        goto exit;\0A        }\0A    }\0A#endif /* MBEDTLS_CIPHER_MODE_WITH_PADDING */\0A\0A    ret = mbedtls_cipher_crypt(&cipher_ctx, iv, iv_len, data, len, output, &finish_olen);\0A    if (ret == MBEDTLS_ERR_CIPHER_INVALID_PADDING) {\0A        ret = MBEDTLS_ERR_PKCS12_PASSWORD_MISMATCH;\0A    }\0A\0A    *output_len += finish_olen;\0A\0Aexit:\0A    mbedtls_platform_zeroize(key, sizeof(key));\0A    mbedtls_platform_zeroize(iv,  sizeof(iv));\0A    mbedtls_cipher_free(&cipher_ctx);\0A\0A    return ret;\0A}\0A\0A#endif /* MBEDTLS_ASN1_PARSE_C && MBEDTLS_CIPHER_C */\0A\0Astatic void pkcs12_fill_buffer(unsigned char *data, size_t data_len,\0A                               const unsigned char *filler, size_t fill_len)\0A{\0A    unsigned char *p = data;\0A    size_t use_len;\0A\0A    if (filler != NULL && fill_len != 0) {\0A        while (data_len > 0) {\0A            use_len = (data_len > fill_len) ? fill_len : data_len;\0A            memcpy(p, filler, use_len);\0A            p += use_len;\0A            data_len -= use_len;\0A        }\0A    } else {\0A        /* If either of the above are not true then clearly there is nothing\0A         * that this function can do. The function should *not* be called\0A         * under either of those circumstances, as you could end up with an\0A         * incorrect output but for safety's sake, leaving the check in as\0A         * otherwise we could end up with memory corruption.*/\0A    }\0A}\0A\0A\0Astatic int calculate_hashes(mbedtls_md_type_t md_type, int iterations,\0A                            unsigned char *diversifier, unsigned char *salt_block,\0A                            unsigned char *pwd_block, unsigned char *hash_output, int use_salt,\0A                            int use_password, size_t hlen, size_t v)\0A{\0A    int ret = -1;\0A    size_t i;\0A    const mbedtls_md_info_t *md_info;\0A    mbedtls_md_context_t md_ctx;\0A    md_info = mbedtls_md_info_from_type(md_type);\0A    if (md_info == NULL) {\0A        return MBEDTLS_ERR_PKCS12_FEATURE_UNAVAILABLE;\0A    }\0A\0A    mbedtls_md_init(&md_ctx);\0A\0A    if ((ret = mbedtls_md_setup(&md_ctx, md_info, 0)) != 0) {\0A        return ret;\0A    }\0A    // Calculate hash( diversifier || salt_block || pwd_block )\0A    if ((ret = mbedtls_md_starts(&md_ctx)) != 0) {\0A        goto exit;\0A    }\0A\0A    if ((ret = mbedtls_md_update(&md_ctx, diversifier, v)) != 0) {\0A        goto exit;\0A    }\0A\0A    if (use_salt != 0) {\0A        if ((ret = mbedtls_md_update(&md_ctx, salt_block, v)) != 0) {\0A            goto exit;\0A        }\0A    }\0A\0A    if (use_password != 0) {\0A        if ((ret = mbedtls_md_update(&md_ctx, pwd_block, v)) != 0) {\0A            goto exit;\0A        }\0A    }\0A\0A    if ((ret = mbedtls_md_finish(&md_ctx, hash_output)) != 0) {\0A        goto exit;\0A    }\0A\0A    // Perform remaining ( iterations - 1 ) recursive hash calculations\0A    for (i = 1; i < (size_t) iterations; i++) {\0A        if ((ret = mbedtls_md(md_info, hash_output, hlen, hash_output))\0A            != 0) {\0A            goto exit;\0A        }\0A    }\0A\0Aexit:\0A    mbedtls_md_free(&md_ctx);\0A    return ret;\0A}\0A\0A\0Aint mbedtls_pkcs12_derivation(unsigned char *data, size_t datalen,\0A                              const unsigned char *pwd, size_t pwdlen,\0A                              const unsigned char *salt, size_t saltlen,\0A                              mbedtls_md_type_t md_type, int id, int iterations)\0A{\0A    int ret = MBEDTLS_ERR_ERROR_CORRUPTION_DETECTED;\0A    unsigned int j;\0A\0A    unsigned char diversifier[128];\0A    unsigned char salt_block[128], pwd_block[128], hash_block[128] = { 0 };\0A    unsigned char hash_output[MBEDTLS_MD_MAX_SIZE];\0A    unsigned char *p;\0A    unsigned char c;\0A    int           use_password = 0;\0A    int           use_salt = 0;\0A\0A    size_t hlen, use_len, v, i;\0A\0A    // This version only allows max of 64 bytes of password or salt\0A    if (datalen > 128 || pwdlen > 64 || saltlen > 64) {\0A        return MBEDTLS_ERR_PKCS12_BAD_INPUT_DATA;\0A    }\0A\0A    if (pwd == NULL && pwdlen != 0) {\0A        return MBEDTLS_ERR_PKCS12_BAD_INPUT_DATA;\0A    }\0A\0A    if (salt == NULL && saltlen != 0) {\0A        return MBEDTLS_ERR_PKCS12_BAD_INPUT_DATA;\0A    }\0A\0A    use_password = (pwd && pwdlen != 0);\0A    use_salt = (salt && saltlen != 0);\0A\0A    hlen = mbedtls_md_get_size_from_type(md_type);\0A\0A    if (hlen <= 32) {\0A        v = 64;\0A    } else {\0A        v = 128;\0A    }\0A\0A    memset(diversifier, (unsigned char) id, v);\0A\0A    if (use_salt != 0) {\0A        pkcs12_fill_buffer(salt_block, v, salt, saltlen);\0A    }\0A\0A    if (use_password != 0) {\0A        pkcs12_fill_buffer(pwd_block,  v, pwd,  pwdlen);\0A    }\0A\0A    p = data;\0A    while (datalen > 0) {\0A        if (calculate_hashes(md_type, iterations, diversifier, salt_block,\0A                             pwd_block, hash_output, use_salt, use_password, hlen,\0A                             v) != 0) {\0A            goto exit;\0A        }\0A\0A        use_len = (datalen > hlen) ? hlen : datalen;\0A        memcpy(p, hash_output, use_len);\0A        datalen -= use_len;\0A        p += use_len;\0A\0A        if (datalen == 0) {\0A            break;\0A        }\0A\0A        // Concatenating copies of hash_output into hash_block (B)\0A        pkcs12_fill_buffer(hash_block, v, hash_output, hlen);\0A\0A        // B += 1\0A        for (i = v; i > 0; i--) {\0A            if (++hash_block[i - 1] != 0) {\0A                break;\0A            }\0A        }\0A\0A        if (use_salt != 0) {\0A            // salt_block += B\0A            c = 0;\0A            for (i = v; i > 0; i--) {\0A                j = salt_block[i - 1] + hash_block[i - 1] + c;\0A                c = MBEDTLS_BYTE_1(j);\0A                salt_block[i - 1] = MBEDTLS_BYTE_0(j);\0A            }\0A        }\0A\0A        if (use_password != 0) {\0A            // pwd_block  += B\0A            c = 0;\0A            for (i = v; i > 0; i--)