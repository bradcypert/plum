ond is true iff the MSBs differ.\0A     */\0A    mbedtls_ct_condition_t cond = mbedtls_ct_bool((xo ^ yo) >> (MBEDTLS_CT_SIZE - 1));\0A\0A    /*\0A     * If the MSB are the same then the difference x-y will be negative (and\0A     * have its MSB set to 1 during conversion to unsigned) if and only if x<y.\0A     *\0A     * If the MSB are different, then the operand with the MSB of 1 is the\0A     * bigger. (That is if y has MSB of 1, then x<y is true and it is false if\0A     * the MSB of y is 0.)\0A     */\0A\0A    // Select either y, or x - y\0A    mbedtls_ct_uint_t ret = mbedtls_ct_if(cond, yo, (mbedtls_ct_uint_t) (xo - yo));\0A\0A    // Extract only the MSB of ret\0A    ret = ret >> (MBEDTLS_CT_SIZE - 1);\0A\0A    // Convert to a condition (i.e., all bits set iff non-zero)\0A    return mbedtls_ct_bool(ret);\0A#endif\0A}\0A\0Astatic inline mbedtls_ct_condition_t mbedtls_ct_uint_ne(mbedtls_ct_uint_t x, mbedtls_ct_uint_t y)\0A{\0A    /* diff = 0 if x == y, non-zero otherwise */\0A    const mbedtls_ct_uint_t diff = mbedtls_ct_compiler_opaque(x) ^ mbedtls_ct_compiler_opaque(y);\0A\0A    /* all ones if x != y, 0 otherwise */\0A    return mbedtls_ct_bool(diff);\0A}\0A\0Astatic inline unsigned char mbedtls_ct_uchar_in_range_if(unsigned char low,\0A                                                         unsigned char high,\0A                                                         unsigned char c,\0A                                                         unsigned char t)\0A{\0A    const unsigned char co = (unsigned char) mbedtls_ct_compiler_opaque(c);\0A    const unsigned char to = (unsigned char) mbedtls_ct_compiler_opaque(t);\0A\0A    /* low_mask is: 0 if low <= c, 0x...ff if low > c */\0A    unsigned low_mask = ((unsigned) co - low) >> 8;\0A    /* high_mask is: 0 if c <= high, 0x...ff if c > high */\0A    unsigned high_mask = ((unsigned) high - co) >> 8;\0A\0A    return (unsigned char) (~(low_mask | high_mask)) & to;\0A}\0A\0A/* ============================================================================\0A * Everything below here is trivial wrapper functions\0A */\0A\0Astatic inline size_t mbedtls_ct_size_if(mbedtls_ct_condition_t condition,\0A                                        size_t if1,\0A                                        size_t if0)\0A{\0A    return (size_t) mbedtls_ct_if(condition, (mbedtls_ct_uint_t) if1, (mbedtls_ct_uint_t) if0);\0A}\0A\0Astatic inline unsigned mbedtls_ct_uint_if(mbedtls_ct_condition_t condition,\0A                                          unsigned if1,\0A                                          unsigned if0)\0A{\0A    return (unsigned) mbedtls_ct_if(condition, (mbedtls_ct_uint_t) if1, (mbedtls_ct_uint_t) if0);\0A}\0A\0Astatic inline mbedtls_ct_condition_t mbedtls_ct_bool_if(mbedtls_ct_condition_t condition,\0A                                                        mbedtls_ct_condition_t if1,\0A                                                        mbedtls_ct_condition_t if0)\0A{\0A    return (mbedtls_ct_condition_t) mbedtls_ct_if(condition, (mbedtls_ct_uint_t) if1,\0A                                                  (mbedtls_ct_uint_t) if0);\0A}\0A\0A#if defined(MBEDTLS_BIGNUM_C)\0A\0Astatic inline mbedtls_mpi_uint mbedtls_ct_mpi_uint_if(mbedtls_ct_condition_t condition,\0A                                                      mbedtls_mpi_uint if1,\0A                                                      mbedtls_mpi_uint if0)\0A{\0A    return (mbedtls_mpi_uint) mbedtls_ct_if(condition,\0A                                            (mbedtls_ct_uint_t) if1,\0A                                            (mbedtls_ct_uint_t) if0);\0A}\0A\0A#endif\0A\0Astatic inline size_t mbedtls_ct_size_if_else_0(mbedtls_ct_condition_t condition, size_t if1)\0A{\0A    return (size_t) (condition & if1);\0A}\0A\0Astatic inline unsigned mbedtls_ct_uint_if_else_0(mbedtls_ct_condition_t condition, unsigned if1)\0A{\0A    return (unsigned) (condition & if1);\0A}\0A\0Astatic inline mbedtls_ct_condition_t mbedtls_ct_bool_if_else_0(mbedtls_ct_condition_t condition,\0A                                                               mbedtls_ct_condition_t if1)\0A{\0A    return (mbedtls_ct_condition_t) (condition & if1);\0A}\0A\0A#if defined(MBEDTLS_BIGNUM_C)\0A\0Astatic inline mbedtls_mpi_uint mbedtls_ct_mpi_uint_if_else_0(mbedtls_ct_condition_t condition,\0A                                                             mbedtls_mpi_uint if1)\0A{\0A    return (mbedtls_mpi_uint) (condition & if1);\0A}\0A\0A#endif /* MBEDTLS_BIGNUM_C */\0A\0Astatic inline int mbedtls_ct_error_if(mbedtls_ct_condition_t condition, int if1, int if0)\0A{\0A    /* Coverting int -> uint -> int here is safe, because we require if1 and if0 to be\0A     * in the range -32767..0, and we require 32-bit int and uint types.\0A     *\0A     * This means that (0 <= -if0 < INT_MAX), so negating if0 is safe, and similarly for\0A     * converting back to int.\0A     */\0A    return -((int) mbedtls_ct_if(condition, (mbedtls_ct_uint_t) (-if1),\0A                                 (mbedtls_ct_uint_t) (-if0)));\0A}\0A\0Astatic inline int mbedtls_ct_error_if_else_0(mbedtls_ct_condition_t condition, int if1)\0A{\0A    return -((int) (condition & (-if1)));\0A}\0A\0Astatic inline mbedtls_ct_condition_t mbedtls_ct_uint_eq(mbedtls_ct_uint_t x,\0A                                                        mbedtls_ct_uint_t y)\0A{\0A    return ~mbedtls_ct_uint_ne(x, y);\0A}\0A\0Astatic inline mbedtls_ct_condition_t mbedtls_ct_uint_gt(mbedtls_ct_uint_t x,\0A                                                        mbedtls_ct_uint_t y)\0A{\0A    return mbedtls_ct_uint_lt(y, x);\0A}\0A\0Astatic inline mbedtls_ct_condition_t mbedtls_ct_uint_ge(mbedtls_ct_uint_t x,\0A                                                        mbedtls_ct_uint_t y)\0A{\0A    return ~mbedtls_ct_uint_lt(x, y);\0A}\0A\0Astatic inline mbedtls_ct_condition_t mbedtls_ct_uint_le(mbedtls_ct_uint_t x,\0A                                                        mbedtls_ct_uint_t y)\0A{\0A    return ~mbedtls_ct_uint_gt(x, y);\0A}\0A\0Astatic inline mbedtls_ct_condition_t mbedtls_ct_bool_ne(mbedtls_ct_condition_t x,\0A                                                        mbedtls_ct_condition_t y)\0A{\0A    return (mbedtls_ct_condition_t) (x ^ y);\0A}\0A\0Astatic inline mbedtls_ct_condition_t mbedtls_ct_bool_and(mbedtls_ct_condition_t x,\0A                                                         mbedtls_ct_condition_t y)\0A{\0A    return (mbedtls_ct_condition_t) (x & y);\0A}\0A\0Astatic inline mbedtls_ct_condition_t mbedtls_ct_bool_or(mbedtls_ct_condition_t x,\0A                                                        mbedtls_ct_condition_t y)\0A{\0A    return (mbedtls_ct_condition_t) (x | y);\0A}\0A\0Astatic inline mbedtls_ct_condition_t mbedtls_ct_bool_not(mbedtls_ct_condition_t x)\0A{\0A    return (mbedtls_ct_condition_t) (~x);\0A}\0A\0A#if defined(MBEDTLS_COMPILER_IS_GCC) && (__GNUC__ > 4)\0A/* Restore warnings for -Wredundant-decls on gcc */\0A    #pragma GCC diagnostic pop\0A#endif\0A\0A#endif /* MBEDTLS_CONSTANT_TIME_IMPL_H */\0A\00" }
