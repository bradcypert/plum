@.str41645 = private global { i64, i64, [127339 x i8] } { i64 -1, i64 127338, [127339 x i8] c"/*\0A *  TLS 1.3 server-side functions\0A *\0A *  Copyright The Mbed TLS Contributors\0A *  SPDX-License-Identifier: Apache-2.0 OR GPL-2.0-or-later\0A */\0A\0A#include \22common.h\22\0A\0A#if defined(MBEDTLS_SSL_SRV_C) && defined(MBEDTLS_SSL_PROTO_TLS1_3)\0A\0A#include \22debug_internal.h\22\0A#include \22mbedtls/error.h\22\0A#include \22mbedtls/platform.h\22\0A#include \22mbedtls/constant_time.h\22\0A#include \22mbedtls/oid.h\22\0A#include \22mbedtls/psa_util.h\22\0A\0A#include \22ssl_misc.h\22\0A#include \22ssl_tls13_keys.h\22\0A#include \22ssl_debug_helpers.h\22\0A\0A\0Astatic const mbedtls_ssl_ciphersuite_t *ssl_tls13_validate_peer_ciphersuite(\0A    mbedtls_ssl_context *ssl,\0A    unsigned int cipher_suite)\0A{\0A    const mbedtls_ssl_ciphersuite_t *ciphersuite_info;\0A    if (!mbedtls_ssl_tls13_cipher_suite_is_offered(ssl, cipher_suite)) {\0A        return NULL;\0A    }\0A\0A    ciphersuite_info = mbedtls_ssl_ciphersuite_from_id(cipher_suite);\0A    if ((mbedtls_ssl_validate_ciphersuite(ssl, ciphersuite_info,\0A                                          ssl->tls_version,\0A                                          ssl->tls_version) != 0)) {\0A        return NULL;\0A    }\0A    return ciphersuite_info;\0A}\0A\0Astatic void ssl_tls13_select_ciphersuite(\0A    mbedtls_ssl_context *ssl,\0A    const unsigned char *cipher_suites,\0A    const unsigned char *cipher_suites_end,\0A    int psk_ciphersuite_id,\0A    psa_algorithm_t psk_hash_alg,\0A    const mbedtls_ssl_ciphersuite_t **selected_ciphersuite_info)\0A{\0A    *selected_ciphersuite_info = NULL;\0A\0A    /*\0A     * In a compliant ClientHello the byte-length of the list of ciphersuites\0A     * is even and this function relies on this fact. This should have been\0A     * checked in the main ClientHello parsing function. Double check here.\0A     */\0A    if ((cipher_suites_end - cipher_suites) & 1) {\0A        return;\0A    }\0A\0A    for (const unsigned char *p = cipher_suites;\0A         p < cipher_suites_end; p += 2) {\0A        /*\0A         * \22cipher_suites_end - p is even\22 is an invariant of the loop. As\0A         * cipher_suites_end - p > 0, we have cipher_suites_end - p >= 2 and it\0A         * is thus safe to read two bytes.\0A         */\0A        uint16_t id = MBEDTLS_GET_UINT16_BE(p, 0);\0A\0A        const mbedtls_ssl_ciphersuite_t *info =\0A            ssl_tls13_validate_peer_ciphersuite(ssl, id);\0A        if (info == NULL) {\0A            continue;\0A        }\0A\0A        /*\0A         * If a valid PSK ciphersuite identifier has been passed in, we want\0A         * an exact match.\0A         */\0A        if (psk_ciphersuite_id != 0) {\0A            if (id != psk_ciphersuite_id) {\0A                continue;\0A            }\0A        } else if (psk_hash_alg != PSA_ALG_NONE) {\0A            if (mbedtls_md_psa_alg_from_type((mbedtls_md_type_t) info->mac) !=\0A                psk_hash_alg) {\0A                continue;\0A            }\0A        }\0A\0A        *selected_ciphersuite_info = info;\0A        return;\0A    }\0A\0A    MBEDTLS_SSL_DEBUG_MSG(1, (\22No matched ciphersuite, psk_ciphersuite_id=%x, psk_hash_alg=%lx\22,\0A                              (unsigned) psk_ciphersuite_id,\0A                              (unsigned long) psk_hash_alg));\0A}\0A\0A#if defined(MBEDTLS_SSL_TLS1_3_KEY_EXCHANGE_MODE_SOME_PSK_ENABLED)\0A/* From RFC 8446:\0A *\0A *   enum { psk_ke(0), psk_dhe_ke(1), (255) } PskKeyExchangeMode;\0A *   struct {\0A *       PskKeyExchangeMode ke_modes<1..255>;\0A *   } PskKeyExchangeModes;\0A */\0AMBEDTLS_CHECK_RETURN_CRITICAL\0Astatic int ssl_tls13_parse_key_exchange_modes_ext(mbedtls_ssl_context *ssl,\0A                                                  const unsigned char *buf,\0A                                                  const unsigned char *end)\0A{\0A    const unsigned char *p = buf;\0A    size_t ke_modes_len;\0A    int ke_modes = 0;\0A\0A    /* Read ke_modes length (1 Byte) */\0A    MBEDTLS_SSL_CHK_BUF_READ_PTR(p, end, 1);\0A    ke_modes_len = *p++;\0A    /* Currently, there are only two PSK modes, so even without looking\0A     * at the content, something's wrong if the list has more than 2 items. */\0A    if (ke_modes_len > 2) {\0A        MBEDTLS_SSL_PEND_FATAL_ALERT(MBEDTLS_SSL_ALERT_MSG_ILLEGAL_PARAMETER,\0A                                     MBEDTLS_ERR_SSL_ILLEGAL_PARAMETER);\0A        return MBEDTLS_ERR_SSL_HANDSHAKE_FAILURE;\0A    }\0A\0A    MBEDTLS_SSL_CHK_BUF_READ_PTR(p, end, ke_modes_len);\0A\0A    while (ke_modes_len-- != 0) {\0A        switch (*p++) {\0A            case MBEDTLS_SSL_TLS1_3_PSK_MODE_PURE:\0A                ke_modes |= MBEDTLS_SSL_TLS1_3_KEY_EXCHANGE_MODE_PSK;\0A                MBEDTLS_SSL_DEBUG_MSG(3, (\22Found PSK KEX MODE\22));\0A                break;\0A            case MBEDTLS_SSL_TLS1_3_PSK_MODE_ECDHE:\0A                ke_modes |= MBEDTLS_SSL_TLS1_3_KEY_EXCHANGE_MODE_PSK_EPHEMERAL;\0A                MBEDTLS_SSL_DEBUG_MSG(3, (\22Found PSK_EPHEMERAL KEX MODE\22));\0A                break;\0A            default:\0A                MBEDTLS_SSL_PEND_FATAL_ALERT(MBEDTLS_SSL_ALERT_MSG_ILLEGAL_PARAMETER,\0A                                             MBEDTLS_ERR_SSL_ILLEGAL_PARAMETER);\0A                return MBEDTLS_ERR_SSL_ILLEGAL_PARAMETER;\0A        }\0A    }\0A\0A    ssl->handshake->tls13_kex_modes = ke_modes;\0A    return 0;\0A}\0A\0A/*\0A * Non-error return values of\0A * ssl_tls13_offered_psks_check_identity_match_ticket() and\0A * ssl_tls13_offered_psks_check_identity_match(). They are positive to\0A * not collide with error codes that are negative. Zero\0A * (SSL_TLS1_3_PSK_IDENTITY_MATCH) in case of success as it may be propagated\0A * up by the callers of this function as a generic success condition.\0A *\0A * The return value SSL_TLS1_3_PSK_IDENTITY_MATCH_BUT_PSK_NOT_USABLE means\0A * that the pre-shared-key identity matches that of a ticket or an externally-\0A * provisioned pre-shared-key. We have thus been able to retrieve the\0A * attributes of the pre-shared-key but at least one of them does not meet\0A * some criteria and the pre-shared-key cannot be used. For example, a ticket\0A * is expired or its version is not TLS 1.3. Note eventually that the return\0A * value SSL_TLS1_3_PSK_IDENTITY_MATCH_BUT_PSK_NOT_USABLE does not have\0A * anything to do with binder check. A binder check is done only when a\0A * suitable pre-shared-key has been selected and only for that selected\0A * pre-shared-key: if the binder check fails, we fail the handshake and we do\0A * not try to find another pre-shared-key for which the binder check would\0A * succeed as recommended by the specification.\0A */\0A#define SSL_TLS1_3_PSK_IDENTITY_DOES_NOT_MATCH 2\0A#define SSL_TLS1_3_PSK_IDENTITY_MATCH_BUT_PSK_NOT_USABLE 1\0A#define SSL_TLS1_3_PSK_IDENTITY_MATCH 0\0A\0AMBEDTLS_CHECK_RETURN_CRITICAL\0Astatic int ssl_tls13_key_exchange_is_psk_available(mbedtls_ssl_context *ssl);\0AMBEDTLS_CHECK_RETURN_CRITICAL\0Astatic int ssl_tls13_key_exchange_is_psk_ephemeral_available(mbedtls_ssl_context *ssl);\0A\0A#if defined(MBEDTLS_SSL_SESSION_TICKETS)\0AMBEDTLS_CHECK_RETURN_CRITICAL\0Astatic int ssl_tls13_offered_psks_check_identity_match_ticket(\0A    mbedtls_ssl_context *ssl,\0A    const unsigned char *identity,\0A    size_t identity_len,\0A    uint32_t obfuscated_ticket_age,\0A    mbedtls_ssl_session *session)\0A{\0A    int ret = MBEDTLS_ERR_ERROR_CORRUPTION_DETECTED;\0A    unsigned char *ticket_buffer;\0A#if defined(MBEDTLS_HAVE_TIME)\0A    mbedtls_ms_time_t now;\0A    mbedtls_ms_time_t server_age;\0A    uint32_t client_age;\0A    mbedtls_ms_time_t age_diff;\0A#endif\0A\0A    ((void) obfuscated_ticket_age);\0A\0A    MBEDTLS_SSL_DEBUG_MSG(2, (\22=> check_identity_match_ticket\22));\0A\0A    /* Ticket parser is not configured, Skip */\0A    if (ssl->conf->f_ticket_parse == NULL || identity_len == 0) {\0A        return SSL_TLS1_3_PSK_IDENTITY_DOES_NOT_MATCH;\0A    }\0A\0A    /* We create a copy of the encrypted ticket since the ticket parsing\0A     * function is allowed to use its input buffer as an output buffer\0A     * (in-place decryption). We do, however, need the original buffer for\0A     * computing the PSK binder value.\0A     */\0A    ticket_buffer = mbedtls_calloc(1, identity_len);\0A    if (ticket_buffer == NULL) {\0A        return MBEDTLS_ERR_SSL_ALLOC_FAILED;\0A    }\0A    memcpy(ticket_buffer, identity, identity_len);\0A\0A    ret = ssl->conf->f_ticket_parse(ssl->conf->p_ticket,\0A                                    session,\0A                                    ticket_buffer, identity_len);\0A    switch (ret) {\0A        case 0:\0A            ret = SSL_TLS1_3_PSK_IDENTITY_MATCH;\0A            break;\0A\0A        case MBEDTLS_ERR_SSL_SESSION_TICKET_EXPIRED:\0A            MBEDTLS_SSL_DEBUG_MSG(3, (\22ticket is expired\22));\0A            ret = SSL_TLS1_3_PSK_IDENTITY_MATCH_BUT_PSK_NOT_USABLE;\0A            break;\0A\0A        case MBEDTLS_ERR_SSL_INVALID_MAC:\0A            MBEDTLS_SSL_DEBUG_MSG(3, (\22ticket is not authentic\22));\0A            ret = SSL_TLS1_3_PSK_IDENTITY_DOES_NOT_MATCH;\0A            break;\0A\0A        default:\0A            MBEDTLS_SSL_DEBUG_RET(1, \22ticket_parse\22, ret);\0A            ret = SSL_TLS1_3_PSK_IDENTITY_DOES_NOT_MATCH;\0A    }\0A\0A    /* We delete the temporary buffer */\0A    mbedtls_free(ticket_buffer);\0A\0A    if (ret != SSL_TLS1_3_PSK_IDENTITY_MATCH) {\0A        goto exit;\0A    }\0A\0A    /*\0A     * The identity matches that of a ticket. Now check that it has suitable\0A     * attributes and bet it will not be the case.\0A     */\0A    ret = SSL_TLS1_3_PSK_IDENTITY_MATCH_BUT_PSK_NOT_USABLE;\0A\0A    if (session->tls_version != MBEDTLS_SSL_VERSION_TLS1_3) {\0A        MBEDTLS_SSL_DEBUG_MSG(3, (\22Ticket TLS version is not 1.3.\22));\0A        goto exit;\0A    }\0A\0A#if defined(MBEDTLS_HAVE_TIME)\0A    now = mbedtls_ms_time();\0A\0A    if (now < session->ticket_creation_time) {\0A        MBEDTLS_SSL_DEBUG_MSG(\0A            3, (\22Invalid ticket creation time ( now = %\22 MBEDTLS_PRINTF_MS_TIME\0A                \22, creation_time = %\22 MBEDTLS_PRINTF_MS_TIME \22 )\22,\0A                now, session->ticket_creation_time));\0A        goto exit;\0A    }\0A\0A    server_age = now - session->ticket_creation_time;\0A\0A    /* RFC 8446 section 4.6.1\0A     *\0A     * Servers MUST NOT use any value greater than 604800 seconds (7 days).\0A     *\0A     * RFC 8446 section 4.2.11.1\0A     *\0A     * Clients MUST NOT attempt to use tickets which have ages greater than\0A     * the \22ticket_lifetime\22 value which was provided with the ticket.\0A     *\0A     */\0A    if (server_age > MBEDTLS_SSL_TLS1_3_MAX_ALLOWED_TICKET_LIFETIME * 1000) {\0A        MBEDTLS_SSL_DEBUG_MSG(\0A            3, (\22Ticket age exceeds limitation ticket_age = %\22 MBEDTLS_PRINTF_MS_TIME,\0A                server_age));\0A        goto exit;\0A    }\0A\0A    /* RFC 8446 section 4.2.10\0A     *\0A     * For PSKs provisioned via NewSessionTicket, a server MUST validate that\0A     * the ticket age for the selected PSK identity (computed by subtracting\0A     * ticket_age_add from PskIdentity.obfuscated_ticket_age modulo 2^32) is\0A     * within a small tolerance of the time since the ticket was issued.\0A     *\0A     * NOTE: The typical accuracy of an RTC crystal is ±100 to ±20 parts per\0A     *       million (360 to 72 milliseconds per hour). Default tolerance\0A     *       window is 6s, thus in the worst case clients and servers must\0A     *       sync up their system time every 6000/360/2~=8 hours.\0A     */\0A    client_age = obfuscated_ticket_age - session->ticket_age_add;\0A    age_diff = server_age - (mbedtls_ms_time_t) client_age;\0A    if (age_diff < -MBEDTLS_SSL_TLS1_3_TICKET_AGE_TOLERANCE ||\0A        age_diff > MBEDTLS_SSL_TLS1_3_TICKET_AGE_TOLERANCE) {\0A        MBEDTLS_SSL_DEBUG_MSG(\0A            3, (\22Ticket age outside tolerance window ( diff = %\22\0A                MBEDTLS_PRINTF_MS_TIME \22)\22,\0A                age_diff));\0A        goto exit;\0A    }\0A#endif /* MBEDTLS_HAVE_TIME */\0A\0A    /*\0A     * All good, we have found a suitable ticket.\0A     */\0A    ret = SSL_TLS1_3_PSK_IDENTITY_MATCH;\0A\0Aexit:\0A    if (ret != SSL_TLS1_3_PSK_IDENTITY_MATCH) {\0A        mbedtls_ssl_session_free(session);\0A    }\0A\0A    MBEDTLS_SSL_DEBUG_MSG(2, (\22<= check_identity_match_ticket\22));\0A    return ret;\0A}\0A#endif /* MBEDTLS_SSL_SESSION_TICKETS */\0A\0AMBEDTLS_CHECK_RETURN_CRITICAL\0Astatic int ssl_tls13_offered_psks_check_identity_match(\0A    mbedtls_ssl_context *ssl,\0A    const unsigned char *identity,\0A    size_t identity_len,\0A    uint32_t obfuscated_ticket_age,\0A    int *psk_type,\0A    mbedtls_ssl_session *session)\0A{\0A    int ret = MBEDTLS_ERR_ERROR_CORRUPTION_DETECTED;\0A\0A    ((void) session);\0A    ((void) obfuscated_ticket_age);\0A    *psk_type = MBEDTLS_SSL_TLS1_3_PSK_EXTERNAL;\0A\0A    MBEDTLS_SSL_DEBUG_BUF(4, \22identity\22, identity, identity_len);\0A\0A#if defined(MBEDTLS_SSL_SESSION_TICKETS)\0A    ret = ssl_tls13_offered_psks_check_identity_match_ticket(\0A        ssl, identity, identity_len, obfuscated_ticket_age, session);\0A    if (ret == SSL_TLS1_3_PSK_IDENTITY_MATCH) {\0A        *psk_type = MBEDTLS_SSL_TLS1_3_PSK_RESUMPTION;\0A        ret = mbedtls_ssl_set_hs_psk(ssl,\0A                                     session->resumption_key,\0A                                     session->resumption_key_len);\0A        if (ret != 0) {\0A            MBEDTLS_SSL_DEBUG_RET(1, \22mbedtls_ssl_set_hs_psk\22, ret);\0A            return ret;\0A        }\0A\0A        MBEDTLS_SSL_DEBUG_BUF(4, \22Ticket-resumed PSK:\22,\0A                              session->resumption_key,\0A                              session->resumption_key_len);\0A        MBEDTLS_SSL_DEBUG_MSG(4, (\22ticket: obfuscated_ticket_age: %u\22,\0A                                  (unsigned) obfuscated_ticket_age));\0A        return SSL_TLS1_3_PSK_IDENTITY_MATCH;\0A    } else if (ret == SSL_TLS1_3_PSK_IDENTITY_MATCH_BUT_PSK_NOT_USABLE) {\0A        return SSL_TLS1_3_PSK_IDENTITY_MATCH_BUT_PSK_NOT_USABLE;\0A    }\0A#endif /* MBEDTLS_SSL_SESSION_TICKETS */\0A\0A    /* Check identity with external configured function */\0A    if (ssl->conf->f_psk != NULL) {\0A        if (ssl->conf->f_psk(\0A                ssl->conf->p_psk, ssl, identity, identity_len) == 0) {\0A            return SSL_TLS1_3_PSK_IDENTITY_MATCH;\0A        }\0A        return SSL_TLS1_3_PSK_IDENTITY_DOES_NOT_MATCH;\0A    }\0A\0A    MBEDTLS_SSL_DEBUG_BUF(5, \22identity\22, identity, identity_len);\0A    /* Check identity with pre-configured psk */\0A    if (ssl->conf->psk_identity != NULL &&\0A        identity_len == ssl->conf->psk_identity_len &&\0A        mbedtls_ct_memcmp(ssl->conf->psk_identity,\0A                          identity, identity_len) == 0) {\0A        ret = mbedtls_ssl_set_hs_psk(ssl, ssl->conf->psk, ssl->conf->psk_len);\0A        if (ret != 0) {\0A            MBEDTLS_SSL_DEBUG_RET(1, \22mbedtls_ssl_set_hs_psk\22, ret);\0A            return ret;\0A        }\0A        return SSL_TLS1_3_PSK_IDENTITY_MATCH;\0A    }\0A\0A    return SSL_TLS1_3_PSK_IDENTITY_DOES_NOT_MATCH;\0A}\0A\0A/*\0A * Non-error return values of ssl_tls13_offered_psks_check_binder_match().\0A * They are positive to not collide with error codes that are negative. Zero\0A * (SSL_TLS1_3_BINDER_MATCH) in case of success as it may be propagated up\0A * by the callers of this function as a generic success condition.\0A */\0A#define SSL_TLS1_3_BINDER_DOES_NOT_MATCH 1\0A#define SSL_TLS1_3_BINDER_MATCH 0\0AMBEDTLS_CHECK_RETURN_CRITICAL\0Astatic int ssl_tls13_offered_psks_check_binder_match(\0A    mbedtls_ssl_context *ssl,\0A    const unsigned char *binder, size_t binder_len,\0A    int psk_type, psa_algorithm_t psk_hash_alg)\0A{\0A    int ret = MBEDTLS_ERR_ERROR_CORRUPTION_DETECTED;\0A\0A    unsigned char transcript[PSA_HASH_MAX_SIZE];\0A    siz