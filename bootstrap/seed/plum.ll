@.str40706 = private global { i64, i64, [6023 x i8] } { i64 -1, i64 6022, [6023 x i8] c"/**\0A * \5Cfile poly1305.h\0A *\0A * \5Cbrief   This file contains Poly1305 definitions and functions.\0A *\0A *          Poly1305 is a one-time message authenticator that can be used to\0A *          authenticate messages. Poly1305-AES was created by Daniel\0A *          Bernstein https://cr.yp.to/mac/poly1305-20050329.pdf The generic\0A *          Poly1305 algorithm (not tied to AES) was also standardized in RFC\0A *          7539.\0A *\0A * \5Cauthor Daniel King <damaki.gh@gmail.com>\0A */\0A\0A/*\0A *  Copyright The Mbed TLS Contributors\0A *  SPDX-License-Identifier: Apache-2.0 OR GPL-2.0-or-later\0A */\0A\0A#ifndef MBEDTLS_POLY1305_H\0A#define MBEDTLS_POLY1305_H\0A#include \22mbedtls/private_access.h\22\0A\0A#include \22mbedtls/build_info.h\22\0A\0A#include <stdint.h>\0A#include <stddef.h>\0A\0A/** Invalid input parameter(s). */\0A#define MBEDTLS_ERR_POLY1305_BAD_INPUT_DATA         -0x0057\0A\0A#ifdef __cplusplus\0Aextern \22C\22 {\0A#endif\0A\0A#if !defined(MBEDTLS_POLY1305_ALT)\0A\0Atypedef struct mbedtls_poly1305_context {\0A    uint32_t MBEDTLS_PRIVATE(r)[4];      /** The value for 'r' (low 128 bits of the key). */\0A    uint32_t MBEDTLS_PRIVATE(s)[4];      /** The value for 's' (high 128 bits of the key). */\0A    uint32_t MBEDTLS_PRIVATE(acc)[5];    /** The accumulator number. */\0A    uint8_t MBEDTLS_PRIVATE(queue)[16];  /** The current partial block of data. */\0A    size_t MBEDTLS_PRIVATE(queue_len);   /** The number of bytes stored in 'queue'. */\0A}\0Ambedtls_poly1305_context;\0A\0A#else  /* MBEDTLS_POLY1305_ALT */\0A#include \22poly1305_alt.h\22\0A#endif /* MBEDTLS_POLY1305_ALT */\0A\0A/**\0A * \5Cbrief           This function initializes the specified Poly1305 context.\0A *\0A *                  It must be the first API called before using\0A *                  the context.\0A *\0A *                  It is usually followed by a call to\0A *                  \5Cc mbedtls_poly1305_starts(), then one or more calls to\0A *                  \5Cc mbedtls_poly1305_update(), then one call to\0A *                  \5Cc mbedtls_poly1305_finish(), then finally\0A *                  \5Cc mbedtls_poly1305_free().\0A *\0A * \5Cparam ctx       The Poly1305 context to initialize. This must\0A *                  not be \5Cc NULL.\0A */\0Avoid mbedtls_poly1305_init(mbedtls_poly1305_context *ctx);\0A\0A/**\0A * \5Cbrief           This function releases and clears the specified\0A *                  Poly1305 context.\0A *\0A * \5Cparam ctx       The Poly1305 context to clear. This may be \5Cc NULL, in which\0A *                  case this function is a no-op. If it is not \5Cc NULL, it must\0A *                  point to an initialized Poly1305 context.\0A */\0Avoid mbedtls_poly1305_free(mbedtls_poly1305_context *ctx);\0A\0A/**\0A * \5Cbrief           This function sets the one-time authentication key.\0A *\0A * \5Cwarning         The key must be unique and unpredictable for each\0A *                  invocation of Poly1305.\0A *\0A * \5Cparam ctx       The Poly1305 context to which the key should be bound.\0A *                  This must be initialized.\0A * \5Cparam key       The buffer containing the \5Cc 32 Byte (\5Cc 256 Bit) key.\0A *\0A * \5Creturn          \5Cc 0 on success.\0A * \5Creturn          A negative error code on failure.\0A */\0Aint mbedtls_poly1305_starts(mbedtls_poly1305_context *ctx,\0A                            const unsigned char key[32]);\0A\0A/**\0A * \5Cbrief           This functions feeds an input buffer into an ongoing\0A *                  Poly1305 computation.\0A *\0A *                  It is called between \5Cc mbedtls_cipher_poly1305_starts() and\0A *                  \5Cc mbedtls_cipher_poly1305_finish().\0A *                  It can be called repeatedly to process a stream of data.\0A *\0A * \5Cparam ctx       The Poly1305 context to use for the Poly1305 operation.\0A *                  This must be initialized and bound to a key.\0A * \5Cparam ilen      The length of the input data in Bytes.\0A *                  Any value is accepted.\0A * \5Cparam input     The buffer holding the input data.\0A *                  This pointer can be \5Cc NULL if `ilen == 0`.\0A *\0A * \5Creturn          \5Cc 0 on success.\0A * \5Creturn          A negative error code on failure.\0A */\0Aint mbedtls_poly1305_update(mbedtls_poly1305_context *ctx,\0A                            const unsigned char *input,\0A                            size_t ilen);\0A\0A/**\0A * \5Cbrief           This function generates the Poly1305 Message\0A *                  Authentication Code (MAC).\0A *\0A * \5Cparam ctx       The Poly1305 context to use for the Poly1305 operation.\0A *                  This must be initialized and bound to a key.\0A * \5Cparam mac       The buffer to where the MAC is written. This must\0A *                  be a writable buffer of length \5Cc 16 Bytes.\0A *\0A * \5Creturn          \5Cc 0 on success.\0A * \5Creturn          A negative error code on failure.\0A */\0Aint mbedtls_poly1305_finish(mbedtls_poly1305_context *ctx,\0A                            unsigned char mac[16]);\0A\0A/**\0A * \5Cbrief           This function calculates the Poly1305 MAC of the input\0A *                  buffer with the provided key.\0A *\0A * \5Cwarning         The key must be unique and unpredictable for each\0A *                  invocation of Poly1305.\0A *\0A * \5Cparam key       The buffer containing the \5Cc 32 Byte (\5Cc 256 Bit) key.\0A * \5Cparam ilen      The length of the input data in Bytes.\0A *                  Any value is accepted.\0A * \5Cparam input     The buffer holding the input data.\0A *                  This pointer can be \5Cc NULL if `ilen == 0`.\0A * \5Cparam mac       The buffer to where the MAC is written. This must be\0A *                  a writable buffer of length \5Cc 16 Bytes.\0A *\0A * \5Creturn          \5Cc 0 on success.\0A * \5Creturn          A negative error code on failure.\0A */\0Aint mbedtls_poly1305_mac(const unsigned char key[32],\0A                         const unsigned char *input,\0A                         size_t ilen,\0A                         unsigned char mac[16]);\0A\0A#if defined(MBEDTLS_SELF_TEST)\0A/**\0A * \5Cbrief           The Poly1305 checkup routine.\0A *\0A * \5Creturn          \5Cc 0 on success.\0A * \5Creturn          \5Cc 1 on failure.\0A */\0Aint mbedtls_poly1305_self_test(int verbose);\0A#endif /* MBEDTLS_SELF_TEST */\0A\0A#ifdef __cplusplus\0A}\0A#endif\0A\0A#endif /* MBEDTLS_POLY1305_H */\0A\00" }
