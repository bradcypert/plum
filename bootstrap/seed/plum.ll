@.str40924 = private global { i64, i64, [26790 x i8] } { i64 -1, i64 26789, [26790 x i8] c"/**\0A * \5Cfile alignment.h\0A *\0A * \5Cbrief Utility code for dealing with unaligned memory accesses\0A */\0A/*\0A *  Copyright The Mbed TLS Contributors\0A *  SPDX-License-Identifier: Apache-2.0 OR GPL-2.0-or-later\0A */\0A\0A#ifndef MBEDTLS_LIBRARY_ALIGNMENT_H\0A#define MBEDTLS_LIBRARY_ALIGNMENT_H\0A\0A#include <stdint.h>\0A#include <string.h>\0A#include <stdlib.h>\0A\0A/*\0A * Define MBEDTLS_EFFICIENT_UNALIGNED_ACCESS for architectures where unaligned memory\0A * accesses are known to be efficient.\0A *\0A * All functions defined here will behave correctly regardless, but might be less\0A * efficient when this is not defined.\0A */\0A#if defined(__ARM_FEATURE_UNALIGNED) \5C\0A    || defined(MBEDTLS_ARCH_IS_X86) || defined(MBEDTLS_ARCH_IS_X64) \5C\0A    || defined(MBEDTLS_PLATFORM_IS_WINDOWS_ON_ARM64)\0A/*\0A * __ARM_FEATURE_UNALIGNED is defined where appropriate by armcc, gcc 7, clang 9\0A * (and later versions) for Arm v7 and later; all x86 platforms should have\0A * efficient unaligned access.\0A *\0A * https://learn.microsoft.com/en-us/cpp/build/arm64-windows-abi-conventions?view=msvc-170#alignment\0A * specifies that on Windows-on-Arm64, unaligned access is safe (except for uncached\0A * device memory).\0A */\0A#define MBEDTLS_EFFICIENT_UNALIGNED_ACCESS\0A#endif\0A\0A#if defined(__IAR_SYSTEMS_ICC__) && \5C\0A    (defined(MBEDTLS_ARCH_IS_ARM64) || defined(MBEDTLS_ARCH_IS_ARM32) \5C\0A    || defined(__ICCRX__) || defined(__ICCRL78__) || defined(__ICCRISCV__))\0A#pragma language=save\0A#pragma language=extended\0A#define MBEDTLS_POP_IAR_LANGUAGE_PRAGMA\0A/* IAR recommend this technique for accessing unaligned data in\0A * https://www.iar.com/knowledge/support/technical-notes/compiler/accessing-unaligned-data\0A * This results in a single load / store instruction (if unaligned access is supported).\0A * According to that document, this is only supported on certain architectures.\0A */\0A    #define UINT_UNALIGNED\0Atypedef uint16_t __packed mbedtls_uint16_unaligned_t;\0Atypedef uint32_t __packed mbedtls_uint32_unaligned_t;\0Atypedef uint64_t __packed mbedtls_uint64_unaligned_t;\0A#elif defined(MBEDTLS_COMPILER_IS_GCC) && (MBEDTLS_GCC_VERSION >= 40504) && \5C\0A    ((MBEDTLS_GCC_VERSION < 60300) || (!defined(MBEDTLS_EFFICIENT_UNALIGNED_ACCESS)))\0A/*\0A * gcc may generate a branch to memcpy for calls like `memcpy(dest, src, 4)` rather than\0A * generating some LDR or LDRB instructions (similar for stores).\0A *\0A * This is architecture dependent: x86-64 seems fine even with old gcc; 32-bit Arm\0A * is affected. To keep it simple, we enable for all architectures.\0A *\0A * For versions of gcc < 5.4.0 this issue always happens.\0A * For gcc < 6.3.0, this issue happens at -O0\0A * For all versions, this issue happens iff unaligned access is not supported.\0A *\0A * For gcc 4.x, this implementation will generate byte-by-byte loads even if unaligned access is\0A * supported, which is correct but not optimal.\0A *\0A * For performance (and code size, in some cases), we want to avoid the branch and just generate\0A * some inline load/store instructions since the access is small and constant-size.\0A *\0A * The manual states:\0A * \22The packed attribute specifies that a variable or structure field should have the smallest\0A *  possible alignment—one byte for a variable\22\0A * https://gcc.gnu.org/onlinedocs/gcc-4.5.4/gcc/Variable-Attributes.html\0A *\0A * Previous implementations used __attribute__((__aligned__(1)), but had issues with a gcc bug:\0A * https://gcc.gnu.org/bugzilla/show_bug.cgi?id=94662\0A *\0A * Tested with several versions of GCC from 4.5.0 up to 13.2.0\0A * We don't enable for older than 4.5.0 as this has not been tested.\0A */\0A #define UINT_UNALIGNED_STRUCT\0Atypedef struct {\0A    uint16_t x;\0A} __attribute__((packed)) mbedtls_uint16_unaligned_t;\0Atypedef struct {\0A    uint32_t x;\0A} __attribute__((packed)) mbedtls_uint32_unaligned_t;\0Atypedef struct {\0A    uint64_t x;\0A} __attribute__((packed)) mbedtls_uint64_unaligned_t;\0A #endif\0A\0A/*\0A * We try to force mbedtls_(get|put)_unaligned_uintXX to be always inline, because this results\0A * in code that is both smaller and faster. IAR and gcc both benefit from this when optimising\0A * for size.\0A */\0A\0A/**\0A * Read the unsigned 16 bits integer from the given address, which need not\0A * be aligned.\0A *\0A * \5Cparam   p pointer to 2 bytes of data\0A * \5Creturn  Data at the given address\0A */\0A#if defined(__IAR_SYSTEMS_ICC__)\0A#pragma inline = forced\0A#elif defined(__GNUC__)\0A__attribute__((always_inline))\0A#endif\0Astatic inline uint16_t mbedtls_get_unaligned_uint16(const void *p)\0A{\0A    uint16_t r;\0A#if defined(UINT_UNALIGNED)\0A    mbedtls_uint16_unaligned_t *p16 = (mbedtls_uint16_unaligned_t *) p;\0A    r = *p16;\0A#elif defined(UINT_UNALIGNED_STRUCT)\0A    mbedtls_uint16_unaligned_t *p16 = (mbedtls_uint16_unaligned_t *) p;\0A    r = p16->x;\0A#else\0A    memcpy(&r, p, sizeof(r));\0A#endif\0A    return r;\0A}\0A\0A/**\0A * Write the unsigned 16 bits integer to the given address, which need not\0A * be aligned.\0A *\0A * \5Cparam   p pointer to 2 bytes of data\0A * \5Cparam   x data to write\0A */\0A#if defined(__IAR_SYSTEMS_ICC__)\0A#pragma inline = forced\0A#elif defined(__GNUC__)\0A__attribute__((always_inline))\0A#endif\0Astatic inline void mbedtls_put_unaligned_uint16(void *p, uint16_t x)\0A{\0A#if defined(UINT_UNALIGNED)\0A    mbedtls_uint16_unaligned_t *p16 = (mbedtls_uint16_unaligned_t *) p;\0A    *p16 = x;\0A#elif defined(UINT_UNALIGNED_STRUCT)\0A    mbedtls_uint16_unaligned_t *p16 = (mbedtls_uint16_unaligned_t *) p;\0A    p16->x = x;\0A#else\0A    memcpy(p, &x, sizeof(x));\0A#endif\0A}\0A\0A/**\0A * Read the unsigned 32 bits integer from the given address, which need not\0A * be aligned.\0A *\0A * \5Cparam   p pointer to 4 bytes of data\0A * \5Creturn  Data at the given address\0A */\0A#if defined(__IAR_SYSTEMS_ICC__)\0A#pragma inline = forced\0A#elif defined(__GNUC__)\0A__attribute__((always_inline))\0A#endif\0Astatic inline uint32_t mbedtls_get_unaligned_uint32(const void *p)\0A{\0A    uint32_t r;\0A#if defined(UINT_UNALIGNED)\0A    mbedtls_uint32_unaligned_t *p32 = (mbedtls_uint32_unaligned_t *) p;\0A    r = *p32;\0A#elif defined(UINT_UNALIGNED_STRUCT)\0A    mbedtls_uint32_unaligned_t *p32 = (mbedtls_uint32_unaligned_t *) p;\0A    r = p32->x;\0A#else\0A    memcpy(&r, p, sizeof(r));\0A#endif\0A    return r;\0A}\0A\0A/**\0A * Write the unsigned 32 bits integer to the given address, which need not\0A * be aligned.\0A *\0A * \5Cparam   p pointer to 4 bytes of data\0A * \5Cparam   x data to write\0A */\0A#if defined(__IAR_SYSTEMS_ICC__)\0A#pragma inline = forced\0A#elif defined(__GNUC__)\0A__attribute__((always_inline))\0A#endif\0Astatic inline void mbedtls_put_unaligned_uint32(void *p, uint32_t x)\0A{\0A#if defined(UINT_UNALIGNED)\0A    mbedtls_uint32_unaligned_t *p32 = (mbedtls_uint32_unaligned_t *) p;\0A    *p32 = x;\0A#elif defined(UINT_UNALIGNED_STRUCT)\0A    mbedtls_uint32_unaligned_t *p32 = (mbedtls_uint32_unaligned_t *) p;\0A    p32->x = x;\0A#else\0A    memcpy(p, &x, sizeof(x));\0A#endif\0A}\0A\0A/**\0A * Read the unsigned 64 bits integer from the given address, which need not\0A * be aligned.\0A *\0A * \5Cparam   p pointer to 8 bytes of data\0A * \5Creturn  Data at the given address\0A */\0A#if defined(__IAR_SYSTEMS_ICC__)\0A#pragma inline = forced\0A#elif defined(__GNUC__)\0A__attribute__((always_inline))\0A#endif\0Astatic inline uint64_t mbedtls_get_unaligned_uint64(const void *p)\0A{\0A    uint64_t r;\0A#if defined(UINT_UNALIGNED)\0A    mbedtls_uint64_unaligned_t *p64 = (mbedtls_uint64_unaligned_t *) p;\0A    r = *p64;\0A#elif defined(UINT_UNALIGNED_STRUCT)\0A    mbedtls_uint64_unaligned_t *p64 = (mbedtls_uint64_unaligned_t *) p;\0A    r = p64->x;\0A#else\0A    memcpy(&r, p, sizeof(r));\0A#endif\0A    return r;\0A}\0A\0A/**\0A * Write the unsigned 64 bits integer to the given address, which need not\0A * be aligned.\0A *\0A * \5Cparam   p pointer to 8 bytes of data\0A * \5Cparam   x data to write\0A */\0A#if defined(__IAR_SYSTEMS_ICC__)\0A#pragma inline = forced\0A#elif defined(__GNUC__)\0A__attribute__((always_inline))\0A#endif\0Astatic inline void mbedtls_put_unaligned_uint64(void *p, uint64_t x)\0A{\0A#if defined(UINT_UNALIGNED)\0A    mbedtls_uint64_unaligned_t *p64 = (mbedtls_uint64_unaligned_t *) p;\0A    *p64 = x;\0A#elif defined(UINT_UNALIGNED_STRUCT)\0A    mbedtls_uint64_unaligned_t *p64 = (mbedtls_uint64_unaligned_t *) p;\0A    p64->x = x;\0A#else\0A    memcpy(p, &x, sizeof(x));\0A#endif\0A}\0A\0A#if defined(MBEDTLS_POP_IAR_LANGUAGE_PRAGMA)\0A#pragma language=restore\0A#endif\0A\0A/** Byte Reading Macros\0A *\0A * Given a multi-byte integer \5Cp x, MBEDTLS_BYTE_n retrieves the n-th\0A * byte from x, where byte 0 is the least significant byte.\0A */\0A#define MBEDTLS_BYTE_0(x) ((uint8_t) ((x)         & 0xff))\0A#define MBEDTLS_BYTE_1(x) ((uint8_t) (((x) >>  8) & 0xff))\0A#define MBEDTLS_BYTE_2(x) ((uint8_t) (((x) >> 16) & 0xff))\0A#define MBEDTLS_BYTE_3(x) ((uint8_t) (((x) >> 24) & 0xff))\0A#define MBEDTLS_BYTE_4(x) ((uint8_t) (((x) >> 32) & 0xff))\0A#define MBEDTLS_BYTE_5(x) ((uint8_t) (((x) >> 40) & 0xff))\0A#define MBEDTLS_BYTE_6(x) ((uint8_t) (((x) >> 48) & 0xff))\0A#define MBEDTLS_BYTE_7(x) ((uint8_t) (((x) >> 56) & 0xff))\0A\0A/*\0A * Detect GCC built-in byteswap routines\0A */\0A#if defined(__GNUC__) && defined(__GNUC_PREREQ)\0A#if __GNUC_PREREQ(4, 8)\0A#define MBEDTLS_BSWAP16 __builtin_bswap16\0A#endif /* __GNUC_PREREQ(4,8) */\0A#if __GNUC_PREREQ(4, 3)\0A#define MBEDTLS_BSWAP32 __builtin_bswap32\0A#define MBEDTLS_BSWAP64 __builtin_bswap64\0A#endif /* __GNUC_PREREQ(4,3) */\0A#endif /* defined(__GNUC__) && defined(__GNUC_PREREQ) */\0A\0A/*\0A * Detect Clang built-in byteswap routines\0A */\0A#if defined(__clang__) && defined(__has_builtin)\0A#if __has_builtin(__builtin_bswap16) && !defined(MBEDTLS_BSWAP16)\0A#define MBEDTLS_BSWAP16 __builtin_bswap16\0A#endif /* __has_builtin(__builtin_bswap16) */\0A#if __has_builtin(__builtin_bswap32) && !defined(MBEDTLS_BSWAP32)\0A#define MBEDTLS_BSWAP32 __builtin_bswap32\0A#endif /* __has_builtin(__builtin_bswap32) */\0A#if __has_builtin(__builtin_bswap64) && !defined(MBEDTLS_BSWAP64)\0A#define MBEDTLS_BSWAP64 __builtin_bswap64\0A#endif /* __has_builtin(__builtin_bswap64) */\0A#endif /* defined(__clang__) && defined(__has_builtin) */\0A\0A/*\0A * Detect MSVC built-in byteswap routines\0A */\0A#if defined(_MSC_VER)\0A#if !defined(MBEDTLS_BSWAP16)\0A#define MBEDTLS_BSWAP16 _byteswap_ushort\0A#endif\0A#if !defined(MBEDTLS_BSWAP32)\0A#define MBEDTLS_BSWAP32 _byteswap_ulong\0A#endif\0A#if !defined(MBEDTLS_BSWAP64)\0A#define MBEDTLS_BSWAP64 _byteswap_uint64\0A#endif\0A#endif /* defined(_MSC_VER) */\0A\0A/* Detect armcc built-in byteswap routine */\0A#if defined(__ARMCC_VERSION) && (__ARMCC_VERSION >= 410000) && !defined(MBEDTLS_BSWAP32)\0A#if defined(__ARM_ACLE)  /* ARM Compiler 6 - earlier versions don't need a header */\0A#include <arm_acle.h>\0A#endif\0A#define MBEDTLS_BSWAP32 __rev\0A#endif\0A\0A/* Detect IAR built-in byteswap routine */\0A#if defined(__IAR_SYSTEMS_ICC__)\0A#if defined(__ARM_ACLE)\0A#include <arm_acle.h>\0A#define MBEDTLS_BSWAP16(x) ((uint16_t) __rev16((uint32_t) (x)))\0A#define MBEDTLS_BSWAP32 __rev\0A#define MBEDTLS_BSWAP64 __revll\0A#endif\0A#endif\0A\0A/*\0A * Where compiler built-ins are not present, fall back to C code that the\0A * compiler may be able to detect and transform into the relevant bswap or\0A * similar instruction.\0A */\0A#if !defined(MBEDTLS_BSWAP16)\0Astatic inline uint16_t mbedtls_bswap16(uint16_t x)\0A{\0A    return\0A        (x & 0x00ff) << 8 |\0A        (x & 0xff00) >> 8;\0A}\0A#define MBEDTLS_BSWAP16 mbedtls_bswap16\0A#endif /* !defined(MBEDTLS_BSWAP16) */\0A\0A#if !defined(MBEDTLS_BSWAP32)\0Astatic inline uint32_t mbedtls_bswap32(uint32_t x)\0A{\0A    return\0A        (x & 0x000000ff) << 24 |\0A        (x & 0x0000ff00) <<  8 |\0A        (x & 0x00ff0000) >>  8 |\0A        (x & 0xff000000) >> 24;\0A}\0A#define MBEDTLS_BSWAP32 mbedtls_bswap32\0A#endif /* !defined(MBEDTLS_BSWAP32) */\0A\0A#if !defined(MBEDTLS_BSWAP64)\0Astatic inline uint64_t mbedtls_bswap64(uint64_t x)\0A{\0A    return\0A        (x & 0x00000000000000ffULL) << 56 |\0A        (x & 0x000000000000ff00ULL) << 40 |\0A        (x & 0x0000000000ff0000ULL) << 24 |\0A        (x & 0x00000000ff000000ULL) <<  8 |\0A        (x & 0x000000ff00000000ULL) >>  8 |\0A        (x & 0x0000ff0000000000ULL) >> 24 |\0A        (x & 0x00ff000000000000ULL) >> 40 |\0A        (x & 0xff00000000000000ULL) >> 56;\0A}\0A#define MBEDTLS_BSWAP64 mbedtls_bswap64\0A#endif /* !defined(MBEDTLS_BSWAP64) */\0A\0A#if !defined(__BYTE_ORDER__)\0A\0A#if defined(__LITTLE_ENDIAN__)\0A/* IAR defines __xxx_ENDIAN__, but not __BYTE_ORDER__ */\0A#define MBEDTLS_IS_BIG_ENDIAN 0\0A#elif defined(__BIG_ENDIAN__)\0A#define MBEDTLS_IS_BIG_ENDIAN 1\0A#else\0Astatic const uint16_t mbedtls_byte_order_detector = { 0x100 };\0A#define MBEDTLS_IS_BIG_ENDIAN (*((unsigned char *) (&mbedtls_byte_order_detector)) == 0x01)\0A#endif\0A\0A#else\0A\0A#if (__BYTE_ORDER__) == (__ORDER_BIG_ENDIAN__)\0A#define MBEDTLS_IS_BIG_ENDIAN 1\0A#else\0A#define MBEDTLS_IS_BIG_ENDIAN 0\0A#endif\0A\0A#endif /* !defined(__BYTE_ORDER__) */\0A\0A/**\0A * Get the unsigned 32 bits integer corresponding to four bytes in\0A * big-endian order (MSB first).\0A *\0A * \5Cparam   data    Base address of the memory to get the four bytes from.\0A * \5Cparam   offset  Offset from \5Cp data of the first and most significant\0A *                  byte of the four bytes to build the 32 bits unsigned\0A *                  integer from.\0A */\0A#define MBEDTLS_GET_UINT32_BE(data, offset)                                \5C\0A    ((MBEDTLS_IS_BIG_ENDIAN)                                               \5C\0A        ? mbedtls_get_unaligned_uint32((data) + (offset))                  \5C\0A        : MBEDTLS_BSWAP32(mbedtls_get_unaligned_uint32((data) + (offset))) \5C\0A    )\0A\0A/**\0A * Put in memory a 32 bits unsigned integer in big-endian order.\0A *\0A * \5Cparam   n       32 bits unsigned integer to put in memory.\0A * \5Cparam   data    Base address of the memory where to put the 32\0A *                  bits unsigned integer in.\0A * \5Cparam   offset  Offset from \5Cp data where to put the most significant\0A *                  byte of the 32 bits unsigned integer \5Cp n.\0A */\0A#define MBEDTLS_PUT_UINT32_BE(n, data, offset)                                   \5C\0A    {                                                                            \5C\0A        if (MBEDTLS_IS_BIG_ENDIAN)                                               \5C\0A        {                                                                        \5C\0A            mbedtls_put_unaligned_uint32((data) + (offset), (uint32_t) (n));     \5C\0A        }                                                                        \5C\0A        else                                                                     \5C\0A        {                                                                        \5C\0A            mbedtls_put_unaligned_uint32((data) + (offset), MBEDTLS_BSWAP32((uint32_t) (n))); \5C\0A        }                                                                        \5C\0A    }\0A\0A/**\0A * Get the unsigned 32 bits integer corresponding to four bytes in\0A * little-endian order (LSB first).\0A *\0A * \5Cparam   data    Base address of the memory to get the four bytes from.\0A * \5Cparam   offset  Offset from \5Cp data of the first and least significant\0A *                  byte of the four bytes to build the 32 bits unsigned\0A *                  integer from.\0A */\0A#define MBEDTLS_GET_UINT32_LE(data, offset)                                \5C\0A    ((MBEDTLS_IS_BIG_ENDIAN)                                               \5C\0A        ? MBEDTLS_BSWAP32(mbedtls_get_unaligned_uint32((data) + (offset))) \5C\0A        : mbedtls_get_unaligned_uint32((data) + (offset))                  \5C\0A    )\0A\0A\0A/**\0A * Put in memory a 32 bits unsigned integer in little-endian order.\0A *\0A * \5Cparam   n       32 bits unsigned integer to put in memory.\0A * \5Cparam   data    Base address of the memory where to put the 32\0A *                  bits unsigned integer in.\0A * \5Cparam   offset  Offset from \5Cp data where to put the least significant\0A *                  byte of the 32 bits unsigned integer \5Cp n.\0A */\0A#define MBEDTLS_PUT_UINT32_LE(n, data, offset)                                   \5C\0A    {                                                                            \5C\0A        if (MBEDTLS_IS_BIG_ENDIAN)                                               \5C\0A        {                                                                        \5C\0A            mbedtls_put_unaligned_uint32((data) + (offset), MBEDTLS_BSWAP32((uint32_t) (n))); \5C\0A        }                                                                        \5C\0A        else                                                                     \5C\0A        {                                                                        \5C\0A            mbedtls_put_unaligned_uint32((data) + (offset), ((uint32_t) (n)));   \5C\0A        }                                                                        \5C\0A    }\0A\0A/**\0A * Get the unsigned 16 bits integer corresponding to two bytes in\0A * little-endian order (LSB first).\0A *\0A * \5Cparam   data    Base address of the memory to get the two bytes from.\0A * \5Cparam   offset  Offset from \5Cp data of the first and least significant\0A *                  byte of the two bytes to build the 16 bits unsigned\0A *                  integer from.\0A */\0A#define MBEDTLS_GET_UINT16_LE(data, offset)                                \5C\0A    ((MBEDTLS_IS_BIG_ENDIAN)                                               \5C\0A        ? MBEDTLS_BSWAP16(mbedtls_get_unaligned_uint16((data) + (offset))) \5C\0A        : mbedtls_get_unaligned_uint16((data) + (offset))                  \5C\0A    )\0A\0A/**\0A * Put in memory a 16 bits unsigned integer in little-endian order.\0A *\0A * \5Cparam   n       16 bits unsigned integer to put in memory.\0A * \5Cparam   data    Base address of the memory where to put the 16\0A *                  bits unsigned integer in.\0A * \5Cparam   offset  Offset from \5Cp data where to put the least significant\0A *                  byte of the 16 bits unsigned integer \5Cp n.\0A */\0A#define MBEDTLS_PUT_UINT16_LE(n, data, offset)                                   \5C\0A    {                                                                            \5C\0A        if (MBEDTLS_IS_BIG_ENDIAN)                                               \5C\0A        {                                                                        \5C\0A            mbedtls_put_unaligned_uint16((data) + (offset), MBEDTLS_BSWAP16((uint16_t) (n))); \5C\0A        }                                                                        \5C\0A        else                                                                     \5C\0A        {                                                                        \5C\0A            mbedtls_put_unaligned_uint16((data) + (offset), (uint16_t) (n));     \5C\0A        }                                                                        \5C\0A    }\0A\0A/**\0A * Get the unsigned 16 bits integer corresponding to two bytes in\0A * big-endian order (MSB first).\0A *\0A * \5Cparam   data    Base address of the memory to get the two bytes from.\0A * \5Cparam   offset  Offset from \5Cp data of the first and most significant\0A *                  byte of the two bytes to build the 16 bits unsigned\0A *                  integer from.\0A */\0A#define MBEDTLS_GET_UINT16_BE(data, offset)                                \5C\0A    ((MBEDTLS_IS_BIG_ENDIAN)                                               \5C\0A        ? mbedtls_get_unaligned_uint16((data) + (offset))                  \5C\0A        : MBEDTLS_BSWAP16(mbedtls_get_unaligned_uint16((data) + (offset))) \5C\0A    )\0A\0A/**\0A * Put in memory a 16 bits unsigned integer in big-endian order.\0A *\0A * \5Cparam   n       16 bits unsigned integer to put in memory.\0A * \5Cparam   data    Base address of the memory where to put the 16\0A *                  bits unsigned integer in.\0A * \5Cparam   offset  Offset from \5Cp data where to put the most significant\0A *                  byte of the 16 bits unsigned integer \5Cp n.\0A */\0A#define MBEDTLS_PUT_UINT16_BE(n, data, offset)                                   \5C\0A    {                                                                            \5C\0A        if (MBEDTLS_IS_BIG_ENDIAN)                                               \5C\0A        {                                                                        \5C\0A            mbedtls_put_unaligned_uint16((data) + (offset), (uint16_t) (n));     \5C\0A        }                                                                        \5C\0A        else                                                                     \5C\0A        {                                                                        \5C\0A            mbedtls_put_unaligned_uint16((data) + (offset), MBEDTLS_BSWAP16((uint16_t) (n))); \5C\0A        }                                                                        \5C\0A    }\0A\0A/**\0A * Get the unsigned 24 bits integer corresponding to three bytes in\0A * big-endian order (MSB first).\0A *\0A * \5Cparam   data    Base address of the memory to get the three bytes from.\0A * \5Cparam   offset  Offset from \5Cp data of the first and most significant\0A *                  byte of the three bytes to build the 24 bits unsigned\0A *                  integer from.\0A */\0A#define MBEDTLS_GET_UINT24_BE(data, offset)        \5C\0A    (        