;\0A        }\0A\0A        return -1;\0A    }\0A\0A    if (verbose != 0) {\0A        mbedtls_printf(\22  %s test %d passed\5Cn\22, type_name, test_num);\0A    }\0A\0A    return 0;\0A}\0A\0Astatic int mbedtls_sha3_long_kat_test(int verbose,\0A                                      const char *type_name,\0A                                      mbedtls_sha3_id id)\0A{\0A    mbedtls_sha3_context ctx;\0A    unsigned char buffer[1000];\0A    unsigned char hash[64];\0A    int result = 0;\0A\0A    memset(buffer, 'a', 1000);\0A\0A    if (verbose != 0) {\0A        mbedtls_printf(\22  %s long KAT test \22, type_name);\0A    }\0A\0A    mbedtls_sha3_init(&ctx);\0A\0A    result = mbedtls_sha3_starts(&ctx, id);\0A    if (result != 0) {\0A        if (verbose != 0) {\0A            mbedtls_printf(\22setup failed\5Cn \22);\0A        }\0A    }\0A\0A    /* Process 1,000,000 (one million) 'a' characters */\0A    for (int i = 0; i < 1000; i++) {\0A        result = mbedtls_sha3_update(&ctx, buffer, 1000);\0A        if (result != 0) {\0A            if (verbose != 0) {\0A                mbedtls_printf(\22update error code: %i\5Cn\22, result);\0A            }\0A\0A            goto cleanup;\0A        }\0A    }\0A\0A    result = mbedtls_sha3_finish(&ctx, hash, sizeof(hash));\0A    if (result != 0) {\0A        if (verbose != 0) {\0A            mbedtls_printf(\22finish error code: %d\5Cn\22, result);\0A        }\0A\0A        goto cleanup;\0A    }\0A\0A    switch (id) {\0A        case MBEDTLS_SHA3_224:\0A            result = memcmp(hash, long_kat_hash_sha3_224, 28);\0A            break;\0A        case MBEDTLS_SHA3_256:\0A            result = memcmp(hash, long_kat_hash_sha3_256, 32);\0A            break;\0A        case MBEDTLS_SHA3_384:\0A            result = memcmp(hash, long_kat_hash_sha3_384, 48);\0A            break;\0A        case MBEDTLS_SHA3_512:\0A            result = memcmp(hash, long_kat_hash_sha3_512, 64);\0A            break;\0A        default:\0A            break;\0A    }\0A\0A    if (result != 0) {\0A        if (verbose != 0) {\0A            mbedtls_printf(\22failed\5Cn\22);\0A        }\0A    }\0A\0A    if (verbose != 0) {\0A        mbedtls_printf(\22passed\5Cn\22);\0A    }\0A\0Acleanup:\0A    mbedtls_sha3_free(&ctx);\0A    return result;\0A}\0A\0Aint mbedtls_sha3_self_test(int verbose)\0A{\0A    int i;\0A\0A    /* SHA-3 Known Answer Tests (KAT) */\0A    for (i = 0; i < 2; i++) {\0A        if (0 != mbedtls_sha3_kat_test(verbose,\0A                                       \22SHA3-224\22, MBEDTLS_SHA3_224, i)) {\0A            return 1;\0A        }\0A\0A        if (0 != mbedtls_sha3_kat_test(verbose,\0A                                       \22SHA3-256\22, MBEDTLS_SHA3_256, i)) {\0A            return 1;\0A        }\0A\0A        if (0 != mbedtls_sha3_kat_test(verbose,\0A                                       \22SHA3-384\22, MBEDTLS_SHA3_384, i)) {\0A            return 1;\0A        }\0A\0A        if (0 != mbedtls_sha3_kat_test(verbose,\0A                                       \22SHA3-512\22, MBEDTLS_SHA3_512, i)) {\0A            return 1;\0A        }\0A    }\0A\0A    /* SHA-3 long KAT tests */\0A    if (0 != mbedtls_sha3_long_kat_test(verbose,\0A                                        \22SHA3-224\22, MBEDTLS_SHA3_224)) {\0A        return 1;\0A    }\0A\0A    if (0 != mbedtls_sha3_long_kat_test(verbose,\0A                                        \22SHA3-256\22, MBEDTLS_SHA3_256)) {\0A        return 1;\0A    }\0A\0A    if (0 != mbedtls_sha3_long_kat_test(verbose,\0A                                        \22SHA3-384\22, MBEDTLS_SHA3_384)) {\0A        return 1;\0A    }\0A\0A    if (0 != mbedtls_sha3_long_kat_test(verbose,\0A                                        \22SHA3-512\22, MBEDTLS_SHA3_512)) {\0A        return 1;\0A    }\0A\0A    if (verbose != 0) {\0A        mbedtls_printf(\22\5Cn\22);\0A    }\0A\0A    return 0;\0A}\0A#endif /* MBEDTLS_SELF_TEST */\0A\0A#endif /* MBEDTLS_SHA3_C */\0A\00" }
