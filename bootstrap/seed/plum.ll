@.str41952 = private global { i64, i64, [245001 x i8] } { i64 -1, i64 245000, [245001 x i8] c"/**\0A * \5Cfile psa/crypto.h\0A * \5Cbrief Platform Security Architecture cryptography module\0A */\0A/*\0A *  Copyright The Mbed TLS Contributors\0A *  SPDX-License-Identifier: Apache-2.0 OR GPL-2.0-or-later\0A */\0A\0A#ifndef PSA_CRYPTO_H\0A#define PSA_CRYPTO_H\0A\0A#if defined(MBEDTLS_PSA_CRYPTO_PLATFORM_FILE)\0A#include MBEDTLS_PSA_CRYPTO_PLATFORM_FILE\0A#else\0A#include \22crypto_platform.h\22\0A#endif\0A\0A#include <stddef.h>\0A\0A#ifdef __DOXYGEN_ONLY__\0A/* This __DOXYGEN_ONLY__ block contains mock definitions for things that\0A * must be defined in the crypto_platform.h header. These mock definitions\0A * are present in this file as a convenience to generate pretty-printed\0A * documentation that includes those definitions. */\0A\0A/** \5Cdefgroup platform Implementation-specific definitions\0A * @{\0A */\0A\0A/**@}*/\0A#endif /* __DOXYGEN_ONLY__ */\0A\0A#ifdef __cplusplus\0Aextern \22C\22 {\0A#endif\0A\0A/* The file \22crypto_types.h\22 declares types that encode errors,\0A * algorithms, key types, policies, etc. */\0A#include \22crypto_types.h\22\0A\0A/** \5Cdefgroup version API version\0A * @{\0A */\0A\0A/**\0A * The major version of this implementation of the PSA Crypto API\0A */\0A#define PSA_CRYPTO_API_VERSION_MAJOR 1\0A\0A/**\0A * The minor version of this implementation of the PSA Crypto API\0A */\0A#define PSA_CRYPTO_API_VERSION_MINOR 0\0A\0A/**@}*/\0A\0A/* The file \22crypto_values.h\22 declares macros to build and analyze values\0A * of integral types defined in \22crypto_types.h\22. */\0A#include \22crypto_values.h\22\0A\0A/** \5Cdefgroup initialization Library initialization\0A * @{\0A */\0A\0A/**\0A * \5Cbrief Library initialization.\0A *\0A * Applications must call this function before calling any other\0A * function in this module.\0A *\0A * Applications may call this function more than once. Once a call\0A * succeeds, subsequent calls are guaranteed to succeed.\0A *\0A * If the application calls other functions before calling psa_crypto_init(),\0A * the behavior is undefined. Implementations are encouraged to either perform\0A * the operation as if the library had been initialized or to return\0A * #PSA_ERROR_BAD_STATE or some other applicable error. In particular,\0A * implementations should not return a success status if the lack of\0A * initialization may have security implications, for example due to improper\0A * seeding of the random number generator.\0A *\0A * \5Cretval #PSA_SUCCESS \5Cemptydescription\0A * \5Cretval #PSA_ERROR_INSUFFICIENT_MEMORY \5Cemptydescription\0A * \5Cretval #PSA_ERROR_INSUFFICIENT_STORAGE \5Cemptydescription\0A * \5Cretval #PSA_ERROR_COMMUNICATION_FAILURE \5Cemptydescription\0A * \5Cretval #PSA_ERROR_HARDWARE_FAILURE \5Cemptydescription\0A * \5Cretval #PSA_ERROR_CORRUPTION_DETECTED \5Cemptydescription\0A * \5Cretval #PSA_ERROR_INSUFFICIENT_ENTROPY \5Cemptydescription\0A * \5Cretval #PSA_ERROR_STORAGE_FAILURE \5Cemptydescription\0A * \5Cretval #PSA_ERROR_DATA_INVALID \5Cemptydescription\0A * \5Cretval #PSA_ERROR_DATA_CORRUPT \5Cemptydescription\0A */\0Apsa_status_t psa_crypto_init(void);\0A\0A/**@}*/\0A\0A/** \5Caddtogroup attributes\0A * @{\0A */\0A\0A/** \5Cdef PSA_KEY_ATTRIBUTES_INIT\0A *\0A * This macro returns a suitable initializer for a key attribute structure\0A * of type #psa_key_attributes_t.\0A */\0A\0A/** Return an initial value for a key attributes structure.\0A */\0Astatic psa_key_attributes_t psa_key_attributes_init(void);\0A\0A/** Declare a key as persistent and set its key identifier.\0A *\0A * If the attribute structure currently declares the key as volatile (which\0A * is the default content of an attribute structure), this function sets\0A * the lifetime attribute to #PSA_KEY_LIFETIME_PERSISTENT.\0A *\0A * This function does not access storage, it merely stores the given\0A * value in the structure.\0A * The persistent key will be written to storage when the attribute\0A * structure is passed to a key creation function such as\0A * psa_import_key(), psa_generate_key(), psa_generate_key_custom(),\0A * psa_key_derivation_output_key(), psa_key_derivation_output_key_custom()\0A * or psa_copy_key().\0A *\0A * This function may be declared as `static` (i.e. without external\0A * linkage). This function may be provided as a function-like macro,\0A * but in this case it must evaluate each of its arguments exactly once.\0A *\0A * \5Cparam[out] attributes  The attribute structure to write to.\0A * \5Cparam key              The persistent identifier for the key.\0A *                         This can be any value in the range from\0A *                         #PSA_KEY_ID_USER_MIN to #PSA_KEY_ID_USER_MAX\0A *                         inclusive.\0A */\0Astatic void psa_set_key_id(psa_key_attributes_t *attributes,\0A                           mbedtls_svc_key_id_t key);\0A\0A#ifdef MBEDTLS_PSA_CRYPTO_KEY_ID_ENCODES_OWNER\0A/** Set the owner identifier of a key.\0A *\0A * When key identifiers encode key owner identifiers, psa_set_key_id() does\0A * not allow to define in key attributes the owner of volatile keys as\0A * psa_set_key_id() enforces the key to be persistent.\0A *\0A * This function allows to set in key attributes the owner identifier of a\0A * key. It is intended to be used for volatile keys. For persistent keys,\0A * it is recommended to use the PSA Cryptography API psa_set_key_id() to define\0A * the owner of a key.\0A *\0A * \5Cparam[out] attributes  The attribute structure to write to.\0A * \5Cparam owner            The key owner identifier.\0A */\0Astatic void mbedtls_set_key_owner_id(psa_key_attributes_t *attributes,\0A                                     mbedtls_key_owner_id_t owner);\0A#endif\0A\0A/** Set the location of a persistent key.\0A *\0A * To make a key persistent, you must give it a persistent key identifier\0A * with psa_set_key_id(). By default, a key that has a persistent identifier\0A * is stored in the default storage area identifier by\0A * #PSA_KEY_LIFETIME_PERSISTENT. Call this function to choose a storage\0A * area, or to explicitly declare the key as volatile.\0A *\0A * This function does not access storage, it merely stores the given\0A * value in the structure.\0A * The persistent key will be written to storage when the attribute\0A * structure is passed to a key creation function such as\0A * psa_import_key(), psa_generate_key(), psa_generate_key_custom(),\0A * psa_key_derivation_output_key(), psa_key_derivation_output_key_custom()\0A * or psa_copy_key().\0A *\0A * This function may be declared as `static` (i.e. without external\0A * linkage). This function may be provided as a function-like macro,\0A * but in this case it must evaluate each of its arguments exactly once.\0A *\0A * \5Cparam[out] attributes       The attribute structure to write to.\0A * \5Cparam lifetime              The lifetime for the key.\0A *                              If this is #PSA_KEY_LIFETIME_VOLATILE, the\0A *                              key will be volatile, and the key identifier\0A *                              attribute is reset to 0.\0A */\0Astatic void psa_set_key_lifetime(psa_key_attributes_t *attributes,\0A                                 psa_key_lifetime_t lifetime);\0A\0A/** Retrieve the key identifier from key attributes.\0A *\0A * This function may be declared as `static` (i.e. without external\0A * linkage). This function may be provided as a function-like macro,\0A * but in this case it must evaluate its argument exactly once.\0A *\0A * \5Cparam[in] attributes        The key attribute structure to query.\0A *\0A * \5Creturn The persistent identifier stored in the attribute structure.\0A *         This value is unspecified if the attribute structure declares\0A *         the key as volatile.\0A */\0Astatic mbedtls_svc_key_id_t psa_get_key_id(\0A    const psa_key_attributes_t *attributes);\0A\0A/** Retrieve the lifetime from key attributes.\0A *\0A * This function may be declared as `static` (i.e. without external\0A * linkage). This function may be provided as a function-like macro,\0A * but in this case it must evaluate its argument exactly once.\0A *\0A * \5Cparam[in] attributes        The key attribute structure to query.\0A *\0A * \5Creturn The lifetime value stored in the attribute structure.\0A */\0Astatic psa_key_lifetime_t psa_get_key_lifetime(\0A    const psa_key_attributes_t *attributes);\0A\0A/** Declare usage flags for a key.\0A *\0A * Usage flags are part of a key's usage policy. They encode what\0A * kind of operations are permitted on the key. For more details,\0A * refer to the documentation of the type #psa_key_usage_t.\0A *\0A * This function overwrites any usage flags\0A * previously set in \5Cp attributes.\0A *\0A * This function may be declared as `static` (i.e. without external\0A * linkage). This function may be provided as a function-like macro,\0A * but in this case it must evaluate each of its arguments exactly once.\0A *\0A * \5Cparam[out] attributes       The attribute structure to write to.\0A * \5Cparam usage_flags           The usage flags to write.\0A */\0Astatic void psa_set_key_usage_flags(psa_key_attributes_t *attributes,\0A                                    psa_key_usage_t usage_flags);\0A\0A/** Retrieve the usage flags from key attributes.\0A *\0A * This function may be declared as `static` (i.e. without external\0A * linkage). This function may be provided as a function-like macro,\0A * but in this case it must evaluate its argument exactly once.\0A *\0A * \5Cparam[in] attributes        The key attribute structure to query.\0A *\0A * \5Creturn The usage flags stored in the attribute structure.\0A */\0Astatic psa_key_usage_t psa_get_key_usage_flags(\0A    const psa_key_attributes_t *attributes);\0A\0A/** Declare the permitted algorithm policy for a key.\0A *\0A * The permitted algorithm policy of a key encodes which algorithm or\0A * algorithms are permitted to be used with this key. The following\0A * algorithm policies are supported:\0A * - 0 does not allow any cryptographic operation with the key. The key\0A *   may be used for non-cryptographic actions such as exporting (if\0A *   permitted by the usage flags).\0A * - An algorithm value permits this particular algorithm.\0A * - An algorithm wildcard built from #PSA_ALG_ANY_HASH allows the specified\0A *   signature scheme with any hash algorithm.\0A * - An algorithm built from #PSA_ALG_AT_LEAST_THIS_LENGTH_MAC allows\0A *   any MAC algorithm from the same base class (e.g. CMAC) which\0A *   generates/verifies a MAC length greater than or equal to the length\0A *   encoded in the wildcard algorithm.\0A * - An algorithm built from #PSA_ALG_AEAD_WITH_AT_LEAST_THIS_LENGTH_TAG\0A *   allows any AEAD algorithm from the same base class (e.g. CCM) which\0A *   generates/verifies a tag length greater than or equal to the length\0A *   encoded in the wildcard algorithm.\0A *\0A * This function overwrites any algorithm policy\0A * previously set in \5Cp attributes.\0A *\0A * This function may be declared as `static` (i.e. without external\0A * linkage). This function may be provided as a function-like macro,\0A * but in this case it must evaluate each of its arguments exactly once.\0A *\0A * \5Cparam[out] attributes       The attribute structure to write to.\0A * \5Cparam alg                   The permitted algorithm policy to write.\0A */\0Astatic void psa_set_key_algorithm(psa_key_attributes_t *attributes,\0A                                  psa_algorithm_t alg);\0A\0A\0A/** Retrieve the algorithm policy from key attributes.\0A *\0A * This function may be declared as `static` (i.e. without external\0A * linkage). This function may be provided as a function-like macro,\0A * but in this case it must evaluate its argument exactly once.\0A *\0A * \5Cparam[in] attributes        The key attribute structure to query.\0A *\0A * \5Creturn The algorithm stored in the attribute structure.\0A */\0Astatic psa_algorithm_t psa_get_key_algorithm(\0A    const psa_key_attributes_t *attributes);\0A\0A/** Declare the type of a key.\0A *\0A * This function overwrites any key type\0A * previously set in \5Cp attributes.\0A *\0A * This function may be declared as `static` (i.e. without external\0A * linkage). This function may be provided as a function-like macro,\0A * but in this case it must evaluate each of its arguments exactly once.\0A *\0A * \5Cparam[out] attributes       The attribute structure to write to.\0A * \5Cparam type                  The key type to write.\0A *                              If this is 0, the key type in \5Cp attributes\0A *                              becomes unspecified.\0A */\0Astatic void psa_set_key_type(psa_key_attributes_t *attributes,\0A                             psa_key_type_t type);\0A\0A\0A/** Declare the size of a key.\0A *\0A * This function overwrites any key size previously set in \5Cp attributes.\0A *\0A * This function may be declared as `static` (i.e. without external\0A * linkage). This function may be provided as a function-like macro,\0A * but in this case it must evaluate each of its arguments exactly once.\0A *\0A * \5Cparam[out] attributes       The attribute structure to write to.\0A * \5Cparam bits                  The key size in bits.\0A *                              If this is 0, the key size in \5Cp attributes\0A *                              becomes unspecified. Keys of size 0 are\0A *                              not supported.\0A */\0Astatic void psa_set_key_bits(psa_key_attributes_t *attributes,\0A                             size_t bits);\0A\0A/** Retrieve the key type from key attributes.\0A *\0A * This function may be declared as `static` (i.e. without external\0A * linkage). This function may be provided as a function-like macro,\0A * but in this case it must evaluate its argument exactly once.\0A *\0A * \5Cparam[in] attributes        The key attribute structure to query.\0A *\0A * \5Creturn The key type stored in the attribute structure.\0A */\0Astatic psa_key_type_t psa_get_key_type(const psa_key_attributes_t *attributes);\0A\0A/** Retrieve the key size from key attributes.\0A *\0A * This function may be declared as `static` (i.e. without external\0A * linkage). This function may be provided as a function-like macro,\0A * but in this case it must evaluate its argument exactly once.\0A *\0A * \5Cparam[in] attributes        The key attribute structure to query.\0A *\0A * \5Creturn The key size stored in the attribute structure, in bits.\0A */\0Astatic size_t psa_get_key_bits(const psa_key_attributes_t *attributes);\0A\0A/** Retrieve the attributes of a key.\0A *\0A * This function first resets the attribute structure as with\0A * psa_reset_key_attributes(). It then copies the attributes of\0A * the given key into the given attribute structure.\0A *\0A * \5Cnote This function may allocate memory or other resources.\0A *       Once you have called this function on an attribute structure,\0A *       you must call psa_reset_key_attributes() to free these resources.\0A *\0A * \5Cparam[in] key               Identifier of the key to query.\0A * \5Cparam[in,out] attributes    On success, the attributes of the key.\0A *                              On failure, equivalent to a\0A *                              freshly-initialized structure.\0A *\0A * \5Cretval #PSA_SUCCESS \5Cemptydescription\0A * \5Cretval #PSA_ERROR_INVALID_HANDLE \5Cemptydescription\0A * \5Cretval #PSA_ERROR_INSUFFICIENT_MEMORY \5Cemptydescription\0A * \5Cretval #PSA_ERROR_COMMUNICATION_FAILURE \5Cemptydescription\0A * \5Cretval #PSA_ERROR_CORRUPTION_DETECTED \5Cemptydescription\0A * \5Cretval #PSA_ERROR_STORAGE_FAILURE \5Cemptydescription\0A * \5Cretval #PSA_ERROR_DATA_CORRUPT \5Cemptydescription\0A * \5Cretval #PSA_ERROR_DATA_INVALID \5Cemptydescription\0A * \5Cretval #PSA_ERROR_BAD_STATE\0A *         The library has not been previously initialized by psa_crypto_init().\0A *         It is implementation-dependent whether a failure to initialize\0A *         results in this error code.\0A */\0Apsa_status_t psa_get_key_attributes(mbedtls_svc_key_id_t key,\0A                                    psa_key_attributes_t *attributes);\0A\0A/** Reset a key attribute structure to a freshly initialized state.\0A *\0A * You must initialize the attribute structure as described in the\0A * documentation of the type #psa_key_attributes_t before calling this\0A * function. Once the structure has been initialized, you may call this\0A * function at any time.\0A *\0A * This function frees any auxiliary resources that the structure\0A * may contain.\0A *\0A * \5Cparam[in,out] attributes    The attribute structure to reset.\0A */\0Avoid psa_reset_key_attributes(psa_key_attributes_t *attributes);\0A\0A/**@}*/\0A\0A/** \5Cdefgroup key_management Key management\0A * @{\0A */\0A\0A/** Remove non-essential copies of key material from memory.\0A *\0A * If the key identifier designates a volatile key, this functions does not do\0A * anything and returns successfully.\0A *\0A * If the key identifier designates a persistent key, then this function will\0A * free all resources associated with the key in volatile memory. The key\0A * data in persistent storage is not affected and the key can still be used.\0A *\0A * \5Cparam key Identifier of the key to purge.\0A *\0A * \5Cretval #PSA_SUCCESS\0A *         The key material will have been removed from memory if it is not\0A *         currently required.\0A * \5Cretval #PSA_ERROR_INVALID_ARGUMENT\0A *         \5Cp key is not a valid key identifier.\0A * \5Cretval #PSA_ERROR_BAD_STATE\0A *         The library has not been previously initialized by psa_crypto_init().\0A *         It is implementation-dependent whether a failure to initialize\0A *         results in this error code.\0A */\0Apsa_status_t psa_purge_key(mbedtls_svc_key_id_t key);\0A\0A/** Make a copy of a key.\0A *\0A * Copy key material from one location to another.\0A *\0A * This function is primarily useful to copy a key from one location\0A * to another, since it populates a key using the material from\0A * another key which may have a different lifetime.\0A *\0A * This function may be used to share a key with a different party,\0A * subject to implementation-defined restrictions on key sharing.\0A *\0A * The policy on the source key must have the usage flag\0A * #PSA_KEY_USAGE_COPY set.\0A * This flag is sufficient to permit the copy if the key has the lifetime\0A * #PSA_KEY_LIFETIME_VOLATILE or #PSA_KEY_LIFETIME_PERSISTENT.\0A * Some secure elements do not provide a way to copy a key without\0A * making it extractable from the secure element. If a key is located\0A * in such a secure element, then the key must have both usage flags\0A * #PSA_KEY_USAGE_COPY and #PSA_KEY_USAGE_EXPORT in order to make\0A * a copy of the key outside the secure element.\0A *\0A * The resulting key may only be used in a way that conforms to\0A * both the policy of the original key and the policy specified in\0A * the \5Cp attributes parameter:\0A * - The usage flags on the resulting key are the bitwise-and of the\0A *   usage flags on the source policy and the usage flags in \5Cp attributes.\0A * - If both allow the same algorithm or wildcard-based\0A *   algorithm policy, the resulting key has the same algorithm policy.\0A * - If either of the policies allows an algorithm and the other policy\0A *   allows a wildcard-based algorithm policy that includes this algorithm,\0A *   the resulting key allows the same algorithm.\0A * - If the policies do not allow any algorithm in common, this function\0A *   fails with the status #PSA_ERROR_INVALID_ARGUMENT.\0A *\0A * The effect of this function on implementation-defined attributes is\0A * implementation-defined.\0A *\0A * \5Cparam source_key        The key to copy. It must allow the usage\0A *                          #PSA_KEY_USAGE_COPY. If a private or secret key is\0A *                          being copied outside of a secure element it must\0A *                          also allow #PSA_KEY_USAGE_EXPORT.\0A * \5Cparam[in] attributes    The attributes for the new key.\0A *                          They are used as follows:\0A *                          - The key type and size may be 0. If either is\0A *                            nonzero, it must match the corresponding\0A *                            attribute of the source key.\0A *                          - The key location (the lifetime and, for\0A *                            persistent keys, the key identifier) is\0A *                            used directly.\0A *                          - The policy constraints (usage flags and\0A *                            algorithm policy) are combined from\0A *                            the source key and \5Cp attributes so that\0A *                            both sets of restrictions apply, as\0A *                            described in the documentation of this function.\0A * \5Cparam[out] target_key   On success, an identifier for the newly created\0A *                          key. For persistent keys, this is the key\0A *                          identifier defined in \5Cp attributes.\0A *                          \5Cc 0 on failure.\0A *\0A * \5Cretval #PSA_SUCCESS \5Cemptydescription\0A * \5Cretval #PSA_ERROR_INVALID_HANDLE\0A *         \5Cp source_key is invalid.\0A * \5Cretval #PSA_ERROR_ALREADY_EXISTS\0A *         This is an attempt to create a persistent key, and there is\0A *         already a persistent key with the given identifier.\0A * \5Cretval #PSA_ERROR_INVALID_ARGUMENT\0A *         The lifetime or identifier in \5Cp attributes are invalid, or\0A *         the policy constraints on the source and specified in\0A *         \5Cp attributes are incompatible, or\0A *         \5Cp attributes specifies a key type or key size\0A *         which does not match the attributes of the source key.\0A * \5Cretval #PSA_ERROR_NOT_PERMITTED\0A *         The source key does not have the #PSA_KEY_USAGE_COPY usage flag, or\0A *         the source key is not exportable and its lifetime does not\0A *         allow copying it to the target's lifetime.\0A * \5Cretval #PSA_ERROR_INSUFFICIENT_MEMORY \5Cemptydescription\0A * \5Cretval #PSA_ERROR_INSUFFICIENT_STORAGE \5Cemptydescription\0A * \5Cretval #PSA_ERROR_COMMUNICATION_FAILURE \5Cemptydescription\0A * \5Cretval #PSA_ERROR_HARDWARE_FAILURE \5Cemptydescription\0A * \5Cretval #PSA_ERROR_DATA_INVALID \5Cemptydescription\0A * \5Cretval #PSA_ERROR_DATA_CORRUPT \5Cemptydescription\0A * \5Cretval #PSA_ERROR_STORAGE_FAILURE \5Cemptydescription\0A * \5Cretval #PSA_ERROR_CORRUPTION_DETECTED \5Cemptydescription\0A * \5Cretval #PSA_ERROR_BAD_STATE\0A *         The library has not been previously initialized by psa_crypto_init().\0A *         It is implementation-dependent whether a failure to initialize\0A *         results in this error code.\0A */\0Apsa_status_t psa_copy_key(mbedtls_svc_key_id_t source_key,\0A                          const psa_key_attributes_t *attributes,\0A                          mbedtls_svc_key_id_t *target_key);\0A\0A\0A/**\0A * \5Cbrief Destroy a key.\0A *\0A * This function destroys a key from both volatile\0A * memory and, if applicable, non-volatile storage. Implementations shall\0A * make a best effort to ensure that the key material cannot be recovered.\0A *\0A * This function also erases any metadata such as policies and frees\0A * resources associated with the key.\0A *\0A * If a key is currently in use in a multipart operation, then destroying the\0A * key will cause the multipart operation to fail.\0A *\0A * \5Cwarning    We can only guarantee that the the key material will\0A *             eventually be wiped from memory. With threading enabled\0A *             and during concurrent execution, copies of the key material may\0A *             still exist until all threads have finished using the key.\0A *\0A * \5Cparam key  Identifier of the key to erase. If this is \5Cc 0, do nothing and\0A *             return #PSA_SUCCESS.\0A *\0A * \5Cretval #PSA_SUCCESS\0A *         \5Cp key was a valid identifier and the key material that it\0A *         referred to has been erased. Alternatively, \5Cp key is \5Cc 0.\0A * \5Cretval #PSA_ERROR_NOT_PERMITTED\0A *         The key cannot be erased because it is\0A *         read-only, either due to a policy or due to physical restrictions.\0A * \5Cretval #PSA_ERROR_INVALID_HANDLE\0A *         \5Cp key is not a valid identifier nor \5Cc 0.\0A * \5Cretval #PSA_ERROR_COMMUNICATION_FAILURE\0A *         There was a failure in communication with the cryptoprocessor.\0A *         The key material may still be present in the cryptoprocessor.\0A * \5Cretval #PSA_ERROR_DATA_INVALID\0A *         This error is typically a result of either storage corruption on a\0A *         cleartext storage backend, or an attempt to read data that was\0A *         written by an incompatible version of the library.\0A * \5Cretval #PSA_ERROR_STORAGE_FAILURE\0A *         The storage is corrupted. Implementations shall make a best effort\0A *         to erase key material even in this stage, however applications\0A *         should be aware that it may be impossible to guarantee that the\0A *         key material is not recoverable in such cases.\0A * \5Cretval #PSA_ERROR_CORRUPTION_DETECTED\0A *         An unexpected condition which is not a storage corruption or\0A *         a communication failure occurred. The cryptoprocessor may have\0A *         been compromised.\0A * \5Cretval #PSA_ERROR_BAD_STATE\0A *         The library has not been previously initialized by psa_crypto_init().\0A *         It is implementation-dependent whether a failure to initialize\0A *         results in this error code.\0A */\0Apsa_status_t psa_destroy_key(mbedtls_svc_key_id_t key);\0A\0A/**@}*/\0A\0A/** \5Cdefgroup import_export Key import and export\0A * @{\0A */\0A\0A/**\0A * \5Cbrief Import a key in binary format.\0A *\0A * This function supports any output from psa_export_key(). Refer to the\0A * documentation of psa_export_public_key() for the format of public keys\0A * and to the documentation of psa_export_key() for the format for\0A * other key types.\0A *\0A * The key data determines the key size. The attributes may optionally\0A * specify a key size; in this case it must match the size determined\0A * from the key data. A key size of 0 in \5Cp attributes indicates that\0A * the key size is solely determined by the key data.\0A *\0A * Implementations must reject an attempt to import a key of size 0.\0A *\0A * This specification supports a single format for each key type.\0A * Implementations may support other formats as long as the standard\0A * format is supported. Implementations that support other formats\0A * should ensure that the formats are clearly unambiguous so as to\0A * minimize the risk that an invalid input is accidentally interpreted\0A * according to a different format.\0A *\0A * \5Cparam[in] attributes    The attributes for the new key.\0A *                          The key size is always determined from the\0A *                          \5Cp data buffer.\0A *                          If the key size in \5Cp attributes is nonzero,\0A *                          it must be equal to the size from \5Cp data.\0A * \5Cparam[out] key          On success, an identifier to the newly created key.\0A *                          For persistent keys, this is the key identifier\0A *                          defined in \5Cp attributes.\0A *                          \5Cc 0 on failure.\0A * \5Cparam[in] data    Buffer containing the key data. The content of this\0A *                    buffer is interpreted according to the type declared\0A *                    in \5Cp attributes.\0A *                    All implementations must support at least the format\0A *                    described in the documentation\0A *                    of psa_export_key() or psa_export_public_key() for\0A *                    the chosen type. Implementations may allow other\0A *                    formats, but should be conservative: implementations\0A *                    should err on the side of rejecting content if it\0A *                    may be erroneous (e.g. wrong type or truncated data).\0A * \5Cparam data_length Size of the \5Cp data buffer in bytes.\0A *\0A * \5Cretval #PSA_SUCCESS\0A *         Success.\0A *         If the key is persistent, the key material and the key's metadata\0A *         have been saved to persistent storage.\0A * \5Cretval #PSA_ERROR_ALREADY_EXISTS\0A *         This is an attempt to create a persistent key, and there is\0A *         already a persistent key with the given identifier.\0A * \5Cretval #PSA_ERROR_NOT_SUPPORTED\0A *         The key type or key size is not supported, either by the\0A *         implementation in general or in this particular persistent location.\0A * \5Cretval #PSA_ERROR_INVALID_ARGUMENT\0A *         The key attributes, as a whole, are invalid, or\0A *         the key data is not correctly formatted, or\0A *         the size in \5Cp attributes is nonzero and does not match the size\0A *         of the key data.\0A * \5Cretval #PSA_ERROR_INSUFFICIENT_MEMORY \5Cemptydescription\0A * \5Cretval #PSA_ERROR_INSUFFICIENT_STORAGE \5Cemptydescription\0A * \5Cretval #PSA_ERROR_COMMUNICATION_FAILURE \5Cemptydescription\0A * \5Cretval #PSA_ERROR_DATA_CORRUPT \5Cemptydescription\0A * \5Cretval #PSA_ERROR_DATA_INVALID \5Cemptydescription\0A * \5Cretval #PSA_ERROR_STORAGE_FAILURE \5Cemptydescription\0A * \5Cretval #PSA_ERROR_HARDWARE_FAILURE \5Cemptydescription\0A * \5Cretval #PSA_ERROR_CORRUPTION_DETECTED \5Cemptydescription\0A * \5Cretval #PSA_ERROR_BAD_STATE\0A *         The library has not been previously initialized by psa_crypto_init().\0A *         It is implementation-dependent whether a failure to initialize\0A *         results in this error code.\0A */\0Apsa_status_t psa_import_key(const psa_key_attributes_t *attributes,\0A                            const uint8_t *data,\0A                            size_t data_length,\0A                            mbedtls_svc_key_id_t *key);\0A\0A\0A\0A/**\0A * \5Cbrief Export a key in binary format.\0A *\0A * The output of this function can be passed to psa_import_key() to\0A * create an equivalent object.\0A *\0A * If the implementation of psa_import_key() supports other formats\0A * beyond the format specified here, the output from psa_export_key()\0A * must use the representation specified here, not the original\0A * representation.\0A *\0A * For standard key types, the output format is as follows:\0A *\0A * - For symmetric keys (including MAC keys), the format is the\0A *   raw bytes of the key.\0A * - For DES, the key data consists of 8 bytes. The parity bits must be\0A *   correct.\0A * - For Triple-DES, the format is the concatenation of the\0A *   two or three DES keys.\0A * - For RSA key pairs (#PSA_KEY_TYPE_RSA_KEY_PAIR), the format\0A *   is the non-encrypted DER encoding of the representation defined by\0A *   PKCS\5C#1 (RFC 8017) as `RSAPrivateKey`, version 0.\0A *   ```\0A *   RSAPrivateKey ::= SEQUENCE {\0A *       version             INTEGER,  -- must be 0\0A *       modulus             INTEGER,  -- n\0A *       publicExponent      INTEGER,  -- e\0A *       privateExponent     INTEGER,  -- d\0A *       prime1              INTEGER,  -- p\0A *       prime2              INTEGER,  -- q\0A *       exponent1           INTEGER,  -- d mod (p-1)\0A *       exponent2           INTEGER,  -- d mod (q-1)\0A *       coefficient         INTEGER,  -- (inverse of q) mod p\0A *   }\0A *   ```\0A * - For elliptic curve key pairs (key types for which\0A *   #PSA_KEY_TYPE_IS_ECC_KEY_PAIR is true), the format is\0A *   a representation of the private value as a `ceiling(m/8)`-byte string\0A *   where `m` is the bit size associated with the curve, i.e. the bit size\0A *   of the order of the curve's coordinate field. This byte string is\0A *   in little-endian order for Montgomery curves (curve types\0A *   `PSA_ECC_FAMILY_CURVEXXX`), and in big-endian order for Weierstrass\0A *   curves (curve types `PSA_ECC_FAMILY_SECTXXX`, `PSA_ECC_FAMILY_SECPXXX`\0A *   and `PSA_ECC_FAMILY_BRAINPOOL_PXXX`).\0A *   For Weierstrass curves, this is the content of the `privateKey` field of\0A *   the `ECPrivateKey` format defined by RFC 5915.  For Montgomery curves,\0A *   the format is defined by RFC 7748, and output is masked according to §5.\0A *   For twisted Edwards curves, the private key is as defined by RFC 8032\0A *   (a 32-byte string for Edwards25519, a 57-byte string for Edwards448).\0A * - For Diffie-Hellman key exchange key pairs (key types for which\0A *   #PSA_KEY_TYPE_IS_DH_KEY_PAIR is true), the\0A *   format is the representation of the private key `x` as a big-endian byte\0A *   string. The length of the byte string is the private key size in bytes\0A *   (leading zeroes are not stripped).\0A * - For public keys (key types for which #PSA_KEY_TYPE_IS_PUBLIC_KEY is\0A *   true), the format is the same as for psa_export_public_key().\0A *\0A * The policy on the key must have the usage flag #PSA_KEY_USAGE_EXPORT set.\0A *\0A * \5Cparam key               Identifier of the key to export. It must allow the\0A *                          usage #PSA_KEY_USAGE_EXPORT, unless it is a public\0A *                          key.\0A * \5Cparam[out] data         Buffer where the key data is to be written.\0A * \5Cparam data_size         Size of the \5Cp data buffer in bytes.\0A * \5Cparam[out] data_length  On success, the number of bytes\0A *                          that make up the key data.\0A *\0A * \5Cretval #PSA_SUCCESS \5Cemptydescription\0A * \5Cretval #PSA_ERROR_INVALID_HANDLE \5Cemptydescription\0A * \5Cretval #PSA_ERROR_NOT_PERMITTED\0A *         The key does not have the #PSA_KEY_USAGE_EXPORT flag.\0A * \5Cretval #PSA_ERROR_NOT_SUPPORTED \5Cemptydescription\0A * \5Cretval #PSA_ERROR_BUFFER_TOO_SMALL\0A *         The size of the \5Cp data buffer is too small. You can determine a\0A *         sufficient buffer size by calling\0A *         #PSA_EXPORT_KEY_OUTPUT_SIZE(\5Cc type, \5Cc bits)\0A *         where \5Cc type is the key type\0A *         and \5Cc bits is the key size in bits.\0A * \5Cretval #PSA_ERROR_COMMUNICATION_FAILURE \5Cemptydescription\0A * \5Cretval #PSA_ERROR_HARDWARE_FAILURE \5Cemptydescription\0A * \5Cretval #PSA_ERROR_CORRUPTION_DETECTED \5Cemptydescription\0A * \5Cretval #PSA_ERROR_STORAGE_FAILURE \5Cemptydescription\0A * \5Cretval #PSA_ERROR_INSUFFICIENT_MEMORY \5Cemptydescription\0A * \5Cretval #PSA_ERROR_BAD_STATE\0A *         The library has not been previously initialized by psa_crypto_init().\0A *         It is implementation-dependent whether a failure to initialize\0A *         results in this error code.\0A */\0Apsa_status_t psa_export_key(mbedtls_svc_key_id_t key,\0A                            uint8_t *data,\0A                            size_t data_size,\0A                            size_t *data_length);\0A\0A/**\0A * \5Cbrief Export a public key or the public part of a key pair in binary format.\0A *\0A * The output of this function can be passed to psa_import_key() to\0A * create an object that is equivalent to the public key.\0A *\0A * This specification supports a single format for each key type.\0A * Implementations may support other formats as long as the standard\0A * format is supported. Implementations that support other formats\0A * should ensure that the formats are clearly unambiguous so as to\0A * minimize the risk that an invalid input is accidentally interpreted\0A * according to a different format.\0A *\0A * For standard key types, the output format is as follows:\0A * - For RSA public keys (#PSA_KEY_TYPE_RSA_PUBLIC_KEY), the DER encoding of\0A *   the representation defined by RFC 3279 &sect;2.3.1 as `RSAPublicKey`.\0A *   ```\0A *   RSAPublicKey ::= SEQUENCE {\0A *      modulus            INTEGER,    -- n\0A *      publicExponent     INTEGER  }  -- e\0A *   ```\0A * - For elliptic curve keys on a twisted Edwards curve (key types for which\0A *   #PSA_KEY_TYPE_IS_ECC_PUBLIC_KEY is true and #PSA_KEY_TYPE_ECC_GET_FAMILY\0A *   returns #PSA_ECC_FAMILY_TWISTED_EDWARDS), the public key is as defined\0A *   by RFC 8032\0A *   (a 32-byte string for Edwards25519, a 57-byte string for Edwards448).\0A * - For other elliptic curve public keys (key types for which\0A *   #PSA_KEY_TYPE_IS_ECC_PUBLIC_KEY is true), the format is the uncompressed\0A *   representation defined by SEC1 &sect;2.3.3 as the content of an ECPoint.\0A *   Let `m` be the bit size associated with the curve, i.e. the bit size of\0A *   `q` for a curve over `F_q`. The representation consists of:\0A *      - The byte 0x04;\0A *      - `x_P` as a `ceiling(m/8)`-byte string, big-endian;\0A *      - `y_P` as a `ceiling(m/8)`-byte string, big-endian.\0A * - For Diffie-Hellman key exchange public keys (key types for which\0A *   #PSA_KEY_TYPE_IS_DH_PUBLIC_KEY is true),\0A *   the format is the representation of the public key `y = g^x mod p` as a\0A *   big-endian byte string. The length of the byte string is the length of the\0A *   base prime `p` in bytes.\0A *\0A * Exporting a public key object or the public part of a key pair is\0A * always permitted, regardless of the key's usage flags.\0A *\0A * \5Cparam key               Identifier of the key to export.\0A * \5Cparam[out] data         Buffer where the key data is to be written.\0A * \5Cparam data_size         Size of the \5Cp data buffer in bytes.\0A * \5Cparam[out] data_length  On success, the number of bytes\0A *                          that make up the key data.\0A *\0A * \5Cretval #PSA_SUCCESS \5Cemptydescription\0A * \5Cretval #PSA_ERROR_INVALID_HANDLE \5Cemptydescription\0A * \5Cretval #PSA_ERROR_INVALID_ARGUMENT\0A *         The key is neither a public key nor a key pair.\0A * \5Cretval #PSA_ERROR_NOT_SUPPORTED \5Cemptydescription\0A * \5Cretval #PSA_ERROR_BUFFER_TOO_SMALL\0A *         The size of the \5Cp data buffer is too small. You can determine a\0A *         sufficient buffer size by calling\0A *         #PSA_EXPORT_KEY_OUTPUT_SIZE(#PSA_KEY_TYPE_PUBLIC_KEY_OF_KEY_PAIR(\5Cc type), \5Cc bits)\0A *         where \5Cc type is the key type\0A *         and \5Cc bits is the key size in bits.\0A * \5Cretval #PSA_ERROR_COMMUNICATION_FAILURE \5Cemptydescription\0A * \5Cretval #PSA_ERROR_HARDWARE_FAILURE \5Cemptydescription\0A * \5Cretval #PSA_ERROR_CORRUPTION_DETECTED \5Cemptydescription\0A * \5Cretval #PSA_ERROR_STORAGE_FAILURE \5Cemptydescription\0A * \5Cretval #PSA_ERROR_INSUFFICIENT_MEMORY \5Cemptydescription\0A * \5Cretval #PSA_ERROR_BAD_STATE\0A *         The library has not been previously initialized by psa_crypto_init().\0A *         It is implementation-dependent whether a failure to initialize\0A *         results in this error code.\0A */\0Apsa_status_t psa_export_public_key(mbedtls_svc_key_id_t key,\0A                                   uint8_t *data,\0A                                   size_t data_size,\0A                                   size_t *data_length);\0A\0A\0A\0A/**@}*/\0A\0A/** \5Cdefgroup hash Message digests\0A * @{\0A */\0A\0A/** Calculate the hash (digest) of a message.\0A *\0A * \5Cnote To verify the hash of a message against an\0A *       expected value, use psa_hash_compare() instead.\0A *\0A * \5Cparam alg               The hash algorithm to compute (\5Cc PSA_ALG_XXX value\0A *                          such that #PSA_ALG_IS_HASH(\5Cp alg) is true).\0A * \5Cparam[in] input         Buffer containing the message to hash.\0A * \5Cparam input_length      Size of the \5Cp input buffer in bytes.\0A * \5Cparam[out] hash         Buffer where the hash is to be written.\0A * \5Cparam hash_size         Size of the \5Cp hash buffer in bytes.\0A * \5Cparam[out] hash_length  On success, the number of bytes\0A *                          that make up the hash value. This is always\0A *                          #PSA_HASH_LENGTH(\5Cp alg).\0A *\0A * \5Cretval #PSA_SUCCESS\0A *         Success.\0A * \5Cretval #PSA_ERROR_NOT_SUPPORTED\0A *         \5Cp alg is not supported or is not a hash algorithm.\0A * \5Cretval #PSA_ERROR_INVALID_ARGUMENT \5Cemptydescription\0A * \5Cretval #PSA_ERROR_BUFFER_TOO_SMALL\0A *         \5Cp hash_size is too small\0A * \5Cretval #PSA_ERROR_INSUFFICIENT_MEMORY \5Cemptydescription\0A * \5Cretval #PSA_ERROR_COMMUNICATION_FAILURE \5Cemptydescription\0A * \5Cretval #PSA_ERROR_HARDWARE_FAILURE \5Cemptydescription\0A * \5Cretval #PSA_ERROR_CORRUPTION_DETECTED \5Cemptydescription\0A * \5Cretval #PSA_ERROR_BAD_STATE\0A *         The library has not been previously initialized by psa_crypto_init().\0A *         It is implementation-dependent whether a failure to initialize\0A *         results in this error code.\0A */\0Apsa_status_t psa_hash_compute(psa_algorithm_t alg,\0A                              const uint8_t *input,\0A                              size_t input_length,\0A                              uint8_t *hash,\0A                              size_t hash_size,\0A                              size_t *hash_length);\0A\0A/** Calculate the hash (digest) of a message and compare it with a\0A * reference value.\0A *\0A * \5Cparam alg               The hash algorithm to compute (\5Cc PSA_ALG_XXX value\0A *                          such that #PSA_ALG_IS_HASH(\5Cp alg) is true).\0A * \5Cparam[in] input         Buffer containing the message to hash.\0A * \5Cparam input_length      Size of the \5Cp input buffer in bytes.\0A * \5Cparam[in] hash          Buffer containing the expected hash value.\0A * \5Cparam hash_length       Size of the \5Cp hash buffer in bytes.\0A *\0A * \5Cretval #PSA_SUCCESS\0A *         The expected hash is identical to the actual hash of the input.\0A * \5Cretval #PSA_ERROR_INVALID_SIGNATURE\0A *         The hash of the message was calculated successfully, but it\0A *         differs from the expected hash.\0A * \5Cretval #PSA_ERROR_NOT_SUPPORTED\0A *         \5Cp alg is not supported or is not a hash algorithm.\0A * \5Cretval #PSA_ERROR_INVALID_ARGUMENT\0A *         \5Cp input_length or \5Cp hash_length do not match the hash size for \5Cp alg\0A * \5Cretval #PSA_ERROR_INSUFFICIENT_MEMORY \5Cemptydescription\0A * \5Cretval #PSA_ERROR_COMMUNICATION_FAILURE \5Cemptydescription\0A * \5Cretval #PSA_ERROR_HARDWARE_FAILURE \5Cemptydescription\0A * \5Cretval #PSA_ERROR_CORRUPTION_DETECTED \5Cemptydescription\0A * \5Cretval #PSA_ERROR_BAD_STATE\0A *         The library has not been previously initialized by psa_crypto_init().\0A *         It is implementation-dependent whether a failure to initialize\0A *         results in this error code.\0A */\0Apsa_status_t psa_hash_compare(psa_algorithm_t alg,\0A                              const uint8_t *input,\0A                              size_t input_length,\0A                              const uint8_t *hash,\0A                              size_t hash_length);\0A\0A/** The type of the state data structure for multipart hash operations.\0A *\0A * Before calling any function on a hash operation object, the application must\0A * initialize it by any of the following means:\0A * - Set the structure to all-bits-zero, for example:\0A *   \5Ccode\0A *   psa_hash_operation_t operation;\0A *   memset(&operation, 0, sizeof(operation));\0A *   \5Cendcode\0A * - Initialize the structure to logical zero values, for example:\0A *   \5Ccode\0A *   psa_hash_operation_t operation = {0};\0A *   \5Cendcode\0A * - Initialize the structure to the initializer #PSA_HASH_OPERATION_INIT,\0A *   for example:\0A *   \5Ccode\0A *   psa_hash_operation_t operation = PSA_HASH_OPERATION_INIT;\0A *   \5Cendcode\0A * - Assign the result of the function psa_hash_operation_init()\0A *   to the structure, for example:\0A *   \5Ccode\0A *   psa_hash_operation_t operation;\0A *   operation = psa_hash_operation_init();\0A *   \5Cendcode\0A *\0A * This is an implementation-defined \5Cc struct. Applications should not\0A * make any assumptions about the content of this structure.\0A * Implementation details can change in future versions without notice. */\0Atypedef struct psa_hash_operation_s psa_hash_operation_t;\0A\0A/** \5Cdef PSA_HASH_OPERATION_INIT\0A *\0A * This macro returns a suitable initializer for a hash operation object\0A * of type #psa_hash_operation_t.\0A */\0A\0A/** Return an initial value for a hash operation object.\0A */\0Astatic psa_hash_operation_t psa_hash_operation_init(void);\0A\0A/** Set up a multipart hash operation.\0A *\0A * The sequence of operations to calculate a hash (message digest)\0A * is as follows:\0A * -# Allocate an operation object which will be passed to all the functions\0A *    listed here.\0A * -# Initialize the operation object with one of the methods described in the\0A *    documentation for #psa_hash_operation_t, e.g. #PSA_HASH_OPERATION_INIT.\0A * -# Call psa_hash_setup() to specify the algorithm.\0A * -# Call psa_hash_update() zero, one or more times, passing a fragment\0A *    of the message each time. The hash that is calculated is the hash\0A *    of the concatenation of these messages in order.\0A * -# To calculate the hash, call psa_hash_finish().\0A *    To compare the hash with an expected value, call psa_hash_verify().\0A *\0A * If an error occurs at any step after a call to psa_hash_setup(), the\0A * operation will need to be reset by a call to psa_hash_abort(). The\0A * application may call psa_hash_abort() at any time after the operation\0A * has been initialized.\0A *\0A * After a successful call to psa_hash_setup(), the application must\0A * eventually terminate the operation. The following events terminate an\0A * operation:\0A * - A successful call to psa_hash_finish() or psa_hash_verify().\0A * - A call to psa_hash_abort().\0A *\0A * \5Cparam[in,out] operation The operation object to set up. It must have\0A *                          been initialized as per the documentation for\0A *                          #psa_hash_operation_t and not yet in use.\0A * \5Cparam alg               The hash algorithm to compute (\5Cc PSA_ALG_XXX value\0A *                          such that #PSA_ALG_IS_HASH(\5Cp alg) is true).\0A *\0A * \5Cretval #PSA_SUCCESS\0A *         Success.\0A * \5Cretval #PSA_ERROR_NOT_SUPPORTED\0A *         \5Cp alg is not a supported hash algorithm.\0A * \5Cretval #PSA_ERROR_INVALID_ARGUMENT\0A *         \5Cp alg is not a hash algorithm.\0A * \5Cretval #PSA_ERROR_INSUFFICIENT_MEMORY \5Cemptydescription\0A * \5Cretval #PSA_ERROR_COMMUNICATION_FAILURE \5Cemptydescription\0A * \5Cretval #PSA_ERROR_HARDWARE_FAILURE \5Cemptydescription\0A * \5Cretval #PSA_ERROR_CORRUPTION_DETECTED \5Cemptydescription\0A * \5Cretval #PSA_ERROR_BAD_STATE\0A *         The operation state is not valid (it must be inactive), or\0A *         the library has not been previously initialized by psa_crypto_init().\0A *         It is implementation-dependent whether a failure to initialize\0A *         results in this error code.\0A */\0Apsa_status_t psa_hash_setup(psa_hash_operation_t *operation,\0A                            psa_algorithm_t alg);\0A\0A/** Add a message fragment to a multipart hash operation.\0A *\0A * The application must call psa_hash_setup() before calling this function.\0A *\0A * If this function returns an error status, the operation enters an error\0A * state and must be aborted by calling psa_hash_abort().\0A *\0A * \5Cparam[in,out] operation Active hash operation.\0A * \5Cparam[in] input         Buffer containing the message fragment to hash.\0A * \5Cparam input_length      Size of the \5Cp input buffer in bytes.\0A *\0A * \5Cretval #PSA_SUCCESS\0A *         Success.\0A * \5Cretval #PSA_ERROR_INSUFFICIENT_MEMORY \5Cemptydescription\0A * \5Cretval #PSA_ERROR_COMMUNICATION_FAILURE \5Cemptydescription\0A * \5Cretval #PSA_ERROR_HARDWARE_FAILURE \5Cemptydescription\0A * \5Cretval #PSA_ERROR_CORRUPTION_DETECTED \5Cemptydescription\0A * \5Cretval #PSA_ERROR_BAD_STATE\0A * 