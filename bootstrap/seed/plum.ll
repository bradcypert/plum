mbedtls_pkcs7_free(pkcs7);\0A    }\0A\0A    return ret;\0A}\0A\0Astatic int mbedtls_pkcs7_data_or_hash_verify(mbedtls_pkcs7 *pkcs7,\0A                                             const mbedtls_x509_crt *cert,\0A                                             const unsigned char *data,\0A                                             size_t datalen,\0A                                             const int is_data_hash)\0A{\0A    int ret = MBEDTLS_ERR_ERROR_CORRUPTION_DETECTED;\0A    unsigned char *hash;\0A    mbedtls_pk_context pk_cxt = cert->pk;\0A    const mbedtls_md_info_t *md_info;\0A    mbedtls_md_type_t md_alg;\0A    mbedtls_pkcs7_signer_info *signer;\0A\0A    if (pkcs7->signed_data.no_of_signers == 0) {\0A        return MBEDTLS_ERR_PKCS7_INVALID_CERT;\0A    }\0A\0A    if (mbedtls_x509_time_is_past(&cert->valid_to) ||\0A        mbedtls_x509_time_is_future(&cert->valid_from)) {\0A        return MBEDTLS_ERR_PKCS7_CERT_DATE_INVALID;\0A    }\0A\0A    ret = mbedtls_oid_get_md_alg(&pkcs7->signed_data.digest_alg_identifiers, &md_alg);\0A    if (ret != 0) {\0A        return ret;\0A    }\0A\0A    md_info = mbedtls_md_info_from_type(md_alg);\0A    if (md_info == NULL) {\0A        return MBEDTLS_ERR_PKCS7_VERIFY_FAIL;\0A    }\0A\0A    hash = mbedtls_calloc(mbedtls_md_get_size(md_info), 1);\0A    if (hash == NULL) {\0A        return MBEDTLS_ERR_PKCS7_ALLOC_FAILED;\0A    }\0A\0A    /* BEGIN must free hash before jumping out */\0A    if (is_data_hash) {\0A        if (datalen != mbedtls_md_get_size(md_info)) {\0A            ret = MBEDTLS_ERR_PKCS7_VERIFY_FAIL;\0A        } else {\0A            memcpy(hash, data, datalen);\0A        }\0A    } else {\0A        ret = mbedtls_md(md_info, data, datalen, hash);\0A    }\0A    if (ret != 0) {\0A        mbedtls_free(hash);\0A        return MBEDTLS_ERR_PKCS7_VERIFY_FAIL;\0A    }\0A\0A    /* assume failure */\0A    ret = MBEDTLS_ERR_PKCS7_VERIFY_FAIL;\0A\0A    /*\0A     * Potential TODOs\0A     * Currently we iterate over all signers and return success if any of them\0A     * verify.\0A     *\0A     * However, we could make this better by checking against the certificate's\0A     * identification and SignerIdentifier fields first. That would also allow\0A     * us to distinguish between 'no signature for key' and 'signature for key\0A     * failed to validate'.\0A     */\0A    for (signer = &pkcs7->signed_data.signers; signer; signer = signer->next) {\0A        ret = mbedtls_pk_verify(&pk_cxt, md_alg, hash,\0A                                mbedtls_md_get_size(md_info),\0A                                signer->sig.p, signer->sig.len);\0A\0A        if (ret == 0) {\0A            break;\0A        }\0A    }\0A\0A    mbedtls_free(hash);\0A    /* END must free hash before jumping out */\0A    return ret;\0A}\0A\0Aint mbedtls_pkcs7_signed_data_verify(mbedtls_pkcs7 *pkcs7,\0A                                     const mbedtls_x509_crt *cert,\0A                                     const unsigned char *data,\0A                                     size_t datalen)\0A{\0A    if (data == NULL) {\0A        return MBEDTLS_ERR_PKCS7_BAD_INPUT_DATA;\0A    }\0A    return mbedtls_pkcs7_data_or_hash_verify(pkcs7, cert, data, datalen, 0);\0A}\0A\0Aint mbedtls_pkcs7_signed_hash_verify(mbedtls_pkcs7 *pkcs7,\0A                                     const mbedtls_x509_crt *cert,\0A                                     const unsigned char *hash,\0A                                     size_t hashlen)\0A{\0A    if (hash == NULL) {\0A        return MBEDTLS_ERR_PKCS7_BAD_INPUT_DATA;\0A    }\0A    return mbedtls_pkcs7_data_or_hash_verify(pkcs7, cert, hash, hashlen, 1);\0A}\0A\0A/*\0A * Unallocate all pkcs7 data\0A */\0Avoid mbedtls_pkcs7_free(mbedtls_pkcs7 *pkcs7)\0A{\0A    mbedtls_pkcs7_signer_info *signer_cur;\0A    mbedtls_pkcs7_signer_info *signer_prev;\0A\0A    if (pkcs7 == NULL || pkcs7->raw.p == NULL) {\0A        return;\0A    }\0A\0A    mbedtls_free(pkcs7->raw.p);\0A\0A    mbedtls_x509_crt_free(&pkcs7->signed_data.certs);\0A    mbedtls_x509_crl_free(&pkcs7->signed_data.crl);\0A\0A    signer_cur = pkcs7->signed_data.signers.next;\0A    pkcs7_free_signer_info(&pkcs7->signed_data.signers);\0A    while (signer_cur != NULL) {\0A        signer_prev = signer_cur;\0A        signer_cur = signer_prev->next;\0A        pkcs7_free_signer_info(signer_prev);\0A        mbedtls_free(signer_prev);\0A    }\0A\0A    pkcs7->raw.p = NULL;\0A}\0A\0A#endif\0A\00" }
@.const41297 = private global <{ i64, ptr, ptr, i1, [7 x i8] }> <{ i64 -1, ptr @.str41293, ptr @.str41295, i1 1, [7 x i8] zeroinitializer }>
