                         const mbedtls_x509_sequence\0A                                       *subject_alt_name,\0A                                       const char *prefix);\0Aint mbedtls_x509_info_cert_type(char **buf, size_t *size,\0A                                unsigned char ns_cert_type);\0Aint mbedtls_x509_info_key_usage(char **buf, size_t *size,\0A                                unsigned int key_usage);\0A\0Aint mbedtls_x509_write_set_san_common(mbedtls_asn1_named_data **extensions,\0A                                      const mbedtls_x509_san_list *san_list);\0A\0A#endif /* MBEDTLS_X509_INTERNAL_H */\0A\00" }
