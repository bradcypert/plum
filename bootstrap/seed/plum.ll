rns:\0A *  - `0` on success.\0A *  - A negative error code if `max_len` didn't offer enough space\0A *    for the expansion.\0A */\0AMBEDTLS_CHECK_RETURN_CRITICAL\0Astatic int ssl_build_inner_plaintext(unsigned char *content,\0A                                     size_t *content_size,\0A                                     size_t remaining,\0A                                     uint8_t rec_type,\0A                                     size_t pad)\0A{\0A    size_t len = *content_size;\0A\0A    /* Write real content type */\0A    if (remaining == 0) {\0A        return -1;\0A    }\0A    content[len] = rec_type;\0A    len++;\0A    remaining--;\0A\0A    if (remaining < pad) {\0A        return -1;\0A    }\0A    memset(content + len, 0, pad);\0A    len += pad;\0A    remaining -= pad;\0A\0A    *content_size = len;\0A    return 0;\0A}\0A\0A/* This function parses a (D)TLSInnerPlaintext structure.\0A * See ssl_build_inner_plaintext() for details. */\0AMBEDTLS_CHECK_RETURN_CRITICAL\0Astatic int ssl_parse_inner_plaintext(unsigned char const *content,\0A                                     size_t *content_size,\0A                                     uint8_t *rec_type)\0A{\0A    size_t remaining = *content_size;\0A\0A    /* Determine length of padding by skipping zeroes from the back. */\0A    do {\0A        if (remaining == 0) {\0A            return -1;\0A        }\0A        remaining--;\0A    } while (content[remaining] == 0);\0A\0A    *content_size = remaining;\0A    *rec_type = content[remaining];\0A\0A    return 0;\0A}\0A#endif /* MBEDTLS_SSL_DTLS_CONNECTION_ID || MBEDTLS_SSL_PROTO_TLS1_3 */\0A\0A/* The size of the `add_data` structure depends on various\0A * factors, namely\0A *\0A * 1) CID functionality disabled\0A *\0A * additional_data =\0A *    8:                    seq_num +\0A *    1:                       type +\0A *    2:                    version +\0A *    2:  length of inner plaintext +\0A *\0A * size = 13 bytes\0A *\0A * 2) CID functionality based on RFC 9146 e