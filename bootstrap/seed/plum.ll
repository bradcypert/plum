efine MBEDTLS_TLS_DHE_PSK_WITH_AES_128_CCM_8          0xC0AA  /**< TLS 1.2 */\0A#define MBEDTLS_TLS_DHE_PSK_WITH_AES_256_CCM_8          0xC0AB  /**< TLS 1.2 */\0A/* The last two are named with PSK_DHE in the RFC, which looks like a typo */\0A\0A#define MBEDTLS_TLS_ECDHE_ECDSA_WITH_AES_128_CCM        0xC0AC  /**< TLS 1.2 */\0A#define MBEDTLS_TLS_ECDHE_ECDSA_WITH_AES_256_CCM        0xC0AD  /**< TLS 1.2 */\0A#define MBEDTLS_TLS_ECDHE_ECDSA_WITH_AES_128_CCM_8      0xC0AE  /**< TLS 1.2 */\0A#define MBEDTLS_TLS_ECDHE_ECDSA_WITH_AES_256_CCM_8      0xC0AF  /**< TLS 1.2 */\0A\0A#define MBEDTLS_TLS_ECJPAKE_WITH_AES_128_CCM_8          0xC0FF  /**< experimental */\0A\0A/* RFC 7905 */\0A#define MBEDTLS_TLS_ECDHE_RSA_WITH_CHACHA20_POLY1305_SHA256   0xCCA8 /**< TLS 1.2 */\0A#define MBEDTLS_TLS_ECDHE_ECDSA_WITH_CHACHA20_POLY1305_SHA256 0xCCA9 /**< TLS 1.2 */\0A#define MBEDTLS_TLS_DHE_RSA_WITH_CHACHA20_POLY1305_SHA256     0xCCAA /**< TLS 1.2 */\0A#define MBEDTLS_TLS_PSK_WITH_CHACHA20_POLY1305_SHA256         0xCCAB /**< TLS 1.2 */\0A#define MBEDTLS_TLS_ECDHE_PSK_WITH_CHACHA20_POLY1305_SHA256   0xCCAC /**< TLS 1.2 */\0A#define MBEDTLS_TLS_DHE_PSK_WITH_CHACHA20_POLY1305_SHA256     0xCCAD /**< TLS 1.2 */\0A#define MBEDTLS_TLS_RSA_PSK_WITH_CHACHA20_POLY1305_SHA256     0xCCAE /**< TLS 1.2 */\0A\0A/* RFC 8446, Appendix B.4 */\0A#define MBEDTLS_TLS1_3_AES_128_GCM_SHA256                     0x1301 /**< TLS 1.3 */\0A#define MBEDTLS_TLS1_3_AES_256_GCM_SHA384                     0x1302 /**< TLS 1.3 */\0A#define MBEDTLS_TLS1_3_CHACHA20_POLY1305_SHA256               0x1303 /**< TLS 1.3 */\0A#define MBEDTLS_TLS1_3_AES_128_CCM_SHA256                     0x1304 /**< TLS 1.3 */\0A#define MBEDTLS_TLS1_3_AES_128_CCM_8_SHA256                   0x1305 /**< TLS 1.3 */\0A\0A/* Reminder: update mbedtls_ssl_premaster_secret when adding a new key exchange.\0A * Reminder: update MBEDTLS_KEY_EXCHANGE__xxx below\0A */\0Atypedef enum {\0A    MBEDTLS_KEY_EXCHANGE_NONE = 0,\0A    MBEDTLS_KEY_EXCHANGE_RSA,\0A    MBEDTLS_KEY_EXCHANGE_DHE_RSA,\0A    MBEDTLS_KEY_EXCHANGE_ECDHE_RSA,\0A    MBEDTLS_KEY_EXCHANGE_ECDHE_ECDSA,\0A    MBEDTLS_KEY_EXCHANGE_PSK,\0A    MBEDTLS_KEY_EXCHANGE_DHE_PSK,\0A    MBEDTLS_KEY_EXCHANGE_RSA_PSK,\0A    MBEDTLS_KEY_EXCHANGE_ECDHE_PSK,\0A    MBEDTLS_KEY_EXCHANGE_ECDH_RSA,\0A    MBEDTLS_KEY_EXCHANGE_ECDH_ECDSA,\0A    MBEDTLS_KEY_EXCHANGE_ECJPAKE,\0A} mbedtls_key_exchange_type_t;\0A\0A/* Key exchanges using a certificate */\0A#if defined(MBEDTLS_KEY_EXCHANGE_RSA_ENABLED)           || \5C\0A    defined(MBEDTLS_KEY_EXCHANGE_DHE_RSA_ENABLED)       || \5C\0A    defined(MBEDTLS_KEY_EXCHANGE_ECDHE_RSA_ENABLED)     || \5C\0A    defined(MBEDTLS_KEY_EXCHANGE_ECDHE_ECDSA_ENABLED)   || \5C\0A    defined(MBEDTLS_KEY_EXCHANGE_RSA_PSK_ENABLED)       || \5C\0A    defined(MBEDTLS_KEY_EXCHANGE_ECDH_RSA_ENABLED)      || \5C\0A    defined(MBEDTLS_KEY_EXCHANGE_ECDH_ECDSA_ENABLED)\0A#define MBEDTLS_KEY_EXCHANGE_WITH_CERT_ENABLED\0A#endif\0A\0A/* Key exchanges in either TLS 1.2 or 1.3 which are using an ECDSA\0A * signature */\0A#if defined(MBEDTLS_KEY_EXCHANGE_ECDHE_ECDSA_ENABLED) || \5C\0A    defined(MBEDTLS_SSL_TLS1_3_KEY_EXCHANGE_MODE_EPHEMERAL_ENABLED)\0A#define MBEDTLS_KEY_EXCHANGE_WITH_ECDSA_ANY_ENABLED\0A#endif\0A\0A#if defined(MBEDTLS_KEY_EXCHANGE_WITH_CERT_ENABLED) || \5C\0A    defined(MBEDTLS_SSL_TLS1_3_KEY_EXCHANGE_MODE_EPHEMERAL_ENABLED)\0A#define MBEDTLS_SSL_HANDSHAKE_WITH_CERT_ENABLED\0A#endif\0A\0A/* Key exchanges allowing client certificate requests.\0A *\0A * Note: that's almost the same as MBEDTLS_KEY_EXCHANGE_WITH_CERT_ENABLED\0A * above, except RSA-PSK uses a server certificate but no client cert.\0A *\0A * Note: this difference is specific to TLS 1.2, as with TLS 1.3, things are\0A * more symmetrical: client certs and server certs are either both allowed\0A * (Ephemeral mode) or both disallowed (PSK and PKS-Ephemeral modes).\0A */\0A#if defined(MBEDTLS_KEY_EXCHANGE_RSA_ENABLED)           ||       \5C\0A    defined(MBEDTLS_KEY_EXCHANGE_DHE_RSA_ENABLED)       ||       \5C\0A    defined(MBEDTLS_KEY_EXCHANGE_ECDHE_RSA_ENABLED)     ||       \5C\0A    defined(MBEDTLS_KEY_EXCHANGE_ECDHE_ECDSA_ENABLED)   ||       \5C\0A    defined(MBEDTLS_KEY_EXCHANGE_ECDH_ECDSA_ENABLED)    ||       \5C\0A    defined(MBEDTLS_KEY_EXCHANGE_ECDH_RSA_ENABLED)\0A#define MBEDTLS_KEY_EXCHANGE_CERT_REQ_ALLOWED_ENABLED\0A#endif\0A\0A/* Helper to state that certificate-based client authentication through ECDSA\0A * is supported in TLS 1.2 */\0A#if defined(MBEDTLS_KEY_EXCHANGE_CERT_REQ_ALLOWED_ENABLED) && \5C\0A    defined(MBEDTLS_PK_CAN_ECDSA_SIGN) && defined(MBEDTLS_PK_CAN_ECDSA_VERIFY)\0A#define MBEDTLS_KEY_EXCHANGE_ECDSA_CERT_REQ_ALLOWED_ENABLED\0A#endif\0A\0A/* ECDSA required for certificates in either TLS 1.2 or 1.3 */\0A#if defined(MBEDTLS_KEY_EXCHANGE_ECDSA_CERT_REQ_ALLOWED_ENABLED) || \5C\0A    defined(MBEDTLS_SSL_TLS1_3_KEY_EXCHANGE_MODE_EPHEMERAL_ENABLED)\0A#define MBEDTLS_KEY_EXCHANGE_ECDSA_CERT_REQ_ANY_ALLOWED_ENABLED\0A#endif\0A\0A/* Key exchanges involving server signature in ServerKeyExchange */\0A#if defined(MBEDTLS_KEY_EXCHANGE_DHE_RSA_ENABLED)       || \5C\0A    defined(MBEDTLS_KEY_EXCHANGE_ECDHE_RSA_ENABLED)     || \5C\0A    defined(MBEDTLS_KEY_EXCHANGE_ECDHE_ECDSA_ENABLED)\0A#define MBEDTLS_KEY_EXCHANGE_WITH_SERVER_SIGNATURE_ENABLED\0A#endif\0A\0A/* Key exchanges using ECDH */\0A#if defined(MBEDTLS_KEY_EXCHANGE_ECDH_RSA_ENABLED)      || \5C\0A    defined(MBEDTLS_KEY_EXCHANGE_ECDH_ECDSA_ENABLED)\0A#define MBEDTLS_KEY_EXCHANGE_SOME_ECDH_ENABLED\0A#endif\0A\0A/* Key exchanges that don't involve ephemeral keys */\0A#if defined(MBEDTLS_KEY_EXCHANGE_RSA_ENABLED)           || \5C\0A    defined(MBEDTLS_KEY_EXCHANGE_PSK_ENABLED)           || \5C\0A    defined(MBEDTLS_KEY_EXCHANGE_RSA_PSK_ENABLED)       || \5C\0A    defined(MBEDTLS_KEY_EXCHANGE_SOME_ECDH_ENABLED)\0A#define MBEDTLS_KEY_EXCHANGE_SOME_NON_PFS_ENABLED\0A#endif\0A\0A/* Key exchanges that involve ephemeral keys */\0A#if defined(MBEDTLS_KEY_EXCHANGE_DHE_RSA_ENABLED)       || \5C\0A    defined(MBEDTLS_KEY_EXCHANGE_DHE_PSK_ENABLED)       || \5C\0A    defined(MBEDTLS_KEY_EXCHANGE_ECDHE_RSA_ENABLED)     || \5C\0A    defined(MBEDTLS_KEY_EXCHANGE_ECDHE_PSK_ENABLED)     || \5C\0A    defined(MBEDTLS_KEY_EXCHANGE_ECDHE_ECDSA_ENABLED)   || \5C\0A    defined(MBEDTLS_KEY_EXCHANGE_ECJPAKE_ENABLED)\0A#define MBEDTLS_KEY_EXCHANGE_SOME_PFS_ENABLED\0A#endif\0A\0A/* Key exchanges using a PSK */\0A#if defined(MBEDTLS_KEY_EXCHANGE_PSK_ENABLED)           || \5C\0A    defined(MBEDTLS_KEY_EXCHANGE_RSA_PSK_ENABLED)       || \5C\0A    defined(MBEDTLS_KEY_EXCHANGE_DHE_PSK_ENABLED)       || \5C\0A    defined(MBEDTLS_KEY_EXCHANGE_ECDHE_PSK_ENABLED)\0A#define MBEDTLS_KEY_EXCHANGE_SOME_PSK_ENABLED\0A#endif\0A\0A/* Key exchanges using DHE */\0A#if defined(MBEDTLS_KEY_EXCHANGE_DHE_RSA_ENABLED)       || \5C\0A    defined(MBEDTLS_KEY_EXCHANGE_DHE_PSK_ENABLED)\0A#define MBEDTLS_KEY_EXCHANGE_SOME_DHE_ENABLED\0A#endif\0A\0A/* Key exchanges using ECDHE */\0A#if defined(MBEDTLS_KEY_EXCHANGE_ECDHE_RSA_ENABLED)     || \5C\0A    defined(MBEDTLS_KEY_EXCHANGE_ECDHE_ECDSA_ENABLED)   || \5C\0A    defined(MBEDTLS_KEY_EXCHANGE_ECDHE_PSK_ENABLED)\0A#define MBEDTLS_KEY_EXCHANGE_SOME_ECDHE_ENABLED\0A#endif\0A\0A/* TLS 1.2 key exchanges using ECDH or ECDHE*/\0A#if defined(MBEDTLS_KEY_EXCHANGE_SOME_ECDH_ENABLED) || \5C\0A    defined(MBEDTLS_KEY_EXCHANGE_SOME_ECDHE_ENABLED)\0A#define MBEDTLS_KEY_EXCHANGE_SOME_ECDH_OR_ECDHE_1_2_ENABLED\0A#endif\0A\0A/* TLS 1.3 PSK key exchanges */\0A#if defined(MBEDTLS_SSL_TLS1_3_KEY_EXCHANGE_MODE_PSK_ENABLED) || \5C\0A    defined(MBEDTLS_SSL_TLS1_3_KEY_EXCHANGE_MODE_PSK_EPHEMERAL_ENABLED)\0A#define MBEDTLS_SSL_TLS1_3_KEY_EXCHANGE_MODE_SOME_PSK_ENABLED\0A#endif\0A\0A/* TLS 1.2 or 1.3 key exchanges with PSK */\0A#if defined(MBEDTLS_KEY_EXCHANGE_SOME_PSK_ENABLED) || \5C\0A    defined(MBEDTLS_SSL_TLS1_3_KEY_EXCHANGE_MODE_SOME_PSK_ENABLED)\0A#define MBEDTLS_SSL_HANDSHAKE_WITH_PSK_ENABLED\0A#endif\0A\0A/* TLS 1.3 ephemeral key exchanges */\0A#if defined(MBEDTLS_SSL_TLS1_3_KEY_EXCHANGE_MODE_EPHEMERAL_ENABLED) || \5C\0A    defined(MBEDTLS_SSL_TLS1_3_KEY_EXCHANGE_MODE_PSK_EPHEMERAL_ENABLED)\0A#define MBEDTLS_SSL_TLS1_3_KEY_EXCHANGE_MODE_SOME_EPHEMERAL_ENABLED\0A#endif\0A\0A/* TLS 1.3 key exchanges using ECDHE */\0A#if defined(MBEDTLS_SSL_TLS1_3_KEY_EXCHANGE_MODE_SOME_EPHEMERAL_ENABLED) && \5C\0A    defined(PSA_WANT_ALG_ECDH)\0A#define MBEDTLS_SSL_TLS1_3_KEY_EXCHANGE_MODE_SOME_ECDHE_ENABLED\0A#endif\0A\0A/* TLS 1.2 or 1.3 key exchanges using ECDH or ECDHE */\0A#if defined(MBEDTLS_KEY_EXCHANGE_SOME_ECDH_OR_ECDHE_1_2_ENABLED) || \5C\0A    defined(MBEDTLS_SSL_TLS1_3_KEY_EXCHANGE_MODE_SOME_ECDHE_ENABLED)\0A#define MBEDTLS_KEY_EXCHANGE_SOME_ECDH_OR_ECDHE_ANY_ENABLED\0A#endif\0A\0A/* TLS 1.2 XXDH key exchanges: ECDH or ECDHE or FFDH */\0A#if (defined(MBEDTLS_KEY_EXCHANGE_SOME_ECDH_OR_ECDHE_1_2_ENABLED) || \5C\0A    defined(MBEDTLS_KEY_EXCHANGE_SOME_DHE_ENABLED))\0A#define MBEDTLS_KEY_EXCHANGE_SOME_XXDH_1_2_ENABLED\0A#endif\0A\0A/* The handshake params structure has a set of fields called xxdh_psa which are used:\0A * - by TLS 1.2 with `USE_PSA` to do ECDH or ECDHE;\0A * - by TLS 1.3 to do ECDHE or FFDHE.\0A * The following macros can be used to guard their declaration and use.\0A */\0A#if defined(MBEDTLS_KEY_EXCHANGE_SOME_ECDH_OR_ECDHE_1_2_ENABLED) && \5C\0A    defined(MBEDTLS_USE_PSA_CRYPTO)\0A#define MBEDTLS_KEY_EXCHANGE_SOME_XXDH_PSA_1_2_ENABLED\0A#endif\0A#if defined(MBEDTLS_KEY_EXCHANGE_SOME_XXDH_PSA_1_2_ENABLED) || \5C\0A    defined(MBEDTLS_SSL_TLS1_3_KEY_EXCHANGE_MODE_SOME_EPHEMERAL_ENABLED)\0A#define MBEDTLS_KEY_EXCHANGE_SOME_XXDH_PSA_ANY_ENABLED\0A#endif\0A\0Atypedef struct mbedtls_ssl_ciphersuite_t mbedtls_ssl_ciphersuite_t;\0A\0A#define MBEDTLS_CIPHERSUITE_WEAK       0x01    /**< Weak ciphersuite flag  */\0A#define MBEDTLS_CIPHERSUITE_SHORT_TAG  0x02    /**< Short authentication tag,\0A                                                     eg for CCM_8 */\0A#define MBEDTLS_CIPHERSUITE_NODTLS     0x04    /**< Can't be used with DTLS */\0A\0A/**\0A * \5Cbrief   This structure is used for storing ciphersuite information\0A *\0A * \5Cnote    members are defined using integral types instead of enums\0A *          in order to pack structure and reduce memory usage by internal\0A *          \5Cc ciphersuite_definitions[]\0A */\0Astruct mbedtls_ssl_ciphersuite_t {\0A    int MBEDTLS_PRIVATE(id);\0A    const char *MBEDTLS_PRIVATE(name);\0A\0A    uint8_t MBEDTLS_PRIVATE(cipher);           /* mbedtls_cipher_type_t */\0A    uint8_t MBEDTLS_PRIVATE(mac);              /* mbedtls_md_type_t */\0A    uint8_t MBEDTLS_PRIVATE(key_exchange);     /* mbedtls_key_exchange_type_t */\0A    uint8_t MBEDTLS_PRIVATE(flags);\0A\0A    uint16_t MBEDTLS_PRIVATE(min_tls_version); /* mbedtls_ssl_protocol_version */\0A    uint16_t MBEDTLS_PRIVATE(max_tls_version); /* mbedtls_ssl_protocol_version */\0A};\0A\0Aconst int *mbedtls_ssl_list_ciphersuites(void);\0A\0Aconst mbedtls_ssl_ciphersuite_t *mbedtls_ssl_ciphersuite_from_string(const char *ciphersuite_name);\0Aconst mbedtls_ssl_ciphersuite_t *mbedtls_ssl_ciphersuite_from_id(int ciphersuite_id);\0A\0Astatic inline const char *mbedtls_ssl_ciphersuite_get_name(const mbedtls_ssl_ciphersuite_t *info)\0A{\0A    return info->MBEDTLS_PRIVATE(name);\0A}\0A\0Astatic inline int mbedtls_ssl_ciphersuite_get_id(const mbedtls_ssl_ciphersuite_t *info)\0A{\0A    return info->MBEDTLS_PRIVATE(id);\0A}\0A\0Asize_t mbedtls_ssl_ciphersuite_get_cipher_key_bitlen(const mbedtls_ssl_ciphersuite_t *info);\0A\0A#ifdef __cplusplus\0A}\0A#endif\0A\0A#endif /* ssl_ciphersuites.h */\0A\00" }
