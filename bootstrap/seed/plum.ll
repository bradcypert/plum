)\0A#define MBEDTLS_PSA_BUILTIN_ECC_SECP_R1_521 1\0A#define MBEDTLS_ECP_DP_SECP521R1_ENABLED\0A#endif /* missing accel */\0A#endif /* PSA_WANT_ECC_SECP_R1_521 */\0A\0A#if defined(PSA_WANT_ECC_SECP_K1_192)\0A#if !defined(MBEDTLS_PSA_ACCEL_ECC_SECP_K1_192) || \5C\0A    defined(MBEDTLS_PSA_ECC_ACCEL_INCOMPLETE_KEY_TYPES) || \5C\0A    defined(MBEDTLS_PSA_ECC_ACCEL_INCOMPLETE_ALGS)\0A#define MBEDTLS_PSA_BUILTIN_ECC_SECP_K1_192 1\0A#define MBEDTLS_ECP_DP_SECP192K1_ENABLED\0A#endif /* missing accel */\0A#endif /* PSA_WANT_ECC_SECP_K1_192 */\0A\0A#if defined(PSA_WANT_ECC_SECP_K1_256)\0A#if !defined(MBEDTLS_PSA_ACCEL_ECC_SECP_K1_256) || \5C\0A    defined(MBEDTLS_PSA_ECC_ACCEL_INCOMPLETE_KEY_TYPES) || \5C\0A    defined(MBEDTLS_PSA_ECC_ACCEL_INCOMPLETE_ALGS)\0A#define MBEDTLS_PSA_BUILTIN_ECC_SECP_K1_256 1\0A#define MBEDTLS_ECP_DP_SECP256K1_ENABLED\0A#endif /* missing accel */\0A#endif /* PSA_WANT_ECC_SECP_K1_256 */\0A\0A/* ECC: algs: enable built-ins as needed.\0A *\0A * We need the alg built-in:\0A * - if it's not accelerated, or\0A * - if there's a relevant curve (see below) with missing acceleration, or\0A * - if there's a key type among (public, basic) with missing acceleration.\0A *\0A * Relevant curves are:\0A * - all curves for ECDH\0A * - Weierstrass curves for (deterministic) ECDSA\0A * - secp256r1 for EC J-PAKE\0A */\0A#if defined(PSA_WANT_ALG_DETERMINISTIC_ECDSA)\0A#if !defined(MBEDTLS_PSA_ACCEL_ALG_DETERMINISTIC_ECDSA) || \5C\0A    defined(MBEDTLS_PSA_ECC_ACCEL_INCOMPLETE_WEIERSTRASS_CURVES) || \5C\0A    defined(MBEDTLS_PSA_ECC_ACCEL_INCOMPLETE_KEY_TYPES_BASIC)\0A#define MBEDTLS_PSA_BUILTIN_ALG_DETERMINISTIC_ECDSA 1\0A#define MBEDTLS_ECDSA_DETERMINISTIC\0A#define MBEDTLS_HMAC_DRBG_C\0A#define MBEDTLS_MD_C\0A#define MBEDTLS_ECDSA_C\0A#define MBEDTLS_ECP_C\0A#define MBEDTLS_BIGNUM_C\0A#define MBEDTLS_ASN1_PARSE_C\0A#define MBEDTLS_ASN1_WRITE_C\0A#endif /* missing accel */\0A#endif /* PSA_WANT_ALG_DETERMINISTIC_ECDSA */\0A\0A#if defined(PSA_WANT_ALG_ECDH)\0A#if !defin