@.str40570 = private global { i64, i64, [26164 x i8] } { i64 -1, i64 26163, [26164 x i8] c"/*\0A *  PSA RSA layer on top of Mbed TLS crypto\0A */\0A/*\0A *  Copyright The Mbed TLS Contributors\0A *  SPDX-License-Identifier: Apache-2.0 OR GPL-2.0-or-later\0A */\0A\0A#include \22common.h\22\0A\0A#if defined(MBEDTLS_PSA_CRYPTO_C)\0A\0A#include <psa/crypto.h>\0A#include \22psa/crypto_values.h\22\0A#include \22psa_crypto_core.h\22\0A#include \22psa_crypto_random_impl.h\22\0A#include \22psa_crypto_rsa.h\22\0A#include \22psa_crypto_hash.h\22\0A#include \22mbedtls/psa_util.h\22\0A\0A#include <stdlib.h>\0A#include <string.h>\0A#include \22mbedtls/platform.h\22\0A\0A#include <mbedtls/rsa.h>\0A#include <mbedtls/error.h>\0A#include \22rsa_internal.h\22\0A\0A#if defined(MBEDTLS_PSA_BUILTIN_ALG_RSA_PKCS1V15_CRYPT) || \5C\0A    defined(MBEDTLS_PSA_BUILTIN_ALG_RSA_OAEP) || \5C\0A    defined(MBEDTLS_PSA_BUILTIN_ALG_RSA_PKCS1V15_SIGN) || \5C\0A    defined(MBEDTLS_PSA_BUILTIN_ALG_RSA_PSS) || \5C\0A    defined(MBEDTLS_PSA_BUILTIN_KEY_TYPE_RSA_KEY_PAIR_IMPORT) || \5C\0A    defined(MBEDTLS_PSA_BUILTIN_KEY_TYPE_RSA_KEY_PAIR_EXPORT) || \5C\0A    defined(MBEDTLS_PSA_BUILTIN_KEY_TYPE_RSA_PUBLIC_KEY)\0A\0A/* Mbed TLS doesn't support non-byte-aligned key sizes (i.e. key sizes\0A * that are not a multiple of 8) well. For example, there is only\0A * mbedtls_rsa_get_len(), which returns a number of bytes, and no\0A * way to return the exact bit size of a key.\0A * To keep things simple, reject non-byte-aligned key sizes. */\0Astatic psa_status_t psa_check_rsa_key_byte_aligned(\0A    const mbedtls_rsa_context *rsa)\0A{\0A    mbedtls_mpi n;\0A    psa_status_t status;\0A    mbedtls_mpi_init(&n);\0A    status = mbedtls_to_psa_error(\0A        mbedtls_rsa_export(rsa, &n, NULL, NULL, NULL, NULL));\0A    if (status == PSA_SUCCESS) {\0A        if (mbedtls_mpi_bitlen(&n) % 8 != 0) {\0A            status = PSA_ERROR_NOT_SUPPORTED;\0A        }\0A    }\0A    mbedtls_mpi_free(&n);\0A    return status;\0A}\0A\0Apsa_status_t mbedtls_psa_rsa_load_representation(\0A    psa_key_type_t type, const uint8_t *data, size_t data_length,\0A    mbedtls_rsa_context **p_rsa)\0A{\0A    psa_status_t status;\0A    size_t bits;\0A\0A    *p_rsa = mbedtls_calloc(1, sizeof(mbedtls_rsa_context));\0A    if (*p_rsa == NULL) {\0A        return PSA_ERROR_INSUFFICIENT_MEMORY;\0A    }\0A    mbedtls_rsa_init(*p_rsa);\0A\0A    /* Parse the data. */\0A    if (PSA_KEY_TYPE_IS_KEY_PAIR(type)) {\0A        status = mbedtls_to_psa_error(mbedtls_rsa_parse_key(*p_rsa, data, data_length));\0A    } else {\0A        status = mbedtls_to_psa_error(mbedtls_rsa_parse_pubkey(*p_rsa, data, data_length));\0A    }\0A    if (status != PSA_SUCCESS) {\0A        goto exit;\0A    }\0A\0A    /* The size of an RSA key doesn't have to be a multiple of 8. Mbed TLS\0A     * supports non-byte-aligned key sizes, but not well. For example,\0A     * mbedtls_rsa_get_len() returns the key size in bytes, not in bits. */\0A    bits = PSA_BYTES_TO_BITS(mbedtls_rsa_get_len(*p_rsa));\0A    if (bits > PSA_VENDOR_RSA_MAX_KEY_BITS) {\0A        status = PSA_ERROR_NOT_SUPPORTED;\0A        goto exit;\0A    }\0A    status = psa_check_rsa_key_byte_aligned(*p_rsa);\0A    if (status != PSA_SUCCESS) {\0A        goto exit;\0A    }\0A\0Aexit:\0A    return status;\0A}\0A#endif /* defined(MBEDTLS_PSA_BUILTIN_ALG_RSA_PKCS1V15_CRYPT) ||\0A        * defined(MBEDTLS_PSA_BUILTIN_ALG_RSA_OAEP) ||\0A        * defined(MBEDTLS_PSA_BUILTIN_ALG_RSA_PKCS1V15_SIGN) ||\0A        * defined(MBEDTLS_PSA_BUILTIN_ALG_RSA_PSS) ||\0A        * defined(MBEDTLS_PSA_BUILTIN_KEY_TYPE_RSA_KEY_PAIR_IMPORT) ||\0A        * defined(MBEDTLS_PSA_BUILTIN_KEY_TYPE_RSA_KEY_PAIR_EXPORT) ||\0A        * defined(MBEDTLS_PSA_BUILTIN_KEY_TYPE_RSA_PUBLIC_KEY) */\0A\0A#if (defined(MBEDTLS_PSA_BUILTIN_KEY_TYPE_RSA_KEY_PAIR_IMPORT) && \5C\0A    defined(MBEDTLS_PSA_BUILTIN_KEY_TYPE_RSA_KEY_PAIR_EXPORT)) || \5C\0A    defined(MBEDTLS_PSA_BUILTIN_KEY_TYPE_RSA_PUBLIC_KEY)\0Apsa_status_t mbedtls_psa_rsa_import_key(\0A    const psa_key_attributes_t *attributes,\0A    const uint8_t *data, size_t data_length,\0A    uint8_t *key_buffer, size_t key_buffer_size,\0A    size_t *key_buffer_length, size_t *bits)\0A{\0A    psa_status_t status;\0A    mbedtls_rsa_context *rsa = NULL;\0A\0A    /* Parse input */\0A    status = mbedtls_psa_rsa_load_representation(attributes->type,\0A                                                 data,\0A                                                 data_length,\0A                                                 &rsa);\0A    if (status != PSA_SUCCESS) {\0A        goto exit;\0A    }\0A\0A    *bits = (psa_key_bits_t) PSA_BYTES_TO_BITS(mbedtls_rsa_get_len(rsa));\0A\0A    /* Re-export the data to PSA export format, such that we can store export\0A     * representation in the key slot. Export representation in case of RSA is\0A     * the smallest representation that's allowed as input, so a straight-up\0A     * allocation of the same size as the input buffer will be large enough. */\0A    status = mbedtls_psa_rsa_export_key(attributes->type,\0A                                        rsa,\0A                                        key_buffer,\0A                                        key_buffer_size,\0A                                        key_buffer_length);\0Aexit:\0A    /* Always free the RSA object */\0A    mbedtls_rsa_free(rsa);\0A    mbedtls_free(rsa);\0A\0A    return status;\0A}\0A#endif /* (defined(MBEDTLS_PSA_BUILTIN_KEY_TYPE_RSA_KEY_PAIR_IMPORT) &&\0A        *  defined(MBEDTLS_PSA_BUILTIN_KEY_TYPE_RSA_KEY_PAIR_EXPORT)) ||\0A        * defined(MBEDTLS_PSA_BUILTIN_KEY_TYPE_RSA_PUBLIC_KEY) */\0A\0A#if defined(MBEDTLS_PSA_BUILTIN_KEY_TYPE_RSA_KEY_PAIR_EXPORT) || \5C\0A    defined(MBEDTLS_PSA_BUILTIN_KEY_TYPE_RSA_PUBLIC_KEY)\0Apsa_status_t mbedtls_psa_rsa_export_key(psa_key_type_t type,\0A                                        mbedtls_rsa_context *rsa,\0A                                        uint8_t *data,\0A                                        size_t data_size,\0A                                        size_t *data_length)\0A{\0A    int ret;\0A    uint8_t *end = data + data_size;\0A\0A    /* PSA Crypto API defines the format of an RSA key as a DER-encoded\0A     * representation of the non-encrypted PKCS#1 RSAPrivateKey for a\0A     * private key and of the RFC3279 RSAPublicKey for a public key. */\0A    if (PSA_KEY_TYPE_IS_KEY_PAIR(type)) {\0A        ret = mbedtls_rsa_write_key(rsa, data, &end);\0A    } else {\0A        ret = mbedtls_rsa_write_pubkey(rsa, data, &end);\0A    }\0A\0A    if (ret < 0) {\0A        /* Clean up in case pk_write failed halfway through. */\0A        memset(data, 0, data_size);\0A        return mbedtls_to_psa_error(ret);\0A    }\0A\0A    /* The mbedtls_pk_xxx functions write to the end of the buffer.\0A     * Move the data to the beginning and erase remaining data\0A     * at the original location. */\0A    if (2 * (size_t) ret <= data_size) {\0A        memcpy(data, data + data_size - ret, ret);\0A        memset(data + data_size - ret, 0, ret);\0A    } else if ((size_t) ret < data_size) {\0A        memmove(data, data + data_size - ret, ret);\0A        memset(data + ret, 0, data_size - ret);\0A    }\0A\0A    *data_length = ret;\0A    return PSA_SUCCESS;\0A}\0A\0Apsa_status_t mbedtls_psa_rsa_export_public_key(\0A    const psa_key_attributes_t *attributes,\0A    const uint8_t *key_buffer, size_t key_buffer_size,\0A    uint8_t *data, size_t data_size, size_t *data_length)\0A{\0A    psa_status_t status = PSA_ERROR_CORRUPTION_DETECTED;\0A    mbedtls_rsa_context *rsa = NULL;\0A\0A    status = mbedtls_psa_rsa_load_representation(\0A        attributes->type, key_buffer, key_buffer_size, &rsa);\0A    if (status == PSA_SUCCESS) {\0A        status = mbedtls_psa_rsa_export_key(PSA_KEY_TYPE_RSA_PUBLIC_KEY,\0A                                            rsa,\0A                                            data,\0A                                            data_size,\0A                                            data_length);\0A    }\0A\0A    mbedtls_rsa_free(rsa);\0A    mbedtls_free(rsa);\0A\0A    return status;\0A}\0A#endif /* defined(MBEDTLS_PSA_BUILTIN_KEY_TYPE_RSA_KEY_PAIR_EXPORT) ||\0A        * defined(MBEDTLS_PSA_BUILTIN_KEY_TYPE_RSA_PUBLIC_KEY) */\0A\0A#if defined(MBEDTLS_PSA_BUILTIN_KEY_TYPE_RSA_KEY_PAIR_GENERATE)\0Astatic psa_status_t psa_rsa_read_exponent(const uint8_t *e_bytes,\0A                                          size_t e_length,\0A                                          int *exponent)\0A{\0A    size_t i;\0A    uint32_t acc = 0;\0A\0A    /* Mbed TLS encodes the public exponent as an int. For simplicity, only\0A     * support values that fit in a 32-bit integer, which is larger than\0A     * int on just about every platform anyway. */\0A    if (e_length > sizeof(acc)) {\0A        return PSA_ERROR_NOT_SUPPORTED;\0A    }\0A    for (i = 0; i < e_length; i++) {\0A        acc = (acc << 8) | e_bytes[i];\0A    }\0A    if (acc > INT_MAX) {\0A        return PSA_ERROR_NOT_SUPPORTED;\0A    }\0A    *exponent = acc;\0A    return PSA_SUCCESS;\0A}\0A\0Apsa_status_t mbedtls_psa_rsa_generate_key(\0A    const psa_key_attributes_t *attributes,\0A    const uint8_t *custom_data, size_t custom_data_length,\0A    uint8_t *key_buffer, size_t key_buffer_size, size_t *key_buffer_length)\0A{\0A    psa_status_t status;\0A    mbedtls_rsa_context rsa;\0A    int ret = MBEDTLS_ERR_ERROR_CORRUPTION_DETECTED;\0A    int exponent = 65537;\0A\0A    if (custom_data_length != 0) {\0A        status = psa_rsa_read_exponent(custom_data, custom_data_length,\0A                                       &exponent);\0A        if (status != PSA_SUCCESS) {\0A            return status;\0A        }\0A    }\0A\0A    mbedtls_rsa_init(&rsa);\0A    ret = mbedtls_rsa_gen_key(&rsa,\0A                              mbedtls_psa_get_random,\0A                              MBEDTLS_PSA_RANDOM_STATE,\0A                              (unsigned int) attributes->bits,\0A                              exponent);\0A    if (ret != 0) {\0A        mbedtls_rsa_free(&rsa);\0A        return mbedtls_to_psa_error(ret);\0A    }\0A\0A    status = mbedtls_psa_rsa_export_key(attributes->type,\0A                                        &rsa, key_buffer, key_buffer_size,\0A                                        key_buffer_length);\0A    mbedtls_rsa_free(&rsa);\0A\0A    return status;\0A}\0A#endif /* defined(MBEDTLS_PSA_BUILTIN_KEY_TYPE_RSA_KEY_PAIR_GENERATE) */\0A\0A/****************************************************************/\0A/* Sign/verify hashes */\0A/****************************************************************/\0A\0A#if defined(MBEDTLS_PSA_BUILTIN_ALG_RSA_PKCS1V15_SIGN) || \5C\0A    defined(MBEDTLS_PSA_BUILTIN_ALG_RSA_PSS)\0A\0A/* Decode the hash algorithm from alg and store the mbedtls encoding in\0A * md_alg. Verify that the hash length is acceptable. */\0Astatic psa_status_t psa_rsa_decode_md_type(psa_algorithm_t alg,\0A                                           size_t hash_length,\0A                                           mbedtls_md_type_t *md_alg)\0A{\0A    psa_algorithm_t hash_alg = PSA_ALG_SIGN_GET_HASH(alg);\0A    *md_alg = mbedtls_md_type_from_psa_alg(hash_alg);\0A\0A    /* The Mbed TLS RSA module uses an unsigned int for hash length\0A     * parameters. Validate that it fits so that we don't risk an\0A     * overflow later. */\0A#if SIZE_MAX > UINT_MAX\0A    if (hash_length > UINT_MAX) {\0A        return PSA_ERROR_INVALID_ARGUMENT;\0A    }\0A#endif\0A\0A    /* For signatures using a hash, the hash length must be correct. */\0A    if (alg != PSA_ALG_RSA_PKCS1V15_SIGN_RAW) {\0A        if (*md_alg == MBEDTLS_MD_NONE) {\0A            return PSA_ERROR_NOT_SUPPORTED;\0A        }\0A        if (mbedtls_md_get_size_from_type(*md_alg) != hash_length) {\0A            return PSA_ERROR_INVALID_ARGUMENT;\0A        }\0A    }\0A\0A    return PSA_SUCCESS;\0A}\0A\0Apsa_status_t mbedtls_psa_rsa_sign_hash(\0A    const psa_key_attributes_t *attributes,\0A    const uint8_t *key_buffer, size_t key_buffer_size,\0A    psa_algorithm_t alg, const uint8_t *hash, size_t hash_length,\0A    uint8_t *signature, size_t signature_size, size_t *signature_length)\0A{\0A    psa_status_t status = PSA_ERROR_CORRUPTION_DETECTED;\0A    mbedtls_rsa_context *rsa = NULL;\0A    int ret = MBEDTLS_ERR_ERROR_CORRUPTION_DETECTED;\0A    mbedtls_md_type_t md_alg;\0A\0A    status = mbedtls_psa_rsa_load_representation(attributes->type,\0A                                                 key_buffer,\0A                                                 key_buffer_size,\0A                                                 &rsa);\0A    if (status != PSA_SUCCESS) {\0A        goto exit;\0A    }\0A\0A    status = psa_rsa_decode_md_type(alg, hash_length, &md_alg);\0A    if (status != PSA_SUCCESS) {\0A        goto exit;\0A    }\0A\0A    if (signature_size < mbedtls_rsa_get_len(rsa)) {\0A        status = PSA_ERROR_BUFFER_TOO_SMALL;\0A        goto exit;\0A    }\0A\0A#if defined(MBEDTLS_PSA_BUILTIN_ALG_RSA_PKCS1V15_SIGN)\0A    if (PSA_ALG_IS_RSA_PKCS1V15_SIGN(alg)) {\0A        ret = mbedtls_rsa_set_padding(rsa, MBEDTLS_RSA_PKCS_V15,\0A                                      MBEDTLS_MD_NONE);\0A        if (ret == 0) {\0A            ret = mbedtls_rsa_pkcs1_sign(rsa,\0A                                         mbedtls_psa_get_random,\0A                                         MBEDTLS_PSA_RANDOM_STATE,\0A                                         md_alg,\0A                                         (unsigned int) hash_length,\0A                                         hash,\0A                                         signature);\0A        }\0A    } else\0A#endif /* MBEDTLS_PSA_BUILTIN_ALG_RSA_PKCS1V15_SIGN */\0A#if defined(MBEDTLS_PSA_BUILTIN_ALG_RSA_PSS)\0A    if (PSA_ALG_IS_RSA_PSS(alg)) {\0A        ret = mbedtls_rsa_set_padding(rsa, MBEDTLS_RSA_PKCS_V21, md_alg);\0A\0A        if (ret == 0) {\0A            ret = mbedtls_rsa_rsassa_pss_sign(rsa,\0A                                              mbedtls_psa_get_random,\0A                                              MBEDTLS_PSA_RANDOM_STATE,\0A                                              MBEDTLS_MD_NONE,\0A                                              (unsigned int) hash_length,\0A                                              hash,\0A                                              signature);\0A        }\0A    } else\0A#endif /* MBEDTLS_PSA_BUILTIN_ALG_RSA_PSS */\0A    {\0A        status = PSA_ERROR_INVALID_ARGUMENT;\0A        goto exit;\0A    }\0A\0A    if (ret == 0) {\0A        *signature_length = mbedtls_rsa_get_len(rsa);\0A    }\0A    status = mbedtls_to_psa_error(ret);\0A\0Aexit:\0A    mbedtls_rsa_free(rsa);\0A    mbedtls_free(rsa);\0A\0A    return status;\0A}\0A\0A#if defined(MBEDTLS_PSA_BUILTIN_ALG_RSA_PSS)\0Astatic int rsa_pss_expected_salt_len(psa_algorithm_t alg,\0A                                     const mbedtls_rsa_context *rsa,\0A                                     size_t hash_length)\0A{\0A    if (PSA_ALG_IS_RSA_PSS_ANY_SALT(alg)) {\0A        return MBEDTLS_RSA_SALT_LEN_ANY;\0A    }\0A    /* Otherwise: standard salt length, i.e. largest possible salt length\0A     * up to the hash length. */\0A    int klen = (int) mbedtls_rsa_get_len(rsa);   // known to fit\0A    int hlen = (int) hash_length; // known to fit\0A    int room = klen - 2 - hlen;\0A    if (room < 0) {\0A        return 0;  // there is no valid signature in this case anyway\0A    } else if (room > hlen) {\0A        return hlen;\0A    } else {\0A        return room;\0A    }\0A}\0A#endif /* MBEDTLS_PSA_BUILTIN_ALG_RSA_PSS */\0A\0Apsa_status_t mbedtls_psa_rsa_verify_hash(\0A    const psa_key_attributes_t *attributes,\0A    const uint8_t *key_buffer, size_t key_buffer_size,\0A    psa_algorithm_t alg, const uint8_t *hash, size_t hash_length,\0A    const uint8_t *signature, size_t signature_length)\0A{\0A    psa_status_t status = PSA_ERROR_CORRUPTION_DETECTED;\0A    mbedtls_rsa_context *rsa = NULL;\0A    int ret = MBEDTLS_ERR_ERROR_CORRUPTION_DETECTED;\0A    mbedtls_md_type_t md_alg;\0A\0A    status = mbedtls_psa_rsa_load_representation(attributes->type,\0A                                                 key_buffer,\0A                                                 key_buffer_size,\0A                                                 &rsa);\0A    if (status != PSA_SUCCESS) {\0A        goto exit;\0A    }\0A\0A    status = psa_rsa_decode_md_type(alg, hash_length, &md_alg);\0A    if (status != PSA_SUCCESS) {\0A        goto exit;\0A    }\0A\0A    if (signature_length != mbedtls_rsa_get_len(rsa)) {\0A        status = PSA_ERROR_INVALID_SIGNATURE;\0A        goto exit;\0A    }\0A\0A#if defined(MBEDTLS_PSA_BUILTIN_ALG_RSA_PKCS1V15_SIGN)\0A    if (PSA_ALG_IS_RSA_PKCS1V15_SIGN(alg)) {\0A        ret = mbedtls_rsa_set_padding(rsa, MBEDTLS_RSA_PKCS_V15,\0A                                      MBEDTLS_MD_NONE);\0A        if (ret == 0) {\0A            ret = mbedtls_rsa_pkcs1_verify(rsa,\0A                                           md_alg,\0A                                           (unsigned int) hash_length,\0A                                           hash,\0A                                           signature);\0A        }\0A    } else\0A#endif /* MBEDTLS_PSA_BUILTIN_ALG_RSA_PKCS1V15_SIGN */\0A#if defined(MBEDTLS_PSA_BUILTIN_ALG_RSA_PSS)\0A    if (PSA_ALG_IS_RSA_PSS(alg)) {\0A        ret = mbedtls_rsa_set_padding(rsa, MBEDTLS_RSA_PKCS_V21, md_alg);\0A        if (ret == 0) {\0A            int slen = rsa_pss_expected_salt_len(alg, rsa, hash_length);\0A            ret = mbedtls_rsa_rsassa_pss_verify_ext(rsa,\0A                                                    md_alg,\0A                                                    (unsigned) hash_length,\0A                                                    hash,\0A                                                    md_alg,\0A                                                    slen,\0A                                                    signature);\0A        }\0A    } else\0A#endif /* MBEDTLS_PSA_BUILTIN_ALG_RSA_PSS */\0A    {\0A        status = PSA_ERROR_INVALID_ARGUMENT;\0A        goto exit;\0A    }\0A\0A    /* Mbed TLS distinguishes \22invalid padding\22 from \22valid padding but\0A     * the rest of the signature is invalid\22. This has little use in\0A     * practice and PSA doesn't report this distinction. */\0A    status = (ret == MBEDTLS_ERR_RSA_INVALID_PADDING) ?\0A             PSA_ERROR_INVALID_SIGNATURE :\0A             mbedtls_to_psa_error(ret);\0A\0Aexit:\0A    mbedtls_rsa_free(rsa);\0A    mbedtls_free(rsa);\0A\0A    return status;\0A}\0A\0A#endif /* defined(MBEDTLS_PSA_BUILTIN_ALG_RSA_PKCS1V15_SIGN) ||\0A        * defined(MBEDTLS_PSA_BUILTIN_ALG_RSA_PSS) */\0A\0A/****************************************************************/\0A/* Asymmetric cryptography */\0A/****************************************************************/\0A\0A#if defined(MBEDTLS_PSA_BUILTIN_ALG_RSA_OAEP)\0Astatic int psa_rsa_oaep_set_padding_mode(psa_algorithm_t alg,\0A                                         mbedtls_rsa_context *rsa)\0A{\0A    psa_algorithm_t hash_alg = PSA_ALG_RSA_OAEP_GET_HASH(alg);\0A    mbedtls_md_type_t md_alg = mbedtls_md_type_from_psa_alg(hash_alg);\0A\0A    /* Just to get the error status right, as rsa_set_padding() doesn't\0A     * distinguish between \22bad RSA algorithm\22 and \22unknown hash\22. */\0A    if (mbedtls_md_info_from_type(md_alg) == NULL) {\0A        return PSA_ERROR_NOT_SUPPORTED;\0A    }\0A\0A    return mbedtls_rsa_set_padding(rsa, MBEDTLS_RSA_PKCS_V21, md_alg);\0A}\0A#endif /* defined(MBEDTLS_PSA_BUILTIN_ALG_RSA_OAEP) */\0A\0Apsa_status_t mbedtls_psa_asymmetric_encrypt(const psa_key_attributes_t *attributes,\0A                                            const uint8_t *key_buffer,\0A                                            size_t key_buffer_size,\0A                                            psa_algorithm_t alg,\0A                                            const uint8_t *input,\0A                                            size_t input_length,\0A                                            const uint8_t *salt,\0A                                            size_t salt_length,\0A                                            uint8_t *output,\0A                                            size_t output_size,\0A                                            size_t *output_length)\0A{\0A    psa_status_t status = PSA_ERROR_CORRUPTION_DETECTED;\0A    (void) key_buffer;\0A    (void) key_buffer_size;\0A    (void) input;\0A    (void) input_length;\0A    (void) salt;\0A    (void) salt_length;\0A    (void) output;\0A    (void) output_size;\0A    (void) output_length;\0A\0A    if (PSA_KEY_TYPE_IS_RSA(attributes->type)) {\0A#if defined(MBEDTLS_PSA_BUILTIN_ALG_RSA_PKCS1V15_CRYPT) || \5C\0A        defined(MBEDTLS_PSA_BUILTIN_ALG_RSA_OAEP)\0A        mbedtls_rsa_context *rsa = NULL;\0A        status = mbedtls_psa_rsa_load_representation(attributes->type,\0A                                                     key_buffer,\0A                                                     key_buffer_size,\0A                                                     &rsa);\0A        if (status != PSA_SUCCESS) {\0A            goto rsa_exit;\0A        }\0A\0A        if (output_size < mbedtls_rsa_get_len(rsa)) {\0A            status = PSA_ERROR_BUFFER_TOO_SMALL;\0A            goto rsa_exit;\0A        }\0A#endif /* defined(MBEDTLS_PSA_BUILTIN_ALG_RSA_PKCS1V15_CRYPT) ||\0A        * defined(MBEDTLS_PSA_BUILTIN_ALG_RSA_OAEP) */\0A        if (alg == PSA_ALG_RSA_PKCS1V15_CRYPT) {\0A#if defined(MBEDTLS_PSA_BUILTIN_ALG_RSA_PKCS1V15_CRYPT)\0A            status = mbedtls_to_psa_error(\0A                mbedtls_rsa_pkcs1_encrypt(rsa,\0A                                          mbedtls_psa_get_random,\0A                                          MBEDTLS_PSA_RANDOM_STATE,\0A                                          input_length,\0A                                          input,\0A                                          output));\0A#else\0A            status = PSA_ERROR_NOT_SUPPORTED;\0A#endif /* MBEDTLS_PSA_BUILTIN_ALG_RSA_PKCS1V15_CRYPT */\0A        } else\0A        if (PSA_ALG_IS_RSA_OAEP(alg)) {\0A#if defined(MBEDTLS_PSA_BUILTIN_ALG_RSA_OAEP)\0A            status = mbedtls_to_psa_error(\0A                psa_rsa_oaep_set_padding_mode(alg, rsa));\0A            if (status != PSA_SUCCESS) {\0A                goto rsa_exit;\0A            }\0A\0A            status = mbedtls_to_psa_error(\0A                mbedtls_rsa_rsaes_oaep_encrypt(rsa,\0A                                               mbedtls_psa_get_random,\0A                                               MBEDTLS_PSA_RANDOM_STATE,\0A                                               salt, salt_length,\0A                                               input_length,\0A                                               input,\0A                                               output));\0A#else\0A            status = PSA_ERROR_NOT_SUPPORTED;\0A#endif /* MBEDTLS_PSA_BUILTIN_ALG_RSA_OAEP */\0A        } else {\0A            status = PSA_ERROR_INVALID_ARGUMENT;\0A        }\0A#if defined(MBEDTLS_PSA_BUILTIN_ALG_RSA_PKCS1V15_CRYPT) || \5C\0A        defined(MBEDTLS_PSA_BUILTIN_ALG_RSA_OAEP)\0Arsa_exit:\0A        if (status == PSA_SUCCESS) {\0A            *output_length = mbedtls_rsa_get_len(rsa);\0A        }\0A\0A        mbedtls_rsa_free(rsa);\0A        mbedtls_free(rsa);\0A#endif /* defined(MBEDTLS_PSA_BUILTIN_ALG_RSA_PKCS1V15_CRYPT) ||\0A        * defined(MBEDTLS_PSA_BUILTIN_ALG_RSA_OAEP) */\0A    } else {\0A        status = PSA_ERROR_NOT_SUPPORTED;\0A    }\0A\0A    return status;\0A}\0A\0Apsa_status_t mbedtls_psa_asymmetric_decrypt(const psa_key_attributes_t *attributes,\0A                                            const uint8_t *key_buffer,\0A                                            size_t key_buffer_size,\0A                                            psa_algorithm_t alg,\0A                                            const uint8_t *input,\0A 