x35, 0x46, 0xc3 },\0A    { 0x08, 0x62, 0x5c, 0xa8, 0xfe, 0x56, 0x9c, 0x19,   // 192-bit key\0A      0xba, 0x7a, 0xf3, 0x76, 0x0a, 0x6e, 0xd1, 0xce,\0A      0xf4, 0xd1, 0x99, 0x26, 0x3e, 0x99, 0x9d, 0xde,\0A      0x14, 0x08, 0x2d, 0xbb, 0xa7, 0x56, 0x0b, 0x79,\0A      0xa4, 0xc6, 0xb4, 0x56, 0xb8, 0x70, 0x7d, 0xce,\0A      0x75, 0x1f, 0x98, 0x54, 0xf1, 0x88, 0x93, 0xdf },\0A    { 0x30, 0x02, 0x6c, 0x32, 0x96, 0x66, 0x14, 0x17,   // 256-bit key\0A      0x21, 0x17, 0x8b, 0x99, 0xc0, 0xa1, 0xf1, 0xb2,\0A      0xf0, 0x69, 0x40, 0x25, 0x3f, 0x7b, 0x30, 0x89,\0A      0xe2, 0xa3, 0x0e, 0xa8, 0x6a, 0xa3, 0xc8, 0x8f,\0A      0x59, 0x40, 0xf0, 0x5a, 0xd7, 0xee, 0x41, 0xd7,\0A      0x13, 0x47, 0xbb, 0x72, 0x61, 0xe3, 0x48, 0xf1 }\0A};\0A#endif /* MBEDTLS_CIPHER_MODE_CFB */\0A\0A#define ARIA_SELF_TEST_ASSERT(cond)                   \5C\0A    do {                                            \5C\0A        if (cond) {                                \5C\0A            if (verbose)                           \5C\0A            mbedtls_printf(\22failed\5Cn\22);       \5C\0A            goto exit;                              \5C\0A        } else {                                    \5C\0A            if (verbose)                           \5C\0A            mbedtls_printf(\22passed\5Cn\22);       \5C\0A        }                                           \5C\0A    } while (0)\0A\0A/*\0A * Checkup routine\0A */\0Aint mbedtls_aria_self_test(int verbose)\0A{\0A    int i;\0A    uint8_t blk[MBEDTLS_ARIA_BLOCKSIZE];\0A    mbedtls_aria_context ctx;\0A    int ret = 1;\0A\0A#if (defined(MBEDTLS_CIPHER_MODE_CFB) || defined(MBEDTLS_CIPHER_MODE_CTR))\0A    size_t j;\0A#endif\0A\0A#if (defined(MBEDTLS_CIPHER_MODE_CBC) || \5C\0A    defined(MBEDTLS_CIPHER_MODE_CFB) || \5C\0A    defined(MBEDTLS_CIPHER_MODE_CTR))\0A    uint8_t buf[48], iv[MBEDTLS_ARIA_BLOCKSIZE];\0A#endif\0A\0A    mbedtls_aria_init(&ctx);\0A\0A    /*\0A     * Test set 1\0A     */\0A    for (i = 0; i < 3; i++) {\0A        /* test ECB encryption */\0A        if (verbose) {\0A            mbedtls_printf(\22  ARIA-ECB-%d (enc): \22, 128 + 64 * i);\0A        }\0A        mbedtls_aria_setkey_enc(&ctx, aria_test1_ecb_key, 128 + 64 * i);\0A        mbedtls_aria_crypt_ecb(&ctx, aria_test1_ecb_pt, blk);\0A        ARIA_SELF_TEST_ASSERT(\0A            memcmp(blk, aria_test1_ecb_ct[i], MBEDTLS_ARIA_BLOCKSIZE)\0A            != 0);\0A\0A        /* test ECB decryption */\0A        if (verbose) {\0A            mbedtls_printf(\22  ARIA-ECB-%d (dec): \22, 128 + 64 * i);\0A#if defined(MBEDTLS_BLOCK_CIPHER_NO_DECRYPT)\0A            mbedtls_printf(\22skipped\5Cn\22);\0A#endif\0A        }\0A\0A#if !defined(MBEDTLS_BLOCK_CIPHER_NO_DECRYPT)\0A        mbedtls_aria_setkey_dec(&ctx, aria_test1_ecb_key, 128 + 64 * i);\0A        mbedtls_aria_crypt_ecb(&ctx, aria_test1_ecb_ct[i], blk);\0A        ARIA_SELF_TEST_ASSERT(\0A            memcmp(blk, aria_test1_ecb_pt, MBEDTLS_ARIA_BLOCKSIZE)\0A            != 0);\0A#endif\0A    }\0A    if (verbose) {\0A        mbedtls_printf(\22\5Cn\22);\0A    }\0A\0A    /*\0A     * Test set 2\0A     */\0A#if defined(MBEDTLS_CIPHER_MODE_CBC)\0A    for (i = 0; i < 3; i++) {\0A        /* Test CBC encryption */\0A        if (verbose) {\0A            mbedtls_printf(\22  ARIA-CBC-%d (enc): \22, 128 + 64 * i);\0A        }\0A        mbedtls_aria_setkey_enc(&ctx, aria_test2_key, 128 + 64 * i);\0A        memcpy(iv, aria_test2_iv, MBEDTLS_ARIA_BLOCKSIZE);\0A        memset(buf, 0x55, sizeof(buf));\0A        mbedtls_aria_crypt_cbc(&ctx, MBEDTLS_ARIA_ENCRYPT, 48, iv,\0A                               aria_test2_pt, buf);\0A        ARIA_SELF_TEST_ASSERT(memcmp(buf, aria_test2_cbc_ct[i], 48)\0A                              != 0);\0A\0A        /* Test CBC decryption */\0A        if (verbose) {\0A            mbedtls_printf(\22  ARIA-CBC-%d (dec): \22, 128 + 64 * i);\0A        }\0A        mbedtls_aria_setkey_dec(&ctx, aria_test2_key, 128 + 64 * i);\0A        memcpy(iv, aria_test2_iv, MBEDTLS_ARIA_BLOCKSIZE);\0A        memset(buf, 0xAA, sizeof(buf));\0A        mbedtls_aria_crypt_cbc(&ctx, MBEDTLS_ARIA_DECRYPT, 48, iv,\0A                               aria_test2_cbc_ct[i], buf);\0A        ARIA_SELF_TEST_ASSERT(memcmp(buf, aria_test2_pt, 48) != 0);\0A    }\0A    if (verbose) {\0A        mbedtls_printf(\22\5Cn\22);\0A    }\0A\0A#endif /* MBEDTLS_CIPHER_MODE_CBC */\0A\0A#if defined(MBEDTLS_CIPHER_MODE_CFB)\0A    for (i = 0; i < 3; i++) {\0A        /* Test CFB encryption */\0A        if (verbose) {\0A            mbedtls_printf(\22  ARIA-CFB-%d (enc): \22, 128 + 64 * i);\0A        }\0A        mbedtls_aria_setkey_enc(&ctx, aria_test2_key, 128 + 64 * i);\0A        memcpy(iv, aria_test2_iv, MBEDTLS_ARIA_BLOCKSIZE);\0A        memset(buf, 0x55, sizeof(buf));\0A        j = 0;\0A        mbedtls_aria_crypt_cfb128(&ctx, MBEDTLS_ARIA_ENCRYPT, 48, &j, iv,\0A                                  aria_test2_pt, buf);\0A        ARIA_SELF_TEST_ASSERT(memcmp(buf, aria_test2_cfb_ct[i], 48) != 0);\0A\0A        /* Test CFB decryption */\0A        if (verbose) {\0A            mbedtls_printf(\22  ARIA-CFB-%d (dec): \22, 128 + 64 * i);\0A        }\0A        mbedtls_aria_setkey_enc(&ctx, aria_test2_key, 128 + 64 * i);\0A        memcpy(iv, aria_test2_iv, MBEDTLS_ARIA_BLOCKSIZE);\0A        memset(buf, 0xAA, sizeof(buf));\0A        j = 0;\0A        mbedtls_aria_crypt_cfb128(&ctx, MBEDTLS_ARIA_DECRYPT, 48, &j,\0A                                  iv, aria_test2_cfb_ct[i], buf);\0A        ARIA_SELF_TEST_ASSERT(memcmp(buf, aria_test2_pt, 48) != 0);\0A    }\0A    if (verbose) {\0A        mbedtls_printf(\22\5Cn\22);\0A    }\0A#endif /* MBEDTLS_CIPHER_MODE_CFB */\0A\0A#if defined(MBEDTLS_CIPHER_MODE_CTR)\0A    for (i = 0; i < 3; i++) {\0A        /* Test CTR encryption */\0A        if (verbose) {\0A            mbedtls_printf(\22  ARIA-CTR-%d (enc): \22, 128 + 64 * i);\0A        }\0A        mbedtls_aria_setkey_enc(&ctx, aria_test2_key, 128 + 64 * i);\0A        memset(iv, 0, MBEDTLS_ARIA_BLOCKSIZE);                      // IV = 0\0A        memset(buf, 0x55, sizeof(buf));\0A        j = 0;\0A        mbedtls_aria_crypt_ctr(&ctx, 48, &j, iv, blk,\0A                               aria_test2_pt, buf);\0A        ARIA_SELF_TEST_ASSERT(memcmp(buf, aria_test2_ctr_ct[i], 48) != 0);\0A\0A        /* Test CTR decryption */\0A        if (verbose) {\0A            mbedtls_printf(\22  ARIA-CTR-%d (dec): \22, 128 + 64 * i);\0A        }\0A        mbedtls_aria_setkey_enc(&ctx, aria_test2_key, 128 + 64 * i);\0A        memset(iv, 0, MBEDTLS_ARIA_BLOCKSIZE);                      // IV = 0\0A        memset(buf, 0xAA, sizeof(buf));\0A        j = 0;\0A        mbedtls_aria_crypt_ctr(&ctx, 48, &j, iv, blk,\0A                               aria_test2_ctr_ct[i], buf);\0A        ARIA_SELF_TEST_ASSERT(memcmp(buf, aria_test2_pt, 48) != 0);\0A    }\0A    if (verbose) {\0A        mbedtls_printf(\22\5Cn\22);\0A    }\0A#endif /* MBEDTLS_CIPHER_MODE_CTR */\0A\0A    ret = 0;\0A\0Aexit:\0A    mbedtls_aria_free(&ctx);\0A    return ret;\0A}\0A\0A#endif /* MBEDTLS_SELF_TEST */\0A\0A#endif /* MBEDTLS_ARIA_C */\0A\00" }
