g() |> Result.and_then(_, |text| {\0A            let lines = text.split(\22\5Cr\5Cn\22);\0A            http_parse_request_line(lines[0]) |> Result.and_then(_, |rl|\0A                http_parse_headers(Array.drop(lines, 1)) |> Result.and_then(_, |headers|\0A                    http_validate_host(headers, 0, false, String.ends_with(lines[0], \22HTTP/1.1\22))\0A                        |> Result.map(_, |ignored| RequestHead {\0A                            method: rl.method, path: rl.path, headers: headers,\0A                            leftover_body: raw.slice(i + 4, raw.len()),\0A                        })))\0A        }),\0A    }\0A\0A/// A small, fixed table covering the reason phrases any real client\0A/// actually looks at — not the full IANA registry. An unrecognized code\0A/// still produces a syntactically valid status line (`\22Unknown\22`), just\0A/// a less informative one; never a hard error, since the STATUS CODE\0A/// itself (not its phrase) is what every real HTTP client actually acts\0A/// on.\0Alet http_status_reason (code: Int): String = match code {\0A    200 => \22OK\22, 201 => \22Created\22, 204 => \22No Content\22,\0A    301 => \22Moved Permanently\22, 302 => \22Found\22,\0A    400 => \22Bad Request\22, 401 => \22Unauthorized\22, 403 => \22Forbidden\22, 404 => \22Not Found\22, 405 => \22Method Not Allowed\22,\0A    500 => \22Internal Server Error\22, 501 => \22Not Implemented\22, 502 => \22Bad Gateway\22, 503 => \22Service Unavailable\22,\0A    _ => \22Unknown\22,\0A}\0A\0A// This whole-response API owns framing: caller-supplied lengths/codings\0A// cannot override the method/status policy or describe a different body.\0A// Omit length for 304: resp.body need not be the selected representation.\0A// HEAD may report the byte length of the handler's would-be GET body.\0Alet http_response_to_wire (method: String) (resp: Response): Result[HttpWire, String] =\0A    if !http_status_valid(resp.status) { Err(\22http server: invalid response status\22) }\0A 