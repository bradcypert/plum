@.str41562 = private global { i64, i64, [2271 x i8] } { i64 -1, i64 2270, [2271 x i8] c"/*\0A *  Message Processing Stack, Trace module\0A *\0A *  Copyright The Mbed TLS Contributors\0A *  SPDX-License-Identifier: Apache-2.0 OR GPL-2.0-or-later\0A */\0A\0A#include \22common.h\22\0A\0A#if defined(MBEDTLS_SSL_PROTO_TLS1_3)\0A\0A#include \22mps_common.h\22\0A\0A#if defined(MBEDTLS_MPS_ENABLE_TRACE)\0A\0A#include \22mps_trace.h\22\0A#include <stdarg.h>\0A\0Astatic int trace_depth = 0;\0A\0A#define color_default  \22\5Cx1B[0m\22\0A#define color_red      \22\5Cx1B[1;31m\22\0A#define color_green    \22\5Cx1B[1;32m\22\0A#define color_yellow   \22\5Cx1B[1;33m\22\0A#define color_blue     \22\5Cx1B[1;34m\22\0A#define color_magenta  \22\5Cx1B[1;35m\22\0A#define color_cyan     \22\5Cx1B[1;36m\22\0A#define color_white    \22\5Cx1B[1;37m\22\0A\0Astatic char const *colors[] =\0A{\0A    color_default,\0A    color_green,\0A    color_yellow,\0A    color_magenta,\0A    color_cyan,\0A    color_blue,\0A    color_white\0A};\0A\0A#define MPS_TRACE_BUF_SIZE 100\0A\0Avoid mbedtls_mps_trace_print_msg(int id, int line, const char *format, ...)\0A{\0A    int ret;\0A    char str[MPS_TRACE_BUF_SIZE];\0A    va_list argp;\0A    va_start(argp, format);\0A    ret = mbedtls_vsnprintf(str, MPS_TRACE_BUF_SIZE, format, argp);\0A    va_end(argp);\0A\0A    if (ret >= 0 && ret < MPS_TRACE_BUF_SIZE) {\0A        str[ret] = '\5C0';\0A        mbedtls_printf(\22[%d|L%d]: %s\5Cn\22, id, line, str);\0A    }\0A}\0A\0Aint mbedtls_mps_trace_get_depth()\0A{\0A    return trace_depth;\0A}\0Avoid mbedtls_mps_trace_dec_depth()\0A{\0A    trace_depth--;\0A}\0Avoid mbedtls_mps_trace_inc_depth()\0A{\0A    trace_depth++;\0A}\0A\0Avoid mbedtls_mps_trace_color(int id)\0A{\0A    if (id > (int) (sizeof(colors) / sizeof(*colors))) {\0A        return;\0A    }\0A    printf(\22%s\22, colors[id]);\0A}\0A\0Avoid mbedtls_mps_trace_indent(int level, mbedtls_mps_trace_type ty)\0A{\0A    if (level > 0) {\0A        while (--level) {\0A            printf(\22|  \22);\0A        }\0A\0A        printf(\22|  \22);\0A    }\0A\0A    switch (ty) {\0A        case MBEDTLS_MPS_TRACE_TYPE_COMMENT:\0A            mbedtls_printf(\22@ \22);\0A            break;\0A\0A        case MBEDTLS_MPS_TRACE_TYPE_CALL:\0A            mbedtls_printf(\22+--> \22);\0A            break;\0A\0A        case MBEDTLS_MPS_TRACE_TYPE_ERROR:\0A            mbedtls_printf(\22E \22);\0A            break;\0A\0A        case MBEDTLS_MPS_TRACE_TYPE_RETURN:\0A            mbedtls_printf(\22< \22);\0A            break;\0A\0A        default:\0A            break;\0A    }\0A}\0A\0A#endif /* MBEDTLS_MPS_ENABLE_TRACE */\0A#endif /* MBEDTLS_SSL_PROTO_TLS1_3 */\0A\00" }
