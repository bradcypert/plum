{\0A    return ~mbedtls_ct_uint_gt(x, y);\0A}\0A\0Astatic inline mbedtls_ct_condition_t mbedtls_ct_bool_ne(mbedtls_ct_condition_t x,\0A                                                        mbedtls_ct_condition_t y)\0A{\0A    return (mbedtls_ct_condition_t) (x ^ y);\0A}\0A\0Astatic inline mbedtls_ct_condition_t mbedtls_ct_bool_and(mbedtls_ct_condition_t x,\0A                                                         mbedtls_ct_condition_t y)\0A{\0A    return (mbedtls_ct_condition_t) (x & y);\0A}\0A\0Astatic inline mbedtls_ct_condition_t mbedtls_ct_bool_or(mbedtls_ct_condition_t x,\0A                                                        mbedtls_ct_condition_t y)\0A{\0A    return (mbedtls_ct_condition_t) (x | y);\0A}\0A\0Astatic inline mbedtls_ct_condition_t mbedtls_ct_bool_not(mbedtls_ct_condition_t x)\0A{\0A    return (mbedtls_ct_condition_t) (~x);\0A}\0A\0A#if defined(MBEDTLS_COMPILER_IS_GCC) && (__GNUC__ > 4)\0A/* Restore warnings for -Wredundant-decls on gcc */\0A    #pragma GCC diagnostic pop\0A#endif\0A\0A#endif /* MBEDTLS_CONSTANT_TIME_IMPL_H */\0A\00" }
