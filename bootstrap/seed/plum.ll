@.str62838 = private global { i64, i64, [14334 x i8] } { i64 -1, i64 14333, [14334 x i8] c"/// Hoisted, so the platform is not re-derived per character. It is\0A/// compiled in (`Os.platform()` is a constant, not a lookup), but a\0A/// global says that once rather than trusting every call site to be\0A/// cheap.\0Alet IS_WINDOWS: Bool = Os.platform() == \22windows\22\0A\0A/// `\5C\5C` on Windows, `/` everywhere else.\0A///\0A/// Every function in this module has an `_in` form taking the\0A/// convention as its first argument, and a host form that reads it\0A/// from `Os.platform()`. The pair exists because the Windows branch\0A/// is UNREACHABLE on a Unix machine, not merely untested, so a\0A/// Windows-only path bug could otherwise only be found by CI, on a\0A/// machine nobody can attach a debugger to. `lsp.uri_to_path_in` is\0A/// the same shape for the same reason, and two releases shipped bugs\0A/// of exactly this kind before it existed.\0A///\0A/// They are also what to call when you are building a path FOR\0A/// another platform rather than for the one you are running on.\0Apub let separator_in (windows: Bool): String = if windows { \22\5C\5C\22 } else { \22/\22 }\0Apub let separator (): String = separator_in(IS_WINDOWS)\0A\0A/// Backslashes become forward slashes on Windows so the rest of this\0A/// module has ONE separator to reason about. A no-op elsewhere: a\0A/// backslash is a legal character in a Unix filename and must not be\0A/// touched there.\0Alet normalize_in (windows: Bool) (p: String): String = if windows { String.replace(p, \22\5C\5C\22, \22/\22) } else { p }\0A\0A// All indices below are UTF-8 byte offsets. Separators, dots and drive\0A// letters are ASCII, so boundaries found here cannot split a codepoint.\0Alet byte_at (b: Bytes) (i: Int): Int = Option.unwrap_or(b.at(i), 0)\0Alet alpha (c: Int): Bool = (c >= 65 && c <= 90) || (c >= 97 && c <= 122)\0Alet drive_end (windows: Bool) (b: Bytes): Int =\0A    if windows && b.len() >= 2 && alpha(byte_at(b, 0)) && byte_at(b, 1) == 58 { 2 } else { 0 }\0Alet has_drive_in (windows: Bool) (p: String): Bool = drive_end(windows, p.as_bytes()) == 2\0A\0A// Native argv and filesystem paths can carry non-UTF-8 bytes (POSIX\0A// filenames and Windows ANSI paths). Slicing an existing path must\0A// preserve those bytes, rather than decode them as newly received text.\0A// This private runtime retag keeps the slice's explicit length and\0A// ownership, including embedded NULs; Bytes.as_string stays validating.\0Alet str_of_bytes_raw (b: Bytes): String = \22\22\0Alet text_range (b: Bytes) (start: Int) (end: Int): String =\0A    str_of_bytes_raw(b.slice(start, end))\0A\0A// Input is normalized once. The root includes the UNC server/share,\0A// but base still names the last component (including a bare share).\0Astruct Bounds { drive: Int, root: Int, end: Int, base: Int, rooted: Bool, unc: Bool }\0Alet segment_end (b: Bytes) (i: Int): Int =\0A    if i >= b.len() || byte_at(b, i) == 47 { i } else { segment_end(b, i + 1) }\0Alet skip_seps (b: Bytes) (i: Int): Int =\0A    if i < b.len() && byte_at(b, i) == 47 { skip_seps(b, i + 1) } else { i }\0Alet trim_end (b: Bytes) (i: Int) (floor: Int): Int =\0A    if i > floor && byte_at(b, i - 1) == 47 { trim_end(b, i - 1, floor) } else { i }\0Alet base_start (b: Bytes) (i: Int) (floor: Int): Int =\0A    if i <= floor || byte_at(b, i - 1) == 47 { i } else { base_start(b, i - 1, floor) }\0A\0Alet bounds (windows: Bool) (b: Bytes): Bounds = {\0A    let drive = drive_end(windows, b);\0A    let rooted = drive < b.len() && byte_at(b, drive) == 47;\0A    let unc = windows && drive == 0 && b.len() >= 2 && byte_at(b, 0) == 47\0A        && byte_at(b, 1) == 47 && (b.len() == 2 || byte_at(b, 2) != 47);\0A    let server_end = if unc { segment_end(b, 2) } else { 0 };\0A    let root = if unc {\0A        if server_end < b.len() { segment_end(b, skip_seps(b, server_end)) } else { server_end }\0A    } else { drive + if rooted { 1 } else { 0 } };\0A    let end = trim_end(b, b.len(), drive);\0A    Bounds { drive: drive, root: root, end: end, base: base_start(b, end, drive), rooted: rooted, unc: unc }\0A}\0A\0A/// Rooted: `/x` anywhere, and on Windows also `C:/x` and a `//server`\0A/// UNC path. `C:x` (a drive-RELATIVE path) is deliberately not\0A/// absolute; it means \22the current directory on drive C\22, which is\0A/// a relative path with a drive attached.\0Apub let is_absolute_in (windows: Bool) (p: String): Bool = {\0A    let n = normalize_in(windows, p);\0A    let b = n.as_bytes();\0A    let drive = drive_end(windows, b);\0A    drive < b.len() && byte_at(b, drive) == 47\0A}\0Apub let is_absolute (p: String): Bool = is_absolute_in(IS_WINDOWS, p)\0A\0A/// --- clean ---\0A///\0A/// Lexical only, and that limit is the point: `a/b/../c` becomes\0A/// `a/c` WITHOUT asking whether `a/b` is a symlink pointing\0A/// elsewhere. Resolving that needs syscalls and is a different\0A/// function; `Os.remove_tree` already refuses to follow links out of\0A/// a tree rather than trying to reason about them.\0A// An owned linked stack gives constant-time push/pop without Array.remove\0A// or Array.slice copying a growing prefix. Drain it explicitly at the end\0A// so neither scanning nor releasing a deep path grows the machine stack.\0Aenum Segments { NoSegments, Segment(String, Segments) }\0Alet segment_strings (stack: Segments) (parts: Array[String]): Array[String] = match stack {\0A    NoSegments => Array.reverse(parts),\0A    Segment(part, rest) => {\0A        parts = parts.push(part);\0A        segment_strings(rest, parts)\0A    },\0A}\0Alet clean_parts (b: Bytes) (i: Int) (rooted: Bool) (stack: Segments): Array[String] =\0A    if i >= b.len() { segment_strings(stack, []) }\0A    else {\0A        let end = segment_end(b, i);\0A        let part = text_range(b, i, end);\0A        if part == \22\22 || part == \22.\22 { clean_parts(b, end + 1, rooted, stack) }\0A        else if part == \22..\22 { match stack {\0A            Seg