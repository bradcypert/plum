@.str41549 = private global { i64, i64, [43504 x i8] } { i64 -1, i64 43503, [43504 x i8] c"/*\0A *  Public Key layer for parsing key files and structures\0A *\0A *  Copyright The Mbed TLS Contributors\0A *  SPDX-License-Identifier: Apache-2.0 OR GPL-2.0-or-later\0A */\0A\0A#include \22common.h\22\0A\0A#if defined(MBEDTLS_PK_PARSE_C)\0A\0A#include \22mbedtls/pk.h\22\0A#include \22mbedtls/asn1.h\22\0A#include \22mbedtls/oid.h\22\0A#include \22mbedtls/platform_util.h\22\0A#include \22mbedtls/platform.h\22\0A#include \22mbedtls/error.h\22\0A#include \22mbedtls/ecp.h\22\0A#include \22pk_internal.h\22\0A\0A#include <string.h>\0A\0A#if defined(MBEDTLS_USE_PSA_CRYPTO)\0A#include \22mbedtls/psa_util.h\22\0A#include \22psa/crypto.h\22\0A#endif\0A\0A/* Key types */\0A#if defined(MBEDTLS_RSA_C)\0A#include \22mbedtls/rsa.h\22\0A#include \22rsa_internal.h\22\0A#endif\0A\0A/* Extended formats */\0A#if defined(MBEDTLS_PEM_PARSE_C)\0A#include \22mbedtls/pem.h\22\0A#endif\0A#if defined(MBEDTLS_PKCS5_C)\0A#include \22mbedtls/pkcs5.h\22\0A#endif\0A#if defined(MBEDTLS_PKCS12_C)\0A#include \22mbedtls/pkcs12.h\22\0A#endif\0A\0A#if defined(MBEDTLS_PK_HAVE_ECC_KEYS)\0A\0A/***********************************************************************\0A *\0A *      Low-level ECC parsing: optional support for SpecifiedECDomain\0A *\0A * There are two functions here that are used by the rest of the code:\0A * - pk_ecc_tag_is_speficied_ec_domain()\0A * - pk_ecc_group_id_from_specified()\0A *\0A * All the other functions are internal to this section.\0A *\0A * The two \22public\22 functions have a dummy variant provided\0A * in configs without MBEDTLS_PK_PARSE_EC_EXTENDED. This acts as an\0A * abstraction layer for this macro, which should not appear outside\0A * this section.\0A *\0A **********************************************************************/\0A\0A#if !defined(MBEDTLS_PK_PARSE_EC_EXTENDED)\0A/* See the \22real\22 version for documentation */\0Astatic int pk_ecc_tag_is_specified_ec_domain(int tag)\0A{\0A    (void) tag;\0A    return 0;\0A}\0A\0A/* See the \22real\22 version for documentation */\0Astatic int pk_ecc_group_id_from_specified(const mbedtls_asn1_buf *params,\0A                                          mbedtls_ecp_group_id *grp_id)\0A{\0A    (void) params;\0A    (void) grp_id;\0A    return MBEDTLS_ERR_ECP_FEATURE_UNAVAILABLE;\0A}\0A#else /* MBEDTLS_PK_PARSE_EC_EXTENDED */\0A/*\0A * Tell if the passed tag might be the start of SpecifiedECDomain\0A * (that is, a sequence).\0A */\0Astatic int pk_ecc_tag_is_specified_ec_domain(int tag)\0A{\0A    return tag == (MBEDTLS_ASN1_CONSTRUCTED | MBEDTLS_ASN1_SEQUENCE);\0A}\0A\0A/*\0A * Parse a SpecifiedECDomain (SEC 1 C.2) and (mostly) fill the group with it.\0A * WARNING: the resulting group should only be used with\0A * pk_ecc_group_id_from_specified(), since its base point may not be set correctly\0A * if it was encoded compressed.\0A *\0A *  SpecifiedECDomain ::= SEQUENCE {\0A *      version SpecifiedECDomainVersion(ecdpVer1 | ecdpVer2 | ecdpVer3, ...),\0A *      fieldID FieldID {{FieldTypes}},\0A *      curve Curve,\0A *      base ECPoint,\0A *      order INTEGER,\0A *      cofactor INTEGER OPTIONAL,\0A *      hash HashAlgorithm OPTIONAL,\0A *      ...\0A *  }\0A *\0A * We only support prime-field as field type, and ignore hash and cofactor.\0A */\0Astatic int pk_group_from_specified(const mbedtls_asn1_buf *params, mbedtls_ecp_group *grp)\0A{\0A    int ret = MBEDTLS_ERR_ERROR_CORRUPTION_DETECTED;\0A    unsigned char *p = params->p;\0A    const unsigned char *const end = params->p + params->len;\0A    const unsigned char *end_field, *end_curve;\0A    size_t len;\0A    int ver;\0A\0A    /* SpecifiedECDomainVersion ::= INTEGER { 1, 2, 3 } */\0A    if ((ret = mbedtls_asn1_get_int(&p, end, &ver)) != 0) {\0A        return MBEDTLS_ERROR_ADD(MBEDTLS_ERR_PK_KEY_INVALID_FORMAT, ret);\0A    }\0A\0A    if (ver < 1 || ver > 3) {\0A        return MBEDTLS_ERR_PK_KEY_INVALID_FORMAT;\0A    }\0A\0A    /*\0A     * FieldID { FIELD-ID:IOSet } ::= SEQUENCE { -- Finite field\0A     *       fieldType FIELD-ID.&id({IOSet}),\0A     *       parameters FIELD-ID.&Type({IOSet}{@fieldType})\0A     * }\0A     */\0A    if ((ret = mbedtls_asn1_get_tag(&p, end, &len,\0A                                    MBEDTLS_ASN1_CONSTRUCTED | MBEDTLS_ASN1_SEQUENCE)) != 0) {\0A        return ret;\0A    }\0A\0A    end_field = p + len;\0A\0A    /*\0A     * FIELD-ID ::= TYPE-IDENTIFIER\0A     * FieldTypes FIELD-ID ::= {\0A     *       { Prime-p IDENTIFIED BY prime-field } |\0A     *       { Characteristic-two IDENTIFIED BY characteristic-two-field }\0A     * }\0A     * prime-field OBJECT IDENTIFIER ::= { id-fieldType 1 }\0A     */\0A    if ((ret = mbedtls_asn1_get_tag(&p, end_field, &len, MBEDTLS_ASN1_OID)) != 0) {\0A        return ret;\0A    }\0A\0A    if (len != MBEDTLS_OID_SIZE(MBEDTLS_OID_ANSI_X9_62_PRIME_FIELD) ||\0A        memcmp(p, MBEDTLS_OID_ANSI_X9_62_PRIME_FIELD, len) != 0) {\0A        return MBEDTLS_ERR_PK_FEATURE_UNAVAILABLE;\0A    }\0A\0A    p += len;\0A\0A    /* Prime-p ::= INTEGER -- Field of size p. */\0A    if ((ret = mbedtls_asn1_get_mpi(&p, end_field, &grp->P)) != 0) {\0A        return MBEDTLS_ERROR_ADD(MBEDTLS_ERR_PK_KEY_INVALID_FORMAT, ret);\0A    }\0A\0A    grp->pbits = mbedtls_mpi_bitlen(&grp->P);\0A\0A    if (p != end_field) {\0A        return MBEDTLS_ERROR_ADD(MBEDTLS_ERR_PK_KEY_INVALID_FORMAT,\0A                                 MBEDTLS_ERR_ASN1_LENGTH_MISMATCH);\0A    }\0A\0A    /*\0A     * Curve ::= SEQUENCE {\0A     *       a FieldElement,\0A     *       b FieldElement,\0A     *       seed BIT STRING OPTIONAL\0A     *       -- Shall be present if used in SpecifiedECDomain\0A     *       -- with version equal to ecdpVer2 or ecdpVer3\0A     * }\0A     */\0A    if ((ret = mbedtls_asn1_get_tag(&p, end, &len,\0A                                    MBEDTLS_ASN1_CONSTRUCTED | MBEDTLS_ASN1_SEQUENCE)) != 0) {\0A        return ret;\0A    }\0A\0A    end_curve = p + len;\0A\0A    /*\0A     * FieldElement ::= OCTET STRING\0A     * containing an integer in the case of a prime field\0A     */\0A    if ((ret = mbedtls_asn1_get_tag(&p, end_curve, &len, MBEDTLS_ASN1_OCTET_STRING)) != 0 ||\0A        (ret = mbedtls_mpi_read_binary(&grp->A, p, len)) != 0) {\0A        return MBEDTLS_ERROR_ADD(MBEDTLS_ERR_PK_KEY_INVALID_FORMAT, ret);\0A    }\0A\0A    p += len;\0A\0A    if ((ret = mbedtls_asn1_get_tag(&p, end_curve, &len, MBEDTLS_ASN1_OCTET_STRING)) != 0 ||\0A        (ret = mbedtls_mpi_read_binary(&grp->B, p, len)) != 0) {\0A        return MBEDTLS_ERROR_ADD(MBEDTLS_ERR_PK_KEY_INVALID_FORMAT, ret);\0A    }\0A\0A    p += len;\0A\0A    /* Ignore seed BIT STRING OPTIONAL */\0A    if ((ret = mbedtls_asn1_get_tag(&p, end_curve, &len, MBEDTLS_ASN1_BIT_STRING)) == 0) {\0A        p += len;\0A    }\0A\0A    if (p != end_curve) {\0A        return MBEDTLS_ERROR_ADD(MBEDTLS_ERR_PK_KEY_INVALID_FORMAT,\0A                                 MBEDTLS_ERR_ASN1_LENGTH_MISMATCH);\0A    }\0A\0A    /*\0A     * ECPoint ::= OCTET STRING\0A     */\0A    if ((ret = mbedtls_asn1_get_tag(&p, end, &len, MBEDTLS_ASN1_OCTET_STRING)) != 0) {\0A        return MBEDTLS_ERROR_ADD(MBEDTLS_ERR_PK_KEY_INVALID_FORMAT, ret);\0A    }\0A\0A    if ((ret = mbedtls_ecp_point_read_binary(grp, &grp->G,\0A                                             (const unsigned char *) p, len)) != 0) {\0A        /*\0A         * If we can't read the point because it's compressed, cheat by\0A         * reading only the X coordinate and the parity bit of Y.\0A         */\0A        if (ret != MBEDTLS_ERR_ECP_FEATURE_UNAVAILABLE ||\0A            (p[0] != 0x02 && p[0] != 0x03) ||\0A            len != mbedtls_mpi_size(&grp->P) + 1 ||\0A            mbedtls_mpi_read_binary(&grp->G.X, p + 1, len - 1) != 0 ||\0A            mbedtls_mpi_lset(&grp->G.Y, p[0] - 2) != 0 ||\0A            mbedtls_mpi_lset(&grp->G.Z, 1) != 0) {\0A            return MBEDTLS_ERR_PK_KEY_INVALID_FORMAT;\0A        }\0A    }\0A\0A    p += len;\0A\0A    /*\0A     * order INTEGER\0A     */\0A    if ((ret = mbedtls_asn1_get_mpi(&p, end, &grp->N)) != 0) {\0A        return MBEDTLS_ERROR_ADD(MBEDTLS_ERR_PK_KEY_INVALID_FORMAT, ret);\0A    }\0A\0A    grp->nbits = mbedtls_mpi_bitlen(&grp->N);\0A\0A    /*\0A     * Allow optional elements by purposefully not enforcing p == end here.\0A     */\0A\0A    return 0;\0A}\0A\0A/*\0A * Find the group id associated with an (almost filled) group as generated by\0A * pk_group_from_specified(), or return an error if unknown.\0A */\0Astatic int pk_group_id_from_group(const mbedtls_ecp_group *grp, mbedtls_ecp_group_id *grp_id)\0A{\0A    int ret = 0;\0A    mbedtls_ecp_group ref;\0A    const mbedtls_ecp_group_id *id;\0A\0A    mbedtls_ecp_group_init(&ref);\0A\0A    for (id = mbedtls_ecp_grp_id_list(); *id != MBEDTLS_ECP_DP_NONE; id++) {\0A        /* Load the group associated to that id */\0A        mbedtls_ecp_group_free(&ref);\0A        MBEDTLS_MPI_CHK(mbedtls_ecp_group_load(&ref, *id));\0A\0A        /* Compare to the group we were given, starting with easy tests */\0A        if (grp->pbits == ref.pbits && grp->nbits == ref.nbits &&\0A            mbedtls_mpi_cmp_mpi(&grp->P, &ref.P) == 0 &&\0A            mbedtls_mpi_cmp_mpi(&grp->A, &ref.A) == 0 &&\0A            mbedtls_mpi_cmp_mpi(&grp->B, &ref.B) == 0 &&\0A            mbedtls_mpi_cmp_mpi(&grp->N, &ref.N) == 0 &&\0A            mbedtls_mpi_cmp_mpi(&grp->G.X, &ref.G.X) == 0 &&\0A            mbedtls_mpi_cmp_mpi(&grp->G.Z, &ref.G.Z) == 0 &&\0A            /* For Y we may only know the parity bit, so compare only that */\0A            mbedtls_mpi_get_bit(&grp->G.Y, 0) == mbedtls_mpi_get_bit(&ref.G.Y, 0)) {\0A            break;\0A        }\0A    }\0A\0Acleanup:\0A    mbedtls_ecp_group_free(&ref);\0A\0A    *grp_id = *id;\0A\0A    if (ret == 0 && *id == MBEDTLS_ECP_DP_NONE) {\0A        ret = MBEDTLS_ERR_ECP_FEATURE_UNAVAILABLE;\0A    }\0A\0A    return ret;\0A}\0A\0A/*\0A * Parse a SpecifiedECDomain (SEC 1 C.2) and find the associated group ID\0A */\0Astatic int pk_ecc_group_id_from_specified(const mbedtls_asn1_buf *params,\0A                                          mbedtls_ecp_group_id *grp_id)\0A{\0A    int ret = MBEDTLS_ERR_ERROR_CORRUPTION_DETECTED;\0A    mbedtls_ecp_group grp;\0A\0A    mbedtls_ecp_group_init(&grp);\0A\0A    if ((ret = pk_group_from_specified(params, &grp)) != 0) {\0A        goto cleanup;\0A    }\0A\0A    ret = pk_group_id_from_group(&grp, grp_id);\0A\0Acleanup:\0A    /* The API respecting lifecycle for mbedtls_ecp_group struct is\0A     * _init(), _load() and _free(). In pk_ecc_group_id_from_specified() the\0A     * temporary grp breaks that flow and it's members are populated\0A     * by pk_group_id_from_group(). As such mbedtls_ecp_group_free()\0A     * which is assuming a group populated by _setup() may not clean-up\0A     * properly -> Manually free it's members.\0A     */\0A    mbedtls_mpi_free(&grp.N);\0A    mbedtls_mpi_free(&grp.P);\0A    mbedtls_mpi_free(&grp.A);\0A    mbedtls_mpi_free(&grp.B);\0A    mbedtls_ecp_point_free(&grp.G);\0A\0A    return ret;\0A}\0A#endif /* MBEDTLS_PK_PARSE_EC_EXTENDED */\0A\0A/***********************************************************************\0A *\0A * Unsorted (yet!) from this point on until the next section header\0A *\0A **********************************************************************/\0A\0A/* Minimally parse an ECParameters buffer to and mbedtls_asn1_buf\0A *\0A * ECParameters ::= CHOICE {\0A *   namedCurve         OBJECT IDENTIFIER\0A *   specifiedCurve     SpecifiedECDomain -- = SEQUENCE { ... }\0A *   -- implicitCurve   NULL\0A * }\0A */\0Astatic int pk_get_ecparams(unsigned char **p, const unsigned char *end,\0A                           mbedtls_asn1_buf *params)\0A{\0A    int ret = MBEDTLS_ERR_ERROR_CORRUPTION_DETECTED;\0A\0A    if (end - *p < 1) {\0A        return MBEDTLS_ERROR_ADD(MBEDTLS_ERR_PK_KEY_INVALID_FORMAT,\0A                                 MBEDTLS_ERR_ASN1_OUT_OF_DATA);\0A    }\0A\0A    /* Acceptable tags: OID for namedCurve, or specifiedECDomain */\0A    params->tag = **p;\0A    if (params->tag != MBEDTLS_ASN1_OID &&\0A        !pk_ecc_tag_is_specified_ec_domain(params->tag)) {\0A        return MBEDTLS_ERROR_ADD(MBEDTLS_ERR_PK_KEY_INVALID_FORMAT,\0A                                 MBEDTLS_ERR_ASN1_UNEXPECTED_TAG);\0A    }\0A\0A    if ((ret = mbedtls_asn1_get_tag(p, end, &params->len, params->tag)) != 0) {\0A        return MBEDTLS_ERROR_ADD(MBEDTLS_ERR_PK_KEY_INVALID_FORMAT, ret);\0A    }\0A\0A    params->p = *p;\0A    *p += params->len;\0A\0A    if (*p != end) {\0A        return MBEDTLS_ERROR_ADD(MBEDTLS_ERR_PK_KEY_INVALID_FORMAT,\0A                                 MBEDTLS_ERR_ASN1_LENGTH_MISMATCH);\0A    }\0A\0A    return 0;\0A}\0A\0A/*\0A * Use EC parameters to initialise an EC group\0A *\0A * ECParameters ::= CHOICE {\0A *   namedCurve         OBJECT IDENTIFIER\0A *   specifiedCurve     SpecifiedECDomain -- = SEQUENCE { ... }\0A *   -- implicitCurve   NULL\0A */\0Astatic int pk_use_ecparams(const mbedtls_asn1_buf *params, mbedtls_pk_context *pk)\0A{\0A    int ret = MBEDTLS_ERR_ERROR_CORRUPTION_DETECTED;\0A    mbedtls_ecp_group_id grp_id;\0A\0A    if (params->tag == MBEDTLS_ASN1_OID) {\0A        if (mbedtls_oid_get_ec_grp(params, &grp_id) != 0) {\0A            return MBEDTLS_ERR_PK_UNKNOWN_NAMED_CURVE;\0A        }\0A    } else {\0A        ret = pk_ecc_group_id_from_specified(params, &grp_id);\0A        if (ret != 0) {\0A            return ret;\0A        }\0A    }\0A\0A    return mbedtls_pk_ecc_set_group(pk, grp_id);\0A}\0A\0A#if defined(MBEDTLS_PK_HAVE_RFC8410_CURVES)\0A\0A/*\0A * Load an RFC8410 EC key, which doesn't have any parameters\0A */\0Astatic int pk_use_ecparams_rfc8410(const mbedtls_asn1_buf *params,\0A                                   mbedtls_ecp_group_id grp_id,\0A                                   mbedtls_pk_context *pk)\0A{\0A    if (params->tag != 0 || params->len != 0) {\0A        return MBEDTLS_ERR_PK_KEY_INVALID_FORMAT;\0A    }\0A\0A    return mbedtls_pk_ecc_set_group(pk, grp_id);\0A}\0A\0A/*\0A * Parse an RFC 8410 encoded private EC key\0A *\0A * CurvePrivateKey ::= OCTET STRING\0A */\0Astatic int pk_parse_key_rfc8410_der(mbedtls_pk_context *pk,\0A                                    unsigned char *key, size_t keylen, const unsigned char *end,\0A                                    int (*f_rng)(void *, unsigned char *, size_t), void *p_rng)\0A{\0A    int ret = MBEDTLS_ERR_ERROR_CORRUPTION_DETECTED;\0A    size_t len;\0A\0A    if ((ret = mbedtls_asn1_get_tag(&key, (key + keylen), &len, MBEDTLS_ASN1_OCTET_STRING)) != 0) {\0A        return MBEDTLS_ERROR_ADD(MBEDTLS_ERR_PK_KEY_INVALID_FORMAT, ret);\0A    }\0A\0A    if (key + len != end) {\0A        return MBEDTLS_ERR_PK_KEY_INVALID_FORMAT;\0A    }\0A\0A    /*\0A     * Load the private key\0A     */\0A    ret = mbedtls_pk_ecc_set_key(pk, key, len);\0A    if (ret != 0) {\0A        return ret;\0A    }\0A\0A    /* pk_parse_key_pkcs8_unencrypted_der() only supports version 1 PKCS8 keys,\0A     * which never contain a public key. As such, derive the public key\0A     * unconditionally. */\0A    if ((ret = mbedtls_pk_ecc_set_pubkey_from_prv(pk, key, len, f_rng, p_rng)) != 0) {\0A        return ret;\0A    }\0A\0A    return 0;\0A}\0A#endif /* MBEDTLS_PK_HAVE_RFC8410_CURVES */\0A\0A#endif /* MBEDTLS_PK_HAVE_ECC_KEYS */\0A\0A/* Get a PK algorithm identifier\0A *\0A *  AlgorithmIdentifier  ::=  SEQUENCE  {\0A *       algorithm               OBJECT IDENTIFIER,\0A *       parameters              ANY DEFINED BY algorithm OPTIONAL  }\0A */\0Astatic int pk_get_pk_alg(unsigned char **p,\0A                         const unsigned char *end,\0A                         mbedtls_pk_type_t *pk_alg, mbedtls_asn1_buf *params,\0A                         mbedtls_ecp_group_id *ec_grp_id)\0A{\0A    int ret = MBEDTLS_ERR_ERROR_CORRUPTION_DETECTED;\0A    mbedtls_asn1_buf alg_oid;\0A\0A    memset(params, 0, sizeof(mbedtls_asn1_buf));\0A\0A    if ((ret = mbedtls_asn1_get_alg(p, end, &alg_oid, params)) != 0) {\0A        return MBEDTLS_ERROR_ADD(MBEDTLS_ERR_PK_INVALID_ALG, ret);\0A    }\0A\0A    ret = mbedtls_oid_get_pk_alg(&alg_oid, pk_alg);\0A#if defined(MBEDTLS_PK_HAVE_ECC_KEYS)\0A    if (ret == MBEDTLS_ERR_OID_NOT_FOUND) {\0A        ret = mbedtls_oid_get_ec_grp_algid(&alg_oid, ec_grp_id);\0A        if (ret == 0) {\0A            *pk_alg = MBEDTLS_PK_ECKEY;\0A        }\0A    }\0A#else\0A    (void) ec_grp_id;\0A#endif\0A    if (ret != 0) {\0A        return MBEDTLS_ERR_PK_UNKNOWN_PK_ALG;\0A    }\0A\0A    /*\0A     * No parameters with RSA (only for EC)\0A     */\0A    if (*pk_alg == MBEDTLS_PK_RSA &&\0A        ((params->tag != MBEDTLS_ASN1_NULL && params->tag != 0) ||\0A         params->len != 0)) {\0A        return MBEDTLS_ERR_PK_INVALID_ALG;\0A    }\0A\0A    return 0;\0A}\0A\0A/*\0A *  SubjectPublicKeyInfo  ::=  SEQUENCE  {\0A *       algorithm            AlgorithmIdentifier,\0A *       subjectPublicKey     BIT STRING }\0A */\0Aint mbedtls_pk_parse_subpubkey(unsigned char **p, const unsigned char *end,\0A                               mbedtls_pk_context *pk)\0A{\0A    int ret = MBEDTLS_ERR_ERROR_CORRUPTION_DETECTED;\0A    size_t len;\0A    mbedtls_asn1_buf alg_params;\0A    mbedtls_pk_type_t pk_alg = MBEDTLS_PK_NONE;\0A    mbedtls_ecp_group_id ec_grp_id = MBEDTLS_ECP_DP_NONE;\0A    const mbedtls_pk_info_t *pk_info;\0A\0A    if ((ret = mbedtls_asn1_get_tag(p, end, &len,\0A                                    MBEDTLS_ASN1_CONSTRUCTED | MBEDTLS_ASN1_SEQUENCE)) != 0) {\0A        return MBEDTLS_ERROR_ADD(MBEDTLS_ERR_PK_KEY_INVALID_FORMAT, ret);\0A    }\0A\0A    end = *p + len;\0A\0A    if ((ret = pk_get_pk_alg(p, end, &pk_alg, &alg_params, &ec_grp_id)) != 0) {\0A        return ret;\0A    }\0A\0A    if ((ret = mbedtls_asn1_get_bitstring_null(p, end, &len)) != 0) {\0A        return MBEDTLS_ERROR_ADD(MBEDTLS_ERR_PK_INVALID_PUBKEY, ret);\0A    }\0A\0A    if (*p + len != end) {\0A        return MBEDTLS_ERROR_ADD(MBEDTLS_ERR_PK_INVALID_PUBKEY,\0A                                 MBEDTLS_ERR_ASN1_LENGTH_MISMATCH);\0A    }\0A\0A    if ((pk_info = mbedtls_pk_info_from_type(pk_alg)) == NULL) {\0A        return MBEDTLS_ERR_PK_UNKNOWN_PK_ALG;\0A    }\0A\0A    if ((ret = mbedtls_pk_setup(pk, pk_info)) != 0) {\0A        return ret;\0A    }\0A\0A#if defined(MBEDTLS_RSA_C)\0A    if (pk_alg == MBEDTLS_PK_RSA) {\0A        ret = mbedtls_rsa_parse_pubkey(mbedtls_pk_rsa(*pk), *p, (size_t) (end - *p));\0A        if (ret == 0) {\0A            /* On success all the input has been consumed by the parsing function. */\0A            *p += end - *p;\0A        } else if ((ret <= MBEDTLS_ERR_ASN1_OUT_OF_DATA) &&\0A                   (ret >= MBEDTLS_ERR_ASN1_BUF_TOO_SMALL)) {\0A            /* In case of ASN1 error codes add MBEDTLS_ERR_PK_INVALID_PUBKEY. */\0A            ret = MBEDTLS_ERROR_ADD(MBEDTLS_ERR_PK_INVALID_PUBKEY, ret);\0A        } else {\0A            ret = MBEDTLS_ERR_PK_INVALID_PUBKEY;\0A        }\0A    } else\0A#endif /* MBEDTLS_RSA_C */\0A#if defined(MBEDTLS_PK_HAVE_ECC_KEYS)\0A    if (pk_alg == MBEDTLS_PK_ECKEY_DH || pk_alg == MBEDTLS_PK_ECKEY) {\0A#if defined(MBEDTLS_PK_HAVE_RFC8410_CURVES)\0A        if (MBEDTLS_PK_IS_RFC8410_GROUP_ID(ec_grp_id)) {\0A            ret = pk_use_ecparams_rfc8410(&alg_params, ec_grp_id, pk);\0A        } else\0A#endif\0A        {\0A            ret = pk_use_ecparams(&alg_params, pk);\0A        }\0A        if (ret == 0) {\0A            ret = mbedtls_pk_ecc_set_pubkey(pk, *p, (size_t) (end - *p));\0A            *p += end - *p;\0A        }\0A    } else\0A#endif /* MBEDTLS_PK_HAVE_ECC_KEYS */\0A    ret = MBEDTLS_ERR_PK_UNKNOWN_PK_ALG;\0A\0A    if (ret == 0 && *p != end) {\0A        ret = MBEDTLS_ERROR_ADD(MBEDTLS_ERR_PK_INVALID_PUBKEY,\0A                                MBEDTLS_ERR_ASN1_LENGTH_MISMATCH);\0A    }\0A\0A    if (ret != 0) {\0A        mbedtls_pk_free(pk);\0A    }\0A\0A    return ret;\0A}\0A\0A#if defined(MBEDTLS_PK_HAVE_ECC_KEYS)\0A/*\0A * Parse a SEC1 encoded private EC key\0A */\0Astatic int pk_parse_key_sec1_der(mbedtls_pk_context *pk,\0A                                 const unsigned char *key, size_t keylen,\0A                                 int (*f_rng)(void *, unsigned char *, size_t), void *p_rng)\0A{\0A    int ret = MBEDTLS_ERR_ERROR_CORRUPTION_DETECTED;\0A    int version, pubkey_done;\0A    size_t len, d_len;\0A    mbedtls_asn1_buf params = { 0, 0, NULL };\0A    unsigned char *p = (unsigned char *) key;\0A    unsigned char *d;\0A    unsigned char *end = p + keylen;\0A    unsigned char *end2;\0A\0A    /*\0A     * RFC 5915, or SEC1 Appendix C.4\0A     *\0A     * ECPrivateKey ::= SEQUENCE {\0A     *      version        INTEGER { ecPrivkeyVer1(1) } (ecPrivkeyVer1),\0A     *      privateKey     OCTET STRING,\0A     *      parameters [0] ECParameters {{ NamedCurve }} OPTIONAL,\0A     *      publicKey  [1] BIT STRING OPTIONAL\0A     *    }\0A     */\0A    if ((ret = mbedtls_asn1_get_tag(&p, end, &len,\0A                                    MBEDTLS_ASN1_CONSTRUCTED | MBEDTLS_ASN1_SEQUENCE)) != 0) {\0A        return MBEDTLS_ERROR_ADD(MBEDTLS_ERR_PK_KEY_INVALID_FORMAT, ret);\0A    }\0A\0A    end = p + len;\0A\0A    if ((ret = mbedtls_asn1_get_int(&p, end, &version)) != 0) {\0A        return MBEDTLS_ERROR_ADD(MBEDTLS_ERR_PK_KEY_INVALID_FORMAT, ret);\0A    }\0A\0A    if (version != 1) {\0A        return MBEDTLS_ERR_PK_KEY_INVALID_VERSION;\0A    }\0A\0A    if ((ret = mbedtls_asn1_get_tag(&p, end, &len, MBEDTLS_ASN1_OCTET_STRING)) != 0) {\0A        return MBEDTLS_ERROR_ADD(MBEDTLS_ERR_PK_KEY_INVALID_FORMAT, ret);\0A    }\0A\0A    /* Keep a reference to the position fo the private key. It will be used\0A     * later in this function. */\0A    d = p;\0A    d_len = len;\0A\0A    p += len;\0A\0A    pubkey_done = 0;\0A    if (p != end) {\0A        /*\0A         * Is 'parameters' present?\0A         */\0A        if ((ret = mbedtls_asn1_get_tag(&p, end, &len,\0A                                        MBEDTLS_ASN1_CONTEXT_SPECIFIC | MBEDTLS_ASN1_CONSTRUCTED |\0A                                        0)) == 0) {\0A            if ((ret = pk_get_ecparams(&p, p + len, &params)) != 0 ||\0A                (ret = pk_use_ecparams(&params, pk)) != 0) {\0A                return ret;\0A            }\0A        } else if (ret != MBEDTLS_ERR_ASN1_UNEXPECTED_TAG) {\0A            return MBEDTLS_ERROR_ADD(MBEDTLS_ERR_PK_KEY_INVALID_FORMAT, ret);\0A        }\0A    }\0A\0A    /*\0A     * Load the private key\0A     */\0A    ret = mbedtls_pk_ecc_set_key(pk, d, d_len);\0A    if (ret != 0) {\0A        return ret;\0A    }\0A\0A    if (p != end) {\0A        /*\0A         * Is 'publickey' present? If not, or if we can't read it (eg because it\0A         * is compressed), create it from the private key.\0A         */\0A        if ((ret = mbedtls_asn1_get_tag(&p, end, &len,\0A                                        MBEDTLS_ASN1_CONTEXT_SPECIFIC | MBEDTLS_ASN1_CONSTRUCTED |\0A                                        1)) == 0) {\0A            end2 = p + len;\0A\0A            if ((ret = mbedtls_asn1_get_bitstring_null(&p, end2, &len)) != 0) {\0A                return MBEDTLS_ERROR_ADD(MBEDTLS_ERR_PK_KEY_INVALID_FORMAT, ret);\0A            }\0A\0A            if (p + len != end2) {\0A                return MBEDTLS_ERROR_ADD(MBEDTLS_ERR_PK_KEY_INVALID_FORMAT,\0A                                         MBEDTLS_ERR_ASN1_LENGTH_MISMATCH);\0A            }\0A\0A            if ((ret = mbedtls_pk_ecc_set_pubkey(pk, p, (size_t) (end2 - p))) == 0) {\0A                pubkey_done = 1;\0A            } else {\0A                /*\0A                 * The only acceptable failure mode of mbedtls_pk_ecc_set_pubkey() above\0A                 * is if the point format is not recognized.\0A                 */\0A                if (ret != MBEDTLS_ERR_ECP_FEATURE_UNAVAILABLE) {\0A                    return MBEDTLS_ERR_PK_KEY_INVALID_FORMAT;\0A                }\0A            }\0A        } else if (ret != MBEDTLS_ERR_ASN1_UNEXPECTED_TAG) {\0A            return MBEDTLS_ERROR_ADD(MBEDTLS_ERR_PK_KEY_INVALID_FORMAT, ret);\0A        }\0A    }\0A\0A    if (!pubkey_done) {\0A        if ((ret = mbedtls_pk_ecc_set_pubkey_from_prv(pk, d, d_len, f_rng, p_rng)) != 0) {\0A            return ret;\0A        }\0A    }\0A\0A    return 0;\0A}\0A#endif /* MBEDTLS_PK_HAVE_ECC_KEYS */\0A\0A/***********************************************************************\0A *\0A *      PKCS#8 parsing functions\0A *\0A **********************************************************************/\0A\0A/*\0A * Parse an unencrypted PKCS#8 encoded private key\0A *\0A * Notes:\0A *\0A * - This function does not own the key buffer. It is the\0A *   responsibility of the caller to take care of zeroizing\0A *   and freeing it after use.\0A *\0A * - The function is responsible for freeing the provided\0A *   PK context on failure.\0A *\0A */\0Astatic int pk_parse_key_pkcs8_unencrypted_der(\0A    mbedtls_pk_context *pk,\0A    const unsigned char *key, size_t keylen,\0A    int (*f_rng)(void *, unsigned char *, size_t), void *p_rng)\0A{\0A    int ret, version;\0A    size_t len;\0A    mbedtls_asn1_buf params;\0A    unsigned char *p = (unsigned char *) key;\0A    unsigned char *end = p + keylen;\0A    mbedtls_pk_type_t pk_alg = MBEDTLS_PK_NONE;\0A    mbedtls_ecp_group_id ec_grp_id = MBEDTLS_ECP_DP_NONE;\0A    const mbedtls_pk_info_t *pk_info;\0A\0A#if !defined(MBEDTLS_PK_HAVE_ECC_KEYS)\0A    (void) f_rng;\0A    (void) p_rng;\0A#endif\0A\0A    /*\0A     * This function parses the PrivateKeyInfo object (PKCS#8 v1.2 = RFC 5208)\0A     *\0A     *    PrivateKeyInfo ::= SEQUENCE {\0A     *      version                   Version,\0A     *      privateKeyAlgorithm       PrivateKeyAlgorithmIdentifier,\0A     *      privateKey                PrivateKey,\0A     *      attributes           [0]  IMPLICIT Attributes OPTIONAL }\0A     *\0A     *    Version ::= INTEGER\0A     *    PrivateKeyAlgorithmIdentifier ::= AlgorithmIdentifier\0A     *    PrivateKey ::= OCTET STRING\0A     *\0A     *  The PrivateKey OCTET STRING is a SEC1 ECPrivateKey\0A     */\0A\0A    if ((ret = mbedtls_asn1_get_tag(&p, end, &len,\0A                                    MBEDTLS_ASN1_CONSTRUCTED | MBEDTLS_ASN1_SEQUENCE)) != 0) {\0A        return MBEDTLS_ERROR_ADD(MBEDTLS_ERR_PK_KEY_INVALID_FORMAT, ret);\0A    }\0A\0A    end = p + len;\0A\0A    if ((ret = mbedtls_asn1_get_int(&p, end, &version)) != 0) {\0A        return MBEDTLS_ERROR_ADD(MBEDTLS_ERR_PK_KEY_INVALID_FORMAT, ret);\0A    }\0A\0A    if (version != 0) {\0A        return MBEDTLS_ERROR_ADD(MBEDTLS_ERR_PK_KEY_INVALID_VERSION, ret);\0A    }\0A\0A    if ((ret = pk_get_pk_alg(&p, end, &pk_alg, &params, &ec_grp_id)) != 0) {\0A        return ret;\0A    }\0A\0A    if ((ret = mbedtls_asn1_get_tag(&p, end, &len, MBEDTLS_ASN1_OCTET_STRING)) != 0) {\0A        return MBEDTLS_ERROR_ADD(MBEDTLS_ERR_PK_KEY_INVALID_FORMAT, ret);\0A    }\0A\0A    if (len < 1) {\0A        return MBEDTLS_ERROR_ADD(MBEDTLS_ERR_PK_KEY_INVALID_FORMAT,\0A                                 MBEDTLS_ERR_ASN1_OUT_OF_DATA);\0A    }\0A\0A    if ((pk_info = mbedtls_pk_info_from_type(pk_alg)) == NULL) {\0A        return MBEDTLS_ERR_PK_UNKNOWN_PK_ALG;\0A    }\0A\0A    if ((ret = mbedtls_pk_setup(pk, pk_info)) != 0) {\0A        return ret;\0A    }\0A\0A#if defined(MBEDTLS_RSA_C)\0A    if (pk_alg == MBEDTLS_PK_RSA) {\0A        if ((ret = mbedtls_rsa_parse_key(mbedtls_pk_rsa(*pk), p, len)) != 0) {\0A            mbedtls_pk_free(pk);\0A            return ret;\0A        }\0A    } else\0A#endif /* MBEDTLS_RSA_C */\0A#if defined(MBEDTLS_PK_HAVE_ECC_KEYS)\0A    if (pk_alg == MBEDTLS_PK_ECKEY || pk_alg == MBEDTLS_PK_ECKEY_DH) {\0A#if defined(MBEDTLS_PK_HAVE_RFC8410_CURVES)\0A        if (MBEDTLS_PK_IS_RFC8410_GROUP_ID(ec_grp_id)) {\0A            if ((ret =\0A                     pk_use_ecparams_rfc8410(&params, ec_grp_id, pk)) != 0 ||\0A                (ret =\0A                     pk_parse_key_rfc8410_der(pk, p, len, end, f_rng,\0A                                              p_rng)) != 0) {\0A                mbedtls_pk_free(pk);\0A                return ret;\0A            }\0A        } else\0A#endif\0A        {\0A            if ((ret = pk_use_ecparams(&params, pk)) != 0 ||\0A                (ret = pk_parse_key_sec1_der(pk, p, len, f_rng, p_rng)) != 0) {\0A                mbedtls_pk_free(pk);\0A                return ret;\0A            }\0A        }\0A    } else\0A#endif /* MBEDTLS_PK_HAVE_ECC_KEYS */\0A    return MBEDTLS_ERR_PK_UNKNOWN_PK_ALG;\0A\0A    end = p + len;\0A    if (end != (key + keylen)) {\0A        return MBEDTLS_ERROR_ADD(MBEDTLS_ERR_PK_KEY_INVALID_FORMAT,\0A                                 MBEDTLS_ERR_ASN1_LENGTH_MISMATCH);\0A    }\0A\0A    return 0;\0A}\0A\0A/*\0A * Parse an encrypted PKCS#8 encoded private key\0A *\0A * To save space, the decryption happens in-place on the given key buffer.\0A * Also, while this function may modify the keybuffer, it doesn't own it,\0A * and instead it is the responsibility of the caller to zeroize and properly\0A * free it after use.\0A *\0A */\0A#if defined(MBEDTLS_PKCS12_C) || defined(MBEDTLS_PKCS5_C)\0AMBEDTLS_STATIC_TESTABLE int mbedtls_pk_parse_key_pkcs8_encrypted_der(\0A    mbedtls_pk_context *pk,\0A    unsigned char *key, size_t keylen,\0A    const unsigned char *pwd, size_t pwdlen,\0A    int (*f_rng)(void *, unsigned char *, size_t), void *p_rng)\0A{\0A    int ret, decrypted = 0;\0A    size_t len;\0A    unsigned char *buf;\0A    unsigned char *p, *end;\0A    mbedtls_asn1_buf pbe_alg_oid, pbe_params;\0A#if defined(MBEDTLS_PKCS12_C) && defined(MBEDTLS_CIPHER_PADDING_PKCS7) && defined(MBEDTLS_CIPHER_C)\0A    mbedtls_cipher_type_t cipher_alg;\0A    mbedtls_md_type_t md_alg;\0A#endif\0A    size_t outlen = 0;\0A\0A    p = key;\0A    end = p + keylen;\0A\0A    if (pwdlen == 0) {\0A        return MBEDTLS_ERR_PK_PASSWORD_REQUIRED;\0A    }\0A\0A    /*\0A     * This function parses the EncryptedPrivateKeyInfo object (PKCS#8)\0A     *\0A     *  EncryptedPrivateKeyInfo ::= SEQUENCE {\0A     *    encryptionAlgorithm  EncryptionAlgorithmIdentifier,\0A     *    encryptedData        EncryptedData\0A     *  }\0A     *\0A     *  EncryptionAlgorithmIdentifier ::= AlgorithmIdentifier\0A     *\0A     *  EncryptedData ::= OCTET STRING\0A     *\0A     *  The EncryptedData OCTET STRING is a PKCS#8 PrivateKeyInfo\0A     *\0A     */\0A    if ((ret = mbedtls_asn1_get_tag(&p, end, &len,\0A                                    MBEDTLS_ASN1_CONSTRUCTED | MBEDTLS_ASN1_SEQUENCE)) != 0) {\0A        return MBEDTLS_ERROR_ADD(MBEDTLS_ERR_PK_KEY_INVALID_FORMAT, ret);\0A    }\0A\0A    end = p + len;\0A\0A    if ((ret = mbedtls_asn1_get_alg(&p, end, &pbe_alg_oid, &pbe_params)) != 0) {\0A        return MBEDTLS_ERROR_ADD(MBEDTLS_ERR_PK_KEY_INVALID_FORMAT, ret);\0A    }\0A\0A    if ((ret = mbedtls_asn1_get_tag(&p, end, &len, MBEDTLS_ASN1_OCTET_STRING)) != 0) {\0A        return MBEDTLS_ERROR_ADD(MBEDTLS_ERR_PK_KEY_INVALID_FORMAT, ret);\0A    }\0A\0A    buf = p;\0A\0A    /*\0A     * Decrypt EncryptedData with appropriate PBE\0A     */\0A#if defined(MBEDTLS_PKCS12_C) && defined(MBEDTLS_CIPHER_PADDING_PKCS7) && defined(MBEDTLS_CIPHER_C)\0A    if (mbedtls_oid_get_pkcs12_pbe_alg(&pbe_alg_oid, &md_alg, &cipher_alg) == 0) {\0A        if ((ret = mbedtls_pkcs12_pbe_ext(&pbe_params, MBEDTLS_PKCS12_PBE_DECRYPT,\0A                                          cipher_alg, md_alg,\0A                                          pwd, pwdlen, p, len, buf, len, &outlen)) != 0) {\0A            if (ret == MBEDTLS_ERR_PKCS12_PASSWORD_MISMATCH) {\0A                return MBEDTLS_ERR_PK_PASSWORD_MISMATCH;\0A            }\0A\0A            return ret;\0A        }\0A\0A        decrypted = 1;\0A    } else\0A#endif /* MBEDTLS_PKCS12_C && MBEDTLS_CIPHER_PADDING_PKCS7 && MBEDTLS_CIPHER_C */\0A#if defined(MBEDTLS_PKCS5_C) && defined(MBEDTLS_CIPHER_PADDING_PKCS7) && defined(MBEDTLS_CIPHER_C)\0A    if (MBEDTLS_OID_CMP(MBEDTLS_OID_PKCS5_PBES2, &pbe_alg_oid) == 0) {\0A        if ((ret = mbedtls_pkcs5_pbes2_ext(&pbe_params, MBEDTLS_PKCS5_DECRYPT, pwd, pwdlen,\0A                                           p, len, buf, len, &outlen)) != 0) {\0A            if (ret == MBEDTLS_ERR_PKCS5_PASSWORD_MISMATCH) {\0A                return MBEDTLS_ERR_PK_PASSWORD_MISMATCH;\0A            }\0A\0A            return ret;\0A        }\0A\0A        decrypted = 1;\0A    } else\0A#endif /* MBEDTLS_PKCS5_C && MBEDTLS_CIPHER_PADDING_PKCS7 && MBEDTLS_CIPHER_C */\0A    {\0A        ((void) pwd);\0A    }\0A\0A    if (decrypted == 0) {\0A        return MBEDTLS_ERR_PK_FEATURE_UNAVAILABLE;\0A    }\0A    return pk_parse_key_pkcs8_unencrypted_der(pk, buf, outlen, f_rng, p_rng);\0A}\0A#endif /* MBEDTLS_PKCS12_C || MBEDTLS_PKCS5_C */\0A\0A/***********************************************************************\0A *\0A *      Top-level functions, with format auto-discovery\0A *\0A **********************************************************************/\0A\0A/*\0A * Parse a private key\0A */\0Aint mbedtls_pk_parse_key(mbedtls_pk_context *pk,\0A                         const unsigned char *key, size_t keylen,\0A                         const unsigned char *pwd, size_t pwdlen,\0A                         int (*f_rng)(void *, unsigned char *, size_t), void *p_rng)\0A{\0A    int ret = MBEDTLS_ERR_ERROR_CORRUPTION_DETECTED;\0A    const mbedtls_pk_info_t *pk_info;\0A#if defined(MBEDTLS_PEM_PARSE_C)\0A    size_t len;\0A    mbedtls_pem_context pem;\0A#endif\0A\0A    if (keylen == 0) {\0A        return MBEDTLS_ERR_PK_KEY_INVALID_FORMAT;\0A    }\0A\0A#if defined(MBEDTLS_PEM_PARSE_C)\0A    mbedtls_pem_init(&pem);\0A\0A#if defined(MBEDTLS_RSA_C)\0A    /* Avoid calling mbedtls_pem_read_buffer() on non-null-terminated string */\0A    if (key[keylen - 1] != '\5C0') {\0A        ret = MBEDTLS_ERR_PEM_NO_HEADER_FOOTER_PRESENT;\0A    } else {\0A        ret = mbedtls_pem_read_buffer(&pem,\0A                                      PEM_BEGIN_PRIVATE_KEY_RSA, PEM_END_PRIVATE_KEY_RSA,\0A                                      key, pwd, pwdlen, &len);\0A    }\0A\0A    if (ret == 0) {\0A        pk_info = mbedtls_pk_info_from_type(MBEDTLS_PK_RSA);\0A        if ((ret = mbedtls_pk_setup(pk, pk_info)) != 0 ||\0A            (ret = mbedtls_rsa_parse_key(mbedtls_pk_rsa(*pk),\0A                                         pem.buf, pem.buflen)) != 0) {\0A            mbedtls_pk_free(pk);\0A        }\0A\0A        mbedtls_pem_free(&pem);\0A        return ret;\0A    } else if (ret == MBEDTLS_ERR_PEM_PASSWORD_MISMATCH) {\0A        return MBEDTLS_ERR_PK_PASSWORD_MISMATCH;\0A    } else if (ret == MBEDTLS_ERR_PEM_PASSWORD_REQUIRED) {\0A        return MBEDTLS_ERR_PK_PASSWORD_REQUIRED;\0A    } else if (ret != MBEDTLS_ERR_PEM_NO_HEADER_FOOTER_PRESENT) {\0A        return ret;\0A    }\0A#endif /* MBEDTLS_RSA_C */\0A\0A#if defined(MBEDTLS_PK_HAVE_ECC_KEYS)\0A    /* Avoid calling mbedtls_pem_read_buffer() on non-null-terminated string */\0A    if (key[keylen - 1] != '\5C0') {\0A        ret = MBEDTLS_ERR_PEM_NO_HEADER_FOOTER_PRESENT;\0A    } else {\0A        ret = mbedtls_pem_read_buffer(&pem,\0A                                      PEM_BEGIN_PRIVATE_KEY_EC,\0A                                      PEM_END_PRIVATE_KEY_EC,\0A                                      key, pwd, pwdlen, &len);\0A    }\0A    if (ret == 0) {\0A        pk_info = mbedtls_pk_info_from_type(MBEDTLS_PK_ECKEY);\0A\0A        if ((ret = mbedtls_pk_setup(pk, pk_info)) != 0 ||\0A            (ret = pk_parse_key_sec1_der(pk,\0A                                         pem.buf, pem.buflen,\0A                                         f_rng, p_rng)) != 0) {\0A            mbedtls_pk_free(pk);\0A        }\0A\0A        mbedtls_pem_free(&pem);\0A        return ret;\0A    } else if (ret == MBEDTLS_ERR_PEM_PASSWORD_MISMATCH) {\0A        return MBEDTLS_ERR_PK_PASSWORD_MISMATCH;\0A    } else if (ret == MBEDTLS_ERR_PEM_PASSWORD_REQUIRED) {\0A        return MBEDTLS_ERR_PK_PASSWORD_REQUIRED;\0A    } else if (ret != MBEDTLS_ERR_PEM_NO_HEADER_FOOTER_PRESENT) {\0A        return ret;\0A    }\0A#endif /* MBEDTLS_PK_HAVE_ECC_KEYS */\0A\0A    /* Avoid calling mbedtls_pem_read_buffer() on non-null-terminated string */\0A    if (key[keylen - 1] != '\5C0') {\0A        ret = MBEDTLS_ERR_PEM_NO_HEADER_FOOTER_PRESENT;\0A    } else {\0A        ret = mbedtls_pem_read_buffer(&pem,\0A                                      PEM_BEGIN_PRIVATE_KEY_PKCS8, PEM_END_PRIVATE_KEY_PKCS8,\0A                                      key, NULL, 0, &len);\0A    }\0A    if (ret == 0) {\0A        if ((ret = pk_parse_key_pkcs8_unencrypted_der(pk,\0A                                                      pem.buf, pem.buflen, f_rng, p_rng)) != 0) {\0A            mbedtls_pk_free(pk);\0A        }\0A\0A        mbedtls_pem_free(&pem);\0A        return ret;\0A    } else if (ret != MBEDTLS_ERR_PEM_NO_HEADER_FOOTER_PRESENT) {\0A        return ret;\0A    }\0A\0A#if defined(MBEDTLS_PKCS12_C) || defined(MBEDTLS_PKCS5_C)\0A    /* Avoid calling mbedtls_pem_read_buffer() on non-null-terminated string */\0A    if (key[keylen - 1] != '\5C0') {\0A        ret = MBEDTLS_ERR_PEM_NO_HEADER_FOOTER_PRESENT;\0A    } else {\0A        ret = mbedtls_pem_read_buffer(&pem,\0A                                      PEM_BEGIN_ENCRYPTED_PRIVATE_KEY_PKCS8,\0A                                      PEM_END_ENCRYPTED_PRIVATE_KEY_PKCS8,\0A                                      key, NULL, 0, &len);\0A    }\0A    if (ret == 0) {\0A        if ((ret = mbedtls_pk_parse_key_pkcs8_encrypted_der(pk, pem.buf, pem.buflen,\0A                                                            pwd, pwdlen, f_rng, p_rng)) != 0) {\0A            mbedtls_pk_free(pk);\0A        }\0A\0A        mbedtls_pem_free(&pem);\0A        return ret;\0A    } else if (ret != MBEDTLS_ERR_PEM_NO_HEADER_FOOTER_PRESENT) {\0A        return ret;\0A    }\0A#endif /* MBEDTLS_PKCS12_C || MBEDTLS_PKCS5_C */\0A#else\0A    ((void) pwd);\0A    ((void) pwdlen);\0A#endif /* MBEDTLS_PEM_PARSE_C */\0A\0A    /*\0A     * At this point we only know it's not a PEM formatted key. Could be any\0A     * of the known DER encoded private key formats\0A     *\0A     * We try the different DER format parsers to see if one passes without\0A     * error\0A     */\0A#if defined(MBEDTLS_PKCS12_C) || defined(MBEDTLS_PKCS5_C)\0A    if (pwdlen != 0) {\0A        unsigned char *key_copy;\0A\0A        if ((key_copy = mbedtls_calloc(1, keylen)) == NULL) {\0A            return MBEDTLS_ERR_PK_ALLOC_FAILED;\0A        }\0A\0A        memcpy(key_copy, key, keylen);\0A\0A        ret = mbedtls_pk_parse_key_pkcs8_encrypted_der(pk, key_copy, keylen,\0A                                                       pwd, pwdlen, f_rng, p_rng);\0A\0A        mbedtls_zeroize_and_free(key_copy, keylen);\0A    }\0A\0A    if (ret == 0) {\0A        return 0;\0A    }\0A\0A    mbedtls_pk_free(pk);\0A    mbedtls_pk_init(pk);\0A\0A    if (ret == MBEDTLS_ERR_PK_PASSWORD_MISMATCH) {\0A        return ret;\0A    }\0A#endif /* MBEDTLS_PKCS12_C || MBEDTLS_PKCS5_C */\0A\0A    ret = pk_parse_key_pkcs8_unencrypted_der(pk, key, keylen, f_rng, p_rng);\0A    if (ret == 0) {\0A        return 0;\0A    }\0A\0A    mbedtls_pk_free(pk);\0A    mbedtls_pk_init(pk);\0A\0A#if defined(MBEDTLS_RSA_C)\0A\0A    pk_info = mbedtls_pk_info_from_type(MBEDTLS_PK_RSA);\0A    if (mbedtls_pk_setup(pk, pk_info) == 0 &&\0A        mbedtls_rsa_parse_key(mbedtls_pk_rsa(*pk), key, keylen) == 0) {\0A        return 0;\0A    }\0A\0A    mbedtls_pk_free(pk);\0A    mbedtls_pk_init(pk);\0A#endif /* MBEDTLS_RSA_C */\0A\0A#if defined(MBEDTLS_PK_HAVE_ECC_KEYS)\0A    pk_info = mbedtls_pk_info_from_type(MBEDTLS_PK_ECKEY);\0A    if (mbedtls_pk_setup(pk, pk_info) == 0 &&\0A        pk_parse_key_sec1_der(pk,\0A                              key, keylen, f_rng, p_rng) == 0) {\0A        return 0;\0A    }\0A    mbedtls_pk_free(pk);\0A#endif /* MBEDTLS_PK_HAVE_ECC_KEYS */\0A\0A    /* If MBEDTLS_RSA_C is defined but MBEDTLS_PK_HAVE_ECC_KEYS isn't,\0A     * it is ok to leave the PK context initialized but not\0A     * freed: It is the caller's responsibility to call pk_init()\0A     * before calling this function, and to call pk_free()\0A     * when it fails. If MBEDTLS_PK_HAVE_ECC_KEYS is defined but MBEDTLS_RSA_C\0A     * isn't, this leads to mbedtls_pk_free() being called\0A     * twice, once here and once by the caller, but this is\0A     * also ok and in line with the mbedtls_pk_free() calls\0A     * on failed PEM parsing attempts. */\0A\0A    return MBEDTLS_ERR_PK_KEY_INVALID_FORMAT;\0A}\0A\0A/*\0A * Parse a public key\0A */\0Aint mbedtls_pk_parse_public_key(mbedtls_pk_context *ctx,\0A                                const unsigned char *key, size_t keylen)\0A{\0A    int ret = MBEDTLS_ERR_ERROR_CORRUPTION_DETECTED;\0A    unsigned char *p;\0A#if defined(MBEDTLS_RSA_C)\0A    const mbedtls_pk_info_t *pk_info;\0A#endif\0A#if defined(MBEDTLS_PEM_PARSE_C)\0A    size_t len;\0A    mbedtls_pem_context pem;\0A#endif\0A\0A    if (keylen == 0) {\0A        return MBEDTLS_ERR_PK_KEY_INVALID_FORMAT;\0A    }\0A\0A#if defined(MBEDTLS_PEM_PARSE_C)\0A    mbedtls_pem_init(&pem);\0A#if defined(MBEDTLS_RSA_C)\0A    /* Avoid calling mbedtls_pem_read_buffer() on non-null-terminated string */\0A    if (key[keylen - 1] != '\5C0') {\0A        ret = MBEDTLS_ERR_PEM_NO_HEADER_FOOTER_PRESENT;\0A    } else {\0A        ret = mbedtls_pem_read_buffer(&pem,\0A                                      PEM_BEGIN_PUBLIC_KEY_RSA, PEM_END_PUBLIC_KEY_RSA,\0A                                      key, NULL, 0, &len);\0A    }\0A\0A    if (ret == 0) {\0A        p = pem.buf;\0A        if ((pk_info = mbedtls_pk_info_from_type(MBEDTLS_PK_RSA)) == NULL) {\0A            mbedtls_pem_free(&pem);\0A            return MBEDTLS_ERR_PK_UNKNOWN_PK_ALG;\0A        }\0A\0A        if ((ret = mbedtls_pk_setup(ctx, pk_info)) != 0) {\0A            mbedtls_pem_free(&pem);\0A            return ret;\0A        }\0A\0A        if ((ret = mbedtls_rsa_parse_pubkey(mbedtls_pk_rsa(*ctx), p, pem.buflen)) != 0) {\0A            mbedtls_pk_free(ctx);\0A        }\0A\0A        mbedtls_pem_free(&pem);\0A        return ret;\0A    } else if (ret != MBEDTLS_ERR_PEM_NO_HEADER_FOOTER_PRESENT) {\0A        mbedtls_pem_free(&pem);\0A        return ret;\0A    }\0A#endif /* MBEDTLS_RSA_C */\0A\0A    /* Avoid calling mbedtls_pem_read_buffer() on non-null-terminated string */\0A    if (key[keylen - 1] != '\5C0') {\0A        ret = MBEDTLS_ERR_PEM_NO_HEADER_FOOTER_PRESENT;\0A    } else {\0A        ret = mbedtls_pem_read_buffer(&pem,\0A                                      PEM_BEGIN_PUBLIC_KEY, PEM_END_PUBLIC_KEY,\0A                                      key, NULL, 0, &len);\0A    }\0A\0A    if (ret == 0) {\0A        /*\0A         * Was PEM encoded\0A         */\0A        p = pem.buf;\0A\0A        ret = mbedtls_pk_parse_subpubkey(&p, p + pem.buflen, ctx);\0A        mbedtls_pem_free(&pem);\0A        return ret;\0A    } else if (ret != MBEDTLS_ERR_PEM_NO_HEADER_FOOTER_PRESENT) {\0A        mbedtls_pem_free(&pem);\0A        return ret;\0A    }\0A    mbedtls_pem_free(&pem);\0A#endif /* MBEDTLS_PEM_PARSE_C */\0A\0A#if defined(MBEDTLS_RSA_C)\0A    if ((pk_info = mbedtls_pk_info_from_type(MBEDTLS_PK_RSA)) == NULL) {\0A        return MBEDTLS_ERR_PK_UNKNOWN_PK_ALG;\0A    }\0A\0A    if ((ret = mbedtls_pk_setup(ctx, pk_info)) != 0) {\0A        return ret;\0A    }\0A\0A    p = (unsigned char *) key;\0A    ret = mbedtls_rsa_parse_pubkey(mbedtls_pk_rsa(*ctx), p, keylen);\0A    if (ret == 0) {\0A        return ret;\0A    }\0A    mbedtls_pk_free(ctx);\0A    if (ret != MBEDTLS_ERR_ASN1_UNEXPECTED_TAG) {\0A        return ret;\0A    }\0A#endif /* MBEDTLS_RSA_C */\0A    p = (unsigned char *) key;\0A\0A    ret = mbedtls_pk_parse_subpubkey(&p, p + keylen, ctx);\0A\0A    return ret;\0A}\0A\0A/***********************************************************************\0A *\0A *      Top-level functions, with filesystem support\0A *\0A **********************************************************************/\0A\0A#if defined(MBEDTLS_FS_IO)\0A/*\0A * Load all data from a file into a given buffer.\0A *\0A * The file is expected to contain either PEM or DER encoded data.\0A * A terminating null byte is always appended. It is included in the announced\0A * length only if the data looks like it is PEM encoded.\0A */\0Aint mbedtls_pk_load_file(const char *path, unsigned char **buf, size_t *n)\0A{\0A    FILE *f;\0A    long size;\0A\0A    if ((f = fopen(path, \22rb\22)) == NULL) {\0A        return MBEDTLS_ERR_PK_FILE_IO_ERROR;\0A    }\0A\0A    /* Ensure no stdio buffering of secrets, as such buffers cannot be wiped. */\0A    mbedtls_setbuf(f, NULL);\0A\0A    fseek(f, 0, SEEK_END);\0A    if ((size = ftell(f)) == -1) {\0A        fclose(f);\0A        return MBEDTLS_ERR_PK_FILE_IO_ERROR;\0A    }\0A    fseek(f, 0, SEEK_SET);\0A\0A    *n = (size_t) size;\0A\0A    if (*n + 1 == 0 ||\0A        (*buf = mbedtls_calloc(1, *n + 1)) == NULL) {\0A        fclose(f);\0A        return MBEDTLS_ERR_PK_ALLOC_FAILED;\0A    }\0A\0A    if (fread(*buf, 1, *n, f) != *n) {\0A        fclose(f);\0A\0A        mbedtls_zeroize_and_free(*buf, *n);\0A\0A        return MBEDTLS_ERR_PK_FILE_IO_ERROR;\0A    }\0A\0A    fclose(f);\0A\0A    (*buf)[*n] = '\5C0';\0A\0A    if (strstr((const char *) *buf, \22-----BEGIN \22) != NULL) {\0A        ++*n;\0A    }\0A\0A    return 0;\0A}\0A\0A/*\0A * Load and parse a private key\0A */\0Aint mbedtls_pk_parse_keyfile(mbedtls_pk_context *ctx,\0A                             const char *path, const char *pwd,\0A                             int (*f_rng)(void *, unsigned char *, size_t), void *p_rng)\0A{\0A    int ret = MBEDTLS_ERR_ERROR_CORRUPTION_DETECTED;\0A    size_t n;\0A    unsigned char *buf;\0A\0A    if ((ret = mbedtls_pk_load_file(path, &buf, &n)) != 0) {\0A        return ret;\0A    }\0A\0A    if (pwd == NULL) {\0A        ret = mbedtls_pk_parse_key(ctx, buf, n, NULL, 0, f_rng, p_rng);\0A    } else {\0A        ret = mbedtls_pk_parse_key(ctx, buf, n,\0A                                   (const unsigned char *) pwd, strlen(pwd), f_rng, p_rng);\0A    }\0A\0A    mbedtls_zeroize_and_free(buf, n);\0A\0A    return ret;\0A}\0A\0A/*\0A * Load and parse a public key\0A */\0Aint mbedtls_pk_parse_public_keyfile(mbedtls_pk_context *ctx, const char *path)\0A{\0A    int ret = MBEDTLS_ERR_ERROR_CORRUPTION_DETECTED;\0A    size_t n;\0A    unsigned char *buf;\0A\0A    if ((ret = mbedtls_pk_load_file(path, &buf, &n)) != 0) {\0A        return ret;\0A    }\0A\0A    ret = mbedtls_pk_parse_public_key(ctx, buf, n);\0A\0A    mbedtls_zeroize_and_free(buf, n);\0A\0A    return ret;\0A}\0A#endif /* MBEDTLS_FS_IO */\0A\0A#endif /* MBEDTLS_PK_PARSE_C */\0A\00" }
