@.str44814 = private global { i64, i64, [3418 x i8] } { i64 -1, i64 3417, [3418 x i8] c"/**\0A * \5Cfile mbedtls/config_adjust_ssl.h\0A * \5Cbrief Adjust TLS configuration\0A *\0A * This is an internal header. Do not include it directly.\0A *\0A * Automatically enable certain dependencies. Generally, MBEDTLS_xxx\0A * configurations need to be explicitly enabled by the user: enabling\0A * MBEDTLS_xxx_A but not MBEDTLS_xxx_B when A requires B results in a\0A * compilation error. However, we do automatically enable certain options\0A * in some circumstances. One case is if MBEDTLS_xxx_B is an internal option\0A * used to identify parts of a module that are used by other module, and we\0A * don't want to make the symbol MBEDTLS_xxx_B part of the public API.\0A * Another case is if A didn't depend on B in earlier versions, and we\0A * want to use B in A but we need to preserve backward compatibility with\0A * configurations that explicitly activate MBEDTLS_xxx_A but not\0A * MBEDTLS_xxx_B.\0A */\0A/*\0A *  Copyright The Mbed TLS Contributors\0A *  SPDX-License-Identifier: Apache-2.0 OR GPL-2.0-or-later\0A */\0A\0A#ifndef MBEDTLS_CONFIG_ADJUST_SSL_H\0A#define MBEDTLS_CONFIG_ADJUST_SSL_H\0A\0A#if !defined(MBEDTLS_CONFIG_FILES_READ)\0A#error \22Do not include mbedtls/config_adjust_*.h manually! This can lead to problems, \22 \5C\0A    \22up to and including runtime errors such as buffer overflows. \22 \5C\0A    \22If you're trying to fix a complaint from check_config.h, just remove \22 \5C\0A    \22it from your configuration file: since Mbed TLS 3.0, it is included \22 \5C\0A    \22automatically at the right point.\22\0A#endif /* */\0A\0A/* The following blocks make it easier to disable all of TLS,\0A * or of TLS 1.2 or 1.3 or DTLS, without having to manually disable all\0A * key exchanges, options and extensions related to them. */\0A\0A#if !defined(MBEDTLS_SSL_TLS_C)\0A#undef MBEDTLS_SSL_CLI_C\0A#undef MBEDTLS_SSL_SRV_C\0A#undef MBEDTLS_SSL_PROTO_TLS1_3\0A#undef MBEDTLS_SSL_PROTO_TLS1_2\0A#undef MBEDTLS_SSL_PROTO_DTLS\0A#endif\0A\0A#if !(defined(MBEDTLS_SSL_SRV_C) && defined(MBEDTLS_SSL_SESSION_TICKETS))\0A#undef MBEDTLS_SSL_TICKET_C\0A#endif\0A\0A#if !defined(MBEDTLS_SSL_PROTO_DTLS)\0A#undef MBEDTLS_SSL_DTLS_ANTI_REPLAY\0A#undef MBEDTLS_SSL_DTLS_CONNECTION_ID\0A#undef MBEDTLS_SSL_DTLS_CONNECTION_ID_COMPAT\0A#undef MBEDTLS_SSL_DTLS_HELLO_VERIFY\0A#undef MBEDTLS_SSL_DTLS_SRTP\0A#undef MBEDTLS_SSL_DTLS_CLIENT_PORT_REUSE\0A#endif\0A\0A#if !defined(MBEDTLS_SSL_PROTO_TLS1_2)\0A#undef MBEDTLS_SSL_ENCRYPT_THEN_MAC\0A#undef MBEDTLS_SSL_EXTENDED_MASTER_SECRET\0A#undef MBEDTLS_SSL_RENEGOTIATION\0A#undef MBEDTLS_KEY_EXCHANGE_RSA_ENABLED\0A#undef MBEDTLS_KEY_EXCHANGE_DHE_RSA_ENABLED\0A#undef MBEDTLS_KEY_EXCHANGE_ECDHE_RSA_ENABLED\0A#undef MBEDTLS_KEY_EXCHANGE_ECDHE_ECDSA_ENABLED\0A#undef MBEDTLS_KEY_EXCHANGE_PSK_ENABLED\0A#undef MBEDTLS_KEY_EXCHANGE_DHE_PSK_ENABLED\0A#undef MBEDTLS_KEY_EXCHANGE_RSA_PSK_ENABLED\0A#undef MBEDTLS_KEY_EXCHANGE_ECDHE_PSK_ENABLED\0A#undef MBEDTLS_KEY_EXCHANGE_ECDH_RSA_ENABLED\0A#undef MBEDTLS_KEY_EXCHANGE_ECDH_ECDSA_ENABLED\0A#undef MBEDTLS_KEY_EXCHANGE_ECJPAKE_ENABLED\0A#endif\0A\0A#if !defined(MBEDTLS_SSL_PROTO_TLS1_3)\0A#undef MBEDTLS_SSL_TLS1_3_KEY_EXCHANGE_MODE_PSK_ENABLED\0A#undef MBEDTLS_SSL_TLS1_3_KEY_EXCHANGE_MODE_EPHEMERAL_ENABLED\0A#undef MBEDTLS_SSL_TLS1_3_KEY_EXCHANGE_MODE_PSK_EPHEMERAL_ENABLED\0A#undef MBEDTLS_SSL_EARLY_DATA\0A#undef MBEDTLS_SSL_RECORD_SIZE_LIMIT\0A#endif\0A\0A#if defined(MBEDTLS_SSL_PROTO_TLS1_2) && \5C\0A    (defined(MBEDTLS_ECDH_C) || defined(MBEDTLS_ECDSA_C) || \5C\0A    defined(MBEDTLS_KEY_EXCHANGE_ECJPAKE_ENABLED))\0A#define MBEDTLS_SSL_TLS1_2_SOME_ECC\0A#endif\0A\0A#endif /* MBEDTLS_CONFIG_ADJUST_SSL_H */\0A\00" }
