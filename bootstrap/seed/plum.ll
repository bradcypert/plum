@.str41666 = private global { i64, i64, [131325 x i8] } { i64 -1, i64 131324, [131325 x i8] c"/*\0A *  TLS client-side functions\0A *\0A *  Copyright The Mbed TLS Contributors\0A *  SPDX-License-Identifier: Apache-2.0 OR GPL-2.0-or-later\0A */\0A\0A#include \22common.h\22\0A\0A#if defined(MBEDTLS_SSL_CLI_C) && defined(MBEDTLS_SSL_PROTO_TLS1_2)\0A\0A#include \22mbedtls/platform.h\22\0A\0A#include \22mbedtls/ssl.h\22\0A#include \22ssl_client.h\22\0A#include \22ssl_misc.h\22\0A#include \22debug_internal.h\22\0A#include \22mbedtls/error.h\22\0A#include \22mbedtls/constant_time.h\22\0A\0A#if defined(MBEDTLS_USE_PSA_CRYPTO)\0A#include \22psa_util_internal.h\22\0A#include \22psa/crypto.h\22\0A#if defined(MBEDTLS_KEY_EXCHANGE_ECDHE_PSK_ENABLED)\0A/* Define a local translating function to save code size by not using too many\0A * arguments in each translating place. */\0Astatic int local_err_translation(psa_status_t status)\0A{\0A    return psa_status_to_mbedtls(status, psa_to_ssl_errors,\0A                                 ARRAY_LENGTH(psa_to_ssl_errors),\0A                                 psa_generic_status_to_mbedtls);\0A}\0A#define PSA_TO_MBEDTLS_ERR(status) local_err_translation(status)\0A#endif /* MBEDTLS_KEY_EXCHANGE_ECDHE_PSK_ENABLED */\0A#endif /* MBEDTLS_USE_PSA_CRYPTO */\0A\0A#include <string.h>\0A\0A#include <stdint.h>\0A\0A#if defined(MBEDTLS_HAVE_TIME)\0A#include \22mbedtls/platform_time.h\22\0A#endif\0A\0A#if defined(MBEDTLS_SSL_SESSION_TICKETS)\0A#include \22mbedtls/platform_util.h\22\0A#endif\0A\0A#if defined(MBEDTLS_SSL_RENEGOTIATION)\0AMBEDTLS_CHECK_RETURN_CRITICAL\0Astatic int ssl_write_renegotiation_ext(mbedtls_ssl_context *ssl,\0A                                       unsigned char *buf,\0A                                       const unsigned char *end,\0A                                       size_t *olen)\0A{\0A    unsigned char *p = buf;\0A\0A    *olen = 0;\0A\0A    /* We're always including a TLS_EMPTY_RENEGOTIATION_INFO_SCSV in the\0A     * initial 