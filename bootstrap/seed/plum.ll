   }\0A\0A        if (hostname_mismatch) {\0A            MBEDTLS_SSL_DEBUG_MSG(\0A                1, (\22Hostname mismatch the session ticket, \22\0A                    \22disable session resumption.\22));\0A            return MBEDTLS_ERR_SSL_BAD_INPUT_DATA;\0A        }\0A    } else {\0A        return mbedtls_ssl_session_set_hostname(session_negotiate,\0A                                                context_hostname);\0A    }\0A#endif /* MBEDTLS_SSL_PROTO_TLS1_3 &&\0A          MBEDTLS_SSL_SESSION_TICKETS &&\0A          MBEDTLS_SSL_SERVER_NAME_INDICATION */\0A\0A    return 0;\0A}\0A/*\0A * Write ClientHello handshake message.\0A * Handler for MBEDTLS_SSL_CLIENT_HELLO\0A */\0Aint mbedtls_ssl_write_client_hello(mbedtls_ssl_context *ssl)\0A{\0A    int ret = 0;\0A    unsigned char *buf;\0A    size_t buf_len, msg_len, binders_len;\0A\0A    MBEDTLS_SSL_DEBUG_MSG(2, (\22=> write client hello\22));\0A\0A    MBEDTLS_SSL_PROC_CHK(ssl_prepare_client_hello(ssl));\0A\0A    MBEDTLS_SSL_PROC_CHK(mbedtls_ssl_start_handshake_msg(\0A                             ssl, MBEDTLS_SSL_HS_CLIENT_HELLO,\0A                             &buf, &buf_len));\0A\0A    MBEDTLS_SSL_PROC_CHK(ssl_write_client_hello_body(ssl, buf,\0A                                                     buf + buf_len,\0A                                                     &msg_len,\0A                                                     &binders_len));\0A\0A#if defined(MBEDTLS_SSL_PROTO_TLS1_2) && defined(MBEDTLS_SSL_PROTO_DTLS)\0A    if (ssl->conf->transport == MBEDTLS_SSL_TRANSPORT_DATAGRAM) {\0A        ssl->out_msglen = msg_len + 4;\0A        mbedtls_ssl_send_flight_completed(ssl);\0A\0A        /*\0A         * The two functions below may try to send data on the network and\0A         * can return with the MBEDTLS_ERR_SSL_WANT_READ error code when they\0A         * fail to do so and the transmission has to be retried later. In that\0A         * case as in fatal error cases, we return immediately. But we must have\0A         * set the handshake state to the next state at that point to ensure\0A         * that we will not write and send again a ClientHello when we\0A         * eventually succeed in sending the pending data.\0A         */\0A        mbedtls_ssl_handshake_set_state(ssl, MBEDTLS_SSL_SERVER_HELLO);\0A\0A        if ((ret = mbedtls_ssl_write_handshake_msg(ssl)) != 0) {\0A            MBEDTLS_SSL_DEBUG_RET(1, \22mbedtls_ssl_write_handshake_msg\22, ret);\0A            return ret;\0A        }\0A\0A        if ((ret = mbedtls_ssl_flight_transmit(ssl)) != 0) {\0A            MBEDTLS_SSL_DEBUG_RET(1, \22mbedtls_ssl_flight_transmit\22, ret);\0A            return ret;\0A        }\0A    } else\0A#endif /* MBEDTLS_SSL_PROTO_TLS1_2 && MBEDTLS_SSL_PROTO_DTLS */\0A    {\0A\0A        ret = mbedtls_ssl_add_hs_hdr_to_checksum(ssl,\0A                                                 MBEDTLS_SSL_HS_CLIENT_HELLO,\0A                                                 msg_len);\0A        if (ret != 0) {\0A            MBEDTLS_SSL_DEBUG_RET(1, \22mbedtls_ssl_add_hs_hdr_to_checksum\22, ret);\0A            return ret;\0A        }\0A        ret = ssl->handshake->update_checksum(ssl, buf, msg_len - binders_len);\0A        if (ret != 0) {\0A            MBEDTLS_SSL_DEBUG_RET(1, \22update_checksum\22, ret);\0A            return ret;\0A        }\0A#if defined(MBEDTLS_SSL_TLS1_3_KEY_EXCHANGE_MODE_SOME_PSK_ENABLED)\0A        if (binders_len > 0) {\0A            MBEDTLS_SSL_PROC_CHK(\0A                mbedtls_ssl_tls13_write_binders_of_pre_shared_key_ext(\0A                    ssl, buf + msg_len - binders_len, buf + msg_len));\0A            ret = ssl->handshake->update_checksum(ssl, buf + msg_len - binders_len,\0A                                                  binders_len);\0A            if (ret != 0) {\0A                MBEDTLS_SSL_DEBUG_RET(1, \22update_checksum\22, ret);\0A                return ret;\0A            }\0A        }\0A#endif /* MBEDTLS_SSL_TLS1_3_KEY_EXCHANGE_MODE_SOME_PSK_ENABLED */\0A\0A        MBEDTLS_SSL_PROC_CHK(mbedtls_ssl_finish_handshake_msg(ssl,\0A                                                              buf_len,\0A                                                              msg_len));\0A\0A        /*\0A         * Set next state. Note that if TLS 1.3 is proposed, this may be\0A         * overwritten by mbedtls_ssl_tls13_finalize_client_hello().\0A         */\0A        mbedtls_ssl_handshake_set_state(ssl, MBEDTLS_SSL_SERVER_HELLO);\0A\0A#if defined(MBEDTLS_SSL_PROTO_TLS1_3)\0A        if (ssl->handshake->min_tls_version <=  MBEDTLS_SSL_VERSION_TLS1_3 &&\0A            MBEDTLS_SSL_VERSION_TLS1_3 <= ssl->tls_version) {\0A            ret = mbedtls_ssl_tls13_finalize_client_hello(ssl);\0A        }\0A#endif\0A    }\0A\0A#if defined(MBEDTLS_SSL_PROTO_TLS1_3)\0A    MBEDTLS_SSL_PRINT_EXTS(\0A        3, MBEDTLS_SSL_HS_CLIENT_HELLO, ssl->handshake->sent_extensions);\0A#endif\0A\0Acleanup:\0A\0A    MBEDTLS_SSL_DEBUG_MSG(2, (\22<= write client hello\22));\0A    return ret;\0A}\0A\0A#endif /* MBEDTLS_SSL_PROTO_TLS1_3 || MBEDTLS_SSL_PROTO_TLS1_2 */\0A#endif /* MBEDTLS_SSL_CLI_C */\0A\00" }
