@.str39927 = private global { i64, i64, [8711 x i8] } { i64 -1, i64 8710, [8711 x i8] c"/**\0A * \5Cfile pkcs12.h\0A *\0A * \5Cbrief PKCS#12 Personal Information Exchange Syntax\0A */\0A/*\0A *  Copyright The Mbed TLS Contributors\0A *  SPDX-License-Identifier: Apache-2.0 OR GPL-2.0-or-later\0A */\0A#ifndef MBEDTLS_PKCS12_H\0A#define MBEDTLS_PKCS12_H\0A\0A#include \22mbedtls/build_info.h\22\0A\0A#include \22mbedtls/md.h\22\0A#include \22mbedtls/cipher.h\22\0A#include \22mbedtls/asn1.h\22\0A\0A#include <stddef.h>\0A\0A/** Bad input parameters to function. */\0A#define MBEDTLS_ERR_PKCS12_BAD_INPUT_DATA                 -0x1F80\0A/** Feature not available, e.g. unsupported encryption scheme. */\0A#define MBEDTLS_ERR_PKCS12_FEATURE_UNAVAILABLE            -0x1F00\0A/** PBE ASN.1 data not as expected. */\0A#define MBEDTLS_ERR_PKCS12_PBE_INVALID_FORMAT             -0x1E80\0A/** Given private key password does not allow for correct decryption. */\0A#define MBEDTLS_ERR_PKCS12_PASSWORD_MISMATCH              -0x1E00\0A\0A#define MBEDTLS_PKCS12_DERIVE_KEY       1   /**< encryption/decryption key */\0A#define MBEDTLS_PKCS12_DERIVE_IV        2   /**< initialization vector     */\0A#define MBEDTLS_PKCS12_DERIVE_MAC_KEY   3   /**< integrity / MAC key       */\0A\0A#define MBEDTLS_PKCS12_PBE_DECRYPT      MBEDTLS_DECRYPT\0A#define MBEDTLS_PKCS12_PBE_ENCRYPT      MBEDTLS_ENCRYPT\0A\0A#ifdef __cplusplus\0Aextern \22C\22 {\0A#endif\0A\0A#if defined(MBEDTLS_ASN1_PARSE_C) && defined(MBEDTLS_CIPHER_C)\0A\0A#if !defined(MBEDTLS_DEPRECATED_REMOVED)\0A/**\0A * \5Cbrief            PKCS12 Password Based function (encryption / decryption)\0A *                   for cipher-based and mbedtls_md-based PBE's\0A *\0A * \5Cnote             When encrypting, #MBEDTLS_CIPHER_PADDING_PKCS7 must\0A *                   be enabled at compile time.\0A *\0A * \5Cdeprecated       This function is deprecated and will be removed in a\0A *                   future version of the library.\0A *                   Please use mbedtls_pkcs12_pbe_ext() instead.\0A *\0A * \5Cwarning          When decrypting:\0A *                   - if #MBEDTLS_CIPHER_PADDING_PKCS7 is enabled at compile\0A *                     time, this function validates the CBC padding and returns\0A *                     #MBEDTLS_ERR_PKCS12_PASSWORD_MISMATCH if the padding is\0A *                     invalid. Note that this can help active adversaries\0A *                     attempting to brute-forcing the password. Note also that\0A *                     there is no guarantee that an invalid password will be\0A *                     detected (the chances of a valid padding with a random\0A *                     password are about 1/255).\0A *                   - if #MBEDTLS_CIPHER_PADDING_PKCS7 is disabled at compile\0A *                     time, this function does not validate the CBC padding.\0A *\0A * \5Cparam pbe_params an ASN1 buffer containing the pkcs-12 PbeParams structure\0A * \5Cparam mode       either #MBEDTLS_PKCS12_PBE_ENCRYPT or\0A *                   #MBEDTLS_PKCS12_PBE_DECRYPT\0A * \5Cparam cipher_type the cipher used\0A * \5Cparam md_type    the mbedtls_md used\0A * \5Cparam pwd        Latin1-encoded password used. This may only be \5Cc NULL when\0A *                   \5Cp pwdlen is 0. No null terminator should be used.\0A * \5Cparam pwdlen     length of the password (may be 0)\0A * \5Cparam data       the input data\0A * \5Cparam len        data length\0A * \5Cparam output     Output buffer.\0A *                   On success, it contains the encrypted or decrypted data,\0A *                   possibly followed by the CBC padding.\0A *                   On failure, the content is indeterminate.\0A *                   For decryption, there must be enough room for \5Cp len\0A *                   bytes.\0A *                   For encryption, there must be enough room for\0A *                   \5Cp len + 1 bytes, rounded up to the block size of\0A *                   the block cipher identified by \5Cp pbe_params.\0A *\0A * \5Creturn           0 if successful, or a MBEDTLS_ERR_XXX code\0A */\0Aint MBEDTLS_DEPRECATED mbedtls_pkcs12_pbe(mbedtls_asn1_buf *pbe_params, int mode,\0A                                          mbedtls_cipher_type_t cipher_type,\0A                                          mbedtls_md_type_t md_type,\0A                                          const unsigned char *pwd,  size_t pwdlen,\0A                                          const unsigned char *data, size_t len,\0A                                          unsigned char *output);\0A#endif /* MBEDTLS_DEPRECATED_REMOVED */\0A\0A#if defined(MBEDTLS_CIPHER_PADDING_PKCS7)\0A\0A/**\0A * \5Cbrief            PKCS12 Password Based function (encryption / decryption)\0A *                   for cipher-based and mbedtls_md-based PBE's\0A *\0A *\0A * \5Cwarning          When decrypting:\0A *                   - This function validates the CBC padding and returns\0A *                     #MBEDTLS_ERR_PKCS12_PASSWORD_MISMATCH if the padding is\0A *                     invalid. Note that this can help active adversaries\0A *                     attempting to brute-forcing the password. Note also that\0A *                     there is no guarantee that an invalid password will be\0A *                     detected (the chances of a valid padding with a random\0A *                     password are about 1/255).\0A *\0A * \5Cparam pbe_params an ASN1 buffer containing the pkcs-12 PbeParams structure\0A * \5Cparam mode       either #MBEDTLS_PKCS12_PBE_ENCRYPT or\0A *                   #MBEDTLS_PKCS12_PBE_DECRYPT\0A * \5Cparam cipher_type the cipher used\0A * \5Cparam md_type    the mbedtls_md used\0A * \5Cparam pwd        Latin1-encoded password used. This may only be \5Cc NULL when\0A *                   \5Cp pwdlen is 0. No null terminator should be used.\0A * \5Cparam pwdlen     length of the password (may be 0)\0A * \5Cparam data       the input data\0A * \5Cparam len        data length\0A * \5Cparam output     Output buffer.\0A *                   On success, it contains the encrypted or decrypted data,\0A *                   possibly followed by the CBC padding.\0A *                   On failure, the content is indeterminate.\0A *                   For decryption, there must be enough room for \5Cp len\0A *                   bytes.\0A *                   For encryption, there must be enough room for\0A *                   \5Cp len + 1 bytes, rounded up to the block size of\0A *                   the block cipher identified by \5Cp pbe_params.\0A * \5Cparam output_size size of output buffer.\0A *                    This must be big enough to accommodate for output plus\0A *                    padding data.\0A * \5Cparam output_len On success, length of actual data written to the output buffer.\0A *\0A * \5Creturn           0 if successful, or a MBEDTLS_ERR_XXX code\0A */\0Aint mbedtls_pkcs12_pbe_ext(mbedtls_asn1_buf *pbe_params, int mode,\0A                           mbedtls_cipher_type_t cipher_type, mbedtls_md_type_t md_type,\0A                           const unsigned char *pwd,  size_t pwdlen,\0A                           const unsigned char *data, size_t len,\0A                           unsigned char *output, size_t output_size,\0A                           size_t *output_len);\0A\0A#endif /* MBEDTLS_CIPHER_PADDING_PKCS7 */\0A\0A#endif /* MBEDTLS_ASN1_PARSE_C && MBEDTLS_CIPHER_C */\0A\0A/**\0A * \5Cbrief            The PKCS#12 derivation function uses a password and a salt\0A *                   to produce pseudo-random bits for a particular \22purpose\22.\0A *\0A *                   Depending on the given id, this function can produce an\0A *                   encryption/decryption key, an initialization vector or an\0A *                   integrity key.\0A *\0A * \5Cparam data       buffer to store the derived data in\0A * \5Cparam datalen    length of buffer to fill\0A * \5Cparam pwd        The password to use. For compliance with PKCS#12 §B.1, this\0A *                   should be a BMPString, i.e. a Unicode string where each\0A *                   character is encoded as 2 bytes in big-endian order, with\0A *                   no byte order mark and with a null terminator (i.e. the\0A *                   last two bytes should be 0x00 0x00).\0A * \5Cparam pwdlen     length of the password (may be 0).\0A * \5Cparam salt       Salt buffer to use. This may only be \5Cc NULL when\0A *                   \5Cp saltlen is 0.\0A * \5Cparam saltlen    length of the salt (may be zero)\0A * \5Cparam mbedtls_md mbedtls_md type to use during the derivation\0A * \5Cparam id         id that describes the purpose (can be\0A *                   #MBEDTLS_PKCS12_DERIVE_KEY, #MBEDTLS_PKCS12_DERIVE_IV or\0A *                   #MBEDTLS_PKCS12_DERIVE_MAC_KEY)\0A * \5Cparam iterations number of iterations\0A *\0A * \5Creturn          0 if successful, or a MD, BIGNUM type error.\0A */\0Aint mbedtls_pkcs12_derivation(unsigned char *data, size_t datalen,\0A                              const unsigned char *pwd, size_t pwdlen,\0A                              const unsigned char *salt, size_t saltlen,\0A                              mbedtls_md_type_t mbedtls_md, int id, int iterations);\0A\0A#ifdef __cplusplus\0A}\0A#endif\0A\0A#endif /* pkcs12.h */\0A\00" }
