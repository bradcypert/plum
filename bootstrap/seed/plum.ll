= MBEDTLS_ERR_ECP_VERIFY_FAILED;\0A        goto cleanup;\0A    }\0A\0Acleanup:\0A    mbedtls_ecp_point_free(&R);\0A    mbedtls_mpi_free(&e); mbedtls_mpi_free(&s_inv);\0A    mbedtls_mpi_free(&u1); mbedtls_mpi_free(&u2);\0A\0A    ECDSA_RS_LEAVE(ver);\0A\0A    return ret;\0A}\0A\0A/*\0A * Verify ECDSA signature of hashed message\0A */\0Aint mbedtls_ecdsa_verify(mbedtls_ecp_group *grp,\0A                         const unsigned char *buf, size_t blen,\0A                         const mbedtls_ecp_point *Q,\0A                         const mbedtls_mpi *r,\0A                         const mbedtls_mpi *s)\0A{\0A    return mbedtls_ecdsa_verify_restartable(grp, buf, blen, Q, r, s, NULL);\0A}\0A#endif /* !MBEDTLS_ECDSA_VERIFY_ALT */\0A\0A/*\0A * Convert a signature (given by context) to ASN.1\0A */\0Astatic int ecdsa_signature_to_asn1(const mbedtls_mpi *r, const mbedtls_mpi *s,\0A                                   unsigned char *sig, size_t sig_size,\0A                                   size_t *slen)\0A{\0A    int ret = MBEDTLS_ERR_ERROR_CORRUPTION_DETECTED;\0A    unsigned char buf[MBEDTLS_ECDSA_MAX_LEN] = { 0 };\0A    unsigned char *p = buf + sizeof(buf);\0A    size_t len = 0;\0A\0A    MBEDTLS_ASN1_CHK_ADD(len, mbedtls_asn1_write_mpi(&p, buf, s));\0A    MBEDTLS_ASN1_CHK_ADD(len, mbedtls_asn1_write_mpi(&p, buf, r));\0A\0A    MBEDTLS_ASN1_CHK_ADD(len, mbedtls_asn1_write_len(&p, buf, len));\0A    MBEDTLS_ASN1_CHK_ADD(len, mbedtls_asn1_write_tag(&p, buf,\0A                                                     MBEDTLS_ASN1_CONSTRUCTED |\0A                                                     MBEDTLS_ASN1_SEQUENCE));\0A\0A    if (len > sig_size) {\0A        return MBEDTLS_ERR_ECP_BUFFER_TOO_SMALL;\0A    }\0A\0A    memcpy(sig, p, len);\0A    *slen = len;\0A\0A    return 0;\0A}\0A\0A/*\0A * Compute and write signature\0A */\0Aint mbedtls_ecdsa_write_signature_restartable(mbedtls_ecdsa_context *ctx,\0A                                              mbedtls_md_type_t md_alg,\0A                                              const unsigned char *hash, size_t hlen,\0A                                              unsigned char *sig, size_t sig_size, size_t *slen,\0A                                              int (*f_rng)(void *, unsigned char *, size_t),\0A                                              void *p_rng,\0A                                              mbedtls_ecdsa_restart_ctx *rs_ctx)\0A{\0A    int ret = MBEDTLS_ERR_ERROR_CORRUPTION_DETECTED;\0A    mbedtls_mpi r, s;\0A    if (f_rng == NULL) {\0A        return MBEDTLS_ERR_ECP_BAD_INPUT_DATA;\0A    }\0A\0A    mbedtls_mpi_init(&r);\0A    mbedtls_mpi_init(&s);\0A\0A#if defined(MBEDTLS_ECDSA_DETERMINISTIC)\0A    MBEDTLS_MPI_CHK(mbedtls_ecdsa_sign_det_restartable(&ctx->grp, &r, &s, &ctx->d,\0A                                                       hash, hlen, md_alg, f_rng,\0A                                                       p_rng, rs_ctx));\0A#else\0A    (void) md_alg;\0A\0A#if defined(MBEDTLS_ECDSA_SIGN_ALT)\0A    (void) rs_ctx;\0A\0A    MBEDTLS_MPI_CHK(mbedtls_ecdsa_sign(&ctx->grp, &r, &s, &ctx->d,\0A                                       hash, hlen, f_rng, p_rng));\0A#else\0A    /* Use the same RNG for both blinding and ephemeral key generation */\0A    MBEDTLS_MPI_CHK(mbedtls_ecdsa_sign_restartable(&ctx->grp, &r, &s, &ctx->d,\0A                                                   hash, hlen, f_rng, p_rng, f_rng,\0A                                                   p_rng, rs_ctx));\0A#endif /* MBEDTLS_ECDSA_SIGN_ALT */\0A#endif /* MBEDTLS_ECDSA_DETERMINISTIC */\0A\0A    MBEDTLS_MPI_CHK(ecdsa_signature_to_asn1(&r, &s, sig, sig_size, slen));\0A\0Acleanup:\0A    mbedtls_mpi_free(&r);\0A    mbedtls_mpi_free(&s);\0A\0A    return ret;\0A}\0A\0A/*\0A * Compute and write signature\0A */\0Aint mbedtls_ecdsa_write_signature(mbedtls_ecdsa_context *ctx,\0A                                  mbedtls_md_type_t md_alg,\0A                                  const unsigned char *hash, size_t hlen,\0A                                  unsigned char *sig, size_t sig_size, size_t *slen,\0A                                  int (*f_rng)(void *, unsigned char *, size_t),\0A                                  void *p_rng)\0A{\0A    return mbedtls_ecdsa_write_signature_restartable(\0A        ctx, md_alg, hash, hlen, sig, sig_size, slen,\0A        f_rng, p_rng, NULL);\0A}\0A\0A/*\0A * Read and check signature\0A */\0Aint mbedtls_ecdsa_read_signature(mbedtls_ecdsa_context *ctx,\0A                                 const unsigned char *hash, size_t hlen,\0A                                 const unsigned char *sig, size_t slen)\0A{\0A    return mbedtls_ecdsa_read_signature_restartable(\0A        ctx, hash, hlen, sig, slen, NULL);\0A}\0A\0A/*\0A * Restartable read and check signature\0A */\0Aint mbedtls_ecdsa_read_signature_restartable(mbedtls_ecdsa_context *ctx,\0A                                             const unsigned char *hash, size_t hlen,\0A                                             const unsigned char *sig, size_t slen,\0A                                             mbedtls_ecdsa_restart_ctx *rs_ctx)\0A{\0A    int ret = MBEDTLS_ERR_ERROR_CORRUPTION_DETECTED;\0A    unsigned char *p = (unsigned char *) sig;\0A    const unsigned char *end = sig + slen;\0A    size_t len;\0A    mbedtls_mpi r, s;\0A    mbedtls_mpi_init(&r);\0A    mbedtls_mpi_init(&s);\0A\0A    if ((ret = mbedtls_asn1_get_tag(&p, end, &len,\0A                                    MBEDTLS_ASN1_CONSTRUCTED | MBEDTLS_ASN1_SEQUENCE)) != 0) {\0A        ret += MBEDTLS_ERR_ECP_BAD_INPUT_DATA;\0A        goto cleanup;\0A    }\0A\0A    if (p + len != end) {\0A        ret = MBEDTLS_ERROR_ADD(MBEDTLS_ERR_ECP_BAD_INPUT_DATA,\0A                                MBEDTLS_ERR_ASN1_LENGTH_MISMATCH);\0A        goto cleanup;\0A    }\0A\0A    if ((ret = mbedtls_asn1_get_mpi(&p, end, &r)) != 0 ||\0A        (ret = mbedtls_asn1_get_mpi(&p, end, &s)) != 0) {\0A        ret += MBEDTLS_ERR_ECP_BAD_INPUT_DATA;\0A        goto cleanup;\0A    }\0A#if defined(MBEDTLS_ECDSA_VERIFY_ALT)\0A    (void) rs_ctx;\0A\0A    if ((ret = mbedtls_ecdsa_verify(&ctx->grp, hash, hlen,\0A                                    &ctx->Q, &r, &s)) != 0) {\0A        goto cleanup;\0A    }\0A#else\0A    if ((ret = mbedtls_ecdsa_verify_restartable(&ctx->grp, hash, hlen,\0A                                                &ctx->Q, &r, &s, rs_ctx)) != 0) {\0A        goto cleanup;\0A    }\0A#endif /* MBEDTLS_ECDSA_VERIFY_ALT */\0A\0A    /* At this point we know that the buffer starts with a valid signature.\0A     * Return 0 if the buffer just contains the signature, and a specific\0A     * error code if the valid signature is followed by more data. */\0A    if (p != end) {\0A        ret = MBEDTLS_ERR_ECP_SIG_LEN_MISMATCH;\0A    }\0A\0Acleanup:\0A    mbedtls_mpi_free(&r);\0A    mbedtls_mpi_free(&s);\0A\0A    return ret;\0A}\0A\0A#if !defined(MBEDTLS_ECDSA_GENKEY_ALT)\0A/*\0A * Generate key pair\0A */\0Aint mbedtls_ecdsa_genkey(mbedtls_ecdsa_context *ctx, mbedtls_ecp_group_id gid,\0A                         int (*f_rng)(void *, unsigned char *, size_t), void *p_rng)\0A{\0A    int ret = 0;\0A    ret = mbedtls_ecp_group_load(&ctx->grp, gid);\0A    if (ret != 0) {\0A        return ret;\0A    }\0A\0A    return mbedtls_ecp_gen_keypair(&ctx->grp, &ctx->d,\0A                                   &ctx->Q, f_rng, p_rng);\0A}\0A#endif /* !MBEDTLS_ECDSA_GENKEY_ALT */\0A\0A/*\0A * Set context from an mbedtls_ecp_keypair\0A */\0Aint mbedtls_ecdsa_from_keypair(mbedtls_ecdsa_context *ctx, const mbedtls_ecp_keypair *key)\0A{\0A    int ret = MBEDTLS_ERR_ERROR_CORRUPTION_DETECTED;\0A    if ((ret = mbedtls_ecp_group_copy(&ctx->grp, &key->grp)) != 0 ||\0A        (ret = mbedtls_mpi_copy(&ctx->d, &key->d)) != 0 ||\0A        (ret = mbedtls_ecp_copy(&ctx->Q, &key->Q)) != 0) {\0A        mbedtls_ecdsa_free(ctx);\0A    }\0A\0A    return ret;\0A}\0A\0A/*\0A * Initialize context\0A */\0Avoid mbedtls_ecdsa_init(mbedtls_ecdsa_context *ctx)\0A{\0A    mbedtls_ecp_keypair_init(ctx);\0A}\0A\0A/*\0A * Free context\0A */\0Avoid mbedtls_ecdsa_free(mbedtls_ecdsa_context *ctx)\0A{\0A    if (ctx == NULL) {\0A        return;\0A    }\0A\0A    mbedtls_ecp_keypair_free(ctx);\0A}\0A\0A#if defined(MBEDTLS_ECP_RESTARTABLE)\0A/*\0A * Initialize a restart context\0A */\0Avoid mbedtls_ecdsa_restart_init(mbedtls_ecdsa_restart_ctx *ctx)\0A{\0A    mbedtls_ecp_restart_init(&ctx->ecp);\0A\0A    ctx->ver = NULL;\0A    ctx->sig = NULL;\0A#if defined(MBEDTLS_ECDSA_DETERMINISTIC)\0A    ctx->det = NULL;\0A#endif\0A}\0A\0A/*\0A * Free the components of a restart context\0A */\0Avoid mbedtls_ecdsa_restart_free(mbedtls_ecdsa_restart_ctx *ctx)\0A{\0A    if (ctx == NULL) {\0A        return;\0A    }\0A\0A    mbedtls_ecp_restart_free(&ctx->ecp);\0A\0A    ecdsa_restart_ver_free(ctx->ver);\0A    mbedtls_free(ctx->ver);\0A    ctx->ver = NULL;\0A\0A    ecdsa_restart_sig_free(ctx->sig);\0A    mbedtls_free(ctx->sig);\0A    ctx->sig = NULL;\0A\0A#if defined(MBEDTLS_ECDSA_DETERMINISTIC)\0A    ecdsa_restart_det_free(ctx->det);\0A    mbedtls_free(ctx->det);\0A    ctx->det = NULL;\0A#endif\0A}\0A#endif /* MBEDTLS_ECP_RESTARTABLE */\0A\0A#endif /* MBEDTLS_ECDSA_C */\0A\00" }
