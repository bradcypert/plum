@.str43061 = private global { i64, i64, [3973 x i8] } { i64 -1, i64 3972, [3973 x i8] c"/*\0A *  Portable interface to the CPU cycle counter\0A *\0A *  Copyright The Mbed TLS Contributors\0A *  SPDX-License-Identifier: Apache-2.0 OR GPL-2.0-or-later\0A */\0A\0A#include \22common.h\22\0A\0A#if defined(MBEDTLS_TIMING_C)\0A\0A#include \22mbedtls/timing.h\22\0A\0A#if !defined(MBEDTLS_TIMING_ALT)\0A\0A#if !defined(unix) && !defined(__unix__) && !defined(__unix) && \5C\0A    !defined(__APPLE__) && !defined(_WIN32) && !defined(__QNXNTO__) && \5C\0A    !defined(__HAIKU__) && !defined(__midipix__)\0A#error \22This module only works on Unix and Windows, see MBEDTLS_TIMING_C in mbedtls_config.h\22\0A#endif\0A\0A#if defined(_WIN32) && !defined(EFIX64) && !defined(EFI32)\0A\0A#include <windows.h>\0A#include <process.h>\0A\0Astruct _hr_time {\0A    LARGE_INTEGER start;\0A};\0A\0A#else\0A\0A#include <unistd.h>\0A#include <sys/types.h>\0A#include <signal.h>\0A/* time.h should be included independently of MBEDTLS_HAVE_TIME. If the\0A * platform matches the ifdefs above, it will be used. */\0A#include <time.h>\0A#include <sys/time.h>\0Astruct _hr_time {\0A    struct timeval start;\0A};\0A#endif /* _WIN32 && !EFIX64 && !EFI32 */\0A\0A/**\0A * \5Cbrief          Return the elapsed time in milliseconds\0A *\0A * \5Cwarning        May change without notice\0A *\0A * \5Cparam val      points to a timer structure\0A * \5Cparam reset    If 0, query the elapsed time. Otherwise (re)start the timer.\0A *\0A * \5Creturn         Elapsed time since the previous reset in ms. When\0A *                 restarting, this is always 0.\0A *\0A * \5Cnote           To initialize a timer, call this function with reset=1.\0A *\0A *                 Determining the elapsed time and resetting the timer is not\0A *                 atomic on all platforms, so after the sequence\0A *                 `{ get_timer(1); ...; time1 = get_timer(1); ...; time2 =\0A *                 get_timer(0) }` the value time1+time2 is only approximately\0A *                 the delay since the first reset.\0A */\0A#if defined(_WIN32) && !defined(EFIX64) && !defined(EFI32)\0A\0Aunsigned long mbedtls_timing_get_timer(struct mbedtls_timing_hr_time *val, int reset)\0A{\0A    struct _hr_time *t = (struct _hr_time *) val;\0A\0A    if (reset) {\0A        QueryPerformanceCounter(&t->start);\0A        return 0;\0A    } else {\0A        unsigned long delta;\0A        LARGE_INTEGER now, hfreq;\0A        QueryPerformanceCounter(&now);\0A        QueryPerformanceFrequency(&hfreq);\0A        delta = (unsigned long) ((now.QuadPart - t->start.QuadPart) * 1000ul\0A                                 / hfreq.QuadPart);\0A        return delta;\0A    }\0A}\0A\0A#else /* _WIN32 && !EFIX64 && !EFI32 */\0A\0Aunsigned long mbedtls_timing_get_timer(struct mbedtls_timing_hr_time *val, int reset)\0A{\0A    struct _hr_time *t = (struct _hr_time *) val;\0A\0A    if (reset) {\0A        gettimeofday(&t->start, NULL);\0A        return 0;\0A    } else {\0A        unsigned long delta;\0A        struct timeval now;\0A        gettimeofday(&now, NULL);\0A        delta = (now.tv_sec  - t->start.tv_sec) * 1000ul\0A                + (now.tv_usec - t->start.tv_usec) / 1000;\0A        return delta;\0A    }\0A}\0A\0A#endif /* _WIN32 && !EFIX64 && !EFI32 */\0A\0A/*\0A * Set delays to watch\0A */\0Avoid mbedtls_timing_set_delay(void *data, uint32_t int_ms, uint32_t fin_ms)\0A{\0A    mbedtls_timing_delay_context *ctx = (mbedtls_timing_delay_context *) data;\0A\0A    ctx->int_ms = int_ms;\0A    ctx->fin_ms = fin_ms;\0A\0A    if (fin_ms != 0) {\0A        (void) mbedtls_timing_get_timer(&ctx->timer, 1);\0A    }\0A}\0A\0A/*\0A * Get number of delays expired\0A */\0Aint mbedtls_timing_get_delay(void *data)\0A{\0A    mbedtls_timing_delay_context *ctx = (mbedtls_timing_delay_context *) data;\0A    unsigned long elapsed_ms;\0A\0A    if (ctx->fin_ms == 0) {\0A        return -1;\0A    }\0A\0A    elapsed_ms = mbedtls_timing_get_timer(&ctx->timer, 0);\0A\0A    if (elapsed_ms >= ctx->fin_ms) {\0A        return 2;\0A    }\0A\0A    if (elapsed_ms >= ctx->int_ms) {\0A        return 1;\0A    }\0A\0A    return 0;\0A}\0A\0A/*\0A * Get the final delay.\0A */\0Auint32_t mbedtls_timing_get_final_delay(\0A    const mbedtls_timing_delay_context *data)\0A{\0A    return data->fin_ms;\0A}\0A#endif /* !MBEDTLS_TIMING_ALT */\0A#endif /* MBEDTLS_TIMING_C */\0A\00" }
