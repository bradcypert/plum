nt8 alpn_chosen<0..2^8-1> // ALPN: negotiated application protocol\0A *\0A * Note that many fields of the ssl_context or sub-structures are not\0A * serialized, as they fall in one of the following categories:\0A *\0A *  1. forced value (eg in_left must be 0)\0A *  2. pointer to dynamically-allocated memory (eg session, transform)\0A *  3. value can be re-derived from other data (eg session keys from MS)\0A *  4. value was temporary (eg content of input buffer)\0A *  5. value will be provided by the user again (eg I/O callbacks and context)\0A */\0Aint mbedtls_ssl_context_save(mbedtls_ssl_context *ssl,\0A                             unsigned char *buf,\0A                             size_t buf_len,\0A                             size_t *olen)\0A{\0A    unsigned char *p = buf;\0A    size_t used = 0;\0A    size_t session_len;\0A    int ret = 0;\0A\0A    /*\0A     * Enforce usage restrictions, see \22return BAD_INPUT_DATA\22 in\0A     * this function's documentation.\0A     *\0A     * These are due to assumptions/limitations in the implementation. Some of\0A     * them are likely to stay (no handshake in progress) some might go away\0A     * (only DTLS) but are currently used to simplify the implementation.\0A     */\0A    /* The initial handshake must be over */\0A    if (mbedtls_ssl_is_handshake_over(ssl) == 0) {\0A        MBEDTLS_SSL_DEBUG_MSG(1, (\22Initial handshake isn't over\22));\0A        return MBEDTLS_ERR_SSL_BAD_INPUT_DATA;\0A    }\0A    if (ssl->handshake != NULL) {\0A        MBEDTLS_SSL_DEBUG_MSG(1, (\22Handshake isn't completed\22));\0A        return MBEDTLS_ERR_SSL_BAD_INPUT_DATA;\0A    }\0A    /* Double-check that sub-structures are indeed ready */\0A    if (ssl->transform == NULL || ssl->session == NULL) {\0A        MBEDTLS_SSL_DEBUG_MSG(1, (\22Serialised structures aren't ready\22));\0A        return MBEDTLS_ERR_SSL_BAD_INPUT_DATA;\0A    }\0A    /* There must be no pending incoming or outgoing data */\0A    if (mbedtls_ssl_check_pending(ssl) != 0) {\