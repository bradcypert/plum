\22-\22.concat(plum__radix_acc(0 - (n / r), r, plum__radix_digit(0 - (n - (n / r) * r)))) }\0A    else { plum__radix_acc(n, r, \22\22) }\0A}\0A\0Alet plum__radix_acc (n: Int) (r: Int) (acc: String): String =\0A    if n == 0 { acc } else { plum__radix_acc(n / r, r, plum__radix_digit(n - (n / r) * r).concat(acc)) }\0A\0A/// Built from the digit's VALUE rather than looked up in a table.\0A///\0A/// A global `chars_of(\220123..z\22)` is the obvious spelling and cost\0A/// every program 37 allocations at startup, 36 strings and the\0A/// array, whether or not it ever formatted a number, because\0A/// globals are initialised eagerly and are not dead-code eliminated.\0A/// `bootstrap/alloc-check` caught it as a uniform +37 across every\0A/// fixture, which is what a constant offset in that harness means.\0A///\0A/// This pays about two allocations per digit instead, and only when\0A/// a conversion actually happens. 48 is '0' and 87 is 'a' - 10.\0Alet plum__radix_digit (v: Int): String =\0A    match Bytes.as_string(Bytes.from_array([if v < 10 { 48 + v } else { 87 + v }])) {\0A        Ok(c) => c,\0A        Err(_) => \22?\22,\0A    }\0A\0A/// Lowercase hex, SIGNED: `-255` is `-ff`, not a two's-complement bit\0A/// pattern. `Int.to_hex_bits` is the one that shows the bits.\0Apub let Int.to_hex (n: Int): String = Int.to_radix(n, 16)\0A/// Binary, SIGNED: `-1` is `-1`. `Int.to_bits` shows all 64 bits.\0Apub let Int.to_binary (n: Int): String = Int.to_radix(n, 2)\0A/// Octal, signed. See `Int.to_radix` for other bases.\0Apub let Int.to_octal (n: Int): String = Int.to_radix(n, 8)\0A\0A/// The BIT PATTERN: all 64 bits, two's complement, most significant\0A/// first. This is the one to reach for with a bit field, where a signed\0A/// reading is not what is wanted. `Int.to_bits(-1)` is sixty-four\0A/// ones, while `Int.to_binary(-1)` is \22-1\22. Both are right about\0A/// different questions.\0Apub let Int.to_bits (n: Int): String = plum__bits_acc(n, 63, \22\22)\0A\0Alet plum__bits