 [MGV]\0A */\0Astatic const uint16_t last4[16] =\0A{\0A    0x0000, 0x1c20, 0x3840, 0x2460,\0A    0x7080, 0x6ca0, 0x48c0, 0x54e0,\0A    0xe100, 0xfd20, 0xd940, 0xc560,\0A    0x9180, 0x8da0, 0xa9c0, 0xb5e0\0A};\0A\0Astatic void gcm_mult_smalltable(uint8_t *output, const uint8_t *x, uint64_t H[16][2])\0A{\0A    int i = 0;\0A    unsigned char lo, hi, rem;\0A    uint64_t u64z[2];\0A    const uint64_t *pu64z = NULL;\0A    uint8_t *u8z = (uint8_t *) u64z;\0A\0A    lo = x[15] & 0xf;\0A    hi = (x[15] >> 4) & 0xf;\0A\0A    pu64z = H[lo];\0A\0A    rem = (unsigned char) pu64z[1] & 0xf;\0A    u64z[1] = (pu64z[0] << 60) | (pu64z[1] >> 4);\0A    u64z[0] = (pu64z[0] >> 4);\0A    u64z[0] ^= (uint64_t) last4[rem] << 48;\0A    mbedtls_xor_no_simd(u8z, u8z, (uint8_t *) H[hi], 16);\0A\0A    for (i = 14; i >= 0; i--) {\0A        lo = x[i] & 0xf;\0A        hi = (x[i] >> 4) & 0xf;\0A\0A        rem = (unsigned char) u64z[1] & 0xf;\0A        u64z[1] = (u64z[0] << 60) | (u64z[1] >> 4);\0A        u64z[0] = (u64z[0] >> 4);\0A        u64z[0] ^= (uint64_t) last4[rem] << 48;\0A        mbedtls_xor_no_simd(u8z, u8z, (uint8_t *) H[lo], 16);\0A\0A        rem = (unsigned char) u64z[1] & 0xf;\0A        u64z[1] = (u64z[0] << 60) | (u64z[1] >> 4);\0A        u64z[0] = (u64z[0] >> 4);\0A        u64z[0] ^= (uint64_t) last4[rem] << 48;\0A        mbedtls_xor_no_simd(u8z, u8z, (uint8_t *) H[hi], 16);\0A    }\0A\0A    MBEDTLS_PUT_UINT64_BE(u64z[0], output, 0);\0A    MBEDTLS_PUT_UINT64_BE(u64z[1], output, 8);\0A}\0A#endif\0A\0A/*\0A * Sets output to x times H using the precomputed tables.\0A * x and output are seen as elements of GF(2^128) as in [MGV].\0A */\0Astatic void gcm_mult(mbedtls_gcm_context *ctx, const unsigned char x[16],\0A                     unsigned char output[16])\0A{\0A    switch (ctx->acceleration) {\0A#if defined(MBEDTLS_AESNI_HAVE_CODE)\0A        case MBEDTLS_GCM_ACC_AESNI:\0A            mbedtls_aesni_gcm_mult(output, x, (uint8_t *) ctx->H[MBEDTLS_GCM_HTABLE_SIZE/2]);\0A            break;\0A