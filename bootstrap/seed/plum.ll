this process's console, which is the entire\0A    // point of this function as against `plum_spawn_capture`.\0A    ZeroMemory(&si, sizeof(si));\0A    si.cb = sizeof(si);\0A    ZeroMemory(&pi, sizeof(pi));\0A\0A    if (!CreateProcessW(NULL, cmdline, NULL, NULL, TRUE, 0, NULL, NULL, &si, &pi)) {\0A        free(cmdline);\0A        return -1;\0A    }\0A    free(cmdline);\0A    CloseHandle(pi.hThread);\0A\0A    WaitForSingleObject(pi.hProcess, INFINITE);\0A    if (!GetExitCodeProcess(pi.hProcess, &code)) code = (DWORD)-1;\0A    CloseHandle(pi.hProcess);\0A    (void)program;\0A    return (long long)(int)code;\0A}\0A\0A#endif\0A\0A// Runs a command with stdio INHERITED — no capture, no temp files — and\0A// returns its exit status. `process_run` above is for a caller that\0A// wants the output as a value; this is for a caller that wants the\0A// child to simply BE the program: `plum run` streaming its output as it\0A// happens, and a child that can read stdin.\0A//\0A// Deliberately separate rather than a flag on `process_run`: that one's\0A// whole design is the temp-file capture described above, and threading\0A// \22except don't\22 through it would leave every path harder to read.\0Along long process_run_inherit(const char *program, const char *args_joined, long long argc) {\0A    char *args_copy = strdup(args_joined);\0A    char **argv = malloc(sizeof(char *) * (size_t)(argc + 2));\0A    if (args_copy == NULL || argv == NULL) {\0A        free(args_copy);\0A        free(argv);\0A        return -1;\0A    }\0A    // Same separator-splitting as `process_run` above; see its own note\0A    // on why the first element is special-cased.\0A    argv[0] = (char *)program;\0A    long long idx = 1;\0A    if (argc > 0) {\0A        argv[idx++] = args_copy;\0A        for (char *c = args_copy; *c != '\5C0'; c++) {\0A            if (*c == PLUM_PROC_ARG_SEP) {\0A                *c = '\5C0';\0A                if (idx <= argc) {\0A                    argv[idx++] = c + 1;\0A                