types & MBEDTLS_X509_EXT_KEY_USAGE) {\0A        ret = mbedtls_snprintf(p, n, \22\5Cn%skey usage         : \22, prefix);\0A        MBEDTLS_X509_SAFE_SNPRINTF;\0A\0A        if ((ret = mbedtls_x509_info_key_usage(&p, &n, csr->key_usage)) != 0) {\0A            return ret;\0A        }\0A    }\0A\0A    if (csr->ext_types != 0) {\0A        ret = mbedtls_snprintf(p, n, \22\5Cn\22);\0A        MBEDTLS_X509_SAFE_SNPRINTF;\0A    }\0A\0A    return (int) (size - n);\0A}\0A#endif /* MBEDTLS_X509_REMOVE_INFO */\0A\0A/*\0A * Initialize a CSR\0A */\0Avoid mbedtls_x509_csr_init(mbedtls_x509_csr *csr)\0A{\0A    memset(csr, 0, sizeof(mbedtls_x509_csr));\0A}\0A\0A/*\0A * Unallocate all CSR data\0A */\0Avoid mbedtls_x509_csr_free(mbedtls_x509_csr *csr)\0A{\0A    if (csr == NULL) {\0A        return;\0A    }\0A\0A    mbedtls_pk_free(&csr->pk);\0A\0A#if defined(MBEDTLS_X509_RSASSA_PSS_SUPPORT)\0A    mbedtls_free(csr->sig_opts);\0A#endif\0A\0A    mbedtls_asn1_free_named_data_list_shallow(csr->subject.next);\0A    mbedtls_asn1_sequence_free(csr->subject_alt_names.next);\0A\0A    if (csr->raw.p != NULL) {\0A        mbedtls_zeroize_and_free(csr->raw.p, csr->raw.len);\0A    }\0A\0A    mbedtls_platform_zeroize(csr, sizeof(mbedtls_x509_csr));\0A}\0A\0A#endif /* MBEDTLS_X509_CSR_PARSE_C */\0A\00" }
