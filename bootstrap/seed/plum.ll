@.str39553 = private global { i64, i64, [70210 x i8] } { i64 -1, i64 70209, [70210 x i8] c"/**\0A * \5Cfile ecp.h\0A *\0A * \5Cbrief This file provides an API for Elliptic Curves over GF(P) (ECP).\0A *\0A * The use of ECP in cryptography and TLS is defined in\0A * <em>Standards for Efficient Cryptography Group (SECG): SEC1\0A * Elliptic Curve Cryptography</em> and\0A * <em>RFC-4492: Elliptic Curve Cryptography (ECC) Cipher Suites\0A * for Transport Layer Security (TLS)</em>.\0A *\0A * <em>RFC-2409: The Internet Key Exchange (IKE)</em> defines ECP\0A * group types.\0A *\0A */\0A\0A/*\0A *  Copyright The Mbed TLS Contributors\0A *  SPDX-License-Identifier: Apache-2.0 OR GPL-2.0-or-later\0A */\0A\0A#ifndef MBEDTLS_ECP_H\0A#define MBEDTLS_ECP_H\0A#include \22mbedtls/private_access.h\22\0A\0A#include \22mbedtls/build_info.h\22\0A#include \22mbedtls/platform_util.h\22\0A\0A#include \22mbedtls/bignum.h\22\0A\0A/*\0A * ECP error codes\0A */\0A/** Bad input parameters to function. */\0A#define MBEDTLS_ERR_ECP_BAD_INPUT_DATA                    -0x4F80\0A/** The buffer is too small to write to. */\0A#define MBEDTLS_ERR_ECP_BUFFER_TOO_SMALL                  -0x4F00\0A/** The requested feature is not available, for example, the requested curve is not supported. */\0A#define MBEDTLS_ERR_ECP_FEATURE_UNAVAILABLE               -0x4E80\0A/** The signature is not valid. */\0A#define MBEDTLS_ERR_ECP_VERIFY_FAILED                     -0x4E00\0A/** Memory allocation failed. */\0A#define MBEDTLS_ERR_ECP_ALLOC_FAILED                      -0x4D80\0A/** Generation of random value, such as ephemeral key, failed. */\0A#define MBEDTLS_ERR_ECP_RANDOM_FAILED                     -0x4D00\0A/** Invalid private or public key. */\0A#define MBEDTLS_ERR_ECP_INVALID_KEY                       -0x4C80\0A/** The buffer contains a valid signature followed by more data. */\0A#define MBEDTLS_ERR_ECP_SIG_LEN_MISMATCH                  -0x4C00\0A/** Operation in progress, call again with the same parameters to continue. */\0A#define MBEDTLS_ERR_ECP_IN_PROGRESS                       -0x4B00\0A\0A/* Flags indicating whether to include code that is specific to certain\0A * types of curves. These flags are for internal library use only. */\0A#if defined(MBEDTLS_ECP_DP_SECP192R1_ENABLED) || \5C\0A    defined(MBEDTLS_ECP_DP_SECP224R1_ENABLED) || \5C\0A    defined(MBEDTLS_ECP_DP_SECP256R1_ENABLED) || \5C\0A    defined(MBEDTLS_ECP_DP_SECP384R1_ENABLED) || \5C\0A    defined(MBEDTLS_ECP_DP_SECP521R1_ENABLED) || \5C\0A    defined(MBEDTLS_ECP_DP_BP256R1_ENABLED) || \5C\0A    defined(MBEDTLS_ECP_DP_BP384R1_ENABLED) || \5C\0A    defined(MBEDTLS_ECP_DP_BP512R1_ENABLED) || \5C\0A    defined(MBEDTLS_ECP_DP_SECP192K1_ENABLED) || \5C\0A    defined(MBEDTLS_ECP_DP_SECP224K1_ENABLED) || \5C\0A    defined(MBEDTLS_ECP_DP_SECP256K1_ENABLED)\0A#define MBEDTLS_ECP_SHORT_WEIERSTRASS_ENABLED\0A#endif\0A#if defined(MBEDTLS_ECP_DP_CURVE25519_ENABLED) || \5C\0A    defined(MBEDTLS_ECP_DP_CURVE448_ENABLED)\0A#define MBEDTLS_ECP_MONTGOMERY_ENABLED\0A#endif\0A\0A#ifdef __cplusplus\0Aextern \22C\22 {\0A#endif\0A\0A/**\0A * Domain-parameter identifiers: curve, subgroup, and generator.\0A *\0A * \5Cnote Only curves over prime fields are supported.\0A *\0A * \5Cwarning This library does not support validation of arbitrary domain\0A * parameters. Therefore, only standardized domain parameters from trusted\0A * sources should be used. See mbedtls_ecp_group_load().\0A */\0A/* Note: when adding a new curve:\0A * - Add it at the end of this enum, otherwise you'll break the ABI by\0A *   changing the numerical value for existing curves.\0A * - Increment MBEDTLS_ECP_DP_MAX below if needed.\0A * - Update the calculation of MBEDTLS_ECP_MAX_BITS below.\0A * - Add the corresponding MBEDTLS_ECP_DP_xxx_ENABLED macro definition to\0A *   mbedtls_config.h.\0A * - List the curve as a dependency of MBEDTLS_ECP_C and\0A *   MBEDTLS_ECDSA_C if supported in check_config.h.\0A * - Add the curve to the appropriate curve type macro\0A *   MBEDTLS_ECP_yyy_ENABLED above.\0A * - Add the necessary definitions to ecp_curves.c.\0A * - Add the curve to the ecp_supported_curves array in ecp.c.\0A * - Add the curve to applicable profiles in x509_crt.c.\0A * - Add the curve to applicable presets in ssl_tls.c.\0A */\0Atypedef enum {\0A    MBEDTLS_ECP_DP_NONE = 0,       /*!< Curve not defined. */\0A    MBEDTLS_ECP_DP_SECP192R1,      /*!< Domain parameters for the 192-bit curve defined by FIPS 186-4 and SEC1. */\0A    MBEDTLS_ECP_DP_SECP224R1,      /*!< Domain parameters for the 224-bit curve defined by FIPS 186-4 and SEC1. */\0A    MBEDTLS_ECP_DP_SECP256R1,      /*!< Domain parameters for the 256-bit curve defined by FIPS 186-4 and SEC1. */\0A    MBEDTLS_ECP_DP_SECP384R1,      /*!< Domain parameters for the 384-bit curve defined by FIPS 186-4 and SEC1. */\0A    MBEDTLS_ECP_DP_SECP521R1,      /*!< Domain parameters for the 521-bit curve defined by FIPS 186-4 and SEC1. */\0A    MBEDTLS_ECP_DP_BP256R1,        /*!< Domain parameters for 256-bit Brainpool curve. */\0A    MBEDTLS_ECP_DP_BP384R1,        /*!< Domain parameters for 384-bit Brainpool curve. */\0A    MBEDTLS_ECP_DP_BP512R1,        /*!< Domain parameters for 512-bit Brainpool curve. */\0A    MBEDTLS_ECP_DP_CURVE25519,     /*!< Domain parameters for Curve25519. */\0A    MBEDTLS_ECP_DP_SECP192K1,      /*!< Domain parameters for 192-bit \22Koblitz\22 curve. */\0A    MBEDTLS_ECP_DP_SECP224K1,      /*!< Domain parameters for 224-bit \22Koblitz\22 curve. */\0A    MBEDTLS_ECP_DP_SECP256K1,      /*!< Domain parameters for 256-bit \22Koblitz\22 curve. */\0A    MBEDTLS_ECP_DP_CURVE448,       /*!< Domain parameters for Curve448. */\0A} mbedtls_ecp_group_id;\0A\0A/**\0A * The number of supported curves, plus one for #MBEDTLS_ECP_DP_NONE.\0A */\0A#define MBEDTLS_ECP_DP_MAX     14\0A\0A/*\0A * Curve types\0A */\0Atypedef enum {\0A    MBEDTLS_ECP_TYPE_NONE = 0,\0A    MBEDTLS_ECP_TYPE_SHORT_WEIERSTRASS,    /* y^2 = x^3 + a x + b      */\0A    MBEDTLS_ECP_TYPE_MONTGOMERY,           /* y^2 = x^3 + a x^2 + x    */\0A} mbedtls_ecp_curve_type;\0A\0A/**\0A * Curve information, for use by other modules.\0A *\0A * The fields of this structure are part of the public API and can be\0A * accessed directly by applications. Future versions of the library may\0A * add extra fields or reorder existing fields.\0A */\0Atypedef struct mbedtls_ecp_curve_info {\0A    mbedtls_ecp_group_id grp_id;    /*!< An internal identifier. */\0A    uint16_t tls_id;                /*!< The TLS NamedCurve identifier. */\0A    uint16_t bit_size;              /*!< The curve size in bits. */\0A    const char *name;               /*!< A human-friendly name. */\0A} mbedtls_ecp_curve_info;\0A\0A/**\0A * \5Cbrief           The ECP point structure, in Jacobian coordinates.\0A *\0A * \5Cnote            All functions expect and return points satisfying\0A *                  the following condition: <code>Z == 0</code> or\0A *                  <code>Z == 1</code>. Other values of \5Cp Z are\0A *                  used only by internal functions.\0A *                  The point is zero, or \22at infinity\22, if <code>Z == 0</code>.\0A *                  Otherwise, \5Cp X and \5Cp Y are its standard (affine)\0A *                  coordinates.\0A */\0Atypedef struct mbedtls_ecp_point {\0A    mbedtls_mpi MBEDTLS_PRIVATE(X);          /*!< The X coordinate of the ECP point. */\0A    mbedtls_mpi MBEDTLS_PRIVATE(Y);          /*!< The Y coordinate of the ECP point. */\0A    mbedtls_mpi MBEDTLS_PRIVATE(Z);          /*!< The Z coordinate of the ECP point. */\0A}\0Ambedtls_ecp_point;\0A\0A#if !defined(MBEDTLS_ECP_ALT)\0A/*\0A * default Mbed TLS elliptic curve arithmetic implementation\0A *\0A * (in case MBEDTLS_ECP_ALT is defined then the developer has to provide an\0A * alternative implementation for the whole module and it will replace this\0A * one.)\0A */\0A\0A/**\0A * \5Cbrief           The ECP group structure.\0A *\0A * We consider two types of curve equations:\0A * <ul><li>Short Weierstrass: <code>y^2 = x^3 + A x + B mod P</code>\0A * (SEC1 + RFC-4492)</li>\0A * <li>Montgomery: <code>y^2 = x^3 + A x^2 + x mod P</code> (Curve25519,\0A * Curve448)</li></ul>\0A * In both cases, the generator (\5Cp G) for a prime-order subgroup is fixed.\0A *\0A * For Short Weierstrass, this subgroup is the whole curve, and its\0A * cardinality is denoted by \5Cp N. Our code requires that \5Cp N is an\0A * odd prime as mbedtls_ecp_mul() requires an odd number, and\0A * mbedtls_ecdsa_sign() requires that it is prime for blinding purposes.\0A *\0A * The default implementation only initializes \5Cp A without setting it to the\0A * authentic value for curves with <code>A = -3</code>(SECP256R1, etc), in which\0A * case you need to load \5Cp A by yourself when using domain parameters directly,\0A * for example:\0A * \5Ccode\0A * mbedtls_mpi_init(&A);\0A * mbedtls_ecp_group_init(&grp);\0A * CHECK_RETURN(mbedtls_ecp_group_load(&grp, grp_id));\0A * if (mbedtls_ecp_group_a_is_minus_3(&grp)) {\0A *     CHECK_RETURN(mbedtls_mpi_sub_int(&A, &grp.P, 3));\0A * } else {\0A *     CHECK_RETURN(mbedtls_mpi_copy(&A, &grp.A));\0A * }\0A *\0A * do_something_with_a(&A);\0A *\0A * cleanup:\0A * mbedtls_mpi_free(&A);\0A * mbedtls_ecp_group_free(&grp);\0A * \5Cendcode\0A *\0A * For Montgomery curves, we do not store \5Cp A, but <code>(A + 2) / 4</code>,\0A * which is the quantity used in the formulas. Additionally, \5Cp nbits is\0A * not the size of \5Cp N but the required size for private keys.\0A *\0A * If \5Cp modp is NULL, reduction modulo \5Cp P is done using a generic algorithm.\0A * Otherwise, \5Cp modp must point to a function that takes an \5Cp mbedtls_mpi in the\0A * range of <code>0..2^(2*pbits)-1</code>, and transforms it in-place to an integer\0A * which is congruent mod \5Cp P to the given MPI, and is close enough to \5Cp pbits\0A * in size, so that it may be efficiently brought in the 0..P-1 range by a few\0A * additions or subtractions. Therefore, it is only an approximate modular\0A * reduction. It must return 0 on success and non-zero on failure.\0A *\0A * \5Cnote        Alternative implementations of the ECP module must obey the\0A *              following constraints.\0A *              * Group IDs must be distinct: if two group structures have\0A *                the same ID, then they must be identical.\0A *              * The fields \5Cc id, \5Cc P, \5Cc A, \5Cc B, \5Cc G, \5Cc N,\0A *                \5Cc pbits and \5Cc nbits must have the same type and semantics\0A *                as in the built-in implementation.\0A *                They must be available for reading, but direct modification\0A *                of these fields does not need to be supported.\0A *                They do not need to be at the same offset in the structure.\0A */\0Atypedef struct mbedtls_ecp_group {\0A    mbedtls_ecp_group_id id;    /*!< An internal group identifier. */\0A    mbedtls_mpi P;              /*!< The prime modulus of the base field. */\0A    mbedtls_mpi A;              /*!< For Short Weierstrass: \5Cp A in the equation. Note that\0A                                     \5Cp A is not set to the authentic value in some cases.\0A                                     Refer to detailed description of ::mbedtls_ecp_group if\0A                                     using domain parameters in the structure.\0A                                     For Montgomery curves: <code>(A + 2) / 4</code>. */\0A    mbedtls_mpi B;              /*!< For Short Weierstrass: \5Cp B in the equation.\0A                                     For Montgomery curves: unused. */\0A    mbedtls_ecp_point G;        /*!< The generator of the subgroup used. */\0A    mbedtls_mpi N;              /*!< The order of \5Cp G. */\0A    size_t pbits;               /*!< The number of bits in \5Cp P.*/\0A    size_t nbits;               /*!< For Short Weierstrass: The number of bits in \5Cp P.\0A                                     For Montgomery curves: the number of bits in the\0A                                     private keys. */\0A    /* End of public fields */\0A\0A    unsigned int MBEDTLS_PRIVATE(h);             /*!< \5Cinternal 1 if the constants are static. */\0A    int(*MBEDTLS_PRIVATE(modp))(mbedtls_mpi *);  /*!< The function for fast pseudo-reduction\0A                                                    mod \5Cp P (see above).*/\0A    int(*MBEDTLS_PRIVATE(t_pre))(mbedtls_ecp_point *, void *);   /*!< Unused. */\0A    int(*MBEDTLS_PRIVATE(t_post))(mbedtls_ecp_point *, void *);  /*!< Unused. */\0A    void *MBEDTLS_PRIVATE(t_data);               /*!< Unused. */\0A    mbedtls_ecp_point *MBEDTLS_PRIVATE(T);       /*!< Pre-computed points for ecp_mul_comb(). */\0A    size_t MBEDTLS_PRIVATE(T_size);              /*!< The number of dynamic allocated pre-computed points. */\0A}\0Ambedtls_ecp_group;\0A\0A/**\0A * \5Cname SECTION: Module settings\0A *\0A * The configuration options you can set for this module are in this section.\0A * Either change them in mbedtls_config.h, or define them using the compiler command line.\0A * \5C{\0A */\0A\0A#if !defined(MBEDTLS_ECP_WINDOW_SIZE)\0A/*\0A * Maximum \22window\22 size used for point multiplication.\0A * Default: a point where higher memory usage yields diminishing performance\0A *          returns.\0A * Minimum value: 2. Maximum value: 7.\0A *\0A * Result is an array of at most ( 1 << ( MBEDTLS_ECP_WINDOW_SIZE - 1 ) )\0A * points used for point multiplication. This value is directly tied to EC\0A * peak memory usage, so decreasing it by one should roughly cut memory usage\0A * by two (if large curves are in use).\0A *\0A * Reduction in size may reduce speed, but larger curves are impacted first.\0A * Sample performances (in ECDHE handshakes/s, with FIXED_POINT_OPTIM = 1):\0A *      w-size:     6       5       4       3       2\0A *      521       145     141     135     120      97\0A *      384       214     209     198     177     146\0A *      256       320     320     303     262     226\0A *      224       475     475     453     398     342\0A *      192       640     640     633     587     476\0A */\0A#define MBEDTLS_ECP_WINDOW_SIZE    4   /**< The maximum window size used. */\0A#endif /* MBEDTLS_ECP_WINDOW_SIZE */\0A\0A#if !defined(MBEDTLS_ECP_FIXED_POINT_OPTIM)\0A/*\0A * Trade code size for speed on fixed-point multiplication.\0A *\0A * This speeds up repeated multiplication of the generator (that is, the\0A * multiplication in ECDSA signatures, and half of the multiplications in\0A * ECDSA verification and ECDHE) by a factor roughly 3 to 4.\0A *\0A * For each n-bit Short Weierstrass curve that is enabled, this adds 4n bytes\0A * of code size if n < 384 and 8n otherwise.\0A *\0A * Change this value to 0 to reduce code size.\0A */\0A#define MBEDTLS_ECP_FIXED_POINT_OPTIM  1   /**< Enable fixed-point speed-up. */\0A#endif /* MBEDTLS_ECP_FIXED_POINT_OPTIM */\0A\0A/** \5C} name SECTION: Module settings */\0A\0A#else  /* MBEDTLS_ECP_ALT */\0A#include \22ecp_alt.h\22\0A#endif /* MBEDTLS_ECP_ALT */\0A\0A/**\0A * The maximum size of the groups, that is, of \5Cc N and \5Cc P.\0A */\0A#if !defined(MBEDTLS_ECP_LIGHT)\0A/* Dummy definition to help code that has optional ECP support and\0A * defines an MBEDTLS_ECP_MAX_BYTES-sized array unconditionally. */\0A#define MBEDTLS_ECP_MAX_BITS 1\0A/* Note: the curves must be listed in DECREASING size! */\0A#elif defined(MBEDTLS_ECP_DP_SECP521R1_ENABLED)\0A#define MBEDTLS_ECP_MAX_BITS 521\0A#elif defined(MBEDTLS_ECP_DP_BP512R1_ENABLED)\0A#define MBEDTLS_ECP_MAX_BITS 512\0A#elif defined(MBEDTLS_ECP_DP_CURVE448_ENABLED)\0A#define MBEDTLS_ECP_MAX_BITS 448\0A#elif defined(MBEDTLS_ECP_DP_BP384R1_ENABLED)\0A#define MBEDTLS_ECP_MAX_BITS 384\0A#elif defined(MBEDTLS_ECP_DP_SECP384R1_ENABLED)\0A#define MBEDTLS_ECP_MAX_BITS 384\0A#elif defined(MBEDTLS_ECP_DP_BP256R1_ENABLED)\0A#define MBEDTLS_ECP_MAX_BITS 256\0A#elif defined(MBEDTLS_ECP_DP_SECP256K1_ENABLED)\0A#define MBEDTLS_ECP_MAX_BITS 256\0A#elif defined(MBEDTLS_ECP_DP_SECP256R1_ENABLED)\0A#define MBEDTLS_ECP_MAX_BITS 256\0A#elif defined(MBEDTLS_ECP_DP_CURVE25519_ENABLED)\0A#define MBEDTLS_ECP_MAX_BITS 255\0A#elif defined(MBEDTLS_ECP_DP_SECP224K1_ENABLED)\0A#define MBEDTLS_ECP_MAX_BITS 225 // n is slightly above 2^224\0A#elif defined(MBEDTLS_ECP_DP_SECP224R1_ENABLED)\0A#define MBEDTLS_ECP_MAX_BITS 224\0A#elif defined(MBEDTLS_ECP_DP_SECP192K1_ENABLED)\0A#define MBEDTLS_ECP_MAX_BITS 192\0A#elif defined(MBEDTLS_ECP_DP_SECP192R1_ENABLED)\0A#define MBEDTLS_ECP_MAX_BITS 192\0A#else /* !MBEDTLS_ECP_LIGHT */\0A#error \22Missing definition of MBEDTLS_ECP_MAX_BITS\22\0A#endif /* !MBEDTLS_ECP_LIGHT */\0A\0A#define MBEDTLS_ECP_MAX_BYTES    ((MBEDTLS_ECP_MAX_BITS + 7) / 8)\0A#define MBEDTLS_ECP_MAX_PT_LEN   (2 * MBEDTLS_ECP_MAX_BYTES + 1)\0A\0A#if defined(MBEDTLS_ECP_RESTARTABLE)\0A\0A/**\0A * \5Cbrief           Internal restart context for multiplication\0A *\0A * \5Cnote            Opaque struct\0A */\0Atypedef struct mbedtls_ecp_restart_mul mbedtls_ecp_restart_mul_ctx;\0A\0A/**\0A * \5Cbrief           Internal restart context for ecp_muladd()\0A *\0A * \5Cnote            Opaque struct\0A */\0Atypedef struct mbedtls_ecp_restart_muladd mbedtls_ecp_restart_muladd_ctx;\0A\0A/**\0A * \5Cbrief           General context for resuming ECC operations\0A */\0Atypedef struct {\0A    unsigned MBEDTLS_PRIVATE(ops_done);                  /*!<  current ops count             */\0A    unsigned MBEDTLS_PRIVATE(depth);                     /*!<  call depth (0 = top-level)    */\0A    mbedtls_ecp_restart_mul_ctx *MBEDTLS_PRIVATE(rsm);   /*!<  ecp_mul_comb() sub-context    */\0A    mbedtls_ecp_restart_muladd_ctx *MBEDTLS_PRIVATE(ma); /*!<  ecp_muladd() sub-context      */\0A} mbedtls_ecp_restart_ctx;\0A\0A/*\0A * Operation counts for restartable functions\0A */\0A#define MBEDTLS_ECP_OPS_CHK   3 /*!< basic ops count for ecp_check_pubkey()  */\0A#define MBEDTLS_ECP_OPS_DBL   8 /*!< basic ops count for ecp_double_jac()    */\0A#define MBEDTLS_ECP_OPS_ADD  11 /*!< basic ops count for see ecp_add_mixed() */\0A#define MBEDTLS_ECP_OPS_INV 120 /*!< empirical equivalent for mpi_mod_inv()  */\0A\0A/**\0A * \5Cbrief           Internal; for restartable functions in other modules.\0A *                  Check and update basic ops budget.\0A *\0A * \5Cparam grp       Group structure\0A * \5Cparam rs_ctx    Restart context\0A * \5Cparam ops       Number of basic ops to do\0A *\0A * \5Creturn          \5Cc 0 if doing \5Cp ops basic ops is still allowed,\0A * \5Creturn          #MBEDTLS_ERR_ECP_IN_PROGRESS otherwise.\0A */\0Aint mbedtls_ecp_check_budget(const mbedtls_ecp_group *grp,\0A                             mbedtls_ecp_restart_ctx *rs_ctx,\0A                             unsigned ops);\0A\0A/* Utility macro for checking and updating ops budget */\0A#define MBEDTLS_ECP_BUDGET(ops)   \5C\0A    MBEDTLS_MPI_CHK(mbedtls_ecp_check_budget(grp, rs_ctx, \5C\0A                                             (unsigned) (ops)));\0A\0A#else /* MBEDTLS_ECP_RESTARTABLE */\0A\0A#define MBEDTLS_ECP_BUDGET(ops)     /* no-op; for compatibility */\0A\0A/* We want to declare restartable versions of existing functions anyway */\0Atypedef void mbedtls_ecp_restart_ctx;\0A\0A#endif /* MBEDTLS_ECP_RESTARTABLE */\0A\0A/**\0A * \5Cbrief    The ECP key-pair structure.\0A *\0A * A generic key-pair that may be used for ECDSA and fixed ECDH, for example.\0A *\0A * \5Cnote    Members are deliberately in the same order as in the\0A *          ::mbedtls_ecdsa_context structure.\0A */\0Atypedef struct mbedtls_ecp_keypair {\0A    mbedtls_ecp_group MBEDTLS_PRIVATE(grp);      /*!<  Elliptic curve and base point     */\0A    mbedtls_mpi MBEDTLS_PRIVATE(d);              /*!<  our secret value                  */\0A    mbedtls_ecp_point MBEDTLS_PRIVATE(Q);        /*!<  our public value                  */\0A}\0Ambedtls_ecp_keypair;\0A\0A/**\0A * The uncompressed point format for Short Weierstrass curves\0A * (MBEDTLS_ECP_DP_SECP_XXX and MBEDTLS_ECP_DP_BP_XXX).\0A */\0A#define MBEDTLS_ECP_PF_UNCOMPRESSED    0\0A/**\0A * The compressed point format for Short Weierstrass curves\0A * (MBEDTLS_ECP_DP_SECP_XXX and MBEDTLS_ECP_DP_BP_XXX).\0A *\0A * \5Cwarning     While this format is supported for all concerned curves for\0A *              writing, when it comes to parsing, it is not supported for all\0A *              curves. Specifically, parsing compressed points on\0A *              MBEDTLS_ECP_DP_SECP224R1 and MBEDTLS_ECP_DP_SECP224K1 is not\0A *              supported.\0A */\0A#define MBEDTLS_ECP_PF_COMPRESSED      1\0A\0A/*\0A * Some other constants from RFC 4492\0A */\0A#define MBEDTLS_ECP_TLS_NAMED_CURVE    3   /**< The named_curve of ECCurveType. */\0A\0A#if defined(MBEDTLS_ECP_RESTARTABLE)\0A/**\0A * \5Cbrief           Set the maximum number of basic operations done in a row.\0A *\0A *                  If more operations are needed to complete a computation,\0A *                  #MBEDTLS_ERR_ECP_IN_PROGRESS will be returned by the\0A *                  function performing the computation. It is then the\0A *                  caller's responsibility to either call again with the same\0A *                  parameters until it returns 0 or an error code; or to free\0A *                  the restart context if the operation is to be aborted.\0A *\0A *                  It is strictly required that all input parameters and the\0A *                  restart context be the same on successive calls for the\0A *                  same operation, but output parameters need not be the\0A *                  same; they must not be used until the function finally\0A *                  returns 0.\0A *\0A *                  This only applies to functions whose documentation\0A *                  mentions they may return #MBEDTLS_ERR_ECP_IN_PROGRESS (or\0A *                  #MBEDTLS_ERR_SSL_CRYPTO_IN_PROGRESS for functions in the\0A *                  SSL module). For functions that accept a \22restart context\22\0A *                  argument, passing NULL disables restart and makes the\0A *                  function equivalent to the function with the same name\0A *                  with \5Cc _restartable removed. For functions in the ECDH\0A *                  module, restart is disabled unless the function accepts\0A *                  an \22ECDH context\22 argument and\0A *                  mbedtls_ecdh_enable_restart() was previously called on\0A *                  that context. For function in the SSL module, restart is\0A *                  only enabled for specific sides and key exchanges\0A *                  (currently only for clients and ECDHE-ECDSA).\0A *\0A * \5Cwarning         Using the PSA interruptible interfaces with keys in local\0A *                  storage and no accelerator driver will also call this\0A *                  function to set the values specified via those interfaces,\0A *                  overwriting values previously set. Care should be taken if\0A *                  mixing these two interfaces.\0A *\0A * \5Cparam max_ops   Maximum number of basic operations done in a row.\0A *                  Default: 0 (unlimited).\0A *                  Lower (non-zero) values mean ECC functions will block for\0A *                  a lesser maximum amount of time.\0A *\0A * \5Cnote            A \22basic operation\22 is defined as a rough equivalent of a\0A *                  multiplication in GF(p) for the NIST P-256 curve.\0A *                  As an indication, with default settings, a scalar\0A *                  multiplication (full run of \5Cc mbedtls_ecp_mul()) is:\0A *                  - about 3300 basic operations for P-256\0A *                  - about 9400 basic operations for P-384\0A *\0A * \5Cnote            Very low values are not always respected: sometimes\0A *                  functions need to block for a minimum number of\0A *                  operations, and will do so even if max_ops is set to a\0A *                  lower value.  That minimum depends on the curve size, and\0A *                  can be made lower by decreasing the value of\0A *                  \5Cc MBEDTLS_ECP_WINDOW_SIZE.  As an indication, here is the\0A *                  lowest effective value for various curves and values of\0A *                  that parameter (w for short):\0A *                          w=6     w=5     w=4     w=3     w=2\0A *                  P-256   208     208     160     136     124\0A *                  P-384   682     416     320     272     248\0A *                  P-521  1364     832     640     544     496\0A *\0A * \5Cnote            This setting is currently ignored by Curve25519.\0A */\0Avoid mbedtls_ecp_set_max_ops(unsigned max_ops);\0A\0A/**\0A * \5Cbrief           Check if restart is enabled (max_ops != 0)\0A *\0A * \5Creturn          \5Cc 0 if \5Cc max_ops == 0 (restart disabled)\0A * \5Creturn          \5Cc 1 otherwise (restart enabled)\0A */\0Aint mbedtls_ecp_restart_is_enabled(void);\0A#endif /* MBEDTLS_ECP_RESTARTABLE */\0A\0A/*\0A * Get the type of a curve\0A */\0Ambedtls_ecp_curve_type mbedtls_ecp_get_type(const mbedtls_ecp_group *grp);\0A\0A/**\0A * \5Cbrief           This function retrieves the information defined in\0A *                  mbedtls_ecp_curve_info() for all supported curves.\0A *\0A * \5Cnote            This function returns information about all curves\0A *                  supported by the library. Some curves may not be\0A *                  supported for all algorithms. Call mbedtls_ecdh_can_do()\0A *                  or mbedtls_ecdsa_can_do() to check if a curve is\0A *                  supported for ECDH or ECDSA.\0A *\0A * \5Creturn          A statically allocated array. The last entry is 0.\0A */\0Aconst mbedtls_ecp_curve_info *mbedtls_ecp_curve_list(void);\0A\0A/**\0A * \5Cbrief           This function retrieves the list of internal group\0A *                  identifiers of all supported curves in the order of\0A *                  preference.\0A *\0A * \5Cnote            This function returns information about all curves\0A *                  supported by the library. Some curves may not be\0A *                  supported for all algorithms. Call mbedtls_ecdh_can_do()\0A *                  or mbedtls_ecdsa_can_do() to check if a curve is\0A *                  supported for ECDH or ECDSA.\0A *\0A * \5Creturn          A statically allocated array,\0A *                  terminated with MBEDTLS_ECP_DP_NONE.\0A */\0Aconst mbedtls_ecp_group_id *mbedtls_ecp_grp_id_list(void);\0A\0A/**\0A * \5Cbrief           This function retrieves curve information from an internal\0A *                  group identifier.\0A *\0A * \5Cparam grp_id    An \5Cc MBEDTLS_ECP_DP_XXX value.\0A *\0A * \5Creturn          The associated curve information on success.\0A * \5Creturn          NULL on failure.\0A */\0Aconst mbedtls_ecp_curve_info *mbedtls_ecp_curve_info_from_grp_id(mbedtls_ecp_group_id grp_id);\0A\0A/**\0A * \5Cbrief           This function retrieves curve information from a TLS\0A *                  NamedCurve value.\0A *\0A * \5Cparam tls_id    An \5Cc MBEDTLS_ECP_DP_XXX value.\0A *\0A * \5Creturn          The associated curve information on success.\0A * \5Creturn          NULL on failure.\0A */\0Aconst mbedtls_ecp_curve_info *mbedtls_ecp_curve_info_from_tls_id(uint16_t tls_id);\0A\0A/**\0A * \5Cbrief           This function retrieves curve information from a\0A *                  human-readable name.\0A *\0A * \5Cparam name      The human-readable name.\0A *\0A * \5Creturn          The associated curve information on success.\0A * \5Creturn          NULL on failure.\0A */\0Aconst mbedtls_ecp_curve_info *mbedtls_ecp_curve_info_from_name(const char *name);\0A\0A/**\0A * \5Cbrief           This function initializes a point as zero.\0A *\0A * \5Cparam pt        The point to initialize.\0A */\0Avoid mbedtls_ecp_point_init(mbedtls_ecp_point *pt);\0A\0A/**\0A * \5Cbrief           This function initializes an ECP group context\0A *                  without loading any domain parameters.\0A *\0A * \5Cnote            After this function is called, domain parameters\0A *                  for various ECP groups can be loaded through the\0A *                  mbedtls_ecp_group_load() or mbedtls_ecp_tls_read_group()\0A *                  functions.\0A */\0Avoid mbedtls_ecp_group_init(mbedtls_ecp_group *grp);\0A\0A/**\0A * \5Cbrief           This function initializes a key pair as an invalid one.\0A *\0A * \5Cparam key       The key pair to initialize.\0A */\0Avoid mbedtls_ecp_keypair_init(mbedtls_ecp_keypair *key);\0A\0A/**\0A * \5Cbrief           This function frees the components of a point.\0A *\0A * \5Cparam pt        The point to free.\0A */\0Avoid mbedtls_ecp_point_free(mbedtls_ecp_point *pt);\0A\0A/**\0A * \5Cbrief           This function frees the components of an ECP group.\0A *\0A * \5Cparam grp       The group to free. This may be \5Cc NULL, in which\0A *                  case this function returns immediately. If it is not\0A *                  \5Cc NULL, it must point to an initialized ECP group.\0A */\0Avoid mbedtls_ecp_group_free(mbedtls_ecp_group *grp);\0A\0A/**\0A * \5Cbrief           This function frees the components of a key pair.\0A *\0A * \5Cparam key       The key pair to free. This may be \5Cc NULL, in which\0A *                  case this function returns immediately. If it is not\0A *                  \5Cc NULL, it must point to an initialized ECP key pair.\0A */\0Avoid mbedtls_ecp_keypair_free(mbedtls_ecp_keypair *key);\0A\0A#if defined(MBEDTLS_ECP_RESTARTABLE)\0A/**\0A * \5Cbrief           Initialize a restart context.\0A *\0A * \5Cparam ctx       The restart context to initialize. This must\0A *                  not be \5Cc NULL.\0A */\0Avoid mbedtls_ecp_restart_init(mbedtls_ecp_restart_ctx *ctx);\0A\0A/**\0A * \5Cbrief           Free the components of a restart context.\0A *\0A * \5Cparam ctx       The restart context to free. This may be \5Cc NULL, in which\0A *                  case this function returns immediately. If it is not\0A *                  \5Cc NULL, it must point to an initialized restart context.\0A */\0Avoid mbedtls_ecp_restart_free(mbedtls_ecp_restart_ctx *ctx);\0A#endif /* MBEDTLS_ECP_RESTARTABLE */\0A\0A/**\0A * \5Cbrief           This function copies the contents of point \5Cp Q into\0A *                  point \5Cp P.\0A *\0A * \5Cparam P         The destination point. This must be initialized.\0A * \5Cparam Q         The source point. This must be initialized.\0A *\0A * \5Creturn          \5Cc 0 on success.\0A * \5Creturn          #MBEDTLS_ERR_MPI_ALLOC_FAILED on memory-allocation failure.\0A * \5Creturn          Another negative error code for other kinds of failure.\0A */\0Aint mbedtls_ecp_copy(mbedtls_ecp_point *P, const mbedtls_ecp_point *Q);\0A\0A/**\0A * \5Cbrief           This function copies the contents of group \5Cp src into\0A *                  group \5Cp dst.\0A *\0A * \5Cparam dst       The destination group. This must be initialized.\0A * \5Cparam src       The source group. This must be initialized.\0A *\0A * \5Creturn          \5Cc 0 on success.\0A * \5Creturn          #MBEDTLS_ERR_MPI_ALLOC_FAILED on memory-allocation failure.\0A * \5Creturn          Another negative error code on other kinds of failure.\0A */\0Aint mbedtls_ecp_group_copy(mbedtls_ecp_group *dst,\0A                           const mbedtls_ecp_group *src);\0A\0A/**\0A * \5Cbrief           This function sets a point to the point at infinity.\0A *\0A * \5Cparam pt        The point to set. This must be initialized.\0A *\0A * \5Creturn          \5Cc 0 on success.\0A * \5Creturn          #MBEDTLS_ERR_MPI_ALLOC_FAILED on memory-allocation failure.\0A * \5Creturn          Another negative error code on other kinds of failure.\0A */\0Aint mbedtls_ecp_set_zero(mbedtls_ecp_point *pt);\0A\0A/**\0A * \5Cbrief           This function checks if a point is the point at infinity.\0A *\0A * \5Cparam pt        The point to test. This must be initialized.\0A *\0A * \5Creturn          \5Cc 1 if the point is zero.\0A * \5Creturn          \5Cc 0 if the point is non-zero.\0A * \5Creturn          A negative error code on failure.\0A */\0Aint mbedtls_ecp_is_zero(mbedtls_ecp_point *pt);\0A\0A/**\0A * \5Cbrief           This function compares two points.\0A *\0A * \5Cnote            This assumes that the points are normalized. Otherwise,\0A *                  they may compare as \22not equal\22 even if they are.\0A *\0A * \5Cparam P         The first point to compare. This must be initialized.\0A * \5Cparam Q         The second point to compare. This must be initialized.\0A *\0A * \5Creturn          \5Cc 0 if the points are equal.\0A * \5Creturn          #MBEDTLS_ERR_ECP_BAD_INPUT_DATA if the points are not equal.\0A */\0Aint mbedtls_ecp_point_cmp(const mbedtls_ecp_point *P,\0A                          const mbedtls_ecp_point *Q);\0A\0A/**\0A * \5Cbrief           This function imports a non-zero point from two ASCII\0A *                  strings.\0A *\0A * \5Cparam P         The destination point. This must be initialized.\0A * \5Cparam radix     The numeric base of the input.\0A * \5Cparam x         The first affine coordinate, as a null-terminated string.\0A * \5Cparam y         The second affine coordinate, as a null-terminated string.\0A *\0A * \5Creturn          \5Cc 0 on success.\0A * \5Creturn          An \5Cc MBEDTLS_ERR_MPI_XXX error code on failure.\0A */\0Aint mbedtls_ecp_point_read_string(mbedtls_ecp_point *P, int radix,\0A                                  const char *x, const char *y);\0A\0A/**\0A * \5Cbrief           This function exports a point into unsigned binary data.\0A *\0A * \5Cparam grp       The group to which the point should belong.\0A *                  This must be initialized and have group parameters\0A *                  set, for example through mbedtls_ecp_group_load().\0A * \5Cparam P         The point to export. This must be initialized.\0A * \5Cparam format    The point format. This must be either\0A *                  #MBEDTLS_ECP_PF_COMPRESSED or #MBEDTLS_ECP_PF_UNCOMPRESSED.\0A *                  (For groups without these formats, this parameter is\0A *                  ignored. But it still has to be either of the above\0A *                  values.)\0A * \5Cparam olen      The address at which to store the length of\0A *                  the output in Bytes. This must not be \5Cc NULL.\0A * \5Cparam buf       The output buffer. This must be a writable buffer\0A *                  of length \5Cp buflen Bytes.\0A * \5Cparam buflen    The length of the output buffer \5Cp buf in Bytes.\0A *\0A * \5Creturn          \5Cc 0 on success.\0A * \5Creturn          #MBEDTLS_ERR_ECP_BUFFER_TOO_SMALL if the output buffer\0A *                  is too small to hold the point.\0A * \5Creturn          #MBEDTLS_ERR_ECP_FEATURE_UNAVAILABLE if the point format\0A *                  or the export for the given group is not implemented.\0A * \5Creturn          Another negative error code on other kinds of failure.\0A */\0Aint mbedtls_ecp_point_write_binary(const mbedtls_ecp_group *grp,\0A                                   const mbedtls_ecp_point *P,\0A                                   int format, size_t *olen,\0A                                   unsigned char *buf, size_t buflen);\0A\0A/**\0A * \5Cbrief           This function imports a point from unsigned binary data.\0A *\0A * \5Cnote            This function does not check that the point actually\0A *                  belongs to the given group, see mbedtls_ecp_check_pubkey()\0A *                  for that.\0A *\0A * \5Cnote            For compressed points, see #MBEDTLS_ECP_PF_COMPRESSED for\0A *                  limitations.\0A *\0A * \5Cparam grp       The group to which the point should belong.\0A *                  This must be initialized and have group parameters\0A *                  set, for example through mbedtls_ecp_group_load().\0A * \5Cparam P         The destination context to import the point to.\0A *                  This must be initialized.\0A * \5Cparam buf       The input buffer. This must be a readable buffer\0A *                  of length \5Cp ilen Bytes.\0A * \5Cparam ilen      The length of the input buffer \5Cp buf in Bytes.\0A *\0A * \5Creturn          \5Cc 0 on success.\0A * \5Creturn          #MBEDTLS_ERR_ECP_BAD_INPUT_DATA if the input is invalid.\0A * \5Creturn          #MBEDTLS_ERR_MPI_ALLOC_FAILED on memory-allocation failure.\0A * \5Creturn          #MBEDTLS_ERR_ECP_FEATURE_UNAVAILABLE if the import for the\0A *                  given group is not implemented.\0A */\0Aint mbedtls_ecp_point_read_binary(const mbedtls_ecp_group *grp,\0A                                  mbedtls_ecp_point *P,\0A                                  const unsigned char *buf, size_t ilen);\0A\0A/**\0A * \5Cbrief           This function imports a point from a TLS ECPoint record.\0A *\0A * \5Cnote            On function return, \5Cp *buf is updated to point immediately\0A *                  after the ECPoint record.\0A *\0A * \5Cparam grp       The ECP group to use.\0A *                  This must be initialized and have group parameters\0A *                  set, for example through mbedtls_ecp_group_load().\0A * \5Cparam pt        The destination point.\0A * \5Cparam buf       The address of the pointer to the start of the input buffer.\0A * \5Cparam len       The length of the buffer.\0A *\0A * \5Creturn          \5Cc 0 on success.\0A * \5Creturn          An \5Cc MBEDTLS_ERR_MPI_XXX error code on initialization\0A *                  failure.\0A * \5Creturn          #MBEDTLS_ERR_ECP_BAD_INPUT_DATA if input is invalid.\0A */\0Aint mbedtls_ecp_tls_read_point(const mbedtls_ecp_group *grp,\0A                               mbedtls_ecp_point *pt,\0A                               const unsigned char **buf, size_t len);\0A\0A/**\0A * \5Cbrief           This function exports a point as a TLS ECPoint record\0A *                  defined in RFC 4492, Section 5.4.\0A *\0A * \5Cparam grp       The ECP group to use.\0A *                  This must be initialized and have group parameters\0A *                  set, for example through mbedtls_ecp_group_load().\0A * \5Cparam pt        The point to be exported. This must be initialized.\0A * \5Cparam format    The point format to use. This must be either\0A *                  #MBEDTLS_ECP_PF_COMPRESSED or #MBEDTLS_ECP_PF_UNCOMPRESSED.\0A * \5Cparam olen      The address at which to store the length in Bytes\0A *                  of the data written.\0A * \5Cparam buf       The target buffer. This must be a writable buffer of\0A *                  length \5Cp blen Bytes.\0A * \5Cparam blen      The length of the target buffer \5Cp buf in Bytes.\0A *\0A * \5Creturn          \5Cc 0 on success.\0A * \5Creturn          #MBEDTLS_ERR_ECP_BAD_INPUT_DATA if the input is invalid.\0A * \5Creturn          #MBEDTLS_ERR_ECP_BUFFER_TOO_SMALL if the target buffer\0A *                  is too small to hold the exported point.\0A * \5Creturn          Another negative error code on other kinds of failure.\0A */\0Aint mbedtls_ecp_tls_write_point(const mbedtls_ecp_group *grp,\0A                                const mbedtls_ecp_point *pt,\0A                                int format, size_t *olen,\0A                                unsigned char *buf, size_t blen);\0A\0A/**\0A * \5Cbrief           This function sets up an ECP group context\0A *                  from a standardized set of domain parameters.\0A *\0A * \5Cnote            The index should be a value of the NamedCurve enum,\0A *                  as defined in <em>RFC-4492: Elliptic Curve Cryptography\0A *                  (ECC) Cipher Suites for Transport Layer Security (TLS)</em>,\0A *                  usually in the form of an \5Cc MBEDTLS_ECP_DP_XXX macro.\0A *\0A * \5Cparam grp       The group context to setup. This must be initialized.\0A * \5Cparam id        The identifier of the domain parameter set to load.\0A *\0A * \5Creturn          \5Cc 0 on success.\0A * \5Creturn          #MBEDTLS_ERR_ECP_FEATURE_UNAVAILABLE if \5Cp id doesn't\0A *                  correspond to a known group.\0A * \5Creturn          Another negative error code on other kinds of failure.\0A */\0Aint mbedtls_ecp_group_load(mbedtls_ecp_group *grp, mbedtls_ecp_group_id id);\0A\0A/**\0A * \5Cbrief           This function sets up an ECP group context from a TLS\0A *                  ECParameters record as defined in RFC 4492, Section 5.4.\0A *\0A * \5Cnote            The read pointer \5Cp buf is updated to point right after\0A *                  the ECParameters record on exit.\0A *\0A * \5Cparam grp       The group context to setup. This must be initialized.\0A * \5Cparam buf       The address of the pointer to the start of the input buffer.\0A * \5Cparam len       The length of the input buffer \5Cc *buf in Bytes.\0A *\0A * \5Creturn          \5Cc 0 on success.\0A * \5Creturn          #MBEDTLS_ERR_ECP_BAD_INPUT_DATA if input is invalid.\0A * \5Creturn          #MBEDTLS_ERR_ECP_FEATURE_UNAVAILABLE if the group is not\0A *                  recognized.\0A * \5Creturn          Another negative error code on other kinds of failure.\0A */\0Aint mbedtls_ecp_tls_read_group(mbedtls_ecp_group *grp,\0A                               const unsigned char **buf, size_t len);\0A\0A/**\0A * \5Cbrief           This function extracts an elliptic curve group ID from a\0A *                  TLS ECParameters record as defined in RFC 4492, Section 5.4.\0A *\0A * \5Cnote            The read pointer \5Cp buf is updated to point right after\0A *                  the ECParameters record on exit.\0A *\0A * \5Cparam grp       The address at which to store the group id.\0A *                  This must not be \5Cc NULL.\0A * \5Cparam buf       The address of the pointer to the start of the input buffer.\0A * \5Cparam len       The length of the input buffer \5Cc *buf in Bytes.\0A *\0A * \5Creturn          \5Cc 0 on success.\0A * \5Creturn          #MBEDTLS_ERR_ECP_BAD_INPUT_DATA if input is invalid.\0A * \5Creturn          #MBEDTLS_ERR_ECP_FEATURE_UNAVAILABLE if the group is not\0A *                  recognized.\0A * \5Creturn          Another negative error code on other kinds of failure.\0A */\0Aint mbedtls_ecp_tls_read_group_id(mbedtls_ecp_group_id *grp,\0A                                  const unsigned char **buf,\0A                                  size_t len);\0A/**\0A * \5Cbrief           This function exports an elliptic curve as a TLS\0A *                  ECParameters record as defined in RFC 4492, Section 5.4.\0A *\0A * \5Cparam grp       The ECP group to be exported.\0A *                  This must be initialized and have group parameters\0A *                  set, for example through mbedtls_ecp_group_load().\0A * \5Cparam olen      The address at which to store the number of Bytes written.\0A *                  This must not be \5Cc NULL.\0A * \5Cparam buf       The buffer to write to. This must be a writable buffer\0A *                  of length \5Cp blen Bytes.\0A * \5Cparam blen      The length of the output buffer \5Cp buf in Bytes.\0A *\0A * \5Creturn          \5Cc 0 on success.\0A * \5Creturn          #MBEDTLS_ERR_ECP_BUFFER_TOO_SMALL if the output\0A *                  buffer is too small to hold the exported group.\0A * \5Creturn          Another negative error code on other kinds of failure.\0A */\0Aint mbedtls_ecp_tls_write_group(const mbedtls_ecp_group *grp,\0A                                size_t *olen,\0A                                unsigned char *buf, size_t blen);\0A\0A/**\0A * \5Cbrief           This function performs a scalar multiplication of a point\0A *                  by an integer: \5Cp R = \5Cp m * \5Cp P.\0A *\0A *                  It is not thread-safe to use same group in multiple threads.\0A *\0A * \5Cnote            To prevent timing attacks, this function\0A *                  executes the exact same sequence of base-field\0A *                  operations for any valid \5Cp m. It avoids any if-branch or\0A *                  array index depending on the value of \5Cp m. It also uses\0A *                  \5Cp f_rng to randomize some intermediate results.\0A *\0A * \5Cparam grp       The ECP group to use.\0A *                  This must be initialized and have group parameters\0A *                  set, for example through mbedtls_ecp_group_load().\0A * \5Cparam R         The point in which to store the result of the calculation.\0A *                  This must be initialized.\0A * \5Cparam m         The integer by which to multiply. This must be initialized.\0A * \5Cparam P         The point to multiply. This must be initialized.\0A * \5Cparam f_rng     The RNG function. This must not be \5Cc NULL.\0A * \5Cparam p_rng     The RNG context to be passed to \5Cp f_rng. This may be \5Cc\0A *                  NULL if \5Cp f_rng doesn't need a context.\0A *\0A * \5Creturn          \5Cc 0 on success.\0A * \5Creturn          #MBEDTLS_ERR_ECP_INVALID_KEY if \5Cp m is not a valid private\0A *                  key, or \5Cp P is not a valid public key.\0A * \5Creturn          #MBEDTLS_ERR_MPI_ALLOC_FAILED on memory-allocation failure.\0A * \5Creturn          Another negative error code on other kinds of failure.\0A */\0Aint mbedtls_ecp_mul(mbedtls_ecp_group *grp, mbedtls_ecp_point *R,\0A                    const mbedtls_mpi *m, const mbedtls_ecp_point *P,\0A                    int (*f_rng)(void *, unsigned char *, size_t), void *p_rng);\0A\0A/**\0A * \5Cbrief           This function performs multiplication of a point by\0A *                  an integer: \5Cp R = \5Cp m * \5Cp P in a restartable way.\0A *\0A * \5Csee             mbedtls_ecp_mul()\0A *\0A * \5Cnote            This function does the same as \5Cc mbedtls_ecp_mul(), but\0A *                  it can return early and restart according to the limit set\0A *                  with \5Cc mbedtls_ecp_set_max_ops() to reduce blocking.\0A *\0A * \5Cparam grp       The ECP group to use.\0A *                  This must be initialized and have group parameters\0A *                  set, for example through mbedtls_ecp_group_load().\0A * \5Cparam R         The point in which to store the result of the calculation.\0A *                  This must be initialized.\0A * \5Cparam m         The integer by which to multiply. This must be initialized.\0A * \5Cparam P         The point to multiply. This must be initialized.\0A * \5Cparam f_rng     The RNG function. This must not be \5Cc NULL.\0A * \5Cparam p_rng     The RNG context to be passed to \5Cp f_rng. This may be \5Cc\0A *                  NULL if \5Cp f_rng doesn't need a context.\0A * \5Cparam rs_ctx    The restart context (NULL disables restart).\0A *\0A * \5Creturn          \5Cc 0 on success.\0A * \5Creturn          #MBEDTLS_ERR_ECP_INVALID_KEY if \5Cp m is not a valid private\0A *                  key, or \5Cp P is not a valid public key.\0A * \5Creturn          #MBEDTLS_ERR_MPI_ALLOC_FAILED on memory-allocation failure.\0A * \5Creturn          #MBEDTLS_ERR_ECP_IN_PROGRESS if maximum number of\0A *                  operations was reached: see \5Cc mbedtls_ecp_set_max_ops().\0A * \5Creturn          Another negative error code on other kinds of failure.\0A */\0Aint mbedtls_ecp_mul_restartable(mbedtls_ecp_group *grp, mbedtls_ecp_point *R,\0A                                const mbedtls_mpi *m, const mbedtls_ecp_point *P,\0A                                int (*f_rng)(void *, unsigned char *, size_t), void *p_rng,\0A                                mbedtls_ecp_restart_ctx *rs_ctx);\0A\0A#if defined(MBEDTLS_ECP_SHORT_WEIERSTRASS_ENABLED)\0A/**\0A * \5Cbrief           This function checks if domain parameter A of the curve is\0A *                  \5Cc -3.\0A *\0A * \5Cnote            This function is only defined for short Weierstrass curves.\0A *                  It may not be included in builds without any short\0A *                  Weierstrass curve.\0A *\0A * \5Cparam grp       The ECP group to use.\0A *                  This must be initialized and have group parameters\0A *                  set, for example through mbedtls_ecp_group_load().\0A *\0A * \5Creturn          \5Cc 1 if <code>A = -3</code>.\0A * \5Creturn          \5Cc 0 Otherwise.\0A */\0Astatic inline int mbedtls_ecp_group_a_is_minus_3(const mbedtls_ecp_group *grp)\0A{\0A    return grp->A.MBEDTLS_PRIVATE(p) == NULL;\0A}\0A\0A/**\0A * \5Cbrief           This function performs multiplication and addition of two\0A *                  points by integers: \5Cp R = \5Cp m * \5Cp P + \5Cp n * \5Cp Q\0A *\0A *                  It is not thread-safe to use same group in multiple threads.\0A *\0A * \5Cnote            In contrast to mbedtls_ecp_mul(), this function does not\0A *                  guarantee a constant execution flow and timing.\0A *\0A * \5Cnote            This function is only defined for short Weierstrass curves.\0A *                  It may not be included in builds without any short\0A *                  Weierstrass curve.\0A *\0A * \5Cparam grp       The ECP group to use.\0A *                  This must be initialized and have group parameters\0A *                  set, for example through mbedtls_ecp_group_load().\0A * \5Cparam R         The point in which to store the result of the calculation.\0A *                  This must be initialized.\0A * \5Cparam m         The integer by which to multiply \5Cp P.\0A *                  This must be initialized.\0A * \5Cparam P         The point to multiply by \5Cp m. This must be initialized.\0A * \5Cparam n         The integer by which to multiply \5Cp Q.\0A *                  This must be initialized.\0A * \5Cparam Q         The point to be multiplied by \5Cp n.\0A *                  This must be initialized.\0A *\0A * \5Creturn          \5Cc 0 on success.\0A * \5Creturn          #MBEDTLS_ERR_ECP_INVALID_KEY if \5Cp m or \5Cp n are not\0A *                  valid private keys, or \5Cp P or \5Cp Q are not valid public\0A *                  keys.\0A * \5Creturn          #MBEDTLS_ERR_MPI_ALLOC_FAILED on memory-allocation failure.\0A * \5Creturn          #MBEDTLS_ERR_ECP_FEATURE_UNAVAILABLE if \5Cp grp does not\0A *                  designate a short Weierstrass curve.\0A * \5Creturn          Another negative error code on other kinds of failure.\0A */\0Aint mbedtls_ecp_muladd(mbedtls_ecp_group *grp, mbedtls_ecp_point *R,\0A                       const mbedtls_mpi *m, const mbedtls_ecp_point *P,\0A                       const mbedtls_mpi *n, const mbedtls_ecp_point *Q);\0A\0A/**\0A * \5Cbrief           This function performs multiplication and addition of two\0A *                  points by integers: \5Cp R = \5Cp m * \5Cp P + \5Cp n * \5Cp Q in a\0A *                  restartable way.\0A *\0A * \5Csee             \5Cc mbedtls_ecp_muladd()\0A *\0A * \5Cnote            This function works the same as \5Cc mbedtls_ecp_muladd(),\0A *                  but it can return early and restart according to the limit\0A *                  set with \5Cc mbedtls_ecp_set_max_ops() to reduce blocking.\0A *\0A * \5Cnote            This function is only defined for short Weierstrass curves.\0A *                  It may not be included in builds without any short\0A *                  Weierstrass curve.\0A *\0A * \5Cparam grp       The ECP group to use.\0A *                  This must be initialized and have group parameters\0A *                  set, for example through mbedtls_ecp_group_load().\0A * \5Cparam R         The point in which to store the result of the calculation.\0A *                  This must be initialized.\0A * \5Cparam m         The integer by which to multiply \5Cp P.\0A *                  This must be initialized.\0A * \5Cparam P         The point to multiply by \5Cp m. This must be initialized.\0A * \5Cparam n         The integer by which to multiply \5Cp Q.\0A *                  This must be initialized.\0A * \5Cparam Q         The point to be multiplied by \5Cp n.\0A *                  This must be initialized.\0A * \5Cparam rs_ctx    The restart context (NULL disables restart).\0A *\0A * \5Creturn          \5Cc 0 on success.\0A * \5Creturn          #MBEDTLS_ERR_ECP_INVALID_KEY if \5Cp m or \5Cp n are not\0A *                  valid private keys, or \5Cp P or \5Cp Q are not valid public\0A *                  keys.\0A * \5Creturn          #MBEDTLS_ERR_MPI_ALLOC_FAILED on memory-allocation failure.\0A * \5Creturn          #MBEDTLS_ERR_ECP_FEATURE_UNAVAILABLE if \5Cp grp does not\0A *                  designate a short Weierstrass curve.\0A * \5Creturn          #MBEDTLS_ERR_ECP_IN_PROGRESS if maximum number of\0A *                  operations was reached: see \5Cc mbedtls_ecp_set_max_ops().\0A * \5Creturn          Another negative error code on other kinds of failure.\0A */\0Aint mbedtls_ecp_muladd_restartable(\0A    mbedtls_ecp_group *grp, mbedtls_ecp_point *R,\0A    const mbedtls_mpi *m, const mbedtls_ecp_point *P,\0A    const mbedtls_mpi *n, const mbedtls_ecp_point *Q,\0A    mbedtls_ecp_restart_ctx *rs_ctx);\0A#endif /* MBEDTLS_ECP_SHORT_WEIERSTRASS_ENABLED */\0A\0A/**\0A * \5Cbrief           This function checks that a point is a valid public key\0A *                  on this curve.\0A *\0A *                  It only checks that the point is non-zero, has\0A *                  valid coordinates and lies on the curve. It does not verify\0A *                  that it is indeed a multiple of \5Cc G. This additional\0A *                  check is computationally more expensive, is not required\0A *                  by standards, and should not be necessary if the group\0A *                  used has a small cofactor. In particular, it is useless for\0A *                  the NIST groups which all have a cofactor of 1.\0A *\0A * \5Cnote            This function uses bare components rather than an\0A *                  ::mbedtls_ecp_keypair structure, to ease use with other\0A *                  structures, such as ::mbedtls_ecdh_context or\0A *                  ::mbedtls_ecdsa_context.\0A *\0A * \5Cparam grp       The ECP group the point should belong to.\0A *                  This must be initialized and have group parameters\0A *                  set, for example through mbedtls_ecp_group_load().\0A * \5Cparam pt        The point to check. This must be initialized.\0A *\0A * \5Creturn          \5Cc 0 if the point is a valid public key.\0A * \5Creturn          #MBEDTLS_ERR_ECP_INVALID_KEY if the point is not\0A *                  a valid public key for the given curve.\0A * \5Creturn          Another negative error code on other kinds of failure.\0A */\0Aint mbedtls_ecp_check_pubkey(const mbedtls_ecp_group *grp,\0A                             const mbedtls_ecp_point *pt);\0A\0A/**\0A * \5Cbrief           This function checks that an \5Cc mbedtls_mpi is a\0A *                  valid private key for this curve.\0A *\0A * \5Cnote            This function uses bare components rather than an\0A *                  ::mbedtls_ecp_keypair structure to ease use with other\0A *                  structures, such as ::mbedtls_ecdh_context or\0A *                  ::mbedtls_ecdsa_context.\0A *\0A * \5Cparam grp       The ECP group the private key should belong to.\0A *                  This must be initialized and have group parameters\0A *                  set, for example through mbedtls_ecp_group_load().\0A * \5Cparam d         The integer to check. This must be initialized.\0A *\0A * \5Creturn          \5Cc 0 if the point is a valid private key.\0A * \5Creturn          #MBEDTLS_ERR_ECP_INVALID_KEY if the point is not a valid\0A *                  private key for the given curve.\0A * \5Creturn          Another negative error code on other kinds of failure.\0A */\0Aint mbedtls_ecp_check_privkey(const mbedtls_ecp_group *grp,\0A                              const mbedtls_mpi *d);\0A\0A/**\0A * \5Cbrief           This function generates a private key.\0A *\0A * \5Cparam grp       The ECP group to generate a private key for.\0A *                  This must be initialized and have group parameters\0A *                  set, for example through mbedtls_ecp_group_load().\0A * \5Cparam d         The destination MPI (secret part). This must be initialized.\0A * \5Cparam f_rng     The RNG function. This must not be \5Cc NULL.\0A * \5Cparam p_rng     The RNG parameter to be passed to \5Cp f_rng. This may be\0A *                  \5Cc NULL if \5Cp f_rng doesn't need a context argument.\0A *\0A * \5Creturn          \5Cc 0 on success.\0A * \5Creturn          An \5Cc MBEDTLS_ERR_ECP_XXX or \5Cc MBEDTLS_MPI_XXX error code\0A *                  on failure.\0A */\0Aint mbedtls_ecp_gen_privkey(const mbedtls_ecp_group *grp,\0A                            mbedtls_mpi *d,\0A                            int (*f_rng)(void *, unsigned char *, size_t),\0A                            void *p_rng);\0A\0A/**\0A * \5Cbrief           This function generates a keypair with a configurable base\0A *                  point.\0A *\0A * \5Cnote            This function uses bare components rather than an\0A *                  ::mbedtls_ecp_keypair structure to ease use with other\0A *                  structures, such as ::mbedtls_ecdh_context or\0A *                  ::mbedtls_ecdsa_context.\0A *\0A * \5Cparam grp       The ECP group to generate a key pair for.\0A *                  This must be initialized and have group parameters\0A *                  set, for example through mbedtls_ecp_group_load().\0A * \5Cparam G         The base point to use. This must be initialized\0A *                  and belong to \5Cp grp. It replaces the default base\0A *                  point \5Cc grp->G used by mbedtls_ecp_gen_keypair().\0A * \5Cparam d         The destination MPI (secret part).\0A *                  This must be initialized.\0A * \5Cparam Q         The destination point (public part).\0A *                  This must be initialized.\0A * \5Cparam f_rng     The RNG function. This must not be \5Cc NULL.\0A * \5Cparam p_rng     The RNG context to be passed to \5Cp f_rng. This may\0A *                  be \5Cc NULL if \5Cp f_rng doesn't need a context argument.\0A *\0A * \5Creturn          \5Cc 0 on success.\0A * \5Creturn          An \5Cc MBEDTLS_ERR_ECP_XXX or \5Cc MBEDTLS_MPI_XXX error code\0A *                  on failure.\0A */\0Aint mbedtls_ecp_gen_keypair_base(mbedtls_ecp_group *grp,\0A                                 const mbedtls_ecp_point *G,\0A                                 mbedtls_mpi *d, mbedtls_ecp_point *Q,\0A                                 int (*f_rng)(void *, unsigned char *, size_t),\0A                                 void *p_rng);\0A\0A/**\0A * \5Cbrief           This function generates an ECP keypair.\0A *\0A * \5Cnote            This function uses bare components rather than an\0A *                  ::mbedtls_ecp_keypair structure to ease use with other\0A *                  structures, such as ::mbedtls_ecdh_context or\0A *                  ::mbedtls_ecdsa_context.\0A *\0A * \5Cparam grp       The ECP group to generate a key pair for.\0A *                  This must be initialized and have group parameters\0A *                  set, for example through mbedtls_ecp_group_load().\0A * \5Cparam d         The destination MPI (secret part).\0A *                  This must be initialized.\0A * \5Cparam Q         The destination point (public part).\0A *                  This must be initialized.\0A * \5Cparam f_rng     The RNG function. This must not be \5Cc NULL.\0A * \5Cparam p_rng     The RNG context to be passed to \5Cp f_rng. This may\0A *                  be \5Cc NULL if \5Cp f_rng doesn't need a context argument.\0A *\0A * \5Creturn          \5Cc 0 on success.\0A * \5Creturn          An \5Cc MBEDTLS_ERR_ECP_XXX or \5Cc MBEDTLS_MPI_XXX error code\0A *                  on failure.\0A */\0Aint mbedtls_ecp_gen_keypair(mbedtls_ecp_group *grp, mbedtls_mpi *d,\0A                            mbedtls_ecp_point *Q,\0A                            int (*f_rng)(void *, unsigned char *, size_t),\0A                            void *p_rng);\0A\0A/**\0A * \5Cbrief           This function generates an ECP key.\0A *\0A * \5Cparam grp_id    The ECP group identifier.\0A * \5Cparam key       The destination key. This must be initialized.\0A * \5Cparam f_rng     The RNG function to use. This must not be \5Cc NULL.\0A * \5Cparam p_rng     The RNG context to be passed to \5Cp f_rng. This may\0A *                  be \5Cc NULL if \5Cp f_rng doesn't need a context argument.\0A *\0A * \5Creturn          \5Cc 0 on success.\0A * \5Creturn          An \5Cc MBEDTLS_ERR_ECP_XXX or \5Cc MBEDTLS_MPI_XXX error code\0A *                  on failure.\0A */\0Aint mbedtls_ecp_gen_key(mbedtls_ecp_group_id grp_id, mbedtls_ecp_keypair *key,\0A                        int (*f_rng)(void *, unsigned char *, size_t),\0A                        void *p_rng);\0A\0A/** \5Cbrief          Set the public key in a key pair object.\0A *\0A * \5Cnote            This function does not check that the point actually\0A *                  belongs to the given group. Call mbedtls_ecp_check_pubkey()\0A *                  on \5Cp Q before calling this function to check that.\0A *\0A * \5Cnote            This function does not check that the public key matches\0A *                  the private key that is already in \5Cp key, if any.\0A *                  To check the consistency of the resulting key pair object,\0A *                  call mbedtls_ecp_check_pub_priv() after setting both\0A *                  the public key and the private key.\0A *\0A * \5Cparam grp_id    The ECP group identifier.\0A * \5Cparam key       The key pair object. It must be initialized.\0A *                  If its group has already been set, it must match \5Cp grp_id.\0A *                  If its group has not been set, it will be set to \5Cp grp_id.\0A *                  If the public key has already been set, it is overwritten.\0A * \5Cparam Q         The public key to copy. This must be a point on the\0A *                  curve indicated by \5Cp grp_id.\0A *\0A * \5Creturn          \5Cc 0 on success.\0A * \5Creturn          #MBEDTLS_ERR_ECP_BAD_INPUT_DATA if \5Cp key does not\0A *                  match \5Cp grp_id.\0A * \5Creturn          #MBEDTLS_ERR_ECP_FEATURE_UNAVAILABLE if the operation for\0A *                  the group is not implemented.\0A * \5Creturn          #MBEDTLS_ERR_MPI_ALLOC_FAILED on memory-allocation failure.\0A * \5Creturn          Another negative error code on other kinds of failure.\0A */\0Aint mbedtls_ecp_set_public_key(mbedtls_ecp_group_id grp_id,\0A                               mbedtls_ecp_keypair *key,\0A                               const mbedtls_ecp_point *Q);\0A\0A/**\0A * \5Cbrief           This function reads an elliptic curve private key.\0A *\0A * \5Cnote            This function does not set the public key in the\0A *                  key pair object. Without a public key, the key pair object\0A *                  cannot be used with operations that require the public key.\0A *                  Call mbedtls_ecp_keypair_calc_public() to set the public\0A *                  key from the private key. Alternatively, you can call\0A *                  mbedtls_ecp_set_public_key() to set the public key part,\0A *                  and then optionally mbedtls_ecp_check_pub_priv() to check\0A *                  that the private and public parts are consistent.\0A *\0A * \5Cnote            If a public key has already been set in the key pair\0A *                  object, this function does not check that it is consistent\0A *                  with the private key. Call mbedtls_ecp_check_pub_priv()\0A *                  after setting both the public key and the private key\0A *                  to make that check.\0A *\0A * \5Cparam grp_id    The ECP group identifier.\0A * \5Cparam key       The destination key.\0A * \5Cparam buf       The buffer containing the binary representation of the\0A *                  key. (Big endian integer for Weierstrass curves, byte\0A *                  string for Montgomery curves.)\0A * \5Cparam buflen    The length of the buffer in bytes.\0A *\0A * \5Creturn          \5Cc 0 on success.\0A * \5Creturn          #MBEDTLS_ERR_ECP_INVALID_KEY error if the key is\0A *                  invalid.\0A * \5Creturn          #MBEDTLS_ERR_MPI_ALLOC_FAILED if memory allocation failed.\0A * \5Creturn          #MBEDTLS_ERR_ECP_FEATURE_UNAVAILABLE if the operation for\0A *                  the group is not implemented.\0A * \5Creturn          Another negative error code on different kinds of failure.\0A */\0Aint mbedtls_ecp_read_key(mbedtls_ecp_group_id grp_id, mbedtls_ecp_keypair *key,\0A                         const unsigned char *buf, size_t buflen);\0A\0A#if !defined(MBEDTLS_DEPRECATED_REMOVED)\0A/**\0A * \5Cbrief           This function exports an elliptic curve private key.\0A *\0A * \5Cdeprecated      Note that although this function accepts an output\0A *                  buffer that is smaller or larger than the key, most key\0A *                  import interfaces require the output to have exactly\0A *                  key's nominal length. It is generally simplest to\0A *                  pass the key's nominal length as \5Cc buflen, after\0A *                  checking that the output buffer is large enough.\0A *                  See the description of the \5Cp buflen parameter for\0A *                  how to calculate the nominal length.\0A *                  To avoid this difficulty, use mbedtls_ecp_write_key_ext()\0A *                  instead.\0A *                  mbedtls_ecp_write_key() is deprecated and will be\0A *                  removed in a future version of the library.\0A *\0A * \5Cnote            If the private key was not set in \5Cp key,\0A *                  the output is unspecified. Future versions\0A *                  may return an error in that case.\0A *\0A * \5Cparam key       The private key.\0A * \5Cparam buf       The output buffer for containing the binary representation\0A *                  of the key.\0A *                  For Weierstrass curves, this is the big-endian\0A *                  representation, padded with null bytes at the beginning\0A *                  to reach \5Cp buflen bytes.\0A *                  For Montgomery curves, this is the standard byte string\0A *                  representation (which is little-endian), padded with\0A *                  null bytes at the end to reach \5Cp buflen bytes.\0A * \5Cparam buflen    The total length of the buffer in bytes.\0A *                  The length of the output is\0A *                  (`grp->nbits` + 7) / 8 bytes\0A *                  where `grp->nbits` is the private key size in bits.\0A *                  For Weierstrass keys, if the output buffer is smaller,\0A *                  leading zeros are trimmed to fit if possible. For\0A *                  Montgomery keys, the output buffer must always be large\0A *                  enough for the nominal length.\0A *\0A * \5Creturn          \5Cc 0 on success.\0A * \5Creturn          #MBEDTLS_ERR_ECP_BUFFER_TOO_SMALL or\0A *                  #MBEDTLS_ERR_MPI_BUFFER_TOO_SMALL if the \5Cp key\0A *                  representation is larger than the available space in \5Cp buf.\0A * \5Creturn          Another negative error code on different kinds of failure.\0A */\0Aint MBEDTLS_DEPRECATED mbedtls_ecp_write_key(mbedtls_ecp_keypair *key,\0A                                             unsigned char *buf, size_t buflen);\0A#endif /* MBEDTLS_DEPRECATED_REMOVED */\0A\0A/**\0A * \5Cbrief           This function exports an elliptic curve private key.\0A *\0A * \5Cparam key       The private key.\0A * \5Cparam olen      On success, the length of the private key.\0A *                  This is always (`grp->nbits` + 7) / 8 bytes\0A *                  where `grp->nbits` is the private key size in bits.\0A * \5Cparam buf       The output buffer for containing the binary representation\0A *                  of the key.\0A * \5Cparam buflen    The total length of the buffer in bytes.\0A *                  #MBEDTLS_ECP_MAX_BYTES is always sufficient.\0A *\0A * \5Creturn          \5Cc 0 on success.\0A * \5Creturn          #MBEDTLS_ERR_ECP_BUFFER_TOO_SMALL if the \5Cp key\0A *                  representation is larger than the available space in \5Cp buf.\0A * \5Creturn          #MBEDTLS_ERR_ECP_BAD_INPUT_DATA if no private key is\0A *                  set in \5Cp key.\0A * \5Creturn          Another negative error code on different kinds of failure.\0A */\0Aint mbedtls_ecp_write_key_ext(const mbedtls_ecp_keypair *key,\0A                              size_t *olen, unsigned char *buf, size_t buflen);\0A\0A/**\0A * \5Cbrief           This function exports an elliptic curve public key.\0A *\0A * \5Cnote            If the public key was not set in \5Cp key,\0A *                  the output is unspecified. Future versions\0A *                  may return an error in that case.\0A *\0A * \5Cparam key       The public key.\0A * \5Cparam format    The point format. This must be either\0A *                  #MBEDTLS_ECP_PF_COMPRESSED or #MBEDTLS_ECP_PF_UNCOMPRESSED.\0A *                  (For groups without these formats, this parameter is\0A *                  ignored. But it still has to be either of the above\0A *                  values.)\0A * \5Cparam olen      The address at which to store the length of\0A *                  the output in Bytes. This must not be \5Cc NULL.\0A * \5Cparam buf       The output buffer. This must be a writable buffer\0A *                  of length \5Cp buflen Bytes.\0A * \5Cparam buflen    The length of the output buffer \5Cp buf in Bytes.\0A *\0A * \5Creturn          \5Cc 0 on success.\0A * \5Creturn          #MBEDTLS_ERR_ECP_BUFFER_TOO_SMALL if the output buffer\0A *                  is too small to hold the point.\0A * \5Creturn          #MBEDTLS_ERR_ECP_FEATURE_UNAVAILABLE if the point format\0A *                  or the export for the given group is not implemented.\0A * \5Creturn          Another negative error code on other kinds of failure.\0A */\0Aint mbedtls_ecp_write_public_key(const mbedtls_ecp_keypair *key,\0A                                 int format, size_t *olen,\0A                                 unsigned char *buf, size_t buflen);\0A\0A/**\0A * \5Cbrief           This function checks that the keypair objects\0A *                  \5Cp pub and \5Cp prv have the same group and the\0A *                  same public point, and that the private key in\0A *                  \5Cp prv is consistent with the public key.\0A *\0A * \5Cparam pub       The keypair structure holding the public key. This\0A *                  must be initialized. If it contains a private key, that\0A *                  part is ignored.\0A * \5Cparam prv       The keypair structure holding the full keypair.\0A *                  This must be initialized.\0A * \5Cparam f_rng     The RNG function. This must not be \5Cc NULL.\0A * \5Cparam p_rng     The RNG context to be passed to \5Cp f_rng. This may be \5Cc\0A *                  NULL if \5Cp f_rng doesn't need a context.\0A *\0A * \5Creturn          \5Cc 0 on success, meaning that the keys are valid and match.\0A * \5Creturn          #MBEDTLS_ERR_ECP_BAD_INPUT_DATA if the keys are invalid or do not match.\0A * \5Creturn          An \5Cc MBEDTLS_ERR_ECP_XXX or an \5Cc MBEDTLS_ERR_MPI_XXX\0A *                  error code on calculation failure.\0A */\0Aint mbedtls_ecp_check_pub_priv(\0A    const mbedtls_ecp_keypair *pub, const mbedtls_ecp_keypair *prv,\0A    int (*f_rng)(void *, unsigned char *, size_t), void *p_rng);\0A\0A/** \5Cbrief          Calculate the public key from a private key in a key pair.\0A *\0A * \5Cparam key       A keypair structure. It must have a private key set.\0A *                  If the public key is set, it will be overwritten.\0A * \5Cparam f_rng     The RNG function. This must not be \5Cc NULL.\0A * \5Cparam p_rng     The RNG context to be passed to \5Cp f_rng. This may be \5Cc\0A *                  NULL if \5Cp f_rng doesn't need a context.\0A *\0A * \5Creturn          \5Cc 0 on success. The key pair object can be used for\0A *                  operations that require the public key.\0A * \5Creturn          An \5Cc MBEDTLS_ERR_ECP_XXX or an \5Cc MBEDTLS_ERR_MPI_XXX\0A *                  error code on calculation failure.\0A */\0Aint mbedtls_ecp_keypair_calc_public(\0A    mbedtls_ecp_keypair *key,\0A    int (*f_rng)(void *, unsigned char *, size_t), void *p_rng);\0A\0A/** \5Cbrief          Query the group that a key pair belongs to.\0A *\0A * \5Cparam key       The key pair to query.\0A *\0A * \5Creturn          The group ID for the group registered in the key pair\0A *                  object.\0A *                  This is \5Cc MBEDTLS_ECP_DP_NONE if no group has been set\0A *                  in the key pair object.\0A */\0Ambedtls_ecp_group_id mbedtls_ecp_keypair_get_group_id(\0A    const mbedtls_ecp_keypair *key);\0A\0A/**\0A * \5Cbrief           This function exports generic key-pair parameters.\0A *\0A *                  Each of the output parameters can be a null pointer\0A *                  if you do not need that parameter.\0A *\0A * \5Cnote            If the private key or the public key was not set in \5Cp key,\0A *                  the corresponding output is unspecified. Future versions\0A *                  may return an error in that case.\0A *\0A * \5Cparam key       The key pair to export from.\0A * \5Cparam grp       Slot for exported ECP group.\0A *                  It must either be null or point to an initialized ECP group.\0A * \5Cparam d         Slot for the exported secret value.\0A *                  It must either be null or point to an initialized mpi.\0A * \5Cparam Q         Slot for the exported public value.\0A *                  It must either be null or point to an initialized ECP point.\0A *\0A * \5Creturn          \5Cc 0 on success,\0A * \5Creturn          #MBEDTLS_ERR_MPI_ALLOC_FAILED on memory-allocation failure.\0A * \5Creturn          #MBEDTLS_ERR_ECP_FEATURE_UNAVAILABLE if key id doesn't\0A *                  correspond to a known group.\0A * \5Creturn          Another negative error code on other kinds of failure.\0A */\0Aint mbedtls_ecp_export(const mbedtls_ecp_keypair *key, mbedtls_ecp_group *grp,\0A                       mbedtls_mpi *d, mbedtls_ecp_point *Q);\0A\0A#if defined(MBEDTLS_SELF_TEST)\0A\0A/**\0A * \5Cbrief          The ECP checkup routine.\0A *\0A * \5Creturn         \5Cc 0 on success.\0A * \5Creturn         \5Cc 1 on failure.\0A */\0Aint mbedtls_ecp_self_test(int verbose);\0A\0A#endif /* MBEDTLS_SELF_TEST */\0A\0A#ifdef __cplusplus\0A}\0A#endif\0A\0A#endif /* ecp.h */\0A\00" }
