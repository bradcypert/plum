4) | b);\0A    }\0A    path[n / 2] = '\5C0';\0A    const char *digest = plum_cache_hash_file(path);\0A    free(path);\0A    return digest;\0A}\0A\0A// Verify the bytes actually copied, not a prior read of the source path.\0A// A concurrent cleaner can remove an entry at any point; that is a miss.\0Along long plum_cache_copy(const char *src, const char *dst, const char *digest) {\0A    FILE *in=fopen(src,\22rb\22); if (!in) return -1;\0A    FILE *out=fopen(dst,\22wb\22); if (!out) { fclose(in); return -1; }\0A    unsigned char buf[32768]; size_t n; int bad=0; char got[65];\0A    plum_cache_sha s; plum_cache_init(&s);\0A    while ((n=fread(buf,1,sizeof(buf),in)) != 0) {\0A        plum_cache_update(&s,buf,n);\0A        if (fwrite(buf,1,n,out) != n) { bad=1; break; }\0A    }\0A    if (ferror(in)) bad=1;\0A    if (fclose(in) != 0) bad=1;\0A    if (fclose(out) != 0) bad=1;\0A    plum_cache_final(&s,got);\0A    if (digest[0] && strcmp(got,digest) != 0) bad=1;\0A    if (bad) remove(dst);\0A    return bad ? -1 : 0;\0A}\0A\0A#if defined(_WIN32)\0A// Reserve the DIRECTORY atomically. GetTempFileName followed by deleting its\0A// file and making a directory releases the name between those operations;\0A// concurrent callers can then select the same supposedly unique name.\0Astatic void plum_win_temp_dir(const char *root, const char *prefix) {\0A    static volatile LONG serial=0;\0A    size_t len=strlen(root);\0A    const char *separator=len && (root[len-1]=='/' || root[len-1]=='\5C\5C') ? \22\22 : \22\5C\5C\22;\0A    for (unsigned attempt=0; attempt<128; attempt++) {\0A        unsigned long next=(unsigned long)(ULONG)InterlockedIncrement(&serial);\0A        int n=snprintf(plum_os_buf,sizeof(plum_os_buf),\22%s%s%s%lu-%llu-%lu\22,root,separator,prefix,\0A                       (unsigned long)GetCurrentProcessId(),(unsigned long long)GetTickCount64(),next);\0A        if (n<0 || n>=(int)sizeof(plum_os_buf)) break;\0A        if (CreateDirectoryA(plum_os_buf,NULL)) return;\0A        