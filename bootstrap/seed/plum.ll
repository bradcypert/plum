@.str40392 = private global { i64, i64, [21645 x i8] } { i64 -1, i64 21644, [21645 x i8] c"/*\0A *  Elliptic curve Diffie-Hellman\0A *\0A *  Copyright The Mbed TLS Contributors\0A *  SPDX-License-Identifier: Apache-2.0 OR GPL-2.0-or-later\0A */\0A\0A/*\0A * References:\0A *\0A * SEC1 https://www.secg.org/sec1-v2.pdf\0A * RFC 4492\0A */\0A\0A#include \22common.h\22\0A\0A#if defined(MBEDTLS_ECDH_C)\0A\0A#include \22mbedtls/ecdh.h\22\0A#include \22mbedtls/platform_util.h\22\0A#include \22mbedtls/error.h\22\0A\0A#include <string.h>\0A\0A#if defined(MBEDTLS_ECDH_LEGACY_CONTEXT)\0Atypedef mbedtls_ecdh_context mbedtls_ecdh_context_mbed;\0A#endif\0A\0Astatic mbedtls_ecp_group_id mbedtls_ecdh_grp_id(\0A    const mbedtls_ecdh_context *ctx)\0A{\0A#if defined(MBEDTLS_ECDH_LEGACY_CONTEXT)\0A    return ctx->grp.id;\0A#else\0A    return ctx->grp_id;\0A#endif\0A}\0A\0Aint mbedtls_ecdh_can_do(mbedtls_ecp_group_id gid)\0A{\0A    /* At this time, all groups support ECDH. */\0A    (void) gid;\0A    return 1;\0A}\0A\0A#if !defined(MBEDTLS_ECDH_GEN_PUBLIC_ALT)\0A/*\0A * Generate public key (restartable version)\0A *\0A * Note: this internal function relies on its caller preserving the value of\0A * the output parameter 'd' across continuation calls. This would not be\0A * acceptable for a public function but is OK here as we control call sites.\0A */\0Astatic int ecdh_gen_public_restartable(mbedtls_ecp_group *grp,\0A                                       mbedtls_mpi *d, mbedtls_ecp_point *Q,\0A                                       int (*f_rng)(void *, unsigned char *, size_t),\0A                                       void *p_rng,\0A                                       mbedtls_ecp_restart_ctx *rs_ctx)\0A{\0A    int ret = MBEDTLS_ERR_ERROR_CORRUPTION_DETECTED;\0A\0A    int restarting = 0;\0A#if defined(MBEDTLS_ECP_RESTARTABLE)\0A    restarting = (rs_ctx != NULL && rs_ctx->rsm != NULL);\0A#endif\0A    /* If multiplication is in progress, we already generated a privkey */\0A    if (!restarting) {\0A        MBEDTLS_MPI_CHK(mbedtls_ecp_gen_privkey(grp, d, f_rng, p_rng));\0A    }\0A\0A    MBEDTLS_MPI_CHK(mbedtls_ecp_mul_restartable(grp, Q, d, &grp->G,\0A                                                f_rng, p_rng, rs_ctx));\0A\0Acleanup:\0A    return ret;\0A}\0A\0A/*\0A * Generate public key\0A */\0Aint mbedtls_ecdh_gen_public(mbedtls_ecp_group *grp, mbedtls_mpi *d, mbedtls_ecp_point *Q,\0A                            int (*f_rng)(void *, unsigned char *, size_t),\0A                            void *p_rng)\0A{\0A    return ecdh_gen_public_restartable(grp, d, Q, f_rng, p_rng, NULL);\0A}\0A#endif /* !MBEDTLS_ECDH_GEN_PUBLIC_ALT */\0A\0A#if !defined(MBEDTLS_ECDH_COMPUTE_SHARED_ALT)\0A/*\0A * Compute shared secret (SEC1 3.3.1)\0A */\0Astatic int ecdh_compute_shared_restartable(mbedtls_ecp_group *grp,\0A                                           mbedtls_mpi *z,\0A                                           const mbedtls_ecp_point *Q, const mbedtls_mpi *d,\0A                                           int (*f_rng)(void *, unsigned char *, size_t),\0A                                           void *p_rng,\0A                                           mbedtls_ecp_restart_ctx *rs_ctx)\0A{\0A    int ret = MBEDTLS_ERR_ERROR_CORRUPTION_DETECTED;\0A    mbedtls_ecp_point P;\0A\0A    mbedtls_ecp_point_init(&P);\0A\0A    MBEDTLS_MPI_CHK(mbedtls_ecp_mul_restartable(grp, &P, d, Q,\0A                                                f_rng, p_rng, rs_ctx));\0A\0A    if (mbedtls_ecp_is_zero(&P)) {\0A        ret = MBEDTLS_ERR_ECP_BAD_INPUT_DATA;\0A        goto cleanup;\0A    }\0A\0A    MBEDTLS_MPI_CHK(mbedtls_mpi_copy(z, &P.X));\0A\0Acleanup:\0A    mbedtls_ecp_point_free(&P);\0A\0A    return ret;\0A}\0A\0A/*\0A * Compute shared secret (SEC1 3.3.1)\0A */\0Aint mbedtls_ecdh_compute_shared(mbedtls_ecp_group *grp, mbedtls_mpi *z,\0A                                const mbedtls_ecp_point *Q, const mbedtls_mpi *d,\0A                                int (*f_rng)(void *, unsigned char *, size_t),\0A                                void *p_rng)\0A{\0A    return ecdh_compute_shared_restartable(grp, z, Q, d,\0A                                           f_rng, p_rng, NULL);\0A}\0A#endif /* !MBEDTLS_ECDH_COMPUTE_SHARED_ALT */\0A\0Astatic void ecdh_init_internal(mbedtls_ecdh_context_mbed *ctx)\0A{\0A    mbedtls_ecp_group_init(&ctx->grp);\0A    mbedtls_mpi_init(&ctx->d);\0A    mbedtls_ecp_point_init(&ctx->Q);\0A    mbedtls_ecp_point_init(&ctx->Qp);\0A    mbedtls_mpi_init(&ctx->z);\0A\0A#if defined(MBEDTLS_ECP_RESTARTABLE)\0A    mbedtls_ecp_restart_init(&ctx->rs);\0A#endif\0A}\0A\0Ambedtls_ecp_group_id mbedtls_ecdh_get_grp_id(mbedtls_ecdh_context *ctx)\0A{\0A#if defined(MBEDTLS_ECDH_LEGACY_CONTEXT)\0A    return ctx->MBEDTLS_PRIVATE(grp).id;\0A#else\0A    return ctx->MBEDTLS_PRIVATE(grp_id);\0A#endif\0A}\0A\0A/*\0A * Initialize context\0A */\0Avoid mbedtls_ecdh_init(mbedtls_ecdh_context *ctx)\0A{\0A#if defined(MBEDTLS_ECDH_LEGACY_CONTEXT)\0A    ecdh_init_internal(ctx);\0A    mbedtls_ecp_point_init(&ctx->Vi);\0A    mbedtls_ecp_point_init(&ctx->Vf);\0A    mbedtls_mpi_init(&ctx->_d);\0A#else\0A    memset(ctx, 0, sizeof(mbedtls_ecdh_context));\0A\0A    ctx->var = MBEDTLS_ECDH_VARIANT_NONE;\0A#endif\0A    ctx->point_format = MBEDTLS_ECP_PF_UNCOMPRESSED;\0A#if defined(MBEDTLS_ECP_RESTARTABLE)\0A    ctx->restart_enabled = 0;\0A#endif\0A}\0A\0Astatic int ecdh_setup_internal(mbedtls_ecdh_context_mbed *ctx,\0A                               mbedtls_ecp_group_id grp_id)\0A{\0A    int ret = MBEDTLS_ERR_ERROR_CORRUPTION_DETECTED;\0A\0A    ret = mbedtls_ecp_group_load(&ctx->grp, grp_id);\0A    if (ret != 0) {\0A        return MBEDTLS_ERR_ECP_FEATURE_UNAVAILABLE;\0A    }\0A\0A    return 0;\0A}\0A\0A/*\0A * Setup context\0A */\0Aint mbedtls_ecdh_setup(mbedtls_ecdh_context *ctx, mbedtls_ecp_group_id grp_id)\0A{\0A#if defined(MBEDTLS_ECDH_LEGACY_CONTEXT)\0A    return ecdh_setup_internal(ctx, grp_id);\0A#else\0A    switch (grp_id) {\0A#if defined(MBEDTLS_ECDH_VARIANT_EVEREST_ENA