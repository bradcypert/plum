@.str40645 = private global { i64, i64, [5303 x i8] } { i64 -1, i64 5302, [5303 x i8] c"/**\0A * \5Cfile rsa_internal.h\0A *\0A * \5Cbrief Internal-only RSA public-key cryptosystem API.\0A *\0A * This file declares RSA-related functions that are to be used\0A * only from within the Mbed TLS library itself.\0A *\0A */\0A/*\0A *  Copyright The Mbed TLS Contributors\0A *  SPDX-License-Identifier: Apache-2.0 OR GPL-2.0-or-later\0A */\0A#ifndef MBEDTLS_RSA_INTERNAL_H\0A#define MBEDTLS_RSA_INTERNAL_H\0A\0A#include \22mbedtls/rsa.h\22\0A#include \22mbedtls/asn1.h\22\0A\0A/**\0A * \5Cbrief           Parse a PKCS#1 (ASN.1) encoded private RSA key.\0A *\0A * \5Cparam rsa       The RSA context where parsed data will be stored.\0A * \5Cparam key       The buffer that contains the key.\0A * \5Cparam keylen    The length of the key buffer in bytes.\0A *\0A * \5Creturn          0 on success.\0A * \5Creturn          MBEDTLS_ERR_ASN1_xxx in case of ASN.1 parsing errors.\0A * \5Creturn          MBEDTLS_ERR_RSA_xxx in case of RSA internal failures while\0A *                  parsing data.\0A * \5Creturn          MBEDTLS_ERR_RSA_KEY_CHECK_FAILED if validity checks on the\0A *                  provided key fail.\0A */\0Aint mbedtls_rsa_parse_key(mbedtls_rsa_context *rsa, const unsigned char *key, size_t keylen);\0A\0A/**\0A * \5Cbrief           Parse a PKCS#1 (ASN.1) encoded public RSA key.\0A *\0A * \5Cparam rsa       The RSA context where parsed data will be stored.\0A * \5Cparam key       The buffer that contains the key.\0A * \5Cparam keylen    The length of the key buffer in bytes.\0A *\0A * \5Creturn          0 on success.\0A * \5Creturn          MBEDTLS_ERR_ASN1_xxx in case of ASN.1 parsing errors.\0A * \5Creturn          MBEDTLS_ERR_RSA_xxx in case of RSA internal failures while\0A *                  parsing data.\0A * \5Creturn          MBEDTLS_ERR_RSA_KEY_CHECK_FAILED if validity checks on the\0A *                  provided key fail.\0A */\0Aint mbedtls_rsa_parse_pubkey(mbedtls_rsa_context *rsa, const unsigned char *key, size_t keylen);\0A\0A/**\0A * \5Cbrief           Write a PKCS#1 (ASN.1) encoded private RSA key.\0A *\0A * \5Cparam rsa       The RSA context which contains the data to be written.\0A * \5Cparam start     Beginning of the buffer that will be filled with the\0A *                  private key.\0A * \5Cparam p         End of the buffer that will be filled with the private key.\0A *                  On successful return, the referenced pointer will be\0A *                  updated in order to point to the beginning of written data.\0A *\0A * \5Creturn          On success, the number of bytes written to the output buffer\0A *                  (i.e. a value > 0).\0A * \5Creturn          MBEDTLS_ERR_RSA_BAD_INPUT_DATA if the RSA context does not\0A *                  contain a valid key pair.\0A * \5Creturn          MBEDTLS_ERR_ASN1_xxx in case of failure while writing to the\0A *                  output buffer.\0A *\0A * \5Cnote            The output buffer is filled backward, i.e. starting from its\0A *                  end and moving toward its start.\0A */\0Aint mbedtls_rsa_write_key(const mbedtls_rsa_context *rsa, unsigned char *start,\0A                          unsigned char **p);\0A\0A/**\0A * \5Cbrief           Parse a PKCS#1 (ASN.1) encoded public RSA key.\0A *\0A * \5Cparam rsa       The RSA context which contains the data to be written.\0A * \5Cparam start     Beginning of the buffer that will be filled with the\0A *                  private key.\0A * \5Cparam p         End of the buffer that will be filled with the private key.\0A *                  On successful return, the referenced pointer will be\0A *                  updated in order to point to the beginning of written data.\0A *\0A * \5Creturn          On success, the number of bytes written to the output buffer\0A *                  (i.e. a value > 0).\0A * \5Creturn          MBEDTLS_ERR_RSA_BAD_INPUT_DATA if the RSA context does not\0A *                  