@.str41841 = private global { i64, i64, [7750 x i8] } { i64 -1, i64 7749, [7750 x i8] c"/**\0A * \5Cfile chacha20.h\0A *\0A * \5Cbrief   This file contains ChaCha20 definitions and functions.\0A *\0A *          ChaCha20 is a stream cipher that can encrypt and decrypt\0A *          information. ChaCha was created by Daniel Bernstein as a variant of\0A *          its Salsa cipher https://cr.yp.to/chacha/chacha-20080128.pdf\0A *          ChaCha20 is the variant with 20 rounds, that was also standardized\0A *          in RFC 7539.\0A *\0A * \5Cauthor Daniel King <damaki.gh@gmail.com>\0A */\0A\0A/*\0A *  Copyright The Mbed TLS Contributors\0A *  SPDX-License-Identifier: Apache-2.0 OR GPL-2.0-or-later\0A */\0A\0A#ifndef MBEDTLS_CHACHA20_H\0A#define MBEDTLS_CHACHA20_H\0A#include \22mbedtls/private_access.h\22\0A\0A#include \22mbedtls/build_info.h\22\0A\0A#include <stdint.h>\0A#include <stddef.h>\0A\0A/** Invalid input parameter(s). */\0A#define MBEDTLS_ERR_CHACHA20_BAD_INPUT_DATA         -0x0051\0A\0A#ifdef __cplusplus\0Aextern \22C\22 {\0A#endif\0A\0A#if !defined(MBEDTLS_CHACHA20_ALT)\0A\0Atypedef struct mbedtls_chacha20_context {\0A    uint32_t MBEDTLS_PRIVATE(state)[16];          /*! The state (before round operations). */\0A    uint8_t  MBEDTLS_PRIVATE(keystream8)[64];     /*! Leftover keystream bytes. */\0A    size_t MBEDTLS_PRIVATE(keystream_bytes_used); /*! Number of keystream bytes already used. */\0A}\0Ambedtls_chacha20_context;\0A\0A#else  /* MBEDTLS_CHACHA20_ALT */\0A#include \22chacha20_alt.h\22\0A#endif /* MBEDTLS_CHACHA20_ALT */\0A\0A/**\0A * \5Cbrief           This function initializes the specified ChaCha20 context.\0A *\0A *                  It must be the first API called before using\0A *                  the context.\0A *\0A *                  It is usually followed by calls to\0A *                  \5Cc mbedtls_chacha20_setkey() and\0A *                  \5Cc mbedtls_chacha20_starts(), then one or more calls to\0A *                  to \5Cc mbedtls_chacha20_update(), and finally to\0A *                  \5Cc mbedtls_chacha20_free().\0A *\0A * \5Cparam ctx       The ChaCha20 context to initialize.\0A *                  This must not be \5Cc NULL.\0A */\0Avoid mbedtls_chacha20_init(mbedtls_chacha20_context *ctx);\0A\0A/**\0A * \5Cbrief           This function releases and clears the specified\0A *                  ChaCha20 context.\0A *\0A * \5Cparam ctx       The ChaCha20 context to clear. This may be \5Cc NULL,\0A *                  in which case this function is a no-op. If it is not\0A *                  \5Cc NULL, it must point to an initialized context.\0A *\0A */\0Avoid mbedtls_chacha20_free(mbedtls_chacha20_context *ctx);\0A\0A/**\0A * \5Cbrief           This function sets the encryption/decryption key.\0A *\0A * \5Cnote            After using this function, you must also call\0A *                  \5Cc mbedtls_chacha20_starts() to set a nonce before you\0A *                  start encrypting/decrypting data with\0A *                  \5Cc mbedtls_chacha_update().\0A *\0A * \5Cparam ctx       The ChaCha20 context to which the key should be bound.\0A *                  It must be initialized.\0A * \5Cparam key       The encryption/decryption key. This must be \5Cc 32 Bytes\0A *                  in length.\0A *\0A * \5Creturn          \5Cc 0 on success.\0A * \5Creturn          #MBEDTLS_ERR_CHACHA20_BAD_INPUT_DATA if ctx or key is NULL.\0A */\0Aint mbedtls_chacha20_setkey(mbedtls_chacha20_context *ctx,\0A                            const unsigned char key[32]);\0A\0A/**\0A * \5Cbrief           This function sets the nonce and initial counter value.\0A *\0A * \5Cnote            A ChaCha20 context can be re-used with the same key by\0A *                  calling this function to change the nonce.\0A *\0A * \5Cwarning         You must never use the same nonce twice with the same key.\0A *                  This would void any confidentiality guarantees for the\0A *                  messages encrypted with the same nonce and key.\0A *\0A * \5Cparam ctx       The ChaCha20 context to which the nonce should be bound.\0A *                  It must be initialized and bound to a key.\0A * \5Cparam nonce     The nonce. This must be \5Cc 12 Bytes in size.\0A * \5Cparam counter   The initial counter value. This is usually \5Cc 0.\0A *\0A * \5Creturn          \5Cc 0 on success.\0A * \5Creturn          #MBEDTLS_ERR_CHACHA20_BAD_INPUT_DATA if ctx or nonce is\0A *                  NULL.\0A */\0Aint mbedtls_chacha20_starts(mbedtls_chacha20_context *ctx,\0A                            const unsigned char nonce[12],\0A                            uint32_t counter);\0A\0A/**\0A * \5Cbrief           This function encrypts or decrypts data.\0A *\0A *                  Since ChaCha20 is a stream cipher, the same operation is\0A *                  used for encrypting and decrypting data.\0A *\0A * \5Cnote            The \5Cp input and \5Cp output pointers must either be equal or\0A *                  point to non-overlapping buffers.\0A *\0A * \5Cnote            \5Cc mbedtls_chacha20_setkey() and\0A *                  \5Cc mbedtls_chacha20_starts() must be called at least once\0A *                  to setup the context before this function can be called.\0A *\0A * \5Cnote            This function can be called multiple times in a row in\0A *                  order to encrypt of decrypt data piecewise with the same\0A *                  key and nonce.\0A *\0A * \5Cparam ctx       The ChaCha20 context to use for encryption or decryption.\0A *                  It must be initialized and bound to a key and nonce.\0A * \5Cparam size      The length of the input data in Bytes.\0A * \5Cparam input     The buffer holding the input data.\0A *                  This pointer can be \5Cc NULL if `size == 0`.\0A * \5Cparam output    The buffer holding the output data.\0A *                  This must be able to hold \5Cp size Bytes.\0A *                  This pointer can be \5Cc NULL if `size == 0`.\0A *\0A * \5Creturn          \5Cc 0 on success.\0A * \5Creturn          A negative error code on failure.\0A */\0Aint mbedtls_chacha20_update(mbedtls_chacha20_context *ctx,\0A                            size_t size,\0A                            const unsigned char *input,\0A                            unsigned char *output);\0A\0A/**\0A * \5Cbrief           This function encrypts or decrypts data with ChaCha20 and\0A *                  the given key and nonce.\0A *\0A *                  Since ChaCha20 is a stream cipher, the same operation is\0A *                  used for encrypting and decrypting data.\0A *\0A * \5Cwarning         You must never use the same (key, nonce) pair more than\0A *                  once. This would void any confidentiality guarantees for\0A *                  the messages encrypted with the same nonce and key.\0A *\0A * \5Cnote            The \5Cp input and \5Cp output pointers must either be equal or\0A *                  point to non-overlapping buffers.\0A *\0A * \5Cparam key       The encryption/decryption key.\0A *                  This must be \5Cc 32 Bytes in length.\0A * \5Cparam nonce     The nonce. This must be \5Cc 12 Bytes in size.\0A * \5Cparam counter   The initial counter value. This is usually \5Cc 0.\0A * \5Cparam size      The length of the input data in Bytes.\0A * \5Cparam input     The buffer holding the input data.\0A *                  This pointer can be \5Cc NULL if `size == 0`.\0A * \5Cparam output    The buffer holding the output data.\0A *                  This must be able to hold \5Cp size Bytes.\0A *                  This pointer can be \5Cc NULL if `size == 0`.\0A *\0A * \5Creturn          \5Cc 0 on success.\0A * \5Creturn          A negative error code on failure.\0A */\0Aint mbedtls_chacha20_crypt(const unsigned char key[32],\0A                           const unsigned char nonce[12],\0A                           uint32_t counter,\0A                           size_t size,\0A                           const unsigned char *input,\0A                           unsigned char *output);\0A\0A#if defined(MBEDTLS_SELF_TEST)\0A/**\0A * \5Cbrief           The ChaCha20 checkup routine.\0A *\0A * \5Creturn          \5Cc 0 on success.\0A * \5Creturn          \5Cc 1 on failure.\0A */\0Aint mbedtls_chacha20_self_test(int verbose);\0A#endif /* MBEDTLS_SELF_TEST */\0A\0A#ifdef __cplusplus\0A}\0A#endif\0A\0A#endif /* MBEDTLS_CHACHA20_H */\0A\00" }
