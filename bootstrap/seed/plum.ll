@.str39756 = private global { i64, i64, [18753 x i8] } { i64 -1, i64 18752, [18753 x i8] c"// Blocking reads from standard input, for the language server.\0A//\0A// The runtime can already WRITE (printf) and read whole FILES, but had\0A// no way to read stdin at all — which is what an LSP server does for a\0A// living.\0A//\0A// **The buffers are owned HERE**, reused across calls and valid until\0A// the next call to the same function. The obvious alternative — malloc\0A// and hand ownership to the caller — does not work portably: the real\0A// compiler materializes an extern's `CStr` RETURN as a Plum string, so\0A// the pointer cannot be handed back to a `free`-shaped extern, and\0A// Plum has no `free` of its own. Caller-owned buffers would therefore\0A// leak one allocation per message in a process designed to run for\0A// hours.\0A//\0A// Not thread-safe, and does not need to be: a language server reads its\0A// requests on one thread, in order.\0A//\0A// Deliberately blocking and synchronous. A language server is a request\0A// loop: read one message, answer it, read the next. Nothing here needs\0A// to be asynchronous, and pretending otherwise would mean inventing a\0A// concurrency story for a problem that does not have one.\0A\0A#include <stdio.h>\0A#include <stdlib.h>\0A#include <string.h>\0A#include <limits.h>\0A\0Astatic char *line_buf = NULL;\0Astatic size_t line_cap = 0;\0Astatic char *body_buf = NULL;\0Astatic size_t body_cap = 0;\0A\0Astatic int ensure(char **buf, size_t *cap, size_t need) {\0A    if (*cap >= need) return 1;\0A    size_t next = *cap ? *cap : 256;\0A    while (next < need) next *= 2;\0A    char *bigger = (char *)realloc(*buf, next);\0A    if (!bigger) return 0;\0A    *buf = bigger;\0A    *cap = next;\0A    return 1;\0A}\0A\0A// One line, without its newline. Returns \22\22 at EOF — which is how the\0A// server learns its client has gone away, since it cannot distinguish a\0A// null pointer from an empty string once the value crosses into Plum.\0Aconst char *stdin_read_line(void) {\0A    size_t len = 0;\0A    if (!ensure(&line_buf, &line_cap, 256)) return \22\22;\0A    for (;;) {\0A        int c = fgetc(stdin);\0A        if (c == EOF) break;\0A        if (c == '\5Cn') break;\0A        if (!ensure(&line_buf, &line_cap, len + 2)) return \22\22;\0A        line_buf[len++] = (char)c;\0A    }\0A    // LSP framing is CRLF; the caller only ever wants the content.\0A    if (len > 0 && line_buf[len - 1] == '\5Cr') len--;\0A    line_buf[len] = '\5C0';\0A    return line_buf;\0A}\0A\0A// Exactly `n` bytes, or \22\22 if the stream ended early. An LSP message\0A// body is length-prefixed, so a short read is a protocol error rather\0A// than something to paper over.\0Aconst char *stdin_read_n(long long n) {\0A    if (n < 0) return \22\22;\0A    if (!ensure(&body_buf, &body_cap, (size_t)n + 1)) return \22\22;\0A    size_t got = fread(body_buf, 1, (size_t)n, stdin);\0A    if (got != (size_t)n) return \22\22;\0A    body_buf[n] = '\5C0';\0A    return body_buf;\0A}\0A\0A// Writes without a trailing newline, which `println` cannot do and an\0A// LSP header needs.\0Avoid stdout_write(const char *s) { fputs(s, stdout); }\0A\0A// stdout is a pipe here, not a terminal, so it is block-buffered: a\0A// response written but not flushed leaves the client waiting forever\0A// while the server waits for the next request. The one deadlock this\0A// design can produce, and the one line that prevents it.\0Avoid stdout_flush(void) { fflush(stdout); }\0A\0A// The shadow call stack, for a stack trace on a runtime failure.\0A//\0A// Pushed on entry and popped on the way out, by code the compiler emits\0A// only when `--trace` is passed. Without it nothing calls these, the\0A// depth stays zero, and `plum_trace` prints nothing.\0A//\0A// Why this instead of a real unwinder: `backtrace()` is glibc and\0A// macOS, `_Unwind_Backtrace` needs a library on musl, and Windows has\0A// its own API -- three implementations, two of which CI can only\0A// cross-compile and never run. This is one implementation for every\0A// target, and it prints the names the compiler already knows rather\0A// than mangled symbols an unwinder would hand back to be decoded.\0A//\0A// It lives in C rather than in emitted IR because the trace goes to\0A// STDERR, and naming `stderr` portably from LLVM text is not possible:\0A// it is `stderr` on glibc and musl and `__stderrp` on macOS. Here the C\0A// compiler knows which. Stderr and not stdout because the panic MESSAGE\0A// goes to stdout, where `bootstrap/abort_corpus` compares it byte for\0A// byte; a trace that varies with the build must stay out of that.\0A//\0A// --- Where the pop goes, and why it is not in the epilogue ---\0A//\0A// These two functions look symmetric, and the PLACEMENT of the pop is\0A// what made this hard. Popping once before a function's `ret` -- the\0A// obvious design -- puts a side-effecting call between a tail-recursive\0A// call and the return of its value, so the optimiser cannot rewrite the\0A// recursion as a loop. Measured, not reasoned about: three million\0A// deep, fine without tracing, segfault with.\0A//\0A// The compiler instead pays the pop PER PATH, and a self-call in tail\0A// position pops BEFORE calling (see `cg_expr_t` in\0A// `bootstrap/self_host/codegen/codegen.plum`). Nothing then sits\0A// between the call and the `ret`, tail recursion runs in constant stack\0A// space under `--trace`, and the depth still balances: LLVM's\0A// tail-recursion elimination hoists only allocas into its new entry\0A// block, so the push rides inside the loop with the pop.\0A//\0A// A consequence visible from in here: a tail-recursive chain leaves ONE\0A// frame, not one per iteration, because a tail call really does replace\0A// its caller's frame. Two earlier designs that tried to detect that by\0A// STACK ADDRESS instead both failed -- an `alloca` handed out escapes\0A// and blocks the same optimisation, and `__builtin_frame_address(1)`\0A// does not order by call depth (a four-deep chain reported 2b0, 2a0,\0A// 2a0, 2b0). DESIGN.md has both in full, under \22Stack traces, and\0A// the thing they cost\22.\0A#include <stdio.h>\0A\0A#define PLUM_TRACE_CAP 256\0A\0Astatic const char *plum_frame_names[PLUM_TRACE_CAP];\0Astatic long long plum_depth = 0;\0A\0Avoid plum_frame_push(const char *name) {\0A    if (plum_depth >= 0 && plum_depth < PLUM_TRACE_CAP) {\0A        plum_frame_names[plum_depth] = name;\0A    }\0A    // Counted past the end on purpose: a runaway recursion must not\0A    // overflow this array, and the count is what lets a trace say how\0A    // many frames it is not showing.\0A    plum_depth++;\0A}\0A\0Avoid plum_frame_pop(void) {\0A    if (plum_depth > 0) plum_depth--;\0A}\0A\0A// Innermost first, which is the order a reader scans: the frame the\0A// failure happened in is the one they are looking for.\0Avoid plum_trace(void) {\0A    if (plum_depth <= 0) return;\0A    long long shown = plum_depth < PLUM_TRACE_CAP ? plum_depth : PLUM_TRACE_CAP;\0A    fprintf(stderr, \22stack trace:\5Cn\22);\0A    for (long long i = shown - 1; i >= 0; i--) {\0A        fprintf(stderr, \22  at %s\5Cn\22, plum_frame_names[i] ? plum_frame_names[i] : \22?\22);\0A    }\0A    if (plum_depth > shown) {\0A        fprintf(stderr, \22  ... %lld more frames\5Cn\22, plum_depth - shown);\0A    }\0A}\0A\0A// --- A public stdin, and stderr (issue #17, timeouts in #7) ---\0A//\0A// Added ALONGSIDE `stdin_read_line`/`stdin_read_n` rather than changing\0A// them: those are called by the language server in this same binary, and\0A// MAINTENANCE.md's rule is not to change the arity of a shim the\0A// compiler still calls.\0A//\0A// The reason for new ones is a contract the old pair cannot express.\0A// `stdin_read_line` returns \22\22 at end of stream AND for an empty line,\0A// so a filter reading until EOF cannot tell \22the input ended\22 from \22the\0A// input contained a blank line\22 -- and a program that stops at the first\0A// blank line is wrong in a way that only shows up on real data.\0A// `stdin_read_n` has the mirror problem: it returns \22\22 on a short read,\0A// discarding however many bytes it did get.\0A//\0A// Both new functions return a COUNT and leave the bytes in a buffer the\0A// caller reads separately, the same split `tcp_recv_n`/`tcp_recv_data`\0A// and `file_read_n`/`file_read_data` use, and for the same reason: a\0A// `CStr` return cannot carry a length.\0A//\0A// --- ONE reader, and why stdio could not stay ---\0A//\0A// These four functions and their timed counterparts share a single\0A// buffer, filled by raw `read`/`ReadFile`. They used to use `fgetc` and\0A// `fread`, and that had to go the moment a TIMED read existed:\0A//\0A// `poll` asks the KERNEL whether bytes are available. It knows nothing\0A// about bytes stdio has already pulled into its own buffer. A timed read\0A// layered over stdio therefore reports \22nothing there, timed out\22 while\0A// a complete line sits in the stdio buffer -- not a Windows quirk, a\0A// silent wrong answer everywhere. Two readers over one file descriptor\0A// cannot both be right, so there is one.\0A//\0A// The language server's own `stdin_read_line`/`stdin_read_n` above still\0A// use stdio. They are a different consumer in the same binary and never\0A// mix with these, because the language server does not do timed reads --\0A// but MIXING THEM WOULD LOSE BYTES, and that is the reason to leave them\0A// alone rather than the reason not to worry.\0A//\0A// --- What a timeout bounds ---\0A//\0A// The WHOLE CALL, not just the wait for the first byte. `poll` returning\0A// readable means A byte is available, not a line, so a slow writer can\0A// leave a reader blocked mid-line long past its deadline -- which would\0A// pass every test written against a terminal, where a line arrives all\0A// at once, and fail against a pipe.\0A//\0A// That is only safe because a partial line SURVIVES the timeout. Bytes\0A// already read stay in the buffer and the next call continues where this\0A// one stopped, so a timeout is never data loss. A design that discarded\0A// them would be worse than the blocking one it replaced.\0A\0A#include <stdlib.h>\0A#include <string.h>\0A\0A#if defined(_WIN32)\0A#include <windows.h>\0A#else\0A#include <poll.h>\0A#include <unistd.h>\0A#include <errno.h>\0A#include <time.h>\0A#endif\0A\0A#define PLUM_STDIN_TIMED_OUT (-2)\0A\0Astatic unsigned char *plum_in_buf = NULL;   // unconsumed bytes\0Astatic size_t plum_in_cap = 0;\0Astatic size_t plum_in_len = 0;\0Astatic int plum_in_eof = 0;\0A\0Astatic char *plum_out_buf = NULL;           // the line/bytes just handed out\0Astatic size_t plum_out_cap = 0;\0Astatic long long plum_out_len = 0;\0A\0Astatic int plum_grow(unsigned char **buf, size_t *cap, size_t need) {\0A    if (*cap >= need) return 1;\0A    size_t next = *cap ? *cap : 1024;\0A    while (next < need) next *= 2;\0A    unsigned char *bigger = (unsigned char *)realloc(*buf, next);\0A    if (!bigger) return 0;\0A    *buf = bigger;\0A    *cap = next;\0A    return 1;\0A}\0A\0A// Hands `n` bytes from the front of the buffer to the caller, and drops\0A// them from it. The copy is what lets the returned pointer stay valid\0A// while the buffer keeps being refilled.\0Astatic long long plum_in_take(size_t n, size_t drop) {\0A    if (!plum_grow((unsigned char **)&plum_out_buf, &plum_out_cap, n + 1)) return -1;\0A    memcpy(plum_out_buf, plum_in_buf, n);\0A    plum_out_buf[n] = '\5C0';\0A    memmove(plum_in_buf, plum_in_buf + drop, plum_in_len - drop);\0A    plum_in_len -= drop;\0A    plum_out_len = (long long)n;\0A    return (long long)n;\0A}\0A\0A// Milliseconds left until `deadline_ns`, or -1 for \22no deadline\22.\0A// `now_ns` is only read when there is a deadline to compare against.\0A#if !defined(_WIN32)\0Astatic long long plum_now_ns(void) {\0A    struct timespec ts;\0A    if (clock_gettime(CLOCK_MONOTONIC, &ts) != 0) return 0;\0A    return (long long)ts.tv_sec * 1000000000LL + (long long)ts.tv_nsec;\0A}\0A#else\0Astatic long long plum_now_ns(void) {\0A    LARGE_INTEGER freq, ticks;\0A    if (!QueryPerformanceFrequency(&freq) || freq.QuadPart == 0) return 0;\0A    QueryPerformanceCounter(&ticks);\0A    long long secs = (long long)(ticks.QuadPart / freq.QuadPart);\0A    long long rem = (long long)(ticks.QuadPart % freq.QuadPart);\0A    return secs * 1000000000LL + (rem * 1000000000LL) / (long long)freq.QuadPart;\0A}\0A#endif\0A\0A// Only negative durations mean \22forever\22. Saturate large finite waits\0A// instead of overflowing into that sentinel (issue #224).\0Astatic long long plum_stdin_deadline(long long timeout_nanos) {\0A    if (timeout_nanos < 0) return -1;\0A    long long now = plum_now_ns();\0A    return timeout_nanos > LLONG_MAX - now ? LLONG_MAX : now + timeout_nanos;\0A}\0A\0A// Reads once into the buffer, waiting no longer than `deadline_ns`\0A// (negative means wait as long as it takes). Returns 1 if bytes were\0A// added, 0 on end of stream, PLUM_STDIN_TIMED_OUT if the deadline\0A// passed first, -1 on error.\0Astatic int plum_in_fill(long long deadline_ns) {\0A    if (plum_in_eof) return 0;\0A    if (!plum_grow(&plum_in_buf, &plum_in_cap, plum_in_len + 4096)) return -1;\0A\0A#if defined(_WIN32)\0A    HANDLE h = GetStdHandle(STD_INPUT_HANDLE);\0A    if (h == INVALID_HANDLE_VALUE || h == NULL) return -1;\0A    DWORD type = GetFileType(h);\0A    for (;;) {\0A        // A file redirected into stdin is always ready; there is nothing\0A        // to wait for and no way to block.\0A        if (type == FILE_TYPE_DISK) break;\0A        if (type == FILE_TYPE_PIPE) {\0A            DWORD avail = 0;\0A            if (!PeekNamedPipe(h, NULL, 0, NULL, &avail, NULL)) {\0A                // A closed pipe peeks as an error, which is end of\0A                // stream rather than a failure.\0A                plum_in_eof = 1;\0A                return 0;\0A            }\0A            if (avail > 0) break;\0A        } else {\0A            // Console. `WaitForSingleObject` signals for any input\0A            // record -- a key release, a mouse move, a focus change --\0A            // so a wake is not proof that a byte is readable, and the\0A            // loop re-checks rather than trusting it.\0A            DWORD w = WaitForSingleObject(h, 0);\0A            if (w == WAIT_OBJECT_0) break;\0A        }\0A        if (deadline_ns >= 0 && plum_now_ns() >= deadline_ns) return PLUM_STDIN_TIMED_OUT;\0A        Sleep(5);\0A    }\0A    DWORD got = 0;\0A    if (!ReadFile(h, plum_in_buf + plum_in_len, 4096, &got, NULL) || got == 0) {\0A        plum_in_eof = 1;\0A        return 0;\0A    }\0A    plum_in_len += (size_t)got;\0A    return 1;\0A#else\0A    for (;;) {\0A        struct pollfd pfd;\0A        pfd.fd = 0;\0A        pfd.events = POLLIN;\0A        pfd.revents = 0;\0A        int ms = -1;\0A        if (deadline_ns >= 0) {\0A            long long left = deadline_ns - plum_now_ns();\0A            if (left <= 0) return PLUM_STDIN_TIMED_OUT;\0A            long long lms = left / 1000000LL;\0A            if (left % 1000000LL != 0) lms++;\0A            ms = lms > 2147483647LL ? 2147483647 : (int)lms;\0A        }\0A        int r = poll(&pfd, 1, ms);\0A        if (r < 0) {\0A            if (errno == EINTR) continue;\0A            return -1;\0A        }\0A        if (r == 0) return PLUM_STDIN_TIMED_OUT;\0A        break;\0A    }\0A    ssize_t got = read(0, plum_in_buf + plum_in_len, 4096);\0A    if (got < 0) {\0A        if (errno == EINTR) return 1; // nothing added; the caller loops\0A        return -1;\0A    }\0A    if (got == 0) {\0A        plum_in_eof = 1;\0A        return 0;\0A    }\0A    plum_in_len += (size_t)got;\0A    return 1;\0A#endif\0A}\0A\0A// The index of the first newline in the buffer, or -1.\0Astatic long long plum_in_find_nl(void) {\0A    for (size_t i = 0; i < plum_in_len; i++) {\0A        if (plum_in_buf[i] == '\5Cn') return (long long)i;\0A    }\0A    return -1;\0A}\0A\0A// Shared by the timed and untimed line reads. `deadline_ns` negative\0A// means block.\0Astatic long long plum_line_until(long long deadline_ns) {\0A    for (;;) {\0A        long long nl = plum_in_find_nl();\0A        if (nl >= 0) {\0A            size_t len = (size_t)nl;\0A            // LSP framing is CRLF; a caller only ever wants the content.\0A            if (len > 0 && plum_in_buf[len - 1] == '\5Cr') len--;\0A            return plum_in_take(len, (size_t)nl + 1);\0A        }\0A        if (plum_in_eof) {\0A            // End of stream with bytes still held is a final line\0A            // without a trailing newline, which is an ordinary line and\0A            // must not be thrown away.\0A            if (plum_in_len > 0) {\0A                size_t len = plum_in_len;\0A                if (len > 0 && plum_in_buf[len - 1] == '\5Cr') len--;\0A                return plum_in_take(len, plum_in_len);\0A            }\0A            return -1;\0A        }\0A        int r = plum_in_fill(deadline_ns);\0A        if (r == PLUM_STDIN_TIMED_OUT) return PLUM_STDIN_TIMED_OUT;\0A        if (r < 0) return -1;\0A        // r == 0 sets `plum_in_eof`; the next turn of the loop handles it.\0A    }\0A}\0A\0Astatic long long plum_bytes_until(long long max, long long deadline_ns) {\0A    // A nonpositive request is an empty result even at EOF. Do not fill\0A    // or take: either would allocate, and filling could wait or consume\0A    // input. Clear only the previous result, preserving pending input.\0A    if (max <= 0) {\0A        plum_out_len = 0;\0A        if (plum_out_buf) plum_out_buf[0] = '\5C0';\0A        return 0;\0A    }\0A    while (plum_in_len == 0 && !plum_in_eof) {\0A        int r = plum_in_fill(deadline_ns);\0A        if (r == PLUM_STDIN_TIMED_OUT) return PLUM_STDIN_TIMED_OUT;\0A        if (r < 0) return -1;\0A    }\0A    // End of stream with nothing buffered is -1 here, so the TIMED\0A    // caller can report it as a distinct outcome. `stdin_bytes_n` maps\0A    // it back to 0, which is the contract its callers already have.\0A    if (plum_in_eof && plum_in_len == 0) return -1;\0A    size_t n = plum_in_len < (size_t)max ? plum_in_len : (size_t)max;\0A    return plum_in_take(n, n);\0A}\0A\0A// The line just read, without its newline. Returns the byte count, or\0A// -1 at end of stream -- which is the distinction the whole pair exists\0A// for. An empty line is 0, and that is not the same answer.\0Along long stdin_line_n(void) { return plum_line_until(-1); }\0A\0Aconst char *stdin_line_data(void) { return plum_out_buf ? plum_out_buf : \22\22; }\0A\0A// Up to `max` bytes. Returns how many were actually read: 0 at end of\0A// stream, and a SHORT COUNT is data, not a failure -- a pipe hands over\0A// what it has.\0Along long stdin_bytes_n(long long max) {\0A    long long r = plum_bytes_until(max, -1);\0A    if (r == PLUM_STDIN_TIMED_OUT) return 0;\0A    return r < 0 ? 0 : r;\0A}\0A\0Aconst char *stdin_bytes_data(void) { return plum_out_buf ? plum_out_buf : \22\22; }\0A\0A// The timed counterparts. `-2` is \22the deadline passed\22, which is a\0A// third outcome neither of the two above has room to report -- they\0A// spend their sentinel on end of stream.\0A//\0A// A timeout leaves everything already read IN THE BUFFER, so the next\0A// call resumes mid-line rather than starting over. That is what makes\0A// bounding the whole call safe.\0Along long stdin_line_timed(long long timeout_nanos) {\0A    return plum_line_until(plum_stdin_deadline(timeout_nanos));\0A}\0A\0Along long stdin_bytes_timed(long long max, long long timeout_nanos) {\0A    return plum_bytes_until(max, plum_stdin_deadline(timeout_nanos));\0A}\0A\0A// Unbuffered by convention: stderr is where a program says something is\0A// wrong, and a message lost in a buffer at exit is the one that mattered.\0Avoid stderr_write(const char *s) {\0A    fputs(s, stderr);\0A    fflush(stderr);\0A}\0A\00" }
