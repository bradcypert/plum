@.str39519 = private global { i64, i64, [20866 x i8] } { i64 -1, i64 20865, [20866 x i8] c"/**\0A *  Modular bignum functions\0A *\0A * This module implements operations on integers modulo some fixed modulus.\0A *\0A * The functions in this module obey the following conventions unless\0A * explicitly indicated otherwise:\0A *\0A * - **Modulus parameters**: the modulus is passed as a pointer to a structure\0A *   of type #mbedtls_mpi_mod_modulus. The structure must be set up with an\0A *   array of limbs storing the bignum value of the modulus. The modulus must\0A *   be odd and is assumed to have no leading zeroes. The modulus is usually\0A *   named \5Cc N and is usually input-only. Functions which take a parameter\0A *   of type \5Cc const #mbedtls_mpi_mod_modulus* must not modify its value.\0A * - **Bignum parameters**: Bignums are passed as pointers to an array of\0A *   limbs or to a #mbedtls_mpi_mod_residue structure. A limb has the type\0A *   #mbedtls_mpi_uint. Residues must be initialized before use, and must be\0A *   associated with the modulus \5Cc N. Unless otherwise specified:\0A *     - Bignum parameters called \5Cc A, \5Cc B, ... are inputs and are not\0A *       modified by the function. Functions which take a parameter of\0A *       type \5Cc const #mbedtls_mpi_mod_residue* must not modify its value.\0A *     - Bignum parameters called \5Cc X, \5Cc Y, ... are outputs or input-output.\0A *       The initial bignum value of output-only parameters is ignored, but\0A *       they must be set up and associated with the modulus \5Cc N. Some\0A *       functions (typically constant-flow) require that the limbs in an\0A *       output residue are initialized.\0A *     - Bignum parameters called \5Cc p are inputs used to set up a modulus or\0A *       residue. These must be pointers to an array of limbs.\0A *     - \5Cc T is a temporary storage area. The initial content of such a\0A *       parameter is ignored and the final content is unspecified.\0A *     - Some functions use different names, such as \5Cc r for the residue.\0A * - **Bignum sizes**: bignum sizes are always expressed in limbs. Both\0A *   #mbedtls_mpi_mod_modulus and #mbedtls_mpi_mod_residue have a \5Cc limbs\0A *   member storing its size. All bignum parameters must have the same\0A *   number of limbs as the modulus. All bignum sizes must be at least 1 and\0A *   must be significantly less than #SIZE_MAX. The behavior if a size is 0 is\0A *   undefined.\0A * - **Bignum representation**: the representation of inputs and outputs is\0A *   specified by the \5Cc int_rep field of the modulus.\0A * - **Parameter ordering**: for bignum parameters, outputs come before inputs.\0A *   The modulus is passed after residues. Temporaries come last.\0A * - **Aliasing**: in general, output bignums may be aliased to one or more\0A *   inputs. Modulus values may not be aliased to any other parameter. Outputs\0A *   may not be aliased to one another. Temporaries may not be aliased to any\0A *   other parameter.\0A * - **Overlap**: apart from aliasing of residue pointers (where two residue\0A *   arguments are equal pointers), overlap is not supported and may result\0A *   in undefined behavior.\0A * - **Error handling**: functions generally check compatibility of input\0A *   sizes. Most functions will not check that input values are in canonical\0A *   form (i.e. that \5Cc A < \5Cc N), this is only checked during setup of a\0A *   residue structure.\0A * - **Modular representatives**: all functions expect inputs to be in the\0A *   range [0, \5Cc N - 1] and guarantee outputs in the range [0, \5Cc N - 1].\0A *   Residues are set up with an associated modulus, and operations are only\0A *   guaranteed to work if the modulus is associated with all residue\0A *   parameters. If a residue is passed with a modulus other than the one it\0A *   is associated with, then it may be out of range. If an input is out of\0A *   range, outputs are fully unspecified, though bignum values out of range\0A *   should not cause buffer overflows (beware that this is not extensively\0A *   tested).\0A */\0A\0A/*\0A *  Copyright The Mbed TLS Contributors\0A *  SPDX-License-Identifier: Apache-2.0 OR GPL-2.0-or-later\0A */\0A\0A#ifndef MBEDTLS_BIGNUM_MOD_H\0A#define MBEDTLS_BIGNUM_MOD_H\0A\0A#include \22common.h\22\0A\0A#if defined(MBEDTLS_BIGNUM_C)\0A#include \22mbedtls/bignum.h\22\0A#endif\0A\0A/** How residues associated with a modulus are represented.\0A *\0A * This also determines which fields of the modulus structure are valid and\0A * what their contents are (see #mbedtls_mpi_mod_modulus).\0A */\0Atypedef enum {\0A    /** Representation not chosen (makes the modulus structure invalid). */\0A    MBEDTLS_MPI_MOD_REP_INVALID    = 0,\0A    /* Skip 1 as it is slightly easier to accidentally pass to functions. */\0A    /** Montgomery representation. */\0A    MBEDTLS_MPI_MOD_REP_MONTGOMERY = 2,\0A    /* Optimised reduction available. This indicates a coordinate modulus (P)\0A     * and one or more of the following have been configured:\0A     * - A nist curve (MBEDTLS_ECP_DP_SECPXXXR1_ENABLED) & MBEDTLS_ECP_NIST_OPTIM.\0A     * - A Kobliz Curve.\0A     * - A Fast Reduction Curve CURVE25519 or CURVE448. */\0A    MBEDTLS_MPI_MOD_REP_OPT_RED,\0A} mbedtls_mpi_mod_rep_selector;\0A\0A/* Make mbedtls_mpi_mod_rep_selector and mbedtls_mpi_mod_ext_rep disjoint to\0A * make it easier to catch when they are accidentally swapped. */\0Atypedef enum {\0A    MBEDTLS_MPI_MOD_EXT_REP_INVALID = 0,\0A    MBEDTLS_MPI_MOD_EXT_REP_LE      = 8,\0A    MBEDTLS_MPI_MOD_EXT_REP_BE\0A} mbedtls_mpi_mod_ext_rep;\0A\0Atypedef struct {\0A    mbedtls_mpi_uint *p;\0A    size_t limbs;\0A} mbedtls_mpi_mod_residue;\0A\0Atypedef struct {\0A    mbedtls_mpi_uint const *rr;  /* The residue for 2^{2*n*biL} mod N */\0A    mbedtls_mpi_uint mm;         /* Montgomery const for -N^{-1} mod 2^{ciL} */\0A} mbedtls_mpi_mont_struct;\0A\0Atypedef int (*mbedtls_mpi_modp_fn)(mbedtls_mpi_uint *X, size_t X_limbs);\0A\0Atypedef struct {\0A    mbedtls_mpi_modp_fn modp;    /* The optimised reduction function pointer */\0A} mbedtls_mpi_opt_red_struct;\0A\0Atypedef struct {\0A    const mbedtls_mpi_uint *p;\0A    size_t limbs;                            // number of limbs\0A    size_t bits;                             // bitlen of p\0A    mbedtls_mpi_mod_rep_selector int_rep;    // selector to signal the active member of the union\0A    union rep {\0A        /* if int_rep == #MBEDTLS_MPI_MOD_REP_MONTGOMERY */\0A        mbedtls_mpi_mont_struct mont;\0A        /* if int_rep == #MBEDTLS_MPI_MOD_REP_OPT_RED */\0A        mbedtls_mpi_opt_red_struct ored;\0A    } rep;\0A} mbedtls_mpi_mod_modulus;\0A\0A/** Setup a residue structure.\0A *\0A * The residue will be set up with the buffer \5Cp p and modulus \5Cp N.\0A *\0A * The memory pointed to by \5Cp p will be used by the resulting residue structure.\0A * The value at the pointed-to memory will be the initial value of \5Cp r and must\0A * hold a value that is less than the modulus. This value will be used as-is\0A * and interpreted according to the value of the `N->int_rep` field.\0A *\0A * The modulus \5Cp N will be the modulus associated with \5Cp r. The residue \5Cp r\0A * should only be used in operations where the modulus is \5Cp N.\0A *\0A * \5Cparam[out] r    The address of the residue to setup.\0A * \5Cparam[in] N     The address of the modulus related to \5Cp r.\0A * \5Cparam[in] p     The address of the limb array containing the value of \5Cp r.\0A *                  The memory pointed to by \5Cp p will be used by \5Cp r and must\0A *                  not be modified in any way until after\0A *                  mbedtls_mpi_mod_residue_release() is called. The data\0A *                  pointed to by \5Cp p must be less than the modulus (the value\0A *                  pointed to by `N->p`) and already in the representation\0A *                  indicated by `N->int_rep`.\0A * \5Cparam p_limbs   The number of limbs of \5Cp p. Must be the same as the number\0A *                  of limbs in the modulus \5Cp N.\0A *\0A * \5Creturn      \5Cc 0 if successful.\0A * \5Creturn      #MBEDTLS_ERR_MPI_BAD_INPUT_DATA if \5Cp p_limbs is less than the\0A *              limbs in \5Cp N or if \5Cp p is not less than \5Cp N.\0A */\0Aint mbedtls_mpi_mod_residue_setup(mbedtls_mpi_mod_residue *r,\0A                                  const mbedtls_mpi_mod_modulus *N,\0A                                  mbedtls_mpi_uint *p,\0A                                  size_t p_limbs);\0A\0A/** Unbind elements of a residue structure.\0A *\0A * This function removes the reference to the limb array that was passed to\0A * mbedtls_mpi_mod_residue_setup() to make it safe to free or use again.\0A *\0A * This function invalidates \5Cp r and it must not be used until after\0A * mbedtls_mpi_mod_residue_setup() is called on it again.\0A *\0A * \5Cparam[out] r     The address of residue to release.\0A */\0Avoid mbedtls_mpi_mod_residue_release(mbedtls_mpi_mod_residue *r);\0A\0A/** Initialize a modulus structure.\0A *\0A * \5Cparam[out] N     The address of the modulus structure to initialize.\0A */\0Avoid mbedtls_mpi_mod_modulus_init(mbedtls_mpi_mod_modulus *N);\0A\0A/** Setup a modulus structure.\0A *\0A * \5Cparam[out] N    The address of the modulus structure to populate.\0A * \5Cparam[in] p     The address of the limb array storing the value of \5Cp N.\0A *                  The memory pointed to by \5Cp p will be used by \5Cp N and must\0A *                  not be modified in any way until after\0A *                  mbedtls_mpi_mod_modulus_free() is called.\0A * \5Cparam p_limbs   The number of limbs of \5Cp p.\0A *\0A * \5Creturn      \5Cc 0 if successful.\0A */\0Aint mbedtls_mpi_mod_modulus_setup(mbedtls_mpi_mod_modulus *N,\0A                                  const mbedtls_mpi_uint *p,\0A                                  size_t p_limbs);\0A\0A/** Setup an optimised-reduction compatible modulus structure.\0A *\0A * \5Cparam[out] N    The address of the modulus structure to populate.\0A * \5Cparam[in] p     The address of the limb array storing the value of \5Cp N.\0A *                  The memory pointed to by \5Cp p will be used by \5Cp N and must\0A *                  not be modified in any way until after\0A *                  mbedtls_mpi_mod_modulus_free() is called.\0A * \5Cparam p_limbs   The number of limbs of \5Cp p.\0A * \5Cparam modp      A pointer to the optimised reduction function to use. \5Cp p.\0A *\0A * \5Creturn      \5Cc 0 if successful.\0A */\0Aint mbedtls_mpi_mod_optred_modulus_setup(mbedtls_mpi_mod_modulus *N,\0A                                         const mbedtls_mpi_uint *p,\0A                                         size_t p_limbs,\0A                                         mbedtls_mpi_modp_fn modp);\0A\0A/** Free elements of a modulus structure.\0A *\0A * This function frees any memory allocated by mbedtls_mpi_mod_modulus_setup().\0A *\0A * \5Cwarning This function does not free the limb array passed to\0A *          mbedtls_mpi_mod_modulus_setup() only removes the reference to it,\0A *          making it safe to free or to use it again.\0A *\0A * \5Cparam[in,out] N     The address of the modulus structure to free.\0A */\0Avoid mbedtls_mpi_mod_modulus_free(mbedtls_mpi_mod_modulus *N);\0A\0A/** \5Cbrief  Multiply two residues, returning the residue modulo the specified\0A *          modulus.\0A *\0A * \5Cnote Currently handles the case when `N->int_rep` is\0A * MBEDTLS_MPI_MOD_REP_MONTGOMERY.\0A *\0A * The size of the operation is determined by \5Cp N. \5Cp A, \5Cp B and \5Cp X must\0A * all be associated with the modulus \5Cp N and must all have the same number\0A * of limbs as \5Cp N.\0A *\0A * \5Cp X may be aliased to \5Cp A or \5Cp B, or even both, but may not overlap\0A * either otherwise. They may not alias \5Cp N (since they must be in canonical\0A * form, they cannot == \5Cp N).\0A *\0A * \5Cparam[out] X        The address of the result MPI. Must have the same\0A *                      number of limbs as \5Cp N.\0A *                      On successful completion, \5Cp X contains the result of\0A *                      the multiplication `A * B * R^-1` mod N where\0A *                      `R = 2^(biL * N->limbs)`.\0A * \5Cparam[in]  A        The address of the first MPI.\0A * \5Cparam[in]  B        The address of the second MPI.\0A * \5Cparam[in]  N        The address of the modulus. Used to perform a modulo\0A *                      operation on the result of the multiplication.\0A *\0A * \5Creturn      \5Cc 0 if successful.\0A * \5Creturn      #MBEDTLS_ERR_MPI_BAD_INPUT_DATA if all the parameters do not\0A *              have the same number of limbs or \5Cp N is invalid.\0A * \5Creturn      #MBEDTLS_ERR_MPI_ALLOC_FAILED on memory-allocation failure.\0A */\0Aint mbedtls_mpi_mod_mul(mbedtls_mpi_mod_residue *X,\0A                        const mbedtls_mpi_mod_residue *A,\0A                        const mbedtls_mpi_mod_residue *B,\0A                        const mbedtls_mpi_mod_modulus *N);\0A\0A/**\0A * \5Cbrief Perform a fixed-size modular subtraction.\0A *\0A * Calculate `A - B modulo N`.\0A *\0A * \5Cp A, \5Cp B and \5Cp X must all have the same number of limbs as \5Cp N.\0A *\0A * \5Cp X may be aliased to \5Cp A or \5Cp B, or even both, but may not overlap\0A * either otherwise.\0A *\0A * \5Cnote This function does not check that \5Cp A or \5Cp B are in canonical\0A *       form (that is, are < \5Cp N) - that will have been done by\0A *       mbedtls_mpi_mod_residue_setup().\0A *\0A * \5Cparam[out] X    The address of the result MPI. Must be initialized.\0A *                  Must have the same number of limbs as the modulus \5Cp N.\0A * \5Cparam[in]  A    The address of the first MPI.\0A * \5Cparam[in]  B    The address of the second MPI.\0A * \5Cparam[in]  N    The address of the modulus. Used to perform a modulo\0A *                  operation on the result of the subtraction.\0A *\0A * \5Creturn          \5Cc 0 if successful.\0A * \5Creturn          #MBEDTLS_ERR_MPI_BAD_INPUT_DATA if the given MPIs do not\0A *                  have the correct number of limbs.\0A */\0Aint mbedtls_mpi_mod_sub(mbedtls_mpi_mod_residue *X,\0A                        const mbedtls_mpi_mod_residue *A,\0A                        const mbedtls_mpi_mod_residue *B,\0A                        const mbedtls_mpi_mod_modulus *N);\0A\0A/**\0A * \5Cbrief Perform modular inversion of an MPI with respect to a modulus \5Cp N.\0A *\0A * \5Cp A and \5Cp X must be associated with the modulus \5Cp N and will therefore\0A * have the same number of limbs as \5Cp N.\0A *\0A * \5Cp X may be aliased to \5Cp A.\0A *\0A * \5Cwarning  Currently only supports prime moduli, but does not check for them.\0A *\0A * \5Cparam[out] X   The modular inverse of \5Cp A with respect to \5Cp N.\0A * \5Cparam[in] A    The number to calculate the modular inverse of.\0A *                 Must not be 0.\0A * \5Cparam[in] N    The modulus to use.\0A *\0A * \5Creturn         \5Cc 0 if successful.\0A * \5Creturn         #MBEDTLS_ERR_MPI_BAD_INPUT_DATA if \5Cp A and \5Cp N do not\0A *                 have the same number of limbs.\0A * \5Creturn         #MBEDTLS_ERR_MPI_BAD_INPUT_DATA if \5Cp A is zero.\0A * \5Creturn         #MBEDTLS_ERR_MPI_ALLOC_FAILED if couldn't allocate enough\0A *                 memory (needed for conversion to and from Mongtomery form\0A *                 when not in Montgomery form already, and for temporary use\0A *                 by the inversion calculation itself).\0A */\0A\0Aint mbedtls_mpi_mod_inv(mbedtls_mpi_mod_residue *X,\0A                        const mbedtls_mpi_mod_residue *A,\0A                        const mbedtls_mpi_mod_modulus *N);\0A/**\0A * \5Cbrief Perform a fixed-size modular addition.\0A *\0A * Calculate `A + B modulo N`.\0A *\0A * \5Cp A, \5Cp B and \5Cp X must all be associated with the modulus \5Cp N and must\0A * all have the same number of limbs as \5Cp N.\0A *\0A * \5Cp X may be aliased to \5Cp A or \5Cp B, or even both, but may not overlap\0A * either otherwise.\0A *\0A * \5Cnote This function does not check that \5Cp A or \5Cp B are in canonical\0A *       form (that is, are < \5Cp N) - that will have been done by\0A *       mbedtls_mpi_mod_residue_setup().\0A *\0A * \5Cparam[out] X    The address of the result residue. Must be initialized.\0A *                  Must have the same number of limbs as the modulus \5Cp N.\0A * \5Cparam[in]  A    The address of the first input residue.\0A * \5Cparam[in]  B    The address of the second input residue.\0A * \5Cparam[in]  N    The address of the modulus. Used to perform a modulo\0A *                  operation on the result of the addition.\0A *\0A * \5Creturn          \5Cc 0 if successful.\0A * \5Creturn          #MBEDTLS_ERR_MPI_BAD_INPUT_DATA if the given MPIs do not\0A *                  have the correct number of limbs.\0A */\0Aint mbedtls_mpi_mod_add(mbedtls_mpi_mod_residue *X,\0A                        const mbedtls_mpi_mod_residue *A,\0A                        const mbedtls_mpi_mod_residue *B,\0A                        const mbedtls_mpi_mod_modulus *N);\0A\0A/** Generate a random number uniformly in a range.\0A *\0A * This function generates a random number between \5Cp min inclusive and\0A * \5Cp N exclusive.\0A *\0A * The procedure complies with RFC 6979 §3.3 (deterministic ECDSA)\0A * when the RNG is a suitably parametrized instance of HMAC_DRBG\0A * and \5Cp min is \5Cc 1.\0A *\0A * \5Cnote           There are `N - min` possible outputs. The lower bound\0A *                 \5Cp min can be reached, but the upper bound \5Cp N cannot.\0A *\0A * \5Cparam X        The destination residue.\0A * \5Cparam min      The minimum value to return. It must be strictly smaller\0A *                 than \5Cb N.\0A * \5Cparam N        The modulus.\0A *                 This is the upper bound of the output range, exclusive.\0A * \5Cparam f_rng    The RNG function to use. This must not be \5Cc NULL.\0A * \5Cparam p_rng    The RNG parameter to be passed to \5Cp f_rng.\0A *\0A * \5Creturn         \5Cc 0 if successful.\0A * \5Creturn         #MBEDTLS_ERR_MPI_NOT_ACCEPTABLE if the implementation was\0A *                 unable to find a suitable value within a limited number\0A *                 of attempts. This has a negligible probability if \5Cp N\0A *                 is significantly larger than \5Cp min, which is the case\0A *                 for all usual cryptographic applications.\0A */\0Aint mbedtls_mpi_mod_random(mbedtls_mpi_mod_residue *X,\0A                           mbedtls_mpi_uint min,\0A                           const mbedtls_mpi_mod_modulus *N,\0A                           int (*f_rng)(void *, unsigned char *, size_t),\0A                           void *p_rng);\0A\0A/** Read a residue from a byte buffer.\0A *\0A * The residue will be automatically converted to the internal representation\0A * based on the value of the `N->int_rep` field.\0A *\0A * The modulus \5Cp N will be the modulus associated with \5Cp r. The residue \5Cp r\0A * should only be used in operations where the modulus is \5Cp N or a modulus\0A * equivalent to \5Cp N (in the sense that all their fields or memory pointed by\0A * their fields hold the same value).\0A *\0A * \5Cparam[out] r    The address of the residue. It must have exactly the same\0A *                  number of limbs as the modulus \5Cp N.\0A * \5Cparam[in] N     The address of the modulus.\0A * \5Cparam[in] buf   The input buffer to import from.\0A * \5Cparam buflen    The length in bytes of \5Cp buf.\0A * \5Cparam ext_rep   The endianness of the number in the input buffer.\0A *\0A * \5Creturn       \5Cc 0 if successful.\0A * \5Creturn       #MBEDTLS_ERR_MPI_BUFFER_TOO_SMALL if \5Cp r isn't\0A *               large enough to hold the value in \5Cp buf.\0A * \5Creturn       #MBEDTLS_ERR_MPI_BAD_INPUT_DATA if \5Cp ext_rep\0A *               is invalid or the value in the buffer is not less than \5Cp N.\0A */\0Aint mbedtls_mpi_mod_read(mbedtls_mpi_mod_residue *r,\0A                         const mbedtls_mpi_mod_modulus *N,\0A                         const unsigned char *buf,\0A                         size_t buflen,\0A                         mbedtls_mpi_mod_ext_rep ext_rep);\0A\0A/** Write a residue into a byte buffer.\0A *\0A * The modulus \5Cp N must be the modulus associated with \5Cp r (see\0A * mbedtls_mpi_mod_residue_setup() and mbedtls_mpi_mod_read()).\0A *\0A * The residue will be automatically converted from the internal representation\0A * based on the value of `N->int_rep` field.\0A *\0A * \5Cwarning     If the buffer is smaller than `N->bits`, the number of\0A *              leading zeroes is leaked through timing. If \5Cp r is\0A *              secret, the caller must ensure that \5Cp buflen is at least\0A *              (`N->bits`+7)/8.\0A *\0A * \5Cparam[in] r     The address of the residue. It must have the same number of\0A *                  limbs as the modulus \5Cp N. (\5Cp r is an input parameter, but\0A *                  its value will be modified during execution and restored\0A *                  before the function returns.)\0A * \5Cparam[in] N     The address of the modulus associated with \5Cp r.\0A * \5Cparam[out] buf  The output buffer to export to.\0A * \5Cparam buflen    The length in bytes of \5Cp buf.\0A * \5Cparam ext_rep   The endianness in which the number should be written into\0A *                  the output buffer.\0A *\0A * \5Creturn       \5Cc 0 if successful.\0A * \5Creturn       #MBEDTLS_ERR_MPI_BUFFER_TOO_SMALL if \5Cp buf isn't\0A *               large enough to hold the value of \5Cp r (without leading\0A *               zeroes).\0A * \5Creturn       #MBEDTLS_ERR_MPI_BAD_INPUT_DATA if \5Cp ext_rep is invalid.\0A * \5Creturn       #MBEDTLS_ERR_MPI_ALLOC_FAILED if couldn't allocate enough\0A *               memory for conversion. Can occur only for moduli with\0A *               MBEDTLS_MPI_MOD_REP_MONTGOMERY.\0A */\0Aint mbedtls_mpi_mod_write(const mbedtls_mpi_mod_residue *r,\0A                          const mbedtls_mpi_mod_modulus *N,\0A                          unsigned char *buf,\0A                          size_t buflen,\0A                          mbedtls_mpi_mod_ext_rep ext_rep);\0A\0A#endif /* MBEDTLS_BIGNUM_MOD_H */\0A\00" }
