 }\0A    memset(operation, 0, sizeof(psa_pake_operation_t));\0A\0A    return status;\0A}\0A#endif /* PSA_WANT_ALG_SOME_PAKE */\0A\0A/* Memory copying test hooks. These are called before input copy, after input\0A * copy, before output copy and after output copy, respectively.\0A * They are used by memory-poisoning tests to temporarily unpoison buffers\0A * while they are copied. */\0A#if defined(MBEDTLS_TEST_HOOKS)\0Avoid (*psa_input_pre_copy_hook)(const uint8_t *input, size_t input_len) = NULL;\0Avoid (*psa_input_post_copy_hook)(const uint8_t *input, size_t input_len) = NULL;\0Avoid (*psa_output_pre_copy_hook)(const uint8_t *output, size_t output_len) = NULL;\0Avoid (*psa_output_post_copy_hook)(const uint8_t *output, size_t output_len) = NULL;\0A#endif\0A\0A/** Copy from an input buffer to a local copy.\0A *\0A * \5Cparam[in] input             Pointer to input buffer.\0A * \5Cparam[in] input_len         Length of the input buffer.\0A * \5Cparam[out] input_copy       Pointer to a local copy in which to store the input data.\0A * \5Cparam[out] input_copy_len   Length of the local copy buffer.\0A * \5Creturn                      #PSA_SUCCESS, if the buffer was successfully\0A *                              copied.\0A * \5Creturn                      #PSA_ERROR_CORRUPTION_DETECTED, if the local\0A *                              copy is too small to hold contents of the\0A *                              input buffer.\0A */\0AMBEDTLS_STATIC_TESTABLE\0Apsa_status_t psa_crypto_copy_input(const uint8_t *input, size_t input_len,\0A                                   uint8_t *input_copy, size_t input_copy_len)\0A{\0A    if (input_len > input_copy_len) {\0A        return PSA_ERROR_CORRUPTION_DETECTED;\0A    }\0A\0A#if defined(MBEDTLS_TEST_HOOKS)\0A    if (psa_input_pre_copy_hook != NULL) {\0A        psa_input_pre_copy_hook(input, input_len);\0A    }\0A#endif\0A\0A    if (input_len > 0) {\0A        memcpy(input_copy, input, input_len);\0A    }\0A\0A#if defined(MBEDTLS_TEST_HOOKS