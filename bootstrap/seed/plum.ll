@.str41577 = private global { i64, i64, [28026 x i8] } { i64 -1, i64 28025, [28026 x i8] c"/**\0A * \5Cfile aes.h\0A *\0A * \5Cbrief   This file contains AES definitions and functions.\0A *\0A *          The Advanced Encryption Standard (AES) specifies a FIPS-approved\0A *          cryptographic algorithm that can be used to protect electronic\0A *          data.\0A *\0A *          The AES algorithm is a symmetric block cipher that can\0A *          encrypt and decrypt information. For more information, see\0A *          <em>FIPS Publication 197: Advanced Encryption Standard</em> and\0A *          <em>ISO/IEC 18033-2:2006: Information technology -- Security\0A *          techniques -- Encryption algorithms -- Part 2: Asymmetric\0A *          ciphers</em>.\0A *\0A *          The AES-XTS block mode is standardized by NIST SP 800-38E\0A *          <https://nvlpubs.nist.gov/nistpubs/legacy/sp/nistspecialpublication800-38e.pdf>\0A *          and described in detail by IEEE P1619\0A *          <https://ieeexplore.ieee.org/servlet/opac?punumber=4375278>.\0A */\0A\0A/*\0A *  Copyright The Mbed TLS Contributors\0A *  SPDX-License-Identifier: Apache-2.0 OR GPL-2.0-or-later\0A */\0A\0A#ifndef MBEDTLS_AES_H\0A#define MBEDTLS_AES_H\0A#include \22mbedtls/private_access.h\22\0A\0A#include \22mbedtls/build_info.h\22\0A#include \22mbedtls/platform_util.h\22\0A\0A#include <stddef.h>\0A#include <stdint.h>\0A\0A/* padlock.c and aesni.c rely on these values! */\0A#define MBEDTLS_AES_ENCRYPT     1 /**< AES encryption. */\0A#define MBEDTLS_AES_DECRYPT     0 /**< AES decryption. */\0A\0A/* Error codes in range 0x0020-0x0022 */\0A/** Invalid key length. */\0A#define MBEDTLS_ERR_AES_INVALID_KEY_LENGTH                -0x0020\0A/** Invalid data input length. */\0A#define MBEDTLS_ERR_AES_INVALID_INPUT_LENGTH              -0x0022\0A\0A/* Error codes in range 0x0021-0x0025 */\0A/** Invalid input data. */\0A#define MBEDTLS_ERR_AES_BAD_INPUT_DATA                    -0x0021\0A\0A#ifdef __cplusplus\0Aextern \22C\22 {\0A#endif\0A\0A#if !defined(MBEDTLS_AES_ALT)\0A// Regular implementation\0A//\0A\0A/**\0A * \5Cbrief The AES context-type definition.\0A */\0Atypedef struct mbedtls_aes_context {\0A    int MBEDTLS_PRIVATE(nr);                     /*!< The number of rounds. */\0A    size_t MBEDTLS_PRIVATE(rk_offset);           /*!< The offset in array elements to AES\0A                                                    round keys in the buffer. */\0A#if defined(MBEDTLS_AES_ONLY_128_BIT_KEY_LENGTH) && !defined(MBEDTLS_PADLOCK_C)\0A    uint32_t MBEDTLS_PRIVATE(buf)[44];           /*!< Aligned data buffer to hold\0A                                                    10 round keys for 128-bit case. */\0A#else\0A    uint32_t MBEDTLS_PRIVATE(buf)[68];           /*!< Unaligned data buffer. This buffer can\0A                                                    hold 32 extra Bytes, which can be used for\0A                                                    one of the following purposes:\0A                                                    <ul><li>Alignment if VIA padlock is\0A                                                    used.</li>\0A                                                    <li>Simplifying key expansion in the 256-bit\0A                                                    case by generating an extra round key.\0A                                                    </li></ul> */\0A#endif /* MBEDTLS_AES_ONLY_128_BIT_KEY_LENGTH && !MBEDTLS_PADLOCK_C */\0A}\0Ambedtls_aes_context;\0A\0A#if defined(MBEDTLS_CIPHER_MODE_XTS)\0A/**\0A * \5Cbrief The AES XTS context-type definition.\0A */\0Atypedef struct mbedtls_aes_xts_context {\0A    mbedtls_aes_context MBEDTLS_PRIVATE(crypt); /*!< The AES context to use for AES block\0A                                                   encryption or decryption. */\0A    mbedtls_aes_context MBEDTLS_PRIVATE(tweak); /*!< The AES context used for tweak\0A                                                   computation. */\0A} mbedtls_aes_xts_context;\0A#endif /* MBEDTLS_CIPHER_MODE_XTS */\0A\0A#else  /* MBEDTLS_AES_ALT */\0A#include \22aes_alt.h\22\0A#endif /* MBEDTLS_AES_ALT */\0A\0A/**\0A * \5Cbrief          This function initializes the specified AES context.\0A *\0A *                 It must be the first API called before using\0A *                 the context.\0A *\0A * \5Cparam ctx      The AES context to initialize. This must not be \5Cc NULL.\0A */\0Avoid mbedtls_aes_init(mbedtls_aes_context *ctx);\0A\0A/**\0A * \5Cbrief          This function releases and clears the specified AES context.\0A *\0A * \5Cparam ctx      The AES context to clear.\0A *                 If this is \5Cc NULL, this function does nothing.\0A *                 Otherwise, the context must have been at least initialized.\0A */\0Avoid mbedtls_aes_free(mbedtls_aes_context *ctx);\0A\0A#if defined(MBEDTLS_CIPHER_MODE_XTS)\0A/**\0A * \5Cbrief          This function initializes the specified AES XTS context.\0A *\0A *                 It must be the first API called before using\0A *                 the context.\0A *\0A * \5Cparam ctx      The AES XTS context to initialize. This must not be \5Cc NULL.\0A */\0Avoid mbedtls_aes_xts_init(mbedtls_aes_xts_context *ctx);\0A\0A/**\0A * \5Cbrief          This function releases and clears the specified AES XTS context.\0A *\0A * \5Cparam ctx      The AES XTS context to clear.\0A *                 If this is \5Cc NULL, this function does nothing.\0A *                 Otherwise, the context must have been at least initialized.\0A */\0Avoid mbedtls_aes_xts_free(mbedtls_aes_xts_context *ctx);\0A#endif /* MBEDTLS_CIPHER_MODE_XTS */\0A\0A/**\0A * \5Cbrief          This function sets the encryption key.\0A *\0A * \5Cparam ctx      The AES context to which the key should be bound.\0A *                 It must be initialized.\0A * \5Cparam key      The encryption key.\0A *                 This must be a readable buffer of size \5Cp keybits bits.\0A * \5Cparam keybits  The size of data passed in bits. Valid options are:\0A *                 <ul><li>128 bits</li>\0A *                 <li>192 bits</li>\0A *                 <li>256 bits</li></ul>\0A *\0A * \5Creturn         \5Cc 0 on success.\0A * \5Creturn         #MBEDTLS_ERR_AES_INVALID_KEY_LENGTH on failure.\0A */\0AMBEDTLS_CHECK_RETURN_TYPICAL\0Aint mbedtls_aes_setkey_enc(mbedtls_aes_context *ctx, const unsigned char *key,\0A                           unsigned int keybits);\0A\0A#if !defined(MBEDTLS_BLOCK_CIPHER_NO_DECRYPT)\0A/**\0A * \5Cbrief          This function sets the decryption key.\0A *\0A * \5Cparam ctx      The AES context to which the key should be bound.\0A *                 It must be initialized.\0A * \5Cparam key      The decryption key.\0A *                 This must be a readable buffer of size \5Cp keybits bits.\0A * \5Cparam keybits  The size of data passed. Valid options are:\0A *                 <ul><li>128 bits</li>\0A *                 <li>192 bits</li>\0A *                 <li>256 bits</li></ul>\0A *\0A * \5Creturn         \5Cc 0 on success.\0A * \5Creturn         #MBEDTLS_ERR_AES_INVALID_KEY_LENGTH on failure.\0A */\0AMBEDTLS_CHECK_RETURN_TYPICAL\0Aint mbedtls_aes_setkey_dec(mbedtls_aes_context *ctx, const unsigned char *key,\0A                           unsigned int keybits);\0A#endif /* !MBEDTLS_BLOCK_CIPHER_NO_DECRYPT */\0A\0A#if defined(MBEDTLS_CIPHER_MODE_XTS)\0A/**\0A * \5Cbrief          This function prepares an XTS context for encryption and\0A *                 sets the encryption key.\0A *\0A * \5Cparam ctx      The AES XTS context to which the key should be bound.\0A *                 It must be initialized.\0A * \5Cparam key      The encryption key. This is comprised of the XTS key1\0A *                 concatenated with the XTS key2.\0A *                 This must be a readable buffer of size \5Cp keybits bits.\0A * \5Cparam keybits  The size of \5Cp key passed in bits. Valid options are:\0A *                 <ul><li>256 bits (each of key1 and key2 is a 128-bit key)</li>\0A *                 <li>512 bits (each of key1 and key2 is a 256-bit key)</li></ul>\0A *\0A * \5Creturn         \5Cc 0 on success.\0A * \5Creturn         #MBEDTLS_ERR_AES_INVALID_KEY_LENGTH on failure.\0A */\0AMBEDTLS_CHECK_RETURN_TYPICAL\0Aint mbedtls_aes_xts_setkey_enc(mbedtls_aes_xts_context *ctx,\0A                               const unsigned char *key,\0A                               unsigned int keybits);\0A\0A/**\0A * \5Cbrief          This function prepares an XTS context for decryption and\0A *                 sets the decryption key.\0A *\0A * \5Cparam ctx      The AES XTS context to which the key should be bound.\0A *                 It must be initialized.\0A * \5Cparam key      The decryption key. This is comprised of the XTS key1\0A *                 concatenated with the XTS key2.\0A *                 This must be a readable buffer of size \5Cp keybits bits.\0A * \5Cparam keybits  The size of \5Cp key passed in bits. Valid options are:\0A *                 <ul><li>256 bits (each of key1 and key2 is a 128-bit key)</li>\0A *                 <li>512 bits (each of key1 and key2 is a 256-bit key)</li></ul>\0A *\0A * \5Creturn         \5Cc 0 on success.\0A * \5Creturn         #MBEDTLS_ERR_AES_INVALID_KEY_LENGTH on failure.\0A */\0AMBEDTLS_CHECK_RETURN_TYPICAL\0Aint mbedtls_aes_xts_setkey_dec(mbedtls_aes_xts_context *ctx,\0A                               const unsigned char *key,\0A                               unsigned int keybits);\0A#endif /* MBEDTLS_CIPHER_MODE_XTS */\0A\0A/**\0A * \5Cbrief          This function performs an AES single-block encryption or\0A *                 decryption operation.\0A *\0A *                 It performs the operation defined in the \5Cp mode parameter\0A *                 (encrypt or decrypt), on the input data buffer defined in\0A *                 the \5Cp input parameter.\0A *\0A *                 mbedtls_aes_init(), and either mbedtls_aes_setkey_enc() or\0A *                 mbedtls_aes_setkey_dec() must be called before the first\0A *                 call to this API with the same context.\0A *\0A * \5Cparam ctx      The AES context to use for encryption or decryption.\0A *                 It must be initialized and bound to a key.\0A * \5Cparam mode     The AES operation: #MBEDTLS_AES_ENCRYPT or\0A *                 #MBEDTLS_AES_DECRYPT.\0A * \5Cparam input    The buffer holding the input data.\0A *                 It must be readable and at least \5Cc 16 Bytes long.\0A * \5Cparam output   The buffer where the output data will be written.\0A *                 It must be writeable and at least \5Cc 16 Bytes long.\0A\0A * \5Creturn         \5Cc 0 on success.\0A */\0AMBEDTLS_CHECK_RETURN_TYPICAL\0Aint mbedtls_aes_crypt_ecb(mbedtls_aes_context *ctx,\0A                          int mode,\0A                          const unsigned char input[16],\0A                          unsigned char output[16]);\0A\0A#if defined(MBEDTLS_CIPHER_MODE_CBC)\0A/**\0A * \5Cbrief  This function performs an AES-CBC encryption or decryption operation\0A *         on full blocks.\0A *\0A *         It performs the operation defined in the \5Cp mode\0A *         parameter (encrypt/decrypt), on the input data buffer defined in\0A *         the \5Cp input parameter.\0A *\0A *         It can be called as many times as needed, until all the input\0A *         data is processed. mbedtls_aes_init(), and either\0A *         mbedtls_aes_setkey_enc() or mbedtls_aes_setkey_dec() must be called\0A *         before the first call to this API with the same context.\0A *\0A * \5Cnote   This function operates on full blocks, that is, the input size\0A *         must be a multiple of the AES block size of \5Cc 16 Bytes.\0A *\0A * \5Cnote   Upon exit, the content of the IV is updated so that you can\0A *         call the same function again on the next\0A *         block(s) of data and get the same result as if it was\0A *         encrypted in one call. This allows a \22streaming\22 usage.\0A *         If you need to retain the contents of the IV, you should\0A *         either save it manually or use the cipher module instead.\0A *\0A *\0A * \5Cparam ctx      The AES context to use for encryption or decryption.\0A *                 It must be initialized and bound to a key.\0A * \5Cparam mode     The AES operation: #MBEDTLS_AES_ENCRYPT or\0A *                 #MBEDTLS_AES_DECRYPT.\0A * \5Cparam length   The length of the input data in Bytes. This must be a\0A *                 multiple of the block size (\5Cc 16 Bytes).\0A * \5Cparam iv       Initialization vector (updated after use).\0A *                 It must be a readable and writeable buffer of \5Cc 16 Bytes.\0A * \5Cparam input    The buffer holding the input data.\0A *                 It must be readable and of size \5Cp length Bytes.\0A * \5Cparam output   The buffer holding the output data.\0A *                 It must be writeable and of size \5Cp length Bytes.\0A *\0A * \5Creturn         \5Cc 0 on success.\0A * \5Creturn         #MBEDTLS_ERR_AES_INVALID_INPUT_LENGTH\0A *                 on failure.\0A */\0AMBEDTLS_CHECK_RETURN_TYPICAL\0Aint mbedtls_aes_crypt_cbc(mbedtls_aes_context *ctx,\0A                          int mode,\0A                          size_t length,\0A                          unsigned char iv[16],\0A                          const unsigned char *input,\0A                          unsigned char *output);\0A#endif /* MBEDTLS_CIPHER_MODE_CBC */\0A\0A#if defined(MBEDTLS_CIPHER_MODE_XTS)\0A/**\0A * \5Cbrief      This function performs an AES-XTS encryption or decryption\0A *             operation for an entire XTS data unit.\0A *\0A *             AES-XTS encrypts or decrypts blocks based on their location as\0A *             defined by a data unit number. The data unit number must be\0A *             provided by \5Cp data_unit.\0A *\0A *             NIST SP 800-38E limits the maximum size of a data unit to 2^20\0A *             AES blocks. If the data unit is larger than this, this function\0A *             returns #MBEDTLS_ERR_AES_INVALID_INPUT_LENGTH.\0A *\0A * \5Cparam ctx          The AES XTS context to use for AES XTS operations.\0A *                     It must be initialized and bound to a key.\0A * \5Cparam mode         The AES operation: #MBEDTLS_AES_ENCRYPT or\0A *                     #MBEDTLS_AES_DECRYPT.\0A * \5Cparam length       The length of a data unit in Bytes. This can be any\0A *                     length between 16 bytes and 2^24 bytes inclusive\0A *                     (between 1 and 2^20 block cipher blocks).\0A * \5Cparam data_unit    The address of the data unit encoded as an array of 16\0A *                     bytes in little-endian format. For disk encryption, this\0A *                     is typically the index of the block device sector that\0A *                     contains the data.\0A * \5Cparam input        The buffer holding the input data (which is an entire\0A *                     data unit). This function reads \5Cp length Bytes from \5Cp\0A *                     input.\0A * \5Cparam output       The buffer holding the output data (which is an entire\0A *                     data unit). This function writes \5Cp length Bytes to \5Cp\0A *                     output.\0A *\0A * \5Creturn             \5Cc 0 on success.\0A * \5Creturn             #MBEDTLS_ERR_AES_INVALID_INPUT_LENGTH if \5Cp length is\0A *                     smaller than an AES block in size (16 Bytes) or if \5Cp\0A *                     length is larger than 2^20 blocks (16 MiB).\0A */\0AMBEDTLS_CHECK_RETURN_TYPICAL\0Aint mbedtls_aes_crypt_xts(mbedtls_aes_xts_context *ctx,\0A                          int mode,\0A                          size_t length,\0A                          const unsigned char data_unit[16],\0A                          const unsigned char *input,\0A                          unsigned char *output);\0A#endif /* MBEDTLS_CIPHER_MODE_XTS */\0A\0A#if defined(MBEDTLS_CIPHER_MODE_CFB)\0A/**\0A * \5Cbrief This function performs an AES-CFB128 encryption or decryption\0A *        operation.\0A *\0A *        It performs the operation defined in the \5Cp mode\0A *        parameter (encrypt or decrypt), on the input data buffer\0A *        defined in the \5Cp input parameter.\0A *\0A *        For CFB, you must set up the context with mbedtls_aes_setkey_enc(),\0A *        regardless of whether you are performing an encryption or decryption\0A *        operation, that is, regardless of the \5Cp mode parameter. This is\0A *        because CFB mode uses the same key schedule for encryption and\0A *        decryption.\0A *\0A * \5Cnote  Upon exit, the content of the IV is updated so that you can\0A *        call the same function again on the next\0A *        block(s) of data and get the same result as if it was\0A *        encrypted in one call. This allows a \22streaming\22 usage.\0A *        If you need to retain the contents of the\0A *        IV, you must either save it manually or use the cipher\0A *        module instead.\0A *\0A *\0A * \5Cparam ctx      The AES context to use for encryption or decryption.\0A *                 It must be initialized and bound to a key.\0A * \5Cparam mode     The AES operation: #MBEDTLS_AES_ENCRYPT or\0A *                 #MBEDTLS_AES_DECRYPT.\0A * \5Cparam length   The length of the input data in Bytes.\0A * \5Cparam iv_off   The offset in IV (updated after use).\0A *                 It must point to a valid \5Cc size_t.\0A * \5Cparam iv       The initialization vector (updated after use).\0A *                 It must be a readable and writeable buffer of \5Cc 16 Bytes.\0A * \5Cparam input    The buffer holding the input data.\0A *                 It must be readable and of size \5Cp length Bytes.\0A * \5Cparam output   The buffer holding the output data.\0A *                 It must be writeable and of size \5Cp length Bytes.\0A *\0A * \5Creturn         \5Cc 0 on success.\0A */\0AMBEDTLS_CHECK_RETURN_TYPICAL\0Aint mbedtls_aes_crypt_cfb128(mbedtls_aes_context *ctx,\0A                             int mode,\0A                             size_t length,\0A                             size_t *iv_off,\0A                             unsigned char iv[16],\0A                             const unsigned char *input,\0A                             unsigned char *output);\0A\0A/**\0A * \5Cbrief This function performs an AES-CFB8 encryption or decryption\0A *        operation.\0A *\0A *        It performs the operation defined in the \5Cp mode\0A *        parameter (encrypt/decrypt), on the input data buffer defined\0A *        in the \5Cp input parameter.\0A *\0A *        Due to the nature of CFB, you must use the same key schedule for\0A *        both encryption and decryption operations. Therefore, you must\0A *        use the context initialized with mbedtls_aes_setkey_enc() for\0A *        both #MBEDTLS_AES_ENCRYPT and #MBEDTLS_AES_DECRYPT.\0A *\0A * \5Cnote  Upon exit, the content of the IV is updated so that you can\0A *        call the same function again on the next\0A *        block(s) of data and get the same result as if it was\0A *        encrypted in one call. This allows a \22streaming\22 usage.\0A *        If you need to retain the contents of the\0A *        IV, you should either save it manually or use the cipher\0A *        module instead.\0A *\0A *\0A * \5Cparam ctx      The AES context to use for encryption or decryption.\0A *                 It must be initialized and bound to a key.\0A * \5Cparam mode     The AES operation: #MBEDTLS_AES_ENCRYPT or\0A *                 #MBEDTLS_AES_DECRYPT\0A * \5Cparam length   The length of the input data.\0A * \5Cparam iv       The initialization vector (updated after use).\0A *                 It must be a readable and writeable buffer of \5Cc 16 Bytes.\0A * \5Cparam input    The buffer holding the input data.\0A *                 It must be readable and of size \5Cp length Bytes.\0A * \5Cparam output   The buffer holding the output data.\0A *                 It must be writeable and of size \5Cp length Bytes.\0A *\0A * \5Creturn         \5Cc 0 on success.\0A */\0AMBEDTLS_CHECK_RETURN_TYPICAL\0Aint mbedtls_aes_crypt_cfb8(mbedtls_aes_context *ctx,\0A                           int mode,\0A                           size_t length,\0A                           unsigned char iv[16],\0A                           const unsigned char *input,\0A                           unsigned char *output);\0A#endif /*MBEDTLS_CIPHER_MODE_CFB */\0A\0A#if defined(MBEDTLS_CIPHER_MODE_OFB)\0A/**\0A * \5Cbrief       This function performs an AES-OFB (Output Feedback Mode)\0A *              encryption or decryption operation.\0A *\0A *              For OFB, you must set up the context with\0A *              mbedtls_aes_setkey_enc(), regardless of whether you are\0A *              performing an encryption or decryption operation. This is\0A *              because OFB mode uses the same key schedule for encryption and\0A *              decryption.\0A *\0A *              The OFB operation is identical for encryption or decryption,\0A *              therefore no operation mode needs to be specified.\0A *\0A * \5Cnote        Upon exit, the content of iv, the Initialisation Vector, is\0A *              updated so that you can call the same function again on the next\0A *              block(s) of data and get the same result as if it was encrypted\0A *              in one call. This allows a \22streaming\22 usage, by initialising\0A *              iv_off to 0 before the first call, and preserving its value\0A *              between calls.\0A *\0A *              For non-streaming use, the iv should be initialised on each call\0A *              to a unique value, and iv_off set to 0 on each call.\0A *\0A *              If you need to retain the contents of the initialisation vector,\0A *              you must either save it manually or use the cipher module\0A *              instead.\0A *\0A * \5Cwarning     For the OFB mode, the initialisation vector must be unique\0A *              every encryption operation. Reuse of an initialisation vector\0A *              will compromise security.\0A *\0A * \5Cparam ctx      The AES context to use for encryption or decryption.\0A *                 It must be initialized and bound to a key.\0A * \5Cparam length   The length of the input data.\0A * \5Cparam iv_off   The offset in IV (updated after use).\0A *                 It must point to a valid \5Cc size_t.\0A * \5Cparam iv       The initialization vector (updated after use).\0A *                 It must be a readable and writeable buffer of \5Cc 16 Bytes.\0A * \5Cparam input    The buffer holding the input data.\0A *                 It must be readable and of size \5Cp length Bytes.\0A * \5Cparam output   The buffer holding the output data.\0A *                 It must be writeable and of size \5Cp length Bytes.\0A *\0A * \5Creturn         \5Cc 0 on success.\0A */\0AMBEDTLS_CHECK_RETURN_TYPICAL\0Aint mbedtls_aes_crypt_ofb(mbedtls_aes_context *ctx,\0A                          size_t length,\0A                          size_t *iv_off,\0A                          unsigned char iv[16],\0A                          const unsigned char *input,\0A                          unsigned char *output);\0A\0A#endif /* MBEDTLS_CIPHER_MODE_OFB */\0A\0A#if defined(MBEDTLS_CIPHER_MODE_CTR)\0A/**\0A * \5Cbrief      This function performs an AES-CTR encryption or decryption\0A *             operation.\0A *\0A *             Due to the nature of CTR, you must use the same key schedule\0A *             for both encryption and decryption operations. Therefore, you\0A *             must use the context initialized with mbedtls_aes_setkey_enc()\0A *             for both #MBEDTLS_AES_ENCRYPT and #MBEDTLS_AES_DECRYPT.\0A *\0A * \5Cwarning    You must never reuse a nonce value with the same key. Doing so\0A *             would void the encryption for the two messages encrypted with\0A *             the same nonce and key.\0A *\0A *             There are two common strategies for managing nonces with CTR:\0A *\0A *             1. You can handle everything as a single message processed over\0A *             successive calls to this function. In that case, you want to\0A *             set \5Cp nonce_counter and \5Cp nc_off to 0 for the first call, and\0A *             then preserve the values of \5Cp nonce_counter, \5Cp nc_off and \5Cp\0A *             stream_block across calls to this function as they will be\0A *             updated by this function.\0A *\0A *             With this strategy, you must not encrypt more than 2**128\0A *             blocks of data with the same key.\0A *\0A *             2. You can encrypt separate messages by dividing the \5Cp\0A *             nonce_counter buffer in two areas: the first one used for a\0A *             per-message nonce, handled by yourself, and the second one\0A *             updated by this function internally.\0A *\0A *             For example, you might reserve the first 12 bytes for the\0A *             per-message nonce, and the last 4 bytes for internal use. In that\0A *             case, before calling this function on a new message you need to\0A *             set the first 12 bytes of \5Cp nonce_counter to your chosen nonce\0A *             value, the last 4 to 0, and \5Cp nc_off to 0 (which will cause \5Cp\0A *             stream_block to be ignored). That way, you can encrypt at most\0A *             2**96 messages of up to 2**32 blocks each with the same key.\0A *\0A *             The per-message nonce (or information sufficient to reconstruct\0A *             it) needs to be communicated with the ciphertext and must be unique.\0A *             The recommended way to ensure uniqueness is to use a message\0A *             counter. An alternative is to generate random nonces, but this\0A *             limits the number of messages that can be securely encrypted:\0A *             for example, with 96-bit random nonces, you should not encrypt\0A *             more than 2**32 messages with the same key.\0A *\0A *             Note that for both strategies, sizes are measured in blocks and\0A *             that an AES block is 16 bytes.\0A *\0A * \5Cwarning    Upon return, \5Cp stream_block contains sensitive data. Its\0A *             content must not be written to insecure storage and should be\0A *             securely discarded as soon as it's no longer needed.\0A *\0A * \5Cparam ctx              The AES context to use for encryption or decryption.\0A *                         It must be initialized and bound to a key.\0A * \5Cparam length           The length of the input data.\0A * \5Cparam nc_off           The offset in the current \5Cp stream_block, for\0A *                         resuming within the current cipher stream. The\0A *                         offset pointer should be 0 at the start of a stream.\0A *                         It must point to a valid \5Cc size_t.\0A * \5Cparam nonce_counter    The 128-bit nonce and counter.\0A *                         It must be a readable-writeable buffer of \5Cc 16 Bytes.\0A * \5Cparam stream_block     The saved stream block for resuming. This is\0A *                         overwritten by the function.\0A *                         It must be a readable-writeable buffer of \5Cc 16 Bytes.\0A * \5Cparam input            The buffer holding the input data.\0A *                         It must be readable and of size \5Cp length Bytes.\0A * \5Cparam output           The buffer holding the output data.\0A *                         It must be writeable and of size \5Cp length Bytes.\0A *\0A * \5Creturn                 \5Cc 0 on success.\0A */\0AMBEDTLS_CHECK_RETURN_TYPICAL\0Aint mbedtls_aes_crypt_ctr(mbedtls_aes_context *ctx,\0A                          size_t length,\0A                          size_t *nc_off,\0A                          unsigned char nonce_counter[16],\0A                          unsigned char stream_block[16],\0A                          const unsigned char *input,\0A                          unsigned char *output);\0A#endif /* MBEDTLS_CIPHER_MODE_CTR */\0A\0A/**\0A * \5Cbrief           Internal AES block encryption function. This is only\0A *                  exposed to allow overriding it using\0A *                  \5Cc MBEDTLS_AES_ENCRYPT_ALT.\0A *\0A * \5Cparam ctx       The AES context to use for encryption.\0A * \5Cparam input     The plaintext block.\0A * \5Cparam output    The output (ciphertext) block.\0A *\0A * \5Creturn          \5Cc 0 on success.\0A */\0AMBEDTLS_CHECK_RETURN_TYPICAL\0Aint mbedtls_internal_aes_encrypt(mbedtls_aes_context *ctx,\0A                                 const unsigned char input[16],\0A                                 unsigned char output[16]);\0A\0A#if !defined(MBEDTLS_BLOCK_CIPHER_NO_DECRYPT)\0A/**\0A * \5Cbrief           Internal AES block decryption function. This is only\0A *                  exposed to allow overriding it using see\0A *                  \5Cc MBEDTLS_AES_DECRYPT_ALT.\0A *\0A * \5Cparam ctx       The AES context to use for decryption.\0A * \5Cparam input     The ciphertext block.\0A * \5Cparam output    The output (plaintext) block.\0A *\0A * \5Creturn          \5Cc 0 on success.\0A */\0AMBEDTLS_CHECK_RETURN_TYPICAL\0Aint mbedtls_internal_aes_decrypt(mbedtls_aes_context *ctx,\0A                                 const unsigned char input[16],\0A                                 unsigned char output[16]);\0A#endif /* !MBEDTLS_BLOCK_CIPHER_NO_DECRYPT */\0A\0A#if defined(MBEDTLS_SELF_TEST)\0A/**\0A * \5Cbrief          Checkup routine.\0A *\0A * \5Creturn         \5Cc 0 on success.\0A * \5Creturn         \5Cc 1 on failure.\0A */\0AMBEDTLS_CHECK_RETURN_CRITICAL\0Aint mbedtls_aes_self_test(int verbose);\0A\0A#endif /* MBEDTLS_SELF_TEST */\0A\0A#ifdef __cplusplus\0A}\0A#endif\0A\0A#endif /* aes.h */\0A\00" }
