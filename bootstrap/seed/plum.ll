@.str45337 = private global { i64, i64, [28539 x i8] } { i64 -1, i64 28538, [28539 x i8] c"/*\0A *  TLS 1.3 key schedule\0A *\0A *  Copyright The Mbed TLS Contributors\0A *  SPDX-License-Identifier: Apache-2.0 OR GPL-2.0-or-later\0A */\0A#if !defined(MBEDTLS_SSL_TLS1_3_KEYS_H)\0A#define MBEDTLS_SSL_TLS1_3_KEYS_H\0A\0A/* This requires MBEDTLS_SSL_TLS1_3_LABEL( idx, name, string ) to be defined at\0A * the point of use. See e.g. the definition of mbedtls_ssl_tls13_labels_union\0A * below. */\0A#define MBEDTLS_SSL_TLS1_3_LABEL_LIST                                             \5C\0A    MBEDTLS_SSL_TLS1_3_LABEL(finished, \22finished\22) \5C\0A    MBEDTLS_SSL_TLS1_3_LABEL(resumption, \22resumption\22) \5C\0A    MBEDTLS_SSL_TLS1_3_LABEL(traffic_upd, \22traffic upd\22) \5C\0A    MBEDTLS_SSL_TLS1_3_LABEL(exporter, \22exporter\22) \5C\0A    MBEDTLS_SSL_TLS1_3_LABEL(key, \22key\22) \5C\0A    MBEDTLS_SSL_TLS1_3_LABEL(iv, \22iv\22) \5C\0A    MBEDTLS_SSL_TLS1_3_LABEL(c_hs_traffic, \22c hs traffic\22) \5C\0A    MBEDTLS_SSL_TLS1_3_LABEL(c_ap_traffic, \22c ap traffic\22) \5C\0A    MBEDTLS_SSL_TLS1_3_LABEL(c_e_traffic, \22c e traffic\22) \5C\0A    MBEDTLS_SSL_TLS1_3_LABEL(s_hs_traffic, \22s hs traffic\22) \5C\0A    MBEDTLS_SSL_TLS1_3_LABEL(s_ap_traffic, \22s ap traffic\22) \5C\0A    MBEDTLS_SSL_TLS1_3_LABEL(s_e_traffic, \22s e traffic\22) \5C\0A    MBEDTLS_SSL_TLS1_3_LABEL(e_exp_master, \22e exp master\22) \5C\0A    MBEDTLS_SSL_TLS1_3_LABEL(res_master, \22res master\22) \5C\0A    MBEDTLS_SSL_TLS1_3_LABEL(exp_master, \22exp master\22) \5C\0A    MBEDTLS_SSL_TLS1_3_LABEL(ext_binder, \22ext binder\22) \5C\0A    MBEDTLS_SSL_TLS1_3_LABEL(res_binder, \22res binder\22) \5C\0A    MBEDTLS_SSL_TLS1_3_LABEL(derived, \22derived\22) \5C\0A    MBEDTLS_SSL_TLS1_3_LABEL(client_cv, \22TLS 1.3, client CertificateVerify\22) \5C\0A    MBEDTLS_SSL_TLS1_3_LABEL(server_cv, \22TLS 1.3, server CertificateVerify\22)\0A\0A#define MBEDTLS_SSL_TLS1_3_CONTEXT_UNHASHED 0\0A#define MBEDTLS_SSL_TLS1_3_CONTEXT_HASHED   1\0A\0A#define MBEDTLS_SSL_TLS1_3_PSK_EXTERNAL   0\0A#define MBEDTLS_SSL_TLS1_3_PSK_RESUMPTION 1\0A\0A#if defined(MBEDTLS_SSL_PROTO_TLS1_3)\0A\0A#define MBEDTLS_SSL_TLS1_3_LABEL(name, string)       \5C\0A    const unsigned char name    [sizeof(string) - 1];\0A\0Aunion mbedtls_ssl_tls13_labels_union {\0A    MBEDTLS_SSL_TLS1_3_LABEL_LIST\0A};\0Astruct mbedtls_ssl_tls13_labels_struct {\0A    MBEDTLS_SSL_TLS1_3_LABEL_LIST\0A};\0A#undef MBEDTLS_SSL_TLS1_3_LABEL\0A\0Aextern const struct mbedtls_ssl_tls13_labels_struct mbedtls_ssl_tls13_labels;\0A\0A#define MBEDTLS_SSL_TLS1_3_LBL_LEN(LABEL)  \5C\0A    sizeof(mbedtls_ssl_tls13_labels.LABEL)\0A\0A#define MBEDTLS_SSL_TLS1_3_LBL_WITH_LEN(LABEL)  \5C\0A    mbedtls_ssl_tls13_labels.LABEL,              \5C\0A    MBEDTLS_SSL_TLS1_3_LBL_LEN(LABEL)\0A\0A#define MBEDTLS_SSL_TLS1_3_KEY_SCHEDULE_MAX_LABEL_LEN  \5C\0A    sizeof(union mbedtls_ssl_tls13_labels_union)\0A\0A/* The maximum length of HKDF contexts used in the TLS 1.3 standard.\0A * Since contexts are always hashes of message transcripts, this can\0A * be approximated from above by the maximum hash size. */\0A#define MBEDTLS_SSL_TLS1_3_KEY_SCHEDULE_MAX_CONTEXT_LEN  \5C\0A    PSA_HASH_MAX_SIZE\0A\0A/* Maximum desired length for expanded key material generated\0A * by HKDF-Expand-Label.\0A *\0A * Warning: If this ever needs to be increased, the implementation\0A * ssl_tls13_hkdf_encode_label() in ssl_tls13_keys.c needs to be\0A * adjusted since it currently assumes that HKDF key expansion\0A * is never used with more than 255 Bytes of output. */\0A#define MBEDTLS_SSL_TLS1_3_KEY_SCHEDULE_MAX_EXPANSION_LEN 255\0A\0A/**\0A * \5Cbrief            The \5Cc HKDF-Expand-Label function from\0A *                   the TLS 1.3 standard RFC 8446.\0A *\0A * <tt>\0A *                   HKDF-Expand-Label( Secret, Label, Context, Length ) =\0A *                       HKDF-Expand( Secret, HkdfLabel, Length )\0A * </tt>\0A *\0A * \5Cparam hash_alg   The identifier for the hash algorithm to use.\0A * \5Cparam secret     The \5Cc Secret argument to \5Cc HKDF-Expand-Label.\0A *                   This must be a readable buffer of length\0A *                   \5Cp secret_len Bytes.\0A * \5Cparam secret_len The length of \5Cp secret in Bytes.\0A * \5Cparam label      The \5Cc Label argument to \5Cc HKDF-Expand-Label.\0A *                   This must be a readable buffer of length\0A *                   \5Cp label_len Bytes.\0A * \5Cparam label_len  The length of \5Cp label in Bytes.\0A * \5Cparam ctx        The \5Cc Context argument to \5Cc HKDF-Expand-Label.\0A *                   This must be a readable buffer of length \5Cp ctx_len Bytes.\0A * \5Cparam ctx_len    The length of \5Cp context in Bytes.\0A * \5Cparam buf        The destination buffer to hold the expanded secret.\0A *                   This must be a writable buffer of length \5Cp buf_len Bytes.\0A * \5Cparam buf_len    The desired size of the expanded secret in Bytes.\0A *\0A * \5Creturns          \5Cc 0 on success.\0A * \5Creturn           A negative error code on failure.\0A */\0A\0AMBEDTLS_CHECK_RETURN_CRITICAL\0Aint mbedtls_ssl_tls13_hkdf_expand_label(\0A    psa_algorithm_t hash_alg,\0A    const unsigned char *secret, size_t secret_len,\0A    const unsigned char *label, size_t label_len,\0A    const unsigned char *ctx, size_t ctx_len,\0A    unsigned char *buf, size_t buf_len);\0A\0A/**\0A * \5Cbrief           This function is part of the TLS 1.3 key schedule.\0A *                  It extracts key and IV for the actual client/server traffic\0A *                  from the client/server traffic secrets.\0A *\0A * From RFC 8446:\0A *\0A * <tt>\0A *   [sender]_write_key = HKDF-Expand-Label(Secret, \22key\22, \22\22, key_length)\0A *   [sender]_write_iv  = HKDF-Expand-Label(Secret, \22iv\22, \22\22, iv_length)*\0A * </tt>\0A *\0A * \5Cparam hash_alg      The identifier for the hash algorithm to be used\0A *                      for the HKDF-based expansion of the secret.\0A * \5Cparam client_secret The client traffic secret.\0A *                      This must be a readable buffer of size\0A *                      \5Cp secret_len Bytes\0A * \5Cparam server_secret The server traffic secret.\0A *                      This must be a readable buffer of size\0A *                      \5Cp secret_len Bytes\0A * \5Cparam secret_len    Length of the secrets \5Cp client_secret and\0A *                      \5Cp server_secret in Bytes.\0A * \5Cparam key_len       The desired length of the key to be extracted in Bytes.\0A * \5Cparam iv_len        The desired length of the IV to be extracted in Bytes.\0A * \5Cparam keys          The address of the structure holding the generated\0A *                      keys and IVs.\0A *\0A * \5Creturns             \5Cc 0 on success.\0A * \5Creturns             A negative error code on failure.\0A */\0A\0AMBEDTLS_CHECK_RETURN_CRITICAL\0Aint mbedtls_ssl_tls13_make_traffic_keys(\0A    psa_algorithm_t hash_alg,\0A    const unsigned char *client_secret,\0A    const unsigned char *server_secret, size_t secret_len,\0A    size_t key_len, size_t iv_len,\0A    mbedtls_ssl_key_set *keys);\0A\0A/**\0A * \5Cbrief The \5Cc Derive-Secret function from the TLS 1.3 standard RFC 8446.\0A *\0A * <tt>\0A *   Derive-Secret( Secret, Label, Messages ) =\0A *      HKDF-Expand-Label( Secret, Label,\0A *                         Hash( Messages ),\0A *                         Hash.Length ) )\0A * </tt>\0A *\0A * \5Cparam hash_alg   The identifier for the hash function used for the\0A *                   applications of HKDF.\0A * \5Cparam secret     The \5Cc Secret argument to the \5Cc Derive-Secret function.\0A *                   This must be a readable buffer of length\0A *                   \5Cp secret_len Bytes.\0A * \5Cparam secret_len The length of \5Cp secret in Bytes.\0A * \5Cparam label      The \5Cc Label argument to the \5Cc Derive-Secret function.\0A *                   This must be a readable buffer of length\0A *                   \5Cp label_len Bytes.\0A * \5Cparam label_len  The length of \5Cp label in Bytes.\0A * \5Cparam ctx        The hash of the \5Cc Messages argument to the\0A *                   \5Cc Derive-Secret function, or the \5Cc Messages argument\0A *                   itself, depending on \5Cp ctx_hashed.\0A * \5Cparam ctx_len    The length of \5Cp ctx in Bytes.\0A * \5Cparam ctx_hashed This indicates whether the \5Cp ctx contains the hash of\0A *                   the \5Cc Messages argument in the application of the\0A *                   \5Cc Derive-Secret function\0A *                   (value MBEDTLS_SSL_TLS1_3_CONTEXT_HASHED), or whether\0A *                   it is the content of \5Cc Messages itself, in which case\0A *                   the function takes care of the hashing\0A *                   (value MBEDTLS_SSL_TLS1_3_CONTEXT_UNHASHED).\0A * \5Cparam dstbuf     The target buffer to write the output of\0A *                   \5Cc Derive-Secret to. This must be a writable buffer of\0A *                   size \5Cp dtsbuf_len Bytes.\0A * \5Cparam dstbuf_len The length of \5Cp dstbuf in Bytes.\0A *\0A * \5Creturns        \5Cc 0 on success.\0A * \5Creturns        A negative error code on failure.\0A */\0AMBEDTLS_CHECK_RETURN_CRITICAL\0Aint mbedtls_ssl_tls13_derive_secret(\0A    psa_algorithm_t hash_alg,\0A    const unsigned char *secret, size_t secret_len,\0A    const unsigned char *label, size_t label_len,\0A    const unsigned char *ctx, size_t ctx_len,\0A    int ctx_hashed,\0A    unsigned char *dstbuf, size_t dstbuf_len);\0A\0A/**\0A * \5Cbrief Derive TLS 1.3 early data key material from early secret.\0A *\0A *        This is a small wrapper invoking mbedtls_ssl_tls13_derive_secret()\0A *        with the appropriate labels.\0A *\0A * <tt>\0A *        Early Secret\0A *             |\0A *             +-----> Derive-Secret(., \22c e traffic\22, ClientHello)\0A *             |                      = client_early_traffic_secret\0A *             |\0A *             +-----> Derive-Secret(., \22e exp master\22, ClientHello)\0A *             .                      = early_exporter_master_secret\0A *             .\0A *             .\0A * </tt>\0A *\0A * \5Cnote  To obtain the actual key and IV for the early data traffic,\0A *        the client secret derived by this function need to be\0A *        further processed by mbedtls_ssl_tls13_make_traffic_keys().\0A *\0A * \5Cnote  The binder key, which is also generated from the early secret,\0A *        is omitted here. Its calculation is part of the separate routine\0A *        mbedtls_ssl_tls13_create_psk_binder().\0A *\0A * \5Cparam hash_alg     The hash algorithm associated with the PSK for which\0A *                     early data key material is being derived.\0A * \5Cparam early_secret The early secret from which the early data key material\0A *                     should be derived. This must be a readable buffer whose\0A *                     length is the digest size of the hash algorithm\0A *                     represented by \5Cp md_size.\0A * \5Cparam transcript   The transcript of the handshake so far, calculated with\0A *                     respect to \5Cp hash_alg. This must be a readable buffer\0A *                     whose length is the digest size of the hash algorithm\0A *                     represented by \5Cp md_size.\0A * \5Cparam derived      The address of the structure in which to store\0A *                     the early data key material.\0A *\0A * \5Creturns        \5Cc 0 on success.\0A * \5Creturns        A negative error code on failure.\0A */\0AMBEDTLS_CHECK_RETURN_CRITICAL\0Aint mbedtls_ssl_tls13_derive_early_secrets(\0A    psa_algorithm_t hash_alg,\0A    unsigned char const *early_secret,\0A    unsigned char const *transcript, size_t transcript_len,\0A    mbedtls_ssl_tls13_early_secrets *derived);\0A\0A/**\0A * \5Cbrief Derive TLS 1.3 handshake key material from the handshake secret.\0A *\0A *        This is a small wrapper invoking mbedtls_ssl_tls13_derive_secret()\0A *        with the appropriate labels from the standard.\0A *\0A * <tt>\0A *        Handshake Secret\0A *              |\0A *              +-----> Derive-Secret( ., \22c hs traffic\22,\0A *              |                      ClientHello...ServerHello )\0A *              |                      = client_handshake_traffic_secret\0A *              |\0A *              +-----> Derive-Secret( ., \22s hs traffic\22,\0A *              .                      ClientHello...ServerHello )\0A *              .                      = server_handshake_traffic_secret\0A *              .\0A * </tt>\0A *\0A * \5Cnote  To obtain the actual key and IV for the encrypted handshake traffic,\0A *        the client and server secret derived by this function need to be\0A *        further processed by mbedtls_ssl_tls13_make_traffic_keys().\0A *\0A * \5Cparam hash_alg          The hash algorithm associated with the ciphersuite\0A *                          that's being used for the connection.\0A * \5Cparam handshake_secret  The handshake secret from which the handshake key\0A *                          material should be derived. This must be a readable\0A *                          buffer whose length is the digest size of the hash\0A *                          algorithm represented by \5Cp md_size.\0A * \5Cparam transcript        The transcript of the handshake so far, calculated\0A *                          with respect to \5Cp hash_alg. This must be a readable\0A *                          buffer whose length is the digest size of the hash\0A *                          algorithm represented by \5Cp md_size.\0A * \5Cparam derived           The address of the structure in which to\0A *                          store the handshake key material.\0A *\0A * \5Creturns        \5Cc 0 on success.\0A * \5Creturns        A negative error code on failure.\0A */\0AMBEDTLS_CHECK_RETURN_CRITICAL\0Aint mbedtls_ssl_tls13_derive_handshake_secrets(\0A    psa_algorithm_t hash_alg,\0A    unsigned char const *handshake_secret,\0A    unsigned char const *transcript, size_t transcript_len,\0A    mbedtls_ssl_tls13_handshake_secrets *derived);\0A\0A/**\0A * \5Cbrief Derive TLS 1.3 application key material from the master secret.\0A *\0A *        This is a small wrapper invoking mbedtls_ssl_tls13_derive_secret()\0A *        with the appropriate labels from the standard.\0A *\0A * <tt>\0A *        Master Secret\0A *              |\0A *              +-----> Derive-Secret( ., \22c ap traffic\22,\0A *              |                      ClientHello...server Finished )\0A *              |                      = client_application_traffic_secret_0\0A *              |\0A *              +-----> Derive-Secret( ., \22s ap traffic\22,\0A *              |                      ClientHello...Server Finished )\0A *              |                      = server_application_traffic_secret_0\0A *              |\0A *              +-----> Derive-Secret( ., \22exp master\22,\0A *              .                      ClientHello...server Finished)\0A *              .                      = exporter_master_secret\0A *              .\0A * </tt>\0A *\0A * \5Cnote  To obtain the actual key and IV for the (0-th) application traffic,\0A *        the client and server secret derived by this function need to be\0A *        further processed by mbedtls_ssl_tls13_make_traffic_keys().\0A *\0A * \5Cparam hash_alg          The hash algorithm associated with the ciphersuite\0A *                          that's being used for the connection.\0A * \5Cparam master_secret     The master secret from which the application key\0A *                          material should be derived. This must be a readable\0A *                          buffer whose length is the digest size of the hash\0A *                          algorithm represented by \5Cp md_size.\0A * \5Cparam transcript        The transcript of the handshake up to and including\0A *                          the ServerFinished message, calculated with respect\0A *                          to \5Cp hash_alg. This must be a readable buffer whose\0A *                          length is the digest size of the hash algorithm\0A *                          represented by \5Cp hash_alg.\0A * \5Cparam derived           The address of the structure in which to\0A *                          store the application key material.\0A *\0A * \5Creturns        \5Cc 0 on success.\0A * \5Creturns        A negative error code on failure.\0A */\0AMBEDTLS_CHECK_RETURN_CRITICAL\0Aint mbedtls_ssl_tls13_derive_application_secrets(\0A    psa_algorithm_t hash_alg,\0A    unsigned char const *master_secret,\0A    unsigned char const *transcript, size_t transcript_len,\0A    mbedtls_ssl_tls13_application_secrets *derived);\0A\0A/**\0A * \5Cbrief Derive TLS 1.3 resumption master secret from the master secret.\0A *\0A *        This is a small wrapper invoking mbedtls_ssl_tls13_derive_secret()\0A *        with the appropriate labels from the standard.\0A *\0A * \5Cparam hash_alg          The hash algorithm used in the application for which\0A *                          key material is being derived.\0A * \5Cparam application_secret The application secret from which the resumption master\0A *                          secret should be derived. This must be a readable\0A *                          buffer whose length is the digest size of the hash\0A *                          algorithm represented by \5Cp md_size.\0A * \5Cparam transcript        The transcript of the handshake up to and including\0A *                          the ClientFinished message, calculated with respect\0A *                          to \5Cp hash_alg. This must be a readable buffer whose\0A *                          length is the digest size of the hash algorithm\0A *                          represented by \5Cp hash_alg.\0A * \5Cparam transcript_len    The length of \5Cp transcript in Bytes.\0A * \5Cparam derived           The address of the structure in which to\0A *                          store the resumption master secret.\0A *\0A * \5Creturns        \5Cc 0 on success.\0A * \5Creturns        A negative error code on failure.\0A */\0AMBEDTLS_CHECK_RETURN_CRITICAL\0Aint mbedtls_ssl_tls13_derive_resumption_master_secret(\0A    psa_algorithm_t hash_alg,\0A    unsigned char const *application_secret,\0A    unsigned char const *transcript, size_t transcript_len,\0A    mbedtls_ssl_tls13_application_secrets *derived);\0A\0A/**\0A * \5Cbrief Compute the next secret in the TLS 1.3 key schedule\0A *\0A * The TLS 1.3 key schedule proceeds as follows to compute\0A * the three main secrets during the handshake: The early\0A * secret for early data, the handshake secret for all\0A * other encrypted handshake messages, and the master\0A * secret for all application traffic.\0A *\0A * <tt>\0A *                    0\0A *                    |\0A *                    v\0A *     PSK ->  HKDF-Extract = Early Secret\0A *                    |\0A *                    v\0A *     Derive-Secret( ., \22derived\22, \22\22 )\0A *                    |\0A *                    v\0A *  (EC)DHE -> HKDF-Extract = Handshake Secret\0A *                    |\0A *                    v\0A *     Derive-Secret( ., \22derived\22, \22\22 )\0A *                    |\0A *                    v\0A *     0 -> HKDF-Extract = Master Secret\0A * </tt>\0A *\0A * Each of the three secrets in turn is the basis for further\0A * key derivations, such as the derivation of traffic keys and IVs;\0A * see e.g. mbedtls_ssl_tls13_make_traffic_keys().\0A *\0A * This function implements one step in this evolution of secrets:\0A *\0A * <tt>\0A *                old_secret\0A *                    |\0A *                    v\0A *     Derive-Secret( ., \22derived\22, \22\22 )\0A *                    |\0A *                    v\0A *     input -> HKDF-Extract = new_secret\0A * </tt>\0A *\0A * \5Cparam hash_alg    The identifier for the hash function used for the\0A *                    applications of HKDF.\0A * \5Cparam secret_old  The address of the buffer holding the old secret\0A *                    on function entry. If not \5Cc NULL, this must be a\0A *                    readable buffer whose size matches the output size\0A *                    of the hash function represented by \5Cp hash_alg.\0A *                    If \5Cc NULL, an all \5Cc 0 array will be used instead.\0A * \5Cparam input       The address of the buffer holding the additional\0A *                    input for the key derivation (e.g., the PSK or the\0A *                    ephemeral (EC)DH secret). If not \5Cc NULL, this must be\0A *                    a readable buffer whose size \5Cp input_len Bytes.\0A *                    If \5Cc NULL, an all \5Cc 0 array will be used instead.\0A * \5Cparam input_len   The length of \5Cp input in Bytes.\0A * \5Cparam secret_new  The address of the buffer holding the new secret\0A *                    on function exit. This must be a writable buffer\0A *                    whose size matches the output size of the hash\0A *                    function represented by \5Cp hash_alg.\0A *                    This may be the same as \5Cp secret_old.\0A *\0A * \5Creturns           \5Cc 0 on success.\0A * \5Creturns           A negative error code on failure.\0A */\0A\0AMBEDTLS_CHECK_RETURN_CRITICAL\0Aint mbedtls_ssl_tls13_evolve_secret(\0A    psa_algorithm_t hash_alg,\0A    const unsigned char *secret_old,\0A    const unsigned char *input, size_t input_len,\0A    unsigned char *secret_new);\0A\0A/**\0A * \5Cbrief             Calculate a TLS 1.3 PSK binder.\0A *\0A * \5Cparam ssl         The SSL context. This is used for debugging only and may\0A *                    be \5Cc NULL if MBEDTLS_DEBUG_C is disabled.\0A * \5Cparam hash_alg    The hash algorithm associated to the PSK \5Cp psk.\0A * \5Cparam psk         The buffer holding the PSK for which to create a binder.\0A * \5Cparam psk_len     The size of \5Cp psk in bytes.\0A * \5Cparam psk_type    This indicates whether the PSK \5Cp psk is externally\0A *                    provisioned (#MBEDTLS_SSL_TLS1_3_PSK_EXTERNAL) or a\0A *                    resumption PSK (#MBEDTLS_SSL_TLS1_3_PSK_RESUMPTION).\0A * \5Cparam transcript  The handshake transcript up to the point where the\0A *                    PSK binder calculation happens. This must be readable,\0A *                    and its size must be equal to the digest size of\0A *                    the hash algorithm represented by \5Cp hash_alg.\0A * \5Cparam result      The address at which to store the PSK binder on success.\0A *                    This must be writable, and its size must be equal to the\0A *                    digest size of  the hash algorithm represented by\0A *                    \5Cp hash_alg.\0A *\0A * \5Creturns           \5Cc 0 on success.\0A * \5Creturns           A negative error code on failure.\0A */\0AMBEDTLS_CHECK_RETURN_CRITICAL\0Aint mbedtls_ssl_tls13_create_psk_binder(mbedtls_ssl_context *ssl,\0A                                        const psa_algorithm_t hash_alg,\0A                                        unsigned char const *psk, size_t psk_len,\0A                                        int psk_type,\0A                                        unsigned char const *transcript,\0A                                        unsigned char *result);\0A\0A/**\0A * \5Cbref Setup an SSL transform structure representing the\0A *       record protection mechanism used by TLS 1.3\0A *\0A * \5Cparam transform    The SSL transform structure to be created. This must have\0A *                     been initialized through mbedtls_ssl_transform_init() and\0A *                     not used in any other way prior to calling this function.\0A *                     In particular, this function does not clean up the\0A *                     transform structure prior to installing the new keys.\0A * \5Cparam endpoint     Indicates whether the transform is for the client\0A *                     (value #MBEDTLS_SSL_IS_CLIENT) or the server\0A *                     (value #MBEDTLS_SSL_IS_SERVER).\0A * \5Cparam ciphersuite  The numerical identifier for the ciphersuite to use.\0A *                     This must be one of the identifiers listed in\0A *                     ssl_ciphersuites.h.\0A * \5Cparam traffic_keys The key material to use. No reference is stored in\0A *                     the SSL transform being generated, and the caller\0A *                     should destroy the key material afterwards.\0A * \5Cparam ssl          (Debug-only) The SSL context to use for debug output\0A *                     in case of failure. This parameter is only needed if\0A *                     #MBEDTLS_DEBUG_C is set, and is ignored otherwise.\0A *\0A * \5Creturn             \5Cc 0 on success. In this case, \5Cp transform is ready to\0A *                     be used with mbedtls_ssl_transform_decrypt() and\0A *                     mbedtls_ssl_transform_encrypt().\0A * \5Creturn             A negative error code on failure.\0A */\0AMBEDTLS_CHECK_RETURN_CRITICAL\0Aint mbedtls_ssl_tls13_populate_transform(mbedtls_ssl_transform *transform,\0A                                         int endpoint,\0A                                         int ciphersuite,\0A                                         mbedtls_ssl_key_set const *traffic_keys,\0A                                         mbedtls_ssl_context *ssl);\0A\0A/*\0A * TLS 1.3 key schedule evolutions\0A *\0A *   Early -> Handshake -> Application\0A *\0A * Small wrappers around mbedtls_ssl_tls13_evolve_secret().\0A */\0A\0A/**\0A * \5Cbrief Begin TLS 1.3 key schedule by calculating early secret.\0A *\0A *        The TLS 1.3 key schedule can be viewed as a simple state machine\0A *        with states Initial -> Early -> Handshake -> Application, and\0A *        this function represents the Initial -> Early transition.\0A *\0A * \5Cparam ssl  The SSL context to operate on.\0A *\0A * \5Creturns    \5Cc 0 on success.\0A * \5Creturns    A negative error code on failure.\0A */\0AMBEDTLS_CHECK_RETURN_CRITICAL\0Aint mbedtls_ssl_tls13_key_schedule_stage_early(mbedtls_ssl_context *ssl);\0A\0A/**\0A * \5Cbrief Compute TLS 1.3 resumption master secret.\0A *\0A * \5Cparam ssl  The SSL context to operate on. This must be in\0A *             key schedule stage \5Cc Application, see\0A *             mbedtls_ssl_tls13_key_schedule_stage_application().\0A *\0A * \5Creturns    \5Cc 0 on success.\0A * \5Creturns    A negative error code on failure.\0A */\0AMBEDTLS_CHECK_RETURN_CRITICAL\0Aint mbedtls_ssl_tls13_compute_resumption_master_secret(mbedtls_ssl_context *ssl);\0A\0A/**\0A * \5Cbrief Calculate the verify_data value for the client or server TLS 1.3\0A * Finished message.\0A *\0A * \5Cparam ssl  The SSL context to operate on. This must be in\0A *             key schedule stage \5Cc Handshake, see\0A *             mbedtls_ssl_tls13_key_schedule_stage_application().\0A * \5Cparam dst        The address at which to write the verify_data value.\0A * \5Cparam dst_len    The size of \5Cp dst in bytes.\0A * \5Cparam actual_len The address at which to store the amount of data\0A *                   actually written to \5Cp dst upon success.\0A * \5Cparam which      The message to calculate the `verify_data` for:\0A *                   - #MBEDTLS_SSL_IS_CLIENT for the Client's Finished message\0A *                   - #MBEDTLS_SSL_IS_SERVER for the Server's Finished message\0A *\0A * \5Cnote       Both client and server call this function twice, once to\0A *             generate their own Finished message, and once to verify the\0A *             peer's Finished message.\0A\0A * \5Creturns    \5Cc 0 on success.\0A * \5Creturns    A negative error code on failure.\0A */\0AMBEDTLS_CHECK_RETURN_CRITICAL\0Aint mbedtls_ssl_tls13_calculate_verify_data(mbedtls_ssl_context *ssl,\0A                                            unsigned char *dst,\0A                                            size_t dst_len,\0A                                            size_t *actual_len,\0A                                            int which);\0A\0A#if defined(MBEDTLS_SSL_EARLY_DATA)\0A/**\0A * \5Cbrief Compute TLS 1.3 early transform\0A *\0A * \5Cparam ssl  The SSL context to operate on.\0A *\0A * \5Creturns    \5Cc 0 on success.\0A * \5Creturns    A negative error code on failure.\0A *\0A * \5Cwarning    The function does not compute the early master secret. Call\0A *             mbedtls_ssl_tls13_key_schedule_stage_early() before to\0A *             call this function to generate the early master secret.\0A * \5Cnote       For a client/server endpoint, the function computes only the\0A *             encryption/decryption part of the transform as the decryption/\0A *             encryption part is not defined by the specification (no early\0A *             traffic from the server to the client).\0A */\0AMBEDTLS_CHECK_RETURN_CRITICAL\0Aint mbedtls_ssl_tls13_compute_early_transform(mbedtls_ssl_context *ssl);\0A#endif /* MBEDTLS_SSL_EARLY_DATA */\0A\0A/**\0A * \5Cbrief Compute TLS 1.3 handshake transform\0A *\0A * \5Cparam ssl  The SSL context to operate on. The early secret must have been\0A *             computed.\0A *\0A * \5Creturns    \5Cc 0 on success.\0A * \5Creturns    A negative error code on failure.\0A */\0AMBEDTLS_CHECK_RETURN_CRITICAL\0Aint mbedtls_ssl_tls13_compute_handshake_transform(mbedtls_ssl_context *ssl);\0A\0A/**\0A * \5Cbrief Compute TLS 1.3 application transform\0A *\0A * \5Cparam ssl  The SSL context to operate on. The early secret must have been\0A *             computed.\0A *\0A * \5Creturns    \5Cc 0 on success.\0A * \5Creturns    A negative error code on failure.\0A */\0AMBEDTLS_CHECK_RETURN_CRITICAL\0Aint mbedtls_ssl_tls13_compute_application_transform(mbedtls_ssl_context *ssl);\0A\0A#if defined(MBEDTLS_SSL_TLS1_3_KEY_EXCHANGE_MODE_SOME_PSK_ENABLED)\0A/**\0A * \5Cbrief Export TLS 1.3 PSK from handshake context\0A *\0A * \5Cparam[in]   ssl  The SSL context to operate on.\0A * \5Cparam[out]  psk  PSK output pointer.\0A * \5Cparam[out]  psk_len Length of PSK.\0A *\0A * \5Creturns     \5Cc 0 if there is a configured PSK and it was exported\0A *              successfully.\0A * \5Creturns     A negative error code on failure.\0A */\0AMBEDTLS_CHECK_RETURN_CRITICAL\0Aint mbedtls_ssl_tls13_export_handshake_psk(mbedtls_ssl_context *ssl,\0A                                           unsigned char **psk,\0A                                           size_t *psk_len);\0A#endif\0A\0A#endif /* MBEDTLS_SSL_PROTO_TLS1_3 */\0A\0A#endif /* MBEDTLS_SSL_TLS1_3_KEYS_H */\0A\00" }
@.const45339 = private global <{ i64, ptr, ptr, i1, [7 x i8] }> <{ i64 -1, ptr @.str45335, ptr @.str45337, i1 0, [7 x i8] zeroinitializer }>
@.str45340 = private global { i64, i64, [35 x i8] } { i64 -1, i64 34, [35 x i8] c"mbedtls/library/ssl_tls13_server.c\00" }
@.str45342 = private global { i64, i64, [127339 x i8] } { i64 -1, i64 127338, [127339 x i8] c"/*\0A *  TLS 1.3 server-side functions\0A *\0A *  Copyright The Mbed TLS Contributors\0A *  SPDX-License-Identifier: Apache-2.0 OR GPL-2.0-or-later\0A */\0A\0A#include \22common.h\22\0A\0A#if defined(MBEDTLS_SSL_SRV_C) && defined(MBEDTLS_SSL_PROTO_TLS1_3)\0A\0A#include \22debug_internal.h\22\0A#include \22mbedtls/error.h\22\0A#include \22mbedtls/platform.h\22\0A#include \22mbedtls/constant_time.h\22\0A#include \22mbedtls/oid.h\22\0A#include \22mbedtls/psa_util.h\22\0A\0A#include \22ssl_misc.h\22\0A#include \22ssl_tls13_keys.h\22\0A#include \22ssl_debug_helpers.h\22\0A\0A\0Astatic const mbedtls_ssl_ciphersuite_t *ssl_tls13_validate_peer_ciphersuite(\0A    mbedtls_ssl_context *ssl,\0A    unsigned int cipher_suite)\0A{\0A    const mbedtls_ssl_ciphersuite_t *ciphersuite_info;\0A    if (!mbedtls_ssl_tls13_cipher_suite_is_offered(ssl, cipher_suite)) {\0A        return NULL;\0A    }\0A\0A    ciphersuite_info = mbedtls_ssl_ciphersuite_from_id(cipher_suite);\0A    if ((mbedtls_ssl_validate_ciphersuite(ssl, ciphersuite_info,\0A                                          ssl->tls_version,\0A                                          ssl->tls_version) != 0)) {\0A        return NULL;\0A    }\0A    return ciphersuite_info;\0A}\0A\0Astatic void ssl_tls13_select_ciphersuite(\0A    mbedtls_ssl_context *ssl,\0A    const unsigned char *cipher_suites,\0A    const unsigned char *cipher_suites_end,\0A    int psk_ciphersuite_id,\0A    psa_algorithm_t psk_hash_alg,\0A    const mbedtls_ssl_ciphersuite_t **selected_ciphersuite_info)\0A{\0A    *selected_ciphersuite_info = NULL;\0A\0A    /*\0A     * In a compliant ClientHello the byte-length of the list of ciphersuites\0A     * is even and this function relies on this fact. This should have been\0A     * checked in the main ClientHello parsing function. Double check here.\0A     */\0A    if ((cipher_suites_end - cipher_suites) & 1) {\0A        return;\0A    }\0A\0A    for (const unsigned char *p = cipher_suites;\0A         p < cipher_suites_end; p += 2) {\0A        /*\0A         * \22cipher_suites_end - p is even\22 is an invariant of the loop. As\0A         * cipher_suites_end - p > 0, we have cipher_suites_end - p >= 2 and it\0A         * is thus safe to read two bytes.\0A         */\0A        uint16_t id = MBEDTLS_GET_UINT16_BE(p, 0);\0A\0A        const mbedtls_ssl_ciphersuite_t *info =\0A            ssl_tls13_validate_peer_ciphersuite(ssl, id);\0A        if (info == NULL) {\0A            continue;\0A        }\0A\0A        /*\0A         * If a valid PSK ciphersuite identifier has been passed in, we want\0A         * an exact match.\0A         */\0A        if (psk_ciphersuite_id != 0) {\0A            if (id != psk_ciphersuite_id) {\0A                continue;\0A            }\0A        } else if (psk_hash_alg != PSA_ALG_NONE) {\0A            if (mbedtls_md_psa_alg_from_type((mbedtls_md_type_t) info->mac) !=\0A                psk_hash_alg) {\0A                continue;\0A            }\0A        }\0A\0A        *selected_ciphersuite_info = info;\0A        return;\0A    }\0A\0A    MBEDTLS_SSL_DEBUG_MSG(1, (\22No matched ciphersuite, psk_ciphersuite_id=%x, psk_hash_alg=%lx\22,\0A                              (unsigned) psk_ciphersuite_id,\0A                              (unsigned long) psk_hash_alg));\0A}\0A\0A#if defined(MBEDTLS_SSL_TLS1_3_KEY_EXCHANGE_MODE_SOME_PSK_ENABLED)\0A/* From RFC 8446:\0A *\0A *   enum { psk_ke(0), psk_dhe_ke(1), (255) } PskKeyExchangeMode;\0A *   struct {\0A *       PskKeyExchangeMode ke_modes<1..255>;\0A *   } PskKeyExchangeModes;\0A */\0AMBEDTLS_CHECK_RETURN_CRITICAL\0Astatic int ssl_tls13_parse_key_exchange_modes_ext(mbedtls_ssl_context *ssl,\0A                                                  const unsigned char *buf,\0A                                                  const unsigned char *end)\0A{\0A    const unsigned char *p = buf;\0A    size_t ke_modes_len;\0A    int ke_modes = 0;\0A\0A    /* Read ke_modes length (1 Byte) */\0A    MBEDTLS_SSL_CHK_BUF_READ_PTR(p, end, 1);\0A    ke_modes_len = *p++;\0A    /* Currently, there are only two PSK modes, so even without looking\0A     * at the content, something's wrong if the list has more than 2 items. */\0A    if (ke_modes_len > 2) {\0A        MBEDTLS_SSL_PEND_FATAL_ALERT(MBEDTLS_SSL_ALERT_MSG_ILLEGAL_PARAMETER,\0A                                     MBEDTLS_ERR_SSL_ILLEGAL_PARAMETER);\0A        return MBEDTLS_ERR_SSL_HANDSHAKE_FAILURE;\0A    }\0A\0A    MBEDTLS_SSL_CHK_BUF_READ_PTR(p, end, ke_modes_len);\0A\0A    while (ke_modes_len-- != 0) {\0A        switch (*p++) {\0A            case MBEDTLS_SSL_TLS1_3_PSK_MODE_PURE:\0A                ke_modes |= MBEDTLS_SSL_TLS1_3_KEY_EXCHANGE_MODE_PSK;\0A                MBEDTLS_SSL_DEBUG_MSG(3, (\22Found PSK KEX MODE\22));\0A                break;\0A            case MBEDTLS_SSL_TLS1_3_PSK_MODE_ECDHE:\0A                ke_modes |= MBEDTLS_SSL_TLS1_3_KEY_EXCHANGE_MODE_PSK_EPHEMERAL;\0A                MBEDTLS_SSL_DEBUG_MSG(3, (\22Found PSK_EPHEMERAL KEX MODE\22));\0A                break;\0A            default:\0A                MBEDTLS_SSL_PEND_FATAL_ALERT(MBEDTLS_SSL_ALERT_MSG_ILLEGAL_PARAMETER,\0A                                             MBEDTLS_ERR_SSL_ILLEGAL_PARAMETER);\0A                return MBEDTLS_ERR_SSL_ILLEGAL_PARAMETER;\0A        }\0A    }\0A\0A    ssl->handshake->tls13_kex_modes = ke_modes;\0A    return 0;\0A}\0A\0A/*\0A * Non-error return values of\0A * ssl_tls13_offered_psks_check_identity_match_ticket() and\0A * ssl_tls13_offered_psks_check_identity_match(). They are positive to\0A * not collide with error codes that are negative. Zero\0A * (SSL_TLS1_3_PSK_IDENTITY_MATCH) in case of success as it may be propagated\0A * up by the callers of this function as a generic success condition.\0A *\0A * The return value SSL_TLS1_3_PSK_IDENTITY_MATCH_BUT_PSK_NOT_USABLE means\0A * that the pre-shared-key identity matches that of a ticket or an externally-\0A * provisioned pre-shared-key. We have thus been able to retrieve the\0A * attributes of the pre-shared-key but at least one of them does not meet\0A * some criteria and the pre-shared-key cannot be used. For example, a ticket\0A * is expired or its version is not TLS 1.3. Note eventually that the return\0A * value SSL_TLS1_3_PSK_IDENTITY_MATCH_BUT_PSK_NOT_USABLE does not have\0A * anything to do with binder check. A binder check is done only when a\0A * suitable pre-shared-key has been selected and only for that selected\0A * pre-shared-key: if the binder check fails, we fail the handshake and we do\0A * not try to find another pre-shared-key for which the binder check would\0A * succeed as recommended by the specification.\0A */\0A#define SSL_TLS1_3_PSK_IDENTITY_DOES_NOT_MATCH 2\0A#define SSL_TLS1_3_PSK_IDENTITY_MATCH_BUT_PSK_NOT_USABLE 1\0A#define SSL_TLS1_3_PSK_IDENTITY_MATCH 0\0A\0AMBEDTLS_CHECK_RETURN_CRITICAL\0Astatic int ssl_tls13_key_exchange_is_psk_available(mbedtls_ssl_context *ssl);\0AMBEDTLS_CHECK_RETURN_CRITICAL\0Astatic int ssl_tls13_key_exchange_is_psk_ephemeral_available(mbedtls_ssl_context *ssl);\0A\0A#if defined(MBEDTLS_SSL_SESSION_TICKETS)\0AMBEDTLS_CHECK_RETURN_CRITICAL\0Astatic int ssl_tls13_offered_psks_check_identity_match_ticket(\0A    mbedtls_ssl_context *ssl,\0A    const unsigned char *identity,\0A    size_t identity_len,\0A    uint32_t obfuscated_ticket_age,\0A    mbedtls_ssl_session *session)\0A{\0A    int ret = MBEDTLS_ERR_ERROR_CORRUPTION_DETECTED;\0A    unsigned char *ticket_buffer;\0A#if defined(MBEDTLS_HAVE_TIME)\0A    mbedtls_ms_time_t now;\0A    mbedtls_ms_time_t server_age;\0A    uint32_t client_age;\0A    mbedtls_ms_time_t age_diff;\0A#endif\0A\0A    ((void) obfuscated_ticket_age);\0A\0A    MBEDTLS_SSL_DEBUG_MSG(2, (\22=> check_identity_match_ticket\22));\0A\0A    /* Ticket parser is not configured, Skip */\0A    if (ssl->conf->f_ticket_parse == NULL || identity_len == 0) {\0A        return SSL_TLS1_3_PSK_IDENTITY_DOES_NOT_MATCH;\0A    }\0A\0A    /* We create a copy of the encrypted ticket since the ticket parsing\0A     * function is allowed to use its input buffer as an output buffer\0A     * (in-place decryption). We do, however, need the original buffer for\0A     * computing the PSK binder value.\0A     */\0A    ticket_buffer = mbedtls_calloc(1, identity_len);\0A    if (ticket_buffer == NULL) {\0A        return MBEDTLS_ERR_SSL_ALLOC_FAILED;\0A    }\0A    memcpy(ticket_buffer, identity, identity_len);\0A\0A    ret = ssl->conf->f_ticket_parse(ssl->conf->p_ticket,\0A                                    session,\0A                                    ticket_buffer, identity_len);\0A    switch (ret) {\0A        case 0:\0A            ret = SSL_TLS1_3_PSK_IDENTITY_MATCH;\0A            break;\0A\0A        case MBEDTLS_ERR_SSL_SESSION_TICKET_EXPIRED:\0A            MBEDTLS_SSL_DEBUG_MSG(3, (\22ticket is expired\22));\0A            ret = SSL_TLS1_3_PSK_IDENTITY_MATCH_BUT_PSK_NOT_USABLE;\0A            break;\0A\0A        case MBEDTLS_ERR_SSL_INVALID_MAC:\0A            MBEDTLS_SSL_DEBUG_MSG(3, (\22ticket is not authentic\22));\0A            ret = SSL_TLS1_3_PSK_IDENTITY_DOES_NOT_MATCH;\0A            break;\0A\0A        default:\0A            MBEDTLS_SSL_DEBUG_RET(1, \22ticket_parse\22, ret);\0A            ret = SSL_TLS1_3_PSK_IDENTITY_DOES_NOT_MATCH;\0A    }\0A\0A    /* We delete the temporary buffer */\0A    mbedtls_free(ticket_buffer);\0A\0A    if (ret != SSL_TLS1_3_PSK_IDENTITY_MATCH) {\0A        goto exit;\0A    }\0A\0A    /*\0A     * The identity matches that of a ticket. Now check that it has suitable\0A     * attributes and bet it will not be the case.\0A     */\0A    ret = SSL_TLS1_3_PSK_IDENTITY_MATCH_BUT_PSK_NOT_USABLE;\0A\0A    if (session->tls_version != MBEDTLS_SSL_VERSION_TLS1_3) {\0A        MBEDTLS_SSL_DEBUG_MSG(3, (\22Ticket TLS version is not 1.3.\22));\0A        goto exit;\0A    }\0A\0A#if defined(MBEDTLS_HAVE_TIME)\0A    now = mbedtls_ms_time();\0A\0A    if (now < session->ticket_creation_time) {\0A        MBEDTLS_SSL_DEBUG_MSG(\0A            3, (\22Invalid ticket creation time ( now = %\22 MBEDTLS_PRINTF_MS_TIME\0A                \22, creation_time = %\22 MBEDTLS_PRINTF_MS_TIME \22 )\22,\0A                now, session->ticket_creation_time));\0A        goto exit;\0A    }\0A\0A    server_age = now - session->ticket_creation_time;\0A\0A    /* RFC 8446 section 4.6.1\0A     *\0A     * Servers MUST NOT use any value greater than 604800 seconds (7 days).\0A     *\0A     * RFC 8446 section 4.2.11.1\0A     *\0A     * Clients MUST NOT attempt to use tickets which have ages greater than\0A     * the \22ticket_lifetime\22 value which was provided with the ticket.\0A     *\0A     */\0A    if (server_age > MBEDTLS_SSL_TLS1_3_MAX_ALLOWED_TICKET_LIFETIME * 1000) {\0A        MBEDTLS_SSL_DEBUG_MSG(\0A            3, (\22Ticket age exceeds limitation ticket_age = %\22 MBEDTLS_PRINTF_MS_TIME,\0A                server_age));\0A        goto exit;\0A    }\0A\0A    /* RFC 8446 section 4.2.10\0A     *\0A     * For PSKs provisioned via NewSessionTicket, a server MUST validate that\0A     * the ticket age for the selected PSK identity (computed by subtracting\0A     * ticket_age_add from PskIdentity.obfuscated_ticket_age modulo 2^32) is\0A     * within a small tolerance of the time since the ticket was issued.\0A     *\0A     * NOTE: The typical accuracy of an RTC crystal is ±100 to ±20 parts per\0A     *       million (360 to 72 milliseconds per hour). Default tolerance\0A     *       window is 6s, thus in the worst case clients and servers must\0A     *       sync up their system time every 6000/360/2~=8 hours.\0A     */\0A    client_age = obfuscated_ticket_age - session->ticket_age_add;\0A    age_diff = server_age - (mbedtls_ms_time_t) client_age;\0A    if (age_diff < -MBEDTLS_SSL_TLS1_3_TICKET_AGE_TOLERANCE ||\0A        age_diff > MBEDTLS_SSL_TLS1_3_TICKET_AGE_TOLERANCE) {\0A        MBEDTLS_SSL_DEBUG_MSG(\0A            3, (\22Ticket age outside tolerance window ( diff = %\22\0A                MBEDTLS_PRINTF_MS_TIME \22)\22,\0A                age_diff));\0A        goto exit;\0A    }\0A#endif /* MBEDTLS_HAVE_TIME */\0A\0A    /*\0A     * All good, we have found a suitable ticket.\0A     */\0A    ret = SSL_TLS1_3_PSK_IDENTITY_MATCH;\0A\0Aexit:\0A    if (ret != SSL_TLS1_3_PSK_IDENTITY_MATCH) {\0A        mbedtls_ssl_session_free(session);\0A    }\0A\0A    MBEDTLS_SSL_DEBUG_MSG(2, (\22<= check_identity_match_ticket\22));\0A    return ret;\0A}\0A#endif /* MBEDTLS_SSL_SESSION_TICKETS */\0A\0AMBEDTLS_CHECK_RETURN_CRITICAL\0Astatic int ssl_tls13_offered_psks_check_identity_match(\0A    mbedtls_ssl_context *ssl,\0A    const unsigned char *identity,\0A    size_t identity_len,\0A    uint32_t obfuscated_ticket_age,\0A    int *psk_type,\0A    mbedtls_ssl_session *session)\0A{\0A    int ret = MBEDTLS_ERR_ERROR_CORRUPTION_DETECTED;\0A\0A    ((void) session);\0A    ((void) obfuscated_ticket_age);\0A    *psk_type = MBEDTLS_SSL_TLS1_3_PSK_EXTERNAL;\0A\0A    MBEDTLS_SSL_DEBUG_BUF(4, \22identity\22, identity, identity_len);\0A\0A#if defined(MBEDTLS_SSL_SESSION_TICKETS)\0A    ret = ssl_tls13_offered_psks_check_identity_match_ticket(\0A        ssl, identity, identity_len, obfuscated_ticket_age, session);\0A    if (ret == SSL_TLS1_3_PSK_IDENTITY_MATCH) {\0A        *psk_type = MBEDTLS_SSL_TLS1_3_PSK_RESUMPTION;\0A        ret = mbedtls_ssl_set_hs_psk(ssl,\0A                                     session->resumption_key,\0A                                     session->resumption_key_len);\0A        if (ret != 0) {\0A            MBEDTLS_SSL_DEBUG_RET(1, \22mbedtls_ssl_set_hs_psk\22, ret);\0A            return ret;\0A        }\0A\0A        MBEDTLS_SSL_DEBUG_BUF(4, \22Ticket-resumed PSK:\22,\0A                              session->resumption_key,\0A                              session->resumption_key_len);\0A        MBEDTLS_SSL_DEBUG_MSG(4, (\22ticket: obfuscated_ticket_age: %u\22,\0A                                  (unsigned) obfuscated_ticket_age));\0A        return SSL_TLS1_3_PSK_IDENTITY_MATCH;\0A    } else if (ret == SSL_TLS1_3_PSK_IDENTITY_MATCH_BUT_PSK_NOT_USABLE) {\0A        return SSL_TLS1_3_PSK_IDENTITY_MATCH_BUT_PSK_NOT_USABLE;\0A    }\0A#endif /* MBEDTLS_SSL_SESSION_TICKETS */\0A\0A    /* Check identity with external configured function */\0A    if (ssl->conf->f_psk != NULL) {\0A        if (ssl->conf->f_psk(\0A                ssl->conf->p_psk, ssl, identity, identity_len) == 0) {\0A            return SSL_TLS1_3_PSK_IDENTITY_MATCH;\0A        }\0A        return SSL_TLS1_3_PSK_IDENTITY_DOES_NOT_MATCH;\0A    }\0A\0A    MBEDTLS_SSL_DEBUG_BUF(5, \22identity\22, identity, identity_len);\0A    /* Check identity with pre-configured psk */\0A    if (ssl->conf->psk_identity != NULL &&\0A        identity_len == ssl->conf->psk_identity_len &&\0A        mbedtls_ct_memcmp(ssl->conf->psk_identity,\0A                          identity, identity_len) == 0) {\0A        ret = mbedtls_ssl_set_hs_psk(ssl, ssl->conf->psk, ssl->conf->psk_len);\0A        if (ret != 0) {\0A            MBEDTLS_SSL_DEBUG_RET(1, \22mbedtls_ssl_set_hs_psk\22, ret);\0A            return ret;\0A        }\0A        return SSL_TLS1_3_PSK_IDENTITY_MATCH;\0A    }\0A\0A    return SSL_TLS1_3_PSK_IDENTITY_DOES_NOT_MATCH;\0A}\0A\0A/*\0A * Non-error return values of ssl_tls13_offered_psks_check_binder_match().\0A * They are positive to not collide with error codes that are negative. Zero\0A * (SSL_TLS1_3_BINDER_MATCH) in case of success as it may be propagated up\0A * by the callers of this function as a generic success condition.\0A */\0A#define SSL_TLS1_3_BINDER_DOES_NOT_MATCH 1\0A#define SSL_TLS1_3_BINDER_MATCH 0\0AMBEDTLS_CHECK_RETURN_CRITICAL\0Astatic int ssl_tls13_offered_psks_check_binder_match(\0A    mbedtls_ssl_context *ssl,\0A    const unsigned char *binder, size_t binder_len,\0A    int psk_type, psa_algorithm_t psk_hash_alg)\0A{\0A    int ret = MBEDTLS_ERR_ERROR_CORRUPTION_DETECTED;\0A\0A    unsigned char transcript[PSA_HASH_MAX_SIZE];\0A    siz