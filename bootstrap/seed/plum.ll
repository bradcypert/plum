and modulo, which is NOT what `/` and `%` do: those\0A/// truncate toward zero, so `-1 / 86400` is `0` and the day before the\0A/// epoch would land in 1970. Every calendar function below needs the\0A/// floor, and dates before 1970 are real dates.\0Alet plum__floor_div (a: Int) (b: Int): Int = {\0A    let q = a / b;\0A    if a - q * b != 0 && (a < 0) != (b < 0) { q - 1 } else { q }\0A}\0A\0Alet plum__floor_mod (a: Int) (b: Int): Int = a - plum__floor_div(a, b) * b\0A\0A/// A civil date and time, as UTC. `weekday` is 0 for Sunday.\0Apub struct DateTime {\0A    pub year: Int, pub month: Int, pub day: Int,\0A    pub hour: Int, pub minute: Int, pub second: Int,\0A    pub weekday: Int,\0A}\0A\0A/// Howard Hinnant's `civil_from_days`: exact for every date in the\0A/// proleptic Gregorian calendar, with no lookup table and no leap-year\0A/// special case. It shifts the year to start in March so the leap day\0A/// falls at the END of the cycle, which is what removes the special\0A/// case rather than hiding it.\0A///\0A/// The inner divisions all operate on non-negative values, so plain `/`\0A/// is right there; only `era` can go negative and it uses the floor.\0Apub let utc (epoch: Int): DateTime = {\0A    let days = plum__floor_div(epoch, 86400);\0A    let secs = plum__floor_mod(epoch, 86400);\0A    let z = days + 719468;\0A    let era = plum__floor_div(z, 146097);\0A    let doe = z - era * 146097;\0A    let yoe = (doe - doe / 1460 + doe / 36524 - doe / 146096) / 365;\0A    let doy = doe - (365 * yoe + yoe / 4 - yoe / 100);\0A    let mp = (5 * doy + 2) / 153;\0A    let d = doy - (153 * mp + 2) / 5 + 1;\0A    let m = if mp < 10 { mp + 3 } else { mp - 9 };\0A    DateTime {\0A        year: yoe + era * 400 + (if m <= 2 { 1 } else { 0 }),\0A        month: m,\0A        day: d,\0A        hour: secs / 3600,\0A        minute: secs / 60 - secs / 3600 * 60,\0A        second: secs - secs / 60 * 60,\0A        // 1970-01-01 was a Thursday, which is index 4.\0A        weekday: plum__floor_mod(days + 4, 7),\0A    }\0A}\0A\0A/// The English name of a weekday, 0 being Sunday, as `Time.utc`\0A/// reports it. Out-of-range numbers give an empty string.\0Apub let weekday_name (weekday: Int): String =\0A    [\22Sun\22, \22Mon\22, \22Tue\22, \22Wed\22, \22Thu\22, \22Fri\22, \22Sat\22][plum__floor_mod(weekday, 7)]\0A\0A/// The English name of a month, 1 being January, as `Time.utc` reports\0A/// it. Out-of-range numbers give an empty string.\0Apub let month_name (month: Int): String =\0A    [\22Jan\22, \22Feb\22, \22Mar\22, \22Apr\22, \22May\22, \22Jun\22, \22Jul\22, \22Aug\22, \22Sep\22, \22Oct\22, \22Nov\22, \22Dec\22][plum__floor_mod(month - 1, 12)]\0A\0Alet plum__two (n: Int): String = String.pad_left(n.to_string(), 2, \220\22)\0A\0A/// `2026-08-27T01:40:28Z`, in ISO 8601, which is the one to reach for\0A/// when a machine reads it back or when it needs to sort as text.\0Apub let iso8601 (epoch: Int): String = {\0A    let t = utc(epoch);\0A    let date = String.pad_left(t.year.to_string(), 4, \220\22).concat(\22-\22).concat(plum__two(t.month)).concat(\22-\22).concat(plum__two(t.day));\0A    date.concat(\22T\22).concat(plum__two(t.hour)).concat(\22:\22).concat(plum__two(t.minute)).concat(\22:\22).concat(plum__two(t.second)).concat(\22Z\22)\0A}\0A\0A/// `Thu, 27 Aug 2026 01:40:28 GMT`, the HTTP date format (RFC 7231),\0A/// which is what a `Last-Modified` header and a good many generated\0A/// files want.\0Apub let rfc7231 (epoch: Int): String = {\0A    let t = utc(epoch);\0A    let head = weekday_name(t.weekday).concat(\22, \22).concat(plum__two(t.day)).concat(\22 \22).concat(month_name(t.month));\0A    let time = plum__two(t.hour).concat(\22:\22).concat(plum__two(t.minute)).concat(\22:\22).concat(plum__two(t.second));\0A    head.concat(\22 \22).concat(t.year.to_string()).concat(\22 \22).concat(time).concat(\22 GMT\22)\0A}\0A\00" }
