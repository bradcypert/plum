A/// not guaranteed to be valid UTF-8.\0Apub let Bytes.slice (b: Bytes) (start: Int) (end: Int): Bytes = {\0A    let n = bytes_len_raw(b);\0A    let lo = if start < 0 { 0 } else if start > n { n } else { start };\0A    let hi = if end < lo { lo } else if end > n { n } else { end };\0A    bytes_slice_raw(b, lo, hi)\0A}\0A\0A/// The two runs of bytes, joined.\0Apub let Bytes.concat (a: Bytes) (b: Bytes): Bytes = bytes_concat_raw(a, b)\0A\0A/// `None` rather than an abort for an out-of-range index: a byte\0A/// buffer is usually being walked by a parser that does not know how\0A/// long it is yet, and `Option` is how the rest of this prelude says\0A/// \22nothing there\22 (`Array.first`, `Map.get`).\0A/// The byte at `i` as a number 0-255, or `None` when out of range.\0Apub let Bytes.at (b: Bytes) (i: Int): Option[Int] =\0A    if i < 0 { None } else if i >= bytes_len_raw(b) { None } else { Some(bytes_at_raw(b, i)) }\0A\0A/// Each element is one byte, 0-255. Values outside that range are\0A/// masked to their low 8 bits rather than rejected. `from_array` is\0A/// a construction helper, and a `Result` here would put error handling\0A/// in front of every literal buffer.\0A/// Bytes from numbers. Values outside 0-255 are truncated to their\0A/// low eight bits.\0Apub let Bytes.from_array (xs: Array[Int]): Bytes = bytes_from_array_raw(xs)\0A\0A/// The way back in from C, and the counterpart to `.as_cstr()`.\0A///\0A/// Takes an explicit LENGTH, which is the whole difference from\0A/// `CStr.as_string()`: that one stops at the first NUL because a\0A/// `char*` alone cannot say how long it is, and any C API returning\0A/// bytes has to hand back a count separately. Given the count, this\0A/// is binary-safe. Given a wrong one, it reads whatever is\0A/// next in memory, exactly as the equivalent C would.\0A///\0A/// COPIES into a fresh cell. C buffers are routinely static, reused\0A/// on the next call, or freed by the callee; the copy is what makes\0A/// the result an ordinary owned Plum value.\0Alet bytes_from_cstr_raw (c: CStr) (len: Int): Bytes = bytes_from_cstr_raw(c, len)\0A/// Copies `len` bytes from a C pointer.\0A///\0A/// For `extern \5C\22C\5C\22` results only, and `unsafe` for the obvious reason:\0A/// nothing checks that the pointer is valid or that `len` is right.\0Apub let Bytes.from_cstr (c: CStr) (len: Int): Bytes =\0A    if len <= 0 { Bytes.empty() } else { bytes_from_cstr_raw(c, len) }\0A\0Alet plum__bytes_to_array_acc (b: Bytes) (i: Int) (n: Int) (acc: Array[Int]): Array[Int] =\0A    if i >= n { acc } else { plum__bytes_to_array_acc(b, i + 1, n, acc.push(bytes_at_raw(b, i))) }\0A/// The bytes as numbers 0-255.\0Apub let Bytes.to_array (b: Bytes): Array[Int] = plum__bytes_to_array_acc(b, 0, bytes_len_raw(b), [])\0A\0A/// Lowercase hex, two characters per byte, no separator.\0A///\0A/// This is what `.to_string()` would have to be if `Bytes` had one,\0A/// and the reason it does not: hex is A rendering, not THE rendering,\0A/// and picking it silently would make `.to_string()` mean something\0A/// different on this type than on every other. Named explicitly, the\0A/// caller decides.\0Alet plum__hex_digit (v: Int): String =\0A    if v == 0 { \220\22 } else if v == 1 { \221\22 } else if v == 2 { \222\22 } else if v == 3 { \223\22 }\0A    else if v == 4 { \224\22 } else if v == 5 { \225\22 } else if v == 6 { \226\22 } else if v == 7 { \227\22 }\0A    else if v == 8 { \228\22 } else if v == 9 { \229\22 } else if v == 10 { \22a\22 } else if v == 11 { \22b\22 }\0A    else if v == 12 { \22c\22 } else if v == 13 { \22d\22 } else if v == 14 { \22e\22 } else { \22f\22 }\0A\0Alet plum__bytes_hex_acc (b: Bytes) (i: Int) (n: Int) (acc: Array[String]): Array[String] =\0A    if i >= n { acc }\0A    else {\0A        let v = bytes_at_raw(b, i);\0A        plum__bytes_hex_acc(b, i + 1, n, acc.push(plum__hex_digit(v / 16)).push(plum__hex_digit(v % 16)))\0A    }\0A/// Lowercase hex, two characters per byte. `Encoding.hex_decode`\0A/// reads it back.\0Apub let Bytes.to_hex (b: Bytes): String = Array.concat_all(plum__bytes_hex_acc(b, 0, bytes_len_raw(b), []))\0A\0A/// The one string operation that had NEITHER form: there was no way\0A/// to join an array of strings with a separator at all.\0Alet plum__join_acc (parts: Array[String]) (sep: String) (i: Int) (acc: Array[String]): Array[String] =\0A    if i >= parts.len() { acc }\0A    else if i == 0 { plum__join_acc(parts, sep, 1, acc.push(parts[0])) }\0A    else { plum__join_acc(parts, sep, i + 1, acc.push(sep).push(parts[i])) }\0A\0A/// Namespaced under `Array`, not `String`, since 2026-08-25: both\0A/// take an `Array[String]`. `String.` used to mean two different\0A/// things, \22first parameter is a String\22 for most of it and\0A/// \22produces a String\22 for these two, and `x.f(a)` = `T.f(x, a)`\0A/// needs it to mean exactly one. `parts.join(\22, \22)` now works and\0A/// reads the right way round.\0Apub let Array.join (parts: Array[String]) (sep: String): String = Array.concat_all(plum__join_acc(parts, sep, 0, []))\0A\0Alet plum__string_digit_value (c: String): Result[Int, String] = match c {\0A    \220\22 => Ok(0), \221\22 => Ok(1), \222\22 => Ok(2), \223\22 => Ok(3), \224\22 => Ok(4),\0A    \225\22 => Ok(5), \226\22 => Ok(6), \227\22 => Ok(7), \228\22 => Ok(8), \229\22 => Ok(9),\0A    _ => Err(\22expected a digit, found \22.concat(c)),\0A}\0A\0A/// Int's minimum, which CANNOT be written as a literal: its\0A/// magnitude is out of range as a positive number, so the lexer\0A/// rejects `9223372036854775808` before any sign is applied.\0Alet plum__int_min (u: Unit): Int = 0 - 9223372036854775807 - 1\0A\0Alet plum__string_parse_int_acc (cs: Array[String]) (i: Int) (acc: Int) (any: Bool) (negative: Bool): Result[Int, String] =\0A    if i >= cs.len() { if any { Ok(acc) } else { Err(\22expected at least one digit\22) } }\0A    else { match plum__string_digit_value(cs[i]) {\0A        // Range is checked BEFORE multiplying, not after. `*` and\0A        // `+` on Int abort the program on overflow (2026-08-21), so\0A        // an out-of-range literal used to KILL a program that had\0A        // asked for a `Result` precisely so it could handle bad\0A        // input -- `String.parse_int(\2299999999999999999999\22)` printed\0A        // `integer overflow` and exited 1 instead of returning Err.\0A        // Before that change the backends wrapped and returned a\0A        // garbage number instead, which was no better.\0A        //\0A        // 922337203685477580 is Int::MAX / 10: one more and `acc * 10`\0A        // itself overflows.\0A        // Accumulated NEGATIVELY for a negative number, rather\0A        // than building the magnitude and negating at the end.\0A        // The magnitude of Int's minimum is one larger than its\0A        // maximum, so `-9223372036854775808` -- a perfectly good\0A        // Int -- overflowed while still positive and came back as\0A        // `integer out of range`. Found by a property test on\0A        // 2026-08-25; the Rust interpreter had the identical bug,\0A        // so `interp-check` agreed with it and saw nothing.\0A        Ok(d) => if negative {\0A            if acc < 0 - 922337203685477580 { Err(\22integer out of range\22) }\0A                     else if acc * 10 < plum__int_min(()) + d { Err(\22integer out of range\22) }\0A                     else { plum__string_parse_int_acc(cs, i + 1, acc * 10 - d, true, negative) }\0A        } else if acc > 922337203685477580 { Err(\22integer out of range\22) }\0A                 else if acc * 10 > 9223372036854775807 - d { Err(\22integer out of range\22) }\0A                 else { plum__string_parse_int_acc(cs, i + 1, acc * 10 + d, true, negative) },\0A        Err(e) => Err(e),\0A    } }\0A\0A/// Parses a decimal integer, with an optional leading `-`.\0A///\0A/// `Err` on anything else, including an empty string, surrounding\0A/// spaces, and a number too large for an `Int`. No `0x` or `0b`\0A/// prefixes — this is the inverse of `to_string`, not a literal\0A/// parser.\0Apub let String.parse_int (s: String): Result[Int, String] = {\0A    let cs = chars_of(s);\0A    if Array.is_empty(cs) { Err(\22empty string\22) }\0A    else if cs[0] == \22-\22 { plum__string_parse_int_acc(Array.slice(cs, 1, cs.len()), 0, 0, false, true) }\0A    else { plum__string_parse_int_acc(cs, 0, 0, false, false) }\0A}\0A\0A/// `String.parse_float` DELEGATES to the JSON number parser below,\0A/// exactly as the real prelude does.\0A///\0A/// It used to have a hand-written parser here, on the reasoning that\0A/// dragging a JSON parser in to read a float would be absurd. That\0A/// reasoning cost twice. The hand-written version accumulated the\0A/// fraction digit by digit against a repeatedly-divided 0.1, so\0A/// `0.000001` parsed as 1.0000000000000002e-06, invisible until\0A/// floats started printing every digit that matters. And its own\0A/// comment admitted the second cost: \22no exponent, which is a real\0A/// narrowing, stated rather than discovered\22. Stated, but it made\0A/// the two compilers DISAGREE. `String.parse_float(\221e3\22)` gave\0A/// 1000 under the real compiler and an error here.\0A///\0A/// The JSON parser was already in this same prelude, already\0A/// handling exponents, already correct. Reusing it is not absurd;\0A/// writing a second one was.\0Apub let String.parse_float (s: String): Result[Float, String] = {\0A    let cs = chars_of(s);\0A    match parse_number(cs, 0) {\0A        Ok(r) => if r.next_pos == cs.len() { Ok(r.value) } else { Err(\22trailing characters after number\22) },\0A        Err(e) => Err(e),\0A    }\0A}\0A\0A// --- Sorting ---\0A\0A// Merge into a fresh, uniquely owned accumulator. Tail calls move it\0A// into the next push, so growth is amortized O(1) per element. Taking\0A// the left element on equality preserves the original order of ties.\0Alet plum__array_sort_merge_acc[T] (left: Array[T]) (right: Array[T]) (le: (T, T) -> Bool) (i: Int) (j: Int) (acc: Array[T]): Array[T] =\0A    if i >= left.len() {\0A        if j >= right.len() { acc }\0A        else { plum__array_sort_merge_acc(left, right, le, i, j + 1, acc.push(right[j])) }\0A    } else if j >= right.len() {\0A        plum__array_sort_merge_acc(left, right, le, i + 1, j, acc.push(left[i]))\0A    } else if le(left[i], right[j]) {\0A        plum__array_sort_merge_acc(left, right, le, i + 1, j, acc.push(left[i]))\0A    } else {\0A        plum__array_sort_merge_acc(left, right, le, i, j + 1, acc.push(right[j]))\0A    }\0A\0A// Split index ranges rather than copying slices of the input. Only\0A// the sorted runs and merge output allocate, with O(n) peak storage\0A// and O(log n) stack depth for the recursive splits.\0Alet plum__array_sort_range[T] (arr: Array[T]) (le: (T, T) -> Bool) (lo: Int) (hi: Int): Array[T] =\0A    if hi <= lo { [] }\0A    else if hi - lo == 1 { [arr[lo]] }\0A    else {\0A        let mid = lo + (hi - lo) / 2;\0A        let left = plum__array_sort_range(arr, le, lo, mid);\0A        let right = plum__array_sort_range(arr, le, mid, hi);\0A        plum__array_sort_merge_acc(left, right, le, 0, 0, [])\0A    }\0A\0A/// Sorted by a \5C\22less than or equal\5C\22 predicate.\0A///\0A/// STABLE: elements `le` considers equivalent keep their original\0A/// order, which is what makes sorting by one key and then another\0A/// produce the ordering people expect.\0A///\0A/// Merge sort with O(n log n) comparisons and O(n) auxiliary storage.\0Apub let Array.sort_by[T] (arr: Array[T]) (le: (T, T) -> Bool): Array[T] = plum__array_sort_range(arr, le, 0, arr.len())\0A\0A/// Sorted ascending.\0Apub let Array.sort_int (arr: Array[Int]): Array[Int] = Array.sort_by(arr, |a: Int, b: Int| a <= b)\0A/// Sorted ascending. NaN does not compare, so an array containing one\0A/// has no meaningful order.\0Apub let Array.sort_float (arr: Array[Float]): Array[Float] = Array.sort_by(arr, |a: Float, b: Float| a <= b)\0A\0A// `Array.sort_string` is deliberately ABSENT: the real prelude compares\0A// via `a.runes()`, and this compiler has no `.runes()` primitive. It\0A// belongs with `Float.sqrt` and friends -- the group that needs a\0A// runtime primitive rather than prelude source -- not here.\0A\0A// --- Zip ---\0A\0A/// A named struct, not a tuple, exactly as the real prelude has it.\0Apub struct Zipped[A, B] { pub first: A, pub second: B }\0A\0Alet plum__array_zip_acc[T, U] (a: Array[T]) (b: Array[U]) (i: Int) (acc: Array[Zipped[T, U]]): Array[Zipped[T, U]] =\0A    if i >= a.len() || i >= b.len() { acc } else { plum__array_zip_acc(a, b, i + 1, acc.push(Zipped { first: a[i], second: b[i] })) }\0A\0A/// Pairs elements positionally, stopping at the shorter array.\0Apub let Array.zip[T, U] (a: Array[T]) (b: Array[U]): Array[Zipped[T, U]] = plum__array_zip_acc(a, b, 0, [])\0A\0A// --- String trimming ---\0A\0Alet plum__string_ws_prefix_len_acc (chars: Array[String]) (i: Int): Int =\0A    if i >= chars.len() { i } else if String.is_ascii_ws(chars[i]) { plum__string_ws_prefix_len_acc(chars, i + 1) } else { i }\0A\0A/// Whitespace removed from the start.\0Apub let String.trim_start (s: String): String = {\0A    let chars = chars_of(s);\0A    Array.concat_all(Array.drop(chars, plum__string_ws_prefix_len_acc(chars, 0)))\0A}\0A\0A/// Whitespace removed from the end.\0Apub let String.trim_end (s: String): String = String.reverse(String.trim_start(String.reverse(s)))\0A\0A/// Split on newlines.\0A///\0A/// A trailing newline produces a final empty piece, since the text\0A/// after it is empty — which is what makes joining the result back\0A/// with newlines give the original.\0Apub let String.lines (s: String): Array[String] = s.split(\22\5Cn\22)\0A\0A// --- Numbers that need the runtime ---\0A\0A/// The real prelude writes these as `unsafe { fabs(x) }`,\0A/// `unsafe { sqrt(x) }` and friends.\0A/// This backend has no `extern \22C\22`/`unsafe` support, so they reach the\0A/// same libm functions as runtime primitives instead.\0Alet abs_raw (x: Float): Float = 0.0\0Alet sqrt_raw (x: Float): Float = 0.0\0Alet pow_raw (b: Float) (e: Float): Float = 0.0\0Alet floor_raw (x: Float): Float = 0.0\0Alet ceil_raw (x: Float): Float = 0.0\0Alet round_raw (x: Float): Float = 0.0\0Alet sin_raw (x: Float): Float = 0.0\0Alet cos_raw (x: Float): Float = 0.0\0Alet tan_raw (x: Float): Float = 0.0\0Alet asin_raw (x: Float): Float = 0.0\0Alet acos_raw (x: Float): Float = 0.0\0Alet atan_raw (x: Float): Float = 0.0\0Alet atan2_raw (y: Float) (x: Float): Float = 0.0\0Alet log_raw (x: Float): Float = 0.0\0Alet log2_raw (x: Float): Float = 0.0\0Alet log10_raw (x: Float): Float = 0.0\0Alet exp_raw (x: Float): Float = 0.0\0Alet float_fixed_raw (x: Float) (decimals: Int): String = \22\22\0Alet random_raw (ignored: Bool): Float = 0.0\0A\0A/// The square root. Negative input gives NaN rather than failing.\0Apub let Float.sqrt (x: Float): Float = sqrt_raw(x)\0A/// `base` raised to `exp`. A fractional exponent of a negative base\0A/// gives NaN.\0Apub let Float.pow (base: Float) (exp: Float): Float = pow_raw(base, exp)\0A/// The largest whole number no greater than `x` — toward negative\0A/// infinity, so `floor(-2.5)` is `-3.0`.\0Apub let Float.floor (x: Float): Float = floor_raw(x)\0A/// The smallest whole number no less than `x`.\0Apub let Float.ceil (x: Float): Float = ceil_raw(x)\0A/// The nearest whole number, halves AWAY FROM ZERO: `round(2.5)` is\0A/// `3.0` and `round(-2.5)` is `-3.0`.\0A///\0A/// `Float.to_fixed` rounds halves to EVEN, which is not an\0A/// inconsistency — it is what C, Python, Rust and Java all do, because\0A/// rounding is arithmetic and formatting is rendering.\0Apub let Float.round (x: Float): Float = round_raw(x)\0A\0A/// A float in `[0.0, 1.0)` from a process-wide generator seeded from\0A/// the clock.\0A///\0A/// Different every run, and NOT reproducible. `Rng.from_seed` is the\0A/// one for a test or a replay.\0Apub let Float.random (): Float = random_raw(true)\0A/// A float in `[lo, hi)`, from the same unseeded generator as\0A/// `Float.random`.\0Apub let Float.random_range (lo: Float) (hi: Float): Float = lo + (hi - lo) * Float.random(())\0A\0A/// --- Trigonometry, logs and constants (issue #20) ---\0A///\0A/// Angles are RADIANS everywhere, which is what libm takes and what the\0A/// inverse functions return. `Float.radians` and `Float.degrees` convert\0A/// at the edges, so a program that thinks in degrees converts once\0A/// rather than scattering `* 3.14159 / 180.0`.\0A/// Sine of an angle in RADIANS.\0Apub let Float.sin (x: Float): Float = sin_raw(x)\0A/// Cosine of an angle in radians.\0Apub let Float.cos (x: Float): Float = cos_raw(x)\0A/// Tangent of an angle in radians. Grows without bound near odd\0A/// multiples of pi/2 rather than failing.\0Apub let Float.tan (x: Float): Float = tan_raw(x)\0A/// The angle in radians whose sine is `x`, in `[-pi/2, pi/2]`. NaN\0A/// outside `[-1, 1]`.\0Apub let Float.asin (x: Float): Float = asin_raw(x)\0A/// The angle in radians whose cosine is `x`, in `[0, pi]`. NaN\0A/// outside `[-1, 1]`.\0Apub let Float.acos (x: Float): Float = acos_raw(x)\0A/// The angle in radians whose tangent is `x`. `Float.atan2` is the\0A/// one that knows which quadrant.\0Apub let Float.atan (x: Float): Float = atan_raw(x)\0A\0A/// `atan2(y, x)`, in that order, matching libm, Go, Python\0A/// and Java all use, and the reason it exists: it knows which QUADRANT\0A/// the point is in, which `atan(y / x)` cannot, and it does not divide\0A/// by zero when `x` is 0.\0Apub let Float.atan2 (y: Float) (x: Float): Float = atan2_raw(y, x)\0A\0A/// Natural log. `log2` and `log10` are separate rather than\0A/// `log(x) / log(2.0)`, because libm computes them directly and the\0A/// division loses accuracy at exactly the powers people check.\0A/// The natural logarithm. NaN for a negative argument, and negative\0A/// infinity at zero.\0Apub let Float.log (x: Float): Float = log_raw(x)\0A/// Base-2 logarithm, computed directly rather than as a division —\0A/// which is what keeps `log2(8.0)` exactly `3.0`.\0Apub let Float.log2 (x: Float): Float = log2_raw(x)\0A/// Base-10 logarithm, computed directly. See `Float.log2`.\0Apub let Float.log10 (x: Float): Float = log10_raw(x)\0A/// `e` raised to `x`.\0Apub let Float.exp (x: Float): Float = exp_raw(x)\0A\0A/// Constants as FUNCTIONS, because `Float.` is a type namespace and\0A/// `T.f(x)` is how a name gets into it. Written out to the last digit a\0A/// double can hold rather than computed, so they are exact literals and\0A/// not a rounding of something else.\0A/// Pi, to the last digit a double holds.\0Apub let Float.pi (): Float = 3.141592653589793\0A/// Two pi — a full turn, which is the more useful constant when\0A/// working with angles.\0Apub let Float.tau (): Float = 6.283185307179586\0A/// Euler's number.\0Apub let Float.e (): Float = 2.718281828459045\0A\0A/// Degrees to radians. Every trigonometric function here takes\0A/// radians, so this is the conversion at the edge.\0Apub let Float.radians (degrees: Float): Float = degrees * 3.141592653589793 / 180.0\0A/// Radians to degrees.\0Apub let Float.degrees (radians: Float): Float = radians * 180.0 / 3.141592653589793\0A\0A/// --- Seeded, reproducible random numbers (issue #20) ---\0A///\0A/// `Float.random` reads a process-global generator seeded from the\0A/// clock, which is right for \22give me something different each run\22 and\0A/// useless for a test or a replay. An `Rng` is a VALUE: same seed, same\0A/// sequence, on every platform and every run.\0A///\0A/// Every call returns the NEXT GENERATOR alongside the number, rather\0A/// than mutating in place, so a generator is as ordinary a value as an\0A/// `Int`. Threading it by hand is the cost; being able to replay a game\0A/// from a seed, or write a test that cannot flake, is what it buys. A\0A/// `Ref[Rng]` is the opt-in for in-place update.\0A///\0A/// --- Which generator, and why ---\0A///\0A/// SplitMix64: a small, modern 64-bit generator with a full 2^64\0A/// period. It is fast, has excellent bit diffusion, and is the right\0A/// generator when reproducibility and simple state matter more than\0A/// cryptographic secrecy. The wrapping multiply and logical shifts it\0A/// needs became expressible when `Int.wrapping_mul` and bitwise\0A/// operators landed.\0A///\0A/// **Not for cryptography, keys, tokens or passwords.** It is a\0A/// statistical generator and its entire state is recoverable from two\0A/// outputs.\0Apub struct Rng { state: Int }\0A\0Alet RNG_GAMMA: Int = -7046029254386353131\0Alet RNG_MIX_1: Int = -4658895280553007687\0Alet RNG_MIX_2: Int = -7723592293110705685\0Alet RNG_RANGE: Int = 9223372036854775807\0A\0A/// Any `Int` is a legal seed, including zero and negatives. SplitMix64\0A/// has no forbidden state, unlike generators whose all-zero state gets\0A/// stuck, so the seed is kept exactly rather than folded into a range.\0Apub let Rng.from_seed (seed: Int): Rng = Rng { state: seed }\0A\0Alet plum__mod_floor (a: Int) (m: Int): Int = {\0A    let r = a - (a / m) * m;\0A    if r < 0 { r + m } else { r }\0A}\0A\0A/// The raw step: advance by SplitMix64's golden-ratio increment, then\0A/// mix all 64 bits. The sign-bit mask gives callers `[0, 2^63)`, which\0A/// keeps range arithmetic non-negative without weakening the generator\0A/// state or its period.\0Alet rng_step (r: Rng): (Rng, Int) = {\0A    let next = Rng { state: Int.wrapping_add(r.state, RNG_GAMMA) };\0A    let z1 = Int.wrapping_mul(next.state ^ Int.shr_logical(next.state, 30), RNG_MIX_1);\0A    let z2 = Int.wrapping_mul(z1 ^ Int.shr_logical(z1, 27), RNG_MIX_2);\0A    (next, (z2 ^ Int.shr_logical(z2, 31)) & RNG_RANGE)\0A}\0A\0A/// A `Float` in `[0.0, 1.0)`. The upper bound is excluded, which is what\0A/// makes `lo + (hi - lo) * f` stay below `hi`.\0Apub let Rng.float (r: Rng): (Rng, Float) = {\0A    let (next, z) = rng_step(r);\0A    (next, z.to_float() / 9223372036854775808.0)\0A}\0A\0A/// A float in `[lo, hi)`, and the next generator.\0Apub let Rng