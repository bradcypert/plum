@.str7592 = private global { i64, i64, [80780 x i8] } { i64 -1, i64 80779, [80780 x i8] c"/// A value that may not be there.\0A///\0A/// Plum has no null, so absence is spelled here and the checker makes\0A/// you handle it.\0Apub enum Option[T] { Some(T), None }\0A/// A value, or an explanation of why there isn't one.\0A///\0A/// Failure is an ordinary value: no exceptions, so a function that can\0A/// fail says so in its type.\0Apub enum Result[T, E] { Ok(T), Err(E) }\0A\0A/// Whether there is a value.\0Apub let Option.is_some[T] (o: Option[T]): Bool = match o { Some(_) => true, None => false }\0A/// Whether there is no value.\0Apub let Option.is_none[T] (o: Option[T]): Bool = match o { Some(_) => false, None => true }\0A/// The first option when it contains a value, or `fallback` otherwise.\0A///\0A/// `fallback` is evaluated whether or not it is needed. Use `or_else`\0A/// when finding the fallback costs something.\0Apub let Option.or[T] (o: Option[T]) (fallback: Option[T]): Option[T] = match o { Some(_) => o, None => fallback }\0A/// The first option when it contains a value, or the result of calling\0A/// `f` otherwise. The lazy `or`: `f` runs only when it has to.\0Apub let Option.or_else[T] (o: Option[T]) (f: () -> Option[T]): Option[T] = match o { Some(_) => o, None => f() }\0A/// The value, or `fallback` when there is none.\0A///\0A/// `fallback` is evaluated whether or not it is needed. Use\0A/// `unwrap_or_else` when computing it costs something.\0Apub let Option.unwrap_or[T] (o: Option[T]) (fallback: T): T = match o { Some(v) => v, None => fallback }\0A/// The value, or the result of calling `f` when there is none. The\0A/// lazy `unwrap_or`: `f` runs only when it has to.\0Apub let Option.unwrap_or_else[T] (o: Option[T]) (f: () -> T): T = match o { Some(v) => v, None => f() }\0A/// Transforms the value if there is one, leaving `None` alone.\0Apub let Option.map[T, U] (o: Option[T]) (f: (T) -> U): Option[U] = match o { Some(v) => Some(f(v)), None => None }\0A/// Chains an operation that may itself find nothing.\0A///\0A/// `map` with a function returning `Option` would give\0A/// `Option[Option[U]]`; this is the one that keeps it flat.\0Apub let Option.and_then[T, U] (o: Option[T]) (f: (T) -> Option[U]): Option[U] = match o { Some(v) => f(v), None => None }\0A/// Turns nothing into an error, so an `Option` can join a chain of\0A/// `Result`s.\0Apub let Option.ok_or[T, E] (o: Option[T]) (err: E): Result[T, E] = match o { Some(v) => Ok(v), None => Err(err) }\0A\0A/// Whether this succeeded.\0Apub let Result.is_ok[T, E] (r: Result[T, E]): Bool = match r { Ok(_) => true, Err(_) => false }\0A/// Whether this failed.\0Apub let Result.is_err[T, E] (r: Result[T, E]): Bool = match r { Ok(_) => false, Err(_) => true }\0A/// The value, or `fallback` on failure — DISCARDING the error. Reach\0A/// for `unwrap_or_else` when the error should shape the answer.\0Apub let Result.unwrap_or[T, E] (r: Result[T, E]) (fallback: T): T = match r { Ok(v) => v, Err(_) => fallback }\0A/// The value, or the result of calling `f` with the error. The\0A/// recovery that gets to see what went wrong.\0Apub let Result.unwrap_or_else[T, E] (r: Result[T, E]) (f: (E) -> T): T = match r { Ok(v) => v, Err(e) => f(e) }\0A/// Transforms the value on success, leaving an error untouched.\0Apub let Result.map[T, E, U] (r: Result[T, E]) (f: (T) -> U): Result[U, E] = match r { Ok(v) => Ok(f(v)), Err(e) => Err(e) }\0A/// Transforms the ERROR, leaving a success untouched. For adding\0A/// context to a failure on its way up.\0Apub let Result.map_err[T, E, F] (r: Result[T, E]) (f: (E) -> F): Result[T, F] = match r { Ok(v) => Ok(v), Err(e) => Err(f(e)) }\0A/// Chains an operation that may itself fail, stopping at the first\0A/// error. The flat version of `map` over a fallible step.\0Apub let Result.and_then[T, E, U] (r: Result[T, E]) (f: (T) -> Result[U, E]): Result[U, E] = match r { Ok(v) => f(v), Err(e) => Err(e) }\0A\0A/// Whether the array has no elements.\0Apub let Array.is_empty[T] (xs: Array[T]): Bool = xs.len() == 0\0A\0Alet plum__array_concat_acc[T] (a: Array[T]) (b: Array[T]) (i: Int): Array[T] =\0A    if i >= b.len() { a } else { plum__array_concat_acc(a.push(b[i]), b, i + 1) }\0A/// A new array with `b`'s elements after `a`'s. Neither input is\0A/// changed.\0Apub let Array.concat[T] (a: Array[T]) (b: Array[T]): Array[T] = plum__array_concat_acc(a, b, 0)\0A\0Alet plum__array_contains_acc[T] (xs: Array[T]) (needle: T) (i: Int): Bool =\0A    if i >= xs.len() { false } else if xs[i] == needle { true } else { plum__array_contains_acc(xs, needle, i + 1) }\0A/// Whether any element equals `needle`, compared structurally.\0Apub let Array.contains[T] (xs: Array[T]) (needle: T): Bool = plum__array_contains_acc(xs, needle, 0)\0A\0Alet plum__array_any_acc[T] (xs: Array[T]) (f: (T) -> Bool) (i: Int): Bool =\0A    if i >= xs.len() { false } else if f(xs[i]) { true } else { plum__array_any_acc(xs, f, i + 1) }\0A/// Whether `f` holds for at least one element. Stops at the first\0A/// that passes; false for an empty array.\0Apub let Array.any[T] (xs: Array[T]) (f: (T) -> Bool): Bool = plum__array_any_acc(xs, f, 0)\0A\0A/// Clamped at both ends, like the real prelude's own: a slice past\0A/// the end is the tail, not a crash, which matters because this\0A/// backend emits no bounds check of its own.\0Alet plum__array_slice_acc[T] (xs: Array[T]) (i: Int) (end: Int) (acc: Array[T]): Array[T] =\0A    if i >= end { acc } else if i >= xs.len() { acc } else { plum__array_slice_acc(xs, i + 1, end, acc.push(xs[i])) }\0A/// The elements from `start` up to but NOT including `end`.\0A///\0A/// Out-of-range bounds are clamped rather than an error, and a `start`\0A/// past `end` gives an empty array — so slicing near the end of an\0A/// array needs no arithmetic to stay safe.\0Apub let Array.slice[T] (xs: Array[T]) (start: Int) (end: Int): Array[T] =\0A    plum__array_slice_acc(xs, if start < 0 { 0 } else { start }, end, [])\0A\0Alet plum__array_reverse_acc[T] (xs: Array[T]) (i: Int) (acc: Array[T]): Array[T] =\0A    if i < 0 { acc } else { plum__array_reverse_acc(xs, i - 1, acc.push(xs[i])) }\0A/// A new array in the opposite order.\0Apub let Array.reverse[T] (xs: Array[T]): Array[T] = plum__array_reverse_acc(xs, xs.len() - 1, [])\0A\0Alet plum__array_all_acc[T] (xs: Array[T]) (f: (T) -> Bool) (i: Int): Bool =\0A    if i >= xs.len() { true } else if f(xs[i]) { plum__array_all_acc(xs, f, i + 1) } else { false }\0A/// Whether `f` holds for every element. Stops at the first that\0A/// fails; TRUE for an empty array, which is the convention everywhere\0A/// and still surprises people.\0Apub let Array.all[T] (xs: Array[T]) (f: (T) -> Bool): Bool = plum__array_all_acc(xs, f, 0)\0A\0Alet plum__array_find_acc[T] (xs: Array[T]) (f: (T) -> Bool) (i: Int): Option[T] =\0A    if i >= xs.len() { None } else if f(xs[i]) { Some(xs[i]) } else { plum__array_find_acc(xs, f, i + 1) }\0A/// The first element `f` accepts, or `None`.\0Apub let Array.find[T] (xs: Array[T]) (f: (T) -> Bool): Option[T] = plum__array_find_acc(xs, f, 0)\0A\0Alet plum__array_find_index_acc[T] (xs: Array[T]) (f: (T) -> Bool) (i: Int): Option[Int] =\0A    if i >= xs.len() { None } else if f(xs[i]) { Some(i) } else { plum__array_find_index_acc(xs, f, i + 1) }\0A/// The index of the first element `f` accepts, or `None`.\0Apub let Array.find_index[T] (xs: Array[T]) (f: (T) -> Bool): Option[Int] = plum__array_find_index_acc(xs, f, 0)\0A\0A/// The index of the first element equal to `needle`, or `None`.\0Apub let Array.index_of[T] (xs: Array[T]) (needle: T): Option[Int] = Array.find_index(xs, |x| x == needle)\0A/// The first element, or `None` when the array is empty.\0Apub let Array.first[T] (xs: Array[T]): Option[T] = if Array.is_empty(xs) { None } else { Some(xs[0]) }\0A/// The last element, or `None` when the array is empty.\0Apub let Array.last[T] (xs: Array[T]): Option[T] = if Array.is_empty(xs) { None } else { Some(xs[xs.len() - 1]) }\0A/// The first `n` elements, or all of them if there are fewer. Never\0A/// an error.\0Apub let Array.take[T] (xs: Array[T]) (n: Int): Array[T] = Array.slice(xs, 0, n)\0A/// Everything after the first `n` elements, or nothing if there are\0A/// fewer.\0Apub let Array.drop[T] (xs: Array[T]) (n: Int): Array[T] = Array.slice(xs, n, xs.len())\0A\0A/// The sum, which OVERFLOWS like any other addition and stops the\0A/// program rather than wrapping.\0Apub let Array.sum_int (xs: Array[Int]): Int = Array.fold(xs, 0, |acc, x| acc + x)\0A/// The sum, left to right. Floating-point addition is not\0A/// associative, so a different order can give a different last digit.\0Apub let Array.sum_float (xs: Array[Float]): Float = Array.fold(xs, 0.0, |acc, x| acc + x)\0A\0A// --- Numbers ---\0A\0A/// The absolute value.\0A///\0A/// `Int.abs` of the most negative `Int` cannot be represented and\0A/// overflows, which stops the program rather than returning a negative\0A/// \22absolute\22 value.\0Apub let Int.abs (a: Int): Int = if a < 0 { 0 - a } else { a }\0A/// The smaller of two.\0Apub let Int.min (a: Int) (b: Int): Int = if a < b { a } else { b }\0A/// The larger of two.\0Apub let Int.max (a: Int) (b: Int): Int = if a > b { a } else { b }\0A/// `x` held between `lo` and `hi` inclusive. A `lo` above `hi` gives\0A/// `hi`, since the upper bound is applied last.\0Apub let Int.clamp (x: Int) (lo: Int) (hi: Int): Int = Int.min(Int.max(x, lo), hi)\0A\0A/// An UNSIGNED right shift: zeros are shifted in, never the sign\0A/// bit. `>>` is arithmetic, because `Int` is signed and `-8 >> 1`\0A/// should be -4; hashing wants the other one, and writing it by\0A/// hand is exactly the sort of thing that is wrong at n = 0 and\0A/// n = 64 in every codebase that tries.\0A///\0A/// The mask is `~(-1 << (64 - n))` and NOT `(1 << (64 - n)) - 1`,\0A/// which is the spelling everyone reaches for first and which traps\0A/// here: at n = 1 that is `(1 << 63) - 1`, and `1 << 63` is\0A/// `Int`'s most negative value, so subtracting one from it is an\0A/// integer overflow. The complement builds the same mask out of a\0A/// shift and a NOT, neither of which can overflow.\0A///\0A/// The two ends are handled before the mask because the mask cannot\0A/// express them: at n = 0 it would need all 64 bits, and `64 - 0`\0A/// is a shift of 64, which this language defines as zero.\0Apub let Int.shr_logical (x: Int) (n: Int): Int =\0A    if n <= 0 { x }\0A    else if n >= 64 { 0 }\0A    else { (x >> n) & ~((0 - 1) << (64 - n)) }\0A\0A/// The number of one bits. Counted a nibble at a time through a\0A/// lookup rather than bit by bit, so it is 16 steps and not 64.\0Apub let Int.count_ones (x: Int): Int = plum__popcount(x, 0, 0)\0A\0Alet plum__popcount (x: Int) (i: Int) (acc: Int): Int =\0A    if i >= 16 { acc }\0A    else { plum__popcount(x, i + 1, acc + PLUM_NIBBLE_ONES[Int.shr_logical(x, i * 4) & 15]) }\0A\0Alet PLUM_NIBBLE_ONES: Array[Int] = [0, 1, 1, 2, 1, 2, 2, 3, 1, 2, 2, 3, 2, 3, 3, 4]\0A\0A/// The absolute value, clearing the sign bit (including on negative zero).\0A/// NaN remains NaN.\0Apub let Float.abs (a: Float): Float = abs_raw(a)\0A/// The smaller of two. NaN does not compare, so a NaN argument gives\0A/// an answer that is not meaningful.\0Apub let Float.min (a: Float) (b: Float): Float = if a < b { a } else { b }\0A/// The larger of two. See `Float.min` on NaN.\0Apub let Float.max (a: Float) (b: Float): Float = if a > b { a } else { b }\0A/// `x` held between `lo` and `hi` inclusive.\0Apub let Float.clamp (x: Float) (lo: Float) (hi: Float): Float = Float.min(Float.max(x, lo), hi)\0A\0A/// --- Strings ---\0A///\0A/// All of these are built on `chars_of`, which is the one primitive\0A/// in `runtime.plum`. That is what makes them codepoint-safe rather\0A/// than byte-indexed, so `String.slice` can never split a multi-byte\0A/// character in half, because it never sees bytes at all.\0A/// The string with its CHARACTERS reversed, not its bytes — so text\0A/// outside ASCII survives.\0Apub let String.reverse (s: String): String = Array.concat_all(Array.reverse(chars_of(s)))\0A/// Whether the string has no bytes.\0Apub let String.is_empty (s: String): Bool = s.len() == 0\0A/// Characters from `start` up to but not including `end`, counted in\0A/// CODEPOINTS rather than bytes. Out-of-range bounds are clamped.\0Apub let String.slice (s: String) (start: Int) (end: Int): String = Array.concat_all(Array.slice(chars_of(s), start, end))\0A/// The string joined to itself `n` times. `n` of zero or less gives\0A/// an empty string.\0A/// Repeats `s` `n` times.\0A///\0A/// A LOOP with a self-rebinding accumulator, not recursion. It was\0A/// `s.concat(String.repeat(s, n - 1))`, which concatenates onto a\0A/// string one shorter each time, so the bytes allocated are\0A/// 1+2+3+...+n: quadratic. 25k characters allocated 313MB, 50k\0A/// allocated 1.25GB, 100k allocated 5.0GB, and a million never\0A/// finished.\0A///\0A/// `out = out.concat(s)` is the shape the backend can grow in place,\0A/// because the slot is overwritten with the result and nothing can\0A/// observe a mutation. Found while writing SHA-256, whose test\0A/// vector needs a million characters.\0Apub let String.repeat (s: String) (n: Int): String = {\0A    let mut out = \22\22;\0A    for i in 0..n { out = out.concat(s); };\0A    out\0A}\0A\0A/// The number of CHARACTERS in `s`, which is not `s.len()`.\0A///\0A/// `.len()` is bytes; everything else in this section is codepoints.\0A/// The two agree on ASCII and part company on anything else, so a\0A/// program that lines text up in columns wants this one; padding\0A/// computed from a byte count puts an accented name in the wrong place.\0A/// The number of CHARACTERS (codepoints). `String.len` is the number\0A/// of BYTES, and the two differ for anything outside ASCII.\0Apub let String.char_len (s: String): Int = chars_of(s).len()\0A\0A/// Pad `s` to `width` CHARACTERS with `fill`, on the left or the right.\0A///\0A/// A `fill` that is not exactly one character returns `s` untouched, as\0A/// does a string already at least `width` wide. Both are deliberate: a\0A/// formatting helper that returns a `Result` is a formatting helper\0A/// nobody uses, and truncating to fit loses data that padding was never\0A/// asked to remove.\0A/// Padded on the LEFT to `width` characters — right-aligned text.\0A///\0A/// `fill` must be a single character. A string already at or past the\0A/// width is returned unchanged: this pads, it never truncates.\0Apub let String.pad_left (s: String) (width: Int) (fill: String): String = plum__pad(s, width, fill, true)\0A/// Padded on the RIGHT to `width` characters — left-aligned text.\0A/// Never truncates; see `String.pad_left`.\0Apub let String.pad_right (s: String) (width: Int) (fill: String): String = plum__pad(s, width, fill, false)\0A\0A// --- Formatting numbers (issue #23) ---\0A//\0A// String interpolation already exists -- `\22${a} + ${b} = ${a + b}\22` --\0A// so building output is not the gap. What was missing is CONTROL over\0A// how a number renders inside one: `${1.0 / 3.0}` gives\0A// 0.3333333333333333 and there was no way to ask for two places, and\0A// `${flags}` printing 20 is the wrong view of a bit field.\0A//\0A// These are the functions a `${x:.2}` syntax would lower to. Shipping\0A// them first means that syntax, if it ever arrives, can be designed\0A// against real usage rather than guessed -- and it stays purely\0A// additive, since it would be sugar over exactly these.\0A\0A/// Centred padding, completing the set beside `pad_left`/`pad_right`.\0A/// An odd remainder goes on the RIGHT, so a column of centred headings\0A/// lines up on its left edge rather than drifting.\0Apub let String.pad_center (s: String) (width: Int) (fill: String): String = {\0A    let n = String.char_len(s);\0A    if String.char_len(fill) != 1 || n >= width { s }\0A    else {\0A        let total = width - n;\0A        let left = total / 2;\0A        String.repeat(fill, left).concat(s).concat(String.repeat(fill, total - left))\0A    }\0A}\0A\0A/// `decimals` places after the point, rounded HALF TO EVEN. Precision is\0A/// clamped to 0..17: negative values act as 0, and values above 17 act as 17.\0A/// The limit leaves one guard digit for deterministic tie handling while\0A/// staying within the precision of a `Float`.\0A///\0A/// --- Why the rounding is done here and not by the C library ---\0A///\0A/// `snprintf(\22%.*f\22)` is correctly rounded on every platform and does\0A/// not give the same answer on all of them. glibc and Microsoft's CRT\0A/// agree on every value whose expansion is not an exact tie (2.675 is\0A/// really 2.674999..., and both render it 2.67) and disagree on ties:\0A/// glibc rounds 0.5, 1.5, 2.5, 3.5 to 0, 2, 2, 4 and the Microsoft CRT\0A/// to 1, 2, 3, 4.\0A///\0A/// A language whose programs print different\0A/// numbers depending on the machine has a worse problem than one whose\0A/// rounding is a line longer, so the decision is made here: the library\0A/// is asked for a high-precision expansion, and the rounding is applied\0A/// to the digits.\0A///\0A/// --- Why half to EVEN ---\0A///\0A/// It is IEEE 754's default (`roundTiesToEven`), which is what glibc\0A/// inherits from the ambient rounding mode rather than choosing, and it\0A/// is unbiased: rounding every tie away from zero accumulates. Summing\0A/// the thousand ties 0.5 .. 999.5 gives 500,500 rounded away and\0A/// 500,000 rounded to even, against an exact 500,000.\0A///\0A/// **`Float.round` rounds half AWAY from zero and that is not an\0A/// inconsistency.** C specifies `round()` that way regardless of the FP\0A/// mode, because it is arithmetic: \22the nearest integer, ties away\22,\0A/// while this is rendering. Every language with both has this pair.\0A///\0A/// --- Why 18 digits is enough to tell a tie from a near-miss ---\0A///\0A/// A tie has to be exact. The gap between neighbouring doubles near any\0A/// value whose fractional digits matter is enormously larger than\0A/// 1e-18: next to 2.5 it is about 4.4e-16, so the value after 2.5\0A/// renders as 2.500000000000000444 and is visibly not a tie. Above\0A/// about 1e3 the fraction is all zeros anyway.\0Apub let Float.to_fixed (x: Float) (decimals: Int): String = {\0A    let d = Int.clamp(decimals, 0, 17);\0A    let raw = float_fixed_raw(x, 18);\0A    // `inf` and `nan` have no digits to round.\0A    if !String.contains(raw, \22.\22) { raw } else { plum__round_decimals(raw, d) }\0A}\0A\0Alet plum__round_decimals (s: String) (d: Int): String = {\0A    let neg = String.starts_with(s, \22-\22);\0A    let body = if neg { String.slice(s, 1, String.char_len(s)) } else { s };\0A    let dot = Option.unwrap_or(String.index_of(body, \22.\22), String.char_len(body));\0A    let ip = String.slice(body, 0, dot);\0A    let fp = String.slice(body, dot + 1, String.char_len(body));\0A    let keep = String.slice(fp, 0, d);\0A    let rest = String.slice(fp, d, String.char_len(fp));\0A    let digits = ip.concat(keep);\0A    let bumped = if plum__rounds_up(digits, rest) { plum__inc_decimal(digits) } else { digits };\0A    let n = String.char_len(bumped);\0A    let out_ip = String.slice(bumped, 0, n - d);\0A    let out_fp = String.slice(bumped, n - d, n);\0A    let text = if d == 0 { out_ip } else { out_ip.concat(\22.\22).concat(out_fp) };\0A    // The sign survives a value that rounds to zero: `-0.00` says the\0A    // value was below zero, which is information. C does this too.\0A    if neg { \22-\22.concat(text) } else { text }\0A}\0A\0A/// `rest` is everything being discarded. Above half rounds up, below\0A/// half rounds down, and an EXACT half goes to whichever direction\0A/// leaves the last kept digit even.\0Alet plum__rounds_up (kept: String) (rest: String): Bool =\0A    if String.is_empty(rest) { false }\0A    else {\0A        let first = plum__digit_at(rest, 0);\0A        if first > 5 { true }\0A        else if first < 5 { false }\0A        else if plum__any_