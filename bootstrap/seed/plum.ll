EVEREST_ENABLED)\0A        case MBEDTLS_ECDH_VARIANT_EVEREST:\0A            return mbedtls_everest_make_public(&ctx->ctx.everest_ecdh, olen,\0A                                               buf, blen, f_rng, p_rng);\0A#endif\0A        case MBEDTLS_ECDH_VARIANT_MBEDTLS_2_0:\0A            return ecdh_make_public_internal(&ctx->ctx.mbed_ecdh, olen,\0A                                             ctx->point_format, buf, blen,\0A                                             f_rng, p_rng,\0A                                             restart_enabled);\0A        default:\0A            return MBEDTLS_ERR_ECP_BAD_INPUT_DATA;\0A    }\0A#endif\0A}\0A\0Astatic int ecdh_read_public_internal(mbedtls_ecdh_context_mbed *ctx,\0A                                     const unsigned char *buf, size_t blen)\0A{\0A    int ret = MBEDTLS_ERR_ERROR_CORRUPTION_DETECTED;\0A    const unsigned char *p = buf;\0A\0A    if ((ret = mbedtls_ecp_tls_read_point(&ctx->grp, &ctx->Qp, &p,\0A                                          blen)) != 0) {\0A        return ret;\0A    }\0A\0A    if ((size_t) (p - buf) != blen) {\0A        return MBEDTLS_ERR_ECP_BAD_INPUT_DATA;\0A    }\0A\0A    return 0;\0A}\0A\0A/*\0A * Parse and import the client's public value\0A */\0Aint mbedtls_ecdh_read_public(mbedtls_ecdh_context *ctx,\0A                             const unsigned char *buf, size_t blen)\0A{\0A#if defined(MBEDTLS_ECDH_LEGACY_CONTEXT)\0A    return ecdh_read_public_internal(ctx, buf, blen);\0A#else\0A    switch (ctx->var) {\0A#if defined(MBEDTLS_ECDH_VARIANT_EVEREST_ENABLED)\0A        case MBEDTLS_ECDH_VARIANT_EVEREST:\0A            return mbedtls_everest_read_public(&ctx->ctx.everest_ecdh,\0A                                               buf, blen);\0A#endif\0A        case MBEDTLS_ECDH_VARIANT_MBEDTLS_2_0:\0A            return ecdh_read_public_internal(&ctx->ctx.mbed_ecdh,\0A                                             buf, blen);\0A        default:\0A            return MBEDTLS_ERR_ECP_BAD_INPUT_DATA;\0A    }\0A