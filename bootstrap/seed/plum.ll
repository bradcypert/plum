@.str42627 = private global { i64, i64, [20587 x i8] } { i64 -1, i64 20586, [20587 x i8] c"/*\0A *  PSA PAKE layer on top of Mbed TLS software crypto\0A */\0A/*\0A *  Copyright The Mbed TLS Contributors\0A *  SPDX-License-Identifier: Apache-2.0 OR GPL-2.0-or-later\0A */\0A\0A#include \22common.h\22\0A\0A#if defined(MBEDTLS_PSA_CRYPTO_C)\0A\0A#include <psa/crypto.h>\0A#include \22psa_crypto_core.h\22\0A#include \22psa_crypto_pake.h\22\0A#include \22psa_crypto_slot_management.h\22\0A\0A#include <mbedtls/ecjpake.h>\0A#include \22psa_util_internal.h\22\0A\0A#include <mbedtls/platform.h>\0A#include <mbedtls/error.h>\0A#include <string.h>\0A\0A/*\0A * State sequence:\0A *\0A *   psa_pake_setup()\0A *   |\0A *   |-- In any order:\0A *   |   | psa_pake_set_password_key()\0A *   |   | psa_pake_set_user()\0A *   |   | psa_pake_set_peer()\0A *   |   | psa_pake_set_role()\0A *   |\0A *   |--- In any order: (First round input before or after first round output)\0A *   |   |\0A *   |   |------ In Order\0A *   |   |       | psa_pake_output(PSA_PAKE_STEP_KEY_SHARE)\0A *   |   |       | psa_pake_output(PSA_PAKE_STEP_ZK_PUBLIC)\0A *   |   |       | psa_pake_output(PSA_PAKE_STEP_ZK_PROOF)\0A *   |   |       | psa_pake_output(PSA_PAKE_STEP_KEY_SHARE)\0A *   |   |       | psa_pake_output(PSA_PAKE_STEP_ZK_PUBLIC)\0A *   |   |       | psa_pake_output(PSA_PAKE_STEP_ZK_PROOF)\0A *   |   |\0A *   |   |------ In Order:\0A *   |           | psa_pake_input(PSA_PAKE_STEP_KEY_SHARE)\0A *   |           | psa_pake_input(PSA_PAKE_STEP_ZK_PUBLIC)\0A *   |           | psa_pake_input(PSA_PAKE_STEP_ZK_PROOF)\0A *   |           | psa_pake_input(PSA_PAKE_STEP_KEY_SHARE)\0A *   |           | psa_pake_input(PSA_PAKE_STEP_ZK_PUBLIC)\0A *   |           | psa_pake_input(PSA_PAKE_STEP_ZK_PROOF)\0A *   |\0A *   |--- In any order: (Second round input before or after second round output)\0A *   |   |\0A *   |   |------ In Order\0A *   |   |       | psa_pake_output(PSA_PAKE_STEP_KEY_SHARE)\0A *   |   |       | psa_pake_output(PSA_PAKE_STEP_ZK_PUBLIC)\0A *   |   |       | psa_pake_output(PSA_PAKE_STEP_ZK_PROOF)\0A *   |   |\0A *   |   |------ In Order:\0A *   |           | psa_pake_input(PSA_PAKE_STEP_KEY_SHARE)\0A *   |           | psa_pake_input(PSA_PAKE_STEP_ZK_PUBLIC)\0A *   |           | psa_pake_input(PSA_PAKE_STEP_ZK_PROOF)\0A *   |\0A *   psa_pake_get_implicit_key()\0A *   psa_pake_abort()\0A */\0A\0A/*\0A * Possible sequence of calls to implementation:\0A *\0A * |--- In any order:\0A * |   |\0A * |   |------ In Order\0A * |   |       | mbedtls_psa_pake_output(PSA_JPAKE_X1_STEP_KEY_SHARE)\0A * |   |       | mbedtls_psa_pake_output(PSA_JPAKE_X1_STEP_ZK_PUBLIC)\0A * |   |       | mbedtls_psa_pake_output(PSA_JPAKE_X1_STEP_ZK_PROOF)\0A * |   |       | mbedtls_psa_pake_output(PSA_JPAKE_X2_STEP_KEY_SHARE)\0A * |   |       | mbedtls_psa_pake_output(PSA_JPAKE_X2_STEP_ZK_PUBLIC)\0A * |   |       | mbedtls_psa_pake_output(PSA_JPAKE_X2_STEP_ZK_PROOF)\0A * |   |\0A * |   |------ In Order:\0A * |           | mbedtls_psa_pake_input(PSA_JPAKE_X1_STEP_KEY_SHARE)\0A * |           | mbedtls_psa_pake_input(PSA_JPAKE_X1_STEP_ZK_PUBLIC)\0A * |           | mbedtls_psa_pake_input(PSA_JPAKE_X1_STEP_ZK_PROOF)\0A * |           | mbedtls_psa_pake_input(PSA_JPAKE_X2_STEP_KEY_SHARE)\0A * |           | mbedtls_psa_pake_input(PSA_JPAKE_X2_STEP_ZK_PUBLIC)\0A * |           | mbedtls_psa_pake_input(PSA_JPAKE_X2_STEP_ZK_PROOF)\0A * |\0A * |--- In any order:\0A * |   |\0A * |   |------ In Order\0A * |   |       | mbedtls_psa_pake_output(PSA_JPAKE_X2S_STEP_KEY_SHARE)\0A * |   |       | mbedtls_psa_pake_output(PSA_JPAKE_X2S_STEP_ZK_PUBLIC)\0A * |   |       | mbedtls_psa_pake_output(PSA_JPAKE_X2S_STEP_ZK_PROOF)\0A * |   |\0A * |   |------ In Order:\0A * |           | mbedtls_psa_pake_input(PSA_JPAKE_X4S_STEP_KEY_SHARE)\0A * |           | mbedtls_psa_pake_input(PSA_JPAKE_X4S_STEP_ZK_PUBLIC)\0A * |           | mbedtls_psa_pake_input(PSA_JPAKE_X4S_STEP_ZK_PROOF)\0A */\0A\0A#if defined(MBEDTLS_PSA_BUILTIN_ALG_JPAKE)\0Astatic psa_status_t mbedtls_ecjpake_to_psa_error(int ret)\0A{\0A    switch (ret) {\0A        case MBEDTLS_ERR_MPI_BAD_INPUT_DATA:\0A        case MBEDTLS_ERR_ECP_BAD_INPUT_DATA:\0A        case MBEDTLS_ERR_ECP_INVALID_KEY:\0A        case MBEDTLS_ERR_ECP_VERIFY_FAILED:\0A            return PSA_ERROR_DATA_INVALID;\0A        case MBEDTLS_ERR_MPI_BUFFER_TOO_SMALL:\0A        case MBEDTLS_ERR_ECP_BUFFER_TOO_SMALL:\0A            return PSA_ERROR_BUFFER_TOO_SMALL;\0A        case MBEDTLS_ERR_MD_FEATURE_UNAVAILABLE:\0A            return PSA_ERROR_NOT_SUPPORTED;\0A        case MBEDTLS_ERR_ERROR_CORRUPTION_DETECTED:\0A            return PSA_ERROR_CORRUPTION_DETECTED;\0A        default:\0A            return PSA_ERROR_GENERIC_ERROR;\0A    }\0A}\0A#endif\0A\0A#if defined(MBEDTLS_PSA_BUILTIN_PAKE)\0A#if defined(MBEDTLS_PSA_BUILTIN_ALG_JPAKE)\0Astatic psa_status_t psa_pake_ecjpake_setup(mbedtls_psa_pake_operation_t *operation)\0A{\0A    int ret = MBEDTLS_ERR_ERROR_CORRUPTION_DETECTED;\0A\0A    mbedtls_ecjpake_init(&operation->ctx.jpake);\0A\0A    ret = mbedtls_ecjpake_setup(&operation->ctx.jpake,\0A                                operation->role,\0A                                MBEDTLS_MD_SHA256,\0A                                MBEDTLS_ECP_DP_SECP256R1,\0A                                operation->password,\0A                                operation->password_len);\0A\0A    mbedtls_platform_zeroize(operation->password, operation->password_len);\0A\0A    if (ret != 0) {\0A        return mbedtls_ecjpake_to_psa_error(ret);\0A    }\0A\0A    return PSA_SUCCESS;\0A}\0A#endif\0A\0A/* The only two JPAKE user/peer identifiers supported in built-in implementation. */\0Astatic const uint8_t jpake_server_id[] = { 's', 'e', 'r', 'v', 'e', 'r' };\0Astatic const uint8_t jpake_client_id[] = { 'c', 'l', 'i', 'e', 'n', 't' };\0A\0Apsa_status_t mbedtls_psa_pake_setup(mbedtls_psa_pake_operation_t *operation,\0A                                    const psa_crypto_driver_pake_inputs_t *inputs)\0A{\0A    psa_status_t status = PSA_ERROR_CORRUPTION_DETECTED;\0A    size_t user_len = 0, peer_len = 0, password_len = 0;\0A    uint8_t *peer = NULL, *user = NULL;\0A    size_t actual_user_len = 0, actual_peer_len = 0, actual_password_len = 0;\0A    psa_pake_cipher_suite_t cipher_suite = psa_pake_cipher_suite_init();\0A\0A    status = psa_crypto_driver_pake_get_password_len(inputs, &password_len);\0A    if (status != PSA_SUCCESS) {\0A        return status;\0A    }\0A\0A    status = psa_crypto_driver_pake_get_user_len(inputs, &user_len);\0A    if (status != PSA_SUCCESS) {\0A        return status;\0A    }\0A\0A    status = psa_crypto_driver_pake_get_peer_len(inputs, &peer_len);\0A    if (status != PSA_SUCCESS) {\0A        return status;\0A    }\0A\0A    status = psa_crypto_driver_pake_get_cipher_suite(inputs, &cipher_suite);\0A    if (status != PSA_SUCCESS) {\0A        return status;\0A    }\0A\0A    operation->password = mbedtls_calloc(1, password_len);\0A    if (operation->password == NULL) {\0A        status = PSA_ERROR_INSUFFICIENT_MEMORY;\0A        goto error;\0A    }\0A\0A    user = mbedtls_calloc(1, user_len);\0A    if (user == NULL) {\0A        status = PSA_ERROR_INSUFFICIENT_MEMORY;\0A        goto error;\0A    }\0A\0A    peer = mbedtls_calloc(1, peer_len);\0A    if (peer == NULL) {\0A        status = PSA_ERROR_INSUFFICIENT_MEMORY;\0A        goto error;\0A    }\0A\0A    status = psa_crypto_driver_pake_get_password(inputs, operation->password,\0A                                                 password_len, &actual_password_len);\0A    if (status != PSA_SUCCESS) {\0A        goto error;\0A    }\0A\0A    status = psa_crypto_driver_pake_get_user(inputs, user,\0A                                             user_len, &actual_user_len);\0A    if (status != PSA_SUCCESS) {\0A        goto error;\0A    }\0A\0A    status = psa_crypto_driver_pake_get_peer(inputs, peer,\0A                                             peer_len, &actual_peer_len);\0A    if (status != PSA_SUCCESS) {\0A        goto error;\0A    }\0A\0A    operation->password_len = actual_password_len;\0A    operation->alg = cipher_suite.algorithm;\0A\0A#if defined(MBEDTLS_PSA_BUILTIN_ALG_JPAKE)\0A    if (cipher_suite.algorithm == PSA_ALG_JPAKE) {\0A        if (cipher_suite.type != PSA_PAKE_PRIMITIVE_TYPE_ECC ||\0A            cipher_suite.family != PSA_ECC_FAMILY_SECP_R1 ||\0A            cipher_suite.bits != 256 ||\0A            cipher_suite.hash != PSA_ALG_SHA_256) {\0A            status = PSA_ERROR_NOT_SUPPORTED;\0A            goto error;\0A        }\0A\0A        const size_t user_peer_len = sizeof(jpake_client_id); // client and server have the same length\0A        if (actual_user_len != user_peer_len ||\0A            actual_peer_len != user_peer_len) {\0A            status = PSA_ERROR_NOT_SUPPORTED;\0A            goto error;\0A        }\0A\0A        if (memcmp(user, jpake_client_id, actual_user_len) == 0 &&\0A            memcmp(peer, jpake_server_id, actual_peer_len) == 0) {\0A            operation->role = MBEDTLS_ECJPAKE_CLIENT;\0A        } else\0A        if (memcmp(user, jpake_server_id, actual_user_len) == 0 &&\0A            memcmp(peer, jpake_client_id, actual_peer_len) == 0) {\0A            operation->role = MBEDTLS_ECJPAKE_SERVER;\0A        } else {\0A            status = PSA_ERROR_NOT_SUPPORTED;\0A            goto error;\0A        }\0A\0A        operation->buffer_length = 0;\0A        operation->buffer_offset = 0;\0A\0A        status = psa_pake_ecjpake_setup(operation);\0A        if (status != PSA_SUCCESS) {\0A            goto error;\0A        }\0A\0A        /* Role has been set, release user/peer buffers. */\0A        mbedtls_free(user); mbedtls_free(peer);\0A\0A        return PSA_SUCCESS;\0A    } else\0A#else\0A    (void) operation;\0A    (void) inputs;\0A#endif\0A    { status = PSA_ERROR_NOT_SUPPORTED; }\0A\0Aerror:\0A    mbedtls_free(user); mbedtls_free(peer);\0A    /* In case of failure of the setup of a multipart operation, the PSA driver interface\0A     * specifies that the core does not call any other driver entry point thus does not\0A     * call mbedtls_psa_pake_abort(). Therefore call it here to do the needed clean\0A     * up like freeing the memory that may have been allocated to store the password.\0A     */\0A    mbedtls_psa_pake_abort(operation);\0A    return status;\0A}\0A\0Astatic psa_status_t mbedtls_psa_pake_output_internal(\0A    mbedtls_psa_pake_operation_t *operation,\0A    psa_crypto_driver_pake_step_t step,\0A    uint8_t *output,\0A    size_t output_size,\0A    size_t *output_length)\0A{\0A    int ret = MBEDTLS_ERR_ERROR_CORRUPTION_DETECTED;\0A    size_t length;\0A    (void) step; // Unused parameter\0A\0A#if defined(MBEDTLS_PSA_BUILTIN_ALG_JPAKE)\0A    /*\0A     * The PSA CRYPTO PAKE and Mbed TLS JPAKE API have a different\0A     * handling of output sequencing.\0A     *\0A     * The Mbed TLS JPAKE API outputs the whole X1+X2 and X2S steps data\0A     * at once, on the other side the PSA CRYPTO PAKE api requires\0A     * the KEY_SHARE/ZP_PUBLIC/ZK_PROOF parts of X1, X2 & X2S to be\0A     * retrieved in sequence.\0A     *\0A     * In order to achieve API compatibility, the whole X1+X2 or X2S steps\0A     * data is stored in an intermediate buffer at first step output call,\0A     * and data is sliced down by parsing the ECPoint records in order\0A     * to return the right parts on each step.\0A     */\0A    if (operation->alg == PSA_ALG_JPAKE) {\0A        /* Initialize & write round on KEY_SHARE sequences */\0A        if (step == PSA_JPAKE_X1_STEP_KEY_SHARE) {\0A            ret = mbedtls_ecjpake_write_round_one(&operation->ctx.jpake,\0A                                                  operation->buffer,\0A                                                  sizeof(operation->buffer),\0A                                                  &operation->buffer_length,\0A                                                  mbedtls_psa_get_random,\0A                                                  MBEDTLS_PSA_RANDOM_STATE);\0A            if (ret != 0) {\0A                return mbedtls_ecjpake_to_psa_error(ret);\0A            }\0A\0A            operation->buffer_offset = 0;\0A        } else if (step == PSA_JPAKE_X2S_STEP_KEY_SHARE) {\0A            ret = mbedtls_ecjpake_write_round_two(&operation->ctx.jpake,\0A                                                  operation->buffer,\0A                                                  sizeof(operation->buffer),\0A                                                  &operation->buffer_length,\0A                                                  mbedtls_psa_get_random,\0A                                                  MBEDTLS_PSA_RANDOM_STATE);\0A            if (ret != 0) {\0A                return mbedtls_ecjpake_to_psa_error(ret);\0A            }\0A\0A            operation->buffer_offset = 0;\0A        }\0A\0A        /*\0A         * mbedtls_ecjpake_write_round_xxx() outputs thing in the format\0A         * defined by draft-cragie-tls-ecjpake-01 section 7. The summary is\0A         * that the data for each step is prepended with a length byte, and\0A         * then they're concatenated. Additionally, the server's second round\0A         * output is prepended with a 3-bytes ECParameters structure.\0A         *\0A         * In PSA, we output each step separately, and don't prepend the\0A         * output with a length byte, even less a curve identifier, as that\0A         * information is already available.\0A         */\0A        if (step == PSA_JPAKE_X2S_STEP_KEY_SHARE &&\0A            operation->role == MBEDTLS_ECJPAKE_SERVER) {\0A            /* Skip ECParameters, with is 3 bytes (RFC 8422) */\0A            operation->buffer_offset += 3;\0A        }\0A\0A        /* Read the length byte then move past it to the data */\0A        length = operation->buffer[operation->buffer_offset];\0A        operation->buffer_offset += 1;\0A\0A        if (operation->buffer_offset + length > operation->buffer_length) {\0A            return PSA_ERROR_DATA_CORRUPT;\0A        }\0A\0A        if (output_size < length) {\0A            return PSA_ERROR_BUFFER_TOO_SMALL;\0A        }\0A\0A        memcpy(output,\0A               operation->buffer + operation->buffer_offset,\0A               length);\0A        *output_length = length;\0A\0A        operation->buffer_offset += length;\0A\0A        /* Reset buffer after ZK_PROOF sequence */\0A        if ((step == PSA_JPAKE_X2_STEP_ZK_PROOF) ||\0A            (step == PSA_JPAKE_X2S_STEP_ZK_PROOF)) {\0A            mbedtls_platform_zeroize(operation->buffer, sizeof(operation->buffer));\0A            operation->buffer_length = 0;\0A            operation->buffer_offset = 0;\0A        }\0A\0A        return PSA_SUCCESS;\0A    } else\0A#else\0A    (void) step;\0A    (void) output;\0A    (void) output_size;\0A    (void) output_length;\0A#endif\0A    { return PSA_ERROR_NOT_SUPPORTED; }\0A}\0A\0Apsa_status_t mbedtls_psa_pake_output(mbedtls_psa_pake_operation_t *operation,\0A                                     psa_crypto_driver_pake_step_t step,\0A                                     uint8_t *output,\0A                                     size_t output_size,\0A                                     size_t *output_length)\0A{\0A    psa_status_t status = mbedtls_psa_pake_output_internal(\0A        operation, step, output, output_size, output_length);\0A\0A    return status;\0A}\0A\0Astatic psa_status_t mbedtls_psa_pake_input_internal(\0A    mbedtls_psa_pake_operation_t *operation,\0A    psa_crypto_driver_pake_step_t step,\0A    const uint8_t *input,\0A    size_t input_length)\0A{\0A    int ret = MBEDTLS_ERR_ERROR_CORRUPTION_DETECTED;\0A    (void) step; // Unused parameter\0A\0A#if defined(MBEDTLS_PSA_BUILTIN_ALG_JPAKE)\0A    /*\0A     * The PSA CRYPTO PAKE and Mbed TLS JPAKE API have a different\0A     * handling of input sequencing.\0A     *\0A     * The Mbed TLS JPAKE API takes the whole X1+X2 or X4S steps data\0A     * at once as input, on the other side the PSA CRYPTO PAKE api requires\0A     * the KEY_SHARE/ZP_PUBLIC/ZK_PROOF parts of X1, X2 & X4S to be\0A     * given in sequence.\0A     *\0A     * In order to achieve API compatibility, each X1+X2 or X4S step data\0A     * is stored sequentially in an intermediate buffer and given to the\0A     * Mbed TLS JPAKE API on the last step.\0A     *\0A     * This causes any input error to be only detected on the last step.\0A     */\0A    if (operation->alg == PSA_ALG_JPAKE) {\0A        /*\0A         * Copy input to local buffer and format it as the Mbed TLS API\0A         * expects, i.e. as defined by draft-cragie-tls-ecjpake-01 section 7.\0A         * The summary is that the data for each step is prepended with a\0A         * length byte, and then they're concatenated. Additionally, the\0A         * server's second round output is prepended with a 3-bytes\0A         * ECParameters structure - which means we have to prepend that when\0A         * we're a client.\0A         */\0A        if (step == PSA_JPAKE_X4S_STEP_KEY_SHARE &&\0A            operation->role == MBEDTLS_ECJPAKE_CLIENT) {\0A            /* We only support secp256r1. */\0A            /* This is the ECParameters structure defined by RFC 8422. */\0A            unsigned char ecparameters[3] = {\0A                3, /* named_curve */\0A                0, 23 /* secp256r1 */\0A            };\0A\0A            if (operation->buffer_length + sizeof(ecparameters) >\0A                sizeof(operation->buffer)) {\0A                return PSA_ERROR_BUFFER_TOO_SMALL;\0A            }\0A\0A            memcpy(operation->buffer + operation->buffer_length,\0A                   ecparameters, sizeof(ecparameters));\0A            operation->buffer_length += sizeof(ecparameters);\0A        }\0A\0A        /*\0A         * The core checks that input_length is smaller than\0A         * PSA_PAKE_INPUT_MAX_SIZE.\0A         * Thus no risk of integer overflow here.\0A         */\0A        if (operation->buffer_length + input_length + 1 > sizeof(operation->buffer)) {\0A            return PSA_ERROR_BUFFER_TOO_SMALL;\0A        }\0A\0A        /* Write the length byte */\0A        operation->buffer[operation->buffer_length] = (uint8_t) input_length;\0A        operation->buffer_length += 1;\0A\0A        /* Finally copy the data */\0A        memcpy(operation->buffer + operation->buffer_length,\0A               input, input_length);\0A        operation->buffer_length += input_length;\0A\0A        /* Load buffer at each last round ZK_PROOF */\0A        if (step == PSA_JPAKE_X2_STEP_ZK_PROOF) {\0A            ret = mbedtls_ecjpake_read_round_one(&operation->ctx.jpake,\0A                                                 operation->buffer,\0A                                                 operation->buffer_length);\0A\0A            mbedtls_platform_zeroize(operation->buffer, sizeof(operation->buffer));\0A            operation->buffer_length = 0;\0A\0A            if (ret != 0) {\0A                return mbedtls_ecjpake_to_psa_error(ret);\0A            }\0A        } else if (step == PSA_JPAKE_X4S_STEP_ZK_PROOF) {\0A            ret = mbedtls_ecjpake_read_round_two(&operation->ctx.jpake,\0A                                                 operation->buffer,\0A                                                 operation->buffer_length);\0A\0A            mbedtls_platform_zeroize(operation->buffer, sizeof(operation->buffer));\0A            operation->buffer_length = 0;\0A\0A            if (ret != 0) {\0A                return mbedtls_ecjpake_to_psa_error(ret);\0A            }\0A        }\0A\0A        return PSA_SUCCESS;\0A    } else\0A#else\0A    (void) step;\0A    (void) input;\0A    (void) input_length;\0A#endif\0A    { return PSA_ERROR_NOT_SUPPORTED; }\0A}\0A\0Apsa_status_t mbedtls_psa_pake_input(mbedtls_psa_pake_operation_t *operation,\0A                                    psa_crypto_driver_pake_step_t step,\0A                                    const uint8_t *input,\0A                                    size_t input_length)\0A{\0A    psa_status_t status = mbedtls_psa_pake_input_internal(\0A        operation, step, input, input_length);\0A\0A    return status;\0A}\0A\0Apsa_status_t mbedtls_psa_pake_get_implicit_key(\0A    mbedtls_psa_pake_operation_t *operation,\0A    uint8_t *output, size_t output_size,\0A    size_t *output_length)\0A{\0A    int ret = MBEDTLS_ERR_ERROR_CORRUPTION_DETECTED;\0A\0A#if defined(MBEDTLS_PSA_BUILTIN_ALG_JPAKE)\0A    if (operation->alg == PSA_ALG_JPAKE) {\0A        ret = mbedtls_ecjpake_write_shared_key(&operation->ctx.jpake,\0A                                               output,\0A                                               output_size,\0A                                               output_length,\0A                                               mbedtls_psa_get_random,\0A                                               MBEDTLS_PSA_RANDOM_STATE);\0A        if (ret != 0) {\0A            return mbedtls_ecjpake_to_psa_error(ret);\0A        }\0A\0A        return PSA_SUCCESS;\0A    } else\0A#else\0A    (void) output;\0A#endif\0A    { return PSA_ERROR_NOT_SUPPORTED; }\0A}\0A\0Apsa_status_t mbedtls_psa_pake_abort(mbedtls_psa_pake_operation_t *operation)\0A{\0A    mbedtls_zeroize_and_free(operation->password, operation->password_len);\0A    operation->password = NULL;\0A    operation->password_len = 0;\0A\0A#if defined(MBEDTLS_PSA_BUILTIN_ALG_JPAKE)\0A    if (operation->alg == PSA_ALG_JPAKE) {\0A        operation->role = MBEDTLS_ECJPAKE_NONE;\0A        mbedtls_platform_zeroize(operation->buffer, sizeof(operation->buffer));\0A        operation->buffer_length = 0;\0A        operation->buffer_offset = 0;\0A        mbedtls_ecjpake_free(&operation->ctx.jpake);\0A    }\0A#endif\0A\0A    operation->alg = PSA_ALG_NONE;\0A\0A    return PSA_SUCCESS;\0A}\0A\0A#endif /* MBEDTLS_PSA_BUILTIN_PAKE */\0A\0A#endif /* MBEDTLS_PSA_CRYPTO_C */\0A\00" }
