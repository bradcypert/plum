sult(const mbedtls_ssl_context *ssl);\0A\0A/**\0A * \5Cbrief          Return the id of the current ciphersuite\0A *\0A * \5Cparam ssl      SSL context\0A *\0A * \5Creturn         a ciphersuite id\0A */\0Aint mbedtls_ssl_get_ciphersuite_id_from_ssl(const mbedtls_ssl_context *ssl);\0A\0A/**\0A * \5Cbrief          Return the name of the current ciphersuite\0A *\0A * \5Cparam ssl      SSL context\0A *\0A * \5Creturn         a string containing the ciphersuite name\0A */\0Aconst char *mbedtls_ssl_get_ciphersuite(const mbedtls_ssl_context *ssl);\0A\0A\0A/**\0A * \5Cbrief          Return the (D)TLS protocol version negotiated in the\0A *                 given connection.\0A *\0A * \5Cnote           If you call this function too early during the initial\0A *                 handshake, before the two sides have agreed on a version,\0A *                 this function returns #MBEDTLS_SSL_VERSION_UNKNOWN.\0A *\0A * \5Cparam ssl      The SSL context to query.\0A * \5Creturn         The negotiated protocol version.\0A */\0Astatic inline mbedtls_ssl_protocol_version mbedtls_ssl_get_version_number(\0A    const mbedtls_ssl_context *ssl)\0A{\0A    return ssl->MBEDTLS_PRIVATE(tls_version);\0A}\0A\0A/**\0A * \5Cbrief          Return the current TLS version\0A *\0A * \5Cparam ssl      SSL context\0A *\0A * \5Creturn         a string containing the TLS version\0A */\0Aconst char *mbedtls_ssl_get_version(const mbedtls_ssl_context *ssl);\0A\0A/**\0A * \5Cbrief          Return the (maximum) number of bytes added by the record\0A *                 layer: header + encryption/MAC overhead (inc. padding)\0A *\0A * \5Cparam ssl      SSL context\0A *\0A * \5Creturn         Current maximum record expansion in bytes\0A */\0Aint mbedtls_ssl_get_record_expansion(const mbedtls_ssl_context *ssl);\0A\0A/**\0A * \5Cbrief          Return the current maximum outgoing record payload in bytes.\0A *\0A * \5Cnote           The logic to determine the maximum outgoing record payload is\0A *                 version-specific. It takes into account various factors, such as\0A *                 the mbedtls_config.h setting \5Cc MBEDTLS_SSL_OUT_CONTENT_LEN, extensions\0A *                 such as the max fragment length or record size limit extension if\0A *                 used, and for DTLS the path MTU as configured and current\0A *                 record expansion.\0A *\0A * \5Cnote           With DTLS, \5Cc mbedtls_ssl_write() will return an error if\0A *                 called with a larger length value.\0A *                 With TLS, \5Cc mbedtls_ssl_write() will fragment the input if\0A *                 necessary and return the number of bytes written; it is up\0A *                 to the caller to call \5Cc mbedtls_ssl_write() again in\0A *                 order to send the remaining bytes if any.\0A *\0A * \5Csa             mbedtls_ssl_get_max_out_record_payload()\0A * \5Csa             mbedtls_ssl_get_record_expansion()\0A *\0A * \5Cparam ssl      SSL context\0A *\0A * \5Creturn         Current maximum payload for an outgoing record,\0A *                 or a negative error code.\0A */\0Aint mbedtls_ssl_get_max_out_record_payload(const mbedtls_ssl_context *ssl);\0A\0A/**\0A * \5Cbrief          Return the current maximum incoming record payload in bytes.\0A *\0A * \5Cnote           The logic to determine the maximum incoming record payload is\0A *                 version-specific. It takes into account various factors, such as\0A *                 the mbedtls_config.h setting \5Cc MBEDTLS_SSL_IN_CONTENT_LEN, extensions\0A *                 such as the max fragment length extension or record size limit\0A *                 extension if used, and the current record expansion.\0A *\0A * \5Csa             mbedtls_ssl_set_mtu()\0A * \5Csa             mbedtls_ssl_get_max_in_record_payload()\0A * \5Csa             mbedtls_ssl_get_record_expansion()\0A *\0A * \5Cparam ssl      SSL context\0A *\0A * \5Creturn         Current maximum payload for an incoming record,\0A *                 or a negative error code.\0A */\0Aint mbedtls_ssl_get_max_in_record_payload(const mbedtls_ssl_context *ssl);\0A\0A#if defined(MBEDTLS_X509_CRT_PARSE_C)\0A/**\0A * \5Cbrief          Return the peer certificate from the current connection.\0A *\0A * \5Cparam  ssl     The SSL context to use. This must be initialized and setup.\0A *\0A * \5Creturn         The current peer certificate, if available.\0A *                 The returned certificate is owned by the SSL context and\0A *                 is valid only until the next call to the SSL API.\0A * \5Creturn         \5Cc NULL if no peer certificate is available. This might\0A *                 be because the chosen ciphersuite doesn't use CRTs\0A *                 (PSK-based ciphersuites, for example), or because\0A *                 #MBEDTLS_SSL_KEEP_PEER_CERTIFICATE has been disabled,\0A *                 allowing the stack to free the peer's CRT to save memory.\0A *\0A * \5Cnote           For one-time inspection of the peer's certificate during\0A *                 the handshake, consider registering an X.509 CRT verification\0A *                 callback through mbedtls_ssl_conf_verify() instead of calling\0A *                 this function. Using mbedtls_ssl_conf_verify() also comes at\0A *                 the benefit of allowing you to influence the verification\0A *                 process, for example by masking expected and tolerated\0A *                 verification failures.\0A *\0A * \5Cwarning        You must not use the pointer returned by this function\0A *                 after any further call to the SSL API, including\0A *                 mbedtls_ssl_read() and mbedtls_ssl_write(); this is\0A *                 because the pointer might change during renegotiation,\0A *                 which happens transparently to the user.\0A *                 If you want to use the certificate across API calls,\0A *                 you must make a copy.\0A */\0Aconst mbedtls_x509_crt *mbedtls_ssl_get_peer_cert(const mbedtls_ssl_context *ssl);\0A#endif /* MBEDTLS_X509_CRT_PARSE_C */\0A\0A#if defined(MBEDTLS_SSL_CLI_C)\0A/**\0A * \5Cbrief          Export a session in order to resume it later.\0A *\0A * \5Cparam ssl      The SSL context representing the connection for which to\0A *                 to export a session structure for later resumption.\0A * \5Cparam session  The target structure in which to store the exported session.\0A *                 This must have been initialized with mbedtls_ssl_session_init()\0A *                 but otherwise be unused.\0A *\0A * \5Cnote           This function can handle a variety of mechanisms for session\0A *                 resumption: For TLS 1.2, both session ID-based resumption and\0A *                 ticket-based resumption will be considered. For TLS 1.3,\0A *                 sessions equate to tickets, and if session tickets are\0A *                 enabled (see #MBEDTLS_SSL_SESSION_TICKETS configuration\0A *                 option), this function exports the last received ticket and\0A *                 the exported session may be used to resume the TLS 1.3\0A *                 session. If session tickets are disabled, exported sessions\0A *                 cannot be used to resume a TLS 1.3 session.\0A *\0A * \5Creturn         \5Cc 0 if successful. In this case, \5Cp session can be used for\0A *                 session resumption by passing it to mbedtls_ssl_set_session(),\0A *                 and serialized for storage via mbedtls_ssl_session_save().\0A * \5Creturn         Another negative error code on other kinds of failure.\0A *\0A * \5Csa             mbedtls_ssl_set_session()\0A * \5Csa             mbedtls_ssl_session_save()\0A */\0Aint mbedtls_ssl_get_session(const mbedtls_ssl_context *ssl,\0A                            mbedtls_ssl_session *session);\0A#endif /* MBEDTLS_SSL_CLI_C */\0A\0A/**\0A * \5Cbrief          Perform the SSL handshake\0A *\0A * \5Cparam ssl      SSL context\0A *\0A * \5Creturn         \5Cc 0 if successful.\0A * \5Creturn         #MBEDTLS_ERR_SSL_WANT_READ or #MBEDTLS_ERR_SSL_WANT_WRITE\0A *                 if the handshake is incomplete and waiting for data to\0A *                 be available for reading from or writing to the underlying\0A *                 transport - in this case you must call this function again\0A *                 when the underlying transport is ready for the operation.\0A * \5Creturn         #MBEDTLS_ERR_SSL_ASYNC_IN_PROGRESS if an asynchronous\0A *                 operation is in progress (see\0A *                 mbedtls_ssl_conf_async_private_cb()) - in this case you\0A *                 must call this function again when the operation is ready.\0A * \5Creturn         #MBEDTLS_ERR_SSL_CRYPTO_IN_PROGRESS if a cryptographic\0A *                 operation is in progress (see mbedtls_ecp_set_max_ops()) -\0A *                 in this case you must call this function again to complete\0A *                 the handshake when you're done attending other tasks.\0A * \5Creturn         #MBEDTLS_ERR_SSL_HELLO_VERIFY_REQUIRED if DTLS is in use\0A *                 and the client did not demonstrate reachability yet - in\0A *                 this case you must stop using the context (see below).\0A * \5Creturn         #MBEDTLS_ERR_SSL_RECEIVED_NEW_SESSION_TICKET if a TLS 1.3\0A *                 NewSessionTicket message has been received. See the\0A *                 documentation of mbedtls_ssl_read() for more information\0A *                 about this error code.\0A * \5Creturn         #MBEDTLS_ERR_SSL_RECEIVED_EARLY_DATA if early data, as\0A *                 defined in RFC 8446 (TLS 1.3 specification), has been\0A *                 received as part of the handshake. This is server specific\0A *                 and may occur only if the early data feature has been\0A *                 enabled on server (see mbedtls_ssl_conf_early_data()\0A *                 documentation). You must call mbedtls_ssl_read_early_data()\0A *                 to read the early data before resuming the handshake.\0A * \5Creturn         Another SSL error code - in this case you must stop using\0A *                 the context (see below).\0A *\0A * \5Cwarning        If this function returns something other than\0A *                 \5Cc 0,\0A *                 #MBEDTLS_ERR_SSL_WANT_READ,\0A *                 #MBEDTLS_ERR_SSL_WANT_WRITE,\0A *                 #MBEDTLS_ERR_SSL_ASYNC_IN_PROGRESS or\0A *                 #MBEDTLS_ERR_SSL_CRYPTO_IN_PROGRESS or\0A *                 #MBEDTLS_ERR_SSL_RECEIVED_NEW_SESSION_TICKET or\0A *                 #MBEDTLS_ERR_SSL_RECEIVED_EARLY_DATA,\0A *                 you must stop using the SSL context for reading or writing,\0A *                 and either free it or call \5Cc mbedtls_ssl_session_reset()\0A *                 on it before re-using it for a new connection; the current\0A *                 connection must be closed.\0A *\0A * \5Cnote           If DTLS is in use, then you may choose to handle\0A *                 #MBEDTLS_ERR_SSL_HELLO_VERIFY_REQUIRED specially for logging\0A *                 purposes, as it is an expected return value rather than an\0A *                 actual error, but you still need to reset/free the context.\0A *\0A * \5Cnote           Remarks regarding event-driven DTLS:\0A *                 If the function returns #MBEDTLS_ERR_SSL_WANT_READ, no datagram\0A *                 from the underlying transport layer is currently being processed,\0A *                 and it is safe to idle until the timer or the underlying transport\0A *                 signal a new event. This is not true for a successful handshake,\0A *                 in which case the datagram of the underlying transport that is\0A *                 currently being processed might or might not contain further\0A *                 DTLS records.\0A *\0A * \5Cnote           If #MBEDTLS_USE_PSA_CRYPTO is enabled, the PSA crypto\0A *                 subsystem must have been initialized by calling\0A *                 psa_crypto_init() before calling this function.\0A *                 Otherwise, the handshake may call psa_crypto_init()\0A *                 if a negotiation involving TLS 1.3 takes place (this may\0A *                 be the case even if TLS 1.3 is offered but eventually\0A *                 not selected).\0A *\0A * \5Cnote           In TLS, reception of fragmented handshake messages is\0A *                 supported with some limitations (those limitations do\0A *                 not apply to DTLS, where defragmentation is fully\0A *                 supported):\0A *                 - On an Mbed TLS server that only accepts TLS 1.2,\0A *                   the initial ClientHello message must not be fragmented.\0A *                   A TLS 1.2 ClientHello may be fragmented if the server\0A *                   also accepts TLS 1.3 connections (meaning\0A *                   that #MBEDTLS_SSL_PROTO_TLS1_3 enabled, and the\0A *                   accepted versions have not been restricted with\0A *                   mbedtls_ssl_conf_max_tls_version() or the like).\0A *                 - The first fragment of a handshake message must be\0A *                   at least 4 bytes long.\0A *                 - Non-handshake records must not be interleaved between\0A *                   the fragments of a handshake message. (This is permitted\0A *                   in TLS 1.2 but not in TLS 1.3, but Mbed TLS rejects it\0A *                   even in TLS 1.2.)\0A */\0Aint mbedtls_ssl_handshake(mbedtls_ssl_context *ssl);\0A\0A/**\0A * \5Cbrief          After calling mbedtls_ssl_handshake() to start the SSL\0A *                 handshake you can call this function to check whether the\0A *                 handshake is over for a given SSL context. This function\0A *                 should be also used to determine when to stop calling\0A *                 mbedtls_handshake_step() for that context.\0A *\0A * \5Cparam ssl      SSL context\0A *\0A * \5Creturn         \5Cc 1 if handshake is over, \5Cc 0 if it is still ongoing.\0A */\0Astatic inline int mbedtls_ssl_is_handshake_over(mbedtls_ssl_context *ssl)\0A{\0A    return ssl->MBEDTLS_PRIVATE(state) >= MBEDTLS_SSL_HANDSHAKE_OVER;\0A}\0A\0A/**\0A * \5Cbrief          Perform a single step of the SSL handshake\0A *\0A * \5Cnote           The state of the context (ssl->state) will be at\0A *                 the next state after this function returns \5Cc 0. Do not\0A *                 call this function if mbedtls_ssl_is_handshake_over()\0A *                 returns \5Cc 1.\0A *\0A * \5Cwarning        Whilst in the past you may have used direct access to the\0A *                 context state (ssl->state) in order to ascertain when to\0A *                 stop calling this function and although you can still do\0A *                 so with something like ssl->MBEDTLS_PRIVATE(state) or by\0A *                 defining MBEDTLS_ALLOW_PRIVATE_ACCESS, this is now\0A *                 considered deprecated and could be broken in any future\0A *                 release. If you still find you have good reason for such\0A *                 direct access, then please do contact the team to explain\0A *                 this (raise an issue or post to the mailing list), so that\0A *                 we can add a solution to your problem that will be\0A *                 guaranteed to work in the future.\0A *\0A * \5Cparam ssl      SSL context\0A *\0A * \5Creturn         See mbedtls_ssl_handshake().\0A *\0A * \5Cwarning        If this function returns something other than \5Cc 0,\0A *                 #MBEDTLS_ERR_SSL_WANT_READ, #MBEDTLS_ERR_SSL_WANT_WRITE,\0A *                 #MBEDTLS_ERR_SSL_ASYNC_IN_PROGRESS,\0A *                 #MBEDTLS_ERR_SSL_CRYPTO_IN_PROGRESS or\0A *                 #MBEDTLS_ERR_SSL_RECEIVED_NEW_SESSION_TICKET or\0A *                 #MBEDTLS_ERR_SSL_RECEIVED_EARLY_DATA, you must stop using\0A *                 the SSL context for reading or writing, and either free it\0A *                 or call \5Cc mbedtls_ssl_session_reset() on it before\0A *                 re-using it for a new connection; the current connection\0A *                 must be closed.\0A */\0Aint mbedtls_ssl_handshake_step(mbedtls_ssl_context *ssl);\0A\0A#if defined(MBEDTLS_SSL_RENEGOTIATION)\0A/**\0A * \5Cbrief          Initiate an SSL renegotiation on the running connection.\0A *                 Client: perform the renegotiation right now.\0A *                 Server: request renegotiation, which will be performed\0A *                 during the next call to mbedtls_ssl_read() if honored by\0A *                 client.\0A *\0A * \5Cparam ssl      SSL context\0A *\0A * \5Creturn         0 if successful, or any mbedtls_ssl_handshake() return\0A *                 value except #MBEDTLS_ERR_SSL_CLIENT_RECONNECT that can't\0A *                 happen during a renegotiation.\0A *\0A * \5Cwarning        If this function returns something other than \5Cc 0,\0A *                 #MBEDTLS_ERR_SSL_WANT_READ, #MBEDTLS_ERR_SSL_WANT_WRITE,\0A *                 #MBEDTLS_ERR_SSL_ASYNC_IN_PROGRESS or\0A *                 #MBEDTLS_ERR_SSL_CRYPTO_IN_PROGRESS, you must stop using\0A *                 the SSL context for reading or writing, and either free it\0A *                 or call \5Cc mbedtls_ssl_session_reset() on it before\0A *                 re-using it for a new connection; the current connection\0A *                 must be closed.\0A *\0A */\0Aint mbedtls_ssl_renegotiate(mbedtls_ssl_context *ssl);\0A#endif /* MBEDTLS_SSL_RENEGOTIATION */\0A\0A/**\0A * \5Cbrief          Read at most 'len' application data bytes\0A *\0A * \5Cparam ssl      SSL context\0A * \5Cparam buf      buffer that will hold the data\0A * \5Cparam len      maximum number of bytes to read\0A *\0A * \5Creturn         The (positive) number of bytes read if successful.\0A * \5Creturn         \5Cc 0 if the read end of the underlying transport was closed\0A *                 without sending a CloseNotify beforehand, which might happen\0A *                 because of various reasons (internal error of an underlying\0A *                 stack, non-conformant peer not sending a CloseNotify and\0A *                 such) - in this case you must stop using the context\0A *                 (see below).\0A * \5Creturn         #MBEDTLS_ERR_SSL_PEER_CLOSE_NOTIFY if the underlying\0A *                 transport is still functional, but the peer has\0A *                 acknowledged to not send anything anymore.\0A * \5Creturn         #MBEDTLS_ERR_SSL_WANT_READ or #MBEDTLS_ERR_SSL_WANT_WRITE\0A *                 if the handshake is incomplete and waiting for data to\0A *                 be available for reading from or writing to the underlying\0A *                 transport - in this case you must call this function again\0A *                 when the underlying transport is ready for the operation.\0A * \5Creturn         #MBEDTLS_ERR_SSL_ASYNC_IN_PROGRESS if an asynchronous\0A *                 operation is in progress (see\0A *                 mbedtls_ssl_conf_async_private_cb()) - in this case you\0A *                 must call this function again when the operation is ready.\0A * \5Creturn         #MBEDTLS_ERR_SSL_CRYPTO_IN_PROGRESS if a cryptographic\0A *                 operation is in progress (see mbedtls_ecp_set_max_ops()) -\0A *                 in this case you must call this function again to complete\0A *                 the handshake when you're done attending other tasks.\0A * \5Creturn         #MBEDTLS_ERR_SSL_CLIENT_RECONNECT if we're at the server\0A *                 side of a DTLS connection and the client is initiating a\0A *                 new connection using the same source port. See below.\0A * \5Creturn         #MBEDTLS_ERR_SSL_RECEIVED_NEW_SESSION_TICKET if a TLS 1.3\0A *                 NewSessionTicket message has been received.\0A *                 This error code is only returned on the client side. It is\0A *                 only returned if handling of TLS 1.3 NewSessionTicket\0A *                 messages has been enabled through\0A *                 mbedtls_ssl_conf_tls13_enable_signal_new_session_tickets().\0A *                 This error code indicates that a TLS 1.3 NewSessionTicket\0A *                 message has been received and parsed successfully by the\0A *                 client. The ticket data can be retrieved from the SSL\0A *                 context by calling mbedtls_ssl_get_session(). It remains\0A *                 available until the next call to mbedtls_ssl_read().\0A * \5Creturn         #MBEDTLS_ERR_SSL_RECEIVED_EARLY_DATA if early data, as\0A *                 defined in RFC 8446 (TLS 1.3 specification), has been\0A *                 received as part of the handshake. This is server specific\0A *                 and may occur only if the early data feature has been\0A *                 enabled on server (see mbedtls_ssl_conf_early_data()\0A *                 documentation). You must call mbedtls_ssl_read_early_data()\0A *                 to read the early data before resuming the handshake.\0A * \5Creturn         Another SSL error code - in this case you must stop using\0A *                 the context (see below).\0A *\0A * \5Cwarning        If this function returns something other than\0A *                 a positive value,\0A *                 #MBEDTLS_ERR_SSL_WANT_READ,\0A *                 #MBEDTLS_ERR_SSL_WANT_WRITE,\0A *                 #MBEDTLS_ERR_SSL_ASYNC_IN_PROGRESS,\0A *                 #MBEDTLS_ERR_SSL_CRYPTO_IN_PROGRESS,\0A *                 #MBEDTLS_ERR_SSL_CLIENT_RECONNECT or\0A *                 #MBEDTLS_ERR_SSL_RECEIVED_NEW_SESSION_TICKET or\0A *                 #MBEDTLS_ERR_SSL_RECEIVED_EARLY_DATA,\0A *                 you must stop using the SSL context for reading or writing,\0A *                 and either free it or call \5Cc mbedtls_ssl_session_reset()\0A *                 on it before re-using it for a new connection; the current\0A *                 connection must be closed.\0A *\0A * \5Cnote           When this function returns #MBEDTLS_ERR_SSL_CLIENT_RECONNECT\0A *                 (which can only happen server-side), it means that a client\0A *                 is initiating a new connection using the same source port.\0A *                 You can either treat that as a connection close and wait\0A *                 for the client to resend a ClientHello, or directly\0A *                 continue with \5Cc mbedtls_ssl_handshake() with the same\0A *                 context (as it has been reset internally). Either way, you\0A *                 must make sure this is seen by the application as a new\0A *                 connection: application state, if any, should be reset, and\0A *                 most importantly the identity of the client must be checked\0A *                 again. WARNING: not validating the identity of the client\0A *                 again, or not transmitting the new identity to the\0A *                 application layer, would allow authentication bypass!\0A *\0A * \5Cnote           Remarks regarding event-driven DTLS:\0A *                 - If the function returns #MBEDTLS_ERR_SSL_WANT_READ, no datagram\0A *                   from the underlying transport layer is currently being processed,\0A *                   and it is safe to idle until the timer or the underlying transport\0A *                   signal a new event.\0A *                 - This function may return MBEDTLS_ERR_SSL_WANT_READ even if data was\0A *                   initially available on the underlying transport, as this data may have\0A *                   been only e.g. duplicated messages or a renegotiation request.\0A *                   Therefore, you must be prepared to receive MBEDTLS_ERR_SSL_WANT_READ even\0A *                   when reacting to an incoming-data event from the underlying transport.\0A *                 - On success, the datagram of the underlying transport that is currently\0A *                   being processed may contain further DTLS records. You should call\0A *                   \5Cc mbedtls_ssl_check_pending to check for remaining records.\0A *\0A */\0Aint mbedtls_ssl_read(mbedtls_ssl_context *ssl, unsigned char *buf, size_t len);\0A\0A/**\0A * \5Cbrief          Try to write exactly 'len' application data bytes\0A *\0A * \5Cwarning        This function will do partial writes in some cases. If the\0A *                 return value is non-negative but less than length, the\0A *                 function must be called again with updated arguments:\0A *                 buf + ret, len - ret (if ret is the return value) until\0A *                 it returns a value equal to the last 'len' argument.\0A *\0A * \5Cparam ssl      SSL context\0A * \5Cparam buf      buffer holding the data\0A * \5Cparam len      how many bytes must be written\0A *\0A * \5Creturn         The (non-negative) number of bytes actually written if\0A *                 successful (may be less than \5Cp len).\0A * \5Creturn         #MBEDTLS_ERR_SSL_WANT_READ or #MBEDTLS_ERR_SSL_WANT_WRITE\0A *                 if the handshake is incomplete and waiting for data to\0A *                 be available for reading from or writing to the underlying\0A *                 transport - in this case you must call this function again\0A *                 when the underlying transport is ready for the operation.\0A * \5Creturn         #MBEDTLS_ERR_SSL_ASYNC_IN_PROGRESS if an asynchronous\0A *                 operation is in progress (see\0A *                 mbedtls_ssl_conf_async_private_cb()) - in this case you\0A *                 must call this function again when the operation is ready.\0A * \5Creturn         #MBEDTLS_ERR_SSL_CRYPTO_IN_PROGRESS if a cryptographic\0A *                 operation is in progress (see mbedtls_ecp_set_max_ops()) -\0A *                 in this case you must call this function again to complete\0A *                 the handshake when you're done attending other tasks.\0A * \5Creturn         #MBEDTLS_ERR_SSL_RECEIVED_NEW_SESSION_TICKET if a TLS 1.3\0A *                 NewSessionTicket message has been received. See the\0A *                 documentation of mbedtls_ssl_read() for more information\0A *                 about this error code.\0A * \5Creturn         #MBEDTLS_ERR_SSL_RECEIVED_EARLY_DATA if early data, as\0A *                 defined in RFC 8446 (TLS 1.3 specification), has been\0A *                 received as part of the handshake. This is server specific\0A *                 and may occur only if the early data feature has been\0A *                 enabled on server (see mbedtls_ssl_conf_early_data()\0A *                 documentation). You must call mbedtls_ssl_read_early_data()\0A *                 to read the early data before resuming the handshake.\0A * \5Creturn         Another SSL error code - in this case you must stop using\0A *                 the context (see below).\0A *\0A * \5Cwarning        If this function returns something other than\0A *                 a non-negative value,\0A *                 #MBEDTLS_ERR_SSL_WANT_READ,\0A *                 #MBEDTLS_ERR_SSL_WANT_WRITE,\0A *                 #MBEDTLS_ERR_SSL_ASYNC_IN_PROGRESS,\0A *                 #MBEDTLS_ERR_SSL_CRYPTO_IN_PROGRESS or\0A *                 #MBEDTLS_ERR_SSL_RECEIVED_NEW_SESSION_TICKET or\0A *                 #MBEDTLS_ERR_SSL_RECEIVED_EARLY_DATA,\0A *                 you must stop using the SSL context for reading or writing,\0A *                 and either free it or call \5Cc mbedtls_ssl_session_reset()\0A *                 on it before re-using it for a new connection; the current\0A *                 connection must be closed.\0A *\0A * \5Cnote           When this function returns #MBEDTLS_ERR_SSL_WANT_WRITE/READ,\0A *                 it must be called later with the *same* arguments,\0A *                 until it returns a value greater than or equal to 0. When\0A *                 the function returns #MBEDTLS_ERR_SSL_WANT_WRITE there may be\0A *                 some partial data in the output buffer, however this is not\0A *                 yet sent.\0A *\0A * \5Cnote           If the requested length is greater than the maximum\0A *                 fragment length (either the built-in limit or the one set\0A *                 or negotiated with the peer), then:\0A *                 - with TLS, less bytes than requested are written.\0A *                 - with DTLS, MBEDTLS_ERR_SSL_BAD_INPUT_DATA is returned.\0A *                 \5Cc mbedtls_ssl_get_max_out_record_payload() may be used to\0A *                 query the active maximum fragment length.\0A *\0A * \5Cnote           Attempting to write 0 bytes will result in an empty TLS\0A *                 application record being sent.\0A */\0Aint mbedtls_ssl_write(mbedtls_ssl_context *ssl, const unsigned char *buf, size_t len);\0A\0A/**\0A * \5Cbrief           Send an alert message\0A *\0A * \5Cparam ssl       SSL context\0A * \5Cparam level     The alert level of the message\0A *                  (MBEDTLS_SSL_ALERT_LEVEL_WARNING or MBEDTLS_SSL_ALERT_LEVEL_FATAL)\0A * \5Cparam message   The alert message (SSL_ALERT_MSG_*)\0A *\0A * \5Creturn          0 if successful, or a specific SSL error code.\0A *\0A * \5Cnote           If this function returns something other than 0 or\0A *                 MBEDTLS_ERR_SSL_WANT_READ/WRITE, you must stop using\0A *                 the SSL context for reading or writing, and either free it or\0A *                 call \5Cc mbedtls_ssl_session_reset() on it before re-using it\0A *                 for a new connection; the current connection must be closed.\0A */\0Aint mbedtls_ssl_send_alert_message(mbedtls_ssl_context *ssl,\0A                                   unsigned char level,\0A                                   unsigned char message);\0A/**\0A * \5Cbrief          Notify the peer that the connection is being closed\0A *\0A * \5Cparam ssl      SSL context\0A *\0A * \5Creturn          0 if successful, or a specific SSL error code.\0A *\0A * \5Cnote           If this function returns something other than 0 or\0A *                 MBEDTLS_ERR_SSL_WANT_READ/WRITE, you must stop using\0A *                 the SSL context for reading or writing, and either free it or\0A *                 call \5Cc mbedtls_ssl_session_reset() on it before re-using it\0A *                 for a new connection; the current connection must be closed.\0A */\0Aint mbedtls_ssl_close_notify(mbedtls_ssl_context *ssl);\0A\0A#if defined(MBEDTLS_SSL_EARLY_DATA)\0A\0A#if defined(MBEDTLS_SSL_SRV_C)\0A/**\0A * \5Cbrief          Read at most 'len' bytes of early data\0A *\0A * \5Cnote           This API is server specific.\0A *\0A * \5Cwarning        Early data is defined in the TLS 1.3 specification, RFC 8446.\0A *                 IMPORTANT NOTE from section 2.3 of the specification:\0A *\0A *                 The security properties for 0-RTT data are weaker than\0A *                 those for other kinds of TLS data. Specifically:\0A *                 - This data is not forward secret, as it is encrypted\0A *                   solely under keys derived using the offered PSK.\0A *                 - There are no guarantees of non-replay between connections.\0A *                   Protection against replay for ordinary TLS 1.3 1-RTT data\0A *                   is provided via the server's Random value, but 0-RTT data\0A *                   does not depend on the ServerHello and therefore has\0A *                   weaker guarantees. This is especially relevant if the\0A *                   data is authenticated either with TLS client\0A *                   authentication or inside the application protocol. The\0A *                   same warnings apply to any use of the\0A *                   early_exporter_master_secret.\0A *\0A * \5Cwarning        Mbed TLS does not implement any of the anti-replay defenses\0A *                 defined in section 8 of the TLS 1.3 specification:\0A *                 single-use of tickets or ClientHello recording within a\0A *                 given time window.\0A *\0A * \5Cnote           This function is used in conjunction with\0A *                 mbedtls_ssl_handshake(), mbedtls_ssl_handshake_step(),\0A *                 mbedtls_ssl_read() and mbedtls_ssl_write() to read early\0A *                 data when these functions return\0A *                 #MBEDTLS_ERR_SSL_RECEIVED_EARLY_DATA.\0A *\0A * \5Cparam ssl      SSL context, it must have been initialized and set up.\0A * \5Cparam buf      buffer that will hold the data\0A * \5Cparam len      maximum number of bytes to read\0A *\0A * \5Creturn         The (positive) number of bytes read if successful.\0A * \5Creturn         #MBEDTLS_ERR_SSL_BAD_INPUT_DATA if input data is invalid.\0A * \5Creturn         #MBEDTLS_ERR_SSL_CANNOT_READ_EARLY_DATA if it is not\0A *                 possible to read early data for the SSL context \5Cp ssl. Note\0A *                 that this function is intended to be called for an SSL\0A *                 context \5Cp ssl only after a call to mbedtls_ssl_handshake(),\0A *                 mbedtls_ssl_handshake_step(), mbedtls_ssl_read() or\0A *                 mbedtls_ssl_write() for \5Cp ssl that has returned\0A *                 #MBEDTLS_ERR_SSL_RECEIVED_EARLY_DATA.\0A */\0Aint mbedtls_ssl_read_early_data(mbedtls_ssl_context *ssl,\0A                                unsigned char *buf, size_t len);\0A#endif /* MBEDTLS_SSL_SRV_C */\0A\0A#if defined(MBEDTLS_SSL_CLI_C)\0A/**\0A * \5Cbrief          Try to write exactly 'len' application data bytes while\0A *                 performing the handshake (early data).\0A *\0A * \5Cwarning        Early data is defined in the TLS 1.3 specification, RFC 8446.\0A *                 IMPORTANT NOTE from section 2.3 of the specification:\0A *\0A *                 The security properties for 0-RTT data are weaker than\0A *                 those for other kinds of TLS data. Specifically:\0A *                 - This data is not forward secret, as it is encrypted\0A *                   solely under keys derived using the offered PSK.\0A *                 - There are no guarantees of non-replay between connections.\0A *                   Protection against replay for ordinary TLS 1.3 1-RTT data\0A *                   is provided via the server's Random value, but 0-RTT data\0A *                   does not depend on the ServerHello and therefore has\0A *                   weaker guarantees. This is especially relevant if the\0A *                   data is authenticated either with TLS client\0A *                   authentication or inside the application protocol. The\0A *                   same warnings apply to any use of the\0A *                   early_exporter_master_secret.\0A *\0A * \5Cnote           This function behaves mainly as mbedtls_ssl_write(). The\0A *                 specification of mbedtls_ssl_write() relevant to TLS 1.3\0A *                 (thus not the parts specific to (D)TLS1.2) applies to this\0A *                 function and the present documentation is mainly restricted\0A *                 to the differences with mbedtls_ssl_write(). One noticeable\0A *                 difference though is that mbedtls_ssl_write() aims to\0A *                 complete the handshake before to write application data\0A *                 while mbedtls_ssl_write_early() aims to drive the handshake\0A *                 just past the point where it is not possible to send early\0A *                 data anymore.\0A *\0A * \5Cparam ssl      SSL context\0A * \5Cparam buf      buffer holding the data\0A * \5Cparam len      how many bytes must be written\0A *\0A * \5Creturn         The (non-negative) number of bytes actually written if\0A *                 successful (may be less than \5Cp len).\0A *\0A * \5Creturn         One additional specific error code compared to\0A *                 mbedtls_ssl_write():\0A *                 #MBEDTLS_ERR_SSL_CANNOT_WRITE_EARLY_DATA.\0A *\0A *                 #MBEDTLS_ERR_SSL_CANNOT_WRITE_EARLY_DATA is returned when it\0A *                 is not possible to write early data for the SSL context\0A *                 \5Cp ssl.\0A *\0A *                 It may have been possible and it is not possible\0A *                 anymore because the client received the server Finished\0A *                 message, the server rejected early data or the maximum\0A *                 number of allowed early data for the PSK in use has been\0A *                 reached.\0A *\0A *                 It may never have been possible and will never be possible\0A *                 for the SSL context \5Cp ssl because the use of early data\0A *                 is disabled for that context or more generally the context\0A *                 is not suitably configured to enable early data or the first\0A *                 call to the function was done while the handshake was\0A *                 already completed.\0A *\0A *                 It is not possible to write early data for the SSL context\0A *                 \5Cp ssl and any subsequent call to this API will return this\0A *                 error code. But this does not preclude for using it with\0A *                 mbedtls_ssl_write(), mbedtls_ssl_read() or\0A *                 mbedtls_ssl_handshake() and the handshake can be\0A *                 completed by calling one of these APIs.\0A *\0A * \5Cnote           This function may write early data only if the SSL context\0A *                 has been configured for the handshake with a PSK for which\0A *                 early data is allowed.\0A *\0A * \5Cnote           To maximize the number of early data that can be written in\0A *                 the course of the handshake, it is expected that this\0A *                 function starts the handshake for the SSL context \5Cp ssl.\0A *                 But this is not mandatory.\0A *\0A * \5Cnote           This function does not provide any information on whether\0A *                 the server has accepted or will accept early data or not.\0A *                 When it returns a positive value, it just means that it\0A *                 has written early data to the server. To know whether the\0A *                 server has accepted early data or not, you should call\0A *                 mbedtls_ssl_get_early_data_status() with the handshake\0A *                 completed.\0A */\0Aint mbedtls_ssl_write_early_data(mbedtls_ssl_context *ssl,\0A                                 const unsigned char *buf, size_t len);\0A\0A/**\0A * \5Cbrief Get the status of the negotiation of the use of early data.\0A *\0A * \5Cparam ssl      The SSL context to query\0A *\0A * \5Creturn         #MBEDTLS_ERR_SSL_BAD_INPUT_DATA if this function is called\0A *                 from the server-side.\0A *\0A * \5Creturn         #MBEDTLS_ERR_SSL_BAD_INPUT_DATA if this function is called\0A *                 prior to completion of the handshake.\0A *\0A * \5Creturn         #MBEDTLS_SSL_EARLY_DATA_STATUS_NOT_INDICATED if the client\0A *                 has not indicated the use of early data to the server.\0A *\0A * \5Creturn         #MBEDTLS_SSL_EARLY_DATA_STATUS_ACCEPTED if the client has\0A *                 indicated the use of early data and the server has accepted\0A *                 it.\0A *\0A * \5Creturn         #MBEDTLS_SSL_EARLY_DATA_STATUS_REJECTED if the client has\0A *                 indicated the use of early data but the server has rejected\0A *                 it. In this situation, the client may want to re-send the\0A *                 early data it may have tried to send by calling\0A *                 mbedtls_ssl_write_early_data() as ordinary post-handshake\0A *                 application data by calling mbedtls_ssl_write().\0A *\0A */\0Aint mbedtls_ssl_get_early_data_status(mbedtls_ssl_context *ssl);\0A#endif /* MBEDTLS_SSL_CLI_C */\0A\0A#endif /* MBEDTLS_SSL_EARLY_DATA */\0A\0A/**\0A * \5Cbrief          Free referenced items in an SSL context and clear memory\0A *\0A * \5Cparam ssl      SSL context\0A */\0Avoid mbedtls_ssl_free(mbedtls_ssl_context *ssl);\0A\0A#if defined(MBEDTLS_SSL_CONTEXT_SERIALIZATION)\0A/**\0A * \5Cbrief          Save an active connection as serialized data in a buffer.\0A *                 This allows the freeing or re-using of the SSL context\0A *                 while still picking up the connection later in a way that\0A *                 it entirely transparent to the peer.\0A *\0A * \5Csee            mbedtls_ssl_context_load()\0A *\0A * \5Cnote           The serialized data only contains the data that is\0A *                 necessary to resume the connection: negotiated protocol\0A *                 options, session identifier, keys, etc.\0A *                 Loading a saved SSL context does not restore settings and\0A *                 state related to how the application accesses the context,\0A *                 such as configured callback functions, user data, pending\0A *                 incoming or outgoing data, etc.\0A *\0A * \5Cnote           This feature is currently only available under certain\0A *                 conditions, see the documentation of the return value\0A *                 #MBEDTLS_ERR_SSL_BAD_INPUT_DATA for details.\0A *\0A * \5Cnote           When this function succeeds, it calls\0A *                 mbedtls_ssl_session_reset() on \5Cp ssl which as a result is\0A *                 no longer associated with the connection that has been\0A *                 serialized. This avoids creating copies of the connection\0A *                 state. You're then free to either re-use the context\0A *                 structure for a different connection, or call\0A *                 mbedtls_ssl_free() on it. See the documentation of\0A *                 mbedtls_ssl_session_reset() for more details.\0A *\0A * \5Cparam ssl      The SSL context to save. On success, it is no longer\0A *                 associated with the connection that has been serialized.\0A * \5Cparam buf      The buffer to write the serialized data to. It must be a\0A *                 writeable buffer of at least \5Cp buf_len bytes, or may be \5Cc\0A *                 NULL if \5Cp buf_len is \5Cc 0.\0A * \5Cparam buf_len  The number of bytes available for writing in \5Cp buf.\0A * \5Cparam olen     The size in bytes of the data that has been or would have\0A *                 been written. It must point to a valid \5Cc size_t.\0A *\0A * \5Cnote           \5Cp olen is updated to the correct value regardless of\0A *                 whether \5Cp buf_len was large enough. This makes it possible\0A *                 to determine the necessary size by calling this function\0A *                 with \5Cp buf set to \5Cc NULL and \5Cp buf_len to \5Cc 0. However,\0A *                 the value of \5Cp olen is only guaranteed to be correct when\0A *                 the function returns #MBEDTLS_ERR_SSL_BUFFER_TOO_SMALL or\0A *                 \5Cc 0. If the return value is different, then the value of\0A *                 \5Cp olen is undefined.\0A *\0A * \5Creturn         \5Cc 0 if successful.\0A * \5Creturn         #MBEDTLS_ERR_SSL_BUFFER_TOO_SMALL if \5Cp buf is too small.\0A * \5Creturn         #MBEDTLS_ERR_SSL_ALLOC_FAILED if memory allocation failed\0A *                 while resetting the context.\0A * \5Creturn         #MBEDTLS_ERR_SSL_BAD_INPUT_DATA if a handshake is in\0A *                 progress, or there is pending data for reading or sending,\0A *                 or the connection does not use DTLS 1.2 with an AEAD\0A *                 ciphersuite, or renegotiation is enabled.\0A */\0Aint mbedtls_ssl_context_save(mbedtls_ssl_context *ssl,\0A                             unsigned char *buf,\0A                             size_t buf_len,\0A                             size_t *olen);\0A\0A/**\0A * \5Cbrief          Load serialized connection data to an SSL context.\0A *\0A * \5Csee            mbedtls_ssl_context_save()\0A *\0A * \5Cwarning        The same serialized data must never be loaded into more\0A *                 that one context. In order to ensure that, after\0A *                 successfully loading serialized data to an SSL context, you\0A *                 should immediately destroy or invalidate all copies of the\0A *                 serialized data that was loaded. Loading the same data in\0A *                 more than one context would cause severe security failures\0A *                 including but not limited to loss of confidentiality.\0A *\0A * \5Cnote           Before calling this function, the SSL context must be\0A *                 prepared in one of the two following ways. The first way is\0A *                 to take a context freshly initialised with\0A *                 mbedtls_ssl_init() and call mbedtls_ssl_setup() on it with\0A *                 the same ::mbedtls_ssl_config structure that was used in\0A *                 the original connection. The second way is to\0A *                 call mbedtls_ssl_session_reset() on a context that was\0A *                 previously prepared as above but used in the meantime.\0A *                 Either way, you must not use the context to perform a\0A *                 handshake between calling mbedtls_ssl_setup() or\0A *                 mbedtls_ssl_session_reset() and calling this function. You\0A *                 may however call other setter functions in that time frame\0A *                 as indicated in the note below.\0A *\0A * \5Cnote           Before or after calling this function successfully, you\0A *                 also need to configure some connection-specific callbacks\0A *                 and settings before you can use the connection again\0A *                 (unless they were already set before calling\0A *                 mbedtls_ssl_session_reset() and the values are suitable for\0A *                 the present connection). Specifically, you want to call\0A *                 at least mbedtls_ssl_set_bio(),\0A *                 mbedtls_ssl_set_timer_cb(), and\0A *                 mbedtls_ssl_set_user_data_n() or\0A *                 mbedtls_ssl_set_user_data_p() if they were set originally.\0A *                 All other SSL setter functions\0A *                 are not necessary to call, either because they're only used\0A *                 in handshakes, or because the setting is already saved. You\0A *                 might choose to call them anyway, for example in order to\0A *                 share code between the cases of establishing a new\0A *                 connection and the case of loading an already-established\0A *                 connection.\0A *\0A * \5Cnote           If you have new information about the path MTU, you want to\0A *                 call mbedtls_ssl_set_mtu() after calling this function, as\0A *                 otherwise this function would overwrite your\0A *                 newly-configured value with the value that was active when\0A *                 the context was saved.\0A *\0A * \5Cnote           When this function returns an error code, it calls\0A *                 mbedtls_ssl_free() on \5Cp ssl. In this case, you need to\0A *                 prepare the context with the usual sequence starting with a\0A *                 call to mbedtls_ssl_init() if you want to use it again.\0A *\0A * \5Cparam ssl      The SSL context structure to be populated. It must have\0A *                 been prepared as described in the note above.\0A * \5Cparam buf      The buffer holding the serialized connection data. It must\0A *                 be a readable buffer of at least \5Cp len bytes.\0A * \5Cparam len      The size of the serialized data in bytes.\0A *\0A * \5Creturn         \5Cc 0 if successful.\0A * \5Creturn         #MBEDTLS_ERR_SSL_ALLOC_FAILED if memory allocation failed.\0A * \5Creturn         #MBEDTLS_ERR_SSL_VERSION_MISMATCH if the serialized data\0A *                 comes from a different Mbed TLS version or build.\0A * \5Creturn         #MBEDTLS_ERR_SSL_BAD_INPUT_DATA if input data is invalid.\0A */\0Aint mbedtls_ssl_context_load(mbedtls_ssl_context *ssl,\0A                             const unsigned char *buf,\0A                             size_t len);\0A#endif /* MBEDTLS_SSL_CONTEXT_SERIALIZATION */\0A\0A/**\0A * \5Cbrief          Initialize an SSL configuration context\0A *                 Just makes the context ready for\0A *                 mbedtls_ssl_config_defaults() or mbedtls_ssl_config_free().\0A *\0A * \5Cnote           You need to call mbedtls_ssl_config_defaults() unless you\0A *                 manually set all of the relevant fields yourself.\0A *\0A * \5Cparam conf     SSL configuration context\0A */\0Avoid mbedtls_ssl_config_init(mbedtls_ssl_config *conf);\0A\0A/**\0A * \5Cbrief          Load reasonable default SSL configuration values.\0A *                 (You need to call mbedtls_ssl_config_init() first.)\0A *\0A * \5Cparam conf     SSL configuration context\0A * \5Cparam endpoint MBEDTLS_SSL_IS_CLIENT or MBEDTLS_SSL_IS_SERVER\0A * \5Cparam transport MBEDTLS_SSL_TRANSPORT_STREAM for TLS, or\0A *                  MBEDTLS_SSL_TRANSPORT_DATAGRAM for DTLS\0A * \5Cparam preset   a MBEDTLS_SSL_PRESET_XXX value\0A *\0A * \5Cnote           See \5Cc mbedtls_ssl_conf_transport() for notes on DTLS.\0A *\0A * \5Creturn         0 if successful, or\0A *                 MBEDTLS_ERR_XXX_ALLOC_FAILED on memory allocation error.\0A */\0Aint mbedtls_ssl_config_defaults(mbedtls_ssl_config *conf,\0A                                int endpoint, int transport, int preset);\0A\0A/**\0A * \5Cbrief          Free an SSL configuration context\0A *\0A * \5Cparam conf     SSL configuration context\0A */\0Avoid mbedtls_ssl_config_free(mbedtls_ssl_config *conf);\0A\0A/**\0A * \5Cbrief          Initialize SSL session structure\0A *\0A * \5Cparam session  SSL session\0A */\0Avoid mbedtls_ssl_session_init(mbedtls_ssl_session *session);\0A\0A/**\0A * \5Cbrief          Free referenced items in an SSL session including the\0A *                 peer certificate and clear memory\0A *\0A * \5Cnote           A session object can be freed even if the SSL context\0A *                 that was used to retrieve the session is still in use.\0A *\0A * \5Cparam session  SSL session\0A */\0Avoid mbedtls_ssl_session_free(mbedtls_ssl_session *session);\0A\0A/**\0A * \5Cbrief          TLS-PRF function for key derivation.\0A *\0A * \5Cparam prf      The tls_prf type function type to be used.\0A * \5Cparam secret   Secret for the key derivation function.\0A * \5Cparam slen     Length of the secret.\0A * \5Cparam label    String label for the key derivation function,\0A *                 terminated with null character.\0A * \5Cparam random   Random bytes.\0A * \5Cparam rlen     Length of the random bytes buffer.\0A * \5Cparam dstbuf   The buffer holding the derived key.\0A * \5Cparam dlen     Length of the output buffer.\0A *\0A * \5Creturn         0 on success. An SSL specific error on failure.\0A */\0Aint  mbedtls_ssl_tls_prf(const mbedtls_tls_prf_types prf,\0A                         const unsigned char *secret, size_t slen,\0A                         const char *label,\0A                         const unsigned char *random, size_t rlen,\0A                         unsigned char *dstbuf, size_t dlen);\0A\0A#ifdef __cplusplus\0A}\0A#endif\0A\0A#endif /* ssl.h */\0A\00" }
