\0A                    pthread_mutex_unlock(&plum_sel_lock);\0A                    *out = v;\0A                    return i;\0A                }\0A            }\0A            pthread_mutex_unlock(&plum_sel_lock);\0A            return -1;\0A        }\0A    }\0A}\0A\0A// Blocks until a value is available. The `while` (not `if`) is the\0A// standard guard against spurious wakeups, which pthread condition\0A// variables are explicitly permitted to produce.\0Avoid *channel_recv(long long handle) {\0A    plum_chan *c = (plum_chan *)(intptr_t)handle;\0A    if (!c) return NULL;\0A    pthread_mutex_lock(&c->lock);\0A    while (!c->head) {\0A        pthread_cond_wait(&c->ready, &c->lock);\0A    }\0A    plum_chan_node *n = c->head;\0A    c->head = n->next;\0A    if (!c->head) c->tail = NULL;\0A    pthread_mutex_unlock(&c->lock);\0A    void *v = n->value;\0A    free(n);\0A    return v;\0A}\0A\0A// One end of the channel has let go.\0A//\0A// Anything still QUEUED when the last end goes was sent and never\0A// received, and it holds references of its own -- so the drain\0A// releases each value through `rel` rather than just freeing boxes.\0A// `rel` is null for an element type that owns nothing.\0Avoid channel_release(long long handle, void (*rel)(void *)) {\0A    plum_chan *c = (plum_chan *)(intptr_t)handle;\0A    if (!c) return;\0A    pthread_mutex_lock(&c->lock);\0A    c->refs--;\0A    int dead = (c->refs == 0);\0A    plum_chan_node *n = dead ? c->head : NULL;\0A    if (dead) { c->head = NULL; c->tail = NULL; }\0A    pthread_mutex_unlock(&c->lock);\0A    if (!dead) return;\0A    while (n) {\0A        plum_chan_node *next = n->next;\0A        if (rel) rel(*(void **)n->value);\0A        free(n->value);\0A        free(n);\0A        n = next;\0A    }\0A    pthread_mutex_destroy(&c->lock);\0A    pthread_cond_destroy(&c->ready);\0A    free(c);\0A}\0A\00" }
