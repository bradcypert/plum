\0A    const unsigned char *p = data;\0A    memcpy(buf, p + test_offset, len);\0A    test_offset += len;\0A    return 0;\0A}\0A\0A#define CHK(c)    if ((c) != 0)                          \5C\0A    {                                       \5C\0A        if (verbose != 0)                  \5C\0A        mbedtls_printf(\22failed\5Cn\22);  \5C\0A        return 1;                        \5C\0A    }\0A\0A/*\0A * Checkup routine for HMAC_DRBG with SHA-1\0A */\0Aint mbedtls_hmac_drbg_self_test(int verbose)\0A{\0A    mbedtls_hmac_drbg_context ctx;\0A    unsigned char buf[OUTPUT_LEN];\0A    const mbedtls_md_info_t *md_info = mbedtls_md_info_from_type(MBEDTLS_MD_SHA1);\0A\0A    mbedtls_hmac_drbg_init(&ctx);\0A\0A    /*\0A     * PR = True\0A     */\0A    if (verbose != 0) {\0A        mbedtls_printf(\22  HMAC_DRBG (PR = True) : \22);\0A    }\0A\0A    test_offset = 0;\0A    CHK(mbedtls_hmac_drbg_seed(&ctx, md_info,\0A                               hmac_drbg_self_test_entropy, (void *) entropy_pr,\0A                               NULL, 0));\0A    mbedtls_hmac_drbg_set_prediction_resistance(&ctx, MBEDTLS_HMAC_DRBG_PR_ON);\0A    CHK(mbedtls_hmac_drbg_random(&ctx, buf, OUTPUT_LEN));\0A    CHK(mbedtls_hmac_drbg_random(&ctx, buf, OUTPUT_LEN));\0A    CHK(memcmp(buf, result_pr, OUTPUT_LEN));\0A    mbedtls_hmac_drbg_free(&ctx);\0A\0A    mbedtls_hmac_drbg_free(&ctx);\0A\0A    if (verbose != 0) {\0A        mbedtls_printf(\22passed\5Cn\22);\0A    }\0A\0A    /*\0A     * PR = False\0A     */\0A    if (verbose != 0) {\0A        mbedtls_printf(\22  HMAC_DRBG (PR = False) : \22);\0A    }\0A\0A    mbedtls_hmac_drbg_init(&ctx);\0A\0A    test_offset = 0;\0A    CHK(mbedtls_hmac_drbg_seed(&ctx, md_info,\0A                               hmac_drbg_self_test_entropy, (void *) entropy_nopr,\0A                               NULL, 0));\0A    CHK(mbedtls_hmac_drbg_reseed(&ctx, NULL, 0));\0A    CHK(mbedtls_hmac_drbg_random(&ctx, buf, OUTPUT_LEN));\0A    CHK(mbedtls_hmac_drbg_random(&ctx, buf, OUTPUT_LEN));\0A   