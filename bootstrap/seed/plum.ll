@.str42467 = private global { i64, i64, [52642 x i8] } { i64 -1, i64 52641, [52642 x i8] c"/*\0A *  Public Key abstraction layer: wrapper functions\0A *\0A *  Copyright The Mbed TLS Contributors\0A *  SPDX-License-Identifier: Apache-2.0 OR GPL-2.0-or-later\0A */\0A\0A#include \22common.h\22\0A\0A#include \22mbedtls/platform_util.h\22\0A\0A#if defined(MBEDTLS_PK_C)\0A#include \22pk_wrap.h\22\0A#include \22pk_internal.h\22\0A#include \22mbedtls/error.h\22\0A#include \22mbedtls/psa_util.h\22\0A\0A/* Even if RSA not activated, for the sake of RSA-alt */\0A#include \22mbedtls/rsa.h\22\0A\0A#if defined(MBEDTLS_ECP_C)\0A#include \22mbedtls/ecp.h\22\0A#endif\0A\0A#if defined(MBEDTLS_ECDSA_C)\0A#include \22mbedtls/ecdsa.h\22\0A#endif\0A\0A#if defined(MBEDTLS_USE_PSA_CRYPTO)\0A#include \22psa_util_internal.h\22\0A#include \22psa/crypto.h\22\0A#include \22mbedtls/psa_util.h\22\0A\0A#if defined(MBEDTLS_RSA_C)\0A#include \22pkwrite.h\22\0A#include \22rsa_internal.h\22\0A#endif\0A\0A#if defined(MBEDTLS_PK_CAN_ECDSA_SOME)\0A#include \22mbedtls/asn1write.h\22\0A#include \22mbedtls/asn1.h\22\0A#endif\0A#endif  /* MBEDTLS_USE_PSA_CRYPTO */\0A\0A#include \22mbedtls/platform.h\22\0A\0A#include <limits.h>\0A#include <stdint.h>\0A#include <string.h>\0A\0A#if defined(MBEDTLS_RSA_C)\0Astatic int rsa_can_do(mbedtls_pk_type_t type)\0A{\0A    return type == MBEDTLS_PK_RSA ||\0A           type == MBEDTLS_PK_RSASSA_PSS;\0A}\0A\0Astatic size_t rsa_get_bitlen(mbedtls_pk_context *pk)\0A{\0A    const mbedtls_rsa_context *rsa = (const mbedtls_rsa_context *) pk->pk_ctx;\0A    return mbedtls_rsa_get_bitlen(rsa);\0A}\0A\0A#if defined(MBEDTLS_USE_PSA_CRYPTO)\0Astatic int rsa_verify_wrap(mbedtls_pk_context *pk, mbedtls_md_type_t md_alg,\0A                           const unsigned char *hash, size_t hash_len,\0A                           const unsigned char *sig, size_t sig_len)\0A{\0A    mbedtls_rsa_context *rsa = (mbedtls_rsa_context *) pk->pk_ctx;\0A    int ret = MBEDTLS_ERR_ERROR_CORRUPTION_DETECTED;\0A    psa_key_attributes_t attributes = PSA_KEY_ATTRIBUTES_INIT;\0A    mbedtls_svc_key_id_t key_id = MBEDTLS_SVC_KEY_ID_INIT;\0A    psa_status_t status;\0A    int key_len;\0A    unsigned char buf[MBEDTLS_PK_RSA_PUB_DER_MAX_BYTES];\0A    unsigned char *p = buf + sizeof(buf);\0A    psa_algorithm_t psa_alg_md;\0A    size_t rsa_len = mbedtls_rsa_get_len(rsa);\0A\0A#if SIZE_MAX > UINT_MAX\0A    if (md_alg == MBEDTLS_MD_NONE && UINT_MAX < hash_len) {\0A        return MBEDTLS_ERR_PK_BAD_INPUT_DATA;\0A    }\0A#endif\0A\0A    if (mbedtls_rsa_get_padding_mode(rsa) == MBEDTLS_RSA_PKCS_V21) {\0A        psa_alg_md = PSA_ALG_RSA_PSS(mbedtls_md_psa_alg_from_type(md_alg));\0A    } else {\0A        psa_alg_md = PSA_ALG_RSA_PKCS1V15_SIGN(mbedtls_md_psa_alg_from_type(md_alg));\0A    }\0A\0A    if (sig_len < rsa_len) {\0A        return MBEDTLS_ERR_RSA_VERIFY_FAILED;\0A    }\0A\0A    key_len = mbedtls_rsa_write_pubkey(rsa, buf, &p);\0A    if (key_len <= 0) {\0A        return MBEDTLS_ERR_PK_BAD_INPUT_DATA;\0A    }\0A\0A    psa_set_key_usage_flags(&attributes, PSA_KEY_USAGE_VERIFY_HASH);\0A    psa_set_key_algorithm(&attributes, psa_alg_md);\0A    psa_set_key_type(&attributes, PSA_KEY_TYPE_RSA_PUBLIC_KEY);\0A\0A    status = psa_import_key(&attributes,\0A                            buf + sizeof(buf) - key_len, key_len,\0A                            &key_id);\0A    if (status != PSA_SUCCESS) {\0A        ret = PSA_PK_TO_MBEDTLS_ERR(status);\0A        goto cleanup;\0A    }\0A\0A    status = psa_verify_hash(key_id, psa_alg_md, hash, hash_len,\0A                             sig, sig_len);\0A    if (status != PSA_SUCCESS) {\0A        ret = PSA_PK_RSA_TO_MBEDTLS_ERR(status);\0A        goto cleanup;\0A    }\0A    ret = 0;\0A\0Acleanup:\0A    status = psa_destroy_key(key_id);\0A    if (ret == 0 && status != PSA_SUCCESS) {\0A        ret = PSA_PK_TO_MBEDTLS_ERR(status);\0A    }\0A\0A    return ret;\0A}\0A#else /* MBEDTLS_USE_PSA_CRYPTO */\0Astatic int rsa_verify_wrap(mbedtls_pk_context *pk, mbedtls_md_type_t md_alg,\0A                           const unsigned char *hash, size_t hash_len,\0A                           const unsigned char *sig, size_t sig_len)\0A{\0A    int ret = MBEDTLS_ERR_ERROR_CORRUPTION_DETECTED;\0A    mbedtls_rsa_context *rsa = (mbedtls_rsa_context *) pk->pk_ctx;\0A    size_t rsa_len = mbedtls_rsa_get_len(rsa);\0A\0A#if SIZE_MAX > UINT_MAX\0A    if (md_alg == MBEDTLS_MD_NONE && UINT_MAX < hash_len) {\0A        return MBEDTLS_ERR_PK_BAD_INPUT_DATA;\0A    }\0A#endif\0A\0A    if (sig_len < rsa_len) {\0A        return MBEDTLS_ERR_RSA_VERIFY_FAILED;\0A    }\0A\0A    if ((ret = mbedtls_rsa_pkcs1_verify(rsa, md_alg,\0A                                        (unsigned int) hash_len,\0A                                        hash, sig)) != 0) {\0A        return ret;\0A    }\0A\0A    /* The buffer contains a valid signature followed by extra data.\0A     * We have a special error code for that so that so that callers can\0A     * use mbedtls_pk_verify() to check \22Does the buffer start with a\0A     * valid signature?\22 and not just \22Does the buffer contain a valid\0A     * signature?\22. */\0A    if (sig_len > rsa_len) {\0A        return MBEDTLS_ERR_PK_SIG_LEN_MISMATCH;\0A    }\0A\0A    return 0;\0A}\0A#endif /* MBEDTLS_USE_PSA_CRYPTO */\0A\0A#if defined(MBEDTLS_USE_PSA_CRYPTO)\0Aint  mbedtls_pk_psa_rsa_sign_ext(psa_algorithm_t alg,\0A                                 mbedtls_rsa_context *rsa_ctx,\0A                                 const unsigned char *hash, size_t hash_len,\0A                                 unsigned char *sig, size_t sig_size,\0A                                 size_t *sig_len)\0A{\0A    int ret = MBEDTLS_ERR_ERROR_CORRUPTION_DETECTED;\0A    psa_key_attributes_t attributes = PSA_KEY_ATTRIBUTES_INIT;\0A    mbedtls_svc_key_id_t key_id = MBEDTLS_SVC_KEY_ID_INIT;\0A    psa_status_t status;\0A    int key_len;\0A    unsigned char *buf = NULL;\0A    unsigned char *p;\0A\0A    buf = mbedtls_calloc(1, MBEDTLS_PK_RSA_PRV_DER_MAX_BYTES);\0A    if (buf == NULL) {\0A        return MBEDTLS_ERR_PK_ALLOC_FAILED;\0A    }\0A    p = buf + MBEDTLS_PK_RSA_PRV_DER_MAX_BYTES;\0A\0A    *sig_len = mbedtls_rsa_get_len(rsa_ctx);\0A    if (sig_size < *sig_len) {\0A        mbedtls_free(buf);\0A        return MBEDTLS_ERR_PK_BUFFER_TOO_SMALL;\0A    }\0A\0A    key_len = mbedtls_rsa_write_key(rsa_ctx, buf, &p);\0A    if (key_len <= 0) {\0A        mbedtls_free(buf);\0A        return MBEDTLS_ERR_PK_BAD_INPUT_DATA;\0A    }\0A    psa_set_key_usage_flags(&attributes, PSA_KEY_USAGE_SIGN_HASH);\0A    psa_set_key_algorithm(&attributes, alg);\0A    psa_set_key_type(&attributes, PSA_KEY_TYPE_RSA_KEY_PAIR);\0A\0A    status = psa_import_key(&attributes,\0A                            buf + MBEDTLS_PK_RSA_PRV_DER_MAX_BYTES - key_len, key_len,\0A                            &key_id);\0A    if (status != PSA_SUCCESS) {\0A        ret = PSA_PK_TO_MBEDTLS_ERR(status);\0A        goto cleanup;\0A    }\0A    status = psa_sign_hash(key_id, alg, hash, hash_len,\0A                           sig, sig_size, sig_len);\0A    if (status != PSA_SUCCESS) {\0A        ret = PSA_PK_RSA_TO_MBEDTLS_ERR(status);\0A        goto cleanup;\0A    }\0A\0A    ret = 0;\0A\0Acleanup:\0A    mbedtls_free(buf);\0A    status = psa_destroy_key(key_id);\0A    if (ret == 0 && status != PSA_SUCCESS) {\0A        ret = PSA_PK_TO_MBEDTLS_ERR(status);\0A    }\0A    return ret;\0A}\0A#endif /* MBEDTLS_USE_PSA_CRYPTO */\0A\0A#if defined(MBEDTLS_USE_PSA_CRYPTO)\0Astatic int rsa_sign_wrap(mbedtls_pk_context *pk, mbedtls_md_type_t md_alg,\0A                         const unsigned char *hash, size_t hash_len,\0A                         unsigned char *sig, size_t sig_size, size_t *sig_len,\0A                         int (*f_rng)(void *, unsigned char *, size_t), void *p_rng)\0A{\0A    ((void) f_rng);\0A    ((void) p_rng);\0A\0A    psa_algorithm_t psa_md_alg;\0A    psa_md_alg = mbedtls_md_psa_alg_from_type(md_alg);\0A    if (psa_md_alg == 0) {\0A        return MBEDTLS_ERR_PK_BAD_INPUT_DATA;\0A    }\0A    psa_algorithm_t psa_alg;\0A    if (mbedtls_rsa_get_padding_mode(mbedtls_pk_rsa(*pk)) == MBEDTLS_RSA_PKCS_V21) {\0A        psa_alg = PSA_ALG_RSA_PSS(psa_md_alg);\0A    } else {\0A        psa_alg = PSA_ALG_RSA_PKCS1V15_SIGN(psa_md_alg);\0A    }\0A\0A    return mbedtls_pk_psa_rsa_sign_ext(psa_alg, pk->pk_ctx, hash, hash_len,\0A                                       sig, sig_size, sig_len);\0A}\0A#else /* MBEDTLS_USE_PSA_CRYPTO */\0Astatic int rsa_sign_wrap(mbedtls_pk_context *pk, mbedtls_md_type_t md_alg,\0A                         const unsigned char *hash, size_t hash_len,\0A                         unsigned char *sig, size_t sig_size, size_t *sig_len,\0A                         int (*f_rng)(void *, unsigned char *, size_t), void *p_rng)\0A{\0A    mbedtls_rsa_context *rsa = (mbedtls_rsa_context *) pk->pk_ctx;\0A\0A#if SIZE_MAX > UINT_MAX\0A    if (md_alg == MBEDTLS_MD_NONE && UINT_MAX < hash_len) {\0A        return MBEDTLS_ERR_PK_BAD_INPUT_DATA;\0A    }\0A#endif\0A\0A    *sig_len = mbedtls_rsa_get_len(rsa);\0A    if (sig_size < *sig_len) {\0A        return MBEDTLS_ERR_PK_BUFFER_TOO_SMALL;\0A    }\0A\0A    return mbedtls_rsa_pkcs1_sign(rsa, f_rng, p_rng,\0A                                  md_alg, (unsigned int) hash_len,\0A                                  hash, sig);\0A}\0A#endif /* MBEDTLS_USE_PSA_CRYPTO */\0A\0A#if defined(MBEDTLS_USE_PSA_CRYPTO)\0Astatic int rsa_decrypt_wrap(mbedtls_pk_context *pk,\0A                            const unsigned char *input, size_t ilen,\0A                            unsigned char *output, size_t *olen, size_t osize,\0A                            int (*f_rng)(void *, unsigned char *, size_t), void *p_rng)\0A{\0A    mbedtls_rsa_context *rsa = (mbedtls_rsa_context *) pk->pk_ctx;\0A    int ret = MBEDTLS_ERR_ERROR_CORRUPTION_DETECTED;\0A    psa_key_attributes_t attributes = PSA_KEY_ATTRIBUTES_INIT;\0A    mbedtls_svc_key_id_t key_id = MBEDTLS_SVC_KEY_ID_INIT;\0A    psa_algorithm_t psa_md_alg, decrypt_alg;\0A    psa_status_t status;\0A    int key_len;\0A    unsigned char buf[MBEDTLS_PK_RSA_PRV_DER_MAX_BYTES];\0A    unsigned char *p = buf + sizeof(buf);\0A\0A    ((void) f_rng);\0A    ((void) p_rng);\0A\0A    if (ilen != mbedtls_rsa_get_len(rsa)) {\0A        return MBEDTLS_ERR_RSA_BAD_INPUT_DATA;\0A    }\0A\0A    key_len = mbedtls_rsa_write_key(rsa, buf, &p);\0A    if (key_len <= 0) {\0A        return MBEDTLS_ERR_PK_BAD_INPUT_DATA;\0A    }\0A\0A    psa_set_key_type(&attributes, PSA_KEY_TYPE_RSA_KEY_PAIR);\0A    psa_set_key_usage_flags(&attributes, PSA_KEY_USAGE_DECRYPT);\0A    if (mbedtls_rsa_get_padding_mode(rsa) == MBEDTLS_RSA_PKCS_V21) {\0A        psa_md_alg = mbedtls_md_psa_alg_from_type((mbedtls_md_type_t) mbedtls_rsa_get_md_alg(rsa));\0A        decrypt_alg = PSA_ALG_RSA_OAEP(psa_md_alg);\0A    } else {\0A        decrypt_alg = PSA_ALG_RSA_PKCS1V15_CRYPT;\0A    }\0A    psa_set_key_algorithm(&attributes, decrypt_alg);\0A\0A    status = psa_import_key(&attributes,\0A                            buf + sizeof(buf) - key_len, key_len,\0A                            &key_id);\0A    if (status != PSA_SUCCESS) {\0A        ret = PSA_PK_TO_MBEDTLS_ERR(status);\0A        goto cleanup;\0A    }\0A\0A    status = psa_asymmetric_decrypt(key_id, decrypt_alg,\0A                                    input, ilen,\0A                                    NULL, 0,\0A                                    output, osize, olen);\0A    if (status != PSA_SUCCESS) {\0A        ret = PSA_PK_RSA_TO_MBEDTLS_ERR(status);\0A        goto cleanup;\0A    }\0A\0A    ret = 0;\0A\0Acleanup:\0A    mbedtls_platform_zeroize(buf, sizeof(buf));\0A    status = psa_destroy_key(key_id);\0A    if (ret == 0 && status != PSA_SUCCESS) {\0A        ret = PSA_PK_TO_MBEDTLS_ERR(status);\0A    }\0A\0A    return ret;\0A}\0A#else /* MBEDTLS_USE_PSA_CRYPTO */\0Astatic int rsa_decrypt_wrap(mbedtls_pk_context *pk,\0A                            const unsigned char *input, size_t ilen,\0A                            unsigned char *output, size_t *olen, size_t osize,\0A                            int (*f_rng)(void *, unsigned char *, size_t), void *p_rng)\0A{\0A    mbedtls_rsa_context *rsa = (mbedtls_rsa_context *) pk->pk_ctx;\0A\0A    if (ilen != mbedtls_rsa_get_len(rsa)) {\0A        return MBEDTLS_ERR_RSA_BAD_INPUT_DATA;\0A    }\0A\0A    return mbedtls_rsa_pkcs1_decrypt(rsa, f_rng, p_rng,\0A                                     olen, input, output, osize);\0A}\0A#endif /* MBEDTLS_USE_PSA_CRYPTO */\0A\0A#if defined(MBEDTLS_USE_PSA_CRYPTO)\0Astatic int rsa_encrypt_wrap(mbedtls_pk_context *pk,\0A                            const unsigned char *input, size_t ilen,\0A                            unsigned char *output, size_t *olen, size_t osize,\0A                            int (*f_rng)(void *, unsigned char *, size_t), void *p_rng)\0A{\0A    mbedtls_rsa_context *rsa = (mbedtls_rsa_context *) pk->pk_ctx;\0A    int ret = MBEDTLS_ERR_ERROR_CORRUPTION_DETECTED;\0A    psa_key_attributes_t attributes = PSA_KEY_ATTRIBUTES_INIT;\0A    mbedtls_svc_key_id_t key_id = MBEDTLS_SVC_KEY_ID_INIT;\0A    psa_algorithm_t psa_md_alg, psa_encrypt_alg;\0A    psa_status_t status;\0A    int key_len;\0A    unsigned char buf[MBEDTLS_PK_RSA_PUB_DER_MAX_BYTES];\0A    unsigned char *p = buf + sizeof(buf);\0A\0A    ((void) f_rng);\0A    ((void) p_rng);\0A\0A    if (mbedtls_rsa_get_len(rsa) > osize) {\0A        return MBEDTLS_ERR_RSA_OUTPUT_TOO_LARGE;\0A    }\0A\0A    key_len = mbedtls_rsa_write_pubkey(rsa, buf, &p);\0A    if (key_len <= 0) {\0A        return MBEDTLS_ERR_PK_BAD_INPUT_DATA;\0A    }\0A\0A    psa_set_key_usage_flags(&attributes, PSA_KEY_USAGE_ENCRYPT);\0A    if (mbedtls_rsa_get_padding_mode(rsa) == MBEDTLS_RSA_PKCS_V21) {\0A        psa_md_alg = mbedtls_md_psa_alg_from_type((mbedtls_md_type_t) mbedtls_rsa_get_md_alg(rsa));\0A        psa_encrypt_alg = PSA_ALG_RSA_OAEP(psa_md_alg);\0A    } else {\0A        psa_encrypt_alg = PSA_ALG_RSA_PKCS1V15_CRYPT;\0A    }\0A    psa_set_key_algorithm(&attributes, psa_encrypt_alg);\0A    psa_set_key_type(&attributes, PSA_KEY_TYPE_RSA_PUBLIC_KEY);\0A\0A    status = psa_import_key(&attributes,\0A                            buf + sizeof(buf) - key_len, key_len,\0A                            &key_id);\0A    if (status != PSA_SUCCESS) {\0A        ret = PSA_PK_TO_MBEDTLS_ERR(status);\0A        goto cleanup;\0A    }\0A\0A    status = psa_asymmetric_encrypt(key_id, psa_encrypt_alg,\0A                                    input, ilen,\0A                                    NULL, 0,\0A                                    output, osize, olen);\0A    if (status != PSA_SUCCESS) {\0A        ret = PSA_PK_RSA_TO_MBEDTLS_ERR(status);\0A        goto cleanup;\0A    }\0A\0A    ret = 0;\0A\0Acleanup:\0A    status = psa_destroy_key(key_id);\0A    if (ret == 0 && status != PSA_SUCCESS) {\0A        ret = PSA_PK_TO_MBEDTLS_ERR(status);\0A    }\0A\0A    return ret;\0A}\0A#else /* MBEDTLS_USE_PSA_CRYPTO */\0Astatic int rsa_encrypt_wrap(mbedtls_pk_context *pk,\0A                            const unsigned char *input, size_t ilen,\0A                            unsigned char *output, size_t *olen, size_t osize,\0A                            int (*f_rng)(void *, unsigned char *, size_t), void *p_rng)\0A{\0A    mbedtls_rsa_context *rsa = (mbedtls_rsa_context *) pk->pk_ctx;\0A    *olen = mbedtls_rsa_get_len(rsa);\0A\0A    if (*olen > osize) {\0A        return MBEDTLS_ERR_RSA_OUTPUT_TOO_LARGE;\0A    }\0A\0A    return mbedtls_rsa_pkcs1_encrypt(rsa, f_rng, p_rng,\0A                                     ilen, input, output);\0A}\0A#endif /* MBEDTLS_USE_PSA_CRYPTO */\0A\0Astatic int rsa_check_pair_wrap(mbedtls_pk_context *pub, mbedtls_pk_context *prv,\0A                               int (*f_rng)(void *, unsigned char *, size_t),\0A                               void *p_rng)\0A{\0A    (void) f_rng;\0A    (void) p_rng;\0A    return mbedtls_rsa_check_pub_priv((const mbedtls_rsa_context *) pub->pk_ctx,\0A                                      (const mbedtls_rsa_context *) prv->pk_ctx);\0A}\0A\0Astatic void *rs