t is still writing to, and on POSIX leave a zombie until\0A// this program exits, because the only process that could reap it has\0A// stopped tracking it.\0A//\0A// `drop_policy` is where a future choice would live. It is not settable\0A// from Plum today.\0Avoid process_child_free(long long handle) {\0A    PlumProcessSlot *slot = plum_slot_of(handle);\0A    if (slot == NULL) return;\0A    PlumChildState *c = slot->child;\0A    if (c != NULL) {\0A        if (!c->finished) {\0A            (void)process_terminate(handle, 1);\0A#if defined(_WIN32)\0A            HANDLE h = (HANDLE)(intptr_t)c->pid;\0A            WaitForSingleObject(h, 5000);\0A            DWORD code = 0;\0A            if (!GetExitCodeProcess(h, &code)) code = (DWORD)-1;\0A            plum_child_collect(handle, (long long)(int)code);\0A#else\0A            int status = 0;\0A            pid_t r;\0A            do { r = waitpid((pid_t)c->pid, &status, 0); } while (r < 0 && errno == EINTR);\0A            plum_child_collect(handle, (r > 0 && WIFEXITED(status)) ? (long long)WEXITSTATUS(status) : -1);\0A#endif\0A        }\0A        free(c->out_path);\0A        free(c->err_path);\0A        free(c->in_path);\0A        free(c);\0A        slot->child = NULL;\0A    }\0A    free(slot->out_data);\0A    free(slot->err_data);\0A    slot->out_data = NULL;\0A    slot->err_data = NULL;\0A    slot->in_use = 0;\0A}\0A\0A// The inherited-stdio counterpart to `plum_spawn_capture`, and the\0A// second place this file needs a platform split. It was missed when the\0A// first one was written -- the POSIX `fork`/`waitpid` here sat outside\0A// any guard and was found by the Windows CI leg, which is what that leg\0A// is for.\0A#if !defined(_WIN32)\0A\0Astatic long long plum_spawn_inherit(const char *program, char **argv) {\0A    pid_t pid = fork();\0A    if (pid < 0) return -1;\0A    if (pid == 0) {\0A        execvp(program, argv);\0A        _exit(127);\0A    }\0A    int status = 0;\0A    if (waitpid(pid, &status, 0) < 0) return -