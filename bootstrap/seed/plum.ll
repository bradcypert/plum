@.str41719 = private global { i64, i64, [40013 x i8] } { i64 -1, i64 40012, [40013 x i8] c"/*\0A *  PSA crypto layer on top of Mbed TLS crypto\0A */\0A/*\0A *  Copyright The Mbed TLS Contributors\0A *  SPDX-License-Identifier: Apache-2.0 OR GPL-2.0-or-later\0A */\0A\0A#include \22common.h\22\0A\0A#if defined(MBEDTLS_PSA_CRYPTO_C)\0A\0A#include \22psa/crypto.h\22\0A\0A#include \22psa_crypto_core.h\22\0A#include \22psa_crypto_driver_wrappers_no_static.h\22\0A#include \22psa_crypto_slot_management.h\22\0A#include \22psa_crypto_storage.h\22\0A#if defined(MBEDTLS_PSA_CRYPTO_SE_C)\0A#include \22psa_crypto_se.h\22\0A#endif\0A\0A#include <stdlib.h>\0A#include <string.h>\0A#include \22mbedtls/platform.h\22\0A#if defined(MBEDTLS_THREADING_C)\0A#include \22mbedtls/threading.h\22\0A#endif\0A\0A\0A\0A/* Make sure we have distinct ranges of key identifiers for distinct\0A * purposes. */\0AMBEDTLS_STATIC_ASSERT(PSA_KEY_ID_USER_MIN < PSA_KEY_ID_USER_MAX,\0A                      \22Empty user key ID range\22);\0AMBEDTLS_STATIC_ASSERT(PSA_KEY_ID_VENDOR_MIN < PSA_KEY_ID_VENDOR_MAX,\0A                      \22Empty vendor key ID range\22);\0AMBEDTLS_STATIC_ASSERT(MBEDTLS_PSA_KEY_ID_BUILTIN_MIN <= MBEDTLS_PSA_KEY_ID_BUILTIN_MAX,\0A                      \22Empty builtin key ID range\22);\0AMBEDTLS_STATIC_ASSERT(PSA_KEY_ID_VOLATILE_MIN <= PSA_KEY_ID_VOLATILE_MAX,\0A                      \22Empty volatile key ID range\22);\0A\0AMBEDTLS_STATIC_ASSERT(PSA_KEY_ID_USER_MAX < PSA_KEY_ID_VENDOR_MIN ||\0A                      PSA_KEY_ID_VENDOR_MAX < PSA_KEY_ID_USER_MIN,\0A                      \22Overlap between user key IDs and vendor key IDs\22);\0A\0AMBEDTLS_STATIC_ASSERT(PSA_KEY_ID_VENDOR_MIN <= MBEDTLS_PSA_KEY_ID_BUILTIN_MIN &&\0A                      MBEDTLS_PSA_KEY_ID_BUILTIN_MAX <= PSA_KEY_ID_VENDOR_MAX,\0A                      \22Builtin key identifiers are not in the vendor range\22);\0A\0AMBEDTLS_STATIC_ASSERT(PSA_KEY_ID_VENDOR_MIN <= PSA_KEY_ID_VOLATILE_MIN &&\0A                      PSA_KEY_ID_VOLATILE_MAX <= PSA_KEY_ID_VENDOR_MAX,\0A                      \22Volatile key identifiers are not in the vendor range\22);\0A\0AMBEDTLS_STATIC_ASSERT(PSA_KEY_ID_VOLATILE_MAX < MBEDTLS_PSA_KEY_ID_BUILTIN_MIN ||\0A                      MBEDTLS_PSA_KEY_ID_BUILTIN_MAX < PSA_KEY_ID_VOLATILE_MIN,\0A                      \22Overlap between builtin key IDs and volatile key IDs\22);\0A\0A\0A\0A#if defined(MBEDTLS_PSA_KEY_STORE_DYNAMIC)\0A\0A/* Dynamic key store.\0A *\0A * The key store consists of multiple slices.\0A *\0A * The volatile keys are stored in variable-sized tables called slices.\0A * Slices are allocated on demand and deallocated when possible.\0A * The size of slices increases exponentially, so the average overhead\0A * (number of slots that are allocated but not used) is roughly\0A * proportional to the number of keys (with a factor that grows\0A * when the key store is fragmented).\0A *\0A * One slice is dedicated to the cache of persistent and built-in keys.\0A * For simplicity, they are separated from volatile keys. This cache\0A * slice has a fixed size and has the slice index KEY_SLOT_CACHE_SLICE_INDEX,\0A * located after the slices for volatile keys.\0A */\0A\0A/* Size of the last slice containing the cache of persistent and built-in keys. */\0A#define PERSISTENT_KEY_CACHE_COUNT MBEDTLS_PSA_KEY_SLOT_COUNT\0A\0A/* Volatile keys are stored in slices 0 through\0A * (KEY_SLOT_VOLATILE_SLICE_COUNT - 1) inclusive.\0A * Each slice is twice the size of the previous slice.\0A * Volatile key identifiers encode the slice number as follows:\0A *     bits 30..31:  0b10 (mandated by the PSA Crypto specification).\0A *     bits 25..29:  slice index (0...KEY_SLOT_VOLATILE_SLICE_COUNT-1)\0A *     bits 0..24:   slot index in slice\0A */\0A#define KEY_ID_SLOT_INDEX_WIDTH 25u\0A#define KEY_ID_SLICE_INDEX_WIDTH 5u\0A\0A#define KEY_SLOT_VOLATILE_SLICE_BASE_LENGTH 16u\0A#define KEY_SLOT_VOLATILE_SLICE_COUNT 22u\0A#define KEY_SLICE_COUNT (KEY_SLOT_VOLATILE_SLICE_COUNT + 1u)\0A#define KEY_SLOT_CACHE_SLICE_INDEX KEY_SLOT_VOLATILE_SLICE_COUNT\0A\0A\0A/* Check that the length of the largest slice (calculated as\0A * KEY_SLICE_LENGTH_MAX below) does not overflow size_t. We use\0A * an indirect method in case the calculation of KEY_SLICE_LENGTH_MAX\0A * itself overflows uintmax_t: if (BASE_LENGTH << c)\0A * overflows size_t then BASE_LENGTH > SIZE_MAX >> c.\0A */\0A#if (KEY_SLOT_VOLATILE_SLICE_BASE_LENGTH >              \5C\0A     SIZE_MAX >> (KEY_SLOT_VOLATILE_SLICE_COUNT - 1))\0A#error \22Maximum slice length overflows size_t\22\0A#endif\0A\0A#if KEY_ID_SLICE_INDEX_WIDTH + KEY_ID_SLOT_INDEX_WIDTH > 30\0A#error \22Not enough room in volatile key IDs for slice index and slot index\22\0A#endif\0A#if KEY_SLOT_VOLATILE_SLICE_COUNT > (1 << KEY_ID_SLICE_INDEX_WIDTH)\0A#error \22Too many slices to fit the slice index in a volatile key ID\22\0A#endif\0A#define KEY_SLICE_LENGTH_MAX                                            \5C\0A    (KEY_SLOT_VOLATILE_SLICE_BASE_LENGTH << (KEY_SLOT_VOLATILE_SLICE_COUNT - 1))\0A#if KEY_SLICE_LENGTH_MAX > 1 << KEY_ID_SLOT_INDEX_WIDTH\0A#error \22Not enough room in volatile key IDs for a slot index in the largest slice\22\0A#endif\0A#if KEY_ID_SLICE_INDEX_WIDTH > 8\0A#error \22Slice index does not fit in uint8_t for psa_key_slot_t::slice_index\22\0A#endif\0A\0A\0A/* Calculate the volatile key id to use for a given slot.\0A * This function assumes valid parameter values. */\0Astatic psa_key_id_t volatile_key_id_of_index(size_t slice_idx,\0A                                             size_t slot_idx)\0A{\0A    /* We assert above that the slice and slot indexes fit in separate\0A     * bit-fields inside psa_key_id_t, which is a 32-bit type per the\0A     * PSA Cryptography specification. */\0A    return (psa_key_id_t) (0x40000000u |\0A                           (slice_idx << KEY_ID_SLOT_INDEX_WIDTH) |\0A                           slot_idx);\0A}\0A\0A/* Calculate the slice containing the given volatile key.\0A * This function assumes valid parameter values. */\0Astatic size_t slice_index_of_volatile_key_id(psa_key_id_t key_id)\0A{\0A    size_t mask = (1LU << KEY_ID_SLICE_INDEX_WIDTH) - 1;\0A    return (key_id >> KEY_ID_SLOT_INDEX_WIDTH) & mask;\0A}\0A\0A/* Calculate the index of the slot containing the given volatile key.\0A * This function assumes valid parameter values. */\0Astatic size_t slot_index_of_volatile_key_id(psa_key_id_t key_id)\0A{\0A    return key_id & ((1LU << KEY_ID_SLOT_INDEX_WIDTH) - 1);\0A}\0A\0A/* In global_data.first_free_slot_index, use this special value to\0A * indicate that the slice is full. */\0A#define FREE_SLOT_INDEX_NONE ((size_t) -1)\0A\0A#if defined(MBEDTLS_TEST_HOOKS)\0Asize_t psa_key_slot_volatile_slice_count(void)\0A{\0A    return KEY_SLOT_VOLATILE_SLICE_COUNT;\0A}\0A#endif\0A\0A#else /* MBEDTLS_PSA_KEY_STORE_DYNAMIC */\0A\0A/* Static key store.\0A *\0A * All the keys (volatile or persistent) are in a single slice.\0A * We only use slices as a concept to allow some differences between\0A * static and dynamic key store management to be buried in auxiliary\0A * functions.\0A */\0A\0A#define PERSISTENT_KEY_CACHE_COUNT MBEDTLS_PSA_KEY_SLOT_COUNT\0A#define KEY_SLICE_COUNT 1u\0A#define KEY_SLOT_CACHE_SLICE_INDEX 0\0A\0A#endif /* MBEDTLS_PSA_KEY_STORE_DYNAMIC */\0A\0A\0Atypedef struct {\0A#if defined(MBEDTLS_PSA_KEY_STORE_DYNAMIC)\0A    psa_key_slot_t *key_slices[KEY_SLICE_COUNT];\0A    size_t first_free_slot_index[KEY_SLOT_VOLATILE_SLICE_COUNT];\0A#else /* MBEDTLS_PSA_KEY_STORE_DYNAMIC */\0A    psa_key_slot_t key_slots[MBEDTLS_PSA_KEY_SLOT_COUNT];\0A#endif /* MBEDTLS_PSA_KEY_STORE_DYNAMIC */\0A    uint8_t key_slots_initialized;\0A} psa_global_data_t;\0A\0Astatic psa_global_data_t global_data;\0A\0Astatic uint8_t psa_get_key_slots_initialized(void)\0A{\0A    uint8_t initialized;\0A\0A#if defined(MBEDTLS_THREADING_C)\0A    mbedtls_mutex_lock(&mbedtls_threading_psa_globaldata_mutex);\0A#endif /* defined(MBEDTLS_THREADING_C) */\0A\0A    initialized