PTION_DETECTED;\0A    int fd = ((mbedtls_net_context *) ctx)->fd;\0A\0A    ret = check_fd(fd, 0);\0A    if (ret != 0) {\0A        return ret;\0A    }\0A\0A    ret = (int) read(fd, buf, len);\0A\0A    if (ret < 0) {\0A        if (net_would_block(ctx) != 0) {\0A            return MBEDTLS_ERR_SSL_WANT_READ;\0A        }\0A\0A#if (defined(_WIN32) || defined(_WIN32_WCE)) && !defined(EFIX64) && \5C\0A        !defined(EFI32)\0A        if (WSAGetLastError() == WSAECONNRESET) {\0A            return MBEDTLS_ERR_NET_CONN_RESET;\0A        }\0A#else\0A        if (errno == EPIPE || errno == ECONNRESET) {\0A            return MBEDTLS_ERR_NET_CONN_RESET;\0A        }\0A\0A        if (errno == EINTR) {\0A            return MBEDTLS_ERR_SSL_WANT_READ;\0A        }\0A#endif\0A\0A        return MBEDTLS_ERR_NET_RECV_FAILED;\0A    }\0A\0A    return ret;\0A}\0A\0A/*\0A * Read at most 'len' characters, blocking for at most 'timeout' ms\0A */\0Aint mbedtls_net_recv_timeout(void *ctx, unsigned char *buf,\0A                             size_t len, uint32_t timeout)\0A{\0A    int ret = MBEDTLS_ERR_ERROR_CORRUPTION_DETECTED;\0A    struct timeval tv;\0A    fd_set read_fds;\0A    int fd = ((mbedtls_net_context *) ctx)->fd;\0A\0A    ret = check_fd(fd, 1);\0A    if (ret != 0) {\0A        return ret;\0A    }\0A\0A    FD_ZERO(&read_fds);\0A    FD_SET((SOCKET) fd, &read_fds);\0A\0A    tv.tv_sec  = timeout / 1000;\0A    tv.tv_usec = (timeout % 1000) * 1000;\0A\0A    ret = select(fd + 1, &read_fds, NULL, NULL, timeout == 0 ? NULL : &tv);\0A\0A    /* Zero fds ready means we timed out */\0A    if (ret == 0) {\0A        return MBEDTLS_ERR_SSL_TIMEOUT;\0A    }\0A\0A    if (ret < 0) {\0A#if (defined(_WIN32) || defined(_WIN32_WCE)) && !defined(EFIX64) && \5C\0A        !defined(EFI32)\0A        if (WSAGetLastError() == WSAEINTR) {\0A            return MBEDTLS_ERR_SSL_WANT_READ;\0A        }\0A#else\0A        if (errno == EINTR) {\0A            return MBEDTLS_ERR_SSL_WANT_READ;\0A        }\0A#endif\0A\0A        return MBEDTLS_ERR_NET_RECV_FAILED;\0A    }\0A\0A    /* This call will not block */\0A    return mbedtls_net_recv(ctx, buf, len);\0A}\0A\0A/*\0A * Write at most 'len' characters\0A */\0Aint mbedtls_net_send(void *ctx, const unsigned char *buf, size_t len)\0A{\0A    int ret = MBEDTLS_ERR_ERROR_CORRUPTION_DETECTED;\0A    int fd = ((mbedtls_net_context *) ctx)->fd;\0A\0A    ret = check_fd(fd, 0);\0A    if (ret != 0) {\0A        return ret;\0A    }\0A\0A    ret = (int) write(fd, buf, len);\0A\0A    if (ret < 0) {\0A        if (net_would_block(ctx) != 0) {\0A            return MBEDTLS_ERR_SSL_WANT_WRITE;\0A        }\0A\0A#if (defined(_WIN32) || defined(_WIN32_WCE)) && !defined(EFIX64) && \5C\0A        !defined(EFI32)\0A        if (WSAGetLastError() == WSAECONNRESET) {\0A            return MBEDTLS_ERR_NET_CONN_RESET;\0A        }\0A#else\0A        if (errno == EPIPE || errno == ECONNRESET) {\0A            return MBEDTLS_ERR_NET_CONN_RESET;\0A        }\0A\0A        if (errno == EINTR) {\0A            return MBEDTLS_ERR_SSL_WANT_WRITE;\0A        }\0A#endif\0A\0A        return MBEDTLS_ERR_NET_SEND_FAILED;\0A    }\0A\0A    return ret;\0A}\0A\0A/*\0A * Close the connection\0A */\0Avoid mbedtls_net_close(mbedtls_net_context *ctx)\0A{\0A    if (ctx->fd == -1) {\0A        return;\0A    }\0A\0A    close(ctx->fd);\0A\0A    ctx->fd = -1;\0A}\0A\0A/*\0A * Gracefully close the connection\0A */\0Avoid mbedtls_net_free(mbedtls_net_context *ctx)\0A{\0A    if (ctx == NULL || ctx->fd == -1) {\0A        return;\0A    }\0A\0A    shutdown(ctx->fd, 2);\0A    close(ctx->fd);\0A\0A    ctx->fd = -1;\0A}\0A\0A#endif /* MBEDTLS_NET_C */\0A\00" }
