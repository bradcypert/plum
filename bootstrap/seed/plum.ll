@.str41385 = private global { i64, i64, [19995 x i8] } { i64 -1, i64 19994, [19995 x i8] c"/*\0A *  PSA ECP layer on top of Mbed TLS crypto\0A */\0A/*\0A *  Copyright The Mbed TLS Contributors\0A *  SPDX-License-Identifier: Apache-2.0 OR GPL-2.0-or-later\0A */\0A\0A#include \22common.h\22\0A\0A#if defined(MBEDTLS_PSA_CRYPTO_C)\0A\0A#include <psa/crypto.h>\0A#include \22psa_crypto_core.h\22\0A#include \22psa_crypto_ecp.h\22\0A#include \22psa_crypto_random_impl.h\22\0A#include \22mbedtls/psa_util.h\22\0A\0A#include <stdlib.h>\0A#include <string.h>\0A#include \22mbedtls/platform.h\22\0A\0A#include <mbedtls/ecdsa.h>\0A#include <mbedtls/ecdh.h>\0A#include <mbedtls/ecp.h>\0A#include <mbedtls/error.h>\0A\0A#if defined(MBEDTLS_PSA_BUILTIN_KEY_TYPE_ECC_KEY_PAIR_BASIC) || \5C\0A    defined(MBEDTLS_PSA_BUILTIN_KEY_TYPE_ECC_KEY_PAIR_IMPORT) || \5C\0A    defined(MBEDTLS_PSA_BUILTIN_KEY_TYPE_ECC_KEY_PAIR_EXPORT) || \5C\0A    defined(MBEDTLS_PSA_BUILTIN_KEY_TYPE_ECC_PUBLIC_KEY) || \5C\0A    defined(MBEDTLS_PSA_BUILTIN_ALG_ECDSA) || \5C\0A    defined(MBEDTLS_PSA_BUILTIN_ALG_DETERMINISTIC_ECDSA) || \5C\0A    defined(MBEDTLS_PSA_BUILTIN_ALG_ECDH)\0A/* Helper function to verify if the provided EC's family and key bit size are valid.\0A *\0A * Note: \22bits\22 parameter is used both as input and output and it might be updated\0A *       in case provided input value is not multiple of 8 (\22sloppy\22 bits).\0A */\0Astatic int check_ecc_parameters(psa_ecc_family_t family, size_t *bits)\0A{\0A    switch (family) {\0A        case PSA_ECC_FAMILY_SECP_R1:\0A            switch (*bits) {\0A                case 192:\0A                case 224:\0A                case 256:\0A                case 384:\0A                case 521:\0A                    return PSA_SUCCESS;\0A                case 528:\0A                    *bits = 521;\0A                    return PSA_SUCCESS;\0A            }\0A            break;\0A\0A        case PSA_ECC_FAMILY_BRAINPOOL_P_R1:\0A            switch (*bits) {\0A                case 256:\0A                case 384:\0A                case 512:\0A                    return PSA_SUCCESS;\0A            }\0A            break;\0A\0A        case PSA_ECC_FAMILY_MONTGOMERY:\0A            switch (*bits) {\0A                case 448:\0A                case 255:\0A                    return PSA_SUCCESS;\0A                case 256:\0A                    *bits = 255;\0A                    return PSA_SUCCESS;\0A            }\0A            break;\0A\0A        case PSA_ECC_FAMILY_SECP_K1:\0A            switch (*bits) {\0A                case 192:\0A                /* secp224k1 is not and will not be supported in PSA (#3541). */\0A                case 256:\0A                    return PSA_SUCCESS;\0A            }\0A            break;\0A    }\0A\0A    return PSA_ERROR_INVALID_ARGUMENT;\0A}\0A\0Apsa_status_t mbedtls_psa_ecp_load_representation(\0A    psa_key_type_t type, size_t curve_bits,\0A    const uint8_t *data, size_t data_length,\0A    mbedtls_ecp_keypair **p_ecp)\0A{\0A    mbedtls_ecp_group_id grp_id = MBEDTLS_ECP_DP_NONE;\0A    psa_status_t status;\0A    mbedtls_ecp_keypair *ecp = NULL;\0A    size_t curve_bytes = data_length;\0A    int explicit_bits = (curve_bits != 0);\0A\0A    if (PSA_KEY_TYPE_IS_PUBLIC_KEY(type) &&\0A        PSA_KEY_TYPE_ECC_GET_FAMILY(type) != PSA_ECC_FAMILY_MONTGOMERY) {\0A        /* A Weierstrass public key is represented as:\0A         * - The byte 0x04;\0A         * - `x_P` as a `ceiling(m/8)`-byte string, big-endian;\0A         * - `y_P` as a `ceiling(m/8)`-byte string, big-endian.\0A         * So its data length is 2m+1 where m is the curve size in bits.\0A         */\0A        if ((data_length & 1) == 0) {\0A            return PSA_ERROR_INVALID_ARGUMENT;\0A        }\0A        curve_bytes = data_length / 2;\0A\0A        /* Montgomery public keys are represented in compressed format, meaning\0A         * their curve_bytes is equal to the amount of input. */\0A\0A        /* Private keys are represented in uncompressed private random integer\0A         * format, meaning their curve_bytes is equal to the amount of input. */\0A    }\0A\0A    if (explicit_bits) {\0A        /* With an explicit bit-size, the data must have the matching length. */\0A        if (curve_bytes != PSA_BITS_TO_BYTES(curve_bits)) {\0A            return PSA_ERROR_INVALID_ARGUMENT;\0A        }\0A    } else {\0A        /* We need to infer the bit-size from the data. Since the only\0A         * information we have is the length in bytes, the value of curve_bits\0A         * at this stage is rounded up to the nearest multiple of 8. */\0A        curve_bits = PSA_BYTES_TO_BITS(curve_bytes);\0A    }\0A\0A    /* Allocate and initialize a key representation. */\0A    ecp = mbedtls_calloc(1, sizeof(mbedtls_ecp_keypair));\0A    if (ecp == NULL) {\0A        return PSA_ERROR_INSUFFICIENT_MEMORY;\0A    }\0A    mbedtls_ecp_keypair_init(ecp);\0A\0A    status = check_ecc_parameters(PSA_KEY_TYPE_ECC_GET_FAMILY(type), &curve_bits);\0A    if (status != PSA_SUCCESS) {\0A        goto exit;\0A    }\0A\0A    /* Load the group. */\0A    grp_id = mbedtls_ecc_group_from_psa(PSA_KEY_TYPE_ECC_GET_FAMILY(type),\0A                                        curve_bits);\0A    if (grp_id == MBEDTLS_ECP_DP_NONE) {\0A        status = PSA_ERROR_NOT_SUPPORTED;\0A        goto exit;\0A    }\0A\0A    status = mbedtls_to_psa_error(\0A        mbedtls_ecp_group_load(&ecp->grp, grp_id));\0A    if (status != PSA_SUCCESS) {\0A        goto exit;\0A    }\0A\0A    /* Load the key material. */\0A    if (PSA_KEY_TYPE_IS_PUBLIC_KEY(type)) {\0A        /* Load the public value. */\0A        status = mbedtls_to_psa_error(\0A            mbedtls_ecp_point_read_binary(&ecp->grp, &ecp->Q,\0A                                          data,\0A                                          data_length));\0A        if (status != PSA_SUCCESS) {\0A            goto exit;\0A        }\0A\0A        /* Check that the point is on the curve. */\0A        status = mbedtls_to_psa_error(\0A   