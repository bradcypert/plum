@.str61894 = private global { i64, i64, [27390 x i8] } { i64 -1, i64 27389, [27390 x i8] c"/// Filesystem and self-location. These replaced shelling out to\0A/// `mktemp -d`, `rm -rf`, `rm -f`, `cp -r` and `mkdir`, and reading\0A/// `/proc/self/exe`. See `native_stdlib/os_shim.c`.\0A///\0A/// The `..._raw` forms are runtime primitives whose Plum bodies\0A/// exist only to give the checker a signature. They travel with the\0A/// module: `cg_runtime_fn` keys on the bare name and does not care\0A/// which module the call was written in.\0Alet os_temp_dir_raw (ignored: Bool): String = \22\22\0Alet os_self_exe_raw (ignored: Bool): String = \22\22\0Alet os_make_dir_raw (path: String): Int = 0\0Alet os_remove_file_raw (path: String): Int = 0\0Alet os_rename_file_raw (from: String) (to: String): Int = 0\0Alet os_remove_tree_raw (path: String): Int = 0\0Alet os_copy_tree_raw (src: String) (dst: String): Int = 0\0Alet os_platform_raw (ignored: Bool): String = \22\22\0A\0A/// Which platform this program is running on: \22linux\22, \22macos\22 or\0A/// \22windows\22. Compiled in, not detected at runtime; a binary\0A/// cannot move between platforms, so there is nothing to detect.\0Apub let platform (): String = os_platform_raw(true)\0A\0A/// A fresh, empty, private directory. The caller owns it and is\0A/// responsible for `Os.remove_tree` on it.\0Apub let temp_dir (): Result[String, String] = {\0A    let d = os_temp_dir_raw(true);\0A    if String.is_empty(d) { Err(\22Os.temp_dir: could not create a temporary directory\22) }\0A    else { Ok(d) }\0A}\0A\0A/// The path of the running executable, for a program that needs to\0A/// re-invoke itself.\0Apub let self_exe (): Result[String, String] = {\0A    let p = os_self_exe_raw(true);\0A    if String.is_empty(p) { Err(\22Os.self_exe: could not determine the executable path\22) }\0A    else { Ok(p) }\0A}\0A\0A/// Creates one directory. The PARENT must already exist; this makes a\0A/// single level, not a path.\0A///\0A/// `Err` when the parent is missing, when the name is taken by a file,\0A/// or when permission is refused. A directory that already exists is\0A/// also an `Err`, so a caller who does not care should check\0A/// `Os.exists` first.\0Apub let make_dir (path: String): Result[Unit, String] =\0A    if os_make_dir_raw(path) == 0 { Ok(()) }\0A    else { Err(\22Os.make_dir: could not create \22.concat(path)) }\0A\0A/// Atomic within one filesystem, and an error rather than a silent\0A/// copy across two. The point is that the destination is never a\0A/// half-written file.\0Apub let rename_file (from: String) (to: String): Result[Unit, String] =\0A    if os_rename_file_raw(from, to) == 0 { Ok(()) }\0A    else { Err(\22Os.rename_file: could not rename \22.concat(from).concat(\22 to \22).concat(to)) }\0A\0A/// Deletes a file. `Err` when it is not there, when it is a directory,\0A/// or when permission is refused — `Os.remove_tree` is the one for\0A/// directories.\0Apub let remove_file (path: String): Result[Unit, String] =\0A    if os_remove_file_raw(path) == 0 { Ok(()) }\0A    else { Err(\22Os.remove_file: could not remove \22.concat(path)) }\0A\0A/// Deletes a file or directory tree. A final symlink is removed even\0A/// with trailing separators; links encountered in the tree are never\0A/// followed. Ancestors of the requested path resolve normally when the\0A/// starting directory is acquired; traversal then uses held directories.\0A/// Concurrent changes or resource exhaustion can return `Err` after partial\0A/// removal. Traversal is limited to 128 directory levels to bound native\0A/// stack, enumeration storage, and open handles. Empty paths and final\0A/// `.` or `..` components are rejected.\0Apub let remove_tree (path: String): Result[Unit, String] =\0A    if os_remove_tree_raw(path) == 0 { Ok(()) }\0A    else { Err(\22Os.remove_tree: could not remove \22.concat(path)) }\0A\0A/// Copies the contents of `src` into the existing directory `dst`.\0A/// Both roots must be ordinary directories, even with trailing separators;\0A/// their ancestors resolve normally. Identical or nested roots return `Err`\0A/// before changing `dst`. Links inside `src` are copied as links, including\0A/// dangling links, without reading their targets. Destination links and\0A/// unsupported Windows reparse points are rejected. Failure to recreate a\0A/// link returns `Err` rather than substituting its target or link text.\0A/// Regular destination files are replaced, so other hardlinks are unchanged.\0A/// Traversal uses held directories, at most 128 levels, and a 64 KiB transfer\0A/// buffer independent of file size. Errors can leave partial output; the\0A/// caller owns cleanup. File modes are not preserved.\0Apub let copy_tree (src: String) (dst: String): Result[Unit, String] =\0A    if os_copy_tree_raw(src, dst) == 0 { Ok(()) }\0A    else { Err(\22Os.copy_tree: could not copy \22.concat(src).concat(\22 to \22).concat(dst)) }\0A\0A// --- Environment and process ---\0A//\0A// Folded in from the flat prelude in 0.0.9. `Os` already owned the\0A// filesystem calls that shell out to `os_shim.c`, so putting\0A// `read_file` in a separate `Fs` would have split the filesystem\0A// across two modules. This is the shape Go settled on -- `os.ReadFile`,\0A// `os.Getenv`, `os.Exit`, `os.MkdirAll` in one place, with `net`\0A// separate and string helpers on the type.\0A\0Alet exit_raw (code: Int): Bool = false\0Alet env_var_raw (name: String): Array[Bytes] = []\0A\0A/// Exit with a status code, printing nothing. `panic_raw` also exits\0A/// non-zero but prints its message first, which is wrong when the\0A/// report has already been written.\0Apub let exit_with (code: Int): Unit = { exit_raw(code); () }\0A\0A// The raw runtime returns an array (empty when unset), so variant tags\0A// remain the compiler's responsibility. OS bytes become text only through\0A// the same checked conversion used by read_file.\0A/// Reads an environment value as bytes, preserving non-UTF-8 data.\0A///\0A/// `None` when unset; a set but empty value is `Some(Bytes.empty())`.\0A/// The returned buffer owns a copy of the value, independent of later\0A/// environment changes. Values cannot contain NUL in the OS environment.\0Apub let env_var_bytes (name: String): Option[Bytes] = {\0A    let r = env_var_raw(name);\0A    if Array.is_empty(r) { None } else { Some(r[0]) }\0A}\0A\0A/// Reads an environment value as UTF-8 text.\0A///\0A/// `None` when unset or not valid UTF-8. A set but empty value is\0A/// `Some(\22\22)`. Use `Os.env_var_bytes` to distinguish invalid text from\0A/// an unset variable and preserve its bytes. Validation shares the byte\0A/// buffer without making another copy of the value.\0Apub let env_var (name: String): Option[String] =\0A    match env_var_bytes(name) {\0A        None => None,\0A        Some(b) => match b.as_string() {\0A            Ok(s) => Some(s),\0A            Err(_) => None,\0A        },\0A    }\0A\0A// --- Whole-file I/O ---\0A\0Alet write_file_raw (path: String) (contents: String): Bool = false\0A\0A/// Reads a whole seekable file as text.\0A///\0A/// `Err` when the file is missing, unreadable, or not valid UTF-8. Use\0A/// `Os.read_bytes` for a file that is not text, or that might not be.\0A/// A failed or incomplete read returns `Err`, never a partial string.\0Apub let read_file (path: String): Result[String, String] =\0A    match read_bytes(path) {\0A        Err(e) => Err(e),\0A        Ok(b) => match b.as_string() {\0A            Ok(s) => Ok(s),\0A            Err(_) => Err(\22could not read \22.concat(path)),\0A        },\0A    }\0A\0A/// Writes text to a file, creating it or REPLACING what was there.\0A///\0A/// Writes an exclusive sibling temporary, checks writing and closing,\0A/// then replaces the destination in one same-filesystem rename. `Err`\0A/// leaves the old destination intact; temporary files are removed on failure.\0A/// The parent directory must exist and be writable. Symlinks and special\0A/// files are rejected; parent directories are followed. On Unix, new files\0A/// are private (0600) and replacements preserve ordinary permission bits.\0A/// Replacement changes file identity: hard links, ownership, ACLs and other\0A/// metadata are not preserved. This is atomic publication, not a promise\0A/// of durability after power loss; interruption may leave a temporary file.\0Apub let write_file (path: String) (contents: String): Result[Unit, String] =\0A    if write_file_raw(path, contents) { Ok(()) } else { Err(\22could not write \22.concat(path)) }\0A\0A/// --- Whole-file BINARY I/O ---\0A///\0A/// The `String` pair above keeps its contract exactly: it is the text\0A/// convenience, and a program that wants text should keep using it.\0A/// These are for the payloads a `String` cannot honestly describe --\0A/// images, compressed data, anything with an embedded NUL or a byte\0A/// that is not valid UTF-8.\0A///\0A/// Both readers use the same checked byte read. `read_file` then\0A/// validates UTF-8 through `Bytes.as_string`, which shares the byte\0A/// cell without copying it. Binary reads preserve every byte.\0A///\0A/// `read_file_bytes_raw` returns an ARRAY because hand-written runtime\0A/// IR cannot construct a `Result` without hard-coding tag numbers the\0A/// backend assigns per program, so the wrapping happens here.\0Alet read_file_bytes_raw (path: String): Array[Bytes] = []\0Alet write_file_bytes_raw (path: String) (contents: Bytes): Bool = false\0Alet append_file_bytes_raw (path: String) (contents: Bytes): Bool = false\0A\0A/// Reads a whole seekable file as bytes. An empty file returns empty\0A/// `Bytes`. Opening, sizing, temporary buffer allocation, incomplete\0A/// reads, I/O errors, and close failures return `Err`, never a partial buffer.\0Apub let read_bytes (path: String): Result[Bytes, String] = {\0A    let r = read_file_bytes_raw(path);\0A    if Array.is_empty(r) { Err(\22could not read \22.concat(path)) } else { Ok(r[0]) }\0A}\0A\0A/// Writes bytes to a file, creating it or REPLACING what was there.\0A///\0A/// The `Bytes` counterpart to `Os.write_file`: use this for anything\0A/// that is not text, and for text you have already encoded.\0Apub let write_bytes (path: String) (data: Bytes): Result[Unit, String] =\0A    if write_file_bytes_raw(path, data) { Ok(()) } else { Err(\22could not write \22.concat(path)) }\0A\0A/// Creates the file when it does not exist, the way `>>` does.\0Apub let append_bytes (path: String) (data: Bytes): Result[Unit, String] =\0A    if append_file_bytes_raw(path, data) { Ok(()) } else { Err(\22could not append to \22.concat(path)) }\0A\0A// --- Streaming file I/O ---\0A//\0A// The whole-file calls above are the convenience: one call, no\0A// handle, no cleanup to think about. These are for the cases a\0A// whole-file read cannot serve -- a file too big to hold, a stream\0A// consumed as it arrives, an append-only log kept open.\0A//\0A// `File` is a `handle` (issue #9), so an open file CLOSES ITSELF\0A// when the value dies. `File.close` is still offered, and still\0A// returns a `Result`, because closing can fail -- a buffered write\0A// is flushed by `fclose`, and that is exactly when a full disk is\0A// discovered. So: call `close` when the error matters, and rely on\0A// the handle when it does not. Neither leaks.\0A//\0A// Closing twice is fine and is the NORMAL path, since the handle\0A// runs after an explicit close. `native_stdlib/file_shim.c` owns a\0A// slot table precisely so the second one is harmless.\0Aextern \22C\22 {\0A    fn file_open(path: CStr, mode: Int) -> Int;\0A    fn file_close(h: Int);\0A    fn file_close_checked(h: Int) -> Int;\0A    fn file_read_n(h: Int, max_len: Int) -> Int;\0A    fn file_read_data() -> CStr;\0A    fn file_write(h: Int, buf: CStr, len: Int) -> Int;\0A    fn file_seek(h: Int, offset: Int, whence: Int) -> Int;\0A    fn file_flush(h: Int) -> Int;\0A}\0A\0A/// An open file. **Closed when this value dies**, including on a\0A/// panic, so a file opened in a scope needs no cleanup.\0A///\0A/// `File.close` is still offered and still returns a `Result`, because\0A/// closing can fail: a buffered write is flushed by the close, and that\0A/// is exactly when a full disk is discovered. Call it when that error\0A/// matters; rely on the handle when it does not. Closing twice is\0A/// harmless.\0Apub handle File { on_drop: file_close }\0A\0A/// How to open. A closed set, passed as small integers across the\0A/// extern boundary; an extern taking a mode STRING would let a\0A/// caller hand `fopen` anything at all.\0Apub enum Mode { Read, Write, Append }\0A\0A/// Where a seek measures from.\0Apub enum Seek { Start, Current, End }\0A\0Alet mode_code (m: Mode): Int = match m { Read => 0, Write => 1, Append => 2 }\0Alet seek_code (s: Seek): Int = match s { Start => 0, Current => 1, End => 2 }\0A\0A/// `Write` truncates an existing file; `Append` does not. Both create\0A/// one that is not there, and `Read` does not.\0Apub let open (path: String) (mode: Mode): Result[File, String] = unsafe {\0A    let h = file_open(path.as_cstr(), mode_code(mode));\0A    if h < 0 { Err(\22Os.open: could not open \22.concat(path)) } else { Ok(File.from_raw(h)) }\0A}\0A\0A/// Up to `max_len` bytes. An empty result is END OF FILE, not a\0A/// failure: the same three-way split `Net.read_bytes` makes, and\0A/// for the same reason: a reader looping until the end needs to tell\0A/// \22nothing left\22 from \22something broke\22.\0A/// `max_len` must be positive; zero or negative sizes return `Err`\0A/// without consuming input, even at end of file.\0Apub let File.read (f: File) (max_len: Int): Result[Bytes, String] = unsafe {\0A    let n = file_read_n(File.raw(f), max_len);\0A    if n < 0 { Err(\22File.read: read failed\22) }\0A    else { Ok(Bytes.from_cstr(file_read_data(), n)) }\0A}\0A\0A/// `len` MUST be bound BEFORE `.as_cstr()` runs, the same ordering\0A/// `Net.write` spells out: the pointer is an interior one into the\0A/// cell, and reading `.len()` afterwards in the same argument list is\0A/// how that bug was found on the wire the first time.\0Apub let File.write (f: File) (data: Bytes): Result[Int, String] = unsafe {\0A    let len = data.len();\0A    let n = file_write(File.raw(f), data.as_cstr(), len);\0A    if n < 0 { Err(\22File.write: write failed\22) } else { Ok(n) }\0A}\0A\0A/// The new absolute byte position, using 64-bit file offsets on every\0A/// platform. Negative offsets are allowed relative to `Current` or `End`\0A/// when the resulting position is nonnegative. Returns `Err` if seeking\0A/// fails or the position cannot fit in `Int`. Seeking does not read or\0A/// allocate the intervening bytes.\0Apub let File.seek (f: File) (offset: Int) (from: Seek): Result[Int, String] = unsafe {\0A    let p = file_seek(File.raw(f), offset, seek_code(from));\0A    if p < 0 { Err(\22File.seek: seek failed\22) } else { Ok(p) }\0A}\0A\0A/// Makes buffered writes visible without giving up the handle.\0Apub let File.flush (f: File): Result[Unit, String] = unsafe {\0A    if file_flush(File.raw(f)) == 0 { Ok(()) } else { Err(\22File.flush: flush failed\22) }\0A}\0A\0A/// Closing is OPTIONAL: the handle closes the file when it dies. Call\0A/// this when a failed final flush is something the program should\0A/// react to rather than lose. Calling it twice, or letting the handle\0A/// run afterwards, is harmless.\0Apub let File.close (f: File): Result[Unit, String] = unsafe {\0A    if file_close_checked(File.raw(f)) == 0 { Ok(()) } else { Err(\22File.close: close failed\22) }\0A}\0A\0A// --- Running a program ---\0A//\0A// `process_run_raw` takes its arguments TAB-joined in a single string\0A// because an extern boundary has no `Array[String]` -- see\0A// `native_stdlib/process_shim.c`. The join happens here rather than in\0A// the runtime, where it would have to be written in IR.\0A\0Aextern \22C\22 { fn process_capture_status(h: Int) -> Int; }\0A\0Alet process_run_raw (program: String) (args_joined: String) (argc: Int): Int = 0\0Alet process_exit_code_raw (handle: Int): Int = 0\0Alet process_stdout_raw (handle: Int): String = \22\22\0Alet process_stderr_raw (handle: Int): String = \22\22\0Alet process_free_raw (handle: Int): Bool = false\0A\0A/// What a finished process left behind.\0A///\0A/// `exit_code` is the child's own status: a non-zero one is an ordinary\0A/// result, not an error. Launch or output-capture failures return `Err`.\0Apub struct ProcessResult { pub exit_code: Int, pub stdout: String, pub stderr: String }\0A\0A/// NO leading separator: `process_run` points argv[1] at the WHOLE\0A/// joined string, so a leading tab makes argv[1] empty and pushes the\0A/// last real argument past `argc`, silently dropping it. A plain fold\0A/// that prefixes every element is NOT equivalent.\0Alet join_args_acc (args: Array[String]) (i: Int) (acc: String): String =\0A    if i >= args.len() { acc }\0A    else if i == 0 { join_args_acc(args, i + 1, args[i]) }\0A    else { join_args_acc(args, i + 1, acc.concat(\22\5Ct\22).concat(args[i])) }\0A\0A/// A non-zero exit code is an ordinary `Ok`. `Err` means the process\0A/// could not be started, or its output could not be captured completely.\0Apub let run_process (program: String) (args: Array[String]): Result[ProcessResult, String] = {\0A    let joined = join_args_acc(args, 0, \22\22);\0A    let handle = process_run_raw(program, joined, args.len());\0A    if handle < 0 { Err(\22Os.run_process: could not start process: \22.concat(program)) }\0A    else if unsafe { process_capture_status(handle) } != 0 {\0A        let freed = process_free_raw(handle);\0A        Err(\22Os.run_process: could not read captured output\22)\0A    }\0A    else {\0A        let result = ProcessResult {\0A            exit_code: process_exit_code_raw(handle),\0A            stdout: process_stdout_raw(handle),\0A            stderr: process_stderr_raw(handle),\0A        };\0A        let freed = process_free_raw(handle);\0A        Ok(result)\0A    }\0A}\0A\0A// --- Process identity ---\0A//\0A// argv, the working directory, stdin and stderr. `args()` has\0A// always existed as a compiler builtin and is documented now;\0A// the rest was reachable only through the private C shims the\0A// language server uses.\0Aextern \22C\22 {\0A    fn os_cwd() -> CStr;\0A    fn os_chdir(path: CStr) -> Int;\0A    fn stdin_line_n() -> Int;\0A    fn stdin_line_data() -> CStr;\0A    fn stdin_bytes_n(max: Int) -> Int;\0A    fn stdin_bytes_data() -> CStr;\0A    fn stdin_line_timed(timeout_nanos: Int) -> Int;\0A    fn stdin_bytes_timed(max: Int, timeout_nanos: Int) -> Int;\0A    fn stderr_write(s: CStr) -> Unit;\0A}\0A\0A/// The process's current working directory, as an absolute path.\0Apub let cwd (): Result[String, String] = unsafe {\0A    let d = os_cwd().as_string();\0A    if String.is_empty(d) { Err(\22Os.cwd: could not determine the working directory\22) } else { Ok(d) }\0A}\0A\0A/// Changes the process's working directory.\0A///\0A/// Affects the WHOLE process, including every relative path used\0A/// afterwards and every child it spawns — so a library that changes it\0A/// and does not change it back has altered something its caller never\0A/// agreed to.\0Apub let chdir (path: String): Result[Unit, String] = unsafe {\0A    if os_chdir(path.as_cstr()) == 0 { Ok(()) } else { Err(\22Os.chdir: could not change directory to \22.concat(path)) }\0A}\0A\0A/// `$HOME`, or `%USERPROFILE%` on Windows. `None` when unset or not valid UTF-8 --\0A/// no guessing from a username, because a guess that is usually right\0A/// is the worst kind of wrong for a path a program is about to write\0A/// to.\0Apub let home_dir (): Option[String] =\0A    if platform() == \22windows\22 { env_var(\22USERPROFILE\22) } else { env_var(\22HOME\22) }\0A\0A/// `None` is END OF STREAM and `Some(\22\22)` is a blank line, and\0A/// keeping those apart is the whole reason these exist. The shims the\0A/// language server uses return `\22\22` for both, so a filter reading\0A/// until end of input would stop at the first blank line, which is wrong in a\0A/// way that only shows up on real data.\0A///\0A/// The line arrives WITHOUT its newline, and a final line with no\0A/// trailing newline is an ordinary line rather than something to drop.\0Apub let read_stdin_line (): Result[Option[String], String] = unsafe {\0A    let n = stdin_line_n();\0A    if n < 0 { Ok(None) }\0A    else { match Bytes.from_cstr(stdin_line_data(), n).as_string() {\0A        Ok(text) => Ok(Some(text)),\0A        Err(e) => Err(\22Os.read_stdin_line: \22.concat(e)),\0A    } }\0A}\0A\0A/// Up to `max` bytes, as `Bytes`. Stdin carries whatever was piped\0A/// into it, which is not always text. With a positive maximum, an EMPTY\0A/// result is end of stream; a SHORT one is data, because a pipe hands\0A/// over what it has rather than waiting to fill a buffer.\0A///\0A/// A nonpositive `max_len` returns empty bytes immediately, without\0A/// consuming input or checking for end of stream.\0A///\0A/// The bytes are copied into a Plum value before this returns, so the\0A/// result stays valid across later reads; the shim's own buffer is\0A/// reused and would not.\0Apub let read_stdin (max_len: Int): Result[Bytes, String] = unsafe {\0A    let n = stdin_bytes_n(max_len);\0A    if n < 0 { Err(\22Os.read_stdin: read failed\22) } else { Ok(Bytes.from_cstr(stdin_bytes_data(), n)) }\0A}\0A\0A/// Writes to standard error and flushes. NOT `println`, which is\0A/// stdout, since a diagnostic that lands in the same stream as the\0A/// program's output cannot be separated from it by whoever is reading.\0A/// No trailing newline is added; say so if you want one.\0Apub let write_stderr (s: String): Unit = unsafe { stderr_write(s.as_cstr()); () }\0A\0A/// --- Reading with a deadline (issue #7) ---\0A///\0A/// Three outcomes, and `Option` has already spent itself on two of\0A/// them: `read_stdin_line` uses `None` for end of stream, which is the\0A/// distinction the whole function exists for. A timed read has to say\0A/// \22a line\22, \22the input ended\22 or \22nothing arrived in time\22, so it says\0A/// so in a type with three names rather than nesting two `Option`s and\0A/// asking the reader to remember which is which.\0Apub enum Input[T] { Got(T), Eof, TimedOut }\0A\0A/// The timeout bounds the WHOLE CALL, not just the wait for the first\0A/// byte, so a slow writer cannot leave a caller blocked mid-line past\0A/// its deadline. Bytes already read are kept, so `TimedOut` is never\0A/// data loss: calling again resumes where this stopped.\0Apub let read_stdin_line_timeout (d: Time.Duration): Result[Input[String], String] = unsafe {\0A    let n = stdin_line_timed(d.as_nanos());\0A    if n == 0 - 2 { Ok(TimedOut) }\0A    else if n < 0 { Ok(Eof) }\0A    else { match Bytes.from_cstr(stdin_line_data(), n).as_string() {\0A        Ok(text) => Ok(Got(text)),\0A        Err(e) => Err(\22Os.read_stdin_line_timeout: \22.concat(e)),\0A    } }\0A}\0A\0A/// Up to `max_len` bytes, with the same three outcomes. A SHORT read is\0A/// `Got`, not `TimedOut`: a pipe handing over what it has is data\0A/// arriving, not a deadline passing.\0A/// A nonpositive `max_len` returns `Got` with empty bytes immediately,\0A/// even at end of stream or with a zero timeout, without consuming input.\0Apub let read_stdin_timeout (max_len: Int) (d: Time.Duration): Result[Input[Bytes], String] = unsafe {\0A    let n = stdin_bytes_timed(max_len, d.as_nanos());\0A    if n == 0 - 2 { Ok(TimedOut) }\0A    else if n < 0 { Ok(Eof) }\0A    else { Ok(Got(Bytes.from_cstr(stdin_bytes_data(), n))) }\0A}\0A\0A// --- File metadata ---\0A//\0A// The rest of `stat(2)`. `is_directory` below was the first caller\0A// of it and keeps its own wrapper; these are the other fields.\0A//\0A// Loaded once and read field by field, so `Os.stat` costs ONE\0A// `stat` rather than one per field -- Plum's extern surface has no\0A// multi-value return, the same constraint `File.read` works around\