->verify_func(ctx, md_alg, hash, hash_len,\0A                                     sig, sig_len);\0A}\0A\0A/*\0A * Verify a signature\0A */\0Aint mbedtls_pk_verify(mbedtls_pk_context *ctx, mbedtls_md_type_t md_alg,\0A                      const unsigned char *hash, size_t hash_len,\0A                      const unsigned char *sig, size_t sig_len)\0A{\0A    return mbedtls_pk_verify_restartable(ctx, md_alg, hash, hash_len,\0A                                         sig, sig_len, NULL);\0A}\0A\0A/*\0A * Verify a signature with options\0A */\0Aint mbedtls_pk_verify_ext(mbedtls_pk_type_t type, const void *options,\0A                          mbedtls_pk_context *ctx, mbedtls_md_type_t md_alg,\0A                          const unsigned char *hash, size_t hash_len,\0A                          const unsigned char *sig, size_t sig_len)\0A{\0A    if ((md_alg != MBEDTLS_MD_NONE || hash_len != 0) && hash == NULL) {\0A        return MBEDTLS_ERR_PK_BAD_INPUT_DATA;\0A    }\0A\0A    if (ctx->pk_info == NULL) {\0A        return MBEDTLS_ERR_PK_BAD_INPUT_DATA;\0A    }\0A\0A    if (!mbedtls_pk_can_do(ctx, type)) {\0A        return MBEDTLS_ERR_PK_TYPE_MISMATCH;\0A    }\0A\0A    if (type != MBEDTLS_PK_RSASSA_PSS) {\0A        /* General case: no options */\0A        if (options != NULL) {\0A            return MBEDTLS_ERR_PK_BAD_INPUT_DATA;\0A        }\0A\0A        return mbedtls_pk_verify(ctx, md_alg, hash, hash_len, sig, sig_len);\0A    }\0A\0A    /* Ensure the PK context is of the right type otherwise mbedtls_pk_rsa()\0A     * below would return a NULL pointer. */\0A    if (mbedtls_pk_get_type(ctx) != MBEDTLS_PK_RSA) {\0A        return MBEDTLS_ERR_PK_FEATURE_UNAVAILABLE;\0A    }\0A\0A#if defined(MBEDTLS_RSA_C) && defined(MBEDTLS_PKCS1_V21)\0A    int ret = MBEDTLS_ERR_ERROR_CORRUPTION_DETECTED;\0A    const mbedtls_pk_rsassa_pss_options *pss_opts;\0A\0A#if SIZE_MAX > UINT_MAX\0A    if (md_alg == MBEDTLS_MD_NONE && UINT_MAX < hash_len) {\0A        return MBEDTLS_ERR_PK_BAD_INPUT_DATA;\0A    }\0A#endif\0A\0A    if (options == NULL) {\0A        return MBEDTLS_ERR_PK_BAD_INPUT_DATA;\0A    }\0A\0A    pss_opts = (const mbedtls_pk_rsassa_pss_options *) options;\0A\0A#if defined(MBEDTLS_USE_PSA_CRYPTO)\0A    if (pss_opts->mgf1_hash_id == md_alg) {\0A        unsigned char buf[MBEDTLS_PK_RSA_PUB_DER_MAX_BYTES];\0A        unsigned char *p;\0A        int key_len;\0A        size_t signature_length;\0A        psa_status_t status = PSA_ERROR_DATA_CORRUPT;\0A        psa_status_t destruction_status = PSA_ERROR_DATA_CORRUPT;\0A\0A        psa_algorithm_t psa_md_alg = mbedtls_md_psa_alg_from_type(md_alg);\0A        mbedtls_svc_key_id_t key_id = MBEDTLS_SVC_KEY_ID_INIT;\0A        psa_key_attributes_t attributes = PSA_KEY_ATTRIBUTES_INIT;\0A        psa_algorithm_t psa_sig_alg = PSA_ALG_RSA_PSS_ANY_SALT(psa_md_alg);\0A        p = buf + sizeof(buf);\0A        key_len = mbedtls_rsa_write_pubkey(mbedtls_pk_rsa(*ctx), buf, &p);\0A\0A        if (key_len < 0) {\0A            return key_len;\0A        }\0A\0A        psa_set_key_type(&attributes, PSA_KEY_TYPE_RSA_PUBLIC_KEY);\0A        psa_set_key_usage_flags(&attributes, PSA_KEY_USAGE_VERIFY_HASH);\0A        psa_set_key_algorithm(&attributes, psa_sig_alg);\0A\0A        status = psa_import_key(&attributes,\0A                                buf + sizeof(buf) - key_len, key_len,\0A                                &key_id);\0A        if (status != PSA_SUCCESS) {\0A            psa_destroy_key(key_id);\0A            return PSA_PK_TO_MBEDTLS_ERR(status);\0A        }\0A\0A        /* This function requires returning MBEDTLS_ERR_PK_SIG_LEN_MISMATCH\0A         * on a valid signature with trailing data in a buffer, but\0A         * mbedtls_psa_rsa_verify_hash requires the sig_len to be exact,\0A         * so for this reason the passed sig_len is overwritten. Smaller\0A         * signature lengths should not be accepted for verification. */\0A        signature_length = sig_len > mbedtls_pk_get_len(ctx) ?\0A                           mbedtls_pk_get_len(ctx) : sig_len;\0A        status = psa_verify_hash(key_id, psa_sig_alg, hash,\0A                                 hash_len, sig, signature_length);\0A        destruction_status = psa_destroy_key(key_id);\0A\0A        if (status == PSA_SUCCESS && sig_len > mbedtls_pk_get_len(ctx)) {\0A            return MBEDTLS_ERR_PK_SIG_LEN_MISMATCH;\0A        }\0A\0A        if (status == PSA_SUCCESS) {\0A            status = destruction_status;\0A        }\0A\0A        return PSA_PK_RSA_TO_MBEDTLS_ERR(status);\0A    } else\0A#endif /* MBEDTLS_USE_PSA_CRYPTO */\0A    {\0A        if (sig_len < mbedtls_pk_get_len(ctx)) {\0A            return MBEDTLS_ERR_RSA_VERIFY_FAILED;\0A        }\0A\0A        ret = mbedtls_rsa_rsassa_pss_verify_ext(mbedtls_pk_rsa(*ctx),\0A                                                md_alg, (unsigned int) hash_len, hash,\0A                                                pss_opts->mgf1_hash_id,\0A                                                pss_opts->expected_salt_len,\0A                                                sig);\0A        if (ret != 0) {\0A            return ret;\0A        }\0A\0A        if (sig_len > mbedtls_pk_get_len(ctx)) {\0A            return MBEDTLS_ERR_PK_SIG_LEN_MISMATCH;\0A        }\0A\0A        return 0;\0A    }\0A#else\0A    return MBEDTLS_ERR_PK_FEATURE_UNAVAILABLE;\0A#endif /* MBEDTLS_RSA_C && MBEDTLS_PKCS1_V21 */\0A}\0A\0A/*\0A * Make a signature (restartable)\0A */\0Aint mbedtls_pk_sign_restartable(mbedtls_pk_context *ctx,\0A                                mbedtls_md_type_t md_alg,\0A                                const unsigned char *hash, size_t hash_len,\0A                                unsigned char *sig, size_t sig_size, size_t *sig_len,\0A                                int (*f_rng)(void *, unsigned char *, size_t), void *p_rng,\0A                                mbedtls_pk_restart_ctx *rs_ctx)\0A{\0A    if ((md_alg != MBEDTLS_MD_NONE || hash_len != 0) && hash == NULL) {\0A        return MBEDTLS_ERR_PK_BAD_INPUT_DATA;\0A    }\0A\0A    if (ctx->pk_info == NULL || pk_hashlen_helper(md_alg, &hash_len) != 0) {\0A        return MBEDTLS_ERR_PK_BAD_INPUT_DATA;\0A    }\0A\0A#if defined(MBEDTLS_ECDSA_C) && defined(MBEDTLS_ECP_RESTARTABLE)\0A    /* optimization: use non-restartable version if restart disabled */\0A    if (rs_ctx != NULL &&\0A        mbedtls_ecp_restart_is_enabled() &&\0A        ctx->pk_info->sign_rs_func != NULL) {\0A        int ret = MBEDTLS_ERR_ERROR_CORRUPTION_DETECTED;\0A\0A        if ((ret = pk_restart_setup(rs_ctx, ctx->pk_info)) != 0) {\0A            return ret;\0A        }\0A\0A        ret = ctx->pk_info->sign_rs_func(ctx, md_alg,\0A                                         hash, hash_len,\0A                                         sig, sig_size, sig_len,\0A                                         f_rng, p_rng, rs_ctx->rs_ctx);\0A\0A        if (ret != MBEDTLS_ERR_ECP_IN_PROGRESS) {\0A            mbedtls_pk_restart_free(rs_ctx);\0A        }\0A\0A        return ret;\0A    }\0A#else /* MBEDTLS_ECDSA_C && MBEDTLS_ECP_RESTARTABLE */\0A    (void) rs_ctx;\0A#endif /* MBEDTLS_ECDSA_C && MBEDTLS_ECP_RESTARTABLE */\0A\0A    if (ctx->pk_info->sign_func == NULL) {\0A        return MBEDTLS_ERR_PK_TYPE_MISMATCH;\0A    }\0A\0A    return ctx->pk_info->sign_func(ctx, md_alg,\0A                                   hash, hash_len,\0A                                   sig, sig_size, sig_len,\0A                                   f_rng, p_rng);\0A}\0A\0A/*\0A * Make a signature\0A */\0Aint mbedtls_pk_sign(mbedtls_pk_context *ctx, mbedtls_md_type_t md_alg,\0A                    const unsigned char *hash, size_t hash_len,\0A                    unsigned char *sig, size_t sig_size, size_t *sig_len,\0A                    int (*f_rng)(void *, unsigned char *, size_t), void *p_rng)\0A{\0A    return mbedtls_pk_sign_restartable(ctx, md_alg, hash, hash_len,\0A                                       sig, sig_size, sig_len,\0A                                       f_rng, p_rng, NULL);\0A}\0A\0A/*\0A * Make a signature given a signature type.\0A */\0Aint mbedtls_pk_sign_ext(mbedtls_pk_type_t pk_type,\0A                        mbedtls_pk_context *ctx,\0A                        mbedtls_md_type_t md_alg,\0A                        const unsigned char *hash, size_t hash_len,\0A                        unsigned char *sig, size_t sig_size, size_t *sig_len,\0A                        int (*f_rng)(void *, unsigned char *, size_t),\0A                        void *p_rng)\0A{\0A    if (ctx->pk_info == NULL) {\0A        return MBEDTLS_ERR_PK_BAD_INPUT_DATA;\0A    }\0A\0A    if (!mbedtls_pk_can_do(ctx, pk_type)) {\0A        return MBEDTLS_ERR_PK_TYPE_MISMATCH;\0A    }\0A\0A    if (pk_type != MBEDTLS_PK_RSASSA_PSS) {\0A        return mbedtls_pk_sign(ctx, md_alg, hash, hash_len,\0A                               sig, sig_size, sig_len, f_rng, p_rng);\0A    }\0A\0A#if defined(MBEDTLS_RSA_C) && defined(MBEDTLS_PKCS1_V21)\0A\0A#if defined(MBEDTLS_USE_PSA_CRYPTO)\0A    const psa_algorithm_t psa_md_alg = mbedtls_md_psa_alg_from_type(md_alg);\0A    if (psa_md_alg == 0) {\0A        return MBEDTLS_ERR_PK_BAD_INPUT_DATA;\0A    }\0A\0A    if (mbedtls_pk_get_type(ctx) == MBEDTLS_PK_OPAQUE) {\0A        psa_status_t status;\0A\0A        /* PSA_ALG_RSA_PSS() behaves the same as PSA_ALG_RSA_PSS_ANY_SALT() when\0A         * performing a signature, but they are encoded differently. Instead of\0A         * extracting the proper one from the wrapped key policy, just try both. */\0A        status = psa_sign_hash(ctx->priv_id, PSA_ALG_RSA_PSS(psa_md_alg),\0A                               hash, hash_len,\0A                               sig, sig_size, sig_len);\0A        if (status == PSA_ERROR_NOT_PERMITTED) {\0A            status = psa_sign_hash(ctx->priv_id, PSA_ALG_RSA_PSS_ANY_SALT(psa_md_alg),\0A                                   hash, hash_len,\0A                                   sig, sig_size, sig_len);\0A        }\0A        return PSA_PK_RSA_TO_MBEDTLS_ERR(status);\0A    }\0A\0A    return mbed