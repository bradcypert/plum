@.str41637 = private global { i64, i64, [15404 x i8] } { i64 -1, i64 15403, [15404 x i8] c"/**\0A * \5Cfile psa_crypto_storage.h\0A *\0A * \5Cbrief PSA cryptography module: Mbed TLS key storage\0A */\0A/*\0A *  Copyright The Mbed TLS Contributors\0A *  SPDX-License-Identifier: Apache-2.0 OR GPL-2.0-or-later\0A */\0A\0A#ifndef PSA_CRYPTO_STORAGE_H\0A#define PSA_CRYPTO_STORAGE_H\0A\0A#ifdef __cplusplus\0Aextern \22C\22 {\0A#endif\0A\0A#include \22psa/crypto.h\22\0A#include \22psa/crypto_se_driver.h\22\0A\0A#include <stdint.h>\0A#include <string.h>\0A\0A/* Limit the maximum key size in storage. */\0A#if defined(MBEDTLS_PSA_STATIC_KEY_SLOTS)\0A/* Reflect the maximum size for the key buffer. */\0A#define PSA_CRYPTO_MAX_STORAGE_SIZE (MBEDTLS_PSA_STATIC_KEY_SLOT_BUFFER_SIZE)\0A#else\0A/* Just set an upper boundary but it should have no effect since the key size\0A * is limited in memory. */\0A#define PSA_CRYPTO_MAX_STORAGE_SIZE (PSA_BITS_TO_BYTES(PSA_MAX_KEY_BITS))\0A#endif\0A\0A/* Sanity check: a file size must fit in 32 bits. Allow a generous\0A * 64kB of metadata. */\0A#if PSA_CRYPTO_MAX_STORAGE_SIZE > 0xffff0000\0A#error \22PSA_CRYPTO_MAX_STORAGE_SIZE > 0xffff0000\22\0A#endif\0A\0A/** The maximum permitted persistent slot number.\0A *\0A * In Mbed Crypto 0.1.0b:\0A * - Using the file backend, all key ids are ok except 0.\0A * - Using the ITS backend, all key ids are ok except 0xFFFFFF52\0A *   (#PSA_CRYPTO_ITS_RANDOM_SEED_UID) for which the file contains the\0A *   device's random seed (if this feature is enabled).\0A * - Only key ids from 1 to #MBEDTLS_PSA_KEY_SLOT_COUNT are actually used.\0A *\0A * Since we need to preserve the random seed, avoid using that key slot.\0A * Reserve a whole range of key slots just in case something else comes up.\0A *\0A * This limitation will probably become moot when we implement client\0A * separation for key storage.\0A */\0A#define PSA_MAX_PERSISTENT_KEY_IDENTIFIER PSA_KEY_ID_VENDOR_MAX\0A\0A/**\0A * \5Cbrief Checks if persistent data is stored for the given key slot number\0A *\0A * This function checks if any key data or metadata exists for the key slot in\0A * the persistent storage.\0A *\0A * \5Cparam key           Persistent identifier to check.\0A *\0A * \5Cretval 0\0A *         No persistent data present for slot number\0A * \5Cretval 1\0A *         Persistent data present for slot number\0A */\0Aint psa_is_key_present_in_storage(const mbedtls_svc_key_id_t key);\0A\0A/**\0A * \5Cbrief Format key data and metadata and save to a location for given key\0A *        slot.\0A *\0A * This function formats the key data and metadata and saves it to a\0A * persistent storage backend. The storage location corresponding to the\0A * key slot must be empty, otherwise this function will fail. This function\0A * should be called after loading the key into an internal slot to ensure the\0A * persistent key is not saved into a storage location corresponding to an\0A * already occupied non-persistent key, as well as ensuring the key data is\0A * validated.\0A *\0A * Note: This function will only succeed for key buffers which are not\0A * empty. If passed a NULL pointer or zero-length, the function will fail\0A * with #PSA_ERROR_INVALID_ARGUMENT.\0A *\0A * \5Cparam[in] attr          The attributes of the key to save.\0A *                          The key identifier field in the attributes\0A *                          determines the key's location.\0A * \5Cparam[in] data          Buffer containing the key data.\0A * \5Cparam data_length       The number of bytes that make up the key data.\0A *\0A * \5Cretval #PSA_SUCCESS \5Cemptydescription\0A * \5Cretval #PSA_ERROR_INVALID_ARGUMENT \5Cemptydescription\0A * \5Cretval #PSA_ERROR_INSUFFICIENT_MEMORY \5Cemptydescription\0A * \5Cretval #PSA_ERROR_INSUFFICIENT_STORAGE \5Cemptydescription\0A * \5Cretval #PSA_ERROR_STORAGE_FAILURE \5Cemptydescription\0A * \5Cretval #PSA_ERROR_ALREADY_EXISTS \5Cemptydescription\0A * \5Cretval #PSA_ERROR_DATA_INVALID \5Cemptydescription\0A * \5Cretval #PSA_ERROR_DATA_CORRUPT \5Cemptydescription\0A */\0Apsa_status_t psa_save_persistent_key(const psa_key_attributes_t *attr,\0A                                     const uint8_t *data,\0A                                     const size_t data_length);\0A\0A/**\0A * \5Cbrief Parses key data and metadata and load persistent key for given\0A * key slot number.\0A *\0A * This function reads from a storage backend, parses the key data and\0A * metadata and writes them to the appropriate output parameters.\0A *\0A * Note: This function allocates a buffer and returns a pointer to it through\0A * the data parameter. On successful return, the pointer is guaranteed to be\0A * valid and the buffer contains at least one byte of data.\0A * psa_free_persistent_key_data() must be called on the data buffer\0A * afterwards to zeroize and free this buffer.\0A *\0A * \5Cparam[in,out] attr      On input, the key identifier field identifies\0A *                          the key to load. Other fields are ignored.\0A *                          On success, the attribute structure contains\0A *                          the key metadata that was loaded from storage.\0A * \5Cparam[out] data         Pointer to an allocated key data buffer on return.\0A * \5Cparam[out] data_length  The number of bytes that make up the key data.\0A *\0A * \5Cretval #PSA_SUCCESS \5Cemptydescription\0A * \5Cretval #PSA_ERROR_INSUFFICIENT_MEMORY \5Cemptydescription\0A * \5Cretval #PSA_ERROR_DATA_INVALID \5Cemptydescription\0A * \5Cretval #PSA_ERROR_DATA_CORRUPT \5Cemptydescription\0A * \5Cretval #PSA_ERROR_DOES_NOT_EXIST \5Cemptydescription\0A */\0Apsa_status_t psa_load_persistent_key(psa_key_attributes_t *attr,\0A                                     uint8_t **data,\0A                                     size_t *data_length);\0A\0A/**\0A * \5Cbrief Remove persistent data for the given key slot number.\0A *\0A * \5Cparam key           Persistent identifier of the key to remove\0A *                      from persistent storage.\0A *\0A * \5Cretval #PSA_SUCCESS\0A *         The key was successfully removed,\0A *         or the key did not exist.\0A * \5Cretval #PSA_ERROR_DATA_INVALID \5Cemptydescription\0A */\0Apsa_status_t psa_destroy_persistent_key(const mbedtls_svc_key_id_t key);\0A\0A/**\0A * \5Cbrief Free the temporary buffer allocated by psa_load_persistent_key().\0A *\0A * This function must be called at some point after psa_load_persistent_key()\0A * to zeroize and free the memory allocated to the buffer in that function.\0A *\0A * \5Cparam key_data        Buffer for the key data.\0A * \5Cparam key_data_length Size of the key data buffer.\0A *\0A */\0Avoid psa_free_persistent_key_data(uint8_t *key_data, size_t key_data_length);\0A\0A/**\0A * \5Cbrief Formats key data and metadata for persistent storage\0A *\0A * \5Cparam[in] data          Buffer containing the key data.\0A * \5Cparam data_length       Length of the key data buffer.\0A * \5Cparam[in] attr          The core attributes of the key.\0A * \5Cparam[out] storage_data Output buffer for the formatted data.\0A *\0A */\0Avoid psa_format_key_data_for_storage(const uint8_t *data,\0A                                     const size_t data_length,\0A                                     const psa_key_attributes_t *attr,\0A                                     uint8_t *storage_data);\0A\0A/**\0A * \5Cbrief Parses persistent storage data into key data and metadata\0A *\0A * \5Cparam[in] storage_data     Buffer for the storage data.\0A * \5Cparam storage_data_length  Length of the storage data buffer\0A * \5Cparam[out] key_data        On output, pointer to a newly allocated buffer\0A *                             containing the key data. This must be freed\0A *                             using psa_free_persistent_key_data()\0A * \5Cparam[out] key_data_length Length of the key data buffer\0A * \5Cparam[out] attr            On success, the attribute structure is filled\0A *                             with the loaded key metadata.\0A *\0A * \5Cretval #PSA_SUCCESS \5Cemptydescription\0A * \5Cretval #PSA_ERROR_INSUFFICIENT_MEMORY \5Cemptydescription\0A * \5Cretval #PSA_ERROR_DATA_INVALID \5Cemptydescription\0A */\0Apsa_status_t psa_parse_key_data_from_storage(const uint8_t *storage_data,\0A                                             size_t storage_data_length,\0A                                             uint8_t **key_data,\0A                                             size_t *key_data_length,\0A                                             psa_key_attributes_t *attr);\0A\0A#if defined(MBEDTLS_PSA_CRYPTO_SE_C)\0A/** This symbol is defined if transaction support is required. */\0A#define PSA_CRYPTO_STORAGE_HAS_TRANSACTIONS 1\0A#endif\0A\0A#if defined(PSA_CRYPTO_STORAGE_HAS_TRANSACTIONS)\0A\0A/** The type of transaction that is in progress.\0A */\0A/* This is an integer type rather than an enum for two reasons: to support\0A * unknown values when loading a transaction file, and to ensure that the\0A * type has a known size.\0A */\0Atypedef uint16_t psa_crypto_transaction_type_t;\0A\0A/** No transaction is in progress.\0A *\0A * This has the value 0, so zero-initialization sets a transaction's type to\0A * this value.\0A */\0A#define PSA_CRYPTO_TRANSACTION_NONE             ((psa_crypto_transaction_type_t) 0x0000)\0A\0A/** A key creation transaction.\0A *\0A * This is only used for keys in an external cryptoprocessor (secure element).\0A * Keys in RAM or in internal storage are created atomically in storage\0A * (simple file creation), so they do not need a transaction mechanism.\0A */\0A#define PSA_CRYPTO_TRANSACTION_CREATE_KEY       ((psa_crypto_transaction_type_t) 0x0001)\0A\0A/** A key destruction transaction.\0A *\0A * This is only used for keys in an external cryptoprocessor (secure element).\0A * Keys in RAM or in internal storage are destroyed atomically in storage\0A * (simple file deletion), so they do not need a transaction mechanism.\0A */\0A#define PSA_CRYPTO_TRANSACTION_DESTROY_KEY      ((psa_crypto_transaction_type_t) 0x0002)\0A\0A/** Transaction data.\0A *\0A * This type is designed to be serialized by writing the memory representation\0A * and reading it back on the same device.\0A *\0A * \5Cnote The transaction mechanism is not thread-safe. There can only be one\0A *       single active transaction at a time.\0A *       The transaction object is #psa_crypto_transaction.\0A *\0A * \5Cnote If an API call starts a transaction, it must complete this transaction\0A *       before returning to the application.\0A *\0A * The lifetime of a transaction is the following (note that only one\0A * transaction may be active at a time):\0A *\0A * -# Call psa_crypto_prepare_transaction() to initialize the transaction\0A *    object in memory and declare the type of transaction that is starting.\0A * -# Fill in the type-specific fields of #psa_crypto_transaction.\0A * -# Call psa_crypto_save_transaction() to start the transaction. This\0A *    saves the transaction data to internal storage.\0A * -# Perform the work of the transaction by modifying files, contacting\0A *    external entities, or whatever needs doing. Note that the transaction\0A *    may be interrupted by a power failure, so you need to have a way\0A *    recover from interruptions either by undoing what has been done\0A *    so far or by resuming where you left off.\0A * -# If there are intermediate stages in the transaction, update\0A *    the fields of #psa_crypto_transaction and call\0A *    psa_crypto_save_transaction() again when each stage is reached.\0A * -# When the transaction is over, call psa_crypto_stop_transaction() to\0A *    remove the transaction data in storage and in memory.\0A *\0A * If the system crashes while a transaction is in progress, psa_crypto_init()\0A * calls psa_crypto_load_transaction() and takes care of completing or\0A * rewinding the transaction. This is done in psa_crypto_recover_transaction()\0A * in psa_crypto.c. If you add a new type of transaction, be\0A * sure to add code for it in psa_crypto_recover_transaction().\0A */\0Atypedef union {\0A    /* Each element of this union must have the following properties\0A     * to facilitate serialization and deserialization:\0A     *\0A     * - The element is a struct.\0A     * - The first field of the struct is `psa_crypto_transaction_type_t type`.\0A     * - Elements of the struct are arranged such a way that there is\0A     *   no padding.\0A     */\0A    struct psa_crypto_transaction_unknown_s {\0A        psa_crypto_transaction_type_t type;\0A        uint16_t unused1;\0A        uint32_t unused2;\0A        uint64_t unused3;\0A        uint64_t unused4;\0A    } unknown;\0A    /* ::type is #PSA_CRYPTO_TRANSACTION_CREATE_KEY or\0A     * #PSA_CRYPTO_TRANSACTION_DESTROY_KEY. */\0A    struct psa_crypto_transaction_key_s {\0A        psa_crypto_transaction_type_t type;\0A        uint16_t unused1;\0A        psa_key_lifetime_t lifetime;\0A        psa_key_slot_number_t slot;\0A        mbedtls_svc_key_id_t id;\0A    } key;\0A} psa_crypto_transaction_t;\0A\0A/** The single active transaction.\0A */\0Aextern psa_crypto_transaction_t psa_crypto_transaction;\0A\0A/** Prepare for a transaction.\0A *\0A * There must not be an ongoing transaction.\0A *\0A * \5Cparam type          The type of transaction to start.\0A */\0Astatic inline void psa_crypto_prepare_transaction(\0A    psa_crypto_transaction_type_t type)\0A{\0A    psa_crypto_transaction.unknown.type = type;\0A}\0A\0A/** Save the transaction data to storage.\0A *\0A * You may call this function multiple times during a transaction to\0A * atomically update the transaction state.\0A *\0A * \5Cretval #PSA_SUCCESS \5Cemptydescription\0A * \5Cretval #PSA_ERROR_DATA_CORRUPT \5Cemptydescription\0A * \5Cretval #PSA_ERROR_INSUFFICIENT_STORAGE \5Cemptydescription\0A * \5Cretval #PSA_ERROR_STORAGE_FAILURE \5Cemptydescription\0A */\0Apsa_status_t psa_crypto_save_transaction(void);\0A\0A/** Load the transaction data from storage, if any.\0A *\0A * This function is meant to be called from psa_crypto_init() to recover\0A * in case a transaction was interrupted by a system crash.\0A *\0A * \5Cretval #PSA_SUCCESS\0A *         The data about the ongoing transaction has been loaded to\0A *         #psa_crypto_transaction.\0A * \5Cretval #PSA_ERROR_DOES_NOT_EXIST\0A *         There is no ongoing transaction.\0A * \5Cretval #PSA_ERROR_STORAGE_FAILURE \5Cemptydescription\0A * \5Cretval #PSA_ERROR_DATA_INVALID \5Cemptydescription\0A * \5Cretval #PSA_ERROR_DATA_CORRUPT \5Cemptydescription\0A */\0Apsa_status_t psa_crypto_load_transaction(void);\0A\0A/** Indicate that the current transaction is finished.\0A *\0A * Call this function at the very end of transaction processing.\0A * This function does not \22commit\22 or \22abort\22 the transaction: the storage\0A * subsystem has no concept of \22commit\22 and \22abort\22, just saving and\0A * removing the transaction information in storage.\0A *\0A * This function erases the transaction data in storage (if any) and\0A * resets the transaction data in memory.\0A *\0A * \5Cretval #PSA_SUCCESS\0A *         There was transaction data in storage.\0A * \5Cretval #PSA_ERROR_DOES_NOT_EXIST\0A *         There was no transaction data in storage.\0A * \5Cretval #PSA_ERROR_STORAGE_FAILURE\0A *         It was impossible to determine whether there was transaction data\0A *         in storage, or the transaction data could not be erased.\0A */\0Apsa_status_t psa_crypto_stop_transaction(void);\0A\0A/** The ITS file identifier for the transaction data.\0A *\0A * 0xffffffNN = special file; 0x74 = 't' for transaction.\0A */\0A#define PSA_CRYPTO_ITS_TRANSACTION_UID ((psa_key_id_t) 0xffffff74)\0A\0A#endif /* PSA_CRYPTO_STORAGE_HAS_TRANSACTIONS */\0A\0A#if defined(MBEDTLS_PSA_INJECT_ENTROPY)\0A/** Backend side of mbedtls_psa_inject_entropy().\0A *\0A * This function stores the supplied data into the entropy seed file.\0A *\0A * \5Cretval #PSA_SUCCESS\0A *         Success\0A * \5Cretval #PSA_ERROR_STORAGE_FAILURE \5Cemptydescription\0A * \5Cretval #PSA_ERROR_INSUFFICIENT_STORAGE \5Cemptydescription\0A * \5Cretval #PSA_ERROR_NOT_PERMITTED\0A *         The entropy seed file already exists.\0A */\0Apsa_status_t mbedtls_psa_storage_inject_entropy(const unsigned char *seed,\0A                                                size_t seed_size);\0A#endif /* MBEDTLS_PSA_INJECT_ENTROPY */\0A\0A#ifdef __cplusplus\0A}\0A#endif\0A\0A#endif /* PSA_CRYPTO_STORAGE_H */\0A\00" }
