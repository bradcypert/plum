@.str45825 = private global { i64, i64, [7274 x i8] } { i64 -1, i64 7273, [7274 x i8] c"/*\0A *  Copyright The Mbed TLS Contributors\0A *  SPDX-License-Identifier: Apache-2.0 OR GPL-2.0-or-later\0A */\0A\0A/**\0A * \5Cfile mps_common.h\0A *\0A * \5Cbrief Common functions and macros used by MPS\0A */\0A\0A#ifndef MBEDTLS_MPS_COMMON_H\0A#define MBEDTLS_MPS_COMMON_H\0A\0A#include \22mps_error.h\22\0A\0A#include <stdio.h>\0A\0A/**\0A * \5Cname SECTION:       MPS Configuration\0A *\0A * \5C{\0A */\0A\0A/*! This flag controls whether the MPS-internal components\0A *  (reader, writer, Layer 1-3) perform validation of the\0A *  expected abstract state at the entry of API calls.\0A *\0A *  Context: All MPS API functions impose assumptions/preconditions on the\0A *  context on which they operate. For example, every structure has a notion of\0A *  state integrity which is established by `xxx_init()` and preserved by any\0A *  calls to the MPS API which satisfy their preconditions and either succeed,\0A *  or fail with an error code which is explicitly documented to not corrupt\0A *  structure integrity (such as WANT_READ and WANT_WRITE);\0A *  apart from `xxx_init()` any function assumes state integrity as a\0A *  precondition (but usually more). If any of the preconditions is violated,\0A *  the function's behavior is entirely undefined.\0A *  In addition to state integrity, all MPS structures have a more refined\0A *  notion of abstract state that the API operates on. For example, all layers\0A *  have a notion of 'abstract read state' which indicates if incoming data has\0A *  been passed to the user, e.g. through mps_l2_read_start() for Layer 2\0A *  or mps_l3_read() in Layer 3. After such a call, it doesn't make sense to\0A *  call these reading functions again until the incoming data has been\0A *  explicitly 'consumed', e.g. through mps_l2_read_consume() for Layer 2 or\0A *  mps_l3_read_consume() on Layer 3. However, even if it doesn't make sense,\0A *  it's a design choice whether the API should fail gracefully on such\0A *  non-sensical calls or not, and that's what this option is about:\0A *\0A *  This option determines whether the expected abstract state\0A *  is part of the API preconditions or not: If the option is set,\0A *  then the abstract state is not part of the precondition and is\0A *  thus required to be validated by the implementation. If an unexpected\0A *  abstract state is encountered, the implementation must fail gracefully\0A *  with error #MBEDTLS_ERR_MPS_OPERATION_UNEXPECTED.\0A *  Conversely, if this option is not set, then the expected abstract state\0A *  is included in the preconditions of the respective API calls, and\0A *  an implementation's behaviour is undefined if the abstract state is\0A *  not as expected.\0A *\0A *  For example: Enabling this makes mps_l2_read_done() fail if\0A *  no incoming record is currently open; disabling this would\0A *  lead to undefined behavior in this case.\0A *\0A *  Comment this to remove state validation.\0A */\0A#define MBEDTLS_MPS_STATE_VALIDATION\0A\0A/*! This flag enables/disables assertions on the internal state of MPS.\0A *\0A *  Assertions are sanity checks that should never trigger when MPS\0A *  is used within the bounds of its API and preconditions.\0A *\0A *  Enabling this increases security by limiting the scope of\0A *  potential bugs, but comes at the cost of increased code size.\0A *\0A *  Note: So far, there is no guiding principle as to what\0A *  expected conditions merit an assertion, and which don't.\0A *\0A *  Comment this to disable assertions.\0A */\0A#define MBEDTLS_MPS_ENABLE_ASSERTIONS\0A\0A/*! This flag controls whether tracing for MPS should be enabled. */\0A//#define MBEDTLS_MPS_ENABLE_TRACE\0A\0A#if defined(MBEDTLS_MPS_STATE_VALIDATION)\0A\0A#define MBEDTLS_MPS_STATE_VALIDATE_RAW(cond, string)                         \5C\0A    do                                                                         \5C\0A    {                                                                          \5C\0A        if (!(cond))                                                          \5C\0A        {                                                                      \5C\0A            MBEDTLS_MPS_TRACE(MBEDTLS_MPS_TRACE_TYPE_ERROR, string);         \5C\0A            MBEDTLS_MPS_TRACE_RETURN(MBEDTLS_ERR_MPS_OPERATION_UNEXPECTED);  \5C\0A        }                                                                      \5C\0A    } while (0)\0A\0A#else /* MBEDTLS_MPS_STATE_VALIDATION */\0A\0A#define MBEDTLS_MPS_STATE_VALIDATE_RAW(cond, string)           \5C\0A    do                                                           \5C\0A    {                                                            \5C\0A        (cond);                                                \5C\0A    } while (0)\0A\0A#endif /* MBEDTLS_MPS_STATE_VALIDATION */\0A\0A#if defined(MBEDTLS_MPS_ENABLE_ASSERTIONS)\0A\0A#define MBEDTLS_MPS_ASSERT_RAW(cond, string)                          \5C\0A    do                                                                  \5C\0A    {                                                                   \5C\0A        if (!(cond))                                                   \5C\0A        {                                                               \5C\0A            MBEDTLS_MPS_TRACE(MBEDTLS_MPS_TRACE_TYPE_ERROR, string);  \5C\0A            MBEDTLS_MPS_TRACE_RETURN(MBEDTLS_ERR_MPS_INTERNAL_ERROR); \5C\0A        }                                                               \5C\0A    } while (0)\0A\0A#else /* MBEDTLS_MPS_ENABLE_ASSERTIONS */\0A\0A#define MBEDTLS_MPS_ASSERT_RAW(cond, string) do {} while (0)\0A\0A#endif /* MBEDTLS_MPS_ENABLE_ASSERTIONS */\0A\0A\0A/* \5C} name SECTION: MPS Configuration */\0A\0A/**\0A * \5Cname SECTION:       Common types\0A *\0A * Various common types used throughout MPS.\0A * \5C{\0A */\0A\0A/** \5Cbrief   The type of buffer sizes and offsets used in MPS structures.\0A *\0A *           This is an unsigned integer type that should be large enough to\0A *           hold the length of any buffer or message processed by MPS.\0A *\0A *           The reason to pick a value as small as possible here is\0A *           to reduce the size of MPS structures.\0A *\0A * \5Cwarning  Care has to be taken when using a narrower type\0A *           than ::mbedtls_mps_size_t here because of\0A *           potential truncation during conversion.\0A *\0A * \5Cwarning  Handshake messages in TLS may be up to 2^24 ~ 16Mb in size.\0A *           If mbedtls_mps_[opt_]stored_size_t is smaller than that, the\0A *           maximum handshake message is restricted accordingly.\0A *\0A * For now, we use the default type of size_t throughout, and the use of\0A * smaller types or different types for ::mbedtls_mps_size_t and\0A * ::mbedtls_mps_stored_size_t is not yet supported.\0A *\0A */\0Atypedef size_t mbedtls_mps_stored_size_t;\0A#define MBEDTLS_MPS_STORED_SIZE_MAX  (SIZE_MAX)\0A\0A/** \5Cbrief The type of buffer sizes and offsets used in the MPS API\0A *         and implementation.\0A *\0A *         This must be at least as wide as ::mbedtls_stored_size_t but\0A *         may be chosen to be strictly larger if more suitable for the\0A *         target architecture.\0A *\0A *         For example, in a test build for ARM Thumb, using uint_fast16_t\0A *         instead of uint16_t reduced the code size from 1060 Byte to 962 Byte,\0A *         so almost 10%.\0A */\0Atypedef size_t mbedtls_mps_size_t;\0A#define MBEDTLS_MPS_SIZE_MAX  (SIZE_MAX)\0A\0A#if MBEDTLS_MPS_STORED_SIZE_MAX > MBEDTLS_MPS_SIZE_MAX\0A#error \22Misconfiguration of mbedtls_mps_size_t and mbedtls_mps_stored_size_t.\22\0A#endif\0A\0A/* \5C} SECTION: Common types */\0A\0A\0A#endif /* MBEDTLS_MPS_COMMON_H */\0A\00" }
