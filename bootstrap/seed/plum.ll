s_entropy_context *ctx = (mbedtls_entropy_context *) data;\0A    unsigned char buf[MBEDTLS_ENTROPY_BLOCK_SIZE];\0A\0A    if (len > MBEDTLS_ENTROPY_BLOCK_SIZE) {\0A        return MBEDTLS_ERR_ENTROPY_SOURCE_FAILED;\0A    }\0A\0A#if defined(MBEDTLS_ENTROPY_NV_SEED)\0A    /* Update the NV entropy seed before generating any entropy for outside\0A     * use.\0A     */\0A    if (ctx->initial_entropy_run == 0) {\0A        ctx->initial_entropy_run = 1;\0A        if ((ret = mbedtls_entropy_update_nv_seed(ctx)) != 0) {\0A            return ret;\0A        }\0A    }\0A#endif\0A\0A#if defined(MBEDTLS_THREADING_C)\0A    if ((ret = mbedtls_mutex_lock(&ctx->mutex)) != 0) {\0A        return ret;\0A    }\0A#endif\0A\0A    /*\0A     * Always gather extra entropy before a call\0A     */\0A    do {\0A        if (count++ > ENTROPY_MAX_LOOP) {\0A            ret = MBEDTLS_ERR_ENTROPY_SOURCE_FAILED;\0A            goto exit;\0A        }\0A\0A        if ((ret = entropy_gather_internal(ctx)) != 0) {\0A            goto exit;\0A        }\0A\0A        thresholds_reached = 1;\0A        strong_size = 0;\0A        for (i = 0; i < ctx->source_count; i++) {\0A            if (ctx->source[i].size < ctx->source[i].threshold) {\0A                thresholds_reached = 0;\0A            }\0A            if (ctx->source[i].strong == MBEDTLS_ENTROPY_SOURCE_STRONG) {\0A                strong_size += ctx->source[i].size;\0A            }\0A        }\0A    } while (!thresholds_reached || strong_size < MBEDTLS_ENTROPY_BLOCK_SIZE);\0A\0A    memset(buf, 0, MBEDTLS_ENTROPY_BLOCK_SIZE);\0A\0A    /*\0A     * Note that at this stage it is assumed that the accumulator was started\0A     * in a previous call to entropy_update(). If this is not guaranteed, the\0A     * code below will fail.\0A     */\0A    if ((ret = mbedtls_md_finish(&ctx->accumulator, buf)) != 0) {\0A        goto exit;\0A    }\0A\0A    /*\0A     * Reset accumulator and counters and recycle existing entropy\0A     */\0A    mbedtls_md_free(&ctx->accumulator);\0A    mbedtls_md_init(&ctx->accumulator);\0A    ret = mbedtls_md_setup(&ctx->accumulator,\0A                           mbedtls_md_info_from_type(MBEDTLS_ENTROPY_MD), 0);\0A    if (ret != 0) {\0A        goto exit;\0A    }\0A    ret = mbedtls_md_starts(&ctx->accumulator);\0A    if (ret != 0) {\0A        goto exit;\0A    }\0A    if ((ret = mbedtls_md_update(&ctx->accumulator, buf,\0A                                 MBEDTLS_ENTROPY_BLOCK_SIZE)) != 0) {\0A        goto exit;\0A    }\0A\0A    /*\0A     * Perform second hashing on entropy\0A     */\0A    if ((ret = mbedtls_md(mbedtls_md_info_from_type(MBEDTLS_ENTROPY_MD),\0A                          buf, MBEDTLS_ENTROPY_BLOCK_SIZE, buf)) != 0) {\0A        goto exit;\0A    }\0A\0A    for (i = 0; i < ctx->source_count; i++) {\0A        ctx->source[i].size = 0;\0A    }\0A\0A    memcpy(output, buf, len);\0A\0A    ret = 0;\0A\0Aexit:\0A    mbedtls_platform_zeroize(buf, sizeof(buf));\0A\0A#if defined(MBEDTLS_THREADING_C)\0A    if (mbedtls_mutex_unlock(&ctx->mutex) != 0) {\0A        return MBEDTLS_ERR_THREADING_MUTEX_ERROR;\0A    }\0A#endif\0A\0A    return ret;\0A}\0A\0A#if defined(MBEDTLS_ENTROPY_NV_SEED)\0Aint mbedtls_entropy_update_nv_seed(mbedtls_entropy_context *ctx)\0A{\0A    int ret = MBEDTLS_ERR_ENTROPY_FILE_IO_ERROR;\0A    unsigned char buf[MBEDTLS_ENTROPY_BLOCK_SIZE];\0A\0A    /* Read new seed  and write it to NV */\0A    if ((ret = mbedtls_entropy_func(ctx, buf, MBEDTLS_ENTROPY_BLOCK_SIZE)) != 0) {\0A        return ret;\0A    }\0A\0A    if (mbedtls_nv_seed_write(buf, MBEDTLS_ENTROPY_BLOCK_SIZE) < 0) {\0A        return MBEDTLS_ERR_ENTROPY_FILE_IO_ERROR;\0A    }\0A\0A    /* Manually update the remaining stream with a separator value to diverge */\0A    memset(buf, 0, MBEDTLS_ENTROPY_BLOCK_SIZE);\0A    ret = mbedtls_entropy_update_manual(ctx, buf, MBEDTLS_ENTROPY_BLOCK_SIZE);\0A\0A    return ret;\0A}\0A#endif /* MBEDTLS_ENTROPY_NV_SEED */\0A\0A#if defined(MBEDTLS_FS_IO)\0Aint mbedtls_entropy_write_seed_file(mbedtls_entropy_context *ctx, const char *path)\0A{\0A    int ret = MBEDTLS_ERR_ERROR_CORRUPTION_DETECTED;\0A    FILE *f = NULL;\0A    unsigned char buf[MBEDTLS_ENTROPY_BLOCK_SIZE];\0A\0A    if ((ret = mbedtls_entropy_func(ctx, buf, MBEDTLS_ENTROPY_BLOCK_SIZE)) != 0) {\0A        ret = MBEDTLS_ERR_ENTROPY_SOURCE_FAILED;\0A        goto exit;\0A    }\0A\0A    if ((f = fopen(path, \22wb\22)) == NULL) {\0A        ret = MBEDTLS_ERR_ENTROPY_FILE_IO_ERROR;\0A        goto exit;\0A    }\0A\0A    /* Ensure no stdio buffering of secrets, as such buffers cannot be wiped. */\0A    mbedtls_setbuf(f, NULL);\0A\0A    if (fwrite(buf, 1, MBEDTLS_ENTROPY_BLOCK_SIZE, f) != MBEDTLS_ENTROPY_BLOCK_SIZE) {\0A        ret = MBEDTLS_ERR_ENTROPY_FILE_IO_ERROR;\0A        goto exit;\0A    }\0A\0A    ret = 0;\0A\0Aexit:\0A    mbedtls_platform_zeroize(buf, sizeof(buf));\0A\0A    if (f != NULL) {\0A        fclose(f);\0A    }\0A\0A    return ret;\0A}\0A\0Aint mbedtls_entropy_update_seed_file(mbedtls_entropy_context *ctx, const char *path)\0A{\0A    int ret = 0;\0A    FILE *f;\0A    size_t n;\0A    unsigned char buf[MBEDTLS_ENTROPY_MAX_SEED_SIZE];\0A\0A    if ((f = fopen(path, \22rb\22)) == NULL) {\0A        return MBEDTLS_ERR_ENTROPY_FILE_IO_ERROR;\0A    }\0A\0A    /* Ensure no stdio buffering of secrets, as such buffers cannot be wiped. */\0A    mbedtls_setbuf(f, NULL);\0A\0A    fseek(f, 0, SEEK_END);\0A    n = (size_t) ftell(f);\0A    fseek(f, 0, SEEK_SET);\0A\0A    if (n > MBEDTLS_ENTROPY_MAX_SEED_SIZE) {\0A        n = MBEDTLS_ENTROPY_MAX_SEED_SIZE;\0A    }\0A\0A    if (fread(buf, 1, n, f) != n) {\0A        ret = MBEDTLS_ERR_ENTROPY_FILE_IO_ERROR;\0A    } else {\0A        ret = mbedtls_entropy_update_manual(ctx, buf, n);\0A    }\0A\0A    fclose(f);\0A\0A    mbedtls_platform_zeroize(buf, sizeof(buf));\0A\0A    if (ret != 0) {\0A        return ret;\0A    }\0A\0A    return mbedtls_entropy_write_seed_file(ctx, path);\0A}\0A#endif /* MBEDTLS_FS_IO */\0A\0A#if defined(MBEDTLS_SELF_TEST)\0A/*\0A * Dummy source function