\5Cparam sig_size  The size of the \5Cp sig buffer in bytes.\0A * \5Cparam sig_len   On successful return,\0A *                  the number of bytes written to \5Cp sig.\0A * \5Cparam f_rng     RNG function, must not be \5Cc NULL.\0A * \5Cparam p_rng     RNG parameter\0A * \5Cparam rs_ctx    Restart context (NULL to disable restart)\0A *\0A * \5Creturn          See \5Cc mbedtls_pk_sign().\0A * \5Creturn          #MBEDTLS_ERR_ECP_IN_PROGRESS if maximum number of\0A *                  operations was reached: see \5Cc mbedtls_ecp_set_max_ops().\0A */\0Aint mbedtls_pk_sign_restartable(mbedtls_pk_context *ctx,\0A                                mbedtls_md_type_t md_alg,\0A                                const unsigned char *hash, size_t hash_len,\0A                                unsigned char *sig, size_t sig_size, size_t *sig_len,\0A                                int (*f_rng)(void *, unsigned char *, size_t), void *p_rng,\0A                                mbedtls_pk_restart_ctx *rs_ctx);\0A\0A/**\0A * \5Cbrief           Decrypt message (including padding if relevant).\0A *\0A * \5Cparam ctx       The PK context to use. It must have been set up\0A *                  with a private key.\0A * \5Cparam input     Input to decrypt\0A * \5Cparam ilen      Input size\0A * \5Cparam output    Decrypted output\0A * \5Cparam olen      Decrypted message length\0A * \5Cparam osize     Size of the output buffer\0A * \5Cparam f_rng     RNG function, must not be \5Cc NULL.\0A * \5Cparam p_rng     RNG parameter\0A *\0A * \5Cnote            For keys of type #MBEDTLS_PK_RSA, the signature algorithm is\0A *                  either PKCS#1 v1.5 or OAEP, depending on the padding mode in\0A *                  the underlying RSA context. For a pk object constructed by\0A *                  parsing, this is PKCS#1 v1.5 by default.\0A *\0A * \5Creturn          0 on success, or a specific error code.\0A */\0Aint mbedtls_pk_decrypt(mbedtls_pk_context *ctx,\0A                       const unsigned char *input, size_t ilen,\0A                       unsigned char *output, size_t *olen, size_t osize,\0A                       int (*f_rng)(void *, unsigned char *, size_t), void *p_rng);\0A\0A/**\0A * \5Cbrief           Encrypt message (including padding if relevant).\0A *\0A * \5Cparam ctx       The PK context to use. It must have been set up.\0A * \5Cparam input     Message to encrypt\0A * \5Cparam ilen      Message size\0A * \5Cparam output    Encrypted output\0A * \5Cparam olen      Encrypted output length\0A * \5Cparam osize     Size of the output buffer\0A * \5Cparam f_rng     RNG function, must not be \5Cc NULL.\0A * \5Cparam p_rng     RNG parameter\0A *\0A * \5Cnote            For keys of type #MBEDTLS_PK_RSA, the signature algorithm is\0A *                  either PKCS#1 v1.5 or OAEP, depending on the padding mode in\0A *                  the underlying RSA context. For a pk object constructed by\0A *                  parsing, this is PKCS#1 v1.5 by default.\0A *\0A * \5Cnote            \5Cp f_rng is used for padding generation.\0A *\0A * \5Creturn          0 on success, or a specific error code.\0A */\0Aint mbedtls_pk_encrypt(mbedtls_pk_context *ctx,\0A                       const unsigned char *input, size_t ilen,\0A                       unsigned char *output, size_t *olen, size_t osize,\0A                       int (*f_rng)(void *, unsigned char *, size_t), void *p_rng);\0A\0A/**\0A * \5Cbrief           Check if a public-private pair of keys matches.\0A *\0A * \5Cparam pub       Context holding a public key.\0A * \5Cparam prv       Context holding a private (and public) key.\0A * \5Cparam f_rng     RNG function, must not be \5Cc NULL.\0A * \5Cparam p_rng     RNG parameter\0A *\0A * \5Creturn          \5Cc 0 on success (keys were checked and match each other).\0A * \5Creturn          #MBEDTLS_ERR_PK_FEATURE_UNAVAILABLE if the keys could not\0A *                  be checked - in that case they may or may not match.\0A * \5Creturn          #MBEDTLS_ERR_PK_BAD_INPUT_DATA if a context is invalid.\0A * \5Creturn          Another non-zero value if the keys do not match.\0A */\0Aint mbedtls_pk_check_pair(const mbedtls_pk_context *pub,\0A                          const mbedtls_pk_context *prv,\0A                          int (*f_rng)(void *, unsigned char *, size_t),\0A                          void *p_rng);\0A\0A/**\0A * \5Cbrief           Export debug information\0A *\0A * \5Cparam ctx       The PK context to use. It must have been initialized.\0A * \5Cparam items     Place to write debug items\0A *\0A * \5Creturn          0 on success or MBEDTLS_ERR_PK_BAD_INPUT_DATA\0A */\0Aint mbedtls_pk_debug(const mbedtls_pk_context *ctx, mbedtls_pk_debug_item *items);\0A\0A/**\0A * \5Cbrief           Access the type name\0A *\0A * \5Cparam ctx       The PK context to use. It must have been initialized.\0A *\0A * \5Creturn          Type name on success, or \22invalid PK\22\0A */\0Aconst char *mbedtls_pk_get_name(const mbedtls_pk_context *ctx);\0A\0A/**\0A * \5Cbrief           Get the key type\0A *\0A * \5Cparam ctx       The PK context to use. It must have been initialized.\0A *\0A * \5Creturn          Type on success.\0A * \5Creturn          #MBEDTLS_PK_NONE for a context that has not been set up.\0A */\0Ambedtls_pk_type_t mbedtls_pk_get_type(const mbedtls_pk_context *ctx);\0A\0A#if defined(MBEDTLS_RSA_C)\0A/**\0A * Quick access to an RSA context inside a PK context.\0A *\0A * \5Cwarning This function can only be used when the type of the context, as\0A * returned by mbedtls_pk_get_type(), is #MBEDTLS_PK_RSA.\0A * Ensuring that is the caller's responsibility.\0A * Alternatively, you can check whether this function returns NULL.\0A *\0A * \5Creturn The internal RSA context held by the PK context, or NULL.\0A */\0Astatic inline mbedtls_rsa_context *mbedtls_pk_rsa(const mbedtls_pk_context pk)\0A{\0A    switch (mbedtls_pk_get_type(&pk)) {\0A        case MBEDTLS_PK_RSA:\0A            return (mbedtls_rsa_context *) (pk).MBEDTLS_PRIVATE(pk_ctx);\0A        default:\0A            return NULL;\0A    }\0A}\0A#endif /* MBEDTLS_RSA_C */\0A\0A#if defined(MBEDTLS_ECP_C)\0A/**\0A * Quick access to an EC context inside a PK context.\0A *\0A * \5Cwarning This function can only be used when the type of the context, as\0A * returned by mbedtls_pk_get_type(), is #MBEDTLS_PK_ECKEY,\0A * #MBEDTLS_PK_ECKEY_DH, or #MBEDTLS_PK_ECDSA.\0A * Ensuring that is the caller's responsibility.\0A * Alternatively, you can check whether this function returns NULL.\0A *\0A * \5Creturn The internal EC context held by the PK context, or NULL.\0A */\0Astatic inline mbedtls_ecp_keypair *mbedtls_pk_ec(const mbedtls_pk_context pk)\0A{\0A    switch (mbedtls_pk_get_type(&pk)) {\0A        case MBEDTLS_PK_ECKEY:\0A        case MBEDTLS_PK_ECKEY_DH:\0A        case MBEDTLS_PK_ECDSA:\0A            return (mbedtls_ecp_keypair *) (pk).MBEDTLS_PRIVATE(pk_ctx);\0A        default:\0A            return NULL;\0A    }\0A}\0A#endif /* MBEDTLS_ECP_C */\0A\0A#if defined(MBEDTLS_PK_PARSE_C)\0A/** \5Cingroup pk_module */\0A/**\0A * \5Cbrief           Parse a private key in PEM or DER format\0A *\0A * \5Cnote            If #MBEDTLS_USE_PSA_CRYPTO is enabled, the PSA crypto\0A *                  subsystem must have been initialized by calling\0A *                  psa_crypto_init() before calling this function.\0A *\0A * \5Cparam ctx       The PK context to fill. It must have been initialized\0A *                  but not set up.\0A * \5Cparam key       Input buffer to parse.\0A *                  The buffer must contain the input exactly, with no\0A *                  extra trailing material. For PEM, the buffer must\0A *                  contain a null-terminated string.\0A * \5Cparam keylen    Size of \5Cb key in bytes.\0A *                  For PEM data, this includes the terminating null byte,\0A *                  so \5Cp keylen must be equal to `strlen(key) + 1`.\0A * \5Cparam pwd       Optional password for decryption.\0A *                  Pass \5Cc NULL if expecting a non-encrypted key.\0A *                  Pass a string of \5Cp pwdlen bytes if expecting an encrypted\0A *                  key; a non-encrypted key will also be accepted.\0A *                  The empty password is not supported.\0A * \5Cparam pwdlen    Size of the password in bytes.\0A *                  Ignored if \5Cp pwd is \5Cc NULL.\0A * \5Cparam f_rng     RNG function, must not be \5Cc NULL. Used for blinding.\0A * \5Cparam p_rng     RNG parameter\0A *\0A * \5Cnote            On entry, ctx must be empty, either freshly initialised\0A *                  with mbedtls_pk_init() or reset with mbedtls_pk_free(). If you need a\0A *                  specific key type, check the result with mbedtls_pk_can_do().\0A *\0A * \5Cnote            The key is also checked for correctness.\0A *\0A * \5Creturn          0 if successful, or a specific PK or PEM error code\0A */\0Aint mbedtls_pk_parse_key(mbedtls_pk_context *ctx,\0A                         const unsigned char *key, size_t keylen,\0A                         const unsigned char *pwd, size_t pwdlen,\0A                         int (*f_rng)(void *, unsigned char *, size_t), void *p_rng);\0A\0A/** \5Cingroup pk_module */\0A/**\0A * \5Cbrief           Parse a public key in PEM or DER format\0A *\0A * \5Cnote            If #MBEDTLS_USE_PSA_CRYPTO is enabled, the PSA crypto\0A *                  subsystem must have been initialized by calling\0A *                  psa_crypto_init() before calling this function.\0A *\0A * \5Cparam ctx       The PK context to fill. It must have been initialized\0A *                  but not set up.\0A * \5Cparam key       Input buffer to parse.\0A *                  The buffer must contain the input exactly, with no\0A *                  extra trailing material. For PEM, the buffer must\0A *                  contain a null-terminated string.\0A * \5Cparam keylen    Size of \5Cb key in bytes.\0A *                  For PEM data, this includes the terminating null byte,\0A *                  so \5Cp keylen must be equal to `strlen(key) + 1`.\0A *\0A * \5Cnote            On entry, ctx must be empty, either freshly initialised\0A *                  with mbedtls_pk_init() or reset with mbedtls_pk_free(). If you need a\0A *                  specific key type, check the result with mbedtls_pk_can_do().\0A *\0A * \5Cnote            For compressed points, see #MBEDTLS_ECP_PF_COMPRESSED for\0A *                  limitations.\0A *\0A * \5Cnote            The key is also checked for correctness.\0A *\0A * \5Creturn          0 if successful, or a specific PK or PEM error code\0A */\0Aint mbedtls_pk_parse_public_key(mbedtls_pk_context *ctx,\0A                                const unsigned char *key, size_t keylen);\0A\0A#if defined(MBEDTLS_FS_IO)\0A/** \5Cingroup pk_module */\0A/**\0A * \5Cbrief           Load and parse a private key\0A *\0A * \5Cnote            If #MBEDTLS_USE_PSA_CRYPTO is enabled, the PSA crypto\0A *                  subsystem must have been initialized by calling\0A *                  psa_crypto_init() before calling this function.\0A *\0A * \5Cparam ctx       The PK context to fill. It must have been initialized\0A *                  but not set up.\0A * \5Cparam path      filename to read the private key from\0A * \5Cparam password  Optional password to decrypt the file.\0A *                  Pass \5Cc NULL if expecting a non-encrypted key.\0A *                  Pass a null-terminated string if expecting an encrypted\0A *                  key; a non-encrypted key will also be accepted.\0A *                  The empty password is not supported.\0A * \5Cparam f_rng     RNG function, must not be \5Cc NULL. Used for blinding.\0A * \5Cparam p_rng     RNG parameter\0A *\0A * \5Cnote            On entry, ctx must be empty, either freshly initialised\0A *                  with mbedtls_pk_init() or reset with mbedtls_pk_free(). If you need a\0A *                  specific key type, check the result with mbedtls_pk_can_do().\0A *\0A * \5Cnote            The key is also checked for correctness.\0A *\0A * \5Creturn          0 if successful, or a specific PK or PEM error code\0A */\0Aint mbedtls_pk_parse_keyfile(mbedtls_pk_context *ctx,\0A                             const char *path, const char *password,\0A                             int (*f_rng)(void *, unsigned char *, size_t), void *p_rng);\0A\0A/** \5Cingroup pk_module */\0A/**\0A * \5Cbrief           Load and parse a public key\0A *\0A * \5Cparam ctx       The PK context to fill. It must have been initialized\0A *                  but not set up.\0A * \5Cparam path      filename to read the public key from\0A *\0A * \5Cnote            On entry, ctx must be empty, either freshly initialised\0A *                  with mbedtls_pk_init() or reset with mbedtls_pk_free(). If\0A *                  you need a specific key type, check the result with\0A *                  mbedtls_pk_can_do().\0A *\0A * \5Cnote            The key is also checked for correctness.\0A *\0A * \5Creturn          0 if successful, or a specific PK or PEM error code\0A */\0Aint mbedtls_pk_parse_public_keyfile(mbedtls_pk_context *ctx, const char *path);\0A#endif /* MBEDTLS_FS_IO */\0A#endif /* MBEDTLS_PK_PARSE_C */\0A\0A#if defined(MBEDTLS_PK_WRITE_C)\0A/**\0A * \5Cbrief           Write a private key to a PKCS#1 or SEC1 DER structure\0A *                  Note: data is written at the end of the buffer! Use the\0A *                        return value to determine where you should start\0A *                        using the buffer\0A *\0A * \5Cparam ctx       PK context which must contain a valid private key.\0A * \5Cparam buf       buffer to write to\0A * \5Cparam size      size of the buffer\0A *\0A * \5Creturn          length of data written if successful, or a specific\0A *                  error code\0A */\0Aint mbedtls_pk_write_key_der(const mbedtls_pk_context *ctx, unsigned char *buf, size_t size);\0A\0A/**\0A * \5Cbrief           Write a public key to a SubjectPublicKeyInfo DER structure\0A *                  Note: data is written at the end of the buffer! Use the\0A *                        return value to determine where you should start\0A *                        using the buffer\0A *\0A * \5Cparam ctx       PK context which must contain a valid public or private key.\0A * \5Cparam buf       buffer to write to\0A * \5Cparam size      size of the buffer\0A *\0A * \5Creturn          length of data written if successful, or a specific\0A *                  error code\0A */\0Aint mbedtls_pk_write_pubkey_der(const mbedtls_pk_context *ctx, unsigned char *buf, size_t size);\0A\0A#if defined(MBEDTLS_PEM_WRITE_C)\0A/**\0A * \5Cbrief           Write a public key to a PEM string\0A *\0A * \5Cparam ctx       PK context which must contain a valid public or private key.\0A * \5Cparam buf       Buffer to write to. The output includes a\0A *                  terminating null byte.\0A * \5Cparam size      Size of the buffer in bytes.\0A *\0A * \5Creturn          0 if successful, or a specific error code\0A */\0Aint mbedtls_pk_write_pubkey_pem(const mbedtls_pk_context *ctx, unsigned char *buf, size_t size);\0A\0A/**\0A * \5Cbrief           Write a private key to a PKCS#1 or SEC1 PEM string\0A *\0A * \5Cparam ctx       PK context which must contain a valid private key.\0A * \5Cparam buf       Buffer to write to. The output includes a\0A *                  terminating null byte.\0A * \5Cparam size      Size of the buffer in bytes.\0A *\0A * \5Creturn          0 if successful, or a specific error code\0A */\0Aint mbedtls_pk_write_key_pem(const mbedtls_pk_context *ctx, unsigned char *buf, size_t size);\0A#endif /* MBEDTLS_PEM_WRITE_C */\0A#endif /* MBEDTLS_PK_WRITE_C */\0A\0A/*\0A * WARNING: Low-level functions. You probably do not want to use these unless\0A *          you are certain you do ;)\0A */\0A\0A#if defined(MBEDTLS_PK_PARSE_C)\0A/**\0A * \5Cbrief           Parse a SubjectPublicKeyInfo DER structure\0A *\0A * \5Cparam p         the position in the ASN.1 data\0A * \5Cparam end       end of the buffer\0A * \5Cparam pk        The PK context to fill. It must have been initialized\0A *                  but not set up.\0A *\0A * \5Creturn          0 if successful, or a specific PK error code\0A */\0Aint mbedtls_pk_parse_subpubkey(unsigned char **p, const unsigned char *end,\0A                               mbedtls_pk_context *pk);\0A#endif /* MBEDTLS_PK_PARSE_C */\0A\0A#if defined(MBEDTLS_PK_WRITE_C)\0A/**\0A * \5Cbrief           Write a subjectPublicKey to ASN.1 data\0A *                  Note: function works backwards in data buffer\0A *\0A * \5Cparam p         reference to current position pointer\0A * \5Cparam start     start of the buffer (for bounds-checking)\0A * \5Cparam key       PK context which must contain a valid public or private key.\0A *\0A * \5Creturn          the length written or a negative error code\0A */\0Aint mbedtls_pk_write_pubkey(unsigned char **p, unsigned char *start,\0A                            const mbedtls_pk_context *key);\0A#endif /* MBEDTLS_PK_WRITE_C */\0A\0A#ifdef __cplusplus\0A}\0A#endif\0A\0A#endif /* MBEDTLS_PK_H */\0A\00" }
