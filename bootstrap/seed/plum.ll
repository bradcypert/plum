A}\0A\0Avoid mbedtls_ssl_transform_free(mbedtls_ssl_transform *transform)\0A{\0A    if (transform == NULL) {\0A        return;\0A    }\0A\0A#if defined(MBEDTLS_USE_PSA_CRYPTO)\0A    psa_destroy_key(transform->psa_key_enc);\0A    psa_destroy_key(transform->psa_key_dec);\0A#else\0A    mbedtls_cipher_free(&transform->cipher_ctx_enc);\0A    mbedtls_cipher_free(&transform->cipher_ctx_dec);\0A#endif /* MBEDTLS_USE_PSA_CRYPTO */\0A\0A#if defined(MBEDTLS_SSL_SOME_SUITES_USE_MAC)\0A#if defined(MBEDTLS_USE_PSA_CRYPTO)\0A    psa_destroy_key(transform->psa_mac_enc);\0A    psa_destroy_key(transform->psa_mac_dec);\0A#else\0A    mbedtls_md_free(&transform->md_ctx_enc);\0A    mbedtls_md_free(&transform->md_ctx_dec);\0A#endif /* MBEDTLS_USE_PSA_CRYPTO */\0A#endif\0A\0A    mbedtls_platform_zeroize(transform, sizeof(mbedtls_ssl_transform));\0A}\0A\0Avoid mbedtls_ssl_set_inbound_transform(mbedtls_ssl_context *ssl,\0A                                       mbedtls_ssl_transform *transform)\0A{\0A    ssl->transform_in = transform;\0A    memset(ssl->in_ctr, 0, MBEDTLS_SSL_SEQUENCE_NUMBER_LEN);\0A}\0A\0Avoid mbedtls_ssl_set_outbound_transform(mbedtls_ssl_context *ssl,\0A                                        mbedtls_ssl_transform *transform)\0A{\0A    ssl->transform_out = transform;\0A    memset(ssl->cur_out_ctr, 0, sizeof(ssl->cur_out_ctr));\0A}\0A\0A#if defined(MBEDTLS_SSL_PROTO_DTLS)\0A\0Avoid mbedtls_ssl_buffering_free(mbedtls_ssl_context *ssl)\0A{\0A    unsigned offset;\0A    mbedtls_ssl_handshake_params * const hs = ssl->handshake;\0A\0A    if (hs == NULL) {\0A        return;\0A    }\0A\0A    ssl_free_buffered_record(ssl);\0A\0A    for (offset = 0; offset < MBEDTLS_SSL_MAX_BUFFERED_HS; offset++) {\0A        ssl_buffering_free_slot(ssl, offset);\0A    }\0A}\0A\0Astatic void ssl_buffering_free_slot(mbedtls_ssl_context *ssl,\0A                                    uint8_t slot)\0A{\0A    mbedtls_ssl_handshake_params * const hs = ssl->handshake;\0A    mbedtls_ssl_hs_buffer * const hs_buf = &hs->buffering.hs[slot];\0A\0A    if (slot >= MBEDTLS_SSL_MAX_BUFFERED_HS) {\0A        return;\0A    }\0A\0A    if (hs_buf->is_valid == 1) {\0A        hs->buffering.total_bytes_buffered -= hs_buf->data_len;\0A        mbedtls_zeroize_and_free(hs_buf->data, hs_buf->data_len);\0A        memset(hs_buf, 0, sizeof(mbedtls_ssl_hs_buffer));\0A    }\0A}\0A\0A#endif /* MBEDTLS_SSL_PROTO_DTLS */\0A\0A/*\0A * Convert version numbers to/from wire format\0A * and, for DTLS, to/from TLS equivalent.\0A *\0A * For TLS this is the identity.\0A * For DTLS, map as follows, then use 1's complement (v -> ~v):\0A * 1.x <-> 3.x+1    for x != 0 (DTLS 1.2 based on TLS 1.2)\0A *                  DTLS 1.0 is stored as TLS 1.1 internally\0A */\0Avoid mbedtls_ssl_write_version(unsigned char version[2], int transport,\0A                               mbedtls_ssl_protocol_version tls_version)\0A{\0A    uint16_t tls_version_formatted;\0A#if defined(MBEDTLS_SSL_PROTO_DTLS)\0A    if (transport == MBEDTLS_SSL_TRANSPORT_DATAGRAM) {\0A        tls_version_formatted =\0A            ~(tls_version - (tls_version == 0x0302 ? 0x0202 : 0x0201));\0A    } else\0A#else\0A    ((void) transport);\0A#endif\0A    {\0A        tls_version_formatted = (uint16_t) tls_version;\0A    }\0A    MBEDTLS_PUT_UINT16_BE(tls_version_formatted, version, 0);\0A}\0A\0Auint16_t mbedtls_ssl_read_version(const unsigned char version[2],\0A                                  int transport)\0A{\0A    uint16_t tls_version = MBEDTLS_GET_UINT16_BE(version, 0);\0A#if defined(MBEDTLS_SSL_PROTO_DTLS)\0A    if (transport == MBEDTLS_SSL_TRANSPORT_DATAGRAM) {\0A        tls_version =\0A            ~(tls_version - (tls_version == 0xfeff ? 0x0202 : 0x0201));\0A    }\0A#else\0A    ((void) transport);\0A#endif\0A    return tls_version;\0A}\0A\0A/*\0A * Send pending fatal alert.\0A * 0,   No alert message.\0A * !0,  if mbedtls_ssl_send_alert_message() returned in error, the error code it\0A *      returned, ssl->alert_reason otherwise.\0A */\0Aint mbedtls_ssl_handle_pending_alert(mbedtls_ssl_context *ssl)\0A{\0A    int ret;\0A\0A    /* No pending alert, return success*/\0A    if (ssl->send_alert == 0) {\0A        return 0;\0A    }\0A\0A    ret = mbedtls_ssl_send_alert_message(ssl,\0A                                         MBEDTLS_SSL_ALERT_LEVEL_FATAL,\0A                                         ssl->alert_type);\0A\0A    /* If mbedtls_ssl_send_alert_message() returned with MBEDTLS_ERR_SSL_WANT_WRITE,\0A     * do not clear the alert to be able to send it later.\0A     */\0A    if (ret != MBEDTLS_ERR_SSL_WANT_WRITE) {\0A        ssl->send_alert = 0;\0A    }\0A\0A    if (ret != 0) {\0A        return ret;\0A    }\0A\0A    return ssl->alert_reason;\0A}\0A\0A/*\0A * Set pending fatal alert flag.\0A */\0Avoid mbedtls_ssl_pend_fatal_alert(mbedtls_ssl_context *ssl,\0A                                  unsigned char alert_type,\0A                                  int alert_reason)\0A{\0A    ssl->send_alert = 1;\0A    ssl->alert_type = alert_type;\0A    ssl->alert_reason = alert_reason;\0A}\0A\0A#endif /* MBEDTLS_SSL_TLS_C */\0A\00" }
