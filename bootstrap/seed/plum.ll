ld be blocking on a non-blocking socket\0A * and thus 'failed' with a negative return value.\0A */\0Astatic int net_would_block(const mbedtls_net_context *ctx)\0A{\0A    ((void) ctx);\0A    return WSAGetLastError() == WSAEWOULDBLOCK;\0A}\0A#else\0A/*\0A * Check if the requested operation would be blocking on a non-blocking socket\0A * and thus 'failed' with a negative return value.\0A *\0A * Note: on a blocking socket this function always returns 0!\0A */\0Astatic int net_would_block(const mbedtls_net_context *ctx)\0A{\0A    int err = errno;\0A\0A    /*\0A     * Never return 'WOULD BLOCK' on a blocking socket\0A     */\0A    if ((fcntl(ctx->fd, F_GETFL) & O_NONBLOCK) != O_NONBLOCK) {\0A        errno = err;\0A        return 0;\0A    }\0A\0A    switch (errno = err) {\0A#if defined EAGAIN\0A        case EAGAIN:\0A#endif\0A#if defined EWOULDBLOCK && EWOULDBLOCK != EAGAIN\0A        case EWOULDBLOCK:\0A#endif\0A    return 1;\0A    }\0A    return 0;\0A}\0A#endif /* ( _WIN32 || _WIN32_WCE ) && !EFIX64 && !EFI32 */\0A\0A/*\0A * Accept a connection from a remote client\0A */\0Aint mbedtls_net_accept(mbedtls_net_context *bind_ctx,\0A                       mbedtls_net_context *client_ctx,\0A                       void *client_ip, size_t buf_size, size_t *cip_len)\0A{\0A    int ret = MBEDTLS_ERR_ERROR_CORRUPTION_DETECTED;\0A    int type;\0A\0A    struct sockaddr_storage client_addr;\0A\0A#if defined(__socklen_t_defined) || defined(_SOCKLEN_T) ||  \5C\0A    defined(_SOCKLEN_T_DECLARED) || defined(__DEFINED_socklen_t) || \5C\0A    defined(socklen_t) || (defined(_POSIX_VERSION) && _POSIX_VERSION >= 200112L)\0A    socklen_t n = (socklen_t) sizeof(client_addr);\0A    socklen_t type_len = (socklen_t) sizeof(type);\0A#else\0A    int n = (int) sizeof(client_addr);\0A    int type_len = (int) sizeof(type);\0A#endif\0A\0A    /* Is this a TCP or UDP socket? */\0A    if (getsockopt(bind_ctx->fd, SOL_SOCKET, SO_TYPE,\0A                   (void *) &type, &type_len) != 0 ||\0A        (type != S