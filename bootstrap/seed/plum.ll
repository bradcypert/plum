bal_data_t global_data;\0A\0Astatic uint8_t psa_get_initialized(void)\0A{\0A    uint8_t initialized;\0A\0A#if defined(MBEDTLS_THREADING_C)\0A    mbedtls_mutex_lock(&mbedtls_threading_psa_rngdata_mutex);\0A#endif /* defined(MBEDTLS_THREADING_C) */\0A\0A    initialized = global_data.rng_state == RNG_SEEDED;\0A\0A#if defined(MBEDTLS_THREADING_C)\0A    mbedtls_mutex_unlock(&mbedtls_threading_psa_rngdata_mutex);\0A#endif /* defined(MBEDTLS_THREADING_C) */\0A\0A#if defined(MBEDTLS_THREADING_C)\0A    mbedtls_mutex_lock(&mbedtls_threading_psa_globaldata_mutex);\0A#endif /* defined(MBEDTLS_THREADING_C) */\0A\0A    initialized =\0A        (initialized && (global_data.initialized == PSA_CRYPTO_SUBSYSTEM_ALL_INITIALISED));\0A\0A#if defined(MBEDTLS_THREADING_C)\0A    mbedtls_mutex_unlock(&mbedtls_threading_psa_globaldata_mutex);\0A#endif /* defined(MBEDTLS_THREADING_C) */\0A\0A    return initialized;\0A}\0A\0Astatic uint8_t psa_get_drivers_initialized(void)\0A{\0A    uint8_t initialized;\0A\0A#if defined(MBEDTLS_THREADING_C)\0A    mbedtls_mutex_lock(&mbedtls_threading_psa_globaldata_mutex);\0A#endif /* defined(MBEDTLS_THREADING_C) */\0A\0A    initialized = (global_data.initialized & PSA_CRYPTO_SUBSYSTEM_DRIVER_WRAPPERS_INITIALIZED) != 0;\0A\0A#if defined(MBEDTLS_THREADING_C)\0A    mbedtls_mutex_unlock(&mbedtls_threading_psa_globaldata_mutex);\0A#endif /* defined(MBEDTLS_THREADING_C) */\0A\0A    return initialized;\0A}\0A\0A#define GUARD_MODULE_INITIALIZED        \5C\0A    if (psa_get_initialized() == 0)     \5C\0A    return PSA_ERROR_BAD_STATE;\0A\0A#if !defined(MBEDTLS_PSA_ASSUME_EXCLUSIVE_BUFFERS)\0A\0A/* Declare a local copy of an input buffer and a variable that will be used\0A * to store a pointer to the start of the buffer.\0A *\0A * Note: This macro must be called before any operations which may jump to\0A * the exit label, so that the local input copy object is safe to be freed.\0A *\0A * Assumptions:\0A * - input is the name of a pointer to the buffer to be copied\0A * - The name LOCAL_INPUT_COPY_OF_input is unused in the current scope\0A * - input_copy_name is a name that is unused in the current scope\0A */\0A#define LOCAL_INPUT_DECLARE(input, input_copy_name) \5C\0A    psa_crypto_local_input_t LOCAL_INPUT_COPY_OF_##input = PSA_CRYPTO_LOCAL_INPUT_INIT; \5C\0A    const uint8_t *input_copy_name = NULL;\0A\0A/* Allocate a copy of the buffer input and set the pointer input_copy to\0A * point to the start of the copy.\0A *\0A * Assumptions:\0A * - psa_status_t status exists\0A * - An exit label is declared\0A * - input is the name of a pointer to the buffer to be copied\0A * - LOCAL_INPUT_DECLARE(input, input_copy) has previously been called\0A */\0A#define LOCAL_INPUT_ALLOC(input, length, input_copy) \5C\0A    status = psa_crypto_local_input_alloc(input, length, \5C\0A                                          &LOCAL_INPUT_COPY_OF_##input); \5C\0A    if (status != PSA_SUCCESS) { \5C\0A        goto exit; \5C\0A    } \5C\0A    input_copy = LOCAL_INPUT_COPY_OF_##input.buffer;\0A\0A/* Free the local input copy allocated previously by LOCAL_INPUT_ALLOC()\0A *\0A * Assumptions:\0A * - input_copy is the name of the input copy pointer set by LOCAL_INPUT_ALLOC()\0A * - input is the name of the original buffer that was copied\0A */\0A#define LOCAL_INPUT_FREE(input, input_copy) \5C\0A    input_copy = NULL; \5C\0A    psa_crypto_local_input_free(&LOCAL_INPUT_COPY_OF_##input);\0A\0A/* Declare a local copy of an output buffer and a variable that will be used\0A * to store a pointer to the start of the buffer.\0A *\0A * Note: This macro must be called before any operations which may jump to\0A * the exit label, so that the local output copy object is safe to be freed.\0A *\0A * Assumptions:\0A * - output is the name of a pointer to the buffer to be copied\0A * - The name LOCAL_OUTPUT_COPY_OF_output is unused in the current scope\0A * - output_copy_name is a name that is unused in the current scope\0A */\0A#define LOCAL_OUTPUT_DECLARE(output, output_copy_name) \5C\0A    psa_crypto_local_output_t LOCAL_OUTPUT_COPY_OF_##output = PSA_CRYPTO_LOCAL_OUTPUT_INIT; \5C\0A    uint8_t *output_copy_name = NULL;\0A\0A/* Allocate a copy of the buffer output and set the pointer output_copy to\0A * point to the start of the copy.\0A *\0A * Assumptions:\0A * - psa_status_t status exists\0A * - An exit label is declared\0A * - output is the name of a pointer to the buffer to be copied\0A * - LOCAL_OUTPUT_DECLARE(output, output_copy) has previously been called\0A */\0A#define LOCAL_OUTPUT_ALLOC(output, length, output_copy) \5C\0A    status = psa_crypto_local_output_alloc(output, length, \5C\0A                                           &LOCAL_OUTPUT_COPY_OF_##output); \5C\0A    if (status != PSA_SUCCESS) { \5C\0A        goto exit; \5C\0A    } \5C\0A    output_copy = LOCAL_OUTPUT_COPY_OF_##output.buffer;\0A\0A/* Free the local output copy allocated previously by LOCAL_OUTPUT_ALLOC()\0A * after first copying back its contents to the original buffer.\0A *\0A * Assumptions:\0A * - psa_status_t status exists\0A * - output_copy is the name of the output copy pointer set by LOCAL_OUTPUT_ALLOC()\0A * - output is the name of the original buffer that was copied\0A */\0A#define LOCAL_OUTPUT_FREE(output, output_copy) \5C\0A    output_copy = NULL; \5C\0A    do { \5C\0A        psa_status_t local_output_status; \5C\0A        local_output_status = psa_crypto_local_output_free(&LOCAL_OUTPUT_COPY_OF_##output); \5C\0A        if (local_output_status != PSA_SUCCESS) { \5C\0A            /* Since this error case is an internal error, it's more serious than \5C\0A             * any existing error code and so it's fine to overwrite the existing \5C\0A             * status. */ \5C\0A            status = local_output_status; \5C\0A        } \5C\0A    } while (0)\0A#else /* !MBEDTLS_PSA_ASSUME_EXCLUSIVE_BUFFERS */\0A#define LOCAL_INPUT_DECLARE(input, input_copy_name) \5C\0A    const uint8_t *input_copy_name = NULL;\0A#define LOCAL_INPUT_ALLOC(input, length, 