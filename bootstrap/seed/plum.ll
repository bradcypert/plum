@.str41936 = private global { i64, i64, [31802 x i8] } { i64 -1, i64 31801, [31802 x i8] c"/**\0A * \5Cfile ecdsa.h\0A *\0A * \5Cbrief This file contains ECDSA definitions and functions.\0A *\0A * The Elliptic Curve Digital Signature Algorithm (ECDSA) is defined in\0A * <em>Standards for Efficient Cryptography Group (SECG):\0A * SEC1 Elliptic Curve Cryptography</em>.\0A * The use of ECDSA for TLS is defined in <em>RFC-4492: Elliptic Curve\0A * Cryptography (ECC) Cipher Suites for Transport Layer Security (TLS)</em>.\0A *\0A */\0A/*\0A *  Copyright The Mbed TLS Contributors\0A *  SPDX-License-Identifier: Apache-2.0 OR GPL-2.0-or-later\0A */\0A\0A#ifndef MBEDTLS_ECDSA_H\0A#define MBEDTLS_ECDSA_H\0A#include \22mbedtls/private_access.h\22\0A\0A#include \22mbedtls/build_info.h\22\0A\0A#include \22mbedtls/ecp.h\22\0A#include \22mbedtls/md.h\22\0A\0A/**\0A * \5Cbrief           Maximum ECDSA signature size for a given curve bit size\0A *\0A * \5Cparam bits      Curve size in bits\0A * \5Creturn          Maximum signature size in bytes\0A *\0A * \5Cnote            This macro returns a compile-time constant if its argument\0A *                  is one. It may evaluate its argument multiple times.\0A */\0A/*\0A *     Ecdsa-Sig-Value ::= SEQUENCE {\0A *         r       INTEGER,\0A *         s       INTEGER\0A *     }\0A *\0A * For each of r and s, the value (V) may include an extra initial \220\22 bit.\0A */\0A#define MBEDTLS_ECDSA_MAX_SIG_LEN(bits)                               \5C\0A    (/*T,L of SEQUENCE*/ ((bits) >= 61 * 8 ? 3 : 2) +              \5C\0A     /*T,L of r,s*/ 2 * (((bits) >= 127 * 8 ? 3 : 2) +     \5C\0A                         /*V of r,s*/ ((bits) + 8) / 8))\0A\0A/** The maximal size of an ECDSA signature in Bytes. */\0A#define MBEDTLS_ECDSA_MAX_LEN  MBEDTLS_ECDSA_MAX_SIG_LEN(MBEDTLS_ECP_MAX_BITS)\0A\0A#ifdef __cplusplus\0Aextern \22C\22 {\0A#endif\0A\0A/**\0A * \5Cbrief           The ECDSA context structure.\0A *\0A * \5Cwarning         Performing multiple operations concurrently on the same\0A *                  ECDSA context is not supported; objects of this type\0A *                  should not be shared between multiple threads.\0A *\0A * \5Cnote            pk_wrap module assumes that \22ecdsa_context\22 is identical\0A *                  to \22ecp_keypair\22 (see for example structure\0A *                  \22mbedtls_eckey_info\22 where ECDSA sign/verify functions\0A *                  are used also for EC key)\0A */\0Atypedef mbedtls_ecp_keypair mbedtls_ecdsa_context;\0A\0A#if defined(MBEDTLS_ECP_RESTARTABLE)\0A\0A/**\0A * \5Cbrief           Internal restart context for ecdsa_verify()\0A *\0A * \5Cnote            Opaque struct, defined in ecdsa.c\0A */\0Atypedef struct mbedtls_ecdsa_restart_ver mbedtls_ecdsa_restart_ver_ctx;\0A\0A/**\0A * \5Cbrief           Internal restart context for ecdsa_sign()\0A *\0A * \5Cnote            Opaque struct, defined in ecdsa.c\0A */\0Atypedef struct mbedtls_ecdsa_restart_sig mbedtls_ecdsa_restart_sig_ctx;\0A\0A#if defined(MBEDTLS_ECDSA_DETERMINISTIC)\0A/**\0A * \5Cbrief           Internal restart context for ecdsa_sign_det()\0A *\0A * \5Cnote            Opaque struct, defined in ecdsa.c\0A */\0Atypedef struct mbedtls_ecdsa_restart_det mbedtls_ecdsa_restart_det_ctx;\0A#endif\0A\0A/**\0A * \5Cbrief           General context for resuming ECDSA operations\0A */\0Atypedef struct {\0A    mbedtls_ecp_restart_ctx MBEDTLS_PRIVATE(ecp);        /*!<  base context for ECP restart and\0A                                                            shared administrative info    */\0A    mbedtls_ecdsa_restart_ver_ctx *MBEDTLS_PRIVATE(ver); /*!<  ecdsa_verify() sub-context    */\0A    mbedtls_ecdsa_restart_sig_ctx *MBEDTLS_PRIVATE(sig); /*!<  ecdsa_sign() sub-context      */\0A#if defined(MBEDTLS_ECDSA_DETERMINISTIC)\0A    mbedtls_ecdsa_restart_det_ctx *MBEDTLS_PRIVATE(det); /*!<  ecdsa_sign_det() sub-context  */\0A#endif\0A} mbedtls_ecdsa_restart_ctx;\0A\0A#else /* MBEDTLS_ECP_RESTARTABLE */\0A\0A/* Now we can declare functions that take a pointer to that */\0Atypedef void mbedtls_ecdsa_restart_ctx;\0A\0A#endif /* MBEDTLS_ECP_RESTARTABLE */\0A\0A/**\0A * \5Cbrief          This function checks whether a given group can be used\0A *                 for ECDSA.\0A *\0A * \5Cparam gid      The ECP group ID to check.\0A *\0A * \5Creturn         \5Cc 1 if the group can be used, \5Cc 0 otherwise\0A */\0Aint mbedtls_ecdsa_can_do(mbedtls_ecp_group_id gid);\0A\0A/**\0A * \5Cbrief           This function computes the ECDSA signature of a\0A *                  previously-hashed message.\0A *\0A * \5Cnote            The deterministic version implemented in\0A *                  mbedtls_ecdsa_sign_det_ext() is usually preferred.\0A *\0A * \5Cnote            If the bitlength of the message hash is larger than the\0A *                  bitlength of the group order, then the hash is truncated\0A *                  as defined in <em>Standards for Efficient Cryptography Group\0A *                  (SECG): SEC1 Elliptic Curve Cryptography</em>, section\0A *                  4.1.3, step 5.\0A *\0A * \5Csee             ecp.h\0A *\0A * \5Cparam grp       The context for the elliptic curve to use.\0A *                  This must be initialized and have group parameters\0A *                  set, for example through mbedtls_ecp_group_load().\0A * \5Cparam r         The MPI context in which to store the first part\0A *                  the signature. This must be initialized.\0A * \5Cparam s         The MPI context in which to store the second part\0A *                  the signature. This must be initialized.\0A * \5Cparam d         The private signing key. This must be initialized.\0A * \5Cparam buf       The content to be signed. This is usually the hash of\0A *                  the original data to be signed. This must be a readable\0A *                  buffer of length \5Cp blen Bytes. It may be \5Cc NULL if\0A *                  \5Cp blen is zero.\0A * \5Cparam blen      The length of \5Cp buf in Bytes.\0A * \5Cparam f_rng     The RNG function. This must not be \5Cc NULL.\0A * \5Cparam p_rng     The RNG context to be passed to \5Cp f_rng. This may be\0A *                  \5Cc NULL if \5Cp f_rng doesn't need a context parameter.\0A *\0A * \5Creturn          \5Cc 0 on success.\0A * \5Creturn          An \5Cc MBEDTLS_ERR_ECP_XXX\0A *                  or \5Cc MBEDTLS_MPI_XXX error code on failure.\0A */\0Aint mbedtls_ecdsa_sign(mbedtls_ecp_group *grp, mbedtls_mpi *r, mbedtls_mpi *s,\0A                       const mbedtls_mpi *d, const unsigned char *buf, size_t blen,\0A                       int (*f_rng)(void *, unsigned char *, size_t), void *p_rng);\0A\0A#if defined(MBEDTLS_ECDSA_DETERMINISTIC)\0A/**\0A * \5Cbrief           This function computes the ECDSA signature of a\0A *                  previously-hashed message, deterministic version.\0A *\0A *                  For more information, see <em>RFC-6979: Deterministic\0A *                  Usage of the Digital Signature Algorithm (DSA) and Elliptic\0A *                  Curve Digital Signature Algorithm (ECDSA)</em>.\0A *\0A * \5Cnote            If the bitlength of the message hash is larger than the\0A *                  bitlength of the group order, then the hash is truncated as\0A *                  defined in <em>Standards for Efficient Cryptography Group\0A *                  (SECG): SEC1 Elliptic Curve Cryptography</em>, section\0A *                  4.1.3, step 5.\0A *\0A * \5Csee             ecp.h\0A *\0A * \5Cparam grp           The context for the elliptic curve to use.\0A *                      This must be initialized and have group parameters\0A *                      set, for example through mbedtls_ecp_group_load().\0A * \5Cparam r             The MPI context in which to store the first part\0A *                      the signature. This must be initialized.\0A * \5Cparam s             The MPI context in which to store the second part\0A *                      the signature. This must be initialized.\0A * \5Cparam d             The private signing key. This must be initialized\0A *                      and setup, for example through mbedtls_ecp_gen_privkey().\0A * \5Cparam buf           The hashed content to be signed. This must be a readable\0A *                      buffer of length \5Cp blen Bytes. It may be \5Cc NULL if\0A *                      \5Cp blen is zero.\0A * \5Cparam blen          The length of \5Cp buf in Bytes.\0A * \5Cparam md_alg        The hash algorithm used to hash the original data.\0A * \5Cparam f_rng_blind   The RNG function used for blinding. This must not be\0A *                      \5Cc NULL.\0A * \5Cparam p_rng_blind   The RNG context to be passed to \5Cp f_rng_blind. This\0A *                      may be \5Cc NULL if \5Cp f_rng_blind doesn't need a context\0A *                      parameter.\0A *\0A * \5Creturn          \5Cc 0 on success.\0A * \5Creturn          An \5Cc MBEDTLS_ERR_ECP_XXX or \5Cc MBEDTLS_MPI_XXX\0A *                  error code on failure.\0A */\0Aint mbedtls_ecdsa_sign_det_ext(mbedtls_ecp_group *grp, mbedtls_mpi *r,\0A                               mbedtls_mpi *s, const mbedtls_mpi *d,\0A                               const unsigned char *buf, size_t blen,\0A                               mbedtls_md_type_t md_alg,\0A                               int (*f_rng_blind)(void *, unsigned char *, size_t),\0A                               void *p_rng_blind);\0A#endif /* MBEDTLS_ECDSA_DETERMINISTIC */\0A\0A#if !defined(MBEDTLS_ECDSA_SIGN_ALT)\0A/**\0A * \5Cbrief               This function computes the ECDSA signature of a\0A *                      previously-hashed message, in a restartable way.\0A *\0A * \5Cnote                The deterministic version implemented in\0A *                      mbedtls_ecdsa_sign_det_restartable() is usually\0A *                      preferred.\0A *\0A * \5Cnote                This function is like \5Cc mbedtls_ecdsa_sign() but\0A *                      it can return early and restart according to the\0A *                      limit set with \5Cc mbedtls_ecp_set_max_ops() to\0A *                      reduce blocking.\0A *\0A * \5Cnote                If the bitlength of the message hash is larger\0A *                      than the bitlength of the group order, then the\0A *                      hash is truncated as defined in <em>Standards for\0A *                      Efficient Cryptography Group (SECG): SEC1 Elliptic\0A *                      Curve Cryptography</em>, section 4.1.3, step 5.\0A *\0A * \5Csee                 ecp.h\0A *\0A * \5Cparam grp           The context for the elliptic curve to use.\0A *                      This must be initialized and have group parameters\0A *                      set, for example through mbedtls_ecp_group_load().\0A * \5Cparam r             The MPI context in which to store the first part\0A *                      the signature. This must be initialized.\0A * \5Cparam s             The MPI context in which to store the second part\0A *                      the signature. This must be initialized.\0A * \5Cparam d             The private signing key. This must be initialized\0A *                      and setup, for example through\0A *                      mbedtls_ecp_gen_privkey().\0A * \5Cparam buf           The hashed content to be signed. This must be a readable\0A *                      buffer of length \5Cp blen Bytes. It may be \5Cc NULL if\0A *                      \5Cp blen is zero.\0A * \5Cparam blen          The length of \5Cp buf in Bytes.\0A * \5Cparam f_rng         The RNG function. This must not be \5Cc NULL.\0A * \5Cparam p_rng         The RNG context to be passed to \5Cp f_rng. This may be\0A *                      \5Cc NULL if \5Cp f_rng doesn't need a context parameter.\0A * \5Cparam f_rng_blind   The RNG function used for blinding. This must not be\0A *                      \5Cc NULL.\0A * \5Cparam p_rng_blind   The RNG context to be passed to \5Cp f_rng. This may be\0A *                      \5Cc NULL if \5Cp f_rng doesn't need a context parameter.\0A * \5Cparam rs_ctx        The restart context to use. This may be \5Cc NULL\0A *                      to disable restarting. If it is not \5Cc NULL, it\0A *                      must point to an initialized restart context.\0A *\0A * \5Creturn              \5Cc 0 on success.\0A * \5Creturn              #MBEDTLS_ERR_ECP_IN_PROGRESS if maximum number of\0A *                      operations was reached: see \5Cc\0A *                      mbedtls_ecp_set_max_ops().\0A * \5Creturn              Another \5Cc MBEDTLS_ERR_ECP_XXX, \5Cc\0A *                      MBEDTLS_ERR_MPI_XXX or \5Cc MBEDTLS_ERR_ASN1_XXX\0A *                      error code on failure.\0A */\0Aint mbedtls_ecdsa_sign_restartable(\0A    mbedtls_ecp_group *grp,\0A    mbedtls_mpi *r, mbedtls_mpi *s,\0A    const mbedtls_mpi *d,\0A    const unsigned char *buf, size_t blen,\0A    int (*f_rng)(void *, unsigned char *, size_t),\0A    void *p_rng,\0A    int (*f_rng_blind)(void *, unsigned char *, size_t),\0A    void *p_rng_blind,\0A    mbedtls_ecdsa_restart_ctx *rs_ctx);\0A\0A#endif /* !MBEDTLS_ECDSA_SIGN_ALT */\0A\0A#if defined(MBEDTLS_ECDSA_DETERMINISTIC)\0A\0A/**\0A * \5Cbrief               This function computes the ECDSA signature of a\0A *                      previously-hashed message, in a restartable way.\0A *\0A * \5Cnote                This function is like \5Cc\0A *                      mbedtls_ecdsa_sign_det_ext() but it can return\0A *                      early and restart according to the limit set with\0A *                      \5Cc mbedtls_ecp_set_max_ops() to reduce blocking.\0A *\0A * \5Cnote                If the bitlength of the message hash is larger\0A *                      than the bitlength of the group order, then the\0A *                      hash is truncated as defined in <em>Standards for\0A *                      Efficient Cryptography Group (SECG): SEC1 Elliptic\0A *                      Curve Cryptography</em>, section 4.1.3, step 5.\0A *\0A * \5Csee                 ecp.h\0A *\0A * \5Cparam grp           The context for the elliptic curve to use.\0A *                      This must be initialized and have group parameters\0A *                      set, for example through mbedtls_ecp_group_load().\0A * \5Cparam r             The MPI context in which to store the first part\0A *                      the signature. This must be initialized.\0A * \5Cparam s             The MPI context in which to store the second part\0A *                      the signature. This must be initialized.\0A * \5Cparam d             The private signing key. This must be initialized\0A *                      and setup, for example through\0A *                      mbedtls_ecp_gen_privkey().\0A * \5Cparam buf           The hashed content to be signed. This must be a readable\0A *                      buffer of length \5Cp blen Bytes. It may be \5Cc NULL if\0A *                      \5Cp blen is zero.\0A * \5Cparam blen          The length of \5Cp buf in Bytes.\0A * \5Cparam md_alg        The hash algorithm used to hash the original data.\0A * \5Cparam f_rng_blind   The RNG function used for blinding. This must not be\0A *                      \5Cc NULL.\0A * \5Cparam p_rng_blind   The RNG context to be passed to \5Cp f_rng_blind. This may be\0A *                      \5Cc NULL if \5Cp f_rng_blind doesn't need a context parameter.\0A * \5Cparam rs_ctx        The restart context to use. This may be \5Cc NULL\0A *                      to disable restarting. If it is not \5Cc NULL, it\0A *                      must point to an initialized restart context.\0A *\0A * \5Creturn              \5Cc 0 on success.\0A * \5Creturn              #MBEDTLS_ERR_ECP_IN_PROGRESS if maximum number of\0A *                      operations was reached: see \5Cc\0A *                      mbedtls_ecp_set_max_ops().\0A * \5Creturn              Another \5Cc MBEDTLS_ERR_ECP_XXX, \5Cc\0A *                      MBEDTLS_ERR_MPI_XXX or \5Cc MBEDTLS_ERR_ASN1_XXX\0A *                      error code on failure.\0A */\0Aint mbedtls_ecdsa_sign_det_restartable(\0A    mbedtls_ecp_group *grp,\0A    mbedtls_mpi *r, mbedtls_mpi *s,\0A    const mbedtls_mpi *d, const unsigned char *buf, size_t blen,\0A    mbedtls_md_type_t md_alg,\0A    int (*f_rng_blind)(void *, unsigned char *, size_t),\0A    void *p_rng_blind,\0A    mbedtls_ecdsa_restart_ctx *rs_ctx);\0A\0A#endif /* MBEDTLS_ECDSA_DETERMINISTIC */\0A\0A/**\0A * \5Cbrief           This function verifies the ECDSA signature of a\0A *                  previously-hashed message.\0A *\0A * \5Cnote            If the bitlength of the message hash is larger than the\0A *                  bitlength of the group order, then the hash is truncated as\0A *                  defined in <em>Standards for Efficient Cryptography Group\0A *                  (SECG): SEC1 Elliptic Curve Cryptography</em>, section\0A *                  4.1.4, step 3.\0A *\0A * \5Csee             ecp.h\0A *\0A * \5Cparam grp       The ECP group to use.\0A *                  This must be initialized and have group parameters\0A *                  set, for example through mbedtls_ecp_group_load().\0A * \5Cparam buf       The hashed content that was signed. This must be a readable\0A *                  buffer of length \5Cp blen Bytes. It may be \5Cc NULL if\0A *                  \5Cp blen is zero.\0A * \5Cparam blen      The length of \5Cp buf in Bytes.\0A * \5Cparam Q         The public key to use for verification. This must be\0A *                  initialized and setup.\0A * \5Cparam r         The first integer of the signature.\0A *                  This must be initialized.\0A * \5Cparam s         The second integer of the signature.\0A *                  This must be initialized.\0A *\0A * \5Creturn          \5Cc 0 on success.\0A * \5Creturn          An \5Cc MBEDTLS_ERR_ECP_XXX or \5Cc MBEDTLS_MPI_XXX\0A *                  error code on failure.\0A */\0Aint mbedtls_ecdsa_verify(mbedtls_ecp_group *grp,\0A                         const unsigned char *buf, size_t blen,\0A                         const mbedtls_ecp_point *Q, const mbedtls_mpi *r,\0A                         const mbedtls_mpi *s);\0A\0A#if !defined(MBEDTLS_ECDSA_VERIFY_ALT)\0A/**\0A * \5Cbrief           This function verifies the ECDSA signature of a\0A *                  previously-hashed message, in a restartable manner\0A *\0A * \5Cnote            If the bitlength of the message hash is larger than the\0A *                  bitlength of the group order, then the hash is truncated as\0A *                  defined in <em>Standards for Efficient Cryptography Group\0A *                  (SECG): SEC1 Elliptic Curve Cryptography</em>, section\0A *                  4.1.4, step 3.\0A *\0A * \5Csee             ecp.h\0A *\0A * \5Cparam grp       The ECP group to use.\0A *                  This must be initialized and have group parameters\0A *                  set, for example through mbedtls_ecp_group_load().\0A * \5Cparam buf       The hashed content that was signed. This must be a readable\0A *                  buffer of length \5Cp blen Bytes. It may be \5Cc NULL if\0A *                  \5Cp blen is zero.\0A * \5Cparam blen      The length of \5Cp buf in Bytes.\0A * \5Cparam Q         The public key to use for verification. This must be\0A *                  initialized and setup.\0A * \5Cparam r         The first integer of the signature.\0A *                  This must be initialized.\0A * \5Cparam s         The second integer of the signature.\0A *                  This must be initialized.\0A * \5Cparam rs_ctx    The restart context to use. This may be \5Cc NULL to disable\0A *                  restarting. If it is not \5Cc NULL, it must point to an\0A *                  initialized restart context.\0A *\0A * \5Creturn          \5Cc 0 on success.\0A * \5Creturn          #MBEDTLS_ERR_ECP_IN_PROGRESS if maximum number of\0A *                  operations was reached: see \5Cc mbedtls_ecp_set_max_ops().\0A * \5Creturn          An \5Cc MBEDTLS_ERR_ECP_XXX or \5Cc MBEDTLS_MPI_XXX\0A *                  error code on failure.\0A */\0Aint mbedtls_ecdsa_verify_restartable(mbedtls_ecp_group *grp,\0A                                     const unsigned char *buf, size_t blen,\0A                                     const mbedtls_ecp_point *Q,\0A                                     const mbedtls_mpi *r,\0A                                     const mbedtls_mpi *s,\0A                                     mbedtls_ecdsa_restart_ctx *rs_ctx);\0A\0A#endif /* !MBEDTLS_ECDSA_VERIFY_ALT */\0A\0A/**\0A * \5Cbrief           This function computes the ECDSA signature and writes it\0A *                  to a buffer, serialized as defined in <em>RFC-4492:\0A *                  Elliptic Curve Cryptography (ECC) Cipher Suites for\0A *                  Transport Layer Security (TLS)</em>.\0A *\0A * \5Cwarning         It is not thread-safe to use the same context in\0A *                  multiple threads.\0A *\0A * \5Cnote            The deterministic version is used if\0A *                  #MBEDTLS_ECDSA_DETERMINISTIC is defined. For more\0A *                  information, see <em>RFC-6979: Deterministic Usage\0A *                  of the Digital Signature Algorithm (DSA) and Elliptic\0A *                  Curve Digital Signature Algorithm (ECDSA)</em>.\0A *\0A * \5Cnote            If the bitlength of the message hash is larger than the\0A *                  bitlength of the group order, then the hash is truncated as\0A *                  defined in <em>Standards for Efficient Cryptography Group\0A *                  (SECG): SEC1 Elliptic Curve Cryptography</em>, section\0A *                  4.1.3, step 5.\0A *\0A * \5Csee             ecp.h\0A *\0A * \5Cparam ctx       The ECDSA context to use. This must be initialized\0A *                  and have a group and private key bound to it, for example\0A *                  via mbedtls_ecdsa_genkey() or mbedtls_ecdsa_from_keypair().\0A * \5Cparam md_alg    The message digest that was used to hash the message.\0A * \5Cparam hash      The message hash to be signed. This must be a readable\0A *                  buffer of length \5Cp hlen Bytes.\0A * \5Cparam hlen      The length of the hash \5Cp hash in Bytes.\0A * \5Cparam sig       The buffer to which to write the signature. This must be a\0A *                  writable buffer of length at least twice as large as the\0A *                  size of the curve used, plus 9. For example, 73 Bytes if\0A *                  a 256-bit curve is used. A buffer length of\0A *                  #MBEDTLS_ECDSA_MAX_LEN is always safe.\0A * \5Cparam sig_size  The size of the \5Cp sig buffer in bytes.\0A * \5Cparam slen      The address at which to store the actual length of\0A *                  the signature written. Must not be \5Cc NULL.\0A * \5Cparam f_rng     The RNG function. This must not be \5Cc NULL if\0A *                  #MBEDTLS_ECDSA_DETERMINISTIC is unset. Otherwise,\0A *                  it is used only for blinding and may be set to \5Cc NULL, but\0A *                  doing so is DEPRECATED.\0A * \5Cparam p_rng     The RNG context to be passed to \5Cp f_rng. This may be\0A *                  \5Cc NULL if \5Cp f_rng is \5Cc NULL or doesn't use a context.\0A *\0A * \5Creturn          \5Cc 0 on success.\0A * \5Creturn          An \5Cc MBEDTLS_ERR_ECP_XXX, \5Cc MBEDTLS_ERR_MPI_XXX or\0A *                  \5Cc MBEDTLS_ERR_ASN1_XXX error code on failure.\0A */\0Aint mbedtls_ecdsa_write_signature(mbedtls_ecdsa_context *ctx,\0A                                  mbedtls_md_type_t md_alg,\0A                                  const unsigned char *hash, size_t hlen,\0A                                  unsigned char *sig, size_t sig_size, size_t *slen,\0A                                  int (*f_rng)(void *, unsigned char *, size_t),\0A                                  void *p_rng);\0A\0A/**\0A * \5Cbrief           This function computes the ECDSA signature and writes it\0A *                  to a buffer, in a restartable way.\0A *\0A * \5Csee             \5Cc mbedtls_ecdsa_write_signature()\0A *\0A * \5Cnote            This function is like \5Cc mbedtls_ecdsa_write_signature()\0A *                  but it can return early and restart according to the limit\0A *                  set with \5Cc mbedtls_ecp_set_max_ops() to reduce blocking.\0A *\0A * \5Cparam ctx       The ECDSA context to use. This must be initialized\0A *                  and have a group and private key bound to it, for example\0A *                  via mbedtls_ecdsa_genkey() or mbedtls_ecdsa_from_keypair().\0A * \5Cparam md_alg    The message digest that was used to hash the message.\0A * \5Cparam hash      The message hash to be signed. This must be a readable\0A *                  buffer of length \5Cp hlen Bytes.\0A * \5Cparam hlen      The length of the hash \5Cp hash in Bytes.\0A * \5Cparam sig       The buffer to which to write the signature. This must be a\0A *                  writable buffer of length at least twice as large as the\0A *                  size of the curve used, plus 9. For example, 73 Bytes if\0A *                  a 256-bit curve is used. A buffer length of\0A *                  #MBEDTLS_ECDSA_MAX_LEN is always safe.\0A * \5Cparam sig_size  The size of the \5Cp sig buffer in bytes.\0A * \5Cparam slen      The address at which to store the actual length of\0A *                  the signature written. Must not be \5Cc NULL.\0A * \5Cparam f_rng     The RNG function. This must not be \5Cc NULL if\0A *                  #MBEDTLS_ECDSA_DETERMINISTIC is unset. Otherwise,\0A *                  it is unused and may be set to \5Cc NULL.\0A * \5Cparam p_rng     The RNG context to be passed to \5Cp f_rng. This may be\0A *                  \5Cc NULL if \5Cp f_rng is \5Cc NULL or doesn't use a context.\0A * \5Cparam rs_ctx    The restart context to use. This may be \5Cc NULL to disable\0A *                  restarting. If it is not \5Cc NULL, it must point to an\0A *                  initialized restart context.\0A *\0A * \5Creturn          \5Cc 0 on success.\0A * \5Creturn          #MBEDTLS_ERR_ECP_IN_PROGRESS if maximum number of\0A *                  operations was reached: see \5Cc mbedtls_ecp_set_max_ops().\0A * \5Creturn          Another \5Cc MBEDTLS_ERR_ECP_XXX, \5Cc MBEDTLS_ERR_MPI_XXX or\0A *                  \5Cc MBEDTLS_ERR_ASN1_XXX error code on failure.\0A */\0Aint mbedtls_ecdsa_write_signature_restartable(mbedtls_ecdsa_context *ctx,\0A                                              mbedtls_md_type_t md_alg,\0A                                              const unsigned char *hash, size_t hlen,\0A                                              unsigned char *sig, size_t sig_size, size_t *slen,\0A                                              int (*f_rng)(void *, unsigned char *, size_t),\0A                                              void *p_rng,\0A                                              mbedtls_ecdsa_restart_ctx *rs_ctx);\0A\0A/**\0A * \5Cbrief           This function reads and verifies an ECDSA signature.\0A *\0A * \5Cnote            If the bitlength of the message hash is larger than the\0A *                  bitlength of the group order, then the hash is truncated as\0A *                  defined in <em>Standards for Efficient Cryptography Group\0A *                  (SECG): SEC1 Elliptic Curve Cryptography</em>, section\0A *                  4.1.4, step 3.\0A *\0A * \5Csee             ecp.h\0A *\0A * \5Cparam ctx       The ECDSA context to use. This must be initialized\0A *                  and have a group and public key bound to it.\0A * \5Cparam hash      The message hash that was signed. This must be a readable\0A *                  buffer of length \5Cp hlen Bytes.\0A * \5Cparam hlen      The size of the hash \5Cp hash.\0A * \5Cparam sig       The signature to read and verify. This must be a readable\0A *                  buffer of length \5Cp slen Bytes.\0A * \5Cparam slen      The size of \5Cp sig in Bytes.\0A *\0A * \5Creturn          \5Cc 0 on success.\0A * \5Creturn          #MBEDTLS_ERR_ECP_BAD_INPUT_DATA if signature is invalid.\0A * \5Creturn          #MBEDTLS_ERR_ECP_SIG_LEN_MISMATCH if there is a valid\0A *                  signature in \5Cp sig, but its length is less than \5Cp siglen.\0A * \5Creturn          An \5Cc MBEDTLS_ERR_ECP_XXX or \5Cc MBEDTLS_ERR_MPI_XXX\0A *                  error code on failure for any other reason.\0A */\0Aint mbedtls_ecdsa_read_signature(mbedtls_ecdsa_context *ctx,\0A                                 const unsigned char *hash, size_t hlen,\0A                                 const unsigned char *sig, size_t slen);\0A\0A/**\0A * \5Cbrief           This function reads and verifies an ECDSA signature,\0A *                  in a restartable way.\0A *\0A * \5Csee             \5Cc mbedtls_ecdsa_read_signature()\0A *\0A * \5Cnote            This function is like \5Cc mbedtls_ecdsa_read_signature()\0A *                  but it can return early and restart according to the limit\0A *                  set with \5Cc mbedtls_ecp_set_max_ops() to reduce blocking.\0A *\0A * \5Cparam ctx       The ECDSA context to use. This must be initialized\0A *                  and have a group and public key bound to it.\0A * \5Cparam hash      The message hash that was signed. This must be a readable\0A *                  buffer of length \5Cp hlen Bytes.\0A * \5Cparam hlen      The size of the hash \5Cp hash.\0A * \5Cparam sig       The signature to read and verify. This must be a readable\0A *                  buffer of length \5Cp slen Bytes.\0A * \5Cparam slen      The size of \5Cp sig in Bytes.\0A * \5Cparam rs_ctx    The restart context to use. This may be \5Cc NULL to disable\0A *                  restarting. If it is not \5Cc NULL, it must point to an\0A *                  initialized restart context.\0A *\0A * \5Creturn          \5Cc 0 on success.\0A * \5Creturn          #MBEDTLS_ERR_ECP_BAD_INPUT_DATA if signature is invalid.\0A * \5Creturn          #MBEDTLS_ERR_ECP_SIG_LEN_MISMATCH if there is a valid\0A *                  signature in \5Cp sig, but its length is less than \5Cp siglen.\0A * \5Creturn          #MBEDTLS_ERR_ECP_IN_PROGRESS if maximum number of\0A *                  operations was reached: see \5Cc mbedtls_ecp_set_max_ops().\0A * \5Creturn          Another \5Cc MBEDTLS_ERR_ECP_XXX or \5Cc MBEDTLS_ERR_MPI_XXX\0A *                  error code on failure for any other reason.\0A */\0Aint mbedtls_ecdsa_read_signature_restartable(mbedtls_ecdsa_context *ctx,\0A                                             const unsigned char *hash, size_t hlen,\0A                                             const unsigned char *sig, size_t slen,\0A                                             mbedtls_ecdsa_restart_ctx *rs_ctx);\0A\0A/**\0A * \5Cbrief          This function generates an ECDSA keypair on the given curve.\0A *\0A * \5Csee            ecp.h\0A *\0A * \5Cparam ctx      The ECDSA context to store the keypair in.\0A *                 This must be initialized.\0A * \5Cparam gid      The elliptic curve to use. One of the various\0A *                 \5Cc MBEDTLS_ECP_DP_XXX macros depending on configuration.\0A * \5Cparam f_rng    The RNG function to use. This must not be \5Cc NULL.\0A * \5Cparam p_rng    The RNG context to be passed to \5Cp f_rng. This may be\0A *                 \5Cc NULL if \5Cp f_rng doesn't need a context argument.\0A *\0A * \5Creturn         \5Cc 0 on success.\0A * \5Creturn         An \5Cc MBEDTLS_ERR_ECP_XXX code on failure.\0A */\0Aint mbedtls_ecdsa_genkey(mbedtls_ecdsa_context *ctx, mbedtls_ecp_group_id gid,\0A                         int (*f_rng)(void *, unsigned char *, size_t), void *p_rng);\0A\0A/**\0A * \5Cbrief           This function sets up an ECDSA context from an EC key pair.\0A *\0A * \5Csee             ecp.h\0A *\0A * \5Cparam ctx       The ECDSA context to setup. This must be initialized.\0A * \5Cparam key       The EC key to use. This must be initialized and hold\0A *                  a private-public key pair or a public key. In the former\0A *                  case, the ECDSA context may be used for signature creation\0A *                  and verification after this call. In the latter case, it\0A *                  may be used for signature verification.\0A *\0A * \5Creturn          \5Cc 0 on success.\0A * \5Creturn          An \5Cc MBEDTLS_ERR_ECP_XXX code on failure.\0A */\0Aint mbedtls_ecdsa_from_keypair(mbedtls_ecdsa_context *ctx,\0A                               const mbedtls_ecp_keypair *key);\0A\0A/**\0A * \5Cbrief           This function initializes an ECDSA context.\0A *\0A * \5Cparam ctx       The ECDSA context to initialize.\0A *                  This must not be \5Cc NULL.\0A */\0Avoid mbedtls_ecdsa_init(mbedtls_ecdsa_context *ctx);\0A\0A/**\0A * \5Cbrief           This function frees an ECDSA context.\0A *\0A * \5Cparam ctx       The ECDSA context to free. This may be \5Cc NULL,\0A *                  in which case this function does nothing. If it\0A *                  is not \5Cc NULL, it must be initialized.\0A */\0Avoid mbedtls_ecdsa_free(mbedtls_ecdsa_context *ctx);\0A\0A#if defined(MBEDTLS_ECP_RESTARTABLE)\0A/**\0A * \5Cbrief           Initialize a restart context.\0A *\0A * \5Cparam ctx       The restart context to initialize.\0A *                  This must not be \5Cc NULL.\0A */\0Avoid mbedtls_ecdsa_restart_init(mbedtls_ecdsa_restart_ctx *ctx);\0A\0A/**\0A * \5Cbrief           Free the components of a restart context.\0A *\0A * \5Cparam ctx       The restart context to free. This may be \5Cc NULL,\0A *                  in which case this function does nothing. If it\0A *                  is not \5Cc NULL, it must be initialized.\0A */\0Avoid mbedtls_ecdsa_restart_free(mbedtls_ecdsa_restart_ctx *ctx);\0A#endif /* MBEDTLS_ECP_RESTARTABLE */\0A\0A#ifdef __cplusplus\0A}\0A#endif\0A\0A#endif /* ecdsa.h */\0A\00" }
