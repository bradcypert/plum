@.str41812 = private global { i64, i64, [1771 x i8] } { i64 -1, i64 1770, [1771 x i8] c"/**\0A * \5Cfile psa_crypto_core_common.h\0A *\0A * \5Cbrief Utility macros for internal use in the PSA cryptography core.\0A */\0A/*\0A *  Copyright The Mbed TLS Contributors\0A *  SPDX-License-Identifier: Apache-2.0 OR GPL-2.0-or-later\0A */\0A\0A#ifndef PSA_CRYPTO_CORE_COMMON_H\0A#define PSA_CRYPTO_CORE_COMMON_H\0A\0A/** Return an offset into a buffer.\0A *\0A * This is just the addition of an offset to a pointer, except that this\0A * function also accepts an offset of 0 into a buffer whose pointer is null.\0A * (`p + n` has undefined behavior when `p` is null, even when `n == 0`.\0A * A null pointer is a valid buffer pointer when the size is 0, for example\0A * as the result of `malloc(0)` on some platforms.)\0A *\0A * \5Cparam p     Pointer to a buffer of at least n bytes.\0A *              This may be \5Cp NULL if \5Cp n is zero.\0A * \5Cparam n     An offset in bytes.\0A * \5Creturn      Pointer to offset \5Cp n in the buffer \5Cp p.\0A *              Note that this is only a valid pointer if the size of the\0A *              buffer is at least \5Cp n + 1.\0A */\0Astatic inline unsigned char *psa_crypto_buffer_offset(\0A    unsigned char *p, size_t n)\0A{\0A    return p == NULL ? NULL : p + n;\0A}\0A\0A/** Return an offset into a read-only buffer.\0A *\0A * Similar to mbedtls_buffer_offset(), but for const pointers.\0A *\0A * \5Cparam p     Pointer to a buffer of at least n bytes.\0A *              This may be \5Cp NULL if \5Cp n is zero.\0A * \5Cparam n     An offset in bytes.\0A * \5Creturn      Pointer to offset \5Cp n in the buffer \5Cp p.\0A *              Note that this is only a valid pointer if the size of the\0A *              buffer is at least \5Cp n + 1.\0A */\0Astatic inline const unsigned char *psa_crypto_buffer_offset_const(\0A    const unsigned char *p, size_t n)\0A{\0A    return p == NULL ? NULL : p + n;\0A}\0A\0A#endif /* PSA_CRYPTO_CORE_COMMON_H */\0A\00" }
