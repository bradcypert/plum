@.str41155 = private global { i64, i64, [24399 x i8] } { i64 -1, i64 24398, [24399 x i8] c"/**\0A * \5Cfile ssl_ciphersuites.h\0A *\0A * \5Cbrief SSL Ciphersuites for Mbed TLS\0A */\0A/*\0A *  Copyright The Mbed TLS Contributors\0A *  SPDX-License-Identifier: Apache-2.0 OR GPL-2.0-or-later\0A */\0A#ifndef MBEDTLS_SSL_CIPHERSUITES_H\0A#define MBEDTLS_SSL_CIPHERSUITES_H\0A#include \22mbedtls/private_access.h\22\0A\0A#include \22mbedtls/build_info.h\22\0A\0A#include \22mbedtls/pk.h\22\0A#include \22mbedtls/cipher.h\22\0A#include \22mbedtls/md.h\22\0A\0A#ifdef __cplusplus\0Aextern \22C\22 {\0A#endif\0A\0A/*\0A * Supported ciphersuites (Official IANA names)\0A */\0A#define MBEDTLS_TLS_RSA_WITH_NULL_MD5                    0x01   /**< Weak! */\0A#define MBEDTLS_TLS_RSA_WITH_NULL_SHA                    0x02   /**< Weak! */\0A\0A#define MBEDTLS_TLS_PSK_WITH_NULL_SHA                    0x2C   /**< Weak! */\0A#define MBEDTLS_TLS_DHE_PSK_WITH_NULL_SHA                0x2D   /**< Weak! */\0A#define MBEDTLS_TLS_RSA_PSK_WITH_NULL_SHA                0x2E   /**< Weak! */\0A#define MBEDTLS_TLS_RSA_WITH_AES_128_CBC_SHA             0x2F\0A\0A#define MBEDTLS_TLS_DHE_RSA_WITH_AES_128_CBC_SHA         0x33\0A#define MBEDTLS_TLS_RSA_WITH_AES_256_CBC_SHA             0x35\0A#define MBEDTLS_TLS_DHE_RSA_WITH_AES_256_CBC_SHA         0x39\0A\0A#define MBEDTLS_TLS_RSA_WITH_NULL_SHA256                 0x3B   /**< Weak! */\0A#define MBEDTLS_TLS_RSA_WITH_AES_128_CBC_SHA256          0x3C   /**< TLS 1.2 */\0A#define MBEDTLS_TLS_RSA_WITH_AES_256_CBC_SHA256          0x3D   /**< TLS 1.2 */\0A\0A#define MBEDTLS_TLS_RSA_WITH_CAMELLIA_128_CBC_SHA        0x41\0A#define MBEDTLS_TLS_DHE_RSA_WITH_CAMELLIA_128_CBC_SHA    0x45\0A\0A#define MBEDTLS_TLS_DHE_RSA_WITH_AES_128_CBC_SHA256      0x67   /**< TLS 1.2 */\0A#define MBEDTLS_TLS_DHE_RSA_WITH_AES_256_CBC_SHA256      0x6B   /**< TLS 1.2 */\0A\0A#define MBEDTLS_TLS_RSA_WITH_CAMELLIA_256_CBC_SHA        0x84\0A#define MBEDTLS_TLS_DHE_RSA_WITH_CAMELLIA_256_CBC_SHA    