and modulo, which is NOT what `/` and `%` do: those\0A/// truncate toward zero, so `-1 / 86400` is `0` and the day before the\0A/// epoch would land in 1970. Every calendar function below needs the\0A/// floor, and dates before 1970 are real dates.\0Alet plum__floor_div (a: Int) (b: Int): Int = {\0A    let q = a / b;\0A    if a - q * b != 0 && (a < 0) != (b < 0) { q - 1 } else { q }\0A}\0A\0Alet plum__floor_mod (a: Int) (b: Int): Int = a - plum__floor_div(a, b) * b\0A\0A/// A civil date and time, as UTC. `weekday` is 0 for Sunday.\0Apub struct DateTime {\0A    pub year: Int, pub month: Int, pub day: Int,\0A    pub hour: Int, pub minute: Int, pub second: Int,\0A    pub weekday: Int,\0A}\0A\0A/// Howard Hinnant's `civil_from_days`: exact for every date in the\0A/// proleptic Gregorian calendar, with no lookup table and no leap-year\0A/// special case. It shifts the year to start in March so the leap day\0A/// falls at the END of the cycle, which is what removes the special\0A/// case rather than hiding it.\0A///\0A/// The inner divisions all operate on non-negative values, so plain `/`\0A/// is right there; only `era` can go negative and it uses the floor.\0Apub let utc (epoch: Int): DateTime = {\0A    let days = plum__floor_div(epoch, 86400);\0A    let secs = plum__floor_mod(epoch, 86400);\0A    let z = days + 719468;\0A    let era = plum__floor_div(z, 146097);\0A    let doe = z - era * 146097;\0A    let yoe = (doe - doe / 1460 + doe / 36524 - doe / 146096) / 365;\0A    let doy = doe - (365 * yoe + yoe / 4 - yoe / 100);\0A    let mp = (5 * doy + 2) / 153;\0A    let d = doy - (153 * mp + 2) / 5 + 1;\0A    let m = if mp < 10 { mp + 3 } else { mp - 9 };\0A    DateTime {\0A        year: yoe + era * 400 + (if m <= 2 { 1 } else { 0 }),\0A        month: m,\0A        day: d,\0A        hour: secs / 3600,\0A        minute: secs / 60 - secs / 3600 * 60,\0A        second: secs - secs / 60 * 60,\0A        // 1970-01-01 was a Thursday, which is index 4.\0A        weekday: plum__fl