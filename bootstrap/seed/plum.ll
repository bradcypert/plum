@.str39715 = private global { i64, i64, [26 x i8] } { i64 -1, i64 25, [26 x i8] c"mbedtls/library/entropy.c\00" }
@.str39717 = private global { i64, i64, [18138 x i8] } { i64 -1, i64 18137, [18138 x i8] c"/*\0A *  Entropy accumulator implementation\0A *\0A *  Copyright The Mbed TLS Contributors\0A *  SPDX-License-Identifier: Apache-2.0 OR GPL-2.0-or-later\0A */\0A\0A#include \22common.h\22\0A\0A#if defined(MBEDTLS_ENTROPY_C)\0A\0A#include \22mbedtls/entropy.h\22\0A#include \22entropy_poll.h\22\0A#include \22mbedtls/platform_util.h\22\0A#include \22mbedtls/error.h\22\0A\0A#include <string.h>\0A\0A#if defined(MBEDTLS_FS_IO)\0A#include <stdio.h>\0A#endif\0A\0A#include \22mbedtls/platform.h\22\0A\0A#define ENTROPY_MAX_LOOP    256     /**< Maximum amount to loop before error */\0A\0Avoid mbedtls_entropy_init(mbedtls_entropy_context *ctx)\0A{\0A    ctx->source_count = 0;\0A    memset(ctx->source, 0, sizeof(ctx->source));\0A\0A#if defined(MBEDTLS_THREADING_C)\0A    mbedtls_mutex_init(&ctx->mutex);\0A#endif\0A\0A    ctx->accumulator_started = 0;\0A    mbedtls_md_init(&ctx->accumulator);\0A\0A    /* Reminder: Update ENTROPY_HAVE_STRONG in the test files\0A     *           when adding more strong entropy sources here. */\0A\0A#if !defined(MBEDTLS_NO_DEFAULT_ENTROPY_SOURCES)\0A#if !defined(MBEDTLS_NO_PLATFORM_ENTROPY)\0A    mbedtls_entropy_add_source(ctx, mbedtls_platform_entropy_poll, NULL,\0A                               MBEDTLS_ENTROPY_MIN_PLATFORM,\0A                               MBEDTLS_ENTROPY_SOURCE_STRONG);\0A#endif\0A#if defined(MBEDTLS_ENTROPY_HARDWARE_ALT)\0A    mbedtls_entropy_add_source(ctx, mbedtls_hardware_poll, NULL,\0A                               MBEDTLS_ENTROPY_MIN_HARDWARE,\0A                               MBEDTLS_ENTROPY_SOURCE_STRONG);\0A#endif\0A#if defined(MBEDTLS_ENTROPY_NV_SEED)\0A    mbedtls_entropy_add_source(ctx, mbedtls_nv_seed_poll, NULL,\0A                               MBEDTLS_ENTROPY_BLOCK_SIZE,\0A                               MBEDTLS_ENTROPY_SOURCE_STRONG);\0A    ctx->initial_entropy_run = 0;\0A#endif\0A#endif /* MBEDTLS_NO_DEFAULT_ENTROPY_SOURCES */\0A}\0A\0Avoid mbedtls_entropy_free(mbedtls_entropy_context *ctx)\0A{\0A    if (ctx == NULL) {\0A        return;\0A    }\0A\0A    /* If the context was already free, don't call free() again.\0A     * This is important for mutexes which don't allow double-free. */\0A    if (ctx->accumulator_started == -1) {\0A        return;\0A    }\0A\0A#if defined(MBEDTLS_THREADING_C)\0A    mbedtls_mutex_free(&ctx->mutex);\0A#endif\0A    mbedtls_md_free(&ctx->accumulator);\0A#if defined(MBEDTLS_ENTROPY_NV_SEED)\0A    ctx->initial_entropy_run = 0;\0A#endif\0A    ctx->source_count = 0;\0A    mbedtls_platform_zeroize(ctx->source, sizeof(ctx->source));\0A    ctx->accumulator_started = -1;\0A}\0A\0Aint mbedtls_entropy_add_source(mbedtls_entropy_context *ctx,\0A                               mbedtls_entropy_f_source_ptr f_source, void *p_source,\0A                               size_t threshold, int strong)\0A{\0A    int idx, ret = 0;\0A\0A#if defined(MBEDTLS_THREADING_C)\0A    if ((ret = mbedtls_mutex_lock(&ctx->mutex)) != 0) {\0A        return ret;\0A    }\0A#endif\0A\0A    idx = ctx->source_count;\0A    if (idx >= MBEDTLS_ENTROPY_MAX_SOURCES) {\0A        ret = MBEDTLS_ERR_ENTROPY_MAX_SOURCES;\0A        goto exit;\0A    }\0A\0A    ctx->source[idx].f_source  = f_source;\0A    ctx->source[idx].p_source  = p_source;\0A    ctx->source[idx].threshold = threshold;\0A    ctx->source[idx].strong    = strong;\0A\0A    ctx->source_count++;\0A\0Aexit:\0A#if defined(MBEDTLS_THREADING_C)\0A    if (mbedtls_mutex_unlock(&ctx->mutex) != 0) {\0A        return MBEDTLS_ERR_THREADING_MUTEX_ERROR;\0A    }\0A#endif\0A\0A    return ret;\0A}\0A\0A/*\0A * Entropy accumulator update\0A */\0Astatic int entropy_update(mbedtls_entropy_context *ctx, unsigned char source_id,\0A                          const unsigned char *data, size_t len)\0A{\0A    unsigned char header[2];\0A    unsigned char tmp[MBEDTLS_ENTROPY_BLOCK_SIZE];\0A    size_t use_len = len;\0A    const unsigned char *p = data;\0A    int ret = 0;\0A\0A    if (use_len > MBEDTLS_ENTROPY_BLOCK_SIZE) {\0A        if ((ret = mbedtls_md(mbedtls_md_info_from_type(MBEDTLS_ENTROPY_MD),\0A                              data, len, tmp)) != 0) {\0A            goto cleanup;\0A        }\0A        p = tmp;\0A        use_len = MBEDTLS_ENTROPY_BLOCK_SIZE;\0A    }\0A\0A    header[0] = source_id;\0A    header[1] = use_len & 0xFF;\0A\0A    /*\0A     * Start the accumulator if this has not already happened. Note that\0A     * it is sufficient to start the accumulator here only because all calls to\0A     * gather entropy eventually execute this code.\0A     */\0A    if (ctx->accumulator_started == 0) {\0A        ret = mbedtls_md_setup(&ctx->accumulator,\0A                               mbedtls_md_info_from_type(MBEDTLS_ENTROPY_MD), 0);\0A        if (ret != 0) {\0A            goto cleanup;\0A        }\0A        ret = mbedtls_md_starts(&ctx->accumulator);\0A        if (ret != 0) {\0A            goto cleanup;\0A        }\0A        ctx->accumulator_started = 1;\0A    }\0A    if ((ret = mbedtls_md_update(&ctx->accumulator, header, 2)) != 0) {\0A        goto cleanup;\0A    }\0A    ret = mbedtls_md_update(&ctx->accumulator, p, use_len);\0A\0Acleanup:\0A    mbedtls_platform_zeroize(tmp, sizeof(tmp));\0A\0A    return ret;\0A}\0A\0Aint mbedtls_entropy_update_manual(mbedtls_entropy_context *ctx,\0A                                  const unsigned char *data, size_t len)\0A{\0A    int ret = MBEDTLS_ERR_ERROR_CORRUPTION_DETECTED;\0A\0A#if defined(MBEDTLS_THREADING_C)\0A    if ((ret = mbedtls_mutex_lock(&ctx->mutex)) != 0) {\0A        return ret;\0A    }\0A#endif\0A\0A    ret = entropy_update(ctx, MBEDTLS_ENTROPY_SOURCE_MANUAL, data, len);\0A\0A#if defined(MBEDTLS_THREADING_C)\0A    if (mbedtls_mutex_unlock(&ctx->mutex) != 0) {\0A        return MBEDTLS_ERR_THREADING_MUTEX_ERROR;\0A    }\0A#endif\0A\0A    return ret;\0A}\0A\0A/*\0A * Run through the different sources to add entropy to our accumulator\0A */\0Astatic int entropy_gather_internal(mbedtls_entropy_context *ctx)\0A{\0A    int ret = MBEDTLS_ERR_ENTROPY_SOURCE_FAILED;\0A    int i;\0A    int have_one_strong = 0;\0A    unsigned char buf[MBEDTLS_ENTROPY_MAX_GATHER];\0A    size_t olen;\0A\0A    if (ctx->source_count == 0) {\0A        return MBEDTLS_ERR_ENTROPY_NO_SOURCES_DEFINED;\0A    }\0A\0A    /*\0A     * Run through our entropy sources\0A     */\0A    for (i = 0; i < ctx->source_count; i++) {\0A        if (ctx->source[i].strong == MBEDTLS_ENTROPY_SOURCE_STRONG) {\0A            have_one_strong = 1;\0A        }\0A\0A        olen = 0;\0A        if ((ret = ctx->source[i].f_source(ctx->source[i].p_source,\0A                                           buf, MBEDTLS_ENTROPY_MAX_GATHER, &olen)) != 0) {\0A            goto cleanup;\0A        }\0A\0A        /*\0A         * Add if we actually gathered something\0A         */\0A        if (olen > 0) {\0A            if ((ret = entropy_update(ctx, (unsigned char) i,\0A                                      buf, olen)) != 0) {\0A                return ret;\0A            }\0A            ctx->source[i].size += olen;\0A        }\0A    }\0A\0A    if (have_one_strong == 0) {\0A        ret = MBEDTLS_ERR_ENTROPY_NO_STRONG_SOURCE;\0A    }\0A\0Acleanup:\0A    mbedtls_platform_zeroize(buf, sizeof(buf));\0A\0A    return ret;\0A}\0A\0A/*\0A * Thread-safe wrapper for entropy_gather_internal()\0A */\0Aint mbedtls_entropy_gather(mbedtls_entropy_context *ctx)\0A{\0A    int ret = MBEDTLS_ERR_ERROR_CORRUPTION_DETECTED;\0A\0A#if defined(MBEDTLS_THREADING_C)\0A    if ((ret = mbedtls_mutex_lock(&ctx->mutex)) != 0) {\0A        return ret;\0A    }\0A#endif\0A\0A    ret = entropy_gather_internal(ctx);\0A\0A#if defined(MBEDTLS_THREADING_C)\0A    if (mbedtls_mutex_unlock(&ctx->mutex) != 0) {\0A        return MBEDTLS_ERR_THREADING_MUTEX_ERROR;\0A    }\0A#endif\0A\0A    return ret;\0A}\0A\0Aint mbedtls_entropy_func(void *data, unsigned char *output, size_t len)\0A{\0A    int ret, count = 0, i, thresholds_reached;\0A    size_t strong_size;\0A    mbedtls_entropy_context *ctx = (mbedtls_entropy_context *) data;\0A    unsigned char buf[MBEDTLS_ENTROPY_BLOCK_SIZE];\0A\0A    if (len > MBEDTLS_ENTROPY_BLOCK_SIZE) {\0A        return MBEDTLS_ERR_ENTROPY_SOURCE_FAILED;\0A    }\0A\0A#if defined(MBEDTLS_ENTROPY_NV_SEED)\0A    /* Update the NV entropy seed before generating any entropy for outside\0A     * use.\0A     */\0A    if (ctx->initial_entropy_run == 0) {\0A        ctx->initial_entropy_run = 1;\0A        if ((ret = mbedtls_entropy_update_nv_seed(ctx)) != 0) {\0A            return ret;\0A        }\0A    }\0A#endif\0A\0A#if defined(MBEDTLS_THREADING_C)\0A    if ((ret = mbedtls_mutex_lock(&ctx->mutex)) != 0) {\0A        return ret;\0A    }\0A#endif\0A\0A    /*\0A     * Always gather extra entropy before a call\0A     */\0A    do {\0A        if (count++ > ENTROPY_MAX_LOOP) {\0A            ret = MBEDTLS_ERR_ENTROPY_SOURCE_FAILED;\0A            goto exit;\0A        }\0A\0A        if ((ret = entropy_gather_internal(ctx)) != 0) {\0A            goto exit;\0A        }\0A\0A        thresholds_reached = 1;\0A        strong_size = 0;\0A        for (i = 0; i < ctx->source_count; i++) {\0A            if (ctx->source[i].size < ctx->source[i].threshold) {\0A                thresholds_reached = 0;\0A            }\0A            if (ctx->source[i].strong == MBEDTLS_ENTROPY_SOURCE_STRONG) {\0A                strong_size += ctx->source[i].size;\0A            }\0A        }\0A    } while (!thresholds_reached || strong_size < MBEDTLS_ENTROPY_BLOCK_SIZE);\0A\0A    memset(buf, 0, MBEDTLS_ENTROPY_BLOCK_SIZE);\0A\0A    /*\0A     * Note that at this stage it is assumed that the accumulator was started\0A     * in a previous call to entropy_update(). If this is not guaranteed, the\0A     * code below will fail.\0A     */\0A    if ((ret = mbedtls_md_finish(&ctx->accumulator, buf)) != 0) {\0A        goto exit;\0A    }\0A\0A    /*\0A     * Reset accumulator and counters and recycle existing entropy\0A     */\0A    mbedtls_md_free(&ctx->accumulator);\0A    mbedtls_md_init(&ctx->accumulator);\0A    ret = mbedtls_md_setup(&ctx->accumulator,\0A                           mbedtls_md_info_from_type(MBEDTLS_ENTROPY_MD), 0);\0A    if (ret != 0) {\0A        goto exit;\0A    }\0A    ret = mbedtls_md_starts(&ctx->accumulator);\0A    if (ret != 0) {\0A        goto exit;\0A    }\0A    if ((ret = mbedtls_md_update(&ctx->accumulator, buf,\0A                                 MBEDTLS_ENTROPY_BLOCK_SIZE)) != 0) {\0A        goto exit;\0A    }\0A\0A    /*\0A     * Perform second hashing on entropy\0A     */\0A    if ((ret = mbedtls_md(mbedtls_md_info_from_type(MBEDTLS_ENTROPY_MD),\0A                          buf, MBEDTLS_ENTROPY_BLOCK_SIZE, buf)) != 0) {\0A        goto exit;\0A    }\0A\0A    for (i = 0; i < ctx->source_count; i++) {\0A        ctx->source[i].size = 0;\0A    }\0A\0A    memcpy(output, buf, len);\0A\0A    ret = 0;\0A\0Aexit:\0A    mbedtls_platform_zeroize(buf, sizeof(buf));\0A\0A#if defined(MBEDTLS_THREADING_C)\0A    if (mbedtls_mutex_unlock(&ctx->mutex) != 0) {\0A        return MBEDTLS_ERR_THREADING_MUTEX_ERROR;\0A    }\0A#endif\0A\0A    return ret;\0A}\0A\0A#if defined(MBEDTLS_ENTROPY_NV_SEED)\0Aint mbedtls_entropy_update_nv_seed(mbedtls_entropy_context *ctx)\0A{\0A    int ret = MBEDTLS_ERR_ENTROPY_FILE_IO_ERROR;\0A    unsigned char buf[MBEDTLS_ENTROPY_BLOCK_SIZE];\0A\0A    /* Read new seed  and write it to NV */\0A    if ((ret = mbedtls_entropy_func(ctx, buf, MBEDTLS_ENTROPY_BLOCK_SIZE)) != 0) {\0A        return ret;\0A    }\0A\0A    if (mbedtls_nv_seed_write(buf, MBEDTLS_ENTROPY_BLOCK_SIZE) < 0) {\0A        return MBEDTLS_ERR_ENTROPY_FILE_IO_ERROR;\0A    }\0A\0A    /* Manually update the remaining stream with a separator value to diverge */\0A    memset(buf, 0, MBEDTLS_ENTROPY_BLOCK_SIZE);\0A    ret = mbedtls_entropy_update_manual(ctx, buf, MBEDTLS_ENTROPY_BLOCK_SIZE);\0A\0A    return ret;\0A}\0A#endif /* MBEDTLS_ENTROPY_NV_SEED */\0A\0A#if defined(MBEDTLS_FS_IO)\0Aint mbedtls_entropy_write_seed_file(mbedtls_entropy_context *ctx, const char *path)\0A{\0A    int ret = MBEDTLS_ERR_ERROR_CORRUPTION_DETECTED;\0A    FILE *f = NULL;\0A    unsigned char buf[MBEDTLS_ENTROPY_BLOCK_SIZE];\0A\0A    if ((ret = mbedtls_entropy_func(ctx, buf, MBEDTLS_ENTROPY_BLOCK_SIZE)) != 0) {\0A        ret = MBEDTLS_ERR_ENTROPY_SOURCE_FAILED;\0A        goto exit;\0A    }\0A\0A    if ((f = fopen(path, \22wb\22)) == NULL) {\0A        ret = MBEDTLS_ERR_ENTROPY_FILE_IO_ERROR;\0A        goto exit;\0A    }\0A\0A    /* Ensure no stdio buffering of secrets, as such buffers cannot be wiped. */\0A    mbedtls_setbuf(f, NULL);\0A\0A    if (fwrite(buf, 1, MBEDTLS_ENTROPY_BLOCK_SIZE, f) != MBEDTLS_ENTROPY_BLOCK_SIZE) {\0A        ret = MBEDTLS_ERR_ENTROPY_FILE_IO_ERROR;\0A        goto exit;\0A    }\0A\0A    ret = 0;\0A\0Aexit:\0A    mbedtls_platform_zeroize(buf, sizeof(buf));\0A\0A    if (f != NULL) {\0A        fclose(f);\0A    }\0A\0A    return ret;\0A}\0A\0Aint mbedtls_entropy_update_seed_file(mbedtls_entropy_context *ctx, const char *path)\0A{\0A    int ret = 0;\0A    FILE *f;\0A    size_t n;\0A    unsigned char buf[MBEDTLS_ENTROPY_MAX_SEED_SIZE];\0A\0A    if ((f = fopen(path, \22rb\22)) == NULL) {\0A        return MBEDTLS_ERR_ENTROPY_FILE_IO_ERROR;\0A    }\0A\0A    /* Ensure no stdio buffering of secrets, as such buffers cannot be wiped. */\0A    mbedtls_setbuf(f, NULL);\0A\0A    fseek(f, 0, SEEK_END);\0A    n = (size_t) ftell(f);\0A    fseek(f, 0, SEEK_SET);\0A\0A    if (n > MBEDTLS_ENTROPY_MAX_SEED_SIZE) {\0A        n = MBEDTLS_ENTROPY_MAX_SEED_SIZE;\0A    }\0A\0A    if (fread(buf, 1, n, f) != n) {\0A        ret = MBEDTLS_ERR_ENTROPY_FILE_IO_ERROR;\0A    } else {\0A        ret = mbedtls_entropy_update_manual(ctx, buf, n);\0A    }\0A\0A    fclose(f);\0A\0A    mbedtls_platform_zeroize(buf, sizeof(buf));\0A\0A    if (ret != 0) {\0A        return ret;\0A    }\0A\0A    return mbedtls_entropy_write_seed_file(ctx, path);\0A}\0A#endif /* MBEDTLS_FS_IO */\0A\0A#if defined(MBEDTLS_SELF_TEST)\0A/*\0A * Dummy source function\0A */\0Astatic int entropy_dummy_source(void *data, unsigned char *output,\0A                                size_t len, size_t *olen)\0A{\0A    ((void) data);\0A\0A    memset(output, 0x2a, len);\0A    *olen = len;\0A\0A    return 0;\0A}\0A\0A#if defined(MBEDTLS_ENTROPY_HARDWARE_ALT)\0A\0Astatic int mbedtls_entropy_source_self_test_gather(unsigned char *buf, size_t buf_len)\0A{\0A    int ret = 0;\0A    size_t entropy_len = 0;\0A    size_t olen = 0;\0A    size_t attempts = buf_len;\0A\0A    while (attempts > 0 && entropy_len < buf_len) {\0A        if ((ret = mbedtls_hardware_poll(NULL, buf + entropy_len,\0A                                         buf_len - entropy_len, &olen)) != 0) {\0A            return ret;\0A        }\0A\0A        entropy_len += olen;\0A        attempts--;\0A    }\0A\0A    if (entropy_len < buf_len) {\0A        ret = 1;\0A    }\0A\0A    return ret;\0A}\0A\0A\0Astatic int mbedtls_entropy_source_self_test_check_bits(const unsigned char *buf,\0A                                                       size_t buf_len)\0A{\0A    unsigned char set = 0xFF;\0A    unsigned char unset = 0x00;\0A    size_t i;\0A\0A    for (i = 0; i < buf_len; i++) {\0A        set &= buf[i];\0A        unset |= buf[i];\0A    }\0A\0A    return set == 0xFF || unset == 0x00;\0A}\0A\0A/*\0A * A test to ensure that the entropy sources are functioning correctly\0A * and there is no obvious failure. The test performs the following checks:\0A *  - The entropy source is not providing only 0s (all bits unset) or 1s (all\0A *    bits set).\0A *  - The entropy source is not providing values in a pattern. Because the\0A *    hardware could be providing data in an arbitrary length, this check polls\0A *    the hardware entropy source twice and compares the result to ensure they\0A *    are not equal.\0A *  - The error code returned by the entropy source is not an error.\0A */\0Aint mbedtls_entropy_source_self_test(int verbose)\0A{\0A    int ret = 0;\0A    unsigned char buf0[2 * sizeof(unsigned long long int)];\0A    unsigned char buf1[2 * sizeof(unsigned long long int)];\0A\0A    if (verbose != 0) {\0A        mbedtls_printf(\22  ENTROPY_BIAS test: \22);\0A    }\0A\0A    memset(buf0, 0x00, sizeof(buf0));\0A    memset(buf1, 0x00, sizeof(buf1));\0A\0A    if ((ret = mbedtls_entropy_source_self_test_gather(buf0, sizeof(buf0))) != 0) {\0A        goto cleanup;\0A    }\0A    if ((ret = mbedtls_entropy_source_self_test_gather(buf1, sizeof(buf1))) != 0) {\0A        goto cleanup;\0A    }\0A\0A    /* Make sure that the returned values are not all 0 or 1 */\0A    if ((ret = mbedtls_entropy_source_self_test_check_bits(buf0, sizeof(buf0))) != 0) {\0A        goto cleanup;\0A    }\0A    if ((ret = mbedtls_entropy_source_self_test_check_bits(buf1, sizeof(buf1))) != 0) {\0A        goto cleanup;\0A    }\0A\0A    /* Make sure that the entropy source is not returning values in a\0A     * pattern */\0A    ret = memcmp(buf0, buf1, sizeof(buf0)) == 0;\0A\0Acleanup:\0A    if (verbose != 0) {\0A        if (ret != 0) {\0A            mbedtls_printf(\22failed\5Cn\22);\0A        } else {\0A            mbedtls_printf(\22passed\5Cn\22);\0A        }\0A\0A        mbedtls_printf(\22\5Cn\22);\0A    }\0A\0A    return ret != 0;\0A}\0A\0A#endif /* MBEDTLS_ENTROPY_HARDWARE_ALT */\0A\0A/*\0A * The actual entropy quality is hard to test, but we can at least\0A * test that the functions don't cause errors and write the correct\0A * amount of data to buffers.\0A */\0Aint mbedtls_entropy_self_test(int verbose)\0A{\0A    int ret = 1;\0A    mbedtls_entropy_context ctx;\0A    unsigned char buf[MBEDTLS_ENTROPY_BLOCK_SIZE] = { 0 };\0A    unsigned char acc[MBEDTLS_ENTROPY_BLOCK_SIZE] = { 0 };\0A    size_t i, j;\0A\0A    if (verbose != 0) {\0A        mbedtls_printf(\22  ENTROPY test: \22);\0A    }\0A\0A    mbedtls_entropy_init(&ctx);\0A\0A    /* First do a gather to make sure we have default sources */\0A    if ((ret = mbedtls_entropy_gather(&ctx)) != 0) {\0A        goto cleanup;\0A    }\0A\0A    ret = mbedtls_entropy_add_source(&ctx, entropy_dummy_source, NULL, 16,\0A                                     MBEDTLS_ENTROPY_SOURCE_WEAK);\0A    if (ret != 0) {\0A        goto cleanup;\0A    }\0A\0A    if ((ret = mbedtls_entropy_update_manual(&ctx, buf, sizeof(buf))) != 0) {\0A        goto cleanup;\0A    }\0A\0A    /*\0A     * To test that mbedtls_entropy_func writes correct number of bytes:\0A     * - use the whole buffer and rely on ASan to detect overruns\0A     * - collect entropy 8 times and OR the result in an accumulator:\0A     *   any byte should then be 0 with probably 2^(-64), so requiring\0A     *   each of the 32 or 64 bytes to be non-zero has a false failure rate\0A     *   of at most 2^(-58) which is acceptable.\0A     */\0A    for (i = 0; i < 8; i++) {\0A        if ((ret = mbedtls_entropy_func(&ctx, buf, sizeof(buf))) != 0) {\0A            goto cleanup;\0A        }\0A\0A        for (j = 0; j < sizeof(buf); j++) {\0A            acc[j] |= buf[j];\0A        }\0A    }\0A\0A    for (j = 0; j < sizeof(buf); j++) {\0A        if (acc[j] == 0) {\0A            ret = 1;\0A            goto cleanup;\0A        }\0A    }\0A\0A#if defined(MBEDTLS_ENTROPY_HARDWARE_ALT)\0A    if ((ret = mbedtls_entropy_source_self_test(0)) != 0) {\0A        goto cleanup;\0A    }\0A#endif\0A\0Acleanup:\0A    mbedtls_entropy_free(&ctx);\0A\0A    if (verbose != 0) {\0A        if (ret != 0) {\0A            mbedtls_printf(\22failed\5Cn\22);\0A        } else {\0A            mbedtls_printf(\22passed\5Cn\22);\0A        }\0A\0A        mbedtls_printf(\22\5Cn\22);\0A    }\0A\0A    return ret != 0;\0A}\0A#endif /* MBEDTLS_SELF_TEST */\0A\0A#endif /* MBEDTLS_ENTROPY_C */\0A\00" }
