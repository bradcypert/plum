@.str41466 = private global { i64, i64, [16991 x i8] } { i64 -1, i64 16990, [16991 x i8] c"/*\0A *  Copyright The Mbed TLS Contributors\0A *  SPDX-License-Identifier: Apache-2.0 OR GPL-2.0-or-later\0A */\0A\0A/**\0A * \5Cfile mps_reader.h\0A *\0A * \5Cbrief This file defines reader objects, which together with their\0A *        sibling writer objects form the basis for the communication\0A *        between the various layers of the Mbed TLS messaging stack,\0A *        as well as the communication between the messaging stack and\0A *        the (D)TLS handshake protocol implementation.\0A *\0A * Readers provide a means of transferring incoming data from\0A * a 'producer' providing it in chunks of arbitrary size, to\0A * a 'consumer' which fetches and processes it in chunks of\0A * again arbitrary, and potentially different, size.\0A *\0A * Readers can thus be seen as datagram-to-stream converters,\0A * and they abstract away the following two tasks from the user:\0A * 1. The pointer arithmetic of stepping through a producer-\0A *    provided chunk in smaller chunks.\0A * 2. The merging of incoming data chunks in case the\0A *    consumer requests data in larger chunks than what the\0A *    producer provides.\0A *\0A * The basic abstract flow of operation is the following:\0A * - Initially, the reader is in 'producing mode'.\0A * - The producer hands an incoming data buffer to the reader,\0A *   moving it from 'producing' to 'consuming' mode.\0A * - The consumer subsequently fetches and processes the buffer\0A *   content. Once that's done -- or partially done and a consumer's\0A *   request can't be fulfilled -- the producer revokes the reader's\0A *   access to the incoming data buffer, putting the reader back to\0A *   producing mode.\0A * - The producer subsequently gathers more incoming data and hands\0A *   it to the reader until it switches back to consuming mode\0A *   if enough data is available for the last consumer request to\0A *   be satisfiable.\0A * - Repeat the above.\0A *\0A * The abstract states of the reader from the producer's and\0A * consumer's perspective are as follows:\0A *\0A * - From the perspective of the consumer, the state of the\0A *   reader consists of the following:\0A *   - A byte stream representing (concatenation of) the data\0A *     received through calls to mbedtls_mps_reader_get(),\0A *   - A marker within that byte stream indicating which data\0A *     can be considered processed, and hence need not be retained,\0A *     when the reader is passed back to the producer via\0A *     mbedtls_mps_reader_reclaim().\0A *     The marker is set via mbedtls_mps_reader_commit()\0A *     which places it at the end of the current byte stream.\0A *   The consumer need not be aware of the distinction between consumer\0A *   and producer mode, because it only interfaces with the reader\0A *   when the latter is in consuming mode.\0A *\0A * - From the perspective of the producer, the reader's state is one of:\0A *   - Attached: The reader is in consuming mode.\0A *   - Unset: No incoming data buffer is currently managed by the reader,\0A *            and all previously handed incoming data buffers have been\0A *            fully processed. More data needs to be fed into the reader\0A *            via mbedtls_mps_reader_feed().\0A *\0A *   - Accumulating: No incoming data buffer is currently managed by the\0A *                   reader, but some data from the previous incoming data\0A *                   buffer hasn't been processed yet and is internally\0A *                   held back.\0A *   The Attached state belongs to consuming mode, while the Unset and\0A *   Accumulating states belong to producing mode.\0A *\0A * Transitioning from the Unset or Accumulating state to Attached is\0A * done via successful calls to mbedtls_mps_reader_feed(), while\0A * transitioning from Attached to either Unset or Accumulating (depending\0A * on what has been processed) is done via mbedtls_mps_reader_reclaim().\0A *\0A * The following diagram depicts the producer-state progression:\0A *\0A *        +------------------+             reclaim\0A *        |      Unset       +<-------------------------------------+       get\0A *        +--------|---------+                                      |   +------+\0A *                 |                                                |   |      |\0A *                 |                                                |   |      |\0A *                 |                feed                  +---------+---+--+   |\0A *                 +-------------------------------------->                <---+\0A *                                                        |    Attached    |\0A *                 +-------------------------------------->                <---+\0A *                 |     feed, enough data available      +---------+---+--+   |\0A *                 |     to serve previous consumer request         |   |      |\0A *                 |                                                |   |      |\0A *        +--------+---------+                                      |   +------+\0A *   +---->   Accumulating   |<-------------------------------------+    commit\0A *   |    +---+--------------+      reclaim, previous read request\0A *   |        |                        couldn't be fulfilled\0A *   |        |\0A *   +--------+\0A *     feed, need more data to serve\0A *     previous consumer request\0A *                                         |\0A *                                         |\0A *               producing mode            |           consuming mode\0A *                                         |\0A *\0A */\0A\0A#ifndef MBEDTLS_READER_H\0A#define MBEDTLS_READER_H\0A\0A#include <stdio.h>\0A\0A#include \22mps_common.h\22\0A#include \22mps_error.h\22\0A\0Astruct mbedtls_mps_reader;\0Atypedef struct mbedtls_mps_reader mbedtls_mps_reader;\0A\0A/*\0A * Structure definitions\0A */\0A\0Astruct mbedtls_mps_reader {\0A    unsigned char *frag;  /*!< The fragment of incoming data managed by\0A                           *   the reader; it is provided to the reader\0A                           *   through mbedtls_mps_reader_feed(). The reader\0A                           *   does not own the fragment and does not\0A                           *   perform any allocation operations on it,\0A                           *   but does have read and write access to it.\0A                           *\0A                           *   The reader is in consuming mode if\0A                           *   and only if \5Cc frag is not \5Cc NULL.          */\0A    mbedtls_mps_stored_size_t frag_len;\0A    /*!< The length of the current fragment.\0A     *   Must be 0 if \5Cc frag == \5Cc NULL.             */\0A    mbedtls_mps_stored_size_t commit;\0A    /*!< The offset of the last commit, relative\0A     *   to the first byte in the fragment, if\0A     *   no accumulator is present. If an accumulator\0A     *   is present, it is viewed as a prefix to the\0A     *   current fragment, and this variable contains\0A     *   an offset from the beginning of the accumulator.\0A     *\0A     *   This is only used when the reader is in\0A     *   consuming mode, i.e. \5Cc frag != \5Cc NULL;\0A     *   otherwise, its value is \5Cc 0.                */\0A    mbedtls_mps_stored_size_t end;\0A    /*!< The offset of the end of the last chunk\0A     *   passed to the user through a call to\0A     *   mbedtls_mps_reader_get(), relative to the first\0A     *   byte in the fragment, if no accumulator is\0A     *   present. If an accumulator is present, it is\0A     *   viewed as a prefix to the current fragment, and\0A     *   this variable contains an offset from the\0A     *   beginning of the accumulator.\0A     *\0A     *   This is only used when the reader is in\0A     *   consuming mode, i.e. \5Cc frag != \5Cc NULL;\0A     *   otherwise, its value is \5Cc 0.                */\0A    mbedtls_mps_stored_size_t pending;\0A    /*!< The amount of incoming data missing on the\0A     *   last call to mbedtls_mps_reader_get().\0A     *   In particular, it is \5Cc 0 if the last call\0A     *   was successful.\0A     *   If a reader is reclaimed after an\0A     *   unsuccessful call to mbedtls_mps_reader_get(),\0A     *   this variable is used to have the reader\0A     *   remember how much data should be accumulated\0A     *   so that the call to mbedtls_mps_reader_get()\0A     *   succeeds next time.\0A     *   This is only used when the reader is in\0A     *   consuming mode, i.e. \5Cc frag != \5Cc NULL;\0A     *   otherwise, its value is \5Cc 0.                */\0A\0A    /* The accumulator is only needed if we need to be able to pause\0A     * the reader. A few bytes could be saved by moving this to a\0A     * separate struct and using a pointer here. */\0A\0A    unsigned char *acc;   /*!< The accumulator is used to gather incoming\0A                           *   data if a read-request via mbedtls_mps_reader_get()\0A                           *   cannot be served from the current fragment.   */\0A    mbedtls_mps_stored_size_t acc_len;\0A    /*!< The total size of the accumulator.           */\0A    mbedtls_mps_stored_size_t acc_available;\0A    /*!< The number of bytes currently gathered in\0A     *   the accumulator. This is both used in\0A     *   producing and in consuming mode:\0A     *   While producing, it is increased until\0A     *   it reaches the value of \5Cc acc_remaining below.\0A     *   While consuming, it is used to judge if a\0A     *   get request can be served from the\0A     *   accumulator or not.\0A     *   Must not be larger than \5Cc acc_len.           */\0A    union {\0A        mbedtls_mps_stored_size_t acc_remaining;\0A        /*!< This indicates the amount of data still\0A         *   to be gathered in the accumulator. It is\0A         *   only used in producing mode.\0A         *   Must be at most acc_len - acc_available.  */\0A        mbedtls_mps_stored_size_t frag_offset;\0A        /*!< If an accumulator is present and in use, this\0A         *   field indicates the offset of the current\0A         *   fragment from the beginning of the\0A         *   accumulator. If no accumulator is present\0A         *   or the accumulator is not in use, this is \5Cc 0.\0A         *   It is only used in consuming mode.\0A         *   Must not be larger than \5Cc acc_available. */\0A    } acc_share;\0A};\0A\0A/*\0A * API organization:\0A * A reader object is usually prepared and maintained\0A * by some lower layer and passed for usage to an upper\0A * layer, and the API naturally splits according to which\0A * layer is supposed to use the respective functions.\0A */\0A\0A/*\0A * Maintenance API (Lower layer)\0A */\0A\0A/**\0A * \5Cbrief           Initialize a reader object\0A *\0A * \5Cparam reader    The reader to be initialized.\0A * \5Cparam acc       The buffer to be used as a temporary accumulator\0A *                  in case get requests through mbedtls_mps_reader_get()\0A *                  exceed the buffer provided by mbedtls_mps_reader_feed().\0A *                  This buffer is owned by the caller and exclusive use\0A *                  for reading and writing is given to the reader for the\0A *                  duration of the reader's lifetime. It is thus the caller's\0A *                  responsibility to maintain (and not touch) the buffer for\0A *                  the lifetime of the reader, and to properly zeroize and\0A *                  free the memory after the reader has been destroyed.\0A * \5Cparam acc_len   The size in Bytes of \5Cp acc.\0A *\0A * \5Creturn          \5Cc 0 on success.\0A * \5Creturn          A negative \5Cc MBEDTLS_ERR_READER_XXX error code on failure.\0A */\0Aint mbedtls_mps_reader_init(mbedtls_mps_reader *reader,\0A                            unsigned char *acc,\0A                            mbedtls_mps_size_t acc_len);\0A\0A/**\0A * \5Cbrief           Free a reader object\0A *\0A * \5Cparam reader    The reader to be freed.\0A *\0A * \5Creturn          \5Cc 0 on success.\0A * \5Creturn          A negative \5Cc MBEDTLS_ERR_READER_XXX error code on failure.\0A */\0Aint mbedtls_mps_reader_free(mbedtls_mps_reader *reader);\0A\0A/**\0A * \5Cbrief           Pass chunk of data for the reader to manage.\0A *\0A * \5Cparam reader    The reader context to use. The reader must be\0A *                  in producing mode.\0A * \5Cparam buf       The buffer to be managed by the reader.\0A * \5Cparam buflen    The size in Bytes of \5Cp buffer.\0A *\0A * \5Creturn          \5Cc 0 on success. In this case, the reader will be\0A *                  moved to consuming mode and obtains read access\0A *                  of \5Cp buf until mbedtls_mps_reader_reclaim()\0A *                  is called. It is the responsibility of the caller\0A *                  to ensure that the \5Cp buf persists and is not changed\0A *                  between successful calls to mbedtls_mps_reader_feed()\0A *                  and mbedtls_mps_reader_reclaim().\0A * \5Creturn          \5Cc MBEDTLS_ERR_MPS_READER_NEED_MORE if more input data is\0A *                  required to fulfill a previous request to mbedtls_mps_reader_get().\0A *                  In this case, the reader remains in producing mode and\0A *                  takes no ownership of the provided buffer (an internal copy\0A *                  is made instead).\0A * \5Creturn          Another negative \5Cc MBEDTLS_ERR_READER_XXX error code on\0A *                  different kinds of failures.\0A */\0Aint mbedtls_mps_reader_feed(mbedtls_mps_reader *reader,\0A                            unsigned char *buf,\0A                            mbedtls_mps_size_t buflen);\0A\0A/**\0A * \5Cbrief           Reclaim reader's access to the current input buffer.\0A *\0A * \5Cparam reader    The reader context to use. The reader must be\0A *                  in consuming mode.\0A * \5Cparam paused    If not \5Cc NULL, the integer at address \5Cp paused will be\0A *                  modified to indicate whether the reader has been paused\0A *                  (value \5Cc 1) or not (value \5Cc 0). Pausing happens if there\0A *                  is uncommitted data and a previous request to\0A *                  mbedtls_mps_reader_get() has exceeded the bounds of the\0A *                  input buffer.\0A *\0A * \5Creturn          \5Cc 0 on success.\0A * \5Creturn          A negative \5Cc MBEDTLS_ERR_READER_XXX error code on failure.\0A */\0Aint mbedtls_mps_reader_reclaim(mbedtls_mps_reader *reader,\0A                               int *paused);\0A\0A/*\0A * Usage API (Upper layer)\0A */\0A\0A/**\0A * \5Cbrief           Request data from the reader.\0A *\0A * \5Cparam reader    The reader context to use. The reader must\0A *                  be in consuming mode.\0A * \5Cparam desired   The desired amount of data to be read, in Bytes.\0A * \5Cparam buffer    The address to store the buffer pointer in.\0A *                  This must not be \5Cc NULL.\0A * \5Cparam buflen    The address to store the actual buffer\0A *                  length in, or \5Cc NULL.\0A *\0A * \5Creturn          \5Cc 0 on success. In this case, \5Cc *buf holds the\0A *                  address of a buffer of size \5Cc *buflen\0A *                  (if \5Cc buflen != \5Cc NULL) or \5Cc desired\0A *                  (if \5Cc buflen == \5Cc NULL). The user has read access\0A *                  to the buffer and guarantee of stability of the data\0A *                  until the next call to mbedtls_mps_reader_reclaim().\0A * \5Creturn          #MBEDTLS_ERR_MPS_READER_OUT_OF_DATA if there is not enough\0A *                  data available to serve the get request. In this case, the\0A *                  reader remains intact and in consuming mode, and the consumer\0A *                  should retry the call after a successful cycle of\0A *                  mbedtls_mps_reader_reclaim() and mbedtls_mps_reader_feed().\0A *                  If, after such a cycle, the consumer requests a different\0A *                  amount of data, the result is implementation-defined;\0A *                  progress is guaranteed only if the same amount of data\0A *                  is requested after a mbedtls_mps_reader_reclaim() and\0A *                  mbedtls_mps_reader_feed() cycle.\0A * \5Creturn          Another negative \5Cc MBEDTLS_ERR_READER_XXX error\0A *                  code for different kinds of failure.\0A *\0A * \5Cnote            Passing \5Cc NULL as \5Cp buflen is a convenient way to\0A *                  indicate that fragmentation is not tolerated.\0A *                  It's functionally equivalent to passing a valid\0A *                  address as buflen and checking \5Cc *buflen == \5Cc desired\0A *                  afterwards.\0A */\0Aint mbedtls_mps_reader_get(mbedtls_mps_reader *reader,\0A                           mbedtls_mps_size_t desired,\0A                           unsigned char **buffer,\0A                           mbedtls_mps_size_t *buflen);\0A\0A/**\0A * \5Cbrief         Mark data obtained from mbedtls_mps_reader_get() as processed.\0A *\0A *                This call indicates that all data received from prior calls to\0A *                mbedtls_mps_reader_get() has been or will have been\0A *                processed when mbedtls_mps_reader_reclaim() is called,\0A *                and thus need not be backed up.\0A *\0A *                This function has no user observable effect until\0A *                mbedtls_mps_reader_reclaim() is called. In particular,\0A *                buffers received from mbedtls_mps_reader_get() remain\0A *                valid until mbedtls_mps_reader_reclaim() is called.\0A *\0A * \5Cparam reader  The reader context to use.\0A *\0A * \5Creturn        \5Cc 0 on success.\0A * \5Creturn        A negative \5Cc MBEDTLS_ERR_READER_XXX error code on failure.\0A *\0A */\0Aint mbedtls_mps_reader_commit(mbedtls_mps_reader *reader);\0A\0A#endif /* MBEDTLS_READER_H */\0A\00" }
