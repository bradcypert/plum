tion\0A * \5Cretval #PSA_ERROR_INVALID_ARGUMENT\0A *         An unsupported, incorrectly formatted or incorrect type of key was\0A *         used.\0A * \5Cretval #PSA_ERROR_NOT_SUPPORTED Either no internal interruptible operations\0A *         are currently supported, or the key type is currently unsupported.\0A * \5Cretval #PSA_ERROR_INSUFFICIENT_MEMORY\0A *         There was insufficient memory to load the key representation.\0A */\0Apsa_status_t mbedtls_psa_sign_hash_start(\0A    mbedtls_psa_sign_hash_interruptible_operation_t *operation,\0A    const psa_key_attributes_t *attributes, const uint8_t *key_buffer,\0A    size_t key_buffer_size, psa_algorithm_t alg,\0A    const uint8_t *hash, size_t hash_length);\0A\0A/**\0A * \5Cbrief Continue and eventually complete the action of signing a hash or\0A *        short message with a private key, in an interruptible manner.\0A *\0A * \5Cnote The signature of this function is that of a PSA driver\0A *       sign_hash_complete entry point. This function behaves as a\0A *       sign_hash_complete entry point as defined in the PSA driver interface\0A *       specification for transparent drivers.\0A *\0A * \5Cparam[in]  operation        The \5Cc\0A *                              mbedtls_psa_sign_hash_interruptible_operation_t\0A *                              to use. This must be initialized first.\0A *\0A * \5Cparam[out] signature        Buffer where the signature is to be written.\0A * \5Cparam signature_size        Size of the \5Cp signature buffer in bytes. This\0A *                              must be appropriate for the selected\0A *                              algorithm and key.\0A * \5Cparam[out] signature_length On success, the number of bytes that make up\0A *                              the returned signature value.\0A *\0A * \5Cretval #PSA_SUCCESS\0A *         Operation completed successfully\0A *\0A * \5Cretval #PSA_OPERATION_INCOMPLETE\0A *         Operation was interrupted due to the setting of \5Cc\0A *         psa_interruptible_set_max_ops(), there is still work to be done,\0A *         please call this function again with the same operation object.\0A *\0A * \5Cretval #PSA_ERROR_BUFFER_TOO_SMALL\0A *         The size of the \5Cp signature buffer is too small. You can\0A *         determine a sufficient buffer size by calling\0A *         #PSA_SIGN_OUTPUT_SIZE(\5Cc key_type, \5Cc key_bits, \5Cp alg)\0A *         where \5Cc key_type and \5Cc key_bits are the type and bit-size\0A *         respectively of \5Cp key.\0A *\0A * \5Cretval #PSA_ERROR_NOT_SUPPORTED \5Cemptydescription\0A * \5Cretval #PSA_ERROR_INVALID_ARGUMENT \5Cemptydescription\0A * \5Cretval #PSA_ERROR_INSUFFICIENT_MEMORY \5Cemptydescription\0A * \5Cretval #PSA_ERROR_CORRUPTION_DETECTED \5Cemptydescription\0A * \5Cretval #PSA_ERROR_INSUFFICIENT_ENTROPY \5Cemptydescription\0A */\0Apsa_status_t mbedtls_psa_sign_hash_complete(\0A    mbedtls_psa_sign_hash_interruptible_operation_t *operation,\0A    uint8_t *signature, size_t signature_size,\0A    size_t *signature_length);\0A\0A/**\0A * \5Cbrief Abort a sign hash operation.\0A *\0A * \5Cnote The signature of this function is that of a PSA driver sign_hash_abort\0A *       entry point. This function behaves as a sign_hash_abort entry point as\0A *       defined in the PSA driver interface specification for transparent\0A *       drivers.\0A *\0A * \5Cparam[in]  operation        The \5Cc\0A *                              mbedtls_psa_sign_hash_interruptible_operation_t\0A *                              to abort.\0A *\0A * \5Cretval #PSA_SUCCESS\0A *         The operation was aborted successfully.\0A */\0Apsa_status_t mbedtls_psa_sign_hash_abort(\0A    mbedtls_psa_sign_hash_interruptible_operation_t *operation);\0A\0A/**\0A * \5Cbrief  Start reading and verifying a hash or short message, in an\0A *         interruptible manner.\0A *\0A * \5Cnote The signature of this function is that of a PSA driver\0A *       verify_hash_start entry point. This function behaves