@.str42005 = private global { i64, i64, [85892 x i8] } { i64 -1, i64 85891, [85892 x i8] c"/**\0A * \5Cfile ssl_ciphersuites.c\0A *\0A * \5Cbrief SSL ciphersuites for Mbed TLS\0A *\0A *  Copyright The Mbed TLS Contributors\0A *  SPDX-License-Identifier: Apache-2.0 OR GPL-2.0-or-later\0A */\0A\0A#include \22common.h\22\0A\0A#if defined(MBEDTLS_SSL_TLS_C)\0A\0A#include \22mbedtls/platform.h\22\0A\0A#include \22mbedtls/ssl_ciphersuites.h\22\0A#include \22mbedtls/ssl.h\22\0A#include \22ssl_misc.h\22\0A#if defined(MBEDTLS_USE_PSA_CRYPTO)\0A#include \22mbedtls/psa_util.h\22\0A#endif\0A\0A#include <string.h>\0A\0A/*\0A * Ordered from most preferred to least preferred in terms of security.\0A *\0A * Current rule (except weak and null which come last):\0A * 1. By key exchange:\0A *    Forward-secure non-PSK > forward-secure PSK > ECJPAKE > other non-PSK > other PSK\0A * 2. By key length and cipher:\0A *    ChaCha > AES-256 > Camellia-256 > ARIA-256 > AES-128 > Camellia-128 > ARIA-128\0A * 3. By cipher mode when relevant GCM > CCM > CBC > CCM_8\0A * 4. By hash function used when relevant\0A * 5. By key exchange/auth again: EC > non-EC\0A */\0Astatic const int ciphersuite_preference[] =\0A{\0A#if defined(MBEDTLS_SSL_CIPHERSUITES)\0A    MBEDTLS_SSL_CIPHERSUITES,\0A#else\0A#if defined(MBEDTLS_SSL_PROTO_TLS1_3)\0A    /* TLS 1.3 ciphersuites */\0A    MBEDTLS_TLS1_3_CHACHA20_POLY1305_SHA256,\0A    MBEDTLS_TLS1_3_AES_256_GCM_SHA384,\0A    MBEDTLS_TLS1_3_AES_128_GCM_SHA256,\0A    MBEDTLS_TLS1_3_AES_128_CCM_SHA256,\0A    MBEDTLS_TLS1_3_AES_128_CCM_8_SHA256,\0A#endif /* MBEDTLS_SSL_PROTO_TLS1_3 */\0A\0A    /* Chacha-Poly ephemeral suites */\0A    MBEDTLS_TLS_ECDHE_RSA_WITH_CHACHA20_POLY1305_SHA256,\0A    MBEDTLS_TLS_ECDHE_ECDSA_WITH_CHACHA20_POLY1305_SHA256,\0A    MBEDTLS_TLS_DHE_RSA_WITH_CHACHA20_POLY1305_SHA256,\0A\0A    /* All AES-256 ephemeral suites */\0A    MBEDTLS_TLS_ECDHE_ECDSA_WITH_AES_256_GCM_SHA384,\0A    MBEDTLS_TLS_ECDHE_RSA_WITH_AES_256_GCM_SHA384,\0A    MBEDTLS_TLS_DHE_