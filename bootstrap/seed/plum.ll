@.str41724 = private global { i64, i64, [4331 x i8] } { i64 -1, i64 4330, [4331 x i8] c"/**\0A * \5Cfile x509.h\0A *\0A * \5Cbrief Internal part of the public \22x509.h\22.\0A */\0A/*\0A *  Copyright The Mbed TLS Contributors\0A *  SPDX-License-Identifier: Apache-2.0 OR GPL-2.0-or-later\0A */\0A#ifndef MBEDTLS_X509_INTERNAL_H\0A#define MBEDTLS_X509_INTERNAL_H\0A#include \22mbedtls/private_access.h\22\0A\0A#include \22mbedtls/build_info.h\22\0A\0A#include \22mbedtls/x509.h\22\0A#include \22mbedtls/asn1.h\22\0A#include \22pk_internal.h\22\0A\0A#if defined(MBEDTLS_RSA_C)\0A#include \22mbedtls/rsa.h\22\0A#endif\0A\0Aint mbedtls_x509_get_name(unsigned char **p, const unsigned char *end,\0A                          mbedtls_x509_name *cur);\0Aint mbedtls_x509_get_alg_null(unsigned char **p, const unsigned char *end,\0A                              mbedtls_x509_buf *alg);\0Aint mbedtls_x509_get_alg(unsigned char **p, const unsigned char *end,\0A                         mbedtls_x509_buf *alg, mbedtls_x509_buf *params);\0A#if defined(MBEDTLS_X509_RSASSA_PSS_SUPPORT)\0Aint mbedtls_x509_get_rsassa_pss_params(const mbedtls_x509_buf *params,\0A                                       mbedtls_md_type_t *md_alg, mbedtls_md_type_t *mgf_md,\0A                                       int *salt_len);\0A#endif\0Aint mbedtls_x509_get_sig(unsigned char **p, const unsigned char *end, mbedtls_x509_buf *sig);\0Aint mbedtls_x509_get_sig_alg(const mbedtls_x509_buf *sig_oid, const mbedtls_x509_buf *sig_params,\0A                             mbedtls_md_type_t *md_alg, mbedtls_pk_type_t *pk_alg,\0A                             void **sig_opts);\0Aint mbedtls_x509_get_time(unsigned char **p, const unsigned char *end,\0A                          mbedtls_x509_time *t);\0Aint mbedtls_x509_get_serial(unsigned char **p, const unsigned char *end,\0A                            mbedtls_x509_buf *serial);\0Aint mbedtls_x509_get_ext(unsigned char **p, const unsigned char *end,\0A                         mbedtls_x509_buf *ext, int tag);\0A#if !defined(MBEDTLS_X509_REMOVE_INFO)\0Aint mbedtls_x509_sig_alg_gets(char *buf, size_t size, const mbedtls_x509_buf *sig_oid,\0A                              mbedtls_pk_type_t pk_alg, mbedtls_md_type_t md_alg,\0A                              const void *sig_opts);\0A#endif\0Aint mbedtls_x509_key_size_helper(char *buf, size_t buf_size, const char *name);\0Aint mbedtls_x509_set_extension(mbedtls_asn1_named_data **head, const char *oid, size_t oid_len,\0A                               int critical, const unsigned char *val,\0A                               size_t val_len);\0Aint mbedtls_x509_write_extensions(unsigned char **p, unsigned char *start,\0A                                  mbedtls_asn1_named_data *first);\0Aint mbedtls_x509_write_names(unsigned char **p, unsigned char *start,\0A                             mbedtls_asn1_named_data *first);\0Aint mbedtls_x509_write_sig(unsigned char **p, unsigned char *start,\0A                           const char *oid, size_t oid_len,\0A                           unsigned char *sig, size_t size,\0A                           mbedtls_pk_type_t pk_alg);\0Aint mbedtls_x509_get_ns_cert_type(unsigned char **p,\0A                                  const unsigned char *end,\0A                                  unsigned char *ns_cert_type);\0Aint mbedtls_x509_get_key_usage(unsigned char **p,\0A                               const unsigned char *end,\0A                               unsigned int *key_usage);\0Aint mbedtls_x509_get_subject_alt_name(unsigned char **p,\0A                                      const unsigned char *end,\0A                                      mbedtls_x509_sequence *subject_alt_name);\0Aint mbedtls_x509_get_subject_alt_name_ext(unsigned char **p,\0A                                          const unsigned char *end,\0A                                          mbedtls_x509_sequence *subject_alt_name);\0Aint mbedtls_x509_info_subject_alt_name(char **buf, size_t *size,\0A                                       const mbedtls_x509_sequence\0A                                       *subject_alt_name,\0A                                       const char *prefix);\0Aint mbedtls_x509_info_cert_type(char **buf, size_t *size,\0A                                unsigned char ns_cert_type);\0Aint mbedtls_x509_info_key_usage(char **buf, size_t *size,\0A                                unsigned int key_usage);\0A\0Aint mbedtls_x509_write_set_san_common(mbedtls_asn1_named_data **extensions,\0A                                      const mbedtls_x509_san_list *san_list);\0A\0A#endif /* MBEDTLS_X509_INTERNAL_H */\0A\00" }
