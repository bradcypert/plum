if (bind(bind_ctx->fd, (struct sockaddr *) &local_addr, n) != 0) {\0A            return MBEDTLS_ERR_NET_BIND_FAILED;\0A        }\0A    }\0A\0A    if (client_ip != NULL) {\0A        if (client_addr.ss_family == AF_INET) {\0A            struct sockaddr_in *addr4 = (struct sockaddr_in *) &client_addr;\0A            *cip_len = sizeof(addr4->sin_addr.s_addr);\0A\0A            if (buf_size < *cip_len) {\0A                return MBEDTLS_ERR_NET_BUFFER_TOO_SMALL;\0A            }\0A\0A            memcpy(client_ip, &addr4->sin_addr.s_addr, *cip_len);\0A        } else {\0A            struct sockaddr_in6 *addr6 = (struct sockaddr_in6 *) &client_addr;\0A            *cip_len = sizeof(addr6->sin6_addr.s6_addr);\0A\0A            if (buf_size < *cip_len) {\0A                return MBEDTLS_ERR_NET_BUFFER_TOO_SMALL;\0A            }\0A\0A            memcpy(client_ip, &addr6->sin6_addr.s6_addr, *cip_len);\0A        }\0A    }\0A\0A    return 0;\0A}\0A\0A/*\0A * Set the socket blocking or non-blocking\0A */\0Aint mbedtls_net_set_block(mbedtls_net_context *ctx)\0A{\0A#if (defined(_WIN32) || defined(_WIN32_WCE)) && !defined(EFIX64) && \5C\0A    !defined(EFI32)\0A    u_long n = 0;\0A    return ioctlsocket(ctx->fd, FIONBIO, &n);\0A#else\0A    return fcntl(ctx->fd, F_SETFL, fcntl(ctx->fd, F_GETFL) & ~O_NONBLOCK);\0A#endif\0A}\0A\0Aint mbedtls_net_set_nonblock(mbedtls_net_context *ctx)\0A{\0A#if (defined(_WIN32) || defined(_WIN32_WCE)) && !defined(EFIX64) && \5C\0A    !defined(EFI32)\0A    u_long n = 1;\0A    return ioctlsocket(ctx->fd, FIONBIO, &n);\0A#else\0A    return fcntl(ctx->fd, F_SETFL, fcntl(ctx->fd, F_GETFL) | O_NONBLOCK);\0A#endif\0A}\0A\0A/*\0A * Check if data is available on the socket\0A */\0A\0Aint mbedtls_net_poll(mbedtls_net_context *ctx, uint32_t rw, uint32_t timeout)\0A{\0A    int ret = MBEDTLS_ERR_ERROR_CORRUPTION_DETECTED;\0A    struct timeval tv;\0A\0A    fd_set read_fds;\0A    fd_set write_fds;\0A\0A    int fd = ctx->fd;\0A\0A    ret = check_fd(fd, 1);\0A    if (ret != 0)