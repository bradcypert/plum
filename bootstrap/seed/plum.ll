ed with the\0A     * #MBEDTLS_ERR_SSL_WANT_WRITE error code.\0A     * We proceed to the next handshake step only when all data from the\0A     * previous one have been sent to the peer, thus we make sure that this is\0A     * the case here by calling `mbedtls_ssl_flush_output()`. The function may\0A     * return with the #MBEDTLS_ERR_SSL_WANT_WRITE error code in which case\0A     * we have to wait before to go ahead.\0A     * In the case of TLS 1.3, handshake step handlers do not send data to the\0A     * peer. Data are only sent here and through\0A     * `mbedtls_ssl_handle_pending_alert` in case an error that triggered an\0A     * alert occurred.\0A     */\0A    if ((ret = mbedtls_ssl_flush_output(ssl)) != 0) {\0A        return ret;\0A    }\0A\0A#if defined(MBEDTLS_SSL_PROTO_DTLS)\0A    if (ssl->conf->transport == MBEDTLS_SSL_TRANSPORT_DATAGRAM &&\0A        ssl->handshake->retransmit_state == MBEDTLS_SSL_RETRANS_SENDING) {\0A        if ((ret = mbedtls_ssl_flight_transmit(ssl)) != 0) {\0A            return ret;\0A        }\0A    }\0A#endif /* MBEDTLS_SSL_PROTO_DTLS */\0A\0A    return ret;\0A}\0A\0Aint mbedtls_ssl_handshake_step(mbedtls_ssl_context *ssl)\0A{\0A    int ret = MBEDTLS_ERR_ERROR_CORRUPTION_DETECTED;\0A\0A    if (ssl            == NULL                       ||\0A        ssl->conf      == NULL                       ||\0A        ssl->handshake == NULL                       ||\0A        ssl->state == MBEDTLS_SSL_HANDSHAKE_OVER) {\0A        return MBEDTLS_ERR_SSL_BAD_INPUT_DATA;\0A    }\0A\0A    ret = ssl_prepare_handshake_step(ssl);\0A    if (ret != 0) {\0A        return ret;\0A    }\0A\0A    ret = mbedtls_ssl_handle_pending_alert(ssl);\0A    if (ret != 0) {\0A        goto cleanup;\0A    }\0A\0A    /* If ssl->conf->endpoint is not one of MBEDTLS_SSL_IS_CLIENT or\0A     * MBEDTLS_SSL_IS_SERVER, this is the return code we give */\0A    ret = MBEDTLS_ERR_SSL_BAD_INPUT_DATA;\0A\0A#if defined(MBEDTLS_SSL_CLI_C)\0A    if (ssl->conf->endpoint == MBEDTLS_SSL_IS_CLI