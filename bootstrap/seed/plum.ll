@.str41550 = private global { i64, i64, [14 x i8] } { i64 -1, i64 13, [14 x i8] c"compat_shim.c\00" }
@.str41552 = private global { i64, i64, [10909 x i8] } { i64 -1, i64 10908, [10909 x i8] c"// Platform compatibility fills: C functions the generated runtime IR\0A// calls that do NOT exist under the same name on every target.\0A//\0A// The generated code depends on 47 C symbols. 45 of them are plain\0A// standard C and are present everywhere. This file exists for the two\0A// that are not, and it is deliberately the ONLY place that knows a\0A// target's name -- the runtime IR (`codegen/runtime.plum`) stays\0A// target-neutral, and the compiler emits no LLVM target triple at all,\0A// so `clang` targets whatever host it is running on.\0A//\0A// **Why fills rather than renames.** The obvious fix is to rename the\0A// call in the runtime to something neutral, e.g. `@plum_usable_size`.\0A// That cannot be the FIRST move, because of a bootstrap cycle:\0A// `bootstrap/seed/plum.ll` is a checked-in compiler shipped as IR, and\0A// that IR already contains the glibc name. On a Mac the seed would\0A// fail to LINK, so there would be no compiler with which to build the\0A// compiler that stops emitting the name. Defining the missing symbol\0A// here breaks the cycle with no seed regeneration: the existing seed\0A// links unchanged, on every platform, today.\0A//\0A// A rename remains available later as ordinary cleanup, on a normal\0A// seed-refresh cycle. It is not urgent, and this file is not a\0A// placeholder for it -- `dprintf` below is a genuine fill either way.\0A//\0A// On Linux this file is an empty translation unit apart from the\0A// placeholder below, which exists only because an entirely empty one\0A// is not strictly conforming C.\0A\0A// Keeps this a well-formed translation unit on platforms that need\0A// none of the fills. Never called.\0Aint plum_compat_placeholder(void);\0Aint plum_compat_placeholder(void) { return 0; }\0A\0A// Unicode case mapping for a single CODEPOINT.\0A//\0A// Two separate problems make this a shim rather than a direct call to\0A// `towupper`/`towlower` from the generated IR.\0A//\0A// **An ABI mismatch.** The IR declared `i32 @towupper(i32)`. That is\0A// right on Linux and macOS, where `wint_t` is 32 bits. On Windows\0A// `wint_t` is `unsigned short` -- 16 bits -- so the declaration was\0A// wrong there before any question of behaviour arose.\0A//\0A// **No usable locale.** MSYS2's MINGW64 environment links the legacy\0A// `msvcrt.dll`, which has no UTF-8 locale at all, so the `setlocale`\0A// call below cannot succeed there and `towupper` stays ASCII-only.\0A// Windows' own `CharUpperBuffW` needs no locale and is always present,\0A// so this sidesteps the question rather than depending on which CRT\0A// the toolchain happened to link.\0A//\0A// **Scope: the Basic Multilingual Plane.** Above U+FFFF a codepoint\0A// needs a surrogate pair, which `CharUpperBuffW` does not case-map;\0A// those pass through unchanged on Windows. Every cased character\0A// outside the BMP is in scripts (Deseret, Adlam, Vithkuqi) that\0A// nothing here targets, and passing through is the same thing this\0A// already does for uncased characters. A real, documented limit --\0A// Linux and macOS have no such restriction.\0A#if defined(_WIN32)\0A#include <windows.h>\0A\0Astatic int plum_case_map(int cp, int upper) {\0A    WCHAR w;\0A    if (cp < 0 || cp > 0xFFFF) return cp;\0A    w = (WCHAR)cp;\0A    if (upper) CharUpperBuffW(&w, 1); else CharLowerBuffW(&w, 1);\0A    return (int)w;\0A}\0A\0Aint plum_toupper_cp(int cp);\0Aint plum_tolower_cp(int cp);\0Aint plum_toupper_cp(int cp) { return plum_case_map(cp, 1); }\0Aint plum_tolower_cp(int cp) { return plum_case_map(cp, 0); }\0A\0A#else\0A#include <wctype.h>\0A\0Aint plum_toupper_cp(int cp);\0Aint plum_tolower_cp(int cp);\0Aint plum_toupper_cp(int cp) { return (int)towupper((wint_t)cp); }\0Aint plum_tolower_cp(int cp) { return (int)towlower((wint_t)cp); }\0A\0A#endif\0A\0A// `%.*g` with the exponent in the form C99 requires: a sign and AT\0A// LEAST two digits, no more than the value needs.\0A//\0A// Microsoft's CRT pads the exponent to three digits -- `1e-006` where\0A// every other platform prints `1e-06` -- which is a pre-C99 convention\0A// it keeps for compatibility. MinGW inherits it, because the plain\0A// `snprintf` a program links against is the CRT's.\0A//\0A// Normalising the RESULT is deliberate, in preference to defining\0A// `__USE_MINGW_ANSI_STDIO` and letting MinGW substitute a conforming\0A// printf. That macro would work, probably; this can be TESTED on\0A// Linux, by handing the normaliser a Microsoft-shaped string directly,\0A// and a fix that can be verified where it is written beats one that\0A// can only be verified by pushing.\0A//\0A// Float text is compared byte for byte by the corpus, and the same\0A// values must print the same way on every platform -- that is the\0A// whole reason `plum_fmt_double` retries at 15, 16 and 17 digits.\0A#include <stdio.h>\0A#include <string.h>\0A\0Astatic void plum_fix_exponent(char *buf) {\0A    char *e = strpbrk(buf, \22eE\22);\0A    char *digits;\0A    char *p;\0A    size_t len;\0A    size_t keep;\0A    if (e == NULL) return;\0A\0A    digits = e + 1;\0A    if (*digits == '+' || *digits == '-') digits++;\0A\0A    // Leading zeros to drop, keeping the last two digits at minimum.\0A    len = strlen(digits);\0A    p = digits;\0A    while (*p == '0') p++;\0A    keep = strlen(p);\0A    if (keep < 2) {\0A        // `e+5` is not a form the CRT produces, but if it ever did,\0A        // back up rather than emit a one-digit exponent.\0A        p = digits + (len > 2 ? len - 2 : 0);\0A        keep = strlen(p);\0A    }\0A    if (p != digits) memmove(digits, p, keep + 1);\0A}\0A\0Aint plum_format_g(char *buf, long long cap, int prec, double v);\0Aint plum_format_g(char *buf, long long cap, int prec, double v) {\0A    int n = snprintf(buf, (size_t)cap, \22%.*g\22, prec, v);\0A    if (n > 0 && (long long)n < cap) plum_fix_exponent(buf);\0A    return (int)strlen(buf);\0A}\0A\0A// Puts stdout and stderr into BINARY mode, so a `\5Cn` written by a Plum\0A// program stays one byte.\0A//\0A// Microsoft's CRT opens the standard streams in TEXT mode, which\0A// translates every `\5Cn` on the way out into `\5Cr\5Cn`. That is right for a\0A// Windows text editor and wrong for this language: Plum emits UTF-8\0A// bytes, its corpus compares program output byte for byte, and the same\0A// program must print the same bytes on every platform. A compiler that\0A// writes LLVM IR to stdout would also be corrupting it.\0A//\0A// The bug this fixes was invisible in every diff that showed it,\0A// because of a second effect stacked on the first: MSYS2's bash strips\0A// a trailing `\5Cr\5Cn` in command substitution, so the LAST line of any\0A// captured output came back clean while every earlier line kept its\0A// `\5Cr`. One-line fixtures therefore passed and multi-line ones failed\0A// with a diff whose lines looked identical. It took an `od -c` dump to\0A// see it at all.\0A//\0A// A no-op everywhere else: POSIX has no text mode to leave.\0A#if defined(_WIN32)\0A#include <fcntl.h>\0A#include <io.h>\0A#include <stdio.h>\0A\0Avoid plum_set_binary_stdio(void);\0Avoid plum_set_binary_stdio(void) {\0A    _setmode(_fileno(stdout), _O_BINARY);\0A    _setmode(_fileno(stderr), _O_BINARY);\0A}\0A#else\0Avoid plum_set_binary_stdio(void);\0Avoid plum_set_binary_stdio(void) { }\0A#endif\0A\0A// Which platform this binary is running on, as a lowercase word.\0A//\0A// Deliberately NOT named `plum_platform`: a Plum function called\0A// `platform` mangles to `@plum_platform`, and a collision between a\0A// runtime symbol and a mangled Plum name is a mistake this project has\0A// already made once (`@plum_print` against `print`).\0A//\0A// It exists because the compiler builds a `clang` command line in Plum\0A// code, where a C `#ifdef` cannot reach -- and the libraries a link\0A// needs are not the same everywhere. Returns a string literal with\0A// static storage; the caller copies it immediately.\0Aconst char *plum_host_platform(void);\0Aconst char *plum_host_platform(void) {\0A#if defined(_WIN32)\0A    return \22windows\22;\0A#elif defined(__APPLE__)\0A    return \22macos\22;\0A#else\0A    return \22linux\22;\0A#endif\0A}\0A\0A// Puts the process into a UTF-8 locale, so `towupper`/`towlower` map\0A// non-ASCII codepoints instead of passing them through.\0A//\0A// This was `setlocale(6, \22C.utf8\22)` emitted directly as IR until\0A// 2026-08-24, and it was wrong on macOS twice over -- silently, which\0A// is the worst way for a locale call to be wrong:\0A//\0A//   1. **`LC_ALL` is not 6 everywhere.** It is 6 on glibc and 0 on\0A//      BSD/Darwin, where 6 is `LC_MESSAGES`. The call therefore set the\0A//      wrong category and left `LC_CTYPE` alone. Emitting the constant\0A//      as a literal in IR is what made this possible; here the C\0A//      header supplies it, so it is right by construction on each\0A//      platform.\0A//   2. **`C.utf8` is a glibc locale name.** macOS does not have it, so\0A//      even with the right category the call would have failed and\0A//      changed nothing.\0A//\0A// The fallbacks matter for the same reason: there is no single locale\0A// name that exists everywhere. Each branch tries the spellings its\0A// platform actually ships, most specific first. If every one fails the\0A// process keeps the \22C\22 locale and ASCII case mapping still works --\0A// degraded, not broken.\0A#include <locale.h>\0A\0Avoid plum_set_utf8_locale(void);\0Avoid plum_set_utf8_locale(void) {\0A#if defined(_WIN32)\0A    // UCRT accepts the codepage-only form, which asks for UTF-8\0A    // without naming a language.\0A    if (setlocale(LC_ALL, \22.UTF-8\22) == NULL) setlocale(LC_ALL, \22en-US.UTF-8\22);\0A#elif defined(__APPLE__)\0A    if (setlocale(LC_ALL, \22C.UTF-8\22) == NULL)\0A        if (setlocale(LC_ALL, \22en_US.UTF-8\22) == NULL)\0A            setlocale(LC_ALL, \22UTF-8\22);\0A#else\0A    if (setlocale(LC_ALL, \22C.utf8\22) == NULL)\0A        if (setlocale(LC_ALL, \22C.UTF-8\22) == NULL)\0A            setlocale(LC_ALL, \22en_US.UTF-8\22);\0A#endif\0A}\0A\0A#if defined(__APPLE__)\0A\0A// `malloc_usable_size` is a glibc extension. Apple's libc spells the\0A// same operation `malloc_size`, in a different header. The runtime\0A// uses it to DERIVE an allocation's capacity rather than storing it\0A// (see `runtime.plum`'s array-growth comment), so the value must be\0A// the real usable size, not a guess -- which is exactly what\0A// `malloc_size` returns.\0A#include <malloc/malloc.h>\0A#include <stddef.h>\0A\0Asize_t malloc_usable_size(void *p);\0Asize_t malloc_usable_size(void *p) { return malloc_size(p); }\0A\0A#elif defined(_WIN32)\0A\0A// The MSVC and UCRT runtimes spell it `_msize`.\0A#include <malloc.h>\0A#include <stddef.h>\0A#include <stdarg.h>\0A#include <stdio.h>\0A#include <io.h>\0A\0Asize_t malloc_usable_size(void *p);\0Asize_t malloc_usable_size(void *p) { return _msize(p); }\0A\0A// `dprintf` is POSIX, absent from the Windows CRTs. The runtime calls\0A// it in exactly one place -- the allocation-statistics dump, always to\0A// fd 2 -- so routing it through `stderr` is faithful rather than an\0A// approximation. `vfprintf` is used instead of a `write` to a raw fd\0A// so the formatting is done by the CRT, as the caller expects.\0Aint dprintf(int fd, const char *fmt, ...);\0Aint dprintf(int fd, const char *fmt, ...) {\0A    va_list ap;\0A    int n;\0A    FILE *out = (fd == 2) ? stderr : stdout;\0A    va_start(ap, fmt);\0A    n = vfprintf(out, fmt, ap);\0A    va_end(ap);\0A    return n;\0A}\0A\0A#endif\0A\00" }
