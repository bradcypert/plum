@.str41267 = private global { i64, i64, [66562 x i8] } { i64 -1, i64 66561, [66562 x i8] c"/*\0A *  Multi-precision integer library\0A *\0A *  Copyright The Mbed TLS Contributors\0A *  SPDX-License-Identifier: Apache-2.0 OR GPL-2.0-or-later\0A */\0A\0A/*\0A *  The following sources were referenced in the design of this Multi-precision\0A *  Integer library:\0A *\0A *  [1] Handbook of Applied Cryptography - 1997\0A *      Menezes, van Oorschot and Vanstone\0A *\0A *  [2] Multi-Precision Math\0A *      Tom St Denis\0A *      https://github.com/libtom/libtommath/blob/develop/tommath.pdf\0A *\0A *  [3] GNU Multi-Precision Arithmetic Library\0A *      https://gmplib.org/manual/index.html\0A *\0A */\0A\0A#include \22common.h\22\0A\0A#if defined(MBEDTLS_BIGNUM_C)\0A\0A#include \22mbedtls/bignum.h\22\0A#include \22bignum_core.h\22\0A#include \22bignum_internal.h\22\0A#include \22bn_mul.h\22\0A#include \22mbedtls/platform_util.h\22\0A#include \22mbedtls/error.h\22\0A#include \22constant_time_internal.h\22\0A\0A#include <limits.h>\0A#include <string.h>\0A\0A#include \22mbedtls/platform.h\22\0A\0A\0A\0A/*\0A * Conditionally select an MPI sign in constant time.\0A * (MPI sign is the field s in mbedtls_mpi. It is unsigned short and only 1 and -1 are valid\0A * values.)\0A */\0Astatic inline signed short mbedtls_ct_mpi_sign_if(mbedtls_ct_condition_t cond,\0A                                                  signed short sign1, signed short sign2)\0A{\0A    return (signed short) mbedtls_ct_uint_if(cond, sign1 + 1, sign2 + 1) - 1;\0A}\0A\0A/*\0A * Compare signed values in constant time\0A */\0Aint mbedtls_mpi_lt_mpi_ct(const mbedtls_mpi *X,\0A                          const mbedtls_mpi *Y,\0A                          unsigned *ret)\0A{\0A    mbedtls_ct_condition_t different_sign, X_is_negative, Y_is_negative, result;\0A\0A    if (X->n != Y->n) {\0A        return MBEDTLS_ERR_MPI_BAD_INPUT_DATA;\0A    }\0A\0A    /*\0A     * Set N_is_negative to MBEDTLS_CT_FALSE if N >= 0, MBEDTLS_CT_TRUE if N < 0.\0A     * We know that N->s == 1 if N >= 0 and N->s == -1 if N < 0.\0A     */\0A    X_is_negative = mbedtls_ct_bool((X->s & 2) >> 1);\0A    Y_is_negative = mbedtls_ct_bool((Y->s & 2) >> 1);\0A\0A    /*\0A     * If the signs are different, then the positive operand is the bigger.\0A     * That is if X is negative (X_is_negative == 1), then X < Y is true and it\0A     * is false if X is positive (X_is_negative == 0).\0A     */\0A    different_sign = mbedtls_ct_bool_ne(X_is_negative, Y_is_negative); // true if different sign\0A    result = mbedtls_ct_bool_and(different_sign, X_is_negative);\0A\0A    /*\0A     * Assuming signs are the same, compare X and Y. We switch the comparison\0A     * order if they are negative so that we get the right result, regardles of\0A     * sign.\0A     */\0A\0A    /* This array is used to conditionally swap the pointers in const time */\0A    void * const p[2] = { X->p, Y->p };\0A    size_t i = mbedtls_ct_size_if_else_0(X_is_negative, 1);\0A    mbedtls_ct_condition_t lt = mbedtls_mpi_core_lt_ct(p[i], p[i ^ 1], X->n);\0A\0A    /*\0A     * Store in result iff the signs are the same (i.e., iff different_sign == false). If\0A     * the signs differ, result has already been set, so we don't change it.\0A     */\0A    result = mbedtls_ct_bool_or(result,\0A                                mbedtls_ct_bool_and(mbedtls_ct_bool_not(different_sign), lt));\0A\0A    *ret = mbedtls_ct_uint_if_else_0(result, 1);\0A\0A    return 0;\0A}\0A\0A/*\0A * Conditionally assign X = Y, without leaking information\0A * about whether the assignment was made or not.\0A * (Leaking information about the respective sizes of X and Y is ok however.)\0A */\0A#if defined(_MSC_VER) && defined(MBEDTLS_PLATFORM_IS_WINDOWS_ON_ARM64) && \5C\0A    (_MSC_FULL_VER < 193131103)\0A/*\0A * MSVC miscompiles this function if it's inlined prior to Visual Studio 2022 version 17.1. See:\0A * https://developercommunity.visualstudio.com/t/c-compiler-miscompiles-part-of-mbedtls-library-on/1646989\0A */\0A__declspec(noinline)\0A#endif\0Aint mbedtls_mpi_safe_cond_assign(mbedtls_mpi *X,\0A                                 const mbedtls_mpi *Y,\0A                                 unsigned char assign)\0A{\0A    int ret = 0;\0A\0A    MBEDTLS_MPI_CHK(mbedtls_mpi_grow(X, Y->n));\0A\0A    {\0A        mbedtls_ct_condition_t do_assign = mbedtls_ct_bool(assign);\0A\0A        X->s = mbedtls_ct_mpi_sign_if(do_assign, Y->s, X->s);\0A\0A        mbedtls_mpi_core_cond_assign(X->p, Y->p, Y->n, do_assign);\0A\0A        mbedtls_ct_condition_t do_not_assign = mbedtls_ct_bool_not(do_assign);\0A        for (size_t i = Y->n; i < X->n; i++) {\0A            X->p[i] = mbedtls_ct_mpi_uint_if_else_0(do_not_assign, X->p[i]);\0A        }\0A    }\0A\0Acleanup:\0A    return ret;\0A}\0A\0A/*\0A * Conditionally swap X and Y, without leaking information\0A * about whether the swap was made or not.\0A * Here it is not ok to simply swap the pointers, which would lead to\0A * different memory access patterns when X and Y are used afterwards.\0A */\0Aint mbedtls_mpi_safe_cond_swap(mbedtls_mpi *X,\0A                               mbedtls_mpi *Y,\0A                               unsigned char swap)\0A{\0A    int ret = 0;\0A    int s;\0A\0A    if (X == Y) {\0A        return 0;\0A    }\0A\0A    mbedtls_ct_condition_t do_swap = mbedtls_ct_bool(swap);\0A\0A    MBEDTLS_MPI_CHK(mbedtls_mpi_grow(X, Y->n));\0A    MBEDTLS_MPI_CHK(mbedtls_mpi_grow(Y, X->n));\0A\0A    s = X->s;\0A    X->s = mbedtls_ct_mpi_sign_if(do_swap, Y->s, X->s);\0A    Y->s = mbedtls_ct_mpi_sign_if(do_swap, s, Y->s);\0A\0A    mbedtls_mpi_core_cond_swap(X->p, Y->p, X->n, do_swap);\0A\0Acleanup:\0A    return ret;\0A}\0A\0A/* Implementation that should never be optimized out by the compiler */\0A#define mbedtls_mpi_zeroize_and_free(v, n) mbedtls_zeroize_and_free(v, ciL * (n))\0A\0A/*\0A * Initialize one MPI\0A */\0Avoid mbedtls_mpi_init(mbedtls_mpi *X)\0A{\0A    X->s = 1;\0A    X->n = 0;\0A    X->p = NULL;\0A}\0A\0A/*\0A * Unallocate one MPI\0A */\0Avoid mbedtls_mpi_free(mbedtls_mpi *X)\0A{\0A    if (X == NULL) {\0A        return;\0A    }\0A\0A    if (X->p != NULL) {\0A        mbedtls_mpi_zeroize_and_free(X->p, X->n);\0A    }\0A\0A    X->s = 1;\0A    X->n = 0;\0A    X->p = NULL;\0A}\0A\0A/*\0A * Enlarge to the specified number of limbs\0A */\0Aint mbedtls_mpi_grow(mbedtls_mpi *X, size_t nblimbs)\0A{\0A    mbedtls_mpi_uint *p;\0A\0A    if (nblimbs > MBEDTLS_MPI_MAX_LIMBS) {\0A        return MBEDTLS_ERR_MPI_ALLOC_FAILED;\0A    }\0A\0A    if (X->n < nblimbs) {\0A        if ((p = (mbedtls_mpi_uint *) mbedtls_calloc(nblimbs, ciL)) == NULL) {\0A            return MBEDTLS_ERR_MPI_ALLOC_FAILED;\0A        }\0A\0A        if (X->p != NULL) {\0A            memcpy(p, X->p, X->n * ciL);\0A            mbedtls_mpi_zeroize_and_free(X->p, X->n);\0A        }\0A\0A        /* nblimbs fits in n because we ensure that MBEDTLS_MPI_MAX_LIMBS\0A         * fits, and we've checked that nblimbs <= MBEDTLS_MPI_MAX_LIMBS. */\0A        X->n = (unsigned short) nblimbs;\0A        X->p = p;\0A    }\0A\0A    return 0;\0A}\0A\0A/*\0A * Resize down as much as possible,\0A * while keeping at least the specified number of limbs\0A */\0Aint mbedtls_mpi_shrink(mbedtls_mpi *X, size_t nblimbs)\0A{\0A    mbedtls_mpi_uint *p;\0A    size_t i;\0A\0A    if (nblimbs > MBEDTLS_MPI_MAX_LIMBS) {\0A        return MBEDTLS_ERR_MPI_ALLOC_FAILED;\0A    }\0A\0A    /* Actually resize up if there are currently fewer than nblimbs limbs. */\0A    if (X->n <= nblimbs) {\0A        return mbedtls_mpi_grow(X, nblimbs);\0A    }\0A    /* After this point, then X->n > nblimbs and in particular X->n > 0. */\0A\0A    for (i = X->n - 1; i > 0; i--) {\0A        if (X->p[i] != 0) {\0A            break;\0A        }\0A    }\0A    i++;\0A\0A    if (i < nblimbs) {\0A        i = nblimbs;\0A    }\0A\0A    if ((p = (mbedtls_mpi_uint *) mbedtls_calloc(i, ciL)) == NULL) {\0A        return MBEDTLS_ERR_MPI_ALLOC_FAILED;\0A    }\0A\0A    if (X->p != NULL) {\0A        memcpy(p, X->p, i * ciL);\0A        mbedtls_mpi_zeroize_and_free(X->p, X->n);\0A    }\0A\0A    /* i fits in n because we ensure that MBEDTLS_MPI_MAX_LIMBS\0A     * fits, and we've checked that i <= nblimbs <= MBEDTLS_MPI_MAX_LIMBS. */\0A    X->n = (unsigned short) i;\0A    X->p = p;\0A\0A    return 0;\0A}\0A\0A/* Resize X to have exactly n limbs and set it to 0. */\0Astatic int mbedtls_mpi_resize_clear(mbedtls_mpi *X, size_t limbs)\0A{\0A    if (limbs == 0) {\0A        mbedtls_mpi_free(X);\0A        return 0;\0A    } else if (X->n == limbs) {\0A        memset(X->p, 0, limbs * ciL);\0A        X->s = 1;\0A        return 0;\0A    } else {\0A        mbedtls_mpi_free(X);\0A        return mbedtls_mpi_grow(X, limbs);\0A    }\0A}\0A\0A/*\0A * Copy the contents of Y into X.\0A *\0A * This function is not constant-time. Leading zeros in Y may be removed.\0A *\0A * Ensure that X does not shrink. This is not guaranteed by the public API,\0A * but some code in the bignum module might still rely on this property.\0A */\0Aint mbedtls_mpi_copy(mbedtls_mpi *X, const mbedtls_mpi *Y)\0A{\0A    int ret = 0;\0A    size_t i;\0A\0A    if (X == Y) {\0A        return 0;\0A    }\0A\0A    if (Y->n == 0) {\0A        if (X->n != 0) {\0A            X->s = 1;\0A            memset(X->p, 0, X->n * ciL);\0A        }\0A        return 0;\0A    }\0A\0A    for (i = Y->n - 1; i > 0; i--) {\0A        if (Y->p[i] != 0) {\0A            break;\0A        }\0A    }\0A    i++;\0A\0A    X->s = Y->s;\0A\0A    if (X->n < i) {\0A        MBEDTLS_MPI_CHK(mbedtls_mpi_grow(X, i));\0A    } else {\0A        memset(X->p + i, 0, (X->n - i) * ciL);\0A    }\0A\0A    memcpy(X->p, Y->p, i * ciL);\0A\0Acleanup:\0A\0A    return ret;\0A}\0A\0A/*\0A * Swap the contents of X and Y\0A */\0Avoid mbedtls_mpi_swap(mbedtls_mpi *X, mbedtls_mpi *Y)\0A{\0A    mbedtls_mpi T;\0A\0A    memcpy(&T,  X, sizeof(mbedtls_mpi));\0A    memcpy(X,  Y, sizeof(mbedtls_mpi));\0A    memcpy(Y, &T, sizeof(mbedtls_mpi));\0A}\0A\0Astatic inline mbedtls_mpi_uint mpi_sint_abs(mbedtls_mpi_sint z)\0A{\0A    if (z >= 0) {\0A        return z;\0A    }\0A    /* Take care to handle the most negative value (-2^(biL-1)) correctly.\0A     * A naive -z would have undefined behavior.\0A     * Write this in a way that makes popular compilers happy (GCC, Clang,\0A     * MSVC). */\0A    return (mbedtls_mpi_uint) 0 - (mbedtls_mpi_uint) z;\0A}\0A\0A/* Convert x to a sign, i.e. to 1, if x is positive, or -1, if x is negative.\0A * This looks awkward but generates smaller code than (x < 0 ? -1 : 1) */\0A#define TO_SIGN(x) ((mbedtls_mpi_sint) (((mbedtls_mpi_uint) x) >> (biL - 1)) * -2 + 1)\0A\0A/*\0A * Set value from integer\0A */\0Aint mbedtls_mpi_lset(mbedtls_mpi *X, mbedtls_mpi_sint z)\0A{\0A    int ret = MBEDTLS_ERR_ERROR_CORRUPTION_DETECTED;\0A\0A    MBEDTLS_MPI_CHK(mbedtls_mpi_grow(X, 1));\0A    memset(X->p, 0, X->n * ciL);\0A\0A    X->p[0] = mpi_sint_abs(z);\0A    X->s    = TO_SIGN(z);\0A\0Acleanup:\0A\0A    return ret;\0A}\0A\0A/*\0A * Get a specific bit\0A */\0Aint mbedtls_mpi_get_bit(const mbedtls_mpi *X, size_t pos)\0A{\0A    if (X->n * biL <= pos) {\0A        return 0;\0A    }\0A\0A    return (X->p[pos / biL] >> (pos % biL)) & 0x01;\0A}\0A\0A/*\0A * Set a bit to a specific value of 0 or 1\0A */\0Aint mbedtls_mpi_set_bit(mbedtls_mpi *X, size_t pos, unsigned char val)\0A{\0A    int ret = 0;\0A    size_t off = pos / biL;\0A    size_t idx = pos % biL;\0A\0A    if (val != 0 && val != 1) {\0A        return MBEDTLS_ERR_MPI_BAD_INPUT_DATA;\0A    }\0A\0A    if (X->n * biL <= pos) {\0A        if (val == 0) {\0A            return 0;\0A        }\0A\0A        MBEDTLS_MPI_CHK(mbedtls_mpi_grow(X, off + 1));\0A    }\0A\0A    X->p[off] &= ~((mbedtls_mpi_uint) 0x01 << idx);\0A    X->p[off] |= (mbedtls_mpi_uint) val << idx;\0A\0Acleanup:\0A\0A    return ret;\0A}\0A\0A/*\0A * Return the number of less significant zero-bits\0A */\0Asize_t mbedtls_mpi_lsb(const mbedtls_mpi *X)\0A{\0A    size_t i;\0A\0A#if defined(__has_builtin)\0A#if (MBEDTLS_MPI_UINT_MAX == UINT_MAX) && __has_builtin(__builtin_ctz)\0A    #define mbedtls_mpi_uint_ctz __builtin_ctz\0A#elif (MBEDTLS_MPI_UINT_MAX == ULONG_MAX) && __has_builtin(__builtin_ctzl)\0A    #define mbedtls_mpi_uint_ctz __builtin_ctzl\0A#elif (MBEDTLS_MPI_UINT_MAX == ULLONG_MAX) && __has_builtin(__builtin_ctzll)\0A    #define mbedtls_mpi_uint_ctz __builtin_ctzll\0A#endif\0A#endif\0A\0A#if defined(mbedtls_mpi_uint_ctz)\0A    for (i = 0; i < X->n; i++) {\0A        if (X->p[i] != 0) {\0A            return i * biL + mbedtls_mpi_uint_ctz(X->p[i]);\0A        }\0A    }\0A#else\0A    size_t count = 0;\0A    for (i = 0; i < X->n; i++) {\0A        for (size_t j = 0; j < biL; j++, count++) {\0A            if (((X->p[i] >> j) & 1) != 0) {\0A                return count;\0A            }\0A        }\0A    }\0A#endif\0A\0A    return 0;\0A}\0A\0A/*\0A * Return the number of bits\0A */\0Asize_t mbedtls_mpi_bitlen(const mbedtls_mpi *X)\0A{\0A    return mbedtls_mpi_core_bitlen(X->p, X->n);\0A}\0A\0A/*\0A * Return the total size in bytes\0A */\0Asize_t mbedtls_mpi_size(const mbedtls_mpi *X)\0A{\0A    return (mbedtls_mpi_bitlen(X) + 7) >> 3;\0A}\0A\0A/*\0A * Convert an ASCII character to digit value\0A */\0Astatic int mpi_get_digit(mbedtls_mpi_uint *d, int radix, char c)\0A{\0A    *d = 255;\0A\0A    if (c >= 0x30 && c <= 0x39) {\0A        *d = c - 0x30;\0A    }\0A    if (c >= 0x41 && c <= 0x46) {\0A        *d = c - 0x37;\0A    }\0A    if (c >= 0x61 && c <= 0x66) {\0A        *d = c - 0x57;\0A    }\0A\0A    if (*d >= (mbedtls_mpi_uint) radix) {\0A        return MBEDTLS_ERR_MPI_INVALID_CHARACTER;\0A    }\0A\0A    return 0;\0A}\0A\0A/*\0A * Import from an ASCII string\0A */\0Aint mbedtls_mpi_read_string(mbedtls_mpi *X, int radix, const char *s)\0A{\0A    int ret = MBEDTLS_ERR_ERROR_CORRUPTION_DETECTED;\0A    size_t i, j, slen, n;\0A    int sign = 1;\0A    mbedtls_mpi_uint d;\0A    mbedtls_mpi T;\0A\0A    if (radix < 2 || radix > 16) {\0A        return MBEDTLS_ERR_MPI_BAD_INPUT_DATA;\0A    }\0A\0A    mbedtls_mpi_init(&T);\0A\0A    if (s[0] == 0) {\0A        mbedtls_mpi_free(X);\0A        return 0;\0A    }\0A\0A    if (s[0] == '-') {\0A        ++s;\0A        sign = -1;\0A    }\0A\0A    slen = strlen(s);\0A\0A    if (radix == 16) {\0A        if (slen > SIZE_MAX >> 2) {\0A            return MBEDTLS_ERR_MPI_BAD_INPUT_DATA;\0A        }\0A\0A        n = BITS_TO_LIMBS(slen << 2);\0A\0A        MBEDTLS_MPI_CHK(mbedtls_mpi_grow(X, n));\0A        MBEDTLS_MPI_CHK(mbedtls_mpi_lset(X, 0));\0A\0A        for (i = slen, j = 0; i > 0; i--, j++) {\0A            MBEDTLS_MPI_CHK(mpi_get_digit(&d, radix, s[i - 1]));\0A            X->p[j / (2 * ciL)] |= d << ((j % (2 * ciL)) << 2);\0A        }\0A    } else {\0A        MBEDTLS_MPI_CHK(mbedtls_mpi_lset(X, 0));\0A\0A        for (i = 0; i < slen; i++) {\0A            MBEDTLS_MPI_CHK(mpi_get_digit(&d, radix, s[i]));\0A            MBEDTLS_MPI_CHK(mbedtls_mpi_mul_int(&T, X, radix));\0A            MBEDTLS_MPI_CHK(mbedtls_mpi_add_int(X, &T, d));\0A        }\0A    }\0A\0A    if (sign < 0 && mbedtls_mpi_bitlen(X) != 0) {\0A        X->s = -1;\0A    }\0A\0Acleanup:\0A\0A    mbedtls_mpi_free(&T);\0A\0A    return ret;\0A}\0A\0A/*\0A * Helper to write the digits high-order first.\0A */\0Astatic int mpi_write_hlp(mbedtls_mpi *X, int radix,\0A                         char **p, const size_t buflen)\0A{\0A    int ret = MBEDTLS_ERR_ERROR_CORRUPTION_DETECTED;\0A    mbedtls_mpi_uint r;\0A    size_t length = 0;\0A    char *p_end = *p + buflen;\0A\0A    do {\0A        if (length >= buflen) {\0A            return MBEDTLS_ERR_MPI_BUFFER_TOO_SMALL;\0A        }\0A\0A        MBEDTLS_MPI_CHK(mbedtls_mpi_mod_int(&r, X, radix));\0A        MBEDTLS_MPI_CHK(mbedtls_mpi_div_int(X, NULL, X, radix));\0A        /*\0A         * Write the residue in the current position, as an ASCII character.\0A         */\0A        if (r < 0xA) {\0A            *(--p_end) = (char) ('0' + r);\0A        } else {\0A            *(--p_end) = (char) ('A' + (r - 0xA));\0A        }\0A\0A        length++;\0A    } while (mbedtls_mpi_cmp_int(X, 0) != 0);\0A\0A    memmove(*p, p_end, length);\0A    *p += length;\0A\0Acleanup:\0A\0A    return ret;\0A}\0A\0A/*\0A * Export into an ASCII string\0A */\0Aint mbedtls_mpi_write_string(const mbedtls_mpi *X, int radix,\0A                             char *buf, size_t buflen, size_t *olen)\0A{\0A    int ret = 0;\0A    size_t n;\0A    char *p;\0A    mbedtls_mpi T;\0A\0A    if (radix < 2 || radix > 16) {\0A        return MBEDTLS_ERR_MPI_BAD_INPUT_DATA;\0A    }\0A\0A    n = mbedtls_mpi_bitlen(X);   /* Number of bits necessary to present `n`. */\0A    if (radix >=  4) {\0A        n >>= 1;                 /* Number of 4-adic digits necessary to present\0A                                  * `n`. If radix > 4, this might be a strict\0A                                  * overapproximation of the number of\0A                                  * radix-adic digits needed to present `n`. */\0A    }\0A    if (radix >= 16) {\0A        n >>= 1;                 /* Number of hexadecimal digits necessary to\0A                                  * present `n`. */\0A\0A    }\0A    n += 1; /* Terminating null byte */\0A    n += 1; /* Compensate for the divisions above, which round down `n`\0A             * in case it's not even. */\0A    n += 1; /* Potential '-'-sign. */\0A    n += (n & 1);   /* Make n even to have enough space for hexadecimal writing,\0A                     * which always uses an even number of hex-digits. */\0A\0A    if (buflen < n) {\0A        *olen = n;\0A        return MBEDTLS_ERR_MPI_BUFFER_TOO_SMALL;\0A    }\0A\0A    p = buf;\0A    mbedtls_mpi_init(&T);\0A\0A    if (X->s == -1) {\0A        *p++ = '-';\0A        buflen--;\0A    }\0A\0A    if (radix == 16) {\0A        int c;\0A        size_t i, j, k;\0A\0A        for (i = X->n, k = 0; i > 0; i--) {\0A            for (j = ciL; j > 0; j--) {\0A                c = (X->p[i - 1] >> ((j - 1) << 3)) & 0xFF;\0A\0A                if (c == 0 && k == 0 && (i + j) != 2) {\0A                    c