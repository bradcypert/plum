 unsafe {\0A    let n = stdin_line_n();\0A    if n < 0 { Ok(None) }\0A    else { match Bytes.from_cstr(stdin_line_data(), n).as_string() {\0A        Ok(text) => Ok(Some(text)),\0A        Err(e) => Err(\22Os.read_stdin_line: \22.concat(e)),\0A    } }\0A}\0A\0A/// Up to `max` bytes, as `Bytes`. Stdin carries whatever was piped\0A/// into it, which is not always text. With a positive maximum, an EMPTY\0A/// result is end of stream; a SHORT one is data, because a pipe hands\0A/// over what it has rather than waiting to fill a buffer.\0A///\0A/// A nonpositive `max_len` returns empty bytes immediately, without\0A/// consuming input or checking for end of stream.\0A///\0A/// The bytes are copied into a Plum value before this returns, so the\0A/// result stays valid across later reads; the shim's own buffer is\0A/// reused and would not.\0Apub let read_stdin (max_len: Int): Result[Bytes, String] = unsafe {\0A    let n = stdin_bytes_n(max_len);\0A    if n < 0 { Err(\22Os.read_stdin: read failed\22) } else { Ok(Bytes.from_cstr(stdin_bytes_data(), n)) }\0A}\0A\0A/// Writes to standard error and flushes. NOT `println`, which is\0A/// stdout, since a diagnostic that lands in the same stream as the\0A/// program's output cannot be separated from it by whoever is reading.\0A/// No trailing newline is added; say so if you want one.\0Apub let write_stderr (s: String): Unit = unsafe { stderr_write(s.as_cstr()); () }\0A\0A/// --- Reading with a deadline (issue #7) ---\0A///\0A/// Three outcomes, and `Option` has already spent itself on two of\0A/// them: `read_stdin_line` uses `None` for end of stream, which is the\0A/// distinction the whole function exists for. A timed read has to say\0A/// \22a line\22, \22the input ended\22 or \22nothing arrived in time\22, so it says\0A/// so in a type with three names rather than nesting two `Option`s and\0A/// asking the reader to remember which is which.\0Apub enum Input[T] { Got(T), Eof, TimedOut }\0A\0A/// The timeout bounds the WHOLE CALL,