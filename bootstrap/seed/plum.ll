@.str40789 = private global { i64, i64, [4677 x i8] } { i64 -1, i64 4676, [4677 x i8] c"// Sleeping, and clocks with sub-second resolution (issue #19).\0A//\0A// `Time.now()` reads libc `time()` straight from the emitted runtime and\0A// needs no shim, because seconds since the epoch is the one thing every\0A// platform spells the same way. Everything here is where they stop\0A// agreeing: POSIX has `clock_gettime` and `nanosleep`, Windows has\0A// `GetSystemTimeAsFileTime`, `QueryPerformanceCounter` and `Sleep`, and\0A// the differences are in units, origins and resolutions rather than in\0A// shape.\0A//\0A// Same ABI conventions as its neighbours: every function takes and\0A// returns only `long long` (Plum `Int`).\0A//\0A// **Nanoseconds throughout**, which is what `Duration` stores. A signed\0A// 64-bit count of nanoseconds spans about 292 years either side of its\0A// origin -- far more than a duration needs, and enough for a wall clock\0A// until 2262. Go and Rust both made this trade; the alternative,\0A// milliseconds, buys range nobody wants and loses precision that timing\0A// code does.\0A\0A#include <stdint.h>\0A\0A#if defined(_WIN32)\0A#include <windows.h>\0A#else\0A#include <time.h>\0A#include <errno.h>\0A#endif\0A\0A// Wall clock: nanoseconds since the Unix epoch. Moves when the system\0A// clock is set, which is exactly why it must not be used for measuring\0A// elapsed time -- see `time_monotonic_nanos`.\0Along long time_now_nanos(void) {\0A#if defined(_WIN32)\0A    // A FILETIME counts 100-nanosecond ticks since 1601-01-01. The\0A    // constant is the number of such ticks between then and the Unix\0A    // epoch, and is exact rather than approximate.\0A    FILETIME ft;\0A    ULARGE_INTEGER t;\0A    GetSystemTimeAsFileTime(&ft);\0A    t.LowPart = ft.dwLowDateTime;\0A    t.HighPart = ft.dwHighDateTime;\0A    return (long long)((t.QuadPart - 116444736000000000ULL) * 100ULL);\0A#else\0A    struct timespec ts;\0A    if (clock_gettime(CLOCK_REALTIME, &ts) != 0) return 0;\0A    return (long long)ts.tv_sec * 1000000000LL + (long long)ts.tv_nsec;\0A#endif\0A}\0A\0A// Monotonic: nanoseconds since an unspecified origin, which never moves\0A// backwards and is unaffected by the system clock being set.\0A//\0A// The origin is deliberately meaningless. Two readings are only ever\0A// subtracted from each other, which is what `Time.since` does and the\0A// only thing an `Instant` is for -- so exposing the origin would invite\0A// treating it as a date, which it is not.\0Along long time_monotonic_nanos(void) {\0A#if defined(_WIN32)\0A    // `QueryPerformanceCounter` counts in units of its own frequency, so\0A    // the conversion has to divide before multiplying to avoid\0A    // overflowing at a high frequency -- seconds and remainder\0A    // separately, rather than ticks * 1e9 which overflows an int64 after\0A    // a couple of hours at 10MHz.\0A    LARGE_INTEGER freq, ticks;\0A    if (!QueryPerformanceFrequency(&freq) || freq.QuadPart == 0) return 0;\0A    QueryPerformanceCounter(&ticks);\0A    long long secs = (long long)(ticks.QuadPart / freq.QuadPart);\0A    long long rem = (long long)(ticks.QuadPart % freq.QuadPart);\0A    return secs * 1000000000LL + (rem * 1000000000LL) / (long long)freq.QuadPart;\0A#else\0A    struct timespec ts;\0A    if (clock_gettime(CLOCK_MONOTONIC, &ts) != 0) return 0;\0A    return (long long)ts.tv_sec * 1000000000LL + (long long)ts.tv_nsec;\0A#endif\0A}\0A\0A// Sleeps for at least `nanos`, and returns 0.\0A//\0A// AT LEAST, never at most: a sleep may overshoot by whatever the\0A// scheduler decides, and no caller can be promised otherwise. A\0A// non-positive duration returns immediately rather than yielding, so\0A// `sleep(zero)` is free.\0A//\0A// `nanosleep` is resumed across a signal with the remaining time rather\0A// than returning early. Without the loop, a program that installs any\0A// handler -- or runs under a profiler that uses timers -- gets a sleep\0A// that silently ends early, which is the kind of bug that only shows up\0A// on someone else's machine.\0A//\0A// Windows sleeps in whole MILLISECONDS, so a sub-millisecond request\0A// rounds up to one rather than down to zero: returning immediately from\0A// `sleep(micros(500))` would break a caller pacing a loop.\0Along long time_sleep_nanos(long long nanos) {\0A    if (nanos <= 0) return 0;\0A#if defined(_WIN32)\0A    {\0A        long long ms = nanos / 1000000LL;\0A        if (nanos % 1000000LL != 0) ms++;\0A        while (ms > 0) {\0A            DWORD chunk = ms > 0x7FFFFFFFLL ? 0x7FFFFFFF : (DWORD)ms;\0A            Sleep(chunk);\0A            ms -= (long long)chunk;\0A        }\0A        return 0;\0A    }\0A#else\0A    {\0A        struct timespec req;\0A        req.tv_sec = (time_t)(nanos / 1000000000LL);\0A        req.tv_nsec = (long)(nanos % 1000000000LL);\0A        while (nanosleep(&req, &req) != 0) {\0A            if (errno != EINTR) return -1;\0A        }\0A        return 0;\0A    }\0A#endif\0A}\0A\00" }
