@.str40800 = private global { i64, i64, [19419 x i8] } { i64 -1, i64 19418, [19419 x i8] c"/*\0A *  Message Processing Stack, Reader implementation\0A *\0A *  Copyright The Mbed TLS Contributors\0A *  SPDX-License-Identifier: Apache-2.0 OR GPL-2.0-or-later\0A */\0A\0A#include \22common.h\22\0A\0A#if defined(MBEDTLS_SSL_PROTO_TLS1_3)\0A\0A#include \22mps_reader.h\22\0A#include \22mps_common.h\22\0A#include \22mps_trace.h\22\0A\0A#include <string.h>\0A\0A#if defined(MBEDTLS_MPS_ENABLE_TRACE)\0Astatic int mbedtls_mps_trace_id = MBEDTLS_MPS_TRACE_BIT_READER;\0A#endif /* MBEDTLS_MPS_ENABLE_TRACE */\0A\0A/*\0A * GENERAL NOTE ON CODING STYLE\0A *\0A * The following code intentionally separates memory loads\0A * and stores from other operations (arithmetic or branches).\0A * This leads to the introduction of many local variables\0A * and significantly increases the C-code line count, but\0A * should not increase the size of generated assembly.\0A *\0A * The reason for this is twofold:\0A * (1) It will ease verification efforts using the VST\0A *     (Verified Software Toolchain)\0A *     whose program logic cannot directly reason\0A *     about instructions containing a load or store in\0A *     addition to other operations (e.g. *p = *q or\0A *     tmp = *p + 42).\0A * (2) Operating on local variables and writing the results\0A *     back to the target contexts on success only\0A *     allows to maintain structure invariants even\0A *     on failure - this in turn has two benefits:\0A *     (2.a) If for some reason an error code is not caught\0A *           and operation continues, functions are nonetheless\0A *           called with sane contexts, reducing the risk\0A *           of dangerous behavior.\0A *     (2.b) Randomized testing is easier if structures\0A *           remain intact even in the face of failing\0A *           and/or non-sensical calls.\0A *     Moreover, it might even reduce code-size because\0A *     the compiler need not write back temporary results\0A *     to memory in case of failure.\0A *\0A */\0A\0Astatic inline int mps_reader_is_accumulating(\0A    mbedtls_mps_reader const *rd)\0A{\0A    mbedtls_mps_size_t acc_remaining;\0A    if (rd->acc == NULL) {\0A        return 0;\0A    }\0A\0A    acc_remaining = rd->acc_share.acc_remaining;\0A    return acc_remaining > 0;\0A}\0A\0Astatic inline int mps_reader_is_producing(\0A    mbedtls_mps_reader const *rd)\0A{\0A    unsigned char *frag = rd->frag;\0A    return frag == NULL;\0A}\0A\0Astatic inline int mps_reader_is_consuming(\0A    mbedtls_mps_reader const *rd)\0A{\0A    return !mps_reader_is_producing(rd);\0A}\0A\0Astatic inline mbedtls_mps_size_t mps_reader_get_fragment_offset(\0A    mbedtls_mps_reader const *rd)\0A{\0A    unsigned char *acc = rd->acc;\0A    mbedtls_mps_size_t frag_offset;\0A\0A    if (acc == NULL) {\0A        return 0;\0A    }\0A\0A    frag_offset = rd->acc_share.frag_offset;\0A    return frag_offset;\0A}\0A\0Astatic inline mbedtls_mps_size_t mps_reader_serving_from_accumulator(\0A    mbedtls_mps_reader const *rd)\0A{\0A    mbedtls_mps_size_t frag_offset, end;\0A\0A    frag_offset = mps_reader_get_fragment_offset(rd);\0A    end = rd->end;\0A\0A    return end < frag_offset;\0A}\0A\0Astatic inline void mps_reader_zero(mbedtls_mps_reader *rd)\0A{\0A    /* A plain memset() would likely be more efficient,\0A     * but the current way of zeroing makes it harder\0A     * to overlook fields which should not be zero-initialized.\0A     * It's also more suitable for FV efforts since it\0A     * doesn't require reasoning about structs being\0A     * interpreted as unstructured binary blobs. */\0A    static mbedtls_mps_reader const zero =\0A    { .frag          = NULL,\0A      .frag_len      = 0,\0A      .commit        = 0,\0A      .end           = 0,\0A      .pending       = 0,\0A      .acc           = NULL,\0A      .acc_len       = 0,\0A      .acc_available = 0,\0A      .acc_share     = { .acc_remaining = 0 } };\0A    *rd = zero;\0A}\0A\0Aint mbedtls_mps_reader_init(mbedtls_mps_reader *rd,\0A                            unsigned char *acc,\0A                            mbedtls_mps_size_t acc_len)\0A{\0A    MBEDTLS_MPS_TRACE_INIT(\22mbedtls_mps_reader_init\22);\0A    MBEDTLS_MPS_TRACE(MBEDTLS_MPS_TRACE_TYPE_COMMENT,\0A                      \22* Accumulator size: %u bytes\22, (unsigned) acc_len);\0A    mps_reader_zero(rd);\0A    rd->acc = acc;\0A    rd->acc_len = acc_len;\0A    MBEDTLS_MPS_TRACE_RETURN(0);\0A}\0A\0Aint mbedtls_mps_reader_free(mbedtls_mps_reader *rd)\0A{\0A    MBEDTLS_MPS_TRACE_INIT(\22mbedtls_mps_reader_free\22);\0A    mps_reader_zero(rd);\0A    MBEDTLS_MPS_TRACE_RETURN(0);\0A}\0A\0Aint mbedtls_mps_reader_feed(mbedtls_mps_reader *rd,\0A                            unsigned char *new_frag,\0A                            mbedtls_mps_size_t new_frag_len)\0A{\0A    mbedtls_mps_size_t copy_to_acc;\0A    MBEDTLS_MPS_TRACE_INIT(\22mbedtls_mps_reader_feed\22);\0A    MBEDTLS_MPS_TRACE(MBEDTLS_MPS_TRACE_TYPE_COMMENT,\0A                      \22* Fragment length: %u bytes\22, (unsigned) new_frag_len);\0A\0A    if (new_frag == NULL) {\0A        MBEDTLS_MPS_TRACE_RETURN(MBEDTLS_ERR_MPS_READER_INVALID_ARG);\0A    }\0A\0A    MBEDTLS_MPS_STATE_VALIDATE_RAW(mps_reader_is_producing(\0A                                       rd),\0A                                   \22mbedtls_mps_reader_feed() requires reader to be in producing mode\22);\0A\0A    if (mps_reader_is_accumulating(rd)) {\0A        unsigned char *acc    = rd->acc;\0A        mbedtls_mps_size_t acc_remaining = rd->acc_share.acc_remaining;\0A        mbedtls_mps_size_t acc_available = rd->acc_available;\0A\0A        /* Skip over parts of the accumulator that have already been filled. */\0A        acc += acc_available;\0A\0A        copy_to_acc = acc_remaining;\0A        if (copy_to_acc > new_frag_len) {\0A            copy_to_acc = new_frag_len;\0A        }\0A\0A        /* Copy new contents to accumulator. */\0A        memcpy(acc, new_frag, copy_to_acc);\0A\0A        MBEDTLS_MPS_TRACE(MBEDTLS_MPS_TRACE_TYPE_COMMENT,\0A                          \22Copy new data of size %u of %u into accumulator at offset %u\22,\0A                          (unsigned) copy_to_acc, (unsigned) new_frag_len,\0A                          (unsigned) acc_available);\0A\0A        /* Check if, with the new fragment, we have enough data. */\0A        acc_remaining -= copy_to_acc;\0A        if (acc_remaining > 0) {\0A            /* We need to accumulate more data. Stay in producing mode. */\0A            acc_available += copy_to_acc;\0A            rd->acc_share.acc_remaining = acc_remaining;\0A            rd->acc_available = acc_available;\0A            MBEDTLS_MPS_TRACE_RETURN(MBEDTLS_ERR_MPS_READER_NEED_MORE);\0A        }\0A\0A        /* We have filled the accumulator: Move to consuming mode. */\0A\0A        MBEDTLS_MPS_TRACE(MBEDTLS_MPS_TRACE_TYPE_COMMENT,\0A                          \22Enough data available to serve user request\22);\0A\0A        /* Remember overlap of accumulator and fragment. */\0A        rd->acc_share.frag_offset = acc_available;\0A        acc_available += copy_to_acc;\0A        rd->acc_available = acc_available;\0A    } else { /* Not accumulating */\0A        rd->acc_share.frag_offset = 0;\0A    }\0A\0A    rd->frag = new_frag;\0A    rd->frag_len = new_frag_len;\0A    rd->commit = 0;\0A    rd->end = 0;\0A    MBEDTLS_MPS_TRACE_RETURN(0);\0A}\0A\0A\0Aint mbedtls_mps_reader_get(mbedtls_mps_reader *rd,\0A                           mbedtls_mps_size_t desired,\0A                           unsigned char **buffer,\0A                           mbedtls_mps_size_t *buflen)\0A{\0A    unsigned char *frag;\0A    mbedtls_mps_size_t frag_len, frag_offset, end, frag_fetched, frag_remaining;\0A    MBEDTLS_MPS_TRACE_INIT(\22mbedtls_mps_reader_get\22);\0A    MBEDTLS_MPS_TRACE(MBEDTLS_MPS_TRACE_TYPE_COMMENT,\0A                      \22* Bytes requested: %u\22, (unsigned) desired);\0A\0A    MBEDTLS_MPS_STATE_VALIDATE_RAW(mps_reader_is_consuming(\0A                                       rd),\0A                                   \22mbedtls_mps_reader_get() requires reader to be in consuming mode\22);\0A\0A    end = rd->end;\0A    frag_offset = mps_reader_get_fragment_offset(rd);\0A\0A    /* Check if we're still serving from the accumulator. */\0A    if (mps_reader_serving_from_accumulator(rd)) {\0A        /* Illustration of supported and unsupported cases:\0A         *\0A         * - Allowed #1\0A         *\0A         *                          +-----------------------------------+\0A         *                          |               frag                |\0A         *                          +-----------------------------------+\0A         *\0A         *             end end+desired\0A         *              |       |\0A         *        +-----v-------v-------------+\0A         *        |          acc              |\0A         *        +---------------------------+\0A         *                          |         |\0A         *                     frag_offset  acc_available\0A         *\0A         * - Allowed #2\0A         *\0A         *                          +-----------------------------------+\0A         *                          |               frag                |\0A         *                          +-----------------------------------+\0A         *\0A         *                  end          end+desired\0A         *                   |                |\0A         *        +----------v----------------v\0A         *        |          acc              |\0A         *        +---------------------------+\0A         *                          |         |\0A         *                   frag_offset acc_available\0A         *\0A         * - Not allowed #1 (could be served, but we don't actually use it):\0A         *\0A         *                      +-----------------------------------+\0A         *                      |               frag                |\0A         *                      +-----------------------------------+\0A         *\0A         *              end        end+desired\0A         *               |             |\0A         *        +------v-------------v------+\0A         *        |          acc              |\0A         *        +---------------------------+\0A         *                      |             |\0A         *                frag_offset   acc_available\0A         *\0A         *\0A         * - Not allowed #2 (can't be served with a contiguous buffer):\0A         *\0A         *                      +-----------------------------------+\0A         *                      |               frag                |\0A         *                      +-----------------------------------+\0A         *\0A         *              end                 end + desired\0A         *               |                        |\0A         *        +------v--------------------+   v\0A         *        |            acc            |\0A         *        +---------------------------+\0A         *                      |             |\0A         *                frag_offset   acc_available\0A         *\0A         * In case of Allowed #2 we're switching to serve from\0A         * `frag` starting from the next call to mbedtls_mps_reader_get().\0A         */\0A\0A        unsigned char *acc;\0A\0A        MBEDTLS_MPS_TRACE(MBEDTLS_MPS_TRACE_TYPE_COMMENT,\0A                          \22Serve the request from the accumulator\22);\0A        if (frag_offset - end < desired) {\0A            mbedtls_mps_size_t acc_available;\0A            acc_available = rd->acc_available;\0A            if (acc_available - end != desired) {\0A                /* It might be possible to serve some of these situations by\0A                 * making additional space in the accumulator, removing those\0A                 * parts that have already been committed.\0A                 * On the other hand, this brings additional complexity and\0A                 * enlarges the code size, while there doesn't seem to be a use\0A                 * case where we don't attempt exactly the same `get` calls when\0A                 * resuming on a reader than what we tried before pausing it.\0A                 * If we believe we adhere to this restricted usage throughout\0A                 * the library, this check is a good opportunity to\0A                 * validate this. */\0A                MBEDTLS_MPS_TRACE_RETURN(\0A                    MBEDTLS_ERR_MPS_READER_INCONSISTENT_REQUESTS);\0A            }\0A        }\0A\0A        acc = rd->acc;\0A        acc += end;\0A\0A        *buffer = acc;\0A        if (buflen != NULL) {\0A            *buflen = desired;\0A        }\0A\0A        end += desired;\0A        rd->end = end;\0A        rd->pending = 0;\0A\0A        MBEDTLS_MPS_TRACE_RETURN(0);\0A    }\0A\0A    /* Attempt to serve the request from the current fragment */\0A    MBEDTLS_MPS_TRACE(MBEDTLS_MPS_TRACE_TYPE_COMMENT,\0A                      \22Serve the request from the current fragment.\22);\0A\0A    frag_len = rd->frag_len;\0A    frag_fetched = end - frag_offset; /* The amount of data from the current\0A                                       * fragment that has already been passed\0A                                       * to the user. */\0A    frag_remaining = frag_len - frag_fetched; /* Remaining data in fragment */\0A\0A    /* Check if we can serve the read request from the fragment. */\0A    if (frag_remaining < desired) {\0A        MBEDTLS_MPS_TRACE(MBEDTLS_MPS_TRACE_TYPE_COMMENT,\0A                          \22There's not enough data in the current fragment \22\0A                          \22to serve the request.\22);\0A        /* There's not enough data in the current fragment,\0A         * so either just RETURN what we have or fail. */\0A        if (buflen == NULL) {\0A            if (frag_remaining > 0) {\0A                rd->pending = desired - frag_remaining;\0A                MBEDTLS_MPS_TRACE(MBEDTLS_MPS_TRACE_TYPE_COMMENT,\0A                                  \22Remember to collect %u bytes before re-opening\22,\0A                                  (unsigned) rd->pending);\0A            }\0A            MBEDTLS_MPS_TRACE_RETURN(MBEDTLS_ERR_MPS_READER_OUT_OF_DATA);\0A        }\0A\0A        desired = frag_remaining;\0A    }\0A\0A    /* There's enough data in the current fragment to serve the\0A     * (potentially modified) read request. */\0A\0A    frag = rd->frag;\0A    frag += frag_fetched;\0A\0A    *buffer = frag;\0A    if (buflen != NULL) {\0A        *buflen = desired;\0A    }\0A\0A    end += desired;\0A    rd->end = end;\0A    rd->pending = 0;\0A    MBEDTLS_MPS_TRACE_RETURN(0);\0A}\0A\0Aint mbedtls_mps_reader_commit(mbedtls_mps_reader *rd)\0A{\0A    mbedtls_mps_size_t end;\0A    MBEDTLS_MPS_TRACE_INIT(\22mbedtls_mps_reader_commit\22);\0A    MBEDTLS_MPS_STATE_VALIDATE_RAW(mps_reader_is_consuming(\0A                                       rd),\0A                                   \22mbedtls_mps_reader_commit() requires reader to be in consuming mode\22);\0A\0A    end = rd->end;\0A    rd->commit = end;\0A\0A    MBEDTLS_MPS_TRACE_RETURN(0);\0A}\0A\0Aint mbedtls_mps_reader_reclaim(mbedtls_mps_reader *rd,\0A                               int *paused)\0A{\0A    unsigned char *frag, *acc;\0A    mbedtls_mps_size_t pending, commit;\0A    mbedtls_mps_size_t acc_len, frag_offset, frag_len;\0A    MBEDTLS_MPS_TRACE_INIT(\22mbedtls_mps_reader_reclaim\22);\0A\0A    if (paused != NULL) {\0A        *paused = 0;\0A    }\0A\0A    MBEDTLS_MPS_STATE_VALIDATE_RAW(mps_reader_is_consuming(\0A                                       rd),\0A                                   \22mbedtls_mps_reader_reclaim() requires reader to be in consuming mode\22);\0A\0A    frag     = rd->frag;\0A    acc      = rd->acc;\0A    pending  = rd->pending;\0A    commit   = rd->commit;\0A    frag_len = rd->frag_len;\0A\0A    frag_offset = mps_reader_get_fragment_offset(rd);\0A\0A    if (pending == 0) {\0A        MBEDTLS_MPS_TRACE(MBEDTLS_MPS_TRACE_TYPE_COMMENT,\0A                          \22No unsatisfied read-request has been logged.\22);\0A\0A        /* Check if there's data left to be consumed. */\0A        if (commit < frag_offset || commit - frag_offset < frag_len) {\0A            MBEDTLS_MPS_TRACE(MBEDTLS_MPS_TRACE_TYPE_COMMENT,\0A                              \22There is data left to be consumed.\22);\0A            rd->end = commit;\0A            MBEDTLS_MPS_TRACE_RETURN(MBEDTLS_ERR_MPS_READER_DATA_LEFT);\0A        }\0A\0A        rd->acc_available = 0;\0A        rd->acc_share.acc_remaining = 0;\0A\0A        MBEDTLS_MPS_TRACE(MBEDTLS_MPS_TRACE_TYPE_COMMENT,\0A                          \22Fragment has been fully processed and committed.\22);\0A    } else {\0A        int overflow;\0A\0A        mbedtls_mps_size_t acc_backup_offset;\0A        mbedtls_mps_size_t acc_backup_len;\0A        mbedtls_mps_size_t frag_backup_offset;\0A        mbedtls_mps_size_t frag_backup_len;\0A\0A        mbedtls_mps_size_t backup_len;\0A        mbedtls_mps_size_t acc_len_needed;\0A\0A        MBEDTLS_MPS_TRACE(MBEDTLS_MPS_TRACE_TYPE_COMMENT,\0A                          \22There has been an unsatisfied read with %u bytes overhead.\22,\0A                          (unsigned) pending);\0A\0A        if (acc == NULL) {\0A            MBEDTLS_MPS_TRACE(MBEDTLS_MPS_TRACE_TYPE_COMMENT,\0A                              \22No accumulator present\22);\0A            MBEDTLS_MPS_TRACE_RETURN(\0A                MBEDTLS_ERR_MPS_READER_NEED_ACCUMULATOR);\0A        }\0A        acc_len = rd->acc_len;\0A\0A        /* Check if the upper layer has already fetched\0A         * and committed the contents of the accumulator. */\0A        if (commit < frag_offset) {\0A            /* No, accumulator is still being processed. */\0A            frag_backup_offset = 0;\0A            frag_backup_len = frag_len;\0A            acc_backup_offset = commit;\0A            acc_backup_len = frag_offset - commit;\0A        } else {\0A            /* Yes, the accumulator is already processed. */\0A            frag_backup_offset = commit - frag_offset;\0A            frag_backup_len = frag_len - frag_backup_offset;\0A            acc_backup_offset = 0;\0A            acc_backup_len = 0;\0A        }\0A\0A        backup_len = acc_backup_len + frag_backup_len;\0A        acc_len_needed = backup_len + pending;\0A\0A        overflow  = 0;\0A        overflow |= (backup_len     < acc_backup_len);\0A        overflow |= (acc_len_needed < backup_len);\0A\0A        if (overflow || acc_len < acc_len_needed) {\0A            /* Except for the different return code, we behave as if\0A             * there hadn't been a call to mbedtls_mps_reader_get()\0A             * since the last commit. */\0A            rd->end = commit;\0A            rd->pending = 0;\0A            MBEDTLS_MPS_TRACE(MBEDTLS_MPS_TRACE_TYPE_ERROR,\0A                              \22The accumulator is too small to handle the backup.\22);\0A            MBEDTLS_MPS_TRACE(MBEDTLS_MPS_TRACE_TYPE_ERROR,\0A                              \22* Size: %u\22, (unsigned) acc_len);\0A            MBEDTLS_MPS_TRACE(MBEDTLS_MPS_TRACE_TYPE_ERROR,\0A                              \22* Needed: %u (%u + %u)\22,\0A                              (unsigned) acc_len_needed,\0A                              (unsigned) backup_len, (unsigned) pending);\0A            MBEDTLS_MPS_TRACE_RETURN(\0A                MBEDTLS_ERR_MPS_READER_ACCUMULATOR_TOO_SMALL);\0A        }\0A\0A        MBEDTLS_MPS_TRACE(MBEDTLS_MPS_TRACE_TYPE_COMMENT,\0A                          \22Fragment backup: %u\22, (unsigned) frag_backup_len);\0A        MBEDTLS_MPS_TRACE(MBEDTLS_MPS_TRACE_TYPE_COMMENT,\0A                          \22Accumulator backup: %u\22, (unsigned) acc_backup_len);\0A\0A        /* Move uncommitted parts from the accumulator to the front\0A         * of the accumulator. */\0A        memmove(acc, acc + acc_backup_offset, acc_backup_len);\0A\0A        /* Copy uncommitted parts of the current fragment to the\0A         * accumulator. */\0A        memcpy(acc + acc_backup_len,\0A               frag + frag_backup_offset, frag_backup_len);\0A\0A        rd->acc_available = backup_len;\0A        rd->acc_share.acc_remaining = pending;\0A\0A        if (paused != NULL) {\0A            *paused = 1;\0A        }\0A    }\0A\0A    rd->frag     = NULL;\0A    rd->frag_len = 0;\0A\0A    rd->commit  = 0;\0A    rd->end     = 0;\0A    rd->pending = 0;\0A\0A    MBEDTLS_MPS_TRACE(MBEDTLS_MPS_TRACE_TYPE_COMMENT,\0A                      \22Final state: aa %u, al %u, ar %u\22,\0A                      (unsigned) rd->acc_available, (unsigned) rd->acc_len,\0A                      (unsigned) rd->acc_share.acc_remaining);\0A    MBEDTLS_MPS_TRACE_RETURN(0);\0A}\0A\0A#endif /* MBEDTLS_SSL_PROTO_TLS1_3 */\0A\00" }
