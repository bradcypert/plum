a).p;\0A}\0A\0A/** \5Cbrief Retrieve the user data in an SSL context as an integer.\0A *\0A * This is the value last set with mbedtls_ssl_set_user_data_n(), or\0A * \5Cc 0 if mbedtls_ssl_set_user_data_n() has not previously been\0A * called. The value is undefined if mbedtls_ssl_set_user_data_p() has\0A * been called without a subsequent call to mbedtls_ssl_set_user_data_n().\0A *\0A * \5Cparam ssl            The SSL context to modify.\0A * \5Creturn               The current value of the user data.\0A */\0Astatic inline uintptr_t mbedtls_ssl_get_user_data_n(\0A    mbedtls_ssl_context *ssl)\0A{\0A    return ssl->MBEDTLS_PRIVATE(user_data).n;\0A}\0A\0A#if defined(MBEDTLS_SSL_ASYNC_PRIVATE)\0A/**\0A * \5Cbrief           Configure asynchronous private key operation callbacks.\0A *\0A * \5Cparam conf              SSL configuration context\0A * \5Cparam f_async_sign      Callback to start a signature operation. See\0A *                          the description of ::mbedtls_ssl_async_sign_t\0A *                          for more information. This may be \5Cc NULL if the\0A *                          external processor does not support any signature\0A *                          operation; in this case the private key object\0A *                          associated with the certificate will be used.\0A * \5Cparam f_async_decrypt   Callback to start a decryption operation. See\0A *                          the description of ::mbedtls_ssl_async_decrypt_t\0A *                          for more information. This may be \5Cc NULL if the\0A *                          external processor does not support any decryption\0A *                          operation; in this case the private key object\0A *                          associated with the certificate will be used.\0A * \5Cparam f_async_resume    Callback to resume an asynchronous operation. See\0A *                          the description of ::mbedtls_ssl_async_resume_t\0A *                          for more information. Th