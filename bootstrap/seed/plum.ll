@.str44322 = private global { i64, i64, [8308 x i8] } { i64 -1, i64 8307, [8308 x i8] c"/**\0A * \5Cfile pkcs5.h\0A *\0A * \5Cbrief PKCS#5 functions\0A *\0A * \5Cauthor Mathias Olsson <mathias@kompetensum.com>\0A */\0A/*\0A *  Copyright The Mbed TLS Contributors\0A *  SPDX-License-Identifier: Apache-2.0 OR GPL-2.0-or-later\0A */\0A#ifndef MBEDTLS_PKCS5_H\0A#define MBEDTLS_PKCS5_H\0A\0A#include \22mbedtls/build_info.h\22\0A#include \22mbedtls/platform_util.h\22\0A\0A#include \22mbedtls/asn1.h\22\0A#include \22mbedtls/md.h\22\0A#include \22mbedtls/cipher.h\22\0A\0A#include <stddef.h>\0A#include <stdint.h>\0A\0A/** Bad input parameters to function. */\0A#define MBEDTLS_ERR_PKCS5_BAD_INPUT_DATA                  -0x2f80\0A/** Unexpected ASN.1 data. */\0A#define MBEDTLS_ERR_PKCS5_INVALID_FORMAT                  -0x2f00\0A/** Requested encryption or digest alg not available. */\0A#define MBEDTLS_ERR_PKCS5_FEATURE_UNAVAILABLE             -0x2e80\0A/** Given private key password does not allow for correct decryption. */\0A#define MBEDTLS_ERR_PKCS5_PASSWORD_MISMATCH               -0x2e00\0A\0A#define MBEDTLS_PKCS5_DECRYPT      MBEDTLS_DECRYPT\0A#define MBEDTLS_PKCS5_ENCRYPT      MBEDTLS_ENCRYPT\0A\0A#ifdef __cplusplus\0Aextern \22C\22 {\0A#endif\0A\0A#if defined(MBEDTLS_ASN1_PARSE_C) && defined(MBEDTLS_CIPHER_C)\0A\0A#if !defined(MBEDTLS_DEPRECATED_REMOVED)\0A/**\0A * \5Cbrief          PKCS#5 PBES2 function\0A *\0A * \5Cnote           When encrypting, #MBEDTLS_CIPHER_PADDING_PKCS7 must\0A *                 be enabled at compile time.\0A *\0A * \5Cdeprecated     This function is deprecated and will be removed in a\0A *                 future version of the library.\0A *                 Please use mbedtls_pkcs5_pbes2_ext() instead.\0A *\0A * \5Cwarning        When decrypting:\0A *                 - if #MBEDTLS_CIPHER_PADDING_PKCS7 is enabled at compile\0A *                   time, this function validates the CBC padding and returns\0A *                   #MBEDTLS_ERR_PKCS5_PASSWORD_MISMATCH if the padding is\0A *                   invalid. Note that this can help active adversaries\0A *                   attempting to brute-forcing the password. Note also that\0A *                   there is no guarantee that an invalid password will be\0A *                   detected (the chances of a valid padding with a random\0A *                   password are about 1/255).\0A *                 - if #MBEDTLS_CIPHER_PADDING_PKCS7 is disabled at compile\0A *                   time, this function does not validate the CBC padding.\0A *\0A * \5Cparam pbe_params the ASN.1 algorithm parameters\0A * \5Cparam mode       either #MBEDTLS_PKCS5_DECRYPT or #MBEDTLS_PKCS5_ENCRYPT\0A * \5Cparam pwd        password to use when generating key\0A * \5Cparam pwdlen     length of password\0A * \5Cparam data       data to process\0A * \5Cparam datalen    length of data\0A * \5Cparam output     Output buffer.\0A *                   On success, it contains the encrypted or decrypted data,\0A *                   possibly followed by the CBC padding.\0A *                   On failure, the content is indeterminate.\0A *                   For decryption, there must be enough room for \5Cp datalen\0A *                   bytes.\0A *                   For encryption, there must be enough room for\0A *                   \5Cp datalen + 1 bytes, rounded up to the block size of\0A *                   the block cipher identified by \5Cp pbe_params.\0A *\0A * \5Creturns        0 on success, or a MBEDTLS_ERR_XXX code if verification fails.\0A */\0Aint MBEDTLS_DEPRECATED mbedtls_pkcs5_pbes2(const mbedtls_asn1_buf *pbe_params, int mode,\0A                                           const unsigned char *pwd,  size_t pwdlen,\0A                                           const unsigned char *data, size_t datalen,\0A                                           unsigned char *output);\0A#endif /* MBEDTLS_DEPRECATED_REMOVED */\0A\0A#if defined(MBEDTLS_CIPHER_PADDING_PKCS7)\0A\0A/**\0A * \5Cbrief          PKCS#5 PBES2 function\0A *\0A * \5Cwarning        When decrypting:\0A *                 - This function validates the CBC padding and returns\0A *                   #MBEDTLS_ERR_PKCS5_PASSWORD_MISMATCH if the padding is\0A *                   invalid. Note that this can help active adversaries\0A *                   attempting to brute-forcing the password. Note also that\0A *                   there is no guarantee that an invalid password will be\0A *                   detected (the chances of a valid padding with a random\0A *                   password are about 1/255).\0A *\0A * \5Cparam pbe_params the ASN.1 algorithm parameters\0A * \5Cparam mode       either #MBEDTLS_PKCS5_DECRYPT or #MBEDTLS_PKCS5_ENCRYPT\0A * \5Cparam pwd        password to use when generating key\0A * \5Cparam pwdlen     length of password\0A * \5Cparam data       data to process\0A * \5Cparam datalen    length of data\0A * \5Cparam output     Output buffer.\0A *                   On success, it contains the decrypted data.\0A *                   On failure, the content is indetermidate.\0A *                   For decryption, there must be enough room for \5Cp datalen\0A *                   bytes.\0A *                   For encryption, there must be enough room for\0A *                   \5Cp datalen + 1 bytes, rounded up to the block size of\0A *                   the block cipher identified by \5Cp pbe_params.\0A * \5Cparam output_size size of output buffer.\0A *                    This must be big enough to accommodate for output plus\0A *                    padding data.\0A * \5Cparam output_len On success, length of actual data written to the output buffer.\0A *\0A * \5Creturns        0 on success, or a MBEDTLS_ERR_XXX code if parsing or decryption fails.\0A */\0Aint mbedtls_pkcs5_pbes2_ext(const mbedtls_asn1_buf *pbe_params, int mode,\0A                            const unsigned char *pwd,  size_t pwdlen,\0A                            const unsigned char *data, size_t datalen,\0A                            unsigned char *output, size_t output_size,\0A                            size_t *output_len);\0A\0A#endif /* MBEDTLS_CIPHER_PADDING_PKCS7 */\0A\0A#endif /* MBEDTLS_ASN1_PARSE_C && MBEDTLS_CIPHER_C*/\0A\0A/**\0A * \5Cbrief          PKCS#5 PBKDF2 using HMAC without using the HMAC context\0A *\0A * \5Cparam md_type  Hash algorithm used\0A * \5Cparam password Password to use when generating key\0A * \5Cparam plen     Length of password\0A * \5Cparam salt     Salt to use when generating key\0A * \5Cparam slen     Length of salt\0A * \5Cparam iteration_count       Iteration count\0A * \5Cparam key_length            Length of generated key in bytes\0A * \5Cparam output   Generated key. Must be at least as big as key_length\0A *\0A * \5Creturns        0 on success, or a MBEDTLS_ERR_XXX code if verification fails.\0A */\0Aint mbedtls_pkcs5_pbkdf2_hmac_ext(mbedtls_md_type_t md_type,\0A                                  const unsigned char *password,\0A                                  size_t plen, const unsigned char *salt, size_t slen,\0A                                  unsigned int iteration_count,\0A                                  uint32_t key_length, unsigned char *output);\0A\0A#if defined(MBEDTLS_MD_C)\0A#if !defined(MBEDTLS_DEPRECATED_REMOVED)\0A/**\0A * \5Cbrief          PKCS#5 PBKDF2 using HMAC\0A *\0A * \5Cdeprecated     Superseded by mbedtls_pkcs5_pbkdf2_hmac_ext().\0A *\0A * \5Cparam ctx      Generic HMAC context\0A * \5Cparam password Password to use when generating key\0A * \5Cparam plen     Length of password\0A * \5Cparam salt     Salt to use when generating key\0A * \5Cparam slen     Length of salt\0A * \5Cparam iteration_count       Iteration count\0A * \5Cparam key_length            Length of generated key in bytes\0A * \5Cparam output   Generated key. Must be at least as big as key_length\0A *\0A * \5Creturns        0 on success, or a MBEDTLS_ERR_XXX code if verification fails.\0A */\0Aint MBEDTLS_DEPRECATED mbedtls_pkcs5_pbkdf2_hmac(mbedtls_md_context_t *ctx,\0A                                                 const unsigned char *password,\0A                                                 size_t plen,\0A                                                 const unsigned char *salt,\0A                                                 size_t slen,\0A                                                 unsigned int iteration_count,\0A                                                 uint32_t key_length,\0A                                                 unsigned char *output);\0A#endif /* !MBEDTLS_DEPRECATED_REMOVED */\0A#endif /* MBEDTLS_MD_C */\0A#if defined(MBEDTLS_SELF_TEST)\0A\0A/**\0A * \5Cbrief          Checkup routine\0A *\0A * \5Creturn         0 if successful, or 1 if the test failed\0A */\0Aint mbedtls_pkcs5_self_test(int verbose);\0A\0A#endif /* MBEDTLS_SELF_TEST */\0A\0A#ifdef __cplusplus\0A}\0A#endif\0A\0A#endif /* pkcs5.h */\0A\00" }
