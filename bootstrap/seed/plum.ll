ce has no multi-value return, which is the same constraint\0A// `tcp_recv_n`/`tcp_recv_data` and `file_read_n`/`file_read_data` work\0A// around the same way.\0A//\0A// Thread-local rather than plain static: `net_shim.c` learned what a\0A// shared buffer costs when two threads use it at once, and a per-thread\0A// record is cheap enough not to repeat that.\0A#include <errno.h>\0A#include <time.h>\0A\0Astatic PLUM_OS_TLS long long stat_size = 0;\0Astatic PLUM_OS_TLS long long stat_mtime = 0;\0Astatic PLUM_OS_TLS long long stat_is_dir = 0;\0A\0A// 0 on success, -1 if the path cannot be stat'ed at all (most commonly\0A// because it is not there). Follows symlinks, matching `path_is_dir`.\0Along long os_stat_load(const char *path) {\0A    PlumPathStat st;\0A    if (plum_path_stat(path, &st) != 0) {\0A        stat_size = 0;\0A        stat_mtime = 0;\0A        stat_is_dir = 0;\0A        return -1;\0A    }\0A    stat_size = (long long)st.st_size;\0A    stat_mtime = (long long)st.st_mtime;\0A    stat_is_dir = S_ISDIR(st.st_mode) ? 1 : 0;\0A    return 0;\0A}\0A\0Along long os_stat_size(void) { return stat_size; }\0Along long os_stat_mtime(void) { return stat_mtime; }\0Along long os_stat_is_dir(void) { return stat_is_dir; }\0A\0A// Retention is best effort and runs after compilation. Only complete hash\0A// entries are eviction candidates; staging is protected by its live owner.\0A// Cache roots must be private to this host/user (not a shared network store).\0Atypedef struct { char *path; uint64_t bytes; time_t age; } plum_cache_entry;\0A\0Astatic int plum_cache_stat_private(const char *path, PlumPathStat *st) {\0A#if defined(_WIN32)\0A    DWORD attrs=plum_path_attributes(path);\0A    if (attrs == INVALID_FILE_ATTRIBUTES || (attrs & FILE_ATTRIBUTE_REPARSE_POINT)) return -1;\0A    return plum_path_stat(path,st);\0A#else\0A    return lstat(path,st);\0A#endif\0A}\0A\0Astatic uint64_t plum_cache_tree_bytes(const char *path) {\0A    PlumPathStat st;\0A    if (plum_cache_stat_private(path,&st) != 0) return 0;\0A    if (S_ISREG(st.st_mode)) return st.st_size > 0 ? (uint64_t)st.st_size : 0;\0A    if (!S_ISDIR(st.st_mode)) return 0;\0A    PlumPathDir *d=plum_path_opendir(path); if (!d) return 0;\0A    uint64_t bytes=0; const char *e; char child[PLUM_PATH_MAX];\0A    while ((e=plum_path_readdir(d)) != NULL) {\0A        if (!strcmp(e,\22.\22) || !strcmp(e,\22..\22)) continue;\0A        if (plum_join(child,sizeof(child),path,e) == 0) bytes+=plum_cache_tree_bytes(child);\0A    }\0A    plum_path_closedir(d); return bytes;\0A}\0A\0Astatic int plum_cache_owner_gone(const char *path) {\0A    char owner[PLUM_PATH_MAX]; long pid=0;\0A    if (plum_join(owner,sizeof(owner),path,\22.owner\22) != 0) return 0;\0A    FILE *f=plum_path_fopen(owner,\22r\22); if (!f) return 0;\0A    int parsed=fscanf(f,\22%ld\22,&pid); fclose(f);\0A    if (parsed != 1 || pid <= 0 || pid > 2147483647L) return 0;\0A#if defined(_WIN32)\0A    HANDLE process=OpenProcess(PROCESS_QUERY_LIMITED_INFORMATION,FALSE,(DWORD)pid);\0A    if (!process) return GetLastError() == ERROR_INVALID_PARAMETER;\0A    DWORD code=STILL_ACTIVE;\0A    int gone=GetExitCodeProcess(process,&code) && code != STILL_ACTIVE;\0A    CloseHandle(process); return gone;\0A#else\0A    return kill((pid_t)pid,0) != 0 && errno == ESRCH;\0A#endif\0A}\0A\0Astatic int plum_cache_oldest(const void *a, const void *b) {\0A    const plum_cache_entry *x=a, *y=b;\0A    if (x->age != y->age) return x->age < y->age ? -1 : 1;\0A    return strcmp(x->path,y->path);\0A}\0A\0Along long plum_cache_prune(const char *root, long long limit) {\0A    if (limit < 0) return 0;\0A    const char *kinds[]={\22ir\22,\22obj\22,\22shims\22,\22staging\22};\0A    plum_cache_entry *entries=NULL; size_t count=0, capacity=0;\0A    uint64_t total=0; long long removed=0; time_t now=time(NULL);\0A    char parent[PLUM_PATH_MAX], path[PLUM_PATH_MAX]; PlumPathStat st;\0A    for (size_t k=0;k<sizeof(kinds)/sizeof(kinds[0]);k++) {\0A        if (plum_join(parent,sizeof(parent),root,kinds[k]) != 0\0A            || plum_cache_stat_private(parent,&st) != 0 || !S_ISDIR(st.st_mode)) continue;\0A        PlumPathDir *d=plum_path_opendir(parent); if (!d) continue;\0A        const char *e;\0A        while ((e=plum_path_readdir(d)) != NULL) {\0A            if (plum_join(path,sizeof(path),parent,e) != 0\0A                || plum_cache_stat_private(path,&st) != 0 || !S_ISDIR(st.st_mode)) continue;\0A            // Keep recognizing legacy Windows pcb*.tmp staging entries too.\0A            if (!strncmp(e,\22.partial-\22,9) || !strncmp(e,\22pcb\22,3)) {\0A                if (now > st.st_mtime && now-st.st_mtime > 86400 && plum_cache_owner_gone(path)) {\0A                    if (plum_remove_tree(path) == 0) removed++;\0A                }\0A                continue;\0A            }\0A            if (strlen(e) != 64) continue;\0A            int hex=1;\0A            for (size_t i=0;i<64;i++) {\0A                if (!((e[i]>='0' && e[i]<='9')\0A                    || (e[i]>='a' && e[i]<='f'))) { hex=0; break; }\0A            }\0A            if (!hex) continue;\0A            if (count == capacity) {\0A                size_t next=capacity ? capacity*2 : 32;\0A                plum_cache_entry *grown=realloc(entries,next*sizeof(*entries));\0A                if (!grown) break;\0A                entries=grown; capacity=next;\0A            }\0A            char *saved=strdup(path); if (!saved) break;\0A            uint64_t bytes=plum_cache_tree_bytes(path);\0A            entries[count++]=(plum_cache_entry){saved,bytes,st.st_mtime}; total+=bytes;\0A        }\0A        plum_path_closedir(d);\0A    }\0A    if (count > 1) qsort(entries,count,sizeof(*entries),plum_cache_oldest);\0A    for (size_t i=0;i<count;i++) {\0A        if (total > (uint64_t)limit && plum_remove_tree(entries[i].path) == 0) {\0A            total=total >= entries[i].bytes ? total-entries[i].bytes : 0; removed++;\0A        }\0A        free(entries[i].path);\0A    }\0A    free(entries); return removed;\0A}\0A\0A// Three-way, and the third case is the point: 1 present, 0 absent, -1\0A// CANNOT SAY.\0A//\0A// \22Does this exist\22 and \22can I see whether this exists\22 are different\0A// questions, and collapsing them is how a permission error becomes a\0A// silent \22no\22. Only `ENOENT` and `ENOTDIR` mean absent -- the latter\0A// because a path under a non-directory (`a/b` where `a` is a file)\0A// cannot exist either. Anything else is a real failure to report.\0Along long os_path_exists(const char *path) {\0A    PlumPathStat st;\0A    if (plum_path_stat(path, &st) == 0) {\0A        return 1;\0A    }\0A    if (errno == ENOENT || errno == ENOTDIR) {\0A        return 0;\0A    }\0A    return -1;\0A}\0A\0A// --- Working directory (issue #17) ---\0A//\0A// Its own buffer rather than `plum_os_buf`: that one holds the result of\0A// `os_temp_dir`/`os_self_exe`, and a caller holding one of those across\0A// a `cwd()` would silently get the wrong string back.\0Astatic PLUM_OS_TLS char plum_cwd_buf[PLUM_PATH_MAX];\0A\0A// \22\22 on failure, never NULL -- a null `CStr` return is a hard runtime\0A// abort under Plum's FFI semantics, the same trade every other shim\0A// here makes.\0Aconst char *os_cwd(void) {\0A#if defined(_WIN32)\0A    wchar_t wide[PLUM_PATH_MAX];\0A    if (!_wgetcwd(wide, PLUM_PATH_MAX) || !plum_path_utf8(wide, plum_cwd_buf, sizeof(plum_cwd_buf))) plum_cwd_buf[0] = 0;\0A#else\0A    if (getcwd(plum_cwd_buf, sizeof(plum_cwd_buf)) == NULL) plum_cwd_buf[0] = '\5C0';\0A#endif\0A    return plum_cwd_buf;\0A}\0A\0Along long os_chdir(const char *path) {\0A#if defined(_WIN32)\0A    wchar_t *wide = plum_path_wide(path);\0A    if (!wide) return -1;\0A    int rc = _wchdir(wide);\0A    free(wide);\0A    return rc == 0 ? 0 : -1;\0A#else\0A    return chdir(path) == 0 ? 0 : -1;\0A#endif\0A}\0A\00" }
