nt type is Data OBJECT IDENTIFIER ::= {pkcs-7 1} */\0A#define MBEDTLS_OID_PKCS7_SIGNED_DATA                 MBEDTLS_OID_PKCS7 \22\5Cx02\22 /**< Content type is Signed Data OBJECT IDENTIFIER ::= {pkcs-7 2} */\0A#define MBEDTLS_OID_PKCS7_ENVELOPED_DATA              MBEDTLS_OID_PKCS7 \22\5Cx03\22 /**< Content type is Enveloped Data OBJECT IDENTIFIER ::= {pkcs-7 3} */\0A#define MBEDTLS_OID_PKCS7_SIGNED_AND_ENVELOPED_DATA   MBEDTLS_OID_PKCS7 \22\5Cx04\22 /**< Content type is Signed and Enveloped Data OBJECT IDENTIFIER ::= {pkcs-7 4} */\0A#define MBEDTLS_OID_PKCS7_DIGESTED_DATA               MBEDTLS_OID_PKCS7 \22\5Cx05\22 /**< Content type is Digested Data OBJECT IDENTIFIER ::= {pkcs-7 5} */\0A#define MBEDTLS_OID_PKCS7_ENCRYPTED_DATA              MBEDTLS_OID_PKCS7 \22\5Cx06\22 /**< Content type is Encrypted Data OBJECT IDENTIFIER ::= {pkcs-7 6} */\0A\0A/*\0A * PKCS#8 OIDs\0A */\0A#define MBEDTLS_OID_PKCS9_CSR_EXT_REQ           MBEDTLS_OID_PKCS9 \22\5Cx0e\22 /**< extensionRequest OBJECT IDENTIFIER ::= {pkcs-9 14} */\0A\0A/*\0A * PKCS#12 PBE OIDs\0A */\0A#define MBEDTLS_OID_PKCS12_PBE                      MBEDTLS_OID_PKCS12 \22\5Cx01\22 /**< pkcs-12PbeIds OBJECT IDENTIFIER ::= {pkcs-12 1} */\0A\0A#define MBEDTLS_OID_PKCS12_PBE_SHA1_DES3_EDE_CBC    MBEDTLS_OID_PKCS12_PBE \22\5Cx03\22 /**< pbeWithSHAAnd3-KeyTripleDES-CBC OBJECT IDENTIFIER ::= {pkcs-12PbeIds 3} */\0A#define MBEDTLS_OID_PKCS12_PBE_SHA1_DES2_EDE_CBC    MBEDTLS_OID_PKCS12_PBE \22\5Cx04\22 /**< pbeWithSHAAnd2-KeyTripleDES-CBC OBJECT IDENTIFIER ::= {pkcs-12PbeIds 4} */\0A#define MBEDTLS_OID_PKCS12_PBE_SHA1_RC2_128_CBC     MBEDTLS_OID_PKCS12_PBE \22\5Cx05\22 /**< pbeWithSHAAnd128BitRC2-CBC OBJECT IDENTIFIER ::= {pkcs-12PbeIds 5} */\0A#define MBEDTLS_OID_PKCS12_PBE_SHA1_RC2_40_CBC      MBEDTLS_OID_PKCS12_PBE \22\5Cx06\22 /**< pbeWithSHAAnd40BitRC2-CBC OBJECT IDENTIFIER ::= {pkcs-12PbeIds 6} */\0A\0A/*\0A * EC key algorithms from RFC 5480\0A */\0A\0A/* id-ecPublicKey OBJECT IDENTIFIER ::= {\0A *       iso(1) member-body(2) us(840) ansi-X9-62(10045) keyType(2) 1 } */\0A#define MBEDTLS_OID_EC_ALG_UNRESTRICTED         MBEDTLS_OID_ANSI_X9_62 \22\5Cx02\5C01\22\0A\0A/*   id-ecDH OBJECT IDENTIFIER ::= {\0A *     iso(1) identified-organization(3) certicom(132)\0A *     schemes(1) ecdh(12) } */\0A#define MBEDTLS_OID_EC_ALG_ECDH                 MBEDTLS_OID_CERTICOM \22\5Cx01\5Cx0c\22\0A\0A/*\0A * ECParameters namedCurve identifiers, from RFC 5480, RFC 5639, and SEC2\0A */\0A\0A/* secp192r1 OBJECT IDENTIFIER ::= {\0A *   iso(1) member-body(2) us(840) ansi-X9-62(10045) curves(3) prime(1) 1 } */\0A#define MBEDTLS_OID_EC_GRP_SECP192R1        MBEDTLS_OID_ANSI_X9_62 \22\5Cx03\5Cx01\5Cx01\22\0A\0A/* secp224r1 OBJECT IDENTIFIER ::= {\0A *   iso(1) identified-organization(3) certicom(132) curve(0) 33 } */\0A#define MBEDTLS_OID_EC_GRP_SECP224R1        MBEDTLS_OID_CERTICOM \22\5Cx00\5Cx21\22\0A\0A/* secp256r1 OBJECT IDENTIFIER ::= {\0A *   iso(1) member-body(2) us(840) ansi-X9-62(10045) curves(3) prime(1) 7 } */\0A#define MBEDTLS_OID_EC_GRP_SECP256R1        MBEDTLS_OID_ANSI_X9_62 \22\5Cx03\5Cx01\5Cx07\22\0A\0A/* secp384r1 OBJECT IDENTIFIER ::= {\0A *   iso(1) identified-organization(3) certicom(132) curve(0) 34 } */\0A#define MBEDTLS_OID_EC_GRP_SECP384R1        MBEDTLS_OID_CERTICOM \22\5Cx00\5Cx22\22\0A\0A/* secp521r1 OBJECT IDENTIFIER ::= {\0A *   iso(1) identified-organization(3) certicom(132) curve(0) 35 } */\0A#define MBEDTLS_OID_EC_GRP_SECP521R1        MBEDTLS_OID_CERTICOM \22\5Cx00\5Cx23\22\0A\0A/* secp192k1 OBJECT IDENTIFIER ::= {\0A *   iso(1) identified-organization(3) certicom(132) curve(0) 31 } */\0A#define MBEDTLS_OID_EC_GRP_SECP192K1        MBEDTLS_OID_CERTICOM \22\5Cx00\5Cx1f\22\0A\0A/* secp224k1 OBJECT IDENTIFIER ::= {\0A *   iso(1) identified-organization(3) certicom(132) curve(0) 32 } */\0A#define MBEDTLS_OID_EC_GRP_SECP224K1        MBEDTLS_OID_CERTICOM \22\5Cx00\5Cx20\22\0A\0A/* secp256k1 OBJECT IDENTIFIER ::= {\0A *   iso(1) identified-organization(3) certicom(132) curve(0) 10 } */\0A#define MBEDTLS_OID_EC_GRP_SECP256K1        MBEDTLS_OID_CERTICOM \22\5Cx00\5Cx0a\22\0A\0A/* RFC 5639 4.1\0A * ecStdCurvesAndGeneration OBJECT IDENTIFIER::= {iso(1)\0A * identified-organization(3) teletrust(36) algorithm(3) signature-\0A * algorithm(3) ecSign(2) 8}\0A * ellipticCurve OBJECT IDENTIFIER ::= {ecStdCurvesAndGeneration 1}\0A * versionOne OBJECT IDENTIFIER ::= {ellipticCurve 1} */\0A#define MBEDTLS_OID_EC_BRAINPOOL_V1         MBEDTLS_OID_TELETRUST \22\5Cx03\5Cx03\5Cx02\5Cx08\5Cx01\5Cx01\22\0A\0A/* brainpoolP256r1 OBJECT IDENTIFIER ::= {versionOne 7} */\0A#define MBEDTLS_OID_EC_GRP_BP256R1          MBEDTLS_OID_EC_BRAINPOOL_V1 \22\5Cx07\22\0A\0A/* brainpoolP384r1 OBJECT IDENTIFIER ::= {versionOne 11} */\0A#define MBEDTLS_OID_EC_GRP_BP384R1          MBEDTLS_OID_EC_BRAINPOOL_V1 \22\5Cx0B\22\0A\0A/* brainpoolP512r1 OBJECT IDENTIFIER ::= {versionOne 13} */\0A#define MBEDTLS_OID_EC_GRP_BP512R1          MBEDTLS_OID_EC_BRAINPOOL_V1 \22\5Cx0D\22\0A\0A/*\0A * SEC1 C.1\0A *\0A * prime-field OBJECT IDENTIFIER ::= { id-fieldType 1 }\0A * id-fieldType OBJECT IDENTIFIER ::= { ansi-X9-62 fieldType(1)}\0A */\0A#define MBEDTLS_OID_ANSI_X9_62_FIELD_TYPE   MBEDTLS_OID_ANSI_X9_62 \22\5Cx01\22\0A#define MBEDTLS_OID_ANSI_X9_62_PRIME_FIELD  MBEDTLS_OID_ANSI_X9_62_FIELD_TYPE \22\5Cx01\22\0A\0A/*\0A * ECDSA signature identifiers, from RFC 5480\0A */\0A#define MBEDTLS_OID_ANSI_X9_62_SIG          MBEDTLS_OID_ANSI_X9_62 \22\5Cx04\22 /* signatures(4) */\0A#define MBEDTLS_OID_ANSI_X9_62_SIG_SHA2     MBEDTLS_OID_ANSI_X9_62_SIG \22\5Cx03\22 /* ecdsa-with-SHA2(3) */\0A\0A/* ecdsa-with-SHA1 OBJECT IDENTIFIER ::= {\0A *   iso(1) member-body(2) us(840) ansi-X9-62(10045) signatures(4) 1 } */\0A#define MBEDTLS_OID_ECDSA_SHA1              MBEDTLS_OID_ANSI_X9_62_SIG \22\5Cx01\22\0A\0A/* ecdsa-with-SHA224 OBJECT IDENTIFIER ::= {\0A *   iso(1) member-body(2) us(840) ansi-X9-62(10045) signatures(4)\0A *   ecdsa-with-SHA2(3) 1 } */\0A#define MBEDTLS_OID_ECDSA_SHA224            MBEDTLS_OID_ANSI_X9_62_SIG_SHA2 \22\5Cx01\22\0A\0A/* ecdsa-with-SHA256 OBJECT IDENTIFIER ::= {\0A *   iso(1) member-body(2) us(840) ansi-X9-62(10045) signatures(4)\0A *   ecdsa-with-SHA2(3) 2 } */\0A#define MBEDTLS_OID_ECDSA_SHA256            MBEDTLS_OID_ANSI_X9_62_SIG_SHA2 \22\5Cx02\22\0A\0A/* ecdsa-with-SHA384 OBJECT IDENTIFIER ::= {\0A *   iso(1) member-body(2) us(840) ansi-X9-62(10045) signatures(4)\0A *   ecdsa-with-SHA2(3) 3 } */\0A#define MBEDTLS_OID_ECDSA_SHA384            MBEDTLS_OID_ANSI_X9_62_SIG_SHA2 \22\5Cx03\22\0A\0A/* ecdsa-with-SHA512 OBJECT IDENTIFIER ::= {\0A *   iso(1) member-body(2) us(840) ansi-X9-62(10045) signatures(4)\0A *   ecdsa-with-SHA2(3) 4 } */\0A#define MBEDTLS_OID_ECDSA_SHA512            MBEDTLS_OID_ANSI_X9_62_SIG_SHA2 \22\5Cx04\22\0A\0A/*\0A * EC key algorithms from RFC 8410\0A */\0A\0A#define MBEDTLS_OID_X25519                  MBEDTLS_OID_THAWTE \22\5Cx6e\22 /**< id-X25519    OBJECT IDENTIFIER ::= { 1 3 101 110 } */\0A#define MBEDTLS_OID_X448                    MBEDTLS_OID_THAWTE \22\5Cx6f\22 /**< id-X448      OBJECT IDENTIFIER ::= { 1 3 101 111 } */\0A#define MBEDTLS_OID_ED25519                 MBEDTLS_OID_THAWTE \22\5Cx70\22 /**< id-Ed25519   OBJECT IDENTIFIER ::= { 1 3 101 112 } */\0A#define MBEDTLS_OID_ED448                   MBEDTLS_OID_THAWTE \22\5Cx71\22 /**< id-Ed448     OBJECT IDENTIFIER ::= { 1 3 101 113 } */\0A\0A#ifdef __cplusplus\0Aextern \22C\22 {\0A#endif\0A\0A/**\0A * \5Cbrief Base OID descriptor structure\0A */\0Atypedef struct mbedtls_oid_descriptor_t {\0A    const char *MBEDTLS_PRIVATE(asn1);               /*!< OID ASN.1 representation       */\0A    size_t MBEDTLS_PRIVATE(asn1_len);                /*!< length of asn1                 */\0A#if !defined(MBEDTLS_X509_REMOVE_INFO)\0A    const char *MBEDTLS_PRIVATE(name);               /*!< official name (e.g. from RFC)  */\0A    const char *MBEDTLS_PRIVATE(description);        /*!< human friendly description     */\0A#endif\0A} mbedtls_oid_descriptor_t;\0A\0A/**\0A * \5Cbrief           Translate an ASN.1 OID into its numeric representation\0A *                  (e.g. \22\5Cx2A\5Cx86\5Cx48\5Cx86\5CxF7\5Cx0D\22 into \221.2.840.113549\22)\0A *\0A * \5Cparam buf       buffer to put representation in\0A * \5Cparam size      size of the buffer\0A * \5Cparam oid       OID to translate\0A *\0A * \5Creturn          Length of the string written (excluding final NULL) or\0A *                  MBEDTLS_ERR_OID_BUF_TOO_SMALL in case of error\0A */\0Aint mbedtls_oid_get_numeric_string(char *buf, size_t size, const mbedtls_asn1_buf *oid);\0A\0A/**\0A * \5Cbrief           Translate a string containing a dotted-decimal\0A *                  representation of an ASN.1 OID into its encoded form\0A *                  (e.g. \221.2.840.113549\22 into \22\5Cx2A\5Cx86\5Cx48\5Cx86\5CxF7\5Cx0D\22).\0A *                  On success, this function allocates oid->buf from the\0A *                  heap. It must be freed by the caller using mbedtls_free().\0A *\0A * \5Cparam oid       #mbedtls_asn1_buf to populate with the DER-encoded OID\0A * \5Cparam oid_str   string representation of the OID to parse\0A * \5Cparam size      length of the OID string, not including any null terminator\0A *\0A * \5Creturn          0 if successful\0A * \5Creturn          #MBEDTLS_ERR_ASN1_INVALID_DATA if \5Cp oid_str does not\0A *                  represent a valid OID\0A * \5Creturn          #MBEDTLS_ERR_ASN1_ALLOC_FAILED if the function fails to\0A *                  allocate oid->buf\0A */\0Aint mbedtls_oid_from_numeric_string(mbedtls_asn1_buf *oid, const char *oid_str, size_t size);\0A\0A/**\0A * \5Cbrief          Translate an X.509 extension OID into local values\0A *\0A * \5Cparam oid      OID to use\0A * \5Cparam ext_type place to store the extension type\0A *\0A * \5Creturn         0 if successful, or MBEDTLS_ERR_OID_NOT_FOUND\0A */\0Aint mbedtls_oid_get_x509_ext_type(const mbedtls_asn1_buf *oid, int *ext_type);\0A\0A/**\0A * \5Cbrief          Translate an X.509 attribute type OID into the short name\0A *                 (e.g. the OID for an X520 Common Name into \22CN\22)\0A *\0A * \5Cparam oid      OID to use\0A * \5Cparam short_name    place to store the string pointer\0A *\0A * \5Creturn         0 if successful, or MBEDTLS_ERR_OID_NOT_FOUND\0A */\0Aint mbedtls_oid_get_attr_short_name(const mbedtls_asn1_buf *oid, const char **short_name);\0A\0A/**\0A * \5Cbrief          Translate PublicKeyAlgorithm OID into pk_type\0A *\0A * \5Cparam oid      OID to use\0A * \5Cparam pk_alg   place to store public key algorithm\0A *\0A * \5Creturn         0 if successful, or MBEDTLS_ERR_OID_NOT_FOUND\0A */\0Aint mbedtls_oid_get_pk_alg(const mbedtls_asn1_buf *oid, mbedtls_pk_type_t *pk_alg);\0A\0A/**\0A * \5Cbrief          Translate pk_type into PublicKeyAlgorithm OID\0A *\0A * \5Cparam pk_alg   Public key type to look for\0A * \5Cparam oid      place to store ASN.1 OID string pointer\0A * \5Cparam olen     length of the OID\0A *\0A * \5Creturn         0 if successful, or MBEDTLS_ERR_OID_NOT_FOUND\0A */\0Aint mbedtls_oid_get_oid_by_pk_alg(mbedtls_pk_type_t pk_alg,\0A                                  const char **oid, size_t *olen);\0A\0A#if defined(MBEDTLS_PK_HAVE_ECC_KEYS)\0A/**\0A * \5Cbrief          Translate NamedCurve OID into an EC group identifier\0A *\0A * \5Cparam oid      OID to use\0A * \5Cparam grp_id   place to store group id\0A *\0A * \5Creturn         0 if successful, or MBEDTLS_ERR_OID_NOT_FOUND\0A */\0Aint mbedtls_oid_get_ec_grp(const mbedtls_asn1_buf *oid, mbedtls_ecp_group_id *grp_id);\0A\0A/**\0A * \5Cbrief          Translate EC group identifier into NamedCurve OID\0A *\0A * \5Cparam grp_id   EC group identifier\0A * \5Cparam oid      place to store ASN.1 OID string pointer\0A * \5Cparam olen     length of the OID\0A *\0A * \5Creturn         0 if successful, or MBEDTLS_ERR_OID_NOT_FOUND\0A */\0Aint mbedtls_oid_get_oid_by_ec_grp(mbedtls_ecp_group_id grp_id,\0A                                  const char **oid, size_t *olen);\0A\0A/**\0A * \5Cbrief          Translate AlgorithmIdentifier OID into an EC group identifier,\0A *                 for curves that are directly encoded at this level\0A *\0A * \5Cparam oid      OID to use\0A * \5Cparam grp_id   place to store group id\0A *\0A * \5Creturn         0 if successful, or MBEDTLS_ERR_OID_NOT_FOUND\0A */\0Aint mbedtls_oid_get_ec_grp_algid(const mbedtls_asn1_buf *oid, mbedtls_ecp_group_id *grp_id);\0A\0A/**\0A * \5Cbrief          Translate EC group identifier into AlgorithmIdentifier OID,\0A *                 for curves that are directly encoded at this level\0A *\0A * \5Cparam grp_id   EC group identifier\0A * \5Cparam oid      place to store ASN.1 OID string pointer\0A * \5Cparam olen     length of the OID\0A *\0A * \5Creturn         0 if successful, or MBEDTLS_ERR_OID_NOT_FOUND\0A */\0Aint mbedtls_oid_get_oid_by_ec_grp_algid(mbedtls_ecp_group_id grp_id,\0A                                        const char **oid, size_t *olen);\0A#endif /* MBEDTLS_PK_HAVE_ECC_KEYS */\0A\0A/**\0A * \5Cbrief          Translate SignatureAlgorithm OID into md_type and pk_type\0A *\0A * \5Cparam oid      OID to use\0A * \5Cparam md_alg   place to store message digest algorithm\0A * \5Cparam pk_alg   place to store public key algorithm\0A *\0A * \5Creturn         0 if successful, or MBEDTLS_ERR_OID_NOT_FOUND\0A */\0Aint mbedtls_oid_get_sig_alg(const mbedtls_asn1_buf *oid,\0A                            mbedtls_md_type_t *md_alg, mbedtls_pk_type_t *pk_alg);\0A\0A/**\0A * \5Cbrief          Translate SignatureAlgorithm OID into description\0A *\0A * \5Cparam oid      OID to use\0A * \5Cparam desc     place to store string pointer\0A *\0A * \5Creturn         0 if successful, or MBEDTLS_ERR_OID_NOT_FOUND\0A */\0Aint mbedtls_oid_get_sig_alg_desc(const mbedtls_asn1_buf *oid, const char **desc);\0A\0A/**\0A * \5Cbrief          Translate md_type and pk_type into SignatureAlgorithm OID\0A *\0A * \5Cparam md_alg   message digest algorithm\0A * \5Cparam pk_alg   public key algorithm\0A * \5Cparam oid      place to store ASN.1 OID string pointer\0A * \5Cparam olen     length of the OID\0A *\0A * \5Creturn         0 if successful, or MBEDTLS_ERR_OID_NOT_FOUND\0A */\0Aint mbedtls_oid_get_oid_by_sig_alg(mbedtls_pk_type_t pk_alg, mbedtls_md_type_t md_alg,\0A                                   const char **oid, size_t *olen);\0A\0A/**\0A * \5Cbrief          Translate hmac algorithm OID into md_type\0A *\0A * \5Cparam oid      OID to use\0A * \5Cparam md_hmac  place to store message hmac algorithm\0A *\0A * \5Creturn         0 if successful, or MBEDTLS_ERR_OID_NOT_FOUND\0A */\0Aint mbedtls_oid_get_md_hmac(const mbedtls_asn1_buf *oid, mbedtls_md_type_t *md_hmac);\0A\0A/**\0A * \5Cbrief          Translate hash algorithm OID into md_type\0A *\0A * \5Cparam oid      OID to use\0A * \5Cparam md_alg   place to store message digest algorithm\0A *\0A * \5Creturn         0 if successful, or MBEDTLS_ERR_OID_NOT_FOUND\0A */\0Aint mbedtls_oid_get_md_alg(const mbedtls_asn1_buf *oid, mbedtls_md_type_t *md_alg);\0A\0A#if !defined(MBEDTLS_X509_REMOVE_INFO)\0A/**\0A * \5Cbrief          Translate Extended Key Usage OID into description\0A *\0A * \5Cparam oid      OID to use\0A * \5Cparam desc     place to store string pointer\0A *\0A * \5Creturn         0 if successful, or MBEDTLS_ERR_OID_NOT_FOUND\0A */\0Aint mbedtls_oid_get_extended_key_usage(const mbedtls_asn1_buf *oid, const char **desc);\0A#endif\0A\0A/**\0A * \5Cbrief          Translate certificate policies OID into description\0A *\0A * \5Cparam oid      OID to use\0A * \5Cparam desc     place to store string pointer\0A *\0A * \5Creturn         0 if successful, or MBEDTLS_ERR_OID_NOT_FOUND\0A */\0Aint mbedtls_oid_get_certificate_policies(const mbedtls_asn1_buf *oid, const char **desc);\0A\0A/**\0A * \5Cbrief          Translate md_type into hash algorithm OID\0A *\0A * \5Cparam md_alg   message digest algorithm\0A * \5Cparam oid      place to store ASN.1 OID string pointer\0A * \5Cparam olen     length of the OID\0A *\0A * \5Creturn         0 if successful, or MBEDTLS_ERR_OID_NOT_FOUND\0A */\0Aint mbedtls_oid_get_oid_by_md(mbedtls_md_type_t md_alg, const char **oid, size_t *olen);\0A\0A#if defined(MBEDTLS_CIPHER_C)\0A/**\0A * \5Cbrief          Translate encryption algorithm OID into cipher_type\0A *\0A * \5Cparam oid           OID to use\0A * \5Cparam cipher_alg    place to store cipher algorithm\0A *\0A * \5Creturn         0 if successful, or MBEDTLS_ERR_OID_NOT_FOUND\0A */\0Aint mbedtls_oid_get_cipher_alg(const mbedtls_asn1_buf *oid, mbedtls_cipher_type_t *cipher_alg);\0A\0A#if defined(MBEDTLS_PKCS12_C)\0A/**\0A * \5Cbrief          Translate PKCS#12 PBE algorithm OID into md_type and\0A *                 cipher_type\0A *\0A * \5Cparam oid           OID to use\0A * \5Cparam md_alg        place to store message digest algorithm\0A * \5Cparam cipher_alg    place to store cipher algorithm\0A *\0A * \5Creturn         0 if successful, or MBEDTLS_ERR_OID_NOT_FOUND\0A */\0Aint mbedtls_oid_get_pkcs12_pbe_alg(const mbedtls_asn1_buf *oid, mbedtls_md_type_t *md_alg,\0A                                   mbedtls_cipher_type_t *cipher_alg);\0A#endif /* MBEDTLS_PKCS12_C */\0A#endif /* MBEDTLS_CIPHER_C */\0A\0A#ifdef __cplusplus\0A}\0A#endif\0A\0A#endif /* oid.h */\0A\00" }
