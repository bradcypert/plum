HANGE_ECDH_RSA:\0A        case MBEDTLS_KEY_EXCHANGE_ECDH_ECDSA:\0A        case MBEDTLS_KEY_EXCHANGE_RSA:\0A        case MBEDTLS_KEY_EXCHANGE_PSK:\0A        case MBEDTLS_KEY_EXCHANGE_RSA_PSK:\0A            return 1;\0A\0A        default:\0A            return 0;\0A    }\0A}\0A#endif /* MBEDTLS_KEY_EXCHANGE_SOME_NON_PFS_ENABLED */\0A\0A#if defined(MBEDTLS_KEY_EXCHANGE_SOME_ECDH_ENABLED)\0Astatic inline int mbedtls_ssl_ciphersuite_uses_ecdh(const mbedtls_ssl_ciphersuite_t *info)\0A{\0A    switch (info->MBEDTLS_PRIVATE(key_exchange)) {\0A        case MBEDTLS_KEY_EXCHANGE_ECDH_RSA:\0A        case MBEDTLS_KEY_EXCHANGE_ECDH_ECDSA:\0A            return 1;\0A\0A        default:\0A            return 0;\0A    }\0A}\0A#endif /* MBEDTLS_KEY_EXCHANGE_SOME_ECDH_ENABLED */\0A\0Astatic inline int mbedtls_ssl_ciphersuite_cert_req_allowed(const mbedtls_ssl_ciphersuite_t *info)\0A{\0A    switch (info->MBEDTLS_PRIVATE(key_exchange)) {\0A        case MBEDTLS_KEY_EXCHANGE_RSA:\0A        case MBEDTLS_KEY_EXCHANGE_DHE_RSA:\0A        case MBEDTLS_KEY_EXCHANGE_ECDH_RSA:\0A        case MBEDTLS_KEY_EXCHANGE_ECDHE_RSA:\0A        case MBEDTLS_KEY_EXCHANGE_ECDH_ECDSA:\0A        case MBEDTLS_KEY_EXCHANGE_ECDHE_ECDSA:\0A            return 1;\0A\0A        default:\0A            return 0;\0A    }\0A}\0A\0Astatic inline int mbedtls_ssl_ciphersuite_uses_srv_cert(const mbedtls_ssl_ciphersuite_t *info)\0A{\0A    switch (info->MBEDTLS_PRIVATE(key_exchange)) {\0A        case MBEDTLS_KEY_EXCHANGE_RSA:\0A        case MBEDTLS_KEY_EXCHANGE_RSA_PSK:\0A        case MBEDTLS_KEY_EXCHANGE_DHE_RSA:\0A        case MBEDTLS_KEY_EXCHANGE_ECDH_RSA:\0A        case MBEDTLS_KEY_EXCHANGE_ECDHE_RSA:\0A        case MBEDTLS_KEY_EXCHANGE_ECDH_ECDSA:\0A        case MBEDTLS_KEY_EXCHANGE_ECDHE_ECDSA:\0A            return 1;\0A\0A        default:\0A            return 0;\0A    }\0A}\0A\0A#if defined(MBEDTLS_KEY_EXCHANGE_SOME_DHE_ENABLED)\0Astatic inline int mbedtls_ssl_ciphersuite_uses_dhe(const mbedtls_ssl_ciphersuite_t *info)\0A{\0A    switch (info->MBEDTLS_PRIVATE(key_exchange)) {\0A        case MBEDTLS_KEY_EXCHANGE_DHE_RSA:\0A        case MBEDTLS_KEY_EXCHANGE_DHE_PSK:\0A            return 1;\0A\0A        default:\0A            return 0;\0A    }\0A}\0A#endif /* MBEDTLS_KEY_EXCHANGE_SOME_DHE_ENABLED) */\0A\0A#if defined(MBEDTLS_KEY_EXCHANGE_SOME_ECDHE_ENABLED)\0Astatic inline int mbedtls_ssl_ciphersuite_uses_ecdhe(const mbedtls_ssl_ciphersuite_t *info)\0A{\0A    switch (info->MBEDTLS_PRIVATE(key_exchange)) {\0A        case MBEDTLS_KEY_EXCHANGE_ECDHE_ECDSA:\0A        case MBEDTLS_KEY_EXCHANGE_ECDHE_RSA:\0A        case MBEDTLS_KEY_EXCHANGE_ECDHE_PSK:\0A            return 1;\0A\0A        default:\0A            return 0;\0A    }\0A}\0A#endif /* MBEDTLS_KEY_EXCHANGE_SOME_ECDHE_ENABLED) */\0A\0A#if defined(MBEDTLS_KEY_EXCHANGE_WITH_SERVER_SIGNATURE_ENABLED)\0Astatic inline int mbedtls_ssl_ciphersuite_uses_server_signature(\0A    const mbedtls_ssl_ciphersuite_t *info)\0A{\0A    switch (info->MBEDTLS_PRIVATE(key_exchange)) {\0A        case MBEDTLS_KEY_EXCHANGE_DHE_RSA:\0A        case MBEDTLS_KEY_EXCHANGE_ECDHE_RSA:\0A        case MBEDTLS_KEY_EXCHANGE_ECDHE_ECDSA:\0A            return 1;\0A\0A        default:\0A            return 0;\0A    }\0A}\0A#endif /* MBEDTLS_KEY_EXCHANGE_WITH_SERVER_SIGNATURE_ENABLED */\0A\0A#endif /* MBEDTLS_SSL_CIPHERSUITES_INTERNAL_H */\0A\00" }
