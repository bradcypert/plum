@.str41781 = private global { i64, i64, [4300 x i8] } { i64 -1, i64 4299, [4300 x i8] c"// Cleanup for handles the program never got to release (issue #1).\0A//\0A// A `handle` runs its `on_drop` when the value dies, which covers every\0A// ordinary exit: a normal return, a block ending, an `Err` being\0A// returned. Plum has no early `return`, so those really are all the\0A// paths a function can take -- except one.\0A//\0A// **A panic does not unwind.** `panic_raw` prints and calls `exit`, so\0A// nothing between the failure and the process ending runs, and a\0A// `Child` outlived its parent's panic and kept working. That is not\0A// untidiness the operating system tidies up: the OS reclaims file\0A// descriptors and memory, and does not kill your grandchildren, remove\0A// your lock file, or take the terminal out of raw mode.\0A//\0A// So live handles are tracked, and released on the way out.\0A//\0A// --- Why `atexit` and not a hook in `plum_panic` ---\0A//\0A// Every exit this needs to cover goes through `exit()`: `panic_raw`\0A// does, `Os.exit_with` does, and returning from `main` does. One\0A// `atexit` handler therefore covers all three, and covers any future\0A// path that exits properly, without the panic code knowing this exists.\0A//\0A// --- Why this is not the refcounting problem again ---\0A//\0A// Tracking every VALUE would be ruinous. Handles are not values in that\0A// sense: a program holds a few files, a socket, maybe a child. The\0A// registry is a flat array with a linear-scan removal, which is the\0A// right shape at that size and would be the wrong one at a million.\0A//\0A// **Not thread-safe**, matching every other blocking primitive in this\0A// directory. A handle opened on one thread and dropped on another is\0A// not something the language offers yet.\0A\0A#include <stdlib.h>\0A\0A#define PLUM_HANDLE_MAX 256\0A\0Atypedef struct {\0A    void *cell;                 // the refcounted cell, used as the identity\0A    void (*on_drop)(long long);\0A    long long value;            // the raw handle to hand back to `on_drop`\0A} PlumTrackedHandle;\0A\0Astatic PlumTrackedHandle plum_tracked[PLUM_HANDLE_MAX];\0Astatic int plum_tracked_n = 0;\0Astatic int plum_tracked_armed = 0;\0Astatic int plum_tracked_running = 0;\0A\0A// LIFO, the same order a scope releases in: a handle opened later may\0A// depend on one opened earlier, so the later one goes first.\0A//\0A// `plum_tracked_running` makes this non-reentrant. A cleanup that fails\0A// and calls `exit` itself would otherwise re-enter here and run every\0A// remaining handler a second time, which turns one bad cleanup into a\0A// double free.\0Astatic void plum_handle_cleanup_all(void) {\0A    if (plum_tracked_running) return;\0A    plum_tracked_running = 1;\0A    while (plum_tracked_n > 0) {\0A        PlumTrackedHandle *t = &plum_tracked[--plum_tracked_n];\0A        if (t->on_drop != NULL) t->on_drop(t->value);\0A    }\0A    plum_tracked_running = 0;\0A}\0A\0A// Called where a handle cell is built. `on_drop` is the function the\0A// `handle` declaration named.\0A//\0A// **Silently stops tracking past the cap.** Overflowing is not worth a\0A// crash: the program still works and still releases every handle on the\0A// ordinary paths, and only the panic path loses the ones past 256. A\0A// program holding more than 256 live handles is doing something this\0A// design did not anticipate, and should say so in a bug report rather\0A// than through an abort.\0Avoid plum_handle_track(void *cell, void (*on_drop)(long long), long long value) {\0A    if (!plum_tracked_armed) {\0A        atexit(plum_handle_cleanup_all);\0A        plum_tracked_armed = 1;\0A    }\0A    if (plum_tracked_n >= PLUM_HANDLE_MAX) return;\0A    plum_tracked[plum_tracked_n].cell = cell;\0A    plum_tracked[plum_tracked_n].on_drop = on_drop;\0A    plum_tracked[plum_tracked_n].value = value;\0A    plum_tracked_n++;\0A}\0A\0A// Called when a handle is released the ordinary way, BEFORE its\0A// `on_drop` runs -- so a cleanup that fails and exits does not find\0A// itself still registered and run twice.\0A//\0A// The scan runs backwards because releases are overwhelmingly LIFO, so\0A// the entry being removed is usually the last one.\0Avoid plum_handle_untrack(void *cell) {\0A    for (int i = plum_tracked_n - 1; i >= 0; i--) {\0A        if (plum_tracked[i].cell == cell) {\0A            for (int j = i; j < plum_tracked_n - 1; j++) {\0A                plum_tracked[j] = plum_tracked[j + 1];\0A            }\0A            plum_tracked_n--;\0A            return;\0A        }\0A    }\0A}\0A\00" }
