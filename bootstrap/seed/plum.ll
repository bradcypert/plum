mbedtls_ssl_handshake_set_state(ssl, MBEDTLS_SSL_SERVER_HELLO);\0A\0A                MBEDTLS_SSL_DEBUG_MSG(\0A                    1, (\22Switch to early data keys for outbound traffic\22));\0A                mbedtls_ssl_set_outbound_transform(\0A                    ssl, ssl->handshake->transform_earlydata);\0A                ssl->early_data_state = MBEDTLS_SSL_EARLY_DATA_STATE_CAN_WRITE;\0A            }\0A            break;\0A#endif /* MBEDTLS_SSL_EARLY_DATA */\0A#endif /* MBEDTLS_SSL_TLS1_3_COMPATIBILITY_MODE */\0A\0A#if defined(MBEDTLS_SSL_SESSION_TICKETS)\0A        case MBEDTLS_SSL_TLS1_3_NEW_SESSION_TICKET:\0A            ret = ssl_tls13_process_new_session_ticket(ssl);\0A            break;\0A#endif /* MBEDTLS_SSL_SESSION_TICKETS */\0A\0A        default:\0A            MBEDTLS_SSL_DEBUG_MSG(1, (\22invalid state %d\22, ssl->state));\0A            return MBEDTLS_ERR_SSL_BAD_INPUT_DATA;\0A    }\0A\0A    return ret;\0A}\0A\0A#endif /* MBEDTLS_SSL_CLI_C && MBEDTLS_SSL_PROTO_TLS1_3 */\0A\00" }
