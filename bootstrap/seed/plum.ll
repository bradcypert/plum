@.str40742 = private global { i64, i64, [16557 x i8] } { i64 -1, i64 16556, [16557 x i8] c"/**\0A * \5Cfile asn1write.h\0A *\0A * \5Cbrief ASN.1 buffer writing functionality\0A */\0A/*\0A *  Copyright The Mbed TLS Contributors\0A *  SPDX-License-Identifier: Apache-2.0 OR GPL-2.0-or-later\0A */\0A#ifndef MBEDTLS_ASN1_WRITE_H\0A#define MBEDTLS_ASN1_WRITE_H\0A\0A#include \22mbedtls/build_info.h\22\0A\0A#include \22mbedtls/asn1.h\22\0A\0A#define MBEDTLS_ASN1_CHK_ADD(g, f)                      \5C\0A    do                                                  \5C\0A    {                                                   \5C\0A        if ((ret = (f)) < 0)                         \5C\0A        return ret;                              \5C\0A        else                                            \5C\0A        (g) += ret;                                 \5C\0A    } while (0)\0A\0A#define MBEDTLS_ASN1_CHK_CLEANUP_ADD(g, f)                      \5C\0A    do                                                  \5C\0A    {                                                   \5C\0A        if ((ret = (f)) < 0)                         \5C\0A        goto cleanup;                              \5C\0A        else                                            \5C\0A        (g) += ret;                                 \5C\0A    } while (0)\0A\0A#ifdef __cplusplus\0Aextern \22C\22 {\0A#endif\0A\0A#if defined(MBEDTLS_ASN1_WRITE_C) || defined(MBEDTLS_X509_USE_C) || \5C\0A    defined(MBEDTLS_PSA_UTIL_HAVE_ECDSA)\0A/**\0A * \5Cbrief           Write a length field in ASN.1 format.\0A *\0A * \5Cnote            This function works backwards in data buffer.\0A *\0A * \5Cparam p         The reference to the current position pointer.\0A * \5Cparam start     The start of the buffer, for bounds-checking.\0A * \5Cparam len       The length value to write.\0A *\0A * \5Creturn          The number of bytes written to \5Cp p on success.\0A * \5Creturn          A negative \5Cc MBEDTLS_ERR_ASN1_XXX error code on failure.\0A */\0Aint mbedtls_asn1_write_len(unsigned char **p, const unsigned char *start,\0A                           size_t len);\0A/**\0A * \5Cbrief           Write an ASN.1 tag in ASN.1 format.\0A *\0A * \5Cnote            This function works backwards in data buffer.\0A *\0A * \5Cparam p         The reference to the current position pointer.\0A * \5Cparam start     The start of the buffer, for bounds-checking.\0A * \5Cparam tag       The tag to write.\0A *\0A * \5Creturn          The number of bytes written to \5Cp p on success.\0A * \5Creturn          A negative \5Cc MBEDTLS_ERR_ASN1_XXX error code on failure.\0A */\0Aint mbedtls_asn1_write_tag(unsigned char **p, const unsigned char *start,\0A                           unsigned char tag);\0A#endif /* MBEDTLS_ASN1_WRITE_C || MBEDTLS_X509_USE_C || MBEDTLS_PSA_UTIL_HAVE_ECDSA*/\0A\0A#if defined(MBEDTLS_ASN1_WRITE_C)\0A/**\0A * \5Cbrief           Write raw buffer data.\0A *\0A * \5Cnote            This function works backwards in data buffer.\0A *\0A * \5Cparam p         The reference to the current position pointer.\0A * \5Cparam start     The start of the buffer, for bounds-checking.\0A * \5Cparam buf       The data buffer to write.\0A * \5Cparam size      The length of the data buffer.\0A *\0A * \5Creturn          The number of bytes written to \5Cp p on success.\0A * \5Creturn          A negative \5Cc MBEDTLS_ERR_ASN1_XXX error code on failure.\0A */\0Aint mbedtls_asn1_write_raw_buffer(unsigned char **p, const unsigned char *start,\0A                                  const unsigned char *buf, size_t size);\0A\0A#if defined(MBEDTLS_BIGNUM_C)\0A/**\0A * \5Cbrief           Write an arbitrary-precision number (#MBEDTLS_ASN1_INTEGER)\0A *                  in ASN.1 format.\0A *\0A * \5Cnote            This function works backwards in data buffer.\0A *\0A * \5Cparam p         The reference to the current position pointer.\0A * \5Cparam start     The start of the buffer, for bounds-checking.\0A * \5Cparam X         The MPI to write.\0A *                  It must be non-negative.\0A *\0A * \5Creturn          The number of bytes written to \5Cp p on success.\0A * \5Creturn          A negative \5Cc MBEDTLS_ERR_ASN1_XXX error code on failure.\0A */\0Aint mbedtls_asn1_write_mpi(unsigned char **p, const unsigned char *start,\0A                           const mbedtls_mpi *X);\0A#endif /* MBEDTLS_BIGNUM_C */\0A\0A/**\0A * \5Cbrief           Write a NULL tag (#MBEDTLS_ASN1_NULL) with zero data\0A *                  in ASN.1 format.\0A *\0A * \5Cnote            This function works backwards in data buffer.\0A *\0A * \5Cparam p         The reference to the current position pointer.\0A * \5Cparam start     The start of the buffer, for bounds-checking.\0A *\0A * \5Creturn          The number of bytes written to \5Cp p on success.\0A * \5Creturn          A negative \5Cc MBEDTLS_ERR_ASN1_XXX error code on failure.\0A */\0Aint mbedtls_asn1_write_null(unsigned char **p, const unsigned char *start);\0A\0A/**\0A * \5Cbrief           Write an OID tag (#MBEDTLS_ASN1_OID) and data\0A *                  in ASN.1 format.\0A *\0A * \5Cnote            This function works backwards in data buffer.\0A *\0A * \5Cparam p         The reference to the current position pointer.\0A * \5Cparam start     The start of the buffer, for bounds-checking.\0A * \5Cparam oid       The OID to write.\0A * \5Cparam oid_len   The length of the OID.\0A *\0A * \5Creturn          The number of bytes written to \5Cp p on success.\0A * \5Creturn          A negative \5Cc MBEDTLS_ERR_ASN1_XXX error code on failure.\0A */\0Aint mbedtls_asn1_write_oid(unsigned char **p, const unsigned char *start,\0A                           const char *oid, size_t oid_len);\0A\0A/**\0A * \5Cbrief           Write an AlgorithmIdentifier sequence in ASN.1 format.\0A *\0A * \5Cnote            This function works backwards in data buffer.\0A *\0A * \5Cparam p         The reference to the current position pointer.\0A * \5Cparam start     The start of the buffer, for bounds-checking.\0A * \5Cparam oid       The OID of the algorithm to write.\0A * \5Cparam oid_len   The length of the algorithm's OID.\0A * \5Cparam par_len   The length of the parameters, which must be already written.\0A *                  If 0, NULL parameters are added\0A *\0A * \5Creturn          The number of bytes written to \5Cp p on success.\0A * \5Creturn          A negative \5Cc MBEDTLS_ERR_ASN1_XXX error code on failure.\0A */\0Aint mbedtls_asn1_write_algorithm_identifier(unsigned char **p,\0A                                            const unsigned char *start,\0A                                            const char *oid, size_t oid_len,\0A                                            size_t par_len);\0A\0A/**\0A * \5Cbrief           Write an AlgorithmIdentifier sequence in ASN.1 format.\0A *\0A * \5Cnote            This function works backwards in data buffer.\0A *\0A * \5Cparam p         The reference to the current position pointer.\0A * \5Cparam start     The start of the buffer, for bounds-checking.\0A * \5Cparam oid       The OID of the algorithm to write.\0A * \5Cparam oid_len   The length of the algorithm's OID.\0A * \5Cparam par_len   The length of the parameters, which must be already written.\0A * \5Cparam has_par   If there are any parameters. If 0, par_len must be 0. If 1\0A *                  and \5Cp par_len is 0, NULL parameters are added.\0A *\0A * \5Creturn          The number of bytes written to \5Cp p on success.\0A * \5Creturn          A negative \5Cc MBEDTLS_ERR_ASN1_XXX error code on failure.\0A */\0Aint mbedtls_asn1_write_algorithm_identifier_ext(unsigned char **p,\0A                                                const unsigned char *start,\0A                                                const char *oid, size_t oid_len,\0A                                                size_t par_len, int has_par);\0A\0A/**\0A * \5Cbrief           Write a boolean tag (#MBEDTLS_ASN1_BOOLEAN) and value\0A *                  in ASN.1 format.\0A *\0A * \5Cnote            This function works backwards in data buffer.\0A *\0A * \5Cparam p         The reference to the current position pointer.\0A * \5Cparam start     The start of the buffer, for bounds-checking.\0A * \5Cparam boolean   The boolean value to write, either \5Cc 0 or \5Cc 1.\0A *\0A * \5Creturn          The number of bytes written to \5Cp p on success.\0A * \5Creturn          A negative \5Cc MBEDTLS_ERR_ASN1_XXX error code on failure.\0A */\0Aint mbedtls_asn1_write_bool(unsigned char **p, const unsigned char *start,\0A                            int boolean);\0A\0A/**\0A * \5Cbrief           Write an int tag (#MBEDTLS_ASN1_INTEGER) and value\0A *                  in ASN.1 format.\0A *\0A * \5Cnote            This function works backwards in data buffer.\0A *\0A * \5Cparam p         The reference to the current position pointer.\0A * \5Cparam start     The start of the buffer, for bounds-checking.\0A * \5Cparam val       The integer value to write.\0A *                  It must be non-negative.\0A *\0A * \5Creturn          The number of bytes written to \5Cp p on success.\0A * \5Creturn          A negative \5Cc MBEDTLS_ERR_ASN1_XXX error code on failure.\0A */\0Aint mbedtls_asn1_write_int(unsigned char **p, const unsigned char *start, int val);\0A\0A/**\0A * \5Cbrief           Write an enum tag (#MBEDTLS_ASN1_ENUMERATED) and value\0A *                  in ASN.1 format.\0A *\0A * \5Cnote            This function works backwards in data buffer.\0A *\0A * \5Cparam p         The reference to the current position pointer.\0A * \5Cparam start     The start of the buffer, for bounds-checking.\0A * \5Cparam val       The integer value to write.\0A *\0A * \5Creturn          The number of bytes written to \5Cp p on success.\0A * \5Creturn          A negative \5Cc MBEDTLS_ERR_ASN1_XXX error code on failure.\0A */\0Aint mbedtls_asn1_write_enum(unsigned char **p, const unsigned char *start, int val);\0A\0A/**\0A * \5Cbrief           Write a string in ASN.1 format using a specific\0A *                  string encoding tag.\0A\0A * \5Cnote            This function works backwards in data buffer.\0A *\0A * \5Cparam p         The reference to the current position pointer.\0A * \5Cparam start     The start of the buffer, for bounds-checking.\0A * \5Cparam tag       The string encoding tag to write, e.g.\0A *                  #MBEDTLS_ASN1_UTF8_STRING.\0A * \5Cparam text      The string to write.\0A * \5Cparam text_len  The length of \5Cp text in bytes (which might\0A *                  be strictly larger than the number of characters).\0A *\0A * \5Creturn          The number of bytes written to \5Cp p on success.\0A * \5Creturn          A negative error code on failure.\0A */\0Aint mbedtls_asn1_write_tagged_string(unsigned char **p, const unsigned char *start,\0A                                     int tag, const char *text,\0A                                     size_t text_len);\0A\0A/**\0A * \5Cbrief           Write a string in ASN.1 format using the PrintableString\0A *                  string encoding tag (#MBEDTLS_ASN1_PRINTABLE_STRING).\0A *\0A * \5Cnote            This function works backwards in data buffer.\0A *\0A * \5Cparam p         The reference to the current position pointer.\0A * \5Cparam start     The start of the buffer, for bounds-checking.\0A * \5Cparam text      The string to write.\0A * \5Cparam text_len  The length of \5Cp text in bytes (which might\0A *                  be strictly larger than the number of characters).\0A *\0A * \5Creturn          The number of bytes written to \5Cp p on success.\0A * \5Creturn          A negative error code on failure.\0A */\0Aint mbedtls_asn1_write_printable_string(unsigned char **p,\0A                                        const unsigned char *start,\0A                                        const char *text, size_t text_len);\0A\0A/**\0A * \5Cbrief           Write a UTF8 string in ASN.1 format using the UTF8String\0A *                  string encoding tag (#MBEDTLS_ASN1_UTF8_STRING).\0A *\0A * \5Cnote            This function works backwards in data buffer.\0A *\0A * \5Cparam p         The reference to the current position pointer.\0A * \5Cparam start     The start of the buffer, for bounds-checking.\0A * \5Cparam text      The string to write.\0A * \5Cparam text_len  The length of \5Cp text in bytes (which might\0A *                  be strictly larger than the number of characters).\0A *\0A * \5Creturn          The number of bytes written to \5Cp p on success.\0A * \5Creturn          A negative error code on failure.\0A */\0Aint mbedtls_asn1_write_utf8_string(unsigned char **p, const unsigned char *start,\0A                                   const char *text, size_t text_len);\0A\0A/**\0A * \5Cbrief           Write a string in ASN.1 format using the IA5String\0A *                  string encoding tag (#MBEDTLS_ASN1_IA5_STRING).\0A *\0A * \5Cnote            This function works backwards in data buffer.\0A *\0A * \5Cparam p         The reference to the current position pointer.\0A * \5Cparam start     The start of the buffer, for bounds-checking.\0A * \5Cparam text      The string to write.\0A * \5Cparam text_len  The length of \5Cp text in bytes (which might\0A *                  be strictly larger than the number of characters).\0A *\0A * \5Creturn          The number of bytes written to \5Cp p on success.\0A * \5Creturn          A negative error code on failure.\0A */\0Aint mbedtls_asn1_write_ia5_string(unsigned char **p, const unsigned char *start,\0A                                  const char *text, size_t text_len);\0A\0A/**\0A * \5Cbrief           Write a bitstring tag (#MBEDTLS_ASN1_BIT_STRING) and\0A *                  value in ASN.1 format.\0A *\0A * \5Cnote            This function works backwards in data buffer.\0A *\0A * \5Cparam p         The reference to the current position pointer.\0A * \5Cparam start     The start of the buffer, for bounds-checking.\0A * \5Cparam buf       The bitstring to write.\0A * \5Cparam bits      The total number of bits in the bitstring.\0A *\0A * \5Creturn          The number of bytes written to \5Cp p on success.\0A * \5Creturn          A negative error code on failure.\0A */\0Aint mbedtls_asn1_write_bitstring(unsigned char **p, const unsigned char *start,\0A                                 const unsigned char *buf, size_t bits);\0A\0A/**\0A * \5Cbrief           This function writes a named bitstring tag\0A *                  (#MBEDTLS_ASN1_BIT_STRING) and value in ASN.1 format.\0A *\0A *                  As stated in RFC 5280 Appendix B, trailing zeroes are\0A *                  omitted when encoding named bitstrings in DER.\0A *\0A * \5Cnote            This function works backwards within the data buffer.\0A *\0A * \5Cparam p         The reference to the current position pointer.\0A * \5Cparam start     The start of the buffer which is used for bounds-checking.\0A * \5Cparam buf       The bitstring to write.\0A * \5Cparam bits      The total number of bits in the bitstring.\0A *\0A * \5Creturn          The number of bytes written to \5Cp p on success.\0A * \5Creturn          A negative error code on failure.\0A */\0Aint mbedtls_asn1_write_named_bitstring(unsigned char **p,\0A                                       const unsigned char *start,\0A                                       const unsigned char *buf,\0A                                       size_t bits);\0A\0A/**\0A * \5Cbrief           Write an octet string tag (#MBEDTLS_ASN1_OCTET_STRING)\0A *                  and value in ASN.1 format.\0A *\0A * \5Cnote            This function works backwards in data buffer.\0A *\0A * \5Cparam p         The reference to the current position pointer.\0A * \5Cparam start     The start of the buffer, for bounds-checking.\0A * \5Cparam buf       The buffer holding the data to write.\0A * \5Cparam size      The length of the data buffer \5Cp buf.\0A *\0A * \5Creturn          The number of bytes written to \5Cp p on success.\0A * \5Creturn          A negative error code on failure.\0A */\0Aint mbedtls_asn1_write_octet_string(unsigned char **p, const unsigned char *start,\0A                                    const unsigned char *buf, size_t size);\0A\0A/**\0A * \5Cbrief           Create or find a specific named_data entry for writing in a\0A *                  sequence or list based on the OID. If not already in there,\0A *                  a new entry is added to the head of the list.\0A *                  Warning: Destructive behaviour for the val data!\0A *\0A * \5Cparam list      The pointer to the location of the head of the list to seek\0A *                  through (will be updated in case of a new entry).\0A * \5Cparam oid       The OID to look for.\0A * \5Cparam oid_len   The size of the OID.\0A * \5Cparam val       The associated data to store. If this is \5Cc NULL,\0A *                  no data is copied to the new or existing buffer.\0A * \5Cparam val_len   The minimum length of the data buffer needed.\0A *                  If this is 0, do not allocate a buffer for the associated\0A *                  data.\0A *                  If the OID was already present, enlarge, shrink or free\0A *                  the existing buffer to fit \5Cp val_len.\0A *\0A * \5Creturn          A pointer to the new / existing entry on success.\0A * \5Creturn          \5Cc NULL if there was a memory allocation error.\0A */\0Ambedtls_asn1_named_data *mbedtls_asn1_store_named_data(mbedtls_asn1_named_data **list,\0A                                                       const char *oid, size_t oid_len,\0A                                                       const unsigned char *val,\0A                                                       size_t val_len);\0A\0A#ifdef __cplusplus\0A}\0A#endif\0A\0A#endif /* MBEDTLS_ASN1_WRITE_C */\0A\0A#endif /* MBEDTLS_ASN1_WRITE_H */\0A\00" }
