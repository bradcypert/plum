@.str39654 = private global { i64, i64, [40205 x i8] } { i64 -1, i64 40204, [40205 x i8] c"/**\0A * \5Cfile oid.h\0A *\0A * \5Cbrief Object Identifier (OID) database\0A */\0A/*\0A *  Copyright The Mbed TLS Contributors\0A *  SPDX-License-Identifier: Apache-2.0 OR GPL-2.0-or-later\0A */\0A#ifndef MBEDTLS_OID_H\0A#define MBEDTLS_OID_H\0A#include \22mbedtls/private_access.h\22\0A\0A#include \22mbedtls/build_info.h\22\0A\0A#include \22mbedtls/asn1.h\22\0A#include \22mbedtls/pk.h\22\0A\0A#include <stddef.h>\0A\0A#if defined(MBEDTLS_CIPHER_C)\0A#include \22mbedtls/cipher.h\22\0A#endif\0A\0A#include \22mbedtls/md.h\22\0A\0A/** OID is not found. */\0A#define MBEDTLS_ERR_OID_NOT_FOUND                         -0x002E\0A/** output buffer is too small */\0A#define MBEDTLS_ERR_OID_BUF_TOO_SMALL                     -0x000B\0A\0A/* This is for the benefit of X.509, but defined here in order to avoid\0A * having a \22backwards\22 include of x.509.h here */\0A/*\0A * X.509 extension types (internal, arbitrary values for bitsets)\0A */\0A#define MBEDTLS_OID_X509_EXT_AUTHORITY_KEY_IDENTIFIER    (1 << 0)\0A#define MBEDTLS_OID_X509_EXT_SUBJECT_KEY_IDENTIFIER      (1 << 1)\0A#define MBEDTLS_OID_X509_EXT_KEY_USAGE                   (1 << 2)\0A#define MBEDTLS_OID_X509_EXT_CERTIFICATE_POLICIES        (1 << 3)\0A#define MBEDTLS_OID_X509_EXT_POLICY_MAPPINGS             (1 << 4)\0A#define MBEDTLS_OID_X509_EXT_SUBJECT_ALT_NAME            (1 << 5)\0A#define MBEDTLS_OID_X509_EXT_ISSUER_ALT_NAME             (1 << 6)\0A#define MBEDTLS_OID_X509_EXT_SUBJECT_DIRECTORY_ATTRS     (1 << 7)\0A#define MBEDTLS_OID_X509_EXT_BASIC_CONSTRAINTS           (1 << 8)\0A#define MBEDTLS_OID_X509_EXT_NAME_CONSTRAINTS            (1 << 9)\0A#define MBEDTLS_OID_X509_EXT_POLICY_CONSTRAINTS          (1 << 10)\0A#define MBEDTLS_OID_X509_EXT_EXTENDED_KEY_USAGE          (1 << 11)\0A#define MBEDTLS_OID_X509_EXT_CRL_DISTRIBUTION_POINTS     (1 << 12)\0A#define MBEDTLS_OID_X509_EXT_INIHIBIT_ANYPOLICY          (1 << 13)\0A#define 