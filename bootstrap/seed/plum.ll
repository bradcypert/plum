replaced, and\0A// deliberately not `cp -r src dst` (that would nest a directory).\0A//\0A// File MODES are not preserved. The one caller copies a project into a\0A// scratch directory to type-check it, where nothing is executed; if a\0A// caller ever needs the executable bit, this is the line to revisit\0A// rather than a thing to assume.\0Astatic int plum_copy_tree(const char *src, const char *dst) {\0A    DIR *d;\0A    struct dirent *e;\0A    char *s;\0A    char *t;\0A    int rc = 0;\0A\0A    // Refuse self-copy and either direction of overlap before reading or\0A    // creating any destination entry. Otherwise recursion can be unbounded,\0A    // and a file copied onto itself is truncated by fopen(\22wb\22).\0A    if (plum_paths_overlap(src, dst) != 0) return -1;\0A\0A    d = opendir(src);\0A    if (d == NULL) return -1;\0A    s = (char *)malloc(PLUM_PATH_MAX);\0A    t = (char *)malloc(PLUM_PATH_MAX);\0A    if (s == NULL || t == NULL) { free(s); free(t); closedir(d); return -1; }\0A\0A    while ((e = readdir(d)) != NULL) {\0A        if (strcmp(e->d_name, \22.\22) == 0 || strcmp(e->d_name, \22..\22) == 0) continue;\0A        if (plum_join(s, PLUM_PATH_MAX, src, e->d_name) != 0) { rc = -1; continue; }\0A        if (plum_join(t, PLUM_PATH_MAX, dst, e->d_name) != 0) { rc = -1; continue; }\0A        if (plum_is_dir(s)) {\0A            if (PLUM_MKDIR(t) != 0 && !plum_is_dir(t)) { rc = -1; continue; }\0A            if (plum_copy_tree(s, t) != 0) rc = -1;\0A        } else {\0A            if (plum_copy_file(s, t) != 0) rc = -1;\0A        }\0A    }\0A    free(s);\0A    free(t);\0A    closedir(d);\0A    return rc;\0A}\0A\0Along long os_copy_tree(const char *src, const char *dst) {\0A    return plum_copy_tree(src, dst) == 0 ? 0 : -1;\0A}\0A\0A// --- File metadata (issue #24) ---\0A//\0A// `stat(2)`, the rest of it. `path_is_dir` in `dir_shim.c` was the first\0A// caller and stays where it is; these are its siblings, here because\0A// this is the filesystem shim.\0A//\0A// Loaded into a thread-local record and then read field by field, so\0A// `Os.stat` costs ONE `stat` rather than one per field. Plum's extern\0A// surface has no multi-value return, which is the same constraint\0A// `tcp_recv_n`/`tcp_recv_data` and `file_read_n`/`file_read_data` work\0A// around the same way.\0A//\0A// Thread-local rather than plain static: `net_shim.c` learned what a\0A// shared buffer costs when two threads use it at once, and a per-thread\0A// record is cheap enough not to repeat that.\0A#include <errno.h>\0A#include <time.h>\0A\0A#if defined(_MSC_VER)\0A#define PLUM_OS_TLS __declspec(thread)\0A#else\0A#define PLUM_OS_TLS _Thread_local\0A#endif\0A\0Astatic PLUM_OS_TLS long long stat_size = 0;\0Astatic PLUM_OS_TLS long long stat_mtime = 0;\0Astatic PLUM_OS_TLS long long stat_is_dir = 0;\0A\0A// 0 on success, -1 if the path cannot be stat'ed at all (most commonly\0A// because it is not there). Follows symlinks, matching `path_is_dir`.\0Along long os_stat_load(const char *path) {\0A    struct stat st;\0A    if (stat(path, &st) != 0) {\0A        stat_size = 0;\0A        stat_mtime = 0;\0A        stat_is_dir = 0;\0A        return -1;\0A    }\0A    stat_size = (long long)st.st_size;\0A    stat_mtime = (long long)st.st_mtime;\0A    stat_is_dir = S_ISDIR(st.st_mode) ? 1 : 0;\0A    return 0;\0A}\0A\0Along long os_stat_size(void) { return stat_size; }\0Along long os_stat_mtime(void) { return stat_mtime; }\0Along long os_stat_is_dir(void) { return stat_is_dir; }\0A\0A// Retention is best effort and runs after compilation. Only complete hash\0A// entries are eviction candidates; staging is protected by its live owner.\0A// Cache roots must be private to this host/user (not a shared network store).\0Atypedef struct { char *path; uint64_t bytes; time_t age; } plum_cache_entry;\0A\0Astatic int plum_cache_stat_private(const char *path, struct stat *st) {\0A#if defined(_WIN32)\0A    DWORD attrs=GetFileAttributesA(path);\0A    if (attrs == INVALID_FILE_ATTRIBUTES || 