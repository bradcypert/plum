tocol_version tls_version,\0A                                 uint32_t *flags)\0A{\0A    int ret = 0;\0A    unsigned int usage = 0;\0A    const char *ext_oid;\0A    size_t ext_len;\0A\0A    /*\0A     * keyUsage\0A     */\0A\0A    /* Note: don't guard this with MBEDTLS_SSL_CLI_C because the server wants\0A     * to check what a compliant client will think while choosing which cert\0A     * to send to the client. */\0A#if defined(MBEDTLS_SSL_PROTO_TLS1_2)\0A    if (tls_version == MBEDTLS_SSL_VERSION_TLS1_2 &&\0A        recv_endpoint == MBEDTLS_SSL_IS_CLIENT) {\0A        /* TLS 1.2 server part of the key exchange */\0A        switch (ciphersuite->key_exchange) {\0A            case MBEDTLS_KEY_EXCHANGE_RSA:\0A            case MBEDTLS_KEY_EXCHANGE_RSA_PSK:\0A                usage = MBEDTLS_X509_KU_KEY_ENCIPHERMENT;\0A                break;\0A\0A            case MBEDTLS_KEY_EXCHANGE_DHE_RSA:\0A            case MBEDTLS_KEY_EXCHANGE_ECDHE_RSA:\0A            case MBEDTLS_KEY_EXCHANGE_ECDHE_ECDSA:\0A                usage = MBEDTLS_X509_KU_DIGITAL_SIGNATURE;\0A                break;\0A\0A            case MBEDTLS_KEY_EXCHANGE_ECDH_RSA:\0A            case MBEDTLS_KEY_EXCHANGE_ECDH_ECDSA:\0A                usage = MBEDTLS_X509_KU_KEY_AGREEMENT;\0A                break;\0A\0A            /* Don't use default: we want warnings when adding new values */\0A            case MBEDTLS_KEY_EXCHANGE_NONE:\0A            case MBEDTLS_KEY_EXCHANGE_PSK:\0A            case MBEDTLS_KEY_EXCHANGE_DHE_PSK:\0A            case MBEDTLS_KEY_EXCHANGE_ECDHE_PSK:\0A            case MBEDTLS_KEY_EXCHANGE_ECJPAKE:\0A                usage = 0;\0A        }\0A    } else\0A#endif\0A    {\0A        /* This is either TLS 1.3 authentication, which always uses signatures,\0A         * or 1.2 client auth: rsa_sign and mbedtls_ecdsa_sign are the only\0A         * options we implement, both using signatures. */\0A        (void) tls_version;\0A        (void) ciphersuite;\0A        usage = MBEDTLS_X509_KU_DIGITAL_SIGNATUR