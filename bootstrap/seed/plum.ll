nt mbedtls_cipher_set_padding_mode(mbedtls_cipher_context_t *ctx,\0A                                    mbedtls_cipher_padding_t mode);\0A#endif /* MBEDTLS_CIPHER_MODE_WITH_PADDING */\0A\0A/**\0A * \5Cbrief           This function sets the initialization vector (IV)\0A *                  or nonce.\0A *\0A * \5Cnote            Some ciphers do not use IVs nor nonce. For these\0A *                  ciphers, this function has no effect.\0A *\0A * \5Cnote            For #MBEDTLS_CIPHER_CHACHA20, the nonce length must\0A *                  be 12, and the initial counter value is 0.\0A *\0A * \5Cnote            For #MBEDTLS_CIPHER_CHACHA20_POLY1305, the nonce length\0A *                  must be 12.\0A *\0A * \5Cparam ctx       The generic cipher context. This must be initialized and\0A *                  bound to a cipher information structure.\0A * \5Cparam iv        The IV to use, or NONCE_COUNTER for CTR-mode ciphers. This\0A *                  must be a readable buffer of at least \5Cp iv_len Bytes.\0A * \5Cparam iv_len    The IV length for ciphers with variable-size IV.\0A *                  This parameter is discarded by ciphers with fixed-size IV.\0A *\0A * \5Creturn          \5Cc 0 on success.\0A * \5Creturn          #MBEDTLS_ERR_CIPHER_BAD_INPUT_DATA on\0A *                  parameter-verification failure.\0A */\0Aint mbedtls_cipher_set_iv(mbedtls_cipher_context_t *ctx,\0A                          const unsigned char *iv,\0A                          size_t iv_len);\0A\0A/**\0A * \5Cbrief         This function resets the cipher state.\0A *\0A * \5Cnote          With non-AEAD ciphers, the order of calls for each message\0A *                is as follows:\0A *                1. mbedtls_cipher_set_iv() if the mode uses an IV/nonce.\0A *                2. mbedtls_cipher_reset()\0A *                3. mbedtls_cipher_update() one or more times\0A *                4. mbedtls_cipher_finish()\0A *                .\0A *                This sequence can be repeated to encrypt or decrypt multiple\0A *                messages with the same key.\0A *\0A * \5Cnote          With AEAD ciphers, the order of calls for each message\0A *                is as follows:\0A *                1. mbedtls_cipher_set_iv() if the mode uses an IV/nonce.\0A *                2. mbedtls_cipher_reset()\0A *                3. mbedtls_cipher_update_ad()\0A *                4. mbedtls_cipher_update() one or more times\0A *                5. mbedtls_cipher_finish()\0A *                6. mbedtls_cipher_check_tag() (for decryption) or\0A *                mbedtls_cipher_write_tag() (for encryption).\0A *                .\0A *                This sequence can be repeated to encrypt or decrypt multiple\0A *                messages with the same key.\0A *\0A * \5Cparam ctx     The generic cipher context. This must be bound to a key.\0A *\0A * \5Creturn        \5Cc 0 on success.\0A * \5Creturn        #MBEDTLS_ERR_CIPHER_BAD_INPUT_DATA on\0A *                parameter-verification failure.\0A */\0Aint mbedtls_cipher_reset(mbedtls_cipher_context_t *ctx);\0A\0A#if defined(MBEDTLS_GCM_C) || defined(MBEDTLS_CHACHAPOLY_C)\0A/**\0A * \5Cbrief               This function adds additional data for AEAD ciphers.\0A *                      Currently supported with GCM and ChaCha20+Poly1305.\0A *\0A * \5Cparam ctx           The generic cipher context. This must be initialized.\0A * \5Cparam ad            The additional data to use. This must be a readable\0A *                      buffer of at least \5Cp ad_len Bytes.\0A * \5Cparam ad_len        The length of \5Cp ad in Bytes.\0A *\0A * \5Creturn              \5Cc 0 on success.\0A * \5Creturn              A specific error code on failure.\0A */\0Aint mbedtls_cipher_update_ad(mbedtls_cipher_context_t *ctx,\0A                             const unsigned char *ad, size_t ad_len);\0A#endif /* MBEDTLS_GCM_C || MBEDTLS_CHACHAPOLY_C */\0A\0A/**\0A * \5Cbrief               The generic cipher update function. It encrypts or\0A *                      decrypts using the given cipher context. Writes as\0A *                      many block-sized blocks of data as possible to output.\0A *                      Any data that cannot be written immediately is either\0A *                      added to the next block, or flushed when\0A *                      mbedtls_cipher_finish() is called.\0A *                      Exception: For MBEDTLS_MODE_ECB, expects a single block\0A *                      in size. For example, 16 Bytes for AES.\0A *\0A * \5Cparam ctx           The generic cipher context. This must be initialized and\0A *                      bound to a key.\0A * \5Cparam input         The buffer holding the input data. This must be a\0A *                      readable buffer of at least \5Cp ilen Bytes.\0A * \5Cparam ilen          The length of the input data.\0A * \5Cparam output        The buffer for the output data. This must be able to\0A *                      hold at least `ilen + block_size`. This must not be the\0A *                      same buffer as \5Cp input.\0A * \5Cparam olen          The length of the output data, to be updated with the\0A *                      actual number of Bytes written. This must not be\0A *                      \5Cc NULL.\0A *\0A * \5Creturn              \5Cc 0 on success.\0A * \5Creturn              #MBEDTLS_ERR_CIPHER_BAD_INPUT_DATA on\0A *                      parameter-verification failure.\0A * \5Creturn              #MBEDTLS_ERR_CIPHER_FEATURE_UNAVAILABLE on an\0A *                      unsupported mode for a cipher.\0A * \5Creturn              A cipher-specific error code on failure.\0A */\0Aint mbedtls_cipher_update(mbedtls_cipher_context_t *ctx,\0A                          const unsigned char *input,\0A                          size_t ilen, unsigned char *output,\0A                          size_t *olen);\0A\0A/**\0A * \5Cbrief               The generic cipher finalization function. If data still\0A *                      needs to be flushed from an incomplete block, the data\0A *                      contained in it is padded to the size of\0A *                      the last block, and written to the \5Cp output buffer.\0A *\0A * \5Cparam ctx           The generic cipher context. This must be initialized and\0A *                      bound to a key.\0A * \5Cparam output        The buffer to write data to. This needs to be a writable\0A *                      buffer of at least block_size Bytes.\0A * \5Cparam olen          The length of the data written to the \5Cp output buffer.\0A *                      This may not be \5Cc NULL.\0A *\0A * \5Creturn              \5Cc 0 on success.\0A * \5Creturn              #MBEDTLS_ERR_CIPHER_BAD_INPUT_DATA on\0A *                      parameter-verification failure.\0A * \5Creturn              #MBEDTLS_ERR_CIPHER_FULL_BLOCK_EXPECTED on decryption\0A *                      expecting a full block but not receiving one.\0A * \5Creturn              #MBEDTLS_ERR_CIPHER_INVALID_PADDING on invalid padding\0A *                      while decrypting.\0A * \5Creturn              A cipher-specific error code on failure.\0A */\0Aint mbedtls_cipher_finish(mbedtls_cipher_context_t *ctx,\0A                          unsigned char *output, size_t *olen);\0A\0A#if defined(MBEDTLS_GCM_C) || defined(MBEDTLS_CHACHAPOLY_C)\0A/**\0A * \5Cbrief               This function writes a tag for AEAD ciphers.\0A *                      Currently supported with GCM and ChaCha20+Poly1305.\0A *                      This must be called after mbedtls_cipher_finish().\0A *\0A * \5Cparam ctx           The generic cipher context. This must be initialized,\0A *                      bound to a key, and have just completed a cipher\0A *                      operation through mbedtls_cipher_finish() the tag for\0A *                      which should be written.\0A * \5Cparam tag           The buffer to write the tag to. This must be a writable\0A *                      buffer of at least \5Cp tag_len Bytes.\0A * \5Cparam tag_len       The length of the tag to write.\0A *\0A * \5Creturn              \5Cc 0 on success.\0A * \5Creturn              A specific error code on failure.\0A */\0Aint mbedtls_cipher_write_tag(mbedtls_cipher_context_t *ctx,\0A                             unsigned char *tag, size_t tag_len);\0A\0A/**\0A * \5Cbrief               This function checks the tag for AEAD ciphers.\0A *                      Currently supported with GCM and ChaCha20+Poly1305.\0A *                      This must be called after mbedtls_cipher_finish().\0A *\0A * \5Cparam ctx           The generic cipher context. This must be initialized.\0A * \5Cparam tag           The buffer holding the tag. This must be a readable\0A *                      buffer of at least \5Cp tag_len Bytes.\0A * \5Cparam tag_len       The length of the tag to check.\0A *\0A * \5Creturn              \5Cc 0 on success.\0A * \5Creturn              A specific error code on failure.\0A */\0Aint mbedtls_cipher_check_tag(mbedtls_cipher_context_t *ctx,\0A                             const unsigned char *tag, size_t tag_len);\0A#endif /* MBEDTLS_GCM_C || MBEDTLS_CHACHAPOLY_C */\0A\0A/**\0A * \5Cbrief               The generic all-in-one encryption/decryption function,\0A *                      for all ciphers except AEAD constructs.\0A *\0A * \5Cparam ctx           The generic cipher context. This must be initialized.\0A * \5Cparam iv            The IV to use, or NONCE_COUNTER for CTR-mode ciphers.\0A *                      This must be a readable buffer of at least \5Cp iv_len\0A *                      Bytes.\0A * \5Cparam iv_len        The IV length for ciphers with variable-size IV.\0A *                      This parameter is discarded by ciphers with fixed-size\0A *                      IV.\0A * \5Cparam input         The buffer holding the input data. This must be a\0A *                      readable buffer of at least \5Cp ilen Bytes.\0A * \5Cparam ilen          The length of the input data in Bytes.\0A * \5Cparam output        The buffer for the output data. This must be able to\0A *                      hold at least `ilen + block_size`. This must not be the\0A *                      same buffer as \5Cp input.\0A * \5Cparam olen          The length of the output data, to be updated with the\0A *                      actual number of Bytes written. This must not be\0A *                      \5Cc NULL.\0A *\0A * \5Cnote                Some ciphers do not use IVs nor nonce. For these\0A *                      ciphers, use \5Cp iv = NULL and \5Cp iv_len = 0.\0A *\0A * \5Creturn              \5Cc 0 on success.\0A * \5Creturn              #MBEDTLS_ERR_CIPHER_BAD_INPUT_DATA on\0A *                      parameter-verification failure.\0A * \5Creturn              #MBEDTLS_ERR_CIPHER_FULL_BLOCK_EXPECTED on decryption\0A *                      expecting a full block but not receiving one.\0A * \5Creturn              #MBEDTLS_ERR_CIPHER_INVALID_PADDING on invalid padding\0A *                      while decrypting.\0A * \5Creturn              A cipher-specific error code on failure.\0A */\0Aint mbedtls_cipher_crypt(mbedtls_cipher_context_t *ctx,\0A                         const unsigned char *iv, size_t iv_len,\0A                         const unsigned char *input, size_t ilen,\0A                         unsigned char *output, size_t *olen);\0A\0A#if defined(MBEDTLS_CIPHER_MODE_AEAD) || defined(MBEDTLS_NIST_KW_C)\0A/**\0A * \5Cbrief               The authenticated encryption (AEAD/NIST_KW) function.\0A *\0A * \5Cnote                For AEAD modes, the tag will be appended to the\0A *                      ciphertext, as recommended by RFC 5116.\0A *                      (NIST_KW doesn't have a separate tag.)\0A *\0A * \5Cparam ctx           The generic cipher context. This must be initialized and\0A *                      bound to a key, with an AEAD algorithm or NIST_KW.\0A * \5Cparam iv            The nonce to use. This must be a readable buffer of\0A *                      at least \5Cp iv_len Bytes and may be \5Cc NULL if \5Cp\0A *                      iv_len is \5Cc 0.\0A * \5Cparam iv_len        The length of the nonce. For AEAD ciphers, this must\0A *                      satisfy the constraints imposed by the cipher used.\0A *                      For NIST_KW, this must be \5Cc 0.\0A * \5Cparam ad            The additional data to authenticate. This must be a\0A *                      readable buffer of at least \5Cp ad_len Bytes, and may\0A *                      be \5Cc NULL is \5Cp ad_len is \5Cc 0.\0A * \5Cparam ad_len        The length of \5Cp ad. For NIST_KW, this must be \5Cc 0.\0A * \5Cparam input         The buffer holding the input data. This must be a\0A *                      readable buffer of at least \5Cp ilen Bytes, and may be\0A *                      \5Cc NULL if \5Cp ilen is \5Cc 0.\0A * \5Cparam ilen          The length of the input data.\0A * \5Cparam output        The buffer for the output data. This must be a\0A *                      writable buffer of at least \5Cp output_len Bytes, and\0A *                      must not be \5Cc NULL.\0A * \5Cparam output_len    The length of the \5Cp output buffer in Bytes. For AEAD\0A *                      ciphers, this must be at least \5Cp ilen + \5Cp tag_len.\0A *                      For NIST_KW, this must be at least \5Cp ilen + 8\0A *                      (rounded up to a multiple of 8 if KWP is used);\0A *                      \5Cp ilen + 15 is always a safe value.\0A * \5Cparam olen          This will be filled with the actual number of Bytes\0A *                      written to the \5Cp output buffer. This must point to a\0A *                      writable object of type \5Cc size_t.\0A * \5Cparam tag_len       The desired length of the authentication tag. For AEAD\0A *                      ciphers, this must match the constraints imposed by\0A *                      the cipher used, and in particular must not be \5Cc 0.\0A *                      For NIST_KW, this must be \5Cc 0.\0A *\0A * \5Creturn              \5Cc 0 on success.\0A * \5Creturn              #MBEDTLS_ERR_CIPHER_BAD_INPUT_DATA on\0A *                      parameter-verification failure.\0A * \5Creturn              A cipher-specific error code on failure.\0A */\0Aint mbedtls_cipher_auth_encrypt_ext(mbedtls_cipher_context_t *ctx,\0A                                    const unsigned char *iv, size_t iv_len,\0A                                    const unsigned char *ad, size_t ad_len,\0A                                    const unsigned char *input, size_t ilen,\0A                                    unsigned char *output, size_t output_len,\0A                                    size_t *olen, size_t tag_len);\0A\0A/**\0A * \5Cbrief               The authenticated encryption (AEAD/NIST_KW) function.\0A *\0A * \5Cnote                If the data is not authentic, then the output buffer\0A *                      is zeroed out to prevent the unauthentic plaintext being\0A *                      used, making this interface safer.\0A *\0A * \5Cnote                For AEAD modes, the tag must be appended to the\0A *                      ciphertext, as recommended by RFC 5116.\0A *                      (NIST_KW doesn't have a separate tag.)\0A *\0A * \5Cparam ctx           The generic cipher context. This must be initialized and\0A *                      bound to a key, with an AEAD algorithm or NIST_KW.\0A * \5Cparam iv            The nonce to use. This must be a readable buffer of\0A *                      at least \5Cp iv_len Bytes and may be \5Cc NULL if \5Cp\0A *                      iv_len is \5Cc 0.\0A * \5Cparam iv_len        The length of the nonce. For AEAD ciphers, this must\0A *                      satisfy the constraints imposed by the cipher used.\0A *                      For NIST_KW, this must be \5Cc 0.\0A * \5Cparam ad            The additional data to authenticate. This must be a\0A *                      readable buffer of at least \5Cp ad_len Bytes, and may\0A *                      be \5Cc NULL is \5Cp ad_len is \5Cc 0.\0A * \5Cparam ad_len        The length of \5Cp ad. For NIST_KW, this must be \5Cc 0.\0A * \5Cparam input         The buffer holding the input data. This must be a\0A *                      readable buffer of at least \5Cp ilen Bytes, and may be\0A *                      \5Cc NULL if \5Cp ilen is \5Cc 0.\0A * \5Cparam ilen          The length of the input data. For AEAD ciphers this\0A *                      must be at least \5Cp tag_len. For NIST_KW this must be\0A *                      at least \5Cc 8.\0A * \5Cparam output        The buffer for the output data. This must be a\0A *                      writable buffer of at least \5Cp output_len Bytes, and\0A *                      may be \5Cc NULL if \5Cp output_len is \5Cc 0.\0A * \5Cparam output_len    The length of the \5Cp output buffer in Bytes. For AEAD\0A *                      ciphers, this must be at least \5Cp ilen - \5Cp tag_len.\0A *                      For NIST_KW, this must be at least \5Cp ilen - 8.\0A * \5Cparam olen          This will be filled with the actual number of Bytes\0A *                      written to the \5Cp output buffer. This must point to a\0A *                      writable object of type \5Cc size_t.\0A * \5Cparam tag_len       The actual length of the authentication tag. For AEAD\0A *                      ciphers, this must match the constraints imposed by\0A *                      the cipher used, and in particular must not be \5Cc 0.\0A *                      For NIST_KW, this must be \5Cc 0.\0A *\0A * \5Creturn              \5Cc 0 on success.\0A * \5Creturn              #MBEDTLS_ERR_CIPHER_BAD_INPUT_DATA on\0A *                      parameter-verification failure.\0A * \5Creturn              #MBEDTLS_ERR_CIPHER_AUTH_FAILED if data is not authentic.\0A * \5Creturn              A cipher-specific error code on failure.\0A */\0Aint mbedtls_cipher_auth_decrypt_ext(mbedtls_cipher_context_t *ctx,\0A                                    const unsigned char *iv, size_t iv_len,\0A                                    const unsigned char *ad, size_t ad_len,\0A                                    const unsigned char *input, size_t ilen,\0A                                    unsigned char *output, size_t output_len,\0A                                    size_t *olen, size_t tag_len);\0A#endif /* MBEDTLS_CIPHER_MODE_AEAD || MBEDTLS_NIST_KW_C */\0A#ifdef __cplusplus\0A}\0A#endif\0A\0A#endif /* MBEDTLS_CIPHER_H */\0A\00" }
