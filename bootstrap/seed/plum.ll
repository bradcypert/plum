@.str40620 = private global { i64, i64, [33576 x i8] } { i64 -1, i64 33575, [33576 x i8] c"/**\0A * \5Cfile cmac.c\0A *\0A * \5Cbrief NIST SP800-38B compliant CMAC implementation for AES and 3DES\0A *\0A *  Copyright The Mbed TLS Contributors\0A *  SPDX-License-Identifier: Apache-2.0 OR GPL-2.0-or-later\0A */\0A\0A/*\0A * References:\0A *\0A * - NIST SP 800-38B Recommendation for Block Cipher Modes of Operation: The\0A *      CMAC Mode for Authentication\0A *   http://nvlpubs.nist.gov/nistpubs/SpecialPublications/NIST.SP.800-38b.pdf\0A *\0A * - RFC 4493 - The AES-CMAC Algorithm\0A *   https://tools.ietf.org/html/rfc4493\0A *\0A * - RFC 4615 - The Advanced Encryption Standard-Cipher-based Message\0A *      Authentication Code-Pseudo-Random Function-128 (AES-CMAC-PRF-128)\0A *      Algorithm for the Internet Key Exchange Protocol (IKE)\0A *   https://tools.ietf.org/html/rfc4615\0A *\0A *   Additional test vectors: ISO/IEC 9797-1\0A *\0A */\0A\0A#include \22common.h\22\0A\0A#if defined(MBEDTLS_CMAC_C)\0A\0A#include \22mbedtls/cmac.h\22\0A#include \22mbedtls/platform_util.h\22\0A#include \22mbedtls/error.h\22\0A#include \22mbedtls/platform.h\22\0A#include \22constant_time_internal.h\22\0A\0A#include <string.h>\0A\0A#if !defined(MBEDTLS_CMAC_ALT) || defined(MBEDTLS_SELF_TEST)\0A\0A/*\0A * Multiplication by u in the Galois field of GF(2^n)\0A *\0A * As explained in NIST SP 800-38B, this can be computed:\0A *\0A *   If MSB(p) = 0, then p = (p << 1)\0A *   If MSB(p) = 1, then p = (p << 1) ^ R_n\0A *   with R_64 = 0x1B and  R_128 = 0x87\0A *\0A * Input and output MUST NOT point to the same buffer\0A * Block size must be 8 bytes or 16 bytes - the block sizes for DES and AES.\0A */\0Astatic int cmac_multiply_by_u(unsigned char *output,\0A                              const unsigned char *input,\0A                              size_t blocksize)\0A{\0A    const unsigned char R_128 = 0x87;\0A    unsigned char R_n;\0A    uint32_t overflow = 0x00;\0A    int i;\0A\0A    if (blocksize == MBEDTLS_AES_BLOCK_SIZE) {\0A        R_n = R_128;\0A    }\0A#if defined(MBEDTLS_DES_C)\0A    else if (blocksize == MBEDTLS_DES3_BLOCK_SIZE) {\0A        const unsigned char R_64 = 0x1B;\0A        R_n = R_64;\0A    }\0A#endif\0A    else {\0A        return MBEDTLS_ERR_CIPHER_BAD_INPUT_DATA;\0A    }\0A\0A    for (i = (int) blocksize - 4; i >= 0; i -= 4) {\0A        uint32_t i32 = MBEDTLS_GET_UINT32_BE(&input[i], 0);\0A        uint32_t new_overflow = i32 >> 31;\0A        i32 = (i32 << 1) | overflow;\0A        MBEDTLS_PUT_UINT32_BE(i32, &output[i], 0);\0A        overflow = new_overflow;\0A    }\0A\0A    R_n = (unsigned char) mbedtls_ct_uint_if_else_0(mbedtls_ct_bool(input[0] >> 7), R_n);\0A    output[blocksize - 1] ^= R_n;\0A\0A    return 0;\0A}\0A\0A/*\0A * Generate subkeys\0A *\0A * - as specified by RFC 4493, section 2.3 Subkey Generation Algorithm\0A */\0Astatic int cmac_generate_subkeys(mbedtls_cipher_context_t *ctx,\0A                                 unsigned char *K1, unsigned char *K2)\0A{\0A    int ret = MBEDTLS_ERR_ERROR_CORRUPTION_DETECTED;\0A    unsigned char L[MBEDTLS_CMAC_MAX_BLOCK_SIZE];\0A    size_t olen, block_size;\0A\0A    mbedtls_platform_zeroize(L, sizeof(L));\0A\0A    block_size = mbedtls_cipher_info_get_block_size(ctx->cipher_info);\0A\0A    /* Calculate Ek(0) */\0A    if ((ret = mbedtls_cipher_update(ctx, L, block_size, L, &olen)) != 0) {\0A        goto exit;\0A    }\0A\0A    /*\0A     * Generate K1 and K2\0A     */\0A    if ((ret = cmac_multiply_by_u(K1, L, block_size)) != 0) {\0A        goto exit;\0A    }\0A\0A    if ((ret = cmac_multiply_by_u(K2, K1, block_size)) != 0) {\0A        goto exit;\0A    }\0A\0Aexit:\0A    mbedtls_platform_zeroize(L, sizeof(L));\0A\0A    return ret;\0A}\0A#endif /* !defined(MBEDTLS_CMAC_ALT) || defined(MBEDTLS_SELF_TEST) */\0A\0A#if !defined(MBEDTLS_CMAC_ALT)\0A\0A/*\0A * Create padded last block from (partial) last block.\0A *\0A * We can't use the padding option from the cipher layer, as it only works for\0A * CBC and we use ECB mode, and anyway we need to XOR K1 or K2 in addition.\0A */\0Astatic void cmac_pad(unsigned char padded_block[MBEDTLS_CMAC_MAX_BLOCK_SIZE],\0A                     size_t padded_block_len,\0A                     const unsigned char *last_block,\0A                     size_t last_block_len)\0A{\0A    size_t j;\0A\0A    for (j = 0; j < padded_block_len; j++) {\0A        if (j < last_block_len) {\0A            padded_block[j] = last_block[j];\0A        } else if (j == last_block_len) {\0A            padded_block[j] = 0x80;\0A        } else {\0A            padded_block[j] = 0x00;\0A        }\0A    }\0A}\0A\0Aint mbedtls_cipher_cmac_starts(mbedtls_cipher_context_t *ctx,\0A                               const unsigned char *key, size_t keybits)\0A{\0A    mbedtls_cipher_type_t type;\0A    mbedtls_cmac_context_t *cmac_ctx;\0A    int retval;\0A\0A    if (ctx == NULL || ctx->cipher_info == NULL || key == NULL) {\0A        return MBEDTLS_ERR_CIPHER_BAD_INPUT_DATA;\0A    }\0A\0A    if ((retval = mbedtls_cipher_setkey(ctx, key, (int) keybits,\0A                                        MBEDTLS_ENCRYPT)) != 0) {\0A        return retval;\0A    }\0A\0A    type = mbedtls_cipher_info_get_type(ctx->cipher_info);\0A\0A    switch (type) {\0A        case MBEDTLS_CIPHER_AES_128_ECB:\0A        case MBEDTLS_CIPHER_AES_192_ECB:\0A        case MBEDTLS_CIPHER_AES_256_ECB:\0A        case MBEDTLS_CIPHER_DES_EDE3_ECB:\0A            break;\0A        default:\0A            return MBEDTLS_ERR_CIPHER_BAD_INPUT_DATA;\0A    }\0A\0A    /* Allocated and initialise in the cipher context memory for the CMAC\0A     * context */\0A    cmac_ctx = mbedtls_calloc(1, sizeof(mbedtls_cmac_context_t));\0A    if (cmac_ctx == NULL) {\0A        return MBEDTLS_ERR_CIPHER_ALLOC_FAILED;\0A    }\0A\0A    ctx->cmac_ctx = cmac_ctx;\0A\0A    mbedtls_platform_zeroize(cmac_ctx->state, sizeof(cmac_ctx->state));\0A\0A    return 0;\0A}\0A\0Aint mbedtls_cipher_cmac_update(mbedtls_cipher_context_t *ctx,\0A                               const unsigned char *input, size_t ilen)\0A{\0A    mbedtls_cmac_context_t *cmac_ctx;\0A    unsigned char *state;\0A    int ret = 0;\0A    size_t n, j, olen, block_size;\0A\0A    if (ctx == NULL || ctx->cipher_info == NULL || input == NULL ||\0A        ctx->cmac_ctx == NULL) {\0A        return MBEDTLS_ERR_CIPHER_BAD_INPUT_DATA;\0A    }\0A\0A    cmac_ctx = ctx->cmac_ctx;\0A    block_size = mbedtls_cipher_info_get_block_size(ctx->cipher_info);\0A    state = ctx->cmac_ctx->state;\0A\0A    /* Without the MBEDTLS_ASSUME below, gcc -O3 will generate a warning of the form\0A     * error: writing 16 bytes into a region of size 0 [-Werror=stringop-overflow=] */\0A    MBEDTLS_ASSUME(block_size <= MBEDTLS_CMAC_MAX_BLOCK_SIZE);\0A\0A    /* Is there data still to process from the last call, that's greater in\0A     * size than a block? */\0A    if (cmac_ctx->unprocessed_len > 0 &&\0A        ilen > block_size - cmac_ctx->unprocessed_len) {\0A        memcpy(&cmac_ctx->unprocessed_block[cmac_ctx->unprocessed_len],\0A               input,\0A               block_size - cmac_ctx->unprocessed_len);\0A\0A        mbedtls_xor_no_simd(state, cmac_ctx->unprocessed_block, state, block_size);\0A\0A        if ((ret = mbedtls_cipher_update(ctx, state, block_size, state,\0A                                         &olen)) != 0) {\0A            goto exit;\0A        }\0A\0A        input += block_size - cmac_ctx->unprocessed_len;\0A        ilen -= block_size - cmac_ctx->unprocessed_len;\0A        cmac_ctx->unprocessed_len = 0;\0A    }\0A\0A    /* n is the number of blocks including any final partial block */\0A    n = (ilen + block_size - 1) / block_size;\0A\0A    /* Iterate across the input data in block sized chunks, excluding any\0A     * final partial or complete block */\0A    for (j = 1; j < n; j++) {\0A        mbedtls_xor_no_simd(state, input, state, block_size);\0A\0A        if ((ret = mbedtls_cipher_update(ctx, state, block_size, state,\0A                                         &olen)) != 0) {\0A            goto exit;\0A        }\0A\0A        ilen -= block_size;\0A        input += block_size;\0A    }\0A\0A    /* If there is data left over that wasn't aligned to a block */\0A    if (ilen > 0) {\0A        memcpy(&cmac_ctx->unprocessed_block[cmac_ctx->unprocessed_len],\0A               input,\0A               ilen);\0A        cmac_ctx->unprocessed_len += ilen;\0A    }\0A\0Aexit:\0A    return ret;\0A}\0A\0Aint mbedtls_cipher_cmac_finish(mbedtls_cipher_context_t *ctx,\0A                               unsigned char *output)\0A{\0A    mbedtls_cmac_context_t *cmac_ctx;\0A    unsigned char *state, *last_block;\0A    unsigned char K1[MBEDTLS_CMAC_MAX_BLOCK_SIZE];\0A    unsigned char K2[MBEDTLS_CMAC_MAX_BLOCK_SIZE];\0A    unsigned char M_last[MBEDTLS_CMAC_MAX_BLOCK_SIZE];\0A    int ret = MBEDTLS_ERR_ERROR_CORRUPTION_DETECTED;\0A    size_t olen, block_size;\0A\0A    if (ctx == NULL || ctx->cipher_info == NULL || ctx->cmac_ctx == NULL ||\0A        output == NULL) {\0A        return MBEDTLS_ERR_CIPHER_BAD_INPUT_DATA;\0A    }\0A\0A    cmac_ctx = ctx->cmac_ctx;\0A    block_size = mbedtls_cipher_info_get_block_size(ctx->cipher_info);\0A    MBEDTLS_ASSUME(block_size <= MBEDTLS_CMAC_MAX_BLOCK_SIZE); // silence GCC warning\0A    state = cmac_ctx->state;\0A\0A    mbedtls_platform_zeroize(K1, sizeof(K1));\0A    mbedtls_platform_zeroize(K2, sizeof(K2));\0A    cmac_generate_subkeys(ctx, K1, K2);\0A\0A    last_block = cmac_ctx->unprocessed_block;\0A\0A    /* Calculate last block */\0A    if (cmac_ctx->unprocessed_len < block_size) {\0A        cmac_pad(M_last, block_size, last_block, cmac_ctx->unprocessed_len);\0A        mbedtls_xor(M_last, M_last, K2, block_size);\0A    } else {\0A        /* Last block is complete block */\0A        mbedtls_xor(M_last, last_block, K1, block_size);\0A    }\0A\0A\0A    mbedtls_xor(state, M_last, state, block_size);\0A    if ((ret = mbedtls_cipher_update(ctx, state, block_size, state,\0A                                     &olen)) != 0) {\0A        goto exit;\0A    }\0A\0A    memcpy(output, state, block_size);\0A\0Aexit:\0A    /* Wipe the generated keys on the stack, and any other transients to avoid\0A     * side channel leakage */\0A    mbedtls_platform_zeroize(K1, sizeof(K1));\0A    mbedtls_platform_zeroize(K2, sizeof(K2));\0A\0A    cmac_ctx->unprocessed_len = 0;\0A    mbedtls_platform_zeroize(cmac_ctx->unprocessed_block,\0A                             sizeof(cmac_ctx->unprocessed_block));\0A\0A    mbedtls_platform_zeroize(state, MBEDTLS_CMAC_MAX_BLOCK_SIZE);\0A    return ret;\0A}\0A\0Aint mbedtls_cipher_cmac_reset(mbedtls_cipher_context_t *ctx)\0A{\0A    mbedtls_cmac_context_t *cmac_ctx;\0A\0A    if (ctx == NULL || ctx->cipher_info == NULL || ctx->cmac_ctx == NULL) {\0A        return MBEDTLS_ERR_CIPHER_BAD_INPUT_DATA;\0A    }\0A\0A    cmac_ctx = ctx->cmac_ctx;\0A\0A    /* Reset the internal state */\0A    cmac_ctx->unprocessed_len = 0;\0A    mbedtls_platform_zeroize(cmac_ctx->unprocessed_block,\0A                             sizeof(cmac_ctx->unprocessed_block));\0A    mbedtls_platform_zeroize(cmac_ctx->state,\0A                             sizeof(cmac_ctx->state));\0A\0A    return 0;\0A}\0A\0Aint mbedtls_cipher_cmac(const mbedtls_cipher_info_t *cipher_info,\0A                        const unsigned char *key, size_t keylen,\0A                        const unsigned char *input, size_t ilen,\0A                        unsigned char *output)\0A{\0A    mbedtls_cipher_context_t ctx;\0A    int ret = MBEDTLS_ERR_ERROR_CORRUPTION_DETECTED;\0A\0A    if (cipher_info == NULL || key == NULL || input == NULL || output == NULL) {\0A        return MBEDTLS_ERR_CIPHER_BAD_INPUT_DATA;\0A    }\0A\0A    mbedtls_cipher_init(&ctx);\0A\0A    if ((ret = mbedtls_cipher_setup(&ctx, cipher_info)) != 0) {\0A        goto exit;\0A    }\0A\0A    ret = mbedtls_cipher_cmac_starts(&ctx, key, keylen);\0A    if (ret != 0) {\0A        goto exit;\0A    }\0A\0A    ret = mbedtls_cipher_cmac_update(&ctx, input, ilen);\0A    i