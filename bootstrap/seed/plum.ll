t mbedtls_asn1_get_enum(unsigned char **p,\0A                          const unsigned char *end,\0A                          int *val)\0A{\0A    return asn1_get_tagged_int(p, end, MBEDTLS_ASN1_ENUMERATED, val);\0A}\0A\0A#if defined(MBEDTLS_BIGNUM_C)\0Aint mbedtls_asn1_get_mpi(unsigned char **p,\0A                         const unsigned char *end,\0A                         mbedtls_mpi *X)\0A{\0A    int ret = MBEDTLS_ERR_ERROR_CORRUPTION_DETECTED;\0A    size_t len;\0A\0A    if ((ret = mbedtls_asn1_get_tag(p, end, &len, MBEDTLS_ASN1_INTEGER)) != 0) {\0A        return ret;\0A    }\0A\0A    ret = mbedtls_mpi_read_binary(X, *p, len);\0A\0A    *p += len;\0A\0A    return ret;\0A}\0A#endif /* MBEDTLS_BIGNUM_C */\0A\0Aint mbedtls_asn1_get_bitstring(unsigned char **p, const unsigned char *end,\0A                               mbedtls_asn1_bitstring *bs)\0A{\0A    int ret = MBEDTLS_ERR_ERROR_CORRUPTION_DETECTED;\0A\0A    /* Certificate type is a single byte bitstring */\0A    if ((ret = mbedtls_asn1_get_tag(p, end, &bs->len, MBEDTLS_ASN1_BIT_STRING)) != 0) {\0A        return ret;\0A    }\0A\0A    /* Check length, subtract one for actual bit string length */\0A    if (bs->len < 1) {\0A        return MBEDTLS_ERR_ASN1_OUT_OF_DATA;\0A    }\0A    bs->len -= 1;\0A\0A    /* Get number of unused bits, ensure unused bits <= 7 */\0A    bs->unused_bits = **p;\0A    if (bs->unused_bits > 7) {\0A        return MBEDTLS_ERR_ASN1_INVALID_LENGTH;\0A    }\0A    (*p)++;\0A\0A    /* Get actual bitstring */\0A    bs->p = *p;\0A    *p += bs->len;\0A\0A    if (*p != end) {\0A        return MBEDTLS_ERR_ASN1_LENGTH_MISMATCH;\0A    }\0A\0A    return 0;\0A}\0A\0A/*\0A * Traverse an ASN.1 \22SEQUENCE OF <tag>\22\0A * and call a callback for each entry found.\0A */\0Aint mbedtls_asn1_traverse_sequence_of(\0A    unsigned char **p,\0A    const unsigned char *end,\0A    unsigned char tag_must_mask, unsigned char tag_must_val,\0A    unsigned char tag_may_mask, unsigned char tag_may_val,\0A    int (*cb)(void *