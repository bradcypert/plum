@.str45812 = private global { i64, i64, [8751 x i8] } { i64 -1, i64 8750, [8751 x i8] c"/**\0A * \5Cfile psa/crypto_compat.h\0A *\0A * \5Cbrief PSA cryptography module: Backward compatibility aliases\0A *\0A * This header declares alternative names for macro and functions.\0A * New application code should not use these names.\0A * These names may be removed in a future version of Mbed TLS.\0A *\0A * \5Cnote This file may not be included directly. Applications must\0A * include psa/crypto.h.\0A */\0A/*\0A *  Copyright The Mbed TLS Contributors\0A *  SPDX-License-Identifier: Apache-2.0 OR GPL-2.0-or-later\0A */\0A\0A#ifndef PSA_CRYPTO_COMPAT_H\0A#define PSA_CRYPTO_COMPAT_H\0A\0A#ifdef __cplusplus\0Aextern \22C\22 {\0A#endif\0A\0A/*\0A * To support both openless APIs and psa_open_key() temporarily, define\0A * psa_key_handle_t to be equal to mbedtls_svc_key_id_t. Do not mark the\0A * type and its utility macros and functions deprecated yet. This will be done\0A * in a subsequent phase.\0A */\0Atypedef mbedtls_svc_key_id_t psa_key_handle_t;\0A\0A#define PSA_KEY_HANDLE_INIT MBEDTLS_SVC_KEY_ID_INIT\0A\0A/** Check whether a handle is null.\0A *\0A * \5Cparam handle  Handle\0A *\0A * \5Creturn Non-zero if the handle is null, zero otherwise.\0A */\0Astatic inline int psa_key_handle_is_null(psa_key_handle_t handle)\0A{\0A    return mbedtls_svc_key_id_is_null(handle);\0A}\0A\0A/** Open a handle to an existing persistent key.\0A *\0A * Open a handle to a persistent key. A key is persistent if it was created\0A * with a lifetime other than #PSA_KEY_LIFETIME_VOLATILE. A persistent key\0A * always has a nonzero key identifier, set with psa_set_key_id() when\0A * creating the key. Implementations may provide additional pre-provisioned\0A * keys that can be opened with psa_open_key(). Such keys have an application\0A * key identifier in the vendor range, as documented in the description of\0A * #psa_key_id_t.\0A *\0A * The application must eventually close the handle with psa_close_key() or\0A * psa_destroy_key() to release associated resources. If the application dies\0A * without calling one of these functions, the implementation should perform\0A * the equivalent of a call to psa_close_key().\0A *\0A * Some implementations permit an application to open the same key multiple\0A * times. If this is successful, each call to psa_open_key() will return a\0A * different key handle.\0A *\0A * \5Cnote This API is not part of the PSA Cryptography API Release 1.0.0\0A * specification. It was defined in the 1.0 Beta 3 version of the\0A * specification but was removed in the 1.0.0 released version. This API is\0A * kept for the time being to not break applications relying on it. It is not\0A * deprecated yet but will be in the near future.\0A *\0A * \5Cnote Applications that rely on opening a key multiple times will not be\0A * portable to implementations that only permit a single key handle to be\0A * opened. See also :ref:\5C`key-handles\5C`.\0A *\0A *\0A * \5Cparam key           The persistent identifier of the key.\0A * \5Cparam[out] handle   On success, a handle to the key.\0A *\0A * \5Cretval #PSA_SUCCESS\0A *         Success. The application can now use the value of `*handle`\0A *         to access the key.\0A * \5Cretval #PSA_ERROR_INSUFFICIENT_MEMORY\0A *         The implementation does not have sufficient resources to open the\0A *         key. This can be due to reaching an implementation limit on the\0A *         number of open keys, the number of open key handles, or available\0A *         memory.\0A * \5Cretval #PSA_ERROR_DOES_NOT_EXIST\0A *         There is no persistent key with key identifier \5Cp key.\0A * \5Cretval #PSA_ERROR_INVALID_ARGUMENT\0A *         \5Cp key is not a valid persistent key identifier.\0A * \5Cretval #PSA_ERROR_NOT_PERMITTED\0A *         The specified key exists, but the application does not have the\0A *         permission to access it. Note that this specification does not\0A *         define any way to create such a key, but it may be possible\0A *         through implementation-specific means.\0A * \5Cretval #PSA_ERROR_COMMUNICATION_FAILURE \5Cemptydescription\0A * \5Cretval #PSA_ERROR_CORRUPTION_DETECTED \5Cemptydescription\0A * \5Cretval #PSA_ERROR_STORAGE_FAILURE \5Cemptydescription\0A * \5Cretval #PSA_ERROR_DATA_INVALID \5Cemptydescription\0A * \5Cretval #PSA_ERROR_DATA_CORRUPT \5Cemptydescription\0A * \5Cretval #PSA_ERROR_BAD_STATE\0A *         The library has not been previously initialized by psa_crypto_init().\0A *         It is implementation-dependent whether a failure to initialize\0A *         results in this error code.\0A */\0Apsa_status_t psa_open_key(mbedtls_svc_key_id_t key,\0A                          psa_key_handle_t *handle);\0A\0A/** Close a key handle.\0A *\0A * If the handle designates a volatile key, this will destroy the key material\0A * and free all associated resources, just like psa_destroy_key().\0A *\0A * If this is the last open handle to a persistent key, then closing the handle\0A * will free all resources associated with the key in volatile memory. The key\0A * data in persistent storage is not affected and can be opened again later\0A * with a call to psa_open_key().\0A *\0A * Closing the key handle makes the handle invalid, and the key handle\0A * must not be used again by the application.\0A *\0A * \5Cnote This API is not part of the PSA Cryptography API Release 1.0.0\0A * specification. It was defined in the 1.0 Beta 3 version of the\0A * specification but was removed in the 1.0.0 released version. This API is\0A * kept for the time being to not break applications relying on it. It is not\0A * deprecated yet but will be in the near future.\0A *\0A * \5Cnote If the key handle was used to set up an active\0A * :ref:\5C`multipart operation <multipart-operations>\5C`, then closing the\0A * key handle can cause the multipart operation to fail. Applications should\0A * maintain the key handle until after the multipart operation has finished.\0A *\0A * \5Cparam handle        The key handle to close.\0A *                      If this is \5Cc 0, do nothing and return \5Cc PSA_SUCCESS.\0A *\0A * \5Cretval #PSA_SUCCESS\0A *         \5Cp handle was a valid handle or \5Cc 0. It is now closed.\0A * \5Cretval #PSA_ERROR_INVALID_HANDLE\0A *         \5Cp handle is not a valid handle nor \5Cc 0.\0A * \5Cretval #PSA_ERROR_COMMUNICATION_FAILURE \5Cemptydescription\0A * \5Cretval #PSA_ERROR_CORRUPTION_DETECTED \5Cemptydescription\0A * \5Cretval #PSA_ERROR_BAD_STATE\0A *         The library has not been previously initialized by psa_crypto_init().\0A *         It is implementation-dependent whether a failure to initialize\0A *         results in this error code.\0A */\0Apsa_status_t psa_close_key(psa_key_handle_t handle);\0A\0A/** \5Caddtogroup attributes\0A * @{\0A */\0A\0A#if !defined(MBEDTLS_DEPRECATED_REMOVED)\0A/** Custom Diffie-Hellman group.\0A *\0A * Mbed TLS does not support custom DH groups.\0A *\0A * \5Cdeprecated This value is not useful, so this macro will be removed in\0A *             a future version of the library.\0A */\0A#define PSA_DH_FAMILY_CUSTOM                                            \5C\0A    ((psa_dh_family_t) MBEDTLS_DEPRECATED_NUMERIC_CONSTANT(0x7e))\0A\0A/**\0A * \5Cbrief Set domain parameters for a key.\0A *\0A * \5Cdeprecated  Mbed TLS no longer supports any domain parameters.\0A *              This function only does the equivalent of\0A *              psa_set_key_type() and will be removed in a future version\0A *              of the library.\0A *\0A * \5Cparam[in,out] attributes    Attribute structure where \5Cp type will be set.\0A * \5Cparam type                  Key type (a \5Cc PSA_KEY_TYPE_XXX value).\0A * \5Cparam[in] data              Ignored.\0A * \5Cparam data_length           Must be 0.\0A *\0A * \5Cretval #PSA_SUCCESS \5Cemptydescription\0A * \5Cretval #PSA_ERROR_NOT_SUPPORTED \5Cemptydescription\0A */\0Astatic inline psa_status_t MBEDTLS_DEPRECATED psa_set_key_domain_parameters(\0A    psa_key_attributes_t *attributes,\0A    psa_key_type_t type, const uint8_t *data, size_t data_length)\0A{\0A    (void) data;\0A    if (data_length != 0) {\0A        return PSA_ERROR_NOT_SUPPORTED;\0A    }\0A    psa_set_key_type(attributes, type);\0A    return PSA_SUCCESS;\0A}\0A\0A/**\0A * \5Cbrief Get domain parameters for a key.\0A *\0A * \5Cdeprecated  Mbed TLS no longer supports any domain parameters.\0A *              This function alwaya has an empty output and will be\0A *              removed in a future version of the library.\0A\0A * \5Cparam[in] attributes        Ignored.\0A * \5Cparam[out] data             Ignored.\0A * \5Cparam data_size             Ignored.\0A * \5Cparam[out] data_length      Set to 0.\0A *\0A * \5Cretval #PSA_SUCCESS \5Cemptydescription\0A */\0Astatic inline psa_status_t MBEDTLS_DEPRECATED psa_get_key_domain_parameters(\0A    const psa_key_attributes_t *attributes,\0A    uint8_t *data, size_t data_size, size_t *data_length)\0A{\0A    (void) attributes;\0A    (void) data;\0A    (void) data_size;\0A    *data_length = 0;\0A    return PSA_SUCCESS;\0A}\0A\0A/** Safe output buffer size for psa_get_key_domain_parameters().\0A *\0A */\0A#define PSA_KEY_DOMAIN_PARAMETERS_SIZE(key_type, key_bits)      \5C\0A    MBEDTLS_DEPRECATED_NUMERIC_CONSTANT(1u)\0A#endif /* MBEDTLS_DEPRECATED_REMOVED */\0A\0A/**@}*/\0A\0A#ifdef __cplusplus\0A}\0A#endif\0A\0A#endif /* PSA_CRYPTO_COMPAT_H */\0A\00" }
