;\0A    }\0A\0A    if (ctx->pk_info == NULL || pk_hashlen_helper(md_alg, &hash_len) != 0) {\0A        return MBEDTLS_ERR_PK_BAD_INPUT_DATA;\0A    }\0A\0A#if defined(MBEDTLS_ECDSA_C) && defined(MBEDTLS_ECP_RESTARTABLE)\0A    /* optimization: use non-restartable version if restart disabled */\0A    if (rs_ctx != NULL &&\0A        mbedtls_ecp_restart_is_enabled() &&\0A        ctx->pk_info->sign_rs_func != NULL) {\0A        int ret = MBEDTLS_ERR_ERROR_CORRUPTION_DETECTED;\0A\0A        if ((ret = pk_restart_setup(rs_ctx, ctx->pk_info)) != 0) {\0A            return ret;\0A        }\0A\0A        ret = ctx->pk_info->sign_rs_func(ctx, md_alg,\0A                                         hash, hash_len,\0A                                         sig, sig_size, sig_len,\0A                                         f_rng, p_rng, rs_ctx->rs_ctx);\0A\0A        if (ret != MBEDTLS_ERR_ECP_IN_PROGRESS) {\0A            mbedtls_pk_restart_free(rs_ctx);\0A        }\0A\0A        return ret;\0A    }\0A#else /* MBEDTLS_ECDSA_C && MBEDTLS_ECP_RESTARTABLE */\0A    (void) rs_ctx;\0A#endif /* MBEDTLS_ECDSA_C && MBEDTLS_ECP_RESTARTABLE */\0A\0A    if (ctx->pk_info->sign_func == NULL) {\0A        return MBEDTLS_ERR_PK_TYPE_MISMATCH;\0A    }\0A\0A    return ctx->pk_info->sign_func(ctx, md_alg,\0A                                   hash, hash_len,\0A                                   sig, sig_size, sig_len,\0A                                   f_rng, p_rng);\0A}\0A\0A/*\0A * Make a signature\0A */\0Aint mbedtls_pk_sign(mbedtls_pk_context *ctx, mbedtls_md_type_t md_alg,\0A                    const unsigned char *hash, size_t hash_len,\0A                    unsigned char *sig, size_t sig_size, size_t *sig_len,\0A                    int (*f_rng)(void *, unsigned char *, size_t), void *p_rng)\0A{\0A    return mbedtls_pk_sign_restartable(ctx, md_alg, hash, hash_len,\0A                                       sig, sig_size, sig_len,\0A                                       f_rng, p_rng, NULL);\0A}\0A\0A/*\0A * Make a signature given a signature type.\0A */\0Aint mbedtls_pk_sign_ext(mbedtls_pk_type_t pk_type,\0A                        mbedtls_pk_context *ctx,\0A                        mbedtls_md_type_t md_alg,\0A                        const unsigned char *hash, size_t hash_len,\0A                        unsigned char *sig, size_t sig_size, size_t *sig_len,\0A                        int (*f_rng)(void *, unsigned char *, size_t),\0A                        void *p_rng)\0A{\0A    if (ctx->pk_info == NULL) {\0A        return MBEDTLS_ERR_PK_BAD_INPUT_DATA;\0A    }\0A\0A    if (!mbedtls_pk_can_do(ctx, pk_type)) {\0A        return MBEDTLS_ERR_PK_TYPE_MISMATCH;\0A    }\0A\0A    if (pk_type != MBEDTLS_PK_RSASSA_PSS) {\0A        return mbedtls_pk_sign(ctx, md_alg, hash, hash_len,\0A                               sig, sig_size, sig_len, f_rng, p_rng);\0A    }\0A\0A#if defined(MBEDTLS_RSA_C) && defined(MBEDTLS_PKCS1_V21)\0A\0A#if defined(MBEDTLS_USE_PSA_CRYPTO)\0A    const psa_algorithm_t psa_md_alg = mbedtls_md_psa_alg_from_type(md_alg);\0A    if (psa_md_alg == 0) {\0A        return MBEDTLS_ERR_PK_BAD_INPUT_DATA;\0A    }\0A\0A    if (mbedtls_pk_get_type(ctx) == MBEDTLS_PK_OPAQUE) {\0A        psa_status_t status;\0A\0A        /* PSA_ALG_RSA_PSS() behaves the same as PSA_ALG_RSA_PSS_ANY_SALT() when\0A         * performing a signature, but they are encoded differently. Instead of\0A         * extracting the proper one from the wrapped key policy, just try both. */\0A        status = psa_sign_hash(ctx->priv_id, PSA_ALG_RSA_PSS(psa_md_alg),\0A                               hash, hash_len,\0A                               sig, sig_size, sig_len);\0A        if (status == PSA_ERROR_NOT_PERMITTED) {\0A            status = psa_sign_hash(ctx->priv_id, PSA_ALG_RSA_PSS_ANY_SALT(psa_md_alg),\0A                                   hash, hash_len,\0A                                   sig, sig_size, sig_len);\0A        }\0A        return PSA_PK_RSA_TO_MBEDTLS_ERR(status);\0A    }\0A\0A    return mbed