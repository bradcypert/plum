=====================\0A * Core const-time primitives\0A */\0A\0A/* Ensure that the compiler cannot know the value of x (i.e., cannot optimise\0A * based on its value) after this function is called.\0A *\0A * If we are not using assembly, this will be fairly inefficient, so its use\0A * should be minimised.\0A */\0A\0A#if !defined(MBEDTLS_CT_ASM)\0Aextern volatile mbedtls_ct_uint_t mbedtls_ct_zero;\0A#endif\0A\0A/**\0A * \5Cbrief   Ensure that a value cannot be known at compile time.\0A *\0A * \5Cparam x        The value to hide from the compiler.\0A * \5Creturn         The same value that was passed in, such that the compiler\0A *                 cannot prove its value (even for calls of the form\0A *                 x = mbedtls_ct_compiler_opaque(1), x will be unknown).\0A *\0A * \5Cnote           This is mainly used in constructing mbedtls_ct_condition_t\0A *                 values and performing operations over them, to ensure that\0A *                 there is no way for the compiler to ever know anything about\0A *                 the value of an mbedtls_ct_condition_t.\0A */\0Astatic inline mbedtls_ct_uint_t mbedtls_ct_compiler_opaque(mbedtls_ct_uint_t x)\0A{\0A#if defined(MBEDTLS_CT_ASM)\0A    asm volatile (\22\22 : [x] \22+r\22 (x) :);\0A    return x;\0A#else\0A    return x ^ mbedtls_ct_zero;\0A#endif\0A}\0A\0A/*\0A * Selecting unified syntax is needed for gcc, and harmless on clang.\0A *\0A * This is needed because on Thumb 1, condition flags are always set, so\0A * e.g. \22negs\22 is supported but \22neg\22 is not (on Thumb 2, both exist).\0A *\0A * Under Thumb 1 unified syntax, only the \22negs\22 form is accepted, and\0A * under divided syntax, only the \22neg\22 form is accepted. clang only\0A * supports unified syntax.\0A *\0A * On Thumb 2 and Arm, both compilers are happy with the \22s\22 suffix,\0A * although we don't actually care about setting the flags.\0A *\0A * For old versions of gcc (see #8516 for details), restore divided\0A * syntax afterwa