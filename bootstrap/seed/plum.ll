@.str57334 = private global { i64, i64, [40119 x i8] } { i64 -1, i64 40118, [40119 x i8] c"/// One header. `name` is as it appeared on the wire; header names are\0A/// case-insensitive in HTTP, so compare with care.\0Apub struct Header { pub name: String, pub value: String }\0A/// A complete response: status, headers, and the whole body as raw bytes.\0A/// Use Response.text to decode UTF-8 explicitly.\0Apub struct Response { pub status: Int, pub headers: Array[Header], pub body: Bytes }\0A/// A response's head, before the body has been read.\0A///\0A/// `leftover_body` is whatever arrived in the same read as the headers\0A/// — a body does not begin on a tidy packet boundary, so those bytes\0A/// have to be handed on rather than dropped.\0Apub struct Head { pub status: Int, pub headers: Array[Header], pub leftover_body: Bytes }\0A/// An incoming request, with its body preserved as raw bytes.\0A/// Use Request.text to decode UTF-8 explicitly.\0Apub struct Request { pub method: String, pub path: String, pub headers: Array[Header], pub body: Bytes }\0A/// A request's first line, split.\0Apub struct RequestLine { pub method: String, pub path: String }\0A/// A request's head, before its body has been read. `leftover_body`\0A/// carries the bytes that arrived alongside the headers.\0Apub struct RequestHead { pub method: String, pub path: String, pub headers: Array[Header], pub leftover_body: Bytes }\0A\0Aextern \22C\22 {\0A    fn tls_connect(host: CStr, port: Int) -> Int;\0A    fn tls_send(handle: Int, buf: CStr, len: Int) -> Int;\0A    fn tls_recv_n(handle: Int, max_len: Int) -> Int;\0A    fn tls_recv_data() -> CStr;\0A    fn tls_close(handle: Int) -> Unit;\0A}\0A\0A// Keep transport policy in one place: explicit byte counts, clean EOF,\0A// and errors have identical meanings for plain TCP and TLS.\0Alet http_read (fd: Int) (secure: Int) (max_len: Int): Result[Bytes, String] =\0A    if secure == 0 { Net.read_bytes(fd, max_len) }\0A    else { unsafe {\0A        let n = tl