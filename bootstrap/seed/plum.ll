@.str42200 = private global { i64, i64, [5951 x i8] } { i64 -1, i64 5950, [5951 x i8] c"// Whole-file I/O for the generated runtime. Keep libc's FILE,\0A// size_t and positioning types on the C side of the boundary: in\0A// particular, Windows long/ftell are only 32 bits even on 64-bit builds.\0A// The caller owns the returned buffer and must free it after copying it\0A// into a Plum cell. NULL means failure; an empty file still owns a buffer.\0A#if !defined(_WIN32)\0A#ifndef _FILE_OFFSET_BITS\0A#define _FILE_OFFSET_BITS 64\0A#endif\0A#ifndef _POSIX_C_SOURCE\0A#define _POSIX_C_SOURCE 200809L\0A#endif\0A#endif\0A\0A#include <stdint.h>\0A#include <stdio.h>\0A#include <stdlib.h>\0A#include <string.h>\0A#include <errno.h>\0A#include <sys/stat.h>\0A\0A#if defined(_WIN32)\0A#include <windows.h>\0A#include <fcntl.h>\0A#include <io.h>\0A#else\0A#include <unistd.h>\0A#endif\0A\0A#if defined(_WIN32)\0A#define PLUM_WHOLE_SEEK _fseeki64\0A#define PLUM_WHOLE_TELL _ftelli64\0A#else\0A#define PLUM_WHOLE_SEEK fseeko\0A#define PLUM_WHOLE_TELL ftello\0A#endif\0A\0Achar *plum_read_whole_file(const char *path, long long *length) {\0A    *length = 0;\0A    FILE *f = fopen(path, \22rb\22);\0A    if (f == NULL) return NULL;\0A    char *buf = NULL;\0A\0A    if (PLUM_WHOLE_SEEK(f, 0, SEEK_END) != 0) goto fail;\0A    int64_t size = PLUM_WHOLE_TELL(f);\0A    // Also reserve the runtime cell's refcount, length and trailing NUL\0A    // (17 bytes). Neither native nor Plum allocation sizes may overflow.\0A    if (size < 0 || (uint64_t)size > INT64_MAX - 17 ||\0A        (uint64_t)size > SIZE_MAX - 17) goto fail;\0A    if (PLUM_WHOLE_SEEK(f, 0, SEEK_SET) != 0) goto fail;\0A\0A    buf = malloc((size_t)size + 1);\0A    if (buf == NULL) goto fail;\0A    size_t got = fread(buf, 1, (size_t)size, f);\0A    if (ferror(f) || got != (size_t)size) goto fail;\0A    if (fclose(f) != 0) {\0A        free(buf);\0A        return NULL;\0A    }\0A    buf[got] = '\5C0';\0A    *length = size;\0A    return buf;\0A\0Afail:\0A    fclose(f);\0A    free(buf);\0A    return NULL;\0A}\0A\0A// Shared with Os.rename_file. Never falls back to a cross-volume copy.\0Aextern long long os_rename_file(const char *from, const char *to);\0A\0A#if defined(_WIN32)\0Astatic wchar_t *plum_whole_wide(const char *path) {\0A    int n = MultiByteToWideChar(CP_UTF8, MB_ERR_INVALID_CHARS, path, -1, NULL, 0);\0A    if (n <= 0) return NULL;\0A    wchar_t *w = malloc((size_t)n * sizeof(wchar_t));\0A    if (w != NULL && !MultiByteToWideChar(CP_UTF8, MB_ERR_INVALID_CHARS, path, -1, w, n)) {\0A        free(w);\0A        return NULL;\0A    }\0A    return w;\0A}\0A#endif\0A\0A// Borrow the payload; do not copy it into another file-sized buffer.\0A// Only the sibling name (O(path length)) and libc's bounded FILE buffer\0A// are allocated here. Every ordinary failure releases both before return.\0Along long plum_write_whole_file(const char *path, const char *data, long long length) {\0A    if (length < 0 || (uint64_t)length > SIZE_MAX) return -1;\0A    size_t n = strlen(path);\0A    if (n > SIZE_MAX - 64) return -1;\0A    char *tmp = malloc(n + 64);\0A    if (tmp == NULL) return -1;\0A    // Use a short basename even when the destination already uses NAME_MAX.\0A    const char *slash = strrchr(path, '/');\0A#if defined(_WIN32)\0A    const char *backslash = strrchr(path, '\5C\5C');\0A    if (backslash != NULL && (slash == NULL || backslash > slash)) slash = backslash;\0A#endif\0A    size_t prefix = slash == NULL ? 0 : (size_t)(slash - path) + 1;\0A#if defined(_WIN32)\0A    if (prefix == 0 && n >= 2 && path[1] == ':') prefix = 2;\0A#endif\0A    memcpy(tmp, path, prefix);\0A    int fd = -1;\0A    long long result = -1;\0A#if defined(_WIN32)\0A    wchar_t *dest = plum_whole_wide(path);\0A    wchar_t *wide_tmp = NULL;\0A    if (dest == NULL) goto done;\0A    DWORD attrs = GetFileAttributesW(dest);\0A    if (attrs == INVALID_FILE_ATTRIBUTES) {\0A        DWORD err = GetLastError();\0A        if (err != ERROR_FILE_NOT_FOUND && err != ERROR_PATH_NOT_FOUND) goto done;\0A    } else if (attrs & (FILE_ATTRIBUTE_DIRECTORY | FILE_ATTRIBUTE_REPARSE_POINT |\0A                        FILE_ATTRIBUTE_READONLY)) goto done;\0A    // CREATE_NEW semantics via _O_EXCL. Predictability is harmless: no\0A    // pre-existing file (including a reparse point) is ever opened.\0A    static volatile LONG sequence;\0A    for (int attempt = 0; attempt < 128; attempt++) {\0A        snprintf(tmp + prefix, n + 64 - prefix, \22.plum-%lu-%lu.tmp\22,\0A                 (unsigned long)GetCurrentProcessId(),\0A                 (unsigned long)InterlockedIncrement(&sequence));\0A        free(wide_tmp);\0A        wide_tmp = plum_whole_wide(tmp);\0A        if (wide_tmp == NULL) goto done;\0A        fd = _wopen(wide_tmp, _O_WRONLY | _O_BINARY | _O_CREAT | _O_EXCL,\0A                    _S_IREAD | _S_IWRITE);\0A        if (fd >= 0) break;\0A        if (errno != EEXIST) goto done;\0A    }\0A    if (fd < 0) goto done;\0A    FILE *f = _fdopen(fd, \22wb\22);\0A    if (f == NULL) { _close(fd); goto remove_tmp; }\0A#else\0A    struct stat st;\0A    int exists = lstat(path, &st) == 0;\0A    if (!exists && errno != ENOENT) goto done;\0A    // Do not turn a device, FIFO or symlink into a regular file, or\0A    // follow it and modify some other object. Parent paths are trusted.\0A    if (exists && !S_ISREG(st.st_mode)) goto done;\0A    memcpy(tmp + prefix, \22.plum-XXXXXX\22, sizeof(\22.plum-XXXXXX\22));\0A    fd = mkstemp(tmp);\0A    if (fd < 0) goto done;\0A    FILE *f = fdopen(fd, \22wb\22);\0A    if (f == NULL) { close(fd); goto remove_tmp; }\0A#endif\0A    size_t wrote = fwrite(data, 1, (size_t)length, f);\0A    int ok = wrote == (size_t)length && !ferror(f);\0A#if !defined(_WIN32)\0A    // Preserve ordinary permissions for replacements, including executable\0A    // bits. New files retain mkstemp's private 0600 permissions. Ownership,\0A    // hard-link identity, ACLs and other inode metadata are not copied.\0A    if (ok && exi