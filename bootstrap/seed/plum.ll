@.str43026 = private global { i64, i64, [107885 x i8] } { i64 -1, i64 107884, [107885 x i8] c"/*\0A *  TLS 1.3 client-side functions\0A *\0A *  Copyright The Mbed TLS Contributors\0A *  SPDX-License-Identifier: Apache-2.0 OR GPL-2.0-or-later\0A */\0A\0A#include \22common.h\22\0A\0A#if defined(MBEDTLS_SSL_CLI_C) && defined(MBEDTLS_SSL_PROTO_TLS1_3)\0A\0A#include <string.h>\0A\0A#include \22debug_internal.h\22\0A#include \22mbedtls/error.h\22\0A#include \22mbedtls/platform.h\22\0A\0A#include \22ssl_misc.h\22\0A#include \22ssl_client.h\22\0A#include \22ssl_tls13_keys.h\22\0A#include \22ssl_debug_helpers.h\22\0A#include \22mbedtls/psa_util.h\22\0A\0A#if defined(MBEDTLS_SSL_TLS1_3_KEY_EXCHANGE_MODE_SOME_EPHEMERAL_ENABLED)\0A/* Define a local translating function to save code size by not using too many\0A * arguments in each translating place. */\0Astatic int local_err_translation(psa_status_t status)\0A{\0A    return psa_status_to_mbedtls(status, psa_to_ssl_errors,\0A                                 ARRAY_LENGTH(psa_to_ssl_errors),\0A                                 psa_generic_status_to_mbedtls);\0A}\0A#define PSA_TO_MBEDTLS_ERR(status) local_err_translation(status)\0A#endif\0A\0A/* Write extensions */\0A\0A/*\0A * ssl_tls13_write_supported_versions_ext():\0A *\0A * struct {\0A *      ProtocolVersion versions<2..254>;\0A * } SupportedVersions;\0A */\0AMBEDTLS_CHECK_RETURN_CRITICAL\0Astatic int ssl_tls13_write_supported_versions_ext(mbedtls_ssl_context *ssl,\0A                                                  unsigned char *buf,\0A                                                  unsigned char *end,\0A                                                  size_t *out_len)\0A{\0A    unsigned char *p = buf;\0A    unsigned char versions_len = (ssl->handshake->min_tls_version <=\0A                                  MBEDTLS_SSL_VERSION_TLS1_2) ? 4 : 2;\0A\0A    *out_len = 0;\0A\0A    MBEDTLS_SSL_DEBUG_MSG(3, (\22client hello, adding supported versions extension\22));\0A\0A    /* Ch