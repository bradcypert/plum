_WITH_ARIA_128_GCM_SHA256\0A *      MBEDTLS_TLS_RSA_WITH_ARIA_256_GCM_SHA384\0A *      MBEDTLS_TLS_DHE_RSA_WITH_ARIA_128_GCM_SHA256\0A *      MBEDTLS_TLS_DHE_RSA_WITH_ARIA_256_GCM_SHA384\0A *      MBEDTLS_TLS_ECDHE_ECDSA_WITH_ARIA_128_GCM_SHA256\0A *      MBEDTLS_TLS_ECDHE_ECDSA_WITH_ARIA_256_GCM_SHA384\0A *      MBEDTLS_TLS_ECDH_ECDSA_WITH_ARIA_128_GCM_SHA256\0A *      MBEDTLS_TLS_ECDH_ECDSA_WITH_ARIA_256_GCM_SHA384\0A *      MBEDTLS_TLS_ECDHE_RSA_WITH_ARIA_128_GCM_SHA256\0A *      MBEDTLS_TLS_ECDHE_RSA_WITH_ARIA_256_GCM_SHA384\0A *      MBEDTLS_TLS_ECDH_RSA_WITH_ARIA_128_GCM_SHA256\0A *      MBEDTLS_TLS_ECDH_RSA_WITH_ARIA_256_GCM_SHA384\0A *      MBEDTLS_TLS_PSK_WITH_ARIA_128_CBC_SHA256\0A *      MBEDTLS_TLS_PSK_WITH_ARIA_256_CBC_SHA384\0A *      MBEDTLS_TLS_DHE_PSK_WITH_ARIA_128_CBC_SHA256\0A *      MBEDTLS_TLS_DHE_PSK_WITH_ARIA_256_CBC_SHA384\0A *      MBEDTLS_TLS_RSA_PSK_WITH_ARIA_128_CBC_SHA256\0A *      MBEDTLS_TLS_RSA_PSK_WITH_ARIA_256_CBC_SHA384\0A *      MBEDTLS_TLS_PSK_WITH_ARIA_128_GCM_SHA256\0A *      MBEDTLS_TLS_PSK_WITH_ARIA_256_GCM_SHA384\0A *      MBEDTLS_TLS_DHE_PSK_WITH_ARIA_128_GCM_SHA256\0A *      MBEDTLS_TLS_DHE_PSK_WITH_ARIA_256_GCM_SHA384\0A *      MBEDTLS_TLS_RSA_PSK_WITH_ARIA_128_GCM_SHA256\0A *      MBEDTLS_TLS_RSA_PSK_WITH_ARIA_256_GCM_SHA384\0A *      MBEDTLS_TLS_ECDHE_PSK_WITH_ARIA_128_CBC_SHA256\0A *      MBEDTLS_TLS_ECDHE_PSK_WITH_ARIA_256_CBC_SHA384\0A */\0A#define MBEDTLS_ARIA_C\0A\0A/**\0A * \5Cdef MBEDTLS_CCM_C\0A *\0A * Enable the Counter with CBC-MAC (CCM) mode for 128-bit block cipher.\0A *\0A * Module:  library/ccm.c\0A *\0A * Requires: MBEDTLS_CIPHER_C, MBEDTLS_AES_C or MBEDTLS_CAMELLIA_C or\0A *                             MBEDTLS_ARIA_C\0A *\0A * This module enables the AES-CCM ciphersuites, if other requisites are\0A * enabled as well.\0A */\0A#define MBEDTLS_CCM_C\0A\0A/**\0A * \5Cdef MBEDTLS_CHACHA20_C\0A *\0A * Enable the ChaCha20 stream cipher.\0A *\0A * Module:  library/chacha20.c\0A */\0A#define MBEDTLS_CHACHA20_C\0A\0A/**\0A * \5Cdef MBEDTLS_CHACHAPOLY_C\0A *\0A * Enable the ChaCha20-Poly1305 AEAD algorithm.\0A *\0A * Module:  library/chachapoly.c\0A *\0A * This module requires: MBEDTLS_CHACHA20_C, MBEDTLS_POLY1305_C\0A */\0A#define MBEDTLS_CHACHAPOLY_C\0A\0A/**\0A * \5Cdef MBEDTLS_CIPHER_C\0A *\0A * Enable the generic cipher layer.\0A *\0A * Module:  library/cipher.c\0A * Caller:  library/ccm.c\0A *          library/cmac.c\0A *          library/gcm.c\0A *          library/nist_kw.c\0A *          library/pkcs12.c\0A *          library/pkcs5.c\0A *          library/psa_crypto_aead.c\0A *          library/psa_crypto_mac.c\0A *          library/ssl_ciphersuites.c\0A *          library/ssl_msg.c\0A *          library/ssl_ticket.c (unless MBEDTLS_USE_PSA_CRYPTO is enabled)\0A * Auto-enabled by: MBEDTLS_PSA_CRYPTO_C depending on which ciphers are enabled\0A *                  (see the documentation of that option for details).\0A *\0A * Uncomment to enable generic cipher wrappers.\0A */\0A#define MBEDTLS_CIPHER_C\0A\0A/**\0A * \5Cdef MBEDTLS_CMAC_C\0A *\0A * Enable the CMAC (Cipher-based Message Authentication Code) mode for block\0A * ciphers.\0A *\0A * \5Cnote When #MBEDTLS_CMAC_ALT is active, meaning that the underlying\0A *       implementation of the CMAC algorithm is provided by an alternate\0A *       implementation, that alternate implementation may opt to not support\0A *       AES-192 or 3DES as underlying block ciphers for the CMAC operation.\0A *\0A * Module:  library/cmac.c\0A *\0A * Requires: MBEDTLS_CIPHER_C, MBEDTLS_AES_C or MBEDTLS_DES_C\0A *\0A */\0A#define MBEDTLS_CMAC_C\0A\0A/**\0A * \5Cdef MBEDTLS_CTR_DRBG_C\0A *\0A * Enable the CTR_DRBG AES-based random generator.\0A * The CTR_DRBG generator uses AES-256 by default.\0A * To use AES-128 instead, enable \5Cc MBEDTLS_CTR_DRBG_USE_128_BIT_KEY above.\0A *\0A * AES support can either be achieved through builtin (MBEDTLS_AES_C) or PSA.\0A * Builtin is the default option when MBEDTLS_AES_C is defined otherwise PSA\0A * is used.\0A *\0A * \5Cwarning When using PSA, the user should call `psa_crypto_init()` before\0A *          using any CTR_DRBG operation (except `mbedtls_ctr_drbg_init()`).\0A *\0A * \5Cnote AES-128 will be used if \5Cc MBEDTLS_AES_ONLY_128_BIT_KEY_LENGTH is set.\0A *\0A * \5Cnote To achieve a 256-bit security strength with CTR_DRBG,\0A *       you must use AES-256 *and* use sufficient entropy.\0A *       See ctr_drbg.h for more details.\0A *\0A * Module:  library/ctr_drbg.c\0A * Caller:\0A *\0A * Requires: MBEDTLS_AES_C or\0A *           (PSA_WANT_KEY_TYPE_AES and PSA_WANT_ALG_ECB_NO_PADDING and\0A *            MBEDTLS_PSA_CRYPTO_C)\0A *\0A * This module provides the CTR_DRBG AES random number generator.\0A */\0A#define MBEDTLS_CTR_DRBG_C\0A\0A/**\0A * \5Cdef MBEDTLS_DEBUG_C\0A *\0A * Enable the debug functions.\0A *\0A * Module:  library/debug.c\0A * Caller:  library/ssl_msg.c\0A *          library/ssl_tls.c\0A *          library/ssl_tls12_*.c\0A *          library/ssl_tls13_*.c\0A *\0A * This module provides debugging functions.\0A */\0A#define MBEDTLS_DEBUG_C\0A\0A/**\0A * \5Cdef MBEDTLS_DES_C\0A *\0A * Enable the DES block cipher.\0A *\0A * Module:  library/des.c\0A * Caller:  library/pem.c\0A *          library/cipher.c\0A *\0A * PEM_PARSE uses DES/3DES for decrypting encrypted keys.\0A *\0A * \5Cwarning   DES/3DES are considered weak ciphers and their use constitutes a\0A *            security risk. We recommend considering stronger ciphers instead.\0A */\0A#define MBEDTLS_DES_C\0A\0A/**\0A * \5Cdef MBEDTLS_DHM_C\0A *\0A * Enable the Diffie-Hellman-Merkle module.\0A *\0A * Module:  library/dhm.c\0A * Caller:  library/ssl_tls.c\0A *          library/ssl*_client.c\0A *          library/ssl*_server.c\0A *\0A * This module is used by the following key exchanges:\0A *      DHE-RSA, DHE-PSK\0A *\0A * \5Cwarning    Using DHE constitutes a security risk as it\0A *             is not possible to validate custom DH parameters.\0A *             If possible, it is recommended users should consider\0A *             preferring other methods of key exchange.\0A *             See dhm.h for more details.\0A *\0A */\0A#define MBEDTLS_DHM_C\0A\0A/**\0A * \5Cdef MBEDTLS_ECDH_C\0A *\0A * Enable the elliptic curve Diffie-Hellman library.\0A *\0A * Module:  library/ecdh.c\0A * Caller:  library/psa_crypto.c\0A *          library/ssl_tls.c\0A *          library/ssl*_client.c\0A *          library/ssl*_server.c\0A *\0A * This module is used by the following key exchanges:\0A *      ECDHE-ECDSA, ECDHE-RSA, DHE-PSK\0A *\0A * Requires: MBEDTLS_ECP_C\0A */\0A#define MBEDTLS_ECDH_C\0A\0A/**\0A * \5Cdef MBEDTLS_ECDSA_C\0A *\0A * Enable the elliptic curve DSA library.\0A *\0A * Module:  library/ecdsa.c\0A * Caller:\0A *\0A * This module is used by the following key exchanges:\0A *      ECDHE-ECDSA\0A *\0A * Requires: MBEDTLS_ECP_C, MBEDTLS_ASN1_WRITE_C, MBEDTLS_ASN1_PARSE_C,\0A *           and at least one MBEDTLS_ECP_DP_XXX_ENABLED for a\0A *           short Weierstrass curve.\0A */\0A#define MBEDTLS_ECDSA_C\0A\0A/**\0A * \5Cdef MBEDTLS_ECJPAKE_C\0A *\0A * Enable the elliptic curve J-PAKE library.\0A *\0A * \5Cnote EC J-PAKE support is based on the Thread v1.0.0 specification.\0A *       It has not been reviewed for compliance with newer standards such as\0A *       Thread v1.1 or RFC 8236.\0A *\0A * Module:  library/ecjpake.c\0A * Caller:\0A *\0A * This module is used by the following key exchanges:\0A *      ECJPAKE\0A *\0A * Requires: MBEDTLS_ECP_C and either MBEDTLS_MD_C or MBEDTLS_PSA_CRYPTO_C\0A *\0A * \5Cwarning If using a hash that is only provided by PSA drivers, you must\0A * call psa_crypto_init() before doing any EC J-PAKE operations.\0A */\0A#define MBEDTLS_ECJPAKE_C\0A\0A/**\0A * \5Cdef MBEDTLS_ECP_C\0A *\0A * Enable the elliptic curve over GF(p) library.\0A *\0A * Module:  library/ecp.c\0A * Caller:  library/ecdh.c\0A *          library/ecdsa.c\0A *          library/ecjpake.c\0A *\0A * Requires: MBEDTLS_BIGNUM_C and at least one MBEDTLS_ECP_DP_XXX_ENABLED\0A */\0A#define MBEDTLS_ECP_C\0A\0A/**\0A * \5Cdef MBEDTLS_ENTROPY_C\0A *\0A * Enable the platform-specific entropy code.\0A *\0A * Module:  library/entropy.c\0A * Caller:\0A *\0A * Requires: MBEDTLS_SHA512_C or MBEDTLS_SHA256_C\0A *\0A * This module provides a generic entropy pool\0A */\0A#define MBEDTLS_ENTROPY_C\0A\0A/**\0A * \5Cdef MBEDTLS_ERROR_C\0A *\0A * Enable error code to error string conversion.\0A *\0A * Module:  library/error.c\0A * Caller:\0A *\0A * This module enables mbedtls_strerror().\0A */\0A#define MBEDTLS_ERROR_C\0A\0A/**\0A * \5Cdef MBEDTLS_GCM_C\0A *\0A * Enable the Galois/Counter Mode (GCM).\0A *\0A * Module:  library/gcm.c\0A *\0A * Requires: MBEDTLS_CIPHER_C, MBEDTLS_AES_C or MBEDTLS_CAMELLIA_C or\0A *                             MBEDTLS_ARIA_C\0A *\0A * This module enables the AES-GCM and CAMELLIA-GCM ciphersuites, if other\0A * requisites are enabled as well.\0A */\0A#define MBEDTLS_GCM_C\0A\0A/**\0A * \5Cdef MBEDTLS_GCM_LARGE_TABLE\0A *\0A * Enable large pre-computed tables for  Galois/Counter Mode (GCM).\0A * Can significantly increase throughput on systems without GCM hardware\0A * acceleration (e.g., AESNI, AESCE).\0A *\0A * The mbedtls_gcm_context size will increase by 3840 bytes.\0A * The code size will increase by roughly 344 bytes.\0A *\0A * Module:  library/gcm.c\0A *\0A * Requires: MBEDTLS_GCM_C\0A */\0A//#define MBEDTLS_GCM_LARGE_TABLE\0A\0A/**\0A * \5Cdef MBEDTLS_HKDF_C\0A *\0A * Enable the HKDF algorithm (RFC 5869).\0A *\0A * Module:  library/hkdf.c\0A * Caller:\0A *\0A * Requires: MBEDTLS_MD_C\0A *\0A * This module adds support for the Hashed Message Authentication Code\0A * (HMAC)-based key derivation function (HKDF).\0A */\0A#define MBEDTLS_HKDF_C\0A\0A/**\0A * \5Cdef MBEDTLS_HMAC_DRBG_C\0A *\0A * Enable the HMAC_DRBG random generator.\0A *\0A * Module:  library/hmac_drbg.c\0A * Caller:\0A *\0A * Requires: MBEDTLS_MD_C\0A *\0A * Uncomment to enable the HMAC_DRBG random number generator.\0A */\0A#define MBEDTLS_HMAC_DRBG_C\0A\0A/**\0A * \5Cdef MBEDTLS_LMS_C\0A *\0A * Enable the LMS stateful-hash asymmetric signature algorithm.\0A *\0A * Module:  library/lms.c\0A * Caller:\0A *\0A * Requires: MBEDTLS_PSA_CRYPTO_C\0A *\0A * Uncomment to enable the LMS verification algorithm and public key operations.\0A */\0A#define MBEDTLS_LMS_C\0A\0A/**\0A * \5Cdef MBEDTLS_LMS_PRIVATE\0A *\0A * Enable LMS private-key operations and signing code. Functions enabled by this\0A * option are experimental, and should not be used in production.\0A *\0A * Requires: MBEDTLS_LMS_C\0A *\0A * Uncomment to enable the LMS signature algorithm and private key operations.\0A */\0A//#define MBEDTLS_LMS_PRIVATE\0A\0A/**\0A * \5Cdef MBEDTLS_NIST_KW_C\0A *\0A * Enable the Key Wrapping mode for 128-bit block ciphers,\0A * as defined in NIST SP 800-38F. Only KW and KWP modes\0A * are supported. At the moment, only AES is approved by NIST.\0A *\0A * Module:  library/nist_kw.c\0A *\0A * Requires: MBEDTLS_AES_C and MBEDTLS_CIPHER_C\0A */\0A#define MBEDTLS_NIST_KW_C\0A\0A/**\0A * \5Cdef MBEDTLS_MD_C\0A *\0A * Enable the generic layer for message digest (hashing) and HMAC.\0A *\0A * Requires: one of: MBEDTLS_MD5_C, MBEDTLS_RIPEMD160_C, MBEDTLS_SHA1_C,\0A *                   MBEDTLS_SHA224_C, MBEDTLS_SHA256_C, MBEDTLS_SHA384_C,\0A *                   MBEDTLS_SHA512_C, or MBEDTLS_PSA_CRYPTO_C with at least\0A *                   one hash.\0A * Module:  library/md.c\0A * Caller:  library/constant_time.c\0A *          library/ecdsa.c\0A *          library/ecjpake.c\0A *          library/hkdf.c\0A *          library/hmac_drbg.c\0A *          library/pk.c\0A *          library/pkcs5.c\0A *          library/pkcs12.c\0A *          library/psa_crypto_ecp.c\0A *          library/psa_crypto_rsa.c\0A *          library/rsa.c\0A *          library/ssl_cookie.c\0A *          library/ssl_msg.c\0A *          library/ssl_tls.c\0A *          library/x509.c\0A *          library/x509_crt.c\0A *          library/x509write_crt.c\0A *          library/x509write_csr.c\0A *\0A * Uncomment to enable generic message digest wrappers.\0A */\0A#define MBEDTLS_MD_C\0A\0A/**\0A * \5Cdef MBEDTLS_MD5_C\0A *\0A * Enable the MD5 hash algorithm.\0A *\0A * Module:  library/md5.c\0A * Caller:  library/md.c\0A *          library/pem.c\0A *          library/ssl_tls.c\0A *\0A * This module is required for TLS 1.2 depending on the handshake parameters.\0A * Further, it is used for checking MD5-signed certificates, and for PBKDF1\0A * when decrypting PEM-encoded encrypted keys.\0A *\0A * \5Cwarning   MD5 is considered a weak message digest and its use constitutes a\0A *            security risk. If possible, we recommend avoiding dependencies on\0A *            it, and considering stronger message digests instead.\0A *\0A */\0A#define MBEDTLS_MD5_C\0A\0A/**\0A * \5Cdef MBEDTLS_MEMORY_BUFFER_ALLOC_C\0A *\0A * Enable the buffer allocator implementation that makes use of a (stack)\0A * based buffer to 'allocate' dynamic memory. (replaces calloc() and free()\0A * calls)\0A *\0A * Module:  library/memory_buffer_alloc.c\0A *\0A * Requires: MBEDTLS_PLATFORM_C\0A *           MBEDTLS_PLATFORM_MEMORY (to use it within Mbed TLS)\0A *\0A * Enable this module to enable the buffer memory allocator.\0A */\0A//#define MBEDTLS_MEMORY_BUFFER_ALLOC_C\0A\0A/**\0A * \5Cdef MBEDTLS_NET_C\0A *\0A * Enable the TCP and UDP over IPv6/IPv4 networking routines.\0A *\0A * \5Cnote This module only works on POSIX/Unix (including Linux, BSD and OS X)\0A * and Windows. For other platforms, you'll want to disable it, and write your\0A * own networking callbacks to be passed to \5Cc mbedtls_ssl_set_bio().\0A *\0A * \5Cnote See also our Knowledge Base article about porting to a new\0A * environment:\0A * https://mbed-tls.readthedocs.io/en/latest/kb/how-to/how-do-i-port-mbed-tls-to-a-new-environment-OS\0A *\0A * Module:  library/net_sockets.c\0A *\0A * This module provides networking routines.\0A */\0A#define MBEDTLS_NET_C\0A\0A/**\0A * \5Cdef MBEDTLS_OID_C\0A *\0A * Enable the OID database.\0A *\0A * Module:  library/oid.c\0A * Caller:  library/asn1write.c\0A *          library/pkcs5.c\0A *          library/pkparse.c\0A *          library/pkwrite.c\0A *          library/rsa.c\0A *          library/x509.c\0A *          library/x509_create.c\0A *          library/x509_crl.c\0A *          library/x509_crt.c\0A *          library/x509_csr.c\0A *          library/x509write_crt.c\0A *          library/x509write_csr.c\0A *\0A * This modules translates between OIDs and internal values.\0A */\0A#define MBEDTLS_OID_C\0A\0A/**\0A * \5Cdef MBEDTLS_PADLOCK_C\0A *\0A * Enable VIA Padlock support on x86.\0A *\0A * Module:  library/padlock.c\0A * Caller:  library/aes.c\0A *\0A * Requires: MBEDTLS_HAVE_ASM\0A *\0A * This modules adds support for the VIA PadLock on x86.\0A */\0A#define MBEDTLS_PADLOCK_C\0A\0A/**\0A * \5Cdef MBEDTLS_PEM_PARSE_C\0A *\0A * Enable PEM decoding / parsing.\0A *\0A * Module:  library/pem.c\0A * Caller:  library/dhm.c\0A *          library/pkparse.c\0A *          library/x509_crl.c\0A *          library/x509_crt.c\0A *          library/x509_csr.c\0A *\0A * Requires: MBEDTLS_BASE64_C\0A *           optionally MBEDTLS_MD5_C, or PSA Crypto with MD5 (see below)\0A *\0A * \5Cwarning When parsing password-protected files, if MD5 is provided only by\0A * a PSA driver, you must call psa_crypto_init() before the first file.\0A *\0A * This modules adds support for decoding / parsing PEM files.\0A */\0A#define MBEDTLS_PEM_PARSE_C\0A\0A/**\0A * \5Cdef MBEDTLS_PEM_WRITE_C\0A *\0A * Enable PEM encoding / writing.\0A *\0A * Module:  library/pem.c\0A * Caller:  library/pkwrite.c\0A *          library/x509write_crt.c\0A *          library/x509write_csr.c\0A *\0A * Requires: MBEDTLS_BASE64_C\0A *\0A * This modules adds support for encoding / writing PEM files.\0A */\0A#define MBEDTLS_PEM_WRITE_C\0A\0A/**\0A * \5Cdef MBEDTLS_PK_C\0A *\0A * Enable the generic public (asymmetric) key layer.\0A *\0A * Module:  library/pk.c\0A * Caller:  library/psa_crypto_rsa.c\0A *          library/ssl_tls.c\0A *          library/ssl*_client.c\0A *          library/ssl*_server.c\0A *          library/x509.c\0A *\0A * Requires: MBEDTLS_MD_C, MBEDTLS_RSA_C or MBEDTLS_ECP_C\0A *\0A * Uncomment to enable generic public key wrappers.\0A */\0A#define MBEDTLS_PK_C\0A\0A/**\0A * \5Cdef MBEDTLS_PK_PARSE_C\0A *\0A * Enable the generic public (asymmetric) key parser.\0A *\0A * Module:  library/pkparse.c\0A * Caller:  library/x509_crt.c\0A *          library/x509_csr.c\0A *\0A * Requires: MBEDTLS_ASN1_PARSE_C, MBEDTLS_OID_C, MBEDTLS_PK_C\0A *\0A * Uncomment to enable generic public key parse functions.\0A */\0A#define MBEDTLS_PK_PARSE_C\0A\0A/**\0A * \5Cdef MBEDTLS_PK_WRITE_C\0A *\0A * Enable the generic public (asymmetric) key writer.\0A *\0A * Module:  library/pkwrite.c\0A * Caller:  library/x509write.c\0A *\0A * Requires: MBEDTLS_ASN1_WRITE_C, MBEDTLS_OID_C, MBEDTLS_PK_C\0A *\0A * Uncomment to enable generic public key write functions.\0A */\0A#define MBEDTLS_PK_WRITE_C\0A\0A/**\0A * \5Cdef MBEDTLS_PKCS5_C\0A *\0A * Enable PKCS#5 functions.\0A *\0A * Module:  library/pkcs5.c\0A *\0A * Auto-enables: MBEDTLS_MD_C\0A *\0A * \5Cwarning If using a hash that is only provided by PSA drivers, you must\0A * call psa_crypto_init() before doing any PKCS5 operations.\0A *\0A * This module adds support for the PKCS#5 functions.\0A */\0A#define MBEDTLS_PKCS5_C\0A\0A/**\0A * \5Cdef MBEDTLS_PKCS7_C\0A *\0A * Enable PKCS #7 core for using PKCS #7-formatted signatures.\0A * RFC Link - https://tools.ietf.org/html/rfc2315\0A *\0A * Module:  library/pkcs7.c\0A *\0A * Requires: MBEDTLS_ASN1_PARSE_C, MBEDTLS_OID_C, MBEDTLS_PK_PARSE_C,\0A *           MBEDTLS_X509_CRT_PARSE_C MBEDTLS_X509_CRL_PARSE_C,\0A *           MBEDTLS_BIGNUM_C, MBEDTLS_MD_C\0A *\0A * This module is required for the PKCS #7 parsing modules.\0A */\0A#define MBEDTLS_PKCS7_C\0A\0A/**\0A * \5Cdef MBEDTLS_PKCS12_C\0A *\0A * Enable PKCS#12 PBE functions.\0A * Adds algorithms for parsing PKCS#8 encrypted private keys\0A *\0A * Module:  library/pkcs12.c\0A * Caller:  library/pkparse.c\0A *\0A * Requires: MBEDTLS_ASN1_PARSE_C and either MBEDTLS_MD_C or\0A *           MBEDTLS_PSA_CRYPTO_C.\0A *\0A * \5Cwarning If using a hash that is only provided by PSA drivers, you must\0A * call psa_crypto_init() before doing any PKCS12 operations.\0A *\0A * This module enables PKCS#12 functions.\0A */\0A#define MBEDTLS_PKCS12_C\0A\0A/**\0A * \5Cdef MBEDTLS_PLATFORM_C\0A *\0A * Enable the platform abstraction layer that allows you to re-assign\0A * functions like calloc(), free(), snprintf(), printf(), fprintf(), exit().\0A *\0A * Enabling MBEDTLS_PLATFORM_C enables to use of MBEDTLS_PLATFORM_XXX_ALT\0A * or MBEDTLS_PLATFORM_XXX_MACRO directives, allowing the functions mentioned\0A * above to be specified at runtime or compile time respectively.\0A *\0A * \5Cnote This abstraction layer must be enabled on Windows (including MSYS2)\0A * as other modules rely on it for a fixed snprintf implementation.\0A *\0A * Module:  library/platform.c\0A * Caller:  Most other .c files\0A *\0A * This module enables abstraction of common (libc) functions.\0A */\0A#define MBEDTLS_PLATFORM_C\0A\0A/**\0A * \5Cdef MBEDTLS_POLY1305_C\0A *\0A * Enable the Poly1305 MAC algorithm.\0A *\0A * Module:  library/poly1305.c\0A * Caller:  library/chachapoly.c\0A */\0A#define MBEDTLS_POLY1305_C\0A\0A/**\0A * \5Cdef MBEDTLS_PSA_CRYPTO_C\0A *\0A * Enable the Platform Security Architecture (PSA) cryptography API.\0A *\0A * \5Cnote In multithreaded applications, you must enable #MBEDTLS_THREADING_C,\0A *       unless only one thread ever calls `psa_xxx()` functions.\0A *       That includes indirect calls, such as:\0A *       - performing a TLS handshake if support for TLS 1.3 is enabled;\0A *       - using a TLS 1.3 connection;\0A *       - indirect calls from PK, X.509 or SSL functions when\0A *         #MBEDTLS_USE_PSA_CRYPTO is enabled;\0A *       - indirect calls to calculate a hash when #MBEDTLS_MD_C is disabled;\0A *       - any other call to a function that requires calling psa_crypto_init()\0A *         beforehand.\0A *\0A * Module:  library/psa_crypto.c\0A *\0A * Requires: either MBEDTLS_CTR_DRBG_C and MBEDTLS_ENTROPY_C,\0A *           or MBEDTLS_HMAC_DRBG_C and MBEDTLS_ENTROPY_C,\0A *           or MBEDTLS_PSA_CRYPTO_EXTERNAL_RNG.\0A * Auto-enables: MBEDTLS_CIPHER_C if any unauthenticated (ie, non-AEAD) cipher\0A *               is enabled in PSA (unless it's fully accelerated, see\0A *               docs/driver-only-builds.md about that).\0A */\0A#define MBEDTLS_PSA_CRYPTO_C\0A\0A/**\0A * \5Cdef MBEDTLS_PSA_CRYPTO_SE_C\0A *\0A * Enable dynamic secure element support in the Platform Security Architecture\0A * cryptography API.\0A *\0A * \5Cdeprecated This feature is deprecated. Please switch to the PSA driver\0A *             interface.\0A *\0A * \5Cwarning    This feature is not thread-safe, and should not be used in a\0A *             multi-threaded environment.\0A *\0A * Module:  library/psa_crypto_se.c\0A *\0A * Requires: MBEDTLS_PSA_CRYPTO_C, MBEDTLS_PSA_CRYPTO_STORAGE_C\0A *\0A */\0A//#define MBEDTLS_PSA_CRYPTO_SE_C\0A\0A/**\0A * \5Cdef MBEDTLS_PSA_CRYPTO_STORAGE_C\0A *\0A * Enable the Platform Security Architecture persistent key storage.\0A *\0A * Module:  library/psa_crypto_storage.c\0A *\0A * Requires: MBEDTLS_PSA_CRYPTO_C,\0A *           either MBEDTLS_PSA_ITS_FILE_C or a native implementation of\0A *           the PSA ITS interface\0A */\0A#define MBEDTLS_PSA_CRYPTO_STORAGE_C\0A\0A/**\0A * \5Cdef MBEDTLS_PSA_ITS_FILE_C\0A *\0A * Enable the emulation of the Platform Security Architecture\0A * Internal Trusted Storage (PSA ITS) over files.\0A *\0A * Module:  library/psa_its_file.c\0A *\0A * Requires: MBEDTLS_FS_IO\0A */\0A#define MBEDTLS_PSA_ITS_FILE_C\0A\0A/**\0A * \5Cdef MBEDTLS_PSA_STATIC_KEY_SLOTS\0A *\0A * Statically preallocate memory to store keys' material in PSA instead\0A * of allocating it dynamically when required. This allows builds without a\0A * heap, if none of the enabled cryptographic implementations or other features\0A * require it.\0A * This feature affects both volatile and persistent keys which means that\0A * it's not possible to persistently store a key which is larger than\0A * #MBEDTLS_PSA_STATIC_KEY_SLOT_BUFFER_SIZE.\0A *\0A * \5Cnote This feature comes with a (potentially) higher RAM usage since:\0A *       - All the key slots are allocated no matter if they are used or not.\0A *       - Each key buffer's length is #MBEDTLS_PSA_STATIC_KEY_SLOT_BUFFER_SIZE bytes.\0A *\0A * Requires: MBEDTLS_PSA_CRYPTO_C\0A *\0A */\0A//#define MBEDTLS_PSA_STATIC_KEY_SLOTS\0A\0A/**\0A * \5Cdef MBEDTLS_RIPEMD160_C\0A *\0A * Enable the RIPEMD-160 hash algorithm.\0A *\0A * Module:  library/ripemd160.c\0A * Caller:  library/md.c\0A *\0A */\0A#define MBEDTLS_RIPEMD160_C\0A\0A/**\0A * \5Cdef MBEDTLS_RSA_C\0A *\0A * Enable the RSA public-key cryptosystem.\0A *\0A * Module:  library/rsa.c\0A *          library/rsa_alt_helpers.c\0A * Caller:  library/pk.c\0A *          library/psa_crypto.c\0A *          library/ssl_tls.c\0A *          library/ssl*_client.c\0A *          library/ssl*_server.c\0A *\0A * This module is used by the following key exchanges:\0A *      RSA, DHE-RSA, ECDHE-RSA, RSA-PSK\0A *\0A * Requires: MBEDTLS_BIGNUM_C, MBEDTLS_OID_C\0A */\0A#define MBEDTLS_RSA_C\0A\0A/**\0A * \5Cdef MBEDTLS_SHA1_C\0A *\0A * Enable the SHA1 cryptographic hash algorithm.\0A *\0A * Module:  library/sha1.c\0A * Caller:  library/md.c\0A *          library/psa_crypto_hash.c\0A *\0A * This module is required for TLS 1.2 depending on the handshake parameters,\0A * and for SHA1-signed certificates.\0A *\0A * \5Cwarning   SHA-1 is considered a weak message digest and its use constitutes\0A *            a security risk. If possible, we recommend avoiding dependencies\0A *            on it, and considering stronger message digests instead.\0A *\0A */\0A#define MBEDTLS_SHA1_C\0A\0A/**\0A * \5Cdef MBEDTLS_SHA224_C\0A *\0A * Enable the SHA-224 cryptographic hash algorithm.\0A *\0A * Module:  library/sha256.c\0A * Caller:  library/md.c\0A *          library/ssl_cookie.c\0A *\0A * This module adds support for SHA-224.\0A */\0A#define MBEDTLS_SHA224_C\0A\0A/**\0A * \5Cdef MBEDTLS_SHA256_C\0A *\0A * Enable the SHA-256 cryptographic hash algorithm.\0A *\0A * Module:  library/sha256.c\0A * Caller:  library/entropy.c\0A *          library/md.c\0A *          library/ssl_tls.c\0A *          library/ssl*_client.c\0A *          library/ssl*_server.c\0A *\0A * This module adds support for SHA-256.\0A * This module is required for the SSL/TLS 1.2 PRF function.\0A */\0A#define MBEDTLS_SHA256_C\0A\0A/**\0A * \5Cdef MBEDTLS_SHA256_USE_ARMV8_A_CRYPTO_IF_PRESENT\0A *\0A * Enable acceleration of the SHA-256 and SHA-224 cryptographic hash algorithms\0A * with the ARMv8 cryptographic extensions if they are available at runtime.\0A * If not, the library will fall back to the C implementation.\0A *\0A * \5Cnote If MBEDTLS_SHA256_USE_ARMV8_A_CRYPTO_IF_PRESENT is defined when building\0A * for a non-Armv8-A build it will be silently ignored.\0A *\0A * \5Cnote    Minimum compiler versions for this feature are Clang 4.0,\0A * armclang 6.6 or GCC 6.0.\0A *\0A * \5Cnote \5Cc CFLAGS must be set to a minimum of \5Cc -march=armv8-a+crypto for\0A * armclang <= 6.9\0A *\0A * \5Cnote This was previously known as MBEDTLS_SHA256_USE_A64_CRYPTO_IF_PRESENT.\0A * That name is deprecated, but may still be used as an alternative form for this\0A * option.\0A *\0A * \5Cwarning MBEDTLS_SHA256_USE_ARMV8_A_CRYPTO_IF_PRESENT cannot be defined at the\0A * same time as MBEDTLS_SHA256_USE_ARMV8_A_CRYPTO_ONLY.\0A *\0A * Requires: MBEDTLS_SHA256_C.\0A *\0A * Module:  library/sha256.c\0A *\0A * Uncomment to have the library check for the Armv8-A SHA-256 crypto extensions\0A * and use them if available.\0A */\0A//#define MBEDTLS_SHA256_USE_ARMV8_A_CRYPTO_IF_PRESENT\0A\0A/**\0A * \5Cdef MBEDTLS_SHA256_USE_A64_CRYPTO_IF_PRESENT\0A *\0A * \5Cdeprecated This is now known as MBEDTLS_SHA256_USE_ARMV8_A_CRYPTO_IF_PRESENT.\0A * This name is now deprecated, but may still be used as an alternative form for\0A * this option.\0A */\0A//#define MBEDTLS_SHA256_USE_A64_CRYPTO_IF_PRESENT\0A\0A/**\0A * \5Cdef MBEDTLS_SHA256_USE_ARMV8_A_CRYPTO_ONLY\0A *\0A * Enable acceleration of the SHA-256 and SHA-224 cryptographic hash algorithms\0A * with the ARMv8 cryptographic extensions, which must be available at runtime\0A * or else an illegal instruction fault will occur.\0A *\0A * \5Cnote This allows builds with a smaller code size than with\0A * MBEDTLS_SHA256_USE_ARMV8_A_CRYPTO_IF_PRESENT\0A *\0A * \5Cnote    Minimum compiler versions for this feature are Clang 4.0,\0A * armclang 6.6 or GCC 6.0.\0A *\0A * \5Cnote \5Cc CFLAGS must be set to a minimum of \5Cc -march=armv8-a+crypto for\0A * armclang <= 6.9\0A *\0A * \5Cnote This was previously known as MBEDTLS_SHA256_USE_A64_CRYPTO_ONLY.\0A * That name is deprecated, but may still be used as an alternative form for this\0A * option.\0A *\0A * \5Cwarning MBEDTLS_SHA256_USE_ARMV8_A_CRYPTO_ONLY cannot be defined at the same\0A * time as MBEDTLS_SHA256_USE_ARMV8_A_CRYPTO_IF_PRESENT.\0A *\0A * Requires: MBEDTLS_SHA256_C.\0A *\0A * Module:  library/sha256.c\0A *\0A * Uncomment to have the library use the Armv8-A SHA-256 crypto extensions\0A * unconditionally.\0A */\0A//#define MBEDTLS_SHA256_USE_ARMV8_A_CRYPTO_ONLY\0A\0A/**\0A * \5Cdef MBEDTLS_SHA256_USE_A64_CRYPTO_ONLY\0A *\0A * \5Cdeprecated This is now known as MBEDTLS_SHA256_USE_ARMV8_A_CRYPTO_ONLY.\0A * This name is now deprecated, but may still be used as an alternative form for\0A * this option.\0A */\0A//#define MBEDTLS_SHA256_USE_A64_CRYPTO_ONLY\0A\0A/**\0A * \5Cdef MBEDTLS_SHA384_C\0A *\0A * Enable the SHA-384 cryptographic hash algorithm.\0A *\0A * Module:  library/sha512.c\0A * Caller:  library/md.c\0A *          library/psa_crypto_hash.c\0A *          library/ssl_tls.c\0A *          library/ssl*_client.c\0A *          library/ssl*_server.c\0A *\0A * Comment to disable SHA-384\0A */\0A#define MBEDTLS_SHA384_C\0A\0A/**\0A * \5Cdef MBEDTLS_SHA512_C\0A *\0A * Enable SHA-512 cryptographic hash algorithms.\0A *\0A * Module:  library/sha512.c\0A * Caller:  library/entropy.c\0A *          library/md.c\0A *          library/ssl_tls.c\0A *          library/ssl_cookie.c\0A *\0A * This module adds support for SHA-512.\0A */\0A#define MBEDTLS_SHA512_C\0A\0A/**\0A * \5Cdef MBEDTLS_SHA3_C\0A *\0A * Enable the SHA3 cryptographic hash algorithm.\0A *\0A * Module:  library/sha3.c\0A *\0A * This module adds support for SHA3.\0A */\0A#define MBEDTLS_SHA3_C\0A\0A/**\0A * \5Cdef MBEDTLS_SHA512_USE_A64_CRYPTO_IF_PRESENT\0A *\0A * Enable acceleration of the SHA-512 and SHA-384 cryptographic hash algorithms\0A * with the ARMv8 cryptographic extensions if they are available at runtime.\0A * If not, the library will fall back to the C implementation.\0A *\0A * \5Cnote If MBEDTLS_SHA512_USE_A64_CRYPTO_IF_PRESENT is defined when building\0A * for a non-Aarch64 build it will be silently ignored.\0A *\0A * \5Cnote    Minimum compiler versions for this feature are Clang 7.0,\0A * armclang 6.9 or GCC 8.0.\0A *\0A * \5Cnote \5Cc CFLAGS must be set to a minimum of \5Cc -march=armv8.2-a+sha3 for\0A * armclang 6.9\0A *\0A * \5Cwarning MBEDTLS_SHA512_USE_A64_CRYPTO_IF_PRESENT cannot be defined at the\0A * same time as MBEDTLS_SHA512_USE_A64_CRYPTO_ONLY.\0A *\0A * Requires: MBEDTLS_SHA512_C.\0A *\0A * Module:  library/sha512.c\0A *\0A * Uncomment to have the library check for the A64 SHA-512 crypto extensions\0A * and use them if available.\0A */\0A//#define MBEDTLS_SHA512_USE_A64_CRYPTO_IF_PRESENT\0A\0A/**\0A * \5Cdef MBEDTLS_SHA512_USE_A64_CRYPTO_ONLY\0A *\0A * Enable acceleration of the SHA-512 and SHA-384 cryptographic hash algorithms\0A * with the ARMv8 cryptographic extensions, which must be available at runtime\0A * or else an illegal instruction fault will occur.\0A *\0A * \5Cnote This allows builds with a smaller code size than with\0A * MBEDTLS_SHA512_USE_A64_CRYPTO_IF_PRESENT\0A *\0A * \5Cnote    Minimum compiler versions for this feature are Clang 7.0,\0A * armclang 6.9 or GCC 8.0.\0A *\0A * \5Cnote \5Cc CFLAGS must be set to a minimum of \5Cc -march=armv8.2-a+sha3 for\0A * armclang 6.9\0A *\0A * \5Cwarning MBEDTLS_SHA512_USE_A64_CRYPTO_ONLY cannot be defined at the same\0A * time as MBEDTLS_SHA512_USE_A64_CRYPTO_IF_PRESENT.\0A *\0A * Requires: MBEDTLS_SHA512_C.\0A *\0A * Module:  library/sha512.c\0A *\0A * Uncomment to have the library use the A64 SHA-512 crypto extensions\0A * unconditionally.\0A */\0A//#define MBEDTLS_SHA512_USE_A64_CRYPTO_ONLY\0A\0A/**\0A * \5Cdef MBEDTLS_SSL_CACHE_C\0A *\0A * Enable simple SSL cache implementation.\0A *\0A * Module:  library/ssl_cache.c\0A * Caller:\0A *\0A * Requires: MBEDTLS_SSL_CACHE_C\0A */\0A#define MBEDTLS_SSL_CACHE_C\0A\0A/**\0A * \5Cdef MBEDTLS_SSL_COOKIE_C\0A *\0A * Enable basic implementation of DTLS cookies for hello verification.\0A *\0A * Module:  library/ssl_cookie.c\0A * Caller:\0A */\0A#define MBEDTLS_SSL_COOKIE_C\0A\0A/**\0A * \5Cdef MBEDTLS_SSL_TICKET_C\0A *\0A * Enable an implementation of TLS server-side callbacks for session tickets.\0A *\0A * Module:  library/ssl_ticket.c\0A * Caller:\0A *\0A * Requires: (MBEDTLS_CIPHER_C || MBEDTLS_USE_PSA_CRYPTO) &&\0A *           (MBEDTLS_GCM_C || MBEDTLS_CCM_C || MBEDTLS_CHACHAPOLY_C)\0A */\0A#define MBEDTLS_SSL_TICKET_C\0A\0A/**\0A * \5Cdef MBEDTLS_SSL_CLI_C\0A *\0A * Enable the SSL/TLS client code.\0A *\0A * Module:  library/ssl*_client.c\0A * Caller:\0A *\0A * Requires: MBEDTLS_SSL_TLS_C\0A *\0A * This module is required for SSL/TLS client support.\0A */\0A#define MBEDTLS_SSL_CLI_C\0A\0A/**\0A * \5Cdef MBEDTLS_SSL_SRV_C\0A *\0A * Enable the SSL/TLS server code.\0A *\0A * Module:  library/ssl*_server.c\0A * Caller:\0A *\0A * Requires: MBEDTLS_SSL_TLS_C\0A *\0A * This module is required for SSL/TLS server support.\0A */\0A#define MBEDTLS_SSL_SRV_C\0A\0A/**\0A * \5Cdef MBEDTLS_SSL_TLS_C\0A *\0A * Enable the generic SSL/TLS code.\0A *\0A * Module:  library/ssl_tls.c\0A * Caller:  library/ssl*_client.c\0A *          library/ssl*_server.c\0A *\0A * Requires: MBEDTLS_CIPHER_C, MBEDTLS_MD_C\0A *           and at least one of the MBEDTLS_SSL_PROTO_XXX defines\0A *\0A * This module is required for SSL/TLS.\0A */\0A#define MBEDTLS_SSL_TLS_C\0A\0A/**\0A * \5Cdef MBEDTLS_THREADING_C\0A *\0A * Enable the threading abstraction layer.\0A *\0A * Traditionally, Mbed TLS assumes it is used in a non-threaded environment or\0A * that contexts are not shared between threads. If you do intend to use contexts\0A * between threads, you will need to enable this layer to prevent race\0A * conditions.\0A *\0A * The PSA subsystem has an implicit shared context. Therefore, you must\0A * enable this option if more than one thread may use any part of\0A * Mbed TLS that is implemented on top of the PSA subsystem.\0A *\0A * You must enable this option in multithreaded applications where more than\0A * one thread performs any of the following operations:\0A *\0A * - Any call to a PSA function (`psa_xxx()`).\0A * - Any call to a TLS, X.509 or PK function (`mbedtls_ssl_xxx()`,\0A *   `mbedtls_x509_xxx()`, `mbedtls_pkcs7_xxx()`, `mbedtls_pk_xxx()`)\0A *   if `MBEDTLS_USE_PSA_CRYPTO` is enabled (regardless of whether individual\0A *   TLS, X.509 or PK contexts are shared between threads).\0A * - A TLS 1.3 connection, regardless of the compile-time configuration.\0A * - Any library feature that calculates a hash, if `MBEDTLS_MD_C` is disabled.\0A *   As an exception, algorithm-specific low-level modules do not require\0A *   threading protection unless the contexts are shared between threads.\0A * - Any library feature that performs symmetric encryption or decryption,\0A *   if `MBEDTLS_CIPHER_C` is disabled.\0A *   As an exception, algorithm-specific low-level modules do not require\0A *   threading protection unless the contexts are shared between threads.\0A * - Any use of a cryptographic context if the same context is used in\0A *   multiple threads.\0A * - Any call to a function where the documentation specifies that\0A *   psa_crypto_init() must be called prior to that function.\0A *\0A * See also our Knowledge Base article about threading:\0A * https://mbed-tls.readthedocs.io/en/latest/kb/development/thread-safety-and-multi-threading\0A *\0A * Module:  library/threading.c\0A *\0A * This allows different threading implementations (self-implemented or\0A * provided).\0A *\0A * You will have to enable either MBEDTLS_THREADING_ALT or\0A * MBEDTLS_THREADING_PTHREAD.\0A *\0A * Enable this layer to allow use of mutexes within Mbed TLS\0A */\0A//#define MBEDTLS_THREADING_C\0A\0A/**\0A * \5Cdef MBEDTLS_TIMING_C\0A *\0A * Enable the semi-portable timing interface.\0A *\0A * \5Cnote The provided implementation only works on POSIX/Unix (including Linux,\0A * BSD and OS X) and Windows. On other platforms, you can either disable that\0A * module and provide your own implementations of the callbacks needed by\0A * \5Cc mbedtls_ssl_set_timer_cb() for DTLS, or leave it enabled and provide\0A * your own implementation of the whole module by setting\0A * \5Cc MBEDTLS_TIMING_ALT in the current file.\0A *\0A * \5Cnote The timing module will include time.h on suitable platforms\0A *       regardless of the setting of MBEDTLS_HAVE_TIME, unless\0A *       MBEDTLS_TIMING_ALT is used. See timing.c for more information.\0A *\0A * \5Cnote See also our Knowledge Base article about porting to a new\0A * environment:\0A * https://mbed-tls.readthedocs.io/en/latest/kb/how-to/how-do-i-port-mbed-tls-to-a-new-environment-OS\0A *\0A * Module:  library/timing.c\0A */\0A#define MBEDTLS_TIMING_C\0A\0A/**\0A * \5Cdef MBEDTLS_VERSION_C\0A *\0A * Enable run-time version information.\0A *\0A * Module:  library/version.c\0A *\0A * This module provides run-time version information.\0A */\0A#define MBEDTLS_VERSION_C\0A\0A/**\0A * \5Cdef MBEDTLS_X509_USE_C\0A *\0A * Enable X.509 core for using certificates.\0A *\0A * Module:  library/x509.c\0A * Caller:  library/x509_crl.c\0A *          library/x509_crt.c\0A *          library/x509_csr.c\0A *\0A * Requires: MBEDTLS_ASN1_PARSE_C, MBEDTLS_BIGNUM_C, MBEDTLS_OID_C, MBEDTLS_PK_PARSE_C,\0A *           (MBEDTLS_MD_C or MBEDTLS_USE_PSA_CRYPTO)\0A *\0A * \5Cwarning If building with MBEDTLS_USE_PSA_CRYPTO, you must call\0A * psa_crypto_init() before doing any X.509 operation.\0A *\0A * This module is required for the X.509 parsing modules.\0A */\0A#define MBEDTLS_X509_USE_C\0A\0A/**\0A * \5Cdef MBEDTLS_X509_CRT_PARSE_C\0A *\0A * Enable X.509 certificate parsing.\0A *\0A * Module:  library/x509_crt.c\0A * Caller:  library/ssl_tls.c\0A *          library/ssl*_client.c\0A *          library/ssl*_server.c\0A *\0A * Requires: MBEDTLS_X509_USE_C\0A *\0A * This module is required for X.509 certificate parsing.\0A */\0A#define MBEDTLS_X509_CRT_PARSE_C\0A\0A/**\0A * \5Cdef MBEDTLS_X509_CRL_PARSE_C\0A *\0A * Enable X.509 CRL parsing.\0A *\0A * Module:  library/x509_crl.c\0A * Caller:  library/x509_crt.c\0A *\0A * Requires: MBEDTLS_X509_USE_C\0A *\0A * This module is required for X.509 CRL parsing.\0A */\0A#define MBEDTLS_X509_CRL_PARSE_C\0A\0A/**\0A * \5Cdef MBEDTLS_X509_CSR_PARSE_C\0A *\0A * Enable X.509 Certificate Signing Request (CSR) parsing.\0A *\0A * Module:  library/x509_csr.c\0A * Caller:  library/x509_crt_write.c\0A *\0A * Requires: MBEDTLS_X509_USE_C\0A *\0A * This module is used for reading X.509 certificate request.\0A */\0A#define MBEDTLS_X509_CSR_PARSE_C\0A\0A/**\0A * \5Cdef MBEDTLS_X509_CREATE_C\0A *\0A * Enable X.509 core for creating certificates.\0A *\0A * Module:  library/x509_create.c\0A *\0A * Requires: MBEDTLS_BIGNUM_C, MBEDTLS_OID_C, MBEDTLS_PK_PARSE_C,\0A *           (MBEDTLS_MD_C or MBEDTLS_USE_PSA_CRYPTO)\0A *\0A * \5Cwarning If building with MBEDTLS_USE_PSA_CRYPTO, you must call\0A * psa_crypto_init() before doing any X.509 create operation.\0A