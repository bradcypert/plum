@.str42913 = private global { i64, i64, [31801 x i8] } { i64 -1, i64 31800, [31801 x i8] c"// Filesystem and self-location primitives, so the compiler stops\0A// shelling out to Unix commands to do them.\0A//\0A// `bootstrap/self_host/main.plum` used to reach these through\0A// `run_process`: `mktemp -d` (5 sites), `rm -rf`/`rm -f` (6), `cp -r`\0A// (1), `mkdir` (1), and `/proc/self/exe` (3). That works on Linux,\0A// works on macOS by luck, and cannot work on Windows, where none of\0A// those programs exist. `/proc/self/exe` is worse than the others: it\0A// is Linux-only, so the language server -- which re-invokes itself\0A// through it -- was already broken on a Mac.\0A//\0A// Replacing them is also just better on the platforms where they DID\0A// work. A `plum build` forked three processes to make a directory,\0A// delete a file, and delete a directory; now it forks one, for `clang`,\0A// which is the only one that was ever doing real work.\0A//\0A// Same shim conventions as its neighbours (see `net_shim.c`'s header\0A// for the general pattern): every function takes and returns only\0A// `long long` (Plum `Int`) or `const char *` (Plum `CStr`), because\0A// Plum's extern surface has no raw pointers, no out-parameters and no\0A// multi-value return.\0A//\0A// **Returned strings live in a static buffer**, not in `malloc`'d\0A// memory. The Plum side copies immediately into a string cell\0A// (`plum_str_new`), so the buffer's contents are needed only until the\0A// call returns -- and a `malloc` here would be a leak, since the\0A// extern boundary gives the Plum side no way to free it. Not\0A// re-entrant, and not required to be: nothing calls these from more\0A// than one thread.\0A\0A#include <stdio.h>\0A#include <stdlib.h>\0A#include <string.h>\0A#include <sys/stat.h>\0A#include <dirent.h>\0A#include <stdint.h>\0A#include <ctype.h>\0A#include <errno.h>\0A#include <time.h>\0A\0A#if defined(_WIN32)\0A#include <windows.h>\0A#include <direct.h>\0A#include <io.h>\0A#define PLUM_MKDIR(p) _mkdir(p)\0A#define PLUM_RMDIR(p) _rmdir(p)\0A#else\0A#include <unistd.h>\0A#include <signal.h>\0A#define PLUM_MKDIR(p) mkdir((p), 0700)\0A#define PLUM_RMDIR(p) rmdir(p)\0A#endif\0A\0A#if defined(__APPLE__)\0A#include <mach-o/dyld.h>\0A#endif\0A\0A#if defined(__linux__) && defined(__has_include)\0A#if __has_include(<linux/if_alg.h>)\0A#define PLUM_CACHE_AF_ALG 1\0A#include <sys/socket.h>\0A#include <linux/if_alg.h>\0A#endif\0A#endif\0A\0A#define PLUM_PATH_MAX 4096\0A\0Astatic char plum_os_buf[PLUM_PATH_MAX];\0A\0A// Compiler artifact support. Hash files in bounded memory: materializing the\0A// compiler executable as an Array[Int] just to fingerprint it would dominate\0A// a warm run. SHA-256 uses unsigned 32-bit arithmetic (FIPS 180-4).\0Atypedef struct {\0A    uint32_t h[8];\0A    uint64_t bytes;\0A    unsigned char block[64];\0A    size_t used;\0A} plum_cache_sha;\0A\0Astatic uint32_t plum_cache_rotr(uint32_t x, unsigned n) {\0A    return (x >> n) | (x << (32 - n));\0A}\0A\0Astatic void plum_cache_block(plum_cache_sha *s, const unsigned char *p) {\0A    static const uint32_t k[64] = {\0A        0x428a2f98,0x71374491,0xb5c0fbcf,0xe9b5dba5,0x3956c25b,0x59f111f1,0x923f82a4,0xab1c5ed5,\0A        0xd807aa98,0x12835b01,0x243185be,0x550c7dc3,0x72be5d74,0x80deb1fe,0x9bdc06a7,0xc19bf174,\0A        0xe49b69c1,0xefbe4786,0x0fc19dc6,0x240ca1cc,0x2de92c6f,0x4a7484aa,0x5cb0a9dc,0x76f988da,\0A        0x983e5152,0xa831c66d,0xb00327c8,0xbf597fc7,0xc6e00bf3,0xd5a79147,0x06ca6351,0x14292967,\0A        0x27b70a85,0x2e1b2138,0x4d2c6dfc,0x53380d13,0x650a7354,0x766a0abb,0x81c2c92e,0x92722c85,\0A        0xa2bfe8a1,0xa81a664b,0xc24b8b70,0xc76c51a3,0xd192e819,0xd6990624,0xf40e3585,0x106aa070,\0A        0x19a4c116,0x1e376c08,0x2748774c,0x34b0bcb5,0x391c0cb3,0x4ed8aa4a,0x5b9cca4f,0x682e6ff3,\0A        0x748f82ee,0x78a5636f,0x84c87814,0x8cc70208,0x90befffa,0xa4506ceb,0xbef9a3f7,0xc67178f2\0A    };\0A    uint32_t w[64], a,b,c,d,e,f,g,h;\0A    for (unsigned i = 0; i < 16;