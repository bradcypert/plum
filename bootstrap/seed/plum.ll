@.str40632 = private global { i64, i64, [4889 x i8] } { i64 -1, i64 4888, [4889 x i8] c"/**\0A * \5Cfile mbedtls/config_adjust_psa_superset_legacy.h\0A * \5Cbrief Adjust PSA configuration: automatic enablement from legacy\0A *\0A * This is an internal header. Do not include it directly.\0A *\0A * To simplify some edge cases, we automatically enable certain cryptographic\0A * mechanisms in the PSA API if they are enabled in the legacy API. The general\0A * idea is that if legacy module M uses mechanism A internally, and A has\0A * both a legacy and a PSA implementation, we enable A through PSA whenever\0A * it's enabled through legacy. This facilitates the transition to PSA\0A * implementations of A for users of M.\0A */\0A/*\0A *  Copyright The Mbed TLS Contributors\0A *  SPDX-License-Identifier: Apache-2.0 OR GPL-2.0-or-later\0A */\0A\0A#ifndef MBEDTLS_CONFIG_ADJUST_PSA_SUPERSET_LEGACY_H\0A#define MBEDTLS_CONFIG_ADJUST_PSA_SUPERSET_LEGACY_H\0A\0A#if !defined(MBEDTLS_CONFIG_FILES_READ)\0A#error \22Do not include mbedtls/config_adjust_*.h manually! This can lead to problems, \22 \5C\0A    \22up to and including runtime errors such as buffer overflows. \22 \5C\0A    \22If you're trying to fix a complaint from check_config.h, just remove \22 \5C\0A    \22it from your configuration file: since Mbed TLS 3.0, it is included \22 \5C\0A    \22automatically at the right point.\22\0A#endif /* */\0A\0A/****************************************************************/\0A/* Hashes that are built in are also enabled in PSA.\0A * This simplifies dependency declarations especially\0A * for modules that obey MBEDTLS_USE_PSA_CRYPTO. */\0A/****************************************************************/\0A\0A#if defined(MBEDTLS_MD5_C)\0A#define PSA_WANT_ALG_MD5 1\0A#endif\0A\0A#if defined(MBEDTLS_RIPEMD160_C)\0A#define PSA_WANT_ALG_RIPEMD160 1\0A#endif\0A\0A#if defined(MBEDTLS_SHA1_C)\0A#define PSA_WANT_ALG_SHA_1 1\0A#endif\0A\0A#if defined(MBEDTLS_SHA224_C)\0A#define PSA_WANT_ALG_SHA_224 1\0A#endif\0A\0A#if defined(MBEDTLS_SHA256_C)\0A#define PSA_WANT_ALG_SHA_256 1\0A#endif\0A\0A#if defined(MBEDTLS_SHA384_C)\0A#define PSA_WANT_ALG_SHA_384 1\0A#endif\0A\0A#if defined(MBEDTLS_SHA512_C)\0A#define PSA_WANT_ALG_SHA_512 1\0A#endif\0A\0A#if defined(MBEDTLS_SHA3_C)\0A#define PSA_WANT_ALG_SHA3_224 1\0A#define PSA_WANT_ALG_SHA3_256 1\0A#define PSA_WANT_ALG_SHA3_384 1\0A#define PSA_WANT_ALG_SHA3_512 1\0A#endif\0A\0A/* Ensure that the PSA's supported curves (PSA_WANT_ECC_xxx) are always a\0A * superset of the builtin ones (MBEDTLS_ECP_DP_xxx). */\0A#if defined(MBEDTLS_ECP_DP_BP256R1_ENABLED)\0A#if !defined(PSA_WANT_ECC_BRAINPOOL_P_R1_256)\0A#define PSA_WANT_ECC_BRAINPOOL_P_R1_256 1\0A#endif /* PSA_WANT_ECC_BRAINPOOL_P_R1_256 */\0A#endif /* MBEDTLS_ECP_DP_BP256R1_ENABLED */\0A\0A#if defined(MBEDTLS_ECP_DP_BP384R1_ENABLED)\0A#if !defined(PSA_WANT_ECC_BRAINPOOL_P_R1_384)\0A#define PSA_WANT_ECC_BRAINPOOL_P_R1_384 1\0A#endif /* PSA_WANT_ECC_BRAINPOOL_P_R1_384 */\0A#endif /*MBEDTLS_ECP_DP_BP384R1_ENABLED  */\0A\0A#if defined(MBEDTLS_ECP_DP_BP512R1_ENABLED)\0A#if !defined(PSA_WANT_ECC_BRAINPOOL_P_R1_512)\0A#define PSA_WANT_ECC_BRAINPOOL_P_R1_512 1\0A#endif /* PSA_WANT_ECC_BRAINPOOL_P_R1_512 */\0A#endif /* MBEDTLS_ECP_DP_BP512R1_ENABLED */\0A\0A#if defined(MBEDTLS_ECP_DP_CURVE25519_ENABLED)\0A#if !defined(PSA_WANT_ECC_MONTGOMERY_255)\0A#define PSA_WANT_ECC_MONTGOMERY_255 1\0A#endif /* PSA_WANT_ECC_MONTGOMERY_255 */\0A#endif /* MBEDTLS_ECP_DP_CURVE25519_ENABLED */\0A\0A#if defined(MBEDTLS_ECP_DP_CURVE448_ENABLED)\0A#if !defined(PSA_WANT_ECC_MONTGOMERY_448)\0A#define PSA_WANT_ECC_MONTGOMERY_448 1\0A#endif /* PSA_WANT_ECC_MONTGOMERY_448 */\0A#endif /* MBEDTLS_ECP_DP_CURVE448_ENABLED */\0A\0A#if defined(MBEDTLS_ECP_DP_SECP192R1_ENABLED)\0A#if !defined(PSA_WANT_ECC_SECP_R1_192)\0A#define PSA_WANT_ECC_SECP_R1_192 1\0A#endif /* PSA_WANT_ECC_SECP_R1_192 */\0A#endif /* MBEDTLS_ECP_DP_SECP192R1_ENABLED */\0A\0A#if defined(MBEDTLS_ECP_DP_SECP224R1_ENABLED)\0A#if !defined(PS