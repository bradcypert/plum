@.str39613 = private global { i64, i64, [4723 x i8] } { i64 -1, i64 4722, [4723 x i8] c"/**\0A * \5Cfile memory_buffer_alloc.h\0A *\0A * \5Cbrief Buffer-based memory allocator\0A */\0A/*\0A *  Copyright The Mbed TLS Contributors\0A *  SPDX-License-Identifier: Apache-2.0 OR GPL-2.0-or-later\0A */\0A#ifndef MBEDTLS_MEMORY_BUFFER_ALLOC_H\0A#define MBEDTLS_MEMORY_BUFFER_ALLOC_H\0A\0A#include \22mbedtls/build_info.h\22\0A\0A#include <stddef.h>\0A\0A/**\0A * \5Cname SECTION: Module settings\0A *\0A * The configuration options you can set for this module are in this section.\0A * Either change them in mbedtls_config.h or define them on the compiler command line.\0A * \5C{\0A */\0A\0A#if !defined(MBEDTLS_MEMORY_ALIGN_MULTIPLE)\0A#define MBEDTLS_MEMORY_ALIGN_MULTIPLE       4 /**< Align on multiples of this value */\0A#endif\0A\0A/** \5C} name SECTION: Module settings */\0A\0A#define MBEDTLS_MEMORY_VERIFY_NONE         0\0A#define MBEDTLS_MEMORY_VERIFY_ALLOC        (1 << 0)\0A#define MBEDTLS_MEMORY_VERIFY_FREE         (1 << 1)\0A#define MBEDTLS_MEMORY_VERIFY_ALWAYS       (MBEDTLS_MEMORY_VERIFY_ALLOC | \5C\0A                                            MBEDTLS_MEMORY_VERIFY_FREE)\0A\0A#ifdef __cplusplus\0Aextern \22C\22 {\0A#endif\0A\0A/**\0A * \5Cbrief   Initialize use of stack-based memory allocator.\0A *          The stack-based allocator does memory management inside the\0A *          presented buffer and does not call calloc() and free().\0A *          It sets the global mbedtls_calloc() and mbedtls_free() pointers\0A *          to its own functions.\0A *          (Provided mbedtls_calloc() and mbedtls_free() are thread-safe if\0A *           MBEDTLS_THREADING_C is defined)\0A *\0A * \5Cnote    This code is not optimized and provides a straight-forward\0A *          implementation of a stack-based memory allocator.\0A *\0A * \5Cparam buf   buffer to use as heap\0A * \5Cparam len   size of the buffer\0A */\0Avoid mbedtls_memory_buffer_alloc_init(unsigned char *buf, size_t len);\0A\0A/**\0A * \5Cbrief   Free the mutex for thread-safety and clear remaining memory\0A */\0Avoid mbedtls_memory_buffer_alloc_free(void);\0A\0A/**\0A * \5Cbrief   Determine when the allocator should automatically verify the state\0A *          of the entire chain of headers / meta-data.\0A *          (Default: MBEDTLS_MEMORY_VERIFY_NONE)\0A *\0A * \5Cparam verify    One of MBEDTLS_MEMORY_VERIFY_NONE, MBEDTLS_MEMORY_VERIFY_ALLOC,\0A *                  MBEDTLS_MEMORY_VERIFY_FREE or MBEDTLS_MEMORY_VERIFY_ALWAYS\0A */\0Avoid mbedtls_memory_buffer_set_verify(int verify);\0A\0A#if defined(MBEDTLS_MEMORY_DEBUG)\0A/**\0A * \5Cbrief   Print out the status of the allocated memory (primarily for use\0A *          after a program should have de-allocated all memory)\0A *          Prints out a list of 'still allocated' blocks and their stack\0A *          trace if MBEDTLS_MEMORY_BACKTRACE is defined.\0A */\0Avoid mbedtls_memory_buffer_alloc_status(void);\0A\0A/**\0A * \5Cbrief   Get the number of alloc/free so far.\0A *\0A * \5Cparam alloc_count   Number of allocations.\0A * \5Cparam free_count    Number of frees.\0A */\0Avoid mbedtls_memory_buffer_alloc_count_get(size_t *alloc_count, size_t *free_count);\0A\0A/**\0A * \5Cbrief   Get the peak heap usage so far\0A *\0A * \5Cparam max_used      Peak number of bytes in use or committed. This\0A *                      includes bytes in allocated blocks too small to split\0A *                      into smaller blocks but larger than the requested size.\0A * \5Cparam max_blocks    Peak number of blocks in use, including free and used\0A */\0Avoid mbedtls_memory_buffer_alloc_max_get(size_t *max_used, size_t *max_blocks);\0A\0A/**\0A * \5Cbrief   Reset peak statistics\0A */\0Avoid mbedtls_memory_buffer_alloc_max_reset(void);\0A\0A/**\0A * \5Cbrief   Get the current heap usage\0A *\0A * \5Cparam cur_used      Current number of bytes in use or committed. This\0A *                      includes bytes in allocated blocks too small to split\0A *                      into smaller blocks but larger than the requested size.\0A * \5Cparam cur_blocks    Current number of blocks in use, including free and used\0A */\0Avoid mbedtls_memory_buffer_alloc_cur_get(size_t *cur_used, size_t *cur_blocks);\0A#endif /* MBEDTLS_MEMORY_DEBUG */\0A\0A/**\0A * \5Cbrief   Verifies that all headers in the memory buffer are correct\0A *          and contain sane values. Helps debug buffer-overflow errors.\0A *\0A *          Prints out first failure if MBEDTLS_MEMORY_DEBUG is defined.\0A *          Prints out full header information if MBEDTLS_MEMORY_DEBUG\0A *          is defined. (Includes stack trace information for each block if\0A *          MBEDTLS_MEMORY_BACKTRACE is defined as well).\0A *\0A * \5Creturn             0 if verified, 1 otherwise\0A */\0Aint mbedtls_memory_buffer_alloc_verify(void);\0A\0A#if defined(MBEDTLS_SELF_TEST)\0A/**\0A * \5Cbrief          Checkup routine\0A *\0A * \5Creturn         0 if successful, or 1 if a test failed\0A */\0Aint mbedtls_memory_buffer_alloc_self_test(int verbose);\0A#endif\0A\0A#ifdef __cplusplus\0A}\0A#endif\0A\0A#endif /* memory_buffer_alloc.h */\0A\00" }
