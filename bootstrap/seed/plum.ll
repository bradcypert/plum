                                                          for resending messages         */\0A\0A#if defined(MBEDTLS_SSL_DTLS_CONNECTION_ID)\0A    /* The state of CID configuration in this handshake. */\0A\0A    uint8_t cid_in_use; /*!< This indicates whether the use of the CID extension\0A                         *   has been negotiated. Possible values are\0A                         *   #MBEDTLS_SSL_CID_ENABLED and\0A                         *   #MBEDTLS_SSL_CID_DISABLED. */\0A    unsigned char peer_cid[MBEDTLS_SSL_CID_OUT_LEN_MAX];   /*! The peer's CID */\0A    uint8_t peer_cid_len;                                  /*!< The length of\0A                                                            *   \5Cc peer_cid.  */\0A#endif /* MBEDTLS_SSL_DTLS_CONNECTION_ID */\0A\0A    uint16_t mtu;                       /*!<  Handshake mtu, used to fragment outgoing messages */\0A#endif /* MBEDTLS_SSL_PROTO_DTLS */\0A\0A    /*\0A     * Checksum contexts\0A     */\0A#if defined(MBEDTLS_MD_CAN_SHA256)\0A#if defined(MBEDTLS_USE_PSA_CRYPTO)\0A    psa_hash_operation_t fin_sha256_psa;\0A#else\0A    mbedtls_md_context_t fin_sha256;\0A#endif\0A#endif\0A#if defined(MBEDTLS_MD_CAN_SHA384)\0A#if defined(MBEDTLS_USE_PSA_CRYPTO)\0A    psa_hash_operation_t fin_sha384_psa;\0A#else\0A    mbedtls_md_context_t fin_sha384;\0A#endif\0A#endif\0A\0A#if defined(MBEDTLS_SSL_PROTO_TLS1_3)\0A    uint16_t offered_group_id; /* The NamedGroup value for the group\0A                                * that is being used for ephemeral\0A                                * key exchange.\0A                                *\0A                                * On the client: Defaults to the first\0A                                * entry in the client's group list,\0A                                * but can be overwritten by the HRR. */\0A#endif /* MBEDTLS_SSL_PROTO_TLS1_3 */\0A\0A#if defined(MBEDTLS_SSL_CLI_C)\0A    uint8_t client_auth;       /*!< used to check if CertificateRequest has been\0A                                    received from server side. If CertificateRequest\0A                                    has been received, Certificate and CertificateVerify\0A                                    should be sent to server */\0A#endif /* MBEDTLS_SSL_CLI_C */\0A    /*\0A     * State-local variables used during the processing\0A     * of a specific handshake state.\0A     */\0A    union {\0A        /* Outgoing Finished message */\0A        struct {\0A            uint8_t preparation_done;\0A\0A            /* Buffer holding digest of the handshake up to\0A             * but excluding the outgoing finished message. */\0A            unsigned char digest[MBEDTLS_TLS1_3_MD_MAX_SIZE];\0A            size_t digest_len;\0A        } finished_out;\0A\0A        /* Incoming Finished message */\0A        struct {\0A            uint8_t preparation_done;\0A\0A            /* Buffer holding digest of the handshake up to but\0A             * excluding the peer's incoming finished message. */\0A            unsigned char digest[MBEDTLS_TLS1_3_MD_MAX_SIZE];\0A            size_t digest_len;\0A        } finished_in;\0A\0A    } state_local;\0A\0A    /* End of state-local variables. */\0A\0A    unsigned char randbytes[MBEDTLS_CLIENT_HELLO_RANDOM_LEN +\0A                            MBEDTLS_SERVER_HELLO_RANDOM_LEN];\0A    /*!<  random bytes            */\0A#if defined(MBEDTLS_SSL_PROTO_TLS1_2)\0A    unsigned char premaster[MBEDTLS_PREMASTER_SIZE];\0A    /*!<  premaster secret        */\0A    size_t pmslen;                      /*!<  premaster length        */\0A#endif\0A\0A#if defined(MBEDTLS_SSL_PROTO_TLS1_3)\0A    uint32_t sent_extensions;       /*!< extensions sent by endpoint */\0A    uint32_t received_extensions;   /*!< extensions received by endpoint */\0A\0A#if defined(MBEDTLS_SSL_HANDSHAKE_WITH_CERT_ENABLED)\0A    unsigned char certificate_request_context_len;\0A    unsigned char *certificate_request_context;\0A#endif\0A\0A    /** TLS 1.3 transform for encrypted handshake messages. */\0A    mbedtls_ssl_transform *transform_handshake;\0A    union {\0A        unsigned char early[MBEDTLS_TLS1_3_MD_MAX_SIZE];\0A        unsigned char handshake[MBEDTLS_TLS1_3_MD_MAX_SIZE];\0A        unsigned char app[MBEDTLS_TLS1_3_MD_MAX_SIZE];\0A    } tls13_master_secrets;\0A\0A    mbedtls_ssl_tls13_handshake_secrets tls13_hs_secrets;\0A#if defined(MBEDTLS_SSL_EARLY_DATA)\0A    /** TLS 1.3 transform for early data and handshake messages. */\0A    mbedtls_ssl_transform *transform_earlydata;\0A#endif\0A#endif /* MBEDTLS_SSL_PROTO_TLS1_3 */\0A\0A#if defined(MBEDTLS_SSL_ASYNC_PRIVATE)\0A    /** Asynchronous operation context. This field is meant for use by the\0A     * asynchronous operation callbacks (mbedtls_ssl_config::f_async_sign_start,\0A     * mbedtls_ssl_config::f_async_decrypt_start,\0A     * mbedtls_ssl_config::f_async_resume, mbedtls_ssl_config::f_async_cancel).\0A     * The library does not use it internally. */\0A    void *user_async_ctx;\0A#endif /* MBEDTLS_SSL_ASYNC_PRIVATE */\0A\0A#if defined(MBEDTLS_SSL_SERVER_NAME_INDICATION)\0A    const unsigned char *sni_name;      /*!< raw SNI                        */\0A    size_t sni_name_len;                /*!< raw SNI len                    */\0A#if defined(MBEDTLS_KEY_EXCHANGE_CERT_REQ_ALLOWED_ENABLED)\0A    const mbedtls_x509_crt *dn_hints;   /*!< acceptable client cert issuers */\0A#endif\0A#endif /* MBEDTLS_SSL_SERVER_NAME_INDICATION */\0A};\0A\0Atypedef struct mbedtls_ssl_hs_buffer mbedtls_ssl_hs_buffer;\0A\0A/*\0A * Representation of decryption/encryption transformations on records\0A *\0A * There are the following general types of record transformations:\0A * - Stream transformations (TLS versions == 1.2 only)\0A *   Transformation adding a MAC and applying a stream-cipher\0A *   to the authenticated message.\0A * - CBC block cipher transformations ([D]TLS versions == 1.2 only)\0A *   For TLS 1.2, no IV is generated at key extraction time, but every\0A *   encrypted record is explicitly prefixed by the IV with which it was\0A *   encrypted.\0A * - AEAD transformations ([D]TLS versions == 1.2 only)\0A *   These come in two fundamentally different versions, the first one\0A *   used in TLS 1.2, excluding ChaChaPoly ciphersuites, and the second\0A *   one used for ChaChaPoly ciphersuites in TLS 1.2 as well as for TLS 1.3.\0A *   In the first transformation, the IV to be used for a record is obtained\0A *   as the concatenation of an explicit, static 4-byte IV and the 8-byte\0A *   record sequence number, and explicitly prepending this sequence number\0A *   to the encrypted record. In contrast, in the second transformation\0A *   the IV is obtained by XOR'ing a static IV obtained at key extraction\0A *   time with the 8-byte record sequence number, without prepending the\0A *   latter to the encrypted record.\0A *\0A * Additionally, DTLS 1.2 + CID as well as TLS 1.3 use an inner plaintext\0A * which allows to add flexible length padding and to hide a record's true\0A * content type.\0A *\0A * In addition to type and version, the following parameters are relevant:\0A * - The symmetric cipher algorithm to be used.\0A * - The (static) encryption/decryption keys for the cipher.\0A * - For stream/CBC, the type of message digest to be used.\0A * - For stream/CBC, (static) encryption/decryption keys for the digest.\0A * - For AEAD transformations, the size (potentially 0) of an explicit,\0A *   random initialization vector placed in encrypted records.\0A * - For some transformations (currently AEAD) an implicit IV. It is static\0A *   and (if present) is combined with the explicit IV in a transformation-\0A *   -dependent way (e.g. appending in TLS 1.2 and XOR'ing in TLS 1.3).\0A * - For stream/CBC, a flag determining the order of encryption and MAC.\0A * - The details of the transformation depend on the SSL/TLS version.\0A * - The length of the authentication tag.\0A *\0A * The struct below refines this abstract view as follows:\0A * - The cipher underlying the transformation is managed in\0A *   cipher contexts cipher_ctx_{enc/dec}, which must have the\0A *   same cipher type. The mode of these cipher contexts determines\0A *   the type of the transformation in the sense above: e.g., if\0A *   the type is MBEDTLS_CIPHER_AES_256_CBC resp. MBEDTLS_CIPHER_AES_192_GCM\0A *   then the transformation has type CBC resp. AEAD.\0A * - The cipher keys are never stored explicitly but\0A *   are maintained within cipher_ctx_{enc/dec}.\0A * - For stream/CBC transformations, the message digest contexts\0A *   used for the MAC's are stored in md_ctx_{enc/dec}. These contexts\0A *   are unused for AEAD transformations.\0A * - For stream/CBC transformations, the MAC keys are not stored explicitly\0A *   but maintained within md_ctx_{enc/dec}.\0A * - The mac_enc and mac_dec fields are unused for EAD transformations.\0A * - For transformations using an implicit IV maintained within\0A *   the transformation context, its contents are stored within\0A *   iv_{enc/dec}.\0A * - The value of ivlen indicates the length of the IV.\0A *   This is redundant in case of stream/CBC transformations\0A *   which always use 0 resp. the cipher's block length as the\0A *   IV length, but is needed for AEAD ciphers and may be\0A *   different from the underlying cipher's block length\0A *   in this case.\0A * - The field fixed_ivlen is nonzero for AEAD transformations only\0A *   and indicates the length of the static part of the IV which is\0A *   constant throughout the communication, and which is stored in\0A *   the first fixed_ivlen bytes of the iv_{enc/dec} arrays.\0A * - tls_version denotes the 2-byte TLS version\0A * - For stream/CBC transformations, maclen denotes the length of the\0A *   authentication tag, while taglen is unused and 0.\0A * - For AEAD transformations, taglen denotes the length of the\0A *   authentication tag, while maclen is unused and 0.\0A * - For CBC transformations, encrypt_then_mac determines the\0A *   order of encryption and authentication. This field is unused\0A *   in other transformations.\0A *\0A */\0Astruct mbedtls_ssl_transform {\0A    /*\0A     * Session specific crypto layer\0A     */\0A    size_t minlen;                      /*!<  min. ciphertext length  */\0A    size_t ivlen;                       /*!<  IV length               */\0A    size_t fixed_ivlen;                 /*!<  Fixed part of IV (AEAD) */\0A    size_t maclen;                      /*!<  MAC(CBC) len            */\0A    size_t taglen;                      /*!<  TAG(AEAD) len           */\0A\0A    unsigned char iv_enc[16];           /*!<  IV (encryption)         */\0A    unsigned char iv_dec[16];           /*!<  IV (decryption)         */\0A\0A#if defined(MBEDTLS_SSL_SOME_SUITES_USE_MAC)\0A\0A#if defined(MBEDTLS_USE_PSA_CRYPTO)\0A    mbedtls_svc_key_id_t psa_mac_enc;           /*!<  MAC (encryption)        */\0A    mbedtls_svc_key_id_t psa_mac_dec;           /*!<  MAC (decryption)        */\0A    psa_algorithm_t psa_mac_alg;                /*!<  psa MAC algorithm       */\0A#else\0A    mbedtls_md_context_t md_ctx_enc;            /*!<  MAC (encryption)        */\0A    mbedtls_md_context_t md_ctx_dec;            /*!<  MAC (decryption)        */\0A#endif /* MBEDTLS_USE_PSA_CRYPTO */\0A\0A#if defined(MBEDTLS_SSL_ENCRYPT_THEN_MAC)\0A    int encrypt_then_mac;       /*!< flag for EtM activation                */\0A#endif\0A\0A#endif /* MBEDTLS_SSL_SOME_SUITES_USE_MAC */\0A\0A    mbedtls_ssl_protocol_version tls_version;\0A\0A#if defined(MBEDTLS_USE_PSA_CRYPTO)\0A    mbedtls_svc_key_id_t psa_key_enc;           /*!<  psa encryption key      */\0A    mbedtls_svc_key_id_t psa_key_dec;           /*!<  psa decryption key      */\0A    psa_algorithm_t psa_alg;                    /*!<  psa algorithm           */\0A#else\0A    mbedtls_cipher_context_t cipher_ctx_enc;    /*!<  encryption context      */\0A    mbedtls_cipher_context_t cipher_ctx_dec;    /*!<  decryption context      */\0A#endif /* MBEDTLS_USE_PSA_CRYPTO */\0A\0A#if defined(MBEDTLS_