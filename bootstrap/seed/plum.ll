e\0A#endif /* MBEDTLS_PSA_BUILTIN_ALG_RSA_PSS */\0A    {\0A        status = PSA_ERROR_INVALID_ARGUMENT;\0A        goto exit;\0A    }\0A\0A    /* Mbed TLS distinguishes \22invalid padding\22 from \22valid padding but\0A     * the rest of the signature is invalid\22. This has little use in\0A     * practice and PSA doesn't report this distinction. */\0A    status = (ret == MBEDTLS_ERR_RSA_INVALID_PADDING) ?\0A             PSA_ERROR_INVALID_SIGNATURE :\0A             mbedtls_to_psa_error(ret);\0A\0Aexit:\0A    mbedtls_rsa_free(rsa);\0A    mbedtls_free(rsa);\0A\0A    return status;\0A}\0A\0A#endif /* defined(MBEDTLS_PSA_BUILTIN_ALG_RSA_PKCS1V15_SIGN) ||\0A        * defined(MBEDTLS_PSA_BUILTIN_ALG_RSA_PSS) */\0A\0A/****************************************************************/\0A/* Asymmetric cryptography */\0A/****************************************************************/\0A\0A#if defined(MBEDTLS_PSA_BUILTIN_ALG_RSA_OAEP)\0Astatic int psa_rsa_oaep_set_padding_mode(psa_algorithm_t alg,\0A                                         mbedtls_rsa_context *rsa)\0A{\0A    psa_algorithm_t hash_alg = PSA_ALG_RSA_OAEP_GET_HASH(alg);\0A    mbedtls_md_type_t md_alg = mbedtls_md_type_from_psa_alg(hash_alg);\0A\0A    /* Just to get the error status right, as rsa_set_padding() doesn't\0A     * distinguish between \22bad RSA algorithm\22 and \22unknown hash\22. */\0A    if (mbedtls_md_info_from_type(md_alg) == NULL) {\0A        return PSA_ERROR_NOT_SUPPORTED;\0A    }\0A\0A    return mbedtls_rsa_set_padding(rsa, MBEDTLS_RSA_PKCS_V21, md_alg);\0A}\0A#endif /* defined(MBEDTLS_PSA_BUILTIN_ALG_RSA_OAEP) */\0A\0Apsa_status_t mbedtls_psa_asymmetric_encrypt(const psa_key_attributes_t *attributes,\0A                                            const uint8_t *key_buffer,\0A                                            size_t key_buffer_size,\0A                                            psa_algorithm_t alg,\0A                                            const uint8_t *input,\0A                                            size_t input_length,\0A                                            const uint8_t *salt,\0A                                            size_t salt_length,\0A                                            uint8_t *output,\0A                                            size_t output_size,\0A                                            size_t *output_length)\0A{\0A    psa_status_t status = PSA_ERROR_CORRUPTION_DETECTED;\0A    (void) key_buffer;\0A    (void) key_buffer_size;\0A    (void) input;\0A    (void) input_length;\0A    (void) salt;\0A    (void) salt_length;\0A    (void) output;\0A    (void) output_size;\0A    (void) output_length;\0A\0A    if (PSA_KEY_TYPE_IS_RSA(attributes->type)) {\0A#if defined(MBEDTLS_PSA_BUILTIN_ALG_RSA_PKCS1V15_CRYPT) || \5C\0A        defined(MBEDTLS_PSA_BUILTIN_ALG_RSA_OAEP)\0A        mbedtls_rsa_context *rsa = NULL;\0A        status = mbedtls_psa_rsa_load_representation(attributes->type,\0A                                                     key_buffer,\0A                                                     key_buffer_size,\0A                                                     &rsa);\0A        if (status != PSA_SUCCESS) {\0A            goto rsa_exit;\0A        }\0A\0A        if (output_size < mbedtls_rsa_get_len(rsa)) {\0A            status = PSA_ERROR_BUFFER_TOO_SMALL;\0A            goto rsa_exit;\0A        }\0A#endif /* defined(MBEDTLS_PSA_BUILTIN_ALG_RSA_PKCS1V15_CRYPT) ||\0A        * defined(MBEDTLS_PSA_BUILTIN_ALG_RSA_OAEP) */\0A        if (alg == PSA_ALG_RSA_PKCS1V15_CRYPT) {\0A#if defined(MBEDTLS_PSA_BUILTIN_ALG_RSA_PKCS1V15_CRYPT)\0A            status = mbedtls_to_psa_error(\0A                mbedtls_rsa_pkcs1_encrypt(rsa,\0A                                          mbedtls_psa_get_random,\0A                                          MBEDTLS_PSA_RANDOM_STATE,\0A                                          input_length,\0A                                          input,\0A                                          output));\0A#else\0A            status = PSA_ERROR_NOT_SUPPORTED;\0A#endif /* MBEDTLS_PSA_BUILTIN_ALG_RSA_PKCS1V15_CRYPT */\0A        } else\0A        if (PSA_ALG_IS_RSA_OAEP(alg)) {\0A#if defined(MBEDTLS_PSA_BUILTIN_ALG_RSA_OAEP)\0A            status = mbedtls_to_psa_error(\0A                psa_rsa_oaep_set_padding_mode(alg, rsa));\0A            if (status != PSA_SUCCESS) {\0A                goto rsa_exit;\0A            }\0A\0A            status = mbedtls_to_psa_error(\0A                mbedtls_rsa_rsaes_oaep_encrypt(rsa,\0A                                               mbedtls_psa_get_random,\0A                                               MBEDTLS_PSA_RANDOM_STATE,\0A                                               salt, salt_length,\0A                                               input_length,\0A                                               input,\0A                                               output));\0A#else\0A            status = PSA_ERROR_NOT_SUPPORTED;\0A#endif /* MBEDTLS_PSA_BUILTIN_ALG_RSA_OAEP */\0A        } else {\0A            status = PSA_ERROR_INVALID_ARGUMENT;\0A        }\0A#if defined(MBEDTLS_PSA_BUILTIN_ALG_RSA_PKCS1V15_CRYPT) || \5C\0A        defined(MBEDTLS_PSA_BUILTIN_ALG_RSA_OAEP)\0Arsa_exit:\0A        if (status == PSA_SUCCESS) {\0A            *output_length = mbedtls_rsa_get_len(rsa);\0A        }\0A\0A        mbedtls_rsa_free(rsa);\0A        mbedtls_free(rsa);\0A#endif /* defined(MBEDTLS_PSA_BUILTIN_ALG_RSA_PKCS1V15_CRYPT) ||\0A        * defined(MBEDTLS_PSA_BUILTIN_ALG_RSA_OAEP) */\0A    } else {\0A        status = PSA_ERROR_NOT_SUPPORTED;\0A    }\0A\0A    return status;\0A}\0A\0Apsa_status_t mbedtls_psa_asymmetric_decrypt(const psa_key_attributes_t *attributes,\0A                                            const uint8_t *key_buffer,\0A                                            size_t key_buffer_size,\0A                                            psa_algorithm_t alg,\0A                                            const uint8_t *input,\0A 