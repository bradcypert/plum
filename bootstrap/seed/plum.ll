@.str40707 = private global { i64, i64, [2905 x i8] } { i64 -1, i64 2904, [2905 x i8] c"// A thin ABI-adapter shim for POSIX directory listing — `opendir`/\0A// `readdir`/`closedir` return a `struct dirent *`/`DIR *`, neither of\0A// which fit Plum's `extern \22C\22` type surface (`Int`/`Float`/`Bool`/\0A// `CStr`/qualifying-struct only, no raw pointers/opaque types). Same\0A// pattern as `net_shim.c` (see its own doc comment for the general\0A// story) — flat `Int`/`CStr` functions, real POSIX structs built/\0A// consumed internally.\0A//\0A// **Handle-based, not a single call returning `Array[String]`** — the\0A// extern surface has no way to return an array at all. Mirrors `net_\0A// shim.c`'s own accept-loop shape: `dir_open` returns an opaque `Int`\0A// handle, `dir_read_next` returns ONE entry name per call (`\22\22`, a\0A// real non-null empty `CStr`, when exhausted — same \22never return\0A// null, an empty result is a normal outcome\22 convention `tcp_recv`\0A// already established, not a new one), and the Plum-level wrapper\0A// (`list_dir` in `STDLIB_OS_SRC`) loops via the SAME tail-recursive\0A// accumulator idiom every other \22read until done\22 stdlib function\0A// already uses. `.` and `..` are skipped here, C-side, once — no\0A// caller of `list_dir` should ever have to filter them out themselves.\0A//\0A// **Unix-only (Linux/macOS)** — same documented v1 scope as every\0A// other native_stdlib shim.\0A#include <dirent.h>\0A#include <sys/stat.h>\0A#include <string.h>\0A#include <stdlib.h>\0A#include <stdint.h>\0A\0Along long dir_open(const char *path) {\0A    DIR *d = opendir(path);\0A    if (d == NULL) {\0A        return -1;\0A    }\0A    return (long long)(intptr_t)d;\0A}\0A\0Aconst char *dir_read_next(long long handle) {\0A    DIR *d = (DIR *)(intptr_t)handle;\0A    if (d == NULL) {\0A        return \22\22;\0A    }\0A    struct dirent *entry;\0A    while ((entry = readdir(d)) != NULL) {\0A        if (strcmp(entry->d_name, \22.\22) == 0 || strcmp(entry->d_name, \22..\22) == 0) {\0A            continue;\0A        }\0A        size_t len = strlen(entry->d_name);\0A        char *copy = malloc(len + 1);\0A        if (copy == NULL) {\0A            return \22\22;\0A        }\0A        memcpy(copy, entry->d_name, len + 1);\0A        return copy;\0A    }\0A    return \22\22;\0A}\0A\0Avoid dir_close(long long handle) {\0A    DIR *d = (DIR *)(intptr_t)handle;\0A    if (d != NULL) {\0A        closedir(d);\0A    }\0A}\0A\0A// `stat(2)`-based — tells a caller (module resolution, walking a\0A// project tree) whether to recurse into an entry `list_dir` returned.\0A// Returns 1 (is a directory), 0 (exists, isn't a directory), or -1\0A// (`stat` itself failed — most commonly: the path doesn't exist at\0A// all). The three-way return (not a plain `Bool`) is what lets the\0A// Plum-level `is_directory` wrapper distinguish \22doesn't exist\22 from\0A// \22exists but isn't a directory\22 as a real `Err`, not silently\0A// collapse both into `false`.\0Along long path_is_dir(const char *path) {\0A    struct stat st;\0A    if (stat(path, &st) != 0) {\0A        return -1;\0A    }\0A    return S_ISDIR(st.st_mode) ? 1 : 0;\0A}\0A\00" }
