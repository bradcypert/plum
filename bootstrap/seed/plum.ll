         [s] \22=&l\22 (s),\0A                  [x] \22+&l\22 (x)\0A                  :\0A                  :\0A                  \22cc\22 /* clobbers flag bits */\0A                  );\0A    return (mbedtls_ct_condition_t) x;\0A#elif defined(MBEDTLS_CT_X86_64_ASM) && (defined(MBEDTLS_CT_SIZE_32) || defined(MBEDTLS_CT_SIZE_64))\0A    uint64_t s;\0A    asm volatile (\22mov  %[x], %[s]                                \5Cn\5Ct\22\0A                  \22neg  %[s]                                      \5Cn\5Ct\22\0A                  \22or   %[x], %[s]                                \5Cn\5Ct\22\0A                  \22sar  $63, %[s]                                 \5Cn\5Ct\22\0A                  :\0A                  [s] \22=&a\22 (s)\0A                  :\0A                  [x] \22D\22 (x)\0A                  :\0A                  );\0A    return (mbedtls_ct_condition_t) s;\0A#elif defined(MBEDTLS_CT_X86_ASM) && defined(MBEDTLS_CT_SIZE_32)\0A    uint32_t s;\0A    asm volatile (\22mov %[x], %[s]                                 \5Cn\5Ct\22\0A                  \22neg %[s]                                       \5Cn\5Ct\22\0A                  \22or %[s], %[x]                                  \5Cn\5Ct\22\0A                  \22sar $31, %[x]                                  \5Cn\5Ct\22\0A                  :\0A                  [s] \22=&c\22 (s),\0A                  [x] \22+&a\22 (x)\0A                  :\0A                  :\0A                  );\0A    return (mbedtls_ct_condition_t) x;\0A#else\0A    const mbedtls_ct_uint_t xo = mbedtls_ct_compiler_opaque(x);\0A#if defined(_MSC_VER)\0A    /* MSVC has a warning about unary minus on unsigned, but this is\0A     * well-defined and precisely what we want to do here */\0A#pragma warning( push )\0A#pragma warning( disable : 4146 )\0A#endif\0A    // y is negative (i.e., top bit set) iff x is non-zero\0A    mbedtls_ct_int_t y = (-xo) | -(xo >> 1);\0A\0A    // extract only the sign bit of y so that y == 1 (if x is non-zero) or 0 (if x 