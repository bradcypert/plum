@.str45565 = private global { i64, i64, [597 x i8] } { i64 -1, i64 596, [597 x i8] c"/**\0A * \5Cfile bignum_core_invasive.h\0A *\0A * \5Cbrief Function declarations for invasive functions of bignum core.\0A */\0A/**\0A *  Copyright The Mbed TLS Contributors\0A *  SPDX-License-Identifier: Apache-2.0 OR GPL-2.0-or-later\0A */\0A\0A#ifndef MBEDTLS_BIGNUM_CORE_INVASIVE_H\0A#define MBEDTLS_BIGNUM_CORE_INVASIVE_H\0A\0A#include \22bignum_core.h\22\0A\0A#if defined(MBEDTLS_TEST_HOOKS) && !defined(MBEDTLS_THREADING_C)\0A\0Aextern void (*mbedtls_safe_codepath_hook)(void);\0Aextern void (*mbedtls_unsafe_codepath_hook)(void);\0A\0A#endif /* MBEDTLS_TEST_HOOKS && !MBEDTLS_THREADING_C */\0A\0A#endif /* MBEDTLS_BIGNUM_CORE_INVASIVE_H */\0A\00" }
