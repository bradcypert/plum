@.str41119 = private global { i64, i64, [27247 x i8] } { i64 -1, i64 27246, [27247 x i8] c"/*\0A *  Elliptic curve DSA\0A *\0A *  Copyright The Mbed TLS Contributors\0A *  SPDX-License-Identifier: Apache-2.0 OR GPL-2.0-or-later\0A */\0A\0A/*\0A * References:\0A *\0A * SEC1 https://www.secg.org/sec1-v2.pdf\0A */\0A\0A#include \22common.h\22\0A\0A#if defined(MBEDTLS_ECDSA_C)\0A\0A#include \22mbedtls/ecdsa.h\22\0A#include \22mbedtls/asn1write.h\22\0A\0A#include <string.h>\0A\0A#if defined(MBEDTLS_ECDSA_DETERMINISTIC)\0A#include \22mbedtls/hmac_drbg.h\22\0A#endif\0A\0A#include \22mbedtls/platform.h\22\0A\0A#include \22mbedtls/platform_util.h\22\0A#include \22mbedtls/error.h\22\0A\0A#if defined(MBEDTLS_ECP_RESTARTABLE)\0A\0A/*\0A * Sub-context for ecdsa_verify()\0A */\0Astruct mbedtls_ecdsa_restart_ver {\0A    mbedtls_mpi u1, u2;     /* intermediate values  */\0A    enum {                  /* what to do next?     */\0A        ecdsa_ver_init = 0, /* getting started      */\0A        ecdsa_ver_muladd,   /* muladd step          */\0A    } state;\0A};\0A\0A/*\0A * Init verify restart sub-context\0A */\0Astatic void ecdsa_restart_ver_init(mbedtls_ecdsa_restart_ver_ctx *ctx)\0A{\0A    mbedtls_mpi_init(&ctx->u1);\0A    mbedtls_mpi_init(&ctx->u2);\0A    ctx->state = ecdsa_ver_init;\0A}\0A\0A/*\0A * Free the components of a verify restart sub-context\0A */\0Astatic void ecdsa_restart_ver_free(mbedtls_ecdsa_restart_ver_ctx *ctx)\0A{\0A    if (ctx == NULL) {\0A        return;\0A    }\0A\0A    mbedtls_mpi_free(&ctx->u1);\0A    mbedtls_mpi_free(&ctx->u2);\0A\0A    ecdsa_restart_ver_init(ctx);\0A}\0A\0A/*\0A * Sub-context for ecdsa_sign()\0A */\0Astruct mbedtls_ecdsa_restart_sig {\0A    int sign_tries;\0A    int key_tries;\0A    mbedtls_mpi k;          /* per-signature random */\0A    mbedtls_mpi r;          /* r value              */\0A    enum {                  /* what to do next?     */\0A        ecdsa_sig_init = 0, /* getting started      */\0A        ecdsa_sig_mul,      /* doing