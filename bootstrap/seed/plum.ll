@.str46201 = private global { i64, i64, [103922 x i8] } { i64 -1, i64 103921, [103922 x i8] c"/*\0A *  X.509 certificate parsing and verification\0A *\0A *  Copyright The Mbed TLS Contributors\0A *  SPDX-License-Identifier: Apache-2.0 OR GPL-2.0-or-later\0A */\0A/*\0A *  The ITU-T X.509 standard defines a certificate format for PKI.\0A *\0A *  http://www.ietf.org/rfc/rfc5280.txt (Certificates and CRLs)\0A *  http://www.ietf.org/rfc/rfc3279.txt (Alg IDs for CRLs)\0A *  http://www.ietf.org/rfc/rfc2986.txt (CSRs, aka PKCS#10)\0A *\0A *  http://www.itu.int/ITU-T/studygroups/com17/languages/X.680-0207.pdf\0A *  http://www.itu.int/ITU-T/studygroups/com17/languages/X.690-0207.pdf\0A *\0A *  [SIRO] https://cabforum.org/wp-content/uploads/Chunghwatelecom201503cabforumV4.pdf\0A */\0A\0A#include \22common.h\22\0A\0A#if defined(MBEDTLS_X509_CRT_PARSE_C)\0A\0A#include \22mbedtls/x509_crt.h\22\0A#include \22x509_internal.h\22\0A#include \22mbedtls/error.h\22\0A#include \22mbedtls/oid.h\22\0A#include \22mbedtls/platform_util.h\22\0A\0A#include <string.h>\0A\0A#if defined(MBEDTLS_PEM_PARSE_C)\0A#include \22mbedtls/pem.h\22\0A#endif\0A\0A#if defined(MBEDTLS_USE_PSA_CRYPTO)\0A#include \22psa/crypto.h\22\0A#include \22psa_util_internal.h\22\0A#include \22mbedtls/psa_util.h\22\0A#endif /* MBEDTLS_USE_PSA_CRYPTO */\0A#include \22pk_internal.h\22\0A\0A#include \22mbedtls/platform.h\22\0A\0A#if defined(MBEDTLS_THREADING_C)\0A#include \22mbedtls/threading.h\22\0A#endif\0A\0A#if defined(MBEDTLS_HAVE_TIME)\0A#if defined(_WIN32) && !defined(EFIX64) && !defined(EFI32)\0A#ifndef WIN32_LEAN_AND_MEAN\0A#define WIN32_LEAN_AND_MEAN\0A#endif\0A#include <windows.h>\0A#else\0A#include <time.h>\0A#endif\0A#endif\0A\0A#if defined(MBEDTLS_FS_IO)\0A#include <stdio.h>\0A#if !defined(_WIN32) || defined(EFIX64) || defined(EFI32)\0A#include <sys/types.h>\0A#include <sys/stat.h>\0A#if defined(__MBED__)\0A#include <platform/mbed_retarget.h>\0A#else\0A#include <dirent.h>\0A#endif /* __MBED__ */\0A#include <errno.h>\0A#endif /* !_WIN32 || EFIX64 || EFI32 */\0A#endif\0A\0A/*\0A * Item in a verification chain: cert and flags for it\0A */\0Atypedef struct {\0A    mbedtls_x509_crt *crt;\0A    uint32_t flags;\0A} x509_crt_verify_chain_item;\0A\0A/*\0A * Max size of verification chain: end-entity + intermediates + trusted root\0A */\0A#define X509_MAX_VERIFY_CHAIN_SIZE    (MBEDTLS_X509_MAX_INTERMEDIATE_CA + 2)\0A\0A/* Default profile. Do not remove items unless there are serious security\0A * concerns. */\0Aconst mbedtls_x509_crt_profile mbedtls_x509_crt_profile_default =\0A{\0A    /* Hashes from SHA-256 and above. Note that this selection\0A     * should be aligned with ssl_preset_default_hashes in ssl_tls.c. */\0A    MBEDTLS_X509_ID_FLAG(MBEDTLS_MD_SHA256) |\0A    MBEDTLS_X509_ID_FLAG(MBEDTLS_MD_SHA384) |\0A    MBEDTLS_X509_ID_FLAG(MBEDTLS_MD_SHA512),\0A    0xFFFFFFF, /* Any PK alg    */\0A#if defined(MBEDTLS_PK_HAVE_ECC_KEYS)\0A    /* Curves at or above 128-bit security level. Note that this selection\0A     * should be aligned with ssl_preset_default_curves in ssl_tls.c. */\0A    MBEDTLS_X509_ID_FLAG(MBEDTLS_ECP_DP_SECP256R1) |\0A    MBEDTLS_X509_ID_FLAG(MBEDTLS_ECP_DP_SECP384R1) |\0A    MBEDTLS_X509_ID_FLAG(MBEDTLS_ECP_DP_SECP521R1) |\0A    MBEDTLS_X509_ID_FLAG(MBEDTLS_ECP_DP_BP256R1) |\0A    MBEDTLS_X509_ID_FLAG(MBEDTLS_ECP_DP_BP384R1) |\0A    MBEDTLS_X509_ID_FLAG(MBEDTLS_ECP_DP_BP512R1) |\0A    0,\0A#else /* MBEDTLS_PK_HAVE_ECC_KEYS */\0A    0,\0A#endif /* MBEDTLS_PK_HAVE_ECC_KEYS */\0A    2048,\0A};\0A\0A/* Next-generation profile. Currently identical to the default, but may\0A * be tightened at any time. */\0Aconst mbedtls_x509_crt_profile mbedtls_x509_crt_profile_next =\0A{\0A    /* Hashes from SHA-256 and above. */\0A    MBEDTLS_X509_ID_FLAG(MBEDTLS_MD_SHA256) |\0A    MBEDTLS_X509_ID_FLAG(MBEDTLS_MD_SHA384) |\0A    MBEDTLS_X509_ID_FLAG(MBEDTLS_MD_SHA512),\0A    0xFFFFFFF, /* Any PK alg    */\0A#if defined(MBEDTLS_ECP_C)\0A    /* Curves at or above 128-bit security level. */\0A    MBEDTLS_X509_ID_FLAG(MBEDTLS_ECP_DP_SECP256R1) |\0A    MBEDTLS_X509_ID_FLAG(MBEDTLS_ECP_DP_SECP384R1) |\0A    MBEDTLS_X509_ID_FLAG(MBEDTLS_ECP_DP_SECP521R1) |\0A    MBEDTLS_X509_ID_FLAG(MBEDTLS_ECP_DP_BP256R1) |\0A    MBEDTLS_X509_ID_FLAG(MBEDTLS_ECP_DP_BP384R1) |\0A    MBEDTLS_X509_ID_FLAG(MBEDTLS_ECP_DP_BP512R1) |\0A    MBEDTLS_X509_ID_FLAG(MBEDTLS_ECP_DP_SECP256K1),\0A#else\0A    0,\0A#endif\0A    2048,\0A};\0A\0A/*\0A * NSA Suite B Profile\0A */\0Aconst mbedtls_x509_crt_profile mbedtls_x509_crt_profile_suiteb =\0A{\0A    /* Only SHA-256 and 384 */\0A    MBEDTLS_X509_ID_FLAG(MBEDTLS_MD_SHA256) |\0A    MBEDTLS_X509_ID_FLAG(MBEDTLS_MD_SHA384),\0A    /* Only ECDSA */\0A    MBEDTLS_X509_ID_FLAG(MBEDTLS_PK_ECDSA) |\0A    MBEDTLS_X509_ID_FLAG(MBEDTLS_PK_ECKEY),\0A#if defined(MBEDTLS_PK_HAVE_ECC_KEYS)\0A    /* Only NIST P-256 and P-384 */\0A    MBEDTLS_X509_ID_FLAG(MBEDTLS_ECP_DP_SECP256R1) |\0A    MBEDTLS_X509_ID_FLAG(MBEDTLS_ECP_DP_SECP384R1),\0A#else /* MBEDTLS_PK_HAVE_ECC_KEYS */\0A    0,\0A#endif /* MBEDTLS_PK_HAVE_ECC_KEYS */\0A    0,\0A};\0A\0A/*\0A * Empty / all-forbidden profile\0A */\0Aconst mbedtls_x509_crt_profile mbedtls_x509_crt_profile_none =\0A{\0A    0,\0A    0,\0A    0,\0A    (uint32_t) -1,\0A};\0A\0A/*\0A * Check md_alg against profile\0A * Return 0 if md_alg is acceptable for this profile, -1 otherwise\0A */\0Astatic int x509_profile_check_md_alg(const mbedtls_x509_crt_profile *profile,\0A                                     mbedtls_md_type_t md_alg)\0A{\0A    if (md_alg == MBEDTLS_MD_NONE) {\0A        return -1;\0A    }\0A\0A    if ((profile->allowed_mds & MBEDTLS_X509_ID_FLAG(md_alg)) != 0) {\0A        return 0;\0A    }\0A\0A    return -1;\0A}\0A\0A/*\0A * Check pk_alg against profile\0A * Return 0 if pk_alg is acceptable for this profile, -1 otherwise\0A */\0Astatic int x509_profile_check_pk_alg(const mbedtls_x509_crt_profile *profile,\0A                                     mbedtls_pk_type_t pk_alg)\0A{\0A    if (pk_alg == MBEDTLS_PK_NONE) {\0A        return -1;\0A    }\0A\0A    if ((profile->allowed_pks & MBEDTLS_X509_ID_FLAG(pk_alg)) != 0) {\0A        return 0;\0A    }\0A\0A    return -1;\0A}\0A\0A/*\0A * Check key against profile\0A * Return 0 if pk is acceptable for this profile, -1 otherwise\0A */\0Astatic int x509_profile_check_key(const mbedtls_x509_crt_profile *profile,\0A                                  const mbedtls_pk_context *pk)\0A{\0A    const mbedtls_pk_type_t pk_alg = mbedtls_pk_get_type(pk);\0A\0A#if defined(MBEDTLS_RSA_C)\0A    if (pk_alg == MBEDTLS_PK_RSA || pk_alg == MBEDTLS_PK_RSASSA_PSS) {\0A        if (mbedtls_pk_get_bitlen(pk) >= profile->rsa_min_bitlen) {\0A            return 0;\0A        }\0A\0A        return -1;\0A    }\0A#endif /* MBEDTLS_RSA_C */\0A\0A#if defined(MBEDTLS_PK_HAVE_ECC_KEYS)\0A    if (pk_alg == MBEDTLS_PK_ECDSA ||\0A        pk_alg == MBEDTLS_PK_ECKEY ||\0A        pk_alg == MBEDTLS_PK_ECKEY_DH) {\0A        const mbedtls_ecp_group_id gid = mbedtls_pk_get_ec_group_id(pk);\0A\0A        if (gid == MBEDTLS_ECP_DP_NONE) {\0A            return -1;\0A        }\0A\0A        if ((profile->allowed_curves & MBEDTLS_X509_ID_FLAG(gid)) != 0) {\0A            return 0;\0A        }\0A\0A        return -1;\0A    }\0A#endif /* MBEDTLS_PK_HAVE_ECC_KEYS */\0A\0A    return -1;\0A}\0A\0A/*\0A * Like memcmp, but case-insensitive and always returns -1 if different\0A */\0Astatic int x509_memcasecmp(const void *s1, const void *s2, size_t len)\0A{\0A    size_t i;\0A    unsigned char diff;\0A    const unsigned char *n1 = s1, *n2 = s2;\0A\0A    for (i = 0; i < len; i++) {\0A        diff = n1[i] ^ n2[i];\0A\0A        if (diff == 0) {\0A            continue;\0A        }\0A\0A        if (diff == 32 &&\0A            ((n1[i] >= 'a' && n1[i] <= 'z') ||\0A             (n1[i] >= 'A' && n1[i] <= 'Z'))) {\0A            continue;\0A        }\0A\0A        return -1;\0A    }\0A\0A    return 0;\0A}\0A\0A/*\0A * Return 0 if name matches wildcard, -1 otherwise\0A */\0Astatic int x509_check_wildcard(const char *cn, const mbedtls_x509_buf *name)\0A{\0A    size_t i;\0A    size_t cn_idx = 0, cn_len = strlen(cn);\0A\0A    /* We can't have a match if there is no wildcard to match */\0A    if (name->len < 3 || name->p[0] != '*' || name->p[1] != '.') {\0A        return -1;\0A    }\0A\0A    for (i = 0; i < cn_len; ++i) {\0A        if (cn[i] == '.') {\0A            cn_idx = i;\0A            break;\0A        }\0A    }\0A\0A    if (cn_idx == 0) {\0A        return -1;\0A    }\0A\0A    if (cn_len - cn_idx == name->len - 1 &&\0A        x509_memcasecmp(name->p + 1, cn + cn_idx, name->len - 1) == 0) {\0A        return 0;\0A    }\0A\0A    return -1;\0A}\0A\0A/*\0A * Compare two X.509 strings, case-insensitive, and allowing for some encoding\0A * variations (but not all).\0A *\0A * Return 0 if equal, -1 otherwise.\0A */\0Astatic int x509_string_cmp(const mbedtls_x509_buf *a, const mbedtls_x509_buf *b)\0A{\0A    if (a->tag == b->tag &&\0A        a->len == b->len &&\0A        memcmp(a->p, b->p, b->len) == 0) {\0A        return 0;\0A    }\0A\0A    if ((a->tag == MBEDTLS_ASN1_UTF8_STRING || a->tag == MBEDTLS_ASN1_PRINTABLE_STRING) &&\0A        (b->tag == MBEDTLS_ASN1_UTF8_STRING || b->tag == MBEDTLS_ASN1_PRINTABLE_STRING) &&\0A        a->len == b->len &&\0A        x509_memcasecmp(a->p, b->p, b->len) == 0) {\0A        return 0;\0A    }\0A\0A    return -1;\0A}\0A\0A/*\0A * Compare two X.509 Names (aka rdnSequence).\0A *\0A * See RFC 5280 section 7.1, though we don't implement the whole algorithm:\0A * we sometimes return unequal when the full algorithm would return equal,\0A * but never the other way. (In particular, we don't do Unicode normalisation\0A * or space folding.)\0A *\0A * Return 0 if equal, -1 otherwise.\0A */\0Astatic int x509_name_cmp(const mbedtls_x509_name *a, const mbedtls_x509_name *b)\0A{\0A    /* Avoid recursion, it might not be optimised by the compiler */\0A    while (a != NULL || b != NULL) {\0A        if (a == NULL || b == NULL) {\0A            return -1;\0A        }\0A\0A        /* type */\0A        if (a->oid.tag != b->oid.tag ||\0A            a->oid.len != b->oid.len ||\0A            memcmp(a->oid.p, b->oid.p, b->oid.len) != 0) {\0A            return -1;\0A        }\0A\0A        /* value */\0A        if (x509_string_cmp(&a->val, &b->val) != 0) {\0A            return -1;\0A        }\0A\0A        /* structure of the list of sets */\0A        if (a->next_merged != b->next_merged) {\0A            return -1;\0A        }\0A\0A        a = a->next;\0A        b = b->next;\0A    }\0A\0A    /* a == NULL == b */\0A    return 0;\0A}\0A\0A/*\0A * Reset (init or clear) a verify_chain\0A */\0Astatic void x509_crt_verify_chain_reset(\0A    mbedtls_x509_crt_verify_chain *ver_chain)\0A{\0A    size_t i;\0A\0A    for (i = 0; i < MBEDTLS_X509_MAX_VERIFY_CHAIN_SIZE; i++) {\0A        ver_chain->items[i].crt = NULL;\0A        ver_chain->items[i].flags = (uint32_t) -1;\0A    }\0A\0A    ver_chain->len = 0;\0A\0A#if defined(MBEDTLS_X509_TRUSTED_CERTIFICATE_CALLBACK)\0A    ver_chain->trust_ca_cb_result = NULL;\0A#endif /* MBEDTLS_X509_TRUSTED_CERTIFICATE_CALLBACK */\0A}\0A\0A/*\0A *  Version  ::=  INTEGER  {  v1(0), v2(1), v3(2)  }\0A */\0Astatic int x509_get_version(unsigned char **p,\0A                            const unsigned char *end,\0A                            int *ver)\0A{\0A    int ret = MBEDTLS_ERR_ERROR_CORRUPTION_DETECTED;\0A    size_t len;\0A\0A    if ((ret = mbedtls_asn1_get_tag(p, end, &len,\0A                                    MBEDTLS_ASN1_CONTEXT_SPECIFIC | MBEDTLS_ASN1_CONSTRUCTED |\0A                                    0)) != 0) {\0A        if (ret == MBEDTLS_ERR_ASN1_UNEXPECTED_TAG) {\0A            *ver = 0;\0A            return 0;\0A        }\0A\0A        return MBEDTLS_ERROR_ADD(MBEDTLS_ERR_X509_INVALID_FORMAT, ret);\0A    }\0A\0A    end = *p + len;\0A\0A    if ((ret = mbedtls_asn1_get_int(p, end, ver)) != 0) {\0A        return MBEDTLS_ERROR_ADD(MBEDTLS_ERR_X509_INVALID_VERSION, ret);\0A    }\0A\0A    if (*p != end) {\0A        return MBEDTLS_ERROR_ADD(MBEDTLS_ERR_X509_INVALID_VERSION,\0A                                 MBEDTLS_ERR_ASN1_LENGTH_MISMATCH);\0A    }\0A\0A    return 0;\0A}\0A\0A/*\0A *  Validity ::= SEQUENCE {\0A *       notBefore      Time,\0A *       notAfter       Time }\0A */\0Astatic int x509_get_dates(unsigned char **p,\0A                          const unsigned char *end,\0A                          mbedtls_x509_time *from,\0A                          mbedtls_x509_time *to)\0A{\0A    int ret = MBEDTLS_ERR_ERROR_CORRUPTION_DETECTED;\0A    size_t len;\0A\0A    if ((ret = mbedtls_asn1_get_tag(p, end, &len,\0A                                    MBEDTLS_ASN1_CONSTRUCTED | MBEDTLS_ASN1_SEQUENCE)) != 0) {\0A        return MBEDTLS_ERROR_ADD(MBEDTLS_ERR_X509_INVALID_DATE, ret);\0A    }\0A\0A    end = *p + len;\0A\0A    if ((ret = mbedtls_x509_get_time(p, end, from)) != 0) {\0A        return ret;\0A    }\0A\0A    if ((ret = mbedtls_x509_get_time(p, end, to)) != 0) {\0A        return ret;\0A    }\0A\0A    if (*p != end) {\0A        return MBEDTLS_ERROR_ADD(MBEDTLS_ERR_X509_INVALID_DATE,\0A                                 MBEDTLS_ERR_ASN1_LENGTH_MISMATCH);\0A    }\0A\0A    return 0;\0A}\0A\0A/*\0A * X.509 v2/v3 unique identifier (not parsed)\0A */\0Astatic int x509_get_uid(unsigned char **p,\0A                        const unsigned char *end,\0A                        mbedtls_x509_buf *uid, int n)\0A{\0A    int ret = MBEDTLS_ERR_ERROR_CORRUPTION_DETECTED;\0A\0A    if (*p == end) {\0A        return 0;\0A    }\0A\0A    uid->tag = **p;\0A\0A    if ((ret = mbedtls_asn1_get_tag(p, end, &uid->len,\0A                                    MBEDTLS_ASN1_CONTEXT_SPECIFIC | MBEDTLS_ASN1_CONSTRUCTED |\0A                                    n)) != 0) {\0A        if (ret == MBEDTLS_ERR_ASN1_UNEXPECTED_TAG) {\0A            return 0;\0A        }\0A\0A        return MBEDTLS_ERROR_ADD(MBEDTLS_ERR_X509_INVALID_FORMAT, ret);\0A    }\0A\0A    uid->p = *p;\0A    *p += uid->len;\0A\0A    return 0;\0A}\0A\0Astatic int x509_get_basic_constraints(unsigned char **p,\0A                                      const unsigned char *end,\0A                                      int *ca_istrue,\0A                                      int *max_pathlen)\0A{\0A    int ret = MBEDTLS_ERR_ERROR_CORRUPTION_DETECTED;\0A    size_t len;\0A\0A    /*\0A     * BasicConstraints ::= SEQUENCE {\0A     *      cA                      BOOLEAN DEFAULT FALSE,\0A     *      pathLenConstraint       INTEGER (0..MAX) OPTIONAL }\0A     */\0A    *ca_istrue = 0; /* DEFAULT FALSE */\0A    *max_pathlen = 0; /* endless */\0A\0A    if ((ret = mbedtls_asn1_get_tag(p, end, &len,\0A                                    MBEDTLS_ASN1_CONSTRUCTED | MBEDTLS_ASN1_SEQUENCE)) != 0) {\0A        return MBEDTLS_ERROR_ADD(MBEDTLS_ERR_X509_INVALID_EXTENSIONS, ret);\0A    }\0A\0A    if (*p == end) {\0A        return 0;\0A    }\0A\0A    if ((ret = mbedtls_asn1_get_bool(p, end, ca_istrue)) != 0) {\0A        if (ret == MBEDTLS_ERR_ASN1_UNEXPECTED_TAG) {\0A            ret = mbedtls_asn1_get_int(p, end, ca_istrue);\0A        }\0A\0A        if (ret != 0) {\0A            return MBEDTLS_ERROR_ADD(MBEDTLS_ERR_X509_INVALID_EXTENSIONS, ret);\0A        }\0A\0A        if (*ca_istrue != 0) {\0A            *ca_istrue = 1;\0A        }\0A    }\0A\0A    if (*p == end) {\0A        return 0;\0A    }\0A\0A    if ((ret = mbedtls_asn1_get_int(p, end, max_pathlen)) != 0) {\0A        return MBEDTLS_ERROR_ADD(MBEDTLS_ERR_X509_INVALID_EXTENSIONS, ret);\0A    }\0A\0A    if (*p != end) {\0A        return MBEDTLS_ERROR_ADD(MBEDTLS_ERR_X509_INVALID_EXTENSIONS,\0A                                 MBEDTLS_ERR_ASN1_LENGTH_MISMATCH);\0A    }\0A\0A    /* Do not accept max_pathlen equal to INT_MAX to avoid a signed integer\0A     * overflow, which is an undefined behavior. */\0A    if (*max_pathlen == INT_MAX) {\0A        return MBEDTLS_ERROR_ADD(MBEDTLS_ERR_X509_INVALID_EXTENSIONS,\0A                                 MBEDTLS_ERR_ASN1_INVALID_LENGTH);\0A    }\0A\0A    (*max_pathlen)++;\0A\0A    return 0;\0A}\0A\0A/*\0A * ExtKeyUsageSyntax ::= SEQUENCE SIZE (1..MAX) OF KeyPurposeId\0A *\0A * KeyPurposeId ::= OBJECT IDENTIFIER\0A */\0Astatic int x509_get_ext_key_usage(unsigned char **p,\0A                                  const unsigned char *end,\0A                                  mbedtls_x509_sequence *ext_key_usage)\0A{\0A    int ret = MBEDTLS_ERR_ERROR_CORRUPTION_DETECTED;\0A\0A    if ((ret = mbedtls_asn1_get_sequence_of(p, end, ext_key_usage, MBEDTLS_ASN1_OID)) != 0) {\0A        return MBEDTLS_ERROR_ADD(MBEDTLS_ERR_X509_INVALID_EXTENSIONS, ret);\0A    }\0A\0A    /* Sequence length must be >= 1 */\0A    if (ext_key_usage->buf.p == NULL) {\0A        return MBEDTLS_ERROR_ADD(MBEDTLS_ERR_X509_INVALID_EXTENSIONS,\0A                                 MBEDTLS_ERR_ASN1_INVALID_LENGTH);\0A    }\0A\0A    return 0;\0A}\0A\0A/*\0A * SubjectKeyIdentifier ::= KeyIdentifier\0A *\0A * KeyIdentifier ::= OCTET STRING\0A */\0Astatic int x509_get_subject_key_id(unsigned char **p,\0A                                   const unsigned char *end,\0A                                   mbedtls_x509_buf *subject_key_id)\0A{\0A    int ret = MBEDTLS_ERR_ERROR_CORRUPTION_DETECTED;\0A    size_t len = 0u;\0A\0A    if ((ret = mbedtls_asn1_get_tag(p, end, &len,\0A                                    MBEDTLS_ASN1_OCTET_STRING)) != 0) {\0A        return MBEDTLS_ERROR_ADD(MBEDTLS_ERR_X509_INVALID_EXTENSIONS, ret);\0A    }\0A\0A    subject_key_id->len = len;\0A    subject_key_id->tag = MBEDTLS_ASN1_OCTET_STRING;\0A    subject_key_id->p = *p;\0A    *p += len;\0A\0A    if (*p != end) {\0A        return MBEDTLS_ERROR_ADD(MBEDTLS_ERR_X509_INVALID_EXTENSIONS,\0A                                 MBEDTLS_ERR_ASN1_LENGTH_MISMATCH);\0A    }\0A\0A    return 0;\0A}\0A\0A/*\0A * AuthorityKeyIdentifier ::= SEQUENCE {\0A *        keyIdentifier [0] KeyIdentifier OPTIONAL,\0A *        authorityCertIssuer [1] GeneralNames OPTIONAL,\0A *        authorityCertSerialNumber [2] CertificateSerialNumber OPTIONAL }\0A *\0A *    KeyIdentifier ::= OCTET STRING\0A */\0Astatic int x509_get_authority_key_id(unsigned char **p,\0A                                     unsigned char *end,\0A                                     mbedtls_x509_authority *authority_key_id)\0A{\0A    int ret = MBEDTLS_ERR_ERROR_CORRUPTION_DETECTED;\0A    size_t len = 0u;\0A\0A    if ((ret = mbedtls_asn1_get_tag(p, end, &len,\0A                                    MBEDTLS_ASN1_CONSTRUCTED | MBEDTLS_ASN1_SEQUENCE)) != 0) {\0A        return MBEDTLS_ERROR_ADD(MBEDTLS_ERR_X509_INVALID_EXTENSIONS, ret);\0A    }\0A\0A    if (*p + len != end) {\0A        return MBEDTLS_ERROR_ADD(MBEDTLS_ERR_X509_INVALID_EXTENSIONS,\0A                                 MBEDTLS_ERR_ASN1_LENGTH_MISMATCH);\0A    }\0A\0A    ret = mbedtls_asn1_get_tag(p, end, &len,\0A                               MBEDTLS_ASN1_CONTEXT_SPECIFIC);\0A\0A    /* KeyIdentifier is an OPTIONAL field */\0A    if (ret == 0) {\0A        authority_key_id->keyIdentifier.len = len;\0A        authority_key_id->keyIdentifier.p = *p;\0A        /* Setting tag of the keyIdentfier intentionally to 0x04.\0A         * Although the .keyIdentfier field is CONTEXT_SPECIFIC ([0] OPTIONAL),\0A         * its tag with the content is the payload of on OCTET STRING primitive */\0A        authority_key_id->keyIdentifier.tag = MBEDTLS_ASN1_OCTET_STRING;\0A\0A        *p += len;\0A    } else if (ret != MBEDTLS_ERR_ASN1_UNEXPECTED_TAG) {\0A        return MBEDTLS_ERROR_ADD(MBEDTLS_ERR_X509_INVALID_EXTENSIONS, ret);\0A    }\0A\0A    if (*p < end) {\0A        /* Getting authorityCertIssuer using the required specific class tag [1] */\0A        if ((ret = mbedtls_asn1_get_tag(p, end, &len,\0A                                        MBEDTLS_ASN1_CONTEXT_SPECIFIC | MBEDTLS_ASN1_CONSTRUCTED |\0A                                        1)) != 0) {\0A            /* authorityCertIssuer and authorityCertSerialNumber MUST both\0A               be present or both be absent. At th