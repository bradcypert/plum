0A\0A    status = psa_reserve_free_key_slot(NULL, p_slot);\0A    if (status != PSA_SUCCESS) {\0A#if defined(MBEDTLS_THREADING_C)\0A        PSA_THREADING_CHK_RET(mbedtls_mutex_unlock(\0A                                  &mbedtls_threading_key_slot_mutex));\0A#endif\0A        return status;\0A    }\0A\0A    (*p_slot)->attr.id = key;\0A    (*p_slot)->attr.lifetime = PSA_KEY_LIFETIME_PERSISTENT;\0A\0A    status = PSA_ERROR_DOES_NOT_EXIST;\0A#if defined(MBEDTLS_PSA_CRYPTO_BUILTIN_KEYS)\0A    /* Load keys in the 'builtin' range through their own interface */\0A    status = psa_load_builtin_key_into_slot(*p_slot);\0A#endif /* MBEDTLS_PSA_CRYPTO_BUILTIN_KEYS */\0A\0A#if defined(MBEDTLS_PSA_CRYPTO_STORAGE_C)\0A    if (status == PSA_ERROR_DOES_NOT_EXIST) {\0A        status = psa_load_persistent_key_into_slot(*p_slot);\0A    }\0A#endif /* defined(MBEDTLS_PSA_CRYPTO_STORAGE_C) */\0A\0A    if (status != PSA_SUCCESS) {\0A        psa_wipe_key_slot(*p_slot);\0A\0A        /* If the key does not exist, we need to return\0A         * PSA_ERROR_INVALID_HANDLE. */\0A        if (status == PSA_ERROR_DOES_NOT_EXIST) {\0A            status = PSA_ERROR_INVALID_HANDLE;\0A        }\0A    } else {\0A        /* Add implicit usage flags. */\0A        psa_extend_key_usage_flags(&(*p_slot)->attr.policy.usage);\0A\0A        psa_key_slot_state_transition((*p_slot), PSA_SLOT_FILLING,\0A                                      PSA_SLOT_FULL);\0A        status = psa_register_read(*p_slot);\0A    }\0A\0A#else /* MBEDTLS_PSA_CRYPTO_STORAGE_C || MBEDTLS_PSA_CRYPTO_BUILTIN_KEYS */\0A    status = PSA_ERROR_INVALID_HANDLE;\0A#endif /* MBEDTLS_PSA_CRYPTO_STORAGE_C || MBEDTLS_PSA_CRYPTO_BUILTIN_KEYS */\0A\0A    if (status != PSA_SUCCESS) {\0A        *p_slot = NULL;\0A    }\0A#if defined(MBEDTLS_THREADING_C)\0A    PSA_THREADING_CHK_RET(mbedtls_mutex_unlock(\0A                              &mbedtls_threading_key_slot_mutex));\0A#endif\0A    return status;\0A}\0A\0Apsa_status_t psa_unregister_read(psa_key_slot_t *slo