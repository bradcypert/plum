@.str40795 = private global { i64, i64, [3933 x i8] } { i64 -1, i64 3932, [3933 x i8] c"/*\0A *  Context structure declaration of the Mbed TLS software-based PSA drivers\0A *  called through the PSA Crypto driver dispatch layer.\0A *  This file contains the context structures of those algorithms which do not\0A *  rely on other algorithms, i.e. are 'primitive' algorithms.\0A *\0A * \5Cnote This file may not be included directly. Applications must\0A * include psa/crypto.h.\0A *\0A * \5Cnote This header and its content are not part of the Mbed TLS API and\0A * applications must not depend on it. Its main purpose is to define the\0A * multi-part state objects of the Mbed TLS software-based PSA drivers. The\0A * definitions of these objects are then used by crypto_struct.h to define the\0A * implementation-defined types of PSA multi-part state objects.\0A */\0A/*\0A *  Copyright The Mbed TLS Contributors\0A *  SPDX-License-Identifier: Apache-2.0 OR GPL-2.0-or-later\0A */\0A\0A#ifndef PSA_CRYPTO_BUILTIN_PRIMITIVES_H\0A#define PSA_CRYPTO_BUILTIN_PRIMITIVES_H\0A#include \22mbedtls/private_access.h\22\0A\0A#include <psa/crypto_driver_common.h>\0A\0A/*\0A * Hash multi-part operation definitions.\0A */\0A\0A#include \22mbedtls/md5.h\22\0A#include \22mbedtls/ripemd160.h\22\0A#include \22mbedtls/sha1.h\22\0A#include \22mbedtls/sha256.h\22\0A#include \22mbedtls/sha512.h\22\0A#include \22mbedtls/sha3.h\22\0A\0A#if defined(MBEDTLS_PSA_BUILTIN_ALG_MD5) || \5C\0A    defined(MBEDTLS_PSA_BUILTIN_ALG_RIPEMD160) || \5C\0A    defined(MBEDTLS_PSA_BUILTIN_ALG_SHA_1) || \5C\0A    defined(MBEDTLS_PSA_BUILTIN_ALG_SHA_224) || \5C\0A    defined(MBEDTLS_PSA_BUILTIN_ALG_SHA_256) || \5C\0A    defined(MBEDTLS_PSA_BUILTIN_ALG_SHA_384) || \5C\0A    defined(MBEDTLS_PSA_BUILTIN_ALG_SHA_512) || \5C\0A    defined(MBEDTLS_PSA_BUILTIN_ALG_SHA3_224) || \5C\0A    defined(MBEDTLS_PSA_BUILTIN_ALG_SHA3_256) || \5C\0A    defined(MBEDTLS_PSA_BUILTIN_ALG_SHA3_384) || \5C\0A    defined(MBEDTLS_PSA_BUILTIN_ALG_SHA3_512)\0A#define MBEDTLS_PSA_BUILTIN_HASH\0A#endif\0A\0Atypedef struct {\0A    psa_algorithm_t MBEDTLS_PRIVATE(alg);\0A    union {\0A        unsigned dummy; /* Make the union non-empty even with no supported algorithms. */\0A#if defined(MBEDTLS_PSA_BUILTIN_ALG_MD5)\0A        mbedtls_md5_context md5;\0A#endif\0A#if defined(MBEDTLS_PSA_BUILTIN_ALG_RIPEMD160)\0A        mbedtls_ripemd160_context ripemd160;\0A#endif\0A#if defined(MBEDTLS_PSA_BUILTIN_ALG_SHA_1)\0A        mbedtls_sha1_context sha1;\0A#endif\0A#if defined(MBEDTLS_PSA_BUILTIN_ALG_SHA_256) || \5C\0A        defined(MBEDTLS_PSA_BUILTIN_ALG_SHA_224)\0A        mbedtls_sha256_context sha256;\0A#endif\0A#if defined(MBEDTLS_PSA_BUILTIN_ALG_SHA_512) || \5C\0A        defined(MBEDTLS_PSA_BUILTIN_ALG_SHA_384)\0A        mbedtls_sha512_context sha512;\0A#endif\0A#if defined(MBEDTLS_PSA_BUILTIN_ALG_SHA3_224) || \5C\0A        defined(MBEDTLS_PSA_BUILTIN_ALG_SHA3_256) || \5C\0A        defined(MBEDTLS_PSA_BUILTIN_ALG_SHA3_384) || \5C\0A        defined(MBEDTLS_PSA_BUILTIN_ALG_SHA3_512)\0A        mbedtls_sha3_context sha3;\0A#endif\0A    } MBEDTLS_PRIVATE(ctx);\0A} mbedtls_psa_hash_operation_t;\0A\0A#define MBEDTLS_PSA_HASH_OPERATION_INIT { 0, { 0 } }\0A\0A/*\0A * Cipher multi-part operation definitions.\0A */\0A\0A#include \22mbedtls/cipher.h\22\0A\0A#if defined(MBEDTLS_PSA_BUILTIN_ALG_STREAM_CIPHER) || \5C\0A    defined(MBEDTLS_PSA_BUILTIN_ALG_CTR) || \5C\0A    defined(MBEDTLS_PSA_BUILTIN_ALG_CFB) || \5C\0A    defined(MBEDTLS_PSA_BUILTIN_ALG_OFB) || \5C\0A    defined(MBEDTLS_PSA_BUILTIN_ALG_ECB_NO_PADDING) || \5C\0A    defined(MBEDTLS_PSA_BUILTIN_ALG_CBC_NO_PADDING) || \5C\0A    defined(MBEDTLS_PSA_BUILTIN_ALG_CBC_PKCS7) || \5C\0A    defined(MBEDTLS_PSA_BUILTIN_ALG_CCM_STAR_NO_TAG)\0A#define MBEDTLS_PSA_BUILTIN_CIPHER  1\0A#endif\0A\0Atypedef struct {\0A    /* Context structure for the Mbed TLS cipher implementation. */\0A    psa_algorithm_t MBEDTLS_PRIVATE(alg);\0A    uint8_t MBEDTLS_PRIVATE(iv_length);\0A    uint8_t MBEDTLS_PRIVATE(block_length);\0A    union {\0A        unsigned int MBEDTLS_PRIVATE(dummy);\0A        mbedtls_cipher_context_t MBEDTLS_PRIVATE(cipher);\0A    } MBEDTLS_PRIVATE(ctx);\0A} mbedtls_psa_cipher_operation_t;\0A\0A#define MBEDTLS_PSA_CIPHER_OPERATION_INIT { 0, 0, 0, { 0 } }\0A\0A#endif /* PSA_CRYPTO_BUILTIN_PRIMITIVES_H */\0A\00" }
