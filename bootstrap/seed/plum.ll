se { Err(\22File.close: close failed\22) }\0A}\0A\0A// --- Running a program ---\0A//\0A// `process_run_raw` takes its arguments TAB-joined in a single string\0A// because an extern boundary has no `Array[String]` -- see\0A// `native_stdlib/process_shim.c`. The join happens here rather than in\0A// the runtime, where it would have to be written in IR.\0A\0Aextern \22C\22 { fn process_capture_status(h: Int) -> Int; }\0A\0Alet process_run_raw (program: String) (args_joined: String) (argc: Int): Int = 0\0Alet process_exit_code_raw (handle: Int): Int = 0\0Alet process_stdout_raw (handle: Int): String = \22\22\0Alet process_stderr_raw (handle: Int): String = \22\22\0Alet process_free_raw (handle: Int): Bool = false\0A\0A/// What a finished process left behind.\0A///\0A/// `exit_code` is the child's own status: a non-zero one is an ordinary\0A/// result, not an error. Launch or output-capture failures return `Err`.\0Apub struct ProcessResult { pub exit_code: Int, pub stdout: String, pub stderr: String }\0A\0A/// NO leading separator: `process_run` points argv[1] at the WHOLE\0A/// joined string, so a leading tab makes argv[1] empty and pushes the\0A/// last real argument past `argc`, silently dropping it. A plain fold\0A/// that prefixes every element is NOT equivalent.\0Alet join_args_acc (args: Array[String]) (i: Int) (acc: String): String =\0A    if i >= args.len() { acc }\0A    else if i == 0 { join_args_acc(args, i + 1, args[i]) }\0A    else { join_args_acc(args, i + 1, acc.concat(\22\5Ct\22).concat(args[i])) }\0A\0A/// A non-zero exit code is an ordinary `Ok`. `Err` means the process\0A/// could not be started, or its output could not be captured completely.\0Apub let run_process (program: String) (args: Array[String]): Result[ProcessResult, String] = {\0A    let joined = join_args_acc(args, 0, \22\22);\0A    let handle = process_run_raw(program, joined, args.len());\0A    if handle < 0 { Err(\22Os.run_process: could not start process: \22.concat(program)) }\0A    else if unsafe { process_capture_status(handle) } != 0 {\0A        let freed = process_free_raw(handle);\0A        Err(\22Os.run_process: could not read captured output\22)\0A    }\0A    else {\0A        let result = ProcessResult {\0A            exit_code: process_exit_code_raw(handle),\0A            stdout: process_stdout_raw(handle),\0A            stderr: process_stderr_raw(handle),\0A        };\0A        let freed = process_free_raw(handle);\0A        Ok(result)\0A    }\0A}\0A\0A// --- Process identity ---\0A//\0A// argv, the working directory, stdin and stderr. `args()` has\0A// always existed as a compiler builtin and is documented now;\0A// the rest was reachable only through the private C shims the\0A// language server uses.\0Aextern \22C\22 {\0A    fn os_cwd() -> CStr;\0A    fn os_chdir(path: CStr) -> Int;\0A    fn stdin_read_owned(max: Int, timeout_nanos: Int, line: Int) -> Int;\0A    fn stdin_result_len(result: Int) -> Int;\0A    fn stdin_result_data(result: Int) -> CStr;\0A    fn stdin_result_release(result: Int);\0A    fn stderr_write(s: CStr) -> Unit;\0A}\0A\0A/// The process's current working directory, as an absolute path.\0Apub let cwd (): Result[String, String] = unsafe {\0A    let d = os_cwd().as_string();\0A    if String.is_empty(d) { Err(\22Os.cwd: could not determine the working directory\22) } else { Ok(d) }\0A}\0A\0A/// Changes the process's working directory.\0A///\0A/// Affects the WHOLE process, including every relative path used\0A/// afterwards and every child it spawns — so a library that changes it\0A/// and does not change it back has altered something its caller never\0A/// agreed to.\0Apub let chdir (path: String): Result[Unit, String] = unsafe {\0A    if os_chdir(path.as_cstr()) == 0 { Ok(()) } else { Err(\22Os.chdir: could not change directory to \22.concat(path)) }\0A}\0A\0A/// `$HOME`, or `%USERPROFILE%` on Windows. `None` when unset or not valid UTF-8 --\0A/// no guessing from a username, because a guess that is usually right\0A/// is the worst kind of wrong for a path a program is about to write\0A/// to.\0Apub let home_dir (): Option[String] =\0A    if platform() == \22windows\22 { env_var(\22USERPROFILE\22) } else { env_var(\22HOME\22) }\0A\0A/// `None` is END OF STREAM and `Some(\22\22)` is a blank line, and\0A/// keeping those apart is the whole reason these exist. The shims the\0A/// language server uses return `\22\22` for both, so a filter reading\0A/// until end of input would stop at the first blank line, which is wrong in a\0A/// way that only shows up on real data.\0A///\0A/// The line arrives WITHOUT its newline, and a final line with no\0A/// trailing newline is an ordinary line rather than something to drop.\0Apub let read_stdin_line (): Result[Option[String], String] = {\0A    match read_stdin_owned(0, 0 - 1, 1) {\0A        Ok(Got(bytes)) => match bytes.as_string() {\0A            Ok(text) => Ok(Some(text)),\0A            Err(e) => Err(\22Os.read_stdin_line: \22.concat(e)),\0A        },\0A        Ok(Eof) => Ok(None),\0A        Ok(TimedOut) => Err(\22Os.read_stdin_line: unexpected timeout\22),\0A        Err(e) => Err(\22Os.read_stdin_line: \22.concat(e)),\0A    }\0A}\0A\0A/// Up to `max` bytes, as `Bytes`. Stdin carries whatever was piped\0A/// into it, which is not always text. With a positive maximum, an EMPTY\0A/// result is end of stream; a SHORT one is data, because a pipe hands\0A/// over what it has rather than waiting to fill a buffer.\0A///\0A/// A nonpositive `max_len` returns empty bytes immediately, without\0A/// consuming input or checking for end of stream.\0A///\0A/// Calls consume a shared stream in serialized order. The bytes are\0A/// copied from an independently owned native result into a Plum value,\0A/// so another task's reads cannot overwrite them during or after the copy.\0Apub let read_stdin (max_len: Int): Result[Bytes, String] = {\0A    match read_stdin_owned(max_len, 0 - 1, 0) {\0A        Ok(Got(bytes)) => Ok(bytes),\0A        Ok(Eof) => Ok(Bytes.