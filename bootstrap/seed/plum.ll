@.str46257 = private global { i64, i64, [59447 x i8] } { i64 -1, i64 59446, [59447 x i8] c"/**\0A * \5Cfile cipher.c\0A *\0A * \5Cbrief Generic cipher wrapper for Mbed TLS\0A *\0A * \5Cauthor Adriaan de Jong <dejong@fox-it.com>\0A *\0A *  Copyright The Mbed TLS Contributors\0A *  SPDX-License-Identifier: Apache-2.0 OR GPL-2.0-or-later\0A */\0A\0A#include \22common.h\22\0A\0A#if defined(MBEDTLS_CIPHER_C)\0A\0A#include \22mbedtls/cipher.h\22\0A#include \22cipher_wrap.h\22\0A#include \22mbedtls/platform_util.h\22\0A#include \22mbedtls/error.h\22\0A#include \22mbedtls/constant_time.h\22\0A#include \22constant_time_internal.h\22\0A\0A#include <stdlib.h>\0A#include <string.h>\0A\0A#if defined(MBEDTLS_CHACHAPOLY_C)\0A#include \22mbedtls/chachapoly.h\22\0A#endif\0A\0A#if defined(MBEDTLS_GCM_C)\0A#include \22mbedtls/gcm.h\22\0A#endif\0A\0A#if defined(MBEDTLS_CCM_C)\0A#include \22mbedtls/ccm.h\22\0A#endif\0A\0A#if defined(MBEDTLS_CHACHA20_C)\0A#include \22mbedtls/chacha20.h\22\0A#endif\0A\0A#if defined(MBEDTLS_CMAC_C)\0A#include \22mbedtls/cmac.h\22\0A#endif\0A\0A#if defined(MBEDTLS_USE_PSA_CRYPTO) && !defined(MBEDTLS_DEPRECATED_REMOVED)\0A#include \22psa/crypto.h\22\0A#endif /* MBEDTLS_USE_PSA_CRYPTO && !MBEDTLS_DEPRECATED_REMOVED */\0A\0A#if defined(MBEDTLS_NIST_KW_C)\0A#include \22mbedtls/nist_kw.h\22\0A#endif\0A\0A#include \22mbedtls/platform.h\22\0A\0Astatic int supported_init = 0;\0A\0Astatic inline const mbedtls_cipher_base_t *mbedtls_cipher_get_base(\0A    const mbedtls_cipher_info_t *info)\0A{\0A    return mbedtls_cipher_base_lookup_table[info->base_idx];\0A}\0A\0Aconst int *mbedtls_cipher_list(void)\0A{\0A    const mbedtls_cipher_definition_t *def;\0A    int *type;\0A\0A    if (!supported_init) {\0A        def = mbedtls_cipher_definitions;\0A        type = mbedtls_cipher_supported;\0A\0A        while (def->type != 0) {\0A            *type++ = (*def++).type;\0A        }\0A\0A        *type = 0;\0A\0A        supported_init = 1;\0A    }\0A\0A    return mbedtls_cipher_supported;\0A}\0A\0Aconst mbedtls_cipher_info_t *mbedtls_cipher_info_from_type(\0A    const mbedtls_cipher_type_t cipher_type)\0A{\0A    const mbedtls_cipher_definition_t *def;\0A\0A    for (def = mbedtls_cipher_definitions; def->info != NULL; def++) {\0A        if (def->type == cipher_type) {\0A            return def->info;\0A        }\0A    }\0A\0A    return NULL;\0A}\0A\0Aconst mbedtls_cipher_info_t *mbedtls_cipher_info_from_string(\0A    const char *cipher_name)\0A{\0A    const mbedtls_cipher_definition_t *def;\0A\0A    if (NULL == cipher_name) {\0A        return NULL;\0A    }\0A\0A    for (def = mbedtls_cipher_definitions; def->info != NULL; def++) {\0A        if (!strcmp(def->info->name, cipher_name)) {\0A            return def->info;\0A        }\0A    }\0A\0A    return NULL;\0A}\0A\0Aconst mbedtls_cipher_info_t *mbedtls_cipher_info_from_values(\0A    const mbedtls_cipher_id_t cipher_id,\0A    int key_bitlen,\0A    const mbedtls_cipher_mode_t mode)\0A{\0A    const mbedtls_cipher_definition_t *def;\0A\0A    for (def = mbedtls_cipher_definitions; def->info != NULL; def++) {\0A        if (mbedtls_cipher_get_base(def->info)->cipher == cipher_id &&\0A            mbedtls_cipher_info_get_key_bitlen(def->info) == (unsigned) key_bitlen &&\0A            def->info->mode == mode) {\0A            return def->info;\0A        }\0A    }\0A\0A    return NULL;\0A}\0A\0A#if defined(MBEDTLS_USE_PSA_CRYPTO) && !defined(MBEDTLS_DEPRECATED_REMOVED)\0Astatic inline psa_key_type_t mbedtls_psa_translate_cipher_type(\0A    mbedtls_cipher_type_t cipher)\0A{\0A    switch (cipher) {\0A        case MBEDTLS_CIPHER_AES_128_CCM:\0A        case MBEDTLS_CIPHER_AES_192_CCM:\0A        case MBEDTLS_CIPHER_AES_256_CCM:\0A        case MBEDTLS_CIPHER_AES_128_CCM_STAR_NO_TAG:\0A        case MBEDTLS_CIPHER_AES_192_CCM_STAR_NO_TAG:\0A        case MBEDTLS_CIPHER_AES_256_CCM_STAR_NO_TAG:\0A        case MBEDTLS_CIPHER_AES_128_GCM:\0A        case MBEDTLS_CIPHER_AES_192_GCM:\0A        case MBEDTLS_CIPHER_AES_256_GCM:\0A        case MBEDTLS_CIPHER_AES_128_CBC:\0A        case MBEDTLS_CIPHER_AES_192_CBC:\0A        case MBEDTLS_CIPHER_AES_256_CBC:\0A        case MBEDTLS_CIPHER_AES_128_ECB:\0A        case MBEDTLS_CIPHER_AES_192_ECB:\0A        case MBEDTLS_CIPHER_AES_256_ECB:\0A            return PSA_KEY_TYPE_AES;\0A\0A        /* ARIA not yet supported in PSA. */\0A        /* case MBEDTLS_CIPHER_ARIA_128_CCM:\0A           case MBEDTLS_CIPHER_ARIA_192_CCM:\0A           case MBEDTLS_CIPHER_ARIA_256_CCM:\0A           case MBEDTLS_CIPHER_ARIA_128_CCM_STAR_NO_TAG:\0A           case MBEDTLS_CIPHER_ARIA_192_CCM_STAR_NO_TAG:\0A           case MBEDTLS_CIPHER_ARIA_256_CCM_STAR_NO_TAG:\0A           case MBEDTLS_CIPHER_ARIA_128_GCM:\0A           case MBEDTLS_CIPHER_ARIA_192_GCM:\0A           case MBEDTLS_CIPHER_ARIA_256_GCM:\0A           case MBEDTLS_CIPHER_ARIA_128_CBC:\0A           case MBEDTLS_CIPHER_ARIA_192_CBC:\0A           case MBEDTLS_CIPHER_ARIA_256_CBC:\0A               return( PSA_KEY_TYPE_ARIA ); */\0A\0A        default:\0A            return 0;\0A    }\0A}\0A\0Astatic inline psa_algorithm_t mbedtls_psa_translate_cipher_mode(\0A    mbedtls_cipher_mode_t mode, size_t taglen)\0A{\0A    switch (mode) {\0A        case MBEDTLS_MODE_ECB:\0A            return PSA_ALG_ECB_NO_PADDING;\0A        case MBEDTLS_MODE_GCM:\0A            return PSA_ALG_AEAD_WITH_SHORTENED_TAG(PSA_ALG_GCM, taglen);\0A        case MBEDTLS_MODE_CCM:\0A            return PSA_ALG_AEAD_WITH_SHORTENED_TAG(PSA_ALG_CCM, taglen);\0A        case MBEDTLS_MODE_CCM_STAR_NO_TAG:\0A            return PSA_ALG_CCM_STAR_NO_TAG;\0A        case MBEDTLS_MODE_CBC:\0A            if (taglen == 0) {\0A                return PSA_ALG_CBC_NO_PADDING;\0A            } else {\0A                return 0;\0A            }\0A        default:\0A            return 0;\0A    }\0A}\0A#endif /* MBEDTLS_USE_PSA_CRYPTO && !MBEDTLS_DEPRECATED_REMOVED */\0A\0Avoid mbedtls_cipher_init(mbedtls_cipher_context_t *ctx)\0A{\0A    memset(ctx, 0, sizeof(mbedtls_cipher_context_t));\0A}\0A\0Avoid mbedtls_cipher_free(mbedtls_cipher_context_t *ctx)\0A{\0A    if (ctx == NULL) {\0A        return;\0A    }\0A\0A#if defined(MBEDTLS_USE_PSA_CRYPTO) && !defined(MBEDTLS_DEPRECATED_REMOVED)\0A    if (ctx->psa_enabled == 1) {\0A        if (ctx->cipher_ctx != NULL) {\0A            mbedtls_cipher_context_psa * const cipher_psa =\0A                (mbedtls_cipher_context_psa *) ctx->cipher_ctx;\0A\0A            if (cipher_psa->slot_state == MBEDTLS_CIPHER_PSA_KEY_OWNED) {\0A                /* xxx_free() doesn't allow to return failures. */\0A                (void) psa_destroy_key(cipher_psa->slot);\0A            }\0A\0A            mbedtls_zeroize_and_free(cipher_psa, sizeof(*cipher_psa));\0A        }\0A\0A        mbedtls_platform_zeroize(ctx, sizeof(mbedtls_cipher_context_t));\0A        return;\0A    }\0A#endif /* MBEDTLS_USE_PSA_CRYPTO && !MBEDTLS_DEPRECATED_REMOVED */\0A\0A#if defined(MBEDTLS_CMAC_C)\0A    if (ctx->cmac_ctx) {\0A        mbedtls_zeroize_and_free(ctx->cmac_ctx,\0A                                 sizeof(mbedtls_cmac_context_t));\0A    }\0A#endif\0A\0A    if (ctx->cipher_ctx) {\0A        mbedtls_cipher_get_base(ctx->cipher_info)->ctx_free_func(ctx->cipher_ctx);\0A    }\0A\0A    mbedtls_platform_zeroize(ctx, sizeof(mbedtls_cipher_context_t));\0A}\0A\0Aint mbedtls_cipher_setup(mbedtls_cipher_context_t *ctx,\0A                         const mbedtls_cipher_info_t *cipher_info)\0A{\0A    if (cipher_info == NULL) {\0A        return MBEDTLS_ERR_CIPHER_BAD_INPUT_DATA;\0A    }\0A\0A    memset(ctx, 0, sizeof(mbedtls_cipher_context_t));\0A\0A    if (mbedtls_cipher_get_base(cipher_info)->ctx_alloc_func != NULL) {\0A        ctx->cipher_ctx = mbedtls_cipher_get_base(cipher_info)->ctx_alloc_func();\0A        if (ctx->cipher_ctx == NULL) {\0A            return MBEDTLS_ERR_CIPHER_ALLOC_FAILED;\0A        }\0A    }\0A\0A    ctx->cipher_info = cipher_info;\0A\0A    return 0;\0A}\0A\0A#if defined(MBEDTLS_USE_PSA_CRYPTO) && !defined(MBEDTLS_DEPRECATED_REMOVED)\0Aint mbedtls_cipher_setup_psa(mbedtls_cipher_context_t *ctx,\0A                             const mbedtls_cipher_info_t *cipher_info,\0A                             size_t taglen)\0A{\0A    psa_algorithm_t alg;\0A    mbedtls_cipher_context_psa *cipher_psa;\0A\0A    if (NULL == cipher_info || NULL == ctx) {\0A        return MBEDTLS_ERR_CIPHER_BAD_INPUT_DATA;\0A    }\0A\0A    /* Check that the underlying cipher mode and cipher type are\0A     * supported by the underlying PSA Crypto implementation. */\0A    alg = mbedtls_psa_translate_cipher_mode(((mbedtls_cipher_mode_t) cipher_info->mode), taglen);\0A    if (alg == 0) {\0A        return MBEDTLS_ERR_CIPHER_FEATURE_UNAVAILABLE;\0A    }\0A    if (mbedtls_psa_translate_cipher_type(((mbedtls_cipher_type_t) cipher_info->type)) == 0) {\0A        return MBEDTLS_ERR_CIPHER_FEATURE_UNAVAILABLE;\0A    }\0A\0A    memset(ctx, 0, sizeof(mbedtls_cipher_context_t));\0A\0A    cipher_psa = mbedtls_calloc(1, sizeof(mbedtls_cipher_context_psa));\0A    if (cipher_psa == NULL) {\0A        return MBEDTLS_ERR_CIPHER_ALLOC_FAILED;\0A    }\0A    cipher_psa->alg  = alg;\0A    ctx->cipher_ctx  = cipher_psa;\0A    ctx->cipher_info = cipher_info;\0A    ctx->psa_enabled = 1;\0A    return 0;\0A}\0A#endif /* MBEDTLS_USE_PSA_CRYPTO && !MBEDTLS_DEPRECATED_REMOVED */\0A\0Aint mbedtls_cipher_setkey(mbedtls_cipher_context_t *ctx,\0A                          const unsigned char *key,\0A                          int key_bitlen,\0A                          const mbedtls_operation_t operation)\0A{\0A    if (operation != MBEDTLS_ENCRYPT && operation != MBEDTLS_DECRYPT) {\0A        return MBEDTLS_ERR_CIPHER_BAD_INPUT_DATA;\0A    }\0A    if (ctx->cipher_info == NULL) {\0A        return MBEDTLS_ERR_CIPHER_BAD_INPUT_DATA;\0A    }\0A#if defined(MBEDTLS_BLOCK_CIPHER_NO_DECRYPT)\0A    if (MBEDTLS_MODE_ECB == ((mbedtls_cipher_mode_t) ctx->cipher_info->mode) &&\0A        MBEDTLS_DECRYPT == operation) {\0A        return MBEDTLS_ERR_CIPHER_FEATURE_UNAVAILABLE;\0A    }\0A#endif\0A\0A#if defined(MBEDTLS_USE_PSA_CRYPTO) && !defined(MBEDTLS_DEPRECATED_REMOVED)\0A    if (ctx->psa_enabled == 1) {\0A        mbedtls_cipher_context_psa * const cipher_psa =\0A            (mbedtls_cipher_context_psa *) ctx->cipher_ctx;\0A\0A        size_t const key_bytelen = ((size_t) key_bitlen + 7) / 8;\0A\0A        psa_status_t status;\0A        psa_key_type_t key_type;\0A        psa_key_attributes_t attributes = PSA_KEY_ATTRIBUTES_INIT;\0A\0A        /* PSA Crypto API only accepts byte-aligned keys. */\0A        if (key_bitlen % 8 != 0) {\0A            return MBEDTLS_ERR_CIPHER_BAD_INPUT_DATA;\0A        }\0A\0A        /* Don't allow keys to be set multiple times. */\0A        if (cipher_psa->slot_state != MBEDTLS_CIPHER_PSA_KEY_UNSET) {\0A            return MBEDTLS_ERR_CIPHER_BAD_INPUT_DATA;\0A        }\0A\0A        key_type = mbedtls_psa_translate_cipher_type(\0A            ((mbedtls_cipher_type_t) ctx->cipher_info->type));\0A        if (key_type == 0) {\0A            return MBEDTLS_ERR_CIPHER_FEATURE_UNAVAILABLE;\0A        }\0A        psa_set_key_type(&attributes, key_type);\0A\0A        /* Mbed TLS' cipher layer doesn't enforce the mode of operation\0A         * (encrypt vs. decrypt): it is possible to setup a key for encryption\0A         * and use it for AEAD decryption. Until tests relying on this\0A         * are changed, allow any usage in PSA. */\0A        psa_set_key_usage_flags(&attributes,\0A                                PSA_KEY_USAGE_ENCRYPT | PSA_KEY_USAGE_DECRYPT);\0A        psa_set_key_algorithm(&attributes, cipher_psa->alg);\0A\0A        status = psa_import_key(&attributes, key, key_bytelen,\0A                                &cipher_psa->slot);\0A        switch (status) {\0A            case PSA_SUCCESS:\0A                break;\0A            case PSA_ERROR_INSUFFICIENT_MEMORY:\0A                return MBEDTLS_ERR_CIPHER_ALLOC_FAILED;\0A            case PSA_ERROR_NOT_SUPPORTED:\0A                return MBEDTLS_ERR_CIPHER_FE