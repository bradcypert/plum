@.str39964 = private global { i64, i64, [8020 x i8] } { i64 -1, i64 8019, [8020 x i8] c"/*\0A *  RFC 1521 base64 encoding/decoding\0A *\0A *  Copyright The Mbed TLS Contributors\0A *  SPDX-License-Identifier: Apache-2.0 OR GPL-2.0-or-later\0A */\0A\0A#include <limits.h>\0A\0A#include \22common.h\22\0A\0A#if defined(MBEDTLS_BASE64_C)\0A\0A#include \22mbedtls/base64.h\22\0A#include \22base64_internal.h\22\0A#include \22constant_time_internal.h\22\0A\0A#include <stdint.h>\0A\0A#if defined(MBEDTLS_SELF_TEST)\0A#include <string.h>\0A#include \22mbedtls/platform.h\22\0A#endif /* MBEDTLS_SELF_TEST */\0A\0AMBEDTLS_STATIC_TESTABLE\0Aunsigned char mbedtls_ct_base64_enc_char(unsigned char value)\0A{\0A    unsigned char digit = 0;\0A    /* For each range of values, if value is in that range, mask digit with\0A     * the corresponding value. Since value can only be in a single range,\0A     * only at most one masking will change digit. */\0A    digit |= mbedtls_ct_uchar_in_range_if(0, 25, value, 'A' + value);\0A    digit |= mbedtls_ct_uchar_in_range_if(26, 51, value, 'a' + value - 26);\0A    digit |= mbedtls_ct_uchar_in_range_if(52, 61, value, '0' + value - 52);\0A    digit |= mbedtls_ct_uchar_in_range_if(62, 62, value, '+');\0A    digit |= mbedtls_ct_uchar_in_range_if(63, 63, value, '/');\0A    return digit;\0A}\0A\0AMBEDTLS_STATIC_TESTABLE\0Asigned char mbedtls_ct_base64_dec_value(unsigned char c)\0A{\0A    unsigned char val = 0;\0A    /* For each range of digits, if c is in that range, mask val with\0A     * the corresponding value. Since c can only be in a single range,\0A     * only at most one masking will change val. Set val to one plus\0A     * the desired value so that it stays 0 if c is in none of the ranges. */\0A    val |= mbedtls_ct_uchar_in_range_if('A', 'Z', c, c - 'A' +  0 + 1);\0A    val |= mbedtls_ct_uchar_in_range_if('a', 'z', c, c - 'a' + 26 + 1);\0A    val |= mbedtls_ct_uchar_in_range_if('0', '9', c, c - '0' + 52 + 1);\0A    val |= mbedtls_ct_uchar_in_range_if('+', '+', c, c - '+' + 62 + 1);\0A    val |= mbedtls_ct_uchar_in_range_if('/', '/', c, c - '/' + 63 + 1);\0A    /* At this point, val is 0 if c is an invalid digit and v+1 if c is\0A     * a digit with the value v. */\0A    return val - 1;\0A}\0A\0A/*\0A * Encode a buffer into base64 format\0A */\0Aint mbedtls_base64_encode(unsigned char *dst, size_t dlen, size_t *olen,\0A                          const unsigned char *src, size_t slen)\0A{\0A    size_t i, n;\0A    int C1, C2, C3;\0A    unsigned char *p;\0A\0A    if (slen == 0) {\0A        *olen = 0;\0A        return 0;\0A    }\0A\0A    n = slen / 3 + (slen % 3 != 0);\0A\0A    if (n > (SIZE_MAX - 1) / 4) {\0A        *olen = SIZE_MAX;\0A        return MBEDTLS_ERR_BASE64_BUFFER_TOO_SMALL;\0A    }\0A\0A    n *= 4;\0A\0A    if ((dlen < n + 1) || (NULL == dst)) {\0A        *olen = n + 1;\0A        return MBEDTLS_ERR_BASE64_BUFFER_TOO_SMALL;\0A    }\0A\0A    n = (slen / 3) * 3;\0A\0A    for (i = 0, p = dst; i < n; i += 3) {\0A        C1 = *src++;\0A        C2 = *src++;\0A        C3 = *src++;\0A\0A        *p++ = mbedtls_ct_base64_enc_char((C1 >> 2) & 0x3F);\0A        *p++ = mbedtls_ct_base64_enc_char((((C1 &  3) << 4) + (C2 >> 4))\0A                                          & 0x3F);\0A        *p++ = mbedtls_ct_base64_enc_char((((C2 & 15) << 2) + (C3 >> 6))\0A                                          & 0x3F);\0A        *p++ = mbedtls_ct_base64_enc_char(C3 & 0x3F);\0A    }\0A\0A    if (i < slen) {\0A        C1 = *src++;\0A        C2 = ((i + 1) < slen) ? *src++ : 0;\0A\0A        *p++ = mbedtls_ct_base64_enc_char((C1 >> 2) & 0x3F);\0A        *p++ = mbedtls_ct_base64_enc_char((((C1 & 3) << 4) + (C2 >> 4))\0A                                          & 0x3F);\0A\0A        if ((i + 1) < slen) {\0A            *p++ = mbedtls_ct_base64_enc_char(((C2 & 15) << 2) & 0x3F);\0A        } else {\0A            *p++ = '=';\0A        }\0A\0A        *p++ = '=';\0A    }\0A\0A    *olen = (size_t) (p - dst);\0A    *p = 0;\0A\0A    return 0;\0A}\0A\0A/*\0A * Decode a base64-formatted buffer\0A */\0Aint mbedtls_base64_decode(unsigned char *dst, size_t dlen, size_t *olen,\0A                          const unsigned char *src, size_t slen)\0A{\0A    size_t i; /* index in source */\0A    size_t n; /* number of digits or trailing = in source */\0A    uint32_t x; /* value accumulator */\0A    unsigned accumulated_digits = 0;\0A    unsigned equals = 0;\0A    int spaces_present = 0;\0A    unsigned char *p;\0A\0A    /* First pass: check for validity and get output length */\0A    for (i = n = 0; i < slen; i++) {\0A        /* Skip spaces before checking for EOL */\0A        spaces_present = 0;\0A        while (i < slen && src[i] == ' ') {\0A            ++i;\0A            spaces_present = 1;\0A        }\0A\0A        /* Spaces at end of buffer are OK */\0A        if (i == slen) {\0A            break;\0A        }\0A\0A        if ((slen - i) >= 2 &&\0A            src[i] == '\5Cr' && src[i + 1] == '\5Cn') {\0A            continue;\0A        }\0A\0A        if (src[i] == '\5Cn') {\0A            continue;\0A        }\0A\0A        /* Space inside a line is an error */\0A        if (spaces_present) {\0A            return MBEDTLS_ERR_BASE64_INVALID_CHARACTER;\0A        }\0A\0A        if (src[i] > 127) {\0A            return MBEDTLS_ERR_BASE64_INVALID_CHARACTER;\0A        }\0A\0A        if (src[i] == '=') {\0A            if (++equals > 2) {\0A                return MBEDTLS_ERR_BASE64_INVALID_CHARACTER;\0A            }\0A        } else {\0A            if (equals != 0) {\0A                return MBEDTLS_ERR_BASE64_INVALID_CHARACTER;\0A            }\0A            if (mbedtls_ct_base64_dec_value(src[i]) < 0) {\0A                return MBEDTLS_ERR_BASE64_INVALID_CHARACTER;\0A            }\0A        }\0A        n++;\0A    }\0A\0A    if (n == 0) {\0A        *olen = 0;\0A        return 0;\0A    }\0A\0A    /* The following expression is to calculate the following formula without\0A     * risk of integer overflow in n:\0A     *     n = ( ( n * 6 ) + 7 ) >> 3;\0A     */\0A    n = (6 * (n >> 3)) + ((6 * (n & 0x7) + 7) >> 3);\0A    n -= equals;\0A\0A    if (dst == NULL || dlen < n) {\0A        *olen = n;\0A        return MBEDTLS_ERR_BASE64_BUFFER_TOO_SMALL;\0A    }\0A\0A    equals = 0;\0A    for (x = 0, p = dst; i > 0; i--, src++) {\0A        if (*src == '\5Cr' || *src == '\5Cn' || *src == ' ') {\0A            continue;\0A        }\0A\0A        x = x << 6;\0A        if (*src == '=') {\0A            ++equals;\0A        } else {\0A            x |= mbedtls_ct_base64_dec_value(*src);\0A        }\0A\0A        if (++accumulated_digits == 4) {\0A            accumulated_digits = 0;\0A            *p++ = MBEDTLS_BYTE_2(x);\0A            if (equals <= 1) {\0A                *p++ = MBEDTLS_BYTE_1(x);\0A            }\0A            if (equals <= 0) {\0A                *p++ = MBEDTLS_BYTE_0(x);\0A            }\0A        }\0A    }\0A\0A    *olen = (size_t) (p - dst);\0A\0A    return 0;\0A}\0A\0A#if defined(MBEDTLS_SELF_TEST)\0A\0Astatic const unsigned char base64_test_dec[64] =\0A{\0A    0x24, 0x48, 0x6E, 0x56, 0x87, 0x62, 0x5A, 0xBD,\0A    0xBF, 0x17, 0xD9, 0xA2, 0xC4, 0x17, 0x1A, 0x01,\0A    0x94, 0xED, 0x8F, 0x1E, 0x11, 0xB3, 0xD7, 0x09,\0A    0x0C, 0xB6, 0xE9, 0x10, 0x6F, 0x22, 0xEE, 0x13,\0A    0xCA, 0xB3, 0x07, 0x05, 0x76, 0xC9, 0xFA, 0x31,\0A    0x6C, 0x08, 0x34, 0xFF, 0x8D, 0xC2, 0x6C, 0x38,\0A    0x00, 0x43, 0xE9, 0x54, 0x97, 0xAF, 0x50, 0x4B,\0A    0xD1, 0x41, 0xBA, 0x95, 0x31, 0x5A, 0x0B, 0x97\0A};\0A\0Astatic const unsigned char base64_test_enc[] =\0A    \22JEhuVodiWr2/F9mixBcaAZTtjx4Rs9cJDLbpEG8i7hPK\22\0A    \22swcFdsn6MWwINP+Nwmw4AEPpVJevUEvRQbqVMVoLlw==\22;\0A\0A/*\0A * Checkup routine\0A */\0Aint mbedtls_base64_self_test(int verbose)\0A{\0A    size_t len;\0A    const unsigned char *src;\0A    unsigned char buffer[128];\0A\0A    if (verbose != 0) {\0A        mbedtls_printf(\22  Base64 encoding test: \22);\0A    }\0A\0A    src = base64_test_dec;\0A\0A    if (mbedtls_base64_encode(buffer, sizeof(buffer), &len, src, 64) != 0 ||\0A        memcmp(base64_test_enc, buffer, 88) != 0) {\0A        if (verbose != 0) {\0A            mbedtls_printf(\22failed\5Cn\22);\0A        }\0A\0A        return 1;\0A    }\0A\0A    if (verbose != 0) {\0A        mbedtls_printf(\22passed\5Cn  Base64 decoding test: \22);\0A    }\0A\0A    src = base64_test_enc;\0A\0A    if (mbedtls_base64_decode(buffer, sizeof(buffer), &len, src, 88) != 0 ||\0A        memcmp(base64_test_dec, buffer, 64) != 0) {\0A        if (verbose != 0) {\0A            mbedtls_printf(\22failed\5Cn\22);\0A        }\0A\0A        return 1;\0A    }\0A\0A    if (verbose != 0) {\0A        mbedtls_printf(\22passed\5Cn\5Cn\22);\0A    }\0A\0A    return 0;\0A}\0A\0A#endif /* MBEDTLS_SELF_TEST */\0A\0A#endif /* MBEDTLS_BASE64_C */\0A\00" }
