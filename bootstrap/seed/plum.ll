@.str39017 = private global { i64, i64, [13377 x i8] } { i64 -1, i64 13376, [13377 x i8] c"/**\0A * \5Cfile camellia.h\0A *\0A * \5Cbrief Camellia block cipher\0A */\0A/*\0A *  Copyright The Mbed TLS Contributors\0A *  SPDX-License-Identifier: Apache-2.0 OR GPL-2.0-or-later\0A */\0A#ifndef MBEDTLS_CAMELLIA_H\0A#define MBEDTLS_CAMELLIA_H\0A#include \22mbedtls/private_access.h\22\0A\0A#include \22mbedtls/build_info.h\22\0A\0A#include <stddef.h>\0A#include <stdint.h>\0A\0A#include \22mbedtls/platform_util.h\22\0A\0A#define MBEDTLS_CAMELLIA_ENCRYPT     1\0A#define MBEDTLS_CAMELLIA_DECRYPT     0\0A\0A/** Bad input data. */\0A#define MBEDTLS_ERR_CAMELLIA_BAD_INPUT_DATA -0x0024\0A\0A/** Invalid data input length. */\0A#define MBEDTLS_ERR_CAMELLIA_INVALID_INPUT_LENGTH -0x0026\0A\0A#ifdef __cplusplus\0Aextern \22C\22 {\0A#endif\0A\0A#if !defined(MBEDTLS_CAMELLIA_ALT)\0A// Regular implementation\0A//\0A\0A/**\0A * \5Cbrief          CAMELLIA context structure\0A */\0Atypedef struct mbedtls_camellia_context {\0A    int MBEDTLS_PRIVATE(nr);                     /*!<  number of rounds  */\0A    uint32_t MBEDTLS_PRIVATE(rk)[68];            /*!<  CAMELLIA round keys    */\0A}\0Ambedtls_camellia_context;\0A\0A#else  /* MBEDTLS_CAMELLIA_ALT */\0A#include \22camellia_alt.h\22\0A#endif /* MBEDTLS_CAMELLIA_ALT */\0A\0A/**\0A * \5Cbrief          Initialize a CAMELLIA context.\0A *\0A * \5Cparam ctx      The CAMELLIA context to be initialized.\0A *                 This must not be \5Cc NULL.\0A */\0Avoid mbedtls_camellia_init(mbedtls_camellia_context *ctx);\0A\0A/**\0A * \5Cbrief          Clear a CAMELLIA context.\0A *\0A * \5Cparam ctx      The CAMELLIA context to be cleared. This may be \5Cc NULL,\0A *                 in which case this function returns immediately. If it is not\0A *                 \5Cc NULL, it must be initialized.\0A */\0Avoid mbedtls_camellia_free(mbedtls_camellia_context *ctx);\0A\0A/**\0A * \5Cbrief          Perform a CAMELLIA key schedule operation for encryption.\0A *\0A * \5Cparam ctx      The CAMELLIA context to use. This must be initialized.\0A * \5Cparam key      The encryption key to use. This must be a readable buffer\0A *                 of size \5Cp keybits Bits.\0A * \5Cparam keybits  The length of \5Cp key in Bits. This must be either \5Cc 128,\0A *                 \5Cc 192 or \5Cc 256.\0A *\0A * \5Creturn         \5Cc 0 if successful.\0A * \5Creturn         A negative error code on failure.\0A */\0Aint mbedtls_camellia_setkey_enc(mbedtls_camellia_context *ctx,\0A                                const unsigned char *key,\0A                                unsigned int keybits);\0A\0A#if !defined(MBEDTLS_BLOCK_CIPHER_NO_DECRYPT)\0A/**\0A * \5Cbrief          Perform a CAMELLIA key schedule operation for decryption.\0A *\0A * \5Cparam ctx      The CAMELLIA context to use. This must be initialized.\0A * \5Cparam key      The decryption key. This must be a readable buffer\0A *                 of size \5Cp keybits Bits.\0A * \5Cparam keybits  The length of \5Cp key in Bits. This must be either \5Cc 128,\0A *                 \5Cc 192 or \5Cc 256.\0A *\0A * \5Creturn         \5Cc 0 if successful.\0A * \5Creturn         A negative error code on failure.\0A */\0Aint mbedtls_camellia_setkey_dec(mbedtls_camellia_context *ctx,\0A                                const unsigned char *key,\0A                                unsigned int keybits);\0A#endif /* !MBEDTLS_BLOCK_CIPHER_NO_DECRYPT */\0A\0A/**\0A * \5Cbrief          Perform a CAMELLIA-ECB block encryption/decryption operation.\0A *\0A * \5Cparam ctx      The CAMELLIA context to use. This must be initialized\0A *                 and bound to a key.\0A * \5Cparam mode     The mode of operation. This must be either\0A *                 #MBEDTLS_CAMELLIA_ENCRYPT or #MBEDTLS_CAMELLIA_DECRYPT.\0A * \5Cparam input    The input block. This must be a readable buffer\0A *                 of size \5Cc 16 Bytes.\0A * \5Cparam output   The output block. This must be a writable buffer\0A *                 of size \5Cc 16 Bytes.\0A *\0A * \5Creturn         \5Cc 0 if successful.\0A * \5Creturn         A negative error code on failure.\0A */\0Aint mbedtls_camellia_crypt_ecb(mbedtls_camellia_context *ctx,\0A                               int mode,\0A                               const unsigned char input[16],\0A                               unsigned char output[16]);\0A\0A#if defined(MBEDTLS_CIPHER_MODE_CBC)\0A/**\0A * \5Cbrief          Perform a CAMELLIA-CBC buffer encryption/decryption operation.\0A *\0A * \5Cnote           Upon exit, the content of the IV is updated so that you can\0A *                 call the function same function again on the following\0A *                 block(s) of data and get the same result as if it was\0A *                 encrypted in one call. This allows a \22streaming\22 usage.\0A *                 If on the other hand you need to retain the contents of the\0A *                 IV, you should either save it manually or use the cipher\0A *                 module instead.\0A *\0A * \5Cparam ctx      The CAMELLIA context to use. This must be initialized\0A *                 and bound to a key.\0A * \5Cparam mode     The mode of operation. This must be either\0A *                 #MBEDTLS_CAMELLIA_ENCRYPT or #MBEDTLS_CAMELLIA_DECRYPT.\0A * \5Cparam length   The length in Bytes of the input data \5Cp input.\0A *                 This must be a multiple of \5Cc 16 Bytes.\0A * \5Cparam iv       The initialization vector. This must be a read/write buffer\0A *                 of length \5Cc 16 Bytes. It is updated to allow streaming\0A *                 use as explained above.\0A * \5Cparam input    The buffer holding the input data. This must point to a\0A *                 readable buffer of length \5Cp length Bytes.\0A * \5Cparam output   The buffer holding the output data. This must point to a\0A *                 writable buffer of length \5Cp length Bytes.\0A *\0A * \5Creturn         \5Cc 0 if successful.\0A * \5Creturn         A negative error code on failure.\0A */\0Aint mbedtls_camellia_crypt_cbc(mbedtls_camellia_context *ctx,\0A                               int mode,\0A                               size_t length,\0A                               unsigned char iv[16],\0A                               const unsigned char *input,\0A                               unsigned char *output);\0A#endif /* MBEDTLS_CIPHER_MODE_CBC */\0A\0A#if defined(MBEDTLS_CIPHER_MODE_CFB)\0A/**\0A * \5Cbrief          Perform a CAMELLIA-CFB128 buffer encryption/decryption\0A *                 operation.\0A *\0A * \5Cnote           Due to the nature of CFB mode, you should use the same\0A *                 key for both encryption and decryption. In particular, calls\0A *                 to this function should be preceded by a key-schedule via\0A *                 mbedtls_camellia_setkey_enc() regardless of whether \5Cp mode\0A *                 is #MBEDTLS_CAMELLIA_ENCRYPT or #MBEDTLS_CAMELLIA_DECRYPT.\0A *\0A * \5Cnote           Upon exit, the content of the IV is updated so that you can\0A *                 call the function same function again on the following\0A *                 block(s) of data and get the same result as if it was\0A *                 encrypted in one call. This allows a \22streaming\22 usage.\0A *                 If on the other hand you need to retain the contents of the\0A *                 IV, you should either save it manually or use the cipher\0A *                 module instead.\0A *\0A * \5Cparam ctx      The CAMELLIA context to use. This must be initialized\0A *                 and bound to a key.\0A * \5Cparam mode     The mode of operation. This must be either\0A *                 #MBEDTLS_CAMELLIA_ENCRYPT or #MBEDTLS_CAMELLIA_DECRYPT.\0A * \5Cparam length   The length of the input data \5Cp input. Any value is allowed.\0A * \5Cparam iv_off   The current offset in the IV. This must be smaller\0A *                 than \5Cc 16 Bytes. It is updated after this call to allow\0A *                 the aforementioned streaming usage.\0A * \5Cparam iv       The initialization vector. This must be a read/write buffer\0A *                 of length \5Cc 16 Bytes. It is updated after this call to\0A *                 allow the aforementioned streaming usage.\0A * \5Cparam input    The buffer holding the input data. This must be a readable\0A *                 buffer of size \5Cp length Bytes.\0A * \5Cparam output   The buffer to hold the output data. This must be a writable\0A *                 buffer of length \5Cp length Bytes.\0A *\0A * \5Creturn         \5Cc 0 if successful.\0A * \5Creturn         A negative error code on failure.\0A */\0Aint mbedtls_camellia_crypt_cfb128(mbedtls_camellia_context *ctx,\0A                                  int mode,\0A                                  size_t length,\0A                                  size_t *iv_off,\0A                                  unsigned char iv[16],\0A                                  const unsigned char *input,\0A                                  unsigned char *output);\0A#endif /* MBEDTLS_CIPHER_MODE_CFB */\0A\0A#if defined(MBEDTLS_CIPHER_MODE_CTR)\0A/**\0A * \5Cbrief      Perform a CAMELLIA-CTR buffer encryption/decryption operation.\0A *\0A * *note       Due to the nature of CTR mode, you should use the same\0A *             key for both encryption and decryption. In particular, calls\0A *             to this function should be preceded by a key-schedule via\0A *             mbedtls_camellia_setkey_enc() regardless of whether the mode\0A *             is #MBEDTLS_CAMELLIA_ENCRYPT or #MBEDTLS_CAMELLIA_DECRYPT.\0A *\0A * \5Cwarning    You must never reuse a nonce value with the same key. Doing so\0A *             would void the encryption for the two messages encrypted with\0A *             the same nonce and key.\0A *\0A *             There are two common strategies for managing nonces with CTR:\0A *\0A *             1. You can handle everything as a single message processed over\0A *             successive calls to this function. In that case, you want to\0A *             set \5Cp nonce_counter and \5Cp nc_off to 0 for the first call, and\0A *             then preserve the values of \5Cp nonce_counter, \5Cp nc_off and \5Cp\0A *             stream_block across calls to this function as they will be\0A *             updated by this function.\0A *\0A *             With this strategy, you must not encrypt more than 2**128\0A *             blocks of data with the same key.\0A *\0A *             2. You can encrypt separate messages by dividing the \5Cp\0A *             nonce_counter buffer in two areas: the first one used for a\0A *             per-message nonce, handled by yourself, and the second one\0A *             updated by this function internally.\0A *\0A *             For example, you might reserve the first \5Cc 12 Bytes for the\0A *             per-message nonce, and the last \5Cc 4 Bytes for internal use.\0A *             In that case, before calling this function on a new message you\0A *             need to set the first \5Cc 12 Bytes of \5Cp nonce_counter to your\0A *             chosen nonce value, the last four to \5Cc 0, and \5Cp nc_off to \5Cc 0\0A *             (which will cause \5Cp stream_block to be ignored). That way, you\0A *             can encrypt at most \5Cc 2**96 messages of up to \5Cc 2**32 blocks\0A *             each  with the same key.\0A *\0A *             The per-message nonce (or information sufficient to reconstruct\0A *             it) needs to be communicated with the ciphertext and must be\0A *             unique. The recommended way to ensure uniqueness is to use a\0A *             message counter. An alternative is to generate random nonces,\0A *             but this limits the number of messages that can be securely\0A *             encrypted: for example, with 96-bit random nonces, you should\0A *             not encrypt more than 2**32 messages with the same key.\0A *\0A *             Note that for both strategies, sizes are measured in blocks and\0A *             that a CAMELLIA block is \5Cc 16 Bytes.\0A *\0A * \5Cwarning    Upon return, \5Cp stream_block contains sensitive data. Its\0A *             content must not be written to insecure storage and should be\0A *             securely discarded as soon as it's no longer needed.\0A *\0A * \5Cparam ctx           The CAMELLIA context to use. This must be initialized\0A *                      and bound to a key.\0A * \5Cparam length        The length of the input data \5Cp input in Bytes.\0A *                      Any value is allowed.\0A * \5Cparam nc_off        The offset in the current \5Cp stream_block (for resuming\0A *                      within current cipher stream). The offset pointer to\0A *                      should be \5Cc 0 at the start of a stream. It is updated\0A *                      at the end of this call.\0A * \5Cparam nonce_counter The 128-bit nonce and counter. This must be a read/write\0A *                      buffer of length \5Cc 16 Bytes.\0A * \5Cparam stream_block  The saved stream-block for resuming. This must be a\0A *                      read/write buffer of length \5Cc 16 Bytes.\0A * \5Cparam input         The input data stream. This must be a readable buffer of\0A *                      size \5Cp length Bytes.\0A * \5Cparam output        The output data stream. This must be a writable buffer\0A *                      of size \5Cp length Bytes.\0A *\0A * \5Creturn              \5Cc 0 if successful.\0A * \5Creturn              A negative error code on failure.\0A */\0Aint mbedtls_camellia_crypt_ctr(mbedtls_camellia_context *ctx,\0A                               size_t length,\0A                               size_t *nc_off,\0A                               unsigned char nonce_counter[16],\0A                               unsigned char stream_block[16],\0A                               const unsigned char *input,\0A                               unsigned char *output);\0A#endif /* MBEDTLS_CIPHER_MODE_CTR */\0A\0A#if defined(MBEDTLS_SELF_TEST)\0A\0A/**\0A * \5Cbrief          Checkup routine\0A *\0A * \5Creturn         0 if successful, or 1 if the test failed\0A */\0Aint mbedtls_camellia_self_test(int verbose);\0A\0A#endif /* MBEDTLS_SELF_TEST */\0A\0A#ifdef __cplusplus\0A}\0A#endif\0A\0A#endif /* camellia.h */\0A\00" }
