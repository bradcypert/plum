@.str39428 = private global { i64, i64, [2614 x i8] } { i64 -1, i64 2613, [2614 x i8] c"/**\0A * \5Cfile base64.h\0A *\0A * \5Cbrief RFC 1521 base64 encoding/decoding\0A */\0A/*\0A *  Copyright The Mbed TLS Contributors\0A *  SPDX-License-Identifier: Apache-2.0 OR GPL-2.0-or-later\0A */\0A#ifndef MBEDTLS_BASE64_H\0A#define MBEDTLS_BASE64_H\0A\0A#include \22mbedtls/build_info.h\22\0A\0A#include <stddef.h>\0A\0A/** Output buffer too small. */\0A#define MBEDTLS_ERR_BASE64_BUFFER_TOO_SMALL               -0x002A\0A/** Invalid character in input. */\0A#define MBEDTLS_ERR_BASE64_INVALID_CHARACTER              -0x002C\0A\0A#ifdef __cplusplus\0Aextern \22C\22 {\0A#endif\0A\0A/**\0A * \5Cbrief          Encode a buffer into base64 format\0A *\0A * \5Cparam dst      destination buffer\0A * \5Cparam dlen     size of the destination buffer\0A * \5Cparam olen     number of bytes written\0A * \5Cparam src      source buffer\0A * \5Cparam slen     amount of data to be encoded\0A *\0A * \5Creturn         0 if successful, or MBEDTLS_ERR_BASE64_BUFFER_TOO_SMALL.\0A *                 *olen is always updated to reflect the amount\0A *                 of data that has (or would have) been written.\0A *                 If that length cannot be represented, then no data is\0A *                 written to the buffer and *olen is set to the maximum\0A *                 length representable as a size_t.\0A *\0A * \5Cnote           Call this function with dlen = 0 to obtain the\0A *                 required buffer size in *olen\0A */\0Aint mbedtls_base64_encode(unsigned char *dst, size_t dlen, size_t *olen,\0A                          const unsigned char *src, size_t slen);\0A\0A/**\0A * \5Cbrief          Decode a base64-formatted buffer\0A *\0A * \5Cparam dst      destination buffer (can be NULL for checking size)\0A * \5Cparam dlen     size of the destination buffer\0A * \5Cparam olen     number of bytes written\0A * \5Cparam src      source buffer\0A * \5Cparam slen     amount of data to be decoded\0A *\0A * \5Creturn         0 if successful, MBEDTLS_ERR_BASE64_BUFFER_TOO_SMALL, or\0A *                 MBEDTLS_ERR_BASE64_INVALID_CHARACTER if the input data is\0A *                 not correct. *olen is always updated to reflect the amount\0A *                 of data that has (or would have) been written.\0A *\0A * \5Cnote           Call this function with *dst = NULL or dlen = 0 to obtain\0A *                 the required buffer size in *olen\0A */\0Aint mbedtls_base64_decode(unsigned char *dst, size_t dlen, size_t *olen,\0A                          const unsigned char *src, size_t slen);\0A\0A#if defined(MBEDTLS_SELF_TEST)\0A/**\0A * \5Cbrief          Checkup routine\0A *\0A * \5Creturn         0 if successful, or 1 if the test failed\0A */\0Aint mbedtls_base64_self_test(int verbose);\0A\0A#endif /* MBEDTLS_SELF_TEST */\0A\0A#ifdef __cplusplus\0A}\0A#endif\0A\0A#endif /* base64.h */\0A\00" }
