@.str41732 = private global { i64, i64, [13551 x i8] } { i64 -1, i64 13550, [13551 x i8] c"/*\0A *  PKCS#12 Personal Information Exchange Syntax\0A *\0A *  Copyright The Mbed TLS Contributors\0A *  SPDX-License-Identifier: Apache-2.0 OR GPL-2.0-or-later\0A */\0A/*\0A *  The PKCS #12 Personal Information Exchange Syntax Standard v1.1\0A *\0A *  http://www.rsa.com/rsalabs/pkcs/files/h11301-wp-pkcs-12v1-1-personal-information-exchange-syntax.pdf\0A *  ftp://ftp.rsasecurity.com/pub/pkcs/pkcs-12/pkcs-12v1-1.asn\0A */\0A\0A#include \22common.h\22\0A\0A#if defined(MBEDTLS_PKCS12_C)\0A\0A#include \22mbedtls/pkcs12.h\22\0A#include \22mbedtls/asn1.h\22\0A#if defined(MBEDTLS_CIPHER_C)\0A#include \22mbedtls/cipher.h\22\0A#endif /* MBEDTLS_CIPHER_C */\0A#include \22mbedtls/platform_util.h\22\0A#include \22mbedtls/error.h\22\0A\0A#include <string.h>\0A\0A#if defined(MBEDTLS_DES_C)\0A#include \22mbedtls/des.h\22\0A#endif\0A\0A#include \22psa_util_internal.h\22\0A\0A#if defined(MBEDTLS_ASN1_PARSE_C) && defined(MBEDTLS_CIPHER_C)\0A\0Astatic int pkcs12_parse_pbe_params(mbedtls_asn1_buf *params,\0A                                   mbedtls_asn1_buf *salt, int *iterations)\0A{\0A    int ret = MBEDTLS_ERR_ERROR_CORRUPTION_DETECTED;\0A    unsigned char **p = &params->p;\0A    const unsigned char *end = params->p + params->len;\0A\0A    /*\0A     *  pkcs-12PbeParams ::= SEQUENCE {\0A     *    salt          OCTET STRING,\0A     *    iterations    INTEGER\0A     *  }\0A     *\0A     */\0A    if (params->tag != (MBEDTLS_ASN1_CONSTRUCTED | MBEDTLS_ASN1_SEQUENCE)) {\0A        return MBEDTLS_ERROR_ADD(MBEDTLS_ERR_PKCS12_PBE_INVALID_FORMAT,\0A                                 MBEDTLS_ERR_ASN1_UNEXPECTED_TAG);\0A    }\0A\0A    if ((ret = mbedtls_asn1_get_tag(p, end, &salt->len, MBEDTLS_ASN1_OCTET_STRING)) != 0) {\0A        return MBEDTLS_ERROR_ADD(MBEDTLS_ERR_PKCS12_PBE_INVALID_FORMAT, ret);\0A    }\0A\0A    salt->p = *p;\0A    *p += salt->len;\0A\0A    if ((ret = mbedtls_asn1_get_int(p, end, iterations)) != 0) {\0A        return MBEDTLS_ERROR_ADD(MBEDTLS_ERR_PKCS12_PBE_INVALID_FORMAT, ret);\0A    }\0A\0A    if (*p != end) {\0A        return MBEDTLS_ERROR_ADD(MBEDTLS_ERR_PKCS12_PBE_INVALID_FORMAT,\0A                                 MBEDTLS_ERR_ASN1_LENGTH_MISMATCH);\0A    }\0A\0A    return 0;\0A}\0A\0A#define PKCS12_MAX_PWDLEN 128\0A\0Astatic int pkcs12_pbe_derive_key_iv(mbedtls_asn1_buf *pbe_params, mbedtls_md_type_t md_type,\0A                                    const unsigned char *pwd,  size_t pwdlen,\0A                                    unsigned char *key, size_t keylen,\0A                                    unsigned char *iv,  size_t ivlen)\0A{\0A    int ret, iterations = 0;\0A    mbedtls_asn1_buf salt;\0A    size_t i;\0A    unsigned char unipwd[PKCS12_MAX_PWDLEN * 2 + 2];\0A\0A    if (pwdlen > PKCS12_MAX_PWDLEN) {\0A        return MBEDTLS_ERR_PKCS12_BAD_INPUT_DATA;\0A    }\0A\0A    memset(&salt, 0, sizeof(mbedtls_asn1_buf));\0A    memset(&unipwd, 0, sizeof(unipwd));\0A\0A    if ((ret = pkcs12_parse_pbe_params(pbe_params, &salt,\0A                                       &iterations)) != 0) {\0A        return ret;\0A    }\0A\0A    for (i = 0; i < pwdlen; i++) {\0A        unipwd[i * 2 + 1] = pwd[i];\0A    }\0A\0A    if ((ret = mbedtls_pkcs12_derivation(key, keylen, unipwd, pwdlen * 2 + 2,\0A                                         salt.p, salt.len, md_type,\0A                                         MBEDTLS_PKCS12_DERIVE_KEY, iterations)) != 0) {\0A        return ret;\0A    }\0A\0A    if (iv == NULL || ivlen == 0) {\0A        return 0;\0A    }\0A\0A    if ((ret = mbedtls_pkcs12_derivation(iv, ivlen, unipwd, pwdlen * 2 + 2,\0A                                         salt.p, salt.len, md_type,\0A                                         MBEDTLS_PKCS12_DERIVE_IV, iterations)) != 0) {\0A        return ret;\0A    }\0A    return 0;\0A}\0A\0A#undef PKCS12_MAX_PWDLEN\0A\0A#if !defined(MBEDTLS_CIPHER_PADDING_PKCS7)\0Aint mbedtls_pkcs12_pbe_ext(mbedtls_asn1_buf *pbe_params, int mode,\0A                           mbedtls_cipher_type_t cipher_type, mbedtls_md_type_t md_type,\0A                           const unsigned char *pwd,  size_t pwdlen,\0A                           const unsigned char *data, size_t len,\0A                           unsigned char *output, size_t output_size,\0A                           size_t *output_len);\0A#endif\0A\0A#if !defined(MBEDTLS_DEPRECATED_REMOVED)\0Aint mbedtls_pkcs12_pbe(mbedtls_asn1_buf *pbe_params, int mode,\0A                       mbedtls_cipher_type_t cipher_type, mbedtls_md_type_t md_type,\0A                       const unsigned char *pwd,  size_t pwdlen,\0A                       const unsigned char *data, size_t len,\0A                       unsigned char *output)\0A{\0A    size_t output_len = 0;\0A\0A    /* We assume caller of the function is providing a big enough output buffer\0A     * so we pass output_size as SIZE_MAX to pass checks, However, no guarantees\0A     * for the output size actually being correct.\0A     */\0A    return mbedtls_pkcs12_pbe_ext(pbe_params, mode, cipher_type, md_type,\0A                                  pwd, pwdlen, data, len, output, SIZE_MAX,\0A                                  &output_len);\0A}\0A#endif\0A\0Aint mbedtls_pkcs12_pbe_ext(mbedtls_asn1_buf *pbe_params, int mode,\0A                           mbedtls_cipher_type_t cipher_type, mbedtls_md_type_t md_type,\0A                           const unsigned char *pwd,  size_t pwdlen,\0A                           const unsigned char *data, size_t len,\0A                           unsigned char *output, size_t output_size,\0A                           size_t *output_len)\0A{\0A    int ret, keylen = 0;\0A    unsigned char key[32];\0A    unsigned char iv[16];\0A    const mbedtls_cipher_info_t *cipher_info;\0A    mbedtls_cipher_context_t cipher_ctx;\0A    size_t iv_len = 0;\0A    size_t finish_olen = 0;\0A    unsigned int padlen = 0;\0A\0A    if (pwd == NULL && pwdlen != 0) {\0A        return MBEDTLS_ERR_PKCS12_BAD_INPUT_DATA;\0A    }\0A\0A    cipher_info = mbedtls_cipher_info_from_type(cipher_type);\0A    if (cipher_info == NULL) {\0A        return MBEDTLS_ERR_PKCS12_FEATURE_UNAVAILABLE;\0A    }\0A\0A    keylen = (int) mbedtls_cipher_info_get_key_bitlen(cipher_info) / 8;\0A\0A    if (mode == MBEDTLS_PKCS12_PBE_DECRYPT) {\0A        if (output_size < len) {\0A            return MBEDTLS_ERR_ASN1_BUF_TOO_SMALL;\0A        }\0A    }\0A\0A    if (mode == MBEDTLS_PKCS12_PBE_ENCRYPT) {\0A        padlen = cipher_info->block_size - (len % cipher_info->block_size);\0A        if (output_size < (len + padlen)) {\0A            return MBEDTLS_ERR_ASN1_BUF_TOO_SMALL;\0A        }\0A    }\0A\0A    iv_len = mbedtls_cipher_info_get_iv_size(cipher_info);\0A    if ((ret = pkcs12_pbe_derive_key_iv(pbe_params, md_type, pwd, pwdlen,\0A                                        key, keylen,\0A                                        iv, iv_len)) != 0) {\0A        return ret;\0A    }\0A\0A    mbedtls_cipher_init(&cipher_ctx);\0A\0A    if ((ret = mbedtls_cipher_setup(&cipher_ctx, cipher_info)) != 0) {\0A        goto exit;\0A    }\0A\0A    if ((ret = mbedtls_cipher_setkey(&cipher_ctx, key, 8 * keylen,\0A                                     (mbedtls_operation_t) mode)) != 0) {\0A        goto exit;\0A    }\0A\0A#if defined(MBEDTLS_CIPHER_MODE_WITH_PADDING)\0A    {\0A        /* PKCS12 uses CBC with PKCS7 padding */\0A        mbedtls_cipher_padding_t padding = MBEDTLS_PADDING_PKCS7;\0A#if !defined(MBEDTLS_CIPHER_PADDING_PKCS7)\0A        /* For historical reasons, when decrypting, this function works when\0A         * decrypting even when support for PKCS7 padding is disabled. In this\0A         * case, it ignores the padding, and so will never report a\0A         * password mismatch.\0A         */\0A        if (mode == MBEDTLS_PKCS12_PBE_DECRYPT) {\0A            padding = MBEDTLS_PADDING_NONE;\0A        }\0A#endif\0A        if ((ret = mbedtls_cipher_set_padding_mode(&cipher_ctx, padding)) != 0) {\0A            goto exit;\0A        }\0A    }\0A#endif /* MBEDTLS_CIPHER_MODE_WITH_PADDING */\0A\0A    ret = mbedtls_cipher_crypt(&cipher_ctx, iv, iv_len, data, len, output, &finish_olen);\0A    if (ret == MBEDTLS_ERR_CIPHER_INVALID_PADDING) {\0A        ret = MBEDTLS_ERR_PKCS12_PASSWORD_MISMATCH;\0A    }\0A\0A    *output_len += finish_olen;\0A\0Aexit:\0A    mbedtls_platform_zeroize(key, sizeof(key));\0A    mbedtls_platform_zeroize(iv,  sizeof(iv));\0A    mbedtls_cipher_free(&cipher_ctx);\0A\0A    return ret;\0A}\0A\0A#endif /* MBEDTLS_ASN1_PARSE_C && MBEDTLS_CIPHER_C */\0A\0Astatic void pkcs12_fill_buffer(unsigned char *data, size_t data_len,\0A                               const unsigned char *filler, size_t fill_len)\0A{\0A    unsigned char *p = data;\0A    size_t use_len;\0A\0A    if (filler != NULL && fill_len != 0) {\0A        while (data_len > 0) {\0A            use_len = (data_len > fill_len) ? fill_len : data_len;\0A            memcpy(p, filler, use_len);\0A            p += use_len;\0A            data_len -= use_len;\0A        }\0A    } else {\0A        /* If either of the above are not true then clearly there is nothing\0A         * that this function can do. The function should *not* be called\0A         * under either of those circumstances, as you could end up with an\0A         * incorrect output but for safety's sake, leaving the check in as\0A         * otherwise we could end up with memory corruption.*/\0A    }\0A}\0A\0A\0Astatic int calculate_hashes(mbedtls_md_type_t md_type, int iterations,\0A                            unsigned char *diversifier, unsigned char *salt_block,\0A                            unsigned char *pwd_block, unsigned char *hash_output, int use_salt,\0A                            int use_password, size_t hlen, size_t v)\0A{\0A    int ret = -1;\0A    size_t i;\0A    const mbedtls_md_info_t *md_info;\0A    mbedtls_md_context_t md_ctx;\0A    md_info = mbedtls_md_info_from_type(md_type);\0A    if (md_info == NULL) {\0A        return MBEDTLS_ERR_PKCS12_FEATURE_UNAVAILABLE;\0A    }\0A\0A    mbedtls_md_init(&md_ctx);\0A\0A    if ((ret = mbedtls_md_setup(&md_ctx, md_info, 0)) != 0) {\0A        return ret;\0A    }\0A    // Calculate hash( diversifier || salt_block || pwd_block )\0A    if ((ret = mbedtls_md_starts(&md_ctx)) != 0) {\0A        goto exit;\0A    }\0A\0A    if ((ret = mbedtls_md_update(&md_ctx, diversifier, v)) != 0) {\0A        goto exit;\0A    }\0A\0A    if (use_salt != 0) {\0A        if ((ret = mbedtls_md_update(&md_ctx, salt_block, v)) != 0) {\0A            goto exit;\0A        }\0A    }\0A\0A    if (use_password != 0) {\0A        if ((ret = mbedtls_md_update(&md_ctx, pwd_block, v)) != 0) {\0A            goto exit;\0A        }\0A    }\0A\0A    if ((ret = mbedtls_md_finish(&md_ctx, hash_output)) != 0) {\0A        goto exit;\0A    }\0A\0A    // Perform remaining ( iterations - 1 ) recursive hash calculations\0A    for (i = 1; i < (size_t) iterations; i++) {\0A        if ((ret = mbedtls_md(md_info, hash_output, hlen, hash_output))\0A            != 0) {\0A            goto exit;\0A        }\0A    }\0A\0Aexit:\0A    mbedtls_md_free(&md_ctx);\0A    return ret;\0A}\0A\0A\0Aint mbedtls_pkcs12_derivation(unsigned char *data, size_t datalen,\0A                              const unsigned char *pwd, size_t pwdlen,\0A                              const unsigned char *salt, size_t saltlen,\0A                              mbedtls_md_type_t md_type, int id, int iterations)\0A{\0A    int ret = MBEDTLS_ERR_ERROR_CORRUPTION_DETECTED;\0A    unsigned int j;\0A\0A    unsigned char diversifier[128];\0A    unsigned char salt_block[128], pwd_block[128], hash_block[128] = { 0 };\0A    unsigned char hash_output[MBEDTLS_MD_MAX_SIZE];\0A    unsigned char *p;\0A    unsigned char c;\0A    int           use_password = 0;\0A    int           use_salt = 0;\0A\0A    size_t hlen, use_len, v, i;\0A\0A    // This version only allows max of 64 bytes of password or salt\0A    if (datalen > 128 || pwdlen > 64 || saltlen > 64) {\0A        return MBEDTLS_ERR_PKCS12_BAD_INPUT_DATA;\0A    }\0A\0A    if (pwd == NULL && pwdlen != 0) {\0A        return MBEDTLS_ERR_PKCS12_BAD_INPUT_DATA;\0A    }\0A\0A    if (salt == NULL && saltlen != 0) {\0A        return MBEDTLS_ERR_PKCS12_BAD_INPUT_DATA;\0A    }\0A\0A    use_password = (pwd && pwdlen != 0);\0A    use_salt = (salt && saltlen != 0);\0A\0A    hlen = mbedtls_md_get_size_from_type(md_type);\0A\0A    if (hlen <= 32) {\0A        v = 64;\0A    } else {\0A        v = 128;\0A    }\0A\0A    memset(diversifier, (unsigned char) id, v);\0A\0A    if (use_salt != 0) {\0A        pkcs12_fill_buffer(salt_block, v, salt, saltlen);\0A    }\0A\0A    if (use_password != 0) {\0A        pkcs12_fill_buffer(pwd_block,  v, pwd,  pwdlen);\0A    }\0A\0A    p = data;\0A    while (datalen > 0) {\0A        if (calculate_hashes(md_type, iterations, diversifier, salt_block,\0A                             pwd_block, hash_output, use_salt, use_password, hlen,\0A                             v) != 0) {\0A            goto exit;\0A        }\0A\0A        use_len = (datalen > hlen) ? hlen : datalen;\0A        memcpy(p, hash_output, use_len);\0A        datalen -= use_len;\0A        p += use_len;\0A\0A        if (datalen == 0) {\0A            break;\0A        }\0A\0A        // Concatenating copies of hash_output into hash_block (B)\0A        pkcs12_fill_buffer(hash_block, v, hash_output, hlen);\0A\0A        // B += 1\0A        for (i = v; i > 0; i--) {\0A            if (++hash_block[i - 1] != 0) {\0A                break;\0A            }\0A        }\0A\0A        if (use_salt != 0) {\0A            // salt_block += B\0A            c = 0;\0A            for (i = v; i > 0; i--) {\0A                j = salt_block[i - 1] + hash_block[i - 1] + c;\0A                c = MBEDTLS_BYTE_1(j);\0A                salt_block[i - 1] = MBEDTLS_BYTE_0(j);\0A            }\0A        }\0A\0A        if (use_password != 0) {\0A            // pwd_block  += B\0A            c = 0;\0A            for (i = v; i > 0; i--)