@.str39974 = private global { i64, i64, [9117 x i8] } { i64 -1, i64 9116, [9117 x i8] c"/*\0A *  PSA hashing layer on top of Mbed TLS software crypto\0A */\0A/*\0A *  Copyright The Mbed TLS Contributors\0A *  SPDX-License-Identifier: Apache-2.0 OR GPL-2.0-or-later\0A */\0A\0A#ifndef PSA_CRYPTO_HASH_H\0A#define PSA_CRYPTO_HASH_H\0A\0A#include <psa/crypto.h>\0A\0A/** Calculate the hash (digest) of a message using Mbed TLS routines.\0A *\0A * \5Cnote The signature of this function is that of a PSA driver hash_compute\0A *       entry point. This function behaves as a hash_compute entry point as\0A *       defined in the PSA driver interface specification for transparent\0A *       drivers.\0A *\0A * \5Cparam alg               The hash algorithm to compute (\5Cc PSA_ALG_XXX value\0A *                          such that #PSA_ALG_IS_HASH(\5Cp alg) is true).\0A * \5Cparam[in] input         Buffer containing the message to hash.\0A * \5Cparam input_length      Size of the \5Cp input buffer in bytes.\0A * \5Cparam[out] hash         Buffer where the hash is to be written.\0A * \5Cparam hash_size         Size of the \5Cp hash buffer in bytes.\0A * \5Cparam[out] hash_length  On success, the number of bytes\0A *                          that make up the hash value. This is always\0A *                          #PSA_HASH_LENGTH(\5Cp alg).\0A *\0A * \5Cretval #PSA_SUCCESS\0A *         Success.\0A * \5Cretval #PSA_ERROR_NOT_SUPPORTED\0A *         \5Cp alg is not supported\0A * \5Cretval #PSA_ERROR_BUFFER_TOO_SMALL\0A *         \5Cp hash_size is too small\0A * \5Cretval #PSA_ERROR_INSUFFICIENT_MEMORY \5Cemptydescription\0A * \5Cretval #PSA_ERROR_CORRUPTION_DETECTED \5Cemptydescription\0A */\0Apsa_status_t mbedtls_psa_hash_compute(\0A    psa_algorithm_t alg,\0A    const uint8_t *input,\0A    size_t input_length,\0A    uint8_t *hash,\0A    size_t hash_size,\0A    size_t *hash_length);\0A\0A/** Set up a multipart hash operation using Mbed TLS routines.\0A *\0A * \5Cnote The signature of this function is that of a PSA driver hash_setup\0A *       entry point. This function behaves as a hash_setup entry point as\0A *       defined in the PSA driver interface specification for transparent\0A *       drivers.\0A *\0A * If an error occurs at any step after a call to mbedtls_psa_hash_setup(), the\0A * operation will need to be reset by a call to mbedtls_psa_hash_abort(). The\0A * core may call mbedtls_psa_hash_abort() at any time after the operation\0A * has been initialized.\0A *\0A * After a successful call to mbedtls_psa_hash_setup(), the core must\0A * eventually terminate the operation. The following events terminate an\0A * operation:\0A * - A successful call to mbedtls_psa_hash_finish() or mbedtls_psa_hash_verify().\0A * - A call to mbedtls_psa_hash_abort().\0A *\0A * \5Cparam[in,out] operation The operation object to set up. It must have\0A *                          been initialized to all-zero and not yet be in use.\0A * \5Cparam alg               The hash algorithm to compute (\5Cc PSA_ALG_XXX value\0A *                          such that #PSA_ALG_IS_HASH(\5Cp alg) is true).\0A *\0A * \5Cretval #PSA_SUCCESS\0A *         Success.\0A * \5Cretval #PSA_ERROR_NOT_SUPPORTED\0A *         \5Cp alg is not supported\0A * \5Cretval #PSA_ERROR_BAD_STATE\0A *         The operation state is not valid (it must be inactive).\0A * \5Cretval #PSA_ERROR_INSUFFICIENT_MEMORY \5Cemptydescription\0A * \5Cretval #PSA_ERROR_CORRUPTION_DETECTED \5Cemptydescription\0A */\0Apsa_status_t mbedtls_psa_hash_setup(\0A    mbedtls_psa_hash_operation_t *operation,\0A    psa_algorithm_t alg);\0A\0A/** Clone an Mbed TLS hash operation.\0A *\0A * \5Cnote The signature of this function is that of a PSA driver hash_clone\0A *       entry point. This function behaves as a hash_clone entry point as\0A *       defined in the PSA driver interface specification for transparent\0A *       drivers.\0A *\0A * This function copies the state of an ongoing hash operation to\0A * a new operation object. In other words, this function is equivalent\0A * to calling mbedtls_psa_hash_setup() on \5Cp target_operation with the same\0A * algorithm that \5Cp source_operation was set up for, then\0A * mbedtls_psa_hash_update() on \5Cp target_operation with the same input that\0A * that was passed to \5Cp source_operation. After this function returns, the\0A * two objects are independent, i.e. subsequent calls involving one of\0A * the objects do not affect the other object.\0A *\0A * \5Cparam[in] source_operation      The active hash operation to clone.\0A * \5Cparam[in,out] target_operation  The operation object to set up.\0A *                                  It must be initialized but not active.\0A *\0A * \5Cretval #PSA_SUCCESS \5Cemptydescription\0A * \5Cretval #PSA_ERROR_BAD_STATE\0A *         The \5Cp source_operation state is not valid (it must be active).\0A * \5Cretval #PSA_ERROR_BAD_STATE\0A *         The \5Cp target_operation state is not valid (it must be inactive).\0A * \5Cretval #PSA_ERROR_CORRUPTION_DETECTED \5Cemptydescription\0A * \5Cretval #PSA_ERROR_INSUFFICIENT_MEMORY \5Cemptydescription\0A */\0Apsa_status_t mbedtls_psa_hash_clone(\0A    const mbedtls_psa_hash_operation_t *source_operation,\0A    mbedtls_psa_hash_operation_t *target_operation);\0A\0A/** Add a message fragment to a multipart Mbed TLS hash operation.\0A *\0A * \5Cnote The signature of this function is that of a PSA driver hash_update\0A *       entry point. This function behaves as a hash_update entry point as\0A *       defined in the PSA driver interface specification for transparent\0A *       drivers.\0A *\0A * The application must call mbedtls_psa_hash_setup() before calling this function.\0A *\0A * If this function returns an error status, the operation enters an error\0A * state and must be aborted by calling mbedtls_psa_hash_abort().\0A *\0A * \5Cparam[in,out] operation Active hash operation.\0A * \5Cparam[in] input         Buffer containing the message fragment to hash.\0A * \5Cparam input_length      Size of the \5Cp input buffer in bytes.\0A *\0A * \5Cretval #PSA_SUCCESS\0A *         Success.\0A * \5Cretval #PSA_ERROR_BAD_STATE\0A *         The operation state is not valid (it must be active).\0A * \5Cretval #PSA_ERROR_INSUFFICIENT_MEMORY \5Cemptydescription\0A * \5Cretval #PSA_ERROR_CORRUPTION_DETECTED \5Cemptydescription\0A */\0Apsa_status_t mbedtls_psa_hash_update(\0A    mbedtls_psa_hash_operation_t *operation,\0A    const uint8_t *input,\0A    size_t input_length);\0A\0A/** Finish the calculation of the Mbed TLS-calculated hash of a message.\0A *\0A * \5Cnote The signature of this function is that of a PSA driver hash_finish\0A *       entry point. This function behaves as a hash_finish entry point as\0A *       defined in the PSA driver interface specification for transparent\0A *       drivers.\0A *\0A * The application must call mbedtls_psa_hash_setup() before calling this function.\0A * This function calculates the hash of the message formed by concatenating\0A * the inputs passed to preceding calls to mbedtls_psa_hash_update().\0A *\0A * When this function returns successfully, the operation becomes inactive.\0A * If this function returns an error status, the operation enters an error\0A * state and must be aborted by calling mbedtls_psa_hash_abort().\0A *\0A * \5Cparam[in,out] operation     Active hash operation.\0A * \5Cparam[out] hash             Buffer where the hash is to be written.\0A * \5Cparam hash_size             Size of the \5Cp hash buffer in bytes.\0A * \5Cparam[out] hash_length      On success, the number of bytes\0A *                              that make up the hash value. This is always\0A *                              #PSA_HASH_LENGTH(\5Cc alg) where \5Cc alg is the\0A *                              hash algorithm that is calculated.\0A *\0A * \5Cretval #PSA_SUCCESS\0A *         Success.\0A * \5Cretval #PSA_ERROR_BAD_STATE\0A *         The operation state is not valid (it must be active).\0A * \5Cretval #PSA_ERROR_BUFFER_TOO_SMALL\0A *         The size of the \5Cp hash buffer is too small. You can determine a\0A *         sufficient buffer size by calling #PSA_HASH_LENGTH(\5Cc alg)\0A *         where \5Cc alg is the hash algorithm that is calculated.\0A * \5Cretval #PSA_ERROR_INSUFFICIENT_MEMORY \5Cemptydescription\0A * \5Cretval #PSA_ERROR_CORRUPTION_DETECTED \5Cemptydescription\0A */\0Apsa_status_t mbedtls_psa_hash_finish(\0A    mbedtls_psa_hash_operation_t *operation,\0A    uint8_t *hash,\0A    size_t hash_size,\0A    size_t *hash_length);\0A\0A/** Abort an Mbed TLS hash operation.\0A *\0A * \5Cnote The signature of this function is that of a PSA driver hash_abort\0A *       entry point. This function behaves as a hash_abort entry point as\0A *       defined in the PSA driver interface specification for transparent\0A *       drivers.\0A *\0A * Aborting an operation frees all associated resources except for the\0A * \5Cp operation structure itself. Once aborted, the operation object\0A * can be reused for another operation by calling\0A * mbedtls_psa_hash_setup() again.\0A *\0A * You may call this function any time after the operation object has\0A * been initialized by one of the methods described in #psa_hash_operation_t.\0A *\0A * In particular, calling mbedtls_psa_hash_abort() after the operation has been\0A * terminated by a call to mbedtls_psa_hash_abort(), mbedtls_psa_hash_finish() or\0A * mbedtls_psa_hash_verify() is safe and has no effect.\0A *\0A * \5Cparam[in,out] operation     Initialized hash operation.\0A *\0A * \5Cretval #PSA_SUCCESS \5Cemptydescription\0A * \5Cretval #PSA_ERROR_CORRUPTION_DETECTED \5Cemptydescription\0A */\0Apsa_status_t mbedtls_psa_hash_abort(\0A    mbedtls_psa_hash_operation_t *operation);\0A\0A#endif /* PSA_CRYPTO_HASH_H */\0A\00" }
