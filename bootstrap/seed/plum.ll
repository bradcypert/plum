_init == 0) {\0A        const int *p;\0A        int *q;\0A\0A        for (p = ciphersuite_preference, q = supported_ciphersuites;\0A             *p != 0 && q < supported_ciphersuites + MAX_CIPHERSUITES - 1;\0A             p++) {\0A            const mbedtls_ssl_ciphersuite_t *cs_info;\0A            if ((cs_info = mbedtls_ssl_ciphersuite_from_id(*p)) != NULL &&\0A                !ciphersuite_is_removed(cs_info)) {\0A                *(q++) = *p;\0A            }\0A        }\0A        *q = 0;\0A\0A        supported_init = 1;\0A    }\0A\0A    return supported_ciphersuites;\0A}\0A#endif /* MBEDTLS_SSL_CIPHERSUITES */\0A\0Aconst mbedtls_ssl_ciphersuite_t *mbedtls_ssl_ciphersuite_from_string(\0A    const char *ciphersuite_name)\0A{\0A    const mbedtls_ssl_ciphersuite_t *cur = ciphersuite_definitions;\0A\0A    if (NULL == ciphersuite_name) {\0A        return NULL;\0A    }\0A\0A    while (cur->id != 0) {\0A        if (0 == strcmp(cur->name, ciphersuite_name)) {\0A            return cur;\0A        }\0A\0A        cur++;\0A    }\0A\0A    return NULL;\0A}\0A\0Aconst mbedtls_ssl_ciphersuite_t *mbedtls_ssl_ciphersuite_from_id(int ciphersuite)\0A{\0A    const mbedtls_ssl_ciphersuite_t *cur = ciphersuite_definitions;\0A\0A    while (cur->id != 0) {\0A        if (cur->id == ciphersuite) {\0A            return cur;\0A        }\0A\0A        cur++;\0A    }\0A\0A    return NULL;\0A}\0A\0Aconst char *mbedtls_ssl_get_ciphersuite_name(const int ciphersuite_id)\0A{\0A    const mbedtls_ssl_ciphersuite_t *cur;\0A\0A    cur = mbedtls_ssl_ciphersuite_from_id(ciphersuite_id);\0A\0A    if (cur == NULL) {\0A        return \22unknown\22;\0A    }\0A\0A    return cur->name;\0A}\0A\0Aint mbedtls_ssl_get_ciphersuite_id(const char *ciphersuite_name)\0A{\0A    const mbedtls_ssl_ciphersuite_t *cur;\0A\0A    cur = mbedtls_ssl_ciphersuite_from_string(ciphersuite_name);\0A\0A    if (cur == NULL) {\0A        return 0;\0A    }\0A\0A    return cur->id;\0A}\0A\0Asize_t mbedtls_ssl_ciphersuite_get_cipher_key_bitlen(