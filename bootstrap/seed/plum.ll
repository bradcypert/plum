@.str55110 = private global { i64, i64, [23664 x i8] } { i64 -1, i64 23663, [23664 x i8] c"/// Filesystem and self-location. These replaced shelling out to\0A/// `mktemp -d`, `rm -rf`, `rm -f`, `cp -r` and `mkdir`, and reading\0A/// `/proc/self/exe`. See `native_stdlib/os_shim.c`.\0A///\0A/// The `..._raw` forms are runtime primitives whose Plum bodies\0A/// exist only to give the checker a signature. They travel with the\0A/// module: `cg_runtime_fn` keys on the bare name and does not care\0A/// which module the call was written in.\0Alet os_temp_dir_raw (ignored: Bool): String = \22\22\0Alet os_self_exe_raw (ignored: Bool): String = \22\22\0Alet os_make_dir_raw (path: String): Int = 0\0Alet os_remove_file_raw (path: String): Int = 0\0Alet os_rename_file_raw (from: String) (to: String): Int = 0\0Alet os_remove_tree_raw (path: String): Int = 0\0Alet os_copy_tree_raw (src: String) (dst: String): Int = 0\0Alet os_platform_raw (ignored: Bool): String = \22\22\0A\0A/// Which platform this program is running on: \22linux\22, \22macos\22 or\0A/// \22windows\22. Compiled in, not detected at runtime; a binary\0A/// cannot move between platforms, so there is nothing to detect.\0Apub let platform (): String = os_platform_raw(true)\0A\0A/// A fresh, empty, private directory. The caller owns it and is\0A/// responsible for `Os.remove_tree` on it.\0Apub let temp_dir (): Result[String, String] = {\0A    let d = os_temp_dir_raw(true);\0A    if String.is_empty(d) { Err(\22Os.temp_dir: could not create a temporary directory\22) }\0A    else { Ok(d) }\0A}\0A\0A/// The path of the running executable, for a program that needs to\0A/// re-invoke itself.\0Apub let self_exe (): Result[String, String] = {\0A    let p = os_self_exe_raw(true);\0A    if String.is_empty(p) { Err(\22Os.self_exe: could not determine the executable path\22) }\0A    else { Ok(p) }\0A}\0A\0A/// Creates one directory. The PARENT must already exist; this makes a\0A/// single level, not a path.\0A///\0A/// `Err` when the parent is missing, when the name is taken by a file,\0A/// or when permission is refused. A directory that already exists is\0A/// also an `Err`, so a caller who does not care should check\0A/// `Os.exists` first.\0Apub let make_dir (path: String): Result[Unit, String] =\0A    if os_make_dir_raw(path) == 0 { Ok(()) }\0A    else { Err(\22Os.make_dir: could not create \22.concat(path)) }\0A\0A/// Atomic within one filesystem, and an error rather than a silent\0A/// copy across two. The point is that the destination is never a\0A/// half-written file.\0Apub let rename_file (from: String) (to: String): Result[Unit, String] =\0A    if os_rename_file_raw(from, to) == 0 { Ok(()) }\0A    else { Err(\22Os.rename_file: could not rename \22.concat(from).concat(\22 to \22).concat(to)) }\0A\0A/// Deletes a file. `Err` when it is not there, when it is a directory,\0A/// or when permission is refused — `Os.remove_tree` is the one for\0A/// directories.\0Apub let remove_file (path: String): Result[Unit, String] =\0A    if os_remove_file_raw(path) == 0 { Ok(()) }\0A    else { Err(\22Os.remove_file: could not remove \22.concat(path)) }\0A\0A/// Deletes a directory and everything under it. Symlinks are removed,\0A/// never followed into.\0Apub let remove_tree (path: String): Result[Unit, String] =\0A    if os_remove_tree_raw(path) == 0 { Ok(()) }\0A    else { Err(\22Os.remove_tree: could not remove \22.concat(path)) }\0A\0A/// Copies the CONTENTS of `src` into `dst`, which must already exist\0A/// and must not overlap `src`. Returns `Err` for identical or nested\0A/// directories before changing `dst`. File modes are not preserved.\0Apub let copy_tree (src: String) (dst: String): Result[Unit, String] =\0A    if os_copy_tree_raw(src, dst) == 0 { Ok(()) }\0A    else { Err(\22Os.copy_tree: could not copy \22.concat(src).concat(\22 to \22).concat(dst)) }\0A\0A// --- Environment and process ---\0A//\0A// Folded in from the flat prelude in 0.0.9. `Os` already owned the\0A// filesystem calls that shell out to `os_shim.c`, so putting\0A// `read_file` in a separate `Fs` would have split the filesystem\0A// across two modules. This is the shape Go settled on -- `os.ReadFile`,\0A// `os.Getenv`, `os.Exit`, `os.MkdirAll` in one place, with `net`\0A// separate and string helpers on the type.\0A\0Alet exit_raw (code: Int): Bool = false\0Alet env_var_raw (name: String): Array[String] = []\0A\0A/// Exit with a status code, printing nothing. `panic_raw` also exits\0A/// non-zero but prints its message first, which is wrong when the\0A/// report has already been written.\0Apub let exit_with (code: Int): Unit = { exit_raw(code); () }\0A\0A/// `env_var_raw` returns an ARRAY, empty when unset, matching\0A/// `read_file_raw`: hand-written runtime IR cannot construct an\0A/// `Option` without hard-coding tag numbers the backend assigns per\0A/// program, so the wrapping happens here where `Some`/`None` are\0A/// ordinary variants.\0Apub let env_var (name: String): Option[String] = {\0A    let r = env_var_raw(name);\0A    if Array.is_empty(r) { None } else { Some(r[0]) }\0A}\0A\0A// --- Whole-file I/O ---\0A\0Alet read_file_raw (path: String): Array[String] = []\0Alet write_file_raw (path: String) (contents: String): Bool = false\0A\0A/// Reads a whole file as text.\0A///\0A/// `Err` when the file is missing, unreadable, or not valid UTF-8. Use\0A/// `Os.read_bytes` for a file that is not text, or that might not be.\0Apub let read_file (path: String): Result[String, String] = {\0A    let r = read_file_raw(path);\0A    if Array.is_empty(r) { Err(\22could not read \22.concat(path)) } else { Ok(r[0]) }\0A}\0A\0A/// Writes text to a file, creating it or REPLACING what was there.\0A///\0A/// The parent directory must exist. Nothing is written on failure, so\0A/// a full disk leaves the old contents rather than a truncated file.\0Apub let write_file (path: String) (contents: String): Result[Unit, String] =\0A    if write_file_raw(path, contents) { Ok(()) } else { Err(\22could not write \22.concat(path)) }\0A\0A/// --- Whole-file BINARY I/O ---\0A///\0A/// The `String` pair above keeps its contract exactly: it is the text\0A/// convenience, and a program that wants text should keep using it.\0A/// These are for the payloads a `String` cannot honestly describe --\0A/// images, compressed data, anything with an embedded NUL or a byte\0A/// that is not valid UTF-8.\0A///\0A/// The runtime half needed almost nothing: `read_file_raw` already\0A/// reads with `fread` and the file's real size, and `write_file_raw`\0A/// already writes with `fwrite` and the cell's stored length, so\0A/// neither has ever stopped at a NUL. What was missing was a TYPE\0A/// that promised as much. `Os.read_file` returning a `String` is a\0A/// claim about encoding that a JPEG does not satisfy, and\0A/// byte-indexed operations to do anything with the result.\0A///\0A/// `read_file_bytes_raw` returns an ARRAY for the same reason its\0A/// String twin does: hand-written runtime IR cannot construct a\0A/// `Result` without hard-coding tag numbers the backend assigns per\0A/// program, so the wrapping happens here.\0Alet read_file_bytes_raw (path: String): Array[Bytes] = []\0Alet write_file_bytes_raw (path: String) (contents: Bytes): Bool = false\0Alet append_file_bytes_raw (path: String) (contents: Bytes): Bool = false\0A\0A/// An empty file reads back as empty `Bytes`, NOT as an error, because the\0A/// array is empty only when the file could not be opened at all, so\0A/// \22no such file\22 and \22a file with nothing in it\22 stay distinct.\0Apub let read_bytes (path: String): Result[Bytes, String] = {\0A    let r = read_file_bytes_raw(path);\0A    if Array.is_empty(r) { Err(\22could not read \22.concat(path)) } else { Ok(r[0]) }\0A}\0A\0A/// Writes bytes to a file, creating it or REPLACING what was there.\0A///\0A/// The `Bytes` counterpart to `Os.write_file`: use this for anything\0A/// that is not text, and for text you have already encoded.\0Apub let write_bytes (path: String) (data: Bytes): Result[Unit, String] =\0A    if write_file_bytes_raw(path, data) { Ok(()) } else { Err(\22could not write \22.concat(path)) }\0A\0A/// Creates the file when it does not exist, the way `>>` does.\0Apub let append_bytes (path: String) (data: Bytes): Result[Unit, String] =\0A    if append_file_bytes_raw(path, data) { Ok(()) } else { Err(\22could not append to \22.concat(path)) }\0A\0A// --- Streaming file I/O ---\0A//\0A// The whole-file calls above are the convenience: one call, no\0A// handle, no cleanup to think about. These are for the cases a\0A// whole-file read cannot serve -- a file too big to hold, a stream\0A// consumed as it arrives, an append-only log kept open.\0A//\0A// `File` is a `handle` (issue #9), so an open file CLOSES ITSELF\0A// when the value dies. `File.close` is still offered, and still\0A// returns a `Result`, because closing can fail -- a buffered write\0A// is flushed by `fclose`, and that is exactly when a full disk is\0A// discovered. So: call `close` when the error matters, and rely on\0A// the handle when it does not. Neither leaks.\0A//\0A// Closing twice is fine and is the NORMAL path, since the handle\0A// runs after an explicit close. `native_stdlib/file_shim.c` owns a\0A// slot table precisely so the second one is harmless.\0Aextern \22C\22 {\0A    fn file_open(path: CStr, mode: Int) -> Int;\0A    fn file_close(h: Int);\0A    fn file_close_checked(h: Int) -> Int;\0A    fn file_read_n(h: Int, max_len: Int) -> Int;\0A    fn file_read_data() -> CStr;\0A    fn file_write(h: Int, buf: CStr, len: Int) -> Int;\0A    fn file_seek(h: Int, offset: Int, whence: Int) -> Int;\0A    fn file_flush(h: Int) -> Int;\0A}\0A\0A/// An open file. **Closed when this value dies**, including on a\0A/// panic, so a file opened in a scope needs no cleanup.\0A///\0A/// `File.close` is still offered and still returns a `Result`, because\0A/// closing can fail: a buffered write is flushed by the close, and that\0A/// is exactly when a full disk is discovered. Call it when that error\0A/// matters; rely on the handle when it does not. Closing twice is\0A/// harmless.\0Apub handle File { on_drop: file_close }\0A\0A/// How to open. A closed set, passed as small integers across the\0A/// extern boundary; an extern taking a mode STRING would let a\0A/// caller hand `fopen` anything at all.\0Apub enum Mode { Read, Write, Append }\0A\0A/// Where a seek measures from.\0Apub enum Seek { Start, Current, End }\0A\0Alet mode_code (m: Mode): Int = match m { Read => 0, Write => 1, Append => 2 }\0Alet seek_code (s: Seek): Int = match s { Start => 0, Current => 1, End => 2 }\0A\0A/// `Write` truncates an existing file; `Append` does not. Both create\0A/// one that is not there, and `Read` does not.\0Apub let open (path: String) (mode: Mode): Result[File, String] = unsafe {\0A    let h = file_open(path.as_cstr(), mode_code(mode));\0A    if h < 0 { Err(\22Os.open: could not open \22.concat(path)) } else { Ok(File.from_raw(h)) }\0A}\0A\0A/// Up to `max_len` bytes. An empty result is END OF FILE, not a\0A/// failure: the same three-way split `Net.read_bytes` makes, and\0A/// for the same reason: a reader looping until the end needs to tell\0A/// \22nothing left\22 from \22something broke\22.\0A/// `max_len` must be positive; zero or negative sizes return `Err`\0A/// without consuming input, even at end of file.\0Apub let File.read (f: File) (max_len: Int): Result[Bytes, String] = unsafe {\0A    let n = file_read_n(File.raw(f), max_len);\0A    if n < 0 { Err(\22File.read: read failed\22) }\0A    else { Ok(Bytes.from_cstr(file_read_data(), n)) }\0A}\0A\0A/// `len` MUST be bound BEFORE `.as_cstr()` runs, the same ordering\0A/// `Net.write` spells out: the pointer is an interior one into the\0A/// cell, and reading `.len()` afterwards in the same argument list is\0A/// how that bug was found on the wire the first time.\0Apub let File.write (f: File) (data: Bytes): Result[Int, String] = unsafe {\0A    let len = data.len();\0A    let n = file_write(File.raw(f), data.as_cstr(), len);\0A    if n < 0 { Err(\22File.write: write failed\22) } else { Ok(n) }\0A}\0A\0A/// The new absolute position.\0Apub let File.seek (f: File) (offset: Int) (from: Seek): Result[Int, String] = unsafe {\0A    let p = file_seek(File.raw(f), offset, seek_code(from));\0A    if p < 0 { Err(\22File.seek: seek failed\22) } else { Ok(p) }\0A}\0A\0A/// Makes buffered writes visible without giving up the handle.\0Apub let File.flush (f: File): Result[Unit, String] = unsafe {\0A    if file_flush(File.raw(f)) == 0 { Ok(()) } else { Err(\22File.flush: flush failed\22) }\0A}\0A\0A/// Closing is OPTIONAL: the handle closes the file when it dies. Call\0A/// this when a failed final flush is something the program should\0A/// react to rather than lose. Calling it twice, or letting the handle\0A/// run afterwards, is harmless.\0Apub let File.close (f: File): Result[Unit, String] = unsafe {\0A    if file_close_checked(File.raw(f)) == 0 { Ok(()) } else { Err(\22File.close: close failed\22) }\0A}\0A\0A// --- Running a program ---\0A//\0A// `process_run_raw` takes its arguments TAB-joined in a single string\0A// because an extern boundary has no `Array[String]` -- see\0A// `native_stdlib/process_shim.c`. The join happens here rather than in\0A// the runtime, where it would have to be written in IR.\0A\0Alet process_run_raw (program: String) (args_joined: String) (argc: Int): Int = 0\0Alet process_exit_code_raw (handle: Int): Int = 0\0Alet process_stdout_raw (handle: Int): String = \22\22\0Alet process_stderr_raw (handle: Int): String = \22\22\0Alet process_free_raw (handle: Int): Bool = false\0A\0A/// What a finished process left behind.\0A///\0A/// `exit_code` is the child's own status: a non-zero one is an ordinary\0A/// result, not an error. Failing to START the process is the `Err`.\0A/// What a finished process left behind.\0A///\0A/// `exit_code` is the child's own status: a non-zero one is an ordinary\0A/// result, not an error. Failing to START the process is the `Err`.\0Apub struct ProcessResult { pub exit_code: Int, pub stdout: String, pub stderr: String }\0A\0A/// NO leading separator: `process_run` points argv[1] at the WHOLE\0A/// joined string, so a leading tab makes argv[1] empty and pushes the\0A/// last real argument past `argc`, silently dropping it. A plain fold\0A/// that prefixes every element is NOT equivalent.\0Alet join_args_acc (args: Array[String]) (i: Int) (acc: String): String =\0A    if i >= args.len() { acc }\0A    else if i == 0 { join_args_acc(args, i + 1, args[i]) }\0A    else { join_args_acc(args, i + 1, acc.concat(\22\5Ct\22).concat(args[i])) }\0A\0A/// A non-zero exit code is an ordinary `Ok`. `Err` means the process\0A/// could not be started at all.\0Apub let run_process (program: String) (args: Array[String]): Result[ProcessResult, String] = {\0A    let joined = join_args_acc(args, 0, \22\22);\0A    let handle = process_run_raw(program, joined, args.len());\0A    if handle < 0 { Err(\22Os.run_process: could not start process: \22.concat(program)) }\0A    else {\0A        let result = ProcessResult {\0A            exit_code: process_exit_code_raw(handle),\0A            stdout: process_stdout_raw(handle),\0A            stderr: process_stderr_raw(handle),\0A        };\0A        let freed = process_free_raw(handle);\0A        Ok(result)\0A    }\0A}\0A\0A// --- Process identity ---\0A//\0A// argv, the working directory, stdin and stderr. `args()` has\0A// always existed as a compiler builtin and is documented now;\0A// the rest was reachable only through the private C shims the\0A// language server uses.\0Aextern \22C\22 {\0A    fn os_cwd() -> CStr;\0A    fn os_chdir(path: CStr) -> Int;\0A    fn stdin_line_n() -> Int;\0A    fn stdin_line_data() -> CStr;\0A    fn stdin_bytes_n(max: Int) -> Int;\0A    fn stdin_bytes_data() -> CStr;\0A    fn stdin_line_timed(timeout_nanos: Int) -> Int;\0A    fn stdin_bytes_timed(max: Int, timeout_nanos: Int) -> Int;\0