\0A    ctx->grp_id = MBEDTLS_ECP_DP_NONE;\0A#endif\0A}\0A\0Astatic int ecdh_make_params_internal(mbedtls_ecdh_context_mbed *ctx,\0A                                     size_t *olen, int point_format,\0A                                     unsigned char *buf, size_t blen,\0A                                     int (*f_rng)(void *,\0A                                                  unsigned char *,\0A                                                  size_t),\0A                                     void *p_rng,\0A                                     int restart_enabled)\0A{\0A    int ret = MBEDTLS_ERR_ERROR_CORRUPTION_DETECTED;\0A    size_t grp_len, pt_len;\0A#if defined(MBEDTLS_ECP_RESTARTABLE)\0A    mbedtls_ecp_restart_ctx *rs_ctx = NULL;\0A#endif\0A\0A    if (ctx->grp.pbits == 0) {\0A        return MBEDTLS_ERR_ECP_BAD_INPUT_DATA;\0A    }\0A\0A#if defined(MBEDTLS_ECP_RESTARTABLE)\0A    if (restart_enabled) {\0A        rs_ctx = &ctx->rs;\0A    }\0A#else\0A    (void) restart_enabled;\0A#endif\0A\0A\0A#if defined(MBEDTLS_ECP_RESTARTABLE)\0A    if ((ret = ecdh_gen_public_restartable(&ctx->grp, &ctx->d, &ctx->Q,\0A                                           f_rng, p_rng, rs_ctx)) != 0) {\0A        return ret;\0A    }\0A#else\0A    if ((ret = mbedtls_ecdh_gen_public(&ctx->grp, &ctx->d, &ctx->Q,\0A                                       f_rng, p_rng)) != 0) {\0A        return ret;\0A    }\0A#endif /* MBEDTLS_ECP_RESTARTABLE */\0A\0A    if ((ret = mbedtls_ecp_tls_write_group(&ctx->grp, &grp_len, buf,\0A                                           blen)) != 0) {\0A        return ret;\0A    }\0A\0A    buf += grp_len;\0A    blen -= grp_len;\0A\0A    if ((ret = mbedtls_ecp_tls_write_point(&ctx->grp, &ctx->Q, point_format,\0A                                           &pt_len, buf, blen)) != 0) {\0A        return ret;\0A    }\0A\0A    *olen = grp_len + pt_len;\0A    return 0;\0A}\0A\0A/*\0A * Setup and write the ServerKeyExchange parameters (RFC 4492)\0A *      struct {\0A *          