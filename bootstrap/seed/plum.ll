A\0A    /*\0A     * Morally equivalent to updating ssl->state, but NewSessionTicket and\0A     * ChangeCipherSpec share the same state.\0A     */\0A    ssl->handshake->new_session_ticket = 0;\0A\0A    if ((ret = mbedtls_ssl_write_handshake_msg(ssl)) != 0) {\0A        MBEDTLS_SSL_DEBUG_RET(1, \22mbedtls_ssl_write_handshake_msg\22, ret);\0A        return ret;\0A    }\0A\0A    MBEDTLS_SSL_DEBUG_MSG(2, (\22<= write new session ticket\22));\0A\0A    return 0;\0A}\0A#endif /* MBEDTLS_SSL_SESSION_TICKETS */\0A\0A/*\0A * SSL handshake -- server side -- single step\0A */\0Aint mbedtls_ssl_handshake_server_step(mbedtls_ssl_context *ssl)\0A{\0A    int ret = 0;\0A\0A    MBEDTLS_SSL_DEBUG_MSG(2, (\22server state: %d\22, ssl->state));\0A\0A    switch (ssl->state) {\0A        case MBEDTLS_SSL_HELLO_REQUEST:\0A            ssl->state = MBEDTLS_SSL_CLIENT_HELLO;\0A            break;\0A\0A        /*\0A         *  <==   ClientHello\0A         */\0A        case MBEDTLS_SSL_CLIENT_HELLO:\0A            ret = ssl_parse_client_hello(ssl);\0A            break;\0A\0A#if defined(MBEDTLS_SSL_PROTO_DTLS)\0A        case MBEDTLS_SSL_SERVER_HELLO_VERIFY_REQUEST_SENT:\0A            return MBEDTLS_ERR_SSL_HELLO_VERIFY_REQUIRED;\0A#endif\0A\0A        /*\0A         *  ==>   ServerHello\0A         *        Certificate\0A         *      ( ServerKeyExchange  )\0A         *      ( CertificateRequest )\0A         *        ServerHelloDone\0A         */\0A        case MBEDTLS_SSL_SERVER_HELLO:\0A            ret = ssl_write_server_hello(ssl);\0A            break;\0A\0A        case MBEDTLS_SSL_SERVER_CERTIFICATE:\0A            ret = mbedtls_ssl_write_certificate(ssl);\0A            break;\0A\0A        case MBEDTLS_SSL_SERVER_KEY_EXCHANGE:\0A            ret = ssl_write_server_key_exchange(ssl);\0A            break;\0A\0A        case MBEDTLS_SSL_CERTIFICATE_REQUEST:\0A            ret = ssl_write_certificate_request(ssl);\0A            break;\0A\0A        case MBEDTLS_SSL_SERVER_HELLO_DONE:\0A            ret = ssl