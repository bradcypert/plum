@.str40083 = private global { i64, i64, [32567 x i8] } { i64 -1, i64 32566, [32567 x i8] c"/*\0A *  CTR_DRBG implementation based on AES-256 (NIST SP 800-90)\0A *\0A *  Copyright The Mbed TLS Contributors\0A *  SPDX-License-Identifier: Apache-2.0 OR GPL-2.0-or-later\0A */\0A/*\0A *  The NIST SP 800-90 DRBGs are described in the following publication.\0A *\0A *  https://nvlpubs.nist.gov/nistpubs/Legacy/SP/nistspecialpublication800-90r.pdf\0A */\0A\0A#include \22common.h\22\0A\0A#if defined(MBEDTLS_CTR_DRBG_C)\0A\0A#include \22ctr.h\22\0A#include \22mbedtls/ctr_drbg.h\22\0A#include \22mbedtls/platform_util.h\22\0A#include \22mbedtls/error.h\22\0A\0A#include <string.h>\0A\0A#if defined(MBEDTLS_FS_IO)\0A#include <stdio.h>\0A#endif\0A\0A/* Using error translation functions from PSA to MbedTLS */\0A#if defined(MBEDTLS_CTR_DRBG_USE_PSA_CRYPTO)\0A#include \22psa_util_internal.h\22\0A#endif\0A\0A#include \22mbedtls/platform.h\22\0A\0A#if defined(MBEDTLS_CTR_DRBG_USE_PSA_CRYPTO)\0Astatic psa_status_t ctr_drbg_setup_psa_context(mbedtls_ctr_drbg_psa_context *psa_ctx,\0A                                               unsigned char *key, size_t key_len)\0A{\0A    psa_key_attributes_t key_attr = PSA_KEY_ATTRIBUTES_INIT;\0A    psa_status_t status;\0A\0A    psa_set_key_usage_flags(&key_attr, PSA_KEY_USAGE_ENCRYPT);\0A    psa_set_key_algorithm(&key_attr, PSA_ALG_ECB_NO_PADDING);\0A    psa_set_key_type(&key_attr, PSA_KEY_TYPE_AES);\0A    status = psa_import_key(&key_attr, key, key_len, &psa_ctx->key_id);\0A    if (status != PSA_SUCCESS) {\0A        goto exit;\0A    }\0A\0A    status = psa_cipher_encrypt_setup(&psa_ctx->operation, psa_ctx->key_id, PSA_ALG_ECB_NO_PADDING);\0A    if (status != PSA_SUCCESS) {\0A        goto exit;\0A    }\0A\0Aexit:\0A    psa_reset_key_attributes(&key_attr);\0A    return status;\0A}\0A\0Astatic void ctr_drbg_destroy_psa_contex(mbedtls_ctr_drbg_psa_context *psa_ctx)\0A{\0A    psa_cipher_abort(&psa_ctx->operation);\0A    psa_destroy_key(psa_ctx->key_id);\0A\0A    psa_ctx->operation = psa_cipher_operation_init();\0A    psa_ctx->key_id = MBEDTLS_SVC_KEY_ID_INIT;\0A}\0A#endif\0A\0A/*\0A * CTR_DRBG context initialization\0A */\0Avoid mbedtls_ctr_drbg_init(mbedtls_ctr_drbg_context *ctx)\0A{\0A    memset(ctx, 0, sizeof(mbedtls_ctr_drbg_context));\0A#if defined(MBEDTLS_CTR_DRBG_USE_PSA_CRYPTO)\0A    ctx->psa_ctx.key_id = MBEDTLS_SVC_KEY_ID_INIT;\0A    ctx->psa_ctx.operation = psa_cipher_operation_init();\0A#else\0A    mbedtls_aes_init(&ctx->aes_ctx);\0A#endif\0A    /* Indicate that the entropy nonce length is not set explicitly.\0A     * See mbedtls_ctr_drbg_set_nonce_len(). */\0A    ctx->reseed_counter = -1;\0A\0A    ctx->reseed_interval = MBEDTLS_CTR_DRBG_RESEED_INTERVAL;\0A}\0A\0A/*\0A *  This function resets CTR_DRBG context to the state immediately\0A *  after initial call of mbedtls_ctr_drbg_init().\0A */\0Avoid mbedtls_ctr_drbg_free(mbedtls_ctr_drbg_context *ctx)\0A{\0A    if (ctx == NULL) {\0A        return;\0A    }\0A\0A#if defined(MBEDTLS_THREADING_C)\0A    /* The mutex is initialized iff f_entropy is set. */\0A    if (ctx->f_entropy != NULL) {\0A        mbedtls_mutex_free(&ctx->mutex);\0A    }\0A#endif\0A#if defined(MBEDTLS_CTR_DRBG_USE_PSA_CRYPTO)\0A    ctr_drbg_destroy_psa_contex(&ctx->psa_ctx);\0A#else\0A    mbedtls_aes_free(&ctx->aes_ctx);\0A#endif\0A    mbedtls_platform_zeroize(ctx, sizeof(mbedtls_ctr_drbg_context));\0A    ctx->reseed_interval = MBEDTLS_CTR_DRBG_RESEED_INTERVAL;\0A    ctx->reseed_counter = -1;\0A}\0A\0Avoid mbedtls_ctr_drbg_set_prediction_resistance(mbedtls_ctr_drbg_context *ctx,\0A                                                int resistance)\0A{\0A    ctx->prediction_resistance = resistance;\0A}\0A\0Avoid mbedtls_ctr_drbg_set_entropy_len(mbedtls_ctr_drbg_context *ctx,\0A                                      size_t len)\0A{\0A    ctx->entropy_len = len;\0A}\0A\0Aint mbedtls_ctr_drbg_set_nonce_len(mbedtls_ctr_drbg_context *ctx,\0A                                   size_t len)\0A{\0A    /* If mbedtls_ctr_drbg_seed() has already been called, it's\0A     * too late. Return the error code that's closest to making sense. */\0A    if (ctx->f_entropy != NULL) {\0A        return MBEDTLS_ERR_CTR_DRBG_ENTROPY_SOURCE_FAILED;\0A    }\0A\0A    if (len > MBEDTLS_CTR_DRBG_MAX_SEED_INPUT) {\0A        return MBEDTLS_ERR_CTR_DRBG_INPUT_TOO_BIG;\0A    }\0A\0A    /* This shouldn't be an issue because\0A     * MBEDTLS_CTR_DRBG_MAX_SEED_INPUT < INT_MAX in any sensible\0A     * configuration, but make sure anyway. */\0A    if (len > INT_MAX) {\0A        return MBEDTLS_ERR_CTR_DRBG_INPUT_TOO_BIG;\0A    }\0A\0A    /* For backward compatibility with Mbed TLS <= 2.19, store the\0A     * entropy nonce length in a field that already exists, but isn't\0A     * used until after the initial seeding. */\0A    /* Due to the capping of len above, the value fits in an int. */\0A    ctx->reseed_counter = (int) len;\0A    return 0;\0A}\0A\0Avoid mbedtls_ctr_drbg_set_reseed_interval(mbedtls_ctr_drbg_context *ctx,\0A                                          int interval)\0A{\0A    ctx->reseed_interval = interval;\0A}\0A\0Astatic int block_cipher_df(unsigned char *output,\0A                           const unsigned char *data, size_t data_len)\0A{\0A    unsigned char buf[MBEDTLS_CTR_DRBG_MAX_SEED_INPUT +\0A                      MBEDTLS_CTR_DRBG_BLOCKSIZE + 16];\0A    unsigned char tmp[MBEDTLS_CTR_DRBG_SEEDLEN];\0A    unsigned char key[MBEDTLS_CTR_DRBG_KEYSIZE];\0A    unsigned char chain[MBEDTLS_CTR_DRBG_BLOCKSIZE];\0A    unsigned char *p, *iv;\0A    int ret = 0;\0A#if defined(MBEDTLS_CTR_DRBG_USE_PSA_CRYPTO)\0A    psa_status_t status;\0A    size_t tmp_len;\0A    mbedtls_ctr_drbg_psa_context psa_ctx;\0A\0A    psa_ctx.key_id = MBEDTLS_SVC_KEY_ID_INIT;\0A    psa_ctx.operation = psa_cipher_operation_init();\0A#else\0A    mbedtls_aes_context aes_ctx;\0A#endif\0A\0A    int i, j;\0A    size_t buf_len, use_len;\0A\0A    if (data_len > MBEDTLS_CTR_DRBG_MAX_SEED_INPUT) {\0A        return MBEDTLS_ERR_CTR_DRBG_INPUT_TOO_BIG;\0A    }\0A\0A    memset(buf, 0, MBEDTLS_CTR_DRBG_MAX_SEED_INPUT +\0A           MBEDTLS_CTR_DRBG_BLOCKSIZE + 16);\0A\0A    /*\0A     * Construct IV (16 bytes) and S in buffer\0A     * IV = Counter (in 32-bits) padded to 16 with zeroes\0A     * S = Length input string (in 32-bits) || Length of output (in 32-bits) ||\0A     *     data || 0x80\0A     *     (Total is padded to a multiple of 16-bytes with zeroes)\0A     */\0A    p = buf + MBEDTLS_CTR_DRBG_BLOCKSIZE;\0A    MBEDTLS_PUT_UINT32_BE(data_len, p, 0);\0A    p += 4 + 3;\0A    *p++ = MBEDTLS_CTR_DRBG_SEEDLEN;\0A    memcpy(p, data, data_len);\0A    p[data_len] = 0x80;\0A\0A    buf_len = MBEDTLS_CTR_DRBG_BLOCKSIZE + 8 + data_len + 1;\0A\0A    for (i = 0; i < MBEDTLS_CTR_DRBG_KEYSIZE; i++) {\0A        key[i] = i;\0A    }\0A\0A#if defined(MBEDTLS_CTR_DRBG_USE_PSA_CRYPTO)\0A    status = ctr_drbg_setup_psa_context(&psa_ctx, key, sizeof(key));\0A    if (status != PSA_SUCCESS) {\0A        ret = psa_generic_status_to_mbedtls(status);\0A        goto exit;\0A    }\0A#else\0A    mbedtls_aes_init(&aes_ctx);\0A\0A    if ((ret = mbedtls_aes_setkey_enc(&aes_ctx, key,\0A                                      MBEDTLS_CTR_DRBG_KEYBITS)) != 0) {\0A        goto exit;\0A    }\0A#endif\0A\0A    /*\0A     * Reduce data to MBEDTLS_CTR_DRBG_SEEDLEN bytes of data\0A     */\0A    for (j = 0; j < MBEDTLS_CTR_DRBG_SEEDLEN; j += MBEDTLS_CTR_DRBG_BLOCKSIZE) {\0A        p = buf;\0A        memset(chain, 0, MBEDTLS_CTR_DRBG_BLOCKSIZE);\0A        use_len = buf_len;\0A\0A        while (use_len > 0) {\0A            mbedtls_xor(chain, chain, p, MBEDTLS_CTR_DRBG_BLOCKSIZE);\0A            p += MBEDTLS_CTR_DRBG_BLOCKSIZE;\0A            use_len -= (use_len >= MBEDTLS_CTR_DRBG_BLOCKSIZE) ?\0A                       MBEDTLS_CTR_DRBG_BLOCKSIZE : use_len;\0A\0A#if defined(MBEDTLS_CTR_DRBG_USE_PSA_CRYPTO)\0A            status = psa_cipher_update(&psa_ctx.operation, chain, MBEDTLS_CTR_DRBG_BLOCKSIZE,\0A                                       chain, MBEDTLS_CTR_DRBG_BLOCKSIZE, &tmp_len);\0A            if (status != PSA_SUCCESS) {\0A                ret = psa_generic_status_to_mbedtls(status);\0A                goto exit;\0A            }\0A#else\0A            if ((ret = mbedtls_aes_crypt_ecb(&aes_ctx, MBEDTLS_AES_ENCRYPT,\0A                                             chain, chain)) != 0) {\0A                goto exit;\0A            }\0A#endif\0A        }\0A\0A        memcpy(tmp + j, chain, MBEDTLS_CTR_DRBG_BLOCKSIZE);\0A\0A        /*\0A         * Update IV\0A         */\0A        buf[3]++;\0A    }\0A\0A    /*\0A     * Do final encryption with reduced data\0A     */\0A#if defined(MBEDTLS_CTR_DRBG_USE_PSA_CRYPTO)\0A    ctr_drbg_destroy_psa_contex(&psa_ctx);\0A\0A    status = ctr_drbg_setup_psa_context(&psa_ctx, tmp, MBEDTLS_CTR_DRBG_KEYSIZE);\0A    if (status != PSA_SUCCESS) {\0A        ret = psa_generic_status_to_mbedtls(status);\0A        goto exit;\0A    }\0A#else\0A    if ((ret = mbedtls_aes_setkey_enc(&aes_ctx, tmp,\0A                                      MBEDTLS_CTR_DRBG_KEYBITS)) != 0) {\0A        goto exit;\0A    }\0A#endif\0A    iv = tmp + MBEDTLS_CTR_DRBG_KEYSIZE;\0A    p = output;\0A\0A    for (j = 0; j < MBEDTLS_CTR_DRBG_SEEDLEN; j += MBEDTLS_CTR_DRBG_BLOCKSIZE) {\0A#if defined(MBEDTLS_CTR_DRBG_USE_PSA_CRYPTO)\0A        status = psa_cipher_update(&psa_ctx.operation, iv, MBEDTLS_CTR_DRBG_BLOCKSIZE,\0A                                   iv, MBEDTLS_CTR_DRBG_BLOCKSIZE, &tmp_len);\0A        if (status != PSA_SUCCESS) {\0A            ret = psa_generic_status_to_mbedtls(status);\0A            goto exit;\0A        }\0A#else\0A        if ((ret = mbedtls_aes_crypt_ecb(&aes_ctx, MBEDTLS_AES_ENCRYPT,\0A                                         iv, iv)) != 0) {\0A            goto exit;\0A        }\0A#endif\0A        memcpy(p, iv, MBEDTLS_CTR_DRBG_BLOCKSIZE);\0A        p += MBEDTLS_CTR_DRBG_BLOCKSIZE;\0A    }\0Aexit:\0A#if defined(MBEDTLS_CTR_DRBG_USE_PSA_CRYPTO)\0A    ctr_drbg_destroy_psa_contex(&psa_ctx);\0A#else\0A    mbedtls_aes_free(&aes_ctx);\0A#endif\0A    /*\0A     * tidy up the stack\0A     */\0A    mbedtls_platform_zeroize(buf, sizeof(buf));\0A    mbedtls_platform_zeroize(tmp, sizeof(tmp));\0A    mbedtls_platform_zeroize(key, sizeof(key));\0A    mbedtls_platform_zeroize(chain, sizeof(chain));\0A    if (0 != ret) {\0A        /*\0A         * wipe partial seed from memory\0A         */\0A        mbedtls_platform_zeroize(output, MBEDTLS_CTR_DRBG_SEEDLEN);\0A    }\0A\0A    return ret;\0A}\0A\0A/* CTR_DRBG_Update (SP 800-90A &sect;10.2.1.2)\0A * ctr_drbg_update_internal(ctx, provided_data)\0A * implements\0A * CTR_DRBG_Update(provided_data, Key, V)\0A * with inputs and outputs\0A *   ctx->aes_ctx = Key\0A *   ctx->counter = V\0A */\0Astatic int ctr_drbg_update_internal(mbedtls_ctr_drbg_context *ctx,\0A                                    const unsigned char data[MBEDTLS_CTR_DRBG_SEEDLEN])\0A{\0A    unsigned char tmp[MBEDTLS_CTR_DRBG_SEEDLEN];\0A    unsigned char *p = tmp;\0A    int j;\0A    int ret = 0;\0A#if defined(MBEDTLS_CTR_DRBG_USE_PSA_CRYPTO)\0A    psa_status_t status;\0A    size_t tmp_len;\0A#endif\0A\0A    memset(tmp, 0, MBEDTLS_CTR_DRBG_SEEDLEN);\0A\0A    for (j = 0; j < MBEDTLS_CTR_DRBG_SEEDLEN; j += MBEDTLS_CTR_DRBG_BLOCKSIZE) {\0A        /*\0A         * Increase counter\0A         */\0A        mbedtls_ctr_increment_counter(ctx->counter);\0A\0A        /*\0A         * Crypt counter block\0A         */\0A#if defined(MBEDTLS_CTR_DRBG_USE_PSA_CRYPTO)\0A        status = psa_cipher_update(&ctx->psa_ctx.operation, ctx->counter, sizeof(ctx->counter),\0A                                   p, MBEDTLS_CTR_DRBG_BLOCKSIZE, &tmp_len);\0A        if (status != PSA_SUCCESS) {\0A            ret = psa_generic_status_to_mbedtls(status);\0A            goto exit;\0A        }\0A#else\0A        if ((ret = mbedtls_aes_crypt_ecb(&ctx->aes_ctx, MBEDTLS_AES_ENCRYPT,\0A                                         ctx->counter, p)) != 0) {\0A            goto exit;\0A        }\0A#endif\0A\0A        p += MBEDTLS_CTR_DRBG_BLOCKSIZE;\0A    }\0A\0A    mbedtls_xor(tmp, tmp, data, MBEDTLS_CTR_DRBG_SEEDLEN);\0A\0A    /*\0A     * Update key and counter\0A     */\0A#if defined(MBEDTLS_CTR_DRBG_USE_PSA_CRYPTO)\0A    ctr_drbg_destroy_psa_contex(&ctx->psa_ctx);\0A\0A    status = ctr_drbg_setup_psa_context(&ctx->psa_ctx, tmp, MBEDTLS_CTR_DRBG_KEYSIZE);\0A    if (status != PSA_SUCCESS) {\0A        ret = psa_generic_status_to_mbedtls(status);\0A        goto exit;\0A    }\0A#else\0A    if ((ret = mbedtls_aes_setkey_enc(&ctx->aes_ctx, tmp,\0A                                      MBEDTLS_CTR_DRBG_KEYBITS)) != 0) {\0A        goto exit;\0A    }\0A#endif\0A    memcpy(ctx->counter, tmp + MBEDTLS_CTR_DRBG_KEYSIZE,\0A           MBEDTLS_CTR_DRBG_BLOCKSIZE);\0A\0Aexit:\0A    mbedtls_platform_zeroize(tmp, sizeof(tmp));\0A    return ret;\0A}\0A\0A/* CTR_DRBG_Instantiate with derivation function (SP 800-90A &sect;10.2.1.3.2)\0A * mbedtls_ctr_drbg_update(ctx, additional, add_len)\0A * implements\0A * CTR_DRBG_Instantiate(entropy_input, nonce, personalization_string,\0A *                      security_strength) -> initial_working_state\0A * with inputs\0A *   ctx->counter = all-bits-0\0A *   ctx->aes_ctx = context from all-bits-0 key\0A *   additional[:add_len] = entropy_input || nonce || personalization_string\0A * and with outputs\0A *   ctx = initial_working_state\0A */\0Aint mbedtls_ctr_drbg_update(mbedtls_ctr_drbg_context *ctx,\0A                            const unsigned char *additional,\0A                            size_t add_len)\0A{\0A    unsigned char add_input[MBEDTLS_CTR_DRBG_SEEDLEN];\0A    int ret = MBEDTLS_ERR_ERROR_CORRUPTION_DETECTED;\0A\0A    if (add_len == 0) {\0A        return 0;\0A    }\0A\0A    if ((ret = block_cipher_df(add_input, additional, add_len)) != 0) {\0A        goto exit;\0A    }\0A    if ((ret = ctr_drbg_update_internal(ctx, add_input)) != 0) {\0A        goto exit;\0A    }\0A\0Aexit:\0A    mbedtls_platform_zeroize(add_input, sizeof(add_input));\0A    return ret;\0A}\0A\0A/* CTR_DRBG_Reseed with derivation function (SP 800-90A &sect;10.2.1.4.2)\0A * mbedtls_ctr_drbg_reseed(ctx, additional, len, nonce_len)\0A * implements\0A * CTR_DRBG_Reseed(working_state, entropy_input, additional_input)\0A *                -> new_working_state\0A * with inputs\0A *   ctx contains working_state\0A *   additional[:len] = additional_input\0A * and entropy_input comes from calling ctx->f_entropy\0A *                              for (ctx->entropy_len + nonce_len) bytes\0A * and with output\0A *   ctx contains new_working_state\0A */\0Astatic int mbedtls_ctr_drbg_reseed_internal(mbedtls_ctr_drbg_context *ctx,\0A                                            const unsigned char *additional,\0A                                            size_t len,\0A                                            size_t nonce_len)\0A{\0A    unsigned char seed[MBEDTLS_CTR_DRBG_MAX_SEED_INPUT];\0A    size_t seedlen = 0;\0A    int ret = MBEDTLS_ERR_ERROR_CORRUPTION_DETECTED;\0A\0A    if (ctx->entropy_len > MBEDTLS_CTR_DRBG_MAX_SEED_INPUT) {\0A        return MBEDTLS_ERR_CTR_DRBG_INPUT_TOO_BIG;\0A    }\0A    if (nonce_len > MBEDTLS_CTR_DRBG_MAX_SEED_INPUT - ctx->entropy_len) {\0A        return MBEDTLS_ERR_CTR_DRBG_INPUT_TOO_BIG;\0A    }\0A    if (len > MBEDTLS_CTR_DRBG_MAX_SEED_INPUT - ctx->entropy_len - nonce_len) {\0A        return MBEDTLS_ERR_CTR_DRBG_INPUT_TOO_BIG;\0A    }\0A\0A    memset(seed, 0, MBEDTLS_CTR_DRBG_MAX_SEED_INPUT);\0A\0A    /* Gather entropy_len bytes of entropy to seed state. */\0A    if (0 != ctx->f_entropy(ctx->p_entropy, seed, ctx->entropy_len)) {\0A        return MBEDTLS_ERR_CTR_DRBG_ENTROPY_SOURCE_FAILED;\0A    }\0A    seedlen += ctx->entropy_len;\0A\0A    /* Gather entropy for a nonce if requested. */\0A    if (nonce_len != 0) {\0A        if (0 != ctx->f_entropy(ctx->p_entropy, seed + seedlen, nonce_len)) {\0A            return MBEDTLS_ERR_CTR_DRBG_ENTROPY_SOURCE_FAILED;\0A        }\0A        seedlen += nonce_len;\0A    }\0A\0A    /* Add additional data if provided. */\0A    if (additional != NULL && len != 0) {\0A        memcpy(seed + seedlen, additional, len);\0A        seedlen += len;\0A    }\0A\0A    /* Reduce to 384 bits. */\0A    if ((ret = block_cipher_df(seed, seed, seedlen)) != 0) {\0A        goto exit;\0A    }\0A\0A    /* Update state. */\0A    if ((ret = ctr_drbg_update_internal(ctx, seed)) != 0) {\0A        goto exit;\0A    }\0A    ctx->reseed_counter = 1;\0A\0Aexit:\0A    mbedtls_platform_zeroize(seed, sizeof(seed));\0A    return ret;\0A}\0A\0Aint mbedtls_ctr_drbg_reseed(mbedtls_ctr_drbg_context *ctx,\0A                            const unsigned char *additional, size_t len)\0A{\0A    return mbedtls_ctr_drbg_reseed_internal(ctx, additional, len, 0);\0A}\0A\0A/* Return a \22good\22 nonce length for CTR_DRBG. The chosen nonce length\0A * is sufficient to achieve the maximum security strength given the key\0A * size and entropy length. If there is enough entropy in the initial\0A * call to the entropy function to serve as both the entropy input and\0A * the nonce, don't make a second call to get a nonce. */\0Astatic size_t good_nonce_len(size_t entropy_len)\0A{\0A    if (entropy_len >= MBEDTLS_CTR_DRBG_KEYSIZE * 3 / 2) {\0A        return 0;\0A    } else {\0A        return (entropy_len + 1) / 2;\0A    }\0A}\0A\0A/* CTR_DRBG_Instantiate with derivation function (SP 800-90A &sect;10.2.1.3.2)\0A * mbedtls_ctr_drbg_seed(ctx, f_entropy, p_entropy, custom, len)\0A * implements\0A * CTR_DRBG_Instantiate(entropy_input, nonce, personalization_string,\0A *                      security_strength) -> initial_working_state\0A * with inputs\0A *   custom[:len] = nonce || personalization_string\0A * where entropy_input comes from f_entropy for ctx->entropy_len bytes\0A * and with outputs\0A *   ctx = initial_working_state\0A */\0Aint mbedtls_ctr_drbg_seed(mbedtls_ctr_drbg_context *ctx,\0A                          int (*f_entropy)(void *, unsigned char *, size_t),\0A                          void *p_entropy,\0A                          const unsigned char *custom,\0A                          size_t len)\0A{\0A    int ret = MBEDTLS_ERR_ERROR_CORRUPTION_DETECTED;\0A    unsigned char key[MBEDTLS_CTR_DRBG_KEYSIZE];\0A    size_t nonce_len;\0A\0A    memset(key, 0, MBEDTLS_CTR_DRBG_KEYSIZE);\0A\0A    /* The mutex is initialized iff f_entropy is set. */\0A#if defined(MBEDTLS_THREADING_C)\0A    mbedtls_mutex_init(&ctx->mutex);\0A#endif\0A\0A    ctx->f_entropy = f_entropy;\0A    ctx->p_entropy = p_entropy;\0A\0A    if (ctx->entropy_len == 0) {\0A        ctx->entropy_len = MBEDTLS_CTR_DRBG_ENTROPY_LEN;\0A    }\0A    /* ctx->reseed_counter contains the desired amount of entropy to\0A     * grab for a nonce (see mbedtls_ctr_drbg_set_nonce_len()).\0A     * If it's -1, indicating that the entropy nonce length was not set\0A     * explicitly, use a sufficiently large nonce for security. */\0A    nonce_len = (ctx->reseed_counter >= 0 ?\0A                 (size_t) ctx->reseed_counter :\0A                 good_nonce_len(ctx->entropy_len));\0A\0A    /* Initialize with an empty key. */\0A#if defined(MBEDTLS_CTR_DRBG_USE_PSA_CRYPTO)\0A    psa_status_t status;\0A\0A    status = ctr_drbg_setup_psa_context(&ctx->psa_ctx, key, MBEDTLS_CTR_DRBG_KEYSIZE);\0A    if (status != PSA_SUCCESS) {\0A        ret = psa_generic_status_to_mbedtls(status);\0A        return status;\0A    }\0A#else\0A    if ((ret = mbedtls_aes_setkey_enc(&ctx->aes_ctx, key,\0A                                      MBEDTLS_CTR_DRBG_KEYBITS)) != 0) {\0A        return ret;\0A    }\0A#endif\0A\0A    /* Do the initial seeding. */\0A    if ((ret = mbedtls_ctr_drbg_reseed_internal(ctx, custom, len,\0A                                                nonce_len)) != 0) {\0A        return ret;\0A    }\0A    return 0;\0A}\0A\0A/* CTR_DRBG_Generate with derivation function (SP 800-90A &sect;10.2.1.5.2)\0A * mbedtls_ctr_drbg_random_with_add(ctx, output, output_len, additional, add_len)\0A * implements\0A * CTR_DRBG_Reseed(working_state, en