@.str55468 = private global { i64, i64, [23905 x i8] } { i64 -1, i64 23904, [23905 x i8] c"/// Filesystem and self-location. These replaced shelling out to\0A/// `mktemp -d`, `rm -rf`, `rm -f`, `cp -r` and `mkdir`, and reading\0A/// `/proc/self/exe`. See `native_stdlib/os_shim.c`.\0A///\0A/// The `..._raw` forms are runtime primitives whose Plum bodies\0A/// exist only to give the checker a signature. They travel with the\0A/// module: `cg_runtime_fn` keys on the bare name and does not care\0A/// which module the call was written in.\0Alet os_temp_dir_raw (ignored: Bool): String = \22\22\0Alet os_self_exe_raw (ignored: Bool): String = \22\22\0Alet os_make_dir_raw (path: String): Int = 0\0Alet os_remove_file_raw (path: String): Int = 0\0Alet os_rename_file_raw (from: String) (to: String): Int = 0\0Alet os_remove_tree_raw (path: String): Int = 0\0Alet os_copy_tree_raw (src: String) (dst: String): Int = 0\0Alet os_platform_raw (ignored: Bool): String = \22\22\0A\0A/// Which platform this program is running on: \22linux\22, \22macos\22 or\0A/// \22windows\22. Compiled in, not detected at runtime; a binary\0A/// cannot move between platforms, so there is nothing to detect.\0Apub let platform (): String = os_platform_raw(true)\0A\0A/// A fresh, empty, private directory. The caller owns it and is\0A/// responsible for `Os.remove_tree` on it.\0Apub let temp_dir (): Result[String, String] = {\0A    let d = os_temp_dir_raw(true);\0A    if String.is_empty(d) { Err(\22Os.temp_dir: could not create a temporary directory\22) }\0A    else { Ok(d) }\0A}\0A\0A/// The path of the running executable, for a program that needs to\0A/// re-invoke itself.\0Apub let self_exe (): Result[String, String] = {\0A    let p = os_self_exe_raw(true);\0A    if String.is_empty(p) { Err(\22Os.self_exe: could not determine the executable path\22) }\0A    else { Ok(p) }\0A}\0A\0A/// Creates one directory. The PARENT must already exist; this makes a\0A/// single level, not a path.\0A///\0A/// `Err` when the parent is missing, when the name is taken by a file,\0A/// or when permission is refused. A directory that already exists is\0A/// also an `Err`, so a caller who does not care should check\0A/// `Os.exists` first.\0Apub let make_dir (path: String): Result[Unit, String] =\0A    if os_make_dir_raw(path) == 0 { Ok(()) }\0A    else { Err(\22Os.make_dir: could not create \22.concat(path)) }\0A\0A/// Atomic within one filesystem, and an error rather than a silent\0A/// copy across two. The point is that the destination is never a\0A/// half-written file.\0Apub let rename_file (from: String) (to: String): Result[Unit, String] =\0A    if os_rename_file_raw(from, to) == 0 { Ok(()) }\0A    else { Err(\22Os.rename_file: could not rename \22.concat(from).concat(\22 to \22).concat(to)) }\0A\0A/// Deletes a file. `Err` when it is not there, when it is a directory,\0A/// or when permission is refused — `Os.remove_tree` is the one for\0A/// directories.\0Apub let remove_file (path: String): Result[Unit, String] =\0A    if os_remove_file_raw(path) == 0 { Ok(()) }\0A    else { Err(\22Os.remove_file: could not remove \22.concat(path)) }\0A\0A/// Deletes a file or directory tree. A final symlink is removed even\0A/// with trailing separators; links encountered in the tree are never\0A/// followed. Ancestors of the requested path resolve normally when the\0A/// starting directory is acquired; traversal then uses held directories.\0A/// Concurrent changes or resource exhaustion can return `Err` after partial\0A/// removal. Traversal is limited to 128 directory levels to bound native\0A/// stack, enumeration storage, and open handles. Empty paths and final\0A/// `.` or `..` components are rejected.\0Apub let remove_tree (path: String): Result[Unit, String] =\0A    if os_remove_tree_raw(path) == 0 { Ok(()) }\0A    else { Err(\22Os.remove_tree: could not remove \22.concat(path)) }\0A\0A/// Copies the CONTENTS of `src` into `dst`, which must already exist\0A/// and must not overlap `src`. Returns `Err` for identical or nested\0A/// directories before changing `dst`. File modes are not preserved.\0Apub let copy_tree (src: String) (dst: String): Result[Unit, String] =\0A    if os_copy_tree_raw(src, dst) == 0 { Ok(()) }\0A    else { Err(\22Os.copy_tree: could not copy \22.concat(src).concat(\22 to \22).concat(dst)) }\0A\0A// --- Environment and process ---\0A//\0A// Folded in from the flat prelude in 0.0.9. `Os` already owned the\0A// filesystem calls that shell out to `os_shim.c`, so putting\0A// `read_file` in a separate `Fs` would have split the filesystem\0A// across two modules. This is the shape Go settled on -- `os.ReadFile`,\0A// `os.Getenv`, `os.Exit`, `os.MkdirAll` in one place, with `net`\0A// separate and string helpers on the type.\0A\0Alet exit_raw (code: Int): Bool = false\0Alet env_var_raw (name: String): Array[String] = []\0A\0A/// Exit with a status code, printing nothing. `panic_raw` also exits\0A/// non-zero but prints its message first, which is wrong when the\0A/// report has already been written.\0Apub let exit_with (code: Int): Unit = { exit_raw(code); () }\0A\0A/// `env_var_raw` returns an ARRAY, empty when unset, matching\0A/// `read_file_raw`: hand-written runtime IR cannot construct an\0A/// `Option` without hard-coding tag numbers the backend assigns per\0A/// program, so the wrapping happens here where `Some`/`None` are\0A/// ordinary variants.\0Apub let env_var (name: String): Option[String] = {\0A    let r = env_var_raw(name);\0A    if Array.is_empty(r) { None } else { Some(r[0]) }\0A}\0A\0A// --- Whole-file I/O ---\0A\0Alet write_file_raw (path: String) (contents: String): Bool = false\0A\0A/// Reads a whole seekable file as text.\0A///\0A/// `Err` when the file is missing, unreadable, or not valid UTF-8. Use\0A/// `Os.read_bytes` for a file that is not text, or that might not be.\0A/// A failed or incomplete read returns `Err`, never a partial string.\0Apub let read_file (path: String): Result[String, String] =\0A    match read_bytes(path) {\0A        Err(e) => Err(e),\0A        Ok(b) => match b.as_string() {\0A            Ok(s) => Ok(s),\0A            Err(_) => Err(\22could not read \22.concat(path)),\0A        },\0A    }\0A\0A/// Writes text to a file, creating it or REPLACING what was there.\0A///\0A/// The parent directory must exist. Returns `Err` if opening, writing,\0A/// or closing fails. A failure can leave a truncated or partially written file.\0Apub let write_file (path: String) (contents: String): Result[Unit, String] =\0A    if write_file_raw(path, contents) { Ok(()) } else { Err(\22could not write \22.concat(path)) }\0A\0A/// --- Whole-file BINARY I/O ---\0A///\0A/// The `String` pair above keeps its contract exactly: it is the text\0A/// convenience, and a program that wants text should keep using it.\0A/// These are for the payloads a `String` cannot honestly describe --\0A/// images, compressed data, anything with an embedded NUL or a byte\0A/// that is not valid UTF-8.\0A///\0A/// Both readers use the same checked byte read. `read_file` then\0A/// validates UTF-8 through `Bytes.as_string`, which shares the byte\0A/// cell without copying it. Binary reads preserve every byte.\0A///\0A/// `read_file_bytes_raw` returns an ARRAY because hand-written runtime\0A/// IR cannot construct a `Result` without hard-coding tag numbers the\0A/// backend assigns per program, so the wrapping happens here.\0Alet read_file_bytes_raw (path: String): Array[Bytes] = []\0Alet write_file_bytes_raw (path: String) (contents: Bytes): Bool = false\0Alet append_file_bytes_raw (path: String) (contents: Bytes): Bool = false\0A\0A/// Reads a whole seekable file as bytes. An empty file returns empty\0A/// `Bytes`. Opening, sizing, temporary buffer allocation, incomplete\0A/// reads, I/O errors, and close failures return `Err`, never a partial buffer.\0Apub let read_bytes (path: String): Result[Bytes, String] = {\0A    let r = read_file_bytes_raw(path);\0A    if Array.is_empty(r) { Err(\22could not read \22.concat(path)) } else { Ok(r[0]) }\0A}\0A\0A/// Writes bytes to a file, creating it or REPLACING what was there.\0A///\0A/// The `Bytes` counterpart to `Os.write_file`: use this for anything\0A/// that is not text, and for text you have already encoded.\0Apub let write_bytes (path: String) (data: Bytes): Result[Unit, String] =\0A    if write_file_bytes_raw(path, data) { Ok(()) } else { Err(\22could not write \22.concat(path)) }\0A\0A/// Creates the file when it does not exist, the way `>>` does.\0Apub let append_bytes (path: String) (data: Bytes): Result[Unit, String] =\0A    if append_file_bytes_raw(path, data) { Ok(()) } else { Err(\22could not append to \22.concat(path)) }\0A\0A// --- Streaming file I/O ---\0A//\0A// The whole-file calls above are the convenience: one call, no\0A// handle, no cleanup to think about. These are for the cases a\0A// whole-file read cannot serve -- a file too big to hold, a stream\0A// consumed as it arrives, an append-only log kept open.\0A//\0A// `File` is a `handle` (issue #9), so an open file CLOSES ITSELF\0A// when the value dies. `File.close` is still offered, and still\0A// returns a `Result`, because closing can fail -- a buffered write\0A// is flushed by `fclose`, and that is exactly when a full disk is\0A// discovered. So: call `close` when the error matters, and rely on\0A// the handle when it does not. Neither leaks.\0A//\0A// Closing twice is fine and is the NORMAL path, since the handle\0A// runs after an explicit close. `native_stdlib/file_shim.c` owns a\0A// slot table precisely so the second one is harmless.\0Aextern \22C\22 {\0A    fn file_open(path: CStr, mode: Int) -> Int;\0A    fn file_close(h: Int);\0A    fn file_close_checked(h: Int) -> Int;\0A    fn file_read_n(h: Int, max_len: Int) -> Int;\0A    fn file_read_data() -> CStr;\0A    fn file_write(h: Int, buf: CStr, len: Int) -> Int;\0A    fn file_seek(h: Int, offset: Int, whence: Int) -> Int;\0A    fn file_flush(h: Int) -> Int;\0A}\0A\0A/// An open file. **Closed when this value dies**, including on a\0A/// panic, so a file opened in a scope needs no cleanup.\0A///\0A/// `File.close` is still offered and still returns a `Result`, because\0A/// closing can fail: a buffered write is flushed by the close, and that\0A/// is exactly when a full disk is discovered. Call it when that error\0A/// matters; rely on the handle when it does not. Closing twice is\0A/// harmless.\0Apub handle File { on_drop: file_close }\0A\0A/// How to open. A closed set, passed as small integers across the\0A/// extern boundary; an extern taking a mode STRING would let a\0A/// caller hand `fopen` anything at all.\0Apub enum Mode { Read, Write, Append }\0A\0A/// Where a seek measures from.\0Apub enum Seek { Start, Current, End }\0A\0Alet mode_code (m: Mode): Int = match m { Read => 0, Write => 1, Append => 2 }\0Alet seek_code (s: Seek): Int = match s { Start => 0, Current => 1, End => 2 }\0A\0A/// `Write` truncates an existing file; `Append` does not. Both create\0A/// one that is not there, and `Read` does not.\0Apub let open (path: String) (mode: Mode): Result[File, String] = unsafe {\0A    let h = file_open(path.as_cstr(), mode_code(mode));\0A    if h < 0 { Err(\22Os.open: could not open \22.concat(path)) } else { Ok(File.from_raw(h)) }\0A}\0A\0A/// Up to `max_len` bytes. An empty result is END OF FILE, not a\0A/// failure: the same three-way split `Net.read_bytes` makes, and\0A/// for the same reason: a reader looping until the end needs to tell\0A/// \22nothing left\22 from \22something broke\22.\0A/// `max_len` must be positive; zero or negative sizes return `Err`\0A/// without consuming input, even at end of file.\0Apub let File.read (f: File) (max_len: Int): Result[Bytes, String] = unsafe {\0A    let n = file_read_n(File.raw(f), max_len);\0A    if n < 0 { Err(\22File.read: read failed\22) }\0A    else { Ok(Bytes.from_cstr(file_read_data(), n)) }\0A}\0A\0A/// `len` MUST be bound BEFORE `.as_cstr()` runs, the same ordering\0A/// `Net