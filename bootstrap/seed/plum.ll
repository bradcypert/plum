lot_idx = selected_slot - global_data.key_slots;\0A            *volatile_key_id = PSA_KEY_ID_VOLATILE_MIN + slot_idx;\0A        }\0A#endif\0A        *p_slot = selected_slot;\0A\0A        return PSA_SUCCESS;\0A    }\0A    status = PSA_ERROR_INSUFFICIENT_MEMORY;\0A\0Aerror:\0A    *p_slot = NULL;\0A\0A    return status;\0A}\0A\0A#if defined(MBEDTLS_PSA_CRYPTO_STORAGE_C)\0Astatic psa_status_t psa_load_persistent_key_into_slot(psa_key_slot_t *slot)\0A{\0A    psa_status_t status = PSA_SUCCESS;\0A    uint8_t *key_data = NULL;\0A    size_t key_data_length = 0;\0A\0A    status = psa_load_persistent_key(&slot->attr,\0A                                     &key_data, &key_data_length);\0A    if (status != PSA_SUCCESS) {\0A        goto exit;\0A    }\0A\0A#if defined(MBEDTLS_PSA_CRYPTO_SE_C)\0A    /* Special handling is required for loading keys associated with a\0A     * dynamically registered SE interface. */\0A    const psa_drv_se_t *drv;\0A    psa_drv_se_context_t *drv_context;\0A    if (psa_get_se_driver(slot->attr.lifetime, &drv, &drv_context)) {\0A        psa_se_key_data_storage_t *data;\0A\0A        if (key_data_length != sizeof(*data)) {\0A            status = PSA_ERROR_DATA_INVALID;\0A            goto exit;\0A        }\0A        data = (psa_se_key_data_storage_t *) key_data;\0A        status = psa_copy_key_material_into_slot(\0A            slot, data->slot_number, sizeof(data->slot_number));\0A        goto exit;\0A    }\0A#endif /* MBEDTLS_PSA_CRYPTO_SE_C */\0A\0A    status = psa_copy_key_material_into_slot(slot, key_data, key_data_length);\0A    if (status != PSA_SUCCESS) {\0A        goto exit;\0A    }\0A\0Aexit:\0A    psa_free_persistent_key_data(key_data, key_data_length);\0A    return status;\0A}\0A#endif /* MBEDTLS_PSA_CRYPTO_STORAGE_C */\0A\0A#if defined(MBEDTLS_PSA_CRYPTO_BUILTIN_KEYS)\0A\0Astatic psa_status_t psa_load_builtin_key_into_slot(psa_key_slot_t *slot)\0A{\0A    psa_status_t status = PSA_ERROR_CORRUPTION_DETECTED;\0A    psa_key_attributes_t attributes =