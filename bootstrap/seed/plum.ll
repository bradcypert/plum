@.str45037 = private global { i64, i64, [34453 x i8] } { i64 -1, i64 34452, [34453 x i8] c"/**\0A * \5Cfile mbedtls/config_adjust_legacy_from_psa.h\0A * \5Cbrief Adjust PSA configuration: activate legacy implementations\0A *\0A * This is an internal header. Do not include it directly.\0A *\0A * When MBEDTLS_PSA_CRYPTO_CONFIG is enabled, activate legacy implementations\0A * of cryptographic mechanisms as needed to fulfill the needs of the PSA\0A * configuration. Generally speaking, we activate a legacy mechanism if\0A * it's needed for a requested PSA mechanism and there is no PSA driver\0A * for it.\0A */\0A/*\0A *  Copyright The Mbed TLS Contributors\0A *  SPDX-License-Identifier: Apache-2.0 OR GPL-2.0-or-later\0A */\0A\0A#ifndef MBEDTLS_CONFIG_ADJUST_LEGACY_FROM_PSA_H\0A#define MBEDTLS_CONFIG_ADJUST_LEGACY_FROM_PSA_H\0A\0A#if !defined(MBEDTLS_CONFIG_FILES_READ)\0A#error \22Do not include mbedtls/config_adjust_*.h manually! This can lead to problems, \22 \5C\0A    \22up to and including runtime errors such as buffer overflows. \22 \5C\0A    \22If you're trying to fix a complaint from check_config.h, just remove \22 \5C\0A    \22it from your configuration file: since Mbed TLS 3.0, it is included \22 \5C\0A    \22automatically at the right point.\22\0A#endif /* */\0A\0A/* Define appropriate ACCEL macros for the p256-m driver.\0A * In the future, those should be generated from the drivers JSON description.\0A */\0A#if defined(MBEDTLS_PSA_P256M_DRIVER_ENABLED)\0A#define MBEDTLS_PSA_ACCEL_ECC_SECP_R1_256\0A#define MBEDTLS_PSA_ACCEL_ALG_ECDSA\0A#define MBEDTLS_PSA_ACCEL_ALG_ECDH\0A#define MBEDTLS_PSA_ACCEL_KEY_TYPE_ECC_PUBLIC_KEY\0A#define MBEDTLS_PSA_ACCEL_KEY_TYPE_ECC_KEY_PAIR_BASIC\0A#define MBEDTLS_PSA_ACCEL_KEY_TYPE_ECC_KEY_PAIR_IMPORT\0A#define MBEDTLS_PSA_ACCEL_KEY_TYPE_ECC_KEY_PAIR_EXPORT\0A#define MBEDTLS_PSA_ACCEL_KEY_TYPE_ECC_KEY_PAIR_GENERATE\0A#endif\0A\0A/*\0A * ECC: support for a feature is controlled by a triplet or a pair:\0A * (curve, key_type public/basic, alg) or (curve, key_type_<action>).\0A *\0A * A triplet/pair is accelerated if all of is components are accelerated;\0A * otherwise each component needs to be built in.\0A *\0A * We proceed in two passes:\0A * 1. Check if acceleration is complete for curves, key types, algs.\0A * 2. Then enable built-ins for each thing that's either not accelerated of\0A * doesn't have complete acceleration of the other triplet/pair components.\0A *\0A * Note: this needs psa/crypto_adjust_keypair_types.h to have been included\0A * already, so that we know the full set of key types that are requested.\0A */\0A\0A/* ECC: curves: is acceleration complete? */\0A#if (defined(PSA_WANT_ECC_BRAINPOOL_P_R1_256) && \5C\0A    !defined(MBEDTLS_PSA_ACCEL_ECC_BRAINPOOL_P_R1_256)) || \5C\0A    (defined(PSA_WANT_ECC_BRAINPOOL_P_R1_384) && \5C\0A    !defined(MBEDTLS_PSA_ACCEL_ECC_BRAINPOOL_P_R1_384)) || \5C\0A    (defined(PSA_WANT_ECC_BRAINPOOL_P_R1_512) && \5C\0A    !defined(MBEDTLS_PSA_ACCEL_ECC_BRAINPOOL_P_R1_512)) || \5C\0A    (defined(PSA_WANT_ECC_SECP_R1_192) && !defined(MBEDTLS_PSA_ACCEL_ECC_SECP_R1_192)) || \5C\0A    (defined(PSA_WANT_ECC_SECP_R1_224) && !defined(MBEDTLS_PSA_ACCEL_ECC_SECP_R1_224)) || \5C\0A    (defined(PSA_WANT_ECC_SECP_R1_256) && !defined(MBEDTLS_PSA_ACCEL_ECC_SECP_R1_256)) || \5C\0A    (defined(PSA_WANT_ECC_SECP_R1_384) && !defined(MBEDTLS_PSA_ACCEL_ECC_SECP_R1_384)) || \5C\0A    (defined(PSA_WANT_ECC_SECP_R1_521) && !defined(MBEDTLS_PSA_ACCEL_ECC_SECP_R1_521)) || \5C\0A    (defined(PSA_WANT_ECC_SECP_K1_192) && !defined(MBEDTLS_PSA_ACCEL_ECC_SECP_K1_192)) || \5C\0A    (defined(PSA_WANT_ECC_SECP_K1_256) && !defined(MBEDTLS_PSA_ACCEL_ECC_SECP_K1_256))\0A#define MBEDTLS_PSA_ECC_ACCEL_INCOMPLETE_CURVES\0A#define MBEDTLS_PSA_ECC_ACCEL_INCOMPLETE_WEIERSTRASS_CURVES\0A#endif\0A\0A#if (defined(PSA_WANT_ECC_MONTGOMERY_255) && !defined(MBEDTLS_PSA_ACCEL_ECC_MONTGOMERY_255)) || \5C\0A    (defined(PSA_WANT_ECC_MONTGOMERY_448) && !defined(MBEDTLS_PSA_ACCEL_ECC_MONTGOMERY_448))\0A#define MBEDTLS_PSA_ECC_ACCEL_INCOMPLETE_CURVES\0A#endif\0A\0A/* ECC: algs: is acceleration complete? */\0A#if (defined(PSA_WANT_ALG_ECDH) && !defined(MBEDTLS_PSA_ACCEL_ALG_ECDH)) || \5C\0A    (defined(PSA_WANT_ALG_ECDSA) && !defined(MBEDTLS_PSA_ACCEL_ALG_ECDSA)) || \5C\0A    (defined(PSA_WANT_ALG_DETERMINISTIC_ECDSA) && \5C\0A    !defined(MBEDTLS_PSA_ACCEL_ALG_DETERMINISTIC_ECDSA)) || \5C\0A    (defined(PSA_WANT_ALG_JPAKE) && !defined(MBEDTLS_PSA_ACCEL_ALG_JPAKE))\0A#define MBEDTLS_PSA_ECC_ACCEL_INCOMPLETE_ALGS\0A#endif\0A\0A/* ECC: key types: is acceleration complete? */\0A#if (defined(PSA_WANT_KEY_TYPE_ECC_PUBLIC_KEY) && \5C\0A    !defined(MBEDTLS_PSA_ACCEL_KEY_TYPE_ECC_PUBLIC_KEY)) || \5C\0A    (defined(PSA_WANT_KEY_TYPE_ECC_KEY_PAIR_BASIC) && \5C\0A    !defined(MBEDTLS_PSA_ACCEL_KEY_TYPE_ECC_KEY_PAIR_BASIC))\0A#define MBEDTLS_PSA_ECC_ACCEL_INCOMPLETE_KEY_TYPES_BASIC\0A#endif\0A\0A/* Special case: we don't support cooked key derivation in drivers yet */\0A#if defined(MBEDTLS_PSA_ACCEL_KEY_TYPE_ECC_KEY_PAIR_DERIVE)\0A#undef MBEDTLS_PSA_ACCEL_KEY_TYPE_ECC_KEY_PAIR_DERIVE\0A#endif\0A\0A/* Note: the condition about key derivation is always true as DERIVE can't be\0A * accelerated yet */\0A#if (defined(PSA_WANT_KEY_TYPE_ECC_PUBLIC_KEY) && \5C\0A    !defined(MBEDTLS_PSA_ACCEL_KEY_TYPE_ECC_PUBLIC_KEY)) || \5C\0A    (defined(PSA_WANT_KEY_TYPE_ECC_KEY_PAIR_BASIC) && \5C\0A    !defined(MBEDTLS_PSA_ACCEL_KEY_TYPE_ECC_KEY_PAIR_BASIC)) || \5C\0A    (defined(PSA_WANT_KEY_TYPE_ECC_KEY_PAIR_IMPORT) && \5C\0A    !defined(MBEDTLS_PSA_ACCEL_KEY_TYPE_ECC_KEY_PAIR_IMPORT)) || \5C\0A    (defined(PSA_WANT_KEY_TYPE_ECC_KEY_PAIR_EXPORT) && \5C\0A    !defined(MBEDTLS_PSA_ACCEL_KEY_TYPE_ECC_KEY_PAIR_EXPORT)) || \5C\0A    (defined(PSA_WANT_KEY_TYPE_ECC_KEY_PAIR_GENERATE) && \5C\0A    !defined(MBEDTLS_PSA_ACCEL_KEY_TYPE_ECC_KEY_PAIR_GENERATE)) || \5C\0A    (defined(PSA_WANT_KEY_TYPE_ECC_KEY_PAIR_DERIVE) && \5C\0A    !defined(MBEDTLS_PSA_ACCEL_KEY_TYPE_ECC_KEY_PAIR_DERIVE))\0A#define MBEDTLS