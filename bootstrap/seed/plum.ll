@.str45595 = private global { i64, i64, [1030 x i8] } { i64 -1, i64 1029, [1030 x i8] c"/**\0A * \5Cfile bignum_mod_raw_invasive.h\0A *\0A * \5Cbrief Function declarations for invasive functions of Low-level\0A *        modular bignum.\0A */\0A/**\0A *  Copyright The Mbed TLS Contributors\0A *  SPDX-License-Identifier: Apache-2.0 OR GPL-2.0-or-later\0A */\0A\0A#ifndef MBEDTLS_BIGNUM_MOD_RAW_INVASIVE_H\0A#define MBEDTLS_BIGNUM_MOD_RAW_INVASIVE_H\0A\0A#include \22common.h\22\0A#include \22mbedtls/bignum.h\22\0A#include \22bignum_mod.h\22\0A\0A#if defined(MBEDTLS_TEST_HOOKS)\0A\0A/** Convert the result of a quasi-reduction to its canonical representative.\0A *\0A * \5Cparam[in,out] X     The address of the MPI to be converted. Must have the\0A *                      same number of limbs as \5Cp N. The input value must\0A *                      be in range 0 <= X < 2N.\0A * \5Cparam[in]     N     The address of the modulus.\0A */\0AMBEDTLS_STATIC_TESTABLE\0Avoid mbedtls_mpi_mod_raw_fix_quasi_reduction(mbedtls_mpi_uint *X,\0A                                             const mbedtls_mpi_mod_modulus *N);\0A\0A#endif /* MBEDTLS_TEST_HOOKS */\0A\0A#endif /* MBEDTLS_BIGNUM_MOD_RAW_INVASIVE_H */\0A\00" }
