@.str40660 = private global { i64, i64, [7196 x i8] } { i64 -1, i64 7195, [7196 x i8] c"/**\0A * \5Cfile debug_internal.h\0A *\0A * \5Cbrief Internal part of the public \22debug.h\22.\0A */\0A/*\0A *  Copyright The Mbed TLS Contributors\0A *  SPDX-License-Identifier: Apache-2.0 OR GPL-2.0-or-later\0A */\0A#ifndef MBEDTLS_DEBUG_INTERNAL_H\0A#define MBEDTLS_DEBUG_INTERNAL_H\0A\0A#include \22mbedtls/debug.h\22\0A\0A/**\0A * \5Cbrief    Print a message to the debug output. This function is always used\0A *          through the MBEDTLS_SSL_DEBUG_MSG() macro, which supplies the ssl\0A *          context, file and line number parameters.\0A *\0A * \5Cparam ssl       SSL context\0A * \5Cparam level     error level of the debug message\0A * \5Cparam file      file the message has occurred in\0A * \5Cparam line      line number the message has occurred at\0A * \5Cparam format    format specifier, in printf format\0A * \5Cparam ...       variables used by the format specifier\0A *\0A * \5Cattention       This function is intended for INTERNAL usage within the\0A *                  library only.\0A */\0Avoid mbedtls_debug_print_msg(const mbedtls_ssl_context *ssl, int level,\0A                             const char *file, int line,\0A                             const char *format, ...) MBEDTLS_PRINTF_ATTRIBUTE(5, 6);\0A\0A/**\0A * \5Cbrief   Print the return value of a function to the debug output. This\0A *          function is always used through the MBEDTLS_SSL_DEBUG_RET() macro,\0A *          which supplies the ssl context, file and line number parameters.\0A *\0A * \5Cparam ssl       SSL context\0A * \5Cparam level     error level of the debug message\0A * \5Cparam file      file the error has occurred in\0A * \5Cparam line      line number the error has occurred in\0A * \5Cparam text      the name of the function that returned the error\0A * \5Cparam ret       the return code value\0A *\0A * \5Cattention       This function is intended for INTERNAL usage within the\0A *                  library only.\0A */\0Avoid mbedtls_debug_print_ret(const mbedtls_ssl_context *ssl, int level,\0A                             const char *file, int line,\0A                             const char *text, int ret);\0A\0A/**\0A * \5Cbrief   Output a buffer of size len bytes to the debug output. This function\0A *          is always used through the MBEDTLS_SSL_DEBUG_BUF() macro,\0A *          which supplies the ssl context, file and line number parameters.\0A *\0A * \5Cparam ssl       SSL context\0A * \5Cparam level     error level of the debug message\0A * \5Cparam file      file the error has occurred in\0A * \5Cparam line      line number the error has occurred in\0A * \5Cparam text      a name or label for the buffer being dumped. Normally the\0A *                  variable or buffer name\0A * \5Cparam buf       the buffer to be outputted\0A * \5Cparam len       length of the buffer\0A *\0A * \5Cattention       This function is intended for INTERNAL usage within the\0A *                  library only.\0A */\0Avoid mbedtls_debug_print_buf(const mbedtls_ssl_context *ssl, int level,\0A                             const char *file, int line, const char *text,\0A                             const unsigned char *buf, size_t len);\0A\0A#if defined(MBEDTLS_BIGNUM_C)\0A/**\0A * \5Cbrief   Print a MPI variable to the debug output. This function is always\0A *          used through the MBEDTLS_SSL_DEBUG_MPI() macro, which supplies the\0A *          ssl context, file and line number parameters.\0A *\0A * \5Cparam ssl       SSL context\0A * \5Cparam level     error level of the debug message\0A * \5Cparam file      file the error has occurred in\0A * \5Cparam line      line number the error has occurred in\0A * \5Cparam text      a name or label for the MPI being output. Normally the\0A *                  variable name\0A * \5Cparam X         the MPI variable\0A *\0A * \5Cattention       This function is intended for INTERNAL usage within the\0A *                  library only.\0A */\0Avoid mbedtls_debug_print_mpi(const mbedtls_ssl_context *ssl, int level,\0A                             const char *file, int line,\0A                             const char *text, const mbedtls_mpi *X);\0A#endif\0A\0A#if defined(MBEDTLS_ECP_LIGHT)\0A/**\0A * \5Cbrief   Print an ECP point to the debug output. This function is always\0A *          used through the MBEDTLS_SSL_DEBUG_ECP() macro, which supplies the\0A *          ssl context, file and line number parameters.\0A *\0A * \5Cparam ssl       SSL context\0A * \5Cparam level     error level of the debug message\0A * \5Cparam file      file the error has occurred in\0A * \5Cparam line      line number the error has occurred in\0A * \5Cparam text      a name or label for the ECP point being output. Normally the\0A *                  variable name\0A * \5Cparam X         the ECP point\0A *\0A * \5Cattention       This function is intended for INTERNAL usage within the\0A *                  library only.\0A */\0Avoid mbedtls_debug_print_ecp(const mbedtls_ssl_context *ssl, int level,\0A                             const char *file, int line,\0A                             const char *text, const mbedtls_ecp_point *X);\0A#endif\0A\0A#if defined(MBEDTLS_X509_CRT_PARSE_C) && !defined(MBEDTLS_X509_REMOVE_INFO)\0A/**\0A * \5Cbrief   Print a X.509 certificate structure to the debug output. This\0A *          function is always used through the MBEDTLS_SSL_DEBUG_CRT() macro,\0A *          which supplies the ssl context, file and line number parameters.\0A *\0A * \5Cparam ssl       SSL context\0A * \5Cparam level     error level of the debug message\0A * \5Cparam file      file the error has occurred in\0A * \5Cparam line      line number the error has occurred in\0A * \5Cparam text      a name or label for the certificate being output\0A * \5Cparam crt       X.509 certificate structure\0A *\0A * \5Cattention       This function is intended for INTERNAL usage within the\0A *                  library only.\0A */\0Avoid mbedtls_debug_print_crt(const mbedtls_ssl_context *ssl, int level,\0A                             const char *file, int line,\0A                             const char *text, const mbedtls_x509_crt *crt);\0A#endif\0A\0A/* Note: the MBEDTLS_ECDH_C guard here is mandatory because this debug function\0A         only works for the built-in implementation. */\0A#if defined(MBEDTLS_KEY_EXCHANGE_SOME_ECDH_OR_ECDHE_ANY_ENABLED) && \5C\0A    defined(MBEDTLS_ECDH_C)\0Atypedef enum {\0A    MBEDTLS_DEBUG_ECDH_Q,\0A    MBEDTLS_DEBUG_ECDH_QP,\0A    MBEDTLS_DEBUG_ECDH_Z,\0A} mbedtls_debug_ecdh_attr;\0A\0A/**\0A * \5Cbrief   Print a field of the ECDH structure in the SSL context to the debug\0A *          output. This function is always used through the\0A *          MBEDTLS_SSL_DEBUG_ECDH() macro, which supplies the ssl context, file\0A *          and line number parameters.\0A *\0A * \5Cparam ssl       SSL context\0A * \5Cparam level     error level of the debug message\0A * \5Cparam file      file the error has occurred in\0A * \5Cparam line      line number the error has occurred in\0A * \5Cparam ecdh      the ECDH context\0A * \5Cparam attr      the identifier of the attribute being output\0A *\0A * \5Cattention       This function is intended for INTERNAL usage within the\0A *                  library only.\0A */\0Avoid mbedtls_debug_printf_ecdh(const mbedtls_ssl_context *ssl, int level,\0A                               const char *file, int line,\0A                               const mbedtls_ecdh_context *ecdh,\0A                               mbedtls_debug_ecdh_attr attr);\0A#endif /* MBEDTLS_KEY_EXCHANGE_SOME_ECDH_OR_ECDHE_ANY_ENABLED &&\0A          MBEDTLS_ECDH_C */\0A\0A#endif /* MBEDTLS_DEBUG_INTERNAL_H */\0A\00" }
