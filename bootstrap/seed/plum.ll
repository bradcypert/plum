@.str41096 = private global { i64, i64, [38995 x i8] } { i64 -1, i64 38994, [38995 x i8] c"// Filesystem and self-location primitives, so the compiler stops\0A// shelling out to Unix commands to do them.\0A//\0A// `bootstrap/self_host/main.plum` used to reach these through\0A// `run_process`: `mktemp -d` (5 sites), `rm -rf`/`rm -f` (6), `cp -r`\0A// (1), `mkdir` (1), and `/proc/self/exe` (3). That works on Linux,\0A// works on macOS by luck, and cannot work on Windows, where none of\0A// those programs exist. `/proc/self/exe` is worse than the others: it\0A// is Linux-only, so the language server -- which re-invokes itself\0A// through it -- was already broken on a Mac.\0A//\0A// Replacing them is also just better on the platforms where they DID\0A// work. A `plum build` forked three processes to make a directory,\0A// delete a file, and delete a directory; now it forks one, for `clang`,\0A// which is the only one that was ever doing real work.\0A//\0A// Same shim conventions as its neighbours (see `net_shim.c`'s header\0A// for the general pattern): every function takes and returns only\0A// `long long` (Plum `Int`) or `const char *` (Plum `CStr`), because\0A// Plum's extern surface has no raw pointers, no out-parameters and no\0A// multi-value return.\0A//\0A// **Returned strings live in a static buffer**, not in `malloc`'d\0A// memory. The Plum side copies immediately into a string cell\0A// (`plum_str_new`), so the buffer's contents are needed only until the\0A// call returns -- and a `malloc` here would be a leak, since the\0A// extern boundary gives the Plum side no way to free it. Not\0A// re-entrant, and not required to be: nothing calls these from more\0A// than one thread.\0A\0A#include <stdio.h>\0A#include <stdlib.h>\0A#include <string.h>\0A#include <sys/stat.h>\0A#include <dirent.h>\0A#include <stdint.h>\0A#include <stddef.h>\0A#include <wchar.h>\0A#include <ctype.h>\0A#include <errno.h>\0A#include <time.h>\0A\0A#if defined(_WIN32)\0A#include <windows.h>\0A#include <winternl.h>\0A#include <direct.h>\0A#include <io.h>\0A#define PLUM_MKDIR(p) _mkdir(p)\0A#define PLUM_RMDIR(p) _rmdir(p)\0A#else\0A#include <unistd.h>\0A#include <fcntl.h>\0A#include <signal.h>\0A#define PLUM_MKDIR(p) mkdir((p), 0700)\0A#define PLUM_RMDIR(p) rmdir(p)\0A#endif\0A\0A#if defined(__APPLE__)\0A#include <mach-o/dyld.h>\0A#endif\0A\0A#if defined(__linux__) && defined(__has_include)\0A#if __has_include(<linux/if_alg.h>)\0A#define PLUM_CACHE_AF_ALG 1\0A#include <sys/socket.h>\0A#include <linux/if_alg.h>\0A#endif\0A#endif\0A\0A#define PLUM_PATH_MAX 4096\0A\0Astatic char plum_os_buf[PLUM_PATH_MAX];\0A\0A// Compiler artifact support. Hash files in bounded memory: materializing the\0A// compiler executable as an Array[Int] just to fingerprint it would dominate\0A// a warm run. SHA-256 uses unsigned 32-bit arithmetic (FIPS 180-4).\0Atypedef struct {\0A    uint32_t h[8];\0A    uint64_t bytes;\0A    unsigned char block[64];\0A    size_t used;\0A} plum_cache_sha;\0A\0Astatic uint32_t plum_cache_rotr(uint32_t x, unsigned n) {\0A    return (x >> n) | (x << (32 - n));\0A}\0A\0Astatic void plum_cache_block(plum_cache_sha *s, const unsigned char *p) {\0A    static const uint32_t k[64] = {\0A        0x428a2f98,0x71374491,0xb5c0fbcf,0xe9b5dba5,0x3956c25b,0x59f111f1,0x923f82a4,0xab1c5ed5,\0A        0xd807aa98,0x12835b01,0x243185be,0x550c7dc3,0x72be5d74,0x80deb1fe,0x9bdc06a7,0xc19bf174,\0A        0xe49b69c1,0xefbe4786,0x0fc19dc6,0x240ca1cc,0x2de92c6f,0x4a7484aa,0x5cb0a9dc,0x76f988da,\0A        0x983e5152,0xa831c66d,0xb00327c8,0xbf597fc7,0xc6e00bf3,0xd5a79147,0x06ca6351,0x14292967,\0A        0x27b70a85,0x2e1b2138,0x4d2c6dfc,0x53380d13,0x650a7354,0x766a0abb,0x81c2c92e,0x92722c85,\0A        0xa2bfe8a1,0xa81a664b,0xc24b8b70,0xc76c51a3,0xd192e819,0xd6990624,0xf40e3585,0x106aa070,\0A        0x19a4c116,0x1e376c08,0x2748774c,0x34b0bcb5,0x391c0cb3,0x4ed8aa4a,0x5b9cca4f,0x682e6ff3,\0A        0x748f82ee,0x78a5636f,0x84c87814,0x8cc70208,0x90befffa,0xa4506ceb,0xbef9a3f7,0xc67178f2\0A    };\0A    uint32_t w[64], a,b,c,d,e,f,g,h;\0A    for (unsigned i = 0; i < 16; i++)\0A        w[i] = ((uint32_t)p[i*4] << 24) | ((uint32_t)p[i*4+1] << 16)\0A             | ((uint32_t)p[i*4+2] << 8) | p[i*4+3];\0A    for (unsigned i = 16; i < 64; i++) {\0A        uint32_t x = w[i-15], y = w[i-2];\0A        w[i] = w[i-16] + (plum_cache_rotr(x,7)^plum_cache_rotr(x,18)^(x>>3))\0A             + w[i-7] + (plum_cache_rotr(y,17)^plum_cache_rotr(y,19)^(y>>10));\0A    }\0A    a=s->h[0]; b=s->h[1]; c=s->h[2]; d=s->h[3];\0A    e=s->h[4]; f=s->h[5]; g=s->h[6]; h=s->h[7];\0A    for (unsigned i = 0; i < 64; i++) {\0A        uint32_t t1 = h + (plum_cache_rotr(e,6)^plum_cache_rotr(e,11)^plum_cache_rotr(e,25))\0A                    + ((e&f)^((~e)&g)) + k[i] + w[i];\0A        uint32_t t2 = (plum_cache_rotr(a,2)^plum_cache_rotr(a,13)^plum_cache_rotr(a,22))\0A                    + ((a&b)^(a&c)^(b&c));\0A        h=g; g=f; f=e; e=d+t1; d=c; c=b; b=a; a=t1+t2;\0A    }\0A    s->h[0]+=a; s->h[1]+=b; s->h[2]+=c; s->h[3]+=d;\0A    s->h[4]+=e; s->h[5]+=f; s->h[6]+=g; s->h[7]+=h;\0A}\0A\0Astatic void plum_cache_init(plum_cache_sha *s) {\0A    static const uint32_t h[8] = {0x6a09e667,0xbb67ae85,0x3c6ef372,0xa54ff53a,\0A                                  0x510e527f,0x9b05688c,0x1f83d9ab,0x5be0cd19};\0A    memcpy(s->h,h,sizeof(h)); s->bytes=0; s->used=0;\0A}\0A\0Astatic void plum_cache_update(plum_cache_sha *s, const unsigned char *p, size_t n) {\0A    s->bytes += n;\0A    while (n) {\0A        size_t take = 64 - s->used;\0A        if (take > n) take = n;\0A        memcpy(s->block+s->used,p,take); s->used+=take; p+=take; n-=take;\0A        if (s->used == 64) { plum_cache_block(s,s->block); s->used=0; }\0A    }\0A}\0A\0Astatic void plum_cache_final(plum_cache_sha *s, char out[65]) {\0A    uint64_t bits = s->bytes * 8;\0A    unsigned char pad[128] = {0x80};\0A    size_t n = s->used < 56 ? 56-s->used : 120-s->used;\0A    for (unsigned i = 0; i < 8; i++) pad[n+i]=(unsigned char)(bits >> ((7-i)*8));\0A    plum_cache_update(s,pad,n+8);\0A    for (unsigned i = 0; i < 8; i++) snprintf(out+i*8,9,\22%08x\22,(unsigned)s->h[i]);\0A    out[64]='\5C0';\0A}\0A\0Aconst char *plum_cache_hash_text(const char *p, long long n) {\0A    static char out[65];\0A    if (n < 0) { out[0]='\5C0'; return out; }\0A    plum_cache_sha s; plum_cache_init(&s);\0A    plum_cache_update(&s,(const unsigned char *)p,(size_t)n);\0A    plum_cache_final(&s,out); return out;\0A}\0A\0A// Linux's optional kernel SHA provider uses CPU acceleration when available.\0A// No new library/tool dependency; an unavailable provider falls back to the\0A// portable implementation. Cache correctness is independent of the provider.\0Astatic int plum_cache_kernel_hash(const char *path, char out[65]) {\0A#if defined(PLUM_CACHE_AF_ALG)\0A    struct sockaddr_alg sa;\0A    memset(&sa,0,sizeof(sa)); sa.salg_family=AF_ALG;\0A    memcpy(sa.salg_type,\22hash\22,5); memcpy(sa.salg_name,\22sha256\22,7);\0A    int parent=socket(AF_ALG,SOCK_SEQPACKET,0);\0A    if (parent < 0) return 0;\0A    if (bind(parent,(struct sockaddr *)&sa,sizeof(sa)) != 0) { close(parent); return 0; }\0A    int fd=accept(parent,NULL,NULL); close(parent);\0A    if (fd < 0) return 0;\0A    FILE *f=fopen(path,\22rb\22);\0A    if (!f) { close(fd); return 0; }\0A    unsigned char buf[65536], digest[32]; size_t n; int bad=0;\0A    while ((n=fread(buf,1,sizeof(buf),f)) != 0) {\0A        size_t at=0;\0A        while (at < n) {\0A            ssize_t sent=send(fd,buf+at,n-at,MSG_MORE);\0A            if (sent <= 0) { bad=1; break; }\0A            at+=(size_t)sent;\0A        }\0A        if (bad) break;\0A    }\0A    if (ferror(f)) bad=1;\0A    if (fclose(f) != 0) bad=1;\0A    if (!bad && send(fd,NULL,0,0) != 0) bad=1;\0A    if (!bad && recv(fd,digest,sizeof(digest),0) != (ssize_t)sizeof(digest)) bad=1;\0A    close(fd);\0A    if (bad) return 0;\0A    for (unsigned i=0;i<32;i++) snprintf(out+i*2,3,\22%02x\22,(unsigned)digest[i]);\0A    out[64]='\5C0'; return 1;\0A#else\0A    (void)path; (void)out; return 0;\0A#endif\0A}\0A\0Aconst char *plum_cache_hash_file(const char *path) {\0A    static char out[65];\0A    unsigned char buf[32768]; size_t n;\0A    out[0]='\5C0';\0A    struct stat st;\0A    if (stat(path,&st) == 0 && S_ISREG(st.st_mode) && st.st_size > 1048576\0A        && plum_cache_kernel_hash(path,out)) return out;\0A    FILE *f=fopen(path,\22rb\22);\0A    if (!f) return out;\0A    plum_cache_sha s; plum_cache_init(&s);\0A    while ((n=fread(buf,1,sizeof(buf),f)) != 0) plum_cache_update(&s,buf,n);\0A    int bad=ferror(f); if (fclose(f) != 0) bad=1;\0A    if (!bad) plum_cache_final(&s,out);\0A    return out;\0A}\0A\0A// Saved input paths are byte strings, just like fopen's paths. Windows\0A// argv uses the active ANSI code page, and POSIX filenames need not be\0A// UTF-8 either. Decode the hex envelope without treating it as Unicode.\0Astatic int plum_cache_hex_digit(unsigned char c) {\0A    if (c >= '0' && c <= '9') return c - '0';\0A    if (c >= 'a' && c <= 'f') return c - 'a' + 10;\0A    if (c >= 'A' && c <= 'F') return c - 'A' + 10;\0A    return -1;\0A}\0A\0Aconst char *plum_cache_hash_file_hex(const char *hex) {\0A    size_t n = strlen(hex);\0A    if (n == 0 || n % 2 != 0) return \22\22;\0A    char *path = malloc(n / 2 + 1);\0A    if (!path) return \22\22;\0A    for (size_t i = 0; i < n; i += 2) {\0A        int a = plum_cache_hex_digit((unsigned char)hex[i]);\0A        int b = plum_cache_hex_digit((unsigned char)hex[i + 1]);\0A        // Embedded NUL must not truncate a corrupt manifest's path.\0A        if (a < 0 || b < 0 || (a == 0 && b == 0)) {\0A            free(path); return \22\22;\0A        }\0A        path[i / 2] = (char)((a << 4) | b);\0A    }\0A    path[n / 2] = '\5C0';\0A    const char *digest = plum_cache_hash_file(path);\0A    free(path);\0A    return digest;\0A}\0A\0A// Verify the bytes actually copied, not a prior read of the source path.\0A// A concurrent cleaner can remove an entry at any point;