@.str46967 = private global { i64, i64, [4433 x i8] } { i64 -1, i64 4432, [4433 x i8] c"// Native filesystem boundary. Plum paths are UTF-8 on Windows; POSIX paths\0A// remain byte strings. Returned conversion buffers belong to the caller.\0A#ifndef PLUM_PATH_SHIM_H\0A#define PLUM_PATH_SHIM_H\0A#include <stdio.h>\0A#include <stdlib.h>\0A#include <stdint.h>\0A#include <limits.h>\0A#include <errno.h>\0A#include <sys/stat.h>\0A#include <dirent.h>\0A#if defined(_WIN32)\0A#include <windows.h>\0A#include <direct.h>\0A#include <wchar.h>\0A\0Astatic inline wchar_t *plum_path_wide_limit(const char *path, int max_units) {\0A    int n = MultiByteToWideChar(CP_UTF8, MB_ERR_INVALID_CHARS, path, -1, NULL, 0);\0A    if (!n) { errno = EILSEQ; return NULL; }\0A    if (n > max_units) { errno = E2BIG; SetLastError(ERROR_BUFFER_OVERFLOW); return NULL; }\0A    if ((size_t)n > SIZE_MAX / sizeof(wchar_t)) { errno = ENOMEM; return NULL; }\0A    wchar_t *wide = malloc((size_t)n * sizeof(wchar_t));\0A    if (!wide) { errno = ENOMEM; SetLastError(ERROR_NOT_ENOUGH_MEMORY); return NULL; }\0A    if (MultiByteToWideChar(CP_UTF8, MB_ERR_INVALID_CHARS, path, -1, wide, n) != n) {\0A        free(wide); errno = EILSEQ; return NULL;\0A    }\0A    return wide;\0A}\0A\0Astatic inline wchar_t *plum_path_wide(const char *path) {\0A    return plum_path_wide_limit(path, INT_MAX);\0A}\0A\0A// No replacement characters and no successful truncation, including when a\0A// Windows filename contains an unpaired surrogate (not representable in UTF-8).\0Astatic inline int plum_path_utf8(const wchar_t *wide, char *out, size_t capacity) {\0A    if (!capacity || capacity > INT_MAX) { errno = ERANGE; return 0; }\0A    out[0] = 0;\0A    int n = WideCharToMultiByte(CP_UTF8, WC_ERR_INVALID_CHARS, wide, -1,\0A                                out, (int)capacity, NULL, NULL);\0A    if (!n) { out[0] = 0; errno = GetLastError() == ERROR_INSUFFICIENT_BUFFER ? ERANGE : EILSEQ; }\0A    return n;\0A}\0A\0Astatic inline FILE *plum_path_fopen(const char *path, const char *mode) {\0A    wchar_t *wide = plum_path_wide(path);\0A    if (!wide) return NULL;\0A    // All shim callers use short ASCII CRT modes, never user-supplied text.\0A    wchar_t wm[16]; size_t i = 0;\0A    for (; mode[i] && i < 15; i++) wm[i] = (unsigned char)mode[i];\0A    wm[i] = 0;\0A    FILE *f = mode[i] ? NULL : _wfopen(wide, wm);\0A    free(wide);\0A    return f;\0A}\0A\0Atypedef struct _stat64 PlumPathStat;\0Astatic inline int plum_path_stat(const char *path, PlumPathStat *st) {\0A    wchar_t *wide = plum_path_wide(path);\0A    if (!wide) return -1;\0A    int rc = _wstat64(wide, st);\0A    free(wide); return rc;\0A}\0Astatic inline int plum_path_remove(const char *path) {\0A    wchar_t *wide = plum_path_wide(path);\0A    if (!wide) return -1;\0A    int rc = _wremove(wide);\0A    free(wide); return rc;\0A}\0Astatic inline int plum_path_mkdir(const char *path) {\0A    wchar_t *wide = plum_path_wide(path);\0A    if (!wide) return -1;\0A    int rc = _wmkdir(wide);\0A    free(wide); return rc;\0A}\0Astatic inline DWORD plum_path_attributes(const char *path) {\0A    wchar_t *wide = plum_path_wide(path);\0A    if (!wide) return INVALID_FILE_ATTRIBUTES;\0A    DWORD attrs = GetFileAttributesW(wide);\0A    free(wide); return attrs;\0A}\0A\0A// MinGW's wide stream owns its entry storage. One UTF-8 buffer per stream,\0A// bounded by the maximum Windows filename, with no allocation per entry.\0Atypedef struct { _WDIR *stream; char name[4 * MAX_PATH]; } PlumPathDir;\0Astatic inline PlumPathDir *plum_path_opendir(const char *path) {\0A    wchar_t *wide = plum_path_wide(path);\0A    if (!wide) return NULL;\0A    _WDIR *stream = _wopendir(wide);\0A    free(wide);\0A    if (!stream) return NULL;\0A    PlumPathDir *dir = malloc(sizeof(*dir));\0A    if (!dir) { _wclosedir(stream); errno = ENOMEM; return NULL; }\0A    dir->stream = stream; dir->name[0] = 0;\0A    return dir;\0A}\0Astatic inline const char *plum_path_readdir(PlumPathDir *dir) {\0A    struct _wdirent *entry = _wreaddir(dir->stream);\0A    if (!entry) return NULL;\0A    return plum_path_utf8(entry->d_name, dir->name, sizeof(dir->name)) ? dir->name : NULL;\0A}\0Astatic inline void plum_path_closedir(PlumPathDir *dir) {\0A    _wclosedir(dir->stream); free(dir);\0A}\0A#else\0Atypedef struct stat PlumPathStat;\0Atypedef DIR PlumPathDir;\0A#define plum_path_fopen fopen\0A#define plum_path_stat stat\0A#define plum_path_remove remove\0A#define plum_path_mkdir(path) mkdir((path), 0700)\0A#define plum_path_opendir opendir\0A#define plum_path_closedir closedir\0Astatic inline const char *plum_path_readdir(PlumPathDir *dir) {\0A    struct dirent *entry = readdir(dir);\0A    return entry ? entry->d_name : NULL;\0A}\0A#endif\0A#endif\0A\00" }
