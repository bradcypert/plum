len);\0A    ssl->cli_id_len = ilen;\0A\0A    return 0;\0A}\0A\0Avoid mbedtls_ssl_conf_dtls_cookies(mbedtls_ssl_config *conf,\0A                                   mbedtls_ssl_cookie_write_t *f_cookie_write,\0A                                   mbedtls_ssl_cookie_check_t *f_cookie_check,\0A                                   void *p_cookie)\0A{\0A    conf->f_cookie_write = f_cookie_write;\0A    conf->f_cookie_check = f_cookie_check;\0A    conf->p_cookie       = p_cookie;\0A}\0A#endif /* MBEDTLS_SSL_DTLS_HELLO_VERIFY */\0A\0A#if defined(MBEDTLS_KEY_EXCHANGE_SOME_PSK_ENABLED)\0AMBEDTLS_CHECK_RETURN_CRITICAL\0Astatic int ssl_conf_has_psk_or_cb(mbedtls_ssl_config const *conf)\0A{\0A    if (conf->f_psk != NULL) {\0A        return 1;\0A    }\0A\0A    if (conf->psk_identity_len == 0 || conf->psk_identity == NULL) {\0A        return 0;\0A    }\0A\0A\0A#if defined(MBEDTLS_USE_PSA_CRYPTO)\0A    if (!mbedtls_svc_key_id_is_null(conf->psk_opaque)) {\0A        return 1;\0A    }\0A#endif /* MBEDTLS_USE_PSA_CRYPTO */\0A\0A    if (conf->psk != NULL && conf->psk_len != 0) {\0A        return 1;\0A    }\0A\0A    return 0;\0A}\0A#endif /* MBEDTLS_KEY_EXCHANGE_SOME_PSK_ENABLED */\0A\0AMBEDTLS_CHECK_RETURN_CRITICAL\0Astatic int ssl_parse_renegotiation_info(mbedtls_ssl_context *ssl,\0A                                        const unsigned char *buf,\0A                                        size_t len)\0A{\0A#if defined(MBEDTLS_SSL_RENEGOTIATION)\0A    if (ssl->renego_status != MBEDTLS_SSL_INITIAL_HANDSHAKE) {\0A        /* Check verify-data in constant-time. The length OTOH is no secret */\0A        if (len    != 1 + ssl->verify_data_len ||\0A            buf[0] !=     ssl->verify_data_len ||\0A            mbedtls_ct_memcmp(buf + 1, ssl->peer_verify_data,\0A                              ssl->verify_data_len) != 0) {\0A            MBEDTLS_SSL_DEBUG_MSG(1, (\22non-matching renegotiation info\22));\0A            mbedtls_ssl_send_alert_message(ssl, MBEDTLS_SSL_ALERT_LEVEL_FATAL,\0A                                           MBEDTLS_SSL_ALERT_MSG_HANDSHAKE_FAILURE);\0A            return MBEDTLS_ERR_SSL_HANDSHAKE_FAILURE;\0A        }\0A    } else\0A#endif /* MBEDTLS_SSL_RENEGOTIATION */\0A    {\0A        if (len != 1 || buf[0] != 0x0) {\0A            MBEDTLS_SSL_DEBUG_MSG(1, (\22non-zero length renegotiation info\22));\0A            mbedtls_ssl_send_alert_message(ssl, MBEDTLS_SSL_ALERT_LEVEL_FATAL,\0A                                           MBEDTLS_SSL_ALERT_MSG_HANDSHAKE_FAILURE);\0A            return MBEDTLS_ERR_SSL_HANDSHAKE_FAILURE;\0A        }\0A\0A        ssl->secure_renegotiation = MBEDTLS_SSL_SECURE_RENEGOTIATION;\0A    }\0A\0A    return 0;\0A}\0A\0A#if defined(MBEDTLS_KEY_EXCHANGE_SOME_ECDH_OR_ECDHE_1_2_ENABLED) || \5C\0A    defined(MBEDTLS_KEY_EXCHANGE_ECDSA_CERT_REQ_ALLOWED_ENABLED) || \5C\0A    defined(MBEDTLS_KEY_EXCHANGE_ECJPAKE_ENABLED)\0A/*\0A * Function for parsing a supported groups (TLS 1.3) or supported elliptic\0A * curves (TLS 1.2) extension.\0A *\0A * The \22extension_data\22 field of a supported groups extension contains a\0A * \22NamedGroupList\22 value (TLS 1.3 RFC8446):\0A *      enum {\0A *          secp256r1(0x0017), secp384r1(0x0018), secp521r1(0x0019),\0A *          x25519(0x001D), x448(0x001E),\0A *          ffdhe2048(0x0100), ffdhe3072(0x0101), ffdhe4096(0x0102),\0A *          ffdhe6144(0x0103), ffdhe8192(0x0104),\0A *          ffdhe_private_use(0x01FC..0x01FF),\0A *          ecdhe_private_use(0xFE00..0xFEFF),\0A *          (0xFFFF)\0A *      } NamedGroup;\0A *      struct {\0A *          NamedGroup named_group_list<2..2^16-1>;\0A *      } NamedGroupList;\0A *\0A * The \22extension_data\22 field of a supported elliptic curves extension contains\0A * a \22NamedCurveList\22 value (TLS 1.2 RFC 8422):\0A * enum {\0A *      deprecated(1..22),\0A *      secp256r1 (23), secp384r1 (24), secp521r1 (25),\0A *      x25519(29), x448(30),\0A *      reserved (0xFE00..0xFEFF),\0A *      deprecated(0xFF01..0xFF02),\0A *      (0xFFFF)\0A *  } NamedCurve;\0A * struct {\0A *      NamedCurve named_curve_list<2..2^16-1>\0A *  } NamedCurveList;\0A *\0A * The TLS 1.3 supported groups extension was defined to be a compatible\0A * generalization of the TLS 1.2 supported elliptic curves extension. They both\0A * share the same extension identifier.\0A *\0A */\0AMBEDTLS_CHECK_RETURN_CRITICAL\0Astatic int ssl_parse_supported_groups_ext(mbedtls_ssl_context *ssl,\0A                                          const unsigned char *buf,\0A                                          size_t len)\0A{\0A    size_t list_size, our_size;\0A    const unsigned char *p;\0A    uint16_t *curves_tls_id;\0A\0A    if (len < 2) {\0A        MBEDTLS_SSL_DEBUG_MSG(1, (\22bad client hello message\22));\0A        mbedtls_ssl_send_alert_message(ssl, MBEDTLS_SSL_ALERT_LEVEL_FATAL,\0A                                       MBEDTLS_SSL_ALERT_MSG_DECODE_ERROR);\0A        return MBEDTLS_ERR_SSL_DECODE_ERROR;\0A    }\0A    list_size = MBEDTLS_GET_UINT16_BE(buf, 0);\0A    if (list_size + 2 != len ||\0A        list_size % 2 != 0) {\0A        MBEDTLS_SSL_DEBUG_MSG(1, (\22bad client hello message\22));\0A        mbedtls_ssl_send_alert_message(ssl, MBEDTLS_SSL_ALERT_LEVEL_FATAL,\0A                                       MBEDTLS_SSL_ALERT_MSG_DECODE_ERROR);\0A        return MBEDTLS_ERR_SSL_DECODE_ERROR;\0A    }\0A\0A    /* Should never happen unless client duplicates the extension */\0A    if (ssl->handshake->curves_tls_id != NULL) {\0A        MBEDTLS_SSL_DEBUG_MSG(1, (\22bad client hello message\22));\0A        mbedtls_ssl_send_alert_message(ssl, MBEDTLS_SSL_ALERT_LEVEL_FATAL,\0A                                       MBEDTLS_SSL_ALERT_MSG_ILLEGAL_PARAMETER);\0A        return MBEDTLS_ERR_SSL_ILLEGAL_PARAMETER;\0A    }\0A\0A    /* Don't allow our peer to make us allocate too much memory,\0A     * and leave room for a final 0 */\0A    our_size = list_size / 2 + 1;\0A    if (our_size > MBEDTLS_ECP_DP_MAX) {\0A        our_size = MBEDTLS_ECP_DP_MAX;\0A    }\0A\0A    if ((curves_tls_id = mbedtls_calloc(our_size,\0A                                        sizeof(*curves_tls_id))) == NULL) {\0A        mbedtls_ssl_send_alert_message(ssl, MBEDTLS_SSL_ALERT_LEVEL_FATAL,\0A                                       MBEDTLS_SSL_ALERT_MSG_INTERNAL_ERROR);\0A        return MBEDTLS_ERR_SSL_ALLOC_FAILED;\0A    }\0A\0A    ssl->handshake->curves_tls_id = curves_tls_id;\0A\0A    p = buf + 2;\0A    while (list_size > 0 && our_size > 1) {\0A        uint16_t curr_tls_id = MBEDTLS_GET_UINT16_BE(p, 0);\0A\0A        if (mbedtls_ssl_get_ecp_group_id_from_tls_id(curr_tls_id) !=\0A            MBEDTLS_ECP_DP_NONE) {\0A            *curves_tls_id++ = curr_tls_id;\0A            our_size--;\0A        }\0A\0A        list_size -= 2;\0A        p += 2;\0A    }\0A\0A    return 0;\0A}\0A\0AMBEDTLS_CHECK_RETURN_CRITICAL\0Astatic int ssl_parse_supported_point_formats(mbedtls_ssl_context *ssl,\0A                                             const unsigned char *buf,\0A                                             size_t len)\0A{\0A    size_t list_size;\0A    const unsigned char *p;\0A\0A    if (len == 0 || (size_t) (buf[0] + 1) != len) {\0A        MBEDTLS_SSL_DEBUG_MSG(1, (\22bad client hello message\22));\0A        mbedtls_ssl_send_alert_message(ssl, MBEDTLS_SSL_ALERT_LEVEL_FATAL,\0A                                       MBEDTLS_SSL_ALERT_MSG_DECODE_ERROR);\0A        return MBEDTLS_ERR_SSL_DECODE_ERROR;\0A    }\0A    list_size = buf[0];\0A\0A    p = buf + 1;\0A    while (list_size > 0) {\0A        if (p[0] == MBEDTLS_ECP_PF_UNCOMPRESSED ||\0A            p[0] == MBEDTLS_ECP_PF_COMPRESSED) {\0A#if !defined(MBEDTLS_USE_PSA_CRYPTO) && \5C\0A            defined(MBEDTLS_KEY_EXCHANGE_SOME_ECDH_OR_ECDHE_1_2_ENABLED)\0A            ssl->handshake->ecdh_ctx.point_format = p[0];\0A#endif /* !MBEDTLS_USE_PSA_CRYPTO && MBEDTLS_KEY_EXCHANGE_SOME_ECDH_OR_ECDHE_1_2_ENABLED */\0A#if !defined(MBEDTLS_USE_PSA_CRYPTO) &&                             \5C\0A            defined(MBEDTLS_KEY_EXCHANGE_ECJPAKE_ENABLED)\0A            mbedtls_ecjpake_set_point_format(&ssl->handshake->ecjpake_ctx,\0A                                             p[0]);\0A#endif /* !MBEDTLS_USE_PSA_CRYPTO && MBEDTLS_KEY_EXCHANGE_ECJPAKE_ENABLED */\0A            MBEDTLS_SSL_DEBUG_MSG(4, (\22point format selected: %d\22, p[0]));\0A            return 0;\0A        }\0A\0A        list_size--;\0A        p++;\0A    }\0A\0A    return 0;\0A}\0A#endif /* MBEDTLS_KEY_EXCHANGE_SOME_ECDH_OR_ECDHE_1_2_ENABLED ||\0A          MBEDTLS_KEY_EXCHANGE_ECDSA_CERT_REQ_ALLOWED_ENABLED ||\0A          MBEDTLS_KEY_EXCHANGE_ECJPAKE_ENABLED */\0A\0A#if defined(MBEDTLS_KEY_EXCHANGE_ECJPAKE_ENABLED)\0AMBEDTLS_CHECK_RETURN_CRITICAL\0Astatic int ssl_parse_ecjpake_kkpp(mbedtls_ssl_context *ssl,\0A                                  const unsigned char *buf,\0A                                  size_t len)\0A{\0A    int ret = MBEDTLS_ERR_ERROR_CORRUPTION_DETECTED;\0A\0A#if defined(MBEDTLS_USE_PSA_CRYPTO)\0A    if (ssl->handshake->psa_pake_ctx_is_ok != 1)\0A#else\0A    if (mbedtls_ecjpake_check(&ssl->handshake->ecjpake_ctx) != 0)\0A#endif /* MBEDTLS_USE_PSA_CRYPTO */\0A    {\0A        MBEDTLS_SSL_DEBUG_MSG(3, (\22skip ecjpake kkpp extension\22));\0A        return 0;\0A    }\0A\0A#if defined(MBEDTLS_USE_PSA_CRYPTO)\0A    if ((ret = mbedtls_psa_ecjpake_read_round(\0A             &ssl->handshake->psa_pake_ctx, buf, len,\0A             MBEDTLS_ECJPAKE_ROUND_ONE)) != 0) {\0A        psa_destroy_key(ssl->handshake->psa_pake_password);\0A        psa_pake_abort(&ssl->handshake->psa_pake_ctx);\0A\0A        MBEDTLS_SSL_DEBUG_RET(1, \22psa_pake_input round one\22, ret);\0A        mbedtls_ssl_send_alert_message(\0A            ssl,\0A            MBEDTLS_SSL_ALERT_LEVEL_FATAL,\0A            MBEDTLS_SSL_ALERT_MSG_HANDSHAKE_FAILURE);\0A\0A        return ret;\0A    }\0A#else\0A    if ((ret = mbedtls_ecjpake_read_round_one(&ssl->handshake->ecjpake_ctx,\0A                                              buf, len)) != 0) {\0A        MBEDTLS_SSL_DEBUG_RET(1, \22mbedtls_ecjpake_read_round_one\22, ret);\0A        mbedtls_ssl_send_alert_message(ssl, MBEDTLS_SSL_ALERT_LEVEL_FATAL,\0A                                       MBEDTLS_SSL_ALERT_MSG_ILLEGAL_PARAMETER);\0A        return ret;\0A    }\0A#endif /* MBEDTLS_USE_PSA_CRYPTO */\0A\0A    /* Only mark the extension as OK when we're sure it is */\0A    ssl->handshake->cli_exts |= MBEDTLS_TLS_EXT_ECJPAKE_KKPP_OK;\0A\0A    return 0;\0A}\0A#endif /* MBEDTLS_KEY_EXCHANGE_ECJPAKE_ENABLED */\0A\0A#if defined(MBEDTLS_SSL_MAX_FRAGMENT_LENGTH)\0AMBEDTLS_CHECK_RETURN_CRITICAL\0Astatic int ssl_parse_max_fragment_length_ext(mbedtls_ssl_context *ssl,\0A                                             const unsigned char *buf,\0A                                             size_t len)\0A{\0A    if (len != 1 || buf[0] >= MBEDTLS_SSL_MAX_FRAG_LEN_INVALID) {\0A        MBEDTLS_SSL_DEBUG_MSG(1, (\22bad client hello message\22));\0A        mbedtls_ssl_send_alert_message(ssl, MBEDTLS_SSL_ALERT_LEVEL_FATAL,\0A                                       MBEDTLS_SSL_ALERT_MSG_ILLEGAL_PARAMETER);\0A        return MBEDTLS_ERR_SSL_ILLEGAL_PARAMETER;\0A    }\0A\0A    ssl->session_negotiate->mfl_code = buf[0];\0A\0A    return 0;\0A}\0A#endif /* MBEDTLS_SSL_MAX_FRAGMENT_LENGTH */\0A\0A#if defined(MBEDTLS_SSL_DTLS_CONNECTION_ID)\0AMBEDTLS_CHECK_RETURN_CRITICAL\0Astatic int ssl_parse_cid_ext(mbedtls_ssl_context *ssl,\0A                             const unsigned char *buf,\0A                             size_t len)\0A{\0A    size_t peer_cid_len;\0A\0A    /* CID extension only makes sense in DTLS */\0A    if (ssl->conf->transport != MBEDTLS_SSL_TRANSPORT_DATAGRAM) {\0A        MBEDTLS_SSL_DEBUG_MSG(1, (\22bad client hello message\22));\0A        mbedtls_ssl_send_alert_message(ssl, MBEDTLS_SSL_ALERT_LEVEL_FATAL,\0A                                       MBEDTLS_SSL_ALERT_MSG_ILLEGAL_PARAMETER);\0A        return MBEDTLS_ERR_SSL_ILLEGAL_PARAMETER;\0A    }\0A\0A    /*\0A     *   struct {\0A     *      opaque cid<0..2^8-1>;\0A     *   } ConnectionId;\0A     */\0A\0A    if (len < 1) {\0A        MBEDTLS_SSL_DEBUG_MSG(1, (\22bad client hello message\22));\0A        mbedtls_ssl_send_alert_message(ssl, MBEDTLS_SSL_ALERT_LEVEL_FATAL,\0A                                       MBEDTLS_SSL_ALERT_MSG_DECODE_ERROR);\0A        return MBEDTLS_ERR_SSL_DECODE_ERROR;\0A    }\0A\0A    peer_cid_len = *buf++;\0A    len--;\0A\0A    if (len != peer_cid_len) {\0A        MBEDTLS_SSL_DEBUG_MSG(1, (\22bad client hello message\22));\0A        mbedtls_ssl_send_alert_message(ssl, MBEDTLS_SSL_ALERT_LEVEL_FATAL,\0A                                       MBEDTLS_SSL_ALERT_MSG_DECODE_ERROR);\0A        return MBEDTLS_ERR_SSL_DECODE_ERROR;\0A    }\0A\0A    /* Ignore CID if the user has disabled its use. */\0A    if (ssl->negotiate_cid == MBEDTLS_SSL_CID_DISABLED) {\0A        /* Leave ssl->handshake->cid_in_use in its default\0A         * value of MBEDTLS_SSL_CID_DISABLED. */\0A        MBEDTLS_SSL_DEBUG_MSG(3, (\22Client sent CID extension, but CID disabled\22));\0A        return 0;\0A    }\0A\0A    if (peer_cid_len > MBEDTLS_SSL_CID_OUT_LEN_MAX) {\0A        MBEDTLS_SSL_DEBUG_MSG(1, (\22bad client hello message\22));\0A        mbedtls_ssl_send_alert_message(ssl, MBEDTLS_SSL_ALERT_LEVEL_FATAL,\0A                                       MBEDTLS_SSL_ALERT_MSG_ILLEGAL_PARAMETER);\0A        return MBEDTLS_ERR_SSL_ILLEGAL_PARAMETER;\0A    }\0A\0A    ssl->handshake->cid_in_use = MBEDTLS_SSL_CID_ENABLED;\0A    ssl->handshake->peer_cid_len = (uint8_t) peer_cid_len;\0A    memcpy(ssl->handshake->peer_cid, buf, peer_cid_len);\0A\0A    MBEDTLS_SSL_DEBUG_MSG(3, (\22Use of CID extension negotiated\22));\0A    MBEDTLS_SSL_DEBUG_BUF(3, \22Client CID\22, buf, peer_cid_len);\0A\0A    return 0;\0A}\0A#endif /* MBEDTLS_SSL_DTLS_CONNECTION_ID */\0A\0A#if defined(MBEDTLS_SSL_ENCRYPT_THEN_MAC)\0AMBEDTLS_CHECK_RETURN_CRITICAL\0Astatic int ssl_parse_encrypt_then_mac_ext(mbedtls_ssl_context *ssl,\0A                                  