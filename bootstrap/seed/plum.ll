@.str46312 = private global { i64, i64, [4700 x i8] } { i64 -1, i64 4699, [4700 x i8] c"// TLS transport boundary for Http.  This is intentionally separate from\0A// net_shim.c: a TLS connection is an opaque session, not a socket fd.\0A//\0A// The first implementation uses Mbed TLS' client API.  The Plum ABI sees\0A// only Int handles, CStrs, and byte counts; certificate loading, hostname\0A// verification, and the underlying socket remain native details.\0A\0A#include <stdlib.h>\0A#include <string.h>\0A#include <stdio.h>\0A#include <stdint.h>\0A\0A#include <mbedtls/net_sockets.h>\0A#include <mbedtls/ssl.h>\0A#include <mbedtls/error.h>\0A#include <mbedtls/x509_crt.h>\0A\0A#if defined(_WIN32)\0A#include <windows.h>\0A#include <wincrypt.h>\0A#endif\0A\0Atypedef struct {\0A    mbedtls_net_context net;\0A    mbedtls_ssl_context ssl;\0A    mbedtls_ssl_config config;\0A    mbedtls_x509_crt ca;\0A} plum_tls;\0A\0Astatic int plum_load_ca(mbedtls_x509_crt *ca) {\0A#if defined(_WIN32)\0A    HCERTSTORE store = CertOpenSystemStoreA(0, \22ROOT\22);\0A    if (store == NULL) return -1;\0A    int loaded = 0;\0A    PCCERT_CONTEXT cert = NULL;\0A    while ((cert = CertEnumCertificatesInStore(store, cert)) != NULL) {\0A        if (mbedtls_x509_crt_parse_der(ca, cert->pbCertEncoded,\0A                                       cert->cbCertEncoded) == 0) {\0A            loaded++;\0A        }\0A    }\0A    CertCloseStore(store, 0);\0A    return loaded == 0 ? -1 : 0;\0A#else\0A    static const char *paths[] = {\0A        \22/etc/ssl/certs/ca-certificates.crt\22,\0A        \22/etc/ssl/cert.pem\22,\0A        \22/etc/pki/tls/certs/ca-bundle.crt\22,\0A        NULL,\0A    };\0A    for (int i = 0; paths[i] != NULL; ++i) {\0A        FILE *f = fopen(paths[i], \22rb\22);\0A        if (f != NULL) {\0A            fclose(f);\0A            return mbedtls_x509_crt_parse_file(ca, paths[i]);\0A        }\0A    }\0A    return -1;\0A#endif\0A}\0A\0Along long tls_connect(const char *host, long long port) {\0A   