       MBEDTLS_SSL_DEBUG_RET(2, \22ssl->f_send\22, send_ret);\0A        (void) send_ret;\0A\0A        return 0;\0A    }\0A\0A    if (ret == 0) {\0A        MBEDTLS_SSL_DEBUG_MSG(1, (\22cookie is valid, resetting context\22));\0A        if ((ret = mbedtls_ssl_session_reset_int(ssl, 1)) != 0) {\0A            MBEDTLS_SSL_DEBUG_RET(1, \22reset\22, ret);\0A            return ret;\0A        }\0A\0A        return MBEDTLS_ERR_SSL_CLIENT_RECONNECT;\0A    }\0A\0A    return ret;\0A}\0A#endif /* MBEDTLS_SSL_DTLS_CLIENT_PORT_REUSE && MBEDTLS_SSL_SRV_C */\0A\0AMBEDTLS_CHECK_RETURN_CRITICAL\0Astatic int ssl_check_record_type(uint8_t record_type)\0A{\0A    if (record_type != MBEDTLS_SSL_MSG_HANDSHAKE &&\0A        record_type != MBEDTLS_SSL_MSG_ALERT &&\0A        record_type != MBEDTLS_SSL_MSG_CHANGE_CIPHER_SPEC &&\0A        record_type != MBEDTLS_SSL_MSG_APPLICATION_DATA) {\0A        return MBEDTLS_ERR_SSL_INVALID_RECORD;\0A    }\0A\0A    return 0;\0A}\0A\0A/*\0A * ContentType type;\0A * ProtocolVersion version;\0A * uint16 epoch;            // DTLS only\0A * uint48 sequence_number;  // DTLS only\0A * uint16 length;\0A *\0A * Return 0 if header looks sane (and, for DTLS, the record is expected)\0A * MBEDTLS_ERR_SSL_INVALID_RECORD if the header looks bad,\0A * MBEDTLS_ERR_SSL_UNEXPECTED_RECORD (DTLS only) if sane but unexpected.\0A *\0A * With DTLS, mbedtls_ssl_read_record() will:\0A * 1. proceed with the record if this function returns 0\0A * 2. drop only the current record if this function returns UNEXPECTED_RECORD\0A * 3. return CLIENT_RECONNECT if this function return that value\0A * 4. drop the whole datagram if this function returns anything else.\0A * Point 2 is needed when the peer is resending, and we have already received\0A * the first record from a datagram but are still waiting for the others.\0A */\0AMBEDTLS_CHECK_RETURN_CRITICAL\0Astatic int ssl_parse_record_header(mbedtls_ssl_context const *ssl,\0A                                   unsigned char *buf,\0A              