nsigned char *) &session->ticket_age_add,\0A                                sizeof(session->ticket_age_add)) != 0)) {\0A        MBEDTLS_SSL_DEBUG_RET(1, \22generate_ticket_age_add\22, ret);\0A        return ret;\0A    }\0A    MBEDTLS_SSL_DEBUG_MSG(3, (\22ticket_age_add: %u\22,\0A                              (unsigned int) session->ticket_age_add));\0A\0A    /* Generate ticket_nonce */\0A    ret = ssl->conf->f_rng(ssl->conf->p_rng, ticket_nonce, ticket_nonce_size);\0A    if (ret != 0) {\0A        MBEDTLS_SSL_DEBUG_RET(1, \22generate_ticket_nonce\22, ret);\0A        return ret;\0A    }\0A    MBEDTLS_SSL_DEBUG_BUF(3, \22ticket_nonce:\22,\0A                          ticket_nonce, ticket_nonce_size);\0A\0A    ciphersuite_info =\0A        (mbedtls_ssl_ciphersuite_t *) ssl->handshake->ciphersuite_info;\0A    psa_hash_alg = mbedtls_md_psa_alg_from_type((mbedtls_md_type_t) ciphersuite_info->mac);\0A    hash_length = PSA_HASH_LENGTH(psa_hash_alg);\0A    if (hash_length == -1 ||\0A        (size_t) hash_length > sizeof(session->resumption_key)) {\0A        return MBEDTLS_ERR_SSL_INTERNAL_ERROR;\0A    }\0A\0A    /* In this code the psk key length equals the length of the hash */\0A    session->resumption_key_len = hash_length;\0A    session->ciphersuite = ciphersuite_info->id;\0A\0A    /* Compute resumption key\0A     *\0A     *  HKDF-Expand-Label( resumption_master_secret,\0A     *                    \22resumption\22, ticket_nonce, Hash.length )\0A     */\0A    ret = mbedtls_ssl_tls13_hkdf_expand_label(\0A        psa_hash_alg,\0A        session->app_secrets.resumption_master_secret,\0A        hash_length,\0A        MBEDTLS_SSL_TLS1_3_LBL_WITH_LEN(resumption),\0A        ticket_nonce,\0A        ticket_nonce_size,\0A        session->resumption_key,\0A        hash_length);\0A\0A    if (ret != 0) {\0A        MBEDTLS_SSL_DEBUG_RET(2,\0A                              \22Creating the ticket-resumed PSK failed\22,\0A                              ret);\0A        return ret;\0A    }\0A    MBEDTLS_SSL_DEBUG_BUF(3, \22Ticket-resumed PSK\22,\0A                          session->resumption_key,\0A                          session->resumption_key_len);\0A\0A    MBEDTLS_SSL_DEBUG_BUF(3, \22resumption_master_secret\22,\0A                          session->app_secrets.resumption_master_secret,\0A                          hash_length);\0A\0A    return 0;\0A}\0A\0A/* This function creates a NewSessionTicket message in the following format:\0A *\0A * struct {\0A *    uint32 ticket_lifetime;\0A *    uint32 ticket_age_add;\0A *    opaque ticket_nonce<0..255>;\0A *    opaque ticket<1..2^16-1>;\0A *    Extension extensions<0..2^16-2>;\0A * } NewSessionTicket;\0A *\0A * The ticket inside the NewSessionTicket message is an encrypted container\0A * carrying the necessary information so that the server is later able to\0A * re-start the communication.\0A *\0A * The following fields are placed inside the ticket by the\0A * f_ticket_write() function:\0A *\0A *  - creation time (ticket_creation_time)\0A *  - flags (ticket_flags)\0A *  - age add (ticket_age_add)\0A *  - key (resumption_key)\0A *  - key length (resumption_key_len)\0A *  - ciphersuite (ciphersuite)\0A *  - max_early_data_size (max_early_data_size)\0A */\0AMBEDTLS_CHECK_RETURN_CRITICAL\0Astatic int ssl_tls13_write_new_session_ticket_body(mbedtls_ssl_context *ssl,\0A                                                   unsigned char *buf,\0A                                                   unsigned char *end,\0A                                                   size_t *out_len,\0A                                                   unsigned char *ticket_nonce,\0A                                                   size_t ticket_nonce_size)\0A{\0A    int ret = MBEDTLS_ERR_ERROR_CORRUPTION_DETECTED;\0A    unsigned char *p = buf;\0A    mbedtls_ssl_session *session = ssl->session;\0A    size_t ticket_len;\0A    uint32_t ticket_lifetime;\0A    unsigned char *p_extensions_len;\0A\0A    *out_len = 0;\0A    MBEDTLS_SSL_DEBUG_MSG(2, (\22=> write NewSessionTicket msg\22));\0A\0A    /*\0A     *    ticket_lifetime   4 bytes\0A     *    ticket_age_add    4 bytes\0A     *    ticket_nonce      1 + ticket_nonce_size bytes\0A     *    ticket            >=2 bytes\0A     */\0A    MBEDTLS_SSL_CHK_BUF_PTR(p, end, 4 + 4 + 1 + ticket_nonce_size + 2);\0A\0A    /* Generate ticket and ticket_lifetime */\0A#if defined(MBEDTLS_HAVE_TIME)\0A    session->ticket_creation_time = mbedtls_ms_time();\0A#endif\0A    ret = ssl->conf->f_ticket_write(ssl->conf->p_ticket,\0A                                    session,\0A                                    p + 9 + ticket_nonce_size + 2,\0A                                    end,\0A                                    &ticket_len,\0A                                    &ticket_lifetime);\0A    if (ret != 0) {\0A        MBEDTLS_SSL_DEBUG_RET(1, \22write_ticket\22, ret);\0A        return ret;\0A    }\0A\0A    /* RFC 8446 section 4.6.1\0A     *\0A     *  ticket_lifetime:  Indicates the lifetime in seconds as a 32-bit\0A     *     unsigned integer in network byte order from the time of ticket\0A     *     issuance.  Servers MUST NOT use any value greater than\0A     *     604800 seconds (7 days) ...\0A     */\0A    if (ticket_lifetime > MBEDTLS_SSL_TLS1_3_MAX_ALLOWED_TICKET_LIFETIME) {\0A        MBEDTLS_SSL_DEBUG_MSG(\0A            1, (\22Ticket lifetime (%u) is greater than 7 days.\22,\0A                (unsigned int) ticket_lifetime));\0A        return MBEDTLS_ERR_SSL_BAD_INPUT_DATA;\0A    }\0A\0A    MBEDTLS_PUT_UINT32_BE(ticket_lifetime, p, 0);\0A    MBEDTLS_SSL_DEBUG_MSG(3, (\22ticket_lifetime: %u\22,\0A                              (unsigned int) ticket_lifetime));\0A\0A    /* Write ticket_age_add */\0A    MBEDTLS_PUT_UINT32_BE(session->ticket_age_add, p, 4);\0A    MBEDTLS_SSL_DEBUG_MSG(3, (\22ticket_age_add: %u\22,\0A                              (unsigned int) session->ticket_age_add));\0A\0A    /* Write ticket_nonce */\0A    p[8] = (unsigned char) ticket_nonce_size;\0A    if (ticket_nonce_size > 0) {\0A        memcpy(p + 9, ticket_nonce, ticket_nonce_size);\0A    }\0A    p += 9 + ticket_nonce_size;\0A\0A    /* Write ticket */\0A    MBEDTLS_PUT_UINT16_BE(ticket_len, p, 0);\0A    p += 2;\0A    MBEDTLS_SSL_DEBUG_BUF(4, \22ticket\22, p, ticket_len);\0A    p += ticket_len;\0A\0A    /* Ticket Extensions\0A     *\0A     * Extension extensions<0..2^16-2>;\0A     */\0A    ssl->handshake->sent_extensions = MBEDTLS_SSL_EXT_MASK_NONE;\0A\0A    MBEDTLS_SSL_CHK_BUF_PTR(p, end, 2);\0A    p_extensions_len = p;\0A    p += 2;\0A\0A#if defined(MBEDTLS_SSL_EARLY_DATA)\0A    if (mbedtls_ssl_tls13_session_ticket_allow_early_data(session)) {\0A        size_t output_len;\0A\0A        if ((ret = mbedtls_ssl_tls13_write_early_data_ext(\0A                 ssl, 1, p, end, &output_len)) != 0) {\0A            MBEDTLS_SSL_DEBUG_RET(\0A                1, \22mbedtls_ssl_tls13_write_early_data_ext\22, ret);\0A            return ret;\0A        }\0A        p += output_len;\0A    } else {\0A        MBEDTLS_SSL_DEBUG_MSG(\0A            4, (\22early_data not allowed, \22\0A                \22skip early_data extension in NewSessionTicket\22));\0A    }\0A\0A#endif /* MBEDTLS_SSL_EARLY_DATA */\0A\0A    MBEDTLS_PUT_UINT16_BE(p - p_extensions_len - 2, p_extensions_len, 0);\0A\0A    *out_len = p - buf;\0A    MBEDTLS_SSL_DEBUG_BUF(4, \22ticket\22, buf, *out_len);\0A    MBEDTLS_SSL_DEBUG_MSG(2, (\22<= write new session ticket\22));\0A\0A    MBEDTLS_SSL_PRINT_EXTS(\0A        3, MBEDTLS_SSL_HS_NEW_SESSION_TICKET, ssl->handshake->sent_extensions);\0A\0A    return 0;\0A}\0A\0A/*\0A * Handler for MBEDTLS_SSL_TLS1_3_NEW_SESSION_TICKET\0A */\0Astatic int ssl_tls13_write_new_session_ticket(mbedtls_ssl_context *ssl)\0A{\0A    int ret = MBEDTLS_ERR_ERROR_CORRUPTION_DETECTED;\0A\0A    MBEDTLS_SSL_PROC_CHK_NEG(ssl_tls13_write_new_session_ticket_coordinate(ssl));\0A\0A    if (ret == SSL_NEW_SESSION_TICKET_WRITE) {\0A        unsigned char ticket_nonce[MBEDTLS_SSL_TLS1_3_TICKET_NONCE_LENGTH];\0A        unsigned char *buf;\0A        size_t buf_len, msg_len;\0A\0A        MBEDTLS_SSL_PROC_CHK(ssl_tls13_prepare_new_session_ticket(\0A                                 ssl, ticket_nonce, sizeof(ticket_nonce)));\0A\0A        MBEDTLS_SSL_PROC_CHK(mbedtls_ssl_start_handshake_msg(\0A                                 ssl, MBEDTLS_SSL_HS_NEW_SESSION_TICKET,\0A                                 &buf, &buf_len));\0A\0A        MBEDTLS_SSL_PROC_CHK(ssl_tls13_write_new_session_ticket_body(\0A                                 ssl, buf, buf + buf_len, &msg_len,\0A                                 ticket_nonce, sizeof(ticket_nonce)));\0A\0A        MBEDTLS_SSL_PROC_CHK(mbedtls_ssl_finish_handshake_msg(\0A                                 ssl, buf_len, msg_len));\0A\0A        /* Limit session tickets count to one when resumption connection.\0A         *\0A         * See document of mbedtls_ssl_conf_new_session_tickets.\0A         */\0A        if (ssl->handshake->resume == 1) {\0A            ssl->handshake->new_session_tickets_count = 0;\0A        } else {\0A            ssl->handshake->new_session_tickets_count--;\0A        }\0A\0A        mbedtls_ssl_handshake_set_state(\0A            ssl, MBEDTLS_SSL_TLS1_3_NEW_SESSION_TICKET_FLUSH);\0A    } else {\0A        mbedtls_ssl_handshake_set_state(ssl, MBEDTLS_SSL_HANDSHAKE_OVER);\0A    }\0A\0Acleanup:\0A\0A    return ret;\0A}\0A#endif /* MBEDTLS_SSL_SESSION_TICKETS */\0A\0A/*\0A * TLS 1.3 State Machine -- server side\0A */\0Aint mbedtls_ssl_tls13_handshake_server_step(mbedtls_ssl_context *ssl)\0A{\0A    int ret = MBEDTLS_ERR_ERROR_CORRUPTION_DETECTED;\0A\0A    if (ssl->state == MBEDTLS_SSL_HANDSHAKE_OVER || ssl->handshake == NULL) {\0A        return MBEDTLS_ERR_SSL_BAD_INPUT_DATA;\0A    }\0A\0A    MBEDTLS_SSL_DEBUG_MSG(2, (\22tls13 server state: %s(%d)\22,\0A                              mbedtls_ssl_states_str((mbedtls_ssl_states) ssl->state),\0A                              ssl->state));\0A\0A    switch (ssl->state) {\0A        /* start state */\0A        case MBEDTLS_SSL_HELLO_REQUEST:\0A            mbedtls_ssl_handshake_set_state(ssl, MBEDTLS_SSL_CLIENT_HELLO);\0A            ret = 0;\0A            break;\0A\0A        case MBEDTLS_SSL_CLIENT_HELLO:\0A            ret = ssl_tls13_process_client_hello(ssl);\0A            if (ret != 0) {\0A                MBEDTLS_SSL_DEBUG_RET(1, \22ssl_tls13_process_client_hello\22, ret);\0A            }\0A            break;\0A\0A        case MBEDTLS_SSL_HELLO_RETRY_REQUEST:\0A            ret = ssl_tls13_write_hello_retry_request(ssl);\0A            if (ret != 0) {\0A                MBEDTLS_SSL_DEBUG_RET(1, \22ssl_tls13_write_hello_retry_request\22, ret);\0A                return ret;\0A            }\0A            break;\0A\0A        case MBEDTLS_SSL_SERVER_HELLO:\0A            ret = ssl_tls13_write_server_hello(ssl);\0A            break;\0A\0A        case MBEDTLS_SSL_ENCRYPTED_EXTENSIONS:\0A            ret = ssl_tls13_write_encrypted_extensions(ssl);\0A            if (ret != 0) {\0A                MBEDTLS_SSL_DEBUG_RET(1, \22ssl_tls13_write_encrypted_extensions\22, ret);\0A                return ret;\0A            }\0A            break;\0A\0A#if defined(MBEDTLS_SSL_TLS1_3_KEY_EXCHANGE_MODE_EPHEMERAL_ENABLED)\0A        case MBEDTLS_SSL_CERTIFICATE_REQUEST:\0A            ret = ssl_tls13_write_certificate_request(ssl);\0A            break;\0A\0A        case MBEDTLS_SSL_SERVER_CERTIFICATE:\0A            ret = ssl_tls13_write_server_certificate(ssl);\0A            break;\0A\0A        case MBEDTLS_SSL_CERTIFICATE_VERIFY:\0A            ret = ssl_tls13_write_certificate_verify(ssl);\0A            break;\0A#endif /* MBEDTLS_SSL_TLS1_3_KEY_EXCHANGE_MODE_EPHEMERAL_ENABLED */\0A\0A            /*\0A             * Injection of dummy-CCS's for middlebox compatibility\0A             */\0A#if defined(MBEDTLS_SSL_TLS1_3_COMPATIBILITY_MODE)\0A        case MBEDTLS_SSL_SERVER_CCS_AFTER_HELLO_RETRY_REQUEST:\0A            ret = mbedtls_ssl_tls13_write_change_cipher_spec(ssl);\0A            if (ret == 0) {\0A                mbedtls_ssl_handshake_set_state(ssl, MBEDTLS_SSL_CLIENT_HELLO);\0A            }\0A            break;\0A\0A        case MBEDTLS_SSL_SERVER_CCS_AFTER_SERVER_HELLO:\0A            ret = mbedtls_ssl_tls13_write_change_cipher_spec(ssl);\0A            if (ret != 0) {\0A                break;\0A            }\0A            mbedtls_ssl_handshake_set_state(ssl, MBEDTLS_SSL_ENCRYPTED_EXTENSIONS);\0A            break;\0A#endif /* MBEDTLS_SSL_TLS1_3_COMPATIBILITY_MODE */\0A\0A        case MBEDTLS_SSL_SERVER_FINISHED:\0A            ret = ssl_tls13_write_server_finished(ssl);\0A            break;\0A\0A#if defined(MBEDTLS_SSL_EARLY_DATA)\0A        case MBEDTLS_SSL_END_OF_EARLY_DATA:\0A            ret = ssl_tls13_process_end_of_early_data(ssl);\0A            break;\0A#endif /* MBEDTLS_SSL_EARLY_DATA */\0A\0A        case MBEDTLS_SSL_CLIENT_FINISHED:\0A            ret = ssl_tls13_process_client_finished(ssl);\0A            break;\0A\0A        case MBEDTLS_SSL_HANDSHAKE_WRAPUP:\0A            ret = ssl_tls13_handshake_wrapup(ssl);\0A            break;\0A\0A#if defined(MBEDTLS_SSL_TLS1_3_KEY_EXCHANGE_MODE_EPHEMERAL_ENABLED)\0A        case MBEDTLS_SSL_CLIENT_CERTIFICATE:\0A            ret = mbedtls_ssl_tls13_process_certificate(ssl);\0A            if (ret == 0) {\0A                if (ssl->session_negotiate->peer_cert != NULL) {\0A                    mbedtls_ssl_handshake_set_state(\0A                        ssl, MBEDTLS_SSL_CLIENT_CERTIFICATE_VERIFY);\0A                } else {\0A                    MBEDTLS_SSL_DEBUG_MSG(2, (\22skip parse certificate verify\22));\0A                    mbedtls_ssl_handshake_set_state(\0A                        ssl, MBEDTLS_SSL_CLIENT_FINISHED);\0A                }\0A            }\0A            break;\0A\0A        case MBEDTLS_SSL_CLIENT_CERTIFICATE_VERIFY:\0A            ret = mbedtls_ssl_tls13_process_certificate_verify(ssl);\0A            if (ret == 0) {\0A                mbedtls_ssl_handshake_set_state(\0A                    ssl, MBEDTLS_SSL_CLIENT_FINISHED);\0A            }\0A            break;\0A#endif /* MBEDTLS_SSL_TLS1_3_KEY_EXCHANGE_MODE_EPHEMERAL_ENABLED */\0A\0A#if defined(MBEDTLS_SSL_SESSION_TICKETS)\0A        case MBEDTLS_SSL_TLS1_3_NEW_SESSION_TICKET:\0A            ret = ssl_tls13_write_new_session_ticket(ssl);\0A            if (ret != 0) {\0A                MBEDTLS_SSL_DEBUG_RET(1,\0A                                      \22ssl_tls13_write_new_session_ticket \22,\0A                                      ret);\0A            }\0A            break;\0A        case MBEDTLS_SSL_TLS1_3_NEW_SESSION_TICKET_FLUSH:\0A            /* This state is necessary to do the flush of the New Session\0A             * Ticket message written in MBEDTLS_SSL_TLS1_3_NEW_SESSION_TICKET\0A             * as part of ssl_prepare_handshake_step.\0A             */\0A            ret = 0;\0A\0A            if (ssl->handshake->new_session_tickets_count == 0) {\0A                mbedtls_ssl_handshake_set_state(ssl, MBEDTLS_SSL_HANDSHAKE_OVER);\0A            } else {\0A                mbedtls_ssl_handshake_set_state(\0A                    ssl, MBEDTLS_SSL_TLS1_3_NEW_SESSION_TICKET);\0A            }\0A            break;\0A\0A#endif /* MBEDTLS_SSL_SESSION_TICKETS */\0A\0A        default:\0A            MBEDTLS_SSL_DEBUG_MSG(1, (\22invalid state %d\22, ssl->state));\0A            return MBEDTLS_ERR_SSL_FEATURE_UNAVAILABLE;\0A    }\0A\0A    return ret;\0A}\0A\0A#endif /* MBEDTLS_SSL_SRV_C && MBEDTLS_SSL_PROTO_TLS1_3 */\0A\00" }
