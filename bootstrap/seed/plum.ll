             }\0A            }\0A            if (PSA_KEY_LIFETIME_GET_LOCATION(slot->attr.lifetime) !=\0A                PSA_KEY_LOCATION_LOCAL_STORAGE) {\0A                psa_key_id_t id = MBEDTLS_SVC_KEY_ID_GET_KEY_ID(slot->attr.id);\0A                ++stats->external_slots;\0A                if (id > stats->max_open_external_key_id) {\0A                    stats->max_open_external_key_id = id;\0A                }\0A            }\0A        }\0A    }\0A}\0A\0A#endif /* MBEDTLS_PSA_CRYPTO_C */\0A\00" }
