@.str57118 = private global { i64, i64, [19449 x i8] } { i64 -1, i64 19448, [19449 x i8] c"/// One `name=value` pair of a query string, decoded.\0A///\0A/// Both halves are the real text: `a b` is a space, not `a%20b`.\0A/// `build_query` re-encodes them on the way out.\0Apub struct Param { pub name: String, pub value: String }\0A\0A/// `port` is always RESOLVED: the scheme's default when the URL did\0A/// not say. 0 means the scheme has no default this module knows,\0A/// which is not an error. Parsing is not connecting, and a URL\0A/// with a scheme we have never heard of is still a URL.\0A///\0A/// `path` is percent-encoded and never empty (`/` when the URL had\0A/// none). `raw_query` and `fragment` are stored without their `?`\0A/// and `#`, and are `\22\22` when absent, which does not distinguish\0A/// `http://h/p` from `http://h/p?`, a difference nothing observable\0A/// depends on.\0Apub struct Url {\0A    pub scheme: String,\0A    pub host: String,\0A    pub port: Int,\0A    pub path: String,\0A    pub raw_query: String,\0A    pub fragment: String,\0A}\0A\0Alet byte_at (b: Bytes) (i: Int): Int = match b.at(i) { Some(v) => v, None => 0 }\0A\0A/// Ports the schemes this module knows about default to. An unknown\0A/// scheme gets 0; see `Url`'s note.\0Apub let default_port (scheme: String): Int =\0A    if scheme == \22http\22 { 80 }\0A    else if scheme == \22https\22 { 443 }\0A    else { 0 }\0A\0A/// RFC 3986: ALPHA *( ALPHA / DIGIT / \22+\22 / \22-\22 / \22.\22 ).\0Alet scheme_ok_acc (b: Bytes) (i: Int) (n: Int): Bool =\0A    if i >= n { true }\0A    else {\0A        let c = byte_at(b, i);\0A        let alpha = (c >= 65 && c <= 90) || (c >= 97 && c <= 122);\0A        let digit = c >= 48 && c <= 57;\0A        let mark = c == 43 || c == 45 || c == 46;\0A        if i == 0 { if alpha { scheme_ok_acc(b, i + 1, n) } else { false } }\0A        else if alpha || digit || mark { scheme_ok_acc(b, i + 1, n) }\0A        else { false }\0A    }\0A\0Alet scheme_ok (s: String): Bool = {\0A    let b = s.as_bytes();\0A    if b.is_empty() { false } else { scheme_ok_acc(b, 0, b.len()) }\0A}\0A\0A/// Every index here is a CODEPOINT index, because `String.index_of`\0A/// and `String.slice` both are. Mixing one with `.len()`, which is\0A/// BYTES, is the bug this comment exists to prevent. They agree on\0A/// ASCII and part company on anything else, and a URL with a raw\0A/// non-ASCII character in it is exactly the input that would find it.\0Alet clen (s: String): Int = String.char_len(s)\0A\0A/// Splits `s` at the first `sep`, returning the part before and the\0A/// part after. When `sep` is absent the whole string is `before`.\0Apub struct Split { pub before: String, pub after: String, pub found: Bool }\0A\0Alet split_first (s: String) (sep: String): Split =\0A    match String.index_of(s, sep) {\0A        None => Split { before: s, after: \22\22, found: false },\0A        Some(i) => Split {\0A            before: String.slice(s, 0, i),\0A            after: String.slice(s, i + clen(sep), clen(s)),\0A            found: true,\0A        },\0A    }\0A\0Alet hex_value (c: Int): Int =\0A    if c >= 48 && c <= 57 { c - 48 }\0A    else if c >= 65 && c <= 70 { c - 65 + 10 }\0A    else if c >= 97 && c <= 102 { c - 97 + 10 }\0A    else { 0 - 1 }\0A\0Aenum PercentError { Escape(String), Utf8 }\0A\0A// Raw component syntax has already established that unescaped bytes are\0A// ASCII. Only escaped bytes can form multibyte UTF-8, so collect at most\0A// one codepoint (four bytes), then use the prelude's complete validator.\0A// Never decode an entire component just to discard the decoded buffer.\0Alet validate_pct_acc (b: Bytes) (i: Int) (pending: Array[Int]) (left: Int): Result[Unit, PercentError] =\0A    if i >= b.len() {\0A        if left == 0 { Ok(()) } else { Err(Utf8) }\0A    } else if byte_at(b, i) != 37 {\0A        if left != 0 { Err(Utf8) }\0A        else { validate_pct_acc(b, i + 1, pending, 0) }\0A    } else if i + 2 >= b.len() {\0A        Err(Escape(\22Encoding.percent_decode: truncated escape at byte \22.concat(i.to_string())))\0A    } else {\0A        let hi = hex_value(byte_at(b, i + 1));\0A        let lo = hex_value(byte_at(b, i + 2));\0A        if hi < 0 || lo < 0 {\0A            Err(Escape(\22Encoding.percent_decode: invalid escape at byte \22.concat(i.to_string())))\0A        } else {\0A            let c = hi * 16 + lo;\0A            if left == 0 && c < 128 { validate_pct_acc(b, i + 3, pending, 0) }\0A            else if left == 0 && (c < 194 || c > 244) { Err(Utf8) }\0A            else {\0A                let next = pending.push(c);\0A                let remaining = if left > 0 { left - 1 }\0A                                else if c < 224 { 1 } else if c < 240 { 2 } else { 3 };\0A                if remaining > 0 { validate_pct_acc(b, i + 3, next, remaining) }\0A                else if !Bytes.is_utf8(Bytes.from_array(next)) { Err(Utf8) }\0A                else { validate_pct_acc(b, i + 3, [], 0) }\0A            }\0A        }\0A    }\0A\0A// Keep decoded UTF-8 checks separate from the raw URI alphabet. Parsing\0A// establishes the text contract that lets query_get return only Option.\0Alet validate_pct (context: String) (s: String): Result[Unit, String] =\0A    match validate_pct_acc(s.as_bytes(), 0, [], 0) {\0A        Ok(_) => Ok(()),\0A        Err(Utf8) => Err(\22Url.parse: \22.concat(context).concat(\22 is not valid UTF-8 once decoded\22)),\0A        Err(Escape(e)) => Err(\22Url.parse: \22.concat(context).concat(\22: \22).concat(e)),\0A    }\0A\0A// RFC 3986 component alphabets. Percent escapes are checked separately:\0A// admitting '%' here must never mean admitting an arbitrary following byte.\0Alet unreserved (c: Int): Bool =\0A    (c >= 65 && c <= 90) || (c >= 97 && c <= 122) || (c >= 48 && c <= 57)\0A        || c == 45 || c == 46 || c == 95 || c == 126\0A\0Alet sub_delim (c: Int): Bool =\0A    c == 33 || c == 36 || c == 38 || c == 39 || c == 40 || c == 41\0A        || c == 42 || c == 43 || c == 44 || c == 59 || c == 61\0A\0Aenum Component { Host, Path, Query, Fragment }\0A\0Alet component_char (kind: Component) (c: Int): Bool =\0A    unreserved(c) || sub_delim(c) || match kind {\0A        Host => false,\0A        Path => c == 58 || c == 64 || c == 47,\0A        Query => c == 58 || c == 64 || c == 47 || c == 63,\0A        Fragment => c == 58 || c == 64 || c == 47 || c == 63,\0A    }\0A\0A// Scan raw syntax without allocating decoded text. '%' is provisionally\0A// allowed, but its triplet and decoded UTF-8 must pass validate_pct below.\0A// All other bytes must be ASCII members of this component's grammar.\0Alet component_ok (b: Bytes) (kind: Component) (i: Int): Bool =\0A    if i >= b.len() { true }\0A    else if byte_at(b, i) == 37 || component_char(kind, byte_at(b, i)) {\0A        component_ok(b, kind, i + 1)\0A    } else { false }\0A\0Alet validate_component (context: String) (kind: Component) (s: String): Result[Unit, String] =\0A    if !component_ok(s.as_bytes(), kind, 0) {\0A        Err(\22Url.parse: invalid raw character in \22.concat(context))\0A    } else if String.contains(s, \22%\22) { validate_pct(context, s) }\0A    else { Ok(()) }\0A\0Alet hex_digit (c: Int): Bool =\0A    (c >= 48 && c <= 57) || (c >= 65 && c <= 70) || (c >= 97 && c <= 102)\0A\0A// A dotted IPv4 tail counts as two IPv6 groups. No leading zeroes,\0A// empty octets, or values outside 0..255 (RFC 3986 dec-octet).\0Alet ipv4_tail (b: Bytes) (i: Int) (octets: Int) (digits: Int) (value: Int): Bool =\0A    if i >= b.len() { octets == 3 && digits > 0 }\0A    else {\0A        let c = byte_at(b, i);\0A        if c == 46 {\0A            digits > 0 && octets < 3 && ipv4_tail(b, i + 1, octets + 1, 0, 0)\0A        } else if c >= 48 && c <= 57 {\0A            let next = value * 10 + c - 48;\0A            digits < 3 && !(digits > 0 && value == 0) && next <= 255\0A                && ipv4_tail(b, i + 1, octets, digits + 1, next)\0A        } else { false }\0A    }\0A\0Alet hex_end (b: Bytes) (i: Int): Int =\0A    if i < b.len() && hex_digit(byte_at(b, i)) { hex_end(b, i + 1) } else { i }\0A\0A// Count explicit 16-bit groups; '::' may occur once and must replace\0A// at least one group. Work on the same byte view, including IPv4 tails.\0Alet ipv6_groups (b: Bytes) (i: Int) (groups: Int) (compressed: Bool): Bool = {\0A    let end = hex_end(b, i);\0A    let digits = end - i;\0A    if digits < 1 || digits > 4 || groups >= 8 { false }\0A    else if end < b.len() && byte_at(b, end) == 46 {\0A        ipv4_tail(b, i, 0, 0, 0)\0A            && (if compressed { groups + 2 < 8 } else { groups + 2 == 8 })\0A    } else if end == b.len() {\0A        if compressed { groups + 1 < 8 } else { groups + 1 == 8 }\0A    } else if byte_at(b, end) != 58 { false }\0A    else if end + 1 < b.len() && byte_at(b, end + 1) == 58 {\0A        if compressed { false }\0A        else if end + 2 == b.len() { groups + 1 < 8 }\0A        else { ipv6_groups(b, end + 2, groups + 1, true) }\0A    } else { ipv6_groups(b, end + 1, groups + 1, compressed) }\0A}\0A\0Alet ipv6_ok (host: String): Bool = {\0A    let b = host.as_bytes();\0A    if b.len() < 2 || b.len() > 45 { false }\0A    else if byte_at(b, 0) == 58 {\0A        byte_at(b, 1) == 58 && (b.len() == 2 || ipv6_groups(b, 2, 0, true))\0A    } else { ipv6_groups(b, 0, 0, false) }\0A}\0A\0A/// `a=1&b=2` into pairs, still encoded. A field with no `=` has an\0A/// empty value (`?flag`), and an empty field is skipped (`?a=1&&b=2`)\0A/// rather than becoming a nameless pair.\0Alet parse_params_acc (fields: Array[String]) (i: Int) (acc: Array[Param]): Array[Param] =\0A    if i >= fields.len() { acc }\0A    else if String.is_empty(fields[i]) { parse_params_acc(fields, i + 1, acc) }\0A    else {\0A        let kv = split_first(fields[i], \22=\22);\0A        parse_params_acc(fields, i + 1, acc.push(Param { name: kv.before, value: kv.after }))\0A    }\0A\0Alet raw_params (raw_query: String): Array[Param] =\0A    if String.is_empty(raw_query) { [] }\0A    else { parse_params_acc(String.split(raw_query, \22&\22), 0, []) }\0A\0A/// The authority, minus any `[...]` IPv6 brackets, plus a port.\0A///\0A/// Brackets are STRIPPED rather than kept: `Net.connect_to` passes the\0A/// host to `getaddrinfo`, which wants `::1` and not `[::1]`. They\0A/// exist in the URL only to keep the colons in an IPv6 address from\0A/// being read as a port separator, which is a syntax problem and not\0A/// something the host itself carries.\0Alet parse_authority (authority: String) (scheme: String): Result[Url, String] =\0A    if String.contains(authority, \22@\22) {\0A        Err(\22Url.parse: userinfo (user@host) is not supported\22)\0A    } else if String.is_empty(authority) {\0A        Err(\22Url.parse: missing host\22)\0A    } else if String.starts_with(authority, \22[\22) {\0A        match String.index_of(authority, \22]\22) {\0A            None => Err(\22Url.parse: unterminated IPv6 address\22),\0A            Some(close) => {\0A                let host = String.slice(authority, 1, close);\0A                let rest = String.slice(authority, close + 1, clen(authority));\0A                if String.is_empty(host) { Err(\22Url.parse: missing host\22) }\0A                else if !ipv6_ok(host) { Err(\22Url.parse: invalid or unsupported IP literal\22) }\0A                else if String.is_empty(rest) { Ok(host_port(scheme, host, default_port(scheme))) }\0A                else if !String.starts_with(rest, \22:\22) { Err(\22Url.parse: trailing text after IPv6 address\22) }\0A                else { with_port(scheme, host, String.slice(rest, 1, clen(rest))) }\0A            },\0A        }\0A    } else {\0A        let hp = split_first(authority, \22:\22);\0A        if String.is_empty(hp.before) { Err(\22Url.parse: missing host\22) }\0A        else { match validate_component(\22host\22, Host, hp.before) {\0A            Err(e) => Err(e),\0A            Ok(_) => if !hp.found { Ok(host_port(scheme, hp.before, default_port(scheme))) }\0A                     else { with_port(scheme, hp.before, hp.after) },\0A        } }\0A    }\0A\0A/// A partially-built `Url`; the caller fills in path/query/fragment.\0Alet host_port (scheme: String) (host: String) (port: Int): Url =\0A    Url { scheme: scheme, host: host, port: port, path: \22/\22, raw_query: \22\22, fragment: \22\22 }\0A\0Alet port_digits (b: Bytes) (i: Int): Bool =\0A    if i >= b.len() { true }\0A    else { let c = byte_at(b, i); c >= 48 && c <= 57 && port_digits(b, i + 1) }\0A\0Alet with_port (scheme: String) (host: String) (text: String): Result[Url, String] =\0A    if String.is_empty(text) { Err(\22Url.parse: empty port\22) }\0A    else if !port_digits(text.as_bytes(), 0) { Err(\22Url.parse: invalid port: \22.concat(text)) }\0A    else { match String.parse_int(text) {\0A        Err(_) => Err(\22Url.parse: invalid port: \22.concat(text)),\0A        Ok(p) => if p < 1 || p > 65535 { Err(\22Url.parse: port out of range: \22.concat(text)) }\0A                 else { Ok(host_port(scheme, host, p)) },\0A    } }\0A\0A// Reject raw ASCII whitespace and controls before splitting components.\0A// Percent escapes remain encoded; %0D and %0A cannot delimit wire lines.\0Alet raw_url_ok_acc (b: Bytes) (i: Int): Bool =\0A    if i >= b.len() { true }\0A    else {\0A        let c = byte_at(b, i);\0A        if c <= 32 || c == 127 { false } else { raw_url_ok_acc(b, i + 1) }\0A    }\0A\0A/// Absolute URLs only. A scheme-relative (`//host/x`) or relative\0A/// (`/x`) reference has no meaning without a base to resolve against,\0A/// and resolution is a different function than parsing.\0A///\0A/// Components follow RFC 3986: raw spaces, controls, non-ASCII text,\0A/// and characters outside each component's grammar must be percent-encoded.\0A/// Bracketed hosts must be IPv6 literals, including optional dotted IPv4\0A/// tails; IPvFuture and scoped zone identifiers are not supported.\0A/// Percent escapes must be complete hex triplets; decoded components\0A/// must be valid UT