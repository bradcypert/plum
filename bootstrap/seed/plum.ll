           const char *oid, size_t len)\0A{\0A    while (list != NULL) {\0A        if (list->oid.len == len &&\0A            memcmp(list->oid.p, oid, len) == 0) {\0A            break;\0A        }\0A\0A        list = list->next;\0A    }\0A\0A    return list;\0A}\0A\0A#endif /* MBEDTLS_ASN1_PARSE_C */\0A\00" }
