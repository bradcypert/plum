@.str45234 = private global { i64, i64, [436 x i8] } { i64 -1, i64 435, [436 x i8] c"/**\0A * \5Cfile private_access.h\0A *\0A * \5Cbrief Macro wrapper for struct's members.\0A */\0A/*\0A *  Copyright The Mbed TLS Contributors\0A *  SPDX-License-Identifier: Apache-2.0 OR GPL-2.0-or-later\0A */\0A\0A#ifndef MBEDTLS_PRIVATE_ACCESS_H\0A#define MBEDTLS_PRIVATE_ACCESS_H\0A\0A#ifndef MBEDTLS_ALLOW_PRIVATE_ACCESS\0A#define MBEDTLS_PRIVATE(member) private_##member\0A#else\0A#define MBEDTLS_PRIVATE(member) member\0A#endif\0A\0A#endif /* MBEDTLS_PRIVATE_ACCESS_H */\0A\00" }
