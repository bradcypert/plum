0A/// result, not an error. Failing to START the process is the `Err`.\0Apub struct ProcessResult { pub exit_code: Int, pub stdout: String, pub stderr: String }\0A\0A/// NO leading separator: `process_run` points argv[1] at the WHOLE\0A/// joined string, so a leading tab makes argv[1] empty and pushes the\0A/// last real argument past `argc`, silently dropping it. A plain fold\0A/// that prefixes every element is NOT equivalent.\0Alet join_args_acc (args: Array[String]) (i: Int) (acc: String): String =\0A    if i >= args.len() { acc }\0A    else if i == 0 { join_args_acc(args, i + 1, args[i]) }\0A    else { join_args_acc(args, i + 1, acc.concat(\22\5Ct\22).concat(args[i])) }\0A\0A/// A non-zero exit code is an ordinary `Ok`. `Err` means the process\0A/// could not be started at all.\0Apub let run_process (program: String) (args: Array[String]): Result[ProcessResult, String] = {\0A    let joined = join_args_acc(args, 0, \22\22);\0A    let handle = process_run_raw(program, joined, args.len());\0A    if handle < 0 { Err(\22Os.run_process: could not start process: \22.concat(program)) }\0A    else {\0A        let result = ProcessResult {\0A            exit_code: process_exit_code_raw(handle),\0A            stdout: process_stdout_raw(handle),\0A            stderr: process_stderr_raw(handle),\0A        };\0A        let freed = process_free_raw(handle);\0A        Ok(result)\0A    }\0A}\0A\0A// --- Process identity ---\0A//\0A// argv, the working directory, stdin and stderr. `args()` has\0A// always existed as a compiler builtin and is documented now;\0A// the rest was reachable only through the private C shims the\0A// language server uses.\0Aextern \22C\22 {\0A    fn os_cwd() -> CStr;\0A    fn os_chdir(path: CStr) -> Int;\0A    fn stdin_line_n() -> Int;\0A    fn stdin_line_data() -> CStr;\0A    fn stdin_bytes_n(max: Int) -> Int;\0A    fn stdin_bytes_data() -> CStr;\0A    fn stdin_line_timed(timeout_nanos: Int) -> Int;\0A    fn stdin_bytes_timed(max: Int, timeout_nanos: In