@.str40585 = private global { i64, i64, [5360 x i8] } { i64 -1, i64 5359, [5360 x i8] c"/**\0A * \5Cfile md5.h\0A *\0A * \5Cbrief MD5 message digest algorithm (hash function)\0A *\0A * \5Cwarning   MD5 is considered a weak message digest and its use constitutes a\0A *            security risk. We recommend considering stronger message\0A *            digests instead.\0A */\0A/*\0A *  Copyright The Mbed TLS Contributors\0A *  SPDX-License-Identifier: Apache-2.0 OR GPL-2.0-or-later\0A */\0A#ifndef MBEDTLS_MD5_H\0A#define MBEDTLS_MD5_H\0A#include \22mbedtls/private_access.h\22\0A\0A#include \22mbedtls/build_info.h\22\0A\0A#include <stddef.h>\0A#include <stdint.h>\0A\0A#ifdef __cplusplus\0Aextern \22C\22 {\0A#endif\0A\0A#if !defined(MBEDTLS_MD5_ALT)\0A// Regular implementation\0A//\0A\0A/**\0A * \5Cbrief          MD5 context structure\0A *\0A * \5Cwarning        MD5 is considered a weak message digest and its use\0A *                 constitutes a security risk. We recommend considering\0A *                 stronger message digests instead.\0A *\0A */\0Atypedef struct mbedtls_md5_context {\0A    uint32_t MBEDTLS_PRIVATE(total)[2];          /*!< number of bytes processed  */\0A    uint32_t MBEDTLS_PRIVATE(state)[4];          /*!< intermediate digest state  */\0A    unsigned char MBEDTLS_PRIVATE(buffer)[64];   /*!< data block being processed */\0A}\0Ambedtls_md5_context;\0A\0A#else  /* MBEDTLS_MD5_ALT */\0A#include \22md5_alt.h\22\0A#endif /* MBEDTLS_MD5_ALT */\0A\0A/**\0A * \5Cbrief          Initialize MD5 context\0A *\0A * \5Cparam ctx      MD5 context to be initialized\0A *\0A * \5Cwarning        MD5 is considered a weak message digest and its use\0A *                 constitutes a security risk. We recommend considering\0A *                 stronger message digests instead.\0A *\0A */\0Avoid mbedtls_md5_init(mbedtls_md5_context *ctx);\0A\0A/**\0A * \5Cbrief          Clear MD5 context\0A *\0A * \5Cparam ctx      MD5 context to be cleared\0A *\0A * \5Cwarning        MD5 is considered a weak message digest and its use\0A *                 constitutes a security risk. We recommend considering\0A *                 stronger message digests instead.\0A *\0A */\0Avoid mbedtls_md5_free(mbedtls_md5_context *ctx);\0A\0A/**\0A * \5Cbrief          Clone (the state of) an MD5 context\0A *\0A * \5Cparam dst      The destination context\0A * \5Cparam src      The context to be cloned\0A *\0A * \5Cwarning        MD5 is considered a weak message digest and its use\0A *                 constitutes a security risk. We recommend considering\0A *                 stronger message digests instead.\0A *\0A */\0Avoid mbedtls_md5_clone(mbedtls_md5_context *dst,\0A                       const mbedtls_md5_context *src);\0A\0A/**\0A * \5Cbrief          MD5 context setup\0A *\0A * \5Cparam ctx      context to be initialized\0A *\0A * \5Creturn         0 if successful\0A *\0A * \5Cwarning        MD5 is considered a weak message digest and its use\0A *                 constitutes a security risk. We recommend considering\0A *                 stronger message digests instead.\0A *\0A */\0Aint mbedtls_md5_starts(mbedtls_md5_context *ctx);\0A\0A/**\0A * \5Cbrief          MD5 process buffer\0A *\0A * \5Cparam ctx      MD5 context\0A * \5Cparam input    buffer holding the data\0A * \5Cparam ilen     length of the input data\0A *\0A * \5Creturn         0 if successful\0A *\0A * \5Cwarning        MD5 is considered a weak message digest and its use\0A *                 constitutes a security risk. We recommend considering\0A *                 stronger message digests instead.\0A *\0A */\0Aint mbedtls_md5_update(mbedtls_md5_context *ctx,\0A                       const unsigned char *input,\0A                       size_t ilen);\0A\0A/**\0A * \5Cbrief          MD5 final digest\0A *\0A * \5Cparam ctx      MD5 context\0A * \5Cparam output   MD5 checksum result\0A *\0A * \5Creturn         0 if successful\0A *\0A * \5Cwarning        MD5 is considered a weak message digest and its use\0A *                 constitutes a security risk. We recommend considering\0A *                 stronger message digests instead.\0A *\0A */\0Aint mbedtls_md5_finish(mbedtls_md5_context *ctx,\0A                       unsigned char output[16]);\0A\0A/**\0A * \5Cbrief          MD5 process data block (internal use only)\0A *\0A * \5Cparam ctx      MD5 context\0A * \5Cparam data     buffer holding one block of data\0A *\0A * \5Creturn         0 if successful\0A *\0A * \5Cwarning        MD5 is considered a weak message digest and its use\0A *                 constitutes a security risk. We recommend considering\0A *                 stronger message digests instead.\0A *\0A */\0Aint mbedtls_internal_md5_process(mbedtls_md5_context *ctx,\0A                                 const unsigned char data[64]);\0A\0A/**\0A * \5Cbrief          Output = MD5( input buffer )\0A *\0A * \5Cparam input    buffer holding the data\0A * \5Cparam ilen     length of the input data\0A * \5Cparam output   MD5 checksum result\0A *\0A * \5Creturn         0 if successful\0A *\0A * \5Cwarning        MD5 is considered a weak message digest and its use\0A *                 constitutes a security risk. We recommend considering\0A *                 stronger message digests instead.\0A *\0A */\0Aint mbedtls_md5(const unsigned char *input,\0A                size_t ilen,\0A                unsigned char output[16]);\0A\0A#if defined(MBEDTLS_SELF_TEST)\0A\0A/**\0A * \5Cbrief          Checkup routine\0A *\0A * \5Creturn         0 if successful, or 1 if the test failed\0A *\0A * \5Cwarning        MD5 is considered a weak message digest and its use\0A *                 constitutes a security risk. We recommend considering\0A *                 stronger message digests instead.\0A *\0A */\0Aint mbedtls_md5_self_test(int verbose);\0A\0A#endif /* MBEDTLS_SELF_TEST */\0A\0A#ifdef __cplusplus\0A}\0A#endif\0A\0A#endif /* mbedtls_md5.h */\0A\00" }
