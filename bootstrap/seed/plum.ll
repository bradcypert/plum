 text, -1, wide, n) != n) {\0A        free(wide);\0A        return NULL;\0A    }\0A    return wide;\0A}\0A\0A// Quoting only examines ASCII syntax, so it is safe to quote UTF-8\0A// before converting. Both spawn paths use this one command-line builder.\0Astatic wchar_t *plum_win_command_line(char **argv) {\0A    // A valid command line has at most 32766 UTF-16 units. Each unit\0A    // takes at most three UTF-8 bytes, so even rejected input needs no\0A    // more than this bounded quoting buffer.\0A    const size_t max_bytes = 3 * 32766 + 1;\0A    size_t cap = 1, len = 0;\0A    for (size_t i = 0; argv[i] != NULL; i++) {\0A        size_t n = strlen(argv[i]);\0A        if (n >= max_bytes) return NULL;\0A        size_t growth = n * 2 + 3;\0A        cap = growth > max_bytes - cap ? max_bytes : cap + growth;\0A    }\0A    char *quoted = malloc(cap);\0A    if (quoted == NULL) return NULL;\0A    for (size_t i = 0; argv[i] != NULL; i++) {\0A        if (plum_win_append_arg(quoted, cap, &len, argv[i]) != 0) {\0A            free(quoted);\0A            return NULL;\0A        }\0A    }\0A    quoted[len] = '\5C0';\0A    // Count UTF-16 units before allocating the wide command line.\0A    wchar_t *wide = plum_win_utf16(quoted, 32767);\0A    free(quoted);\0A    return wide;\0A}\0A\0Atypedef struct {\0A    wchar_t *text;\0A    int key_len;\0A    size_t order; // later entries win, including duplicate overlay keys\0A    int owned;   // parent entries borrow the GetEnvironmentStringsW snapshot\0A} PlumWinEnvEntry;\0A\0Astatic int plum_win_env_key_compare(const PlumWinEnvEntry *a, const PlumWinEnvEntry *b) {\0A    return CompareStringOrdinal(a->text, a->key_len, b->text, b->key_len, TRUE) - CSTR_EQUAL;\0A}\0A\0Astatic int plum_win_env_compare(const void *left, const void *right) {\0A    const PlumWinEnvEntry *a = left, *b = right;\0A    int cmp = plum_win_env_key_compare(a, b);\0A    if (cmp != 0) return cmp;\0A    return (a->order > b->order) - (a->order < b->order);\0A}\0A\0A// Succe