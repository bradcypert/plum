@.str40052 = private global { i64, i64, [56602 x i8] } { i64 -1, i64 56601, [56602 x i8] c"/**\0A * \5Cfile x509_crt.h\0A *\0A * \5Cbrief X.509 certificate parsing and writing\0A */\0A/*\0A *  Copyright The Mbed TLS Contributors\0A *  SPDX-License-Identifier: Apache-2.0 OR GPL-2.0-or-later\0A */\0A#ifndef MBEDTLS_X509_CRT_H\0A#define MBEDTLS_X509_CRT_H\0A#include \22mbedtls/private_access.h\22\0A\0A#include \22mbedtls/build_info.h\22\0A\0A#include \22mbedtls/x509.h\22\0A#include \22mbedtls/x509_crl.h\22\0A#include \22mbedtls/bignum.h\22\0A\0A/**\0A * \5Caddtogroup x509_module\0A * \5C{\0A */\0A\0A#ifdef __cplusplus\0Aextern \22C\22 {\0A#endif\0A\0A/**\0A * \5Cname Structures and functions for parsing and writing X.509 certificates\0A * \5C{\0A */\0A\0A/**\0A * Container for an X.509 certificate. The certificate may be chained.\0A *\0A * Some fields of this structure are publicly readable. Do not modify\0A * them except via Mbed TLS library functions: the effect of modifying\0A * those fields or the data that those fields points to is unspecified.\0A */\0Atypedef struct mbedtls_x509_crt {\0A    int MBEDTLS_PRIVATE(own_buffer);                     /**< Indicates if \5Cc raw is owned\0A                                                          *   by the structure or not.        */\0A    mbedtls_x509_buf raw;               /**< The raw certificate data (DER). */\0A    mbedtls_x509_buf tbs;               /**< The raw certificate body (DER). The part that is To Be Signed. */\0A\0A    int version;                /**< The X.509 version. (1=v1, 2=v2, 3=v3) */\0A    mbedtls_x509_buf serial;            /**< Unique id for certificate issued by a specific CA. */\0A    mbedtls_x509_buf sig_oid;           /**< Signature algorithm, e.g. sha1RSA */\0A\0A    mbedtls_x509_buf issuer_raw;        /**< The raw issuer data (DER). Used for quick comparison. */\0A    mbedtls_x509_buf subject_raw;       /**< The raw subject data (DER). Used for quick comparison. */\0A\0A    mbedtls_x509_name issuer;           /**< The parsed issuer data (named information object). */\0A    mbedtls_x509_name subject;          /**< The parsed subject data (named information object). */\0A\0A    mbedtls_x509_time valid_from;       /**< Start time of certificate validity. */\0A    mbedtls_x509_time valid_to;         /**< End time of certificate validity. */\0A\0A    mbedtls_x509_buf pk_raw;\0A    mbedtls_pk_context pk;              /**< Container for the public key context. */\0A\0A    mbedtls_x509_buf issuer_id;         /**< Optional X.509 v2/v3 issuer unique identifier. */\0A    mbedtls_x509_buf subject_id;        /**< Optional X.509 v2/v3 subject unique identifier. */\0A    mbedtls_x509_buf v3_ext;            /**< Optional X.509 v3 extensions.  */\0A    mbedtls_x509_sequence subject_alt_names; /**< Optional list of raw entries of Subject Alternative Names extension. These can be later parsed by mbedtls_x509_parse_subject_alt_name. */\0A    mbedtls_x509_buf subject_key_id;    /**< Optional X.509 v3 extension subject key identifier. */\0A    mbedtls_x509_authority authority_key_id;    /**< Optional X.509 v3 extension authority key identifier. */\0A\0A    mbedtls_x509_sequence certificate_policies; /**< Optional list of certificate policies (Only anyPolicy is printed and enforced, however the rest of the policies are still listed). */\0A\0A    int MBEDTLS_PRIVATE(ext_types);              /**< Bit string containing detected and parsed extensions */\0A    int MBEDTLS_PRIVATE(ca_istrue);              /**< Optional Basic Constraint extension value: 1 if this certificate belongs to a CA, 0 otherwise. */\0A    int MBEDTLS_PRIVATE(max_pathlen);            /**< Optional Basic Constraint extension value: The maximum path length to the root certificate. Path length is 1 higher than RFC 5280 'meaning', so 1+ */\0A\0A    unsigned int MBEDTLS_PRIVATE(key_usage);     /**< Optional key usage extension value: See the values in x509.h */\0A\0A    mbedtls_x509_sequence ext_key_usage; /**< Optional list of extended key usage OIDs. */\0A\0A    unsigned char MBEDTLS_PRIVATE(ns_cert_type); /**< Optional Netscape certificate type extension value: See the values in x509.h */\0A\0A    mbedtls_x509_buf MBEDTLS_PRIVATE(sig);               /**< Signature: hash of the tbs part signed with the private key. */\0A    mbedtls_md_type_t MBEDTLS_PRIVATE(sig_md);           /**< Internal representation of the MD algorithm of the signature algorithm, e.g. MBEDTLS_MD_SHA256 */\0A    mbedtls_pk_type_t MBEDTLS_PRIVATE(sig_pk);           /**< Internal representation of the Public Key algorithm of the signature algorithm, e.g. MBEDTLS_PK_RSA */\0A    void *MBEDTLS_PRIVATE(sig_opts);             /**< Signature options to be passed to mbedtls_pk_verify_ext(), e.g. for RSASSA-PSS */\0A\0A    /** Next certificate in the linked list that constitutes the CA chain.\0A     * \5Cp NULL indicates the end of the list.\0A     * Do not modify this field directly. */\0A    struct mbedtls_x509_crt *next;\0A}\0Ambedtls_x509_crt;\0A\0A/**\0A * Build flag from an algorithm/curve identifier (pk, md, ecp)\0A * Since 0 is always XXX_NONE, ignore it.\0A */\0A#define MBEDTLS_X509_ID_FLAG(id)   (1 << ((id) - 1))\0A\0A/**\0A * Security profile for certificate verification.\0A *\0A * All lists are bitfields, built by ORing flags from MBEDTLS_X509_ID_FLAG().\0A *\0A * The fields of this structure are part of the public API and can be\0A * manipulated directly by applications. Future versions of the library may\0A * add extra fields or reorder existing fields.\0A *\0A * You can create custom profiles by starting from a copy of\0A * an existing profile, such as mbedtls_x509_crt_profile_default or\0A * mbedtls_x509_ctr_profile_none and then tune it to your needs.\0A *\0A * For example to allow SHA-224 in addition to the default:\0A *\0A *  mbedtls_x509_crt_profile my_profile = mbedtls_x509_crt_profile_default;\0A *  my_profile.allowed_mds |= MBEDTLS_X509_ID_FLAG( MBEDTLS_MD_SHA224 );\0A *\0A * Or to allow only RSA-3072+ with SHA-256:\0A *\0A *  mbedtls_x509_crt_profile my_profile = mbedtls_x509_crt_profile_none;\0A *  my_profile.allowed_mds = MBEDTLS_X509_ID_FLAG( MBEDTLS_MD_SHA256 );\0A *  my_profile.allowed_pks = MBEDTLS_X509_ID_FLAG( MBEDTLS_PK_RSA );\0A *  my_profile.rsa_min_bitlen = 3072;\0A */\0Atypedef struct mbedtls_x509_crt_profile {\0A    uint32_t allowed_mds;       /**< MDs for signatures         */\0A    uint32_t allowed_pks;       /**< PK algs for public keys;\0A                                 *   this applies to all certificates\0A                                 *   in the provided chain.     */\0A    uint32_t allowed_curves;    /**< Elliptic curves for ECDSA  */\0A    uint32_t rsa_min_bitlen;    /**< Minimum size for RSA keys  */\0A}\0Ambedtls_x509_crt_profile;\0A\0A#define MBEDTLS_X509_CRT_VERSION_1              0\0A#define MBEDTLS_X509_CRT_VERSION_2              1\0A#define MBEDTLS_X509_CRT_VERSION_3              2\0A\0A#define MBEDTLS_X509_RFC5280_MAX_SERIAL_LEN 20\0A#define MBEDTLS_X509_RFC5280_UTC_TIME_LEN   15\0A\0A#if !defined(MBEDTLS_X509_MAX_FILE_PATH_LEN)\0A#define MBEDTLS_X509_MAX_FILE_PATH_LEN 512\0A#endif\0A\0A/* This macro unfolds to the concatenation of macro invocations\0A * X509_CRT_ERROR_INFO( error code,\0A *                             error code as string,\0A *                             human readable description )\0A * where X509_CRT_ERROR_INFO is defined by the user.\0A * See x509_crt.c for an example of how to use this. */\0A#define MBEDTLS_X509_CRT_ERROR_INFO_LIST                                  \5C\0A    X509_CRT_ERROR_INFO(MBEDTLS_X509_BADCERT_EXPIRED,            \5C\0A                        \22MBEDTLS_X509_BADCERT_EXPIRED\22,          \5C\0A                        \22The certificate validity has expired\22) \5C\0A    X509_CRT_ERROR_INFO(MBEDTLS_X509_BADCERT_REVOKED,            \5C\0A                        \22MBEDTLS_X509_BADCERT_REVOKED\22,          \5C\0A                        \22The certificate has been revoked (is on a CRL)\22) \5C\0A    X509_CRT_ERROR_INFO(MBEDTLS_X509_BADCERT_CN_MISMATCH,                  \5C\0A                        \22MBEDTLS_X509_BADCERT_CN_MISMATCH\22,                \5C\0A                        \22The certificate Common Name (CN) does not match with the expected CN\22) \5C\0A    X509_CRT_ERROR_INFO(MBEDTLS_X509_BADCERT_NOT_TRUSTED,                             \5C\0A                        \22MBEDTLS_X509_BADCERT_NOT_TRUSTED\22,                           \5C\0A                        \22The certificate is not correctly signed by the trusted CA\22) \5C\0A    X509_CRT_ERROR_INFO(MBEDTLS_X509_BADCRL_NOT_TRUSTED,                      \5C\0A                        \22MBEDTLS_X509_BADCRL_NOT_TRUSTED\22,                    \5C\0A                        \22The CRL is not correctly signed by the trusted CA\22) \5C\0A    X509_CRT_ERROR_INFO(MBEDTLS_X509_BADCRL_EXPIRED,    \5C\0A                        \22MBEDTLS_X509_BADCRL_EXPIRED\22,  \5C\0A                        \22The CRL is expired\22)          \5C\0A    X509_CRT_ERROR_INFO(MBEDTLS_X509_BADCERT_MISSING,   \5C\0A                        \22MBEDTLS_X509_BADCERT_MISSING\22, \5C\0A                        \22Certificate was missing\22)     \5C\0A    X509_CRT_ERROR_INFO(MBEDTLS_X509_BADCERT_SKIP_VERIFY,         \5C\0A                        \22MBEDTLS_X509_BADCERT_SKIP_VERIFY\22,       \5C\0A                        \22Certificate verification was skipped\22)  \5C\0A    X509_CRT_ERROR_INFO(MBEDTLS_X509_BADCERT_OTHER,                          \5C\0A                        \22MBEDTLS_X509_BADCERT_OTHER\22,                        \5C\0A                        \22Other reason (can be used by verify callback)\22)    \5C\0A    X509_CRT_ERROR_INFO(MBEDTLS_X509_BADCERT_FUTURE,                         \5C\0A                        \22MBEDTLS_X509_BADCERT_FUTURE\22,                       \5C\0A                        \22The certificate validity starts in the future\22)    \5C\0A    X509_CRT_ERROR_INFO(MBEDTLS_X509_BADCRL_FUTURE,     \5C\0A                        \22MBEDTLS_X509_BADCRL_FUTURE\22,   \5C\0A                        \22The CRL is from the future\22)  \5C\0A    X509_CRT_ERROR_INFO(MBEDTLS_X509_BADCERT_KEY_USAGE,                      \5C\0A                        \22MBEDTLS_X509_BADCERT_KEY_USAGE\22,                    \5C\0A                        \22Usage does not match the keyUsage extension\22)      \5C\0A    X509_CRT_ERROR_INFO(MBEDTLS_X509_BADCERT_EXT_KEY_USAGE,                       \5C\0A                        \22MBEDTLS_X509_BADCERT_EXT_KEY_USAGE\22,                     \5C\0A                        \22Usage does not match the extendedKeyUsage extension\22)   \5C\0A    X509_CRT_ERROR_INFO(MBEDTLS_X509_BADCERT_NS_CERT_TYPE,                        \5C\0A                        \22MBEDTLS_X509_BADCERT_NS_CERT_TYPE\22,                      \5C\0A                        \22Usage does not match the nsCertType extension\22)         \5C\0A    X509_CRT_ERROR_INFO(MBEDTLS_X509_BADCERT_BAD_MD,                              \5C\0A                        \22MBEDTLS_X509_BADCERT_BAD_MD\22,                            \5C\0A                        \22The certificate is signed with an unacceptable hash.\22)  \5C\0A    X509_CRT_ERROR_INFO(MBEDTLS_X509_BADCERT_BAD_PK,                                                  \5C\0A                        \22MBEDTLS_X509_BADCERT_BAD_PK\22,                                                \5C\0A                        \22The certificate is signed with an unacceptable PK alg (eg RSA vs ECDSA).\22)  \5C\0A    X509_CRT_ERROR_INFO(MBEDTLS_X509_BADCERT_BAD_KEY,                                                            \5C\0A                        \22MBEDTLS_X509_BADCERT_BAD_KEY\22,                                                          \5C\0A                        \22The certificate is signed with an unacceptable key (eg bad curve, RSA too short).\22)    \5C\0A    X509_CRT_ERROR_INFO(MBEDTLS_X509_BADCRL_BAD_MD,                          \5C\0A                        \22MBEDTLS_X509_BADCRL_BAD_MD\22,                        \5C\0A                        \22The CRL is signed with an unacceptable hash.\22)     \5C\0A    X509_CRT_ERROR_INFO(MBEDTLS_X509_BADCRL_BAD_PK,                                            \5C\0A                        \22MBEDTLS_X509_BADCRL_BAD_PK\22,                                          \5C\0A                        \22The CRL is signed with an unacceptable PK alg (eg RSA vs ECDSA).\22)   \5C\0A    X509_CRT_ERROR_INFO(MBEDTLS_X509_BADCRL_BAD_KEY,                                                    \5C\0A                        \22MBEDTLS_X509_BADCRL_BAD_KEY\22,                                                  \5C\0A                        \22The CRL is signed with an unacceptable key (eg bad curve, RSA too short).\22)\0A\0A/**\0A * Container for writing a certificate (CRT)\0A */\0Atypedef struct mbedtls_x509write_cert {\0A    int MBEDTLS_PRIVATE(version);\0A    unsigned char MBEDTLS_PRIVATE(serial)[MBEDTLS_X509_RFC5280_MAX_SERIAL_LEN];\0A    size_t MBEDTLS_PRIVATE(serial_len);\0A    mbedtls_pk_context *MBEDTLS_PRIVATE(subject_key);\0A    mbedtls_pk_context *MBEDTLS_PRIVATE(issuer_key);\0A    mbedtls_asn1_named_data *MBEDTLS_PRIVATE(subject);\0A    mbedtls_asn1_named_data *MBEDTLS_PRIVATE(issuer);\0A    mbedtls_md_type_t MBEDTLS_PRIVATE(md_alg);\0A    char MBEDTLS_PRIVATE(not_before)[MBEDTLS_X509_RFC5280_UTC_TIME_LEN + 1];\0A    char MBEDTLS_PRIVATE(not_after)[MBEDTLS_X509_RFC5280_UTC_TIME_LEN + 1];\0A    mbedtls_asn1_named_data *MBEDTLS_PRIVATE(extensions);\0A}\0Ambedtls_x509write_cert;\0A\0A/**\0A * \5Cbrief           Set Subject Alternative Name\0A *\0A * \5Cparam ctx       Certificate context to use\0A * \5Cparam san_list  List of SAN values\0A *\0A * \5Creturn          0 if successful, or MBEDTLS_ERR_X509_ALLOC_FAILED\0A *\0A * \5Cnote            \22dnsName\22, \22uniformResourceIdentifier\22, \22IP address\22,\0A *                  \22otherName\22, and \22DirectoryName\22, as defined in RFC 5280,\0A *                  are supported.\0A */\0Aint mbedtls_x509write_crt_set_subject_alternative_name(mbedtls_x509write_cert *ctx,\0A                                                       const mbedtls_x509_san_list *san_list);\0A\0A/**\0A * Item in a verification chain: cert and flags for it\0A */\0Atypedef struct {\0A    mbedtls_x509_crt *MBEDTLS_PRIVATE(crt);\0A    uint32_t MBEDTLS_PRIVATE(flags);\0A} mbedtls_x509_crt_verify_chain_item;\0A\0A/**\0A * Max size of verification chain: end-entity + intermediates + trusted root\0A */\0A#define MBEDTLS_X509_MAX_VERIFY_CHAIN_SIZE  (MBEDTLS_X509_MAX_INTERMEDIATE_CA + 2)\0A\0A/**\0A * Verification chain as built by \5Cc mbedtls_crt_verify_chain()\0A */\0Atypedef struct {\0A    mbedtls_x509_crt_verify_chain_item MBEDTLS_PRIVATE(items)[MBEDTLS_X509_MAX_VERIFY_CHAIN_SIZE];\0A    unsigned MBEDTLS_PRIVATE(len);\0A\0A#if defined(MBEDTLS_X509_TRUSTED_CERTIFICATE_CALLBACK)\0A    /* This stores the list of potential trusted signers obtained from\0A     * the CA callback used for the CRT verification, if configured.\0A     * We must track it somewhere because the callback passes its\0A     * ownership to the caller. */\0A    mbedtls_x509_crt *MBEDTLS_PRIVATE(trust_ca_cb_result);\0A#endif /* MBEDTLS_X509_TRUSTED_CERTIFICATE_CALLBACK */\0A} mbedtls_x509_crt_verify_chain;\0A\0A#if defined(MBEDTLS_ECDSA_C) && defined(MBEDTLS_ECP_RESTARTABLE)\0A\0A/**\0A * \5Cbrief       Context for resuming X.509 verify operations\0A */\0Atypedef struct {\0A    /* for check_signature() */\0A    mbedtls_pk_restart_ctx MBEDTLS_PRIVATE(pk);\0A\0A    /* for find_parent_in() */\0A    mbedtls_x509_crt *MBEDTLS_PRIVATE(parent); /* non-null iff parent_in in progress */\0A    mbedtls_x509_crt *MBEDTLS_PRIVATE(fallback_parent);\0A    int MBEDTLS_PRIVATE(fallback_signature_is_good);\0A\0A    /* for find_parent() */\0A    int MBEDTLS_PRIVATE(parent_is_trusted); /* -1 if find_parent is not in progress */\0A\0A    /* for verify_chain() */\0A    enum {\0A        x509_crt_rs_none,\0A        x509_crt_rs_find_parent,\0A    } MBEDTLS_PRIVATE(in_progress);  /* none if no operation is in progress */\0A    int MBEDTLS_PRIVATE(self_cnt);\0A    mbedtls_x509_crt_verify_chain MBEDTLS_PRIVATE(ver_chain);\0A\0A} mbedtls_x509_crt_restart_ctx;\0A\0A#else /* MBEDTLS_ECDSA_C && MBEDTLS_ECP_RESTARTABLE */\0A\0A/* Now we can declare functions that take a pointer to that */\0Atypedef void mbedtls_x509_crt_restart_ctx;\0A\0A#endif /* MBEDTLS_ECDSA_C && MBEDTLS_ECP_RESTARTABLE */\0A\0A#if defined(MBEDTLS_X509_CRT_PARSE_C)\0A/**\0A * Default security profile. Should provide a good balance between security\0A * and compatibility with current deployments.\0A *\0A * This profile permits:\0A * - SHA2 hashes with at least 256 bits: SHA-256, SHA-384, SHA-512.\0A * - Elliptic curves with 255 bits and above except secp256k1.\0A * - RSA with 2048 bits and above.\0A *\0A * New minor versions of Mbed TLS may extend this profile, for example if\0A * new algorithms are added to the library. New minor versions of Mbed TLS will\0A * not reduce this profile unless serious security concerns require it.\0A */\0Aextern const mbedtls_x509_crt_profile mbedtls_x509_crt_profile_default;\0A\0A/**\0A * Expected next default profile. Recommended for new deployments.\0A * Currently targets a 128-bit security level, except for allowing RSA-2048.\0A * This profile may change at any time.\0A */\0Aextern const mbedtls_x509_crt_profile mbedtls_x509_crt_profile_next;\0A\0A/**\0A * NSA Suite B profile.\0A */\0Aextern const mbedtls_x509_crt_profile mbedtls_x509_crt_profile_suiteb;\0A\0A/**\0A * Empty profile that allows nothing. Useful as a basis for constructing\0A * custom profiles.\0A */\0Aextern const mbedtls_x509_crt_profile mbedtls_x509_crt_profile_none;\0A\0A/**\0A * \5Cbrief          Parse a single DER formatted certificate and add it\0A *                 to the end of the provided chained list.\0A *\0A * \5Cnote           If #MBEDTLS_USE_PSA_CRYPTO is enabled, the PSA crypto\0A *                 subsystem must have been initialized by calling\0A *                 psa_crypto_init() before calling this function.\0A *\0A * \5Cparam chain    The pointer to the start of the CRT chain to attach to.\0A *                 When parsing the first CRT in a chain, this should point\0A *                 to an instance of ::mbedtls_x509_crt initialized through\0A *                 mbedtls_x509_crt_init().\0A * \5Cparam buf      The buffer holding the DER encoded certificate.\0A * \5Cparam buflen   The size in Bytes of \5Cp buf.\0A *\0A * \5Cnote           This function makes an internal copy of the CRT buffer\0A *                 \5Cp buf. In particular, \5Cp buf may be destroyed or reused\0A *                 after this call returns. To avoid duplicating the CRT\0A *                 buffer (at the cost of stricter lifetime constraints),\0A *                 use mbedtls_x509_crt_parse_der_nocopy() instead.\0A *\0A * \5Creturn         \5Cc 0 if successful.\0A * \5Creturn         A negative error code on failure.\0A */\0Aint mbedtls_x509_crt_parse_der(mbedtls_x509_crt *chain,\0A                               const unsigned char *buf,\0A                               size_t buflen);\0A\0A/**\0A * \5Cbrief          The type of certificate extension callbacks.\0A *\0A *                 Callbacks of this type are passed to and used by the\0A *                 mbedtls_x509_crt_parse_der_with_ext_cb() routine when\0A *                 it encounters either an unsupported extension or a\0A *                 \22certificate policies\22 extension containing any\0A *                 unsupported certificate policies.\0A *                 Future versions of the library may invoke the callback\0A *                 in other cases, if and when the need arises.\0A *\0A * \5Cparam p_ctx    An opaque context passed to the callback.\0A * \5Cparam crt      The certificate being parsed.\0A * \5Cparam oid      The OID of the extension.\0A * \5Cparam critical Whether the extension is critical.\0A * \5Cparam p        Pointer to the start of the extension value\0A *                 (the content of the OCTET STRING).\0A * \5Cparam end      End of extension value.\0A *\0A * \5Cnote           The callback must fail and return a negative error code\0A *                 if it can not parse or does not support the extension.\0A *                 When the callback fails to parse a critical extension\0A *                 mbedtls_x509_crt_parse_der_with_ext_cb() also fails.\0A *                 When the callback fails to parse a non critical extension\0A *                 mbedtls_x509_crt_parse_der_with_ext_cb() simply skips\0A *                 the extension and continues parsing.\0A *\0A * \5Creturn         \5Cc 0 on success.\0A * \5Creturn         A negative error code on failure.\0A */\0Atypedef int (*mbedtls_x509_crt_ext_cb_t)(void *p_ctx,\0A                                         mbedtls_x509_crt const *crt,\0A                                         mbedtls_x509_buf const *oid,\0A                                         int critical,\0A                                         const unsigned char *p,\0A                                         const unsigned char *end);\0A\0A/**\0A * \5Cbrief            Parse a single DER formatted certificate and add it\0A *                   to the end of the provided chained list.\0A *\0A * \5Cnote             If #MBEDTLS_USE_PSA_CRYPTO is enabled, the PSA crypto\0A *                   subsystem must have been initialized by calling\0A *                   psa_crypto_init() before calling this function.\0A *\0A * \5Cparam chain      The pointer to the start of the CRT chain to attach to.\0A *                   When parsing the first CRT in a chain, this should point\0A *                   to an instance of ::mbedtls_x509_crt initialized through\0A *                   mbedtls_x509_crt_init().\0A * \5Cparam buf        The buffer holding the DER encoded certificate.\0A * \5Cparam buflen     The size in Bytes of \5Cp buf.\0A * \5Cparam make_copy  When not zero this function makes an internal copy of the\0A *                   CRT buffer \5Cp buf. In particular, \5Cp buf may be destroyed\0A *                   or reused after this call returns.\0A *                   When zero this function avoids duplicating the CRT buffer\0A *                   by taking temporary ownership thereof until the CRT\0A *                   is destroyed (like mbedtls_x509_crt_parse_der_nocopy())\0A * \5Cparam cb         A callback invoked for every unsupported certificate\0A *                   extension.\0A * \5Cparam p_ctx      An opaque context passed to the callback.\0A *\0A * \5Cnote             This call is functionally equivalent to\0A *                   mbedtls_x509_crt_parse_der(), and/or\0A *                   mbedtls_x509_crt_parse_der_nocopy()\0A *                   but it calls the callback with every unsupported\0A *                   certificate extension and additionally the\0A *                   \22certificate policies\22 extension if it contains any\0A *                   unsupported certificate policies.\0A *                   The callback must return a negative error code if it\0A *                   does not know how to handle such an extension.\0A *                   When the callback fails to parse a critical extension\0A *                   mbedtls_x509_crt_parse_der_with_ext_cb() also fails.\0A *                   When the callback fails to parse a non critical extension\0A *                   mbedtls_x509_crt_parse_der_with_ext_cb() simply skips\0A *                   the extension and continues parsing.\0A *                   Future versions of the library may invoke the callback\0A *                   in other cases, if and when the need arises.\0A *\0A * \5Creturn           \5Cc 0 if successful.\0A * \5Creturn           A negative error code on failure.\0A */\0Aint mbedtls_x509_crt_parse_der_with_ext_cb(mbedtls_x509_crt *chain,\0A                                           const unsigned char *buf,\0A                                           size_t buflen,\0A                                           int make_copy,\0A                                           mbedtls_x509_crt_ext_cb_t cb,\0A                                           void *p_ctx);\0A\0A/**\0A * \5Cbrief          Parse a single DER formatted certificate and add it\0A *                 to the end of the provided chained list. This is a\0A *                 variant of mbedtls_x509_crt_parse_der() which takes\0A *                 temporary ownership of the CRT buffer until the CRT\0A *                 is destroyed.\0A *\0A * \5Cnote           If #MBEDTLS_USE_PSA_CRYPTO is enabled, the PSA crypto\0A *                 subsystem must have been initialized by calling\0A *                 psa_crypto_init() before calling this function.\0A *\0A * \5Cparam chain    The pointer to the start of the CRT chain to attach to.\0A *                 When parsing the first CRT in a chain, this should point\0A *                 to an instance of ::mbedtls_x509_crt initialized through\0A *                 mbedtls_x509_crt_init().\0A * \5Cparam buf      The address of the readable buffer holding the DER encoded\0A *                 certificate to use. On success, this buffer must be\0A *                 retained and not be changed for the lifetime of the\0A *                 CRT chain \5Cp chain, that is, until \5Cp chain is destroyed\0A *                 through a call to mbedtls_x509_crt_free().\0A * \5Cparam buflen   The size in Bytes of \5Cp buf.\0A *\0A * \5Cnote           This call is functionally equivalent to\0A *                 mbedtls_x509_crt_parse_der(), but it avoids creating a\0A *                 copy of the input buffer at the cost of stronger lifetime\0A *                 constraints. This is useful in constrained environments\0A *                 where duplication of the CRT cannot be tolerated.\0A *\0A * \5Creturn         \5Cc 0 if successful.\0A * \5Creturn         A negative error code on failure.\0A */\0Aint mbedtls_x509_crt_parse_der_nocopy(mbedtls_x509_crt *chain,\0A                                      const unsigned char *buf,\0A                                      size_t buflen);\0A\0A/**\0A * \5Cbrief          Parse one DER-encoded or one or more concatenated PEM-encoded\0A *                 certificates and add them to the chained list.\0A *\0A *                 For CRTs in PEM encoding, the function parses permissively:\0A *                 if at least one certificate can be parsed, the function\0A *                 returns the number of certificates for which parsing failed\0A *                 (hence \5Cc 0 if all certificates were parsed successfully).\0A *                 If no certificate could be parsed, the function returns\0A *                 the first (negative) error encountered during parsing.\0A *\0A *                 PEM encoded certificates may be interleaved by other data\0A *                 such as human readable descriptions of their content, as\0A *                 long as the certificates are enclosed in the PEM specific\0A *                 '-----{BEGIN/END} CERTIFICATE-----' delimiters.\0A *\0A * \5Cnote           If #MBEDTLS_USE_PSA_CRYPTO is enabled, the PSA crypto\0A *                 subsystem must have been initialized by calling\0A *                 psa_crypto_init() before calling this function.\0A *\0A * \5Cparam chain    The chain to which to add the parsed certificates.\0A * \5Cparam buf      The buffer holding the certificate data in PEM or DER format.\0A *                 For certificates in PEM encoding, this may be a concatenation\0A *                 of multiple certificates; for DER encoding, the buffer must\0A *                 comprise exactly one certificate.\0A * \5Cparam buflen   The size of \5Cp buf, including the terminating \5Cc NULL byte\0A *                 in case of PEM encoded data.\0A *\0A * \5Creturn         \5Cc 0 if all certificates were parsed successfully.\0A * \5Creturn         The (positive) number of certificates that couldn't\0A *                 be parsed if parsing was partly successful (see above).\0A * \5Creturn         A negative X509 or PEM error code otherwise.\0A *\0A */\0Aint mbedtls_x509_crt_parse(mbedtls_x509_crt *chain, const unsigned char *buf, size_t buflen);\0A\0A#if defined(MBEDTLS_FS_IO)\0A/**\0A * \5Cbrief          Load one or more certificates and add them\0A *                 to the chained list. Parses permissively. If some\0A *                 certificates can be parsed, the result is the number\0A *                 of failed certificates it encountered. If none complete\0A *                 correctly, the first error is returned.\0A *\0A * \5Cnote           If #MBEDTLS_USE_PSA_CRYPTO is enabled, the PSA crypto\0A *                 subsystem must have been initialized by calling\0A *                 psa_crypto_init() before calling this function.\0A *\0A * \5Cparam chain    points to the start of the chain\0A * \5Cparam path     filename to read the certificates from\0A *\0A * \5Creturn         0 if all certificates parsed successfully, a positive number\0A *                 if partly successful or a specific X509 or PEM error code\0A */\0Aint mbedtls_x509_crt_parse_file(mbedtls_x509_crt *chain, const char *path);\0A\0A/**\0A * \5Cbrief          Load one or more certificate files from a path and add them\0A *                 to the chained list. Parses permissively. If some\0A *                 certificates can be parsed, the result is the number\0A *                 of failed certificates it encountered. If none complete\0A *                 correctly, the first error is returned.\0A *\0A * \5Cparam chain    points to the start of the chain\0A * \5Cparam path     directory / folder to read the certificate files from\0A *\0A * \5Creturn         0 if all certificates parsed successfully, a positive number\0A *                 if partly successful or a specific X509 or PEM error code\0A */\0Aint mbedtls_x509_crt_parse_path(mbedtls_x509_crt *chain, const char *path);\0A\0A#endif /* MBEDTLS_FS_IO */\0A\0A#if !defined(MBEDTLS_X509_REMOVE_INFO)\0A/**\0A * \5Cbrief          Returns an informational string about the\0A *                 certificate.\0A *\0A * \5Cparam buf      Buffer to write to\0A * \5Cparam size     Maximum size of buffer\0A * \5Cparam prefix   A line prefix\0A * \5Cparam crt      The X509 certificate to represent\0A *\0A * \5Creturn         The length of the string written (not including the\0A *                 terminated nul byte), or a negative error code.\0A */\0Aint mbedtls_x509_crt_info(char *buf, size_t size, const char *prefix,\0A                          const mbedtls_x509_crt *crt);\0A\0A/**\0A * \5Cbrief          Returns an informational string about the\0A *                 verification status of a certificate.\0A *\0A * \5Cparam buf      Buffer to write to\0A * \5Cparam size     Maximum size of buffer\0A * \5Cparam prefix   A line prefix\0A * \5Cparam flags    Verification flags created by mbedtls_x509_crt_verify()\0A *\0A * \5Creturn         The length of the string written (not including the\0A *                 terminated nul byte), or a negative error code.\0A */\0Aint mbedtls_x509_crt_verify_info(char *buf, size_t size, const char *prefix,\0A                                 uint32_t flags);\0A#endif /* !MBEDTLS_X509_REMOVE_INFO */\0A\0A/**\0A * \5Cbrief          Verify a chain of certificates.\0A *\0A *                 The verify callback is a user-supplied callback that\0A *                 can clear / modify / add flags for a certificate. If set,\0A *                 the verification callback is called for each\0A *                 certificate in the chain (from the trust-ca down to the\0A *                 presented crt). The parameters for the callback are:\0A *                 (void *parameter, mbedtls_x509_crt *crt, int certificate_depth,\0A *                 int *flags). With the flags representing current flags for\0A *                 that specific certificate and the certificate depth from\0A *                 the bottom (Peer cert depth = 0).\0A *\0A *                 All flags left after returning from the callback\0A *                 are also returned to the application. The function should\0A *                 return 0 for anything (including invalid certificates)\0A *                 other than fatal error, as a non-zero return code\0A *                 immediately aborts the verification process. For fatal\0A *                 errors, a specific error code should be used (different\0A *                 from MBEDTLS_ERR_X509_CERT_VERIFY_FAILED which should not\0A *                 be returned at this point), or MBEDTLS_ERR_X509_FATAL_ERROR\0A *                 can be used if no better code is available.\0A *\0A * \5Cnote           In case verification failed, the results can be displayed\0A *                 using \5Cc mbedtls_x509_crt_verify_info()\0A *\0A * \5Cnote           Same as \5Cc mbedtls_x509_crt_verify_with_profile() with the\0A *                 default security profile.\0A *\0A * \5Cnote           It is your responsibility to provide up-to-date CRLs for\0A *                 all trusted CAs. If no CRL is provided for the CA that was\0A *                 used to sign the certificate, CRL verification is skipped\0A *                 silently, that is *without* setting any flag.\0A *\0A * \5Cnote           The \5Cc trust_ca list can contain two types of certificates:\0A *                 (1) those of trusted root CAs, so that certificates\0A *                 chaining up to those CAs will be trusted, and (2)\0A *                 self-signed end-entity certificates to be trusted (for\0A *                 specific peers you know) - in that case, the self-signed\0A *                 certificate doesn't need to have the CA bit set.\0A *\0A * \5Cparam crt      The certificate chain to be verified.\0A * \5Cparam trust_ca The list of trusted CAs.\0A * \5Cparam ca_crl   The list of CRLs for trusted CAs.\0A * \5Cparam cn       The expected Common Name. This will be checked to be\0A *                 present in the certificate's subjectAltNames extension or,\0A *                 if this extension is absent, as a CN component in its\0A *                 Subject name. DNS names and IP addresses are fully\0A *                 supported, while the URI subtype is partially supported:\0A *                 only exact matching, without any normalization procedures\0A *                 described in 7.4 of RFC5280, will result in a positive\0A *                 URI verification.\0A *                 This may be \5Cc NULL if the CN need not be verified.\0A * \5Cparam flags    The address at which to store the result of the verification.\0A *                 If the verification couldn't be completed, the flag value is\0A *                 set to (uint32_t) -1.\0A * \5Cparam f_vrfy   The verification callback to use. See the documentation\0A *                 of mbedtls_x509_crt_verify() for more information.\0A * \5Cparam p_vrfy   The context to be passed to \5Cp f_vrfy.\0A *\0A * \5Creturn         \5Cc 0 if the chain is valid with respect to the\0A *                 passed CN, CAs, CRLs and security profile.\0A * \5Creturn         #MBEDTLS_ERR_X509_CERT_VERIFY_FAILED in case the\0A *                 certificate chain verification failed. In this case,\0A *                 \5Cc *flags will have one or more\0A *                 \5Cc MBEDTLS_X509_BADCERT_XXX or \5Cc MBEDTLS_X509_BADCRL_XXX\0A *                 flags set.\0A * \5Creturn         Another negative error code in case of a fatal error\0A *                 encountered during the verification process.\0A */\0Aint mbedtls_x509_crt_verify(mbedtls_x509_crt *crt,\0A                            mbedtls_x509_crt *trust_ca,\0A                            mbedtls_x509_crl *ca_crl,\0A                            const char *cn, uint32_t *flags,\0A                            int (*f_vrfy)(void *, mbedtls_x509_crt *, int, uint32_t *),\0A                            void *p_vrfy);\0A\0A/**\0A * \5Cbrief          Verify a chain of certificates with respect to\0A *                 a configurable security profile.\0A *\0A * \5Cnote           Same as \5Cc mbedtls_x509_crt_verify(), but with explicit\0A *                 security profile.\0A *\0A * \5Cnote           The restrictions on keys (RSA minimum size, allowed curves\0A *                 for ECDSA) apply to all certificates: trusted root,\0A *                 intermediate CAs if any, and end entity certificate.\0A *\0A * \5Cparam crt      The certificate chain to be verified.\0A * \5Cparam trust_ca The list of trusted CAs.\0A * \5Cparam ca_crl   The list of CRLs for trusted CAs.\0A * \5Cparam profile  The security profile to use for the verification.\0A * \5Cparam cn       The expected Common Name. This may be \5Cc NULL if the\0A *                 CN need not be verified.\0A * \5Cparam flags    The address at which to store the result of the verification.\0A *                 If the verification couldn't be completed, the flag value is\0A *                 set to (uint32_t) -1.\0A * \5Cparam f_vrfy   The verification callback to use. See the documentation\0A *                 of mbedtls_x509_crt_verify() for more information.\0A * \5Cparam p_vrfy   The context to be passed to \5Cp f_vrfy.\0A *\0A * \5Creturn         \5Cc 0 if the chain is valid with respect to the\0A *                 passed CN, CAs, CRLs and security profile.\0A * \5Creturn         #MBEDTLS_ERR_X509_CERT_VERIFY_FAILED in case the\0A *                 certificate chain verification failed. In this case,\0A *                 \5Cc *flags will have one or more\0A *                 \5Cc MBEDTLS_X509_BADCERT_XXX or \5Cc MBEDTLS_X509_BADCRL_XXX\0A *                 flags set.\0A * \5Creturn         Another negative error code in case of a fatal error\0A *                 encountered during the verification process.\0A */\0Aint mbedtls_x509_crt_verify_with_profile(mbedtls_x509_crt *crt,\0A                                         mbedtls_x509_crt *trust_ca,\0A                                         mbedtls_x509_crl *ca_crl,\0A                                         const mbedtls_x509_crt_profile *profile,\0A                                         const char *cn, uint32_t *flags,\0A                                         int (*f_vrfy)(void *, mbedtls_x509_crt *, int, uint32_t *),\0A                                         void *p_vrfy);\0A\0A/**\0A * \5Cbrief          Restartable version of \5Cc mbedtls_crt_verify_with_profile()\0A *\0A * \5Cnote           Performs the same job as \5Cc mbedtls_crt_verify_with_profile()\0A *                 but can return early and restart according to the limit\0A *                 set with \5Cc mbedtls_ecp_set_max_ops() to reduce blocking.\0A *\0A * \5Cparam crt      The certificate chain to be verified.\0A * \5Cparam trust_ca The list of trusted CAs.\0A * \5Cparam ca_crl   The list of CRLs for trusted CAs.\0A * \5Cparam profile  The security profile to use for the verification.\0A * \5Cparam cn       The expected Common Name. This may be \5Cc NULL if the\0A *                 CN need not be verified.\0A * \5Cparam flags    The address at which to store the result of the verification.\0A *                 If the verification couldn't be completed, the flag value is\0A *                 set to (uint32_t) -1.\0A * \5Cparam f_vrfy   The verification callback to use. See the documentation\0A *                 of mbedtls_x509_crt_verify() for more information.\0A * \5Cparam p_vrfy   The context to be passed to \5Cp f_vrfy.\0A * \5Cparam rs_ctx   The restart context to use. This may be set to \5Cc NULL\0A *                 to disable restartable ECC.\0A *\0A * \5Creturn         See \5Cc mbedtls_crt_verify_with_profile(), or\0A * \5Creturn         #MBEDTLS_ERR_ECP_IN_PROGRESS if maximum number of\0A *                 operations was reached: see \5Cc mbedtls_ecp_set_max_ops().\0A */\0Aint mbedtls_x509_crt_verify_restartable(mbedtls_x509_crt *crt,\0A                                        mbedtls_x509_crt *trust_ca,\0A                                        mbedtls_x509_crl *ca_crl,\0A                                        const mbedtls_x509_crt_profile *profile,\0A                                        const char *cn, uint32_t *flags,\0A                                        int (*f_vrfy)(void *, mbedtls_x509_crt *, int, uint32_t *),\0A                                        void *p_vrfy,\0A                                        mbedtls_x509_crt_restart_ctx *rs_ctx);\0A\0A/**\0A * \5Cbrief               The type of trusted certificate callbacks.\0A *\0A *                      Callbacks of this type are passed to and used by the CRT\0A *                      verification routine mbedtls_x509_crt_verify_with_ca_cb()\0A *                      when looking for trusted signers of a given certificate.\0A *\0A *                      On success, the callback returns a list of trusted\0A *                      certificates to be considered as potential signers\0A *                      for the input certificate.\0A *\0A * \5Cparam p_ctx         An opaque context passed to the callback.\0A * \5Cparam child         The certificate for which to search a potential signer.\0A *                      This will point to a readable certificate.\0A * \5Cparam candidate_cas The address at which to store the address of the first\0A *                      entry in the generated linked list of candidate signers.\0A *                      This will not be \5Cc NULL.\0A *\0A * \5Cnote                The callback must only return a non-zero value on a\0A *                      fatal error. If, in contrast, the search for a potential\0A *                      signer completes without a single candidate, the\0A *                      callback must return \5Cc 0 and set \5Cc *candidate_cas\0A *                      to \5Cc NULL.\0A *\0A * \5Creturn              \5Cc 0 on success. In this case, \5Cc *candidate_cas points\0A *                      to a heap-allocated linked list of instances of\0A *                      ::mbedtls_x509_crt, and ownership of this list is passed\0A *                      to the caller.\0A * \5Creturn              A negative error code on failure.\0A */\0Atypedef int (*mbedtls_x509_crt_ca_cb_t)(void *p_ctx,\0A                                        mbedtls_x509_crt const *child,\0A                                        mbedtls_x509_crt **candidate_cas);\0A\0A#if defined(MBEDTLS_X509_TRUSTED_CERTIFICATE_CALLBACK)\0A/**\0A * \5Cbrief          Version of \5Cc mbedtls_x509_crt_verify_with_profile() which\0A *                 uses a callback to acquire the list of trusted CA\0A *                 certificates.\0A *\0A * \5Cparam crt      The certificate chain to be verified.\0A * \5Cparam f_ca_cb  The callback to be used to query for potential signers\0A *                 of a given child certificate. See the documentation of\0A *                 ::mbedtls_x509_crt_ca_cb_t for more information.\0A * \5Cparam p_ca_cb  The opaque context to be passed to \5Cp f_ca_cb.\0A * \5Cparam profile  The security profile for the verification.\0A * \5Cparam cn       The expected Common Name. This may be \5Cc NULL if the\0A *                 CN need not be verified.\0A * \5Cparam flags    The address at which to store the result of the verification.\0A *                 If the verification couldn't be completed, the flag value is\0A *                 set to (uint32_t) -1.\0A * \5Cparam f_vrfy   The verification callback to use. See the documentation\0A *                 of mbedtls_x509_crt_verify() for more information.\0A * \5Cparam p_vrfy   The context to be passed to \5Cp f_vrfy.\0A *\0A * \5Creturn         See \5Cc mbedtls_crt_verify_with_profile().\0A */\0Aint mbedtls_x509_crt_verify_with_ca_cb(mbedtls_x509_crt *crt,\0A                                       mbedtls_x509_crt_ca_cb_t f_ca_cb,\0A                                       void *p_ca_cb,\0A                                       const mbedtls_x509_crt_profile *profile,\0A                                       const char *cn, uint32_t *flags,\0A                                       int (*f_vrfy)(void *, mbedtls_x509_crt *, int, uint32_t *),\0A                                       void *p_vrfy);\0A\0A#endif /* MBEDTLS_X509_TRUSTED_CERTIFICATE_CALLBACK */\0A\0A/**\0A * \5Cbrief          Check usage of certificate against keyUsage extension.\0A *\0A * \5Cparam crt      Leaf certificate used.\0A * \5Cparam usage    Intended usage(s) (eg MBEDTLS_X509_KU_KEY_ENCIPHERMENT\0A *                 before using the certificate to perform an RSA key\0A *                 exchange).\0A *\0A * \5Cnote           Except for decipherOnly and encipherOnly, a bit set in the\0A *                 usage argument means this bit MUST be set in the\0A *                 certificate. For decipherOnly and encipherOnly, it means\0A *                 that bit MAY be set.\0A *\0A * \5Creturn         0 is these uses of the certificate are allowed,\0A *                 MBEDTLS_ERR_X509_BAD_INPUT_DATA if the keyUsage extension\0A *                 is present but does not match the usage argument.\0A *\0A * \5Cnote           You should only call this function on leaf certificates, on\0A *                 (intermediate) CAs the keyUsage extension is automatically\0A *                 checked by \5Cc mbedtls_x509_crt_verify().\0A */\0Aint mbedtls_x509_crt_check_key_usage(const mbedtls_x509_crt *crt,\0A                                     unsigned int usage);\0A\0A/**\0A * \5Cbrief           Check usage of certificate against extendedKeyUsage.\0A *\0A * \5Cparam crt       Leaf certificate used.\0A * \5Cparam usage_oid Intended usage (eg MBEDTLS_OID_SERVER_AUTH or\0A *                  MBEDTLS_OID_CLIENT_AUTH).\0A * \5Cparam usage_len Length of usage_oid (eg given by MBEDTLS_OID_SIZE()).\0A *\0A * \5Creturn          0 if this use of the certificate is allowed,\0A *                  MBEDTLS_ERR_X509_BAD_INPUT_DATA if not.\0A *\0A * \5Cnote            Usually only makes sense on leaf certificates.\0A */\0Aint mbedtls_x509_crt_check_extended_key_usage(const mbedtls_x509_crt *crt,\0A                                              const char *usage_oid,\0A                                              size_t usage_len);\0A\0A#if defined(MBEDTLS_X509_CRL_PARSE_C)\0A/**\0A * \5Cbrief          Verify the certificate revocation status\0A *\0A * \5Cparam crt      a certificate to be verified\0A * \5Cparam crl      the CRL to verify against\0A *\0A * \5Creturn         1 if the certificate is revoked, 0 otherwise\0A *\0A */\0Aint mbedtls_x509_crt_is_revoked(const mbedtls_x509_crt *crt, const mbedtls_x509_crl *crl);\0A#endif /* MBEDTLS_X509_CRL_PARSE_C */\0A\0A/**\0A * \5Cbrief          Initialize a certificate (chain)\0A *\0A * \5Cparam crt      Certificate chain to initialize\0A */\0Avoid mbedtls_x509_crt_init(mbedtls_x509_crt *crt);\0A\0A/**\0A * \5Cbrief          Unallocate all certificate data\0A *\0A * \5Cparam crt      Certificate chain to free\0A */\0Avoid mbedtls_x509_crt_free(mbedtls_x509_crt *crt);\0A\0A#if defined(MBEDTLS_ECDSA_C) && defined(MBEDTLS_ECP_RESTARTABLE)\0A/**\0A * \5Cbrief           Initialize a restart context\0A */\0Avoid mbedtls_x509_crt_restart_init(mbedtls_x509_crt_restart_ctx *ctx);\0A\0A/**\0A * \5Cbrief           Free the components of a restart context\0A */\0Avoid mbedtls_x509_crt_restart_free(mbedtls_x509_crt_restart_ctx *ctx);\0A#endif /* MBEDTLS_ECDSA_C && MBEDTLS_ECP_RESTARTABLE */\0A#endif /* MBEDTLS_X509_CRT_PARSE_C */\0A\0A/**\0A * \5Cbrief               Query certificate for given extension type\0A *\0A * \5Cparam[in] ctx       Certificate context to be queried, must not be \5Cc NULL\0A * \5Cparam ext_type      Extension type being queried for, must be a valid\0A *                      extension type. Must be one of the MBEDTLS_X509_EXT_XXX\0A *                      values\0A *\0A * \5Creturn              0 if the given extension type is not present,\0A *                      non-zero otherwise\0A */\0Astatic inline int mbedtls_x509_crt_has_ext_type(const mbedtls_x509_crt *ctx,\0A                                                int ext_type)\0A{\0A    return ctx->MBEDTLS_PRIVATE(ext_types) & ext_type;\0A}\0A\0A/**\0A * \5Cbrief               Access the ca_istrue field\0A *\0A * \5Cparam[in] crt       Certificate to be queried, must not be \5Cc NULL\0A *\0A * \5Creturn              \5Cc 1 if this a CA certificate \5Cc 0 otherwise.\0A * \5Creturn              MBEDTLS_ERR_X509_INVALID_EXTENSIONS if the certificate does not contain\0A *                      the Optional Basic Constraint extension.\0A *\0A */\0Aint mbedtls_x509_crt_get_ca_istrue(const mbedtls_x509_crt *crt);\0A\0A/** \5C} name Structures and functions for parsing and writing X.509 certificates */\0A\0A#if defined(MBEDTLS_X509_CRT_WRITE_C)\0A/**\0A * \5Cbrief           Initialize a CRT writing context\0A *\0A * \5Cparam ctx       CRT context to initialize\0A */\0Avoid mbedtls_x509write_crt_init(mbedtls_x509write_cert *ctx);\0A\0A/**\0A * \5Cbrief           Set the version for a Certificate\0A *                  Default: MBEDTLS_X509_CRT_VERSION_3\0A *\0A * \5Cparam ctx       CRT context to use\0A * \5Cparam version   version to set (MBEDTLS_X509_CRT_VERSION_1, MBEDTLS_X509_CRT_VERSION_2 or\0A *                                  MBEDTLS_X509_CRT_VERSION_3)\0A */\0Avoid mbedtls_x509write_crt_set_version(mbedtls_x509write_cert *ctx, int version);\0A\0A#if defined(MBEDTLS_BIGNUM_C) && !defined(MBEDTLS_DEPRECATED_REMOVED)\0A/**\0A * \5Cbrief           Set the serial number for a Certificate.\0A *\0A * \5Cdeprecated      This function is deprecated and will be removed in a\0A *                  future version of the library. Please use\0A *                  mbedtls_x509write_crt_set_serial_raw() instead.\0A *\0A * \5Cnote            Even though the MBEDTLS_BIGNUM_C guard looks redundant since\0A *                  X509 depends on PK and PK depends on BIGNUM, this emphasizes\0A *                  a direct dependency between X509 and BIGNUM which is going\0A *                  to be deprecated in the future.\0A *\0A * \5Cparam ctx       CRT context to use\0A * \5Cparam serial    serial number to set\0A *\0A * \5Creturn          0 if successful\0A */\0Aint MBEDTLS_DEPRECATED mbedtls_x509write_crt_set_serial(\0A    mbedtls_x509write_cert *ctx, const mbedtls_mpi *serial);\0A#endif // MBEDTLS_BIGNUM_C && !MBEDTLS_DEPRECATED_REMOVED\0A\0A/**\0A * \5Cbrief           Set the serial number for a Certificate.\0A *\0A * \5Cparam ctx          CRT context to use\0A * \5Cparam serial       A raw array of bytes containing the serial number in big\0A *                     endian format\0A * \5Cparam serial_len   Length of valid bytes (expressed in bytes) in \5Cp serial\0A *                     input buffer\0A *\0A * \5Creturn          0 if successful, or\0A *                  MBEDTLS_ERR_X509_BAD_INPUT_DATA if the provided input buffer\0A *                  is too big (longer than MBEDTLS_X509_RFC5280_MAX_SERIAL_LEN)\0A */\0Aint mbedtls_x509write_crt_set_serial_raw(mbedtls_x509write_cert *ctx,\0A                                         unsigned char *serial, size_t serial_len);\0A\0A/**\0A * \5Cbrief           Set the validity period for a Certificate\0A *                  Timestamps should be in string format for UTC timezone\0A *                  i.e. \22YYYYMMDDhhmmss\22\0A *                  e.g. \2220131231235959\22 for December 31st 2013\0A *                       at 23:59:59\0A *\0A * \5Cparam ctx       CRT context to use\0A * \5Cparam not_before    not_before timestamp\0A * \5Cparam not_after     not_after timestamp\0A *\0A * \5Creturn          0 if timestamp was parsed successfully, or\0A *                  a specific error code\0A */\0Aint mbedtls_x509write_crt_set_validity(mbedtls_x509write_cert *ctx, const char *not_before,\0A                                       const char *not_after);\0A\0A/**\0A * \5Cbrief           Set the issuer name for a Certificate\0A *                  Issuer names should contain a comma-separated list\0A *                  of OID types and values:\0A *                  e.g. \22C=UK,O=ARM,CN=Mbed TLS CA\22\0A *\0A * \5Cparam ctx           CRT context to use\0A * \5Cparam issuer_name   issuer name to set\0A *\0A * \5Creturn          0 if issuer name was parsed successfully, or\0A *                  a specific error code\0A */\0Aint mbedtls_x509write_crt_set_issuer_name(mbedtls_x509write_cert *ctx,\0A                                          const char *issuer_name);\0A\0A/**\0A * \5Cbrief           Set the subject name for a Certificate\0A *                  Subject names should contain a comma-separated list\0A *                  of OID types and values:\0A *                  e.g. \22C=UK,O=ARM,CN=Mbed TLS Server 1\22\0A *\0A * \5Cparam ctx           CRT context to use\0A * \5Cparam subject_name  subject name to set\0A *\0A * \5Creturn          0 if subject name was parsed successfully, or\0A *                  a specific error code\0A */\0Aint mbedtls_x509write_crt_set_subject_name(mbedtls_x509write_cert *ctx,\0A                                           const char *subject_name);\0A\0A/**\0A * \5Cbrief           Set the subject public key for the certificate\0A *\0A * \5Cparam ctx       CRT context to use\0A * \5Cparam key       public key to include\0A */\0Avoid mbedtls_x509write_crt_set_subject_key(mbedtls_x509write_cert *ctx, mbedtls_pk_context *key);\0A\0A/**\0A * \5Cbrief           Set the issuer key used for signing the certificate\0A *\0A * \5Cparam ctx       CRT context to use\0A * \5Cparam key       private key to sign with\0A */\0Avoid mbedtls_x509write_crt_set_issuer_key(mbedtls_x509write_cert *ctx, mbedtls_pk_context *key);\0A\0A/**\0A * \5Cbrief           Set the MD algorithm to use for the signature\0A *                  (e.g. MBEDTLS_MD_SHA1)\0A *\0A * \5Cparam ctx       CRT context to use\0A * \5Cparam md_alg    MD algorithm to use\0A */\0Avoid mbedtls_x509write_crt_set_md_alg(mbedtls_x509write_cert *ctx, mbedtls_md_type_t md_alg);\0A\0A/**\0A * \5Cbrief           Generic function to add to or replace an extension in the\0A *                  CRT\0A *\0A * \5Cparam ctx       CRT context to use\0A * \5Cparam oid       OID of the extension\0A * \5Cparam oid_len   length of the OID\0A * \5Cparam critical  if the extension is critical (per the RFC's definition)\0A * \5Cparam val       value of the extension OCTET STRING\0A * \5Cparam val_len   length of the value data\0A *\0A * \5Creturn          0 if successful, or a MBEDTLS_ERR_X509_ALLOC_FAILED\0A */\0Aint mbedtls_x509write_crt_set_extension(mbedtls_x509write_cert *ctx,\0A                                        const char *oid, size_t oid_len,\0A                                        int critical,\0A                                        const unsigned char *val, size_t val_len);\0A\0A/**\0A * \5Cbrief           Set the basicConstraints extension for a CRT\0A *\0A * \5Cparam ctx       CRT context to use\0A * \5Cparam is_ca     is this a CA certificate\0A * \5Cparam max_pathlen   maximum length of certificate chains below this\0A *                      certificate (only for CA certificates, -1 is\0A *                      unlimited)\0A *\0A * \5Creturn          0 if successful, or a MBEDTLS_ERR_X509_ALLOC_FAILED\0A */\0Aint mbedtls_x509write_crt_set_basic_constraints(mbedtls_x509write_cert *ctx,\0A                                                int is_ca, int max_pathlen);\0A\0A#if defined(MBEDTLS_MD_CAN_SHA1)\0A/**\0A * \5Cbrief           Set the subjectKeyIdentifier extension for a CRT\0A *                  Requires that mbedtls_x509write_crt_set_subject_key() has been\0A *                  called before\0A *\0A * \5Cparam ctx       CRT context to use\0A *\0A * \5Creturn          0 if successful, or a MBEDTLS_ERR_X509_ALLOC_FAILED\0A */\0Aint mbedtls_x509write_crt_set_subject_key_identifier(mbedtls_x509write_cert *ctx);\0A\0A/**\0A * \5Cbrief           Set the authorityKeyIdentifier extension for a CRT\0A *                  Requires that mbedtls_x509write_crt_set_issuer_key() has been\0A *                  called before\0A *\0A * \5Cparam ctx       CRT context to use\0A *\0A * \5Creturn          0 if successful, or a MBEDTLS_ERR_X509_ALLOC_FAILED\0A */\0Aint mbedtls_x509write_crt_set_authority_key_identifier(mbedtls_x509write_cert *ctx);\0A#endif /* MBEDTLS_MD_CAN_SHA1 */\0A\0A/**\0A * \5Cbrief           Set the Key Usage Extension flags\0A *                  (e.g. MBEDTLS_X509_KU_DIGITAL_SIGNATURE | MBEDTLS_X509_KU_KEY_CERT_SIGN)\0A *\0A * \5Cparam ctx       CRT context to use\0A * \5Cparam key_usage key usage flags to set\0A *\0A * \5Creturn          0 if successful, or MBEDTLS_ERR_X509_ALLOC_FAILED\0A */\0Aint mbedtls_x509write_crt_set_key_usage(mbedtls_x509write_cert *ctx,\0A                                        unsigned int key_usage);\0A\0A/**\0A * \5Cbrief           Set the Extended Key Usage Extension\0A *                  (e.g. MBEDTLS_OID_SERVER_AUTH)\0A *\0A * \5Cparam ctx       CRT context to use\0A * \5Cparam exts      extended key usage extensions to set, a sequence of\0A *                  MBEDTLS_ASN1_OID objects\0A *\0A * \5Creturn          0 if successful, or MBEDTLS_ERR_X509_ALLOC_FAILED\0A */\0Aint mbedtls_x509write_crt_set_ext_key_usage(mbedtls_x509write_cert *ctx,\0A                                            const mbedtls_asn1_sequence *exts);\0A\0A/**\0A * \5Cbrief           Set the Netscape Cert Type flags\0A *                  (e.g. MBEDTLS_X509_NS_CERT_TYPE_SSL_CLIENT | MBEDTLS_X509_NS_CERT_TYPE_EMAIL)\0A *\0A * \5Cparam ctx           CRT context to use\0A * \5Cparam ns_cert_type  Netscape Cert Type flags to set\0A *\0A * \5Creturn          0 if successful, or MBEDTLS_ERR_X509_ALLOC_FAILED\0A */\0Aint mbedtls_x509write_crt_set_ns_cert_type(mbedtls_x509write_cert *ctx,\0A                                           unsigned char ns_cert_type);\0A\0A/**\0A * \5Cbrief           Free the contents of a CRT write context\0A *\0A * \5Cparam ctx       CRT context to free\0A */\0Avoid mbedtls_x509write_crt_free(mbedtls_x509write_cert *ctx);\0A\0A/**\0A * \5Cbrief           Write a built up certificate to a X509 DER structure\0A *                  Note: data is written at the end of the buffer! Use the\0A *                        return value to determine where you should start\0A *                        using the buffer\0A *\0A * \5Cparam ctx       certificate to write away\0A * \5Cparam buf       buffer to write to\0A * \5Cparam size      size of the buffer\0A * \5Cparam f_rng     RNG function. This must not be \5Cc NULL.\0A * \5Cparam p_rng     RNG parameter\0A *\0A * \5Creturn          length of data written if successful, or a specific\0A *                  error code\0A *\0A * \5Cnote            \5Cp f_rng is used for the signature operation.\0A */\0Aint mbedtls_x509write_crt_der(mbedtls_x509write_cert *ctx, unsigned char *buf, size_t size,\0A                              int (*f_rng)(void *, unsigned char *, size_t),\0A                              void *p_rng);\0A\0A#if defined(MBEDTLS_PEM_WRITE_C)\0A/**\0A * \5Cbrief           Write a built up certificate to a X509 PEM string\0A *\0A * \5Cparam ctx       certificate to write away\0A * \5Cparam buf       buffer to write to\0A * \5Cparam size      size of the buffer\0A * \5Cparam f_rng     RNG function. This must not be \5Cc NULL.\0A * \5Cparam p_rng     RNG parameter\0A *\0A * \5Creturn          0 if successful, or a specific error code\0A *\0A * \5Cnote            \5Cp f_rng is used for the signature operation.\0A */\0Aint mbedtls_x509write_crt_pem(mbedtls_x509write_cert *ctx, unsigned char *buf, size_t size,\0A                              int (*f_rng)(void *, unsigned char *, size_t),\0A                              void *p_rng);\0A#endif /* MBEDTLS_PEM_WRITE_C */\0A#endif /* MBEDTLS_X509_CRT_WRITE_C */\0A\0A/** \5C} addtogroup x509_module */\0A\0A#ifdef __cplusplus\0A}\0A#endif\0A\0A#endif /* mbedtls_x509_crt.h */\0A\00" }
