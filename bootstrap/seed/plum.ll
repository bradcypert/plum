 * behavior making sure to depend only on output_max_len (the size of the\0A     * user-provided output buffer), which is independent from plaintext\0A     * length, validity of padding, success of the decryption, and other\0A     * secrets. */\0A    if (output_max_len != 0) {\0A        memcpy(output, input + ilen - plaintext_max_size, plaintext_max_size);\0A    }\0A\0A    /* Report the amount of data we copied to the output buffer. In case\0A     * of errors (bad padding or output too large), the value of *olen\0A     * when this function returns is not specified. Making it equivalent\0A     * to the good case limits the risks of leaking the padding validity. */\0A    *olen = plaintext_size;\0A\0A    return ret;\0A}\0A\0A#endif /* MBEDTLS_PKCS1_V15 && MBEDTLS_RSA_C && ! MBEDTLS_RSA_ALT */\0A\0A#if !defined(MBEDTLS_RSA_ALT)\0A\0Aint mbedtls_rsa_import(mbedtls_rsa_context *ctx,\0A                       const mbedtls_mpi *N,\0A                       const mbedtls_mpi *P, const mbedtls_mpi *Q,\0A                       const mbedtls_mpi *D, const mbedtls_mpi *E)\0A{\0A    int ret = MBEDTLS_ERR_ERROR_CORRUPTION_DETECTED;\0A\0A    if ((N != NULL && (ret = mbedtls_mpi_copy(&ctx->N, N)) != 0) ||\0A        (P != NULL && (ret = mbedtls_mpi_copy(&ctx->P, P)) != 0) ||\0A        (Q != NULL && (ret = mbedtls_mpi_copy(&ctx->Q, Q)) != 0) ||\0A        (D != NULL && (ret = mbedtls_mpi_copy(&ctx->D, D)) != 0) ||\0A        (E != NULL && (ret = mbedtls_mpi_copy(&ctx->E, E)) != 0)) {\0A        return MBEDTLS_ERROR_ADD(MBEDTLS_ERR_RSA_BAD_INPUT_DATA, ret);\0A    }\0A\0A    if (N != NULL) {\0A        ctx->len = mbedtls_mpi_size(&ctx->N);\0A    }\0A\0A    return 0;\0A}\0A\0Aint mbedtls_rsa_import_raw(mbedtls_rsa_context *ctx,\0A                           unsigned char const *N, size_t N_len,\0A                           unsigned char const *P, size_t P_len,\0A                           unsigned char const *Q, size_t Q_len,\0A                           unsigned char const *D, size_t D_len,\0