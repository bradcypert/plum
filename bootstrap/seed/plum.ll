@.str45785 = private global { i64, i64, [27183 x i8] } { i64 -1, i64 27182, [27183 x i8] c"/*\0A * The LM-OTS one-time public-key signature scheme\0A *\0A * Copyright The Mbed TLS Contributors\0A *  SPDX-License-Identifier: Apache-2.0 OR GPL-2.0-or-later\0A */\0A\0A/*\0A *  The following sources were referenced in the design of this implementation\0A *  of the LM-OTS algorithm:\0A *\0A *  [1] IETF RFC8554\0A *      D. McGrew, M. Curcio, S.Fluhrer\0A *      https://datatracker.ietf.org/doc/html/rfc8554\0A *\0A *  [2] NIST Special Publication 800-208\0A *      David A. Cooper et. al.\0A *      https://nvlpubs.nist.gov/nistpubs/SpecialPublications/NIST.SP.800-208.pdf\0A */\0A\0A#include \22common.h\22\0A\0A#if defined(MBEDTLS_LMS_C)\0A\0A#include <string.h>\0A\0A#include \22lmots.h\22\0A\0A#include \22mbedtls/lms.h\22\0A#include \22mbedtls/platform_util.h\22\0A#include \22mbedtls/error.h\22\0A#include \22psa_util_internal.h\22\0A\0A#include \22psa/crypto.h\22\0A\0A/* Define a local translating function to save code size by not using too many\0A * arguments in each translating place. */\0Astatic int local_err_translation(psa_status_t status)\0A{\0A    return psa_status_to_mbedtls(status, psa_to_lms_errors,\0A                                 ARRAY_LENGTH(psa_to_lms_errors),\0A                                 psa_generic_status_to_mbedtls);\0A}\0A#define PSA_TO_MBEDTLS_ERR(status) local_err_translation(status)\0A\0A#define PUBLIC_KEY_TYPE_OFFSET     (0)\0A#define PUBLIC_KEY_I_KEY_ID_OFFSET (PUBLIC_KEY_TYPE_OFFSET + \5C\0A                                    MBEDTLS_LMOTS_TYPE_LEN)\0A#define PUBLIC_KEY_Q_LEAF_ID_OFFSET (PUBLIC_KEY_I_KEY_ID_OFFSET + \5C\0A                                     MBEDTLS_LMOTS_I_KEY_ID_LEN)\0A#define PUBLIC_KEY_KEY_HASH_OFFSET (PUBLIC_KEY_Q_LEAF_ID_OFFSET + \5C\0A                                    MBEDTLS_LMOTS_Q_LEAF_ID_LEN)\0A\0A/* We only support parameter sets that use 8-bit digits, as it does not require\0A * translation logic between digits and bytes */\0A#define W_WINTERNITZ_PARAMETER (8u)\0A#define CHECKSUM_LEN           (2)\0A#define I_DIGIT_IDX_LEN        (2)\0A#define J_HASH_IDX_LEN         (1)\0A#define D_CONST_LEN            (2)\0A\0A#define DIGIT_MAX_VALUE        ((1u << W_WINTERNITZ_PARAMETER) - 1u)\0A\0A#define D_CONST_LEN            (2)\0Astatic const unsigned char D_PUBLIC_CONSTANT_BYTES[D_CONST_LEN] = { 0x80, 0x80 };\0Astatic const unsigned char D_MESSAGE_CONSTANT_BYTES[D_CONST_LEN] = { 0x81, 0x81 };\0A\0A#if defined(MBEDTLS_TEST_HOOKS)\0Aint (*mbedtls_lmots_sign_private_key_invalidated_hook)(unsigned char *) = NULL;\0A#endif /* defined(MBEDTLS_TEST_HOOKS) */\0A\0A/* Calculate the checksum digits that are appended to the end of the LMOTS digit\0A * string. See NIST SP800-208 section 3.1 or RFC8554 Algorithm 2 for details of\0A * the checksum algorithm.\0A *\0A *  params              The LMOTS parameter set, I and q values which\0A *                      describe the key being used.\0A *\0A *  digest              The digit string to create the digest from. As\0A *                      this does not contain a checksum, it is the same\0A *                      size as a hash output.\0A */\0Astatic unsigned short lmots_checksum_calculate(const mbedtls_lmots_parameters_t *params,\0A                                               const unsigned char *digest)\0A{\0A    size_t idx;\0A    unsigned sum = 0;\0A\0A    for (idx = 0; idx < MBEDTLS_LMOTS_N_HASH_LEN(params->type); idx++) {\0A        sum += DIGIT_MAX_VALUE - digest[idx];\0A    }\0A\0A    return sum;\0A}\0A\0A/* Create the string of digest digits (in the base determined by the Winternitz\0A * parameter with the checksum appended to the end (Q || cksm(Q)). See NIST\0A * SP800-208 section 3.1 or RFC8554 Algorithm 3 step 5 (also used in Algorithm\0A * 4b step 3) for details.\0A *\0A *  params              The LMOTS parameter set, I and q values which\0A *                      describe the key being used.\0A *\0A *  msg                 The message that will be hashed to create the\0A *                      digest.\0A *\0A *  msg_size            The size of the message.\0A *\0A *  C_random_value      The random value that will be combined with the\0A *                      message digest. This is always the same size as a\0A *                      hash output for whichever hash algorithm is\0A *                      determined by the parameter set.\0A *\0A *  output              An output containing the digit string (+\0A *                      checksum) of length P digits (in the case of\0A *                      MBEDTLS_LMOTS_SHA256_N32_W8, this means it is of\0A *                      size P bytes).\0A */\0Astatic int create_digit_array_with_checksum(const mbedtls_lmots_parameters_t *params,\0A                                            const unsigned char *msg,\0A                                            size_t msg_len,\0A                                            const unsigned char *C_random_value,\0A                                            unsigned char *out)\0A{\0A    psa_hash_operation_t op = PSA_HASH_OPERATION_INIT;\0A    psa_status_t status = PSA_ERROR_CORRUPTION_DETECTED;\0A    size_t output_hash_len;\0A    unsigned short checksum;\0A\0A    status = psa_hash_setup(&op, PSA_ALG_SHA_256);\0A    if (status != PSA_SUCCESS) {\0A        goto exit;\0A    }\0A\0A    status = psa_hash_update(&op, params->I_key_identifier,\0A                             MBEDTLS_LMOTS_I_KEY_ID_LEN);\0A    if (status != PSA_SUCCESS) {\0A        goto exit;\0A    }\0A\0A    status = psa_hash_update(&op, params->q_leaf_identifier,\0A                             MBEDTLS_LMOTS_Q_LEAF_ID_LEN);\0A    if (status != PSA_SUCCESS) {\0A        goto exit;\0A    }\0A\0A    status = psa_hash_update(&op, D_MESSAGE_CONSTANT_BYTES, D_CONST_LEN);\0A    if (status != PSA_SUCCESS) {\0A        goto exit;\0A    }\0A\0A    status = psa_hash_update(&op, C_random_value,\0A                             MBEDTLS_LMOTS_C_RANDOM_VALUE_LEN(params->type));\0A    if (status != PSA_SUCCESS) {\0A        goto exit;\0A    }\0A\0A    status = psa_hash_update(&op, msg, msg_len);\0A    if (status != PSA_SUCCESS) {\0A        goto exit;\0A    }\0A\0A    status = psa_hash_finish(&op, out,\0A                             MBEDTLS_LMOTS_N_HASH_LEN(params->type),\0A                             &output_hash_len);\0A    if (status != PSA_SUCCESS) {\0A        goto exit;\0A    }\0A\0A    checksum = lmots_checksum_calculate(params, out);\0A    MBEDTLS_PUT_UINT16_BE(checksum, out, MBEDTLS_LMOTS_N_HASH_LEN(params->type));\0A\0Aexit:\0A    psa_hash_abort(&op);\0A\0A    return PSA_TO_MBEDTLS_ERR(status);\0A}\0A\0A/* Hash each element of the string of digits (+ checksum), producing a hash\0A * output for each element. This is used in several places (by varying the\0A * hash_idx_min/max_values) in order to calculate a public key from a private\0A * key (RFC8554 Algorithm 1 step 4), in order to sign a message (RFC8554\0A * Algorithm 3 step 5), and to calculate a public key candidate from a\0A * signature and message (RFC8554 Algorithm 4b step 3).\0A *\0A *  params              The LMOTS parameter set, I and q values which\0A *                      describe the key being used.\0A *\0A *  x_digit_array       The array of digits (of size P, 34 in the case of\0A *                      MBEDTLS_LMOTS_SHA256_N32_W8).\0A *\0A *  hash_idx_min_values An array of the starting values of the j iterator\0A *                      for each of the members of the digit array. If\0A *                      this value in NULL, then all iterators will start\0A *                      at 0.\0A *\0A *  hash_idx_max_values An array of the upper bound values of the j\0A *                      iterator for each of the members of the digit\0A *                      array. If this value in NULL, then iterator is\0A *                      bounded to be less than 2^w - 1 (255 in the case\0A *                      of MBEDTLS_LMOTS_SHA256_N32_W8)\0A *\0A *  output              An array containing a hash output for each member\0A *                      of the digit string P. In the case of\0A *                      MBEDTLS_LMOTS_SHA256_N32_W8, this is of size 32 *\0A *                      34.\0A */\0Astatic int hash_digit_array(const mbedtls_lmots_parameters_t *params,\0A                            const unsigned char *x_digit_array,\0A                            const unsigned char *hash_idx_min_values,\0A                            const unsigned char *hash_idx_max_values,\0A                            unsigned char *output)\0A{\0A    unsigned int i_digit_idx;\0A    unsigned char i_digit_idx_bytes[I_DIGIT_IDX_LEN];\0A    unsigned int j_hash_idx;\0A    unsigned char j_hash_idx_bytes[J_HASH_IDX_LEN];\0A    unsigned int j_hash_idx_min;\0A    unsigned int j_hash_idx_max;\0A    psa_hash_operation_t op = PSA_HASH_OPERATION_INIT;\0A    psa_status_t status = PSA_ERROR_CORRUPTION_DETECTED;\0A    size_t output_hash_len;\0A    unsigned char tmp_hash[MBEDTLS_LMOTS_N_HASH_LEN_MAX];\0A\0A    for (i_digit_idx = 0;\0A         i_digit_idx < MBEDTLS_LMOTS_P_SIG_DIGIT_COUNT(params->type);\0A         i_digit_idx++) {\0A\0A        memcpy(tmp_hash,\0A               &x_digit_array[i_digit_idx * MBEDTLS_LMOTS_N_HASH_LEN(params->type)],\0A               MBEDTLS_LMOTS_N_HASH_LEN(params->type));\0A\0A        j_hash_idx_min = hash_idx_min_values != NULL ?\0A                         hash_idx_min_values[i_digit_idx] : 0;\0A        j_hash_idx_max = hash_idx_max_values != NULL ?\0A                         hash_idx_max_values[i_digit_idx] : DIGIT_MAX_VALUE;\0A\0A        for (j_hash_idx = j_hash_idx_min;\0A             j_hash_idx < j_hash_idx_max;\0A             j_hash_idx++) {\0A            status = psa_hash_setup(&op, PSA_ALG_SHA_256);\0A            if (status != PSA_SUCCESS) {\0A                goto exit;\0A            }\0A\0A            status = psa_hash_update(&op,\0A                                     params->I_key_identifier,\0A                                     MBEDTLS_LMOTS_I_KEY_ID_LEN);\0A            if (status != PSA_SUCCESS) {\0A                goto exit;\0A            }\0A\0A            status = psa_hash_update(&op,\0A                                     params->q_leaf_identifier,\0A                                     MBEDTLS_LMOTS_Q_LEAF_ID_LEN);\0A            if (status != PSA_SUCCESS) {\0A                goto exit;\0A            }\0A\0A            MBEDTLS_PUT_UINT16_BE(i_digit_idx, i_digit_idx_bytes, 0);\0A            status = psa_hash_update(&op, i_digit_idx_bytes, I_DIGIT_IDX_LEN);\0A            if (status != PSA_SUCCESS) {\0A                goto exit;\0A            }\0A\0A            j_hash_idx_bytes[0] = (uint8_t) j_hash_idx;\0A            status = psa_hash_update(&op, j_hash_idx_bytes, J_HASH_IDX_LEN);\0A            if (status != PSA_SUCCESS) {\0A                goto exit;\0A            }\0A\0A            status = psa_hash_update(&op, tmp_hash,\0A                                     MBEDTLS_LMOTS_N_HASH_LEN(params->type));\0A            if (status != PSA_SUCCESS) {\0A                goto exit;\0A            }\0A\0A            status = psa_hash_finish(&op, tmp_hash, sizeof(tmp_hash),\0A                                     &output_hash_len);\0A            if (status != PSA_SUCCESS) {\0A                goto exit;\0A            }\0A\0A            psa_hash_abort(&op);\0A        }\0A\0A        memcpy(&output[i_digit_idx * MBEDTLS_LMOTS_N_HASH_LEN(params->type)],\0A               tmp_hash, MBEDTLS_LMOTS_N_HASH_LEN(params->type));\0A    }\0A\0Aexit:\0A    psa_hash_abort(&op);\0A    mbedtls_platform_zeroize(tmp_hash, sizeof(tmp_hash));\0A\0A    return PSA_TO_MBEDTLS_ERR(status);\0A}\0A\0A/* Combine the hashes of the digit array into a public key. This is used in\0A * in order to calculate a public key from a private key (RFC8554 Algorithm 1\0A * step 4), and to calculate a public key candidate from a signature and message\0A * (RFC8554 Algorithm 4b step 3).\0A *\0A *  params           The LMOTS parameter set, I and q values which describe\0A *                   the key being used.\0A *  y_hashed_digits  The array of hashes, one hash for each digit of the\0A *                   symbol array (which is of size P, 34 in the case of\0A *                   MBEDTLS_LMOTS_SHA256_N32_W8)\0A *\0A *  pub_key          The output public key (or candidate public key in\0A *                   case this is being run as part of signature\0A *                   verification), in the form of a hash output.\0A */\0Astatic int public_key_from_hashed_digit_array(const mbedtls_lmots_parameters_t *params,\0A                                              const unsigned char *y_hashed_digits,\0A                                              unsigned char *pub_key)\0A{\0A    psa_hash_operation_t op = PSA_HASH_OPERATION_INIT;\0A    psa_status_t status = PSA_ERROR_CORRUPTION_DETECTED;\0A    size_t output_hash_len;\0A\0A    status = psa_hash_setup(&op, PSA_ALG_SHA_256);\0A    if (status != PSA_SUCCESS) {\0A        goto exit;\0A    }\0A\0A    status = psa_hash_update(&op,\0A                             params->I_key_identifier,\0A                             MBEDTLS_LMOTS_I_KEY_ID_LEN);\0A    if (status != PSA_SUCCESS) {\0A        goto exit;\0A    }\0A\0A    status = psa_hash_update(&op, params->q_leaf_identifier,\0A                             MBEDTLS_LMOTS_Q_LEAF_ID_LEN);\0A    if (status != PSA_SUCCESS) {\0A        goto exit;\0A    }\0A\0A    status = psa_hash_update(&op, D_PUBLIC_CONSTANT_BYTES, D_CONST_LEN);\0A    if (status != PSA_SUCCESS) {\0A        goto exit;\0A    }\0A\0A    status = psa_hash_update(&op, y_hashed_digits,\0A                             MBEDTLS_LMOTS_P_SIG_DIGIT_COUNT(params->type) *\0A                             MBEDTLS_LMOTS_N_HASH_LEN(params->type));\0A    if (status != PSA_SUCCESS) {\0A        goto exit;\0A    }\0A\0A    status = psa_hash_finish(&op, pub_key,\0A                             MBEDTLS_LMOTS_N_HASH_LEN(params->type),\0A                             &output_hash_len);\0A    if (status != PSA_SUCCESS) {\0A\0Aexit:\0A        psa_hash_abort(&op);\0A    }\0A\0A    return PSA_TO_MBEDTLS_ERR(status);\0A}\0A\0A#if !defined(MBEDTLS_DEPRECATED_REMOVED)\0Aint mbedtls_lms_error_from_psa(psa_status_t status)\0A{\0A    switch (status) {\0A        case PSA_SUCCESS:\0A            return 0;\0A        case PSA_ERROR_HARDWARE_FAILURE:\0A            return MBEDTLS_ERR_PLATFORM_HW_ACCEL_FAILED;\0A        case PSA_ERROR_NOT_SUPPORTED:\0A            return MBEDTLS_ERR_PLATFORM_FEATURE_UNSUPPORTED;\0A        case PSA_ERROR_BUFFER_TOO_SMALL:\0A            return MBEDTLS_ERR_LMS_BUFFER_TOO_SMALL;\0A        case PSA_ERROR_INVALID_ARGUMENT:\0A            return MBEDTLS_ERR_LMS_BAD_INPUT_DATA;\0A        default:\0A            return MBEDTLS_ERR_ERROR_GENERIC_ERROR;\0A    }\0A}\0A#endif /* !MBEDTLS_DEPRECATED_REMOVED */\0A\0Avoid mbedtls_lmots_public_init(mbedtls_lmots_public_t *ctx)\0A{\0A    memset(ctx, 0, sizeof(*ctx));\0A}\0A\0Avoid mbedtls_lmots_public_free(mbedtls_lmots_public_t *ctx)\0A{\0A    if (ctx == NULL) {\0A        return;\0A    }\0A\0A    mbedtls_platform_zeroize(ctx, sizeof(*ctx));\0A}\0A\0Aint mbedtls_lmots_import_public_key(mbedtls_lmots_public_t *ctx,\0A                                    const unsigned char *key, size_t key_len)\0A{\0A    if (key_len < MBEDTLS_LMOTS_SIG_TYPE_OFFSET + MBEDTLS_LMOTS_TYPE_LEN) {\0A        return MBEDTLS_ERR_LMS_BAD_INPUT_DATA;\0A    }\0A\0A    ctx->params.type = (mbedtls_lmots_algorithm_type_t)\0A                       MBEDTLS_GET_UINT32_BE(key, MBEDTLS_LMOTS_SIG_TYPE_OFFSET);\0A\0A    if (key_len != MBEDTLS_LMOTS_PUBLIC_KEY_LEN(ctx->params.type)) {\0A        return MBEDTLS_ERR_LMS_BAD_INPUT_DATA;\0A    }\0A\0A    memcpy(ctx->params.I_key_identifier,\0A           key + PUBLIC_KEY_I_KEY_ID_OFFSET,\0A           MBEDTLS_LMOTS_I_KEY_ID_LEN);\0A\0A    memcpy(ctx->params.q_leaf_identifier,\0A           key + PUBLIC_KEY_Q_LEAF_ID_OFFSET,\0A           MBEDTLS_LMOTS_Q_LEAF_ID_LEN);\0A\0A    memcpy(ctx->public_key,\0A           key + PUBLIC_KEY_KEY_HASH_OFFSET,\0A           MBEDTLS_LMOTS_N_HASH_LEN(ctx->params.type));\0A\0A    ctx->have_public_key = 1;\0A\0A    return 0;\0A}\0A\0Aint mbedtls_lmots_export_public_key(const mbedtls_lmots_public_t *ctx,\0A                                    unsigned char *key, size_t key_size,\0A                                    size_t *key_len)\0A{\0A    if (key_size < MBEDTLS_LMOTS_PUBLIC_KEY_LEN(ctx->params.type)) {\0A        return MBEDTLS_ERR_LMS_BUFFER_TOO_SMALL;\0A    }\0A\0A    if (!ctx->have_public_key) {\0A        return MBEDTLS_ERR_LMS_BAD_INPUT_DATA;\0A    }\0A\0A    MBEDTLS_PUT_UINT32_BE(ctx->params.type, key, MBEDTLS_LMOTS_SIG_TYPE_OFFSET);\0A\0A    memcpy(key + PUBLIC_KEY_I_KEY_ID_OFFSET,\0A           ctx->params.I_key_identifier,\0A           MBEDTLS_LMOTS_I_KEY_ID_LEN);\0A\0A    memcpy(key + PUBLIC_KEY_Q_LEAF_ID_OFFSET,\0A           ctx->params.q_leaf_identifier,\0A           MBEDTLS_LMOTS_Q_LEAF_ID_LEN);\0A\0A    memcpy(key + PUBLIC_KEY_KEY_HASH_OFFSET, ctx->public_key,\0A           MBEDTLS_LMOTS_N_HASH_LEN(ctx->params.type));\0A\0A    if (key_len != NULL) {\0A        *key_len = MBEDTLS_LMOTS_PUBLIC_KEY_LEN(ctx->params.type);\0A    }\0A\0A    return 0;\0A}\0A\0Aint mbedtls_lmots_calculate_public_key_candidate(const mbedtls_lmots_parameters_t *params,\0A                                                 const unsigned char  *msg,\0A                                                 size_t msg_size,\0A                                                 const unsigned char *sig,\0A                                                 size_t sig_size,\0A                                                 unsigned char *out,\0A                                                 size_t out_size,\0A                                                 size_t *out_len)\0A{\0A    unsigned char tmp_digit_array[MBEDTLS_LMOTS_P_SIG_DIGIT_COUNT_MAX];\0A    unsigned char y_hashed_digits[MBEDTLS_LMOTS_P_SIG_DIGIT_COUNT_MAX][MBEDTLS_LMOTS_N_HASH_LEN_MAX];\0A    int ret = MBEDTLS_ERR_ERROR_CORRUPTION_DETECTED;\0A\0A    if (msg == NULL && msg_size != 0) {\0A        return MBEDTLS_ERR_LMS_BAD_INPUT_DATA;\0A    }\0A\0A    if (sig_size != MBEDTLS_LMOTS_SIG_LEN(params->type) ||\0A        out_size < MBEDTLS_LMOTS_N_HASH_LEN(params->type)) {\0A        return MBEDTLS_ERR_LMS_BAD_INPUT_DATA;\0A    }\0A\0A    ret = create_digit_array_with_checksum(params, msg, msg_size,\0A                                           sig + MBEDTLS_LMOTS_SIG_C_RANDOM_OFFSET,\0A                                           tmp_digit_array);\0A    if (ret) {\0A        return ret;\0A    }\0A\0A    ret = hash_digit_array(params,\0A                           sig + MBEDTLS_LMOTS_SIG_SIGNATURE_OFFSET(params->type),\0A                           tmp_digit_array, NULL, (unsigned char *) y_hashed_digits);\0A    if (ret) {\0A        return ret;\0A    }\0A\0A    ret = public_key_from_hashed_digit_array(params,\0A                                             (unsigned char *) y_hashed_digits,\0A                                             out);\0A    if (ret) {\0A        return ret;\0A    }\0A\0A    if (out_len != NULL) {\0A        *out_len = MBEDTLS_LMOTS_N_HASH_LEN(params->type);\0A    }\0A\0A    return 0;\0A}\0A\0Aint mbedtls_lmots_verify(const mbedtls_lmots_public_t *ctx,\0A                         const unsigned char *msg, size_t msg_size,\0A                         const unsigned char *sig, size_t sig_size)\0A{\0A    unsigned char Kc_public_key_candidate[MBEDTLS_LMOTS_N_HASH_LEN_MAX];\0A    int ret = MBEDTLS_ERR_ERROR_CORRUPTION_DETECTED;\0A\0A    if (msg == NULL && msg_size != 0) {\0A        return MBEDTLS_ERR_LMS_BAD_INPUT_DATA;\0A    }\0A\0A    if (!ctx->have_public_key) {\0A        return MBEDTLS_ERR_LMS_BAD_INPUT_DATA;\0A    }\0A\0A    if (ctx->params.type != MBEDTLS_LMOTS_SHA256_N32_W8) {\0A        return MBEDTLS_ERR_LMS_BAD_INPUT_DATA;\0A    }\0A\0A    if (sig_size < MBEDTLS_LMOTS_SIG_TYPE_OFFSET + MBEDTLS_LMOTS_TYPE_LEN) {\0A        return MBEDTLS_ERR_LMS_VERIFY_FAILED;\0A    }\0A\0A    if (MBEDTLS_GET_UINT32_BE(sig, MBEDTLS_LMOTS_SIG_TYPE_OFFSET) != MBEDTLS_LMOTS_SHA256_N32_W8) {\0A        return MBEDTLS_ERR_LMS_VERIFY_FAILED;\0A    }\0A\0A    ret = mbedtls_lmots_calculate_public_key_candidate(&ctx->params,\0A                                                       msg, msg_size, sig, sig_size,\0A                                                       Kc_public_key_candidate,\0A                                                       MBEDTLS_LMOTS_N_HASH_LEN(ctx->params.type),\0A                                                       NULL);\0A    if (ret) {\0A        return MBEDTLS_ERR_LMS_VERIFY_FAILED;\0A    }\0A\0A    if (memcmp(&Kc_public_key_candidate, ctx->public_key,\0A               sizeof(ctx->public_key))) {\0A        return MBEDTLS_ERR_LMS_VERIFY_FAILED;\0A    }\0A\0A    return 0;\0A}\0A\0A#if defined(MBEDTLS_LMS_PRIVATE)\0A\0Avoid mbedtls_lmots_private_init(mbedtls_lmots_private_t *ctx)\0A{\0A    memset(ctx, 0, sizeof(*ctx));\0A}\0A\0Avoid mbedtls_lmots_private_free(mbedtls_lmots_private_t *ctx)\0A{\0A    if (ctx == NULL) {\0A        return;\0A    }\0A\0A    mbedtls_platform_zeroize(ctx,\0A                             sizeof(*ctx));\0A}\0A\0Aint mbedtls_lmots_generate_private_key(mbedtls_lmots_private_t *ctx,\0A                                       mbedtls_lmots_algorithm_type_t type,\0A                                       const unsigned char I_key_identifier[MBEDTLS_LMOTS_I_KEY_ID_LEN],\0A                                       uint32_t q_leaf_identifier,\0A                                       const unsigned char *seed,\0A                                       size_t seed_size)\0A{\0A    psa_hash_operation_t op = PSA_HASH_OPERATION_INIT;\0A    psa_status_t status = PSA_ERROR_CORRUPTION_DETECTED;\0A    size_t output_hash_len;\0A    unsigned int i_digit_idx;\0A    unsigned char i_digit_idx_bytes[2];\0A    unsigned char const_bytes[1] = { 0xFF };\0A\0A    if (ctx->have_private_key) {\0A        return MBEDTLS_ERR_LMS_BAD_INPUT_DATA;\0A    }\0A\0A    if (type != MBEDTLS_LMOTS_SHA256_N32_W8) {\0A        return MBEDTLS_ERR_LMS_BAD_INPUT_DATA;\0A    }\0A\0A    ctx->params.type = type;\0A\0A    memcpy(ctx->params.I_key_identifier,\0A           I_key_identifier,\0A           sizeof(ctx->params.I_key_identifier));\0A\0A    MBEDTLS_PUT_UINT32_BE(q_leaf_identifier, ctx->params.q_leaf_identifier, 0);\0A\0A    for (i_digit_idx = 0;\0A         i_digit_idx < MBEDTLS_LMOTS_P_SIG_DIGIT_COUNT(ctx->params.type);\0A         i_digit_idx++) {\0A        status = psa_hash_setup(&op, PSA_ALG_SHA_256);\0A        if (status != PSA_SUCCESS) {\0A            goto exit;\0A        }\0A\0A        status = psa_hash_update(&op,\0A                                 ctx->params.I_key_identifier,\0A                                 sizeof(ctx->params.I_key_identifier));\0A        if (status != PSA_SUCCESS) {\0A            goto exit;\0A        }\0A\0A        status = psa_hash_update(&op,\0A                                 ctx->params.q_leaf_identifier,\0A                                 MBEDTLS_LMOTS_Q_LEAF_ID_LEN);\0A        if (status != PSA_SUCCESS) {\0A            goto exit;\0A        }\0A\0A        MBEDTLS_PUT_UINT16_BE(i_digit_idx, i_digit_idx_bytes, 0);\0A        status = psa_hash_update(&op, i_digit_idx_bytes, I_DIGIT_IDX_LEN);\0A        if (status != PSA_SUCCESS) {\0A            goto exit;\0A        }\0A\0A        status = psa_hash_update(&op, const_bytes, sizeof(const_bytes));\0A        if (status != PSA_SUCCESS) {\0A            goto exit;\0A        }\0A\0A        status = psa_hash_update(&op, seed, seed_size);\0A        if (status != PSA_SUCCESS) {\0A            goto exit;\0A        }\0A\0A        status = psa_hash_finish(&op,\0A                                 ctx->private_key[i_digit_idx],\0A                                 MBEDTLS_LMOTS_N_HASH_LEN(ctx->params.type),\0A                                 &output_hash_len);\0A        if (status != PSA_SUCCESS) {\0A            goto exit;\0A        }\0A\0A        psa_hash_abort(&op);\0A    }\0A\0A    ctx->have_private_key = 1;\0A\0Aexit:\0A    psa_hash_abort(&op);\0A\0A    return PSA_TO_MBEDTLS_ERR(status);\0A}\0A\0Aint mbedtls_lmots_calculate_public_key(mbedtls_lmots_public_t *ctx,\0A                                       const mbedtls_lmots_private_t *priv_ctx)\0A{\0A    unsigned char y_hashed_digits[MBEDTLS_LMOTS_P_SIG_DIGIT_COUNT_MAX][MBEDTLS_LMOTS_N_HASH_LEN_MAX];\0A    int ret = MBEDTLS_ERR_ERROR_CORRUPTION_DETECTED;\0A\0A    /* Check that a private key is loaded */\0A    if (!priv_ctx->have_private_key) {\0A        return MBEDTLS_ERR_LMS_BAD_INPUT_DATA;\0A    }\0A\0A    ret = hash_digit_array(&priv_ctx->params,\0A                           (unsigned char *) priv_ctx->private_key, NULL,\0A                           NULL, (unsigned char *) y_hashed_digits);\0A    if (ret) {\0A        goto exit;\0A    }\0A\0A    ret = public_key_from_hashed_digit_array(&priv_ctx->params,\0A                                             (unsigned char *) y_hashed_digits,\0A                                             ctx->public_key);\0A    if (ret) {\0A        goto exit;\0A    }\0A\0A    memcpy(&ctx->params, &priv_ctx->params,\0A           sizeof(ctx->params));\0A\0A    ctx->have_public_key = 1;\0A\0Aexit:\0A    mbedtls_platform_zeroize(y_hashed_digits, sizeof(y_hashed_digits));\0A\0A    return ret;\0A}\0A\0Aint mbedtls_lmots_sign(mbedtls_lmots_private_t *ctx,\0A                       int (*f_rng)(void *, unsigned char *, size_t),\0A                       void *p_rng, const unsigned char *msg, size_t msg_size,\0A                       unsigned char *sig, size_t sig_size, size_t *sig_len)\0A{\0A    unsigned char tmp_digit_array[MBEDTLS_LMOTS_P_SIG_DIGIT_COUNT_MAX];\0A    /* Create a temporary buffer to prepare the signature in. This allows us to\0A     * finish creating a signature (ensuring the process doesn't fail), and then\0A     * erase the private key **before** writing any data into the sig parameter\0A     * buffer. If data were directly written into the sig buffer, it might leak\0A     * a partial signature on failure, which effectively compromises the private\0A     * key.\0A     */\0A    unsigned char tmp_sig[MBEDTLS_LMOTS_P_SIG_DIGIT_COUNT_MAX][MBEDTLS_LMOTS_N_HASH_LEN_MAX];\0A    unsigned char tmp_c_random[MBEDTLS_LMOTS_N_HASH_LEN_MAX];\0A    int ret = MBEDTLS_ERR_ERROR_CORRUPTION_DETECTED;\0A\0A    if (msg == NULL && msg_size != 0) {\0A        return MBEDTLS_ERR_LMS_BAD_INPUT_DATA;\0A    }\0A\0A    if (sig_size < MBEDTLS_LMOTS_SIG_LEN(ctx->params.type)) {\0A        return MBEDTLS_ERR_LMS_BUFFER_TOO_SMALL;\0A    }\0A\0A    /* Check that a private key is loaded */\0A    if (!ctx->have_private_key) {\0A        return MBEDTLS_ERR_LMS_BAD_INPUT_DATA;\0A    }\0A\0A    ret = f_rng(p_rng, tmp_c_random,\0A                MBEDTLS_LMOTS_N_HASH_LEN(ctx->params.type));\0A    if (ret) {\0A        return ret;\0A    }\0A\0A    ret = create_digit_array_with_checksum(&ctx->params,\0A                                           msg, msg_size,\0A                                           tmp_c_random,\0A                                           tmp_digit_array);\0A    if (ret) {\0A        goto exit;\0A    }\0A\0A    ret = hash_digit_array(&ctx->params, (unsigned char *) ctx->private_key,\0A                           NULL, tmp_digit_array, (unsigned char *) tmp_sig);\0A    if (ret) {\0A        goto exit;\0A    }\0A\0A    MBEDTLS_PUT_UINT32_BE(ctx->params.type, sig, MBEDTLS_LMOTS_SIG_TYPE_OFFSET);\0A\0A    /* Test hook to check if sig is being written to before we invalidate the\0A     * private key.\0A     */\0A#if defined(MBEDTLS_TEST_HOOKS)\0A    if (mbedtls_lmots_sign_private_key_invalidated_hook != NULL) {\0A        ret = (*mbedtls_lmots_sign_private_key_invalidated_hook)(sig);\0A        if (ret != 0) {\0A            return ret;\0A        }\0A    }\0A#endif /* defined(MBEDTLS_TEST_HOOKS) */\0A\0A    /* We've got a valid signature now, so it's time to make sure the private\0A     * key can't be reused.\0A     */\0A    ctx->have_private_key = 0;\0A    mbedtls_platform_zeroize(ctx->private_key,\0A                             sizeof(ctx->private_key));\0A\0A    memcpy(sig + MBEDTLS_LMOTS_SIG_C_RANDOM_OFFSET, tmp_c_random,\0A           MBEDTLS_LMOTS_C_RANDOM_VALUE_LEN(ctx->params.type));\0A\0A    memcpy(sig + MBEDTLS_LMOTS_SIG_SIGNATURE_OFFSET(ctx->params.type), tmp_sig,\0A           MBEDTLS_LMOTS_P_SIG_DIGIT_COUNT(ctx->params.type)\0A           * MBEDTLS_LMOTS_N_HASH_LEN(ctx->params.type));\0A\0A    if (sig_len != NULL) {\0A        *sig_len = MBEDTLS_LMOTS_SIG_LEN(ctx->params.type);\0A    }\0A\0A    ret = 0;\0A\0Aexit:\0A    mbedtls_platform_zeroize(tmp_digit_array, sizeof(tmp_digit_array));\0A    mbedtls_platform_zeroize(tmp_sig, sizeof(tmp_sig));\0A\0A    return ret;\0A}\0A\0A#endif /* defined(MBEDTLS_LMS_PRIVATE) */\0A#endif /* defined(MBEDTLS_LMS_C) */\0A\00" }
