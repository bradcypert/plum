@.str42443 = private global { i64, i64, [3294 x i8] } { i64 -1, i64 3293, [3294 x i8] c"/**\0A * \5Cfile padlock.h\0A *\0A * \5Cbrief VIA PadLock ACE for HW encryption/decryption supported by some\0A *        processors\0A *\0A * \5Cwarning These functions are only for internal use by other library\0A *          functions; you must not call them directly.\0A */\0A/*\0A *  Copyright The Mbed TLS Contributors\0A *  SPDX-License-Identifier: Apache-2.0 OR GPL-2.0-or-later\0A */\0A#ifndef MBEDTLS_PADLOCK_H\0A#define MBEDTLS_PADLOCK_H\0A\0A#include \22mbedtls/build_info.h\22\0A\0A#include \22mbedtls/aes.h\22\0A\0A#define MBEDTLS_ERR_PADLOCK_DATA_MISALIGNED               -0x0030  /**< Input data should be aligned. */\0A\0A#if defined(__has_feature)\0A#if __has_feature(address_sanitizer)\0A#define MBEDTLS_HAVE_ASAN\0A#endif\0A#endif\0A\0A/*\0A * - `padlock` is implements with GNUC assembly for x86 target.\0A * - Some versions of ASan result in errors about not enough registers.\0A */\0A#if defined(MBEDTLS_PADLOCK_C) && \5C\0A    defined(__GNUC__) && defined(MBEDTLS_ARCH_IS_X86) && \5C\0A    defined(MBEDTLS_HAVE_ASM) && \5C\0A    !defined(MBEDTLS_HAVE_ASAN)\0A\0A#define MBEDTLS_VIA_PADLOCK_HAVE_CODE\0A\0A#include <stdint.h>\0A\0A#define MBEDTLS_PADLOCK_RNG 0x000C\0A#define MBEDTLS_PADLOCK_ACE 0x00C0\0A#define MBEDTLS_PADLOCK_PHE 0x0C00\0A#define MBEDTLS_PADLOCK_PMM 0x3000\0A\0A#define MBEDTLS_PADLOCK_ALIGN16(x) (uint32_t *) (16 + ((int32_t) (x) & ~15))\0A\0A#ifdef __cplusplus\0Aextern \22C\22 {\0A#endif\0A\0A/**\0A * \5Cbrief          Internal PadLock detection routine\0A *\0A * \5Cnote           This function is only for internal use by other library\0A *                 functions; you must not call it directly.\0A *\0A * \5Cparam feature  The feature to detect\0A *\0A * \5Creturn         non-zero if CPU has support for the feature, 0 otherwise\0A */\0Aint mbedtls_padlock_has_support(int feature);\0A\0A/**\0A * \5Cbrief          Internal PadLock AES-ECB block en(de)cryption\0A *\0A * \5Cnote           This function is only for internal use by other library\0A *                 functions; you must not call it directly.\0A *\0A * \5Cparam ctx      AES context\0A * \5Cparam mode     MBEDTLS_AES_ENCRYPT or MBEDTLS_AES_DECRYPT\0A * \5Cparam input    16-byte input block\0A * \5Cparam output   16-byte output block\0A *\0A * \5Creturn         0 if success, 1 if operation failed\0A */\0Aint mbedtls_padlock_xcryptecb(mbedtls_aes_context *ctx,\0A                              int mode,\0A                              const unsigned char input[16],\0A                              unsigned char output[16]);\0A\0A/**\0A * \5Cbrief          Internal PadLock AES-CBC buffer en(de)cryption\0A *\0A * \5Cnote           This function is only for internal use by other library\0A *                 functions; you must not call it directly.\0A *\0A * \5Cparam ctx      AES context\0A * \5Cparam mode     MBEDTLS_AES_ENCRYPT or MBEDTLS_AES_DECRYPT\0A * \5Cparam length   length of the input data\0A * \5Cparam iv       initialization vector (updated after use)\0A * \5Cparam input    buffer holding the input data\0A * \5Cparam output   buffer holding the output data\0A *\0A * \5Creturn         0 if success, 1 if operation failed\0A */\0Aint mbedtls_padlock_xcryptcbc(mbedtls_aes_context *ctx,\0A                              int mode,\0A                              size_t length,\0A                              unsigned char iv[16],\0A                              const unsigned char *input,\0A                              unsigned char *output);\0A\0A#ifdef __cplusplus\0A}\0A#endif\0A\0A#endif /* HAVE_X86  */\0A\0A#endif /* padlock.h */\0A\00" }
