@.str40540 = private global { i64, i64, [11491 x i8] } { i64 -1, i64 11490, [11491 x i8] c"/**\0A *  Modular bignum functions\0A *\0A *  Copyright The Mbed TLS Contributors\0A *  SPDX-License-Identifier: Apache-2.0 OR GPL-2.0-or-later\0A */\0A\0A#include \22common.h\22\0A\0A#if defined(MBEDTLS_BIGNUM_C) && defined(MBEDTLS_ECP_WITH_MPI_UINT)\0A\0A#include <string.h>\0A\0A#include \22mbedtls/platform_util.h\22\0A#include \22mbedtls/error.h\22\0A#include \22mbedtls/bignum.h\22\0A\0A#include \22mbedtls/platform.h\22\0A\0A#include \22bignum_core.h\22\0A#include \22bignum_mod.h\22\0A#include \22bignum_mod_raw.h\22\0A#include \22constant_time_internal.h\22\0A\0Aint mbedtls_mpi_mod_residue_setup(mbedtls_mpi_mod_residue *r,\0A                                  const mbedtls_mpi_mod_modulus *N,\0A                                  mbedtls_mpi_uint *p,\0A                                  size_t p_limbs)\0A{\0A    if (p_limbs != N->limbs || !mbedtls_mpi_core_lt_ct(p, N->p, N->limbs)) {\0A        return MBEDTLS_ERR_MPI_BAD_INPUT_DATA;\0A    }\0A\0A    r->limbs = N->limbs;\0A    r->p = p;\0A\0A    return 0;\0A}\0A\0Avoid mbedtls_mpi_mod_residue_release(mbedtls_mpi_mod_residue *r)\0A{\0A    if (r == NULL) {\0A        return;\0A    }\0A\0A    r->limbs = 0;\0A    r->p = NULL;\0A}\0A\0Avoid mbedtls_mpi_mod_modulus_init(mbedtls_mpi_mod_modulus *N)\0A{\0A    if (N == NULL) {\0A        return;\0A    }\0A\0A    N->p = NULL;\0A    N->limbs = 0;\0A    N->bits = 0;\0A    N->int_rep = MBEDTLS_MPI_MOD_REP_INVALID;\0A}\0A\0Avoid mbedtls_mpi_mod_modulus_free(mbedtls_mpi_mod_modulus *N)\0A{\0A    if (N == NULL) {\0A        return;\0A    }\0A\0A    switch (N->int_rep) {\0A        case MBEDTLS_MPI_MOD_REP_MONTGOMERY:\0A            if (N->rep.mont.rr != NULL) {\0A                mbedtls_zeroize_and_free((mbedtls_mpi_uint *) N->rep.mont.rr,\0A                                         N->limbs * sizeof(mbedtls_mpi_uint));\0A                N->rep.mont.rr = NULL;\0A            }\0A            N->rep.mont.mm = 0;\0A            break;\0A        case MBEDTLS_MPI_MOD_REP_OPT_RED:\0A            N->rep.ored.modp = NULL;\0A            break;\0A        case MBEDTLS_MPI_MOD_REP_INVALID:\0A            break;\0A    }\0A\0A    N->p = NULL;\0A    N->limbs = 0;\0A    N->bits = 0;\0A    N->int_rep = MBEDTLS_MPI_MOD_REP_INVALID;\0A}\0A\0Astatic int set_mont_const_square(const mbedtls_mpi_uint **X,\0A                                 const mbedtls_mpi_uint *A,\0A                                 size_t limbs)\0A{\0A    int ret = MBEDTLS_ERR_ERROR_CORRUPTION_DETECTED;\0A    mbedtls_mpi N;\0A    mbedtls_mpi RR;\0A    *X = NULL;\0A\0A    mbedtls_mpi_init(&N);\0A    mbedtls_mpi_init(&RR);\0A\0A    if (A == NULL || limbs == 0 || limbs >= (MBEDTLS_MPI_MAX_LIMBS / 2) - 2) {\0A        goto cleanup;\0A    }\0A\0A    if (mbedtls_mpi_grow(&N, limbs)) {\0A        goto cleanup;\0A    }\0A\0A    memcpy(N.p, A, sizeof(mbedtls_mpi_uint) * limbs);\0A\0A    ret = mbedtls_mpi_core_get_mont_r2_unsafe(&RR, &N);\0A\0A    if (ret == 0) {\0A        *X = RR.p;\0A        RR.p = NULL;\0A    }\0A\0Acleanup:\0A    mbedtls_mpi_free(&N);\0A    mbedtls_mpi_free(&RR);\0A    ret = (ret != 0) ? MBEDTLS_ERR_ERROR_CORRUPTION_DETECTED : 0;\0A    return ret;\0A}\0A\0Astatic inline void standard_modulus_setup(mbedtls_mpi_mod_modulus *N,\0A                                          const mbedtls_mpi_uint *p,\0A                                          size_t p_limbs,\0A                                          mbedtls_mpi_mod_rep_selector int_rep)\0A{\0A    N->p = p;\0A    N->limbs = p_limbs;\0A    N->bits = mbedtls_mpi_core_bitlen(p, p_limbs);\0A    N->int_rep = int_rep;\0A}\0A\0Aint mbedtls_mpi_mod_modulus_setup(mbedtls_mpi_mod_modulus *N,\0A                                  const mbedtls_mpi_uint *p,\0A                                  size_t p_limbs)\0A{\0A    int ret = 0;\0A    standard_modulus_setup(N, p, p_limbs, MBEDTLS_MPI_MOD_REP_MONTGOMERY);\0A    N->rep.mont.mm = mbedtls_mpi_core_montmul_init(N->p);\0A    ret = set_mont_const_square(&N->rep.mont.rr, N->p, N->limbs);\0A\0A    if (ret != 0) {\0A        mbedtls_mpi_mod_modulus_free(N);\0A    }\0A\0A    return ret;\0A}\0A\0Aint mbedtls_mpi_mod_optred_modulus_setup(mbedtls_mpi_mod_modulus *N,\0A                                         const mbedtls_mpi_uint *p,\0A                                         size_t p_limbs,\0A                                         mbedtls_mpi_modp_fn modp)\0A{\0A    standard_modulus_setup(N, p, p_limbs, MBEDTLS_MPI_MOD_REP_OPT_RED);\0A    N->rep.ored.modp = modp;\0A    return 0;\0A}\0A\0Aint mbedtls_mpi_mod_mul(mbedtls_mpi_mod_residue *X,\0A                        const mbedtls_mpi_mod_residue *A,\0A                        const mbedtls_mpi_mod_residue *B,\0A                        const mbedtls_mpi_mod_modulus *N)\0A{\0A    if (N->limbs == 0) {\0A        return MBEDTLS_ERR_MPI_BAD_INPUT_DATA;\0A    }\0A\0A    if (X->limbs != N->limbs || A->limbs != N->limbs || B->limbs != N->limbs) {\0A        return MBEDTLS_ERR_MPI_BAD_INPUT_DATA;\0A    }\0A\0A    mbedtls_mpi_uint *T = mbedtls_calloc(N->limbs * 2 + 1, ciL);\0A    if (T == NULL) {\0A        return MBEDTLS_ERR_MPI_ALLOC_FAILED;\0A    }\0A\0A    mbedtls_mpi_mod_raw_mul(X->p, A->p, B->p, N, T);\0A\0A    mbedtls_free(T);\0A\0A    return 0;\0A}\0A\0Aint mbedtls_mpi_mod_sub(mbedtls_mpi_mod_residue *X,\0A                        const mbedtls_mpi_mod_residue *A,\0A                        const mbedtls_mpi_mod_residue *B,\0A                        const mbedtls_mpi_mod_modulus *N)\0A{\0A    if (X->limbs != N->limbs || A->limbs != N->limbs || B->limbs != N->limbs) {\0A        return MBEDTLS_ERR_MPI_BAD_INPUT_DATA;\0A    }\0A\0A    mbedtls_mpi_mod_raw_sub(X->p, A->p, B->p, N);\0A\0A    return 0;\0A}\0A\0Astatic int mbedtls_mpi_mod_inv_mont(mbedtls_mpi_mod_residue *X,\0A                                    const mbedtls_mpi_mod_residue *A,\0A                                    const mbedtls_mpi_mod_modulus *N,\0A                                    mbedtls_mpi_uint *working_memory)\0A{\0A    /* Input already in Montgomery form, so there's little to do */\0A    mbedtls_mpi_mod_raw_inv_prime(X->p, A->p,\0A                                  N->p, N->limbs,\0A                                  N->rep.mont.rr,\0A                                  working_memory);\0A    return 0;\0A}\0A\0Astatic int mbedtls_mpi_mod_inv_non_mont(mbedtls_mpi_mod_residue *X,\0A                                        const mbedtls_mpi_mod_residue *A,\0A                                        const mbedtls_mpi_mod_modulus *N,\0A                                        mbedtls_mpi_uint *working_memory)\0A{\0A    /* Need to convert input into Montgomery form */\0A\0A    int ret = MBEDTLS_ERR_ERROR_CORRUPTION_DETECTED;\0A\0A    mbedtls_mpi_mod_modulus Nmont;\0A    mbedtls_mpi_mod_modulus_init(&Nmont);\0A\0A    MBEDTLS_MPI_CHK(mbedtls_mpi_mod_modulus_setup(&Nmont, N->p, N->limbs));\0A\0A    /* We'll use X->p to hold the Montgomery form of the input A->p */\0A    mbedtls_mpi_core_to_mont_rep(X->p, A->p, Nmont.p, Nmont.limbs,\0A                                 Nmont.rep.mont.mm, Nmont.rep.mont.rr,\0A                                 working_memory);\0A\0A    mbedtls_mpi_mod_raw_inv_prime(X->p, X->p,\0A                                  Nmont.p, Nmont.limbs,\0A                                  Nmont.rep.mont.rr,\0A                                  working_memory);\0A\0A    /* And convert back from Montgomery form */\0A\0A    mbedtls_mpi_core_from_mont_rep(X->p, X->p, Nmont.p, Nmont.limbs,\0A                                   Nmont.rep.mont.mm, working_memory);\0A\0Acleanup:\0A    mbedtls_mpi_mod_modulus_free(&Nmont);\0A    return ret;\0A}\0A\0Aint mbedtls_mpi_mod_inv(mbedtls_mpi_mod_residue *X,\0A                        const mbedtls_mpi_mod_residue *A,\0A                        const mbedtls_mpi_mod_modulus *N)\0A{\0A    if (X->limbs != N->limbs || A->limbs != N->limbs) {\0A        return MBEDTLS_ERR_MPI_BAD_INPUT_DATA;\0A    }\0A\0A    /* Zero has the same value regardless of Montgomery form or not */\0A    if (mbedtls_mpi_core_check_zero_ct(A->p, A->limbs) == 0) {\0A        return MBEDTLS_ERR_MPI_BAD_INPUT_DATA;\0A    }\0A\0A    size_t working_limbs =\0A        mbedtls_mpi_mod_raw_inv_prime_working_limbs(N->limbs);\0A\0A    mbedtls_mpi_uint *working_memory = mbedtls_calloc(working_limbs,\0A                                                      sizeof(mbedtls_mpi_uint));\0A    if (working_memory == NULL) {\0A        return MBEDTLS_ERR_MPI_ALLOC_FAILED;\0A    }\0A\0A    int ret = MBEDTLS_ERR_ERROR_CORRUPTION_DETECTED;\0A\0A    switch (N->int_rep) {\0A        case MBEDTLS_MPI_MOD_REP_MONTGOMERY:\0A            ret = mbedtls_mpi_mod_inv_mont(X, A, N, working_memory);\0A            break;\0A        case MBEDTLS_MPI_MOD_REP_OPT_RED:\0A            ret = mbedtls_mpi_mod_inv_non_mont(X, A, N, working_memory);\0A            break;\0A        default:\0A            ret = MBEDTLS_ERR_MPI_BAD_INPUT_DATA;\0A            break;\0A    }\0A\0A    mbedtls_zeroize_and_free(working_memory,\0A                             working_limbs * sizeof(mbedtls_mpi_uint));\0A\0A    return ret;\0A}\0A\0Aint mbedtls_mpi_mod_add(mbedtls_mpi_mod_residue *X,\0A                        const mbedtls_mpi_mod_residue *A,\0A                        const mbedtls_mpi_mod_residue *B,\0A                        const mbedtls_mpi_mod_modulus *N)\0A{\0A    if (X->limbs != N->limbs || A->limbs != N->limbs || B->limbs != N->limbs) {\0A        return MBEDTLS_ERR_MPI_BAD_INPUT_DATA;\0A    }\0A\0A    mbedtls_mpi_mod_raw_add(X->p, A->p, B->p, N);\0A\0A    return 0;\0A}\0A\0Aint mbedtls_mpi_mod_random(mbedtls_mpi_mod_residue *X,\0A                           mbedtls_mpi_uint min,\0A                           const mbedtls_mpi_mod_modulus *N,\0A                           int (*f_rng)(void *, unsigned char *, size_t),\0A                           void *p_rng)\0A{\0A    if (X->limbs != N->limbs) {\0A        return MBEDTLS_ERR_MPI_BAD_INPUT_DATA;\0A    }\0A    return mbedtls_mpi_mod_raw_random(X->p, min, N, f_rng, p_rng);\0A}\0A\0Aint mbedtls_mpi_mod_read(mbedtls_mpi_mod_residue *r,\0A                         const mbedtls_mpi_mod_modulus *N,\0A                         const unsigned char *buf,\0A                         size_t buflen,\0A                         mbedtls_mpi_mod_ext_rep ext_rep)\0A{\0A    int ret = MBEDTLS_ERR_MPI_BAD_INPUT_DATA;\0A\0A    /* Do our best to check if r and m have been set up */\0A    if (r->limbs == 0 || N->limbs == 0) {\0A        goto cleanup;\0A    }\0A    if (r->limbs != N->limbs) {\0A        goto cleanup;\0A    }\0A\0A    ret = mbedtls_mpi_mod_raw_read(r->p, N, buf, buflen, ext_rep);\0A    if (ret != 0) {\0A        goto cleanup;\0A    }\0A\0A    r->limbs = N->limbs;\0A\0A    ret = mbedtls_mpi_mod_raw_canonical_to_modulus_rep(r->p, N);\0A\0Acleanup:\0A    return ret;\0A}\0A\0Aint mbedtls_mpi_mod_write(const mbedtls_mpi_mod_residue *r,\0A                          const mbedtls_mpi_mod_modulus *N,\0A                          unsigned char *buf,\0A                          size_t buflen,\0A                          mbedtls_mpi_mod_ext_rep ext_rep)\0A{\0A    /* Do our best to check if r and m have been set up */\0A    if (r->limbs == 0 || N->limbs == 0) {\0A        return MBEDTLS_ERR_MPI_BAD_INPUT_DATA;\0A    }\0A    if (r->limbs != N->limbs) {\0A        return MBEDTLS_ERR_MPI_BAD_INPUT_DATA;\0A    }\0A\0A    int ret = MBEDTLS_ERR_ERROR_CORRUPTION_DETECTED;\0A    mbedtls_mpi_uint *working_memory = r->p;\0A    size_t working_memory_len = sizeof(mbedtls_mpi_uint) * r->limbs;\0A\0A    if (N->int_rep == MBEDTLS_MPI_MOD_REP_MONTGOMERY) {\0A\0A        working_memory = mbedtls_calloc(r->limbs, sizeof(mbedtls_mpi_uint));\0A\0A        if (working_memory == NULL) {\0A            ret = MBEDTLS_ERR_MPI_ALLOC_FAILED;\0A            goto cleanup;\0A        }\0A\0A        memcpy(working_memory, r->p, working_memory_len);\0A\0A        ret = mbedtls_mpi_mod_raw_from_mont_rep(working_memory, N);\0A        if (ret != 0) {\0A            goto cleanup;\0A        }\0A    }\0A\0A    ret = mbedtls_mpi_mod_raw_write(working_memory, N, buf, buflen, ext_rep);\0A\0Acleanup:\0A\0A    if (N->int_rep == MBEDTLS_MPI_MOD_REP_MONTGOMERY &&\0A        working_memory != NULL) {\0A\0A        mbedtls_zeroize_and_free(working_memory, working_memory_len);\0A    }\0A\0A    return ret;\0A}\0A\0A#endif /* MBEDTLS_BIGNUM_C && MBEDTLS_ECP_WITH_MPI_UINT */\0A\00" }
