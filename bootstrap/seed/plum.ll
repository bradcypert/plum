or a timeout as well would give two mechanisms\0A// racing over one deadline.\0Along long term_enter_raw(void) {\0A#if defined(_WIN32)\0A    HANDLE h = GetStdHandle(STD_INPUT_HANDLE);\0A    if (h == INVALID_HANDLE_VALUE || h == NULL) return -1;\0A    if (plum_raw_depth == 0) {\0A        if (!GetConsoleMode(h, &plum_saved_in_mode)) return -1;\0A        DWORD mode = plum_saved_in_mode;\0A        mode &= ~(ENABLE_LINE_INPUT | ENABLE_ECHO_INPUT | ENABLE_PROCESSED_INPUT);\0A        // The reason one decoder can serve every platform: with this\0A        // set, the console delivers the same VT escape sequences a\0A        // POSIX terminal does, instead of INPUT_RECORD structures.\0A        mode |= ENABLE_VIRTUAL_TERMINAL_INPUT;\0A        if (!SetConsoleMode(h, mode)) return -1;\0A    }\0A    plum_raw_depth++;\0A    return 0;\0A#else\0A    if (!isatty(STDIN_FILENO)) return -1;\0A    if (plum_raw_depth == 0) {\0A        if (tcgetattr(STDIN_FILENO, &plum_saved_termios) != 0) return -1;\0A        struct termios raw = plum_saved_termios;\0A        raw.c_iflag &= (tcflag_t)~(IXON | ICRNL | BRKINT | INPCK | ISTRIP);\0A        raw.c_oflag &= (tcflag_t)~(OPOST);\0A        raw.c_lflag &= (tcflag_t)~(ECHO | ICANON | IEXTEN | ISIG);\0A        raw.c_cflag |= (tcflag_t)CS8;\0A        raw.c_cc[VMIN] = 1;\0A        raw.c_cc[VTIME] = 0;\0A        if (tcsetattr(STDIN_FILENO, TCSAFLUSH, &raw) != 0) return -1;\0A    }\0A    plum_raw_depth++;\0A    return 0;\0A#endif\0A}\0A\0A// Takes no argument it uses: a `handle`'s cleanup is called with the\0A// number the cell holds, and these have no per-instance state -- the\0A// depth counter is what decides whether this one is the last.\0Avoid term_leave_raw(long long ignored) {\0A    (void)ignored;\0A    if (plum_raw_depth <= 0) return;\0A    plum_raw_depth--;\0A    if (plum_raw_depth > 0) return;\0A#if defined(_WIN32)\0A    HANDLE h = GetStdHandle(STD_INPUT_HANDLE);\0A    if (h != INVALID_HANDLE_VALUE && h != NULL) SetConsoleMode(h, plum_saved_in_mode);\0A#else\0A    tcsetattr(STDIN_FILENO, TCSAFLUSH, &plum_saved_termios);\0A#endif\0A}\0A\0A// Windows needs telling that escape sequences written to stdout are\0A// escape sequences. POSIX terminals need no equivalent.\0A#if defined(_WIN32)\0Astatic int plum_enable_vt_output(void) {\0A    HANDLE h = GetStdHandle(STD_OUTPUT_HANDLE);\0A    if (h == INVALID_HANDLE_VALUE || h == NULL) return -1;\0A    if (!GetConsoleMode(h, &plum_saved_out_mode)) return -1;\0A    return SetConsoleMode(h, plum_saved_out_mode | ENABLE_VIRTUAL_TERMINAL_PROCESSING) ? 0 : -1;\0A}\0A#endif\0A\0A// `\5C033[?1049h` and `?1049l`: the xterm alternate screen. Entering\0A// leaves the user's scrollback untouched and leaving puts their shell\0A// back exactly as it was, which is why a full-screen program should use\0A// it rather than clearing.\0A//\0A// Flushed immediately, unlike `term_write`. A mode change that has not\0A// reached the terminal yet is a mode change that has not happened, and\0A// everything drawn after it would land on the wrong screen.\0Along long term_enter_alt(void) {\0A    // Refused when stdout is not a terminal. Escape sequences written\0A    // into a file or a pipe are not invisible -- they are corruption,\0A    // and the caller gets an `Err` they can act on instead.\0A    if (!term_is_tty(1)) return -1;\0A    if (plum_alt_depth == 0) {\0A#if defined(_WIN32)\0A        if (plum_enable_vt_output() != 0) return -1;\0A#endif\0A        if (fputs(\22\5C033[?1049h\22, stdout) == EOF) return -1;\0A        if (fflush(stdout) != 0) return -1;\0A    }\0A    plum_alt_depth++;\0A    return 0;\0A}\0A\0Avoid term_leave_alt(long long ignored) {\0A    (void)ignored;\0A    if (plum_alt_depth <= 0) return;\0A    plum_alt_depth--;\0A    if (plum_alt_depth > 0) return;\0A    fputs(\22\5C033[?1049l\22, stdout);\0A    fflush(stdout);\0A}\0A\0Along long term_hide_cursor(void) {\0A    if (!term_is_tty(1)) return -1;\0A    if (plum_cursor_depth == 0) {\0A#if defined(_WIN32)\0A        if (plum_enable_vt_output() != 0) return -1;\0A#endif\0A        if (fputs(\22\5C033[?25l\22, stdout) == EOF) return -1;\0A        if (fflush(stdout) != 0) return -1;\0A    }\0A    plum_cursor_depth++;\0A    return 0;\0A}\0A\0Avoid term_show_cursor(long long ignored) {\0A    (void)ignored;\0A    if (plum_cursor_depth <= 0) return;\0A    plum_cursor_depth--;\0A    if (plum_cursor_depth > 0) return;\0A    fputs(\22\5C033[?25h\22, stdout);\0A    fflush(stdout);\0A}\0A\00" }
