@.str40370 = private global { i64, i64, [7024 x i8] } { i64 -1, i64 7023, [7024 x i8] c"// Streaming file I/O, behind Plum's `handle` type (issues #16 and #9).\0A//\0A// Same ABI conventions as its neighbours (see `net_shim.c`'s header for\0A// the general pattern): every function takes and returns only\0A// `long long` (Plum `Int`) or `const char *` (Plum `CStr`), because\0A// Plum's extern surface has no raw pointers, no out-parameters and no\0A// multi-value return.\0A//\0A// --- Why a SLOT TABLE and not a cast pointer ---\0A//\0A// `dir_shim.c` casts its `DIR *` straight to a handle, which is simpler\0A// and is fine there because a directory is closed exactly once, by the\0A// one function that reads it to the end.\0A//\0A// A file cannot do that, because closing one happens TWICE by design.\0A// `File.close` is explicit and returns a `Result`, so a caller who cares\0A// whether the final flush succeeded can see it; and the handle's\0A// `on_drop` closes it again on the way out, so a caller who forgets --\0A// or who returns early -- still cannot leak it. That pairing is Rust's\0A// `File`, and it is the shape issue #16 sketched.\0A//\0A// Rust makes the second close impossible: `close` CONSUMES the value.\0A// Plum has no move semantics, so both really do run, and the second one\0A// must be harmless. A cast pointer cannot be: `fclose` on an\0A// already-closed `FILE *` is undefined, and the fd number underneath may\0A// by then belong to a completely different file. A slot the shim owns\0A// can simply be marked empty, and every later close on it does nothing.\0A//\0A// So the number Plum holds is an INDEX (biased by one so that 0 is never\0A// a live handle), and the real `FILE *` never leaves this file. That is\0A// also what the `handle` design meant by \22the state does not have to fit\0A// in the number\22.\0A//\0A// **Not thread-safe**, matching `dir_shim.c` and `process_shim.c`: the\0A// table is unguarded, so opening and closing files from several threads\0A// at once is not supported. The read BUFFER is thread-local, because\0A// that one is cheap to make safe and `net_shim.c` learned the hard way\0A// what a shared one costs.\0A\0A#include <stdio.h>\0A#include <stdlib.h>\0A#include <string.h>\0A\0A#if defined(_MSC_VER)\0A#define PLUM_TLS __declspec(thread)\0A#else\0A#define PLUM_TLS _Thread_local\0A#endif\0A\0A#define PLUM_MAX_FILES 256\0A\0Astatic FILE *slots[PLUM_MAX_FILES];\0A\0A// A handle is `index + 1`, so a valid one is never 0 and never collides\0A// with the -1 every wrapper here uses for failure.\0Astatic int slot_of(long long h) {\0A    if (h < 1 || h > PLUM_MAX_FILES) return -1;\0A    if (slots[h - 1] == NULL) return -1;\0A    return (int)(h - 1);\0A}\0A\0A// Modes are passed as small integers rather than strings: an extern\0A// taking a `CStr` would mean the caller could hand `fopen` anything at\0A// all, and the set Plum offers is closed. 0 read, 1 write, 2 append.\0A//\0A// All three are BINARY (`b`), which is a no-op on POSIX and load-bearing\0A// on Windows, where a text-mode stream rewrites `\5Cn` on the way through\0A// and would corrupt exactly the payloads `Bytes` exists for.\0Along long file_open(const char *path, long long mode) {\0A    const char *m = mode == 0 ? \22rb\22 : mode == 1 ? \22wb\22 : mode == 2 ? \22ab\22 : NULL;\0A    if (m == NULL) return -1;\0A    for (int i = 0; i < PLUM_MAX_FILES; i++) {\0A        if (slots[i] == NULL) {\0A            FILE *f = fopen(path, m);\0A            if (f == NULL) return -1;\0A            slots[i] = f;\0A            return (long long)i + 1;\0A        }\0A    }\0A    return -1;\0A}\0A\0A// 0 on success, -1 on a real error. Closing an already-closed handle is\0A// SUCCESS, not an error: the guard runs after an explicit close on every\0A// well-written program, and reporting that as a failure would make the\0A// safe pattern the noisy one.\0Along long file_close_checked(long long h) {\0A    int i = slot_of(h);\0A    if (i < 0) return 0;\0A    FILE *f = slots[i];\0A    slots[i] = NULL;\0A    return fclose(f) == 0 ? 0 : -1;\0A}\0A\0A// The `on_drop` hook. A release runs while a value is being freed and\0A// has nowhere to report to, so the result is discarded here -- which is\0A// exactly why `file_close_checked` exists alongside it.\0Avoid file_close(long long h) {\0A    file_close_checked(h);\0A}\0A\0A// --- Reading ---\0A//\0A// Split across two calls for the same reason `tcp_recv_n`/\0A// `tcp_recv_data` are: a `CStr` return cannot carry a length, so a\0A// single-call read would have to NUL-terminate and the caller would have\0A// to `strlen` -- which truncates any file containing a zero byte, i.e.\0A// every file this API exists to read.\0A//\0A// Three outcomes, kept apart:\0A//   > 0   that many bytes are in the buffer\0A//   = 0   end of file\0A//   < 0   a read error\0Astatic PLUM_TLS char *read_buf = NULL;\0Astatic PLUM_TLS size_t read_cap = 0;\0A\0Astatic int read_ensure(size_t need) {\0A    if (read_cap >= need) return 1;\0A    size_t next = read_cap ? read_cap : 4096;\0A    while (next < need) next *= 2;\0A    char *bigger = (char *)realloc(read_buf, next);\0A    if (bigger == NULL) return 0;\0A    read_buf = bigger;\0A    read_cap = next;\0A    return 1;\0A}\0A\0Along long file_read_n(long long h, long long max_len) {\0A    int i = slot_of(h);\0A    if (i < 0) return -1;\0A    // Only a positive request can report zero bytes as end of file.\0A    // Reject invalid sizes before allocating or touching the stream.\0A    if (max_len <= 0) return -1;\0A    if (!read_ensure((size_t)max_len + 1)) return -1;\0A    size_t got = fread(read_buf, 1, (size_t)max_len, slots[i]);\0A    if (got == 0 && ferror(slots[i])) return -1;\0A    read_buf[got] = '\5C0';\0A    return (long long)got;\0A}\0A\0A// The bytes `file_read_n` just read. Valid until the next read on this\0A// thread, and meaningful only with the count that call returned -- the\0A// buffer is not NUL-delimited data, and reading it with `strlen` is the\0A// bug this pair exists to avoid.\0Aconst char *file_read_data(void) {\0A    return read_buf ? read_buf : \22\22;\0A}\0A\0A// Bytes written, or -1. A short write is possible under real POSIX\0A// semantics and is NOT retried here; the Plum wrapper reports the count\0A// and lets the caller decide, matching `tcp_send`'s own scope note.\0Along long file_write(long long h, const char *buf, long long len) {\0A    int i = slot_of(h);\0A    if (i < 0) return -1;\0A    if (len < 0) return -1;\0A    size_t wrote = fwrite(buf, 1, (size_t)len, slots[i]);\0A    return (long long)wrote;\0A}\0A\0A// The new absolute position, or -1. `whence` is 0 start, 1 current,\0A// 2 end -- the same order `SEEK_SET`/`SEEK_CUR`/`SEEK_END` are usually\0A// written in, but passed as Plum's own constants rather than assuming\0A// the C macros have those values on every platform.\0Along long file_seek(long long h, long long offset, long long whence) {\0A    int i = slot_of(h);\0A    if (i < 0) return -1;\0A    int w = whence == 0 ? SEEK_SET : whence == 1 ? SEEK_CUR : whence == 2 ? SEEK_END : -1;\0A    if (w == -1) return -1;\0A    if (fseek(slots[i], (long)offset, w) != 0) return -1;\0A    return (long long)ftell(slots[i]);\0A}\0A\0A// Flushes buffered writes without closing, so a caller can make data\0A// visible to another process and keep the handle.\0Along long file_flush(long long h) {\0A    int i = slot_of(h);\0A    if (i < 0) return -1;\0A    return fflush(slots[i]) == 0 ? 0 : -1;\0A}\0A\00" }
