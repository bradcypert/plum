_context *ssl)\0A{\0A    int ret = MBEDTLS_ERR_ERROR_CORRUPTION_DETECTED;\0A    mbedtls_ssl_key_set traffic_keys;\0A    mbedtls_ssl_transform *transform_application = NULL;\0A\0A    ret = ssl_tls13_key_schedule_stage_application(ssl);\0A    if (ret != 0) {\0A        MBEDTLS_SSL_DEBUG_RET(1,\0A                              \22ssl_tls13_key_schedule_stage_application\22, ret);\0A        goto cleanup;\0A    }\0A\0A    ret = ssl_tls13_generate_application_keys(ssl, &traffic_keys);\0A    if (ret != 0) {\0A        MBEDTLS_SSL_DEBUG_RET(1,\0A                              \22ssl_tls13_generate_application_keys\22, ret);\0A        goto cleanup;\0A    }\0A\0A    transform_application =\0A        mbedtls_calloc(1, sizeof(mbedtls_ssl_transform));\0A    if (transform_application == NULL) {\0A        ret = MBEDTLS_ERR_SSL_ALLOC_FAILED;\0A        goto cleanup;\0A    }\0A\0A    ret = mbedtls_ssl_tls13_populate_transform(\0A        transform_application,\0A        ssl->conf->endpoint,\0A        ssl->handshake->ciphersuite_info->id,\0A        &traffic_keys,\0A        ssl);\0A    if (ret != 0) {\0A        MBEDTLS_SSL_DEBUG_RET(1, \22mbedtls_ssl_tls13_populate_transform\22, ret);\0A        goto cleanup;\0A    }\0A\0A    ssl->transform_application = transform_application;\0A\0Acleanup:\0A\0A    mbedtls_platform_zeroize(&traffic_keys, sizeof(traffic_keys));\0A    if (ret != 0) {\0A        mbedtls_free(transform_application);\0A    }\0A    return ret;\0A}\0A\0A#if defined(MBEDTLS_SSL_TLS1_3_KEY_EXCHANGE_MODE_SOME_PSK_ENABLED)\0Aint mbedtls_ssl_tls13_export_handshake_psk(mbedtls_ssl_context *ssl,\0A                                           unsigned char **psk,\0A                                           size_t *psk_len)\0A{\0A#if defined(MBEDTLS_USE_PSA_CRYPTO)\0A    psa_key_attributes_t key_attributes = PSA_KEY_ATTRIBUTES_INIT;\0A    psa_status_t status = PSA_ERROR_CORRUPTION_DETECTED;\0A\0A    *psk_len = 0;\0A    *psk = NULL;\0A\0A    if (mbedtls_svc_key_id_is_null(ssl->handshake->psk_opaque)) {\0A        return MBEDTLS_ERR_SSL_INTERNAL_ERROR;\0A    }\0A\0A    status = psa_get_key_attributes(ssl->handshake->psk_opaque, &key_attributes);\0A    if (status != PSA_SUCCESS) {\0A        return PSA_TO_MBEDTLS_ERR(status);\0A    }\0A\0A    *psk_len = PSA_BITS_TO_BYTES(psa_get_key_bits(&key_attributes));\0A    *psk = mbedtls_calloc(1, *psk_len);\0A    if (*psk == NULL) {\0A        return MBEDTLS_ERR_SSL_ALLOC_FAILED;\0A    }\0A\0A    status = psa_export_key(ssl->handshake->psk_opaque,\0A                            (uint8_t *) *psk, *psk_len, psk_len);\0A    if (status != PSA_SUCCESS) {\0A        mbedtls_free((void *) *psk);\0A        *psk = NULL;\0A        return PSA_TO_MBEDTLS_ERR(status);\0A    }\0A    return 0;\0A#else\0A    *psk = ssl->handshake->psk;\0A    *psk_len = ssl->handshake->psk_len;\0A    if (*psk == NULL) {\0A        return MBEDTLS_ERR_SSL_INTERNAL_ERROR;\0A    }\0A    return 0;\0A#endif /* !MBEDTLS_USE_PSA_CRYPTO */\0A}\0A#endif /* MBEDTLS_SSL_TLS1_3_KEY_EXCHANGE_MODE_SOME_PSK_ENABLED */\0A\0A#endif /* MBEDTLS_SSL_PROTO_TLS1_3 */\0A\00" }
