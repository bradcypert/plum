                 library only.\0A */\0Avoid mbedtls_debug_print_ret(const mbedtls_ssl_context *ssl, int level,\0A                             const char *file, int line,\0A                             const char *text, int ret);\0A\0A/**\0A * \5Cbrief   Output a buffer of size len bytes to the debug output. This function\0A *          is always used through the MBEDTLS_SSL_DEBUG_BUF() macro,\0A *          which supplies the ssl context, file and line number parameters.\0A *\0A * \5Cparam ssl       SSL context\0A * \5Cparam level     error level of the debug message\0A * \5Cparam file      file the error has occurred in\0A * \5Cparam line      line number the error has occurred in\0A * \5Cparam text      a name or label for the buffer being dumped. Normally the\0A *                  variable or buffer name\0A * \5Cparam buf       the buffer to be outputted\0A * \5Cparam len       length of the buffer\0A *\0A * \5Cattention       This function is intended for INTERNAL usage within the\0A *                  library only.\0A */\0Avoid mbedtls_debug_print_buf(const mbedtls_ssl_context *ssl, int level,\0A                             const char *file, int line, const char *text,\0A                             const unsigned char *buf, size_t len);\0A\0A#if defined(MBEDTLS_BIGNUM_C)\0A/**\0A * \5Cbrief   Print a MPI variable to the debug output. This function is always\0A *          used through the MBEDTLS_SSL_DEBUG_MPI() macro, which supplies the\0A *          ssl context, file and line number parameters.\0A *\0A * \5Cparam ssl       SSL context\0A * \5Cparam level     error level of the debug message\0A * \5Cparam file      file the error has occurred in\0A * \5Cparam line      line number the error has occurred in\0A * \5Cparam text      a name or label for the MPI being output. Normally the\0A *                  variable name\0A * \5Cparam X         the MPI variable\0A *\0A * \5Cattention       This function is intended for INTERNAL usage within the\0A *                  library only.\0A */\0Avoid mbedtls_debug_print_mpi(const mbedtls_ssl_context *ssl, int level,\0A                             const char *file, int line,\0A                             const char *text, const mbedtls_mpi *X);\0A#endif\0A\0A#if defined(MBEDTLS_ECP_LIGHT)\0A/**\0A * \5Cbrief   Print an ECP point to the debug output. This function is always\0A *          used through the MBEDTLS_SSL_DEBUG_ECP() macro, which supplies the\0A *          ssl context, file and line number parameters.\0A *\0A * \5Cparam ssl       SSL context\0A * \5Cparam level     error level of the debug message\0A * \5Cparam file      file the error has occurred in\0A * \5Cparam line      line number the error has occurred in\0A * \5Cparam text      a name or label for the ECP point being output. Normally the\0A *                  variable name\0A * \5Cparam X         the ECP point\0A *\0A * \5Cattention       This function is intended for INTERNAL usage within the\0A *                  library only.\0A */\0Avoid mbedtls_debug_print_ecp(const mbedtls_ssl_context *ssl, int level,\0A                             const char *file, int line,\0A                             const char *text, const mbedtls_ecp_point *X);\0A#endif\0A\0A#if defined(MBEDTLS_X509_CRT_PARSE_C) && !defined(MBEDTLS_X509_REMOVE_INFO)\0A/**\0A * \5Cbrief   Print a X.509 certificate structure to the debug output. This\0A *          function is always used through the MBEDTLS_SSL_DEBUG_CRT() macro,\0A *          which supplies the ssl context, file and line number parameters.\0A *\0A * \5Cparam ssl       SSL context\0A * \5Cparam level     error level of the debug message\0A * \5Cparam file      file the error has occurred in\0A * \5Cparam line      line number the error has occurred in\0A * \5Cparam text      a name or label for the certificate being output\0A * \5Cparam crt       X.509 certificate structure\0A *\0A * \5Cattention       This function is intended for INTERNAL usage within the\0A *                  library