@.str42288 = private global { i64, i64, [41935 x i8] } { i64 -1, i64 41934, [41935 x i8] c"/*\0A *  Elliptic curve J-PAKE\0A *\0A *  Copyright The Mbed TLS Contributors\0A *  SPDX-License-Identifier: Apache-2.0 OR GPL-2.0-or-later\0A */\0A\0A/*\0A * References in the code are to the Thread v1.0 Specification,\0A * available to members of the Thread Group http://threadgroup.org/\0A */\0A\0A#include \22common.h\22\0A\0A#if defined(MBEDTLS_ECJPAKE_C)\0A\0A#include \22mbedtls/ecjpake.h\22\0A#include \22mbedtls/platform_util.h\22\0A#include \22mbedtls/error.h\22\0A\0A#include <string.h>\0A\0A#if !defined(MBEDTLS_ECJPAKE_ALT)\0A\0A/*\0A * Convert a mbedtls_ecjpake_role to identifier string\0A */\0Astatic const char * const ecjpake_id[] = {\0A    \22client\22,\0A    \22server\22\0A};\0A\0A#define ID_MINE     (ecjpake_id[ctx->role])\0A#define ID_PEER     (ecjpake_id[1 - ctx->role])\0A\0A/**\0A * Helper to Compute a hash from md_type\0A */\0Astatic int mbedtls_ecjpake_compute_hash(mbedtls_md_type_t md_type,\0A                                        const unsigned char *input, size_t ilen,\0A                                        unsigned char *output)\0A{\0A    return mbedtls_md(mbedtls_md_info_from_type(md_type),\0A                      input, ilen, output);\0A}\0A\0A/*\0A * Initialize context\0A */\0Avoid mbedtls_ecjpake_init(mbedtls_ecjpake_context *ctx)\0A{\0A    ctx->md_type = MBEDTLS_MD_NONE;\0A    mbedtls_ecp_group_init(&ctx->grp);\0A    ctx->point_format = MBEDTLS_ECP_PF_UNCOMPRESSED;\0A\0A    mbedtls_ecp_point_init(&ctx->Xm1);\0A    mbedtls_ecp_point_init(&ctx->Xm2);\0A    mbedtls_ecp_point_init(&ctx->Xp1);\0A    mbedtls_ecp_point_init(&ctx->Xp2);\0A    mbedtls_ecp_point_init(&ctx->Xp);\0A\0A    mbedtls_mpi_init(&ctx->xm1);\0A    mbedtls_mpi_init(&ctx->xm2);\0A    mbedtls_mpi_init(&ctx->s);\0A}\0A\0A/*\0A * Free context\0A */\0Avoid mbedtls_ecjpake_free(mbedtls_ecjpake_context *ctx)\0A{\0A    if (ctx == NULL) {\0A        return;\0A    }\0A\0A    ctx->md_type = MBEDTLS_MD_NONE;\0A    mbedtls_ecp_group_free(&ctx->grp);\0A\0A    mbedtls_ecp_point_free(&ctx->Xm1);\0A    mbedtls_ecp_point_free(&ctx->Xm2);\0A    mbedtls_ecp_point_free(&ctx->Xp1);\0A    mbedtls_ecp_point_free(&ctx->Xp2);\0A    mbedtls_ecp_point_free(&ctx->Xp);\0A\0A    mbedtls_mpi_free(&ctx->xm1);\0A    mbedtls_mpi_free(&ctx->xm2);\0A    mbedtls_mpi_free(&ctx->s);\0A}\0A\0A/*\0A * Setup context\0A */\0Aint mbedtls_ecjpake_setup(mbedtls_ecjpake_context *ctx,\0A                          mbedtls_ecjpake_role role,\0A                          mbedtls_md_type_t hash,\0A                          mbedtls_ecp_group_id curve,\0A                          const unsigned char *secret,\0A                          size_t len)\0A{\0A    int ret = MBEDTLS_ERR_ERROR_CORRUPTION_DETECTED;\0A\0A    if (role != MBEDTLS_ECJPAKE_CLIENT && role != MBEDTLS_ECJPAKE_SERVER) {\0A        return MBEDTLS_ERR_ECP_BAD_INPUT_DATA;\0A    }\0A\0A    ctx->role = role;\0A\0A    if ((mbedtls_md_info_from_type(hash)) == NULL) {\0A        return MBEDTLS_ERR_MD_FEATURE_UNAVAILABLE;\0A    }\0A\0A    ctx->md_type = hash;\0A\0A    MBEDTLS_MPI_CHK(mbedtls_ecp_group_load(&ctx->grp, curve));\0A\0A    MBEDTLS_MPI_CHK(mbedtls_mpi_read_binary(&ctx->s, secret, len));\0A\0Acleanup:\0A    if (ret != 0) {\0A        mbedtls_ecjpake_free(ctx);\0A    }\0A\0A    return ret;\0A}\0A\0Aint mbedtls_ecjpake_set_point_format(mbedtls_ecjpake_context *ctx,\0A                                     int point_format)\0A{\0A    switch (point_format) {\0A        case MBEDTLS_ECP_PF_UNCOMPRESSED:\0A        case MBEDTLS_ECP_PF_COMPRESSED:\0A            ctx->point_format = point_format;\0A            return 0;\0A        default:\0A            return MBEDTLS_ERR_ECP_BAD_INPUT_DATA;\0A    }\0A}\0A\0A/*\0A * Check if context is ready for use\0A */\0Aint mbedtls_ecjpake_check(const mbedtls_ecjpake_context *ctx)\0A{\0A    if (ctx->md_type == MBEDTLS_MD_NONE ||\0A        ctx->grp.id == MBEDTLS_ECP_DP_NONE ||\0A        ctx->s.p == NULL) {\0A        return MBEDTLS_ERR_ECP_BAD_INPUT_DATA;\0A    }\0A\0A    return 0;\0A}\0A\0A/*\0A * Write a point plus its length to a buffer\0A */\0Astatic int ecjpake_write_len_point(unsigned char **p,\0A                                   const unsigned char *end,\0A                                   const mbedtls_ecp_group *grp,\0A                                   const int pf,\0A                                   const mbedtls_ecp_point *P)\0A{\0A    int ret = MBEDTLS_ERR_ERROR_CORRUPTION_DETECTED;\0A    size_t len;\0A\0A    /* Need at least 4 for length plus 1 for point */\0A    if (end < *p || end - *p < 5) {\0A        return MBEDTLS_ERR_ECP_BUFFER_TOO_SMALL;\0A    }\0A\0A    ret = mbedtls_ecp_point_write_binary(grp, P, pf,\0A                                         &len, *p + 4, (size_t) (end - (*p + 4)));\0A    if (ret != 0) {\0A        return ret;\0A    }\0A\0A    MBEDTLS_PUT_UINT32_BE(len, *p, 0);\0A\0A    *p += 4 + len;\0A\0A    return 0;\0A}\0A\0A/*\0A * Size of the temporary buffer for ecjpake_hash:\0A * 3 EC points plus their length, plus ID and its length (4 + 6 bytes)\0A */\0A#define ECJPAKE_HASH_BUF_LEN    (3 * (4 + MBEDTLS_ECP_MAX_PT_LEN) + 4 + 6)\0A\0A/*\0A * Compute hash for ZKP (7.4.2.2.2.1)\0A */\0Astatic int ecjpake_hash(const mbedtls_md_type_t md_type,\0A                        const mbedtls_ecp_group *grp,\0A                        const int pf,\0A                        const mbedtls_ecp_point *G,\0A                        const mbedtls_ecp_point *V,\0A                        const mbedtls_ecp_point *X,\0A                        const char *id,\0A                        mbedtls_mpi *h)\0A{\0A    int ret = MBEDTLS_ERR_ERROR_CORRUPTION_DETECTED;\0A    unsigned char buf[ECJPAKE_HASH_BUF_LEN];\0A    unsigned char *p = buf;\0A    const unsigned char *end = buf + sizeof(buf);\0A    const size_t id_len = strlen(id);\0A    unsigned char hash[MBEDTLS_MD_MAX_SIZE];\0A\0A    /* Write things to temporary buffer */\0A    MBEDTLS_MPI_CHK(ecjpake_write_len_point(&p, end