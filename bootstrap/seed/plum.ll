@.str39817 = private global { i64, i64, [5553 x i8] } { i64 -1, i64 5552, [5553 x i8] c"/*\0A *  Copyright The Mbed TLS Contributors\0A *  SPDX-License-Identifier: Apache-2.0 OR GPL-2.0-or-later\0A */\0A\0A/**\0A * \5Cfile mps_trace.h\0A *\0A * \5Cbrief Tracing module for MPS\0A */\0A\0A#ifndef MBEDTLS_MPS_MBEDTLS_MPS_TRACE_H\0A#define MBEDTLS_MPS_MBEDTLS_MPS_TRACE_H\0A\0A#include \22common.h\22\0A#include \22mps_common.h\22\0A#include \22mps_trace.h\22\0A\0A#include \22mbedtls/platform.h\22\0A\0A#if defined(MBEDTLS_MPS_ENABLE_TRACE)\0A\0A/*\0A * Adapt this to enable/disable tracing output\0A * from the various layers of the MPS.\0A */\0A\0A#define MBEDTLS_MPS_TRACE_ENABLE_LAYER_1\0A#define MBEDTLS_MPS_TRACE_ENABLE_LAYER_2\0A#define MBEDTLS_MPS_TRACE_ENABLE_LAYER_3\0A#define MBEDTLS_MPS_TRACE_ENABLE_LAYER_4\0A#define MBEDTLS_MPS_TRACE_ENABLE_READER\0A#define MBEDTLS_MPS_TRACE_ENABLE_WRITER\0A\0A/*\0A * To use the existing trace module, only change\0A * MBEDTLS_MPS_TRACE_ENABLE_XXX above, but don't modify the\0A * rest of this file.\0A */\0A\0Atypedef enum {\0A    MBEDTLS_MPS_TRACE_TYPE_COMMENT,\0A    MBEDTLS_MPS_TRACE_TYPE_CALL,\0A    MBEDTLS_MPS_TRACE_TYPE_ERROR,\0A    MBEDTLS_MPS_TRACE_TYPE_RETURN\0A} mbedtls_mps_trace_type;\0A\0A#define MBEDTLS_MPS_TRACE_BIT_LAYER_1 1\0A#define MBEDTLS_MPS_TRACE_BIT_LAYER_2 2\0A#define MBEDTLS_MPS_TRACE_BIT_LAYER_3 3\0A#define MBEDTLS_MPS_TRACE_BIT_LAYER_4 4\0A#define MBEDTLS_MPS_TRACE_BIT_WRITER  5\0A#define MBEDTLS_MPS_TRACE_BIT_READER  6\0A\0A#if defined(MBEDTLS_MPS_TRACE_ENABLE_LAYER_1)\0A#define MBEDTLS_MPS_TRACE_MASK_LAYER_1 (1u << MBEDTLS_MPS_TRACE_BIT_LAYER_1)\0A#else\0A#define MBEDTLS_MPS_TRACE_MASK_LAYER_1 0\0A#endif\0A\0A#if defined(MBEDTLS_MPS_TRACE_ENABLE_LAYER_2)\0A#define MBEDTLS_MPS_TRACE_MASK_LAYER_2 (1u << MBEDTLS_MPS_TRACE_BIT_LAYER_2)\0A#else\0A#define MBEDTLS_MPS_TRACE_MASK_LAYER_2 0\0A#endif\0A\0A#if defined(MBEDTLS_MPS_TRACE_ENABLE_LAYER_3)\0A#define MBEDTLS_MPS_TRACE_MASK_LAYER_3 (1u << MBEDTLS_MPS_TRACE_BIT_LAYER_3)\0A#else\0A#define MBEDTLS_MPS_TRACE_MASK_LAYER_3 0\0A#endif\0A\0A#if defined(MBEDTLS_MPS_TRACE_ENABLE_LAYER_4)\0A#define MBEDTLS_MPS_TRACE_MASK_LAYER_4 (1u << MBEDTLS_MPS_TRACE_BIT_LAYER_4)\0A#else\0A#define MBEDTLS_MPS_TRACE_MASK_LAYER_4 0\0A#endif\0A\0A#if defined(MBEDTLS_MPS_TRACE_ENABLE_READER)\0A#define MBEDTLS_MPS_TRACE_MASK_READER (1u << MBEDTLS_MPS_TRACE_BIT_READER)\0A#else\0A#define MBEDTLS_MPS_TRACE_MASK_READER 0\0A#endif\0A\0A#if defined(MBEDTLS_MPS_TRACE_ENABLE_WRITER)\0A#define MBEDTLS_MPS_TRACE_MASK_WRITER (1u << MBEDTLS_MPS_TRACE_BIT_WRITER)\0A#else\0A#define MBEDTLS_MPS_TRACE_MASK_WRITER 0\0A#endif\0A\0A#define MBEDTLS_MPS_TRACE_MASK (MBEDTLS_MPS_TRACE_MASK_LAYER_1 |       \5C\0A                                MBEDTLS_MPS_TRACE_MASK_LAYER_2 |       \5C\0A                                MBEDTLS_MPS_TRACE_MASK_LAYER_3 |       \5C\0A                                MBEDTLS_MPS_TRACE_MASK_LAYER_4 |       \5C\0A                                MBEDTLS_MPS_TRACE_MASK_READER  |       \5C\0A                                MBEDTLS_MPS_TRACE_MASK_WRITER)\0A\0A/* We have to avoid globals because E-ACSL chokes on them...\0A * Wrap everything in stub functions. */\0Aint  mbedtls_mps_trace_get_depth(void);\0Avoid mbedtls_mps_trace_inc_depth(void);\0Avoid mbedtls_mps_trace_dec_depth(void);\0A\0Avoid mbedtls_mps_trace_color(int id);\0Avoid mbedtls_mps_trace_indent(int level, mbedtls_mps_trace_type ty);\0A\0Avoid mbedtls_mps_trace_print_msg(int id, int line, const char *format, ...);\0A\0A#define MBEDTLS_MPS_TRACE(type, ...)                                              \5C\0A    do {                                                                            \5C\0A        if (!(MBEDTLS_MPS_TRACE_MASK & (1u << mbedtls_mps_trace_id)))         \5C\0A        break;                                                                  \5C\0A        mbedtls_mps_trace_indent(mbedtls_mps_trace_get_depth(), type);            \5C\0A        mbedtls_mps_trace_color(mbedtls_mps_trace_id);                            \5C\0A        mbedtls_mps_trace_print_msg(mbedtls_mps_trace_id, __LINE__, __VA_ARGS__); \5C\0A        mbedtls_mps_trace_color(0);                                               \5C\0A    } while (0)\0A\0A#define MBEDTLS_MPS_TRACE_INIT(...)                                         \5C\0A    do {                                                                      \5C\0A        if (!(MBEDTLS_MPS_TRACE_MASK & (1u << mbedtls_mps_trace_id)))   \5C\0A        break;                                                            \5C\0A        MBEDTLS_MPS_TRACE(MBEDTLS_MPS_TRACE_TYPE_CALL, __VA_ARGS__);        \5C\0A        mbedtls_mps_trace_inc_depth();                                        \5C\0A    } while (0)\0A\0A#define MBEDTLS_MPS_TRACE_END(val)                                        \5C\0A    do {                                                                    \5C\0A        if (!(MBEDTLS_MPS_TRACE_MASK & (1u << mbedtls_mps_trace_id))) \5C\0A        break;                                                          \5C\0A        MBEDTLS_MPS_TRACE(MBEDTLS_MPS_TRACE_TYPE_RETURN, \22%d (-%#04x)\22,    \5C\0A                          (int) (val), -((unsigned) (val)));                           \5C\0A        mbedtls_mps_trace_dec_depth();                                      \5C\0A    } while (0)\0A\0A#define MBEDTLS_MPS_TRACE_RETURN(val)         \5C\0A    do {                                        \5C\0A        /* Breaks tail recursion. */            \5C\0A        int ret__ = val;                        \5C\0A        MBEDTLS_MPS_TRACE_END(ret__);         \5C\0A        return ret__;                        \5C\0A    } while (0)\0A\0A#else /* MBEDTLS_MPS_TRACE */\0A\0A#define MBEDTLS_MPS_TRACE(type, ...) do { } while (0)\0A#define MBEDTLS_MPS_TRACE_INIT(...)  do { } while (0)\0A#define MBEDTLS_MPS_TRACE_END          do { } while (0)\0A\0A#define MBEDTLS_MPS_TRACE_RETURN(val) return val;\0A\0A#endif /* MBEDTLS_MPS_TRACE */\0A\0A#endif /* MBEDTLS_MPS_MBEDTLS_MPS_TRACE_H */\0A\00" }
