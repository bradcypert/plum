@.str45407 = private global { i64, i64, [27309 x i8] } { i64 -1, i64 27308, [27309 x i8] c"/**\0A * \5Cfile asn1.h\0A *\0A * \5Cbrief Generic ASN.1 parsing\0A */\0A/*\0A *  Copyright The Mbed TLS Contributors\0A *  SPDX-License-Identifier: Apache-2.0 OR GPL-2.0-or-later\0A */\0A#ifndef MBEDTLS_ASN1_H\0A#define MBEDTLS_ASN1_H\0A#include \22mbedtls/private_access.h\22\0A\0A#include \22mbedtls/build_info.h\22\0A#include \22mbedtls/platform_util.h\22\0A\0A#include <stddef.h>\0A\0A#if defined(MBEDTLS_BIGNUM_C)\0A#include \22mbedtls/bignum.h\22\0A#endif\0A\0A/**\0A * \5Caddtogroup asn1_module\0A * \5C{\0A */\0A\0A/**\0A * \5Cname ASN1 Error codes\0A * These error codes are combined with other error codes for\0A * higher error granularity.\0A * e.g. X.509 and PKCS #7 error codes\0A * ASN1 is a standard to specify data structures.\0A * \5C{\0A */\0A/** Out of data when parsing an ASN1 data structure. */\0A#define MBEDTLS_ERR_ASN1_OUT_OF_DATA                      -0x0060\0A/** ASN1 tag was of an unexpected value. */\0A#define MBEDTLS_ERR_ASN1_UNEXPECTED_TAG                   -0x0062\0A/** Error when trying to determine the length or invalid length. */\0A#define MBEDTLS_ERR_ASN1_INVALID_LENGTH                   -0x0064\0A/** Actual length differs from expected length. */\0A#define MBEDTLS_ERR_ASN1_LENGTH_MISMATCH                  -0x0066\0A/** Data is invalid. */\0A#define MBEDTLS_ERR_ASN1_INVALID_DATA                     -0x0068\0A/** Memory allocation failed */\0A#define MBEDTLS_ERR_ASN1_ALLOC_FAILED                     -0x006A\0A/** Buffer too small when writing ASN.1 data structure. */\0A#define MBEDTLS_ERR_ASN1_BUF_TOO_SMALL                    -0x006C\0A\0A/** \5C} name ASN1 Error codes */\0A\0A/**\0A * \5Cname DER constants\0A * These constants comply with the DER encoded ASN.1 type tags.\0A * DER encoding uses hexadecimal representation.\0A * An example DER sequence is:\5Cn\0A * - 0x02 -- tag indicating INTEGER\0A * - 0x01 -- length in octets\0A * - 0x05 -- value\0A * Such sequences are typically read into \5Cc ::mbedtls_x509_buf.\0A * \5C{\0A */\0A#define MBEDTLS_ASN1_BOOLEAN                 0x01\0A#define MBEDTLS_ASN1_INTEGER                 0x02\0A#define MBEDTLS_ASN1_BIT_STRING              0x03\0A#define MBEDTLS_ASN1_OCTET_STRING            0x04\0A#define MBEDTLS_ASN1_NULL                    0x05\0A#define MBEDTLS_ASN1_OID                     0x06\0A#define MBEDTLS_ASN1_ENUMERATED              0x0A\0A#define MBEDTLS_ASN1_UTF8_STRING             0x0C\0A#define MBEDTLS_ASN1_SEQUENCE                0x10\0A#define MBEDTLS_ASN1_SET                     0x11\0A#define MBEDTLS_ASN1_PRINTABLE_STRING        0x13\0A#define MBEDTLS_ASN1_T61_STRING              0x14\0A#define MBEDTLS_ASN1_IA5_STRING              0x16\0A#define MBEDTLS_ASN1_UTC_TIME                0x17\0A#define MBEDTLS_ASN1_GENERALIZED_TIME        0x18\0A#define MBEDTLS_ASN1_UNIVERSAL_STRING        0x1C\0A#define MBEDTLS_ASN1_BMP_STRING              0x1E\0A#define MBEDTLS_ASN1_PRIMITIVE               0x00\0A#define MBEDTLS_ASN1_CONSTRUCTED             0x20\0A#define MBEDTLS_ASN1_CONTEXT_SPECIFIC        0x80\0A\0A/* Slightly smaller way to check if tag is a string tag\0A * compared to canonical implementation. */\0A#define MBEDTLS_ASN1_IS_STRING_TAG(tag)                                \5C\0A    ((unsigned int) (tag) < 32u && (                                   \5C\0A         ((1u << (tag)) & ((1u << MBEDTLS_ASN1_BMP_STRING)       |     \5C\0A                           (1u << MBEDTLS_ASN1_UTF8_STRING)      |     \5C\0A                           (1u << MBEDTLS_ASN1_T61_STRING)       |     \5C\0A                           (1u << MBEDTLS_ASN1_IA5_STRING)       |     \5C\0A                           (1u << MBEDTLS_ASN1_UNIVERSAL_STRING) |     \5C\0A                           (1u << MBEDTLS_ASN1_PRINTABLE_STRING))) != 0))\0A\0A/*\0A * Bit masks for each of the components of an ASN.1 tag as specified in\0A * ITU X.690 (08/2015), section 8.1 \22General rules for encoding\22,\0A * paragraph 8.1.2.2:\0A *\0A * Bit  8     7   6   5          1\0A *     +-------+-----+------------+\0A *     | Class | P/C | Tag number |\0A *     +-------+-----+------------+\0A */\0A#define MBEDTLS_ASN1_TAG_CLASS_MASK          0xC0\0A#define MBEDTLS_ASN1_TAG_PC_MASK             0x20\0A#define MBEDTLS_ASN1_TAG_VALUE_MASK          0x1F\0A\0A/** \5C} name DER constants */\0A\0A/** Returns the size of the binary string, without the trailing \5C\5C0 */\0A#define MBEDTLS_OID_SIZE(x) (sizeof(x) - 1)\0A\0A/**\0A * Compares an mbedtls_asn1_buf structure to a reference OID.\0A *\0A * Only works for 'defined' oid_str values (MBEDTLS_OID_HMAC_SHA1), you cannot use a\0A * 'unsigned char *oid' here!\0A */\0A#define MBEDTLS_OID_CMP(oid_str, oid_buf)                                   \5C\0A    ((MBEDTLS_OID_SIZE(oid_str) != (oid_buf)->len) ||                \5C\0A     memcmp((oid_str), (oid_buf)->p, (oid_buf)->len) != 0)\0A\0A#define MBEDTLS_OID_CMP_RAW(oid_str, oid_buf, oid_buf_len)              \5C\0A    ((MBEDTLS_OID_SIZE(oid_str) != (oid_buf_len)) ||             \5C\0A     memcmp((oid_str), (oid_buf), (oid_buf_len)) != 0)\0A\0A#ifdef __cplusplus\0Aextern \22C\22 {\0A#endif\0A\0A/**\0A * \5Cname Functions to parse ASN.1 data structures\0A * \5C{\0A */\0A\0A/**\0A * Type-length-value structure that allows for ASN1 using DER.\0A */\0Atypedef struct mbedtls_asn1_buf {\0A    int tag;                /**< ASN1 type, e.g. MBEDTLS_ASN1_UTF8_STRING. */\0A    size_t len;             /**< ASN1 length, in octets. */\0A    unsigned char *p;       /**< ASN1 data, e.g. in ASCII. */\0A}\0Ambedtls_asn1_buf;\0A\0A/**\0A * Container for ASN1 bit strings.\0A */\0Atypedef struct mbedtls_asn1_bitstring {\0A    size_t len;                 /**< ASN1 length, in octets. */\0A    unsigned char unused_bits;  /**< Number of unused bits at the end of the string */\0A    unsigned char *p;           /**< Raw ASN1 data for the bit string */\0A}\0Ambedtls_asn1_bitstring;\0A\0A/**\0A * Container for a sequence of ASN.1 items\0A */\0Atypedef struct mbedtls_asn1_sequence {\0A    mbedtls_asn1_buf buf;                   /**< Buffer containing the given ASN.1 item. */\0A\0A    /** The next entry in the sequence.\0A     *\0A     * The details of memory management for sequences are not documented and\0A     * may change in future versions. Set this field to \5Cp NULL when\0A     * initializing a structure, and do not modify it except via Mbed TLS\0A     * library functions.\0A     */\0A    struct mbedtls_asn1_sequence *next;\0A}\0Ambedtls_asn1_sequence;\0A\0A/**\0A * Container for a sequence or list of 'named' ASN.1 data items\0A */\0Atypedef struct mbedtls_asn1_named_data {\0A    mbedtls_asn1_buf oid;                   /**< The object identifier. */\0A    mbedtls_asn1_buf val;                   /**< The named value. */\0A\0A    /** The next entry in the sequence.\0A     *\0A     * The details of memory management for named data sequences are not\0A     * documented and may change in future versions. Set this field to \5Cp NULL\0A     * when initializing a structure, and do not modify it except via Mbed TLS\0A     * library functions.\0A     */\0A    struct mbedtls_asn1_named_data *next;\0A\0A    /** Merge next item into the current one?\0A     *\0A     * This field exists for the sake of Mbed TLS's X.509 certificate parsing\0A     * code and may change in future versions of the library.\0A     */\0A    unsigned char MBEDTLS_PRIVATE(next_merged);\0A}\0Ambedtls_asn1_named_data;\0A\0A#if defined(MBEDTLS_ASN1_PARSE_C) || defined(MBEDTLS_X509_CREATE_C) || \5C\0A    defined(MBEDTLS_PSA_UTIL_HAVE_ECDSA)\0A/**\0A * \5Cbrief       Get the length of an ASN.1 element.\0A *              Updates the pointer to immediately behind the length.\0A *\0A * \5Cparam p     On entry, \5Cc *p points to the first byte of the length,\0A *              i.e. immediately after the tag.\0A *              On successful completion, \5Cc *p points to the first byte\0A *              after the length, i.e. the first byte of the content.\0A *              On error, the value of \5Cc *p is undefined.\0A * \5Cparam end   End of data.\0A * \5Cparam len   On successful completion, \5Cc *len contains the length\0A *              read from the ASN.1 input.\0A *\0A * \5Creturn      0 if successful.\0A * \5Creturn      #MBEDTLS_ERR_ASN1_OUT_OF_DATA if the ASN.1 element\0A *              would end beyond \5Cp end.\0A * \5Creturn      #MBEDTLS_ERR_ASN1_INVALID_LENGTH if the length is unparsable.\0A */\0Aint mbedtls_asn1_get_len(unsigned char **p,\0A                         const unsigned char *end,\0A                         size_t *len);\0A\0A/**\0A * \5Cbrief       Get the tag and length of the element.\0A *              Check for the requested tag.\0A *              Updates the pointer to immediately behind the tag and length.\0A *\0A * \5Cparam p     On entry, \5Cc *p points to the start of the ASN.1 element.\0A *              On successful completion, \5Cc *p points to the first byte\0A *              after the length, i.e. the first byte of the content.\0A *              On error, the value of \5Cc *p is undefined.\0A * \5Cparam end   End of data.\0A * \5Cparam len   On successful completion, \5Cc *len contains the length\0A *              read from the ASN.1 input.\0A * \5Cparam tag   The expected tag.\0A *\0A * \5Creturn      0 if successful.\0A * \5Creturn      #MBEDTLS_ERR_ASN1_UNEXPECTED_TAG if the data does not start\0A *              with the requested tag.\0A * \5Creturn      #MBEDTLS_ERR_ASN1_OUT_OF_DATA if the ASN.1 element\0A *              would end beyond \5Cp end.\0A * \5Creturn      #MBEDTLS_ERR_ASN1_INVALID_LENGTH if the length is unparsable.\0A */\0Aint mbedtls_asn1_get_tag(unsigned char **p,\0A                         const unsigned char *end,\0A                         size_t *len, int tag);\0A#endif /* MBEDTLS_ASN1_PARSE_C || MBEDTLS_X509_CREATE_C || MBEDTLS_PSA_UTIL_HAVE_ECDSA */\0A\0A#if defined(MBEDTLS_ASN1_PARSE_C)\0A/**\0A * \5Cbrief       Retrieve a boolean ASN.1 tag and its value.\0A *              Updates the pointer to immediately behind the full tag.\0A *\0A * \5Cparam p     On entry, \5Cc *p points to the start of the ASN.1 element.\0A *              On successful completion, \5Cc *p points to the first byte\0A *              beyond the ASN.1 element.\0A *              On error, the value of \5Cc *p is undefined.\0A * \5Cparam end   End of data.\0A * \5Cparam val   On success, the parsed value (\5Cc 0 or \5Cc 1).\0A *\0A * \5Creturn      0 if successful.\0A * \5Creturn      An ASN.1 error code if the input does not start with\0A *              a valid ASN.1 BOOLEAN.\0A */\0Aint mbedtls_asn1_get_bool(unsigned char **p,\0A                          const unsigned char *end,\0A                          int *val);\0A\0A/**\0A * \5Cbrief       Retrieve an integer ASN.1 tag and its value.\0A *              Updates the pointer to immediately behind the full tag.\0A *\0A * \5Cparam p     On entry, \5Cc *p points to the start of the ASN.1 element.\0A *              On successful completion, \5Cc *p points to the first byte\0A *              beyond the ASN.1 element.\0A *              On error, the value of \5Cc *p is undefined.\0A * \5Cparam end   End of data.\0A * \5Cparam val   On success, the parsed value.\0A *\0A * \5Creturn      0 if successful.\0A * \5Creturn      An ASN.1 error code if the input does not start with\0A *              a valid ASN.1 INTEGER.\0A * \5Creturn      #MBEDTLS_ERR_ASN1_INVALID_LENGTH if the parsed value does\0A *              not fit in an \5Cc int.\0A */\0Aint mbedtls_asn1_get_int(unsigned char **p,\0A                         const unsigned char *end,\0A                         int *val);\0A\0A/**\0A * \5Cbrief       Retrieve an enumerated ASN.1 tag and its value.\0A *              Updates the pointer to immediately behind the full tag.\0A *\0A * \5Cparam p     On entry, \5Cc *p points to the start of the ASN.1 element.\0A *              On successful completion, \5Cc *p points to the first byte\0A *              beyond the ASN.1 element.\0A *              On error, the value of \5Cc *p is undefined.\0A * \5Cparam end   End of data.\0A * \5Cparam val   On success, the parsed value.\0A *\0A * \5Creturn      0 if successful.\0A * \5Creturn      An ASN.1 error code if the input does not start with\0A *              a valid ASN.1 ENUMERATED.\0A * \5Creturn      #MBEDTLS_ERR_ASN1_INVALID_LENGTH if the parsed value does\0A *              not fit in an \5Cc int.\0A */\0Aint mbedtls_asn1_get_enum(unsigned char **p,\0A                          const unsigned char *end,\0A                          int *val);\0A\0A/**\0A * \5Cbrief       Retrieve a bitstring ASN.1 tag and its value.\0A *              Updates the pointer to immediately behind the full tag.\0A *\0A * \5Cparam p     On entry, \5Cc *p points to the start of the ASN.1 element.\0A *              On successful completion, \5Cc *p is equal to \5Cp end.\0A *              On error, the value of \5Cc *p is undefined.\0A * \5Cparam end   End of data.\0A * \5Cparam bs    On success, ::mbedtls_asn1_bitstring information about\0A *              the parsed value.\0A *\0A * \5Creturn      0 if successful.\0A * \5Creturn      #MBEDTLS_ERR_ASN1_LENGTH_MISMATCH if the input contains\0A *              extra data after a valid BIT STRING.\0A * \5Creturn      An ASN.1 error code if the input does not start with\0A *              a valid ASN.1 BIT STRING.\0A */\0Aint mbedtls_asn1_get_bitstring(unsigned char **p, const unsigned char *end,\0A                               mbedtls_asn1_bitstring *bs);\0A\0A/**\0A * \5Cbrief       Retrieve a bitstring ASN.1 tag without unused bits and its\0A *              value.\0A *              Updates the pointer to the beginning of the bit/octet string.\0A *\0A * \5Cparam p     On entry, \5Cc *p points to the start of the ASN.1 element.\0A *              On successful completion, \5Cc *p points to the first byte\0A *              of the content of the BIT STRING.\0A *              On error, the value of \5Cc *p is undefined.\0A * \5Cparam end   End of data.\0A * \5Cparam len   On success, \5Cc *len is the length of the content in bytes.\0A *\0A * \5Creturn      0 if successful.\0A * \5Creturn      #MBEDTLS_ERR_ASN1_INVALID_DATA if the input starts with\0A *              a valid BIT STRING with a nonzero number of unused bits.\0A * \5Creturn      An ASN.1 error code if the input does not start with\0A *              a valid ASN.1 BIT STRING.\0A */\0Aint mbedtls_asn1_get_bitstring_null(unsigned char **p,\0A                                    const unsigned char *end,\0A                                    size_t *len);\0A\0A/**\0A * \5Cbrief       Parses and splits an ASN.1 \22SEQUENCE OF <tag>\22.\0A *              Updates the pointer to immediately behind the full sequence tag.\0A *\0A * This function allocates memory for the sequence elements. You can free\0A * the allocated memory with mbedtls_asn1_sequence_free().\0A *\0A * \5Cnote        On error, this function may return a partial list in \5Cp cur.\0A *              You must set `cur->next = NULL` before calling this function!\0A *              Otherwise it is impossible to distinguish a previously non-null\0A *              pointer from a pointer to an object allocated by this function.\0A *\0A * \5Cnote        If the sequence is empty, this function does not modify\0A *              \5Cc *cur. If the sequence is valid and non-empty, this\0A *              function sets `cur->buf.tag` to \5Cp tag. This allows\0A *              callers to distinguish between an empty sequence and\0A *              a one-element sequence.\0A *\0A * \5Cparam p     On entry, \5Cc *p points to the start of the ASN.1 element.\0A *              On successful completion, \5Cc *p is equal to \5Cp end.\0A *              On error, the value of \5Cc *p is undefined.\0A * \5Cparam end   End of data.\0A * \5Cparam cur   A ::mbedtls_asn1_sequence which this function fills.\0A *              When this function returns, \5Cc *cur is the head of a linked\0A *              list. Each node in this list is allocated with\0A *              mbedtls_calloc() apart from \5Cp cur itself, and should\0A *              therefore be freed with mbedtls_free().\0A *              The list describes the content of the sequence.\0A *              The head of the list (i.e. \5Cc *cur itself) describes the\0A *              first element, `*cur->next` describes the second element, etc.\0A *              For each element, `buf.tag == tag`, `buf.len` is the length\0A *              of the content of the content of the element, and `buf.p`\0A *              points to the first byte of the content (i.e. immediately\0A *              past the length of the element).\0A *              Note that list elements may be allocated even on error.\0A * \5Cparam tag   Each element of the sequence must have this tag.\0A *\0A * \5Creturn      0 if successful.\0A * \5Creturn      #MBEDTLS_ERR_ASN1_LENGTH_MISMATCH if the input contains\0A *              extra data after a valid SEQUENCE OF \5Cp tag.\0A * \5Creturn      #MBEDTLS_ERR_ASN1_UNEXPECTED_TAG if the input starts with\0A *              an ASN.1 SEQUENCE in which an element has a tag that\0A *              is different from \5Cp tag.\0A * \5Creturn      #MBEDTLS_ERR_ASN1_ALLOC_FAILED if a memory allocation failed.\0A * \5Creturn      An ASN.1 error code if the input does not start with\0A *              a valid ASN.1 SEQUENCE.\0A */\0Aint mbedtls_asn1_get_sequence_of(unsigned char **p,\0A                                 const unsigned char *end,\0A                                 mbedtls_asn1_sequence *cur,\0A                                 int tag);\0A/**\0A * \5Cbrief          Free a heap-allocated linked list presentation of\0A *                 an ASN.1 sequence, including the first element.\0A *\0A * There are two common ways to manage the memory used for the representation\0A * of a parsed ASN.1 sequence:\0A * - Allocate a head node `mbedtls_asn1_sequence *head` with mbedtls_calloc().\0A *   Pass this node as the `cur` argument to mbedtls_asn1_get_sequence_of().\0A *   When you have finished processing the sequence,\0A *   call mbedtls_asn1_sequence_free() on `head`.\0A * - Allocate a head node `mbedtls_asn1_sequence *head` in any manner,\0A *   for example on the stack. Make sure that `head->next == NULL`.\0A *   Pass `head` as the `cur` argument to mbedtls_asn1_get_sequence_of().\0A *   When you have finished processing the sequence,\0A *   call mbedtls_asn1_sequence_free() on `head->cur`,\0A *   then free `head` itself in the appropriate manner.\0A *\0A * \5Cparam seq      The address of the first sequence component. This may\0A *                 be \5Cc NULL, in which case this functions returns\0A *                 immediately.\0A */\0Avoid mbedtls_asn1_sequence_free(mbedtls_asn1_sequence *seq);\0A\0A/**\0A * \5Cbrief                Traverse an ASN.1 SEQUENCE container and\0A *                       call a callback for each entry.\0A *\0A * This function checks that the input is a SEQUENCE of elements that\0A * each have a \22must\22 tag, and calls a callback function on the elements\0A * that have a \22may\22 tag.\0A *\0A * For example, to validate that the input is a SEQUENCE of `tag1` and call\0A * `cb` on each element, use\0A * ```\0A * mbedtls_asn1_traverse_sequence_of(&p, end, 0xff, tag1, 0, 0, cb, ctx);\0A * ```\0A *\0A * To validate that the input is a SEQUENCE of ANY and call `cb` on\0A * each element, use\0A * ```\0A * mbedtls_asn1_traverse_sequence_of(&p, end, 0, 0, 0, 0, cb, ctx);\0A * ```\0A *\0A * To validate that the input is a SEQUENCE of CHOICE {NULL, OCTET STRING}\0A * and call `cb` on each element that is an OCTET STRING, use\0A * ```\0A * mbedtls_asn1_traverse_sequence_of(&p, end, 0xfe, 0x04, 0xff, 0x04, cb, ctx);\0A * ```\0A *\0A * The callback is called on the elements with a \22may\22 tag from left to\0A * right. If the input is not a valid SEQUENCE of elements with a \22must\22 tag,\0A * the callback is called on the elements up to the leftmost point where\0A * the input is invalid.\0A *\0A * \5Cwarning              This function is still experimental and may change\0A *                       at any time.\0A *\0A * \5Cparam p              The address of the pointer to the beginning of\0A *                       the ASN.1 SEQUENCE header. This is updated to\0A *                       point to the end of the ASN.1 SEQUENCE container\0A *                       on a successful invocation.\0A * \5Cparam end            The end of the ASN.1 SEQUENCE container.\0A * \5Cparam tag_must_mask  A mask to be applied to the ASN.1 tags found within\0A *                       the SEQUENCE before comparing to \5Cp tag_must_val.\0A * \5Cparam tag_must_val   The required value of each ASN.1 tag found in the\0A *                       SEQUENCE, after masking with \5Cp tag_must_mask.\0A *                       Mismatching tags lead to an error.\0A *                       For example, a value of \5Cc 0 for both \5Cp tag_must_mask\0A *                       and \5Cp tag_must_val means that every tag is allowed,\0A *                       while a value of \5Cc 0xFF for \5Cp tag_must_mask means\0A *                       that \5Cp tag_must_val is the only allowed tag.\0A * \5Cparam tag_may_mask   A mask to be applied to the ASN.1 tags found within\0A *                       the SEQUENCE before comparing to \5Cp tag_may_val.\0A * \5Cparam tag_may_val    The desired value of each ASN.1 tag found in the\0A *                       SEQUENCE, after masking with \5Cp tag_may_mask.\0A *                       Mismatching tags will be silently ignored.\0A *                       For example, a value of \5Cc 0 for \5Cp tag_may_mask and\0A *                       \5Cp tag_may_val means that any tag will be considered,\0A *                       while a value of \5Cc 0xFF for \5Cp tag_may_mask means\0A *                       that all tags with value different from \5Cp tag_may_val\0A *                       will be ignored.\0A * \5Cparam cb             The callback to trigger for each component\0A *                       in the ASN.1 SEQUENCE that matches \5Cp tag_may_val.\0A *                       The callback function is called with the following\0A *                       parameters:\0A *                       - \5Cp ctx.\0A *                       - The tag of the current element.\0A *                       - A pointer to the start of the current element's\0A *                         content inside the input.\0A *                       - The length of the content of the current element.\0A *                       If the callback returns a non-zero value,\0A *                       the function stops immediately,\0A *                       forwarding the callback's return value.\0A * \5Cparam ctx            The context to be passed to the callback \5Cp cb.\0A *\0A * \5Creturn               \5Cc 0 if successful the entire ASN.1 SEQUENCE\0A *                       was traversed without parsing or callback errors.\0A * \5Creturn               #MBEDTLS_ERR_ASN1_LENGTH_MISMATCH if the input\0A *                       contains extra data after a valid SEQUENCE\0A *                       of elements with an accepted tag.\0A * \5Creturn               #MBEDTLS_ERR_ASN1_UNEXPECTED_TAG if the input starts\0A *                       with an ASN.1 SEQUENCE in which an element has a tag\0A *                       that is not accepted.\0A * \5Creturn               An ASN.1 error code if the input does not start with\0A *                       a valid ASN.1 SEQUENCE.\0A * \5Creturn               A non-zero error code forwarded from the callback\0A *                       \5Cp cb in case the latter returns a non-zero value.\0A */\0Aint mbedtls_asn1_traverse_sequence_of(\0A    unsigned char **p,\0A    const unsigned char *end,\0A    unsigned char tag_must_mask, unsigned char tag_must_val,\0A    unsigned char tag_may_mask, unsigned char tag_may_val,\0A    int (*cb)(void *ctx, int tag,\0A              unsigned char *start, size_t len),\0A    void *ctx);\0A\0A#if defined(MBEDTLS_BIGNUM_C)\0A/**\0A * \5Cbrief       Retrieve an integer ASN.1 tag and its value.\0A *              Updates the pointer to immediately behind the full tag.\0A *\0A * \5Cparam p     On entry, \5Cc *p points to the start of the ASN.1 element.\0A *              On successful completion, \5Cc *p points to the first byte\0A *              beyond the ASN.1 element.\0A *              On error, the value of \5Cc *p is undefined.\0A * \5Cparam end   End of data.\0A * \5Cparam X     On success, the parsed value.\0A *\0A * \5Creturn      0 if successful.\0A * \5Creturn      An ASN.1 error code if the input does not start with\0A *              a valid ASN.1 INTEGER.\0A * \5Creturn      #MBEDTLS_ERR_ASN1_INVALID_LENGTH if the parsed value does\0A *              not fit in an \5Cc int.\0A * \5Creturn      An MPI error code if the parsed value is too large.\0A */\0Aint mbedtls_asn1_get_mpi(unsigned char **p,\0A                         const unsigned char *end,\0A                         mbedtls_mpi *X);\0A#endif /* MBEDTLS_BIGNUM_C */\0A\0A/**\0A * \5Cbrief       Retrieve an AlgorithmIdentifier ASN.1 sequence.\0A *              Updates the pointer to immediately behind the full\0A *              AlgorithmIdentifier.\0A *\0A * \5Cparam p     On entry, \5Cc *p points to the start of the ASN.1 element.\0A *              On successful completion, \5Cc *p points to the first byte\0A *              beyond the AlgorithmIdentifier element.\0A *              On error, the value of \5Cc *p is undefined.\0A * \5Cparam end   End of data.\0A * \5Cparam alg   The buffer to receive the OID.\0A * \5Cparam params The buffer to receive the parameters.\0A *              This is zeroized if there are no parameters.\0A *\0A * \5Creturn      0 if successful or a specific ASN.1 or MPI error code.\0A */\0Aint mbedtls_asn1_get_alg(unsigned char **p,\0A                         const unsigned char *end,\0A                         mbedtls_asn1_buf *alg, mbedtls_asn1_buf *params);\0A\0A/**\0A * \5Cbrief       Retrieve an AlgorithmIdentifier ASN.1 sequence with NULL or no\0A *              params.\0A *              Updates the pointer to immediately behind the full\0A *              AlgorithmIdentifier.\0A *\0A * \5Cparam p     On entry, \5Cc *p points to the start of the ASN.1 element.\0A *              On successful completion, \5Cc *p points to the first byte\0A *              beyond the AlgorithmIdentifier element.\0A *              On error, the value of \5Cc *p is undefined.\0A * \5Cparam end   End of data.\0A * \5Cparam alg   The buffer to receive the OID.\0A *\0A * \5Creturn      0 if successful or a specific ASN.1 or MPI error code.\0A */\0Aint mbedtls_asn1_get_alg_null(unsigned char **p,\0A                              const unsigned char *end,\0A                              mbedtls_asn1_buf *alg);\0A\0A/**\0A * \5Cbrief       Find a specific named_data entry in a sequence or list based on\0A *              the OID.\0A *\0A * \5Cparam list  The list to seek through\0A * \5Cparam oid   The OID to look for\0A * \5Cparam len   Size of the OID\0A *\0A * \5Creturn      NULL if not found, or a pointer to the existing entry.\0A */\0Aconst mbedtls_asn1_named_data *mbedtls_asn1_find_named_data(const mbedtls_asn1_named_data *list,\0A                                                            const char *oid, size_t len);\0A\0A#if !defined(MBEDTLS_DEPRECATED_REMOVED)\0A/**\0A * \5Cbrief       Free a mbedtls_asn1_named_data entry\0A *\0A * \5Cdeprecated  This function is deprecated and will be removed in a\0A *              future version of the library.\0A *              Please use mbedtls_asn1_free_named_data_list()\0A *              or mbedtls_asn1_free_named_data_list_shallow().\0A *\0A * \5Cparam entry The named data entry to free.\0A *              This function calls mbedtls_free() on\0A *              `entry->oid.p` and `entry->val.p`.\0A */\0Avoid MBEDTLS_DEPRECATED mbedtls_asn1_free_named_data(mbedtls_asn1_named_data *entry);\0A#endif /* MBEDTLS_DEPRECATED_REMOVED */\0A\0A/**\0A * \5Cbrief       Free all entries in a mbedtls_asn1_named_data list.\0A *\0A * \5Cparam head  Pointer to the head of the list of named data entries to free.\0A *              This function calls mbedtls_free() on\0A *              `entry->oid.p` and `entry->val.p` and then on `entry`\0A *              for each list entry, and sets \5Cc *head to \5Cc NULL.\0A */\0Avoid mbedtls_asn1_free_named_data_list(mbedtls_asn1_named_data **head);\0A\0A/**\0A * \5Cbrief       Free all shallow entries in a mbedtls_asn1_named_data list,\0A *              but do not free internal pointer targets.\0A *\0A * \5Cparam name  Head of the list of named data entries to free.\0A *              This function calls mbedtls_free() on each list element.\0A */\0Avoid mbedtls_asn1_free_named_data_list_shallow(mbedtls_asn1_named_data *name);\0A\0A/** \5C} name Functions to parse ASN.1 data structures */\0A/** \5C} addtogroup asn1_module */\0A\0A#endif /* MBEDTLS_ASN1_PARSE_C */\0A\0A#ifdef __cplusplus\0A}\0A#endif\0A\0A#endif /* asn1.h */\0A\00" }
