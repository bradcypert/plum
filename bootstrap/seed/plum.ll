  %o2 = or i1 %o1, %r3
  %o3 = or i1 %o2, %r4
  %o4 = or i1 %o3, %r5
  %o5 = or i1 %o4, %r6
  %o6 = or i1 %o5, %r7
  %o7 = or i1 %o6, %r8
  %o8 = or i1 %o7, %r9
