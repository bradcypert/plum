@.str39748 = private global { i64, i64, [2696 x i8] } { i64 -1, i64 2695, [2696 x i8] c"/**\0A * \5Cfile timing.h\0A *\0A * \5Cbrief Portable interface to timeouts and to the CPU cycle counter\0A */\0A/*\0A *  Copyright The Mbed TLS Contributors\0A *  SPDX-License-Identifier: Apache-2.0 OR GPL-2.0-or-later\0A */\0A#ifndef MBEDTLS_TIMING_H\0A#define MBEDTLS_TIMING_H\0A#include \22mbedtls/private_access.h\22\0A\0A#include \22mbedtls/build_info.h\22\0A\0A#include <stdint.h>\0A\0A#ifdef __cplusplus\0Aextern \22C\22 {\0A#endif\0A\0A#if !defined(MBEDTLS_TIMING_ALT)\0A// Regular implementation\0A//\0A\0A/**\0A * \5Cbrief          timer structure\0A */\0Astruct mbedtls_timing_hr_time {\0A    uint64_t MBEDTLS_PRIVATE(opaque)[4];\0A};\0A\0A/**\0A * \5Cbrief          Context for mbedtls_timing_set/get_delay()\0A */\0Atypedef struct mbedtls_timing_delay_context {\0A    struct mbedtls_timing_hr_time   MBEDTLS_PRIVATE(timer);\0A    uint32_t                        MBEDTLS_PRIVATE(int_ms);\0A    uint32_t                        MBEDTLS_PRIVATE(fin_ms);\0A} mbedtls_timing_delay_context;\0A\0A#else  /* MBEDTLS_TIMING_ALT */\0A#include \22timing_alt.h\22\0A#endif /* MBEDTLS_TIMING_ALT */\0A\0A/* Internal use */\0Aunsigned long mbedtls_timing_get_timer(struct mbedtls_timing_hr_time *val, int reset);\0A\0A/**\0A * \5Cbrief          Set a pair of delays to watch\0A *                 (See \5Cc mbedtls_timing_get_delay().)\0A *\0A * \5Cparam data     Pointer to timing data.\0A *                 Must point to a valid \5Cc mbedtls_timing_delay_context struct.\0A * \5Cparam int_ms   First (intermediate) delay in milliseconds.\0A *                 The effect if int_ms > fin_ms is unspecified.\0A * \5Cparam fin_ms   Second (final) delay in milliseconds.\0A *                 Pass 0 to cancel the current delay.\0A *\0A * \5Cnote           To set a single delay, either use \5Cc mbedtls_timing_set_timer\0A *                 directly or use this function with int_ms == fin_ms.\0A */\0Avoid mbedtls_timing_set_delay(void *data, uint32_t int_ms, uint32_t fin_ms);\0A\0A/**\0A * \5Cbrief          Get the status of delays\0A *                 (Memory helper: number of delays passed.)\0A *\0A * \5Cparam data     Pointer to timing data\0A *                 Must point to a valid \5Cc mbedtls_timing_delay_context struct.\0A *\0A * \5Creturn         -1 if cancelled (fin_ms = 0),\0A *                  0 if none of the delays are passed,\0A *                  1 if only the intermediate delay is passed,\0A *                  2 if the final delay is passed.\0A */\0Aint mbedtls_timing_get_delay(void *data);\0A\0A/**\0A * \5Cbrief          Get the final timing delay\0A *\0A * \5Cparam data     Pointer to timing data\0A *                 Must point to a valid \5Cc mbedtls_timing_delay_context struct.\0A *\0A * \5Creturn         Final timing delay in milliseconds.\0A */\0Auint32_t mbedtls_timing_get_final_delay(\0A    const mbedtls_timing_delay_context *data);\0A\0A#ifdef __cplusplus\0A}\0A#endif\0A\0A#endif /* timing.h */\0A\00" }
