turn MBEDTLS_ERR_PLATFORM_HW_ACCEL_FAILED;\0A        }\0A\0A        status = psa_cipher_finish(&cipher_op,\0A                                   output + *olen, ilen - *olen,\0A                                   &part_len);\0A        if (status != PSA_SUCCESS) {\0A            return MBEDTLS_ERR_PLATFORM_HW_ACCEL_FAILED;\0A        }\0A\0A        *olen += part_len;\0A        return 0;\0A    }\0A#endif /* MBEDTLS_USE_PSA_CRYPTO && !MBEDTLS_DEPRECATED_REMOVED */\0A\0A    if ((ret = mbedtls_cipher_set_iv(ctx, iv, iv_len)) != 0) {\0A        return ret;\0A    }\0A\0A    if ((ret = mbedtls_cipher_reset(ctx)) != 0) {\0A        return ret;\0A    }\0A\0A    if ((ret = mbedtls_cipher_update(ctx, input, ilen,\0A                                     output, olen)) != 0) {\0A        return ret;\0A    }\0A\0A    if ((ret = mbedtls_cipher_finish(ctx, output + *olen,\0A                                     &finish_olen)) != 0) {\0A        return ret;\0A    }\0A\0A    *olen += finish_olen;\0A\0A    return 0;\0A}\0A\0A#if defined(MBEDTLS_CIPHER_MODE_AEAD)\0A/*\0A * Packet-oriented encryption for AEAD modes: internal function used by\0A * mbedtls_cipher_auth_encrypt_ext().\0A */\0Astatic int mbedtls_cipher_aead_encrypt(mbedtls_cipher_context_t *ctx,\0A                                       const unsigned char *iv, size_t iv_len,\0A                                       const unsigned char *ad, size_t ad_len,\0A                                       const unsigned char *input, size_t ilen,\0A                                       unsigned char *output, size_t *olen,\0A                                       unsigned char *tag, size_t tag_len)\0A{\0A#if defined(MBEDTLS_USE_PSA_CRYPTO) && !defined(MBEDTLS_DEPRECATED_REMOVED)\0A    if (ctx->psa_enabled == 1) {\0A        /* As in the non-PSA case, we don't check that\0A         * a key has been set. If not, the key slot will\0A         * still be in its default state of 0, which is\0A         * guaranteed to be invalid, hence the PSA-call\0A    