@.str45112 = private global { i64, i64, [3714 x i8] } { i64 -1, i64 3713, [3714 x i8] c"/**\0A * \5Cfile psa_crypto_invasive.h\0A *\0A * \5Cbrief PSA cryptography module: invasive interfaces for test only.\0A *\0A * The interfaces in this file are intended for testing purposes only.\0A * They MUST NOT be made available to clients over IPC in integrations\0A * with isolation, and they SHOULD NOT be made available in library\0A * integrations except when building the library for testing.\0A */\0A/*\0A *  Copyright The Mbed TLS Contributors\0A *  SPDX-License-Identifier: Apache-2.0 OR GPL-2.0-or-later\0A */\0A\0A#ifndef PSA_CRYPTO_INVASIVE_H\0A#define PSA_CRYPTO_INVASIVE_H\0A\0A/*\0A * Include the build-time configuration information header. Here, we do not\0A * include `\22mbedtls/build_info.h\22` directly but `\22psa/build_info.h\22`, which\0A * is basically just an alias to it. This is to ease the maintenance of the\0A * TF-PSA-Crypto repository which has a different build system and\0A * configuration.\0A */\0A#include \22psa/build_info.h\22\0A\0A#include \22psa/crypto.h\22\0A#include \22common.h\22\0A\0A#include \22mbedtls/entropy.h\22\0A\0A#if !defined(MBEDTLS_PSA_CRYPTO_EXTERNAL_RNG)\0A/** \5Cbrief Configure entropy sources.\0A *\0A * This function may only be called before a call to psa_crypto_init(),\0A * or after a call to mbedtls_psa_crypto_free() and before any\0A * subsequent call to psa_crypto_init().\0A *\0A * This function is only intended for test purposes. The functionality\0A * it provides is also useful for system integrators, but\0A * system integrators should configure entropy drivers instead of\0A * breaking through to the Mbed TLS API.\0A *\0A * \5Cparam entropy_init  Function to initialize the entropy context\0A *                      and set up the desired entropy sources.\0A *                      It is called by psa_crypto_init().\0A *                      By default this is mbedtls_entropy_init().\0A *                      This function cannot report failures directly.\0A *                      To indicate a failure, set the entropy context\0A *                      to a state where mbedtls_entropy_func() will\0A *                      return an error.\0A * \5Cparam entropy_free  Function to free the entropy context\0A *                      and associated resources.\0A *                      It is called by mbedtls_psa_crypto_free().\0A *                      By default this is mbedtls_entropy_free().\0A *\0A * \5Cretval #PSA_SUCCESS\0A *         Success.\0A * \5Cretval #PSA_ERROR_NOT_PERMITTED\0A *         The caller does not have the permission to configure\0A *         entropy sources.\0A * \5Cretval #PSA_ERROR_BAD_STATE\0A *         The library has already been initialized.\0A */\0Apsa_status_t mbedtls_psa_crypto_configure_entropy_sources(\0A    void (* entropy_init)(mbedtls_entropy_context *ctx),\0A    void (* entropy_free)(mbedtls_entropy_context *ctx));\0A#endif /* !defined(MBEDTLS_PSA_CRYPTO_EXTERNAL_RNG) */\0A\0A#if defined(MBEDTLS_TEST_HOOKS) && defined(MBEDTLS_PSA_CRYPTO_C)\0Apsa_status_t psa_mac_key_can_do(\0A    psa_algorithm_t algorithm,\0A    psa_key_type_t key_type);\0A\0Apsa_status_t psa_crypto_copy_input(const uint8_t *input, size_t input_len,\0A                                   uint8_t *input_copy, size_t input_copy_len);\0A\0Apsa_status_t psa_crypto_copy_output(const uint8_t *output_copy, size_t output_copy_len,\0A                                    uint8_t *output, size_t output_len);\0A\0A/*\0A * Test hooks to use for memory unpoisoning/poisoning in copy functions.\0A */\0Aextern void (*psa_input_pre_copy_hook)(const uint8_t *input, size_t input_len);\0Aextern void (*psa_input_post_copy_hook)(const uint8_t *input, size_t input_len);\0Aextern void (*psa_output_pre_copy_hook)(const uint8_t *output, size_t output_len);\0Aextern void (*psa_output_post_copy_hook)(const uint8_t *output, size_t output_len);\0A\0A#endif /* MBEDTLS_TEST_HOOKS && MBEDTLS_PSA_CRYPTO_C */\0A\0A#endif /* PSA_CRYPTO_INVASIVE_H */\0A\00" }
