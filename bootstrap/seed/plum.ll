                               unsigned char tag[16])\0A{\0A    int ret = MBEDTLS_ERR_ERROR_CORRUPTION_DETECTED;\0A\0A    ret = mbedtls_chachapoly_starts(ctx, nonce, mode);\0A    if (ret != 0) {\0A        goto cleanup;\0A    }\0A\0A    ret = mbedtls_chachapoly_update_aad(ctx, aad, aad_len);\0A    if (ret != 0) {\0A        goto cleanup;\0A    }\0A\0A    ret = mbedtls_chachapoly_update(ctx, length, input, output);\0A    if (ret != 0) {\0A        goto cleanup;\0A    }\0A\0A    ret = mbedtls_chachapoly_finish(ctx, tag);\0A\0Acleanup:\0A    return ret;\0A}\0A\0Aint mbedtls_chachapoly_encrypt_and_tag(mbedtls_chachapoly_context *ctx,\0A                                       size_t length,\0A                                       const unsigned char nonce[12],\0A                                       const unsigned char *aad,\0A                                       size_t aad_len,\0A                                       const unsigned char *input,\0A                                       unsigned char *output,\0A                                       unsigned char tag[16])\0A{\0A    return chachapoly_crypt_and_tag(ctx, MBEDTLS_CHACHAPOLY_ENCRYPT,\0A                                    length, nonce, aad, aad_len,\0A                                    input, output, tag);\0A}\0A\0Aint mbedtls_chachapoly_auth_decrypt(mbedtls_chachapoly_context *ctx,\0A                                    size_t length,\0A                                    const unsigned char nonce[12],\0A                                    const unsigned char *aad,\0A                                    size_t aad_len,\0A                                    const unsigned char tag[16],\0A                                    const unsigned char *input,\0A                                    unsigned char *output)\0A{\0A    int ret = MBEDTLS_ERR_ERROR_CORRUPTION_DETECTED;\0A    unsigned char check_tag[16];\0A    int diff;\0A\0A    if ((ret = chachapoly_crypt_and_tag(ctx,\0A                                        M