string(mbedtls_asn1_buf *oid,\0A                                    const char *oid_str, size_t size)\0A{\0A    int ret = MBEDTLS_ERR_ASN1_INVALID_DATA;\0A    const char *str_ptr = oid_str;\0A    const char *str_bound = oid_str + size;\0A    unsigned int val = 0;\0A    unsigned int component1, component2;\0A    size_t encoded_len;\0A    unsigned char *resized_mem;\0A\0A    /* Count the number of dots to get a worst-case allocation size. */\0A    size_t num_dots = 0;\0A    for (size_t i = 0; i < size; i++) {\0A        if (oid_str[i] == '.') {\0A            num_dots++;\0A        }\0A    }\0A    /* Allocate maximum possible required memory:\0A     * There are (num_dots + 1) integer components, but the first 2 share the\0A     * same subidentifier, so we only need num_dots subidentifiers maximum. */\0A    if (num_dots == 0 || (num_dots > MBEDTLS_OID_MAX_COMPONENTS - 1)) {\0A        return MBEDTLS_ERR_ASN1_INVALID_DATA;\0A    }\0A    /* Each byte can store 7 bits, calculate number of bytes for a\0A     * subidentifier:\0A     *\0A     * bytes = ceil(subidentifer_size * 8 / 7)\0A     */\0A    size_t bytes_per_subidentifier = (((sizeof(unsigned int) * 8) - 1) / 7)\0A                                     + 1;\0A    size_t max_possible_bytes = num_dots * bytes_per_subidentifier;\0A    oid->p = mbedtls_calloc(max_possible_bytes, 1);\0A    if (oid->p == NULL) {\0A        return MBEDTLS_ERR_ASN1_ALLOC_FAILED;\0A    }\0A    unsigned char *out_ptr = oid->p;\0A    unsigned char *out_bound = oid->p + max_possible_bytes;\0A\0A    ret = oid_parse_number(&component1, &str_ptr, str_bound);\0A    if (ret != 0) {\0A        goto error;\0A    }\0A    if (component1 > 2) {\0A        /* First component can't be > 2 */\0A        ret = MBEDTLS_ERR_ASN1_INVALID_DATA;\0A        goto error;\0A    }\0A    if (str_ptr >= str_bound || *str_ptr != '.') {\0A        ret = MBEDTLS_ERR_ASN1_INVALID_DATA;\0A        goto error;\0A    }\0A    str_ptr++;\0A\0A    ret = oid_parse_number(&component2, &str_ptr, str_bound);\0A    if (ret != 0) {\0A        goto error;\0A    }\0A    if ((component1 < 2) && (component2 > 39)) {\0A        /* Root nodes 0 and 1 may have up to 40 children, numbered 0-39 */\0A        ret = MBEDTLS_ERR_ASN1_INVALID_DATA;\0A        goto error;\0A    }\0A    if (str_ptr < str_bound) {\0A        if (*str_ptr == '.') {\0A            str_ptr++;\0A        } else {\0A            ret = MBEDTLS_ERR_ASN1_INVALID_DATA;\0A            goto error;\0A        }\0A    }\0A\0A    if (component2 > (UINT_MAX - (component1 * 40))) {\0A        ret = MBEDTLS_ERR_ASN1_INVALID_DATA;\0A        goto error;\0A    }\0A    ret = oid_subidentifier_encode_into(&out_ptr, out_bound,\0A                                        (component1 * 40) + component2);\0A    if (ret != 0) {\0A        goto error;\0A    }\0A\0A    while (str_ptr < str_bound) {\0A        ret = oid_parse_number(&val, &str_ptr, str_bound);\0A        if (ret != 0) {\0A            goto error;\0A        }\0A        if (str_ptr < str_bound) {\0A            if (*str_ptr == '.') {\0A                str_ptr++;\0A            } else {\0A                ret = MBEDTLS_ERR_ASN1_INVALID_DATA;\0A                goto error;\0A            }\0A        }\0A\0A        ret = oid_subidentifier_encode_into(&out_ptr, out_bound, val);\0A        if (ret != 0) {\0A            goto error;\0A        }\0A    }\0A\0A    encoded_len = (size_t) (out_ptr - oid->p);\0A    resized_mem = mbedtls_calloc(encoded_len, 1);\0A    if (resized_mem == NULL) {\0A        ret = MBEDTLS_ERR_ASN1_ALLOC_FAILED;\0A        goto error;\0A    }\0A    memcpy(resized_mem, oid->p, encoded_len);\0A    mbedtls_free(oid->p);\0A    oid->p = resized_mem;\0A    oid->len = encoded_len;\0A\0A    oid->tag = MBEDTLS_ASN1_OID;\0A\0A    return 0;\0A\0Aerror:\0A    mbedtls_free(oid->p);\0A    oid->p = NULL;\0A    oid->len = 0;\0A    return ret;\0A}\0A\0A#endif /* MBEDTLS_OID_C */\0A\00" }
