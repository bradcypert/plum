ATA;\0A    }\0A\0A    if (ctx->pk_info->encrypt_func == NULL) {\0A        return MBEDTLS_ERR_PK_TYPE_MISMATCH;\0A    }\0A\0A    return ctx->pk_info->encrypt_func(ctx, input, ilen,\0A                                      output, olen, osize, f_rng, p_rng);\0A}\0A\0A/*\0A * Check public-private key pair\0A */\0Aint mbedtls_pk_check_pair(const mbedtls_pk_context *pub,\0A                          const mbedtls_pk_context *prv,\0A                          int (*f_rng)(void *, unsigned char *, size_t),\0A                          void *p_rng)\0A{\0A    if (pub->pk_info == NULL ||\0A        prv->pk_info == NULL) {\0A        return MBEDTLS_ERR_PK_BAD_INPUT_DATA;\0A    }\0A\0A    if (f_rng == NULL) {\0A        return MBEDTLS_ERR_PK_BAD_INPUT_DATA;\0A    }\0A\0A    if (prv->pk_info->check_pair_func == NULL) {\0A        return MBEDTLS_ERR_PK_FEATURE_UNAVAILABLE;\0A    }\0A\0A    if (prv->pk_info->type == MBEDTLS_PK_RSA_ALT) {\0A        if (pub->pk_info->type != MBEDTLS_PK_RSA) {\0A            return MBEDTLS_ERR_PK_TYPE_MISMATCH;\0A        }\0A    } else {\0A        if ((prv->pk_info->type != MBEDTLS_PK_OPAQUE) &&\0A            (pub->pk_info != prv->pk_info)) {\0A            return MBEDTLS_ERR_PK_TYPE_MISMATCH;\0A        }\0A    }\0A\0A    return prv->pk_info->check_pair_func((mbedtls_pk_context *) pub,\0A                                         (mbedtls_pk_context *) prv,\0A                                         f_rng, p_rng);\0A}\0A\0A/*\0A * Get key size in bits\0A */\0Asize_t mbedtls_pk_get_bitlen(const mbedtls_pk_context *ctx)\0A{\0A    /* For backward compatibility, accept NULL or a context that\0A     * isn't set up yet, and return a fake value that should be safe. */\0A    if (ctx == NULL || ctx->pk_info == NULL) {\0A        return 0;\0A    }\0A\0A    return ctx->pk_info->get_bitlen((mbedtls_pk_context *) ctx);\0A}\0A\0A/*\0A * Export debug information\0A */\0Aint mbedtls_pk_debug(const mbedtls_pk_context *ctx, mbedtls_pk_debug_item *items)\0A{\0A    if (ctx->pk_info == NULL) {\0A        return MBEDTLS_ERR_PK_BAD_INPUT_DATA;\0A    }\0A\0A    if (ctx->pk_info->debug_func == NULL) {\0A        return MBEDTLS_ERR_PK_TYPE_MISMATCH;\0A    }\0A\0A    ctx->pk_info->debug_func((mbedtls_pk_context *) ctx, items);\0A    return 0;\0A}\0A\0A/*\0A * Access the PK type name\0A */\0Aconst char *mbedtls_pk_get_name(const mbedtls_pk_context *ctx)\0A{\0A    if (ctx == NULL || ctx->pk_info == NULL) {\0A        return \22invalid PK\22;\0A    }\0A\0A    return ctx->pk_info->name;\0A}\0A\0A/*\0A * Access the PK type\0A */\0Ambedtls_pk_type_t mbedtls_pk_get_type(const mbedtls_pk_context *ctx)\0A{\0A    if (ctx == NULL || ctx->pk_info == NULL) {\0A        return MBEDTLS_PK_NONE;\0A    }\0A\0A    return ctx->pk_info->type;\0A}\0A\0A#endif /* MBEDTLS_PK_C */\0A\00" }
