@.str45306 = private global { i64, i64, [4864 x i8] } { i64 -1, i64 4863, [4864 x i8] c"/*\0A *  Context structure declaration of the Mbed TLS software-based PSA drivers\0A *  called through the PSA Crypto driver dispatch layer.\0A *  This file contains the context structures of key derivation algorithms\0A *  which need to rely on other algorithms.\0A *\0A * \5Cnote This file may not be included directly. Applications must\0A * include psa/crypto.h.\0A *\0A * \5Cnote This header and its content are not part of the Mbed TLS API and\0A * applications must not depend on it. Its main purpose is to define the\0A * multi-part state objects of the Mbed TLS software-based PSA drivers. The\0A * definitions of these objects are then used by crypto_struct.h to define the\0A * implementation-defined types of PSA multi-part state objects.\0A */\0A/*\0A *  Copyright The Mbed TLS Contributors\0A *  SPDX-License-Identifier: Apache-2.0 OR GPL-2.0-or-later\0A */\0A\0A#ifndef PSA_CRYPTO_BUILTIN_KEY_DERIVATION_H\0A#define PSA_CRYPTO_BUILTIN_KEY_DERIVATION_H\0A#include \22mbedtls/private_access.h\22\0A\0A#include <psa/crypto_driver_common.h>\0A\0A#if defined(MBEDTLS_PSA_BUILTIN_ALG_HKDF) || \5C\0A    defined(MBEDTLS_PSA_BUILTIN_ALG_HKDF_EXTRACT) || \5C\0A    defined(MBEDTLS_PSA_BUILTIN_ALG_HKDF_EXPAND)\0Atypedef struct {\0A    uint8_t *MBEDTLS_PRIVATE(info);\0A    size_t MBEDTLS_PRIVATE(info_length);\0A#if PSA_HASH_MAX_SIZE > 0xff\0A#error \22PSA_HASH_MAX_SIZE does not fit in uint8_t\22\0A#endif\0A    uint8_t MBEDTLS_PRIVATE(offset_in_block);\0A    uint8_t MBEDTLS_PRIVATE(block_number);\0A    unsigned int MBEDTLS_PRIVATE(state) : 2;\0A    unsigned int MBEDTLS_PRIVATE(info_set) : 1;\0A    uint8_t MBEDTLS_PRIVATE(output_block)[PSA_HASH_MAX_SIZE];\0A    uint8_t MBEDTLS_PRIVATE(prk)[PSA_HASH_MAX_SIZE];\0A    struct psa_mac_operation_s MBEDTLS_PRIVATE(hmac);\0A} psa_hkdf_key_derivation_t;\0A#endif /* MBEDTLS_PSA_BUILTIN_ALG_HKDF ||\0A          MBEDTLS_PSA_BUILTIN_ALG_HKDF_EXTRACT ||\0A          MBEDTLS_PSA_BUILTIN_ALG_HKDF_EXPAND */\0A#if defined(MBEDTLS_PSA_BUILTIN_ALG_TLS12_ECJPAKE_TO_PMS)\0Atypedef struct {\0A    uint8_t MBEDTLS_PRIVATE(data)[PSA_TLS12_ECJPAKE_TO_PMS_DATA_SIZE];\0A} psa_tls12_ecjpake_to_pms_t;\0A#endif /* MBEDTLS_PSA_BUILTIN_ALG_TLS12_ECJPAKE_TO_PMS */\0A\0A#if defined(MBEDTLS_PSA_BUILTIN_ALG_TLS12_PRF) || \5C\0A    defined(MBEDTLS_PSA_BUILTIN_ALG_TLS12_PSK_TO_MS)\0Atypedef enum {\0A    PSA_TLS12_PRF_STATE_INIT,             /* no input provided */\0A    PSA_TLS12_PRF_STATE_SEED_SET,         /* seed has been set */\0A    PSA_TLS12_PRF_STATE_OTHER_KEY_SET,    /* other key has been set - optional */\0A    PSA_TLS12_PRF_STATE_KEY_SET,          /* key has been set */\0A    PSA_TLS12_PRF_STATE_LABEL_SET,        /* label has been set */\0A    PSA_TLS12_PRF_STATE_OUTPUT            /* output has been started */\0A} psa_tls12_prf_key_derivation_state_t;\0A\0Atypedef struct psa_tls12_prf_key_derivation_s {\0A#if PSA_HASH_MAX_SIZE > 0xff\0A#error \22PSA_HASH_MAX_SIZE does not fit in uint8_t\22\0A#endif\0A\0A    /* Indicates how many bytes in the current HMAC block have\0A     * not yet been read by the user. */\0A    uint8_t MBEDTLS_PRIVATE(left_in_block);\0A\0A    /* The 1-based number of the block. */\0A    uint8_t MBEDTLS_PRIVATE(block_number);\0A\0A    psa_tls12_prf_key_derivation_state_t MBEDTLS_PRIVATE(state);\0A\0A    uint8_t *MBEDTLS_PRIVATE(secret);\0A    size_t MBEDTLS_PRIVATE(secret_length);\0A    uint8_t *MBEDTLS_PRIVATE(seed);\0A    size_t MBEDTLS_PRIVATE(seed_length);\0A    uint8_t *MBEDTLS_PRIVATE(label);\0A    size_t MBEDTLS_PRIVATE(label_length);\0A#if defined(MBEDTLS_PSA_BUILTIN_ALG_TLS12_PSK_TO_MS)\0A    uint8_t *MBEDTLS_PRIVATE(other_secret);\0A    size_t MBEDTLS_PRIVATE(other_secret_length);\0A#endif /* MBEDTLS_PSA_BUILTIN_ALG_TLS12_PSK_TO_MS */\0A\0A    uint8_t MBEDTLS_PRIVATE(Ai)[PSA_HASH_MAX_SIZE];\0A\0A    /* `HMAC_hash( prk, A( i ) + seed )` in the notation of RFC 5246, Sect. 5. */\0A    uint8_t MBEDTLS_PRIVATE(output_block)[PSA_HASH_MAX_SIZE];\0A} psa_tls12_prf_key_derivation_t;\0A#endif /* MBEDTLS_PSA_BUILTIN_ALG_TLS12_PRF) ||\0A        * MBEDTLS_PSA_BUILTIN_ALG_TLS12_PSK_TO_MS */\0A#if defined(PSA_HAVE_SOFT_PBKDF2)\0Atypedef enum {\0A    PSA_PBKDF2_STATE_INIT,             /* no input provided */\0A    PSA_PBKDF2_STATE_INPUT_COST_SET,   /* input cost has been set */\0A    PSA_PBKDF2_STATE_SALT_SET,         /* salt has been set */\0A    PSA_PBKDF2_STATE_PASSWORD_SET,     /* password has been set */\0A    PSA_PBKDF2_STATE_OUTPUT            /* output has been started */\0A} psa_pbkdf2_key_derivation_state_t;\0A\0Atypedef struct {\0A    psa_pbkdf2_key_derivation_state_t MBEDTLS_PRIVATE(state);\0A    uint64_t MBEDTLS_PRIVATE(input_cost);\0A    uint8_t *MBEDTLS_PRIVATE(salt);\0A    size_t MBEDTLS_PRIVATE(salt_length);\0A    uint8_t MBEDTLS_PRIVATE(password)[PSA_HMAC_MAX_HASH_BLOCK_SIZE];\0A    size_t MBEDTLS_PRIVATE(password_length);\0A    uint8_t MBEDTLS_PRIVATE(output_block)[PSA_HASH_MAX_SIZE];\0A    uint8_t MBEDTLS_PRIVATE(bytes_used);\0A    uint32_t MBEDTLS_PRIVATE(block_number);\0A} psa_pbkdf2_key_derivation_t;\0A#endif /* PSA_HAVE_SOFT_PBKDF2 */\0A\0A#endif /* PSA_CRYPTO_BUILTIN_KEY_DERIVATION_H */\0A\00" }
