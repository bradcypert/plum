=====================================\0A * Everything below here is trivial wrapper functions\0A */\0A\0Astatic inline size_t mbedtls_ct_size_if(mbedtls_ct_condition_t condition,\0A                                        size_t if1,\0A                                        size_t if0)\0A{\0A    return (size_t) mbedtls_ct_if(condition, (mbedtls_ct_uint_t) if1, (mbedtls_ct_uint_t) if0);\0A}\0A\0Astatic inline unsigned mbedtls_ct_uint_if(mbedtls_ct_condition_t condition,\0A                                          unsigned if1,\0A                                          unsigned if0)\0A{\0A    return (unsigned) mbedtls_ct_if(condition, (mbedtls_ct_uint_t) if1, (mbedtls_ct_uint_t) if0);\0A}\0A\0Astatic inline mbedtls_ct_condition_t mbedtls_ct_bool_if(mbedtls_ct_condition_t condition,\0A                                                        mbedtls_ct_condition_t if1,\0A                                                        mbedtls_ct_condition_t if0)\0A{\0A    return (mbedtls_ct_condition_t) mbedtls_ct_if(condition, (mbedtls_ct_uint_t) if1,\0A                                                  (mbedtls_ct_uint_t) if0);\0A}\0A\0A#if defined(MBEDTLS_BIGNUM_C)\0A\0Astatic inline mbedtls_mpi_uint mbedtls_ct_mpi_uint_if(mbedtls_ct_condition_t condition,\0A                                                      mbedtls_mpi_uint if1,\0A                                                      mbedtls_mpi_uint if0)\0A{\0A    return (mbedtls_mpi_uint) mbedtls_ct_if(condition,\0A                                            (mbedtls_ct_uint_t) if1,\0A                                            (mbedtls_ct_uint_t) if0);\0A}\0A\0A#endif\0A\0Astatic inline size_t mbedtls_ct_size_if_else_0(mbedtls_ct_condition_t condition, size_t if1)\0A{\0A    return (size_t) (condition & if1);\0A}\0A\0Astatic inline unsigned mbedtls_ct_uint_if_else_0(mbedtls_ct_condition_t condition, unsigned if1)\0A{\0A    return (unsigned) (condition & if1);\0A}\0A\0Astatic inline mbedtls_ct_condition_t mbedtls_ct_bool