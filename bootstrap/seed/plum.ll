et_size(md_info);\0A\0A    /*\0A     * Set initial working state.\0A     * Use the V memory location, which is currently all 0, to initialize the\0A     * MD context with an all-zero key. Then set V to its initial value.\0A     */\0A    if ((ret = mbedtls_md_hmac_starts(&ctx->md_ctx, ctx->V, md_size)) != 0) {\0A        return ret;\0A    }\0A    memset(ctx->V, 0x01, md_size);\0A\0A    ctx->f_entropy = f_entropy;\0A    ctx->p_entropy = p_entropy;\0A\0A    if (ctx->entropy_len == 0) {\0A        /*\0A         * See SP800-57 5.6.1 (p. 65-66) for the security strength provided by\0A         * each hash function, then according to SP800-90A rev1 10.1 table 2,\0A         * min_entropy_len (in bits) is security_strength.\0A         *\0A         * (This also matches the sizes used in the NIST test vectors.)\0A         */\0A        ctx->entropy_len = md_size <= 20 ? 16 : /* 160-bits hash -> 128 bits */\0A                           md_size <= 28 ? 24 : /* 224-bits hash -> 192 bits */\0A                           32;  /* better (256+) -> 256 bits */\0A    }\0A\0A    if ((ret = hmac_drbg_reseed_core(ctx, custom, len,\0A                                     1 /* add nonce */)) != 0) {\0A        return ret;\0A    }\0A\0A    return 0;\0A}\0A\0A/*\0A * Set prediction resistance\0A */\0Avoid mbedtls_hmac_drbg_set_prediction_resistance(mbedtls_hmac_drbg_context *ctx,\0A                                                 int resistance)\0A{\0A    ctx->prediction_resistance = resistance;\0A}\0A\0A/*\0A * Set entropy length grabbed for seeding\0A */\0Avoid mbedtls_hmac_drbg_set_entropy_len(mbedtls_hmac_drbg_context *ctx, size_t len)\0A{\0A    ctx->entropy_len = len;\0A}\0A\0A/*\0A * Set reseed interval\0A */\0Avoid mbedtls_hmac_drbg_set_reseed_interval(mbedtls_hmac_drbg_context *ctx, int interval)\0A{\0A    ctx->reseed_interval = interval;\0A}\0A\0A/*\0A * HMAC_DRBG random function with optional additional data:\0A * 10.1.2.5 (arabic) + 9.3 (Roman)\0A */\0Aint mbedtls_hmac_drbg_random_with_ad