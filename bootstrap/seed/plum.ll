@.str45619 = private global { i64, i64, [15488 x i8] } { i64 -1, i64 15487, [15488 x i8] c"/**\0A * \5Cfile pkcs5.c\0A *\0A * \5Cbrief PKCS#5 functions\0A *\0A * \5Cauthor Mathias Olsson <mathias@kompetensum.com>\0A *\0A *  Copyright The Mbed TLS Contributors\0A *  SPDX-License-Identifier: Apache-2.0 OR GPL-2.0-or-later\0A */\0A/*\0A * PKCS#5 includes PBKDF2 and more\0A *\0A * http://tools.ietf.org/html/rfc2898 (Specification)\0A * http://tools.ietf.org/html/rfc6070 (Test vectors)\0A */\0A\0A#include \22common.h\22\0A\0A#if defined(MBEDTLS_PKCS5_C)\0A\0A#include \22mbedtls/pkcs5.h\22\0A#include \22mbedtls/error.h\22\0A\0A#if defined(MBEDTLS_ASN1_PARSE_C)\0A#include \22mbedtls/asn1.h\22\0A#if defined(MBEDTLS_CIPHER_C)\0A#include \22mbedtls/cipher.h\22\0A#endif /* MBEDTLS_CIPHER_C */\0A#include \22mbedtls/oid.h\22\0A#endif /* MBEDTLS_ASN1_PARSE_C */\0A\0A#include <string.h>\0A\0A#include \22mbedtls/platform.h\22\0A\0A#include \22psa_util_internal.h\22\0A\0A#if defined(MBEDTLS_ASN1_PARSE_C) && defined(MBEDTLS_CIPHER_C)\0Astatic int pkcs5_parse_pbkdf2_params(const mbedtls_asn1_buf *params,\0A                                     mbedtls_asn1_buf *salt, int *iterations,\0A                                     int *keylen, mbedtls_md_type_t *md_type)\0A{\0A    int ret = MBEDTLS_ERR_ERROR_CORRUPTION_DETECTED;\0A    mbedtls_asn1_buf prf_alg_oid;\0A    unsigned char *p = params->p;\0A    const unsigned char *end = params->p + params->len;\0A\0A    if (params->tag != (MBEDTLS_ASN1_CONSTRUCTED | MBEDTLS_ASN1_SEQUENCE)) {\0A        return MBEDTLS_ERROR_ADD(MBEDTLS_ERR_PKCS5_INVALID_FORMAT,\0A                                 MBEDTLS_ERR_ASN1_UNEXPECTED_TAG);\0A    }\0A    /*\0A     *  PBKDF2-params ::= SEQUENCE {\0A     *    salt              OCTET STRING,\0A     *    iterationCount    INTEGER,\0A     *    keyLength         INTEGER OPTIONAL\0A     *    prf               AlgorithmIdentifier DEFAULT algid-hmacWithSHA1\0A     *  }\0A     *\0A     */\0A    if ((ret = mbedtls_asn1_get_tag(&p, end, &salt->len,\0A                                    MBEDTLS_ASN1_OCTET_STRING)) != 0) {\0A        return MBEDTLS_ERROR_ADD(MBEDTLS_ERR_PKCS5_INVALID_FORMAT, ret);\0A    }\0A\0A    salt->p = p;\0A    p += salt->len;\0A\0A    if ((ret = mbedtls_asn1_get_int(&p, end, iterations)) != 0) {\0A        return MBEDTLS_ERROR_ADD(MBEDTLS_ERR_PKCS5_INVALID_FORMAT, ret);\0A    }\0A\0A    if (p == end) {\0A        return 0;\0A    }\0A\0A    if ((ret = mbedtls_asn1_get_int(&p, end, keylen)) != 0) {\0A        if (ret != MBEDTLS_ERR_ASN1_UNEXPECTED_TAG) {\0A            return MBEDTLS_ERROR_ADD(MBEDTLS_ERR_PKCS5_INVALID_FORMAT, ret);\0A        }\0A    }\0A\0A    if (p == end) {\0A        return 0;\0A    }\0A\0A    if ((ret = mbedtls_asn1_get_alg_null(&p, end, &prf_alg_oid)) != 0) {\0A        return MBEDTLS_ERROR_ADD(MBEDTLS_ERR_PKCS5_INVALID_FORMAT, ret);\0A    }\0A\0A    if (mbedtls_oid_get_md_hmac(&prf_alg_oid, md_type) != 0) {\0A        return MBEDTLS_ERR_PKCS5_FEATURE_UNAVAILABLE;\0A    }\0A\0A    if (p != end) {\0A        return MBEDTLS_ERROR_ADD(MBEDTLS_ERR_PKCS5_INVALID_FORMAT,\0A                                 MBEDTLS_ERR_ASN1_LENGTH_MISMATCH);\0A    }\0A\0A    return 0;\0A}\0A\0A#if !defined(MBEDTLS_CIPHER_PADDING_PKCS7)\0Aint mbedtls_pkcs5_pbes2_ext(const mbedtls_asn1_buf *pbe_params, int mode,\0A                            const unsigned char *pwd,  size_t pwdlen,\0A                            const unsigned char *data, size_t datalen,\0A                            unsigned char *output, size_t output_size,\0A                            size_t *output_len);\0A#endif\0A\0A#if !defined(MBEDTLS_DEPRECATED_REMOVED)\0Aint mbedtls_pkcs5_pbes2(const mbedtls_asn1_buf *pbe_params, int mode,\0A                        const unsigned char *pwd,  size_t pwdlen,\0A                        const unsigned char *data, size_t datalen,\0A                        unsigned char *output)\0A{\0A    size_t output_len = 0;\0A\0A    /* We assume caller of the function is providing a big enough output buffer\0A     * so we pass output_size as SIZE_MAX to pass checks, However, no guarantees\0A     * for the output size actually being correct.\0A     */\0A    return mbedtls_pkcs5_pbes2_ext(pbe_params, mode, pwd, pwdlen, data,\0A                                   datalen, output, SIZE_MAX, &output_len);\0A}\0A#endif\0A\0Aint mbedtls_pkcs5_pbes2_ext(const mbedtls_asn1_buf *pbe_params, int mode,\0A                            const unsigned char *pwd,  size_t pwdlen,\0A                            const unsigned char *data, size_t datalen,\0A                            unsigned char *output, size_t output_size,\0A                            size_t *output_len)\0A{\0A    int ret, iterations = 0, keylen = 0;\0A    unsigned char *p, *end;\0A    mbedtls_asn1_buf kdf_alg_oid, enc_scheme_oid, kdf_alg_params, enc_scheme_params;\0A    mbedtls_asn1_buf salt;\0A    mbedtls_md_type_t md_type = MBEDTLS_MD_SHA1;\0A    unsigned char key[32], iv[32];\0A    const mbedtls_cipher_info_t *cipher_info;\0A    mbedtls_cipher_type_t cipher_alg;\0A    mbedtls_cipher_context_t cipher_ctx;\0A    unsigned int padlen = 0;\0A\0A    p = pbe_params->p;\0A    end = p + pbe_params->len;\0A\0A    /*\0A     *  PBES2-params ::= SEQUENCE {\0A     *    keyDerivationFunc AlgorithmIdentifier {{PBES2-KDFs}},\0A     *    encryptionScheme AlgorithmIdentifier {{PBES2-Encs}}\0A     *  }\0A     */\0A    if (pbe_params->tag != (MBEDTLS_ASN1_CONSTRUCTED | MBEDTLS_ASN1_SEQUENCE)) {\0A        return MBEDTLS_ERROR_ADD(MBEDTLS_ERR_PKCS5_INVALID_FORMAT,\0A                                 MBEDTLS_ERR_ASN1_UNEXPECTED_TAG);\0A    }\0A\0A    if ((ret = mbedtls_asn1_get_alg(&p, end, &kdf_alg_oid,\0A                                    &kdf_alg_params)) != 0) {\0A        return MBEDTLS_ERROR_ADD(MBEDTLS_ERR_PKCS5_INVALID_FORMAT, ret);\0A    }\0A\0A    // Only PBKDF2 supported at the moment\0A    //\0A    if (MBEDTLS_OID_CMP(MBEDTLS_OID_PKCS5_PBKDF2, &kdf_alg_oid) != 0) {\0A        return MBEDTLS_ERR_PKCS5_FEATURE_UNAVAILABLE;\0A    }\0A\0A    if ((ret = pkcs5_parse_pbkdf2_params(&kdf_alg_params,\0A                                         &salt, &iterations, &keylen,\0A                                         &md_type)) != 0) {\0A        return ret;\0A    }\0A\0A    if ((ret = mbedtls_asn1_get_alg(&p, end, &enc_scheme_oid,\0A                                    &enc_scheme_params)) != 0) {\0A        return MBEDTLS_ERROR_ADD(MBEDTLS_ERR_PKCS5_INVALID_FORMAT, ret);\0A    }\0A\0A    if (mbedtls_oid_get_cipher_alg(&enc_scheme_oid, &cipher_alg) != 0) {\0A        return MBEDTLS_ERR_PKCS5_FEATURE_UNAVAILABLE;\0A    }\0A\0A    cipher_info = mbedtls_cipher_info_from_type(cipher_alg);\0A    if (cipher_info == NULL) {\0A        return MBEDTLS_ERR_PKCS5_FEATURE_UNAVAILABLE;\0A    }\0A\0A    /*\0A     * The value of keylen from pkcs5_parse_pbkdf2_params() is ignored\0A     * since it is optional and we don't know if it was set or not\0A     */\0A    keylen = (int) mbedtls_cipher_info_get_key_bitlen(cipher_info) / 8;\0A\0A    if (enc_scheme_params.tag != MBEDTLS_ASN1_OCTET_STRING ||\0A        enc_scheme_params.len != mbedtls_cipher_info_get_iv_size(cipher_info)) {\0A        return MBEDTLS_ERR_PKCS5_INVALID_FORMAT;\0A    }\0A\0A    if (mode == MBEDTLS_PKCS5_DECRYPT) {\0A        if (output_size < datalen) {\0A            return MBEDTLS_ERR_ASN1_BUF_TOO_SMALL;\0A        }\0A    }\0A\0A    if (mode == MBEDTLS_PKCS5_ENCRYPT) {\0A        padlen = cipher_info->block_size - (datalen % cipher_info->block_size);\0A        if (output_size < (datalen + padlen)) {\0A            return MBEDTLS_ERR_ASN1_BUF_TOO_SMALL;\0A        }\0A    }\0A\0A    mbedtls_cipher_init(&cipher_ctx);\0A\0A    memcpy(iv, enc_scheme_params.p, enc_scheme_params.len);\0A\0A    if ((ret = mbedtls_pkcs5_pbkdf2_hmac_ext(md_type, pwd, pwdlen, salt.p,\0A                                             salt.len, iterations, keylen,\0A                                             key)) != 0) {\0A        goto exit;\0A    }\0A\0A    if ((ret = mbedtls_cipher_setup(&cipher_ctx, cipher_info)) != 0) {\0A        goto exit;\0A    }\0A\0A    if ((ret = mbedtls_cipher_setkey(&cipher_ctx, key, 8 * keylen,\0A                                     (mbedtls_operation_t) mode)) != 0) {\0A        goto exit;\0A    }\0A\0A#if defined(MBEDTLS_CIPHER_MODE_WITH_PADDING)\0A    {\0A        /* PKCS5 uses CBC with PKCS7 padding (which is the same as\0A         * \22PKCS5 padding\22 except that it's typically only called PKCS5\0A         * with 64-bit-block ciphers).\0A         */\0A        mbedtls_cipher_padding_t padding = MBEDTLS_PADDING_PKCS7;\0A#if !defined(MBEDTLS_CIPHER_PADDING_PKCS7)\0A        /* For historical reasons, when decrypting, this function works when\0A         * decrypting even when support for PKCS7 padding is disabled. In this\0A         * case, it ignores the padding, and so will never report a\0A         * password mismatch.\0A         */\0A        if (mode == MBEDTLS_DECRYPT) {\0A            padding = MBEDTLS_PADDING_NONE;\0A        }\0A#endif\0A        if ((ret = mbedtls_cipher_set_padding_mode(&cipher_ctx, padding)) != 0) {\0A            goto exit;\0A        }\0A    }\0A#endif /* MBEDTLS_CIPHER_MODE_WITH_PADDING */\0A    if ((ret = mbedtls_cipher_crypt(&cipher_ctx, iv, enc_scheme_params.len,\0A                                    data, datalen, output, output_len)) != 0) {\0A        ret = MBEDTLS_ERR_PKCS5_PASSWORD_MISMATCH;\0A    }\0A\0Aexit:\0A    mbedtls_cipher_free(&cipher_ctx);\0A\0A    return ret;\0A}\0A#endif /* MBEDTLS_ASN1_PARSE_C && MBEDTLS_CIPHER_C */\0A\0Astatic int pkcs5_pbkdf2_hmac(mbedtls_md_context_t *ctx,\0A                             const unsigned char *password,\0A                             size_t plen, const unsigned char *salt, size_t slen,\0A                             unsigned int iteration_count,\0A                             uint32_t key_length, unsigned char *output)\0A{\0A    int ret = MBEDTLS_ERR_ERROR_CORRUPTION_DETECTED;\0A    unsigned int i;\0A    unsigned char md1[MBEDTLS_MD_MAX_SIZE];\0A    unsigned char work[MBEDTLS_MD_MAX_SIZE];\0A    unsigned char md_size = mbedtls_md_get_size(ctx->md_info);\0A    size_t use_len;\0A    unsigned char *out_p = output;\0A    unsigned char counter[4];\0A\0A    memset(counter, 0, 4);\0A    counter[3] = 1;\0A\0A#if UINT_MAX > 0xFFFFFFFF\0A    if (iteration_count > 0xFFFFFFFF) {\0A        return MBEDTLS_ERR_PKCS5_BAD_INPUT_DATA;\0A    }\0A#endif\0A\0A    if ((ret = mbedtls_md_hmac_starts(ctx, password, plen)) != 0) {\0A        return ret;\0A    }\0A    while (key_length) {\0A        // U1 ends up in work\0A        //\0A        if ((ret = mbedtls_md_hmac_update(ctx, salt, slen)) != 0) {\0A            goto cleanup;\0A        }\0A\0A        if ((ret = mbedtls_md_hmac_update(ctx, counter, 4)) != 0) {\0A            goto cleanup;\0A        }\0A\0A        if ((ret = mbedtls_md_hmac_finish(ctx, work)) != 0) {\0A            goto cleanup;\0A        }\0A\0A        if ((ret = mbedtls_md_hmac_reset(ctx)) != 0) {\0A            goto cleanup;\0A        }\0A\0A        memcpy(md1, work, md_size);\0A\0A        for (i = 1; i < iteration_count; i++) {\0A            // U2 ends up in md1\0A            //\0A            if ((ret = mbedtls_md_hmac_update(ctx, md1, md_size)) != 0) {\0A                goto cleanup;\0A            }\0A\0A            if ((ret = mbedtls_md_hmac_finish(ctx, md1)) != 0) {\0A                goto cleanup;\0A            }\0A\0A            if ((ret = mbedtls_md_hmac_reset(ctx)) != 0) {\0A                goto cleanup;\0A            }\0A\0A            // U1 xor U2\0A            //\0A            mbedtls_xor(work, work, md1, md_size);\0A        }\0A\0A        use_len = (key_length < md_size) ? key_length : md_size;\0A        memcpy(out_p, work, use_len);\0A\0A        key_length -= (uint32_t) use_len;\0A        out_p += use_len;\0A\0A        for (i = 4; i > 0; i--) {\0A            if (++counter[i - 1] != 0) {\0A                break;\0A            }\0A        }\0A    }\0A\0Acleanup:\0A    /* Zeroise buffers