@.str41130 = private global { i64, i64, [6212 x i8] } { i64 -1, i64 6211, [6212 x i8] c"/*\0A *  Platform-specific and custom entropy polling functions\0A *\0A *  Copyright The Mbed TLS Contributors\0A *  SPDX-License-Identifier: Apache-2.0 OR GPL-2.0-or-later\0A */\0A\0A#if defined(__linux__) || defined(__midipix__)\0A/* Ensure that syscall() is available even when compiling with -std=c99 */\0A#if !defined(_GNU_SOURCE)\0A#define _GNU_SOURCE\0A#endif\0A#endif\0A\0A#include \22common.h\22\0A\0A#include <string.h>\0A\0A#if defined(MBEDTLS_ENTROPY_C)\0A\0A#include \22mbedtls/entropy.h\22\0A#include \22entropy_poll.h\22\0A#include \22mbedtls/error.h\22\0A\0A#if defined(MBEDTLS_TIMING_C)\0A#include \22mbedtls/timing.h\22\0A#endif\0A#include \22mbedtls/platform.h\22\0A\0A#if !defined(MBEDTLS_NO_PLATFORM_ENTROPY)\0A\0A#if !defined(unix) && !defined(__unix__) && !defined(__unix) && \5C\0A    !defined(__APPLE__) && !defined(_WIN32) && !defined(__QNXNTO__) && \5C\0A    !defined(__HAIKU__) && !defined(__midipix__) && !defined(__MVS__)\0A#error \5C\0A    \22Platform entropy sources only work on Unix and Windows, see MBEDTLS_NO_PLATFORM_ENTROPY in mbedtls_config.h\22\0A#endif\0A\0A#if defined(_WIN32) && !defined(EFIX64) && !defined(EFI32)\0A\0A#include <windows.h>\0A#include <bcrypt.h>\0A#include <intsafe.h>\0A\0Aint mbedtls_platform_entropy_poll(void *data, unsigned char *output, size_t len,\0A                                  size_t *olen)\0A{\0A    ((void) data);\0A    *olen = 0;\0A\0A    /*\0A     * BCryptGenRandom takes ULONG for size, which is smaller than size_t on\0A     * 64-bit Windows platforms. Extract entropy in chunks of len (dependent\0A     * on ULONG_MAX) size.\0A     */\0A    while (len != 0) {\0A        unsigned long ulong_bytes =\0A            (len > ULONG_MAX) ? ULONG_MAX : (unsigned long) len;\0A\0A        if (!BCRYPT_SUCCESS(BCryptGenRandom(NULL, output, ulong_bytes,\0A                                            BCRYPT_USE_SYSTEM_PREFERRED_RNG))) {\0A            return MBEDTLS_ERR_ENTROPY_SOURCE_FAILED;\0A        }\0A\0A        *olen += ulong_bytes;\0A        len -= ulong_bytes;\0A    }\0A\0A    return 0;\0A}\0A#else /* _WIN32 && !EFIX64 && !EFI32 */\0A\0A/*\0A * Test for Linux getrandom() support.\0A * Since there is no wrapper in the libc yet, use the generic syscall wrapper\0A * available in GNU libc and compatible libc's (eg uClibc).\0A */\0A#if ((defined(__linux__) && defined(__GLIBC__)) || defined(__midipix__))\0A#include <unistd.h>\0A#include <sys/syscall.h>\0A#if defined(SYS_getrandom)\0A#define HAVE_GETRANDOM\0A#include <errno.h>\0A\0Astatic int getrandom_wrapper(void *buf, size_t buflen, unsigned int flags)\0A{\0A    /* MemSan cannot understand that the syscall writes to the buffer */\0A#if defined(__has_feature)\0A#if __has_feature(memory_sanitizer)\0A    memset(buf, 0, buflen);\0A#endif\0A#endif\0A    return (int) syscall(SYS_getrandom, buf, buflen, flags);\0A}\0A#endif /* SYS_getrandom */\0A#endif /* __linux__ || __midipix__ */\0A\0A#if defined(__FreeBSD__) || defined(__DragonFly__)\0A#include <sys/param.h>\0A#if (defined(__FreeBSD__) && __FreeBSD_version >= 1200000) || \5C\0A    (defined(__DragonFly__) && __DragonFly_version >= 500700)\0A#include <errno.h>\0A#include <sys/random.h>\0A#define HAVE_GETRANDOM\0Astatic int getrandom_wrapper(void *buf, size_t buflen, unsigned int flags)\0A{\0A    return (int) getrandom(buf, buflen, flags);\0A}\0A#endif /* (__FreeBSD__ && __FreeBSD_version >= 1200000) ||\0A          (__DragonFly__ && __DragonFly_version >= 500700) */\0A#endif /* __FreeBSD__ || __DragonFly__ */\0A\0A/*\0A * Some BSD systems provide KERN_ARND.\0A * This is equivalent to reading from /dev/urandom, only it doesn't require an\0A * open file descriptor, and provides up to 256 bytes per call (basically the\0A * same as getentropy(), but with a longer history).\0A *\0A * Documentation: https://netbsd.gw.com/cgi-bin/man-cgi?sysctl+7\0A */\0A#if (defined(__FreeBSD__) || defined(__NetBSD__)) && !defined(HAVE_GETRANDOM)\0A#include <sys/param.h>\0A#include <sys/sysctl.h>\0A#if defined(KERN_ARND)\0A#define HAVE_SYSCTL_ARND\0A\0Astatic int sysctl_arnd_wrapper(unsigned char *buf, size_t buflen)\0A{\0A    int name[2];\0A    size_t len;\0A\0A    name[0] = CTL_KERN;\0A    name[1] = KERN_ARND;\0A\0A    while (buflen > 0) {\0A        len = buflen > 256 ? 256 : buflen;\0A        if (sysctl(name, 2, buf, &len, NULL, 0) == -1) {\0A            return -1;\0A        }\0A        buflen -= len;\0A        buf += len;\0A    }\0A    return 0;\0A}\0A#endif /* KERN_ARND */\0A#endif /* __FreeBSD__ || __NetBSD__ */\0A\0A#include <stdio.h>\0A\0Aint mbedtls_platform_entropy_poll(void *data,\0A                                  unsigned char *output, size_t len, size_t *olen)\0A{\0A    FILE *file;\0A    size_t read_len;\0A    int ret = MBEDTLS_ERR_ERROR_CORRUPTION_DETECTED;\0A    ((void) data);\0A\0A#if defined(HAVE_GETRANDOM)\0A    ret = getrandom_wrapper(output, len, 0);\0A    if (ret >= 0) {\0A        *olen = (size_t) ret;\0A        return 0;\0A    } else if (errno != ENOSYS) {\0A        return MBEDTLS_ERR_ENTROPY_SOURCE_FAILED;\0A    }\0A    /* Fall through if the system call isn't known. */\0A#else\0A    ((void) ret);\0A#endif /* HAVE_GETRANDOM */\0A\0A#if defined(HAVE_SYSCTL_ARND)\0A    ((void) file);\0A    ((void) read_len);\0A    if (sysctl_arnd_wrapper(output, len) == -1) {\0A        return MBEDTLS_ERR_ENTROPY_SOURCE_FAILED;\0A    }\0A    *olen = len;\0A    return 0;\0A#else\0A\0A    *olen = 0;\0A\0A    file = fopen(\22/dev/urandom\22, \22rb\22);\0A    if (file == NULL) {\0A        return MBEDTLS_ERR_ENTROPY_SOURCE_FAILED;\0A    }\0A\0A    /* Ensure no stdio buffering of secrets, as such buffers cannot be wiped. */\0A    mbedtls_setbuf(file, NULL);\0A\0A    read_len = fread(output, 1, len, file);\0A    if (read_len != len) {\0A        fclose(file);\0A        return MBEDTLS_ERR_ENTROPY_SOURCE_FAILED;\0A    }\0A\0A    fclose(file);\0A    *olen = len;\0A\0A    return 0;\0A#endif /* HAVE_SYSCTL_ARND */\0A}\0A#endif /* _WIN32 && !EFIX64 && !EFI32 */\0A#endif /* !MBEDTLS_NO_PLATFORM_ENTROPY */\0A\0A#if defined(MBEDTLS_ENTROPY_NV_SEED)\0Aint mbedtls_nv_seed_poll(void *data,\0A                         unsigned char *output, size_t len, size_t *olen)\0A{\0A    unsigned char buf[MBEDTLS_ENTROPY_BLOCK_SIZE];\0A    size_t use_len = MBEDTLS_ENTROPY_BLOCK_SIZE;\0A    ((void) data);\0A\0A    memset(buf, 0, MBEDTLS_ENTROPY_BLOCK_SIZE);\0A\0A    if (mbedtls_nv_seed_read(buf, MBEDTLS_ENTROPY_BLOCK_SIZE) < 0) {\0A        return MBEDTLS_ERR_ENTROPY_SOURCE_FAILED;\0A    }\0A\0A    if (len < use_len) {\0A        use_len = len;\0A    }\0A\0A    memcpy(output, buf, use_len);\0A    *olen = use_len;\0A\0A    return 0;\0A}\0A#endif /* MBEDTLS_ENTROPY_NV_SEED */\0A\0A#endif /* MBEDTLS_ENTROPY_C */\0A\00" }
