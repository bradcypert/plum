); s->used=0; }\0A    }\0A}\0A\0Astatic void plum_cache_final(plum_cache_sha *s, char out[65]) {\0A    uint64_t bits = s->bytes * 8;\0A    unsigned char pad[128] = {0x80};\0A    size_t n = s->used < 56 ? 56-s->used : 120-s->used;\0A    for (unsigned i = 0; i < 8; i++) pad[n+i]=(unsigned char)(bits >> ((7-i)*8));\0A    plum_cache_update(s,pad,n+8);\0A    for (unsigned i = 0; i < 8; i++) snprintf(out+i*8,9,\22%08x\22,(unsigned)s->h[i]);\0A    out[64]='\5C0';\0A}\0A\0Aconst char *plum_cache_hash_text(const char *p, long long n) {\0A    static char out[65];\0A    if (n < 0) { out[0]='\5C0'; return out; }\0A    plum_cache_sha s; plum_cache_init(&s);\0A    plum_cache_update(&s,(const unsigned char *)p,(size_t)n);\0A    plum_cache_final(&s,out); return out;\0A}\0A\0A// Linux's optional kernel SHA provider uses CPU acceleration when available.\0A// No new library/tool dependency; an unavailable provider falls back to the\0A// portable implementation. Cache correctness is independent of the provider.\0Astatic int plum_cache_kernel_hash(const char *path, char out[65]) {\0A#if defined(PLUM_CACHE_AF_ALG)\0A    struct sockaddr_alg sa;\0A    memset(&sa,0,sizeof(sa)); sa.salg_family=AF_ALG;\0A    memcpy(sa.salg_type,\22hash\22,5); memcpy(sa.salg_name,\22sha256\22,7);\0A    int parent=socket(AF_ALG,SOCK_SEQPACKET,0);\0A    if (parent < 0) return 0;\0A    if (bind(parent,(struct sockaddr *)&sa,sizeof(sa)) != 0) { close(parent); return 0; }\0A    int fd=accept(parent,NULL,NULL); close(parent);\0A    if (fd < 0) return 0;\0A    FILE *f=fopen(path,\22rb\22);\0A    if (!f) { close(fd); return 0; }\0A    unsigned char buf[65536], digest[32]; size_t n; int bad=0;\0A    while ((n=fread(buf,1,sizeof(buf),f)) != 0) {\0A        size_t at=0;\0A        while (at < n) {\0A            ssize_t sent=send(fd,buf+at,n-at,MSG_MORE);\0A            if (sent <= 0) { bad=1; break; }\0A            at+=(size_t)sent;\0A        }\0A        if (bad) break;\0A    }\0A    if (ferror(f)) bad=1;\0A    if (fclose(f) != 0) bad=1;\0A    if (!bad && send(fd,NULL,0,0) != 0) bad=1;\0A    if (!bad && recv(fd,digest,sizeof(digest),0) != (ssize_t)sizeof(digest)) bad=1;\0A    close(fd);\0A    if (bad) return 0;\0A    for (unsigned i=0;i<32;i++) snprintf(out+i*2,3,\22%02x\22,(unsigned)digest[i]);\0A    out[64]='\5C0'; return 1;\0A#else\0A    (void)path; (void)out; return 0;\0A#endif\0A}\0A\0Aconst char *plum_cache_hash_file(const char *path) {\0A    static char out[65];\0A    unsigned char buf[32768]; size_t n;\0A    out[0]='\5C0';\0A    struct stat st;\0A    if (stat(path,&st) == 0 && S_ISREG(st.st_mode) && st.st_size > 1048576\0A        && plum_cache_kernel_hash(path,out)) return out;\0A    FILE *f=fopen(path,\22rb\22);\0A    if (!f) return out;\0A    plum_cache_sha s; plum_cache_init(&s);\0A    while ((n=fread(buf,1,sizeof(buf),f)) != 0) plum_cache_update(&s,buf,n);\0A    int bad=ferror(f); if (fclose(f) != 0) bad=1;\0A    if (!bad) plum_cache_final(&s,out);\0A    return out;\0A}\0A\0A// Saved input paths are byte strings, just like fopen's paths. Windows\0A// argv uses the active ANSI code page, and POSIX filenames need not be\0A// UTF-8 either. Decode the hex envelope without treating it as Unicode.\0Astatic int plum_cache_hex_digit(unsigned char c) {\0A    if (c >= '0' && c <= '9') return c - '0';\0A    if (c >= 'a' && c <= 'f') return c - 'a' + 10;\0A    if (c >= 'A' && c <= 'F') return c - 'A' + 10;\0A    return -1;\0A}\0A\0Aconst char *plum_cache_hash_file_hex(const char *hex) {\0A    size_t n = strlen(hex);\0A    if (n == 0 || n % 2 != 0) return \22\22;\0A    char *path = malloc(n / 2 + 1);\0A    if (!path) return \22\22;\0A    for (size_t i = 0; i < n; i += 2) {\0A        int a = plum_cache_hex_digit((unsigned char)hex[i]);\0A        int b = plum_cache_hex_digit((unsigned char)hex[i + 1]);\0A        // Embedded NUL must not truncate a corrupt manifest's path.\0A        if (a < 0 || b < 0 || (a == 0 && b == 0)) {\0A            free(path); return \22\22;\0A        }\0A        path[i / 2] = (char)((a << 4) | b);\0A    }\0A    path[n / 2] = '\5C0';\0A    const char *digest = plum_cache_hash_file(path);\0A    free(path);\0A    return digest;\0A}\0A\0A// Verify the bytes actually copied, not a prior read of the source path.\0A// A concurrent cleaner can remove an entry at any point; that is a miss.\0Along long plum_cache_copy(const char *src, const char *dst, const char *digest) {\0A    FILE *in=fopen(src,\22rb\22); if (!in) return -1;\0A    FILE *out=fopen(dst,\22wb\22); if (!out) { fclose(in); return -1; }\0A    unsigned char buf[32768]; size_t n; int bad=0; char got[65];\0A    plum_cache_sha s; plum_cache_init(&s);\0A    while ((n=fread(buf,1,sizeof(buf),in)) != 0) {\0A        plum_cache_update(&s,buf,n);\0A        if (fwrite(buf,1,n,out) != n) { bad=1; break; }\0A    }\0A    if (ferror(in)) bad=1;\0A    if (fclose(in) != 0) bad=1;\0A    if (fclose(out) != 0) bad=1;\0A    plum_cache_final(&s,got);\0A    if (digest[0] && strcmp(got,digest) != 0) bad=1;\0A    if (bad) remove(dst);\0A    return bad ? -1 : 0;\0A}\0A\0A#if defined(_WIN32)\0A// Reserve the DIRECTORY atomically. GetTempFileName followed by deleting its\0A// file and making a directory releases the name between those operations;\0A// concurrent callers can then select the same supposedly unique name.\0Astatic void plum_win_temp_dir(const char *root, const char *prefix) {\0A    static volatile LONG serial=0;\0A    size_t len=strlen(root);\0A    const char *separator=len && (root[len-1]=='/' || root[len-1]=='\5C\5C') ? \22\22 : \22\5C\5C\22;\0A    for (unsigned attempt=0; attempt<128; attempt++) {\0A        unsigned long next=(unsigned long)(ULONG)InterlockedIncrement(&serial);\0A        int n=snprintf(plum_os_buf,sizeof(plum_os_buf),\22%s%s%s%lu-%llu-%lu\22,root,separator,prefix,\0A                       (unsigned long)GetCurrentProcessId(),(unsigned long long)GetTickCount64(),next);\0A        if (n<0 || n>=(int)sizeof(plum_os_buf)) break;\0A        if (CreateDirectoryA(plum_os_bu