@.str42666 = private global { i64, i64, [51626 x i8] } { i64 -1, i64 51625, [51626 x i8] c"/*\0A *  Public Key abstraction layer\0A *\0A *  Copyright The Mbed TLS Contributors\0A *  SPDX-License-Identifier: Apache-2.0 OR GPL-2.0-or-later\0A */\0A\0A#include \22common.h\22\0A\0A#if defined(MBEDTLS_PK_C)\0A#include \22mbedtls/pk.h\22\0A#include \22pk_wrap.h\22\0A#include \22pkwrite.h\22\0A#include \22pk_internal.h\22\0A\0A#include \22mbedtls/platform_util.h\22\0A#include \22mbedtls/error.h\22\0A\0A#if defined(MBEDTLS_RSA_C)\0A#include \22mbedtls/rsa.h\22\0A#include \22rsa_internal.h\22\0A#endif\0A#if defined(MBEDTLS_PK_HAVE_ECC_KEYS)\0A#include \22mbedtls/ecp.h\22\0A#endif\0A#if defined(MBEDTLS_ECDSA_C)\0A#include \22mbedtls/ecdsa.h\22\0A#endif\0A\0A#if defined(MBEDTLS_PSA_CRYPTO_CLIENT)\0A#include \22psa_util_internal.h\22\0A#include \22mbedtls/psa_util.h\22\0A#endif\0A\0A#include <limits.h>\0A#include <stdint.h>\0A\0A/*\0A * Initialise a mbedtls_pk_context\0A */\0Avoid mbedtls_pk_init(mbedtls_pk_context *ctx)\0A{\0A    ctx->pk_info = NULL;\0A    ctx->pk_ctx = NULL;\0A#if defined(MBEDTLS_USE_PSA_CRYPTO)\0A    ctx->priv_id = MBEDTLS_SVC_KEY_ID_INIT;\0A#endif /* MBEDTLS_USE_PSA_CRYPTO */\0A#if defined(MBEDTLS_PK_USE_PSA_EC_DATA)\0A    memset(ctx->pub_raw, 0, sizeof(ctx->pub_raw));\0A    ctx->pub_raw_len = 0;\0A    ctx->ec_family = 0;\0A    ctx->ec_bits = 0;\0A#endif /* MBEDTLS_PK_USE_PSA_EC_DATA */\0A}\0A\0A/*\0A * Free (the components of) a mbedtls_pk_context\0A */\0Avoid mbedtls_pk_free(mbedtls_pk_context *ctx)\0A{\0A    if (ctx == NULL) {\0A        return;\0A    }\0A\0A    if ((ctx->pk_info != NULL) && (ctx->pk_info->ctx_free_func != NULL)) {\0A        ctx->pk_info->ctx_free_func(ctx->pk_ctx);\0A    }\0A\0A#if defined(MBEDTLS_PK_USE_PSA_EC_DATA)\0A    /* The ownership of the priv_id key for opaque keys is external of the PK\0A     * module. It's the user responsibility to clear it after use. */\0A    if ((ctx->pk_info != NULL) && (ctx->pk_info->type != MBEDTLS_PK_OPAQUE)) {\0A        psa_destroy_key(ctx->priv_id);\0A    }\0A#endif /* MBEDTLS_PK_USE_PSA_EC_DATA */\0A\0A    mbedtls_platform_zeroize(ctx, sizeof(mbedtls_pk_context));\0A}\0A\0A#if defined(MBEDTLS_ECDSA_C) && defined(MBEDTLS_ECP_RESTARTABLE)\0A/*\0A * Initialize a restart context\0A */\0Avoid mbedtls_pk_restart_init(mbedtls_pk_restart_ctx *ctx)\0A{\0A    ctx->pk_info = NULL;\0A    ctx->rs_ctx = NULL;\0A}\0A\0A/*\0A * Free the components of a restart context\0A */\0Avoid mbedtls_pk_restart_free(mbedtls_pk_restart_ctx *ctx)\0A{\0A    if (ctx == NULL || ctx->pk_info == NULL ||\0A        ctx->pk_info->rs_free_func == NULL) {\0A        return;\0A    }\0A\0A    ctx->pk_info->rs_free_func(ctx->rs_ctx);\0A\0A    ctx->pk_info = NULL;\0A    ctx->rs_ctx = NULL;\0A}\0A#endif /* MBEDTLS_ECDSA_C && MBEDTLS_ECP_RESTARTABLE */\0A\0A/*\0A * Get pk_info structure from type\0A */\0Aconst mbedtls_pk_info_t *mbedtls_pk_info_from_type(mbedtls_pk_type_t pk_type)\0A{\0A    switch (pk_type) {\0A#if defined(MBEDTLS_RSA_C)\0A        case MBEDTLS_PK_RSA:\0A            return &mbedtls_rsa_info;\0A#endif /* MBEDTLS_RSA_C */\0A#if defined(MBEDTLS_PK_HAVE_ECC_KEYS)\0A        case MBEDTLS_PK_ECKEY:\0A            return &mbedtls_eckey_info;\0A        case MBEDTLS_PK_ECKEY_DH:\0A            return &mbedtls_eckeydh_info;\0A#endif /* MBEDTLS_PK_HAVE_ECC_KEYS */\0A#if defined(MBEDTLS_PK_CAN_ECDSA_SOME)\0A        case MBEDTLS_PK_ECDSA:\0A            return &mbedtls_ecdsa_info;\0A#endif /* MBEDTLS_PK_CAN_ECDSA_SOME */\0A        /* MBEDTLS_PK_RSA_ALT omitted on purpose */\0A        default:\0A            return NULL;\0A    }\0A}\0A\0A/*\0A * Initialise context\0A */\0Aint mbedtls_pk_setup(mbedtls_pk_context *ctx, const mbedtls_pk_info_t *info)\0A{\0A    if (info == NULL || ctx->pk_info != NULL) {\0A        return MBEDTLS_ERR_PK_BAD_INPUT_DATA;\0A    }\0A\0A    if ((info->ctx_alloc_func != NULL) &&\0A        ((ctx->pk_ctx = info->ctx_alloc_func()) == NULL)) {\0A        return MBEDTLS_ERR_PK_ALLOC_FAILED;\0A    }\0A\0A    ctx->pk_info = info;\0A\0A    return 0;\0A}\0A\0A#if defined(MBEDTLS_USE_PSA_CRYPTO)\0A/*\0A * Initialise a PSA-wrapping context\0A */\0Aint mbedtls_pk_setup_opaque(mbedtls_pk_context *ctx,\0A                            const mbedtls_svc_key_id_t key)\0A{\0A    const mbedtls_pk_info_t *info = NULL;\0A    psa_key_attributes_t attributes = PSA_KEY_ATTRIBUTES_INIT;\0A    psa_key_type_t type;\0A\0A    if (ctx == NULL || ctx->pk_info != NULL) {\0A        return MBEDTLS_ERR_PK_BAD_INPUT_DATA;\0A    }\0A\0A    if (PSA_SUCCESS != psa_get_key_attributes(key, &attributes)) {\0A        return MBEDTLS_ERR_PK_BAD_INPUT_DATA;\0A    }\0A    type = psa_get_key_type(&attributes);\0A    psa_reset_key_attributes(&attributes);\0A\0A#if defined(MBEDTLS_PK_HAVE_ECC_KEYS)\0A    if (PSA_KEY_TYPE_IS_ECC_KEY_PAIR(type)) {\0A        info = &mbedtls_ecdsa_opaque_info;\0A    } else\0A#endif /* MBEDTLS_PK_HAVE_ECC_KEYS */\0A    if (type == PSA_KEY_TYPE_RSA_KEY_PAIR) {\0A        info = &mbedtls_rsa_opaque_info;\0A    } else {\0A        return MBEDTLS_ERR_PK_FEATURE_UNAVAILABLE;\0A    }\0A\0A    ctx->pk_info = info;\0A    ctx->priv_id = key;\0A\0A    return 0;\0A}\0A#endif /* MBEDTLS_USE_PSA_CRYPTO */\0A\0A#if defined(MBEDTLS_PK_RSA_ALT_SUPPORT)\0A/*\0A * Initialize an RSA-alt context\0A */\0Aint mbedtls_pk_setup_rsa_alt(mbedtls_pk_context *ctx, void *key,\0A                             mbedtls_pk_rsa_alt_decrypt_func decrypt_func,\0A                             mbedtls_pk_rsa_alt_sign_func sign_func,\0A                             mbedtls_pk_rsa_alt_key_len_func key_len_func)\0A{\0A    mbedtls_rsa_alt_context *rsa_alt;\0A    const mbedtls_pk_info_t *info = &mbedtls_rsa_alt_info;\0A\0A    if (ctx->pk_info != NULL) {\0A        return MBEDTLS_ERR_PK_BAD_INPUT_DATA;\0A    }\0A\0A    if ((ctx->pk_ctx = info->ctx_alloc_func()) == NULL) {\0A        return MBEDTLS_ERR_PK_ALLOC_FAILED;\0A    }\0A\0A    ctx->pk_info = info;\0A\0A    rsa_alt = (mbedtls_rsa_alt_context *) ctx->pk_ctx;\0A\0A    rsa_alt->key = key;\0A    rsa_alt->decrypt_func = decrypt_func;\0A    rsa_alt->sign_func = sign_func;\0A    rsa_alt->key_len_func = key_len_func;\0A\0A    return 0;\0A}\0A#endif /* MBEDTLS_PK_RSA_ALT_SUPPORT */\0A\0A/*\0A * Tell if a PK can do the operations of the given type\0A */\0Aint mbedtls_pk_can_do(const mbedtls_pk_context *ctx, mbedtls_pk_type_t type)\0A{\0A    /* A context with null pk_info is not set up yet and can't do anything.\0A     * For backward compatibility, also accept NULL instead of a context\0A     * pointer. */\0A    if (ctx == NULL || ctx->pk_info == NULL) {\0A        return 0;\0A    }\0A\0A    return ctx->pk_info->can_do(type);\0A}\0A\0A#if defined(MBEDTLS_USE_PSA_CRYPTO)\0A/*\0A * Tell if a PK can do the operations of the given PSA algorithm\0A */\0Aint mbedtls_pk_can_do_ext(const mbedtls_pk_context *ctx, psa_algorithm_t alg,\0A                          psa_key_usage_t usage)\0A{\0A    psa_key_usage_t key_usage;\0A\0A    /* A context with null pk_info is not set up yet and can't do anything.\0A     * For backward compatibility, also accept NULL instead of a context\0A     * pointer. */\0A    if (ctx == NULL || ctx->pk_info == NULL) {\0A        return 0;\0A    }\0A\0A    /* Filter out non allowed algorithms */\0A    if (PSA_ALG_IS_ECDSA(alg) == 0 &&\0A        PSA_ALG_IS_RSA_PKCS1V15_SIGN(alg) == 0 &&\0A        PSA_ALG_IS_RSA_PSS(alg) == 0 &&\0A        alg != PSA_ALG_RSA_PKCS1V15_CRYPT &&\0A        PSA_ALG_IS_ECDH(alg) == 0) {\0A        return 0;\0A    }\0A\0A    /* Filter out non allowed usage flags */\0A    if (usage == 0 ||\0A        (usage & ~(PSA_KEY_USAGE_SIGN_HASH |\0A                   PSA_KEY_USAGE_DECRYPT |\0A                   PSA_KEY_USAGE_DERIVE)) != 0) {\0A        return 0;\0A    }\0A\0A    /* Wildcard hash is not allowed */\0A    if (PSA_ALG_IS_SIGN_HASH(alg) &&\0A        PSA_ALG_SIGN_GET_HASH(alg) == PSA_ALG_ANY_HASH) {\0A        return 0;\0A    }\0A\0A    if (mbedtls_pk_get_type(ctx) != MBEDTLS_PK_OPAQUE) {\0A        mbedtls_pk_type_t type;\0A\0A        if (PSA_ALG_IS_ECDSA(alg) || PSA_ALG_IS_ECDH(alg)) {\0A            type = MBEDTLS_PK_ECKEY;\0A        } else if (PSA_ALG_IS_RSA_PKCS1V15_SIGN(alg) ||\0A                   alg == PSA_ALG_RSA_PKCS1V15_CRYPT) {\0A            type = MBEDTLS_PK_RSA;\0A        } else if (PSA_ALG_IS_RSA_PSS(alg)) {\0A            type = MBEDTLS_PK_RSASSA_PSS;\0A        } else {\0A            return 0;\0A        }\0A\0A        if (ctx->pk_info->can_do(type) == 0) {\0A            return 0;\0A        }\0A\0A        switch (type) {\0A            case MBEDTLS_PK_ECKEY:\0A                key_usage = PSA_KEY_USAGE_SIGN_HASH | PSA_KEY_USAGE_DERIVE;\0A                break;\0A            case MBEDTLS_PK_RSA:\0A            case MBEDTLS_PK_RSASSA_PSS:\0A                key_usage = PSA_KEY_USAGE_SIGN_HASH |\0A                            PSA_KEY_USAGE_SIGN_MESSAGE |\0A                            PSA_KEY_USAGE_DECRYPT;\0A                break;\0A            default:\0A                /* Should never happen */\0A                return 0;\0A        }\0A\0A        return (key_usage & usage) == usage;\0A    }\0A\0A    psa_key_attributes_t attributes = PSA_KEY_ATTRIBUTES_INIT;\0A    psa_status_t status;\0A\0A    status = psa_get_key_attributes(ctx->priv_id, &attributes);\0A    if (status != PSA_SUCCESS) {\0A        return 0;\0A    }\0A\0A    psa_algorithm_t key_alg = psa_get_key_algorithm(&attributes);\0A    /* Key's enrollment is available only when an Mbed TLS implementation of PSA\0A     * Crypto is being used, i.e. when MBEDTLS_PSA_CRYPTO_C is defined.\0A     * Even though we don't officially support using other implementations of PSA\0A     * Crypto with TLS and X.509 (yet), we try to keep vendor's customizations\0A     * separated. */\0A#if defined(MBEDTLS_PSA_CRYPTO_C)\0A    psa_algorithm_t key_alg2 = psa_get_key_enrollment_algorithm(&attributes);\0A#endif /* MBEDTLS_PSA_CRYPTO_C */\0A    key_usage = psa_get_key_usage_flags(&attributes);\0A    psa_reset_key_attributes(&attributes);\0A\0A    if ((key_usage & usage) != usage) {\0A        return 0;\0A    }\0A\0A    /*\0A     * Common case: the key alg [or alg2] only allows alg.\0A     * This will match PSA_ALG_RSA_PKCS1V15_CRYPT & PSA_ALG_IS_ECDH\0A     * directly.\0A     * This would also match ECDSA/RSA_PKCS1V15_SIGN/RSA_PSS with\0A     * a fixed hash on key_alg [or key_alg2].\0A     */\0A    if (alg == key_alg) {\0A        return 1;\0A    }\0A#if defined(MBEDTLS_PSA_CRYPTO_C)\0A    if (alg == key_alg2) {\0A        return 1;\0A    }\0A#endif /* MBEDTLS_PSA_CRYPTO_C */\0A\0A    /*\0A     * If key_alg [or key_alg2] is a hash-and-sign with a wildcard for the hash,\0A     * and alg is the same hash-and-sign family with any hash,\0A     * then alg is compliant with this key alg\0A     */\0A    if (PSA_ALG_IS_SIGN_HASH(alg)) {\0A        if (PSA_ALG_IS_SIGN_HASH(key_alg) &&\0A            PSA_ALG_SIGN_GET_HASH(key_alg) == PSA_ALG_ANY_HASH &&\0A            (alg & ~PSA_ALG_HASH_MASK) == (key_alg & ~PSA_ALG_HASH_MASK)) {\0A            return 1;\0A        }\0A#if defined(MBEDTLS_PSA_CRYPTO_C)\0A        if (PSA_ALG_IS_SIGN_HASH(key_alg2) &&\0A            PSA_ALG_SIGN_GET_HASH(key_alg2) == PSA_ALG_ANY_HASH &&\0A            (alg & ~PSA_ALG_HASH_MASK) == (key_alg2 & ~PSA_ALG_HASH_MASK)) {\0A            return 1;\0A        }\0A#endif /* MBEDTLS_PSA_CRYPTO_C */\0A    }\0A\0A    return 0;\0A}\0A#endif /* MBEDTLS_USE_PSA_CRYPTO */\0A\0A#if defined(MBEDTLS_PSA_CRYPTO_CLIENT)\0A#if defined(MBEDTLS_RSA_C)\0Astatic psa_algorithm_t psa_algorithm_for_rsa(const mbedtls_rsa_context *rsa,\0A                                             int want_crypt)\0A{\0A    if (mbedtls_rsa_get_padding_mode(rsa) == MBEDTLS_RSA_PKCS_V21) {\0A        if (want_crypt) {\0A            mbedtls_md_type_t md_type = (mbedtls_md_type_t) mbedtls_rsa_get_md_alg(rsa);\0A            return PSA_ALG_RSA_OAEP(mbedtls_md_psa_alg_from_type(md_type));\0A        } else {\0A            return PSA_ALG_RSA_PSS_ANY_SALT(PSA_ALG_ANY_HASH);\0A        }\0A    } else {\0A        if (want_crypt) {\0A            return PSA_ALG_RSA_PKCS1V15_CRYPT;\0A        } else {\0A            return PSA_ALG_RSA_PKCS1V15_SIGN(PSA_ALG_ANY_HASH);\0A        }\0A    }\0A}\0A#endif /* MBEDTLS_RSA_C */\0A\0Aint mbedtls_pk_get_psa_attributes(const mbedtls_pk_context *pk,\0A                                  psa_key_usage_t usage,\0A                                  psa_key_attributes_t *attributes)\0A{\0A    mbedtls_pk_type_t pk_type = mbedtls_pk_get_type(pk);\0A\0A    psa_key_usage_t more_usage = usage;\0A    if (usage == PSA_KEY_USAGE_SIGN_MESSAGE) {\0A        more_usage |= PSA_KEY_USAGE_VERIFY_MESSAGE;\0A    } else if (usage == PSA_KEY_USAGE_SIGN_HASH) {\0A        more_usage |= PSA_KEY_USAGE_VERIFY_HASH;\0A    } else if (usage == PSA_KEY_USAGE_DECRYPT) {\0A        more_usage |= PSA_KEY_USAGE_ENCRYPT;\0A    }\0A    more_usage |= PSA_KEY_USAGE_EXPORT | PSA_KEY_USAGE_COPY;\0A\0A    int want_private = !(usage == PSA_KEY_USAGE_VERIFY_MESSAGE ||\0A                         usage == PSA_KEY_USAGE_VERIFY_HASH ||\0A                         usage == PSA_KEY_USAGE_ENCRYPT);\0A\0A    switch (pk_type) {\0A#if defined(MBEDTLS_RSA_C)\0A        case MBEDTLS_PK_RSA:\0A        {\0A            int want_crypt = 0; /* 0: sign/verify; 1: encrypt/decrypt */\0A            switch (usage) {\0A                case PSA_KEY_USAGE_SIGN_MESSAGE:\0A                case PSA_KEY_USAGE_SIGN_HASH:\0A                case PSA_KEY_USAGE_VERIFY_MESSAGE:\0A                case PSA_KEY_USAGE_VERIFY_HASH:\0A                    /* Nothing to do. */\0A                    break;\0A                case PSA_KEY_USAGE_DECRYPT:\0A                case PSA_KEY_USAGE_ENCRYPT:\0A                    want_crypt = 1;\0A                    break;\0A                default:\0A                    return MBEDTLS_ERR_PK_TYPE_MISMATCH;\0A            }\0A            /* Detect the presence of a private key in a way that works both\0A             * in CRT and non-CRT configurations. */\0A            mbedtls_rsa_context *rsa = mbedtls_pk_rsa(*pk);\0A            int has_private = (mbedtls_rsa_check_privkey(rsa) == 0);\0A            if (want_private && !has_private) {\0A                return MBEDTLS_ERR_PK_TYPE_MISMATCH;\0A            }\0A            psa_set_key_type(attributes, (want_private ?\0A                                          PSA_KEY_TYPE_RSA_KEY_PAIR :\0A                                          PSA_KEY_TYPE_RSA_PUBLIC_KEY));\0A            psa_set_key_bits(attributes, mbedtls_pk_get_bitlen(pk));\0A            psa_set_key_algorithm(attributes,\0A                                  psa_algorithm_for_rsa(rsa, want_crypt));\0A            break;\0A        }\0A#endif /* MBEDTLS_RSA_C */\0A\0A#if defined(MBEDTLS_PK_HAVE_ECC_KEYS)\0A        case MBEDTLS_PK_ECKEY:\0A        case MBEDTLS_PK_ECKEY_DH:\0A        case MBEDTLS_PK_ECDSA:\0A        {\0A            int sign_ok = (pk_type != MBEDTLS_PK_ECKEY_DH);\0A            int derive_ok = (pk_type != MBEDTLS_PK_ECDSA);\0A#if defined(MBEDTLS_PK_USE_PSA_EC_DATA)\0A            psa_ecc_family_t family = pk->ec_family;\0A            size_t bits = pk->ec_bits;\0A            int has_private = 0;\0A            if (pk->priv_id != MBEDTLS_SVC_KEY_ID_INIT) {\0A                has_private = 1;\0A            }\0A#else\0A            const mbedtls_ecp_keypair *ec = mbedtls_pk_ec_ro(*pk);\0A            int has_private = (ec->d.n != 0);\0A            size_t bits = 0;\0A            psa_ecc_family_t family =\0A                mbedtls_ecc_group_to_psa(ec->grp.id, &bits);\0A#endif\0A            psa_algorithm_t alg = 0;\0A            switch (usage) {\0A                case PSA_KEY_USAGE_SIGN_MESSAGE:\0A                case PSA_KEY_USAGE_SIGN_HASH:\0A                case PSA_KEY_USAGE_VERIFY_MESSAGE:\0A                case PSA_KEY_USAGE_VERIFY_HASH:\0A                    if (!sign_ok) {\0A                        return MBEDTLS_ERR_PK_TYPE_MISMATCH;\0A                    }\0A#if defined(MBEDTLS_ECDSA_DETERMINISTIC)\0A                    alg = PSA_ALG_DETERMINISTIC_ECDSA(PSA_ALG_ANY_HASH);\0A#else\0A                    alg = PSA_ALG_ECDSA(PSA_ALG_ANY_HASH);\0A#endif\0A                    break;\0A                case PSA_KEY_USAGE_DERIVE:\0A                    alg = PSA_ALG_ECDH;\0A                    if (!derive_ok) {\0A                        return MBEDTLS_ERR_PK_TYPE_MISMATCH;\0A                    }\0A                    break;\0A                default:\0A                    return MBEDTLS_ERR_PK_TYPE_MISMATCH;\0A            }\0A            if (want_private && !has_private) {\0A                return MBEDTLS_ERR_PK_TYPE_MISMATCH;\0A            }\0A            psa_set_key_type(attributes, (want_private ?\0A                                          PSA_KEY_TYPE_ECC_KEY_PAIR(family) :\0A                                          PSA_KEY_TYPE_ECC_PUBLIC_KEY(family)));\0A            psa_set_key_bits(attributes, bits);\0A            psa_set_key_algorithm(attributes, alg);\0A            break;\0A        }\0A#endif /* MBEDTLS_PK_HAVE_ECC_KEYS */\0A\0A#if defined(MBEDTLS_PK_RSA_ALT_SUPPORT)\0A        case MBEDTLS_PK_RSA_ALT:\0A            return MBEDTLS_ERR_PK_FEATURE_UNAVAILABLE;\0A#endif /* MBEDTLS_PK_RSA_ALT_SUPPORT */\0A\0A#if defined(MBEDTLS_USE_PSA_CRYPTO)\0A        case MBEDTLS_PK_OPAQUE:\0A        {\0A            psa_key_attributes_t old_attributes = PSA_KEY_ATTRIBUTES_INIT;\0A            psa_status_t status = PSA_ERROR_CORRUPTION_DETECTED;\0A            status = psa_get_key_attributes(pk->priv_id, &old_attributes);\0A            if (status != PSA_SUCCESS) {\0A                return MBEDTLS_ERR_PK_BAD_INPUT_DATA;\0A            }\0A            psa_key_type_t old_type = psa_get_key_type(&old_attributes);\0A            switch (usage) {\0A                case PSA_KEY_USAGE_SIGN_MESSAGE:\0A                case PSA_KEY_USAGE_SIGN_HASH:\0A                case PSA_KEY_USAGE_VERIFY_MESSAGE:\0A                case PSA_KEY_USAGE_VERIFY_HASH:\0A                    if (!(PSA_KEY_TYPE_IS_ECC_KEY_PAIR(old_type) ||\0A                          old_type == PSA_KEY_TYPE_RSA_KEY_PAIR)) {\0A                        return MBEDTLS_ERR_PK_TYPE_MISMATCH;\0A                    }\0A                    break;\0A                case PSA_KEY_USAGE_DECRYPT:\0A                case PSA_KEY_USAGE_ENCRYPT:\0A                    if (old_type != PSA_KEY_TYPE_RSA_KEY_PAIR) {\0A                        return MBEDTLS_ERR_PK_TYPE_MISMATCH;\0A                    }\0A                    break;\0A                case PSA_KEY_USAGE_DERIVE:\0A                    if (!(PSA_KEY_TYPE_IS_ECC_KEY_PAIR(old_type))) {\0A                        return MBEDTLS_ERR_PK_TYPE_MISMATCH;\0A                    }\0A                    break;\0A                default:\0A                    return MBEDTLS_ERR_PK_TYPE_MISMATCH;\0A            }\0A            psa_key_type_t new_type = old_type;\0A            /* Opaque keys are always key pairs, so we don't need a check\0A             * on the input if the required usage is private. We just need\0A             * to adjust the type correctly if the required usage is public. */\0A            if (!want_private) {\0A                new_type = PSA_KEY_TYPE_PUBLIC_KEY_OF_KEY_PAIR(new_type);\0A            }\0A            more_usage = psa_get_key_usage_flags(&old_attributes);\0A            if ((usage & more_usage) == 0) {\0A                return MBEDTLS_ERR_PK_TYPE_MISMATCH;\0A            }\0A            psa_set_key_type(attributes, new_type);\0A            psa_set_key_bits(attributes, psa_get_key_bits(&old_attributes));\0A            psa_set_key_algorithm(attributes, psa_get_key_algorithm(&old_attributes));\0A            break;\0A        }\0A#endif /* MBEDTLS_USE_PSA_CRYPTO */\0A\0A        default:\0A            return MBEDTLS_ERR_PK_BAD_INPUT_DATA;\0A    }\0A\0A    psa_set_key_usage_flags(attributes, more_usage);\0A    /* Key's enrollment is available only when an Mbed TLS implementation of PSA\0A     * Crypto is being used, i.e. when MBEDTLS_PSA_CRYPTO_C is defined.\0A     * Even tho