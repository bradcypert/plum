@.str39127 = private global { i64, i64, [12830 x i8] } { i64 -1, i64 12829, [12830 x i8] c"/**\0A * \5Cfile ecjpake.h\0A *\0A * \5Cbrief Elliptic curve J-PAKE\0A */\0A/*\0A *  Copyright The Mbed TLS Contributors\0A *  SPDX-License-Identifier: Apache-2.0 OR GPL-2.0-or-later\0A */\0A#ifndef MBEDTLS_ECJPAKE_H\0A#define MBEDTLS_ECJPAKE_H\0A#include \22mbedtls/private_access.h\22\0A\0A/*\0A * J-PAKE is a password-authenticated key exchange that allows deriving a\0A * strong shared secret from a (potentially low entropy) pre-shared\0A * passphrase, with forward secrecy and mutual authentication.\0A * https://en.wikipedia.org/wiki/Password_Authenticated_Key_Exchange_by_Juggling\0A *\0A * This file implements the Elliptic Curve variant of J-PAKE,\0A * as defined in Chapter 7.4 of the Thread v1.0 Specification,\0A * available to members of the Thread Group http://threadgroup.org/\0A *\0A * As the J-PAKE algorithm is inherently symmetric, so is our API.\0A * Each party needs to send its first round message, in any order, to the\0A * other party, then each sends its second round message, in any order.\0A * The payloads are serialized in a way suitable for use in TLS, but could\0A * also be use outside TLS.\0A */\0A#include \22mbedtls/build_info.h\22\0A\0A#include \22mbedtls/ecp.h\22\0A#include \22mbedtls/md.h\22\0A\0A#ifdef __cplusplus\0Aextern \22C\22 {\0A#endif\0A\0A/**\0A * Roles in the EC J-PAKE exchange\0A */\0Atypedef enum {\0A    MBEDTLS_ECJPAKE_CLIENT = 0,         /**< Client                         */\0A    MBEDTLS_ECJPAKE_SERVER,             /**< Server                         */\0A    MBEDTLS_ECJPAKE_NONE,               /**< Undefined                      */\0A} mbedtls_ecjpake_role;\0A\0A#if !defined(MBEDTLS_ECJPAKE_ALT)\0A/**\0A * EC J-PAKE context structure.\0A *\0A * J-PAKE is a symmetric protocol, except for the identifiers used in\0A * Zero-Knowledge Proofs, and the serialization of the second message\0A * (KeyExchange) as defined by the Thread spec.\0A *\0A * In order to benefit from this symmetry, we choose a different naming\0A * convention from the Thread v1.0 spec. Correspondence is indicated in the\0A * description as a pair C: client name, S: server name\0A */\0Atypedef struct mbedtls_ecjpake_context {\0A    mbedtls_md_type_t MBEDTLS_PRIVATE(md_type);          /**< Hash to use                    */\0A    mbedtls_ecp_group MBEDTLS_PRIVATE(grp);              /**< Elliptic curve                 */\0A    mbedtls_ecjpake_role MBEDTLS_PRIVATE(role);          /**< Are we client or server?       */\0A    int MBEDTLS_PRIVATE(point_format);                   /**< Format for point export        */\0A\0A    mbedtls_ecp_point MBEDTLS_PRIVATE(Xm1);              /**< My public key 1   C: X1, S: X3 */\0A    mbedtls_ecp_point MBEDTLS_PRIVATE(Xm2);              /**< My public key 2   C: X2, S: X4 */\0A    mbedtls_ecp_point MBEDTLS_PRIVATE(Xp1);              /**< Peer public key 1 C: X3, S: X1 */\0A    mbedtls_ecp_point MBEDTLS_PRIVATE(Xp2);              /**< Peer public key 2 C: X4, S: X2 */\0A    mbedtls_ecp_point MBEDTLS_PRIVATE(Xp);               /**< Peer public key   C: Xs, S: Xc */\0A\0A    mbedtls_mpi MBEDTLS_PRIVATE(xm1);                    /**< My private key 1  C: x1, S: x3 */\0A    mbedtls_mpi MBEDTLS_PRIVATE(xm2);                    /**< My private key 2  C: x2, S: x4 */\0A\0A    mbedtls_mpi MBEDTLS_PRIVATE(s);                      /**< Pre-shared secret (passphrase) */\0A} mbedtls_ecjpake_context;\0A\0A#else  /* MBEDTLS_ECJPAKE_ALT */\0A#include \22ecjpake_alt.h\22\0A#endif /* MBEDTLS_ECJPAKE_ALT */\0A\0A/**\0A * \5Cbrief           Initialize an ECJPAKE context.\0A *\0A * \5Cparam ctx       The ECJPAKE context to initialize.\0A *                  This must not be \5Cc NULL.\0A */\0Avoid mbedtls_ecjpake_init(mbedtls_ecjpake_context *ctx);\0A\0A/**\0A * \5Cbrief           Set up an ECJPAKE context for use.\0A *\0A * \5Cnote            Currently the only values for hash/curve allowed by the\0A *                  standard are #MBEDTLS_MD_SHA256/#MBEDTLS_ECP_DP_SECP256R1.\0A *\0A * \5Cparam ctx       The ECJPAKE context to set up. This must be initialized.\0A * \5Cparam role      The role of the caller. This must be either\0A *                  #MBEDTLS_ECJPAKE_CLIENT or #MBEDTLS_ECJPAKE_SERVER.\0A * \5Cparam hash      The identifier of the hash function to use,\0A *                  for example #MBEDTLS_MD_SHA256.\0A * \5Cparam curve     The identifier of the elliptic curve to use,\0A *                  for example #MBEDTLS_ECP_DP_SECP256R1.\0A * \5Cparam secret    The pre-shared secret (passphrase). This must be\0A *                  a readable not empty buffer of length \5Cp len Bytes. It need\0A *                  only be valid for the duration of this call.\0A * \5Cparam len       The length of the pre-shared secret \5Cp secret.\0A *\0A * \5Creturn          \5Cc 0 if successful.\0A * \5Creturn          A negative error code on failure.\0A */\0Aint mbedtls_ecjpake_setup(mbedtls_ecjpake_context *ctx,\0A                          mbedtls_ecjpake_role role,\0A                          mbedtls_md_type_t hash,\0A                          mbedtls_ecp_group_id curve,\0A                          const unsigned char *secret,\0A                          size_t len);\0A\0A/**\0A * \5Cbrief               Set the point format for future reads and writes.\0A *\0A * \5Cparam ctx           The ECJPAKE context to configure.\0A * \5Cparam point_format  The point format to use:\0A *                      #MBEDTLS_ECP_PF_UNCOMPRESSED (default)\0A *                      or #MBEDTLS_ECP_PF_COMPRESSED.\0A *\0A * \5Creturn              \5Cc 0 if successful.\0A * \5Creturn              #MBEDTLS_ERR_ECP_BAD_INPUT_DATA if \5Cp point_format\0A *                      is invalid.\0A */\0Aint mbedtls_ecjpake_set_point_format(mbedtls_ecjpake_context *ctx,\0A                                     int point_format);\0A\0A/**\0A * \5Cbrief           Check if an ECJPAKE context is ready for use.\0A *\0A * \5Cparam ctx       The ECJPAKE context to check. This must be\0A *                  initialized.\0A *\0A * \5Creturn          \5Cc 0 if the context is ready for use.\0A * \5Creturn          #MBEDTLS_ERR_ECP_BAD_INPUT_DATA otherwise.\0A */\0Aint mbedtls_ecjpake_check(const mbedtls_ecjpake_context *ctx);\0A\0A/**\0A * \5Cbrief           Generate and write the first round message\0A *                  (TLS: contents of the Client/ServerHello extension,\0A *                  excluding extension type and length bytes).\0A *\0A * \5Cparam ctx       The ECJPAKE context to use. This must be\0A *                  initialized and set up.\0A * \5Cparam buf       The buffer to write the contents to. This must be a\0A *                  writable buffer of length \5Cp len Bytes.\0A * \5Cparam len       The length of \5Cp buf in Bytes.\0A * \5Cparam olen      The address at which to store the total number\0A *                  of Bytes written to \5Cp buf. This must not be \5Cc NULL.\0A * \5Cparam f_rng     The RNG function to use. This must not be \5Cc NULL.\0A * \5Cparam p_rng     The RNG parameter to be passed to \5Cp f_rng. This\0A *                  may be \5Cc NULL if \5Cp f_rng doesn't use a context.\0A *\0A * \5Creturn          \5Cc 0 if successful.\0A * \5Creturn          A negative error code on failure.\0A */\0Aint mbedtls_ecjpake_write_round_one(mbedtls_ecjpake_context *ctx,\0A                                    unsigned char *buf, size_t len, size_t *olen,\0A                                    int (*f_rng)(void *, unsigned char *, size_t),\0A                                    void *p_rng);\0A\0A/**\0A * \5Cbrief           Read and process the first round message\0A *                  (TLS: contents of the Client/ServerHello extension,\0A *                  excluding extension type and length bytes).\0A *\0A * \5Cparam ctx       The ECJPAKE context to use. This must be initialized\0A *                  and set up.\0A * \5Cparam buf       The buffer holding the first round message. This must\0A *                  be a readable buffer of length \5Cp len Bytes.\0A * \5Cparam len       The length in Bytes of \5Cp buf.\0A *\0A * \5Creturn          \5Cc 0 if successful.\0A * \5Creturn          A negative error code on failure.\0A */\0Aint mbedtls_ecjpake_read_round_one(mbedtls_ecjpake_context *ctx,\0A                                   const unsigned char *buf,\0A                                   size_t len);\0A\0A/**\0A * \5Cbrief           Generate and write the second round message\0A *                  (TLS: contents of the Client/ServerKeyExchange).\0A *\0A * \5Cparam ctx       The ECJPAKE context to use. This must be initialized,\0A *                  set up, and already have performed round one.\0A * \5Cparam buf       The buffer to write the round two contents to.\0A *                  This must be a writable buffer of length \5Cp len Bytes.\0A * \5Cparam len       The size of \5Cp buf in Bytes.\0A * \5Cparam olen      The address at which to store the total number of Bytes\0A *                  written to \5Cp buf. This must not be \5Cc NULL.\0A * \5Cparam f_rng     The RNG function to use. This must not be \5Cc NULL.\0A * \5Cparam p_rng     The RNG parameter to be passed to \5Cp f_rng. This\0A *                  may be \5Cc NULL if \5Cp f_rng doesn't use a context.\0A *\0A * \5Creturn          \5Cc 0 if successful.\0A * \5Creturn          A negative error code on failure.\0A */\0Aint mbedtls_ecjpake_write_round_two(mbedtls_ecjpake_context *ctx,\0A                                    unsigned char *buf, size_t len, size_t *olen,\0A                                    int (*f_rng)(void *, unsigned char *, size_t),\0A                                    void *p_rng);\0A\0A/**\0A * \5Cbrief           Read and process the second round message\0A *                  (TLS: contents of the Client/ServerKeyExchange).\0A *\0A * \5Cparam ctx       The ECJPAKE context to use. This must be initialized\0A *                  and set up and already have performed round one.\0A * \5Cparam buf       The buffer holding the second round message. This must\0A *                  be a readable buffer of length \5Cp len Bytes.\0A * \5Cparam len       The length in Bytes of \5Cp buf.\0A *\0A * \5Creturn          \5Cc 0 if successful.\0A * \5Creturn          A negative error code on failure.\0A */\0Aint mbedtls_ecjpake_read_round_two(mbedtls_ecjpake_context *ctx,\0A                                   const unsigned char *buf,\0A                                   size_t len);\0A\0A/**\0A * \5Cbrief           Derive the shared secret\0A *                  (TLS: Pre-Master Secret).\0A *\0A * \5Cparam ctx       The ECJPAKE context to use. This must be initialized,\0A *                  set up and have performed both round one and two.\0A * \5Cparam buf       The buffer to write the derived secret to. This must\0A *                  be a writable buffer of length \5Cp len Bytes.\0A * \5Cparam len       The length of \5Cp buf in Bytes.\0A * \5Cparam olen      The address at which to store the total number of Bytes\0A *                  written to \5Cp buf. This must not be \5Cc NULL.\0A * \5Cparam f_rng     The RNG function to use. This must not be \5Cc NULL.\0A * \5Cparam p_rng     The RNG parameter to be passed to \5Cp f_rng. This\0A *                  may be \5Cc NULL if \5Cp f_rng doesn't use a context.\0A *\0A * \5Creturn          \5Cc 0 if successful.\0A * \5Creturn          A negative error code on failure.\0A */\0Aint mbedtls_ecjpake_derive_secret(mbedtls_ecjpake_context *ctx,\0A                                  unsigned char *buf, size_t len, size_t *olen,\0A                                  int (*f_rng)(void *, unsigned char *, size_t),\0A                                  void *p_rng);\0A\0A/**\0A * \5Cbrief           Write the shared key material to be passed to a Key\0A *                  Derivation Function as described in RFC8236.\0A *\0A * \5Cparam ctx       The ECJPAKE context to use. This must be initialized,\0A *                  set up and have performed both round one and two.\0A * \5Cparam buf       The buffer to write the derived secret to. This must\0A *                  be a writable buffer of length \5Cp len Bytes.\0A * \5Cparam len       The length of \5Cp buf in Bytes.\0A * \5Cparam olen      The address at which to store the total number of bytes\0A *                  written to \5Cp buf. This must not be \5Cc NULL.\0A * \5Cparam f_rng     The RNG function to use. This must not be \5Cc NULL.\0A * \5Cparam p_rng     The RNG parameter to be passed to \5Cp f_rng. This\0A *                  may be \5Cc NULL if \5Cp f_rng doesn't use a context.\0A *\0A * \5Creturn          \5Cc 0 if successful.\0A * \5Creturn          A negative error code on failure.\0A */\0Aint mbedtls_ecjpake_write_shared_key(mbedtls_ecjpake_context *ctx,\0A                                     unsigned char *buf, size_t len, size_t *olen,\0A                                     int (*f_rng)(void *, unsigned char *, size_t),\0A                                     void *p_rng);\0A\0A/**\0A * \5Cbrief           This clears an ECJPAKE context and frees any\0A *                  embedded data structure.\0A *\0A * \5Cparam ctx       The ECJPAKE context to free. This may be \5Cc NULL,\0A *                  in which case this function does nothing. If it is not\0A *                  \5Cc NULL, it must point to an initialized ECJPAKE context.\0A */\0Avoid mbedtls_ecjpake_free(mbedtls_ecjpake_context *ctx);\0A\0A#if defined(MBEDTLS_SELF_TEST)\0A\0A/**\0A * \5Cbrief          Checkup routine\0A *\0A * \5Creturn         0 if successful, or 1 if a test failed\0A */\0Aint mbedtls_ecjpake_self_test(int verbose);\0A\0A#endif /* MBEDTLS_SELF_TEST */\0A\0A#ifdef __cplusplus\0A}\0A#endif\0A\0A\0A#endif /* ecjpake.h */\0A\00" }
