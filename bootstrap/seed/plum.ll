@.str58228 = private global { i64, i64, [33542 x i8] } { i64 -1, i64 33541, [33542 x i8] c"/// One header. `name` is as it appeared on the wire; header names are\0A/// case-insensitive in HTTP, so compare with care.\0Apub struct Header { pub name: String, pub value: String }\0A/// A complete response: status, headers, and the whole body.\0Apub struct Response { pub status: Int, pub headers: Array[Header], pub body: String }\0A/// A response's head, before the body has been read.\0A///\0A/// `leftover_body` is whatever arrived in the same read as the headers\0A/// — a body does not begin on a tidy packet boundary, so those bytes\0A/// have to be handed on rather than dropped.\0Apub struct Head { pub status: Int, pub headers: Array[Header], pub leftover_body: String }\0A/// An incoming request, as a handler receives it.\0Apub struct Request { pub method: String, pub path: String, pub headers: Array[Header], pub body: String }\0A/// A request's first line, split.\0Apub struct RequestLine { pub method: String, pub path: String }\0A/// A request's head, before its body has been read. `leftover_body`\0A/// carries the bytes that arrived alongside the headers.\0Apub struct RequestHead { pub method: String, pub path: String, pub headers: Array[Header], pub leftover_body: String }\0A\0Aextern \22C\22 {\0A    fn tls_connect(host: CStr, port: Int) -> Int;\0A    fn tls_send(handle: Int, buf: CStr, len: Int) -> Int;\0A    fn tls_recv_n(handle: Int, max_len: Int) -> Int;\0A    fn tls_recv_data() -> CStr;\0A    fn tls_close(handle: Int) -> Unit;\0A}\0A\0Alet http_tls_read (handle: Int) (max_len: Int): String = unsafe {\0A    let n = tls_recv_n(handle, max_len);\0A    if n <= 0 { \22\22 } else { tls_recv_data().as_string() }\0A}\0A\0Alet http_tls_write (handle: Int) (data: String): Result[Int, String] = unsafe {\0A    let len = data.len();\0A    let n = tls_send(handle, data.as_cstr(), len);\0A    if n < 0 { Err(\22https client: write failed\22) } else { Ok(n) }\0A}\0A\0A/// URL pa