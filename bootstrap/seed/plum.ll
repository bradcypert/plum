@.str39237 = private global { i64, i64, [8003 x i8] } { i64 -1, i64 8002, [8003 x i8] c"/**\0A * \5Cfile platform_util.h\0A *\0A * \5Cbrief Common and shared functions used by multiple modules in the Mbed TLS\0A *        library.\0A */\0A/*\0A *  Copyright The Mbed TLS Contributors\0A *  SPDX-License-Identifier: Apache-2.0 OR GPL-2.0-or-later\0A */\0A#ifndef MBEDTLS_PLATFORM_UTIL_H\0A#define MBEDTLS_PLATFORM_UTIL_H\0A\0A#include \22mbedtls/build_info.h\22\0A\0A#include <stddef.h>\0A#if defined(MBEDTLS_HAVE_TIME_DATE)\0A#include \22mbedtls/platform_time.h\22\0A#include <time.h>\0A#endif /* MBEDTLS_HAVE_TIME_DATE */\0A\0A#ifdef __cplusplus\0Aextern \22C\22 {\0A#endif\0A\0A/* Internal helper macros for deprecating API constants. */\0A#if !defined(MBEDTLS_DEPRECATED_REMOVED)\0A#if defined(MBEDTLS_DEPRECATED_WARNING)\0A#define MBEDTLS_DEPRECATED __attribute__((deprecated))\0AMBEDTLS_DEPRECATED typedef char const *mbedtls_deprecated_string_constant_t;\0A#define MBEDTLS_DEPRECATED_STRING_CONSTANT(VAL)       \5C\0A    ((mbedtls_deprecated_string_constant_t) (VAL))\0AMBEDTLS_DEPRECATED typedef int mbedtls_deprecated_numeric_constant_t;\0A#define MBEDTLS_DEPRECATED_NUMERIC_CONSTANT(VAL)       \5C\0A    ((mbedtls_deprecated_numeric_constant_t) (VAL))\0A#else /* MBEDTLS_DEPRECATED_WARNING */\0A#define MBEDTLS_DEPRECATED\0A#define MBEDTLS_DEPRECATED_STRING_CONSTANT(VAL) VAL\0A#define MBEDTLS_DEPRECATED_NUMERIC_CONSTANT(VAL) VAL\0A#endif /* MBEDTLS_DEPRECATED_WARNING */\0A#endif /* MBEDTLS_DEPRECATED_REMOVED */\0A\0A/* Implementation of the check-return facility.\0A * See the user documentation in mbedtls_config.h.\0A *\0A * Do not use this macro directly to annotate function: instead,\0A * use one of MBEDTLS_CHECK_RETURN_CRITICAL or MBEDTLS_CHECK_RETURN_TYPICAL\0A * depending on how important it is to check the return value.\0A */\0A#if !defined(MBEDTLS_CHECK_RETURN)\0A#if defined(__GNUC__)\0A#define MBEDTLS_CHECK_RETURN __attribute__((__warn_unused_result__))\0A#elif defined(_MSC_VER) && _MSC_VER >= 1700\0A#include <sal.h>\0A#define MBEDTLS_CHECK_RETURN _Check_return_\0A#else\0A#define MBEDTLS_CHECK_RETURN\0A#endif\0A#endif\0A\0A/** Critical-failure function\0A *\0A * This macro appearing at the beginning of the declaration of a function\0A * indicates that its return value should be checked in all applications.\0A * Omitting the check is very likely to indicate a bug in the application\0A * and will result in a compile-time warning if #MBEDTLS_CHECK_RETURN\0A * is implemented for the compiler in use.\0A *\0A * \5Cnote  The use of this macro is a work in progress.\0A *        This macro may be added to more functions in the future.\0A *        Such an extension is not considered an API break, provided that\0A *        there are near-unavoidable circumstances under which the function\0A *        can fail. For example, signature/MAC/AEAD verification functions,\0A *        and functions that require a random generator, are considered\0A *        return-check-critical.\0A */\0A#define MBEDTLS_CHECK_RETURN_CRITICAL MBEDTLS_CHECK_RETURN\0A\0A/** Ordinary-failure function\0A *\0A * This macro appearing at the beginning of the declaration of a function\0A * indicates that its return value should be generally be checked in portable\0A * applications. Omitting the check will result in a compile-time warning if\0A * #MBEDTLS_CHECK_RETURN is implemented for the compiler in use and\0A * #MBEDTLS_CHECK_RETURN_WARNING is enabled in the compile-time configuration.\0A *\0A * You can use #MBEDTLS_IGNORE_RETURN to explicitly ignore the return value\0A * of a function that is annotated with #MBEDTLS_CHECK_RETURN.\0A *\0A * \5Cnote  The use of this macro is a work in progress.\0A *        This macro will be added to more functions in the future.\0A *        Eventually this should appear before most functions returning\0A *        an error code (as \5Cc int in the \5Cc mbedtls_xxx API or\0A *        as ::psa_status_t in the \5Cc psa_xxx API).\0A */\0A#if defined(MBEDTLS_CHECK_RETURN_WARNING)\0A#define MBEDTLS_CHECK_RETURN_TYPICAL MBEDTLS_CHECK_RETURN\0A#else\0A#define MBEDTLS_CHECK_RETURN_TYPICAL\0A#endif\0A\0A/** Benign-failure function\0A *\0A * This macro appearing at the beginning of the declaration of a function\0A * indicates that it is rarely useful to check its return value.\0A *\0A * This macro has an empty expansion. It exists for documentation purposes:\0A * a #MBEDTLS_CHECK_RETURN_OPTIONAL annotation indicates that the function\0A * has been analyzed for return-check usefulness, whereas the lack of\0A * an annotation indicates that the function has not been analyzed and its\0A * return-check usefulness is unknown.\0A */\0A#define MBEDTLS_CHECK_RETURN_OPTIONAL\0A\0A/** \5Cdef MBEDTLS_IGNORE_RETURN\0A *\0A * Call this macro with one argument, a function call, to suppress a warning\0A * from #MBEDTLS_CHECK_RETURN due to that function call.\0A */\0A#if !defined(MBEDTLS_IGNORE_RETURN)\0A/* GCC doesn't silence the warning with just (void)(result).\0A * (void)!(result) is known to work up at least up to GCC 10, as well\0A * as with Clang and MSVC.\0A *\0A * https://gcc.gnu.org/onlinedocs/gcc-3.4.6/gcc/Non_002dbugs.html\0A * https://stackoverflow.com/questions/40576003/ignoring-warning-wunused-result\0A * https://gcc.gnu.org/bugzilla/show_bug.cgi?id=66425#c34\0A */\0A#define MBEDTLS_IGNORE_RETURN(result) ((void) !(result))\0A#endif\0A\0A/* If the following macro is defined, the library is being built by the test\0A * framework, and the framework is going to provide a replacement\0A * mbedtls_platform_zeroize() using a preprocessor macro, so the function\0A * declaration should be omitted.  */\0A#if !defined(MBEDTLS_TEST_DEFINES_ZEROIZE) //no-check-names\0A/**\0A * \5Cbrief       Securely zeroize a buffer\0A *\0A *              The function is meant to wipe the data contained in a buffer so\0A *              that it can no longer be recovered even if the program memory\0A *              is later compromised. Call this function on sensitive data\0A *              stored on the stack before returning from a function, and on\0A *              sensitive data stored on the heap before freeing the heap\0A *              object.\0A *\0A *              It is extremely difficult to guarantee that calls to\0A *              mbedtls_platform_zeroize() are not removed by aggressive\0A *              compiler optimizations in a portable way. For this reason, Mbed\0A *              TLS provides the configuration option\0A *              MBEDTLS_PLATFORM_ZEROIZE_ALT, which allows users to configure\0A *              mbedtls_platform_zeroize() to use a suitable implementation for\0A *              their platform and needs\0A *\0A * \5Cparam buf   Buffer to be zeroized\0A * \5Cparam len   Length of the buffer in bytes\0A *\0A */\0Avoid mbedtls_platform_zeroize(void *buf, size_t len);\0A#endif\0A\0A#if defined(MBEDTLS_HAVE_TIME_DATE)\0A/**\0A * \5Cbrief      Platform-specific implementation of gmtime_r()\0A *\0A *             The function is a thread-safe abstraction that behaves\0A *             similarly to the gmtime_r() function from Unix/POSIX.\0A *\0A *             Mbed TLS will try to identify the underlying platform and\0A *             make use of an appropriate underlying implementation (e.g.\0A *             gmtime_r() for POSIX and gmtime_s() for Windows). If this is\0A *             not possible, then gmtime() will be used. In this case, calls\0A *             from the library to gmtime() will be guarded by the mutex\0A *             mbedtls_threading_gmtime_mutex if MBEDTLS_THREADING_C is\0A *             enabled. It is recommended that calls from outside the library\0A *             are also guarded by this mutex.\0A *\0A *             If MBEDTLS_PLATFORM_GMTIME_R_ALT is defined, then Mbed TLS will\0A *             unconditionally use the alternative implementation for\0A *             mbedtls_platform_gmtime_r() supplied by the user at compile time.\0A *\0A * \5Cparam tt     Pointer to an object containing time (in seconds) since the\0A *               epoch to be converted\0A * \5Cparam tm_buf Pointer to an object where the results will be stored\0A *\0A * \5Creturn      Pointer to an object of type struct tm on success, otherwise\0A *              NULL\0A */\0Astruct tm *mbedtls_platform_gmtime_r(const mbedtls_time_t *tt,\0A                                     struct tm *tm_buf);\0A#endif /* MBEDTLS_HAVE_TIME_DATE */\0A\0A#ifdef __cplusplus\0A}\0A#endif\0A\0A#endif /* MBEDTLS_PLATFORM_UTIL_H */\0A\00" }
