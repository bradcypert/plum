uckets[idx].push(entry));\0A        }\0A    };\0A    Map { buckets: new_buckets, size: m.size }\0A}\0A\0A/// A NEW map with `k` set to `v`, replacing any previous value. The\0A/// original is unchanged.\0Apub let Map.insert[K: Eq + Hash, V] (m: Map[K, V]) (k: K) (v: V): Map[K, V] = {\0A    let idx = map_bucket_index(k, m.buckets.len());\0A    let bucket = m.buckets[idx];\0A    let existing_i = map_bucket_find_index(bucket, k, 0);\0A    let inserted = if existing_i >= 0 {\0A        Map { buckets: m.buckets.set(idx, bucket.set(existing_i, MapEntry { key: k, value: v })), size: m.size }\0A    } else {\0A        Map { buckets: m.buckets.set(idx, bucket.push(MapEntry { key: k, value: v })), size: m.size + 1 }\0A    };\0A    if inserted.size * MAP_LOAD_FACTOR_DEN > inserted.buckets.len() * MAP_LOAD_FACTOR_NUM {\0A        map_rehash(inserted, inserted.buckets.len() * 2)\0A    } else {\0A        inserted\0A    }\0A}\0A\0A/// The value for `k`, or `None`.\0Apub let Map.get[K: Eq + Hash, V] (m: Map[K, V]) (k: K): Option[V] = {\0A    let bucket = m.buckets[map_bucket_index(k, m.buckets.len())];\0A    let i = map_bucket_find_index(bucket, k, 0);\0A    if i >= 0 { Some(bucket[i].value) } else { None }\0A}\0A\0A/// Whether `k` has a value.\0Apub let Map.contains[K: Eq + Hash, V] (m: Map[K, V]) (k: K): Bool =\0A    map_bucket_find_index(m.buckets[map_bucket_index(k, m.buckets.len())], k, 0) >= 0\0A\0A/// A new map without `k`. Removing an absent key is not an error.\0Apub let Map.remove[K: Eq + Hash, V] (m: Map[K, V]) (k: K): Map[K, V] = {\0A    let idx = map_bucket_index(k, m.buckets.len());\0A    let bucket = m.buckets[idx];\0A    let i = map_bucket_find_index(bucket, k, 0);\0A    if i >= 0 { Map { buckets: m.buckets.set(idx, bucket.remove(i)), size: m.size - 1 } } else { m }\0A}\0A\0A/// How many entries.\0Apub let Map.len[K, V] (m: Map[K, V]): Int = m.size\0A\0A/// Every key, in no particular order — buckets, not insertion order.\0Apub let Map.keys[K, V] (m: Map[K, V]): Array[K] = {\0A    let mut acc = [];\0A    for bucket in m.buckets { for entry in bucket { acc = acc.push(entry.key); } };\0A    acc\0A}\0A\0A/// Every value, in the same order as `Map.keys`.\0Apub let Map.values[K, V] (m: Map[K, V]): Array[V] = {\0A    let mut acc = [];\0A    for bucket in m.buckets { for entry in bucket { acc = acc.push(entry.value); } };\0A    acc\0A}\0A\0Alet map_from_arrays_acc[K: Eq + Hash, V] (keys: Array[K]) (values: Array[V]) (i: Int) (acc: Map[K, V]): Map[K, V] =\0A    if i >= keys.len() { acc } else { map_from_arrays_acc(keys, values, i + 1, Map.insert(acc, keys[i], values[i])) }\0A/// A map from parallel arrays, stopping at the shorter. A repeated\0A/// key keeps the LAST value.\0Apub let Map.from_arrays[K: Eq + Hash, V] (keys: Array[K]) (values: Array[V]): Map[K, V] = map_from_arrays_acc(keys, values, 0, Map.new(()))\0A\0A/// A set of `T`, persistent like `Map` — `Set.insert` returns a new\0A/// set. Members need `Eq` and `Hash`. Equal keys hash identically.\0A/// NaN is not a supported key, including inside aggregates, because\0A/// IEEE equality makes it unequal to itself. References use identity.\0Apub struct Set[T] { inner: Map[T, Unit] }\0A\0A/// An empty set.\0Apub let Set.new[T] (): Set[T] = Set { inner: Map.new(()) }\0A/// A new set with `x` added. Adding a member twice changes nothing.\0Apub let Set.insert[T: Eq + Hash] (s: Set[T]) (x: T): Set[T] = Set { inner: Map.insert(s.inner, x, ()) }\0A/// Whether `x` is a member.\0Apub let Set.contains[T: Eq + Hash] (s: Set[T]) (x: T): Bool = Map.contains(s.inner, x)\0A/// A new set without `x`.\0Apub let Set.remove[T: Eq + Hash] (s: Set[T]) (x: T): Set[T] = Set { inner: Map.remove(s.inner, x) }\0A/// How many members.\0Apub let Set.len[T] (s: Set[T]): Int = Map.len(s.inner)\0A/// Every member, in no particular order.\0Apub let Set.to_array[T] (s: Set[T]): Array[T] = Map.keys(s.inner)\0A\0A/// Everything in either set.\0Apub let Set.union[T: Eq + Hash] (a: Set[T]) (b: Set[T]): Set[T] = {\0A   