eader: Header) (name: String): Bool =\0A    header.name.len() == name.len() && http_ascii_equal(header.name.as_bytes(), name.as_bytes(), 0)\0A\0Alet http_find_header (headers: Array[Header]) (name: String): Option[String] =\0A    Option.map(Array.find(headers, |h| http_header_named(h, name)), |h| h.value)\0A\0A/// Splits the raw, already-fully-received header block (see `http_recv_\0A/// headers_acc` above) into the parsed status/headers plus whatever body\0A/// bytes rode along in the same read.\0Alet http_parse_head (raw: String): Result[Head, String] = {\0A    let sep_index = match String.index_of(raw, \22\5Cr\5Cn\5Cr\5Cn\22) { Some(i) => i, None => raw.len() };\0A    let leftover_body = if sep_index + 4 <= raw.len() { String.slice(raw, sep_index + 4, raw.len()) } else { \22\22 };\0A    let lines = String.slice(raw, 0, sep_index).split(\22\5Cr\5Cn\22);\0A    if lines.len() == 0 { Err(\22http client: empty response\22) }\0A    else { http_parse_status_line(lines[0]) |> Result.and_then(_, |status|\0A        Result.map(http_parse_headers(Array.drop(lines, 1)), |headers| Head {\0A            status: status, headers: headers, leftover_body: leftover_body,\0A        })) }\0A}\0A\0Alet http_recv_body_by_length_acc (fd: Int) (secure: Int) (acc: String) (remaining: Int): Result[String, String] =\0A    if remaining <= 0 { Ok(acc) }\0A    else {\0A        let chunk = if secure == 1 { http_tls_read(fd, remaining) } else { Net.read(fd, remaining) };\0A        if String.is_empty(chunk) { Err(\22http client: connection closed before the full response body was received\22) }\0A        else { http_recv_body_by_length_acc(fd, secure, acc.concat(chunk), remaining - chunk.len()) }\0A    }\0A\0Alet http_recv_body_until_close_acc (fd: Int) (secure: Int) (acc: String): String = {\0A    let chunk = if secure == 1 { http_tls_read(fd, 4096) } else { Net.read(fd, 4096) };\0A    if String.is_empty(chunk) { acc } else { http_recv_body_until_close_acc(fd, secure, acc.concat(chunk)) }\0A}\0A\0A/// Takes `headers`/`leftover_body` directly (not a whole `Head`) —\0A/// but, UNLIKE the rest of this module's shared parsing helpers, this\0A/// one is response-side ONLY, not reused for requests (see `http_read_\0A/// request_body` below for why the two genuinely differ, not just a\0A/// convenience split).\0Alet http_read_body (fd: Int) (secure: Int) (headers: Array[Header]) (leftover_body: String): Result[String, String] =\0A    match http_find_header(headers, \22Content-Length\22) {\0A        Some(cl) => match String.parse_int(cl) {\0A            Err(e) => Err(\22http: invalid Content-Length header: \22.concat(e)),\0A            Ok(content_length) => http_recv_body_by_length_acc(fd, secure, leftover_body, content_length - leftover_body.len()),\0A        },\0A        None => match http_find_header(headers, \22Transfer-Encoding\22) {\0A            Some(te) => Err(\22http: Transfer-Encoding (\22.concat(te).concat(\22) is not supported yet\22)),\0A            None => Ok(http_recv_body_until_close_acc(fd, secure, leftover_body)),\0A        },\0A    }\0A\0A/// The REQUEST-side sibling of `http_read_body` above — same `Content-\0A/// Length`/`Transfer-Encoding` handling, but a DELIBERATELY different\0A/// answer when NEITHER is present: an EMPTY body (`leftover_body` as-\0A/// is), never \22read until the connection closes.\22 Originally shared\0A/// `http_read_body` directly for both — a real, live DEADLOCK surfaced\0A/// exactly that assumption was wrong, not just imprecise: a bodyless\0A/// `GET` (no `Content-Length`, since there's no body to measure) has no\0A/// reason to ever close its OWN write side, so a server blocked\0A/// \22reading until close\22 on it hangs forever waiting for a body that\0A/// will never arrive — confirmed directly (a real test hung against a\0A/// real socket, root-caused by isolating each step with `println`\0A/// debugging until the exact hang site was found), not merely\0A/// theorized. The response side's OWN \22no length header -> read until\0A/// close\22 answer stays correct on ITS side: every request this client\0A/// sends already includes `Connection: close`, so that read is bounded\0A/// by the SERVER eventually closing once it's done writing — a\0A/// guarantee nothing analogous exists for on the request side.\0Alet http_read_request_body (fd: Int) (headers: Array[Header]) (leftover_body: String): Result[String, String] =\0A    match http_find_header(headers, \22Content-Length\22) {\0A        Some(cl) => match String.parse_int(cl) {\0A            Err(e) => Err(\22http: invalid Content-Length header: \22.concat(e)),\0A            Ok(content_length) => http_recv_body_by_length_acc(fd, 0, leftover_body, content_length - leftover_body.len()),\0A        },\0A        None => match http_find_header(headers, \22Transfer-Encoding\22) {\0A            Some(te) => Err(\22http: Transfer-Encoding (\22.concat(te).concat(\22) is not supported yet\22)),\0A            None => Ok(leftover_body),\0A        },\0A    }\0A\0A/// Pipe + `Result.and_then`/`Result.map`, not nested `match` — a\0A/// deliberate house-style adoption (see DESIGN.md's own \22?/early-return\0A/// sugar\22 section for the full writeup: real `?`-style early return\0A/// would need a language feature Plum doesn't have at all, `return`,\0A/// plus a `From`-style error-conversion mechanism the closed trait set\0A/// has no room for — this gets most of the real readability benefit\0A/// today, for free, confirmed by rewriting this exact chain both ways\0A/// and running BOTH against the real shipped counterpart before\0A/// choosing this one). `|ignored| ..` discards `tcp_write`'s own `Int`\0A/// (bytes-written count) — the next step doesn't need it, only that the\0A/// write succeeded at all.\0Alet http_do_request (fd: Int) (secure: Int) (wire: String): Result[Response, String] =\0A    (if secure == 1 { http_tls_write(fd, wire) } else { Net.write(fd, wire) })\0A        |> Result.and_then(_, |ignored| http_recv_headers_acc(fd, secure, \22\22))\0A        |> Result.and_then(_, http_parse_head)\0A        |> Result.and_then(_, |head| Result.map(http_read_body(fd, secure, head.headers, head.leftover_body), |response_body| Response { status: head.status, headers: head.headers, body: response_body }))\0A\0A/// Sends a request over HTTP or HTTPS. HTTPS verifies the peer's\0A/// certificate and hostname using the native TLS trust-store integration.\0A///\0A/// Invalid URL text, methods, header names, and header values return Err\0A/// before connecting. Methods and names must be nonempty ASCII tokens;\0A/// values may contain spaces, HTAB, and UTF-8, but no other ASCII controls\0A/// or DEL. Bodies are not subject to protocol-field validation.\0Apub let request (method: String) (url: String) (headers: Array[Header]) (body: String): Result[Response, String] =\0A    http_parse_url(url)\0A        |> Result.and_then(_, |parsed| http_build_request(method, parsed, headers, body)\0A            |> Result.and_then(_, |wire| if parsed.scheme == \22https\22 {\0A                let fd = unsafe { tls_connect(parsed.host.as_cstr(), parsed.port) };\0A                if fd < 0 { Err(\22https client: TLS connection failed\22) }\0A                else { let result = http_do_request(fd, 1, wire); unsafe { tls_close(fd) }; result }\0A            } else {\0A                Net.connect_to(parsed.host, parsed.port) |> Result.and_then(_, |fd| {\0A                    let result = http_do_request(fd, 0, wire);\0A                    Net.close(fd);\0A                    result\0A                })\0A            }))\0A\0A/// Fetches a URL and reads the whole response.\0A///\0A/// Supports both `http://` and `https://`; HTTPS uses the native TLS\0A/// transport with platform trust-store and hostname verification.\0A///\0A/// Redirects are NOT followed: a 301 or 302 comes back as itself, with\0A/// its `Location` header, so the caller decides. Following one changes\0A/// which host you are talking to, which is not a decision a library\0A/// should make quietly.\0Apub let get (url: String): Result[Response, String] = request(\22GET\22, url, [], \22\22)\0A\0A/// POSTs a body and reads the whole response. Sets `Content-Length`;\0A/// set `Content-Type` yourself if the server needs one.\0A///\0A/// Redirects are not followed — see `Http.get`.\0Apub let post (url: String) (body: String): Result[Response, String] = request(\22POST\22, url, [], body)\0A\0A// --- HTTP server ---\0A\0Alet http_parse_request_line (line: String): Result[RequestLine, String] = {\0A    let parts = line.split(\22 \22);\0A    if parts.len() != 3 { Err(\22http server: malformed request line\22) }\0A    else if !http_token_ok(parts[0]) || String.is_empty(parts[1]) || !http_text_ok_acc(parts[1].as_bytes(), 0, false) {\0A        Err(\22http server: malformed request line\22)\0A    } else if parts[2] != \22HTTP/1.1\22 && parts[2] != \22HTTP/1.0\22 {\0A        Err(\22http server: unsupported HTTP version\22)\0A    } else { Ok(RequestLine { method: parts[0], path: parts[1] }) }\0A}\0A\0Alet http_digit (c: Int): Bool = c >= 48 && c <= 57\0Alet http_hex (c: Int): Bool = http_digit(c) || (c >= 65 && c <= 70) || (c >= 97 && c <= 102)\0Alet http_reg_name_byte (c: Int): Bool =\0A    (c >= 65 && c <= 90) || (c >= 97 && c <= 122) || http_digit(c)\0A        || c == 45 || c == 46 || c == 95 || c == 126\0A        || c == 33 || c == 36 || c == 38 || c == 39 || c == 40 || c == 41\0A        || c == 42 || c == 43 || c == 44 || c == 59 || c == 61\0A\0Alet http_port_ok (b: Bytes) (i: Int): Bool =\0A    if i >= b.len() { true }\0A    else if http_digit(http_byte(b, i)) { http_port_ok(b, i + 1) } else { false }\0A\0Alet http_reg_name_ok (b: Bytes) (i: Int): Bool =\0A    if i >= b.len() { true }\0A    else if http_byte(b, i) == 58 { http_port_ok(b, i + 1) }\0A    else if http_byte(b, i) == 37 {\0A        if http_hex(http_byte(b, i + 1)) && http_hex(http_byte(b, i + 2)) { http_reg_name_ok(b, i + 3) } else { false }\0A    } else if http_reg_name_byte(http_byte(b, i)) { http_reg_name_ok(b, i + 1) } else { false }\0A\0Alet http_hex_ok (b: Bytes) (i: Int): Bool =\0A    if i >= b.len() { true }\0A    else if http_hex(http_byte(b, i)) { http_hex_ok(b, i + 1) } else { false }\0A\0A// IPv4 is special only as an IPv6 suffix: exactly four decimal octets,\0A// no leading zeroes. Elsewhere dotted text can also be a reg-name.\0Alet http_ipv4_ok (s: String): Bool = {\0A    let parts = s.split(\22.\22);\0A    parts.len() == 4 && Array.all(parts, |part| {\0A        let b = part.as_bytes();\0A        b.len() >= 1 && b.len() <= 3 && (b.len() == 1 || http_byte(b, 0) != 48)\0A            && http_port_ok(b, 0) && match String.parse_int(part) { Ok(n) => n <= 255, Err(_) => false }\0A    })\0A}\0A\0Alet http_ipv6_groups (parts: Array[String]) (i: Int) (allow_ipv4: Bool) (count: Int): Int =\0A    if i >= parts.len() { count }\0A    else {\0A        let part = parts[i];\0A        if allow_ipv4 && i == parts.len() - 1 && String.contains(part, \22.\22) {\0A            if http_ipv4_ok(part) { count + 2 } else { -1 }\0A        } else if part.len() >= 1 && part.len() <= 4 && http_hex_ok(part.as_bytes(), 0) {\0A            http_ipv6_groups(parts, i + 1, allow_ipv4, count + 1)\0A        } else { -1 }\0A    }\0A\0Alet http_ipv6_side (s: String) (allow_ipv4: Bool): Int =\0A    if String.is_empty(s) { 0 } else { http_ipv6_groups(s.split(\22:\22), 0, allow_ipv4, 0) }\0A\0Alet http_ipv6_ok (s: String): Bool =\0A    if s.len() > 45 { false }\0A    else { match String.index_of(s, \22::\22) {\0A        None => http_ipv6_side(s, true) == 8,\0A        Some(i) => {\0A            let left = http_ipv6_side(String.slice(s, 0, i), false);\0A            let right = http_ipv6_side(String.slice(s, i + 2, String.char_len(s)), true);\0A            left >= 0 && right >= 0 && left + right < 8\0A        },\0A    } }\0A\0Alet http_ipvfuture_tail (b: Bytes) (i: Int): Bool =\0A    if i >= b.len() { true }\0A    else if http_reg_name_byte(http_byte(b, i)) || http_byte(b, i) == 58 { http_ipvfuture_tail(b, i + 1) } else { false }\0A\0Alet http_ip_literal_ok (s: String): Bool =\0A    if String.starts_with(s, \22v\22) || String.starts_with(s, \22V\22) {\0A        match String.index_of(s, \22.\22) {\0A            None => false,\0A            Some(i) => i > 1 && i + 1 < s.len()\0A                && http_hex_ok(String.slice(s, 1, i).as_bytes(), 0)\0A                && http_ipvfuture_tail(s.as_bytes(), i + 1),\0A        }\0A    } else { http_ipv6_ok(s) }\0A\0A// RFC 9110 section 7.2 / RFC 3986: uri-host [ ':' port ]. This is\0A// syntax validation, not DNS resolution or a socket port-range check.\0A// Empty Host and empty port are legal grammar (RFC 9112 section 3.2).\0Alet http_host_ok (s: String): Bool =\0A    if String.starts_with(s, \22[\22) { match String.index_of(s, \22]\22) {\0A        None => false,\0A        Some(i) => {\0A            let b = s.as_bytes();\0A            http_ip_literal_ok(String.slice(s, 1, i))\0A                && (i + 1 == b.len() || (http_byte(b, i + 1) == 58 && http_port_ok(b, i + 2)))\0A        },\0A    } } else { http_reg_name_ok(s.as_bytes(), 0) }\0A\0Alet http_validate_host (headers: Array[Header]) (i: Int) (seen: Bool) (required: Bool): Result[Unit, String] =\0A    if i >= headers.len() {\0A        if required && !seen { Err(\22http server: missing Host header\22) } else { Ok(()) }\0A    } else if http_header_named(headers[i], \22Host\22) {\0A        if seen { Err(\22http server: duplicate Host header\22) }\0A        else if !http_host_ok(headers[i].value) { Err(\22http server: invalid Host header\22) }\0A        else { http_validate_host(headers, i + 1, true, required) }\0A    } else { http_validate_host(headers, i + 1, seen, required) }\0A\0A// Validate the complete head before exposing it to body reading. Keep the\0A// version local so the public RequestLine/RequestHead structs stay stable.\0Alet http_parse_request_head (raw: String): Result[RequestHead, String] =\0A    match String.index_of(raw, \22\5Cr\5Cn\5Cr\5Cn\22) {\0A        None => Err(\22http server: incomplete request head\22),\0A        Some(sep_index) => {\0A            let lines = String.slice(raw, 0, sep_index).split(\22\5Cr\5Cn\22);\0A            http_parse_request_line(lines[0]) |> Result.and_then(_, |rl|\0A                http_parse_headers(Array.drop(lines, 1)) |> Result.and_then(_, |headers|\0A                    http_validate_host(headers, 0, false, String.ends_with(lines[0], \22HTTP/1.1\22))\0A                        |> Result.map(_, |ignored| RequestHead {\0A                            method: rl.method, path: rl.path, headers: headers,\0A                            leftover_body: String.slice(raw, sep_index + 4, String.char_len(raw)),\0A                        })))\0A        },\0A    }\0A\0A/// A small, fixed table covering the reason phrases any real client\0A/// actually looks at — not the full IANA registry. An unrecognized code\0A/// still produces a syntactically valid status line (`\22Unknown\22`), just\0A/// a less informative one; never a hard error, since the STATUS CODE\0A/// itself (not its phrase) is what every real HTTP client actually acts\0A/// on.\0Alet http_status_reason (code: Int): String = match code {\0A    200 => \22OK\22, 201 => \22Created\22, 204 => \22No Content\22,\0A    301 => \22Moved Permanently\22, 302 => \22Found\22,\0A    400 => \22Bad Request\22, 401 => \22Unauthorized\22, 403 => \22Forbidden\22, 404 => \22Not Found\22, 405 => \22Method Not Allowed\22,\0A    500 => \22Internal Server Error\22, 501 => \22Not Implemented\22, 502 => \22Bad Gateway\22, 503 => \22Service Unavailable\22,\0A    _ => \22Unknown\22,\0A}\0A\0A/// The wire-format inverse of `http_build_request` — unlike that\0A/// function, `Content-Length` is ALWAYS sent (even `0` for an empty\0A/// body), not just when the body is non-empty: a request omitting it\0A/// for a bodyless `GET` is common/idiomatic, but a SERVER leaving a\0A/// client to guess whether a response has a body at all is not.\0Alet http_response_to_wire (resp: Response): Result[String, String] =\0A    Result.map(http_validate_headers(resp.headers, 0), |ignored| {\0A        let extra_header_lines = Array.fold(resp.headers, \22\22, |acc, h| acc.concat(h.name).concat(\22: \22).concat(h.value).concat(\22\5Cr\5Cn\22));\0A        \22HTTP/1.1 \22.concat(resp.status.to_string()).concat(\22 \22).concat(http_status_reason(resp.status)).concat(\22\5Cr\5Cn\22)\0A            .concat(\22Content-Length: \22).concat(resp.body.len().to_string()).concat(\22\5Cr\5Cn\22)\0A            .concat(\22Connection: close\5Cr\5Cn\22)\0A            .concat(extra_header_lines)\0A            .concat(\22\5Cr\5Cn\22)\0A            .concat(resp.body)\0A    })\0A\0A// A rejection must be completely sent even if send() makes partial progress.\0Alet http_write_bad_request (conn: Int) (wire: String): Result[Unit, String] =\0A    match Net.write(conn, wire) {\0A        Err(e) => Err(e),\0A        Ok(n) => if n <= 0 { Err(\22http server: could not send Bad Request\22) }\0A            else if n == wire.len() { Ok(()) }\0A            else { http_write_bad_request(conn, String.slice(wire, n, wire.len())) },\0A    }\0A\0A/// Reads exactly one request off `conn`, runs `handler`, writes exactly\0A/// one response back — never touches `conn`'s own lifecycle (opening/\0A/// closing), that's `serve_once`/`http_serve_loop`'s job below, so\0A/// this stays testable on its own without a real listening socket\0A/// (any connected `fd` pair works, e.g. the SAME loopback-pair shape\0A/// `tcp_round_trip`'s own test already uses).\0Alet http_handle_connection (conn: Int) (handler: (Request) -> Response): Result[Unit, String] =\0A    http_recv_headers_acc(conn, 0, \22\22) |> Result.and_then(_, |raw|\0A        match http_parse_request_head(raw) {\0A            Err(e) => http_write_bad_request(conn, \22HTTP/1.1 400 Bad Request\5Cr\5CnContent-Length: 0\5Cr\5CnConnection: close\5Cr\5Cn\5Cr\5Cn\22)\0A                |> Result.and_then(_, |ignored| Err(e)),\0A            Ok(head) => http_read_request_body(conn, head.headers, head.leftover_body) |> Result.and_then(_, |body| {\0A                let request = Request { method: head.method, path: head.path, headers: head.headers, body: body };\0A                let response = handler(request);\0A                http_response_to_wire(response)\0A                    |> Result.and_then(_, |wire| Result.map(Net.write(conn, wire), |sent| ()))\0A            }),\0A        })\0A\0A/// Handles exactly ONE connection then returns — listens, accepts once,\0A/// closes both the connection and the listening socket, and gives back\0A/// whatever `http_handle_connection` produced. Invalid handler headers\0A/// return Err without writing response bytes; the connection is closed.\0A/// Malformed request lines/fields and missing (HTTP/1.1), duplicate, or\0A/// invalid Host fields receive 400 before body reading or handler dispatch,\0A/// then return Err. HTTP/1.0 may omit Host. Present Host values use URI host\0A/// syntax, including empty values, IP literals, and optional decimal ports.\0A/// Real, useful on its own\0A/// (a one-shot server, or a test fixture — this is what THIS module's\0A/// own tests exercise directly), not just a building block for `http_\0A/// serve` below.\0Apub let serve_once (port: Int) (handler: (Request) -> Response): Result[Unit, String] =\0A    match Net.listen_on(port) {\0A        Err(e) => Err(e),\0A        Ok(server) => match Net.accept(server) {\0A            Err(e) => { Net.close(server); Err(e) },\0A            Ok(conn) => {\0A                let result = http_handle_connection(conn, handler);\0A                Net.close(conn);\0A                Net.close(server);\0A                result\0A            },\0A        },\0A    }\0A\0A/// The REAL long-running server: accept, hand the connection off to its\0A/// own task, repeat — forever. Concurrent by design: `spawn` puts each\0A/// connection's `http_handle_connection`/close on its own real OS\0A/// thre