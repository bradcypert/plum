goto exit;\0A    }\0A\0A    switch (operation->alg) {\0A#if defined(PSA_WANT_ALG_JPAKE)\0A        case PSA_ALG_JPAKE:\0A            status = psa_jpake_prologue(operation, step, PSA_JPAKE_INPUT);\0A            if (status != PSA_SUCCESS) {\0A                goto exit;\0A            }\0A            driver_step = convert_jpake_computation_stage_to_driver_step(\0A                &operation->computation_stage.jpake);\0A            break;\0A#endif /* PSA_WANT_ALG_JPAKE */\0A        default:\0A            (void) step;\0A            status = PSA_ERROR_NOT_SUPPORTED;\0A            goto exit;\0A    }\0A\0A    LOCAL_INPUT_ALLOC(input_external, input_length, input);\0A    status = psa_driver_wrapper_pake_input(operation, driver_step,\0A                                           input, input_length);\0A\0A    if (status != PSA_SUCCESS) {\0A        goto exit;\0A    }\0A\0A    switch (operation->alg) {\0A#if defined(PSA_WANT_ALG_JPAKE)\0A        case PSA_ALG_JPAKE:\0A            status = psa_jpake_epilogue(operation, PSA_JPAKE_INPUT);\0A            if (status != PSA_SUCCESS) {\0A                goto exit;\0A            }\0A            break;\0A#endif /* PSA_WANT_ALG_JPAKE */\0A        default:\0A            status = PSA_ERROR_NOT_SUPPORTED;\0A            goto exit;\0A    }\0A\0Aexit:\0A    LOCAL_INPUT_FREE(input_external, input);\0A    if (status != PSA_SUCCESS) {\0A        psa_pake_abort(operation);\0A    }\0A    return status;\0A}\0A\0Apsa_status_t psa_pake_get_implicit_key(\0A    psa_pake_operation_t *operation,\0A    psa_key_derivation_operation_t *output)\0A{\0A    psa_status_t status = PSA_ERROR_CORRUPTION_DETECTED;\0A    psa_status_t abort_status = PSA_ERROR_CORRUPTION_DETECTED;\0A    uint8_t shared_key[MBEDTLS_PSA_JPAKE_BUFFER_SIZE];\0A    size_t shared_key_len = 0;\0A\0A    if (operation->stage != PSA_PAKE_OPERATION_STAGE_COMPUTATION) {\0A        status = PSA_ERROR_BAD_STATE;\0A        goto exit;\0A    }\0A\0A#if defined(PSA_WANT_ALG_JPAKE)\0A    if (operation->alg == PSA_