@.str41584 = private global { i64, i64, [22807 x i8] } { i64 -1, i64 22806, [22807 x i8] c"/*\0A *  PSA AEAD entry points\0A */\0A/*\0A *  Copyright The Mbed TLS Contributors\0A *  SPDX-License-Identifier: Apache-2.0 OR GPL-2.0-or-later\0A */\0A\0A#include \22common.h\22\0A\0A#if defined(MBEDTLS_PSA_CRYPTO_C)\0A\0A#include \22psa_crypto_aead.h\22\0A#include \22psa_crypto_core.h\22\0A#include \22psa_crypto_cipher.h\22\0A\0A#include <string.h>\0A#include \22mbedtls/platform.h\22\0A\0A#include \22mbedtls/ccm.h\22\0A#include \22mbedtls/chachapoly.h\22\0A#include \22mbedtls/cipher.h\22\0A#include \22mbedtls/gcm.h\22\0A#include \22mbedtls/error.h\22\0A\0Astatic psa_status_t psa_aead_setup(\0A    mbedtls_psa_aead_operation_t *operation,\0A    const psa_key_attributes_t *attributes,\0A    const uint8_t *key_buffer,\0A    size_t key_buffer_size,\0A    psa_algorithm_t alg)\0A{\0A    psa_status_t status = PSA_ERROR_CORRUPTION_DETECTED;\0A    mbedtls_cipher_id_t cipher_id;\0A    mbedtls_cipher_mode_t mode;\0A    size_t key_bits = attributes->bits;\0A    (void) key_buffer_size;\0A\0A    status = mbedtls_cipher_values_from_psa(alg, attributes->type,\0A                                            &key_bits, &mode, &cipher_id);\0A    if (status != PSA_SUCCESS) {\0A        return status;\0A    }\0A\0A    switch (PSA_ALG_AEAD_WITH_SHORTENED_TAG(alg, 0)) {\0A#if defined(MBEDTLS_PSA_BUILTIN_ALG_CCM)\0A        case PSA_ALG_AEAD_WITH_SHORTENED_TAG(PSA_ALG_CCM, 0):\0A            operation->alg = PSA_ALG_CCM;\0A            /* CCM allows the following tag lengths: 4, 6, 8, 10, 12, 14, 16.\0A             * The call to mbedtls_ccm_encrypt_and_tag or\0A             * mbedtls_ccm_auth_decrypt will validate the tag length. */\0A            if (PSA_BLOCK_CIPHER_BLOCK_LENGTH(attributes->type) != 16) {\0A                return PSA_ERROR_INVALID_ARGUMENT;\0A            }\0A\0A            mbedtls_ccm_init(&operation->ctx.ccm);\0A            status = mbedtls_to_psa_error(\0A                mbedtls_ccm_setkey(&operation->ctx.ccm, cipher_id,\0A                                   key_buffer, (unsigned int) key_bits));\0A            if (status != PSA_SUCCESS) {\0A                return status;\0A            }\0A            break;\0A#endif /* MBEDTLS_PSA_BUILTIN_ALG_CCM */\0A\0A#if defined(MBEDTLS_PSA_BUILTIN_ALG_GCM)\0A        case PSA_ALG_AEAD_WITH_SHORTENED_TAG(PSA_ALG_GCM, 0):\0A            operation->alg = PSA_ALG_GCM;\0A            /* GCM allows the following tag lengths: 4, 8, 12, 13, 14, 15, 16.\0A             * The call to mbedtls_gcm_crypt_and_tag or\0A             * mbedtls_gcm_auth_decrypt will validate the tag length. */\0A            if (PSA_BLOCK_CIPHER_BLOCK_LENGTH(attributes->type) != 16) {\0A                return PSA_ERROR_INVALID_ARGUMENT;\0A            }\0A\0A            mbedtls_gcm_init(&operation->ctx.gcm);\0A            status = mbedtls_to_psa_error(\0A                mbedtls_gcm_setkey(&operation->ctx.gcm, cipher_id,\0A                                   key_buffer, (unsigned int) key_bits));\0A            if (status != PSA_SUCCESS) {\0A                return status;\0A            }\0A            break;\0A#endif /* MBEDTLS_PSA_BUILTIN_ALG_GCM */\0A\0A#if defined(MBEDTLS_PSA_BUILTIN_ALG_CHACHA20_POLY1305)\0A        case PSA_ALG_AEAD_WITH_SHORTENED_TAG(PSA_ALG_CHACHA20_POLY1305, 0):\0A            operation->alg = PSA_ALG_CHACHA20_POLY1305;\0A            /* We only support the default tag length. */\0A            if (alg != PSA_ALG_CHACHA20_POLY1305) {\0A                return PSA_ERROR_NOT_SUPPORTED;\0A            }\0A\0A            mbedtls_chachapoly_init(&operation->ctx.chachapoly);\0A            status = mbedtls_to_psa_error(\0A                mbedtls_chachapoly_setkey(&operation->ctx.chachapoly,\0A                                          key_buffer));\0A            if (status != PSA_SUCCESS) {\0A                return status;\0A            }\0A            break;\0A#endif /* MBEDTLS_PSA_BUILTIN_ALG_CHACHA20_POLY1305 */\0A\0A        default:\0A            (void) status;\0A            (void) key_buffer;\0A            return PSA_ERROR_NOT_SUPPORTED;\0A    }\0A\0A    operation->key_type = psa_get_key_type(attributes);\0A\0A    operation->tag_length = PSA_ALG_AEAD_GET_TAG_LENGTH(alg);\0A\0A    return PSA_SUCCESS;\0A}\0A\0Apsa_status_t mbedtls_psa_aead_encrypt(\0A    const psa_key_attributes_t *attributes,\0A    const uint8_t *key_buffer, size_t key_buffer_size,\0A    psa_algorithm_t alg,\0A    const uint8_t *nonce, size_t nonce_length,\0A    const uint8_t *additional_data, size_t additional_data_length,\0A    const uint8_t *plaintext, size_t plaintext_length,\0A    uint8_t *ciphertext, size_t ciphertext_size, size_t *ciphertext_length)\0A{\0A    psa_status_t status = PSA_ERROR_CORRUPTION_DETECTED;\0A    mbedtls_psa_aead_operation_t operation = MBEDTLS_PSA_AEAD_OPERATION_INIT;\0A    uint8_t *tag;\0A\0A    status = psa_aead_setup(&operation, attributes, key_buffer,\0A                            key_buffer_size, alg);\0A\0A    if (status != PSA_SUCCESS) {\0A        goto exit;\0A    }\0A\0A    /* For all currently supported modes, the tag is at the end of the\0A     * ciphertext. */\0A    if (ciphertext_size < (plaintext_length + operation.tag_length)) {\0A        status = PSA_ERROR_BUFFER_TOO_SMALL;\0A        goto exit;\0A    }\0A    tag = ciphertext + plaintext_length;\0A\0A#if defined(MBEDTLS_PSA_BUILTIN_ALG_CCM)\0A    if (operation.alg == PSA_ALG_CCM) {\0A        status = mbedtls_to_psa_error(\0A            mbedtls_ccm_encrypt_and_tag(&operation.ctx.ccm,\0A                                        plaintext_length,\0A                                        nonce, nonce_length,\0A                                        additional_data,\0A                                        additional_data_length,\0A                                        plaintext, ciphertext,\0A                                        tag, operation.tag_length));\0A    } else\0A#endif /* MBEDTLS_PSA_BUILTIN_ALG_CCM */\0A#if defined(MBEDTLS_PSA_BUILTIN_ALG_GCM)\0A    if (operation.alg == PSA_ALG_GCM) {\0A        status = mbedtls_to_psa_error(\0A            mbedtls_gcm_crypt_and_tag(&operation.ctx.gcm,\0A                                      MBEDTLS_GCM_ENCRYPT,\0A                                      plaintext_length,\0A                                      nonce, nonce_length,\0A                                      additional_data, additional_data_length,\0A                                      plaintext, ciphertext,\0A                                      operation.tag_length, tag));\0A    } else\0A#endif /* MBEDTLS_PSA_BUILTIN_ALG_GCM */\0A#if defined(MBEDTLS_PSA_BUILTIN_ALG_CHACHA20_POLY1305)\0A    if (operation.alg == PSA_ALG_CHACHA20_POLY1305) {\0A        if (operation.tag_length != 16) {\0A            status = PSA_ERROR_NOT_SUPPORTED;\0A            goto exit;\0A        }\0A        status = mbedtls_to_psa_error(\0A            mbedtls_chachapoly_encrypt_and_tag(&operation.ctx.chachapoly,\0A                                               plaintext_length,\0A                                               nonce,\0A                                               additional_data,\0A                                               additional_data_length,\0A                                               plaintext,\0A                                               ciphertext,\0A                                               tag));\0A    } else\0A#endif /* MBEDTLS_PSA_BUILTIN_ALG_CHACHA20_POLY1305 */\0A    {\0A        (void) tag;\0A        (void) nonce;\0A        (void) nonce_length;\0A        (void) additional_data;\0A        (void) additional_data_length;\0A        (void) plaintext;\0A        return PSA_ERROR_NOT_SUPPORTED;\0A    }\0A\0A    if (status == PSA_SUCCESS) {\0A        *ciphertext_length = plaintext_length + operation.tag_length;\0A    }\0A\0Aexit:\0A    mbedtls_psa_aead_abort(&operation);\0A\0A    return status;\0A}\0A\0A/* Locate the tag in a ciphertext buffer containing the encrypted data\0A * followed by the tag. Return the length of the part preceding the tag in\0A * *plaintext_length. This is the size of the plaintext in modes where\0A * the encrypted data has the same size as the plaintext, such as\0A * CCM and GCM. */\0Astatic psa_status_t psa_aead_unpadded_locate_tag(size_t tag_length,\0A                                                 const uint8_t *ciphertext,\0A                                                 size_t ciphertext_length,\0A                                                 size_t plaintext_size,\0A                                                 const uint8_t **p_tag)\0A{\0A    size_t payload_length;\0A    if (tag_length > ciphertext_length) {\0A        return PSA_ERROR_INVALID_ARGUMENT;\0A    }\0A    payload_length = ciphertext_length - tag_length;\0A    if (payload_length > plaintext_size) {\0A        return PSA_ERROR_BUFFER_TOO_SMALL;\0A    }\0A    *p_tag = ciphertext + payload_length;\0A    return PSA_SUCCESS;\0A}\0A\0Apsa_status_t mbedtls_psa_aead_decrypt(\0A    const psa_key_attributes_t *attributes,\0A    const uint8_t *key_buffer, size_t key_buffer_size,\0A    psa_algorithm_t alg,\0A    const uint8_t *nonce, size_t nonce_length,\0A    const uint8_t *additional_data, size_t additional_data_length,\0A    const uint8_t *ciphertext, size_t ciphertext_length,\0A    uint8_t *plaintext, size_t plaintext_size, size_t *plaintext_length)\0A{\0A    psa_status_t status = PSA_ERROR_CORRUPTION_DETECTED;\0A    mbedtls_psa_aead_operation_t operation = MBEDTLS_PSA_AEAD_OPERATION_INIT;\0A    const uint8_t *tag = NULL;\0A\0A    status = psa_aead_setup(&operation, attributes, key_buffer,\0A                            key_buffer_size, alg);\0A\0A    if (status != PSA_SUCCESS) {\0A        goto exit;\0A    }\0A\0A    status = psa_aead_unpadded_locate_tag(operation.tag_length,\0A                                          ciphertext, ciphertext_length,\0A                                          plaintext_size, &tag);\0A    if (status != PSA_SUCCESS) {\0A        goto exit;\0A    }\0A\0A#if defined(MBEDTLS_PSA_BUILTIN_ALG_CCM)\0A    if (operation.alg == PSA_ALG_CCM) {\0A        status = mbedtls_to_psa_error(\0A            mbedtls_ccm_auth_decrypt(&operation.ctx.ccm,\0A                                     ciphertext_length - operation.tag_length,\0A                                     nonce, nonce_length,\0A                                     additional_data,\0A                                     additional_data_length,\0A                                     ciphertext, plaintext,\0A                                     tag, operation.tag_length));\0A    } else\0A#endif /* MBEDTLS_PSA_BUILTIN_ALG_CCM */\0A#if defined(MBEDTLS_PSA_BUILTIN_ALG_GCM)\0A    if (operation.alg == PSA_ALG_GCM) {\0A        status = mbedtls_to_psa_error(\0A            mbedtls_gcm_auth_decrypt(&operation.ctx.gcm,\0A                                     ciphertext_length - operation.tag_length,\0A                                     nonce, nonce_length,\0A                                     additional_data,\0A                                     additional_data_length,\0A                                     tag, operation.tag_length,\0A                                     ciphertext, plaintext));\0A    } else\0A#endif /* MBEDTLS_PSA_BUILTIN_ALG_GCM */\0A#if defined(MBEDTLS_PSA_BUILTIN_ALG_CHACHA20_POLY1305)\0A    if (operation.alg == PSA_ALG_CHACHA20_POLY1305) {\0A        if (operation.tag_length != 16) {\0A            status = PSA_ERROR_NOT_SUPPORTED;\0A            goto exit;\0A        }\0A        status = mbedtls_to_psa_error(\0A            mbedtls_chachapoly_auth_decrypt(&operation.ctx.chachapoly,\0A                                            ciphertext_length - operation.tag_length,\0A                                            nonce,\0A                                            additional_data,\0A                                            additional_data_length,\0A                                            tag,\0A                                            ciphertext,\0A                                            plaintext));\0A    } else\0A#endif /* MBEDTLS_PSA_BUILTIN_ALG_CHACHA20_POLY1305 */\0A    {\0A        (void) nonce;\0A        (void) nonce_length;\0A        (void) additional_data;\0A        (void) additional_data_length;\0A        (void) plaintext;\0A        return PSA_ERROR_NOT_SUPPORTED;\0A    }\0A\0A    if (status == PSA_SUCCESS) {\0A        *plaintext_length = ciphertext_length - operation.tag_length;\0A    }\0A\0Aexit:\0A    mbedtls_psa_aead_abort(&operation);\0A\0A    if (status == PSA_SUCCESS) {\0A        *plaintext_length = ciphertext_length - operation.tag_length;\0A    }\0A    return status;\0A}\0A\0A/* Set the key and algorithm for a multipart authenticated encryption\0A * operation. */\0Apsa_status_t mbedtls_psa_aead_encrypt_setup(\0A    mbedtls_psa_aead_operation_t *operation,\0A    const psa_key_attributes_t *attributes,\0A    const uint8_t *key_buffer,\0A    size_t key_buffer_size,\0A    psa_algorithm_t alg)\0A{\0A    psa_status_t status = PSA_ERROR_CORRUPTION_DETECTED;\0A\0A    status = psa_aead_setup(operation, attributes, key_buffer,\0A                            key_buffer_size, alg);\0A\0A    if (status == PSA_SUCCESS) {\0A        operation->is_encrypt = 1;\0A    }\0A\0A    return status;\0A}\0A\0A/* Set the key and algorithm for a multipart authenticated decryption\0A * operation. */\0Apsa_status_t mbedtls_psa_aead_decrypt_setup(\0A    mbedtls_psa_aead_operation_t *operation,\0A    const psa_key_attributes_t *attributes,\0A    const uint8_t *key_buffer,\0A    size_t key_buffer_size,\0A    psa_algorithm_t alg)\0A{\0A    psa_status_t status = PSA_ERROR_CORRUPTION_DETECTED;\0A\0A    status = psa_aead_setup(operation, attributes, key_buffer,\0A                            key_buffer_size, alg);\0A\0A    if (status == PSA_SUCCESS) {\0A        operation->is_encrypt = 0;\0A    }\0A\0A    return status;\0A}\0A\0A/* Set a nonce for the multipart AEAD operation*/\0Apsa_status_t mbedtls_psa_aead_set_nonce(\0A    mbedtls_psa_aead_operation_t *operation,\0A    const uint8_t *nonce,\0A    size_t nonce_length)\0A{\0A    psa_status_t status = PSA_ERROR_CORRUPTION_DETECTED;\0A\0A#if defined(MBEDTLS_PSA_BUILTIN_ALG_GCM)\0A    if (operation->alg == PSA_ALG_GCM) {\0A        status = mbedtls_to_psa_error(\0A            mbedtls_gcm_starts(&operation->ctx.gcm,\0A                               operation->is_encrypt ?\0A                               MBEDTLS_GCM_ENCRYPT : MBEDTLS_GCM_DECRYPT,\0A                               nonce,\0A                               nonce_length));\0A    } else\0A#endif /* MBEDTLS_PSA_BUILTIN_ALG_GCM */\0A#if defined(MBEDTLS_PSA_BUILTIN_ALG_CCM)\0A    if (operation->alg == PSA_ALG_CCM) {\0A        status = mbedtls_to_psa_error(\0A            mbedtls_ccm_starts(&operation->ctx.ccm,\0A                               operation->is_encrypt ?\0A                               MBEDTLS_CCM_ENCRYPT : MBEDTLS_CCM_DECRYPT,\0A                               nonce,\0A                               nonce_length));\0A    } else\0A#endif /* MBEDTLS_PSA_BUILTIN_ALG_CCM */\0A#if defined(MBEDTLS_PSA_BUILTIN_ALG_CHACHA20_POLY1305)\0A    if (operation->alg == PSA_ALG_CHACHA20_POLY1305) {\0A        /* Note - ChaChaPoly allows an 8 byte nonce, but we would have to\0A         * allocate a buffer in the operation, copy the nonce to it and pad\0A         * it, so for now check the nonce is 12 bytes, as\0A         * mbedtls_chachapoly_starts() assumes it can read 12 bytes from the\0A         * passed in buffer. */\0A        if (nonce_length != 12) {\0A            return PSA_ERROR_INVALID_ARGUMENT;\0A        }\0A\0A        status = mbedtls_to_psa_error(\0A            mbedtls_chachapoly_starts(&operation->ctx.chachapoly,\0A                                      nonce,\0A                                      operation->is_encrypt ?\0A                                      MBEDTLS_CHACHAPOLY_ENCRYPT :\0A                                      MBEDTLS_CHACHAPOLY_DECRYPT));\0A    } else\0A#endif /* MBEDTLS_PSA_BUILTIN_ALG_CHACHA20_POLY1305 */\0A    {\0A        (void) operation;\0A        (void) nonce;\0A        (void) nonce_length;\0A\0A        return PSA_ERROR_NOT_SUPPORTED;\0A    }\0A\0A    return status;\0A}\0A\0A/* Declare the lengths of the message and additional data for AEAD. */\0Apsa_status_t mbedtls_psa_aead_set_lengths(\0A    mbedtls_psa_aead_operation_t *operation,\0A    size_t ad_length,\0A    size_t plaintext_length)\0A{\0A#if defined(MBEDTLS_PSA_BUILTIN_ALG_CCM)\0A    if (operation->alg == PSA_ALG_CCM) {\0A        return mbedtls_to_psa_error(\0A            mbedtls_ccm_set_lengths(&operation->ctx.ccm,\0A                                    ad_length,\0A                                    plaintext_length,\0A                                    operation->tag_length));\0A\0A    }\0A#else /* MBEDTLS_PSA_BUILTIN_ALG_CCM */\0A    (void) operation;\0A    (void) ad_length;\0A    (void) plaintext_length;\0A#endif /* MBEDTLS_PSA_BUILTIN_ALG_CCM */\0A\0A    return PSA_SUCCESS;\0A}\0A\0A/* Pass additional data to an active multipart AEAD operation. */\0Apsa_status_t mbedtls_psa_aead_update_ad(\0A    mbedtls_psa_aead_operation_t *operation,\0A    const uint8_t *input,\0A    size_t input_length)\0A{\0A    psa_status_t status = PSA_ERROR_CORRUPTION_DETECTED;\0A\0A#if defined(MBEDTLS_PSA_BUILTIN_ALG_GCM)\0A    if (operation->alg == PSA_ALG_GCM) {\0A        status = mbedtls_to_psa_error(\0A            mbedtls_gcm_update_ad(&operation->ctx.gcm, input, input_length));\0A    } else\0A#endif /* MBEDTLS_PSA_BUILTIN_ALG_GCM */\0A#if defined(MBEDTLS_PSA_BUILTIN_ALG_CCM)\0A    if (operation->alg == PSA_ALG_CCM) {\0A        status = mbedtls_to_psa_error(\0A            mbedtls_ccm_update_ad(&operation->ctx.ccm, input, input_length));\0A    } else\0A#endif /* MBEDTLS_PSA_BUILTIN_ALG_CCM */\0A#if defined(MBEDTLS_PSA_BUILTIN_ALG_CHACHA20_POLY1305)\0A    if (operation->alg == PSA_ALG_CHACHA20_POLY1305) {\0A        status = mbedtls_to_psa_error(\0A            mbedtls_chachapoly_update_aad(&operation->ctx.chachapoly,\0A                                          input,\0A                                          input_length));\0A    } else\0A#endif /* MBEDTLS_PSA_BUILTIN_ALG_CHACHA20_POLY1305 */\0A    {\0A        (void) operation;\0A        (void) input;\0A        (void) input_length;\0A\0A        return PSA_ERROR_NOT_SUPPORTED;\0A    }\0A\0A    return status;\0A}\0A\0A/* Encrypt or decrypt a message fragment in an active multipart AEAD\0A * operation.*/\0Apsa_status_t mbedtls_psa_aead_update(\0A    mbedtls_psa_aead_operation_t *operation,\0A    const uint8_t *input,\0A    size_t input_length,\0A    uint8_t *output,\0A    size_t output_size,\0A    size_t *output_length)\0A{\0A    size_t update_output_length;\0A    psa_status_t status = PSA_ERROR_CORRUPTION_DETECTED;\0A\0A    update_output_length = input_length;\0A\0A#if defined(MBEDTLS_PSA_BUILTIN_ALG_GCM)\0A    if (operation->alg == PSA_ALG_GCM) {\0A        status =  mbedtls_to_psa_error(\0A            mbedtls_gcm_update(&operation->ctx.gcm,\0A                               input, input_length,\0A                               output, output_size,\0A                               &update_output_length));\0A    } else\0A#endif /* MBEDTLS_PSA_BUILTIN_ALG_GCM */\0A#if defined(MBEDTLS_PSA_BUILTIN_ALG_CCM)\0A    if (operation->alg == PSA_ALG_CCM) {\0A        if (output_size < input_length) {\0A            return PSA_ERROR_BUFFER_TOO_SMALL;\0A        }\0A\0A        status = mbedtls_to_psa_error(\0A            mbedtls_ccm_update(&operation->ctx.ccm,\0A                               input, input_length,\0A                               output, output_size,\0A                               &update_output_length));\0A    } else\0A#endif /* MBEDTLS_PSA_BUILTIN_ALG_CCM */\0A#if defined(MBEDTLS_PSA_BUILTIN_ALG_CHACHA20_POLY1305)\0A    if (operation->alg == PSA_ALG_CHACHA20_POLY1305) {\0A        if (output_size < input_length) {\0A            return PSA_ERROR_BUFFER_TOO_SMALL;\0A        }\0A\0A        status = mbedtls_to_psa_error(\0A            mbedtls_chachapoly_update(&operation->ctx.chachapoly,\0A                                      input_length,\0A                                      input,\0A                                      output));\0A    } else\0A#endif /* MBEDTLS_PSA_BUILTIN_ALG_CHACHA20_POLY1305 */\0A    {\0A        (void) operation;\0A        (void) input;\0A        (void) output;\0A        (void) output_size;\0A\0A        return PSA_ERROR_NOT_SUPPORTED;\0A    }\0A\0A    if (status == PSA_SUCCESS) {\0A        *output_length = update_output_length;\0A    }\0A\0A    return status;\0A}\0A\0A/* Finish encrypting a message in a multipart AEAD operation. */\0Apsa_status_t mbedtls_psa_aead_finish(\0A    mbedtls_psa_aead_operation_t *operation,\0A    uint8_t *ciphertext,\0A    size_t ciphertext_size,\0A    size_t *ciphertext_length,\0A    uint8_t *tag,\0A    size_t tag_size,\0A    size_t *tag_length)\0A{\0A    psa_status_t status = PSA_ERROR_CORRUPTION_DETECTED;\0A    size_t finish_output_size = 0;\0A\0A    if (tag_size < operation->tag_length) {\0A        return PSA_ERROR_BUFFER_TOO_SMALL;\0A    }\0A\0A#if defined(MBEDTLS_PSA_BUILTIN_ALG_GCM)\0A    if (operation->alg == PSA_ALG_GCM) {\0A        status =  mbedtls_to_psa_error(\0A            mbedtls_gcm_finish(&operation->ctx.gcm,\0A                               ciphertext, ciphertext_size, ciphertext_length,\0A                               tag, operation->tag_length));\0A    } else\0A#endif /* MBEDTLS_PSA_BUILTIN_ALG_GCM */\0A#if defined(MBEDTLS_PSA_BUILTIN_ALG_CCM)\0A    if (operation->alg == PSA_ALG_CCM) {\0A        /* tag must be big enough to store a tag of size passed into set\0A         * lengths. */\0A        if (tag_size < operation->tag_length) {\0A            return PSA_ERROR_BUFFER_TOO_SMALL;\0A        }\0A\0A        status = mbedtls_to_psa_error(\0A            mbedtls_ccm_finish(&operation->ctx.ccm,\0A                               tag, operation->tag_length));\0A    } else\0A#endif /* MBEDTLS_PSA_BUILTIN_ALG_CCM */\0A#if defined(MBEDTLS_PSA_BUILTIN_ALG_CHACHA20_POLY1305)\0A    if (operation->alg == PSA_ALG_CHACHA20_POLY1305) {\0A        /* Belt and braces. Although the above tag_size check should have\0A         * already done this, if we later start supporting smaller tag sizes\0A         * for chachapoly, then passing a tag buffer smaller than 16 into here\0A         * could cause a buffer overflow, so better safe than sorry. */\0A        if (tag_size < 16) {\0A            return PSA_ERROR_BUFFER_TOO_SMALL;\0A        }\0A\0A        status = mbedtls_to_psa_error(\0A            mbedtls_chachapoly_finish(&operation->ctx.chachapoly,\0A                                      tag));\0A    } else\0A#endif /* MBEDTLS_PSA_BUILTIN_ALG_CHACHA20_POLY1305 */\0A    {\0A        (void) ciphertext;\0A        (void) ciphertext_size;\0A        (void) ciphertext_length;\0A        (void) tag;\0A        (void) tag_size;\0A        (void) tag_length;\0A\0A        return PSA_ERROR_NOT_SUPPORTED;\0A    }\0A\0A    if (status == PSA_SUCCESS) {\0A        /* This will be zero for all supported algorithms currently, but left\0A         * here for future support. */\0A        *ciphertext_length = finish_output_size;\0A        *tag_length = operation->tag_length;\0A    }\0A\0A    return status;\0A}\0A\0A/* Abort an AEAD operation */\0Apsa_status_t mbedtls_psa_aead_abort(\0A    mbedtls_psa_aead_operation_t *operation)\0A{\0A    switch (operation->alg) {\0A#if defined(MBEDTLS_PSA_BUILTIN_ALG_CCM)\0A        case PSA_ALG_CCM:\0A            mbedtls_ccm_free(&operation->ctx.ccm);\0A            break;\0A#endif /* MBEDTLS_PSA_BUILTIN_ALG_CCM */\0A#if defined(MBEDTLS_PSA_BUILTIN_ALG_GCM)\0A        case PSA_ALG_GCM:\0A            mbedtls_gcm_free(&operation->ctx.gcm);\0A            break;\0A#endif /* MBEDTLS_PSA_BUILTIN_ALG_GCM */\0A#if defined(MBEDTLS_PSA_BUILTIN_ALG_CHACHA20_POLY1305)\0A        case PSA_ALG_CHACHA20_POLY1305:\0A            mbedtls_chachapoly_free(&operation->ctx.chachapoly);\0A            break;\0A#endif /* MBEDTLS_PSA_BUILTIN_ALG_CHACHA20_POLY1305 */\0A    }\0A\0A    operation->is_encrypt = 0;\0A\0A    return PSA_SUCCESS;\0A}\0A\0A#endif /* MBEDTLS_PSA_CRYPTO_C */\0A\00" }
