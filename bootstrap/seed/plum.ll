;\0A            } else if (r == 1) {\0A                MBEDTLS_MPI_CHK(mbedtls_mpi_add_int(X, X, 4));\0A            }\0A\0A            /* Set Y = (X-1) / 2, which is X / 2 because X is odd */\0A            MBEDTLS_MPI_CHK(mbedtls_mpi_copy(&Y, X));\0A            MBEDTLS_MPI_CHK(mbedtls_mpi_shift_r(&Y, 1));\0A\0A            while (1) {\0A                /*\0A                 * First, check small factors for X and Y\0A                 * before doing Miller-Rabin on any of them\0A                 */\0A                if ((ret = mpi_check_small_factors(X)) == 0 &&\0A                    (ret = mpi_check_small_factors(&Y)) == 0 &&\0A                    (ret = mpi_miller_rabin(X, rounds, f_rng, p_rng))\0A                    == 0 &&\0A                    (ret = mpi_miller_rabin(&Y, rounds, f_rng, p_rng))\0A                    == 0) {\0A                    goto cleanup;\0A                }\0A\0A                if (ret != MBEDTLS_ERR_MPI_NOT_ACCEPTABLE) {\0A                    goto cleanup;\0A                }\0A\0A                /*\0A                 * Next candidates. We want to preserve Y = (X-1) / 2 and\0A                 * Y = 1 mod 2 and Y = 2 mod 3 (eq X = 3 mod 4 and X = 2 mod 3)\0A                 * so up Y by 6 and X by 12.\0A                 */\0A                MBEDTLS_MPI_CHK(mbedtls_mpi_add_int(X,  X, 12));\0A                MBEDTLS_MPI_CHK(mbedtls_mpi_add_int(&Y, &Y, 6));\0A            }\0A        }\0A    }\0A\0Acleanup:\0A\0A    mbedtls_mpi_free(&Y);\0A\0A    return ret;\0A}\0A\0A#endif /* MBEDTLS_GENPRIME */\0A\0A#if defined(MBEDTLS_SELF_TEST)\0A\0A#define GCD_PAIR_COUNT  3\0A\0Astatic const int gcd_pairs[GCD_PAIR_COUNT][3] =\0A{\0A    { 693, 609, 21 },\0A    { 1764, 868, 28 },\0A    { 768454923, 542167814, 1 }\0A};\0A\0A/*\0A * Checkup routine\0A */\0Aint mbedtls_mpi_self_test(int verbose)\0A{\0A    int ret, i;\0A    mbedtls_mpi A, E, N, X, Y, U, V;\0A\0A    mbedtls_mpi_init(&A); mbedtls_mpi_init(&E); mbedtls_mpi_init(&N); mbedtls_mpi_init(&X);\0A    mbedtls_mpi_init(&Y); mbedtls_mpi_init(&U); mbedtls_mpi_init(&V);\0A\0A    MBEDTLS_MPI_CHK(mbedtls_mpi_read_string(&A, 16,\0A                                            \22EFE021C2645FD1DC586E69184AF4A31E\22 \5C\0A                                            \22D5F53E93B5F123FA41680867BA110131\22 \5C\0A                                            \22944FE7952E2517337780CB0DB80E61AA\22 \5C\0A                                            \22E7C8DDC6C5C6AADEB34EB38A2F40D5E6\22));\0A\0A    MBEDTLS_MPI_CHK(mbedtls_mpi_read_string(&E, 16,\0A                                            \22B2E7EFD37075B9F03FF989C7C5051C20\22 \5C\0A                                            \2234D2A323810251127E7BF8625A4F49A5\22 \5C\0A                                            \22F3E27F4DA8BD59C47D6DAABA4C8127BD\22 \5C\0A                                            \225B5C25763222FEFCCFC38B832366C29E\22));\0A\0A    MBEDTLS_MPI_CHK(mbedtls_mpi_read_string(&N, 16,\0A                                            \220066A198186C18C10B2F5ED9B522752A\22 \5C\0A                                            \229830B69916E535C8F047518A889A43A5\22 \5C\0A                                            \2294B6BED27A168D31D4A52F88925AA8F5\22));\0A\0A    MBEDTLS_MPI_CHK(mbedtls_mpi_mul_mpi(&X, &A, &N));\0A\0A    MBEDTLS_MPI_CHK(mbedtls_mpi_read_string(&U, 16,\0A                                            \22602AB7ECA597A3D6B56FF9829A5E8B85\22 \5C\0A                                            \229E857EA95A03512E2BAE7391688D264A\22 \5C\0A                                            \22A5663B0341DB9CCFD2C4C5F421FEC814\22 \5C\0A                                            \228001B72E848A38CAE1C65F78E56ABDEF\22 \5C\0A                                            \22E12D3C039B8A02D6BE593F0BBBDA56F1\22 \5C\0A                                            \22ECF677152EF804370C1A305CAF3B5BF1\22 \5C\0A                                            \2230879B56C61DE584A0F53A2447A51E\22));\0A\0A    if (verbose != 0) {\0A        mbedtls_printf(\22 