->verify_func(ctx, md_alg, hash, hash_len,\0A                                     sig, sig_len);\0A}\0A\0A/*\0A * Verify a signature\0A */\0Aint mbedtls_pk_verify(mbedtls_pk_context *ctx, mbedtls_md_type_t md_alg,\0A                      const unsigned char *hash, size_t hash_len,\0A                      const unsigned char *sig, size_t sig_len)\0A{\0A    return mbedtls_pk_verify_restartable(ctx, md_alg, hash, hash_len,\0A                                         sig, sig_len, NULL);\0A}\0A\0A/*\0A * Verify a signature with options\0A */\0Aint mbedtls_pk_verify_ext(mbedtls_pk_type_t type, const void *options,\0A                          mbedtls_pk_context *ctx, mbedtls_md_type_t md_alg,\0A                          const unsigned char *hash, size_t hash_len,\0A                          const unsigned char *sig, size_t sig_len)\0A{\0A    if ((md_alg != MBEDTLS_MD_NONE || hash_len != 0) && hash == NULL) {\0A        return MBEDTLS_ERR_PK_BAD_INPUT_DATA;\0A    }\0A\0A    if (ctx->pk_info == NULL) {\0A        return MBEDTLS_ERR_PK_BAD_INPUT_DATA;\0A    }\0A\0A    if (!mbedtls_pk_can_do(ctx, type)) {\0A        return MBEDTLS_ERR_PK_TYPE_MISMATCH;\0A    }\0A\0A    if (type != MBEDTLS_PK_RSASSA_PSS) {\0A        /* General case: no options */\0A        if (options != NULL) {\0A            return MBEDTLS_ERR_PK_BAD_INPUT_DATA;\0A        }\0A\0A        return mbedtls_pk_verify(ctx, md_alg, hash, hash_len, sig, sig_len);\0A    }\0A\0A    /* Ensure the PK context is of the right type otherwise mbedtls_pk_rsa()\0A     * below would return a NULL pointer. */\0A    if (mbedtls_pk_get_type(ctx) != MBEDTLS_PK_RSA) {\0A        return MBEDTLS_ERR_PK_FEATURE_UNAVAILABLE;\0A    }\0A\0A#if defined(MBEDTLS_RSA_C) && defined(MBEDTLS_PKCS1_V21)\0A    int ret = MBEDTLS_ERR_ERROR_CORRUPTION_DETECTED;\0A    const mbedtls_pk_rsassa_pss_options *pss_opts;\0A\0A#if SIZE_MAX > UINT_MAX\0A    if (md_alg == MBEDTLS_MD_NONE && UINT_MAX < hash_len) {\0A        return MBEDTLS_ERR_PK_BAD_INPUT_DATA;\0A    