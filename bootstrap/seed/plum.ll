@.str45235 = private global { i64, i64, [5901 x i8] } { i64 -1, i64 5900, [5901 x i8] c"/**\0A * \5Cfile pem.h\0A *\0A * \5Cbrief Privacy Enhanced Mail (PEM) decoding\0A */\0A/*\0A *  Copyright The Mbed TLS Contributors\0A *  SPDX-License-Identifier: Apache-2.0 OR GPL-2.0-or-later\0A */\0A#ifndef MBEDTLS_PEM_H\0A#define MBEDTLS_PEM_H\0A#include \22mbedtls/private_access.h\22\0A\0A#include \22mbedtls/build_info.h\22\0A\0A#include <stddef.h>\0A\0A/**\0A * \5Cname PEM Error codes\0A * These error codes are returned in case of errors reading the\0A * PEM data.\0A * \5C{\0A */\0A/** No PEM header or footer found. */\0A#define MBEDTLS_ERR_PEM_NO_HEADER_FOOTER_PRESENT          -0x1080\0A/** PEM string is not as expected. */\0A#define MBEDTLS_ERR_PEM_INVALID_DATA                      -0x1100\0A/** Failed to allocate memory. */\0A#define MBEDTLS_ERR_PEM_ALLOC_FAILED                      -0x1180\0A/** RSA IV is not in hex-format. */\0A#define MBEDTLS_ERR_PEM_INVALID_ENC_IV                    -0x1200\0A/** Unsupported key encryption algorithm. */\0A#define MBEDTLS_ERR_PEM_UNKNOWN_ENC_ALG                   -0x1280\0A/** Private key password can't be empty. */\0A#define MBEDTLS_ERR_PEM_PASSWORD_REQUIRED                 -0x1300\0A/** Given private key password does not allow for correct decryption. */\0A#define MBEDTLS_ERR_PEM_PASSWORD_MISMATCH                 -0x1380\0A/** Unavailable feature, e.g. hashing/encryption combination. */\0A#define MBEDTLS_ERR_PEM_FEATURE_UNAVAILABLE               -0x1400\0A/** Bad input parameters to function. */\0A#define MBEDTLS_ERR_PEM_BAD_INPUT_DATA                    -0x1480\0A/** \5C} name PEM Error codes */\0A\0A#ifdef __cplusplus\0Aextern \22C\22 {\0A#endif\0A\0A#if defined(MBEDTLS_PEM_PARSE_C)\0A/**\0A * \5Cbrief       PEM context structure\0A */\0Atypedef struct mbedtls_pem_context {\0A    unsigned char *MBEDTLS_PRIVATE(buf);     /*!< buffer for decoded data             */\0A    size_t MBEDTLS_PRIVATE(buflen);          /*!< length of the buffer                */\0A    unsigned char *MBEDTLS_PRIVATE(info);    /*!< buffer for extra header information */\0A}\0Ambedtls_pem_context;\0A\0A/**\0A * \5Cbrief       PEM context setup\0A *\0A * \5Cparam ctx   context to be initialized\0A */\0Avoid mbedtls_pem_init(mbedtls_pem_context *ctx);\0A\0A/**\0A * \5Cbrief       Read a buffer for PEM information and store the resulting\0A *              data into the specified context buffers.\0A *\0A * \5Cparam ctx       context to use\0A * \5Cparam header    header string to seek and expect\0A * \5Cparam footer    footer string to seek and expect\0A * \5Cparam data      source data to look in (must be nul-terminated)\0A * \5Cparam pwd       password for decryption (can be NULL)\0A * \5Cparam pwdlen    length of password\0A * \5Cparam use_len   destination for total length used from data buffer. It is\0A *                  set after header is correctly read, so unless you get\0A *                  MBEDTLS_ERR_PEM_BAD_INPUT_DATA or\0A *                  MBEDTLS_ERR_PEM_NO_HEADER_FOOTER_PRESENT, use_len is\0A *                  the length to skip.\0A *\0A * \5Cnote            Attempts to check password correctness by verifying if\0A *                  the decrypted text starts with an ASN.1 sequence of\0A *                  appropriate length\0A *\0A * \5Cnote            \5Cc mbedtls_pem_free must be called on PEM context before\0A *                  the PEM context can be reused in another call to\0A *                  \5Cc mbedtls_pem_read_buffer\0A *\0A * \5Creturn          0 on success, or a specific PEM error code\0A */\0Aint mbedtls_pem_read_buffer(mbedtls_pem_context *ctx, const char *header, const char *footer,\0A                            const unsigned char *data,\0A                            const unsigned char *pwd,\0A                            size_t pwdlen, size_t *use_len);\0A\0A/**\0A * \5Cbrief       Get the pointer to the decoded binary data in a PEM context.\0A *\0A * \5Cparam ctx       PEM context to access.\0A * \5Cparam buflen    On success, this will contain the length of the binary data.\0A *                  This must be a valid (non-null) pointer.\0A *\0A * \5Creturn          A pointer to the decoded binary data.\0A *\0A * \5Cnote            The returned pointer remains valid only until \5Cp ctx is\0A                    modified or freed.\0A */\0Astatic inline const unsigned char *mbedtls_pem_get_buffer(mbedtls_pem_context *ctx, size_t *buflen)\0A{\0A    *buflen = ctx->MBEDTLS_PRIVATE(buflen);\0A    return ctx->MBEDTLS_PRIVATE(buf);\0A}\0A\0A\0A/**\0A * \5Cbrief       PEM context memory freeing\0A *\0A * \5Cparam ctx   context to be freed\0A */\0Avoid mbedtls_pem_free(mbedtls_pem_context *ctx);\0A#endif /* MBEDTLS_PEM_PARSE_C */\0A\0A#if defined(MBEDTLS_PEM_WRITE_C)\0A/**\0A * \5Cbrief           Write a buffer of PEM information from a DER encoded\0A *                  buffer.\0A *\0A * \5Cparam header    The header string to write.\0A * \5Cparam footer    The footer string to write.\0A * \5Cparam der_data  The DER data to encode.\0A * \5Cparam der_len   The length of the DER data \5Cp der_data in Bytes.\0A * \5Cparam buf       The buffer to write to.\0A * \5Cparam buf_len   The length of the output buffer \5Cp buf in Bytes.\0A * \5Cparam olen      The address at which to store the total length written\0A *                  or required (if \5Cp buf_len is not enough).\0A *\0A * \5Cnote            You may pass \5Cc NULL for \5Cp buf and \5Cc 0 for \5Cp buf_len\0A *                  to request the length of the resulting PEM buffer in\0A *                  `*olen`.\0A *\0A * \5Cnote            This function may be called with overlapping \5Cp der_data\0A *                  and \5Cp buf buffers.\0A *\0A * \5Creturn          \5Cc 0 on success.\0A * \5Creturn          #MBEDTLS_ERR_BASE64_BUFFER_TOO_SMALL if \5Cp buf isn't large\0A *                  enough to hold the PEM buffer. In  this case, `*olen` holds\0A *                  the required minimum size of \5Cp buf.\0A * \5Creturn          Another PEM or BASE64 error code on other kinds of failure.\0A */\0Aint mbedtls_pem_write_buffer(const char *header, const char *footer,\0A                             const unsigned char *der_data, size_t der_len,\0A                             unsigned char *buf, size_t buf_len, size_t *olen);\0A#endif /* MBEDTLS_PEM_WRITE_C */\0A\0A#ifdef __cplusplus\0A}\0A#endif\0A\0A#endif /* pem.h */\0A\00" }
