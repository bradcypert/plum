\0A\0A        default:\0A            return MBEDTLS_ERR_RSA_INVALID_PADDING;\0A    }\0A}\0A\0A/*\0A * Copy the components of an RSA key\0A */\0Aint mbedtls_rsa_copy(mbedtls_rsa_context *dst, const mbedtls_rsa_context *src)\0A{\0A    int ret = MBEDTLS_ERR_ERROR_CORRUPTION_DETECTED;\0A\0A    dst->len = src->len;\0A\0A    MBEDTLS_MPI_CHK(mbedtls_mpi_copy(&dst->N, &src->N));\0A    MBEDTLS_MPI_CHK(mbedtls_mpi_copy(&dst->E, &src->E));\0A\0A    MBEDTLS_MPI_CHK(mbedtls_mpi_copy(&dst->D, &src->D));\0A    MBEDTLS_MPI_CHK(mbedtls_mpi_copy(&dst->P, &src->P));\0A    MBEDTLS_MPI_CHK(mbedtls_mpi_copy(&dst->Q, &src->Q));\0A\0A#if !defined(MBEDTLS_RSA_NO_CRT)\0A    MBEDTLS_MPI_CHK(mbedtls_mpi_copy(&dst->DP, &src->DP));\0A    MBEDTLS_MPI_CHK(mbedtls_mpi_copy(&dst->DQ, &src->DQ));\0A    MBEDTLS_MPI_CHK(mbedtls_mpi_copy(&dst->QP, &src->QP));\0A    MBEDTLS_MPI_CHK(mbedtls_mpi_copy(&dst->RP, &src->RP));\0A    MBEDTLS_MPI_CHK(mbedtls_mpi_copy(&dst->RQ, &src->RQ));\0A#endif\0A\0A    MBEDTLS_MPI_CHK(mbedtls_mpi_copy(&dst->RN, &src->RN));\0A\0A    MBEDTLS_MPI_CHK(mbedtls_mpi_copy(&dst->Vi, &src->Vi));\0A    MBEDTLS_MPI_CHK(mbedtls_mpi_copy(&dst->Vf, &src->Vf));\0A\0A    dst->padding = src->padding;\0A    dst->hash_id = src->hash_id;\0A\0Acleanup:\0A    if (ret != 0) {\0A        mbedtls_rsa_free(dst);\0A    }\0A\0A    return ret;\0A}\0A\0A/*\0A * Free the components of an RSA key\0A */\0Avoid mbedtls_rsa_free(mbedtls_rsa_context *ctx)\0A{\0A    if (ctx == NULL) {\0A        return;\0A    }\0A\0A    mbedtls_mpi_free(&ctx->Vi);\0A    mbedtls_mpi_free(&ctx->Vf);\0A    mbedtls_mpi_free(&ctx->RN);\0A    mbedtls_mpi_free(&ctx->D);\0A    mbedtls_mpi_free(&ctx->Q);\0A    mbedtls_mpi_free(&ctx->P);\0A    mbedtls_mpi_free(&ctx->E);\0A    mbedtls_mpi_free(&ctx->N);\0A\0A#if !defined(MBEDTLS_RSA_NO_CRT)\0A    mbedtls_mpi_free(&ctx->RQ);\0A    mbedtls_mpi_free(&ctx->RP);\0A    mbedtls_mpi_free(&ctx->QP);\0A    mbedtls_mpi_free(&ctx->DQ);\0A    mbedtls_mpi_free(&ctx->DP);\0A#endif /* MBEDTLS_RSA_NO_CRT */\0A\0A#if defined(MBEDTLS_THREADING_C)\0A    /* Free the mutex, but only if it hasn't been freed already. */\0A    if (ctx->ver != 0) {\0A        mbedtls_mutex_free(&ctx->mutex);\0A        ctx->ver = 0;\0A    }\0A#endif\0A}\0A\0A#endif /* !MBEDTLS_RSA_ALT */\0A\0A#if defined(MBEDTLS_SELF_TEST)\0A\0A\0A/*\0A * Example RSA-1024 keypair, for test purposes\0A */\0A#define KEY_LEN 128\0A\0A#define RSA_N   \229292758453063D803DD603D5E777D788\22 \5C\0A                \228ED1D5BF35786190FA2F23EBC0848AEA\22 \5C\0A                \22DDA92CA6C3D80B32C4D109BE0F36D6AE\22 \5C\0A                \227130B9CED7ACDF54CFC7555AC14EEBAB\22 \5C\0A                \2293A89813FBF3C4F8066D2D800F7C38A8\22 \5C\0A                \221AE31942917403FF4946B0A83D3D3E05\22 \5C\0A                \22EE57C6F5F5606FB5D4BC6CD34EE0801A\22 \5C\0A                \225E94BB77B07507233A0BC7BAC8F90F79\22\0A\0A#define RSA_E   \2210001\22\0A\0A#define RSA_D   \2224BF6185468786FDD303083D25E64EFC\22 \5C\0A                \2266CA472BC44D253102F8B4A9D3BFA750\22 \5C\0A                \2291386C0077937FE33FA3252D28855837\22 \5C\0A                \22AE1B484A8A9A45F7EE8C0C634F99E8CD\22 \5C\0A                \22DF79C5CE07EE72C7F123142198164234\22 \5C\0A                \22CABB724CF78B8173B9F880FC86322407\22 \5C\0A                \22AF1FEDFDDE2BEB674CA15F3E81A1521E\22 \5C\0A                \22071513A1E85B5DFA031F21ECAE91A34D\22\0A\0A#define RSA_P   \22C36D0EB7FCD285223CFB5AABA5BDA3D8\22 \5C\0A                \222C01CAD19EA484A87EA4377637E75500\22 \5C\0A                \22FCB2005C5C7DD6EC4AC023CDA285D796\22 \5C\0A                \22C3D9E75E1EFC42488BB4F1D13AC30A57\22\0A\0A#define RSA_Q   \22C000DF51A7C77AE8D7C7370C1FF55B69\22 \5C\0A                \22E211C2B9E5DB1ED0BF61D0D9899620F4\22 \5C\0A                \22910E4168387E3C30AA1E00C339A79508\22 \5C\0A                \228452DD96A9A5EA5D9DCA68DA636032AF\22\0A\0A#define PT_LEN  24\0A#define RSA_PT  \22\5CxAA\5CxBB\5CxCC\5Cx03\5Cx02\5Cx01\5Cx00\5CxFF\5CxFF\5CxFF\5CxFF\5CxFF\22 \5C\0