@.str41957 = private global { i64, i64, [1126 x i8] } { i64 -1, i64 1125, [1126 x i8] c"/**\0A * \5Cfile psa/crypto_adjust_auto_enabled.h\0A * \5Cbrief Adjust PSA configuration: enable always-on features\0A *\0A * This is an internal header. Do not include it directly.\0A *\0A * Always enable certain features which require a negligible amount of code\0A * to implement, to avoid some edge cases in the configuration combinatorics.\0A */\0A/*\0A *  Copyright The Mbed TLS Contributors\0A *  SPDX-License-Identifier: Apache-2.0 OR GPL-2.0-or-later\0A */\0A\0A#ifndef PSA_CRYPTO_ADJUST_AUTO_ENABLED_H\0A#define PSA_CRYPTO_ADJUST_AUTO_ENABLED_H\0A\0A#if !defined(MBEDTLS_CONFIG_FILES_READ)\0A#error \22Do not include psa/crypto_adjust_*.h manually! This can lead to problems, \22 \5C\0A    \22up to and including runtime errors such as buffer overflows. \22 \5C\0A    \22If you're trying to fix a complaint from check_config.h, just remove \22 \5C\0A    \22it from your configuration file: since Mbed TLS 3.0, it is included \22 \5C\0A    \22automatically at the right point.\22\0A#endif /* */\0A\0A#define PSA_WANT_KEY_TYPE_DERIVE 1\0A#define PSA_WANT_KEY_TYPE_PASSWORD 1\0A#define PSA_WANT_KEY_TYPE_PASSWORD_HASH 1\0A#define PSA_WANT_KEY_TYPE_RAW_DATA 1\0A\0A#endif /* PSA_CRYPTO_ADJUST_AUTO_ENABLED_H */\0A\00" }
