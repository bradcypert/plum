@.str44947 = private global { i64, i64, [1736 x i8] } { i64 -1, i64 1735, [1736 x i8] c"/**\0A * \5Cfile compat-2.x.h\0A *\0A * \5Cbrief Compatibility definitions\0A *\0A * \5Cdeprecated Use the new names directly instead\0A */\0A/*\0A *  Copyright The Mbed TLS Contributors\0A *  SPDX-License-Identifier: Apache-2.0 OR GPL-2.0-or-later\0A */\0A\0A#if defined(MBEDTLS_DEPRECATED_WARNING)\0A#warning \22Including compat-2.x.h is deprecated\22\0A#endif\0A\0A#ifndef MBEDTLS_COMPAT2X_H\0A#define MBEDTLS_COMPAT2X_H\0A\0A/*\0A * Macros for renamed functions\0A */\0A#define mbedtls_ctr_drbg_update_ret   mbedtls_ctr_drbg_update\0A#define mbedtls_hmac_drbg_update_ret  mbedtls_hmac_drbg_update\0A#define mbedtls_md5_starts_ret        mbedtls_md5_starts\0A#define mbedtls_md5_update_ret        mbedtls_md5_update\0A#define mbedtls_md5_finish_ret        mbedtls_md5_finish\0A#define mbedtls_md5_ret               mbedtls_md5\0A#define mbedtls_ripemd160_starts_ret  mbedtls_ripemd160_starts\0A#define mbedtls_ripemd160_update_ret  mbedtls_ripemd160_update\0A#define mbedtls_ripemd160_finish_ret  mbedtls_ripemd160_finish\0A#define mbedtls_ripemd160_ret         mbedtls_ripemd160\0A#define mbedtls_sha1_starts_ret       mbedtls_sha1_starts\0A#define mbedtls_sha1_update_ret       mbedtls_sha1_update\0A#define mbedtls_sha1_finish_ret       mbedtls_sha1_finish\0A#define mbedtls_sha1_ret              mbedtls_sha1\0A#define mbedtls_sha256_starts_ret     mbedtls_sha256_starts\0A#define mbedtls_sha256_update_ret     mbedtls_sha256_update\0A#define mbedtls_sha256_finish_ret     mbedtls_sha256_finish\0A#define mbedtls_sha256_ret            mbedtls_sha256\0A#define mbedtls_sha512_starts_ret     mbedtls_sha512_starts\0A#define mbedtls_sha512_update_ret     mbedtls_sha512_update\0A#define mbedtls_sha512_finish_ret     mbedtls_sha512_finish\0A#define mbedtls_sha512_ret            mbedtls_sha512\0A\0A#endif /* MBEDTLS_COMPAT2X_H */\0A\00" }
