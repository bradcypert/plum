@.str41414 = private global { i64, i64, [19995 x i8] } { i64 -1, i64 19994, [19995 x i8] c"/*\0A *  PSA ECP layer on top of Mbed TLS crypto\0A */\0A/*\0A *  Copyright The Mbed TLS Contributors\0A *  SPDX-License-Identifier: Apache-2.0 OR GPL-2.0-or-later\0A */\0A\0A#include \22common.h\22\0A\0A#if defined(MBEDTLS_PSA_CRYPTO_C)\0A\0A#include <psa/crypto.h>\0A#include \22psa_crypto_core.h\22\0A#include \22psa_crypto_ecp.h\22\0A#include \22psa_crypto_random_impl.h\22\0A#include \22mbedtls/psa_util.h\22\0A\0A#include <stdlib.h>\0A#include <string.h>\0A#include \22mbedtls/platform.h\22\0A\0A#include <mbedtls/ecdsa.h>\0A#include <mbedtls/ecdh.h>\0A#include <mbedtls/ecp.h>\0A#include <mbedtls/error.h>\0A\0A#if defined(MBEDTLS_PSA_BUILTIN_KEY_TYPE_ECC_KEY_PAIR_BASIC) || \5C\0A    defined(MBEDTLS_PSA_BUILTIN_KEY_TYPE_ECC_KEY_PAIR_IMPORT) || \5C\0A    defined(MBEDTLS_PSA_BUILTIN_KEY_TYPE_ECC_KEY_PAIR_EXPORT) || \5C\0A    defined(MBEDTLS_PSA_BUILTIN_KEY_TYPE_ECC_PUBLIC_KEY) || \5C\0A    defined(MBEDTLS_PSA_BUILTIN_ALG_ECDSA) || \5C\0A    defined(MBEDTLS_PSA_BUILTIN_ALG_DETERMINISTIC_ECDSA) || \5C\0A    defined(MBEDTLS_PSA_BUILTIN_ALG_ECDH)\0A/* Helper function to verify if the provided EC's family and key bit size are valid.\0A *\0A * Note: \22bits\22 parameter is used both as input and output and it might be updated\0A *       in case provided input value is not multiple of 8 (\22sloppy\22 bits).\0A */\0Astatic int check_ecc_parameters(psa_ecc_family_t family, size_t *bits)\0A{\0A    switch (family) {\0A        case PSA_ECC_FAMILY_SECP_R1:\0A            switch (*bits) {\0A                case 192:\0A                case 224:\0A                case 256:\0A                case 384:\0A                case 521:\0A                    return PSA_SUCCESS;\0A                case 528:\0A                    *bits = 521;\0A                    return PSA_SUCCESS;\0A            }\0A            break;\0A\0A        case PSA_ECC_FAMILY_BRAINPOOL_P_R1:\0A            switch (*bits) {\0A                case 256:\0A                case 384:\0A                case 512:\0A                    return PSA_SUCCESS;\0A            }\0A            break;\0A\0A        case PSA_ECC_FAMILY_MONTGOMERY:\0A            switch (*bits) {\0A                case 448:\0A                case 255:\0A                    return PSA_SUCCESS;\0A                case 256:\0A                    *bits = 255;\0A                    return PSA_SUCCESS;\0A            }\0A            break;\0A\0A        case PSA_ECC_FAMILY_SECP_K1:\0A            switch (*bits) {\0A                case 192:\0A                /* secp224k1 is not and will not be supported in PSA (#3541). */\0A                case 256:\0A                    return PSA_SUCCESS;\0A            }\0A            break;\0A    }\0A\0A    return PSA_ERROR_INVALID_ARGUMENT;\0A}\0A\0Apsa_status_t mbedtls_psa_ecp_load_representation(\0A    psa_key_type_t type, size_t curve_bits,\0A    const uint8_t *data, size_t data_length,\0A    mbedtls_ecp_keypair **p_ecp)\0A{\0A    mbedtls_ecp_group_id grp_id = MBEDTLS_ECP_DP_NONE;\0A    psa_status_t status;\0A    mbedtls_ecp_keypair *ecp = NULL;\0A    size_t curve_bytes = data_length;\0A    int explicit_bits = (curve_bits != 0);\0A\0A    if (PSA_KEY_TYPE_IS_PUBLIC_KEY(type) &&\0A        PSA_KEY_TYPE_ECC_GET_FAMILY(type) != PSA_ECC_FAMILY_MONTGOMERY) {\0A        /* A Weierstrass public key is represented as:\0A         * - The byte 0x04;\0A         * - `x_P` as a `ceiling(m/8)`-byte string, big-endian;\0A         * - `y_P` as a `ceiling(m/8)`-byte string, big-endian.\0A         * So its data length is 2m+1 where m is the curve size in bits.\0A         */\0A        if ((data_length & 1) == 0) {\0A            return PSA_ERROR_INVALID_ARGUMENT;\0A        }\0A        curve_bytes = data_length / 2;\0A\0A        /* Montgomery public keys are represented in compressed format, meaning\0A         * their curve_bytes is equal to the amount of input. */\0A\0A        /* Private keys are represented in uncompressed private random integer\0A         * format, meaning their curve_bytes is equal to the amount of input. */\0A    }\0A\0A    if (explicit_bits) {\0A        /* With an explicit bit-size, the data must have the matching length. */\0A        if (curve_bytes != PSA_BITS_TO_BYTES(curve_bits)) {\0A            return PSA_ERROR_INVALID_ARGUMENT;\0A        }\0A    } else {\0A        /* We need to infer the bit-size from the data. Since the only\0A         * information we have is the length in bytes, the value of curve_bits\0A         * at this stage is rounded up to the nearest multiple of 8. */\0A        curve_bits = PSA_BYTES_TO_BITS(curve_bytes);\0A    }\0A\0A    /* Allocate and initialize a key representation. */\0A    ecp = mbedtls_calloc(1, sizeof(mbedtls_ecp_keypair));\0A    if (ecp == NULL) {\0A        return PSA_ERROR_INSUFFICIENT_MEMORY;\0A    }\0A    mbedtls_ecp_keypair_init(ecp);\0A\0A    status = check_ecc_parameters(PSA_KEY_TYPE_ECC_GET_FAMILY(type), &curve_bits);\0A    if (status != PSA_SUCCESS) {\0A        goto exit;\0A    }\0A\0A    /* Load the group. */\0A    grp_id = mbedtls_ecc_group_from_psa(PSA_KEY_TYPE_ECC_GET_FAMILY(type),\0A                                        curve_bits);\0A    if (grp_id == MBEDTLS_ECP_DP_NONE) {\0A        status = PSA_ERROR_NOT_SUPPORTED;\0A        goto exit;\0A    }\0A\0A    status = mbedtls_to_psa_error(\0A        mbedtls_ecp_group_load(&ecp->grp, grp_id));\0A    if (status != PSA_SUCCESS) {\0A        goto exit;\0A    }\0A\0A    /* Load the key material. */\0A    if (PSA_KEY_TYPE_IS_PUBLIC_KEY(type)) {\0A        /* Load the public value. */\0A        status = mbedtls_to_psa_error(\0A            mbedtls_ecp_point_read_binary(&ecp->grp, &ecp->Q,\0A                                          data,\0A                                          data_length));\0A        if (status != PSA_SUCCESS) {\0A            goto exit;\0A        }\0A\0A        /* Check that the point is on the curve. */\0A        status = mbedtls_to_psa_error(\0A            mbedtls_ecp_check_pubkey(&ecp->grp, &ecp->Q));\0A        if (status != PSA_SUCCESS) {\0A            goto exit;\0A        }\0A    } else {\0A        /* Load and validate the secret value. */\0A        status = mbedtls_to_psa_error(\0A            mbedtls_ecp_read_key(ecp->grp.id,\0A                                 ecp,\0A                                 data,\0A                                 data_length));\0A        if (status != PSA_SUCCESS) {\0A            goto exit;\0A        }\0A    }\0A\0A    *p_ecp = ecp;\0Aexit:\0A    if (status != PSA_SUCCESS) {\0A        mbedtls_ecp_keypair_free(ecp);\0A        mbedtls_free(ecp);\0A    }\0A\0A    return status;\0A}\0A#endif /* defined(MBEDTLS_PSA_BUILTIN_KEY_TYPE_ECC_KEY_PAIR_BASIC) ||\0A        * defined(MBEDTLS_PSA_BUILTIN_KEY_TYPE_ECC_KEY_PAIR_IMPORT) ||\0A        * defined(MBEDTLS_PSA_BUILTIN_KEY_TYPE_ECC_KEY_PAIR_EXPORT) ||\0A        * defined(MBEDTLS_PSA_BUILTIN_KEY_TYPE_ECC_PUBLIC_KEY) ||\0A        * defined(MBEDTLS_PSA_BUILTIN_ALG_ECDSA) ||\0A        * defined(MBEDTLS_PSA_BUILTIN_ALG_DETERMINISTIC_ECDSA) ||\0A        * defined(MBEDTLS_PSA_BUILTIN_ALG_ECDH) */\0A\0A#if defined(MBEDTLS_PSA_BUILTIN_KEY_TYPE_ECC_KEY_PAIR_IMPORT) || \5C\0A    defined(MBEDTLS_PSA_BUILTIN_KEY_TYPE_ECC_KEY_PAIR_EXPORT) || \5C\0A    defined(MBEDTLS_PSA_BUILTIN_KEY_TYPE_ECC_PUBLIC_KEY)\0A\0Apsa_status_t mbedtls_psa_ecp_import_key(\0A    const psa_key_attributes_t *attributes,\0A    const uint8_t *data, size_t data_length,\0A    uint8_t *key_buffer, size_t key_buffer_size,\0A    size_t *key_buffer_length, size_t *bits)\0A{\0A    psa_status_t status;\0A    mbedtls_ecp_keypair *ecp = NULL;\0A\0A    /* Parse input */\0A    status = mbedtls_psa_ecp_load_representation(attributes->type,\0A                                                 attributes->bits,\0A                                                 data,\0A                                                 data_length,\0A                                                 &ecp);\0A    if (status != PSA_SUCCESS) {\0A        goto exit;\0A    }\0A\0A    if (PSA_KEY_TYPE_ECC_GET_FAMILY(attributes->type) ==\0A        PSA_ECC_FAMILY_MONTGOMERY) {\0A        *bits = ecp->grp.nbits + 1;\0A    } else {\0A        *bits = ecp->grp.nbits;\0A    }\0A\0A    /* Re-export the data to PSA export format. There is currently no support\0A     * for other input formats then the export format, so this is a 1-1\0A     * copy operation. */\0A    status = mbedtls_psa_ecp_export_key(attributes->type,\0A                                        ecp,\0A                                        key_buffer,\0A                                        key_buffer_size,\0A                                        key_buffer_length);\0Aexit:\0A    /* Always free the PK object (will also free contained ECP context) */\0A    mbedtls_ecp_keypair_free(ecp);\0A    mbedtls_free(ecp);\0A\0A    return status;\0A}\0A\0Apsa_status_t mbedtls_psa_ecp_export_key(psa_key_type_t type,\0A                                        mbedtls_ecp_keypair *ecp,\0A                                        uint8_t *data,\0A                                        size_t data_size,\0A                                        size_t *data_length)\0A{\0A    psa_status_t status;\0A\0A    if (PSA_KEY_TYPE_IS_PUBLIC_KEY(type)) {\0A        /* Check whether the public part is loaded */\0A        if (mbedtls_ecp_is_zero(&ecp->Q)) {\0A            /* Calculate the public key */\0A            status = mbedtls_to_psa_error(\0A                mbedtls_ecp_mul(&ecp->grp, &ecp->Q, &ecp->d, &ecp->grp.G,\0A                                mbedtls_psa_get_random,\0A                                MBEDTLS_PSA_RANDOM_STATE));\0A            if (status != PSA_SUCCESS) {\0A                return status;\0A            }\0A        }\0A\0A        status = mbedtls_to_psa_error(\0A            mbedtls_ecp_point_write_binary(&ecp->grp, &ecp->Q,\0A                                           MBEDTLS_ECP_PF_UNCOMPRESSED,\0A                                           data_length,\0A                                           data,\0A                                           data_size));\0A        if (status != PSA_SUCCESS) {\0A            memset(data, 0, data_size);\0A        }\0A\0A        return status;\0A    } else {\0A        status = mbedtls_to_psa_error(\0A            mbedtls_ecp_write_key_ext(ecp, data_length, data, data_size));\0A        return status;\0A    }\0A}\0A\0Apsa_status_t mbedtls_psa_ecp_export_public_key(\0A    const psa_key_attributes_t *attributes,\0A    const uint8_t *key_buffer, size_t key_buffer_size,\0A    uint8_t *data, size_t data_size, size_t *data_length)\0A{\0A    psa_status_t status = PSA_ERROR_CORRUPTION_DETECTED;\0A    mbedtls_ecp_keypair *ecp = NULL;\0A\0A    status = mbedtls_psa_ecp_load_representation(\0A        attributes->type, attributes->bits,\0A        key_buffer, key_buffer_size, &ecp);\0A    if (status != PSA_SUCCESS) {\0A        return status;\0A    }\0A\0A    status = mbedtls_psa_ecp_export_key(\0A        PSA_KEY_TYPE_ECC_PUBLIC_KEY(\0A            PSA_KEY_TYPE_ECC_GET_FAMILY(attributes->type)),\0A        ecp, data, data_size, data_length);\0A\0A    mbedtls_ecp_keypair_free(ecp);\0A    mbedtls_free(ecp);\0A\0A    return status;\0A}\0A#endif /* defined(MBEDTLS_PSA_BUILTIN_KEY_TYPE_ECC_KEY_PAIR_IMPORT) ||\0A        * defined(MBEDTLS_PSA_BUILTIN_KEY_TYPE_ECC_KEY_PAIR_EXPORT) ||\0A        * defined(MBEDTLS_PSA_BUILTIN_KEY_TYPE_ECC_PUBLIC_KEY) */\0A\0A#if defined(MBEDTLS_PSA_BUILTIN_KEY_TYPE_ECC_KEY_PAIR_GENERATE)\0Apsa_status_t mbedtls_psa_ecp_generate_key(\0A    const psa_key_attributes_t *attributes,\0A    uint8_t *key_buffer, size_t key_buffer_size, size_t *key_buffer_length)\0A{\0A    psa_ecc_family_t curve = PSA_KEY_TYPE_ECC_GET_FAMILY(\0A        attributes->type);\0A    mbedtls_ecp_group_id grp_id =\0A        mbedtls_ecc_group_from_psa(curve, attributes->bits);\0A    if (grp_id == MBEDTLS_ECP_DP_NONE) {\0A        return PSA_ERROR_NOT_SUPPORTED;\0A    }\0A\0A    mbedtls_ecp_keypair ecp;\0A    mbedtls_ecp_keypair_init(&ecp);\0A    int ret = MBEDTLS_ERR_ERROR_CORRUPTION_DETECTED;\0A\0A    ret = mbedtls_ecp_group_load(&ecp.grp, grp_id);\0A    if (ret != 0) {\0A        goto exit;\0A    }\0A\0A    ret = mbedtls_ecp_gen_privkey(&ecp.grp, &ecp.d,\0A                                  mbedtls_psa_get_random,\0A                                  MBEDTLS_PSA_RANDOM_STATE);\0A    if (ret != 0) {\0A        goto exit;\0A    }\0A\0A    ret = mbedtls_ecp_write_key_ext(&ecp, key_buffer_length,\0A                                    key_buffer, key_buffer_size);\0A\0Aexit:\0A    mbedtls_ecp_keypair_free(&ecp);\0A    return mbedtls_to_psa_error(ret);\0A}\0A#endif /* MBEDTLS_PSA_BUILTIN_KEY_TYPE_ECC_KEY_PAIR_GENERATE */\0A\0A/****************************************************************/\0A/* ECDSA sign/verify */\0A/****************************************************************/\0A\0A#if defined(MBEDTLS_PSA_BUILTIN_ALG_ECDSA) || \5C\0A    defined(MBEDTLS_PSA_BUILTIN_ALG_DETERMINISTIC_ECDSA)\0Apsa_status_t mbedtls_psa_ecdsa_sign_hash(\0A    const psa_key_attributes_t *attributes,\0A    const uint8_t *key_buffer, size_t key_buffer_size,\0A    psa_algorithm_t alg, const uint8_t *hash, size_t hash_length,\0A    uint8_t *signature, size_t signature_size, size_t *signature_length)\0A{\0A    psa_status_t status = PSA_ERROR_CORRUPTION_DETECTED;\0A    mbedtls_ecp_keypair *ecp = NULL;\0A    int ret = MBEDTLS_ERR_ERROR_CORRUPTION_DETECTED;\0A    size_t curve_bytes;\0A    mbedtls_mpi r, s;\0A\0A    status = mbedtls_psa_ecp_load_representation(attributes->type,\0A                                                 attributes->bits,\0A                                                 key_buffer,\0A                                                 key_buffer_size,\0A                                                 &ecp);\0A    if (status != PSA_SUCCESS) {\0A        return status;\0A    }\0A\0A    curve_bytes = PSA_BITS_TO_BYTES(ecp->grp.pbits);\0A    mbedtls_mpi_init(&r);\0A    mbedtls_mpi_init(&s);\0A\0A    if (signature_size < 2 * curve_bytes) {\0A        ret = MBEDTLS_ERR_ECP_BUFFER_TOO_SMALL;\0A        goto cleanup;\0A    }\0A\0A    if (PSA_ALG_ECDSA_IS_DETERMINISTIC(alg)) {\0A#if defined(MBEDTLS_PSA_BUILTIN_ALG_DETERMINISTIC_ECDSA)\0A        psa_algorithm_t hash_alg = PSA_ALG_SIGN_GET_HASH(alg);\0A        mbedtls_md_type_t md_alg = mbedtls_md_type_from_psa_alg(hash_alg);\0A        MBEDTLS_MPI_CHK(mbedtls_ecdsa_sign_det_ext(\0A                            &ecp->grp, &r, &s,\0A                            &ecp->d, hash,\0A                            hash_length, md_alg,\0A                            mbedtls_psa_get_random,\0A                            MBEDTLS_PSA_RANDOM_STATE));\0A#else\0A        ret = MBEDTLS_ERR_ECP_FEATURE_UNAVAILABLE;\0A        goto cleanup;\0A#endif /* defined(MBEDTLS_PSA_BUILTIN_ALG_DETERMINISTIC_ECDSA) */\0A    } else {\0A        (void) alg;\0A        MBEDTLS_MPI_CHK(mbedtls_ecdsa_sign(&ecp->grp, &r, &s, &ecp->d,\0A                                           hash, hash_length,\0A                                           mbedtls_psa_get_random,\0A                                           MBEDTLS_PSA_RANDOM_STATE));\0A    }\0A\0A    MBEDTLS_MPI_CHK(mbedtls_mpi_write_binary(&r,\0A                                             signature,\0A                                             curve_bytes));\0A    MBEDTLS_MPI_CHK(mbedtls_mpi_write_binary(&s,\0A                                             signature + curve_bytes,\0A                                             curve_bytes));\0Acleanup:\0A    mbedtls_mpi_free(&r);\0A    mbedtls_mpi_free(&s);\0A    if (ret == 0) {\0A        *signature_length = 2 * curve_bytes;\0A    }\0A\0A    mbedtls_ecp_keypair_free(ecp);\0A    mbedtls_free(ecp);\0A\0A    return mbedtls_to_psa_error(ret);\0A}\0A\0Apsa_status_t mbedtls_psa_ecp_load_public_part(mbedtls_ecp_keypair *ecp)\0A{\0A    int ret = 0;\0A\0A    /* Check whether the public part is loaded. If not, load it. */\0A    if (mbedtls_ecp_is_zero(&ecp->Q)) {\0A        ret = mbedtls_ecp_mul(&ecp->grp, &ecp->Q,\0A                              &ecp->d, &ecp->grp.G,\0A                              mbedtls_psa_get_random,\0A                              MBEDTLS_PSA_RANDOM_STATE);\0A    }\0A\0A    return mbedtls_to_psa_error(ret);\0A}\0A\0Apsa_status_t mbedtls_psa_ecdsa_verify_hash(\0A    const psa_key_attributes_t *attributes,\0A    const uint8_t *key_buffer, size_t key_buffer_size,\0A    psa_algorithm_t alg, const uint8_t *hash, size_t hash_length,\0A    const uint8_t *signature, size_t signature_length)\0A{\0A    psa_status_t status = PSA_ERROR_CORRUPTION_DETECTED;\0A    mbedtls_ecp_keypair *ecp = NULL;\0A    size_t curve_bytes;\0A    mbedtls_mpi r, s;\0A\0A    (void) alg;\0A\0A    status = mbedtls_psa_ecp_load_representation(attributes->type,\0A                                                 attributes->bits,\0A                                                 key_buffer,\0A                                                 key_buffer_size,\0A                                                 &ecp);\0A    if (status != PSA_SUCCESS) {\0A        return status;\0A    }\0A\0A    curve_bytes = PSA_BITS_TO_BYTES(ecp->grp.pbits);\0A    mbedtls_mpi_init(&r);\0A    mbedtls_mpi_init(&s);\0A\0A    if (signature_length != 2 * curve_bytes) {\0A        status = PSA_ERROR_INVALID_SIGNATURE;\0A        goto cleanup;\0A    }\0A\0A    status = mbedtls_to_psa_error(mbedtls_mpi_read_binary(&r,\0A                                                          signature,\0A                                                          curve_bytes));\0A    if (status != PSA_SUCCESS) {\0A        goto cleanup;\0A    }\0A\0A    status = mbedtls_to_psa_error(mbedtls_mpi_read_binary(&s,\0A                                                          signature + curve_bytes,\0A                                                          curve_bytes));\0A    if (status != PSA_SUCCESS) {\0A        goto cleanup;\0A    }\0A\0A    status = mbedtls_psa_ecp_load_public_part(ecp);\0A    if (status != PSA_SUCCESS) {\0A        goto cleanup;\0A    }\0A\0A    status = mbedtls_to_psa_error(mbedtls_ecdsa_verify(&ecp->grp, hash,\0A                                                       hash_length, &ecp->Q,\0A                                                       &r, &s));\0Acleanup:\0A    mbedtls_mpi_free(&r);\0A    mbedtls_mpi_free(&s);\0A    mbedtls_ecp_keypair_free(ecp);\0A    mbedtls_free(ecp);\0A\0A    return status;\0A}\0A\0A#endif /* defined(MBEDTLS_PSA_BUILTIN_ALG_ECDSA) || \5C\0A        * defined(MBEDTLS_PSA_BUILTIN_ALG_DETERMINISTIC_ECDSA) */\0A\0A/****************************************************************/\0A/* ECDH Key Agreement */\0A/****************************************************************/\0A\0A#if defined(MBEDTLS_PSA_BUILTIN_ALG_ECDH)\0Apsa_status_t mbedtls_psa_key_agreement_ecdh(\0A    const psa_key_attributes_t *attributes,\0A    const uint8_t *key_buffer, size_t key_buffer_size,\0A    psa_algorithm_t alg, const uint8_t *peer_key, size_t peer_key_length,\0A    uint8_t *shared_secret, size_t shared_secret_size,\0A    size_t *shared_secret_length)\0A{\0A    psa_status_t status;\0A    if (!PSA_KEY_TYPE_IS_ECC_KEY_PAIR(attributes->type) ||\0A        !PSA_ALG_IS_ECDH(alg)) {\0A        return PSA_ERROR_INVALID_ARGUMENT;\0A    }\0A    mbedtls_ecp_keypair *ecp = NULL;\0A    status = mbedtls_psa_ecp_load_representation(\0A        attributes->type,\0A        attributes->bits,\0A        key_buffer,\0A        key_buffer_size,\0A        &ecp);\0A    if (status != PSA_SUCCESS) {\0A        return status;\0A    }\0A    mbedtls_ecp_keypair *their_key = NULL;\0A    mbedtls_ecdh_context ecdh;\0A    size_t bits = 0;\0A    psa_ecc_family_t curve = mbedtls_ecc_group_to_psa(ecp->grp.id, &bits);\0A    mbedtls_ecdh_init(&ecdh);\0A\0A    status = mbedtls_psa_ecp_load_representation(\0A        PSA_KEY_TYPE_ECC_PUBLIC_KEY(curve),\0A        bits,\0A        peer_key,\0A        peer_key_length,\0A        &their_key);\0A    if (status != PSA_SUCCESS) {\0A        goto exit;\0A    }\0A\0A    status = mbedtls_to_psa_error(\0A        mbedtls_ecdh_get_params(&ecdh, their_key, MBEDTLS_ECDH_THEIRS));\0A    if (status != PSA_SUCCESS) {\0A        goto exit;\0A    }\0A    status = mbedtls_to_psa_error(\0A        mbedtls_ecdh_get_params(&ecdh, ecp, MBEDTLS_ECDH_OURS));\0A    if (status != PSA_SUCCESS) {\0A        goto exit;\0A    }\0A\0A    status = mbedtls_to_psa_error(\0A        mbedtls_ecdh_calc_secret(&ecdh,\0A                                 shared_secret_length,\0A                                 shared_secret, shared_secret_size,\0A                                 mbedtls_psa_get_random,\0A                                 MBEDTLS_PSA_RANDOM_STATE));\0A    if (status != PSA_SUCCESS) {\0A        goto exit;\0A    }\0A    if (PSA_BITS_TO_BYTES(bits) != *shared_secret_length) {\0A        status = PSA_ERROR_CORRUPTION_DETECTED;\0A    }\0Aexit:\0A    if (status != PSA_SUCCESS) {\0A        mbedtls_platform_zeroize(shared_secret, shared_secret_size);\0A    }\0A    mbedtls_ecdh_free(&ecdh);\0A    mbedtls_ecp_keypair_free(their_key);\0A    mbedtls_free(their_key);\0A    mbedtls_ecp_keypair_free(ecp);\0A    mbedtls_free(ecp);\0A    return status;\0A}\0A#endif /* MBEDTLS_PSA_BUILTIN_ALG_ECDH */\0A\0A\0A#endif /* MBEDTLS_PSA_CRYPTO_C */\0A\00" }
