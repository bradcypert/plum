         input,\0A                                          output,\0A                                          output_size));\0A#else\0A            status = PSA_ERROR_NOT_SUPPORTED;\0A#endif /* MBEDTLS_PSA_BUILTIN_ALG_RSA_PKCS1V15_CRYPT */\0A        } else\0A        if (PSA_ALG_IS_RSA_OAEP(alg)) {\0A#if defined(MBEDTLS_PSA_BUILTIN_ALG_RSA_OAEP)\0A            status = mbedtls_to_psa_error(\0A                psa_rsa_oaep_set_padding_mode(alg, rsa));\0A            if (status != PSA_SUCCESS) {\0A                goto rsa_exit;\0A            }\0A\0A            status = mbedtls_to_psa_error(\0A                mbedtls_rsa_rsaes_oaep_decrypt(rsa,\0A                                               mbedtls_psa_get_random,\0A                                               MBEDTLS_PSA_RANDOM_STATE,\0A                                               salt, salt_length,\0A                                               output_length,\0A                                               input,\0A                                               output,\0A                                               output_size));\0A#else\0A            status = PSA_ERROR_NOT_SUPPORTED;\0A#endif /* MBEDTLS_PSA_BUILTIN_ALG_RSA_OAEP */\0A        } else {\0A            status = PSA_ERROR_INVALID_ARGUMENT;\0A        }\0A\0A#if defined(MBEDTLS_PSA_BUILTIN_ALG_RSA_PKCS1V15_CRYPT) || \5C\0A        defined(MBEDTLS_PSA_BUILTIN_ALG_RSA_OAEP)\0Arsa_exit:\0A        mbedtls_rsa_free(rsa);\0A        mbedtls_free(rsa);\0A#endif /* defined(MBEDTLS_PSA_BUILTIN_ALG_RSA_PKCS1V15_CRYPT) ||\0A        * defined(MBEDTLS_PSA_BUILTIN_ALG_RSA_OAEP) */\0A    } else {\0A        status = PSA_ERROR_NOT_SUPPORTED;\0A    }\0A\0A    return status;\0A}\0A\0A#endif /* MBEDTLS_PSA_CRYPTO_C */\0A\00" }
