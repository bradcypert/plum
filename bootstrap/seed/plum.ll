@.str41956 = private global { i64, i64, [24891 x i8] } { i64 -1, i64 24890, [24891 x i8] c"/*\0A *  X.509 certificate writing\0A *\0A *  Copyright The Mbed TLS Contributors\0A *  SPDX-License-Identifier: Apache-2.0 OR GPL-2.0-or-later\0A */\0A/*\0A * References:\0A * - certificates: RFC 5280, updated by RFC 6818\0A * - CSRs: PKCS#10 v1.7 aka RFC 2986\0A * - attributes: PKCS#9 v2.0 aka RFC 2985\0A */\0A\0A#include \22common.h\22\0A\0A#if defined(MBEDTLS_X509_CRT_WRITE_C)\0A\0A#include \22mbedtls/x509_crt.h\22\0A#include \22x509_internal.h\22\0A#include \22mbedtls/asn1write.h\22\0A#include \22mbedtls/error.h\22\0A#include \22mbedtls/oid.h\22\0A#include \22mbedtls/platform.h\22\0A#include \22mbedtls/platform_util.h\22\0A#include \22mbedtls/md.h\22\0A\0A#include <string.h>\0A#include <stdint.h>\0A\0A#if defined(MBEDTLS_PEM_WRITE_C)\0A#include \22mbedtls/pem.h\22\0A#endif /* MBEDTLS_PEM_WRITE_C */\0A\0A#if defined(MBEDTLS_USE_PSA_CRYPTO)\0A#include \22psa/crypto.h\22\0A#include \22psa_util_internal.h\22\0A#include \22mbedtls/psa_util.h\22\0A#endif /* MBEDTLS_USE_PSA_CRYPTO */\0A\0Avoid mbedtls_x509write_crt_init(mbedtls_x509write_cert *ctx)\0A{\0A    memset(ctx, 0, sizeof(mbedtls_x509write_cert));\0A\0A    ctx->version = MBEDTLS_X509_CRT_VERSION_3;\0A}\0A\0Avoid mbedtls_x509write_crt_free(mbedtls_x509write_cert *ctx)\0A{\0A    if (ctx == NULL) {\0A        return;\0A    }\0A\0A    mbedtls_asn1_free_named_data_list(&ctx->subject);\0A    mbedtls_asn1_free_named_data_list(&ctx->issuer);\0A    mbedtls_asn1_free_named_data_list(&ctx->extensions);\0A\0A    mbedtls_platform_zeroize(ctx, sizeof(mbedtls_x509write_cert));\0A}\0A\0Avoid mbedtls_x509write_crt_set_version(mbedtls_x509write_cert *ctx,\0A                                       int version)\0A{\0A    ctx->version = version;\0A}\0A\0Avoid mbedtls_x509write_crt_set_md_alg(mbedtls_x509write_cert *ctx,\0A                                      mbedtls_md_type_t md_alg)\0A{\0A    ctx->md_alg = md_alg;\0A}\0A\0Avoid mbedtls_x509write_crt_set_subject_key(mbedtls_x509write_cert *ctx,\0A                                           mbedtls_pk_context *key)\0A{\0A    ctx->subject_key = key;\0A}\0A\0Avoid mbedtls_x509write_crt_set_issuer_key(mbedtls_x509write_cert *ctx,\0A                                          mbedtls_pk_context *key)\0A{\0A    ctx->issuer_key = key;\0A}\0A\0Aint mbedtls_x509write_crt_set_subject_name(mbedtls_x509write_cert *ctx,\0A                                           const char *subject_name)\0A{\0A    return mbedtls_x509_string_to_names(&ctx->subject, subject_name);\0A}\0A\0Aint mbedtls_x509write_crt_set_issuer_name(mbedtls_x509write_cert *ctx,\0A                                          const char *issuer_name)\0A{\0A    return mbedtls_x509_string_to_names(&ctx->issuer, issuer_name);\0A}\0A\0A#if defined(MBEDTLS_BIGNUM_C) && !defined(MBEDTLS_DEPRECATED_REMOVED)\0Aint mbedtls_x509write_crt_set_serial(mbedtls_x509write_cert *ctx,\0A                                     const mbedtls_mpi *serial)\0A{\0A    int ret;\0A    size_t tmp_len;\0A\0A    /* Ensure that the MPI value fits into the buffer */\0A    tmp_len = mbedtls_mpi_size(serial);\0A    if (tmp_len > MBEDTLS_X509_RFC5280_MAX_SERIAL_LEN) {\0A        return MBEDTLS_ERR_X509_BAD_INPUT_DATA;\0A    }\0A\0A    ctx->serial_len = tmp_len;\0A\0A    ret = mbedtls_mpi_write_binary(serial, ctx->serial, tmp_len);\0A    if (ret < 0) {\0A        return ret;\0A    }\0A\0A    return 0;\0A}\0A#endif // MBEDTLS_BIGNUM_C && !MBEDTLS_DEPRECATED_REMOVED\0A\0Aint mbedtls_x509write_crt_set_serial_raw(mbedtls_x509write_cert *ctx,\0A                                         unsigned char *serial, size_t serial_len)\0A{\0A    if (serial_len > MBEDTLS_X509_RFC5280_MAX_SERIAL_LEN) {\0A        return MBEDTLS_ERR_X509_BAD_INPUT_DATA;\0A    }\0A\0A    ctx->serial_len = serial_len;\0A    memcpy(ctx->serial, serial, serial_len);\0A\0A    return 0;\0A}\0A\0Aint mbedtls_x509write_crt_set_validity(mbedtls_x509write_cert *ctx,\0A                                       const char *not_before,\0A                                       const char *not_after)\0A{\0A    if (strlen(not_before) != MBEDTLS_X509_RFC5280_UTC_TIME_LEN - 1 ||\0A        strlen(not_after)  != MBEDTLS_X509_RFC5280_UTC_TIME_LEN - 1) {\0A        return MBEDTLS_ERR_X509_BAD_INPUT_DATA;\0A    }\0A    strncpy(ctx->not_before, not_before, MBEDTLS_X509_RFC5280_UTC_TIME_LEN);\0A    strncpy(ctx->not_after, not_after, MBEDTLS_X509_RFC5280_UTC_TIME_LEN);\0A    ctx->not_before[MBEDTLS_X509_RFC5280_UTC_TIME_LEN - 1] = 'Z';\0A    ctx->not_after[MBEDTLS_X509_RFC5280_UTC_TIME_LEN - 1] = 'Z';\0A\0A    return 0;\0A}\0A\0Aint mbedtls_x509write_crt_set_subject_alternative_name(mbedtls_x509write_cert *ctx,\0A                                                       const mbedtls_x509_san_list *san_list)\0A{\0A    return mbedtls_x509_write_set_san_common(&ctx->extensions, san_list);\0A}\0A\0A\0Aint mbedtls_x509write_crt_set_extension(mbedtls_x509write_cert *ctx,\0A                                        const char *oid, size_t oid_len,\0A                                        int critical,\0A                                        const unsigned char *val, size_t val_len)\0A{\0A    return mbedtls_x509_set_extension(&ctx->extensions, oid, oid_len,\0A                                      critical, val, val_len);\0A}\0A\0Aint mbedtls_x509write_crt_set_basic_constraints(mbedtls_x509write_cert *ctx,\0A                                                int is_ca, int max_pathlen)\0A{\0A    int ret = MBEDTLS_ERR_ERROR_CORRUPTION_DETECTED;\0A    unsigned char buf[9];\0A    unsigned char *c = buf + sizeof(buf);\0A    size_t len = 0;\0A\0A    memset(buf, 0, sizeof(buf));\0A\0A    if (is_ca && max_pathlen > 127) {\0A        return MBEDTLS_ERR_X509_BAD_INPUT_DATA;\0A    }\0A\0A    if (is_ca) {\0A        if (max_pathlen >= 0) {\0A            MBEDTLS_ASN1_CHK_ADD(len, mbedtls_asn1_write_int(&c, buf,\0A                                                             max_pathlen));\0A        }\0A        MBEDTLS_ASN1_CHK_ADD(len, mbedtls_asn1_write_bool(&c, buf, 1));\0A    }\0A\0A    MBEDTLS_ASN1_CHK_ADD(len, mbedtls_asn1_write_len(&c, buf, len));\0A    MBEDTLS_ASN1_CHK_ADD(len, mbedtls_asn1_write_tag(&c, buf,\0A                                                     MBEDTLS_ASN1_CONSTRUCTED |\0A                                                     MBEDTLS_ASN1_SEQUENCE));\0A\0A    return\0A        mbedtls_x509write_crt_set_extension(ctx, MBEDTLS_OID_BASIC_CONSTRAINTS,\0A                                            MBEDTLS_OID_SIZE(MBEDTLS_OID_BASIC_CONSTRAINTS),\0A                                            is_ca, buf + sizeof(buf) - len, len);\0A}\0A\0A#if defined(MBEDTLS_MD_CAN_SHA1)\0Astatic int mbedtls_x509write_crt_set_key_identifier(mbedtls_x509write_cert *ctx,\0A                                                    int is_ca,\0A                                                    unsigned char tag)\0A{\0A    int ret = MBEDTLS_ERR_ERROR_CORRUPTION_DETECTED;\0A    unsigned char buf[MBEDTLS_MPI_MAX_SIZE * 2 + 20]; /* tag, length + 2xMPI */\0A    unsigned char *c = buf + sizeof(buf);\0A    size_t len = 0;\0A#if defined(MBEDTLS_USE_PSA_CRYPTO)\0A    psa_status_t status = PSA_ERROR_CORRUPTION_DETECTED;\0A    size_t hash_length;\0A#endif /* MBEDTLS_USE_PSA_CRYPTO */\0A\0A    memset(buf, 0, sizeof(buf));\0A    MBEDTLS_ASN1_CHK_ADD(len,\0A                         mbedtls_pk_write_pubkey(&c,\0A                                                 buf,\0A                                                 is_ca ?\0A                                                 ctx->issuer_key :\0A                                                 ctx->subject_key));\0A\0A\0A#if defined(MBEDTLS_USE_PSA_CRYPTO)\0A    status = psa_hash_compute(PSA_ALG_SHA_1,\0A                              buf + sizeof(buf) - len,\0A                              len,\0A                              buf + sizeof(buf) - 20,\0A                              20,\0A                              &hash_length);\0A    if (status != PSA_SUCCESS) {\0A        return MBEDTLS_ERR_PLATFORM_HW_ACCEL_FAILED;\0A    }\0A#else\0A    ret = mbedtls_md(mbedtls_md_info_from_type(MBEDTLS_MD_SHA1),\0A                     buf + sizeof(buf) - len, len,\0A                     buf + sizeof(buf) - 20);\0A    if (ret != 0) {\0A        return ret;\0A    }\0A#endif /* MBEDTLS_USE_PSA_CRYPTO */\0A\0A    c = buf + sizeof(buf) - 20;\0A    len = 20;\0A\0A    MBEDTLS_ASN1_CHK_ADD(len, mbedtls_asn1_write_len(&c, buf, len));\0A    MBEDTLS_ASN1_CHK_ADD(len, mbedtls_asn1_write_tag(&c, buf, tag));\0A\0A    if (is_ca) { // writes AuthorityKeyIdentifier sequence\0A        MBEDTLS_ASN1_CHK_ADD(len, mbedtls_asn1_write_len(&c, buf, len));\0A        MBEDTLS_ASN1_CHK_ADD(len,\0A                             mbedtls_asn1_write_tag(&c,\0A                                                    buf,\0A                                                    MBEDTLS_ASN1_CONSTRUCTED |\0A                                                    MBEDTLS_ASN1_SEQUENCE));\0A    }\0A\0A    if (is_ca) {\0A        return mbedtls_x509write_crt_set_extension(ctx,\0A                                                   MBEDTLS_OID_AUTHORITY_KEY_IDENTIFIER,\0A                                                   MBEDTLS_OID_SIZE(\0A                                                       MBEDTLS_OID_AUTHORITY_KEY_IDENTIFIER),\0A                                                   0, buf + sizeof(buf) - len, len);\0A    } else {\0A        return mbedtls_x509write_crt_set_extension(ctx,\0A                                                   MBEDTLS_OID_SUBJECT_KEY_IDENTIFIER,\0A                                                   MBEDTLS_OID_SIZE(\0A                                                       MBEDTLS_OID_SUBJECT_KEY_IDENTIFIER),\0A                                                   0, buf + sizeof(buf) - len, len);\0A    }\0A}\0A\0Aint mbedtls_x509write_crt_set_subject_key_identifier(mbedtls_x509write_cert *ctx)\0A{\0A    return mbedtls_x509write_crt_set_key_identifier(ctx,\0A                                                    0,\0A                                                    MBEDTLS_ASN1_OCTET_STRING);\0A}\0A\0Aint mbedtls_x509write_crt_set_authority_key_identifier(mbedtls_x509write_cert *ctx)\0A{\0A    return mbedtls_x509write_crt_set_key_identifier(ctx,\0A                                                    1,\0A                                                    (MBEDTLS_ASN1_CONTEXT_SPECIFIC | 0));\0A}\0A#endif /* MBEDTLS_MD_CAN_SHA1 */\0A\0Aint mbedtls_x509write_crt_set_key_usage(mbedtls_x509write_cert *ctx,\0A                                        unsigned int key_usage)\0A{\0A    unsigned char buf[5] = { 0 }, ku[2] = { 0 };\0A    unsigned char *c;\0A    int ret = MBEDTLS_ERR_ERROR_CORRUPTION_DETECTED;\0A    const unsigned int allowed_bits = MBEDTLS_X509_KU_DIGITAL_SIGNATURE |\0A                                      MBEDTLS_X509_KU_NON_REPUDIATION   |\0A                                      MBEDTLS_X509_KU_KEY_ENCIPHERMENT  |\0A                                      MBEDTLS_X509_KU_DATA_ENCIPHERMENT |\0A                                      MBEDTLS_X509_KU_KEY_AGREEMENT     |\0A                                      MBEDTLS_X509_KU_KEY_CERT_SIGN     |\0A                                      MBEDTLS_X509_KU_CRL_SIGN          |\0A                                      MBEDTLS_X509_KU_ENCIPHER_ONLY     |\0A                                      MBEDTLS_X509_KU_DECIPHER_ONLY;\0A\0A    /* Check that nothing other than the allowed flags is set */\0A    if ((key_usage & ~allowed_bits) != 0) {\0A        return MBEDTLS_ERR_X509_FEATURE_UNAVAILABLE;\0A    }\0A\0A    c = buf + 5;\0A    MBEDTLS_PUT_UINT16_LE(key_usage, ku, 0);\0A    ret = mbedtls_asn1_write_named_bitstring(&c, buf, ku, 9);\0A\0A    if (ret < 0) {\0A        return ret;\0A    } else if (ret < 3 || ret > 5) {\0A        return MBEDTLS_ERR_X509_INVALID_FORMAT;\0A    }\0A\0A    ret = mbedtls_x509write_crt_set_extension(ctx, MBEDTLS_OID_KEY_USAGE,\0A                                              MBEDTLS_OID_SIZE(MBEDTLS_OID_KEY_USAGE),\0A                                              1, c, (size_t) ret);\0A    if (ret != 0) {\0A        return ret;\0A    }\0A\0A    return 0;\0A}\0A\0Aint mbedtls_x509write_crt_set_ext_key_usage(mbedtls_x509write_cert *ctx,\0A                                            const mbedtls_asn1_sequence *exts)\0A{\0A    unsigned char buf[256];\0A    unsigned char *c = buf + sizeof(buf);\0A    int ret;\0A    size_t len = 0;\0A    const mbedtls_asn1_sequence *last_ext = NULL;\0A    const mbedtls_asn1_sequence *ext;\0A\0A    memset(buf, 0, sizeof(buf));\0A\0A    /* We need at least one extension: SEQUENCE SIZE (1..MAX) OF KeyPurposeId */\0A    if (exts == NULL) {\0A        return MBEDTLS_ERR_X509_BAD_INPUT_DATA;\0A    }\0A\0A    /* Iterate over exts backwards, so we write them out in the requested order */\0A    while (last_ext != exts) {\0A        for (ext = exts; ext->next != last_ext; ext = ext->next) {\0A        }\0A        if (ext->buf.tag != MBEDTLS_ASN1_OID) {\0A            return MBEDTLS_ERR_X509_BAD_INPUT_DATA;\0A        }\0A        MBEDTLS_ASN1_CHK_ADD(len, mbedtls_asn1_write_raw_buffer(&c, buf, ext->buf.p, ext->buf.len));\0A        MBEDTLS_ASN1_CHK_ADD(len, mbedtls_asn1_write_len(&c, buf, ext->buf.len));\0A        MBEDTLS_ASN1_CHK_ADD(len, mbedtls_asn1_write_tag(&c, buf, MBEDTLS_ASN1_OID));\0A        last_ext = ext;\0A    }\0A\0A    MBEDTLS_ASN1_CHK_ADD(len, mbedtls_asn1_write_len(&c, buf, len));\0A    MBEDTLS_ASN1_CHK_ADD(len,\0A                         mbedtls_asn1_write_tag(&c, buf,\0A                                                MBEDTLS_ASN1_CONSTRUCTED | MBEDTLS_ASN1_SEQUENCE));\0A\0A    return mbedtls_x509write_crt_set_extension(ctx,\0A                                               MBEDTLS_OID_EXTENDED_KEY_USAGE,\0A                                               MBEDTLS_OID_SIZE(MBEDTLS_OID_EXTENDED_KEY_USAGE),\0A                                               1, c, len);\0A}\0A\0Aint mbedtls_x509write_crt_set_ns_cert_type(mbedtls_x509write_cert *ctx,\0A                                           unsigned char ns_cert_type)\0A{\0A    unsigned char buf[4] = { 0 };\0A    unsigned char *c;\0A    int ret = MBEDTLS_ERR_ERROR_CORRUPTION_DETECTED;\0A\0A    c = buf + 4;\0A\0A    ret = mbedtls_asn1_write_named_bitstring(&c, buf, &ns_cert_type, 8);\0A    if (ret < 3 || ret > 4) {\0A        return ret;\0A    }\0A\0A    ret = mbedtls_x509write_crt_set_extension(ctx, MBEDTLS_OID_NS_CERT_TYPE,\0A                                              MBEDTLS_OID_SIZE(MBEDTLS_OID_NS_CERT_TYPE),\0A                                              0, c, (size_t) ret);\0A    if (ret != 0) {\0A        return ret;\0A    }\0A\0A    return 0;\0A}\0A\0Astatic int x509_write_time(unsigned char **p, unsigned char *start,\0A                           const char *t, size_t size)\0A{\0A    int ret = MBEDTLS_ERR_ERROR_CORRUPTION_DETECTED;\0A    size_t len = 0;\0A\0A    /*\0A     * write MBEDTLS_ASN1_UTC_TIME if year < 2050 (2 bytes shorter)\0A     */\0A    if (t[0] < '2' || (t[0] == '2' && t[1] == '0' && t[2] < '5')) {\0A        MBEDTLS_ASN1_CHK_ADD(len, mbedtls_asn1_write_raw_buffer(p, start,\0A                                                                (const unsigned char *) t + 2,\0A                                                                size - 2));\0A        MBEDTLS_ASN1_CHK_ADD(len, mbedtls_asn1_write_len(p, start, len));\0A        MBEDTLS_ASN1_CHK_ADD(len, mbedtls_asn1_write_tag(p, start,\0A                                                         MBEDTLS_ASN1_UTC_TIME));\0A    } else {\0A        MBEDTLS_ASN1_CHK_ADD(len, mbedtls_asn1_write_raw_buffer(p, start,\0A                                                                (const unsigned char *) t,\0A                                                                size));\0A        MBEDTLS_ASN1_CHK_ADD(len, mbedtls_asn1_write_len(p, start, len));\0A        MBEDTLS_ASN1_CHK_ADD(len, mbedtls_asn1_write_tag(p, start,\0A                                                         MBEDTLS_ASN1_GENERALIZED_TIME));\0A    }\0A\0A    return (int) len;\0A}\0A\0Aint mbedtls_x509write_crt_der(mbedtls_x509write_cert *ctx,\0A                              unsigned char *buf, size_t size,\0A                              int (*f_rng)(void *, unsigned char *, size_t),\0A                              void *p_rng)\0A{\0A    int ret = MBEDTLS_ERR_ERROR_CORRUPTION_DETECTED;\0A    const char *sig_oid;\0A    size_t sig_oid_len = 0;\0A    unsigned char *c, *c2;\0A    unsigned char sig[MBEDTLS_PK_SIGNATURE_MAX_SIZE];\0A    size_t hash_length = 0;\0A    unsigned char hash[MBEDTLS_MD_MAX_SIZE];\0A#if defined(MBEDTLS_USE_PSA_CRYPTO)\0A    psa_status_t status = PSA_ERROR_CORRUPTION_DETECTED;\0A    psa_algorithm_t psa_algorithm;\0A#endif /* MBEDTLS_USE_PSA_CRYPTO */\0A\0A    size_t sub_len = 0, pub_len = 0, sig_and_oid_len = 0, sig_len;\0A    size_t len = 0;\0A    mbedtls_pk_type_t pk_alg;\0A    int write_sig_null_par;\0A\0A    /*\0A     * Prepare data to be signed at the end of the target buffer\0A     */\0A    c = buf + size;\0A\0A    /* Signature algorithm needed in TBS, and later for actual signature */\0A\0A    /* There's no direct way of extracting a signature algorithm\0A     * (represented as an element of mbedtls_pk_type_t) from a PK instance. */\0A    if (mbedtls_pk_can_do(ctx->issuer_key, MBEDTLS_PK_RSA)) {\0A        pk_alg = MBEDTLS_PK_RSA;\0A    } else if (mbedtls_pk_can_do(ctx->issuer_key, MBEDTLS_PK_ECDSA)) {\0A        pk_alg = MBEDTLS_PK_ECDSA;\0A    } else {\0A        return MBEDTLS_ERR_X509_INVALID_ALG;\0A    }\0A\0A    if ((ret = mbedtls_oid_get_oid_by_sig_alg(pk_alg, ctx->md_alg,\0A                                              &sig_oid, &sig_oid_len)) != 0) {\0A        return ret;\0A    }\0A\0A    /*\0A     *  Extensions  ::=  SEQUENCE SIZE (1..MAX) OF Extension\0A     */\0A\0A    /* Only for v3 */\0A    if (ctx->version == MBEDTLS_X509_CRT_VERSION_3) {\0A        MBEDTLS_ASN1_CHK_ADD(len,\0A                             mbedtls_x509_write_extensions(&c,\0A                                                           buf, ctx->extensions));\0A        MBEDTLS_ASN1_CHK_ADD(len, mbedtls_asn1_write_len(&c, buf, len));\0A        MBEDTLS_ASN1_CHK_ADD(len,\0A                             mbedtls_asn1_write_tag(&c, buf,\0A                                                    MBEDTLS_ASN1_CONSTRUCTED |\0A                                                    MBEDTLS_ASN1_SEQUENCE));\0A        MBEDTLS_ASN1_CHK_ADD(len, mbedtls_asn1_write_len(&c, buf, len));\0A        MBEDTLS_ASN1_CHK_ADD(len,\0A                             mbedtls_asn1_write_tag(&c, buf,\0A                                                    MBEDTLS_ASN1_CONTEXT_SPECIFIC |\0A                                                    MBEDTLS_ASN1_CONSTRUCTED | 3));\0A    }\0A\0A    /*\0A     *  SubjectPublicKeyInfo\0A     */\0A    MBEDTLS_ASN1_CHK_ADD(pub_len,\0A                         mbedtls_pk_write_pubkey_der(ctx->subject_key,\0A                                                     buf, (size_t) (c - buf)));\0A    c -= pub_len;\0A    len += pub_len;\0A\0A    /*\0A     *  Subject  ::=  Name\0A     */\0A    MBEDTLS_ASN1_CHK_ADD(len,\0A                         mbedtls_x509_write_names(&c, buf,\0A                                                  ctx->subject));\0A\0A    /*\0A     *  Validity ::= SEQUENCE {\0A     *       notBefore      Time,\0A     *       notAfter       Time }\0A     */\0A    sub_len = 0;\0A\0A    MBEDTLS_ASN1_CHK_ADD(sub_len,\0A                         x509_write_time(&c, buf, ctx->not_after,\0A                                         MBEDTLS_X509_RFC5280_UTC_TIME_LEN));\0A\0A    MBEDTLS_ASN1_CHK_ADD(sub_len,\0A                         x509_write_time(&c, buf, ctx->not_before,\0A                                         MBEDTLS_X509_RFC5280_UTC_TIME_LEN));\0A\0A    len += sub_len;\0A    MBEDTLS_ASN1_CHK_ADD(len, mbedtls_asn1_write_len(&c, buf, sub_len));\0A    MBEDTLS_ASN1_CHK_ADD(len,\0A                         mbedtls_asn1_write_tag(&c, buf,\0A                                                MBEDTLS_ASN1_CONSTRUCTED |\0A                                                MBEDTLS_ASN1_SEQUENCE));\0A\0A    /*\0A     *  Issuer  ::=  Name\0A     */\0A    MBEDTLS_ASN1_CHK_ADD(len, mbedtls_x509_write_names(&c, buf,\0A                                                       ctx->issuer));\0A\0A    /*\0A     *  Signature   ::=  AlgorithmIdentifier\0A     */\0A    if (pk_alg == MBEDTLS_PK_ECDSA) {\0A        /*\0A         * The AlgorithmIdentifier's parameters field must be absent for DSA/ECDSA signature\0A         * algorithms, see https://www.rfc-editor.org/rfc/rfc5480#page-17 and\0A         * https://www.rfc-editor.org/rfc/rfc5758#section-3.\0A         */\0A        write_sig_null_par = 0;\0A    } else {\0A        write_sig_null_par = 1;\0A    }\0A    MBEDTLS_ASN1_CHK_ADD(len,\0A                         mbedtls_asn1_write_algorithm_identifier_ext(&c, buf,\0A                                                                     sig_oid, strlen(sig_oid),\0A                                                                     0, write_sig_null_par));\0A\0A    /*\0A     *  Serial   ::=  INTEGER\0A     *\0A     * Written data is:\0A     * - \22ctx->serial_len\22 bytes for the raw serial buffer\0A     *   - if MSb of \22serial\22 is 1, then prepend an extra 0x00 byte\0A     * - 1 byte for the length\0A     * - 1 byte for the TAG\0A     */\0A    MBEDTLS_ASN1_CHK_ADD(len, mbedtls_asn1_write_raw_buffer(&c, buf,\0A                                                            ctx->serial, ctx->serial_len));\0A    if (*c & 0x80) {\0A        if (c - buf < 1) {\0A            return MBEDTLS_ERR_X509_BUFFER_TOO_SMALL;\0A        }\0A        *(--c) = 0x0;\0A        len++;\0A        MBEDTLS_ASN1_CHK_ADD(len, mbedtls_asn1_write_len(&c, buf,\0A                                                         ctx->serial_len + 1));\0A    } else {\0A        MBEDTLS_ASN1_CHK_ADD(len, mbedtls_asn1_write_len(&c, buf,\0A                                                         ctx->serial_len));\0A    }\0A    MBEDTLS_ASN1_CHK_ADD(len, mbedtls_asn1_write_tag(&c, buf,\0A                                                     MBEDTLS_ASN1_INTEGER));\0A\0A    /*\0A     *  Version  ::=  INTEGER  {  v1(0), v2(1), v3(2)  }\0A     */\0A\0A    /* Can be omitted for v1 */\0A    if (ctx->version != MBEDTLS_X509_CRT_VERSION_1) {\0A        sub_len = 0;\0A        MBEDTLS_ASN1_CHK_ADD(sub_len,\0A                             mbedtls_asn1_write_int(&c, buf, ctx->version));\0A        len += sub_len;\0A        MBEDTLS_ASN1_CHK_ADD(len,\0A                             mbedtls_asn1_write_len(&c, buf, sub_len));\0A        MBEDTLS_ASN1_CHK_ADD(len,\0A                             mbedtls_asn1_write_tag(&c, buf,\0A                                                    MBEDTLS_ASN1_CONTEXT_SPECIFIC |\0A                                                    MBEDTLS_ASN1_CONSTRUCTED | 0));\0A    }\0A\0A    MBEDTLS_ASN1_CHK_ADD(len, mbedtls_asn1_write_len(&c, buf, len));\0A    MBEDTLS_ASN1_CHK_ADD(len,\0A                         mbedtls_asn1_write_tag(&c, buf, MBEDTLS_ASN1_CONSTRUCTED |\0A                                                MBEDTLS_ASN1_SEQUENCE));\0A\0A    /*\0A     * Make signature\0A     */\0A\0A    /* Compute hash of CRT. */\0A#if defined(MBEDTLS_USE_PSA_CRYPTO)\0A    psa_algorithm = mbedtls_md_psa_alg_from_type(ctx->md_alg);\0A\0A    status = psa_hash_compute(psa_algorithm,\0A                              c,\0A                              len,\0A                              hash,\0A                              sizeof(hash),\0A                              &hash_length);\0A    if (status != PSA_SUCCESS) {\0A        return MBEDTLS_ERR_PLATFORM_HW_ACCEL_FAILED;\0A    }\0A#else\0A    if ((ret = mbedtls_md(mbedtls_md_info_from_type(ctx->md_alg), c,\0A                          len, hash)) != 0) {\0A        return ret;\0A    }\0A#endif /* MBEDTLS_USE_PSA_CRYPTO */\0A\0A\0A    if ((ret = mbedtls_pk_sign(ctx->issuer_key, ctx->md_alg,\0A                               hash, hash_length, sig, sizeof(sig), &sig_len,\0A                               f_rng, p_rng)) != 0) {\0A        return ret;\0A    }\0A\0A    /* Move CRT to the front of the buffer to have space\0A     * for the signature. */\0A    memmove(buf, c, len);\0A    c = buf + len;\0A\0A    /* Add signature at the end of the buffer,\0A     * making sure that it doesn't underflow\0A     * into the CRT buffer. */\0A    c2 = buf + size;\0A    MBEDTLS_ASN1_CHK_ADD(sig_and_oid_len, mbedtls_x509_write_sig(&c2, c,\0A                                                                 sig_oid, sig_oid_len,\0A                                                                 sig, sig_len, pk_alg));\0A\0A    /*\0A     * Memory layout after this step:\0A     *\0A     * buf       c=buf+len                c2            buf+size\0A     * [CRT0,...,CRTn, UNUSED, ..., UNUSED, SIG0, ..., SIGm]\0A     */\0A\0A    /* Move raw CRT to just before the signature. */\0A    c = c2 - len;\0A    memmove(c, buf, len);\0A\0A    len += sig_and_oid_len;\0A    MBEDTLS_ASN1_CHK_ADD(len, mbedtls_asn1_write_len(&c, buf, len));\0A    MBEDTLS_ASN1_CHK_ADD(len, mbedtls_asn1_write_tag(&c, buf,\0A                                                     MBEDTLS_ASN1_CONSTRUCTED |\0A                                                     MBEDTLS_ASN1_SEQUENCE));\0A\0A    return (int) len;\0A}\0A\0A#define PEM_BEGIN_CRT           \22-----BEGIN CERTIFICATE-----\5Cn\22\0A#define PEM_END_CRT             \22-----END CERTIFICATE-----\5Cn\22\0A\0A#if defined(MBEDTLS_PEM_WRITE_C)\0Aint mbedtls_x509write_crt_pem(mbedtls_x509write_cert *crt,\0A                              unsigned char *buf, size_t size,\0A                              int (*f_rng)(void *, unsigned char *, size_t),\0A                              void *p_rng)\0A{\0A    int ret = MBEDTLS_ERR_ERROR_CORRUPTION_DETECTED;\0A    size_t olen;\0A\0A    if ((ret = mbedtls_x509write_crt_der(crt, buf, size,\0A                                         f_rng, p_rng)) < 0) {\0A        return ret;\0A    }\0A\0A    if ((ret = mbedtls_pem_write_buffer(PEM_BEGIN_CRT, PEM_END_CRT,\0A                                        buf + size - ret, ret,\0A                                        buf, size, &olen)) != 0) {\0A        return ret;\0A    }\0A\0A    return 0;\0A}\0A#endif /* MBEDTLS_PEM_WRITE_C */\0A\0A#endif /* MBEDTLS_X509_CRT_WRITE_C */\0A\00" }
