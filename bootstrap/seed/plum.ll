                        const mbedtls_ecp_keypair *key,\0A                            mbedtls_ecdh_side side)\0A{\0A    int ret = MBEDTLS_ERR_ERROR_CORRUPTION_DETECTED;\0A    if (side != MBEDTLS_ECDH_OURS && side != MBEDTLS_ECDH_THEIRS) {\0A        return MBEDTLS_ERR_ECP_BAD_INPUT_DATA;\0A    }\0A\0A    if (mbedtls_ecdh_grp_id(ctx) == MBEDTLS_ECP_DP_NONE) {\0A        /* This is the first call to get_params(). Set up the context\0A         * for use with the group. */\0A        if ((ret = mbedtls_ecdh_setup(ctx, key->grp.id)) != 0) {\0A            return ret;\0A        }\0A    } else {\0A        /* This is not the first call to get_params(). Check that the\0A         * current key's group is the same as the context's, which was set\0A         * from the first key's group. */\0A        if (mbedtls_ecdh_grp_id(ctx) != key->grp.id) {\0A            return MBEDTLS_ERR_ECP_BAD_INPUT_DATA;\0A        }\0A    }\0A\0A#if defined(MBEDTLS_ECDH_LEGACY_CONTEXT)\0A    return ecdh_get_params_internal(ctx, key, side);\0A#else\0A    switch (ctx->var) {\0A#if defined(MBEDTLS_ECDH_VARIANT_EVEREST_ENABLED)\0A        case MBEDTLS_ECDH_VARIANT_EVEREST:\0A        {\0A            mbedtls_everest_ecdh_side s = side == MBEDTLS_ECDH_OURS ?\0A                                          MBEDTLS_EVEREST_ECDH_OURS :\0A                                          MBEDTLS_EVEREST_ECDH_THEIRS;\0A            return mbedtls_everest_get_params(&ctx->ctx.everest_ecdh,\0A                                              key, s);\0A        }\0A#endif\0A        case MBEDTLS_ECDH_VARIANT_MBEDTLS_2_0:\0A            return ecdh_get_params_internal(&ctx->ctx.mbed_ecdh,\0A                                            key, side);\0A        default:\0A            return MBEDTLS_ERR_ECP_BAD_INPUT_DATA;\0A    }\0A#endif\0A}\0A\0Astatic int ecdh_make_public_internal(mbedtls_ecdh_context_mbed *ctx,\0A                                     size_t *olen, int point_format,\0A                                     unsigned char *buf, siz