@.str41255 = private global { i64, i64, [14676 x i8] } { i64 -1, i64 14675, [14676 x i8] c"/*\0A *  Privacy Enhanced Mail (PEM) decoding\0A *\0A *  Copyright The Mbed TLS Contributors\0A *  SPDX-License-Identifier: Apache-2.0 OR GPL-2.0-or-later\0A */\0A\0A#include \22common.h\22\0A\0A#if defined(MBEDTLS_PEM_PARSE_C) || defined(MBEDTLS_PEM_WRITE_C)\0A\0A#include \22mbedtls/pem.h\22\0A#include \22mbedtls/base64.h\22\0A#include \22mbedtls/des.h\22\0A#include \22mbedtls/aes.h\22\0A#include \22mbedtls/md.h\22\0A#include \22mbedtls/cipher.h\22\0A#include \22mbedtls/platform_util.h\22\0A#include \22mbedtls/error.h\22\0A\0A#include <string.h>\0A\0A#include \22mbedtls/platform.h\22\0A\0A#if defined(MBEDTLS_USE_PSA_CRYPTO)\0A#include \22psa/crypto.h\22\0A#endif\0A\0A#if defined(MBEDTLS_MD_CAN_MD5) &&  \5C\0A    defined(MBEDTLS_CIPHER_MODE_CBC) &&                             \5C\0A    (defined(MBEDTLS_DES_C) || defined(MBEDTLS_AES_C))\0A#define PEM_RFC1421\0A#endif /* MBEDTLS_MD_CAN_MD5 &&\0A          MBEDTLS_CIPHER_MODE_CBC &&\0A          ( MBEDTLS_AES_C || MBEDTLS_DES_C ) */\0A\0A#if defined(MBEDTLS_PEM_PARSE_C)\0Avoid mbedtls_pem_init(mbedtls_pem_context *ctx)\0A{\0A    memset(ctx, 0, sizeof(mbedtls_pem_context));\0A}\0A\0A#if defined(PEM_RFC1421)\0A/*\0A * Read a 16-byte hex string and convert it to binary\0A */\0Astatic int pem_get_iv(const unsigned char *s, unsigned char *iv,\0A                      size_t iv_len)\0A{\0A    size_t i, j, k;\0A\0A    memset(iv, 0, iv_len);\0A\0A    for (i = 0; i < iv_len * 2; i++, s++) {\0A        if (*s >= '0' && *s <= '9') {\0A            j = *s - '0';\0A        } else\0A        if (*s >= 'A' && *s <= 'F') {\0A            j = *s - '7';\0A        } else\0A        if (*s >= 'a' && *s <= 'f') {\0A            j = *s - 'W';\0A        } else {\0A            return MBEDTLS_ERR_PEM_INVALID_ENC_IV;\0A        }\0A\0A        k = ((i & 1) != 0) ? j : j << 4;\0A\0A        iv[i >> 1] = (unsigned char) (iv[i >> 1] | k);\0A    }\0A\0A    return 0;\0A}\0A\0Astatic int pem_pbkdf1(unsigned char *key, size_t keylen,\0A                      unsigned char *iv,\0A                      const unsigned char *pwd, size_t pwdlen)\0A{\0A    mbedtls_md_context_t md5_ctx;\0A    const mbedtls_md_info_t *md5_info;\0A    unsigned char md5sum[16];\0A    size_t use_len;\0A    int ret = MBEDTLS_ERR_ERROR_CORRUPTION_DETECTED;\0A\0A    mbedtls_md_init(&md5_ctx);\0A\0A    /* Prepare the context. (setup() errors gracefully on NULL info.) */\0A    md5_info = mbedtls_md_info_from_type(MBEDTLS_MD_MD5);\0A    if ((ret = mbedtls_md_setup(&md5_ctx, md5_info, 0)) != 0) {\0A        goto exit;\0A    }\0A\0A    /*\0A     * key[ 0..15] = MD5(pwd || IV)\0A     */\0A    if ((ret = mbedtls_md_starts(&md5_ctx)) != 0) {\0A        goto exit;\0A    }\0A    if ((ret = mbedtls_md_update(&md5_ctx, pwd, pwdlen)) != 0) {\0A        goto exit;\0A    }\0A    if ((ret = mbedtls_md_update(&md5_ctx, iv,  8)) != 0) {\0A        goto exit;\0A    }\0A    if ((ret = mbedtls_md_finish(&md5_ctx, md5sum)) != 0) {\0A        goto exit;\0A    }\0A\0A    if (keylen <= 16) {\0A        memcpy(key, md5sum, keylen);\0A        goto exit;\0A    }\0A\0A    memcpy(key, md5sum, 16);\0A\0A    /*\0A     * key[16..23] = MD5(key[ 0..15] || pwd || IV])\0A     */\0A    if ((ret = mbedtls_md_starts(&md5_ctx)) != 0) {\0A        goto exit;\0A    }\0A    if ((ret = mbedtls_md_update(&md5_ctx, md5sum, 16)) != 0) {\0A        goto exit;\0A    }\0A    if ((ret = mbedtls_md_update(&md5_ctx, pwd, pwdlen)) != 0) {\0A        goto exit;\0A    }\0A    if ((ret = mbedtls_md_update(&md5_ctx, iv, 8)) != 0) {\0A        goto exit;\0A    }\0A    if ((ret = mbedtls_md_finish(&md5_ctx, md5sum)) != 0) {\0A        goto exit;\0A    }\0A\0A    use_len = 16;\0A    if (keylen < 32) {\0A        use_len = keylen - 16;\0A    }\0A\0A    memcpy(key + 16, md5sum, use_len);\0A\0Aexit:\0A    mbedtls_md_free(&md5_ctx);\0A    mbedtls_platform_zeroize(md5sum, 16);\0A\0A    return ret;\0A}\0A\0A#if defined(MBEDTLS_DES_C)\0A/*\0A * Decrypt with DES-CBC, using PBKDF1 for key derivation\0A */\0Astatic int pem_des_decrypt(unsigned char des_iv[8],\0A                           unsigned char *buf, size_t buflen,\0A                           const unsigned char *pwd, size_t pwdlen)\0A{\0A    mbedtls_des_context des_ctx;\0A    unsigned char des_key[8];\0A    int ret = MBEDTLS_ERR_ERROR_CORRUPTION_DETECTED;\0A\0A    mbedtls_des_init(&des_ctx);\0A\0A    if ((ret = pem_pbkdf1(des_key, 8, des_iv, pwd, pwdlen)) != 0) {\0A        goto exit;\0A    }\0A\0A    if ((ret = mbedtls_des_setkey_dec(&des_ctx, des_key)) != 0) {\0A        goto exit;\0A    }\0A    ret = mbedtls_des_crypt_cbc(&des_ctx, MBEDTLS_DES_DECRYPT, buflen,\0A                                des_iv, buf, buf);\0A\0Aexit:\0A    mbedtls_des_free(&des_ctx);\0A    mbedtls_platform_zeroize(des_key, 8);\0A\0A    return ret;\0A}\0A\0A/*\0A * Decrypt with 3DES-CBC, using PBKDF1 for key derivation\0A */\0Astatic int pem_des3_decrypt(unsigned char des3_iv[8],\0A                            unsigned char *buf, size_t buflen,\0A                            const unsigned char *pwd, size_t pwdlen)\0A{\0A    mbedtls_des3_context des3_ctx;\0A    unsigned char des3_key[24];\0A    int ret = MBEDTLS_ERR_ERROR_CORRUPTION_DETECTED;\0A\0A    mbedtls_des3_init(&des3_ctx);\0A\0A    if ((ret = pem_pbkdf1(des3_key, 24, des3_iv, pwd, pwdlen)) != 0) {\0A        goto exit;\0A    }\0A\0A    if ((ret = mbedtls_des3_set3key_dec(&des3_ctx, des3_key)) != 0) {\0A        goto exit;\0A    }\0A    ret = mbedtls_des3_crypt_cbc(&des3_ctx, MBEDTLS_DES_DECRYPT, buflen,\0A                                 des3_iv, buf, buf);\0A\0Aexit:\0A    mbedtls_des3_free(&des3_ctx);\0A    mbedtls_platform_zeroize(des3_key, 24);\0A\0A    return ret;\0A}\0A#endif /* MBEDTLS_DES_C */\0A\0A#if defined(MBEDTLS_AES_C)\0A/*\0A * Decrypt with AES-XXX-CBC, using PBKDF1 for key derivation\0A */\0Astatic int pem_aes_decrypt(unsigned char aes_iv[16], unsigned int keylen,\0A                           unsigned char *buf, size_t buflen,\0A                           const unsigned char *pwd, size_t pwdlen)\0A{\0A    mbedtls_aes_context aes_ctx;\0A    unsigned char aes_key[32];\0A    int ret = MBEDTLS_ERR_ERROR_CORRUPTION_DETECTED;\0A\0A    mbedtls_aes_init(&aes_ctx);\0A\0A    if ((ret = pem_pbkdf1(aes_key, keylen, aes_iv, pwd, pwdlen)) != 0) {\0A        goto exit;\0A    }\0A\0A    if ((ret = mbedtls_aes_setkey_dec(&aes_ctx, aes_key, keylen * 8)) != 0) {\0A        goto exit;\0A    }\0A    ret = mbedtls_aes_crypt_cbc(&aes_ctx, MBEDTLS_AES_DECRYPT, buflen,\0A                                aes_iv, buf, buf);\0A\0Aexit:\0A    mbedtls_aes_free(&aes_ctx);\0A    mbedtls_platform_zeroize(aes_key, keylen);\0A\0A    return ret;\0A}\0A#endif /* MBEDTLS_AES_C */\0A\0A#if defined(MBEDTLS_DES_C) || defined(MBEDTLS_AES_C)\0Astatic int pem_check_pkcs_padding(unsigned char *input, size_t input_len, size_t *data_len)\0A{\0A    /* input_len > 0 is guaranteed by mbedtls_pem_read_buffer(). */\0A    size_t pad_len = input[input_len - 1];\0A    size_t i;\0A\0A    if (pad_len > input_len) {\0A        return MBEDTLS_ERR_PEM_PASSWORD_MISMATCH;\0A    }\0A\0A    *data_len = input_len - pad_len;\0A\0A    for (i = *data_len; i < input_len; i++) {\0A        if (input[i] != pad_len) {\0A            return MBEDTLS_ERR_PEM_PASSWORD_MISMATCH;\0A        }\0A    }\0A\0A    return 0;\0A}\0A#endif /* MBEDTLS_DES_C || MBEDTLS_AES_C */\0A\0A#endif /* PEM_RFC1421 */\0A\0Aint mbedtls_pem_read_buffer(mbedtls_pem_context *ctx, const char *header, const char *footer,\0A                            const unsigned char *data, const unsigned char *pwd,\0A                            size_t pwdlen, size_t *use_len)\0A{\0A    int ret, enc;\0A    size_t len;\0A    unsigned char *buf;\0A    const unsigned char *s1, *s2, *end;\0A#if defined(PEM_RFC1421)\0A    unsigned char pem_iv[16];\0A    mbedtls_cipher_type_t enc_alg = MBEDTLS_CIPHER_NONE;\0A#else\0A    ((void) pwd);\0A    ((void) pwdlen);\0A#endif /* PEM_RFC1421 */\0A\0A    if (ctx == NULL) {\0A        return MBEDTLS_ERR_PEM_BAD_INPUT_DATA;\0A    }\0A\0A    s1 = (unsigned char *) strstr((const char *) data, header);\0A\0A    if (s1 == NULL) {\0A        return MBEDTLS_ERR_PEM_NO_HEADER_FOOTER_PRESENT;\0A    }\0A\0A    s2 = (unsigned char *) strstr((const char *) data, footer);\0A\0A    if (s2 == NULL || s2 <= s1) {\0A        return MBEDTLS_ERR_PEM_NO_HEADER_FOOTER_PRESENT;\0A    }\0A\0A    s1 += strlen(header);\0A    if (*s1 == ' ') {\0A        s1++;\0A    }\0A    if (*s1 == '\5Cr') {\0A        s1++;\0A    }\0A    if (*s1 == '\5Cn') {\0A        s1++;\0A    } else {\0A        return MBEDTLS_ERR_PEM_NO_HEADER_FOOTER_PRESENT;\0A    }\0A\0A    end = s2;\0A    end += strlen(footer);\0A    if (*end == ' ') {\0A        end++;\0A    }\0A    if (*end == '\5Cr') {\0A        end++;\0A    }\0A    if (*end == '\5Cn') {\0A        end++;\0A    }\0A    *use_len = (size_t) (end - data);\0A\0A    enc = 0;\0A\0A    if (s2 - s1 >= 22 && memcmp(s1, \22Proc-Type: 4,ENCRYPTED\22, 22) == 0) {\0A#if defined(PEM_RFC1421)\0A        enc++;\0A\0A        s1 += 22;\0A        if (*s1 == '\5Cr') {\0A            s1++;\0A        }\0A        if (*s1 == '\5Cn') {\0A            s1++;\0A        } else {\0A            return MBEDTLS_ERR_PEM_INVALID_DATA;\0A        }\0A\0A\0A#if defined(MBEDTLS_DES_C)\0A        if (s2 - s1 >= 23 && memcmp(s1, \22DEK-Info: DES-EDE3-CBC,\22, 23) == 0) {\0A            enc_alg = MBEDTLS_CIPHER_DES_EDE3_CBC;\0A\0A            s1 += 23;\0A            if (s2 - s1 < 16 || pem_get_iv(s1, pem_iv, 8) != 0) {\0A                return MBEDTLS_ERR_PEM_INVALID_ENC_IV;\0A            }\0A\0A            s1 += 16;\0A        } else if (s2 - s1 >= 18 && memcmp(s1, \22DEK-Info: DES-CBC,\22, 18) == 0) {\0A            enc_alg = MBEDTLS_CIPHER_DES_CBC;\0A\0A            s1 += 18;\0A            if (s2 - s1 < 16 || pem_get_iv(s1, pem_iv, 8) != 0) {\0A                return MBEDTLS_ERR_PEM_INVALID_ENC_IV;\0A            }\0A\0A            s1 += 16;\0A        }\0A#endif /* MBEDTLS_DES_C */\0A\0A#if defined(MBEDTLS_AES_C)\0A        if (s2 - s1 >= 14 && memcmp(s1, \22DEK-Info: AES-\22, 14) == 0) {\0A            if (s2 - s1 < 22) {\0A                return MBEDTLS_ERR_PEM_UNKNOWN_ENC_ALG;\0A            } else if (memcmp(s1, \22DEK-Info: AES-128-CBC,\22, 22) == 0) {\0A                enc_alg = MBEDTLS_CIPHER_AES_128_CBC;\0A            } else if (memcmp(s1, \22DEK-Info: AES-192-CBC,\22, 22) == 0) {\0A                enc_alg = MBEDTLS_CIPHER_AES_192_CBC;\0A            } else if (memcmp(s1, \22DEK-Info: AES-256-CBC,\22, 22) == 0) {\0A                enc_alg = MBEDTLS_CIPHER_AES_256_CBC;\0A            } else {\0A                return MBEDTLS_ERR_PEM_UNKNOWN_ENC_ALG;\0A            }\0A\0A            s1 += 22;\0A            if (s2 - s1 < 32 || pem_get_iv(s1, pem_iv, 16) != 0) {\0A                return MBEDTLS_ERR_PEM_INVALID_ENC_IV;\0A            }\0A\0A            s1 += 32;\0A        }\0A#endif /* MBEDTLS_AES_C */\0A\0A        if (enc_alg == MBEDTLS_CIPHER_NONE) {\0A            return MBEDTLS_ERR_PEM_UNKNOWN_ENC_ALG;\0A        }\0A\0A        if (*s1 == '\5Cr') {\0A            s1++;\0A        }\0A        if (*s1 == '\5Cn') {\0A            s1++;\0A        } else {\0A            return MBEDTLS_ERR_PEM_INVALID_DATA;\0A        }\0A#else\0A        return MBEDTLS_ERR_PEM_FEATURE_UNAVAILABLE;\0A#endif /* PEM_RFC1421 */\0A    }\0A\0A    if (s1 >= s2) {\0A        return MBEDTLS_ERR_PEM_INVALID_DATA;\0A    }\0A\0A    ret = mbedtls_base64_decode(NULL, 0, &len, s1, (size_t) (s2 - s1));\0A\0A    if (ret == MBEDTLS_ERR_BASE64_INVALID_CHARACTER) {\0A        return MBEDTLS_ERROR_ADD(MBEDTLS_ERR_PEM_INVALID_DATA, ret);\0A    }\0A\0A    if (len == 0) {\0A        return MBEDTLS_ERR_PEM_BAD_INPUT_DATA;\0A    }\0A\0A    if ((buf = mbedtls_calloc(1, len)) == NULL) {\0A        return MBEDTLS_ERR_PEM_ALLOC_FAILED;\0A    }\0A\0A    if ((ret = mbedtls_base64_decode(buf, len, &len, s1, (size_t) (s2 - s1))) != 0) {\0A        mbedtls_zeroize_and_free(buf, len);\0A        return MBEDTLS_ERROR_ADD(MBEDTLS_ERR_PEM_INVALID_DATA, ret);\0A    }\0A\0A    if (enc != 0) {\0A#if defined(PEM_RFC1421)\0A        if (pwd == NULL) {\0A            mbedtls_zeroize_and_free(buf, len);\0A            return MBEDTLS_ERR_PEM_PASSWORD_REQUIRED;\0A        }\0A\0A        ret = 0;\0A\0A#if defined(MBEDTLS_DES_C)\0A        if (enc_alg == MBEDTLS_CIPHER_DES_EDE3_CBC) {\0A            ret = pem_des3_decrypt(pem_iv, buf, len, pwd, pwdlen);\0A        } else if (enc_alg == MBEDTLS_CIPHER_DES_CBC) {\0A            ret = pem_des_decrypt(pem_iv, buf, len, pwd, pwdlen);\0A        }\0A#endif /* MBEDTLS_DES_C */\0A\0A#if defined(MBEDTLS_AES_C)\0A        if (enc_alg == MBEDTLS_CIPHER_AES_128_CBC) {\0A            ret = pem_aes_decrypt(pem_iv, 16, buf, len, pwd, pwdlen);\0A        } else if (enc_alg == MBEDTLS_CIPHER_AES_192_CBC) {\0A            ret = pem_aes_decrypt(pem_iv, 24, buf, len, pwd, pwdlen);\0A        } else if (enc_alg == MBEDTLS_CIPHER_AES_256_CBC) {\0A            ret = pem_aes_decrypt(pem_iv, 32, buf, len, pwd, pwdlen);\0A        }\0A#endif /* MBEDTLS_AES_C */\0A\0A        if (ret != 0) {\0A            mbedtls_zeroize_and_free(buf, len);\0A            return ret;\0A        }\0A\0A        /* Check PKCS padding and update data length based on padding info.\0A         * This can be used to detect invalid padding data and password\0A         * mismatches. */\0A        size_t unpadded_len;\0A        ret = pem_check_pkcs_padding(buf, len, &unpadded_len);\0A        if (ret != 0) {\0A            mbedtls_zeroize_and_free(buf, len);\0A            return ret;\0A        }\0A        len = unpadded_len;\0A#else\0A        mbedtls_zeroize_and_free(buf, len);\0A        return MBEDTLS_ERR_PEM_FEATURE_UNAVAILABLE;\0A#endif /* PEM_RFC1421 */\0A    }\0A\0A    ctx->buf = buf;\0A    ctx->buflen = len;\0A\0A    return 0;\0A}\0A\0Avoid mbedtls_pem_free(mbedtls_pem_context *ctx)\0A{\0A    if (ctx == NULL) {\0A        return;\0A    }\0A\0A    if (ctx->buf != NULL) {\0A        mbedtls_zeroize_and_free(ctx->buf, ctx->buflen);\0A    }\0A    mbedtls_free(ctx->info);\0A\0A    mbedtls_platform_zeroize(ctx, sizeof(mbedtls_pem_context));\0A}\0A#endif /* MBEDTLS_PEM_PARSE_C */\0A\0A#if defined(MBEDTLS_PEM_WRITE_C)\0Aint mbedtls_pem_write_buffer(const char *header, const char *footer,\0A                             const unsigned char *der_data, size_t der_len,\0A                             unsigned char *buf, size_t buf_len, size_t *olen)\0A{\0A    int ret = MBEDTLS_ERR_ERROR_CORRUPTION_DETECTED;\0A    unsigned char *encode_buf = NULL, *c, *p = buf;\0A    size_t len = 0, use_len, add_len = 0;\0A\0A    mbedtls_base64_encode(NULL, 0, &use_len, der_data, der_len);\0A    add_len = strlen(header) + strlen(footer) + (((use_len > 2) ? (use_len - 2) : 0) / 64) + 1;\0A\0A    if (use_len + add_len > buf_len) {\0A        *olen = use_len + add_len;\0A        return MBEDTLS_ERR_BASE64_BUFFER_TOO_SMALL;\0A    }\0A\0A    if (use_len != 0 &&\0A        ((encode_buf = mbedtls_calloc(1, use_len)) == NULL)) {\0A        return MBEDTLS_ERR_PEM_ALLOC_FAILED;\0A    }\0A\0A    if ((ret = mbedtls_base64_encode(encode_buf, use_len, &use_len, der_data,\0A                                     der_len)) != 0) {\0A        mbedtls_free(encode_buf);\0A        return ret;\0A    }\0A\0A    memcpy(p, header, strlen(header));\0A    p += strlen(header);\0A    c = encode_buf;\0A\0A    while (use_len) {\0A        len = (use_len > 64) ? 64 : use_len;\0A        memcpy(p, c, len);\0A        use_len -= len;\0A        p += len;\0A        c += len;\0A        *p++ = '\5Cn';\0A    }\0A\0A    memcpy(p, footer, strlen(footer));\0A    p += strlen(footer);\0A\0A    *p++ = '\5C0';\0A    *olen = (size_t) (p - buf);\0A\0A    /* Clean any remaining data previously written to the buffer */\0A    memset(buf + *olen, 0, buf_len - *olen);\0A\0A    mbedtls_free(encode_buf);\0A    return 0;\0A}\0A#endif /* MBEDTLS_PEM_WRITE_C */\0A#endif /* MBEDTLS_PEM_PARSE_C || MBEDTLS_PEM_WRITE_C */\0A\00" }
