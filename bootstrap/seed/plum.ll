SSL_DEBUG_RET(1, \22mbedtls_ecjpake_read_round_one\22, ret);\0A        mbedtls_ssl_send_alert_message(ssl, MBEDTLS_SSL_ALERT_LEVEL_FATAL,\0A                                       MBEDTLS_SSL_ALERT_MSG_ILLEGAL_PARAMETER);\0A        return ret;\0A    }\0A#endif /* MBEDTLS_USE_PSA_CRYPTO */\0A\0A    /* Only mark the extension as OK when we're sure it is */\0A    ssl->handshake->cli_exts |= MBEDTLS_TLS_EXT_ECJPAKE_KKPP_OK;\0A\0A    return 0;\0A}\0A#endif /* MBEDTLS_KEY_EXCHANGE_ECJPAKE_ENABLED */\0A\0A#if defined(MBEDTLS_SSL_MAX_FRAGMENT_LENGTH)\0AMBEDTLS_CHECK_RETURN_CRITICAL\0Astatic int ssl_parse_max_fragment_length_ext(mbedtls_ssl_context *ssl,\0A                                             const unsigned char *buf,\0A                                             size_t len)\0A{\0A    if (len != 1 || buf[0] >= MBEDTLS_SSL_MAX_FRAG_LEN_INVALID) {\0A        MBEDTLS_SSL_DEBUG_MSG(1, (\22bad client hello message\22));\0A        mbedtls_ssl_send_alert_message(ssl, MBEDTLS_SSL_ALERT_LEVEL_FATAL,\0A                                       MBEDTLS_SSL_ALERT_MSG_ILLEGAL_PARAMETER);\0A        return MBEDTLS_ERR_SSL_ILLEGAL_PARAMETER;\0A    }\0A\0A    ssl->session_negotiate->mfl_code = buf[0];\0A\0A    return 0;\0A}\0A#endif /* MBEDTLS_SSL_MAX_FRAGMENT_LENGTH */\0A\0A#if defined(MBEDTLS_SSL_DTLS_CONNECTION_ID)\0AMBEDTLS_CHECK_RETURN_CRITICAL\0Astatic int ssl_parse_cid_ext(mbedtls_ssl_context *ssl,\0A                             const unsigned char *buf,\0A                             size_t len)\0A{\0A    size_t peer_cid_len;\0A\0A    /* CID extension only makes sense in DTLS */\0A    if (ssl->conf->transport != MBEDTLS_SSL_TRANSPORT_DATAGRAM) {\0A        MBEDTLS_SSL_DEBUG_MSG(1, (\22bad client hello message\22));\0A        mbedtls_ssl_send_alert_message(ssl, MBEDTLS_SSL_ALERT_LEVEL_FATAL,\0A                                       MBEDTLS_SSL_ALERT_MSG_ILLEGAL_PARAMETER);\0A        return MBEDTLS_ERR_SSL_ILLEGAL_PARAMETER;\0A    }\0A\0A    /*\0A     *   struct {\0A     *      opaque cid<0..2^8-1>;\0A     *   } ConnectionId;\0A     */\0A\0A    if (len < 1) {\0A        MBEDTLS_SSL_DEBUG_MSG(1, (\22bad client hello message\22));\0A        mbedtls_ssl_send_alert_message(ssl, MBEDTLS_SSL_ALERT_LEVEL_FATAL,\0A                                       MBEDTLS_SSL_ALERT_MSG_DECODE_ERROR);\0A        return MBEDTLS_ERR_SSL_DECODE_ERROR;\0A    }\0A\0A    peer_cid_len = *buf++;\0A    len--;\0A\0A    if (len != peer_cid_len) {\0A        MBEDTLS_SSL_DEBUG_MSG(1, (\22bad client hello message\22));\0A        mbedtls_ssl_send_alert_message(ssl, MBEDTLS_SSL_ALERT_LEVEL_FATAL,\0A                                       MBEDTLS_SSL_ALERT_MSG_DECODE_ERROR);\0A        return MBEDTLS_ERR_SSL_DECODE_ERROR;\0A    }\0A\0A    /* Ignore CID if the user has disabled its use. */\0A    if (ssl->negotiate_cid == MBEDTLS_SSL_CID_DISABLED) {\0A        /* Leave ssl->handshake->cid_in_use in its default\0A         * value of MBEDTLS_SSL_CID_DISABLED. */\0A        MBEDTLS_SSL_DEBUG_MSG(3, (\22Client sent CID extension, but CID disabled\22));\0A        return 0;\0A    }\0A\0A    if (peer_cid_len > MBEDTLS_SSL_CID_OUT_LEN_MAX) {\0A        MBEDTLS_SSL_DEBUG_MSG(1, (\22bad client hello message\22));\0A        mbedtls_ssl_send_alert_message(ssl, MBEDTLS_SSL_ALERT_LEVEL_FATAL,\0A                                       MBEDTLS_SSL_ALERT_MSG_ILLEGAL_PARAMETER);\0A        return MBEDTLS_ERR_SSL_ILLEGAL_PARAMETER;\0A    }\0A\0A    ssl->handshake->cid_in_use = MBEDTLS_SSL_CID_ENABLED;\0A    ssl->handshake->peer_cid_len = (uint8_t) peer_cid_len;\0A    memcpy(ssl->handshake->peer_cid, buf, peer_cid_len);\0A\0A    MBEDTLS_SSL_DEBUG_MSG(3, (\22Use of CID extension negotiated\22));\0A    MBEDTLS_SSL_DEBUG_BUF(3, \22Client CID\22, buf, peer_cid_len);\0A\0A    return 0;\0A}\0A#endif /* MBEDTLS_SSL_DTLS_CONNECTION_ID */\0A\0A#if defined(MBEDTLS_SSL_ENCRYPT_THEN_MAC)\0AMBEDTLS_CHECK_RETURN_CRITICAL\0Astatic int ssl_parse_encrypt_then_mac_ext(mbedtls_ssl_context *ssl,\0A                                  