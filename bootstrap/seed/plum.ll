@.str56534 = private global { i64, i64, [19449 x i8] } { i64 -1, i64 19448, [19449 x i8] c"/// One `name=value` pair of a query string, decoded.\0A///\0A/// Both halves are the real text: `a b` is a space, not `a%20b`.\0A/// `build_query` re-encodes them on the way out.\0Apub struct Param { pub name: String, pub value: String }\0A\0A/// `port` is always RESOLVED: the scheme's default when the URL did\0A/// not say. 0 means the scheme has no default this module knows,\0A/// which is not an error. Parsing is not connecting, and a URL\0A/// with a scheme we have never heard of is still a URL.\0A///\0A/// `path` is percent-encoded and never empty (`/` when the URL had\0A/// none). `raw_query` and `fragment` are stored without their `?`\0A/// and `#`, and are `\22\22` when absent, which does not distinguish\0A/// `http://h/p` from `http://h/p?`, a difference nothing observable\0A/// depends on.\0Apub struct Url {\0A    pub scheme: String,\0A    pub host: String,\0A    pub port: Int,\0A    pub path: String,\0A    pub raw_query: String,\0A    pub fragment: String,\0A}\0A\0Alet byte_at (b: Bytes) (i: Int): Int = match b.at(i) { Some(v) => v, None => 0 }\0A\0A/// Ports the schemes this module knows about default to. An unknown\0A/// scheme gets 0; see `Url`'s note.\0Apub let default_port (scheme: String): Int =\0A    if scheme == \22http\22 { 80 }\0A    else if scheme == \22https\22 { 443 }\0A    else { 0 }\0A\0A/// RFC 3986: ALPHA *( ALPHA / DIGIT / \22+\22 / \22-\22 / \22.\22 ).\0Alet scheme_ok_acc (b: Bytes) (i: Int) (n: Int): Bool =\0A    if i >= n { true }\0A    else {\0A        let c = byte_at(b, i);\0A        let alpha = (c >= 65 && c <= 90) || (c >= 97 && c <= 122);\0A        let digit = c >= 48 && c <= 57;\0A        let mark = c == 43 || c == 45 || c == 46;\0A        if i == 0 { if alpha { scheme_ok_acc(b, i + 1, n) } else { false } }\0A        else if alpha || digit || mark { scheme_ok_acc(b, i + 1, n) }\0A        else { false }\0A    }\0A\0Alet scheme_ok (s: Strin