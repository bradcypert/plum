r_info_t *cipher_info;\0A\0A    cipher_info = mbedtls_cipher_info_from_values(cipher, keybits,\0A                                                  MBEDTLS_MODE_ECB);\0A    if (cipher_info == NULL) {\0A        return MBEDTLS_ERR_CCM_BAD_INPUT;\0A    }\0A\0A    if (mbedtls_cipher_info_get_block_size(cipher_info) != 16) {\0A        return MBEDTLS_ERR_CCM_BAD_INPUT;\0A    }\0A\0A    mbedtls_cipher_free(&ctx->cipher_ctx);\0A\0A    if ((ret = mbedtls_cipher_setup(&ctx->cipher_ctx, cipher_info)) != 0) {\0A        return ret;\0A    }\0A\0A    if ((ret = mbedtls_cipher_setkey(&ctx->cipher_ctx, key, keybits,\0A                                     MBEDTLS_ENCRYPT)) != 0) {\0A        return ret;\0A    }\0A#endif\0A\0A    return ret;\0A}\0A\0A/*\0A * Free context\0A */\0Avoid mbedtls_ccm_free(mbedtls_ccm_context *ctx)\0A{\0A    if (ctx == NULL) {\0A        return;\0A    }\0A#if defined(MBEDTLS_BLOCK_CIPHER_C)\0A    mbedtls_block_cipher_free(&ctx->block_cipher_ctx);\0A#else\0A    mbedtls_cipher_free(&ctx->cipher_ctx);\0A#endif\0A    mbedtls_platform_zeroize(ctx, sizeof(mbedtls_ccm_context));\0A}\0A\0A#define CCM_STATE__CLEAR                0\0A#define CCM_STATE__STARTED              (1 << 0)\0A#define CCM_STATE__LENGTHS_SET          (1 << 1)\0A#define CCM_STATE__AUTH_DATA_STARTED    (1 << 2)\0A#define CCM_STATE__AUTH_DATA_FINISHED   (1 << 3)\0A#define CCM_STATE__ERROR                (1 << 4)\0A\0A/*\0A * Encrypt or decrypt a partial block with CTR\0A */\0Astatic int mbedtls_ccm_crypt(mbedtls_ccm_context *ctx,\0A                             size_t offset, size_t use_len,\0A                             const unsigned char *input,\0A                             unsigned char *output)\0A{\0A    int ret = MBEDTLS_ERR_ERROR_CORRUPTION_DETECTED;\0A    unsigned char tmp_buf[16] = { 0 };\0A\0A#if defined(MBEDTLS_BLOCK_CIPHER_C)\0A    ret = mbedtls_block_cipher_encrypt(&ctx->block_cipher_ctx, ctx->ctr, tmp_buf);\0A#else\0A    size_t olen = 0;\0A    ret = mbedtls_cipher_update(&ctx->cipher_ctx, ctx->ctr, 16, tmp_buf, &olen);\0A#endif\0A    if (ret != 0) {\0A        ctx->state |= CCM_STATE__ERROR;\0A        mbedtls_platform_zeroize(tmp_buf, sizeof(tmp_buf));\0A        return ret;\0A    }\0A\0A    mbedtls_xor(output, input, tmp_buf + offset, use_len);\0A\0A    mbedtls_platform_zeroize(tmp_buf, sizeof(tmp_buf));\0A    return ret;\0A}\0A\0Astatic void mbedtls_ccm_clear_state(mbedtls_ccm_context *ctx)\0A{\0A    ctx->state = CCM_STATE__CLEAR;\0A    memset(ctx->y, 0, 16);\0A    memset(ctx->ctr, 0, 16);\0A}\0A\0Astatic int ccm_calculate_first_block_if_ready(mbedtls_ccm_context *ctx)\0A{\0A    int ret = MBEDTLS_ERR_ERROR_CORRUPTION_DETECTED;\0A    unsigned char i;\0A    size_t len_left;\0A#if !defined(MBEDTLS_BLOCK_CIPHER_C)\0A    size_t olen;\0A#endif\0A\0A    /* length calculation can be done only after both\0A     * mbedtls_ccm_starts() and mbedtls_ccm_set_lengths() have been executed\0A     */\0A    if (!(ctx->state & CCM_STATE__STARTED) || !(ctx->state & CCM_STATE__LENGTHS_SET)) {\0A        return 0;\0A    }\0A\0A    /* CCM expects non-empty tag.\0A     * CCM* allows empty tag. For CCM* without tag, the tag calculation is skipped.\0A     */\0A    if (ctx->tag_len == 0) {\0A        if (ctx->mode == MBEDTLS_CCM_STAR_ENCRYPT || ctx->mode == MBEDTLS_CCM_STAR_DECRYPT) {\0A            ctx->plaintext_len = 0;\0A            return 0;\0A        } else {\0A            return MBEDTLS_ERR_CCM_BAD_INPUT;\0A        }\0A    }\0A\0A    /*\0A     * First block:\0A     * 0        .. 0        flags\0A     * 1        .. iv_len   nonce (aka iv)  - set by: mbedtls_ccm_starts()\0A     * iv_len+1 .. 15       length\0A     *\0A     * With flags as (bits):\0A     * 7        0\0A     * 6        add present?\0A     * 5 .. 3   (t - 2) / 2\0A     * 2 .. 0   q - 1\0A     */\0A    ctx->y[0] |= (ctx->add_len > 0) << 6;\0A    ctx->y[0] |= ((ctx->tag_len - 2) / 2) << 3;\0A    ctx->y[0] |= ctx->q - 1;\0A\0A    for (i = 0, len_left = ctx->plaintext_len; i < ctx->q; i++, len_left >>= 8) {\0A        ctx->y[15-i] = MBEDTLS_BYTE_0(len_left);\0A    }\0A\0A    if (len_left > 0) {\0A        ctx->state |= CCM_STATE__ERROR;\0A        return MBEDTLS_ERR_CCM_BAD_INPUT;\0A    }\0A\0A    /* Start CBC-MAC with first block*/\0A#if defined(MBEDTLS_BLOCK_CIPHER_C)\0A    ret = mbedtls_block_cipher_encrypt(&ctx->block_cipher_ctx, ctx->y, ctx->y);\0A#else\0A    ret = mbedtls_cipher_update(&ctx->cipher_ctx, ctx->y, 16, ctx->y, &olen);\0A#endif\0A    if (ret != 0) {\0A        ctx->state |= CCM_STATE__ERROR;\0A        return ret;\0A    }\0A\0A    return 0;\0A}\0A\0Aint mbedtls_ccm_starts(mbedtls_ccm_context *ctx,\0A                       int mode,\0A                       const unsigned char *iv,\0A                       size_t iv_len)\0A{\0A    /* Also implies q is within bounds */\0A    if (iv_len < 7 || iv_len > 13) {\0A        return MBEDTLS_ERR_CCM_BAD_INPUT;\0A    }\0A\0A    ctx->mode = mode;\0A    ctx->q = 16 - 1 - (unsigned char) iv_len;\0A\0A    /*\0A     * Prepare counter block for encryption:\0A     * 0        .. 0        flags\0A     * 1        .. iv_len   nonce (aka iv)\0A     * iv_len+1 .. 15       counter (initially 1)\0A     *\0A     * With flags as (bits):\0A     * 7 .. 3   0\0A     * 2 .. 0   q - 1\0A     */\0A    memset(ctx->ctr, 0, 16);\0A    ctx->ctr[0] = ctx->q - 1;\0A    memcpy(ctx->ctr + 1, iv, iv_len);\0A    memset(ctx->ctr + 1 + iv_len, 0, ctx->q);\0A    ctx->ctr[15] = 1;\0A\0A    /*\0A     * See ccm_calculate_first_block_if_ready() for block layout description\0A     */\0A    memcpy(ctx->y + 1, iv, iv_len);\0A\0A    ctx->state |= CCM_STATE__STARTED;\0A    return ccm_calculate_first_block_if_ready(ctx);\0A}\0A\0Aint mbedtls_ccm_set_lengths(mbedtls_ccm_context *ctx,\0A                            size_t total_ad_len,\0A                            size_t plaintext_len,\0A                            size_t tag_len)\0A{\0A    /*\0A     * Check length requirements: SP800-38C A.1\0A     * Additional requirement: a < 2^16 - 2^8 to simplify the code.\0A     * 'length' checked later (when writing it to the first block)\0A     *\0A     * Also, loosen the requirements to enable support for CCM* (IEEE 802.15.4).\0A     */\0A    if (tag_len == 2 || tag_len > 16 || tag_len % 2 != 0) {\0A        return MBEDTLS_ERR_CCM_BAD_INPUT;\0A    }\0A\0A    if (total_ad_len >= 0xFF00) {\0A        return MBEDTLS_ERR_CCM_BAD_INPUT;\0A    }\0A\0A    ctx->plaintext_len = plaintext_len;\0A    ctx->add_len = total_ad_len;\0A    ctx->tag_len = tag_len;\0A    ctx->processed = 0;\0A\0A    ctx->state |= CCM_STATE__LENGTHS_SET;\0A    return ccm_calculate_first_block_if_ready(ctx);\0A}\0A\0Aint mbedtls_ccm_update_ad(mbedtls_ccm_context *ctx,\0A                          const unsigned char *add,\0A                          size_t add_len)\0A{\0A    int ret = MBEDTLS_ERR_ERROR_CORRUPTION_DETECTED;\0A    size_t use_len, offset;\0A#if !defined(MBEDTLS_BLOCK_CIPHER_C)\0A    size_t olen;\0A#endif\0A\0A    if (ctx->state & CCM_STATE__ERROR) {\0A        return MBEDTLS_ERR_CCM_BAD_INPUT;\0A    }\0A\0A    if (add_len > 0) {\0A        if (ctx->state & CCM_STATE__AUTH_DATA_FINISHED) {\0A            return MBEDTLS_ERR_CCM_BAD_INPUT;\0A        }\0A\0A        if (!(ctx->state & CCM_STATE__AUTH_DATA_STARTED)) {\0A            if (add_len > ctx->add_len) {\0A                return MBEDTLS_ERR_CCM_BAD_INPUT;\0A            }\0A\0A            ctx->y[0] ^= (unsigned char) ((ctx->add_len >> 8) & 0xFF);\0A            ctx->y[1] ^= (unsigned char) ((ctx->add_len) & 0xFF);\0A\0A            ctx->state |= CCM_STATE__AUTH_DATA_STARTED;\0A        } else if (ctx->processed + add_len > ctx->add_len) {\0A            return MBEDTLS_ERR_CCM_BAD_INPUT;\0A        }\0A\0A        while (add_len > 0) {\0A            offset = (ctx->processed + 2) % 16; /* account for y[0] and y[1]\0A                                                 * holding total auth data length */\0A            use_len = 16 - offset;\0A\0A            if (use_len > add_len) {\0A                use_len = add_len;\0A            }\0A\0A            mbedtls_xor(ctx->y + offset, ctx->y + offset, add, use_len);\0A\0A            ctx->processed += use_len;\0A            add_len -= use_len;\0A            add += use_len;\0A\0A            if (use_len + offset == 16 || ctx->processed == ctx->add_len) {\0A#if defined(MBEDTLS_BLOCK_CIPHER_C)\0A                ret = mbedtls_block_cipher_encrypt(&ctx->block_cipher_ctx, ctx->y, ctx->y);\0A#else\0A                ret = mbedtls_cipher_update(&ctx->cipher_ctx, ctx->y, 16, ctx->y, &olen);\0A#endif\0A                if (ret != 0) {\0A                    ctx->state |= CCM_STATE__ERROR;\0A                    return ret;\0A                }\0A            }\0A        }\0A\0A        if (ctx->processed == ctx->add_len) {\0A            ctx->state |= CCM_STATE__AUTH_DATA_FINISHED;\0A            ctx->processed = 0; // prepare for mbedtls_ccm_update()\0A        }\0A    }\0A\0A    return 0;\0A}\0A\0Aint mbedtls_ccm_update(mbedtls_ccm_context *ctx,\0A                       const unsigned char *input, size_t input_len,\0A                       unsigned char *output, size_t output_size,\0A                       size_t *output_len)\0A{\0A    int ret = MBEDTLS_ERR_ERROR_CORRUPTION_DETECTED;\0A    unsigned char i;\0A    size_t use_len, offset;\0A#if !defined(MBEDTLS_BLOCK_CIPHER_C)\0A    size_t olen;\0A#endif\0A\0A    unsigned char local_output[16];\0A\0A    if (ctx->state & CCM_STATE__ERROR) {\0A        return MBEDTLS_ERR_CCM_BAD_INPUT;\0A    }\0A\0A    /* Check against plaintext length only if performing operation with\0A     * authentication\0A     */\0A    if (ctx->tag_len != 0 && ctx->processed + input_len > ctx->plaintext_len) {\0A        return MBEDTLS_ERR_CCM_BAD_INPUT;\0A    }\0A\0A    if (output_size < input_len) {\0A        return MBEDTLS_ERR_CCM_BAD_INPUT;\0A    }\0A    *output_len = input_len;\0A\0A    ret = 0;\0A\0A    while (input_len > 0) {\0A        offset = ctx->processed % 16;\0A\0A        use_len = 16 - offset;\0A\0A        if (use_len > input_len) {\0A            use_len = input_len;\0A        }\0A\0A        ctx->processed += use_len;\0A\0A        if (ctx->mode == MBEDTLS_CCM_ENCRYPT || \5C\0A            ctx->mode == MBEDTLS_CCM_STAR_ENCRYPT) {\0A            mbedtls_xor(ctx->y + offset, ctx->y + offset, input, use_len);\0A\0A            if (use_len + offset == 16 || ctx->processed == ctx->plaintext_len) {\0A#if defined(MBEDTLS_BLOCK_CIPHER_C)\0A                ret = mbedtls_block_cipher_encrypt(&ctx->block_cipher_ctx, ctx->y, ctx->y);\0A#else\0A                ret = mbedtls_cipher_update(&ctx->cipher_ctx, ctx->y, 16, ctx->y, &olen);\0A#endif\0A                if (ret != 0) {\0A                    ctx->state |= CCM_STATE__ERROR;\0A                    goto exit;\0A                }\0A            }\0A\0A            ret = mbedtls_ccm_crypt(ctx, offset, use_len, input, output);\0A            if (ret != 0) {\0A                goto exit;\0A            }\0A        }\0A\0A        if (ctx->mode == MBEDTLS_CCM_DECRYPT || \5C\0A            ctx->mode == MBEDTLS_CCM_STAR_DECRYPT) {\0A            /* Since output may be in shared memory, we cannot be sure that\0A             * it will contain what we wrote to it. Therefore, we should avoid using\0A             * it as input to any operations.\0A             * Write decrypted data to local_output to avoid using output variable as\0A             * input in the XOR operation for Y.\0A             */\0A            ret = mbedtls_ccm_crypt(ctx, offset, use_len, input, local_output);\0A            if (ret != 0) {\0A                goto exit;\0A            }\0A\0A            mbedtls_xor(ctx->y + offset, ctx->y + offset, local_output, use_len);\0A\0A            memcpy(output, local_output, use_len);\0A\0A            if (use_len + offset == 16 || ctx->processed == ctx->plaintext_len) {\0A#if defined(MBEDTLS_BLOCK_CIPHER_C)\0A                ret = mbedtls_block_cipher_encrypt(&ctx->block_cipher_ctx, ctx->y, ctx->y);\0A#else\0A                ret = mbedtls_cipher_update(&ctx->cipher_ctx, ctx->y, 16, ctx->y, &olen);\0A#endif\0A                if (ret != 0) {\0A                    ctx->state |= CCM_STATE__ERROR;\0A                    goto exit;\0A                }\0A            }\0A        }\0A\0A        if (use_len + offset == 16 || ctx->processed == ctx->plaintext_len) {\0A            for (i = 0; i < ctx->q; i++) {\0A                if (++(ctx->ctr)[15-i] != 0) {\0A                    break;\0A                }\0A            }\0A        }\0A\0A        input_len -= use_len;\0A        input += use_len;\0A        output += use_len;\0A    }\0A\0Aexit:\0A    mbedtls_platform_zeroize(local_output, 16);\0A\0A    return ret;\0A}\0A\0Aint mbedtls_ccm_finish(mbedtls_ccm_context *ctx,\0A                       unsigned char *tag, size_t tag_len)\0A{\0A    int ret = MBEDTLS_ERR_ERROR_CORRUPTION_DETECTED;\0A    unsigned char i;\0A\0A    if (ctx->state & CCM_STATE__ERROR) {\0A        return MBEDTLS_ERR_ERROR_CORRUPTION_DETECTED;\0A    }\0A\0A    if (ctx->add_len > 0 && !(ctx->state & CCM_STATE__AUTH_DATA_FINISHED)) {\0A        return MBEDTLS_ERR_CCM_BAD_INPUT;\0A    }\0A\0A    if (ctx->plaintext_len > 0 && ctx->processed != ctx->plaintext_len) {\0A        return MBEDTLS_ERR_CCM_BAD_INPUT;\0A    }\0A\0A    /*\0A     * Authentication: reset counter and crypt/mask internal tag\0A     */\0A    for (i = 0; i < ctx->q; i++) {\0A        ctx->ctr[15-i] = 0;\0A    }\0A\0A    ret = mbedtls_ccm_crypt(ctx, 0, 16, ctx->y, ctx->y);\0A    if (ret != 0) {\0A        return ret;\0A    }\0A    if (tag != NULL) {\0A        memcpy(tag, ctx->y, tag_len);\0A    }\0A    mbedtls_ccm_clear_state(ctx);\0A\0A    return 0;\0A}\0A\0A/*\0A * Authenticated encryption or decryption\0A */\0Astatic int ccm_auth_crypt(mbedtls_ccm_context *ctx, int mode, size_t length,\0A                          const unsigned char *iv, size_t iv_len,\0A                          const unsigned char *add, size_t add_len,\0A                          const unsigned char *input, unsigned char *output,\0A                  