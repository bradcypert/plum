@.str40842 = private global { i64, i64, [7303 x i8] } { i64 -1, i64 7302, [7303 x i8] c"/**\0A * \5Cfile sha512.h\0A * \5Cbrief This file contains SHA-384 and SHA-512 definitions and functions.\0A *\0A * The Secure Hash Algorithms 384 and 512 (SHA-384 and SHA-512) cryptographic\0A * hash functions are defined in <em>FIPS 180-4: Secure Hash Standard (SHS)</em>.\0A */\0A/*\0A *  Copyright The Mbed TLS Contributors\0A *  SPDX-License-Identifier: Apache-2.0 OR GPL-2.0-or-later\0A */\0A#ifndef MBEDTLS_SHA512_H\0A#define MBEDTLS_SHA512_H\0A#include \22mbedtls/private_access.h\22\0A\0A#include \22mbedtls/build_info.h\22\0A\0A#include <stddef.h>\0A#include <stdint.h>\0A\0A/** SHA-512 input data was malformed. */\0A#define MBEDTLS_ERR_SHA512_BAD_INPUT_DATA                 -0x0075\0A\0A#ifdef __cplusplus\0Aextern \22C\22 {\0A#endif\0A\0A#if !defined(MBEDTLS_SHA512_ALT)\0A// Regular implementation\0A//\0A\0A/**\0A * \5Cbrief          The SHA-512 context structure.\0A *\0A *                 The structure is used both for SHA-384 and for SHA-512\0A *                 checksum calculations. The choice between these two is\0A *                 made in the call to mbedtls_sha512_starts().\0A */\0Atypedef struct mbedtls_sha512_context {\0A    uint64_t MBEDTLS_PRIVATE(total)[2];          /*!< The number of Bytes processed. */\0A    uint64_t MBEDTLS_PRIVATE(state)[8];          /*!< The intermediate digest state. */\0A    unsigned char MBEDTLS_PRIVATE(buffer)[128];  /*!< The data block being processed. */\0A#if defined(MBEDTLS_SHA384_C)\0A    int MBEDTLS_PRIVATE(is384);                  /*!< Determines which function to use:\0A                                                      0: Use SHA-512, or 1: Use SHA-384. */\0A#endif\0A}\0Ambedtls_sha512_context;\0A\0A#else  /* MBEDTLS_SHA512_ALT */\0A#include \22sha512_alt.h\22\0A#endif /* MBEDTLS_SHA512_ALT */\0A\0A/**\0A * \5Cbrief          This function initializes a SHA-512 context.\0A *\0A * \5Cparam ctx      The SHA-512 context to initialize. This must\0A *                 not be \5Cc NULL.\0A */\0Avoid mbedtls_sha512_init(mbedtls_sha512_context *ctx);\0A\0A/**\0A * \5Cbrief          This function clears a SHA-512 context.\0A *\0A * \5Cparam ctx      The SHA-512 context to clear. This may be \5Cc NULL,\0A *                 in which case this function does nothing. If it\0A *                 is not \5Cc NULL, it must point to an initialized\0A *                 SHA-512 context.\0A */\0Avoid mbedtls_sha512_free(mbedtls_sha512_context *ctx);\0A\0A/**\0A * \5Cbrief          This function clones the state of a SHA-512 context.\0A *\0A * \5Cparam dst      The destination context. This must be initialized.\0A * \5Cparam src      The context to clone. This must be initialized.\0A */\0Avoid mbedtls_sha512_clone(mbedtls_sha512_context *dst,\0A                          const mbedtls_sha512_context *src);\0A\0A/**\0A * \5Cbrief          This function starts a SHA-384 or SHA-512 checksum\0A *                 calculation.\0A *\0A * \5Cparam ctx      The SHA-512 context to use. This must be initialized.\0A * \5Cparam is384    Determines which function to use. This must be\0A *                 either \5Cc 0 for SHA-512, or \5Cc 1 for SHA-384.\0A *\0A * \5Cnote           is384 must be defined accordingly to the enabled\0A *                 MBEDTLS_SHA384_C/MBEDTLS_SHA512_C symbols otherwise the\0A *                 function will return #MBEDTLS_ERR_SHA512_BAD_INPUT_DATA.\0A *\0A * \5Creturn         \5Cc 0 on success.\0A * \5Creturn         A negative error code on failure.\0A */\0Aint mbedtls_sha512_starts(mbedtls_sha512_context *ctx, int is384);\0A\0A/**\0A * \5Cbrief          This function feeds an input buffer into an ongoing\0A *                 SHA-512 checksum calculation.\0A *\0A * \5Cparam ctx      The SHA-512 context. This must be initialized\0A *                 and have a hash operation started.\0A * \5Cparam input    The buffer holding the input data. This must\0A *                 be a readable buffer of length \5Cp ilen Bytes.\0A * \5Cparam ilen     The length of the input data in Bytes.\0A *\0A * \5Creturn         \5Cc 0 on success.\0A * \5Creturn         A negative error code on failure.\0A */\0Aint mbedtls_sha512_update(mbedtls_sha512_context *ctx,\0A                          const unsigned char *input,\0A                          size_t ilen);\0A\0A/**\0A * \5Cbrief          This function finishes the SHA-512 operation, and writes\0A *                 the result to the output buffer.\0A *\0A * \5Cparam ctx      The SHA-512 context. This must be initialized\0A *                 and have a hash operation started.\0A * \5Cparam output   The SHA-384 or SHA-512 checksum result.\0A *                 This must be a writable buffer of length \5Cc 64 bytes\0A *                 for SHA-512, \5Cc 48 bytes for SHA-384.\0A *\0A * \5Creturn         \5Cc 0 on success.\0A * \5Creturn         A negative error code on failure.\0A */\0Aint mbedtls_sha512_finish(mbedtls_sha512_context *ctx,\0A                          unsigned char *output);\0A\0A/**\0A * \5Cbrief          This function processes a single data block within\0A *                 the ongoing SHA-512 computation.\0A *                 This function is for internal use only.\0A *\0A * \5Cparam ctx      The SHA-512 context. This must be initialized.\0A * \5Cparam data     The buffer holding one block of data. This\0A *                 must be a readable buffer of length \5Cc 128 Bytes.\0A *\0A * \5Creturn         \5Cc 0 on success.\0A * \5Creturn         A negative error code on failure.\0A */\0Aint mbedtls_internal_sha512_process(mbedtls_sha512_context *ctx,\0A                                    const unsigned char data[128]);\0A\0A/**\0A * \5Cbrief          This function calculates the SHA-512 or SHA-384\0A *                 checksum of a buffer.\0A *\0A *                 The function allocates the context, performs the\0A *                 calculation, and frees the context.\0A *\0A *                 The SHA-512 result is calculated as\0A *                 output = SHA-512(input buffer).\0A *\0A * \5Cparam input    The buffer holding the input data. This must be\0A *                 a readable buffer of length \5Cp ilen Bytes.\0A * \5Cparam ilen     The length of the input data in Bytes.\0A * \5Cparam output   The SHA-384 or SHA-512 checksum result.\0A *                 This must be a writable buffer of length \5Cc 64 bytes\0A *                 for SHA-512, \5Cc 48 bytes for SHA-384.\0A * \5Cparam is384    Determines which function to use. This must be either\0A *                 \5Cc 0 for SHA-512, or \5Cc 1 for SHA-384.\0A *\0A * \5Cnote           is384 must be defined accordingly with the supported\0A *                 symbols in the config file. If:\0A *                 - is384 is 0, but \5Cc MBEDTLS_SHA384_C is not defined, or\0A *                 - is384 is 1, but \5Cc MBEDTLS_SHA512_C is not defined\0A *                 then the function will return\0A *                 #MBEDTLS_ERR_SHA512_BAD_INPUT_DATA.\0A *\0A * \5Creturn         \5Cc 0 on success.\0A * \5Creturn         A negative error code on failure.\0A */\0Aint mbedtls_sha512(const unsigned char *input,\0A                   size_t ilen,\0A                   unsigned char *output,\0A                   int is384);\0A\0A#if defined(MBEDTLS_SELF_TEST)\0A\0A#if defined(MBEDTLS_SHA384_C)\0A/**\0A * \5Cbrief          The SHA-384 checkup routine.\0A *\0A * \5Creturn         \5Cc 0 on success.\0A * \5Creturn         \5Cc 1 on failure.\0A */\0Aint mbedtls_sha384_self_test(int verbose);\0A#endif /* MBEDTLS_SHA384_C */\0A\0A#if defined(MBEDTLS_SHA512_C)\0A/**\0A * \5Cbrief          The SHA-512 checkup routine.\0A *\0A * \5Creturn         \5Cc 0 on success.\0A * \5Creturn         \5Cc 1 on failure.\0A */\0Aint mbedtls_sha512_self_test(int verbose);\0A#endif /* MBEDTLS_SHA512_C */\0A\0A#endif /* MBEDTLS_SELF_TEST */\0A\0A#ifdef __cplusplus\0A}\0A#endif\0A\0A#endif /* mbedtls_sha512.h */\0A\00" }
