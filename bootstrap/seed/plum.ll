@.str41892 = private global { i64, i64, [4132 x i8] } { i64 -1, i64 4131, [4132 x i8] c"/** \5Cfile psa_crypto_random_impl.h\0A *\0A * \5Cbrief PSA crypto random generator implementation abstraction.\0A */\0A/*\0A *  Copyright The Mbed TLS Contributors\0A *  SPDX-License-Identifier: Apache-2.0 OR GPL-2.0-or-later\0A */\0A\0A#ifndef PSA_CRYPTO_RANDOM_IMPL_H\0A#define PSA_CRYPTO_RANDOM_IMPL_H\0A\0A#include \22psa_util_internal.h\22\0A\0A#if defined(MBEDTLS_PSA_CRYPTO_EXTERNAL_RNG)\0A\0Atypedef mbedtls_psa_external_random_context_t mbedtls_psa_random_context_t;\0A\0A#else /* MBEDTLS_PSA_CRYPTO_EXTERNAL_RNG */\0A\0A#include \22mbedtls/entropy.h\22\0A\0A/* Choose a DRBG based on configuration and availability */\0A#if defined(MBEDTLS_CTR_DRBG_C)\0A\0A#include \22mbedtls/ctr_drbg.h\22\0A#undef MBEDTLS_PSA_HMAC_DRBG_MD_TYPE\0A\0A#elif defined(MBEDTLS_HMAC_DRBG_C)\0A\0A#include \22mbedtls/hmac_drbg.h\22\0A#if defined(MBEDTLS_MD_CAN_SHA512) && defined(MBEDTLS_MD_CAN_SHA256)\0A#include <limits.h>\0A#if SIZE_MAX > 0xffffffff\0A/* Looks like a 64-bit system, so prefer SHA-512. */\0A#define MBEDTLS_PSA_HMAC_DRBG_MD_TYPE MBEDTLS_MD_SHA512\0A#else\0A/* Looks like a 32-bit system, so prefer SHA-256. */\0A#define MBEDTLS_PSA_HMAC_DRBG_MD_TYPE MBEDTLS_MD_SHA256\0A#endif\0A#elif defined(MBEDTLS_MD_CAN_SHA512)\0A#define MBEDTLS_PSA_HMAC_DRBG_MD_TYPE MBEDTLS_MD_SHA512\0A#elif defined(MBEDTLS_MD_CAN_SHA256)\0A#define MBEDTLS_PSA_HMAC_DRBG_MD_TYPE MBEDTLS_MD_SHA256\0A#else\0A#error \22No hash algorithm available for HMAC_DBRG.\22\0A#endif\0A\0A#else /* !MBEDTLS_CTR_DRBG_C && !MBEDTLS_HMAC_DRBG_C*/\0A\0A#error \22No DRBG module available for the psa_crypto module.\22\0A\0A#endif /* !MBEDTLS_CTR_DRBG_C && !MBEDTLS_HMAC_DRBG_C*/\0A\0A/* The maximum number of bytes that mbedtls_psa_get_random() is expected to return. */\0A#if defined(MBEDTLS_CTR_DRBG_C)\0A#define MBEDTLS_PSA_RANDOM_MAX_REQUEST MBEDTLS_CTR_DRBG_MAX_REQUEST\0A#elif defined(MBEDTLS_HMAC_DRBG_C)\0A#define MBEDTLS_PSA_RANDOM_MAX_REQUEST MBEDTLS_HMAC_DRBG_MAX_REQUEST\0A#endif\0A\0A#if defined(MBEDTLS_CTR_DRBG_C)\0Atypedef mbedtls_ctr_drbg_context            mbedtls_psa_drbg_context_t;\0A#elif defined(MBEDTLS_HMAC_DRBG_C)\0Atypedef mbedtls_hmac_drbg_context           mbedtls_psa_drbg_context_t;\0A#endif /* !MBEDTLS_CTR_DRBG_C && !MBEDTLS_HMAC_DRBG_C */\0A\0Atypedef struct {\0A    void (* entropy_init)(mbedtls_entropy_context *ctx);\0A    void (* entropy_free)(mbedtls_entropy_context *ctx);\0A    mbedtls_entropy_context entropy;\0A    mbedtls_psa_drbg_context_t drbg;\0A} mbedtls_psa_random_context_t;\0A\0A/** Initialize the PSA DRBG.\0A *\0A * \5Cparam p_rng        Pointer to the Mbed TLS DRBG state.\0A */\0Astatic inline void mbedtls_psa_drbg_init(mbedtls_psa_drbg_context_t *p_rng)\0A{\0A#if defined(MBEDTLS_CTR_DRBG_C)\0A    mbedtls_ctr_drbg_init(p_rng);\0A#elif defined(MBEDTLS_HMAC_DRBG_C)\0A    mbedtls_hmac_drbg_init(p_rng);\0A#endif\0A}\0A\0A/** Deinitialize the PSA DRBG.\0A *\0A * \5Cparam p_rng        Pointer to the Mbed TLS DRBG state.\0A */\0Astatic inline void mbedtls_psa_drbg_free(mbedtls_psa_drbg_context_t *p_rng)\0A{\0A#if defined(MBEDTLS_CTR_DRBG_C)\0A    mbedtls_ctr_drbg_free(p_rng);\0A#elif defined(MBEDTLS_HMAC_DRBG_C)\0A    mbedtls_hmac_drbg_free(p_rng);\0A#endif\0A}\0A\0A/** Seed the PSA DRBG.\0A *\0A * \5Cparam entropy       An entropy context to read the seed from.\0A * \5Cparam custom        The personalization string.\0A *                      This can be \5Cc NULL, in which case the personalization\0A *                      string is empty regardless of the value of \5Cp len.\0A * \5Cparam len           The length of the personalization string.\0A *\0A * \5Creturn              \5Cc 0 on success.\0A * \5Creturn              An Mbed TLS error code (\5Cc MBEDTLS_ERR_xxx) on failure.\0A */\0Astatic inline int mbedtls_psa_drbg_seed(mbedtls_psa_drbg_context_t *drbg_ctx,\0A                                        mbedtls_entropy_context *entropy,\0A                                        const unsigned char *custom, size_t len)\0A{\0A#if defined(MBEDTLS_CTR_DRBG_C)\0A    return mbedtls_ctr_drbg_seed(drbg_ctx, mbedtls_entropy_func, entropy, custom, len);\0A#elif defined(MBEDTLS_HMAC_DRBG_C)\0A    const mbedtls_md_info_t *md_info = mbedtls_md_info_from_type(MBEDTLS_PSA_HMAC_DRBG_MD_TYPE);\0A    return mbedtls_hmac_drbg_seed(drbg_ctx, md_info, mbedtls_entropy_func, entropy, custom, len);\0A#endif\0A}\0A\0A#endif /* MBEDTLS_PSA_CRYPTO_EXTERNAL_RNG */\0A\0A#endif /* PSA_CRYPTO_RANDOM_IMPL_H */\0A\00" }
