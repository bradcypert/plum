ward zero. Use\0A/// `Duration.as_nanos` when the remainder matters.\0Apub let Duration.as_micros (d: Duration): Int = d.nanos / 1000\0A/// The duration in milliseconds, TRUNCATED toward zero. Use\0A/// `Duration.as_nanos` when the remainder matters.\0Apub let Duration.as_millis (d: Duration): Int = d.nanos / 1000000\0A/// The duration in whole seconds, TRUNCATED toward zero. Use\0A/// `Duration.as_nanos` when the remainder matters.\0Apub let Duration.as_seconds (d: Duration): Int = d.nanos / 1000000000\0A/// Whether this is exactly no time. A negative duration is not zero.\0Apub let Duration.is_zero (d: Duration): Bool = d.nanos == 0\0A\0A/// Adds two durations.\0Apub let Duration.add (a: Duration) (b: Duration): Duration = Duration { nanos: a.nanos + b.nanos }\0A/// Subtracts `b` from `a`. The result may be negative, which is a\0A/// legal duration and is what `Time.between` returns for two instants\0A/// given the other way round.\0Apub let Duration.sub (a: Duration) (b: Duration): Duration = Duration { nanos: a.nanos - b.nanos }\0A/// Multiplies a duration by a whole number.\0Apub let Duration.scale (d: Duration) (n: Int): Duration = Duration { nanos: d.nanos * n }\0A\0A/// A duration can be NEGATIVE. `sub` may produce one, and refusing\0A/// to represent it would only move the problem to every caller of\0A/// `sub`. `sleep` treats a non-positive duration as no wait at all.\0Apub let Duration.negate (d: Duration): Duration = Duration { nanos: 0 - d.nanos }\0A\0A/// --- Comparison ---\0A///\0A/// Functions rather than `<`, because this checker offers ordered\0A/// comparison on `Int`, `Float` and `String` and on nothing else --\0A/// a struct has no `<`. `==` works, since that is structural.\0A///\0A/// If ordered comparison ever reaches single-field wrappers, `<`\0A/// starts working on a `Duration` for free and these stay as the\0A/// spelling that always worked.\0Apub let Duration.compare (a: Duration) (b: Duration): Int =\0A    if a.nanos < b.nanos { 0 - 1 } else if a.nanos > b.nanos { 1 } else { 0 }\0A/// Whether `a` is shorter than `b`.\0A///\0A/// Spelled out rather than `<`, because ordered comparison in this\0A/// language works on `Int`, `Float` and `String` and not on structs.\0A/// `==` does work, since that one is structural.\0Apub let Duration.lt (a: Duration) (b: Duration): Bool = a.nanos < b.nanos\0A/// Whether `a` is no longer than `b`.\0A///\0A/// Spelled out rather than `<`, because ordered comparison in this\0A/// language works on `Int`, `Float` and `String` and not on structs.\0A/// `==` does work, since that one is structural.\0Apub let Duration.le (a: Duration) (b: Duration): Bool = a.nanos <= b.nanos\0A/// Whether `a` is longer than `b`.\0A///\0A/// Spelled out rather than `<`, because ordered comparison in this\0A/// language works on `Int`, `Float` and `String` and not on structs.\0A/// `==` does work, since that one is structural.\0Apub let Duration.gt (a: Duration) (b: Duration): Bool = a.nanos > b.nanos\0A/// Whether `a` is at least as long as `b`.\0A///\0A/// Spelled out rather than `<`, because ordered comparison in this\0A/// language works on `Int`, `Float` and `String` and not on structs.\0A/// `==` does work, since that one is structural.\0Apub let Duration.ge (a: Duration) (b: Duration): Bool = a.nanos >= b.nanos\0A/// The shorter of two durations.\0Apub let Duration.min (a: Duration) (b: Duration): Duration = if a.nanos <= b.nanos { a } else { b }\0A/// The longer of two durations.\0Apub let Duration.max (a: Duration) (b: Duration): Duration = if a.nanos >= b.nanos { a } else { b }\0A\0A// --- Clocks ---\0A\0A/// Wall clock, in milliseconds since the Unix epoch. The same clock\0A/// `now()` reads, at a resolution `now()` cannot express.\0A///\0A/// It can jump: setting the system clock or an NTP correction moves\0A/// it, backwards included. Use it to say WHEN something happened;\0A/// use `instant` to measure how long something took.\0A///\0A/// Converted directly to milliseconds, with