dtls_calloc((size_t) MERKLE_TREE_LEAF_NODE_AM(ctx->params.type),\0A                                           sizeof(*ctx->ots_private_keys));\0A    if (ctx->ots_private_keys == NULL) {\0A        ret = MBEDTLS_ERR_LMS_ALLOC_FAILED;\0A        goto exit;\0A    }\0A\0A    /* Requires a cast to size_t to avoid an implicit cast warning on certain\0A     * platforms (particularly Windows) */\0A    ctx->ots_public_keys = mbedtls_calloc((size_t) MERKLE_TREE_LEAF_NODE_AM(ctx->params.type),\0A                                          sizeof(*ctx->ots_public_keys));\0A    if (ctx->ots_public_keys == NULL) {\0A        ret = MBEDTLS_ERR_LMS_ALLOC_FAILED;\0A        goto exit;\0A    }\0A\0A    for (idx = 0; idx < MERKLE_TREE_LEAF_NODE_AM(ctx->params.type); idx++) {\0A        mbedtls_lmots_private_init(&ctx->ots_private_keys[idx]);\0A        mbedtls_lmots_public_init(&ctx->ots_public_keys[idx]);\0A    }\0A\0A\0A    for (idx = 0; idx < MERKLE_TREE_LEAF_NODE_AM(ctx->params.type); idx++) {\0A        ret = mbedtls_lmots_generate_private_key(&ctx->ots_private_keys[idx],\0A                                                 otstype,\0A                                                 ctx->params.I_key_identifier,\0A                                                 idx, seed, seed_size);\0A        if (ret != 0) {\0A            goto exit;\0A        }\0A\0A        ret = mbedtls_lmots_calculate_public_key(&ctx->ots_public_keys[idx],\0A                                                 &ctx->ots_private_keys[idx]);\0A        if (ret != 0) {\0A            goto exit;\0A        }\0A    }\0A\0A    ctx->q_next_usable_key = 0;\0A\0Aexit:\0A    if (ret != 0) {\0A        mbedtls_lms_private_free(ctx);\0A    }\0A\0A    return ret;\0A}\0A\0Aint mbedtls_lms_calculate_public_key(mbedtls_lms_public_t *ctx,\0A                                     const mbedtls_lms_private_t *priv_ctx)\0A{\0A    const size_t node_bytes = MBEDTLS_LMS_M_NODE_BYTES(priv_ctx->params.type);\0A    int ret = MBEDTLS_ERR_ERROR_CORRUPTION_DETECTED;\0A    unsigned char *tree = NULL;\0A\0A    if (!priv_ctx->have_private_key) {\0A        return MBEDTLS_ERR_LMS_BAD_INPUT_DATA;\0A    }\0A\0A    if (priv_ctx->params.type\0A        != MBEDTLS_LMS_SHA256_M32_H10) {\0A        return MBEDTLS_ERR_LMS_BAD_INPUT_DATA;\0A    }\0A\0A    if (priv_ctx->params.otstype\0A        != MBEDTLS_LMOTS_SHA256_N32_W8) {\0A        return MBEDTLS_ERR_LMS_BAD_INPUT_DATA;\0A    }\0A\0A    tree = mbedtls_calloc((size_t) MERKLE_TREE_NODE_AM(priv_ctx->params.type),\0A                          node_bytes);\0A    if (tree == NULL) {\0A        return MBEDTLS_ERR_LMS_ALLOC_FAILED;\0A    }\0A\0A    memcpy(&ctx->params, &priv_ctx->params,\0A           sizeof(mbedtls_lmots_parameters_t));\0A\0A    ret = calculate_merkle_tree(priv_ctx, tree);\0A    if (ret != 0) {\0A        goto exit;\0A    }\0A\0A    /* Root node is always at position 1, due to 1-based indexing */\0A    memcpy(ctx->T_1_pub_key, &tree[node_bytes], node_bytes);\0A\0A    ctx->have_public_key = 1;\0A\0A    ret = 0;\0A\0Aexit:\0A    mbedtls_zeroize_and_free(tree, node_bytes *\0A                             (size_t) MERKLE_TREE_NODE_AM(priv_ctx->params.type));\0A\0A    return ret;\0A}\0A\0A\0Aint mbedtls_lms_sign(mbedtls_lms_private_t *ctx,\0A                     int (*f_rng)(void *, unsigned char *, size_t),\0A                     void *p_rng, const unsigned char *msg,\0A                     unsigned int msg_size, unsigned char *sig, size_t sig_size,\0A                     size_t *sig_len)\0A{\0A    uint32_t q_leaf_identifier;\0A    int ret = MBEDTLS_ERR_ERROR_CORRUPTION_DETECTED;\0A\0A    if (!ctx->have_private_key) {\0A        return MBEDTLS_ERR_LMS_BAD_INPUT_DATA;\0A    }\0A\0A    if (sig_size < MBEDTLS_LMS_SIG_LEN(ctx->params.type, ctx->params.otstype)) {\0A        return MBEDTLS_ERR_LMS_BUFFER_TOO_SMALL;\0A    }\0A\0A    if (ctx->params.type != MBEDTLS_LMS_SHA256_M32_H10) {\0A        return MBEDTLS_ERR_LMS_BAD_INPUT_DATA;\0A    }\0A\0A    if (ctx->params.otstype\0A        != MBEDTLS_LMOTS_SHA256_N32_W8) {\0A        return MBEDTLS_ERR_LMS_BAD_INPUT_DATA;\0A    }\0A\0A    if (ctx->q_next_usable_key >= MERKLE_TREE_LEAF_NODE_AM(ctx->params.type)) {\0A        return MBEDTLS_ERR_LMS_OUT_OF_PRIVATE_KEYS;\0A    }\0A\0A\0A    q_leaf_identifier = ctx->q_next_usable_key;\0A    /* This new value must _always_ be written back to the disk before the\0A     * signature is returned.\0A     */\0A    ctx->q_next_usable_key += 1;\0A\0A    if (MBEDTLS_LMS_SIG_LEN(ctx->params.type, ctx->params.otstype)\0A        < SIG_OTS_SIG_OFFSET) {\0A        return MBEDTLS_ERR_LMS_BAD_INPUT_DATA;\0A    }\0A\0A    ret = mbedtls_lmots_sign(&ctx->ots_private_keys[q_leaf_identifier],\0A                             f_rng,\0A                             p_rng,\0A                             msg,\0A                             msg_size,\0A                             sig + SIG_OTS_SIG_OFFSET,\0A                             MBEDTLS_LMS_SIG_LEN(ctx->params.type,\0A                                                 ctx->params.otstype) - SIG_OTS_SIG_OFFSET,\0A                             NULL);\0A    if (ret != 0) {\0A        return ret;\0A    }\0A\0A    MBEDTLS_PUT_UINT32_BE(ctx->params.type, sig, SIG_TYPE_OFFSET(ctx->params.otstype));\0A    MBEDTLS_PUT_UINT32_BE(q_leaf_identifier, sig, SIG_Q_LEAF_ID_OFFSET);\0A\0A    ret = get_merkle_path(ctx,\0A                          MERKLE_TREE_INTERNAL_NODE_AM(ctx->params.type) + q_leaf_identifier,\0A                          sig + SIG_PATH_OFFSET(ctx->params.otstype));\0A    if (ret != 0) {\0A        return ret;\0A    }\0A\0A    if (sig_len != NULL) {\0A        *sig_len = MBEDTLS_LMS_SIG_LEN(ctx->params.type, ctx->params.otstype);\0A    }\0A\0A\0A    return 0;\0A}\0A\0A#endif /* defined(MBEDTLS_LMS_PRIVATE) */\0A#endif /* defined(MBEDTLS_LMS_C) */\0A\00" }
