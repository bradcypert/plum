@.str41475 = private global { i64, i64, [6192 x i8] } { i64 -1, i64 6191, [6192 x i8] c"/**\0A * \5Cfile cipher_wrap.h\0A *\0A * \5Cbrief Cipher wrappers.\0A *\0A * \5Cauthor Adriaan de Jong <dejong@fox-it.com>\0A */\0A/*\0A *  Copyright The Mbed TLS Contributors\0A *  SPDX-License-Identifier: Apache-2.0 OR GPL-2.0-or-later\0A */\0A#ifndef MBEDTLS_CIPHER_WRAP_H\0A#define MBEDTLS_CIPHER_WRAP_H\0A\0A#include \22mbedtls/build_info.h\22\0A\0A#include \22mbedtls/cipher.h\22\0A\0A#if defined(MBEDTLS_USE_PSA_CRYPTO)\0A#include \22psa/crypto.h\22\0A#endif /* MBEDTLS_USE_PSA_CRYPTO */\0A\0A#ifdef __cplusplus\0Aextern \22C\22 {\0A#endif\0A\0A/* Support for GCM either through Mbed TLS SW implementation or PSA */\0A#if defined(MBEDTLS_GCM_C) || \5C\0A    (defined(MBEDTLS_USE_PSA_CRYPTO) && defined(PSA_WANT_ALG_GCM))\0A#define MBEDTLS_CIPHER_HAVE_GCM_VIA_LEGACY_OR_USE_PSA\0A#endif\0A\0A#if (defined(MBEDTLS_GCM_C) && defined(MBEDTLS_AES_C)) || \5C\0A    (defined(MBEDTLS_USE_PSA_CRYPTO) && defined(PSA_WANT_ALG_GCM) && defined(PSA_WANT_KEY_TYPE_AES))\0A#define MBEDTLS_CIPHER_HAVE_GCM_AES_VIA_LEGACY_OR_USE_PSA\0A#endif\0A\0A#if defined(MBEDTLS_CCM_C) || \5C\0A    (defined(MBEDTLS_USE_PSA_CRYPTO) && defined(PSA_WANT_ALG_CCM))\0A#define MBEDTLS_CIPHER_HAVE_CCM_VIA_LEGACY_OR_USE_PSA\0A#endif\0A\0A#if (defined(MBEDTLS_CCM_C) && defined(MBEDTLS_AES_C)) || \5C\0A    (defined(MBEDTLS_USE_PSA_CRYPTO) && defined(PSA_WANT_ALG_CCM) && defined(PSA_WANT_KEY_TYPE_AES))\0A#define MBEDTLS_CIPHER_HAVE_CCM_AES_VIA_LEGACY_OR_USE_PSA\0A#endif\0A\0A#if defined(MBEDTLS_CCM_C) || \5C\0A    (defined(MBEDTLS_USE_PSA_CRYPTO) && defined(PSA_WANT_ALG_CCM_STAR_NO_TAG))\0A#define MBEDTLS_CIPHER_HAVE_CCM_STAR_NO_TAG_VIA_LEGACY_OR_USE_PSA\0A#endif\0A\0A#if (defined(MBEDTLS_CCM_C) && defined(MBEDTLS_AES_C)) || \5C\0A    (defined(MBEDTLS_USE_PSA_CRYPTO) && defined(PSA_WANT_ALG_CCM_STAR_NO_TAG) && \5C\0A    defined(PSA_WANT_KEY_TYPE_AES))\0A#define MBEDTLS_CIPHER_HAVE_CCM_STAR_NO_TAG_AES_VIA_LEGACY_OR_USE_PSA\0A#endif\0A\0A#if defined(MBEDTLS_CHACHAPOLY_C) || \5C\0A    (defined(MBEDTLS_USE_PSA_CRYPTO) && defined(PSA_WANT_ALG_CHACHA20_POLY1305))\0A#define MBEDTLS_CIPHER_HAVE_CHACHAPOLY_VIA_LEGACY_OR_USE_PSA\0A#endif\0A\0A#if defined(MBEDTLS_CIPHER_HAVE_GCM_VIA_LEGACY_OR_USE_PSA) || \5C\0A    defined(MBEDTLS_CIPHER_HAVE_CCM_VIA_LEGACY_OR_USE_PSA) || \5C\0A    defined(MBEDTLS_CIPHER_HAVE_CCM_STAR_NO_TAG_VIA_LEGACY_OR_USE_PSA) || \5C\0A    defined(MBEDTLS_CIPHER_HAVE_CHACHAPOLY_VIA_LEGACY_OR_USE_PSA)\0A#define MBEDTLS_CIPHER_HAVE_SOME_AEAD_VIA_LEGACY_OR_USE_PSA\0A#endif\0A\0A/**\0A * Base cipher information. The non-mode specific functions and values.\0A */\0Astruct mbedtls_cipher_base_t {\0A    /** Base Cipher type (e.g. MBEDTLS_CIPHER_ID_AES) */\0A    mbedtls_cipher_id_t cipher;\0A\0A    /** Encrypt using ECB */\0A    int (*ecb_func)(void *ctx, mbedtls_operation_t mode,\0A                    const unsigned char *input, unsigned char *output);\0A\0A#if defined(MBEDTLS_CIPHER_MODE_CBC)\0A    /** Encrypt using CBC */\0A    int (*cbc_func)(void *ctx, mbedtls_operation_t mode, size_t length,\0A                    unsigned char *iv, const unsigned char *input,\0A                    unsigned char *output);\0A#endif\0A\0A#if defined(MBEDTLS_CIPHER_MODE_CFB)\0A    /** Encrypt using CFB (Full length) */\0A    int (*cfb_func)(void *ctx, mbedtls_operation_t mode, size_t length, size_t *iv_off,\0A                    unsigned char *iv, const unsigned char *input,\0A                    unsigned char *output);\0A#endif\0A\0A#if defined(MBEDTLS_CIPHER_MODE_OFB)\0A    /** Encrypt using OFB (Full length) */\0A    int (*ofb_func)(void *ctx, size_t length, size_t *iv_off,\0A                    unsigned char *iv,\0A                    const unsigned char *input,\0A                    unsigned char *output);\0A#endif\0A\0A#if defined(MBEDTLS_CIPHER_MODE_CTR)\0A    /** Encrypt using CTR */\0A    int (*ctr_func)(void *ctx, size_t length, size_t *nc_off,\0A                    unsigned char *nonce_counter, unsigned char *stream_block,\0A                    const unsigned char *input, unsigned char *output);\0A#endif\0A\0A#if defined(MBEDTLS_CIPHER_MODE_XTS)\0A    /** Encrypt or decrypt using XTS. */\0A    int (*xts_func)(void *ctx, mbedtls_operation_t mode, size_t length,\0A                    const unsigned char data_unit[16],\0A                    const unsigned char *input, unsigned char *output);\0A#endif\0A\0A#if defined(MBEDTLS_CIPHER_MODE_STREAM)\0A    /** Encrypt using STREAM */\0A    int (*stream_func)(void *ctx, size_t length,\0A                       const unsigned char *input, unsigned char *output);\0A#endif\0A\0A    /** Set key for encryption purposes */\0A    int (*setkey_enc_func)(void *ctx, const unsigned char *key,\0A                           unsigned int key_bitlen);\0A\0A#if !defined(MBEDTLS_BLOCK_CIPHER_NO_DECRYPT)\0A    /** Set key for decryption purposes */\0A    int (*setkey_dec_func)(void *ctx, const unsigned char *key,\0A                           unsigned int key_bitlen);\0A#endif\0A\0A    /** Allocate a new context */\0A    void * (*ctx_alloc_func)(void);\0A\0A    /** Free the given context */\0A    void (*ctx_free_func)(void *ctx);\0A\0A};\0A\0Atypedef struct {\0A    mbedtls_cipher_type_t type;\0A    const mbedtls_cipher_info_t *info;\0A} mbedtls_cipher_definition_t;\0A\0A#if defined(MBEDTLS_USE_PSA_CRYPTO)\0Atypedef enum {\0A    MBEDTLS_CIPHER_PSA_KEY_UNSET = 0,\0A    MBEDTLS_CIPHER_PSA_KEY_OWNED, /* Used for PSA-based cipher contexts which */\0A                                  /* use raw key material internally imported */\0A                                  /* as a volatile key, and which hence need  */\0A                                  /* to destroy that key when the context is  */\0A                                  /* freed.                                   */\0A    MBEDTLS_CIPHER_PSA_KEY_NOT_OWNED, /* Used for PSA-based cipher contexts   */\0A                                      /* which use a key provided by the      */\0A                                      /* user, and which hence will not be    */\0A                                      /* destroyed when the context is freed. */\0A} mbedtls_cipher_psa_key_ownership;\0A\0Atypedef struct {\0A    psa_algorithm_t alg;\0A    mbedtls_svc_key_id_t slot;\0A    mbedtls_cipher_psa_key_ownership slot_state;\0A} mbedtls_cipher_context_psa;\0A#endif /* MBEDTLS_USE_PSA_CRYPTO */\0A\0Aextern const mbedtls_cipher_definition_t mbedtls_cipher_definitions[];\0A\0Aextern int mbedtls_cipher_supported[];\0A\0Aextern const mbedtls_cipher_base_t *mbedtls_cipher_base_lookup_table[];\0A\0A#ifdef __cplusplus\0A}\0A#endif\0A\0A#endif /* MBEDTLS_CIPHER_WRAP_H */\0A\00" }
