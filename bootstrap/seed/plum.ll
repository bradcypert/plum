)\0A#include \22mbedtls/hmac_drbg.h\22\0A#endif\0A\0A#if defined(MBEDTLS_LMS_C)\0A#include \22mbedtls/lms.h\22\0A#endif\0A\0A#if defined(MBEDTLS_MD_C)\0A#include \22mbedtls/md.h\22\0A#endif\0A\0A#if defined(MBEDTLS_NET_C)\0A#include \22mbedtls/net_sockets.h\22\0A#endif\0A\0A#if defined(MBEDTLS_OID_C)\0A#include \22mbedtls/oid.h\22\0A#endif\0A\0A#if defined(MBEDTLS_PEM_PARSE_C) || defined(MBEDTLS_PEM_WRITE_C)\0A#include \22mbedtls/pem.h\22\0A#endif\0A\0A#if defined(MBEDTLS_PK_C)\0A#include \22mbedtls/pk.h\22\0A#endif\0A\0A#if defined(MBEDTLS_PKCS12_C)\0A#include \22mbedtls/pkcs12.h\22\0A#endif\0A\0A#if defined(MBEDTLS_PKCS5_C)\0A#include \22mbedtls/pkcs5.h\22\0A#endif\0A\0A#if defined(MBEDTLS_PKCS7_C)\0A#include \22mbedtls/pkcs7.h\22\0A#endif\0A\0A#if defined(MBEDTLS_POLY1305_C)\0A#include \22mbedtls/poly1305.h\22\0A#endif\0A\0A#if defined(MBEDTLS_RSA_C)\0A#include \22mbedtls/rsa.h\22\0A#endif\0A\0A#if defined(MBEDTLS_SHA1_C)\0A#include \22mbedtls/sha1.h\22\0A#endif\0A\0A#if defined(MBEDTLS_SHA256_C)\0A#include \22mbedtls/sha256.h\22\0A#endif\0A\0A#if defined(MBEDTLS_SHA3_C)\0A#include \22mbedtls/sha3.h\22\0A#endif\0A\0A#if defined(MBEDTLS_SHA512_C)\0A#include \22mbedtls/sha512.h\22\0A#endif\0A\0A#if defined(MBEDTLS_SSL_TLS_C)\0A#include \22mbedtls/ssl.h\22\0A#endif\0A\0A#if defined(MBEDTLS_THREADING_C)\0A#include \22mbedtls/threading.h\22\0A#endif\0A\0A#if defined(MBEDTLS_X509_USE_C) || defined(MBEDTLS_X509_CREATE_C)\0A#include \22mbedtls/x509.h\22\0A#endif\0A\0A\0Aconst char *mbedtls_high_level_strerr(int error_code)\0A{\0A    int high_level_error_code;\0A\0A    if (error_code < 0) {\0A        error_code = -error_code;\0A    }\0A\0A    /* Extract the high-level part from the error code. */\0A    high_level_error_code = error_code & 0xFF80;\0A\0A    switch (high_level_error_code) {\0A    /* Begin Auto-Generated Code. */\0A    #if defined(MBEDTLS_CIPHER_C)\0A        case -(MBEDTLS_ERR_CIPHER_FEATURE_UNAVAILABLE):\0A            return( \22CIPHER - The selected feature is not available\22 );\0A        case -(MBEDTLS_ERR_CIPHER_BAD_INPUT_DATA):\0A            return( \22CIPHER - Bad input parameters\22 );\0A        case -(MBEDTLS_ERR_CIPHER_ALLOC_FAILED):\0A            return( \22CIPHER - Failed to allocate memory\22 );\0A        case -(MBEDTLS_ERR_CIPHER_INVALID_PADDING):\0A            return( \22CIPHER - Input data contains invalid padding and is rejected\22 );\0A        case -(MBEDTLS_ERR_CIPHER_FULL_BLOCK_EXPECTED):\0A            return( \22CIPHER - Decryption of block requires a full block\22 );\0A        case -(MBEDTLS_ERR_CIPHER_AUTH_FAILED):\0A            return( \22CIPHER - Authentication failed (for AEAD modes)\22 );\0A        case -(MBEDTLS_ERR_CIPHER_INVALID_CONTEXT):\0A            return( \22CIPHER - The context is invalid. For example, because it was freed\22 );\0A#endif /* MBEDTLS_CIPHER_C */\0A\0A#if defined(MBEDTLS_DHM_C)\0A        case -(MBEDTLS_ERR_DHM_BAD_INPUT_DATA):\0A            return( \22DHM - Bad input parameters\22 );\0A        case -(MBEDTLS_ERR_DHM_READ_PARAMS_FAILED):\0A            return( \22DHM - Reading of the DHM parameters failed\22 );\0A        case -(MBEDTLS_ERR_DHM_MAKE_PARAMS_FAILED):\0A            return( \22DHM - Making of the DHM parameters failed\22 );\0A        case -(MBEDTLS_ERR_DHM_READ_PUBLIC_FAILED):\0A            return( \22DHM - Reading of the public values failed\22 );\0A        case -(MBEDTLS_ERR_DHM_MAKE_PUBLIC_FAILED):\0A            return( \22DHM - Making of the public value failed\22 );\0A        case -(MBEDTLS_ERR_DHM_CALC_SECRET_FAILED):\0A            return( \22DHM - Calculation of the DHM secret failed\22 );\0A        case -(MBEDTLS_ERR_DHM_INVALID_FORMAT):\0A            return( \22DHM - The ASN.1 data is not formatted correctly\22 );\0A        case -(MBEDTLS_ERR_DHM_ALLOC_FAILED):\0A            return( \22DHM - Allocation of memory failed\22 );\0A        case -(MBEDTLS_ERR_DHM_FILE_IO_ERROR):\0A            return( \22DHM - Read or write of file failed\22 );\0A        case