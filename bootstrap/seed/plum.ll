      const unsigned char *tag2,\0A                                    size_t tag_len)\0A{\0A    /* Check tag in \22constant-time\22 */\0A    int diff = mbedtls_ct_memcmp(tag1, tag2, tag_len);\0A\0A    if (diff != 0) {\0A        return MBEDTLS_ERR_CCM_AUTH_FAILED;\0A    }\0A\0A    return 0;\0A}\0A\0Astatic int ccm_auth_decrypt(mbedtls_ccm_context *ctx, int mode, size_t length,\0A                            const unsigned char *iv, size_t iv_len,\0A                            const unsigned char *add, size_t add_len,\0A                            const unsigned char *input, unsigned char *output,\0A                            const unsigned char *tag, size_t tag_len)\0A{\0A    int ret = MBEDTLS_ERR_ERROR_CORRUPTION_DETECTED;\0A    unsigned char check_tag[16];\0A\0A    if ((ret = ccm_auth_crypt(ctx, mode, length,\0A                              iv, iv_len, add, add_len,\0A                              input, output, check_tag, tag_len)) != 0) {\0A        return ret;\0A    }\0A\0A    if ((ret = mbedtls_ccm_compare_tags(tag, check_tag, tag_len)) != 0) {\0A        mbedtls_platform_zeroize(output, length);\0A        return ret;\0A    }\0A\0A    return 0;\0A}\0A\0Aint mbedtls_ccm_star_auth_decrypt(mbedtls_ccm_context *ctx, size_t length,\0A                                  const unsigned char *iv, size_t iv_len,\0A                                  const unsigned char *add, size_t add_len,\0A                                  const unsigned char *input, unsigned char *output,\0A                                  const unsigned char *tag, size_t tag_len)\0A{\0A    return ccm_auth_decrypt(ctx, MBEDTLS_CCM_STAR_DECRYPT, length,\0A                            iv, iv_len, add, add_len,\0A                            input, output, tag, tag_len);\0A}\0A\0Aint mbedtls_ccm_auth_decrypt(mbedtls_ccm_context *ctx, size_t length,\0A                             const unsigned char *iv, size_t iv_len,\0A                             const unsigned char *add, size_t add_len,\0A                