 String.char_len (s: String): Int = chars_of(s).len()\0A\0A/// Pad `s` to `width` CHARACTERS with `fill`, on the left or the right.\0A///\0A/// A `fill` that is not exactly one character returns `s` untouched, as\0A/// does a string already at least `width` wide. Both are deliberate: a\0A/// formatting helper that returns a `Result` is a formatting helper\0A/// nobody uses, and truncating to fit loses data that padding was never\0A/// asked to remove.\0A/// Padded on the LEFT to `width` characters — right-aligned text.\0A///\0A/// `fill` must be a single character. A string already at or past the\0A/// width is returned unchanged: this pads, it never truncates.\0Apub let String.pad_left (s: String) (width: Int) (fill: String): String = plum__pad(s, width, fill, true)\0A/// Padded on the RIGHT to `width` characters — left-aligned text.\0A/// Never truncates; see `String.pad_left`.\0Apub let String.pad_right (s: String) (width: Int) (fill: String): String = plum__pad(s, width, fill, false)\0A\0A// --- Formatting numbers (issue #23) ---\0A//\0A// String interpolation already exists -- `\22${a} + ${b} = ${a + b}\22` --\0A// so building output is not the gap. What was missing is CONTROL over\0A// how a number renders inside one: `${1.0 / 3.0}` gives\0A// 0.3333333333333333 and there was no way to ask for two places, and\0A// `${flags}` printing 20 is the wrong view of a bit field.\0A//\0A// These are the functions a `${x:.2}` syntax would lower to. Shipping\0A// them first means that syntax, if it ever arrives, can be designed\0A// against real usage rather than guessed -- and it stays purely\0A// additive, since it would be sugar over exactly these.\0A\0A/// Centred padding, completing the set beside `pad_left`/`pad_right`.\0A/// An odd remainder goes on the RIGHT, so a column of centred headings\0A/// lines up on its left edge rather than drifting.\0Apub let String.pad_center (s: String) (width: Int) (fill: String): String = {\0A    let n = String.char_len(s);\0A    if String.char_len(fill) != 1 || n >= width { s }\0A    else {\0A        let total = width - n;\0A        let left = total / 2;\0A        String.repeat(fill, left).concat(s).concat(String.repeat(fill, total - left))\0A    }\0A}\0A\0A/// `decimals` places after the point, rounded HALF TO EVEN. Precision is\0A/// clamped to 0..17: negative values act as 0, and values above 17 act as 17.\0A/// The limit leaves one guard digit for deterministic tie handling while\0A/// staying within the precision of a `Float`.\0A///\0A/// --- Why the rounding is done here and not by the C library ---\0A///\0A/// `snprintf(\22%.*f\22)` is correctly rounded on every platform and does\0A/// not give the same answer on all of them. glibc and Microsoft's CRT\0A/// agree on every value whose expansion is not an exact tie (2.675 is\0A/// really 2.674999..., and both render it 2.67) and disagree on ties:\0A/// glibc rounds 0.5, 1.5, 2.5, 3.5 to 0, 2, 2, 4 and the Microsoft CRT\0A/// to 1, 2, 3, 4.\0A///\0A/// A language whose programs print different\0A/// numbers depending on the machine has a worse problem than one whose\0A/// rounding is a line longer, so the decision is made here: the library\0A/// is asked for a high-precision expansion, and the rounding is applied\0A/// to the digits.\0A///\0A/// --- Why half to EVEN ---\0A///\0A/// It is IEEE 754's default (`roundTiesToEven`), which is what glibc\0A/// inherits from the ambient rounding mode rather than choosing, and it\0A/// is unbiased: rounding every tie away from zero accumulates. Summing\0A/// the thousand ties 0.5 .. 999.5 gives 500,500 rounded away and\0A/// 500,000 rounded to even, against an exact 500,000.\0A///\0A/// **`Float.round` rounds half AWAY from zero and that is not an\0A/// inconsistency.** C specifies `round()` that way regardless of the FP\0A/// mode, because it is arithmetic: \22the nearest integer, ties away\22,\0A/// while this is rendering. Every language with both has this pair.\0A///\0A/// --- Why 18 digits is enough to tell a tie from a near-miss ---\0A///\0A/// A tie has to be exact. The gap between neighbouring doubles near any\0A/// value whose fractional digits matter is enormously larger than\0A/// 1e-18: next to 2.5 it is about 4.4e-16, so the value after 2.5\0A/// renders as 2.500000000000000444 and is visibly not a tie. Above\0A/// about 1e3 the fraction is all zeros anyway.\0Apub let Float.to_fixed (x: Float) (decimals: Int): String = {\0A    let d = Int.clamp(decimals, 0, 17);\0A    let raw = float_fixed_raw(x, 18);\0A    // `inf` and `nan` have no digits to round.\0A    if !String.contains(raw, \22.\22) { raw } else { plum__round_decimals(raw, d) }\0A}\0A\0Alet plum__round_decimals (s: String) (d: Int): String = {\0A    let neg = String.starts_with(s, \22-\22);\0A    let body = if neg { String.slice(s, 1, String.char_len(s)) } else { s };\0A    let dot = Option.unwrap_or(String.index_of(body, \22.\22), String.char_len(body));\0A    let ip = String.slice(body, 0, dot);\0A    let fp = String.slice(body, dot + 1, String.char_len(body));\0A    let keep = String.slice(fp, 0, d);\0A    let rest = String.slice(fp, d, String.char_len(fp));\0A    let digits = ip.concat(keep);\0A    let bumped = if plum__rounds_up(digits, rest) { plum__inc_decimal(digits) } else { digits };\0A    let n = String.char_len(bumped);\0A    let out_ip = String.slice(bumped, 0, n - d);\0A    let out_fp = String.slice(bumped, n - d, n);\0A    let text = if d == 0 { out_ip } else { out_ip.concat(\22.\22).concat(out_fp) };\0A    // The sign survives a value that rounds to zero: `-0.00` says the\0A    // value was below zero, which is information. C does this too.\0A    if neg { \22-\22.concat(text) } else { text }\0A}\0A\0A/// `rest` is everything being discarded. Above half rounds up, below\0A/// half rounds down, and an EXACT half goes to whichever direction\0A/// leaves the last kept digit even.\0Alet plum__rounds_up (kept: String) (rest: String): Bool =\0A    if String.is_empty(rest) { false }\0A    else {\0A        let first = plum__digit_at(rest, 0);\0A        if first > 5 { true }\0A        else if first < 5 { false }\0A        else if plum__any_nonzero(rest, 1) { true }\0A        else {\0A            // An exact tie. Round to even.\0A            let last = if String.is_empty(kept) { 0 } else { plum__digit_at(kept, String.char_len(kept) - 1) };\0A            last - (last / 2) * 2 == 1\0A        }\0A    }\0A\0Alet plum__digit_at (s: String) (i: Int): Int =\0A    Option.unwrap_or(String.index_of(\220123456789\22, String.slice(s, i, i + 1)), 0)\0A\0Alet plum__any_nonzero (s: String) (i: Int): Bool =\0A    if i >= String.char_len(s) { false }\0A    else if plum__digit_at(s, i) != 0 { true }\0A    else { plum__any_nonzero(s, i + 1) }\0A\0A/// Adds one to a decimal digit string, growing it when every digit\0A/// carries: \22999\22 becomes \221000\22, which is what makes 9.99 round to\0A/// 10.0 without a special case.\0Alet plum__inc_decimal (s: String): String = plum__inc_acc(s, String.char_len(s) - 1, \22\22)\0A\0Alet plum__inc_acc (s: String) (i: Int) (acc: String): String =\0A    if i < 0 { \221\22.concat(acc) }\0A    else {\0A        let v = plum__digit_at(s, i) + 1;\0A        if v < 10 { String.slice(s, 0, i).concat(plum__radix_digit(v)).concat(acc) }\0A        else { plum__inc_acc(s, i - 1, \220\22.concat(acc)) }\0A    }\0A\0A/// --- Radix ---\0A///\0A/// SIGNED, and reversible: `Int.to_radix(-255, 16)` is \22-ff\22, which\0A/// `String.parse_int` would read back. That is the opposite of what C\0A/// and Rust print for `%x` on a negative, and it is the choice that\0A/// keeps `to_radix` a number conversion rather than a bit dump. For the\0A/// bit pattern, `Int.to_bits` says so in its name.\0A///\0A/// Radix is clamped to 2..36: one digit per character, `0-9a-z`.\0Apub let Int.to_radix (n: Int) (radix: Int): String = {\0A    let r = Int.clamp(radix, 2, 36);\0A    if n == 0 { \220\22 }\0A    // The most negative Int has no positive counterpart, so it