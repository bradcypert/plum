TLS_SSL_CHK_BUF_PTR(p, end, 7 + protocol_name_len);\0A\0A    MBEDTLS_SSL_DEBUG_MSG(3, (\22server side, adding alpn extension\22));\0A    /*\0A     * 0 . 1    ext identifier\0A     * 2 . 3    ext length\0A     * 4 . 5    protocol list length\0A     * 6 . 6    protocol name length\0A     * 7 . 7+n  protocol name\0A     */\0A    MBEDTLS_PUT_UINT16_BE(MBEDTLS_TLS_EXT_ALPN, p, 0);\0A\0A    *out_len = 7 + protocol_name_len;\0A\0A    MBEDTLS_PUT_UINT16_BE(protocol_name_len + 3, p, 2);\0A    MBEDTLS_PUT_UINT16_BE(protocol_name_len + 1, p, 4);\0A    /* Note: the length of the chosen protocol has been checked to be less\0A     * than 255 bytes in `mbedtls_ssl_conf_alpn_protocols`.\0A     */\0A    p[6] = MBEDTLS_BYTE_0(protocol_name_len);\0A\0A    memcpy(p + 7, ssl->alpn_chosen, protocol_name_len);\0A\0A#if defined(MBEDTLS_SSL_PROTO_TLS1_3)\0A    mbedtls_ssl_tls13_set_hs_sent_ext_mask(ssl, MBEDTLS_TLS_EXT_ALPN);\0A#endif\0A\0A    return 0;\0A}\0A#endif /* MBEDTLS_SSL_ALPN */\0A\0A#if defined(MBEDTLS_SSL_PROTO_TLS1_3) && \5C\0A    defined(MBEDTLS_SSL_SESSION_TICKETS) && \5C\0A    defined(MBEDTLS_SSL_SERVER_NAME_INDICATION) && \5C\0A    defined(MBEDTLS_SSL_CLI_C)\0Aint mbedtls_ssl_session_set_hostname(mbedtls_ssl_session *session,\0A                                     const char *hostname)\0A{\0A    /* Initialize to suppress unnecessary compiler warning */\0A    size_t hostname_len = 0;\0A\0A    /* Check if new hostname is valid before\0A     * making any change to current one */\0A    if (hostname != NULL) {\0A        hostname_len = strlen(hostname);\0A\0A        if (hostname_len > MBEDTLS_SSL_MAX_HOST_NAME_LEN) {\0A            return MBEDTLS_ERR_SSL_BAD_INPUT_DATA;\0A        }\0A    }\0A\0A    /* Now it's clear that we will overwrite the old hostname,\0A     * so we can free it safely */\0A    if (session->hostname != NULL) {\0A        mbedtls_zeroize_and_free(session->hostname,\0A                                 strlen(session->hostname));\0A    }\0A\0A    /* Passing NULL as