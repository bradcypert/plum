@.str44904 = private global { i64, i64, [155770 x i8] } { i64 -1, i64 155769, [155770 x i8] c"/**\0A * \5Cfile mbedtls_config.h\0A *\0A * \5Cbrief Configuration options (set of defines)\0A *\0A *  This set of compile-time options may be used to enable\0A *  or disable features selectively, and reduce the global\0A *  memory footprint.\0A */\0A/*\0A *  Copyright The Mbed TLS Contributors\0A *  SPDX-License-Identifier: Apache-2.0 OR GPL-2.0-or-later\0A */\0A\0A/**\0A * This is an optional version symbol that enables compatibility handling of\0A * config files.\0A *\0A * It is equal to the #MBEDTLS_VERSION_NUMBER of the Mbed TLS version that\0A * introduced the config format we want to be compatible with.\0A */\0A//#define MBEDTLS_CONFIG_VERSION 0x03000000\0A\0A/**\0A * \5Cname SECTION: System support\0A *\0A * This section sets system specific settings.\0A * \5C{\0A */\0A\0A/**\0A * \5Cdef MBEDTLS_HAVE_ASM\0A *\0A * The compiler has support for asm().\0A *\0A * Requires support for asm() in compiler.\0A *\0A * Used in:\0A *      library/aesni.h\0A *      library/aria.c\0A *      library/bn_mul.h\0A *      library/constant_time.c\0A *      library/padlock.h\0A *\0A * Required by:\0A *      MBEDTLS_AESCE_C\0A *      MBEDTLS_AESNI_C (on some platforms)\0A *      MBEDTLS_PADLOCK_C\0A *\0A * Comment to disable the use of assembly code.\0A */\0A#define MBEDTLS_HAVE_ASM\0A\0A/**\0A * \5Cdef MBEDTLS_NO_UDBL_DIVISION\0A *\0A * The platform lacks support for double-width integer division (64-bit\0A * division on a 32-bit platform, 128-bit division on a 64-bit platform).\0A *\0A * Used in:\0A *      include/mbedtls/bignum.h\0A *      library/bignum.c\0A *\0A * The bignum code uses double-width division to speed up some operations.\0A * Double-width division is often implemented in software that needs to\0A * be linked with the program. The presence of a double-width integer\0A * type is usually detected automatically through preprocessor macros,\0A * but the automatic detection cannot know whether the code needs to\0A * and can be linked with an implementation of division for that type.\0A * By default division is assumed to be usable if the type is present.\0A * Uncomment this option to prevent the use of double-width division.\0A *\0A * Note that division for the native integer type is always required.\0A * Furthermore, a 64-bit type is always required even on a 32-bit\0A * platform, but it need not support multiplication or division. In some\0A * cases it is also desirable to disable some double-width operations. For\0A * example, if double-width division is implemented in software, disabling\0A * it can reduce code size in some embedded targets.\0A */\0A//#define MBEDTLS_NO_UDBL_DIVISION\0A\0A/**\0A * \5Cdef MBEDTLS_NO_64BIT_MULTIPLICATION\0A *\0A * The platform lacks support for 32x32 -> 64-bit multiplication.\0A *\0A * Used in:\0A *      library/poly1305.c\0A *\0A * Some parts of the library may use multiplication of two unsigned 32-bit\0A * operands with a 64-bit result in order to speed up computations. On some\0A * platforms, this is not available in hardware and has to be implemented in\0A * software, usually in a library provided by the toolchain.\0A *\0A * Sometimes it is not desirable to have to link to that library. This option\0A * removes the dependency of that library on platforms that lack a hardware\0A * 64-bit multiplier by embedding a software implementation in Mbed TLS.\0A *\0A * Note that depending on the compiler, this may decrease performance compared\0A * to using the library function provided by the toolchain.\0A */\0A//#define MBEDTLS_NO_64BIT_MULTIPLICATION\0A\0A/**\0A * \5Cdef MBEDTLS_HAVE_SSE2\0A *\0A * CPU supports SSE2 instruction set.\0A *\0A * Uncomment if the CPU supports SSE2 (IA-32 specific).\0A */\0A//#define MBEDTLS_HAVE_SSE2\0A\0A/**\0A * \5Cdef MBEDTLS_HAVE_TIME\0A *\0A * System has time.h and time().\0A * The time does not need to be correct, only time differences are used,\0A * by contrast with MBEDTLS_HAVE_TIME_DATE\0A *\0A * Defining MBEDTLS_HAVE_TIME allows you to specify MBEDTLS_PLATFORM_TIME_ALT,\0A * MBEDTLS_PLATFORM_TIME_MACRO, MBEDTLS_PLATFORM_TIME_TYPE_MACRO and\0A * MBEDTLS_PLATFORM_STD_TIME.\0A *\0A * Comment if your system does not support time functions.\0A *\0A * \5Cnote If MBEDTLS_TIMING_C is set - to enable the semi-portable timing\0A *       interface - timing.c will include time.h on suitable platforms\0A *       regardless of the setting of MBEDTLS_HAVE_TIME, unless\0A *       MBEDTLS_TIMING_ALT is used. See timing.c for more information.\0A */\0A#define MBEDTLS_HAVE_TIME\0A\0A/**\0A * \5Cdef MBEDTLS_HAVE_TIME_DATE\0A *\0A * System has time.h, time(), and an implementation for\0A * mbedtls_platform_gmtime_r() (see below).\0A * The time needs to be correct (not necessarily very accurate, but at least\0A * the date should be correct). This is used to verify the validity period of\0A * X.509 certificates.\0A *\0A * Comment if your system does not have a correct clock.\0A *\0A * \5Cnote mbedtls_platform_gmtime_r() is an abstraction in platform_util.h that\0A * behaves similarly to the gmtime_r() function from the C standard. Refer to\0A * the documentation for mbedtls_platform_gmtime_r() for more information.\0A *\0A * \5Cnote It is possible to configure an implementation for\0A * mbedtls_platform_gmtime_r() at compile-time by using the macro\0A * MBEDTLS_PLATFORM_GMTIME_R_ALT.\0A */\0A#define MBEDTLS_HAVE_TIME_DATE\0A\0A/**\0A * \5Cdef MBEDTLS_PLATFORM_MEMORY\0A *\0A * Enable the memory allocation layer.\0A *\0A * By default Mbed TLS uses the system-provided calloc() and free().\0A * This allows different allocators (self-implemented or provided) to be\0A * provided to the platform abstraction layer.\0A *\0A * Enabling #MBEDTLS_PLATFORM_MEMORY without the\0A * MBEDTLS_PLATFORM_{FREE,CALLOC}_MACROs will provide\0A * \22mbedtls_platform_set_calloc_free()\22 allowing you to set an alternative calloc() and\0A * free() function pointer at runtime.\0A *\0A * Enabling #MBEDTLS_PLATFORM_MEMORY and specifying\0A * MBEDTLS_PLATFORM_{CALLOC,FREE}_MACROs will allow you to specify the\0A * alternate function at compile time.\0A *\0A * An overview of how the value of mbedtls_calloc is determined:\0A *\0A * - if !MBEDTLS_PLATFORM_MEMORY\0A *     - mbedtls_calloc = calloc\0A * - if MBEDTLS_PLATFORM_MEMORY\0A *     - if (MBEDTLS_PLATFORM_CALLOC_MACRO && MBEDTLS_PLATFORM_FREE_MACRO):\0A *         - mbedtls_calloc = MBEDTLS_PLATFORM_CALLOC_MACRO\0A *     - if !(MBEDTLS_PLATFORM_CALLOC_MACRO && MBEDTLS_PLATFORM_FREE_MACRO):\0A *         - Dynamic setup via mbedtls_platform_set_calloc_free is now possible with a default value MBEDTLS_PLATFORM_STD_CALLOC.\0A *         - How is MBEDTLS_PLATFORM_STD_CALLOC handled?\0A *         - if MBEDTLS_PLATFORM_NO_STD_FUNCTIONS:\0A *             - MBEDTLS_PLATFORM_STD_CALLOC is not set to anything;\0A *             - MBEDTLS_PLATFORM_STD_MEM_HDR can be included if present;\0A *         - if !MBEDTLS_PLATFORM_NO_STD_FUNCTIONS:\0A *             - if MBEDTLS_PLATFORM_STD_CALLOC is present:\0A *                 - User-defined MBEDTLS_PLATFORM_STD_CALLOC is respected;\0A *             - if !MBEDTLS_PLATFORM_STD_CALLOC:\0A *                 - MBEDTLS_PLATFORM_STD_CALLOC = calloc\0A *\0A *         - At this point the presence of MBEDTLS_PLATFORM_STD_CALLOC is checked.\0A *         - if !MBEDTLS_PLATFORM_STD_CALLOC\0A *             - MBEDTLS_PLATFORM_STD_CALLOC = uninitialized_calloc\0A *\0A *         - mbedtls_calloc = MBEDTLS_PLATFORM_STD_CALLOC.\0A *\0A * Defining MBEDTLS_PLATFORM_CALLOC_MACRO and #MBEDTLS_PLATFORM_STD_CALLOC at the same time is not possible.\0A * MBEDTLS_PLATFORM_CALLOC_MACRO and MBEDTLS_PLATFORM_FREE_MACRO must both be defined or undefined at the same time.\0A * #MBEDTLS_PLATFORM_STD_CALLOC and #MBEDTLS_PLATFORM_STD_FREE do not have to be defined at the same time, as, if they are used,\0A * dynamic setup of these functions is possible. See the tree above to see how are they handled in all cases.\0A * An uninitialized #MBEDTLS_PLATFORM_STD_CALLOC always fails, returning a null pointer.\0A * An uninitialized #MBEDTLS_PLATFORM_STD_FREE does not do anything.\0A *\0A * Requires: MBEDTLS_PLATFORM_C\0A *\0A * Enable this layer to allow use of alternative memory allocators.\0A */\0A//#define MBEDTLS_PLATFORM_MEMORY\0A\0A/**\0A * \5Cdef MBEDTLS_PLATFORM_NO_STD_FUNCTIONS\0A *\0A * Do not assign standard functions in the platform layer (e.g. calloc() to\0A * MBEDTLS_PLATFORM_STD_CALLOC and printf() to MBEDTLS_PLATFORM_STD_PRINTF)\0A *\0A * This makes sure there are no linking errors on platforms that do not support\0A * these functions. You will HAVE to provide alternatives, either at runtime\0A * via the platform_set_xxx() functions or at compile time by setting\0A * the MBEDTLS_PLATFORM_STD_XXX defines, or enabling a\0A * MBEDTLS_PLATFORM_XXX_MACRO.\0A *\0A * Requires: MBEDTLS_PLATFORM_C\0A *\0A * Uncomment to prevent default assignment of standard functions in the\0A * platform layer.\0A */\0A//#define MBEDTLS_PLATFORM_NO_STD_FUNCTIONS\0A\0A/**\0A * \5Cdef MBEDTLS_PLATFORM_EXIT_ALT\0A *\0A * MBEDTLS_PLATFORM_XXX_ALT: Uncomment a macro to let Mbed TLS support the\0A * function in the platform abstraction layer.\0A *\0A * Example: In case you uncomment MBEDTLS_PLATFORM_PRINTF_ALT, Mbed TLS will\0A * provide a function \22mbedtls_platform_set_printf()\22 that allows you to set an\0A * alternative printf function pointer.\0A *\0A * All these define require MBEDTLS_PLATFORM_C to be defined!\0A *\0A * \5Cnote MBEDTLS_PLATFORM_SNPRINTF_ALT is required on Windows;\0A * it will be enabled automatically by check_config.h\0A *\0A * \5Cwarning MBEDTLS_PLATFORM_XXX_ALT cannot be defined at the same time as\0A * MBEDTLS_PLATFORM_XXX_MACRO!\0A *\0A * Requires: MBEDTLS_PLATFORM_TIME_ALT requires MBEDTLS_HAVE_TIME\0A *\0A * Uncomment a macro to enable alternate implementation of specific base\0A * platform function\0A */\0A//#define MBEDTLS_PLATFORM_SETBUF_ALT\0A//#define MBEDTLS_PLATFORM_EXIT_ALT\0A//#define MBEDTLS_PLATFORM_TIME_ALT\0A//#define MBEDTLS_PLATFORM_FPRINTF_ALT\0A//#define MBEDTLS_PLATFORM_PRINTF_ALT\0A//#define MBEDTLS_PLATFORM_SNPRINTF_ALT\0A//#define MBEDTLS_PLATFORM_VSNPRINTF_ALT\0A//#define MBEDTLS_PLATFORM_NV_SEED_ALT\0A//#define MBEDTLS_PLATFORM_SETUP_TEARDOWN_ALT\0A//#define MBEDTLS_PLATFORM_MS_TIME_ALT\0A\0A/**\0A * Uncomment the macro to let Mbed TLS use your alternate implementation of\0A * mbedtls_platform_gmtime_r(). This replaces the default implementation in\0A * platform_util.c.\0A *\0A * gmtime() is not a thread-safe function as defined in the C standard. The\0A * library will try to use safer implementations of this function, such as\0A * gmtime_r() when available. However, if Mbed TLS cannot identify the target\0A * system, the implementation of mbedtls_platform_gmtime_r() will default to\0A * using the standard gmtime(). In this case, calls from the library to\0A * gmtime() will be guarded by the global mutex mbedtls_threading_gmtime_mutex\0A * if MBEDTLS_THREADING_C is enabled. We recommend that calls from outside the\0A * library are also guarded with this mutex to avoid race conditions. However,\0A * if the macro MBEDTLS_PLATFORM_GMTIME_R_ALT is defined, Mbed TLS will\0A * unconditionally use the implementation for mbedtls_platform_gmtime_r()\0A * supplied at compile time.\0A */\0A//#define MBEDTLS_PLATFORM_GMTIME_R_ALT\0A\0A/**\0A * Uncomment the macro to let Mbed TLS use your alternate implementation of\0A * mbedtls_platform_zeroize(), to wipe sensitive data in memory. This replaces\0A * the default implementation in platform_util.c.\0A *\0A * By default, the library uses a system function such as memset_s()\0A * (optional feature of C11), explicit_bzero() (BSD and compatible), or\0A * SecureZeroMemory (Windows). If no such function is detected, the library\0A * falls back to a plain C implementation. Compilers are technically\0A * permitted to optimize this implementation out, meaning that the memory is\0A * not actually wiped. The library tries to prevent that, but the C language\0A * makes it impossible to guarantee that the memory will always be wiped.\0A *\0A * If your platform provides a guaranteed method to wipe memory which\0A * `platform_util.c` does not detect, define this macro to the name of\0A * a function that takes two arguments, a `void *` pointer and a length,\0A * and wipes that many bytes starting at the specified address. For example,\0A * if your platform has explicit_bzero() but `platform_util.c` does not\0A * detect its presence, define `MBEDTLS_PLATFORM_ZEROIZE_ALT` to be\0A * `explicit_bzero` to use that function as mbedtls_platform_zeroize().\0A */\0A//#define MBEDTLS_PLATFORM_ZEROIZE_ALT\0A\0A/**\0A * \5Cdef MBEDTLS_DEPRECATED_WARNING\0A *\0A * Mark deprecated functions and features so that they generate a warning if\0A * used. Functionality deprecated in one version will usually be removed in the\0A * next version. You can enable this to help you prepare the transition to a\0A * new major version by making sure your code is not using this functionality.\0A *\0A * This only works with GCC and Clang. With other compilers, you may want to\0A * use MBEDTLS_DEPRECATED_REMOVED\0A *\0A * Uncomment to get warnings on using deprecated functions and features.\0A */\0A//#define MBEDTLS_DEPRECATED_WARNING\0A\0A/**\0A * \5Cdef MBEDTLS_DEPRECATED_REMOVED\0A *\0A * Remove deprecated functions and features so that they generate an error if\0A * used. Functionality deprecated in one version will usually be removed in the\0A * next version. You can enable this to help you prepare the transition to a\0A * new major version by making sure your code is not using this functionality.\0A *\0A * Uncomment to get errors on using deprecated functions and features.\0A */\0A//#define MBEDTLS_DEPRECATED_REMOVED\0A\0A/** \5C} name SECTION: System support */\0A\0A/**\0A * \5Cname SECTION: Mbed TLS feature support\0A *\0A * This section sets support for features that are or are not needed\0A * within the modules that are enabled.\0A * \5C{\0A */\0A\0A/**\0A * \5Cdef MBEDTLS_TIMING_ALT\0A *\0A * Uncomment to provide your own alternate implementation for\0A * mbedtls_timing_get_timer(), mbedtls_set_alarm(), mbedtls_set/get_delay()\0A *\0A * Only works if you have MBEDTLS_TIMING_C enabled.\0A *\0A * You will need to provide a header \22timing_alt.h\22 and an implementation at\0A * compile time.\0A */\0A//#define MBEDTLS_TIMING_ALT\0A\0A/**\0A * \5Cdef MBEDTLS_AES_ALT\0A *\0A * MBEDTLS__MODULE_NAME__ALT: Uncomment a macro to let Mbed TLS use your\0A * alternate core implementation of a symmetric crypto, an arithmetic or hash\0A * module (e.g. platform specific assembly optimized implementations). Keep\0A * in mind that the function prototypes should remain the same.\0A *\0A * This replaces the whole module. If you only want to replace one of the\0A * functions, use one of the MBEDTLS__FUNCTION_NAME__ALT flags.\0A *\0A * Example: In case you uncomment MBEDTLS_AES_ALT, Mbed TLS will no longer\0A * provide the \22struct mbedtls_aes_context\22 definition and omit the base\0A * function declarations and implementations. \22aes_alt.h\22 will be included from\0A * \22aes.h\22 to include the new function definitions.\0A *\0A * Uncomment a macro to enable alternate implementation of the corresponding\0A * module.\0A *\0A * \5Cwarning   MD5, DES and SHA-1 are considered weak and their\0A *            use constitutes a security risk. If possible, we recommend\0A *            avoiding dependencies on them, and considering stronger message\0A *            digests and ciphers instead.\0A *\0A */\0A//#define MBEDTLS_AES_ALT\0A//#define MBEDTLS_ARIA_ALT\0A//#define MBEDTLS_CAMELLIA_ALT\0A//#define MBEDTLS_CCM_ALT\0A//#define MBEDTLS_CHACHA20_ALT\0A//#define MBEDTLS_CHACHAPOLY_ALT\0A//#define MBEDTLS_CMAC_ALT\0A//#define MBEDTLS_DES_ALT\0A//#define MBEDTLS_DHM_ALT\0A//#define MBEDTLS_ECJPAKE_ALT\0A//#define MBEDTLS_GCM_ALT\0A//#define MBEDTLS_NIST_KW_ALT\0A//#define MBEDTLS_MD5_ALT\0A//#define MBEDTLS_POLY1305_ALT\0A//#define MBEDTLS_RIPEMD160_ALT\0A//#define MBEDTLS_RSA_ALT\0A//#define MBEDTLS_SHA1_ALT\0A//#define MBEDTLS_SHA256_ALT\0A//#define MBEDTLS_SHA512_ALT\0A\0A/*\0A * When replacing the elliptic curve module, please consider, that it is\0A * implemented with two .c files:\0A *      - ecp.c\0A *      - ecp_curves.c\0A * You can replace them very much like all the other MBEDTLS__MODULE_NAME__ALT\0A * macros as described above. The only difference is that you have to make sure\0A * that you provide functionality for both .c files.\0A */\0A//#define MBEDTLS_ECP_ALT\0A\0A/**\0A * \5Cdef MBEDTLS_SHA256_PROCESS_ALT\0A *\0A * MBEDTLS__FUNCTION_NAME__ALT: Uncomment a macro to let Mbed TLS use you\0A * alternate core implementation of symmetric crypto or hash function. Keep in\0A * mind that function prototypes should remain the same.\0A *\0A * This replaces only one function. The header file from Mbed TLS is still\0A * used, in contrast to the MBEDTLS__MODULE_NAME__ALT flags.\0A *\0A * Example: In case you uncomment MBEDTLS_SHA256_PROCESS_ALT, Mbed TLS will\0A * no longer provide the mbedtls_sha1_process() function, but it will still provide\0A * the other function (using your mbedtls_sha1_process() function) and the definition\0A * of mbedtls_sha1_context, so your implementation of mbedtls_sha1_process must be compatible\0A * with this definition.\0A *\0A * \5Cnote If you use the AES_xxx_ALT macros, then it is recommended to also set\0A *       MBEDTLS_AES_ROM_TABLES in order to help the linker garbage-collect the AES\0A *       tables.\0A *\0A * Uncomment a macro to enable alternate implementation of the corresponding\0A * function.\0A *\0A * \5Cwarning   MD5, DES and SHA-1 are considered weak and their use\0A *            constitutes a security risk. If possible, we recommend avoiding\0A *            dependencies on them, and considering stronger message digests\0A *            and ciphers instead.\0A *\0A * \5Cwarning   If both MBEDTLS_ECDSA_SIGN_ALT and MBEDTLS_ECDSA_DETERMINISTIC are\0A *            enabled, then the deterministic ECDH signature functions pass the\0A *            the static HMAC-DRBG as RNG to mbedtls_ecdsa_sign(). Therefore\0A *            alternative implementations should use the RNG only for generating\0A *            the ephemeral key and nothing else. If this is not possible, then\0A *            MBEDTLS_ECDSA_DETERMINISTIC should be disabled and an alternative\0A *            implementation should be provided for mbedtls_ecdsa_sign_det_ext().\0A *\0A */\0A//#define MBEDTLS_MD5_PROCESS_ALT\0A//#define MBEDTLS_RIPEMD160_PROCESS_ALT\0A//#define MBEDTLS_SHA1_PROCESS_ALT\0A//#define MBEDTLS_SHA256_PROCESS_ALT\0A//#define MBEDTLS_SHA512_PROCESS_ALT\0A//#define MBEDTLS_DES_SETKEY_ALT\0A//#define MBEDTLS_DES_CRYPT_ECB_ALT\0A//#define MBEDTLS_DES3_CRYPT_ECB_ALT\0A//#define MBEDTLS_AES_SETKEY_ENC_ALT\0A//#define MBEDTLS_AES_SETKEY_DEC_ALT\0A//#define MBEDTLS_AES_ENCRYPT_ALT\0A//#define MBEDTLS_AES_DECRYPT_ALT\0A//#define MBEDTLS_ECDH_GEN_PUBLIC_ALT\0A//#define MBEDTLS_ECDH_COMPUTE_SHARED_ALT\0A//#define MBEDTLS_ECDSA_VERIFY_ALT\0A//#define MBEDTLS_ECDSA_SIGN_ALT\0A//#define MBEDTLS_ECDSA_GENKEY_ALT\0A\0A/**\0A * \5Cdef MBEDTLS_ECP_INTERNAL_ALT\0A *\0A * Expose a part of the internal interface of the Elliptic Curve Point module.\0A *\0A * MBEDTLS_ECP__FUNCTION_NAME__ALT: Uncomment a macro to let Mbed TLS use your\0A * alternative core implementation of elliptic curve arithmetic. Keep in mind\0A * that function prototypes should remain the same.\0A *\0A * This partially replaces one function. The header file from Mbed TLS is still\0A * used, in contrast to the MBEDTLS_ECP_ALT flag. The original implementation\0A * is still present and it is used for group structures not supported by the\0A * alternative.\0A *\0A * The original implementation can in addition be removed by setting the\0A * MBEDTLS_ECP_NO_FALLBACK option, in which case any function for which the\0A * corresponding MBEDTLS_ECP__FUNCTION_NAME__ALT macro is defined will not be\0A * able to fallback to curves not supported by the alternative implementation.\0A *\0A * Any of these options become available by defining MBEDTLS_ECP_INTERNAL_ALT\0A * and implementing the following functions:\0A *      unsigned char mbedtls_internal_ecp_grp_capable(\0A *          const mbedtls_ecp_group *grp )\0A *      int  mbedtls_internal_ecp_init( const mbedtls_ecp_group *grp )\0A *      void mbedtls_internal_ecp_free( const mbedtls_ecp_group *grp )\0A * The mbedtls_internal_ecp_grp_capable function should return 1 if the\0A * replacement functions implement arithmetic for the given group and 0\0A * otherwise.\0A * The functions mbedtls_internal_ecp_init and mbedtls_internal_ecp_free are\0A * called before and after each point operation and provide an opportunity to\0A * implement optimized set up and tear down instructions.\0A *\0A * Example: In case you set MBEDTLS_ECP_INTERNAL_ALT and\0A * MBEDTLS_ECP_DOUBLE_JAC_ALT, Mbed TLS will still provide the ecp_double_jac()\0A * function, but will use your mbedtls_internal_ecp_double_jac() if the group\0A * for the operation is supported by your implementation (i.e. your\0A * mbedtls_internal_ecp_grp_capable() function returns 1 for this group). If the\0A * group is not supported by your implementation, then the original Mbed TLS\0A * implementation of ecp_double_jac() is used instead, unless this fallback\0A * behaviour is disabled by setting MBEDTLS_ECP_NO_FALLBACK (in which case\0A * ecp_double_jac() will return MBEDTLS_ERR_ECP_FEATURE_UNAVAILABLE).\0A *\0A * The function prototypes and the definition of mbedtls_ecp_group and\0A * mbedtls_ecp_point will not change based on MBEDTLS_ECP_INTERNAL_ALT, so your\0A * implementation of mbedtls_internal_ecp__function_name__ must be compatible\0A * with their definitions.\0A *\0A * Uncomment a macro to enable alternate implementation of the corresponding\0A * function.\0A */\0A/* Required for all the functions in this section */\0A//#define MBEDTLS_ECP_INTERNAL_ALT\0A/* Turn off software fallback for curves not supported in hardware */\0A//#define MBEDTLS_ECP_NO_FALLBACK\0A/* Support for Weierstrass curves with Jacobi representation */\0A//#define MBEDTLS_ECP_RANDOMIZE_JAC_ALT\0A//#define MBEDTLS_ECP_ADD_MIXED_ALT\0A//#define MBEDTLS_ECP_DOUBLE_JAC_ALT\0A//#define MBEDTLS_ECP_NORMALIZE_JAC_MANY_ALT\0A//#define MBEDTLS_ECP_NORMALIZE_JAC_ALT\0A/* Support for curves with Montgomery arithmetic */\0A//#define MBEDTLS_ECP_DOUBLE_ADD_MXZ_ALT\0A//#define MBEDTLS_ECP_RANDOMIZE_MXZ_ALT\0A//#define MBEDTLS_ECP_NORMALIZE_MXZ_ALT\0A\0A/**\0A * \5Cdef MBEDTLS_ENTROPY_HARDWARE_ALT\0A *\0A * Uncomment this macro to let Mbed TLS use your own implementation of a\0A * hardware entropy collector.\0A *\0A * Your function must be called \5Cc mbedtls_hardware_poll(), have the same\0A * prototype as declared in library/entropy_poll.h, and accept NULL as first\0A * argument.\0A *\0A * Uncomment to use your own hardware entropy collector.\0A */\0A//#define MBEDTLS_ENTROPY_HARDWARE_ALT\0A\0A/**\0A * \5Cdef MBEDTLS_AES_ROM_TABLES\0A *\0A * Use precomputed AES tables stored in ROM.\0A *\0A * Uncomment this macro to use precomputed AES tables stored in ROM.\0A * Comment this macro to generate AES tables in RAM at runtime.\0A *\0A * Tradeoff: Using precomputed ROM tables reduces RAM usage by ~8kb\0A * (or ~2kb if \5Cc MBEDTLS_AES_FEWER_TABLES is used) and reduces the\0A * initialization time before the first AES operation can be performed.\0A * It comes at the cost of additional ~8kb ROM use (resp. ~2kb if \5Cc\0A * MBEDTLS_AES_FEWER_TABLES below is used), and potentially degraded\0A * performance if ROM access is slower than RAM access.\0A *\0A * This option is independent of \5Cc MBEDTLS_AES_FEWER_TABLES.\0A */\0A//#define MBEDTLS_AES_ROM_TABLES\0A\0A/**\0A * \5Cdef MBEDTLS_AES_FEWER_TABLES\0A *\0A * Use less ROM/RAM for AES tables.\0A *\0A * Uncommenting this macro omits 75% of the AES tables from\0A * ROM / RAM (depending on the value of \5Cc MBEDTLS_AES_ROM_TABLES)\0A * by computing their values on the fly during operations\0A * (the tables are entry-wise rotations of one another).\0A *\0A * Tradeoff: Uncommenting this reduces the RAM / ROM footprint\0A * by ~6kb but at the cost of more arithmetic operations during\0A * runtime. Specifically, one has to compare 4 accesses within\0A * different tables to 4 accesses with additional arithmetic\0A * operations within the same table. The performance gain/loss\0A * depends on the system and memory details.\0A *\0A * This option is independent of \5Cc MBEDTLS_AES_ROM_TABLES.\0A */\0A//#define MBEDTLS_AES_FEWER_TABLES\0A\0A/**\0A * \5Cdef MBEDTLS_AES_ONLY_128_BIT_KEY_LENGTH\0A *\0A * Use only 128-bit keys in AES operations to save ROM.\0A *\0A * Uncomment this macro to remove support for AES operations that use 192-\0A * or 256-bit keys.\0A *\0A * Uncommenting this macro reduces the size of AES code by ~300 bytes\0A * on v8-M/Thumb2.\0A *\0A * Module:  library/aes.c\0A *\0A * Requires: MBEDTLS_AES_C\0A */\0A//#define MBEDTLS_AES_ONLY_128_BIT_KEY_LENGTH\0A\0A/*\0A * Disable plain C implementation for AES.\0A *\0A * When the plain C implementation is enabled, and an implementation using a\0A * special CPU feature (such as MBEDTLS_AESCE_C) is also enabled, runtime\0A * detection will be used to select between them.\0A *\0A * If only one implementation is present, runtime detection will not be used.\0A * This configuration will crash at runtime if running on a CPU without the\0A * necessary features. It will not build unless at least one of MBEDTLS_AESCE_C\0A * and/or MBEDTLS_AESNI_C is enabled & present in the build.\0A */\0A//#define MBEDTLS_AES_USE_HARDWARE_ONLY\0A\0A/**\0A * \5Cdef MBEDTLS_CAMELLIA_SMALL_MEMORY\0A *\0A * Use less ROM for the Camellia implementation (saves about 768 bytes).\0A *\0A * Uncomment this macro to use less memory for Camellia.\0A */\0A//#define MBEDTLS_CAMELLIA_SMALL_MEMORY\0A\0A/**\0A * \5Cdef MBEDTLS_CHECK_RETURN_WARNING\0A *\0A * If this macro is defined, emit a compile-time warning if application code\0A * calls a function without checking its return value, but the return value\0A * should generally be checked in portable applications.\0A *\0A * This is only supported on platforms where #MBEDTLS_CHECK_RETURN is\0A * implemented. Otherwise this option has no effect.\0A *\0A * Uncomment to get warnings on using fallible functions without checking\0A * their return value.\0A *\0A * \5Cnote  This feature is a work in progress.\0A *        Warnings will be added to more functions in the future.\0A *\0A * \5Cnote  A few functions are considered critical, and ignoring the return\0A *        value of these functions will trigger a warning even if this\0A *        macro is not defined. To completely disable return value check\0A *        warnings, define #MBEDTLS_CHECK_RETURN with an empty expansion.\0A */\0A//#define MBEDTLS_CHECK_RETURN_WARNING\0A\0A/**\0A * \5Cdef MBEDTLS_CIPHER_MODE_CBC\0A *\0A * Enable Cipher Block Chaining mode (CBC) for symmetric ciphers.\0A */\0A#define MBEDTLS_CIPHER_MODE_CBC\0A\0A/**\0A * \5Cdef MBEDTLS_CIPHER_MODE_CFB\0A *\0A * Enable Cipher Feedback mode (CFB) for symmetric ciphers.\0A */\0A#define MBEDTLS_CIPHER_MODE_CFB\0A\0A/**\0A * \5Cdef MBEDTLS_CIPHER_MODE_CTR\0A *\0A * Enable Counter Block Cipher mode (CTR) for symmetric ciphers.\0A */\0A#define MBEDTLS_CIPHER_MODE_CTR\0A\0A/**\0A * \5Cdef MBEDTLS_CIPHER_MODE_OFB\0A *\0A * Enable Output Feedback mode (OFB) for symmetric ciphers.\0A */\0A#define MBEDTLS_CIPHER_MODE_OFB\0A\0A/**\0A * \5Cdef MBEDTLS_CIPHER_MODE_XTS\0A *\0A * Enable Xor-encrypt-xor with ciphertext stealing mode (XTS) for AES.\0A */\0A#define MBEDTLS_CIPHER_MODE_XTS\0A\0A/**\0A * \5Cdef MBEDTLS_CIPHER_NULL_CIPHER\0A *\0A * Enable NULL cipher.\0A * Warning: Only do so when you know what you are doing. This allows for\0A * encryption or channels without any security!\0A *\0A * To enable the following ciphersuites:\0A *      MBEDTLS_TLS_ECDH_ECDSA_WITH_NULL_SHA\0A *      MBEDTLS_TLS_ECDH_RSA_WITH_NULL_SHA\0A *      MBEDTLS_TLS_ECDHE_ECDSA_WITH_NULL_SHA\0A *      MBEDTLS_TLS_ECDHE_RSA_WITH_NULL_SHA\0A *      MBEDTLS_TLS_ECDHE_PSK_WITH_NULL_SHA384\0A *      MBEDTLS_TLS_ECDHE_PSK_WITH_NULL_SHA256\0A *      MBEDTLS_TLS_ECDHE_PSK_WITH_NULL_SHA\0A *      MBEDTLS_TLS_DHE_PSK_WITH_NULL_SHA384\0A *      MBEDTLS_TLS_DHE_PSK_WITH_NULL_SHA256\0A *      MBEDTLS_TLS_DHE_PSK_WITH_NULL_SHA\0A *      MBEDTLS_TLS_RSA_WITH_NULL_SHA256\0A *      MBEDTLS_TLS_RSA_WITH_NULL_SHA\0A *      MBEDTLS_TLS_RSA_WITH_NULL_MD5\0A *      MBEDTLS_TLS_RSA_PSK_WITH_NULL_SHA384\0A *      MBEDTLS_TLS_RSA_PSK_WITH_NULL_SHA256\0A *      MBEDTLS_TLS_RSA_PSK_WITH_NULL_SHA\0A *      MBEDTLS_TLS_PSK_WITH_NULL_SHA384\0A *      MBEDTLS_TLS_PSK_WITH_NULL_SHA256\0A *      MBEDTLS_TLS_PSK_WITH_NULL_SHA\0A *\0A * Uncomment this macro to enable the NULL cipher and ciphersuites\0A */\0A//#define MBEDTLS_CIPHER_NULL_CIPHER\0A\0A/**\0A * \5Cdef MBEDTLS_CIPHER_PADDING_PKCS7\0A *\0A * MBEDTLS_CIPHER_PADDING_XXX: Uncomment or comment macros to add support for\0A * specific padding modes in the cipher layer with cipher modes that support\0A * padding (e.g. CBC)\0A *\0A * If you disable all padding modes, only full blocks can be used with CBC.\0A *\0A * Enable padding modes in the cipher layer.\0A */\0A#define MBEDTLS_CIPHER_PADDING_PKCS7\0A#define MBEDTLS_CIPHER_PADDING_ONE_AND_ZEROS\0A#define MBEDTLS_CIPHER_PADDING_ZEROS_AND_LEN\0A#define MBEDTLS_CIPHER_PADDING_ZEROS\0A\0A/** \5Cdef MBEDTLS_CTR_DRBG_USE_128_BIT_KEY\0A *\0A * Uncomment this macro to use a 128-bit key in the CTR_DRBG module.\0A * Without this, CTR_DRBG uses a 256-bit key\0A * unless \5Cc MBEDTLS_AES_ONLY_128_BIT_KEY_LENGTH is set.\0A */\0A//#define MBEDTLS_CTR_DRBG_USE_128_BIT_KEY\0A\0A/**\0A * Enable the verified implementations of ECDH primitives from Project Everest\0A * (currently only Curve25519). This feature changes the layout of ECDH\0A * contexts and therefore is a compatibility break for applications that access\0A * fields of a mbedtls_ecdh_context structure directly. See also\0A * MBEDTLS_ECDH_LEGACY_CONTEXT in include/mbedtls/ecdh.h.\0A *\0A * The Everest code is provided under the Apache 2.0 license only; therefore enabling this\0A * option is not compatible with taking the library under the GPL v2.0-or-later license.\0A */\0A//#define MBEDTLS_ECDH_VARIANT_EVEREST_ENABLED\0A\0A/**\0A * \5Cdef MBEDTLS_ECP_DP_SECP192R1_ENABLED\0A *\0A * MBEDTLS_ECP_XXXX_ENABLED: Enables specific curves within the Elliptic Curve\0A * module.  By default all supported curves are enabled.\0A *\0A * Comment macros to disable the curve and functions for it\0A */\0A/* Short Weierstrass curves (supporting ECP, ECDH, ECDSA) */\0A#define MBEDTLS_ECP_DP_SECP192R1_ENABLED\0A#define MBEDTLS_ECP_DP_SECP224R1_ENABLED\0A#define MBEDTLS_ECP_DP_SECP256R1_ENABLED\0A#define MBEDTLS_ECP_DP_SECP384R1_ENABLED\0A#define MBEDTLS_ECP_DP_SECP521R1_ENABLED\0A#define MBEDTLS_ECP_DP_SECP192K1_ENABLED\0A#define MBEDTLS_ECP_DP_SECP224K1_ENABLED\0A#define MBEDTLS_ECP_DP_SECP256K1_ENABLED\0A#define MBEDTLS_ECP_DP_BP256R1_ENABLED\0A#define MBEDTLS_ECP_DP_BP384R1_ENABLED\0A#define MBEDTLS_ECP_DP_BP512R1_ENABLED\0A/* Montgomery curves (supporting ECP) */\0A#define MBEDTLS_ECP_DP_CURVE25519_ENABLED\0A#define MBEDTLS_ECP_DP_CURVE448_ENABLED\0A\0A/**\0A * \5Cdef MBEDTLS_ECP_NIST_OPTIM\0A *\0A * Enable specific 'modulo p' routines for each NIST prime.\0A * Depending on the prime and architecture, makes operations 4 to 8 times\0A * faster on the corresponding curve.\0A *\0A * Comment this macro to disable NIST curves optimisation.\0A */\0A#define MBEDTLS_ECP_NIST_OPTIM\0A\0A/**\0A * \5Cdef MBEDTLS_ECP_RESTARTABLE\0A *\0A * Enable \22non-blocking\22 ECC operations that can return early and be resumed.\0A *\0A * This allows various functions to pause by returning\0A * #MBEDTLS_ERR_ECP_IN_PROGRESS (or, for functions in the SSL module,\0A * #MBEDTLS_ERR_SSL_CRYPTO_IN_PROGRESS) and then be called later again in\0A * order to further progress and eventually complete their operation. This is\0A * controlled through mbedtls_ecp_set_max_ops() which limits the maximum\0A * number of ECC operations a function may perform before pausing; see\0A * mbedtls_ecp_set_max_ops() for more information.\0A *\0A * This is useful in non-threaded environments if you want to avoid blocking\0A * for too long on ECC (and, hence, X.509 or SSL/TLS) operations.\0A *\0A * This option:\0A * - Adds xxx_restartable() variants of existing operations in the\0A *   following modules, with corresponding restart context types:\0A *   - ECP (for Short Weierstrass curves only): scalar multiplication (mul),\0A *     linear combination (muladd);\0A *   - ECDSA: signature generation & verification;\0A *   - PK: signature generation & verification;\0A *   - X509: certificate chain verification.\0A * - Adds mbedtls_ecdh_enable_restart() in the ECDH module.\0A * - Changes the behaviour of TLS 1.2 clients (not servers) when using the\0A *   ECDHE-ECDSA key exchange (not other key exchanges) to make all ECC\0A *   computations restartable:\0A *   - ECDH operations from the key exchange, only for Short Weierstrass\0A *     curves, only when MBEDTLS_USE_PSA_CRYPTO is not enabled.\0A *   - verification of the server's key exchange signature;\0A *   - verification of the server's certificate chain;\0A *   - generation of the client's signature if client authentication is used,\0A *     with an ECC key/certificate.\0A *\0A * \5Cnote  In the cases above, the usual SSL/TLS functions, such as\0A *        mbedtls_ssl_handshake(), can now return\0A *        MBEDTLS_ERR_SSL_CRYPTO_IN_PROGRESS.\0A *\0A * \5Cnote  When this option and MBEDTLS_USE_PSA_CRYPTO are both enabled,\0A *        restartable operations in PK, X.509 and TLS (see above) are not\0A *        using PSA. On the other hand, ECDH computations in TLS are using\0A *        PSA, and are not restartable. These are temporary limitations that\0A *        should be lifted in the future.\0A *\0A * \5Cnote  This option only works with the default software implementation of\0A *        elliptic curve functionality. It is incompatible with\0A *        MBEDTLS_ECP_ALT, MBEDTLS_ECDH_XXX_ALT, MBEDTLS_ECDSA_XXX_ALT.\0A *\0A * Requires: MBEDTLS_ECP_C\0A *\0A * Uncomment this macro to enable restartable ECC computations.\0A */\0A//#define MBEDTLS_ECP_RESTARTABLE\0A\0A/**\0A * Uncomment to enable using new bignum code in the ECC modules.\0A *\0A * \5Cwarning This is currently experimental, incomplete and therefore should not\0A * be used in production.\0A */\0A//#define MBEDTLS_ECP_WITH_MPI_UINT\0A\0A/**\0A * \5Cdef MBEDTLS_ECDSA_DETERMINISTIC\0A *\0A * Enable deterministic ECDSA (RFC 6979).\0A * Standard ECDSA is \22fragile\22 in the sense that lack of entropy when signing\0A * may result in a compromise of the long-term signing key. This is avoided by\0A * the deterministic variant.\0A *\0A * Requires: MBEDTLS_HMAC_DRBG_C, MBEDTLS_ECDSA_C\0A *\0A * Comment this macro to disable deterministic ECDSA.\0A */\0A#define MBEDTLS_ECDSA_DETERMINISTIC\0A\0A/**\0A * \5Cdef MBEDTLS_KEY_EXCHANGE_PSK_ENABLED\0A *\0A * Enable the PSK based ciphersuite modes in SSL / TLS.\0A *\0A * This enables the following ciphersuites (if other requisites are\0A * enabled as well):\0A *      MBEDTLS_TLS_PSK_WITH_AES_256_GCM_SHA384\0A *      MBEDTLS_TLS_PSK_WITH_AES_256_CBC_SHA384\0A *      MBEDTLS_TLS_PSK_WITH_AES_256_CBC_SHA\0A *      MBEDTLS_TLS_PSK_WITH_CAMELLIA_256_GCM_SHA384\0A *      MBEDTLS_TLS_PSK_WITH_CAMELLIA_256_CBC_SHA384\0A *      MBEDTLS_TLS_PSK_WITH_AES_128_GCM_SHA256\0A *      MBEDTLS_TLS_PSK_WITH_AES_128_CBC_SHA256\0A *      MBEDTLS_TLS_PSK_WITH_AES_128_CBC_SHA\0A *      MBEDTLS_TLS_PSK_WITH_CAMELLIA_128_GCM_SHA256\0A *      MBEDTLS_TLS_PSK_WITH_CAMELLIA_128_CBC_SHA256\0A */\0A#define MBEDTLS_KEY_EXCHANGE_PSK_ENABLED\0A\0A/**\0A * \5Cdef MBEDTLS_KEY_EXCHANGE_DHE_PSK_ENABLED\0A *\0A * Enable the DHE-PSK based ciphersuite modes in SSL / TLS.\0A *\0A * Requires: MBEDTLS_DHM_C\0A *\0A * This enables the following ciphersuites (if other requisites are\0A * enabled as well):\0A *      MBEDTLS_TLS_DHE_PSK_WITH_AES_256_GCM_SHA384\0A *      MBEDTLS_TLS_DHE_PSK_WITH_AES_256_CBC_SHA384\0A *      MBEDTLS_TLS_DHE_PSK_WITH_AES_256_CBC_SHA\0A *      MBEDTLS_TLS_DHE_PSK_WITH_CAMELLIA_256_GCM_SHA384\0A *      MBEDTLS_TLS_DHE_PSK_WITH_CAMELLIA_256_CBC_SHA384\0A *      MBEDTLS_TLS_DHE_PSK_WITH_AES_128_GCM_SHA256\0A *      MBEDTLS_TLS_DHE_PSK_WITH_AES_128_CBC_SHA256\0A *      MBEDTLS_TLS_DHE_PSK_WITH_AES_128_CBC_SHA\0A *      MBEDTLS_TLS_DHE_PSK_WITH_CAMELLIA_128_GCM_SHA256\0A *      MBEDTLS_TLS_DHE_PSK_WITH_CAMELLIA_128_CBC_SHA256\0A *\0A * \5Cwarning    Using DHE constitutes a security risk as it\0A *             is not possible to validate custom DH parameters.\0A *             If possible, it is recommended users should consider\0A *             preferring other methods of key exchange.\0A *             See dhm.h for more details.\0A *\0A */\0A#define MBEDTLS_KEY_EXCHANGE_DHE_PSK_ENABLED\0A\0A/**\0A * \5Cdef MBEDTLS_KEY_EXCHANGE_ECDHE_PSK_ENABLED\0A *\0A * Enable the ECDHE-PSK based ciphersuite modes in SSL / TLS.\0A *\0A * Requires: MBEDTLS_ECDH_C or (MBEDTLS_USE_PSA_CRYPTO and PSA_WANT_ALG_ECDH)\0A *\0A * This enables the following ciphersuites (if other requisites are\0A * enabled as well):\0A *      MBEDTLS_TLS_ECDHE_PSK_WITH_AES_256_CBC_SHA384\0A *      MBEDTLS_TLS_ECDHE_PSK_WITH_AES_256_CBC_SHA\0A *      MBEDTLS_TLS_ECDHE_PSK_WITH_CAMELLIA_256_CBC_SHA384\0A *      MBEDTLS_TLS_ECDHE_PSK_WITH_AES_128_CBC_SHA256\0A *      MBEDTLS_TLS_ECDHE_PSK_WITH_AES_128_CBC_SHA\0A *      MBEDTLS_TLS_ECDHE_PSK_WITH_CAMELLIA_128_CBC_SHA256\0A */\0A#define MBEDTLS_KEY_EXCHANGE_ECDHE_PSK_ENABLED\0A\0A/**\0A * \5Cdef MBEDTLS_KEY_EXCHANGE_RSA_PSK_ENABLED\0A *\0A * Enable the RSA-PSK based ciphersuite modes in SSL / TLS.\0A *\0A * Requires: MBEDTLS_RSA_C, MBEDTLS_PKCS1_V15,\0A *           MBEDTLS_X509_CRT_PARSE_C\0A *\0A * This enables the following ciphersuites (if other requisites are\0A * enabled as well):\0A *      MBEDTLS_TLS_RSA_PSK_WITH_AES_256_GCM_SHA384\0A *      MBEDTLS_TLS_RSA_PSK_WITH_AES_256_CBC_SHA384\0A *      MBEDTLS_TLS_RSA_PSK_WITH_AES_256_CBC_SHA\0A *      MBEDTLS_TLS_RSA_PSK_WITH_CAMELLIA_256_GCM_SHA384\0A *      MBEDTLS_TLS_RSA_PSK_WITH_CAMELLIA_256_CBC_SHA384\0A *      MBEDTLS_TLS_RSA_PSK_WITH_AES_128_GCM_SHA256\0A *      MBEDTLS_TLS_RSA_PSK_WITH_AES_128_CBC_SHA256\0A *      MBEDTLS_TLS_RSA_PSK_WITH_AES_128_CBC_SHA\0A *      MBEDTLS_TLS_RSA_PSK_WITH_CAMELLIA_128_GCM_SHA256\0A *      MBEDTLS_TLS_RSA_PSK_WITH_CAMELLIA_128_CBC_SHA256\0A */\0A#define MBEDTLS_KEY_EXCHANGE_RSA_PSK_ENABLED\0A\0A/**\0A * \5Cdef MBEDTLS_KEY_EXCHANGE_RSA_ENABLED\0A *\0A * Enable the RSA-only based ciphersuite modes in SSL / TLS.\0A *\0A * Requires: MBEDTLS_RSA_C, MBEDTLS_PKCS1_V15,\0A *           MBEDTLS_X509_CRT_PARSE_C\0A *\0A * This enables the following ciphersuites (if other requisites are\0A * enabled as well):\0A *      MBEDTLS_TLS_RSA_WITH_AES_256_GCM_SHA384\0A *      MBEDTLS_TLS_RSA_WITH_AES_256_CBC_SHA256\0A *      MBEDTLS_TLS_RSA_WITH_AES_256_CBC_SHA\0A *      MBEDTLS_TLS_RSA_WITH_CAMELLIA_256_GCM_SHA384\0A *      MBEDTLS_TLS_RSA_WITH_CAMELLIA_256_CBC_SHA256\0A *      MBEDTLS_TLS_RSA_WITH_CAMELLIA_256_CBC_SHA\0A *      MBEDTLS_TLS_RSA_WITH_AES_128_GCM_SHA256\0A *      MBEDTLS_TLS_RSA_WITH_AES_128_CBC_SHA256\0A *      MBEDTLS_TLS_RSA_WITH_AES_128_CBC_SHA\0A *      MBEDTLS_TLS_RSA_WITH_CAMELLIA_128_GCM_SHA256\0A *      MBEDTLS_TLS_RSA_WITH_CAMELLIA_128_CBC_SHA256\0A *      MBEDTLS_TLS_RSA_WITH_CAMELLIA_128_CBC_SHA\0A */\0A#define MBEDTLS_KEY_EXCHANGE_RSA_ENABLED\0A\0A/**\0A * \5Cdef MBEDTLS_KEY_EXCHANGE_DHE_RSA_ENABLED\0A *\0A * Enable the DHE-RSA based ciphersuite modes in SSL / TLS.\0A *\0A * Requires: MBEDTLS_DHM_C, MBEDTLS_RSA_C, MBEDTLS_PKCS1_V15,\0A *           MBEDTLS_X509_CRT_PARSE_C\0A *\0A * This enables the following ciphersuites (if other requisites are\0A * enabled as well):\0A *      MBEDTLS_TLS_DHE_RSA_WITH_AES_256_GCM_SHA384\0A *      MBEDTLS_TLS_DHE_RSA_WITH_AES_256_CBC_SHA256\0A *      MBEDTLS_TLS_DHE_RSA_WITH_AES_256_CBC_SHA\0A *      MBEDTLS_TLS_DHE_RSA_WITH_CAMELLIA_256_GCM_SHA384\0A *      MBEDTLS_TLS_DHE_RSA_WITH_CAMELLIA_256_CBC_SHA256\0A *      MBEDTLS_TLS_DHE_RSA_WITH_CAMELLIA_256_CBC_SHA\0A *      MBEDTLS_TLS_DHE_RSA_WITH_AES_128_GCM_SHA256\0A *      MBEDTLS_TLS_DHE_RSA_WITH_AES_128_CBC_SHA256\0A *      MBEDTLS_TLS_DHE_RSA_WITH_AES_128_CBC_SHA\0A *      MBEDTLS_TLS_DHE_RSA_WITH_CAMELLIA_128_GCM_SHA256\0A *      MBEDTLS_TLS_DHE_RSA_WITH_CAMELLIA_128_CBC_SHA256\0A *      MBEDTLS_TLS_DHE_RSA_WITH_CAMELLIA_128_CBC_SHA\0A *\0A * \5Cwarning    Using DHE constitutes a security risk as it\0A *             is not possible to validate custom DH parameters.\0A *             If possible, it is recommended users should consider\0A *             preferring other methods of key exchange.\0A *             See dhm.h for more details.\0A *\0A */\0A#define MBEDTLS_KEY_EXCHANGE_DHE_RSA_ENABLED\0A\0A/**\0A * \5Cdef MBEDTLS_KEY_EXCHANGE_ECDHE_RSA_ENABLED\0A *\0A * Enable the ECDHE-RSA based ciphersuite modes in SSL / TLS.\0A *\0A * Requires: MBEDTLS_ECDH_C or (MBEDTLS_USE_PSA_CRYPTO and PSA_WANT_ALG_ECDH)\0A *           MBEDTLS_RSA_C\0A *           MBEDTLS_PKCS1_V15\0A *           MBEDTLS_X509_CRT_PARSE_C\0A *\0A * This enables the following ciphersuites (if other requisites are\0A * enabled as well):\0A *      MBEDTLS_TLS_ECDHE_RSA_WITH_AES_256_GCM_SHA384\0A *      MBEDTLS_TLS_ECDHE_RSA_WITH_AES_256_CBC_SHA384\0A *      MBEDTLS_TLS_ECDHE_RSA_WITH_AES_256_CBC_SHA\0A *      MBEDTLS_TLS_ECDHE_RSA_WITH_CAMELLIA_256_GCM_SHA384\0A *      MBEDTLS_TLS_ECDHE_RSA_WITH_CAMELLIA_256_CBC_SHA384\0A *      MBEDTLS_TLS_ECDHE_RSA_WITH_AES_128_GCM_SHA256\0A *      MBEDTLS_TLS_ECDHE_RSA_WITH_AES_128_CBC_SHA256\0A *      MBEDTLS_TLS_ECDHE_RSA_WITH_AES_128_CBC_SHA\0A *      MBEDTLS_TLS_ECDHE_RSA_WITH_CAMELLIA_128_GCM_SHA256\0A *      MBEDTLS_TLS_ECDHE_RSA_WITH_CAMELLIA_128_CBC_SHA256\0A */\0A#define MBEDTLS_KEY_EXCHANGE_ECDHE_RSA_ENABLED\0A\0A/**\0A * \5Cdef MBEDTLS_KEY_EXCHANGE_ECDHE_ECDSA_ENABLED\0A *\0A * Enable the ECDHE-ECDSA based ciphersuite modes in SSL / TLS.\0A *\0A * Requires: MBEDTLS_ECDH_C or (MBEDTLS_USE_PSA_CRYPTO and PSA_WANT_ALG_ECDH)\0A *           MBEDTLS_ECDSA_C or (MBEDTLS_USE_PSA_CRYPTO and PSA_WANT_ALG_ECDSA)\0A *           MBEDTLS_X509_CRT_PARSE_C\0A *\0A * This enables the following ciphersuites (if other requisites are\0A * enabled as well):\0A *      MBEDTLS_TLS_ECDHE_ECDSA_WITH_AES_256_GCM_SHA384\0A *      MBEDTLS_TLS_ECDHE_ECDSA_WITH_AES_256_CBC_SHA384\0A *      MBEDTLS_TLS_ECDHE_ECDSA_WITH_AES_256_CBC_SHA\0A *      MBEDTLS_TLS_ECDHE_ECDSA_WITH_CAMELLIA_256_GCM_SHA384\0A *      MBEDTLS_TLS_ECDHE_ECDSA_WITH_CAMELLIA_256_CBC_SHA384\0A *      MBEDTLS_TLS_ECDHE_ECDSA_WITH_AES_128_GCM_SHA256\0A *      MBEDTLS_TLS_ECDHE_ECDSA_WITH_AES_128_CBC_SHA256\0A *      MBEDTLS_TLS_ECDHE_ECDSA_WITH_AES_128_CBC_SHA\0A *      MBEDTLS_TLS_ECDHE_ECDSA_WITH_CAMELLIA_128_GCM_SHA256\0A *      MBEDTLS_TLS_ECDHE_ECDSA_WITH_CAMELLIA_128_CBC_SHA256\0A */\0A#define MBEDTLS_KEY_EXCHANGE_ECDHE_ECDSA_ENABLED\0A\0A/**\0A * \5Cdef MBEDTLS_KEY_EXCHANGE_ECDH_ECDSA_ENABLED\0A *\0A * Enable the ECDH-ECDSA based ciphersuite modes in SSL / TLS.\0A *\0A * Requires: MBEDTLS_ECDH_C or (MBEDTLS_USE_PSA_CRYPTO and PSA_WANT_ALG_ECDH)\0A *           MBEDTLS_ECDSA_C or (MBEDTLS_USE_PSA_CRYPTO and PSA_WANT_ALG_ECDSA)\0A *           MBEDTLS_X509_CRT_PARSE_C\0A *\0A * This enables the following ciphersuites (if other requisites are\0A * enabled as well):\0A *      MBEDTLS_TLS_ECDH_ECDSA_WITH_AES_128_CBC_SHA\0A *      MBEDTLS_TLS_ECDH_ECDSA_WITH_AES_256_CBC_SHA\0A *      MBEDTLS_TLS_ECDH_ECDSA_WITH_AES_128_CBC_SHA256\0A *      MBEDTLS_TLS_ECDH_ECDSA_WITH_AES_256_CBC_SHA384\0A *      MBEDTLS_TLS_ECDH_ECDSA_WITH_AES_128_GCM_SHA256\0A *      MBEDTLS_TLS_ECDH_ECDSA_WITH_AES_256_GCM_SHA384\0A *      MBEDTLS_TLS_ECDH_ECDSA_WITH_CAMELLIA_128_CBC_SHA256\0A *      MBEDTLS_TLS_ECDH_ECDSA_WITH_CAMELLIA_256_CBC_SHA384\0A *      MBEDTLS_TLS_ECDH_ECDSA_WITH_CAMELLIA_128_GCM_SHA256\0A *      MBEDTLS_TLS_ECDH_ECDSA_WITH_CAMELLIA_256_GCM_SHA384\0A */\0A#define MBEDTLS_KEY_EXCHANGE_ECDH_ECDSA_ENABLED\0A\0A/**\0A * \5Cdef MBEDTLS_KEY_EXCHANGE_ECDH_RSA_ENABLED\0A *\0A * Enable the ECDH-RSA based ciphersuite modes in SSL / TLS.\0A *\0A * Requires: MBEDTLS_ECDH_C or (MBEDTLS_USE_PSA_CRYPTO and PSA_WANT_ALG_ECDH)\0A *           MBEDTLS_RSA_C\0A *           MBEDTLS_X509_CRT_PARSE_C\0A *\0A * This enables the following ciphersuites (if other requisites are\0A * enabled as well):\0A *      MBEDTLS_TLS_ECDH_RSA_WITH_AES_128_CBC_SHA\0A *      MBEDTLS_TLS_ECDH_RSA_WITH_AES_256_CBC_SHA\0A *      MBEDTLS_TLS_ECDH_RSA_WITH_AES_128_CBC_SHA256\0A *      MBEDTLS_TLS_ECDH_RSA_WITH_AES_256_CBC_SHA384\0A *      MBEDTLS_TLS_ECDH_RSA_WITH_AES_128_GCM_SHA256\0A *      MBEDTLS_TLS_ECDH_RSA_WITH_AES_256_GCM_SHA384\0A *      MBEDTLS_TLS_ECDH_RSA_WITH_CAMELLIA_128_CBC_SHA256\0A *      MBEDTLS_TLS_ECDH_RSA_WITH_CAMELLIA_256_CBC_SHA384\0A *      MBEDTLS_TLS_ECDH_RSA_WITH_CAMELLIA_128_GCM_SHA256\0A *      MBEDTLS_TLS_ECDH_RSA_WITH_CAMELLIA_256_GCM_SHA384\0A */\0A#define MBEDTLS_KEY_EXCHANGE_ECDH_RSA_ENABLED\0A\0A/**\0A * \5Cdef MBEDTLS_KEY_EXCHANGE_ECJPAKE_ENABLED\0A *\0A * Enable the ECJPAKE based ciphersuite modes in SSL / TLS.\0A *\0A * \5Cwarning This is currently experimental. EC J-PAKE support is based on the\0A * Thread v1.0.0 specification; incompatible changes to the specification\0A * might still happen. For this reason, this is disabled by default.\0A *\0A * Requires: MBEDTLS_ECJPAKE_C or (MBEDTLS_USE_PSA_CRYPTO and PSA_WANT_ALG_JPAKE)\0A *           SHA-256 (via MBEDTLS_SHA256_C or a PSA driver)\0A *           MBEDTLS_ECP_DP_SECP256R1_ENABLED\0A *\0A * \5Cwarning If SHA-256 is provided only by a PSA driver, you must call\0A * psa_crypto_init() before the first handshake (even if\0A * MBEDTLS_USE_PSA_CRYPTO is disabled).\0A *\0A * This enables the following ciphersuites (if other requisites are\0A * enabled as well):\0A *      MBEDTLS_TLS_ECJPAKE_WITH_AES_128_CCM_8\0A */\0A//#define MBEDTLS_KEY_EXCHANGE_ECJPAKE_ENABLED\0A\0A/**\0A * \5Cdef MBEDTLS_PK_PARSE_EC_EXTENDED\0A *\0A * Enhance support for reading EC keys using variants of SEC1 not allowed by\0A * RFC 5915 and RFC 5480.\0A *\0A * Currently this means parsing the SpecifiedECDomain choice of EC\0A * parameters (only known groups are supported, not arbitrary domains, to\0A * avoid validation issues).\0A *\0A * Disable if you only need to support RFC 5915 + 5480 key formats.\0A */\0A#define MBEDTLS_PK_PARSE_EC_EXTENDED\0A\0A/**\0A * \5Cdef MBEDTLS_PK_PARSE_EC_COMPRESSED\0A *\0A * Enable the support for parsing public keys of type Short Weierstrass\0A * (MBEDTLS_ECP_DP_SECP_XXX and MBEDTLS_ECP_DP_BP_XXX) which are using the\0A * compressed point format. This parsing is done through ECP module's functions.\0A *\0A * \5Cnote As explained in the description of MBEDTLS_ECP_PF_COMPRESSED (in ecp.h)\0A *       the only unsupported curves are MBEDTLS_ECP_DP_SECP224R1 and\0A *       MBEDTLS_ECP_DP_SECP224K1.\0A */\0A#define MBEDTLS_PK_PARSE_EC_COMPRESSED\0A\0A/**\0A * \5Cdef MBEDTLS_ERROR_STRERROR_DUMMY\0A *\0A * Enable a dummy error function to make use of mbedtls_strerror() in\0A * third party libraries easier when MBEDTLS_ERROR_C is disabled\0A * (no effect when MBEDTLS_ERROR_C is enabled).\0A *\0A * You can safely disable this if MBEDTLS_ERROR_C is enabled, or if you're\0A * not using mbedtls_strerror() or error_strerror() in your application.\0A *\0A * Disable if you run into name conflicts and want to really remove the\0A * mbedtls_strerror()\0A */\0A#define MBEDTLS_ERROR_STRERROR_DUMMY\0A\0A/**\0A * \5Cdef MBEDTLS_GENPRIME\0A *\0A * Enable the prime-number generation code.\0A *\0A * Requires: MBEDTLS_BIGNUM_C\0A */\0A#define MBEDTLS_GENPRIME\0A\0A/**\0A * \5Cdef MBEDTLS_FS_IO\0A *\0A * Enable functions that use the filesystem.\0A */\0A#define MBEDTLS_FS_IO\0A\0A/**\0A * \5Cdef MBEDTLS_NO_DEFAULT_ENTROPY_SOURCES\0A *\0A * Do not add default entropy sources in mbedtls_entropy_init().\0A *\0A * This is useful to have more control over the added entropy sources in an\0A * application.\0A *\0A * Uncomment this macro to prevent loading of default entropy functions.\0A */\0A//#define MBEDTLS_NO_DEFAULT_ENTROPY_SOURCES\0A\0A/**\0A * \5Cdef MBEDTLS_NO_PLATFORM_ENTROPY\0A *\0A * Do not use built-in platform entropy functions.\0A * This is useful if your platform does not support\0A * standards like the /dev/urandom or Windows CryptoAPI.\0A *\0A * Uncomment this macro to disable the built-in platform entropy functions.\0A */\0A//#define MBEDTLS_NO_PLATFORM_ENTROPY\0A\0A/**\0A * \5Cdef MBEDTLS_ENTROPY_FORCE_SHA256\0A *\0A * Force the entropy accumulator to use a SHA-256 accumulator instead of the\0A * default SHA-512 based one (if both are available).\0A *\0A * Requires: MBEDTLS_SHA256_C\0A *\0A * On 32-bit systems SHA-256 can be much faster than SHA-512. Use this option\0A * if you have performance concerns.\0A *\0A * This option is only useful if both MBEDTLS_SHA256_C and\0A * MBEDTLS_SHA512_C are defined. Otherwise the available hash module is used.\0A */\0A//#define MBEDTLS_ENTROPY_FORCE_SHA256\0A\0A/**\0A * \5Cdef MBEDTLS_ENTROPY_NV_SEED\0A *\0A * Enable the non-volatile (NV) seed file-based entropy source.\0A * (Also enables the NV seed read/write functions in the platform layer)\0A *\0A * This is crucial (if not required) on systems that do not have a\0A * cryptographic entropy source (in hardware or kernel) available.\0A *\0A * Requires: MBEDTLS_ENTROPY_C, MBEDTLS_PLATFORM_C\0A *\0A * \5Cnote The read/write functions that are used by the entropy source are\0A *       determined in the platform layer, and can be modified at runtime and/or\0A *       compile-time depending on the flags (MBEDTLS_PLATFORM_NV_SEED_*) used.\0A *\0A * \5Cnote If you use the default implementation functions that read a seedfile\0A *       with regular fopen(), please make sure you make a seedfile with the\0A *       proper name (defined in MBEDTLS_PLATFORM_STD_NV_SEED_FILE) and at\0A *       least MBEDTLS_ENTROPY_BLOCK_SIZE bytes in size that can be read from\0A *       and written to or you will get an entropy source error! The default\0A *       implementation will only use the first MBEDTLS_ENTROPY_BLOCK_SIZE\0A *       bytes from the file.\0A *\0A * \5Cnote The entropy collector will write to the seed file before entropy is\0A *       given to an external source, to update it.\0A */\0A//#define MBEDTLS_ENTROPY_NV_SEED\0A\0A/* MBEDTLS_PSA_CRYPTO_KEY_ID_ENCODES_OWNER\0A *\0A * Enable key identifiers that encode a key owner identifier.\0A *\0A * The owner of a key is identified by a value of type ::mbedtls_key_owner_id_t\0A * which is currently hard-coded to be int32_t.\0A *\0A * Note that this option is meant for internal use only and may be removed\0A * without notice.\0A */\0A//#define MBEDTLS_PSA_CRYPTO_KEY_ID_ENCODES_OWNER\0A\0A/**\0A * \5Cdef MBEDTLS_MEMORY_DEBUG\0A *\0A * Enable debugging of buffer allocator memory issues. Automatically prints\0A * (to stderr) all (fatal) messages on memory allocation issues. Enables\0A * function for 'debug output' of allocated memory.\0A *\0A * Requires: MBEDTLS_MEMORY_BUFFER_ALLOC_C\0A *\0A * Uncomment this macro to let the buffer allocator print out error messages.\0A */\0A//#define MBEDTLS_MEMORY_DEBUG\0A\0A/**\0A * \5Cdef MBEDTLS_MEMORY_BACKTRACE\0A *\0A * Include backtrace information with each allocated block.\0A *\0A * Requires: MBEDTLS_MEMORY_BUFFER_ALLOC_C\0A *           GLIBC-compatible backtrace() and backtrace_symbols() support\0A *\0A * Uncomment this macro to include backtrace information\0A */\0A//#define MBEDTLS_MEMORY_BACKTRACE\0A\0A/**\0A * \5Cdef MBEDTLS_PK_RSA_ALT_SUPPORT\0A *\0A * Support external private RSA keys (eg from a HSM) in the PK layer.\0A *\0A * Comment this macro to disable support for external private RSA keys.\0A */\0A#define MBEDTLS_PK_RSA_ALT_SUPPORT\0A\0A/**\0A * \5Cdef MBEDTLS_PKCS1_V15\0A *\0A * Enable support for PKCS#1 v1.5 encoding.\0A *\0A * Requires: MBEDTLS_RSA_C\0A *\0A * This enables support for PKCS#1 v1.5 operations.\0A */\0A#define MBEDTLS_PKCS1_V15\0A\0A/**\0A * \5Cdef MBEDTLS_PKCS1_V21\0A *\0A * Enable support for PKCS#1 v2.1 encoding.\0A *\0A * Requires: MBEDTLS_RSA_C\0A *\0A * \5Cwarning If using a hash that is only provided by PSA drivers, you must\0A * call psa_crypto_init() before doing any PKCS#1 v2.1 operation.\0A *\0A * This enables support for RSAES-OAEP and RSASSA-PSS operations.\0A */\0A#define MBEDTLS_PKCS1_V21\0A\0A/** \5Cdef MBEDTLS_PSA_CRYPTO_BUILTIN_KEYS\0A *\0A * Enable support for platform built-in keys. If you enable this feature,\0A * you must implement the function mbedtls_psa_platform_get_builtin_key().\0A * See the documentation of that function for more information.\0A *\0A * Built-in keys are typically derived from a hardware unique key or\0A * stored in a secure element.\0A *\0A * Requires: MBEDTLS_PSA_CRYPTO_C.\0A *\0A * \5Cwarning This interface is experimental and may change or be removed\0A * without notice.\0A */\0A//#define MBEDTLS_PSA_CRYPTO_BUILTIN_KEYS\0A\0A/** \5Cdef MBEDTLS_PSA_CRYPTO_CLIENT\0A *\0A * Enable support for PSA crypto client.\0A *\0A * \5Cnote This option allows to include the code necessary for a PSA\0A *       crypto client when the PSA crypto implementation is not included in\0A *       the library (MBEDTLS_PSA_CRYPTO_C disabled). The code included is the\0A *       code to set and get PSA key attributes.\0A *       The development of PSA drivers partially relying on the library to\0A *       fulfill the hardware gaps is another possible usage of this option.\0A *\0A * \5Cwarning This interface is experimental and may change or be removed\0A * without notice.\0A */\0A//#define MBEDTLS_PSA_CRYPTO_CLIENT\0A\0A/** \5Cdef MBEDTLS_PSA_CRYPTO_EXTERNAL_RNG\0A *\0A * Make the PSA Crypto module use an external random generator provided\0A * by a driver, instead of Mbed TLS's entropy and DRBG modules.\0A *\0A * \5Cnote This random generator must deliver random numbers with cryptographic\0A *       quality and high performance. It must supply unpredictable numbers\0A *       with a uniform distribution. The implementation of this function\0A *       is responsible for ensuring that the random generator is seeded\0A *       with sufficient entropy. If you have a hardware TRNG which is slow\0A *       or delivers non-uniform output, declare it as an entropy source\0A *       with mbedtls_entropy_add_source() instead of enabling this option.\0A *\0A * If you enable this option, you must configure the type\0A * ::mbedtls_psa_external_random_context_t in psa/crypto_platform.h\0A * and define a function called mbedtls_psa_external_get_random()\0A * with the following prototype:\0A * ```\0A * psa_status_t mbedtls_psa_external_get_random(\0A *     mbedtls_psa_external_random_context_t *context,\0A *     uint8_t *output, size_t output_size, size_t *output_length);\0A * );\0A * ```\0A * The \5Cc context value is initialized to 0 before the first call.\0A * The function must fill the \5Cc output buffer with \5Cc output_size bytes\0A * of random data and set \5Cc *output_length to \5Cc output_size.\0A *\0A * Requires: MBEDTLS_PSA_CRYPTO_C\0A *\0A * \5Cwarning If you enable this option, code that uses the PSA cryptography\0A *          interface will not use any of the entropy sources set up for\0A *          the entropy module, nor the NV seed that MBEDTLS_ENTROPY_NV_SEED\0A *          enables.\0A *\0A * \5Cnote This option is experimental and may be removed without notice.\0A */\0A//#define MBEDTLS_PSA_CRYPTO_EXTERNAL_RNG\0A\0A/**\0A * \5Cdef MBEDTLS_PSA_CRYPTO_SPM\0A *\0A * When MBEDTLS_PSA_CRYPTO_SPM is defined, the code is built for SPM (Secure\0A * Partition Manager) integration which separates the code into two parts: a\0A * NSPE (Non-Secure Process Environment) and an SPE (Secure Process\0A * Environment).\0A *\0A * If you enable this option, your build environment must include a header\0A * file `\22crypto_spe.h\22` (either in the `psa` subdirectory of the Mbed TLS\0A * header files, or in another directory on the compiler's include search\0A * path). Alternatively, your platform may customize the header\0A * `psa/crypto_platform.h`, in which case it can skip or replace the\0A * inclusion of `\22crypto_spe.h\22`.\0A *\0A * Module:  library/psa_crypto.c\0A * Requires: MBEDTLS_PSA_CRYPTO_C\0A *\0A */\0A//#define MBEDTLS_PSA_CRYPTO_SPM\0A\0A/**\0A * \5Cdef MBEDTLS_PSA_KEY_STORE_DYNAMIC\0A *\0A * Dynamically resize the PSA key store to accommodate any number of\0A * volatile keys (until the heap memory is exhausted).\0A *\0A * If this option is disabled, the key store has a fixed size\0A * #MBEDTLS_PSA_KEY_SLOT_COUNT for volatile keys and loaded persistent keys\0A * together.\0A *\0A * This option has no effect when #MBEDTLS_PSA_CRYPTO_C is disabled.\0A *\0A * Module:  library/psa_crypto.c\0A * Requires: MBEDTLS_PSA_CRYPTO_C\0A */\0A#define MBEDTLS_PSA_KEY_STORE_DYNAMIC\0A\0A/**\0A * Uncomment to enable p256-m. This is an alternative implementation of\0A * key generation, ECDH and (randomized) ECDSA on the curve SECP256R1.\0A * Compared to the default implementation:\0A *\0A * - p256-m has a much smaller code size and RAM footprint.\0A * - p256-m is only available via the PSA API. This includes the pk module\0A *   when #MBEDTLS_USE_PSA_CRYPTO is enabled.\0A * - p256-m does not support deterministic ECDSA, EC-JPAKE, custom protocols\0A *   over the core arithmetic, or deterministic derivation of keys.\0A *\0A * We recommend enabling this option if your application uses the PSA API\0A * and the only elliptic curve support it needs is ECDH and ECDSA over\0A * SECP256R1.\0A *\0A * If you enable this option, you do not need to enable any ECC-related\0A * MBEDTLS_xxx option. You do need to separately request support for the\0A * cryptographic mechanisms through the PSA API:\0A * - #MBEDTLS_PSA_CRYPTO_C and #MBEDTLS_PSA_CRYPTO_CONFIG for PSA-based\0A *   configuration;\0A * - #MBEDTLS_USE_PSA_CRYPTO if you want to use p256-m from PK, X.509 or TLS;\0A * - #PSA_WANT_ECC_SECP_R1_256;\0A * - #PSA_WANT_ALG_ECDH and/or #PSA_WANT_ALG_ECDSA as needed;\0A * - #PSA_WANT_KEY_TYPE_ECC_PUBLIC_KEY, #PSA_WANT_KEY_TYPE_ECC_KEY_PAIR_BASIC,\0A *   #PSA_WANT_KEY_TYPE_ECC_KEY_PAIR_IMPORT,\0A *   #PSA_WANT_KEY_TYPE_ECC_KEY_PAIR_EXPORT and/or\0A *   #PSA_WANT_KEY_TYPE_ECC_KEY_PAIR_GENERATE as needed.\0A *\0A * \5Cnote To benefit from the smaller code size of p256-m, make sure that you\0A *       do not enable any ECC-related option not supported by p256-m: this\0A *       would cause the built-in ECC implementation to be built as well, in\0A *       order to provide the required option.\0A *       Make sure #PSA_WANT_ALG_DETERMINISTIC_ECDSA, #PSA_WANT_ALG_JPAKE and\0A *       #PSA_WANT_KEY_TYPE_ECC_KEY_PAIR_DERIVE, and curves other than\0A *       SECP256R1 are disabled as they are not supported by this driver.\0A *       Also, avoid defining #MBEDTLS_PK_PARSE_EC_COMPRESSED or\0A *       #MBEDTLS_PK_PARSE_EC_EXTENDED as those currently require a subset of\0A *       the built-in ECC implementation, see docs/driver-only-builds.md.\0A */\0A//#define MBEDTLS_PSA_P256M_DRIVER_ENABLED\0A\0A/**\0A * \5Cdef MBEDTLS_PSA_INJECT_ENTROPY\0A *\0A * Enable support for entropy injection at first boot. This feature is\0A * required on systems that do not have a built-in entropy source (TRNG).\0A * This feature is currently not supported on systems that have a built-in\0A * entropy source.\0A *\0A * Requires: MBEDTLS_PSA_CRYPTO_STORAGE_C, MBEDTLS_ENTROPY_NV_SEED\0A *\0A */\0A//#define MBEDTLS_PSA_INJECT_ENTROPY\0A\0A/**\0A * \5Cdef MBEDTLS_PSA_ASSUME_EXCLUSIVE_BUFFERS\0A *\0A * Assume all buffers passed to PSA functions are owned exclusively by the\0A * PSA function and are not stored in shared memory.\0A *\0A * This option may be enabled if all buffers passed to any PSA function reside\0A * in memory that is accessible only to the PSA function during its execution.\0A *\0A * This option MUST be disabled whenever buffer arguments are in memory shared\0A * with an untrusted party, for example where arguments to PSA calls are passed\0A * across a trust boundary.\0A *\0A * \5Cnote Enabling this option reduces memory usage and code size.\0A *\0A * \5Cnote Enabling this option causes overlap of input and output buffers\0A *       not to be supported by PSA functions.\0A */\0A//#define MBEDTLS_PSA_ASSUME_EXCLUSIVE_BUFFERS\0A\0A/**\0A * \5Cdef MBEDTLS_RSA_NO_CRT\0A *\0A * Do not use the Chinese Remainder Theorem\0A * for the RSA private operation.\0A *\0A * Uncomment this macro to disable the use of CRT in RSA.\0A *\0A */\0A//#define MBEDTLS_RSA_NO_CRT\0A\0A/**\0A * \5Cdef MBEDTLS_SELF_TEST\0A *\0A * Enable the checkup functions (*_self_test).\0A */\0A#define MBEDTLS_SELF_TEST\0A\0A/**\0A * \5Cdef MBEDTLS_SHA256_SMALLER\0A *\0A * Enable an implementation of SHA-256 that has lower ROM footprint but also\0A * lower performance.\0A *\0A * The default implementation is meant to be a reasonable compromise between\0A * performance and size. This version optimizes more aggressively for size at\0A * the expense of performance. Eg on Cortex-M4 it reduces the size of\0A * mbedtls_sha256_process() from ~2KB to ~0.5KB for a performance hit of about\0A * 30%.\0A *\0A * Uncomment to enable the smaller implementation of SHA256.\0A */\0A//#define MBEDTLS_SHA256_SMALLER\0A\0A/**\0A * \5Cdef MBEDTLS_SHA512_SMALLER\0A *\0A * Enable an implementation of SHA-512 that has lower ROM footprint but also\0A * lower performance.\0A *\0A * Uncomment to enable the smaller implementation of SHA512.\0A */\0A//#define MBEDTLS_SHA512_SMALLER\0A\0A/**\0A * \5Cdef MBEDTLS_SSL_ALL_ALERT_MESSAGES\0A *\0A * Enable sending of alert messages in case of encountered errors as per RFC.\0A * If you choose not to send the alert messages, Mbed TLS can still communicate\0A * with other servers, only debugging of failures is harder.\0A *\0A * The advantage of not sending alert messages, is that no information is given\0A * about reasons for failures thus preventing adversaries of gaining intel.\0A *\0A * Enable sending of all alert messages\0A */\0A#define MBEDTLS_SSL_ALL_ALERT_MESSAGES\0A\0A/**\0A * \5Cdef MBEDTLS_SSL_DTLS_CONNECTION_ID\0A *\0A * Enable support for the DTLS Connection ID (CID) extension,\0A * which allows to identify DTLS connections across changes\0A * in the underlying transport. The CID functionality is described\0A * in RFC 9146.\0A *\0A * Setting this option enables the SSL APIs `mbedtls_ssl_set_cid()`,\0A * mbedtls_ssl_get_own_cid()`, `mbedtls_ssl_get_peer_cid()` and\0A * `mbedtls_ssl_conf_cid()`. See the corresponding documentation for\0A * more information.\0A *\0A * The maximum lengths of outgoing and incoming CIDs can be configured\0A * through the options\0A * - MBEDTLS_SSL_CID_OUT_LEN_MAX\0A * - MBEDTLS_SSL_CID_IN_LEN_MAX.\0A *\0A * Requires: MBEDTLS_SSL_PROTO_DTLS\0A *\0A * Uncomment to enable the Connection ID extension.\0A */\0A#define MBEDTLS_SSL_DTLS_CONNECTION_ID\0A\0A\0A/**\0A * \5Cdef MBEDTLS_SSL_DTLS_CONNECTION_ID_COMPAT\0A *\0A * Defines whether RFC 9146 (default) or the legacy version\0A * (version draft-ietf-tls-dtls-connection-id-05,\0A * https://tools.ietf.org/html/draft-ietf-tls-dtls-connection-id-05)\0A * is used.\0A *\0A * Set the value to 0 for the standard version, and\0A * 1 for the legacy draft version.\0A *\0A * \5Cdeprecated Support for the legacy version of the DTLS\0A *             Connection ID feature is deprecated. Please\0A *             switch to the standardized version defined\0A *             in RFC 9146 enabled by utilizing\0A *             MBEDTLS_SSL_DTLS_CONNECTION_ID without use\0A *             of MBEDTLS_SSL_DTLS_CONNECTION_ID_COMPAT.\0A *\0A * Requires: MBEDTLS_SSL_DTLS_CONNECTION_ID\0A */\0A#define MBEDTLS_SSL_DTLS_CONNECTION_ID_COMPAT 0\0A\0A/**\0A * \5Cdef MBEDTLS_SSL_ASYNC_PRIVATE\0A *\0A * Enable asynchronous external private key operations in SSL. This allows\0A * you to configure an SSL connection to call an external cryptographic\0A * module to perform private key operations instead of performing the\0A * operation inside the library.\0A *\0A * Requires: MBEDTLS_X509_CRT_PARSE_C\0A */\0A//#define MBEDTLS_SSL_ASYNC_PRIVATE\0A\0A/** \5Cdef MBEDTLS_SSL_CLI_ALLOW_WEAK_CERTIFICATE_VERIFICATION_WITHOUT_HOSTNAME\0A *\0A * In TLS clients, when a client authenticates a server through its\0A * certificate, the client normally checks three things:\0A * - the certificate chain must be valid;\0A * - the chain must start from a trusted CA;\0A * - the certificate must cover the server name that is expected by the client.\0A *\0A * Omitting any of these checks is generally insecure, and can allow a\0A * malicious server to impersonate a legitimate server.\0A *\0A * The third check may be safely skipped in some unusual scenarios,\0A * such as networks where eavesdropping is a risk but not active attacks,\0A * or a private PKI where the client equally trusts all servers that are\0A * accredited by the root CA.\0A *\0A * You should call mbedtls_ssl_set_hostname() with the expected server name\0A * before starting a TLS handshake on a client (unless the client is\0A * set up to only use PSK-based authentication, which does not rely on the\0A * host name). This configuration option controls what happens if a TLS client\0A * is configured with the authentication mode #MBEDTLS_SSL_VERIFY_REQUIRED\0A * (default), certificate authentication is enabled and the client does not\0A * call mbedtls_ssl_set_hostname():\0A *\0A * - If this option is unset (default), the connection attempt is aborted\0A *   with the error #MBEDTLS_ERR_SSL_CERTIFICATE_VERIFICATION_WITHOUT_HOSTNAME.\0A * - If this option is set, the TLS library does not check the server name\0A *   that the certificate is valid for. This is the historical behavior\0A *   of Mbed TLS, but may be insecure as explained above.\0A *\0A * Enable this option for strict backward compatibility if you have\0A * determined that it is secure in the scenario where you are using\0A * Mbed TLS.\0A *\0A * \5Cdeprecated This option exists only for backward compatibility and will\0A *             be removed in the next major version of Mbed TLS.\0A *\0A */\0A//#define MBEDTLS_SSL_CLI_ALLOW_WEAK_CERTIFICATE_VERIFICATION_WITHOUT_HOSTNAME\0A\0A/**\0A * \5Cdef MBEDTLS_SSL_CONTEXT_SERIALIZATION\0A *\0A * Enable serialization of the TLS context structures, through use of the\0A * functions mbedtls_ssl_context_save() and mbedtls_ssl_context_load().\0A *\0A * This pair of functions allows one side of a connection to serialize the\0A * context associated with the connection, then free or re-use that context\0A * while the serialized state is persisted elsewhere, and finally deserialize\0A * that state to a live context for resuming read/write operations on the\0A * connection. From a protocol perspective, the state of the connection is\0A * unaffected, in particular this is entirely transparent to the peer.\0A *\0A * Note: this is distinct from TLS session resumption, which is part of the\0A * protocol and fully visible by the peer. TLS session resumption enables\0A * establishing new connections associated to a saved session with shorter,\0A * lighter handshakes, while context serialization is a local optimization in\0A * handling a single, potentially long-lived connection.\0A *\0A * Enabling these APIs makes some SSL structures larger, as 64 extra bytes are\0A * saved after the handshake to allow for more efficient serialization, so if\0A * you don't need this feature you'll save RAM by disabling it.\0A *\0A * Requires: MBEDTLS_GCM_C or MBEDTLS_CCM_C or MBEDTLS_CHACHAPOLY_C\0A *\0A * Comment to disable the context serialization APIs.\0A */\0A#define MBEDTLS_SSL_CONTEXT_SERIALIZATION\0A\0A/**\0A * \5Cdef MBEDTLS_SSL_DEBUG_ALL\0A *\0A * Enable the debug messages in SSL module for all issues.\0A * Debug messages have been disabled in some places to prevent timing\0A * attacks due to (unbalanced) debugging function calls.\0A *\0A * If you need all error reporting you should enable this during debugging,\0A * but remove this for production servers that should log as well.\0A *\0A * Uncomment this macro to report all debug messages on errors introducing\0A * a timing side-channel.\0A *\0A */\0A//#define MBEDTLS_SSL_DEBUG_ALL\0A\0A/** \5Cdef MBEDTLS_SSL_ENCRYPT_THEN_MAC\0A *\0A * Enable support for Encrypt-then-MAC, RFC 7366.\0A *\0A * This allows peers that both support it to use a more robust protection for\0A * ciphersuites using CBC, providing deep resistance against timing attacks\0A * on the padding or underlying cipher.\0A *\0A * This only affects CBC ciphersuites, and is useless if none is defined.\0A *\0A * Requires: MBEDTLS_SSL_PROTO_TLS1_2\0A *\0A * Comment this macro to disable support for Encrypt-then-MAC\0A */\0A#define MBEDTLS_SSL_ENCRYPT_THEN_MAC\0A\0A/** \5Cdef MBEDTLS_SSL_EXTENDED_MASTER_SECRET\0A *\0A * Enable support for RFC 7627: Session Hash and Extended Master Secret\0A * Extension.\0A *\0A * This was introduced as \22the proper fix\22 to the Triple Handshake family of\0A * attacks, but it is recommended to always use it (even if you disable\0A * renegotiation), since it actually fixes a more fundamental issue in the\0A * original SSL/TLS design, and has implications beyond Triple Handshake.\0A *\0A * Requires: MBEDTLS_SSL_PROTO_TLS1_2\0A *\0A * Comment this macro to disable support for Extended Master Secret.\0A */\0A#define MBEDTLS_SSL_EXTENDED_MASTER_SECRET\0A\0A/**\0A * \5Cdef MBEDTLS_SSL_KEEP_PEER_CERTIFICATE\0A *\0A * This option controls the availability of the API mbedtls_ssl_get_peer_cert()\0A * giving access to the peer's certificate after completion of the handshake.\0A *\0A * Unless you need mbedtls_ssl_peer_cert() in your application, it is\0A * recommended to disable this option for reduced RAM usage.\0A *\0A * \5Cnote If this option is disabled, mbedtls_ssl_get_peer_cert() is still\0A *       defined, but always returns \5Cc NULL.\0A *\0A * \5Cnote This option has no influence on the protection against the\0A *       triple handshake attack. Even if it is disabled, Mbed TLS will\0A *       still ensure that certificates do not change during renegotiation,\0A *       for example by keeping a hash of the peer's certificate.\0A *\0A * \5Cnote This option is required if MBEDTLS_SSL_PROTO_TLS1_3 is set.\0A *\0A * Comment this macro to disable storing the peer's certificate\0A * after the handshake.\0A */\0A#define MBEDTLS_SSL_KEEP_PEER_CERTIFICATE\0A\0A/**\0A * \5Cdef MBEDTLS_SSL_RENEGOTIATION\0A *\0A * Enable support for TLS renegotiation.\0A *\0A * The two main uses of renegotiation are (1) refresh keys on long-lived\0A * connections and (2) client authentication after the initial handshake.\0A * If you don't need renegotiation, it's probably better to disable it, since\0A * it has been associated with security issues in the past and is easy to\0A * misuse/misunderstand.\0A *\0A * Requires: MBEDTLS_SSL_PROTO_TLS1_2\0A *\0A * Comment this to disable support for renegotiation.\0A *\0A * \5Cnote   Even if this option is disabled, both client and server are aware\0A *         of the Renegotiation Indication Extension (RFC 5746) used to\0A *         prevent the SSL renegotiation attack (see RFC 5746 Sect. 1).\0A *         (See \5Cc mbedtls_ssl_conf_legacy_renegotiation for the\0A *          configuration of this extension).\0A *\0A */\0A#define MBEDTLS_SSL_RENEGOTIATION\0A\0A/**\0A * \5Cdef MBEDTLS_SSL_MAX_FRAGMENT_LENGTH\0A *\0A * Enable support for RFC 6066 max_fragment_length extension in SSL.\0A *\0A * Comment this macro to disable support for the max_fragment_length extension\0A */\0A#define MBEDTLS_SSL_MAX_FRAGMENT_LENGTH\0A\0A/**\0A * \5Cdef MBEDTLS_SSL_RECORD_SIZE_LIMIT\0A *\0A * Enable support for RFC 8449 record_size_limit extension in SSL (TLS 1.3 only).\0A *\0A * Requires: MBEDTLS_SSL_PROTO_TLS1_3\0A *\0A * Uncomment this macro to enable support for the record_size_limit extension\0A */\0A//#define MBEDTLS_SSL_RECORD_SIZE_LIMIT\0A\0A/**\0A * \5Cdef MBEDTLS_SSL_PROTO_TLS1_2\0A *\0A * Enable support for TLS 1.2 (and DTLS 1.2 if DTLS is enabled).\0A *\0A * Requires: Without MBEDTLS_USE_PSA_CRYPTO: MBEDTLS_MD_C and\0A *              (MBEDTLS_SHA256_C or MBEDTLS_SHA384_C or\0A *               SHA-256 or SHA-512 provided by a PSA driver)\0A *           With MBEDTLS_USE_PSA_CRYPTO:\0A *              PSA_WANT_ALG_SHA_256 or PSA_WANT_ALG_SHA_384\0A *\0A * \5Cwarning If building with MBEDTLS_USE_PSA_CRYPTO, or if the hash(es) used\0A * are only provided by PSA drivers, you must call psa_crypto_init() before\0A * doing any TLS operations.\0A *\0A * Comment this macro to disable support for TLS 1.2 / DTLS 1.2\0A */\0A#define MBEDTLS_SSL_PROTO_TLS1_2\0A\0A/**\0A * \5Cdef MBEDTLS_SSL_PROTO_TLS1_3\0A *\0A * Enable support for TLS 1.3.\0A *\0A * \5Cnote See docs/architecture/tls13-support.md for a description of the TLS\0A *       1.3 support that this option enables.\0A *\0A * Requires: MBEDTLS_SSL_KEEP_PEER_CERTIFICATE\0A * Requires: MBEDTLS_PSA_CRYPTO_C\0A *\0A * \5Cnote TLS 1.3 uses PSA crypto for cryptographic operations that are\0A *       directly performed by TLS 1.3 code. As a consequence, when TLS 1.3\0A *       is enabled, a TLS handshake may call psa_crypto_init(), even\0A *       if it ends up negotiating a different TLS version.\0A *\0A * \5Cnote Cryptographic operations performed indirectly via another module\0A *       (X.509, PK) or by code shared with TLS 1.2 (record protection,\0A *       running handshake hash) only use PSA crypto if\0A *       #MBEDTLS_USE_PSA_CRYPTO is enabled.\0A *\0A * \5Cnote In multithreaded applications, you must also enable\0A *       #MBEDTLS_THREADING_C, even if individual TLS contexts are not\0A *       shared between threads, unless only one thread ever calls\0A *       TLS functions.\0A *\0A * Uncomment this macro to enable the support for TLS 1.3.\0A */\0A#define MBEDTLS_SSL_PROTO_TLS1_3\0A\0A/**\0A * \5Cdef MBEDTLS_SSL_TLS1_3_COMPATIBILITY_MODE\0A *\0A * Enable TLS 1.3 middlebox compatibility mode.\0A *\0A * As specified in Section D.4 of RFC 8446, TLS 1.3 offers a compatibility\0A * mode to make a TLS 1.3 connection more likely to pass through middle boxes\0A * expecting TLS 1.2 traffic.\0A *\0A * Turning on the compatibility mode comes at the cost of a few added bytes\0A * on the wire, but it doesn't affect compatibility with TLS 1.3 implementations\0A * that don't use it. Therefore, unless transmission bandwidth is critical and\0A * you know that middlebox compatibility issues won't occur, it is therefore\0A * recommended to set this option.\0A *\0A * Comment to disable compatibility mode for TLS 1.3. If\0A * MBEDTLS_SSL_PROTO_TLS1_3 is not enabled, this option does not have any\0A * effect on the build.\0A *\0A */\0A#define MBEDTLS_SSL_TLS1_3_COMPATIBILITY_MODE\0A\0A/**\0A * \5Cdef MBEDTLS_SSL_TLS1_3_KEY_EXCHANGE_MODE_PSK_ENABLED\0A *\0A * Enable TLS 1.3 PSK key exchange mode.\0A *\0A * Comment to disable support for the PSK key exchange mode in TLS 1.3. If\0A * MBEDTLS_SSL_PROTO_TLS1_3 is not enabled, this option does not have any\0A * effect on the build.\0A *\0A */\0A#define MBEDTLS_SSL_TLS1_3_KEY_EXCHANGE_MODE_PSK_ENABLED\0A\0A/**\0A * \5Cdef MBEDTLS_SSL_TLS1_3_KEY_EXCHANGE_MODE_EPHEMERAL_ENABLED\0A *\0A * Enable TLS 1.3 ephemeral key exchange mode.\0A *\0A * Requires: PSA_WANT_ALG_ECDH or PSA_WANT_ALG_FFDH\0A *           MBEDTLS_X509_CRT_PARSE_C\0A *           and at least one of:\0A *               MBEDTLS_ECDSA_C or (MBEDTLS_USE_PSA_CRYPTO and PSA_WANT_ALG_ECDSA)\0A *               MBEDTLS_PKCS1_V21\0A *\0A * Comment to disable support for the ephemeral key exchange mode in TLS 1.3.\0A * If MBEDTLS_SSL_PROTO_TLS1_3 is not enabled, this option does not have any\0A * effect on the build.\0A *\0A */\0A#define MBEDTLS_SSL_TLS1_3_KEY_EXCHANGE_MODE_EPHEMERAL_ENABLED\0A\0A/**\0A * \5Cdef MBEDTLS_SSL_TLS1_3_KEY_EXCHANGE_MODE_PSK_EPHEMERAL_ENABLED\0A *\0A * Enable TLS 1.3 PSK ephemeral key exchange mode.\0A *\0A * Requires: PSA_WANT_ALG_ECDH or PSA_WANT_ALG_FFDH\0A *\0A * Comment to disable support for the PSK ephemeral key exchange mode in\0A * TLS 1.3. If MBEDTLS_SSL_PROTO_TLS1_3 is not enabled, this option does not\0A * have any effect on the build.\0A *\0A */\0A#define MBEDTLS_SSL_TLS1_3_KEY_EXCHANGE_MODE_PSK_EPHEMERAL_ENABLED\0A\0A/**\0A * \5Cdef MBEDTLS_SSL_EARLY_DATA\0A *\0A * Enable support for RFC 8446 TLS 1.3 early data.\0A *\0A * Requires: MBEDTLS_SSL_SESSION_TICKETS and either\0A *           MBEDTLS_SSL_TLS1_3_KEY_EXCHANGE_MODE_PSK_ENABLED or\0A *           MBEDTLS_SSL_TLS1_3_KEY_EXCHANGE_MODE_PSK_EPHEMERAL_ENABLED\0A *\0A * Comment this to disable support for early data. If MBEDTLS_SSL_PROTO_TLS1_3\0A * is not enabled, this option does not have any effect on the build.\0A *\0A * \5Cnote The maximum amount of early data can be set with\0A *       MBEDTLS_SSL_MAX_EARLY_DATA_SIZE.\0A *\0A */\0A//#define MBEDTLS_SSL_EARLY_DATA\0A\0A/**\0A * \5Cdef MBEDTLS_SSL_PROTO_DTLS\0A *\0A * Enable support for DTLS (all available versions).\0A *\0A * Enable this and MBEDTLS_SSL_PROTO_TLS1_2 to enable DTLS 1.2.\0A *\0A * Requires: MBEDTLS_SSL_PROTO_TLS1_2\0A *\0A * Comment this macro to disable support for DTLS\0A */\0A#define MBEDTLS_SSL_PROTO_DTLS\0A\0A/**\0A * \5Cdef MBEDTLS_SSL_ALPN\0A *\0A * Enable support for RFC 7301 Application Layer Protocol Negotiation.\0A *\0A * Comment this macro to disable support for ALPN.\0A */\0A#define MBEDTLS_SSL_ALPN\0A\0A/**\0A * \5Cdef MBEDTLS_SSL_DTLS_ANTI_REPLAY\0A *\0A * Enable support for the anti-replay mechanism in DTLS.\0A *\0A * Requires: MBEDTLS_SSL_TLS_C\0A *           MBEDTLS_SSL_PROTO_DTLS\0A *\0A * \5Cwarning Disabling this is often a security risk!\0A * See mbedtls_ssl_conf_dtls_anti_replay() for details.\0A *\0A * Comment this to disable anti-replay in DTLS.\0A */\0A#define MBEDTLS_SSL_DTLS_ANTI_REPLAY\0A\0A/**\0A * \5Cdef MBEDTLS_SSL_DTLS_HELLO_VERIFY\0A *\0A * Enable support for HelloVerifyRequest on DTLS servers.\0A *\0A * This feature is highly recommended to prevent DTLS servers being used as\0A * amplifiers in DoS attacks against other hosts. It should always be enabled\0A * unless you know for sure amplification cannot be a problem in the\0A * environment in which your server operates.\0A *\0A * \5Cwarning Disabling this can be a security risk! (see above)\0A *\0A * Requires: MBEDTLS_SSL_PROTO_DTLS\0A *\0A * Comment this to disable support for HelloVerifyRequest.\0A */\0A#define MBEDTLS_SSL_DTLS_HELLO_VERIFY\0A\0A/**\0A * \5Cdef MBEDTLS_SSL_DTLS_SRTP\0A *\0A * Enable support for negotiation of DTLS-SRTP (RFC 5764)\0A * through the use_srtp extension.\0A *\0A * \5Cnote This feature provides the minimum functionality required\0A * to negotiate the use of DTLS-SRTP and to allow the derivation of\0A * the associated SRTP packet protection key material.\0A * In particular, the SRTP packet protection itself, as well as the\0A * demultiplexing of RTP and DTLS packets at the datagram layer\0A * (see Section 5 of RFC 5764), are not handled by this feature.\0A * Instead, after successful completion of a handshake negotiating\0A * the use of DTLS-SRTP, the extended key exporter API\0A * mbedtls_ssl_conf_export_keys_cb() should be used to implement\0A * the key exporter described in Section 4.2 of RFC 5764 and RFC 5705\0A * (this is implemented in the SSL example programs).\0A * The resulting key should then be passed to an SRTP stack.\0A *\0A * Setting this option enables the runtime API\0A * mbedtls_ssl_conf_dtls_srtp_protection_profiles()\0A * through which the supported DTLS-SRTP protection\0A * profiles can be configured. You must call this API at\0A * runtime if you wish to negotiate the use of DTLS-SRTP.\0A *\0A * Requires: MBEDTLS_SSL_PROTO_DTLS\0A *\0A * Uncomment this to enable support for use_srtp extension.\0A */\0A//#define MBEDTLS_SSL_DTLS_SRTP\0A\0A/**\0A * \5Cdef MBEDTLS_SSL_DTLS_CLIENT_PORT_REUSE\0A *\0A * Enable server-side support for clients that reconnect from the same port.\0A *\0A * Some clients unexpectedly close the connection and try to reconnect using the\0A * same source port. This needs special support from the server to handle the\0A * new connection securely, as described in section 4.2.8 of RFC 6347. This\0A * flag enables that support.\0A *\0A * Requires: MBEDTLS_SSL_DTLS_HELLO_VERIFY\0A *\0A * Comment this to disable support for clients reusing the source port.\0A */\0A#define MBEDTLS_SSL_DTLS_CLIENT_PORT_REUSE\0A\0A/**\0A * \5Cdef MBEDTLS_SSL_SESSION_TICKETS\0A *\0A * Enable support for RFC 5077 session tickets in SSL.\0A * Client-side, provides full support for session tickets (maintenance of a\0A * session store remains the responsibility of the application, though).\0A * Server-side, you also need to provide callbacks for writing and parsing\0A * tickets, including authenticated encryption and key management. Example\0A * callbacks are provided by MBEDTLS_SSL_TICKET_C.\0A *\0A * Comment this macro to disable support for SSL session tickets\0A */\0A#define MBEDTLS_SSL_SESSION_TICKETS\0A\0A/**\0A * \5Cdef MBEDTLS_SSL_SERVER_NAME_INDICATION\0A *\0A * Enable support for RFC 6066 server name indication (SNI) in SSL.\0A *\0A * Requires: MBEDTLS_X509_CRT_PARSE_C\0A *\0A * Comment this macro to disable support for server name indication in SSL\0A */\0A#define MBEDTLS_SSL_SERVER_NAME_INDICATION\0A\0A/**\0A * \5Cdef MBEDTLS_SSL_VARIABLE_BUFFER_LENGTH\0A *\0A * When this option is enabled, the SSL buffer will be resized automatically\0A * based on the negotiated maximum fragment length in each direction.\0A *\0A * Requires: MBEDTLS_SSL_MAX_FRAGMENT_LENGTH\0A */\0A//#define MBEDTLS_SSL_VARIABLE_BUFFER_LENGTH\0A\0A/**\0A * \5Cdef MBEDTLS_TEST_CONSTANT_FLOW_MEMSAN\0A *\0A * Enable testing of the constant-flow nature of some sensitive functions with\0A * clang's MemorySanitizer. This causes some existing tests to also test\0A * this non-functional property of the code under test.\0A *\0A * This setting requires compiling with clang -fsanitize=memory. The test\0A * suites can then be run normally.\0A *\0A * \5Cwarning This macro is only used for extended testing; it is not considered\0A * part of the library's API, so it may change or disappear at any time.\0A *\0A * Uncomment to enable testing of the constant-flow nature of selected code.\0A */\0A//#define MBEDTLS_TEST_CONSTANT_FLOW_MEMSAN\0A\0A/**\0A * \5Cdef MBEDTLS_TEST_CONSTANT_FLOW_VALGRIND\0A *\0A * Enable testing of the constant-flow nature of some sensitive functions with\0A * valgrind's memcheck tool. This causes some existing tests to also test\0A * this non-functional property of the code under test.\0A *\0A * This setting requires valgrind headers for building, and is only useful for\0A * testing if the tests suites are run with valgrind's memcheck. This can be\0A * done for an individual test suite with 'valgrind ./test_suite_xxx', or when\0A * using CMake, this can be done for all test suites with 'make memcheck'.\0A *\0A * \5Cwarning This macro is only used for extended testing; it is not considered\0A * part of the library's API, so it may change or disappear at any time.\0A *\0A * Uncomment to enable testing of the constant-flow nature of selected code.\0A */\0A//#define MBEDTLS_TEST_CONSTANT_FLOW_VALGRIND\0A\0A/**\0A * \5Cdef MBEDTLS_TEST_HOOKS\0A *\0A * Enable features for invasive testing such as introspection functions and\0A * hooks for fault injection. This enables additional unit tests.\0A *\0A * Merely enabling this feature should not change the behavior of the product.\0A * It only adds new code, and new branching points where the default behavior\0A * is the same as when this feature is disabled.\0A * However, this feature increases the attack surface: there is an added\0A * risk of vulnerabilities, and more gadgets that can make exploits easier.\0A * Therefore this feature must never be enabled in production.\0A *\0A * See `docs/architecture/testing/mbed-crypto-invasive-testing.md` for more\0A * information.\0A *\0A * Uncomment to enable invasive tests.\0A */\0A//#define MBEDTLS_TEST_HOOKS\0A\0A/**\0A * \5Cdef MBEDTLS_THREADING_ALT\0A *\0A * Provide your own alternate threading implementation.\0A *\0A * Requires: MBEDTLS_THREADING_C\0A *\0A * Uncomment this to allow your own alternate threading implementation.\0A */\0A//#define MBEDTLS_THREADING_ALT\0A\0A/**\0A * \5Cdef MBEDTLS_THREADING_PTHREAD\0A *\0A * Enable the pthread wrapper layer for the threading layer.\0A *\0A * Requires: MBEDTLS_THREADING_C\0A *\0A * Uncomment this to enable pthread mutexes.\0A */\0A//#define MBEDTLS_THREADING_PTHREAD\0A\0A/**\0A * \5Cdef MBEDTLS_USE_PSA_CRYPTO\0A *\0A * Make the X.509 and TLS libraries use PSA for cryptographic operations as\0A * much as possible, and enable new APIs for using keys handled by PSA Crypto.\0A *\0A * \5Cnote Development of this option is currently in progress, and parts of Mbed\0A * TLS's X.509 and TLS modules are not ported to PSA yet. However, these parts\0A * will still continue to work as usual, so enabling this option should not\0A * break backwards compatibility.\0A *\0A * \5Cwarning If you enable this option, you need to call `psa_crypto_init()`\0A * before calling any function from the SSL/TLS, X.509 or PK modules, except\0A * for the various mbedtls_xxx_init() functions which can be called at any time.\0A *\0A * \5Cwarning In multithreaded applications, you must also enable\0A * #MBEDTLS_THREADING_C, unless only one thread ever calls PSA functions\0A * (`psa_xxx()`), including indirect calls through SSL/TLS, X.509 or PK.\0A *\0A * \5Cnote An important and desirable effect of this option is that it allows\0A * PK, X.509 and TLS to take advantage of PSA drivers. For example, enabling\0A * this option is what allows use of drivers for ECDSA, ECDH and EC J-PAKE in\0A * those modules. However, note that even with this option disabled, some code\0A * in PK, X.509, TLS or the crypto library might still use PSA drivers, if it\0A * can determine it's safe to do so; currently that's the case for hashes.\0A *\0A * \5Cnote See docs/use-psa-crypto.md for a complete description this option.\0A *\0A * Requires: MBEDTLS_PSA_CRYPTO_C.\0A *\0A * Uncomment this to enable internal use of PSA Crypto and new associated APIs.\0A */\0A//#define MBEDTLS_USE_PSA_CRYPTO\0A\0A/**\0A * \5Cdef MBEDTLS_PSA_CRYPTO_CONFIG\0A *\0A * This setting allows support for cryptographic mechanisms through the PSA\0A * API to be configured separately from support through the mbedtls API.\0A *\0A * When this option is disabled, the PSA API exposes the cryptographic\0A * mechanisms that can be implemented on top of the `mbedtls_xxx` API\0A * configured with `MBEDTLS_XXX` symbols.\0A *\0A * When this option is enabled, the PSA API exposes the cryptographic\0A * mechanisms requested by the `PSA_WANT_XXX` symbols defined in\0A * include/psa/crypto_config.h. The corresponding `MBEDTLS_XXX` settings are\0A * automatically enabled if required (i.e. if no PSA driver provides the\0A * mechanism). You may still freely enable additional `MBEDTLS_XXX` symbols\0A * in mbedtls_config.h.\0A *\0A * If the symbol #MBEDTLS_PSA_CRYPTO_CONFIG_FILE is defined, it specifies\0A * an alternative header to include instead of include/psa/crypto_config.h.\0A *\0A * \5Cwarning This option is experimental, in that the set of `PSA_WANT_XXX`\0A *          symbols is not completely finalized yet, and the configuration\0A *          tooling is not ideally adapted to having two separate configuration\0A *          files.\0A *          Future minor releases of Mbed TLS may make minor changes to those\0A *          symbols, but we will endeavor to provide a transition path.\0A *          Nonetheless, this option is considered mature enough to use in\0A *          production, as long as you accept that you may need to make\0A *          minor changes to psa/crypto_config.h when upgrading Mbed TLS.\0A */\0A//#define MBEDTLS_PSA_CRYPTO_CONFIG\0A\0A/**\0A * \5Cdef MBEDTLS_VERSION_FEATURES\0A *\0A * Allow run-time checking of compile-time enabled features. Thus allowing users\0A * to check at run-time if the library is for instance compiled with threading\0A * support via mbedtls_version_check_feature().\0A *\0A * Requires: MBEDTLS_VERSION_C\0A *\0A * Comment this to disable run-time checking and save ROM space\0A */\0A#define MBEDTLS_VERSION_FEATURES\0A\0A/**\0A * \5Cdef MBEDTLS_X509_TRUSTED_CERTIFICATE_CALLBACK\0A *\0A * If set, this enables the X.509 API `mbedtls_x509_crt_verify_with_ca_cb()`\0A * and the SSL API `mbedtls_ssl_conf_ca_cb()` which allow users to configure\0A * the set of trusted certificates through a callback instead of a linked\0A * list.\0A *\0A * This is useful for example in environments where a large number of trusted\0A * certificates is present and storing them in a linked list isn't efficient\0A * enough, or when the set of trusted certificates changes frequently.\0A *\0A * See the documentation of `mbedtls_x509_crt_verify_with_ca_cb()` and\0A * `mbedtls_ssl_conf_ca_cb()` for more information.\0A *\0A * Requires: MBEDTLS_X509_CRT_PARSE_C\0A *\0A * Uncomment to enable trusted certificate callbacks.\0A */\0A//#define MBEDTLS_X509_TRUSTED_CERTIFICATE_CALLBACK\0A\0A/**\0A * \5Cdef MBEDTLS_X509_REMOVE_INFO\0A *\0A * Disable mbedtls_x509_*_info() and related APIs.\0A *\0A * Uncomment to omit mbedtls_x509_*_info(), as well as mbedtls_debug_print_crt()\0A * and other functions/constants only used by these functions, thus reducing\0A * the code footprint by several KB.\0A */\0A//#define MBEDTLS_X509_REMOVE_INFO\0A\0A/**\0A * \5Cdef MBEDTLS_X509_RSASSA_PSS_SUPPORT\0A *\0A * Enable parsing and verification of X.509 certificates, CRLs and CSRS\0A * signed with RSASSA-PSS (aka PKCS#1 v2.1).\0A *\0A * Requires: MBEDTLS_PKCS1_V21\0A *\0A * Comment this macro to disallow using RSASSA-PSS in certificates.\0A */\0A#define MBEDTLS_X509_RSASSA_PSS_SUPPORT\0A/** \5C} name SECTION: Mbed TLS feature support */\0A\0A/**\0A * \5Cname SECTION: Mbed TLS modules\0A *\0A * This section enables or disables entire modules in Mbed TLS\0A * \5C{\0A */\0A\0A/**\0A * \5Cdef MBEDTLS_AESNI_C\0A *\0A * Enable AES-NI support on x86-64 or x86-32.\0A *\0A * \5Cnote AESNI is only supported with certain compilers and target options:\0A * - Visual Studio: supported\0A * - GCC, x86-64, target not explicitly supporting AESNI:\0A *   requires MBEDTLS_HAVE_ASM.\0A * - GCC, x86-32, target not explicitly supporting AESNI:\0A *   not supported.\0A * - GCC, x86-64 or x86-32, target supporting AESNI: supported.\0A *   For this assembly-less implementation, you must currently compile\0A *   `library/aesni.c` and `library/aes.c` with machine options to enable\0A *   SSE2 and AESNI instructions: `gcc -msse2 -maes -mpclmul` or\0A *   `clang -maes -mpclmul`.\0A * - Non-x86 targets: this option is silently ignored.\0A * - Other compilers: this option is silently ignored.\0A *\0A * \5Cnote\0A * Above, \22GCC\22 includes compatible compilers such as Clang.\0A * The limitations on target support are likely to be relaxed in the future.\0A *\0A * Module:  library/aesni.c\0A * Caller:  library/aes.c\0A *\0A * Requires: MBEDTLS_HAVE_ASM (on some platforms, see note)\0A *\0A * This modules adds support for the AES-NI instructions on x86.\0A */\0A#define MBEDTLS_AESNI_C\0A\0A/**\0A * \5Cdef MBEDTLS_AESCE_C\0A *\0A * Enable AES cryptographic extension support on Armv8.\0A *\0A * Module:  library/aesce.c\0A * Caller:  library/aes.c\0A *\0A * Requires: MBEDTLS_AES_C\0A *\0A * \5Cwarning Runtime detection only works on Linux. For non-Linux operating\0A *          system, Armv8-A Cryptographic Extensions must be supported by\0A *          the CPU when this option is enabled.\0A *\0A * \5Cnote    Minimum compiler versions for this feature when targeting aarch64\0A *          are Clang 4.0; armclang 6.6; GCC 6.0; or MSVC 2019 version 16.11.2.\0A *          Minimum compiler versions for this feature when targeting 32-bit\0A *          Arm or Thumb are Clang 11.0; armclang 6.20; or GCC 6.0.\0A *\0A * \5Cnote \5Cc CFLAGS must be set to a minimum of \5Cc -march=armv8-a+crypto for\0A * armclang <= 6.9\0A *\0A * This module adds support for the AES Armv8-A Cryptographic Extensions on Armv8 systems.\0A */\0A#define MBEDTLS_AESCE_C\0A\0A/**\0A * \5Cdef MBEDTLS_AES_C\0A *\0A * Enable the AES block cipher.\0A *\0A * Module:  library/aes.c\0A * Caller:  library/cipher.c\0A *          library/pem.c\0A *          library/ctr_drbg.c\0A *\0A * This module enables the following ciphersuites (if other requisites are\0A * enabled as well):\0A *      MBEDTLS_TLS_ECDH_ECDSA_WITH_AES_128_CBC_SHA\0A *      MBEDTLS_TLS_ECDH_ECDSA_WITH_AES_256_CBC_SHA\0A *      MBEDTLS_TLS_ECDH_RSA_WITH_AES_128_CBC_SHA\0A *      MBEDTLS_TLS_ECDH_RSA_WITH_AES_256_CBC_SHA\0A *      MBEDTLS_TLS_ECDH_ECDSA_WITH_AES_128_CBC_SHA256\0A *      MBEDTLS_TLS_ECDH_ECDSA_WITH_AES_256_CBC_SHA384\0A *      MBEDTLS_TLS_ECDH_RSA_WITH_AES_128_CBC_SHA256\0A *      MBEDTLS_TLS_ECDH_RSA_WITH_AES_256_CBC_SHA384\0A *      MBEDTLS_TLS_ECDH_ECDSA_WITH_AES_128_GCM_SHA256\0A *      MBEDTLS_TLS_ECDH_ECDSA_WITH_AES_256_GCM_SHA384\0A *      MBEDTLS_TLS_ECDH_RSA_WITH_AES_128_GCM_SHA256\0A *      MBEDTLS_TLS_ECDH_RSA_WITH_AES_256_GCM_SHA384\0A *      MBEDTLS_TLS_ECDHE_ECDSA_WITH_AES_256_GCM_SHA384\0A *      MBEDTLS_TLS_ECDHE_RSA_WITH_AES_256_GCM_SHA384\0A *      MBEDTLS_TLS_DHE_RSA_WITH_AES_256_GCM_SHA384\0A *      MBEDTLS_TLS_ECDHE_ECDSA_WITH_AES_256_CBC_SHA384\0A *      MBEDTLS_TLS_ECDHE_RSA_WITH_AES_256_CBC_SHA384\0A *      MBEDTLS_TLS_DHE_RSA_WITH_AES_256_CBC_SHA256\0A *      MBEDTLS_TLS_ECDHE_ECDSA_WITH_AES_256_CBC_SHA\0A *      MBEDTLS_TLS_ECDHE_RSA_WITH_AES_256_CBC_SHA\0A *      MBEDTLS_TLS_DHE_RSA_WITH_AES_256_CBC_SHA\0A *      MBEDTLS_TLS_ECDHE_ECDSA_WITH_AES_128_GCM_SHA256\0A *      MBEDTLS_TLS_ECDHE_RSA_WITH_AES_128_GCM_SHA256\0A *      MBEDTLS_TLS_DHE_RSA_WITH_AES_128_GCM_SHA256\0A *      MBEDTLS_TLS_ECDHE_ECDSA_WITH_AES_128_CBC_SHA256\0A *      MBEDTLS_TLS_ECDHE_RSA_WITH_AES_128_CBC_SHA256\0A *      MBEDTLS_TLS_DHE_RSA_WITH_AES_128_CBC_SHA256\0A *      MBEDTLS_TLS_ECDHE_ECDSA_WITH_AES_128_CBC_SHA\0A *      MBEDTLS_TLS_ECDHE_RSA_WITH_AES_128_CBC_SHA\0A *      MBEDTLS_TLS_DHE_RSA_WITH_AES_128_CBC_SHA\0A *      MBEDTLS_TLS_DHE_PSK_WITH_AES_256_GCM_SHA384\0A *      MBEDTLS_TLS_ECDHE_PSK_WITH_AES_256_CBC_SHA384\0A *      MBEDTLS_TLS_DHE_PSK_WITH_AES_256_CBC_SHA384\0A *      MBEDTLS_TLS_ECDHE_PSK_WITH_AES_256_CBC_SHA\0A *      MBEDTLS_TLS_DHE_PSK_WITH_AES_256_CBC_SHA\0A *      MBEDTLS_TLS_DHE_PSK_WITH_AES_128_GCM_SHA256\0A *      MBEDTLS_TLS_ECDHE_PSK_WITH_AES_128_CBC_SHA256\0A *      MBEDTLS_TLS_DHE_PSK_WITH_AES_128_CBC_SHA256\0A *      MBEDTLS_TLS_ECDHE_PSK_WITH_AES_128_CBC_SHA\0A *      MBEDTLS_TLS_DHE_PSK_WITH_AES_128_CBC_SHA\0A *      MBEDTLS_TLS_RSA_WITH_AES_256_GCM_SHA384\0A *      MBEDTLS_TLS_RSA_WITH_AES_256_CBC_SHA256\0A *      MBEDTLS_TLS_RSA_WITH_AES_256_CBC_SHA\0A *      MBEDTLS_TLS_RSA_WITH_AES_128_GCM_SHA256\0A *      MBEDTLS_TLS_RSA_WITH_AES_128_CBC_SHA256\0A *      MBEDTLS_TLS_RSA_WITH_AES_128_CBC_SHA\0A *      MBEDTLS_TLS_RSA_PSK_WITH_AES_256_GCM_SHA384\0A *      MBEDTLS_TLS_RSA_PSK_WITH_AES_256_CBC_SHA384\0A *      MBEDTLS_TLS_RSA_PSK_WITH_AES_256_CBC_SHA\0A *      MBEDTLS_TLS_RSA_PSK_WITH_AES_128_GCM_SHA256\0A *      MBEDTLS_TLS_RSA_PSK_WITH_AES_128_CBC_SHA256\0A *      MBEDTLS_TLS_RSA_PSK_WITH_AES_128_CBC_SHA\0A *      MBEDTLS_TLS_PSK_WITH_AES_256_GCM_SHA384\0A *      MBEDTLS_TLS_PSK_WITH_AES_256_CBC_SHA384\0A *      MBEDTLS_TLS_PSK_WITH_AES_256_CBC_SHA\0A *      MBEDTLS_TLS_PSK_WITH_AES_128_GCM_SHA256\0A *      MBEDTLS_TLS_PSK_WITH_AES_128_CBC_SHA256\0A *      MBEDTLS_TLS_PSK_WITH_AES_128_CBC_SHA\0A *\0A * PEM_PARSE uses AES for decrypting encrypted keys.\0A */\0A#define MBEDTLS_AES_C\0A\0A/**\0A * \5Cdef MBEDTLS_ASN1_PARSE_C\0A *\0A * Enable the generic ASN1 parser.\0A *\0A * Module:  library/asn1.c\0A * Caller:  library/x509.c\0A *          library/dhm.c\0A *          library/pkcs12.c\0A *          library/pkcs5.c\0A *          library/pkparse.c\0A */\0A#define MBEDTLS_ASN1_PARSE_C\0A\0A/**\0A * \5Cdef MBEDTLS_ASN1_WRITE_C\0A *\0A * Enable the generic ASN1 writer.\0A *\0A * Module:  library/asn1write.c\0A * Caller:  library/ecdsa.c\0A *          library/pkwrite.c\0A *          library/x509_create.c\0A *          library/x509write_crt.c\0A *          library/x509write_csr.c\0A */\0A#define MBEDTLS_ASN1_WRITE_C\0A\0A/**\0A * \5Cdef MBEDTLS_BASE64_C\0A *\0A * Enable the Base64 module.\0A *\0A * Module:  library/base64.c\0A * Caller:  library/pem.c\0A *\0A * This module is required for PEM support (required by X.509).\0A */\0A#define MBEDTLS_BASE64_C\0A\0A/**\0A * \5Cdef MBEDTLS_BLOCK_CIPHER_NO_DECRYPT\0A *\0A * Remove decryption operation for AES, ARIA and Camellia block cipher.\0A *\0A * \5Cnote  This feature is incompatible with insecure block cipher,\0A *        MBEDTLS_DES_C, and cipher modes which always require decryption\0A *        operation, MBEDTLS_CIPHER_MODE_CBC, MBEDTLS_CIPHER_MODE_XTS and\0A *        MBEDTLS_NIST_KW_C. When #MBEDTLS_PSA_CRYPTO_CONFIG is enabled,\0A *        this feature is incompatible with following supported PSA equivalence,\0A *        PSA_WANT_ALG_ECB_NO_PADDING, PSA_WANT_ALG_CBC_NO_PADDING,\0A *        PSA_WANT_ALG_CBC_PKCS7 and PSA_WANT_KEY_TYPE_DES.\0A *\0A * Module:  library/aes.c\0A *          library/aesce.c\0A *          library/aesni.c\0A *          library/aria.c\0A *          library/camellia.c\0A *          library/cipher.c\0A */\0A//#define MBEDTLS_BLOCK_CIPHER_NO_DECRYPT\0A\0A/**\0A * \5Cdef MBEDTLS_BIGNUM_C\0A *\0A * Enable the multi-precision integer library.\0A *\0A * Module:  library/bignum.c\0A *          library/bignum_core.c\0A *          library/bignum_mod.c\0A *          library/bignum_mod_raw.c\0A * Caller:  library/dhm.c\0A *          library/ecp.c\0A *          library/ecdsa.c\0A *          library/rsa.c\0A *          library/rsa_alt_helpers.c\0A *          library/ssl_tls.c\0A *\0A * This module is required for RSA, DHM and ECC (ECDH, ECDSA) support.\0A */\0A#define MBEDTLS_BIGNUM_C\0A\0A/**\0A * \5Cdef MBEDTLS_CAMELLIA_C\0A *\0A * Enable the Camellia block cipher.\0A *\0A * Module:  library/camellia.c\0A * Caller:  library/cipher.c\0A *\0A * This module enables the following ciphersuites (if other requisites are\0A * enabled as well):\0A *      MBEDTLS_TLS_ECDH_ECDSA_WITH_CAMELLIA_128_CBC_SHA256\0A *      MBEDTLS_TLS_ECDH_ECDSA_WITH_CAMELLIA_256_CBC_SHA384\0A *      MBEDTLS_TLS_ECDH_RSA_WITH_CAMELLIA_128_CBC_SHA256\0A *      MBEDTLS_TLS_ECDH_RSA_WITH_CAMELLIA_256_CBC_SHA384\0A *      MBEDTLS_TLS_ECDH_ECDSA_WITH_CAMELLIA_128_GCM_SHA256\0A *      MBEDTLS_TLS_ECDH_ECDSA_WITH_CAMELLIA_256_GCM_SHA384\0A *      MBEDTLS_TLS_ECDH_RSA_WITH_CAMELLIA_128_GCM_SHA256\0A *      MBEDTLS_TLS_ECDH_RSA_WITH_CAMELLIA_256_GCM_SHA384\0A *      MBEDTLS_TLS_ECDHE_ECDSA_WITH_CAMELLIA_256_GCM_SHA384\0A *      MBEDTLS_TLS_ECDHE_RSA_WITH_CAMELLIA_256_GCM_SHA384\0A *      MBEDTLS_TLS_DHE_RSA_WITH_CAMELLIA_256_GCM_SHA384\0A *      MBEDTLS_TLS_ECDHE_ECDSA_WITH_CAMELLIA_256_CBC_SHA384\0A *      MBEDTLS_TLS_ECDHE_RSA_WITH_CAMELLIA_256_CBC_SHA384\0A *      MBEDTLS_TLS_DHE_RSA_WITH_CAMELLIA_256_CBC_SHA256\0A *      MBEDTLS_TLS_DHE_RSA_WITH_CAMELLIA_256_CBC_SHA\0A *      MBEDTLS_TLS_ECDHE_ECDSA_WITH_CAMELLIA_128_GCM_SHA256\0A *      MBEDTLS_TLS_ECDHE_RSA_WITH_CAMELLIA_128_GCM_SHA256\0A *      MBEDTLS_TLS_DHE_RSA_WITH_CAMELLIA_128_GCM_SHA256\0A *      MBEDTLS_TLS_ECDHE_ECDSA_WITH_CAMELLIA_128_CBC_SHA256\0A *      MBEDTLS_TLS_ECDHE_RSA_WITH_CAMELLIA_128_CBC_SHA256\0A *      MBEDTLS_TLS_DHE_RSA_WITH_CAMELLIA_128_CBC_SHA256\0A *      MBEDTLS_TLS_DHE_RSA_WITH_CAMELLIA_128_CBC_SHA\0A *      MBEDTLS_TLS_DHE_PSK_WITH_CAMELLIA_256_GCM_SHA384\0A *      MBEDTLS_TLS_ECDHE_PSK_WITH_CAMELLIA_256_CBC_SHA384\0