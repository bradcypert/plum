@.str40659 = private global { i64, i64, [45512 x i8] } { i64 -1, i64 45511, [45512 x i8] c"/**\0A * \5Cfile bignum.h\0A *\0A * \5Cbrief Multi-precision integer library\0A */\0A/*\0A *  Copyright The Mbed TLS Contributors\0A *  SPDX-License-Identifier: Apache-2.0 OR GPL-2.0-or-later\0A */\0A#ifndef MBEDTLS_BIGNUM_H\0A#define MBEDTLS_BIGNUM_H\0A#include \22mbedtls/private_access.h\22\0A\0A#include \22mbedtls/build_info.h\22\0A\0A#include <stddef.h>\0A#include <stdint.h>\0A\0A#if defined(MBEDTLS_FS_IO)\0A#include <stdio.h>\0A#endif\0A\0A/** An error occurred while reading from or writing to a file. */\0A#define MBEDTLS_ERR_MPI_FILE_IO_ERROR                     -0x0002\0A/** Bad input parameters to function. */\0A#define MBEDTLS_ERR_MPI_BAD_INPUT_DATA                    -0x0004\0A/** There is an invalid character in the digit string. */\0A#define MBEDTLS_ERR_MPI_INVALID_CHARACTER                 -0x0006\0A/** The buffer is too small to write to. */\0A#define MBEDTLS_ERR_MPI_BUFFER_TOO_SMALL                  -0x0008\0A/** The input arguments are negative or result in illegal output. */\0A#define MBEDTLS_ERR_MPI_NEGATIVE_VALUE                    -0x000A\0A/** The input argument for division is zero, which is not allowed. */\0A#define MBEDTLS_ERR_MPI_DIVISION_BY_ZERO                  -0x000C\0A/** The input arguments are not acceptable. */\0A#define MBEDTLS_ERR_MPI_NOT_ACCEPTABLE                    -0x000E\0A/** Memory allocation failed. */\0A#define MBEDTLS_ERR_MPI_ALLOC_FAILED                      -0x0010\0A\0A#define MBEDTLS_MPI_CHK(f)       \5C\0A    do                           \5C\0A    {                            \5C\0A        if ((ret = (f)) != 0) \5C\0A        goto cleanup;        \5C\0A    } while (0)\0A\0A/*\0A * Maximum size MPIs are allowed to grow to in number of limbs.\0A */\0A#define MBEDTLS_MPI_MAX_LIMBS                             10000\0A\0A#if !defined(MBEDTLS_MPI_WINDOW_SIZE)\0A/*\0A * Maximum window size used for modular exponentiation. Default: 3\0A * Minimum value: 1. Maximum value: 6.\0A *\0A * Result is an array of ( 2 ** MBEDTLS_MPI_WINDOW_SIZE ) MPIs used\0A * for the sliding window calculation. (So 8 by default)\0A *\0A * Reduction in size, reduces speed.\0A */\0A#define MBEDTLS_MPI_WINDOW_SIZE                           3        /**< Maximum window size used. */\0A#endif /* !MBEDTLS_MPI_WINDOW_SIZE */\0A\0A#if !defined(MBEDTLS_MPI_MAX_SIZE)\0A/*\0A * Maximum size of MPIs allowed in bits and bytes for user-MPIs.\0A * ( Default: 512 bytes => 4096 bits, Maximum tested: 2048 bytes => 16384 bits )\0A *\0A * Note: Calculations can temporarily result in larger MPIs. So the number\0A * of limbs required (MBEDTLS_MPI_MAX_LIMBS) is higher.\0A */\0A#define MBEDTLS_MPI_MAX_SIZE                              1024     /**< Maximum number of bytes for usable MPIs. */\0A#endif /* !MBEDTLS_MPI_MAX_SIZE */\0A\0A#define MBEDTLS_MPI_MAX_BITS                              (8 * MBEDTLS_MPI_MAX_SIZE)      /**< Maximum number of bits for usable MPIs. */\0A\0A/*\0A * When reading from files with mbedtls_mpi_read_file() and writing to files with\0A * mbedtls_mpi_write_file() the buffer should have space\0A * for a (short) label, the MPI (in the provided radix), the newline\0A * characters and the '\5C0'.\0A *\0A * By default we assume at least a 10 char label, a minimum radix of 10\0A * (decimal) and a maximum of 4096 bit numbers (1234 decimal chars).\0A * Autosized at compile time for at least a 10 char label, a minimum radix\0A * of 10 (decimal) for a number of MBEDTLS_MPI_MAX_BITS size.\0A *\0A * This used to be statically sized to 1250 for a maximum of 4096 bit\0A * numbers (1234 decimal chars).\0A *\0A * Calculate using the formula:\0A *  MBEDTLS_MPI_RW_BUFFER_SIZE = ceil(MBEDTLS_MPI_MAX_BITS / ln(10) * ln(2)) +\0A *                                LabelSize + 6\0A */\0A#define MBEDTLS_MPI_MAX_BITS_SCALE100          (100 * MBEDTLS_MPI_MAX_BITS)\0A#define MBEDTLS_LN_2_DIV_LN_10_SCALE100                 332\0A#define MBEDTLS_MPI_RW_BUFFER_SIZE             (((MBEDTLS_MPI_MAX_BITS_SCALE100 + \5C\0A                                                  MBEDTLS_LN_2_DIV_LN_10_SCALE100 - 1) / \5C\0A                                                 MBEDTLS_LN_2_DIV_LN_10_SCALE100) + 10 + 6)\0A\0A/*\0A * Define the base integer type, architecture-wise.\0A *\0A * 32 or 64-bit integer types can be forced regardless of the underlying\0A * architecture by defining MBEDTLS_HAVE_INT32 or MBEDTLS_HAVE_INT64\0A * respectively and undefining MBEDTLS_HAVE_ASM.\0A *\0A * Double-width integers (e.g. 128-bit in 64-bit architectures) can be\0A * disabled by defining MBEDTLS_NO_UDBL_DIVISION.\0A */\0A#if !defined(MBEDTLS_HAVE_INT32)\0A    #if defined(_MSC_VER) && defined(_M_AMD64)\0A/* Always choose 64-bit when using MSC */\0A        #if !defined(MBEDTLS_HAVE_INT64)\0A            #define MBEDTLS_HAVE_INT64\0A        #endif /* !MBEDTLS_HAVE_INT64 */\0Atypedef  int64_t mbedtls_mpi_sint;\0Atypedef uint64_t mbedtls_mpi_uint;\0A#define MBEDTLS_MPI_UINT_MAX                UINT64_MAX\0A    #elif defined(__GNUC__) && (                         \5C\0A    defined(__amd64__) || defined(__x86_64__)     || \5C\0A    defined(__ppc64__) || defined(__powerpc64__)  || \5C\0A    defined(__ia64__)  || defined(__alpha__)      || \5C\0A    (defined(__sparc__) && defined(__arch64__)) || \5C\0A    defined(__s390x__) || defined(__mips64)       || \5C\0A    defined(__aarch64__))\0A        #if !defined(MBEDTLS_HAVE_INT64)\0A            #define MBEDTLS_HAVE_INT64\0A        #endif /* MBEDTLS_HAVE_INT64 */\0Atypedef  int64_t mbedtls_mpi_sint;\0Atypedef uint64_t mbedtls_mpi_uint;\0A#define MBEDTLS_MPI_UINT_MAX                UINT64_MAX\0A        #if !defined(MBEDTLS_NO_UDBL_DIVISION)\0A/* mbedtls_t_udbl defined as 128-bit unsigned int */\0Atypedef unsigned int mbedtls_t_udbl __attribute__((mode(TI)));\0A            #define MBEDTLS_HAVE_UDBL\0A        #endif /* !MBEDTLS_NO_UDBL_DIVISION */\0A    #elif defined(__ARMCC_VERSION) && defined(__aarch64__)\0A/*\0A * __ARMCC_VERSION is defined for both armcc and armclang and\0A * __aarch64__ is only defined by armclang when compiling 64-bit code\0A */\0A        #if !defined(MBEDTLS_HAVE_INT64)\0A            #define MBEDTLS_HAVE_INT64\0A        #endif /* !MBEDTLS_HAVE_INT64 */\0Atypedef  int64_t mbedtls_mpi_sint;\0Atypedef uint64_t mbedtls_mpi_uint;\0A#define MBEDTLS_MPI_UINT_MAX                UINT64_MAX\0A        #if !defined(MBEDTLS_NO_UDBL_DIVISION)\0A/* mbedtls_t_udbl defined as 128-bit unsigned int */\0Atypedef __uint128_t mbedtls_t_udbl;\0A            #define MBEDTLS_HAVE_UDBL\0A        #endif /* !MBEDTLS_NO_UDBL_DIVISION */\0A    #elif defined(MBEDTLS_HAVE_INT64)\0A/* Force 64-bit integers with unknown compiler */\0Atypedef  int64_t mbedtls_mpi_sint;\0Atypedef uint64_t mbedtls_mpi_uint;\0A#define MBEDTLS_MPI_UINT_MAX                UINT64_MAX\0A    #endif\0A#endif /* !MBEDTLS_HAVE_INT32 */\0A\0A#if !defined(MBEDTLS_HAVE_INT64)\0A/* Default to 32-bit compilation */\0A    #if !defined(MBEDTLS_HAVE_INT32)\0A        #define MBEDTLS_HAVE_INT32\0A    #endif /* !MBEDTLS_HAVE_INT32 */\0Atypedef  int32_t mbedtls_mpi_sint;\0Atypedef uint32_t mbedtls_mpi_uint;\0A#define MBEDTLS_MPI_UINT_MAX                UINT32_MAX\0A    #if !defined(MBEDTLS_NO_UDBL_DIVISION)\0Atypedef uint64_t mbedtls_t_udbl;\0A        #define MBEDTLS_HAVE_UDBL\0A    #endif /* !MBEDTLS_NO_UDBL_DIVISION */\0A#endif /* !MBEDTLS_HAVE_INT64 */\0A\0A/*\0A * Sanity check that exactly one of MBEDTLS_HAVE_INT32 or MBEDTLS_HAVE_INT64 is defined,\0A * so that code elsewhere doesn't have to check.\0A */\0A#if (!(defined(MBEDTLS_HAVE_INT32) || defined(MBEDTLS_HAVE_INT64))) || \5C\0A    (defined(MBEDTLS_HAVE_INT32) && defined(MBEDTLS_HAVE_INT64))\0A#error \22Only 32-bit or 64-bit limbs are supported in bignum\22\0A#endif\0A\0A/** \5Ctypedef mbedtls_mpi_uint\0A * \5Cbrief The type of machine digits in a bignum, called _limbs_.\0A *\0A * This is always an unsigned integer type with no padding bits. The size\0A * is platform-dependent.\0A */\0A\0A/** \5Ctypedef mbedtls_mpi_sint\0A * \5Cbrief The signed type corresponding to #mbedtls_mpi_uint.\0A *\0A * This is always an signed integer type with no padding bits. The size\0A * is platform-dependent.\0A */\0A\0A#ifdef __cplusplus\0Aextern \22C\22 {\0A#endif\0A\0A/**\0A * \5Cbrief          MPI structure\0A */\0Atypedef struct mbedtls_mpi {\0A    /** Pointer to limbs.\0A     *\0A     * This may be \5Cc NULL if \5Cc n is 0.\0A     */\0A    mbedtls_mpi_uint *MBEDTLS_PRIVATE(p);\0A\0A    /** Sign: -1 if the mpi is negative, 1 otherwise.\0A     *\0A     * The number 0 must be represented with `s = +1`. Although many library\0A     * functions treat all-limbs-zero as equivalent to a valid representation\0A     * of 0 regardless of the sign bit, there are exceptions, so bignum\0A     * functions and external callers must always set \5Cc s to +1 for the\0A     * number zero.\0A     *\0A     * Note that this implies that calloc() or `... = {0}` does not create\0A     * a valid MPI representation. You must call mbedtls_mpi_init().\0A     */\0A    signed short MBEDTLS_PRIVATE(s);\0A\0A    /** Total number of limbs in \5Cc p.  */\0A    unsigned short MBEDTLS_PRIVATE(n);\0A    /* Make sure that MBEDTLS_MPI_MAX_LIMBS fits in n.\0A     * Use the same limit value on all platforms so that we don't have to\0A     * think about different behavior on the rare platforms where\0A     * unsigned short can store values larger than the minimum required by\0A     * the C language, which is 65535.\0A     */\0A#if MBEDTLS_MPI_MAX_LIMBS > 65535\0A#error \22MBEDTLS_MPI_MAX_LIMBS > 65535 is not supported\22\0A#endif\0A}\0Ambedtls_mpi;\0A\0A/**\0A * \5Cbrief           Initialize an MPI context.\0A *\0A *                  This makes the MPI ready to be set or freed,\0A *                  but does not define a value for the MPI.\0A *\0A * \5Cparam X         The MPI context to initialize. This must not be \5Cc NULL.\0A */\0Avoid mbedtls_mpi_init(mbedtls_mpi *X);\0A\0A/**\0A * \5Cbrief          This function frees the components of an MPI context.\0A *\0A * \5Cparam X        The MPI context to be cleared. This may be \5Cc NULL,\0A *                 in which case this function is a no-op. If it is\0A *                 not \5Cc NULL, it must point to an initialized MPI.\0A */\0Avoid mbedtls_mpi_free(mbedtls_mpi *X);\0A\0A/**\0A * \5Cbrief          Enlarge an MPI to the specified number of limbs.\0A *\0A * \5Cnote           This function does nothing if the MPI is\0A *                 already large enough.\0A *\0A * \5Cparam X        The MPI to grow. It must be initialized.\0A * \5Cparam nblimbs  The target number of limbs.\0A *\0A * \5Creturn         \5Cc 0 if successful.\0A * \5Creturn         #MBEDTLS_ERR_MPI_ALLOC_FAILED if memory allocation failed.\0A * \5Creturn         Another negative error code on other kinds of failure.\0A */\0Aint mbedtls_mpi_grow(mbedtls_mpi *X, size_t nblimbs);\0A\0A/**\0A * \5Cbrief          This function resizes an MPI downwards, keeping at least the\0A *                 specified number of limbs.\0A *\0A *                 If \5Cc X is smaller than \5Cc nblimbs, it is resized up\0A *                 instead.\0A *\0A * \5Cparam X        The MPI to shrink. This must point to an initialized MPI.\0A * \5Cparam nblimbs  The minimum number of limbs to keep.\0A *\0A * \5Creturn         \5Cc 0 if successful.\0A * \5Creturn         #MBEDTLS_ERR_MPI_ALLOC_FAILED if memory allocation failed\0A *                 (this can only happen when resizing up).\0A * \5Creturn         Another negative error code on other kinds of failure.\0A */\0Aint mbedtls_mpi_shrink(mbedtls_mpi *X, size_t nblimbs);\0A\0A/**\0A * \5Cbrief          Make a copy of an MPI.\0A *\0A * \5Cparam X        The destination MPI. This must point to an initialized MPI.\0A * \5Cparam Y        The source MPI. This must point to an initialized MPI.\0A *\0A * \5Cnote           The limb-buffer in the destination MPI is enlarged\0A *                 if necessary to hold the value in the source MPI.\0A *\0A * \5Creturn         \5Cc 0 if successful.\0A * \5Creturn         #MBEDTLS_ERR_MPI_ALLOC_FAILED if memory allocation failed.\0A * \5Creturn         Another negative error code on other kinds of failure.\0A */\0Aint mbedtls_mpi_copy(mbedtls_mpi *X, const mbedtls_mpi *Y);\0A\0A/**\0A * \5Cbrief          Swap the contents of two MPIs.\0A *\0A * \5Cparam X        The first MPI. It must be initialized.\0A * \5Cparam Y        The second MPI. It must be initialized.\0A */\0Avoid mbedtls_mpi_swap(mbedtls_mpi *X, mbedtls_mpi *Y);\0A\0A/**\0A * \5Cbrief          Perform a safe conditional copy of MPI which doesn't\0A *                 reveal whether the condition was true or not.\0A *\0A * \5Cparam X        The MPI to conditionally assign to. This must point\0A *                 to an initialized MPI.\0A * \5Cparam Y        The MPI to be assigned from. This must point to an\0A *                 initialized MPI.\0A * \5Cparam assign   The condition deciding whether to perform the\0A *                 assignment or not. Must be either 0 or 1:\0A *                 * \5Cc 1: Perform the assignment `X = Y`.\0A *                 * \5Cc 0: Keep the original value of \5Cp X.\0A *\0A * \5Cnote           This function is equivalent to\0A *                      `if( assign ) mbedtls_mpi_copy( X, Y );`\0A *                 except that it avoids leaking any information about whether\0A *                 the assignment was done or not (the above code may leak\0A *                 information through branch prediction and/or memory access\0A *                 patterns analysis).\0A *\0A * \5Cwarning        If \5Cp assign is neither 0 nor 1, the result of this function\0A *                 is indeterminate, and the resulting value in \5Cp X might be\0A *                 neither its original value nor the value in \5Cp Y.\0A *\0A * \5Creturn         \5Cc 0 if successful.\0A * \5Creturn         #MBEDTLS_ERR_MPI_ALLOC_FAILED if memory allocation failed.\0A * \5Creturn         Another negative error code on other kinds of failure.\0A */\0Aint mbedtls_mpi_safe_cond_assign(mbedtls_mpi *X, const mbedtls_mpi *Y, unsigned char assign);\0A\0A/**\0A * \5Cbrief          Perform a safe conditional swap which doesn't\0A *                 reveal whether the condition was true or not.\0A *\0A * \5Cparam X        The first MPI. This must be initialized.\0A * \5Cparam Y        The second MPI. This must be initialized.\0A * \5Cparam swap     The condition deciding whether to perform\0A *                 the swap or not. Must be either 0 or 1:\0A *                 * \5Cc 1: Swap the values of \5Cp X and \5Cp Y.\0A *                 * \5Cc 0: Keep the original values of \5Cp X and \5Cp Y.\0A *\0A * \5Cnote           This function is equivalent to\0A *                      if( swap ) mbedtls_mpi_swap( X, Y );\0A *                 except that it avoids leaking any information about whether\0A *                 the swap was done or not (the above code may leak\0A *                 information through branch prediction and/or memory access\0A *                 patterns analysis).\0A *\0A * \5Cwarning        If \5Cp swap is neither 0 nor 1, the result of this function\0A *                 is indeterminate, and both \5Cp X and \5Cp Y might end up with\0A *                 values different to either of the original ones.\0A *\0A * \5Creturn         \5Cc 0 if successful.\0A * \5Creturn         #MBEDTLS_ERR_MPI_ALLOC_FAILED if memory allocation failed.\0A * \5Creturn         Another negative error code on other kinds of failure.\0A *\0A */\0Aint mbedtls_mpi_safe_cond_swap(mbedtls_mpi *X, mbedtls_mpi *Y, unsigned char swap);\0A\0A/**\0A * \5Cbrief          Store integer value in MPI.\0A *\0A * \5Cparam X        The MPI to set. This must be initialized.\0A * \5Cparam z        The value to use.\0A *\0A * \5Creturn         \5Cc 0 if successful.\0A * \5Creturn         #MBEDTLS_ERR_MPI_ALLOC_FAILED if memory allocation failed.\0A * \5Creturn         Another negative error code on other kinds of failure.\0A */\0Aint mbedtls_mpi_lset(mbedtls_mpi *X, mbedtls_mpi_sint z);\0A\0A/**\0A * \5Cbrief          Get a specific bit from an MPI.\0A *\0A * \5Cparam X        The MPI to query. This must be initialized.\0A * \5Cparam pos      Zero-based index of the bit to query.\0A *\0A * \5Creturn         \5Cc 0 or \5Cc 1 on success, depending on whether bit \5Cc pos\0A *                 of \5Cc X is unset or set.\0A * \5Creturn         A negative error code on failure.\0A */\0Aint mbedtls_mpi_get_bit(const mbedtls_mpi *X, size_t pos);\0A\0A/**\0A * \5Cbrief          Modify a specific bit in an MPI.\0A *\0A * \5Cnote           This function will grow the target MPI if necessary to set a\0A *                 bit to \5Cc 1 in a not yet existing limb. It will not grow if\0A *                 the bit should be set to \5Cc 0.\0A *\0A * \5Cparam X        The MPI to modify. This must be initialized.\0A * \5Cparam pos      Zero-based index of the bit to modify.\0A * \5Cparam val      The desired value of bit \5Cc pos: \5Cc 0 or \5Cc 1.\0A *\0A * \5Creturn         \5Cc 0 if successful.\0A * \5Creturn         #MBEDTLS_ERR_MPI_ALLOC_FAILED if memory allocation failed.\0A * \5Creturn         Another negative error code on other kinds of failure.\0A */\0Aint mbedtls_mpi_set_bit(mbedtls_mpi *X, size_t pos, unsigned char val);\0A\0A/**\0A * \5Cbrief          Return the number of bits of value \5Cc 0 before the\0A *                 least significant bit of value \5Cc 1.\0A *\0A * \5Cnote           This is the same as the zero-based index of\0A *                 the least significant bit of value \5Cc 1.\0A *\0A * \5Cparam X        The MPI to query.\0A *\0A * \5Creturn         The number of bits of value \5Cc 0 before the least significant\0A *                 bit of value \5Cc 1 in \5Cp X.\0A */\0Asize_t mbedtls_mpi_lsb(const mbedtls_mpi *X);\0A\0A/**\0A * \5Cbrief          Return the number of bits up to and including the most\0A *                 significant bit of value \5Cc 1.\0A *\0A * * \5Cnote         This is same as the one-based index of the most\0A *                 significant bit of value \5Cc 1.\0A *\0A * \5Cparam X        The MPI to query. This must point to an initialized MPI.\0A *\0A * \5Creturn         The number of bits up to and including the most\0A *                 significant bit of value \5Cc 1.\0A */\0Asize_t mbedtls_mpi_bitlen(const mbedtls_mpi *X);\0A\0A/**\0A * \5Cbrief          Return the total size of an MPI value in bytes.\0A *\0A * \5Cparam X        The MPI to use. This must point to an initialized MPI.\0A *\0A * \5Cnote           The value returned by this function may be less than\0A *                 the number of bytes used to store \5Cp X internally.\0A *                 This happens if and only if there are trailing bytes\0A *                 of value zero.\0A *\0A * \5Creturn         The least number of bytes capable of storing\0A *                 the absolute value of \5Cp X.\0A */\0Asize_t mbedtls_mpi_size(const mbedtls_mpi *X);\0A\0A/**\0A * \5Cbrief          Import an MPI from an ASCII string.\0A *\0A * \5Cparam X        The destination MPI. This must point to an initialized MPI.\0A * \5Cparam radix    The numeric base of the input string.\0A * \5Cparam s        Null-terminated string buffer.\0A *\0A * \5Creturn         \5Cc 0 if successful.\0A * \5Creturn         A negative error code on failure.\0A */\0Aint mbedtls_mpi_read_string(mbedtls_mpi *X, int radix, const char *s);\0A\0A/**\0A * \5Cbrief          Export an MPI to an ASCII string.\0A *\0A * \5Cparam X        The source MPI. This must point to an initialized MPI.\0A * \5Cparam radix    The numeric base of the output string.\0A * \5Cparam buf      The buffer to write the string to. This must be writable\0A *                 buffer of length \5Cp buflen Bytes.\0A * \5Cparam buflen   The available size in Bytes of \5Cp buf.\0A * \5Cparam olen     The address at which to store the length of the string\0A *                 written, including the  final \5Cc NULL byte. This must\0A *                 not be \5Cc NULL.\0A *\0A * \5Cnote           You can call this function with `buflen == 0` to obtain the\0A *                 minimum required buffer size in `*olen`.\0A *\0A * \5Creturn         \5Cc 0 if successful.\0A * \5Creturn         #MBEDTLS_ERR_MPI_BUFFER_TOO_SMALL if the target buffer \5Cp buf\0A *                 is too small to hold the value of \5Cp X in the desired base.\0A *                 In this case, `*olen` is nonetheless updated to contain the\0A *                 size of \5Cp buf required for a successful call.\0A * \5Creturn         Another negative error code on different kinds of failure.\0A */\0Aint mbedtls_mpi_write_string(const mbedtls_mpi *X, int radix,\0A                             char *buf, size_t buflen, size_t *olen);\0A\0A#if defined(MBEDTLS_FS_IO)\0A/**\0A * \5Cbrief          Read an MPI from a line in an opened file.\0A *\0A * \5Cparam X        The destination MPI. This must point to an initialized MPI.\0A * \5Cparam radix    The numeric base of the string representation used\0A *                 in the source line.\0A * \5Cparam fin      The input file handle to use. This must not be \5Cc NULL.\0A *\0A * \5Cnote           On success, this function advances the file stream\0A *                 to the end of the current line or to EOF.\0A *\0A *                 The function returns \5Cc 0 on an empty line.\0A *\0A *                 Leading whitespaces are ignored, as is a\0A *                 '0x' prefix for radix \5Cc 16.\0A *\0A * \5Creturn         \5Cc 0 if successful.\0A * \5Creturn         #MBEDTLS_ERR_MPI_BUFFER_TOO_SMALL if the file read buffer\0A *                 is too small.\0A * \5Creturn         Another negative error code on failure.\0A */\0Aint mbedtls_mpi_read_file(mbedtls_mpi *X, int radix, FILE *fin);\0A\0A/**\0A * \5Cbrief          Export an MPI into an opened file.\0A *\0A * \5Cparam p        A string prefix to emit prior to the MPI data.\0A *                 For example, this might be a label, or \220x\22 when\0A *                 printing in base \5Cc 16. This may be \5Cc NULL if no prefix\0A *                 is needed.\0A * \5Cparam X        The source MPI. This must point to an initialized MPI.\0A * \5Cparam radix    The numeric base to be used in the emitted string.\0A * \5Cparam fout     The output file handle. This may be \5Cc NULL, in which case\0A *                 the output is written to \5Cc stdout.\0A *\0A * \5Creturn         \5Cc 0 if successful.\0A * \5Creturn         A negative error code on failure.\0A */\0Aint mbedtls_mpi_write_file(const char *p, const mbedtls_mpi *X,\0A                           int radix, FILE *fout);\0A#endif /* MBEDTLS_FS_IO */\0A\0A/**\0A * \5Cbrief          Import an MPI from unsigned big endian binary data.\0A *\0A * \5Cparam X        The destination MPI. This must point to an initialized MPI.\0A * \5Cparam buf      The input buffer. This must be a readable buffer of length\0A *                 \5Cp buflen Bytes.\0A * \5Cparam buflen   The length of the input buffer \5Cp buf in Bytes.\0A *\0A * \5Creturn         \5Cc 0 if successful.\0A * \5Creturn         #MBEDTLS_ERR_MPI_ALLOC_FAILED if memory allocation failed.\0A * \5Creturn         Another negative error code on different kinds of failure.\0A */\0Aint mbedtls_mpi_read_binary(mbedtls_mpi *X, const unsigned char *buf,\0A                            size_t buflen);\0A\0A/**\0A * \5Cbrief          Import X from unsigned binary data, little endian\0A *\0A * \5Cparam X        The destination MPI. This must point to an initialized MPI.\0A * \5Cparam buf      The input buffer. This must be a readable buffer of length\0A *                 \5Cp buflen Bytes.\0A * \5Cparam buflen   The length of the input buffer \5Cp buf in Bytes.\0A *\0A * \5Creturn         \5Cc 0 if successful.\0A * \5Creturn         #MBEDTLS_ERR_MPI_ALLOC_FAILED if memory allocation failed.\0A * \5Creturn         Another negative error code on different kinds of failure.\0A */\0Aint mbedtls_mpi_read_binary_le(mbedtls_mpi *X,\0A                               const unsigned char *buf, size_t buflen);\0A\0A/**\0A * \5Cbrief          Export X into unsigned binary data, big endian.\0A *                 Always fills the whole buffer, which will start with zeros\0A *                 if the number is smaller.\0A *\0A * \5Cparam X        The source MPI. This must point to an initialized MPI.\0A * \5Cparam buf      The output buffer. This must be a writable buffer of length\0A *                 \5Cp buflen Bytes.\0A * \5Cparam buflen   The size of the output buffer \5Cp buf in Bytes.\0A *\0A * \5Creturn         \5Cc 0 if successful.\0A * \5Creturn         #MBEDTLS_ERR_MPI_BUFFER_TOO_SMALL if \5Cp buf isn't\0A *                 large enough to hold the value of \5Cp X.\0A * \5Creturn         Another negative error code on different kinds of failure.\0A */\0Aint mbedtls_mpi_write_binary(const mbedtls_mpi *X, unsigned char *buf,\0A                             size_t buflen);\0A\0A/**\0A * \5Cbrief          Export X into unsigned binary data, little endian.\0A *                 Always fills the whole buffer, which will end with zeros\0A *                 if the number is smaller.\0A *\0A * \5Cparam X        The source MPI. This must point to an initialized MPI.\0A * \5Cparam buf      The output buffer. This must be a writable buffer of length\0A *                 \5Cp buflen Bytes.\0A * \5Cparam buflen   The size of the output buffer \5Cp buf in Bytes.\0A *\0A * \5Creturn         \5Cc 0 if successful.\0A * \5Creturn         #MBEDTLS_ERR_MPI_BUFFER_TOO_SMALL if \5Cp buf isn't\0A *                 large enough to hold the value of \5Cp X.\0A * \5Creturn         Another negative error code on different kinds of failure.\0A */\0Aint mbedtls_mpi_write_binary_le(const mbedtls_mpi *X,\0A                                unsigned char *buf, size_t buflen);\0A\0A/**\0A * \5Cbrief          Perform a left-shift on an MPI: X <<= count\0A *\0A * \5Cparam X        The MPI to shift. This must point to an initialized MPI.\0A *                 The MPI pointed by \5Cp X may be resized to fit\0A *                 the resulting number.\0A * \5Cparam count    The number of bits to shift by.\0A *\0A * \5Creturn         \5Cc 0 if successful.\0A * \5Creturn         #MBEDTLS_ERR_MPI_ALLOC_FAILED if a memory allocation failed.\0A * \5Creturn         Another negative error code on different kinds of failure.\0A */\0Aint mbedtls_mpi_shift_l(mbedtls_mpi *X, size_t count);\0A\0A/**\0A * \5Cbrief          Perform a right-shift on an MPI: X >>= count\0A *\0A * \5Cparam X        The MPI to shift. This must point to an initialized MPI.\0A * \5Cparam count    The number of bits to shift by.\0A *\0A * \5Creturn         \5Cc 0 if successful.\0A * \5Creturn         #MBEDTLS_ERR_MPI_ALLOC_FAILED if a memory allocation failed.\0A * \5Creturn         Another negative error code on different kinds of failure.\0A */\0Aint mbedtls_mpi_shift_r(mbedtls_mpi *X, size_t count);\0A\0A/**\0A * \5Cbrief          Compare the absolute values of two MPIs.\0A *\0A * \5Cparam X        The left-hand MPI. This must point to an initialized MPI.\0A * \5Cparam Y        The right-hand MPI. This must point to an initialized MPI.\0A *\0A * \5Creturn         \5Cc 1 if `|X|` is greater than `|Y|`.\0A * \5Creturn         \5Cc -1 if `|X|` is lesser than `|Y|`.\0A * \5Creturn         \5Cc 0 if `|X|` is equal to `|Y|`.\0A */\0Aint mbedtls_mpi_cmp_abs(const mbedtls_mpi *X, const mbedtls_mpi *Y);\0A\0A/**\0A * \5Cbrief          Compare two MPIs.\0A *\0A * \5Cparam X        The left-hand MPI. This must point to an initialized MPI.\0A * \5Cparam Y        The right-hand MPI. This must point to an initialized MPI.\0A *\0A * \5Creturn         \5Cc 1 if \5Cp X is greater than \5Cp Y.\0A * \5Creturn         \5Cc -1 if \5Cp X is lesser than \5Cp Y.\0A * \5Creturn         \5Cc 0 if \5Cp X is equal to \5Cp Y.\0A */\0Aint mbedtls_mpi_cmp_mpi(const mbedtls_mpi *X, const mbedtls_mpi *Y);\0A\0A/**\0A * \5Cbrief          Check if an MPI is less than the other in constant time.\0A *\0A * \5Cparam X        The left-hand MPI. This must point to an initialized MPI\0A *                 with the same allocated length as Y.\0A * \5Cparam Y        The right-hand MPI. This must point to an initialized MPI\0A *                 with the same allocated length as X.\0A * \5Cparam ret      The result of the comparison:\0A *                 \5Cc 1 if \5Cp X is less than \5Cp Y.\0A *                 \5Cc 0 if \5Cp X is greater than or equal to \5Cp Y.\0A *\0A * \5Creturn         0 on success.\0A * \5Creturn         MBEDTLS_ERR_MPI_BAD_INPUT_DATA if the allocated length of\0A *                 the two input MPIs is not the same.\0A */\0Aint mbedtls_mpi_lt_mpi_ct(const mbedtls_mpi *X, const mbedtls_mpi *Y,\0A                          unsigned *ret);\0A\0A/**\0A * \5Cbrief          Compare an MPI with an integer.\0A *\0A * \5Cparam X        The left-hand MPI. This must point to an initialized MPI.\0A * \5Cparam z        The integer value to compare \5Cp X to.\0A *\0A * \5Creturn         \5Cc 1 if \5Cp X is greater than \5Cp z.\0A * \5Creturn         \5Cc -1 if \5Cp X is lesser than \5Cp z.\0A * \5Creturn         \5Cc 0 if \5Cp X is equal to \5Cp z.\0A */\0Aint mbedtls_mpi_cmp_int(const mbedtls_mpi *X, mbedtls_mpi_sint z);\0A\0A/**\0A * \5Cbrief          Perform an unsigned addition of MPIs: X = |A| + |B|\0A *\0A * \5Cparam X        The destination MPI. This must point to an initialized MPI.\0A * \5Cparam A        The first summand. This must point to an initialized MPI.\0A * \5Cparam B        The second summand. This must point to an initialized MPI.\0A *\0A * \5Creturn         \5Cc 0 if successful.\0A * \5Creturn         #MBEDTLS_ERR_MPI_ALLOC_FAILED if a memory allocation failed.\0A * \5Creturn         Another negative error code on different kinds of failure.\0A */\0Aint mbedtls_mpi_add_abs(mbedtls_mpi *X, const mbedtls_mpi *A,\0A                        const mbedtls_mpi *B);\0A\0A/**\0A * \5Cbrief          Perform an unsigned subtraction of MPIs: X = |A| - |B|\0A *\0A * \5Cparam X        The destination MPI. This must point to an initialized MPI.\0A * \5Cparam A        The minuend. This must point to an initialized MPI.\0A * \5Cparam B        The subtrahend. This must point to an initialized MPI.\0A *\0A * \5Creturn         \5Cc 0 if successful.\0A * \5Creturn         #MBEDTLS_ERR_MPI_NEGATIVE_VALUE if \5Cp B is greater than \5Cp A.\0A * \5Creturn         Another negative error code on different kinds of failure.\0A *\0A */\0Aint mbedtls_mpi_sub_abs(mbedtls_mpi *X, const mbedtls_mpi *A,\0A                        const mbedtls_mpi *B);\0A\0A/**\0A * \5Cbrief          Perform a signed addition of MPIs: X = A + B\0A *\0A * \5Cparam X        The destination MPI. This must point to an initialized MPI.\0A * \5Cparam A        The first summand. This must point to an initialized MPI.\0A * \5Cparam B        The second summand. This must point to an initialized MPI.\0A *\0A * \5Creturn         \5Cc 0 if successful.\0A * \5Creturn         #MBEDTLS_ERR_MPI_ALLOC_FAILED if a memory allocation failed.\0A * \5Creturn         Another negative error code on different kinds of failure.\0A */\0Aint mbedtls_mpi_add_mpi(mbedtls_mpi *X, const mbedtls_mpi *A,\0A                        const mbedtls_mpi *B);\0A\0A/**\0A * \5Cbrief          Perform a signed subtraction of MPIs: X = A - B\0A *\0A * \5Cparam X        The destination MPI. This must point to an initialized MPI.\0A * \5Cparam A        The minuend. This must point to an initialized MPI.\0A * \5Cparam B        The subtrahend. This must point to an initialized MPI.\0A *\0A * \5Creturn         \5Cc 0 if successful.\0A * \5Creturn         #MBEDTLS_ERR_MPI_ALLOC_FAILED if a memory allocation failed.\0A * \5Creturn         Another negative error code on different kinds of failure.\0A */\0Aint mbedtls_mpi_sub_mpi(mbedtls_mpi *X, const mbedtls_mpi *A,\0A                        const mbedtls_mpi *B);\0A\0A/**\0A * \5Cbrief          Perform a signed addition of an MPI and an integer: X = A + b\0A *\0A * \5Cparam X        The destination MPI. This must point to an initialized MPI.\0A * \5Cparam A        The first summand. This must point to an initialized MPI.\0A * \5Cparam b        The second summand.\0A *\0A * \5Creturn         \5Cc 0 if successful.\0A * \5Creturn         #MBEDTLS_ERR_MPI_ALLOC_FAILED if a memory allocation failed.\0A * \5Creturn         Another negative error code on different kinds of failure.\0A */\0Aint mbedtls_mpi_add_int(mbedtls_mpi *X, const mbedtls_mpi *A,\0A                        mbedtls_mpi_sint b);\0A\0A/**\0A * \5Cbrief          Perform a signed subtraction of an MPI and an integer:\0A *                 X = A - b\0A *\0A * \5Cparam X        The destination MPI. This must point to an initialized MPI.\0A * \5Cparam A        The minuend. This must point to an initialized MPI.\0A * \5Cparam b        The subtrahend.\0A *\0A * \5Creturn         \5Cc 0 if successful.\0A * \5Creturn         #MBEDTLS_ERR_MPI_ALLOC_FAILED if a memory allocation failed.\0A * \5Creturn         Another negative error code on different kinds of failure.\0A */\0Aint mbedtls_mpi_sub_int(mbedtls_mpi *X, const mbedtls_mpi *A,\0A                        mbedtls_mpi_sint b);\0A\0A/**\0A * \5Cbrief          Perform a multiplication of two MPIs: X = A * B\0A *\0A * \5Cparam X        The destination MPI. This must point to an initialized MPI.\0A * \5Cparam A        The first factor. This must point to an initialized MPI.\0A * \5Cparam B        The second factor. This must point to an initialized MPI.\0A *\0A * \5Creturn         \5Cc 0 if successful.\0A * \5Creturn         #MBEDTLS_ERR_MPI_ALLOC_FAILED if a memory allocation failed.\0A * \5Creturn         Another negative error code on different kinds of failure.\0A *\0A */\0Aint mbedtls_mpi_mul_mpi(mbedtls_mpi *X, const mbedtls_mpi *A,\0A                        const mbedtls_mpi *B);\0A\0A/**\0A * \5Cbrief          Perform a multiplication of an MPI with an unsigned integer:\0A *                 X = A * b\0A *\0A * \5Cparam X        The destination MPI. This must point to an initialized MPI.\0A * \5Cparam A        The first factor. This must point to an initialized MPI.\0A * \5Cparam b        The second factor.\0A *\0A * \5Creturn         \5Cc 0 if successful.\0A * \5Creturn         #MBEDTLS_ERR_MPI_ALLOC_FAILED if a memory allocation failed.\0A * \5Creturn         Another negative error code on different kinds of failure.\0A *\0A */\0Aint mbedtls_mpi_mul_int(mbedtls_mpi *X, const mbedtls_mpi *A,\0A                        mbedtls_mpi_uint b);\0A\0A/**\0A * \5Cbrief          Perform a division with remainder of two MPIs:\0A *                 A = Q * B + R\0A *\0A * \5Cparam Q        The destination MPI for the quotient.\0A *                 This may be \5Cc NULL if the value of the\0A *                 quotient is not needed. This must not alias A or B.\0A * \5Cparam R        The destination MPI for the remainder value.\0A *                 This may be \5Cc NULL if the value of the\0A *                 remainder is not needed. This must not alias A or B.\0A * \5Cparam A        The dividend. This must point to an initialized MPI.\0A * \5Cparam B        The divisor. This must point to an initialized MPI.\0A *\0A * \5Creturn         \5Cc 0 if successful.\0A * \5Creturn         #MBEDTLS_ERR_MPI_ALLOC_FAILED if memory allocation failed.\0A * \5Creturn         #MBEDTLS_ERR_MPI_DIVISION_BY_ZERO if \5Cp B equals zero.\0A * \5Creturn         Another negative error code on different kinds of failure.\0A */\0Aint mbedtls_mpi_div_mpi(mbedtls_mpi *Q, mbedtls_mpi *R, const mbedtls_mpi *A,\0A                        const mbedtls_mpi *B);\0A\0A/**\0A * \5Cbrief          Perform a division with remainder of an MPI by an integer:\0A *                 A = Q * b + R\0A *\0A * \5Cparam Q        The destination MPI for the quotient.\0A *                 This may be \5Cc NULL if the value of the\0A *                 quotient is not needed.  This must not alias A.\0A * \5Cparam R        The destination MPI for the remainder value.\0A *                 This may be \5Cc NULL if the value of the\0A *                 remainder is not needed.  This must not alias A.\0A * \5Cparam A        The dividend. This must point to an initialized MPi.\0A * \5Cparam b        The divisor.\0A *\0A * \5Creturn         \5Cc 0 if successful.\0A * \5Creturn         #MBEDTLS_ERR_MPI_ALLOC_FAILED if memory allocation failed.\0A * \5Creturn         #MBEDTLS_ERR_MPI_DIVISION_BY_ZERO if \5Cp b equals zero.\0A * \5Creturn         Another negative error code on different kinds of failure.\0A */\0Aint mbedtls_mpi_div_int(mbedtls_mpi *Q, mbedtls_mpi *R, const mbedtls_mpi *A,\0A                        mbedtls_mpi_sint b);\0A\0A/**\0A * \5Cbrief          Perform a modular reduction. R = A mod B\0A *\0A * \5Cparam R        The destination MPI for the residue value.\0A *                 This must point to an initialized MPI.\0A * \5Cparam A        The MPI to compute the residue of.\0A *                 This must point to an initialized MPI.\0A * \5Cparam B        The base of the modular reduction.\0A *                 This must point to an initialized MPI.\0A *\0A * \5Creturn         \5Cc 0 if successful.\0A * \5Creturn         #MBEDTLS_ERR_MPI_ALLOC_FAILED if a memory allocation failed.\0A * \5Creturn         #MBEDTLS_ERR_MPI_DIVISION_BY_ZERO if \5Cp B equals zero.\0A * \5Creturn         #MBEDTLS_ERR_MPI_NEGATIVE_VALUE if \5Cp B is negative.\0A * \5Creturn         Another negative error code on different kinds of failure.\0A *\0A */\0Aint mbedtls_mpi_mod_mpi(mbedtls_mpi *R, const mbedtls_mpi *A,\0A                        const mbedtls_mpi *B);\0A\0A/**\0A * \5Cbrief          Perform a modular reduction with respect to an integer.\0A *                 r = A mod b\0A *\0A * \5Cparam r        The address at which to store the residue.\0A *                 This must not be \5Cc NULL.\0A * \5Cparam A        The MPI to compute the residue of.\0A *                 This must point to an initialized MPi.\0A * \5Cparam b        The integer base of the modular reduction.\0A *\0A * \5Creturn         \5Cc 0 if successful.\0A * \5Creturn         #MBEDTLS_ERR_MPI_ALLOC_FAILED if a memory allocation failed.\0A * \5Creturn         #MBEDTLS_ERR_MPI_DIVISION_BY_ZERO if \5Cp b equals zero.\0A * \5Creturn         #MBEDTLS_ERR_MPI_NEGATIVE_VALUE if \5Cp b is negative.\0A * \5Creturn         Another negative error code on different kinds of failure.\0A */\0Aint mbedtls_mpi_mod_int(mbedtls_mpi_uint *r, const mbedtls_mpi *A,\0A                        mbedtls_mpi_sint b);\0A\0A/**\0A * \5Cbrief          Perform a modular exponentiation: X = A^E mod N\0A *\0A * \5Cparam X        The destination MPI. This must point to an initialized MPI.\0A *                 This must not alias E or N.\0A * \5Cparam A        The base of the exponentiation.\0A *                 This must point to an initialized MPI.\0A * \5Cparam E        The exponent MPI. This must point to an initialized MPI.\0A * \5Cparam N        The base for the modular reduction. This must point to an\0A *                 initialized MPI.\0A * \5Cparam prec_RR  A helper MPI depending solely on \5Cp N which can be used to\0A *                 speed-up multiple modular exponentiations for the same value\0A *                 of \5Cp N. This may be \5Cc NULL. If it is not \5Cc NULL, it must\0A *                 point to an initialized MPI. If it hasn't been used after\0A *                 the call to mbedtls_mpi_init(), this function will compute\0A *                 the helper value and store it in \5Cp prec_RR for reuse on\0A *                 subsequent calls to this function. Otherwise, the function\0A *                 will assume that \5Cp prec_RR holds the helper value set by a\0A *                 previous call to mbedtls_mpi_exp_mod(), and reuse it.\0A *\0A * \5Creturn         \5Cc 0 if successful.\0A * \5Creturn         #MBEDTLS_ERR_MPI_ALLOC_FAILED if a memory allocation failed.\0A * \5Creturn         #MBEDTLS_ERR_MPI_BAD_INPUT_DATA if \5Cc N is negative or\0A *                 even, or if \5Cc E is negative.\0A * \5Creturn         Another negative error code on different kinds of failures.\0A *\0A */\0Aint mbedtls_mpi_exp_mod(mbedtls_mpi *X, const mbedtls_mpi *A,\0A                        const mbedtls_mpi *E, const mbedtls_mpi *N,\0A                        mbedtls_mpi *prec_RR);\0A\0A/**\0A * \5Cbrief          Fill an MPI with a number of random bytes.\0A *\0A * \5Cparam X        The destination MPI. This must point to an initialized MPI.\0A * \5Cparam size     The number of random bytes to generate.\0A * \5Cparam f_rng    The RNG function to use. This must not be \5Cc NULL.\0A * \5Cparam p_rng    The RNG parameter to be passed to \5Cp f_rng. This may be\0A *                 \5Cc NULL if \5Cp f_rng doesn't need a context argument.\0A *\0A * \5Creturn         \5Cc 0 if successful.\0A * \5Creturn         #MBEDTLS_ERR_MPI_ALLOC_FAILED if a memory allocation failed.\0A * \5Creturn         Another negative error code on failure.\0A *\0A * \5Cnote           The bytes obtained from the RNG are interpreted\0A *                 as a big-endian representation of an MPI; this can\0A *                 be relevant in applications like deterministic ECDSA.\0A */\0Aint mbedtls_mpi_fill_random(mbedtls_mpi *X, size_t size,\0A                            int (*f_rng)(void *, unsigned char *, size_t),\0A                            void *p_rng);\0A\0A/** Generate a random number uniformly in a range.\0A *\0A * This function generates a random number between \5Cp min inclusive and\0A * \5Cp N exclusive.\0A *\0A * The procedure complies with RFC 6979 §3.3 (deterministic ECDSA)\0A * when the RNG is a suitably parametrized instance of HMAC_DRBG\0A * and \5Cp min is \5Cc 1.\0A *\0A * \5Cnote           There are `N - min` possible outputs. The lower bound\0A *                 \5Cp min can be reached, but the upper bound \5Cp N cannot.\0A *\0A * \5Cparam X        The destination MPI. This must point to an initialized MPI.\0A * \5Cparam min      The minimum value to return.\0A *                 It must be nonnegative.\0A * \5Cparam N        The upper bound of the range, exclusive.\0A *                 In other words, this is one plus the maximum value to return.\0A *                 \5Cp N must be strictly larger than \5Cp min.\0A * \5Cparam f_rng    The RNG function to use. This must not be \5Cc NULL.\0A * \5Cparam p_rng    The RNG parameter to be passed to \5Cp f_rng.\0A *\0A * \5Creturn         \5Cc 0 if successful.\0A * \5Creturn         #MBEDTLS_ERR_MPI_ALLOC_FAILED if a memory allocation failed.\0A * \5Creturn         #MBEDTLS_ERR_MPI_BAD_INPUT_DATA if \5Cp min or \5Cp N is invalid\0A *                 or if they are incompatible.\0A * \5Creturn         #MBEDTLS_ERR_MPI_NOT_ACCEPTABLE if the implementation was\0A *                 unable to find a suitable value within a limited number\0A *                 of attempts. This has a negligible probability if \5Cp N\0A *                 is significantly larger than \5Cp min, which is the case\0A *                 for all usual cryptographic applications.\0A * \5Creturn         Another negative error code on failure.\0A */\0Aint mbedtls_mpi_random(mbedtls_mpi *X,\0A                       mbedtls_mpi_sint min,\0A                       const mbedtls_mpi *N,\0A                       int (*f_rng)(void *, unsigned char *, size_t),\0A                       void *p_rng);\0A\0A/**\0A * \5Cbrief          Compute the greatest common divisor: G = gcd(A, B)\0A *\0A * \5Cparam G        The destination MPI. This must point to an initialized MPI.\0A * \5Cparam A        The first operand. This must point to an initialized MPI.\0A * \5Cparam B        The second operand. This must point to an initialized MPI.\0A *\0A * \5Creturn         \5Cc 0 if successful.\0A * \5Creturn         #MBEDTLS_ERR_MPI_ALLOC_FAILED if a memory allocation failed.\0A * \5Creturn         Another negative error code on different kinds of failure.\0A */\0Aint mbedtls_mpi_gcd(mbedtls_mpi *G, const mbedtls_mpi *A,\0A                    const mbedtls_mpi *B);\0A\0A/**\0A * \5Cbrief          Compute the modular inverse: X = A^-1 mod N\0A *\0A * \5Cparam X        The destination MPI. This must point to an initialized MPI.\0A * \5Cparam A        The MPI to calculate the modular inverse of. This must point\0A *                 to an initialized MPI.\0A * \5Cparam N        The base of the modular inversion. This must point to an\0A *                 initialized MPI.\0A *\0A * \5Creturn         \5Cc 0 if successful.\0A * \5Creturn         #MBEDTLS_ERR_MPI_ALLOC_FAILED if a memory allocation failed.\0A * \5Creturn         #MBEDTLS_ERR_MPI_BAD_INPUT_DATA if \5Cp N is less than\0A *                 or equal to one.\0A * \5Creturn         #MBEDTLS_ERR_MPI_NOT_ACCEPTABLE if \5Cp A has no modular\0A *                 inverse with respect to \5Cp N.\0A */\0Aint mbedtls_mpi_inv_mod(mbedtls_mpi *X, const mbedtls_mpi *A,\0A                        const mbedtls_mpi *N);\0A\0A/**\0A * \5Cbrief          Miller-Rabin primality test.\0A *\0A * \5Cwarning        If \5Cp X is potentially generated by an adversary, for example\0A *                 when validating cryptographic parameters that you didn't\0A *                 generate yourself and that are supposed to be prime, then\0A *                 \5Cp rounds should be at least the half of the security\0A *                 strength of the cryptographic algorithm. On the other hand,\0A *                 if \5Cp X is chosen uniformly or non-adversarially (as is the\0A *                 case when mbedtls_mpi_gen_prime calls this function), then\0A *                 \5Cp rounds can be much lower.\0A *\0A * \5Cparam X        The MPI to check for primality.\0A *                 This must point to an initialized MPI.\0A * \5Cparam rounds   The number of bases to perform the Miller-Rabin primality\0A *                 test for. The probability of returning 0 on a composite is\0A *                 at most 2<sup>-2*\5Cp rounds </sup>.\0A * \5Cparam f_rng    The RNG function to use. This must not be \5Cc NULL.\0A * \5Cparam p_rng    The RNG parameter to be passed to \5Cp f_rng.\0A *                 This may be \5Cc NULL if \5Cp f_rng doesn't use\0A *                 a context parameter.\0A *\0A * \5Creturn         \5Cc 0 if successful, i.e. \5Cp X is probably prime.\0A * \5Creturn         #MBEDTLS_ERR_MPI_ALLOC_FAILED if a memory allocation failed.\0A * \5Creturn         #MBEDTLS_ERR_MPI_NOT_ACCEPTABLE if \5Cp X is not prime.\0A * \5Creturn         Another negative error code on other kinds of failure.\0A */\0Aint mbedtls_mpi_is_prime_ext(const mbedtls_mpi *X, int rounds,\0A                             int (*f_rng)(void *, unsigned char *, size_t),\0A                             void *p_rng);\0A/**\0A * \5Cbrief Flags for mbedtls_mpi_gen_prime()\0A *\0A * Each of these flags is a constraint on the result X returned by\0A * mbedtls_mpi_gen_prime().\0A */\0Atypedef enum {\0A    MBEDTLS_MPI_GEN_PRIME_FLAG_DH =      0x0001, /**< (X-1)/2 is prime too */\0A    MBEDTLS_MPI_GEN_PRIME_FLAG_LOW_ERR = 0x0002, /**< lower error rate from 2<sup>-80</sup> to 2<sup>-128</sup> */\0A} mbedtls_mpi_gen_prime_flag_t;\0A\0A/**\0A * \5Cbrief          Generate a prime number.\0A *\0A * \5Cparam X        The destination MPI to store the generated prime in.\0A *                 This must point to an initialized MPi.\0A * \5Cparam nbits    The required size of the destination MPI in bits.\0A *                 This must be between \5Cc 3 and #MBEDTLS_MPI_MAX_BITS.\0A * \5Cparam flags    A mask of flags of type #mbedtls_mpi_gen_prime_flag_t.\0A * \5Cparam f_rng    The RNG function to use. This must not be \5Cc NULL.\0A * \5Cparam p_rng    The RNG parameter to be passed to \5Cp f_rng.\0A *                 This may be \5Cc NULL if \5Cp f_rng doesn't use\0A *                 a context parameter.\0A *\0A * \5Creturn         \5Cc 0 if successful, in which case \5Cp X holds a\0A *                 probably prime number.\0A * \5Creturn         #MBEDTLS_ERR_MPI_ALLOC_FAILED if a memory allocation failed.\0A * \5Creturn         #MBEDTLS_ERR_MPI_BAD_INPUT_DATA if `nbits` is not between\0A *                 \5Cc 3 and #MBEDTLS_MPI_MAX_BITS.\0A */\0Aint mbedtls_mpi_gen_prime(mbedtls_mpi *X, size_t nbits, int flags,\0A                          int (*f_rng)(void *, unsigned char *, size_t),\0A                          void *p_rng);\0A\0A#if defined(MBEDTLS_SELF_TEST)\0A\0A/**\0A * \5Cbrief          Checkup routine\0A *\0A * \5Creturn         0 if successful, or 1 if the test failed\0A */\0Aint mbedtls_mpi_self_test(int verbose);\0A\0A#endif /* MBEDTLS_SELF_TEST */\0A\0A#ifdef __cplusplus\0A}\0A#endif\0A\0A#endif /* bignum.h */\0A\00" }
