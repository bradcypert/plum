@.str41064 = private global { i64, i64, [5939 x i8] } { i64 -1, i64 5938, [5939 x i8] c"/*\0A *  Declaration of context structures for use with the PSA driver wrapper\0A *  interface. This file contains the context structures for 'composite'\0A *  operations, i.e. those operations which need to make use of other operations\0A *  from the primitives (crypto_driver_contexts_primitives.h)\0A *\0A *  Warning: This file will be auto-generated in the future.\0A *\0A * \5Cnote This file may not be included directly. Applications must\0A * include psa/crypto.h.\0A *\0A * \5Cnote This header and its content are not part of the Mbed TLS API and\0A * applications must not depend on it. Its main purpose is to define the\0A * multi-part state objects of the PSA drivers included in the cryptographic\0A * library. The definitions of these objects are then used by crypto_struct.h\0A * to define the implementation-defined types of PSA multi-part state objects.\0A */\0A/*  Copyright The Mbed TLS Contributors\0A *  SPDX-License-Identifier: Apache-2.0 OR GPL-2.0-or-later\0A */\0A\0A#ifndef PSA_CRYPTO_DRIVER_CONTEXTS_COMPOSITES_H\0A#define PSA_CRYPTO_DRIVER_CONTEXTS_COMPOSITES_H\0A\0A#include \22psa/crypto_driver_common.h\22\0A\0A/* Include the context structure definitions for the Mbed TLS software drivers */\0A#include \22psa/crypto_builtin_composites.h\22\0A\0A/* Include the context structure definitions for those drivers that were\0A * declared during the autogeneration process. */\0A\0A#if defined(MBEDTLS_TEST_LIBTESTDRIVER1)\0A#include <libtestdriver1/include/psa/crypto.h>\0A#endif\0A\0A#if defined(PSA_CRYPTO_DRIVER_TEST)\0A#if defined(MBEDTLS_TEST_LIBTESTDRIVER1) && \5C\0A    defined(LIBTESTDRIVER1_MBEDTLS_PSA_BUILTIN_MAC)\0Atypedef libtestdriver1_mbedtls_psa_mac_operation_t\0A    mbedtls_transparent_test_driver_mac_operation_t;\0Atypedef libtestdriver1_mbedtls_psa_mac_operation_t\0A    mbedtls_opaque_test_driver_mac_operation_t;\0A\0A#define MBEDTLS_TRANSPARENT_TEST_DRIVER_MAC_O