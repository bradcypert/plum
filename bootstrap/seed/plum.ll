@.str40702 = private global { i64, i64, [10840 x i8] } { i64 -1, i64 10839, [10840 x i8] c"/*\0A *  PSA FFDH layer on top of Mbed TLS crypto\0A */\0A/*\0A *  Copyright The Mbed TLS Contributors\0A *  SPDX-License-Identifier: Apache-2.0 OR GPL-2.0-or-later\0A */\0A\0A#include \22common.h\22\0A\0A#if defined(MBEDTLS_PSA_CRYPTO_C)\0A\0A/* This header is only needed because it defines\0A * MBEDTLS_DHM_RFC7919_FFDHEXXXX_[P|G]_BIN symbols that are used in\0A * mbedtls_psa_ffdh_set_prime_generator(). Apart from that, this module\0A * only uses bignum functions for arithmetic. */\0A#include <mbedtls/dhm.h>\0A\0A#include <psa/crypto.h>\0A#include \22psa_crypto_core.h\22\0A#include \22psa_crypto_ffdh.h\22\0A#include \22psa_crypto_random_impl.h\22\0A#include \22mbedtls/platform.h\22\0A#include \22mbedtls/error.h\22\0A\0A#if defined(MBEDTLS_PSA_BUILTIN_KEY_TYPE_DH_KEY_PAIR_EXPORT) ||   \5C\0A    defined(MBEDTLS_PSA_BUILTIN_KEY_TYPE_DH_KEY_PAIR_GENERATE) ||   \5C\0A    defined(MBEDTLS_PSA_BUILTIN_KEY_TYPE_DH_PUBLIC_KEY) || \5C\0A    defined(MBEDTLS_PSA_BUILTIN_ALG_FFDH)\0Astatic psa_status_t mbedtls_psa_ffdh_set_prime_generator(size_t key_size,\0A                                                         mbedtls_mpi *P,\0A                                                         mbedtls_mpi *G)\0A{\0A    const unsigned char *dhm_P = NULL;\0A    const unsigned char *dhm_G = NULL;\0A    size_t dhm_size_P = 0;\0A    size_t dhm_size_G = 0;\0A    int ret = MBEDTLS_ERR_ERROR_CORRUPTION_DETECTED;\0A\0A    if (P == NULL && G == NULL) {\0A        return PSA_ERROR_INVALID_ARGUMENT;\0A    }\0A\0A#if defined(MBEDTLS_PSA_BUILTIN_DH_RFC7919_2048)\0A    static const unsigned char dhm_P_2048[] =\0A        MBEDTLS_DHM_RFC7919_FFDHE2048_P_BIN;\0A    static const unsigned char dhm_G_2048[] =\0A        MBEDTLS_DHM_RFC7919_FFDHE2048_G_BIN;\0A#endif /* MBEDTLS_PSA_BUILTIN_DH_RFC7919_2048 */\0A#if defined(MBEDTLS_PSA_BUILTIN_DH_RFC7919_3072)\0A    static const unsigned char dhm_P_3072[] =\0A        MBEDTLS_DHM_RFC7919_FFDHE3072_P_BIN;\0A    static const unsigned char dhm_G_3072[] =\0A        MBEDTLS_DHM_RFC7919_FFDHE3072_G_BIN;\0A#endif /* MBEDTLS_PSA_BUILTIN_DH_RFC7919_3072 */\0A#if defined(MBEDTLS_PSA_BUILTIN_DH_RFC7919_4096)\0A    static const unsigned char dhm_P_4096[] =\0A        MBEDTLS_DHM_RFC7919_FFDHE4096_P_BIN;\0A    static const unsigned char dhm_G_4096[] =\0A        MBEDTLS_DHM_RFC7919_FFDHE4096_G_BIN;\0A#endif /* MBEDTLS_PSA_BUILTIN_DH_RFC7919_4096 */\0A#if defined(MBEDTLS_PSA_BUILTIN_DH_RFC7919_6144)\0A    static const unsigned char dhm_P_6144[] =\0A        MBEDTLS_DHM_RFC7919_FFDHE6144_P_BIN;\0A    static const unsigned char dhm_G_6144[] =\0A        MBEDTLS_DHM_RFC7919_FFDHE6144_G_BIN;\0A#endif /* MBEDTLS_PSA_BUILTIN_DH_RFC7919_6144 */\0A#if defined(MBEDTLS_PSA_BUILTIN_DH_RFC7919_8192)\0A    static const unsigned char dhm_P_8192[] =\0A        MBEDTLS_DHM_RFC7919_FFDHE8192_P_BIN;\0A    static const unsigned char dhm_G_8192[] =\0A        MBEDTLS_DHM_RFC7919_FFDHE8192_G_BIN;\0A#endif /* MBEDTLS_PSA_BUILTIN_DH_RFC7919_8192 */\0A\0A    switch (key_size) {\0A#if defined(MBEDTLS_PSA_BUILTIN_DH_RFC7919_2048)\0A        case sizeof(dhm_P_2048):\0A            dhm_P = dhm_P_2048;\0A            dhm_G = dhm_G_2048;\0A            dhm_size_P = sizeof(dhm_P_2048);\0A            dhm_size_G = sizeof(dhm_G_2048);\0A            break;\0A#endif /* MBEDTLS_PSA_BUILTIN_DH_RFC7919_2048 */\0A#if defined(MBEDTLS_PSA_BUILTIN_DH_RFC7919_3072)\0A        case sizeof(dhm_P_3072):\0A            dhm_P = dhm_P_3072;\0A            dhm_G = dhm_G_3072;\0A            dhm_size_P = sizeof(dhm_P_3072);\0A            dhm_size_G = sizeof(dhm_G_3072);\0A            break;\0A#endif /* MBEDTLS_PSA_BUILTIN_DH_RFC7919_3072 */\0A#if defined(MBEDTLS_PSA_BUILTIN_DH_RFC7919_4096)\0A        case sizeof(dhm_P_4096):\0A            dhm_P = dhm_P_4096;\0A            dhm_G = dhm_G_4096;\0A            dhm_size_P = sizeof(dhm_P_4096);\0A            dhm_size_G = sizeof(dhm_G_4096);\0A            break;\0A#endif /* MBEDTLS_PSA_BUILTIN_DH_RFC7919_4096 */\0A#if defined(MBEDTLS_PSA_BUILTIN_DH_RFC7919_6144)\0A        case sizeof(dhm_P_6144):\0A            dhm_P = dhm_P_6144;\0A            dhm_G = dhm_G_6144;\0A            dhm_size_P = sizeof(dhm_P_6144);\0A            dhm_size_G = sizeof(dhm_G_6144);\0A            break;\0A#endif /* MBEDTLS_PSA_BUILTIN_DH_RFC7919_6144 */\0A#if defined(MBEDTLS_PSA_BUILTIN_DH_RFC7919_8192)\0A        case sizeof(dhm_P_8192):\0A            dhm_P = dhm_P_8192;\0A            dhm_G = dhm_G_8192;\0A            dhm_size_P = sizeof(dhm_P_8192);\0A            dhm_size_G = sizeof(dhm_G_8192);\0A            break;\0A#endif /* MBEDTLS_PSA_BUILTIN_DH_RFC7919_8192 */\0A        default:\0A            return PSA_ERROR_INVALID_ARGUMENT;\0A    }\0A\0A    if (P != NULL) {\0A        MBEDTLS_MPI_CHK(mbedtls_mpi_read_binary(P, dhm_P,\0A                                                dhm_size_P));\0A    }\0A    if (G != NULL) {\0A        MBEDTLS_MPI_CHK(mbedtls_mpi_read_binary(G, dhm_G,\0A                                                dhm_size_G));\0A    }\0A\0Acleanup:\0A    if (ret != 0) {\0A        return mbedtls_to_psa_error(ret);\0A    }\0A\0A    return PSA_SUCCESS;\0A}\0A#endif /* MBEDTLS_PSA_BUILTIN_KEY_TYPE_DH_KEY_PAIR_EXPORT ||\0A          MBEDTLS_PSA_BUILTIN_KEY_TYPE_DH_KEY_PAIR_GENERATE ||\0A          MBEDTLS_PSA_BUILTIN_KEY_TYPE_DH_PUBLIC_KEY ||\0A          MBEDTLS_PSA_BUILTIN_ALG_FFDH */\0A\0A#if defined(MBEDTLS_PSA_BUILTIN_KEY_TYPE_DH_KEY_PAIR_EXPORT) || \5C\0A    defined(MBEDTLS_PSA_BUILTIN_KEY_TYPE_DH_PUBLIC_KEY)\0Apsa_status_t mbedtls_psa_ffdh_export_public_key(\0A    const psa_key_attributes_t *attributes,\0A    const uint8_t *key_buffer,\0A    size_t key_buffer_size,\0A    uint8_t *data,\0A    size_t data_size,\0A    size_t *data_length)\0A{\0A    int ret = MBEDTLS_ERR_ERROR_CORRUPTION_DETECTED;\0A    psa_status_t status = PSA_ERROR_CORRUPTION_DETECTED;\0A    mbedtls_mpi GX, G, X, P;\0A    psa_key_type_t type = attributes->type;\0A\0A    if (PSA_KEY_TYPE_IS_PUBLIC_KEY(type)) {\0A        if (key_buffer_size > data_size) {\0A            return PSA_ERROR_BUFFER_TOO_SMALL;\0A        }\0A        memcpy(data, key_buffer, key_buffer_size);\0A        memset(data + key_buffer_size, 0,\0A               data_size - key_buffer_size);\0A        *data_length = key_buffer_size;\0A        return PSA_SUCCESS;\0A    }\0A\0A    mbedtls_mpi_init(&GX); mbedtls_mpi_init(&G);\0A    mbedtls_mpi_init(&X); mbedtls_mpi_init(&P);\0A\0A    size_t key_len = PSA_BITS_TO_BYTES(attributes->bits);\0A\0A    status = mbedtls_psa_ffdh_set_prime_generator(key_len, &P, &G);\0A\0A    if (status != PSA_SUCCESS) {\0A        goto cleanup;\0A    }\0A\0A    MBEDTLS_MPI_CHK(mbedtls_mpi_read_binary(&X, key_buffer,\0A                                            key_buffer_size));\0A\0A    MBEDTLS_MPI_CHK(mbedtls_mpi_exp_mod(&GX, &G, &X, &P, NULL));\0A    MBEDTLS_MPI_CHK(mbedtls_mpi_write_binary(&GX, data, key_len));\0A\0A    *data_length = key_len;\0A\0A    ret = 0;\0Acleanup:\0A    mbedtls_mpi_free(&P); mbedtls_mpi_free(&G);\0A    mbedtls_mpi_free(&X); mbedtls_mpi_free(&GX);\0A\0A    if (status == PSA_SUCCESS && ret != 0) {\0A        status = mbedtls_to_psa_error(ret);\0A    }\0A\0A    return status;\0A}\0A#endif /* MBEDTLS_PSA_BUILTIN_KEY_TYPE_DH_KEY_PAIR_EXPORT ||\0A          MBEDTLS_PSA_BUILTIN_KEY_TYPE_DH_PUBLIC_KEY */\0A\0A#if defined(MBEDTLS_PSA_BUILTIN_KEY_TYPE_DH_KEY_PAIR_GENERATE)\0Apsa_status_t mbedtls_psa_ffdh_generate_key(\0A    const psa_key_attributes_t *attributes,\0A    uint8_t *key_buffer, size_t key_buffer_size, size_t *key_buffer_length)\0A{\0A    mbedtls_mpi X, P;\0A    int ret = MBEDTLS_ERR_ERROR_CORRUPTION_DETECTED;\0A    psa_status_t status = PSA_ERROR_CORRUPTION_DETECTED;\0A    mbedtls_mpi_init(&P); mbedtls_mpi_init(&X);\0A    (void) attributes;\0A\0A    status = mbedtls_psa_ffdh_set_prime_generator(key_buffer_size, &P, NULL);\0A\0A    if (status != PSA_SUCCESS) {\0A        goto cleanup;\0A    }\0A\0A    /* RFC7919: Traditional finite field Diffie-Hellman has each peer choose their\0A        secret exponent from the range [2, P-2].\0A        Select random value in range [3, P-1] and decrease it by 1. */\0A    MBEDTLS_MPI_CHK(mbedtls_mpi_random(&X, 3, &P, mbedtls_psa_get_random,\0A                                       MBEDTLS_PSA_RANDOM_STATE));\0A    MBEDTLS_MPI_CHK(mbedtls_mpi_sub_int(&X, &X, 1));\0A    MBEDTLS_MPI_CHK(mbedtls_mpi_write_binary(&X, key_buffer, key_buffer_size));\0A    *key_buffer_length = key_buffer_size;\0A\0Acleanup:\0A    mbedtls_mpi_free(&P); mbedtls_mpi_free(&X);\0A    if (status == PSA_SUCCESS && ret != 0) {\0A        return mbedtls_to_psa_error(ret);\0A    }\0A\0A    return status;\0A}\0A#endif /* MBEDTLS_PSA_BUILTIN_KEY_TYPE_DH_KEY_PAIR_GENERATE */\0A\0A#if defined(MBEDTLS_PSA_BUILTIN_KEY_TYPE_DH_KEY_PAIR_IMPORT)\0Apsa_status_t mbedtls_psa_ffdh_import_key(\0A    const psa_key_attributes_t *attributes,\0A    const uint8_t *data, size_t data_length,\0A    uint8_t *key_buffer, size_t key_buffer_size,\0A    size_t *key_buffer_length, size_t *bits)\0A{\0A    (void) attributes;\0A\0A    if (key_buffer_size < data_length) {\0A        return PSA_ERROR_BUFFER_TOO_SMALL;\0A    }\0A    memcpy(key_buffer, data, data_length);\0A    *key_buffer_length = data_length;\0A    *bits = PSA_BYTES_TO_BITS(data_length);\0A\0A    return PSA_SUCCESS;\0A}\0A#endif /* MBEDTLS_PSA_BUILTIN_KEY_TYPE_DH_KEY_PAIR_IMPORT */\0A\0A#if defined(MBEDTLS_PSA_BUILTIN_ALG_FFDH)\0Apsa_status_t mbedtls_psa_ffdh_key_agreement(\0A    const psa_key_attributes_t *attributes,\0A    const uint8_t *peer_key,\0A    size_t peer_key_length,\0A    const uint8_t *key_buffer,\0A    size_t key_buffer_size,\0A    uint8_t *shared_secret,\0A    size_t shared_secret_size,\0A    size_t *shared_secret_length)\0A{\0A    int ret = MBEDTLS_ERR_ERROR_CORRUPTION_DETECTED;\0A    psa_status_t status = PSA_ERROR_CORRUPTION_DETECTED;\0A    mbedtls_mpi P, G, X, GY, K;\0A    const size_t calculated_shared_secret_size = peer_key_length;\0A\0A    if (peer_key_length != key_buffer_size ||\0A        calculated_shared_secret_size > shared_secret_size) {\0A        return PSA_ERROR_INVALID_ARGUMENT;\0A    }\0A\0A    if (!PSA_KEY_TYPE_IS_DH_KEY_PAIR(psa_get_key_type(attributes))) {\0A        return PSA_ERROR_INVALID_ARGUMENT;\0A    }\0A\0A    mbedtls_mpi_init(&P); mbedtls_mpi_init(&G);\0A    mbedtls_mpi_init(&X); mbedtls_mpi_init(&GY);\0A    mbedtls_mpi_init(&K);\0A\0A    status = mbedtls_psa_ffdh_set_prime_generator(\0A        PSA_BITS_TO_BYTES(attributes->bits), &P, &G);\0A\0A    if (status != PSA_SUCCESS) {\0A        goto cleanup;\0A    }\0A\0A    MBEDTLS_MPI_CHK(mbedtls_mpi_read_binary(&X, key_buffer,\0A                                            key_buffer_size));\0A\0A    MBEDTLS_MPI_CHK(mbedtls_mpi_read_binary(&GY, peer_key,\0A                                            peer_key_length));\0A\0A    /* Calculate shared secret public key: K = G^(XY) mod P = GY^X mod P */\0A    MBEDTLS_MPI_CHK(mbedtls_mpi_exp_mod(&K, &GY, &X, &P, NULL));\0A\0A    MBEDTLS_MPI_CHK(mbedtls_mpi_write_binary(&K, shared_secret,\0A                                             calculated_shared_secret_size));\0A\0A    *shared_secret_length = calculated_shared_secret_size;\0A\0A    ret = 0;\0A\0Acleanup:\0A    mbedtls_mpi_free(&P); mbedtls_mpi_free(&G);\0A    mbedtls_mpi_free(&X); mbedtls_mpi_free(&GY);\0A    mbedtls_mpi_free(&K);\0A\0A    if (status == PSA_SUCCESS && ret != 0) {\0A        status = mbedtls_to_psa_error(ret);\0A    }\0A\0A    return status;\0A}\0A#endif /* MBEDTLS_PSA_BUILTIN_ALG_FFDH */\0A\0A#endif /* MBEDTLS_PSA_CRYPTO_C */\0A\00" }
