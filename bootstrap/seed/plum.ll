@.str39904 = private global { i64, i64, [23896 x i8] } { i64 -1, i64 23895, [23896 x i8] c"/*\0A *  PSA AEAD driver entry points\0A */\0A/*\0A *  Copyright The Mbed TLS Contributors\0A *  SPDX-License-Identifier: Apache-2.0 OR GPL-2.0-or-later\0A */\0A\0A#ifndef PSA_CRYPTO_AEAD_H\0A#define PSA_CRYPTO_AEAD_H\0A\0A#include <psa/crypto.h>\0A\0A/**\0A * \5Cbrief Process an authenticated encryption operation.\0A *\0A * \5Cnote The signature of this function is that of a PSA driver\0A *       aead_encrypt entry point. This function behaves as an aead_encrypt\0A *       entry point as defined in the PSA driver interface specification for\0A *       transparent drivers.\0A *\0A * \5Cparam[in]  attributes         The attributes of the key to use for the\0A *                                operation.\0A * \5Cparam[in]  key_buffer         The buffer containing the key context.\0A * \5Cparam      key_buffer_size    Size of the \5Cp key_buffer buffer in bytes.\0A * \5Cparam      alg                The AEAD algorithm to compute.\0A * \5Cparam[in]  nonce              Nonce or IV to use.\0A * \5Cparam      nonce_length       Size of the nonce buffer in bytes. This must\0A *                                be appropriate for the selected algorithm.\0A *                                The default nonce size is\0A *                                PSA_AEAD_NONCE_LENGTH(key_type, alg) where\0A *                                key_type is the type of key.\0A * \5Cparam[in]  additional_data    Additional data that will be authenticated\0A *                                but not encrypted.\0A * \5Cparam      additional_data_length  Size of additional_data in bytes.\0A * \5Cparam[in]  plaintext          Data that will be authenticated and encrypted.\0A * \5Cparam      plaintext_length   Size of plaintext in bytes.\0A * \5Cparam[out] ciphertext         Output buffer for the authenticated and\0A *                                encrypted data. The additional data is not\0A *                                part of this output. For algorithms where the\0A *                                encrypted data and the authentication tag are\0A *                                defined as separate outputs, the\0A *                                authentication tag is appended to the\0A *                                encrypted data.\0A * \5Cparam      ciphertext_size    Size of the ciphertext buffer in bytes. This\0A *                                must be appropriate for the selected algorithm\0A *                                and key:\0A *                                - A sufficient output size is\0A *                                  PSA_AEAD_ENCRYPT_OUTPUT_SIZE(key_type, alg,\0A *                                  plaintext_length) where key_type is the type\0A *                                  of key.\0A *                                - PSA_AEAD_ENCRYPT_OUTPUT_MAX_SIZE(\0A *                                  plaintext_length) evaluates to the maximum\0A *                                  ciphertext size of any supported AEAD\0A *                                  encryption.\0A * \5Cparam[out] ciphertext_length  On success, the size of the output in the\0A *                                ciphertext buffer.\0A *\0A * \5Cretval #PSA_SUCCESS Success.\0A * \5Cretval #PSA_ERROR_NOT_SUPPORTED\0A *         \5Cp alg is not supported.\0A * \5Cretval #PSA_ERROR_INSUFFICIENT_MEMORY \5Cemptydescription\0A * \5Cretval #PSA_ERROR_BUFFER_TOO_SMALL\0A *         ciphertext_size is too small.\0A * \5Cretval #PSA_ERROR_CORRUPTION_DETECTED \5Cemptydescription\0A */\0Apsa_status_t mbedtls_psa_aead_encrypt(\0A    const psa_key_attributes_t *attributes,\0A    const uint8_t *key_buffer, size_t key_buffer_size,\0A    psa_algorithm_t alg,\0A    const uint8_t *nonce, size_t nonce_length,\0A    const uint8_t *additional_data, size_t additional_data_length,\0A    const uint8_t *plaintext, size_t plaintext_length,\0A    uint8_t *ciphertext, size_t ciphertext_size, size_t *ciphertext_length);\0A\0A/**\0A * \5Cbrief Process an authenticated decryption operation.\0A *\0A * \5Cnote The signature of this function is that of a PSA driver\0A *       aead_decrypt entry point. This function behaves as an aead_decrypt\0A *       entry point as defined in the PSA driver interface specification for\0A *       transparent drivers.\0A *\0A * \5Cparam[in]  attributes         The attributes of the key to use for the\0A *                                operation.\0A * \5Cparam[in]  key_buffer         The buffer containing the key context.\0A * \5Cparam      key_buffer_size    Size of the \5Cp key_buffer buffer in bytes.\0A * \5Cparam      alg                The AEAD algorithm to compute.\0A * \5Cparam[in]  nonce              Nonce or IV to use.\0A * \5Cparam      nonce_length       Size of the nonce buffer in bytes. This must\0A *                                be appropriate for the selected algorithm.\0A *                                The default nonce size is\0A *                                PSA_AEAD_NONCE_LENGTH(key_type, alg) where\0A *                                key_type is the type of key.\0A * \5Cparam[in]  additional_data    Additional data that has been authenticated\0A *                                but not encrypted.\0A * \5Cparam      additional_data_length  Size of additional_data in bytes.\0A * \5Cparam[in]  ciphertext         Data that has been authenticated and\0A *                                encrypted. For algorithms where the encrypted\0A *                                data and the authentication tag are defined\0A *                                as separate inputs, the buffer contains\0A *                                encrypted data followed by the authentication\0A *                                tag.\0A * \5Cparam      ciphertext_length  Size of ciphertext in bytes.\0A * \5Cparam[out] plaintext          Output buffer for the decrypted data.\0A * \5Cparam      plaintext_size     Size of the plaintext buffer in bytes. This\0A *                                must be appropriate for the selected algorithm\0A *                                and key:\0A *                                - A sufficient output size is\0A *                                  PSA_AEAD_DECRYPT_OUTPUT_SIZE(key_type, alg,\0A *                                  ciphertext_length) where key_type is the\0A *                                  type of key.\0A *                                - PSA_AEAD_DECRYPT_OUTPUT_MAX_SIZE(\0A *                                  ciphertext_length) evaluates to the maximum\0A *                                  plaintext size of any supported AEAD\0A *                                  decryption.\0A * \5Cparam[out] plaintext_length   On success, the size of the output in the\0A *                                plaintext buffer.\0A *\0A * \5Cretval #PSA_SUCCESS Success.\0A * \5Cretval #PSA_ERROR_INVALID_SIGNATURE\0A *         The cipher is not authentic.\0A * \5Cretval #PSA_ERROR_NOT_SUPPORTED\0A *         \5Cp alg is not supported.\0A * \5Cretval #PSA_ERROR_INSUFFICIENT_MEMORY \5Cemptydescription\0A * \5Cretval #PSA_ERROR_BUFFER_TOO_SMALL\0A *         plaintext_size is too small.\0A * \5Cretval #PSA_ERROR_CORRUPTION_DETECTED \5Cemptydescription\0A */\0Apsa_status_t mbedtls_psa_aead_decrypt(\0A    const psa_key_attributes_t *attributes,\0A    const uint8_t *key_buffer, size_t key_buffer_size,\0A    psa_algorithm_t alg,\0A    const uint8_t *nonce, size_t nonce_length,\0A    const uint8_t *additional_data, size_t additional_data_length,\0A    const uint8_t *ciphertext, size_t ciphertext_length,\0A    uint8_t *plaintext, size_t plaintext_size, size_t *plaintext_length);\0A\0A/** Set the key for a multipart authenticated encryption operation.\0A *\0A *  \5Cnote The signature of this function is that of a PSA driver\0A *       aead_encrypt_setup entry point. This function behaves as an\0A *       aead_encrypt_setup entry point as defined in the PSA driver interface\0A *       specification for transparent drivers.\0A *\0A * If an error occurs at any step after a call to\0A * mbedtls_psa_aead_encrypt_setup(), the operation is reset by the PSA core by a\0A * call to mbedtls_psa_aead_abort(). The PSA core may call\0A * mbedtls_psa_aead_abort() at any time after the operation has been\0A * initialized, and is required to when the operation is no longer needed.\0A *\0A * \5Cparam[in,out] operation     The operation object to set up. It must have\0A *                              been initialized as per the documentation for\0A *                              #mbedtls_psa_aead_operation_t and not yet in\0A *                              use.\0A * \5Cparam[in]  attributes       The attributes of the key to use for the\0A *                              operation.\0A * \5Cparam[in]  key_buffer       The buffer containing the key context.\0A * \5Cparam      key_buffer_size  Size of the \5Cp key_buffer buffer in bytes.\0A                                It must be consistent with the size in bits\0A                                recorded in \5Cp attributes.\0A * \5Cparam alg                   The AEAD algorithm to compute\0A *                              (\5Cc PSA_ALG_XXX value such that\0A *                              #PSA_ALG_IS_AEAD(\5Cp alg) is true).\0A *\0A * \5Cretval #PSA_SUCCESS\0A *         Success.\0A * \5Cretval #PSA_ERROR_INVALID_ARGUMENT\0A *         An invalid block length was supplied.\0A * \5Cretval #PSA_ERROR_NOT_SUPPORTED\0A *         \5Cp alg is not supported.\0A * \5Cretval #PSA_ERROR_INSUFFICIENT_MEMORY\0A *         Failed to allocate memory for key material\0A */\0Apsa_status_t mbedtls_psa_aead_encrypt_setup(\0A    mbedtls_psa_aead_operation_t *operation,\0A    const psa_key_attributes_t *attributes,\0A    const uint8_t *key_buffer,\0A    size_t key_buffer_size,\0A    psa_algorithm_t alg);\0A\0A/** Set the key for a multipart authenticated decryption operation.\0A *\0A * \5Cnote The signature of this function is that of a PSA driver\0A *       aead_decrypt_setup entry point. This function behaves as an\0A *       aead_decrypt_setup entry point as defined in the PSA driver interface\0A *       specification for transparent drivers.\0A *\0A * If an error occurs at any step after a call to\0A * mbedtls_psa_aead_decrypt_setup(), the PSA core resets the operation by a\0A * call to mbedtls_psa_aead_abort(). The PSA core may call\0A * mbedtls_psa_aead_abort() at any time after the operation has been\0A * initialized, and is required to when the operation is no longer needed.\0A *\0A * \5Cparam[in,out] operation     The operation object to set up. It must have\0A *                              been initialized as per the documentation for\0A *                              #mbedtls_psa_aead_operation_t and not yet in\0A *                              use.\0A * \5Cparam[in]  attributes       The attributes of the key to use for the\0A *                              operation.\0A * \5Cparam[in]  key_buffer       The buffer containing the key context.\0A * \5Cparam      key_buffer_size  Size of the \5Cp key_buffer buffer in bytes.\0A                                It must be consistent with the size in bits\0A                                recorded in \5Cp attributes.\0A * \5Cparam alg                   The AEAD algorithm to compute\0A *                              (\5Cc PSA_ALG_XXX value such that\0A *                              #PSA_ALG_IS_AEAD(\5Cp alg) is true).\0A *\0A * \5Cretval #PSA_SUCCESS\0A *         Success.\0A * \5Cretval #PSA_ERROR_INVALID_ARGUMENT\0A *         An invalid block length was supplied.\0A * \5Cretval #PSA_ERROR_NOT_SUPPORTED\0A *         \5Cp alg is not supported.\0A * \5Cretval #PSA_ERROR_INSUFFICIENT_MEMORY\0A *         Failed to allocate memory for key material\0A */\0Apsa_status_t mbedtls_psa_aead_decrypt_setup(\0A    mbedtls_psa_aead_operation_t *operation,\0A    const psa_key_attributes_t *attributes,\0A    const uint8_t *key_buffer,\0A    size_t key_buffer_size,\0A    psa_algorithm_t alg);\0A\0A/** Set the nonce for an authenticated encryption or decryption operation.\0A *\0A * \5Cnote The signature of this function is that of a PSA driver aead_set_nonce\0A *       entry point. This function behaves as an aead_set_nonce entry point as\0A *       defined in the PSA driver interface specification for transparent\0A *       drivers.\0A *\0A * This function sets the nonce for the authenticated\0A * encryption or decryption operation.\0A *\0A * The PSA core calls mbedtls_psa_aead_encrypt_setup() or\0A * mbedtls_psa_aead_decrypt_setup() before calling this function.\0A *\0A * If this function returns an error status, the PSA core will call\0A * mbedtls_psa_aead_abort().\0A *\0A * \5Cparam[in,out] operation     Active AEAD operation.\0A * \5Cparam[in] nonce             Buffer containing the nonce to use.\0A * \5Cparam nonce_length          Size of the nonce in bytes.\0A *\0A * \5Cretval #PSA_SUCCESS\0A *         Success.\0A * \5Cretval #PSA_ERROR_INVALID_ARGUMENT\0A *         The size of \5Cp nonce is not acceptable for the chosen algorithm.\0A * \5Cretval #PSA_ERROR_NOT_SUPPORTED\0A *         Algorithm previously set is not supported in this configuration of\0A *         the library.\0A */\0Apsa_status_t mbedtls_psa_aead_set_nonce(\0A    mbedtls_psa_aead_operation_t *operation,\0A    const uint8_t *nonce,\0A    size_t nonce_length);\0A\0A/** Declare the lengths of the message and additional data for AEAD.\0A *\0A * \5Cnote The signature of this function is that of a PSA driver aead_set_lengths\0A *       entry point. This function behaves as an aead_set_lengths entry point\0A *       as defined in the PSA driver interface specification for transparent\0A *       drivers.\0A *\0A * The PSA core calls this function before calling mbedtls_psa_aead_update_ad()\0A * or mbedtls_psa_aead_update() if the algorithm for the operation requires it.\0A * If the algorithm does not require it, calling this function is optional, but\0A * if this function is called then the implementation must enforce the lengths.\0A *\0A * The PSA core may call this function before or after setting the nonce with\0A * mbedtls_psa_aead_set_nonce().\0A *\0A * - For #PSA_ALG_CCM, calling this function is required.\0A * - For the other AEAD algorithms defined in this specification, calling\0A *   this function is not required.\0A *\0A * If this function returns an error status, the PSA core calls\0A * mbedtls_psa_aead_abort().\0A *\0A * \5Cparam[in,out] operation     Active AEAD operation.\0A * \5Cparam ad_length             Size of the non-encrypted additional\0A *                              authenticated data in bytes.\0A * \5Cparam plaintext_length      Size of the plaintext to encrypt in bytes.\0A *\0A * \5Cretval #PSA_SUCCESS\0A *         Success.\0A * \5Cretval #PSA_ERROR_INVALID_ARGUMENT\0A *         At least one of the lengths is not acceptable for the chosen\0A *         algorithm.\0A * \5Cretval #PSA_ERROR_NOT_SUPPORTED\0A *         Algorithm previously set is not supported in this configuration of\0A *         the library.\0A */\0Apsa_status_t mbedtls_psa_aead_set_lengths(\0A    mbedtls_psa_aead_operation_t *operation,\0A    size_t ad_length,\0A    size_t plaintext_length);\0A\0A/** Pass additional data to an active AEAD operation.\0A *\0A *  \5Cnote The signature of this function is that of a PSA driver\0A *       aead_update_ad entry point. This function behaves as an aead_update_ad\0A *       entry point as defined in the PSA driver interface specification for\0A *       transparent drivers.\0A *\0A * Additional data is authenticated, but not encrypted.\0A *\0A * The PSA core can call this function multiple times to pass successive\0A * fragments of the additional data. It will not call this function after\0A * passing data to encrypt or decrypt with mbedtls_psa_aead_update().\0A *\0A * Before calling this function, the PSA core will:\0A *    1. Call either mbedtls_psa_aead_encrypt_setup() or\0A *       mbedtls_psa_aead_decrypt_setup().\0A *    2. Set the nonce with mbedtls_psa_aead_set_nonce().\0A *\0A * If this function returns an error status, the PSA core will call\0A * mbedtls_psa_aead_abort().\0A *\0A * \5Cparam[in,out] operation     Active AEAD operation.\0A * \5Cparam[in] input             Buffer containing the fragment of\0A *                              additional data.\0A * \5Cparam input_length          Size of the \5Cp input buffer in bytes.\0A *\0A * \5Cretval #PSA_SUCCESS\0A *         Success.\0A * \5Cretval #PSA_ERROR_NOT_SUPPORTED\0A *         Algorithm previously set is not supported in this configuration of\0A *         the library.\0A */\0Apsa_status_t mbedtls_psa_aead_update_ad(\0A    mbedtls_psa_aead_operation_t *operation,\0A    const uint8_t *input,\0A    size_t input_length);\0A\0A/** Encrypt or decrypt a message fragment in an active AEAD operation.\0A *\0A *  \5Cnote The signature of this function is that of a PSA driver\0A *       aead_update entry point. This function behaves as an aead_update entry\0A *       point as defined in the PSA driver interface specification for\0A *       transparent drivers.\0A *\0A * Before calling this function, the PSA core will:\0A *    1. Call either mbedtls_psa_aead_encrypt_setup() or\0A *       mbedtls_psa_aead_decrypt_setup(). The choice of setup function\0A *       determines whether this function encrypts or decrypts its input.\0A *    2. Set the nonce with mbedtls_psa_aead_set_nonce().\0A *    3. Call mbedtls_psa_aead_update_ad() to pass all the additional data.\0A *\0A * If this function returns an error status, the PSA core will call\0A * mbedtls_psa_aead_abort().\0A *\0A * This function does not require the input to be aligned to any\0A * particular block boundary. If the implementation can only process\0A * a whole block at a time, it must consume all the input provided, but\0A * it may delay the end of the corresponding output until a subsequent\0A * call to mbedtls_psa_aead_update(), mbedtls_psa_aead_finish() provides\0A * sufficient input. The amount of data that can be delayed in this way is\0A * bounded by #PSA_AEAD_UPDATE_OUTPUT_SIZE.\0A *\0A * \5Cparam[in,out] operation     Active AEAD operation.\0A * \5Cparam[in] input             Buffer containing the message fragment to\0A *                              encrypt or decrypt.\0A * \5Cparam input_length          Size of the \5Cp input buffer in bytes.\0A * \5Cparam[out] output           Buffer where the output is to be written.\0A * \5Cparam output_size           Size of the \5Cp output buffer in bytes.\0A *                              This must be appropriate for the selected\0A *                                algorithm and key:\0A *                                - A sufficient output size is\0A *                                  #PSA_AEAD_UPDATE_OUTPUT_SIZE(\5Cc key_type,\0A *                                  \5Cc alg, \5Cp input_length) where\0A *                                  \5Cc key_type is the type of key and \5Cc alg is\0A *                                  the algorithm that were used to set up the\0A *                                  operation.\0A *                                - #PSA_AEAD_UPDATE_OUTPUT_MAX_SIZE(\5Cp\0A *                                  input_length) evaluates to the maximum\0A *                                  output size of any supported AEAD\0A *                                  algorithm.\0A * \5Cparam[out] output_length    On success, the number of bytes\0A *                              that make up the returned output.\0A *\0A * \5Cretval #PSA_SUCCESS\0A *         Success.\0A *\0A * \5Cretval #PSA_ERROR_BUFFER_TOO_SMALL\0A *         The size of the \5Cp output buffer is too small.\0A *         #PSA_AEAD_UPDATE_OUTPUT_SIZE(\5Cc key_type, \5Cc alg, \5Cp input_length) or\0A *         #PSA_AEAD_UPDATE_OUTPUT_MAX_SIZE(\5Cp input_length) can be used to\0A *         determine the required buffer size.\0A */\0Apsa_status_t mbedtls_psa_aead_update(\0A    mbedtls_psa_aead_operation_t *operation,\0A    const uint8_t *input,\0A    size_t input_length,\0A    uint8_t *output,\0A    size_t output_size,\0A    size_t *output_length);\0A\0A/** Finish encrypting a message in an AEAD operation.\0A *\0A *  \5Cnote The signature of this function is that of a PSA driver\0A *       aead_finish entry point. This function behaves as an aead_finish entry\0A *       point as defined in the PSA driver interface specification for\0A *       transparent drivers.\0A *\0A * The operation must have been set up by the PSA core with\0A * mbedtls_psa_aead_encrypt_setup().\0A *\0A * This function finishes the authentication of the additional data\0A * formed by concatenating the inputs passed to preceding calls to\0A * mbedtls_psa_aead_update_ad() with the plaintext formed by concatenating the\0A * inputs passed to preceding calls to mbedtls_psa_aead_update().\0A *\0A * This function has two output buffers:\0A * - \5Cp ciphertext contains trailing ciphertext that was buffered from\0A *   preceding calls to mbedtls_psa_aead_update().\0A * - \5Cp tag contains the authentication tag.\0A *\0A * Whether or not this function returns successfully, the PSA core subsequently\0A * calls mbedtls_psa_aead_abort() to deactivate the operation.\0A *\0A * \5Cparam[in,out] operation     Active AEAD operation.\0A * \5Cparam[out] ciphertext       Buffer where the last part of the ciphertext\0A *                              is to be written.\0A * \5Cparam ciphertext_size       Size of the \5Cp ciphertext buffer in bytes.\0A *                              This must be appropriate for the selected\0A *                              algorithm and key:\0A *                              - A sufficient output size is\0A *                                #PSA_AEAD_FINISH_OUTPUT_SIZE(\5Cc key_type,\0A *                                \5Cc alg) where \5Cc key_type is the type of key\0A *                                and \5Cc alg is the algorithm that were used to\0A *                                set up the operation.\0A *                              - #PSA_AEAD_FINISH_OUTPUT_MAX_SIZE evaluates to\0A *                                the maximum output size of any supported AEAD\0A *                                algorithm.\0A * \5Cparam[out] ciphertext_length On success, the number of bytes of\0A *                              returned ciphertext.\0A * \5Cparam[out] tag              Buffer where the authentication tag is\0A *                              to be written.\0A * \5Cparam tag_size              Size of the \5Cp tag buffer in bytes.\0A *                              This must be appropriate for the selected\0A *                              algorithm and key:\0A *                              - The exact tag size is #PSA_AEAD_TAG_LENGTH(\5Cc\0A *                                key_type, \5Cc key_bits, \5Cc alg) where\0A *                                \5Cc key_type and \5Cc key_bits are the type and\0A *                                bit-size of the key, and \5Cc alg are the\0A *                                algorithm that were used in the call to\0A *                                mbedtls_psa_aead_encrypt_setup().\0A *                              - #PSA_AEAD_TAG_MAX_SIZE evaluates to the\0A *                                maximum tag size of any supported AEAD\0A *                                algorithm.\0A * \5Cparam[out] tag_length       On success, the number of bytes\0A *                              that make up the returned tag.\0A *\0A * \5Cretval #PSA_SUCCESS\0A *         Success.\0A * \5Cretval #PSA_ERROR_BUFFER_TOO_SMALL\0A *         The size of the \5Cp tag buffer is too small.\0A *         #PSA_AEAD_TAG_LENGTH(\5Cc key_type, key_bits, \5Cc alg) or\0A *         #PSA_AEAD_TAG_MAX_SIZE can be used to determine the required \5Cp tag\0A *         buffer size.\0A */\0Apsa_status_t mbedtls_psa_aead_finish(\0A    mbedtls_psa_aead_operation_t *operation,\0A    uint8_t *ciphertext,\0A    size_t ciphertext_size,\0A    size_t *ciphertext_length,\0A    uint8_t *tag,\0A    size_t tag_size,\0A    size_t *tag_length);\0A\0A/** Abort an AEAD operation.\0A *\0A *  \5Cnote The signature of this function is that of a PSA driver\0A *       aead_abort entry point. This function behaves as an aead_abort entry\0A *       point as defined in the PSA driver interface specification for\0A *       transparent drivers.\0A *\0A * Aborting an operation frees all associated resources except for the\0A * \5Cp operation structure itself. Once aborted, the operation object\0A * can be reused for another operation by the PSA core by it calling\0A * mbedtls_psa_aead_encrypt_setup() or mbedtls_psa_aead_decrypt_setup() again.\0A *\0A * The PSA core may call this function any time after the operation object has\0A * been initialized as described in #mbedtls_psa_aead_operation_t.\0A *\0A * In particular, calling mbedtls_psa_aead_abort() after the operation has been\0A * terminated by a call to mbedtls_psa_aead_abort() or\0A * mbedtls_psa_aead_finish() is safe and has no effect.\0A *\0A * \5Cparam[in,out] operation     Initialized AEAD operation.\0A *\0A * \5Cretval #PSA_SUCCESS\0A *         Success.\0A */\0Apsa_status_t mbedtls_psa_aead_abort(\0A    mbedtls_psa_aead_operation_t *operation);\0A\0A#endif /* PSA_CRYPTO_AEAD_H */\0A\00" }
@.const39906 = private global <{ i64, ptr, ptr, i1, [7 x i8] }> <{ i64 -1, ptr @.str39902, ptr @.str39904, i1 0, [7 x i8] zeroinitializer }>
