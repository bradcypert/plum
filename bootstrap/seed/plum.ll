@.str45121 = private global { i64, i64, [40205 x i8] } { i64 -1, i64 40204, [40205 x i8] c"/**\0A * \5Cfile oid.h\0A *\0A * \5Cbrief Object Identifier (OID) database\0A */\0A/*\0A *  Copyright The Mbed TLS Contributors\0A *  SPDX-License-Identifier: Apache-2.0 OR GPL-2.0-or-later\0A */\0A#ifndef MBEDTLS_OID_H\0A#define MBEDTLS_OID_H\0A#include \22mbedtls/private_access.h\22\0A\0A#include \22mbedtls/build_info.h\22\0A\0A#include \22mbedtls/asn1.h\22\0A#include \22mbedtls/pk.h\22\0A\0A#include <stddef.h>\0A\0A#if defined(MBEDTLS_CIPHER_C)\0A#include \22mbedtls/cipher.h\22\0A#endif\0A\0A#include \22mbedtls/md.h\22\0A\0A/** OID is not found. */\0A#define MBEDTLS_ERR_OID_NOT_FOUND                         -0x002E\0A/** output buffer is too small */\0A#define MBEDTLS_ERR_OID_BUF_TOO_SMALL                     -0x000B\0A\0A/* This is for the benefit of X.509, but defined here in order to avoid\0A * having a \22backwards\22 include of x.509.h here */\0A/*\0A * X.509 extension types (internal, arbitrary values for bitsets)\0A */\0A#define MBEDTLS_OID_X509_EXT_AUTHORITY_KEY_IDENTIFIER    (1 << 0)\0A#define MBEDTLS_OID_X509_EXT_SUBJECT_KEY_IDENTIFIER      (1 << 1)\0A#define MBEDTLS_OID_X509_EXT_KEY_USAGE                   (1 << 2)\0A#define MBEDTLS_OID_X509_EXT_CERTIFICATE_POLICIES        (1 << 3)\0A#define MBEDTLS_OID_X509_EXT_POLICY_MAPPINGS             (1 << 4)\0A#define MBEDTLS_OID_X509_EXT_SUBJECT_ALT_NAME            (1 << 5)\0A#define MBEDTLS_OID_X509_EXT_ISSUER_ALT_NAME             (1 << 6)\0A#define MBEDTLS_OID_X509_EXT_SUBJECT_DIRECTORY_ATTRS     (1 << 7)\0A#define MBEDTLS_OID_X509_EXT_BASIC_CONSTRAINTS           (1 << 8)\0A#define MBEDTLS_OID_X509_EXT_NAME_CONSTRAINTS            (1 << 9)\0A#define MBEDTLS_OID_X509_EXT_POLICY_CONSTRAINTS          (1 << 10)\0A#define MBEDTLS_OID_X509_EXT_EXTENDED_KEY_USAGE          (1 << 11)\0A#define MBEDTLS_OID_X509_EXT_CRL_DISTRIBUTION_POINTS     (1 << 12)\0A#define MBEDTLS_OID_X509_EXT_INIHIBIT_ANYPOLICY          (1 << 13)\0A#define MBEDTLS_OID_X509_EXT_FRESHEST_CRL                (1 << 14)\0A#define MBEDTLS_OID_X509_EXT_NS_CERT_TYPE                (1 << 16)\0A\0A/*\0A * Maximum number of OID components allowed\0A */\0A#define MBEDTLS_OID_MAX_COMPONENTS              128\0A\0A/*\0A * Top level OID tuples\0A */\0A#define MBEDTLS_OID_ISO_MEMBER_BODIES           \22\5Cx2a\22          /* {iso(1) member-body(2)} */\0A#define MBEDTLS_OID_ISO_IDENTIFIED_ORG          \22\5Cx2b\22          /* {iso(1) identified-organization(3)} */\0A#define MBEDTLS_OID_ISO_CCITT_DS                \22\5Cx55\22          /* {joint-iso-ccitt(2) ds(5)} */\0A#define MBEDTLS_OID_ISO_ITU_COUNTRY             \22\5Cx60\22          /* {joint-iso-itu-t(2) country(16)} */\0A\0A/*\0A * ISO Member bodies OID parts\0A */\0A#define MBEDTLS_OID_COUNTRY_US                  \22\5Cx86\5Cx48\22      /* {us(840)} */\0A#define MBEDTLS_OID_ORG_RSA_DATA_SECURITY       \22\5Cx86\5Cxf7\5Cx0d\22  /* {rsadsi(113549)} */\0A#define MBEDTLS_OID_RSA_COMPANY                 MBEDTLS_OID_ISO_MEMBER_BODIES MBEDTLS_OID_COUNTRY_US \5C\0A        MBEDTLS_OID_ORG_RSA_DATA_SECURITY                                 /* {iso(1) member-body(2) us(840) rsadsi(113549)} */\0A#define MBEDTLS_OID_ORG_ANSI_X9_62              \22\5Cxce\5Cx3d\22 /* ansi-X9-62(10045) */\0A#define MBEDTLS_OID_ANSI_X9_62                  MBEDTLS_OID_ISO_MEMBER_BODIES MBEDTLS_OID_COUNTRY_US \5C\0A        MBEDTLS_OID_ORG_ANSI_X9_62\0A\0A/*\0A * ISO Identified organization OID parts\0A */\0A#define MBEDTLS_OID_ORG_DOD                     \22\5Cx06\22          /* {dod(6)} */\0A#define MBEDTLS_OID_ORG_OIW                     \22\5Cx0e\22\0A#define MBEDTLS_OID_OIW_SECSIG                  MBEDTLS_OID_ORG_OIW \22\5Cx03\22\0A#define MBEDTLS_OID_OIW_SECSIG_ALG              MBEDTLS_OID_OIW_SECSIG \22\5Cx02\22\0A#define MBEDTLS_OID_OIW_SECSIG_SHA1             MBEDTLS_OID_OIW_SECSIG_ALG \22\5Cx1a\22\0A#define MBEDTLS_OID_ORG_THAWTE                  \22\5Cx65\22          /* thawte(101) */\0A#define MBEDTLS_OID_THAWTE                      MBEDTLS_OID_ISO_IDENTIFIED_ORG \5C\0A        MBEDTLS_OID_ORG_THAWTE\0A#define MBEDTLS_OID_ORG_CERTICOM                \22\5Cx81\5Cx04\22  /* certicom(132) */\0A#define MBEDTLS_OID_CERTICOM                    MBEDTLS_OID_ISO_IDENTIFIED_ORG \5C\0A        MBEDTLS_OID_ORG_CERTICOM\0A#define MBEDTLS_OID_ORG_TELETRUST               \22\5Cx24\22 /* teletrust(36) */\0A#define MBEDTLS_OID_TELETRUST                   MBEDTLS_OID_ISO_IDENTIFIED_ORG \5C\0A        MBEDTLS_OID_ORG_TELETRUST\0A\0A/*\0A * ISO ITU OID parts\0A */\0A#define MBEDTLS_OID_ORGANIZATION                \22\5Cx01\22          /* {organization(1)} */\0A#define MBEDTLS_OID_ISO_ITU_US_ORG              MBEDTLS_OID_ISO_ITU_COUNTRY MBEDTLS_OID_COUNTRY_US \5C\0A        MBEDTLS_OID_ORGANIZATION                                                                                            /* {joint-iso-itu-t(2) country(16) us(840) organization(1)} */\0A\0A#define MBEDTLS_OID_ORG_GOV                     \22\5Cx65\22          /* {gov(101)} */\0A#define MBEDTLS_OID_GOV                         MBEDTLS_OID_ISO_ITU_US_ORG MBEDTLS_OID_ORG_GOV /* {joint-iso-itu-t(2) country(16) us(840) organization(1) gov(101)} */\0A\0A#define MBEDTLS_OID_ORG_NETSCAPE                \22\5Cx86\5CxF8\5Cx42\22  /* {netscape(113730)} */\0A#define MBEDTLS_OID_NETSCAPE                    MBEDTLS_OID_ISO_ITU_US_ORG MBEDTLS_OID_ORG_NETSCAPE /* Netscape OID {joint-iso-itu-t(2) country(16) us(840) organization(1) netscape(113730)} */\0A\0A/* ISO arc for standard certificate and CRL extensions */\0A#define MBEDTLS_OID_ID_CE                       MBEDTLS_OID_ISO_CCITT_DS \22\5Cx1D\22 /**< id-ce OBJECT IDENTIFIER  ::=  {joint-iso-ccitt(2) ds(5) 29} */\0A\0A#define MBEDTLS_OID_NIST_ALG                    MBEDTLS_OID_GOV \22\5Cx03\5Cx04\22 /** { joint-iso-itu-t(2) country(16) us(840) organization(1) gov(101) csor(3) nistAlgorithm(4) */\0A\0A/**\0A * Private Internet Extensions\0A * { iso(1) identified-organization(3) dod(6) internet(1)\0A *                      security(5) mechanisms(5) pkix(7) }\0A */\0A#define MBEDTLS_OID_INTERNET                    MBEDTLS_OID_ISO_IDENTIFIED_ORG MBEDTLS_OID_ORG_DOD \5C\0A    \22\5Cx01\22\0A#define MBEDTLS_OID_PKIX                        MBEDTLS_OID_INTERNET \22\5Cx05\5Cx05\5Cx07\22\0A\0A/*\0A * Arc for standard naming attributes\0A */\0A#define MBEDTLS_OID_AT                          MBEDTLS_OID_ISO_CCITT_DS \22\5Cx04\22 /**< id-at OBJECT IDENTIFIER ::= {joint-iso-ccitt(2) ds(5) 4} */\0A#define MBEDTLS_OID_AT_CN                       MBEDTLS_OID_AT \22\5Cx03\22 /**< id-at-commonName AttributeType:= {id-at 3} */\0A#define MBEDTLS_OID_AT_SUR_NAME                 MBEDTLS_OID_AT \22\5Cx04\22 /**< id-at-surName AttributeType:= {id-at 4} */\0A#define MBEDTLS_OID_AT_SERIAL_NUMBER            MBEDTLS_OID_AT \22\5Cx05\22 /**< id-at-serialNumber AttributeType:= {id-at 5} */\0A#define MBEDTLS_OID_AT_COUNTRY                  MBEDTLS_OID_AT \22\5Cx06\22 /**< id-at-countryName AttributeType:= {id-at 6} */\0A#define MBEDTLS_OID_AT_LOCALITY                 MBEDTLS_OID_AT \22\5Cx07\22 /**< id-at-locality AttributeType:= {id-at 7} */\0A#define MBEDTLS_OID_AT_STATE                    MBEDTLS_OID_AT \22\5Cx08\22 /**< id-at-state AttributeType:= {id-at 8} */\0A#define MBEDTLS_OID_AT_ORGANIZATION             MBEDTLS_OID_AT \22\5Cx0A\22 /**< id-at-organizationName AttributeType:= {id-at 10} */\0A#define MBEDTLS_OID_AT_ORG_UNIT                 MBEDTLS_OID_AT \22\5Cx0B\22 /**< id-at-organizationalUnitName AttributeType:= {id-at 11} */\0A#define MBEDTLS_OID_AT_TITLE                    MBEDTLS_OID_AT \22\5Cx0C\22 /**< id-at-title AttributeType:= {id-at 12} */\0A#define MBEDTLS_OID_AT_POSTAL_ADDRESS           MBEDTLS_OID_AT \22\5Cx10\22 /**< id-at-postalAddress AttributeType:= {id-at 16} */\0A#define MBEDTLS_OID_AT_POSTAL_CODE              MBEDTLS_OID_AT \22\5Cx11\22 /**< id-at-postalCode AttributeType:= {id-at 17} */\0A#define MBEDTLS_OID_AT_GIVEN_NAME               MBEDTLS_OID_AT \2