@.str42371 = private global { i64, i64, [19602 x i8] } { i64 -1, i64 19601, [19602 x i8] c"/**\0A *  Low-level modular bignum functions\0A *\0A *  This interface should only be used by the higher-level modular bignum\0A *  module (bignum_mod.c) and the ECP module (ecp.c, ecp_curves.c). All other\0A *  modules should use the high-level modular bignum interface (bignum_mod.h)\0A *  or the legacy bignum interface (bignum.h).\0A *\0A * This is a low-level interface to operations on integers modulo which\0A * has no protection against passing invalid arguments such as arrays of\0A * the wrong size. The functions in bignum_mod.h provide a higher-level\0A * interface that includes protections against accidental misuse, at the\0A * expense of code size and sometimes more cumbersome memory management.\0A *\0A * The functions in this module obey the following conventions unless\0A * explicitly indicated otherwise:\0A * - **Modulus parameters**: the modulus is passed as a pointer to a structure\0A *   of type #mbedtls_mpi_mod_modulus. The structure must be set up with an\0A *   array of limbs storing the bignum value of the modulus. The modulus must\0A *   be odd and is assumed to have no leading zeroes. The modulus is usually\0A *   named \5Cc N and is usually input-only.\0A * - **Bignum parameters**: Bignums are passed as pointers to an array of\0A *   limbs. A limb has the type #mbedtls_mpi_uint. Unless otherwise specified:\0A *     - Bignum parameters called \5Cc A, \5Cc B, ... are inputs, and are not\0A *       modified by the function.\0A *     - Bignum parameters called \5Cc X, \5Cc Y are outputs or input-output.\0A *       The initial content of output-only parameters is ignored.\0A *     - \5Cc T is a temporary storage area. The initial content of such a\0A *       parameter is ignored and the final content is unspecified.\0A * - **Bignum sizes**: bignum sizes are usually expressed by the \5Cc limbs\0A *   member of the modulus argument. All bignum parameters must have the same\0A *   number of limbs as the modulus. All bignum sizes must be at least 1 and\0A *   must be significantly less than #SIZE_MAX. The behavior if a size is 0 is\0A *   undefined.\0A * - **Bignum representation**: the representation of inputs and outputs is\0A *   specified by the \5Cc int_rep field of the modulus for arithmetic\0A *   functions. Utility functions may allow for different representation.\0A * - **Parameter ordering**: for bignum parameters, outputs come before inputs.\0A *   The modulus is passed after other bignum input parameters. Temporaries\0A *   come last.\0A * - **Aliasing**: in general, output bignums may be aliased to one or more\0A *   inputs. Modulus values may not be aliased to any other parameter. Outputs\0A *   may not be aliased to one another. Temporaries may not be aliased to any\0A *   other parameter.\0A * - **Overlap**: apart from aliasing of limb array pointers (where two\0A *   arguments are equal pointers), overlap is not supported and may result\0A *   in undefined behavior.\0A * - **Error handling**: This is a low-level module. Functions generally do not\0A *   try to protect against invalid arguments such as nonsensical sizes or\0A *   null pointers. Note that passing bignums with a different size than the\0A *   modulus may lead to buffer overflows. Some functions which allocate\0A *   memory or handle reading/writing of bignums will return an error if\0A *   memory allocation fails or if buffer sizes are invalid.\0A * - **Modular representatives**: all functions expect inputs to be in the\0A *   range [0, \5Cc N - 1] and guarantee outputs in the range [0, \5Cc N - 1]. If\0A *   an input is out of range, outputs are fully unspecified, though bignum\0A *   values out of range should not cause buffer overflows (beware that this is\0A *   not extensively tested).\0A */\0A\0A/*\0A *  Copyright The Mbed TLS Contributors\0A *  SPDX-License-Identifier: Apache-2.0 OR GPL-2.0-or-later\0A */\0A\0A#ifndef MBEDTLS_BIGNUM_MOD_RAW_H\0A#define MBEDTLS_BIGNUM_MOD_RAW_H\0A\0A#include \22common.h\22\0A\0A#if defined(MBEDTLS_BIGNUM_C)\0A#include \22mbedtls/bignum.h\22\0A#endif\0A\0A#include \22bignum_mod.h\22\0A\0A/**\0A * \5Cbrief   Perform a safe conditional copy of an MPI which doesn't reveal\0A *          whether the assignment was done or not.\0A *\0A * The size to copy is determined by \5Cp N.\0A *\0A * \5Cparam[out] X        The address of the destination MPI.\0A *                      This must be initialized. Must have enough limbs to\0A *                      store the full value of \5Cp A.\0A * \5Cparam[in]  A        The address of the source MPI. This must be initialized.\0A * \5Cparam[in]  N        The address of the modulus related to \5Cp X and \5Cp A.\0A * \5Cparam      assign   The condition deciding whether to perform the\0A *                      assignment or not. Must be either 0 or 1:\0A *                      * \5Cc 1: Perform the assignment `X = A`.\0A *                      * \5Cc 0: Keep the original value of \5Cp X.\0A *\0A * \5Cnote           This function avoids leaking any information about whether\0A *                 the assignment was done or not.\0A *\0A * \5Cwarning        If \5Cp assign is neither 0 nor 1, the result of this function\0A *                 is indeterminate, and the resulting value in \5Cp X might be\0A *                 neither its original value nor the value in \5Cp A.\0A */\0Avoid mbedtls_mpi_mod_raw_cond_assign(mbedtls_mpi_uint *X,\0A                                     const mbedtls_mpi_uint *A,\0A                                     const mbedtls_mpi_mod_modulus *N,\0A                                     unsigned char assign);\0A\0A/**\0A * \5Cbrief   Perform a safe conditional swap of two MPIs which doesn't reveal\0A *          whether the swap was done or not.\0A *\0A * The size to swap is determined by \5Cp N.\0A *\0A * \5Cparam[in,out] X     The address of the first MPI. This must be initialized.\0A * \5Cparam[in,out] Y     The address of the second MPI. This must be initialized.\0A * \5Cparam[in]     N     The address of the modulus related to \5Cp X and \5Cp Y.\0A * \5Cparam         swap  The condition deciding whether to perform\0A *                      the swap or not. Must be either 0 or 1:\0A *                      * \5Cc 1: Swap the values of \5Cp X and \5Cp Y.\0A *                      * \5Cc 0: Keep the original values of \5Cp X and \5Cp Y.\0A *\0A * \5Cnote           This function avoids leaking any information about whether\0A *                 the swap was done or not.\0A *\0A * \5Cwarning        If \5Cp swap is neither 0 nor 1, the result of this function\0A *                 is indeterminate, and both \5Cp X and \5Cp Y might end up with\0A *                 values different to either of the original ones.\0A */\0Avoid mbedtls_mpi_mod_raw_cond_swap(mbedtls_mpi_uint *X,\0A                                   mbedtls_mpi_uint *Y,\0A                                   const mbedtls_mpi_mod_modulus *N,\0A                                   unsigned char swap);\0A\0A/** Import X from unsigned binary data.\0A *\0A * The MPI needs to have enough limbs to store the full value (including any\0A * most significant zero bytes in the input).\0A *\0A * \5Cparam[out] X        The address of the MPI. The size is determined by \5Cp N.\0A *                      (In particular, it must have at least as many limbs as\0A *                      the modulus \5Cp N.)\0A * \5Cparam[in] N         The address of the modulus related to \5Cp X.\0A * \5Cparam[in] input     The input buffer to import from.\0A * \5Cparam input_length  The length in bytes of \5Cp input.\0A * \5Cparam ext_rep       The endianness of the number in the input buffer.\0A *\0A * \5Creturn       \5Cc 0 if successful.\0A * \5Creturn       #MBEDTLS_ERR_MPI_BUFFER_TOO_SMALL if \5Cp X isn't\0A *               large enough to hold the value in \5Cp input.\0A * \5Creturn       #MBEDTLS_ERR_MPI_BAD_INPUT_DATA if the external representation\0A *               of \5Cp N is invalid or \5Cp X is not less than \5Cp N.\0A */\0Aint mbedtls_mpi_mod_raw_read(mbedtls_mpi_uint *X,\0A                             const mbedtls_mpi_mod_modulus *N,\0A                             const unsigned char *input,\0A                             size_t input_length,\0A                             mbedtls_mpi_mod_ext_rep ext_rep);\0A\0A/** Export A into unsigned binary data.\0A *\0A * \5Cparam[in] A         The address of the MPI. The size is determined by \5Cp N.\0A *                      (In particular, it must have at least as many limbs as\0A *                      the modulus \5Cp N.)\0A * \5Cparam[in] N         The address of the modulus related to \5Cp A.\0A * \5Cparam[out] output   The output buffer to export to.\0A * \5Cparam output_length The length in bytes of \5Cp output.\0A * \5Cparam ext_rep       The endianness in which the number should be written into the output buffer.\0A *\0A * \5Creturn       \5Cc 0 if successful.\0A * \5Creturn       #MBEDTLS_ERR_MPI_BUFFER_TOO_SMALL if \5Cp output isn't\0A *               large enough to hold the value of \5Cp A.\0A * \5Creturn       #MBEDTLS_ERR_MPI_BAD_INPUT_DATA if the external representation\0A *               of \5Cp N is invalid.\0A */\0Aint mbedtls_mpi_mod_raw_write(const mbedtls_mpi_uint *A,\0A                              const mbedtls_mpi_mod_modulus *N,\0A                              unsigned char *output,\0A                              size_t output_length,\0A                              mbedtls_mpi_mod_ext_rep ext_rep);\0A\0A/** \5Cbrief  Subtract two MPIs, returning the residue modulo the specified\0A *          modulus.\0A *\0A * The size of the operation is determined by \5Cp N. \5Cp A and \5Cp B must have\0A * the same number of limbs as \5Cp N.\0A *\0A * \5Cp X may be aliased to \5Cp A or \5Cp B, or even both, but may not overlap\0A * either otherwise.\0A *\0A * \5Cparam[out] X        The address of the result MPI.\0A *                      This must be initialized. Must have enough limbs to\0A *                      store the full value of the result.\0A * \5Cparam[in]  A        The address of the first MPI. This must be initialized.\0A * \5Cparam[in]  B        The address of the second MPI. This must be initialized.\0A * \5Cparam[in]  N        The address of the modulus. Used to perform a modulo\0A *                      operation on the result of the subtraction.\0A */\0Avoid mbedtls_mpi_mod_raw_sub(mbedtls_mpi_uint *X,\0A                             const mbedtls_mpi_uint *A,\0A                             const mbedtls_mpi_uint *B,\0A                             const mbedtls_mpi_mod_modulus *N);\0A\0A/** \5Cbrief  Multiply two MPIs, returning the residue modulo the specified\0A *          modulus.\0A *\0A * \5Cnote Currently handles the case when `N->int_rep` is\0A * MBEDTLS_MPI_MOD_REP_MONTGOMERY.\0A *\0A * The size of the operation is determined by \5Cp N. \5Cp A, \5Cp B and \5Cp X must\0A * all be associated with the modulus \5Cp N and must all have the same number\0A * of limbs as \5Cp N.\0A *\0A * \5Cp X may be aliased to \5Cp A or \5Cp B, or even both, but may not overlap\0A * either otherwise. They may not alias \5Cp N (since they must be in canonical\0A * form, they cannot == \5Cp N).\0A *\0A * \5Cparam[out] X        The address of the result MPI. Must have the same\0A *                      number of limbs as \5Cp N.\0A *                      On successful completion, \5Cp X contains the result of\0A *                      the multiplication `A * B * R^-1` mod N where\0A *                      `R = 2^(biL * N->limbs)`.\0A * \5Cparam[in]  A        The address of the first MPI.\0A * \5Cparam[in]  B        The address of the second MPI.\0A * \5Cparam[in]  N        The address of the modulus. Used to perform a modulo\0A *                      operation on the result of the multiplication.\0A * \5Cparam[in,out] T     Temporary storage of size at least 2 * N->limbs + 1\0A *                      limbs. Its initial content is unused and\0A *                      its final content is indeterminate.\0A *                      It must not alias or otherwise overlap any of the\0A *                      other parameters.\0A */\0Avoid mbedtls_mpi_mod_raw_mul(mbedtls_mpi_uint *X,\0A                             const mbedtls_mpi_uint *A,\0A                             const mbedtls_mpi_uint *B,\0A                             const mbedtls_mpi_mod_modulus *N,\0A                             mbedtls_mpi_uint *T);\0A\0A/**\0A * \5Cbrief          Returns the number of limbs of working memory required for\0A *                 a call to `mbedtls_mpi_mod_raw_inv_prime()`.\0A *\0A * \5Cnote           This will always be at least\0A *                 `mbedtls_mpi_core_montmul_working_limbs(AN_limbs)`,\0A *                 i.e. sufficient for a call to `mbedtls_mpi_core_montmul()`.\0A *\0A * \5Cparam AN_limbs The number of limbs in the input `A` and the modulus `N`\0A *                 (they must be the same size) that will be given to\0A *                 `mbedtls_mpi_mod_raw_inv_prime()`.\0A *\0A * \5Creturn         The number of limbs of working memory required by\0A *                 `mbedtls_mpi_mod_raw_inv_prime()`.\0A */\0Asize_t mbedtls_mpi_mod_raw_inv_prime_working_limbs(size_t AN_limbs);\0A\0A/**\0A * \5Cbrief Perform fixed-width modular inversion of a Montgomery-form MPI with\0A *        respect to a modulus \5Cp N that must be prime.\0A *\0A * \5Cp X may be aliased to \5Cp A, but not to \5Cp N or \5Cp RR.\0A *\0A * \5Cparam[out] X     The modular inverse of \5Cp A with respect to \5Cp N.\0A *                   Will be in Montgomery form.\0A * \5Cparam[in] A      The number to calculate the modular inverse of.\0A *                   Must be in Montgomery form. Must not be 0.\0A * \5Cparam[in] N      The modulus, as a little-endian array of length \5Cp AN_limbs.\0A *                   Must be prime.\0A * \5Cparam AN_limbs   The number of limbs in \5Cp A, \5Cp N and \5Cp RR.\0A * \5Cparam[in] RR     The precomputed residue of 2^{2*biL} modulo N, as a little-\0A *                   endian array of length \5Cp AN_limbs.\0A * \5Cparam[in,out] T  Temporary storage of at least the number of limbs returned\0A *                   by `mbedtls_mpi_mod_raw_inv_prime_working_limbs()`.\0A *                   Its initial content is unused and its final content is\0A *                   indeterminate.\0A *                   It must not alias or otherwise overlap any of the other\0A *                   parameters.\0A *                   It is up to the caller to zeroize \5Cp T when it is no\0A *                   longer needed, and before freeing it if it was dynamically\0A *                   allocated.\0A */\0Avoid mbedtls_mpi_mod_raw_inv_prime(mbedtls_mpi_uint *X,\0A                                   const mbedtls_mpi_uint *A,\0A                                   const mbedtls_mpi_uint *N,\0A                                   size_t AN_limbs,\0A                                   const mbedtls_mpi_uint *RR,\0A                                   mbedtls_mpi_uint *T);\0A\0A/**\0A * \5Cbrief Perform a known-size modular addition.\0A *\0A * Calculate `A + B modulo N`.\0A *\0A * The number of limbs in each operand, and the result, is given by the\0A * modulus \5Cp N.\0A *\0A * \5Cp X may be aliased to \5Cp A or \5Cp B, or even both, but may not overlap\0A * either otherwise.\0A *\0A * \5Cparam[out] X    The result of the modular addition.\0A * \5Cparam[in] A     Little-endian presentation of the left operand. This\0A *                  must be smaller than \5Cp N.\0A * \5Cparam[in] B     Little-endian presentation of the right operand. This\0A *                  must be smaller than \5Cp N.\0A * \5Cparam[in] N     The address of the modulus.\0A */\0Avoid mbedtls_mpi_mod_raw_add(mbedtls_mpi_uint *X,\0A                             const mbedtls_mpi_uint *A,\0A                             const mbedtls_mpi_uint *B,\0A                             const mbedtls_mpi_mod_modulus *N);\0A\0A/** Convert an MPI from canonical representation (little-endian limb array)\0A * to the representation associated with the modulus.\0A *\0A * \5Cparam[in,out] X The limb array to convert.\0A *                  It must have as many limbs as \5Cp N.\0A *                  It is converted in place.\0A *                  If this function returns an error, the content of \5Cp X\0A *                  is unspecified.\0A * \5Cparam[in] N     The modulus structure.\0A *\0A * \5Creturn          \5Cc 0 if successful.\0A *                  Otherwise an \5Cc MBEDTLS_ERR_MPI_xxx error code.\0A */\0Aint mbedtls_mpi_mod_raw_canonical_to_modulus_rep(\0A    mbedtls_mpi_uint *X,\0A    const mbedtls_mpi_mod_modulus *N);\0A\0A/** Convert an MPI from the representation associated with the modulus\0A * to canonical representation (little-endian limb array).\0A *\0A * \5Cparam[in,out] X The limb array to convert.\0A *                  It must have as many limbs as \5Cp N.\0A *                  It is converted in place.\0A *                  If this function returns an error, the content of \5Cp X\0A *                  is unspecified.\0A * \5Cparam[in] N     The modulus structure.\0A *\0A * \5Creturn          \5Cc 0 if successful.\0A *                  Otherwise an \5Cc MBEDTLS_ERR_MPI_xxx error code.\0A */\0Aint mbedtls_mpi_mod_raw_modulus_to_canonical_rep(\0A    mbedtls_mpi_uint *X,\0A    const mbedtls_mpi_mod_modulus *N);\0A\0A/** Generate a random number uniformly in a range.\0A *\0A * This function generates a random number between \5Cp min inclusive and\0A * \5Cp N exclusive.\0A *\0A * The procedure complies with RFC 6979 §3.3 (deterministic ECDSA)\0A * when the RNG is a suitably parametrized instance of HMAC_DRBG\0A * and \5Cp min is \5Cc 1.\0A *\0A * \5Cnote           There are `N - min` possible outputs. The lower bound\0A *                 \5Cp min can be reached, but the upper bound \5Cp N cannot.\0A *\0A * \5Cparam X        The destination MPI, in canonical representation modulo \5Cp N.\0A *                 It must not be aliased with \5Cp N or otherwise overlap it.\0A * \5Cparam min      The minimum value to return. It must be strictly smaller\0A *                 than \5Cb N.\0A * \5Cparam N        The modulus.\0A *                 This is the upper bound of the output range, exclusive.\0A * \5Cparam f_rng    The RNG function to use. This must not be \5Cc NULL.\0A * \5Cparam p_rng    The RNG parameter to be passed to \5Cp f_rng.\0A *\0A * \5Creturn         \5Cc 0 if successful.\0A * \5Creturn         #MBEDTLS_ERR_MPI_NOT_ACCEPTABLE if the implementation was\0A *                 unable to find a suitable value within a limited number\0A *                 of attempts. This has a negligible probability if \5Cp N\0A *                 is significantly larger than \5Cp min, which is the case\0A *                 for all usual cryptographic applications.\0A */\0Aint mbedtls_mpi_mod_raw_random(mbedtls_mpi_uint *X,\0A                               mbedtls_mpi_uint min,\0A                               const mbedtls_mpi_mod_modulus *N,\0A                               int (*f_rng)(void *, unsigned char *, size_t),\0A                               void *p_rng);\0A\0A/** Convert an MPI into Montgomery form.\0A *\0A * \5Cparam X      The address of the MPI.\0A *               Must have the same number of limbs as \5Cp N.\0A * \5Cparam N      The address of the modulus, which gives the size of\0A *               the base `R` = 2^(biL*N->limbs).\0A *\0A * \5Creturn       \5Cc 0 if successful.\0A */\0Aint mbedtls_mpi_mod_raw_to_mont_rep(mbedtls_mpi_uint *X,\0A                                    const mbedtls_mpi_mod_modulus *N);\0A\0A/** Convert an MPI back from Montgomery representation.\0A *\0A * \5Cparam X      The address of the MPI.\0A *               Must have the same number of limbs as \5Cp N.\0A * \5Cparam N      The address of the modulus, which gives the size of\0A *               the base `R`= 2^(biL*N->limbs).\0A *\0A * \5Creturn       \5Cc 0 if successful.\0A */\0Aint mbedtls_mpi_mod_raw_from_mont_rep(mbedtls_mpi_uint *X,\0A                                      const mbedtls_mpi_mod_modulus *N);\0A\0A/** \5Cbrief  Perform fixed width modular negation.\0A *\0A * The size of the operation is determined by \5Cp N. \5Cp A must have\0A * the same number of limbs as \5Cp N.\0A *\0A * \5Cp X may be aliased to \5Cp A.\0A *\0A * \5Cparam[out] X        The result of the modular negation.\0A *                      This must be initialized.\0A * \5Cparam[in] A         Little-endian presentation of the input operand. This\0A *                      must be less than or equal to \5Cp N.\0A * \5Cparam[in] N         The modulus to use.\0A */\0Avoid mbedtls_mpi_mod_raw_neg(mbedtls_mpi_uint *X,\0A                             const mbedtls_mpi_uint *A,\0A                             const mbedtls_mpi_mod_modulus *N);\0A\0A#endif /* MBEDTLS_BIGNUM_MOD_RAW_H */\0A\00" }
