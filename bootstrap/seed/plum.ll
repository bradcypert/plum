@.str40144 = private global { i64, i64, [41935 x i8] } { i64 -1, i64 41934, [41935 x i8] c"/*\0A *  Elliptic curve J-PAKE\0A *\0A *  Copyright The Mbed TLS Contributors\0A *  SPDX-License-Identifier: Apache-2.0 OR GPL-2.0-or-later\0A */\0A\0A/*\0A * References in the code are to the Thread v1.0 Specification,\0A * available to members of the Thread Group http://threadgroup.org/\0A */\0A\0A#include \22common.h\22\0A\0A#if defined(MBEDTLS_ECJPAKE_C)\0A\0A#include \22mbedtls/ecjpake.h\22\0A#include \22mbedtls/platform_util.h\22\0A#include \22mbedtls/error.h\22\0A\0A#include <string.h>\0A\0A#if !defined(MBEDTLS_ECJPAKE_ALT)\0A\0A/*\0A * Convert a mbedtls_ecjpake_role to identifier string\0A */\0Astatic const char * const ecjpake_id[] = {\0A    \22client\22,\0A    \22server\22\0A};\0A\0A#define ID_MINE     (ecjpake_id[ctx->role])\0A#define ID_PEER     (ecjpake_id[1 - ctx->role])\0A\0A/**\0A * Helper to Compute a hash from md_type\0A */\0Astatic int mbedtls_ecjpake_compute_hash(mbedtls_md_type_t md_type,\0A                                        const unsigned char *input, size_t ilen,\0A                                        unsigned char *output)\0A{\0A    return mbedtls_md(mbedtls_md_info_from_type(md_type),\0A                      input, ilen, output);\0A}\0A\0A/*\0A * Initialize context\0A */\0Avoid mbedtls_ecjpake_init(mbedtls_ecjpake_context *ctx)\0A{\0A    ctx->md_type = MBEDTLS_MD_NONE;\0A    mbedtls_ecp_group_init(&ctx->grp);\0A    ctx->point_format = MBEDTLS_ECP_PF_UNCOMPRESSED;\0A\0A    mbedtls_ecp_point_init(&ctx->Xm1);\0A    mbedtls_ecp_point_init(&ctx->Xm2);\0A    mbedtls_ecp_point_init(&ctx->Xp1);\0A    mbedtls_ecp_point_init(&ctx->Xp2);\0A    mbedtls_ecp_point_init(&ctx->Xp);\0A\0A    mbedtls_mpi_init(&ctx->xm1);\0A    mbedtls_mpi_init(&ctx->xm2);\0A    mbedtls_mpi_init(&ctx->s);\0A}\0A\0A/*\0A * Free context\0A */\0Avoid mbedtls_ecjpake_free(mbedtls_ecjpake_context *ctx)\0A{\0A    if (ctx == NULL) {\0A        return;\0A    }\0A\0A    ctx->md_type = MBED