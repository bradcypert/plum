@.str40766 = private global { i64, i64, [12845 x i8] } { i64 -1, i64 12844, [12845 x i8] c"/**\0A * \5Cfile des.h\0A *\0A * \5Cbrief DES block cipher\0A *\0A * \5Cwarning   DES/3DES are considered weak ciphers and their use constitutes a\0A *            security risk. We recommend considering stronger ciphers\0A *            instead.\0A */\0A/*\0A *  Copyright The Mbed TLS Contributors\0A *  SPDX-License-Identifier: Apache-2.0 OR GPL-2.0-or-later\0A *\0A */\0A#ifndef MBEDTLS_DES_H\0A#define MBEDTLS_DES_H\0A#include \22mbedtls/private_access.h\22\0A\0A#include \22mbedtls/build_info.h\22\0A#include \22mbedtls/platform_util.h\22\0A\0A#include <stddef.h>\0A#include <stdint.h>\0A\0A#define MBEDTLS_DES_ENCRYPT     1\0A#define MBEDTLS_DES_DECRYPT     0\0A\0A/** The data input has an invalid length. */\0A#define MBEDTLS_ERR_DES_INVALID_INPUT_LENGTH              -0x0032\0A\0A#define MBEDTLS_DES_KEY_SIZE    8\0A\0A#ifdef __cplusplus\0Aextern \22C\22 {\0A#endif\0A\0A#if !defined(MBEDTLS_DES_ALT)\0A// Regular implementation\0A//\0A\0A/**\0A * \5Cbrief          DES context structure\0A *\0A * \5Cwarning        DES/3DES are considered weak ciphers and their use constitutes a\0A *                 security risk. We recommend considering stronger ciphers\0A *                 instead.\0A */\0Atypedef struct mbedtls_des_context {\0A    uint32_t MBEDTLS_PRIVATE(sk)[32];            /*!<  DES subkeys       */\0A}\0Ambedtls_des_context;\0A\0A/**\0A * \5Cbrief          Triple-DES context structure\0A *\0A * \5Cwarning        DES/3DES are considered weak ciphers and their use constitutes a\0A *                 security risk. We recommend considering stronger ciphers\0A *                 instead.\0A */\0Atypedef struct mbedtls_des3_context {\0A    uint32_t MBEDTLS_PRIVATE(sk)[96];            /*!<  3DES subkeys      */\0A}\0Ambedtls_des3_context;\0A\0A#else  /* MBEDTLS_DES_ALT */\0A#include \22des_alt.h\22\0A#endif /* MBEDTLS_DES_ALT */\0A\0A/**\0A * \5Cbrief          Initialize DES context\0A *\0A * \5Cparam ctx      DES context to be initialized\0A *\0A * \5Cwarning        DES/3DES are considered weak ciphers and their use constitutes a\0A *                 security risk. We recommend considering stronger ciphers\0A *                 instead.\0A */\0Avoid mbedtls_des_init(mbedtls_des_context *ctx);\0A\0A/**\0A * \5Cbrief          Clear DES context\0A *\0A * \5Cparam ctx      DES context to be cleared\0A *\0A * \5Cwarning        DES/3DES are considered weak ciphers and their use constitutes a\0A *                 security risk. We recommend considering stronger ciphers\0A *                 instead.\0A */\0Avoid mbedtls_des_free(mbedtls_des_context *ctx);\0A\0A/**\0A * \5Cbrief          Initialize Triple-DES context\0A *\0A * \5Cparam ctx      DES3 context to be initialized\0A *\0A * \5Cwarning        DES/3DES are considered weak ciphers and their use constitutes a\0A *                 security risk. We recommend considering stronger ciphers\0A *                 instead.\0A */\0Avoid mbedtls_des3_init(mbedtls_des3_context *ctx);\0A\0A/**\0A * \5Cbrief          Clear Triple-DES context\0A *\0A * \5Cparam ctx      DES3 context to be cleared\0A *\0A * \5Cwarning        DES/3DES are considered weak ciphers and their use constitutes a\0A *                 security risk. We recommend considering stronger ciphers\0A *                 instead.\0A */\0Avoid mbedtls_des3_free(mbedtls_des3_context *ctx);\0A\0A/**\0A * \5Cbrief          Set key parity on the given key to odd.\0A *\0A *                 DES keys are 56 bits long, but each byte is padded with\0A *                 a parity bit to allow verification.\0A *\0A * \5Cparam key      8-byte secret key\0A *\0A * \5Cwarning        DES/3DES are considered weak ciphers and their use constitutes a\0A *                 security risk. We recommend considering stronger ciphers\0A *                 instead.\0A */\0Avoid mbedtls_des_key_set_parity(unsigned char key[MBEDTLS_DES_KEY_SIZE]);\0A\0A/**\0A * \5Cbrief          Check that key parity on the given key is odd.\0A *\0A *                 DES keys are 56 bits long, but each byte is padded with\0A *                 a parity bit to allow verification.\0A *\0A * \5Cparam key      8-byte secret key\0A *\0A * \5Creturn         0 is parity was ok, 1 if parity was not correct.\0A *\0A * \5Cwarning        DES/3DES are considered weak ciphers and their use constitutes a\0A *                 security risk. We recommend considering stronger ciphers\0A *                 instead.\0A */\0AMBEDTLS_CHECK_RETURN_TYPICAL\0Aint mbedtls_des_key_check_key_parity(const unsigned char key[MBEDTLS_DES_KEY_SIZE]);\0A\0A/**\0A * \5Cbrief          Check that key is not a weak or semi-weak DES key\0A *\0A * \5Cparam key      8-byte secret key\0A *\0A * \5Creturn         0 if no weak key was found, 1 if a weak key was identified.\0A *\0A * \5Cwarning        DES/3DES are considered weak ciphers and their use constitutes a\0A *                 security risk. We recommend considering stronger ciphers\0A *                 instead.\0A */\0AMBEDTLS_CHECK_RETURN_TYPICAL\0Aint mbedtls_des_key_check_weak(const unsigned char key[MBEDTLS_DES_KEY_SIZE]);\0A\0A/**\0A * \5Cbrief          DES key schedule (56-bit, encryption)\0A *\0A * \5Cparam ctx      DES context to be initialized\0A * \5Cparam key      8-byte secret key\0A *\0A * \5Creturn         0\0A *\0A * \5Cwarning        DES/3DES are considered weak ciphers and their use constitutes a\0A *                 security risk. We recommend considering stronger ciphers\0A *                 instead.\0A */\0AMBEDTLS_CHECK_RETURN_TYPICAL\0Aint mbedtls_des_setkey_enc(mbedtls_des_context *ctx, const unsigned char key[MBEDTLS_DES_KEY_SIZE]);\0A\0A/**\0A * \5Cbrief          DES key schedule (56-bit, decryption)\0A *\0A * \5Cparam ctx      DES context to be initialized\0A * \5Cparam key      8-byte secret key\0A *\0A * \5Creturn         0\0A *\0A * \5Cwarning        DES/3DES are considered weak ciphers and their use constitutes a\0A *                 security risk. We recommend considering stronger ciphers\0A *                 instead.\0A */\0AMBEDTLS_CHECK_RETURN_TYPICAL\0Aint mbedtls_des_setkey_dec(mbedtls_des_context *ctx, const unsigned char key[MBEDTLS_DES_KEY_SIZE]);\0A\0A/**\0A * \5Cbrief          Triple-DES key schedule (112-bit, encryption)\0A *\0A * \5Cparam ctx      3DES context to be initialized\0A * \5Cparam key      16-byte secret key\0A *\0A * \5Creturn         0\0A *\0A * \5Cwarning        DES/3DES are considered weak ciphers and their use constitutes a\0A *                 security risk. We recommend considering stronger ciphers\0A *                 instead.\0A */\0AMBEDTLS_CHECK_RETURN_TYPICAL\0Aint mbedtls_des3_set2key_enc(mbedtls_des3_context *ctx,\0A                             const unsigned char key[MBEDTLS_DES_KEY_SIZE * 2]);\0A\0A/**\0A * \5Cbrief          Triple-DES key schedule (112-bit, decryption)\0A *\0A * \5Cparam ctx      3DES context to be initialized\0A * \5Cparam key      16-byte secret key\0A *\0A * \5Creturn         0\0A *\0A * \5Cwarning        DES/3DES are considered weak ciphers and their use constitutes a\0A *                 security risk. We recommend considering stronger ciphers\0A *                 instead.\0A */\0AMBEDTLS_CHECK_RETURN_TYPICAL\0Aint mbedtls_des3_set2key_dec(mbedtls_des3_context *ctx,\0A                             const unsigned char key[MBEDTLS_DES_KEY_SIZE * 2]);\0A\0A/**\0A * \5Cbrief          Triple-DES key schedule (168-bit, encryption)\0A *\0A * \5Cparam ctx      3DES context to be initialized\0A * \5Cparam key      24-byte secret key\0A *\0A * \5Creturn         0\0A *\0A * \5Cwarning        DES/3DES are considered weak ciphers and their use constitutes a\0A *                 security risk. We recommend considering stronger ciphers\0A *                 instead.\0A */\0AMBEDTLS_CHECK_RETURN_TYPICAL\0Aint mbedtls_des3_set3key_enc(mbedtls_des3_context *ctx,\0A                             const unsigned char key[MBEDTLS_DES_KEY_SIZE * 3]);\0A\0A/**\0A * \5Cbrief          Triple-DES key schedule (168-bit, decryption)\0A *\0A * \5Cparam ctx      3DES context to be initialized\0A * \5Cparam key      24-byte secret key\0A *\0A * \5Creturn         0\0A *\0A * \5Cwarning        DES/3DES are considered weak ciphers and their use constitutes a\0A *                 security risk. We recommend considering stronger ciphers\0A *                 instead.\0A */\0AMBEDTLS_CHECK_RETURN_TYPICAL\0Aint mbedtls_des3_set3key_dec(mbedtls_des3_context *ctx,\0A                             const unsigned char key[MBEDTLS_DES_KEY_SIZE * 3]);\0A\0A/**\0A * \5Cbrief          DES-ECB block encryption/decryption\0A *\0A * \5Cparam ctx      DES context\0A * \5Cparam input    64-bit input block\0A * \5Cparam output   64-bit output block\0A *\0A * \5Creturn         0 if successful\0A *\0A * \5Cwarning        DES/3DES are considered weak ciphers and their use constitutes a\0A *                 security risk. We recommend considering stronger ciphers\0A *                 instead.\0A */\0AMBEDTLS_CHECK_RETURN_TYPICAL\0Aint mbedtls_des_crypt_ecb(mbedtls_des_context *ctx,\0A                          const unsigned char input[8],\0A                          unsigned char output[8]);\0A\0A#if defined(MBEDTLS_CIPHER_MODE_CBC)\0A/**\0A * \5Cbrief          DES-CBC buffer encryption/decryption\0A *\0A * \5Cnote           Upon exit, the content of the IV is updated so that you can\0A *                 call the function same function again on the following\0A *                 block(s) of data and get the same result as if it was\0A *                 encrypted in one call. This allows a \22streaming\22 usage.\0A *                 If on the other hand you need to retain the contents of the\0A *                 IV, you should either save it manually or use the cipher\0A *                 module instead.\0A *\0A * \5Cparam ctx      DES context\0A * \5Cparam mode     MBEDTLS_DES_ENCRYPT or MBEDTLS_DES_DECRYPT\0A * \5Cparam length   length of the input data\0A * \5Cparam iv       initialization vector (updated after use)\0A * \5Cparam input    buffer holding the input data\0A * \5Cparam output   buffer holding the output data\0A *\0A * \5Cwarning        DES/3DES are considered weak ciphers and their use constitutes a\0A *                 security risk. We recommend considering stronger ciphers\0A *                 instead.\0A */\0AMBEDTLS_CHECK_RETURN_TYPICAL\0Aint mbedtls_des_crypt_cbc(mbedtls_des_context *ctx,\0A                          int mode,\0A                          size_t length,\0A                          unsigned char iv[8],\0A                          const unsigned char *input,\0A                          unsigned char *output);\0A#endif /* MBEDTLS_CIPHER_MODE_CBC */\0A\0A/**\0A * \5Cbrief          3DES-ECB block encryption/decryption\0A *\0A * \5Cparam ctx      3DES context\0A * \5Cparam input    64-bit input block\0A * \5Cparam output   64-bit output block\0A *\0A * \5Creturn         0 if successful\0A *\0A * \5Cwarning        DES/3DES are considered weak ciphers and their use constitutes a\0A *                 security risk. We recommend considering stronger ciphers\0A *                 instead.\0A */\0AMBEDTLS_CHECK_RETURN_TYPICAL\0Aint mbedtls_des3_crypt_ecb(mbedtls_des3_context *ctx,\0A                           const unsigned char input[8],\0A                           unsigned char output[8]);\0A\0A#if defined(MBEDTLS_CIPHER_MODE_CBC)\0A/**\0A * \5Cbrief          3DES-CBC buffer encryption/decryption\0A *\0A * \5Cnote           Upon exit, the content of the IV is updated so that you can\0A *                 call the function same function again on the following\0A *                 block(s) of data and get the same result as if it was\0A *                 encrypted in one call. This allows a \22streaming\22 usage.\0A *                 If on the other hand you need to retain the contents of the\0A *                 IV, you should either save it manually or use the cipher\0A *                 module instead.\0A *\0A * \5Cparam ctx      3DES context\0A * \5Cparam mode     MBEDTLS_DES_ENCRYPT or MBEDTLS_DES_DECRYPT\0A * \5Cparam length   length of the input data\0A * \5Cparam iv       initialization vector (updated after use)\0A * \5Cparam input    buffer holding the input data\0A * \5Cparam output   buffer holding the output data\0A *\0A * \5Creturn         0 if successful, or MBEDTLS_ERR_DES_INVALID_INPUT_LENGTH\0A *\0A * \5Cwarning        DES/3DES are considered weak ciphers and their use constitutes a\0A *                 security risk. We recommend considering stronger ciphers\0A *                 instead.\0A */\0AMBEDTLS_CHECK_RETURN_TYPICAL\0Aint mbedtls_des3_crypt_cbc(mbedtls_des3_context *ctx,\0A                           int mode,\0A                           size_t length,\0A                           unsigned char iv[8],\0A                           const unsigned char *input,\0A                           unsigned char *output);\0A#endif /* MBEDTLS_CIPHER_MODE_CBC */\0A\0A/**\0A * \5Cbrief          Internal function for key expansion.\0A *                 (Only exposed to allow overriding it,\0A *                 see MBEDTLS_DES_SETKEY_ALT)\0A *\0A * \5Cparam SK       Round keys\0A * \5Cparam key      Base key\0A *\0A * \5Cwarning        DES/3DES are considered weak ciphers and their use constitutes a\0A *                 security risk. We recommend considering stronger ciphers\0A *                 instead.\0A */\0Avoid mbedtls_des_setkey(uint32_t SK[32],\0A                        const unsigned char key[MBEDTLS_DES_KEY_SIZE]);\0A\0A#if defined(MBEDTLS_SELF_TEST)\0A\0A/**\0A * \5Cbrief          Checkup routine\0A *\0A * \5Creturn         0 if successful, or 1 if the test failed\0A */\0AMBEDTLS_CHECK_RETURN_CRITICAL\0Aint mbedtls_des_self_test(int verbose);\0A\0A#endif /* MBEDTLS_SELF_TEST */\0A\0A#ifdef __cplusplus\0A}\0A#endif\0A\0A#endif /* des.h */\0A\00" }
