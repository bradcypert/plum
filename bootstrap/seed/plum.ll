@.str40320 = private global { i64, i64, [2271 x i8] } { i64 -1, i64 2270, [2271 x i8] c"/**\0A * \5Cfile version.h\0A *\0A * \5Cbrief Run-time version information\0A */\0A/*\0A *  Copyright The Mbed TLS Contributors\0A *  SPDX-License-Identifier: Apache-2.0 OR GPL-2.0-or-later\0A */\0A/*\0A * This set of run-time variables can be used to determine the version number of\0A * the Mbed TLS library used. Compile-time version defines for the same can be\0A * found in build_info.h\0A */\0A#ifndef MBEDTLS_VERSION_H\0A#define MBEDTLS_VERSION_H\0A\0A#include \22mbedtls/build_info.h\22\0A\0A#if defined(MBEDTLS_VERSION_C)\0A\0A#ifdef __cplusplus\0Aextern \22C\22 {\0A#endif\0A\0A/**\0A * Get the version number.\0A *\0A * \5Creturn          The constructed version number in the format\0A *                  MMNNPP00 (Major, Minor, Patch).\0A */\0Aunsigned int mbedtls_version_get_number(void);\0A\0A/**\0A * Get the version string (\22x.y.z\22).\0A *\0A * \5Cparam string    The string that will receive the value.\0A *                  (Should be at least 9 bytes in size)\0A */\0Avoid mbedtls_version_get_string(char *string);\0A\0A/**\0A * Get the full version string (\22Mbed TLS x.y.z\22).\0A *\0A * \5Cparam string    The string that will receive the value. The Mbed TLS version\0A *                  string will use 18 bytes AT MOST including a terminating\0A *                  null byte.\0A *                  (So the buffer should be at least 18 bytes to receive this\0A *                  version string).\0A */\0Avoid mbedtls_version_get_string_full(char *string);\0A\0A/**\0A * \5Cbrief           Check if support for a feature was compiled into this\0A *                  Mbed TLS binary. This allows you to see at runtime if the\0A *                  library was for instance compiled with or without\0A *                  Multi-threading support.\0A *\0A * \5Cnote            only checks against defines in the sections \22System\0A *                  support\22, \22Mbed TLS modules\22 and \22Mbed TLS feature\0A *                  support\22 in mbedtls_config.h\0A *\0A * \5Cparam feature   The string for the define to check (e.g. \22MBEDTLS_AES_C\22)\0A *\0A * \5Creturn          0 if the feature is present,\0A *                  -1 if the feature is not present and\0A *                  -2 if support for feature checking as a whole was not\0A *                  compiled in.\0A */\0Aint mbedtls_version_check_feature(const char *feature);\0A\0A#ifdef __cplusplus\0A}\0A#endif\0A\0A#endif /* MBEDTLS_VERSION_C */\0A\0A#endif /* version.h */\0A\00" }
