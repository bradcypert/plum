A// no leading zeroes. Elsewhere dotted text can also be a reg-name.\0Alet http_ipv4_ok (s: String): Bool = {\0A    let parts = s.split(\22.\22);\0A    parts.len() == 4 && Array.all(parts, |part| {\0A        let b = part.as_bytes();\0A        b.len() >= 1 && b.len() <= 3 && (b.len() == 1 || http_byte(b, 0) != 48)\0A            && http_port_ok(b, 0) && match String.parse_int(part) { Ok(n) => n <= 255, Err(_) => false }\0A    })\0A}\0A\0Alet http_ipv6_groups (parts: Array[String]) (i: Int) (allow_ipv4: Bool) (count: Int): Int =\0A    if i >= parts.len() { count }\0A    else {\0A        let part = parts[i];\0A        if allow_ipv4 && i == parts.len() - 1 && String.contains(part, \22.\22) {\0A            if http_ipv4_ok(part) { count + 2 } else { -1 }\0A        } else if part.len() >= 1 && part.len() <= 4 && http_hex_ok(part.as_bytes(), 0) {\0A            http_ipv6_groups(parts, i + 1, allow_ipv4, count + 1)\0A        } else { -1 }\0A    }\0A\0Alet http_ipv6_side (s: String) (allow_ipv4: Bool): Int =\0A    if String.is_empty(s) { 0 } else { http_ipv6_groups(s.split(\22:\22), 0, allow_ipv4, 0) }\0A\0Alet http_ipv6_ok (s: String): Bool =\0A    if s.len() > 45 { false }\0A    else { match String.index_of(s, \22::\22) {\0A        None => http_ipv6_side(s, true) == 8,\0A        Some(i) => {\0A            let left = http_ipv6_side(String.slice(s, 0, i), false);\0A            let right = http_ipv6_side(String.slice(s, i + 2, String.char_len(s)), true);\0A            left >= 0 && right >= 0 && left + right < 8\0A        },\0A    } }\0A\0Alet http_ipvfuture_tail (b: Bytes) (i: Int): Bool =\0A    if i >= b.len() { true }\0A    else if http_reg_name_byte(http_byte(b, i)) || http_byte(b, i) == 58 { http_ipvfuture_tail(b, i + 1) } else { false }\0A\0Alet http_ip_literal_ok (s: String): Bool =\0A    if String.starts_with(s, \22v\22) || String.starts_with(s, \22V\22) {\0A        match String.index_of(s, \22.\22) {\0A            None => false,\0A            Some(i) => i > 1 && i + 1 < s.len()\0A                && http_hex_ok(String.slice(s, 1, i).as_bytes(), 0)\0A                && http_ipvfuture_tail(s.as_bytes(), i + 1),\0A        }\0A    } else { http_ipv6_ok(s) }\0A\0A// RFC 9110 section 7.2 / RFC 3986: uri-host [ ':' port ]. This is\0A// syntax validation, not DNS resolution or a socket port-range check.\0A// Empty Host and empty port are legal grammar (RFC 9112 section 3.2).\0Alet http_host_ok (s: String): Bool =\0A    if String.starts_with(s, \22[\22) { match String.index_of(s, \22]\22) {\0A        None => false,\0A        Some(i) => {\0A            let b = s.as_bytes();\0A            http_ip_literal_ok(String.slice(s, 1, i))\0A                && (i + 1 == b.len() || (http_byte(b, i + 1) == 58 && http_port_ok(b, i + 2)))\0A        },\0A    } } else { http_reg_name_ok(s.as_bytes(), 0) }\0A\0Alet http_validate_host (headers: Array[Header]) (i: Int) (seen: Bool) (required: Bool): Result[Unit, String] =\0A    if i >= headers.len() {\0A        if required && !seen { Err(\22http server: missing Host header\22) } else { Ok(()) }\0A    } else if http_header_named(headers[i], \22Host\22) {\0A        if seen { Err(\22http server: duplicate Host header\22) }\0A        else if !http_host_ok(headers[i].value) { Err(\22http server: invalid Host header\22) }\0A        else { http_validate_host(headers, i + 1, true, required) }\0A    } else { http_validate_host(headers, i + 1, seen, required) }\0A\0A// Validate the complete head before exposing it to body reading. Keep the\0A// version local so the public RequestLine/RequestHead structs stay stable.\0Alet http_parse_request_head (raw: String): Result[RequestHead, String] =\0A    match String.index_of(raw, \22\5Cr\5Cn\5Cr\5Cn\22) {\0A        None => Err(\22http server: incomplete request head\22),\0A        Some(sep_index) => {\0A            let lines = String.slice(raw, 0, sep_index).split(\22\5Cr\5Cn\22);\0A            http_parse_request_line(lines[0]) |> Result.and_then(_, |rl|\0A                http_parse_headers(Array.drop(lines, 1)) |> Result.and_then(_, |headers|\0A                    http_validate_host(headers, 0, false, String.ends_with(lines[0], \22HTTP/1.1\22))\0A                        |> Result.map(_, |ignored| RequestHead {\0A                            method: rl.method, path: rl.path, headers: headers,\0A                            leftover_body: String.slice(raw, sep_index + 4, String.char_len(raw)),\0A                        })))\0A        },\0A    }\0A\0A/// A small, fixed table covering the reason phrases any real client\0A/// actually looks at — not the full IANA registry. An unrecognized code\0A/// still produces a syntactically valid status line (`\22Unknown\22`), just\0A/// a less informative one; never a hard error, since the STATUS CODE\0A/// itself (not its phrase) is what every real HTTP client actually acts\0A/// on.\0Alet http_status_reason (code: Int): String = match code {\0A    200 => \22OK\22, 201 => \22Created\22, 204 => \22No Content\22,\0A    301 => \22Moved Permanently\22, 302 => \22Found\22,\0A    400 => \22Bad Request\22, 401 => \22Unauthorized\22, 403 => \22Forbidden\22, 404 => \22Not Found\22, 405 => \22Method Not Allowed\22,\0A    500 => \22Internal Server Error\22, 501 => \22Not Implemented\22, 502 => \22Bad Gateway\22, 503 => \22Service Unavailable\22,\0A    _ => \22Unknown\22,\0A}\0A\0A// This whole-response API owns framing: caller-supplied lengths/codings\0A// cannot override the method/status policy or describe a different body.\0A// Omit length for 304: resp.body need not be the selected representation.\0A// HEAD may report the byte length of the handler's would-be GET body.\0Alet http_response_to_wire (method: String) (resp: Response): Result[String, String] =\0A    if !http_status_valid(resp.status) { Err(\22http server: invalid response status\22) }\0A    else if http_informational(resp.status) { Err(\22http server: handler must return a final response\22) }\0A    else if http_tunnel(method, resp.status) { Err(\22h