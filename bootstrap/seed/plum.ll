== 0 ? 0 : -1;\0A}\0A\0A// `rename`, which is ATOMIC within a filesystem: the destination is\0A// either the old file or the new one, never a half-written mixture.\0A// That is the whole reason this exists -- `plum fmt --write` builds the\0A// formatted text beside the original and renames it into place, so an\0A// interrupted run cannot leave somebody's source truncated.\0A//\0A// Across filesystems `rename` fails rather than copying, and the\0A// caller is told so rather than being silently given a slower,\0A// non-atomic fallback it did not ask for.\0Along long os_rename_file(const char *from, const char *to) {\0A    return rename(from, to) == 0 ? 0 : -1;\0A}\0A\0Astatic int plum_is_dir(const char *path) {\0A    struct stat st;\0A    if (stat(path, &st) != 0) return 0;\0A    return S_ISDIR(st.st_mode) ? 1 : 0;\0A}\0A\0Astatic int plum_join(char *out, size_t cap, const char *a, const char *b) {\0A    int n = snprintf(out, cap, \22%s/%s\22, a, b);\0A    return (n > 0 && (size_t)n < cap) ? 0 : -1;\0A}\0A\0A// Deletes a directory and everything under it. Recurses with a\0A// heap-allocated path buffer per level rather than a shared one,\0A// because the caller's path must stay intact across the child call.\0A//\0A// Symlinks are removed, never followed: `plum_is_dir` uses `stat`,\0A// which follows, so a symlink to a directory would recurse into the\0A// TARGET and delete someone else's files. `lstat` is used here for\0A// exactly that reason. On Windows there is no `lstat`; the reparse\0A// point is deleted by `remove` as an ordinary entry.\0Astatic int plum_remove_tree(const char *path) {\0A    DIR *d;\0A    struct dirent *e;\0A    char *child;\0A    int rc = 0;\0A\0A#if !defined(_WIN32)\0A    struct stat st;\0A    if (lstat(path, &st) != 0) return -1;\0A    if (!S_ISDIR(st.st_mode)) return remove(path) == 0 ? 0 : -1;\0A#else\0A    DWORD attrs=GetFileAttributesA(path);\0A    if (attrs == INVALID_FILE_ATTRIBUTES) return -1;\0A    if (attrs & FILE_ATTRIBUTE_REPARSE_POINT) {\0A        if (attrs & FILE_ATTRIBUTE_DIRECTORY) return RemoveDirectoryA(path) ? 0 : -1;\0A        return remove(path) == 0 ? 0 : -1;\0A    }\0A    if (!plum_is_dir(path)) return remove(path) == 0 ? 0 : -1;\0A#endif\0A\0A    d = opendir(path);\0A    if (d == NULL) return -1;\0A    child = (char *)malloc(PLUM_PATH_MAX);\0A    if (child == NULL) { closedir(d); return -1; }\0A\0A    while ((e = readdir(d)) != NULL) {\0A        if (strcmp(e->d_name, \22.\22) == 0 || strcmp(e->d_name, \22..\22) == 0) continue;\0A        if (plum_join(child, PLUM_PATH_MAX, path, e->d_name) != 0) { rc = -1; continue; }\0A        if (plum_remove_tree(child) != 0) rc = -1;\0A    }\0A    free(child);\0A    closedir(d);\0A    if (PLUM_RMDIR(path) != 0) rc = -1;\0A    return rc;\0A}\0A\0Along long os_remove_tree(const char *path) {\0A    return plum_remove_tree(path) == 0 ? 0 : -1;\0A}\0A\0Astatic int plum_copy_file(const char *src, const char *dst) {\0A    FILE *in, *out;\0A    char buf[65536];\0A    size_t n;\0A    int rc = 0;\0A\0A    in = fopen(src, \22rb\22);\0A    if (in == NULL) return -1;\0A    out = fopen(dst, \22wb\22);\0A    if (out == NULL) { fclose(in); return -1; }\0A    while ((n = fread(buf, 1, sizeof(buf), in)) > 0) {\0A        if (fwrite(buf, 1, n, out) != n) { rc = -1; break; }\0A    }\0A    if (ferror(in)) rc = -1;\0A    if (fclose(out) != 0) rc = -1;\0A    fclose(in);\0A    return rc;\0A}\0A\0A// Resolve an existing directory to its filesystem path. Resolving the\0A// directory itself (rather than only normalising its spelling) catches\0A// aliases such as `.` and symlinks before a copy can write through them.\0Astatic int plum_resolve_dir(const char *path, char *out, size_t cap) {\0A#if defined(_WIN32)\0A    HANDLE h = CreateFileA(path, FILE_READ_ATTRIBUTES,\0A                           FILE_SHARE_READ | FILE_SHARE_WRITE | FILE_SHARE_DELETE,\0A                           NULL, OPEN_EXISTING, FILE_FLAG_BACKUP_SEMANTICS, NULL);\0A    DWORD n;\0A    if (h == INVALID_HAN