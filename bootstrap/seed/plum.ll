@.str42017 = private global { i64, i64, [19804 x i8] } { i64 -1, i64 19803, [19804 x i8] c"/*\0A *  X.509 base functions for creating certificates / CSRs\0A *\0A *  Copyright The Mbed TLS Contributors\0A *  SPDX-License-Identifier: Apache-2.0 OR GPL-2.0-or-later\0A */\0A\0A#include \22common.h\22\0A\0A#if defined(MBEDTLS_X509_CREATE_C)\0A\0A#include \22x509_internal.h\22\0A#include \22mbedtls/asn1write.h\22\0A#include \22mbedtls/error.h\22\0A#include \22mbedtls/oid.h\22\0A\0A#include <string.h>\0A\0A#include \22mbedtls/platform.h\22\0A\0A#include \22mbedtls/asn1.h\22\0A\0A/* Structure linking OIDs for X.509 DN AttributeTypes to their\0A * string representations and default string encodings used by Mbed TLS. */\0Atypedef struct {\0A    const char *name; /* String representation of AttributeType, e.g.\0A                       * \22CN\22 or \22emailAddress\22. */\0A    size_t name_len; /* Length of 'name', without trailing 0 byte. */\0A    const char *oid; /* String representation of OID of AttributeType,\0A                      * as per RFC 5280, Appendix A.1. encoded as per\0A                      * X.690 */\0A    int default_tag; /* The default character encoding used for the\0A                      * given attribute type, e.g.\0A                      * MBEDTLS_ASN1_UTF8_STRING for UTF-8. */\0A} x509_attr_descriptor_t;\0A\0A#define ADD_STRLEN(s)     s, sizeof(s) - 1\0A\0A/* X.509 DN attributes from RFC 5280, Appendix A.1. */\0Astatic const x509_attr_descriptor_t x509_attrs[] =\0A{\0A    { ADD_STRLEN(\22CN\22),\0A      MBEDTLS_OID_AT_CN, MBEDTLS_ASN1_UTF8_STRING },\0A    { ADD_STRLEN(\22commonName\22),\0A      MBEDTLS_OID_AT_CN, MBEDTLS_ASN1_UTF8_STRING },\0A    { ADD_STRLEN(\22C\22),\0A      MBEDTLS_OID_AT_COUNTRY, MBEDTLS_ASN1_PRINTABLE_STRING },\0A    { ADD_STRLEN(\22countryName\22),\0A      MBEDTLS_OID_AT_COUNTRY, MBEDTLS_ASN1_PRINTABLE_STRING },\0A    { ADD_STRLEN(\22O\22),\0A      MBEDTLS_OID_AT_ORGANIZATION, MBEDTLS_ASN1_UTF8_STRING },\0A    { ADD_STRLEN(\22organizationName\22),\0A      MBEDTLS_OID_AT_ORGANIZATION, MBEDTLS_ASN1_UTF8_STRING },\0A    { ADD_STRLEN(\22L\22),\0A      MBEDTLS_OID_AT_LOCALITY, MBEDTLS_ASN1_UTF8_STRING },\0A    { ADD_STRLEN(\22locality\22),\0A      MBEDTLS_OID_AT_LOCALITY, MBEDTLS_ASN1_UTF8_STRING },\0A    { ADD_STRLEN(\22R\22),\0A      MBEDTLS_OID_PKCS9_EMAIL, MBEDTLS_ASN1_IA5_STRING },\0A    { ADD_STRLEN(\22OU\22),\0A      MBEDTLS_OID_AT_ORG_UNIT, MBEDTLS_ASN1_UTF8_STRING },\0A    { ADD_STRLEN(\22organizationalUnitName\22),\0A      MBEDTLS_OID_AT_ORG_UNIT, MBEDTLS_ASN1_UTF8_STRING },\0A    { ADD_STRLEN(\22ST\22),\0A      MBEDTLS_OID_AT_STATE, MBEDTLS_ASN1_UTF8_STRING },\0A    { ADD_STRLEN(\22stateOrProvinceName\22),\0A      MBEDTLS_OID_AT_STATE, MBEDTLS_ASN1_UTF8_STRING },\0A    { ADD_STRLEN(\22emailAddress\22),\0A      MBEDTLS_OID_PKCS9_EMAIL, MBEDTLS_ASN1_IA5_STRING },\0A    { ADD_STRLEN(\22serialNumber\22),\0A      MBEDTLS_OID_AT_SERIAL_NUMBER, MBEDTLS_ASN1_PRINTABLE_STRING },\0A    { ADD_STRLEN(\22postalAddress\22),\0A      MBEDTLS_OID_AT_POSTAL_ADDRESS, MBEDTLS_ASN1_PRINTABLE_STRING },\0A    { ADD_STRLEN(\22postalCode\22),\0A      MBEDTLS_OID_AT_POSTAL_CODE, MBEDTLS_ASN1_PRINTABLE_STRING },\0A    { ADD_STRLEN(\22dnQualifier\22),\0A      MBEDTLS_OID_AT_DN_QUALIFIER, MBEDTLS_ASN1_PRINTABLE_STRING },\0A    { ADD_STRLEN(\22title\22),\0A      MBEDTLS_OID_AT_TITLE, MBEDTLS_ASN1_UTF8_STRING },\0A    { ADD_STRLEN(\22surName\22),\0A      MBEDTLS_OID_AT_SUR_NAME, MBEDTLS_ASN1_UTF8_STRING },\0A    { ADD_STRLEN(\22SN\22),\0A      MBEDTLS_OID_AT_SUR_NAME, MBEDTLS_ASN1_UTF8_STRING },\0A    { ADD_STRLEN(\22givenName\22),\0A      MBEDTLS_OID_AT_GIVEN_NAME, MBEDTLS_ASN1_UTF8_STRING },\0A    { ADD_STRLEN(\22GN\22),\0A      MBEDTLS_OID_AT_GIVEN_NAME, MBEDTLS_ASN1_UTF8_STRING },\0A    { ADD_STRLEN(\22initials\22),\0A      MBEDTLS_OID_AT_INITIALS, MBEDTLS_ASN1_UTF8_STRING },\0A    { ADD_STRLEN(\22pseudonym\22),\0A      MBEDTLS_OID_AT_PSEUDONYM, MBEDTLS_ASN1_UTF8_STRING },\0A    { ADD_STRLEN(\22generationQualifier\22),\0A      MBEDTLS_OID_AT_GENERATION_QUALIFIER, MBEDTLS_ASN1_UTF8_STRING },\0A    { ADD_STRLEN(\22domainComponent\22),\0A      MBEDTLS_OID_DOMAIN_COMPONENT, MBEDTLS_ASN1_IA5_STRING },\0A    { ADD_STRLEN(\22DC\22),\0A      MBEDTLS_OID_DOMAIN_COMPONENT,   MBEDTLS_ASN1_IA5_STRING },\0A    { NULL, 0, NULL, MBEDTLS_ASN1_NULL }\0A};\0A\0Astatic const x509_attr_descriptor_t *x509_attr_descr_from_name(const char *name, size_t name_len)\0A{\0A    const x509_attr_descriptor_t *cur;\0A\0A    for (cur = x509_attrs; cur->name != NULL; cur++) {\0A        if (cur->name_len == name_len &&\0A            strncmp(cur->name, name, name_len) == 0) {\0A            break;\0A        }\0A    }\0A\0A    if (cur->name == NULL) {\0A        return NULL;\0A    }\0A\0A    return cur;\0A}\0A\0Astatic int hex_to_int(char c)\0A{\0A    return ('0' <= c && c <= '9') ? (c - '0') :\0A           ('a' <= c && c <= 'f') ? (c - 'a' + 10) :\0A           ('A' <= c && c <= 'F') ? (c - 'A' + 10) : -1;\0A}\0A\0Astatic int hexpair_to_int(const char *hexpair)\0A{\0A    int n1 = hex_to_int(*hexpair);\0A    int n2 = hex_to_int(*(hexpair + 1));\0A\0A    if (n1 != -1 && n2 != -1) {\0A        return (n1 << 4) | n2;\0A    } else {\0A        return -1;\0A    }\0A}\0A\0Astatic int parse_attribute_value_string(const char *s,\0A                                        int len,\0A                                        unsigned char *data,\0A                                        size_t *data_len)\0A{\0A    const char *c;\0A    const char *end = s + len;\0A    unsigned char *d = data;\0A    int n;\0A\0A    for (c = s; c < end; c++) {\0A        if (*c == '\5C\5C') {\0A            c++;\0A\0A            /* Check for valid escaped characters as per RFC 4514 Section 3 */\0A            if (c + 1 < end && (n = hexpair_to_int(c)) != -1) {\0A                if (n == 0) {\0A                    return MBEDTLS_ERR_X509_INVALID_NAME;\0A                }\0A                *(d++) = n;\0A                c++;\0A            } else if (c < end && strchr(\22 ,=+<>#;\5C\22\5C\5C\22, *c)) {\0A                *(d++) = *c;\0A            } else {\0A                return MBEDTLS_ERR_X509_INVALID_NAME;\0A            }\0A        } else {\0A            *(d++) = *c;\0A        }\0A\0A        if (d - data == MBEDTLS_X509_MAX_DN_NAME_SIZE) {\0A            return MBEDTLS_ERR_X509_INVALID_NAME;\0A        }\0A    }\0A    *data_len = (size_t) (d - data);\0A    return 0;\0A}\0A\0A/** Parse a hexstring containing a DER-encoded string.\0A *\0A * \5Cparam s         A string of \5Cp len bytes hexadecimal digits.\0A * \5Cparam len       Number of bytes to read from \5Cp s.\0A * \5Cparam data      Output buffer of size \5Cp data_size.\0A *                  On success, it contains the payload that's DER-encoded\0A *                  in the input (content without the tag and length).\0A *                  If the DER tag is a string tag, the payload is guaranteed\0A *                  not to contain null bytes.\0A * \5Cparam data_size Length of the \5Cp data buffer.\0A * \5Cparam data_len  On success, the length of the parsed string.\0A *                  It is guaranteed to be less than\0A *                  #MBEDTLS_X509_MAX_DN_NAME_SIZE.\0A * \5Cparam tag       The ASN.1 tag that the payload in \5Cp data is encoded in.\0A *\0A * \5Cretval          0 on success.\0A * \5Cretval          #MBEDTLS_ERR_X509_INVALID_NAME if \5Cp s does not contain\0A *                  a valid hexstring,\0A *                  or if the decoded hexstring is not valid DER,\0A *                  or if the payload does not fit in \5Cp data,\0A *                  or if the payload is more than\0A *                  #MBEDTLS_X509_MAX_DN_NAME_SIZE bytes,\0A *                  of if \5Cp *tag is an ASN.1 string tag and the payload\0A *                  contains a null byte.\0A * \5Cretval          #MBEDTLS_ERR_X509_ALLOC_FAILED on low memory.\0A */\0Astatic int parse_attribute_value_hex_der_encoded(const char *s,\0A                                                 size_t len,\0A                                                 unsigned char *data,\0A                                                 size_t data_size,\0A                                                 size_t *data_len,\0A                                                 int *tag)\0A{\0A    /* Step 1: preliminary length checks. */\0A    /* Each byte is encoded by exactly two hexadecimal digits. */\0A    if (len % 2 != 0) {\0A        /* Odd number of hex digits */\0A        return MBEDTLS_ERR_X509_INVALID_NAME;\0A    }\0A    size_t const der_length = len / 2;\0A    if (der_length > MBEDTLS_X509_MAX_DN_NAME_SIZE + 4) {\0A        /* The payload would be more than MBEDTLS_X509_MAX_DN_NAME_SIZE\0A         * (after subtracting the ASN.1 tag and length). Reject this early\0A         * to avoid allocating a large intermediate buffer. */\0A        return MBEDTLS_ERR_X509_INVALID_NAME;\0A    }\0A    if (der_length < 1) {\0A        /* Avoid empty-buffer shenanigans. A valid DER encoding is never\0A         * empty. */\0A        return MBEDTLS_ERR_X509_INVALID_NAME;\0A    }\0A\0A    /* Step 2: Decode the hex string into an intermediate buffer. */\0A    unsigned char *der = mbedtls_calloc(1, der_length);\0A    if (der == NULL) {\0A        return MBEDTLS_ERR_X509_ALLOC_FAILED;\0A    }\0A    /* Beyond this point, der needs to be freed on exit. */\0A    for (size_t i = 0; i < der_length; i++) {\0A        int c = hexpair_to_int(s + 2 * i);\0A        if (c < 0) {\0A            goto error;\0A        }\0A        der[i] = c;\0A    }\0A\0A    /* Step 3: decode the DER. */\0A    /* We've checked that der_length >= 1 above. */\0A    *tag = der[0];\0A    {\0A        unsigned char *p = der + 1;\0A        if (mbedtls_asn1_get_len(&p, der + der_length, data_len) != 0) {\0A            goto error;\0A        }\0A        /* Now p points to the first byte of the payload inside der,\0A         * and *data_len is the length of the payload. */\0A\0A        /* Step 4: payload validation */\0A        if (*data_len > MBEDTLS_X509_MAX_DN_NAME_SIZE) {\0A            goto error;\0A        }\0A        /* Strings must not contain null bytes. */\0A        if (MBEDTLS_ASN1_IS_STRING_TAG(*tag)) {\0A            for (size_t i = 0; i < *data_len; i++) {\0A                if (p[i] == 0) {\0A                    goto error;\0A                }\0A            }\0A        }\0A\0A        /* Step 5: output the payload. */\0A        if (*data_len > data_size) {\0A            goto error;\0A        }\0A        memcpy(data, p, *data_len);\0A    }\0A    mbedtls_free(der);\0A\0A    return 0;\0A\0Aerror:\0A    mbedtls_free(der);\0A    return MBEDTLS_ERR_X509_INVALID_NAME;\0A}\0A\0Aint mbedtls_x509_string_to_names(mbedtls_asn1_named_data **head, const char *name)\0A{\0A    int ret = MBEDTLS_ERR_X509_INVALID_NAME;\0A    int parse_ret = 0;\0A    const char *s = name, *c = s;\0A    const char *end = s + strlen(s);\0A    mbedtls_asn1_buf oid = { .p = NULL, .len = 0, .tag = MBEDTLS_ASN1_NULL };\0A    const x509_attr_descriptor_t *attr_descr = NULL;\0A    int in_attr_type = 1;\0A    int tag;\0A    int numericoid = 0;\0A    unsigned char data[MBEDTLS_X509_MAX_DN_NAME_SIZE];\0A    size_t data_len = 0;\0A\0A    /* Clear existing chain if present */\0A    mbedtls_asn1_free_named_data_list(head);\0A\0A    while (c <= end) {\0A        if (in_attr_type && *c == '=') {\0A            if ((attr_descr = x509_attr_descr_from_name(s, (size_t) (c - s))) == NULL) {\0A                if ((mbedtls_oid_from_numeric_string(&oid, s, (size_t) (c - s))) != 0) {\0A                    return MBEDTLS_ERR_X509_INVALID_NAME;\0A                } else {\0A                    numericoid = 1;\0A                }\0A            } else {\0A                oid.len = strlen(attr_descr->oid);\0A                oid.p = mbedtls_calloc(1, oid.len);\0A                memcpy(oid.p, attr_descr->oid, oid.len);\0A                numericoid = 0;\0A            }\0A\0A            s = c + 1;\0A            in_attr_type = 0;\0A        }\0A\0A        if (!in_attr_type && ((*c == ',' && *(c-1) != '\5C\5C') || c == end)) {\0A            if (s == c) {\0A                mbedtls_free(oid.p);\0A                return MBEDTLS_ERR_X509_INVALID_NAME;\0A            } else if (*s == '#') {\0A                /* We know that c >= s (loop invariant) and c != s (in this\0A                 * else branch), hence c - s - 1 >= 0. */\0A                parse_ret = parse_attribute_value_hex_der_encoded(\0A                    s + 1, (size_t) (c - s) - 1,\0A                    data, sizeof(data), &data_len, &tag);\0A                if (parse_ret != 0) {\0A                    mbedtls_free(oid.p);\0A                    return parse_ret;\0A                }\0A            } else {\0A                if (numericoid) {\0A                    mbedtls_free(oid.p);\0A                    return MBEDTLS_ERR_X509_INVALID_NAME;\0A                } else {\0A                    if ((parse_ret =\0A                             parse_attribute_value_string(s, (int) (c - s), data,\0A                                                          &data_len)) != 0) {\0A                        mbedtls_free(oid.p);\0A                        return parse_ret;\0A                    }\0A                    tag = attr_descr->default_tag;\0A                }\0A            }\0A\0A            mbedtls_asn1_named_data *cur =\0A                mbedtls_asn1_store_named_data(head, (char *) oid.p, oid.len,\0A                                              (unsigned char *) data,\0A                                              data_len);\0A            mbedtls_free(oid.p);\0A            oid.p = NULL;\0A            if (cur == NULL) {\0A                return MBEDTLS_ERR_X509_ALLOC_FAILED;\0A            }\0A\0A            // set tagType\0A            cur->val.tag = tag;\0A\0A            while (c < end && *(c + 1) == ' ') {\0A                c++;\0A            }\0A\0A            s = c + 1;\0A            in_attr_type = 1;\0A\0A            /* Successfully parsed one name,