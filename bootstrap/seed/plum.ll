@.str41635 = private global { i64, i64, [64707 x i8] } { i64 -1, i64 64706, [64707 x i8] c"/*\0A *  TLS 1.3 key schedule\0A *\0A *  Copyright The Mbed TLS Contributors\0A *  SPDX-License-Identifier: Apache-2.0 OR GPL-2.0-or-later\0A */\0A\0A#include \22common.h\22\0A\0A#if defined(MBEDTLS_SSL_PROTO_TLS1_3)\0A\0A#include <stdint.h>\0A#include <string.h>\0A\0A#include \22mbedtls/hkdf.h\22\0A#include \22debug_internal.h\22\0A#include \22mbedtls/error.h\22\0A#include \22mbedtls/platform.h\22\0A\0A#include \22ssl_misc.h\22\0A#include \22ssl_tls13_keys.h\22\0A#include \22ssl_tls13_invasive.h\22\0A\0A#include \22psa/crypto.h\22\0A#include \22mbedtls/psa_util.h\22\0A\0A/* Define a local translating function to save code size by not using too many\0A * arguments in each translating place. */\0Astatic int local_err_translation(psa_status_t status)\0A{\0A    return psa_status_to_mbedtls(status, psa_to_ssl_errors,\0A                                 ARRAY_LENGTH(psa_to_ssl_errors),\0A                                 psa_generic_status_to_mbedtls);\0A}\0A#define PSA_TO_MBEDTLS_ERR(status) local_err_translation(status)\0A\0A#define MBEDTLS_SSL_TLS1_3_LABEL(name, string)       \5C\0A    .name = string,\0A\0Astruct mbedtls_ssl_tls13_labels_struct const mbedtls_ssl_tls13_labels =\0A{\0A    /* This seems to work in C, despite the string literal being one\0A     * character too long due to the 0-termination. */\0A    MBEDTLS_SSL_TLS1_3_LABEL_LIST\0A};\0A\0A#undef MBEDTLS_SSL_TLS1_3_LABEL\0A\0A/*\0A * This function creates a HkdfLabel structure used in the TLS 1.3 key schedule.\0A *\0A * The HkdfLabel is specified in RFC 8446 as follows:\0A *\0A * struct HkdfLabel {\0A *   uint16 length;            // Length of expanded key material\0A *   opaque label<7..255>;     // Always prefixed by \22tls13 \22\0A *   opaque context<0..255>;   // Usually a communication transcript hash\0A * };\0A *\0A * Parameters:\0A * - desired_length: Length of expanded key material\0A *                   Even though the standard allows expansion to up to\0A *                   2**16 Bytes, TLS 1.3 never uses expansion to more than\0A *                   255 Bytes, so we require `desired_length` to be at most\0A *                   255. This allows us to save a few Bytes of code by\0A *                   hardcoding the writing of the high bytes.\0A * - (label, label_len): label + label length, without \22tls13 \22 prefix\0A *                       The label length MUST be less than or equal to\0A *                       MBEDTLS_SSL_TLS1_3_KEY_SCHEDULE_MAX_LABEL_LEN\0A *                       It is the caller's responsibility to ensure this.\0A *                       All (label, label length) pairs used in TLS 1.3\0A *                       can be obtained via MBEDTLS_SSL_TLS1_3_LBL_WITH_LEN().\0A * - (ctx, ctx_len): context + context length\0A *                   The context length MUST be less than or equal to\0A *                   MBEDTLS_SSL_TLS1_3_KEY_SCHEDULE_MAX_CONTEXT_LEN\0A *                   It is the caller's responsibility to ensure this.\0A * - dst: Target buffer for HkdfLabel structure,\0A *        This MUST be a writable buffer of size\0A *        at least SSL_TLS1_3_KEY_SCHEDULE_MAX_HKDF_LABEL_LEN Bytes.\0A * - dst_len: Pointer at which to store the actual length of\0A *            the HkdfLabel structure on success.\0A */\0A\0Astatic const char tls13_label_prefix[6] = \22tls13 \22;\0A\0A#define SSL_TLS1_3_KEY_SCHEDULE_HKDF_LABEL_LEN(label_len, context_len) \5C\0A    (2                     /* expansion length           */ \5C\0A     + 1                   /* label length               */ \5C\0A     + label_len                                           \5C\0A     + 1                   /* context length             */ \5C\0A     + context_len)\0A\0A#define SSL_TLS1_3_KEY_SCHEDULE_MAX_HKDF_LABEL_LEN                      \5C\0A    SSL_TLS1_3_KEY_SCHEDULE_HKDF_LABEL_LEN(                             \5C\0A        sizeof(tls13_label_prefix) +                       \5C\0A        MBEDTLS_SSL_TLS1_3_KEY_SCHEDULE_MAX_LABEL_LEN,     \5C\0A        MBEDTLS_SSL_TLS1_3_KEY_SCHEDULE_MAX_CONTEXT_LEN)\0A\0Astatic void ssl_tls13_hkdf_encode_label(\0A    size_t desired_length,\0A    const unsigned char *label, size_t label_len,\0A    const unsigned char *ctx, size_t ctx_len,\0A    unsigned char *dst, size_t *dst_len)\0A{\0A    size_t total_label_len =\0A        sizeof(tls13_label_prefix) + label_len;\0A    size_t total_hkdf_lbl_len =\0A        SSL_TLS1_3_KEY_SCHEDULE_HKDF_LABEL_LEN(total_label_len, ctx_len);\0A\0A    unsigned char *p = dst;\0A\0A    /* Add the size of the expanded key material.\0A     * We're hardcoding the high byte to 0 here assuming that we never use\0A     * TLS 1.3 HKDF key expansion to more than 255 Bytes. */\0A#if MBEDTLS_SSL_TLS1_3_KEY_SCHEDULE_MAX_EXPANSION_LEN > 255\0A#error \22The implementation of ssl_tls13_hkdf_encode_label() is not fit for the \5C\0A    value of MBEDTLS_SSL_TLS1_3_KEY_SCHEDULE_MAX_EXPANSION_LEN\22\0A#endif\0A\0A    *p++ = 0;\0A    *p++ = MBEDTLS_BYTE_0(desired_length);\0A\0A    /* Add label incl. prefix */\0A    *p++ = MBEDTLS_BYTE_0(total_label_len);\0A    memcpy(p, tls13_label_prefix, sizeof(tls13_label_prefix));\0A    p += sizeof(tls13_label_prefix);\0A    memcpy(p, label, label_len);\0A    p += label_len;\0A\0A    /* Add context value */\0A    *p++ = MBEDTLS_BYTE_0(ctx_len);\0A    if (ctx_len != 0) {\0A        memcpy(p, ctx, ctx_len);\0A    }\0A\0A    /* Return total length to the caller.  */\0A    *dst_len = total_hkdf_lbl_len;\0A}\0A\0Aint mbedtls_ssl_tls13_hkdf_expand_label(\0A    psa_algorithm_t hash_alg,\0A    const unsigned char *secret, size_t secret_len,\0A    const unsigned char *label, size_t label_len,\0A    const unsigned char *ctx, size_t ctx_len,\0A    unsigned char *buf, size_t buf_len)\0A{\0A    unsigned char hkdf_label[SSL_TLS1_3_KEY_SCHEDULE_MAX_HKDF_LABEL_LEN];\0A    size_t hkdf_label_len = 0;\0A    psa_status_t status = PSA_ERROR_CORRUPTION_DETECTED;\0A    psa_status_t abort_status = PSA_ERROR_CORRUPTION_DETECTED;\0A    psa_key_derivation_operation_t operation =\0A        PSA_KEY_DERIVATION_OPERATION_INIT;\0A\0A    if (label_len > MBEDTLS_SSL_TLS1_3_KEY_SCHEDULE_MAX_LABEL_LEN) {\0A        /* Should never happen since this is an internal\0A         * function, and we know statically which labels\0A         * are allowed. */\0A        return MBEDTLS_ERR_SSL_INTERNAL_ERROR;\0A    }\0A\0A    if (ctx_len > MBEDTLS_SSL_TLS1_3_KEY_SCHEDULE_MAX_CONTEXT_LEN) {\0A        /* Should not happen, as above. */\0A        return MBEDTLS_ERR_SSL_INTERNAL_ERROR;\0A    }\0A\0A    if (buf_len > MBEDTLS_SSL_TLS1_3_KEY_SCHEDULE_MAX_EXPANSION_LEN) {\0A        /* Should not happen, as above. */\0A        return MBEDTLS_ERR_SSL_INTERNAL_ERROR;\0A    }\0A\0A    if (!PSA_ALG_IS_HASH(hash_alg)) {\0A        return MBEDTLS_ERR_SSL_BAD_INPUT_DATA;\0A    }\0A\0A    ssl_tls13_hkdf_encode_label(buf_len,\0A                                label, label_len,\0A                                ctx, ctx_len,\0A                                hkdf_label,\0A                                &hkdf_label_len);\0A\0A    status = psa_key_derivation_setup(&operation, PSA_ALG_HKDF_EXPAND(hash_alg));\0A\0A    if (status != PSA_SUCCESS) {\0A        goto cleanup;\0A    }\0A\0A    status = psa_key_derivation_input_bytes(&operation,\0A                                            PSA_KEY_DERIVATION_INPUT_SECRET,\0A                                            secret,\0A                                            secret_len);\0A\0A    if (status != PSA_SUCCESS) {\0A        goto cleanup;\0A    }\0A\0A    status = psa_key_derivation_input_bytes(&operation,\0A                                            PSA_KEY_DERIVATION_INPUT_INFO,\0A                                            hkdf_label,\0A                                            hkdf_label_len);\0A\0A    if (status != PSA_SUCCESS) {\0A        goto cleanup;\0A    }\0A\0A    status = psa_key_derivation_output_bytes(&operation,\0A                                             buf,\0A                                             buf_len);\0A\0A    if (status != PSA_SUCCESS) {\0A        goto cleanup;\0A    }\0A\0Acleanup:\0A    abort_status = psa_key_derivation_abort(&operation);\0A    status = (status == PSA_SUCCESS ? abort_status : status);\0A    mbedtls_platform_zeroize(hkdf_label, hkdf_label_len);\0A    return PSA_TO_MBEDTLS_ERR(status);\0A}\0A\0AMBEDTLS_CHECK_RETURN_CRITICAL\0Astatic int ssl_tls13_make_traffic_key(\0A    psa_algorithm_t hash_alg,\0A    const unsigned char *secret, size_t secret_len,\0A    unsigned char *key, size_t key_len,\0A    unsigned char *iv, size_t iv_len)\0A{\0A    int ret = MBEDTLS_ERR_ERROR_CORRUPTION_DETECTED;\0A\0A    ret = mbedtls_ssl_tls13_hkdf_expand_label(\0A        hash_alg,\0A        secret, secret_len,\0A        MBEDTLS_SSL_TLS1_3_LBL_WITH_LEN(key),\0A        NULL, 0,\0A        key, key_len);\0A    if (ret != 0) {\0A        return ret;\0A    }\0A\0A    ret = mbedtls_ssl_tls13_hkdf_expand_label(\0A        hash_alg,\0A        secret, secret_len,\0A        MBEDTLS_SSL_TLS1_3_LBL_WITH_LEN(iv),\0A        NULL, 0,\0A        iv, iv_len);\0A    return ret;\0A}\0A\0A/*\0A * The traffic keying material is generated from the following inputs:\0A *\0A *  - One secret value per sender.\0A *  - A purpose value indicating the specific value being generated\0A *  - The desired lengths of key and IV.\0A *\0A * The expansion itself is based on HKDF:\0A *\0A *   [sender]_write_key = HKDF-Expand-Label( Secret, \22key\22, \22\22, key_length )\0A *   [sender]_write_iv  = HKDF-Expand-Label( Secret, \22iv\22 , \22\22, iv_length )\0A *\0A * [sender] denotes the sending side and the Secret value is provided\0A * by the function caller. Note that we generate server and client side\0A * keys in a single function call.\0A */\0Aint mbedtls_ssl_tls13_make_traffic_keys(\0A    psa_algorithm_t hash_alg,\0A    const unsigned char *client_secret,\0A    const unsigned char *server_secret, size_t secret_len,\0A    size_t key_len, size_t iv_len,\0A    mbedtls_ssl_key_set *keys)\0A{\0A    int ret = 0;\0A\0A    ret = ssl_tls13_make_traffic_key(\0A        hash_alg, client_secret, secret_len,\0A        keys->client_write_key, key_len,\0A        keys->client_write_iv, iv_len);\0A    if (ret != 0) {\0A        return ret;\0A    }\0A\0A    ret = ssl_tls13_make_traffic_key(\0A        hash_alg, server_secret, secret_len,\0A        keys->server_write_key, key_len,\0A        keys->server_write_iv, iv_len);\0A    if (ret != 0) {\0A        return ret;\0A    }\0A\0A    keys->key_len = key_len;\0A    keys->iv_len = iv_len;\0A\0A    return 0;\0A}\0A\0Aint mbedtls_ssl_tls13_derive_secret(\0A    psa_algorithm_t hash_alg,\0A    const unsigned char *secret, size_t secret_len,\0A    const unsigned char *label, size_t label_len,\0A    const unsigned char *ctx, size_t ctx_len,\0A    int ctx_hashed,\0A    unsigned char *dstbuf, size_t dstbuf_len)\0A{\0A    int ret;\0A    unsigned char hashed_context[PSA_HASH_MAX_SIZE];\0A    if (ctx_hashed == MBEDTLS_SSL_TLS1_3_CONTEXT_UNHASHED) {\0A        psa_status_t status = PSA_ERROR_CORRUPTION_DETECTED;\0A\0A        status = psa_hash_compute(hash_alg, ctx, ctx_len, hashed_context,\0A                                  PSA_HASH_LENGTH(hash_alg), &ctx_len);\0A        if (status != PSA_SUCCESS) {\0A            ret = PSA_TO_MBEDTLS_ERR(status);\0A            return ret;\0A        }\0A    } else {\0A        if (ctx_len > sizeof(hashed_context)) {\0A            /* This should never happen since this function is internal\0A             * and the code sets `ctx_hashed` correctly.\0A             * Let's double-check nonetheless to not run at the risk\0A             * of getting a stack overflow. */\0A            return MBEDTLS_ERR_SSL_INTERNAL_ERROR;\0A        }\0A\0A        memcpy(hashed_context, ctx, ctx_len);\0A    }\0A\0A    return mbedtls_ssl_tls13_hkdf_expand_label(hash_alg,\0A                                               secret, secret_len,\0A                                               label, label_len,\0A                                               hashed_context, ctx_len,\0A                                               dstbuf, dstbuf_len);\0A\0A}\0A\0Aint mbedtls_ssl_tls13_evolve_secret(\0A    psa_algorithm_t hash_alg,\0A    const unsigned char *secret_old,\0A    const unsigned char *input, size_t input_len,\0A    unsigned char *secret_new)\0A{\0A    int ret = MBEDTLS_ERR_SSL_INTERNAL_ERROR;\0A    psa_status_t status = PSA_ERROR_CORRUPTION_DETECTED;\0A    psa_status_t abort_status = PSA_ERROR_CORRUPTION_DETECTED;\0A    size_t hlen;\0A    unsigned char tmp_secret[PSA_MAC_MAX_SIZE] = { 0 };\0A    const unsigned char all_zeroes_input[MBEDTLS_TLS1_3_MD_MAX_SIZE] = { 0 };\0A    const unsigned char *l_input = NULL;\0A    size_t l_input_len;\0A\0A    psa_key_derivation_operation_t operation =\0A        PSA_KEY_DERIVATION_OPERATION_INIT;\0A\0A    if (!PSA_ALG_IS_HASH(hash_alg)) {\0A        return MBEDTLS_ERR_SSL_BAD_INPUT_DATA;\0A    }\0A\0A    hlen = PSA_HASH_LENGTH(hash_alg);\0A\0A    /* For non-initial runs, call Derive-Secret( ., \22derived\22, \22\22)\0A     * on the old secret. */\0A    if (secret_old != NULL) {\0A        ret = mbedtls_ssl_tls13_derive_secret(\0A            hash_alg,\0A            secret_old, hlen,\0A            MBEDTLS_SSL_TLS1_3_LBL_WITH_LEN(derived),\0A            NULL, 0,        /* context */\0A            MBEDTLS_SSL_TLS1_3_CONTEXT_UNHASHED,\0A            tmp_secret, hlen);\0A        if (ret != 0) {\0A            goto cleanup;\0A        }\0A    }\0A\0A    ret = 0;\0A\0A    if (input != NULL && input_len != 0) {\0A        l_input = input;\0A        l_input_len = input_len;\0A    } else {\0A        l_input = all_zeroes_input;\0A        l_input_len = hlen;\0A    }\0A\0A    status = psa_key_derivation_setup(&operation,\0A                                      PSA_ALG_HKDF_EXTRACT(hash_alg));\0A\0A    if (status != PSA_SUCCESS) {\0A        goto cleanup;\0A    }\0A\0A    status = psa_key_derivation_input_bytes(&operation,\0A                                            PSA_KEY_DERIVATION_INPUT_SALT,\0A                                            tmp_secret,\0A                                            hlen);\0A\0A    if (status != PSA_SUCCESS) {\0A        goto cleanup;\0A    }\0A\0A    status = psa_key_derivation_input_bytes(&operation,\0A                                            PSA_KEY_DERIVATION_INPUT_SECRET,\0A                                            l_input, l_input_len);\0A\0A    if (status != PSA_SUCCESS) {\0A        goto cleanup;\0A    }\0A\0A    status = psa_key_derivation_output_bytes(&operation,\0A                                             secret_new,\0A                                             PSA_HASH_LENGTH(hash_alg));\0A\0A    if (status != PSA_SUCCESS) {\0A        goto cleanup;\0A    }\0A\0Acleanup:\0A    abort_status = psa_key_derivation_abort(&operation);\0A    status = (status == PSA_SUCCESS ? abort_status : status);\0A    ret = (ret == 0 ? PSA_TO_MBEDTLS_ERR(status) : ret);\0A    mbedtls_platform_zeroize(tmp_secret, sizeof(tmp_secret));\0A    return ret;\0A}\0A\0Aint mbedtls_ssl_tls13_derive_early_secrets(\0A    psa_algorithm_t hash_alg,\0A    unsigned char const *early_secret,\0A    unsigned char const *transcript, size_t transcript_len,\0A    mbedtls_ssl_tls13_early_secrets *derived)\0A{\0A    int ret;\0A    size_t const hash_len = PSA_HASH_LENGTH(hash_alg);\0A\0A    /* We should never call this function with an unknown hash,\0A     * but add an assertion anyway. */\0A    if (!PSA_ALG_IS_HASH(hash_alg)) {\0A        return MBEDTLS_ERR_SSL_INTERNAL_ERROR;\0A    }\0A\0A    /*\0A     *            0\0A     *            |\0A     *            v\0A     *  PSK ->  HKDF-Extract = Early Secret\0A     *            |\0A     *            +-----> Derive-Secret(., \22c e traffic\22, ClientHello)\0A     *            |                     = client_early_traffic_secret\0A     *            |\0A     *            +-----> Derive-Secret(., \22e exp master\22, ClientHello)\0A     *            |                     = early_exporter_master_secret\0A     *            v\0A     */\0A\0A    /* Create client_early_traffic_secret */\0A    ret = mbedtls_ssl_tls13_derive_secret(\0A        hash_alg,\0A        early_secret, hash_len,\0A        MBEDTLS_SSL_TLS1_3_LBL_WITH_LEN(c_e_traffic),\0A        transcript, transcript_len,\0A        MBEDTLS_SSL_TLS1_3_CONTEXT_HASHED,\0A        derived->client_early_traffic_secret,\0A        hash_len);\0A    if (ret != 0) {\0A        return ret;\0A    }\0A\0A    /* Create early exporter */\0A    ret = mbedtls_ssl_tls13_derive_secret(\0A        hash_alg,\0A        early_secret, hash_len,\0A        MBEDTLS_SSL_TLS1_3_LBL_WITH_LEN(e_exp_master),\0A        transcript, transcript_len,\0A        MBEDTLS_SSL_TLS1_3_CONTEXT_HASHED,\0A        derived->early_exporter_master_secret,\0A        hash_len);\0A    if (ret != 0) {\0A        return ret;\0A    }\0A\0A    return 0;\0A}\0A\0Aint mbedtls_ssl_tls13_derive_handshake_secrets(\0A    psa_algorithm_t hash_alg,\0A    unsigned char const *handshake_secret,\0A    unsigned char const *transcript, size_t transcript_len,\0A    mbedtls_ssl_tls13_handshake_secrets *derived)\0A{\0A    int ret;\0A    size_t const hash_len = PSA_HASH_LENGTH(hash_alg);\0A\0A    /* We should never call this function with an unknown hash,\0A     * but add an assertion anyway. */\0A    if (!PSA_ALG_IS_HASH(hash_alg)) {\0A        return MBEDTLS_ERR_SSL_INTERNAL_ERROR;\0A    }\0A\0A    /*\0A     *\0A     * Handshake Secret\0A     * |\0A     * +-----> Derive-Secret( ., \22c hs traffic\22,\0A     * |                     ClientHello...ServerHello )\0A     * |                     = client_handshake_traffic_secret\0A     * |\0A     * +-----> Derive-Secret( ., \22s hs traffic\22,\0A     * |                     ClientHello...ServerHello )\0A     * |                     = server_handshake_traffic_secret\0A     *\0A     */\0A\0A    /*\0A     * Compute client_handshake_traffic_secret wit