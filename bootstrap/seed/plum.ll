@.str39576 = private global { i64, i64, [30 x i8] } { i64 -1, i64 29, [30 x i8] c"mbedtls/include/mbedtls/gcm.h\00" }
@.str39578 = private global { i64, i64, [17602 x i8] } { i64 -1, i64 17601, [17602 x i8] c"/**\0A * \5Cfile gcm.h\0A *\0A * \5Cbrief This file contains GCM definitions and functions.\0A *\0A * The Galois/Counter Mode (GCM) for 128-bit block ciphers is defined\0A * in <em>D. McGrew, J. Viega, The Galois/Counter Mode of Operation\0A * (GCM), Natl. Inst. Stand. Technol.</em>\0A *\0A * For more information on GCM, see <em>NIST SP 800-38D: Recommendation for\0A * Block Cipher Modes of Operation: Galois/Counter Mode (GCM) and GMAC</em>.\0A *\0A */\0A/*\0A *  Copyright The Mbed TLS Contributors\0A *  SPDX-License-Identifier: Apache-2.0 OR GPL-2.0-or-later\0A */\0A\0A#ifndef MBEDTLS_GCM_H\0A#define MBEDTLS_GCM_H\0A#include \22mbedtls/private_access.h\22\0A\0A#include \22mbedtls/build_info.h\22\0A\0A#include \22mbedtls/cipher.h\22\0A\0A#if defined(MBEDTLS_BLOCK_CIPHER_C)\0A#include \22mbedtls/block_cipher.h\22\0A#endif\0A\0A#include <stdint.h>\0A\0A#define MBEDTLS_GCM_ENCRYPT     1\0A#define MBEDTLS_GCM_DECRYPT     0\0A\0A/** Authenticated decryption failed. */\0A#define MBEDTLS_ERR_GCM_AUTH_FAILED                       -0x0012\0A/** Bad input parameters to function. */\0A#define MBEDTLS_ERR_GCM_BAD_INPUT                         -0x0014\0A/** An output buffer is too small. */\0A#define MBEDTLS_ERR_GCM_BUFFER_TOO_SMALL                  -0x0016\0A\0A#ifdef __cplusplus\0Aextern \22C\22 {\0A#endif\0A\0A#if !defined(MBEDTLS_GCM_ALT)\0A\0A#if defined(MBEDTLS_GCM_LARGE_TABLE)\0A#define MBEDTLS_GCM_HTABLE_SIZE 256\0A#else\0A#define MBEDTLS_GCM_HTABLE_SIZE 16\0A#endif\0A\0A/**\0A * \5Cbrief          The GCM context structure.\0A */\0Atypedef struct mbedtls_gcm_context {\0A#if defined(MBEDTLS_BLOCK_CIPHER_C)\0A    mbedtls_block_cipher_context_t MBEDTLS_PRIVATE(block_cipher_ctx);  /*!< The cipher context used. */\0A#else\0A    mbedtls_cipher_context_t MBEDTLS_PRIVATE(cipher_ctx);    /*!< The cipher context used. */\0A#endif\0A    uint64_t MBEDTLS_PRIVATE(H)[MBEDTLS_GCM_HTABLE_SIZE][2]; /*!< Precalculated HTable. */\0A    uint64_t MBEDTLS_PRIVATE(len);                           /*!< The total length of the encrypted data. */\0A    uint64_t MBEDTLS_PRIVATE(add_len);                       /*!< The total length of the additional data. */\0A    unsigned char MBEDTLS_PRIVATE(base_ectr)[16];            /*!< The first ECTR for tag. */\0A    unsigned char MBEDTLS_PRIVATE(y)[16];                    /*!< The Y working value. */\0A    unsigned char MBEDTLS_PRIVATE(buf)[16];                  /*!< The buf working value. */\0A    unsigned char MBEDTLS_PRIVATE(mode);                     /*!< The operation to perform:\0A                                                              #MBEDTLS_GCM_ENCRYPT or\0A                                                              #MBEDTLS_GCM_DECRYPT. */\0A    unsigned char MBEDTLS_PRIVATE(acceleration);             /*!< The acceleration to use. */\0A}\0Ambedtls_gcm_context;\0A\0A#else  /* !MBEDTLS_GCM_ALT */\0A#include \22gcm_alt.h\22\0A#endif /* !MBEDTLS_GCM_ALT */\0A\0A/**\0A * \5Cbrief           This function initializes the specified GCM context,\0A *                  to make references valid, and prepares the context\0A *                  for mbedtls_gcm_setkey() or mbedtls_gcm_free().\0A *\0A *                  The function does not bind the GCM context to a particular\0A *                  cipher, nor set the key. For this purpose, use\0A *                  mbedtls_gcm_setkey().\0A *\0A * \5Cparam ctx       The GCM context to initialize. This must not be \5Cc NULL.\0A */\0Avoid mbedtls_gcm_init(mbedtls_gcm_context *ctx);\0A\0A/**\0A * \5Cbrief           This function associates a GCM context with a\0A *                  cipher algorithm and a key.\0A *\0A * \5Cparam ctx       The GCM context. This must be initialized.\0A * \5Cparam cipher    The 128-bit block cipher to use.\0A * \5Cparam key       The encryption key. This must be a readable buffer of at\0A *                  least \5Cp keybits bits.\0A * \5Cparam keybits   The key size in bits. Valid options are:\0A *                  <ul><li>128 bits</li>\0A *                  <li>192 bits</li>\0A *                  <li>256 bits</li></ul>\0A *\0A * \5Creturn          \5Cc 0 on success.\0A * \5Creturn          A cipher-specific error code on failure.\0A */\0Aint mbedtls_gcm_setkey(mbedtls_gcm_context *ctx,\0A                       mbedtls_cipher_id_t cipher,\0A                       const unsigned char *key,\0A                       unsigned int keybits);\0A\0A/**\0A * \5Cbrief           This function performs GCM encryption or decryption of a buffer.\0A *\0A * \5Cnote            The output buffer \5Cp output can be the same as the input\0A *                  buffer \5Cp input. If \5Cp output is greater than \5Cp input, they\0A *                  cannot overlap.\0A *\0A * \5Cwarning         When this function performs a decryption, it outputs the\0A *                  authentication tag and does not verify that the data is\0A *                  authentic. You should use this function to perform encryption\0A *                  only. For decryption, use mbedtls_gcm_auth_decrypt() instead.\0A *\0A * \5Cparam ctx       The GCM context to use for encryption or decryption. This\0A *                  must be initialized.\0A * \5Cparam mode      The operation to perform:\0A *                  - #MBEDTLS_GCM_ENCRYPT to perform authenticated encryption.\0A *                    The ciphertext is written to \5Cp output and the\0A *                    authentication tag is written to \5Cp tag.\0A *                  - #MBEDTLS_GCM_DECRYPT to perform decryption.\0A *                    The plaintext is written to \5Cp output and the\0A *                    authentication tag is written to \5Cp tag.\0A *                    Note that this mode is not recommended, because it does\0A *                    not verify the authenticity of the data. For this reason,\0A *                    you should use mbedtls_gcm_auth_decrypt() instead of\0A *                    calling this function in decryption mode.\0A * \5Cparam length    The length of the input data, which is equal to the length\0A *                  of the output data.\0A * \5Cparam iv        The initialization vector. This must be a readable buffer of\0A *                  at least \5Cp iv_len Bytes.\0A * \5Cparam iv_len    The length of the IV.\0A * \5Cparam add       The buffer holding the additional data. This must be of at\0A *                  least that size in Bytes.\0A * \5Cparam add_len   The length of the additional data.\0A * \5Cparam input     The buffer holding the input data. If \5Cp length is greater\0A *                  than zero, this must be a readable buffer of at least that\0A *                  size in Bytes.\0A * \5Cparam output    The buffer for holding the output data. If \5Cp length is greater\0A *                  than zero, this must be a writable buffer of at least that\0A *                  size in Bytes.\0A * \5Cparam tag_len   The length of the tag to generate.\0A * \5Cparam tag       The buffer for holding the tag. This must be a writable\0A *                  buffer of at least \5Cp tag_len Bytes.\0A *\0A * \5Creturn          \5Cc 0 if the encryption or decryption was performed\0A *                  successfully. Note that in #MBEDTLS_GCM_DECRYPT mode,\0A *                  this does not indicate that the data is authentic.\0A * \5Creturn          #MBEDTLS_ERR_GCM_BAD_INPUT if the lengths or pointers are\0A *                  not valid or a cipher-specific error code if the encryption\0A *                  or decryption failed.\0A */\0Aint mbedtls_gcm_crypt_and_tag(mbedtls_gcm_context *ctx,\0A                              int mode,\0A                              size_t length,\0A                              const unsigned char *iv,\0A                              size_t iv_len,\0A                              const unsigned char *add,\0A                              size_t add_len,\0A                              const unsigned char *input,\0A                              unsigned char *output,\0A                              size_t tag_len,\0A                              unsigned char *tag);\0A\0A/**\0A * \5Cbrief           This function performs a GCM authenticated decryption of a\0A *                  buffer.\0A *\0A * \5Cnote            The output buffer \5Cp output can be the same as the input\0A *                  buffer \5Cp input. If \5Cp output is greater than \5Cp input, they\0A *                  cannot overlap. Implementations which require\0A *                  MBEDTLS_GCM_ALT to be enabled may not provide support for\0A *                  overlapping buffers.\0A *\0A * \5Cparam ctx       The GCM context. This must be initialized.\0A * \5Cparam length    The length of the ciphertext to decrypt, which is also\0A *                  the length of the decrypted plaintext.\0A * \5Cparam iv        The initialization vector. This must be a readable buffer\0A *                  of at least \5Cp iv_len Bytes.\0A * \5Cparam iv_len    The length of the IV.\0A * \5Cparam add       The buffer holding the additional data. This must be of at\0A *                  least that size in Bytes.\0A * \5Cparam add_len   The length of the additional data.\0A * \5Cparam tag       The buffer holding the tag to verify. This must be a\0A *                  readable buffer of at least \5Cp tag_len Bytes.\0A * \5Cparam tag_len   The length of the tag to verify.\0A * \5Cparam input     The buffer holding the ciphertext. If \5Cp length is greater\0A *                  than zero, this must be a readable buffer of at least that\0A *                  size.\0A * \5Cparam output    The buffer for holding the decrypted plaintext. If \5Cp length\0A *                  is greater than zero, this must be a writable buffer of at\0A *                  least that size.\0A *\0A * \5Creturn          \5Cc 0 if successful and authenticated.\0A * \5Creturn          #MBEDTLS_ERR_GCM_AUTH_FAILED if the tag does not match.\0A * \5Creturn          #MBEDTLS_ERR_GCM_BAD_INPUT if the lengths or pointers are\0A *                  not valid or a cipher-specific error code if the decryption\0A *                  failed.\0A */\0Aint mbedtls_gcm_auth_decrypt(mbedtls_gcm_context *ctx,\0A                             size_t length,\0A                             const unsigned char *iv,\0A                             size_t iv_len,\0A                             const unsigned char *add,\0A                             size_t add_len,\0A                             const unsigned char *tag,\0A                             size_t tag_len,\0A                             const unsigned char *input,\0A                             unsigned char *output);\0A\0A/**\0A * \5Cbrief           This function starts a GCM encryption or decryption\0A *                  operation.\0A *\0A * \5Cparam ctx       The GCM context. This must be initialized.\0A * \5Cparam mode      The operation to perform: #MBEDTLS_GCM_ENCRYPT or\0A *                  #MBEDTLS_GCM_DECRYPT.\0A * \5Cparam iv        The initialization vector. This must be a readable buffer of\0A *                  at least \5Cp iv_len Bytes.\0A * \5Cparam iv_len    The length of the IV.\0A *\0A * \5Creturn          \5Cc 0 on success.\0A */\0Aint mbedtls_gcm_starts(mbedtls_gcm_context *ctx,\0A                       int mode,\0A                       const unsigned char *iv,\0A                       size_t iv_len);\0A\0A/**\0A * \5Cbrief           This function feeds an input buffer as associated data\0A *                  (authenticated but not encrypted data) in a GCM\0A *                  encryption or decryption operation.\0A *\0A *                  Call this function after mbedtls_gcm_starts() to pass\0A *                  the associated data. If the associated data is empty,\0A *                  you do not need to call this function. You may not\0A *                  call this function after calling mbedtls_cipher_update().\0A *\0A * \5Cparam ctx       The GCM context. This must have been started with\0A *                  mbedtls_gcm_starts() and must not have yet received\0A *                  any input with mbedtls_gcm_update().\0A * \5Cparam add       The buffer holding the additional data, or \5Cc NULL\0A *                  if \5Cp add_len is \5Cc 0.\0A * \5Cparam add_len   The length of the additional data. If \5Cc 0,\0A *                  \5Cp add may be \5Cc NULL.\0A *\0A * \5Creturn          \5Cc 0 on success.\0A */\0Aint mbedtls_gcm_update_ad(mbedtls_gcm_context *ctx,\0A                          const unsigned char *add,\0A                          size_t add_len);\0A\0A/**\0A * \5Cbrief           This function feeds an input buffer into an ongoing GCM\0A *                  encryption or decryption operation.\0A *\0A *                  You may call this function zero, one or more times\0A *                  to pass successive parts of the input: the plaintext to\0A *                  encrypt, or the ciphertext (not including the tag) to\0A *                  decrypt. After the last part of the input, call\0A *                  mbedtls_gcm_finish().\0A *\0A *                  This function may produce output in one of the following\0A *                  ways:\0A *                  - Immediate output: the output length is always equal\0A *                    to the input length.\0A *                  - Buffered output: the output consists of a whole number\0A *                    of 16-byte blocks. If the total input length so far\0A *                    (not including associated data) is 16 \5C* *B* + *A*\0A *                    with *A* < 16 then the total output length is 16 \5C* *B*.\0A *\0A *                  In particular:\0A *                  - It is always correct to call this function with\0A *                    \5Cp output_size >= \5Cp input_length + 15.\0A *                  - If \5Cp input_length is a multiple of 16 for all the calls\0A *                    to this function during an operation, then it is\0A *                    correct to use \5Cp output_size = \5Cp input_length.\0A *\0A * \5Cnote            The output buffer \5Cp output can be the same as the input\0A *                  buffer \5Cp input. If \5Cp output is greater than \5Cp input, they\0A *                  cannot overlap. Implementations which require\0A *                  MBEDTLS_GCM_ALT to be enabled may not provide support for\0A *                  overlapping buffers.\0A *\0A * \5Cparam ctx           The GCM context. This must be initialized.\0A * \5Cparam input         The buffer holding the input data. If \5Cp input_length\0A *                      is greater than zero, this must be a readable buffer\0A *                      of at least \5Cp input_length bytes.\0A * \5Cparam input_length  The length of the input data in bytes.\0A * \5Cparam output        The buffer for the output data. If \5Cp output_size\0A *                      is greater than zero, this must be a writable buffer of\0A *                      of at least \5Cp output_size bytes.\0A * \5Cparam output_size   The size of the output buffer in bytes.\0A *                      See the function description regarding the output size.\0A * \5Cparam output_length On success, \5Cp *output_length contains the actual\0A *                      length of the output written in \5Cp output.\0A *                      On failure, the content of \5Cp *output_length is\0A *                      unspecified.\0A *\0A * \5Creturn         \5Cc 0 on success.\0A * \5Creturn         #MBEDTLS_ERR_GCM_BAD_INPUT on failure:\0A *                 total input length too long,\0A *                 unsupported input/output buffer overlap detected,\0A *                 or \5Cp output_size too small.\0A */\0Aint mbedtls_gcm_update(mbedtls_gcm_context *ctx,\0A                       const unsigned char *input, size_t input_length,\0A                       unsigned char *output, size_t output_size,\0A                       size_t *output_length);\0A\0A/**\0A * \5Cbrief           This function finishes the GCM operation and generates\0A *                  the authentication tag.\0A *\0A *                  It wraps up the GCM stream, and generates the\0A *                  tag. The tag can have a maximum length of 16 Bytes.\0A *\0A * \5Cparam ctx       The GCM context. This must be initialized.\0A * \5Cparam tag       The buffer for holding the tag. This must be a writable\0A *                  buffer of at least \5Cp tag_len Bytes.\0A * \5Cparam tag_len   The length of the tag to generate. This must be at least\0A *                  four.\0A * \5Cparam output    The buffer for the final output.\0A *                  If \5Cp output_size is nonzero, this must be a writable\0A *                  buffer of at least \5Cp output_size bytes.\0A * \5Cparam output_size  The size of the \5Cp output buffer in bytes.\0A *                  This must be large enough for the output that\0A *                  mbedtls_gcm_update() has not produced. In particular:\0A *                  - If mbedtls_gcm_update() produces immediate output,\0A *                    or if the total input size is a multiple of \5Cc 16,\0A *                    then mbedtls_gcm_finish() never produces any output,\0A *                    so \5Cp output_size can be \5Cc 0.\0A *                  - \5Cp output_size never needs to be more than \5Cc 15.\0A * \5Cparam output_length On success, \5Cp *output_length contains the actual\0A *                      length of the output written in \5Cp output.\0A *                      On failure, the content of \5Cp *output_length is\0A *                      unspecified.\0A *\0A * \5Creturn          \5Cc 0 on success.\0A * \5Creturn          #MBEDTLS_ERR_GCM_BAD_INPUT on failure:\0A *                  invalid value of \5Cp tag_len,\0A *                  or \5Cp output_size too small.\0A */\0Aint mbedtls_gcm_finish(mbedtls_gcm_context *ctx,\0A                       unsigned char *output, size_t output_size,\0A                       size_t *output_length,\0A                       unsigned char *tag, size_t tag_len);\0A\0A/**\0A * \5Cbrief           This function clears a GCM context and the underlying\0A *                  cipher sub-context.\0A *\0A * \5Cparam ctx       The GCM context to clear. If this is \5Cc NULL, the call has\0A *                  no effect. Otherwise, this must be initialized.\0A */\0Avoid mbedtls_gcm_free(mbedtls_gcm_context *ctx);\0A\0A#if defined(MBEDTLS_SELF_TEST)\0A\0A/**\0A * \5Cbrief          The GCM checkup routine.\0A *\0A * \5Creturn         \5Cc 0 on success.\0A * \5Creturn         \5Cc 1 on failure.\0A */\0Aint mbedtls_gcm_self_test(int verbose);\0A\0A#endif /* MBEDTLS_SELF_TEST */\0A\0A#ifdef __cplusplus\0A}\0A#endif\0A\0A\0A#endif /* gcm.h */\0A\00" }
