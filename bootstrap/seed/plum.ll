@.str45510 = private global { i64, i64, [32963 x i8] } { i64 -1, i64 32962, [32963 x i8] c"/*\0A *  AES-NI support functions\0A *\0A *  Copyright The Mbed TLS Contributors\0A *  SPDX-License-Identifier: Apache-2.0 OR GPL-2.0-or-later\0A */\0A\0A/*\0A * [AES-WP] https://www.intel.com/content/www/us/en/developer/articles/tool/intel-advanced-encryption-standard-aes-instructions-set.html\0A * [CLMUL-WP] https://www.intel.com/content/www/us/en/develop/download/intel-carry-less-multiplication-instruction-and-its-usage-for-computing-the-gcm-mode.html\0A */\0A\0A#include \22common.h\22\0A\0A#if defined(MBEDTLS_AESNI_C)\0A\0A#include \22aesni.h\22\0A\0A#include <string.h>\0A\0A#if defined(MBEDTLS_AESNI_HAVE_CODE)\0A\0A#if MBEDTLS_AESNI_HAVE_CODE == 2\0A#if defined(__GNUC__)\0A#include <cpuid.h>\0A#elif defined(_MSC_VER)\0A#include <intrin.h>\0A#else\0A#error \22`__cpuid` required by MBEDTLS_AESNI_C is not supported by the compiler\22\0A#endif\0A#include <immintrin.h>\0A#endif\0A\0A#if defined(MBEDTLS_ARCH_IS_X86)\0A#if defined(MBEDTLS_COMPILER_IS_GCC)\0A#pragma GCC push_options\0A#pragma GCC target (\22pclmul,sse2,aes\22)\0A#define MBEDTLS_POP_TARGET_PRAGMA\0A#elif defined(__clang__) && (__clang_major__ >= 5)\0A#pragma clang attribute push (__attribute__((target(\22pclmul,sse2,aes\22))), apply_to=function)\0A#define MBEDTLS_POP_TARGET_PRAGMA\0A#endif\0A#endif\0A\0A#if !defined(MBEDTLS_AES_USE_HARDWARE_ONLY)\0A/*\0A * AES-NI support detection routine\0A */\0Aint mbedtls_aesni_has_support(unsigned int what)\0A{\0A    static int done = 0;\0A    static unsigned int c = 0;\0A\0A    if (!done) {\0A#if MBEDTLS_AESNI_HAVE_CODE == 2\0A        static int info[4] = { 0, 0, 0, 0 };\0A#if defined(_MSC_VER)\0A        __cpuid(info, 1);\0A#else\0A        __cpuid(1, info[0], info[1], info[2], info[3]);\0A#endif\0A        c = info[2];\0A#else /* AESNI using asm */\0A        asm (\22movl  $1, %%eax   \5Cn\5Ct\22\0A             \22cpuid             \5Cn\5Ct\22\0A             : \22=c\22 (c)\0A             :\0A             : \22eax\22, \22ebx\22, \22edx\22);\0A#endif /* MBEDTLS_AESNI_HAVE_CODE */\0A        done = 1;\0A    }\0A\0A    return (c & what) != 0;\0A}\0A#endif /* !MBEDTLS_AES_USE_HARDWARE_ONLY */\0A\0A#if MBEDTLS_AESNI_HAVE_CODE == 2\0A\0A/*\0A * AES-NI AES-ECB block en(de)cryption\0A */\0Aint mbedtls_aesni_crypt_ecb(mbedtls_aes_context *ctx,\0A                            int mode,\0A                            const unsigned char input[16],\0A                            unsigned char output[16])\0A{\0A    const __m128i *rk = (const __m128i *) (ctx->buf + ctx->rk_offset);\0A    unsigned nr = ctx->nr; // Number of remaining rounds\0A\0A    // Load round key 0\0A    __m128i state;\0A    memcpy(&state, input, 16);\0A    state = _mm_xor_si128(state, rk[0]);  // state ^= *rk;\0A    ++rk;\0A    --nr;\0A\0A#if !defined(MBEDTLS_BLOCK_CIPHER_NO_DECRYPT)\0A    if (mode == MBEDTLS_AES_DECRYPT) {\0A        while (nr != 0) {\0A            state = _mm_aesdec_si128(state, *rk);\0A            ++rk;\0A            --nr;\0A        }\0A        state = _mm_aesdeclast_si128(state, *rk);\0A    } else\0A#else\0A    (void) mode;\0A#endif\0A    {\0A        while (nr != 0) {\0A            state = _mm_aesenc_si128(state, *rk);\0A            ++rk;\0A            --nr;\0A        }\0A        state = _mm_aesenclast_si128(state, *rk);\0A    }\0A\0A    memcpy(output, &state, 16);\0A    return 0;\0A}\0A\0A/*\0A * GCM multiplication: c = a times b in GF(2^128)\0A * Based on [CLMUL-WP] algorithms 1 (with equation 27) and 5.\0A */\0A\0Astatic void gcm_clmul(const __m128i aa, const __m128i bb,\0A                      __m128i *cc, __m128i *dd)\0A{\0A    /*\0A     * Caryless multiplication dd:cc = aa * bb\0A     * using [CLMUL-WP] algorithm 1 (p. 12).\0A     */\0A    *cc = _mm_clmulepi64_si128(aa, bb, 0x00); // a0*b0 = c1:c0\0A    *dd = _mm_clmulepi64_si128(aa, bb, 0x11); // a1*b1 = d1:d0\0A    __m128i ee = _mm_clmulepi64_si128(aa, bb, 0x10); // a0*b1 = e1:e0\0A    __m128i ff = _mm_clmulepi64_si128(aa, bb, 0x01); // a1*b0 = f1:f0\0A    ff = _mm_xor_si128(ff, ee);                      // e1+f1:e0+f0\0A    ee = ff;                                         // e1+f1:e0+f0\0A    ff = _mm_srli_si128(ff, 8);                      // 0:e1+f1\0A    ee = _mm_slli_si128(ee, 8);                      // e0+f0:0\0A    *dd = _mm_xor_si128(*dd, ff);                    // d1:d0+e1+f1\0A    *cc = _mm_xor_si128(*cc, ee);                    // c1+e0+f0:c0\0A}\0A\0Astatic void gcm_shift(__m128i *cc, __m128i *dd)\0A{\0A    /* [CMUCL-WP] Algorithm 5 Step 1: shift cc:dd one bit to the left,\0A     * taking advantage of [CLMUL-WP] eq 27 (p. 18). */\0A    //                                        // *cc = r1:r0\0A    //                                        // *dd = r3:r2\0A    __m128i cc_lo = _mm_slli_epi64(*cc, 1);   // r1<<1:r0<<1\0A    __m128i dd_lo = _mm_slli_epi64(*dd, 1);   // r3<<1:r2<<1\0A    __m128i cc_hi = _mm_srli_epi64(*cc, 63);  // r1>>63:r0>>63\0A    __m128i dd_hi = _mm_srli_epi64(*dd, 63);  // r3>>63:r2>>63\0A    __m128i xmm5 = _mm_srli_si128(cc_hi, 8);  // 0:r1>>63\0A    cc_hi = _mm_slli_si128(cc_hi, 8);         // r0>>63:0\0A    dd_hi = _mm_slli_si128(dd_hi, 8);         // 0:r1>>63\0A\0A    *cc = _mm_or_si128(cc_lo, cc_hi);         // r1<<1|r0>>63:r0<<1\0A    *dd = _mm_or_si128(_mm_or_si128(dd_lo, dd_hi), xmm5); // r3<<1|r2>>62:r2<<1|r1>>63\0A}\0A\0Astatic __m128i gcm_reduce(__m128i xx)\0A{\0A    //                                            // xx = x1:x0\0A    /* [CLMUL-WP] Algorithm 5 Step 2 */\0A    __m128i aa = _mm_slli_epi64(xx, 63);          // x1<<63:x0<<63 = stuff:a\0A    __m128i bb = _mm_slli_epi64(xx, 62);          // x1<<62:x0<<62 = stuff:b\0A    __m128i cc = _mm_slli_epi64(xx, 57);          // x1<<57:x0<<57 = stuff:c\0A    __m128i dd = _mm_slli_si128(_mm_xor_si128(_mm_xor_si128(aa, bb), cc), 8); // a+b+c:0\0A    return _mm_xor_si128(dd, xx);                 // x1+a+b+c:x0 = d:x0\0A}\0A\0Astatic __m128i gcm_mix(__m128i dx)\0A{\0A    /* [CLMUL-WP] Algorithm 5 Steps 3 and 4 */\0A    __m128i ee = _mm_srli_epi64(dx, 1);           // e1:x0>>1 = e1:e0'\0A    __m128i ff = _mm_srli_epi64(dx, 2);           // f1:x0>>2 = f1:f0'\0A    __m128i gg = _mm_srli_epi64(dx, 7);           // g1:x0>>7 = g1:g0'\0A\0A    // e0'+f0'+g0' is almost e0+f0+g0, except for some missing\0A    // bits carried from d. Now get those bits back in.\0A    __m128i eh = _mm_slli_epi64(dx, 63);          // d<<63:stuff\0A    __m128i fh = _mm_slli_epi64(dx, 62);          // d<<62:stuff\0A    __m128i gh = _mm_slli_epi64(dx, 57);          // d<<57:stuff\0A    __m128i hh = _mm_srli_si128(_mm_xor_si128(_mm_xor_si128(eh, fh), gh), 8); // 0:missing bits of d\0A\0A    return _mm_xor_si128(_mm_xor_si128(_mm_xor_si128(_mm_xor_si128(ee, ff), gg), hh), dx);\0A}\0A\0Avoid mbedtls_aesni_gcm_mult(unsigned char c[16],\0A                            const unsigned char a[16],\0A                            const unsigned char b[16])\0A{\0A    __m128i aa = { 0 }, bb = { 0 }, cc, dd;\0A\0A    /* The inputs are in big-endian order, so byte-reverse them */\0A    for (size_t i = 0; i < 16; i++) {\0A        ((uint8_t *) &aa)[i] = a[15 - i];\0A        ((uint8_t *) &bb)[i] = b[15 - i];\0A    }\0A\0A    gcm_clmul(aa, bb, &cc, &dd);\0A    gcm_shift(&cc, &dd);\0A    /*\0A     * Now reduce modulo the GCM polynomial x^128 + x^7 + x^2 + x + 1\0A     * using [CLMUL-WP] algorithm 5 (p. 18).\0A     * Currently dd:cc holds x3:x2:x1:x0 (already shifted).\0A     */\0A    __m128i dx = gcm_reduce(cc);\0A    __m128i xh = gcm_mix(dx);\0A    cc = _mm_xor_si128(xh, dd); // x3+h1:x2+h0\0A\0A    /* Now byte-reverse the outputs */\0A    for (size_t i = 0; i < 16; i++) {\0A        c[i] = ((uint8_t *) &cc)[15 - i];\0A    }\0A\0A    return;\0A}\0A\0A/*\0A * Compute decryption round keys from encryption round keys\0A */\0A#if !defined(MBEDTLS_BLOCK_CIPHER_NO_DECRYPT)\0Avoid mbedtls_aesni_inverse_key(unsigned char *invkey,\0A                               const unsigned char *fwdkey, int nr)\0A{\0A    __m128i *ik = (__m128i *) invkey;\0A    const __m128i *fk = (const __m128i *) fwdkey + nr;\0A\0A    *ik = *fk;\0A    for (--fk, ++ik; fk > (const __m128i *) fwdkey; --fk, ++ik) {\0A        *ik = _mm_aesimc_si128(*fk);\0A    }\0A    *ik = *fk;\0A}\0A#endif\0A\0A/*\0A * Key expansion, 128-bit case\0A */\0Astatic __m128i aesni_set_rk_128(__m128i state, __m128i xword)\0A{\0A    /*\0A     * Finish generating the next round key.\0A     *\0A     * On entry state is r3:r2:r1:r0 and xword is X:stuff:stuff:stuff\0A     * with X = rot( sub( r3 ) ) ^ RCON (obtained with AESKEYGENASSIST).\0A     *\0A     * On exit, xword is r7:r6:r5:r4\0A     * with r4 = X + r0, r5 = r4 + r1, r6 = r5 + r2, r7 = r6 + r3\0A     * and this is returned, to be written to the round key buffer.\0A     */\0A    xword = _mm_shuffle_epi32(xword, 0xff);   // X:X:X:X\0A    xword = _mm_xor_si128(xword, state);      // X+r3:X+r2:X+r1:r4\0A    state = _mm_slli_si128(state, 4);         // r2:r1:r0:0\0A    xword = _mm_xor_si128(xword, state);      // X+r3+r2:X+r2+r1:r5:r4\0A    state = _mm_slli_si128(state, 4);         // r1:r0:0:0\0A    xword = _mm_xor_si128(xword, state);      // X+r3+r2+r1:r6:r5:r4\0A    state = _mm_slli_si128(state, 4);         // r0:0:0:0\0A    state = _mm_xor_si128(xword, state);      // r7:r6:r5:r4\0A    return state;\0A}\0A\0Astatic void aesni_setkey_enc_128(unsigned char *rk_bytes,\0A                                 const unsigned char *key)\0A{\0A    __m128i *rk = (__m128i *) rk_bytes;\0A\0A    memcpy(&rk[0], key, 16);\0A    rk[1] = aesni_set_rk_128(rk[0], _mm_aeskeygenassist_si128(rk[0], 0x01));\0A    rk[2] = aesni_set_rk_128(rk[1], _mm_aeskeygenassist_si128(rk[1], 0x02));\0A    rk[3] = aesni_set_rk_128(rk[2], _mm_aeskeygenassist_si128(rk[2], 0x04));\0A    rk[4] = aesni_set_rk_128(rk[3], _mm_aeskeygenassist_si128(rk[3], 0x08));\0A    rk[5] = aesni_set_rk_128(rk[4], _mm_aeskeygenassist_si128(rk[4], 0x10));\0A    rk[6] = aesni_set_rk_128(rk[5], _mm_aeskeygenassist_si128(rk[5], 0x20));\0A    rk[7] = aesni_set_rk_128(rk[6], _mm_aeskeygenassist_si128(rk[6], 0x40));\0A    rk[8] = aesni_set_rk_128(rk[7], _mm_aeskeygenassist_si128(rk[7], 0x80));\0A    rk[9] = aesni_set_rk_128(rk[8], _mm_aeskeygenassist_si128(rk[8], 0x1B));\0A    rk[10] = aesni_set_rk_128(rk[9], _mm_aeskeygenassist_si128(rk[9], 0x36));\0A}\0A\0A/*\0A * Key expansion, 192-bit case\0A */\0A#if !defined(MBEDTLS_AES_ONLY_128_BIT_KEY_LENGTH)\0Astatic void aesni_set_rk_192(__m128i *state0, __m128i *state1, __m128i xword,\0A                             unsigned char *rk)\0A{\0A    /*\0A     * Finish generating the next 6 quarter-keys.\0A     *\0A     * On entry state0 is r3:r2:r1:r0, state1 is stuff:stuff:r5:r4\0A     * and xword is stuff:stuff:X:stuff with X = rot( sub( r3 ) ) ^ RCON\0A     * (obtained with AESKEYGENASSIST).\0A     *\0A     * On exit, state0 is r9:r8:r7:r6 and state1 is stuff:stuff:r11:r10\0A     * and those are written to the round key buffer.\0A     */\0A    xword = _mm_shuffle_epi32(xword, 0x55);   // X:X:X:X\0A    xword = _mm_xor_si128(xword, *state0);    // X+r3:X+r2:X+r1:X+r0\0A    *state0 = _mm_slli_si128(*state0, 4);     // r2:r1:r0:0\0A    xword = _mm_xor_si128(xword, *state0);    // X+r3+r2:X+r2+r1:X+r1+r0:X+r0\0A    *state0 = _mm_slli_si128(*state0, 4);     // r1:r0:0:0\0A    xword = _mm_xor_si128(xword, *state0);    // X+r3+r2+r1:X+r2+r1+r0:X+r1+r0:X+r0\0A    *state0 = _mm_slli_si128(*state0, 4);     // r0:0:0:0\0A    xword = _mm_xor_si128(xword, *state0);    // X+r3+r2+r1+r0:X+r2+r1+r0:X+r1+r0:X+r0\0A    *state0 = xword;                          // = r9:r8:r7:r6\0A\0A    xword = _mm_shuffle_epi32(xword, 0xff);   // r9:r9:r9:r9\0A    xword = _mm_xor_si128(xword, *state1);    // stuff:stuff:r9+r5:r9+r4\0A    *state1 = _mm_slli_si128(*state1, 4);     // stuff:stuff:r4:0\0A    xword = _mm_xor_si128(xword, *state1);    // stuff:stuff:r9+r5+r4:r9+r4\0A    *state1 = xword;                          // = stuff:stuff:r11:r10\0A\0A    /* Store state0 and the low half of state1 into rk, which is conceptually\0A     * an array of 24-byte elements. Since 24 is not a multiple of 16,\0A     * rk is not necessarily aligned so just `*rk = *state0` doesn't work. */\0A    memcpy(rk, state0, 16);\0A    memcpy(rk + 16, state1, 8);\0A}\0A\0Astatic void aesni_setkey_enc_192(unsigned char *rk,\0A                                 const unsigned char *key)\0A{\0A    /* First round: use original key */\0A    memcpy(rk, key, 24);\0A    /* aes.c guarantees that rk is aligned on a 16-byte boundary. */\0A    __m128i state0 = ((__m128i *) rk)[0];\0A    __m128i state1 = _mm_loadl_epi64(((__m128i *) rk) + 1);\0A\0A    aesni_set_rk_192(&state0, &state1, _mm_aeskeygenassist_si128(state1, 0x01), rk + 24 * 1);\0A    aesni_set_rk_192(&state0, &state1, _mm_aeskeygenassist_si128(state1, 0x02), rk + 24 * 2);\0A    aesni_set_rk_192(&state0, &state1, _mm_aeskeygenassist_si128(state1, 0x04), rk + 24 * 3);\0A    aesni_set_rk_192(&state0, &state1, _mm_aeskeygenassist_si128(state1, 0x08), rk + 24 * 4);\0A    aesni_set_rk_192(&state0, &state1, _mm_aeskeygenassist_si128(state1, 0x10), rk + 24 * 5);\0A    aesni_set_rk_192(&state0, &state1, _mm_aeskeygenassist_si128(state1, 0x20), rk + 24 * 6);\0A    aesni_set_rk_192(&state0, &state1, _mm_aeskeygenassist_si128(state1, 0x40), rk + 24 * 7);\0A    aesni_set_rk_192(&state0, &state1, _mm_aeskeygenassist_si128(state1, 0x80), rk + 24 * 8);\0A}\0A#endif /* !MBEDTLS_AES_ONLY_128_BIT_KEY_LENGTH */\0A\0A/*\0A * Key expansion, 256-bit case\0A */\0A#if !defined(MBEDTLS_AES_ONLY_128_BIT_KEY_LENGTH)\0Astatic void aesni_set_rk_256(__m128i state0, __m128i state1, __m128i xword,\0A                             __m128i *rk0, __m128i *rk1)\0A{\0A    /*\0A     * Finish generating the next two round keys.\0A     *\0A     * On entry state0 is r3:r2:r1:r0, state1 is r7:r6:r5:r4 and\0A     * xword is X:stuff:stuff:stuff with X = rot( sub( r7 )) ^ RCON\0A     * (obtained with AESKEYGENASSIST).\0A     *\0A     * On exit, *rk0 is r11:r10:r9:r8 and *rk1 is