ng.\0Alet http_response_bodyless (method: String) (status: Int): Bool =\0A    method == \22HEAD\22 || http_informational(status) || status == 204 || status == 304\0A\0Alet http_tunnel (method: String) (status: Int): Bool =\0A    method == \22CONNECT\22 && status >= 200 && status < 300\0A\0Alet http_parse_status_line (line: String): Result[Int, String] = {\0A    let parts = line.split(\22 \22);\0A    if parts.len() < 2 { Err(\22http client: malformed status line: \22.concat(line)) }\0A    else if parts[0] != \22HTTP/1.0\22 && parts[0] != \22HTTP/1.1\22 {\0A        Err(\22http client: unsupported HTTP version\22)\0A    } else {\0A        let code = parts[1].as_bytes();\0A        if code.len() != 3 || !http_digit(http_byte(code, 0)) || !http_digit(http_byte(code, 1)) || !http_digit(http_byte(code, 2)) {\0A            Err(\22http client: malformed status code\22)\0A        } else { match String.parse_int(parts[1]) {\0A            Err(e) => Err(\22http client: malformed status code: \22.concat(e)),\0A            Ok(status) => if http_status_valid(status) { Ok(status) } else { Err(\22http client: invalid response status\22) },\0A        } }\0A    }\0A}\0A\0Alet http_byte (b: Bytes) (i: Int): Int = match b.at(i) { Some(c) => c, None => -1 }\0Alet http_ows (c: Int): Bool = c == 32 || c == 9\0Alet http_ows_start (b: Bytes) (i: Int): Int =\0A    if http_ows(http_byte(b, i)) { http_ows_start(b, i + 1) } else { i }\0Alet http_ows_end (b: Bytes) (i: Int): Int =\0A    if http_ows(http_byte(b, i - 1)) { http_ows_end(b, i - 1) } else { i }\0A\0A// Only SP/HTAB are optional whitespace. Generic Unicode trimming would\0A// erase malformed controls. String.slice uses codepoints, Bytes uses octets.\0Alet http_trim_ows (s: String): String = {\0A    let b = s.as_bytes();\0A    let start = http_ows_start(b, 0);\0A    let end = http_ows_end(b, b.len());\0A    String.slice(s, start, String.char_len(s) - (b.len() - end))\0A}\0A\0Alet http_parse_header_line (line: String): Result[Header, Strin