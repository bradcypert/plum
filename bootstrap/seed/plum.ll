efined(MBEDTLS_HAVE_TIME)\0A    if (old == NULL) {\0A        /* This should only happen on an ill-configured cache\0A         * with max_entries == 0. */\0A        return MBEDTLS_ERR_SSL_INTERNAL_ERROR;\0A    }\0A#else /* MBEDTLS_HAVE_TIME */\0A    /* Reuse first entry in chain, but move to last place. */\0A    if (cache->chain == NULL) {\0A        /* This should never happen */\0A        return MBEDTLS_ERR_ERROR_CORRUPTION_DETECTED;\0A    }\0A\0A    old = cache->chain;\0A    cache->chain = old->next;\0A    old->next = NULL;\0A    last->next = old;\0A#endif /* MBEDTLS_HAVE_TIME */\0A\0A    /* Now `old` points to the oldest entry to be overwritten. */\0A    cur = old;\0A\0Afound:\0A\0A    /* If we're reusing an entry, free it first. */\0A    if (cur->session != NULL) {\0A        /* `ssl_cache_entry_zeroize` would break the chain,\0A         * so we reuse `old` to record `next` temporarily. */\0A        old = cur->next;\0A        ssl_cache_entry_zeroize(cur);\0A        cur->next = old;\0A    }\0A\0A#if defined(MBEDTLS_HAVE_TIME)\0A    cur->timestamp = t;\0A#endif\0A\0A    *dst = cur;\0A    return 0;\0A}\0A\0Aint mbedtls_ssl_cache_set(void *data,\0A                          unsigned char const *session_id,\0A                          size_t session_id_len,\0A                          const mbedtls_ssl_session *session)\0A{\0A    int ret = MBEDTLS_ERR_ERROR_CORRUPTION_DETECTED;\0A    mbedtls_ssl_cache_context *cache = (mbedtls_ssl_cache_context *) data;\0A    mbedtls_ssl_cache_entry *cur;\0A\0A    size_t session_serialized_len = 0;\0A    unsigned char *session_serialized = NULL;\0A\0A#if defined(MBEDTLS_THREADING_C)\0A    if ((ret = mbedtls_mutex_lock(&cache->mutex)) != 0) {\0A        return ret;\0A    }\0A#endif\0A\0A    ret = ssl_cache_pick_writing_slot(cache,\0A                                      session_id, session_id_len,\0A                                      &cur);\0A    if (ret != 0) {\0A        goto exit;\0A    }\0A\0A    /* Check how much space we need to s