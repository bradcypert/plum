DTLS_PK_RSA ||\0A           type == MBEDTLS_PK_RSASSA_PSS;\0A}\0A\0A#if defined(PSA_WANT_KEY_TYPE_RSA_KEY_PAIR_BASIC)\0Astatic int rsa_opaque_decrypt(mbedtls_pk_context *pk,\0A                              const unsigned char *input, size_t ilen,\0A                              unsigned char *output, size_t *olen, size_t osize,\0A                              int (*f_rng)(void *, unsigned char *, size_t), void *p_rng)\0A{\0A    psa_key_attributes_t attributes = PSA_KEY_ATTRIBUTES_INIT;\0A    psa_algorithm_t alg;\0A    psa_key_type_t type;\0A    psa_status_t status;\0A\0A    /* PSA has its own RNG */\0A    (void) f_rng;\0A    (void) p_rng;\0A\0A    status = psa_get_key_attributes(pk->priv_id, &attributes);\0A    if (status != PSA_SUCCESS) {\0A        return PSA_PK_TO_MBEDTLS_ERR(status);\0A    }\0A\0A    type = psa_get_key_type(&attributes);\0A    alg = psa_get_key_algorithm(&attributes);\0A    psa_reset_key_attributes(&attributes);\0A\0A    if (!PSA_KEY_TYPE_IS_RSA(type)) {\0A        return MBEDTLS_ERR_PK_FEATURE_UNAVAILABLE;\0A    }\0A\0A    status = psa_asymmetric_decrypt(pk->priv_id, alg, input, ilen, NULL, 0, output, osize, olen);\0A    if (status != PSA_SUCCESS) {\0A        return PSA_PK_RSA_TO_MBEDTLS_ERR(status);\0A    }\0A\0A    return 0;\0A}\0A#endif /* PSA_WANT_KEY_TYPE_RSA_KEY_PAIR_BASIC */\0A\0Astatic int rsa_opaque_sign_wrap(mbedtls_pk_context *pk, mbedtls_md_type_t md_alg,\0A                                const unsigned char *hash, size_t hash_len,\0A                                unsigned char *sig, size_t sig_size, size_t *sig_len,\0A                                int (*f_rng)(void *, unsigned char *, size_t), void *p_rng)\0A{\0A#if defined(MBEDTLS_RSA_C)\0A    psa_key_attributes_t attributes = PSA_KEY_ATTRIBUTES_INIT;\0A    psa_algorithm_t alg;\0A    psa_key_type_t type;\0A    psa_status_t status;\0A\0A    /* PSA has its own RNG */\0A    (void) f_rng;\0A    (void) p_rng;\0A\0A    status = psa_get_key_attributes(pk->priv_id, &attributes);\0A    if (status != PSA_SUCCESS) {\0A        return PSA_PK_TO_MBEDTLS_ERR(status);\0A    }\0A\0A    type = psa_get_key_type(&attributes);\0A    alg = psa_get_key_algorithm(&attributes);\0A    psa_reset_key_attributes(&attributes);\0A\0A    if (PSA_KEY_TYPE_IS_RSA(type)) {\0A        alg = (alg & ~PSA_ALG_HASH_MASK) | mbedtls_md_psa_alg_from_type(md_alg);\0A    } else {\0A        return MBEDTLS_ERR_PK_FEATURE_UNAVAILABLE;\0A    }\0A\0A    status = psa_sign_hash(pk->priv_id, alg, hash, hash_len, sig, sig_size, sig_len);\0A    if (status != PSA_SUCCESS) {\0A        if (PSA_KEY_TYPE_IS_RSA(type)) {\0A            return PSA_PK_RSA_TO_MBEDTLS_ERR(status);\0A        } else {\0A            return PSA_PK_TO_MBEDTLS_ERR(status);\0A        }\0A    }\0A\0A    return 0;\0A#else /* !MBEDTLS_RSA_C */\0A    ((void) pk);\0A    ((void) md_alg);\0A    ((void) hash);\0A    ((void) hash_len);\0A    ((void) sig);\0A    ((void) sig_size);\0A    ((void) sig_len);\0A    ((void) f_rng);\0A    ((void) p_rng);\0A    return MBEDTLS_ERR_PK_FEATURE_UNAVAILABLE;\0A#endif /* !MBEDTLS_RSA_C */\0A}\0A\0Aconst mbedtls_pk_info_t mbedtls_rsa_opaque_info = {\0A    .type = MBEDTLS_PK_OPAQUE,\0A    .name = \22Opaque\22,\0A    .get_bitlen = opaque_get_bitlen,\0A    .can_do = rsa_opaque_can_do,\0A    .verify_func = NULL,\0A    .sign_func = rsa_opaque_sign_wrap,\0A#if defined(MBEDTLS_ECDSA_C) && defined(MBEDTLS_ECP_RESTARTABLE)\0A    .verify_rs_func = NULL,\0A    .sign_rs_func = NULL,\0A    .rs_alloc_func = NULL,\0A    .rs_free_func = NULL,\0A#endif /* MBEDTLS_ECDSA_C && MBEDTLS_ECP_RESTARTABLE */\0A#if defined(PSA_WANT_KEY_TYPE_RSA_KEY_PAIR_BASIC)\0A    .decrypt_func = rsa_opaque_decrypt,\0A#else /* PSA_WANT_KEY_TYPE_RSA_KEY_PAIR_BASIC */\0A    .decrypt_func = NULL,\0A#endif /* PSA_WANT_KEY_TYPE_RSA_KEY_PAIR_BASIC */\0A    .encrypt_func = NULL,\0A    .check_pair_func = NULL,\0A    .ctx_alloc_func = NULL,\0A    .ctx_free_func = NULL,\0A    .debug_func = NULL,\0A};\0A\0A#endif /* MBEDTLS_USE_PSA_CRYPTO */\0A\0A#endif /* MBEDTLS_PK_C */\0A\00" }
