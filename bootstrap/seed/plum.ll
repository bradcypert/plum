ode and a\0A     * low-level error code. The low-level error usually reflects the\0A     * root cause better, so dispatch on that preferably. */\0A    int low_level_ret = -(-ret & 0x007f);\0A    switch (low_level_ret != 0 ? low_level_ret : ret) {\0A        case 0:\0A            return PSA_SUCCESS;\0A\0A#if defined(MBEDTLS_AES_C)\0A        case MBEDTLS_ERR_AES_INVALID_KEY_LENGTH:\0A        case MBEDTLS_ERR_AES_INVALID_INPUT_LENGTH:\0A            return PSA_ERROR_NOT_SUPPORTED;\0A        case MBEDTLS_ERR_AES_BAD_INPUT_DATA:\0A            return PSA_ERROR_INVALID_ARGUMENT;\0A#endif\0A\0A#if defined(MBEDTLS_ASN1_PARSE_C) || defined(MBEDTLS_ASN1_WRITE_C)\0A        case MBEDTLS_ERR_ASN1_OUT_OF_DATA:\0A        case MBEDTLS_ERR_ASN1_UNEXPECTED_TAG:\0A        case MBEDTLS_ERR_ASN1_INVALID_LENGTH:\0A        case MBEDTLS_ERR_ASN1_LENGTH_MISMATCH:\0A        case MBEDTLS_ERR_ASN1_INVALID_DATA:\0A            return PSA_ERROR_INVALID_ARGUMENT;\0A        case MBEDTLS_ERR_ASN1_ALLOC_FAILED:\0A            return PSA_ERROR_INSUFFICIENT_MEMORY;\0A        case MBEDTLS_ERR_ASN1_BUF_TOO_SMALL:\0A            return PSA_ERROR_BUFFER_TOO_SMALL;\0A#endif\0A\0A#if defined(MBEDTLS_CAMELLIA_C)\0A        case MBEDTLS_ERR_CAMELLIA_BAD_INPUT_DATA:\0A        case MBEDTLS_ERR_CAMELLIA_INVALID_INPUT_LENGTH:\0A            return PSA_ERROR_NOT_SUPPORTED;\0A#endif\0A\0A#if defined(MBEDTLS_CCM_C)\0A        case MBEDTLS_ERR_CCM_BAD_INPUT:\0A            return PSA_ERROR_INVALID_ARGUMENT;\0A        case MBEDTLS_ERR_CCM_AUTH_FAILED:\0A            return PSA_ERROR_INVALID_SIGNATURE;\0A#endif\0A\0A#if defined(MBEDTLS_CHACHA20_C)\0A        case MBEDTLS_ERR_CHACHA20_BAD_INPUT_DATA:\0A            return PSA_ERROR_INVALID_ARGUMENT;\0A#endif\0A\0A#if defined(MBEDTLS_CHACHAPOLY_C)\0A        case MBEDTLS_ERR_CHACHAPOLY_BAD_STATE:\0A            return PSA_ERROR_BAD_STATE;\0A        case MBEDTLS_ERR_CHACHAPOLY_AUTH_FAILED:\0A            return PSA_ERROR_INVALID_SIGNATURE;\0A#endif\0A\0A#if defined(MBEDTLS_CIPHER_C)\0A  