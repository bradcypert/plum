@.str41465 = private global { i64, i64, [27 x i8] } { i64 -1, i64 26, [27 x i8] c"mbedtls/library/platform.c\00" }
@.str41467 = private global { i64, i64, [10924 x i8] } { i64 -1, i64 10923, [10924 x i8] c"/*\0A *  Platform abstraction layer\0A *\0A *  Copyright The Mbed TLS Contributors\0A *  SPDX-License-Identifier: Apache-2.0 OR GPL-2.0-or-later\0A */\0A\0A#include \22common.h\22\0A\0A#if defined(MBEDTLS_PLATFORM_C)\0A\0A#include \22mbedtls/platform.h\22\0A#include \22mbedtls/platform_util.h\22\0A#include \22mbedtls/error.h\22\0A\0A/* The compile time configuration of memory allocation via the macros\0A * MBEDTLS_PLATFORM_{FREE/CALLOC}_MACRO takes precedence over the runtime\0A * configuration via mbedtls_platform_set_calloc_free(). So, omit everything\0A * related to the latter if MBEDTLS_PLATFORM_{FREE/CALLOC}_MACRO are defined. */\0A#if defined(MBEDTLS_PLATFORM_MEMORY) &&                 \5C\0A    !(defined(MBEDTLS_PLATFORM_CALLOC_MACRO) &&        \5C\0A    defined(MBEDTLS_PLATFORM_FREE_MACRO))\0A\0A#if !defined(MBEDTLS_PLATFORM_STD_CALLOC)\0Astatic void *platform_calloc_uninit(size_t n, size_t size)\0A{\0A    ((void) n);\0A    ((void) size);\0A    return NULL;\0A}\0A\0A#define MBEDTLS_PLATFORM_STD_CALLOC   platform_calloc_uninit\0A#endif /* !MBEDTLS_PLATFORM_STD_CALLOC */\0A\0A#if !defined(MBEDTLS_PLATFORM_STD_FREE)\0Astatic void platform_free_uninit(void *ptr)\0A{\0A    ((void) ptr);\0A}\0A\0A#define MBEDTLS_PLATFORM_STD_FREE     platform_free_uninit\0A#endif /* !MBEDTLS_PLATFORM_STD_FREE */\0A\0Astatic void * (*mbedtls_calloc_func)(size_t, size_t) = MBEDTLS_PLATFORM_STD_CALLOC;\0Astatic void (*mbedtls_free_func)(void *) = MBEDTLS_PLATFORM_STD_FREE;\0A\0Avoid *mbedtls_calloc(size_t nmemb, size_t size)\0A{\0A    return (*mbedtls_calloc_func)(nmemb, size);\0A}\0A\0Avoid mbedtls_free(void *ptr)\0A{\0A    (*mbedtls_free_func)(ptr);\0A}\0A\0Aint mbedtls_platform_set_calloc_free(void *(*calloc_func)(size_t, size_t),\0A                                     void (*free_func)(void *))\0A{\0A    mbedtls_calloc_func = calloc_func;\0A    mbedtls_free_func = free_func;\0A    return 0;\0A}\0A#endif /* MBEDTLS_PLATFORM_MEMORY &&\0A          !( defined(MBEDTLS_PLATFORM_CALLOC_MACRO) &&\0A             defined(MBEDTLS_PLATFORM_FREE_MACRO) ) */\0A\0A#if defined(MBEDTLS_PLATFORM_HAS_NON_CONFORMING_SNPRINTF)\0A#include <stdarg.h>\0Aint mbedtls_platform_win32_snprintf(char *s, size_t n, const char *fmt, ...)\0A{\0A    int ret = MBEDTLS_ERR_ERROR_CORRUPTION_DETECTED;\0A    va_list argp;\0A\0A    va_start(argp, fmt);\0A    ret = mbedtls_vsnprintf(s, n, fmt, argp);\0A    va_end(argp);\0A\0A    return ret;\0A}\0A#endif\0A\0A#if defined(MBEDTLS_PLATFORM_SNPRINTF_ALT)\0A#if !defined(MBEDTLS_PLATFORM_STD_SNPRINTF)\0A/*\0A * Make dummy function to prevent NULL pointer dereferences\0A */\0Astatic int platform_snprintf_uninit(char *s, size_t n,\0A                                    const char *format, ...)\0A{\0A    ((void) s);\0A    ((void) n);\0A    ((void) format);\0A    return 0;\0A}\0A\0A#define MBEDTLS_PLATFORM_STD_SNPRINTF    platform_snprintf_uninit\0A#endif /* !MBEDTLS_PLATFORM_STD_SNPRINTF */\0A\0Aint (*mbedtls_snprintf)(char *s, size_t n,\0A                        const char *format,\0A                        ...) = MBEDTLS_PLATFORM_STD_SNPRINTF;\0A\0Aint mbedtls_platform_set_snprintf(int (*snprintf_func)(char *s, size_t n,\0A                                                       const char *format,\0A                                                       ...))\0A{\0A    mbedtls_snprintf = snprintf_func;\0A    return 0;\0A}\0A#endif /* MBEDTLS_PLATFORM_SNPRINTF_ALT */\0A\0A#if defined(MBEDTLS_PLATFORM_HAS_NON_CONFORMING_VSNPRINTF)\0A#include <stdarg.h>\0Aint mbedtls_platform_win32_vsnprintf(char *s, size_t n, const char *fmt, va_list arg)\0A{\0A    int ret = MBEDTLS_ERR_ERROR_CORRUPTION_DETECTED;\0A\0A    /* Avoid calling the invalid parameter handler by checking ourselves */\0A    if (s == NULL || n == 0 || fmt == NULL) {\0A        return -1;\0A    }\0A\0A#if defined(_TRUNCATE)\0A    ret = vsnprintf_s(s, n, _TRUNCATE, fmt, arg);\0A#else\0A    ret = vsnprintf(s, n, fmt, arg);\0A    if (ret < 0 || (size_t) ret == n) {\0A        s[n-1] = '\5C0';\0A        ret = -1;\0A    }\0A#endif\0A\0A    return ret;\0A}\0A#endif\0A\0A#if defined(MBEDTLS_PLATFORM_VSNPRINTF_ALT)\0A#if !defined(MBEDTLS_PLATFORM_STD_VSNPRINTF)\0A/*\0A * Make dummy function to prevent NULL pointer dereferences\0A */\0Astatic int platform_vsnprintf_uninit(char *s, size_t n,\0A                                     const char *format, va_list arg)\0A{\0A    ((void) s);\0A    ((void) n);\0A    ((void) format);\0A    ((void) arg);\0A    return -1;\0A}\0A\0A#define MBEDTLS_PLATFORM_STD_VSNPRINTF    platform_vsnprintf_uninit\0A#endif /* !MBEDTLS_PLATFORM_STD_VSNPRINTF */\0A\0Aint (*mbedtls_vsnprintf)(char *s, size_t n,\0A                         const char *format,\0A                         va_list arg) = MBEDTLS_PLATFORM_STD_VSNPRINTF;\0A\0Aint mbedtls_platform_set_vsnprintf(int (*vsnprintf_func)(char *s, size_t n,\0A                                                         const char *format,\0A                                                         va_list arg))\0A{\0A    mbedtls_vsnprintf = vsnprintf_func;\0A    return 0;\0A}\0A#endif /* MBEDTLS_PLATFORM_VSNPRINTF_ALT */\0A\0A#if defined(MBEDTLS_PLATFORM_PRINTF_ALT)\0A#if !defined(MBEDTLS_PLATFORM_STD_PRINTF)\0A/*\0A * Make dummy function to prevent NULL pointer dereferences\0A */\0Astatic int platform_printf_uninit(const char *format, ...)\0A{\0A    ((void) format);\0A    return 0;\0A}\0A\0A#define MBEDTLS_PLATFORM_STD_PRINTF    platform_printf_uninit\0A#endif /* !MBEDTLS_PLATFORM_STD_PRINTF */\0A\0Aint (*mbedtls_printf)(const char *, ...) = MBEDTLS_PLATFORM_STD_PRINTF;\0A\0Aint mbedtls_platform_set_printf(int (*printf_func)(const char *, ...))\0A{\0A    mbedtls_printf = printf_func;\0A    return 0;\0A}\0A#endif /* MBEDTLS_PLATFORM_PRINTF_ALT */\0A\0A#if defined(MBEDTLS_PLATFORM_FPRINTF_ALT)\0A#if !defined(MBEDTLS_PLATFORM_STD_FPRINTF)\0A/*\0A * Make dummy function to prevent NULL pointer dereferences\0A */\0Astatic int platform_fprintf_uninit(FILE *stream, const char *format, ...)\0A{\0A    ((void) stream);\0A    ((void) format);\0A    return 0;\0A}\0A\0A#define MBEDTLS_PLATFORM_STD_FPRINTF   platform_fprintf_uninit\0A#endif /* !MBEDTLS_PLATFORM_STD_FPRINTF */\0A\0Aint (*mbedtls_fprintf)(FILE *, const char *, ...) =\0A    MBEDTLS_PLATFORM_STD_FPRINTF;\0A\0Aint mbedtls_platform_set_fprintf(int (*fprintf_func)(FILE *, const char *, ...))\0A{\0A    mbedtls_fprintf = fprintf_func;\0A    return 0;\0A}\0A#endif /* MBEDTLS_PLATFORM_FPRINTF_ALT */\0A\0A#if defined(MBEDTLS_PLATFORM_SETBUF_ALT)\0A#if !defined(MBEDTLS_PLATFORM_STD_SETBUF)\0A/*\0A * Make dummy function to prevent NULL pointer dereferences\0A */\0Astatic void platform_setbuf_uninit(FILE *stream, char *buf)\0A{\0A    ((void) stream);\0A    ((void) buf);\0A}\0A\0A#define MBEDTLS_PLATFORM_STD_SETBUF   platform_setbuf_uninit\0A#endif /* !MBEDTLS_PLATFORM_STD_SETBUF */\0Avoid (*mbedtls_setbuf)(FILE *stream, char *buf) = MBEDTLS_PLATFORM_STD_SETBUF;\0A\0Aint mbedtls_platform_set_setbuf(void (*setbuf_func)(FILE *stream, char *buf))\0A{\0A    mbedtls_setbuf = setbuf_func;\0A    return 0;\0A}\0A#endif /* MBEDTLS_PLATFORM_SETBUF_ALT */\0A\0A#if defined(MBEDTLS_PLATFORM_EXIT_ALT)\0A#if !defined(MBEDTLS_PLATFORM_STD_EXIT)\0A/*\0A * Make dummy function to prevent NULL pointer dereferences\0A */\0Astatic void platform_exit_uninit(int status)\0A{\0A    ((void) status);\0A}\0A\0A#define MBEDTLS_PLATFORM_STD_EXIT   platform_exit_uninit\0A#endif /* !MBEDTLS_PLATFORM_STD_EXIT */\0A\0Avoid (*mbedtls_exit)(int status) = MBEDTLS_PLATFORM_STD_EXIT;\0A\0Aint mbedtls_platform_set_exit(void (*exit_func)(int status))\0A{\0A    mbedtls_exit = exit_func;\0A    return 0;\0A}\0A#endif /* MBEDTLS_PLATFORM_EXIT_ALT */\0A\0A#if defined(MBEDTLS_HAVE_TIME)\0A\0A#if defined(MBEDTLS_PLATFORM_TIME_ALT)\0A#if !defined(MBEDTLS_PLATFORM_STD_TIME)\0A/*\0A * Make dummy function to prevent NULL pointer dereferences\0A */\0Astatic mbedtls_time_t platform_time_uninit(mbedtls_time_t *timer)\0A{\0A    ((void) timer);\0A    return 0;\0A}\0A\0A#define MBEDTLS_PLATFORM_STD_TIME   platform_time_uninit\0A#endif /* !MBEDTLS_PLATFORM_STD_TIME */\0A\0Ambedtls_time_t (*mbedtls_time)(mbedtls_time_t *timer) = MBEDTLS_PLATFORM_STD_TIME;\0A\0Aint mbedtls_platform_set_time(mbedtls_time_t (*time_func)(mbedtls_time_t *timer))\0A{\0A    mbedtls_time = time_func;\0A    return 0;\0A}\0A#endif /* MBEDTLS_PLATFORM_TIME_ALT */\0A\0A#endif /* MBEDTLS_HAVE_TIME */\0A\0A#if defined(MBEDTLS_ENTROPY_NV_SEED)\0A#if !defined(MBEDTLS_PLATFORM_NO_STD_FUNCTIONS) && defined(MBEDTLS_FS_IO)\0A/* Default implementations for the platform independent seed functions use\0A * standard libc file functions to read from and write to a pre-defined filename\0A */\0Aint mbedtls_platform_std_nv_seed_read(unsigned char *buf, size_t buf_len)\0A{\0A    FILE *file;\0A    size_t n;\0A\0A    if ((file = fopen(MBEDTLS_PLATFORM_STD_NV_SEED_FILE, \22rb\22)) == NULL) {\0A        return -1;\0A    }\0A\0A    /* Ensure no stdio buffering of secrets, as such buffers cannot be wiped. */\0A    mbedtls_setbuf(file, NULL);\0A\0A    if ((n = fread(buf, 1, buf_len, file)) != buf_len) {\0A        fclose(file);\0A        mbedtls_platform_zeroize(buf, buf_len);\0A        return -1;\0A    }\0A\0A    fclose(file);\0A    return (int) n;\0A}\0A\0Aint mbedtls_platform_std_nv_seed_write(unsigned char *buf, size_t buf_len)\0A{\0A    FILE *file;\0A    size_t n;\0A\0A    if ((file = fopen(MBEDTLS_PLATFORM_STD_NV_SEED_FILE, \22w\22)) == NULL) {\0A        return -1;\0A    }\0A\0A    /* Ensure no stdio buffering of secrets, as such buffers cannot be wiped. */\0A    mbedtls_setbuf(file, NULL);\0A\0A    if ((n = fwrite(buf, 1, buf_len, file)) != buf_len) {\0A        fclose(file);\0A        return -1;\0A    }\0A\0A    fclose(file);\0A    return (int) n;\0A}\0A#endif /* MBEDTLS_PLATFORM_NO_STD_FUNCTIONS */\0A\0A#if defined(MBEDTLS_PLATFORM_NV_SEED_ALT)\0A#if !defined(MBEDTLS_PLATFORM_STD_NV_SEED_READ)\0A/*\0A * Make dummy function to prevent NULL pointer dereferences\0A */\0Astatic int platform_nv_seed_read_uninit(unsigned char *buf, size_t buf_len)\0A{\0A    ((void) buf);\0A    ((void) buf_len);\0A    return -1;\0A}\0A\0A#define MBEDTLS_PLATFORM_STD_NV_SEED_READ   platform_nv_seed_read_uninit\0A#endif /* !MBEDTLS_PLATFORM_STD_NV_SEED_READ */\0A\0A#if !defined(MBEDTLS_PLATFORM_STD_NV_SEED_WRITE)\0A/*\0A * Make dummy function to prevent NULL pointer dereferences\0A */\0Astatic int platform_nv_seed_write_uninit(unsigned char *buf, size_t buf_len)\0A{\0A    ((void) buf);\0A    ((void) buf_len);\0A    return -1;\0A}\0A\0A#define MBEDTLS_PLATFORM_STD_NV_SEED_WRITE   platform_nv_seed_write_uninit\0A#endif /* !MBEDTLS_PLATFORM_STD_NV_SEED_WRITE */\0A\0Aint (*mbedtls_nv_seed_read)(unsigned char *buf, size_t buf_len) =\0A    MBEDTLS_PLATFORM_STD_NV_SEED_READ;\0Aint (*mbedtls_nv_seed_write)(unsigned char *buf, size_t buf_len) =\0A    MBEDTLS_PLATFORM_STD_NV_SEED_WRITE;\0A\0Aint mbedtls_platform_set_nv_seed(\0A    int (*nv_seed_read_func)(unsigned char *buf, size_t buf_len),\0A    int (*nv_seed_write_func)(unsigned char *buf, size_t buf_len))\0A{\0A    mbedtls_nv_seed_read = nv_seed_read_func;\0A    mbedtls_nv_seed_write = nv_seed_write_func;\0A    return 0;\0A}\0A#endif /* MBEDTLS_PLATFORM_NV_SEED_ALT */\0A#endif /* MBEDTLS_ENTROPY_NV_SEED */\0A\0A#if !defined(MBEDTLS_PLATFORM_SETUP_TEARDOWN_ALT)\0A/*\0A * Placeholder platform setup that does nothing by default\0A */\0Aint mbedtls_platform_setup(mbedtls_platform_context *ctx)\0A{\0A    (void) ctx;\0A\0A    return 0;\0A}\0A\0A/*\0A * Placeholder platform teardown that does nothing by default\0A */\0Avoid mbedtls_platform_teardown(mbedtls_platform_context *ctx)\0A{\0A    (void) ctx;\0A}\0A#endif /* MBEDTLS_PLATFORM_SETUP_TEARDOWN_ALT */\0A\0A#endif /* MBEDTLS_PLATFORM_C */\0A\00" }
