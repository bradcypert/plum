@.str41807 = private global { i64, i64, [57664 x i8] } { i64 -1, i64 57663, [57664 x i8] c"/**\0A * \5Cfile pk.h\0A *\0A * \5Cbrief Public Key abstraction layer\0A */\0A/*\0A *  Copyright The Mbed TLS Contributors\0A *  SPDX-License-Identifier: Apache-2.0 OR GPL-2.0-or-later\0A */\0A\0A#ifndef MBEDTLS_PK_H\0A#define MBEDTLS_PK_H\0A#include \22mbedtls/private_access.h\22\0A\0A#include \22mbedtls/build_info.h\22\0A\0A#include \22mbedtls/md.h\22\0A\0A#if defined(MBEDTLS_RSA_C)\0A#include \22mbedtls/rsa.h\22\0A#endif\0A\0A#if defined(MBEDTLS_ECP_C)\0A#include \22mbedtls/ecp.h\22\0A#endif\0A\0A#if defined(MBEDTLS_ECDSA_C)\0A#include \22mbedtls/ecdsa.h\22\0A#endif\0A\0A#if defined(MBEDTLS_PSA_CRYPTO_CLIENT)\0A#include \22psa/crypto.h\22\0A#endif\0A\0A/** Memory allocation failed. */\0A#define MBEDTLS_ERR_PK_ALLOC_FAILED        -0x3F80\0A/** Type mismatch, eg attempt to encrypt with an ECDSA key */\0A#define MBEDTLS_ERR_PK_TYPE_MISMATCH       -0x3F00\0A/** Bad input parameters to function. */\0A#define MBEDTLS_ERR_PK_BAD_INPUT_DATA      -0x3E80\0A/** Read/write of file failed. */\0A#define MBEDTLS_ERR_PK_FILE_IO_ERROR       -0x3E00\0A/** Unsupported key version */\0A#define MBEDTLS_ERR_PK_KEY_INVALID_VERSION -0x3D80\0A/** Invalid key tag or value. */\0A#define MBEDTLS_ERR_PK_KEY_INVALID_FORMAT  -0x3D00\0A/** Key algorithm is unsupported (only RSA and EC are supported). */\0A#define MBEDTLS_ERR_PK_UNKNOWN_PK_ALG      -0x3C80\0A/** Private key password can't be empty. */\0A#define MBEDTLS_ERR_PK_PASSWORD_REQUIRED   -0x3C00\0A/** Given private key password does not allow for correct decryption. */\0A#define MBEDTLS_ERR_PK_PASSWORD_MISMATCH   -0x3B80\0A/** The pubkey tag or value is invalid (only RSA and EC are supported). */\0A#define MBEDTLS_ERR_PK_INVALID_PUBKEY      -0x3B00\0A/** The algorithm tag or value is invalid. */\0A#define MBEDTLS_ERR_PK_INVALID_ALG         -0x3A80\0A/** Elliptic curve is unsupported (only NIST curves are supported). */\0A#define MBEDTLS_ERR_PK_UNKNOWN_NAMED_CURVE -0x3A00\0A/** Unavailable feature, e.g. RSA disabled for RSA key. */\0A#define MBEDTLS_ERR_PK_FEATURE_UNAVAILABLE -0x3980\0A/** The buffer contains a valid signature followed by more data. */\0A#define MBEDTLS_ERR_PK_SIG_LEN_MISMATCH    -0x3900\0A/** The output buffer is too small. */\0A#define MBEDTLS_ERR_PK_BUFFER_TOO_SMALL    -0x3880\0A\0A#ifdef __cplusplus\0Aextern \22C\22 {\0A#endif\0A\0A/**\0A * \5Cbrief          Public key types\0A */\0Atypedef enum {\0A    MBEDTLS_PK_NONE=0,\0A    MBEDTLS_PK_RSA,\0A    MBEDTLS_PK_ECKEY,\0A    MBEDTLS_PK_ECKEY_DH,\0A    MBEDTLS_PK_ECDSA,\0A    MBEDTLS_PK_RSA_ALT,\0A    MBEDTLS_PK_RSASSA_PSS,\0A    MBEDTLS_PK_OPAQUE,\0A} mbedtls_pk_type_t;\0A\0A/**\0A * \5Cbrief           Options for RSASSA-PSS signature verification.\0A *                  See \5Cc mbedtls_rsa_rsassa_pss_verify_ext()\0A */\0Atypedef struct mbedtls_pk_rsassa_pss_options {\0A    /** The digest to use for MGF1 in PSS.\0A     *\0A     * \5Cnote When #MBEDTLS_USE_PSA_CRYPTO is enabled and #MBEDTLS_RSA_C is\0A     *       disabled, this must be equal to the \5Cc md_alg argument passed\0A     *       to mbedtls_pk_verify_ext(). In a future version of the library,\0A     *       this constraint may apply whenever #MBEDTLS_USE_PSA_CRYPTO is\0A     *       enabled regardless of the status of #MBEDTLS_RSA_C.\0A     */\0A    mbedtls_md_type_t mgf1_hash_id;\0A\0A    /** The expected length of the salt, in bytes. This may be\0A     * #MBEDTLS_RSA_SALT_LEN_ANY to accept any salt length.\0A     *\0A     * \5Cnote When #MBEDTLS_USE_PSA_CRYPTO is enabled, only\0A     *       #MBEDTLS_RSA_SALT_LEN_ANY is valid. Any other value may be\0A     *       ignored (allowing any salt length).\0A     */\0A    int expected_salt_len;\0A\0A} mbedtls_pk_rsassa_pss_options;\0A\0A/**\0A * \5Cbrief           Maximum size of a signature made by mbedtls_pk_sign().\0A */\0A/* We need to set MBEDTLS_PK_SIGNATURE_MAX_SIZE to the maximum signature\0A * size among the supported signature types. Do it by starting at 0,\0A * then incrementally increasing to be large enough for each supported\0A * signature mechanism.\0A *\0A * The resulting value can be 0, for example if MBEDTLS_ECDH_C is enabled\0A * (which allows the pk module to be included) but neither MBEDTLS_ECDSA_C\0A * nor MBEDTLS_RSA_C nor any opaque signature mechanism (PSA or RSA_ALT).\0A */\0A#define MBEDTLS_PK_SIGNATURE_MAX_SIZE 0\0A\0A#if (defined(MBEDTLS_RSA_C) || defined(MBEDTLS_PK_RSA_ALT_SUPPORT)) && \5C\0A    MBEDTLS_MPI_MAX_SIZE > MBEDTLS_PK_SIGNATURE_MAX_SIZE\0A/* For RSA, the signature can be as large as the bignum module allows.\0A * For RSA_ALT, the signature size is not necessarily tied to what the\0A * bignum module can do, but in the absence of any specific setting,\0A * we use that (rsa_alt_sign_wrap in library/pk_wrap.h will check). */\0A#undef MBEDTLS_PK_SIGNATURE_MAX_SIZE\0A#define MBEDTLS_PK_SIGNATURE_MAX_SIZE MBEDTLS_MPI_MAX_SIZE\0A#endif\0A\0A#if defined(MBEDTLS_ECDSA_C) &&                                 \5C\0A    MBEDTLS_ECDSA_MAX_LEN > MBEDTLS_PK_SIGNATURE_MAX_SIZE\0A/* For ECDSA, the ecdsa module exports a constant for the maximum\0A * signature size. */\0A#undef MBEDTLS_PK_SIGNATURE_MAX_SIZE\0A#define MBEDTLS_PK_SIGNATURE_MAX_SIZE MBEDTLS_ECDSA_MAX_LEN\0A#endif\0A\0A#if defined(MBEDTLS_USE_PSA_CRYPTO)\0A#if PSA_SIGNATURE_MAX_SIZE > MBEDTLS_PK_SIGNATURE_MAX_SIZE\0A/* PSA_SIGNATURE_MAX_SIZE is the maximum size of a signature made\0A * through the PSA API in the PSA representation. */\0A#undef MBEDTLS_PK_SIGNATURE_MAX_SIZE\0A#define MBEDTLS_PK_SIGNATURE_MAX_SIZE PSA_SIGNATURE_MAX_SIZE\0A#endif\0A\0A#if PSA_VENDOR_ECDSA_SIGNATURE_MAX_SIZE + 11 > MBEDTLS_PK_SIGNATURE_MAX_SIZE\0A/* The Mbed TLS representation is different for ECDSA signatures:\0A * PSA uses the raw concatenation of r and s,\0A * whereas Mbed TLS uses the ASN.1 representation (SEQUENCE of two INTEGERs).\0A * Add the overhead of ASN.1: up to (1+2) + 2 * (1+2+1) for the\0A * types, lengths (represented by up to 2 bytes), and potential leading\0A * zeros of the INTEGERs and the SEQUENCE. */\0A#undef MBEDTLS_PK_SIGNATURE_MAX_SIZE\0A#define MBEDTLS_PK_SIGNATURE_MAX_SIZE (PSA_VENDOR_ECDSA_SIGNATURE_MAX_SIZE + 11)\0A#endif\0A#endif /* defined(MBEDTLS_USE_PSA_CRYPTO) */\0A\0A/* Internal helper to define which fields in the pk_context structure below\0A * should be used for EC keys: legacy ecp_keypair or the raw (PSA friendly)\0A * format. It should be noted that this only affects how data is stored, not\0A * which functions are used for various operations. The overall picture looks\0A * like this:\0A * - if USE_PSA is not defined and ECP_C is defined then use ecp_keypair data\0A *   structure and legacy functions\0A * - if USE_PSA is defined and\0A *     - if ECP_C then use ecp_keypair structure, convert data to a PSA friendly\0A *       format and use PSA functions\0A *     - if !ECP_C then use new raw data and PSA functions directly.\0A *\0A * The main reason for the \22intermediate\22 (USE_PSA + ECP_C) above is that as long\0A * as ECP_C is defined mbedtls_pk_ec() gives the user a read/write access to the\0A * ecp_keypair structure inside the pk_context so they can modify it using\0A * ECP functions which are not under PK module's control.\0A */\0A#if defined(MBEDTLS_USE_PSA_CRYPTO) && defined(PSA_WANT_KEY_TYPE_ECC_PUBLIC_KEY) && \5C\0A    !defined(MBEDTLS_ECP_C)\0A#define MBEDTLS_PK_USE_PSA_EC_DATA\0A#endif\0A\0A/**\0A * \5Cbrief           Types for interfacing with the debug module\0A */\0Atypedef enum {\0A    MBEDTLS_PK_DEBUG_NONE = 0,\0A    MBEDTLS_PK_DEBUG_MPI,\0A    MBEDTLS_PK_DEBUG_ECP,\0A    MBEDTLS_PK_DEBUG_PSA_EC,\0A} mbedtls_pk_debug_type;\0A\0A/**\0A * \5Cbrief           Item to send to the debug module\0A */\0Atypedef struct mbedtls_pk_debug_item {\0A    mbedtls_pk_debug_type MBEDTLS_PRIVATE(type);\0A    const char *MBEDTLS_PRIVATE(name);\0A    void *MBEDTLS_PRIVATE(value);\0A} mbedtls_pk_debug_item;\0A\0A/** Maximum number of item send for debugging, plus 1 */\0A#define MBEDTLS_PK_DEBUG_MAX_ITEMS 3\0A\0A/**\0A * \5Cbrief           Public key information and operations\0A *\0A * \5Cnote        The library does not support custom pk info structures,\0A *              only built-in structures returned by\0A *              mbedtls_cipher_info_from_type().\0A */\0Atypedef struct mbedtls_pk_info_t mbedtls_pk_info_t;\0A\0A#define MBEDTLS_PK_MAX_EC_PUBKEY_RAW_LEN \5C\0A    PSA_KEY_EXPORT_ECC_PUBLIC_KEY_MAX_SIZE(PSA_VENDOR_ECC_MAX_CURVE_BITS)\0A/**\0A * \5Cbrief           Public key container\0A */\0Atypedef struct mbedtls_pk_context {\0A    const mbedtls_pk_info_t *MBEDTLS_PRIVATE(pk_info);    /**< Public key information         */\0A    void *MBEDTLS_PRIVATE(pk_ctx);                        /**< Underlying public key context  */\0A    /* The following field is used to store the ID of a private key in the\0A     * following cases:\0A     * - opaque key when MBEDTLS_USE_PSA_CRYPTO is defined\0A     * - normal key when MBEDTLS_PK_USE_PSA_EC_DATA is defined. In this case:\0A     *    - the pk_ctx above is not not used to store the private key anymore.\0A     *      Actually that field not populated at all in this case because also\0A     *      the public key will be stored in raw format as explained below\0A     *    - this ID is used for all private key operations (ex: sign, check\0A     *      key pair, key write, etc) using PSA functions\0A     *\0A     * Note: this private key storing solution only affects EC keys, not the\0A     *       other ones. The latters still use the pk_ctx to store their own\0A     *       context. */\0A#if defined(MBEDTLS_USE_PSA_CRYPTO)\0A    mbedtls_svc_key_id_t MBEDTLS_PRIVATE(priv_id);      /**< Key ID for opaque keys */\0A#endif /* MBEDTLS_USE_PSA_CRYPTO */\0A    /* The following fields are meant for storing the public key in raw format\0A     * which is handy for:\0A     * - easily importing it into the PSA context\0A     * - reducing the ECP module dependencies in the PK one.\0A     *\0A     * When MBEDTLS_PK_USE_PSA_EC_DATA is enabled:\0A     * - the pk_ctx above is not used anymore for storing the public key\0A     *   inside the ecp_keypair structure\0A     * - the following fields are used for all public key operations: signature\0A     *   verify, key pair check and key write.\0A     * - For a key pair, priv_id contains the private key. For a public key,\0A     *   priv_id is null.\0A     * Of course, when MBEDTLS_PK_USE_PSA_EC_DATA is not enabled, the legacy\0A     * ecp_keypair structure is used for storing the public key and performing\0A     * all the operations.\0A     *\0A     * Note: This new public key storing solution only works for EC keys, not\0A     *       other ones. The latters still use pk_ctx to store their own\0A     *       context.\0A     */\0A#if defined(MBEDTLS_PK_USE_PSA_EC_DATA)\0A    uint8_t MBEDTLS_PRIVATE(pub_raw)[MBEDTLS_PK_MAX_EC_PUBKEY_RAW_LEN]; /**< Raw public key   */\0A    size_t MBEDTLS_PRIVATE(pub_raw_len);            /**< Valid bytes in \22pub_raw\22 */\0A    psa_ecc_family_t MBEDTLS_PRIVATE(ec_family);    /**< EC family of pk */\0A    size_t MBEDTLS_PRIVATE(ec_bits);                /**< Curve's bits of pk */\0A#endif /* MBEDTLS_PK_USE_PSA_EC_DATA */\0A} mbedtls_pk_context;\0A\0A#if defined(MBEDTLS_ECDSA_C) && defined(MBEDTLS_ECP_RESTARTABLE)\0A/**\0A * \5Cbrief           Context for resuming operations\0A */\0Atypedef struct {\0A    const mbedtls_pk_info_t *MBEDTLS_PRIVATE(pk_info);    /**< Public key information         */\0A    void *MBEDTLS_PRIVATE(rs_ctx);                        /**< Underlying restart context     */\0A} mbedtls_pk_restart_ctx;\0A#else /* MBEDTLS_ECDSA_C && MBEDTLS_ECP_RESTARTABLE */\0A/* Now we can declare functions that take a pointer to that */\0Atypedef void mbedtls_pk_restart_ctx;\0A#endif /* MBEDTLS_ECDSA_C && MBEDTLS_ECP_RESTARTABLE */\0A\0A#if defined(MBEDTLS_PK_RSA_ALT_SUPPORT)\0A/**\0A * \5Cbrief           Types for RSA-alt abstraction\0A */\0Atypedef int (*mbedtls_pk_rsa_alt_decrypt_func)(void *ctx, size_t *olen,\0A                                               const unsigned char *input, unsigned char *output,\0A                                               size_t output_max_len);\0Atypedef int (*mbedtls_pk_rsa_alt_sign_func)(void *ctx,\0A                                            int (*f_rng)(void *, unsigned char *, size_t),\0A                                            void *p_rng,\0A                                            mbedtls_md_type_t md_alg, unsigned int hashlen,\0A                                            const unsigned char *hash, unsigned char *sig);\0Atypedef size_t (*mbedtls_pk_rsa_alt_key_len_func)(void *ctx);\0A#endif /* MBEDTLS_PK_RSA_ALT_SUPPORT */\0A\0A/**\0A * \5Cbrief           Return information associated with the given PK type\0A *\0A * \5Cparam pk_type   PK type to search for.\0A *\0A * \5Creturn          The PK info associated with the type or NULL if not found.\0A */\0Aconst mbedtls_pk_info_t *mbedtls_pk_info_from_type(mbedtls_pk_type_t pk_type);\0A\0A/**\0A * \5Cbrief           Initialize a #mbedtls_pk_context (as NONE).\0A *\0A * \5Cparam ctx       The context to initialize.\0A *                  This must not be \5Cc NULL.\0A */\0Avoid mbedtls_pk_init(mbedtls_pk_context *ctx);\0A\0A/**\0A * \5Cbrief           Free the components of a #mbedtls_pk_context.\0A *\0A * \5Cparam ctx       The context to clear. It must have been initialized.\0A *                  If this is \5Cc NULL, this function does nothing.\0A *\0A * \5Cnote            For contexts that have been set up with\0A *                  mbedtls_pk_setup_opaque(), this does not free the underlying\0A *                  PSA key and you still need to call psa_destroy_key()\0A *                  independently if you want to destroy that key.\0A */\0Avoid mbedtls_pk_free(mbedtls_pk_context *ctx);\0A\0A#if defined(MBEDTLS_ECDSA_C) && defined(MBEDTLS_ECP_RESTARTABLE)\0A/**\0A * \5Cbrief           Initialize a restart context\0A *\0A * \5Cparam ctx       The context to initialize.\0A *                  This must not be \5Cc NULL.\0A */\0Avoid mbedtls_pk_restart_init(mbedtls_pk_restart_ctx *ctx);\0A\0A/**\0A * \5Cbrief           Free the components of a restart context\0A *\0A * \5Cparam ctx       The context to clear. It must have been initialized.\0A *                  If this is \5Cc NULL, this function does nothing.\0A */\0Avoid mbedtls_pk_restart_free(mbedtls_pk_restart_ctx *ctx);\0A#endif /* MBEDTLS_ECDSA_C && MBEDTLS_ECP_RESTARTABLE */\0A\0A/**\0A * \5Cbrief           Initialize a PK context with the information given\0A *                  and allocates the type-specific PK subcontext.\0A *\0A * \5Cparam ctx       Context to initialize. It must not have been set\0A *                  up yet (type #MBEDTLS_PK_NONE).\0A * \5Cparam info      Information to use\0A *\0A * \5Creturn          0 on success,\0A *                  MBEDTLS_ERR_PK_BAD_INPUT_DATA on invalid input,\0A *                  MBEDTLS_ERR_PK_ALLOC_FAILED on allocation failure.\0A *\0A * \5Cnote            For contexts holding an RSA-alt key, use\0A *                  \5Cc mbedtls_pk_setup_rsa_alt() instead.\0A */\0Aint mbedtls_pk_setup(mbedtls_pk_context *ctx, const mbedtls_pk_info_t *info);\0A\0A#if defined(MBEDTLS_USE_PSA_CRYPTO)\0A/**\0A * \5Cbrief Initialize a PK context to wrap a PSA key.\0A *\0A * This function creates a PK context which wraps a PSA key. The PSA wrapped\0A * key must be an EC or RSA key pair (DH is not suported in the PK module).\0A *\0A * Under the hood PSA functions will be used to perform the required\0A * operations and, based on the key type, used algorithms will be:\0A * * EC:\0A *     * verify, verify_ext, sign, sign_ext: ECDSA.\0A * * RSA:\0A *     * sign, decrypt: use the primary algorithm in the wrapped PSA key;\0A *     * sign_ext: RSA PSS if the pk_type is #MBEDTLS_PK_RSASSA_PSS, otherwise\0A *       it falls back to the sign() case;\0A *     * verify, verify_ext, encrypt: not supported.\0A *\0A * In order for the above operations to succeed, the policy of the wrapped PSA\0A * key must allow the specified algorithm.\0A *\0A * Opaque PK contexts wrapping an EC keys also support \5Cc mbedtls_pk_check_pair(),\0A * whereas RSA ones do not.\0A *\0A * \5Cwarning The PSA wrapped key must remain valid as long as the wrapping PK\0A *          context is in use, that is at least between the point this function\0A *          is called and the point mbedtls_pk_free() is called on this context.\0A *\0A * \5Cparam ctx The context to initialize. It must be empty (type NONE).\0A * \5Cparam key The PSA key to wrap, which must hold an ECC or RSA key pair.\0A *\0A * \5Creturn    \5Cc 0 on success.\0A * \5Creturn    #MBEDTLS_ERR_PK_BAD_INPUT_DATA on invalid input (context already\0A *            used, invalid key identifier).\0A * \5Creturn    #MBEDTLS_ERR_PK_FEATURE_UNAVAILABLE if the key is not an ECC or\0A *            RSA key pair.\0A * \5Creturn    #MBEDTLS_ERR_PK_ALLOC_FAILED on allocation failure.\0A */\0Aint mbedtls_pk_setup_opaque(mbedtls_pk_context *ctx,\0A                            const mbedtls_svc_key_id_t key);\0A#endif /* MBEDTLS_USE_PSA_CRYPTO */\0A\0A#if defined(MBEDTLS_PK_RSA_ALT_SUPPORT)\0A/**\0A * \5Cbrief           Initialize an RSA-alt context\0A *\0A * \5Cparam ctx       Context to initialize. It must not have been set\0A *                  up yet (type #MBEDTLS_PK_NONE).\0A * \5Cparam key       RSA key pointer\0A * \5Cparam decrypt_func  Decryption function\0A * \5Cparam sign_func     Signing function\0A * \5Cparam key_len_func  Function returning key length in bytes\0A *\0A * \5Creturn          0 on success, or MBEDTLS_ERR_PK_BAD_INPUT_DATA if the\0A *                  context wasn't already initialized as RSA_ALT.\0A *\0A * \5Cnote            This function replaces \5Cc mbedtls_pk_setup() for RSA-alt.\0A */\0Aint mbedtls_pk_setup_rsa_alt(mbedtls_pk_context *ctx, void *key,\0A                             mbedtls_pk_rsa_alt_decrypt_func decrypt_func,\0A                             mbedtls_pk_rsa_alt_sign_func sign_func,\0A                             mbedtls_pk_rsa_alt_key_len_func key_len_func);\0A#endif /* MBEDTLS_PK_RSA_ALT_SUPPORT */\0A\0A/**\0A * \5Cbrief           Get the size in bits of the underlying key\0A *\0A * \5Cparam ctx       The context to query. It must have been initialized.\0A *\0A * \5Creturn          Key size in bits, or 0 on error\0A */\0Asize_t mbedtls_pk_get_bitlen(const mbedtls_pk_context *ctx);\0A\0A/**\0A * \5Cbrief           Get the length in bytes of the underlying key\0A *\0A * \5Cparam ctx       The context to query. It must have been initialized.\0A *\0A * \5Creturn          Key length in bytes, or 0 on error\0A */\0Astatic inline size_t mbedtls_pk_get_len(const mbedtls_pk_context *ctx)\0A{\0A    return (mbedtls_pk_get_bitlen(ctx) + 7) / 8;\0A}\0A\0A/**\0A * \5Cbrief           Tell if a context can do the operation given by type\0A *\0A * \5Cparam ctx       The context to query. It must have been initialized.\0A * \5Cparam type      The desired type.\0A *\0A * \5Creturn          1 if the context can do operations on the given type.\0A * \5Creturn          0 if the context cannot do the operations on the given\0A *                  type. This is always the case for a context that has\0A *                  been initialized but not set up, or that has been\0A *                  cleared with mbedtls_pk_free().\0A */\0Aint mbedtls_pk_can_do(const mbedtls_pk_context *ctx, mbedtls_pk_type_t type);\0A\0A#if defined(MBEDTLS_USE_PSA_CRYPTO)\0A/**\0A * \5Cbrief           Tell if context can do the operation given by PSA algorithm\0A *\0A * \5Cparam ctx       The context to query. It must have been initialized.\0A * \5Cparam alg       PSA algorithm to check against, the following are allowed:\0A *                  PSA_ALG_RSA_PKCS1V15_SIGN(hash),\0A *                  PSA_ALG_RSA_PSS(hash),\0A *                  PSA_ALG_RSA_PKCS1V15_CRYPT,\0A *                  PSA_ALG_ECDSA(hash),\0A *                  PSA_ALG_ECDH, where hash is a specific hash.\0A * \5Cparam usage     PSA usage flag to check against, must be composed of:\0A *                  PSA_KEY_USAGE_SIGN_HASH\0A *                  PSA_KEY_USAGE_DECRYPT\0A *                  PSA_KEY_USAGE_DERIVE.\0A *                  Context key must match all passed usage flags.\0A *\0A * \5Cwarning         Since the set of allowed algorithms and usage flags may be\0A *                  expanded in the future, the return value \5Cc 0 should not\0A *                  be taken in account for non-allowed algorithms and usage\0A *                  flags.\0A *\0A * \5Creturn          1 if the context can do operations on the given type.\0A * \5Creturn          0 if the context cannot do the operations on the given\0A *                  type, for non-allowed algorithms and usage flags, or\0A *                  for a context that has been initialized but not set up\0A *                  or that has been cleared with mbedtls_pk_free().\0A */\0Aint mbedtls_pk_can_do_ext(const mbedtls_pk_context *ctx, psa_algorithm_t alg,\0A                          psa_key_usage_t usage);\0A#endif /* MBEDTLS_USE_PSA_CRYPTO */\0A\0A#if defined(MBEDTLS_PSA_CRYPTO_CLIENT)\0A/**\0A * \5Cbrief           Determine valid PSA attributes that can be used to\0A *                  import a key into PSA.\0A *\0A * The attributes determined by this function are suitable\0A * for calling mbedtls_pk_import_into_psa() to create\0A * a PSA key with the same key material.\0A *\0A * The typical flow of operations involving this function is\0A * ```\0A * psa_key_attributes_t attributes = PSA_KEY_ATTRIBUTES_INIT;\0A * int ret = mbedtls_pk_get_psa_attributes(pk, &attributes);\0A * if (ret != 0) ...; // error handling omitted\0A * // Tweak attributes if desired\0A * psa_key_id_t key_id = 0;\0A * ret = mbedtls_pk_import_into_psa(pk, &attributes, &key_id);\0A * if (ret != 0) ...; // error handling omitted\0A * ```\0A *\0A * \5Cnote            This function does not support RSA-alt contexts\0A *                  (set up with mbedtls_pk_setup_rsa_alt()).\0A *\0A * \5Cparam[in] pk    The PK context to use. It must have been set up.\0A *                  It can either contain a key pair or just a public key.\0A * \5Cparam usage     A single `PSA_KEY_USAGE_xxx` flag among the following:\0A *                  - #PSA_KEY_USAGE_DECRYPT: \5Cp pk must contain a\0A *                    key pair. The output \5Cp attributes will contain a\0A *                    key pair type, and the usage policy will allow\0A *                    #PSA_KEY_USAGE_ENCRYPT as well as\0A *                    #PSA_KEY_USAGE_DECRYPT.\0A *                  - #PSA_KEY_USAGE_DERIVE: \5Cp pk must contain a\0A *                    key pair. The output \5Cp attributes will contain a\0A *                    key pair type.\0A *                  - #PSA_KEY_USAGE_ENCRYPT: The output\0A *                    \5Cp attributes will contain a public key type.\0A *                  - #PSA_KEY_USAGE_SIGN_HASH: \5Cp pk must contain a\0A *                    key pair. The output \5Cp attributes will contain a\0A *                    key pair type, and the usage policy will allow\0A *                    #PSA_KEY_USAGE_VERIFY_HASH as well as\0A *                    #PSA_KEY_USAGE_SIGN_HASH.\0A *                  - #PSA_KEY_USAGE_SIGN_MESSAGE: \5Cp pk must contain a\0A *                    key pair. The output \5Cp attributes will contain a\0A *                    key pair type, and the usage policy will allow\0A *                    #PSA_KEY_USAGE_VERIFY_MESSAGE as well as\0A *                    #PSA_KEY_USAGE_SIGN_MESSAGE.\0A *                  - #PSA_KEY_USAGE_VERIFY_HASH: The output\0A *                    \5Cp attributes will contain a public key type.\0A *                  - #PSA_KEY_USAGE_VERIFY_MESSAGE: The output\0A *                    \5Cp attributes will contain a public key type.\0A * \5Cparam[out] attributes\0A *                  On success, valid attributes to import the key into PSA.\0A *                  - The lifetime and key identifier are unchanged. If the\0A *                    attribute structure was initialized or reset before\0A *                    calling this function, this will result in a volatile\0A *                    key. Call psa_set_key_identifier() before or after this\0A *                    function if you wish to create a persistent key. Call\0A *                    psa_set_key_lifetime() before or after this function if\0A *                    you wish to import the key in a secure element.\0A *                  - The key type and bit-size are determined by the contents\0A *                    of the PK context. If the PK context contains a key\0A *                    pair, the key type can be either a key pair type or\0A *                    the corresponding public key type, depending on\0A *                    \5Cp usage. If the PK context contains a public key,\0A *                    the key type is a public key type.\0A *                  - The key's policy is determined by the key type and\0A *                    the \5Cp usage parameter. The usage always allows\0A *                    \5Cp usage, exporting and copying the key, and\0A *                    possibly other permissions as documented for the\0A *                    \5Cp usage parameter.\0A *                    The permitted algorithm policy is determined as follows\0A *                    based on the #mbedtls_pk_type_t type of \5Cp pk,\0A *                    the chosen \5Cp usage and other factors:\0A *                      - #MBEDTLS_PK_RSA whose underlying\0A *                        #mbedtls_rsa_context has the padding mode\0A *                        #MBEDTLS_RSA_PKCS_V15:\0A *                        #PSA_ALG_RSA_PKCS1V15_SIGN(#PSA_ALG_ANY_HASH)\0A *                        if \5Cp usage is SIGN/VERIFY, and\0A *                        #PSA_ALG_RSA_PKCS1V15_CRYPT\0A *                        if \5Cp usage is ENCRYPT/DECRYPT.\0A *                      - #MBEDTLS_PK_RSA whose underlying\0A *                        #mbedtls_rsa_context has the padding mode\0A *                        #MBEDTLS_RSA_PKCS_V21 and the digest type\0A *                        corresponding to the PSA algorithm \5Cc hash:\0A *                        #PSA_ALG_RSA_PSS_ANY_SALT(#PSA_ALG_ANY_HASH)\0A *                        if \5Cp usage is SIGN/VERIFY, and\0A *                        #PSA_ALG_RSA_OAEP(\5Cc hash)\0A *                        if \5Cp usage is ENCRYPT/DECRYPT.\0A *                      - #MBEDTLS_PK_RSA_ALT: not supported.\0A *                      - #MBEDTLS_PK_ECDSA or #MBEDTLS_PK_ECKEY\0A *                        if \5Cp usage is SIGN/VERIFY:\0A *                        #PSA_ALG_DETERMINISTIC_ECDSA(#PSA_ALG_ANY_HASH)\0A *                        if #MBEDTLS_ECDSA_DETERMINISTIC is enabled,\0A *                        otherwise #PSA_ALG_ECDSA(#PSA_ALG_ANY_HASH).\0A *                      - #MBEDTLS_PK_ECKEY_DH or #MBEDTLS_PK_ECKEY\0A *                        if \5Cp usage is DERIVE:\0A *                        #PSA_ALG_ECDH.\0A *                      - #MBEDTLS_PK_OPAQUE: same as the primary algorithm\0A *                        set for the underlying PSA key, except that\0A *                        sign/decrypt flags are removed if the type is\0A *                        set to a public key type.\0A *                        The underlying key must allow \5Cp usage.\0A *                        Note that the enrollment algorithm set with\0A *                        psa_set_key_enrollment_algorithm() is not copied.\0A *\0A * \5Creturn          0 on success.\0A *                  #MBEDTLS_ERR_PK_TYPE_MISMATCH if \5Cp pk does not contain\0A *                  a key of the type identified in \5Cp attributes.\0A *                  Another error code on other failures.\0A */\0Aint mbedtls_pk_get_psa_attributes(const mbedtls_pk_context *pk,\0A                                  psa_key_usage_t usage,\0A                                  psa_key_attributes_t *attributes);\0A\0A/**\0A * \5Cbrief           Import a key into the PSA key store.\0A *\0A * This function is equivalent to calling psa_import_key()\0A * with the key material from \5Cp pk.\0A *\0A * The typical way to use this function is:\0A * -# Call mbedtls_pk_get_psa_attributes() to obtain\0A *    attributes for the given key.\0A * -# If desired, modify the attributes, for example:\0A *     - To create a persistent key, call\0A *       psa_set_key_identifier() and optionally\0A *       psa_set_key_lifetime().\0A *     - To import only the public part of a key pair:\0A *\0A *           psa_set_key_type(&attributes,\0A *                            PSA_KEY_TYPE_PUBLIC_KEY_OF_KEY_PAIR(\0A *                                psa_get_key_type(&attributes)));\0A *     - Restrict the key usage if desired.\0A * -# Call mbedtls_pk_import_into_psa().\0A *\0A * \5Cnote            This function does not support RSA-alt contexts\0A *                  (set up with mbedtls_pk_setup_rsa_alt()).\0A *\0A * \5Cparam[in] pk    The PK context to use. It must have been set up.\0A *                  It can either contain a key pair or just a public key.\0A * \5Cparam[in] attributes\0A *                  The attributes to use for the new key. They must be\0A *                  compatible with \5Cp pk. In particular, the key type\0A *                  must match the content of \5Cp pk.\0A *                  If \5Cp pk contains a key pair, the key type in\0A *                  attributes can be either the key pair type or the\0A *                  corresponding public key type (to import only the\0A *                  public part).\0A * \5Cparam[out] key_id\0A *                  On success, the identifier of the newly created key.\0A *                  On error, this is #MBEDTLS_SVC_KEY_ID_INIT.\0A *\0A * \5Creturn          0 on success.\0A *                  #MBEDTLS_ERR_PK_TYPE_MISMATCH if \5Cp pk does not contain\0A *                  a key of the type identified in \5Cp attributes.\0A *                  Another error code on other failures.\0A */\0Aint mbedtls_pk_import_into_psa(const mbedtls_pk_context *pk,\0A                               const psa_key_attributes_t *attributes,\0A                               mbedtls_svc_key_id_t *key_id);\0A\0A/**\0A * \5Cbrief           Create a PK context starting from a key stored in PSA.\0A *                  This key:\0A *                  - must be exportable and\0A *                  - must be an RSA or EC key pair or public key (FFDH is not supported in PK).\0A *\0A *                  The resulting PK object will be a transparent type:\0A *                  - #MBEDTLS_PK_RSA for RSA keys or\0A *                  - #MBEDTLS_PK_ECKEY for EC keys.\0A *\0A *                  Once this functions returns the PK object will be completely\0A *                  independent from the original PSA key that it was generated\0A *                  from.\0A *                  Calling mbedtls_pk_sign(), mbedtls_pk_verify(),\0A *                  mbedtls_pk_encrypt(), mbedtls_pk_decrypt() on the resulting\0A *                  PK context will perform the corresponding algorithm for that\0A *                  PK context type.\0A *                  * For ECDSA, the choice of deterministic vs randomized will\0A *                    be based on the compile-time setting #MBEDTLS_ECDSA_DETERMINISTIC.\0A *                  * For an RSA key, the output PK context will allow both\0A *                    encrypt/decrypt and sign/verify regardless of the original\0A *                    key's policy.\0A *                    The original key's policy determines the output key's padding\0A *                    mode: PCKS1 v2.1 is set if the PSA key policy is OAEP or PSS,\0A *                    otherwise PKCS1 v1.5 is set.\0A *\0A * \5Cparam key_id    The key identifier of the key stored in PSA.\0A * \5Cparam pk        The PK context that will be filled. It must be initialized,\0A *                  but not set up.\0A *\0A * \5Creturn          0 on success.\0A * \5Creturn          #MBEDTLS_ERR_PK_BAD_INPUT_DATA in case the provided input\0A *                  parameters are not correct.\0A */\0Aint mbedtls_pk_copy_from_psa(mbedtls_svc_key_id_t key_id, mbedtls_pk_context *pk);\0A\0A/**\0A * \5Cbrief           Create a PK context for the public key of a PSA key.\0A *\0A *                  The key must be an RSA or ECC key. It can be either a\0A *                  public key or a key pair, and only the public key is copied.\0A *                  The resulting PK object will be a transparent type:\0A *                  - #MBEDTLS_PK_RSA for RSA keys or\0A *                  - #MBEDTLS_PK_ECKEY for EC keys.\0A *\0A *                  Once this functions returns the PK object will be completely\0A *                  independent from the original PSA key that it was generated\0A *                  from.\0A *                  Calling mbedtls_pk_verify() or\0A *                  mbedtls_pk_encrypt() on the resulting\0A *                  PK context will perform the corresponding algorithm for that\0A *                  PK context type.\0A *\0A *                  For an RSA key, the output PK context will allow both\0A *                  encrypt and verify regardless of the original key's policy.\0A *                  The original key's policy determines the output key's padding\0A *                  mode: PCKS1 v2.1 is set if the PSA key policy is OAEP or PSS,\0A *                  otherwise PKCS1 v1.5 is set.\0A *\0A * \5Cparam key_id    The key identifier of the key stored in PSA.\0A * \5Cparam pk        The PK context that will be filled. It must be initialized,\0A *                  but not set up.\0A *\0A * \5Creturn          0 on success.\0A * \5Creturn          MBEDTLS_ERR_PK_BAD_INPUT_DATA in case the provided input\0A *                  parameters are not correct.\0A */\0Aint mbedtls_pk_copy_public_from_psa(mbedtls_svc_key_id_t key_id, mbedtls_pk_context *pk);\0A#endif /* MBEDTLS_PSA_CRYPTO_CLIENT */\0A\0A/**\0A * \5Cbrief           Verify signature (including padding if relevant).\0A *\0A * \5Cparam ctx       The PK context to use. It must have been set up.\0A * \5Cparam md_alg    Hash algorithm used.\0A *                  This can be #MBEDTLS_MD_NONE if the signature algorithm\0A *                  does not rely on a hash algorithm (non-deterministic\0A *                  ECDSA, RSA PKCS#1 v1.5).\0A *                  For PKCS#1 v1.5, if \5Cp md_alg is #MBEDTLS_MD_NONE, then\0A *                  \5Cp hash is the DigestInfo structure used by RFC 8017\0A *                  &sect;9.2 steps 3&ndash;6. If \5Cp md_alg is a valid hash\0A *                  algorithm then \5Cp hash is the digest itself, and this\0A *                  function calculates the DigestInfo encoding internally.\0A * \5Cparam hash      Hash of the message to sign\0A * \5Cparam hash_len  Hash length\0A * \5Cparam sig       Signature to verify\0A * \5Cparam sig_len   Signature length\0A *\0A * \5Cnote            For keys of type #MBEDTLS_PK_RSA, the signature algorithm is\0A *                  either PKCS#1 v1.5 or PSS (accepting any salt length),\0A *                  depending on the padding mode in the underlying RSA context.\0A *                  For a pk object constructed by parsing, this is PKCS#1 v1.5\0A *                  by default. Use mbedtls_pk_verify_ext() to explicitly select\0A *                  a different algorithm.\0A *\0A * \5Creturn          0 on success (signature is valid),\0A *                  #MBEDTLS_ERR_PK_SIG_LEN_MISMATCH if there is a valid\0A *                  signature in \5Cp sig but its length is less than \5Cp sig_len,\0A *                  or a specific error code.\0A */\0Aint mbedtls_pk_verify(mbedtls_pk_context *ctx, mbedtls_md_type_t md_alg,\0A                      const unsigned char *hash, size_t hash_len,\0A                      const unsigned char *sig, size_t sig_len);\0A\0A/**\0A * \5Cbrief           Restartable version of \5Cc mbedtls_pk_verify()\0A *\0A * \5Cnote            Performs the same job as \5Cc mbedtls_pk_verify(), but can\0A *                  return early and restart according to the limit set with\0A *                  \5Cc mbedtls_ecp_set_max_ops() to reduce blocking for ECC\0A *                  operations. For RSA, same as \5Cc mbedtls_pk_verify().\0A *\0A * \5Cparam ctx       The PK context to use. It must have been set up.\0A * \5Cparam md_alg    Hash algorithm used (see notes)\0A * \5Cparam hash      Hash of the message to sign\0A * \5Cparam hash_len  Hash length or 0 (see notes)\0A * \5Cparam sig       Signature to verify\0A * \5Cparam sig_len   Signature length\0A * \5Cparam rs_ctx    Restart context (NULL to disable restart)\0A *\0A * \5Creturn          See \5Cc mbedtls_pk_verify(), or\0A * \5Creturn          #MBEDTLS_ERR_ECP_IN_PROGRESS if maximum number of\0A *                  operations was reached: see \5Cc mbedtls_ecp_set_max_ops().\0A */\0Aint mbedtls_pk_verify_restartable(mbedtls_pk_context *ctx,\0A                                  mbedtls_md_type_t md_alg,\0A                                  const unsigned char *hash, size_t hash_len,\0A                                  const unsigned char *sig, size_t sig_len,\0A                                  mbedtls_pk_restart_ctx *rs_ctx);\0A\0A/**\0A * \5Cbrief           Verify signature, with options.\0A *                  (Includes verification of the padding depending on type.)\0A *\0A * \5Cparam type      Signature type (inc. possible padding type) to verify\0A * \5Cparam options   Pointer to type-specific options, or NULL\0A * \5Cparam ctx       The PK context to use. It must have been set up.\0A * \5Cparam md_alg    Hash algorithm used (see notes)\0A * \5Cparam hash      Hash of the message to sign\0A * \5Cparam hash_len  Hash length or 0 (see notes)\0A * \5Cparam sig       Signature to verify\0A * \5Cparam sig_len   Signature length\0A *\0A * \5Creturn          0 on success (signature is valid),\0A *                  #MBEDTLS_ERR_PK_TYPE_MISMATCH if the PK context can't be\0A *                  used for this type of signatures,\0A *                  #MBEDTLS_ERR_PK_SIG_LEN_MISMATCH if there is a valid\0A *                  signature in \5Cp sig but its length is less than \5Cp sig_len,\0A *                  or a specific error code.\0A *\0A * \5Cnote            If hash_len is 0, then the length associated with md_alg\0A *                  is used instead, or an error returned if it is invalid.\0A *\0A * \5Cnote            md_alg may be MBEDTLS_MD_NONE, only if hash_len != 0\0A *\0A * \5Cnote            If type is MBEDTLS_PK_RSASSA_PSS, then options must point\0A *                  to a mbedtls_pk_rsassa_pss_options structure,\0A *                  otherwise it must be NULL. Note that if\0A *                  #MBEDTLS_USE_PSA_CRYPTO is defined, the salt length is not\0A *                  verified as PSA_ALG_RSA_PSS_ANY_SALT is used.\0A */\0Aint mbedtls_pk_verify_ext(mbedtls_pk_type_t type, const void *options,\0A                          mbedtls_pk_context *ctx, mbedtls_md_type_t md_alg,\0A                          const unsigned char *hash, size_t hash_len,\0A                          const unsigned char *sig, size_t sig_len);\0A\0A/**\0A * \5Cbrief           Make signature, including padding if relevant.\0A *\0A * \5Cparam ctx       The PK context to use. It must have been set up\0A *                  with a private key.\0A * \5Cparam md_alg    Hash algorithm used (see notes)\0A * \5Cparam hash      Hash of the message to sign\0A * \5Cparam hash_len  Hash length\0A * \5Cparam sig       Place to write the signature.\0A *                  It must have enough room for the signature.\0A *                  #MBEDTLS_PK_SIGNATURE_MAX_SIZE is always enough.\0A *                  You may use a smaller buffer if it is large enough\0A *                  given the key type.\0A * \5Cparam sig_size  The size of the \5Cp sig buffer in bytes.\0A * \5Cparam sig_len   On successful return,\0A *                  the number of bytes written to \5Cp sig.\0A * \5Cparam f_rng     RNG function, must not be \5Cc NULL.\0A * \5Cparam p_rng     RNG parameter\0A *\0A * \5Cnote            For keys of type #MBEDTLS_PK_RSA, the signature algorithm is\0A *                  either PKCS#1 v1.5 or PSS (using the largest possible salt\0A *                  length up to the hash length), depending on the padding mode\0A *                  in the underlying RSA context. For a pk object constructed\0A *                  by parsing, this is PKCS#1 v1.5 by default. Use\0A *                  mbedtls_pk_verify_ext() to explicitly select a different\0A *                  algorithm.\0A *\0A * \5Creturn          0 on success, or a specific error code.\0A *\0A * \5Cnote            For RSA, md_alg may be MBEDTLS_MD_NONE if hash_len != 0.\0A *                  For ECDSA, md_alg may never be MBEDTLS_MD_NONE.\0A */\0Aint mbedtls_pk_sign(mbedtls_pk_context *ctx, mbedtls_md_type_t md_alg,\0A                    const unsigned char *hash, size_t hash_len,\0A                    unsigned char *sig, size_t sig_size, size_t *sig_len,\0A                    int (*f_rng)(void *, unsigned char *, size_t), void *p_rng);\0A\0A/**\0A * \5Cbrief           Make signature given a signature type.\0A *\0A * \5Cparam pk_type   Signature type.\0A * \5Cparam ctx       The PK context to use. It must have been set up\0A *                  with a private key.\0A * \5Cparam md_alg    Hash algorithm used (see notes)\0A * \5Cparam hash      Hash of the message to sign\0A * \5Cparam hash_len  Hash length\0A * \5Cparam sig       Place to write the signature.\0A *                  It must have enough room for the signature.\0A *                  #MBEDTLS_PK_SIGNATURE_MAX_SIZE is always enough.\0A *                  You may use a smaller buffer if it is large enough\0A *                  given the key type.\0A * \5Cparam sig_size  The size of the \5Cp sig buffer in bytes.\0A * \5Cparam 