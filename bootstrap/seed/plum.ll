@.str46437 = private global { i64, i64, [15025 x i8] } { i64 -1, i64 15024, [15025 x i8] c"/*\0A *  PSA MAC layer on top of Mbed TLS software crypto\0A */\0A/*\0A *  Copyright The Mbed TLS Contributors\0A *  SPDX-License-Identifier: Apache-2.0 OR GPL-2.0-or-later\0A */\0A\0A#include \22common.h\22\0A\0A#if defined(MBEDTLS_PSA_CRYPTO_C)\0A\0A#include <psa/crypto.h>\0A#include \22psa_crypto_core.h\22\0A#include \22psa_crypto_cipher.h\22\0A#include \22psa_crypto_mac.h\22\0A#include <mbedtls/md.h>\0A\0A#include <mbedtls/error.h>\0A#include \22mbedtls/constant_time.h\22\0A#include <string.h>\0A\0A#if defined(MBEDTLS_PSA_BUILTIN_ALG_HMAC)\0Astatic psa_status_t psa_hmac_abort_internal(\0A    mbedtls_psa_hmac_operation_t *hmac)\0A{\0A    mbedtls_platform_zeroize(hmac->opad, sizeof(hmac->opad));\0A    return psa_hash_abort(&hmac->hash_ctx);\0A}\0A\0Astatic psa_status_t psa_hmac_setup_internal(\0A    mbedtls_psa_hmac_operation_t *hmac,\0A    const uint8_t *key,\0A    size_t key_length,\0A    psa_algorithm_t hash_alg)\0A{\0A    uint8_t ipad[PSA_HMAC_MAX_HASH_BLOCK_SIZE];\0A    size_t i;\0A    size_t hash_size = PSA_HASH_LENGTH(hash_alg);\0A    size_t block_size = PSA_HASH_BLOCK_LENGTH(hash_alg);\0A    psa_status_t status;\0A\0A    hmac->alg = hash_alg;\0A\0A    /* Sanity checks on block_size, to guarantee that there won't be a buffer\0A     * overflow below. This should never trigger if the hash algorithm\0A     * is implemented correctly. */\0A    /* The size checks against the ipad and opad buffers cannot be written\0A     * `block_size > sizeof( ipad ) || block_size > sizeof( hmac->opad )`\0A     * because that triggers -Wlogical-op on GCC 7.3. */\0A    if (block_size > sizeof(ipad)) {\0A        return PSA_ERROR_NOT_SUPPORTED;\0A    }\0A    if (block_size > sizeof(hmac->opad)) {\0A        return PSA_ERROR_NOT_SUPPORTED;\0A    }\0A    if (block_size < hash_size) {\0A        return PSA_ERROR_NOT_SUPPORTED;\0A    }\0A\0A    if (key_length > block_size) {\0A        status = psa_hash_compute(hash_alg, key, key_length,\0A                                  ipad, sizeof(ipad), &key_length);\0A        if (status != PSA_SUCCESS) {\0A            goto cleanup;\0A        }\0A    }\0A    /* A 0-length key is not commonly used in HMAC when used as a MAC,\0A     * but it is permitted. It is common when HMAC is used in HKDF, for\0A     * example. Don't call `memcpy` in the 0-length because `key` could be\0A     * an invalid pointer which would make the behavior undefined. */\0A    else if (key_length != 0) {\0A        memcpy(ipad, key, key_length);\0A    }\0A\0A    /* ipad contains the key followed by garbage. Xor and fill with 0x36\0A     * to create the ipad value. */\0A    for (i = 0; i < key_length; i++) {\0A        ipad[i] ^= 0x36;\0A    }\0A    memset(ipad + key_length, 0x36, block_size - key_length);\0A\0A    /* Copy the key material from ipad to opad, flipping the requisite bits,\0A     * and filling the rest of opad with the requisite constant. */\0A    for (i = 0; i < key_length; i++) {\0A        hmac->opad[i] = ipad[i] ^ 0x36 ^ 0x5C;\0A    }\0A    memset(hmac->opad + key_length, 0x5C, block_size - key_length);\0A\0A    status = psa_hash_setup(&hmac->hash_ctx, hash_alg);\0A    if (status != PSA_SUCCESS) {\0A        goto cleanup;\0A    }\0A\0A    status = psa_hash_update(&hmac->hash_ctx, ipad, block_size);\0A\0Acleanup:\0A    mbedtls_platform_zeroize(ipad, sizeof(ipad));\0A\0A    return status;\0A}\0A\0Astatic psa_status_t psa_hmac_update_internal(\0A    mbedtls_psa_hmac_operation_t *hmac,\0A    const uint8_t *data,\0A    size_t data_length)\0A{\0A    return psa_hash_update(&hmac->hash_ctx, data, data_length);\0A}\0A\0Astatic psa_status_t psa_hmac_finish_internal(\0A    mbedtls_psa_hmac_operation_t *hmac,\0A    uint8_t *mac,\0A    size_t mac_size)\0A{\0A    uint8_t tmp[PSA_HASH_MAX_SIZE];\0A    psa_algorithm_t hash_alg = hmac->alg;\0A    size_t hash_size = 0;\0A    size_t block_size = PSA_HASH_BLOCK_LENGTH(hash_alg);\0A    psa_status_t status;\0A\0A    status = psa_hash_finish(&hmac->hash_ctx, tmp, sizeof(tmp), &hash_size);\0A    if (status != PSA_SUCCESS) {\0A        return status;\0A    }\0A    /* From here on, tmp needs to be wiped. */\0A\0A    status = psa_hash_setup(&hmac->hash_ctx, hash_alg);\0A    if (status != PSA_SUCCESS) {\0A        goto exit;\0A    }\0A\0A    status = psa_hash_update(&hmac->hash_ctx, hmac->opad, block_size);\0A    if (status != PSA_SUCCESS) {\0A        goto exit;\0A    }\0A\0A    status = psa_hash_update(&hmac->hash_ctx, tmp, hash_size);\0A    if (status != PSA_SUCCESS) {\0A        goto exit;\0A    }\0A\0A    status = psa_hash_finish(&hmac->hash_ctx, tmp, sizeof(tmp), &hash_size);\0A    if (status != PSA_SUCCESS) {\0A        goto exit;\0A    }\0A\0A    memcpy(mac, tmp, mac_size);\0A\0Aexit:\0A    mbedtls_platform_zeroize(tmp, hash_size);\0A    return status;\0A}\0A#endif /* MBEDTLS_PSA_BUILTIN_ALG_HMAC */\0A\0A#if defined(MBEDTLS_PSA_BUILTIN_ALG_CMAC)\0Astatic psa_status_t cmac_setup(mbedtls_psa_mac_operation_t *operation,\0A                               const psa_key_attributes_t *attributes,\0A                               const uint8_t *key_buffer)\0A{\0A    int ret = MBEDTLS_ERR_ERROR_CORRUPTION_DETECTED;\0A\0A#if defined(PSA_WANT_KEY_TYPE_DES)\0A    /* Mbed TLS CMAC does not accept 3DES with only two keys, nor does it accept\0A     * to do CMAC with pure DES, so return NOT_SUPPORTED here. */\0A    if (psa_get_key_type(attributes) == PSA_KEY_TYPE_DES &&\0A        (psa_get_key_bits(attributes) == 64 ||\0A         psa_get_key_bits(attributes) == 128)) {\0A        return PSA_ERROR_NOT_SUPPORTED;\0A    }\0A#endif\0A\0A    const mbedtls_cipher_info_t *cipher_info =\0A        mbedtls_cipher_info_from_psa(\0A            PSA_ALG_CMAC,\0A            psa_get_key_type(attributes),\0A            psa_get_key_bits(attributes),\0A            NULL);\0A\0A    if (cipher_info == NULL) {\0A        return PSA_ERROR_NOT_SUPPORTED;\0A    }\0A\0A    ret = mbedtls_cipher_setup(&operation->ctx.cmac, cipher_info);\0A    if (ret != 0) {\0A        goto exit;\0A    }\0A\0A    ret = mbedtls_cipher_cmac_starts(&operation->ctx.cmac,\0A                                     key_buffer,\0A                                     psa_get_key_bits(attributes));\0Aexit:\0A    return mbedtls_to_psa_error(ret);\0A}\0A#endif /* MBEDTLS_PSA_BUILTIN_ALG_CMAC */\0A\0A#if defined(MBEDTLS_PSA_BUILTIN_ALG_HMAC) || \5C\0A    defined(MBEDTLS_PSA_BUILTIN_ALG_CMAC)\0A\0A/* Initialize this driver's MAC operation structure. Once this function has been\0A * called, mbedtls_psa_mac_abort can run and will do the right thing. */\0Astatic psa_status_t mac_init(\0A    mbedtls_psa_mac_operation_t *operation,\0A    psa_algorithm_t alg)\0A{\0A    psa_status_t status = PSA_ERROR_CORRUPTION_DETECTED;\0A\0A    operation->alg = alg;\0A\0A#if defined(MBEDTLS_PSA_BUILTIN_ALG_CMAC)\0A    if (PSA_ALG_FULL_LENGTH_MAC(operation->alg) == PSA_ALG_CMAC) {\0A        mbedtls_cipher_init(&operation->ctx.cmac);\0A        status = PSA_SUCCESS;\0A    } else\0A#endif /* MBEDTLS_PSA_BUILTIN_ALG_CMAC */\0A#if defined(MBEDTLS_PSA_BUILTIN_ALG_HMAC)\0A    if (PSA_ALG_IS_HMAC(operation->alg)) {\0A        /* We'll set up the hash operation later in psa_hmac_setup_internal. */\0A        operation->ctx.hmac.alg = 0;\0A        status = PSA_SUCCESS;\0A    } else\0A#endif /* MBEDTLS_PSA_BUILTIN_ALG_HMAC */\0A    {\0A        (void) operation;\0A        status = PSA_ERROR_NOT_SUPPORTED;\0A    }\0A\0A    if (status != PSA_SUCCESS) {\0A        memset(operation, 0, sizeof(*operation));\0A    }\0A    return status;\0A}\0A\0Apsa_status_t mbedtls_psa_mac_abort(mbedtls_psa_mac_operation_t *operation)\0A{\0A    if (operation->alg == 0) {\0A        /* The object has (apparently) been initialized but it is not\0A         * in use. It's ok to call abort on such an object, and there's\0A         * nothing to do. */\0A        return PSA_SUCCESS;\0A    } else\0A#if defined(MBEDTLS_PSA_BUILTIN_ALG_CMAC)\0A    if (PSA_ALG_FULL_LENGTH_MAC(operation->alg) == PSA_ALG_CMAC) {\0A        mbedtls_cipher_free(&operation->ctx.cmac);\0A    } else\0A#endif /* MBEDTLS_PSA_BUILTIN_ALG_CMAC */\0A#if defined(MBEDTLS_PSA_BUILTIN_ALG_HMAC)\0A    if (PSA_ALG_IS_HMAC(operation->alg)) {\0A        psa_hmac_abort_internal(&operation->ctx.hmac);\0A    } else\0A#endif /* MBEDTLS_PSA_BUILTIN_ALG_HMAC */\0A    {\0A        /* Sanity check (shouldn't happen: operation->alg should\0A         * always have been initialized to a valid value). */\0A        goto bad_state;\0A    }\0A\0A    operation->alg = 0;\0A\0A    return PSA_SUCCESS;\0A\0Abad_state:\0A    /* If abort is called on an uninitialized object, we can't trust\0A     * anything. Wipe the object in case it contains confidential data.\0A     * This may result in a memory leak if a pointer gets overwritten,\0A     * but it's too late to do anything about this. */\0A    memset(operation, 0, sizeof(*operation));\0A    return PSA_ERROR_BAD_STATE;\0A}\0A\0Astatic psa_status_t psa_mac_setup(mbedtls_psa_mac_operation_t *operation,\0A                                  const psa_key_attributes_t *attributes,\0A                                  const uint8_t *key_buffer,\0A                                  size_t key_buffer_size,\0A                                  psa_algorithm_t alg)\0A{\0A    psa_status_t status = PSA_ERROR_CORRUPTION_DETECTED;\0A\0A    /* A context must be freshly initialized before it can be set up. */\0A    if (operation->alg != 0) {\0A        return PSA_ERROR_BAD_STATE;\0A    }\0A\0A    status = mac_init(operation, alg);\0A    if (status != PSA_SUCCESS) {\0A        return status;\0A    }\0A\0A#if defined(MBEDTLS_PSA_BUILTIN_ALG_CMAC)\0A    if (PSA_ALG_FULL_LENGTH_MAC(alg) == PSA_ALG_CMAC) {\0A        /* Key buffer size for CMAC is dictated by the key bits set on the\0A         * attributes, and previously validated by the core on key import. */\0A        (void) key_buffer_size;\0A        status = cmac_setup(operation, attributes, key_buffer);\0A    } else\0A#endif /* MBEDTLS_PSA_BUILTIN_ALG_CMAC */\0A#if defined(MBEDTLS_PSA_BUILTIN_ALG_HMAC)\0A    if (PSA_ALG_IS_HMAC(alg)) {\0A        status = psa_hmac_setup_internal(&operation->ctx.hmac,\0A                                         key_buffer,\0A                                         key_buffer_size,\0A                                         PSA_ALG_HMAC_GET_HASH(alg));\0A    } else\0A#endif /* MBEDTLS_PSA_BUILTIN_ALG_HMAC */\0A    {\0A        (void) attributes;\0A        (void) key_buffer;\0A        (void) key_buffer_size;\0A        status = PSA_ERROR_NOT_SUPPORTED;\0A    }\0A\0A    if (status != PSA_SUCCESS) {\0A        mbedtls_psa_mac_abort(operation);\0A    }\0A\0A    return status;\0A}\0A\0Apsa_status_t mbedtls_psa_mac_sign_setup(\0A    mbedtls_psa_mac_operation_t *operation,\0A    const psa_key_attributes_t *attributes,\0A    const uint8_t *key_buffer,\0A    size_t key_buffer_size,\0A    psa_algorithm_t alg)\0A{\0A    return psa_mac_setup(operation, attributes,\0A                         key_buffer, key_buffer_size, alg);\0A}\0A\0Apsa_status_t mbedtls_psa_mac_verify_setup(\0A    mbedtls_psa_mac_operation_t *operation,\0A    const psa_key_attributes_t *attributes,\0A    const uint8_t *key_buffer,\0A    size_t key_buffer_size,\0A    psa_algorithm_t alg)\0A{\0A    return psa_mac_setup(operation, attributes,\0A                         key_buffer, key_buffer_size, alg);\0A}\0A\0Apsa_status_t mbedtls_psa_mac_update(\0A    mbedtls_psa_mac_operation_t *operation,\0A    const uint8_t *input,\0A    size_t input_length)\0A{\0A    if (operation->alg == 0) {\0A        return PSA_ERROR_BAD_STATE;\0A    }\0A\0A#if defined(MBEDTLS_PSA_BUILTIN_ALG_CMAC)\0A    if (PSA_ALG_FULL_LENGTH_MAC(operation->alg) == PSA_ALG_CMAC) {\0A        return mbedtls_to_psa_error(\0A            mbedtls_cipher_cmac_update(&operation->ctx.cmac,\0A                                       input, input_length));\0A    } else\0A#endif /* MBEDTLS_PSA_BUILTIN_ALG_CMAC */\0A#if defined(MBEDTLS_PSA_BUILTIN_ALG_HMAC)\0A    if (PSA_ALG_IS_HMAC(operation->alg)) {\0A        return psa_hmac_update_internal(&operation->ctx.hmac,\0A                                        input, input_length);\0A    } else\0A#endif /* MBEDTLS_PSA_BUILTIN_ALG_HMAC */\0A    {\0A        /* This shouldn't happen if `operation` was initialized by\0A         * a setup function. */\0A        (void) input;\0A        (void) input_length;\0A        return PSA_ERROR_BAD_STATE;\0A    }\0A}\0A\0Astatic psa_status_t psa_mac_finish_internal(\0A    mbedtls_psa_mac_operation_t *operation,\0A    uint8_t *mac, size_t mac_size)\0A{\0A#if defined(MBEDTLS_PSA_BUILTIN_ALG_CMAC)\0A    if (PSA_ALG_FULL_LENGTH_MAC(operation->alg) == PSA_ALG_CMAC) {\0A        uint8_t tmp[PSA_BLOCK_CIPHER_BLOCK_MAX_SIZE];\0A        int ret = mbedtls_cipher_cmac_finish(&operation->ctx.cmac, tmp);\0A        if (ret == 0) {\0A            memcpy(mac, tmp, mac_size);\0A        }\0A        mbedtls_platform_zeroize(tmp, sizeof(tmp));\0A        return mbedtls_to_psa_error(ret);\0A    } else\0A#endif /* MBEDTLS_PSA_BUILTIN_ALG_CMAC */\0A#if defined(MBEDTLS_PSA_BUILTIN_ALG_HMAC)\0A    if (PSA_ALG_IS_HMAC(operation->alg)) {\0A        return psa_hmac_finish_internal(&operation->ctx.hmac,\0A                                        mac, mac_size);\0A    } else\0A#endif /* MBEDTLS_PSA_BUILTIN_ALG_HMAC */\0A    {\0A        /* This shouldn't happen if `operation` was initialized by\0A         * a setup function. */\0A        (void) operation;\0A        (void) mac;\0A        (void) mac_size;\0A        return PSA_ERROR_BAD_STATE;\0A    }\0A}\0A\0Apsa_status_t mbedtls_psa_mac_sign_finish(\0A    mbedtls_psa_mac_operation_t *operation,\0A    uint8_t *mac,\0A    size_t mac_size,\0A    size_t *mac_length)\0A{\0A    psa_status_t status = PSA_ERROR_CORRUPTION_DETECTED;\0A\0A    if (operation->alg == 0) {\0A        return PSA_ERROR_BAD_STATE;\0A    }\0A\0A    status = psa_mac_finish_internal(operation, mac, mac_size);\0A    if (status == PSA_SUCCESS) {\0A        *mac_length = mac_size;\0A    }\0A\0A    return status;\0A}\0A\0Apsa_status_t mbedtls_psa_mac_verify_finish(\0A    mbedtls_psa_mac_operation_t *operation,\0A    const uint8_t *mac,\0A    size_t mac_length)\0A{\0A    uint8_t actual_mac[PSA_MAC_MAX_SIZE];\0A    psa_status_t status = PSA_ERROR_CORRUPTION_DETECTED;\0A\0A    if (operation->alg == 0) {\0A        return PSA_ERROR_BAD_STATE;\0A    }\0A\0A    /* Consistency check: requested MAC length fits our local buffer */\0A    if (mac_length > sizeof(actual_mac)) {\0A        return PSA_ERROR_INVALID_ARGUMENT;\0A    }\0A\0A    status = psa_mac_finish_internal(operation, actual_mac, mac_length);\0A    if (status != PSA_SUCCESS) {\0A        goto cleanup;\0A    }\0A\0A    if (mbedtls_ct_memcmp(mac, actual_mac, mac_length) != 0) {\0A        status = PSA_ERROR_INVALID_SIGNATURE;\0A    }\0A\0Acleanup:\0A    mbedtls_platform_zeroize(actual_mac, sizeof(actual_mac));\0A\0A    return status;\0A}\0A\0Apsa_status_t mbedtls_psa_mac_compute(\0A    const psa_key_attributes_t *attributes,\0A    const uint8_t *key_buffer,\0A    size_t key_buffer_size,\0A    psa_algorithm_t alg,\0A    const uint8_t *input,\0A    size_t input_length,\0A    uint8_t *mac,\0A    size_t mac_size,\0A    size_t *mac_length)\0A{\0A    psa_status_t status = PSA_ERROR_CORRUPTION_DETECTED;\0A    mbedtls_psa_mac_operation_t operation = MBEDTLS_PSA_MAC_OPERATION_INIT;\0A\0A    status = psa_mac_setup(&operation,\0A                           attributes, key_buffer, key_buffer_size,\0A                           alg);\0A    if (status != PSA_SUCCESS) {\0A        goto exit;\0A    }\0A\0A    if (input_length > 0) {\0A        status = mbedtls_psa_mac_update(&operation, input, input_length);\0A        if (status != PSA_SUCCESS) {\0A            goto exit;\0A        }\0A    }\0A\0A    status = psa_mac_finish_internal(&operation, mac, mac_size);\0A    if (status == PSA_SUCCESS) {\0A        *mac_length = mac_size;\0A    }\0A\0Aexit:\0A    mbedtls_psa_mac_abort(&operation);\0A\0A    return status;\0A}\0A\0A#endif /* MBEDTLS_PSA_BUILTIN_ALG_HMAC || MBEDTLS_PSA_BUILTIN_ALG_CMAC */\0A\0A#endif /* MBEDTLS_PSA_CRYPTO_C */\0A\00" }
