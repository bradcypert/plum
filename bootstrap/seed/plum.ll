@.str41432 = private global { i64, i64, [44707 x i8] } { i64 -1, i64 44706, [44707 x i8] c"/**\0A * \5Cfile bn_mul.h\0A *\0A * \5Cbrief Multi-precision integer library\0A */\0A/*\0A *  Copyright The Mbed TLS Contributors\0A *  SPDX-License-Identifier: Apache-2.0 OR GPL-2.0-or-later\0A */\0A/*\0A *      Multiply source vector [s] with b, add result\0A *       to destination vector [d] and set carry c.\0A *\0A *      Currently supports:\0A *\0A *         . IA-32 (386+)         . AMD64 / EM64T\0A *         . IA-32 (SSE2)         . Motorola 68000\0A *         . PowerPC, 32-bit      . MicroBlaze\0A *         . PowerPC, 64-bit      . TriCore\0A *         . SPARC v8             . ARM v3+\0A *         . Alpha                . MIPS32\0A *         . C, longlong          . C, generic\0A */\0A#ifndef MBEDTLS_BN_MUL_H\0A#define MBEDTLS_BN_MUL_H\0A\0A#include \22mbedtls/build_info.h\22\0A\0A#include \22mbedtls/bignum.h\22\0A\0A\0A/*\0A * Conversion macros for embedded constants:\0A * build lists of mbedtls_mpi_uint's from lists of unsigned char's grouped by 8, 4 or 2\0A */\0A#if defined(MBEDTLS_HAVE_INT32)\0A\0A#define MBEDTLS_BYTES_TO_T_UINT_4(a, b, c, d)               \5C\0A    ((mbedtls_mpi_uint) (a) <<  0) |                        \5C\0A    ((mbedtls_mpi_uint) (b) <<  8) |                        \5C\0A    ((mbedtls_mpi_uint) (c) << 16) |                        \5C\0A    ((mbedtls_mpi_uint) (d) << 24)\0A\0A#define MBEDTLS_BYTES_TO_T_UINT_2(a, b)                   \5C\0A    MBEDTLS_BYTES_TO_T_UINT_4(a, b, 0, 0)\0A\0A#define MBEDTLS_BYTES_TO_T_UINT_8(a, b, c, d, e, f, g, h) \5C\0A    MBEDTLS_BYTES_TO_T_UINT_4(a, b, c, d),                \5C\0A    MBEDTLS_BYTES_TO_T_UINT_4(e, f, g, h)\0A\0A#else /* 64-bits */\0A\0A#define MBEDTLS_BYTES_TO_T_UINT_8(a, b, c, d, e, f, g, h)   \5C\0A    ((mbedtls_mpi_uint) (a) <<  0) |                        \5C\0A    ((mbedtls_mpi_uint) (b) <<  8) |                        \5C\0A    ((mbedtls_mpi_uint) (c) << 16) |                        \5C\0A    ((mbedtls_mpi_uint) (d) << 24) |                        \5C\0A    ((mbedtls_mpi_uint) (e) << 32) |                        \5C\0A    ((mbedtls_mpi_uint) (f) << 40) |                        \5C\0A    ((mbedtls_mpi_uint) (g) << 48) |                        \5C\0A    ((mbedtls_mpi_uint) (h) << 56)\0A\0A#define MBEDTLS_BYTES_TO_T_UINT_4(a, b, c, d)             \5C\0A    MBEDTLS_BYTES_TO_T_UINT_8(a, b, c, d, 0, 0, 0, 0)\0A\0A#define MBEDTLS_BYTES_TO_T_UINT_2(a, b)                   \5C\0A    MBEDTLS_BYTES_TO_T_UINT_8(a, b, 0, 0, 0, 0, 0, 0)\0A\0A#endif /* bits in mbedtls_mpi_uint */\0A\0A/* *INDENT-OFF* */\0A#if defined(MBEDTLS_HAVE_ASM)\0A\0A/* armcc5 --gnu defines __GNUC__ but doesn't support GNU's extended asm */\0A#if defined(__GNUC__) && \5C\0A    ( !defined(__ARMCC_VERSION) || __ARMCC_VERSION >= 6000000 )\0A\0A/*\0A * GCC < 5.0 treated the x86 ebx (which is used for the GOT) as a\0A * fixed reserved register when building as PIC, leading to errors\0A * like: bn_mul.h:46:13: error: PIC register clobbered by 'ebx' in 'asm'\0A *\0A * This is fixed by an improved register allocator in GCC 5+. From the\0A * release notes:\0A * Register allocation improvements: Reuse of the PIC hard register,\0A * instead of using a fixed register, was implemented on x86/x86-64\0A * targets. This improves generated PIC code performance as more hard\0A * registers can be used.\0A */\0A#if defined(__GNUC__) && __GNUC__ < 5 && defined(__PIC__)\0A#define MULADDC_CANNOT_USE_EBX\0A#endif\0A\0A/*\0A * Disable use of the i386 assembly code below if option -O0, to disable all\0A * compiler optimisations, is passed, detected with __OPTIMIZE__\0A * This is done as the number of registers used in the assembly code doesn't\0A * work with the -O0 option.\0A */\0A#if defined(__i386__) && defined(__OPTIMIZE__) && !defined(MULADDC_CANNOT_USE_EBX)\0A\0A#define MULADDC_X1_INIT                     \5C\0A    { mbedtls_mpi_uint t;                   \5C\0A    asm(                                    \5C\0A        \22movl   %%ebx, %0           \5Cn\5Ct\22   \5C\0A        \22movl   %5, %%esi           \5Cn\5Ct\22   \5C\0A        \22movl   %6, %%edi           \5Cn\5Ct\22   \5C\0A        \22movl   %7, %%ecx           \5Cn\5Ct\22   \5C\0A        \22movl   %8, %%ebx           \5Cn\5Ct\22\0A\0A#define MULADDC_X1_CORE                     \5C\0A        \22lodsl                      \5Cn\5Ct\22   \5C\0A        \22mull   %%ebx               \5Cn\5Ct\22   \5C\0A        \22addl   %%ecx,   %%eax      \5Cn\5Ct\22   \5C\0A        \22adcl   $0,      %%edx      \5Cn\5Ct\22   \5C\0A        \22addl   (%%edi), %%eax      \5Cn\5Ct\22   \5C\0A        \22adcl   $0,      %%edx      \5Cn\5Ct\22   \5C\0A        \22movl   %%edx,   %%ecx      \5Cn\5Ct\22   \5C\0A        \22stosl                      \5Cn\5Ct\22\0A\0A#define MULADDC_X1_STOP                                 \5C\0A        \22movl   %4, %%ebx       \5Cn\5Ct\22                   \5C\0A        \22movl   %%ecx, %1       \5Cn\5Ct\22                   \5C\0A        \22movl   %%edi, %2       \5Cn\5Ct\22                   \5C\0A        \22movl   %%esi, %3       \5Cn\5Ct\22                   \5C\0A        : \22=m\22 (t), \22=m\22 (c), \22=m\22 (d), \22=m\22 (s)        \5C\0A        : \22m\22 (t), \22m\22 (s), \22m\22 (d), \22m\22 (c), \22m\22 (b)   \5C\0A        : \22eax\22, \22ebx\22, \22ecx\22, \22edx\22, \22esi\22, \22edi\22      \5C\0A    ); }\0A\0A#if defined(MBEDTLS_HAVE_SSE2)\0A\0A#define MULADDC_X8_INIT MULADDC_X1_INIT\0A\0A#define MULADDC_X8_CORE                         \5C\0A        \22movd     %%ecx,     %%mm1      \5Cn\5Ct\22   \5C\0A        \22movd     %%ebx,     %%mm0      \5Cn\5Ct\22   \5C\0A        \22movd     (%%edi),   %%mm3      \5Cn\5Ct\22   \5C\0A        \22paddq    %%mm3,     %%mm1      \5Cn\5Ct\22   \5C\0A        \22movd     (%%esi),   %%mm2      \5Cn\5Ct\22   \5C\0A        \22pmuludq  %%mm0,     %%mm2      \5Cn\5Ct\22   \5C\0A        \22movd     4(%%esi),  %%mm4      \5Cn\5Ct\22   \5C\0A        \22pmuludq  %%mm0,     %%mm4      \5Cn\5Ct\22   \5C\0A        \22movd     8(%%esi),  %%mm6      \5Cn\5Ct\22   \5C\0A        \22pmuludq  %%mm0,     %%mm6      \5Cn\5Ct\22   \5C\0A        \22movd     12(%%esi), %%mm7      \5Cn\5Ct\22   \5C\0A        \22pmuludq  %%mm0,     %%mm7      \5Cn\5Ct\22   \5C\0A        \22paddq    %%mm2,     %%mm1      \5Cn\5Ct\22   \5C\0A        \22movd     4(%%edi),  %%mm3      \5Cn\5Ct\22   \5C\0A        \22paddq    %%mm4,     %%mm3      \5Cn\5Ct\22   \5C\0A        \22movd     8(%%edi),  %%mm5      \5Cn\5Ct\22   \5C\0A        \22paddq    %%mm6,     %%mm5      \5Cn\5Ct\22   \5C\0A        \22movd     12(%%edi), %%mm4      \5Cn\5Ct\22   \5C\0A        \22paddq    %%mm4,     %%mm7      \5Cn\5Ct\22   \5C\0A        \22movd     %%mm1,     (%%edi)    \5Cn\5Ct\22   \5C\0A        \22movd     16(%%esi), %%mm2      \5Cn\5Ct\22   \5C\0A        \22pmuludq  %%mm0,     %%mm2      \5Cn\5Ct\22   \5C\0A        \22psrlq    $32,       %%mm1      \5Cn\5Ct\22   \5C\0A        \22movd     20(%%esi), %%mm4      \5Cn\5Ct\22   \5C\0A        \22pmuludq  %%mm0,     %%mm4      \5Cn\5Ct\22   \5C\0A        \22paddq    %%mm3,     %%mm1      \5Cn\5Ct\22   \5C\0A        \22movd     24(%%esi), %%mm6      \5Cn\5Ct\22   \5C\0A        \22pmuludq  %%mm0,     %%mm6      \5Cn\5Ct\22   \5C\0A        \22movd     %%mm1,     4(%%edi)   \5Cn\5Ct\22   \5C\0A        \22psrlq    $32,       %%mm1      \5Cn\5Ct\22   \5C\0A        \22movd     28(%%esi), %%mm3      \5Cn\5Ct\22   \5C\0A        \22pmuludq  %%mm0,     %%mm3      \5Cn\5Ct\22   \5C\0A        \22paddq    %%mm5,     %%mm1      \5Cn\5Ct\22   \5C\0A        \22movd     16(%%edi), %%mm5      \5Cn\5Ct\22   \5C\0A        \22paddq    %%mm5,     %%mm2      \5Cn\5Ct\22   \5C\0A        \22movd     %%mm1,     8(%%edi)   \5Cn\5Ct\22   \5C\0A        \22psrlq    $32,       %%mm1      \5Cn\5Ct\22   \5C\0A        \22paddq    %%mm7,     %%mm1      \5Cn\5Ct\22   \5C\0A        \22movd     20(%%edi), %%mm5      \5Cn\5Ct\22   \5C\0A        \22paddq    %%mm5,     %%mm4      \5Cn\5Ct\22   \5C\0A        \22movd     %%mm1,     12(%%edi)  \5Cn\5Ct\22   \5C\0A        \22psrlq    $32,       %%mm1      \5Cn\5Ct\22   \5C\0A        \22paddq    %%mm2,     %%mm1      \5Cn\5Ct\22   \5C\0A        \22movd     24(%%edi), %%mm5      \5Cn\5Ct\22   \5C\0A        \22paddq    %%mm5,     %%mm6      \5Cn\5Ct\22   \5C\0A        \22movd     %%mm1,     16(%%edi)  \5Cn\5Ct\22   \5C\0A        \22psrlq    $32,       %%mm1      \5Cn\5Ct\22   \5C\0A        \22paddq    %%mm4,     %%mm1      \5Cn\5Ct\22   \5C\0A        \22movd     28(%%edi), %%mm5      \5Cn\5Ct\22   \5C\0A        \22paddq    %%mm5,     %%mm3      \5Cn\5Ct\22   \5C\0A        \22movd     %%mm1,     20(%%edi)  \5Cn\5Ct\22   \5C\0A        \22psrlq    $32,       %%mm1      \5Cn\5Ct\22   \5C\0A        \22paddq    %%mm6,     %%mm1      \5Cn\5Ct\22   \5C\0A        \22movd     %%mm1,     24(%%edi)  \5Cn\5Ct\22   \5C\0A        \22psrlq    $32,       %%mm1      \5Cn\5Ct\22   \5C\0A        \22paddq    %%mm3,     %%mm1      \5Cn\5Ct\22   \5C\0A        \22movd     %%mm1,     28(%%edi)  \5Cn\5Ct\22   \5C\0A        \22addl     $32,       %%edi      \5Cn\5Ct\22   \5C\0A        \22addl     $32,       %%esi      \5Cn\5Ct\22   \5C\0A        \22psrlq    $32,       %%mm1      \5Cn\5Ct\22   \5C\0A        \22movd     %%mm1,     %%ecx      \5Cn\5Ct\22\0A\0A#define MULADDC_X8_STOP                 \5C\0A        \22emms                   \5Cn\5Ct\22   \5C\0A        \22movl   %4, %%ebx       \5Cn\5Ct\22   \5C\0A        \22movl   %%ecx, %1       \5Cn\5Ct\22   \5C\0A        \22movl   %%edi, %2       \5Cn\5Ct\22   \5C\0A        \22movl   %%esi, %3       \5Cn\5Ct\22   \5C\0A        : \22=m\22 (t), \22=m\22 (c), \22=m\22 (d), \22=m\22 (s)        \5C\0A        : \22m\22 (t), \22m\22 (s), \22m\22 (d), \22m\22 (c), \22m\22 (b)   \5C\0A        : \22eax\22, \22ebx\22, \22ecx\22, \22edx\22, \22esi\22, \22edi\22      \5C\0A    ); }                                                \5C\0A\0A#endif /* SSE2 */\0A\0A#endif /* i386 */\0A\0A#if defined(__amd64__