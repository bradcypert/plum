@.str39718 = private global { i64, i64, [277134 x i8] } { i64 -1, i64 277133, [277134 x i8] c"/**\0A * \5Cfile ssl.h\0A *\0A * \5Cbrief SSL/TLS functions.\0A */\0A/*\0A *  Copyright The Mbed TLS Contributors\0A *  SPDX-License-Identifier: Apache-2.0 OR GPL-2.0-or-later\0A */\0A#ifndef MBEDTLS_SSL_H\0A#define MBEDTLS_SSL_H\0A#include \22mbedtls/platform_util.h\22\0A#include \22mbedtls/private_access.h\22\0A\0A#include \22mbedtls/build_info.h\22\0A\0A#include \22mbedtls/bignum.h\22\0A#include \22mbedtls/ecp.h\22\0A\0A#include \22mbedtls/ssl_ciphersuites.h\22\0A\0A#if defined(MBEDTLS_X509_CRT_PARSE_C)\0A#include \22mbedtls/x509_crt.h\22\0A#include \22mbedtls/x509_crl.h\22\0A#endif\0A\0A#if defined(MBEDTLS_DHM_C)\0A#include \22mbedtls/dhm.h\22\0A#endif\0A\0A#include \22mbedtls/md.h\22\0A\0A#if defined(MBEDTLS_KEY_EXCHANGE_SOME_ECDH_OR_ECDHE_ANY_ENABLED)\0A#include \22mbedtls/ecdh.h\22\0A#endif\0A\0A#if defined(MBEDTLS_HAVE_TIME)\0A#include \22mbedtls/platform_time.h\22\0A#endif\0A\0A#include \22psa/crypto.h\22\0A\0A/*\0A * SSL Error codes\0A */\0A/** A cryptographic operation is in progress. Try again later. */\0A#define MBEDTLS_ERR_SSL_CRYPTO_IN_PROGRESS                -0x7000\0A/** The requested feature is not available. */\0A#define MBEDTLS_ERR_SSL_FEATURE_UNAVAILABLE               -0x7080\0A/** Bad input parameters to function. */\0A#define MBEDTLS_ERR_SSL_BAD_INPUT_DATA                    -0x7100\0A/** Verification of the message MAC failed. */\0A#define MBEDTLS_ERR_SSL_INVALID_MAC                       -0x7180\0A/** An invalid SSL record was received. */\0A#define MBEDTLS_ERR_SSL_INVALID_RECORD                    -0x7200\0A/** The connection indicated an EOF. */\0A#define MBEDTLS_ERR_SSL_CONN_EOF                          -0x7280\0A/** A message could not be parsed due to a syntactic error. */\0A#define MBEDTLS_ERR_SSL_DECODE_ERROR                      -0x7300\0A/* Error space gap */\0A/** No RNG was provided to the SSL module. */\0A#define MBEDTLS_ERR_SSL_NO_RNG                            -0x7400\0A/** No client certification received from the client, but required by the authentication mode. */\0A#define MBEDTLS_ERR_SSL_NO_CLIENT_CERTIFICATE             -0x7480\0A/** Client received an extended server hello containing an unsupported extension */\0A#define MBEDTLS_ERR_SSL_UNSUPPORTED_EXTENSION             -0x7500\0A/** No ALPN protocols supported that the client advertises */\0A#define MBEDTLS_ERR_SSL_NO_APPLICATION_PROTOCOL           -0x7580\0A/** The own private key or pre-shared key is not set, but needed. */\0A#define MBEDTLS_ERR_SSL_PRIVATE_KEY_REQUIRED              -0x7600\0A/** No CA Chain is set, but required to operate. */\0A#define MBEDTLS_ERR_SSL_CA_CHAIN_REQUIRED                 -0x7680\0A/** An unexpected message was received from our peer. */\0A#define MBEDTLS_ERR_SSL_UNEXPECTED_MESSAGE                -0x7700\0A/** A fatal alert message was received from our peer. */\0A#define MBEDTLS_ERR_SSL_FATAL_ALERT_MESSAGE               -0x7780\0A/** No server could be identified matching the client's SNI. */\0A#define MBEDTLS_ERR_SSL_UNRECOGNIZED_NAME                 -0x7800\0A/** The peer notified us that the connection is going to be closed. */\0A#define MBEDTLS_ERR_SSL_PEER_CLOSE_NOTIFY                 -0x7880\0A/* Error space gap */\0A/* Error space gap */\0A/** Processing of the Certificate handshake message failed. */\0A#define MBEDTLS_ERR_SSL_BAD_CERTIFICATE                   -0x7A00\0A/* Error space gap */\0A/** A TLS 1.3 NewSessionTicket message has been received. */\0A#define MBEDTLS_ERR_SSL_RECEIVED_NEW_SESSION_TICKET       -0x7B00\0A/** Not possible to read early data */\0A#define MBEDTLS_ERR_SSL_CANNOT_READ_EARLY_DATA            -0x7B80\0A/**\0A * Early data has been received as part of an on-going handshake.\0A * This error code can be returned only on server side if and only if early\0A * data has been enabled by means of the mbedtls_ssl_conf_early_data() API.\0A * This error code can then be returned by mbedtls_ssl_handshake(),\0A * mbedtls_ssl_handshake_step(), mbedtls_ssl_read() or mbedtls_ssl_write() if\0A * early data has been received as part of the handshake sequence they\0A * triggered. To read the early data, call mbedtls_ssl_read_early_data().\0A */\0A#define MBEDTLS_ERR_SSL_RECEIVED_EARLY_DATA               -0x7C00\0A/** Not possible to write early data */\0A#define MBEDTLS_ERR_SSL_CANNOT_WRITE_EARLY_DATA           -0x7C80\0A/* Error space gap */\0A/* Error space gap */\0A/* Error space gap */\0A/* Error space gap */\0A/** Cache entry not found */\0A#define MBEDTLS_ERR_SSL_CACHE_ENTRY_NOT_FOUND             -0x7E80\0A/** Memory allocation failed */\0A#define MBEDTLS_ERR_SSL_ALLOC_FAILED                      -0x7F00\0A/** Hardware acceleration function returned with error */\0A#define MBEDTLS_ERR_SSL_HW_ACCEL_FAILED                   -0x7F80\0A/** Hardware acceleration function skipped / left alone data */\0A#define MBEDTLS_ERR_SSL_HW_ACCEL_FALLTHROUGH              -0x6F80\0A/** Handshake protocol not within min/max boundaries */\0A#define MBEDTLS_ERR_SSL_BAD_PROTOCOL_VERSION              -0x6E80\0A/** The handshake negotiation failed. */\0A#define MBEDTLS_ERR_SSL_HANDSHAKE_FAILURE                 -0x6E00\0A/** Session ticket has expired. */\0A#define MBEDTLS_ERR_SSL_SESSION_TICKET_EXPIRED            -0x6D80\0A/** Public key type mismatch (eg, asked for RSA key exchange and presented EC key) */\0A#define MBEDTLS_ERR_SSL_PK_TYPE_MISMATCH                  -0x6D00\0A/** Unknown identity received (eg, PSK identity) */\0A#define MBEDTLS_ERR_SSL_UNKNOWN_IDENTITY                  -0x6C80\0A/** Internal error (eg, unexpected failure in lower-level module) */\0A#define MBEDTLS_ERR_SSL_INTERNAL_ERROR                    -0x6C00\0A/** A counter would wrap (eg, too many messages exchanged). */\0A#define MBEDTLS_ERR_SSL_COUNTER_WRAPPING                  -0x6B80\0A/** Unexpected message at ServerHello in renegotiation. */\0A#define MBEDTLS_ERR_SSL_WAITING_SERVER_HELLO_RENEGO       -0x6B00\0A/** DTLS client must retry for hello verification */\0A#define MBEDTLS_ERR_SSL_HELLO_VERIFY_REQUIRED             -0x6A80\0A/** A buffer is too small to receive or write a message */\0A#define MBEDTLS_ERR_SSL_BUFFER_TOO_SMALL                  -0x6A00\0A/* Error space gap */\0A/** No data of requested type currently available on underlying transport. */\0A#define MBEDTLS_ERR_SSL_WANT_READ                         -0x6900\0A/** Connection requires a write call. */\0A#define MBEDTLS_ERR_SSL_WANT_WRITE                        -0x6880\0A/** The operation timed out. */\0A#define MBEDTLS_ERR_SSL_TIMEOUT                           -0x6800\0A/** The client initiated a reconnect from the same port. */\0A#define MBEDTLS_ERR_SSL_CLIENT_RECONNECT                  -0x6780\0A/** Record header looks valid but is not expected. */\0A#define MBEDTLS_ERR_SSL_UNEXPECTED_RECORD                 -0x6700\0A/** The alert message received indicates a non-fatal error. */\0A#define MBEDTLS_ERR_SSL_NON_FATAL                         -0x6680\0A/** A field in a message was incorrect or inconsistent with other fields. */\0A#define MBEDTLS_ERR_SSL_ILLEGAL_PARAMETER                 -0x6600\0A/** Internal-only message signaling that further message-processing should be done */\0A#define MBEDTLS_ERR_SSL_CONTINUE_PROCESSING               -0x6580\0A/** The asynchronous operation is not completed yet. */\0A#define MBEDTLS_ERR_SSL_ASYNC_IN_PROGRESS                 -0x6500\0A/** Internal-only message signaling that a message arrived early. */\0A#define MBEDTLS_ERR_SSL_EARLY_MESSAGE                     -0x6480\0A/* Error space gap */\0A/* Error space gap */\0A/* Error space gap */\0A/* Error space gap */\0A/* Error space gap */\0A/* Error space gap */\0A/* Error space gap */\0A/* Error space gap */\0A/** An encrypted DTLS-frame with an unexpected CID was received. */\0A#define MBEDTLS_ERR_SSL_UNEXPECTED_CID                    -0x6000\0A/** An operation failed due to an unexpected version or configuration. */\0A#define MBEDTLS_ERR_SSL_VERSION_MISMATCH                  -0x5F00\0A/** Invalid value in SSL config */\0A#define MBEDTLS_ERR_SSL_BAD_CONFIG                        -0x5E80\0A/* Error space gap */\0A/** Attempt to verify a certificate without an expected hostname.\0A * This is usually insecure.\0A *\0A * In TLS clients, when a client authenticates a server through its\0A * certificate, the client normally checks three things:\0A * - the certificate chain must be valid;\0A * - the chain must start from a trusted CA;\0A * - the certificate must cover the server name that is expected by the client.\0A *\0A * Omitting any of these checks is generally insecure, and can allow a\0A * malicious server to impersonate a legitimate server.\0A *\0A * The third check may be safely skipped in some unusual scenarios,\0A * such as networks where eavesdropping is a risk but not active attacks,\0A * or a private PKI where the client equally trusts all servers that are\0A * accredited by the root CA.\0A *\0A * You should call mbedtls_ssl_set_hostname() with the expected server name\0A * before starting a TLS handshake on a client (unless the client is\0A * set up to only use PSK-based authentication, which does not rely on the\0A * host name). If you have determined that server name verification is not\0A * required for security in your scenario, call mbedtls_ssl_set_hostname()\0A * with \5Cp NULL as the server name.\0A *\0A * This error is raised if all of the following conditions are met:\0A *\0A * - A TLS client is configured with the authentication mode\0A *   #MBEDTLS_SSL_VERIFY_REQUIRED (default).\0A * - Certificate authentication is enabled.\0A * - The client does not call mbedtls_ssl_set_hostname().\0A * - The configuration option\0A *   #MBEDTLS_SSL_CLI_ALLOW_WEAK_CERTIFICATE_VERIFICATION_WITHOUT_HOSTNAME\0A *   is not enabled.\0A */\0A#define MBEDTLS_ERR_SSL_CERTIFICATE_VERIFICATION_WITHOUT_HOSTNAME  -0x5D80\0A\0A/*\0A * Constants from RFC 8446 for TLS 1.3 PSK modes\0A *\0A * Those are used in the Pre-Shared Key Exchange Modes extension.\0A * See Section 4.2.9 in RFC 8446.\0A */\0A#define MBEDTLS_SSL_TLS1_3_PSK_MODE_PURE  0 /* Pure PSK-based exchange  */\0A#define MBEDTLS_SSL_TLS1_3_PSK_MODE_ECDHE 1 /* PSK+ECDHE-based exchange */\0A\0A/*\0A * TLS 1.3 NamedGroup values\0A *\0A * From RF 8446\0A *    enum {\0A *         // Elliptic Curve Groups (ECDHE)\0A *         secp256r1(0x0017), secp384r1(0x0018), secp521r1(0x0019),\0A *         x25519(0x001D), x448(0x001E),\0A *         // Finite Field Groups (DHE)\0A *         ffdhe2048(0x0100), ffdhe3072(0x0101), ffdhe4096(0x0102),\0A *         ffdhe6144(0x0103), ffdhe8192(0x0104),\0A *         // Reserved Code Points\0A *         ffdhe_private_use(0x01FC..0x01FF),\0A *         ecdhe_private_use(0xFE00..0xFEFF),\0A *         (0xFFFF)\0A *     } NamedGroup;\0A *\0A */\0A\0A/* Elliptic Curve Groups (ECDHE) */\0A#define MBEDTLS_SSL_IANA_TLS_GROUP_NONE               0\0A#define MBEDTLS_SSL_IANA_TLS_GROUP_SECP192K1     0x0012\0A#define MBEDTLS_SSL_IANA_TLS_GROUP_SECP192R1     0x0013\0A#define MBEDTLS_SSL_IANA_TLS_GROUP_SECP224K1     0x0014\0A#define MBEDTLS_SSL_IANA_TLS_GROUP_SECP224R1     0x0015\0A#define MBEDTLS_SSL_IANA_TLS_GROUP_SECP256K1     0x0016\0A#define MBEDTLS_SSL_IANA_TLS_GROUP_SECP256R1     0x0017\0A#define MBEDTLS_SSL_IANA_TLS_GROUP_SECP384R1     0x0018\0A#define MBEDTLS_SSL_IANA_TLS_GROUP_SECP521R1     0x0019\0A#define MBEDTLS_SSL_IANA_TLS_GROUP_BP256R1       0x001A\0A#define MBEDTLS_SSL_IANA_TLS_GROUP_BP384R1       0x001B\0A#define MBEDTLS_SSL_IANA_TLS_GROUP_BP512R1       0x001C\0A#define MBEDTLS_SSL_IANA_TLS_GROUP_X25519        0x001D\0A#define MBEDTLS_SSL_IANA_TLS_GROUP_X448          0x001E\0A/* Finite Field Groups (DHE) */\0A#define MBEDTLS_SSL_IANA_TLS_GROUP_FFDHE2048     0x0100\0A#define MBEDTLS_SSL_IANA_TLS_GROUP_FFDHE3072     0x0101\0A#define MBEDTLS_SSL_IANA_TLS_GROUP_FFDHE4096     0x0102\0A#define MBEDTLS_SSL_IANA_TLS_GROUP_FFDHE6144     0x0103\0A#define MBEDTLS_SSL_IANA_TLS_GROUP_FFDHE8192     0x0104\0A\0A/*\0A * TLS 1.3 Key Exchange Modes\0A *\0A * Mbed TLS internal identifiers for use with the SSL configuration API\0A * mbedtls_ssl_conf_tls13_key_exchange_modes().\0A */\0A\0A#define MBEDTLS_SSL_TLS1_3_KEY_EXCHANGE_MODE_PSK            (1u << 0)   /*!< Pure-PSK TLS 1.3 key exchange,\0A                                                                         *   encompassing both externally agreed PSKs\0A                                                                         *   as well as resumption PSKs. */\0A#define MBEDTLS_SSL_TLS1_3_KEY_EXCHANGE_MODE_EPHEMERAL      (1u << 1)   /*!< Pure-Ephemeral TLS 1.3 key exchanges,\0A                                                                         *   including for example ECDHE and DHE\0A                                                                         *   key exchanges. */\0A#define MBEDTLS_SSL_TLS1_3_KEY_EXCHANGE_MODE_PSK_EPHEMERAL  (1u << 2)   /*!< PSK-Ephemeral TLS 1.3 key exchanges,\0A                                                                         *   using both a PSK and an ephemeral\0A                                                                         *   key exchange. */\0A\0A/* Convenience macros for sets of key exchanges. */\0A#define MBEDTLS_SSL_TLS1_3_KEY_EXCHANGE_MODE_ALL                         \5C\0A    (MBEDTLS_SSL_TLS1_3_KEY_EXCHANGE_MODE_PSK              |            \5C\0A     MBEDTLS_SSL_TLS1_3_KEY_EXCHANGE_MODE_PSK_EPHEMERAL    |            \5C\0A     MBEDTLS_SSL_TLS1_3_KEY_EXCHANGE_MODE_EPHEMERAL)          /*!< All TLS 1.3 key exchanges           */\0A#define MBEDTLS_SSL_TLS1_3_KEY_EXCHANGE_MODE_PSK_ALL                     \5C\0A    (MBEDTLS_SSL_TLS1_3_KEY_EXCHANGE_MODE_PSK              |            \5C\0A     MBEDTLS_SSL_TLS1_3_KEY_EXCHANGE_MODE_PSK_EPHEMERAL)      /*!< All PSK-based TLS 1.3 key exchanges */\0A#define MBEDTLS_SSL_TLS1_3_KEY_EXCHANGE_MODE_EPHEMERAL_ALL               \5C\0A    (MBEDTLS_SSL_TLS1_3_KEY_EXCHANGE_MODE_EPHEMERAL        |            \5C\0A     MBEDTLS_SSL_TLS1_3_KEY_EXCHANGE_MODE_PSK_EPHEMERAL)      /*!< All ephemeral TLS 1.3 key exchanges */\0A\0A#define MBEDTLS_SSL_TLS1_3_KEY_EXCHANGE_MODE_NONE   (0)\0A\0A/*\0A * Various constants\0A */\0A\0A#if !defined(MBEDTLS_DEPRECATED_REMOVED)\0A/* These are the high and low bytes of ProtocolVersion as defined by:\0A * - RFC 5246: ProtocolVersion version = { 3, 3 };     // TLS v1.2\0A * - RFC 8446: see section 4.2.1\0A */\0A#define MBEDTLS_SSL_MAJOR_VERSION_3             3\0A#define MBEDTLS_SSL_MINOR_VERSION_3             3   /*!< TLS v1.2 */\0A#define MBEDTLS_SSL_MINOR_VERSION_4             4   /*!< TLS v1.3 */\0A#endif /* MBEDTLS_DEPRECATED_REMOVED */\0A\0A#define MBEDTLS_SSL_TRANSPORT_STREAM            0   /*!< TLS      */\0A#define MBEDTLS_SSL_TRANSPORT_DATAGRAM          1   /*!< DTLS     */\0A\0A#define MBEDTLS_SSL_MAX_HOST_NAME_LEN           255 /*!< Maximum host name defined in RFC 1035 */\0A#define MBEDTLS_SSL_MAX_ALPN_NAME_LEN           255 /*!< Maximum size in bytes of a protocol name in alpn ext., RFC 7301 */\0A\0A#define MBEDTLS_SSL_MAX_ALPN_LIST_LEN           65535 /*!< Maximum size in bytes of list in alpn ext., RFC 7301          */\0A\0A/* RFC 6066 section 4, see also mfl_code_to_length in ssl_tls.c\0A * NONE must be zero so that memset()ing structure to zero works */\0A#define MBEDTLS_SSL_MAX_FRAG_LEN_NONE           0   /*!< don't use this extension   */\0A#define MBEDTLS_SSL_MAX_FRAG_LEN_512            1   /*!< MaxFragmentLength 2^9      */\0A#define MBEDTLS_SSL_MAX_FRAG_LEN_1024           2   /*!< MaxFragmentLength 2^10     */\0A#define MBEDTLS_SSL_MAX_FRAG_LEN_2048           3   /*!< MaxFragmentLength 2^11     */\0A#define MBEDTLS_SSL_MAX_FRAG_LEN_4096           4   /*!< MaxFragmentLength 2^12     */\0A#define MBEDTLS_SSL_MAX_FRAG_LEN_INVALID        5   /*!< first invalid value        */\0A\0A#define MBEDTLS_SSL_IS_CLIENT                   0\0A#define MBEDTLS_SSL_IS_SERVER                   1\0A\0A#define MBEDTLS_SSL_EXTENDED_MS_DISABLED        0\0A#define MBEDTLS_SSL_EXTENDED_MS_ENABLED         1\0A\0A#define MBEDTLS_SSL_CID_DISABLED                0\0A#define MBEDTLS_SSL_CID_ENABLED                 1\0A\0A#define MBEDTLS_SSL_ETM_DISABLED                0\0A#define MBEDTLS_SSL_ETM_ENABLED                 1\0A\0A#define MBEDTLS_SSL_COMPRESS_NULL               0\0A\0A#define MBEDTLS_SSL_VERIFY_NONE                 0\0A#define MBEDTLS_SSL_VERIFY_OPTIONAL             1\0A#define MBEDTLS_SSL_VERIFY_REQUIRED             2\0A#define MBEDTLS_SSL_VERIFY_UNSET                3 /* Used only for sni_authmode */\0A\0A#define MBEDTLS_SSL_LEGACY_RENEGOTIATION        0\0A#define MBEDTLS_SSL_SECURE_RENEGOTIATION        1\0A\0A#define MBEDTLS_SSL_RENEGOTIATION_DISABLED      0\0A#define MBEDTLS_SSL_RENEGOTIATION_ENABLED       1\0A\0A#define MBEDTLS_SSL_ANTI_REPLAY_DISABLED        0\0A#define MBEDTLS_SSL_ANTI_REPLAY_ENABLED         1\0A\0A#define MBEDTLS_SSL_RENEGOTIATION_NOT_ENFORCED  -1\0A#define MBEDTLS_SSL_RENEGO_MAX_RECORDS_DEFAULT  16\0A\0A#define MBEDTLS_SSL_LEGACY_NO_RENEGOTIATION     0\0A#define MBEDTLS_SSL_LEGACY_ALLOW_RENEGOTIATION  1\0A#define MBEDTLS_SSL_LEGACY_BREAK_HANDSHAKE      2\0A\0A#define MBEDTLS_SSL_TRUNC_HMAC_DISABLED         0\0A#define MBEDTLS_SSL_TRUNC_HMAC_ENABLED          1\0A#define MBEDTLS_SSL_TRUNCATED_HMAC_LEN          10  /* 80 bits, rfc 6066 section 7 */\0A\0A#define MBEDTLS_SSL_SESSION_TICKETS_DISABLED     0\0A#define MBEDTLS_SSL_SESSION_TICKETS_ENABLED      1\0A\0A#define MBEDTLS_SSL_TLS1_3_SIGNAL_NEW_SESSION_TICKETS_DISABLED  0\0A#define MBEDTLS_SSL_TLS1_3_SIGNAL_NEW_SESSION_TICKETS_ENABLED   1\0A\0A#define MBEDTLS_SSL_PRESET_DEFAULT              0\0A#define MBEDTLS_SSL_PRESET_SUITEB               2\0A\0A#define MBEDTLS_SSL_CERT_REQ_CA_LIST_ENABLED       1\0A#define MBEDTLS_SSL_CERT_REQ_CA_LIST_DISABLED      0\0A\0A#define MBEDTLS_SSL_EARLY_DATA_DISABLED        0\0A#define MBEDTLS_SSL_EARLY_DATA_ENABLED         1\0A\0A#define MBEDTLS_SSL_DTLS_SRTP_MKI_UNSUPPORTED    0\0A#define MBEDTLS_SSL_DTLS_SRTP_MKI_SUPPORTED      1\0A\0A#define MBEDTLS_SSL_SRV_CIPHERSUITE_ORDER_CLIENT  1\0A#define MBEDTLS_SSL_SRV_CIPHERSUITE_ORDER_SERVER  0\0A\0A#if defined(MBEDTLS_SSL_PROTO_TLS1_3) && defined(MBEDTLS_SSL_SESSION_TICKETS)\0A#if defined(PSA_WANT_ALG_SHA_384)\0A#define MBEDTLS_SSL_TLS1_3_TICKET_RESUMPTION_KEY_LEN        48\0A#elif defined(PSA_WANT_ALG_SHA_256)\0A#define MBEDTLS_SSL_TLS1_3_TICKET_RESUMPTION_KEY_LEN        32\0A#endif\0A#endif /* MBEDTLS_SSL_PROTO_TLS1_3 && MBEDTLS_SSL_SESSION_TICKETS */\0A/*\0A * Default range for DTLS retransmission timer value, in milliseconds.\0A * RFC 6347 4.2.4.1 says from 1 second to 60 seconds.\0A */\0A#define MBEDTLS_SSL_DTLS_TIMEOUT_DFL_MIN    1000\0A#define MBEDTLS_SSL_DTLS_TIMEOUT_DFL_MAX   60000\0A\0A/*\0A * Whether early data record should be discarded or not and how.\0A *\0A * The client has indicated early data and the server has rejected them.\0A * The server has then to skip past early data by either:\0A * - attempting to deprotect received records using the handshake traffic\0A *   key, discarding records which fail deprotection (up to the configured\0A *   max_early_data_size). Once a record is deprotected successfully,\0A *   it is treated as the start of the client's second flight and the\0A *   server proceeds as with an ordinary 1-RTT handshake.\0A * - skipping all records with an external content type of\0A *   \22application_data\22 (indicating that they are encrypted), up to the\0A *   configured max_early_data_size. This is the expected behavior if the\0A *   server has sent an HelloRetryRequest message. The server ignores\0A *   application data message before 2nd ClientHello.\0A */\0A#define MBEDTLS_SSL_EARLY_DATA_NO_DISCARD 0\0A#define MBEDTLS_SSL_EARLY_DATA_TRY_TO_DEPROTECT_AND_DISCARD 1\0A#define MBEDTLS_SSL_EARLY_DATA_DISCARD 2\0A\0A/**\0A * \5Cname SECTION: Module settings\0A *\0A * The configuration options you can set for this module are in this section.\0A * Either change them in mbedtls_config.h or define them on the compiler command line.\0A * \5C{\0A */\0A\0A/*\0A * Maximum fragment length in bytes,\0A * determines the size of each of the two internal I/O buffers.\0A *\0A * Note: the RFC defines the default size of SSL / TLS messages. If you\0A * change the value here, other clients / servers may not be able to\0A * communicate with you anymore. Only change this value if you control\0A * both sides of the connection and have it reduced at both sides, or\0A * if you're using the Max Fragment Length extension and you know all your\0A * peers are using it too!\0A */\0A#if !defined(MBEDTLS_SSL_IN_CONTENT_LEN)\0A#define MBEDTLS_SSL_IN_CONTENT_LEN 16384\0A#endif\0A\0A#if !defined(MBEDTLS_SSL_OUT_CONTENT_LEN)\0A#define MBEDTLS_SSL_OUT_CONTENT_LEN 16384\0A#endif\0A\0A/*\0A * Maximum number of heap-allocated bytes for the purpose of\0A * DTLS handshake message reassembly and future message buffering.\0A */\0A#if !defined(MBEDTLS_SSL_DTLS_MAX_BUFFERING)\0A#define MBEDTLS_SSL_DTLS_MAX_BUFFERING 32768\0A#endif\0A\0A/*\0A * Maximum length of CIDs for incoming and outgoing messages.\0A */\0A#if !defined(MBEDTLS_SSL_CID_IN_LEN_MAX)\0A#define MBEDTLS_SSL_CID_IN_LEN_MAX          32\0A#endif\0A\0A#if !defined(MBEDTLS_SSL_CID_OUT_LEN_MAX)\0A#define MBEDTLS_SSL_CID_OUT_LEN_MAX         32\0A#endif\0A\0A#if !defined(MBEDTLS_SSL_CID_TLS1_3_PADDING_GRANULARITY)\0A#define MBEDTLS_SSL_CID_TLS1_3_PADDING_GRANULARITY 16\0A#endif\0A\0A#if !defined(MBEDTLS_SSL_MAX_EARLY_DATA_SIZE)\0A#define MBEDTLS_SSL_MAX_EARLY_DATA_SIZE        1024\0A#endif\0A\0A#if !defined(MBEDTLS_SSL_TLS1_3_TICKET_AGE_TOLERANCE)\0A#define MBEDTLS_SSL_TLS1_3_TICKET_AGE_TOLERANCE 6000\0A#endif\0A\0A#if !defined(MBEDTLS_SSL_TLS1_3_TICKET_NONCE_LENGTH)\0A#define MBEDTLS_SSL_TLS1_3_TICKET_NONCE_LENGTH 32\0A#endif\0A\0A#if !defined(MBEDTLS_SSL_TLS1_3_DEFAULT_NEW_SESSION_TICKETS)\0A#define MBEDTLS_SSL_TLS1_3_DEFAULT_NEW_SESSION_TICKETS 1\0A#endif\0A\0A/** \5C} name SECTION: Module settings */\0A\0A/*\0A * Default to standard CID mode\0A */\0A#if defined(MBEDTLS_SSL_DTLS_CONNECTION_ID) && \5C\0A    !defined(MBEDTLS_SSL_DTLS_CONNECTION_ID_COMPAT)\0A#define MBEDTLS_SSL_DTLS_CONNECTION_ID_COMPAT 0\0A#endif\0A\0A/*\0A * Length of the verify data for secure renegotiation\0A */\0A#define MBEDTLS_SSL_VERIFY_DATA_MAX_LEN 12\0A\0A/*\0A * Signaling ciphersuite values (SCSV)\0A */\0A#define MBEDTLS_SSL_EMPTY_RENEGOTIATION_INFO    0xFF   /**< renegotiation info ext */\0A\0A/*\0A * Supported Signature and Hash algorithms (For TLS 1.2)\0A * RFC 5246 section 7.4.1.4.1\0A */\0A#define MBEDTLS_SSL_HASH_NONE                0\0A#define MBEDTLS_SSL_HASH_MD5                 1\0A#define MBEDTLS_SSL_HASH_SHA1                2\0A#define MBEDTLS_SSL_HASH_SHA224              3\0A#define MBEDTLS_SSL_HASH_SHA256              4\0A#define MBEDTLS_SSL_HASH_SHA384              5\0A#define MBEDTLS_SSL_HASH_SHA512              6\0A\0A#define MBEDTLS_SSL_SIG_ANON                 0\0A#define MBEDTLS_SSL_SIG_RSA                  1\0A#define MBEDTLS_SSL_SIG_ECDSA                3\0A\0A/*\0A * TLS 1.3 signature algorithms\0A * RFC 8446, Section 4.2.3\0A */\0A\0A/* RSASSA-PKCS1-v1_5 algorithms */\0A#define MBEDTLS_TLS1_3_SIG_RSA_PKCS1_SHA256 0x0401\0A#define MBEDTLS_TLS1_3_SIG_RSA_PKCS1_SHA384 0x0501\0A#define MBEDTLS_TLS1_3_SIG_RSA_PKCS1_SHA512 0x0601\0A\0A/* ECDSA algorithms */\0A#define MBEDTLS_TLS1_3_SIG_ECDSA_SECP256R1_SHA256 0x0403\0A#define MBEDTLS_TLS1_3_SIG_ECDSA_SECP384R1_SHA384 0x0503\0A#define MBEDTLS_TLS1_3_SIG_ECDSA_SECP521R1_SHA512 0x0603\0A\0A/* RSASSA-PSS algorithms with public key OID rsaEncryption */\0A#define MBEDTLS_TLS1_3_SIG_RSA_PSS_RSAE_SHA256 0x0804\0A#define MBEDTLS_TLS1_3_SIG_RSA_PSS_RSAE_SHA384 0x0805\0A#define MBEDTLS_TLS1_3_SIG_RSA_PSS_RSAE_SHA512 0x0806\0A\0A/* EdDSA algorithms */\0A#define MBEDTLS_TLS1_3_SIG_ED25519 0x0807\0A#define MBEDTLS_TLS1_3_SIG_ED448 0x0808\0A\0A/* RSASSA-PSS algorithms with public key OID RSASSA-PSS  */\0A#define MBEDTLS_TLS1_3_SIG_RSA_PSS_PSS_SHA256 0x0809\0A#define MBEDTLS_TLS1_3_SIG_RSA_PSS_PSS_SHA384 0x080A\0A#define MBEDTLS_TLS1_3_SIG_RSA_PSS_PSS_SHA512 0x080B\0A\0A/* LEGACY ALGORITHMS */\0A#define MBEDTLS_TLS1_3_SIG_RSA_PKCS1_SHA1 0x0201\0A#define MBEDTLS_TLS1_3_SIG_ECDSA_SHA1     0x0203\0A\0A#define MBEDTLS_TLS1_3_SIG_NONE 0x0\0A\0A/*\0A * Client Certificate Types\0A * RFC 5246 section 7.4.4 plus RFC 4492 section 5.5\0A */\0A#define MBEDTLS_SSL_CERT_TYPE_RSA_SIGN       1\0A#define MBEDTLS_SSL_CERT_TYPE_ECDSA_SIGN    64\0A\0A/*\0A * Message, alert and handshake types\0A */\0A#define MBEDTLS_SSL_MSG_CHANGE_CIPHER_SPEC     20\0A#define MBEDTLS_SSL_MSG_ALERT                  21\0A#define MBEDTLS_SSL_MSG_HANDSHAKE              22\0A#define MBEDTLS_SSL_MSG_APPLICATION_DATA       23\0A#define MBEDTLS_SSL_MSG_CID                    25\0A\0A#define MBEDTLS_SSL_ALERT_LEVEL_WARNING         1\0A#define MBEDTLS_SSL_ALERT_LEVEL_FATAL           2\0A\0A#define MBEDTLS_SSL_ALERT_MSG_CLOSE_NOTIFY           0  /* 0x00 */\0A#define MBEDTLS_SSL_ALERT_MSG_UNEXPECTED_MESSAGE    10  /* 0x0A */\0A#define MBEDTLS_SSL_ALERT_MSG_BAD_RECORD_MAC        20  /* 0x14 */\0A#define MBEDTLS_SSL_ALERT_MSG_DECRYPTION_FAILED     21  /* 0x15 */\0A#define MBEDTLS_SSL_ALERT_MSG_RECORD_OVERFLOW       22  /* 0x16 */\0A#define MBEDTLS_SSL_ALERT_MSG_DECOMPRESSION_FAILURE 30  /* 0x1E */\0A#define MBEDTLS_SSL_ALERT_MSG_HANDSHAKE_FAILURE     40  /* 0x28 */\0A#define MBEDTLS_SSL_ALERT_MSG_NO_CERT               41  /* 0x29 */\0A#define MBEDTLS_SSL_ALERT_MSG_BAD_CERT              42  /* 0x2A */\0A#define MBEDTLS_SSL_ALERT_MSG_UNSUPPORTED_CERT      43  /* 0x2B */\0A#define MBEDTLS_SSL_ALERT_MSG_CERT_REVOKED          44  /* 0x2C */\0A#define MBEDTLS_SSL_ALERT_MSG_CERT_EXPIRED          45  /* 0x2D */\0A#define MBEDTLS_SSL_ALERT_MSG_CERT_UNKNOWN          46  /* 0x2E */\0A#define MBEDTLS_SSL_ALERT_MSG_ILLEGAL_PARAMETER     47  /* 0x2F */\0A#define MBEDTLS_SSL_ALERT_MSG_UNKNOWN_CA            48  /* 0x30 */\0A#define MBEDTLS_SSL_ALERT_MSG_ACCESS_DENIED         49  /* 0x31 */\0A#define MBEDTLS_SSL_ALERT_MSG_DECODE_ERROR          50  /* 0x32 */\0A#define MBEDTLS_SSL_ALERT_MSG_DECRYPT_ERROR         51  /* 0x33 */\0A#define MBEDTLS_SSL_ALERT_MSG_EXPORT_RESTRICTION    60  /* 0x3C */\0A#define MBEDTLS_SSL_ALERT_MSG_PROTOCOL_VERSION      70  /* 0x46 */\0A#define MBEDTLS_SSL_ALERT_MSG_INSUFFICIENT_SECURITY 71  /* 0x47 */\0A#define MBEDTLS_SSL_ALERT_MSG_INTERNAL_ERROR        80  /* 0x50 */\0A#define MBEDTLS_SSL_ALERT_MSG_INAPROPRIATE_FALLBACK 86  /* 0x56 */\0A#define MBEDTLS_SSL_ALERT_MSG_USER_CANCELED         90  /* 0x5A */\0A#define MBEDTLS_SSL_ALERT_MSG_NO_RENEGOTIATION     100  /* 0x64 */\0A#define MBEDTLS_SSL_ALERT_MSG_MISSING_EXTENSION    109  /* 0x6d -- new in TLS 1.3 */\0A#define MBEDTLS_SSL_ALERT_MSG_UNSUPPORTED_EXT      110  /* 0x6E */\0A#define MBEDTLS_SSL_ALERT_MSG_UNRECOGNIZED_NAME    112  /* 0x70 */\0A#define MBEDTLS_SSL_ALERT_MSG_UNKNOWN_PSK_IDENTITY 115  /* 0x73 */\0A#define MBEDTLS_SSL_ALERT_MSG_CERT_REQUIRED        116  /* 0x74 */\0A#define MBEDTLS_SSL_ALERT_MSG_NO_APPLICATION_PROTOCOL 120 /* 0x78 */\0A\0A#define MBEDTLS_SSL_HS_HELLO_REQUEST            0\0A#define MBEDTLS_SSL_HS_CLIENT_HELLO             1\0A#define MBEDTLS_SSL_HS_SERVER_HELLO             2\0A#define MBEDTLS_SSL_HS_HELLO_VERIFY_REQUEST     3\0A#define MBEDTLS_SSL_HS_NEW_SESSION_TICKET       4\0A#define MBEDTLS_SSL_HS_END_OF_EARLY_DATA        5\0A#define MBEDTLS_SSL_HS_ENCRYPTED_EXTENSIONS     8\0A#define MBEDTLS_SSL_HS_CERTIFICATE             11\0A#define MBEDTLS_SSL_HS_SERVER_KEY_EXCHANGE     12\0A#define MBEDTLS_SSL_HS_CERTIFICATE_REQUEST     13\0A#define MBEDTLS_SSL_HS_SERVER_HELLO_DONE       14\0A#define MBEDTLS_SSL_HS_CERTIFICATE_VERIFY      15\0A#define MBEDTLS_SSL_HS_CLIENT_KEY_EXCHANGE     16\0A#define MBEDTLS_SSL_HS_FINISHED                20\0A#define MBEDTLS_SSL_HS_MESSAGE_HASH           254\0A\0A/*\0A * TLS extensions\0A */\0A#define MBEDTLS_TLS_EXT_SERVERNAME                   0\0A#define MBEDTLS_TLS_EXT_SER