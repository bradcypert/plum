@.str41793 = private global { i64, i64, [6978 x i8] } { i64 -1, i64 6977, [6978 x i8] c"/**\0A * \5Cfile nist_kw.h\0A *\0A * \5Cbrief This file provides an API for key wrapping (KW) and key wrapping with\0A *        padding (KWP) as defined in NIST SP 800-38F.\0A *        https://nvlpubs.nist.gov/nistpubs/SpecialPublications/NIST.SP.800-38F.pdf\0A *\0A *        Key wrapping specifies a deterministic authenticated-encryption mode\0A *        of operation, according to <em>NIST SP 800-38F: Recommendation for\0A *        Block Cipher Modes of Operation: Methods for Key Wrapping</em>. Its\0A *        purpose is to protect cryptographic keys.\0A *\0A *        Its equivalent is RFC 3394 for KW, and RFC 5649 for KWP.\0A *        https://tools.ietf.org/html/rfc3394\0A *        https://tools.ietf.org/html/rfc5649\0A *\0A */\0A/*\0A *  Copyright The Mbed TLS Contributors\0A *  SPDX-License-Identifier: Apache-2.0 OR GPL-2.0-or-later\0A */\0A\0A#ifndef MBEDTLS_NIST_KW_H\0A#define MBEDTLS_NIST_KW_H\0A#include \22mbedtls/private_access.h\22\0A\0A#include \22mbedtls/build_info.h\22\0A\0A#include \22mbedtls/cipher.h\22\0A\0A#ifdef __cplusplus\0Aextern \22C\22 {\0A#endif\0A\0Atypedef enum {\0A    MBEDTLS_KW_MODE_KW = 0,\0A    MBEDTLS_KW_MODE_KWP = 1\0A} mbedtls_nist_kw_mode_t;\0A\0A#if !defined(MBEDTLS_NIST_KW_ALT)\0A// Regular implementation\0A//\0A\0A/**\0A * \5Cbrief    The key wrapping context-type definition. The key wrapping context is passed\0A *           to the APIs called.\0A *\0A * \5Cnote     The definition of this type may change in future library versions.\0A *           Don't make any assumptions on this context!\0A */\0Atypedef struct {\0A    mbedtls_cipher_context_t MBEDTLS_PRIVATE(cipher_ctx);    /*!< The cipher context used. */\0A} mbedtls_nist_kw_context;\0A\0A#else  /* MBEDTLS_NIST_key wrapping_ALT */\0A#include \22nist_kw_alt.h\22\0A#endif /* MBEDTLS_NIST_KW_ALT */\0A\0A/**\0A * \5Cbrief           This function initializes the specified key wrapping context\0A *                  to make references valid and prepare the context\0A *                  for mbedtls_nist_kw_setkey() or mbedtls_nist_kw_free().\0A *\0A * \5Cparam ctx       The key wrapping context to initialize.\0A *\0A */\0Avoid mbedtls_nist_kw_init(mbedtls_nist_kw_context *ctx);\0A\0A/**\0A * \5Cbrief           This function initializes the key wrapping context set in the\0A *                  \5Cp ctx parameter and sets the encryption key.\0A *\0A * \5Cparam ctx       The key wrapping context.\0A * \5Cparam cipher    The 128-bit block cipher to use. Only AES is supported.\0A * \5Cparam key       The Key Encryption Key (KEK).\0A * \5Cparam keybits   The KEK size in bits. This must be acceptable by the cipher.\0A * \5Cparam is_wrap   Specify whether the operation within the context is wrapping or unwrapping\0A *\0A * \5Creturn          \5Cc 0 on success.\0A * \5Creturn          \5Cc MBEDTLS_ERR_CIPHER_BAD_INPUT_DATA for any invalid input.\0A * \5Creturn          \5Cc MBEDTLS_ERR_CIPHER_FEATURE_UNAVAILABLE for 128-bit block ciphers\0A *                  which are not supported.\0A * \5Creturn          cipher-specific error code on failure of the underlying cipher.\0A */\0Aint mbedtls_nist_kw_setkey(mbedtls_nist_kw_context *ctx,\0A                           mbedtls_cipher_id_t cipher,\0A                           const unsigned char *key,\0A                           unsigned int keybits,\0A                           const int is_wrap);\0A\0A/**\0A * \5Cbrief   This function releases and clears the specified key wrapping context\0A *          and underlying cipher sub-context.\0A *\0A * \5Cparam ctx       The key wrapping context to clear.\0A */\0Avoid mbedtls_nist_kw_free(mbedtls_nist_kw_context *ctx);\0A\0A/**\0A * \5Cbrief           This function encrypts a buffer using key wrapping.\0A *\0A * \5Cparam ctx       The key wrapping context to use for encryption.\0A * \5Cparam mode      The key wrapping mode to use (MBEDTLS_KW_MODE_KW or MBEDTLS_KW_MODE_KWP)\0A * \5Cparam input     The buffer holding the input data.\0A * \5Cparam in_len    The length of the input data in Bytes.\0A *                  The input uses units of 8 Bytes called semiblocks.\0A *                  <ul><li>For KW mode: a multiple of 8 bytes between 16 and 2^57-8 inclusive. </li>\0A *                  <li>For KWP mode: any length between 1 and 2^32-1 inclusive.</li></ul>\0A * \5Cparam[out] output    The buffer holding the output data.\0A *                  <ul><li>For KW mode: Must be at least 8 bytes larger than \5Cp in_len.</li>\0A *                  <li>For KWP mode: Must be at least 8 bytes larger rounded up to a multiple of\0A *                  8 bytes for KWP (15 bytes at most).</li></ul>\0A * \5Cparam[out] out_len The number of bytes written to the output buffer. \5Cc 0 on failure.\0A * \5Cparam[in] out_size The capacity of the output buffer.\0A *\0A * \5Creturn          \5Cc 0 on success.\0A * \5Creturn          \5Cc MBEDTLS_ERR_CIPHER_BAD_INPUT_DATA for invalid input length.\0A * \5Creturn          cipher-specific error code on failure of the underlying cipher.\0A */\0Aint mbedtls_nist_kw_wrap(mbedtls_nist_kw_context *ctx, mbedtls_nist_kw_mode_t mode,\0A                         const unsigned char *input, size_t in_len,\0A                         unsigned char *output, size_t *out_len, size_t out_size);\0A\0A/**\0A * \5Cbrief           This function decrypts a buffer using key wrapping.\0A *\0A * \5Cparam ctx       The key wrapping context to use for decryption.\0A * \5Cparam mode      The key wrapping mode to use (MBEDTLS_KW_MODE_KW or MBEDTLS_KW_MODE_KWP)\0A * \5Cparam input     The buffer holding the input data.\0A * \5Cparam in_len    The length of the input data in Bytes.\0A *                  The input uses units of 8 Bytes called semiblocks.\0A *                  The input must be a multiple of semiblocks.\0A *                  <ul><li>For KW mode: a multiple of 8 bytes between 24 and 2^57 inclusive. </li>\0A *                  <li>For KWP mode: a multiple of 8 bytes between 16 and 2^32 inclusive.</li></ul>\0A * \5Cparam[out] output    The buffer holding the output data.\0A *                  The output buffer's minimal length is 8 bytes shorter than \5Cp in_len.\0A * \5Cparam[out] out_len The number of bytes written to the output buffer. \5Cc 0 on failure.\0A *                  For KWP mode, the length could be up to 15 bytes shorter than \5Cp in_len,\0A *                  depending on how much padding was added to the data.\0A * \5Cparam[in] out_size The capacity of the output buffer.\0A *\0A * \5Creturn          \5Cc 0 on success.\0A * \5Creturn          \5Cc MBEDTLS_ERR_CIPHER_BAD_INPUT_DATA for invalid input length.\0A * \5Creturn          \5Cc MBEDTLS_ERR_CIPHER_AUTH_FAILED for verification failure of the ciphertext.\0A * \5Creturn          cipher-specific error code on failure of the underlying cipher.\0A */\0Aint mbedtls_nist_kw_unwrap(mbedtls_nist_kw_context *ctx, mbedtls_nist_kw_mode_t mode,\0A                           const unsigned char *input, size_t in_len,\0A                           unsigned char *output, size_t *out_len, size_t out_size);\0A\0A\0A#if defined(MBEDTLS_SELF_TEST) && defined(MBEDTLS_AES_C)\0A/**\0A * \5Cbrief          The key wrapping checkup routine.\0A *\0A * \5Creturn         \5Cc 0 on success.\0A * \5Creturn         \5Cc 1 on failure.\0A */\0Aint mbedtls_nist_kw_self_test(int verbose);\0A#endif /* MBEDTLS_SELF_TEST && MBEDTLS_AES_C */\0A\0A#ifdef __cplusplus\0A}\0A#endif\0A\0A#endif /* MBEDTLS_NIST_KW_H */\0A\00" }
