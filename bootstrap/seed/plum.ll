@.str41530 = private global { i64, i64, [19808 x i8] } { i64 -1, i64 19807, [19808 x i8] c"/*\0A *  Diffie-Hellman-Merkle key exchange\0A *\0A *  Copyright The Mbed TLS Contributors\0A *  SPDX-License-Identifier: Apache-2.0 OR GPL-2.0-or-later\0A */\0A/*\0A *  The following sources were referenced in the design of this implementation\0A *  of the Diffie-Hellman-Merkle algorithm:\0A *\0A *  [1] Handbook of Applied Cryptography - 1997, Chapter 12\0A *      Menezes, van Oorschot and Vanstone\0A *\0A */\0A\0A#include \22common.h\22\0A\0A#if defined(MBEDTLS_DHM_C)\0A\0A#include \22mbedtls/dhm.h\22\0A#include \22mbedtls/platform_util.h\22\0A#include \22mbedtls/error.h\22\0A\0A#include <string.h>\0A\0A#if defined(MBEDTLS_PEM_PARSE_C)\0A#include \22mbedtls/pem.h\22\0A#endif\0A\0A#if defined(MBEDTLS_ASN1_PARSE_C)\0A#include \22mbedtls/asn1.h\22\0A#endif\0A\0A#include \22mbedtls/platform.h\22\0A\0A#if !defined(MBEDTLS_DHM_ALT)\0A\0A/*\0A * helper to validate the mbedtls_mpi size and import it\0A */\0Astatic int dhm_read_bignum(mbedtls_mpi *X,\0A                           unsigned char **p,\0A                           const unsigned char *end)\0A{\0A    int ret, n;\0A\0A    if (end - *p < 2) {\0A        return MBEDTLS_ERR_DHM_BAD_INPUT_DATA;\0A    }\0A\0A    n = MBEDTLS_GET_UINT16_BE(*p, 0);\0A    (*p) += 2;\0A\0A    if ((size_t) (end - *p) < (size_t) n) {\0A        return MBEDTLS_ERR_DHM_BAD_INPUT_DATA;\0A    }\0A\0A    if ((ret = mbedtls_mpi_read_binary(X, *p, n)) != 0) {\0A        return MBEDTLS_ERROR_ADD(MBEDTLS_ERR_DHM_READ_PARAMS_FAILED, ret);\0A    }\0A\0A    (*p) += n;\0A\0A    return 0;\0A}\0A\0A/*\0A * Verify sanity of parameter with regards to P\0A *\0A * Parameter should be: 2 <= public_param <= P - 2\0A *\0A * This means that we need to return an error if\0A *              public_param < 2 or public_param > P-2\0A *\0A * For more information on the attack, see:\0A *  http://www.cl.cam.ac.uk/~rja14/Papers/psandqs.pdf\0A *  http://web.nvd.nist.gov/view/vuln/detail?vulnId=CVE-2005-2643\0A */\0Astatic int dhm_check_range(const mbedtls_mpi *param, const mbedtls_mpi *P)\0A{\0A    mbedtls_mpi U;\0A    int ret = 0;\0A\0A    mbedtls_mpi_init(&U);\0A\0A    MBEDTLS_MPI_CHK(mbedtls_mpi_sub_int(&U, P, 2));\0A\0A    if (mbedtls_mpi_cmp_int(param, 2) < 0 ||\0A        mbedtls_mpi_cmp_mpi(param, &U) > 0) {\0A        ret = MBEDTLS_ERR_DHM_BAD_INPUT_DATA;\0A    }\0A\0Acleanup:\0A    mbedtls_mpi_free(&U);\0A    return ret;\0A}\0A\0Avoid mbedtls_dhm_init(mbedtls_dhm_context *ctx)\0A{\0A    memset(ctx, 0, sizeof(mbedtls_dhm_context));\0A}\0A\0Asize_t mbedtls_dhm_get_bitlen(const mbedtls_dhm_context *ctx)\0A{\0A    return mbedtls_mpi_bitlen(&ctx->P);\0A}\0A\0Asize_t mbedtls_dhm_get_len(const mbedtls_dhm_context *ctx)\0A{\0A    return mbedtls_mpi_size(&ctx->P);\0A}\0A\0Aint mbedtls_dhm_get_value(const mbedtls_dhm_context *ctx,\0A                          mbedtls_dhm_parameter param,\0A                          mbedtls_mpi *dest)\0A{\0A    const mbedtls_mpi *src = NULL;\0A    switch (param) {\0A        case MBEDTLS_DHM_PARAM_P:\0A            src = &ctx->P;\0A            break;\0A        case MBEDTLS_DHM_PARAM_G:\0A            src = &ctx->G;\0A            break;\0A        case MBEDTLS_DHM_PARAM_X:\0A            src = &ctx->X;\0A            break;\0A        case MBEDTLS_DHM_PARAM_GX:\0A            src = &ctx->GX;\0A            break;\0A        case MBEDTLS_DHM_PARAM_GY:\0A            src = &ctx->GY;\0A            break;\0A        case MBEDTLS_DHM_PARAM_K:\0A            src = &ctx->K;\0A            break;\0A        default:\0A            return MBEDTLS_ERR_DHM_BAD_INPUT_DATA;\0A    }\0A    return mbedtls_mpi_copy(dest, src);\0A}\0A\0A/*\0A * Parse the ServerKeyExchange parameters\0A */\0Aint mbedtls_dhm_read_params(mbedtls_dhm_context *ctx,\0A                            unsigned char **p,\0A                            const unsigned char *end)\0A{\0A    int ret = MBEDTLS_ERR_ERROR_CORRUPTION_DETECTED;\0A\0A    if ((ret = dhm_read_bignum(&ctx->P,  p, end)) != 0 ||\0A        (ret = dhm_read_bignum(&ctx->G,  p, end)) != 0 ||\0A        (ret = dhm_read_bignum(&ctx->GY, p, end)) != 0) {\0A        return ret;\0A    }\0A\0A    if ((ret = dhm_check_range(&ctx->GY, &ctx->P)) != 0) {\0A        return ret;\0A    }\0A\0A    return 0;\0A}\0A\0A/*\0A * Pick a random R in the range [2, M-2] for blinding or key generation.\0A */\0Astatic int dhm_random_below(mbedtls_mpi *R, const mbedtls_mpi *M,\0A                            int (*f_rng)(void *, unsigned char *, size_t), void *p_rng)\0A{\0A    int ret;\0A\0A    MBEDTLS_MPI_CHK(mbedtls_mpi_random(R, 3, M, f_rng, p_rng));\0A    MBEDTLS_MPI_CHK(mbedtls_mpi_sub_int(R, R, 1));\0A\0Acleanup:\0A    return ret;\0A}\0A\0Astatic int dhm_make_common(mbedtls_dhm_context *ctx, int x_size,\0A                           int (*f_rng)(void *, unsigned char *, size_t),\0A                           void *p_rng)\0A{\0A    int ret = 0;\0A\0A    if (mbedtls_mpi_cmp_int(&ctx->P, 0) == 0) {\0A        return MBEDTLS_ERR_DHM_BAD_INPUT_DATA;\0A    }\0A    if (x_size < 0) {\0A        return MBEDTLS_ERR_DHM_BAD_INPUT_DATA;\0A    }\0A\0A    if ((unsigned) x_size < mbedtls_mpi_size(&ctx->P)) {\0A        MBEDTLS_MPI_CHK(mbedtls_mpi_fill_random(&ctx->X, x_size, f_rng, p_rng));\0A    } else {\0A        /* Generate X as large as possible ( <= P - 2 ) */\0A        ret = dhm_random_below(&ctx->X, &ctx->P, f_rng, p_rng);\0A        if (ret == MBEDTLS_ERR_MPI_NOT_ACCEPTABLE) {\0A            return MBEDTLS_ERR_DHM_MAKE_PARAMS_FAILED;\0A        }\0A        if (ret != 0) {\0A            return ret;\0A        }\0A    }\0A\0A    /*\0A     * Calculate GX = G^X mod P\0A     */\0A    MBEDTLS_MPI_CHK(mbedtls_mpi_exp_mod(&ctx->GX, &ctx->G, &ctx->X,\0A                                        &ctx->P, &ctx->RP));\0A\0A    if ((ret = dhm_check_range(&ctx->GX, &ctx->P)) != 0) {\0A        return ret;\0A    }\0A\0Acleanup:\0A    return ret;\0A}\0A\0A/*\0A * Setup and write the ServerKeyExchange parameters\0A */\0Aint mbedtls_dhm_make_params(mbedtls_dhm_context *ctx, int x_size,\0A                            unsigned char *output, size_t *olen,\0A                            int (*f_rng)(void *, unsigned char *, size_t),\0A                            void *p_rng)\0A{\0A    int ret;\0A    size_t n1, n2, n3;\0A    unsigned char *p;\0A\0A    ret = dhm_make_common(ctx, x_size, f_rng, p_rng);\0A    if (ret != 0) {\0A        goto cleanup;\0A    }\0A\0A    /*\0A     * Export P, G, GX. RFC 5246 §4.4 states that \22leading zero octets are\0A     * not required\22. We omit leading zeros for compactness.\0A     */\0A#define DHM_MPI_EXPORT(X, n)                                          \5C\0A    do {                                                                \5C\0A        MBEDTLS_MPI_CHK(mbedtls_mpi_write_binary((X),               \5C\0A                                                 p + 2,               \5C\0A                                                 (n)));           \5C\0A        *p++ = MBEDTLS_BYTE_1(n);                                     \5C\0A        *p++ = MBEDTLS_BYTE_0(n);                                     \5C\0A        p += (n);                                                     \5C\0A    } while (0)\0A\0A    n1 = mbedtls_mpi_size(&ctx->P);\0A    n2 = mbedtls_mpi_size(&ctx->G);\0A    n3 = mbedtls_mpi_size(&ctx->GX);\0A\0A    p = output;\0A    DHM_MPI_EXPORT(&ctx->P, n1);\0A    DHM_MPI_EXPORT(&ctx->G, n2);\0A    DHM_MPI_EXPORT(&ctx->GX, n3);\0A\0A    *olen = (size_t) (p - output);\0A\0Acleanup:\0A    if (ret != 0 && ret > -128) {\0A        ret = MBEDTLS_ERROR_ADD(MBEDTLS_ERR_DHM_MAKE_PARAMS_FAILED, ret);\0A    }\0A    return ret;\0A}\0A\0A/*\0A * Set prime modulus and generator\0A */\0Aint mbedtls_dhm_set_group(mbedtls_dhm_context *ctx,\0A                          const mbedtls_mpi *P,\0A                          const mbedtls_mpi *G)\0A{\0A    int ret = MBEDTLS_ERR_ERROR_CORRUPTION_DETECTED;\0A\0A    if ((ret = mbedtls_mpi_copy(&ctx->P, P)) != 0 ||\0A        (ret = mbedtls_mpi_copy(&ctx->G, G)) != 0) {\0A        return MBEDTLS_ERROR_ADD(MBEDTLS_ERR_DHM_SET_GROUP_FAILED, ret);\0A    }\0A\0A    return 0;\0A}\0A\0A/*\0A * Import the peer's public value G^Y\0A */\0Aint mbedtls_dhm_read_public(mbedtls_dhm_context *ctx,\0A                            const unsigned char *input, size_t ilen)\0A{\0A    int ret = MBEDTLS_ERR_ERROR_CORRUPTION_DETECTED;\0A\0A    if (ilen < 1 || ilen > mbedtls_dhm_get_len(ctx)) {\0A        return MBEDTLS_ERR_DHM_BAD_INPUT_DATA;\0A    }\0A\0A    if ((ret = mbedtls_mpi_read_binary(&ctx->GY, input, ilen)) != 0) {\0A        return MBEDTLS_ERROR_ADD(MBEDTLS_ERR_DHM_READ_PUBLIC_FAILED, ret);\0A    }\0A\0A    return 0;\0A}\0A\0A/*\0A * Create own private value X and export G^X\0A */\0Aint mbedtls_dhm_make_public(mbedtls_dhm_context *ctx, int x_size,\0A                            unsigned char *output, size_t olen,\0A                            int (*f_rng)(void *, unsigned char *, size_t),\0A                            void *p_rng)\0A{\0A    int ret;\0A\0A    if (olen < 1 || olen > mbedtls_dhm_get_len(ctx)) {\0A        return MBEDTLS_ERR_DHM_BAD_INPUT_DATA;\0A    }\0A\0A    ret = dhm_make_common(ctx, x_size, f_rng, p_rng);\0A    if (ret == MBEDTLS_ERR_DHM_MAKE_PARAMS_FAILED) {\0A        return MBEDTLS_ERR_DHM_MAKE_PUBLIC_FAILED;\0A    }\0A    if (ret != 0) {\0A        goto cleanup;\0A    }\0A\0A    MBEDTLS_MPI_CHK(mbedtls_mpi_write_binary(&ctx->GX, output, olen));\0A\0Acleanup:\0A    if (ret != 0 && ret > -128) {\0A        ret = MBEDTLS_ERROR_ADD(MBEDTLS_ERR_DHM_MAKE_PUBLIC_FAILED, ret);\0A    }\0A    return ret;\0A}\0A\0A\0A/*\0A * Use the blinding method and optimisation suggested in section 10 of:\0A *  KOCHER, Paul C. Timing attacks on implementations of Diffie-Hellman, RSA,\0A *  DSS, and other systems. In : Advances in Cryptology-CRYPTO'96. Springer\0A *  Berlin Heidelberg, 1996. p. 104-113.\0A */\0Astatic int dhm_update_blinding(mbedtls_dhm_context *ctx,\0A                               int (*f_rng)(void *, unsigned char *, size_t), void *p_rng)\0A{\0A    int ret;\0A    mbedtls_mpi R;\0A\0A    mbedtls_mpi_init(&R);\0A\0A    /*\0A     * Don't use any blinding the first time a particular X is used,\0A     * but remember it to use blinding next time.\0A     */\0A    if (mbedtls_mpi_cmp_mpi(&ctx->X, &ctx->pX) != 0) {\0A        MBEDTLS_MPI_CHK(mbedtls_mpi_copy(&ctx->pX, &ctx->X));\0A        MBEDTLS_MPI_CHK(mbedtls_mpi_lset(&ctx->Vi, 1));\0A        MBEDTLS_MPI_CHK(mbedtls_mpi_lset(&ctx->Vf, 1));\0A\0A        return 0;\0A    }\0A\0A    /*\0A     * Ok, we need blinding. Can we re-use existing values?\0A     * If yes, just update them by squaring them.\0A     */\0A    if (mbedtls_mpi_cmp_int(&ctx->Vi, 1) != 0) {\0A        MBEDTLS_MPI_CHK(mbedtls_mpi_mul_mpi(&ctx->Vi, &ctx->Vi, &ctx->Vi));\0A        MBEDTLS_MPI_CHK(mbedtls_mpi_mod_mpi(&ctx->Vi, &ctx->Vi, &ctx->P));\0A\0A        MBEDTLS_MPI_CHK(mbedtls_mpi_mul_mpi(&ctx->Vf, &ctx->Vf, &ctx->Vf));\0A        MBEDTLS_MPI_CHK(mbedtls_mpi_mod_mpi(&ctx->Vf, &ctx->Vf, &ctx->P));\0A\0A        return 0;\0A    }\0A\0A    /*\0A     * We need to generate blinding values from scratch\0A     */\0A\0A    /* Vi = random( 2, P-2 ) */\0A    MBEDTLS_MPI_CHK(dhm_random_below(&ctx->Vi, &ctx->P, f_rng, p_rng));\0A\0A    /* Vf = Vi^-X mod P\0A     * First compute Vi^-1 = R * (R Vi)^-1, (avoiding leaks from inv_mod),\0A     * then elevate to the Xth power. */\0A    MBEDTLS_MPI_CHK(dhm_random_below(&R, &ctx->P, f_rng, p_rng));\0A    MBEDTLS_MPI_CHK(mbedtls_mpi_mul_mpi(&ctx->Vf, &ctx->Vi, &R));\0A    MBEDTLS_MPI_CHK(mbedtls_mpi_mod_mpi(&ctx->Vf, &ctx->Vf, &ctx->P));\0A    MBEDTLS_MPI_CHK(mbedtls_mpi_inv_mod(&ctx->Vf, &ctx->Vf, &ctx->P));\0A    MBEDTLS_MPI_CHK(mbedtls_mpi_mul_mpi(&ctx->Vf, &ctx->Vf, &R));\0A    MBEDTLS_MPI_CHK(mbedtls_mpi_mod_mpi(&ctx->Vf, &ctx->Vf, &ctx->P));\0A\0A    MBEDTLS_MPI_CHK(mbedtls_mpi_exp_mod(&ctx->Vf, &ctx->Vf, &ctx->X, &ctx->P, &ctx->RP));\0A\0Acleanup:\0A    mbedtls_mpi_free(&R);\0A\0A    return ret;\0A}\0A\0A/*\0A * Derive and export the shared secret (G^Y)^X mod P\0A */\0Aint mbedtls_dhm_calc_secret(mbedtls_dhm_context *ctx,\0A                            unsigned char *output, size_t output_size, size_t *olen,\0A                            int (*f_rng)(void *, unsigned char *, size_t),\0A                            void *p_rng)\0A{\0A    int ret = MBEDTLS_ERR_ERROR_CORRUPTION_DETECTED;\0A    mbedtls_mpi GYb;\0A\0A    if (f_rng == NULL) {\0A        return MBEDTLS_ERR_DHM_BAD_INPUT_DATA;\0A    }\0A\0A    if (output_size < mbedtls_dhm_get_len(ctx)) {\0A        return MBEDTLS_ERR_DHM_BAD_INPUT_DATA;\0A    }\0A\0A    if ((ret = dhm_check_range(&ctx->GY, &ctx->P)) != 0) {\0A        return ret;\0A    }\0A\0A    mbedtls_mpi_init(&GYb);\0A\0A    /* Blind peer's value */\0A    MBEDTLS_MPI_CHK(dhm_update_blinding(ctx, f_rng, p_rng));\0A    MBEDTLS_MPI_CHK(mbedtls_mpi_mul_mpi(&GYb, &ctx->GY, &ctx->Vi));\0A    MBEDTLS_MPI_CHK(mbedtls_mpi_mod_mpi(&GYb, &GYb, &ctx->P));\0A\0A    /* Do modular exponentiation */\0A    MBEDTLS_MPI_CHK(mbedtls_mpi_exp_mod(&ctx->K, &GYb, &ctx->X,\0A                                        &ctx->P, &ctx->RP));\0A\0A    /* Unblind secret value */\0A    MBEDTLS_MPI_CHK(mbedtls_mpi_mul_mpi(&ctx->K, &ctx->K, &ctx->Vf));\0A    MBEDTLS_MPI_CHK(mbedtls_mpi_mod_mpi(&ctx->K, &ctx->K, &ctx->P));\0A\0A    /* Output the secret without any leading zero byte. This is mandatory\0A     * for TLS per RFC 5246 §8.1.2. */\0A    *olen = mbedtls_mpi_size(&ctx->K);\0A    MBEDTLS_MPI_CHK(mbedtls_mpi_write_binary(&ctx->K, output, *olen));\0A\0Acleanup:\0A    mbedtls_mpi_free(&GYb);\0A\0A    if (ret != 0) {\0A        return MBEDTLS_ERROR_ADD(MBEDTLS_ERR_DHM_CALC_SECRET_FAILED, ret);\0A    }\0A\0A    return 0;\0A}\0A\0A/*\0A * Free the components of a DHM key\0A */\0Avoid mbedtls_dhm_free(mbedtls_dhm_context *ctx)\0A{\0A    if (ctx == NULL) {\0A        return;\0A    }\0A\0A    mbedtls_mpi_free(&ctx->pX);\0A    mbedtls_mpi_free(&ctx->Vf);\0A    mbedtls_mpi_free(&ctx->Vi);\0A    mbedtls_mpi_free(&ctx->RP);\0A    mbedtls_mpi_free(&ctx->K);\0A    mbedtls_mpi_free(&ctx->GY);\0A    mbedtls_mpi_free(&ctx->GX);\0A    mbedtls_mpi_free(&ctx->X);\0A    mbedtls_mpi_free(&ctx->G);\0A    mbedtls_mpi_free(&ctx->P);\0A\0A    mbedtls_platform_zeroize(ctx, sizeof(mbedtls_dhm_context));\0A}\0A\0A#if defined(MBEDTLS_ASN1_PARSE_C)\0A/*\0A * Parse DHM parameters\0A */\0Aint mbedtls_dhm_parse_dhm(mbedtls_dhm_context *dhm, const unsigned char *dhmin,\0A                          size_t dhminlen)\0A{\0A    int ret = MBEDTLS_ERR_ERROR_CORRUPTION_DETECTED;\0A    size_t len;\0A    unsigned char *p, *end;\0A#if defined(MBEDTLS_PEM_PARSE_C)\0A    mbedtls_pem_context pem;\0A#endif /* MBEDTLS_PEM_PARSE_C */\0A\0A#if defined(MBEDTLS_PEM_PARSE_C)\0A    mbedtls_pem_init(&pem);\0A\0A    /* Avoid calling mbedtls_pem_read_buffer() on non-null-terminated string */\0A    if (dhminlen == 0 || dhmin[dhminlen - 1] != '\5C0') {\0A        ret = MBEDTLS_ERR_PEM_NO_HEADER_FOOTER_PRESENT;\0A    } else {\0A        ret = mbedtls_pem_read_buffer(&pem,\0A                                      \22-----BEGIN DH PARAMETERS-----\22,\0A                                      \22-----END DH PARAMETERS-----\22,\0A                                      dhmin, NULL, 0, &dhminlen);\0A    }\0A\0A    if (ret == 0) {\0A        /*\0A         * Was PEM encoded\0A         */\0A        dhminlen = pem.buflen;\0A    } else if (ret != MBEDTLS_ERR_PEM_NO_HEADER_FOOTER_PRESENT) {\0A        goto exit;\0A    }\0A\0A    p = (ret == 0) ? pem.buf : (unsigned char *) dhmin;\0A#else\0A    p = (unsigned char *) dhmin;\0A#endif /* MBEDTLS_PEM_PARSE_C */\0A    end = p + dhminlen;\0A\0A    /*\0A     *  DHParams ::= SEQUENCE {\0A     *      prime              INTEGER,  -- P\0A     *      generator          INTEGER,  -- g\0A     *      privateValueLength INTEGER OPTIONAL\0A     *  }\0A     */\0A    if ((ret = mbedtls_asn1_get_tag(&p, end, &len,\0A                                    MBEDTLS_ASN1_CONSTRUCTED | MBEDTLS_ASN1_SEQUENCE)) != 0) {\0A        ret = MBEDTLS_ERROR_ADD(MBEDTLS_ERR_DHM_INVALID_FORMAT, ret);\0A        goto exit;\0A    }\0A\0A    end = p + len;\0A\0A    if ((ret = mbedtls_asn1_get_mpi(&p, end, &dhm->P)) != 0 ||\0A        (ret = mbedtls_asn1_get_mpi(&p, end, &dhm->G)) != 0) {\0A        ret = MBEDTLS_ERROR_ADD(MBEDTLS_ERR_DHM_INVALID_FORMAT, ret);\0A        goto exit;\0A    }\0A\0A    if (p != end) {\0A        /* This might be the optional privateValueLength.\0A         * If so, we can cleanly discard it */\0A        mbedtls_mpi rec;\0A        mbedtls_mpi_init(&rec);\0A        ret = mbedtls_asn1_get_mpi(&p, end, &rec);\0A        mbedtls_mpi_free(&rec);\0A        if (ret != 0) {\0A            ret = MBEDTLS_ERROR_ADD(MBEDTLS_ERR_DHM_INVALID_FORMAT, ret);\0A            goto exit;\0A        }\0A        if (p != end) {\0A            ret = MBEDTLS_ERROR_ADD(MBEDTLS_ERR_DHM_INVALID_FORMAT,\0A                                    MBEDTLS_ERR_ASN1_LENGTH_MISMATCH);\0A            goto exit;\0A        }\0A    }\0A\0A    ret = 0;\0A\0Aexit:\0A#if defined(MBEDTLS_PEM_PARSE_C)\0A    mbedtls_pem_free(&pem);\0A#endif\0A    if (ret != 0) {\0A        mbedtls_dhm_free(dhm);\0A    }\0A\0A    return ret;\0A}\0A\0A#if defined(MBEDTLS_FS_IO)\0A/*\0A * Load all data from a file into a given buffer.\0A *\0A * The file is expected to contain either PEM or DER encoded data.\0A * A terminating null byte is always appended. It is included in the announced\0A * length only if the data looks like it is PEM encoded.\0A */\0Astatic int load_file(const char *path, unsigned char **buf, size_t *n)\0A{\0A    FILE *f;\0A    long size;\0A\0A    if ((f = fopen(path, \22rb\22)) == NULL) {\0A        return MBEDTLS_ERR_DHM_FILE_IO_ERROR;\0A    }\0A    /* The data loaded here is public, so don't bother disabling buffering. */\0A\0A    fseek(f, 0, SEEK_END);\0A    if ((size = ftell(f)) == -1) {\0A        fclose(f);\0A        return MBEDTLS_ERR_DHM_FILE_IO_ERROR;\0A    }\0A    fseek(f, 0, SEEK_SET);\0A\0A    *n = (size_t) size;\0A\0A    if (*n + 1 == 0 ||\0A        (*buf = mbedtls_calloc(1, *n + 1)) == NULL) {\0A        fclose(f);\0A        return MBEDTLS_ERR_DHM_ALLOC_FAILED;\0A    }\0A\0A    if (fread(*buf, 1, *n, f) != *n) {\0A        fclose(f);\0A\0A        mbedtls_zeroize_and_free(*buf, *n + 1);\0A\0A        return MBEDTLS_ERR_DHM_FILE_IO_ERROR;\0A    }\0A\0A    fclose(f);\0A\0A    (*buf)[*n] = '\5C0';\0A\0A    if (strstr((const char *) *buf, \22-----BEGIN \22) != NULL) {\0A        ++*n;\0A    }\0A\0A    return 0;\0A}\0A\0A/*\0A * Load and parse DHM parameters\0A */\0Aint mbedtls_dhm_parse_dhmfile(mbedtls_dhm_context *dhm, const char *path)\0A{\0A    int ret = MBEDTLS_ERR_ERROR_CORRUPTION_DETECTED;\0A    size_t n;\0A    unsigned char *buf;\0A\0A    if ((ret = load_file(path, &buf, &n)) != 0) {\0A        return ret;\0A    }\0A\0A    ret = mbedtls_dhm_parse_dhm(dhm, buf, n);\0A\0A    mbedtls_zeroize_and_free(buf, n);\0A\0A    return ret;\0A}\0A#endif /* MBEDTLS_FS_IO */\0A#endif /* MBEDTLS_ASN1_PARSE_C */\0A#endif /* MBEDTLS_DHM_ALT */\0A\0A#if defined(MBEDTLS_SELF_TEST)\0A\0A#if defined(MBEDTLS_PEM_PARSE_C)\0Astatic const char mbedtls_test_dhm_params[] =\0A    \22-----BEGIN DH PARAMETERS-----\5Cr\5Cn\22\0A    \22MIGHAoGBAJ419DBEOgmQTzo5qXl5fQcN9TN455wkOL7052HzxxRVMyhYmwQcgJvh\5Cr\5Cn\22\0A    \221sa18fyfR9OiVEMYglOpkqVoGLN7qd5aQNNi5W7/C+VBdHTBJcGZJyyP5B3qcz32\5Cr\5Cn\22\0A    \229mLJKudlVudV0Qxk5qUJaPZ/xupz0NyoVpviuiBOI1gNi8ovSXWzAgEC\5Cr\5Cn\22\0A    \22-----END DH PARAMETERS-----\5Cr\5Cn\22;\0A#else /* MBEDTLS_PEM_PARSE_C */\0Astatic const char mbedtls_test_dhm_params[] = {\0A    0x30, 0x81, 0x87, 0x02, 0x81, 0x81, 0x00, 0x9e, 0x35, 0xf4, 0x30, 0x44,\0A    0x3a, 0x09, 0x90, 0x4f, 0x3a, 0x39, 0xa9, 0x79, 0x79, 0x7d, 0x07, 0x0d,\0A    0xf5, 0x33, 0x78, 0xe7, 0x9c, 0x24, 0x38, 0xbe, 0xf4, 0xe7, 0x61, 0xf3,\0A    0xc7, 0x14, 0x55, 0x33, 0x28, 0x58, 0x9b, 0x04, 0x1c, 0x80, 0x9b, 0xe1,\0A    0xd6, 0xc6, 0xb5, 0xf1, 0xfc, 0x9f, 0x47, 0xd3, 0xa2, 0x54, 0x43, 0x18,\0A    0x82, 0x53, 0xa9, 0x92, 0xa5, 0x68, 0x18, 0xb3, 0x7b