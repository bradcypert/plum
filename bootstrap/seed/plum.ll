[15]);\0A}\0A#endif /* !MBEDTLS_AES_ONLY_128_BIT_KEY_LENGTH */\0A\0A#if defined(MBEDTLS_POP_TARGET_PRAGMA)\0A#if defined(__clang__)\0A#pragma clang attribute pop\0A#elif defined(__GNUC__)\0A#pragma GCC pop_options\0A#endif\0A#undef MBEDTLS_POP_TARGET_PRAGMA\0A#endif\0A\0A#else /* MBEDTLS_AESNI_HAVE_CODE == 1 */\0A\0A#if defined(__has_feature)\0A#if __has_feature(memory_sanitizer)\0A#warning \5C\0A    \22MBEDTLS_AESNI_C is known to cause spurious error reports with some memory sanitizers as they do not understand the assembly code.\22\0A#endif\0A#endif\0A\0A/*\0A * Binutils needs to be at least 2.19 to support AES-NI instructions.\0A * Unfortunately, a lot of users have a lower version now (2014-04).\0A * Emit bytecode directly in order to support \22old\22 version of gas.\0A *\0A * Opcodes from the Intel architecture reference manual, vol. 3.\0A * We always use registers, so we don't need prefixes for memory operands.\0A * Operand macros are in gas order (src, dst) as opposed to Intel order\0A * (dst, src) in order to blend better into the surrounding assembly code.\0A */\0A#define AESDEC(regs)      \22.byte 0x66,0x0F,0x38,0xDE,\22 regs \22\5Cn\5Ct\22\0A#define AESDECLAST(regs)  \22.byte 0x66,0x0F,0x38,0xDF,\22 regs \22\5Cn\5Ct\22\0A#define AESENC(regs)      \22.byte 0x66,0x0F,0x38,0xDC,\22 regs \22\5Cn\5Ct\22\0A#define AESENCLAST(regs)  \22.byte 0x66,0x0F,0x38,0xDD,\22 regs \22\5Cn\5Ct\22\0A#define AESIMC(regs)      \22.byte 0x66,0x0F,0x38,0xDB,\22 regs \22\5Cn\5Ct\22\0A#define AESKEYGENA(regs, imm)  \22.byte 0x66,0x0F,0x3A,0xDF,\22 regs \22,\22 imm \22\5Cn\5Ct\22\0A#define PCLMULQDQ(regs, imm)   \22.byte 0x66,0x0F,0x3A,0x44,\22 regs \22,\22 imm \22\5Cn\5Ct\22\0A\0A#define xmm0_xmm0   \220xC0\22\0A#define xmm0_xmm1   \220xC8\22\0A#define xmm0_xmm2   \220xD0\22\0A#define xmm0_xmm3   \220xD8\22\0A#define xmm0_xmm4   \220xE0\22\0A#define xmm1_xmm0   \220xC1\22\0A#define xmm1_xmm2   \220xD1\22\0A\0A/*\0A * AES-NI AES-ECB block en(de)cryption\0A */\0Aint mbedtls_aesni_crypt_ecb(mbedtls_aes_context *ctx,\0A                            int mode,\0A                            const unsigned char input[16],\0A                            unsigned char output[16])\0A{\0A    asm (\22movdqu    (%3), %%xmm0    \5Cn\5Ct\22 // load input\0A         \22movdqu    (%1), %%xmm1    \5Cn\5Ct\22 // load round key 0\0A         \22pxor      %%xmm1, %%xmm0  \5Cn\5Ct\22 // round 0\0A         \22add       $16, %1         \5Cn\5Ct\22 // point to next round key\0A         \22subl      $1, %0          \5Cn\5Ct\22 // normal rounds = nr - 1\0A         \22test      %2, %2          \5Cn\5Ct\22 // mode?\0A         \22jz        2f              \5Cn\5Ct\22 // 0 = decrypt\0A\0A         \221:                        \5Cn\5Ct\22 // encryption loop\0A         \22movdqu    (%1), %%xmm1    \5Cn\5Ct\22 // load round key\0A         AESENC(xmm1_xmm0)                // do round\0A         \22add       $16, %1         \5Cn\5Ct\22 // point to next round key\0A         \22subl      $1, %0          \5Cn\5Ct\22 // loop\0A         \22jnz       1b              \5Cn\5Ct\22\0A         \22movdqu    (%1), %%xmm1    \5Cn\5Ct\22 // load round key\0A         AESENCLAST(xmm1_xmm0)            // last round\0A#if !defined(MBEDTLS_BLOCK_CIPHER_NO_DECRYPT)\0A         \22jmp       3f              \5Cn\5Ct\22\0A\0A         \222:                        \5Cn\5Ct\22 // decryption loop\0A         \22movdqu    (%1), %%xmm1    \5Cn\5Ct\22\0A         AESDEC(xmm1_xmm0)                // do round\0A         \22add       $16, %1         \5Cn\5Ct\22\0A         \22subl      $1, %0          \5Cn\5Ct\22\0A         \22jnz       2b              \5Cn\5Ct\22\0A         \22movdqu    (%1), %%xmm1    \5Cn\5Ct\22 // load round key\0A         AESDECLAST(xmm1_xmm0)            // last round\0A#endif\0A\0A         \223:                        \5Cn\5Ct\22\0A         \22movdqu    %%xmm0, (%4)    \5Cn\5Ct\22 // export output\0A         :\0A         : \22r\22 (ctx->nr), \22r\22 (ctx->buf + ctx->rk_offset), \22r\22 (mode), \22r\22 (input), \22r\22 (output)\0A         : \22memory\22, \22cc\22, \22xmm0\22, \22xmm1\22, \220\22, \221\22);\0A\0A\0A    return 0;\0A}\0A\0A/*\0A * GCM multiplication: c = a times b in GF(2^128)\0A * Based on [CLMUL-WP] algorithms 1 (with equation 27) and 5.\0A */\0Avoid mbedtls_aesni_gcm_mult(unsigned char c[16],\0A                            const unsigned char a[16],\0A                            const unsigned char b[16])\0A{\0A    unsigned char aa[16], bb[16], cc[16];\0A    size_t i;\0A\0A    /* The inputs are in big-endian order, so byte-reverse them */\0A    for (i = 0; i < 16; i++) {\0A        aa[i] = a[15 - i];\0A        bb[i] = b[15 - i];\0A    }\0A\0A    asm (\22movdqu (%0), %%xmm0               \5Cn\5Ct\22 // a1:a0\0A         \22movdqu (%1), %%xmm1               \5Cn\5Ct\22 // b1:b0\0A\0A         /*\0A          * Caryless multiplication xmm2:xmm1 = xmm0 * xmm1\0A          * using [CLMUL-WP] algorithm 1 (p. 12).\0A          */\0A         \22movdqa %%xmm1, %%xmm2             \5Cn\5Ct\22 // copy of b1:b0\0A         \22movdqa %%xmm1, %%xmm3             \5Cn\5Ct\22 // same\0A         \22movdqa %%xmm1, %%xmm4             \5Cn\5Ct\22 // same\0A         PCLMULQDQ(xmm0_xmm1, \220x00\22)             // a0*b0 = c1:c0\0A         PCLMULQDQ(xmm0_xmm2, \220x11\22)             // a1*b1 = d1:d0\0A         PCLMULQDQ(xmm0_xmm3, \220x10\22)             // a0*b1 = e1:e0\0A         PCLMULQDQ(xmm0_xmm4, \220x01\22)             // a1*b0 = f1:f0\0A         \22pxor %%xmm3, %%xmm4               \5Cn\5Ct\22 // e1+f1:e0+f0\0A         \22movdqa %%xmm4, %%xmm3             \5Cn\5Ct\22 // same\0A         \22psrldq $8, %%xmm4                 \5Cn\5Ct\22 // 0:e1+f1\0A         \22pslldq $8, %%xmm3                 \5Cn\5Ct\22 // e0+f0:0\0A         \22pxor %%xmm4, %%xmm2               \5Cn\5Ct\22 // d1:d0+e1+f1\0A         \22pxor %%xmm3, %%xmm1               \5Cn\5Ct\22 // c1+e0+f1:c0\0A\0A         /*\0A          * Now shift the result one bit to the left,\0A          * taking advantage of [CLMUL-WP] eq 27 (p. 18)\0A          */\0A         \22movdqa %%xmm1, %%xmm3             \5Cn\5Ct\22 // r1:r0\0A         \22movdqa %%xmm2, %%xmm4             \5Cn\5Ct\22 // r3:r2\0A         \22psllq $1, %%xmm1                  \5Cn\5Ct\22 // r1<<1:r0<<1\0A         \22psllq $1, %%xmm2                  \5Cn\5Ct\22 // r3<<1:r2<<1\0A         \22psrlq $63, %%xmm3                 \5Cn\5Ct\22 // r1>>63:r0>>63\0A         \22psrlq $63, %%xmm4                 \5Cn\5Ct\22 // r3>>63:r2>>63\0A         \22movdqa %%xmm3, %%xmm5             \5Cn\5Ct\22 // r1>>63:r0>>63\0A         \22pslldq $8, %%xmm3                 \5Cn\5Ct\22 // r0>>63:0\0A         \22pslldq $8, %%xmm4                 \5Cn\5Ct\22 // r2>>63:0\0A         \22psrldq $8, %%xmm5                 \5Cn\5Ct\22 // 0:r1>>63\0A         \22por %%xmm3, %%xmm1                \5Cn\5Ct\22 // r1<<1|r0>>63:r0<<1\0A         \22por %%xmm4, %%xmm2                \5Cn\5Ct\22 // r3<<1|r2>>62:r2<<1\0A         \22por %%xmm5, %%xmm2                \5Cn\5Ct\22 // r3<<1|r2>>62:r2<<1|r1>>63\0A\0A         /*\0A          * Now reduce modulo the GCM polynomial x^128 + x^7 + x^2 + x + 1\0A          * using [CLMUL-WP] algorithm 5 (p. 18).\0A          * Currently xmm2:xmm1 holds x3:x2:x1:x0 (already shifted).\0A          */\0A         /* Step 2 (1) */\0A         \22movdqa %%xmm1, %%xmm3             \5Cn\5Ct\22 // x1:x0\0A         \22movdqa %%xmm1, %%xmm4             \5Cn\5Ct\22 // same\0A         \22movdqa %%xmm1, %%xmm5             \5Cn\5Ct\22 // same\0A         \22psllq $63, %%xmm3                 \5Cn\5Ct\22 // x1<<63:x0<<63 = stuff:a\0A         \22psllq $62, %%xmm4                 \5Cn\5Ct\22 // x1<<62:x0<<62 = stuff:b\0A         \22psllq $57, %%xmm5                 \5Cn\5Ct\22 // x1<<57:x0<<57 = stuff:c\0A\0A         /* Step 2 (2) */\0A         \22pxor %%xmm4, %%xmm3               \5Cn\5Ct\22 // stuff:a+b\0A         \22pxor %%xmm5, %%xmm3               \5Cn\5Ct\22 // stuff:a+b+c\0A         \22pslldq $8, %%xmm3                 \5Cn\5Ct\22 // a+b+c:0\0A         \22pxor %%xmm3, %%xmm1               \5Cn\5Ct\22 // x1+a+b+c:x0 = d:x0\0A\0A         /* Steps 3 and 4 */\0A         \22movdqa %%xmm1,%%xmm0              \5Cn\5Ct\22 // d:x0\0A         \22movdqa %%xmm1,%%xmm4              \5Cn\5Ct\22 // same\0A         \22movdqa %%xmm1,%%xmm5              \5Cn\5Ct\22 // same\0A         \22psrlq $1, %%xmm0                  \5Cn\5Ct\22 // e1:x0>>1 = e1:e0'\0A         \22psrlq $2, %%xmm4                  \5Cn\5Ct\22 // f1:x0>>2 = f1:f0'\0A         \22psrlq $7, %%xmm5                  \5Cn\5Ct\22 // g1:x0>>7 = g1:g0'\0A         \22pxor %%xmm4, %%xmm0               \5Cn\5Ct\22 // e1+f1:e0'+f0'\0A         \22pxor %%xmm5, %%xmm0               \5Cn\5Ct\22 // e1+f1+g1:e0'+f0'+g0'\0A         // e0'+f0'+g0' is almost e0+f0+g0, ex\5Ctcept for some missing\0A         // bits carried from d. Now get those\5Ct bits back in.\0A         \22movdqa %%xmm1,%%xmm3              \5Cn\5Ct\22 // d:x0\0A         \22movdqa %%xmm1,%%xmm4              \5Cn\5Ct\22 // same\0A         \22movdqa %%xmm1,%%xmm5              \5Cn\5Ct\22 // same\0A         \22psllq $63, %%xmm3                 \5Cn\5Ct\22 // d<<63:stuff\0A         \22psllq $62, %%xmm4                 \5Cn\5Ct\22 // d<<62:stuff\0A         \22psllq $57, %%xmm5                 \5Cn\5Ct\22 // d<<57:stuff\0A         \22pxor %%xmm4, %%xmm3               \5Cn\5Ct\22 // d<<63+d<<62:stuff\0A         \22pxor %%xmm5, %%xmm3               \5Cn\5Ct\22 // missing bits of d:stuff\0A         \22psrldq $8, %%xmm3                 \5Cn\5Ct\22 // 0:missing bits of d\0A         \22pxor %%xmm3, %%xmm0               \5Cn\5Ct\22 // e1+f1+g1:e0+f0+g0\0A         \22pxor %%xmm1, %%xmm0               \5Cn\5Ct\22 // h1:h0\0A         \22pxor %%xmm2, %%xmm0               \5Cn\5Ct\22 // x3+h1:x2+h0\0A\0A         \22movdqu %%xmm0, (%2)               \5Cn\5Ct\22 // done\0A         :\0A         : \22r\22 (aa), \22r\22 (bb), \22r\22 (cc)\0A         : \22memory\22, \22cc\22, \22xmm0\22, \22xmm1\22, \22xmm2\22, \22xmm3\22, \22xmm4\22, \22xmm5\22);\0A\0A    /* Now byte-reverse the outputs */\0A    for (i = 0; i < 16; i++) {\0A        c[i] = cc[15 - i];\0A    }\0A\0A    return;\0A}\0A\0A/*\0A * Compute decryption round keys from encryption round keys\0A */\0A#if !defined(MBEDTLS_BLOCK_CIPHER_NO_DECRYPT)\0Avoid mbedtls_aesni_inverse_key(unsigned char *invkey,\0A                               const unsigned char *fwdkey, int nr)\0A{\0A    unsigned char *ik = invkey;\0A    const unsigned char *fk = fwdkey + 16 * nr;\0A\0A    memcpy(ik, fk, 16);\0A\0A    for (fk -= 16, ik += 16; fk > fwdkey; fk -= 16, ik += 16) {\0A        asm (\22movdqu (%0), %%xmm0       \5Cn\5Ct\22\0A             AESIMC(xmm0_xmm0)\0A             \22movdqu %%xmm0, (%1)       \5Cn\5Ct\22\0A             :\0A             : \22r\22 (fk), \22r\22 (ik)\0A             : \22memory\22, \22xmm0\22);\0A    }\0A\0A    memcpy(ik, fk, 16);\0A}\0A#endif\0A\0A/*\0A * Key expansion, 128-bit case\0A */\0Astatic void aesni_setkey_enc_128(unsigned char *rk,\0A                                 const unsigned char *key)\0A{\0A    asm (\22movdqu (%1), %%xmm0               \5Cn\5Ct\22 // copy the original key\0A         \22movdqu %%xmm0, (%0)               \5Cn\5Ct\22 // as round key 0\0A         \22jmp 2f                            \5Cn\5Ct\22 // skip auxiliary routine\0A\0A         /*\0A          * Finish generating the next round key.\0A          *\0A          * On entry xmm0 is r3:r2:r1:r0 and xmm1 is X:stuff:stuff:stuff\0A          * with X = rot( sub( r3 ) ) ^ RCON.\0A          *\0A          * On exit, xmm0 is r7:r6:r5:r4\0A          * with r4 = X + r0, r5 = r4 + r1, r6 = r5 + r2, r7 = r6 + r3\0A          * and those are written to the round key buffer.\0A          */\0A         \221:                                \5Cn\5Ct\22\0A         \22pshufd $0xff, %%xmm1, %%xmm1      \5Cn\5Ct\22 // X:X:X:X\0A         \22pxor %%xmm0, %%xmm1               \5Cn\5Ct\22 // X+r3:X+r2:X+r1:r4\0A         \22pslldq $4, %%xmm0                 \5Cn\5Ct\22 // r2:r1:r0:0\0A         \22pxor %%xmm0, %%xmm1               \5Cn\5Ct\22 // X+r3+r2:X+r2+r1:r5:r4\0A         \22pslldq $4, %%xmm0                 \5Cn\5Ct\22 // etc\0A         \22pxor %%xmm0, %%xmm1               \5Cn\5Ct\22\0A         \22pslldq $4, %%xmm0                 \5Cn\5Ct\22\0A         \22pxor %%xmm1, %%xmm0               \5Cn\5Ct\22 // update xmm0 for next time!\0A         \22add $16, %0                       \5Cn\5Ct\22 // point to next round key\0A         \22movdqu %%xmm0, (%0)               \5Cn\5Ct\22 // write it\0A         \22ret                               \5Cn\5Ct\22\0A\0A         /* Main \22loop\22 */\0A         \222:                                \5Cn\5Ct\22\0A         AESKEYGENA(xmm0_xmm1, \220x01\22)      \22call 1b \5Cn\5Ct\22\0A         AESKEYGENA(xmm0_xmm1, \220x02\22)      \22call 1b \5Cn\5Ct\22\0A         AESKEYGENA(xmm0_xmm1, \220x04\22)      \22call 1b \5Cn\5Ct\22\0A         AESKEYGENA(xmm0_xmm1, \220x08\22)      \22call 1b \5Cn\5Ct\22\0A         AESKEYGENA(xmm0_xmm1, \220x10\22)      \22call 1b \5Cn\5Ct\22\0A         AESKEYGENA(xmm0_xmm1, \220x20\22)      \22call 1b \5Cn\5Ct\22\0A         AESKEYGENA(xmm0_xmm1, \220x40\22)      \22call 1b \5Cn\5Ct\22\0A         AESKEYGENA(xmm0_xmm1, \220x80\22)      \22call 1b \5Cn\5Ct\22\0A         AESKEYGENA(xmm0_xmm1, \220x1B\22)      \22call 1b \5Cn\5Ct\22\0A         AESKEYGENA(xmm0_xmm1, \220x36\22)      \22call 1b \5Cn\5Ct\22\0A         :\0A         : \22r\22 (rk), \22r\22 (key)\0A         : \22memory\22, \22cc\22, \22xmm0\22, \22xmm1\22, \220\22);\0A}\0A\0A/*\0A * Key expansion, 192-bit case\0A */\0A#if !defined(MBEDTLS_AES_ONLY_128_BIT_KEY_LENGTH)\0Astatic void aesni_setkey_enc_192(unsigned char *rk,\0A                                 const unsigned char *key)\0A{\0A    asm (\22movdqu (%1), %%xmm0   \5Cn\5Ct\22 // copy original round key\0A         \22movdqu %%xmm0, (%0)   \5Cn\5Ct\22\0A         \22add $16, %0           \5Cn\5Ct\22\0A         \22movq 16(%1), %%xmm1   \5Cn\5Ct\22\0A         \22movq %%xmm1, (%0)     \5Cn\5Ct\22\0A         \22add $8, %0            \5Cn\5Ct\22\0A         \22jmp 2f                \5Cn\5Ct\22 // skip auxiliary routine\0A\0A         /*\0A          * Finish generating the next 6 quarter-keys.\0A          *\0A          * On entry xmm0 is r3:r2:r1:r0, xmm1 is stuff:stuff:r5:r4\0A          * and xmm2 is stuff:stuff:X:stuff with X = rot( sub( r3 ) ) ^ RCON.\0A          *\0A          * On exit, xmm0 is r9:r8:r7:r6 and xmm1 is stuff:stuff:r11:r10\0A          * and those are written to the round key buffer.\0A          */\0A         \221:                            \5Cn\5Ct\22\0A         \22pshufd $0x55, %%xmm2, %%xmm2  \5Cn\5Ct\22 // X:X:X:X\0A         \22pxor %%xmm0, %%xmm2           \5Cn\5Ct\22 // X+r3:X+r2:X+r1:r4\0A         \22pslldq $4, %%xmm0             \5Cn\5Ct\22 // etc\0A         \22pxor %%xmm0, %%xmm2           \5Cn\5Ct\22\0A         \22pslldq $4, %%xmm0             \5Cn\5Ct\22\0A         \22pxor %%xmm0, %%xmm2           \5Cn\5Ct\22\0A         \22pslldq $4, %%xmm0             \5Cn\5Ct\22\0A         \22pxor %%xmm2, %%xmm0           \5Cn\5Ct\22 // update xmm0 = r9:r8:r7:r6\0A         \22movdqu %%xmm0, (%0)           \5Cn\5Ct\22\0A         \22add $16, %0                   \5Cn\5Ct\22\0A         \22pshufd $0xff, %%xmm0, %%xmm2  \5Cn\5Ct\22 // r9:r9:r9:r9\0A         \22pxor %%xmm1, %%xmm2           \5Cn\5Ct\22 // stuff:stuff:r9+r5:r10\0A         \22pslldq $4, %%xmm1             \5Cn\5Ct\22 // r2:r1:r0:0\0A         \22pxor %%xmm2, %%xmm1           \5Cn\5Ct\22 // xmm1 = stuff:stuff:r11:r10\0A         \22movq %%xmm1, (%0)             \5Cn\5Ct\22\0A         \22add $8, %0                    \5Cn\5Ct\22\0A         \22ret                           \5Cn\5Ct\22\0A\0A         \222:                            \5Cn\5Ct\22\0A         AESKEYGENA(xmm1_xmm2, \220x01\22)  \22call 1b \5Cn\5Ct\22\0A         AESKEYGENA(xmm1_xmm2, \220x02\22)  \22call 1b \5Cn\5Ct\22\0A         AESKEYGENA(xmm1_xmm2, \220x04\22)  \22call 1b \5Cn\5Ct\22\0A         AESKEYGENA(xmm1_xmm2, \220x08\22)  \22call 1b \5Cn\5Ct\22\0A         AESKEYGENA(xmm1_xmm2, \220x10\22)  \22call 1b \5Cn\5Ct\22\0A         AESKEYGENA(xmm1_xmm2, \220x20\22)  \22call 1b \5Cn\5Ct\22\0A         AESKEYGENA(xmm1_xmm2, \220x40\22)  \22call 1b \5Cn\5Ct\22\0A         AESKEYGENA(xmm1_xmm2, \220x80\22)  \22call 1b \5Cn\5Ct\22\0A\0A         :\0A         : \22r\22 (rk), \22r\22 (key)\0A         : \22memory\22, \22cc\22, \22xmm0\22, \22xmm1\22, \22xmm2\22, \220\22);\0A}\0A#endif /* !MBEDTLS_AES_ONLY_128_BIT_KEY_LENGTH */\0A\0A/*\0A * Key expansion, 256-bit case\0A */\0A#if !defined(MBEDTLS_AES_ONLY_128_BIT_KEY_LENGTH)\0Astatic void aesni_setkey_enc_256(unsigned char *rk,\0A                                 const unsigned char *key)\0A{\0A    asm (\22movdqu (%1), %%xmm0           \5Cn\5Ct\22\0A         \22movdqu %%xmm0, (%0)           \5Cn\5Ct\22\0A         \22add $16, %0                   \5Cn\5Ct\22\0A         \22movdqu 16(%1), %%xmm1         \5Cn\5Ct\22\0A         \22movdqu %%xmm1, (%0)           \5Cn\5Ct\22\0A         \22jmp 2f                        \5Cn\5Ct\22 // skip auxiliary routine\0A\0A         /*\0A          * Finish generating the next two round keys.\0A          *\0A          * On entry xmm0 is r3:r2:r1:r0, xmm1 is r7:r6:r5:r4 and\0A          * xmm2 is X:stuff:stuff:stuff with X = rot( sub( r7 )) ^ RCON\0A          *\0A          * On exit, xmm0 is r11:r10:r9:r8 and xmm1 is r15:r14:r13:r12\0A          * and those have been written to the output buffer.\0A          */\0A         \221:                                \5Cn\5Ct\22\0A         \22pshufd $0xff, %%xmm2, %%xmm2      \5Cn\5Ct\22\0A         \22pxor %%xmm0, %%xmm2               \5Cn\5Ct\22\0A         \22pslldq $4, %%xmm0                 \5Cn\5Ct\22\0A         \22pxor %%xmm0, %%xmm2               \5Cn\5Ct\22\0A         \22pslldq $4, %%xmm0                 \5Cn\5Ct\22\0A         \22pxor %%xmm0, %%xmm2               \5Cn\5Ct\22\0A         \22pslldq $4, %%xmm0                 \5Cn\5Ct\22\0A         \22pxor %%xmm2, %%xmm0               \5Cn\5Ct\22\0A         \22add $16, %0                       \5Cn\5Ct\22\0A         \22movdqu %%xmm0, (%0)               \5Cn\5Ct\22\0A\0A         /* Set xmm2 to stuff:Y:stuff:stuff with Y = subword( r11 )\0A          * and proceed to generate next round key from there */\0A         AESKEYGENA(xmm0_xmm2, \220x00\22)\0A         \22pshufd $0xaa, %%xmm2, %%xmm2      \5Cn\5Ct\22\0A         \22pxor %%xmm1, %%xmm2               \5Cn\5Ct\22\0A         \22pslldq $4, %%xmm1                 \5Cn\5Ct\22\0A         \22pxor %%xmm1, %%xmm2               \5Cn\5Ct\22\0A         \22pslldq $4, %%xmm1                 \5Cn\5Ct\22\0A         \22pxor %%xmm1, %%xmm2               \5Cn\5Ct\22\0A         \22pslldq $4, %%xmm1                 \5Cn\5Ct\22\0A         \22pxor %%xmm2, %%xmm1               \5Cn\5Ct\22\0A         \22add $16, %0                       \5Cn\5Ct\22\0A         \22movdqu %%xmm1, (%0)               \5Cn\5Ct\22\0A         \22ret                               \5Cn\5Ct\22\0A\0A         /*\0A          * Main \22loop\22 - Generating one more key than necessary,\0A          * see definition of mbedtls_aes_context.buf\0A          */\0A         \222:                                \5Cn\5Ct\22\0A         AESKEYGENA(xmm1_xmm2, \220x01\22)      \22call 1b \5Cn\5Ct\22\0A         AESKEYGENA(xmm1_xmm2, \220x02\22)      \22call 1b \5Cn\5Ct\22\0A         AESKEYGENA(xmm1_xmm2, \220x04\22)      \22call 1b \5Cn\5Ct\22\0A         AESKEYGENA(xmm1_xmm2, \220x08\22)      \22call 1b \5Cn\5Ct\22\0A         AESKEYGENA(xmm1_xmm2, \220x10\22)      \22call 1b \5Cn\5Ct\22\0A         AESKEYGENA(xmm1_xmm2, \220x20\22)      \22call 1b \5Cn\5Ct\22\0A         AESKEYGENA(xmm1_xmm2, \220x40\22)      \22call 1b \5Cn\5Ct\22\0A         :\0A         : \22r\22 (rk), \22r\22 (key)\0A         : \22memory\22, \22cc\22, \22xmm0\22, \22xmm1\22, \22xmm2\22, \220\22);\0A}\0A#endif /* !MBEDTLS_AES_ONLY_128_BIT_KEY_LENGTH */\0A\0A#endif  /* MBEDTLS_AESNI_HAVE_CODE */\0A\0A/*\0A * Key expansion, wra