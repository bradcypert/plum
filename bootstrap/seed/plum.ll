a child killed by a\0A// signal, which is a SUCCESSFUL run with an unusual outcome, not a\0A// failure to start anything.\0A#define PLUM_SPAWN_FAILED (-1000000000LL)\0A\0A// `stdin_mode`: -1 inherit the parent's stdin, 0 empty (`/dev/null` /\0A// `NUL`), 1 feed `stdin_data` of length `stdin_len`.\0A// `fail_on_exec`: when set, an `execvp` failure is `PLUM_SPAWN_FAILED`\0A// rather than a child that exited 127 -- so `Process.run` can tell\0A// \22never started\22 from \22started and the program itself returned 127\22.\0A\0Astatic char **plum_split_args(const char *program, const char *args_joined, long long argc, char **copy_out) {\0A    char *args_copy = strdup(args_joined != NULL ? args_joined : \22\22);\0A    char **argv = (char **)malloc(sizeof(char *) * (size_t)(argc + 2));\0A    if (args_copy == NULL || argv == NULL) {\0A        free(args_copy);\0A        free(argv);\0A        *copy_out = NULL;\0A        return NULL;\0A    }\0A    argv[0] = (char *)program;\0A    long long idx = 1;\0A    if (argc > 0) {\0A        argv[idx++] = args_copy;\0A        for (char *c = args_copy; *c != '\5C0'; c++) {\0A            if (*c == PLUM_PROC_ARG_SEP) {\0A                *c = '\5C0';\0A                if (idx <= argc) {\0A                    argv[idx++] = c + 1;\0A                }\0A            }\0A        }\0A    }\0A    argv[idx] = NULL;\0A    *copy_out = args_copy;\0A    return argv;\0A}\0A\0Astatic char **plum_split_joined(const char *joined, long long n, char **copy_out) {\0A    if (n <= 0) {\0A        *copy_out = NULL;\0A        return NULL;\0A    }\0A    char *copy = strdup(joined != NULL ? joined : \22\22);\0A    char **items = (char **)malloc(sizeof(char *) * (size_t)(n + 1));\0A    if (copy == NULL || items == NULL) {\0A        free(copy);\0A        free(items);\0A        *copy_out = NULL;\0A        return NULL;\0A    }\0A    long long idx = 0;\0A    items[idx++] = copy;\0A    for (char *c = copy; *c != '\5C0'; c++) {\0A        if (*c == PLUM_PROC_ARG_SEP) {\0A     