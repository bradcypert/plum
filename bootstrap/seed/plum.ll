(i: Int): Option[Int] =\0A    if i + needle.len() > cs.len() { None }\0A    else if plum__string_matches_at(cs, needle, i, 0) { Some(i) }\0A    else { plum__string_index_of_acc(cs, needle, i + 1) }\0A/// The CHARACTER index where `needle` first appears, or `None`.\0Apub let String.index_of (s: String) (needle: String): Option[Int] = plum__string_index_of_acc(chars_of(s), chars_of(needle), 0)\0A\0A/// --- Namespaced forms of the string METHODS ---\0A///\0A/// `.len()`, `.split()`, `.replace()` and friends are compiler\0A/// PRIMITIVES lowered straight to IR, so they existed only as\0A/// methods, while `String.slice`/`index_of`/`lines`/`repeat`/\0A/// `trim_start`/`trim_end` are ordinary prelude functions and so\0A/// existed only namespaced. That split tracks how each one happens\0A/// to be implemented, which is invisible from outside and produced\0A/// a genuinely confusing surface: `\22x\22.trim()` worked and\0A/// `String.trim(\22x\22)` did not, while `String.trim_start(\22x\22)`\0A/// worked and `\22x\22.trim_start()` did not. Same family, opposite\0A/// rules, no way to tell which without trying.\0A///\0A/// The rule now: `String.f(s, ..)` always works. Some also have\0A/// method sugar. These wrappers cost nothing when unused --\0A/// dead-function elimination drops them.\0A/// The number of BYTES. `String.char_len` is the character count, and\0A/// the two differ for anything outside ASCII.\0Apub let String.len (s: String): Int = s.len()\0A/// Splits on every occurrence of `sep`.\0A///\0A/// A separator at either end produces an empty piece, so splitting\0A/// `\5C\22,a,\5C\22` on `\5C\22,\5C\22` gives three pieces. Splitting on an empty\0A/// separator gives the characters.\0Apub let String.split (s: String) (sep: String): Array[String] = s.split(sep)\0A/// Whether `needle` appears anywhere.\0Apub let String.contains (s: String) (needle: String): Bool = s.contains(needle)\0A/// Whether the string begins with `prefix`.\0Apub let String.starts_with (s: String) (prefix: String): Bool = s.starts_with(prefix)\0A/// Whether the string ends with `suffix`.\0Apub let String.ends_with (s: String) (suffix: String): Bool = s.ends_with(suffix)\0A/// Every occurrence of `from` replaced with `to`. An empty `from`\0A/// leaves the string alone rather than looping.\0Apub let String.replace (s: String) (from: String) (to: String): String = s.replace(from, to)\0A/// Uppercased. ASCII only: letters outside it are left as they are,\0A/// so this is not a general Unicode case mapping.\0Apub let String.to_upper (s: String): String = s.to_upper()\0A/// Lowercased. ASCII only — see `String.to_upper`.\0Apub let String.to_lower (s: String): String = s.to_lower()\0A/// Whitespace removed from both ends, including Unicode spaces.\0Apub let String.trim (s: String): String = s.trim()\0A\0Alet bytes_of_str_raw (s: String): Bytes = bytes_of_str_raw(s)\0Alet str_of_bytes_raw (b: Bytes): String = \22\22\0Alet bytes_len_raw (b: Bytes): Int = 0\0Alet bytes_at_raw (b: Bytes) (i: Int): Int = 0\0Alet bytes_slice_raw (b: Bytes) (start: Int) (end: Int): Bytes = bytes_slice_raw(b, start, end)\0Alet bytes_concat_raw (a: Bytes) (b: Bytes): Bytes = bytes_concat_raw(a, b)\0Alet bytes_from_array_raw (xs: Array[Int]): Bytes = bytes_from_array_raw(xs)\0A\0A/// No bytes.\0Apub let Bytes.empty (): Bytes = bytes_of_str_raw(\22\22)\0A\0A/// How many bytes.\0Apub let Bytes.len (b: Bytes): Int = bytes_len_raw(b)\0A/// Whether there are no bytes.\0Apub let Bytes.is_empty (b: Bytes): Bool = bytes_len_raw(b) == 0\0A\0A/// Free in both directions at runtime; the DIRECTION is what differs.\0A/// Every String is bytes, so this one is total.\0A/// The string's bytes, as UTF-8. No copy of the text is decoded, so\0A/// this is the cheap direction.\0Apub let String.as_bytes (s: String): Bytes = bytes_of_str_raw(s)\0A/// The string's UTF-8 bytes. The same as `String.as_bytes`, named for\0A/// a caller thinking in bytes.\0Apub let Bytes.from_string (s: String): Bytes = bytes_of_str_raw(s)\0A\0A/// Not every Bytes is a String, so this one is not. This is the ONE\0A/// place the UTF-8 promise is established rather than assumed. The\0A/// reason the two types are distinct at all.\0A/// Written in Plum, not as a runtime primitive, because it needs\0A/// nothing the two byte primitives above do not already provide --\0A/// and this prelude's rule is that only what CANNOT be written here\0A/// goes into hand-written IR.\0A///\0A/// Full UTF-8, not just a lead-byte check: the ranges below reject\0A/// overlong encodings (C0/C1, and E0/F0 with a too-small second\0A/// byte), the UTF-16 surrogate block (ED A0..BF, which is why ED is\0A/// singled out), and anything past U+10FFFF (F5..FF, and F4 with a\0A/// second byte over 8F). A validator that only checked continuation\0A/// bytes would accept all four, and each one is a real way for a\0A/// decoder downstream to disagree about what this buffer says.\0Alet plum__is_cont (b: Bytes) (i: Int): Bool = {\0A    let v = bytes_at_raw(b, i);\0A    v >= 128 && v <= 191\0A}\0A\0Alet plum__utf8_ok (b: Bytes) (i: Int) (n: Int): Bool =\0A    if i >= n { true }\0A    else {\0A        let c = bytes_at_raw(b, i);\0A        // ASCII.\0A        if c < 128 { plum__utf8_ok(b, i + 1, n) }\0A        // A continuation byte with no lead (80..BF), or an overlong\0A        // two-byte form (C0/C1).\0A        else if c < 194 { false }\0A        // Two bytes: C2..DF.\0A        else if c < 224 {\0A            if i + 1 >= n { false }\0A            else if !plum__is_cont(b, i + 1) { false }\0A            else { plum__utf8_ok(b, i + 2, n) }\0A        }\0A        // Three bytes: E0..EF. E0 must not be overlong (second byte\0A        // A0..BF) and ED must not encode a surrogate (second byte\0A        // 80..9F).\0A        else if c < 240 {\0A            if i + 2 >= n { false }\0A            else {\0A                let c1 = bytes_at_raw(b, i + 1);\0A                let lo = if c == 224 { 160 } else { 128 };\0A                let hi = i