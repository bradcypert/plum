n;\0A#elif defined(MBEDTLS_CT_X86_64_ASM) && (defined(MBEDTLS_CT_SIZE_32) || defined(MBEDTLS_CT_SIZE_64))\0A    asm volatile (\22and  %[condition], %[if1]                      \5Cn\5Ct\22\0A                  \22not  %[condition]                              \5Cn\5Ct\22\0A                  \22and  %[condition], %[if0]                      \5Cn\5Ct\22\0A                  \22or   %[if1], %[if0]                            \5Cn\5Ct\22\0A                  :\0A                  [condition] \22+&D\22 (condition),\0A                  [if1] \22+&S\22 (if1),\0A                  [if0] \22+&a\22 (if0)\0A                  :\0A                  :\0A                  );\0A    return if0;\0A#elif defined(MBEDTLS_CT_X86_ASM) && defined(MBEDTLS_CT_SIZE_32)\0A    asm volatile (\22and %[condition], %[if1]                       \5Cn\5Ct\22\0A                  \22not %[condition]                               \5Cn\5Ct\22\0A                  \22and %[if0], %[condition]                       \5Cn\5Ct\22\0A                  \22or %[condition], %[if1]                        \5Cn\5Ct\22\0A                  :\0A                  [condition] \22+&c\22 (condition),\0A                  [if1] \22+&a\22 (if1)\0A                  :\0A                  [if0] \22b\22 (if0)\0A                  :\0A                  );\0A    return if1;\0A#else\0A    mbedtls_ct_condition_t not_cond =\0A        (mbedtls_ct_condition_t) (~mbedtls_ct_compiler_opaque(condition));\0A    return (mbedtls_ct_uint_t) ((condition & if1) | (not_cond & if0));\0A#endif\0A}\0A\0Astatic inline mbedtls_ct_condition_t mbedtls_ct_uint_lt(mbedtls_ct_uint_t x, mbedtls_ct_uint_t y)\0A{\0A#if defined(MBEDTLS_CT_AARCH64_ASM) && (defined(MBEDTLS_CT_SIZE_32) || defined(MBEDTLS_CT_SIZE_64))\0A    uint64_t s1;\0A    asm volatile (\22eor     %x[s1], %x[y], %x[x]                   \5Cn\5Ct\22\0A                  \22sub     %x[x], %x[x], %x[y]                    \5Cn\5Ct\22\0A                  \22bic     %x[x], %x[x], %x[s1]                   \5Cn\5C