_ecp_load_public_part(ecp);\0A    if (status != PSA_SUCCESS) {\0A        goto cleanup;\0A    }\0A\0A    status = mbedtls_to_psa_error(mbedtls_ecdsa_verify(&ecp->grp, hash,\0A                                                       hash_length, &ecp->Q,\0A                                                       &r, &s));\0Acleanup:\0A    mbedtls_mpi_free(&r);\0A    mbedtls_mpi_free(&s);\0A    mbedtls_ecp_keypair_free(ecp);\0A    mbedtls_free(ecp);\0A\0A    return status;\0A}\0A\0A#endif /* defined(MBEDTLS_PSA_BUILTIN_ALG_ECDSA) || \5C\0A        * defined(MBEDTLS_PSA_BUILTIN_ALG_DETERMINISTIC_ECDSA) */\0A\0A/****************************************************************/\0A/* ECDH Key Agreement */\0A/****************************************************************/\0A\0A#if defined(MBEDTLS_PSA_BUILTIN_ALG_ECDH)\0Apsa_status_t mbedtls_psa_key_agreement_ecdh(\0A    const psa_key_attributes_t *attributes,\0A    const uint8_t *key_buffer, size_t key_buffer_size,\0A    psa_algorithm_t alg, const uint8_t *peer_key, size_t peer_key_length,\0A    uint8_t *shared_secret, size_t shared_secret_size,\0A    size_t *shared_secret_length)\0A{\0A    psa_status_t status;\0A    if (!PSA_KEY_TYPE_IS_ECC_KEY_PAIR(attributes->type) ||\0A        !PSA_ALG_IS_ECDH(alg)) {\0A        return PSA_ERROR_INVALID_ARGUMENT;\0A    }\0A    mbedtls_ecp_keypair *ecp = NULL;\0A    status = mbedtls_psa_ecp_load_representation(\0A        attributes->type,\0A        attributes->bits,\0A        key_buffer,\0A        key_buffer_size,\0A        &ecp);\0A    if (status != PSA_SUCCESS) {\0A        return status;\0A    }\0A    mbedtls_ecp_keypair *their_key = NULL;\0A    mbedtls_ecdh_context ecdh;\0A    size_t bits = 0;\0A    psa_ecc_family_t curve = mbedtls_ecc_group_to_psa(ecp->grp.id, &bits);\0A    mbedtls_ecdh_init(&ecdh);\0A\0A    status = mbedtls_psa_ecp_load_representation(\0A        PSA_KEY_TYPE_ECC_PUBLIC_KEY(curve),\0A        bits,\0A        peer_key,\0A        peer_key_length,\0A        &their_key);\0A    if (status != PSA_SUCCESS) {\0A        goto exit;\0A    }\0A\0A    status = mbedtls_to_psa_error(\0A        mbedtls_ecdh_get_params(&ecdh, their_key, MBEDTLS_ECDH_THEIRS));\0A    if (status != PSA_SUCCESS) {\0A        goto exit;\0A    }\0A    status = mbedtls_to_psa_error(\0A        mbedtls_ecdh_get_params(&ecdh, ecp, MBEDTLS_ECDH_OURS));\0A    if (status != PSA_SUCCESS) {\0A        goto exit;\0A    }\0A\0A    status = mbedtls_to_psa_error(\0A        mbedtls_ecdh_calc_secret(&ecdh,\0A                                 shared_secret_length,\0A                                 shared_secret, shared_secret_size,\0A                                 mbedtls_psa_get_random,\0A                                 MBEDTLS_PSA_RANDOM_STATE));\0A    if (status != PSA_SUCCESS) {\0A        goto exit;\0A    }\0A    if (PSA_BITS_TO_BYTES(bits) != *shared_secret_length) {\0A        status = PSA_ERROR_CORRUPTION_DETECTED;\0A    }\0Aexit:\0A    if (status != PSA_SUCCESS) {\0A        mbedtls_platform_zeroize(shared_secret, shared_secret_size);\0A    }\0A    mbedtls_ecdh_free(&ecdh);\0A    mbedtls_ecp_keypair_free(their_key);\0A    mbedtls_free(their_key);\0A    mbedtls_ecp_keypair_free(ecp);\0A    mbedtls_free(ecp);\0A    return status;\0A}\0A#endif /* MBEDTLS_PSA_BUILTIN_ALG_ECDH */\0A\0A\0A#endif /* MBEDTLS_PSA_CRYPTO_C */\0A\00" }
