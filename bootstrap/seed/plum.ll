@.str42517 = private global { i64, i64, [14450 x i8] } { i64 -1, i64 14449, [14450 x i8] c"/**\0A * \5Cfile poly1305.c\0A *\0A * \5Cbrief Poly1305 authentication algorithm.\0A *\0A *  Copyright The Mbed TLS Contributors\0A *  SPDX-License-Identifier: Apache-2.0 OR GPL-2.0-or-later\0A */\0A#include \22common.h\22\0A\0A#if defined(MBEDTLS_POLY1305_C)\0A\0A#include \22mbedtls/poly1305.h\22\0A#include \22mbedtls/platform_util.h\22\0A#include \22mbedtls/error.h\22\0A\0A#include <string.h>\0A\0A#include \22mbedtls/platform.h\22\0A\0A#if !defined(MBEDTLS_POLY1305_ALT)\0A\0A#define POLY1305_BLOCK_SIZE_BYTES (16U)\0A\0A/*\0A * Our implementation is tuned for 32-bit platforms with a 64-bit multiplier.\0A * However we provided an alternative for platforms without such a multiplier.\0A */\0A#if defined(MBEDTLS_NO_64BIT_MULTIPLICATION)\0Astatic uint64_t mul64(uint32_t a, uint32_t b)\0A{\0A    /* a = al + 2**16 ah, b = bl + 2**16 bh */\0A    const uint16_t al = (uint16_t) a;\0A    const uint16_t bl = (uint16_t) b;\0A    const uint16_t ah = a >> 16;\0A    const uint16_t bh = b >> 16;\0A\0A    /* ab = al*bl + 2**16 (ah*bl + bl*bh) + 2**32 ah*bh */\0A    const uint32_t lo = (uint32_t) al * bl;\0A    const uint64_t me = (uint64_t) ((uint32_t) ah * bl) + (uint32_t) al * bh;\0A    const uint32_t hi = (uint32_t) ah * bh;\0A\0A    return lo + (me << 16) + ((uint64_t) hi << 32);\0A}\0A#else\0Astatic inline uint64_t mul64(uint32_t a, uint32_t b)\0A{\0A    return (uint64_t) a * b;\0A}\0A#endif\0A\0A\0A/**\0A * \5Cbrief                   Process blocks with Poly1305.\0A *\0A * \5Cparam ctx               The Poly1305 context.\0A * \5Cparam nblocks           Number of blocks to process. Note that this\0A *                          function only processes full blocks.\0A * \5Cparam input             Buffer containing the input block(s).\0A * \5Cparam needs_padding     Set to 0 if the padding bit has already been\0A *                          applied to the input data before calling this\0A *                          function.  Otherwise, set this parameter to 1.\0A */\0Astatic void poly1305_process(mbedtls_poly1305_context *ctx,\0A                             size_t nblocks,\0A                             const unsigned char *input,\0A                             uint32_t needs_padding)\0A{\0A    uint64_t d0, d1, d2, d3;\0A    uint32_t acc0, acc1, acc2, acc3, acc4;\0A    uint32_t r0, r1, r2, r3;\0A    uint32_t rs1, rs2, rs3;\0A    size_t offset  = 0U;\0A    size_t i;\0A\0A    r0 = ctx->r[0];\0A    r1 = ctx->r[1];\0A    r2 = ctx->r[2];\0A    r3 = ctx->r[3];\0A\0A    rs1 = r1 + (r1 >> 2U);\0A    rs2 = r2 + (r2 >> 2U);\0A    rs3 = r3 + (r3 >> 2U);\0A\0A    acc0 = ctx->acc[0];\0A    acc1 = ctx->acc[1];\0A    acc2 = ctx->acc[2];\0A    acc3 = ctx->acc[3];\0A    acc4 = ctx->acc[4];\0A\0A    /* Process full blocks */\0A    for (i = 0U; i < nblocks; i++) {\0A        /* The input block is treated as a 128-bit little-endian integer */\0A        d0   = MBEDTLS_GET_UINT32_LE(input, offset + 0);\0A        d1   = MBEDTLS_GET_UINT32_LE(input, offset + 4);\0A        d2   = MBEDTLS_GET_UINT32_LE(input, offset + 8);\0A        d3   = MBEDTLS_GET_UINT32_LE(input, offset + 12);\0A\0A        /* Compute: acc += (padded) block as a 130-bit integer */\0A        d0  += (uint64_t) acc0;\0A        d1  += (uint64_t) acc1 + (d0 >> 32U);\0A        d2  += (uint64_t) acc2 + (d1 >> 32U);\0A        d3  += (uint64_t) acc3 + (d2 >> 32U);\0A        acc0 = (uint32_t) d0;\0A        acc1 = (uint32_t) d1;\0A        acc2 = (uint32_t) d2;\0A        acc3 = (uint32_t) d3;\0A        acc4 += (uint32_t) (d3 >> 32U) + needs_padding;\0A\0A        /* Compute: acc *= r */\0A        d0 = mul64(acc0, r0) +\0A             mul64(acc1, rs3) +\0A             mul64(acc2, rs2) +\0A             mul64(acc3, rs1);\0A        d1 = mul64(acc0, r1) +\0A             mul64(acc1, r0) +\0A             mul64(acc2, rs3) +\0A             mul64(acc3, rs2) +\0A             mul64(acc4, rs1);\0A        d2 = mul64(acc0, r2) +\0A             mul64(acc1, r1) +\0A             mul64(acc2, r0) +\0A             mul64(acc3, rs3) +\0A             mul64(acc4, rs2);\0A        d3 = mul64(acc0, r3) +\0A             mul64(acc1, r2) +\0A             mul64(acc2, r1) +\0A             mul64(acc3, r0) +\0A             mul64(acc4, rs3);\0A        acc4 *= r0;\0A\0A        /* Compute: acc %= (2^130 - 5) (partial remainder) */\0A        d1 += (d0 >> 32);\0A        d2 += (d1 >> 32);\0A        d3 += (d2 >> 32);\0A        acc0 = (uint32_t) d0;\0A        acc1 = (uint32_t) d1;\0A        acc2 = (uint32_t) d2;\0A        acc3 = (uint32_t) d3;\0A        acc4 = (uint32_t) (d3 >> 32) + acc4;\0A\0A        d0 = (uint64_t) acc0 + (acc4 >> 2) + (acc4 & 0xFFFFFFFCU);\0A        acc4 &= 3U;\0A        acc0 = (uint32_t) d0;\0A        d0 = (uint64_t) acc1 + (d0 >> 32U);\0A        acc1 = (uint32_t) d0;\0A        d0 = (uint64_t) acc2 + (d0 >> 32U);\0A        acc2 = (uint32_t) d0;\0A        d0 = (uint64_t) acc3 + (d0 >> 32U);\0A        acc3 = (uint32_t) d0;\0A        d0 = (uint64_t) acc4 + (d0 >> 32U);\0A        acc4 = (uint32_t) d0;\0A\0A        offset    += POLY1305_BLOCK_SIZE_BYTES;\0A    }\0A\0A    ctx->acc[0] = acc0;\0A    ctx->acc[1] = acc1;\0A    ctx->acc[2] = acc2;\0A    ctx->acc[3] = acc3;\0A    ctx->acc[4] = acc4;\0A}\0A\0A/**\0A * \5Cbrief                   Compute the Poly1305 MAC\0A *\0A * \5Cparam ctx               The Poly1305 context.\0A * \5Cparam mac               The buffer to where the MAC is written. Must be\0A *                          big enough to contain the 16-byte MAC.\0A */\0Astatic void poly1305_compute_mac(const mbedtls_poly1305_context *ctx,\0A                                 unsigned char mac[16])\0A{\0A    uint64_t d;\0A    uint32_t g0, g1, g2, g3, g4;\0A    uint32_t acc0, acc1, acc2, acc3, acc4;\0A    uint32_t mask;\0A    uint32_t mask_inv;\0A\0A    acc0 = ctx->acc[0];\0A    acc1 = ctx->acc[1];\0A    acc2 = ctx->acc[2];\0A    acc3 = ctx->acc[3];\0A    acc4 = ctx->acc[4];\0A\0A    /* Before adding 's' we ensure that the accumulator is mod 2^130 - 5.\0A     * We do this by calculating acc - (2^130 - 5), then checking if\0A     * the 131st bit is set. If it is, then reduce: acc -= (2^130 - 5)\0A     */\0A\0A    /* Calculate acc + -(2^130 - 5) */\0A    d  = ((uint64_t) acc0 + 5U);\0A    g0 = (uint32_t) d;\0A    d  = ((uint64_t) acc1 + (d >> 32));\0A    g1 = (uint32_t) d;\0A    d  = ((uint64_t) acc2 + (d >> 32));\0A    g2 = (uint32_t) d;\0A    d  = ((uint64_t) acc3 + (d >> 32));\0A    g3 = (uint32_t) d;\0A    g4 = acc4 + (uint32_t) (d >> 32U);\0A\0A    /* mask == 0xFFFFFFFF if 131st bit is set, otherwise mask == 0 */\0A    mask = (uint32_t) 0U - (g4 >> 2U);\0A    mask_inv = ~mask;\0A\0A    /* If 131st bit is set then acc=g, otherwise, acc is unmodified */\0A    acc0 = (acc0 & mask_inv) | (g0 & mask);\0A    acc1 = (acc1 & mask_inv) | (g1 & mask);\0A    acc2 = (acc2 & mask_inv) | (g2 & mask);\0A    acc3 = (acc3 & mask_inv) | (g3 & mask);\0A\0A    /* Add 's' */\0A    d = (uint64_t) acc0 + ctx->s[0];\0A    acc0 = (uint32_t) d;\0A    d = (uint64_t) acc1 + ctx->s[1] + (d >> 32U);\0A    acc1 = (uint32_t) d;\0A    d = (uint64_t) acc2 + ctx->s[2] + (d >> 32U);\0A    acc2 = (uint32_t) d;\0A    acc3 += ctx->s[3] + (uint32_t) (d >> 32U);\0A\0A    /* Compute MAC (128 least significant bits of the accumulator) */\0A    MBEDTLS_PUT_UINT32_LE(acc0, mac,  0);\0A    MBEDTLS_PUT_UINT32_LE(acc1, mac,  4);\0A    MBEDTLS_PUT_UINT32_LE(acc2, mac,  8);\0A    MBEDTLS_PUT_UINT32_LE(acc3, mac, 12);\0A}\0A\0Avoid mbedtls_poly1305_init(mbedtls_poly1305_context *ctx)\0A{\0A    mbedtls_platform_zeroize(ctx, sizeof(mbedtls_poly1305_context));\0A}\0A\0Avoid mbedtls_poly1305_free(mbedtls_poly1305_context *ctx)\0A{\0A    if (ctx == NULL) {\0A        return;\0A    }\0A\0A    mbedtls_platform_zeroize(ctx, sizeof(mbedtls_poly1305_context));\0A}\0A\0Aint mbedtls_poly1305_starts(mbedtls_poly1305_context *ctx,\0A                            const unsigned char key[32])\0A{\0A    /* r &= 0x0ffffffc0ffffffc0ffffffc0fffffff */\0A    ctx->r[0] = MBEDTLS_GET_UINT32_LE(key, 0)  & 0x0FFFFFFFU;\0A    ctx->r[1] = MBEDTLS_GET_UINT32_LE(key, 4)  & 0x0FFFFFFCU;\0A    ctx->r[2] = MBEDTLS_GET_UINT32_LE(key, 8)  & 0x0FFFFFFCU;\0A    ctx->r[3] = MBEDTLS_GET_UINT32_LE(key, 12) & 0x0FFFFFFCU;\0A\0A    ctx->s[0] = MBEDTLS_GET_UINT32_LE(key, 16);\0A    ctx->s[1] = MBEDTLS_GET_UINT32_LE(key, 20);\0A    ctx->s[2] = MBEDTLS_GET_UINT32_LE(key, 24);\0A    ctx->s[3] = MBEDTLS_GET_UINT32_LE(key, 28);\0A\0A    /* Initial accumulator state */\0A    ctx->acc[0] = 0U;\0A    ctx->acc[1] = 0U;\0A    ctx->acc[2] = 0U;\0A    ctx->acc[3] = 0U;\0A    ctx->acc[4] = 0U;\0A\0A    /* Queue initially empty */\0A    mbedtls_platform_zeroize(ctx->queue, sizeof(ctx->queue));\0A    ctx->queue_len = 0U;\0A\0A    return 0;\0A}\0A\0Aint mbedtls_poly1305_update(mbedtls_poly1305_context *ctx,\0A                            const unsigned char *input,\0A                            size_t ilen)\0A{\0A    size_t offset    = 0U;\0A    size_t remaining = ilen;\0A    size_t queue_free_len;\0A    size_t nblocks;\0A\0A    if ((remaining > 0U) && (ctx->queue_len > 0U)) {\0A        queue_free_len = (POLY1305_BLOCK_SIZE_BYTES - ctx->queue_len);\0A\0A        if (ilen < queue_free_len) {\0A            /* Not enough data to complete the block.\0A             * Store this data with the other leftovers.\0A             */\0A            memcpy(&ctx->queue[ctx->queue_len],\0A                   input,\0A                   ilen);\0A\0A            ctx->queue_len += ilen;\0A\0A            remaining = 0U;\0A        } else {\0A            /* Enough data to produce a complete block */\0A            memcpy(&ctx->queue[ctx->queue_len],\0A                   input,\0A                   queue_free_len);\0A\0A            ctx->queue_len = 0U;\0A\0A            poly1305_process(ctx, 1U, ctx->queue, 1U);   /* add padding bit */\0A\0A            offset    += queue_free_len;\0A            remaining -= queue_free_len;\0A        }\0A    }\0A\0A    if (remaining >= POLY1305_BLOCK_SIZE_BYTES) {\0A        nblocks = remaining / POLY1305_BLOCK_SIZE_BYTES;\0A\0A        poly1305_process(ctx, nblocks, &input[offset], 1U);\0A\0A        offset += nblocks * POLY1305_BLOCK_SIZE_BYTES;\0A        remaining %= POLY1305_BLOCK_SIZE_BYTES;\0A    }\0A\0A    if (remaining > 0U) {\0A        /* Store partial block */\0A        ctx->queue_len = remaining;\0A        memcpy(ctx->queue, &input[offset], remaining);\0A    }\0A\0A    return 0;\0A}\0A\0Aint mbedtls_poly1305_finish(mbedtls_poly1305_context *ctx,\0A                            unsigned char mac[16])\0A{\0A    /* Process any leftover data */\0A    if (ctx->queue_len > 0U) {\0A        /* Add padding bit */\0A        ctx->queue[ctx->queue_len] = 1U;\0A        ctx->queue_len++;\0A\0A        /* Pad with zeroes */\0A        memset(&ctx->queue[ctx->queue_len],\0A               0,\0A               POLY1305_BLOCK_SIZE_BYTES - ctx->queue_len);\0A\0A        poly1305_process(ctx, 1U,           /* Process 1 block */\0A                         ctx->queue, 0U);   /* Already padded above */\0A    }\0A\0A    poly1305_compute_mac(ctx, mac);\0A\0A    return 0;\0A}\0A\0Aint mbedtls_poly1305_mac(const unsigned char key[32],\0A                         const unsigned char *input,\0A                         size_t ilen,\0A                         unsigned char mac[16])\0A{\0A    mbedtls_poly1305_context ctx;\0A    int ret = MBEDTLS_ERR_ERROR_CORRUPTION_DETECTED;\0A\0A    mbedtls_poly1305_init(&ctx);\0A\0A    ret = mbedtls_poly1305_starts(&ctx, key);\0A    if (ret != 0) {\0A        goto cleanup;\0A    }\0A\0A    ret = mbedtls_poly1305_update(&ctx, input, ilen);\0A    if (ret != 0) {\0A        goto cleanup;\0A    }\0A\0A    ret = mbedtls_poly1305_finish(&ctx, mac);\0A\0Acleanup:\0A    mbedtls_poly1305_free(&ctx);\0A    return ret;\0A}\0A\0A#endif /* MBEDTLS_POLY1305_ALT */\0A\0A#if defined(MBEDTLS_SELF_TEST)\0A\0Astatic const unsigned char test_keys[2][32] =\0A{\0A    {\0A        0x85, 0xd6, 0xbe, 0x78, 0x57, 0x55, 0x6d, 0x33,\0A        0x7f, 0x44, 0x52, 0xfe, 0x42, 0xd5, 0x06, 0xa8,\0A        0x01, 0x03, 0x80, 0x8a, 0xfb, 0x0d, 0xb2, 0xfd,\0A        0x4a, 0xbf, 0xf6, 0xaf, 0x41, 0x49, 0xf5, 0x1b\0A    },\0A    {\0A        0x1c, 0x92, 0x40, 0xa5, 0xeb, 0x55, 0xd3, 0x8a,\0A        0xf3, 0x33, 0x88, 0x86, 0x04, 0xf6, 0xb5, 0xf0,\0A        0x47, 0x39, 0x17, 0xc1, 0x40, 0x2b, 0x80, 0x09,\0A        0x9d, 0xca, 0x5c, 0xbc, 0x20, 0x70, 0x75, 0xc0\0A    }\0A};\0A\0Astatic const unsigned char test_data[2][127] =\0A{\0A    {\0A        0x43, 0x72, 0x79, 0x70, 0x74, 0x6f, 0x67, 0x72,\0A        0x61, 0x70, 0x68, 0x69, 0x63, 0x20, 0x46, 0x6f,\0A        0x72, 0x75, 0x6d, 0x20, 0x52, 0x65, 0x73, 0x65,\0A        0x61, 0x72, 0x63, 0x68, 0x20, 0x47, 0x72, 0x6f,\0A        0x75, 0x70\0A    },\0A    {\0A        0x27, 0x54, 0x77, 0x61, 0x73, 0x20, 0x62, 0x72,\0A        0x69, 0x6c, 0x6c, 0x69, 0x67, 0x2c, 0x20, 0x61,\0A        0x6e, 0x64, 0x20, 0x74, 0x68, 0x65, 0x20, 0x73,\0A        0x6c, 0x69, 0x74, 0x68, 0x79, 0x20, 0x74, 0x6f,\0A        0x76, 0x65, 0x73, 0x0a, 0x44, 0x69, 0x64, 0x20,\0A        0x67, 0x79, 0x72, 0x65, 0x20, 0x61, 0x6e, 0x64,\0A        0x20, 0x67, 0x69, 0x6d, 0x62, 0x6c, 0x65, 0x20,\0A        0x69, 0x6e, 0x20, 0x74, 0x68, 0x65, 0x20, 0x77,\0A        0x61, 0x62, 0x65, 0x3a, 0x0a, 0x41, 0x6c, 0x6c,\0A        0x20, 0x6d, 0x69, 0x6d, 0x73, 0x79, 0x20, 0x77,\0A        0x65, 0x72, 0x65, 0x20, 0x74, 0x68, 0x65, 0x20,\0A        0x62, 0x6f, 0x72, 0x6f, 0x67, 0x6f, 0x76, 0x65,\0A        0x73, 0x2c, 0x0a, 0x41, 0x6e, 0x64, 0x20, 0x74,\0A        0x68, 0x65, 0x20, 0x6d, 0x6f, 0x6d, 0x65, 0x20,\0A        0x72, 0x61, 0x74, 0x68, 0x73, 0x20, 0x6f, 0x75,\0A        0x74, 0x67, 0x72, 0x61, 0x62, 0x65, 0x2e\0A    }\0A};\0A\0Astatic const size_t test_data_len[2] =\0A{\0A    34U,\0A    127U\0A};\0A\0Astatic const unsigned char test_mac[2][16] =\0A{\0A    {\0A        0xa8, 0x06, 0x1d, 0xc1, 0x30, 0x51, 0x36, 0xc6,\0A        0xc2, 0x2b, 0x8b, 0xaf, 0x0c, 0x01, 0x27, 0xa9\0A    },\0A    {\0A        0x45, 0