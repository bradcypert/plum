@.str45226 = private global { i64, i64, [3164 x i8] } { i64 -1, i64 3163, [3164 x i8] c"/**\0A * \5Cfile ssl_cookie.h\0A *\0A * \5Cbrief DTLS cookie callbacks implementation\0A */\0A/*\0A *  Copyright The Mbed TLS Contributors\0A *  SPDX-License-Identifier: Apache-2.0 OR GPL-2.0-or-later\0A */\0A#ifndef MBEDTLS_SSL_COOKIE_H\0A#define MBEDTLS_SSL_COOKIE_H\0A#include \22mbedtls/private_access.h\22\0A\0A#include \22mbedtls/build_info.h\22\0A\0A#include \22mbedtls/ssl.h\22\0A\0A#if !defined(MBEDTLS_USE_PSA_CRYPTO)\0A#if defined(MBEDTLS_THREADING_C)\0A#include \22mbedtls/threading.h\22\0A#endif\0A#endif /* !MBEDTLS_USE_PSA_CRYPTO */\0A\0A/**\0A * \5Cname SECTION: Module settings\0A *\0A * The configuration options you can set for this module are in this section.\0A * Either change them in mbedtls_config.h or define them on the compiler command line.\0A * \5C{\0A */\0A#ifndef MBEDTLS_SSL_COOKIE_TIMEOUT\0A#define MBEDTLS_SSL_COOKIE_TIMEOUT     60 /**< Default expiration delay of DTLS cookies, in seconds if HAVE_TIME, or in number of cookies issued */\0A#endif\0A\0A/** \5C} name SECTION: Module settings */\0A\0A#ifdef __cplusplus\0Aextern \22C\22 {\0A#endif\0A\0A/**\0A * \5Cbrief          Context for the default cookie functions.\0A */\0Atypedef struct mbedtls_ssl_cookie_ctx {\0A#if defined(MBEDTLS_USE_PSA_CRYPTO)\0A    mbedtls_svc_key_id_t    MBEDTLS_PRIVATE(psa_hmac_key);  /*!< key id for the HMAC portion   */\0A    psa_algorithm_t         MBEDTLS_PRIVATE(psa_hmac_alg);  /*!< key algorithm for the HMAC portion   */\0A#else\0A    mbedtls_md_context_t    MBEDTLS_PRIVATE(hmac_ctx);   /*!< context for the HMAC portion   */\0A#endif /* MBEDTLS_USE_PSA_CRYPTO */\0A#if !defined(MBEDTLS_HAVE_TIME)\0A    unsigned long   MBEDTLS_PRIVATE(serial);     /*!< serial number for expiration   */\0A#endif\0A    unsigned long   MBEDTLS_PRIVATE(timeout);    /*!< timeout delay, in seconds if HAVE_TIME,\0A                                                    or in number of tickets issued */\0A\0A#if !defined(MBEDTLS_USE_PSA_CRYPTO)\0A#if defined(MBEDTLS_THREADING_C)\0A    mbedtls_threading_mutex_t MBEDTLS_PRIVATE(mutex);\0A#endif\0A#endif /* !MBEDTLS_USE_PSA_CRYPTO */\0A} mbedtls_ssl_cookie_ctx;\0A\0A/**\0A * \5Cbrief          Initialize cookie context\0A */\0Avoid mbedtls_ssl_cookie_init(mbedtls_ssl_cookie_ctx *ctx);\0A\0A/**\0A * \5Cbrief          Setup cookie context (generate keys)\0A */\0Aint mbedtls_ssl_cookie_setup(mbedtls_ssl_cookie_ctx *ctx,\0A                             int (*f_rng)(void *, unsigned char *, size_t),\0A                             void *p_rng);\0A\0A/**\0A * \5Cbrief          Set expiration delay for cookies\0A *                 (Default MBEDTLS_SSL_COOKIE_TIMEOUT)\0A *\0A * \5Cparam ctx      Cookie context\0A * \5Cparam delay    Delay, in seconds if HAVE_TIME, or in number of cookies\0A *                 issued in the meantime.\0A *                 0 to disable expiration (NOT recommended)\0A */\0Avoid mbedtls_ssl_cookie_set_timeout(mbedtls_ssl_cookie_ctx *ctx, unsigned long delay);\0A\0A/**\0A * \5Cbrief          Free cookie context\0A */\0Avoid mbedtls_ssl_cookie_free(mbedtls_ssl_cookie_ctx *ctx);\0A\0A/**\0A * \5Cbrief          Generate cookie, see \5Cc mbedtls_ssl_cookie_write_t\0A */\0Ambedtls_ssl_cookie_write_t mbedtls_ssl_cookie_write;\0A\0A/**\0A * \5Cbrief          Verify cookie, see \5Cc mbedtls_ssl_cookie_write_t\0A */\0Ambedtls_ssl_cookie_check_t mbedtls_ssl_cookie_check;\0A\0A#ifdef __cplusplus\0A}\0A#endif\0A\0A#endif /* ssl_cookie.h */\0A\00" }
