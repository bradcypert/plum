@.str44587 = private global { i64, i64, [5682 x i8] } { i64 -1, i64 5681, [5682 x i8] c"/**\0A * \5Cfile aesni.h\0A *\0A * \5Cbrief AES-NI for hardware AES acceleration on some Intel processors\0A *\0A * \5Cwarning These functions are only for internal use by other library\0A *          functions; you must not call them directly.\0A */\0A/*\0A *  Copyright The Mbed TLS Contributors\0A *  SPDX-License-Identifier: Apache-2.0 OR GPL-2.0-or-later\0A */\0A#ifndef MBEDTLS_AESNI_H\0A#define MBEDTLS_AESNI_H\0A\0A#include \22mbedtls/build_info.h\22\0A\0A#include \22mbedtls/aes.h\22\0A\0A#define MBEDTLS_AESNI_AES      0x02000000u\0A#define MBEDTLS_AESNI_CLMUL    0x00000002u\0A\0A#if defined(MBEDTLS_AESNI_C) && \5C\0A    (defined(MBEDTLS_ARCH_IS_X64) || defined(MBEDTLS_ARCH_IS_X86))\0A\0A/* Can we do AESNI with intrinsics?\0A * (Only implemented with certain compilers, only for certain targets.)\0A */\0A#undef MBEDTLS_AESNI_HAVE_INTRINSICS\0A#if defined(_MSC_VER) && !defined(__clang__)\0A/* Visual Studio supports AESNI intrinsics since VS 2008 SP1. We only support\0A * VS 2013 and up for other reasons anyway, so no need to check the version. */\0A#define MBEDTLS_AESNI_HAVE_INTRINSICS\0A#endif\0A/* GCC-like compilers: currently, we only support intrinsics if the requisite\0A * target flag is enabled when building the library (e.g. `gcc -mpclmul -msse2`\0A * or `clang -maes -mpclmul`). */\0A#if (defined(__GNUC__) || defined(__clang__)) && defined(__AES__) && defined(__PCLMUL__)\0A#define MBEDTLS_AESNI_HAVE_INTRINSICS\0A#endif\0A/* For 32-bit, we only support intrinsics */\0A#if defined(MBEDTLS_ARCH_IS_X86) && (defined(__GNUC__) || defined(__clang__))\0A#define MBEDTLS_AESNI_HAVE_INTRINSICS\0A#endif\0A\0A/* Choose the implementation of AESNI, if one is available.\0A *\0A * Favor the intrinsics-based implementation if it's available, for better\0A * maintainability.\0A * Performance is about the same (see #7380).\0A * In the long run, we will likely remove the assembly implementation. */\0A#if defined(MBEDTLS_AESNI_HAVE_INTRINSICS)\0A#define MBEDTLS_AESNI_HAVE_CODE 2 // via intrinsics\0A#elif defined(MBEDTLS_HAVE_ASM) && \5C\0A    (defined(__GNUC__) || defined(__clang__)) && defined(MBEDTLS_ARCH_IS_X64)\0A/* Can we do AESNI with inline assembly?\0A * (Only implemented with gas syntax, only for 64-bit.)\0A */\0A#define MBEDTLS_AESNI_HAVE_CODE 1 // via assembly\0A#else\0A#error \22MBEDTLS_AESNI_C defined, but neither intrinsics nor assembly available\22\0A#endif\0A\0A#if defined(MBEDTLS_AESNI_HAVE_CODE)\0A\0A#ifdef __cplusplus\0Aextern \22C\22 {\0A#endif\0A\0A/**\0A * \5Cbrief          Internal function to detect the AES-NI feature in CPUs.\0A *\0A * \5Cnote           This function is only for internal use by other library\0A *                 functions; you must not call it directly.\0A *\0A * \5Cparam what     The feature to detect\0A *                 (MBEDTLS_AESNI_AES or MBEDTLS_AESNI_CLMUL)\0A *\0A * \5Creturn         1 if CPU has support for the feature, 0 otherwise\0A */\0A#if !defined(MBEDTLS_AES_USE_HARDWARE_ONLY)\0Aint mbedtls_aesni_has_support(unsigned int what);\0A#else\0A#define mbedtls_aesni_has_support(what) 1\0A#endif\0A\0A/**\0A * \5Cbrief          Internal AES-NI AES-ECB block encryption and decryption\0A *\0A * \5Cnote           This function is only for internal use by other library\0A *                 functions; you must not call it directly.\0A *\0A * \5Cparam ctx      AES context\0A * \5Cparam mode     MBEDTLS_AES_ENCRYPT or MBEDTLS_AES_DECRYPT\0A * \5Cparam input    16-byte input block\0A * \5Cparam output   16-byte output block\0A *\0A * \5Creturn         0 on success (cannot fail)\0A */\0Aint mbedtls_aesni_crypt_ecb(mbedtls_aes_context *ctx,\0A                            int mode,\0A                            const unsigned char input[16],\0A                            unsigned char output[16]);\0A\0A/**\0A * \5Cbrief          Internal GCM multiplication: c = a * b in GF(2^128)\0A *\0A * \5Cnote           This function is only for internal use by other library\0A *                 functions; you must not call it directly.\0A *\0A * \5Cparam c        Result\0A * \5Cparam a        First operand\0A * \5Cparam b        Second operand\0A *\0A * \5Cnote           Both operands and result are bit strings interpreted as\0A *                 elements of GF(2^128) as per the GCM spec.\0A */\0Avoid mbedtls_aesni_gcm_mult(unsigned char c[16],\0A                            const unsigned char a[16],\0A                            const unsigned char b[16]);\0A\0A#if !defined(MBEDTLS_BLOCK_CIPHER_NO_DECRYPT)\0A/**\0A * \5Cbrief           Internal round key inversion. This function computes\0A *                  decryption round keys from the encryption round keys.\0A *\0A * \5Cnote            This function is only for internal use by other library\0A *                  functions; you must not call it directly.\0A *\0A * \5Cparam invkey    Round keys for the equivalent inverse cipher\0A * \5Cparam fwdkey    Original round keys (for encryption)\0A * \5Cparam nr        Number of rounds (that is, number of round keys minus one)\0A */\0Avoid mbedtls_aesni_inverse_key(unsigned char *invkey,\0A                               const unsigned char *fwdkey,\0A                               int nr);\0A#endif /* !MBEDTLS_BLOCK_CIPHER_NO_DECRYPT */\0A\0A/**\0A * \5Cbrief           Internal key expansion for encryption\0A *\0A * \5Cnote            This function is only for internal use by other library\0A *                  functions; you must not call it directly.\0A *\0A * \5Cparam rk        Destination buffer where the round keys are written\0A * \5Cparam key       Encryption key\0A * \5Cparam bits      Key size in bits (must be 128, 192 or 256)\0A *\0A * \5Creturn          0 if successful, or MBEDTLS_ERR_AES_INVALID_KEY_LENGTH\0A */\0Aint mbedtls_aesni_setkey_enc(unsigned char *rk,\0A                             const unsigned char *key,\0A                             size_t bits);\0A\0A#ifdef __cplusplus\0A}\0A#endif\0A\0A#endif /* MBEDTLS_AESNI_HAVE_CODE */\0A#endif  /* MBEDTLS_AESNI_C && (MBEDTLS_ARCH_IS_X64 || MBEDTLS_ARCH_IS_X86) */\0A\0A#endif /* MBEDTLS_AESNI_H */\0A\00" }
