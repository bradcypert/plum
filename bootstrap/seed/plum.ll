style or old-style\0A * SE driver is present, to avoid unused argument errors at compile time. */\0A#ifndef PSA_CRYPTO_DRIVER_PRESENT\0A#define PSA_CRYPTO_DRIVER_PRESENT\0A#endif\0A#include \22psa_crypto_se.h\22\0A#endif\0A\0A/** Get the key buffer size required to store the key material of a key\0A *  associated with an opaque driver.\0A *\0A * \5Cparam[in] attributes  The key attributes.\0A * \5Cparam[out] key_buffer_size  Minimum buffer size to contain the key material\0A *\0A * \5Cretval #PSA_SUCCESS\0A *         The minimum size for a buffer to contain the key material has been\0A *         returned successfully.\0A * \5Cretval #PSA_ERROR_NOT_SUPPORTED\0A *         The type and/or the size in bits of the key or the combination of\0A *         the two is not supported.\0A * \5Cretval #PSA_ERROR_INVALID_ARGUMENT\0A *         The key is declared with a lifetime not known to us.\0A */\0Apsa_status_t psa_driver_wrapper_get_key_buffer_size(\0A    const psa_key_attributes_t *attributes,\0A    size_t *key_buffer_size )\0A{\0A    psa_key_location_t location = PSA_KEY_LIFETIME_GET_LOCATION( psa_get_key_lifetime(attributes) );\0A    psa_key_type_t key_type = psa_get_key_type(attributes);\0A    size_t key_bits = psa_get_key_bits(attributes);\0A\0A    *key_buffer_size = 0;\0A    switch( location )\0A    {\0A#if defined(PSA_CRYPTO_DRIVER_TEST)\0A        case PSA_CRYPTO_TEST_DRIVER_LOCATION:\0A#if defined(MBEDTLS_PSA_CRYPTO_BUILTIN_KEYS)\0A            /* Emulate property 'builtin_key_size' */\0A            if( psa_key_id_is_builtin(\0A                    MBEDTLS_SVC_KEY_ID_GET_KEY_ID(\0A                        psa_get_key_id( attributes ) ) ) )\0A            {\0A                *key_buffer_size = sizeof( psa_drv_slot_number_t );\0A                return( PSA_SUCCESS );\0A            }\0A#endif /* MBEDTLS_PSA_CRYPTO_BUILTIN_KEYS */\0A            *key_buffer_size = mbedtls_test_opaque_size_function( key_type,\0A                                                                  key_bits );\0A            return( ( *key_buffer_size != 0 ) ?\0A                    PSA_SUCCESS : PSA_ERROR_NOT_SUPPORTED );\0A#endif /* PSA_CRYPTO_DRIVER_TEST */\0A\0A        default:\0A            (void)key_type;\0A            (void)key_bits;\0A            return( PSA_ERROR_INVALID_ARGUMENT );\0A    }\0A}\0A\0Apsa_status_t psa_driver_wrapper_export_public_key(\0A    const psa_key_attributes_t *attributes,\0A    const uint8_t *key_buffer, size_t key_buffer_size,\0A    uint8_t *data, size_t data_size, size_t *data_length )\0A\0A{\0A\0A    psa_status_t status = PSA_ERROR_INVALID_ARGUMENT;\0A    psa_key_location_t location = PSA_KEY_LIFETIME_GET_LOCATION(\0A                                      psa_get_key_lifetime( attributes ) );\0A\0A    /* Try dynamically-registered SE interface first */\0A#if defined(MBEDTLS_PSA_CRYPTO_SE_C)\0A    const psa_drv_se_t *drv;\0A    psa_drv_se_context_t *drv_context;\0A\0A    if( psa_get_se_driver( psa_get_key_lifetime(attributes), &drv, &drv_context ) )\0A    {\0A        if( ( drv->key_management == NULL ) ||\0A            ( drv->key_management->p_export_public == NULL ) )\0A        {\0A            return( PSA_ERROR_NOT_SUPPORTED );\0A        }\0A\0A        return( drv->key_management->p_export_public(\0A                    drv_context,\0A                    *( (psa_key_slot_number_t *)key_buffer ),\0A                    data, data_size, data_length ) );\0A    }\0A#endif /* MBEDTLS_PSA_CRYPTO_SE_C */\0A\0A    switch( location )\0A    {\0A        case PSA_KEY_LOCATION_LOCAL_STORAGE:\0A            /* Key is stored in the slot in export representation, so\0A             * cycle through all known transparent accelerators */\0A#if defined(PSA_CRYPTO_ACCELERATOR_DRIVER_PRESENT)\0A\0A#if (defined(PSA_CRYPTO_DRIVER_TEST) )\0A            status = mbedtls_test_transparent_export_public_key\0A                (attributes,\0A                                key_buffer,\0A                                key_buffer_size,\0A                                data,\0A                                data_size,\0A                                data_length\0A            );\0A\0A            if( status != PSA_ERROR_NOT_SUPPORTED )\0A                return( status );\0A#endif\0A\0A#if (defined(MBEDTLS_PSA_P256M_DRIVER_ENABLED) )\0A            status = p256_transparent_export_public_key\0A                (attributes,\0A                                key_buffer,\0A                                key_buffer_size,\0A                                data,\0A                                data_size,\0A                                data_length\0A            );\0A\0A            if( status != PSA_ERROR_NOT_SUPPORTED )\0A                return( status );\0A#endif\0A\0A\0A#endif /* PSA_CRYPTO_ACCELERATOR_DRIVER_PRESENT */\0A            /* Fell through, meaning no accelerator supports this operation */\0A            return( psa_export_public_key_internal( attributes,\0A                                                    key_buffer,\0A                                                    key_buffer_size,\0A                                                    data,\0A                                                    data_size,\0A                                                    data_length ) );\0A\0A        /* Add cases for opaque driver here */\0A#if defined(PSA_CRYPTO_ACCELERATOR_DRIVER_PRESENT)\0A\0A#if (defined(PSA_CRYPTO_DRIVER_TEST) )\0A        case 0x7fffff:\0A            return( mbedtls_test_opaque_export_public_key\0A            (attributes,\0A                            key_buffer,\0A                            key_buffer_size,\0A                            data,\0A                            data_size,\0A                            data_length\0A        ));\0A#endif\0A\0A\0A#endif /* PSA_CRYPTO_ACCELERATOR_DRIVER_PRESENT */\0A        default:\0A            /* Key is declared with a lifetime not known to us */\0A            return( status );\0A    }\0A\0A}\0A\0Apsa_status_t psa_driver_wrapper_get_builtin_key(\0A    psa_drv_slot_number_t slot_number,\0A    psa_key_attributes_t *attributes,\0A    uint8_t *key_buffer, size_t key_buffer_size, size_t *key_buffer_length )\0A{\0A\0A    psa_key_location_t location = PSA_KEY_LIFETIME_GET_LOCATION( psa_get_key_lifetime(attributes) );\0A    switch( location )\0A    {\0A#if defined(PSA_CRYPTO_ACCELERATOR_DRIVER_PRESENT)\0A\0A#if (defined(PSA_CRYPTO_DRIVER_TEST) )\0A        case 0x7fffff:\0A            return( mbedtls_test_opaque_get_builtin_key\0A            (slot_number,\0A                            attributes,\0A                            key_buffer,\0A                            key_buffer_size,\0A                            key_buffer_length\0A        ));\0A#endif\0A\0A\0A#endif /* PSA_CRYPTO_ACCELERATOR_DRIVER_PRESENT */\0A        default:\0A            (void) slot_number;\0A            (void) key_buffer;\0A            (void) key_buffer_size;\0A            (void) key_buffer_length;\0A            return( PSA_ERROR_DOES_NOT_EXIST );\0A    }\0A\0A}\0A\0A#endif /* MBEDTLS_PSA_CRYPTO_C */\0A\00" }
