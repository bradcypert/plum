@.str41579 = private global { i64, i64, [10819 x i8] } { i64 -1, i64 10818, [10819 x i8] c"/*\0A *  SSL session cache implementation\0A *\0A *  Copyright The Mbed TLS Contributors\0A *  SPDX-License-Identifier: Apache-2.0 OR GPL-2.0-or-later\0A */\0A/*\0A * These session callbacks use a simple chained list\0A * to store and retrieve the session information.\0A */\0A\0A#include \22common.h\22\0A\0A#if defined(MBEDTLS_SSL_CACHE_C)\0A\0A#include \22mbedtls/platform.h\22\0A\0A#include \22mbedtls/ssl_cache.h\22\0A#include \22ssl_misc.h\22\0A#include \22mbedtls/error.h\22\0A\0A#include <string.h>\0A\0Avoid mbedtls_ssl_cache_init(mbedtls_ssl_cache_context *cache)\0A{\0A    memset(cache, 0, sizeof(mbedtls_ssl_cache_context));\0A\0A    cache->timeout = MBEDTLS_SSL_CACHE_DEFAULT_TIMEOUT;\0A    cache->max_entries = MBEDTLS_SSL_CACHE_DEFAULT_MAX_ENTRIES;\0A\0A#if defined(MBEDTLS_THREADING_C)\0A    mbedtls_mutex_init(&cache->mutex);\0A#endif\0A}\0A\0AMBEDTLS_CHECK_RETURN_CRITICAL\0Astatic int ssl_cache_find_entry(mbedtls_ssl_cache_context *cache,\0A                                unsigned char const *session_id,\0A                                size_t session_id_len,\0A                                mbedtls_ssl_cache_entry **dst)\0A{\0A    int ret = MBEDTLS_ERR_SSL_CACHE_ENTRY_NOT_FOUND;\0A#if defined(MBEDTLS_HAVE_TIME)\0A    mbedtls_time_t t = mbedtls_time(NULL);\0A#endif\0A    mbedtls_ssl_cache_entry *cur;\0A\0A    for (cur = cache->chain; cur != NULL; cur = cur->next) {\0A#if defined(MBEDTLS_HAVE_TIME)\0A        if (cache->timeout != 0 &&\0A            (int) (t - cur->timestamp) > cache->timeout) {\0A            continue;\0A        }\0A#endif\0A\0A        if (session_id_len != cur->session_id_len ||\0A            memcmp(session_id, cur->session_id,\0A                   cur->session_id_len) != 0) {\0A            continue;\0A        }\0A\0A        break;\0A    }\0A\0A    if (cur != NULL) {\0A        *dst = cur;\0A        ret = 0;\0A    }\0A\0A    return ret;\0A}\0A\0A\0Aint m