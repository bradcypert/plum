@.str45204 = private global { i64, i64, [20395 x i8] } { i64 -1, i64 20394, [20395 x i8] c"/*\0A *  Armv8-A Cryptographic Extension support functions for Aarch64\0A *\0A *  Copyright The Mbed TLS Contributors\0A *  SPDX-License-Identifier: Apache-2.0 OR GPL-2.0-or-later\0A */\0A\0A#if defined(__clang__) &&  (__clang_major__ >= 4)\0A\0A/* Ideally, we would simply use MBEDTLS_ARCH_IS_ARMV8_A in the following #if,\0A * but that is defined by build_info.h, and we need this block to happen first. */\0A#if defined(__ARM_ARCH)\0A#if __ARM_ARCH >= 8\0A#define MBEDTLS_AESCE_ARCH_IS_ARMV8_A\0A#endif\0A#endif\0A\0A#if defined(MBEDTLS_AESCE_ARCH_IS_ARMV8_A) && !defined(__ARM_FEATURE_CRYPTO)\0A/* TODO: Re-consider above after https://reviews.llvm.org/D131064 merged.\0A *\0A * The intrinsic declaration are guarded by predefined ACLE macros in clang:\0A * these are normally only enabled by the -march option on the command line.\0A * By defining the macros ourselves we gain access to those declarations without\0A * requiring -march on the command line.\0A *\0A * `arm_neon.h` is included by common.h, so we put these defines\0A * at the top of this file, before any includes.\0A */\0A#define __ARM_FEATURE_CRYPTO 1\0A/* See: https://arm-software.github.io/acle/main/acle.html#cryptographic-extensions\0A *\0A * `__ARM_FEATURE_CRYPTO` is deprecated, but we need to continue to specify it\0A * for older compilers.\0A */\0A#define __ARM_FEATURE_AES    1\0A#define MBEDTLS_ENABLE_ARM_CRYPTO_EXTENSIONS_COMPILER_FLAG\0A#endif\0A\0A#endif /* defined(__clang__) &&  (__clang_major__ >= 4) */\0A\0A#include <string.h>\0A#include \22common.h\22\0A\0A#if defined(MBEDTLS_AESCE_C)\0A\0A#include \22aesce.h\22\0A\0A#if defined(MBEDTLS_AESCE_HAVE_CODE)\0A\0A/* Compiler version checks. */\0A#if defined(__clang__)\0A#   if defined(MBEDTLS_ARCH_IS_ARM32) && (__clang_major__ < 11)\0A#       error \22Minimum version of Clang for MBEDTLS_AESCE_C on 32-bit Arm or Thumb is 11.0.\22\0A#   elif defined(MBEDTLS_ARCH_IS_ARM64) && (__clang_major__ < 4)\0A#       error \22Minimum version of Clang for MBEDTLS_AESCE_C on aarch64 is 4.0.\22\0A#   endif\0A#elif defined(__GNUC__)\0A#   if __GNUC__ < 6\0A#       error \22Minimum version of GCC for MBEDTLS_AESCE_C is 6.0.\22\0A#   endif\0A#elif defined(_MSC_VER)\0A/* TODO: We haven't verified MSVC from 1920 to 1928. If someone verified that,\0A *       please update this and document of `MBEDTLS_AESCE_C` in\0A *       `mbedtls_config.h`. */\0A#   if _MSC_VER < 1929\0A#       error \22Minimum version of MSVC for MBEDTLS_AESCE_C is 2019 version 16.11.2.\22\0A#   endif\0A#elif defined(__ARMCC_VERSION)\0A#    if defined(MBEDTLS_ARCH_IS_ARM32) && (__ARMCC_VERSION < 6200002)\0A/* TODO: We haven't verified armclang for 32-bit Arm/Thumb prior to 6.20.\0A * If someone verified that, please update this and document of\0A * `MBEDTLS_AESCE_C` in `mbedtls_config.h`. */\0A#         error \22Minimum version of armclang for MBEDTLS_AESCE_C on 32-bit Arm is 6.20.\22\0A#    elif defined(MBEDTLS_ARCH_IS_ARM64) && (__ARMCC_VERSION < 6060000)\0A#         error \22Minimum version of armclang for MBEDTLS_AESCE_C on aarch64 is 6.6.\22\0A#    endif\0A#endif\0A\0A#if !(defined(__ARM_FEATURE_CRYPTO) || defined(__ARM_FEATURE_AES)) || \5C\0A    defined(MBEDTLS_ENABLE_ARM_CRYPTO_EXTENSIONS_COMPILER_FLAG)\0A#   if defined(__ARMCOMPILER_VERSION)\0A#       if __ARMCOMPILER_VERSION <= 6090000\0A#           error \22Must use minimum -march=armv8-a+crypto for MBEDTLS_AESCE_C\22\0A#       else\0A#           pragma clang attribute push (__attribute__((target(\22aes\22))), apply_to=function)\0A#           define MBEDTLS_POP_TARGET_PRAGMA\0A#       endif\0A#   elif defined(__clang__)\0A#       pragma clang attribute push (__attribute__((target(\22aes\22))), apply_to=function)\0A#       define MBEDTLS_POP_TARGET_PRAGMA\0A#   elif defined(__GNUC__)\0A#       pragma GCC push_options\0A#       pragma GCC target (\22+crypto\22)\0A#       define MBEDTLS_POP_TARGET_PRAGMA\0A#   elif defined(_MSC_VER)\0A#       error \22Required feature(__ARM_FEATURE_AES) is not enabled.\22\0A#   endif\0A#endif /* !(__ARM_FEATURE_CRYPTO || __ARM_FEATURE_AES) ||\0A          MBEDTLS_ENABLE_ARM_CRYPTO_EXTENSIONS_COMPILER_FLAG */\0A\0A#if defined(__linux__) && !defined(MBEDTLS_AES_USE_HARDWARE_ONLY)\0A\0A#include <sys/auxv.h>\0A#if !defined(HWCAP_NEON)\0A#define HWCAP_NEON  (1 << 12)\0A#endif\0A#if !defined(HWCAP2_AES)\0A#define HWCAP2_AES  (1 << 0)\0A#endif\0A#if !defined(HWCAP_AES)\0A#define HWCAP_AES   (1 << 3)\0A#endif\0A#if !defined(HWCAP_ASIMD)\0A#define HWCAP_ASIMD (1 << 1)\0A#endif\0A\0Asigned char mbedtls_aesce_has_support_result = -1;\0A\0A#if !defined(MBEDTLS_AES_USE_HARDWARE_ONLY)\0A/*\0A * AES instruction support detection routine\0A */\0Aint mbedtls_aesce_has_support_impl(void)\0A{\0A    /* To avoid many calls to getauxval, cache the result. This is\0A     * thread-safe, because we store the result in a char so cannot\0A     * be vulnerable to non-atomic updates.\0A     * It is possible that we could end up setting result more than\0A     * once, but that is harmless.\0A     */\0A    if (mbedtls_aesce_has_support_result == -1) {\0A#if defined(MBEDTLS_ARCH_IS_ARM32)\0A        unsigned long auxval  = getauxval(AT_HWCAP);\0A        unsigned long auxval2 = getauxval(AT_HWCAP2);\0A        if (((auxval  & HWCAP_NEON) == HWCAP_NEON) &&\0A            ((auxval2 & HWCAP2_AES) == HWCAP2_AES)) {\0A            mbedtls_aesce_has_support_result = 1;\0A        } else {\0A            mbedtls_aesce_has_support_result = 0;\0A        }\0A#else\0A        unsigned long auxval = getauxval(AT_HWCAP);\0A        if ((auxval & (HWCAP_ASIMD | HWCAP_AES)) ==\0A            (HWCAP_ASIMD | HWCAP_AES)) {\0A            mbedtls_aesce_has_support_result = 1;\0A        } else {\0A            mbedtls_aesce_has_support_result = 0;\0A        }\0A#endif\0A    }\0A    return mbedtls_aesce_has_support_result;\0A}\0A#endif\0A\0A#endif /* defined(__linux__) && !defined(MBEDTLS_AES_USE_HARDWARE_ONLY) */\0A\0A/* Single round of AESCE encryption */\0A#define AESCE_ENCRYPT_ROUND                   \5C\0A    block = vaeseq_u8(block, vld1q_u8(keys)); \5C\0A    block = vaesmcq_u8(block);                \5C\0A    keys += 16\0A/* Two rounds of AESCE encryption */\0A#define AESCE_ENCRYPT_ROUND_X2        AESCE_ENCRYPT_ROUND; AESCE_ENCRYPT_ROUND\0A\0AMBEDTLS_OPTIMIZE_FOR_PERFORMANCE\0Astatic uint8x16_t aesce_encrypt_block(uint8x16_t block,\0A                                      unsigned char *keys,\0A                                      int rounds)\0A{\0A    /* 10, 12 or 14 rounds. Unroll loop. */\0A    if (rounds == 10) {\0A        goto rounds_10;\0A    }\0A    if (rounds == 12) {\0A        goto rounds_12;\0A    }\0A    AESCE_ENCRYPT_ROUND_X2;\0Arounds_12:\0A    AESCE_ENCRYPT_ROUND_X2;\0Arounds_10:\0A    AESCE_ENCRYPT_ROUND_X2;\0A    AESCE_ENCRYPT_ROUND_X2;\0A    AESCE_ENCRYPT_ROUND_X2;\0A    AESCE_ENCRYPT_ROUND_X2;\0A    AESCE_ENCRYPT_ROUND;\0A\0A    /* AES AddRoundKey for the previous round.\0A     * SubBytes, ShiftRows for the final round.  */\0A    block = vaeseq_u8(block, vld1q_u8(keys));\0A    keys += 16;\0A\0A    /* Final round: no MixColumns */\0A\0A    /* Final AddRoundKey */\0A    block = veorq_u8(block, vld1q_u8(keys));\0A\0A    return block;\0A}\0A\0A/* Single round of AESCE decryption\0A *\0A * AES AddRoundKey, SubBytes, ShiftRows\0A *\0A *      block = vaesdq_u8(block, vld1q_u8(keys));\0A *\0A * AES inverse MixColumns for the next round.\0A *\0A * This means that we switch the order of the inverse AddRoundKey and\0A * inverse MixColumns operations. We have to do this as AddRoundKey is\0A * done in an atomic instruction together with the inverses of SubBytes\0A * and ShiftRows.\0A *\0A * It works because MixColumns is a linear operation over GF(2^8) and\0A * AddRoundKey is an exclusive or, which is equivalent to addition over\0A * GF(2^8). (The inverse of MixColumns needs to be applied to the\0A * affected round keys separately which has been done when the\0A * decryption round keys were calculated.)\0A *\0A *      block = vaesimcq_u8(block);\0A */\0A#define AESCE_DECRYPT_ROUND                   \5C\0A    block = vaesdq_u8(block, vld1q_u8(keys)); \5C\0A    block = vaesimcq_u8(block);               \5C\0A    keys += 16\0A/* Two rounds of AESCE decryption */\0A#define AESCE_DECRYPT_ROUND_X2        AESCE_DECRYPT_ROUND; AESCE_DECRYPT_ROUND\0A\0A#if !defined(MBEDTLS_BLOCK_CIPHER_NO_DECRYPT)\0Astatic uint8x16_t aesce_decrypt_block(uint8x16_t block,\0A                                      unsigned char *keys,\0A                                      int rounds)\0A{\0A    /* 10, 12 or 14 rounds. Unroll loop. */\0A    if (rounds == 10) {\0A        goto rounds_10;\0A    }\0A    if (rounds == 12) {\0A        goto rounds_12;\0A    }\0A    AESCE_DECRYPT_ROUND_X2;\0Arounds_12:\0A    AESCE_DECRYPT_ROUND_X2;\0Arounds_10:\0A    AESCE_DECRYPT_ROUND_X2;\0A    AESCE_DECRYPT_ROUND_X2;\0A    AESCE_DECRYPT_ROUND_X2;\0A    AESCE_DECRYPT_ROUND_X2;\0A    AESCE_DECRYPT_ROUND;\0A\0A    /* The inverses of AES AddRoundKey, SubBytes, ShiftRows finishing up the\0A     * last full round. */\0A    block = vaesdq_u8(block, vld1q_u8(keys));\0A    keys += 16;\0A\0A    /* Inverse AddRoundKey for inverting the initial round key addition. */\0A    block = veorq_u8(block, vld1q_u8(keys));\0A\0A    return block;\0A}\0A#endif\0A\0A/*\0A * AES-ECB block en(de)cryption\0A */\0Aint mbedtls_aesce_crypt_ecb(mbedtls_aes_context *ctx,\0A                            int mode,\0A                            const unsigned char input[16],\0A                            unsigned char output[16])\0A{\0A    uint8x16_t block = vld1q_u8(&input[0]);\0A    unsigned char *keys = (unsigned char *) (ctx->buf + ctx->rk_offset);\0A\0A#if !defined(MBEDTLS_BLOCK_CIPHER_NO_DECRYPT)\0A    if (mode == MBEDTLS_AES_DECRYPT) {\0A        block = aesce_decrypt_block(block, keys, ctx->nr);\0A    } else\0A#else\0A    (void) mode;\0A#endif\0A    {\0A        block = aesce_encrypt_block(block, keys, ctx->nr);\0A    }\0A    vst1q_u8(&output[0], block);\0A\0A    return 0;\0A}\0A\0A/*\0A * Compute decryption round keys from encryption round keys\0A */\0A#if !defined(MBEDTLS_BLOCK_CIPHER_NO_DECRYPT)\0Avoid mbedtls_aesce_inverse_key(unsigned char *invkey,\0A                               const unsigned char *fwdkey,\0A                               int nr)\0A{\0A    int i, j;\0A    j = nr;\0A    vst1q_u8(invkey, vld1q_u8(fwdkey + j * 16));\0A    for (i = 1, j--; j > 0; i++, j--) {\0A        vst1q_u8(invkey + i * 16,\0A                 vaesimcq_u8(vld1q_u8(fwdkey + j * 16)));\0A    }\0A    vst1q_u8(invkey + i * 16, vld1q_u8(fwdkey + j * 16));\0A\0A}\0A#endif\0A\0Astatic inline uint32_t aes_rot_word(uint32_t word)\0A{\0A    return (word << (32 - 8)) | (word >> 8);\0A}\0A\0Astatic inline uint32_t aes_sub_word(uint32_t in)\0A{\0A    uint8x16_t v = vreinterpretq_u8_u32(vdupq_n_u32(in));\0A    uint8x16_t zero = vdupq_n_u8(0);\0A\0A    /* vaeseq_u8 does both SubBytes and ShiftRows. Taking the first row yields\0A     * the correct result as ShiftRows doesn't change the first row. */\0A    v = vaeseq_u8(zero, v);\0A    return vgetq_lane_u32(vreinterpretq_u32_u8(v), 0);\0A}\0A\0A/*\0A * Key expansion function\0A */\0Astatic void aesce_setkey_enc(unsigned char *rk,\0A                             const unsigned char *key,\0A                             const size_t key_bit_length)\0A{\0A    static uint8_t const rcon[] = { 0x01, 0x02, 0x04, 0x08, 0x10,\0A                                    0x20, 0x40, 0x80, 0x1b, 0x36 };\0A    /* See https://nvlpubs.nist.gov/nistpubs/FIPS/NIST.FIPS.197.pdf\0A     *   - Section 5, Nr = Nk + 6\0A     *   - Section 5.2, the length of round keys is Nb*(Nr+1)\0A     */\0A    const size_t key_len_in_words = key_bit_length / 32;    /* Nk */\0A    const size_t round_key_len_in_words = 4;                /* Nb */\0A    const size_t rounds_needed = key_len_in_words + 6;      /* Nr */\0A    const size_t round_keys_len_in_words =\0A        round_key_len_in_words * (rounds_needed + 1);       /* Nb*(Nr+1) */\0A    const uint32_t *rko_end = (uint32_t *) rk + round_keys_len_in_words;\0A\0A    memcpy(rk, key, key_len_in_words * 4);\0A\0A    for (uint32_t *rki = (uint32_t *) rk;\0A         rki + key_len_in_words < rko_end;\0A         rki += key_len_in_words) {\0A\0A        size_t iteration = (size_t) (rki - (uint32_t *) rk) / key_len_in_words;\0A        uint32_t *rko;\0A        rko = rki + key_len_in_words;\0A        rko[0] = aes_rot_word(aes_sub_word(rki[key_len_in_words - 1]));\0A        rko[0] ^= rcon[iteration] ^ rki[0];\0A        rko[1] = rko[0] ^ rki[1];\0A        rko[2] = rko[1] ^ rki[2];\0A        rko[3] = rko[2] ^ rki[3];\0A        if (rko + key_len_in_words > rko_end) {\0A            /* Do not write overflow words.*/\0A            continue;\0A        }\0A#if !defined(MBEDTLS_AES_ONLY_128_BIT_KEY_LENGTH)\0A        switch (key_bit_length) {\0A            case 128:\0A                break;\0A            case 192:\0A                rko[4] = rko[3] ^ rki[4];\0A                rko[5] = rko[4] ^ rki[5];\0A                break;\0A            case 256:\0A                rko[4] = aes_sub_word(rko[3]) ^ rki[4];\0A                rko[5] = rko[4] ^ rki[5];\0A                rko[6] = rko[5] ^ rki[6];\0A                rko[7] = rko[6] ^ rki[7];\0A                break;\0A        }\0A#endif /* !MBEDTLS_AES_ONLY_128_BIT_KEY_LENGTH */\0A    }\0A}\0A\0A/*\0A * Key expansion, wrapper\0A */\0Aint mbedtls_aesce_setkey_enc(unsigned char *rk,\0A                             const unsigned char *key,\0A                             size_t bits)\0A{\0A    switch (bits) {\0A        case 128:\0A        case 192:\0A        case 256:\0A            aesce_setkey_enc(rk, key, bits);\0A            break;\0A        default:\0A            return MBEDTLS_ERR_AES_INVALID_KEY_LENGTH;\0A    }\0A\0A    return 0;\0A}\0A\0A#if defined(MBEDTLS_GCM_C)\0A\0A#if defined(MBEDTLS_ARCH_IS_ARM32)\0A\0A#if defined(__clang__)\0A/* On clang for A32/T32, work around some missing intrinsics and types which are listed in\0A * [ACLE](https://arm-software.github.io/acle/neon_intrinsics/advsimd.html#polynomial-1)\0A * These are only required for GCM.\0A */\0A#define vreinterpretq_u64_p64(a) ((uint64x2_t) a)\0A\0Atypedef uint8x16_t poly128_t;\0A\0Astatic inline poly128_t vmull_p64(poly64_t a, poly64_t b)\0A{\0A    poly128_t r;\0A    asm (\22vmull.p64 %[r], %[a], %[b]\22 : [r] \22=w\22 (r) : [a] \22w\22 (a), [b] \22w\22 (b) :);\0A    return r;\0A}\0A\0A/* This is set to cause some more missing intrinsics to be defined below */\0A#define COMMON_MISSING_INTRINSICS\0A\0Astatic inline poly128_t vmull_high_p64(poly64x2_t a, poly64x2_t b)\0A{\0A    return vmull_p64((poly64_t) (vget_high_u64((uint64x2_t) a)),\0A                     (poly64_t) (vget_high_u64((uint64x2_t) b)));\0A}\0A\0A#endif /* defined(__clang__) */\0A\0Astatic inline uint8x16_t vrbitq_u8(uint8x16_t x)\0A{\0A    /* There is no vrbitq_u8 instruction in A32/T32, so provide\0A     * an equivalent non-Neon implementation. Reverse bit order in each\0A     * byte with 4x rbit, rev. */\0A    asm (\22ldm  %[p], { r2-r5 } \5Cn\5Ct\22\0A         \22rbit r2, r2          \5Cn\5Ct\22\0A         \22rev  r2, r2          \5Cn\5Ct\22\0A         \22rbit r3, r3          \5Cn\5Ct\22\0A         \22rev  r3, r3          \5Cn\5Ct\22\0A         \22rbit r4, r4          \5Cn\5Ct\22\0A         \22rev  r4, r4          \5Cn\5Ct\22\0A         \22rbit r5, r5          \5Cn\5Ct\22\0A         \22rev  r5, r5          \5Cn\5Ct\22\0A         \22stm  %[p], { r2-r5 } \5Cn\5Ct\22\0A         :\0A         /* Output: 16 bytes of memory pointed to by &x */\0A         \22+m\22 (*(uint8_t(*)[16]) &x)\0A         :\0A         [p] \22r\22 (&x)\0A         :\0A         \22r2\22, \22r3\22, \22r4\22, \22r5\22\0A         );\0A    return x;\0A}\0A\0A#endif /* defined(MBEDTLS_ARCH_IS_ARM32) */\0A\0A#if defined(MBEDTLS_COMPILER_IS_GCC) && __GNUC__ == 5\0A/* Some intrinsics are not available for GCC 5.X. */\0A#define COMMON_MISSING_INTRINSICS\0A#endif /* MBEDTLS_COMPILER_IS_GCC && __GNUC__ == 5 */\0A\0A\0A#if defined(COMMON_MISSING_INTRINSICS)\0A\0A/* Missing intrinsics common to both GCC 5, and Clang on 32-bit */\0A\0A#define vreinterpretq_p64_u8(a)  ((poly64x2_t) a)\0A#define vreinterpretq_u8_p128(a) ((uint8x16_t) a)\0A\0Astatic inline poly64x1_t vget_low_p64(poly64x2_t a)\0A{\0A    uint64x1_t r = vget_low_u64(vreinterpretq_u64_p64(a));\0A    return (poly64x1_t) r;\0A\0A}\0A\0A#endif /* COMMON_MISSING_INTRINSICS */\0A\0A/* vmull_p64/vmull_high_p64 wrappers.\0A *\0A * Older compilers miss some intrinsic functions for `poly*_t`. We use\0A * uint8x16_t and uint8x16x3_t as input/output parameters.\0A */\0A#if defined(MBEDTLS_COMPILER_IS_GCC)\0A/* GCC reports incompatible type error without cast. GCC think poly64_t and\0A * poly64x1_t are different, that is different with MSVC and Clang. */\0A#define MBEDTLS_VMULL_P64(a, b) vmull_p64((poly64_t) a, (poly64_t) b)\0A#else\0A/* MSVC reports `error C2440: 'type cast'` with cast. Clang does not report\0A * error with/without cast. And I think poly64_t and poly64x1_t are same, no\0A * cast for clang also. */\0A#define MBEDTLS_VMULL_P64(a, b) vmull_p64(a, b)\0A#endif /* MBEDTLS_COMPILER_IS_GCC */\0A\0Astatic inline uint8x16_t pmull_low(uint8x16_t a, uint8x16_t b)\0A{\0A\0A    return vreinterpretq_u8_p128(\0A        MBEDTLS_VMULL_P64(\0A            (poly64_t) vget_low_p64(vreinterpretq_p64_u8(a)),\0A            (poly64_t) vget_low_p64(vreinterpretq_p64_u8(b))\0A            ));\0A}\0A\0Astatic inline uint8x16_t pmull_high(uint8x16_t a, uint8x16_t b)\0A{\0A    return vreinterpretq_u8_p128(\0A        vmull_high_p64(vreinterpretq_p64_u8(a),\0A                       vreinterpretq_p64_u8(b)));\0A}\0A\0A/* GHASH does 128b polynomial multiplication on block in GF(2^128) defined by\0A * `x^128 + x^7 + x^2 + x + 1`.\0A *\0A * Arm64 only has 64b->128b polynomial multipliers, we need to do 4 64b\0A * multiplies to generate a 128b.\0A *\0A * `poly_mult_128` executes polynomial multiplication and outputs 256b that\0A * represented by 3 128b due to code size optimization.\0A *\0A * Output layout:\0A * |            |             |             |\0A * |------------|-------------|-------------|\0A * | ret.val[0] | h3:h2:00:00 | high   128b |\0A * | ret.val[1] |   :m2:m1:00 | middle 128b |\0A * | ret.val[2] |   :  :l1:l0 | low    128b |\0A */\0Astatic inline uint8x16x3_t poly_mult_128(uint8x16_t a, uint8x16_t b)\0A{\0A    uint8x16x3_t ret;\0A    uint8x16_t h, m, l; /* retval high/middle/low */\0A    uint8x16_t c, d, e;\0A\0A    h = pmull_high(a, b);                       /* h3:h2:00:00 = a1*b1 */\0A    l = pmull_low(a, b);                        /*   :  :l1:l0 = a0*b0 */\0A    c = vextq_u8(b, b, 8);                      /*      :c1:c0 = b0:b1 */\0A    d = pmull_high(a, c);                       /*   :d2:d1:00 = a1*b0 */\0A    e = pmull_low(a, c);                        /*   :e2:e1:00 = a0*b1 */\0A    m = veorq_u8(d, e);                         /*   :m2:m1:00 = d + e */\0A\0A    ret.val[0] = h;\0A    ret.val[1] = m;\0A    ret.val[2] = l;\0A    return ret;\0A}\0A\0A/*\0A * Modulo reduction.\0A *\0A * See: https://www.researchgate.net/publication/285612706_Implementing_GCM_on_ARMv8\0A *\0A * Section 4.3\0A *\0A * Modular reduction is slightly more complex. Write the GCM modulus as f(z) =\0A * z^128 +r(z), where r(z) = z^7+z^2+z+ 1. The well known approach is to\0A * consider that z^128 ≡r(z) (mod z^128 +r(z)), allowing us to write the 256-bit\0A * operand to be reduced as a(z) = h(z)z^128 +l(z)≡h(z)r(z) + l(z). That is, we\0A * simply multiply the higher part of the operand by r(z) and add it to l(z). If\0A * the result is still larger than 128 bits, we reduce again.\0A */\0Astatic inline uint8x16_t poly_mult_reduce(uint8x16x3_t input)\0A{\0A    uint8x16_t const ZERO = vdupq_n_u8(0);\0A\0A    uint64x2_t r = vreinterpretq_u64_u8(vdupq_n_u8(0x87));\0A#if defined(__GNUC__)\0A    /* use 'asm' as an optimisation barrier to prevent loading MODULO from\0A     * memory. It is for GNUC compatible compilers.\0A     */\0A    asm volatile (\22\22 : \22+w\22 (r));\0A#endif\0A    uint8x16_t const MODULO = vreinterpretq_u8_u64(vshrq_n_u64(r, 64 - 8));\0A    uint8x16_t h, m, l; /* input high/middle/low 128b */\0A    uint8x16_t c, d, e, f, g, n, o;\0A    h = input.val[0];            /* h3:h2:00:00                          */\0A    m = input.val[1];            /*   :m2:m1:00                          */\0A    l = input.val[2];            /*   :  :l1:l0                          */\0A    c = pmull_high(h, MODULO);   /*   :c2:c1:00 = reduction of h3        */\0A    d = pmull_low(h, MODULO);    /*   :  :d1:d0 = reduction of h2        */\0A    e = veorq_u8(c, m);          /*   :e2:e1:00 = m2:m1:00 + c2:c1:00    */\0A    f = pmull_high(e, MODULO);   /*   :  :f1:f0 = reduction of e2        */\0A    g = vextq_u8(ZERO, e, 8);    /*   :  :g1:00 = e1:00                  */\0A    n = veorq_u8(d, l);          /*   :  :n1:n0 = d1:d0 + l1:l0          */\0A    o = veorq_u8(n, f);          /*       o1:o0 = f1:f0 + n1:n0          */\0A    return veorq_u8(o, g);       /*             = o1:o0 + g1:00          */\0A}\0A\0A/*\0A * GCM multiplication: c = a times b in GF(2^128)\0A */\0Avoid mbedtls_aesce_gcm_mult(unsigned char c[16],\0A                            const unsigned char a[16],\0A                            const unsigned char b[16])\0A{\0A    uint8x16_t va, vb, vc;\0A    va = vrbitq_u8(vld1q_u8(&a[0]));\0A    vb = vrbitq_u8(vld1q_u8(&b[0]));\0A    vc = vrbitq_u8(poly_mult_reduce(poly_mult_128(va, vb)));\0A    vst1q_u8(&c[0], vc);\0A}\0A\0A#endif /* MBEDTLS_GCM_C */\0A\0A#if defined(MBEDTLS_POP_TARGET_PRAGMA)\0A#if defined(__clang__)\0A#pragma clang attribute pop\0A#elif defined(__GNUC__)\0A#pragma GCC pop_options\0A#endif\0A#undef MBEDTLS_POP_TARGET_PRAGMA\0A#endif\0A\0A#endif /* MBEDTLS_AESCE_HAVE_CODE */\0A\0A#endif /* MBEDTLS_AESCE_C */\0A\00" }
