s_rsa_context *rsa, const unsigned char *key, size_t keylen);\0A\0A/**\0A * \5Cbrief           Write a PKCS#1 (ASN.1) encoded private RSA key.\0A *\0A * \5Cparam rsa       The RSA context which contains the data to be written.\0A * \5Cparam start     Beginning of the buffer that will be filled with the\0A *                  private key.\0A * \5Cparam p         End of the buffer that will be filled with the private key.\0A *                  On successful return, the referenced pointer will be\0A *                  updated in order to point to the beginning of written data.\0A *\0A * \5Creturn          On success, the number of bytes written to the output buffer\0A *                  (i.e. a value > 0).\0A * \5Creturn          MBEDTLS_ERR_RSA_BAD_INPUT_DATA if the RSA context does not\0A *                  contain a valid key pair.\0A * \5Creturn          MBEDTLS_ERR_ASN1_xxx in case of failure while writing to the\0A *                  output buffer.\0A *\0A * \5Cnote            The output buffer is filled backward, i.e. starting from its\0A *                  end and moving toward its start.\0A */\0Aint mbedtls_rsa_write_key(const mbedtls_rsa_context *rsa, unsigned char *start,\0A                          unsigned char **p);\0A\0A/**\0A * \5Cbrief           Parse a PKCS#1 (ASN.1) encoded public RSA key.\0A *\0A * \5Cparam rsa       The RSA context which contains the data to be written.\0A * \5Cparam start     Beginning of the buffer that will be filled with the\0A *                  private key.\0A * \5Cparam p         End of the buffer that will be filled with the private key.\0A *                  On successful return, the referenced pointer will be\0A *                  updated in order to point to the beginning of written data.\0A *\0A * \5Creturn          On success, the number of bytes written to the output buffer\0A *                  (i.e. a value > 0).\0A * \5Creturn          MBEDTLS_ERR_RSA_BAD_INPUT_DATA if the RSA context does not\0A *                  