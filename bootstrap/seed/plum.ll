ren (issue #7) ---\0A//\0A// `process_run` blocks, which is the right shape for a compiler\0A// shelling out to `clang` and the wrong one for an application that\0A// wants to stay responsive while something runs. These add the other\0A// shape: start it, look in on it, stop it.\0A//\0A// The temp-file capture is what makes this cheap. A pipe-based child\0A// would need somebody draining it the whole time the child runs -- the\0A// deadlock this file's header describes -- so `poll` could not be a\0A// question you ask occasionally. A file has no fixed buffer, so nothing\0A// has to be read until the child is gone, and `poll` really is just\0A// `waitpid(WNOHANG)`.\0A//\0A// **The status is collected exactly once.** The transition from running\0A// to finished reads both files, deletes them, and fills the same\0A// `out_data`/`err_data` the blocking path fills -- so\0A// `process_exit_code`, `process_stdout_data` and `process_stderr_data`\0A// work unchanged afterwards, and work repeatedly. There is deliberately\0A// no way to read a child's output before it exits: that would mean\0A// defining what a partial read of a file somebody is still writing\0A// means, and no caller has asked for it.\0A\0Astatic void plum_child_collect(long long handle, long long code, int capture) {\0A    PlumProcessSlot *slot = &plum_process_slots[handle];\0A    PlumChildState *c = slot->child;\0A    if (c == NULL || c->finished) return;\0A    slot->exit_code = code;\0A#if defined(_WIN32)\0A    // Closed only now, so everything the child wrote is flushed before\0A    // the files are read back -- the same ordering the blocking path\0A    // depends on.\0A    if (c->h_out != NULL) CloseHandle((HANDLE)c->h_out);\0A    if (c->h_err != NULL) CloseHandle((HANDLE)c->h_err);\0A    c->h_out = NULL;\0A    c->h_err = NULL;\0A    if (c->pid != 0) CloseHandle((HANDLE)(intptr_t)c->pid);\0A    c->pid = 0;\0A#endif\0A    if (capture) plum_process_capture(slot, c->out_path, c->err_path);\0A    if (c->out_path != NULL) plum_capture_remove(c->out_path);\0A    if (c->err_path != NULL) plum_capture_remove(c->err_path);\0A    if (c->in_path != NULL) plum_capture_remove(c->in_path);\0A    c->finished = 1;\0A}\0A\0A#if defined(_WIN32)\0Astatic long long plum_win_child_collect(long long handle) {\0A    HANDLE process = (HANDLE)(intptr_t)plum_process_slots[handle].child->pid;\0A    long long code = plum_win_exit_code(process);\0A    if (code == PLUM_SPAWN_FAILED) return -1;\0A    plum_child_collect(handle, code, 1);\0A    return 1;\0A}\0A#endif\0A\0Astatic PlumProcessSlot *plum_slot_of(long long handle) {\0A    if (handle < 0 || handle >= PLUM_PROC_MAX_SLOTS || !plum_process_slots[handle].in_use) {\0A        return NULL;\0A    }\0A    return &plum_process_slots[handle];\0A}\0A\0A// Starts `program` without waiting for it. Same argument, environment\0A// and stdin packing as `process_run_ex`; same -1 for a child that could\0A// not be started at all, including a program that does not exist.\0Astatic long long process_spawn_locked(long long slot, const char *program, const char *args_joined, long long argc,\0A                        const char *env_joined, long long envc,\0A                        const char *stdin_data, long long stdin_len, long long has_stdin) {\0A    char *args_copy = NULL;\0A    char **argv = plum_split_args(program, args_joined, argc, &args_copy);\0A    if (argv == NULL) return -1;\0A    char *env_copy = NULL;\0A    char **envp = plum_split_joined(env_joined, envc, &env_copy);\0A    if (envc > 0 && envp == NULL) {\0A        free(args_copy);\0A        free(argv);\0A        return -1;\0A    }\0A\0A    PlumChildState *child = calloc(1, sizeof(PlumChildState));\0A    if (child == NULL) {\0A        free(args_copy); free(argv); free(env_copy); free(envp);\0A        return -1;\0A    }\0A\0A    char out_path[PLUM_PROC_PATH_MAX];\0A    char err_path[PLUM_PROC_PATH_MAX];\0A    int stdin_mode = has_stdin ? 1 : 0;\0A    long long rc = plum_spawn_capture(program, argv, out_path, err_path, envp,\0A                                      stdin_data, stdin_len, stdin_mode, 1, child);\0A    free(args_copy); free(argv); free(env_copy); free(envp);\0A    if (rc == PLUM_SPAWN_FAILED) {\0A        free(child->in_path);\0A        free(child);\0A        return -1;\0A    }\0A\0A    child->out_path = plum_strdup_or_null(out_path);\0A    child->err_path = plum_strdup_or_null(err_path);\0A    plum_process_slots[slot].in_use = 1;\0A    plum_process_slots[slot].exit_code = -1;\0A    plum_process_slots[slot].out_data = NULL;\0A    plum_process_slots[slot].err_data = NULL;\0A    plum_process_slots[slot].out_length = plum_process_slots[slot].err_length = 0;\0A    plum_process_slots[slot].capture_failed = 0;\0A    plum_process_slots[slot].child = child;\0A    if (child->out_path == NULL || child->err_path == NULL) {\0A        // Tracking allocation failed after launch. Reap without reading,\0A        // then use the stack paths to delete even an untracked capture.\0A        process_child_free_locked(slot);\0A        plum_capture_remove(out_path);\0A        plum_capture_remove(err_path);\0A        return -1;\0A    }\0A    return slot;\0A}\0A\0A// 1 if the child has exited (its result is now readable), 0 if it is\0A// still running, -1 if the handle is not a live child.\0Astatic long long process_poll_locked(long long handle) {\0A    PlumProcessSlot *slot = plum_slot_of(handle);\0A    if (slot == NULL || slot->child == NULL) return -1;\0A    if (slot->child->finished) return 1;\0A#if defined(_WIN32)\0A    HANDLE h = (HANDLE)(intptr_t)slot->child->pid;\0A    DWORD w = WaitForSingleObject(h, 0);\0A    if (w == WAIT_TIMEOUT) return 0;\0A    if (w != WAIT_OBJECT_0) return -1;\0A    return plum_win_child_collect(handle);\0A#else\0A    int status = 0;\0A    pid_t r;\0A    do { r = waitpid((pid_t)slot->child->pid, &status, WNOHANG); } while (r < 0 && errno == EINTR);\0A    if (r == 0) return 0;\0A    if (r < 0) return -1;\0A    plum_child_collect(handle, WIFEXITED(status) ? (long long)WEXITSTATUS(status) : -1, 1);\0A    return 1;\0A#endif\0A}\0A\0A// Waits for the child. A negative `timeout_nanos` waits forever.\0A// Returns 1 if it exited, 0 if the timeout expired first, -1 on error.\0A//\0A// POSIX waits poll with a capped 1–20ms backoff, releasing the slot lock\0A// between checks. Windows waits pin the OS process with a duplicate handle.\0A// Neither strategy blocks termination or unrelated process operations.\0Along long process_child_wait(long long handle, long long timeout_nanos) {\0A#if defined(_WIN32)\0A    PlumProcessSlot *slot = plum_process_lock(handle);\0A    if (slot == NULL) return -1;\0A    if (slot->child == NULL || slot->child->finished) {\0A        long long result = slot->child == NULL ? -1 : 1;\0A        pthread_mutex_unlock(&slot->lock);\0A        return result;\0A    }\0A    // A duplicate pins the OS object while another task terminates or frees\0A    // the slot. Revalidate the identity before publishing the result.\0A    HANDLE process = NULL;\0A    int duplicated = DuplicateHandle(GetCurrentProcess(), (HANDLE)(intptr_t)slot->child->pid,\0A        GetCurrentProcess(), &process, 0, FALSE, DUPLICATE_SAME_ACCESS);\0A    pthread_mutex_unlock(&slot->lock);\0A    if (!duplicated) return -1;\0A    long long ms = timeout_nanos < 0 ? -1 : timeout_nanos / 1000000LL;\0A    if (timeout_nanos > 0 && timeout_nanos % 1000000LL != 0) ms++;\0A    long long result;\0A    for (;;) {\0A        DWORD chunk = ms < 0 ? INFINITE : ms > 0x7FFFFFFELL ? 0x7FFFFFFE : (DWORD)ms;\0A        DWORD w = WaitForSingleObject(process, chunk);\0A        if (w == WAIT_OBJECT_0) { result = 1; break; }\0A        if (w != WAIT_TIMEOUT) { result = -1; break; }\0A        ms -= chunk;\0A        if (ms == 0) { result = 0; break; }\0A    }\0A    CloseHandle(process);\0A    slot = plum_process_lock(handle);\0A    if (slot == NULL) return -1;\0A    if (slot->child->finished) result = 1;\0A    else if (result == 1) result = plum_win_child_collect((handle - 1) % PLUM_PROC_MAX_SLOTS);\0A    pthread_mutex_unlock(&slot->lock);\0A    return result;\0A#else\0A    // A blocking waitpid under the slot lock would prevent terminate/drop.\0A    // Poll and reap under that lock instead, so concurrent waiters cannot reap\0A    // twice or signal a PID between reaping it and recording completion.\0A    long long waited = 0, step = 1000000LL;\0A    for (;;) {\0A        PlumProcessSlot *slot = plum_process_lock(handle);\0A        if (slot == NULL) return -1;\0A        long long result = process_poll_locked((handle - 1) % PLUM_PROC_MAX_SLOTS);\0A        pthread_mutex_unlock(&slot->lock);\0A        if (result != 0) return result;\0A        if (timeout_nanos >= 0 && waited >= timeout_nanos) return 0;\0A        long long nap = step;\0A        if (timeout_nanos >= 0 && nap > timeout_nanos - waited) nap = timeout_nanos - waited;\0A        struct timespec req = { (time_t)(nap / 1000000000LL), (long)(nap % 1000000000LL) };\0A        while (nanosleep(&req, &req) != 0 && errno == EINTR) { }\0A        if (timeout_nanos >= 0) waited += nap;\0A        if (step < 20000000LL) step *= 2;\0A        if (step > 20000000LL) step = 20000000LL;\0A    }\0A#endif\0A}\0A\0A// Asks the child to stop. `hard` of 0 is a polite request the child can\0A// handle or ignore (SIGTERM, and on Windows the only thing there is);\0A// non-zero cannot be refused (SIGKILL, `TerminateProcess`).\0A//\0A// Windows has no SIGTERM, so both spellings are `TerminateProcess` --\0A// a real difference, documented rather than papered over: a program\0A// that relies on a child cleaning up after a polite terminate will not\0A// get that on Windows.\0A//\0A// Returns 0 on success, -1 if the handle is not a live child. Signalling\0A// a child that has ALREADY exited is success, not failure: the caller\0A// asked for it to be gone and it is.\0Astatic long long process_terminate_locked(long long handle, long long hard) {\0A    PlumProcessSlot *slot = plum_slot_of(handle);\0A    if (slot == NULL || slot->child == NULL) return -1;\0A    if (slot->child->finished) return 0;\0A#if defined(_WIN32)\0A    (void)hard;\0A    return TerminateProcess((HANDLE)(intptr_t)slot->child->pid, 1) ? 0 : -1;\0A#else\0A    return kill((pid_t)slot->child->pid, hard ? SIGKILL : SIGTERM) == 0 ? 0 : -1;\0A#endif\0A}\0A\0A// The operating system's identifier for the child, for a caller that\0A// has to report it or hand it to something else. Windows reports the\0A// process id rather than the handle, which is what a user would\0A// recognise in Task Manager.\0Astatic long long process_child_pid_locked(long long handle) {\0A    PlumProcessSlot *slot = plum_slot_of(handle);\0A    if (slot == NULL || slot->child == NULL) return -1;\0A#if defined(_WIN32)\0A    if (slot->child->pid == 0) return -1;\0A    return (long long)GetProcessId((HANDLE)(intptr_t)slot->child->pid);\0A#else\0A    return slot->child->pid;\0A#endif\0A}\0A\0A// Releases the slot, and is what the `Child` handle runs when the value\0A// dies.\0A//\0A// A child still running is KILLED and reaped. The alternative -- leave\0A// it alive -- sounds gentler and is not: nothing can reach that process\0A// again, since the value that could poll it, wait for it, signal it or\0A// read its output has just been destroyed. It would also leak the\0A// temp files it is still writing to, and on POSIX leave a zombie until\0A// this program exits, because the only process that could reap it has\0A// stopped tracking it.\0A//\0A// `drop_policy` is where a future choice would live. It is not settable\0A// from Plum today.\0Astatic void process_child_free_locked(long long handle) {\0A    PlumProcessSlot *slot = plum_slot_of(handle);\0A    if (slot == NULL) return;\0A    PlumChildState *c = slot->child;\0A    if (c != NULL) {\0A        if (!c->finished) {\0A            (void)process_terminate_locked(handle, 1);\0A#if defined(_WIN32)\0A            HANDLE h = (HANDLE)(intptr_t)c->pid;\0A            WaitForSingleObject(h, 5000);\0A            // Drop discards the status and output. A status-query failure\0A            // must not obstruct resource cleanup or fabricate a result.\0A            plum_child_collect(handle, -1, 0);\0A#else\0A            int status = 0;\0A            pid_t r;\0A            do { r = waitpid((pid_t)c->pid, &status, 0); } while (r < 0 && errno == EINTR);\0A            plum_child_collect(handle, (r > 0 && WIFEXITED(status)) ? (long long)WEXITSTATUS(status) : -1, 0);\0A#endif\0A        }\0A        free(c->out_path);\0A        free(c->err_path);\0A        free(c->in_path);\0A        free(c);\0A        slot->child = NULL;\0A    }\0A    free(slot->out_data);\0A    free(slot->err_data);\0A    slot->out_data = NULL;\0A    slot->err_data = NULL;\0A    slot->out_length = slot->err_length = 0;\0A    slot->capture_failed = 0;\0A    slot->in_use = 0;\0A}\0A\0A// The ABI boundary owns identity validation and locking. Internal helpers use\0A// indices only while the corresponding slot is locked.\0A#define PLUM_PROCESS_ACCESSOR(type, name, invalid) \5C\0A    type name(long long handle) { \5C\0A        PlumProcessSlot *slot = plum_process_lock(handle); \5C\0A        if (slot == NULL) return invalid; \5C\0A        type result = name##_locked((handle - 1) % PLUM_PROC_MAX_SLOTS); \5C\0A        pthread_mutex_unlock(&slot->lock); \5C\0A        return result; \5C\0A    }\0APLUM_PROCESS_ACCESSOR(long long, process_exit_code, -1)\0APLUM_PROCESS_ACCESSOR(const char *, process_stdout_data, \22\22)\0APLUM_PROCESS_ACCESSOR(const char *, process_stderr_data, \22\22)\0APLUM_PROCESS_ACCESSOR(long long, process_capture_status, -1)\0APLUM_PROCESS_ACCESSOR(long long, process_stdout_length, 0)\0APLUM_PROCESS_ACCESSOR(long long, process_stderr_length, 0)\0APLUM_PROCESS_ACCESSOR(long long, process_poll, -1)\0APLUM_PROCESS_ACCESSOR(long long, process_child_pid, -1)\0A#undef PLUM_PROCESS_ACCESSOR\0A\0Along long process_terminate(long long handle, long long hard) {\0A    PlumProcessSlot *slot = plum_process_lock(handle);\0A    if (slot == NULL) return -1;\0A    long long result = process_terminate_locked((handle - 1) % PLUM_PROC_MAX_SLOTS, hard);\0A    pthread_mutex_unlock(&slot->lock);\0A    return result;\0A}\0A\0Avoid process_child_free(long long handle) {\0A    PlumProcessSlot *slot = plum_process_lock(handle);\0A    if (slot == NULL) return;\0A    process_free_locked((handle - 1) % PLUM_PROC_MAX_SLOTS);\0A    plum_process_available(slot);\0A    pthread_mutex_unlock(&slot->lock);\0A}\0Avoid process_free(long long handle) { process_child_free(handle); }\0A\0A// Finish a reserved launch. Failed launches release the reservation; successful\0A// launches publish the complete state before exposing its identity to callers.\0Astatic long long plum_process_publish(long long index, long long result) {\0A    PlumProcessSlot *slot = &plum_process_slots[index];\0A    if (result < 0) plum_process_available(slot);\0A    long long handle = result < 0 ? -1 : slot->identity;\0A    pthread_mutex_unlock(&slot->lock);\0A    return handle;\0A}\0A\0Along long process_run(const char *program, const char *args, long long argc) {\0A    long long index = plum_process_reserve();\0A    if (index < 0) return -1;\0A    return plum_process_publish(index, process_run_locked(index, program, args, argc));\0A}\0Along long process_run_ex(const char *program, const char *args, long long argc,\0A                         const char *env, long long envc,\0A                         const char *input, long long length, long long has_input) {\0A    long long index = plum_process_reserve();\0A    if (index < 0) return -1;\0A    return plum_process_publish(index, process_run_ex_locked(index, program, args, argc,\0A        env, envc, input, length, has_input));\0A}\0Along long process_spawn(const char *program, const char *args, long long argc,\0A                        const char *env, long long envc,\0A                        const char *input, long long length, long long has_input) {\0A    long long index = plum_process_reserve();\0A    if (index < 0) return -1;\0A    return plum_process_publish(index, process_spawn_locked(index, program, args, argc,\0A        env, envc, input, length, has_input));\0A}\0A\0A// The inherited-stdio counterpart to `plum_spawn_capture`, and the\0A// second place this file needs a platform split. It was missed when the\0A// first one was written -- the POSIX `fork`/`waitpid` here sat outside\0A// any guard and was found by the Windows CI leg, which is what that leg\0A// is for.\0A#if !defined(_WIN32)\0A\0Astatic long long plum_spawn_inherit(const char *program, char **argv) {\0A    pid_t pid = fork();\0A    if (pid < 0) return -1;\0A    if (pid == 0) {\0A        execvp(program, argv);\0A        _exit(127);\0A    }\0A    int status = 0;\0A    if (waitpid(pid, &status, 0) < 0) return -1;\0A    if (WIFEXITED(status)) return WEXITSTATUS(status);\0A    // 128 + signal is the shell convention, kept so `plum run` reports\0A    // a killed child the way anything else in a pipeline would.\0A    if (WIFSIGNALED(status)) return 128 + WTERMSIG(status);\0A    return -1;\0A}\0A\0A#else\0A\0Astatic long long plum_spawn_inherit(const char *program, char **argv) {\0A    wchar_t *cmdline = plum_win_command_line(argv);\0A    STARTUPINFOW si;\0A    PROCESS_INFORMATION pi;\0A    if (cmdline == NULL) return -1;\0A\0A    // No `STARTF_USESTDHANDLES`: leaving the field unset is what makes\0A    // the child inherit this process's console, which is the entire\0A    // point of this function as against `plum_spawn_capture`.\0A    ZeroMemory(&si, sizeof(si));\0A    si.cb = sizeof(si);\0A    ZeroMemory(&pi, sizeof(pi));\0A\0A    if (!CreateProcessW(NULL, cmdline, NULL, NULL, TRUE, 0, NULL, NULL, &si, &pi)) {\0A        free(cmdline);\0A        return -1;\0A    }\0A    free(cmdline);\0A    CloseHandle(pi.hThread);\0A\0A    long long code = WaitForSingleObject(pi.hProcess, INFINITE) == WAIT_OBJECT_0 ?\0A        plum_win_exit_code(pi.hProcess) : PLUM_SPAWN_FAILED;\0A    CloseHandle(pi.hProcess);\0A    (void)program;\0A    return code == PLUM_SPAWN_FAILED ? -1 : code;\0A}\0A\0A#endif\0A\0A// Runs a command with stdio INHERITED — no capture, no temp files — and\0A// returns its exit status. `process_run` above is for a caller that\0A// wants the output as a value; this is for a caller that wants the\0A// child to simply BE the program: `plum run` streaming its output as it\0A// happens, and a child that can read stdin.\0A//\0A// Deliberately separate rather than a flag on `process_run`: that one's\0A// whole design is the temp-file capture described above, and threading\0A// \22except don't\22 through it would leave every path harder to read.\0Along long process_run_inherit(const char *program, const char *args_joined, long long argc) {\0A    char *args_copy = strdup(args_joined);\0A    char **argv = malloc(sizeof(char *) * (size_t)(argc + 2));\0A    if (args_copy == NULL || argv == NULL) {\0A        free(args_copy);\0A        free(argv);\0A        return -1;\0A    }\0A    // Same separator-splitting as `process_run` above; see its own note\0A    // on why the first element is special-cased.\0A    argv[0] = (char *)program;\0A    long long idx = 1;\0A    if (argc > 0) {\0A        argv[idx++] = args_copy;\0A        for (char *c = args_copy; *c != '\5C0'; c++) {\0A            if (*c == PLUM_PROC_ARG_SEP) {\0A                *c = '\5C0';\0A                if (idx <= argc) {\0A                    argv[idx++] = c + 1;\0A                }\0A            }\0A        }\0A    }\0A    argv[idx] = NULL;\0A\0A    long long code = plum_spawn_inherit(program, argv);\0A    free(args_copy);\0A    free(argv);\0A    return code;\0A}\0A\00" }
