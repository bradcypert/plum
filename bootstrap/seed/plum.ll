ed long long int)];\0A    unsigned char buf1[2 * sizeof(unsigned long long int)];\0A\0A    if (verbose != 0) {\0A        mbedtls_printf(\22  ENTROPY_BIAS test: \22);\0A    }\0A\0A    memset(buf0, 0x00, sizeof(buf0));\0A    memset(buf1, 0x00, sizeof(buf1));\0A\0A    if ((ret = mbedtls_entropy_source_self_test_gather(buf0, sizeof(buf0))) != 0) {\0A        goto cleanup;\0A    }\0A    if ((ret = mbedtls_entropy_source_self_test_gather(buf1, sizeof(buf1))) != 0) {\0A        goto cleanup;\0A    }\0A\0A    /* Make sure that the returned values are not all 0 or 1 */\0A    if ((ret = mbedtls_entropy_source_self_test_check_bits(buf0, sizeof(buf0))) != 0) {\0A        goto cleanup;\0A    }\0A    if ((ret = mbedtls_entropy_source_self_test_check_bits(buf1, sizeof(buf1))) != 0) {\0A        goto cleanup;\0A    }\0A\0A    /* Make sure that the entropy source is not returning values in a\0A     * pattern */\0A    ret = memcmp(buf0, buf1, sizeof(buf0)) == 0;\0A\0Acleanup:\0A    if (verbose != 0) {\0A        if (ret != 0) {\0A            mbedtls_printf(\22failed\5Cn\22);\0A        } else {\0A            mbedtls_printf(\22passed\5Cn\22);\0A        }\0A\0A        mbedtls_printf(\22\5Cn\22);\0A    }\0A\0A    return ret != 0;\0A}\0A\0A#endif /* MBEDTLS_ENTROPY_HARDWARE_ALT */\0A\0A/*\0A * The actual entropy quality is hard to test, but we can at least\0A * test that the functions don't cause errors and write the correct\0A * amount of data to buffers.\0A */\0Aint mbedtls_entropy_self_test(int verbose)\0A{\0A    int ret = 1;\0A    mbedtls_entropy_context ctx;\0A    unsigned char buf[MBEDTLS_ENTROPY_BLOCK_SIZE] = { 0 };\0A    unsigned char acc[MBEDTLS_ENTROPY_BLOCK_SIZE] = { 0 };\0A    size_t i, j;\0A\0A    if (verbose != 0) {\0A        mbedtls_printf(\22  ENTROPY test: \22);\0A    }\0A\0A    mbedtls_entropy_init(&ctx);\0A\0A    /* First do a gather to make sure we have default sources */\0A    if ((ret = mbedtls_entropy_gather(&ctx)) != 0) {\0A        goto cleanup;\0A    }\0A\0A    ret = m