define i1 @plum_eq_Result_Unit_Str(ptr %a, ptr %b) {
entry:
  %tap = getelementptr i8, ptr %a, i64 8
  %ta = load i64, ptr %tap
  %tbp = getelementptr i8, ptr %b, i64 8
  %tb = load i64, ptr %tbp
  %same = icmp eq i64 %ta, %tb
  br i1 %same, label %payload, label %no
payload:
  switch i64 %ta, label %yes [
    i64 2, label %V2
    i64 3, label %V3
  ]
V2:
  %t0 = getelementptr i8, ptr %a, i64 16
  %t1 = getelementptr i8, ptr %b, i64 16
  %t2 = load i1, ptr %t0
  %t3 = load i1, ptr %t1
