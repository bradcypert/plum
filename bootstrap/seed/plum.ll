al copy but nothing to copy back to. */\0A        return PSA_ERROR_CORRUPTION_DETECTED;\0A    }\0A\0A    status = psa_crypto_copy_output(local_output->buffer, local_output->length,\0A                                    local_output->original, local_output->length);\0A    if (status != PSA_SUCCESS) {\0A        return status;\0A    }\0A\0A    mbedtls_zeroize_and_free(local_output->buffer, local_output->length);\0A    local_output->buffer = NULL;\0A    local_output->length = 0;\0A\0A    return PSA_SUCCESS;\0A}\0A\0A#endif /* MBEDTLS_PSA_CRYPTO_C */\0A\00" }
