@.str40660 = private global { i64, i64, [22239 x i8] } { i64 -1, i64 22238, [22239 x i8] c"/*\0A *  FIPS-202 compliant SHA3 implementation\0A *\0A *  Copyright The Mbed TLS Contributors\0A *  SPDX-License-Identifier: Apache-2.0 OR GPL-2.0-or-later\0A */\0A/*\0A *  The SHA-3 Secure Hash Standard was published by NIST in 2015.\0A *\0A *  https://nvlpubs.nist.gov/nistpubs/fips/nist.fips.202.pdf\0A */\0A\0A#include \22common.h\22\0A\0A#if defined(MBEDTLS_SHA3_C)\0A\0A/*\0A * These macros select manually unrolled implementations of parts of the main permutation function.\0A *\0A * Unrolling has a major impact on both performance and code size. gcc performance benefits a lot\0A * from manually unrolling at higher optimisation levels.\0A *\0A * Depending on your size/perf priorities, compiler and target, it may be beneficial to adjust\0A * these; the defaults here should give sensible trade-offs for gcc and clang on aarch64 and\0A * x86-64.\0A */\0A#if !defined(MBEDTLS_SHA3_THETA_UNROLL)\0A    #define MBEDTLS_SHA3_THETA_UNROLL 0 //no-check-names\0A#endif\0A#if !defined(MBEDTLS_SHA3_CHI_UNROLL)\0A    #if defined(__OPTIMIZE_SIZE__)\0A        #define MBEDTLS_SHA3_CHI_UNROLL 0 //no-check-names\0A    #else\0A        #define MBEDTLS_SHA3_CHI_UNROLL 1 //no-check-names\0A    #endif\0A#endif\0A#if !defined(MBEDTLS_SHA3_PI_UNROLL)\0A    #define MBEDTLS_SHA3_PI_UNROLL 1 //no-check-names\0A#endif\0A#if !defined(MBEDTLS_SHA3_RHO_UNROLL)\0A    #define MBEDTLS_SHA3_RHO_UNROLL 1 //no-check-names\0A#endif\0A\0A#include \22mbedtls/sha3.h\22\0A#include \22mbedtls/platform_util.h\22\0A#include \22mbedtls/error.h\22\0A\0A#include <string.h>\0A\0A#if defined(MBEDTLS_SELF_TEST)\0A#include \22mbedtls/platform.h\22\0A#endif /* MBEDTLS_SELF_TEST */\0A\0A#define XOR_BYTE 0x6\0A\0A/* Precomputed masks for the iota transform.\0A *\0A * Each round uses a 64-bit mask value. In each mask values, only\0A * bits whose position is of the form 2^k-1 can be set, thus only\0A * 7 of 64 bits of the mask need to be known for each mask value.\0A *\0A * We use a compressed encoding of the mask where bits 63, 31 and 15\0A * are moved to bits 4-6. This allows us to make each mask value\0A * 1 byte rather than 8 bytes, saving 7*24 = 168 bytes of data (with\0A * perhaps a little variation due to alignment). Decompressing this\0A * requires a little code, but much less than the savings on the table.\0A *\0A * The impact on performance depends on the platform and compiler.\0A * There's a bit more computation, but less memory bandwidth. A quick\0A * benchmark on x86_64 shows a 7% speed improvement with GCC and a\0A * 5% speed penalty with Clang, compared to the naive uint64_t[24] table.\0A * YMMV.\0A */\0A/* Helper macro to set the values of the higher bits in unused low positions */\0A#define H(b63, b31, b15) (b63 << 6 | b31 << 5 | b15 << 4)\0Astatic const uint8_t iota_r_packed[24] = {\0A    H(0, 0, 0) | 0x01, H(0, 0, 1) | 0x82, H(1, 0, 1) | 0x8a, H(1, 1, 1) | 0x00,\0A    H(0, 0, 1) | 0x8b, H(0, 1, 0) | 0x01, H(1, 1, 1) | 0x81, H(1, 0, 1) | 0x09,\0A    H(0, 0, 0) | 0x8a, H(0, 0, 0) | 0x88, H(0, 1, 1) | 0x09, H(0, 1, 0) | 0x0a,\0A    H(0, 1, 1) | 0x8b, H(1, 0, 0) | 0x8b, H(1, 0, 1) | 0x89, H(1, 0, 1) | 0x03,\0A    H(1, 0, 1) | 0x02, H(1, 0, 0) | 0x80, H(0, 0, 1) | 0x0a, H(1, 1, 0) | 0x0a,\0A    H(1, 1, 1) | 0x81, H(1, 0, 1) | 0x80, H(0, 1, 0) | 0x01, H(1, 1, 1) | 0x08,\0A};\0A#undef H\0A\0Astatic const uint32_t rho[6] = {\0A    0x3f022425, 0x1c143a09, 0x2c3d3615, 0x27191713, 0x312b382e, 0x3e030832\0A};\0A\0Astatic const uint32_t pi[6] = {\0A    0x110b070a, 0x10050312, 0x04181508, 0x0d13170f, 0x0e14020c, 0x01060916\0A};\0A\0A#define ROTR64(x, y) (((x) << (64U - (y))) | ((x) >> (y))) // 64-bit rotate right\0A#define ABSORB(ctx, idx, v) do { ctx->state[(idx) >> 3] ^= ((uint64_t) (v)) << (((idx) & 0x7) << 3); \5C\0A} while (0)\0A#define SQUEEZE(ctx, idx) ((uint8_t) (ctx->state[(idx) >> 3] >> (((idx) & 0x7) << 3)))\0A#define SWAP(x, y) do { uint64_t tmp = (x); (x) = (y); (y) = tmp; } while (0)\0A\0A/* The permutation function.  */\0Astatic void keccak_f1600(mbedtls_sha3_context *ctx)\0A{\0A    uint64_t lane[5];\0A    uint64_t *s = ctx->state;\0A    int i;\0A\0A    for (int round = 0; round < 24; round++) {\0A        uint64_t t;\0A\0A        /* Theta */\0A#if MBEDTLS_SHA3_THETA_UNROLL == 0 //no-check-names\0A        for (i = 0; i < 5; i++) {\0A            lane[i] = s[i] ^ s[i + 5] ^ s[i + 10] ^ s[i + 15] ^ s[i + 20];\0A        }\0A        for (i = 0; i < 5; i++) {\0A            t = lane[(i + 4) % 5] ^ ROTR64(lane[(i + 1) % 5], 63);\0A            s[i] ^= t; s[i + 5] ^= t; s[i + 10] ^= t; s[i + 15] ^= t; s[i + 20] ^= t;\0A        }\0A#else\0A        lane[0] = s[0] ^ s[5] ^ s[10] ^ s[15] ^ s[20];\0A        lane[1] = s[1] ^ s[6] ^ s[11] ^ s[16] ^ s[21];\0A        lane[2] = s[2] ^ s[7] ^ s[12] ^ s[17] ^ s[22];\0A        lane[3] = s[3] ^ s[8] ^ s[13] ^ s[18] ^ s[23];\0A        lane[4] = s[4] ^ s[9] ^ s[14] ^ s[19] ^ s[24];\0A\0A        t = lane[4] ^ ROTR64(lane[1], 63);\0A        s[0] ^= t; s[5] ^= t; s[10] ^= t; s[15] ^= t; s[20] ^= t;\0A\0A        t = lane[0] ^ ROTR64(lane[2], 63);\0A        s[1] ^= t; s[6] ^= t; s[11] ^= t; s[16] ^= t; s[21] ^= t;\0A\0A        t = lane[1] ^ ROTR64(lane[3], 63);\0A        s[2] ^= t; s[7] ^= t; s[12] ^= t; s[17] ^= t; s[22] ^= t;\0A\0A        t = lane[2] ^ ROTR64(lane[4], 63);\0A        s[3] ^= t; s[8] ^= t; s[13] ^= t; s[18] ^= t; s[23] ^= t;\0A\0A        t = lane[3] ^ ROTR64(lane[0], 63);\0A        s[4] ^= t; s[9] ^= t; s[14] ^= t; s[19] ^= t; s[24] ^= t;\0A#endif\0A\0A        /* Rho */\0A        for (i = 1; i < 25; i += 4) {\0A            uint32_t r = rho[(i - 1) >> 2];\0A#if MBEDTLS_SHA3_RHO_UNROLL == 0\0A            for (int j = i; j < i + 4; j++) {\0A                uint8_t r8 = (uint8_t) (r >> 24);\0A                r <<= 8;\0A                s[j] = ROTR64(s[j], r8);\0A            }\0A#else\0A            s[i + 0] = ROTR64(s[i + 0], MBEDTLS_BYTE_3(r));\0A            s[i + 1] = ROTR64(s[i + 1], MBEDTLS_BYTE_2(r));\0A            s[i + 2] = ROTR64(s[i + 2], MBEDTLS_BYTE_1(r));\0A            s[i + 3] = ROTR64(s[i + 3], MBEDTLS_BYTE_0(r));\0A#endif\0A        }\0A\0A        /* Pi */\0A        t = s[1];\0A#if MBEDTLS_SHA3_PI_UNROLL == 0\0A        for (i = 0; i < 24; i += 4) {\0A            uint32_t p = pi[i >> 2];\0A            for (unsigned j = 0; j < 4; j++) {\0A                SWAP(s[p & 0xff], t);\0A                p >>= 8;\0A            }\0A        }\0A#else\0A        uint32_t p = pi[0];\0A        SWAP(s[MBEDTLS_BYTE_0(p)], t); SWAP(s[MBEDTLS_BYTE_1(p)], t);\0A        SWAP(s[MBEDTLS_BYTE_2(p)], t); SWAP(s[MBEDTLS_BYTE_3(p)], t);\0A        p = pi[1];\0A        SWAP(s[MBEDTLS_BYTE_0(p)], t); SWAP(s[MBEDTLS_BYTE_1(p)], t);\0A        SWAP(s[MBEDTLS_BYTE_2(p)], t); SWAP(s[MBEDTLS_BYTE_3(p)], t);\0A        p = pi[2];\0A        SWAP(s[MBEDTLS_BYTE_0(p)], t); SWAP(s[MBEDTLS_BYTE_1(p)], t);\0A        SWAP(s[MBEDTLS_BYTE_2(p)], t); SWAP(s[MBEDTLS_BYTE_3(p)], t);\0A        p = pi[3];\0A        SWAP(s[MBEDTLS_BYTE_0(p)], t); SWAP(s[MBEDTLS_BYTE_1(p)], t);\0A        SWAP(s[MBEDTLS_BYTE_2(p)], t); SWAP(s[MBEDTLS_BYTE_3(p)], t);\0A        p = pi[4];\0A        SWAP(s[MBEDTLS_BYTE_0(p)], t); SWAP(s[MBEDTLS_BYTE_1(p)], t);\0A        SWAP(s[MBEDTLS_BYTE_2(p)], t); SWAP(s[MBEDTLS_BYTE_3(p)], t);\0A        p = pi[5];\0A        SWAP(s[MBEDTLS_BYTE_0(p)], t); SWAP(s[MBEDTLS_BYTE_1(p)], t);\0A        SWAP(s[MBEDTLS_BYTE_2(p)], t); SWAP(s[MBEDTLS_BYTE_3(p)], t);\0A#endif\0A\0A        /* Chi */\0A#if MBEDTLS_SHA3_CHI_UNROLL == 0 //no-check-names\0A        for (i = 0; i <= 20; i += 5) {\0A            lane[0] = s[i]; lane[1] = s[i + 1]; lane[2] = s[i + 2];\0A            lane[3] = s[i + 3]; lane[4] = s[i + 4];\0A            s[i + 0] ^= (~lane[1]) & lane[2];\0A            s[i + 1] ^= (~lane[2]) & lane[3];\0A            s[i + 2] ^= (~lane[3]) & lane[4];\0A            s[i + 3] ^= (~lane[4]) & lane[0];\0A            s[i + 4] ^= (~lane[0]) & lane[1];\0A        }\0A#else\0A        lane[0] = s[0]; lane[1] = s[1]; lane[2] = s[2]; lane[3] = s[3]; lane[4] = s[4];\0A        s[0] ^= (~lane[1]) & lane[2];\0A        s[1] ^= (~lane[2]) & lane[3];\0A        s[2] ^= (~lane[3]) & lane[4];\0A        s[3] ^= (~lane[4]) & lane[0];\0A        s[4] ^= (~lane[0]) & lane[1];\0A\0A        lane[0] = s[5]; lane[1] = s[6]; lane[2] = s[7]; lane[3] = s[8]; lane[4] = s[9];\0A        s[5] ^= (~lane[1]) & lane[2];\0A        s[6] ^= (~lane[2]) & lane[3];\0A        s[7] ^= (~lane[3]) & lane[4];\0A        s[8] ^= (~lane[4]) & lane[0];\0A        s[9] ^= (~lane[0]) & lane[1];\0A\0A        lane[0] = s[10]; lane[1] = s[11]; lane[2] = s[12]; lane[3] = s[13]; lane[4] = s[14];\0A        s[10] ^= (~lane[1]) & lane[2];\0A        s[11] ^= (~lane[2]) & lane[3];\0A        s[12] ^= (~lane[3]) & lane[4];\0A        s[13] ^= (~lane[4]) & lane[0];\0A        s[14] ^= (~lane[0]) & lane[1];\0A\0A        lane[0] = s[15]; lane[1] = s[16]; lane[2] = s[17]; lane[3] = s[18]; lane[4] = s[19];\0A        s[15] ^= (~lane[1]) & lane[2];\0A        s[16] ^= (~lane[2]) & lane[3];\0A        s[17] ^= (~lane[3]) & lane[4];\0A        s[18] ^= (~lane[4]) & lane[0];\0A        s[19] ^= (~lane[0]) & lane[1];\0A\0A        lane[0] = s[20]; lane[1] = s[21]; lane[2] = s[22]; lane[3] = s[23]; lane[4] = s[24];\0A        s[20] ^= (~lane[1]) & lane[2];\0A        s[21] ^= (~lane[2]) & lane[3];\0A        s[22] ^= (~lane[3]) & lane[4];\0A        s[23] ^= (~lane[4]) & lane[0];\0A        s[24] ^= (~lane[0]) & lane[1];\0A#endif\0A\0A        /* Iota */\0A        /* Decompress the round masks (see definition of rc) */\0A        s[0] ^= ((iota_r_packed[round] & 0x40ull) << 57 |\0A                 (iota_r_packed[round] & 0x20ull) << 26 |\0A                 (iota_r_packed[round] & 0x10ull) << 11 |\0A                 (iota_r_packed[round] & 0x8f));\0A    }\0A}\0A\0Avoid mbedtls_sha3_init(mbedtls_sha3_context *ctx)\0A{\0A    memset(ctx, 0, sizeof(mbedtls_sha3_context));\0A}\0A\0Avoid mbedtls_sha3_free(mbedtls_sha3_context *ctx)\0A{\0A    if (ctx == NULL) {\0A        return;\0A    }\0A\0A    mbedtls_platform_zeroize(ctx, sizeof(mbedtls_sha3_context));\0A}\0A\0Avoid mbedtls_sha3_clone(mbedtls_sha3_context *dst,\0A                        const mbedtls_sha3_context *src)\0A{\0A    *dst = *src;\0A}\0A\0A/*\0A * SHA-3 context setup\0A */\0Aint mbedtls_sha3_starts(mbedtls_sha3_context *ctx, mbedtls_sha3_id id)\0A{\0A    switch (id) {\0A        case MBEDTLS_SHA3_224:\0A            ctx->olen = 224 / 8;\0A            ctx->max_block_size = 1152 / 8;\0A            break;\0A        case MBEDTLS_SHA3_256:\0A            ctx->olen = 256 / 8;\0A            ctx->max_block_size = 1088 / 8;\0A            break;\0A        case MBEDTLS_SHA3_384:\0A            ctx->olen = 384 / 8;\0A            ctx->max_block_size = 832 / 8;\0A            break;\0A        case MBEDTLS_SHA3_512:\0A            ctx->olen = 512 / 8;\0A            ctx->max_block_size = 576 / 8;\0A            break;\0A        default:\0A            return MBEDTLS_ERR_SHA3_BAD_INPUT_DATA;\0A    }\0A\0A    memset(ctx->state, 0, sizeof(ctx->state));\0A    ctx->index = 0;\0A\0A    return 0;\0A}\0A\0A/*\0A * SHA-3 process buffer\0A */\0Aint mbedtls_sha3_update(mbedtls_sha3_context *ctx,\0A                        const uint8_t *input,\0A                        size_t ilen)\0A{\0A    if (ilen >= 8) {\0A        // 8-byte align index\0A        int align_bytes = 8 - (ctx->index % 8);\0A        if (align_bytes) {\0A            for (; align_bytes > 0; align_bytes--) {\0A                ABSORB(ctx, ctx->index, *input++);\0A                ilen--;\0A                ctx->index++;\0A            }\0A            if ((ctx->index = ctx->index % ctx->max_block_size) == 0) {\0A                keccak_f1600(ctx);\0A            }\0A        }\0A\0A        // process input in 8-byte chunks\0A        while (ilen >= 8) {\0A            ABSORB(ctx, ctx->index, MBEDTLS_GET_UINT64_LE(input, 0));\0A            input += 8;\0A            ilen -= 8;\0A            if ((ctx->index = (ctx->index + 8) % ctx->max_block_size) ==