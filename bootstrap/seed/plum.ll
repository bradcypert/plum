@.str45421 = private global { i64, i64, [11243 x i8] } { i64 -1, i64 11242, [11243 x i8] c"/*\0A *  Generic ASN.1 parsing\0A *\0A *  Copyright The Mbed TLS Contributors\0A *  SPDX-License-Identifier: Apache-2.0 OR GPL-2.0-or-later\0A */\0A\0A#include \22common.h\22\0A\0A#if defined(MBEDTLS_ASN1_PARSE_C) || defined(MBEDTLS_X509_CREATE_C) || \5C\0A    defined(MBEDTLS_PSA_UTIL_HAVE_ECDSA)\0A\0A#include \22mbedtls/asn1.h\22\0A#include \22mbedtls/platform_util.h\22\0A#include \22mbedtls/error.h\22\0A\0A#include <string.h>\0A\0A#if defined(MBEDTLS_BIGNUM_C)\0A#include \22mbedtls/bignum.h\22\0A#endif\0A\0A#include \22mbedtls/platform.h\22\0A\0A/*\0A * ASN.1 DER decoding routines\0A */\0Aint mbedtls_asn1_get_len(unsigned char **p,\0A                         const unsigned char *end,\0A                         size_t *len)\0A{\0A    if ((end - *p) < 1) {\0A        return MBEDTLS_ERR_ASN1_OUT_OF_DATA;\0A    }\0A\0A    if ((**p & 0x80) == 0) {\0A        *len = *(*p)++;\0A    } else {\0A        int n = (**p) & 0x7F;\0A        if (n == 0 || n > 4) {\0A            return MBEDTLS_ERR_ASN1_INVALID_LENGTH;\0A        }\0A        if ((end - *p) <= n) {\0A            return MBEDTLS_ERR_ASN1_OUT_OF_DATA;\0A        }\0A        *len = 0;\0A        (*p)++;\0A        while (n--) {\0A            *len = (*len << 8) | **p;\0A            (*p)++;\0A        }\0A    }\0A\0A    if (*len > (size_t) (end - *p)) {\0A        return MBEDTLS_ERR_ASN1_OUT_OF_DATA;\0A    }\0A\0A    return 0;\0A}\0A\0Aint mbedtls_asn1_get_tag(unsigned char **p,\0A                         const unsigned char *end,\0A                         size_t *len, int tag)\0A{\0A    if ((end - *p) < 1) {\0A        return MBEDTLS_ERR_ASN1_OUT_OF_DATA;\0A    }\0A\0A    if (**p != tag) {\0A        return MBEDTLS_ERR_ASN1_UNEXPECTED_TAG;\0A    }\0A\0A    (*p)++;\0A\0A    return mbedtls_asn1_get_len(p, end, len);\0A}\0A#endif /* MBEDTLS_ASN1_PARSE_C || MBEDTLS_X509_CREATE_C || MBEDTLS_PSA_UTIL_HAVE_ECDSA */\0A\0A#if defined(MBEDTLS_ASN1_PARSE_C)\0Aint mbedtls_asn1_get_bool(unsigned char **p,\0A                          const unsigned char *end,\0A                          int *val)\0A{\0A    int ret = MBEDTLS_ERR_ERROR_CORRUPTION_DETECTED;\0A    size_t len;\0A\0A    if ((ret = mbedtls_asn1_get_tag(p, end, &len, MBEDTLS_ASN1_BOOLEAN)) != 0) {\0A        return ret;\0A    }\0A\0A    if (len != 1) {\0A        return MBEDTLS_ERR_ASN1_INVALID_LENGTH;\0A    }\0A\0A    *val = (**p != 0) ? 1 : 0;\0A    (*p)++;\0A\0A    return 0;\0A}\0A\0Astatic int asn1_get_tagged_int(unsigned char **p,\0A                               const unsigned char *end,\0A                               int tag, int *val)\0A{\0A    int ret = MBEDTLS_ERR_ERROR_CORRUPTION_DETECTED;\0A    size_t len;\0A\0A    if ((ret = mbedtls_asn1_get_tag(p, end, &len, tag)) != 0) {\0A        return ret;\0A    }\0A\0A    /*\0A     * len==0 is malformed (0 must be represented as 020100 for INTEGER,\0A     * or 0A0100 for ENUMERATED tags\0A     */\0A    if (len == 0) {\0A        return MBEDTLS_ERR_ASN1_INVALID_LENGTH;\0A    }\0A    /* This is a cryptography library. Reject negative integers. */\0A    if ((**p & 0x80) != 0) {\0A        return MBEDTLS_ERR_ASN1_INVALID_LENGTH;\0A    }\0A\0A    /* Skip leading zeros. */\0A    while (len > 0 && **p == 0) {\0A        ++(*p);\0A        --len;\0A    }\0A\0A    /* Reject integers that don't fit in an int. This code assumes that\0A     * the int type has no padding bit. */\0A    if (len > sizeof(int)) {\0A        return MBEDTLS_ERR_ASN1_INVALID_LENGTH;\0A    }\0A    if (len == sizeof(int) && (**p & 0x80) != 0) {\0A        return MBEDTLS_ERR_ASN1_INVALID_LENGTH;\0A    }\0A\0A    *val = 0;\0A    while (len-- > 0) {\0A        *val = (*val << 8) | **p;\0A        (*p)++;\0A    }\0A\0A    return 0;\0A}\0A\0Aint mbedtls_asn1_get_int(unsigned char **p,\0A                         const unsigned char *end,\0A                         int *val)\0A{\0A    return asn1_get_tagged_int(p, end, MBEDTLS_ASN1_INTEGER, val);\0A}\0A\0Aint mbedtls_asn1_get_enum(unsigned char **p,\0A                          const unsigned char *end,\0A                          int *val)\0A{\0A    return asn1_get_tagged_int(p, end, MBEDTLS_ASN1_ENUMERATED, val);\0A}\0A\0A#if defined(MBEDTLS_BIGNUM_C)\0Aint mbedtls_asn1_get_mpi(unsigned char **p,\0A                         const unsigned char *end,\0A                         mbedtls_mpi *X)\0A{\0A    int ret = MBEDTLS_ERR_ERROR_CORRUPTION_DETECTED;\0A    size_t len;\0A\0A    if ((ret = mbedtls_asn1_get_tag(p, end, &len, MBEDTLS_ASN1_INTEGER)) != 0) {\0A        return ret;\0A    }\0A\0A    ret = mbedtls_mpi_read_binary(X, *p, len);\0A\0A    *p += len;\0A\0A    return ret;\0A}\0A#endif /* MBEDTLS_BIGNUM_C */\0A\0Aint mbedtls_asn1_get_bitstring(unsigned char **p, const unsigned char *end,\0A                               mbedtls_asn1_bitstring *bs)\0A{\0A    int ret = MBEDTLS_ERR_ERROR_CORRUPTION_DETECTED;\0A\0A    /* Certificate type is a single byte bitstring */\0A    if ((ret = mbedtls_asn1_get_tag(p, end, &bs->len, MBEDTLS_ASN1_BIT_STRING)) != 0) {\0A        return ret;\0A    }\0A\0A    /* Check length, subtract one for actual bit string length */\0A    if (bs->len < 1) {\0A        return MBEDTLS_ERR_ASN1_OUT_OF_DATA;\0A    }\0A    bs->len -= 1;\0A\0A    /* Get number of unused bits, ensure unused bits <= 7 */\0A    bs->unused_bits = **p;\0A    if (bs->unused_bits > 7) {\0A        return MBEDTLS_ERR_ASN1_INVALID_LENGTH;\0A    }\0A    (*p)++;\0A\0A    /* Get actual bitstring */\0A    bs->p = *p;\0A    *p += bs->len;\0A\0A    if (*p != end) {\0A        return MBEDTLS_ERR_ASN1_LENGTH_MISMATCH;\0A    }\0A\0A    return 0;\0A}\0A\0A/*\0A * Traverse an ASN.1 \22SEQUENCE OF <tag>\22\0A * and call a callback for each entry found.\0A */\0Aint mbedtls_asn1_traverse_sequence_of(\0A    unsigned char **p,\0A    const unsigned char *end,\0A    unsigned char tag_must_mask, unsigned char tag_must_val,\0A    unsigned char tag_may_mask, unsigned char tag_may_val,\0A    int (*cb)(void *