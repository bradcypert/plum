rn success if any of them\0A     * verify.\0A     *\0A     * However, we could make this better by checking against the certificate's\0A     * identification and SignerIdentifier fields first. That would also allow\0A     * us to distinguish between 'no signature for key' and 'signature for key\0A     * failed to validate'.\0A     */\0A    for (signer = &pkcs7->signed_data.signers; signer; signer = signer->next) {\0A        ret = mbedtls_pk_verify(&pk_cxt, md_alg, hash,\0A                                mbedtls_md_get_size(md_info),\0A                                signer->sig.p, signer->sig.len);\0A\0A        if (ret == 0) {\0A            break;\0A        }\0A    }\0A\0A    mbedtls_free(hash);\0A    /* END must free hash before jumping out */\0A    return ret;\0A}\0A\0Aint mbedtls_pkcs7_signed_data_verify(mbedtls_pkcs7 *pkcs7,\0A                                     const mbedtls_x509_crt *cert,\0A                                     const unsigned char *data,\0A                                     size_t datalen)\0A{\0A    if (data == NULL) {\0A        return MBEDTLS_ERR_PKCS7_BAD_INPUT_DATA;\0A    }\0A    return mbedtls_pkcs7_data_or_hash_verify(pkcs7, cert, data, datalen, 0);\0A}\0A\0Aint mbedtls_pkcs7_signed_hash_verify(mbedtls_pkcs7 *pkcs7,\0A                                     const mbedtls_x509_crt *cert,\0A                                     const unsigned char *hash,\0A                                     size_t hashlen)\0A{\0A    if (hash == NULL) {\0A        return MBEDTLS_ERR_PKCS7_BAD_INPUT_DATA;\0A    }\0A    return mbedtls_pkcs7_data_or_hash_verify(pkcs7, cert, hash, hashlen, 1);\0A}\0A\0A/*\0A * Unallocate all pkcs7 data\0A */\0Avoid mbedtls_pkcs7_free(mbedtls_pkcs7 *pkcs7)\0A{\0A    mbedtls_pkcs7_signer_info *signer_cur;\0A    mbedtls_pkcs7_signer_info *signer_prev;\0A\0A    if (pkcs7 == NULL || pkcs7->raw.p == NULL) {\0A        return;\0A    }\0A\0A    mbedtls_free(pkcs7->raw.p);\0A\0A    mbedtls_x509_crt_free(&pkcs7->signed_data.certs);\0A    mbedtls_x509_crl_free(&pkcs7->signed_data.crl);\0A\0A    signer_cur = pkcs7->signed_data.signers.next;\0A    pkcs7_free_signer_info(&pkcs7->signed_data.signers);\0A    while (signer_cur != NULL) {\0A        signer_prev = signer_cur;\0A        signer_cur = signer_prev->next;\0A        pkcs7_free_signer_info(signer_prev);\0A        mbedtls_free(signer_prev);\0A    }\0A\0A    pkcs7->raw.p = NULL;\0A}\0A\0A#endif\0A\00" }
