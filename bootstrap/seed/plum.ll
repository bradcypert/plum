@.str43156 = private global { i64, i64, [1671 x i8] } { i64 -1, i64 1670, [1671 x i8] c"// Whole-file byte reads for the generated runtime. Keep libc's FILE,\0A// size_t and positioning types on the C side of the boundary: in\0A// particular, Windows long/ftell are only 32 bits even on 64-bit builds.\0A// The caller owns the returned buffer and must free it after copying it\0A// into a Plum cell. NULL means failure; an empty file still owns a buffer.\0A#if !defined(_WIN32)\0A#ifndef _FILE_OFFSET_BITS\0A#define _FILE_OFFSET_BITS 64\0A#endif\0A#ifndef _POSIX_C_SOURCE\0A#define _POSIX_C_SOURCE 200809L\0A#endif\0A#endif\0A\0A#include <stdint.h>\0A#include <stdio.h>\0A#include <stdlib.h>\0A\0A#if defined(_WIN32)\0A#define PLUM_WHOLE_SEEK _fseeki64\0A#define PLUM_WHOLE_TELL _ftelli64\0A#else\0A#define PLUM_WHOLE_SEEK fseeko\0A#define PLUM_WHOLE_TELL ftello\0A#endif\0A\0Achar *plum_read_whole_file(const char *path, long long *length) {\0A    *length = 0;\0A    FILE *f = fopen(path, \22rb\22);\0A    if (f == NULL) return NULL;\0A    char *buf = NULL;\0A\0A    if (PLUM_WHOLE_SEEK(f, 0, SEEK_END) != 0) goto fail;\0A    int64_t size = PLUM_WHOLE_TELL(f);\0A    // Also reserve the runtime cell's refcount, length and trailing NUL\0A    // (17 bytes). Neither native nor Plum allocation sizes may overflow.\0A    if (size < 0 || (uint64_t)size > INT64_MAX - 17 ||\0A        (uint64_t)size > SIZE_MAX - 17) goto fail;\0A    if (PLUM_WHOLE_SEEK(f, 0, SEEK_SET) != 0) goto fail;\0A\0A    buf = malloc((size_t)size + 1);\0A    if (buf == NULL) goto fail;\0A    size_t got = fread(buf, 1, (size_t)size, f);\0A    if (ferror(f) || got != (size_t)size) goto fail;\0A    if (fclose(f) != 0) {\0A        free(buf);\0A        return NULL;\0A    }\0A    buf[got] = '\5C0';\0A    *length = size;\0A    return buf;\0A\0Afail:\0A    fclose(f);\0A    free(buf);\0A    return NULL;\0A}\0A\00" }
