@.str39594 = private global { i64, i64, [9559 x i8] } { i64 -1, i64 9558, [9559 x i8] c"/**\0A * \5Cfile entropy.h\0A *\0A * \5Cbrief Entropy accumulator implementation\0A */\0A/*\0A *  Copyright The Mbed TLS Contributors\0A *  SPDX-License-Identifier: Apache-2.0 OR GPL-2.0-or-later\0A */\0A#ifndef MBEDTLS_ENTROPY_H\0A#define MBEDTLS_ENTROPY_H\0A#include \22mbedtls/private_access.h\22\0A\0A#include \22mbedtls/build_info.h\22\0A\0A#include <stddef.h>\0A\0A#include \22md.h\22\0A\0A#if (defined(MBEDTLS_MD_CAN_SHA512) || defined(PSA_WANT_ALG_SHA_512)) && \5C\0A    !defined(MBEDTLS_ENTROPY_FORCE_SHA256)\0A#define MBEDTLS_ENTROPY_SHA512_ACCUMULATOR\0A#define MBEDTLS_ENTROPY_MD  MBEDTLS_MD_SHA512\0A#define MBEDTLS_ENTROPY_BLOCK_SIZE      64      /**< Block size of entropy accumulator (SHA-512) */\0A#else\0A#if (defined(MBEDTLS_MD_CAN_SHA256) || defined(PSA_WANT_ALG_SHA_256))\0A#define MBEDTLS_ENTROPY_SHA256_ACCUMULATOR\0A#define MBEDTLS_ENTROPY_MD  MBEDTLS_MD_SHA256\0A#define MBEDTLS_ENTROPY_BLOCK_SIZE      32      /**< Block size of entropy accumulator (SHA-256) */\0A#endif\0A#endif\0A\0A#if defined(MBEDTLS_THREADING_C)\0A#include \22mbedtls/threading.h\22\0A#endif\0A\0A\0A/** Critical entropy source failure. */\0A#define MBEDTLS_ERR_ENTROPY_SOURCE_FAILED                 -0x003C\0A/** No more sources can be added. */\0A#define MBEDTLS_ERR_ENTROPY_MAX_SOURCES                   -0x003E\0A/** No sources have been added to poll. */\0A#define MBEDTLS_ERR_ENTROPY_NO_SOURCES_DEFINED            -0x0040\0A/** No strong sources have been added to poll. */\0A#define MBEDTLS_ERR_ENTROPY_NO_STRONG_SOURCE              -0x003D\0A/** Read/write error in file. */\0A#define MBEDTLS_ERR_ENTROPY_FILE_IO_ERROR                 -0x003F\0A\0A/**\0A * \5Cname SECTION: Module settings\0A *\0A * The configuration options you can set for this module are in this section.\0A * Either change them in mbedtls_config.h or define them on the compiler command line.\0A * \5C{\0A */\0A\0A#if !defined(MBEDTLS_ENTROPY_MAX_SOURCES)\0A#define MBEDTLS_ENTROPY_MAX_SOURCES     20      /**< Maximum number of sources supported */\0A#endif\0A\0A#if !defined(MBEDTLS_ENTROPY_MAX_GATHER)\0A#define MBEDTLS_ENTROPY_MAX_GATHER      128     /**< Maximum amount requested from entropy sources */\0A#endif\0A\0A/** \5C} name SECTION: Module settings */\0A\0A#define MBEDTLS_ENTROPY_MAX_SEED_SIZE   1024    /**< Maximum size of seed we read from seed file */\0A#define MBEDTLS_ENTROPY_SOURCE_MANUAL   MBEDTLS_ENTROPY_MAX_SOURCES\0A\0A#define MBEDTLS_ENTROPY_SOURCE_STRONG   1       /**< Entropy source is strong   */\0A#define MBEDTLS_ENTROPY_SOURCE_WEAK     0       /**< Entropy source is weak     */\0A\0A#ifdef __cplusplus\0Aextern \22C\22 {\0A#endif\0A\0A/**\0A * \5Cbrief           Entropy poll callback pointer\0A *\0A * \5Cparam data      Callback-specific data pointer\0A * \5Cparam output    Data to fill\0A * \5Cparam len       Maximum size to provide\0A * \5Cparam olen      The actual amount of bytes put into the buffer (Can be 0)\0A *\0A * \5Creturn          0 if no critical failures occurred,\0A *                  MBEDTLS_ERR_ENTROPY_SOURCE_FAILED otherwise\0A */\0Atypedef int (*mbedtls_entropy_f_source_ptr)(void *data, unsigned char *output, size_t len,\0A                                            size_t *olen);\0A\0A/**\0A * \5Cbrief           Entropy source state\0A */\0Atypedef struct mbedtls_entropy_source_state {\0A    mbedtls_entropy_f_source_ptr    MBEDTLS_PRIVATE(f_source);   /**< The entropy source callback */\0A    void *MBEDTLS_PRIVATE(p_source);             /**< The callback data pointer */\0A    size_t          MBEDTLS_PRIVATE(size);       /**< Amount received in bytes */\0A    size_t          MBEDTLS_PRIVATE(threshold);  /**< Minimum bytes required before release */\0A    int             MBEDTLS_PRIVATE(strong);     /**< Is the source strong? */\0A}\0Ambedtls_entropy_source_state;\0A\0A/**\0A * \5Cbrief           Entropy context structure\0A */\0Atypedef struct mbedtls_entropy_context {\0A    mbedtls_md_context_t  MBEDTLS_PRIVATE(accumulator);\0A    int MBEDTLS_PRIVATE(accumulator_started); /* 0 after init.\0A                                               * 1 after the first update.\0A                                               * -1 after free. */\0A    int             MBEDTLS_PRIVATE(source_count); /* Number of entries used in source. */\0A    mbedtls_entropy_source_state    MBEDTLS_PRIVATE(source)[MBEDTLS_ENTROPY_MAX_SOURCES];\0A#if defined(MBEDTLS_THREADING_C)\0A    mbedtls_threading_mutex_t MBEDTLS_PRIVATE(mutex);    /*!< mutex                  */\0A#endif\0A#if defined(MBEDTLS_ENTROPY_NV_SEED)\0A    int MBEDTLS_PRIVATE(initial_entropy_run);\0A#endif\0A}\0Ambedtls_entropy_context;\0A\0A#if !defined(MBEDTLS_NO_PLATFORM_ENTROPY)\0A/**\0A * \5Cbrief           Platform-specific entropy poll callback\0A */\0Aint mbedtls_platform_entropy_poll(void *data,\0A                                  unsigned char *output, size_t len, size_t *olen);\0A#endif\0A\0A/**\0A * \5Cbrief           Initialize the context\0A *\0A * \5Cparam ctx       Entropy context to initialize\0A */\0Avoid mbedtls_entropy_init(mbedtls_entropy_context *ctx);\0A\0A/**\0A * \5Cbrief           Free the data in the context\0A *\0A * \5Cparam ctx       Entropy context to free\0A */\0Avoid mbedtls_entropy_free(mbedtls_entropy_context *ctx);\0A\0A/**\0A * \5Cbrief           Adds an entropy source to poll\0A *                  (Thread-safe if MBEDTLS_THREADING_C is enabled)\0A *\0A * \5Cparam ctx       Entropy context\0A * \5Cparam f_source  Entropy function\0A * \5Cparam p_source  Function data\0A * \5Cparam threshold Minimum required from source before entropy is released\0A *                  ( with mbedtls_entropy_func() ) (in bytes)\0A * \5Cparam strong    MBEDTLS_ENTROPY_SOURCE_STRONG or\0A *                  MBEDTLS_ENTROPY_SOURCE_WEAK.\0A *                  At least one strong source needs to be added.\0A *                  Weaker sources (such as the cycle counter) can be used as\0A *                  a complement.\0A *\0A * \5Creturn          0 if successful or MBEDTLS_ERR_ENTROPY_MAX_SOURCES\0A */\0Aint mbedtls_entropy_add_source(mbedtls_entropy_context *ctx,\0A                               mbedtls_entropy_f_source_ptr f_source, void *p_source,\0A                               size_t threshold, int strong);\0A\0A/**\0A * \5Cbrief           Trigger an extra gather poll for the accumulator\0A *                  (Thread-safe if MBEDTLS_THREADING_C is enabled)\0A *\0A * \5Cparam ctx       Entropy context\0A *\0A * \5Creturn          0 if successful, or MBEDTLS_ERR_ENTROPY_SOURCE_FAILED\0A */\0Aint mbedtls_entropy_gather(mbedtls_entropy_context *ctx);\0A\0A/**\0A * \5Cbrief           Retrieve entropy from the accumulator\0A *                  (Maximum length: MBEDTLS_ENTROPY_BLOCK_SIZE)\0A *                  (Thread-safe if MBEDTLS_THREADING_C is enabled)\0A *\0A * \5Cparam data      Entropy context\0A * \5Cparam output    Buffer to fill\0A * \5Cparam len       Number of bytes desired, must be at most MBEDTLS_ENTROPY_BLOCK_SIZE\0A *\0A * \5Creturn          0 if successful, or MBEDTLS_ERR_ENTROPY_SOURCE_FAILED\0A */\0Aint mbedtls_entropy_func(void *data, unsigned char *output, size_t len);\0A\0A/**\0A * \5Cbrief           Add data to the accumulator manually\0A *                  (Thread-safe if MBEDTLS_THREADING_C is enabled)\0A *\0A * \5Cparam ctx       Entropy context\0A * \5Cparam data      Data to add\0A * \5Cparam len       Length of data\0A *\0A * \5Creturn          0 if successful\0A */\0Aint mbedtls_entropy_update_manual(mbedtls_entropy_context *ctx,\0A                                  const unsigned char *data, size_t len);\0A\0A#if defined(MBEDTLS_ENTROPY_NV_SEED)\0A/**\0A * \5Cbrief           Trigger an update of the seed file in NV by using the\0A *                  current entropy pool.\0A *\0A * \5Cparam ctx       Entropy context\0A *\0A * \5Creturn          0 if successful\0A */\0Aint mbedtls_entropy_update_nv_seed(mbedtls_entropy_context *ctx);\0A#endif /* MBEDTLS_ENTROPY_NV_SEED */\0A\0A#if defined(MBEDTLS_FS_IO)\0A/**\0A * \5Cbrief               Write a seed file\0A *\0A * \5Cparam ctx           Entropy context\0A * \5Cparam path          Name of the file\0A *\0A * \5Creturn              0 if successful,\0A *                      MBEDTLS_ERR_ENTROPY_FILE_IO_ERROR on file error, or\0A *                      MBEDTLS_ERR_ENTROPY_SOURCE_FAILED\0A */\0Aint mbedtls_entropy_write_seed_file(mbedtls_entropy_context *ctx, const char *path);\0A\0A/**\0A * \5Cbrief               Read and update a seed file. Seed is added to this\0A *                      instance. No more than MBEDTLS_ENTROPY_MAX_SEED_SIZE bytes are\0A *                      read from the seed file. The rest is ignored.\0A *\0A * \5Cparam ctx           Entropy context\0A * \5Cparam path          Name of the file\0A *\0A * \5Creturn              0 if successful,\0A *                      MBEDTLS_ERR_ENTROPY_FILE_IO_ERROR on file error,\0A *                      MBEDTLS_ERR_ENTROPY_SOURCE_FAILED\0A */\0Aint mbedtls_entropy_update_seed_file(mbedtls_entropy_context *ctx, const char *path);\0A#endif /* MBEDTLS_FS_IO */\0A\0A#if defined(MBEDTLS_SELF_TEST)\0A/**\0A * \5Cbrief          Checkup routine\0A *\0A *                 This module self-test also calls the entropy self-test,\0A *                 mbedtls_entropy_source_self_test();\0A *\0A * \5Creturn         0 if successful, or 1 if a test failed\0A */\0Aint mbedtls_entropy_self_test(int verbose);\0A\0A#if defined(MBEDTLS_ENTROPY_HARDWARE_ALT)\0A/**\0A * \5Cbrief          Checkup routine\0A *\0A *                 Verifies the integrity of the hardware entropy source\0A *                 provided by the function 'mbedtls_hardware_poll()'.\0A *\0A *                 Note this is the only hardware entropy source that is known\0A *                 at link time, and other entropy sources configured\0A *                 dynamically at runtime by the function\0A *                 mbedtls_entropy_add_source() will not be tested.\0A *\0A * \5Creturn         0 if successful, or 1 if a test failed\0A */\0Aint mbedtls_entropy_source_self_test(int verbose);\0A#endif /* MBEDTLS_ENTROPY_HARDWARE_ALT */\0A#endif /* MBEDTLS_SELF_TEST */\0A\0A#ifdef __cplusplus\0A}\0A#endif\0A\0A#endif /* entropy.h */\0A\00" }
