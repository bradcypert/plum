LS_CHECK_RETURN_CRITICAL\0Astatic int ssl_tls13_is_new_session_ticket(mbedtls_ssl_context *ssl)\0A{\0A\0A    if ((ssl->in_hslen == mbedtls_ssl_hs_hdr_len(ssl)) ||\0A        (ssl->in_msg[0] != MBEDTLS_SSL_HS_NEW_SESSION_TICKET)) {\0A        return 0;\0A    }\0A\0A    return 1;\0A}\0A#endif /* MBEDTLS_SSL_CLI_C */\0A\0AMBEDTLS_CHECK_RETURN_CRITICAL\0Astatic int ssl_tls13_handle_hs_message_post_handshake(mbedtls_ssl_context *ssl)\0A{\0A\0A    MBEDTLS_SSL_DEBUG_MSG(3, (\22received post-handshake message\22));\0A\0A#if defined(MBEDTLS_SSL_CLI_C)\0A    if (ssl->conf->endpoint == MBEDTLS_SSL_IS_CLIENT) {\0A        if (ssl_tls13_is_new_session_ticket(ssl)) {\0A#if defined(MBEDTLS_SSL_SESSION_TICKETS)\0A            MBEDTLS_SSL_DEBUG_MSG(3, (\22NewSessionTicket received\22));\0A            if (mbedtls_ssl_conf_is_signal_new_session_tickets_enabled(ssl->conf) ==\0A                MBEDTLS_SSL_TLS1_3_SIGNAL_NEW_SESSION_TICKETS_ENABLED) {\0A                ssl->keep_current_message = 1;\0A\0A                mbedtls_ssl_handshake_set_state(ssl,\0A                                                MBEDTLS_SSL_TLS1_3_NEW_SESSION_TICKET);\0A                return MBEDTLS_ERR_SSL_WANT_READ;\0A            } else {\0A                MBEDTLS_SSL_DEBUG_MSG(3, (\22Ignoring NewSessionTicket, handling disabled.\22));\0A                return 0;\0A            }\0A#else\0A            MBEDTLS_SSL_DEBUG_MSG(3, (\22Ignoring NewSessionTicket, not supported.\22));\0A            return 0;\0A#endif\0A        }\0A    }\0A#endif /* MBEDTLS_SSL_CLI_C */\0A\0A    /* Fail in all other cases. */\0A    return MBEDTLS_ERR_SSL_UNEXPECTED_MESSAGE;\0A}\0A#endif /* MBEDTLS_SSL_PROTO_TLS1_3 */\0A\0A#if defined(MBEDTLS_SSL_PROTO_TLS1_2)\0A/* This function is called from mbedtls_ssl_read() when a handshake message is\0A * received after the initial handshake. In this context, handshake messages\0A * may only be sent for the purpose of initiating renegotiations.\0A *\0A * This function is introduced as a separate helpe