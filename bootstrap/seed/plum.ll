@.str45784 = private global { i64, i64, [16320 x i8] } { i64 -1, i64 16319, [16320 x i8] c"/*\0A *  PSA RSA layer on top of Mbed TLS crypto\0A */\0A/*\0A *  Copyright The Mbed TLS Contributors\0A *  SPDX-License-Identifier: Apache-2.0 OR GPL-2.0-or-later\0A */\0A\0A#ifndef PSA_CRYPTO_RSA_H\0A#define PSA_CRYPTO_RSA_H\0A\0A#include <psa/crypto.h>\0A#include <mbedtls/rsa.h>\0A\0A/** Load the contents of a key buffer into an internal RSA representation\0A *\0A * \5Cparam[in] type          The type of key contained in \5Cp data.\0A * \5Cparam[in] data          The buffer from which to load the representation.\0A * \5Cparam[in] data_length   The size in bytes of \5Cp data.\0A * \5Cparam[out] p_rsa        Returns a pointer to an RSA context on success.\0A *                          The caller is responsible for freeing both the\0A *                          contents of the context and the context itself\0A *                          when done.\0A */\0Apsa_status_t mbedtls_psa_rsa_load_representation(psa_key_type_t type,\0A                                                 const uint8_t *data,\0A                                                 size_t data_length,\0A                                                 mbedtls_rsa_context **p_rsa);\0A\0A/** Import an RSA key in binary format.\0A *\0A * \5Cnote The signature of this function is that of a PSA driver\0A *       import_key entry point. This function behaves as an import_key\0A *       entry point as defined in the PSA driver interface specification for\0A *       transparent drivers.\0A *\0A * \5Cparam[in]  attributes       The attributes for the key to import.\0A * \5Cparam[in]  data             The buffer containing the key data in import\0A *                              format.\0A * \5Cparam[in]  data_length      Size of the \5Cp data buffer in bytes.\0A * \5Cparam[out] key_buffer       The buffer containing the key data in output\0A *                              format.\0A * \5Cparam[in]  key_buffer_size  Size of the \5Cp key_buffer buffer in bytes. This\0A *                              size is greater or equal to \5Cp data_length.\0A * \5Cparam[out] key_buffer_length  The length of the data written in \5Cp\0A *                                key_buffer in bytes.\0A * \5Cparam[out] bits             The key size in number of bits.\0A *\0A * \5Cretval #PSA_SUCCESS  The RSA key was imported successfully.\0A * \5Cretval #PSA_ERROR_INVALID_ARGUMENT\0A *         The key data is not correctly formatted.\0A * \5Cretval #PSA_ERROR_NOT_SUPPORTED \5Cemptydescription\0A * \5Cretval #PSA_ERROR_INSUFFICIENT_MEMORY \5Cemptydescription\0A * \5Cretval #PSA_ERROR_CORRUPTION_DETECTED \5Cemptydescription\0A */\0Apsa_status_t mbedtls_psa_rsa_import_key(\0A    const psa_key_attributes_t *attributes,\0A    const uint8_t *data, size_t data_length,\0A    uint8_t *key_buffer, size_t key_buffer_size,\0A    size_t *key_buffer_length, size_t *bits);\0A\0A/** Export an RSA key to export representation\0A *\0A * \5Cparam[in] type          The type of key (public/private) to export\0A * \5Cparam[in] rsa           The internal RSA representation from which to export\0A * \5Cparam[out] data         The buffer to export to\0A * \5Cparam[in] data_size     The length of the buffer to export to\0A * \5Cparam[out] data_length  The amount of bytes written to \5Cp data\0A */\0Apsa_status_t mbedtls_psa_rsa_export_key(psa_key_type_t type,\0A                                        mbedtls_rsa_context *rsa,\0A                                        uint8_t *data,\0A                                        size_t data_size,\0A                                        size_t *data_length);\0A\0A/** Export a public RSA key or the public part of an RSA key pair in binary\0A *  format.\0A *\0A * \5Cnote The signature of this function is that of a PSA driver\0A *       export_public_key entry point. This function behaves as an\0A *       export_public_key entry point as defined in the PSA driver interface\0A *       specification.\0A *\0A * \5Cparam[in]  attributes       The attributes for the key to export.\0A * \5Cparam[in]  key_buffer       Material or context of the key to export.\0A * \5Cparam[in]  key_buffer_size  Size of the \5Cp key_buffer buffer in bytes.\0A * \5Cparam[out] data             Buffer where the key data is to be written.\0A * \5Cparam[in]  data_size        Size of the \5Cp data buffer in bytes.\0A * \5Cparam[out] data_length      On success, the number of bytes written in\0A *                              \5Cp data.\0A *\0A * \5Cretval #PSA_SUCCESS  The RSA public key was exported successfully.\0A * \5Cretval #PSA_ERROR_NOT_SUPPORTED \5Cemptydescription\0A * \5Cretval #PSA_ERROR_COMMUNICATION_FAILURE \5Cemptydescription\0A * \5Cretval #PSA_ERROR_HARDWARE_FAILURE \5Cemptydescription\0A * \5Cretval #PSA_ERROR_CORRUPTION_DETECTED \5Cemptydescription\0A * \5Cretval #PSA_ERROR_STORAGE_FAILURE \5Cemptydescription\0A * \5Cretval #PSA_ERROR_INSUFFICIENT_MEMORY \5Cemptydescription\0A */\0Apsa_status_t mbedtls_psa_rsa_export_public_key(\0A    const psa_key_attributes_t *attributes,\0A    const uint8_t *key_buffer, size_t key_buffer_size,\0A    uint8_t *data, size_t data_size, size_t *data_length);\0A\0A/**\0A * \5Cbrief Generate an RSA key.\0A *\0A * \5Cparam[in]  attributes         The attributes for the RSA key to generate.\0A * \5Cparam[in]  custom_data        The public exponent to use.\0A *                                This can be a null pointer if\0A *                                \5Cc params_data_length is 0.\0A * \5Cparam custom_data_length      Length of \5Cp custom_data in bytes.\0A *                                This can be 0, in which case the\0A *                                public exponent will be 65537.\0A * \5Cparam[out] key_buffer         Buffer where the key data is to be written.\0A * \5Cparam[in]  key_buffer_size    Size of \5Cp key_buffer in bytes.\0A * \5Cparam[out] key_buffer_length  On success, the number of bytes written in\0A *                                \5Cp key_buffer.\0A *\0A * \5Cretval #PSA_SUCCESS\0A *         The key was successfully generated.\0A * \5Cretval #PSA_ERROR_NOT_SUPPORTED\0A *         Key length or type not supported.\0A * \5Cretval #PSA_ERROR_BUFFER_TOO_SMALL\0A *         The size of \5Cp key_buffer is too small.\0A */\0Apsa_status_t mbedtls_psa_rsa_generate_key(\0A    const psa_key_attributes_t *attributes,\0A    const uint8_t *custom_data, size_t custom_data_length,\0A    uint8_t *key_buffer, size_t key_buffer_size, size_t *key_buffer_length);\0A\0A/** Sign an already-calculated hash with an RSA private key.\0A *\0A * \5Cnote The signature of this function is that of a PSA driver\0A *       sign_hash entry point. This function behaves as a sign_hash\0A *       entry point as defined in the PSA driver interface specification for\0A *       transparent drivers.\0A *\0A * \5Cparam[in]  attributes       The attributes of the RSA key to use for the\0A *                              operation.\0A * \5Cparam[in]  key_buffer       The buffer containing the RSA key context.\0A *                              format.\0A * \5Cparam[in]  key_buffer_size  Size of the \5Cp key_buffer buffer in bytes.\0A * \5Cparam[in]  alg              A signature algorithm that is compatible with\0A *                              an RSA key.\0A * \5Cparam[in]  hash             The hash or message to sign.\0A * \5Cparam[in]  hash_length      Size of the \5Cp hash buffer in bytes.\0A * \5Cparam[out] signature        Buffer where the signature is to be written.\0A * \5Cparam[in]  signature_size   Size of the \5Cp signature buffer in bytes.\0A * \5Cparam[out] signature_length On success, the number of bytes\0A *                              that make up the returned signature value.\0A *\0A * \5Cretval #PSA_SUCCESS \5Cemptydescription\0A * \5Cretval #PSA_ERROR_BUFFER_TOO_SMALL\0A *         The size of the \5Cp signature buffer is too small. You can\0A *         determine a sufficient buffer size by calling\0A *         #PSA_SIGN_OUTPUT_SIZE(\5Cc PSA_KEY_TYPE_RSA_KEY_PAIR, \5Cc key_bits,\0A *         \5Cp alg) where \5Cc key_bits is the bit-size of the RSA key.\0A * \5Cretval #PSA_ERROR_NOT_SUPPORTED \5Cemptydescription\0A * \5Cretval #PSA_ERROR_INVALID_ARGUMENT \5Cemptydescription\0A * \5Cretval #PSA_ERROR_INSUFFICIENT_MEMORY \5Cemptydescription\0A * \5Cretval #PSA_ERROR_CORRUPTION_DETECTED \5Cemptydescription\0A * \5Cretval #PSA_ERROR_INSUFFICIENT_ENTROPY \5Cemptydescription\0A */\0Apsa_status_t mbedtls_psa_rsa_sign_hash(\0A    const psa_key_attributes_t *attributes,\0A    const uint8_t *key_buffer, size_t key_buffer_size,\0A    psa_algorithm_t alg, const uint8_t *hash, size_t hash_length,\0A    uint8_t *signature, size_t signature_size, size_t *signature_length);\0A\0A/**\0A * \5Cbrief Verify the signature a hash or short message using a public RSA key.\0A *\0A * \5Cnote The signature of this function is that of a PSA driver\0A *       verify_hash entry point. This function behaves as a verify_hash\0A *       entry point as defined in the PSA driver interface specification for\0A *       transparent drivers.\0A *\0A * \5Cparam[in]  attributes       The attributes of the RSA key to use for the\0A *                              operation.\0A * \5Cparam[in]  key_buffer       The buffer containing the RSA key context.\0A *                              format.\0A * \5Cparam[in]  key_buffer_size  Size of the \5Cp key_buffer buffer in bytes.\0A * \5Cparam[in]  alg              A signature algorithm that is compatible with\0A *                              an RSA key.\0A * \5Cparam[in]  hash             The hash or message whose signature is to be\0A *                              verified.\0A * \5Cparam[in]  hash_length      Size of the \5Cp hash buffer in bytes.\0A * \5Cparam[in]  signature        Buffer containing the signature to verify.\0A * \5Cparam[in]  signature_length Size of the \5Cp signature buffer in bytes.\0A *\0A * \5Cretval #PSA_SUCCESS\0A *         The signature is valid.\0A * \5Cretval #PSA_ERROR_INVALID_SIGNATURE\0A *         The calculation was performed successfully, but the passed\0A *         signature is not a valid signature.\0A * \5Cretval #PSA_ERROR_NOT_SUPPORTED \5Cemptydescription\0A * \5Cretval #PSA_ERROR_INVALID_ARGUMENT \5Cemptydescription\0A * \5Cretval #PSA_ERROR_INSUFFICIENT_MEMORY \5Cemptydescription\0A */\0Apsa_status_t mbedtls_psa_rsa_verify_hash(\0A    const psa_key_attributes_t *attributes,\0A    const uint8_t *key_buffer, size_t key_buffer_size,\0A    psa_algorithm_t alg, const uint8_t *hash, size_t hash_length,\0A    const uint8_t *signature, size_t signature_length);\0A\0A/**\0A * \5Cbrief Encrypt a short message with a public key.\0A *\0A * \5Cparam attributes            The attributes for the key to import.\0A * \5Cparam key_buffer            Buffer where the key data is to be written.\0A * \5Cparam key_buffer_size       Size of the \5Cp key_buffer buffer in bytes.\0A * \5Cparam input_length          Size of the \5Cp input buffer in bytes.\0A * \5Cparam[in] salt              A salt or label, if supported by the\0A *                              encryption algorithm.\0A *                              If the algorithm does not support a\0A *                              salt, pass \5Cc NULL.\0A *                              If the algorithm supports an optional\0A *                              salt and you do not want to pass a salt,\0A *                              pass \5Cc NULL.\0A *\0A *                              - For #PSA_ALG_RSA_PKCS1V15_CRYPT, no salt is\0A *                                supported.\0A * \5Cparam salt_length           Size of the \5Cp salt buffer in bytes.\0A *                              If \5Cp salt is \5Cc NULL, pass 0.\0A * \5Cparam[out] output           Buffer where the encrypted message is to\0A *                              be written.\0A * \5Cparam output_size           Size of the \5Cp output buffer in bytes.\0A * \5Cparam[out] output_length    On success, the number of bytes\0A *                              that make up the returned output.\0A *\0A * \5Cretval #PSA_SUCCESS \5Cemptydescription\0A * \5Cretval #PSA_ERROR_BUFFER_TOO_SMALL\0A *         The size of the \5Cp output buffer is too small. You can\0A *         determine a sufficient buffer size by calling\0A *         #PSA_ASYMMETRIC_ENCRYPT_OUTPUT_SIZE(\5Cc key_type, \5Cc key_bits, \5Cp alg)\0A *         where \5Cc key_type and \5Cc key_bits are the type and bit-size\0A *         respectively of \5Cp key.\0A * \5Cretval #PSA_ERROR_NOT_SUPPORTED \5Cemptydescription\0A * \5Cretval #PSA_ERROR_INVALID_ARGUMENT \5Cemptydescription\0A * \5Cretval #PSA_ERROR_INSUFFICIENT_MEMORY \5Cemptydescription\0A * \5Cretval #PSA_ERROR_COMMUNICATION_FAILURE \5Cemptydescription\0A * \5Cretval #PSA_ERROR_HARDWARE_FAILURE \5Cemptydescription\0A * \5Cretval #PSA_ERROR_CORRUPTION_DETECTED \5Cemptydescription\0A * \5Cretval #PSA_ERROR_INSUFFICIENT_ENTROPY \5Cemptydescription\0A * \5Cretval #PSA_ERROR_BAD_STATE\0A *         The library has not been previously initialized by psa_crypto_init().\0A *         It is implementation-dependent whether a failure to initialize\0A *         results in this error code.\0A */\0Apsa_status_t mbedtls_psa_asymmetric_encrypt(const psa_key_attributes_t *attributes,\0A                                            const uint8_t *key_buffer,\0A                                            size_t key_buffer_size,\0A                                            psa_algorithm_t alg,\0A                                            const uint8_t *input,\0A                                            size_t input_length,\0A                                            const uint8_t *salt,\0A                                            size_t salt_length,\0A                                            uint8_t *output,\0A                                            size_t output_size,\0A                                            size_t *output_length);\0A\0A/**\0A * \5Cbrief Decrypt a short message with a private key.\0A *\0A * \5Cparam attributes            The attributes for the key to import.\0A * \5Cparam key_buffer            Buffer where the key data is to be written.\0A * \5Cparam key_buffer_size       Size of the \5Cp key_buffer buffer in bytes.\0A * \5Cparam[in] input             The message to decrypt.\0A * \5Cparam input_length          Size of the \5Cp input buffer in bytes.\0A * \5Cparam[in] salt              A salt or label, if supported by the\0A *                              encryption algorithm.\0A *                              If the algorithm does not support a\0A *                              salt, pass \5Cc NULL.\0A *                              If the algorithm supports an optional\0A *                              salt and you do not want to pass a salt,\0A *                              pass \5Cc NULL.\0A *\0A *                              - For #PSA_ALG_RSA_PKCS1V15_CRYPT, no salt is\0A *                                supported.\0A * \5Cparam salt_length           Size of the \5Cp salt buffer in bytes.\0A *                              If \5Cp salt is \5Cc NULL, pass 0.\0A * \5Cparam[out] output           Buffer where the decrypted message is to\0A *                              be written.\0A * \5Cparam output_size           Size of the \5Cc output buffer in bytes.\0A * \5Cparam[out] output_length    On success, the number of bytes\0A *                              that make up the returned output.\0A *\0A * \5Cretval #PSA_SUCCESS \5Cemptydescription\0A * \5Cretval #PSA_ERROR_BUFFER_TOO_SMALL\0A *         The size of the \5Cp output buffer is too small. You can\0A *         determine a sufficient buffer size by calling\0A *         #PSA_ASYMMETRIC_DECRYPT_OUTPUT_SIZE(\5Cc key_type, \5Cc key_bits, \5Cp alg)\0A *         where \5Cc key_type and \5Cc key_bits are the type and bit-size\0A *         respectively of \5Cp key.\0A * \5Cretval #PSA_ERROR_NOT_SUPPORTED \5Cemptydescription\0A * \5Cretval #PSA_ERROR_INVALID_ARGUMENT \5Cemptydescription\0A * \5Cretval #PSA_ERROR_INSUFFICIENT_MEMORY \5Cemptydescription\0A * \5Cretval #PSA_ERROR_COMMUNICATION_FAILURE \5Cemptydescription\0A * \5Cretval #PSA_ERROR_HARDWARE_FAILURE \5Cemptydescription\0A * \5Cretval #PSA_ERROR_CORRUPTION_DETECTED \5Cemptydescription\0A * \5Cretval #PSA_ERROR_INSUFFICIENT_ENTROPY \5Cemptydescription\0A * \5Cretval #PSA_ERROR_INVALID_PADDING \5Cemptydescription\0A * \5Cretval #PSA_ERROR_BAD_STATE\0A *         The library has not been previously initialized by psa_crypto_init().\0A *         It is implementation-dependent whether a failure to initialize\0A *         results in this error code.\0A */\0Apsa_status_t mbedtls_psa_asymmetric_decrypt(const psa_key_attributes_t *attributes,\0A                                            const uint8_t *key_buffer,\0A                                            size_t key_buffer_size,\0A                                            psa_algorithm_t alg,\0A                                            const uint8_t *input,\0A                                            size_t input_length,\0A                                            const uint8_t *salt,\0A                                            size_t salt_length,\0A                                            uint8_t *output,\0A                                            size_t output_size,\0A                                            size_t *output_length);\0A\0A#endif /* PSA_CRYPTO_RSA_H */\0A\00" }
