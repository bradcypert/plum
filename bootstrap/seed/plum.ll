define ptr @plum_read_file_raw(ptr %path) {
entry:
  %pd = getelementptr i8, ptr %path, i64 16
  %sizep = alloca i64
  %buf = call ptr @plum_read_whole_file(ptr %pd, ptr %sizep)
  %isnull = icmp eq ptr %buf, null
