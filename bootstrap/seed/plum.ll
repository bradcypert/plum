@.str41057 = private global { i64, i64, [14819 x i8] } { i64 -1, i64 14818, [14819 x i8] c"// Whole-file I/O for the generated runtime. Keep libc's FILE,\0A// size_t and positioning types on the C side of the boundary: in\0A// particular, Windows long/ftell are only 32 bits even on 64-bit builds.\0A// The caller owns the returned buffer and must free it after copying it\0A// into a Plum cell. NULL means failure; an empty file still owns a buffer.\0A#if defined(__APPLE__)\0A#define _DARWIN_C_SOURCE 1\0A#endif\0A#if !defined(_WIN32)\0A#ifndef _FILE_OFFSET_BITS\0A#define _FILE_OFFSET_BITS 64\0A#endif\0A#ifndef _POSIX_C_SOURCE\0A#define _POSIX_C_SOURCE 200809L\0A#endif\0A#endif\0A\0A#include <stdint.h>\0A#include <stddef.h>\0A#include <stdio.h>\0A#include <stdlib.h>\0A#include <string.h>\0A#include <errno.h>\0A#include <sys/stat.h>\0A\0A#if defined(_WIN32)\0A#include <windows.h>\0A#include <winternl.h>\0A#include <fcntl.h>\0A#include <io.h>\0A#else\0A#include <unistd.h>\0A#include <fcntl.h>\0A#endif\0A\0A#if defined(_WIN32)\0A#define PLUM_WHOLE_SEEK _fseeki64\0A#define PLUM_WHOLE_TELL _ftelli64\0A#else\0A#define PLUM_WHOLE_SEEK fseeko\0A#define PLUM_WHOLE_TELL ftello\0A#endif\0A\0Achar *plum_read_whole_file(const char *path, long long *length) {\0A    *length = 0;\0A    FILE *f = fopen(path, \22rb\22);\0A    if (f == NULL) return NULL;\0A    char *buf = NULL;\0A\0A    if (PLUM_WHOLE_SEEK(f, 0, SEEK_END) != 0) goto fail;\0A    int64_t size = PLUM_WHOLE_TELL(f);\0A    // Also reserve the runtime cell's refcount, length and trailing NUL\0A    // (17 bytes). Neither native nor Plum allocation sizes may overflow.\0A    if (size < 0 || (uint64_t)size > INT64_MAX - 17 ||\0A        (uint64_t)size > SIZE_MAX - 17) goto fail;\0A    if (PLUM_WHOLE_SEEK(f, 0, SEEK_SET) != 0) goto fail;\0A\0A    buf = malloc((size_t)size + 1);\0A    if (buf == NULL) goto fail;\0A    size_t got = fread(buf, 1, (size_t)size, f);\0A    if (ferror(f) || got != (size_t)size) goto fail;\0A    if (fclose(f) != 0) {\0A        free(buf);\0A        return NULL;\0A    }\0A    buf[got] = '\5C0';\0A    *length = size;\0A    return buf;\0A\0Afail:\0A    fclose(f);\0A    free(buf);\0A    return NULL;\0A}\0A\0A// Shared with Os.rename_file. Never falls back to a cross-volume copy.\0Aextern long long os_rename_file(const char *from, const char *to);\0A\0A#if defined(_WIN32)\0Astatic wchar_t *plum_whole_wide(const char *path) {\0A    int n = MultiByteToWideChar(CP_UTF8, MB_ERR_INVALID_CHARS, path, -1, NULL, 0);\0A    if (n <= 0) return NULL;\0A    wchar_t *w = malloc((size_t)n * sizeof(wchar_t));\0A    if (w != NULL && !MultiByteToWideChar(CP_UTF8, MB_ERR_INVALID_CHARS, path, -1, w, n)) {\0A        free(w);\0A        return NULL;\0A    }\0A    return w;\0A}\0A#endif\0A\0A// Complete the stream before publication. Both ordinary whole-file writes\0A// and strict generated-output writes use this transaction boundary.\0Astatic int plum_whole_finish(FILE *f, const char *data, size_t length,\0A                             int preserve_mode, unsigned mode) {\0A    size_t wrote = fwrite(data, 1, length, f);\0A    int ok = wrote == length && !ferror(f);\0A#if !defined(_WIN32)\0A    if (ok && preserve_mode && fchmod(fileno(f), mode & 0777) != 0) ok = 0;\0A#else\0A    (void)preserve_mode;\0A    (void)mode;\0A#endif\0A    if (fclose(f) != 0) ok = 0;\0A    return ok;\0A}\0A\0A#if defined(_WIN32)\0A// Both MoveFileEx and an NT rename with RootDirectory reopen the destination\0A// directory for write access, conflicting with the ancestor locks. The NT\0A// same-directory form (bare filename, NULL RootDirectory) instead renames\0A// within the source handle's directory, without resolving another parent.\0Astatic int plum_whole_rename_in_place(const wchar_t *from, const wchar_t *to) {\0A    const wchar_t *leaf = wcsrchr(to, L'\5C\5C');\0A    if (!leaf || !*++leaf) return -1;\0A    size_t bytes = wcslen(leaf) * sizeof(wchar_t);\0A    size_t size = sizeof(FILE_RENAME_INFORMATION) + bytes;\0A    if (size > MAXDWORD) return -1;\0A    FILE_RENAME_INFORMATION *rename_info = malloc(size);\0A    if (!rename_info) return -1;\0A    memset(rename_info, 0, size);\0A    rename_info->ReplaceIfExists = TRUE;\0A    rename_info->RootDirectory = NULL;\0A    rename_info->FileNameLength = (DWORD)bytes;\0A    memcpy(rename_info->FileName, leaf, bytes);\0A    typedef NTSTATUS (NTAPI *Rename)(HANDLE, PIO_STATUS_BLOCK, PVOID, ULONG, FILE_INFORMATION_CLASS);\0A    HMODULE ntdll = GetModuleHandleW(L\22ntdll.dll\22);\0A    Rename rename_file = ntdll ? (Rename)(void *)GetProcAddress(ntdll, \22NtSetInformationFile\22) : NULL;\0A    if (!rename_file) { free(rename_info); return -1; }\0A    HANDLE file = CreateFileW(from, DELETE | FILE_READ_ATTRIBUTES,\0A        FILE_SHARE_READ | FILE_SHARE_WRITE | FILE_SHARE_DELETE, NULL, OPEN_EXISTING,\0A        FILE_FLAG_OPEN_REPARSE_POINT, NULL);\0A    int ok = 0;\0A    if (file != INVALID_HANDLE_VALUE) {\0A        BY_HANDLE_FILE_INFORMATION info;\0A        IO_STATUS_BLOCK status;\0A        ok = GetFileInformationByHandle(file, &info) &&\0A            !(info.dwFileAttributes & (FILE_ATTRIBUTE_DIRECTORY | FILE_ATTRIBUTE_REPARSE_POINT)) &&\0A            rename_file(file, &status, rename_info, (ULONG)size, FileRenameInformation) >= 0;\0A        CloseHandle(file);\0A    }\0A    free(rename_info);\0A    return ok ? 0 : -1;\0A}\0A#endif\0A\0A// Borrow the payload; do not copy it into another file-sized buffer.\0A// Only the sibling name (O(path length)) and libc's bounded FILE buffer\0A// are allocated here. Every ordinary failure releases both before return.\0Astatic long long plum_write_whole_file_impl(const char *path, const char *data, long long length,\0A                                            int strict) {\0A#if !defined(_WIN32)\0A    (void)strict;\0A#endif\0A    if (length < 0 || (uint64_t)length > SIZE_MAX) return -1;\0A    size_t n = strlen(path);\0A    if (n > SIZE_MAX - 64) return -1;\0A    char *tmp = malloc(n + 64);\0A    if (tmp == NULL