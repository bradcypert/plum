.g., it's about 5%\0A * better in AES-CBC).\0A *\0A * \5Cparam   r Pointer to result (buffer of at least \5Cp n bytes). \5Cp r\0A *            may be equal to either \5Cp a or \5Cp b, but behaviour when\0A *            it overlaps in other ways is undefined.\0A * \5Cparam   a Pointer to input (buffer of at least \5Cp n bytes)\0A * \5Cparam   b Pointer to input (buffer of at least \5Cp n bytes)\0A * \5Cparam   n Number of bytes to process.\0A *\0A * \5Cnote      Depending on the situation, it may be faster to use either mbedtls_xor() or\0A *            mbedtls_xor_no_simd() (these are functionally equivalent).\0A *            If the result is used immediately after the xor operation in non-SIMD code (e.g, in\0A *            AES-CBC), there may be additional latency to transfer the data from SIMD to scalar\0A *            registers, and in this case, mbedtls_xor_no_simd() may be faster. In other cases where\0A *            the result is not used immediately (e.g., in AES-CTR), mbedtls_xor() may be faster.\0A *            For targets without SIMD support, they will behave the same.\0A */\0Astatic inline void mbedtls_xor_no_simd(unsigned char *r,\0A                                       const unsigned char *a,\0A                                       const unsigned char *b,\0A                                       size_t n)\0A{\0A    size_t i = 0;\0A#if defined(MBEDTLS_EFFICIENT_UNALIGNED_ACCESS)\0A#if defined(MBEDTLS_ARCH_IS_X64) || defined(MBEDTLS_ARCH_IS_ARM64)\0A    /* This codepath probably only makes sense on architectures with 64-bit registers */\0A    for (; (i + 8) <= n; i += 8) {\0A        uint64_t x = mbedtls_get_unaligned_uint64(a + i) ^ mbedtls_get_unaligned_uint64(b + i);\0A        mbedtls_put_unaligned_uint64(r + i, x);\0A    }\0A#if defined(__IAR_SYSTEMS_ICC__)\0A    /* This if statement helps some compilers (e.g., IAR) optimise out the byte-by-byte tail case\0A     * where n is a constant multiple of 8.\0A     * For other compilers (e.g. recent gcc and clang) it makes no difference if n is a compile-time\0A     * constant, and is a very small perf regression if n is not a compile-time constant. */\0A    if (n % 8 == 0) {\0A        return;\0A    }\0A#endif\0A#else\0A    for (; (i + 4) <= n; i += 4) {\0A        uint32_t x = mbedtls_get_unaligned_uint32(a + i) ^ mbedtls_get_unaligned_uint32(b + i);\0A        mbedtls_put_unaligned_uint32(r + i, x);\0A    }\0A#if defined(__IAR_SYSTEMS_ICC__)\0A    if (n % 4 == 0) {\0A        return;\0A    }\0A#endif\0A#endif\0A#endif\0A    for (; i < n; i++) {\0A        r[i] = a[i] ^ b[i];\0A    }\0A}\0A\0A/* Fix MSVC C99 compatible issue\0A *      MSVC support __func__ from visual studio 2015( 1900 )\0A *      Use MSVC predefine macro to avoid name check fail.\0A */\0A#if (defined(_MSC_VER) && (_MSC_VER <= 1900))\0A#define /*no-check-names*/ __func__ __FUNCTION__\0A#endif\0A\0A/* Define `asm` for compilers which don't define it. */\0A/* *INDENT-OFF* */\0A#ifndef asm\0A#if defined(__IAR_SYSTEMS_ICC__)\0A#define asm __asm\0A#else\0A#define asm __asm__\0A#endif\0A#endif\0A/* *INDENT-ON* */\0A\0A/*\0A * Define the constraint used for read-only pointer operands to aarch64 asm.\0A *\0A * This is normally the usual \22r\22, but for aarch64_32 (aka ILP32,\0A * as found in watchos), \22p\22 is required to avoid warnings from clang.\0A *\0A * Note that clang does not recognise '+p' or '=p', and armclang\0A * does not recognise 'p' at all. Therefore, to update a pointer from\0A * aarch64 assembly, it is necessary to use something like:\0A *\0A * uintptr_t uptr = (uintptr_t) ptr;\0A * asm( \22ldr x4, [%x0], #8\22 ... : \22+r\22 (uptr) : : )\0A * ptr = (void*) uptr;\0A *\0A * Note that the \22x\22 in \22%x0\22 is neccessary; writing \22%0\22 will cause warnings.\0A */\0A#if defined(__aarch64__) && defined(MBEDTLS_HAVE_ASM)\0A#if UINTPTR_MAX == 0xfffffffful\0A/* ILP32: Specify the pointer operand slightly differently, as per #7787. */\0A#define MBEDTLS_ASM_AARCH64_PTR_CONSTRAINT \22p\22\0A#elif UINTPTR_MAX == 0xfffffffffffffffful\0A/* Normal case (64-bit pointers): use \22r\22 as the constraint for pointer operands to asm */\0A#define MBEDTLS_ASM_AARCH64_PTR_CONSTRAINT \22r\22\0A#else\0A#error \22Unrecognised pointer size for aarch64\22\0A#endif\0A#endif\0A\0A/* Always provide a static assert macro, so it can be used unconditionally.\0A * It does nothing on systems where we don't know how to define a static assert.\0A */\0A/* Can't use the C11-style `defined(static_assert)` on FreeBSD, since it\0A * defines static_assert even with -std=c99, but then complains about it.\0A */\0A#if defined(static_assert) && !defined(__FreeBSD__)\0A#define MBEDTLS_STATIC_ASSERT(expr, msg)    static_assert(expr, msg)\0A#else\0A/* Make sure `MBEDTLS_STATIC_ASSERT(expr, msg);` is valid both inside and\0A * outside a function. We choose a struct declaration, which can be repeated\0A * any number of times and does not need a matching definition. */\0A#define MBEDTLS_STATIC_ASSERT(expr, msg)                                \5C\0A    struct ISO_C_does_not_allow_extra_semicolon_outside_of_a_function\0A#endif\0A\0A#if defined(__has_builtin)\0A#define MBEDTLS_HAS_BUILTIN(x) __has_builtin(x)\0A#else\0A#define MBEDTLS_HAS_BUILTIN(x) 0\0A#endif\0A\0A/* Define compiler branch hints */\0A#if MBEDTLS_HAS_BUILTIN(__builtin_expect)\0A#define MBEDTLS_LIKELY(x)       __builtin_expect(!!(x), 1)\0A#define MBEDTLS_UNLIKELY(x)     __builtin_expect(!!(x), 0)\0A#else\0A#define MBEDTLS_LIKELY(x)       x\0A#define MBEDTLS_UNLIKELY(x)     x\0A#endif\0A\0A/* MBEDTLS_ASSUME may be used to provide additional information to the compiler\0A * which can result in smaller code-size. */\0A#if MBEDTLS_HAS_BUILTIN(__builtin_assume)\0A/* clang provides __builtin_assume */\0A#define MBEDTLS_ASSUME(x)       __builtin_assume(x)\0A#elif MBEDTLS_HAS_BUILTIN(__builtin_unreachable)\0A/* gcc and IAR can use __builtin_unreachable */\0A#define MBEDTLS_ASSUME(x)       do { if (!(x)) __builtin_unreachable(); } while (0)\0A#elif d