    {\0A        HANDLE h = (HANDLE)(intptr_t)slot->child->pid;\0A        long long ms = timeout_nanos / 1000000LL;\0A        if (timeout_nanos % 1000000LL != 0) ms++;\0A        DWORD w = WaitForSingleObject(h, ms > 0x7FFFFFFELL ? 0x7FFFFFFE : (DWORD)ms);\0A        if (w == WAIT_TIMEOUT) return 0;\0A        if (w != WAIT_OBJECT_0) return -1;\0A        DWORD code = 0;\0A        if (!GetExitCodeProcess(h, &code)) code = (DWORD)-1;\0A        plum_child_collect(handle, (long long)(int)code, 1);\0A        return 1;\0A    }\0A#else\0A    {\0A        long long waited = 0;\0A        long long step = 1000000LL; // 1ms\0A        for (;;) {\0A            long long r = process_poll(handle);\0A            if (r != 0) return r;\0A            if (waited >= timeout_nanos) return 0;\0A            long long left = timeout_nanos - waited;\0A            long long nap = step < left ? step : left;\0A            struct timespec req;\0A            req.tv_sec = (time_t)(nap / 1000000000LL);\0A            req.tv_nsec = (long)(nap % 1000000000LL);\0A            while (nanosleep(&req, &req) != 0 && errno == EINTR) { }\0A            waited += nap;\0A            step *= 2;\0A            if (step > 20000000LL) step = 20000000LL;\0A        }\0A    }\0A#endif\0A}\0A\0A// Asks the child to stop. `hard` of 0 is a polite request the child can\0A// handle or ignore (SIGTERM, and on Windows the only thing there is);\0A// non-zero cannot be refused (SIGKILL, `TerminateProcess`).\0A//\0A// Windows has no SIGTERM, so both spellings are `TerminateProcess` --\0A// a real difference, documented rather than papered over: a program\0A// that relies on a child cleaning up after a polite terminate will not\0A// get that on Windows.\0A//\0A// Returns 0 on success, -1 if the handle is not a live child. Signalling\0A// a child that has ALREADY exited is success, not failure: the caller\0A// asked for it to be gone and it is.\0Along long process_terminate(long long handle, long long hard) {\0A    PlumProcessSlot *slot