            for (i = MBEDTLS_GCM_HTABLE_SIZE/4; i > 0; i >>= 1) {\0A                gcm_gen_table_rightshift(ctx->H[i], ctx->H[i*2]);\0A            }\0A\0A#if !defined(MBEDTLS_GCM_LARGE_TABLE)\0A            /* pack elements of H as 64-bits ints, big-endian */\0A            for (i = MBEDTLS_GCM_HTABLE_SIZE/2; i > 0; i >>= 1) {\0A                MBEDTLS_PUT_UINT64_BE(ctx->H[i][0], &ctx->H[i][0], 0);\0A                MBEDTLS_PUT_UINT64_BE(ctx->H[i][1], &ctx->H[i][1], 0);\0A            }\0A#endif\0A\0A            for (i = 2; i < MBEDTLS_GCM_HTABLE_SIZE; i <<= 1) {\0A                for (j = 1; j < i; j++) {\0A                    mbedtls_xor_no_simd((unsigned char *) ctx->H[i+j],\0A                                        (unsigned char *) ctx->H[i],\0A                                        (unsigned char *) ctx->H[j],\0A                                        16);\0A                }\0A            }\0A    }\0A\0A    return 0;\0A}\0A\0Aint mbedtls_gcm_setkey(mbedtls_gcm_context *ctx,\0A                       mbedtls_cipher_id_t cipher,\0A                       const unsigned char *key,\0A                       unsigned int keybits)\0A{\0A    int ret = MBEDTLS_ERR_ERROR_CORRUPTION_DETECTED;\0A\0A    if (keybits != 128 && keybits != 192 && keybits != 256) {\0A        return MBEDTLS_ERR_GCM_BAD_INPUT;\0A    }\0A\0A#if defined(MBEDTLS_BLOCK_CIPHER_C)\0A    mbedtls_block_cipher_free(&ctx->block_cipher_ctx);\0A\0A    if ((ret = mbedtls_block_cipher_setup(&ctx->block_cipher_ctx, cipher)) != 0) {\0A        return ret;\0A    }\0A\0A    if ((ret = mbedtls_block_cipher_setkey(&ctx->block_cipher_ctx, key, keybits)) != 0) {\0A        return ret;\0A    }\0A#else\0A    const mbedtls_cipher_info_t *cipher_info;\0A\0A    cipher_info = mbedtls_cipher_info_from_values(cipher, keybits,\0A                                                  MBEDTLS_MODE_ECB);\0A    if (cipher_info == NULL) {\0A        return MBEDTLS_ERR_GCM_BAD_INPUT;\0A    }\0A\0A    if (mbedtls_cipher_info_get_block_size(cipher_info) != 16) {\0A        return MBEDTLS_ERR_GCM_BAD_INPUT;\0A    }\0A\0A    mbedtls_cipher_free(&ctx->cipher_ctx);\0A\0A    if ((ret = mbedtls_cipher_setup(&ctx->cipher_ctx, cipher_info)) != 0) {\0A        return ret;\0A    }\0A\0A    if ((ret = mbedtls_cipher_setkey(&ctx->cipher_ctx, key, keybits,\0A                                     MBEDTLS_ENCRYPT)) != 0) {\0A        return ret;\0A    }\0A#endif\0A\0A    if ((ret = gcm_gen_table(ctx)) != 0) {\0A        return ret;\0A    }\0A\0A    return 0;\0A}\0A\0A#if defined(MBEDTLS_GCM_LARGE_TABLE)\0Astatic const uint16_t last8[256] = {\0A    0x0000, 0xc201, 0x8403, 0x4602, 0x0807, 0xca06, 0x8c04, 0x4e05,\0A    0x100e, 0xd20f, 0x940d, 0x560c, 0x1809, 0xda08, 0x9c0a, 0x5e0b,\0A    0x201c, 0xe21d, 0xa41f, 0x661e, 0x281b, 0xea1a, 0xac18, 0x6e19,\0A    0x3012, 0xf213, 0xb411, 0x7610, 0x3815, 0xfa14, 0xbc16, 0x7e17,\0A    0x4038, 0x8239, 0xc43b, 0x063a, 0x483f, 0x8a3e, 0xcc3c, 0x0e3d,\0A    0x5036, 0x9237, 0xd435, 0x1634, 0x5831, 0x9a30, 0xdc32, 0x1e33,\0A    0x6024, 0xa225, 0xe427, 0x2626, 0x6823, 0xaa22, 0xec20, 0x2e21,\0A    0x702a, 0xb22b, 0xf429, 0x3628, 0x782d, 0xba2c, 0xfc2e, 0x3e2f,\0A    0x8070, 0x4271, 0x0473, 0xc672, 0x8877, 0x4a76, 0x0c74, 0xce75,\0A    0x907e, 0x527f, 0x147d, 0xd67c, 0x9879, 0x5a78, 0x1c7a, 0xde7b,\0A    0xa06c, 0x626d, 0x246f, 0xe66e, 0xa86b, 0x6a6a, 0x2c68, 0xee69,\0A    0xb062, 0x7263, 0x3461, 0xf660, 0xb865, 0x7a64, 0x3c66, 0xfe67,\0A    0xc048, 0x0249, 0x444b, 0x864a, 0xc84f, 0x0a4e, 0x4c4c, 0x8e4d,\0A    0xd046, 0x1247, 0x5445, 0x9644, 0xd841, 0x1a40, 0x5c42, 0x9e43,\0A    0xe054, 0x2255, 0x6457, 0xa656, 0xe853, 0x2a52, 0x6c50, 0xae51,\0A    0xf05a, 0x325b, 0x7459, 0xb658, 0xf85d, 0x3a5c, 0x7c5e, 0xbe5f,\0A    0x00e1, 0xc2e0, 0x84e2, 0x46e3, 0x08e6, 0xcae7, 0x8ce5, 0x4ee4,\0A    0x10ef, 0xd2ee, 0x94ec, 0x56ed, 0x18e8, 0xdae9, 0x9ceb, 0x5eea,\0A    0x20fd, 0xe2fc, 0xa4fe, 0x66ff, 0x28fa, 0xeafb, 0xacf9, 0x6ef8,\0A    0x30f3, 0xf2f2, 0xb4f0, 0x76f1, 0x38f4, 0xfaf5, 0xbcf7, 0x7ef6,\0A    0x40