@.str40841 = private global { i64, i64, [7421 x i8] } { i64 -1, i64 7420, [7421 x i8] c"/*\0A *  Context structure declaration of the Mbed TLS software-based PSA drivers\0A *  called through the PSA Crypto driver dispatch layer.\0A *  This file contains the context structures of those algorithms which need to\0A *  rely on other algorithms, i.e. are 'composite' algorithms.\0A *\0A * \5Cnote This file may not be included directly. Applications must\0A * include psa/crypto.h.\0A *\0A * \5Cnote This header and its content are not part of the Mbed TLS API and\0A * applications must not depend on it. Its main purpose is to define the\0A * multi-part state objects of the Mbed TLS software-based PSA drivers. The\0A * definitions of these objects are then used by crypto_struct.h to define the\0A * implementation-defined types of PSA multi-part state objects.\0A */\0A/*\0A *  Copyright The Mbed TLS Contributors\0A *  SPDX-License-Identifier: Apache-2.0 OR GPL-2.0-or-later\0A */\0A\0A#ifndef PSA_CRYPTO_BUILTIN_COMPOSITES_H\0A#define PSA_CRYPTO_BUILTIN_COMPOSITES_H\0A#include \22mbedtls/private_access.h\22\0A\0A#include <psa/crypto_driver_common.h>\0A\0A#include \22mbedtls/cmac.h\22\0A#if defined(MBEDTLS_PSA_BUILTIN_ALG_GCM)\0A#include \22mbedtls/gcm.h\22\0A#endif\0A#if defined(MBEDTLS_PSA_BUILTIN_ALG_CCM)\0A#include \22mbedtls/ccm.h\22\0A#endif\0A#include \22mbedtls/chachapoly.h\22\0A\0A/*\0A * MAC multi-part operation definitions.\0A */\0A#if defined(MBEDTLS_PSA_BUILTIN_ALG_CMAC) || \5C\0A    defined(MBEDTLS_PSA_BUILTIN_ALG_HMAC)\0A#define MBEDTLS_PSA_BUILTIN_MAC\0A#endif\0A\0A#if defined(MBEDTLS_PSA_BUILTIN_ALG_HMAC) || defined(PSA_CRYPTO_DRIVER_TEST)\0Atypedef struct {\0A    /** The HMAC algorithm in use */\0A    psa_algorithm_t MBEDTLS_PRIVATE(alg);\0A    /** The hash context. */\0A    struct psa_hash_operation_s hash_ctx;\0A    /** The HMAC part of the context. */\0A    uint8_t MBEDTLS_PRIVATE(opad)[PSA_HMAC_MAX_HASH_BLOCK_SIZE];\0A} mbedtls_psa_hmac_operation_t;\0A\0A#define MBEDTLS_PSA_HMAC_OPERATION_INIT { 0, PSA_HASH_OPERATION_INIT, { 0 } }\0A#endif /* MBEDTLS_PSA_BUILTIN_ALG_HMAC */\0A\0Atypedef struct {\0A    psa_algorithm_t MBEDTLS_PRIVATE(alg);\0A    union {\0A        unsigned MBEDTLS_PRIVATE(dummy); /* Make the union non-empty even with no supported algorithms. */\0A#if defined(MBEDTLS_PSA_BUILTIN_ALG_HMAC) || defined(PSA_CRYPTO_DRIVER_TEST)\0A        mbedtls_psa_hmac_operation_t MBEDTLS_PRIVATE(hmac);\0A#endif /* MBEDTLS_PSA_BUILTIN_ALG_HMAC */\0A#if defined(MBEDTLS_PSA_BUILTIN_ALG_CMAC) || defined(PSA_CRYPTO_DRIVER_TEST)\0A        mbedtls_cipher_context_t MBEDTLS_PRIVATE(cmac);\0A#endif /* MBEDTLS_PSA_BUILTIN_ALG_CMAC */\0A    } MBEDTLS_PRIVATE(ctx);\0A} mbedtls_psa_mac_operation_t;\0A\0A#define MBEDTLS_PSA_MAC_OPERATION_INIT { 0, { 0 } }\0A\0A#if defined(MBEDTLS_PSA_BUILTIN_ALG_GCM) || \5C\0A    defined(MBEDTLS_PSA_BUILTIN_ALG_CCM) || \5C\0A    defined(MBEDTLS_PSA_BUILTIN_ALG_CHACHA20_POLY1305)\0A#define MBEDTLS_PSA_BUILTIN_AEAD  1\0A#endif\0A\0A/* Context structure for the Mbed TLS AEAD implementation. */\0Atypedef struct {\0A    psa_algorithm_t MBEDTLS_PRIVATE(alg);\0A    psa_key_type_t MBEDTLS_PRIVATE(key_type);\0A\0A    unsigned int MBEDTLS_PRIVATE(is_encrypt) : 1;\0A\0A    uint8_t MBEDTLS_PRIVATE(tag_length);\0A\0A    union {\0A        unsigned dummy; /* Enable easier initializing of the union. */\0A#if defined(MBEDTLS_PSA_BUILTIN_ALG_CCM)\0A        mbedtls_ccm_context MBEDTLS_PRIVATE(ccm);\0A#endif /* MBEDTLS_PSA_BUILTIN_ALG_CCM */\0A#if defined(MBEDTLS_PSA_BUILTIN_ALG_GCM)\0A        mbedtls_gcm_context MBEDTLS_PRIVATE(gcm);\0A#endif /* MBEDTLS_PSA_BUILTIN_ALG_GCM */\0A#if defined(MBEDTLS_PSA_BUILTIN_ALG_CHACHA20_POLY1305)\0A        mbedtls_chachapoly_context MBEDTLS_PRIVATE(chachapoly);\0A#endif /* MBEDTLS_PSA_BUILTIN_ALG_CHACHA20_POLY1305 */\0A\0A    } ctx;\0A\0A} mbedtls_psa_aead_operation_t;\0A\0A#define MBEDTLS_PSA_AEAD_OPERATION_INIT { 0, 0, 0, 0, { 0 } }\0A\0A#include \22mbedtls/ecdsa.h\22\0A\0A/* Context structure for the Mbed TLS interruptible sign hash implementation. */\0Atypedef struct {\0A#if (defined(MBEDTLS_PSA_BUILTIN_ALG_ECDSA) || \5C\0A    defined(MBEDTLS_PSA_BUILTIN_ALG_DETERMINISTIC_ECDSA)) && \5C\0A    defined(MBEDTLS_ECP_RESTARTABLE)\0A    mbedtls_ecdsa_context *MBEDTLS_PRIVATE(ctx);\0A    mbedtls_ecdsa_restart_ctx MBEDTLS_PRIVATE(restart_ctx);\0A\0A    uint32_t MBEDTLS_PRIVATE(num_ops);\0A\0A    size_t MBEDTLS_PRIVATE(coordinate_bytes);\0A    psa_algorithm_t MBEDTLS_PRIVATE(alg);\0A    mbedtls_md_type_t MBEDTLS_PRIVATE(md_alg);\0A    uint8_t MBEDTLS_PRIVATE(hash)[PSA_BITS_TO_BYTES(PSA_VENDOR_ECC_MAX_CURVE_BITS)];\0A    size_t MBEDTLS_PRIVATE(hash_length);\0A\0A#else\0A    /* Make the struct non-empty if algs not supported. */\0A    unsigned MBEDTLS_PRIVATE(dummy);\0A\0A#endif /* defined(MBEDTLS_PSA_BUILTIN_ALG_ECDSA) ||\0A        * defined(MBEDTLS_PSA_BUILTIN_ALG_DETERMINISTIC_ECDSA) &&\0A        * defined( MBEDTLS_ECP_RESTARTABLE ) */\0A} mbedtls_psa_sign_hash_interruptible_operation_t;\0A\0A#if (defined(MBEDTLS_PSA_BUILTIN_ALG_ECDSA) || \5C\0A    defined(MBEDTLS_PSA_BUILTIN_ALG_DETERMINISTIC_ECDSA)) && \5C\0A    defined(MBEDTLS_ECP_RESTARTABLE)\0A#define MBEDTLS_PSA_SIGN_HASH_INTERRUPTIBLE_OPERATION_INIT { { 0 }, { 0 }, 0, 0, 0, 0, 0, 0 }\0A#else\0A#define MBEDTLS_PSA_SIGN_HASH_INTERRUPTIBLE_OPERATION_INIT { 0 }\0A#endif\0A\0A/* Context structure for the Mbed TLS interruptible verify hash\0A * implementation.*/\0Atypedef struct {\0A#if (defined(MBEDTLS_PSA_BUILTIN_ALG_ECDSA) || \5C\0A    defined(MBEDTLS_PSA_BUILTIN_ALG_DETERMINISTIC_ECDSA)) && \5C\0A    defined(MBEDTLS_ECP_RESTARTABLE)\0A\0A    mbedtls_ecdsa_context *MBEDTLS_PRIVATE(ctx);\0A    mbedtls_ecdsa_restart_ctx MBEDTLS_PRIVATE(restart_ctx);\0A\0A    uint32_t MBEDTLS_PRIVATE(num_ops);\0A\0A    uint8_t MBEDTLS_PRIVATE(hash)[PSA_BITS_TO_BYTES(PSA_VENDOR_ECC_MAX_CURVE_BITS)];\0A    size_t MBEDTLS_PRIVATE(hash_length);\0A\0A    mbedtls_mpi MBEDTLS_PRIVATE(r);\0A    mbedtls_mpi MBEDTLS_PRIVATE(s);\0A\0A#else\0A    /* Make the struct non-empty if algs not supported. */\0A    unsigned MBEDTLS_PRIVATE(dummy);\0A\0A#endif /* defined(MBEDTLS_PSA_BUILTIN_ALG_ECDSA) ||\0A        * defined(MBEDTLS_PSA_BUILTIN_ALG_DETERMINISTIC_ECDSA) &&\0A        * defined( MBEDTLS_ECP_RESTARTABLE ) */\0A\0A} mbedtls_psa_verify_hash_interruptible_operation_t;\0A\0A#if (defined(MBEDTLS_PSA_BUILTIN_ALG_ECDSA) || \5C\0A    defined(MBEDTLS_PSA_BUILTIN_ALG_DETERMINISTIC_ECDSA)) && \5C\0A    defined(MBEDTLS_ECP_RESTARTABLE)\0A#define MBEDTLS_VERIFY_SIGN_HASH_INTERRUPTIBLE_OPERATION_INIT { { 0 }, { 0 }, 0, 0, 0, 0, { 0 }, \5C\0A        { 0 } }\0A#else\0A#define MBEDTLS_VERIFY_SIGN_HASH_INTERRUPTIBLE_OPERATION_INIT { 0 }\0A#endif\0A\0A\0A/* EC-JPAKE operation definitions */\0A\0A#include \22mbedtls/ecjpake.h\22\0A\0A#if defined(MBEDTLS_PSA_BUILTIN_ALG_JPAKE)\0A#define MBEDTLS_PSA_BUILTIN_PAKE  1\0A#endif\0A\0A/* Note: the format for mbedtls_ecjpake_read/write function has an extra\0A * length byte for each step, plus an extra 3 bytes for ECParameters in the\0A * server's 2nd round. */\0A#define MBEDTLS_PSA_JPAKE_BUFFER_SIZE ((3 + 1 + 65 + 1 + 65 + 1 + 32) * 2)\0A\0Atypedef struct {\0A    psa_algorithm_t MBEDTLS_PRIVATE(alg);\0A\0A    uint8_t *MBEDTLS_PRIVATE(password);\0A    size_t MBEDTLS_PRIVATE(password_len);\0A#if defined(MBEDTLS_PSA_BUILTIN_ALG_JPAKE)\0A    mbedtls_ecjpake_role MBEDTLS_PRIVATE(role);\0A    uint8_t MBEDTLS_PRIVATE(buffer[MBEDTLS_PSA_JPAKE_BUFFER_SIZE]);\0A    size_t MBEDTLS_PRIVATE(buffer_length);\0A    size_t MBEDTLS_PRIVATE(buffer_offset);\0A#endif\0A    /* Context structure for the Mbed TLS EC-JPAKE implementation. */\0A    union {\0A        unsigned int MBEDTLS_PRIVATE(dummy);\0A#if defined(MBEDTLS_PSA_BUILTIN_ALG_JPAKE)\0A        mbedtls_ecjpake_context MBEDTLS_PRIVATE(jpake);\0A#endif\0A    } MBEDTLS_PRIVATE(ctx);\0A\0A} mbedtls_psa_pake_operation_t;\0A\0A#define MBEDTLS_PSA_PAKE_OPERATION_INIT { { 0 } }\0A\0A#endif /* PSA_CRYPTO_BUILTIN_COMPOSITES_H */\0A\00" }
