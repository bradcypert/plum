@.str45836 = private global { i64, i64, [8812 x i8] } { i64 -1, i64 8811, [8812 x i8] c"/*\0A * Common and shared functions used by multiple modules in the Mbed TLS\0A * library.\0A *\0A *  Copyright The Mbed TLS Contributors\0A *  SPDX-License-Identifier: Apache-2.0 OR GPL-2.0-or-later\0A */\0A\0A/*\0A * Ensure gmtime_r is available even with -std=c99; must be defined before\0A * mbedtls_config.h, which pulls in glibc's features.h. Harmless on other platforms\0A * except OpenBSD, where it stops us accessing explicit_bzero.\0A */\0A#if !defined(_POSIX_C_SOURCE) && !defined(__OpenBSD__)\0A#define _POSIX_C_SOURCE 200112L\0A#endif\0A\0A#if !defined(_GNU_SOURCE)\0A/* Clang requires this to get support for explicit_bzero */\0A#define _GNU_SOURCE\0A#endif\0A\0A#include \22common.h\22\0A\0A#include \22mbedtls/platform_util.h\22\0A#include \22mbedtls/platform.h\22\0A#include \22mbedtls/threading.h\22\0A\0A#include <stddef.h>\0A\0A#ifndef __STDC_WANT_LIB_EXT1__\0A#define __STDC_WANT_LIB_EXT1__ 1 /* Ask for the C11 gmtime_s() and memset_s() if available */\0A#endif\0A#include <string.h>\0A\0A#if defined(_WIN32)\0A#include <windows.h>\0A#endif\0A\0A// Detect platforms known to support explicit_bzero()\0A#if defined(__GLIBC__) && (__GLIBC__ >= 2) && (__GLIBC_MINOR__ >= 25)\0A#define MBEDTLS_PLATFORM_HAS_EXPLICIT_BZERO 1\0A#elif (defined(__FreeBSD__) && (__FreeBSD_version >= 1100037)) || defined(__OpenBSD__)\0A#define MBEDTLS_PLATFORM_HAS_EXPLICIT_BZERO 1\0A#endif\0A\0A#if !defined(MBEDTLS_PLATFORM_ZEROIZE_ALT)\0A\0A#undef HAVE_MEMORY_SANITIZER\0A#if defined(__has_feature)\0A#if __has_feature(memory_sanitizer)\0A#include <sanitizer/msan_interface.h>\0A#define HAVE_MEMORY_SANITIZER\0A#endif\0A#endif\0A\0A/*\0A * Where possible, we try to detect the presence of a platform-provided\0A * secure memset, such as explicit_bzero(), that is safe against being optimized\0A * out, and use that.\0A *\0A * For other platforms, we provide an implementation that aims not to be\0A * optimized out by the compiler.\0A *\0A * This implementation for mbedtls_platform_zeroize() was inspired from Colin\0A * Percival's blog article at:\0A *\0A * http://www.daemonology.net/blog/2014-09-04-how-to-zero-a-buffer.html\0A *\0A * It uses a volatile function pointer to the standard memset(). Because the\0A * pointer is volatile the compiler expects it to change at\0A * any time and will not optimize out the call that could potentially perform\0A * other operations on the input buffer instead of just setting it to 0.\0A * Nevertheless, as pointed out by davidtgoldblatt on Hacker News\0A * (refer to http://www.daemonology.net/blog/2014-09-05-erratum.html for\0A * details), optimizations of the following form are still possible:\0A *\0A * if (memset_func != memset)\0A *     memset_func(buf, 0, len);\0A *\0A * Note that it is extremely difficult to guarantee that\0A * the memset() call will not be optimized out by aggressive compilers\0A * in a portable way. For this reason, Mbed TLS also provides the configuration\0A * option MBEDTLS_PLATFORM_ZEROIZE_ALT, which allows users to configure\0A * mbedtls_platform_zeroize() to use a suitable implementation for their\0A * platform and needs.\0A */\0A#if !defined(MBEDTLS_PLATFORM_HAS_EXPLICIT_BZERO) && !(defined(__STDC_LIB_EXT1__) && \5C\0A    !defined(__IAR_SYSTEMS_ICC__)) \5C\0A    && !defined(_WIN32)\0Astatic void *(*const volatile memset_func)(void *, int, size_t) = memset;\0A#endif\0A\0Avoid mbedtls_platform_zeroize(void *buf, size_t len)\0A{\0A    if (len > 0) {\0A#if defined(MBEDTLS_PLATFORM_HAS_EXPLICIT_BZERO)\0A        explicit_bzero(buf, len);\0A#if defined(HAVE_MEMORY_SANITIZER)\0A        /* You'd think that Msan would recognize explicit_bzero() as\0A         * equivalent to bzero(), but it actually doesn't on several\0A         * platforms, including Linux (Ubuntu 20.04).\0A         * https://github.com/google/sanitizers/issues/1507\0A         * https://github.com/openssh/openssh-portable/commit/74433a19bb6f4cef607680fa4d1d7d81ca3826aa\0A         */\0A        __msan_unpoison(buf, len);\0A#endif\0A#elif defined(__STDC_LIB_EXT1__) && !defined(__IAR_SYSTEMS_ICC__)\0A        memset_s(buf, len, 0, len);\0A#elif defined(_WIN32)\0A        SecureZeroMemory(buf, len);\0A#else\0A        memset_func(buf, 0, len);\0A#endif\0A\0A#if defined(__GNUC__)\0A        /* For clang and recent gcc, pretend that we have some assembly that reads the\0A         * zero'd memory as an additional protection against being optimised away. */\0A#if defined(__clang__) || (__GNUC__ >= 10)\0A#if defined(__clang__)\0A#pragma clang diagnostic push\0A#pragma clang diagnostic ignored \22-Wvla\22\0A#elif defined(MBEDTLS_COMPILER_IS_GCC)\0A#pragma GCC diagnostic push\0A#pragma GCC diagnostic ignored \22-Wvla\22\0A#endif\0A        asm volatile (\22\22 : : \22m\22 (*(char (*)[len]) buf) :);\0A#if defined(__clang__)\0A#pragma clang diagnostic pop\0A#elif defined(MBEDTLS_COMPILER_IS_GCC)\0A#pragma GCC diagnostic pop\0A#endif\0A#endif\0A#endif\0A    }\0A}\0A#endif /* MBEDTLS_PLATFORM_ZEROIZE_ALT */\0A\0Avoid mbedtls_zeroize_and_free(void *buf, size_t len)\0A{\0A    if (buf != NULL) {\0A        mbedtls_platform_zeroize(buf, len);\0A    }\0A\0A    mbedtls_free(buf);\0A}\0A\0A#if defined(MBEDTLS_HAVE_TIME_DATE) && !defined(MBEDTLS_PLATFORM_GMTIME_R_ALT)\0A#include <time.h>\0A#if !defined(_WIN32) && (defined(unix) || \5C\0A    defined(__unix) || defined(__unix__) || (defined(__APPLE__) && \5C\0A    defined(__MACH__)) || defined(__midipix__))\0A#include <unistd.h>\0A#endif /* !_WIN32 && (unix || __unix || __unix__ ||\0A        * (__APPLE__ && __MACH__) || __midipix__) */\0A\0A#if !((defined(_POSIX_VERSION) && _POSIX_VERSION >= 200809L) ||     \5C\0A    (defined(_POSIX_THREAD_SAFE_FUNCTIONS) &&                     \5C\0A    _POSIX_THREAD_SAFE_FUNCTIONS >= 200112L))\0A/*\0A * This is a convenience shorthand macro to avoid checking the long\0A * preprocessor conditions above. Ideally, we could expose this macro in\0A * platform_util.h and simply use it in platform_util.c, threading.c and\0A * threading.h. However, this macro is not part of the Mbed TLS public API, so\0A * we keep it private by only defining it in this file\0A */\0A#if !(defined(_WIN32) && !defined(EFIX64) && !defined(EFI32)) || \5C\0A    (defined(__MINGW32__) && !defined(__MINGW64_VERSION_MAJOR))\0A#define PLATFORM_UTIL_USE_GMTIME\0A#endif\0A\0A#endif /* !( ( defined(_POSIX_VERSION) && _POSIX_VERSION >= 200809L ) || \5C\0A             ( defined(_POSIX_THREAD_SAFE_FUNCTIONS ) && \5C\0A                _POSIX_THREAD_SAFE_FUNCTIONS >= 200112L ) ) */\0A\0Astruct tm *mbedtls_platform_gmtime_r(const mbedtls_time_t *tt,\0A                                     struct tm *tm_buf)\0A{\0A#if defined(_WIN32) && !defined(PLATFORM_UTIL_USE_GMTIME)\0A#if defined(__STDC_LIB_EXT1__)\0A    return (gmtime_s(tt, tm_buf) == 0) ? NULL : tm_buf;\0A#else\0A    /* MSVC and mingw64 argument order and return value are inconsistent with the C11 standard */\0A    return (gmtime_s(tm_buf, tt) == 0) ? tm_buf : NULL;\0A#endif\0A#elif !defined(PLATFORM_UTIL_USE_GMTIME)\0A    return gmtime_r(tt, tm_buf);\0A#else\0A    struct tm *lt;\0A\0A#if defined(MBEDTLS_THREADING_C)\0A    if (mbedtls_mutex_lock(&mbedtls_threading_gmtime_mutex) != 0) {\0A        return NULL;\0A    }\0A#endif /* MBEDTLS_THREADING_C */\0A\0A    lt = gmtime(tt);\0A\0A    if (lt != NULL) {\0A        memcpy(tm_buf, lt, sizeof(struct tm));\0A    }\0A\0A#if defined(MBEDTLS_THREADING_C)\0A    if (mbedtls_mutex_unlock(&mbedtls_threading_gmtime_mutex) != 0) {\0A        return NULL;\0A    }\0A#endif /* MBEDTLS_THREADING_C */\0A\0A    return (lt == NULL) ? NULL : tm_buf;\0A#endif /* _WIN32 && !EFIX64 && !EFI32 */\0A}\0A#endif /* MBEDTLS_HAVE_TIME_DATE && MBEDTLS_PLATFORM_GMTIME_R_ALT */\0A\0A#if defined(MBEDTLS_TEST_HOOKS)\0Avoid (*mbedtls_test_hook_test_fail)(const char *, int, const char *);\0A#endif /* MBEDTLS_TEST_HOOKS */\0A\0A#if defined(MBEDTLS_HAVE_TIME) && !defined(MBEDTLS_PLATFORM_MS_TIME_ALT)\0A\0A#include <time.h>\0A#if !defined(_WIN32) && \5C\0A    (defined(unix) || defined(__unix) || defined(__unix__) || \5C\0A    (defined(__APPLE__) && defined(__MACH__)) || defined(__HAIKU__) || defined(__midipix__))\0A#include <unistd.h>\0A#endif \5C\0A    /* !_WIN32 && (unix || __unix || __unix__ || (__APPLE__ && __MACH__) || __HAIKU__ || __midipix__) */\0A#if (defined(_POSIX_VERSION) && _POSIX_VERSION >= 199309L) || defined(__HAIKU__)\0Ambedtls_ms_time_t mbedtls_ms_time(void)\0A{\0A    int ret;\0A    struct timespec tv;\0A    mbedtls_ms_time_t current_ms;\0A\0A#if defined(__linux__) && defined(CLOCK_BOOTTIME) || defined(__midipix__)\0A    ret = clock_gettime(CLOCK_BOOTTIME, &tv);\0A#else\0A    ret = clock_gettime(CLOCK_MONOTONIC, &tv);\0A#endif\0A    if (ret) {\0A        return time(NULL) * 1000;\0A    }\0A\0A    current_ms = tv.tv_sec;\0A\0A    return current_ms*1000 + tv.tv_nsec / 1000000;\0A}\0A#elif defined(_WIN32) || defined(WIN32) || defined(__CYGWIN__) || \5C\0A    defined(__MINGW32__) || defined(_WIN64)\0A#include <windows.h>\0Ambedtls_ms_time_t mbedtls_ms_time(void)\0A{\0A    FILETIME ct;\0A    mbedtls_ms_time_t current_ms;\0A\0A    GetSystemTimeAsFileTime(&ct);\0A    current_ms = ((mbedtls_ms_time_t) ct.dwLowDateTime +\0A                  ((mbedtls_ms_time_t) (ct.dwHighDateTime) << 32LL))/10000;\0A    return current_ms;\0A}\0A#else\0A#error \22No mbedtls_ms_time available\22\0A#endif\0A#endif /* MBEDTLS_HAVE_TIME && !MBEDTLS_PLATFORM_MS_TIME_ALT */\0A\00" }
