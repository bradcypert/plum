@.str46121 = private global { i64, i64, [329922 x i8] } { i64 -1, i64 329921, [329922 x i8] c"/*\0A *  TLS shared functions\0A *\0A *  Copyright The Mbed TLS Contributors\0A *  SPDX-License-Identifier: Apache-2.0 OR GPL-2.0-or-later\0A */\0A/*\0A *  http://www.ietf.org/rfc/rfc2246.txt\0A *  http://www.ietf.org/rfc/rfc4346.txt\0A */\0A\0A#include \22common.h\22\0A\0A#if defined(MBEDTLS_SSL_TLS_C)\0A\0A#include \22mbedtls/platform.h\22\0A\0A#include \22mbedtls/ssl.h\22\0A#include \22ssl_client.h\22\0A#include \22ssl_debug_helpers.h\22\0A#include \22ssl_misc.h\22\0A\0A#include \22debug_internal.h\22\0A#include \22mbedtls/error.h\22\0A#include \22mbedtls/platform_util.h\22\0A#include \22mbedtls/version.h\22\0A#include \22mbedtls/constant_time.h\22\0A\0A#include <string.h>\0A\0A#if defined(MBEDTLS_USE_PSA_CRYPTO)\0A#include \22mbedtls/psa_util.h\22\0A#include \22md_psa.h\22\0A#include \22psa_util_internal.h\22\0A#include \22psa/crypto.h\22\0A#endif\0A\0A#if defined(MBEDTLS_X509_CRT_PARSE_C)\0A#include \22mbedtls/oid.h\22\0A#endif\0A\0A#if defined(MBEDTLS_USE_PSA_CRYPTO)\0A/* Define local translating functions to save code size by not using too many\0A * arguments in each translating place. */\0Astatic int local_err_translation(psa_status_t status)\0A{\0A    return psa_status_to_mbedtls(status, psa_to_ssl_errors,\0A                                 ARRAY_LENGTH(psa_to_ssl_errors),\0A                                 psa_generic_status_to_mbedtls);\0A}\0A#define PSA_TO_MBEDTLS_ERR(status) local_err_translation(status)\0A#endif\0A\0A#if defined(MBEDTLS_TEST_HOOKS)\0Astatic mbedtls_ssl_chk_buf_ptr_args chk_buf_ptr_fail_args;\0A\0Avoid mbedtls_ssl_set_chk_buf_ptr_fail_args(\0A    const uint8_t *cur, const uint8_t *end, size_t need)\0A{\0A    chk_buf_ptr_fail_args.cur = cur;\0A    chk_buf_ptr_fail_args.end = end;\0A    chk_buf_ptr_fail_args.need = need;\0A}\0A\0Avoid mbedtls_ssl_reset_chk_buf_ptr_fail_args(void)\0A{\0A    memset(&chk_buf_ptr_fail_args, 0, sizeof(chk_buf_ptr_fail_args));\0A}\0A\0Aint mbedtls_ssl_cmp_chk_buf_ptr_fail_args(mbedtls_ssl_chk_buf_ptr_args *args)\0A{\0A    return (chk_buf_ptr_fail_args.cur  != args->cur) ||\0A           (chk_buf_ptr_fail_args.end  != args->end) ||\0A           (chk_buf_ptr_fail_args.need != args->need);\0A}\0A#endif /* MBEDTLS_TEST_HOOKS */\0A\0A#if defined(MBEDTLS_SSL_PROTO_DTLS)\0A\0A#if defined(MBEDTLS_SSL_DTLS_CONNECTION_ID)\0A/* Top-level Connection ID API */\0A\0Aint mbedtls_ssl_conf_cid(mbedtls_ssl_config *conf,\0A                         size_t len,\0A                         int ignore_other_cid)\0A{\0A    if (len > MBEDTLS_SSL_CID_IN_LEN_MAX) {\0A        return MBEDTLS_ERR_SSL_BAD_INPUT_DATA;\0A    }\0A\0A    if (ignore_other_cid != MBEDTLS_SSL_UNEXPECTED_CID_FAIL &&\0A        ignore_other_cid != MBEDTLS_SSL_UNEXPECTED_CID_IGNORE) {\0A        return MBEDTLS_ERR_SSL_BAD_INPUT_DATA;\0A    }\0A\0A    conf->ignore_unexpected_cid = ignore_other_cid;\0A    conf->cid_len = len;\0A    return 0;\0A}\0A\0Aint mbedtls_ssl_set_cid(mbedtls_ssl_context *ssl,\0A                        int enable,\0A                        unsigned char const *own_cid,\0A                        size_t own_cid_len)\0A{\0A    if (ssl->conf->transport != MBEDTLS_SSL_TRANSPORT_DATAGRAM) {\0A        return MBEDTLS_ERR_SSL_BAD_INPUT_DATA;\0A    }\0A\0A    ssl->negotiate_cid = enable;\0A    if (enable == MBEDTLS_SSL_CID_DISABLED) {\0A        MBEDTLS_SSL_DEBUG_MSG(3, (\22Disable use of CID extension.\22));\0A        return 0;\0A    }\0A    MBEDTLS_SSL_DEBUG_MSG(3, (\22Enable use of CID extension.\22));\0A    MBEDTLS_SSL_DEBUG_BUF(3, \22Own CID\22, own_cid, own_cid_len);\0A\0A    if (own_cid_len != ssl->conf->cid_len) {\0A        MBEDTLS_SSL_DEBUG_MSG(3, (\22CID length %u does not match CID length %u in config\22,\0A                                  (unsigned) own_cid_len,\0A                                  (unsigned) ssl->conf->cid_len));\0A        return MBEDTLS_ERR_SSL_BAD_INPUT_DATA;\0A    }\0A\0A    memcpy(ssl->own_cid, own_cid, own_cid_len);\0A    /* Truncation is not an issue here because\0A     * MBEDTLS_SSL_CID_IN_LEN_MAX at most 255. */\0A    ssl->own_cid_len = (uint8_t) own_cid_len;\0A\0A    return 0;\0A}\0A\0Aint mbedtls_ssl_get_own_cid(mbedtls_ssl_context *ssl,\0A                            int *enabled,\0A                            unsigned char own_cid[MBEDTLS_SSL_CID_IN_LEN_MAX],\0A                            size_t *own_cid_len)\0A{\0A    *enabled = MBEDTLS_SSL_CID_DISABLED;\0A\0A    if (ssl->conf->transport != MBEDTLS_SSL_TRANSPORT_DATAGRAM) {\0A        return MBEDTLS_ERR_SSL_BAD_INPUT_DATA;\0A    }\0A\0A    /* We report MBEDTLS_SSL_CID_DISABLED in case the CID length is\0A     * zero as this is indistinguishable from not requesting to use\0A     * the CID extension. */\0A    if (ssl->own_cid_len == 0 || ssl->negotiate_cid == MBEDTLS_SSL_CID_DISABLED) {\0A        return 0;\0A    }\0A\0A    if (own_cid_len != NULL) {\0A        *own_cid_len = ssl->own_cid_len;\0A        if (own_cid != NULL) {\0A            memcpy(own_cid, ssl->own_cid, ssl->own_cid_len);\0A        }\0A    }\0A\0A    *enabled = MBEDTLS_SSL_CID_ENABLED;\0A\0A    return 0;\0A}\0A\0Aint mbedtls_ssl_get_peer_cid(mbedtls_ssl_context *ssl,\0A                             int *enabled,\0A                             unsigned char peer_cid[MBEDTLS_SSL_CID_OUT_LEN_MAX],\0A                             size_t *peer_cid_len)\0A{\0A    *enabled = MBEDTLS_SSL_CID_DISABLED;\0A\0A    if (ssl->conf->transport != MBEDTLS_SSL_TRANSPORT_DATAGRAM ||\0A        mbedtls_ssl_is_handshake_over(ssl) == 0) {\0A        return MBEDTLS_ERR_SSL_BAD_INPUT_DATA;\0A    }\0A\0A    /* We report MBEDTLS_SSL_CID_DISABLED in case the CID extensions\0A     * were used, but client and server requested the empty CID.\0A     * This is indistinguishable from not using the CID extension\0A     * in the first place. */\0A    if (ssl->transform_in->in_cid_len  == 0 &&\0A        ssl->transform_in->out_cid_len == 0) {\0A        return 0;\0A    }\0A\0A    i