@.str45637 = private global { i64, i64, [7196 x i8] } { i64 -1, i64 7195, [7196 x i8] c"/**\0A * \5Cfile debug_internal.h\0A *\0A * \5Cbrief Internal part of the public \22debug.h\22.\0A */\0A/*\0A *  Copyright The Mbed TLS Contributors\0A *  SPDX-License-Identifier: Apache-2.0 OR GPL-2.0-or-later\0A */\0A#ifndef MBEDTLS_DEBUG_INTERNAL_H\0A#define MBEDTLS_DEBUG_INTERNAL_H\0A\0A#include \22mbedtls/debug.h\22\0A\0A/**\0A * \5Cbrief    Print a message to the debug output. This function is always used\0A *          through the MBEDTLS_SSL_DEBUG_MSG() macro, which supplies the ssl\0A *          context, file and line number parameters.\0A *\0A * \5Cparam ssl       SSL context\0A * \5Cparam level     error level of the debug message\0A * \5Cparam file      file the message has occurred in\0A * \5Cparam line      line number the message has occurred at\0A * \5Cparam format    format specifier, in printf format\0A * \5Cparam ...       variables used by the format specifier\0A *\0A * \5Cattention       This function is intended for INTERNAL usage within the\0A *                  library only.\0A */\0Avoid mbedtls_debug_print_msg(const mbedtls_ssl_context *ssl, int level,\0A                             const char *file, int line,\0A                             const char *format, ...) MBEDTLS_PRINTF_ATTRIBUTE(5, 6);\0A\0A/**\0A * \5Cbrief   Print the return value of a function to the debug output. This\0A *          function is always used through the MBEDTLS_SSL_DEBUG_RET() macro,\0A *          which supplies the ssl context, file and line number parameters.\0A *\0A * \5Cparam ssl       SSL context\0A * \5Cparam level     error level of the debug message\0A * \5Cparam file      file the error has occurred in\0A * \5Cparam line      line number the error has occurred in\0A * \5Cparam text      the name of the function that returned the error\0A * \5Cparam ret       the return code value\0A *\0A * \5Cattention       This function is intended for INTERNAL usage within the\0A * 