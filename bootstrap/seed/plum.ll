@.str57552 = private global { i64, i64, [19449 x i8] } { i64 -1, i64 19448, [19449 x i8] c"/// One `name=value` pair of a query string, decoded.\0A///\0A/// Both halves are the real text: `a b` is a space, not `a%20b`.\0A/// `build_query` re-encodes them on the way out.\0Apub struct Param { pub name: String, pub value: String }\0A\0A/// `port` is always RESOLVED: the scheme's default when the URL did\0A/// not say. 0 means the scheme has no default this module knows,\0A/// which is not an error. Parsing is not connecting, and a URL\0A/// with a scheme we have never heard of is still a URL.\0A///\0A/// `path` is percent-encoded and never empty (`/` when the URL had\0A/// none). `raw_query` and `fragment` are stored without their `?`\0A/// and `#`, and are `\22\22` when absent, which does not distinguish\0A/// `http://h/p` from `http://h/p?`, a difference nothing observable\0A/// depends on.\0Apub struct Url {\0A    pub scheme: String,\0A    pub host: String,\0A    pub port: Int,\0A    pub path: String,\0A    pub raw_query: String,\0A    pub fragment: String,\0A}\0A\0Alet byte_at (b: Bytes) (i: Int): Int = match b.at(i) { Some(v) => v, None => 0 }\0A\0A/// Ports the schemes this module knows about default to. An unknown\0A/// scheme gets 0; see `Url`'s note.\0Apub let default_port (scheme: String): Int =\0A    if scheme == \22http\22 { 80 }\0A    else if scheme == \22https\22 { 443 }\0A    else { 0 }\0A\0A/// RFC 3986: ALPHA *( ALPHA / DIGIT / \22+\22 / \22-\22 / \22.\22 ).\0Alet scheme_ok_acc (b: Bytes) (i: Int) (n: Int): Bool =\0A    if i >= n { true }\0A    else {\0A        let c = byte_at(b, i);\0A        let alpha = (c >= 65 && c <= 90) || (c >= 97 && c <= 122);\0A        let digit = c >= 48 && c <= 57;\0A        let mark = c == 43 || c == 45 || c == 46;\0A        if i == 0 { if alpha { scheme_ok_acc(b, i + 1, n) } else { false } }\0A        else if alpha || digit || mark { scheme_ok_acc(b, i + 1, n) }\0A        else { false }\0A    }\0A\0Alet scheme_ok (s: String): Bool = {\0A    let b = s.as_bytes();\0A    if b.is_empty() { false } else { scheme_ok_acc(b, 0, b.len()) }\0A}\0A\0A/// Every index here is a CODEPOINT index, because `String.index_of`\0A/// and `String.slice` both are. Mixing one with `.len()`, which is\0A/// BYTES, is the bug this comment exists to prevent. They agree on\0A/// ASCII and part company on anything else, and a URL with a raw\0A/// non-ASCII character in it is exactly the input that would find it.\0Alet clen (s: String): Int = String.char_len(s)\0A\0A/// Splits `s` at the first `sep`, returning the part before and the\0A/// part after. When `sep` is absent the whole string is `before`.\0Apub struct Split { pub before: String, pub after: String, pub found: Bool }\0A\0Alet split_first (s: String) (sep: String): Split =\0A    match String.index_of(s, sep) {\0A        None => Split { before: s, after: \22\22, found: false },\0A        Some(i) => Split {\0A            before: String.slice(s, 0, i),\0A            after: String.slice(s, i + clen(sep), clen(s)),\0A            found: true,\0A        },\0A    }\0A\0Alet hex_value (c: Int): Int =\0A    if c >= 48 && c <= 57 { c - 48 }\0A    else if c >= 65 && c <= 70 { c - 65 + 10 }\0A    else if c >= 97 && c <= 102 { c - 97 + 10 }\0A    else { 0 - 1 }\0A\0Aenum PercentError { Escape(String), Utf8 }\0A\0A// Raw component syntax has already established that unescaped bytes are\0A// ASCII. Only escaped bytes can form multibyte UTF-8, so collect at most\0A// one codepoint (four bytes), then use the prelude's complete validator.\0A// Never decode an entire component just to discard the decoded buffer.\0Alet validate_pct_acc (b: Bytes) (i: Int) (pending: Array[Int]) (left: Int): Result[Unit, PercentError] =\0A    if i >= b.len() {\0A        if left == 0 { Ok(()) } else { Err(Utf8) }\0A    } else if byte_at(b, i) != 37 {\0A        if left != 0 { Err(Utf8) }\0A        else { validate_pct_acc(b, i + 1, pending, 0) }\0A    } else if i + 2 >= b.len() {\0A        Err(Escape(\22Encoding.percent_decode: truncated escape at byte \22.concat(i.to_string())))\0A    } else {\0A        let hi = hex_value(byte_at(b, i + 1));\0A        let lo = hex_value(byte_at(b, i + 2));\0A        if hi < 0 || lo < 0 {\0A            Err(Escape(\22Encoding.percent_decode: invalid escape at byte \22.concat(i.to_string())))\0A        } else {\0A            let c = hi * 16 + lo;\0A            if left == 0 && c < 128 { validate_pct_acc(b, i + 3, pending, 0) }\0A            else if left == 0 && (c < 194 || c > 244) { Err(Utf8) }\0A            else {\0A                let next = pending.push(c);\0A                let remaining = if left > 0 { left - 1 }\0A                                else if c < 224 { 1 } else if c < 240 { 2 } else { 3 };\0A                if remaining > 0 { validate_pct_acc(b, i + 3, next, remaining) }\0A                else if !Bytes.is_utf8(Bytes.from_array(next)) { Err(Utf8) }\0A                else { validate_pct_acc(b, i + 3, [], 0) }\0A            }\0A        }\0A    }\0A\0A// Keep decoded UTF-8 checks separate from the raw URI alphabet. Parsing\0A// establishes the text contract that lets query_get return only Option.\0Alet validate_pct (context: String) (s: String): Result[Unit, String] =\0A    match validate_pct_acc(s.as_bytes(), 0, [], 0) {\0A        Ok(_) => Ok(()),\0A        Err(Utf8) => Err(\22Url.parse: \22.concat(context).concat(\22 is not valid UTF-8 once decoded\22)),\0A        Err(Escape(e)) => Err(\22Url.parse: \22.concat(context).concat(\22: \22).concat(e)),\0A    }\0A\0A// RFC 3986 component alphabets. Percent escapes are checked separately:\0A// admitting '%' here must never mean admitting an arbitrary following byte.\0Alet unreserved (c: Int): Bool =\0A    (c >= 65 && c <= 90) || (c >= 97 && c <= 122) || (c >= 48 && c <= 57)\0A        || c == 45 || c == 46 || c == 95 || c == 126\0A\0Alet sub_delim (c: Int): Bool =\0A    c == 33 || c == 36 || c == 38 || c == 39 || c == 40 || c == 41\0A        || c == 42 || c == 43 || c