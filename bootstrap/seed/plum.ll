@.str45082 = private global { i64, i64, [11634 x i8] } { i64 -1, i64 11633, [11634 x i8] c"/**\0A * \5Cfile net_sockets.h\0A *\0A * \5Cbrief   Network sockets abstraction layer to integrate Mbed TLS into a\0A *          BSD-style sockets API.\0A *\0A *          The network sockets module provides an example integration of the\0A *          Mbed TLS library into a BSD sockets implementation. The module is\0A *          intended to be an example of how Mbed TLS can be integrated into a\0A *          networking stack, as well as to be Mbed TLS's network integration\0A *          for its supported platforms.\0A *\0A *          The module is intended only to be used with the Mbed TLS library and\0A *          is not intended to be used by third party application software\0A *          directly.\0A *\0A *          The supported platforms are as follows:\0A *              * Microsoft Windows and Windows CE\0A *              * POSIX/Unix platforms including Linux, OS X\0A *\0A */\0A/*\0A *  Copyright The Mbed TLS Contributors\0A *  SPDX-License-Identifier: Apache-2.0 OR GPL-2.0-or-later\0A */\0A#ifndef MBEDTLS_NET_SOCKETS_H\0A#define MBEDTLS_NET_SOCKETS_H\0A#include \22mbedtls/private_access.h\22\0A\0A#include \22mbedtls/build_info.h\22\0A\0A#include \22mbedtls/ssl.h\22\0A\0A#include <stddef.h>\0A#include <stdint.h>\0A\0A/** Failed to open a socket. */\0A#define MBEDTLS_ERR_NET_SOCKET_FAILED                     -0x0042\0A/** The connection to the given server / port failed. */\0A#define MBEDTLS_ERR_NET_CONNECT_FAILED                    -0x0044\0A/** Binding of the socket failed. */\0A#define MBEDTLS_ERR_NET_BIND_FAILED                       -0x0046\0A/** Could not listen on the socket. */\0A#define MBEDTLS_ERR_NET_LISTEN_FAILED                     -0x0048\0A/** Could not accept the incoming connection. */\0A#define MBEDTLS_ERR_NET_ACCEPT_FAILED                     -0x004A\0A/** Reading information from the socket failed. */\0A#define MBEDTLS_ERR_NET_RECV_FAILED                       -0x004C\0A/** Sending information through the socket failed. */\0A#define MBEDTLS_ERR_NET_SEND_FAILED                       -0x004E\0A/** Connection was reset by peer. */\0A#define MBEDTLS_ERR_NET_CONN_RESET                        -0x0050\0A/** Failed to get an IP address for the given hostname. */\0A#define MBEDTLS_ERR_NET_UNKNOWN_HOST                      -0x0052\0A/** Buffer is too small to hold the data. */\0A#define MBEDTLS_ERR_NET_BUFFER_TOO_SMALL                  -0x0043\0A/** The context is invalid, eg because it was free()ed. */\0A#define MBEDTLS_ERR_NET_INVALID_CONTEXT                   -0x0045\0A/** Polling the net context failed. */\0A#define MBEDTLS_ERR_NET_POLL_FAILED                       -0x0047\0A/** Input invalid. */\0A#define MBEDTLS_ERR_NET_BAD_INPUT_DATA                    -0x0049\0A\0A#define MBEDTLS_NET_LISTEN_BACKLOG         10 /**< The backlog that listen() should use. */\0A\0A#define MBEDTLS_NET_PROTO_TCP 0 /**< The TCP transport protocol */\0A#define MBEDTLS_NET_PROTO_UDP 1 /**< The UDP transport protocol */\0A\0A#define MBEDTLS_NET_POLL_READ  1 /**< Used in \5Cc mbedtls_net_poll to check for pending data  */\0A#define MBEDTLS_NET_POLL_WRITE 2 /**< Used in \5Cc mbedtls_net_poll to check if write possible */\0A\0A#ifdef __cplusplus\0Aextern \22C\22 {\0A#endif\0A\0A/**\0A * Wrapper type for sockets.\0A *\0A * Currently backed by just a file descriptor, but might be more in the future\0A * (eg two file descriptors for combined IPv4 + IPv6 support, or additional\0A * structures for hand-made UDP demultiplexing).\0A */\0Atypedef struct mbedtls_net_context {\0A    /** The underlying file descriptor.\0A     *\0A     * This field is only guaranteed to be present on POSIX/Unix-like platforms.\0A     * On other platforms, it may have a different type, have a different\0A     * meaning, or be absent altogether.\0A     */\0A    int fd;\0A}\0Ambedtls_net_context;\0A\0A/**\0A * \5Cbrief          Initialize a context\0A *                 Just makes the context ready to be used or freed safely.\0A *\0A * \5Cparam ctx      Context to initialize\0A */\0Avoid mbedtls_net_init(mbedtls_net_context *ctx);\0A\0A/**\0A * \5Cbrief          Initiate a connection with host:port in the given protocol\0A *\0A * \5Cparam ctx      Socket to use\0A * \5Cparam host     Host to connect to\0A * \5Cparam port     Port to connect to\0A * \5Cparam proto    Protocol: MBEDTLS_NET_PROTO_TCP or MBEDTLS_NET_PROTO_UDP\0A *\0A * \5Creturn         0 if successful, or one of:\0A *                      MBEDTLS_ERR_NET_SOCKET_FAILED,\0A *                      MBEDTLS_ERR_NET_UNKNOWN_HOST,\0A *                      MBEDTLS_ERR_NET_CONNECT_FAILED\0A *\0A * \5Cnote           Sets the socket in connected mode even with UDP.\0A */\0Aint mbedtls_net_connect(mbedtls_net_context *ctx, const char *host, const char *port, int proto);\0A\0A/**\0A * \5Cbrief          Create a receiving socket on bind_ip:port in the chosen\0A *                 protocol. If bind_ip == NULL, all interfaces are bound.\0A *\0A * \5Cparam ctx      Socket to use\0A * \5Cparam bind_ip  IP to bind to, can be NULL\0A * \5Cparam port     Port number to use\0A * \5Cparam proto    Protocol: MBEDTLS_NET_PROTO_TCP or MBEDTLS_NET_PROTO_UDP\0A *\0A * \5Creturn         0 if successful, or one of:\0A *                      MBEDTLS_ERR_NET_SOCKET_FAILED,\0A *                      MBEDTLS_ERR_NET_UNKNOWN_HOST,\0A *                      MBEDTLS_ERR_NET_BIND_FAILED,\0A *                      MBEDTLS_ERR_NET_LISTEN_FAILED\0A *\0A * \5Cnote           Regardless of the protocol, opens the sockets and binds it.\0A *                 In addition, make the socket listening if protocol is TCP.\0A */\0Aint mbedtls_net_bind(mbedtls_net_context *ctx, const char *bind_ip, const char *port, int proto);\0A\0A/**\0A * \5Cbrief           Accept a connection from a remote client\0A *\0A * \5Cparam bind_ctx  Relevant socket\0A * \5Cparam client_ctx Will contain the connected client socket\0A * \5Cparam client_ip Will contain the client IP address, can be NULL\0A * \5Cparam buf_size  Size of the client_ip buffer\0A * \5Cparam cip_len   Will receive the size of the client IP written,\0A *                  can be NULL if client_ip is null\0A *\0A * \5Creturn          0 if successful, or\0A *                  MBEDTLS_ERR_NET_SOCKET_FAILED,\0A *                  MBEDTLS_ERR_NET_BIND_FAILED,\0A *                  MBEDTLS_ERR_NET_ACCEPT_FAILED, or\0A *                  MBEDTLS_ERR_NET_BUFFER_TOO_SMALL if buf_size is too small,\0A *                  MBEDTLS_ERR_SSL_WANT_READ if bind_fd was set to\0A *                  non-blocking and accept() would block.\0A */\0Aint mbedtls_net_accept(mbedtls_net_context *bind_ctx,\0A                       mbedtls_net_context *client_ctx,\0A                       void *client_ip, size_t buf_size, size_t *cip_len);\0A\0A/**\0A * \5Cbrief          Check and wait for the context to be ready for read/write\0A *\0A * \5Cnote           The current implementation of this function uses\0A *                 select() and returns an error if the file descriptor\0A *                 is \5Cc FD_SETSIZE or greater.\0A *\0A * \5Cparam ctx      Socket to check\0A * \5Cparam rw       Bitflag composed of MBEDTLS_NET_POLL_READ and\0A *                 MBEDTLS_NET_POLL_WRITE specifying the events\0A *                 to wait for:\0A *                 - If MBEDTLS_NET_POLL_READ is set, the function\0A *                   will return as soon as the net context is available\0A *                   for reading.\0A *                 - If MBEDTLS_NET_POLL_WRITE is set, the function\0A *                   will return as soon as the net context is available\0A *                   for writing.\0A * \5Cparam timeout  Maximal amount of time to wait before returning,\0A *                 in milliseconds. If \5Cc timeout is zero, the\0A *                 function returns immediately. If \5Cc timeout is\0A *                 -1u, the function blocks potentially indefinitely.\0A *\0A * \5Creturn         Bitmask composed of MBEDTLS_NET_POLL_READ/WRITE\0A *                 on success or timeout, or a negative return code otherwise.\0A */\0Aint mbedtls_net_poll(mbedtls_net_context *ctx, uint32_t rw, uint32_t timeout);\0A\0A/**\0A * \5Cbrief          Set the socket blocking\0A *\0A * \5Cparam ctx      Socket to set\0A *\0A * \5Creturn         0 if successful, or a non-zero error code\0A */\0Aint mbedtls_net_set_block(mbedtls_net_context *ctx);\0A\0A/**\0A * \5Cbrief          Set the socket non-blocking\0A *\0A * \5Cparam ctx      Socket to set\0A *\0A * \5Creturn         0 if successful, or a non-zero error code\0A */\0Aint mbedtls_net_set_nonblock(mbedtls_net_context *ctx);\0A\0A/**\0A * \5Cbrief          Portable usleep helper\0A *\0A * \5Cparam usec     Amount of microseconds to sleep\0A *\0A * \5Cnote           Real amount of time slept will not be less than\0A *                 select()'s timeout granularity (typically, 10ms).\0A */\0Avoid mbedtls_net_usleep(unsigned long usec);\0A\0A/**\0A * \5Cbrief          Read at most 'len' characters. If no error occurs,\0A *                 the actual amount read is returned.\0A *\0A * \5Cparam ctx      Socket\0A * \5Cparam buf      The buffer to write to\0A * \5Cparam len      Maximum length of the buffer\0A *\0A * \5Creturn         the number of bytes received,\0A *                 or a non-zero error code; with a non-blocking socket,\0A *                 MBEDTLS_ERR_SSL_WANT_READ indicates read() would block.\0A */\0Aint mbedtls_net_recv(void *ctx, unsigned char *buf, size_t len);\0A\0A/**\0A * \5Cbrief          Write at most 'len' characters. If no error occurs,\0A *                 the actual amount written is returned.\0A *\0A * \5Cparam ctx      Socket\0A * \5Cparam buf      The buffer to read from\0A * \5Cparam len      The length of the buffer\0A *\0A * \5Creturn         the number of bytes sent,\0A *                 or a non-zero error code; with a non-blocking socket,\0A *                 MBEDTLS_ERR_SSL_WANT_WRITE indicates write() would block.\0A */\0Aint mbedtls_net_send(void *ctx, const unsigned char *buf, size_t len);\0A\0A/**\0A * \5Cbrief          Read at most 'len' characters, blocking for at most\0A *                 'timeout' seconds. If no error occurs, the actual amount\0A *                 read is returned.\0A *\0A * \5Cnote           The current implementation of this function uses\0A *                 select() and returns an error if the file descriptor\0A *                 is \5Cc FD_SETSIZE or greater.\0A *\0A * \5Cparam ctx      Socket\0A * \5Cparam buf      The buffer to write to\0A * \5Cparam len      Maximum length of the buffer\0A * \5Cparam timeout  Maximum number of milliseconds to wait for data\0A *                 0 means no timeout (wait forever)\0A *\0A * \5Creturn         The number of bytes received if successful.\0A *                 MBEDTLS_ERR_SSL_TIMEOUT if the operation timed out.\0A *                 MBEDTLS_ERR_SSL_WANT_READ if interrupted by a signal.\0A *                 Another negative error code (MBEDTLS_ERR_NET_xxx)\0A *                 for other failures.\0A *\0A * \5Cnote           This function will block (until data becomes available or\0A *                 timeout is reached) even if the socket is set to\0A *                 non-blocking. Handling timeouts with non-blocking reads\0A *                 requires a different strategy.\0A */\0Aint mbedtls_net_recv_timeout(void *ctx, unsigned char *buf, size_t len,\0A                             uint32_t timeout);\0A\0A/**\0A * \5Cbrief          Closes down the connection and free associated data\0A *\0A * \5Cparam ctx      The context to close\0A *\0A * \5Cnote           This function frees and clears data associated with the\0A *                 context but does not free the memory pointed to by \5Cp ctx.\0A *                 This memory is the responsibility of the caller.\0A */\0Avoid mbedtls_net_close(mbedtls_net_context *ctx);\0A\0A/**\0A * \5Cbrief          Gracefully shutdown the connection and free associated data\0A *\0A * \5Cparam ctx      The context to free\0A *\0A * \5Cnote           This function frees and clears data associated with the\0A *                 context but does not free the memory pointed to by \5Cp ctx.\0A *                 This memory is the responsibility of the caller.\0A */\0Avoid mbedtls_net_free(mbedtls_net_context *ctx);\0A\0A#ifdef __cplusplus\0A}\0A#endif\0A\0A#endif /* net_sockets.h */\0A\00" }
