;\0A\0A    if (buf[siglen - 1] != 0xBC) {\0A        return MBEDTLS_ERR_RSA_INVALID_PADDING;\0A    }\0A\0A    if (md_alg != MBEDTLS_MD_NONE) {\0A        /* Gather length of hash to sign */\0A        size_t exp_hashlen = mbedtls_md_get_size_from_type(md_alg);\0A        if (exp_hashlen == 0) {\0A            return MBEDTLS_ERR_RSA_BAD_INPUT_DATA;\0A        }\0A\0A        if (hashlen != exp_hashlen) {\0A            return MBEDTLS_ERR_RSA_BAD_INPUT_DATA;\0A        }\0A    }\0A\0A    hlen = mbedtls_md_get_size_from_type(mgf1_hash_id);\0A    if (hlen == 0) {\0A        return MBEDTLS_ERR_RSA_BAD_INPUT_DATA;\0A    }\0A\0A    /*\0A     * Note: EMSA-PSS verification is over the length of N - 1 bits\0A     */\0A    msb = mbedtls_mpi_bitlen(&ctx->N) - 1;\0A\0A    if (buf[0] >> (8 - siglen * 8 + msb)) {\0A        return MBEDTLS_ERR_RSA_BAD_INPUT_DATA;\0A    }\0A\0A    /* Compensate for boundary condition when applying mask */\0A    if (msb % 8 == 0) {\0A        p++;\0A        siglen -= 1;\0A    }\0A\0A    if (siglen < hlen + 2) {\0A        return MBEDTLS_ERR_RSA_BAD_INPUT_DATA;\0A    }\0A    hash_start = p + siglen - hlen - 1;\0A\0A    ret = mgf_mask(p, siglen - hlen - 1, hash_start, hlen, mgf1_hash_id);\0A    if (ret != 0) {\0A        return ret;\0A    }\0A\0A    buf[0] &= 0xFF >> (siglen * 8 - msb);\0A\0A    while (p < hash_start - 1 && *p == 0) {\0A        p++;\0A    }\0A\0A    if (*p++ != 0x01) {\0A        return MBEDTLS_ERR_RSA_INVALID_PADDING;\0A    }\0A\0A    observed_salt_len = (size_t) (hash_start - p);\0A\0A    if (expected_salt_len != MBEDTLS_RSA_SALT_LEN_ANY &&\0A        observed_salt_len != (size_t) expected_salt_len) {\0A        return MBEDTLS_ERR_RSA_INVALID_PADDING;\0A    }\0A\0A    /*\0A     * Generate H = Hash( M' )\0A     */\0A    ret = hash_mprime(hash, hashlen, p, observed_salt_len,\0A                      result, mgf1_hash_id);\0A    if (ret != 0) {\0A        return ret;\0A    }\0A\0A    if (memcmp(hash_start, result, hlen) != 0) {\0A        return MBEDTLS_ER