@.str41341 = private global { i64, i64, [13551 x i8] } { i64 -1, i64 13550, [13551 x i8] c"/*\0A *  PKCS#12 Personal Information Exchange Syntax\0A *\0A *  Copyright The Mbed TLS Contributors\0A *  SPDX-License-Identifier: Apache-2.0 OR GPL-2.0-or-later\0A */\0A/*\0A *  The PKCS #12 Personal Information Exchange Syntax Standard v1.1\0A *\0A *  http://www.rsa.com/rsalabs/pkcs/files/h11301-wp-pkcs-12v1-1-personal-information-exchange-syntax.pdf\0A *  ftp://ftp.rsasecurity.com/pub/pkcs/pkcs-12/pkcs-12v1-1.asn\0A */\0A\0A#include \22common.h\22\0A\0A#if defined(MBEDTLS_PKCS12_C)\0A\0A#include \22mbedtls/pkcs12.h\22\0A#include \22mbedtls/asn1.h\22\0A#if defined(MBEDTLS_CIPHER_C)\0A#include \22mbedtls/cipher.h\22\0A#endif /* MBEDTLS_CIPHER_C */\0A#include \22mbedtls/platform_util.h\22\0A#include \22mbedtls/error.h\22\0A\0A#include <string.h>\0A\0A#if defined(MBEDTLS_DES_C)\0A#include \22mbedtls/des.h\22\0A#endif\0A\0A#include \22psa_util_internal.h\22\0A\0A#if defined(MBEDTLS_ASN1_PARSE_C) && defined(MBEDTLS_CIPHER_C)\0A\0Astatic int pkcs12_parse_pbe_params(mbedtls_asn1_buf *params,\0A                                   mbedtls_asn1_buf *salt, int *iterations)\0A{\0A    int ret = MBEDTLS_ERR_ERROR_CORRUPTION_DETECTED;\0A    unsigned char **p = &params->p;\0A    const unsigned char *end = params->p + params->len;\0A\0A    /*\0A     *  pkcs-12PbeParams ::= SEQUENCE {\0A     *    salt          OCTET STRING,\0A     *    iterations    INTEGER\0A     *  }\0A     *\0A     */\0A    if (params->tag != (MBEDTLS_ASN1_CONSTRUCTED | MBEDTLS_ASN1_SEQUENCE)) {\0A        return MBEDTLS_ERROR_ADD(MBEDTLS_ERR_PKCS12_PBE_INVALID_FORMAT,\0A                                 MBEDTLS_ERR_ASN1_UNEXPECTED_TAG);\0A    }\0A\0A    if ((ret = mbedtls_asn1_get_tag(p, end, &salt->len, MBEDTLS_ASN1_OCTET_STRING)) != 0) {\0A        return MBEDTLS_ERROR_ADD(MBEDTLS_ERR_PKCS12_PBE_INVALID_FORMAT, ret);\0A    }\0A\0A    salt->p = *p;\0A    *p += salt->len;\0A\0A    if ((ret = mbedtls_asn1_get_int(p, end, iterations)) != 0) {\0A        return MBEDTLS_ERROR_ADD(MBEDTLS_ERR_PKCS12_PBE_INVALID_FORMAT, ret);\0A    }\0A\0A    if (*p != end) {\0A        return MBEDTLS_ERROR_ADD(MBEDTLS_ERR_PKCS12_PBE_INVALID_FORMAT,\0A                                 MBEDTLS_ERR_ASN1_LENGTH_MISMATCH);\0A    }\0A\0A    return 0;\0A}\0A\0A#define PKCS12_MAX_PWDLEN 128\0A\0Astatic int pkcs12_pbe_derive_key_iv(mbedtls_asn1_buf *pbe_params, mbedtls_md_type_t md_type,\0A                                    const unsigned char *pwd,  size_t pwdlen,\0A                                    unsigned char *key, size_t keylen,\0A                                    unsigned char *iv,  size_t ivlen)\0A{\0A    int ret, iterations = 0;\0A    mbedtls_asn1_buf salt;\0A    size_t i;\0A    unsigned char unipwd[PKCS12_MAX_PWDLEN * 2 + 2];\0A\0A    if (pwdlen > PKCS12_MAX_PWDLEN) {\0A        return MBEDTLS_ERR_PKCS12_BAD_INPUT_DATA;\0A    }\0A\0A    memset(&salt, 0, sizeof(mbedtls_asn1_buf));\0A    memset(&unipwd, 0, sizeof(unipwd));\0A\0A    if ((ret = pkcs12_parse_pbe_params(pbe_params, &salt,\0A                                       &iterations)) != 0) {\0A        return ret;\0A    }\0A\0A    for (i = 0; i < pwdlen; i++) {\0A        unipwd[i * 2 + 1] = pwd[i];\0A    }\0A\0A    if ((ret = mbedtls_pkcs12_derivation(key, keylen, unipwd, pwdlen * 2 + 2,\0A                                         salt.p, salt.len, md_type,\0A                                         MBEDTLS_PKCS12_DERIVE_KEY, iterations)) != 0) {\0A        return ret;\0A    }\0A\0A    if (iv == NULL || ivlen == 0) {\0A        return 0;\0A    }\0A\0A    if ((ret = mbedtls_pkcs12_derivation(iv, ivlen, unipwd, pwdlen * 2 + 2,\0A                                         salt.p, salt.len, md_type,\0A                                         MBEDTLS_PKCS12_DERIVE_IV, iterations)) != 0) {\0A        return ret;\0A    }\0A    return 0;\0A}\0A\0A#undef PKCS12_MAX_PWDLEN\0A\0A#if !defined(MBEDTLS_CIPHER_PADDING_PKCS7)\0Aint mbedtls_pkcs12_pbe_ext(mbedtls_asn1_buf *pbe_params, int mode,\0A                           mbedtls_cipher_type_t cipher_type, mbedtls_md_type_t md_type,\0A                           const unsigned char *pwd,  size_t pwdlen,\0A                           const unsigned char *data, size_t len,\0A                           unsigned char *output, size_t output_size,\0A                           size_t *output_len);\0A#endif\0A\0A#if !defined(MBEDTLS_DEPRECATED_REMOVED)\0Aint mbedtls_pkcs12_pbe(mbedtls_asn1_buf *pbe_params, int mode,\0A                       mbedtls_cipher_type_t cipher_type, mbedtls_md_type_t md_type,\0A                       const unsigned char *pwd,  size_t pwdlen,\0A                       const unsigned char *data, size_t len,\0A                       unsigned char *output)\0A{\0A    size_t output_len = 0;\0A\0A    /* We assume caller of the function is providing a big enough output buffer\0A     * so we pass output_size as SIZE_MAX to pass checks, However, no guarantees\0A     * for the output size actually being correct.\0A     */\0A    return mbedtls_pkcs12_pbe_ext(pbe_params, mode, cipher_type, md_type,\0A                                  pwd, pwdlen, data, len, output, SIZE_MAX,\0A                                  &output_len);\0A}\0A#endif\0A\0Aint mbedtls_pkcs12_pbe_ext(mbedtls_asn1_buf *pbe_params, int mode,\0A                           mbedtls_cipher_type_t cipher_type, mbedtls_md_type_t md_type,\0A                           const unsigned char *pwd,  size_t pwdlen,\0A                           const unsigned char *data, size_t len,\0A                           unsigned char *output, size_t output_size,\0A                           size_t *output_len)\0A{\0A    int ret, keylen = 0;\0A    unsigned char key[32];\0A    unsigned char iv[16];\0A    const mbedtls_cipher_info_t *cipher_info;\0A    mbedtls_cipher_context_t cipher_ctx;\0A    size_t iv_len = 0;\0A    size_t finish_olen = 0;\0A    unsigned int padlen = 0;\0A\0A    if (pwd == NULL && pwdlen != 0) {\0A        return MBEDTLS_ERR_P