@.str41942 = private global { i64, i64, [20832 x i8] } { i64 -1, i64 20831, [20832 x i8] c"/*\0A *  PSA hashing layer on top of Mbed TLS software crypto\0A */\0A/*\0A *  Copyright The Mbed TLS Contributors\0A *  SPDX-License-Identifier: Apache-2.0 OR GPL-2.0-or-later\0A */\0A\0A#include \22common.h\22\0A\0A/* This is needed for MBEDTLS_ERR_XXX macros */\0A#include <mbedtls/error.h>\0A\0A#if defined(MBEDTLS_ASN1_WRITE_C)\0A#include <mbedtls/asn1write.h>\0A#include <psa/crypto_sizes.h>\0A#endif\0A\0A#include \22psa_util_internal.h\22\0A\0A#if defined(MBEDTLS_PSA_CRYPTO_CLIENT)\0A\0A#include <psa/crypto.h>\0A\0A#if defined(MBEDTLS_MD_LIGHT)\0A#include <mbedtls/md.h>\0A#endif\0A#if defined(MBEDTLS_LMS_C)\0A#include <mbedtls/lms.h>\0A#endif\0A#if defined(MBEDTLS_SSL_TLS_C) && \5C\0A    (defined(MBEDTLS_USE_PSA_CRYPTO) || defined(MBEDTLS_SSL_PROTO_TLS1_3))\0A#include <mbedtls/ssl.h>\0A#endif\0A#if defined(PSA_WANT_KEY_TYPE_RSA_PUBLIC_KEY) ||    \5C\0A    defined(PSA_WANT_KEY_TYPE_RSA_KEY_PAIR_BASIC)\0A#include <mbedtls/rsa.h>\0A#endif\0A#if defined(MBEDTLS_USE_PSA_CRYPTO) && \5C\0A    defined(PSA_WANT_KEY_TYPE_ECC_PUBLIC_KEY)\0A#include <mbedtls/ecp.h>\0A#endif\0A#if defined(MBEDTLS_PK_C)\0A#include <mbedtls/pk.h>\0A#endif\0A#if defined(MBEDTLS_BLOCK_CIPHER_SOME_PSA)\0A#include <mbedtls/cipher.h>\0A#endif\0A#include <mbedtls/entropy.h>\0A\0A/* PSA_SUCCESS is kept at the top of each error table since\0A * it's the most common status when everything functions properly. */\0A#if defined(MBEDTLS_MD_LIGHT)\0Aconst mbedtls_error_pair_t psa_to_md_errors[] =\0A{\0A    { PSA_SUCCESS,                     0 },\0A    { PSA_ERROR_NOT_SUPPORTED,         MBEDTLS_ERR_MD_FEATURE_UNAVAILABLE },\0A    { PSA_ERROR_INVALID_ARGUMENT,      MBEDTLS_ERR_MD_BAD_INPUT_DATA },\0A    { PSA_ERROR_INSUFFICIENT_MEMORY,   MBEDTLS_ERR_MD_ALLOC_FAILED }\0A};\0A#endif\0A\0A#if defined(MBEDTLS_BLOCK_CIPHER_SOME_PSA)\0Aconst mbedtls_error_pair_t psa_to_cipher_errors[] =\0A{\0A    { PSA_SUCCESS,                     0 },\0A    { PSA_ERROR_NOT_SUPPORTED,         MBEDTLS_ERR_CIPHER_FEATURE_UNAVAILABLE },\0A    { PSA_ERROR_INVALID_ARGUMENT,      MBEDTLS_ERR_CIPHER_BAD_INPUT_DATA },\0A    { PSA_ERROR_INSUFFICIENT_MEMORY,   MBEDTLS_ERR_CIPHER_ALLOC_FAILED }\0A};\0A#endif\0A\0A#if defined(MBEDTLS_LMS_C)\0Aconst mbedtls_error_pair_t psa_to_lms_errors[] =\0A{\0A    { PSA_SUCCESS,                     0 },\0A    { PSA_ERROR_BUFFER_TOO_SMALL,      MBEDTLS_ERR_LMS_BUFFER_TOO_SMALL },\0A    { PSA_ERROR_INVALID_ARGUMENT,      MBEDTLS_ERR_LMS_BAD_INPUT_DATA }\0A};\0A#endif\0A\0A#if defined(MBEDTLS_SSL_TLS_C) && \5C\0A    (defined(MBEDTLS_USE_PSA_CRYPTO) || defined(MBEDTLS_SSL_PROTO_TLS1_3))\0Aconst mbedtls_error_pair_t psa_to_ssl_errors[] =\0A{\0A    { PSA_SUCCESS,                     0 },\0A    { PSA_ERROR_INSUFFICIENT_MEMORY,   MBEDTLS_ERR_SSL_ALLOC_FAILED },\0A    { PSA_ERROR_NOT_SUPPORTED,         MBEDTLS_ERR_SSL_FEATURE_UNAVAILABLE },\0A    { PSA_ERROR_INVALID_SIGNATURE,     MBEDTLS_ERR_SSL_INVALID_MAC },\0A    { PSA_ERROR_INVALID_ARGUMENT,      MBEDTLS_ERR_SSL_BAD_INPUT_DATA },\0A    { PSA_ERROR_BAD_STATE,             MBEDTLS_ERR_SSL_INTERNAL_ERROR },\0A    { PSA_ERROR_BUFFER_TOO_SMALL,      MBEDTLS_ERR_SSL_BUFFER_TOO_SMALL }\0A};\0A#endif\0A\0A#if defined(PSA_WANT_KEY_TYPE_RSA_PUBLIC_KEY) ||    \5C\0A    defined(PSA_WANT_KEY_TYPE_RSA_KEY_PAIR_BASIC)\0Aconst mbedtls_error_pair_t psa_to_pk_rsa_errors[] =\0A{\0A    { PSA_SUCCESS,                     0 },\0A    { PSA_ERROR_NOT_PERMITTED,         MBEDTLS_ERR_RSA_BAD_INPUT_DATA },\0A    { PSA_ERROR_INVALID_ARGUMENT,      MBEDTLS_ERR_RSA_BAD_INPUT_DATA },\0A    { PSA_ERROR_INVALID_HANDLE,        MBEDTLS_ERR_RSA_BAD_INPUT_DATA },\0A    { PSA_ERROR_BUFFER_TOO_SMALL,      MBEDTLS_ERR_RSA_OUTPUT_TOO_LARGE },\0A    { PSA_ERROR_INSUFFICIENT_ENTROPY,  MBEDTLS_ERR_RSA_RNG_FAILED },\0A    { PSA_ERROR_INVALID_SIGNATURE,     MBEDTLS_ERR_RSA_VERIFY_FAILED },\0A    { PSA_ERROR_INVALID_PADDING,       MBEDTLS_ERR_RSA_INVALID_PADDING }\0A};\0A#endif\0A\0A#if defined(MBEDTLS_USE_PSA_CRYPTO) && \5C\0A    defined(PSA_WANT_KEY_TYPE_ECC_PUBLIC_KEY)\0Aconst mbedtls_error_pair_t psa_to_pk_ecdsa_errors[] =\0A{\0A    { PSA_SUCCESS,                     0 },\0A    { PSA_ERROR_NOT_PERMITTED,         MBEDTLS_ERR_ECP_BAD_INPUT_DATA },\0A    { PSA_ERROR_INVALID_ARGUMENT,      MBEDTLS_ERR_ECP_BAD_INPUT_DATA },\0A    { PSA_ERROR_INVALID_HANDLE,        MBEDTLS_ERR_ECP_FEATURE_UNAVAILABLE },\0A    { PSA_ERROR_BUFFER_TOO_SMALL,      MBEDTLS_ERR_ECP_BUFFER_TOO_SMALL },\0A    { PSA_ERROR_INSUFFICIENT_ENTROPY,  MBEDTLS_ERR_ECP_RANDOM_FAILED },\0A    { PSA_ERROR_INVALID_SIGNATURE,     MBEDTLS_ERR_ECP_VERIFY_FAILED }\0A};\0A#endif\0A\0Aint psa_generic_status_to_mbedtls(psa_status_t status)\0A{\0A    switch (status) {\0A        case PSA_SUCCESS:\0A            return 0;\0A        case PSA_ERROR_NOT_SUPPORTED:\0A            return MBEDTLS_ERR_PLATFORM_FEATURE_UNSUPPORTED;\0A        case PSA_ERROR_CORRUPTION_DETECTED:\0A            return MBEDTLS_ERR_ERROR_CORRUPTION_DETECTED;\0A        case PSA_ERROR_COMMUNICATION_FAILURE:\0A        case PSA_ERROR_HARDWARE_FAILURE:\0A            return MBEDTLS_ERR_PLATFORM_HW_ACCEL_FAILED;\0A        case PSA_ERROR_NOT_PERMITTED:\0A        default:\0A            return MBEDTLS_ERR_ERROR_GENERIC_ERROR;\0A    }\0A}\0A\0Aint psa_status_to_mbedtls(psa_status_t status,\0A                          const mbedtls_error_pair_t *local_translations,\0A                          size_t local_errors_num,\0A                          int (*fallback_f)(psa_status_t))\0A{\0A    for (size_t i = 0; i < local_errors_num; i++) {\0A        if (status == local_translations[i].psa_status) {\0A            return local_translations[i].mbedtls_error;\0A        }\0A    }\0A    return fallback_f(status);\0A}\0A\0A#if defined(MBEDTLS_PK_C)\0Aint psa_pk_status_to_mbedtls(psa_status_t status)\0A{\0A    switch (status) {\0A        case PSA_ERROR_INVALID_HANDLE:\0A            return MBEDTLS_ERR_PK_KEY_INVALID_FORMAT;\0A        case PSA_ERROR_BUFFER_TOO_SMALL:\0A            return MBEDTLS_ERR_PK_BUFFER_TOO_SMALL;\0A        case PSA_ERROR_NOT_SUPPORTED:\0A            return MBEDTLS_ERR_PK_FEATURE_UNAVAILABLE;\0A        case PSA_ERROR_INVALID_ARGUMENT:\0A            return MBEDTLS_ERR_PK_INVALID_ALG;\0A        case PSA_ERROR_NOT_PERMITTED:\0A            return MBEDTLS_ERR_PK_TYPE_MISMATCH;\0A        case PSA_ERROR_INSUFFICIENT_MEMORY:\0A            return MBEDTLS_ERR_PK_ALLOC_FAILED;\0A        case PSA_ERROR_BAD_STATE:\0A            return MBEDTLS_ERR_PK_BAD_INPUT_DATA;\0A        case PSA_ERROR_DATA_CORRUPT:\0A        case PSA_ERROR_DATA_INVALID:\0A        case PSA_ERROR_STORAGE_FAILURE:\0A            return MBEDTLS_ERR_PK_FILE_IO_ERROR;\0A        default:\0A            return psa_generic_status_to_mbedtls(status);\0A    }\0A}\0A#endif /* MBEDTLS_PK_C */\0A\0A/****************************************************************/\0A/* Key management */\0A/****************************************************************/\0A\0A#if defined(PSA_WANT_KEY_TYPE_ECC_PUBLIC_KEY)\0Apsa_ecc_family_t mbedtls_ecc_group_to_psa(mbedtls_ecp_group_id grpid,\0A                                          size_t *bits)\0A{\0A    switch (grpid) {\0A#if defined(MBEDTLS_ECP_HAVE_SECP192R1)\0A        case MBEDTLS_ECP_DP_SECP192R1:\0A            *bits = 192;\0A            return PSA_ECC_FAMILY_SECP_R1;\0A#endif\0A#if defined(MBEDTLS_ECP_HAVE_SECP224R1)\0A        case MBEDTLS_ECP_DP_SECP224R1:\0A            *bits = 224;\0A            return PSA_ECC_FAMILY_SECP_R1;\0A#endif\0A#if defined(MBEDTLS_ECP_HAVE_SECP256R1)\0A        case MBEDTLS_ECP_DP_SECP256R1:\0A            *bits = 256;\0A            return PSA_ECC_FAMILY_SECP_R1;\0A#endif\0A#if defined(MBEDTLS_ECP_HAVE_SECP384R1)\0A        case MBEDTLS_ECP_DP_SECP384R1:\0A            *bits = 384;\0A            return PSA_ECC_FAMILY_SECP_R1;\0A#endif\0A#if defined(MBEDTLS_ECP_HAVE_SECP521R1)\0A        case MBEDTLS_ECP_DP_SECP521R1:\0A            *bits = 521;\0A            return PSA_ECC_FAMILY_SECP_R1;\0A#endif\0A#if defined(MBEDTLS_ECP_HAVE_BP256R1)\0A        case MBEDTLS_ECP_DP_BP256R1:\0A            *bits = 256;\0A            return PSA_ECC_FAMILY_BRAINPOOL_P_R1;\0A#endif\0A#if defined(MBEDTLS_ECP_HAVE_BP384R1)\0A        case MBEDTLS_ECP_DP_BP384R1:\0A            *bits = 384;\0A            return PSA_ECC_FAMILY_BRAINPOOL_P_R1;\0A#endif\0A#if defined(MBEDTLS_ECP_HAVE_BP512R1)\0A        case MBEDTLS_ECP_DP_BP512R1:\0A            *bits = 512;\0A            return PSA_ECC_FAMILY_BRAINPOOL_P_R1;\0A#endif\0A#if defined(MBEDTLS_ECP_HAVE_CURVE25519)\0A        case MBEDTLS_ECP_DP_CURVE25519:\0A            *bits = 255;\0A            return PSA_ECC_FAMILY_MONTGOMERY;\0A#endif\0A#if defined(MBEDTLS_ECP_HAVE_SECP192K1)\0A        case MBEDTLS_ECP_DP_SECP192K1:\0A            *bits = 192;\0A            return PSA_ECC_FAMILY_SECP_K1;\0A#endif\0A#if defined(MBEDTLS_ECP_HAVE_SECP224K1)\0A    /* secp224k1 is not and will not be supported in PSA (#3541). */\0A#endif\0A#if defined(MBEDTLS_ECP_HAVE_SECP256K1)\0A        case MBEDTLS_ECP_DP_SECP256K1:\0A            *bits = 256;\0A            return PSA_ECC_FAMILY_SECP_K1;\0A#endif\0A#if defined(MBEDTLS_ECP_HAVE_CURVE448)\0A        case MBEDTLS_ECP_DP_CURVE448:\0A            *bits = 448;\0A            return PSA_ECC_FAMILY_MONTGOMERY;\0A#endif\0A        default:\0A            *bits = 0;\0A            return 0;\0A    }\0A}\0A\0Ambedtls_ecp_group_id mbedtls_ecc_group_from_psa(psa_ecc_family_t family,\0A                                                size_t bits)\0A{\0A    switch (family) {\0A        case PSA_ECC_FAMILY_SECP_R1:\0A            switch (bits) {\0A#if defined(PSA_WANT_ECC_SECP_R1_192)\0A                case 192:\0A                    return MBEDTLS_ECP_DP_SECP192R1;\0A#endif\0A#if defined(PSA_WANT_ECC_SECP_R1_224)\0A                case 224:\0A                    return MBEDTLS_ECP_DP_SECP224R1;\0A#endif\0A#if defined(PSA_WANT_ECC_SECP_R1_256)\0A                case 256:\0A                    return MBEDTLS_ECP_DP_SECP256R1;\0A#endif\0A#if defined(PSA_WANT_ECC_SECP_R1_384)\0A                case 384:\0A                    return MBEDTLS_ECP_DP_SECP384R1;\0A#endif\0A#if defined(PSA_WANT_ECC_SECP_R1_521)\0A                case 521:\0A                    return MBEDTLS_ECP_DP_SECP521R1;\0A#endif\0A            }\0A            break;\0A\0A        case PSA_ECC_FAMILY_BRAINPOOL_P_R1:\0A            switch (bits) {\0A#if defined(PSA_WANT_ECC_BRAINPOOL_P_R1_256)\0A                case 256:\0A                    return MBEDTLS_ECP_DP_BP256R1;\0A#endif\0A#if defined(PSA_WANT_ECC_BRAINPOOL_P_R1_384)\0A                case 384:\0A                    return MBEDTLS_ECP_DP_BP384R1;\0A#endif\0A#if defined(PSA_WANT_ECC_BRAINPOOL_P_R1_512)\0A                case 512:\0A                    return MBEDTLS_ECP_DP_BP512R1;\0A#endif\0A            }\0A            break;\0A\0A        case PSA_ECC_FAMILY_MONTGOMERY:\0A            switch (bits) {\0A#if defined(PSA_WANT_ECC_MONTGOMERY_255)\0A                case 255:\0A                    return MBEDTLS_ECP_DP_CURVE25519;\0A#endif\0A#if defined(PSA_WANT_ECC_MONTGOMERY_448)\0A                case 448:\0A                    return MBEDTLS_ECP_DP_CURVE448;\0A#endif\0A            }\0A            break;\0A\0A        case PSA_ECC_FAMILY_SECP_K1:\0A            switch (bits) {\0A#if defined(PSA_WANT_ECC_SECP_K1_192)\0A                case 192:\0A                    return MBEDTLS_ECP_DP_SECP192K1;\0A#endif\0A#if defined(PSA_WANT_ECC_SECP_K1_224)\0A            /* secp224k1 is not and will not be supported in PSA (#3541). */\0A#endif\0A#if defined(PSA_WANT_ECC_SECP_K1_256)\0A                case 256:\0A                    return MBEDTLS_ECP_DP_SECP256K1;\0A#endif\0A            }\0A            break;\0A    }\0A\0A    return MBEDTLS_ECP_DP_NONE;\0A}\0A#endif /* PSA_WANT_KEY_TYPE_ECC_PUBLIC_KEY */\0A\0A/* Wrapper function allowing the classic API to use the PSA RNG.\0A *\0A * `mbedtls_psa_get_random(MBEDTLS_PSA_RANDOM_STATE, ...)` calls\0A * `psa_generate_random(...)`. The state parameter is ignored since the\0A * PSA API doesn't support passing an explicit state.\0A */\0Aint mbedtls_psa_get_random(void *p_rng,\0A                           unsigned char *output,\0A                           size_t output_size)\0A{\0A    /* This function takes a pointer to the RNG state because that's what\0A     * classic mbedtls functions using an RNG expect. The PSA RNG manages\0A     * its own state internally and doesn't let the caller access that state.\0A     * So we just ignore the state parameter, and in practice we'll pass\0A     * NULL. */\0A    (void) p_rng;\0A    psa_status_t status = psa_generate_random(output, output_size);\0A    if (status == PSA_SUCCESS) {\0A        return 0;\0A    } else {\0A        return MBEDTLS_ERR_ENTROPY_SOURCE_FAILED;\0A    }\0A}\0A\0A#endif /* MBEDTLS_PSA_CRYPTO_CLIENT */\0A\0A#if defined(MBEDTLS_PSA_UTIL_HAVE_ECDSA)\0A\0A/**\0A * \5Cbrief  Convert a single raw coordinate to DER ASN.1 format. The output der\0A *         buffer is filled backward (i.e. starting from its end).\0A *\0A * \5Cparam raw_buf           Buffer containing the raw coordinate to be\0A *                          converted.\0A * \5Cparam raw_len           Length of raw_buf in bytes. This must be > 0.\0A * \5Cparam der_buf_start     Pointer to the beginning of the buffer which\0A *                          will be filled with the DER converted data.\0A * \5Cparam der_buf_end       End of the buffer used to store the DER output.\0A *\0A * \5Creturn                  On success, the amount of data (in bytes) written to\0A *                          the DER buffer.\0A * \5Creturn                  MBEDTLS_ERR_ASN1_BUF_TOO_SMALL if the provided der\0A *                          buffer is too small to contain all the converted data.\0A * \5Creturn                  MBEDTLS_ERR_ASN1_INVALID_DATA if the input raw\0A *                          coordinate is null (i.e. all zeros).\0A *\0A * \5Cwarning                 Raw and der buffer must not be overlapping.\0A */\0Astatic int convert_raw_to_der_single_int(const unsigned char *raw_buf, size_t raw_len,\0A                                         unsigned char *der_buf_start,\0A                                         unsigned char *der_buf_end)\0A{\0A    unsigned char *p = der_buf_end;\0A    int len;\0A    int ret = MBEDTLS_ERR_ERROR_CORRUPTION_DETECTED;\0A\0A    /* ASN.1 DER encoding requires minimal length, so skip leading 0s.\0A     * Provided input MPIs should not be 0, but as a failsafe measure, still\0A     * detect that and return error in case. */\0A    while (*raw_buf == 0x00) {\0A        ++raw_buf;\0A        --raw_len;\0A        if (raw_len == 0) {\0A            return MBEDTLS_ERR_ASN1_INVALID_DATA;\0A        }\0A    }\0A    len = (int) raw_len;\0A\0A    /* Copy the raw coordinate to the end of der_buf. */\0A    if ((p - der_buf_start) < len) {\0A        return MBEDTLS_ERR_ASN1_BUF_TOO_SMALL;\0A    }\0A    p -= len;\0A    memcpy(p, raw_buf, len);\0A\0A    /* If MSb is 1, ASN.1 requires that we prepend a 0. */\0A    if (*p & 0x80) {\0A        if ((p - der_buf_start) < 1) {\0A            return MBEDTLS_ERR_ASN1_BUF_TOO_SMALL;\0A        }\0A        --p;\0A        *p = 0x00;\0A        ++len;\0A    }\0A\0A    MBEDTLS_ASN1_CHK_ADD(len, mbedtls_asn1_write_len(&p, der_buf_start, len));\0A    MBEDTLS_ASN1_CHK_ADD(len, mbedtls_asn1_write_tag(&p, der_buf_start, MBEDTLS_ASN1_INTEGER));\0A\0A    return len;\0A}\0A\0Aint mbedtls_ecdsa_raw_to_der(size_t bits, const unsigned char *raw, size_t raw_len,\0A                             unsigned char *der, size_t der_size, size_t *der_len)\0A{\0A    unsigned char r[PSA_BITS_TO_BYTES(PSA_VENDOR_ECC_MAX_CURVE_BITS)];\0A    unsigned char s[PSA_BITS_TO_BYTES(PSA_VENDOR_ECC_MAX_CURVE_BITS)];\0A    const size_t coordinate_len = PSA_BITS_TO_BYTES(bits);\0A    size_t len = 0;\0A    unsigned char *p = der + der_size;\0A    int ret = MBEDTLS_ERR_ERROR_CORRUPTION_DETECTED;\0A\0A    if (bits == 0) {\0A        return MBEDTLS_ERR_ASN1_INVALID_DATA;\0A    }\0A    if (raw_len != (2 * coordinate_len)) {\0A        return MBEDTLS_ERR_ASN1_INVALID_DATA;\0A    }\0A    if (coordinate_len > sizeof(r)) {\0A        return MBEDTLS_ERR_ASN1_BUF_TOO_SMALL;\0A    }\0A\0A    /* Since raw and der buffers might overlap, dump r and s before starting\0A     * the conversion. */\0A    memcpy(r, raw, coordinate_len);\0A    memcpy(s, raw + coordinate_len, coordinate_len);\0A\0A    /* der buffer will initially be written starting from its end so we pick s\0A     * first and then r. */\0A    ret = convert_raw_to_der_single_int(s, coordinate_len, der, p);\0A    if (ret < 0) {\0A        return ret;\0A    }\0A    p -= ret;\0A    len += ret;\0A\0A    ret = convert_raw_to_der_single_int(r, coordinate_len, der, p);\0A    if (ret < 0) {\0A        return ret;\0A    }\0A    p -= ret;\0A    len += ret;\0A\0A    /* Add ASN.1 header (len + tag). */\0A    MBEDTLS_ASN1_CHK_ADD(len, mbedtls_asn1_write_len(&p, der, len));\0A    MBEDTLS_ASN1_CHK_ADD(len, mbedtls_asn1_write_tag(&p, der,\0A                                                     MBEDTLS_ASN1_CONSTRUCTED |\0A                                                     MBEDTLS_ASN1_SEQUENCE));\0A\0A    /* memmove the content of der buffer to its beginnig. */\0A    memmove(der, p, len);\0A    *der_len = len;\0A\0A    return 0;\0A}\0A\0A/**\0A * \5Cbrief Convert a single integer from ASN.1 DER format to raw.\0A *\0A * \5Cparam der               Buffer containing the DER integer value to be\0A *                          converted.\0A * \5Cparam der_len           Length of the der buffer in bytes.\0A * \5Cparam raw               Output buffer that will be filled with the\0A *                          converted data. This should be at least\0A *                          coordinate_size bytes and it must be zeroed before\0A *                          calling this function.\0A * \5Cparam coordinate_size   Size (in bytes) of a single coordinate in raw\0A *                          format.\0A *\0A * \5Creturn                  On success, the amount of DER data parsed from the\0A *                          provided der buffer.\0A * \5Creturn                  MBEDTLS_ERR_ASN1_UNEXPECTED_TAG if the integer tag\0A *                          is missing in the der buffer.\0A * \5Creturn                  MBEDTLS_ERR_ASN1_LENGTH_MISMATCH if the integer\0A *                          is null (i.e. all zeros) or if the output raw buffer\0A *                          is too small to contain the converted raw value.\0A *\0A * \5Cwarning                 Der and raw buffers must not be overlapping.\0A */\0Astatic int convert_der_to_raw_single_int(unsigned char *der, size_t der_len,\0A                                         unsigned char *raw, size_t coordinate_size)\0A{\0A    unsigned char *p = der;\0A    int ret = MBEDTLS_ERR_ERROR_CORRUPTION_DETECTED;\0A    size_t unpadded_len, padding_len = 0;\0A\0A    /* Get the length of ASN.1 element (i.e. the integer we need to parse). */\0A    ret = mbedtls_asn1_get_tag(&p, p + der_len, &unpadded_len,\0A                               MBEDTLS_ASN1_INTEGER);\0A    if (ret != 0) {\0A        return ret;\0A    }\0A\0A    /* It's invalid to have:\0A     * - unpadded_len == 0.\0A     * - MSb set without a leading 0x00 (leading 0x00 is checked below). */\0A    if (((unpadded_len == 0) || (*p & 0x80) != 0)) {\0A        return MBEDTLS_ERR_ASN1_INVALID_DATA;\0A    }\0A\0A    /* Skip possible leading zero */\0A    if (*p == 0x00) {\0A        p++;\0A        unpadded_len--;\0A        /* It is not allowed to have more than 1 leading zero.\0A         * Ignore the case in which unpadded_len = 0 because that's a 0 encoded\0A         * in ASN.1 format (i.e. 020100). */\0A        if ((unpadded_len > 0) && (*p == 0x00)) {\0A            return MBEDTLS_ERR_ASN1_INVALID_DATA;\0A        }\0A    }\0A\0A    if (unpadded_len > coordinate_size) {\0A        /* Parsed number is longer than the maximum expected value. */\0A        return MBEDTLS_ERR_ASN1_INVAL