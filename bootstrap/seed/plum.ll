@.str41066 = private global { i64, i64, [19805 x i8] } { i64 -1, i64 19804, [19805 x i8] c"/*\0A *  X.509 Certificate Signing Request (CSR) parsing\0A *\0A *  Copyright The Mbed TLS Contributors\0A *  SPDX-License-Identifier: Apache-2.0 OR GPL-2.0-or-later\0A */\0A/*\0A *  The ITU-T X.509 standard defines a certificate format for PKI.\0A *\0A *  http://www.ietf.org/rfc/rfc5280.txt (Certificates and CRLs)\0A *  http://www.ietf.org/rfc/rfc3279.txt (Alg IDs for CRLs)\0A *  http://www.ietf.org/rfc/rfc2986.txt (CSRs, aka PKCS#10)\0A *\0A *  http://www.itu.int/ITU-T/studygroups/com17/languages/X.680-0207.pdf\0A *  http://www.itu.int/ITU-T/studygroups/com17/languages/X.690-0207.pdf\0A */\0A\0A#include \22common.h\22\0A\0A#if defined(MBEDTLS_X509_CSR_PARSE_C)\0A\0A#include \22mbedtls/x509_csr.h\22\0A#include \22x509_internal.h\22\0A#include \22mbedtls/error.h\22\0A#include \22mbedtls/oid.h\22\0A#include \22mbedtls/platform_util.h\22\0A\0A#include <string.h>\0A\0A#if defined(MBEDTLS_PEM_PARSE_C)\0A#include \22mbedtls/pem.h\22\0A#endif\0A\0A#include \22mbedtls/platform.h\22\0A\0A#if defined(MBEDTLS_FS_IO) || defined(EFIX64) || defined(EFI32)\0A#include <stdio.h>\0A#endif\0A\0A/*\0A *  Version  ::=  INTEGER  {  v1(0)  }\0A */\0Astatic int x509_csr_get_version(unsigned char **p,\0A                                const unsigned char *end,\0A                                int *ver)\0A{\0A    int ret = MBEDTLS_ERR_ERROR_CORRUPTION_DETECTED;\0A\0A    if ((ret = mbedtls_asn1_get_int(p, end, ver)) != 0) {\0A        if (ret == MBEDTLS_ERR_ASN1_UNEXPECTED_TAG) {\0A            *ver = 0;\0A            return 0;\0A        }\0A\0A        return MBEDTLS_ERROR_ADD(MBEDTLS_ERR_X509_INVALID_VERSION, ret);\0A    }\0A\0A    return 0;\0A}\0A\0A/*\0A * Parse CSR extension requests in DER format\0A */\0Astatic int x509_csr_parse_extensions(mbedtls_x509_csr *csr,\0A                                     unsigned char **p, const unsigned char *end,\0A                                     mbedtls_x509_csr_ext_cb_t cb,\0A                                     void *p_ctx)\0A{\0A    int ret = MBEDTLS_ERR_ERROR_CORRUPTION_DETECTED;\0A    size_t len;\0A    unsigned char *end_ext_data, *end_ext_octet;\0A\0A    while (*p < end) {\0A        mbedtls_x509_buf extn_oid = { 0, 0, NULL };\0A        int is_critical = 0; /* DEFAULT FALSE */\0A        int ext_type = 0;\0A\0A        /* Read sequence tag */\0A        if ((ret = mbedtls_asn1_get_tag(p, end, &len,\0A                                        MBEDTLS_ASN1_CONSTRUCTED | MBEDTLS_ASN1_SEQUENCE)) != 0) {\0A            return MBEDTLS_ERROR_ADD(MBEDTLS_ERR_X509_INVALID_EXTENSIONS, ret);\0A        }\0A\0A        end_ext_data = *p + len;\0A\0A        /* Get extension ID */\0A        if ((ret = mbedtls_asn1_get_tag(p, end_ext_data, &extn_oid.len,\0A                                        MBEDTLS_ASN1_OID)) != 0) {\0A            return MBEDTLS_ERROR_ADD(MBEDTLS_ERR_X509_INVALID_EXTENSIONS, ret);\0A        }\0A\0A        extn_oid.tag = MBEDTLS_ASN1_OID;\0A        extn_oid.p = *p;\0A        *p += extn_oid.len;\0A\0A        /* Get optional critical */\0A        if ((ret = mbedtls_asn1_get_bool(p, end_ext_data, &is_critical)) != 0 &&\0A            (ret != MBEDTLS_ERR_ASN1_UNEXPECTED_TAG)) {\0A            return MBEDTLS_ERROR_ADD(MBEDTLS_ERR_X509_INVALID_EXTENSIONS, ret);\0A        }\0A\0A        /* Data should be octet string type */\0A        if ((ret = mbedtls_asn1_get_tag(p, end_ext_data, &len,\0A                                        MBEDTLS_ASN1_OCTET_STRING)) != 0) {\0A            return MBEDTLS_ERROR_ADD(MBEDTLS_ERR_X509_INVALID_EXTENSIONS, ret);\0A        }\0A\0A        end_ext_octet = *p + len;\0A\0A        if (end_ext_octet != end_ext_data) {\0A            return MBEDTLS_ERROR_ADD(MBEDTLS_ERR_X509_INVALID_EXTENSIONS,\0A                                     MBEDTLS_ERR_ASN1_LENGTH_MISMATCH);\0A        }\0A\0A        /*\0A         * Detect supported extensions and skip unsupported extensions\0A         */\0A        ret = mbedtls_oid_get_x509_ext_type(&extn_oid, &ext_type);\0A\0A        if (ret != 0) {\0A            /* Give the callback (if any) a chance to handle the extension */\0A            if (cb != NULL) {\0A                ret = cb(p_ctx, csr, &extn_oid, is_critical, *p, end_ext_octet);\0A                if (ret != 0 && is_critical) {\0A                    return ret;\0A                }\0A                *p = end_ext_octet;\0A                continue;\0A            }\0A\0A            /* No parser found, skip extension */\0A            *p = end_ext_octet;\0A\0A            if (is_critical) {\0A                /* Data is marked as critical: fail */\0A                return MBEDTLS_ERROR_ADD(MBEDTLS_ERR_X509_INVALID_EXTENSIONS,\0A                                         MBEDTLS_ERR_ASN1_UNEXPECTED_TAG);\0A            }\0A            continue;\0A        }\0A\0A        /* Forbid repeated extensions */\0A        if ((csr->ext_types & ext_type) != 0) {\0A            return MBEDTLS_ERROR_ADD(MBEDTLS_ERR_X509_INVALID_EXTENSIONS,\0A                                     MBEDTLS_ERR_ASN1_INVALID_DATA);\0A        }\0A\0A        csr->ext_types |= ext_type;\0A\0A        switch (ext_type) {\0A            case MBEDTLS_X509_EXT_KEY_USAGE:\0A                /* Parse key usage */\0A                if ((ret = mbedtls_x509_get_key_usage(p, end_ext_data,\0A                                                      &csr->key_usage)) != 0) {\0A                    return ret;\0A                }\0A                break;\0A\0A            case MBEDTLS_X509_EXT_SUBJECT_ALT_NAME:\0A                /* Parse subject alt name */\0A                if ((ret = mbedtls_x509_get_subject_alt_name(p, end_ext_data,\0A                                                             &csr->subject_alt_names)) != 0) {\0A                    return ret;\0A                }\0A                break;\0A\0A            case MBEDTLS_X509_EXT_NS_CERT_TYPE:\0A                /* Parse netscape certificate type */\0A                if ((ret = mbedtls_x509_get_ns_cert_type(p, end_ext_data,\0A                                                         &csr->ns_cert_type)) != 0) {\0A                    return ret;\0A                }\0A                break;\0A            default:\0A                /*\0A                 * If this is a non-critical extension, which the oid layer\0A                 * supports, but there isn't an x509 parser for it,\0A                 * skip the extension.\0A                 */\0A                if (is_critical) {\0A                    return MBEDTLS_ERR_X509_FEATURE_UNAVAILABLE;\0A                } else {\0A                    *p = end_ext_octet;\0A                }\0A        }\0A    }\0A\0A    if (*p != end) {\0A        return MBEDTLS_ERROR_ADD(MBEDTLS_ERR_X509_INVALID_EXTENSIONS,\0A                                 MBEDTLS_ERR_ASN1_LENGTH_MISMATCH);\0A    }\0A\0A    return 0;\0A}\0A\0A/*\0A * Parse CSR attributes in DER format\0A */\0Astatic int x509_csr_parse_attributes(mbedtls_x509_csr *csr,\0A                                     const unsigned char *start, const unsigned char *end,\0A                                     mbedtls_x509_csr_ext_cb_t cb,\0A                                     void *p_ctx)\0A{\0A    int ret;\0A    size_t len;\0A    unsigned char *end_attr_data;\0A    unsigned char **p = (unsigned char **) &start;\0A\0A    while (*p < end) {\0A        mbedtls_x509_buf attr_oid = { 0, 0, NULL };\0A\0A        if ((ret = mbedtls_asn1_get_tag(p, end, &len,\0A                                        MBEDTLS_ASN1_CONSTRUCTED | MBEDTLS_ASN1_SEQUENCE)) != 0) {\0A            return MBEDTLS_ERROR_ADD(MBEDTLS_ERR_X509_INVALID_EXTENSIONS, ret);\0A        }\0A        end_attr_data = *p + len;\0A\0A        /* Get attribute ID */\0A        if ((ret = mbedtls_asn1_get_tag(p, end_attr_data, &attr_oid.len,\0A                                        MBEDTLS_ASN1_OID)) != 0) {\0A            return MBEDTLS_ERROR_ADD(MBEDTLS_ERR_X509_INVALID_EXTENSIONS, ret);\0A        }\0A\0A        attr_oid.tag = MBEDTLS_ASN1_OID;\0A        attr_oid.p = *p;\0A        *p += attr_oid.len;\0A\0A        /* Check that this is an extension-request attribute */\0A        if (MBEDTLS_OID_CMP(MBEDTLS_OID_PKCS9_CSR_EXT_REQ, &attr_oid) == 0) {\0A            if ((ret = mbedtls_asn1_get_tag(p, end, &len,\0A                                            MBEDTLS_ASN1_CONSTRUCTED | MBEDTLS_ASN1_SET)) != 0) {\0A                return MBEDTLS_ERROR_ADD(MBEDTLS_ERR_X509_INVALID_EXTENSIONS, ret);\0A            }\0A\0A            if ((ret = mbedtls_asn1_get_tag(p, end, &len,\0A                                            MBEDTLS_ASN1_CONSTRUCTED | MBEDTLS_ASN1_SEQUENCE)) !=\0A                0) {\0A                return MBEDTLS_ERROR_ADD(MBEDTLS_ERR_X509_INVALID_EXTENSIONS, ret);\0A            }\0A\0A            if ((ret = x509_csr_parse_extensions(csr, p, *p + len, cb, p_ctx)) != 0) {\0A                return ret;\0A            }\0A\0A            if (*p != end_attr_data) {\0A                return MBEDTLS_ERROR_ADD(MBEDTLS_ERR_X509_INVALID_EXTENSIONS,\0A                                         MBEDTLS_ERR_ASN1_LENGTH_MISMATCH);\0A            }\0A        }\0A\0A        *p = end_attr_data;\0A    }\0A\0A    if (*p != end) {\0A        return MBEDTLS_ERROR_ADD(MBEDTLS_ERR_X509_INVALID_EXTENSIONS,\0A                                 MBEDTLS_ERR_ASN1_LENGTH_MISMATCH);\0A    }\0A\0A    return 0;\0A}\0A\0A/*\0A * Parse a CSR in DER format\0A */\0Astatic int mbedtls_x509_csr_parse_der_internal(mbedtls_x509_csr *csr,\0A                                               const unsigned char *buf, size_t buflen,\0A                                               mbedtls_x509_csr_ext_cb_t cb,\0A                                               void *p_ctx)\0A{\0A    int ret = MBEDTLS_ERR_ERROR_CORRUPTION_DETECTED;\0A    size_t len;\0A    unsigned char *p, *end;\0A    mbedtls_x509_buf sig_params;\0A\0A    memset(&sig_params, 0, sizeof(mbedtls_x509_buf));\0A\0A    /*\0A     * Check for valid input\0A     */\0A    if (csr == NULL || buf == NULL || buflen == 0) {\0A        return MBEDTLS_ERR_X509_BAD_INPUT_DATA;\0A    }\0A\0A    mbedtls_x509_csr_init(csr);\0A\0A    /*\0A     * first copy the raw DER data\0A     */\0A    p = mbedtls_calloc(1, len = buflen);\0A\0A    if (p == NULL) {\0A        return MBEDTLS_ERR_X509_ALLOC_FAILED;\0A    }\0A\0A    memcpy(p, buf, buflen);\0A\0A    csr->raw.p = p;\0A    csr->raw.len = len;\0A    end = p + len;\0A\0A    /*\0A     *  CertificationRequest ::= SEQUENCE {\0A     *       certificationRequestInfo CertificationRequestInfo,\0A     *       signatureAlgorithm AlgorithmIdentifier,\0A     *       signature          BIT STRING\0A     *  }\0A     */\0A    if ((ret = mbedtls_asn1_get_tag(&p, end, &len,\0A                                    MBEDTLS_ASN1_CONSTRUCTED | MBEDTLS_ASN1_SEQUENCE)) != 0) {\0A        mbedtls_x509_csr_free(csr);\0A        return MBEDTLS_ERR_X509_INVALID_FORMAT;\0A    }\0A\0A    if (len != (size_t) (end - p)) {\0A        mbedtls_x509_csr_free(csr);\0A        return MBEDTLS_ERROR_ADD(MBEDTLS_ERR_X509_INVALID_FORMAT,\0A                                 MBEDTLS_ERR_ASN1_LENGTH_MISMATCH);\0A    }\0A\0A    /*\0A     *  CertificationRequestInfo ::= SEQUENCE {\0A     */\0A    csr->cri.p = p;\0A\0A    if ((ret = mbedtls_asn1_get_tag(&p, end, &len,\0A                                    MBEDTLS_ASN1_CONSTRUCTED | MBEDTLS_ASN1_SEQUENCE)) != 0) {\0A        mbedtls_x509_csr_free(csr);\0A        return MBEDTLS_ERROR_ADD(MBEDTLS_ERR_X509_INVALID_FORMAT, ret);\0A    }\0A\0A    end = p + len;\0A    csr->cri.len = (size_t) (end - csr->cri.p);\0A\0A    /*\0A     *  Version  ::=  INTEGER {  v1(0) }\0A     */\0A    if ((ret = x509_csr_get_version(&p, end, &csr->version)) != 0) {\0A        mbedtls_x509_csr_free(csr);\0A        return ret;\0A    }\0A\0A    if (csr->version != 0) {\0A        mbedtls_x509_csr_free(csr);\0A        return MBEDTLS_ERR_X509_UNKNOWN_VERSION;\0A    }\0A\0A    csr->version++;\0A\0A    /*\0A     *  subject               Name\0A     */\0A    csr->subject_raw.p = p;\0A\0A    if ((ret = mbedtls_asn1_get_tag(&p, end, &len,\0A                                    MBEDTLS_ASN1_CONSTRUCTED | MBEDTLS_ASN1_SEQUENCE)) != 0) {\0A        mbedtls_x509_csr_free(csr);\0A        return MBEDTLS_ERROR_ADD(MBEDTLS_ERR_X509_INVALID_FORMAT, ret);\0A    }\0A\0A    if ((ret = mbedtls_x509_get_name(&p, p + len, &csr->subject)) != 0) {\0A        mbedtls_x509_csr_free(csr);\0A        return ret;\0A    }\0A\0A    csr->subject_raw.len = (size_t) (p - csr->subject_raw.p);\0A\0A    /*\0A     *  subjectPKInfo SubjectPublicKeyInfo\0A     */\0A    if ((ret = mbedtls_pk_parse_subpubkey(&p, end, &csr->pk)) != 0) {\0A        mbedtls_x509_csr_free(csr);\0A        return ret;\0A    }\0A\0A    /*\0A     *  attributes    [0] Attributes\0A     *\0A     *  The list of possible attributes is open-ended, though RFC 2985\0A     *  (PKCS#9) defines a few in section 5.4. We currently don't support any,\0A     *  so we just ignore them. This is a safe thing to do as the worst thing\0A     *  that could happen is that we issue a certificate that does not match\0A     *  the requester's expectations - this cannot cause a violation of our\0A     *  signature policies.\0A     */\0A    if ((ret = mbedtls_asn1_get_tag(&p, end, &len,\0A                                    MBEDTLS_ASN1_CONSTRUCTED | MBEDTLS_ASN1_CONTEXT_SPECIFIC)) !=\0A        0) {\0A        mbedtls_x509_csr_free(csr);\0A        return MBEDTLS_ERROR_ADD(MBEDTLS_ERR_X509_INVALID_FORMAT, ret);\0A    }\0A\0A    if ((ret = x509_csr_parse_attributes(csr, p, p + len, cb, p_ctx)) != 0) {\0A        mbedtls_x509_csr_free(csr);\0A        return ret;\0A    }\0A\0A    p += len;\0A\0A    end = csr->raw.p + csr->raw.len;\0A\0A    /*\0A     *  signatureAlgorithm   AlgorithmIdentifier,\0A     *  signature            BIT STRING\0A     */\0A    if ((ret = mbedtls_x509_get_alg(&p, end, &csr->sig_oid, &sig_params)) != 0) {\0A        mbedtls_x509_csr_free(csr);\0A        return ret;\0A    }\0A\0A    if ((ret = mbedtls_x509_get_sig_alg(&csr->sig_oid, &sig_params,\0A                                        &csr->sig_md, &csr->sig_pk,\0A                                        &csr->sig_opts)) != 0) {\0A        mbedtls_x509_csr_free(csr);\0A        return MBEDTLS_ERR_X509_UNKNOWN_SIG_ALG;\0A    }\0A\0A    if ((ret = mbedtls_x509_get_sig(&p, end, &csr->sig)) != 0) {\0A        mbedtls_x509_csr_free(csr);\0A        return ret;\0A    }\0A\0A    if (p != end) {\0A        mbedtls_x509_csr_free(csr);\0A        return MBEDTLS_ERROR_ADD(MBEDTLS_ERR_X509_INVALID_FORMAT,\0A                                 MBEDTLS_ERR_ASN1_LENGTH_MISMATCH);\0A    }\0A\0A    return 0;\0A}\0A\0A/*\0A * Parse a CSR in DER format\0A */\0Aint mbedtls_x509_csr_parse_der(mbedtls_x509_csr *csr,\0A                               const unsigned char *buf, size_t buflen)\0A{\0A    return mbedtls_x509_csr_parse_der_internal(csr, buf, buflen, NULL, NULL);\0A}\0A\0A/*\0A * Parse a CSR in DER format with callback for unknown extensions\0A */\0Aint mbedtls_x509_csr_parse_der_with_ext_cb(mbedtls_x509_csr *csr,\0A                                           const unsigned char *buf, size_t buflen,\0A                                           mbedtls_x509_csr_ext_cb_t cb,\0A                                           void *p_ctx)\0A{\0A    return mbedtls_x509_csr_parse_der_internal(csr, buf, buflen, cb, p_ctx);\0A}\0A\0A/*\0A * Parse a CSR, allowing for PEM or raw DER encoding\0A */\0Aint mbedtls_x509_csr_parse(mbedtls_x509_csr *csr, const unsigned char *buf, size_t buflen)\0A{\0A#if defined(MBEDTLS_PEM_PARSE_C)\0A    int ret = MBEDTLS_ERR_ERROR_CORRUPTION_DETECTED;\0A    size_t use_len;\0A    mbedtls_pem_context pem;\0A#endif\0A\0A    /*\0A     * Check for valid input\0A     */\0A    if (csr == NULL || buf == NULL || buflen == 0) {\0A        return MBEDTLS_ERR_X509_BAD_INPUT_DATA;\0A    }\0A\0A#if defined(MBEDTLS_PEM_PARSE_C)\0A    /* Avoid calling mbedtls_pem_read_buffer() on non-null-terminated string */\0A    if (buf[buflen - 1] == '\5C0') {\0A        mbedtls_pem_init(&pem);\0A        ret = mbedtls_pem_read_buffer(&pem,\0A                                      \22-----BEGIN CERTIFICATE REQUEST-----\22,\0A                                      \22-----END CERTIFICATE REQUEST-----\22,\0A                                      buf, NULL, 0, &use_len);\0A        if (ret == MBEDTLS_ERR_PEM_NO_HEADER_FOOTER_PRESENT) {\0A            ret = mbedtls_pem_read_buffer(&pem,\0A                                          \22-----BEGIN NEW CERTIFICATE REQUEST-----\22,\0A                                          \22-----END NEW CERTIFICATE REQUEST-----\22,\0A                                          buf, NULL, 0, &use_len);\0A        }\0A\0A        if (ret == 0) {\0A            /*\0A             * Was PEM encoded, parse the result\0A             */\0A            ret = mbedtls_x509_csr_parse_der(csr, pem.buf, pem.buflen);\0A        }\0A\0A        mbedtls_pem_free(&pem);\0A        if (ret != MBEDTLS_ERR_PEM_NO_HEADER_FOOTER_PRESENT) {\0A            return ret;\0A        }\0A    }\0A#endif /* MBEDTLS_PEM_PARSE_C */\0A    return mbedtls_x509_csr_parse_der(csr, buf, buflen);\0A}\0A\0A#if defined(MBEDTLS_FS_IO)\0A/*\0A * Load a CSR into the structure\0A */\0Aint mbedtls_x509_csr_parse_file(mbedtls_x509_csr *csr, const char *path)\0A{\0A    int ret = MBEDTLS_ERR_ERROR_CORRUPTION_DETECTED;\0A    size_t n;\0A    unsigned char *buf;\0A\0A    if ((ret = mbedtls_pk_load_file(path, &buf, &n)) != 0) {\0A        return ret;\0A    }\0A\0A    ret = mbedtls_x509_csr_parse(csr, buf, n);\0A\0A    mbedtls_zeroize_and_free(buf, n);\0A\0A    return ret;\0A}\0A#endif /* MBEDTLS_FS_IO */\0A\0A#if !defined(MBEDTLS_X509_REMOVE_INFO)\0A#define BEFORE_COLON    14\0A#define BC              \2214\22\0A/*\0A * Return an informational string about the CSR.\0A */\0Aint mbedtls_x509_csr_info(char *buf, size_t size, const char *prefix,\0A                          const mbedtls_x509_csr *csr)\0A{\0A    int ret = MBEDTLS_ERR_ERROR_CORRUPTION_DETECTED;\0A    size_t n;\0A    char *p;\0A    char key_size_str[BEFORE_COLON];\0A\0A    p = buf;\0A    n = size;\0A\0A    ret = mbedtls_snprintf(p, n, \22%sCSR version   : %d\22,\0A                           prefix, csr->version);\0A    MBEDTLS_X509_SAFE_SNPRINTF;\0A\0A    ret = mbedtls_snprintf(p, n, \22\5Cn%ssubject name  : \22, prefix);\0A    MBEDTLS_X509_SAFE_SNPRINTF;\0A    ret = mbedtls_x509_dn_gets(p, n, &csr->subject);\0A    MBEDTLS_X509_SAFE_SNPRINTF;\0A\0A    ret = mbedtls_snprintf(p, n, \22\5Cn%ssigned using  : \22, prefix);\0A    MBEDTLS_X509_SAFE_SNPRINTF;\0A\0A    ret = mbedtls_x509_sig_alg_gets(p, n, &csr->sig_oid, csr->sig_pk, csr->sig_md,\0A                                    csr->sig_opts);\0A    MBEDTLS_X509_SAFE_SNPRINTF;\0A\0A    if ((ret = mbedtls_x509_key_size_helper(key_size_str, BEFORE_COLON,\0A                                            mbedtls_pk_get_name(&csr->pk))) != 0) {\0A        return ret;\0A    }\0A\0A    ret = mbedtls_snprintf(p, n, \22\5Cn%s%-\22 BC \22s: %d bits\5Cn\22, prefix, key_size_str,\0A                           (int) mbedtls_pk_get_bitlen(&csr->pk));\0A    MBEDTLS_X509_SAFE_SNPRINTF;\0A\0A    /*\0A     * Optional extensions\0A     */\0A\0A    if (csr->ext_types & MBEDTLS_X509_EXT_SUBJECT_ALT_NAME) {\0A        ret = mbedtls_snprintf(p, n, \22\5Cn%ssubject alt name  :\22, prefix);\0A        MBEDTLS_X509_SAFE_SNPRINTF;\0A\0A        if ((ret = mbedtls_x509_info_subject_alt_name(&p, &n,\0A                                                      &csr->subject_alt_names,\0A                                                      prefix)) != 0) {\0A            return ret;\0A        }\0A    }\0A\0A    if (csr->ext_types & MBEDTLS_X509_EXT_NS_CERT_TYPE) {\0A        ret = mbedtls_snprintf(p, n, \22\5Cn%scert. type        : \22, prefix);\0A        MBEDTLS_X509_SAFE_SNPRINTF;\0A\0A        if ((ret = mbedtls_x509_info_cert_type(&p, &n, csr->ns_cert_type)) != 0) {\0A            return ret;\0A        }\0A    }\0A\0A    if (csr->ext_types & MBEDTLS_X509_EXT_KEY_USAGE) {\0A        ret = mbedtls_snprintf(p, n, \22\5Cn%skey usage         : \22, prefix);\0A        MBEDTLS_X509_SAFE_SNPRINTF;\0A\0A        if ((ret = mbedtls_x509_info_key_usage(&p, &n, csr->key_usage)) != 0) {\0A            return ret;\0A        }\0A    }\0A\0A    if (csr->ext_types != 0) {\0A        ret = mbedtls_snprintf(p, n, \22\5Cn\22);\0A        MBEDTLS_X509_SAFE_SNPRINTF;\0A    }\0A\0A    return (int) (size - n);\0A}\0A#endif /* MBEDTLS_X509_REMOVE_INFO */\0A\0A/*\0A * Initialize a CSR\0A */\0Avoid mbedtls_x509_csr_init(mbedtls_x509_csr *csr)\0A{\0A    memset(csr, 0, sizeof(mbedtls_x509_csr));\0A}\0A\0A/*\0A * Unallocate all CSR data\0A */\0Avoid mbedtls_x509_csr_free(mbedtls_x509_csr *csr)\0A{\0A    if (csr == NULL) {\0A        return;\0A    }\0A\0A    mbedtls_pk_free(&csr->pk);\0A\0A#if defined(MBEDTLS_X509_RSASSA_PSS_SUPPORT)\0A    mbedtls_free(csr->sig_opts);\0A#endif\0A\0A    mbedtls_asn1_free_named_data_list_shallow(csr->subject.next);\0A    mbedtls_asn1_sequence_free(csr->subject_alt_names.next);\0A\0A    if (csr->raw.p != NULL) {\0A        mbedtls_zeroize_and_free(csr->raw.p, csr->raw.len);\0A    }\0A\0A    mbedtls_platform_zeroize(csr, sizeof(mbedtls_x509_csr));\0A}\0A\0A#endif /* MBEDTLS_X509_CSR_PARSE_C */\0A\00" }
