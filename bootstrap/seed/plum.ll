hods\0A/// and names must be nonempty ASCII tokens;\0A/// values may contain spaces, HTAB, and UTF-8, but no other ASCII controls\0A/// or DEL. Bodies are not subject to protocol-field validation.\0A///\0A/// Reads past up to 100 informational responses to the final response.\0A/// HEAD, 204, and 304 responses have an empty body regardless of framing\0A/// headers. Protocol upgrades (101) and successful CONNECT tunnels return\0A/// Err and close the connection; this API cannot hand off a transport.\0Apub let request (method: String) (url: String) (headers: Array[Header]) (body: Bytes): Result[Response, String] =\0A    http_parse_url(url)\0A        |> Result.and_then(_, |parsed| http_build_request(method, parsed, headers, body)\0A            |> Result.and_then(_, |wire| if parsed.scheme == \22https\22 {\0A                let fd = unsafe { tls_connect(parsed.host.as_cstr(), parsed.port) };\0A                if fd < 0 { Err(\22https client: TLS connection failed\22) }\0A                else { let result = http_do_request(fd, 1, method, wire); unsafe { tls_close(fd) }; result }\0A            } else {\0A                Net.connect_to(parsed.host, parsed.port) |> Result.and_then(_, |fd| {\0A                    let result = http_do_request(fd, 0, method, wire);\0A                    Net.close(fd);\0A                    result\0A                })\0A            }))\0A\0A/// Fetches a URL and reads the whole response.\0A///\0A/// Supports both `http://` and `https://`; HTTPS uses the native TLS\0A/// transport with platform trust-store and hostname verification.\0A///\0A/// Redirects are NOT followed: a 301 or 302 comes back as itself, with\0A/// its `Location` header, so the caller decides. Following one changes\0A/// which host you are talking to, which is not a decision a library\0A/// should make quietly.\0Apub let get (url: String): Result[Response, String] = request(\22GET\22, url, [], Bytes.empty())\0A\0A/// POSTs raw bytes and reads the whole response. For text, pass