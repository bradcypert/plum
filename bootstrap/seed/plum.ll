@.str41572 = private global { i64, i64, [6517 x i8] } { i64 -1, i64 6516, [6517 x i8] c"/** \5Cfile psa_crypto_its.h\0A * \5Cbrief Interface of trusted storage that crypto is built on.\0A */\0A/*\0A *  Copyright The Mbed TLS Contributors\0A *  SPDX-License-Identifier: Apache-2.0 OR GPL-2.0-or-later\0A */\0A\0A#ifndef PSA_CRYPTO_ITS_H\0A#define PSA_CRYPTO_ITS_H\0A\0A#include <stddef.h>\0A#include <stdint.h>\0A\0A#include <psa/crypto_types.h>\0A#include <psa/crypto_values.h>\0A\0A#ifdef __cplusplus\0Aextern \22C\22 {\0A#endif\0A\0A/** \5Cbrief Flags used when creating a data entry\0A */\0Atypedef uint32_t psa_storage_create_flags_t;\0A\0A/** \5Cbrief A type for UIDs used for identifying data\0A */\0Atypedef uint64_t psa_storage_uid_t;\0A\0A#define PSA_STORAGE_FLAG_NONE        0         /**< No flags to pass */\0A#define PSA_STORAGE_FLAG_WRITE_ONCE (1 << 0) /**< The data associated with the uid will not be able to be modified or deleted. Intended to be used to set bits in `psa_storage_create_flags_t`*/\0A\0A/**\0A * \5Cbrief A container for metadata associated with a specific uid\0A */\0Astruct psa_storage_info_t {\0A    uint32_t size;                  /**< The size of the data associated with a uid **/\0A    psa_storage_create_flags_t flags;    /**< The flags set when the uid was created **/\0A};\0A\0A/** Flag indicating that \5Cref psa_storage_create and \5Cref psa_storage_set_extended are supported */\0A#define PSA_STORAGE_SUPPORT_SET_EXTENDED (1 << 0)\0A\0A#define PSA_ITS_API_VERSION_MAJOR  1  /**< The major version number of the PSA ITS API. It will be incremented on significant updates that may include breaking changes */\0A#define PSA_ITS_API_VERSION_MINOR  1  /**< The minor version number of the PSA ITS API. It will be incremented in small updates that are unlikely to include breaking changes */\0A\0A/**\0A * \5Cbrief create a new or modify an existing uid/value pair\0A *\0A * \5Cparam[in] uid           the identifier for the data\0A * \5Cparam[in] data_length   The size in bytes of the data in `p_data`\0A * \5Cparam[in] p_data        A buffer containing the data\0A * \5Cparam[in] create_flags  The flags that the data will be stored with\0A *\0A * \5Creturn      A status indicating the success/failure of the operation\0A *\0A * \5Cretval      #PSA_SUCCESS                     The operation completed successfully\0A * \5Cretval      #PSA_ERROR_NOT_PERMITTED         The operation failed because the provided `uid` value was already created with PSA_STORAGE_FLAG_WRITE_ONCE\0A * \5Cretval      #PSA_ERROR_NOT_SUPPORTED         The operation failed because one or more of the flags provided in `create_flags` is not supported or is not valid\0A * \5Cretval      #PSA_ERROR_INSUFFICIENT_STORAGE  The operation failed because there was insufficient space on the storage medium\0A * \5Cretval      #PSA_ERROR_STORAGE_FAILURE       The operation failed because the physical storage has failed (Fatal error)\0A * \5Cretval      #PSA_ERROR_INVALID_ARGUMENT      The operation failed because one of the provided pointers(`p_data`)\0A *                                               is invalid, for example is `NULL` or references memory the caller cannot access\0A */\0Apsa_status_t psa_its_set(psa_storage_uid_t uid,\0A                         uint32_t data_length,\0A                         const void *p_data,\0A                         psa_storage_create_flags_t create_flags);\0A\0A/**\0A * \5Cbrief Retrieve the value associated with a provided uid\0A *\0A * \5Cparam[in] uid               The uid value\0A * \5Cparam[in] data_offset       The starting offset of the data requested\0A * \5Cparam[in] data_length       the amount of data requested (and the minimum allocated size of the `p_data` buffer)\0A * \5Cparam[out] p_data           The buffer where the data will be placed upon successful completion\0A * \5Cparam[out] p_data_length    The amount of data returned in the p_data buffer\0A *\0A *\0A * \5Creturn      A status indicating the success/failure of the operation\0A *\0A * \5Cretval      #PSA_SUCCESS                 The operation completed successfully\0A * \5Cretval      #PSA_ERROR_DOES_NOT_EXIST    The operation failed because the provided `uid` value was not found in the storage\0A * \5Cretval      #PSA_ERROR_STORAGE_FAILURE   The operation failed because the physical storage has failed (Fatal error)\0A * \5Cretval      #PSA_ERROR_DATA_CORRUPT      The operation failed because stored data has been corrupted\0A * \5Cretval      #PSA_ERROR_INVALID_ARGUMENT  The operation failed because one of the provided pointers(`p_data`, `p_data_length`)\0A *                                           is invalid. For example is `NULL` or references memory the caller cannot access.\0A *                                           In addition, this can also happen if an invalid offset was provided.\0A */\0Apsa_status_t psa_its_get(psa_storage_uid_t uid,\0A                         uint32_t data_offset,\0A                         uint32_t data_length,\0A                         void *p_data,\0A                         size_t *p_data_length);\0A\0A/**\0A * \5Cbrief Retrieve the metadata about the provided uid\0A *\0A * \5Cparam[in] uid           The uid value\0A * \5Cparam[out] p_info       A pointer to the `psa_storage_info_t` struct that will be populated with the metadata\0A *\0A * \5Creturn      A status indicating the success/failure of the operation\0A *\0A * \5Cretval      #PSA_SUCCESS                 The operation completed successfully\0A * \5Cretval      #PSA_ERROR_DOES_NOT_EXIST    The operation failed because the provided uid value was not found in the storage\0A * \5Cretval      #PSA_ERROR_DATA_CORRUPT      The operation failed because stored data has been corrupted\0A * \5Cretval      #PSA_ERROR_INVALID_ARGUMENT  The operation failed because one of the provided pointers(`p_info`)\0A *                                           is invalid, for example is `NULL` or references memory the caller cannot access\0A */\0Apsa_status_t psa_its_get_info(psa_storage_uid_t uid,\0A                              struct psa_storage_info_t *p_info);\0A\0A/**\0A * \5Cbrief Remove the provided key and its associated data from the storage\0A *\0A * \5Cparam[in] uid   The uid value\0A *\0A * \5Creturn  A status indicating the success/failure of the operation\0A *\0A * \5Cretval      #PSA_SUCCESS                  The operation completed successfully\0A * \5Cretval      #PSA_ERROR_DOES_NOT_EXIST     The operation failed because the provided key value was not found in the storage\0A * \5Cretval      #PSA_ERROR_NOT_PERMITTED      The operation failed because the provided key value was created with PSA_STORAGE_FLAG_WRITE_ONCE\0A * \5Cretval      #PSA_ERROR_STORAGE_FAILURE    The operation failed because the physical storage has failed (Fatal error)\0A */\0Apsa_status_t psa_its_remove(psa_storage_uid_t uid);\0A\0A#ifdef __cplusplus\0A}\0A#endif\0A\0A#endif /* PSA_CRYPTO_ITS_H */\0A\00" }
