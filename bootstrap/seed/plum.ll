        iv, iv_len,\0A                                  ad, ad_len,\0A                                  input, ilen + tag_len,\0A                                  output, ilen, olen);\0A        if (status == PSA_ERROR_INVALID_SIGNATURE) {\0A            return MBEDTLS_ERR_CIPHER_AUTH_FAILED;\0A        } else if (status != PSA_SUCCESS) {\0A            return MBEDTLS_ERR_PLATFORM_HW_ACCEL_FAILED;\0A        }\0A\0A        return 0;\0A    }\0A#endif /* MBEDTLS_USE_PSA_CRYPTO && !MBEDTLS_DEPRECATED_REMOVED */\0A\0A#if defined(MBEDTLS_GCM_C)\0A    if (MBEDTLS_MODE_GCM == ((mbedtls_cipher_mode_t) ctx->cipher_info->mode)) {\0A        int ret = MBEDTLS_ERR_ERROR_CORRUPTION_DETECTED;\0A\0A        *olen = ilen;\0A        ret = mbedtls_gcm_auth_decrypt(ctx->cipher_ctx, ilen,\0A                                       iv, iv_len, ad, ad_len,\0A                                       tag, tag_len, input, output);\0A\0A        if (ret == MBEDTLS_ERR_GCM_AUTH_FAILED) {\0A            ret = MBEDTLS_ERR_CIPHER_AUTH_FAILED;\0A        }\0A\0A        return ret;\0A    }\0A#endif /* MBEDTLS_GCM_C */\0A#if defined(MBEDTLS_CCM_C)\0A    if (MBEDTLS_MODE_CCM == ((mbedtls_cipher_mode_t) ctx->cipher_info->mode)) {\0A        int ret = MBEDTLS_ERR_ERROR_CORRUPTION_DETECTED;\0A\0A        *olen = ilen;\0A        ret = mbedtls_ccm_auth_decrypt(ctx->cipher_ctx, ilen,\0A                                       iv, iv_len, ad, ad_len,\0A                                       input, output, tag, tag_len);\0A\0A        if (ret == MBEDTLS_ERR_CCM_AUTH_FAILED) {\0A            ret = MBEDTLS_ERR_CIPHER_AUTH_FAILED;\0A        }\0A\0A        return ret;\0A    }\0A#endif /* MBEDTLS_CCM_C */\0A#if defined(MBEDTLS_CHACHAPOLY_C)\0A    if (MBEDTLS_CIPHER_CHACHA20_POLY1305 == ((mbedtls_cipher_type_t) ctx->cipher_info->type)) {\0A        int ret = MBEDTLS_ERR_ERROR_CORRUPTION_DETECTED;\0A\0A        /* ChachaPoly has fixed length nonce and MAC (tag) */\0A        if ((iv_len != mbedtls_cipher_info_get_iv_size(ctx->cipher_inf