n;\0A#elif defined(MBEDTLS_CT_X86_64_ASM) && (defined(MBEDTLS_CT_SIZE_32) || defined(MBEDTLS_CT_SIZE_64))\0A    asm volatile (\22and  %[condition], %[if1]                      \5Cn\5Ct\22\0A                  \22not  %[condition]                              \5Cn\5Ct\22\0A                  \22and  %[condition], %[if0]                      \5Cn\5Ct\22\0A                  \22or   %[if1], %[if0]                            \5Cn\5Ct\22\0A                  :\0A                  [condition] \22+&D\22 (condition),\0A                  [if1] \22+&S\22 (if1),\0A                  [if0] \22+&a\22 (if0)\0A                  :\0A                  :\0A                  );\0A    return if0;\0A#elif defined(MBEDTLS_CT_X86_ASM) && defined(MBEDTLS_CT_SIZE_32)\0A    asm volatile (\22and %[condition], %[if1]                       \5Cn\5Ct\22\0A                  \22not %[condition]                               \5Cn\5Ct\22\0A                  \22and %[if0], %[condition]                       \5Cn\5Ct\22\0A                  \22or %[condition], %[if1]                        \5Cn\5Ct\22\0A                  :\0A                  [condition] \22+&c\22 (condition),\0A                  [if1] \22+&a\22 (if1)\0A                  :\0A                  [if0] \22b\22 (if0)\0A                  :\0A                  );\0A    return if1;\0A#else\0A    mbedtls_ct_condition_t not_cond =\0A        (mbedtls_ct_condition_t) (~mbedtls_ct_compiler_opaque(condition));\0A    return (mbedtls_ct_uint_t) ((condition & if1) | (not_cond & if0));\0A#endif\0A}\0A\0Astatic inline mbedtls_ct_condition_t mbedtls_ct_uint_lt(mbedtls_ct_uint_t x, mbedtls_ct_uint_t y)\0A{\0A#if defined(MBEDTLS_CT_AARCH64_ASM) && (defined(MBEDTLS_CT_SIZE_32) || defined(MBEDTLS_CT_SIZE_64))\0A    uint64_t s1;\0A    asm volatile (\22eor     %x[s1], %x[y], %x[x]                   \5Cn\5Ct\22\0A                  \22sub     %x[x], %x[x], %x[y]                    \5Cn\5Ct\22\0A                  \22bic     %x[x], %x[x], %x[s1]                   \5Cn\5Ct\22\0A                  \22and     %x[s1], %x[s1], %x[y]                  \5Cn\5Ct\22\0A                  \22orr     %x[s1], %x[x], %x[s1]                  \5Cn\5Ct\22\0A                  \22asr     %x[x], %x[s1], 63\22\0A                  :\0A                  [s1] \22=&r\22 (s1),\0A                  [x] \22+&r\22 (x)\0A                  :\0A                  [y] \22r\22 (y)\0A                  :\0A                  );\0A    return (mbedtls_ct_condition_t) x;\0A#elif defined(MBEDTLS_CT_ARM_ASM) && defined(MBEDTLS_CT_SIZE_32)\0A    uint32_t s1;\0A    asm volatile (\0A        \22.syntax unified                                          \5Cn\5Ct\22\0A#if defined(__thumb__) && !defined(__thumb2__)\0A        \22movs     %[s1], %[x]                                     \5Cn\5Ct\22\0A        \22eors     %[s1], %[s1], %[y]                              \5Cn\5Ct\22\0A#else\0A        \22eors     %[s1], %[x], %[y]                               \5Cn\5Ct\22\0A#endif\0A        \22subs    %[x], %[x], %[y]                                 \5Cn\5Ct\22\0A        \22bics    %[x], %[x], %[s1]                                \5Cn\5Ct\22\0A        \22ands    %[y], %[s1], %[y]                                \5Cn\5Ct\22\0A        \22orrs    %[x], %[x], %[y]                                 \5Cn\5Ct\22\0A        \22asrs    %[x], %[x], #31                                  \5Cn\5Ct\22\0A        RESTORE_ASM_SYNTAX\0A        :\0A        [s1] \22=&l\22 (s1),\0A        [x] \22+&l\22 (x),\0A        [y] \22+&l\22 (y)\0A        :\0A        :\0A        \22cc\22\0A        );\0A    return (mbedtls_ct_condition_t) x;\0A#elif defined(MBEDTLS_CT_X86_64_ASM) && (defined(MBEDTLS_CT_SIZE_32) || defined(MBEDTLS_CT_SIZE_64))\0A    uint64_t s;\0A    asm volatile (\22mov %[x], %[s]                                 \5Cn\5Ct\22\0A                  \22xor %[y], %[s]                                 \5Cn\5Ct\22\0A                  \22sub %[y], %[x]                                 \5Cn\5Ct\22\0A                  \22and %[s