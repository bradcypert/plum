@.str40900 = private global { i64, i64, [4661 x i8] } { i64 -1, i64 4660, [4661 x i8] c"/**\0A * \5Cfile pkwrite.h\0A *\0A * \5Cbrief Internal defines shared by the PK write module\0A */\0A/*\0A *  Copyright The Mbed TLS Contributors\0A *  SPDX-License-Identifier: Apache-2.0 OR GPL-2.0-or-later\0A */\0A\0A#ifndef MBEDTLS_PK_WRITE_H\0A#define MBEDTLS_PK_WRITE_H\0A\0A#include \22mbedtls/build_info.h\22\0A\0A#include \22mbedtls/pk.h\22\0A\0A#if defined(MBEDTLS_USE_PSA_CRYPTO)\0A#include \22psa/crypto.h\22\0A#endif /* MBEDTLS_USE_PSA_CRYPTO */\0A\0A/*\0A * Max sizes of key per types. Shown as tag + len (+ content).\0A */\0A\0A#if defined(MBEDTLS_RSA_C)\0A/*\0A * RSA public keys:\0A *  SubjectPublicKeyInfo  ::=  SEQUENCE  {          1 + 3\0A *       algorithm            AlgorithmIdentifier,  1 + 1 (sequence)\0A *                                                + 1 + 1 + 9 (rsa oid)\0A *                                                + 1 + 1 (params null)\0A *       subjectPublicKey     BIT STRING }          1 + 3 + (1 + below)\0A *  RSAPublicKey ::= SEQUENCE {                     1 + 3\0A *      modulus           INTEGER,  -- n            1 + 3 + MPI_MAX + 1\0A *      publicExponent    INTEGER   -- e            1 + 3 + MPI_MAX + 1\0A *  }\0A */\0A#define MBEDTLS_PK_RSA_PUB_DER_MAX_BYTES    (38 + 2 * MBEDTLS_MPI_MAX_SIZE)\0A\0A/*\0A * RSA private keys:\0A *  RSAPrivateKey ::= SEQUENCE {                    1 + 3\0A *      version           Version,                  1 + 1 + 1\0A *      modulus           INTEGER,                  1 + 3 + MPI_MAX + 1\0A *      publicExponent    INTEGER,                  1 + 3 + MPI_MAX + 1\0A *      privateExponent   INTEGER,                  1 + 3 + MPI_MAX + 1\0A *      prime1            INTEGER,                  1 + 3 + MPI_MAX / 2 + 1\0A *      prime2            INTEGER,                  1 + 3 + MPI_MAX / 2 + 1\0A *      exponent1         INTEGER,                  1 + 3 + MPI_MAX / 2 + 1\0A *      exponent2         INTEGER,                  1 + 3 + MPI_MAX / 2 + 1\0A *      coefficient       INTEGER,                  1 + 3 + MPI_MAX / 2 + 1\0A *      otherPrimeInfos   OtherPrimeInfos OPTIONAL  0 (not supported)\0A *  }\0A */\0A#define MBEDTLS_MPI_MAX_SIZE_2  (MBEDTLS_MPI_MAX_SIZE / 2 + \5C\0A                                 MBEDTLS_MPI_MAX_SIZE % 2)\0A#define MBEDTLS_PK_RSA_PRV_DER_MAX_BYTES    (47 + 3 * MBEDTLS_MPI_MAX_SIZE \5C\0A                                             + 5 * MBEDTLS_MPI_MAX_SIZE_2)\0A\0A#else /* MBEDTLS_RSA_C */\0A\0A#define MBEDTLS_PK_RSA_PUB_DER_MAX_BYTES   0\0A#define MBEDTLS_PK_RSA_PRV_DER_MAX_BYTES   0\0A\0A#endif /* MBEDTLS_RSA_C */\0A\0A#if defined(MBEDTLS_PK_HAVE_ECC_KEYS)\0A\0A/* Find the maximum number of bytes necessary to store an EC point. When USE_PSA\0A * is defined this means looking for the maximum between PSA and built-in\0A * supported curves. */\0A#if defined(MBEDTLS_USE_PSA_CRYPTO)\0A#define MBEDTLS_PK_MAX_ECC_BYTES   (PSA_BITS_TO_BYTES(PSA_VENDOR_ECC_MAX_CURVE_BITS) > \5C\0A                                    MBEDTLS_ECP_MAX_BYTES ? \5C\0A                                    PSA_BITS_TO_BYTES(PSA_VENDOR_ECC_MAX_CURVE_BITS) : \5C\0A                                    MBEDTLS_ECP_MAX_BYTES)\0A#else /* MBEDTLS_USE_PSA_CRYPTO */\0A#define MBEDTLS_PK_MAX_ECC_BYTES   MBEDTLS_ECP_MAX_BYTES\0A#endif /* MBEDTLS_USE_PSA_CRYPTO */\0A\0A/*\0A * EC public keys:\0A *  SubjectPublicKeyInfo  ::=  SEQUENCE  {      1 + 2\0A *    algorithm         AlgorithmIdentifier,    1 + 1 (sequence)\0A *                                            + 1 + 1 + 7 (ec oid)\0A *                                            + 1 + 1 + 9 (namedCurve oid)\0A *    subjectPublicKey  BIT STRING              1 + 2 + 1               [1]\0A *                                            + 1 (point format)        [1]\0A *                                            + 2 * ECP_MAX (coords)    [1]\0A *  }\0A */\0A#define MBEDTLS_PK_ECP_PUB_DER_MAX_BYTES    (30 + 2 * MBEDTLS_PK_MAX_ECC_BYTES)\0A\0A/*\0A * EC private keys:\0A * ECPrivateKey ::= SEQUENCE {                  1 + 2\0A *      version        INTEGER ,                1 + 1 + 1\0A *      privateKey     OCTET STRING,            1 + 1 + ECP_MAX\0A *      parameters [0] ECParameters OPTIONAL,   1 + 1 + (1 + 1 + 9)\0A *      publicKey  [1] BIT STRING OPTIONAL      1 + 2 + [1] above\0A *    }\0A */\0A#define MBEDTLS_PK_ECP_PRV_DER_MAX_BYTES    (29 + 3 * MBEDTLS_PK_MAX_ECC_BYTES)\0A\0A#else /* MBEDTLS_PK_HAVE_ECC_KEYS */\0A\0A#define MBEDTLS_PK_ECP_PUB_DER_MAX_BYTES   0\0A#define MBEDTLS_PK_ECP_PRV_DER_MAX_BYTES   0\0A\0A#endif /* MBEDTLS_PK_HAVE_ECC_KEYS */\0A\0A/* Define the maximum available public key DER length based on the supported\0A * key types (EC and/or RSA). */\0A#if (MBEDTLS_PK_RSA_PUB_DER_MAX_BYTES > MBEDTLS_PK_ECP_PUB_DER_MAX_BYTES)\0A#define MBEDTLS_PK_WRITE_PUBKEY_MAX_SIZE    MBEDTLS_PK_RSA_PUB_DER_MAX_BYTES\0A#else\0A#define MBEDTLS_PK_WRITE_PUBKEY_MAX_SIZE    MBEDTLS_PK_ECP_PUB_DER_MAX_BYTES\0A#endif\0A\0A#endif /* MBEDTLS_PK_WRITE_H */\0A\00" }
