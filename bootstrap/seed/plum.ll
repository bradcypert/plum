@.str44597 = private global { i64, i64, [34882 x i8] } { i64 -1, i64 34881, [34882 x i8] c"/*\0A *  ARIA implementation\0A *\0A *  Copyright The Mbed TLS Contributors\0A *  SPDX-License-Identifier: Apache-2.0 OR GPL-2.0-or-later\0A */\0A\0A/*\0A * This implementation is based on the following standards:\0A * [1] http://210.104.33.10/ARIA/doc/ARIA-specification-e.pdf\0A * [2] https://tools.ietf.org/html/rfc5794\0A */\0A\0A#include \22common.h\22\0A\0A#if defined(MBEDTLS_ARIA_C)\0A\0A#include \22mbedtls/aria.h\22\0A\0A#include <string.h>\0A\0A#include \22mbedtls/platform.h\22\0A\0A#if !defined(MBEDTLS_ARIA_ALT)\0A\0A#include \22mbedtls/platform_util.h\22\0A\0A/*\0A * modify byte order: ( A B C D ) -> ( B A D C ), i.e. swap pairs of bytes\0A *\0A * This is submatrix P1 in [1] Appendix B.1\0A *\0A * Common compilers fail to translate this to minimal number of instructions,\0A * so let's provide asm versions for common platforms with C fallback.\0A */\0A#if defined(MBEDTLS_HAVE_ASM)\0A#if defined(__arm__) /* rev16 available from v6 up */\0A/* armcc5 --gnu defines __GNUC__ but doesn't support GNU's extended asm */\0A#if defined(__GNUC__) && \5C\0A    (!defined(__ARMCC_VERSION) || __ARMCC_VERSION >= 6000000) && \5C\0A    __ARM_ARCH >= 6\0Astatic inline uint32_t aria_p1(uint32_t x)\0A{\0A    uint32_t r;\0A    __asm(\22rev16 %0, %1\22 : \22=l\22 (r) : \22l\22 (x));\0A    return r;\0A}\0A#define ARIA_P1 aria_p1\0A#elif defined(__ARMCC_VERSION) && __ARMCC_VERSION < 6000000 && \5C\0A    (__TARGET_ARCH_ARM >= 6 || __TARGET_ARCH_THUMB >= 3)\0Astatic inline uint32_t aria_p1(uint32_t x)\0A{\0A    uint32_t r;\0A    __asm(\22rev16 r, x\22);\0A    return r;\0A}\0A#define ARIA_P1 aria_p1\0A#endif\0A#endif /* arm */\0A#if defined(__GNUC__) && \5C\0A    defined(__i386__) || defined(__amd64__) || defined(__x86_64__)\0A/* I couldn't find an Intel equivalent of rev16, so two instructions */\0A#define ARIA_P1(x) ARIA_P2(ARIA_P3(x))\0A#endif /* x86 gnuc */\0A#endif /* MBEDTLS_HAVE_ASM && GNUC