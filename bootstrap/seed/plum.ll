        iv, iv_len,\0A                                  ad, ad_len,\0A                                  input, ilen + tag_len,\0A                                  output, ilen, olen);\0A        if (status == PSA_ERROR_INVALID_SIGNATURE) {\0A            return MBEDTLS_ERR_CIPHER_AUTH_FAILED;\0A        } else if (status != PSA_SUCCESS) {\0A            return MBEDTLS_ERR_PLATFORM_HW_ACCEL_FAILED;\0A        }\0A\0A        return 0;\0A    }\0A#endif /* MBEDTLS_USE_PSA_CRYPTO && !MBEDTLS_DEPRECATED_REMOVED */\0A\0A#if defined(MBEDTLS_GCM_C)\0A    if (MBEDTLS_MODE_GCM == ((mbedtls_cipher_mode_t) ctx->cipher_info->mode)) {\0A        int ret = MBEDTLS_ERR_ERROR_CORRUPTION_DETECTED;\0A\0A        *olen = ilen;\0A        ret = mbedtls_gcm_auth_decrypt(ctx->cipher_ctx, ilen,\0A                                       iv, iv_len, ad, ad_len,\0A                                       tag, tag_len, input, output);\0A\0A        if (ret == MBEDTLS_ERR_GCM_AUTH_FAILED) {\0A            ret = MBEDTLS_ERR_CIPHER_AUTH_FAILED;\0A        }\0A\0A        return ret;\0A    }\0A#endif /* MBEDTLS_GCM_C */\0A#if defined(MBEDTLS_CCM_C)\0A    if (MBEDTLS_MODE_CCM == ((mbedtls_cipher_mode_t) ctx->cipher_info->mode)) {\0A        int ret = MBEDTLS_ERR_ERROR_CORRUPTION_DETECTED;\0A\0A        *olen = ilen;\0A        ret = mbedtls_ccm_auth_decrypt(ctx->cipher_ctx, ilen,\0A                                       iv, iv_len, ad, ad_len,\0A                                       input, output, tag, tag_len);\0A\0A        if (ret == MBEDTLS_ERR_CCM_AUTH_FAILED) {\0A            ret = MBEDTLS_ERR_CIPHER_AUTH_FAILED;\0A        }\0A\0A        return ret;\0A    }\0A#endif /* MBEDTLS_CCM_C */\0A#if defined(MBEDTLS_CHACHAPOLY_C)\0A    if (MBEDTLS_CIPHER_CHACHA20_POLY1305 == ((mbedtls_cipher_type_t) ctx->cipher_info->type)) {\0A        int ret = MBEDTLS_ERR_ERROR_CORRUPTION_DETECTED;\0A\0A        /* ChachaPoly has fixed length nonce and MAC (tag) */\0A        if ((iv_len != mbedtls_cipher_info_get_iv_size(ctx->cipher_info)) ||\0A            (tag_len != 16U)) {\0A            return MBEDTLS_ERR_CIPHER_BAD_INPUT_DATA;\0A        }\0A\0A        *olen = ilen;\0A        ret = mbedtls_chachapoly_auth_decrypt(ctx->cipher_ctx, ilen,\0A                                              iv, ad, ad_len, tag, input, output);\0A\0A        if (ret == MBEDTLS_ERR_CHACHAPOLY_AUTH_FAILED) {\0A            ret = MBEDTLS_ERR_CIPHER_AUTH_FAILED;\0A        }\0A\0A        return ret;\0A    }\0A#endif /* MBEDTLS_CHACHAPOLY_C */\0A\0A    return MBEDTLS_ERR_CIPHER_FEATURE_UNAVAILABLE;\0A}\0A#endif /* MBEDTLS_CIPHER_MODE_AEAD */\0A\0A#if defined(MBEDTLS_CIPHER_MODE_AEAD) || defined(MBEDTLS_NIST_KW_C)\0A/*\0A * Packet-oriented encryption for AEAD/NIST_KW: public function.\0A */\0Aint mbedtls_cipher_auth_encrypt_ext(mbedtls_cipher_context_t *ctx,\0A                                    const unsigned char *iv, size_t iv_len,\0A                                    const unsigned char *ad, size_t ad_len,\0A                                    const unsigned char *input, size_t ilen,\0A                                    unsigned char *output, size_t output_len,\0A                                    size_t *olen, size_t tag_len)\0A{\0A#if defined(MBEDTLS_NIST_KW_C)\0A    if (\0A#if defined(MBEDTLS_USE_PSA_CRYPTO) && !defined(MBEDTLS_DEPRECATED_REMOVED)\0A        ctx->psa_enabled == 0 &&\0A#endif\0A        (MBEDTLS_MODE_KW == ((mbedtls_cipher_mode_t) ctx->cipher_info->mode) ||\0A         MBEDTLS_MODE_KWP == ((mbedtls_cipher_mode_t) ctx->cipher_info->mode))) {\0A        mbedtls_nist_kw_mode_t mode =\0A            (MBEDTLS_MODE_KW == ((mbedtls_cipher_mode_t) ctx->cipher_info->mode)) ?\0A            MBEDTLS_KW_MODE_KW : MBEDTLS_KW_MODE_KWP;\0A\0A        /* There is no iv, tag or ad associated with KW and KWP,\0A         * so these length should be 0 as documented. */\0A        if (iv_len != 0 || tag_len != 0 || ad_len != 0) {\0A            return MBEDTLS_ERR_CIPHER_BAD_INPUT_DATA;\0A        }\0A\0A        (void) iv;\0A        (