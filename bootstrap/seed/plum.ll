@.str40188 = private global { i64, i64, [12692 x i8] } { i64 -1, i64 12691, [12692 x i8] c"/**\0A * \5Cfile lmots.h\0A *\0A * \5Cbrief This file provides an API for the LM-OTS post-quantum-safe one-time\0A *        public-key signature scheme as defined in RFC8554 and NIST.SP.200-208.\0A *        This implementation currently only supports a single parameter set\0A *        MBEDTLS_LMOTS_SHA256_N32_W8 in order to reduce complexity.\0A */\0A/*\0A *  Copyright The Mbed TLS Contributors\0A *  SPDX-License-Identifier: Apache-2.0 OR GPL-2.0-or-later\0A */\0A\0A#ifndef MBEDTLS_LMOTS_H\0A#define MBEDTLS_LMOTS_H\0A\0A#include \22mbedtls/build_info.h\22\0A\0A#include \22psa/crypto.h\22\0A\0A#include \22mbedtls/lms.h\22\0A\0A#include <stdint.h>\0A#include <stddef.h>\0A\0A\0A#define MBEDTLS_LMOTS_PUBLIC_KEY_LEN(type) (MBEDTLS_LMOTS_TYPE_LEN + \5C\0A                                            MBEDTLS_LMOTS_I_KEY_ID_LEN + \5C\0A                                            MBEDTLS_LMOTS_Q_LEAF_ID_LEN + \5C\0A                                            MBEDTLS_LMOTS_N_HASH_LEN(type))\0A\0A#define MBEDTLS_LMOTS_SIG_TYPE_OFFSET       (0)\0A#define MBEDTLS_LMOTS_SIG_C_RANDOM_OFFSET (MBEDTLS_LMOTS_SIG_TYPE_OFFSET + \5C\0A                                           MBEDTLS_LMOTS_TYPE_LEN)\0A#define MBEDTLS_LMOTS_SIG_SIGNATURE_OFFSET(type) (MBEDTLS_LMOTS_SIG_C_RANDOM_OFFSET + \5C\0A                                                  MBEDTLS_LMOTS_C_RANDOM_VALUE_LEN(type))\0A\0A#ifdef __cplusplus\0Aextern \22C\22 {\0A#endif\0A\0A\0A#if defined(MBEDTLS_TEST_HOOKS)\0Aextern int (*mbedtls_lmots_sign_private_key_invalidated_hook)(unsigned char *);\0A#endif /* defined(MBEDTLS_TEST_HOOKS) */\0A\0A#if !defined(MBEDTLS_DEPRECATED_REMOVED)\0A/**\0A * \5Cbrief                    This function converts a \5Cref psa_status_t to a\0A *                           low-level LMS error code.\0A *\0A * \5Cparam status             The psa_status_t to convert\0A *\0A * \5Creturn                   The corresponding LMS error code.\0A */\0Aint MBEDTLS_DEPRECATED mbedtls_lms_error_from_psa(psa_status_t status);\0A#endif\0A\0A/**\0A * \5Cbrief                    This function initializes a public LMOTS context\0A *\0A * \5Cparam ctx                The uninitialized LMOTS context that will then be\0A *                           initialized.\0A */\0Avoid mbedtls_lmots_public_init(mbedtls_lmots_public_t *ctx);\0A\0A/**\0A * \5Cbrief                    This function uninitializes a public LMOTS context\0A *\0A * \5Cparam ctx                The initialized LMOTS context that will then be\0A *                           uninitialized.\0A */\0Avoid mbedtls_lmots_public_free(mbedtls_lmots_public_t *ctx);\0A\0A/**\0A * \5Cbrief                    This function imports an LMOTS public key into a\0A *                           LMOTS context.\0A *\0A * \5Cnote                     Before this function is called, the context must\0A *                           have been initialized.\0A *\0A * \5Cnote                     See IETF RFC8554 for details of the encoding of\0A *                           this public key.\0A *\0A * \5Cparam ctx                The initialized LMOTS context store the key in.\0A * \5Cparam key                The buffer from which the key will be read.\0A *                           #MBEDTLS_LMOTS_PUBLIC_KEY_LEN bytes will be read\0A *                           from this.\0A *\0A * \5Creturn         \5Cc 0 on success.\0A * \5Creturn         A non-zero error code on failure.\0A */\0Aint mbedtls_lmots_import_public_key(mbedtls_lmots_public_t *ctx,\0A                                    const unsigned char *key, size_t key_size);\0A\0A/**\0A * \5Cbrief                    This function exports an LMOTS public key from a\0A *                           LMOTS context that already contains a public key.\0A *\0A * \5Cnote                     Before this function is called, the context must\0A *                           have been initialized and the context must contain\0A *                           a public key.\0A *\0A * \5Cnote                     See IETF RFC8554 for details of the encoding of\0A *                           this public key.\0A *\0A * \5Cparam ctx                The initialized LMOTS context that contains the\0A *                           public key.\0A * \5Cparam key                The buffer into which the key will be output. Must\0A *                           be at least #MBEDTLS_LMOTS_PUBLIC_KEY_LEN in size.\0A *\0A * \5Creturn         \5Cc 0 on success.\0A * \5Creturn         A non-zero error code on failure.\0A */\0Aint mbedtls_lmots_export_public_key(const mbedtls_lmots_public_t *ctx,\0A                                    unsigned char *key, size_t key_size,\0A                                    size_t *key_len);\0A\0A/**\0A * \5Cbrief                    This function creates a candidate public key from\0A *                           an LMOTS signature. This can then be compared to\0A *                           the real public key to determine the validity of\0A *                           the signature.\0A *\0A * \5Cnote                     This function is exposed publicly to be used in LMS\0A *                           signature verification, it is expected that\0A *                           mbedtls_lmots_verify will be used for LMOTS\0A *                           signature verification.\0A *\0A * \5Cparam params             The LMOTS parameter set, q and I values as an\0A *                           mbedtls_lmots_parameters_t struct.\0A * \5Cparam msg                The buffer from which the message will be read.\0A * \5Cparam msg_size           The size of the message that will be read.\0A * \5Cparam sig                The buffer from which the signature will be read.\0A *                           #MBEDTLS_LMOTS_SIG_LEN bytes will be read from\0A *                           this.\0A * \5Cparam out                The buffer where the candidate public key will be\0A *                           stored. Must be at least #MBEDTLS_LMOTS_N_HASH_LEN\0A *                           bytes in size.\0A *\0A * \5Creturn         \5Cc 0 on success.\0A * \5Creturn         A non-zero error code on failure.\0A */\0Aint mbedtls_lmots_calculate_public_key_candidate(const mbedtls_lmots_parameters_t *params,\0A                                                 const unsigned char *msg,\0A                                                 size_t msg_size,\0A                                                 const unsigned char *sig,\0A                                                 size_t sig_size,\0A                                                 unsigned char *out,\0A                                                 size_t out_size,\0A                                                 size_t *out_len);\0A\0A/**\0A * \5Cbrief                    This function verifies a LMOTS signature, using a\0A *                           LMOTS context that contains a public key.\0A *\0A * \5Cwarning                  This function is **not intended for use in\0A *                           production**, due to as-yet unsolved problems with\0A *                           handling stateful keys. The API for this function\0A *                           may change considerably in future versions.\0A *\0A * \5Cnote                     Before this function is called, the context must\0A *                           have been initialized and must contain a public key\0A *                           (either by import or calculation from a private\0A *                           key).\0A *\0A * \5Cparam ctx                The initialized LMOTS context from which the public\0A *                           key will be read.\0A * \5Cparam msg                The buffer from which the message will be read.\0A * \5Cparam msg_size           The size of the message that will be read.\0A * \5Cparam sig                The buf from which the signature will be read.\0A *                           #MBEDTLS_LMOTS_SIG_LEN bytes will be read from\0A *                           this.\0A *\0A * \5Creturn         \5Cc 0 on successful verification.\0A * \5Creturn         A non-zero error code on failure.\0A */\0Aint mbedtls_lmots_verify(const mbedtls_lmots_public_t *ctx,\0A                         const unsigned char *msg,\0A                         size_t msg_size, const unsigned char *sig,\0A                         size_t sig_size);\0A\0A#if defined(MBEDTLS_LMS_PRIVATE)\0A\0A/**\0A * \5Cbrief                    This function initializes a private LMOTS context\0A *\0A * \5Cparam ctx                The uninitialized LMOTS context that will then be\0A *                           initialized.\0A */\0Avoid mbedtls_lmots_private_init(mbedtls_lmots_private_t *ctx);\0A\0A/**\0A * \5Cbrief                    This function uninitializes a private LMOTS context\0A *\0A * \5Cparam ctx                The initialized LMOTS context that will then be\0A *                           uninitialized.\0A */\0Avoid mbedtls_lmots_private_free(mbedtls_lmots_private_t *ctx);\0A\0A/**\0A * \5Cbrief                    This function calculates an LMOTS private key, and\0A *                           stores in into an LMOTS context.\0A *\0A * \5Cwarning                  This function is **not intended for use in\0A *                           production**, due to as-yet unsolved problems with\0A *                           handling stateful keys. The API for this function\0A *                           may change considerably in future versions.\0A *\0A * \5Cnote                     The seed must have at least 256 bits of entropy.\0A *\0A * \5Cparam ctx                The initialized LMOTS context to generate the key\0A *                           into.\0A * \5Cparam I_key_identifier   The key identifier of the key, as a 16-byte string.\0A * \5Cparam q_leaf_identifier  The leaf identifier of key. If this LMOTS key is\0A *                           not being used as part of an LMS key, this should\0A *                           be set to 0.\0A * \5Cparam seed               The seed used to deterministically generate the\0A *                           key.\0A * \5Cparam seed_size          The length of the seed.\0A *\0A * \5Creturn         \5Cc 0 on success.\0A * \5Creturn         A non-zero error code on failure.\0A */\0Aint mbedtls_lmots_generate_private_key(mbedtls_lmots_private_t *ctx,\0A                                       mbedtls_lmots_algorithm_type_t type,\0A                                       const unsigned char I_key_identifier[MBEDTLS_LMOTS_I_KEY_ID_LEN],\0A                                       uint32_t q_leaf_identifier,\0A                                       const unsigned char *seed,\0A                                       size_t seed_size);\0A\0A/**\0A * \5Cbrief                    This function generates an LMOTS public key from a\0A *                           LMOTS context that already contains a private key.\0A *\0A * \5Cnote                     Before this function is called, the context must\0A *                           have been initialized and the context must contain\0A *                           a private key.\0A *\0A * \5Cparam ctx                The initialized LMOTS context to generate the key\0A *                           from and store it into.\0A *\0A * \5Creturn         \5Cc 0 on success.\0A * \5Creturn         A non-zero error code on failure.\0A */\0Aint mbedtls_lmots_calculate_public_key(mbedtls_lmots_public_t *ctx,\0A                                       const mbedtls_lmots_private_t *priv_ctx);\0A\0A/**\0A * \5Cbrief                    This function creates a LMOTS signature, using a\0A *                           LMOTS context that contains a private key.\0A *\0A * \5Cnote                     Before this function is called, the context must\0A *                           have been initialized and must contain a private\0A *                           key.\0A *\0A * \5Cnote                     LMOTS private keys can only be used once, otherwise\0A *                           attackers may be able to create forged signatures.\0A *                           If the signing operation is successful, the private\0A *                           key in the context will be erased, and no further\0A *                           signing will be possible until another private key\0A *                           is loaded\0A *\0A * \5Cparam ctx                The initialized LMOTS context from which the\0A *                           private key will be read.\0A * \5Cparam f_rng              The RNG function to be used for signature\0A *                           generation.\0A * \5Cparam p_rng              The RNG context to be passed to f_rng\0A * \5Cparam msg                The buffer from which the message will be read.\0A * \5Cparam msg_size           The size of the message that will be read.\0A * \5Cparam sig                The buf into which the signature will be stored.\0A *                           Must be at least #MBEDTLS_LMOTS_SIG_LEN in size.\0A *\0A * \5Creturn         \5Cc 0 on success.\0A * \5Creturn         A non-zero error code on failure.\0A */\0Aint mbedtls_lmots_sign(mbedtls_lmots_private_t *ctx,\0A                       int (*f_rng)(void *, unsigned char *, size_t),\0A                       void *p_rng, const unsigned char *msg, size_t msg_size,\0A                       unsigned char *sig, size_t sig_size, size_t *sig_len);\0A\0A#endif /* defined(MBEDTLS_LMS_PRIVATE) */\0A\0A#ifdef __cplusplus\0A}\0A#endif\0A\0A#endif /* MBEDTLS_LMOTS_H */\0A\00" }
