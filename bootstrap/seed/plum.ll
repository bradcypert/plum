rse certificate verify\22));\0A        ssl->state++;\0A        return 0;\0A    }\0A\0A#if defined(MBEDTLS_SSL_KEEP_PEER_CERTIFICATE)\0A    if (ssl->session_negotiate->peer_cert == NULL) {\0A        MBEDTLS_SSL_DEBUG_MSG(2, (\22<= skip parse certificate verify\22));\0A        ssl->state++;\0A        return 0;\0A    }\0A#else /* MBEDTLS_SSL_KEEP_PEER_CERTIFICATE */\0A    if (ssl->session_negotiate->peer_cert_digest == NULL) {\0A        MBEDTLS_SSL_DEBUG_MSG(2, (\22<= skip parse certificate verify\22));\0A        ssl->state++;\0A        return 0;\0A    }\0A#endif /* !MBEDTLS_SSL_KEEP_PEER_CERTIFICATE */\0A\0A    /* Read the message without adding it to the checksum */\0A    ret = mbedtls_ssl_read_record(ssl, 0 /* no checksum update */);\0A    if (0 != ret) {\0A        MBEDTLS_SSL_DEBUG_RET(1, (\22mbedtls_ssl_read_record\22), ret);\0A        return ret;\0A    }\0A\0A    ssl->state++;\0A\0A    /* Process the message contents */\0A    if (ssl->in_msgtype != MBEDTLS_SSL_MSG_HANDSHAKE ||\0A        ssl->in_msg[0] != MBEDTLS_SSL_HS_CERTIFICATE_VERIFY) {\0A        MBEDTLS_SSL_DEBUG_MSG(1, (\22bad certificate verify message\22));\0A        return MBEDTLS_ERR_SSL_UNEXPECTED_MESSAGE;\0A    }\0A\0A    i = mbedtls_ssl_hs_hdr_len(ssl);\0A\0A#if !defined(MBEDTLS_SSL_KEEP_PEER_CERTIFICATE)\0A    peer_pk = &ssl->handshake->peer_pubkey;\0A#else /* !MBEDTLS_SSL_KEEP_PEER_CERTIFICATE */\0A    if (ssl->session_negotiate->peer_cert == NULL) {\0A        /* Should never happen */\0A        return MBEDTLS_ERR_SSL_INTERNAL_ERROR;\0A    }\0A    peer_pk = &ssl->session_negotiate->peer_cert->pk;\0A#endif /* MBEDTLS_SSL_KEEP_PEER_CERTIFICATE */\0A\0A    /*\0A     *  struct {\0A     *     SignatureAndHashAlgorithm algorithm; -- TLS 1.2 only\0A     *     opaque signature<0..2^16-1>;\0A     *  } DigitallySigned;\0A     */\0A    if (i + 2 > ssl->in_hslen) {\0A        MBEDTLS_SSL_DEBUG_MSG(1, (\22bad certificate verify message\22));\0A        return MBEDTLS_ERR_SSL_DECODE_ERROR;\0A    }\0A\0A    /*\0A     * Hash\0A     */\0A    md_alg = mbedtls_ssl_md_alg_from_hash(ssl->in_msg[i]);\0A\0A    if (md_alg == MBEDTLS_MD_NONE || mbedtls_ssl_set_calc_verify_md(ssl, ssl->in_msg[i])) {\0A        MBEDTLS_SSL_DEBUG_MSG(1, (\22peer not adhering to requested sig_alg\22\0A                                  \22 for verify message\22));\0A        return MBEDTLS_ERR_SSL_ILLEGAL_PARAMETER;\0A    }\0A\0A#if !defined(MBEDTLS_MD_SHA1)\0A    if (MBEDTLS_MD_SHA1 == md_alg) {\0A        hash_start += 16;\0A    }\0A#endif\0A\0A    /* Info from md_alg will be used instead */\0A    hashlen = 0;\0A\0A    i++;\0A\0A    /*\0A     * Signature\0A     */\0A    if ((pk_alg = mbedtls_ssl_pk_alg_from_sig(ssl->in_msg[i]))\0A        == MBEDTLS_PK_NONE) {\0A        MBEDTLS_SSL_DEBUG_MSG(1, (\22peer not adhering to requested sig_alg\22\0A                                  \22 for verify message\22));\0A        return MBEDTLS_ERR_SSL_ILLEGAL_PARAMETER;\0A    }\0A\0A    /*\0A     * Check the certificate's key type matches the signature alg\0A     */\0A    if (!mbedtls_pk_can_do(peer_pk, pk_alg)) {\0A        MBEDTLS_SSL_DEBUG_MSG(1, (\22sig_alg doesn't match cert key\22));\0A        return MBEDTLS_ERR_SSL_ILLEGAL_PARAMETER;\0A    }\0A\0A    i++;\0A\0A    if (i + 2 > ssl->in_hslen) {\0A        MBEDTLS_SSL_DEBUG_MSG(1, (\22bad certificate verify message\22));\0A        return MBEDTLS_ERR_SSL_DECODE_ERROR;\0A    }\0A\0A    sig_len = MBEDTLS_GET_UINT16_BE(ssl->in_msg, i);\0A    i += 2;\0A\0A    if (i + sig_len != ssl->in_hslen) {\0A        MBEDTLS_SSL_DEBUG_MSG(1, (\22bad certificate verify message\22));\0A        return MBEDTLS_ERR_SSL_DECODE_ERROR;\0A    }\0A\0A    /* Calculate hash and verify signature */\0A    {\0A        size_t dummy_hlen;\0A        ret = ssl->handshake->calc_verify(ssl, hash, &dummy_hlen);\0A        if (0 != ret) {\0A            MBEDTLS_SSL_DEBUG_RET(1, (\22calc_verify\22), ret);\0A            return ret;\0A        }\0A    }\0A\0A    if ((ret = mbedtls_pk_verify(peer_pk,\0A                                 md_alg, hash_start, hashlen,\0A                                 ssl->in_msg + i, sig_len)) != 0) {\0A        MBEDTLS_SSL_DEBUG_RET(1, \22mbedtls_pk_verify\22, ret);\0A        return ret;\0A    }\0A\0A    ret = mbedtls_ssl_update_handshake_status(ssl);\0A    if (0 != ret) {\0A        MBEDTLS_SSL_DEBUG_RET(1, (\22mbedtls_ssl_update_handshake_status\22), ret);\0A        return ret;\0A    }\0A\0A    MBEDTLS_SSL_DEBUG_MSG(2, (\22<= parse certificate verify\22));\0A\0A    return ret;\0A}\0A#endif /* MBEDTLS_KEY_EXCHANGE_CERT_REQ_ALLOWED_ENABLED */\0A\0A#if defined(MBEDTLS_SSL_SESSION_TICKETS)\0AMBEDTLS_CHECK_RETURN_CRITICAL\0Astatic int ssl_write_new_session_ticket(mbedtls_ssl_context *ssl)\0A{\0A    int ret = MBEDTLS_ERR_ERROR_CORRUPTION_DETECTED;\0A    size_t tlen;\0A    uint32_t lifetime;\0A\0A    MBEDTLS_SSL_DEBUG_MSG(2, (\22=> write new session ticket\22));\0A\0A    ssl->out_msgtype = MBEDTLS_SSL_MSG_HANDSHAKE;\0A    ssl->out_msg[0]  = MBEDTLS_SSL_HS_NEW_SESSION_TICKET;\0A\0A    /*\0A     * struct {\0A     *     uint32 ticket_lifetime_hint;\0A     *     opaque ticket<0..2^16-1>;\0A     * } NewSessionTicket;\0A     *\0A     * 4  .  7   ticket_lifetime_hint (0 = unspecified)\0A     * 8  .  9   ticket_len (n)\0A     * 10 .  9+n ticket content\0A     */\0A\0A#if defined(MBEDTLS_HAVE_TIME)\0A    ssl->session_negotiate->ticket_creation_time = mbedtls_ms_time();\0A#endif\0A    if ((ret = ssl->conf->f_ticket_write(ssl->conf->p_ticket,\0A                                         ssl->session_negotiate,\0A                                         ssl->out_msg + 10,\0A                                         ssl->out_msg + MBEDTLS_SSL_OUT_CONTENT_LEN,\0A                                         &tlen, &lifetime)) != 0) {\0A        MBEDTLS_SSL_DEBUG_RET(1, \22mbedtls_ssl_ticket_write\22, ret);\0A        tlen = 0;\0A    }\0A\0A    MBEDTLS_PUT_UINT32_BE(lifetime, ssl->out_msg, 4);\0A    MBEDTLS_PUT_UINT16_BE(tlen, ssl->out_msg, 8);\0A    ssl->out_msglen = 10 + tlen;\0A\0A    /*\0A     * Morally equivalent to updating ssl->state, but NewSessionTicket and\0A     * ChangeCipherSpec share the same state.\0A     */\0A    ssl->handshake->new_session_ticket = 0;\0A\0A    if ((ret = mbedtls_ssl_write_handshake_msg(ssl)) != 0) {\0A        MBEDTLS_SSL_DEBUG_RET(1, \22mbedtls_ssl_write_handshake_msg\22, ret);\0A        return ret;\0A    }\0A\0A    MBEDTLS_SSL_DEBUG_MSG(2, (\22<= write new session ticket\22));\0A\0A    return 0;\0A}\0A#endif /* MBEDTLS_SSL_SESSION_TICKETS */\0A\0A/*\0A * SSL handshake -- server side -- single step\0A */\0Aint mbedtls_ssl_handshake_server_step(mbedtls_ssl_context *ssl)\0A{\0A    int ret = 0;\0A\0A    MBEDTLS_SSL_DEBUG_MSG(2, (\22server state: %d\22, ssl->state));\0A\0A    switch (ssl->state) {\0A        case MBEDTLS_SSL_HELLO_REQUEST:\0A            ssl->state = MBEDTLS_SSL_CLIENT_HELLO;\0A            break;\0A\0A        /*\0A         *  <==   ClientHello\0A         */\0A        case MBEDTLS_SSL_CLIENT_HELLO:\0A            ret = ssl_parse_client_hello(ssl);\0A            break;\0A\0A#if defined(MBEDTLS_SSL_PROTO_DTLS)\0A        case MBEDTLS_SSL_SERVER_HELLO_VERIFY_REQUEST_SENT:\0A            return MBEDTLS_ERR_SSL_HELLO_VERIFY_REQUIRED;\0A#endif\0A\0A        /*\0A         *  ==>   ServerHello\0A         *        Certificate\0A         *      ( ServerKeyExchange  )\0A         *      ( CertificateRequest )\0A         *        ServerHelloDone\0A         */\0A        case MBEDTLS_SSL_SERVER_HELLO:\0A            ret = ssl_write_server_hello(ssl);\0A            break;\0A\0A        case MBEDTLS_SSL_SERVER_CERTIFICATE:\0A            ret = mbedtls_ssl_write_certificate(ssl);\0A            break;\0A\0A        case MBEDTLS_SSL_SERVER_KEY_EXCHANGE:\0A            ret = ssl_write_server_key_exchange(ssl);\0A            break;\0A\0A        case MBEDTLS_SSL_CERTIFICATE_REQUEST:\0A            ret = ssl_write_certificate_request(ssl);\0A            break;\0A\0A        case MBEDTLS_SSL_SERVER_HELLO_DONE:\0A            ret = ssl_write_server_hello_done(ssl);\0A            break;\0A\0A        /*\0A         *  <== ( Certificate/Alert  )\0A         *        ClientKeyExchange\0A         *      ( CertificateVerify  )\0A         *        ChangeCipherSpec\0A         *        Finished\0A         */\0A        case MBEDTLS_SSL_CLIENT_CERTIFICATE:\0A            ret = mbedtls_ssl_parse_certificate(ssl);\0A            break;\0A\0A        case MBEDTLS_SSL_CLIENT_KEY_EXCHANGE:\0A            ret = ssl_parse_client_key_exchange(ssl);\0A            break;\0A\0A        case MBEDTLS_SSL_CERTIFICATE_VERIFY:\0A            ret = ssl_parse_certificate_verify(ssl);\0A            break;\0A\0A        case MBEDTLS_SSL_CLIENT_CHANGE_CIPHER_SPEC:\0A            ret = mbedtls_ssl_parse_change_cipher_spec(ssl);\0A            break;\0A\0A        case MBEDTLS_SSL_CLIENT_FINISHED:\0A            ret = mbedtls_ssl_parse_finished(ssl);\0A            break;\0A\0A        /*\0A         *  ==> ( NewSessionTicket )\0A         *        ChangeCipherSpec\0A         *        Finished\0A         */\0A        case MBEDTLS_SSL_SERVER_CHANGE_CIPHER_SPEC:\0A#if defined(MBEDTLS_SSL_SESSION_TICKETS)\0A            if (ssl->handshake->new_session_ticket != 0) {\0A                ret = ssl_write_new_session_ticket(ssl);\0A            } else\0A#endif\0A            ret = mbedtls_ssl_write_change_cipher_spec(ssl);\0A            break;\0A\0A        case MBEDTLS_SSL_SERVER_FINISHED:\0A            ret = mbedtls_ssl_write_finished(ssl);\0A            break;\0A\0A        case MBEDTLS_SSL_FLUSH_BUFFERS:\0A            MBEDTLS_SSL_DEBUG_MSG(2, (\22handshake: done\22));\0A            ssl->state = MBEDTLS_SSL_HANDSHAKE_WRAPUP;\0A            break;\0A\0A        case MBEDTLS_SSL_HANDSHAKE_WRAPUP:\0A            mbedtls_ssl_handshake_wrapup(ssl);\0A            break;\0A\0A        default:\0A            MBEDTLS_SSL_DEBUG_MSG(1, (\22invalid state %d\22, ssl->state));\0A            return MBEDTLS_ERR_SSL_BAD_INPUT_DATA;\0A    }\0A\0A    return ret;\0A}\0A\0Avoid mbedtls_ssl_conf_preference_order(mbedtls_ssl_config *conf, int order)\0A{\0A    conf->respect_cli_pref = order;\0A}\0A\0A#endif /* MBEDTLS_SSL_SRV_C && MBEDTLS_SSL_PROTO_TLS1_2 */\0A\00" }
