e }\0A    else { match b.at(i) {\0A        Some(c) => {\0A            let ok = if field_value { c == 9 || (c >= 32 && c != 127) } else { c > 32 && c != 127 };\0A            if ok { http_text_ok_acc(b, i + 1, field_value) } else { false }\0A        },\0A        None => false,\0A    } }\0A\0Alet http_validate_headers (headers: Array[Header]) (i: Int): Result[Unit, String] =\0A    if i >= headers.len() { Ok(()) }\0A    else if !http_token_ok(headers[i].name) { Err(\22http: invalid header name\22) }\0A    else if !http_text_ok_acc(headers[i].value.as_bytes(), 0, true) { Err(\22http: invalid header value\22) }\0A    else { http_validate_headers(headers, i + 1) }\0A\0A// Public structs are unchecked data. Validate the actual interpolated fields\0A// here, even when a Url was constructed without going through Url.parse.\0Alet http_build_request (method: String) (parsed: Url.Url) (headers: Array[Header]) (body: String): Result[String, String] = {\0A    let target = Url.request_target(parsed);\0A    let authority = Url.authority(parsed);\0A    if !http_token_ok(method) { Err(\22http client: invalid method\22) }\0A    else if String.is_empty(target) || !http_text_ok_acc(target.as_bytes(), 0, false) { Err(\22http client: invalid request target\22) }\0A    else if String.is_empty(authority) || !http_text_ok_acc(authority.as_bytes(), 0, false) { Err(\22http client: invalid authority\22) }\0A    else { Result.map(http_validate_headers(headers, 0), |ignored| {\0A        let extra_header_lines = Array.fold(headers, \22\22, |acc, h| acc.concat(h.name).concat(\22: \22).concat(h.value).concat(\22\5Cr\5Cn\22));\0A        let content_length_line = if String.is_empty(body) { \22\22 } else { \22Content-Length: \22.concat(body.len().to_string()).concat(\22\5Cr\5Cn\22) };\0A        method.concat(\22 \22).concat(target).concat(\22 HTTP/1.1\5Cr\5Cn\22)\0A            .concat(\22Host: \22).concat(authority).concat(\22\5Cr\5Cn\22)\0A            .concat(\22Connection: close\5Cr\5Cn\22)\0A            .concat(content_length_line)\0A            .concat(extra_header_lines)\0A            .concat(\22\5Cr\5Cn\22)\0A            .concat(body)\0A    }) }\0A}\0A\0A/// Reads (and accumulates) until the blank-line header/body separator\0A/// has actually arrived — it may take more than one `tcp_read` call to\0A/// see it at all, and a single `tcp_read` may ALSO return part of the\0A/// body past it in the same chunk (`http_parse_head` below splits that\0A/// back out). An empty read here means the peer closed before the\0A/// headers even finished, always a real error, never a legitimate\0A/// empty response.\0Alet http_recv_headers_acc (fd: Int) (secure: Int) (acc: String): Result[String, String] =\0A    match String.index_of(acc, \22\5Cr\5Cn\5Cr\5Cn\22) {\0A        Some(_) => Ok(acc),\0A        None => {\0A            let chunk = if secure == 1 { http_tls_read(fd, 4096) } else { Net.read(fd, 4096) };\0A            if String.is_empty(chunk) { Err(\22http client: connection closed before the response headers were complete\22) }\0A            else { http_recv_headers_acc(fd, secure, acc.concat(chunk)) }\0A        },\0A    }\0A\0Alet http_status_valid (status: Int): Bool = status >= 100 && status <= 599\0Alet http_informational (status: Int): Bool = status >= 100 && status < 200\0A\0A// RFC 9112 section 6.3: these responses end at the header terminator,\0A// before Content-Length or Transfer-Encoding can select body framing.\0Alet http_response_bodyless (method: String) (status: Int): Bool =\0A    method == \22HEAD\22 || http_informational(status) || status == 204 || status == 304\0A\0Alet http_tunnel (method: String) (status: Int): Bool =\0A    method == \22CONNECT\22 && status >= 200 && status < 300\0A\0Alet http_parse_status_line (line: String): Result[Int, String] = {\0A    let parts = line.split(\22 \22);\0A    if parts.len() < 2 { Err(\22http client: malformed status line: \22.concat(line)) }\0A    else if parts[0] != \22HTTP/1.0\22 && parts[0] != \22HTTP/1.1\22 {\0A        Err(\22http client: unsupported HTTP version\22)\0A    } else {\0A        let code = parts[1].as_bytes();\0A        if code.len() != 3 || !http_digit(http_byte(code, 0)) || !http_digit(http_byte(code, 1)) || !http_digit(http_byte(code, 2)) {\0A            Err(\22http client: malformed status code\22)\0A        } else { match String.parse_int(parts[1]) {\0A            Err(e) => Err(\22http client: malformed status code: \22.concat(e)),\0A            Ok(status) => if http_status_valid(status) { Ok(status) } else { Err(\22http client: invalid response status\22) },\0A        } }\0A    }\0A}\0A\0Alet http_byte (b: Bytes) (i: Int): Int = match b.at(i) { Some(c) => c, None => -1 }\0Alet http_ows (c: Int): Bool = c == 32 || c == 9\0Alet http_ows_start (b: Bytes) (i: Int): Int =\0A    if http_ows(http_byte(b, i)) { http_ows_start(b, i + 1) } else { i }\0Alet http_ows_end (b: Bytes) (i: Int): Int =\0A    if http_ows(http_byte(b, i - 1)) { http_ows_end(b, i - 1) } else { i }\0A\0A// Only SP/HTAB are optional whitespace. Generic Unicode trimming would\0A// erase malformed controls. String.slice uses codepoints, Bytes uses octets.\0Alet http_trim_ows (s: String): String = {\0A    let b = s.as_bytes();\0A    let start = http_ows_start(b, 0);\0A    let end = http_ows_end(b, b.len());\0A    String.slice(s, start, String.char_len(s) - (b.len() - end))\0A}\0A\0Alet http_parse_header_line (line: String): Result[Header, String] =\0A    match String.index_of(line, \22:\22) {\0A        None => Err(\22http: malformed header line\22),\0A        Some(i) => {\0A            let name = String.slice(line, 0, i);\0A            let value = http_trim_ows(String.slice(line, i + 1, String.char_len(line)));\0A            if !http_token_ok(name) { Err(\22http: invalid header name\22) }\0A            else if !http_text_ok_acc(value.as_bytes(), 0, true) { Err(\22http: invalid header value\22) }\0A            else { Ok(Header { name: name, value: value }) }\0A        },\0A    }\0A\0A// Tail recursion keeps the stack bounded and moves the accumulator into\0A// push. Never silently discard a malformed field (including obs-fold).\0Alet http_parse_headers_acc (lines: Array[String]) (i: Int) (acc: Array[Header]): Result[Array[Header], String] =\0A    if i >= lines.len() { Ok(acc) }\0A    else { match http_parse_header_line(lines[i]) {\0A        Err(e) => Err(e),\0A        Ok(h) => http_parse_headers_acc(lines, i + 1, acc.push(h)),\0A    } }\0A\0Alet http_parse_headers (lines: Array[String]): Result[Array[Header], String] =\0A    http_parse_headers_acc(lines, 0, [])\0A\0A// Parsed names are ASCII tokens; folding never changes their spelling in\0A// the public Header. The same comparison serves Host and body framing.\0Alet http_ascii_lower (c: Int): Int = if c >= 65 && c <= 90 { c + 32 } else { c }\0Alet http_ascii_equal (a: Bytes) (b: Bytes) (i: Int): Bool =\0A    if i >= a.len() { true }\0A    else if http_ascii_lower(http_byte(a, i)) != http_ascii_lower(http_byte(b, i)) { false }\0A    else { http_ascii_equal(a, b, i + 1) }\0A\0Alet http_header_named (header: Header) (name: String): Bool =\0A    header.name.len() == name.len() && http_ascii_equal(header.name.as_bytes(), name.as_bytes(), 0)\0A\0Alet http_find_header (headers: Array[Header]) (name: String): Option[String] =\0A    Option.map(Array.find(headers, |h| http_header_named(h, name)), |h| h.value)\0A\0A/// Splits the raw, already-fully-received header block (see `http_recv_\0A/// headers_acc` above) into the parsed status/headers plus whatever body\0A/// bytes rode along in the same read.\0Alet http_parse_head (raw: String): Result[Head, String] = {\0A    let sep_index = match String.index_of(raw, \22\5Cr\5Cn\5Cr\5Cn\22) { Some(i) => i, None => raw.len() };\0A    let leftover_body = if sep_index + 4 <= raw.len() { String.slice(raw, sep_index + 4, raw.len()) } else { \22\22 };\0A    let lines = String.slice(raw, 0, sep_index).split(\22\5Cr\5Cn\22);\0A    if lines.len() == 0 { Err(\22http client: empty response\22) }\0A    else { http_parse_status_line(lines[0]) |> Result.and_then(_, |status|\0A        Result.map(http_parse_headers(Array.drop(lines, 1)), |headers| Head {\0A            status: status, headers: headers, leftover_body: leftover_body,\0A        })) }\0A}\0A\0Alet http_recv_body_by_length_acc (fd: Int) (secure: Int) (acc: String) (remaining: Int): Result[String, String] =\0A    if remaining <= 0 { Ok(acc) }\0A    else {\0A        let chunk = if secure == 1 { http_tls_read(fd, remaining) } else { Net.read(fd, remaining) };\0A        if String.is_empty(chunk) { Err(\22http client: connection closed before the full response body was received\22) }\0A        else { http_recv_body_by_length_acc(fd, secure, acc.concat(chunk), remaining - chunk.len()) }\0A    }\0A\0Alet http_recv_body_until_close_acc (fd: Int) (secure: Int) (acc: String): String = {\0A    let chunk = if secure == 1 { http_tls_read(fd, 4096) } else { Net.read(fd, 4096) };\0A    if String.is_empty(chunk) { acc } else { http_recv_body_until_close_acc(fd, secure, acc.concat(chunk)) }\0A}\0A\0A// Response framing needs the initiating method as well as the status.\0A// Ignore even buffered content for a bodyless response; never allocate a\0A// receive buffer based on its representation's advertised Content-Length.\0Alet http_read_body (fd: Int) (secure: Int) (method: String) (status: Int) (headers: Array[Header]) (leftover_body: String): Result[String, String] =\0A    if http_response_bodyless(method, status) { Ok(\22\22) }\0A    else if http_tunnel(method, status) { Err(\22http client: CONNECT tunnels are not supported\22) }\0A    else { match http_find_header(headers, \22Content-Length\22) {\0A        Some(cl) => match String.parse_int(cl) {\0A            Err(e) => Err(\22http: invalid Content-Length header: \22.concat(e)),\0A            Ok(content_length) => http_recv_body_by_length_acc(fd, secure, leftover_body, content_length - leftover_body.len()),\0A        },\0A        None => match http_find_header(headers, \22Transfer-Encoding\22) {\0A            Some(te) => Err(\22http: Transfer-Encoding (\22.concat(te).concat(\22) is not supported yet\22)),\0A            None => Ok(http_recv_body_until_close_acc(fd, secure, leftover_body)),\0A        },\0A    } }\0A\0A/// The REQUEST-side sibling of `http_read_body` above — same `Content-\0A/// Length`/`Transfer-Encoding` handling, but a DELIBERATELY different\0A/// answer when NEITHER is present: an EMPTY body (`leftover_body` as-\0A/// is), never \22read until the connection closes.\22 Originally shared\0A/// `http_read_body` directly for both — a real, live DEADLOCK surfaced\0A/// exactly that assumption was wrong, not just imprecise: a bodyless\0A/// `GET` (no `Content-Length`, since there's no body to measure) has no\0A/// reason to ever close its OWN write side, so a server blocked\0A/// \22reading until close\22 on it hangs forever waiting for a body that\0A/// will never arrive — confirmed directly (a real test hung against a\0A/// real socket, root-caused by isolating each step with `println`\0A/// debugging until the exact hang site was found), not merely\0A/// theorized. The response side's OWN \22no length header -> read until\0A/// close\22 answer stays correct on ITS side: every request this client\0A/// sends already includes `Connection: close`, so that read is bounded\0A/// by the SERVER eventually closing once it's done writing — a\0A/// guarantee nothing analogous exists for on the request side.\0Alet http_read_request_body (fd: Int) (headers: Array[Header]) (leftover_body: String): Result[String, String] =\0A    match http_find_header(headers, \22Content-Length\22) {\0A        Some(cl) => match String.parse_int(cl) {\0A            Err(e) => Err(\22http: invalid Content-Length header: \22.concat(e)),\0A            Ok(content_length) => http_recv_body_by_length_acc(fd, 0, leftover_body, content_length - leftover_body.len()),\0A        },\0A        None => match http_find_header(headers, \22Transfer-Encoding\22) {\0A            Some(te) => Err(\22http: Transfer-Encoding (\22.concat(te).concat(\22) is not supported yet\22)),\0A            None => Ok(leftover_body),\0A        },\0A    }\0A\0A// Carry only unread bytes to the next head. A direct tail call releases\0A// the previous head instead of retaining one continuation per interim\0A// response. The count also bounds a peer's endless informational stream.\0Alet http_recv_final_head (fd: Int) (secure: Int) (pending: String) (interim_count: Int): Result[Head, String] =\0A    match http_recv_headers_acc(fd, secure, pending) {\0A        Err(e) => Err(e),\0A        Ok(raw) => match http_parse_head(raw) {\0A            Err(e) => Err(e),\0A            Ok(head) => if head.status == 101 { Err(\22http client: protocol upgrades are not supported\22) }\0A                else if http_informational(head.status) {\0A                    if interim_count >= 100 { Err(\22http client: too many informational responses\22) }\0A                    else { http_recv_final_head(fd, secure, head.leftover_body, interim_count + 1) }\0A                } else { Ok(head) },\0A        },\0A    }\0A\0Alet http_do_request (fd: Int) (secure: Int) (method: String) (wire: String): Result[Response, String] =\0A    (if secure == 1 { http_tls_write(fd, wire) } else { Net.write(fd, wire) })\0A        |> Result.and_then(_, |ignored| http_recv_final_head(fd, secure, \22\22, 0))\0A        |> Result.and_then(_, |head| Result.map(http_read_body(fd, secure, method, head.status, head.headers, head.leftover_body), |response_body| Response { status: head.status, headers: head.headers, body: response_body }))\0A\0A/// Sends a request over HTTP or HTTPS. HTTPS verifies the peer's\0A/// certificate and hostname using the native TLS trust-store integration.\0A///\0A/// Invalid URL text, methods, header names, and header values return Err\0A/// before connecting. Methods and names must be nonempty ASCII tokens;\0A/// values may contain spaces, HTAB, and UTF-8, but no other ASCII controls\0A/// or DEL. Bodies are not subject to protocol-field validation.\0A///\0A/// Reads past up to 100 informational responses to the final response.\0A/// HEAD, 204, and 304 responses have an empty body regardless of framing\0A/// headers. Protocol upgrades (101) and successful CONNECT tunnels return\0A/// Err and close the connection; this API cannot hand off a transport.\0Apub let request (method: String) (url: String) (headers: Array[Header]) (body: String): Result[Response, String] =\0A    http_parse_url(url)\0A        |> Result.and_then(_, |parsed| http_build_request(method, parsed, headers, body)\0A            |> Result.and_then(_, |wire| if parsed.scheme == \22https\22 {\0A                let fd = unsafe { tls_connect(parsed.host.as_cstr(), parsed.port) };\0A                if fd < 0 { Err(\22https client: TLS connection failed\22) }\0A                else { let result = http_do_request(fd, 1, method, wire); unsafe { tls_close(fd) }; result }\0A            } else {\0A                Net.connect_to(parsed.host, parsed.port) |> Result.and_then(_, |fd| {\0A                    let result = http_do_request(fd, 0, method, wire);\0A                    Net.close(fd);\0A                    result\0A                })\0A            }))\0A\0A/// Fetches a URL and reads the whole response.\0A///\0A/// Supports both `http://` and `https://`; HTTPS uses the native TLS\0A/// transport with platform trust-store and hostname verification.\0A///\0A/// Redirects are NOT followed: a 301 or 302 comes back as itself, with\0A/// its `Location` header, so the caller decides. Following one changes\0A/// which host you are talking to, which is not a decision a library\0A/// should make quietly.\0Apub let get (url: String): Result[Response, String] = request(\22GET\22, url, [], \22\22)\0A\0A/// POSTs a body and reads the whole response. Sets `Content-Length`;\0A/// set `Content-Type` yourself if the server needs one.\0A///\0A/// Redirects are not followed — see