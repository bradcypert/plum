4) | b);\0A    }\0A    path[n / 2] = '\5C0';\0A    const char *digest = plum_cache_hash_file(path);\0A    free(path);\0A    return digest;\0A}\0A\0A// Verify the bytes actually copied, not a prior read of the source path.\0A// A concurrent cleaner can remove an entry at any point; that is a miss.\0Along long plum_cache_copy(const char *src, const char *dst, const char *digest) {\0A    FILE *in=fopen(src,\22rb\22); if (!in) return -1;\0A    FILE *out=fopen(dst,\22wb\22); if (!out) { fclose(in); return -1; }\0A    unsigned char buf[32768]; size_t n; int bad=0; char got[65];\0A    plum_cache_sha s; plum_cache_init(&s);\0A    while ((n=fread(buf,1,sizeof(buf),in)) != 0) {\0A        plum_cache_update(&s,buf,n);\0A        if (fwrite(buf,1,n,out) != n) { bad=1; break; }\0A    }\0A    if (ferror(in)) bad=1;\0A    if (fclose(in) != 0) bad=1;\0A    if (fclose(out) != 0) bad=1;\0A    plum_cache_final(&s,got);\0A    if (digest[0] && strcmp(got,digest) != 0) bad=1;\0A    if (bad) remove(dst);\0A    return bad ? -1 : 0;\0A}\0A\0A#if defined(_WIN32)\0A// Reserve the DIRECTORY atomically. GetTempFileName followed by deleting its\0A// file and making a directory releases the name between those operations;\0A// concurrent callers can then select the same supposedly unique name.\0Astatic void plum_win_temp_dir(const char *root, const char *prefix) {\0A    static volatile LONG serial=0;\0A    size_t len=strlen(root);\0A    const char *separator=len && (root[len-1]=='/' || root[len-1]=='\5C\5C') ? \22\22 : \22\5C\5C\22;\0A    for (unsigned attempt=0; attempt<128; attempt++) {\0A        unsigned long next=(unsigned long)(ULONG)InterlockedIncrement(&serial);\0A        int n=snprintf(plum_os_buf,sizeof(plum_os_buf),\22%s%s%s%lu-%llu-%lu\22,root,separator,prefix,\0A                       (unsigned long)GetCurrentProcessId(),(unsigned long long)GetTickCount64(),next);\0A        if (n<0 || n>=(int)sizeof(plum_os_buf)) break;\0A        if (CreateDirectoryA(plum_os_buf,NULL)) return;\0A        if (GetLastError()!=ERROR_ALREADY_EXISTS) break;\0A    }\0A    plum_os_buf[0]='\5C0';\0A}\0A#endif\0A\0Aconst char *plum_cache_temp(const char *root) {\0A#if defined(_WIN32)\0A    plum_win_temp_dir(root,\22.partial-\22);\0A#else\0A    if (snprintf(plum_os_buf,sizeof(plum_os_buf),\22%s/.partial-XXXXXX\22,root) >= (int)sizeof(plum_os_buf)\0A        || mkdtemp(plum_os_buf) == NULL) plum_os_buf[0]='\5C0';\0A#endif\0A    if (plum_os_buf[0]) {\0A        char owner[PLUM_PATH_MAX];\0A        if (snprintf(owner,sizeof(owner),\22%s/.owner\22,plum_os_buf) < (int)sizeof(owner)) {\0A            FILE *f=fopen(owner,\22w\22);\0A            if (f) {\0A#if defined(_WIN32)\0A                fprintf(f,\22%lu\22,(unsigned long)GetCurrentProcessId());\0A#else\0A                fprintf(f,\22%ld\22,(long)getpid());\0A#endif\0A                fclose(f);\0A            }\0A        }\0A    }\0A    return plum_os_buf;\0A}\0A\0A// Windows native-object adapter. Ask the OS loader which images it actually\0A// selects instead of approximating DLL search rules with SearchPath. Support\0A// the MSYS2 MINGW64 layout only; unknown layouts/modules/delay imports bypass.\0A#if defined(_WIN64)\0A#include <bcrypt.h>\0A\0A#define PLUM_WIN_MODULES 256\0A#ifndef PLUM_WIN_IMAGE_TRACE\0A#define PLUM_WIN_IMAGE_TRACE(path, digest) ((void)0)\0A#endif\0A\0Atypedef struct { wchar_t *path; char digest[65]; } plum_win_image;\0Atypedef struct {\0A    HMODULE dll;\0A    BCRYPT_ALG_HANDLE alg;\0A    NTSTATUS (WINAPI *open)(BCRYPT_ALG_HANDLE *,LPCWSTR,LPCWSTR,ULONG);\0A    NTSTATUS (WINAPI *create)(BCRYPT_ALG_HANDLE,BCRYPT_HASH_HANDLE *,PUCHAR,ULONG,PUCHAR,ULONG,ULONG);\0A    NTSTATUS (WINAPI *update)(BCRYPT_HASH_HANDLE,PUCHAR,ULONG,ULONG);\0A    NTSTATUS (WINAPI *finish)(BCRYPT_HASH_HANDLE,PUCHAR,ULONG,ULONG);\0A    NTSTATUS (WINAPI *destroy)(BCRYPT_HASH_HANDLE);\0A    NTSTATUS (WINAPI *close)(BCRYPT_ALG_HANDLE,ULONG);\0A} plum_win_sha;\0A\0Astatic void plum_win_sha_close(plum_win_sha *s) {\0A    if (s->alg) s->close(s-