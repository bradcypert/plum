= is_x1 ?\0A                         PSA_JPAKE_X1_STEP_KEY_SHARE :\0A                         PSA_JPAKE_X2_STEP_KEY_SHARE;\0A    } else if (stage->round == PSA_JPAKE_SECOND) {\0A        key_share_step = (stage->io_mode == PSA_JPAKE_OUTPUT) ?\0A                         PSA_JPAKE_X2S_STEP_KEY_SHARE :\0A                         PSA_JPAKE_X4S_STEP_KEY_SHARE;\0A    } else {\0A        return PSA_JPAKE_STEP_INVALID;\0A    }\0A    return (psa_crypto_driver_pake_step_t) (key_share_step + stage->step - PSA_PAKE_STEP_KEY_SHARE);\0A}\0A#endif /* PSA_WANT_ALG_JPAKE */\0A\0Astatic psa_status_t psa_pake_complete_inputs(\0A    psa_pake_operation_t *operation)\0A{\0A    psa_status_t status = PSA_ERROR_CORRUPTION_DETECTED;\0A    /* Create copy of the inputs on stack as inputs share memory\0A       with the driver context which will be setup by the driver. */\0A    psa_crypto_driver_pake_inputs_t inputs = operation->data.inputs;\0A\0A    if (inputs.password_len == 0) {\0A        return PSA_ERROR_BAD_STATE;\0A    }\0A\0A    if (operation->alg == PSA_ALG_JPAKE) {\0A        if (inputs.user_len == 0 || inputs.peer_len == 0) {\0A            return PSA_ERROR_BAD_STATE;\0A        }\0A    }\0A\0A    /* Clear driver context */\0A    mbedtls_platform_zeroize(&operation->data, sizeof(operation->data));\0A\0A    status = psa_driver_wrapper_pake_setup(operation, &inputs);\0A\0A    /* Driver is responsible for creating its own copy of the password. */\0A    mbedtls_zeroize_and_free(inputs.password, inputs.password_len);\0A\0A    /* User and peer are translated to role. */\0A    mbedtls_free(inputs.user);\0A    mbedtls_free(inputs.peer);\0A\0A    if (status == PSA_SUCCESS) {\0A#if defined(PSA_WANT_ALG_JPAKE)\0A        if (operation->alg == PSA_ALG_JPAKE) {\0A            operation->stage = PSA_PAKE_OPERATION_STAGE_COMPUTATION;\0A        } else\0A#endif /* PSA_WANT_ALG_JPAKE */\0A        {\0A            status = PSA_ERROR_NOT_SUPPORTED;\0A        }\0A    }\0A    return status;\0A}\0A\0A#if defined(PSA_WANT_ALG_JPAKE)\0Astatic psa_status_t psa_jpake_prologue(\0A    psa_pake_operation_t *operation,\0A    psa_pake_step_t step,\0A    psa_jpake_io_mode_t io_mode)\0A{\0A    if (step != PSA_PAKE_STEP_KEY_SHARE &&\0A        step != PSA_PAKE_STEP_ZK_PUBLIC &&\0A        step != PSA_PAKE_STEP_ZK_PROOF) {\0A        return PSA_ERROR_INVALID_ARGUMENT;\0A    }\0A\0A    psa_jpake_computation_stage_t *computation_stage =\0A        &operation->computation_stage.jpake;\0A\0A    if (computation_stage->round != PSA_JPAKE_FIRST &&\0A        computation_stage->round != PSA_JPAKE_SECOND) {\0A        return PSA_ERROR_BAD_STATE;\0A    }\0A\0A    /* Check that the step we are given is the one we were expecting */\0A    if (step != computation_stage->step) {\0A        return PSA_ERROR_BAD_STATE;\0A    }\0A\0A    if (step == PSA_PAKE_STEP_KEY_SHARE &&\0A        computation_stage->inputs == 0 &&\0A        computation_stage->outputs == 0) {\0A        /* Start of the round, so function decides whether we are inputting\0A         * or outputting */\0A        computation_stage->io_mode = io_mode;\0A    } else if (computation_stage->io_mode != io_mode) {\0A        /* Middle of the round so the mode we are in must match the function\0A         * called by the user */\0A        return PSA_ERROR_BAD_STATE;\0A    }\0A\0A    return PSA_SUCCESS;\0A}\0A\0Astatic psa_status_t psa_jpake_epilogue(\0A    psa_pake_operation_t *operation,\0A    psa_jpake_io_mode_t io_mode)\0A{\0A    psa_jpake_computation_stage_t *stage =\0A        &operation->computation_stage.jpake;\0A\0A    if (stage->step == PSA_PAKE_STEP_ZK_PROOF) {\0A        /* End of an input/output */\0A        if (io_mode == PSA_JPAKE_INPUT) {\0A            stage->inputs++;\0A            if (stage->inputs == PSA_JPAKE_EXPECTED_INPUTS(stage->round)) {\0A                stage->io_mode = PSA_JPAKE_OUTPUT;\0A            }\0A        }\0A        if (io_mode == PSA_JPAKE_OUTPUT) {\0A            stage->outputs++;\0A            if (stage->outputs == PSA_JPAKE_EXPECTED_OUTPUTS(stage->round)) {\0A                stage->io_mode = PSA_JPAKE_INPUT;\0A            }\0A        }\0A        if (stage->inputs == PSA_JPAKE_EXPECTED_INPUTS(stage->round) &&\0A            stage->outputs == PSA_JPAKE_EXPECTED_OUTPUTS(stage->round)) {\0A            /* End of a round, move to the next round */\0A            stage->inputs = 0;\0A            stage->outputs = 0;\0A            stage->round++;\0A        }\0A        stage->step = PSA_PAKE_STEP_KEY_SHARE;\0A    } else {\0A        stage->step++;\0A    }\0A    return PSA_SUCCESS;\0A}\0A\0A#endif /* PSA_WANT_ALG_JPAKE */\0A\0Apsa_status_t psa_pake_output(\0A    psa_pake_operation_t *operation,\0A    psa_pake_step_t step,\0A    uint8_t *output_external,\0A    size_t output_size,\0A    size_t *output_length)\0A{\0A    psa_status_t status = PSA_ERROR_CORRUPTION_DETECTED;\0A    psa_crypto_driver_pake_step_t driver_step = PSA_JPAKE_STEP_INVALID;\0A    LOCAL_OUTPUT_DECLARE(output_external, output);\0A    *output_length = 0;\0A\0A    if (operation->stage == PSA_PAKE_OPERATION_STAGE_COLLECT_INPUTS) {\0A        status = psa_pake_complete_inputs(operation);\0A        if (status != PSA_SUCCESS) {\0A            goto exit;\0A        }\0A    }\0A\0A    if (operation->stage != PSA_PAKE_OPERATION_STAGE_COMPUTATION) {\0A        status = PSA_ERROR_BAD_STATE;\0A        goto exit;\0A    }\0A\0A    if (output_size == 0) {\0A        status = PSA_ERROR_INVALID_ARGUMENT;\0A        goto exit;\0A    }\0A\0A    switch (operation->alg) {\0A#if defined(PSA_WANT_ALG_JPAKE)\0A        case PSA_ALG_JPAKE:\0A            status = psa_jpake_prologue(operation, step, PSA_JPAKE_OUTPUT);\0A            if (status != PSA_SUCCESS) {\0A                goto exit;\0A            }\0A            driver_step = convert_jpake_computation_stage_to_driver_step(\0A                &operation->computation_stage.jpake);\0A            break;\0A#endif /* PSA_WANT_ALG_JPAKE */\0A        default:\0A            (void) step;\0A            status = PSA_ERROR_NOT_SUPPORTED;\0A            goto exit;\0A    }\0A\0A    LOCAL_OUTPUT_ALLOC(output_external, output_size, output);\0A\0A    status = psa_driver_wrapper_pake_output(operation, driver_step,\0A                                            output, output_size, output_length);\0A\0A    if (status != PSA_SUCCESS) {\0A        goto exit;\0A    }\0A\0A    switch (operation->alg) {\0A#if defined(PSA_WANT_ALG_JPAKE)\0A        case PSA_ALG_JPAKE:\0A            status = psa_jpake_epilogue(operation, PSA_JPAKE_OUTPUT);\0A            if (status != PSA_SUCCESS) {\0A                goto exit;\0A            }\0A            break;\0A#endif /* PSA_WANT_ALG_JPAKE */\0A        default:\0A            status = PSA_ERROR_NOT_SUPPORTED;\0A            goto exit;\0A    }\0A\0Aexit:\0A    LOCAL_OUTPUT_FREE(output_external, output);\0A    if (status != PSA_SUCCESS) {\0A        psa_pake_abort(operation);\0A    }\0A    return status;\0A}\0A\0Apsa_status_t psa_pake_input(\0A    psa_pake_operation_t *operation,\0A    psa_pake_step_t step,\0A    const uint8_t *input_external,\0A    size_t input_length)\0A{\0A    psa_status_t status = PSA_ERROR_CORRUPTION_DETECTED;\0A    psa_crypto_driver_pake_step_t driver_step = PSA_JPAKE_STEP_INVALID;\0A    const size_t max_input_length = (size_t) PSA_PAKE_INPUT_SIZE(operation->alg,\0A                                                                 operation->primitive,\0A                                                                 step);\0A    LOCAL_INPUT_DECLARE(input_external, input);\0A\0A    if (operation->stage == PSA_PAKE_OPERATION_STAGE_COLLECT_INPUTS) {\0A        status = psa_pake_complete_inputs(operation);\0A        if (status != PSA_SUCCESS) {\0A            goto exit;\0A        }\0A    }\0A\0A    if (operation->stage != PSA_PAKE_OPERATION_STAGE_COMPUTATION) {\0A        status =  PSA_ERROR_BAD_STATE;\0A        goto exit;\0A    }\0A\0A    if (input_length == 0 || input_length > max_input_length) {\0A        status = PSA_ERROR_INVALID_ARGUMENT;\0A        goto exit;\0A    }\0A\0A    switch (operation->alg) {\0A#if defined(PSA_WANT_ALG_JPAKE)\0A        case PSA_ALG_JPAKE:\0A            status = psa_jpake_prologue(operation, step, PSA_JPAKE_INPUT);\0A            if (status != PSA_SUCCESS) {\0A                goto exit;\0A            }\0A            driver_step = convert_jpake_computation_stage_to_driver_step(\0A                &operation->computation_stage.jpake);\0A            break;\0A#endif /* PSA_WANT_ALG_JPAKE */\0A        default:\0A            (void) step;\0A            status = PSA_ERROR_NOT_SUPPORTED;\0A            goto exit;\0A    }\0A\0A    LOCAL_INPUT_ALLOC(input_external, input_length, input);\0A    status = psa_driver_wrapper_pake_input(operation, driver_step,\0A                                           input, input_length);\0A\0A    if (status != PSA_SUCCESS) {\0A        goto exit;\0A    }\0A\0A    switch (operation->alg) {\0A#if defined(PSA_WANT_ALG_JPAKE)\0A        case PSA_ALG_JPAKE:\0A            status = psa_jpake_epilogue(operation, PSA_JPAKE_INPUT);\0A            if (status != PSA_SUCCESS) {\0A                goto exit;\0A            }\0A            break;\0A#endif /* PSA_WANT_ALG_JPAKE */\0A        default:\0A            status = PSA_ERROR_NOT_SUPPORTED;\0A            goto exit;\0A    }\0A\0Aexit:\0A    LOCAL_INPUT_FREE(input_external, input);\0A    if (status != PSA_SUCCESS) {\0A        psa_pake_abort(operation);\0A    }\0A    return status;\0A}\0A\0Apsa_status_t psa_pake_get_implicit_key(\0A    psa_pake_operation_t *operation,\0A    psa_key_derivation_operation_t *output)\0A{\0A    psa_status_t status = PSA_ERROR_CORRUPTION_DETECTED;\0A    psa_status_t abort_status = PSA_ERROR_CORRUPTION_DETECTED;\0A    uint8_t shared_key[MBEDTLS_PSA_JPAKE_BUFFER_SIZE];\0A    size_t shared_key_len = 0;\0A\0A    if (operation->stage != PSA_PAKE_OPERATION_STAGE_COMPUTATION) {\0A        status = PSA_ERROR_BAD_STATE;\0A        goto exit;\0A    }\0A\0A#if defined(PSA_WANT_ALG_JPAKE)\0A    if (operation->alg == PSA_