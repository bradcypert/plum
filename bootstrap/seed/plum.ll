@.str44714 = private global { i64, i64, [28026 x i8] } { i64 -1, i64 28025, [28026 x i8] c"/**\0A * \5Cfile aes.h\0A *\0A * \5Cbrief   This file contains AES definitions and functions.\0A *\0A *          The Advanced Encryption Standard (AES) specifies a FIPS-approved\0A *          cryptographic algorithm that can be used to protect electronic\0A *          data.\0A *\0A *          The AES algorithm is a symmetric block cipher that can\0A *          encrypt and decrypt information. For more information, see\0A *          <em>FIPS Publication 197: Advanced Encryption Standard</em> and\0A *          <em>ISO/IEC 18033-2:2006: Information technology -- Security\0A *          techniques -- Encryption algorithms -- Part 2: Asymmetric\0A *          ciphers</em>.\0A *\0A *          The AES-XTS block mode is standardized by NIST SP 800-38E\0A *          <https://nvlpubs.nist.gov/nistpubs/legacy/sp/nistspecialpublication800-38e.pdf>\0A *          and described in detail by IEEE P1619\0A *          <https://ieeexplore.ieee.org/servlet/opac?punumber=4375278>.\0A */\0A\0A/*\0A *  Copyright The Mbed TLS Contributors\0A *  SPDX-License-Identifier: Apache-2.0 OR GPL-2.0-or-later\0A */\0A\0A#ifndef MBEDTLS_AES_H\0A#define MBEDTLS_AES_H\0A#include \22mbedtls/private_access.h\22\0A\0A#include \22mbedtls/build_info.h\22\0A#include \22mbedtls/platform_util.h\22\0A\0A#include <stddef.h>\0A#include <stdint.h>\0A\0A/* padlock.c and aesni.c rely on these values! */\0A#define MBEDTLS_AES_ENCRYPT     1 /**< AES encryption. */\0A#define MBEDTLS_AES_DECRYPT     0 /**< AES decryption. */\0A\0A/* Error codes in range 0x0020-0x0022 */\0A/** Invalid key length. */\0A#define MBEDTLS_ERR_AES_INVALID_KEY_LENGTH                -0x0020\0A/** Invalid data input length. */\0A#define MBEDTLS_ERR_AES_INVALID_INPUT_LENGTH              -0x0022\0A\0A/* Error codes in range 0x0021-0x0025 */\0A/** Invalid input data. */\0A#define MBEDTLS_ERR_AES_BAD_INPUT_DATA                    -0x0021\0A\0A#ifdef __cplusplus\0Aextern \22C\22 {\0A#endif\0A\0A#if !defined(MBEDTLS_AES_ALT)\0A// Regular implementation\0A//\0A\0A/**\0A * \5Cbrief The AES context-type definition.\0A */\0Atypedef struct mbedtls_aes_context {\0A    int MBEDTLS_PRIVATE(nr);                     /*!< The number of rounds. */\0A    size_t MBEDTLS_PRIVATE(rk_offset);           /*!< The offset in array elements to AES\0A                                                    round keys in the buffer. */\0A#if defined(MBEDTLS_AES_ONLY_128_BIT_KEY_LENGTH) && !defined(MBEDTLS_PADLOCK_C)\0A    uint32_t MBEDTLS_PRIVATE(buf)[44];           /*!< Aligned data buffer to hold\0A                                                    10 round keys for 128-bit case. */\0A#else\0A    uint32_t MBEDTLS_PRIVATE(buf)[68];           /*!< Unaligned data buffer. This buffer can\0A                                                    hold 32 extra Bytes, which can be used for\0A                                                    one of the following purposes:\0A                                                    <ul><li>Alignment if VIA padlock is\0A                                                    used.</li>\0A                                                    <li>Simplifying key expansion in the 256-bit\0A                                                    case by generating an extra round key.\0A                                                    </li></ul> */\0A#endif /* MBEDTLS_AES_ONLY_128_BIT_KEY_LENGTH && !MBEDTLS_PADLOCK_C */\0A}\0Ambedtls_aes_context;\0A\0A#if defined(MBEDTLS_CIPHER_MODE_XTS)\0A/**\0A * \5Cbrief The AES XTS context-type definition.\0A */\0Atypedef struct mbedtls_aes_xts_context {\0A    mbedtls_aes_context MBEDTLS_PRIVATE(crypt); /*!< The AES context to use for AES block\0A                                                   encryption or decryption. */\0A    mbedtls_aes_context MBEDTLS_PRIVATE(tweak); /*!< The AES context used for tweak\0A                                                   computation. */\0A} mbedtls_aes_xts_context;\0A#endif /* MBEDTLS_CIPHER_MODE_XTS */\0A\0A#else  /* MBEDTLS_AES_ALT */\0A#include \22aes_alt.h\22\0A#endif /* MBEDTLS_AES_ALT */\0A\0A/**\0A * \5Cbrief          This function initializes the specified AES context.\0A *\0A *                 It must be the first API called before using\0A *                 the context.\0A *\0A * \5Cparam ctx      The AES context to initialize. This must not be \5Cc NULL.\0A */\0Avoid mbedtls_aes_init(mbedtls_aes_context *ctx);\0A\0A/**\0A * \5Cbrief          This function releases and clears the specified AES context.\0A *\0A * \5Cparam ctx      The AES context to clear.\0A *                 If this is \5Cc NULL, this function does nothing.\0A *                 Otherwise, the context must have been at least initialized.\0A */\0Avoid mbedtls_aes_free(mbedtls_aes_context *ctx);\0A\0A#if defined(MBEDTLS_CIPHER_MODE_XTS)\0A/**\0A * \5Cbrief          This function initializes the specified AES XTS context.\0A *\0A *                 It must be the first API called before using\0A *                 the context.\0A *\0A * \5Cparam ctx      The AES XTS context to initialize. This must not be \5Cc NULL.\0A */\0Avoid mbedtls_aes_xts_init(mbedtls_aes_xts_context *ctx);\0A\0A/**\0A * \5Cbrief          This function releases and clears the specified AES XTS context.\0A *\0A * \5Cparam ctx      The AES XTS context to clear.\0A *                 If this is \5Cc NULL, this function does nothing.\0A *                 Otherwise, the context must have been at least initialized.\0A */\0Avoid mbedtls_aes_xts_free(mbedtls_aes_xts_context *ctx);\0A#endif /* MBEDTLS_CIPHER_MODE_XTS */\0A\0A/**\0A * \5Cbrief          This function sets the encryption key.\0A *\0A * \5Cparam ctx      The AES context to which the key should be bound.\0A *                 It must be initialized.\0A * \5Cparam key      The encryption key.\0A *                 This must be a readable buffer of size \5Cp keybits bits.\0A * \5Cparam keybits  The size of data passed in bits. Valid options are:\0A *                 <ul><li>128 bits</li>\0A *                 <li>192 bits</li>\0A *                 <li>256 bits</li></ul>\0A *\0A * \5Creturn         \5Cc 0 on success.\0A * \5Creturn         #MBEDTLS_ERR_AES_INVALID_KEY_LENGTH on failure.\0A */\0AMBEDTLS_CHECK_RETURN_TYPICAL\0Aint mbedtls_aes_setkey_enc(mbedtls_aes_context *ctx, const unsigned char *key,\0A                           unsigned int keybits);\0A\0A#if !defined(MBEDTLS_BLOCK_CIPHER_NO_DECRYPT)\0A/**\0A * \5Cbrief          This function sets the decryption key.\0A *\0A * \5Cparam ctx      The AES context to which the key should be bound.\0A *                 It must be initialized.\0A * \5Cparam key      The decryption key.\0A *                 This must be a readable buffer of size \5Cp keybits bits.\0A * \5Cparam keybits  The size of data passed. Valid options are:\0A *                 <ul><li>128 bits</li>\0A *                 <li>192 bits</li>\0A *                 <li>256 bits</li></ul>\0A *\0A * \5Creturn         \5Cc 0 on success.\0A * \5Creturn         #MBEDTLS_ERR_AES_INVALID_KEY_LENGTH on failure.\0A */\0AMBEDTLS_CHECK_RETURN_TYPICAL\0Aint mbedtls_aes_setkey_dec(mbedtls_aes_context *ctx, const unsigned char *key,\0A                           unsigned int keybits);\0A#endif /* !MBEDTLS_BLOCK_CIPHER_NO_DECRYPT */\0A\0A#if defined(MBEDTLS_CIPHER_MODE_XTS)\0A/**\0A * \5Cbrief          This function prepares an XTS context for encryption and\0A *                 sets the encryption key.\0A *\0A * \5Cparam ctx      The AES XTS context to which the key should be bound.\0A *                 It must be initialized.\0A * \5Cparam key      The encryption key. This is comprised of the XTS key1\0A *                 concatenated with the XTS key2.\0A *                 This must be a readable buffer of size \5Cp keybits bits.\0A * \5Cparam keybits  The size of \5Cp key passed in bits. Valid options are:\0A *                 <ul><li>256 bits (each of key1 and key2 is a 128-bit key)</li>\0A *                 <li>512 bits (each of key1 and key2 is a 256-bit key)</li></ul>\0A *\0A * \5Creturn         \5Cc 0 on success.\0A * \5Creturn         #MBEDTLS_ERR_AES_INVALID_KEY_LENGTH on failure.\0A */\0AMBEDTLS_CHECK_RETURN_TYPICAL\0Aint mbedtls_aes_xts_setkey_enc(mbedtls_aes_xts_context *ctx,\0A                               const unsigned char *key,\0A                               unsigned int keybits);\0A\0A/**\0A * \5Cbrief          This function prepares an XTS context for decryption and\0A *                 sets the decryption key.\0A *\0A * \5Cparam ctx      The AES XTS context to which the key should be bound.\0A *                 It must be initialized.\0A * \5Cparam key      The decryption key. This is comprised of the XTS key1\0A *                 concatenated with the XTS key2.\0A *                 This must be a readable buffer of size \5Cp keybits bits.\0A * \5Cparam keybits  The size of \5Cp key passed in bits. Valid options are:\0A *                 <ul><li>256 bits (each of key1 and key2 is a 128-bit key)</li>\0A *                 <li>512 bits (each of key1 and key2 is a 256-bit key)</li></ul>\0A *\0A * \5Creturn         \5Cc 0 on success.\0A * \5Creturn         #MBEDTLS_ERR_AES_INVALID_KEY_LENGTH on failure.\0A */\0AMBEDTLS_CHECK_RETURN_TYPICAL\0Aint mbedtls_aes_xts_setkey_dec(mbedtls_aes_xts_context *ctx,\0A                               const unsigned char *key,\0A                               unsigned int keybits);\0A#endif /* MBEDTLS_CIPHER_MODE_XTS */\0A\0A/**\0A * \5Cbrief          This function performs an AES single-block encryption or\0A *                 decryption operation.\0A *\0A *                 It performs the operation defined in the \5Cp mode parameter\0A *                 (encrypt or decrypt), on the input data buffer defined in\0A *                 the \5Cp input parameter.\0A *\0A *                 mbedtls_aes_init(), and either mbedtls_aes_setkey_enc() or\0A *                 mbedtls_aes_setkey_dec() must be ca