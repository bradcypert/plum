return 0;\0A        for (; *value && *value != '\22'; value++) {\0A            unsigned char c=(unsigned char)*value;\0A            if (!((c>='a' && c<='z') || (c>='A' && c<='Z')\0A                || (c>='0' && c<='9') || c=='_' || c=='.' || c=='$')) return 0;\0A        }\0A        if (*value != '\22') return 0;\0A    }\0A    return 1;\0A}\0A\0A// Generated LLVM contains quoted IR strings and identifiers, and comments.\0A// Only a bare `asm` token can introduce assembly. Do not mistake embedded\0A// C source or an application's string data for an LLVM assembly operand.\0Astatic int plum_cache_ir_word(unsigned char c) {\0A    return (c>='a' && c<='z') || (c>='A' && c<='Z') || (c>='0' && c<='9')\0A        || c=='_' || c=='.' || c=='$' || c=='-' || c=='@' || c=='%' || c=='!';\0A}\0Along long plum_cache_safe_ir(const char *ir) {\0A    const char *p=ir;\0A    while (*p) {\0A        if (*p == ';') { while (*p && *p!='\5Cn') p++; }\0A        else if (*p == '\22') {\0A            p++;\0A            while (*p && *p!='\22') {\0A                if (*p=='\5C\5C') { p++; if (!*p) return 0; }\0A                p++;\0A            }\0A            if (!*p) return 0;\0A            p++;\0A        } else if (plum_cache_ir_word((unsigned char)*p)) {\0A            const char *start=p;\0A            while (plum_cache_ir_word((unsigned char)*p)) p++;\0A            if (p-start == 3 && !memcmp(start,\22asm\22,3)) return 0;\0A        } else { p++; }\0A    }\0A    return 1;\0A}\0A\0A// Creates a fresh, empty, private directory and returns its path.\0A// Returns \22\22 -- an empty, non-null CStr -- on failure, because a null\0A// CStr return is a hard runtime abort under Plum's FFI semantics (see\0A// `net_shim.c`'s `tcp_recv` note, the same trade for the same reason).\0Aconst char *os_temp_dir(void) {\0A#if defined(_WIN32)\0A    char base[PLUM_PATH_MAX];\0A    DWORD n = GetTempPathA((DWORD)sizeof(base), base);\0A    if (n == 0 || n >= sizeof(base)) { plum_os_buf[0] = '\5C0'; return plum_os_buf; }\0A    // `GetTempFileNameA` creates a FILE; the directory of the same name\0A    // is what is wanted, so the file is removed and a directory put in\0A    // its place. The name is still unique -- that is what the call\0A    // bought -- and the window between the two is not a security\0A    // boundary this compiler relies on.\0A    if (GetTempFileNameA(base, \22plum\22, 0, plum_os_buf) == 0) { plum_os_buf[0] = '\5C0'; return plum_os_buf; }\0A    DeleteFileA(plum_os_buf);\0A    if (PLUM_MKDIR(plum_os_buf) != 0) { plum_os_buf[0] = '\5C0'; }\0A    return plum_os_buf;\0A#else\0A    const char *tmp = getenv(\22TMPDIR\22);\0A    if (tmp == NULL || tmp[0] == '\5C0') tmp = \22/tmp\22;\0A    if (snprintf(plum_os_buf, sizeof(plum_os_buf), \22%s/plum-XXXXXX\22, tmp) >= (int)sizeof(plum_os_buf)) {\0A        plum_os_buf[0] = '\5C0';\0A        return plum_os_buf;\0A    }\0A    if (mkdtemp(plum_os_buf) == NULL) plum_os_buf[0] = '\5C0';\0A    return plum_os_buf;\0A#endif\0A}\0A\0A// The path of the running executable. Three genuinely different calls\0A// for one question; there is no portable spelling.\0Aconst char *os_self_exe(void) {\0A    plum_os_buf[0] = '\5C0';\0A#if defined(_WIN32)\0A    DWORD n = GetModuleFileNameA(NULL, plum_os_buf, (DWORD)sizeof(plum_os_buf));\0A    if (n == 0 || n >= sizeof(plum_os_buf)) plum_os_buf[0] = '\5C0';\0A#elif defined(__APPLE__)\0A    uint32_t n = (uint32_t)sizeof(plum_os_buf);\0A    if (_NSGetExecutablePath(plum_os_buf, &n) != 0) plum_os_buf[0] = '\5C0';\0A#else\0A    ssize_t n = readlink(\22/proc/self/exe\22, plum_os_buf, sizeof(plum_os_buf) - 1);\0A    if (n < 0) { plum_os_buf[0] = '\5C0'; } else { plum_os_buf[n] = '\5C0'; }\0A#endif\0A    return plum_os_buf;\0A}\0A\0A// 0 on success, -1 on failure, matching the other shims' Int-sentinel\0A// convention rather than C's.\0Along long os_make_dir(const char *path) {\0A    return PLUM_MKDIR(path) == 0 ? 0 : -1;\0A}\0A\0Along long os_remove_file(const char *path) {\0A    return remove(path) == 0 ? 0 : -1;\0A}\0A\0A// `rename`, which is ATOMIC within a filesystem: the destination is\0A// either the old file or the new one, never a half-written mixture.\0A// That is the whole reason this exists -- `plum fmt --write` builds the\0A// formatted text beside the original and renames it into place, so an\0A// interrupted run cannot leave somebody's source truncated.\0A//\0A// Across filesystems `rename` fails rather than copying, and the\0A// caller is told so rather than being silently given a slower,\0A// non-atomic fallback it did not ask for.\0Along long os_rename_file(const char *from, const char *to) {\0A    return rename(from, to) == 0 ? 0 : -1;\0A}\0A\0Astatic int plum_is_dir(const char *path) {\0A    struct stat st;\0A    if (stat(path, &st) != 0) return 0;\0A    return S_ISDIR(st.st_mode) ? 1 : 0;\0A}\0A\0Astatic int plum_join(char *out, size_t cap, const char *a, const char *b) {\0A    int n = snprintf(out, cap, \22%s/%s\22, a, b);\0A    return (n > 0 && (size_t)n < cap) ? 0 : -1;\0A}\0A\0A// Deletes a directory and everything under it. Recurses with a\0A// heap-allocated path buffer per level rather than a shared one,\0A// because the caller's path must stay intact across the child call.\0A//\0A// Symlinks are removed, never followed: `plum_is_dir` uses `stat`,\0A// which follows, so a symlink to a directory would recurse into the\0A// TARGET and delete someone else's files. `lstat` is used here for\0A// exactly that reason. On Windows there is no `lstat`; the reparse\0A// point is deleted by `remove` as an ordinary entry.\0Astatic int plum_remove_tree(const char *path) {\0A    DIR *d;\0A    struct dirent *e;\0A    char *child;\0A    int rc = 0;\0A\0A#if !defined(_WIN32)\0A    struct stat st;\0A    if (lstat(path, &st) != 0) return -1;\0A    if (!S_ISDIR(st.st_mode)) return remove(path) == 0 ? 0 : -1;\0A#else\0A    DWORD attrs=GetFileAttributesA(path);\0A    if (attrs == INVALID_FILE_ATTRIBUTES) return -1;\0A    if (attrs & FILE_ATTRIBUTE_REPARSE_POINT) {\0A        if (attrs & FILE_ATTRIBUTE_DIRECTORY) return RemoveDirectoryA(path) ? 0 : -1;\0A        return remove(path) == 0 ? 0 : -1;\0A    }\0A    if (!plum_is_dir(path)) return remove(path) == 0 ? 0 : -1;\0A#endif\0A\0A    d = opendir(path);\0A    if (d == NULL) return -1;\0A    child = (char *)malloc(PLUM_PATH_MAX);\0A    if (child == NULL) { closedir(d); return -1; }\0A\0A    while ((e = readdir(d)) != NULL) {\0A        if (strcmp(e->d_name, \22.\22) == 0 || strcmp(e->d_name, \22..\22) == 0) continue;\0A        if (plum_join(child, PLUM_PATH_MAX, path, e->d_name) != 0) { rc = -1; continue; }\0A        if (plum_remove_tree(child) != 0) rc = -1;\0A    }\0A    free(child);\0A    closedir(d);\0A    if (PLUM_RMDIR(path) != 0) rc = -1;\0A    return rc;\0A}\0A\0Along long os_remove_tree(const char *path) {\0A    return plum_remove_tree(path) == 0 ? 0 : -1;\0A}\0A\0Astatic int plum_copy_file(const char *src, const char *dst) {\0A    FILE *in, *out;\0A    char buf[65536];\0A    size_t n;\0A    int rc = 0;\0A\0A    in = fopen(src, \22rb\22);\0A    if (in == NULL) return -1;\0A    out = fopen(dst, \22wb\22);\0A    if (out == NULL) { fclose(in); return -1; }\0A    while ((n = fread(buf, 1, sizeof(buf), in)) > 0) {\0A        if (fwrite(buf, 1, n, out) != n) { rc = -1; break; }\0A    }\0A    if (ferror(in)) rc = -1;\0A    if (fclose(out) != 0) rc = -1;\0A    fclose(in);\0A    return rc;\0A}\0A\0A// Resolve an existing directory to its filesystem path. Resolving the\0A// directory itself (rather than only normalising its spelling) catches\0A// aliases such as `.` and symlinks before a copy can write through them.\0Astatic int plum_resolve_dir(const char *path, char *out, size_t cap) {\0A#if defined(_WIN32)\0A    HANDLE h = CreateFileA(path, FILE_READ_ATTRIBUTES,\0A                           FILE_SHARE_READ | FILE_SHARE_WRITE | FILE_SHARE_DELETE,\0A                           NULL, OPEN_EXISTING, FILE_FLAG_BACKUP_SEMANTICS, NULL);\0A    DWORD n;\0A    if (h == INVALID_HANDLE_VALUE) return -1;\0A    n = GetFinalPathNameByHandleA(h, out, (DWORD)cap, FILE_NAME_NORMALIZED | VOLUME_NAME_DOS);\0A    CloseHandle(h);\0A    if (n == 0 || n >= cap) return -1;\0A    for (char *p = out; *p; p++) {\0A        if (*p == '\5C\5C') *p = '/';\0A        *p = (char)tolower((unsigned char)*p);\0A    }\0A    return 0;\0A#else\0A    return realpath(path, out) != NULL ? 0 : -1;\0A#endif\0A}\0A\0A// Directories overlap when either is the other or an ancestor of it.\0A// The separators at the prefix boundary avoid confusing `/a/bc` with `/a/b`.\0Astatic int plum_paths_overlap(const char *a, const char *b) {\0A    char resolved_a[PLUM_PATH_MAX];\0A    char resolved_b[PLUM_PATH_MAX];\0A    size_t a_len, b_len;\0A    if (plum_resolve_dir(a, resolved_a, sizeof(resolved_a)) != 0 ||\0A        plum_resolve_dir(b, resolved_b, sizeof(resolved_b)) != 0) return -1;\0A    a_len = strlen(resolved_a);\0A    b_len = strlen(resolved_b);\0A#if defined(_WIN32)\0A    int same = _stricmp(resolved_a, resolved_b) == 0;\0A    int a_prefix = _strnicmp(resolved_a, resolved_b, a_len) == 0 &&\0A                   (resolved_b[a_len] == '\5C0' || resolved_a[a_len - 1] == '/' || resolved_b[a_len] == '/');\0A    int b_prefix = _strnicmp(resolved_b, resolved_a, b_len) == 0 &&\0A                   (resolved_a[b_len] == '\5C0' || resolved_b[b_len - 1] == '/' || resolved_a[b_len] == '/');\0A#else\0A    int same = strcmp(resolved_a, resolved_b) == 0;\0A    int a_prefix = strncmp(resolved_a, resolved_b, a_len) == 0 &&\0A                   (resolved_b[a_len] == '\5C0' || resolved_a[a_len - 1] == '/' || resolved_b[a_len] == '/');\0A    int b_prefix = strncmp(resolved_b, resolved_a, b_len) == 0 &&\0A                   (resolved_a[b_len] == '\5C0' || resolved_b[b_len - 1] == '/' || resolved_a[b_len] == '/');\0A#endif\0A    return same || a_prefix || b_prefix;\0A}\0A\0A// Copies the CONTENTS of `src` into `dst`, which must already exist --\0A// the semantics of `cp -r src/. dst`, which is what this replaced, and\0A// deliberately not `cp -r src dst` (that would nest a directory).\0A//\0A// File MODES are not preserved. The one caller copies a project into a\0A// scratch directory to type-check it, where nothing is executed; if a\0A// caller ever needs the executable bit, this is the line to revisit\0A// rather than a thing to assume.\0Astatic int plum_copy_tree(const char *src, const char *dst) {\0A    DIR *d;\0A    struct dirent *e;\0A    char *s;\0A    char *t;\0A    int rc = 0;\0A\0A    // Refuse self-copy and either direction of overlap before reading or\0A    // creating any destination entry. Otherwise recursion can be unbounded,\0A    // and a file copied onto itself is truncated by fopen(\22wb\22).\0A    if (plum_paths_overlap(src, dst) != 0) return -1;\0A\0A    d = opendir(src);\0A    if (d == NULL) return -1;\0A    s = (char *)malloc(PLUM_PATH_MAX);\0A    t = (char *)malloc(PLUM_PATH_MAX);\0A    if (s == NULL || t == NULL) { free(s); free(t); closedir(d); return -1; }\0A\0A    while ((e = readdir(d)) != NULL) {\0A        if (strcmp(e->d_name, \22.\22) == 0 || strcmp(e->d_name, \22..\22) == 0) continue;\0A        if (plum_join(s, PLUM_PATH_MAX, src, e->d_name) != 0) { rc = -1; continue; }\0A        if (plum_join(t, PLUM_PATH_MAX, dst, e->d_name) != 0) { rc = -1; continue; }\0A        if (plum_is_dir(s)) {\0A            if (PLUM_MKDIR(t) != 0 && !plum_is_dir(t)) { rc = -1; continue; }\0A            if (plum_copy_tree(s, t) != 0) rc = -1;\0A        } else {\0A            if (plum_copy_file(s, t) != 0) rc = -1;\0A        }\0A    }\0A    free(s);\0A    free(t);\0A    closedir(d);\0A    return rc;\0A}\0A\0Along long os_copy_tree(const char *src, const char *dst) {\0A    return plum_copy_tree(src, dst) == 0 ? 0 : -1;\0A}\0A\0A// --- File metadata (issue #24) ---\0A//\0A// `stat(2)`, the rest of it. `path_is_dir` in `dir_shim.c` was the first\0A// caller and stays where it is; these are its siblings, here because\0A// this is the filesystem shim.\0A//\0A// Loaded into a thread-local record and then read field by field, so\0A// `Os.stat` costs ONE `stat` rather than one per field. Plum's extern\0A// surface has no multi-value return, which is the same constraint\0A// `tcp_recv_n`/`tcp_recv_data` and `file_read_n`/`file_read_data` work\0A// around the same way.\0A//\0A// Thread-local rather than plain static: `net_shim.c` learned what a\0A// shared buffer costs when two threads use it at once, and a per-thread\0A// record is cheap enough not to repeat that.\0A#include <errno.h>\0A#include <time.h>\0A\0A#if defined(_MSC_VER)\0A#define PLUM_OS_TLS __declspec(thread)\0A#else\0A#define PLUM_OS_TLS _Thread_local\0A#endif\0A\0Astatic PLUM_OS_TLS long long stat_size = 0;\0Astatic PLUM_OS_TLS long long stat_mtime = 0;\0Astatic PLUM_OS_TLS long long stat_is_dir = 0;\0A\0A// 0 on success, -1 if the path cannot be stat'ed at all (most commonly\0A// because it is not there). Follows symlinks, matching `path_is_dir`.\0Along long os_stat_load(const char *path) {\0A    struct stat st;\0A    if (stat(path, &st) != 0) {\0A        stat_size = 0;\0A        stat_mtime = 0;\0A        stat_is_dir = 0;\0A        return -1;\0A    }\0A    stat_size = (long long)st.st_size;\0A    stat_mtime = (long long)st.st_mtime;\0A    stat_is_dir = S_ISDIR(st.st_mode) ? 1 : 0;\0A    return 0;\0A}\0A\0Along long os_stat_size(void) { return stat_size; }\0Along long os_stat_mtime(void) { return stat_mtime; }\0Along long os_stat_is_dir(void) { return stat_is_dir; }\0A\0A// Retention is best effort and runs after compilation. Only complete hash\0A// entries are eviction candidates; staging is protected by its live owner.\0A// Cache roots must be private to this host/user (not a shared network store).\0Atypedef struct { char *path; uint64_t bytes; time_t age; } plum_cache_entry;\0A\0Astatic int plum_cache_stat_private(const char *path, struct stat *st) {\0A#if defined(_WIN32)\0A    DWORD attrs=GetFileAttributesA(path);\0A    if (attrs == INVALID_FILE_ATTRIBUTES || (attrs & FILE_ATTRIBUTE_REPARSE_POINT)) return -1;\0A    return stat(path,st);\0A#else\0A    return lstat(path,st);\0A#endif\0A}\0A\0Astatic uint64_t plum_cache_tree_bytes(const char *path) {\0A    struct stat st;\0A    if (plum_cache_stat_private(path,&st) != 0) return 0;\0A    if (S_ISREG(st.st_mode)) return st.st_size > 0 ? (uint64_t)st.st_size : 0;\0A    if (!S_ISDIR(st.st_mode)) return 0;\0A    DIR *d=opendir(path); if (!d) return 0;\0A    uint64_t bytes=0; struct dirent *e; char child[PLUM_PATH_MAX];\0A    while ((e=readdir(d)) != NULL) {\0A        if (!strcmp(e->d_name,\22.\22) || !strcmp(e->d_name,\22..\22)) continue;\0A        if (plum_join(child,sizeof(child),path,e->d_name) == 0) bytes+=plum_cache_tree_bytes(child);\0A    }\0A    closedir(d); return bytes;\0A}\0A\0Astatic int plum_cache_owner_gone(const char *path) {\0A    char owner[PLUM_PATH_MAX]; long pid=0;\0A    if (plum_join(owner,sizeof(owner),path,\22.owner\22) != 0) return 0;\0A    FILE *f=fopen(owner,\22r\22); if (!f) return 0;\0A    int parsed=fscanf(f,\22%ld\22,&pid); fclose(f);\0A    if (parsed != 1 || pid <= 0 || pid > 2147483647L) return 0;\0A#if defined(_WIN32)\0A    HANDLE process=OpenProcess(PROCESS_QUERY_LIMITED_INFORMATION,FALSE,(DWORD)pid);\0A    if (!process) return GetLastError() == ERROR_INVALID_PARAMETER;\0A    DWORD code=STILL_ACTIVE;\0A    int gone=GetExitCodeProcess(process,&code) && code != STILL_ACTIVE;\0A    CloseHandle(process); return gone;\0A#else\0A    return kill((pid_t)pid,0) != 0 && errno == ESRCH;\0A#endif\0A}\0A\0Astatic int plum_cache_oldest(const void *a, const void *b) {\0A    const plum_cache_entry *x=a, *y=b;\0A    if (x->age != y->age) return x->age < y->age ? -1 : 1;\0A    return strcmp(x->path,y->path);\0A}\0A\0Along long plum_cache_prune(const char *root, long long limit) {\0A    if (limit < 0) return 0;\0A    const char *kinds[]={\22ir\22,\22obj\22,\22shims\22};\0A    plum_cache_entry *entries=NULL; size_t count=0, capacity=0;\0A    uint64_t total=0; long long removed=0; time_t now=time(NULL);\0A    char parent[PLUM_PATH_MAX], path[PLUM_PATH_MAX]; struct stat st;\0A    for (size_t k=0;k<3;k++) {\0A        if (plum_join(parent,sizeof(parent),root,kinds[k]) != 0\0A            || plum_cache_stat_private(parent,&st) != 0 || !S_ISDIR(st.st_mode)) continue;\0A        DIR *d=opendir(parent); if (!d) continue;\0A        struct dirent *e;\0A        while ((e=readdir(d)) != NULL) {\0A            if (plum_join(path,sizeof(path),parent,e->d_name) != 0\0A                || plum_cache_stat_private(path,&st) != 0 || !S_ISDIR(st.st_mode)) continue;\0A            // Windows GetTempFileName uses pcb*.tmp; POSIX uses .partial-*.\0A            if (!strncmp(e->d_name,\22.partial-\22,9) || !strncmp(e->d_name,\22pcb\22,3)) {\0A                if (now > st.st_mtime && now-st.st_mtime > 86400 && plum_cache_owner_gone(path)) {\0A                    if (plum_remove_tree(path) == 0) removed++;\0A                }\0A                continue;\0A            }\0A            if (strlen(e->d_name) != 64) continue;\0A            int hex=1;\0A            for (size_t i=0;i<64;i++) {\0A                if (!((e->d_name[i]>='0' && e->d_name[i]<='9')\0A                    || (e->d_name[i]>='a' && e->d_name[i]<='f'))) { hex=0; break; }\0A            }\0A            if (!hex) continue;\0A            if (count == capacity) {\0A                size_t next=capacity ? capacity*2 : 32;\0A                plum_cache_entry *grown=realloc(entries,next*sizeof(*entries));\0A                if (!grown) break;\0A                entries=grown; capacity=next;\0A            }\0A            char *saved=strdup(path); if (!saved) break;\0A            uint64_t bytes=plum_cache_tree_bytes(path);\0A            entries[count++]=(plum_cache_entry){saved,bytes,st.st_mtime}; total+=bytes;\0A        }\0A        closedir(d);\0A    }\0A    if (count > 1) qsort(entries,count,sizeof(*entries),plum_cache_oldest);\0A    for (size_t i=0;i<count;i++) {\0A        if (total > (uint64_t)limit && plum_remove_tree(entries[i].path) == 0) {\0A            total=total >= entries[i].bytes ? total-entries[i].bytes : 0; removed++;\0A        }\0A        free(entries[i].path);\0A    }\0A    free(entries); return removed;\0A}\0A\0A// Three-way, and the third case is the point: 1 present, 0 absent, -1\0A// CANNOT SAY.\0A//\0A// \22Does this exist\22 and \22can I see whether this exists\22 are different\0A// questions, and collapsing them is how a permission error becomes a\0A// silent \22no\22. Only `ENOENT` and `ENOTDIR` mean absent -- the latter\0A// because a path under a non-directory (`a/b` where `a` is a file)\0A// cannot exist either. Anything else is a real failure to report.\0Along long os_path_exists(const char *path) {\0A    struct stat st;\0A    if (stat(path, &st) == 0) {\0A        return 1;\0A    }\0A    if (errno == ENOENT || errno == ENOTDIR) {\0A        return 0;\0A    }\0A    return -1;\0A}\0A\0A// --- Working directory (issue #17) ---\0A//\0A// Its own buffer rather than `plum_os_buf`: that one holds the result of\0A// `os_temp_dir`/`os_self_exe`, and a caller holding one of those across\0A// a `cwd()` would silently get the wrong string back.\0Astatic char plum_cwd_buf[PLUM_PATH_MAX];\0A\0A// \22\22 on failure, never NULL -- a null `CStr` return is a hard runtime\0A// abort under Plum's FFI semantics, the same trade every other shim\0A// here makes.\0Aconst char *os_cwd(void) {\0A#if defined(_WIN32)\0A    if (_getcwd(plum_cwd_buf, (int)sizeof(plum_cwd_buf)) == NULL) plum_cwd_buf[0] = '\5C0';\0A#else\0A    if (getcwd(plum_cwd_buf, sizeof(plum_cwd_buf)) == NULL) plum_cwd_buf[0] = '\5C0';\0A#endif\0A    return plum_cwd_buf;\0A}\0A\0Along long os_chdir(const char *path) {\0A#if defined(_WIN32)\0A    return _chdir(path) == 0 ? 0 : -1;\0A#else\0A    return chdir(path) == 0 ? 0 : -1;\0A#endif\0A}\0A\00" }
