s_entropy_context *ctx = (mbedtls_entropy_context *) data;\0A    unsigned char buf[MBEDTLS_ENTROPY_BLOCK_SIZE];\0A\0A    if (len > MBEDTLS_ENTROPY_BLOCK_SIZE) {\0A        return MBEDTLS_ERR_ENTROPY_SOURCE_FAILED;\0A    }\0A\0A#if defined(MBEDTLS_ENTROPY_NV_SEED)\0A    /* Update the NV entropy seed before generating any entropy for outside\0A     * use.\0A     */\0A    if (ctx->initial_entropy_run == 0) {\0A        ctx->initial_entropy_run = 1;\0A        if ((ret = mbedtls_entropy_update_nv_seed(ctx)) != 0) {\0A            return ret;\0A        }\0A    }\0A#endif\0A\0A#if defined(MBEDTLS_THREADING_C)\0A    if ((ret = mbedtls_mutex_lock(&ctx->mutex)) != 0) {\0A        return ret;\0A    }\0A#endif\0A\0A    /*\0A     * Always gather extra entropy before a call\0A     */\0A    do {\0A        if (count++ > ENTROPY_MAX_LOOP) {\0A            ret = MBEDTLS_ERR_ENTROPY_SOURCE_FAILED;\0A            goto exit;\0A        }\0A\0A        if ((ret = entropy_gather_internal(ctx)) != 0) {\0A            goto exit;\0A        }\0A\0A        thresholds_reached = 1;\0A        strong_size = 0;\0A        for (i = 0; i < ctx->source_count; i++) {\0A            if (ctx->source[i].size < ctx->source[i].threshold) {\0A                thresholds_reached = 0;\0A            }\0A            if (ctx->source[i].strong == MBEDTLS_ENTROPY_SOURCE_STRONG) {\0A                strong_size += ctx->source[i].size;\0A            }\0A        }\0A    } while (!thresholds_reached || strong_size < MBEDTLS_ENTROPY_BLOCK_SIZE);\0A\0A    memset(buf, 0, MBEDTLS_ENTROPY_BLOCK_SIZE);\0A\0A    /*\0A     * Note that at this stage it is assumed that the accumulator was started\0A     * in a previous call to entropy_update(). If this is not guaranteed, the\0A     * code below will fail.\0A     */\0A    if ((ret = mbedtls_md_finish(&ctx->accumulator, buf)) != 0) {\0A        goto exit;\0A    }\0A\0A    /*\0A     * Reset accumulator and counters and recycle existing entropy\0A     */\0A    mbedtls_md_free(&ctx->accumulator);\