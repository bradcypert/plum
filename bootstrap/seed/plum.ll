ithm.\0A * \5Cparam hash     The buffer holding the message digest or raw data.\0A *                 This must be a readable buffer of at least \5Cp hashlen Bytes.\0A * \5Cparam sig      The buffer holding the signature. This must be a readable\0A *                 buffer of length \5Cc ctx->len Bytes. For example, \5Cc 256 Bytes\0A *                 for an 2048-bit RSA modulus.\0A *\0A * \5Creturn         \5Cc 0 if the verify operation was successful.\0A * \5Creturn         An \5Cc MBEDTLS_ERR_RSA_XXX error code on failure.\0A */\0Aint mbedtls_rsa_rsassa_pss_verify(mbedtls_rsa_context *ctx,\0A                                  mbedtls_md_type_t md_alg,\0A                                  unsigned int hashlen,\0A                                  const unsigned char *hash,\0A                                  const unsigned char *sig);\0A\0A/**\0A * \5Cbrief          This function performs a PKCS#1 v2.1 PSS verification\0A *                 operation (RSASSA-PSS-VERIFY).\0A *\0A * \5Cnote           The \5Cp sig buffer must be as large as the size\0A *                 of \5Cp ctx->N. For example, 128 Bytes if RSA-1024 is used.\0A *\0A * \5Cnote           The \5Cc hash_id set in \5Cp ctx by mbedtls_rsa_set_padding() is\0A *                 ignored.\0A *\0A * \5Cparam ctx      The initialized RSA public key context to use.\0A * \5Cparam md_alg   The message-digest algorithm used to hash the original data.\0A *                 Use #MBEDTLS_MD_NONE for signing raw data.\0A * \5Cparam hashlen  The length of the message digest or raw data in Bytes.\0A *                 If \5Cp md_alg is not #MBEDTLS_MD_NONE, this must match the\0A *                 output length of the corresponding hash algorithm.\0A * \5Cparam hash     The buffer holding the message digest or raw data.\0A *                 This must be a readable buffer of at least \5Cp hashlen Bytes.\0A * \5Cparam mgf1_hash_id      The message digest algorithm used for the\0A *                          verification operation and the mask generation\0A *                          function (MGF1). For more details on the encoding\0A *                          operation and the mask generation function, consult\0A *                          <em>RFC-3447: Public-Key Cryptography Standards\0A *                          (PKCS) #1 v2.1: RSA Cryptography\0A *                          Specifications</em>.\0A * \5Cparam expected_salt_len The length of the salt used in padding. Use\0A *                          #MBEDTLS_RSA_SALT_LEN_ANY to accept any salt length.\0A * \5Cparam sig      The buffer holding the signature. This must be a readable\0A *                 buffer of length \5Cc ctx->len Bytes. For example, \5Cc 256 Bytes\0A *                 for an 2048-bit RSA modulus.\0A *\0A * \5Creturn         \5Cc 0 if the verify operation was successful.\0A * \5Creturn         An \5Cc MBEDTLS_ERR_RSA_XXX error code on failure.\0A */\0Aint mbedtls_rsa_rsassa_pss_verify_ext(mbedtls_rsa_context *ctx,\0A                                      mbedtls_md_type_t md_alg,\0A                                      unsigned int hashlen,\0A                                      const unsigned char *hash,\0A                                      mbedtls_md_type_t mgf1_hash_id,\0A                                      int expected_salt_len,\0A                                      const unsigned char *sig);\0A\0A/**\0A * \5Cbrief          This function copies the components of an RSA context.\0A *\0A * \5Cparam dst      The destination context. This must be initialized.\0A * \5Cparam src      The source context. This must be initialized.\0A *\0A * \5Creturn         \5Cc 0 on success.\0A * \5Creturn         #MBEDTLS_ERR_MPI_ALLOC_FAILED on memory allocation failure.\0A */\0Aint mbedtls_rsa_copy(mbedtls_rsa_context *dst, const mbedtls_rsa_context *src);\0A\0A/**\0A * \5Cbrief          This function frees the components of an RSA key.\0A *\0A * \5Cparam ctx      The RSA context to free. May be \5Cc NULL, in which case\0A *                 this function is a no-op. If it is not \5Cc NULL, it must\0A *                 point to an initialized RSA context.\0A */\0Avoid mbedtls_rsa_free(mbedtls_rsa_context *ctx);\0A\0A#if defined(MBEDTLS_SELF_TEST)\0A\0A/**\0A * \5Cbrief          The RSA checkup routine.\0A *\0A * \5Creturn         \5Cc 0 on success.\0A * \5Creturn         \5Cc 1 on failure.\0A */\0Aint mbedtls_rsa_self_test(int verbose);\0A\0A#endif /* MBEDTLS_SELF_TEST */\0A\0A#ifdef __cplusplus\0A}\0A#endif\0A\0A#endif /* rsa.h */\0A\00" }
