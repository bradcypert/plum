;\0A            } else if (r == 1) {\0A                MBEDTLS_MPI_CHK(mbedtls_mpi_add_int(X, X, 4));\0A            }\0A\0A            /* Set Y = (X-1) / 2, which is X / 2 because X is odd */\0A            MBEDTLS_MPI_CHK(mbedtls_mpi_copy(&Y, X));\0A            MBEDTLS_MPI_CHK(mbedtls_mpi_shift_r(&Y, 1));\0A\0A            while (1) {\0A                /*\0A                 * First, check small factors for X and Y\0A                 * before doing Miller-Rabin on any of them\0A                 */\0A                if ((ret = mpi_check_small_factors(X)) == 0 &&\0A                    (ret = mpi_check_small_factors(&Y)) == 0 &&\0A                    (ret = mpi_miller_rabin(X, rounds, f_rng, p_rng))\0A                    == 0 &&\0A                    (ret = mpi_miller_rabin(&Y, rounds, f_rng, p_rng))\0A                    == 0) {\0A                    goto cleanup;\0A                }\0A\0A                if (ret != MBEDTLS_ERR_MPI_NOT_ACCEPTABLE) {\0A                    goto cleanup;\0A                }\0A\0A                /*\0A                 * Next candidates. We want to preserve Y = (X-1) / 2 and\0A                 * Y = 1 mod 2 and Y = 2 mod 3 (eq X = 3 mod 4 and X = 2 mod 3)\0A                 * so up Y by 6 and X by 12.\0A                 */\0A                MBEDTLS_MPI_CHK(mbedtls_mpi_add_int(X,  X, 12));\0A                MBEDTLS_MPI_CHK(mbedtls_mpi_add_int(&Y, &Y, 6));\0A            }\0A        }\0A    }\0A\0Acleanup:\0A\0A    mbedtls_mpi_free(&Y);\0A\0A    return ret;\0A}\0A\0A#endif /* MBEDTLS_GENPRIME */\0A\0A#if defined(MBEDTLS_SELF_TEST)\0A\0A#define GCD_PAIR_COUNT  3\0A\0Astatic const int gcd_pairs[GCD_PAIR_COUNT][3] =\0A{\0A    { 693, 609, 21 },\0A    { 1764, 868, 28 },\0A    { 768454923, 542167814, 1 }\0A};\0A\0A/*\0A * Checkup routine\0A */\0Aint mbedtls_mpi_self_test(int verbose)\0A{\0A    int ret, i;\0A    mbedtls_mpi A, E, N, X, Y, U, V;\0A\0A    mbedtls_mpi_init(&A); mbedtls_mpi_init(&E); mbedtls_mpi_init(&N); mbedtls_mpi_init(&X);\0A    mbedtls