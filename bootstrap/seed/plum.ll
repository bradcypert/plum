@.str42113 = private global { i64, i64, [1148 x i8] } { i64 -1, i64 1147, [1148 x i8] c"/**\0A * \5Cfile base64_internal.h\0A *\0A * \5Cbrief RFC 1521 base64 encoding/decoding: interfaces for invasive testing\0A */\0A/*\0A *  Copyright The Mbed TLS Contributors\0A *  SPDX-License-Identifier: Apache-2.0 OR GPL-2.0-or-later\0A */\0A\0A#ifndef MBEDTLS_BASE64_INTERNAL\0A#define MBEDTLS_BASE64_INTERNAL\0A\0A#include \22common.h\22\0A\0A#if defined(MBEDTLS_TEST_HOOKS)\0A\0A/** Given a value in the range 0..63, return the corresponding Base64 digit.\0A *\0A * The implementation assumes that letters are consecutive (e.g. ASCII\0A * but not EBCDIC).\0A *\0A * \5Cparam value     A value in the range 0..63.\0A *\0A * \5Creturn          A base64 digit converted from \5Cp value.\0A */\0Aunsigned char mbedtls_ct_base64_enc_char(unsigned char value);\0A\0A/** Given a Base64 digit, return its value.\0A *\0A * If c is not a Base64 digit ('A'..'Z', 'a'..'z', '0'..'9', '+' or '/'),\0A * return -1.\0A *\0A * The implementation assumes that letters are consecutive (e.g. ASCII\0A * but not EBCDIC).\0A *\0A * \5Cparam c     A base64 digit.\0A *\0A * \5Creturn      The value of the base64 digit \5Cp c.\0A */\0Asigned char mbedtls_ct_base64_dec_value(unsigned char c);\0A\0A#endif /* MBEDTLS_TEST_HOOKS */\0A\0A#endif /* MBEDTLS_BASE64_INTERNAL */\0A\00" }
