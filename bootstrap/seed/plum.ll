@.str45159 = private global { i64, i64, [20238 x i8] } { i64 -1, i64 20237, [20238 x i8] c"/**\0A * \5Cfile md.h\0A *\0A * \5Cbrief   This file contains the generic functions for message-digest\0A *          (hashing) and HMAC.\0A *\0A * \5Cauthor Adriaan de Jong <dejong@fox-it.com>\0A */\0A/*\0A *  Copyright The Mbed TLS Contributors\0A *  SPDX-License-Identifier: Apache-2.0 OR GPL-2.0-or-later\0A */\0A\0A#ifndef MBEDTLS_MD_H\0A#define MBEDTLS_MD_H\0A#include \22mbedtls/private_access.h\22\0A\0A#include <stddef.h>\0A\0A#include \22mbedtls/build_info.h\22\0A#include \22mbedtls/platform_util.h\22\0A\0A/** The selected feature is not available. */\0A#define MBEDTLS_ERR_MD_FEATURE_UNAVAILABLE                -0x5080\0A/** Bad input parameters to function. */\0A#define MBEDTLS_ERR_MD_BAD_INPUT_DATA                     -0x5100\0A/** Failed to allocate memory. */\0A#define MBEDTLS_ERR_MD_ALLOC_FAILED                       -0x5180\0A/** Opening or reading of file failed. */\0A#define MBEDTLS_ERR_MD_FILE_IO_ERROR                      -0x5200\0A\0A#ifdef __cplusplus\0Aextern \22C\22 {\0A#endif\0A\0A/**\0A * \5Cbrief     Supported message digests.\0A *\0A * \5Cwarning   MD5 and SHA-1 are considered weak message digests and\0A *            their use constitutes a security risk. We recommend considering\0A *            stronger message digests instead.\0A *\0A */\0A/* Note: these are aligned with the definitions of PSA_ALG_ macros for hashes,\0A * in order to enable an efficient implementation of conversion functions.\0A * This is tested by md_to_from_psa() in test_suite_md. */\0Atypedef enum {\0A    MBEDTLS_MD_NONE=0,    /**< None. */\0A    MBEDTLS_MD_MD5=0x03,       /**< The MD5 message digest. */\0A    MBEDTLS_MD_RIPEMD160=0x04, /**< The RIPEMD-160 message digest. */\0A    MBEDTLS_MD_SHA1=0x05,      /**< The SHA-1 message digest. */\0A    MBEDTLS_MD_SHA224=0x08,    /**< The SHA-224 message digest. */\0A    MBEDTLS_MD_SHA256=0x09,    /**< The SHA-256 message digest. */\0A    MBEDTLS_MD_SHA384=0x0a,    /**< The SHA-384 message digest. */\0A    MBEDTLS_MD_SHA512=0x0b,    /**< The SHA-512 message digest. */\0A    MBEDTLS_MD_SHA3_224=0x10,  /**< The SHA3-224 message digest. */\0A    MBEDTLS_MD_SHA3_256=0x11,  /**< The SHA3-256 message digest. */\0A    MBEDTLS_MD_SHA3_384=0x12,  /**< The SHA3-384 message digest. */\0A    MBEDTLS_MD_SHA3_512=0x13,  /**< The SHA3-512 message digest. */\0A} mbedtls_md_type_t;\0A\0A/* Note: this should always be >= PSA_HASH_MAX_SIZE\0A * in all builds with both CRYPTO_C and MD_LIGHT.\0A *\0A * This is to make things easier for modules such as TLS that may define a\0A * buffer size using MD_MAX_SIZE in a part of the code that's common to PSA\0A * and legacy, then assume the buffer's size is PSA_HASH_MAX_SIZE in another\0A * part of the code based on PSA.\0A */\0A#if defined(MBEDTLS_MD_CAN_SHA512) || defined(MBEDTLS_MD_CAN_SHA3_512)\0A#define MBEDTLS_MD_MAX_SIZE         64  /* longest known is SHA512 */\0A#elif defined(MBEDTLS_MD_CAN_SHA384) || defined(MBEDTLS_MD_CAN_SHA3_384)\0A#define MBEDTLS_MD_MAX_SIZE         48  /* longest known is SHA384 */\0A#elif defined(MBEDTLS_MD_CAN_SHA256) || defined(MBEDTLS_MD_CAN_SHA3_256)\0A#define MBEDTLS_MD_MAX_SIZE         32  /* longest known is SHA256 */\0A#elif defined(MBEDTLS_MD_CAN_SHA224) || defined(MBEDTLS_MD_CAN_SHA3_224)\0A#define MBEDTLS_MD_MAX_SIZE         28  /* longest known is SHA224 */\0A#else\0A#define MBEDTLS_MD_MAX_SIZE         20  /* longest known is SHA1 or RIPE MD-160\0A                                           or smaller (MD5 and earlier) */\0A#endif\0A\0A#if defined(MBEDTLS_MD_CAN_SHA3_224)\0A#define MBEDTLS_MD_MAX_BLOCK_SIZE         144 /* the longest known is SHA3-224 */\0A#elif defined(MBEDTLS_MD_CAN_SHA3_256)\0A#define MBEDTLS_MD_MAX_BLOCK_SIZE         136\0A#elif defined(MBEDTLS_MD_CAN_SHA512) || defined(MBEDTLS_MD_CAN_SHA384)\0A#define MBEDTLS_MD_MAX_BLOCK_SIZE         128\0A#elif defined(MBEDTLS_MD_CAN_SHA3_384)\0A#define MBEDTLS_MD_MAX_BLOCK_SIZE         104\0A#elif defined(MBEDTLS_MD_CAN_SHA3_512)\0A#define MBEDTLS_MD_MAX_BLOCK_SIZE         72\0A#else\0A#define MBEDTLS_MD_MAX_BLOCK_SIZE         64\0A#endif\0A\0A/**\0A * Opaque struct.\0A *\0A * Constructed using either #mbedtls_md_info_from_string or\0A * #mbedtls_md_info_from_type.\0A *\0A * Fields can be accessed with #mbedtls_md_get_size,\0A * #mbedtls_md_get_type and #mbedtls_md_get_name.\0A */\0A/* Defined internally in library/md_wrap.h. */\0Atypedef struct mbedtls_md_info_t mbedtls_md_info_t;\0A\0A/**\0A * Used internally to indicate whether a context uses legacy or PSA.\0A *\0A * Internal use only.\0A */\0Atypedef enum {\0A    MBEDTLS_MD_ENGINE_LEGACY = 0,\0A    MBEDTLS_MD_ENGINE_PSA,\0A} mbedtls_md_engine_t;\0A\0A/**\0A * The generic message-digest context.\0A */\0Atypedef struct mbedtls_md_context_t {\0A    /** Information about the associated message digest. */\0A    const mbedtls_md_info_t *MBEDTLS_PRIVATE(md_info);\0A\0A#if defined(MBEDTLS_MD_SOME_PSA)\0A    /** Are hash operations dispatched to PSA or legacy? */\0A    mbedtls_md_engine_t MBEDTLS_PRIVATE(engine);\0A#endif\0A\0A    /** The digest-specific context (legacy) or the PSA operation. */\0A    void *MBEDTLS_PRIVATE(md_ctx);\0A\0A#if defined(MBEDTLS_MD_C)\0A    /** The HMAC part of the context. */\0A    void *MBEDTLS_PRIVATE(hmac_ctx);\0A#endif\0A} mbedtls_md_context_t;\0A\0A/**\0A * \5Cbrief           This function returns the message-digest information\0A *                  associated with the given digest type.\0A *\0A * \5Cparam md_type   The type of digest to search for.\0A *\0A * \5Creturn          The message-digest information associated with \5Cp md_type.\0A * \5Creturn          NULL if the associated message-digest information is not found.\0A */\0Aconst mbedtls_md_info_t *mbedtls_md_info_from_type(mbedtls_md_type_t md_type);\0A\0A/**\0A * \5Cbrief           This function initializes a message-digest context without\0A *                  binding it to a particular message-digest algorithm.\0A *\0A *                  This function should always be called first. It prepares the\0A *                  context for mbedtls_md_setup() for binding it to a\0A *                  message-digest algorithm.\0A */\0Avoid mbedtls_md_init(mbedtls_md_context_t *ctx);\0A\0A/**\0A * \5Cbrief           This function clears the internal structure of \5Cp ctx and\0A *                  frees any embedded internal structure, but does not free\0A *                  \5Cp ctx itself.\0A *\0A *                  If you have called mbedtls_md_setup() on \5Cp ctx, you must\0A *                  call mbedtls_md_free() when you are no longer using the\0A *                  context.\0A *                  Calling this function if you have previously\0A *                  called mbedtls_md_init() and nothing else is optional.\0A *                  You must not call this function if you have not called\0A *                  mbedtls_md_init().\0A */\0Avoid mbedtls_md_free(mbedtls_md_context_t *ctx);\0A\0A\0A/**\0A * \5Cbrief           This function selects the message digest algorithm to use,\0A *                  and allocates internal structures.\0A *\0A *                  It should be called after mbedtls_md_init() or\0A *                  mbedtls_md_free(). Makes it necessary to call\0A *                  mbedtls_md_free() later.\0A *\0A * \5Cparam ctx       The context to set up.\0A * \5Cparam md_info   The information structure of the message-digest algorithm\0A *                  to use.\0A * \5Cparam hmac      Defines if HMAC is used. 0: HMAC is not used (saves some memory),\0A *                  or non-zero: HMAC is used with this context.\0A *\0A * \5Creturn          \5Cc 0 on success.\0A * \5Creturn          #MBEDTLS_ERR_MD_BAD_INPUT_DATA on parameter-verification\0A *                  failure.\0A * \5Creturn          #MBEDTLS_ERR_MD_ALLOC_FAILED on memory-allocation failure.\0A */\0AMBEDTLS_CHECK_RETURN_TYPICAL\0Aint mbedtls_md_setup(mbedtls_md_context_t *ctx, const mbedtls_md_info_t *md_info, int hmac);\0A\0A/**\0A * \5Cbrief           This function clones the state of a message-digest\0A *                  context.\0A *\0A * \5Cnote            You must call mbedtls_md_setup() on \5Cc dst before calling\0A *                  this function.\0A *\0A * \5Cnote            The two contexts must have the same type,\0A *                  for example, both are SHA-256.\0A *\0A * \5Cwarning         This function clones the message-digest state, not the\0A *                  HMAC state.\0A *\0A * \5Cparam dst       The destination context.\0A * \5Cparam src       The context to be cloned.\0A *\0A * \5Creturn          \5Cc 0 on success.\0A * \5Creturn          #MBEDTLS_ERR_MD_BAD_INPUT_DATA on parameter-verification failure.\0A * \5Creturn          #MBEDTLS_ERR_MD_FEATURE_UNAVAILABLE if both contexts are\0A *                  not using the same engine. This can be avoided by moving\0A *                  the call to psa_crypto_init() before the first call to\0A *                  mbedtls_md_setup().\0A */\0AMBEDTLS_CHECK_RETURN_TYPICAL\0Aint mbedtls_md_clone(mbedtls_md_context_t *dst,\0A                     const mbedtls_md_context_t *src);\0A\0A/**\0A * \5Cbrief           This function extracts the message-digest size from the\0A *                  message-digest information structure.\0A *\0A * \5Cparam md_info   The information structure of the message-digest algorithm\0A *                  to use.\0A *\0A * \5Creturn          The size of the message-digest output in Bytes.\0A */\0Aunsigned char mbedtls_md_get_size(const mbedtls_md_info_t *md_info);\0A\0A/**\0A * \5Cbrief           This function gives the message-digest size associated to\0A *                  message-digest type.\0A *\0A * \5Cparam md_type   The message-digest type.\0A *\0A * \5Creturn          The size of the message-digest output in Bytes,\0A *                  or 0 if the message-digest type is not known.\0A */\0Astatic inline unsigned char mbedtls_md_get_size_from_type(mbedtls_md_type_t md_type)\0A{\0A    return mbedtls_md_get_size(mbedtls_md_info_from_type(md_type));\0A}\0A\0A/**\0A * \5Cbrief           This function extracts the message-digest type from the\0A *                  message-digest information structure.\0A *\0A * \5Cparam md_info   The information structure of the message-digest algorithm\0A *                  to use.\0A *\0A * \5Creturn          The type of the message digest.\0A */\0Ambedtls_md_type_t mbedtls_md_get_type(const mbedtls_md_info_t *md_info);\0A\0A/**\0A * \5Cbrief           This function starts a message-digest computation.\0A *\0A *                  You must call this function after setting up the context\0A *                  with mbedtls_md_setup(), and before passing data with\0A *                  mbedtls_md_update().\0A *\0A * \5Cparam ctx       The generic message-digest context.\0A *\0A * \5Creturn          \5Cc 0 on success.\0A * \5Creturn          #MBEDTLS_ERR_MD_BAD_INPUT_DATA on parameter-verification\0A *                  failure.\0A */\0AMBEDTLS_CHECK_RETURN_TYPICAL\0Aint mbedtls_md_starts(mbedtls_md_context_t *ctx);\0A\0A/**\0A * \5Cbrief           This function feeds an input buffer into an ongoing\0A *                  message-digest computation.\0A *\0A *                  You must call mbedtls_md_starts() before calling this\0A *                  function. You may call this function multiple times.\0A *                  Afterwards, call mbedtls_md_finish().\0A *\0A * \5Cparam ctx       The generic message-digest context.\0A * \5Cparam input     The buffer holding the input data.\0A * \5Cparam ilen      The length of the input data.\0A *\0A * \5Creturn          \5Cc 0 on success.\0A * \5Creturn          #MBEDTLS_ERR_MD_BAD_INPUT_DATA on parameter-verification\0A *                  failure.\0A */\0AMBEDTLS_CHECK_RETURN_TYPICAL\0Aint mbedtls_md_update(mbedtls_md_context_t *ctx, const unsigned char *input, size_t ilen);\0A\0A/**\0A * \5Cbrief           This function finishes the digest operation,\0A *                  and writes the result to the output buffer.\0A *\0A *                  Call this function after a call to mbedtls_md_starts(),\0A *                  followed by any number of calls to mbedtls_md_update().\0A *                  Afterwards, you may either clear the context with\0A *                  mbedtls_md_free(), or call mbedtls_md_starts() to reuse\0A *                  the context for another digest operation with the same\0A *                  algorithm.\0A *\0A * \5Cparam ctx       The generic message-digest context.\0A * \5Cparam output    The buffer for the generic message-digest checksum result.\0A *\0A * \5Creturn          \5Cc 0 on success.\0A * \5Creturn          #MBEDTLS_ERR_MD_BAD_INPUT_DATA on parameter-verification\0A *                  failure.\0A */\0AMBEDTLS_CHECK_RETURN_TYPICAL\0Aint mbedtls_md_finish(mbedtls_md_context_t *ctx, unsigned char *output);\0A\0A/**\0A * \5Cbrief          This function calculates the message-digest of a buffer,\0A *                 with respect to a configurable message-digest algorithm\0A *                 in a single call.\0A *\0A *                 The result is calculated as\0A *                 Output = message_digest(input buffer).\0A *\0A * \5Cparam md_info  The information structure of the message-digest algorithm\0A *                 to use.\0A * \5Cparam input    The buffer holding the data.\0A * \5Cparam ilen     The length of the input data.\0A * \5Cparam output   The generic message-digest checksum result.\0A *\0A * \5Creturn         \5Cc 0 on success.\0A * \5Creturn         #MBEDTLS_ERR_MD_BAD_INPUT_DATA on parameter-verification\0A *                 failure.\0A */\0AMBEDTLS_CHECK_RETURN_TYPICAL\0Aint mbedtls_md(const mbedtls_md_info_t *md_info, const unsigned char *input, size_t ilen,\0A               unsigned char *output);\0A\0A/**\0A * \5Cbrief           This function returns the list of digests supported by the\0A *                  generic digest module.\0A *\0A * \5Cnote            The list starts with the strongest available hashes.\0A *\0A * \5Creturn          A statically allocated array of digests. Each element\0A *                  in the returned list is an integer belonging to the\0A *                  message-digest enumeration #mbedtls_md_type_t.\0A *                  The last entry is 0.\0A */\0Aconst int *mbedtls_md_list(void);\0A\0A/**\0A * \5Cbrief           This function returns the message-digest information\0A *                  associated with the given digest name.\0A *\0A * \5Cparam md_name   The name of the digest to search for.\0A *\0A * \5Creturn          The message-digest information associated with \5Cp md_name.\0A * \5Creturn          NULL if the associated message-digest information is not found.\0A */\0Aconst mbedtls_md_info_t *mbedtls_md_info_from_string(const char *md_name);\0A\0A/**\0A * \5Cbrief           This function returns the name of the message digest for\0A *                  the message-digest information structure given.\0A *\0A * \5Cparam md_info   The information structure of the message-digest algorithm\0A *                  to use.\0A *\0A * \5Creturn          The name of the message digest.\0A */\0Aconst char *mbedtls_md_get_name(const mbedtls_md_info_t *md_info);\0A\0A/**\0A * \5Cbrief           This function returns the message-digest information\0A *                  from the given context.\0A *\0A * \5Cparam ctx       The context from which to extract the information.\0A *                  This must be initialized (or \5Cc NULL).\0A *\0A * \5Creturn          The message-digest information associated with \5Cp ctx.\0A * \5Creturn          \5Cc NULL if \5Cp ctx is \5Cc NULL.\0A */\0Aconst mbedtls_md_info_t *mbedtls_md_info_from_ctx(\0A    const mbedtls_md_context_t *ctx);\0A\0A#if defined(MBEDTLS_FS_IO)\0A/**\0A * \5Cbrief          This function calculates the message-digest checksum\0A *                 result of the contents of the provided file.\0A *\0A *                 The result is calculated as\0A *                 Output = message_digest(file contents).\0A *\0A * \5Cparam md_info  The information structure of the message-digest algorithm\0A *                 to use.\0A * \5Cparam path     The input file name.\0A * \5Cparam output   The generic message-digest checksum result.\0A *\0A * \5Creturn         \5Cc 0 on success.\0A * \5Creturn         #MBEDTLS_ERR_MD_FILE_IO_ERROR on an I/O error accessing\0A *                 the file pointed by \5Cp path.\0A * \5Creturn         #MBEDTLS_ERR_MD_BAD_INPUT_DATA if \5Cp md_info was NULL.\0A */\0AMBEDTLS_CHECK_RETURN_TYPICAL\0Aint mbedtls_md_file(const mbedtls_md_info_t *md_info, const char *path,\0A                    unsigned char *output);\0A#endif /* MBEDTLS_FS_IO */\0A\0A/**\0A * \5Cbrief           This function sets the HMAC key and prepares to\0A *                  authenticate a new message.\0A *\0A *                  Call this function after mbedtls_md_setup(), to use\0A *                  the MD context for an HMAC calculation, then call\0A *                  mbedtls_md_hmac_update() to provide the input data, and\0A *                  mbedtls_md_hmac_finish() to get the HMAC value.\0A *\0A * \5Cparam ctx       The message digest context containing an embedded HMAC\0A *                  context.\0A * \5Cparam key       The HMAC secret key.\0A * \5Cparam keylen    The length of the HMAC key in Bytes.\0A *\0A * \5Creturn          \5Cc 0 on success.\0A * \5Creturn          #MBEDTLS_ERR_MD_BAD_INPUT_DATA on parameter-verification\0A *                  failure.\0A */\0AMBEDTLS_CHECK_RETURN_TYPICAL\0Aint mbedtls_md_hmac_starts(mbedtls_md_context_t *ctx, const unsigned char *key,\0A                           size_t keylen);\0A\0A/**\0A * \5Cbrief           This function feeds an input buffer into an ongoing HMAC\0A *                  computation.\0A *\0A *                  Call mbedtls_md_hmac_starts() or mbedtls_md_hmac_reset()\0A *                  before calling this function.\0A *                  You may call this function multiple times to pass the\0A *                  input piecewise.\0A *                  Afterwards, call mbedtls_md_hmac_finish().\0A *\0A * \5Cparam ctx       The message digest context containing an embedded HMAC\0A *                  context.\0A * \5Cparam input     The buffer holding the input data.\0A * \5Cparam ilen      The length of the input data.\0A *\0A * \5Creturn          \5Cc 0 on success.\0A * \5Creturn          #MBEDTLS_ERR_MD_BAD_INPUT_DATA on parameter-verification\0A *                  failure.\0A */\0AMBEDTLS_CHECK_RETURN_TYPICAL\0Aint mbedtls_md_hmac_update(mbedtls_md_context_t *ctx, const unsigned char *input,\0A                           size_t ilen);\0A\0A/**\0A * \5Cbrief           This function finishes the HMAC operation, and writes\0A *                  the result to the output buffer.\0A *\0A *                  Call this function after mbedtls_md_hmac_starts() and\0A *                  mbedtls_md_hmac_update() to get the HMAC value. Afterwards\0A *                  you may either call mbedtls_md_free() to clear the context,\0A *                  or call mbedtls_md_hmac_reset() to reuse the context with\0A *                  the same HMAC key.\0A *\0A * \5Cparam ctx       The message digest context containing an embedded HMAC\0A *                  context.\0A * \5Cparam output    The generic HMAC checksum result.\0A *\0A * \5Creturn          \5Cc 0 on success.\0A * \5Creturn          #MBEDTLS_ERR_MD_BAD_INPUT_DATA on parameter-verification\0A *                  failure.\0A */\0AMBEDTLS_CHECK_RETURN_TYPICAL\0Aint mbedtls_md_hmac_finish(mbedtls_md_context_t *ctx, unsigned char *output);\0A\0A/**\0A * \5Cbrief           This function prepares to authenticate a new message with\0A *                  the same key as the previous HMAC operation.\0A *\0A *                  You may call this function after mbedtls_md_hmac_finish().\0A *                  Afterwards call mbedtls_md_hmac_update() to pass the new\0A *                  input.\0A *\0A * \5Cparam ctx       The message digest context containing an embedded HMAC\0A *                  context.\0A *\0A * \5Creturn          \5Cc 0 on success.\0A * \5Creturn          #MBEDTLS_ERR_MD_BAD_INPUT_DATA on parameter-verification\0A *                  failure.\0A */\0AMBEDTLS_CHECK_RETURN_TYPICAL\0Aint mbedtls_md_hmac_reset(mbedtls_md_context_t *ctx);\0A\0A/**\0A * \5Cbrief          This function calculates the full generic HMAC\0A *                 on the input buffer with the provided key.\0A *\0A *                 The function allocates the context, performs the\0A *                 calculation, and frees the context.\0A *\0A *                 The HMAC result is calculated as\0A *                 output = generic HMAC(hmac key, input buffer).\0A *\0A * \5Cparam md_info  The information structure of the message-digest algorithm\0A *                 to use.\0A * \5Cparam key      The HMAC secret key.\0A * \5Cparam keylen   The length of the HMAC secret key in Bytes.\0A * \5Cparam input    The buffer holding the input data.\0A * \5Cparam ilen     The length of the input data.\0A * \5Cparam output   The generic HMAC result.\0A *\0A * \5Creturn         \5Cc 0 on success.\0A * \5Creturn         #MBEDTLS_ERR_MD_BAD_INPUT_DATA on parameter-verification\0A *                 failure.\0A */\0AMBEDTLS_CHECK_RETURN_TYPICAL\0Aint mbedtls_md_hmac(const mbedtls_md_info_t *md_info, const unsigned char *key, size_t keylen,\0A                    const unsigned char *input, size_t ilen,\0A                    unsigned char *output);\0A\0A#ifdef __cplusplus\0A}\0A#endif\0A\0A#endif /* MBEDTLS_MD_H */\0A\00" }
