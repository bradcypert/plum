3_process_server_finished(ssl);\0A            break;\0A\0A#if defined(MBEDTLS_SSL_EARLY_DATA)\0A        case MBEDTLS_SSL_END_OF_EARLY_DATA:\0A            ret = ssl_tls13_write_end_of_early_data(ssl);\0A            break;\0A#endif\0A\0A        case MBEDTLS_SSL_CLIENT_CERTIFICATE:\0A            ret = ssl_tls13_write_client_certificate(ssl);\0A            break;\0A\0A#if defined(MBEDTLS_SSL_TLS1_3_KEY_EXCHANGE_MODE_EPHEMERAL_ENABLED)\0A        case MBEDTLS_SSL_CLIENT_CERTIFICATE_VERIFY:\0A            ret = ssl_tls13_write_client_certificate_verify(ssl);\0A            break;\0A#endif /* MBEDTLS_SSL_TLS1_3_KEY_EXCHANGE_MODE_EPHEMERAL_ENABLED */\0A\0A        case MBEDTLS_SSL_CLIENT_FINISHED:\0A            ret = ssl_tls13_write_client_finished(ssl);\0A            break;\0A\0A        case MBEDTLS_SSL_FLUSH_BUFFERS:\0A            ret = ssl_tls13_flush_buffers(ssl);\0A            break;\0A\0A        case MBEDTLS_SSL_HANDSHAKE_WRAPUP:\0A            ret = ssl_tls13_handshake_wrapup(ssl);\0A            break;\0A\0A            /*\0A             * Injection of dummy-CCS's for middlebox compatibility\0A             */\0A#if defined(MBEDTLS_SSL_TLS1_3_COMPATIBILITY_MODE)\0A        case MBEDTLS_SSL_CLIENT_CCS_BEFORE_2ND_CLIENT_HELLO:\0A            ret = mbedtls_ssl_tls13_write_change_cipher_spec(ssl);\0A            if (ret != 0) {\0A                break;\0A            }\0A            mbedtls_ssl_handshake_set_state(ssl, MBEDTLS_SSL_CLIENT_HELLO);\0A            break;\0A\0A        case MBEDTLS_SSL_CLIENT_CCS_AFTER_SERVER_FINISHED:\0A            ret = mbedtls_ssl_tls13_write_change_cipher_spec(ssl);\0A            if (ret != 0) {\0A                break;\0A            }\0A            mbedtls_ssl_handshake_set_state(ssl, MBEDTLS_SSL_CLIENT_CERTIFICATE);\0A            break;\0A\0A#if defined(MBEDTLS_SSL_EARLY_DATA)\0A        case MBEDTLS_SSL_CLIENT_CCS_AFTER_CLIENT_HELLO:\0A            ret = mbedtls_ssl_tls13_write_change_cipher_spec(ssl);\0A            if (ret == 0) {\0A                mbedtls_ssl_handshake_set_state(ssl, MBEDTLS_SSL_SERVER_HELLO);\0A\0A                MBEDTLS_SSL_DEBUG_MSG(\0A                    1, (\22Switch to early data keys for outbound traffic\22));\0A                mbedtls_ssl_set_outbound_transform(\0A                    ssl, ssl->handshake->transform_earlydata);\0A                ssl->early_data_state = MBEDTLS_SSL_EARLY_DATA_STATE_CAN_WRITE;\0A            }\0A            break;\0A#endif /* MBEDTLS_SSL_EARLY_DATA */\0A#endif /* MBEDTLS_SSL_TLS1_3_COMPATIBILITY_MODE */\0A\0A#if defined(MBEDTLS_SSL_SESSION_TICKETS)\0A        case MBEDTLS_SSL_TLS1_3_NEW_SESSION_TICKET:\0A            ret = ssl_tls13_process_new_session_ticket(ssl);\0A            break;\0A#endif /* MBEDTLS_SSL_SESSION_TICKETS */\0A\0A        default:\0A            MBEDTLS_SSL_DEBUG_MSG(1, (\22invalid state %d\22, ssl->state));\0A            return MBEDTLS_ERR_SSL_BAD_INPUT_DATA;\0A    }\0A\0A    return ret;\0A}\0A\0A#endif /* MBEDTLS_SSL_CLI_C && MBEDTLS_SSL_PROTO_TLS1_3 */\0A\00" }
