@.str44964 = private global { i64, i64, [17389 x i8] } { i64 -1, i64 17388, [17389 x i8] c"/**\0A * \5Cfile platform.h\0A *\0A * \5Cbrief This file contains the definitions and functions of the\0A *        Mbed TLS platform abstraction layer.\0A *\0A *        The platform abstraction layer removes the need for the library\0A *        to directly link to standard C library functions or operating\0A *        system services, making the library easier to port and embed.\0A *        Application developers and users of the library can provide their own\0A *        implementations of these functions, or implementations specific to\0A *        their platform, which can be statically linked to the library or\0A *        dynamically configured at runtime.\0A *\0A *        When all compilation options related to platform abstraction are\0A *        disabled, this header just defines `mbedtls_xxx` function names\0A *        as aliases to the standard `xxx` function.\0A *\0A *        Most modules in the library and example programs are expected to\0A *        include this header.\0A */\0A/*\0A *  Copyright The Mbed TLS Contributors\0A *  SPDX-License-Identifier: Apache-2.0 OR GPL-2.0-or-later\0A */\0A#ifndef MBEDTLS_PLATFORM_H\0A#define MBEDTLS_PLATFORM_H\0A#include \22mbedtls/private_access.h\22\0A\0A#include \22mbedtls/build_info.h\22\0A\0A#if defined(MBEDTLS_HAVE_TIME)\0A#include \22mbedtls/platform_time.h\22\0A#endif\0A\0A#ifdef __cplusplus\0Aextern \22C\22 {\0A#endif\0A\0A/**\0A * \5Cname SECTION: Module settings\0A *\0A * The configuration options you can set for this module are in this section.\0A * Either change them in mbedtls_config.h or define them on the compiler command line.\0A * \5C{\0A */\0A\0A/* The older Microsoft Windows common runtime provides non-conforming\0A * implementations of some standard library functions, including snprintf\0A * and vsnprintf. This affects MSVC and MinGW builds.\0A */\0A#if defined(__MINGW32__) || (defined(_MSC_VER) && _MSC_VER <= 1900)\0A#define MBEDTLS_PLATFORM_HAS_NON_CONFORMING_SNPRINTF\0A#define MBEDTLS_PLATFORM_HAS_NON_CONFORMING_VSNPRINTF\0A#endif\0A\0A#if !defined(MBEDTLS_PLATFORM_NO_STD_FUNCTIONS)\0A#include <stdio.h>\0A#include <stdlib.h>\0A#if defined(MBEDTLS_HAVE_TIME)\0A#include <time.h>\0A#endif\0A#if !defined(MBEDTLS_PLATFORM_STD_SNPRINTF)\0A#if defined(MBEDTLS_PLATFORM_HAS_NON_CONFORMING_SNPRINTF)\0A#define MBEDTLS_PLATFORM_STD_SNPRINTF   mbedtls_platform_win32_snprintf /**< The default \5Cc snprintf function to use.  */\0A#else\0A#define MBEDTLS_PLATFORM_STD_SNPRINTF   snprintf /**< The default \5Cc snprintf function to use.  */\0A#endif\0A#endif\0A#if !defined(MBEDTLS_PLATFORM_STD_VSNPRINTF)\0A#if defined(MBEDTLS_PLATFORM_HAS_NON_CONFORMING_VSNPRINTF)\0A#define MBEDTLS_PLATFORM_STD_VSNPRINTF   mbedtls_platform_win32_vsnprintf /**< The default \5Cc vsnprintf function to use.  */\0A#else\0A#define MBEDTLS_PLATFORM_STD_VSNPRINTF   vsnprintf /**< The default \5Cc vsnprintf function to use.  */\0A#endif\0A#endif\0A#if !defined(MBEDTLS_PLATFORM_STD_PRINTF)\0A#define MBEDTLS_PLATFORM_STD_PRINTF   printf /**< The default \5Cc printf function to use. */\0A#endif\0A#if !defined(MBEDTLS_PLATFORM_STD_FPRINTF)\0A#define MBEDTLS_PLATFORM_STD_FPRINTF fprintf /**< The default \5Cc fprintf function to use. */\0A#endif\0A#if !defined(MBEDTLS_PLATFORM_STD_CALLOC)\0A#define MBEDTLS_PLATFORM_STD_CALLOC   calloc /**< The default \5Cc calloc function to use. */\0A#endif\0A#if !defined(MBEDTLS_PLATFORM_STD_FREE)\0A#define MBEDTLS_PLATFORM_STD_FREE       free /**< The default \5Cc free function to use. */\0A#endif\0A#if !defined(MBEDTLS_PLATFORM_STD_SETBUF)\0A#define MBEDTLS_PLATFORM_STD_SETBUF   setbuf /**< The default \5Cc setbuf function to use. */\0A#endif\0A#if !defined(MBEDTLS_PLATFORM_STD_EXIT)\0A#define MBEDTLS_PLATFORM_STD_EXIT      exit /**< The default \5Cc exit function to use. */\0A#endif\0A#if !defined(MBEDTLS_PLATFORM_STD_TIME)\0A#define MBEDTLS_PLATFORM_STD_TIME       time    /**< The default \5Cc time function to use. */\0A#endif\0A#if !defined(MBEDTLS_PLATFORM_STD_EXIT_SUCCESS)\0A#define MBEDTLS_PLATFORM_STD_EXIT_SUCCESS  EXIT_SUCCESS /**< The default exit value to use. */\0A#endif\0A#if !defined(MBEDTLS_PLATFORM_STD_EXIT_FAILURE)\0A#define MBEDTLS_PLATFORM_STD_EXIT_FAILURE  EXIT_FAILURE /**< The default exit value to use. */\0A#endif\0A#if defined(MBEDTLS_FS_IO)\0A#if !defined(MBEDTLS_PLATFORM_STD_NV_SEED_READ)\0A#define MBEDTLS_PLATFORM_STD_NV_SEED_READ   mbedtls_platform_std_nv_seed_read\0A#endif\0A#if !defined(MBEDTLS_PLATFORM_STD_NV_SEED_WRITE)\0A#define MBEDTLS_PLATFORM_STD_NV_SEED_WRITE  mbedtls_platform_std_nv_seed_write\0A#endif\0A#if !defined(MBEDTLS_PLATFORM_STD_NV_SEED_FILE)\0A#define MBEDTLS_PLATFORM_STD_NV_SEED_FILE   \22seedfile\22\0A#endif\0A#endif /* MBEDTLS_FS_IO */\0A#else /* MBEDTLS_PLATFORM_NO_STD_FUNCTIONS */\0A#if defined(MBEDTLS_PLATFORM_STD_MEM_HDR)\0A#include MBEDTLS_PLATFORM_STD_MEM_HDR\0A#endif\0A#endif /* MBEDTLS_PLATFORM_NO_STD_FUNCTIONS */\0A\0A/* Enable certain documented defines only when generating doxygen to avoid\0A * an \22unrecognized define\22 error. */\0A#if defined(__DOXYGEN__) && !defined(MBEDTLS_PLATFORM_STD_CALLOC)\0A#define MBEDTLS_PLATFORM_STD_CALLOC\0A#endif\0A\0A#if defined(__DOXYGEN__) && !defined(MBEDTLS_PLATFORM_STD_FREE)\0A#define MBEDTLS_PLATFORM_STD_FREE\0A#endif\0A\0A/** \5C} name SECTION: Module settings */\0A\0A/*\0A * The function pointers for calloc and free.\0A * Please see MBEDTLS_PLATFORM_STD_CALLOC and MBEDTLS_PLATFORM_STD_FREE\0A * in mbedtls_config.h for more information about behaviour and requirements.\0A */\0A#if defined(MBEDTLS_PLATFORM_MEMORY)\0A#if defined(MBEDTLS_PLATFORM_FREE_MACRO) && \5C\0A    defined(MBEDTLS_PLATFORM_CALLOC_MACRO)\0A#undef mbedtls_free\0A#undef mbedtls_calloc\0A#define mbedtls_free       MBEDTLS_PLATFORM_FREE_MACRO\0A#define mbedtls_calloc     MBEDTLS_PLATFORM_CALLOC_MACRO\0A#else\0A/* For size_t */\0A#include <stddef.h>\0Aextern void *mbedtls_calloc(size_t n, size_t size);\0Aextern void mbedtls_free(void *ptr);\0A\0A/**\0A * \5Cbrief               This function dynamically sets the memory-management\0A *                      functions used by the library, during runtime.\0A *\0A * \5Cparam calloc_func   The \5Cc calloc function implementation.\0A * \5Cparam free_func     The \5Cc free function implementation.\0A *\0A * \5Creturn              \5Cc 0.\0A */\0Aint mbedtls_platform_set_calloc_free(void *(*calloc_func)(size_t, size_t),\0A                                     void (*free_func)(void *));\0A#endif /* MBEDTLS_PLATFORM_FREE_MACRO && MBEDTLS_PLATFORM_CALLOC_MACRO */\0A#else /* !MBEDTLS_PLATFORM_MEMORY */\0A#undef mbedtls_free\0A#undef mbedtls_calloc\0A#define mbedtls_free       free\0A#define mbedtls_calloc     calloc\0A#endif /* MBEDTLS_PLATFORM_MEMORY && !MBEDTLS_PLATFORM_{FREE,CALLOC}_MACRO */\0A\0A/*\0A * The function pointers for fprintf\0A */\0A#if defined(MBEDTLS_PLATFORM_FPRINTF_ALT)\0A/* We need FILE * */\0A#include <stdio.h>\0Aextern int (*mbedtls_fprintf)(FILE *stream, const char *format, ...);\0A\0A/**\0A * \5Cbrief                This function dynamically configures the fprintf\0A *                       function that is called when the\0A *                       mbedtls_fprintf() function is invoked by the library.\0A *\0A * \5Cparam fprintf_func   The \5Cc fprintf function implementation.\0A *\0A * \5Creturn               \5Cc 0.\0A */\0Aint mbedtls_platform_set_fprintf(int (*fprintf_func)(FILE *stream, const char *,\0A                                                     ...));\0A#else\0A#undef mbedtls_fprintf\0A#if defined(MBEDTLS_PLATFORM_FPRINTF_MACRO)\0A#define mbedtls_fprintf    MBEDTLS_PLATFORM_FPRINTF_MACRO\0A#else\0A#define mbedtls_fprintf    fprintf\0A#endif /* MBEDTLS_PLATFORM_FPRINTF_MACRO */\0A#endif /* MBEDTLS_PLATFORM_FPRINTF_ALT */\0A\0A/*\0A * The function pointers for printf\0A */\0A#if defined(MBEDTLS_PLATFORM_PRINTF_ALT)\0Aextern int (*mbedtls_printf)(const char *format, ...);\0A\0A/**\0A * \5Cbrief               This function dynamically configures the snprintf\0A *                      function that is called when the mbedtls_snprintf()\0A *                      function is invoked by the library.\0A *\0A * \5Cparam printf_func   The \5Cc printf function implementation.\0A *\0A * \5Creturn              \5Cc 0 on success.\0A */\0Aint mbedtls_platform_set_printf(int (*printf_func)(const char *, ...));\0A#else /* !MBEDTLS_PLATFORM_PRINTF_ALT */\0A#undef mbedtls_printf\0A#if defined(MBEDTLS_PLATFORM_PRINTF_MACRO)\0A#define mbedtls_printf     MBEDTLS_PLATFORM_PRINTF_MACRO\0A#else\0A#define mbedtls_printf     printf\0A#endif /* MBEDTLS_PLATFORM_PRINTF_MACRO */\0A#endif /* MBEDTLS_PLATFORM_PRINTF_ALT */\0A\0A/*\0A * The function pointers for snprintf\0A *\0A * The snprintf implementation should conform to C99:\0A * - it *must* always correctly zero-terminate the buffer\0A *   (except when n == 0, then it must leave the buffer untouched)\0A * - however it is acceptable to return -1 instead of the required length when\0A *   the destination buffer is too short.\0A */\0A#if defined(MBEDTLS_PLATFORM_HAS_NON_CONFORMING_SNPRINTF)\0A/* For Windows (inc. MSYS2), we provide our own fixed implementation */\0Aint mbedtls_platform_win32_snprintf(char *s, size_t n, const char *fmt, ...);\0A#endif\0A\0A#if defined(MBEDTLS_PLATFORM_SNPRINTF_ALT)\0Aextern int (*mbedtls_snprintf)(char *s, size_t n, const char *format, ...);\0A\0A/**\0A * \5Cbrief                 This function allows configuring a custom\0A *                        \5Cc snprintf function pointer.\0A *\0A * \5Cparam snprintf_func   The \5Cc snprintf function implementation.\0A *\0A * \5Creturn                \5Cc 0 on success.\0A */\0Aint mbedtls_platform_set_snprintf(int (*snprintf_func)(char *s, size_t n,\0A                                                       const char *format, ...));\0A#else /* MBEDTLS_PLATFORM_SNPRINTF_ALT */\0A#undef mbedtls_snprintf\0A#if defined(MBEDTLS_PLATFORM_SNPRINTF_MACRO)\0A#define mbedtls_snprintf   MBEDTLS_PLATFORM_SNPRINTF_MACRO\0A#else\0A#define mbedtls_snprintf   MBEDTLS_PLATFORM_STD_SNPRINTF\0A#endif /* MBEDTLS_PLATFORM_SNPRINTF_MACRO */\0A#endif /* MBEDTLS_PLATFORM_SNPRINTF_ALT */\0A\0A/*\0A * The function pointers for vsnprintf\0A *\0A * The vsnprintf implementation should conform to C99:\0A * - it *must* always correctly zero-terminate the buffer\0A *   (except when n == 0, then it must leave the buffer untouched)\0A * - however it is acceptable to return -1 instead of the required length when\0A *   the destination buffer is too short.\0A */\0A#if defined(MBEDTLS_PLATFORM_HAS_NON_CONFORMING_VSNPRINTF)\0A#include <stdarg.h>\0A/* For Older Windows (inc. MSYS2), we provide our own fixed implementation */\0Aint mbedtls_platform_win32_vsnprintf(char *s, size_t n, const char *fmt, va_list arg);\0A#endif\0A\0A#if defined(MBEDTLS_PLATFORM_VSNPRINTF_ALT)\0A#include <stdarg.h>\0Aextern int (*mbedtls_vsnprintf)(char *s, size_t n, const char *format, va_list arg);\0A\0A/**\0A * \5Cbrief   Set your own snprintf function pointer\0A *\0A * \5Cparam   vsnprintf_func   The \5Cc vsnprintf function implementation\0A *\0A * \5Creturn  \5Cc 0\0A */\0Aint mbedtls_platform_set_vsnprintf(int (*vsnprintf_func)(char *s, size_t n,\0A                                                         const char *format, va_list arg));\0A#else /* MBEDTLS_PLATFORM_VSNPRINTF_ALT */\0A#undef mbedtls_vsnprintf\0A#if defined(MBEDTLS_PLATFORM_VSNPRINTF_MACRO)\0A#define mbedtls_vsnprintf   MBEDTLS_PLATFORM_VSNPRINTF_MACRO\0A#else\0A#define mbedtls_vsnprintf   vsnprintf\0A#endif /* MBEDTLS_PLATFORM_VSNPRINTF_MACRO */\0A#endif /* MBEDTLS_PLATFORM_VSNPRINTF_ALT */\0A\0A/*\0A * The function pointers for setbuf\0A */\0A#if defined(MBEDTLS_PLATFORM_SETBUF_ALT)\0A#include <stdio.h>\0A/**\0A * \5Cbrief                  Function pointer to call for `setbuf()` functionality\0A *                         (changing the internal buffering on stdio calls).\0A *\0A * \5Cnote                   The library calls this function to disable\0A *                         buffering when reading or writing sensitive data,\0A *                         to avoid having extra copies of sensitive data\0A *                         remaining in stdio buffers after the file is\0A *                         closed. If this is not a concern, for example if\0A *                         your platform's stdio doesn't have any buffering,\0A *                         you can set mbedtls_setbuf to a function that\0A *                         does nothing.\0A *\0A *                         The library always calls this function with\0A *                         `buf` equal to `NULL`.\0A */\0Aextern void (*mbedtls_setbuf)(FILE *stream, char *buf);\0A\0A/**\0A * \5Cbrief                  Dynamically configure the function that is called\0A *                         when the mbedtls_setbuf() function is called by the\0A *                         library.\0A *\0A * \5Cparam   setbuf_func   The \5Cc setbuf function implementation\0A *\0A * \5Creturn                 \5Cc 0\0A */\0Aint mbedtls_platform_set_setbuf(void (*setbuf_func)(\0A                                    FILE *stream, char *buf));\0A#else\0A#undef mbedtls_setbuf\0A#if defined(MBEDTLS_PLATFORM_SETBUF_MACRO)\0A/**\0A * \5Cbrief                  Macro defining the function for the library to\0A *                         call for `setbuf` functionality (changing the\0A *                         internal buffering on stdio calls).\0A *\0A * \5Cnote                   See extra comments on the mbedtls_setbuf() function\0A *                         pointer above.\0A *\0A * \5Creturn                 \5Cc 0 on success, negative on error.\0A */\0A#define mbedtls_setbuf    MBEDTLS_PLATFORM_SETBUF_MACRO\0A#else\0A#define mbedtls_setbuf    setbuf\0A#endif /* MBEDTLS_PLATFORM_SETBUF_MACRO */\0A#endif /* MBEDTLS_PLATFORM_SETBUF_ALT */\0A\0A/*\0A * The function pointers for exit\0A */\0A#if defined(MBEDTLS_PLATFORM_EXIT_ALT)\0Aextern void (*mbedtls_exit)(int status);\0A\0A/**\0A * \5Cbrief             This function dynamically configures the exit\0A *                    function that is called when the mbedtls_exit()\0A *                    function is invoked by the library.\0A *\0A * \5Cparam exit_func   The \5Cc exit function implementation.\0A *\0A * \5Creturn            \5Cc 0 on success.\0A */\0Aint mbedtls_platform_set_exit(void (*exit_func)(int status));\0A#else\0A#undef mbedtls_exit\0A#if defined(MBEDTLS_PLATFORM_EXIT_MACRO)\0A#define mbedtls_exit   MBEDTLS_PLATFORM_EXIT_MACRO\0A#else\0A#define mbedtls_exit   exit\0A#endif /* MBEDTLS_PLATFORM_EXIT_MACRO */\0A#endif /* MBEDTLS_PLATFORM_EXIT_ALT */\0A\0A/*\0A * The default exit values\0A */\0A#if defined(MBEDTLS_PLATFORM_STD_EXIT_SUCCESS)\0A#define MBEDTLS_EXIT_SUCCESS MBEDTLS_PLATFORM_STD_EXIT_SUCCESS\0A#else\0A#define MBEDTLS_EXIT_SUCCESS 0\0A#endif\0A#if defined(MBEDTLS_PLATFORM_STD_EXIT_FAILURE)\0A#define MBEDTLS_EXIT_FAILURE MBEDTLS_PLATFORM_STD_EXIT_FAILURE\0A#else\0A#define MBEDTLS_EXIT_FAILURE 1\0A#endif\0A\0A/*\0A * The function pointers for reading from and writing a seed file to\0A * Non-Volatile storage (NV) in a platform-independent way\0A *\0A * Only enabled when the NV seed entropy source is enabled\0A */\0A#if defined(MBEDTLS_ENTROPY_NV_SEED)\0A#if !defined(MBEDTLS_PLATFORM_NO_STD_FUNCTIONS) && defined(MBEDTLS_FS_IO)\0A/* Internal standard platform definitions */\0Aint mbedtls_platform_std_nv_seed_read(unsigned char *buf, size_t buf_len);\0Aint mbedtls_platform_std_nv_seed_write(unsigned char *buf, size_t buf_len);\0A#endif\0A\0A#if defined(MBEDTLS_PLATFORM_NV_SEED_ALT)\0Aextern int (*mbedtls_nv_seed_read)(unsigned char *buf, size_t buf_len);\0Aextern int (*mbedtls_nv_seed_write)(unsigned char *buf, size_t buf_len);\0A\0A/**\0A * \5Cbrief   This function allows configuring custom seed file writing and\0A *          reading functions.\0A *\0A * \5Cparam   nv_seed_read_func   The seed reading function implementation.\0A * \5Cparam   nv_seed_write_func  The seed writing function implementation.\0A *\0A * \5Creturn  \5Cc 0 on success.\0A */\0Aint mbedtls_platform_set_nv_seed(\0A    int (*nv_seed_read_func)(unsigned char *buf, size_t buf_len),\0A    int (*nv_seed_write_func)(unsigned char *buf, size_t buf_len)\0A    );\0A#else\0A#undef mbedtls_nv_seed_read\0A#undef mbedtls_nv_seed_write\0A#if defined(MBEDTLS_PLATFORM_NV_SEED_READ_MACRO) && \5C\0A    defined(MBEDTLS_PLATFORM_NV_SEED_WRITE_MACRO)\0A#define mbedtls_nv_seed_read    MBEDTLS_PLATFORM_NV_SEED_READ_MACRO\0A#define mbedtls_nv_seed_write   MBEDTLS_PLATFORM_NV_SEED_WRITE_MACRO\0A#else\0A#define mbedtls_nv_seed_read    mbedtls_platform_std_nv_seed_read\0A#define mbedtls_nv_seed_write   mbedtls_platform_std_nv_seed_write\0A#endif\0A#endif /* MBEDTLS_PLATFORM_NV_SEED_ALT */\0A#endif /* MBEDTLS_ENTROPY_NV_SEED */\0A\0A#if !defined(MBEDTLS_PLATFORM_SETUP_TEARDOWN_ALT)\0A\0A/**\0A * \5Cbrief   The platform context structure.\0A *\0A * \5Cnote    This structure may be used to assist platform-specific\0A *          setup or teardown operations.\0A */\0Atypedef struct mbedtls_platform_context {\0A    char MBEDTLS_PRIVATE(dummy); /**< A placeholder member, as empty structs are not portable. */\0A}\0Ambedtls_platform_context;\0A\0A#else\0A#include \22platform_alt.h\22\0A#endif /* !MBEDTLS_PLATFORM_SETUP_TEARDOWN_ALT */\0A\0A/**\0A * \5Cbrief   This function performs any platform-specific initialization\0A *          operations.\0A *\0A * \5Cnote    This function should be called before any other library functions.\0A *\0A *          Its implementation is platform-specific, and unless\0A *          platform-specific code is provided, it does nothing.\0A *\0A * \5Cnote    The usage and necessity of this function is dependent on the platform.\0A *\0A * \5Cparam   ctx     The platform context.\0A *\0A * \5Creturn  \5Cc 0 on success.\0A */\0Aint mbedtls_platform_setup(mbedtls_platform_context *ctx);\0A/**\0A * \5Cbrief   This function performs any platform teardown operations.\0A *\0A * \5Cnote    This function should be called after every other Mbed TLS module\0A *          has been correctly freed using the appropriate free function.\0A *\0A *          Its implementation is platform-specific, and unless\0A *          platform-specific code is provided, it does nothing.\0A *\0A * \5Cnote    The usage and necessity of this function is dependent on the platform.\0A *\0A * \5Cparam   ctx     The platform context.\0A *\0A */\0Avoid mbedtls_platform_teardown(mbedtls_platform_context *ctx);\0A\0A#ifdef __cplusplus\0A}\0A#endif\0A\0A#endif /* platform.h */\0A\00" }
