                     poly1305_key, poly1305_key);\0A    if (ret != 0) {\0A        goto cleanup;\0A    }\0A\0A    ret = mbedtls_poly1305_starts(&ctx->poly1305_ctx, poly1305_key);\0A\0A    if (ret == 0) {\0A        ctx->aad_len        = 0U;\0A        ctx->ciphertext_len = 0U;\0A        ctx->state          = CHACHAPOLY_STATE_AAD;\0A        ctx->mode           = mode;\0A    }\0A\0Acleanup:\0A    mbedtls_platform_zeroize(poly1305_key, 64U);\0A    return ret;\0A}\0A\0Aint mbedtls_chachapoly_update_aad(mbedtls_chachapoly_context *ctx,\0A                                  const unsigned char *aad,\0A                                  size_t aad_len)\0A{\0A    if (ctx->state != CHACHAPOLY_STATE_AAD) {\0A        return MBEDTLS_ERR_CHACHAPOLY_BAD_STATE;\0A    }\0A\0A    ctx->aad_len += aad_len;\0A\0A    return mbedtls_poly1305_update(&ctx->poly1305_ctx, aad, aad_len);\0A}\0A\0Aint mbedtls_chachapoly_update(mbedtls_chachapoly_context *ctx,\0A                              size_t len,\0A                              const unsigned char *input,\0A                              unsigned char *output)\0A{\0A    int ret = MBEDTLS_ERR_ERROR_CORRUPTION_DETECTED;\0A\0A    if ((ctx->state != CHACHAPOLY_STATE_AAD) &&\0A        (ctx->state != CHACHAPOLY_STATE_CIPHERTEXT)) {\0A        return MBEDTLS_ERR_CHACHAPOLY_BAD_STATE;\0A    }\0A\0A    if (ctx->state == CHACHAPOLY_STATE_AAD) {\0A        ctx->state = CHACHAPOLY_STATE_CIPHERTEXT;\0A\0A        ret = chachapoly_pad_aad(ctx);\0A        if (ret != 0) {\0A            return ret;\0A        }\0A    }\0A\0A    ctx->ciphertext_len += len;\0A\0A    if (ctx->mode == MBEDTLS_CHACHAPOLY_ENCRYPT) {\0A        ret = mbedtls_chacha20_update(&ctx->chacha20_ctx, len, input, output);\0A        if (ret != 0) {\0A            return ret;\0A        }\0A\0A        ret = mbedtls_poly1305_update(&ctx->poly1305_ctx, output, len);\0A        if (ret != 0) {\0A            return ret;\0A        }\0A    } else { /* DECRYPT */\0A        ret = mbedtls_poly1305_update(&ctx->