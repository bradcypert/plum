@.str41852 = private global { i64, i64, [15043 x i8] } { i64 -1, i64 15042, [15043 x i8] c"/*\0A *  PSA hashing layer on top of Mbed TLS software crypto\0A */\0A/*\0A *  Copyright The Mbed TLS Contributors\0A *  SPDX-License-Identifier: Apache-2.0 OR GPL-2.0-or-later\0A */\0A\0A#include \22common.h\22\0A\0A#if defined(MBEDTLS_PSA_CRYPTO_C)\0A\0A#include <psa/crypto.h>\0A#include \22psa_crypto_core.h\22\0A#include \22psa_crypto_hash.h\22\0A\0A#include <mbedtls/error.h>\0A#include <string.h>\0A\0A#if defined(MBEDTLS_PSA_BUILTIN_HASH)\0Apsa_status_t mbedtls_psa_hash_abort(\0A    mbedtls_psa_hash_operation_t *operation)\0A{\0A    switch (operation->alg) {\0A        case 0:\0A            /* The object has (apparently) been initialized but it is not\0A             * in use. It's ok to call abort on such an object, and there's\0A             * nothing to do. */\0A            break;\0A#if defined(MBEDTLS_PSA_BUILTIN_ALG_MD5)\0A        case PSA_ALG_MD5:\0A            mbedtls_md5_free(&operation->ctx.md5);\0A            break;\0A#endif\0A#if defined(MBEDTLS_PSA_BUILTIN_ALG_RIPEMD160)\0A        case PSA_ALG_RIPEMD160:\0A            mbedtls_ripemd160_free(&operation->ctx.ripemd160);\0A            break;\0A#endif\0A#if defined(MBEDTLS_PSA_BUILTIN_ALG_SHA_1)\0A        case PSA_ALG_SHA_1:\0A            mbedtls_sha1_free(&operation->ctx.sha1);\0A            break;\0A#endif\0A#if defined(MBEDTLS_PSA_BUILTIN_ALG_SHA_224)\0A        case PSA_ALG_SHA_224:\0A            mbedtls_sha256_free(&operation->ctx.sha256);\0A            break;\0A#endif\0A#if defined(MBEDTLS_PSA_BUILTIN_ALG_SHA_256)\0A        case PSA_ALG_SHA_256:\0A            mbedtls_sha256_free(&operation->ctx.sha256);\0A            break;\0A#endif\0A#if defined(MBEDTLS_PSA_BUILTIN_ALG_SHA_384)\0A        case PSA_ALG_SHA_384:\0A            mbedtls_sha512_free(&operation->ctx.sha512);\0A            break;\0A#endif\0A#if defined(MBEDTLS_PSA_BUILTIN_ALG_SHA_512)\0A        case PSA_ALG_SHA_512:\0A            mbedtls_sha512_free(&operation->ctx.sha512);\0A            break;\0A#endif\0A#if defined(MBEDTLS_PSA_BUILTIN_ALG_SHA3_224)\0A        case PSA_ALG_SHA3_224:\0A#endif\0A#if defined(MBEDTLS_PSA_BUILTIN_ALG_SHA3_256)\0A        case PSA_ALG_SHA3_256:\0A#endif\0A#if defined(MBEDTLS_PSA_BUILTIN_ALG_SHA3_384)\0A        case PSA_ALG_SHA3_384:\0A#endif\0A#if defined(MBEDTLS_PSA_BUILTIN_ALG_SHA3_512)\0A        case PSA_ALG_SHA3_512:\0A#endif\0A#if defined(MBEDTLS_PSA_BUILTIN_ALG_SHA3_224) || \5C\0A            defined(MBEDTLS_PSA_BUILTIN_ALG_SHA3_256) || \5C\0A            defined(MBEDTLS_PSA_BUILTIN_ALG_SHA3_384) || \5C\0A            defined(MBEDTLS_PSA_BUILTIN_ALG_SHA3_512)\0A            mbedtls_sha3_free(&operation->ctx.sha3);\0A            break;\0A#endif\0A        default:\0A            return PSA_ERROR_BAD_STATE;\0A    }\0A    operation->alg = 0;\0A    return PSA_SUCCESS;\0A}\0A\0Apsa_status_t mbedtls_psa_hash_setup(\0A    mbedtls_psa_hash_operation_t *operation,\0A    psa_algorithm_t alg)\0A{\0A    int ret = MBEDTLS_ERR_ERROR_CORRUPTION_DETECTED;\0A\0A    /* A context must be freshly initialized before it can be set up. */\0A    if (operation->alg != 0) {\0A        return PSA_ERROR_BAD_STATE;\0A    }\0A\0A    switch (alg) {\0A#if defined(MBEDTLS_PSA_BUILTIN_ALG_MD5)\0A        case PSA_ALG_MD5:\0A            mbedtls_md5_init(&operation->ctx.md5);\0A            ret = mbedtls_md5_starts(&operation->ctx.md5);\0A            break;\0A#endif\0A#if defined(MBEDTLS_PSA_BUILTIN_ALG_RIPEMD160)\0A        case PSA_ALG_RIPEMD160:\0A            mbedtls_ripemd160_init(&operation->ctx.ripemd160);\0A            ret = mbedtls_ripemd160_starts(&operation->ctx.ripemd160);\0A            break;\0A#endif\0A#if defined(MBEDTLS_PSA_BUILTIN_ALG_SHA_1)\0A        case PSA_ALG_SHA_1:\0A            mbedtls_sha1_init(&operation->ctx.sha1);\0A            ret = mbedtls_sha1_starts(&operation->ctx.sha1);\0A            break;\0A#endif\0A#if defined(MBEDTLS_PSA_BUILTIN_ALG_SHA_224)\0A        case PSA_ALG_SHA_224:\0A            mbedtls_sha256_init(&operation->ctx.sha256);\0A            ret = mbedtls_sha256_starts(&operation->ctx.sha256, 1);\0A            break;\0A#endif\0A#if defined(MBEDTLS_PSA_BUILTIN_ALG_SHA_256)\0A        case PSA_ALG_SHA_256:\0A            mbedtls_sha256_init(&operation->ctx.sha256);\0A            ret = mbedtls_sha256_starts(&operation->ctx.sha256, 0);\0A            break;\0A#endif\0A#if defined(MBEDTLS_PSA_BUILTIN_ALG_SHA_384)\0A        case PSA_ALG_SHA_384:\0A            mbedtls_sha512_init(&operation->ctx.sha512);\0A            ret = mbedtls_sha512_starts(&operation->ctx.sha512, 1);\0A            break;\0A#endif\0A#if defined(MBEDTLS_PSA_BUILTIN_ALG_SHA_512)\0A        case PSA_ALG_SHA_512:\0A            mbedtls_sha512_init(&operation->ctx.sha512);\0A            ret = mbedtls_sha512_starts(&operation->ctx.sha512, 0);\0A            break;\0A#endif\0A#if defined(MBEDTLS_PSA_BUILTIN_ALG_SHA3_224)\0A        case PSA_ALG_SHA3_224:\0A            mbedtls_sha3_init(&operation->ctx.sha3);\0A            ret = mbedtls_sha3_starts(&operation->ctx.sha3, MBEDTLS_SHA3_224);\0A            break;\0A#endif\0A#if defined(MBEDTLS_PSA_BUILTIN_ALG_SHA3_256)\0A        case PSA_ALG_SHA3_256:\0A            mbedtls_sha3_init(&operation->ctx.sha3);\0A            ret = mbedtls_sha3_starts(&operation->ctx.sha3, MBEDTLS_SHA3_256);\0A            break;\0A#endif\0A#if defined(MBEDTLS_PSA_BUILTIN_ALG_SHA3_384)\0A        case PSA_ALG_SHA3_384:\0A            mbedtls_sha3_init(&operation->ctx.sha3);\0A            ret = mbedtls_sha3_starts(&operation->ctx.sha3, MBEDTLS_SHA3_384);\0A            break;\0A#endif\0A#if defined(MBEDTLS_PSA_BUILTIN_ALG_SHA3_512)\0A        case PSA_ALG_SHA3_512:\0A            mbedtls_sha3_init(&operation->ctx.sha3);\0A            ret = mbedtls_sha3_starts(&operation->ctx.sha3, MBEDTLS_SHA3_512);\0A            break;\0A#endif\0A        default:\0A            return PSA_ALG_IS_HASH(alg) ?\0A                   PSA_ERROR_NOT_SUPPORTED :\0A                   PSA_ERROR_INVALID_ARGUMENT;\0A    }\0A    if (ret == 0) {\0A        operation->alg = alg;\0A    } else {\0A        mbedtls_psa_hash_abort(operation);\0A    }\0A    return mbedtls_to_psa_error(ret);\0A}\0A\0Apsa_status_t mbedtls_psa_hash_clone(\0A    const mbedtls_psa_hash_operation_t *source_operation,\0A    mbedtls_psa_hash_operation_t *target_operation)\0A{\0A    switch (source_operation->alg) {\0A        case 0:\0A            return PSA_ERROR_BAD_STATE;\0A#if defined(MBEDTLS_PSA_BUILTIN_ALG_MD5)\0A        case PSA_ALG_MD5:\0A            mbedtls_md5_clone(&target_operation->ctx.md5,\0A                              &source_operation->ctx.md5);\0A            break;\0A#endif\0A#if defined(MBEDTLS_PSA_BUILTIN_ALG_RIPEMD160)\0A        case PSA_ALG_RIPEMD160:\0A            mbedtls_ripemd160_clone(&target_operation->ctx.ripemd160,\0A                                    &source_operation->ctx.ripemd160);\0A            break;\0A#endif\0A#if defined(MBEDTLS_PSA_BUILTIN_ALG_SHA_1)\0A        case PSA_ALG_SHA_1:\0A            mbedtls_sha1_clone(&target_operation->ctx.sha1,\0A                               &source_operation->ctx.sha1);\0A            break;\0A#endif\0A#if defined(MBEDTLS_PSA_BUILTIN_ALG_SHA_224)\0A        case PSA_ALG_SHA_224:\0A            mbedtls_sha256_clone(&target_operation->ctx.sha256,\0A                                 &source_operation->ctx.sha256);\0A            break;\0A#endif\0A#if defined(MBEDTLS_PSA_BUILTIN_ALG_SHA_256)\0A        case PSA_ALG_SHA_256:\0A            mbedtls_sha256_clone(&target_operation->ctx.sha256,\0A                                 &source_operation->ctx.sha256);\0A            break;\0A#endif\0A#if defined(MBEDTLS_PSA_BUILTIN_ALG_SHA_384)\0A        case PSA_ALG_SHA_384:\0A            mbedtls_sha512_clone(&target_operation->ctx.sha512,\0A                                 &source_operation->ctx.sha512);\0A            break;\0A#endif\0A#if defined(MBEDTLS_PSA_BUILTIN_ALG_SHA_512)\0A        case PSA_ALG_SHA_512:\0A            mbedtls_sha512_clone(&target_operation->ctx.sha512,\0A                                 &source_operation->ctx.sha512);\0A            break;\0A#endif\0A#if defined(MBEDTLS_PSA_BUILTIN_ALG_SHA3_224)\0A        case PSA_ALG_SHA3_224:\0A#endif\0A#if defined(MBEDTLS_PSA_BUILTIN_ALG_SHA3_256)\0A        case PSA_ALG_SHA3_256:\0A#endif\0A#if defined(MBEDTLS_PSA_BUILTIN_ALG_SHA3_384)\0A        case PSA_ALG_SHA3_384:\0A#endif\0A#if defined(MBEDTLS_PSA_BUILTIN_ALG_SHA3_512)\0A        case PSA_ALG_SHA3_512:\0A#endif\0A#if defined(MBEDTLS_PSA_BUILTIN_ALG_SHA3_224) || \5C\0A            defined(MBEDTLS_PSA_BUILTIN_ALG_SHA3_256) || \5C\0A            defined(MBEDTLS_PSA_BUILTIN_ALG_SHA3_384) || \5C\0A            defined(MBEDTLS_PSA_BUILTIN_ALG_SHA3_512)\0A            mbedtls_sha3_clone(&target_operation->ctx.sha3,\0A                               &source_operation->ctx.sha3);\0A            break;\0A#endif\0A        default:\0A            (void) source_operation;\0A            (void) target_operation;\0A            return PSA_ERROR_NOT_SUPPORTED;\0A    }\0A\0A    target_operation->alg = source_operation->alg;\0A    return PSA_SUCCESS;\0A}\0A\0Apsa_status_t mbedtls_psa_hash_update(\0A    mbedtls_psa_hash_operation_t *operation,\0A    const uint8_t *input,\0A    size_t input_length)\0A{\0A    int ret = MBEDTLS_ERR_ERROR_CORRUPTION_DETECTED;\0A\0A    switch (operation->alg) {\0A#if defined(MBEDTLS_PSA_BUILTIN_ALG_MD5)\0A        case PSA_ALG_MD5:\0A            ret = mbedtls_md5_update(&operation->ctx.md5,\0A                                     input, input_length);\0A            break;\0A#endif\0A#if defined(MBEDTLS_PSA_BUILTIN_ALG_RIPEMD160)\0A        case PSA_ALG_RIPEMD160:\0A            ret = mbedtls_ripemd160_update(&operation->ctx.ripemd160,\0A                                           input, input_length);\0A            break;\0A#endif\0A#if defined(MBEDTLS_PSA_BUILTIN_ALG_SHA_1)\0A        case PSA_ALG_SHA_1:\0A            ret = mbedtls_sha1_update(&operation->ctx.sha1,\0A                                      input, input_length);\0A            break;\0A#endif\0A#if defined(MBEDTLS_PSA_BUILTIN_ALG_SHA_224)\0A        case PSA_ALG_SHA_224:\0A            ret = mbedtls_sha256_update(&operation->ctx.sha256,\0A                                        input, input_length);\0A            break;\0A#endif\0A#if defined(MBEDTLS_PSA_BUILTIN_ALG_SHA_256)\0A        case PSA_ALG_SHA_256:\0A            ret = mbedtls_sha256_update(&operation->ctx.sha256,\0A                                        input, input_length);\0A            break;\0A#endif\0A#if defined(MBEDTLS_PSA_BUILTIN_ALG_SHA_384)\0A        case PSA_ALG_SHA_384:\0A            ret = mbedtls_sha512_update(&operation->ctx.sha512,\0A                                        input, input_length);\0A            break;\0A#endif\0A#if defined(MBEDTLS_PSA_BUILTIN_ALG_SHA_512)\0A        case PSA_ALG_SHA_512:\0A            ret = mbedtls_sha512_update(&operation->ctx.sha512,\0A                                        input, input_length);\0A            break;\0A#endif\0A#if defined(MBEDTLS_PSA_BUILTIN_ALG_SHA3_224)\0A        case PSA_ALG_SHA3_224:\0A#endif\0A#if defined(MBEDTLS_PSA_BUILTIN_ALG_SHA3_256)\0A        case PSA_ALG_SHA3_256:\0A#endif\0A#if defined(MBEDTLS_PSA_BUILTIN_ALG_SHA3_384)\0A        case PSA_ALG_SHA3_384:\0A#endif\0A#if defined(MBEDTLS_PSA_BUILTIN_ALG_SHA3_512)\0A        case PSA_ALG_SHA3_512:\0A#endif\0A#if defined(MBEDTLS_PSA_BUILTIN_ALG_SHA3_224) || \5C\0A    defined(MBEDTLS_PSA_BUILTIN_ALG_SHA3_256) || \5C\0A    defined(MBEDTLS_PSA_BUILTIN_ALG_SHA3_384) || \5C\0A    defined(MBEDTLS_PSA_BUILTIN_ALG_SHA3_512)\0A    ret = mbedtls_sha3_update(&operation->ctx.sha3,\0A                              input, input_length);\0A    break;\0A#endif\0A        default:\0A            (void) input;\0A            (void) input_length;\0A            return PSA_ERROR_BAD_STATE;\0A    }\0A\0A    return mbedtls_to_psa_error(ret);\0A}\0A\0Apsa_status_t mbedtls_psa_hash_finish(\0A    mbedtls_psa_hash_operation_t *operation,\0A    uint8_t *hash,\0A    size_t hash_size,\0A    size_t *hash_length)\0A{\0A    psa_status_t status;\0A    int ret = MBEDTLS_ERR_ERROR_CORRUPTION_DETECTED;\0A    size_t actual_hash_length = PSA_HASH_LENGTH(operation->alg);\0A\0A    /* Fill the output buffer with something that isn't a valid hash\0A     * (barring an attack on the hash and deliberately-crafted input),\0A     * in case the caller doesn't check the return status properly. */\0A    *hash_length = hash_size;\0A    /* If hash_size is 0 then hash may be NULL and then the\0A     * call to memset would have undefined behavior. */\0A    if (hash_size != 0) {\0A        memset(hash, '!', hash_size);\0A    }\0A\0A    if (hash_size < actual_hash_length) {\0A        status = PSA_ERROR_BUFFER_TOO_SMALL;\0A        goto exit;\0A    }\0A\0A    switch (operation->alg) {\0A#if defined(MBEDTLS_PSA_BUILTIN_ALG_MD5)\0A        case PSA_ALG_MD5:\0A            ret = mbedtls_md5_finish(&operation->ctx.md5, hash);\0A            break;\0A#endif\0A#if defined(MBEDTLS_PSA_BUILTIN_ALG_RIPEMD160)\0A        case PSA_ALG_RIPEMD160:\0A            ret = mbedtls_ripemd160_finish(&operation->ctx.ripemd160, hash);\0A            break;\0A#endif\0A#if defined(MBEDTLS_PSA_BUILTIN_ALG_SHA_1)\0A        case PSA_ALG_SHA_1:\0A            ret = mbedtls_sha1_finish(&operation->ctx.sha1, hash);\0A            break;\0A#endif\0A#if defined(MBEDTLS_PSA_BUILTIN_ALG_SHA_224)\0A        case PSA_ALG_SHA_224:\0A            ret = mbedtls_sha256_finish(&operation->ctx.sha256, hash);\0A            break;\0A#endif\0A#if defined(MBEDTLS_PSA_BUILTIN_ALG_SHA_256)\0A        case PSA_ALG_SHA_256:\0A            ret = mbedtls_sha256_finish(&operation->ctx.sha256, hash);\0A            break;\0A#endif\0A#if defined(MBEDTLS_PSA_BUILTIN_ALG_SHA_384)\0A        case PSA_ALG_SHA_384:\0A            ret = mbedtls_sha512_finish(&operation->ctx.sha512, hash);\0A            break;\0A#endif\0A#if defined(MBEDTLS_PSA_BUILTIN_ALG_SHA_512)\0A        case PSA_ALG_SHA_512:\0A            ret = mbedtls_sha512_finish(&operation->ctx.sha512, hash);\0A            break;\0A#endif\0A#if defined(MBEDTLS_PSA_BUILTIN_ALG_SHA3_224)\0A        case PSA_ALG_SHA3_224:\0A#endif\0A#if defined(MBEDTLS_PSA_BUILTIN_ALG_SHA3_256)\0A        case PSA_ALG_SHA3_256:\0A#endif\0A#if defined(MBEDTLS_PSA_BUILTIN_ALG_SHA3_384)\0A        case PSA_ALG_SHA3_384:\0A#endif\0A#if defined(MBEDTLS_PSA_BUILTIN_ALG_SHA3_512)\0A        case PSA_ALG_SHA3_512:\0A#endif\0A#if defined(MBEDTLS_PSA_BUILTIN_ALG_SHA3_224) || \5C\0A    defined(MBEDTLS_PSA_BUILTIN_ALG_SHA3_256) || \5C\0A    defined(MBEDTLS_PSA_BUILTIN_ALG_SHA3_384) || \5C\0A    defined(MBEDTLS_PSA_BUILTIN_ALG_SHA3_512)\0A    ret = mbedtls_sha3_finish(&operation->ctx.sha3, hash, hash_size);\0A    break;\0A#endif\0A        default:\0A            (void) hash;\0A            return PSA_ERROR_BAD_STATE;\0A    }\0A    status = mbedtls_to_psa_error(ret);\0A\0Aexit:\0A    if (status == PSA_SUCCESS) {\0A        *hash_length = actual_hash_length;\0A    }\0A    return status;\0A}\0A\0Apsa_status_t mbedtls_psa_hash_compute(\0A    psa_algorithm_t alg,\0A    const uint8_t *input,\0A    size_t input_length,\0A    uint8_t *hash,\0A    size_t hash_size,\0A    size_t *hash_length)\0A{\0A    mbedtls_psa_hash_operation_t operation = MBEDTLS_PSA_HASH_OPERATION_INIT;\0A    psa_status_t status = PSA_ERROR_CORRUPTION_DETECTED;\0A    psa_status_t abort_status = PSA_ERROR_CORRUPTION_DETECTED;\0A\0A    *hash_length = hash_size;\0A    status = mbedtls_psa_hash_setup(&operation, alg);\0A    if (status != PSA_SUCCESS) {\0A        goto exit;\0A    }\0A    status = mbedtls_psa_hash_update(&operation, input, input_length);\0A    if (status != PSA_SUCCESS) {\0A        goto exit;\0A    }\0A    status = mbedtls_psa_hash_finish(&operation, hash, hash_size, hash_length);\0A    if (status != PSA_SUCCESS) {\0A        goto exit;\0A    }\0A\0Aexit:\0A    abort_status = mbedtls_psa_hash_abort(&operation);\0A    if (status == PSA_SUCCESS) {\0A        return abort_status;\0A    } else {\0A        return status;\0A    }\0A\0A}\0A#endif /* MBEDTLS_PSA_BUILTIN_HASH */\0A\0A#endif /* MBEDTLS_PSA_CRYPTO_C */\0A\00" }
