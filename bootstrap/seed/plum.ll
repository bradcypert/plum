exists(path: CStr) -> Int;\0A}\0A\0A/// No `exists` field: a path that is not there is an `Err`, so a\0A/// `Metadata` in hand always describes something real. That is the\0A/// contract `is_directory` already set, and having one of these\0A/// answer `exists: false` while the other errored would be two\0A/// answers to one question.\0Apub struct Metadata { pub is_directory: Bool, pub size: Int, pub mtime: Int }\0A\0A/// Three-way underneath, and the third case is why this returns a\0A/// `Result` rather than a `Bool`: \22does this exist\22 and \22can I see\0A/// whether this exists\22 are different questions. A permission error\0A/// is an `Err`, not a silent `Ok(false)`.\0A///\0A/// This is the ONE function here where a missing path is `Ok`, and\0A/// deliberately so; it is the function whose whole job is to say\0A/// so.\0Apub let exists (path: String): Result[Bool, String] = unsafe {\0A    let r = os_path_exists(path.as_cstr());\0A    if r < 0 { Err(\22Os.exists: cannot determine whether \22.concat(path).concat(\22 exists\22)) }\0A    else { Ok(r == 1) }\0A}\0A\0A/// A missing path is an `Err`, matching `is_directory`.\0Apub let stat (path: String): Result[Metadata, String] = unsafe {\0A    if os_stat_load(path.as_cstr()) != 0 { Err(\22Os.stat: cannot stat \22.concat(path)) }\0A    else { Ok(Metadata { is_directory: os_stat_is_dir() == 1, size: os_stat_size(), mtime: os_stat_mtime() }) }\0A}\0A\0A/// Bytes. Meaningful for a regular file; for a directory it is\0A/// whatever the filesystem records for the directory itself, which\0A/// is not the size of its contents.\0Apub let file_size (path: String): Result[Int, String] = Result.map(stat(path), |m| m.size)\0A\0A/// Seconds since the Unix epoch, the same unit as `Time.now()`, so\0A/// the two can be compared without a conversion.\0Apub let mtime (path: String): Result[Int, String] = Result.map(stat(path), |m| m.mtime)\0A\0A// --- Directory access ---\0A//\0A// `is_directory`'s three-way result is deliberate: a p