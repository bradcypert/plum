@.str46682 = private global { i64, i64, [57492 x i8] } { i64 -1, i64 57491, [57492 x i8] c"/*\0A *  X.509 common functions for parsing and verification\0A *\0A *  Copyright The Mbed TLS Contributors\0A *  SPDX-License-Identifier: Apache-2.0 OR GPL-2.0-or-later\0A */\0A/*\0A *  The ITU-T X.509 standard defines a certificate format for PKI.\0A *\0A *  http://www.ietf.org/rfc/rfc5280.txt (Certificates and CRLs)\0A *  http://www.ietf.org/rfc/rfc3279.txt (Alg IDs for CRLs)\0A *  http://www.ietf.org/rfc/rfc2986.txt (CSRs, aka PKCS#10)\0A *\0A *  http://www.itu.int/ITU-T/studygroups/com17/languages/X.680-0207.pdf\0A *  http://www.itu.int/ITU-T/studygroups/com17/languages/X.690-0207.pdf\0A */\0A\0A#include \22common.h\22\0A\0A#if defined(MBEDTLS_X509_USE_C)\0A\0A#include \22x509_internal.h\22\0A#include \22mbedtls/asn1.h\22\0A#include \22mbedtls/error.h\22\0A#include \22mbedtls/oid.h\22\0A\0A#include <stdio.h>\0A#include <string.h>\0A\0A#if defined(MBEDTLS_PEM_PARSE_C)\0A#include \22mbedtls/pem.h\22\0A#endif\0A\0A#include \22mbedtls/asn1write.h\22\0A\0A#include \22mbedtls/platform.h\22\0A\0A#if defined(MBEDTLS_HAVE_TIME)\0A#include \22mbedtls/platform_time.h\22\0A#endif\0A#if defined(MBEDTLS_HAVE_TIME_DATE)\0A#include \22mbedtls/platform_util.h\22\0A#include <time.h>\0A#endif\0A\0A#define CHECK(code)                                     \5C\0A    do {                                                \5C\0A        if ((ret = (code)) != 0) {                      \5C\0A            return ret;                                 \5C\0A        }                                               \5C\0A    } while (0)\0A\0A#define CHECK_RANGE(min, max, val)                      \5C\0A    do {                                                \5C\0A        if ((val) < (min) || (val) > (max)) {           \5C\0A            return ret;                                 \5C\0A        }                                               \5C\0A    } while (0)\0A\0A/*\0A *  CertificateSerialNumber  ::=  INTEGER\0A */\0Aint mbedtls_x509_get_serial(unsigned char **p, const unsigned char *end,\0A                            mbedtls_x509_buf *serial)\0A{\0A    int ret = MBEDTLS_ERR_ERROR_CORRUPTION_DETECTED;\0A\0A    if ((end - *p) < 1) {\0A        return MBEDTLS_ERROR_ADD(MBEDTLS_ERR_X509_INVALID_SERIAL,\0A                                 MBEDTLS_ERR_ASN1_OUT_OF_DATA);\0A    }\0A\0A    if (**p != (MBEDTLS_ASN1_CONTEXT_SPECIFIC | MBEDTLS_ASN1_PRIMITIVE | 2) &&\0A        **p !=   MBEDTLS_ASN1_INTEGER) {\0A        return MBEDTLS_ERROR_ADD(MBEDTLS_ERR_X509_INVALID_SERIAL,\0A                                 MBEDTLS_ERR_ASN1_UNEXPECTED_TAG);\0A    }\0A\0A    serial->tag = *(*p)++;\0A\0A    if ((ret = mbedtls_asn1_get_len(p, end, &serial->len)) != 0) {\0A        return MBEDTLS_ERROR_ADD(MBEDTLS_ERR_X509_INVALID_SERIAL, ret);\0A    }\0A\0A    serial->p = *p;\0A    *p += serial->len;\0A\0A    return 0;\0A}\0A\0A/* Get an algorithm identifier without parameters (eg for signatures)\0A *\0A *  AlgorithmIdentifier  ::=  SEQUENCE  {\0A *       algorithm               OBJECT IDENTIFIER,\0A *       parameters              ANY DEFINED BY algorithm OPTIONAL  }\0A */\0Aint mbedtls_x509_get_alg_null(unsigned char **p, const unsigned char *end,\0A                              mbedtls_x509_buf *alg)\0A{\0A    int ret = MBEDTLS_ERR_ERROR_CORRUPTION_DETECTED;\0A\0A    if ((ret = mbedtls_asn1_get_alg_null(p, end, alg)) != 0) {\0A        return MBEDTLS_ERROR_ADD(MBEDTLS_ERR_X509_INVALID_ALG, ret);\0A    }\0A\0A    return 0;\0A}\0A\0A/*\0A * Parse an algorithm identifier with (optional) parameters\0A */\0Aint mbedtls_x509_get_alg(unsigned char **p, const unsigned char *end,\0A                         mbedtls_x509_buf *alg, mbedtls_x509_buf *params)\0A{\0A    int ret = MBEDTLS_ERR_ERROR_CORRUPTION_DETECTED;\0A\0A    if ((ret = mbedtls_asn1_get_alg(p, end, alg, params)) != 0) {\0A        return MBEDTLS_ERROR_ADD(MBEDTLS_ERR_X509_INVALID_ALG, ret);\0A    }\0A\0A    return 0;\0A}\0A\0A/*\0A * Convert md type to string\0A */\0A#if !defined(MBEDTLS_X509_REMOVE_INFO) && defined(MBEDTLS_X509_RSASSA_PSS_SUPPORT)\0A\0Astatic inline const char *md_type_to_string(mbedtls_md_type_t md_alg)\0A{\0A    switch (md_alg) {\0A#if defined(MBEDTLS_MD_CAN_MD5)\0A        case MBEDTLS_MD_MD5:\0A            return \22MD5\22;\0A#endif\0A#if defined(MBEDTLS_MD_CAN_SHA1)\0A        case MBEDTLS_MD_SHA1:\0A            return \22SHA1\22;\0A#endif\0A#if defined(MBEDTLS_MD_CAN_SHA224)\0A        case MBEDTLS_MD_SHA224:\0A            return \22SHA224\22;\0A#endif\0A#if defined(MBEDTLS_MD_CAN_SHA256)\0A        case MBEDTLS_MD_SHA256:\0A            return \22SHA256\22;\0A#endif\0A#if defined(MBEDTLS_MD_CAN_SHA384)\0A        case MBEDTLS_MD_SHA384:\0A            return \22SHA384\22;\0A#endif\0A#if defined(MBEDTLS_MD_CAN_SHA512)\0A        case MBEDTLS_MD_SHA512:\0A            return \22SHA512\22;\0A#endif\0A#if defined(MBEDTLS_MD_CAN_RIPEMD160)\0A        case MBEDTLS_MD_RIPEMD160:\0A            return \22RIPEMD160\22;\0A#endif\0A        case MBEDTLS_MD_NONE:\0A            return NULL;\0A        default:\0A            return NULL;\0A    }\0A}\0A\0A#endif /* !defined(MBEDTLS_X509_REMOVE_INFO) && defined(MBEDTLS_X509_RSASSA_PSS_SUPPORT) */\0A\0A#if defined(MBEDTLS_X509_RSASSA_PSS_SUPPORT)\0A/*\0A * HashAlgorithm ::= AlgorithmIdentifier\0A *\0A * AlgorithmIdentifier  ::=  SEQUENCE  {\0A *      algorithm               OBJECT IDENTIFIER,\0A *      parameters              ANY DEFINED BY algorithm OPTIONAL  }\0A *\0A * For HashAlgorithm, parameters MUST be NULL or absent.\0A */\0Astatic int x509_get_hash_alg(const mbedtls_x509_buf *alg, mbedtls_md_type_t *md_alg)\0A{\0A    int ret = MBEDTLS_ERR_ERROR_CORRUPTION_DETECTED;\0A    unsigned char *p;\0A    const unsigned char *end;\0A    mbedtls_x509_buf md_oid;\0A    size_t len;\0A\0A    /* Make sure we got a SEQUENCE and setup bounds */\0A    if (alg->tag != (MBEDTLS_ASN1_CONSTRUCTED | MBEDTLS_ASN1_SEQUENCE)) {\0A        return MBEDTLS_ERROR_ADD(MBEDTLS_ERR_X509