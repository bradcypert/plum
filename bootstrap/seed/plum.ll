g() |> Result.and_then(_, |text| {\0A            let lines = text.split(\22\5Cr\5Cn\22);\0A            http_parse_request_line(lines[0]) |> Result.and_then(_, |rl|\0A                http_parse_headers(Array.drop(lines, 1)) |> Result.and_then(_, |headers|\0A                    http_validate_host(headers, 0, false, String.ends_with(lines[0], \22HTTP/1.1\22))\0A                        |> Result.map(_, |ignored| RequestHead {\0A                            method: rl.method, path: rl.path, headers: headers,\0A                            leftover_body: raw.slice(i + 4, raw.len()),\0A                        })))\0A        }),\0A    }\0A\0A/// A small, fixed table covering the reason phrases any real client\0A/// actually looks at — not the full IANA registry. An unrecognized code\0A/// still produces a syntactically valid status line (`\22Unknown\22`), just\0A/// a less informative one; never a hard error, since the STATUS CODE\0A/// itself (not its phrase) is what every real HTTP client actually acts\0A/// on.\0Alet http_status_reason (code: Int): String = match code {\0A    200 => \22OK\22, 201 => \22Created\22, 204 => \22No Content\22,\0A    301 => \22Moved Permanently\22, 302 => \22Found\22,\0A    400 => \22Bad Request\22, 401 => \22Unauthorized\22, 403 => \22Forbidden\22, 404 => \22Not Found\22, 405 => \22Method Not Allowed\22,\0A    500 => \22Internal Server Error\22, 501 => \22Not Implemented\22, 502 => \22Bad Gateway\22, 503 => \22Service Unavailable\22,\0A    _ => \22Unknown\22,\0A}\0A\0A// This whole-response API owns framing: caller-supplied lengths/codings\0A// cannot override the method/status policy or describe a different body.\0A// Omit length for 304: resp.body need not be the selected representation.\0A// HEAD may report the byte length of the handler's would-be GET body.\0Alet http_response_to_wire (method: String) (resp: Response): Result[HttpWire, String] =\0A    if !http_status_valid(resp.status) { Err(\22http server: invalid response status\22) }\0A    else if http_informational(resp.status) { Err(\22http server: handler must return a final response\22) }\0A    else if http_tunnel(method, resp.status) { Err(\22http server: CONNECT tunnels are not supported\22) }\0A    else { Result.map(http_validate_headers(resp.headers, 0), |ignored| {\0A        let extra_header_lines = Array.fold(resp.headers, \22\22, |acc, h|\0A            if http_header_named(h, \22Content-Length\22) || http_header_named(h, \22Transfer-Encoding\22) { acc }\0A            else { acc.concat(h.name).concat(\22: \22).concat(h.value).concat(\22\5Cr\5Cn\22) });\0A        let length_line = if resp.status == 204 || resp.status == 304 { \22\22 }\0A            else { \22Content-Length: \22.concat(resp.body.len().to_string()).concat(\22\5Cr\5Cn\22) };\0A        let body = if http_response_bodyless(method, resp.status) { Bytes.empty() } else { resp.body };\0A        let head = \22HTTP/1.1 \22.concat(resp.status.to_string()).concat(\22 \22).concat(http_status_reason(resp.status)).concat(\22\5Cr\5Cn\22)\0A            .concat(length_line)\0A            .concat(\22Connection: close\5Cr\5Cn\22)\0A            .concat(extra_header_lines)\0A            .concat(\22\5Cr\5Cn\22);\0A        HttpWire { head: head.as_bytes(), body: body }\0A    }) }\0A\0A// The public RequestHead omits version. Inspect the already validated\0A// request line only when Expect is present, preserving that public shape.\0Alet http_request_http11 (raw: Bytes) (i: Int): Bool =\0A    if i + 1 >= raw.len() { false }\0A    else if http_byte(raw, i) == 13 && http_byte(raw, i + 1) == 10 {\0A        i >= 8 && raw.slice(i - 8, i) == \22HTTP/1.1\22.as_bytes()\0A    } else { http_request_http11(raw, i + 1) }\0A\0Alet http_expectations_ok (headers: Array[Header]) (i: Int): Bool =\0A    if i >= headers.len() { true }\0A    else if http_header_named(headers[i], \22Expect\22)\0A        && !http_expectation_value(headers[i].value.as_bytes(), 0) { false }\0A    else { http_expectations_ok(headers, i + 1)