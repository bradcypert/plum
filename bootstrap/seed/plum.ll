@.str45870 = private global { i64, i64, [26 x i8] } { i64 -1, i64 25, [26 x i8] c"mbedtls/library/pkwrite.c\00" }
@.str45872 = private global { i64, i64, [20718 x i8] } { i64 -1, i64 20717, [20718 x i8] c"/*\0A *  Public Key layer for writing key files and structures\0A *\0A *  Copyright The Mbed TLS Contributors\0A *  SPDX-License-Identifier: Apache-2.0 OR GPL-2.0-or-later\0A */\0A\0A#include \22common.h\22\0A\0A#if defined(MBEDTLS_PK_WRITE_C)\0A\0A#include \22mbedtls/pk.h\22\0A#include \22mbedtls/asn1write.h\22\0A#include \22mbedtls/oid.h\22\0A#include \22mbedtls/platform_util.h\22\0A#include \22mbedtls/error.h\22\0A#include \22pk_internal.h\22\0A\0A#include <string.h>\0A\0A#if defined(MBEDTLS_ECP_C)\0A#include \22mbedtls/bignum.h\22\0A#include \22mbedtls/ecp.h\22\0A#include \22mbedtls/platform_util.h\22\0A#endif\0A#if defined(MBEDTLS_PK_HAVE_ECC_KEYS)\0A#include \22pk_internal.h\22\0A#endif\0A#if defined(MBEDTLS_RSA_C) || defined(MBEDTLS_PK_HAVE_ECC_KEYS)\0A#include \22pkwrite.h\22\0A#endif\0A#if defined(MBEDTLS_PEM_WRITE_C)\0A#include \22mbedtls/pem.h\22\0A#endif\0A#if defined(MBEDTLS_RSA_C)\0A#include \22rsa_internal.h\22\0A#endif\0A\0A#if defined(MBEDTLS_USE_PSA_CRYPTO)\0A#include \22psa/crypto.h\22\0A#include \22psa_util_internal.h\22\0A#endif\0A#include \22mbedtls/platform.h\22\0A\0A/* Helpers for properly sizing buffers aimed at holding public keys or\0A * key-pairs based on build symbols. */\0A#if defined(MBEDTLS_PK_USE_PSA_EC_DATA)\0A#define PK_MAX_EC_PUBLIC_KEY_SIZE       PSA_EXPORT_PUBLIC_KEY_MAX_SIZE\0A#define PK_MAX_EC_KEY_PAIR_SIZE         MBEDTLS_PSA_MAX_EC_KEY_PAIR_LENGTH\0A#elif defined(MBEDTLS_USE_PSA_CRYPTO)\0A#define PK_MAX_EC_PUBLIC_KEY_SIZE       PSA_EXPORT_PUBLIC_KEY_MAX_SIZE\0A#define PK_MAX_EC_KEY_PAIR_SIZE         MBEDTLS_PSA_MAX_EC_KEY_PAIR_LENGTH\0A#else\0A#define PK_MAX_EC_PUBLIC_KEY_SIZE       MBEDTLS_ECP_MAX_PT_LEN\0A#define PK_MAX_EC_KEY_PAIR_SIZE         MBEDTLS_ECP_MAX_BYTES\0A#endif\0A\0A/******************************************************************************\0A * Internal functions for RSA keys.\0A ******************************************************************************/\0A#if defined(MBEDTLS_RSA_C)\0Astatic int pk_write_rsa_der(unsigned char **p, unsigned char *buf,\0A                            const mbedtls_pk_context *pk)\0A{\0A#if defined(MBEDTLS_USE_PSA_CRYPTO)\0A    if (mbedtls_pk_get_type(pk) == MBEDTLS_PK_OPAQUE) {\0A        uint8_t tmp[PSA_EXPORT_KEY_PAIR_MAX_SIZE];\0A        size_t tmp_len = 0;\0A\0A        if (psa_export_key(pk->priv_id, tmp, sizeof(tmp), &tmp_len) != PSA_SUCCESS) {\0A            return MBEDTLS_ERR_PK_BAD_INPUT_DATA;\0A        }\0A        /* Ensure there's enough space in the provided buffer before copying data into it. */\0A        if (tmp_len > (size_t) (*p - buf)) {\0A            mbedtls_platform_zeroize(tmp, sizeof(tmp));\0A            return MBEDTLS_ERR_ASN1_BUF_TOO_SMALL;\0A        }\0A        *p -= tmp_len;\0A        memcpy(*p, tmp, tmp_len);\0A        mbedtls_platform_zeroize(tmp, sizeof(tmp));\0A\0A        return (int) tmp_len;\0A    }\0A#endif /* MBEDTLS_USE_PSA_CRYPTO */\0A    return mbedtls_rsa_write_key(mbedtls_pk_rsa(*pk), buf, p);\0A}\0A#endif /* MBEDTLS_RSA_C */\0A\0A/******************************************************************************\0A * Internal functions for EC keys.\0A ******************************************************************************/\0A#if defined(MBEDTLS_PK_HAVE_ECC_KEYS)\0A#if defined(MBEDTLS_PK_USE_PSA_EC_DATA)\0Astatic int pk_write_ec_pubkey(unsigned char **p, unsigned char *start,\0A                              const mbedtls_pk_context *pk)\0A{\0A    size_t len = 0;\0A    uint8_t buf[PK_MAX_EC_PUBLIC_KEY_SIZE];\0A\0A    if (mbedtls_pk_get_type(pk) == MBEDTLS_PK_OPAQUE) {\0A        if (psa_export_public_key(pk->priv_id, buf, sizeof(buf), &len) != PSA_SUCCESS) {\0A            return MBEDTLS_ERR_PK_BAD_INPUT_DATA;\0A        }\0A    } else {\0A        len = pk->pub_raw_len;\0A        memcpy(buf, pk->pub_raw, len);\0A    }\0A\0A    if (*p < start || (size_t) (*p - start) < len) {\0A        return MBEDTLS_ERR_ASN1_BUF_TOO_SMALL;\0A    }\0A\0A    *p -= len;\0A    memcpy(*p, buf, len);\0A\0A    return (int) len;\0A}\0A#else /* MBEDTLS_PK_USE_PSA_EC_DATA */\0Astatic int pk_write_ec_pubkey(unsigned char **p, unsigned char *start,\0A                              const mbedtls_pk_context *pk)\0A{\0A    size_t len = 0;\0A    unsigned char buf[PK_MAX_EC_PUBLIC_KEY_SIZE];\0A    mbedtls_ecp_keypair *ec = mbedtls_pk_ec(*pk);\0A    int ret = MBEDTLS_ERR_ERROR_CORRUPTION_DETECTED;\0A\0A#if defined(MBEDTLS_USE_PSA_CRYPTO)\0A    if (mbedtls_pk_get_type(pk) == MBEDTLS_PK_OPAQUE) {\0A        if (psa_export_public_key(pk->priv_id, buf, sizeof(buf), &len) != PSA_SUCCESS) {\0A            return MBEDTLS_ERR_PK_BAD_INPUT_DATA;\0A        }\0A        /* Ensure there's enough space in the provided buffer before copying data into it. */\0A        if (len > (size_t) (*p - start)) {\0A            return MBEDTLS_ERR_ASN1_BUF_TOO_SMALL;\0A        }\0A        *p -= len;\0A        memcpy(*p, buf, len);\0A        return (int) len;\0A    } else\0A#endif /* MBEDTLS_USE_PSA_CRYPTO */\0A    {\0A        if ((ret = mbedtls_ecp_point_write_binary(&ec->grp, &ec->Q,\0A                                                  MBEDTLS_ECP_PF_UNCOMPRESSED,\0A                                                  &len, buf, sizeof(buf))) != 0) {\0A            return ret;\0A        }\0A    }\0A\0A    if (*p < start || (size_t) (*p - start) < len) {\0A        return MBEDTLS_ERR_ASN1_BUF_TOO_SMALL;\0A    }\0A\0A    *p -= len;\0A    memcpy(*p, buf, len);\0A\0A    return (int) len;\0A}\0A#endif /* MBEDTLS_PK_USE_PSA_EC_DATA */\0A\0A/*\0A * privateKey  OCTET STRING -- always of length ceil(log2(n)/8)\0A */\0A#if defined(MBEDTLS_PK_USE_PSA_EC_DATA)\0Astatic int pk_write_ec_private(unsigned char **p, unsigned char *start,\0A                               const mbedtls_pk_context *pk)\0A{\0A    size_t byte_length;\0A    int ret = MBEDTLS_ERR_ERROR_CORRUPTION_DETECTED;\0A    unsigned char tmp[PK_MAX_EC_KEY_PAIR_SIZE];\0A    psa_status_t status;\0A\0A    if (mbedtls_pk_get_type(pk) == MBEDTLS_PK_OPAQUE) {\0A        status = psa_export_key(pk->priv_id, tmp, sizeof(tmp), &byte_length);\0A        if (status != PSA_SUCCESS) {\0A            ret = PSA_PK_ECDSA_TO_MBEDTLS_ERR(status);\0A            return ret;\0A        }\0A    } else {\0A        status = psa_export_key(pk->priv_id, tmp, sizeof(tmp), &byte_length);\0A        if (status != PSA_SUCCESS) {\0A            ret = PSA_PK_ECDSA_TO_MBEDTLS_ERR(status);\0A            goto exit;\0A        }\0A    }\0A\0A    ret = mbedtls_asn1_write_octet_string(p, start, tmp, byte_length);\0Aexit:\0A    mbedtls_platform_zeroize(tmp, sizeof(tmp));\0A    return ret;\0A}\0A#else /* MBEDTLS_PK_USE_PSA_EC_DATA */\0Astatic int pk_write_ec_private(unsigned char **p, unsigned char *start,\0A                               const mbedtls_pk_context *pk)\0A{\0A    size_t byte_length;\0A    int ret = MBEDTLS_ERR_ERROR_CORRUPTION_DETECTED;\0A    unsigned char tmp[PK_MAX_EC_KEY_PAIR_SIZE];\0A\0A#if defined(MBEDTLS_USE_PSA_CRYPTO)\0A    psa_status_t status;\0A    if (mbedtls_pk_get_type(pk) == MBEDTLS_PK_OPAQUE) {\0A        status = psa_export_key(pk->priv_id, tmp, sizeof(tmp), &byte_length);\0A        if (status != PSA_SUCCESS) {\0A            ret = PSA_PK_ECDSA_TO_MBEDTLS_ERR(status);\0A            return ret;\0A        }\0A    } else\0A#endif /* MBEDTLS_USE_PSA_CRYPTO */\0A    {\0A        mbedtls_ecp_keypair *ec = mbedtls_pk_ec_rw(*pk);\0A        byte_length = (ec->grp.pbits + 7) / 8;\0A\0A        ret = mbedtls_ecp_write_key_ext(ec, &byte_length, tmp, sizeof(tmp));\0A        if (ret != 0) {\0A            goto exit;\0A        }\0A    }\0A    ret = mbedtls_asn1_write_octet_string(p, start, tmp, byte_length);\0Aexit:\0A    mbedtls_platform_zeroize(tmp, sizeof(tmp));\0A    return ret;\0A}\0A#endif /* MBEDTLS_PK_USE_PSA_EC_DATA */\0A\0A/*\0A * ECParameters ::= CHOICE {\0A *   namedCurve         OBJECT IDENTIFIER\0A * }\0A */\0Astatic int pk_write_ec_param(unsigned char **p, unsigned char *start,\0A                             mbedtls_ecp_group_id grp_id)\0A{\0A    int ret = MBEDTLS_ERR_ERROR_CORRUPTION_DETECTED;\0A    size_t len = 0;\0A    const char *oid;\0A    size_t oid_len;\0A\0A    if ((ret = mbedtls_oid_get_oid_by_ec_grp(grp_id, &oid, &oid_len)) != 0) {\0A        return ret;\0A    }\0A\0A    MBEDTLS_ASN1_CHK_ADD(len, mbedtls_asn1_write_oid(p, start, oid, oid_len));\0A\0A    return (int) len;\0A}\0A\0A#if defined(MBEDTLS_PK_HAVE_RFC8410_CURVES)\0A/*\0A * RFC8410 section 7\0A *\0A * OneAsymmetricKey ::= SEQUENCE {\0A *    version Version,\0A *    privateKeyAlgorithm PrivateKeyAlgorithmIdentifier,\0A *    privateKey PrivateKey,\0A *    attributes [0] IMPLICIT Attributes OPTIONAL,\0A *    ...,\0A *    [[2: publicKey [1] IMPLICIT PublicKey OPTIONAL ]],\0A *    ...\0A * }\0A * ...\0A * CurvePrivateKey ::= OCTET STRING\0A */\0Astatic int pk_write_ec_rfc8410_der(unsigned char **p, unsigned char *buf,\0A                                   const mbedtls_pk_context *pk)\0A{\0A    int ret = MBEDTLS_ERR_ERROR_CORRUPTION_DETECTED;\0A    size_t len = 0;\0A    size_t oid_len = 0;\0A    const char *oid;\0A    mbedtls_ecp_group_id grp_id;\0A\0A    /* privateKey */\0A    MBEDTLS_ASN1_CHK_ADD(len, pk_write_ec_private(p, buf, pk));\0A    MBEDTLS_ASN1_CHK_ADD(len, mbedtls_asn1_write_len(p, buf, len));\0A    MBEDTLS_ASN1_CHK_ADD(len, mbedtls_asn1_write_tag(p, buf, MBEDTLS_ASN1_OCTET_STRING));\0A\0A    grp_id = mbedtls_pk_get_ec_group_id(pk);\0A    /* privateKeyAlgorithm */\0A    if ((ret = mbedtls_oid_get_oid_by_ec_grp_algid(grp_id, &oid, &oid_len)) != 0) {\0A        return ret;\0A    }\0A    MBEDTLS_ASN1_CHK_ADD(len,\0A                         mbedtls_asn1_write_algorithm_identifier_ext(p, buf, oid, oid_len, 0, 0));\0A\0A    /* version */\0A    MBEDTLS_ASN1_CHK_ADD(len, mbedtls_asn1_write_int(p, buf, 0));\0A\0A    MBEDTLS_ASN1_CHK_ADD(len, mbedtls_asn1_write_len(p, buf, len));\0A    MBEDTLS_ASN1_CHK_ADD(len, mbedtls_asn1_write_tag(p, buf, MBEDTLS_ASN1_CONSTRUCTED |\0A                                                     MBEDTLS_ASN1_SEQUENCE));\0A\0A    return (int) len;\0A}\0A#endif /* MBEDTLS_PK_HAVE_RFC8410_CURVES */\0A\0A/*\0A * RFC 5915, or SEC1 Appendix C.4\0A *\0A * ECPrivateKey ::= SEQUENCE {\0A *      version        INTEGER { ecPrivkeyVer1(1) } (ecPrivkeyVer1),\0A *      privateKey     OCTET STRING,\0A *      parameters [0] ECParameters {{ NamedCurve }} OPTIONAL,\0A *      publicKey  [1] BIT STRING OPTIONAL\0A *    }\0A */\0Astatic int pk_write_ec_der(unsigned char **p, unsigned char *buf,\0A                           const mbedtls_pk_context *pk)\0A{\0A    size_t len = 0;\0A    int ret;\0A    size_t pub_len = 0, par_len = 0;\0A    mbedtls_ecp_group_id grp_id;\0A\0A    /* publicKey */\0A    MBEDTLS_ASN1_CHK_ADD(pub_len, pk_write_ec_pubkey(p, buf, pk));\0A\0A    if (*p - buf < 1) {\0A        return MBEDTLS_ERR_ASN1_BUF_TOO_SMALL;\0A    }\0A    (*p)--;\0A    **p = 0;\0A    pub_len += 1;\0A\0A    MBEDTLS_ASN1_CHK_ADD(pub_len, mbedtls_asn1_write_len(p, buf, pub_len));\0A    MBEDTLS_ASN1_CHK_ADD(pub_len, mbedtls_asn1_write_tag(p, buf, MBEDTLS_ASN1_BIT_STRING));\0A\0A    MBEDTLS_ASN1_CHK_ADD(pub_len, mbedtls_asn1_write_len(p, buf, pub_len));\0A    MBEDTLS_ASN1_CHK_ADD(pub_len, mbedtls_asn1_write_tag(p, buf,\0A                                                         MBEDTLS_ASN1_CONTEXT_SPECIFIC |\0A                                                         MBEDTLS_ASN1_CONSTRUCTED | 1));\0A    len += pub_len;\0A\0A    /* parameters */\0A    grp_id = mbedtls_pk_get_ec_group_id(pk);\0A    MBEDTLS_ASN1_CHK_ADD(par_len, pk_write_ec_param(p, buf, grp_id));\0A    MBEDTLS_ASN1_CHK_ADD(par_len, mbedtls_asn1_write_len(p, buf, par_len));\0A    MBEDTLS_ASN1_CHK_ADD(par_len, mbedtls_asn1_write_tag(p, buf,\0A                                                         MBEDTLS_ASN1_CONTEXT_SPECIFIC |\0A                                                         MBEDTLS_ASN1_CONSTRUCTED | 0));\0A    len += par_len;\0A\0A    /* privateKey */\0A    MBEDTLS_ASN1_CHK_ADD(len, pk_write_ec_private(p, buf, pk));\0A\0A    /* version */\0A    MBEDTLS_ASN1_CHK_ADD(len, mbedtls_asn1_write_int(p, buf, 1));\0A\0A    MBEDTLS_ASN1_CHK_ADD(len, mbedtls_asn1_write_len(p, buf, len));\0A    MBEDTLS_ASN1_CHK_ADD(len, mbedtls_asn1_write_tag(p, buf, MBEDTLS_ASN1_CONSTRUCTED |\0A                                                     MBEDTLS_ASN1_SEQUENCE));\0A\0A    return (int) len;\0A}\0A#endif /* MBEDTLS_PK_HAVE_ECC_KEYS */\0A\0A/******************************************************************************\0A * Internal functions for Opaque keys.\0A ******************************************************************************/\0A#if defined(MBEDTLS_USE_PSA_CRYPTO)\0Astatic int pk_write_opaque_pubkey(unsigned char **p, unsigned char *start,\0A                                  const mbedtls_pk_context *pk)\0A{\0A    size_t buffer_size;\0A    size_t len = 0;\0A\0A    if (*p < start) {\0A        return MBEDTLS_ERR_PK_BAD_INPUT_DATA;\0A    }\0A\0A    buffer_size = (size_t) (*p - start);\0A    if (psa_export_public_key(pk->priv_id, start, buffer_size,\0A                              &len) != PSA_SUCCESS) {\0A        return MBEDTLS_ERR_PK_BAD_INPUT_DATA;\0A    }\0A\0A    *p -= len;\0A    memmove(*p, start, len);\0A\0A    return (int) len;\0A}\0A#endif /* MBEDTLS_USE_PSA_CRYPTO */\0A\0A/******************************************************************************\0A * Generic helpers\0A ******************************************************************************/\0A\0A/* Extend the public mbedtls_pk_get_type() by getting key type also in case of\0A * opaque keys. */\0Astatic mbedtls_pk_type_t pk_get_type_ext(const mbedtls_pk_context *pk)\0A{\0A    mbedtls_pk_type_t pk_type = mbedtls_pk_get_type(pk);\0A\0A#if defined(MBEDTLS_USE_PSA_CRYPTO)\0A    if (pk_type == MBEDTLS_PK_OPAQUE) {\0A        psa_key_attributes_t opaque_attrs = PSA_KEY_ATTRIBUTES_INIT;\0A        psa_key_type_t opaque_key_type;\0A\0A        if (psa_get_key_attributes(pk->priv_id, &opaque_attrs) != PSA_SUCCESS) {\0A            return MBEDTLS_PK_NONE;\0A        }\0A        opaque_key_type = psa_get_key_type(&opaque_attrs);\0A        psa_reset_key_attributes(&opaque_attrs);\0A\0A        if (PSA_KEY_TYPE_IS_ECC(opaque_key_type)) {\0A            return MBEDTLS_PK_ECKEY;\0A        } else if (PSA_KEY_TYPE_IS_RSA(opaque_key_type)) {\0A            return MBEDTLS_PK_RSA;\0A        } else {\0A            return MBEDTLS_PK_NONE;\0A        }\0A    } else\0A#endif\0A    return pk_type;\0A}\0A\0A/******************************************************************************\0A * Public functions for writing private/public DER keys.\0A ******************************************************************************/\0Aint mbedtls_pk_write_pubkey(unsigned char **p, unsigned char *start,\0A                            const mbedtls_pk_context *key)\0A{\0A    int ret = MBEDTLS_ERR_ERROR_CORRUPTION_DETECTED;\0A    size_t len = 0;\0A\0A#if defined(MBEDTLS_RSA_C)\0A    if (mbedtls_pk_get_type(key) == MBEDTLS_PK_RSA) {\0A        MBEDTLS_ASN1_CHK_ADD(len, mbedtls_rsa_write_pubkey(mbedtls_pk_rsa(*key), start, p));\0A    } else\0A#endif\0A#if defined(MBEDTLS_PK_HAVE_ECC_KEYS)\0A    if (mbedtls_pk_get_type(key) == MBEDTLS_PK_ECKEY) {\0A        MBEDTLS_ASN1_CHK_ADD(len, pk_write_ec_pubkey(p, start, key));\0A    } else\0A#endif\0A#if defined(MBEDTLS_USE_PSA_CRYPTO)\0A    if (mbedtls_pk_get_type(key) == MBEDTLS_PK_OPAQUE) {\0A        MBEDTLS_ASN1_CHK_ADD(len, pk_write_opaque_pubkey(p, start, key));\0A    } else\0A#endif /* MBEDTLS_USE_PSA_CRYPTO */\0A    return MBEDTLS_ERR_PK_FEATURE_UNAVAILABLE;\0A\0A    return (int) len;\0A}\0A\0Aint mbedtls_pk_write_pubkey_der(const mbedtls_pk_context *key, unsigned char *buf, size_t size)\0A{\0A    int ret = MBEDTLS_ERR_ERROR_CORRUPTION_DETECTED;\0A    unsigned char *c;\0A    int has_par = 1;\0A    size_t len = 0, par_len = 0, oid_len = 0;\0A    mbedtls_pk_type_t pk_type;\0A    const char *oid = NULL;\0A\0A    if (size == 0) {\0A        return MBEDTLS_ERR_ASN1_BUF_TOO_SMALL;\0A    }\0A\0A    c = buf + size;\0A\0A    MBEDTLS_ASN1_CHK_ADD(len, mbedtls_pk_write_pubkey(&c, buf, key));\0A\0A    if (c - buf < 1) {\0A        return MBEDTLS_ERR_ASN1_BUF_TOO_SMALL;\0A    }\0A\0A    /*\0A     *  SubjectPublicKeyInfo  ::=  SEQUENCE  {\0A     *       algorithm            AlgorithmIdentifier,\0A     *       subjectPublicKey     BIT STRING }\0A     */\0A    *--c = 0;\0A    len += 1;\0A\0A    MBEDTLS_ASN1_CHK_ADD(len, mbedtls_asn1_write_len(&c, buf, len));\0A    MBEDTLS_ASN1_CHK_ADD(len, mbedtls_asn1_write_tag(&c, buf, MBEDTLS_ASN1_BIT_STRING));\0A\0A    pk_type = pk_get_type_ext(key);\0A\0A#if defined(MBEDTLS_PK_HAVE_ECC_KEYS)\0A    if (pk_get_type_ext(key) == MBEDTLS_PK_ECKEY) {\0A        mbedtls_ecp_group_id ec_grp_id = mbedtls_pk_get_ec_group_id(key);\0A        if (MBEDTLS_PK_IS_RFC8410_GROUP_ID(ec_grp_id)) {\0A            ret = mbedtls_oid_get_oid_by_ec_grp_algid(ec_grp_id, &oid, &oid_len);\0A            if (ret != 0) {\0A                return ret;\0A            }\0A            has_par = 0;\0A        } else {\0A            MBEDTLS_ASN1_CHK_ADD(par_len, pk_write_ec_param(&c, buf, ec_grp_id));\0A        }\0A    }\0A#endif /* MBEDTLS_PK_HAVE_ECC_KEYS */\0A\0A    /* At this point oid_len is not null only for EC Montgomery keys. */\0A    if (oid_len == 0) {\0A        ret = mbedtls_oid_get_oid_by_pk_alg(pk_type, &oid, &oid_len);\0A        if (ret != 0) {\0A            return ret;\0A        }\0A    }\0A\0A    MBEDTLS_ASN1_CHK_ADD(len, mbedtls_asn1_write_algorithm_identifier_ext(&c, buf, oid, oid_len,\0A                                                                          par_len, has_par));\0A\0A    MBEDTLS_ASN1_CHK_ADD(len, mbedtls_asn1_write_len(&c, buf, len));\0A    MBEDTLS_ASN1_CHK_ADD(len, mbedtls_asn1_write_tag(&c, buf, MBEDTLS_ASN1_CONSTRUCTED |\0A                                                     MBEDTLS_ASN1_SEQUENCE));\0A\0A    return (int) len;\0A}\0A\0Aint mbedtls_pk_write_key_der(const mbedtls_pk_context *key, unsigned char *buf, size_t size)\0A{\0A    unsigned char *c;\0A\0A    if (size == 0) {\0A        return MBEDTLS_ERR_ASN1_BUF_TOO_SMALL;\0A    }\0A\0A    c = buf + size;\0A\0A#if defined(MBEDTLS_RSA_C)\0A    if (pk_get_type_ext(key) == MBEDTLS_PK_RSA) {\0A        return pk_write_rsa_der(&c, buf, key);\0A    } else\0A#endif /* MBEDTLS_RSA_C */\0A#if defined(MBEDTLS_PK_HAVE_ECC_KEYS)\0A    if (pk_get_type_ext(key) == MBEDTLS_PK_ECKEY) {\0A#if defined(MBEDTLS_PK_HAVE_RFC8410_CURVES)\0A        if (mbedtls_pk_is_rfc8410(key)) {\0A            return pk_write_ec_rfc8410_der(&c, buf, key);\0A        }\0A#endif /* MBEDTLS_PK_HAVE_RFC8410_CURVES */\0A        return pk_write_ec_der(&c, buf, key);\0A    } else\0A#endif /* MBEDTLS_PK_HAVE_ECC_KEYS */\0A    return MBEDTLS_ERR_PK_FEATURE_UNAVAILABLE;\0A}\0A\0A/******************************************************************************\0A * Public functions for wrinting private/public PEM keys.\0A ******************************************************************************/\0A#if defined(MBEDTLS_PEM_WRITE_C)\0A\0A#define PUB_DER_MAX_BYTES                                                   \5C\0A    (MBEDTLS_PK_RSA_PUB_DER_MAX_BYTES > MBEDTLS_PK_ECP_PUB_DER_MAX_BYTES ? \5C\0A     MBEDTLS_PK_RSA_PUB_DER_MAX_BYTES : MBEDTLS_PK_ECP_PUB_DER_MAX_BYTES)\0A#define PRV_DER_MAX_BYTES                                                   \5C\0A    (MBEDTLS_PK_RSA_PRV_DER_MAX_BYTES > MBEDTLS_PK_ECP_PRV_DER_MAX_BYTES ? \5C\0A     MBEDTLS_PK_RSA_PRV_DER_MAX_BYTES : MBEDTLS_PK_ECP_PRV_DER_MAX_BYTES)\0A\0Aint mbedtls_pk_write_pubkey_pem(const mbedtls_pk_context *key, unsigned char *buf, size_t size)\0A{\0A    int ret = MBEDTLS_ERR_ERROR_CORRUPTION_DETECTED;\0A    unsigned char *output_buf = NULL;\0A    output_buf = mbedtls_calloc(1, PUB_DER_MAX_BYTES);\0A    if (output_buf == NULL) {\0A        return MBEDTLS_ERR_PK_ALLOC_FAILED;\0A    }\0A    size_t olen = 0;\0A\0A    if ((ret = mbedtls_pk_write_pubkey_der(key, output_buf,\0A                                           PUB_DER_MAX_BYTES)) < 0) {\0A        goto cleanup;\0A    }\0A\0A    if ((ret = mbedtls_pem_write_buffer(PEM_BEGIN_PUBLIC_KEY \22\5Cn\22, PEM_END_PUBLIC_KEY \22\5Cn\22,\0A                                        output_buf + PUB_DER_MAX_BYTES - ret,\0A                                        ret, buf, size, &olen)) != 0) {\0A        goto cleanup;\0A    }\0A\0A    ret = 0;\0Acleanup:\0A    mbedtls_free(output_buf);\0A    return ret;\0A}\0A\0Aint mbedtls_pk_write_key_pem(const mbedtls_pk_context *key, unsigned char *buf, size_t size)\0A{\0A    int ret = MBEDTLS_ERR_ERROR_CORRUPTION_DETECTED;\0A    unsigned char *output_buf = NULL;\0A    output_buf = mbedtls_calloc(1, PRV_DER_MAX_BYTES);\0A    if (output_buf == NULL) {\0A        return MBEDTLS_ERR_PK_ALLOC_FAILED;\0A    }\0A    const char *begin, *end;\0A    size_t olen = 0;\0A\0A    if ((ret = mbedtls_pk_write_key_der(key, output_buf, PRV_DER_MAX_BYTES)) < 0) {\0A        goto cleanup;\0A    }\0A\0A#if defined(MBEDTLS_RSA_C)\0A    if (pk_get_type_ext(key) == MBEDTLS_PK_RSA) {\0A        begin = PEM_BEGIN_PRIVATE_KEY_RSA \22\5Cn\22;\0A        end = PEM_END_PRIVATE_KEY_RSA \22\5Cn\22;\0A    } else\0A#endif\0A#if defined(MBEDTLS_PK_HAVE_ECC_KEYS)\0A    if (pk_get_type_ext(key) == MBEDTLS_PK_ECKEY) {\0A        if (mbedtls_pk_is_rfc8410(key)) {\0A            begin = PEM_BEGIN_PRIVATE_KEY_PKCS8 \22\5Cn\22;\0A            end = PEM_END_PRIVATE_KEY_PKCS8 \22\5Cn\22;\0A        } else {\0A            begin = PEM_BEGIN_PRIVATE_KEY_EC \22\5Cn\22;\0A            end = PEM_END_PRIVATE_KEY_EC \22\5Cn\22;\0A        }\0A    } else\0A#endif /* MBEDTLS_PK_HAVE_ECC_KEYS */\0A    {\0A        ret = MBEDTLS_ERR_PK_FEATURE_UNAVAILABLE;\0A        goto cleanup;\0A    }\0A\0A    if ((ret = mbedtls_pem_write_buffer(begin, end,\0A                                        output_buf + PRV_DER_MAX_BYTES - ret,\0A                                        ret, buf, size, &olen)) != 0) {\0A        goto cleanup;\0A    }\0A\0A    ret = 0;\0Acleanup:\0A    mbedtls_zeroize_and_free(output_buf, PRV_DER_MAX_BYTES);\0A    return ret;\0A}\0A#endif /* MBEDTLS_PEM_WRITE_C */\0A\0A#endif /* MBEDTLS_PK_WRITE_C */\0A\00" }
