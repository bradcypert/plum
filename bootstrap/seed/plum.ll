@.str41718 = private global { i64, i64, [19629 x i8] } { i64 -1, i64 19628, [19629 x i8] c"/**\0A * \5Cfile ecdh.h\0A *\0A * \5Cbrief This file contains ECDH definitions and functions.\0A *\0A * The Elliptic Curve Diffie-Hellman (ECDH) protocol is an anonymous\0A * key agreement protocol allowing two parties to establish a shared\0A * secret over an insecure channel. Each party must have an\0A * elliptic-curve public–private key pair.\0A *\0A * For more information, see <em>NIST SP 800-56A Rev. 2: Recommendation for\0A * Pair-Wise Key Establishment Schemes Using Discrete Logarithm\0A * Cryptography</em>.\0A */\0A/*\0A *  Copyright The Mbed TLS Contributors\0A *  SPDX-License-Identifier: Apache-2.0 OR GPL-2.0-or-later\0A */\0A\0A#ifndef MBEDTLS_ECDH_H\0A#define MBEDTLS_ECDH_H\0A#include \22mbedtls/private_access.h\22\0A\0A#include \22mbedtls/build_info.h\22\0A\0A#include \22mbedtls/ecp.h\22\0A\0A/*\0A * Mbed TLS supports two formats for ECDH contexts (#mbedtls_ecdh_context\0A * defined in `ecdh.h`). For most applications, the choice of format makes\0A * no difference, since all library functions can work with either format,\0A * except that the new format is incompatible with MBEDTLS_ECP_RESTARTABLE.\0A\0A * The new format used when this option is disabled is smaller\0A * (56 bytes on a 32-bit platform). In future versions of the library, it\0A * will support alternative implementations of ECDH operations.\0A * The new format is incompatible with applications that access\0A * context fields directly and with restartable ECP operations.\0A */\0A\0A#if defined(MBEDTLS_ECP_RESTARTABLE)\0A#define MBEDTLS_ECDH_LEGACY_CONTEXT\0A#else\0A#undef MBEDTLS_ECDH_LEGACY_CONTEXT\0A#endif\0A\0A#if defined(MBEDTLS_ECDH_VARIANT_EVEREST_ENABLED)\0A#undef MBEDTLS_ECDH_LEGACY_CONTEXT\0A#include \22everest/everest.h\22\0A#endif\0A\0A#ifdef __cplusplus\0Aextern \22C\22 {\0A#endif\0A\0A/**\0A * Defines the source of the imported EC key.\0A */\0Atypedef enum {\0A    MBEDTLS_ECDH_OURS,   /**< Our key. */\0A    MBEDTLS_ECDH_THEIRS, /**< The key of the peer. */\0A} mbedtls_ecdh_side;\0A\0A#if !defined(MBEDTLS_ECDH_LEGACY_CONTEXT)\0A/**\0A * Defines the ECDH implementation used.\0A *\0A * Later versions of the library may add new variants, therefore users should\0A * not make any assumptions about them.\0A */\0Atypedef enum {\0A    MBEDTLS_ECDH_VARIANT_NONE = 0,   /*!< Implementation not defined. */\0A    MBEDTLS_ECDH_VARIANT_MBEDTLS_2_0,/*!< The default Mbed TLS implementation */\0A#if defined(MBEDTLS_ECDH_VARIANT_EVEREST_ENABLED)\0A    MBEDTLS_ECDH_VARIANT_EVEREST     /*!< Everest implementation */\0A#endif\0A} mbedtls_ecdh_variant;\0A\0A/**\0A * The context used by the default ECDH implementation.\0A *\0A * Later versions might change the structure of this context, therefore users\0A * should not make any assumptions about the structure of\0A * mbedtls_ecdh_context_mbed.\0A */\0Atypedef struct mbedtls_ecdh_context_mbed {\0A    mbedtls_ecp_group MBEDTLS_PRIVATE(grp);   /*!< The elliptic curve used. */\0A    mbedtls_mpi MBEDTLS_PRIVATE(d);           /*!< The private key. */\0A    mbedtls_ecp_point MBEDTLS_PRIVATE(Q);     /*!< The public key. */\0A    mbedtls_ecp_point MBEDTLS_PRIVATE(Qp);    /*!< The value of the public key of the peer. */\0A    mbedtls_mpi MBEDTLS_PRIVATE(z);           /*!< The shared secret. */\0A#if defined(MBEDTLS_ECP_RESTARTABLE)\0A    mbedtls_ecp_restart_ctx MBEDTLS_PRIVATE(rs); /*!< The restart context for EC computations. */\0A#endif\0A} mbedtls_ecdh_context_mbed;\0A#endif\0A\0A/**\0A *\0A * \5Cwarning         Performing multiple operations concurrently on the same\0A *                  ECDSA context is not supported; objects of this type\0A *                  should not be shared between multiple threads.\0A * \5Cbrief           The ECDH context structure.\0A */\0Atypedef struct mbedtls_ecdh_context {\0A#if defined(MBEDTLS_ECDH_LEGACY_CONTEXT)\0A    mbedtls_ecp_group MBEDTLS_PRIVATE(grp);   /*!< The elliptic curve used. */\0A    mbedtls_mpi MBEDTLS_PRIVATE(d);           /*!< The private key. */\0A    mbedtls_ecp_point MBEDTLS_PRIVATE(Q);     /*!< The public key. */\0A    mbedtls_ecp_point MBEDTLS_PRIVATE(Qp);    /*!< The value of the public key of the peer. */\0A    mbedtls_mpi MBEDTLS_PRIVATE(z);           /*!< The shared secret. */\0A    int MBEDTLS_PRIVATE(point_format);        /*!< The format of point export in TLS messages. */\0A    mbedtls_ecp_point MBEDTLS_PRIVATE(Vi);    /*!< The blinding value. */\0A    mbedtls_ecp_point MBEDTLS_PRIVATE(Vf);    /*!< The unblinding value. */\0A    mbedtls_mpi MBEDTLS_PRIVATE(_d);          /*!< The previous \5Cp d. */\0A#if defined(MBEDTLS_ECP_RESTARTABLE)\0A    int MBEDTLS_PRIVATE(restart_enabled);        /*!< The flag for restartable mode. */\0A    mbedtls_ecp_restart_ctx MBEDTLS_PRIVATE(rs); /*!< The restart context for EC computations. */\0A#endif /* MBEDTLS_ECP_RESTARTABLE */\0A#else\0A    uint8_t MBEDTLS_PRIVATE(point_format);       /*!< The format of point export in TLS messages\0A                                                    as defined in RFC 4492. */\0A    mbedtls_ecp_group_id MBEDTLS_PRIVATE(grp_id);/*!< The elliptic curve used. */\0A    mbedtls_ecdh_variant MBEDTLS_PRIVATE(var);   /*!< The ECDH implementation/structure used. */\0A    union {\0A        mbedtls_ecdh_context_mbed   MBEDTLS_PRIVATE(mbed_ecdh);\0A#if defined(MBEDTLS_ECDH_VARIANT_EVEREST_ENABLED)\0A        mbedtls_ecdh_context_everest MBEDTLS_PRIVATE(everest_ecdh);\0A#endif\0A    } MBEDTLS_PRIVATE(ctx);                      /*!< Implementation-specific context. The\0A                                                    context in use is specified by the \5Cc var\0A                                                    field. */\0A#if defined(MBEDTLS_ECP_RESTARTABLE)\0A    uint8_t MBEDTLS_PRIVATE(restart_enabled);    /*!< The flag for restartable mode. Functions of\0A                                                    an alternative implementation not supporting\0A                                                    restartable mode must return\0A                                                    MBEDTLS_ERR_PLATFORM_FEATURE_UNSUPPORTED error\0A                                                    if this flag is set. */\0A#endif /* MBEDTLS_ECP_RESTARTABLE */\0A#endif /* MBEDTLS_ECDH_LEGACY_CONTEXT */\0A}\0Ambedtls_ecdh_context;\0A\0A/**\0A * \5Cbrief          Return the ECP group for provided context.\0A *\0A * \5Cnote           To access group specific fields, users should use\0A *                 `mbedtls_ecp_curve_info_from_grp_id` or\0A *                 `mbedtls_ecp_group_load` on the extracted `group_id`.\0A *\0A * \5Cparam ctx      The ECDH context to parse. This must not be \5Cc NULL.\0A *\0A * \5Creturn         The \5Cc mbedtls_ecp_group_id of the context.\0A */\0Ambedtls_ecp_group_id mbedtls_ecdh_get_grp_id(mbedtls_ecdh_context *ctx);\0A\0A/**\0A * \5Cbrief          Check whether a given group can be used for ECDH.\0A *\0A * \5Cparam gid      The ECP group ID to check.\0A *\0A * \5Creturn         \5Cc 1 if the group can be used, \5Cc 0 otherwise\0A */\0Aint mbedtls_ecdh_can_do(mbedtls_ecp_group_id gid);\0A\0A/**\0A * \5Cbrief           This function generates an ECDH keypair on an elliptic\0A *                  curve.\0A *\0A *                  This function performs the first of two core computations\0A *                  implemented during the ECDH key exchange. The second core\0A *                  computation is performed by mbedtls_ecdh_compute_shared().\0A *\0A * \5Csee             ecp.h\0A *\0A * \5Cparam grp       The ECP group to use. This must be initialized and have\0A *                  domain parameters loaded, for example through\0A *                  mbedtls_ecp_load() or mbedtls_ecp_tls_read_group().\0A * \5Cparam d         The destination MPI (private key).\0A *                  This must be initialized.\0A * \5Cparam Q         The destination point (public key).\0A *                  This must be initialized.\0A * \5Cparam f_rng     The RNG function to use. This must not be \5Cc NULL.\0A * \5Cparam p_rng     The RNG context to be passed to \5Cp f_rng. This may be\0A *                  \5Cc NULL in case \5Cp f_rng doesn't need a context argument.\0A *\0A * \5Creturn          \5Cc 0 on success.\0A * \5Creturn          Another \5Cc MBEDTLS_ERR_ECP_XXX or\0A *                  \5Cc MBEDTLS_MPI_XXX error code on failure.\0A */\0Aint mbedtls_ecdh_gen_public(mbedtls_ecp_group *grp, mbedtls_mpi *d, mbedtls_ecp_point *Q,\0A                            int (*f_rng)(void *, unsigned char *, size_t),\0A                            void *p_rng);\0A\0A/**\0A * \5Cbrief           This function computes the shared secret.\0A *\0A *                  This function performs the second of two core computations\0A *                  implemented during the ECDH key exchange. The first core\0A *                  computation is performed by mbedtls_ecdh_gen_public().\0A *\0A * \5Csee             ecp.h\0A *\0A * \5Cnote            If \5Cp f_rng is not NULL, it is used to implement\0A *                  countermeasures against side-channel attacks.\0A *                  For more information, see mbedtls_ecp_mul().\0A *\0A * \5Cparam grp       The ECP group to use. This must be initialized and have\0A *                  domain parameters loaded, for example through\0A *                  mbedtls_ecp_load() or mbedtls_ecp_tls_read_group().\0A * \5Cparam z         The destination MPI (shared secret).\0A *                  This must be initialized.\0A * \5Cparam Q         The public key from another party.\0A *                  This must be initialized.\0A * \5Cparam d         Our secret exponent (private key).\0A *                  This must be initialized.\0A * \5Cparam f_rng     The RNG function to use. This must not be \5Cc NULL.\0A * \5Cparam p_rng     The RNG context to be passed to \5Cp f_rng. This may be\0A *                  \5Cc NULL if \5Cp f_rng is \5Cc NULL or doesn't need a\0A *                  context argument.\0A *\0A * \5Creturn          \5Cc 0 on success.\0A * \5Creturn          Another \5Cc MBEDTLS_ERR_ECP_XXX or\0A *                  \5Cc MBEDTLS_MPI_XXX error code on failure.\0A */\0Aint mbedtls_ecdh_compute_shared(mbedtls_ecp_group *grp, mbedtls_mpi *z,\0A                                const mbedtls_ecp_point *Q, const mbedtls_mpi *d,\0A                                int (*f_rng)(void *, unsigned char *, size_t),\0A                                void *p_rng);\0A\0A/**\0A * \5Cbrief           This function initializes an ECDH context.\0A *\0A * \5Cparam ctx       The ECDH context to initialize. This must not be \5Cc NULL.\0A */\0Avoid mbedtls_ecdh_init(mbedtls_ecdh_context *ctx);\0A\0A/**\0A * \5Cbrief           This function sets up the ECDH context with the information\0A *                  given.\0A *\0A *                  This function should be called after mbedtls_ecdh_init() but\0A *                  before mbedtls_ecdh_make_params(). There is no need to call\0A *                  this function before mbedtls_ecdh_read_params().\0A *\0A *                  This is the first function used by a TLS server for ECDHE\0A *                  ciphersuites.\0A *\0A * \5Cparam ctx       The ECDH context to set up. This must be initialized.\0A * \5Cparam grp_id    The group id of the group to set up the context for.\0A *\0A * \5Creturn          \5Cc 0 on success.\0A */\0Aint mbedtls_ecdh_setup(mbedtls_ecdh_context *ctx,\0A                       mbedtls_ecp_group_id grp_id);\0A\0A/**\0A * \5Cbrief           This function frees a context.\0A *\0A * \5Cparam ctx       The context to free. This may be \5Cc NULL, in which\0A *                  case this function does nothing. If it is not \5Cc NULL,\0A *                  it must point to an initialized ECDH context.\0A */\0Avoid mbedtls_ecdh_free(mbedtls_ecdh_context *ctx);\0A\0A/**\0A * \5Cbrief           This function generates an EC key pair and exports its\0A *                  in the format used in a TLS ServerKeyExchange handshake\0A *                  message.\0A *\0A *                  This is the second function used by a TLS server for ECDHE\0A *                  ciphersuites. (It is called after mbedtls_ecdh_setup().)\0A *\0A * \5Csee             ecp.h\0A *\0A * \5Cparam ctx       The ECDH context to use. This must be initialized\0A *                  and bound to a group, for example via mbedtls_ecdh_setup().\0A * \5Cparam olen      The address at which to store the number of Bytes written.\0A * \5Cparam buf       The destination buffer. This must be a writable buffer of\0A *                  length \5Cp blen Bytes.\0A * \5Cparam blen      The length of the destination buffer \5Cp buf in Bytes.\0A * \5Cparam f_rng     The RNG function to use. This must not be \5Cc NULL.\0A * \5Cparam p_rng     The RNG context to be passed to \5Cp f_rng. This may be\0A *                  \5Cc NULL in case \5Cp f_rng doesn't need a context argument.\0A *\0A * \5Creturn          \5Cc 0 on success.\0A * \5Creturn          #MBEDTLS_ERR_ECP_IN_PROGRESS if maximum number of\0A *                  operations was reached: see \5Cc mbedtls_ecp_set_max_ops().\0A * \5Creturn          Another \5Cc MBEDTLS_ERR_ECP_XXX error code on failure.\0A */\0Aint mbedtls_ecdh_make_params(mbedtls_ecdh_context *ctx, size_t *olen,\0A                             unsigned char *buf, size_t blen,\0A                             int (*f_rng)(void *, unsigned char *, size_t),\0A                             void *p_rng);\0A\0A/**\0A * \5Cbrief           This function parses the ECDHE parameters in a\0A *                  TLS ServerKeyExchange handshake message.\0A *\0A * \5Cnote            In a TLS handshake, this is the how the client\0A *                  sets up its ECDHE context from the server's public\0A *                  ECDHE key material.\0A *\0A * \5Csee             ecp.h\0A *\0A * \5Cparam ctx       The ECDHE context to use. This must be initialized.\0A * \5Cparam buf       On input, \5Cc *buf must be the start of the input buffer.\0A *                  On output, \5Cc *buf is updated to point to the end of the\0A *                  data that has been read. On success, this is the first byte\0A *                  past the end of the ServerKeyExchange parameters.\0A *                  On error, this is the point at which an error has been\0A *                  detected, which is usually not useful except to debug\0A *                  failures.\0A * \5Cparam end       The end of the input buffer.\0A *\0A * \5Creturn          \5Cc 0 on success.\0A * \5Creturn          An \5Cc MBEDTLS_ERR_ECP_XXX error code on failure.\0A *\0A */\0Aint mbedtls_ecdh_read_params(mbedtls_ecdh_context *ctx,\0A                             const unsigned char **buf,\0A                             const unsigned char *end);\0A\0A/**\0A * \5Cbrief           This function sets up an ECDH context from an EC key.\0A *\0A *                  It is used by clients and servers in place of the\0A *                  ServerKeyExchange for static ECDH, and imports ECDH\0A *                  parameters from the EC key information of a certificate.\0A *\0A * \5Csee             ecp.h\0A *\0A * \5Cparam ctx       The ECDH context to set up. This must be initialized.\0A * \5Cparam key       The EC key to use. This must be initialized.\0A * \5Cparam side      Defines the source of the key. Possible values are:\0A *                  - #MBEDTLS_ECDH_OURS: The key is ours.\0A *                  - #MBEDTLS_ECDH_THEIRS: The key is that of the peer.\0A *\0A * \5Creturn          \5Cc 0 on success.\0A * \5Creturn          Another \5Cc MBEDTLS_ERR_ECP_XXX error code on failure.\0A *\0A */\0Aint mbedtls_ecdh_get_params(mbedtls_ecdh_context *ctx,\0A                            const mbedtls_ecp_keypair *key,\0A                            mbedtls_ecdh_side side);\0A\0A/**\0A * \5Cbrief           This function generates a public key and exports it\0A *                  as a TLS ClientKeyExchange payload.\0A *\0A *                  This is the second function used by a TLS client for ECDH(E)\0A *                  ciphersuites.\0A *\0A * \5Csee             ecp.h\0A *\0A * \5Cparam ctx       The ECDH context to use. This must be initialized\0A *                  and bound to a group, the latter usually by\0A *                  mbedtls_ecdh_read_params().\0A * \5Cparam olen      The address at which to store the number of Bytes written.\0A *                  This must not be \5Cc NULL.\0A * \5Cparam buf       The destination buffer. This must be a writable buffer\0A *                  of length \5Cp blen Bytes.\0A * \5Cparam blen      The size of the destination buffer \5Cp buf in Bytes.\0A * \5Cparam f_rng     The RNG function to use. This must not be \5Cc NULL.\0A * \5Cparam p_rng     The RNG context to be passed to \5Cp f_rng. This may be\0A *                  \5Cc NULL in case \5Cp f_rng doesn't need a context argument.\0A *\0A * \5Creturn          \5Cc 0 on success.\0A * \5Creturn          #MBEDTLS_ERR_ECP_IN_PROGRESS if maximum number of\0A *                  operations was reached: see \5Cc mbedtls_ecp_set_max_ops().\0A * \5Creturn          Another \5Cc MBEDTLS_ERR_ECP_XXX error code on failure.\0A */\0Aint mbedtls_ecdh_make_public(mbedtls_ecdh_context *ctx, size_t *olen,\0A                             unsigned char *buf, size_t blen,\0A                             int (*f_rng)(void *, unsigned char *, size_t),\0A                             void *p_rng);\0A\0A/**\0A * \5Cbrief       This function parses and processes the ECDHE payload of a\0A *              TLS ClientKeyExchange message.\0A *\0A *              This is the third function used by a TLS server for ECDH(E)\0A *              ciphersuites. (It is called after mbedtls_ecdh_setup() and\0A *              mbedtls_ecdh_make_params().)\0A *\0A * \5Csee         ecp.h\0A *\0A * \5Cparam ctx   The ECDH context to use. This must be initialized\0A *              and bound to a group, for example via mbedtls_ecdh_setup().\0A * \5Cparam buf   The pointer to the ClientKeyExchange payload. This must\0A *              be a readable buffer of length \5Cp blen Bytes.\0A * \5Cparam blen  The length of the input buffer \5Cp buf in Bytes.\0A *\0A * \5Creturn      \5Cc 0 on success.\0A * \5Creturn      An \5Cc MBEDTLS_ERR_ECP_XXX error code on failure.\0A */\0Aint mbedtls_ecdh_read_public(mbedtls_ecdh_context *ctx,\0A                             const unsigned char *buf, size_t blen);\0A\0A/**\0A * \5Cbrief           This function derives and exports the shared secret.\0A *\0A *                  This is the last function used by both TLS client\0A *                  and servers.\0A *\0A * \5Cnote            If \5Cp f_rng is not NULL, it is used to implement\0A *                  countermeasures against side-channel attacks.\0A *                  For more information, see mbedtls_ecp_mul().\0A *\0A * \5Csee             ecp.h\0A\0A * \5Cparam ctx       The ECDH context to use. This must be initialized\0A *                  and have its own private key generated and the peer's\0A *                  public key imported.\0A * \5Cparam olen      The address at which to store the total number of\0A *                  Bytes written on success. This must not be \5Cc NULL.\0A * \5Cparam buf       The buffer to write the generated shared key to. This\0A *                  must be a writable buffer of size \5Cp blen Bytes.\0A * \5Cparam blen      The length of the destination buffer \5Cp buf in Bytes.\0A * \5Cparam f_rng     The RNG function to use. This must not be \5Cc NULL.\0A * \5Cparam p_rng     The RNG context. This may be \5Cc NULL if \5Cp f_rng\0A *                  doesn't need a context argument.\0A *\0A * \5Creturn          \5Cc 0 on success.\0A * \5Creturn          #MBEDTLS_ERR_ECP_IN_PROGRESS if maximum number of\0A *                  operations was reached: see \5Cc mbedtls_ecp_set_max_ops().\0A * \5Creturn          Another \5Cc MBEDTLS_ERR_ECP_XXX error code on failure.\0A */\0Aint mbedtls_ecdh_calc_secret(mbedtls_ecdh_context *ctx, size_t *olen,\0A                             unsigned char *buf, size_t blen,\0A                             int (*f_rng)(void *, unsigned char *, size_t),\0A                             void *p_rng);\0A\0A#if defined(MBEDTLS_ECP_RESTARTABLE)\0A/**\0A * \5Cbrief           This function enables restartable EC computations for this\0A *                  context.  (Default: disabled.)\0A *\0A * \5Csee             \5Cc mbedtls_ecp_set_max_ops()\0A *\0A * \5Cnote            It is not possible to safely disable restartable\0A *                  computations once enabled, except by free-ing the context,\0A *                  which cancels possible in-progress operations.\0A *\0A * \5Cparam ctx       The ECDH context to use. This must be initialized.\0A */\0Avoid mbedtls_ecdh_enable_restart(mbedtls_ecdh_context *ctx);\0A#endif /* MBEDTLS_ECP_RESTARTABLE */\0A\0A#ifdef __cplusplus\0A}\0A#endif\0A\0A#endif /* ecdh.h */\0A\00" }
