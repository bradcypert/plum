ls_gcm_crypt_and_tag(&ctx, MBEDTLS_GCM_DECRYPT,\0A                                            pt_len_test_data[i],\0A                                            iv_test_data[iv_index_test_data[i]],\0A                                            iv_len_test_data[i],\0A                                            additional_test_data[add_index_test_data[i]],\0A                                            add_len_test_data[i],\0A                                            ct_test_data[j * 6 + i], buf, 16, tag_buf);\0A\0A            if (ret != 0) {\0A                goto exit;\0A            }\0A\0A            if (memcmp(buf, pt_test_data[pt_index_test_data[i]],\0A                       pt_len_test_data[i]) != 0 ||\0A                memcmp(tag_buf, tag_test_data[j * 6 + i], 16) != 0) {\0A                ret = 1;\0A                goto exit;\0A            }\0A\0A            mbedtls_gcm_free(&ctx);\0A\0A            if (verbose != 0) {\0A                mbedtls_printf(\22passed\5Cn\22);\0A            }\0A\0A            mbedtls_gcm_init(&ctx);\0A\0A            if (verbose != 0) {\0A                mbedtls_printf(\22  AES-GCM-%3d #%d split (%s): \22,\0A                               key_len, i, \22enc\22);\0A            }\0A\0A            ret = mbedtls_gcm_setkey(&ctx, cipher,\0A                                     key_test_data[key_index_test_data[i]],\0A                                     key_len);\0A            if (ret != 0) {\0A                goto exit;\0A            }\0A\0A            ret = mbedtls_gcm_starts(&ctx, MBEDTLS_GCM_ENCRYPT,\0A                                     iv_test_data[iv_index_test_data[i]],\0A                                     iv_len_test_data[i]);\0A            if (ret != 0) {\0A                goto exit;\0A            }\0A\0A            ret = mbedtls_gcm_update_ad(&ctx,\0A                                        additional_test_data[add_index_test_data[i]],\0A                                        add_len_test_data[i]);\0A            if (ret != 0) 