@.str55710 = private global { i64, i64, [35766 x i8] } { i64 -1, i64 35765, [35766 x i8] c"/// One header. `name` is as it appeared on the wire; header names are\0A/// case-insensitive in HTTP, so compare with care.\0Apub struct Header { pub name: String, pub value: String }\0A/// A complete response: status, headers, and the whole body as raw bytes.\0A/// Use Response.text to decode UTF-8 explicitly.\0Apub struct Response { pub status: Int, pub headers: Array[Header], pub body: Bytes }\0A/// A response's head, before the body has been read.\0A///\0A/// `leftover_body` is whatever arrived in the same read as the headers\0A/// — a body does not begin on a tidy packet boundary, so those bytes\0A/// have to be handed on rather than dropped.\0Apub struct Head { pub status: Int, pub headers: Array[Header], pub leftover_body: Bytes }\0A/// An incoming request, with its body preserved as raw bytes.\0A/// Use Request.text to decode UTF-8 explicitly.\0Apub struct Request { pub method: String, pub path: String, pub headers: Array[Header], pub body: Bytes }\0A/// A request's first line, split.\0Apub struct RequestLine { pub method: String, pub path: String }\0A/// A request's head, before its body has been read. `leftover_body`\0A/// carries the bytes that arrived alongside the headers.\0Apub struct RequestHead { pub method: String, pub path: String, pub headers: Array[Header], pub leftover_body: Bytes }\0A\0Aextern \22C\22 {\0A    fn tls_connect(host: CStr, port: Int) -> Int;\0A    fn tls_send(handle: Int, buf: CStr, len: Int) -> Int;\0A    fn tls_recv_n(handle: Int, max_len: Int) -> Int;\0A    fn tls_recv_data() -> CStr;\0A    fn tls_close(handle: Int) -> Unit;\0A}\0A\0A// Keep transport policy in one place: explicit byte counts, clean EOF,\0A// and errors have identical meanings for plain TCP and TLS.\0Alet http_read (fd: Int) (secure: Int) (max_len: Int): Result[Bytes, String] =\0A    if secure == 0 { Net.read_bytes(fd, max_len) }\0A    else { unsafe {\0A        let n = tls_recv_n(fd, max_len);\0A        if n < 0 { Err(\22https client: read failed\22) }\0A        else { Ok(Bytes.from_cstr(tls_recv_data(), n)) }\0A    } }\0A\0Alet http_write (fd: Int) (secure: Int) (data: Bytes): Result[Int, String] =\0A    if secure == 0 { Net.write_bytes(fd, data) }\0A    else { unsafe {\0A        let len = data.len();\0A        let n = tls_send(fd, data.as_cstr(), len);\0A        if n < 0 { Err(\22https client: write failed\22) } else { Ok(n) }\0A    } }\0A\0A// Bytes.slice copies. Slice only a bounded chunk, never the whole unsent\0A// suffix, so repeated short writes do not copy the body quadratically.\0Alet http_write_all (fd: Int) (secure: Int) (data: Bytes) (offset: Int): Result[Unit, String] =\0A    if offset >= data.len() { Ok(()) }\0A    else {\0A        let end = offset + Int.min(16384, data.len() - offset);\0A        match http_write(fd, secure, data.slice(offset, end)) {\0A            Err(e) => Err(e),\0A            Ok(n) => if n <= 0 || n > end - offset { Err(\22http: write made invalid progress\22) }\0A                else { http_write_all(fd, secure, data, offset + n) },\0A        }\0A    }\0A\0A// Serialize only the head. Keep the body as its existing RC buffer rather\0A// than allocating another whole-body copy just to prepend HTTP metadata.\0Astruct HttpWire { head: Bytes, body: Bytes }\0Alet http_send (fd: Int) (secure: Int) (wire: HttpWire): Result[Unit, String] =\0A    http_write_all(fd, secure, wire.head, 0)\0A        |> Result.and_then(_, |ignored| http_write_all(fd, secure, wire.body, 0))\0A\0A/// Decodes the request body as UTF-8. Invalid UTF-8 returns Err; the raw\0A/// body remains available as Bytes. No Content-Type or charset conversion\0A/// is inferred, and valid text shares the body's reference-counted storage.\0Apub let Request.text (req: Request): Result[String, String] = req.body.as_string()\0A\0A/// Decodes the response body as UTF-8, returning Err for invalid text.\0A/// This validates without copying the payload; it does not decompress or\0A/// interpret Content-Type. Use body directly for arbitrary binary data.\0Apub let Response.text (resp: Response): Result[String, String] = resp.body.as_string()\0A\0A/// URL parsing lives in `Url` now; this only decides which URLs an\0A/// HTTP CLIENT is willing to act on, which is a different question\0A/// and the only part that ever belonged here.\0A///\0A/// The two rejection messages are unchanged, deliberately: they are\0A/// what a user sees and what `bootstrap/net-smoke` asserts. What did\0A/// change is that a URL this client cannot USE is now told apart from\0A/// a URL that is not well-formed. `nope://h/x` parses fine and is\0A/// refused for its scheme, while `h/x` is refused for having none,\0A/// and those used to be the same message.\0A///\0Alet http_parse_url (url: String): Result[Url.Url, String] =\0A    match Url.parse(url) {\0A        Err(e) => Err(\22http client: \22.concat(e)),\0A        Ok(u) =>\0A            if u.scheme == \22https\22 || u.scheme == \22http\22 { Ok(u) }\0A            else { Err(\22http client: url must start with http:// or https://\22) },\0A    }\0A\0A// RFC 9110 token syntax, shared by methods and field names. Scan bytes:\0A// tokens are ASCII even when the surrounding String contains UTF-8.\0Alet http_token_byte (c: Int): Bool =\0A    (c >= 65 && c <= 90) || (c >= 97 && c <= 122) || (c >= 48 && c <= 57)\0A        || c == 33 || c == 35 || c == 36 || c == 37 || c == 38 || c == 39\0A        || c == 42 || c == 43 || c == 45 || c == 46 || c == 94 || c == 95\0A        || c == 96 || c == 124 || c == 126\0A\0Alet http_token_ok_acc (b: Bytes) (i: Int): Bool =\0A    if i >= b.len() { true }\0A    else { match b.at(i) {\0A        Some(c) => if http_token_byte(c) { http_token_ok_acc(b, i + 1) } else { false },\0A        None => false,\0A    } }\0A\0Alet http_token_ok (text: String): Bool =\0A    !String.is_empty(text) && http_token_ok_acc(text.as_bytes(), 0)\0A\0A// Field values allow SP and HTAB; targets and authorities allow neither.\0A// Bytes above ASCII are preserved, including existing UTF-8 field values.\0Alet http_text_ok_acc (b: Bytes) (i: Int) (field_value: Bool): Bool =\0A    if i >= b.len() { true }\0A    else { match b.at(i) {\0A        Some(c) => {\0A            let ok = if field_value { c == 9 || (c >= 32 && c != 127) } else { c > 32 && c != 127 };\0A            if ok { http_text_ok_acc(b, i + 1, field_value) } else { false }\0A        },\0A        None => false,\0A    } }\0A\0Alet http_validate_headers (headers: Array[Header]) (i: Int): Result[Unit, String] =\0A    if i >= headers.len() { Ok(()) }\0A    else if !http_token_ok(headers[i].name) { Err(\22http: invalid header name\22) }\0A    else if !http_text_ok_acc(headers[i].value.as_bytes(), 0, true) { Err(\22http: invalid header value\22) }\0A    else { http_validate_headers(headers, i + 1) }\0A\0A// Public structs are unchecked data. Validate the actual interpolated fields\0A// here, even when a Url was constructed without going through Url.parse.\0Alet http_build_request (method: String) (parsed: Url.Url) (headers: Array[Header]) (body: Bytes): Result[HttpWire, String] = {\0A    let target = Url.request_target(parsed);\0A    let authority = Url.authority(parsed);\0A    if !http_token_ok(method) { Err(\22http client: invalid method\22) }\0A    else if String.is_empty(target) || !http_text_ok_acc(target.as_bytes(), 0, false) { Err(\22http client: invalid request target\22) }\0A    else if String.is_empty(authority) || !http_text_ok_acc(authority.as_bytes(), 0, false) { Err(\22http client: invalid authority\22) }\0A    else { Result.map(http_validate_headers(headers, 0), |ignored| {\0A        let extra_header_lines = Array.fold(headers, \22\22, |acc, h| acc.concat(h.name).concat(\22: \22).concat(h.value).concat(\22\5Cr\5Cn\22));\0A        let content_length_line = if body.is_empty() { \22\22 } else { \22Content-Length: \22.concat(body.len().to_string()).concat(\22\5Cr\5Cn\22) };\0A        let head = method.concat(\22 \22).concat(target).concat(\22 HTTP/1.1\5Cr\5Cn\22)\0A            .concat(\22Host: \22).concat(authority).concat(\22\5Cr\5Cn\22)\0A            .concat(\22Connection: close\5Cr\5Cn\22)\0A            .concat(content_length_line)\0A            .concat(extra_header_lines)\0A            .concat(\22\5Cr\5Cn\22);\0A        HttpWire { head: head.as_bytes(), body: body }\0A    }) }\0A}\0A\0A// Search byte offsets, retaining the last three bytes as overlap after a\0A// read. Only the head is decoded later: a body coalesced with the head may\0A// begin with NUL, invalid UTF-8, or half of a multibyte character.\0Alet http_head_separator (raw: Bytes) (i: Int): Option[Int] =\0A    if i + 3 >= raw.len() { None }\0A    else if http_byte(raw, i) == 13 && http_byte(raw, i + 1) == 10\0A        && http_byte(raw, i + 2) == 13 && http_byte(raw, i + 3) == 10 { Some(i) }\0A    else { http_head_separator(raw, i + 1) }\0A\0Alet http_recv_headers_from (fd: Int) (secure: Int) (acc: Bytes) (start: Int): Result[Bytes, String] =\0A    match http_head_separator(acc, start) {\0A        Some(_) => Ok(acc),\0A        None => match http_read(fd, secure, 4096) {\0A            Err(e) => Err(e),\0A            Ok(chunk) => if chunk.is_empty() { Err(\22http client: connection closed before the response headers were complete\22) }\0A                else { http_recv_headers_from(fd, secure, acc.concat(chunk), Int.max(0, acc.len() - 3)) },\0A        },\0A    }\0A\0Alet http_recv_headers_acc (fd: Int) (secure: Int) (acc: Bytes): Result[Bytes, String] =\0A    http_recv_headers_from(fd, secure, acc, 0)\0A\0Alet http_status_valid (status: Int): Bool = status >= 100 && status <= 599\0Alet http_informational (status: Int): Bool = status >= 100 && status < 200\0A\0A// RFC 9112 section 6.3: these responses end at the header terminator,\0A// before Content-Length or Transfer-Encoding can select body framing.\0Alet http_response_bodyless (method: String) (status: Int): Bool =\0A    method == \22HEAD\22 || http_informational(status) || status == 204 || status == 304\0A\0Alet http_tunnel (method: String) (status: Int): Bool =\0A    method == \22CONNECT\22 && status >= 200 && status < 300\0A\0Alet http_parse_status_line (line: String): Result[Int, String] = {\0A    let parts = line.split(\22 \22);\0A    if parts.len() < 2 { Err(\22http client: malformed status line: \22.concat(line)) }\0A    else if parts[0] != \22HTTP/1.0\22 && parts[0] != \22HTTP/1.1\22 {\0A        Err(\22http client: unsupported HTTP version\22)\0A    } else {\0A        let code = parts[1].as_bytes();\0A        if code.len() != 3 || !http_digit(http_byte(code, 0)) || !http_digit(http_byte(code, 1)) || !http_digit(http_byte(code, 2)) {\0A            Err(\22http client: malformed status code\22)\0A        } else { match String.parse_int(parts[1]) {\0A            Err(e) => Err(\22http client: malformed status code: \22.concat(e)),\0A            Ok(status) => if http_status_valid(status) { Ok(status) } else { Err(\22http client: invalid response status\22) },\0A        } }\0A    }\0A}\0A\0Alet http_byte (b: Bytes) (i: Int): Int = match b.at(i) { Some(c) => c, None => -1 }\0Alet http_ows (c: Int): Bool = c == 32 || c == 9\0Alet http_ows_start (b: Bytes) (i: Int): Int =\0A    if http_ows(http_byte(b, i)) { http_ows_start(b, i + 1) } else { i }\0Alet http_ows_end (b: Bytes) (i: Int): Int =\0A    if http_ows(http_byte(b, i - 1)) { http_ows_end(b, i - 1) } else { i }\0A\0A// Only SP/HTAB are optional whitespace. Generic Unicode trimming would\0A// erase malformed controls. String.slice uses codepoints, Bytes uses octets.\0Alet http_trim_ows (s: String): String = {\0A    let b = s.as_bytes();\0A    let start = http_ows_start(b, 0);\0A    let end = http_ows_end(b, b.len());\0A    String.slice(s, start, String.char_len(s) - (b.len() - end))\0A}\0A\0Alet http_parse_header_line (line: String): Result[Header, String] =\0A    match String.index_of(line, \22:\22) {\0A        None => Err(\22http: malformed header line\22),\0A        Some(i) => {\0A            let name = String.slice(line, 0, i);\0A            let value = http_trim_ows(String.slice(line, i + 1, String.char_len(line)));\0A            if !http_token_ok(name) { Err(\22http: invalid header name\22) }\0A            else if !http_text_ok_acc(value.as_bytes(), 0, true) { Err(\22http: invalid header value\22) }\0A            else { Ok(Header { name: name, value: value }) }\0A        },\0A    }\0A\0A// Tail recursion keeps the stack bounded and moves the accumulator into\0A// push. Never silently discard a malformed field (including obs-fold).\0Alet http_parse_headers_acc (lines: Array[String]) (i: Int) (acc: Array[Header]): Result[Array[Header], String] =\0A    if i >= lines.len() { Ok(acc) }\0A    else { match http_parse_header_line(lines[i]) {\0A        Err(e) => Err(e),\0A        Ok(h) => http_parse_headers_acc(lines, i + 1, acc.push(h)),\0A    } }\0A\0Alet http_parse_headers (lines: Array[String]): Result[Array[Header], String] =\0A    http_parse_headers_acc(lines, 0, [])\0A\0A// Parsed names are ASCII tokens; folding never changes their spelling in\0A// the public Header. The same comparison serves Host and body framing.\0Alet http_ascii_lower (c: Int): Int = if c >= 65 && c <= 90 { c + 32 } else { c }\0Alet http_ascii_equal (a: Bytes) (b: Bytes) (i: Int): Bool =\0A    if i >= a.len() { true }\0A    else if http_ascii_lower(http_byte(a, i)) != http_ascii_lower(http_byte(b, i)) { false }\0A    else { http_ascii_equal(a, b, i + 1) }\0A\0Alet http_header_named (header: Header) (name: String): Bool =\0A    header.name.len() == name.len() && http_ascii_equal(header.name.as_bytes(), name.as_bytes(), 0)\0A\0Alet http_find_header (headers: Array[Header]) (name: String): Option[String] =\0A    Option.map(Array.find(headers, |h| http_header_named(h, name)), |h| h.value)\0A\0A// Decode exactly the head, never the body. Byte offsets stay byte offsets\0A// even when a header contains multibyte UTF-8.\0Alet http_parse_head (raw: Bytes): Result[Head, String] =\0A    match http_head_separator(raw, 0) {\0A        None => Err(\22http client: incomplete response head\22),\0A        Some(i) => raw.slice(0, i).as_string() |> Result.and_then(_, |text| {\0A            let lines = text.split(\22\5Cr\5Cn\22);\0A            http_parse_status_line(lines[0]) |> Result.and_then(_, |status|\0A                Result.map(http_parse_headers(Array.drop(lines, 1)), |headers| Head {\0A                    status: status, headers: headers, leftover_body: raw.slice(i + 4, raw.len()),\0A                }))\0A        }),\0A    }\0A\0Alet http_recv_body_by_length_acc (fd: Int) (secure: Int) (acc: Bytes) (remaining: Int): Result[Bytes, String] =\0A    if remaining <= 0 { Ok(acc) }\0A    else { match http_read(fd, secure, Int.min(remaining, 16384)) {\0A        Err(e) => Err(e),\0A        Ok(chunk) => if chunk.is_empty() { Err(\22http client: connection closed before the full response body was received\22) }\0A            else { http_recv_body_by_length_acc(fd, secure, acc.concat(chunk), remaining - chunk.len()) },\0A    } }\0A\0Alet http_recv_body_until_close_acc (fd: Int) (secure: Int) (acc: Bytes): Result[Bytes, String] =\0A    match http_read(fd, secure, 4096) {\0A        Err(e) => Err(e),\0A        Ok(chunk) => if chunk.is_empty() { Ok(acc) }\0A            else { http_recv_body_until_close_acc(fd, secure, acc.concat(chunk)) },\0A    }\0A\0A// Response framing needs the initiating method as well as the status.\0A// Ignore even buffered content for a bodyless response; never allocate a\0A// receive buffer based on its representation's advertised Content-Length.\0Alet http_read_body (fd: Int) (secure: Int) (method: String) (status: Int) (headers: Array[Header]) (leftover_body: Bytes): Result[Bytes, String] =\0A    if http_response_bodyless(method, status) { Ok(Bytes.empty()) }\0A    else if http_tunnel(method, status) { Err(\22http client: CONNECT tunnels are not supported\22) }\0A    else { match http_find_header(headers, \22Content-Length\22) {\0A        Some(cl) => match String.parse_int(cl) {\0A            Err(e) => Err(\22http: invalid Content-Length header: \22.concat(e)),\0A            Ok(content_length) => http_recv_body_by_length_acc(fd, secure, leftover_body, content_length - leftover_body.len()),\0A        },\0A        None => match http_find_header(headers, \22Transfer-Encoding\22) {\0A            Some(te) => Err(\22http: Transfer-Encoding (\22.concat(te).concat(\22) is not supported yet\22)),\0A            None => http_recv_body_until_close_acc(fd, secure, leftover_body),\0A        },\0A    } }\0A\0A/// The REQUEST-side sibling of `http_read_body` above — same `Content-\0A/// Length`/`Transfer-Encoding` handling, but a DELIBERATELY different\0A/// answer when NEITHER is present: an EMPTY body (`leftover_body` as-\0A/// is), never \22read until the connection closes.\22 Originally shared\0A/// `http_read_body` directly for both — a real, live DEADLOCK surfaced\0A/// exactly that assumption was wrong, not just imprecise: a bodyless\0A/// `GET` (no `Content-Length`, since there's no body to measure) has no\0A/// reason to ever close its OWN write side, so a server blocked\0A/// \22reading until close\22 on it hangs forever waiting for a body that\0A/// will never arrive — confirmed directly (a real test hung against a\0A/// real socket, root-caused by isolating each step with `println`\0A/// debugging until the exact hang site was found), not merely\0A/// theorized. The response side's OWN \22no length header -> read until\0A/// close\22 answer stays correct on ITS side: every request this client\0A/// sends already includes `Connection: close`, so that read is bounded\0A/// by the SERVER eventually closing once it's done writing — a\0A/// guarantee nothing analogous exists for on the request side.\0Alet http_read_request_body (fd: Int) (headers: Array[Header]) (leftover_body: Bytes): Result[Bytes, String] =\0A    match http_find_header(headers, \22Content-Length\22) {\0A        Some(cl) => match String.parse_int(cl) {\0A            Err(e) => Err(\22http: invalid Content-Length header: \22.concat(e)),\0A            Ok(content_length) => http_recv_body_by_length_acc(fd, 0, leftover_body, content_length - leftover_body.len()),\0A        },\0A        None => match http_find_header(headers, \22Transfer-Encoding\22) {\0A            Some(te) => Err(\22http: Transfer-Encoding (\22.concat(te).concat(\22) is not supported yet\22)),\0A            None => Ok(leftover_body),\0A        },\0A    }\0A\0A// Carry only unread bytes to the next head. A direct tail call releases\0A// the previous head instead of retaining one continuation per interim\0A// response. The count also bounds a peer's endless informational stream.\0Alet http_recv_final_head (fd: Int) (secure: Int) (pending: Bytes) (interim_count: Int): Result[Head, String] =\0A    match http_recv_headers_acc(fd, secure, pending) {\0A        Err(e) => Err(e),\0A        Ok(raw) => match http_parse_head(raw) {\0A            Err(e) => Err(e),\0A            Ok(head) => if head.status == 101 { Err(\22http client: protocol upgrades are not supported\22) }\0A                else if http_informational(head.status) {\0A                    if interim_count >= 100 { Err(\22http client: too many informational responses\22) }\0A                    else { http_recv_final_head(fd, secure, head.leftover_body, interim_count + 1) }\0A                } else { Ok(head) },\0A        },\0A    }\0A\0Alet http_do_request (fd: Int) (secure: Int) (method: String) (wire: HttpWire): Result[Response, String] =\0A    http_send(fd, secure, wire)\0A        |> Result.and_then(_, |ignored| http_recv_final_head(fd, secure, Bytes.empty(), 0))\0A        |> Result.and_then(_, |head| Result.map(http_read_body(fd, secure, method, head.status, head.headers, head.leftover_body), |response_body| Response { status: head.status, headers: head.headers, body: response_body }))\0A\0A/// Sends a request with a raw byte body over HTTP or HTTPS.\0A/// Encode text with String.as_bytes(); decode the reply with Response.text.\0A/// Reads use bounded chunks, but the complete body is buffered in memory.\0A/// There is currently no total header/body size limit or streaming API.\0A///\0A/// Sends a request over HTTP or HTTPS. HTTPS verifies the peer's\0A/// certificate and hostname using the native TLS trust-store integration.\0A///\0A/// Invalid URL text, methods, header names, and header values return Err\0A/// before connecting. Methods and names must be nonempty ASCII tokens;\0A/// values may contain spaces, HTAB, and UTF-8, but no other ASCII controls\0A/// or DEL. Bodies are not subject to protocol-field validation.\0A///\0A/// Reads past up to 100 informational responses to the final response.\0A/// HEAD, 204, and 304 responses have an empty body regardless of framing\0A/// headers. Protocol upgrades (101) and successful CONNECT tunnels return\0A/// Err and close the connection; this API cannot hand off a transport.\0Apub let request (method: String) (url: String) (headers: Array[Header]) (body: Bytes): Result[Response, String] =\0A    http_parse_url(url)\0A        |> Result.and_then(_, |parsed| http_build_request(method, parsed, headers, body)\0A            |> Result.and_then(_, |wire| if parsed.scheme == \22https\22 {\0A                let fd = unsafe { tls_connect(parsed.host.as_cstr(), parsed.port) };\0A                if fd < 0 { Err(\22https client: TLS connection failed\22) }\0A                else { let result = http_do_request(fd, 1, method, wire); unsafe { tls_close(fd) }; result }\0A            } else {\0A                Net.connect_to(parsed.host, parsed.port) |> Result.and_then(_, |fd| {\0A                    let result = http_do_request(fd, 0, method, wire);\0A                    Net.close(fd);\0A                    result\0A                })\0A            }))\0A\0A/// Fetches a URL and reads the whole response.\0A///\0A/// Supports both `http://` and `https://`; HTTPS uses the native TLS\0A/// transport with platform trust-store and hostname verification.\0A///\0A/// Redirects are NOT followed: a 301 or 302 comes back as itself, with\0A/// its `Location` header, so the caller decides. Following one changes\0A/// which host you are talking to, which is not a decision a library\0A/// should make quietly.\0Apub let get (url: String): Result[Response, String] = request(\22GET\22, url, [], Bytes.empty())\0A\0A/// POSTs raw bytes and reads the whole response. For text, pass\0A/// text.as_bytes() and use Response.text on the result. Sets `Content-Length`;\0A/// set `Content-Type` yourself if the server needs one.\0A///\0A/// Redirects are not followed — see `Http.get`.\0Apub let post (url: String) (body: Bytes): Result[Response, String] = request(\22POST\22, url, [], body)\0A\0A// --- HTTP server ---\0A\0Alet http_parse_request_line (line: String): Result[RequestLine, String] = {\0A    let parts = line.split(\22 \22);\0A    if parts.len() != 3 { Err(\22http server: malformed request line\22) }\0A    else if !http_token_ok(parts[0]) || String.is_empty(parts[1]) || !http_text_ok_acc(parts[1].as_bytes(), 0, false) {\0A        Err(\22http server: malformed request line\22)\0A    } else if parts[2] != \22HTTP/1.1\22 && parts[2] != \22HTTP/1.0\22 {\0A        Err(\22http server: unsupported HTTP version\22)\0A    } else { Ok(RequestLine { method: parts[0], path: parts[1] }) }\0A}\0A\0Alet http_digit (c: Int): Bool = c >= 48 && c <= 57\0Alet http_hex (c: Int): Bool = http_digit(c) || (c >= 65 && c <= 70) || (c >= 97 && c <= 102)\0Alet http_reg_name_byte (c: Int): Bool =\0A    (c >= 65 && c <= 90) || (c >= 97 && c <= 122) || http_digit(c)\0A        || c == 45 || c == 46 || c == 95 || c == 126\0A        || c == 33 || c == 36 || c == 38 || c == 39 || c == 40 || c == 41\0A        || c == 42 || c == 43 || c == 44 || c == 59 || c == 61\0A\0Alet http_port_ok (b: Bytes) (i: Int): Bool =\0A    if i >= b.len() { true }\0A    else if http_digit(http_byte(b, i)) { http_port_ok(b, i + 1) } else { false }\0A\0Alet http_reg_name_ok (b: Bytes) (i: Int): Bool =\0A    if i >= b.len() { true }\0A    else if http_byte(b, i) == 58 { http_port_ok(b, i + 1) }\0A    else if http_byte(b, i) == 37 {\0A        if http_hex(http_byte(b, i + 1)) && http_hex(http_byte(b, i + 2)) { http_reg_name_ok(b, i + 3) } else { false }\0A    } else if http_reg_name_byte(http_byte(b, i)) { http_reg_name_ok(b, i + 1) } else { false }\0A\0Alet http_hex_ok (b: Bytes) (i: Int): Bool =\0A    if i >= b.len() { true }\0A    else if http_hex(http_byte(b, i)) { http_hex_ok(b, i + 1) } else { false }\0A\0A// IPv4 is special only as an IPv6 suffix: exactly four decimal octets,\0A// no leading zeroes. Elsewhere dotted text can also be a reg-name.\0Alet http_ipv4_ok (s: String): Bool = {\0A    let parts = s.split(\22.\22);\0A    parts.len() == 4 && Array.all(parts, |part| {\0A        let b = part.as_bytes();\0A        b.len() >= 1 && b.len() <= 3 && (b.len() == 1 || http_byte(b, 0) != 48)\0A            && http_port_ok(b, 0) && match String.parse_int(part) { Ok(n) => n <= 255, Err(_) => false }\0A    })\0A}\0A\0Alet http_ipv6_groups (parts: Array[String]) (i: Int) (allow_ipv4: Bool) (count: Int): Int =\0A    if i >= parts.len() { count }\0A    else {\0A        let part = parts[i];\0A        if allow_ipv4 && i == parts.len() - 1 && String.contains(part, \22.\22) {\0A            if http_ipv4_ok(part) { count + 2 } else { -1 }\0A        } else if part.len() >= 1 && part.len() <= 4 && http_hex_ok(part.as_bytes(), 0) {\0A            http_ipv6_groups(parts, i + 1, allow_ipv4, count + 1)\0A        } else { -1 }\0A    }\0A\0Alet http_ipv6_side (s: String) (allow_ipv4: Bool): Int =\0A    if String.is_empty(s) { 0 } else { http_ipv6_groups(s.split(\22:\22), 0, allow_ipv4, 0) }\0A\0Alet http_ipv6_ok (s: String): Bool =\0A    if s.len() > 45 { false }\0A    else { match String.index_of(s, \22::\22) {\0A        None => http_ipv6_side(s, true) == 8,\0A        Some(i) => {\0A           