t is still writing to, and on POSIX leave a zombie until\0A// this program exits, because the only process that could reap it has\0A// stopped tracking it.\0A//\0A// `drop_policy` is where a future choice would live. It is not settable\0A// from Plum today.\0Avoid process_child_free(long long handle) {\0A    PlumProcessSlot *slot = plum_slot_of(handle);\0A    if (slot == NULL) return;\0A    PlumChildState *c = slot->child;\0A    if (c != NULL) {\0A        if (!c->finished) {\0A            (void)process_terminate(handle, 1);\0A#if defined(_WIN32)\0A            HANDLE h = (HANDLE)(intptr_t)c->pid;\0A            WaitForSingleObject(h, 5000);\0A            DWORD code = 0;\0A            if (!GetExitCodeProcess(h, &code)) code = (DWORD)-1;\0A            plum_child_collect(handle, (long long)(int)code);\0A#else\0A            int status = 0;\0A            pid_t r;\0A            do { r = waitpid((pid_t)c->pid, &status, 0); } while (r < 0 && errno == EINTR);\0A            plum_child_collect(handle, (r > 0 && WIFEXITED(status)) ? (long long)WEXITSTATUS(status) : -1);\0A#endif\0A        }\0A        free(c->out_path);\0A        free(c->err_path);\0A        free(c->in_path);\0A        free(c);\0A        slot->child = NULL;\0A    }\0A    free(slot->out_data);\0A    free(slot->err_data);\0A    slot->out_data = NULL;\0A    slot->err_data = NULL;\0A    slot->in_use = 0;\0A}\0A\0A// The inherited-stdio counterpart to `plum_spawn_capture`, and the\0A// second place this file needs a platform split. It was missed when the\0A// first one was written -- the POSIX `fork`/`waitpid` here sat outside\0A// any guard and was found by the Windows CI leg, which is what that leg\0A// is for.\0A#if !defined(_WIN32)\0A\0Astatic long long plum_spawn_inherit(const char *program, char **argv) {\0A    pid_t pid = fork();\0A    if (pid < 0) return -1;\0A    if (pid == 0) {\0A        execvp(program, argv);\0A        _exit(127);\0A    }\0A    int status = 0;\0A    if (waitpid(pid, &status, 0) < 0) return -1;\0A    if (WIFEXITED(status)) return WEXITSTATUS(status);\0A    // 128 + signal is the shell convention, kept so `plum run` reports\0A    // a killed child the way anything else in a pipeline would.\0A    if (WIFSIGNALED(status)) return 128 + WTERMSIG(status);\0A    return -1;\0A}\0A\0A#else\0A\0Astatic long long plum_spawn_inherit(const char *program, char **argv) {\0A    char *cmdline;\0A    size_t cap = 0;\0A    size_t len = 0;\0A    int i;\0A    STARTUPINFOA si;\0A    PROCESS_INFORMATION pi;\0A    DWORD code = 0;\0A\0A    for (i = 0; argv[i] != NULL; i++) cap += strlen(argv[i]) * 2 + 3;\0A    cap += 1;\0A    cmdline = (char *)malloc(cap);\0A    if (cmdline == NULL) return -1;\0A    for (i = 0; argv[i] != NULL; i++) {\0A        if (plum_win_append_arg(cmdline, cap, &len, argv[i]) != 0) {\0A            free(cmdline);\0A            return -1;\0A        }\0A    }\0A    cmdline[len] = '\5C0';\0A\0A    // No `STARTF_USESTDHANDLES`: leaving the field unset is what makes\0A    // the child inherit this process's console, which is the entire\0A    // point of this function as against `plum_spawn_capture`.\0A    ZeroMemory(&si, sizeof(si));\0A    si.cb = sizeof(si);\0A    ZeroMemory(&pi, sizeof(pi));\0A\0A    if (!CreateProcessA(NULL, cmdline, NULL, NULL, TRUE, 0, NULL, NULL, &si, &pi)) {\0A        free(cmdline);\0A        return -1;\0A    }\0A    CloseHandle(pi.hThread);\0A\0A    WaitForSingleObject(pi.hProcess, INFINITE);\0A    if (!GetExitCodeProcess(pi.hProcess, &code)) code = (DWORD)-1;\0A    CloseHandle(pi.hProcess);\0A    free(cmdline);\0A    (void)program;\0A    return (long long)(int)code;\0A}\0A\0A#endif\0A\0A// Runs a command with stdio INHERITED — no capture, no temp files — and\0A// returns its exit status. `process_run` above is for a caller that\0A// wants the output as a value; this is for a caller that wants the\0A// child to simply BE the program: `plum run` streaming its output as it\0A// happens, and a child that can read stdin.\0A//\0A// Deliberately separate rather than a flag on `process_run`: that one's\0A// whole design is the temp-file capture described above, and threading\0A// \22except don't\22 through it would leave every path harder to read.\0Along long process_run_inherit(const char *program, const char *args_joined, long long argc) {\0A    char *args_copy = strdup(args_joined);\0A    char **argv = malloc(sizeof(char *) * (size_t)(argc + 2));\0A    if (args_copy == NULL || argv == NULL) {\0A        free(args_copy);\0A        free(argv);\0A        return -1;\0A    }\0A    // Same separator-splitting as `process_run` above; see its own note\0A    // on why the first element is special-cased.\0A    argv[0] = (char *)program;\0A    long long idx = 1;\0A    if (argc > 0) {\0A        argv[idx++] = args_copy;\0A        for (char *c = args_copy; *c != '\5C0'; c++) {\0A            if (*c == PLUM_PROC_ARG_SEP) {\0A                *c = '\5C0';\0A                if (idx <= argc) {\0A                    argv[idx++] = c + 1;\0A                }\0A            }\0A        }\0A    }\0A    argv[idx] = NULL;\0A\0A    long long code = plum_spawn_inherit(program, argv);\0A    free(args_copy);\0A    free(argv);\0A    return code;\0A}\0A\00" }
