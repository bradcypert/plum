@.str44412 = private global { i64, i64, [7535 x i8] } { i64 -1, i64 7534, [7535 x i8] c"/**\0A * \5Cfile ssl_ticket.h\0A *\0A * \5Cbrief TLS server ticket callbacks implementation\0A */\0A/*\0A *  Copyright The Mbed TLS Contributors\0A *  SPDX-License-Identifier: Apache-2.0 OR GPL-2.0-or-later\0A */\0A#ifndef MBEDTLS_SSL_TICKET_H\0A#define MBEDTLS_SSL_TICKET_H\0A#include \22mbedtls/private_access.h\22\0A\0A#include \22mbedtls/build_info.h\22\0A\0A/*\0A * This implementation of the session ticket callbacks includes key\0A * management, rotating the keys periodically in order to preserve forward\0A * secrecy, when MBEDTLS_HAVE_TIME is defined.\0A */\0A\0A#include \22mbedtls/ssl.h\22\0A#include \22mbedtls/cipher.h\22\0A\0A#if defined(MBEDTLS_HAVE_TIME)\0A#include \22mbedtls/platform_time.h\22\0A#endif\0A\0A#if defined(MBEDTLS_USE_PSA_CRYPTO)\0A#include \22psa/crypto.h\22\0A#endif\0A\0A#if defined(MBEDTLS_THREADING_C)\0A#include \22mbedtls/threading.h\22\0A#endif\0A\0A#ifdef __cplusplus\0Aextern \22C\22 {\0A#endif\0A\0A#define MBEDTLS_SSL_TICKET_MAX_KEY_BYTES 32          /*!< Max supported key length in bytes */\0A#define MBEDTLS_SSL_TICKET_KEY_NAME_BYTES 4          /*!< key name length in bytes */\0A\0A/**\0A * \5Cbrief   Information for session ticket protection\0A */\0Atypedef struct mbedtls_ssl_ticket_key {\0A    unsigned char MBEDTLS_PRIVATE(name)[MBEDTLS_SSL_TICKET_KEY_NAME_BYTES];\0A    /*!< random key identifier              */\0A#if defined(MBEDTLS_HAVE_TIME)\0A    mbedtls_time_t MBEDTLS_PRIVATE(generation_time); /*!< key generation timestamp (seconds) */\0A#endif\0A    /*! Lifetime of the key in seconds. This is also the lifetime of the\0A     *  tickets created under that key.\0A     */\0A    uint32_t MBEDTLS_PRIVATE(lifetime);\0A#if !defined(MBEDTLS_USE_PSA_CRYPTO)\0A    mbedtls_cipher_context_t MBEDTLS_PRIVATE(ctx);   /*!< context for auth enc/decryption    */\0A#else\0A    mbedtls_svc_key_id_t MBEDTLS_PRIVATE(key);       /*!< key used for auth enc/decryption   */\0A    psa_algorithm_t MBEDTLS_PRIVATE(alg);            /*!< algorithm of auth enc/decryption   */\0A    psa_key_type_t MBEDTLS_PRIVATE(key_type);        /*!< key type                           */\0A    size_t MBEDTLS_PRIVATE(key_bits);                /*!< key length in bits                 */\0A#endif\0A}\0Ambedtls_ssl_ticket_key;\0A\0A/**\0A * \5Cbrief   Context for session ticket handling functions\0A */\0Atypedef struct mbedtls_ssl_ticket_context {\0A    mbedtls_ssl_ticket_key MBEDTLS_PRIVATE(keys)[2]; /*!< ticket protection keys             */\0A    unsigned char MBEDTLS_PRIVATE(active);           /*!< index of the currently active key  */\0A\0A    uint32_t MBEDTLS_PRIVATE(ticket_lifetime);       /*!< lifetime of tickets in seconds     */\0A\0A    /** Callback for getting (pseudo-)random numbers                        */\0A    int(*MBEDTLS_PRIVATE(f_rng))(void *, unsigned char *, size_t);\0A    void *MBEDTLS_PRIVATE(p_rng);                    /*!< context for the RNG function       */\0A\0A#if defined(MBEDTLS_THREADING_C)\0A    mbedtls_threading_mutex_t MBEDTLS_PRIVATE(mutex);\0A#endif\0A}\0Ambedtls_ssl_ticket_context;\0A\0A/**\0A * \5Cbrief           Initialize a ticket context.\0A *                  (Just make it ready for mbedtls_ssl_ticket_setup()\0A *                  or mbedtls_ssl_ticket_free().)\0A *\0A * \5Cparam ctx       Context to be initialized\0A */\0Avoid mbedtls_ssl_ticket_init(mbedtls_ssl_ticket_context *ctx);\0A\0A/**\0A * \5Cbrief           Prepare context to be actually used\0A *\0A * \5Cparam ctx       Context to be set up\0A * \5Cparam f_rng     RNG callback function (mandatory)\0A * \5Cparam p_rng     RNG callback context\0A * \5Cparam cipher    AEAD cipher to use for ticket protection.\0A *                  Recommended value: MBEDTLS_CIPHER_AES_256_GCM.\0A * \5Cparam lifetime  Tickets lifetime in seconds\0A *                  Recommended value: 86400 (one day).\0A *\0A * \5Cnote            It is highly recommended to select a cipher that is at\0A *                  least as strong as the strongest ciphersuite\0A *                  supported. Usually that means a 256-bit key.\0A *\0A * \5Cnote            It is recommended to pick a reasonable lifetime so as not\0A *                  to negate the benefits of forward secrecy.\0A *\0A * \5Cnote            The TLS 1.3 specification states that ticket lifetime must\0A *                  be smaller than seven days. If ticket lifetime has been\0A *                  set to a value greater than seven days in this module then\0A *                  if the TLS 1.3 is configured to send tickets after the\0A *                  handshake it will fail the connection when trying to send\0A *                  the first ticket.\0A *\0A * \5Creturn          0 if successful,\0A *                  or a specific MBEDTLS_ERR_XXX error code\0A */\0Aint mbedtls_ssl_ticket_setup(mbedtls_ssl_ticket_context *ctx,\0A                             int (*f_rng)(void *, unsigned char *, size_t), void *p_rng,\0A                             mbedtls_cipher_type_t cipher,\0A                             uint32_t lifetime);\0A\0A/**\0A * \5Cbrief           Rotate session ticket encryption key to new specified key.\0A *                  Provides for external control of session ticket encryption\0A *                  key rotation, e.g. for synchronization between different\0A *                  machines.  If this function is not used, or if not called\0A *                  before ticket lifetime expires, then a new session ticket\0A *                  encryption key is generated internally in order to avoid\0A *                  unbounded session ticket encryption key lifetimes.\0A *\0A * \5Cparam ctx       Context to be set up\0A * \5Cparam name      Session ticket encryption key name\0A * \5Cparam nlength   Session ticket encryption key name length in bytes\0A * \5Cparam k         Session ticket encryption key\0A * \5Cparam klength   Session ticket encryption key length in bytes\0A * \5Cparam lifetime  Tickets lifetime in seconds\0A *                  Recommended value: 86400 (one day).\0A *\0A * \5Cnote            \5Cc name and \5Cc k are recommended to be cryptographically\0A *                  random data.\0A *\0A * \5Cnote            \5Cc nlength must match sizeof( ctx->name )\0A *\0A * \5Cnote            \5Cc klength must be sufficient for use by cipher specified\0A *                  to \5Cc mbedtls_ssl_ticket_setup\0A *\0A * \5Cnote            It is recommended to pick a reasonable lifetime so as not\0A *                  to negate the benefits of forward secrecy.\0A *\0A * \5Cnote            The TLS 1.3 specification states that ticket lifetime must\0A *                  be smaller than seven days. If ticket lifetime has been\0A *                  set to a value greater than seven days in this module then\0A *                  if the TLS 1.3 is configured to send tickets after the\0A *                  handshake it will fail the connection when trying to send\0A *                  the first ticket.\0A *\0A * \5Creturn          0 if successful,\0A *                  or a specific MBEDTLS_ERR_XXX error code\0A */\0Aint mbedtls_ssl_ticket_rotate(mbedtls_ssl_ticket_context *ctx,\0A                              const unsigned char *name, size_t nlength,\0A                              const unsigned char *k, size_t klength,\0A                              uint32_t lifetime);\0A\0A/**\0A * \5Cbrief           Implementation of the ticket write callback\0A *\0A * \5Cnote            See \5Cc mbedtls_ssl_ticket_write_t for description\0A */\0Ambedtls_ssl_ticket_write_t mbedtls_ssl_ticket_write;\0A\0A/**\0A * \5Cbrief           Implementation of the ticket parse callback\0A *\0A * \5Cnote            See \5Cc mbedtls_ssl_ticket_parse_t for description\0A */\0Ambedtls_ssl_ticket_parse_t mbedtls_ssl_ticket_parse;\0A\0A/**\0A * \5Cbrief           Free a context's content and zeroize it.\0A *\0A * \5Cparam ctx       Context to be cleaned up\0A */\0Avoid mbedtls_ssl_ticket_free(mbedtls_ssl_ticket_context *ctx);\0A\0A#ifdef __cplusplus\0A}\0A#endif\0A\0A#endif /* ssl_ticket.h */\0A\00" }
