@.str41282 = private global { i64, i64, [3120 x i8] } { i64 -1, i64 3119, [3120 x i8] c"/**\0A * \5Cfile psa/crypto_legacy.h\0A *\0A * \5Cbrief Add temporary suppport for deprecated symbols before they are\0A *        removed from the library.\0A *\0A * PSA_WANT_KEY_TYPE_xxx_KEY_PAIR and MBEDTLS_PSA_ACCEL_KEY_TYPE_xxx_KEY_PAIR\0A * symbols are deprecated.\0A * New symols add a suffix to that base name in order to clearly state what is\0A * the expected use for the key (use, import, export, generate, derive).\0A * Here we define some backward compatibility support for uses stil using\0A * the legacy symbols.\0A */\0A/*\0A *  Copyright The Mbed TLS Contributors\0A *  SPDX-License-Identifier: Apache-2.0 OR GPL-2.0-or-later\0A */\0A\0A#ifndef MBEDTLS_PSA_CRYPTO_LEGACY_H\0A#define MBEDTLS_PSA_CRYPTO_LEGACY_H\0A\0A#if defined(PSA_WANT_KEY_TYPE_ECC_KEY_PAIR) //no-check-names\0A#if !defined(PSA_WANT_KEY_TYPE_ECC_KEY_PAIR_BASIC)\0A#define PSA_WANT_KEY_TYPE_ECC_KEY_PAIR_BASIC      1\0A#endif\0A#if !defined(PSA_WANT_KEY_TYPE_ECC_KEY_PAIR_IMPORT)\0A#define PSA_WANT_KEY_TYPE_ECC_KEY_PAIR_IMPORT   1\0A#endif\0A#if !defined(PSA_WANT_KEY_TYPE_ECC_KEY_PAIR_EXPORT)\0A#define PSA_WANT_KEY_TYPE_ECC_KEY_PAIR_EXPORT   1\0A#endif\0A#if !defined(PSA_WANT_KEY_TYPE_ECC_KEY_PAIR_GENERATE)\0A#define PSA_WANT_KEY_TYPE_ECC_KEY_PAIR_GENERATE 1\0A#endif\0A#if !defined(PSA_WANT_KEY_TYPE_ECC_KEY_PAIR_DERIVE)\0A#define PSA_WANT_KEY_TYPE_ECC_KEY_PAIR_DERIVE   1\0A#endif\0A#endif\0A\0A#if defined(PSA_WANT_KEY_TYPE_RSA_KEY_PAIR) //no-check-names\0A#if !defined(PSA_WANT_KEY_TYPE_RSA_KEY_PAIR_BASIC)\0A#define PSA_WANT_KEY_TYPE_RSA_KEY_PAIR_BASIC      1\0A#endif\0A#if !defined(PSA_WANT_KEY_TYPE_RSA_KEY_PAIR_IMPORT)\0A#define PSA_WANT_KEY_TYPE_RSA_KEY_PAIR_IMPORT   1\0A#endif\0A#if !defined(PSA_WANT_KEY_TYPE_RSA_KEY_PAIR_EXPORT)\0A#define PSA_WANT_KEY_TYPE_RSA_KEY_PAIR_EXPORT   1\0A#endif\0A#if !defined(PSA_WANT_KEY_TYPE_RSA_KEY_PAIR_GENERATE)\0A#define PSA_WANT_KEY_TYPE_RSA_KEY_PAIR_GENERATE 1\0A#endif\0A#endif\0A\0A#if defined(MBEDTLS_PSA_ACCEL_KEY_TYPE_ECC_KEY_PAIR) //no-check-names\0A#if !defined(MBEDTLS_PSA_ACCEL_KEY_TYPE_ECC_KEY_PAIR_BASIC)\0A#define MBEDTLS_PSA_ACCEL_KEY_TYPE_ECC_KEY_PAIR_BASIC\0A#endif\0A#if !defined(MBEDTLS_PSA_ACCEL_KEY_TYPE_ECC_KEY_PAIR_IMPORT)\0A#define MBEDTLS_PSA_ACCEL_KEY_TYPE_ECC_KEY_PAIR_IMPORT\0A#endif\0A#if !defined(MBEDTLS_PSA_ACCEL_KEY_TYPE_ECC_KEY_PAIR_EXPORT)\0A#define MBEDTLS_PSA_ACCEL_KEY_TYPE_ECC_KEY_PAIR_EXPORT\0A#endif\0A#if !defined(MBEDTLS_PSA_ACCEL_KEY_TYPE_ECC_KEY_PAIR_GENERATE)\0A#define MBEDTLS_PSA_ACCEL_KEY_TYPE_ECC_KEY_PAIR_GENERATE\0A#endif\0A#if !defined(MBEDTLS_PSA_ACCEL_KEY_TYPE_ECC_KEY_PAIR_DERIVE)\0A#define MBEDTLS_PSA_ACCEL_KEY_TYPE_ECC_KEY_PAIR_DERIVE\0A#endif\0A#endif\0A\0A#if defined(MBEDTLS_PSA_ACCEL_KEY_TYPE_RSA_KEY_PAIR) //no-check-names\0A#if !defined(MBEDTLS_PSA_ACCEL_KEY_TYPE_RSA_KEY_PAIR_BASIC)\0A#define MBEDTLS_PSA_ACCEL_KEY_TYPE_RSA_KEY_PAIR_BASIC\0A#endif\0A#if !defined(MBEDTLS_PSA_ACCEL_KEY_TYPE_RSA_KEY_PAIR_IMPORT)\0A#define MBEDTLS_PSA_ACCEL_KEY_TYPE_RSA_KEY_PAIR_IMPORT\0A#endif\0A#if !defined(MBEDTLS_PSA_ACCEL_KEY_TYPE_RSA_KEY_PAIR_EXPORT)\0A#define MBEDTLS_PSA_ACCEL_KEY_TYPE_RSA_KEY_PAIR_EXPORT\0A#endif\0A#if !defined(MBEDTLS_PSA_ACCEL_KEY_TYPE_RSA_KEY_PAIR_GENERATE)\0A#define MBEDTLS_PSA_ACCEL_KEY_TYPE_RSA_KEY_PAIR_GENERATE\0A#endif\0A#endif\0A\0A#endif /* MBEDTLS_PSA_CRYPTO_LEGACY_H */\0A\00" }
