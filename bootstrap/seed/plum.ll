@.str40036 = private global { i64, i64, [9181 x i8] } { i64 -1, i64 9180, [9181 x i8] c"/**\0A * \5Cfile psa_util.h\0A *\0A * \5Cbrief Utility functions for the use of the PSA Crypto library.\0A */\0A/*\0A *  Copyright The Mbed TLS Contributors\0A *  SPDX-License-Identifier: Apache-2.0 OR GPL-2.0-or-later\0A */\0A\0A#ifndef MBEDTLS_PSA_UTIL_H\0A#define MBEDTLS_PSA_UTIL_H\0A#include \22mbedtls/private_access.h\22\0A\0A#include \22mbedtls/build_info.h\22\0A\0A#include \22psa/crypto.h\22\0A\0A/* ASN1 defines used in the ECDSA conversion functions.\0A * Note: intentionally not adding MBEDTLS_ASN1_[PARSE|WRITE]_C guards here\0A * otherwise error codes would be unknown in test_suite_psa_crypto_util.data.*/\0A#include <mbedtls/asn1write.h>\0A\0A#if defined(MBEDTLS_PSA_CRYPTO_CLIENT)\0A\0A/** The random generator function for the PSA subsystem.\0A *\0A * This function is suitable as the `f_rng` random generator function\0A * parameter of many `mbedtls_xxx` functions.\0A *\0A * The implementation of this function depends on the configuration of the\0A * library.\0A *\0A * \5Cnote This function may only be used if the PSA crypto subsystem is active.\0A *       This means that you must call psa_crypto_init() before any call to\0A *       this function, and you must not call this function after calling\0A *       mbedtls_psa_crypto_free().\0A *\0A * \5Cparam p_rng         This parameter is only kept for backward compatibility\0A *                      reasons with legacy `f_rng` functions and it's ignored.\0A *                      Set to #MBEDTLS_PSA_RANDOM_STATE or NULL.\0A * \5Cparam output        The buffer to fill. It must have room for\0A *                      \5Cc output_size bytes.\0A * \5Cparam output_size   The number of bytes to write to \5Cp output.\0A *                      This function may fail if \5Cp output_size is too\0A *                      large. It is guaranteed to accept any output size\0A *                      requested by Mbed TLS library functions. The\0A *                      maximum request size depends on the library\0A *                      configuration.\0A *\0A * \5Creturn              \5Cc 0 on success.\0A * \5Creturn              An `MBEDTLS_ERR_ENTROPY_xxx`,\0A *                      `MBEDTLS_ERR_PLATFORM_xxx,\0A *                      `MBEDTLS_ERR_CTR_DRBG_xxx` or\0A *                      `MBEDTLS_ERR_HMAC_DRBG_xxx` on error.\0A */\0Aint mbedtls_psa_get_random(void *p_rng,\0A                           unsigned char *output,\0A                           size_t output_size);\0A\0A/** The random generator state for the PSA subsystem.\0A *\0A * This macro always expands to NULL because the `p_rng` parameter is unused\0A * in mbedtls_psa_get_random(), but it's kept for interface's backward\0A * compatibility.\0A */\0A#define MBEDTLS_PSA_RANDOM_STATE    NULL\0A\0A/** \5Cdefgroup psa_tls_helpers TLS helper functions\0A * @{\0A */\0A#if defined(PSA_WANT_KEY_TYPE_ECC_PUBLIC_KEY)\0A#include <mbedtls/ecp.h>\0A\0A/** Convert an ECC curve identifier from the Mbed TLS encoding to PSA.\0A *\0A * \5Cparam grpid         An Mbed TLS elliptic curve identifier\0A *                      (`MBEDTLS_ECP_DP_xxx`).\0A * \5Cparam[out] bits     On success the bit size of the curve; 0 on failure.\0A *\0A * \5Creturn              If the curve is supported in the PSA API, this function\0A *                      returns the proper PSA curve identifier\0A *                      (`PSA_ECC_FAMILY_xxx`). This holds even if the curve is\0A *                      not supported by the ECP module.\0A * \5Creturn              \5Cc 0 if the curve is not supported in the PSA API.\0A */\0Apsa_ecc_family_t mbedtls_ecc_group_to_psa(mbedtls_ecp_group_id grpid,\0A                                          size_t *bits);\0A\0A/** Convert an ECC curve identifier from the PSA encoding to Mbed TLS.\0A *\0A * \5Cparam family        A PSA elliptic curve family identifier\0A *                      (`PSA_ECC_FAMILY_xxx`).\0A * \5Cparam bits          The bit-length of a private key on \5Cp curve.\0A *\0A * \5Creturn              If the curve is supported in the PSA API, this function\0A *                      returns the corresponding Mbed TLS elliptic curve\0A *                      identifier (`MBEDTLS_ECP_DP_xxx`).\0A * \5Creturn              #MBEDTLS_ECP_DP_NONE if the combination of \5Cc curve\0A *                      and \5Cp bits is not supported.\0A */\0Ambedtls_ecp_group_id mbedtls_ecc_group_from_psa(psa_ecc_family_t family,\0A                                                size_t bits);\0A#endif /* PSA_WANT_KEY_TYPE_ECC_PUBLIC_KEY */\0A\0A/**\0A * \5Cbrief           This function returns the PSA algorithm identifier\0A *                  associated with the given digest type.\0A *\0A * \5Cparam md_type   The type of digest to search for. Must not be NONE.\0A *\0A * \5Cwarning         If \5Cp md_type is \5Cc MBEDTLS_MD_NONE, this function will\0A *                  not return \5Cc PSA_ALG_NONE, but an invalid algorithm.\0A *\0A * \5Cwarning         This function does not check if the algorithm is\0A *                  supported, it always returns the corresponding identifier.\0A *\0A * \5Creturn          The PSA algorithm identifier associated with \5Cp md_type,\0A *                  regardless of whether it is supported or not.\0A */\0Astatic inline psa_algorithm_t mbedtls_md_psa_alg_from_type(mbedtls_md_type_t md_type)\0A{\0A    return PSA_ALG_CATEGORY_HASH | (psa_algorithm_t) md_type;\0A}\0A\0A/**\0A * \5Cbrief           This function returns the given digest type\0A *                  associated with the PSA algorithm identifier.\0A *\0A * \5Cparam psa_alg   The PSA algorithm identifier to search for.\0A *\0A * \5Cwarning         This function does not check if the algorithm is\0A *                  supported, it always returns the corresponding identifier.\0A *\0A * \5Creturn          The MD type associated with \5Cp psa_alg,\0A *                  regardless of whether it is supported or not.\0A */\0Astatic inline mbedtls_md_type_t mbedtls_md_type_from_psa_alg(psa_algorithm_t psa_alg)\0A{\0A    return (mbedtls_md_type_t) (psa_alg & PSA_ALG_HASH_MASK);\0A}\0A#endif /* MBEDTLS_PSA_CRYPTO_CLIENT */\0A\0A#if defined(MBEDTLS_PSA_UTIL_HAVE_ECDSA)\0A\0A/** Convert an ECDSA signature from raw format to DER ASN.1 format.\0A *\0A * \5Cparam       bits        Size of each coordinate in bits.\0A * \5Cparam       raw         Buffer that contains the signature in raw format.\0A * \5Cparam       raw_len     Length of \5Cp raw in bytes. This must be\0A *                          PSA_BITS_TO_BYTES(bits) bytes.\0A * \5Cparam[out]  der         Buffer that will be filled with the converted DER\0A *                          output. It can overlap with raw buffer.\0A * \5Cparam       der_size    Size of \5Cp der in bytes. It is enough if \5Cp der_size\0A *                          is at least the size of the actual output. (The size\0A *                          of the output can vary depending on the presence of\0A *                          leading zeros in the data.) You can use\0A *                          #MBEDTLS_ECDSA_MAX_SIG_LEN(\5Cp bits) to determine a\0A *                          size that is large enough for all signatures for a\0A *                          given value of \5Cp bits.\0A * \5Cparam[out]  der_len     On success it contains the amount of valid data\0A *                          (in bytes) written to \5Cp der. It's undefined\0A *                          in case of failure.\0A *\0A * \5Cnote                    The behavior is undefined if \5Cp der is null,\0A *                          even if \5Cp der_size is 0.\0A *\0A * \5Creturn                  0 if successful.\0A * \5Creturn                  #MBEDTLS_ERR_ASN1_BUF_TOO_SMALL if \5Cp der_size\0A *                          is too small or if \5Cp bits is larger than the\0A *                          largest supported curve.\0A * \5Creturn                  #MBEDTLS_ERR_ASN1_INVALID_DATA if one of the\0A *                          numbers in the signature is 0.\0A */\0Aint mbedtls_ecdsa_raw_to_der(size_t bits, const unsigned char *raw, size_t raw_len,\0A                             unsigned char *der, size_t der_size, size_t *der_len);\0A\0A/** Convert an ECDSA signature from DER ASN.1 format to raw format.\0A *\0A * \5Cparam       bits        Size of each coordinate in bits.\0A * \5Cparam       der         Buffer that contains the signature in DER format.\0A * \5Cparam       der_len     Size of \5Cp der in bytes.\0A * \5Cparam[out]  raw         Buffer that will be filled with the converted raw\0A *                          signature. It can overlap with der buffer.\0A * \5Cparam       raw_size    Size of \5Cp raw in bytes. Must be at least\0A *                          2 * PSA_BITS_TO_BYTES(bits) bytes.\0A * \5Cparam[out]  raw_len     On success it is updated with the amount of valid\0A *                          data (in bytes) written to \5Cp raw. It's undefined\0A *                          in case of failure.\0A *\0A * \5Creturn                  0 if successful.\0A * \5Creturn                  #MBEDTLS_ERR_ASN1_BUF_TOO_SMALL if \5Cp raw_size\0A *                          is too small or if \5Cp bits is larger than the\0A *                          largest supported curve.\0A * \5Creturn                  #MBEDTLS_ERR_ASN1_INVALID_DATA if the data in\0A *                          \5Cp der is inconsistent with \5Cp bits.\0A * \5Creturn                  An \5Cc MBEDTLS_ERR_ASN1_xxx error code if\0A *                          \5Cp der is malformed.\0A */\0Aint mbedtls_ecdsa_der_to_raw(size_t bits, const unsigned char *der, size_t der_len,\0A                             unsigned char *raw, size_t raw_size, size_t *raw_len);\0A\0A#endif /* MBEDTLS_PSA_UTIL_HAVE_ECDSA */\0A\0A/**@}*/\0A\0A#endif /* MBEDTLS_PSA_UTIL_H */\0A\00" }
