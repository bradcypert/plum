@.str39899 = private global { i64, i64, [57529 x i8] } { i64 -1, i64 57528, [57529 x i8] c"/**\0A * \5Cfile psa/crypto_sizes.h\0A *\0A * \5Cbrief PSA cryptography module: Mbed TLS buffer size macros\0A *\0A * \5Cnote This file may not be included directly. Applications must\0A * include psa/crypto.h.\0A *\0A * This file contains the definitions of macros that are useful to\0A * compute buffer sizes. The signatures and semantics of these macros\0A * are standardized, but the definitions are not, because they depend on\0A * the available algorithms and, in some cases, on permitted tolerances\0A * on buffer sizes.\0A *\0A * In implementations with isolation between the application and the\0A * cryptography module, implementers should take care to ensure that\0A * the definitions that are exposed to applications match what the\0A * module implements.\0A *\0A * Macros that compute sizes whose values do not depend on the\0A * implementation are in crypto.h.\0A */\0A/*\0A *  Copyright The Mbed TLS Contributors\0A *  SPDX-License-Identifier: Apache-2.0 OR GPL-2.0-or-later\0A */\0A\0A#ifndef PSA_CRYPTO_SIZES_H\0A#define PSA_CRYPTO_SIZES_H\0A\0A/*\0A * Include the build-time configuration information header. Here, we do not\0A * include `\22mbedtls/build_info.h\22` directly but `\22psa/build_info.h\22`, which\0A * is basically just an alias to it. This is to ease the maintenance of the\0A * TF-PSA-Crypto repository which has a different build system and\0A * configuration.\0A */\0A#include \22psa/build_info.h\22\0A\0A#define PSA_BITS_TO_BYTES(bits) (((bits) + 7u) / 8u)\0A#define PSA_BYTES_TO_BITS(bytes) ((bytes) * 8u)\0A#define PSA_MAX_OF_THREE(a, b, c) ((a) <= (b) ? (b) <= (c) ? \5C\0A                                   (c) : (b) : (a) <= (c) ? (c) : (a))\0A\0A#define PSA_ROUND_UP_TO_MULTIPLE(block_size, length) \5C\0A    (((length) + (block_size) - 1) / (block_size) * (block_size))\0A\0A/** The size of the output of psa_hash_finish(), in bytes.\0A *\0A * This is also the hash size that psa_hash_verify() expects.\0A *\0A * \5Cparam alg   A hash algorithm (\5Cc PSA_ALG_XXX value such that\0A *              #PSA_ALG_IS_HASH(\5Cp alg) is true), or an HMAC algorithm\0A *              (#PSA_ALG_HMAC(\5Cc hash_alg) where \5Cc hash_alg is a\0A *              hash algorithm).\0A *\0A * \5Creturn The hash size for the specified hash algorithm.\0A *         If the hash algorithm is not recognized, return 0.\0A */\0A#define PSA_HASH_LENGTH(alg)                                        \5C\0A    (                                                               \5C\0A        PSA_ALG_HMAC_GET_HASH(alg) == PSA_ALG_MD5 ? 16u :           \5C\0A        PSA_ALG_HMAC_GET_HASH(alg) == PSA_ALG_RIPEMD160 ? 20u :     \5C\0A        PSA_ALG_HMAC_GET_HASH(alg) == PSA_ALG_SHA_1 ? 20u :         \5C\0A        PSA_ALG_HMAC_GET_HASH(alg) == PSA_ALG_SHA_224 ? 28u :       \5C\0A        PSA_ALG_HMAC_GET_HASH(alg) == PSA_ALG_SHA_256 ? 32u :       \5C\0A        PSA_ALG_HMAC_GET_HASH(alg) == PSA_ALG_SHA_384 ? 48u :       \5C\0A        PSA_ALG_HMAC_GET_HASH(alg) == PSA_ALG_SHA_512 ? 64u :       \5C\0A        PSA_ALG_HMAC_GET_HASH(alg) == PSA_ALG_SHA_512_224 ? 28u :   \5C\0A        PSA_ALG_HMAC_GET_HASH(alg) == PSA_ALG_SHA_512_256 ? 32u :   \5C\0A        PSA_ALG_HMAC_GET_HASH(alg) == PSA_ALG_SHA3_224 ? 28u :      \5C\0A        PSA_ALG_HMAC_GET_HASH(alg) == PSA_ALG_SHA3_256 ? 32u :      \5C\0A        PSA_ALG_HMAC_GET_HASH(alg) == PSA_ALG_SHA3_384 ? 48u :      \5C\0A        PSA_ALG_HMAC_GET_HASH(alg) == PSA_ALG_SHA3_512 ? 64u :      \5C\0A        0u)\0A\0A/** The input block size of a hash algorithm, in bytes.\0A *\0A * Hash algorithms process their input data in blocks. Hash operations will\0A * retain any partial blocks until they have enough input to fill the block or\0A * until the operation is finished.\0A * This affects the output from psa_hash_suspend().\0A *\0A * \5Cparam alg   A hash algorithm (\5Cc PSA_ALG_XXX value such that\0A *              PSA_ALG_IS_HASH(\5Cp alg) is true).\0A *\0A * \5Creturn      The block size in bytes for the specified hash algorithm.\0A *              If the hash algorithm is not recognized, return 0.\0A *              An implementation can return either 0 or the correct size for a\0A *              hash algorithm that it recognizes, but does not support.\0A */\0A#define PSA_HASH_BLOCK_LENGTH(alg)                                  \5C\0A    (                                                               \5C\0A        PSA_ALG_HMAC_GET_HASH(alg) == PSA_ALG_MD5 ? 64u :           \5C\0A        PSA_ALG_HMAC_GET_HASH(alg) == PSA_ALG_RIPEMD160 ? 64u :     \5C\0A        PSA_ALG_HMAC_GET_HASH(alg) == PSA_ALG_SHA_1 ? 64u :         \5C\0A        PSA_ALG_HMAC_GET_HASH(alg) == PSA_ALG_SHA_224 ? 64u :       \5C\0A        PSA_ALG_HMAC_GET_HASH(alg) == PSA_ALG_SHA_256 ? 64u :       \5C\0A        PSA_ALG_HMAC_GET_HASH(alg) == PSA_ALG_SHA_384 ? 128u :      \5C\0A        PSA_ALG_HMAC_GET_HASH(alg) == PSA_ALG_SHA_512 ? 128u :      \5C\0A        PSA_ALG_HMAC_GET_HASH(alg) == PSA_ALG_SHA_512_224 ? 128u :  \5C\0A        PSA_ALG_HMAC_GET_HASH(alg) == PSA_ALG_SHA_512_256 ? 128u :  \5C\0A        PSA_ALG_HMAC_GET_HASH(alg) == PSA_ALG_SHA3_224 ? 144u :     \5C\0A        PSA_ALG_HMAC_GET_HASH(alg) == PSA_ALG_SHA3_256 ? 136u :     \5C\0A        PSA_ALG_HMAC_GET_HASH(alg) == PSA_ALG_SHA3_384 ? 104u :     \5C\0A        PSA_ALG_HMAC_GET_HASH(alg) == PSA_ALG_SHA3_512 ? 72u :      \5C\0A        0u)\0A\0A/** \5Cdef PSA_HASH_MAX_SIZE\0A *\0A * Maximum size of a hash.\0A *\0A * This macro expands to a compile-time constant integer. This value\0A * is the maximum size of a hash in bytes.\0A */\0A/* Note: for HMAC-SHA-3, the block size is 144 bytes for HMAC-SHA3-224,\0A * 136 bytes for HMAC-SHA3-256, 104 bytes for SHA3-384, 72 bytes for\0A * HMAC-SHA3-512. */\0A/* Note: PSA_HASH_MAX_SIZE should be kept in sync with MBEDTLS_MD_MAX_SIZE,\0A * see the note on MBEDTLS_MD_MAX_SIZE for details. */\0A#if defined(PSA_WANT_ALG_SHA3_224)\0A#define PSA_HMAC_MAX_HASH_BLOCK_SIZE 144u\0A#elif defined(PSA_WANT_ALG_SHA3_256)\0A#define PSA_HMAC_MAX_HASH_BLOCK_SIZE 136u\0A#elif defined(PSA_WANT_ALG_SHA_512)\0A#define PSA_HMAC_MAX_HASH_BLOCK_SIZE 128u\0A#elif defined(PSA_WANT_ALG_SHA_384)\0A#define PSA_HMAC_MAX_HASH_BLOCK_SIZE 128u\0A#elif defined(PSA_WANT_ALG_SHA3_384)\0A#define PSA_HMAC_MAX_HASH_BLOCK_SIZE 104u\0A#elif defined(PSA_WANT_ALG_SHA3_512)\0A#define PSA_HMAC_MAX_HASH_BLOCK_SIZE 72u\0A#elif defined(PSA_WANT_ALG_SHA_256)\0A#define PSA_HMAC_MAX_HASH_BLOCK_SIZE 64u\0A#elif defined(PSA_WANT_ALG_SHA_224)\0A#define PSA_HMAC_MAX_HASH_BLOCK_SIZE 64u\0A#else /* SHA-1 or smaller */\0A#define PSA_HMAC_MAX_HASH_BLOCK_SIZE 64u\0A#endif\0A\0A#if defined(PSA_WANT_ALG_SHA_512) || defined(PSA_WANT_ALG_SHA3_512)\0A#define PSA_HASH_MAX_SIZE 64u\0A#elif defined(PSA_WANT_ALG_SHA_384) || defined(PSA_WANT_ALG_SHA3_384)\0A#define PSA_HASH_MAX_SIZE 48u\0A#elif defined(PSA_WANT_ALG_SHA_256) || defined(PSA_WANT_ALG_SHA3_256)\0A#define PSA_HASH_MAX_SIZE 32u\0A#elif defined(PSA_WANT_ALG_SHA_224) || defined(PSA_WANT_ALG_SHA3_224)\0A#define PSA_HASH_MAX_SIZE 28u\0A#else /* SHA-1 or smaller */\0A#define PSA_HASH_MAX_SIZE 20u\0A#endif\0A\0A/** \5Cdef PSA_MAC_MAX_SIZE\0A *\0A * Maximum size of a MAC.\0A *\0A * This macro expands to a compile-time constant integer. This value\0A * is the maximum size of a MAC in bytes.\0A */\0A/* All non-HMAC MACs have a maximum size that's smaller than the\0A * minimum possible value of PSA_HASH_MAX_SIZE in this implementation. */\0A/* Note that the encoding of truncated MAC algorithms limits this value\0A * to 64 bytes.\0A */\0A#define PSA_MAC_MAX_SIZE PSA_HASH_MAX_SIZE\0A\0A/** The length of a tag for an AEAD algorithm, in bytes.\0A *\0A * This macro can be used to allocate a buffer of sufficient size to store the\0A * tag output from psa_aead_finish().\0A *\0A * See also #PSA_AEAD_TAG_MAX_SIZE.\0A *\0A * \5Cparam key_type            The type of the AEAD key.\0A * \5Cparam key_bits            The size of the AEAD key in bits.\0A * \5Cparam alg                 An AEAD algorithm\0A *                            (\5Cc PSA_ALG_XXX value such that\0A *                            #PSA_ALG_IS_AEAD(\5Cp alg) is true).\0A *\0A * \5Creturn                    The tag length for the specified algorithm and key.\0A *                            If the AEAD algorithm does not have an identified\0A *                            tag that can be distinguished from the rest of\0A *                            the ciphertext, return 0.\0A *                            If the key type or AEAD algorithm is not\0A *                            recognized, or the parameters are incompatible,\0A *                            return 0.\0A */\0A#define PSA_AEAD_TAG_LENGTH(key_type, key_bits, alg)                        \5C\0A    (PSA_AEAD_NONCE_LENGTH(key_type, alg) != 0 ?                            \5C\0A     PSA_ALG_AEAD_GET_TAG_LENGTH(alg) :                                     \5C\0A     ((void) (key_bits), 0u))\0A\0A/** The maximum tag size for all supported AEAD algorithms, in bytes.\0A *\0A * See also #PSA_AEAD_TAG_LENGTH(\5Cp key_type, \5Cp key_bits, \5Cp alg).\0A */\0A#define PSA_AEAD_TAG_MAX_SIZE       16u\0A\0A/* The maximum size of an RSA key on this implementation, in bits.\0A * This is a vendor-specific macro.\0A *\0A * Mbed TLS does not set a hard limit on the size of RSA keys: any key\0A * whose parameters fit in a bignum is accepted. However large keys can\0A * induce a large memory usage and long computation times. Unlike other\0A * auxiliary macros in this file and in crypto.h, which reflect how the\0A * library is configured, this macro defines how the library is\0A * configured. This implementation refuses to import or generate an\0A * RSA key whose size is larger than the value defined here.\0A *\0A * Note that an implementation may set different size limits for different\0A * operations, and does not need to accept all key sizes up to the limit. */\0A#define PSA_VENDOR_RSA_MAX_KEY_BITS 4096u\0A\0A/* The minimum size of an RSA key on this implementation, in bits.\0A * This is a vendor-specific macro.\0A *\0A * Limits RSA key generation to a minimum due to avoid accidental misuse.\0A * This value cannot be less than 128 bits.\0A */\0A#if defined(MBEDTLS_RSA_GEN_KEY_MIN_BITS)\0A#define PSA_VENDOR_RSA_GENERATE_MIN_KEY_BITS MBEDTLS_RSA_GEN_KEY_MIN_BITS\0A#else\0A#define PSA_VENDOR_RSA_GENERATE_MIN_KEY_BITS 1024\0A#endif\0A\0A/* The maximum size of an DH key on this implementation, in bits.\0A * This is a vendor-specific macro.*/\0A#if defined(PSA_WANT_DH_RFC7919_8192)\0A#define PSA_VENDOR_FFDH_MAX_KEY_BITS 8192u\0A#elif defined(PSA_WANT_DH_RFC7919_6144)\0A#define PSA_VENDOR_FFDH_MAX_KEY_BITS 6144u\0A#elif defined(PSA_WANT_DH_RFC7919_4096)\0A#define PSA_VENDOR_FFDH_MAX_KEY_BITS 4096u\0A#elif defined(PSA_WANT_DH_RFC7919_3072)\0A#define PSA_VENDOR_FFDH_MAX_KEY_BITS 3072u\0A#elif defined(PSA_WANT_DH_RFC7919_2048)\0A#define PSA_VENDOR_FFDH_MAX_KEY_BITS 2048u\0A#else\0A#define PSA_VENDOR_FFDH_MAX_KEY_BITS 0u\0A#endif\0A\0A/* The maximum size of an ECC key on this implementation, in bits.\0A * This is a vendor-specific macro. */\0A#if defined(PSA_WANT_ECC_SECP_R1_521)\0A#define PSA_VENDOR_ECC_MAX_CURVE_BITS 521u\0A#elif defined(PSA_WANT_ECC_BRAINPOOL_P_R1_512)\0A#define PSA_VENDOR_ECC_MAX_CURVE_BITS 512u\0A#elif defined(PSA_WANT_ECC_MONTGOMERY_448)\0A#define PSA_VENDOR_ECC_MAX_CURVE_BITS 448u\0A#elif defined(PSA_WANT_ECC_SECP_R1_384)\0A#define PSA_VENDOR_ECC_MAX_CURVE_BITS 384u\0A#elif defined(PSA_WANT_ECC_BRAINPOOL_P_R1_384)\0A#define PSA_VENDOR_ECC_MAX_CURVE_BITS 384u\0A#elif defined(PSA_WANT_ECC_SECP_R1_256)\0A#define PSA_VENDOR_ECC_MAX_CURVE_BITS 256u\0A#elif defined(PSA_WANT_ECC_SECP_K1_256)\0A#define PSA_VENDOR_ECC_MAX_CURVE_BITS 256u\0A#elif defined(PSA_WANT_ECC_BRAINPOOL_P_R1_256)\0A#define PSA_VENDOR_ECC_MAX_CURVE_BITS 256u\0A#elif defined(PSA_WANT_ECC_MONTGOMERY_255)\0A#define PSA_VENDOR_ECC_MAX_CURVE_BITS 255u\0A#elif defined(PSA_WANT_ECC_SECP_R1_224)\0A#define PSA_VENDOR_ECC_MAX_CURVE_BITS 224u\0A#elif defined(PSA_WANT_ECC_SECP_K1_224)\0A#define PSA_VENDOR_ECC_MAX_CURVE_BITS 224u\0A#elif defined(PSA_WANT_ECC_SECP_R1_192)\0A#define PSA_VENDOR_ECC_MAX_CURVE_BITS 192u\0A#elif defined(PSA_WANT_ECC_SECP_K1_192)\0A#define PSA_VENDOR_ECC_MAX_CURVE_BITS 192u\0A#else\0A#define PSA_VENDOR_ECC_MAX_CURVE_BITS 0u\0A#endif\0A\0A/** This macro returns the maximum supported length of the PSK for the\0A * TLS-1.2 PSK-to-MS key derivation\0A * (#PSA_ALG_TLS12_PSK_TO_MS(\5Cc hash_alg)).\0A *\0A * The maximum supported length does not depend on the chosen hash algorithm.\0A *\0A * Quoting RFC 4279, Sect 5.3:\0A * TLS implementations supporting these ciphersuites MUST support\0A * arbitrary PSK identities up to 128 octets in length, and arbitrary\0A * PSKs up to 64 octets in length.  Supporting longer identities and\0A * keys is RECOMMENDED.\0A *\0A * Therefore, no implementation should define a value smaller than 64\0A * for #PSA_TLS12_PSK_TO_MS_PSK_MAX_SIZE.\0A */\0A#define PSA_TLS12_PSK_TO_MS_PSK_MAX_SIZE 128u\0A\0A/* The expected size of input passed to psa_tls12_ecjpake_to_pms_input,\0A * which is expected to work with P-256 curve only. */\0A#define PSA_TLS12_ECJPAKE_TO_PMS_INPUT_SIZE 65u\0A\0A/* The size of a serialized K.X coordinate to be used in\0A * psa_tls12_ecjpake_to_pms_input. This function only accepts the P-256\0A * curve. */\0A#define PSA_TLS12_ECJPAKE_TO_PMS_DATA_SIZE 32u\0A\0A/* The maximum number of iterations for PBKDF2 on this implementation, in bits.\0A * This is a vendor-specific macro. This can be configured if necessary */\0A#define PSA_VENDOR_PBKDF2_MAX_ITERATIONS 0xffffffffU\0A\0A/** The maximum size of a block cipher. */\0A#define PSA_BLOCK_CIPHER_BLOCK_MAX_SIZE 16u\0A\0A/** The size of the output of psa_mac_sign_finish(), in bytes.\0A *\0A * This is also the MAC size that psa_mac_verify_finish() expects.\0A *\0A * \5Cwarning This macro may evaluate its arguments multiple times or\0A *          zero times, so you should not pass arguments that contain\0A *          side effects.\0A *\0A * \5Cparam key_type      The type of the MAC key.\0A * \5Cparam key_bits      The size of the MAC key in bits.\0A * \5Cparam alg           A MAC algorithm (\5Cc PSA_ALG_XXX value such that\0A *                      #PSA_ALG_IS_MAC(\5Cp alg) is true).\0A *\0A * \5Creturn              The MAC size for the specified algorithm with\0A *                      the specified key parameters.\0A * \5Creturn              0 if the MAC algorithm is not recognized.\0A * \5Creturn              Either 0 or the correct size for a MAC algorithm that\0A *                      the implementation recognizes, but does not support.\0A * \5Creturn              Unspecified if the key parameters are not consistent\0A *                      with the algorithm.\0A */\0A#define PSA_MAC_LENGTH(key_type, key_bits, alg)                                   \5C\0A    ((alg) & PSA_ALG_MAC_TRUNCATION_MASK ? PSA_MAC_TRUNCATED_LENGTH(alg) :        \5C\0A     PSA_ALG_IS_HMAC(alg) ? PSA_HASH_LENGTH(PSA_ALG_HMAC_GET_HASH(alg)) :         \5C\0A     PSA_ALG_IS_BLOCK_CIPHER_MAC(alg) ? PSA_BLOCK_CIPHER_BLOCK_LENGTH(key_type) : \5C\0A     ((void) (key_type), (void) (key_bits), 0u))\0A\0A/** The maximum size of the output of psa_aead_encrypt(), in bytes.\0A *\0A * If the size of the ciphertext buffer is at least this large, it is\0A * guaranteed that psa_aead_encrypt() will not fail due to an\0A * insufficient buffer size. Depending on the algorithm, the actual size of\0A * the ciphertext may be smaller.\0A *\0A * See also #PSA_AEAD_ENCRYPT_OUTPUT_MAX_SIZE(\5Cp plaintext_length).\0A *\0A * \5Cwarning This macro may evaluate its arguments multiple times or\0A *          zero times, so you should not pass arguments that contain\0A *          side effects.\0A *\0A * \5Cparam key_type            A symmetric key type that is\0A *                            compatible with algorithm \5Cp alg.\0A * \5Cparam alg                 An AEAD algorithm\0A *                            (\5Cc PSA_ALG_XXX value such that\0A *                            #PSA_ALG_IS_AEAD(\5Cp alg) is true).\0A * \5Cparam plaintext_length    Size of the plaintext in bytes.\0A *\0A * \5Creturn                    The AEAD ciphertext size for the specified\0A *                            algorithm.\0A *                            If the key type or AEAD algorithm is not\0A *                            recognized, or the parameters are incompatible,\0A *                            return 0.\0A */\0A#define PSA_AEAD_ENCRYPT_OUTPUT_SIZE(key_type, alg, plaintext_length) \5C\0A    (PSA_AEAD_NONCE_LENGTH(key_type, alg) != 0 ?                      \5C\0A     (plaintext_length) + PSA_ALG_AEAD_GET_TAG_LENGTH(alg) :          \5C\0A     0u)\0A\0A/** A sufficient output buffer size for psa_aead_encrypt(), for any of the\0A *  supported key types and AEAD algorithms.\0A *\0A * If the size of the ciphertext buffer is at least this large, it is guaranteed\0A * that psa_aead_encrypt() will not fail due to an insufficient buffer size.\0A *\0A * \5Cnote This macro returns a compile-time constant if its arguments are\0A *       compile-time constants.\0A *\0A * See also #PSA_AEAD_ENCRYPT_OUTPUT_SIZE(\5Cp key_type, \5Cp alg,\0A * \5Cp plaintext_length).\0A *\0A * \5Cparam plaintext_length    Size of the plaintext in bytes.\0A *\0A * \5Creturn                    A sufficient output buffer size for any of the\0A *                            supported key types and AEAD algorithms.\0A *\0A */\0A#define PSA_AEAD_ENCRYPT_OUTPUT_MAX_SIZE(plaintext_length)          \5C\0A    ((plaintext_length) + PSA_AEAD_TAG_MAX_SIZE)\0A\0A\0A/** The maximum size of the output of psa_aead_decrypt(), in bytes.\0A *\0A * If the size of the plaintext buffer is at least this large, it is\0A * guaranteed that psa_aead_decrypt() will not fail due to an\0A * insufficient buffer size. Depending on the algorithm, the actual size of\0A * the plaintext may be smaller.\0A *\0A * See also #PSA_AEAD_DECRYPT_OUTPUT_MAX_SIZE(\5Cp ciphertext_length).\0A *\0A * \5Cwarning This macro may evaluate its arguments multiple times or\0A *          zero times, so you should not pass arguments that contain\0A *          side effects.\0A *\0A * \5Cparam key_type            A symmetric key type that is\0A *                            compatible with algorithm \5Cp alg.\0A * \5Cparam alg                 An AEAD algorithm\0A *                            (\5Cc PSA_ALG_XXX value such that\0A *                            #PSA_ALG_IS_AEAD(\5Cp alg) is true).\0A * \5Cparam ciphertext_length   Size of the plaintext in bytes.\0A *\0A * \5Creturn                    The AEAD ciphertext size for the specified\0A *                            algorithm.\0A *                            If the key type or AEAD algorithm is not\0A *                            recognized, or the parameters are incompatible,\0A *                            return 0.\0A */\0A#define PSA_AEAD_DECRYPT_OUTPUT_SIZE(key_type, alg, ciphertext_length) \5C\0A    (PSA_AEAD_NONCE_LENGTH(key_type, alg) != 0 &&                      \5C\0A     (ciphertext_length) > PSA_ALG_AEAD_GET_TAG_LENGTH(alg) ?      \5C\0A     (ciphertext_length) - PSA_ALG_AEAD_GET_TAG_LENGTH(alg) :      \5C\0A     0u)\0A\0A/** A sufficient output buffer size for psa_aead_decrypt(), for any of the\0A *  supported key types and AEAD algorithms.\0A *\0A * If the size of the plaintext buffer is at least this large, it is guaranteed\0A * that psa_aead_decrypt() will not fail due to an insufficient buffer size.\0A *\0A * \5Cnote This macro returns a compile-time constant if its arguments are\0A *       compile-time constants.\0A *\0A * See also #PSA_AEAD_DECRYPT_OUTPUT_SIZE(\5Cp key_type, \5Cp alg,\0A * \5Cp ciphertext_length).\0A *\0A * \5Cparam ciphertext_length   Size of the ciphertext in bytes.\0A *\0A * \5Creturn                    A sufficient output buffer size for any of the\0A *                            supported key types and AEAD algorithms.\0A *\0A */\0A#define PSA_AEAD_DECRYPT_OUTPUT_MAX_SIZE(ciphertext_length)     \5C\0A    (ciphertext_length)\0A\0A/** The default nonce size for an AEAD algorithm, in bytes.\0A *\0A * This macro can be used to allocate a buffer of sufficient size to\0A * store the nonce output from #psa_aead_generate_nonce().\0A *\0A * See also #PSA_AEAD_NONCE_MAX_SIZE.\0A *\0A * \5Cnote This is not the maximum size of nonce supported as input to\0A *       #psa_aead_set_nonce(), #psa_aead_encrypt() or #psa_aead_decrypt(),\0A *       just the default size that is generated by #psa_aead_generate_nonce().\0A *\0A * \5Cwarning This macro may evaluate its arguments multiple times or\0A *          zero times, so you should not pass arguments that contain\0A *          side effects.\0A *\0A * \5Cparam key_type  A symmetric key type that is compatible with\0A *                  algorithm \5Cp alg.\0A *\0A * \5Cparam alg       An AEAD algorithm (\5Cc PSA_ALG_XXX value such that\0A *                  #PSA_ALG_IS_AEAD(\5Cp alg) is true).\0A *\0A * \5Creturn The default nonce size for the specified key type and algorithm.\0A *         If the key type or AEAD algorithm is not recognized,\0A *         or the parameters are incompatible, return 0.\0A */\0A#define PSA_AEAD_NONCE_LENGTH(key_type, alg) \5C\0A    (PSA_BLOCK_CIPHER_BLOCK_LENGTH(key_type) == 16 ? \5C\0A     MBEDTLS_PSA_ALG_AEAD_EQUAL(alg, PSA_ALG_CCM) ? 13u : \5C\0A     MBEDTLS_PSA_ALG_AEAD_EQUAL(alg, PSA_ALG_GCM) ? 12u : \5C\0A     0u : \5C\0A     (key_type) == PSA_KEY_TYPE_CHACHA20 && \5C\0A     MBEDTLS_PSA_ALG_AEAD_EQUAL(alg, PSA_ALG_CHACHA20_POLY1305) ? 12u : \5C\0A     0u)\0A\0A/** The maximum default nonce size among all supported pairs of key types and\0A *  AEAD algorithms, in bytes.\0A *\0A * This is equal to or greater than any value that #PSA_AEAD_NONCE_LENGTH()\0A * may return.\0A *\0A * \5Cnote This is not the maximum size of nonce supported as input to\0A *       #psa_aead_set_nonce(), #psa_aead_encrypt() or #psa_aead_decrypt(),\0A *       just the largest size that may be generated by\0A *       #psa_aead_generate_nonce().\0A */\0A#define PSA_AEAD_NONCE_MAX_SIZE 13u\0A\0A/** A sufficient output buffer size for psa_aead_update().\0A *\0A * If the size of the output buffer is at least this large, it is\0A * guaranteed that psa_aead_update() will not fail due to an\0A * insufficient buffer size. The actual size of the output may be smaller\0A * in any given call.\0A *\0A * See also #PSA_AEAD_UPDATE_OUTPUT_MAX_SIZE(\5Cp input_length).\0A *\0A * \5Cwarning This macro may evaluate its arguments multiple times or\0A *          zero times, so you should not pass arguments that contain\0A *          side effects.\0A *\0A * \5Cparam key_type            A symmetric key type that is\0A *                            compatible with algorithm \5Cp alg.\0A * \5Cparam alg                 An AEAD algorithm\0A *                            (\5Cc PSA_ALG_XXX value such that\0A *                            #PSA_ALG_IS_AEAD(\5Cp alg) is true).\0A * \5Cparam input_length        Size of the input in bytes.\0A *\0A * \5Creturn                    A sufficient output buffer size for the specified\0A *                            algorithm.\0A *                            If the key type or AEAD algorithm is not\0A *                            recognized, or the parameters are incompatible,\0A *                            return 0.\0A */\0A/* For all the AEAD modes defined in this specification, it is possible\0A * to emit output without delay. However, hardware may not always be\0A * capable of this. So for modes based on a block cipher, allow the\0A * implementation to delay the output until it has a full block. */\0A#define PSA_AEAD_UPDATE_OUTPUT_SIZE(key_type, alg, input_length)                             \5C\0A    (PSA_AEAD_NONCE_LENGTH(key_type, alg) != 0 ?                                             \5C\0A     PSA_ALG_IS_AEAD_ON_BLOCK_CIPHER(alg) ?                                              \5C\0A     PSA_ROUND_UP_TO_MULTIPLE(PSA_BLOCK_CIPHER_BLOCK_LENGTH(key_type), (input_length)) : \5C\0A     (input_length) : \5C\0A     0u)\0A\0A/** A sufficient output buffer size for psa_aead_update(), for any of the\0A *  supported key types and AEAD algorithms.\0A *\0A * If the size of the output buffer is at least this large, it is guaranteed\0A * that psa_aead_update() will not fail due to an insufficient buffer size.\0A *\0A * See also #PSA_AEAD_UPDATE_OUTPUT_SIZE(\5Cp key_type, \5Cp alg, \5Cp input_length).\0A *\0A * \5Cparam input_length      Size of the input in bytes.\0A */\0A#define PSA_AEAD_UPDATE_OUTPUT_MAX_SIZE(input_length)                           \5C\0A    (PSA_ROUND_UP_TO_MULTIPLE(PSA_BLOCK_CIPHER_BLOCK_MAX_SIZE, (input_length)))\0A\0A/** A sufficient ciphertext buffer size for psa_aead_finish().\0A *\0A * If the size of the ciphertext buffer is at least this large, it is\0A * guaranteed that psa_aead_finish() will not fail due to an\0A * insufficient ciphertext buffer size. The actual size of the output may\0A * be smaller in any given call.\0A *\0A * See also #PSA_AEAD_FINISH_OUTPUT_MAX_SIZE.\0A *\0A * \5Cparam key_type            A symmetric key type that is\0A                              compatible with algorithm \5Cp alg.\0A * \5Cparam alg                 An AEAD algorithm\0A *                            (\5Cc PSA_ALG_XXX value such that\0A *                            #PSA_ALG_IS_AEAD(\5Cp alg) is true).\0A *\0A * \5Creturn                    A sufficient ciphertext buffer size for the\0A *                            specified algorithm.\0A *                            If the key type or AEAD algorithm is not\0A *                            recognized, or the parameters are incompatible,\0A *                            return 0.\0A */\0A#define PSA_AEAD_FINISH_OUTPUT_SIZE(key_type, alg) \5C\0A    (PSA_AEAD_NONCE_LENGTH(key_type, alg) != 0 &&  \5C\0A     PSA_ALG_IS_AEAD_ON_BLOCK_CIPHER(alg) ?    \5C\0A     PSA_BLOCK_CIPHER_BLOCK_LENGTH(key_type) : \5C\0A     0u)\0A\0A/** A sufficient ciphertext buffer size for psa_aead_finish(), for any of the\0A *  supported key types and AEAD algorithms.\0A *\0A * See also #PSA_AEAD_FINISH_OUTPUT_SIZE(\5Cp key_type, \5Cp alg).\0A */\0A#define PSA_AEAD_FINISH_OUTPUT_MAX_SIZE     (PSA_BLOCK_CIPHER_BLOCK_MAX_SIZE)\0A\0A/** A sufficient plaintext buffer size for psa_aead_verify().\0A *\0A * If the size of the plaintext buffer is at least this large, it is\0A * guaranteed that psa_aead_verify() will not fail due to an\0A * insufficient plaintext buffer size. The actual size of the output may\0A * be smaller in any given call.\0A *\0A * See also #PSA_AEAD_VERIFY_OUTPUT_MAX_SIZE.\0A *\0A * \5Cparam key_type            A symmetric key type that is\0A *                            compatible with algorithm \5Cp alg.\0A * \5Cparam alg                 An AEAD algorithm\0A *                            (\5Cc PSA_ALG_XXX value such that\0A *                            #PSA_ALG_IS_AEAD(\5Cp alg) is true).\0A *\0A * \5Creturn                    A sufficient plaintext buffer size for the\0A *                            specified algorithm.\0A *                            If the key type or AEAD algorithm is not\0A *                            recognized, or the parameters are incompatible,\0A *                            return 0.\0A */\0A#define PSA_AEAD_VERIFY_OUTPUT_SIZE(key_type, alg) \5C\0A    (PSA_AEAD_NONCE_LENGTH(key_type, alg) != 0 &&  \5C\0A     PSA_ALG_IS_AEAD_ON_BLOCK_CIPHER(alg) ?    \5C\0A     PSA_BLOCK_CIPHER_BLOCK_LENGTH(key_type) : \5C\0A     0u)\0A\0A/** A sufficient plaintext buffer size for psa_aead_verify(), for any of the\0A *  supported key types and AEAD algorithms.\0A *\0A * See also #PSA_AEAD_VERIFY_OUTPUT_SIZE(\5Cp key_type, \5Cp alg).\0A */\0A#define PSA_AEAD_VERIFY_OUTPUT_MAX_SIZE     (PSA_BLOCK_CIPHER_BLOCK_MAX_SIZE)\0A\0A#define PSA_RSA_MINIMUM_PADDING_SIZE(alg)                         \5C\0A    (PSA_ALG_IS_RSA_OAEP(alg) ?                                   \5C\0A     2u * PSA_HASH_LENGTH(PSA_ALG_RSA_OAEP_GET_HASH(alg)) + 1u :   \5C\0A     11u /*PKCS#1v1.5*/)\0A\0A/**\0A * \5Cbrief ECDSA signature size for a given curve bit size\0A *\0A * \5Cparam curve_bits    Curve size in bits.\0A * \5Creturn              Signature size in bytes.\0A *\0A * \5Cnote This macro returns a compile-time constant if its argument is one.\0A */\0A#define PSA_ECDSA_SIGNATURE_SIZE(curve_bits)    \5C\0A    (PSA_BITS_TO_BYTES(curve_bits) * 2u)\0A\0A/** Sufficient signature buffer size for psa_sign_hash().\0A *\0A * This macro returns a sufficient buffer size for a signature using a key\0A * of the specified type and size, with the specified algorithm.\0A * Note that the actual size of the signature may be smaller\0A * (some algorithms produce a variable-size signature).\0A *\0A * \5Cwarning This function may call its arguments multiple times or\0A *          zero times, so you should not pass arguments that contain\0A *          side effects.\0A *\0A * \5Cparam key_type  An asymmetric key type (this may indifferently be a\0A *                  key pair type or a public key type).\0A * \5Cparam key_bits  The size of the key in bits.\0A * \5Cparam alg       The signature algorithm.\0A *\0A * \5Creturn If the parameters are valid and supported, return\0A *         a buffer size in bytes that guarantees that\0A *         psa_sign_hash() will not fail with\0A *         #PSA_ERROR_BUFFER_TOO_SMALL.\0A *         If the parameters are a valid combination that is not supported,\0A *         return either a sensible size or 0.\0A *         If the parameters are not valid, the\0A *         return value is unspecified.\0A */\0A#define PSA_SIGN_OUTPUT_SIZE(key_type, key_bits, alg)        \5C\0A    (PSA_KEY_TYPE_IS_RSA(key_type) ? ((void) alg, PSA_BITS_TO_BYTES(key_bits)) : \5C\0A     PSA_KEY_TYPE_IS_ECC(key_type) ? PSA_ECDSA_SIGNATURE_SIZE(key_bits) : \5C\0A     ((void) alg, 0u))\0A\0A#define PSA_VENDOR_ECDSA_SIGNATURE_MAX_SIZE     \5C\0A    PSA_ECDSA_SIGNATURE_SIZE(PSA_VENDOR_ECC_MAX_CURVE_BITS)\0A\0A/** \5Cdef PSA_SIGNATURE_MAX_SIZE\0A *\0A * Maximum size of an asymmetric signature.\0A *\0A * This macro expands to a compile-time constant integer. This value\0A * is the maximum size of a signature in bytes.\0A */\0A#define PSA_SIGNATURE_MAX_SIZE      1\0A\0A#if (defined(PSA_WANT_ALG_ECDSA) || defined(PSA_WANT_ALG_DETERMINISTIC_ECDSA)) && \5C\0A    (PSA_VENDOR_ECDSA_SIGNATURE_MAX_SIZE > PSA_SIGNATURE_MAX_SIZE)\0A#undef PSA_SIGNATURE_MAX_SIZE\0A#define PSA_SIGNATURE_MAX_SIZE      PSA_VENDOR_ECDSA_SIGNATURE_MAX_SIZE\0A#endif\0A#if (defined(PSA_WANT_ALG_RSA_PKCS1V15_SIGN) || defined(PSA_WANT_ALG_RSA_PSS)) && \5C\0A    (PSA_BITS_TO_BYTES(PSA_VENDOR_RSA_MAX_KEY_BITS) > PSA_SIGNATURE_MAX_SIZE)\0A#undef PSA_SIGNATURE_MAX_SIZE\0A#define PSA_SIGNATURE_MAX_SIZE      PSA_BITS_TO_BYTES(PSA_VENDOR_RSA_MAX_KEY_BITS)\0A#endif\0A\0A/** Sufficient output buffer size for psa_asymmetric_encrypt().\0A *\0A * This macro returns a sufficient buffer size for a ciphertext produced using\0A * a key of the specified type and size, with the specified algorithm.\0A * Note that the actual size of the ciphertext may be smaller, depending\0A * on the algorithm.\0A *\0A * \5Cwarning This function may call its arguments multiple times or\0A *          zero times, so you should not pass arguments that contain\0A *          side effects.\0A *\0A * \5Cparam key_type  An asymmetric key type (this may indifferently be a\0A *                  key pair type or a public key type).\0A * \5Cparam key_bits  The size of the key in bits.\0A * \5Cparam alg       The asymmetric encryption algorithm.\0A *\0A * \5Creturn If the parameters are valid and supported, return\0A *         a buffer size in bytes that guarantees that\0A *         psa_asymmetric_encrypt() will not fail with\0A *         #PSA_ERROR_BUFFER_TOO_SMALL.\0A *         If the parameters are a valid combination that is not supported,\0A *         return either a sensible size or 0.\0A *         If the parameters are not valid, the\0A *         return value is unspecified.\0A */\0A#define PSA_ASYMMETRIC_ENCRYPT_OUTPUT_SIZE(key_type, key_bits, alg)     \5C\0A    (PSA_KEY_TYPE_IS_RSA(key_type) ?                                    \5C\0A     ((void) alg, PSA_BITS_TO_BYTES(key_bits)) :                         \5C\0A     0u)\0A\0A/** A sufficient output buffer size for psa_asymmetric_encrypt(), for any\0A *  supported asymmetric encryption.\0A *\0A * See also #PSA_ASYMMETRIC_ENCRYPT_OUTPUT_SIZE(\5Cp key_type, \5Cp key_bits, \5Cp alg).\0A */\0A/* This macro assumes that RSA is the only supported asymmetric encryption. */\0A#define PSA_ASYMMETRIC_ENCRYPT_OUTPUT_MAX_SIZE          \5C\0A    (PSA_BITS_TO_BYTES(PSA_VENDOR_RSA_MAX_KEY_BITS))\0A\0A/** Sufficient output buffer size for psa_asymmetric_decrypt().\0A *\0A * This macro returns a sufficient buffer size for a plaintext produced using\0A * a key of the specified type and size, with the specified algorithm.\0A * Note that the actual size of the plaintext may be smaller, depending\0A * on the algorithm.\0A *\0A * \5Cwarning This function may call its arguments multiple times or\0A *          zero times, so you should not pass arguments that contain\0A *          side effects.\0A *\0A * \5Cparam key_type  An asymmetric key type (this may indifferently be a\0A *                  key pair type or a public key type).\0A * \5Cparam key_bits  The size of the key in bits.\0A * \5Cparam alg       The asymmetric encryption algorithm.\0A *\0A * \5Creturn If the parameters are valid and supported, return\0A *         a buffer size in bytes that guarantees that\0A *         psa_asymmetric_decrypt() will not fail with\0A *         #PSA_ERROR_BUFFER_TOO_SMALL.\0A *         If the parameters are a valid combination that is not supported,\0A *         return either a sensible size or 0.\0A *         If the parameters are not valid, the\0A *         return value is unspecified.\0A */\0A#define PSA_ASYMMETRIC_DECRYPT_OUTPUT_SIZE(key_type, key_bits, alg)     \5C\0A    (PSA_KEY_TYPE_IS_RSA(key_type) ?                                    \5C\0A     PSA_BITS_TO_BYTES(key_bits) - PSA_RSA_MINIMUM_PADDING_SIZE(alg) :  \5C\0A     0u)\0A\0A/** A sufficient output buffer size for psa_asymmetric_decrypt(), for any\0A *  supported asymmetric decryption.\0A *\0A * This macro assumes that RSA is the only supported asymmetric encryption.\0A *\0A * See also #PSA_ASYMMETRIC_DECRYPT_OUTPUT_SIZE(\5Cp key_type, \5Cp key_bits, \5Cp alg).\0A */\0A#define PSA_ASYMMETRIC_DECRYPT_OUTPUT_MAX_SIZE          \5C\0A    (PSA_BITS_TO_BYTES(PSA_VENDOR_RSA_MAX_KEY_BITS))\0A\0A/* Maximum size of the ASN.1 encoding of an INTEGER with the specified\0A * number of bits.\0A *\0A * This definition assumes that bits <= 2^19 - 9 so that the length field\0A * is at most 3 bytes. The length of the encoding is the length of the\0A * bit string padded to a whole number of bytes plus:\0A * - 1 type byte;\0A * - 1 to 3 length bytes;\0A * - 0 to 1 bytes of leading 0 due to the sign bit.\0A */\0A#define PSA_KEY_EXPORT_ASN1_INTEGER_MAX_SIZE(bits)      \5C\0A    ((bits) / 8u + 5u)\0A\0A/* Maximum size of the export encoding of an RSA public key.\0A * Assumes that the public exponent is less than 2^32.\0A *\0A * RSAPublicKey  ::=  SEQUENCE  {\0A *    modulus            INTEGER,    -- n\0A *    publicExponent     INTEGER  }  -- e\0A *\0A * - 4 bytes of SEQUENCE overhead;\0A * - n : INTEGER;\0A * - 7 bytes for the public exponent.\0A */\0A#define PSA_KEY_EXPORT_RSA_PUBLIC_KEY_MAX_SIZE(key_bits)        \5C\0A    (PSA_KEY_EXPORT_ASN1_INTEGER_MAX_SIZE(key_bits) + 11u)\0A\0A/* Maximum size of the export encoding of an RSA key pair.\0A * Assumes that the public exponent is less than 2^32 and that the size\0A * difference between the two primes is at most 1 bit.\0A *\0A * RSAPrivateKey ::= SEQUENCE {\0A *     version           Version,  -- 0\0A *     modulus           INTEGER,  -- N-bit\0A *     publicExponent    INTEGER,  -- 32-bit\0A *     privateExponent   INTEGER,  -- N-bit\0A *     prime1            INTEGER,  -- N/2-bit\0A *     prime2            INTEGER,  -- N/2-bit\0A *     exponent1         INTEGER,  -- N/2-bit\0A *     exponent2         INTEGER,  -- N/2-bit\0A *     coefficient       INTEGER,  -- N/2-bit\0A * }\0A *\0A * - 4 bytes of SEQUENCE overhead;\0A * - 3 bytes of version;\0A * - 7 half-size INTEGERs plus 2 full-size INTEGERs,\0A *   overapproximated as 9 half-size INTEGERS;\0A * - 7 bytes for the public exponent.\0A */\0A#define PSA_KEY_EXPORT_RSA_KEY_PAIR_MAX_SIZE(key_bits)   \5C\0A    (9u * PSA_KEY_EXPORT_ASN1_INTEGER_MAX_SIZE((key_bits) / 2u + 1u) + 14u)\0A\0A/* Maximum size of the export encoding of a DSA public key.\0A *\0A * SubjectPublicKeyInfo  ::=  SEQUENCE  {\0A *      algorithm            AlgorithmIdentifier,\0A *      subjectPublicKey     BIT STRING  } -- contains DSAPublicKey\0A * AlgorithmIdentifier  ::=  SEQUENCE  {\0A *      algorithm               OBJECT IDENTIFIER,\0A *      parameters              Dss-Params  } -- SEQUENCE of 3 INTEGERs\0A * DSAPublicKey  ::=  INTEGER -- public key, Y\0A *\0A * - 3 * 4 bytes of SEQUENCE overhead;\0A * - 1 + 1 + 7 bytes of algorithm (DSA OID);\0A * - 4 bytes of BIT STRING overhead;\0A * - 3 full-size INTEGERs (p, g, y);\0A * - 1 + 1 + 32 bytes for 1 sub-size INTEGER (q <= 256 bits).\0A */\0A#define PSA_KEY_EXPORT_DSA_PUBLIC_KEY_MAX_SIZE(key_bits)        \5C\0A    (PSA_KEY_EXPORT_ASN1_INTEGER_MAX_SIZE(key_bits) * 3u + 59u)\0A\0A/* Maximum size of the export encoding of a DSA key pair.\0A *\0A * DSAPrivateKey ::= SEQUENCE {\0A *     version             Version,  -- 0\0A *     prime               INTEGER,  -- p\0A *     subprime            INTEGER,  -- q\0A *     generator           INTEGER,  -- g\0A *     public              INTEGER,  -- y\0A *     private             INTEGER,  -- x\0A * }\0A *\0A * - 4 bytes of SEQUENCE overhead;\0A * - 3 bytes of version;\0A * - 3 full-size INTEGERs (p, g, y);\0A * - 2 * (1 + 1 + 32) bytes for 2 sub-size INTEGERs (q, x <= 256 bits).\0A */\0A#define PSA_KEY_EXPORT_DSA_KEY_PAIR_MAX_SIZE(key_bits)   \5C\0A    (PSA_KEY_EXPORT_ASN1_INTEGER_MAX_SIZE(key_bits) * 3u + 75u)\0A\0A/* Maximum size of the export encoding of an ECC public key.\0A *\0A * The representation of an ECC public key is:\0A *      - The byte 0x04;\0A *      - `x_P` as a `ceiling(m/8)`-byte string, big-endian;\0A *      - `y_P` as a `ceiling(m/8)`-byte string, big-endian;\0A *      - where m is the bit size associated with the curve.\0A *\0A * - 1 byte + 2 * point size.\0A */\0A#define PSA_KEY_EXPORT_ECC_PUBLIC_KEY_MAX_SIZE(key_bits)        \5C\0A    (2u * PSA_BITS_TO_BYTES(key_bits) + 1u)\0A\0A/* Maximum size of the export encoding of an ECC key pair.\0A *\0A * An ECC key pair is represented by the secret value.\0A */\0A#define PSA_KEY_EXPORT_ECC_KEY_PAIR_MAX_SIZE(key_bits)   \5C\0A    (PSA_BITS_TO_BYTES(key_bits))\0A\0A/* Maximum size of the export encoding of an DH key pair.\0A *\0A * An DH key pair is represented by the secret value.\0A */\0A#define PSA_KEY_EXPORT_FFDH_KEY_PAIR_MAX_SIZE(key_bits)   \5C\0A    (PSA_BITS_TO_BYTES(key_bits))\0A\0A/* Maximum size of the export encoding of an DH public key.\0A */\0A#define PSA_KEY_EXPORT_FFDH_PUBLIC_KEY_MAX_SIZE(key_bits)   \5C\0A    (PSA_BITS_TO_BYTES(key_bits))\0A\0A/** Sufficient output buffer size for psa_export_key() or\0A * psa_export_public_key().\0A *\0A * This macro returns a compile-time constant if its arguments are\0A * compile-time constants.\0A *\0A * \5Cwarning This macro may evaluate its arguments multiple times or\0A *          zero times, so you should not pass arguments that contain\0A *          side effects.\0A *\0A * The following code illustrates how to allocate enough memory to export\0A * a key by querying the key type and size at runtime.\0A * \5Ccode{c}\0A * psa_key_attributes_t attributes = PSA_KEY_ATTRIBUTES_INIT;\0A * psa_status_t status;\0A * status = psa_get_key_attributes(key, &attributes);\0A * if (status != PSA_SUCCESS) handle_error(...);\0A * psa_key_type_t key_type = psa_get_key_type(&attributes);\0A * size_t key_bits = psa_get_key_bits(&attributes);\0A * size_t buffer_size = PSA_EXPORT_KEY_OUTPUT_SIZE(key_type, key_bits);\0A * psa_reset_key_attributes(&attributes);\0A * uint8_t *buffer = malloc(buffer_size);\0A * if (buffer == NULL) handle_error(...);\0A * size_t buffer_length;\0A * status = psa_export_key(key, buffer, buffer_size, &buffer_length);\0A * if (status != PSA_SUCCESS) handle_error(...);\0A * \5Cendcode\0A *\0A * \5Cparam key_type  A supported key type.\0A * \5Cparam key_bits  The size of the key in bits.\0A *\0A * \5Creturn If the parameters are valid and supported, return\0A *         a buffer size in bytes that guarantees that\0A *         psa_export_key() or psa_export_public_key() will not fail with\0A *         #PSA_ERROR_BUFFER_TOO_SMALL.\0A *         If the parameters are a valid combination that is not supported,\0A *         return either a sensible size or 0.\0A *         If the parameters are not valid, the return value is unspecified.\0A */\0A#define PSA_EXPORT_KEY_OUTPUT_SIZE(key_type, key_bits)                                              \5C\0A    (PSA_KEY_TYPE_IS_UNSTRUCTURED(key_type) ? PSA_BITS_TO_BYTES(key_bits) :                         \5C\0A     PSA_KEY_TYPE_IS_DH(key_type) ? PSA_BITS_TO_BYTES(key_bits) :                                   \5C\0A     (key_type) == PSA_KEY_TYPE_RSA_KEY_PAIR ? PSA_KEY_EXPORT_RSA_KEY_PAIR_MAX_SIZE(key_bits) :     \5C\0A     (key_type) == PSA_KEY_TYPE_RSA_PUBLIC_KEY ? PSA_KEY_EXPORT_RSA_PUBLIC_KEY_MAX_SIZE(key_bits) : \5C\0A     (key_type) == PSA_KEY_TYPE_DSA_KEY_PAIR ? PSA_KEY_EXPORT_DSA_KEY_PAIR_MAX_SIZE(key_bits) :     \5C\0A     (key_type) == PSA_KEY_TYPE_DSA_PUBLIC_KEY ? PSA_KEY_EXPORT_DSA_PUBLIC_KEY_MAX_SIZE(key_bits) : \5C\0A     PSA_KEY_TYPE_IS_ECC_KEY_PAIR(key_type) ? PSA_KEY_EXPORT_ECC_KEY_PAIR_MAX_SIZE(key_bits) :      \5C\0A     PSA_KEY_TYPE_IS_ECC_PUBLIC_KEY(key_type) ? PSA_KEY_EXPORT_ECC_PUBLIC_KEY_MAX_SIZE(key_bits) :  \5C\0A     0u)\0A\0A/** Sufficient output buffer size for psa_export_public_key().\0A *\0A * This macro returns a compile-time constant if its arguments are\0A * compile-time constants.\0A *\0A * \5Cwarning This macro may evaluate its arguments multiple times or\0A *          zero times, so you should not pass arguments that contain\0A *          side effects.\0A *\0A * The following code illustrates how to allocate enough memory to export\0A * a public key by querying the key type and size at runtime.\0A * \5Ccode{c}\0A * psa_key_attributes_t attributes = PSA_KEY_ATTRIBUTES_INIT;\0A * psa_status_t status;\0A * status = psa_get_key_attributes(key, &attributes);\0A * if (status != PSA_SUCCESS) handle_error(...);\0A * psa_key_type_t key_type = psa_get_key_type(&attributes);\0A * size_t key_bits = psa_get_key_bits(&attributes);\0A * size_t buffer_size = PSA_EXPORT_PUBLIC_KEY_OUTPUT_SIZE(key_type, key_bits);\0A * psa_reset_key_attributes(&attributes);\0A * uint8_t *buffer = malloc(buffer_size);\0A * if (buffer == NULL) handle_error(...);\0A * size_t buffer_length;\0A * status = psa_export_public_key(key, buffer, buffer_size, &buffer_length);\0A * if (status != PSA_SUCCESS) handle_error(...);\0A * \5Cendcode\0A *\0A * \5Cparam key_type      A public key or key pair key type.\0A * \5Cparam key_bits      The size of the key in bits.\0A *\0A * \5Creturn              If the parameters are valid and supported, return\0A *                      a buffer size in bytes that guarantees that\0A *                      psa_export_public_key() will not fail with\0A *                      #PSA_ERROR_BUFFER_TOO_SMALL.\0A *                      If the parameters are a valid combination that is not\0A *                      supported, return either a sensible size or 0.\0A *                      If the parameters are not valid,\0A *                      the return value is unspecified.\0A *\0A *                      If the parameters are valid and supported,\0A *                      return the same result as\0A *                      #PSA_EXPORT_KEY_OUTPUT_SIZE(\0A *                          \5Cp #PSA_KEY_TYPE_PUBLIC_KEY_OF_KEY_PAIR(\5Cp key_type),\0A *                          \5Cp key_bits).\0A */\0A#define PSA_EXPORT_PUBLIC_KEY_OUTPUT_SIZE(key_type, key_bits)                           \5C\0A    (PSA_KEY_TYPE_IS_RSA(key_type) ? PSA_KEY_EXPORT_RSA_PUBLIC_KEY_MAX_SIZE(key_bits) : \5C\0A     PSA_KEY_TYPE_IS_ECC(key_type) ? PSA_KEY_EXPORT_ECC_PUBLIC_KEY_MAX_SIZE(key_bits) : \5C\0A     PSA_KEY_TYPE_IS_DH(key_type) ? PSA_BITS_TO_BYTES(key_bits) : \5C\0A     0u)\0A\0A/** Sufficient buffer size for exporting any asymmetric key pair.\0A *\0A * This macro expands to a compile-time constant integer. This value is\0A * a sufficient buffer size when calling psa_export_key() to export any\0A * asymmetric key pair, regardless of the exact key type and key size.\0A *\0A * See also #PSA_EXPORT_KEY_OUTPUT_SIZE(\5Cp key_type, \5Cp key_bits).\0A */\0A#define PSA_EXPORT_KEY_PAIR_MAX_SIZE            1\0A\0A#if defined(PSA_WANT_KEY_TYPE_ECC_KEY_PAIR_BASIC) && \5C\0A    (PSA_KEY_EXPORT_ECC_KEY_PAIR_MAX_SIZE(PSA_VENDOR_ECC_MAX_CURVE_BITS) > \5C\0A     PSA_EXPORT_KEY_PAIR_MAX_SIZE)\0A#undef PSA_EXPORT_KEY_PAIR_MAX_SIZE\0A#define PSA_EXPORT_KEY_PAIR_MAX_SIZE    \5C\0A    PSA_KEY_EXPORT_ECC_KEY_PAIR_MAX_SIZE(PSA_VENDOR_ECC_MAX_CURVE_BITS)\0A#endif\0A#if defined(PSA_WANT_KEY_TYPE_RSA_KEY_PAIR_BASIC) && \5C\0A    (PSA_KEY_EXPORT_RSA_KEY_PAIR_MAX_SIZE(PSA_VENDOR_RSA_MAX_KEY_BITS) > \5C\0A     PSA_EXPORT_KEY_PAIR_MAX_SIZE)\0A#undef PSA_EXPORT_KEY_PAIR_MAX_SIZE\0A#define PSA_EXPORT_KEY_PAIR_MAX_SIZE    \5C\0A    PSA_KEY_EXPORT_RSA_KEY_PAIR_MAX_SIZE(PSA_VENDOR_RSA_MAX_KEY_BITS)\0A#endif\0A#if defined(PSA_WANT_KEY_TYPE_DH_KEY_PAIR_BASIC) && \5C\0A    (PSA_KEY_EXPORT_FFDH_KEY_PAIR_MAX_SIZE(PSA_VENDOR_FFDH_MAX_KEY_BITS) > \5C\0A     PSA_EXPORT_KEY_PAIR_MAX_SIZE)\0A#undef PSA_EXPORT_KEY_PAIR_MAX_SIZE\0A#define PSA_EXPORT_KEY_PAIR_MAX_SIZE    \5C\0A    PSA_KEY_EXPORT_FFDH_KEY_PAIR_MAX_SIZE(PSA_VENDOR_FFDH_MAX_KEY_BITS)\0A#endif\0A\0A/** Sufficient buffer size for exporting any asymmetric public key.\0A *\0A * This macro expands to a compile-time constant integer. This value is\0A * a sufficient buffer size when calling psa_export_key() or\0A * psa_export_public_key() to export any asymmetric public key,\0A * regardless of the exact key type and key size.\0A *\0A * See also #PSA_EXPORT_PUBLIC_KEY_OUTPUT_SIZE(\5Cp key_type, \5Cp key_bits).\0A */\0A#define PSA_EXPORT_PUBLIC_KEY_MAX_SIZE            1\0A\0A#if defined(PSA_WANT_KEY_TYPE_ECC_PUBLIC_KEY) && \5C\0A    (PSA_KEY_EXPORT_ECC_PUBLIC_KEY_MAX_SIZE(PSA_VENDOR_ECC_MAX_CURVE_BITS) > \5C\0A     PSA_EXPORT_PUBLIC_KEY_MAX_SIZE)\0A#undef PSA_EXPORT_PUBLIC_KEY_MAX_SIZE\0A#define PSA_EXPORT_PUBLIC_KEY_MAX_SIZE    \5C\0A    PSA_KEY_EXPORT_ECC_PUBLIC_KEY_MAX_SIZE(PSA_VENDOR_ECC_MAX_CURVE_BITS)\0A#endif\0A#if defined(PSA_WANT_KEY_TYPE_RSA_PUBLIC_KEY) && \5C\0A    (PSA_KEY_EXPORT_RSA_PUBLIC_KEY_MAX_SIZE(PSA_VENDOR_RSA_MAX_KEY_BITS) > \5C\0A     PSA_EXPORT_PUBLIC_KEY_MAX_SIZE)\0A#undef PSA_EXPORT_PUBLIC_KEY_MAX_SIZE\0A#define PSA_EXPORT_PUBLIC_KEY_MAX_SIZE    \5C\0A    PSA_KEY_EXPORT_RSA_PUBLIC_KEY_MAX_SIZE(PSA_VENDOR_RSA_MAX_KEY_BITS)\0A#endif\0A#if defined(PSA_WANT_KEY_TYPE_DH_PUBLIC_KEY) && \5C\0A    (PSA_KEY_EXPORT_FFDH_PUBLIC_KEY_MAX_SIZE(PSA_VENDOR_FFDH_MAX_KEY_BITS) > \5C\0A     PSA_EXPORT_PUBLIC_KEY_MAX_SIZE)\0A#undef PSA_EXPORT_PUBLIC_KEY_MAX_SIZE\0A#define PSA_EXPORT_PUBLIC_KEY_MAX_SIZE    \5C\0A    PSA_KEY_EXPORT_FFDH_PUBLIC_KEY_MAX_SIZE(PSA_VENDOR_FFDH_MAX_KEY_BITS)\0A#endif\0A\0A#define PSA_EXPORT_KEY_PAIR_OR_PUBLIC_MAX_SIZE \5C\0A    ((PSA_EXPORT_KEY_PAIR_MAX_SIZE > PSA_EXPORT_PUBLIC_KEY_MAX_SIZE) ? \5C\0A     PSA_EXPORT_KEY_PAIR_MAX_SIZE : PSA_EXPORT_PUBLIC_KEY_MAX_SIZE)\0A\0A/** Sufficient output buffer size for psa_raw_key_agreement().\0A *\0A * This macro returns a compile-time constant if its arguments are\0A * compile-time constants.\0A *\0A * \5Cwarning This macro may evaluate its arguments multiple times or\0A *          zero times, so you should not pass arguments that contain\0A *          side effects.\0A *\0A * See also #PSA_RAW_KEY_AGREEMENT_OUTPUT_MAX_SIZE.\0A *\0A * \5Cparam key_type      A supported key type.\0A * \5Cparam key_bits      The size of the key in bits.\0A *\0A * \5Creturn              If the parameters are valid and supported, return\0A *                      a buffer size in bytes that guarantees that\0A *                      psa_raw_key_agreement() will not fail with\0A *                      #PSA_ERROR_BUFFER_TOO_SMALL.\0A *                      If the parameters are a valid combination that\0A *                      is not supported, return either a sensible size or 0.\0A *                      If the parameters are not valid,\0A *                      the return value is unspecified.\0A */\0A#define PSA_RAW_KEY_AGREEMENT_OUTPUT_SIZE(key_type, key_bits)   \5C\0A    ((PSA_KEY_TYPE_IS_ECC_KEY_PAIR(key_type) || \5C\0A      PSA_KEY_TYPE_IS_DH_KEY_PAIR(key_type)) ? PSA_BITS_TO_BYTES(key_bits) : 0u)\0A\0A/** Maximum size of the output from psa_raw_key_agreement().\0A *\0A * This macro expands to a compile-time constant integer. This value is the\0A * maximum size of the output any raw key agreement algorithm, in bytes.\0A *\0A * See also #PSA_RAW_KEY_AGREEMENT_OUTPUT_SIZE(\5Cp key_type, \5Cp key_bits).\0A */\0A#define PSA_RAW_KEY_AGREEMENT_OUTPUT_MAX_SIZE       1\0A\0A#if defined(PSA_WANT_ALG_ECDH) && \5C\0A    (PSA_BITS_TO_BYTES(PSA_VENDOR_ECC_MAX_CURVE_BITS) > PSA_RAW_KEY_AGREEMENT_OUTPUT_MAX_SIZE)\0A#undef PSA_RAW_KEY_AGREEMENT_OUTPUT_MAX_SIZE\0A#define PSA_RAW_KEY_AGREEMENT_OUTPUT_MAX_SIZE    PSA_BITS_TO_BYTES(PSA_VENDOR_ECC_MAX_CURVE_BITS)\0A#endif\0A#if defined(PSA_WANT_ALG_FFDH) && \5C\0A    (PSA_BITS_TO_BYTES(PSA_VENDOR_FFDH_MAX_KEY_BITS) > PSA_RAW_KEY_AGREEMENT_OUTPUT_MAX_SIZE)\0A#undef PSA_RAW_KEY_AGREEMENT_OUTPUT_MAX_SIZE\0A#define PSA_RAW_KEY_AGREEMENT_OUTPUT_MAX_SIZE    PSA_BITS_TO_BYTES(PSA_VENDOR_FFDH_MAX_KEY_BITS)\0A#endif\0A\0A/** Maximum key length for ciphers.\0A *\0A * Since there is no additional PSA_WANT_xxx symbol to specifiy the size of\0A * the key once a cipher is enabled (as it happens for asymmetric keys for\0A * example), the maximum key length is taken into account for each cipher.\0A * The resulting value will be the maximum cipher's key length given depending\0A * on which ciphers are enabled.\0A *\0A * Note: max value for AES used below would be doubled if XTS were enabled, but\0A *       this mode is currently not supported in Mbed TLS implementation of PSA\0A *       APIs.\0A */\0A#if (defined(PSA_WANT_KEY_TYPE_AES) || defined(PSA_WANT_KEY_TYPE_ARIA) || \5C\0A    defined(PSA_WANT_KEY_TYPE_CAMELLIA) || defined(PSA_WANT_KEY_TYPE_CHACHA20))\0A#define PSA_CIPHER_MAX_KEY_LENGTH       32u\0A#elif defined(PSA_WANT_KEY_TYPE_DES)\0A#define PSA_CIPHER_MAX_KEY_LENGTH       24u\0A#else\0A#define PSA_CIPHER_MAX_KEY_LENGTH       0u\0A#endif\0A\0A/** The default IV size for a cipher algorithm, in bytes.\0A *\0A * The IV that is generated as part of a call to #psa_cipher_encrypt() is always\0A * the default IV length for the algorithm.\0A *\0A * This macro can be used to allocate a buffer of sufficient size to\0A * store the IV output from #psa_cipher_generate_iv() when using\0A * a multi-part cipher operation.\0A *\0A * See also #PSA_CIPHER_IV_MAX_SIZE.\0A *\0A * \5Cwarning This macro may evaluate its arguments multiple times or\0A *          zero times, so you should not pass arguments that contain\0A *          side effects.\0A *\0A * \5Cparam key_type  A symmetric key type that is compatible with algorithm \5Cp alg.\0A *\0A * \5Cparam alg       A cipher algorithm (\5Cc PSA_ALG_XXX value such that #PSA_ALG_IS_CIPHER(\5Cp alg) is true).\0A *\0A * \5Creturn The default IV size for the specified key type and algorithm.\0A *         If the algorithm does not use an IV, return 0.\0A *         If the key type or cipher algorithm is not recognized,\0A *         or the parameters are incompatible, return 0.\0A */\0A#define PSA_CIPHER_IV_LENGTH(key_type, alg) \5C\0A    (PSA_BLOCK_CIPHER_BLOCK_LENGTH(key_type) > 1 && \5C\0A     ((alg) == PSA_ALG_CTR || \5C\0A      (alg) == PSA_ALG_CFB || \5C\0A      (alg) == PSA_ALG_OFB || \5C\0A      (alg) == PSA_ALG_XTS || \5C\0A      (alg) == PSA_ALG_CBC_NO_PADDING || \5C\0A      (alg) == PSA_ALG_CBC_PKCS7) ? PSA_BLOCK_CIPHER_BLOCK_LENGTH(key_type) : \5C\0A     (key_type) == PSA_KEY_TYPE_CHACHA20 && \5C\0A     (alg) == PSA_ALG_STREAM_CIPHER ? 12u : \5C\0A     (alg) == PSA_ALG_CCM_STAR_NO_TAG ? 13u : \5C\0A     0u)\0A\0A/** The maximum IV size for all supported cipher algorithms, in bytes.\0A *\0A * See also #PSA_CIPHER_IV_LENGTH().\0A */\0A#define PSA_CIPHER_IV_MAX_SIZE 16u\0A\0A/** The maximum size of the output of psa_cipher_encrypt(), in bytes.\0A *\0A * If the size of the output buffer is at least this large, it is guaranteed\0A * that psa_cipher_encrypt() will not fail due to an insufficient buffer size.\0A * Depending on the algorithm, the actual size of the output might be smaller.\0A *\0A * See also #PSA_CIPHER_ENCRYPT_OUTPUT_MAX_SIZE(\5Cp input_length).\0A *\0A * \5Cwarning This macro may evaluate its arguments multiple times or\0A *          zero times, so you should not pass arguments that contain\0A *          side effects.\0A *\0A * \5Cparam key_type      A symmetric key type that is compatible with algorithm\0A *                      alg.\0A * \5Cparam alg           A cipher algorithm (\5Cc PSA_ALG_XXX value such that\0A *                      #PSA_ALG_IS_CIPHER(\5Cp alg) is true).\0A * \5Cparam input_length  Size of the input in bytes.\0A *\0A * \5Creturn              A sufficient output size for the specified key type and\0A *                      algorithm. If the key type or cipher algorithm is not\0A *                      recognized, or the parameters are incompatible,\0A *                      return 0.\0A */\0A#define PSA_CIPHER_ENCRYPT_OUTPUT_SIZE(key_type, alg, input_length)     \5C\0A    (alg == PSA_ALG_CBC_PKCS7 ?                                         \5C\0A     (PSA_BLOCK_CIPHER_BLOCK_LENGTH(key_type) != 0 ?                    \5C\0A      PSA_ROUND_UP_TO_MULTIPLE(PSA_BLOCK_CIPHER_BLOCK_LENGTH(key_type), \5C\0A                               (input_length) + 1u) +                   \5C\0A      PSA_CIPHER_IV_LENGTH((key_type), (alg)) : 0u) :                   \5C\0A     (PSA_ALG_IS_CIPHER(alg) ?                                          \5C\0A      (input_length) + PSA_CIPHER_IV_LENGTH((key_type), (alg)) :        \5C\0A      0u))\0A\0A/** A sufficient output buffer size for psa_cipher_encrypt(), for any of the\0A *  supported key types and cipher algorithms.\0A *\0A * If the size of the output buffer is at least this large, it is guaranteed\0A * that psa_cipher_encrypt() will not fail due to an insufficient buffer size.\0A *\0A * See also #PSA_CIPHER_ENCRYPT_OUTPUT_SIZE(\5Cp key_type, \5Cp alg, \5Cp input_length).\0A *\0A * \5Cparam input_length  Size of the input in bytes.\0A *\0A */\0A#define PSA_CIPHER_ENCRYPT_OUTPUT_MAX_SIZE(input_length)                \5C\0A    (PSA_ROUND_UP_TO_MULTIPLE(PSA_BLOCK_CIPHER_BLOCK_MAX_SIZE,          \5C\0A                              (input_length) + 1u) +                    \5C\0A     PSA_CIPHER_IV_MAX_SIZE)\0A\0A/** The maximum size of the output of psa_cipher_decrypt(), in bytes.\0A *\0A * If the size of the output buffer is at least this large, it is guaranteed\0A * that psa_cipher_decrypt() will not fail due to an insufficient buffer size.\0A * Depending on the algorithm, the actual size of the output might be smaller.\0A *\0A * See also #PSA_CIPHER_DECRYPT_OUTPUT_MAX_SIZE(\5Cp input_length).\0A *\0A * \5Cparam key_type      A symmetric key type that is compatible with algorithm\0A *                      alg.\0A * \5Cparam alg           A cipher algorithm (\5Cc PSA_ALG_XXX value such that\0A *                      #PSA_ALG_IS_CIPHER(\5Cp alg) is true).\0A * \5Cparam input_length  Size of the input in bytes.\0A *\0A * \5Creturn              A sufficient output size for the specified key type and\0A *                      algorithm. If the key type or cipher algorithm is not\0A *                      recognized, or the parameters are incompatible,\0A *                      return 0.\0A */\0A#define PSA_CIPHER_DECRYPT_OUTPUT_SIZE(key_type, alg, input_length)     \5C\0A    (PSA_ALG_IS_CIPHER(alg) &&                                          \5C\0A     ((key_type) & PSA_KEY_TYPE_CATEGORY_MASK) == PSA_KEY_TYPE_CATEGORY_SYMMETRIC ? \5C\0A     (input_length) :                                                   \5C\0A     0u)\0A\0A/** A sufficient output buffer size for psa_cipher_decrypt(), for any of the\0A *  supported key types and cipher algorithms.\0A *\0A * If the size of the output buffer is at least this large, it is guaranteed\0A * that psa_cipher_decrypt() will not fail due to an insufficient buffer size.\0A *\0A * See also #PSA_CIPHER_DECRYPT_OUTPUT_SIZE(\5Cp key_type, \5Cp alg, \5Cp input_length).\0A *\0A * \5Cparam input_length  Size of the input in bytes.\0A */\0A#define PSA_CIPHER_DECRYPT_OUTPUT_MAX_SIZE(input_length)    \5C\0A    (input_length)\0A\0A/** A sufficient output buffer size for psa_cipher_update().\0A *\0A * If the size of the output buffer is at least this large, it is guaranteed\0A * that psa_cipher_update() will not fail due to an insufficient buffer size.\0A * The actual size of the output might be smaller in any given call.\0A *\0A * See also #PSA_CIPHER_UPDATE_OUTPUT_MAX_SIZE(\5Cp input_length).\0A *\0A * \5Cparam key_type      A symmetric key type that is compatible with algorithm\0A *                      alg.\0A * \5Cparam alg           A cipher algorithm (PSA_ALG_XXX value such that\0A *                      #PSA_ALG_IS_CIPHER(\5Cp alg) is true).\0A * \5Cparam input_length  Size of the input in bytes.\0A *\0A * \5Creturn              A sufficient output size for the specified key type and\0A *                      algorithm. If the key type or cipher algorithm is not\0A *                      recognized, or the parameters are incompatible, return 0.\0A */\0A#define PSA_CIPHER_UPDATE_OUTPUT_SIZE(key_type, alg, input_length)      \5C\0A    (PSA_ALG_IS_CIPHER(alg) ?                                           \5C\0A     (PSA_BLOCK_CIPHER_BLOCK_LENGTH(key_type) != 0 ?                    \5C\0A      (((alg) == PSA_ALG_CBC_PKCS7      ||                              \5C\0A        (alg) == PSA_ALG_CBC_NO_PADDING ||                              \5C\0A        (alg) == PSA_ALG_ECB_NO_PADDING) ?                              \5C\0A       PSA_ROUND_UP_TO_MULTIPLE(PSA_BLOCK_CIPHER_BLOCK_LENGTH(key_type), \5C\0A                                input_length) :                         \5C\0A       (input_length)) : 0u) :                                          \5C\0A     0u)\0A\0A/** A sufficient output buffer size for psa_cipher_update(), for any of the\0A *  supported key types and cipher algorithms.\0A *\0A * If the size of the output buffer is at least this large, it is guaranteed\0A * that psa_cipher_update() will not fail due to an insufficient buffer size.\0A *\0A * See also #PSA_CIPHER_UPDATE_OUTPUT_SIZE(\5Cp key_type, \5Cp alg, \5Cp input_length).\0A *\0A * \5Cparam input_length  Size of the input in bytes.\0A */\0A#define PSA_CIPHER_UPDATE_OUTPUT_MAX_SIZE(input_length)     \5C\0A    (PSA_ROUND_UP_TO_MULTIPLE(PSA_BLOCK_CIPHER_BLOCK_MAX_SIZE, input_length))\0A\0A/** A sufficient ciphertext buffer size for psa_cipher_finish().\0A *\0A * If the size of the ciphertext buffer is at least this large, it is\0A * guaranteed that psa_cipher_finish() will not fail due to an insufficient\0A * ciphertext buffer size. The actual size of the output might be smaller in\0A * any given call.\0A *\0A * See also #PSA_CIPHER_FINISH_OUTPUT_MAX_SIZE().\0A *\0A * \5Cparam key_type      A symmetric key type that is compatible with algorithm\0A *                      alg.\0A * \5Cparam alg           A cipher algorithm (PSA_ALG_XXX value such that\0A *                      #PSA_ALG_IS_CIPHER(\5Cp alg) is true).\0A * \5Creturn              A sufficient output size for the specified key type and\0A *                      algorithm. If the key type or cipher algorithm is not\0A *                      recognized, or the parameters are incompatible, return 0.\0A */\0A#define PSA_CIPHER_FINISH_OUTPUT_SIZE(key_type, alg)    \5C\0A    (PSA_ALG_IS_CIPHER(alg) ?                           \5C\0A     (alg == PSA_ALG_CBC_PKCS7 ?                        \5C\0A      PSA_BLOCK_CIPHER_BLOCK_LENGTH(key_type) :         \5C\0A      0u) :                                             \5C\0A     0u)\0A\0A/** A sufficient ciphertext buffer size for psa_cipher_finish(), for any of the\0A *  supported key types and cipher algorithms.\0A *\0A * See also #PSA_CIPHER_FINISH_OUTPUT_SIZE(\5Cp key_type, \5Cp alg).\0A */\0A#define PSA_CIPHER_FINISH_OUTPUT_MAX_SIZE           \5C\0A    (PSA_BLOCK_CIPHER_BLOCK_MAX_SIZE)\0A\0A#endif /* PSA_CRYPTO_SIZES_H */\0A\00" }
