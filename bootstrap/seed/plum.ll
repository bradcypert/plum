ic error code\0A */\0AMBEDTLS_CHECK_RETURN_CRITICAL\0AMBEDTLS_STATIC_TESTABLE\0Aint mbedtls_ssl_check_dtls_clihlo_cookie(\0A    mbedtls_ssl_context *ssl,\0A    const unsigned char *cli_id, size_t cli_id_len,\0A    const unsigned char *in, size_t in_len,\0A    unsigned char *obuf, size_t buf_len, size_t *olen)\0A{\0A    size_t sid_len, cookie_len, epoch, fragment_offset;\0A    unsigned char *p;\0A\0A    /*\0A     * Structure of ClientHello with record and handshake headers,\0A     * and expected values. We don't need to check a lot, more checks will be\0A     * done when actually parsing the ClientHello - skipping those checks\0A     * avoids code duplication and does not make cookie forging any easier.\0A     *\0A     *  0-0  ContentType type;                  copied, must be handshake\0A     *  1-2  ProtocolVersion version;           copied\0A     *  3-4  uint16 epoch;                      copied, must be 0\0A     *  5-10 uint48 sequence_number;            copied\0A     * 11-12 uint16 length;                     (ignored)\0A     *\0A     * 13-13 HandshakeType msg_type;            (ignored)\0A     * 14-16 uint24 length;                     (ignored)\0A     * 17-18 uint16 message_seq;                copied\0A     * 19-21 uint24 fragment_offset;            copied, must be 0\0A     * 22-24 uint24 fragment_length;            (ignored)\0A     *\0A     * 25-26 ProtocolVersion client_version;    (ignored)\0A     * 27-58 Random random;                     (ignored)\0A     * 59-xx SessionID session_id;              1 byte len + sid_len content\0A     * 60+   opaque cookie<0..2^8-1>;           1 byte len + content\0A     *       ...\0A     *\0A     * Minimum length is 61 bytes.\0A     */\0A    MBEDTLS_SSL_DEBUG_MSG(4, (\22check cookie: in_len=%u\22,\0A                              (unsigned) in_len));\0A    MBEDTLS_SSL_DEBUG_BUF(4, \22cli_id\22, cli_id, cli_id_len);\0A    if (in_len < 61) {\0A        MBEDTLS_SSL_DEBUG_MSG(4, (\22check cookie: record too short\22));\0A        return MBEDTLS_ERR_SSL_DECODE_ERROR;\0A    }\0A\0A    epoch = MBEDTLS_GET_UINT16_BE(in, 3);\0A    fragment_offset = MBEDTLS_GET_UINT24_BE(in, 19);\0A\0A    if (in[0] != MBEDTLS_SSL_MSG_HANDSHAKE || epoch != 0 ||\0A        fragment_offset != 0) {\0A        MBEDTLS_SSL_DEBUG_MSG(4, (\22check cookie: not a good ClientHello\22));\0A        MBEDTLS_SSL_DEBUG_MSG(4, (\22    type=%u epoch=%u fragment_offset=%u\22,\0A                                  in[0], (unsigned) epoch,\0A                                  (unsigned) fragment_offset));\0A        return MBEDTLS_ERR_SSL_DECODE_ERROR;\0A    }\0A\0A    sid_len = in[59];\0A    if (59 + 1 + sid_len + 1 > in_len) {\0A        MBEDTLS_SSL_DEBUG_MSG(4, (\22check cookie: sid_len=%u > %u\22,\0A                                  (unsigned) sid_len,\0A                                  (unsigned) in_len - 61));\0A        return MBEDTLS_ERR_SSL_DECODE_ERROR;\0A    }\0A    MBEDTLS_SSL_DEBUG_BUF(4, \22sid received from network\22,\0A                          in + 60, sid_len);\0A\0A    cookie_len = in[60 + sid_len];\0A    if (59 + 1 + sid_len + 1 + cookie_len > in_len) {\0A        MBEDTLS_SSL_DEBUG_MSG(4, (\22check cookie: cookie_len=%u > %u\22,\0A                                  (unsigned) cookie_len,\0A                                  (unsigned) (in_len - sid_len - 61)));\0A        return MBEDTLS_ERR_SSL_DECODE_ERROR;\0A    }\0A\0A    MBEDTLS_SSL_DEBUG_BUF(4, \22cookie received from network\22,\0A                          in + sid_len + 61, cookie_len);\0A    if (ssl->conf->f_cookie_check(ssl->conf->p_cookie,\0A                                  in + sid_len + 61, cookie_len,\0A                                  cli_id, cli_id_len) == 0) {\0A        MBEDTLS_SSL_DEBUG_MSG(4, (\22check cookie: valid\22));\0A        return 0;\0A    }\0A\0A    /*\0A     * If we get here, we've got an invalid cookie, let's prepare HVR.\0A     *\0A     *  0-0  ContentType type;                  copied\0A     *  1-2  ProtocolVersion version;           copied\0