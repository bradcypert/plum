sult[Unit, String] =\0A    http_recv_headers_acc(conn, 0, \22\22) |> Result.and_then(_, |raw|\0A        match http_parse_request_head(raw) {\0A            Err(e) => http_write_bad_request(conn, \22HTTP/1.1 400 Bad Request\5Cr\5CnContent-Length: 0\5Cr\5CnConnection: close\5Cr\5Cn\5Cr\5Cn\22)\0A                |> Result.and_then(_, |ignored| Err(e)),\0A            Ok(head) => http_read_request_body(conn, head.headers, head.leftover_body) |> Result.and_then(_, |body| {\0A                let request = Request { method: head.method, path: head.path, headers: head.headers, body: body };\0A                let response = handler(request);\0A                http_response_to_wire(head.method, response)\0A                    |> Result.and_then(_, |wire| Result.map(Net.write(conn, wire), |sent| ()))\0A            }),\0A        })\0A\0A/// Handles exactly ONE connection then returns — listens, accepts once,\0A/// closes both the connection and the listening socket, and gives back\0A/// whatever `http_handle_connection` produced. Invalid handler headers\0A/// return Err without writing response bytes; the connection is closed.\0A/// Status codes must be 200..599: informational-only handler responses and\0A/// successful CONNECT tunnels return Err without writing response bytes.\0A/// HEAD, 204, and 304 suppress the handler's body. HEAD reports its byte\0A/// length; 204 and 304 omit Content-Length. Caller Content-Length and\0A/// Transfer-Encoding fields are replaced by this generated framing.\0A/// Malformed request lines/fields and missing (HTTP/1.1), duplicate, or\0A/// invalid Host fields receive 400 before body reading or handler dispatch,\0A/// then return Err. HTTP/1.0 may omit Host. Present Host values use URI host\0A/// syntax, including empty values, IP literals, and optional decimal ports.\0A/// Real, useful on its own\0A/// (a one-shot server, or a test fixture — this is what THIS module's\0A/// own tests exercise directly), not just a building block for `http_\0A/// serve` below.\0Apub let serve_once (port: Int) (handler: (Request) -> Response): Result[Unit, String] =\0A    match Net.listen_on(port) {\0A        Err(e) => Err(e),\0A        Ok(server) => match Net.accept(server) {\0A            Err(e) => { Net.close(server); Err(e) },\0A            Ok(conn) => {\0A                let result = http_handle_connection(conn, handler);\0A                Net.close(conn);\0A                Net.close(server);\0A                result\0A            },\0A        },\0A    }\0A\0A/// The REAL long-running server: accept, hand the connection off to its\0A/// own task, repeat — forever. Concurrent by design: `spawn` puts each\0A/// connection's `http_handle_connection`/close on its own real OS\0A/// thread (see DESIGN.md's Concurrency section — \22OS threads first\22)\0A/// so one slow client (a slow body, a slow handler) can't stall every\0A/// OTHER connection behind it the way a single sequential accept-loop\0A/// would. A single misbehaving/erroring connection does NOT bring the\0A/// server down (the spawned task's `Result` is deliberately never\0A/// joined, let alone matched — a bare discarded statement, same idiom\0A/// `println`'s own `write(1, s.as_cstr(), n);` already established for\0A/// a discarded non-`Unit` extern return) — only a hard failure to\0A/// ACCEPT (a real listener-level problem, not a per-connection one)\0A/// stops the loop, matching `Err` propagating out of `tcp_accept_\0A/// connection` itself.\0A///\0A/// `handler` must be a plain top-level function or a closure that\0A/// captures NOTHING (both cross a `spawn` boundary equally, see\0A/// DESIGN.md's \22native-codegen zero-capture closure fix\22 section) — a\0A/// closure that DOES capture live local state still can't cross: the\0A/// interpreter rejects it with a clear error at the `spawn` site, and\0A/// native codegen rejects it with a clean runtime abort (can't be\0A/// proven safe/unsafe at compile time — the same free-variable slot\0A/// could hold either shape depending on what's passed in).\0A///\0A/// Deliberately not directly compile-and-run tested for the INFINITE-\0A/// LOOP shape itself (no `while`/loop-with-an-exit exists in this\0A/// language, and this function genuinely has none by design — a real\0A/// server keeps serving), same as before this change; what IS new here\0A/// (spawn-per-connection actually running two connections concurrently,\0A/// not serially) is covered by `http_serve_loop_handles_two_connections_\0A/// concurrently_not_serially` below.\0Alet http_serve_loop (server: Int) (handler: (Request) -> Response): Result[Unit, String] =\0A    match Net.accept(server) {\0A        Err(e) => Err(e),\0A        Ok(conn) => {\0A            spawn { http_handle_connection(conn, handler); Net.close(conn) };\0A            http_serve_loop(server, handler)\0A        },\0A    }\0A\0A/// Serves HTTP on a port, calling `handler` once per request, forever.\0A///\0A/// **Never returns** unless listening or accepting fails. Connections\0A/// run concurrently. Invalid handler headers close that connection without\0A/// sending a response; other connections continue to be served. Invalid\0A/// request heads receive 400 and close, as described by `serve_once`.\0Apub let serve (port: Int) (handler: (Request) -> Response): Result[Unit, String] =\0A    match Net.listen_on(port) {\0A        Err(e) => Err(e),\0A        Ok(server) => http_serve_loop(server, handler),\0A    }\0A\00" }
