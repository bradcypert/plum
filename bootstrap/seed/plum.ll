ess\0A     * and thus a session under negotiation. Add a sanity check to detect a\0A     * misuse.\0A     */\0A    if (ssl->session_negotiate == NULL) {\0A        return MBEDTLS_ERR_SSL_INTERNAL_ERROR;\0A    }\0A\0A    /* RFC 8446 section 4.6.1\0A     *\0A     * A server receiving more than max_early_data_size bytes of 0-RTT data\0A     * SHOULD terminate the connection with an \22unexpected_message\22 alert.\0A     * Note that if it is still possible to send early_data_len bytes of early\0A     * data, it means that early_data_len is smaller than max_early_data_size\0A     * (type uint32_t) and can fit in an uint32_t. We use this further\0A     * down.\0A     */\0A    if (early_data_len >\0A        (ssl->session_negotiate->max_early_data_size -\0A         ssl->total_early_data_size)) {\0A\0A        MBEDTLS_SSL_DEBUG_MSG(\0A            2, (\22EarlyData: Too much early data received, \22\0A                \22%lu + %\22 MBEDTLS_PRINTF_SIZET \22 > %lu\22,\0A                (unsigned long) ssl->total_early_data_size,\0A                early_data_len,\0A                (unsigned long) ssl->session_negotiate->max_early_data_size));\0A\0A        MBEDTLS_SSL_PEND_FATAL_ALERT(\0A            MBEDTLS_SSL_ALERT_MSG_UNEXPECTED_MESSAGE,\0A            MBEDTLS_ERR_SSL_UNEXPECTED_MESSAGE);\0A        return MBEDTLS_ERR_SSL_UNEXPECTED_MESSAGE;\0A    }\0A\0A    /*\0A     * early_data_len has been checked to be less than max_early_data_size\0A     * that is uint32_t. Its cast to an uint32_t below is thus safe. We need\0A     * the cast to appease some compilers.\0A     */\0A    ssl->total_early_data_size += (uint32_t) early_data_len;\0A\0A    return 0;\0A}\0A#endif /* MBEDTLS_SSL_SRV_C */\0A#endif /* MBEDTLS_SSL_EARLY_DATA */\0A\0A/* Reset SSL context and update hash for handling HRR.\0A *\0A * Replace Transcript-Hash(X) by\0A * Transcript-Hash( message_hash     ||\0A *                 00 00 Hash.length ||\0A *                 X )\0A * A few states of the handshake are preserved, including:\0A *   - session ID\0A *   - session ticket\0A *   - negotiated ciphersuite\0A */\0Aint mbedtls_ssl_reset_transcript_for_hrr(mbedtls_ssl_context *ssl)\0A{\0A    int ret = MBEDTLS_ERR_ERROR_CORRUPTION_DETECTED;\0A    unsigned char hash_transcript[PSA_HASH_MAX_SIZE + 4];\0A    size_t hash_len;\0A    const mbedtls_ssl_ciphersuite_t *ciphersuite_info =\0A        ssl->handshake->ciphersuite_info;\0A\0A    MBEDTLS_SSL_DEBUG_MSG(3, (\22Reset SSL session for HRR\22));\0A\0A    ret = mbedtls_ssl_get_handshake_transcript(ssl, (mbedtls_md_type_t) ciphersuite_info->mac,\0A                                               hash_transcript + 4,\0A                                               PSA_HASH_MAX_SIZE,\0A                                               &hash_len);\0A    if (ret != 0) {\0A        MBEDTLS_SSL_DEBUG_RET(1, \22mbedtls_ssl_get_handshake_transcript\22, ret);\0A        return ret;\0A    }\0A\0A    hash_transcript[0] = MBEDTLS_SSL_HS_MESSAGE_HASH;\0A    hash_transcript[1] = 0;\0A    hash_transcript[2] = 0;\0A    hash_transcript[3] = (unsigned char) hash_len;\0A\0A    hash_len += 4;\0A\0A    MBEDTLS_SSL_DEBUG_BUF(4, \22Truncated handshake transcript\22,\0A                          hash_transcript, hash_len);\0A\0A    /* Reset running hash and replace it with a hash of the transcript */\0A    ret = mbedtls_ssl_reset_checksum(ssl);\0A    if (ret != 0) {\0A        MBEDTLS_SSL_DEBUG_RET(1, \22mbedtls_ssl_reset_checksum\22, ret);\0A        return ret;\0A    }\0A    ret = ssl->handshake->update_checksum(ssl, hash_transcript, hash_len);\0A    if (ret != 0) {\0A        MBEDTLS_SSL_DEBUG_RET(1, \22update_checksum\22, ret);\0A        return ret;\0A    }\0A\0A    return ret;\0A}\0A\0A#if defined(MBEDTLS_SSL_TLS1_3_KEY_EXCHANGE_MODE_SOME_EPHEMERAL_ENABLED)\0A\0Aint mbedtls_ssl_tls13_read_public_xxdhe_share(mbedtls_ssl_context *ssl,\0A                                              const unsigned char *buf,\0A                                              size_t buf_len)\0A{\0A    uint8_t *p = (uint8_t *) buf;\0A    const uint8_t *end = buf + buf_len;\0A    mbedtls_ssl_handshake_params *handshake = ssl->handshake;\0A\0A    /* Get size of the TLS opaque key_exchange field of the KeyShareEntry struct. */\0A    MBEDTLS_SSL_CHK_BUF_READ_PTR(p, end, 2);\0A    uint16_t peerkey_len = MBEDTLS_GET_UINT16_BE(p, 0);\0A    p += 2;\0A\0A    /* Check if key size is consistent with given buffer length. */\0A    MBEDTLS_SSL_CHK_BUF_READ_PTR(p, end, peerkey_len);\0A\0A    /* Store peer's ECDH/FFDH public key. */\0A    if (peerkey_len > sizeof(handshake->xxdh_psa_peerkey)) {\0A        MBEDTLS_SSL_DEBUG_MSG(1, (\22Invalid public key length: %u > %\22 MBEDTLS_PRINTF_SIZET,\0A                                  (unsigned) peerkey_len,\0A                                  sizeof(handshake->xxdh_psa_peerkey)));\0A        return MBEDTLS_ERR_SSL_HANDSHAKE_FAILURE;\0A    }\0A    memcpy(handshake->xxdh_psa_peerkey, p, peerkey_len);\0A    handshake->xxdh_psa_peerkey_len = peerkey_len;\0A\0A    return 0;\0A}\0A\0A#if defined(PSA_WANT_ALG_FFDH)\0Astatic psa_status_t  mbedtls_ssl_get_psa_ffdh_info_from_tls_id(\0A    uint16_t tls_id, size_t *bits, psa_key_type_t *key_type)\0A{\0A    switch (tls_id) {\0A#if defined(PSA_WANT_DH_RFC7919_2048)\0A        case MBEDTLS_SSL_IANA_TLS_GROUP_FFDHE2048:\0A            *bits = 2048;\0A            *key_type = PSA_KEY_TYPE_DH_KEY_PAIR(PSA_DH_FAMILY_RFC7919);\0A            return PSA_SUCCESS;\0A#endif /* PSA_WANT_DH_RFC7919_2048 */\0A#if defined(PSA_WANT_DH_RFC7919_3072)\0A        case MBEDTLS_SSL_IANA_TLS_GROUP_FFDHE3072:\0A            *bits = 3072;\0A            *key_type =  PSA_KEY_TYPE_DH_KEY_PAIR(PSA_DH_FAMILY_RFC7919);\0A            return PSA_SUCCESS;\0A#endif /* PSA_WANT_DH_RFC7919_3072 */\0A#if defined(PSA_WANT_DH_RFC7919_4096)\0A        case MBEDTLS_SSL_IANA_TLS_GROUP_FFDHE4096:\0A            *bits = 4096;\0A            *key_type =  PSA_KEY_TYPE_DH_KEY_PAIR(PSA_DH_FAMILY_RFC7919);\0A            return PSA_SUCCESS;\0A#endif /* PSA_WANT_DH_RFC7919_4096 */\0A#if defined(PSA_WANT_DH_RFC7919_6144)\0A        case MBEDTLS_SSL_IANA_TLS_GROUP_FFDHE6144:\0A            *bits = 6144;\0A            *key_type =  PSA_KEY_TYPE_DH_KEY_PAIR(PSA_DH_FAMILY_RFC7919);\0A            return PSA_SUCCESS;\0A#endif /* PSA_WANT_DH_RFC7919_6144 */\0A#if defined(PSA_WANT_DH_RFC7919_8192)\0A        case MBEDTLS_SSL_IANA_TLS_GROUP_FFDHE8192:\0A            *bits = 8192;\0A            *key_type =  PSA_KEY_TYPE_DH_KEY_PAIR(PSA_DH_FAMILY_RFC7919);\0A            return PSA_SUCCESS;\0A#endif /* PSA_WANT_DH_RFC7919_8192 */\0A        default:\0A            return PSA_ERROR_NOT_SUPPORTED;\0A    }\0A}\0A#endif /* PSA_WANT_ALG_FFDH */\0A\0Aint mbedtls_ssl_tls13_generate_and_write_xxdh_key_exchange(\0A    mbedtls_ssl_context *ssl,\0A    uint16_t named_group,\0A    unsigned char *buf,\0A    unsigned char *end,\0A    size_t *out_len)\0A{\0A    psa_status_t status = PSA_ERROR_GENERIC_ERROR;\0A    int ret = MBEDTLS_ERR_SSL_FEATURE_UNAVAILABLE;\0A    psa_key_attributes_t key_attributes;\0A    size_t own_pubkey_len;\0A    mbedtls_ssl_handshake_params *handshake = ssl->handshake;\0A    size_t bits = 0;\0A    psa_key_type_t key_type = PSA_KEY_TYPE_NONE;\0A    psa_algorithm_t alg = PSA_ALG_NONE;\0A    size_t buf_size = (size_t) (end - buf);\0A\0A    MBEDTLS_SSL_DEBUG_MSG(1, (\22Perform PSA-based ECDH/FFDH computation.\22));\0A\0A    /* Convert EC's TLS ID to PSA key type. */\0A#if defined(PSA_WANT_ALG_ECDH)\0A    if (mbedtls_ssl_get_psa_curve_info_from_tls_id(\0A            named_group, &key_type, &bits) == PSA_SUCCESS) {\0A        alg = PSA_ALG_ECDH;\0A    }\0A#endif\0A#if defined(PSA_WANT_ALG_FFDH)\0A    if (mbedtls_ssl_get_psa_ffdh_info_from_tls_id(named_group, &bits,\0A                                                  &key_type) == PSA_SUCCESS) {\0A        alg = PSA_ALG_FFDH;\0A    }\0A#endif\0A\0A    if (key_type == PSA_KEY_TYPE_NONE) {\0A        return MBEDTLS_ERR_SSL_HANDSHAKE_FAILURE;\0A    }\0A\0A    if (buf_size < PSA_BITS_TO_BYTES(bits)) {\0A        return MBEDTLS_ERR_SSL_BUFFER_TOO_SMALL;\0A    }\0A\0A    handshake->xxdh_psa_type = key_type;\0A    ssl->handshake->xxdh_psa_bits = bits;\0A\0A    key_attributes = psa_key_attributes_init();\0A    psa_set_key_usage_flags(&key_attributes, PSA_KEY_USAGE_DERIVE);\0A    psa_set_key_algorithm(&key_attributes, alg);\0A    psa_set_key_type(&key_attributes, handshake->xxdh_psa_type);\0A    psa_set_key_bits(&key_attributes, handshake->xxdh_psa_bits);\0A\0A    /* Generate ECDH/FFDH private key. */\0A    status = psa_generate_key(&key_attributes,\0A                              &handshake->xxdh_psa_privkey);\0A    if (status != PSA_SUCCESS) {\0A        ret = PSA_TO_MBEDTLS_ERR(status);\0A        MBEDTLS_SSL_DEBUG_RET(1, \22psa_generate_key\22, ret);\0A        return ret;\0A\0A    }\0A\0A    /* Export the public part of the ECDH/FFDH private key from PSA. */\0A    status = psa_export_public_key(handshake->xxdh_psa_privkey,\0A                                   buf, buf_size,\0A                                   &own_pubkey_len);\0A\0A    if (status != PSA_SUCCESS) {\0A        ret = PSA_TO_MBEDTLS_ERR(status);\0A        MBEDTLS_SSL_DEBUG_RET(1, \22psa_export_public_key\22, ret);\0A        return ret;\0A    }\0A\0A    *out_len = own_pubkey_len;\0A\0A    return 0;\0A}\0A#endif /* MBEDTLS_SSL_TLS1_3_KEY_EXCHANGE_MODE_SOME_EPHEMERAL_ENABLED */\0A\0A/* RFC 8446 section 4.2\0A *\0A * If an implementation receives an extension which it recognizes and which is\0A * not specified for the message in which it appears, it MUST abort the handshake\0A * with an \22illegal_parameter\22 alert.\0A *\0A */\0Aint mbedtls_ssl_tls13_check_received_extension(\0A    mbedtls_ssl_context *ssl,\0A    int hs_msg_type,\0A    unsigned int received_extension_type,\0A    uint32_t hs_msg_allowed_extensions_mask)\0A{\0A    uint32_t extension_mask = mbedtls_ssl_get_extension_mask(\0A        received_extension_type);\0A\0A    MBEDTLS_SSL_PRINT_EXT(\0A        3, hs_msg_type, received_extension_type, \22received\22);\0A\0A    if ((extension_mask & hs_msg_allowed_extensions_mask) == 0) {\0A        MBEDTLS_SSL_PRINT_EXT(\0A            3, hs_msg_type, received_extension_type, \22is illegal\22);\0A        MBEDTLS_SSL_PEND_FATAL_ALERT(\0A            MBEDTLS_SSL_ALERT_MSG_ILLEGAL_PARAMETER,\0A            MBEDTLS_ERR_SSL_ILLEGAL_PARAMETER);\0A        return MBEDTLS_ERR_SSL_ILLEGAL_PARAMETER;\0A    }\0A\0A    ssl->handshake->received_extensions |= extension_mask;\0A    /*\0A     * If it is a message containing extension responses, check that we\0A     * previously sent the extension.\0A     */\0A    switch (hs_msg_type) {\0A        case MBEDTLS_SSL_HS_SERVER_HELLO:\0A        case MBEDTLS_SSL_TLS1_3_HS_HELLO_RETRY_REQUEST:\0A        case MBEDTLS_SSL_HS_ENCRYPTED_EXTENSIONS:\0A        case MBEDTLS_SSL_HS_CERTIFICATE:\0A            /* Check if the received extension is sent by peer message.*/\0A            if ((ssl->handshake->sent_extensions & extension_mask) != 0) {\0A                return 0;\0A            }\0A            break;\0A        default:\0A            return 0;\0A    }\0A\0A    MBEDTLS_SSL_PRINT_EXT(\0A        3, hs_msg_type, received_extension_type, \22is unsupported\22);\0A    MBEDTLS_SSL_PEND_FATAL_ALERT(\0A        MBEDTLS_SSL_ALERT_MSG_UNSUPPORTED_EXT,\0A        MBEDTLS_ERR_SSL_UNSUPPORTED_EXTENSION);\0A    return MBEDTLS_ERR_SSL_UNSUPPORTED_EXTENSION;\0A}\0A\0A#if defined(MBEDTLS_SSL_RECORD_SIZE_LIMIT)\0A\0A/* RFC 8449, section 4:\0A *\0A * The ExtensionData of the \22record_size_limit\22 extension is\0A * RecordSizeLimit:\0A *     uint16 RecordSizeLimit;\0A */\0AMBEDTLS_CHECK_RETURN_CRITICAL\0Aint mbedtls_ssl_tls13_parse_record_size_limit_ext(mbedtls_ssl_context *ssl,\0A                                                  const unsigned char *buf,\0A                                                  const unsigned char *end)\0A{\0A    const unsigned char *p = buf;\0A    uint16_t record_size_limit;\0A    const size_t extension_data_len = end - buf;\0A\0A    if (extension_data_len !=\0A        MBEDTLS_SSL_RECORD_SIZE_LIMIT_EXTENSION_DATA_LENGTH) {\0A        MBEDTLS_SSL_DEBUG_MSG(2,\0A                              (\22record_size_limit extension has invalid length: %\22\0A                               MBEDTLS_PRINTF_SIZET \22 Bytes\22,\0A                               extension_data_len));\0A\0A        MBEDTLS_SSL_PEND_FATAL_ALERT(\0A            MBEDTLS_SSL_ALERT_MSG_ILLEGAL_PARAMETER,\0A            MBEDTLS_ERR_SSL_ILLEGAL_PARAMETER);\0A        return MBEDTLS_ERR_SSL_ILLEGAL_PARAMETER;\0A    }\0A\0A    MBEDTLS_SSL_CHK_BUF_READ_PTR(p, end, 2);\0A    record_size_limit = MBEDTLS_GET_UINT16_BE(p, 0);\0A\0A    MBEDTLS_SSL_DEBUG_MSG(2, (\22RecordSizeLimit: %u Bytes\22, record_size_limit));\0A\0A    /* RFC 8449, section 4:\0A     *\0A     * Endpoints MUST NOT send a \22record_size_limit\22 extension with a value\0A     * smaller than 64.  An endpoint MUST treat receipt of a smaller value\0A     * as a fatal error and generate an \22illegal_parameter\22 alert.\0A     */\0A    if (record_size_limit < MBEDTLS_SSL_RECORD_SIZE_LIMIT_MIN) {\0A        MBEDTLS_SSL_DEBUG_MSG(1, (\22Invalid record size limit : %u Bytes\22,\0A                                  record_size_limit));\0A        MBEDTLS_SSL_PEND_FATAL_ALERT(\0A            MBEDTLS_SSL_ALERT_MSG_ILLEGAL_PARAMETER,\0A            MBEDTLS_ERR_SSL_ILLEGAL_PARAMETER);\0A        return MBEDTLS_ERR_SSL_ILLEGAL_PARAMETER;\0A    }\0A\0A    ssl->session_negotiate->record_size_limit = record_size_limit;\0A\0A    return 0;\0A}\0A\0AMBEDTLS_CHECK_RETURN_CRITICAL\0Aint mbedtls_ssl_tls13_write_record_size_limit_ext(mbedtls_ssl_context *ssl,\0A                                                  unsigned char *buf,\0A                                                  const unsigned char *end,\0A                                                  size_t *out_len)\0A{\0A    unsigned char *p = buf;\0A    *out_len = 0;\0A\0A    MBEDTLS_STATIC_ASSERT(MBEDTLS_SSL_IN_CONTENT_LEN >= MBEDTLS_SSL_RECORD_SIZE_LIMIT_MIN,\0A                          \22MBEDTLS_SSL_IN_CONTENT_LEN is less than the \22\0A                          \22minimum record size limit\22);\0A\0A    MBEDTLS_SSL_CHK_BUF_PTR(p, end, 6);\0A\0A    MBEDTLS_PUT_UINT16_BE(MBEDTLS_TLS_EXT_RECORD_SIZE_LIMIT, p, 0);\0A    MBEDTLS_PUT_UINT16_BE(MBEDTLS_SSL_RECORD_SIZE_LIMIT_EXTENSION_DATA_LENGTH,\0A                          p, 2);\0A    MBEDTLS_PUT_UINT16_BE(MBEDTLS_SSL_IN_CONTENT_LEN, p, 4);\0A\0A    *out_len = 6;\0A\0A    MBEDTLS_SSL_DEBUG_MSG(2, (\22Sent RecordSizeLimit: %d Bytes\22,\0A                              MBEDTLS_SSL_IN_CONTENT_LEN));\0A\0A    mbedtls_ssl_tls13_set_hs_sent_ext_mask(ssl, MBEDTLS_TLS_EXT_RECORD_SIZE_LIMIT);\0A\0A    return 0;\0A}\0A\0A#endif /* MBEDTLS_SSL_RECORD_SIZE_LIMIT */\0A\0A#endif /* MBEDTLS_SSL_TLS_C && MBEDTLS_SSL_PROTO_TLS1_3 */\0A\00" }
