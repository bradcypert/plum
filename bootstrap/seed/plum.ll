@.str46942 = private global { i64, i64, [7019 x i8] } { i64 -1, i64 7018, [7019 x i8] c"/*\0A *  X.509 internal, common functions for writing\0A *\0A *  Copyright The Mbed TLS Contributors\0A *  SPDX-License-Identifier: Apache-2.0 OR GPL-2.0-or-later\0A */\0A#include \22common.h\22\0A#if defined(MBEDTLS_X509_CSR_WRITE_C) || defined(MBEDTLS_X509_CRT_WRITE_C)\0A\0A#include \22mbedtls/x509_crt.h\22\0A#include \22x509_internal.h\22\0A#include \22mbedtls/asn1write.h\22\0A#include \22mbedtls/error.h\22\0A#include \22mbedtls/oid.h\22\0A#include \22mbedtls/platform.h\22\0A#include \22mbedtls/platform_util.h\22\0A\0A#include <string.h>\0A#include <stdint.h>\0A\0A#if defined(MBEDTLS_PEM_WRITE_C)\0A#include \22mbedtls/pem.h\22\0A#endif /* MBEDTLS_PEM_WRITE_C */\0A\0A#if defined(MBEDTLS_USE_PSA_CRYPTO)\0A#include \22psa/crypto.h\22\0A#include \22mbedtls/psa_util.h\22\0A#include \22md_psa.h\22\0A#endif /* MBEDTLS_USE_PSA_CRYPTO */\0A\0A#define CHECK_OVERFLOW_ADD(a, b) \5C\0A    do                         \5C\0A    {                           \5C\0A        if (a > SIZE_MAX - (b)) \5C\0A        { \5C\0A            return MBEDTLS_ERR_X509_BAD_INPUT_DATA; \5C\0A        }                            \5C\0A        a += b; \5C\0A    } while (0)\0A\0Aint mbedtls_x509_write_set_san_common(mbedtls_asn1_named_data **extensions,\0A                                      const mbedtls_x509_san_list *san_list)\0A{\0A    int ret = 0;\0A    const mbedtls_x509_san_list *cur;\0A    unsigned char *buf;\0A    unsigned char *p;\0A    size_t len;\0A    size_t buflen = 0;\0A\0A    /* Determine the maximum size of the SubjectAltName list */\0A    for (cur = san_list; cur != NULL; cur = cur->next) {\0A        /* Calculate size of the required buffer */\0A        switch (cur->node.type) {\0A            case MBEDTLS_X509_SAN_DNS_NAME:\0A            case MBEDTLS_X509_SAN_UNIFORM_RESOURCE_IDENTIFIER:\0A            case MBEDTLS_X509_SAN_IP_ADDRESS:\0A            case MBEDTLS_X509_SAN_RFC822_NAME:\0A                /* length of value for each name entry,\0A                 * maximum 4 bytes for the length field,\0A                 * 1 byte for the tag/type.\0A                 */\0A                CHECK_OVERFLOW_ADD(buflen, cur->node.san.unstructured_name.len);\0A                CHECK_OVERFLOW_ADD(buflen, 4 + 1);\0A                break;\0A            case MBEDTLS_X509_SAN_DIRECTORY_NAME:\0A            {\0A                const mbedtls_asn1_named_data *chunk = &cur->node.san.directory_name;\0A                while (chunk != NULL) {\0A                    // Max 4 bytes for length, +1 for tag,\0A                    // additional 4 max for length, +1 for tag.\0A                    // See x509_write_name for more information.\0A                    CHECK_OVERFLOW_ADD(buflen, 4 + 1 + 4 + 1);\0A                    CHECK_OVERFLOW_ADD(buflen, chunk->oid.len);\0A                    CHECK_OVERFLOW_ADD(buflen, chunk->val.len);\0A                    chunk = chunk->next;\0A                }\0A                CHECK_OVERFLOW_ADD(buflen, 4 + 1);\0A                break;\0A            }\0A            default:\0A                /* Not supported - return. */\0A                return MBEDTLS_ERR_X509_FEATURE_UNAVAILABLE;\0A        }\0A    }\0A\0A    /* Add the extra length field and tag */\0A    CHECK_OVERFLOW_ADD(buflen, 4 + 1);\0A\0A    /* Allocate buffer */\0A    buf = mbedtls_calloc(1, buflen);\0A    if (buf == NULL) {\0A        return MBEDTLS_ERR_ASN1_ALLOC_FAILED;\0A    }\0A    p = buf + buflen;\0A\0A    /* Write ASN.1-based structure */\0A    cur = san_list;\0A    len = 0;\0A    while (cur != NULL) {\0A        size_t single_san_len = 0;\0A        switch (cur->node.type) {\0A            case MBEDTLS_X509_SAN_DNS_NAME:\0A            case MBEDTLS_X509_SAN_RFC822_NAME:\0A            case MBEDTLS_X509_SAN_UNIFORM_RESOURCE_IDENTIFIER:\0A            case MBEDTLS_X509_SAN_IP_ADDRESS:\0A            {\0A                const unsigned char *unstructured_name =\0A                    (const unsigned char *) cur->node.san.unstructured_name.p;\0A                size_t unstructured_name_len = cur->node.san.unstructured_name.len;\0A\0A                MBEDTLS_ASN1_CHK_CLEANUP_ADD(single_san_len,\0A                                             mbedtls_asn1_write_raw_buffer(\0A                                                 &p, buf,\0A                                                 unstructured_name, unstructured_name_len));\0A                MBEDTLS_ASN1_CHK_CLEANUP_ADD(single_san_len, mbedtls_asn1_write_len(\0A                                                 &p, buf, unstructured_name_len));\0A                MBEDTLS_ASN1_CHK_CLEANUP_ADD(single_san_len,\0A                                             mbedtls_asn1_write_tag(\0A                                                 &p, buf,\0A                                                 MBEDTLS_ASN1_CONTEXT_SPECIFIC | cur->node.type));\0A            }\0A            break;\0A            case MBEDTLS_X509_SAN_DIRECTORY_NAME:\0A                MBEDTLS_ASN1_CHK_CLEANUP_ADD(single_san_len,\0A                                             mbedtls_x509_write_names(&p, buf,\0A                                                                      (mbedtls_asn1_named_data *) &\0A                                                                      cur->node\0A                                                                      .san.directory_name));\0A                MBEDTLS_ASN1_CHK_CLEANUP_ADD(single_san_len,\0A                                             mbedtls_asn1_write_len(&p, buf, single_san_len));\0A                MBEDTLS_ASN1_CHK_CLEANUP_ADD(single_san_len,\0A                                             mbedtls_asn1_write_tag(&p, buf,\0A                                                                    MBEDTLS_ASN1_CONTEXT_SPECIFIC |\0A                                                                    MBEDTLS_ASN1_CONSTRUCTED |\0A                                                                    MBEDTLS_X509_SAN_DIRECTORY_NAME));\0A                break;\0A            default:\0A                /* Error out on an unsupported SAN */\0A                ret = MBEDTLS_ERR_X509_FEATURE_UNAVAILABLE;\0A                goto cleanup;\0A        }\0A        cur = cur->next;\0A        /* check for overflow */\0A        if (len > SIZE_MAX - single_san_len) {\0A            ret = MBEDTLS_ERR_X509_BAD_INPUT_DATA;\0A            goto cleanup;\0A        }\0A        len += single_san_len;\0A    }\0A\0A    MBEDTLS_ASN1_CHK_CLEANUP_ADD(len, mbedtls_asn1_write_len(&p, buf, len));\0A    MBEDTLS_ASN1_CHK_CLEANUP_ADD(len,\0A                                 mbedtls_asn1_write_tag(&p, buf,\0A                                                        MBEDTLS_ASN1_CONSTRUCTED |\0A                                                        MBEDTLS_ASN1_SEQUENCE));\0A\0A    ret = mbedtls_x509_set_extension(extensions,\0A                                     MBEDTLS_OID_SUBJECT_ALT_NAME,\0A                                     MBEDTLS_OID_SIZE(MBEDTLS_OID_SUBJECT_ALT_NAME),\0A                                     0,\0A                                     buf + buflen - len, len);\0A\0A    /* If we exceeded the allocated buffer it means that maximum size of the SubjectAltName list\0A     * was incorrectly calculated and memory is corrupted. */\0A    if (p < buf) {\0A        ret = MBEDTLS_ERR_ASN1_LENGTH_MISMATCH;\0A    }\0Acleanup:\0A    mbedtls_free(buf);\0A    return ret;\0A}\0A\0A#endif /* MBEDTLS_X509_CSR_WRITE_C || MBEDTLS_X509_CRT_WRITE_C */\0A\00" }
