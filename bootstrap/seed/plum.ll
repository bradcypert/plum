@.str46365 = private global { i64, i64, [26 x i8] } { i64 -1, i64 25, [26 x i8] c"mbedtls/library/entropy.c\00" }
@.str46367 = private global { i64, i64, [18138 x i8] } { i64 -1, i64 18137, [18138 x i8] c"/*\0A *  Entropy accumulator implementation\0A *\0A *  Copyright The Mbed TLS Contributors\0A *  SPDX-License-Identifier: Apache-2.0 OR GPL-2.0-or-later\0A */\0A\0A#include \22common.h\22\0A\0A#if defined(MBEDTLS_ENTROPY_C)\0A\0A#include \22mbedtls/entropy.h\22\0A#include \22entropy_poll.h\22\0A#include \22mbedtls/platform_util.h\22\0A#include \22mbedtls/error.h\22\0A\0A#include <string.h>\0A\0A#if defined(MBEDTLS_FS_IO)\0A#include <stdio.h>\0A#endif\0A\0A#include \22mbedtls/platform.h\22\0A\0A#define ENTROPY_MAX_LOOP    256     /**< Maximum amount to loop before error */\0A\0Avoid mbedtls_entropy_init(mbedtls_entropy_context *ctx)\0A{\0A    ctx->source_count = 0;\0A    memset(ctx->source, 0, sizeof(ctx->source));\0A\0A#if defined(MBEDTLS_THREADING_C)\0A    mbedtls_mutex_init(&ctx->mutex);\0A#endif\0A\0A    ctx->accumulator_started = 0;\0A    mbedtls_md_init(&ctx->accumulator);\0A\0A    /* Reminder: Update ENTROPY_HAVE_STRONG in the test files\0A     *           when adding more strong entropy sources here. */\0A\0A#if !defined(MBEDTLS_NO_DEFAULT_ENTROPY_SOURCES)\0A#if !defined(MBEDTLS_NO_PLATFORM_ENTROPY)\0A    mbedtls_entropy_add_source(ctx, mbedtls_platform_entropy_poll, NULL,\0A                               MBEDTLS_ENTROPY_MIN_PLATFORM,\0A                               MBEDTLS_ENTROPY_SOURCE_STRONG);\0A#endif\0A#if defined(MBEDTLS_ENTROPY_HARDWARE_ALT)\0A    mbedtls_entropy_add_source(ctx, mbedtls_hardware_poll, NULL,\0A                               MBEDTLS_ENTROPY_MIN_HARDWARE,\0A                               MBEDTLS_ENTROPY_SOURCE_STRONG);\0A#endif\0A#if defined(MBEDTLS_ENTROPY_NV_SEED)\0A    mbedtls_entropy_add_source(ctx, mbedtls_nv_seed_poll, NULL,\0A                               MBEDTLS_ENTROPY_BLOCK_SIZE,\0A                               MBEDTLS_ENTROPY_SOURCE_STRONG);\0A    ctx->initial_entropy_run = 0;\0A#endif\0A#endif /* MBEDTLS_NO_DEFAULT_ENTROPY_SOURCES */\0A}\0A\0Avoid mbedtls_entropy_free(mbedtls_entropy_context *ctx)\0A{\0A    if (ctx == NULL) {\0A        return;\0A    }\0A\0A    /* If the context was already free, don't call free() again.\0A     * This is important for mutexes which don't allow double-free. */\0A    if (ctx->accumulator_started == -1) {\0A        return;\0A    }\0A\0A#if defined(MBEDTLS_THREADING_C)\0A    mbedtls_mutex_free(&ctx->mutex);\0A#endif\0A    mbedtls_md_free(&ctx->accumulator);\0A#if defined(MBEDTLS_ENTROPY_NV_SEED)\0A    ctx->initial_entropy_run = 0;\0A#endif\0A    ctx->source_count = 0;\0A    mbedtls_platform_zeroize(ctx->source, sizeof(ctx->source));\0A    ctx->accumulator_started = -1;\0A}\0A\0Aint mbedtls_entropy_add_source(mbedtls_entropy_context *ctx,\0A                               mbedtls_entropy_f_source_ptr f_source, void *p_source,\0A                               size_t threshold, int strong)\0A{\0A    int idx, ret = 0;\0A\0A#if defined(MBEDTLS_THREADING_C)\0A    if ((ret = mbedtls_mutex_lock(&ctx->mutex)) != 0) {\0A        return ret;\0A    }\0A#endif\0A\0A    idx = ctx->source_count;\0A    if (idx >= MBEDTLS_ENTROPY_MAX_SOURCES) {\0A        ret = MBEDTLS_ERR_ENTROPY_MAX_SOURCES;\0A        goto exit;\0A    }\0A\0A    ctx->source[idx].f_source  = f_source;\0A    ctx->source[idx].p_source  = p_source;\0A    ctx->source[idx].threshold = threshold;\0A    ctx->source[idx].strong    = strong;\0A\0A    ctx->source_count++;\0A\0Aexit:\0A#if defined(MBEDTLS_THREADING_C)\0A    if (mbedtls_mutex_unlock(&ctx->mutex) != 0) {\0A        return MBEDTLS_ERR_THREADING_MUTEX_ERROR;\0A    }\0A#endif\0A\0A    return ret;\0A}\0A\0A/*\0A * Entropy accumulator update\0A */\0Astatic int entropy_update(mbedtls_entropy_context *ctx, unsigned char source_id,\0A                          const unsigned char *data, size_t len)\0A{\0A    unsigned char header[2];\0A    unsigned char tmp[MBEDTLS_ENTROPY_BLOCK_SIZE];\0A    size_t use_len = len;\0A    const unsigned char *p = data;\0A    int ret = 0;\0A\0A    if (use_len > MBEDTLS_ENTROPY_BLOCK_SIZE) {\0A        if ((ret = mbedtls_md(mbedtls_md_info_from_type(MBEDTLS_ENTROPY_MD),\0A                              data, len, tmp)) != 0) {\0A            goto cleanup;\0A        }\0A        p = tmp;\0A        use_len = MBEDTLS_ENTROPY_BLOCK_SIZE;\0A    }\0A\0A    header[0] = source_id;\0A    header[1] = use_len & 0xFF;\0A\0A    /*\0A     * Start the accumulator if this has not already happened. Note that\0A     * it is sufficient to start the accumulator here only because all calls to\0A     * gather entropy eventually execute this code.\0A     */\0A    if (ctx->accumulator_started == 0) {\0A        ret = mbedtls_md_setup(&ctx->accumulator,\0A                               mbedtls_md_info_from_type(MBEDTLS_ENTROPY_MD), 0);\0A        if (ret != 0) {\0A            goto cleanup;\0A        }\0A        ret = mbedtls_md_starts(&ctx->accumulator);\0A        if (ret != 0) {\0A            goto cleanup;\0A        }\0A        ctx->accumulator_started = 1;\0A    }\0A    if ((ret = mbedtls_md_update(&ctx->accumulator, header, 2)) != 0) {\0A        goto cleanup;\0A    }\0A    ret = mbedtls_md_update(&ctx->accumulator, p, use_len);\0A\0Acleanup:\0A    mbedtls_platform_zeroize(tmp, sizeof(tmp));\0A\0A    return ret;\0A}\0A\0Aint mbedtls_entropy_update_manual(mbedtls_entropy_context *ctx,\0A                                  const unsigned char *data, size_t len)\0A{\0A    int ret = MBEDTLS_ERR_ERROR_CORRUPTION_DETECTED;\0A\0A#if defined(MBEDTLS_THREADING_C)\0A    if ((ret = mbedtls_mutex_lock(&ctx->mutex)) != 0) {\0A        return ret;\0A    }\0A#endif\0A\0A    ret = entropy_update(ctx, MBEDTLS_ENTROPY_SOURCE_MANUAL, data, len);\0A\0A#if defined(MBEDTLS_THREADING_C)\0A    if (mbedtls_mutex_unlock(&ctx->mutex) != 0) {\0A        return MBEDTLS_ERR_THREADING_MUTEX_ERROR;\0A    }\0A#endif\0A\0A    return ret;\0A}\0A\0A/*\0A * Run through the different sources to add entropy to our accumulator\0A */\0Astatic int entropy_gather_internal(mbedtls_e