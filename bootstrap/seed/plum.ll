@.str46642 = private global { i64, i64, [5377 x i8] } { i64 -1, i64 5376, [5377 x i8] c"/*\0A *  PSA FFDH layer on top of Mbed TLS crypto\0A */\0A/*\0A *  Copyright The Mbed TLS Contributors\0A *  SPDX-License-Identifier: Apache-2.0 OR GPL-2.0-or-later\0A */\0A\0A#ifndef PSA_CRYPTO_FFDH_H\0A#define PSA_CRYPTO_FFDH_H\0A\0A#include <psa/crypto.h>\0A\0A/** Perform a key agreement and return the FFDH shared secret.\0A *\0A * \5Cparam[in]  attributes           The attributes of the key to use for the\0A *                                  operation.\0A * \5Cparam[in]  peer_key             The buffer containing the key context\0A *                                  of the peer's public key.\0A * \5Cparam[in]  peer_key_length      Size of the \5Cp peer_key buffer in\0A *                                  bytes.\0A * \5Cparam[in]  key_buffer           The buffer containing the private key\0A *                                  context.\0A * \5Cparam[in]  key_buffer_size      Size of the \5Cp key_buffer buffer in\0A *                                  bytes.\0A * \5Cparam[out] shared_secret        The buffer to which the shared secret\0A *                                  is to be written.\0A * \5Cparam[in]  shared_secret_size   Size of the \5Cp shared_secret buffer in\0A *                                  bytes.\0A * \5Cparam[out] shared_secret_length On success, the number of bytes that make\0A *                                  up the returned shared secret.\0A * \5Cretval #PSA_SUCCESS\0A *         Success. Shared secret successfully calculated.\0A * \5Cretval #PSA_ERROR_INVALID_ARGUMENT\0A *         \5Cp key_buffer_size, \5Cp peer_key_length, \5Cp shared_secret_size\0A *         do not match\0A * \5Cretval #PSA_ERROR_INSUFFICIENT_MEMORY   \5Cemptydescription\0A * \5Cretval #PSA_ERROR_CORRUPTION_DETECTED   \5Cemptydescription\0A */\0Apsa_status_t mbedtls_psa_ffdh_key_agreement(\0A    const psa_key_attributes_t *attributes,\0A    const uint8_t *peer_key,\0A    size_t peer_key_length,\0A    const uint8_t *key_buffer,\0A    size_t key_buffer_size,\0A    uint8_t *shared_secret,\0A    size_t shared_secret_size,\0A    size_t *shared_secret_length);\0A\0A/** Export a public key or the public part of a DH key pair in binary format.\0A *\0A * \5Cparam[in]  attributes       The attributes for the key to export.\0A * \5Cparam[in]  key_buffer       Material or context of the key to export.\0A * \5Cparam[in]  key_buffer_size  Size of the \5Cp key_buffer buffer in bytes.\0A * \5Cparam[out] data             Buffer where the key data is to be written.\0A * \5Cparam[in]  data_size        Size of the \5Cp data buffer in bytes.\0A * \5Cparam[out] data_length      On success, the number of bytes written in\0A *                              \5Cp data\0A *\0A * \5Cretval #PSA_SUCCESS  The public key was exported successfully.\0A * \5Cretval #PSA_ERROR_BUFFER_TOO_SMALL\0A *         The size of \5Cp key_buffer is too small.\0A * \5Cretval #PSA_ERROR_NOT_PERMITTED         \5Cemptydescription\0A * \5Cretval #PSA_ERROR_INSUFFICIENT_MEMORY   \5Cemptydescription\0A * \5Cretval #PSA_ERROR_CORRUPTION_DETECTED   \5Cemptydescription\0A */\0Apsa_status_t mbedtls_psa_ffdh_export_public_key(\0A    const psa_key_attributes_t *attributes,\0A    const uint8_t *key_buffer,\0A    size_t key_buffer_size,\0A    uint8_t *data,\0A    size_t data_size,\0A    size_t *data_length);\0A\0A/**\0A * \5Cbrief Generate DH key.\0A *\0A * \5Cnote The signature of the function is that of a PSA driver generate_key\0A *       entry point.\0A *\0A * \5Cparam[in]  attributes         The attributes for the key to generate.\0A * \5Cparam[out] key_buffer         Buffer where the key data is to be written.\0A * \5Cparam[in]  key_buffer_size    Size of \5Cp key_buffer in bytes.\0A * \5Cparam[out] key_buffer_length  On success, the number of bytes written in\0A *                                \5Cp key_buffer.\0A *\0A * \5Cretval #PSA_SUCCESS\0A *         The key was generated successfully.\0A * \5Cretval #PSA_ERROR_NOT_SUPPORTED\0A *         Key size in bits is invalid.\0A * \5Cretval #PSA_ERROR_BUFFER_TOO_SMALL\0A *         The size of \5Cp key_buffer is too small.\0A * \5Cretval #PSA_ERROR_INSUFFICIENT_MEMORY   \5Cemptydescription\0A * \5Cretval #PSA_ERROR_CORRUPTION_DETECTED   \5Cemptydescription\0A */\0Apsa_status_t mbedtls_psa_ffdh_generate_key(\0A    const psa_key_attributes_t *attributes,\0A    uint8_t *key_buffer,\0A    size_t key_buffer_size,\0A    size_t *key_buffer_length);\0A\0A/**\0A * \5Cbrief Import DH key.\0A *\0A * \5Cnote The signature of the function is that of a PSA driver import_key\0A *       entry point.\0A *\0A * \5Cparam[in]  attributes       The attributes for the key to import.\0A * \5Cparam[in]  data             The buffer containing the key data in import\0A *                              format.\0A * \5Cparam[in]  data_length      Size of the \5Cp data buffer in bytes.\0A * \5Cparam[out] key_buffer       The buffer containing the key data in output\0A *                              format.\0A * \5Cparam[in]  key_buffer_size  Size of the \5Cp key_buffer buffer in bytes. This\0A *                              size is greater or equal to \5Cp data_length.\0A * \5Cparam[out] key_buffer_length  The length of the data written in \5Cp\0A *                                key_buffer in bytes.\0A * \5Cparam[out] bits             The key size in number of bits.\0A *\0A * \5Cretval #PSA_SUCCESS\0A *         The key was generated successfully.\0A * \5Cretval #PSA_ERROR_BUFFER_TOO_SMALL\0A *         The size of \5Cp key_buffer is too small.\0A */\0Apsa_status_t mbedtls_psa_ffdh_import_key(\0A    const psa_key_attributes_t *attributes,\0A    const uint8_t *data, size_t data_length,\0A    uint8_t *key_buffer, size_t key_buffer_size,\0A    size_t *key_buffer_length, size_t *bits);\0A\0A#endif /* PSA_CRYPTO_FFDH_H */\0A\00" }
