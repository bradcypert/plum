uckets[idx].push(entry));\0A        }\0A    };\0A    Map { buckets: new_buckets, size: m.size }\0A}\0A\0A/// A NEW map with `k` set to `v`, replacing any previous value. The\0A/// original is unchanged.\0Apub let Map.insert[K: Eq + Hash, V] (m: Map[K, V]) (k: K) (v: V): Map[K, V] = {\0A    let idx = map_bucket_index(k, m.buckets.len());\0A    let bucket = m.buckets[idx];\0A    let existing_i = map_bucket_find_index(bucket, k, 0);\0A    let inserted = if existing_i >= 0 {\0A        Map { buckets: m.buckets.set(idx, bucket.set(existing_i, MapEntry { key: k, value: v })), size: m.size }\0A    } else {\0A        Map { buckets: m.buckets.set(idx, bucket.push(MapEntry { key: k, value: v })), size: m.size + 1 }\0A    };\0A    if inserted.size * MAP_LOAD_FACTOR_DEN > inserted.buckets.len() * MAP_LOAD_FACTOR_NUM {\0A        map_rehash(inserted, inserted.buckets.len() * 2)\0A    } else {\0A        inserted\0A    }\0A}\0A\0A/// The value for `k`, or `None`.\0Apub let Map.get[K: Eq + Hash, V] (m: Map[K, V]) (k: K): Option[V] = {\0A    let bucket = m.buckets[map_bucket_index(k, m.buckets.len())];\0A    let i = map_bucket_find_index(bucket, k, 0);\0A    if i >= 0 { Some(bucket[i].value) } else { None }\0A}\0A\0A/// Whether `k` has a value.\0Apub let Map.contains[K: Eq + Hash, V] (m: Map[K, V]) (k: K): Bool =\0A    map_bucket_find_index(m.buckets[map_bucket_index(k, m.buckets.len())], k, 0) >= 0\0A\0A/// A new map without `k`. Removing an absent key is not an error.\0Apub let Map.remove[K: Eq + Hash, V] (m: Map[K, V]) (k: K): Map[K, V] = {\0A    let idx = map_bucket_index(k, m.buckets.len());\0A    let bucket = m.buckets[idx];\0A    let i = map_bucket_find_index(bucket, k, 0);\0A    if i >= 0 { Map { buckets: m.buckets.set(idx, bucket.remove(i)), size: m.size - 1 } } else { m }\0A}\0A\0A/// How many entries.\0Apub let Map.len[K, V] (m: Map[K, V]): Int = m.size\0A\0A/// Every key, in no particular order — buckets, not insertion order.\0Apub let Map.keys[K, V] (m: Map[K, V]): Array[K] = {\0A    let mut acc = [];\0A    for bucket in m.buckets { for entry in bucket { acc = acc.push(entry.key); } };\0A    acc\0A}\0A\0A/// Every value, in the same order as `Map.keys`.\0Apub let Map.values[K, V] (m: Map[K, V]): Array[V] = {\0A    let mut acc = [];\0A    for bucket in m.buckets { for entry in bucket { acc = acc.push(entry.value); } };\0A    acc\0A}\0A\0Alet map_from_arrays_acc[K: Eq + Hash, V] (keys: Array[K]) (values: Array[V]) (i: Int) (acc: Map[K, V]): Map[K, V] =\0A    if i >= keys.len() { acc } else { map_from_arrays_acc(keys, values, i + 1, Map.insert(acc, keys[i], values[i])) }\0A/// A map from parallel arrays, stopping at the shorter. A repeated\0A/// key keeps the LAST value.\0Apub let Map.from_arrays[K: Eq + Hash, V] (keys: Array[K]) (values: Array[V]): Map[K, V] = map_from_arrays_acc(keys, values, 0, Map.new(()))\0A\0A/// A set of `T`, persistent like `Map` — `Set.insert` returns a new\0A/// set. Members need `Eq` and `Hash`. Equal keys hash identically.\0A/// NaN is not a supported key, including inside aggregates, because\0A/// IEEE equality makes it unequal to itself. References use identity.\0Apub struct Set[T] { inner: Map[T, Unit] }\0A\0A/// An empty set.\0Apub let Set.new[T] (): Set[T] = Set { inner: Map.new(()) }\0A/// A new set with `x` added. Adding a member twice changes nothing.\0Apub let Set.insert[T: Eq + Hash] (s: Set[T]) (x: T): Set[T] = Set { inner: Map.insert(s.inner, x, ()) }\0A/// Whether `x` is a member.\0Apub let Set.contains[T: Eq + Hash] (s: Set[T]) (x: T): Bool = Map.contains(s.inner, x)\0A/// A new set without `x`.\0Apub let Set.remove[T: Eq + Hash] (s: Set[T]) (x: T): Set[T] = Set { inner: Map.remove(s.inner, x) }\0A/// How many members.\0Apub let Set.len[T] (s: Set[T]): Int = Map.len(s.inner)\0A/// Every member, in no particular order.\0Apub let Set.to_array[T] (s: Set[T]): Array[T] = Map.keys(s.inner)\0A\0A/// Everything in either set.\0Apub let Set.union[T: Eq + Hash] (a: Set[T]) (b: Set[T]): Set[T] = {\0A    let mut result = b;\0A    for x in Set.to_array(a) { result = Set.insert(result, x); };\0A    result\0A}\0A\0A/// Only what is in both.\0Apub let Set.intersection[T: Eq + Hash] (a: Set[T]) (b: Set[T]): Set[T] = {\0A    let mut result = Set.new(());\0A    for x in Set.to_array(a) { if Set.contains(b, x) { result = Set.insert(result, x); } };\0A    result\0A}\0A\0A/// What is in `a` and not in `b`.\0Apub let Set.difference[T: Eq + Hash] (a: Set[T]) (b: Set[T]): Set[T] = {\0A    let mut result = Set.new(());\0A    for x in Set.to_array(a) { if !Set.contains(b, x) { result = Set.insert(result, x); } };\0A    result\0A}\0A\0Alet set_from_array_acc[T: Eq + Hash] (arr: Array[T]) (i: Int) (acc: Set[T]): Set[T] =\0A    if i >= arr.len() { acc } else { set_from_array_acc(arr, i + 1, Set.insert(acc, arr[i])) }\0A/// A set of the array's elements, discarding duplicates.\0Apub let Set.from_array[T: Eq + Hash] (arr: Array[T]): Set[T] = set_from_array_acc(arr, 0, Set.new(()))\0A\0A// --- JSON ---\0A\0A/// Mirrored from `crates/plumc/src/lib.rs`'s STDLIB_JSON_SRC, minus its\0A/// own `chars_of` (the runtime already provides that one, since it is the\0A/// single thing this prelude cannot write in Plum). Everything else is\0A/// character-for-character the real compiler's, so the two agree on\0A/// number formatting, escape handling and parse errors by construction\0A/// rather than by inspection.\0Apub struct JsonEntry { pub key: String, pub value: JsonValue }\0A/// A parsed JSON document.\0A///\0A/// Numbers are binary64 `Float`s and may lose precision when parsed.\0A/// `use Json;` brings in decoders that turn one of these into your own\0A/// types; `Json.int` rejects values outside the safe integer range.\0Apub enum JsonValue {\0A    JsonNull,\0A    JsonBool(Bool),\0A    JsonNumber(Float),\0A    JsonString(String),\0A    JsonArray(Array[JsonValue]),\0A    JsonObject(Array[JsonEntry]),\0A}\0A/// What a JSON parse step consumed: a value, and where to carry on\0A/// from. Public b