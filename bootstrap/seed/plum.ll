ld = NULL;\0A    int count = 0;\0A    mbedtls_ssl_cache_entry *cur, *last;\0A\0A    /* Check 1: Is there already an entry with the given session ID?\0A     *\0A     * If yes, overwrite it.\0A     *\0A     * If not, `count` will hold the size of the session cache\0A     * at the end of this loop, and `last` will point to the last\0A     * entry, both of which will be used later. */\0A\0A    last = NULL;\0A    for (cur = cache->chain; cur != NULL; cur = cur->next) {\0A        count++;\0A        if (session_id_len == cur->session_id_len &&\0A            memcmp(session_id, cur->session_id, cur->session_id_len) == 0) {\0A            goto found;\0A        }\0A        last = cur;\0A    }\0A\0A    /* Check 2: Is there an outdated entry in the cache?\0A     *\0A     * If so, overwrite it.\0A     *\0A     * If not, remember the oldest entry in `old` for later.\0A     */\0A\0A#if defined(MBEDTLS_HAVE_TIME)\0A    for (cur = cache->chain; cur != NULL; cur = cur->next) {\0A        if (cache->timeout != 0 &&\0A            (int) (t - cur->timestamp) > cache->timeout) {\0A            goto found;\0A        }\0A\0A        if (oldest == 0 || cur->timestamp < oldest) {\0A            oldest = cur->timestamp;\0A            old = cur;\0A        }\0A    }\0A#endif /* MBEDTLS_HAVE_TIME */\0A\0A    /* Check 3: Is there free space in the cache? */\0A\0A    if (count < cache->max_entries) {\0A        /* Create new entry */\0A        cur = mbedtls_calloc(1, sizeof(mbedtls_ssl_cache_entry));\0A        if (cur == NULL) {\0A            return MBEDTLS_ERR_SSL_ALLOC_FAILED;\0A        }\0A\0A        /* Append to the end of the linked list. */\0A        if (last == NULL) {\0A            cache->chain = cur;\0A        } else {\0A            last->next = cur;\0A        }\0A\0A        goto found;\0A    }\0A\0A    /* Last resort: The cache is full and doesn't contain any outdated\0A     * elements. In this case, we evict the oldest one, judged by timestamp\0A     * (if present) or cache-order. */\0A\0A#if defined(MBEDTLS_HAVE_TIME)\0A    if (old == NULL) {\0A        /* This should only happen on an ill-configured cache\0A         * with max_entries == 0. */\0A        return MBEDTLS_ERR_SSL_INTERNAL_ERROR;\0A    }\0A#else /* MBEDTLS_HAVE_TIME */\0A    /* Reuse first entry in chain, but move to last place. */\0A    if (cache->chain == NULL) {\0A        /* This should never happen */\0A        return MBEDTLS_ERR_ERROR_CORRUPTION_DETECTED;\0A    }\0A\0A    old = cache->chain;\0A    cache->chain = old->next;\0A    old->next = NULL;\0A    last->next = old;\0A#endif /* MBEDTLS_HAVE_TIME */\0A\0A    /* Now `old` points to the oldest entry to be overwritten. */\0A    cur = old;\0A\0Afound:\0A\0A    /* If we're reusing an entry, free it first. */\0A    if (cur->session != NULL) {\0A        /* `ssl_cache_entry_zeroize` would break the chain,\0A         * so we reuse `old` to record `next` temporarily. */\0A        old = cur->next;\0A        ssl_cache_entry_zeroize(cur);\0A        cur->next = old;\0A    }\0A\0A#if defined(MBEDTLS_HAVE_TIME)\0A    cur->timestamp = t;\0A#endif\0A\0A    *dst = cur;\0A    return 0;\0A}\0A\0Aint mbedtls_ssl_cache_set(void *data,\0A                          unsigned char const *session_id,\0A                          size_t session_id_len,\0A                          const mbedtls_ssl_session *session)\0A{\0A    int ret = MBEDTLS_ERR_ERROR_CORRUPTION_DETECTED;\0A    mbedtls_ssl_cache_context *cache = (mbedtls_ssl_cache_context *) data;\0A    mbedtls_ssl_cache_entry *cur;\0A\0A    size_t session_serialized_len = 0;\0A    unsigned char *session_serialized = NULL;\0A\0A#if defined(MBEDTLS_THREADING_C)\0A    if ((ret = mbedtls_mutex_lock(&cache->mutex)) != 0) {\0A        return ret;\0A    }\0A#endif\0A\0A    ret = ssl_cache_pick_writing_slot(cache,\0A                                      session_id, session_id_len,\0A                                      &cur);\0A    if (ret != 0) {\0A        goto exit;\0A    }\0A\0A    /* Check how much space we need to serialize the session\0A     * and allocate a sufficiently large buffer. */\0A    ret = mbedtls_ssl_session_save(session, NULL, 0, &session_serialized_len);\0A    if (ret != MBEDTLS_ERR_SSL_BUFFER_TOO_SMALL) {\0A        goto exit;\0A    }\0A\0A    session_serialized = mbedtls_calloc(1, session_serialized_len);\0A    if (session_serialized == NULL) {\0A        ret = MBEDTLS_ERR_SSL_ALLOC_FAILED;\0A        goto exit;\0A    }\0A\0A    /* Now serialize the session into the allocated buffer. */\0A    ret = mbedtls_ssl_session_save(session,\0A                                   session_serialized,\0A                                   session_serialized_len,\0A                                   &session_serialized_len);\0A    if (ret != 0) {\0A        goto exit;\0A    }\0A\0A    if (session_id_len > sizeof(cur->session_id)) {\0A        ret = MBEDTLS_ERR_SSL_BAD_INPUT_DATA;\0A        goto exit;\0A    }\0A    cur->session_id_len = session_id_len;\0A    memcpy(cur->session_id, session_id, session_id_len);\0A\0A    cur->session = session_serialized;\0A    cur->session_len = session_serialized_len;\0A    session_serialized = NULL;\0A\0A    ret = 0;\0A\0Aexit:\0A#if defined(MBEDTLS_THREADING_C)\0A    if (mbedtls_mutex_unlock(&cache->mutex) != 0) {\0A        ret = MBEDTLS_ERR_THREADING_MUTEX_ERROR;\0A    }\0A#endif\0A\0A    if (session_serialized != NULL) {\0A        mbedtls_zeroize_and_free(session_serialized, session_serialized_len);\0A        session_serialized = NULL;\0A    }\0A\0A    return ret;\0A}\0A\0Aint mbedtls_ssl_cache_remove(void *data,\0A                             unsigned char const *session_id,\0A                             size_t session_id_len)\0A{\0A    int ret = MBEDTLS_ERR_ERROR_CORRUPTION_DETECTED;\0A    mbedtls_ssl_cache_context *cache = (mbedtls_ssl_cache_context *) data;\0A    mbedtls_ssl_cache_entry *entry;\0A    mbedtls_ssl_cache_entry *prev;\0A\0A#if defined(MBEDTLS_THREADING_C)\0A    if ((ret = mbedtls_mutex_lock(&cache->mutex)) != 0) {\0A        return ret;\0A    }\0A#endif\0A\0A    ret = ssl_cache_find_entry(cache, session_id, session_id_len, &entry);\0A    /* No valid entry found, exit with success */\0A    if (ret != 0) {\0A        ret = 0;\0A        goto exit;\0A    }\0A\0A    /* Now we remove the entry from the chain */\0A    if (entry == cache->chain) {\0A        cache->chain = entry->next;\0A        goto free;\0A    }\0A    for (prev = cache->chain; prev->next != NULL; prev = prev->next) {\0A        if (prev->next == entry) {\0A            prev->next = entry->next;\0A            break;\0A        }\0A    }\0A\0Afree:\0A    ssl_cache_entry_zeroize(entry);\0A    mbedtls_free(entry);\0A    ret = 0;\0A\0Aexit:\0A#if defined(MBEDTLS_THREADING_C)\0A    if (mbedtls_mutex_unlock(&cache->mutex) != 0) {\0A        ret = MBEDTLS_ERR_THREADING_MUTEX_ERROR;\0A    }\0A#endif\0A\0A    return ret;\0A}\0A\0A#if defined(MBEDTLS_HAVE_TIME)\0Avoid mbedtls_ssl_cache_set_timeout(mbedtls_ssl_cache_context *cache, int timeout)\0A{\0A    if (timeout < 0) {\0A        timeout = 0;\0A    }\0A\0A    cache->timeout = timeout;\0A}\0A#endif /* MBEDTLS_HAVE_TIME */\0A\0Avoid mbedtls_ssl_cache_set_max_entries(mbedtls_ssl_cache_context *cache, int max)\0A{\0A    if (max < 0) {\0A        max = 0;\0A    }\0A\0A    cache->max_entries = max;\0A}\0A\0Avoid mbedtls_ssl_cache_free(mbedtls_ssl_cache_context *cache)\0A{\0A    mbedtls_ssl_cache_entry *cur, *prv;\0A\0A    cur = cache->chain;\0A\0A    while (cur != NULL) {\0A        prv = cur;\0A        cur = cur->next;\0A\0A        ssl_cache_entry_zeroize(prv);\0A        mbedtls_free(prv);\0A    }\0A\0A#if defined(MBEDTLS_THREADING_C)\0A    mbedtls_mutex_free(&cache->mutex);\0A#endif\0A    cache->chain = NULL;\0A}\0A\0A#endif /* MBEDTLS_SSL_CACHE_C */\0A\00" }
