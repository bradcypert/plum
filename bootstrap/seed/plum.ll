@.str44982 = private global { i64, i64, [1882 x i8] } { i64 -1, i64 1881, [1882 x i8] c"/**\0A * \5Cfile block_cipher.h\0A *\0A * \5Cbrief Internal abstraction layer.\0A */\0A/*\0A *  Copyright The Mbed TLS Contributors\0A *  SPDX-License-Identifier: Apache-2.0 OR GPL-2.0-or-later\0A */\0A#ifndef MBEDTLS_BLOCK_CIPHER_H\0A#define MBEDTLS_BLOCK_CIPHER_H\0A\0A#include \22mbedtls/private_access.h\22\0A\0A#include \22mbedtls/build_info.h\22\0A\0A#if defined(MBEDTLS_AES_C)\0A#include \22mbedtls/aes.h\22\0A#endif\0A#if defined(MBEDTLS_ARIA_C)\0A#include \22mbedtls/aria.h\22\0A#endif\0A#if defined(MBEDTLS_CAMELLIA_C)\0A#include \22mbedtls/camellia.h\22\0A#endif\0A\0A#if defined(MBEDTLS_BLOCK_CIPHER_SOME_PSA)\0A#include \22psa/crypto_types.h\22\0A#endif\0A\0A#ifdef __cplusplus\0Aextern \22C\22 {\0A#endif\0A\0Atypedef enum {\0A    MBEDTLS_BLOCK_CIPHER_ID_NONE = 0,  /**< Unset. */\0A    MBEDTLS_BLOCK_CIPHER_ID_AES,       /**< The AES cipher. */\0A    MBEDTLS_BLOCK_CIPHER_ID_CAMELLIA,  /**< The Camellia cipher. */\0A    MBEDTLS_BLOCK_CIPHER_ID_ARIA,      /**< The Aria cipher. */\0A} mbedtls_block_cipher_id_t;\0A\0A/**\0A * Used internally to indicate whether a context uses legacy or PSA.\0A *\0A * Internal use only.\0A */\0Atypedef enum {\0A    MBEDTLS_BLOCK_CIPHER_ENGINE_LEGACY = 0,\0A    MBEDTLS_BLOCK_CIPHER_ENGINE_PSA,\0A} mbedtls_block_cipher_engine_t;\0A\0Atypedef struct {\0A    mbedtls_block_cipher_id_t MBEDTLS_PRIVATE(id);\0A#if defined(MBEDTLS_BLOCK_CIPHER_SOME_PSA)\0A    mbedtls_block_cipher_engine_t MBEDTLS_PRIVATE(engine);\0A    mbedtls_svc_key_id_t MBEDTLS_PRIVATE(psa_key_id);\0A#endif\0A    union {\0A        unsigned dummy; /* Make the union non-empty even with no supported algorithms. */\0A#if defined(MBEDTLS_AES_C)\0A        mbedtls_aes_context MBEDTLS_PRIVATE(aes);\0A#endif\0A#if defined(MBEDTLS_ARIA_C)\0A        mbedtls_aria_context MBEDTLS_PRIVATE(aria);\0A#endif\0A#if defined(MBEDTLS_CAMELLIA_C)\0A        mbedtls_camellia_context MBEDTLS_PRIVATE(camellia);\0A#endif\0A    } MBEDTLS_PRIVATE(ctx);\0A} mbedtls_block_cipher_context_t;\0A\0A#ifdef __cplusplus\0A}\0A#endif\0A\0A#endif /* MBEDTLS_BLOCK_CIPHER_H */\0A\00" }
