@.str44737 = private global { i64, i64, [8857 x i8] } { i64 -1, i64 8856, [8857 x i8] c"/**\0A *  Constant-time functions\0A *\0A *  Copyright The Mbed TLS Contributors\0A *  SPDX-License-Identifier: Apache-2.0 OR GPL-2.0-or-later\0A */\0A\0A/*\0A * The following functions are implemented without using comparison operators, as those\0A * might be translated to branches by some compilers on some platforms.\0A */\0A\0A#include <stdint.h>\0A#include <limits.h>\0A\0A#include \22common.h\22\0A#include \22constant_time_internal.h\22\0A#include \22mbedtls/constant_time.h\22\0A#include \22mbedtls/error.h\22\0A#include \22mbedtls/platform_util.h\22\0A\0A#include <string.h>\0A\0A#if !defined(MBEDTLS_CT_ASM)\0A/*\0A * Define an object with the value zero, such that the compiler cannot prove that it\0A * has the value zero (because it is volatile, it \22may be modified in ways unknown to\0A * the implementation\22).\0A */\0Avolatile mbedtls_ct_uint_t mbedtls_ct_zero = 0;\0A#endif\0A\0A/*\0A * Define MBEDTLS_EFFICIENT_UNALIGNED_VOLATILE_ACCESS where assembly is present to\0A * perform fast unaligned access to volatile data.\0A *\0A * This is needed because mbedtls_get_unaligned_uintXX etc don't support volatile\0A * memory accesses.\0A *\0A * Some of these definitions could be moved into alignment.h but for now they are\0A * only used here.\0A */\0A#if defined(MBEDTLS_EFFICIENT_UNALIGNED_ACCESS) && \5C\0A    ((defined(MBEDTLS_CT_ARM_ASM) && (UINTPTR_MAX == 0xfffffffful)) || \5C\0A    defined(MBEDTLS_CT_AARCH64_ASM))\0A/* We check pointer sizes to avoid issues with them not matching register size requirements */\0A#define MBEDTLS_EFFICIENT_UNALIGNED_VOLATILE_ACCESS\0A\0Astatic inline uint32_t mbedtls_get_unaligned_volatile_uint32(volatile const unsigned char *p)\0A{\0A    /* This is UB, even where it's safe:\0A     *    return *((volatile uint32_t*)p);\0A     * so instead the same thing is expressed in assembly below.\0A     */\0A    uint32_t r;\0A#if defined(MBEDTLS_CT_ARM_ASM)\