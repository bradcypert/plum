: Map[K, V]) (new_bucket_count: Int): Map[K, V] = {\0A    let mut new_buckets = map_make_buckets(new_bucket_count);\0A    for bucket in m.buckets {\0A        for entry in bucket {\0A            let idx = map_bucket_index(entry.key, new_bucket_count);\0A            new_buckets = new_buckets.set(idx, new_buckets[idx].push(entry));\0A        }\0A    };\0A    Map { buckets: new_buckets, size: m.size }\0A}\0A\0A/// A NEW map with `k` set to `v`, replacing any previous value. The\0A/// original is unchanged.\0Apub let Map.insert[K: Eq, V] (m: Map[K, V]) (k: K) (v: V): Map[K, V] = {\0A    let idx = map_bucket_index(k, m.buckets.len());\0A    let bucket = m.buckets[idx];\0A    let existing_i = map_bucket_find_index(bucket, k, 0);\0A    let inserted = if existing_i >= 0 {\0A        Map { buckets: m.buckets.set(idx, bucket.set(existing_i, MapEntry { key: k, value: v })), size: m.size }\0A    } else {\0A        Map { buckets: m.buckets.set(idx, bucket.push(MapEntry { key: k, value: v })), size: m.size + 1 }\0A    };\0A    if inserted.size * MAP_LOAD_FACTOR_DEN > inserted.buckets.len() * MAP_LOAD_FACTOR_NUM {\0A        map_rehash(inserted, inserted.buckets.len() * 2)\0A    } else {\0A        inserted\0A    }\0A}\0A\0A/// The value for `k`, or `None`.\0Apub let Map.get[K: Eq, V] (m: Map[K, V]) (k: K): Option[V] = {\0A    let bucket = m.buckets[map_bucket_index(k, m.buckets.len())];\0A    let i = map_bucket_find_index(bucket, k, 0);\0A    if i >= 0 { Some(bucket[i].value) } else { None }\0A}\0A\0A/// Whether `k` has a value.\0Apub let Map.contains[K: Eq, V] (m: Map[K, V]) (k: K): Bool =\0A    map_bucket_find_index(m.buckets[map_bucket_index(k, m.buckets.len())], k, 0) >= 0\0A\0A/// A new map without `k`. Removing an absent key is not an error.\0Apub let Map.remove[K: Eq, V] (m: Map[K, V]) (k: K): Map[K, V] = {\0A    let idx = map_bucket_index(k, m.buckets.len());\0A    let bucket = m.buckets[idx];\0A    let i = map_bucket_find_index(bucket, k, 0);\0A    if i >= 0 { Map { buckets: