@.str45395 = private global { i64, i64, [2017 x i8] } { i64 -1, i64 2016, [2017 x i8] c"/**\0A * \5Cfile psa/crypto_adjust_config_dependencies.h\0A * \5Cbrief Adjust PSA configuration by resolving some dependencies.\0A *\0A * This is an internal header. Do not include it directly.\0A *\0A * See docs/proposed/psa-conditional-inclusion-c.md.\0A * If the Mbed TLS implementation of a cryptographic mechanism A depends on a\0A * cryptographic mechanism B then if the cryptographic mechanism A is enabled\0A * and not accelerated enable B. Note that if A is enabled and accelerated, it\0A * is not necessary to enable B for A support.\0A */\0A/*\0A *  Copyright The Mbed TLS Contributors\0A *  SPDX-License-Identifier: Apache-2.0 OR GPL-2.0-or-later\0A */\0A\0A#ifndef PSA_CRYPTO_ADJUST_CONFIG_DEPENDENCIES_H\0A#define PSA_CRYPTO_ADJUST_CONFIG_DEPENDENCIES_H\0A\0A#if !defined(MBEDTLS_CONFIG_FILES_READ)\0A#error \22Do not include psa/crypto_adjust_*.h manually! This can lead to problems, \22 \5C\0A    \22up to and including runtime errors such as buffer overflows. \22 \5C\0A    \22If you're trying to fix a complaint from check_config.h, just remove \22 \5C\0A    \22it from your configuration file: since Mbed TLS 3.0, it is included \22 \5C\0A    \22automatically at the right point.\22\0A#endif /* */\0A\0A#if (defined(PSA_WANT_ALG_TLS12_PRF) && \5C\0A    !defined(MBEDTLS_PSA_ACCEL_ALG_TLS12_PRF)) || \5C\0A    (defined(PSA_WANT_ALG_TLS12_PSK_TO_MS) && \5C\0A    !defined(MBEDTLS_PSA_ACCEL_ALG_TLS12_PSK_TO_MS)) || \5C\0A    (defined(PSA_WANT_ALG_HKDF) && \5C\0A    !defined(MBEDTLS_PSA_ACCEL_ALG_HKDF)) || \5C\0A    (defined(PSA_WANT_ALG_HKDF_EXTRACT) && \5C\0A    !defined(MBEDTLS_PSA_ACCEL_ALG_HKDF_EXTRACT)) || \5C\0A    (defined(PSA_WANT_ALG_HKDF_EXPAND) && \5C\0A    !defined(MBEDTLS_PSA_ACCEL_ALG_HKDF_EXPAND)) || \5C\0A    (defined(PSA_WANT_ALG_PBKDF2_HMAC) && \5C\0A    !defined(MBEDTLS_PSA_ACCEL_ALG_PBKDF2_HMAC))\0A#define PSA_WANT_ALG_HMAC 1\0A#define PSA_WANT_KEY_TYPE_HMAC 1\0A#endif\0A\0A#if (defined(PSA_WANT_ALG_PBKDF2_AES_CMAC_PRF_128) && \5C\0A    !defined(MBEDTLS_PSA_ACCEL_ALG_PBKDF2_AES_CMAC_PRF_128))\0A#define PSA_WANT_KEY_TYPE_AES 1\0A#define PSA_WANT_ALG_CMAC 1\0A#endif\0A\0A#endif /* PSA_CRYPTO_ADJUST_CONFIG_DEPENDENCIES_H */\0A\00" }
