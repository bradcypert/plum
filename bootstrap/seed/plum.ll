mbedtls_printf(\22failed\5Cn\22);\0A            }\0A\0A            return 1;\0A        }\0A        memset(plaintext, 0, CCM_SELFTEST_PT_MAX_LEN);\0A\0A        ret = mbedtls_ccm_auth_decrypt(&ctx, msg_len_test_data[i],\0A                                       iv_test_data, iv_len_test_data[i],\0A                                       ad_test_data, add_len_test_data[i],\0A                                       ciphertext, plaintext,\0A                                       ciphertext + msg_len_test_data[i],\0A                                       tag_len_test_data[i]);\0A\0A        if (ret != 0 ||\0A            memcmp(plaintext, msg_test_data, msg_len_test_data[i]) != 0) {\0A            if (verbose != 0) {\0A                mbedtls_printf(\22failed\5Cn\22);\0A            }\0A\0A            return 1;\0A        }\0A\0A        if (verbose != 0) {\0A            mbedtls_printf(\22passed\5Cn\22);\0A        }\0A    }\0A\0A    mbedtls_ccm_free(&ctx);\0A\0A    if (verbose != 0) {\0A        mbedtls_printf(\22\5Cn\22);\0A    }\0A\0A    return 0;\0A}\0A\0A#endif /* MBEDTLS_SELF_TEST && MBEDTLS_AES_C */\0A\0A#endif /* MBEDTLS_CCM_C */\0A\00" }
