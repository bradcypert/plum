    si.hStdInput = hi;\0A    si.hStdOutput = ho;\0A    si.hStdError = he;\0A    ZeroMemory(&pi, sizeof(pi));\0A\0A    // `lpApplicationName` is NULL so that `CreateProcess` searches PATH\0A    // and appends `.exe`, which is what makes `clang` resolve the same\0A    // way it does everywhere else. The ambiguity that normally makes\0A    // that risky -- an unquoted program path containing spaces -- does\0A    // not apply, because the program was quoted above like any other\0A    // argument.\0A    if (!CreateProcessW(NULL, cmdline, NULL, NULL, TRUE, CREATE_UNICODE_ENVIRONMENT, env_block, NULL, &si, &pi)) {\0A        CloseHandle(ho);\0A        CloseHandle(he);\0A        if (hi_owned) CloseHandle(hi);\0A        DeleteFileA(out_path);\0A        DeleteFileA(err_path);\0A        if (in_path[0] != '\5C0') DeleteFileA(in_path);\0A        free(cmdline);\0A        free(env_block);\0A        return PLUM_SPAWN_FAILED;\0A    }\0A\0A    free(cmdline);\0A    free(env_block);\0A    CloseHandle(pi.hThread);\0A\0A    // Asynchronous: keep the process handle to wait on, and keep the\0A    // two file handles OPEN -- they are the child's stdout and stderr,\0A    // and closing them here would close the child's own descriptors.\0A    // The input file cannot be deleted yet either: Windows refuses to\0A    // unlink a file that is open, which is why POSIX can unlink it at\0A    // spawn and this cannot.\0A    if (async != NULL) {\0A        async->pid = (long long)(intptr_t)pi.hProcess;\0A        async->h_out = (void *)ho;\0A        async->h_err = (void *)he;\0A        if (hi_owned) CloseHandle(hi);\0A        if (in_path[0] != '\5C0') async->in_path = plum_strdup_or_null(in_path);\0A        (void)program;\0A        (void)fail_on_exec;\0A        return 0;\0A    }\0A\0A    WaitForSingleObject(pi.hProcess, INFINITE);\0A    if (!GetExitCodeProcess(pi.hProcess, &code)) code = (DWORD)-1;\0A    CloseHandle(pi.hProcess);\0A\0A    // Closed only after the child has exited, so everything it wrote