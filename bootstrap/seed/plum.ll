@.str41973 = private global { i64, i64, [2029 x i8] } { i64 -1, i64 2028, [2029 x i8] c"/**\0A * \5Cfile psa/crypto_adjust_config_synonyms.h\0A * \5Cbrief Adjust PSA configuration: enable quasi-synonyms\0A *\0A * This is an internal header. Do not include it directly.\0A *\0A * When two features require almost the same code, we automatically enable\0A * both when either one is requested, to reduce the combinatorics of\0A * possible configurations.\0A */\0A/*\0A *  Copyright The Mbed TLS Contributors\0A *  SPDX-License-Identifier: Apache-2.0 OR GPL-2.0-or-later\0A */\0A\0A#ifndef PSA_CRYPTO_ADJUST_CONFIG_SYNONYMS_H\0A#define PSA_CRYPTO_ADJUST_CONFIG_SYNONYMS_H\0A\0A#if !defined(MBEDTLS_CONFIG_FILES_READ)\0A#error \22Do not include psa/crypto_adjust_*.h manually! This can lead to problems, \22 \5C\0A    \22up to and including runtime errors such as buffer overflows. \22 \5C\0A    \22If you're trying to fix a complaint from check_config.h, just remove \22 \5C\0A    \22it from your configuration file: since Mbed TLS 3.0, it is included \22 \5C\0A    \22automatically at the right point.\22\0A#endif /* */\0A\0A/****************************************************************/\0A/* De facto synonyms */\0A/****************************************************************/\0A\0A#if defined(PSA_WANT_ALG_ECDSA_ANY) && !defined(PSA_WANT_ALG_ECDSA)\0A#define PSA_WANT_ALG_ECDSA PSA_WANT_ALG_ECDSA_ANY\0A#elif !defined(PSA_WANT_ALG_ECDSA_ANY) && defined(PSA_WANT_ALG_ECDSA)\0A#define PSA_WANT_ALG_ECDSA_ANY PSA_WANT_ALG_ECDSA\0A#endif\0A\0A#if defined(PSA_WANT_ALG_RSA_PKCS1V15_SIGN_RAW) && !defined(PSA_WANT_ALG_RSA_PKCS1V15_SIGN)\0A#define PSA_WANT_ALG_RSA_PKCS1V15_SIGN PSA_WANT_ALG_RSA_PKCS1V15_SIGN_RAW\0A#elif !defined(PSA_WANT_ALG_RSA_PKCS1V15_SIGN_RAW) && defined(PSA_WANT_ALG_RSA_PKCS1V15_SIGN)\0A#define PSA_WANT_ALG_RSA_PKCS1V15_SIGN_RAW PSA_WANT_ALG_RSA_PKCS1V15_SIGN\0A#endif\0A\0A#if defined(PSA_WANT_ALG_RSA_PSS_ANY_SALT) && !defined(PSA_WANT_ALG_RSA_PSS)\0A#define PSA_WANT_ALG_RSA_PSS PSA_WANT_ALG_RSA_PSS_ANY_SALT\0A#elif !defined(PSA_WANT_ALG_RSA_PSS_ANY_SALT) && defined(PSA_WANT_ALG_RSA_PSS)\0A#define PSA_WANT_ALG_RSA_PSS_ANY_SALT PSA_WANT_ALG_RSA_PSS\0A#endif\0A\0A#endif /* PSA_CRYPTO_ADJUST_CONFIG_SYNONYMS_H */\0A\00" }
