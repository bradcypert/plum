@.str41816 = private global { i64, i64, [45512 x i8] } { i64 -1, i64 45511, [45512 x i8] c"/**\0A * \5Cfile bignum.h\0A *\0A * \5Cbrief Multi-precision integer library\0A */\0A/*\0A *  Copyright The Mbed TLS Contributors\0A *  SPDX-License-Identifier: Apache-2.0 OR GPL-2.0-or-later\0A */\0A#ifndef MBEDTLS_BIGNUM_H\0A#define MBEDTLS_BIGNUM_H\0A#include \22mbedtls/private_access.h\22\0A\0A#include \22mbedtls/build_info.h\22\0A\0A#include <stddef.h>\0A#include <stdint.h>\0A\0A#if defined(MBEDTLS_FS_IO)\0A#include <stdio.h>\0A#endif\0A\0A/** An error occurred while reading from or writing to a file. */\0A#define MBEDTLS_ERR_MPI_FILE_IO_ERROR                     -0x0002\0A/** Bad input parameters to function. */\0A#define MBEDTLS_ERR_MPI_BAD_INPUT_DATA                    -0x0004\0A/** There is an invalid character in the digit string. */\0A#define MBEDTLS_ERR_MPI_INVALID_CHARACTER                 -0x0006\0A/** The buffer is too small to write to. */\0A#define MBEDTLS_ERR_MPI_BUFFER_TOO_SMALL                  -0x0008\0A/** The input arguments are negative or result in illegal output. */\0A#define MBEDTLS_ERR_MPI_NEGATIVE_VALUE                    -0x000A\0A/** The input argument for division is zero, which is not allowed. */\0A#define MBEDTLS_ERR_MPI_DIVISION_BY_ZERO                  -0x000C\0A/** The input arguments are not acceptable. */\0A#define MBEDTLS_ERR_MPI_NOT_ACCEPTABLE                    -0x000E\0A/** Memory allocation failed. */\0A#define MBEDTLS_ERR_MPI_ALLOC_FAILED                      -0x0010\0A\0A#define MBEDTLS_MPI_CHK(f)       \5C\0A    do                           \5C\0A    {                            \5C\0A        if ((ret = (f)) != 0) \5C\0A        goto cleanup;        \5C\0A    } while (0)\0A\0A/*\0A * Maximum size MPIs are allowed to grow to in number of limbs.\0A */\0A#define MBEDTLS_MPI_MAX_LIMBS                             10000\0A\0A#if !defined(MBEDTLS_MPI_WINDOW_SIZE)\0A/*\0A * Maximum window size used for modular exponentiation. Default: 3\0A * Minimum value: 1. Maximum value: 6.\0A *\0A * Result is an array of ( 2 ** MBEDTLS_MPI_WINDOW_SIZE ) MPIs used\0A * for the sliding window calculation. (So 8 by default)\0A *\0A * Reduction in size, reduces speed.\0A */\0A#define MBEDTLS_MPI_WINDOW_SIZE                           3        /**< Maximum window size used. */\0A#endif /* !MBEDTLS_MPI_WINDOW_SIZE */\0A\0A#if !defined(MBEDTLS_MPI_MAX_SIZE)\0A/*\0A * Maximum size of MPIs allowed in bits and bytes for user-MPIs.\0A * ( Default: 512 bytes => 4096 bits, Maximum tested: 2048 bytes => 16384 bits )\0A *\0A * Note: Calculations can temporarily result in larger MPIs. So the number\0A * of limbs required (MBEDTLS_MPI_MAX_LIMBS) is higher.\0A */\0A#define MBEDTLS_MPI_MAX_SIZE                              1024     /**< Maximum number of bytes for usable MPIs. */\0A#endif /* !MBEDTLS_MPI_MAX_SIZE */\0A\0A#define MBEDTLS_MPI_MAX_BITS                              (8 * MBEDTLS_MPI_MAX_SIZE)      /**< Maximum number of bits for usable MPIs. */\0A\0A/*\0A * When reading from files with mbedtls_mpi_read_file() and writing to files with\0A * mbedtls_mpi_write_file() the buffer should have space\0A * for a (short) label, the MPI (in the provided radix), the newline\0A * characters and the '\5C0'.\0A *\0A * By default we assume at least a 10 char label, a minimum radix of 10\0A * (decimal) and a maximum of 4096 bit numbers (1234 decimal chars).\0A * Autosized at compile time for at least a 10 char label, a minimum radix\0A * of 10 (decimal) for a number of MBEDTLS_MPI_MAX_BITS size.\0A *\0A * This used to be statically sized to 1250 for a maximum of 4096 bit\0A * numbers (1234 decimal chars).\0A *\0A * Calculate using the formula:\0A *  MBEDTLS_MPI_RW_BUFFER_SIZE = ceil(MBEDTLS_MPI_MAX_BITS / ln(10) * ln(2)) +\0A *                                LabelSize + 6\0A */\0A#define MBEDTLS_MPI_MAX_BITS_SCALE100          (100 * MBEDTLS_MPI_MAX_BITS)\0A#define MBEDTLS_LN_2_DIV_LN_10_SCALE100                 332\0A#define MBEDTLS_MPI_RW_BUFFER_SIZE             (((MBEDTLS_MPI_MAX_BITS_SCALE100 + \5C\0A                                                  MBEDTLS_LN_2_DIV_LN_10_SCALE100 - 1) / \5C\0A                                                 MBEDTLS_LN_2_DIV_LN_10_SCALE100) + 10 + 6)\0A\0A/*\0A * Define the base integer type, architecture-wise.\0A *\0A * 32 or 64-bit integer types can be forced regardless of the underlying\0A * architecture by defining MBEDTLS_HAVE_INT32 or MBEDTLS_HAVE_INT64\0A * respectively and undefining MBEDTLS_HAVE_ASM.\0A *\0A * Double-width integers (e.g. 128-bit in 64-bit architectures) can be\0A * disabled by defining MBEDTLS_NO_UDBL_DIVISION.\0A */\0A#if !defined(MBEDTLS_HAVE_INT32)\0A    #if defined(_MSC_VER) && defined(_M_AMD64)\0A/* Always choose 64-bit when using MSC */\0A        #if !defined(MBEDTLS_HAVE_INT64)\0A            #define MBEDTLS_HAVE_INT64\0A        #endif /* !MBEDTLS_HAVE_INT64 */\0Atypedef  int64_t mbedtls_mpi_sint;\0Atypedef uint64_t mbedtls_mpi_uint;\0A#define MBEDTLS_MPI_UINT_MAX                UINT64_MAX\0A    #elif defined(__GNUC__) && (                         \5C\0A    defined(__amd64__) || defined(__x86_64__)     || \5C\0A    defined(__ppc64__) || defined(__powerpc64__)  || \5C\0A    defined(__ia64__)  || defined(__alpha__)      || \5C\0A    (defined(__sparc__) && defined(__arch64__)) || \5C\0A    defined(__s390x__) || defined(__mips64)       || \5C\0A    defined(__aarch64__))\0A        #if !defined(MBEDTLS_HAVE_INT64)\0A            #define MBEDTLS_HAVE_INT64\0A        #endif /* MBEDTLS_HAVE_INT64 */\0Atypedef  int64_t mbedtls_mpi_sint;\0Atypedef uint64_t mbedtls_mpi_uint;\0A#define MBEDTLS_MPI_UINT_MAX                UINT64_MAX\0A        #if !defined(MBEDTLS_NO_UDBL_DIVISION)\0A/* mbedtls_t_udbl defined as 128-bit unsigned int */\0Atypedef unsigned int mbedtls_t_udbl __attribute__((mode(TI)));\0A            #define MBEDTLS_HAVE_UDBL\0A        #endif /* !MBEDTLS_NO_UDBL_DIVISION */\0A    #elif defined(__ARMCC_VERSION) && defined(__aarch64__)\0A/*\0A * __ARMCC_VERSION is defined for both armcc and armclang and\0A * __aarch64__ is only defined by armclang when compiling 64-bit code\0A */\0A        #if !defined(MBEDTLS_HAVE_INT64)\0A            #define MBEDTLS_HAVE_INT64\0A        #endif /* !MBEDTLS_HAVE_INT64 */\0Atypedef  int64_t mbedtls_mpi_sint;\0Atypedef uint64_t mbedtls_mpi_uint;\0A#define MBEDTLS_MPI_UINT_MAX                UINT64_MAX\0A        #if !defined(MBEDTLS_NO_UDBL_DIVISION)\0A/* mbedtls_t_udbl defined as 128-bit unsigned int */\0Atypedef __uint128_t mbedtls_t_udbl;\0A            #define MBEDTLS_HAVE_UDBL\0A        #endif /* !MBEDTLS_NO_UDBL_DIVISION */\0A    #elif defined(MBEDTLS_HAVE_INT64)\0A/* Force 64-bit integers with unknown compiler */\0Atypedef  int64_t mbedtls_mpi_sint;\0Atypedef uint64_t mbedtls_mpi_uint;\0A#define MBEDTLS_MPI_UINT_MAX                UINT64_MAX\0A    #endif\0A#endif /* !MBEDTLS_HAVE_INT32 */\0A\0A#if !defined(MBEDTLS_HAVE_INT64)\0A/* Default to 32-bit compilation */\0A    #if !defined(MBEDTLS_HAVE_INT32)\0A        #define MBEDTLS_HAVE_INT32\0A    #endif /* !MBEDTLS_HAVE_INT32 */\0Atypedef  int32_t mbedtls_mpi_sint;\0Atypedef uint32_t mbedtls_mpi_uint;\0A#define MBEDTLS_MPI_UINT_MAX                UINT32_MAX\0A    #if !defined(MBEDTLS_NO_UDBL_DIVISION)\0Atypedef uint64_t mbedtls_t_udbl;\0A        #define MBEDTLS_HAVE_UDBL\0A    #endif /* !MBEDTLS_NO_UDBL_DIVISION */\0A#endif /* !MBEDTLS_HAVE_INT64 */\0A\0A/*\0A * Sanity check that exactly one of MBEDTLS_HAVE_INT32 or MBEDTLS_HAVE_INT64 is defined,\0A * so that code elsewhere doesn't have to check.\0A */\0A#if (!(defined(MBEDTLS_HAVE_INT32) || defined(MBEDTLS_HAVE_INT64))) || \5C\0A    (defined(MBEDTLS_HAVE_INT32) && defined(MBEDTLS_HAVE_INT64))\0A#error \22Only 32-bit or 64-bit limbs are supported in bignum\22\0A#endif\0A\0A/** \5Ctypedef mbedtls_mpi_uint\0A * \5Cbrief The type of machine digits in a bignum, called _limbs_.\0A *\0A * This is always an unsigned integer type with no padding bits. The size\0A * is platform-dependent.\0A */\0A\0A/** \5Ctypedef mbedtls_mpi_sint\0A * \5Cbrief The signed type corresponding to #mbedtls_mpi_uint.\0A *\0A * This is always an signed integer type with no padding bits. The size\0A * is platform-dependent.\0A */\0A\0A#ifdef __cplusplus\0Aextern \22C\22 {\0A#endif\0A\0A/**\0A * \5Cbrief          MPI structure\0A */\0Atypedef struct mbedtls_mpi {\0A    /** Pointer to limbs.\0A     *\0A     * This may be \5Cc NULL if \5Cc n is 0.\0A     */\0A    mbedtls_mpi_uint *MBEDTLS_PRIVATE(p);\0A\0A    /** Sign: -1 if the mpi is negative, 1 otherwise.\0A     *\0A     * The number 0 must be represented with `s = +1`. Although many library\0A     * functions treat all-limbs-zero as equivalent to a valid representation\0A     * of 0 regardless of the sign bit, there are exceptions, so bignum\0A     * functions and external callers must always set \5Cc s to +1 for the\0A     * number zero.\0A     *\0A     * Note that this implies that calloc() or `... = {0}` does not create\0A     * a valid MPI representation. You must call mbedtls_mpi_init().\0A     */\0A    signed short MBEDTLS_PRIVATE(s);\0A\0A    /** Total number of limbs in \5Cc p.  */\0A    unsigned short MBEDTLS_PRIVATE(n);\0A    /* Make sure that MBEDTLS_MPI_MAX_LIMBS fits in n.\0A     * Use the same limit value on all platforms so that we don't have to\0A     * think about different behavior on the rare platforms where\0A     * unsigned short can store values larger than the minimum required by\0A     * the C language, which is 65535.\0A     */\0A#if MBEDTLS_MPI_MAX_LIMBS > 65535\0A#error \22MBEDTLS_MPI_MAX_LIMBS > 65535 is not supported\22\0A#endif\0A}\0Ambedtls_mpi;\0A\0A/**\0A * \5Cbrief           Initialize an MPI context.\0A *\0A *                  This makes the MPI ready to be set or freed,\0A *                  but does not define a value for the MPI.\0A *\0A * \5Cparam X         The MPI context to initialize. This must not be \5Cc NULL.\0A */\0Avoid mbedtls_mpi_init(mbedtls_mpi *X);\0A\0A/**\0A * \5Cbrief          This function frees the components of an MPI context.\0A *\0A * \5Cparam X        The MPI context to be cleared. This may be \5Cc NULL,\0A *                 in which case this function is a no-op. If it is\0A *                 not \5Cc NULL, it must point to an initialized MPI.\0A */\0Avoid mbedtls_mpi_free(mbedtls_mpi *X);\0A\0A/**\0A * \5Cbrief          Enlarge an MPI to the specified number of limbs.\0A *\0A * \5Cnote           This function does nothing if the MPI is\0A *                 already large enough.\0A *\0A * \5Cparam X        The MPI to grow. It must be initialized.\0A * \5Cparam nblimbs  The target number of limbs.\0A *\0A * \5Creturn         \5Cc 0 if successful.\0A * \5Creturn         #MBEDTLS_ERR_MPI_ALLOC_FAILED if memory allocation failed.\0A * \5Creturn         Another negative error code on other kinds of failure.\0A */\0Aint mbedtls_mpi_grow(mbedtls_mpi *X, size_t nblimbs);\0A\0A/**\0A * \5Cbrief          This function resizes an MPI downwards, keeping at least the\0A *                 specified number of limbs.\0A *\0A *                 If \5Cc X is smaller than \5Cc nblimbs, it is resized up\0A *                 instead.\0A *\0A * \5Cparam X        The MPI to shrink. This must point to an initialized MPI.\0A * \5Cparam nblimbs  The minimum number of limbs to keep.\0A *\0A * \5Creturn         \5Cc 0 if successful.\0A * \5Creturn         #MBEDTLS_ERR_MPI_ALLOC_FAILED if memory allocation failed\0A *                 (this can only happen when resizing up).\0A * \5Creturn         Another negative error code on other kinds of failure.\0A */\0Aint mbedtls_mpi_shrink(mbedtls_mpi *X, size_t nblimbs);\0A\0A/**\0A * \5Cbrief          Make a copy of an MPI.\0A *\0A * \5Cparam X        The destination MPI. This must point to an initialized MPI.\0A * \5Cparam Y        The source MPI. This must point to an initialized MPI.\0A *\0A * \5Cnote           The limb-buffer in the destination MPI is enlarged\0A *                 if necessary to hold the value in the source MPI.\0A *\0A * \5Creturn         \5Cc 0 if successful.\0A * \5Creturn         #MBEDTLS_ERR_MPI_ALLOC_FAILED if memory allocation failed.\0A * \5Creturn         Another negative error code on other kinds of failure.\0A */\0Aint mbedtls_mpi_copy(mbedtls_mpi *X, const mbedtls_mpi *Y);\0A\0A/**\0A * \5Cbrief          Swap the contents of two MPIs.\0A *\0A * \5Cparam X        The first MPI. It must be initialized.\0A * \5Cparam Y        The second MPI. It must be initialized.\0A */\0Avoid mbedtls_mpi_swap(mbedtls_mpi *X, mbedtls_mpi *Y);\0A\0A/**\0A * \5Cbrief          Perform a safe conditional copy of MPI which doesn't\0A *                 reveal whether the condition was true or not.\0A *\0A * \5Cparam X        The MPI to conditionally assign to. This must point\0A *                 to an initialized MPI.\0A * \5Cparam Y        The MPI to be assigned from. This must point to an\0A *                 initialized MPI.\0A * \5Cparam assign   The condition deciding whether to perform the\0A *                 assignment or not. Must be either 0 or 1:\0A *                 * \5Cc 1: Perform the assignment `X = Y`.\0A *                 * \5Cc 0: Keep the original value of \5Cp X.\0A *\0A * \5Cnote           This function is equivalent to\0A *                      `if( assign ) mbedtls_mpi_copy( X, Y );`\0A *                 except that it avoids leaking any information about whether\0A *                 the assignment was done or not (the above code may leak\0A *                 information through branch prediction and/or memory access\0A *                 patterns analysis).\0A *\0A * \5Cwarning        If \5Cp assign is neither 0 nor 1, the result of this function\0A *                 is indeterminate, and the resulting value in \5Cp X might be\0A *                 neither its original value nor the value in \5Cp Y.\0A *\0A * \5Creturn         \5Cc 0 if successful.\0A * \5Creturn         #MBEDTLS_ERR_MPI_ALLOC_FAILED if memory allocation failed.\0A * \5Creturn         Another negative error code on other kinds of failure.\0A */\0Aint mbedtls_mpi_safe_cond_assign(mbedtls_mpi *X, const mbedtls_mpi *Y, unsigned char assign);\0A\0A/**\0A * \5Cbrief          Perform a safe conditional swap which doesn't\0A *                 reveal whether the condition was true or not.\0A *\0A * \5Cparam X        The first MPI. This must be initialized.\0A * \5Cparam Y        The second MPI. This must be initialized.\0A * \5Cparam swap     The condition deciding whether to perform\0A *                 the swap or not. Must be either 0 or 1:\0A *                 * \5Cc 1: Swap the values of \5Cp X and \5Cp Y.\0A *                 * \5Cc 0: Keep the original values of \5Cp X and \5Cp Y.\0A *\0A * \5Cnote           This function is equivalent to\0A *                      if( swap ) mbedtls_mpi_swap( X, Y );\0A *                 except that it avoids leaking any information about whether\0A *                 the swap was done or not (the above code may leak\0A *                 information through branch prediction and/or memory access\0A *                 patterns analysis).\0A *\0A * \5Cwarning        If \5Cp swap is neither 0 nor 1, the result of this function\0A *                 is indeterminate, and both \5Cp X and \5Cp Y might end up with\0A *                 values different to either of the original ones.\0A *\0A * \5Creturn         \5Cc 0 if successful.\0A * \5Creturn         #MBEDTLS_ERR_MPI_ALLOC_FAILED if memory allocation failed.\0A * \5Creturn         Another negative error code on other kinds of failure.\0A *\0A */\0Aint mbedtls_mpi_safe_cond_swap(mbedtls_mpi *X, mbedtls_mpi *Y, unsigned char swap);\0A\0A/**\0A * \5Cbrief          Store integer value in MPI.\0A *\0A * \5Cparam X        The MPI to set. This must be initialized.\0A * \5Cparam z        The value to use.\0A *\0A * \5Creturn         \5Cc 0 if successful.\0A * \5Creturn         #MBEDTLS_ERR_MPI_ALLOC_FAILED if memory allocation failed.\0A * \5Creturn         Another negative error code on other kinds of failure.\0A */\0Aint mbedtls_mpi_lset(mbedtls_mpi *X, mbedtls_mpi_sint z);\0A\0A/**\0A * \5Cbrief          Get a specific bit from an MPI.\0A *\0A * \5Cparam X        The MPI to query. This must be initialized.\0A * \5Cparam pos      Zero-based index of the bit to query.\0A *\0A * \5Creturn         \5Cc 0 or \5Cc 1 on success, depending on whether bit \5Cc pos\0A *                 of \5Cc X is unset or set.\0A * \5Creturn         A negative error code on failure.\0A */\0Aint mbedtls_mpi_get_bit(const mbedtls_mpi *X, size_t pos);\0A\0A/**\0A * \5Cbrief          Modify a specific bit in an MPI.\0A *\0A * \5Cnote           This function will grow the target MPI if necessary to set a\0A *                 bit to \5Cc 1 in a not yet existing limb. It will not grow if\0A *                 the bit should be set to \5Cc 0.\0A *\0A * \5Cparam X        The MPI to modify. This must be initialized.\0A * \5Cparam pos      Zero-based index of the bit to modify.\0A * \5Cparam val      The desired value of bit \5Cc pos: \5Cc 0 or \5Cc 1.\0A *\0A * \5Creturn         \5Cc 0 if successful.\0A * \5Creturn         #MBEDTLS_ERR_MPI_ALLOC_FAILED if memory allocation failed.\0A * \5Creturn         Another negative error code on other kinds of failure.\0A */\0Aint mbedtls_mpi_set_bit(mbedtls_mpi *X, size_t pos, unsigned char val);\0A\0A/**\0A * \5Cbrief          Return the number of bits of value \5Cc 0 before the\0A *                 least significant bit of value \5Cc 1.\0A *\0A * \5Cnote           This is the same as the zero-based index of\0A *                 the least significant bit of value \5Cc 1.\0A *\0A * \5Cparam X        The MPI to query.\0A *\0A * \5Creturn         The number of bits of value \5Cc 0 before the least significant\0A *                 bit of value \5Cc 1 in \5Cp X.\0A */\0Asize_t mbedtls_mpi_lsb(const mbedtls_mpi *X);\0A\0A/**\0A * \5Cbrief          Return the number of bits up to and including the most\0A