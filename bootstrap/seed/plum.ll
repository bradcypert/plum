0A{\0A    int ret = MBEDTLS_ERR_ERROR_CORRUPTION_DETECTED;\0A    uint32_t lifetime;\0A    size_t ticket_len;\0A    unsigned char *ticket;\0A    const unsigned char *msg;\0A\0A    MBEDTLS_SSL_DEBUG_MSG(2, (\22=> parse new session ticket\22));\0A\0A    if ((ret = mbedtls_ssl_read_record(ssl, 1)) != 0) {\0A        MBEDTLS_SSL_DEBUG_RET(1, \22mbedtls_ssl_read_record\22, ret);\0A        return ret;\0A    }\0A\0A    if (ssl->in_msgtype != MBEDTLS_SSL_MSG_HANDSHAKE) {\0A        MBEDTLS_SSL_DEBUG_MSG(1, (\22bad new session ticket message\22));\0A        mbedtls_ssl_send_alert_message(\0A            ssl,\0A            MBEDTLS_SSL_ALERT_LEVEL_FATAL,\0A            MBEDTLS_SSL_ALERT_MSG_UNEXPECTED_MESSAGE);\0A        return MBEDTLS_ERR_SSL_UNEXPECTED_MESSAGE;\0A    }\0A\0A    /*\0A     * struct {\0A     *     uint32 ticket_lifetime_hint;\0A     *     opaque ticket<0..2^16-1>;\0A     * } NewSessionTicket;\0A     *\0A     * 0  .  3   ticket_lifetime_hint\0A     * 4  .  5   ticket_len (n)\0A     * 6  .  5+n ticket content\0A     */\0A    if (ssl->in_msg[0] != MBEDTLS_SSL_HS_NEW_SESSION_TICKET ||\0A        ssl->in_hslen < 6 + mbedtls_ssl_hs_hdr_len(ssl)) {\0A        MBEDTLS_SSL_DEBUG_MSG(1, (\22bad new session ticket message\22));\0A        mbedtls_ssl_send_alert_message(ssl, MBEDTLS_SSL_ALERT_LEVEL_FATAL,\0A                                       MBEDTLS_SSL_ALERT_MSG_DECODE_ERROR);\0A        return MBEDTLS_ERR_SSL_DECODE_ERROR;\0A    }\0A\0A    msg = ssl->in_msg + mbedtls_ssl_hs_hdr_len(ssl);\0A\0A    lifetime = MBEDTLS_GET_UINT32_BE(msg, 0);\0A\0A    ticket_len = MBEDTLS_GET_UINT16_BE(msg, 4);\0A\0A    if (ticket_len + 6 + mbedtls_ssl_hs_hdr_len(ssl) != ssl->in_hslen) {\0A        MBEDTLS_SSL_DEBUG_MSG(1, (\22bad new session ticket message\22));\0A        mbedtls_ssl_send_alert_message(ssl, MBEDTLS_SSL_ALERT_LEVEL_FATAL,\0A                                       MBEDTLS_SSL_ALERT_MSG_DECODE_ERROR);\0A        return MBEDTLS_ERR_SSL_DECODE_ERROR;\0A    }\0A\0A    MBEDTLS_SSL_DEBUG_MS