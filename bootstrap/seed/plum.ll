@.str41010 = private global { i64, i64, [5649 x i8] } { i64 -1, i64 5648, [5649 x i8] c"/**\0A * \5Cfile check_crypto_config.h\0A *\0A * \5Cbrief Consistency checks for PSA configuration options\0A */\0A/*\0A *  Copyright The Mbed TLS Contributors\0A *  SPDX-License-Identifier: Apache-2.0 OR GPL-2.0-or-later\0A */\0A\0A/*\0A * It is recommended to include this file from your crypto_config.h\0A * in order to catch dependency issues early.\0A */\0A\0A#ifndef MBEDTLS_CHECK_CRYPTO_CONFIG_H\0A#define MBEDTLS_CHECK_CRYPTO_CONFIG_H\0A\0A#if defined(PSA_WANT_ALG_CCM) && \5C\0A    !(defined(PSA_WANT_KEY_TYPE_AES) || \5C\0A    defined(PSA_WANT_KEY_TYPE_CAMELLIA))\0A#error \22PSA_WANT_ALG_CCM defined, but not all prerequisites\22\0A#endif\0A\0A#if defined(PSA_WANT_ALG_CMAC) && \5C\0A    !(defined(PSA_WANT_KEY_TYPE_AES) || \5C\0A    defined(PSA_WANT_KEY_TYPE_CAMELLIA) || \5C\0A    defined(PSA_WANT_KEY_TYPE_DES))\0A#error \22PSA_WANT_ALG_CMAC defined, but not all prerequisites\22\0A#endif\0A\0A#if defined(PSA_WANT_ALG_DETERMINISTIC_ECDSA) && \5C\0A    !(defined(PSA_WANT_KEY_TYPE_ECC_KEY_PAIR_BASIC) || \5C\0A    defined(PSA_WANT_KEY_TYPE_ECC_PUBLIC_KEY))\0A#error \22PSA_WANT_ALG_DETERMINISTIC_ECDSA defined, but not all prerequisites\22\0A#endif\0A\0A#if defined(PSA_WANT_ALG_ECDSA) && \5C\0A    !(defined(PSA_WANT_KEY_TYPE_ECC_KEY_PAIR_BASIC) || \5C\0A    defined(PSA_WANT_KEY_TYPE_ECC_PUBLIC_KEY))\0A#error \22PSA_WANT_ALG_ECDSA defined, but not all prerequisites\22\0A#endif\0A\0A#if defined(PSA_WANT_ALG_GCM) && \5C\0A    !(defined(PSA_WANT_KEY_TYPE_AES) || \5C\0A    defined(PSA_WANT_KEY_TYPE_CAMELLIA))\0A#error \22PSA_WANT_ALG_GCM defined, but not all prerequisites\22\0A#endif\0A\0A#if defined(PSA_WANT_ALG_RSA_PKCS1V15_CRYPT) && \5C\0A    !(defined(PSA_WANT_KEY_TYPE_RSA_KEY_PAIR_BASIC) || \5C\0A    defined(PSA_WANT_KEY_TYPE_RSA_PUBLIC_KEY))\0A#error \22PSA_WANT_ALG_RSA_PKCS1V15_CRYPT defined, but not all prerequisites\22\0A#endif\0A\0A#if defined(PSA_WANT_ALG_RSA_PKCS1V15_SIGN) && \5C\0A    !(defined(PSA_WANT_KEY_TYPE_RSA_KEY_PAIR_BASIC) || \5C\0A    defined(PSA_WANT_KEY_TYPE_RSA_PUBLIC_KEY))\0A#error \22PSA_WANT_ALG_RSA_PKCS1V15_SIGN defined, but not all prerequisites\22\0A#endif\0A\0A#if defined(PSA_WANT_ALG_RSA_OAEP) && \5C\0A    !(defined(PSA_WANT_KEY_TYPE_RSA_KEY_PAIR_BASIC) || \5C\0A    defined(PSA_WANT_KEY_TYPE_RSA_PUBLIC_KEY))\0A#error \22PSA_WANT_ALG_RSA_OAEP defined, but not all prerequisites\22\0A#endif\0A\0A#if defined(PSA_WANT_ALG_RSA_PSS) && \5C\0A    !(defined(PSA_WANT_KEY_TYPE_RSA_KEY_PAIR_BASIC) || \5C\0A    defined(PSA_WANT_KEY_TYPE_RSA_PUBLIC_KEY))\0A#error \22PSA_WANT_ALG_RSA_PSS defined, but not all prerequisites\22\0A#endif\0A\0A#if (defined(PSA_WANT_KEY_TYPE_ECC_KEY_PAIR_BASIC) || \5C\0A    defined(PSA_WANT_KEY_TYPE_ECC_KEY_PAIR_IMPORT) || \5C\0A    defined(PSA_WANT_KEY_TYPE_ECC_KEY_PAIR_EXPORT) || \5C\0A    defined(PSA_WANT_KEY_TYPE_ECC_KEY_PAIR_GENERATE) || \5C\0A    defined(PSA_WANT_KEY_TYPE_ECC_KEY_PAIR_DERIVE)) && \5C\0A    !defined(PSA_WANT_KEY_TYPE_ECC_PUBLIC_KEY)\0A#error \22PSA_WANT_KEY_TYPE_ECC_KEY_PAIR_xxx defined, but not all prerequisites\22\0A#endif\0A\0A#if (defined(PSA_WANT_KEY_TYPE_RSA_KEY_PAIR_BASIC) || \5C\0A    defined(PSA_WANT_KEY_TYPE_RSA_KEY_PAIR_IMPORT) || \5C\0A    defined(PSA_WANT_KEY_TYPE_RSA_KEY_PAIR_EXPORT) || \5C\0A    defined(PSA_WANT_KEY_TYPE_RSA_KEY_PAIR_GENERATE)) && \5C\0A    !defined(PSA_WANT_KEY_TYPE_RSA_PUBLIC_KEY)\0A#error \22PSA_WANT_KEY_TYPE_RSA_KEY_PAIR_xxx defined, but not all prerequisites\22\0A#endif\0A\0A#if (defined(PSA_WANT_KEY_TYPE_DH_KEY_PAIR_BASIC) || \5C\0A    defined(PSA_WANT_KEY_TYPE_DH_KEY_PAIR_IMPORT) || \5C\0A    defined(PSA_WANT_KEY_TYPE_DH_KEY_PAIR_EXPORT) || \5C\0A    defined(PSA_WANT_KEY_TYPE_DH_KEY_PAIR_GENERATE)) && \5C\0A    !defined(PSA_WANT_KEY_TYPE_DH_PUBLIC_KEY)\0A#error \22PSA_WANT_KEY_TYPE_DH_KEY_PAIR_xxx defined, but not all prerequisites\22\0A#endif\0A\0A#if defined(PSA_WANT_KEY_TYPE_ECC_KEY_PAIR)\0A#if defined(MBEDTLS_DEPRECATED_REMOVED)\0A#error \22PSA_WANT_KEY_TYPE_ECC_KEY_PAIR is deprecated and will be removed in a \5C\0A    future version of Mbed TLS. Please switch to new PSA_WANT_KEY_TYPE_ECC_KEY_PAIR_xxx \5C\0A    symbols, where xxx can be: USE, IMPORT, EXPORT, GENERATE, DERIVE\22\0A#elif defined(MBEDTLS_DEPRECATED_WARNING)\0A#warning \22PSA_WANT_KEY_TYPE_ECC_KEY_PAIR is deprecated and will be removed in a \5C\0A    future version of Mbed TLS. Please switch to new PSA_WANT_KEY_TYPE_ECC_KEY_PAIR_xxx \5C\0A    symbols, where xxx can be: USE, IMPORT, EXPORT, GENERATE, DERIVE\22\0A#endif /* MBEDTLS_DEPRECATED_WARNING */\0A#endif /* PSA_WANT_KEY_TYPE_ECC_KEY_PAIR */\0A\0A#if defined(PSA_WANT_KEY_TYPE_RSA_KEY_PAIR)\0A#if defined(MBEDTLS_DEPRECATED_REMOVED)\0A#error \22PSA_WANT_KEY_TYPE_RSA_KEY_PAIR is deprecated and will be removed in a \5C\0A    future version of Mbed TLS. Please switch to new PSA_WANT_KEY_TYPE_RSA_KEY_PAIR_xxx \5C\0A    symbols, where xxx can be: USE, IMPORT, EXPORT, GENERATE, DERIVE\22\0A#elif defined(MBEDTLS_DEPRECATED_WARNING)\0A#warning \22PSA_WANT_KEY_TYPE_RSA_KEY_PAIR is deprecated and will be removed in a \5C\0A    future version of Mbed TLS. Please switch to new PSA_WANT_KEY_TYPE_RSA_KEY_PAIR_xxx \5C\0A    symbols, where xxx can be: USE, IMPORT, EXPORT, GENERATE, DERIVE\22\0A#endif /* MBEDTLS_DEPRECATED_WARNING */\0A#endif /* PSA_WANT_KEY_TYPE_RSA_KEY_PAIR */\0A\0A#if defined(PSA_WANT_KEY_TYPE_RSA_KEY_PAIR_DERIVE)\0A#error \22PSA_WANT_KEY_TYPE_RSA_KEY_PAIR_DERIVE defined, but feature is not supported\22\0A#endif\0A\0A#if defined(PSA_WANT_KEY_TYPE_DH_KEY_PAIR_DERIVE)\0A#error \22PSA_WANT_KEY_TYPE_DH_KEY_PAIR_DERIVE defined, but feature is not supported\22\0A#endif\0A\0A#if defined(MBEDTLS_SSL_PROTO_TLS1_2) && defined(MBEDTLS_USE_PSA_CRYPTO) && \5C\0A    !(defined(PSA_WANT_ALG_SHA_1) || defined(PSA_WANT_ALG_SHA_256) || defined(PSA_WANT_ALG_SHA_512))\0A#error \22MBEDTLS_SSL_PROTO_TLS1_2 defined, but not all prerequisites\22\0A#endif\0A\0A#if defined(PSA_WANT_ALG_TLS12_ECJPAKE_TO_PMS) && \5C\0A    !defined(PSA_WANT_ALG_SHA_256)\0A#error \22PSA_WANT_ALG_TLS12_ECJPAKE_TO_PMS defined, but not all prerequisites\22\0A#endif\0A\0A#endif /* MBEDTLS_CHECK_CRYPTO_CONFIG_H */\0A\00" }
