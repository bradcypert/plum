@.str39948 = private global { i64, i64, [38320 x i8] } { i64 -1, i64 38319, [38320 x i8] c"/**\0A *  Core bignum functions\0A *\0A *  This interface should only be used by the legacy bignum module (bignum.h)\0A *  and the modular bignum modules (bignum_mod.c, bignum_mod_raw.c). All other\0A *  modules should use the high-level modular bignum interface (bignum_mod.h)\0A *  or the legacy bignum interface (bignum.h).\0A *\0A * This module is about processing non-negative integers with a fixed upper\0A * bound that's of the form 2^n-1 where n is a multiple of #biL.\0A * These can be thought of integers written in base 2^#biL with a fixed\0A * number of digits. Digits in this base are called *limbs*.\0A * Many operations treat these numbers as the principal representation of\0A * a number modulo 2^n or a smaller bound.\0A *\0A * The functions in this module obey the following conventions unless\0A * explicitly indicated otherwise:\0A *\0A * - **Overflow**: some functions indicate overflow from the range\0A *   [0, 2^n-1] by returning carry parameters, while others operate\0A *   modulo and so cannot overflow. This should be clear from the function\0A *   documentation.\0A * - **Bignum parameters**: Bignums are passed as pointers to an array of\0A *   limbs. A limb has the type #mbedtls_mpi_uint. Unless otherwise specified:\0A *     - Bignum parameters called \5Cp A, \5Cp B, ... are inputs, and are\0A *       not modified by the function.\0A *     - For operations modulo some number, the modulus is called \5Cp N\0A *       and is input-only.\0A *     - Bignum parameters called \5Cp X, \5Cp Y are outputs or input-output.\0A *       The initial content of output-only parameters is ignored.\0A *     - Some functions use different names that reflect traditional\0A *       naming of operands of certain operations (e.g.\0A *       divisor/dividend/quotient/remainder).\0A *     - \5Cp T is a temporary storage area. The initial content of such\0A *       parameter is ignored and the final content is unspecified.\0A * - **Bignum sizes**: bignum sizes are always expressed in limbs.\0A *   Most functions work on bignums of a given size and take a single\0A *   \5Cp limbs parameter that applies to all parameters that are limb arrays.\0A *   All bignum sizes must be at least 1 and must be significantly less than\0A *   #SIZE_MAX. The behavior if a size is 0 is undefined. The behavior if the\0A *   total size of all parameters overflows #SIZE_MAX is undefined.\0A * - **Parameter ordering**: for bignum parameters, outputs come before inputs.\0A *   Temporaries come last.\0A * - **Aliasing**: in general, output bignums may be aliased to one or more\0A *   inputs. As an exception, parameters that are documented as a modulus value\0A *   may not be aliased to an output. Outputs may not be aliased to one another.\0A *   Temporaries may not be aliased to any other parameter.\0A * - **Overlap**: apart from aliasing of limb array pointers (where two\0A *   arguments are equal pointers), overlap is not supported and may result\0A *   in undefined behavior.\0A * - **Error handling**: This is a low-level module. Functions generally do not\0A *   try to protect against invalid arguments such as nonsensical sizes or\0A *   null pointers. Note that some functions that operate on bignums of\0A *   different sizes have constraints about their size, and violating those\0A *   constraints may lead to buffer overflows.\0A * - **Modular representatives**: functions that operate modulo \5Cp N expect\0A *   all modular inputs to be in the range [0, \5Cp N - 1] and guarantee outputs\0A *   in the range [0, \5Cp N - 1]. If an input is out of range, outputs are\0A *   fully unspecified, though bignum values out of range should not cause\0A *   buffer overflows (beware that this is not extensively tested).\0A */\0A\0A/*\0A *  Copyright The Mbed TLS Contributors\0A *  SPDX-License-Identifier: Apache-2.0 OR GPL-2.0-or-later\0A */\0A\0A#ifndef MBEDTLS_BIGNUM_CORE_H\0A#define MBEDTLS_BIGNUM_CORE_H\0A\0A#include \22common.h\22\0A\0A#include \22mbedtls/bignum.h\22\0A\0A#include \22constant_time_internal.h\22\0A\0A#define ciL    (sizeof(mbedtls_mpi_uint))     /** chars in limb  */\0A#define biL    (ciL << 3)                     /** bits  in limb  */\0A#define biH    (ciL << 2)                     /** half limb size */\0A\0A/*\0A * Convert between bits/chars and number of limbs\0A * Divide first in order to avoid potential overflows\0A */\0A#define BITS_TO_LIMBS(i)  ((i) / biL + ((i) % biL != 0))\0A#define CHARS_TO_LIMBS(i) ((i) / ciL + ((i) % ciL != 0))\0A/* Get a specific byte, without range checks. */\0A#define GET_BYTE(X, i)                                \5C\0A    (((X)[(i) / ciL] >> (((i) % ciL) * 8)) & 0xff)\0A\0A/* Constants to identify whether a value is public or secret. If a parameter is marked as secret by\0A * this constant, the function must be constant time with respect to the parameter.\0A *\0A * This is only needed for functions with the _optionally_safe postfix. All other functions have\0A * fixed behavior that can't be changed at runtime and are constant time with respect to their\0A * parameters as prescribed by their documentation or by conventions in their module's documentation.\0A *\0A * Parameters should be named X_public where X is the name of the\0A * corresponding input parameter.\0A *\0A * Implementation should always check using\0A *  if (X_public == MBEDTLS_MPI_IS_PUBLIC) {\0A *      // unsafe path\0A *  } else {\0A *      // safe path\0A *  }\0A * not the other way round, in order to prevent misuse. (That is, if a value\0A * other than the two below is passed, default to the safe path.)\0A *\0A * The value of MBEDTLS_MPI_IS_PUBLIC is chosen in a way that is unlikely to happen by accident, but\0A * which can be used as an immediate value in a Thumb2 comparison (for code size). */\0A#define MBEDTLS_MPI_IS_PUBLIC  0x2a2a2a2a\0A#define MBEDTLS_MPI_IS_SECRET  0\0A#if defined(MBEDTLS_TEST_HOOKS) && !defined(MBEDTLS_THREADING_C)\0A// Default value for testing that is neither MBEDTLS_MPI_IS_PUBLIC nor MBEDTLS_MPI_IS_SECRET\0A#define MBEDTLS_MPI_IS_TEST  1\0A#endif\0A\0A/** Count leading zero bits in a given integer.\0A *\0A * \5Cwarning     The result is undefined if \5Cp a == 0\0A *\0A * \5Cparam a     Integer to count leading zero bits.\0A *\0A * \5Creturn      The number of leading zero bits in \5Cp a, if \5Cp a != 0.\0A *              If \5Cp a == 0, the result is undefined.\0A */\0Asize_t mbedtls_mpi_core_clz(mbedtls_mpi_uint a);\0A\0A/** Return the minimum number of bits required to represent the value held\0A * in the MPI.\0A *\0A * \5Cnote This function returns 0 if all the limbs of \5Cp A are 0.\0A *\0A * \5Cparam[in] A     The address of the MPI.\0A * \5Cparam A_limbs   The number of limbs of \5Cp A.\0A *\0A * \5Creturn      The number of bits in \5Cp A.\0A */\0Asize_t mbedtls_mpi_core_bitlen(const mbedtls_mpi_uint *A, size_t A_limbs);\0A\0A/** Convert a big-endian byte array aligned to the size of mbedtls_mpi_uint\0A * into the storage form used by mbedtls_mpi.\0A *\0A * \5Cparam[in,out] A     The address of the MPI.\0A * \5Cparam A_limbs       The number of limbs of \5Cp A.\0A */\0Avoid mbedtls_mpi_core_bigendian_to_host(mbedtls_mpi_uint *A,\0A                                        size_t A_limbs);\0A\0A/** \5Cbrief         Compare a machine integer with an MPI.\0A *\0A *                 This function operates in constant time with respect\0A *                 to the values of \5Cp min and \5Cp A.\0A *\0A * \5Cparam min      A machine integer.\0A * \5Cparam[in] A    An MPI.\0A * \5Cparam A_limbs  The number of limbs of \5Cp A.\0A *                 This must be at least 1.\0A *\0A * \5Creturn         MBEDTLS_CT_TRUE if \5Cp min is less than or equal to \5Cp A, otherwise MBEDTLS_CT_FALSE.\0A */\0Ambedtls_ct_condition_t mbedtls_mpi_core_uint_le_mpi(mbedtls_mpi_uint min,\0A                                                    const mbedtls_mpi_uint *A,\0A                                                    size_t A_limbs);\0A\0A/**\0A * \5Cbrief          Check if one unsigned MPI is less than another in constant\0A *                 time.\0A *\0A * \5Cparam A        The left-hand MPI. This must point to an array of limbs\0A *                 with the same allocated length as \5Cp B.\0A * \5Cparam B        The right-hand MPI. This must point to an array of limbs\0A *                 with the same allocated length as \5Cp A.\0A * \5Cparam limbs    The number of limbs in \5Cp A and \5Cp B.\0A *                 This must not be 0.\0A *\0A * \5Creturn         MBEDTLS_CT_TRUE  if \5Cp A is less than \5Cp B.\0A *                 MBEDTLS_CT_FALSE if \5Cp A is greater than or equal to \5Cp B.\0A */\0Ambedtls_ct_condition_t mbedtls_mpi_core_lt_ct(const mbedtls_mpi_uint *A,\0A                                              const mbedtls_mpi_uint *B,\0A                                              size_t limbs);\0A\0A/**\0A * \5Cbrief   Perform a safe conditional copy of an MPI which doesn't reveal\0A *          whether assignment was done or not.\0A *\0A * \5Cparam[out] X        The address of the destination MPI.\0A *                      This must be initialized. Must have enough limbs to\0A *                      store the full value of \5Cp A.\0A * \5Cparam[in]  A        The address of the source MPI. This must be initialized.\0A * \5Cparam      limbs    The number of limbs of \5Cp A.\0A * \5Cparam      assign   The condition deciding whether to perform the\0A *                      assignment or not. Callers will need to use\0A *                      the constant time interface (e.g. `mbedtls_ct_bool()`)\0A *                      to construct this argument.\0A *\0A * \5Cnote           This function avoids leaking any information about whether\0A *                 the assignment was done or not.\0A */\0Avoid mbedtls_mpi_core_cond_assign(mbedtls_mpi_uint *X,\0A                                  const mbedtls_mpi_uint *A,\0A                                  size_t limbs,\0A                                  mbedtls_ct_condition_t assign);\0A\0A/**\0A * \5Cbrief   Perform a safe conditional swap of two MPIs which doesn't reveal\0A *          whether the swap was done or not.\0A *\0A * \5Cparam[in,out] X         The address of the first MPI.\0A *                          This must be initialized.\0A * \5Cparam[in,out] Y         The address of the second MPI.\0A *                          This must be initialized.\0A * \5Cparam         limbs     The number of limbs of \5Cp X and \5Cp Y.\0A * \5Cparam         swap      The condition deciding whether to perform\0A *                          the swap or not.\0A *\0A * \5Cnote           This function avoids leaking any information about whether\0A *                 the swap was done or not.\0A */\0Avoid mbedtls_mpi_core_cond_swap(mbedtls_mpi_uint *X,\0A                                mbedtls_mpi_uint *Y,\0A                                size_t limbs,\0A                                mbedtls_ct_condition_t swap);\0A\0A/** Import X from unsigned binary data, little-endian.\0A *\0A * The MPI needs to have enough limbs to store the full value (including any\0A * most significant zero bytes in the input).\0A *\0A * \5Cparam[out] X         The address of the MPI.\0A * \5Cparam X_limbs        The number of limbs of \5Cp X.\0A * \5Cparam[in] input      The input buffer to import from.\0A * \5Cparam input_length   The length bytes of \5Cp input.\0A *\0A * \5Creturn       \5Cc 0 if successful.\0A * \5Creturn       #MBEDTLS_ERR_MPI_BUFFER_TOO_SMALL if \5Cp X isn't\0A *               large enough to hold the value in \5Cp input.\0A */\0Aint mbedtls_mpi_core_read_le(mbedtls_mpi_uint *X,\0A                             size_t X_limbs,\0A                             const unsigned char *input,\0A                             size_t input_length);\0A\0A/** Import X from unsigned binary data, big-endian.\0A *\0A * The MPI needs to have enough limbs to store the full value (including any\0A * most significant zero bytes in the input).\0A *\0A * \5Cparam[out] X        The address of the MPI.\0A *                      May only be #NULL if \5Cp X_limbs is 0 and \5Cp input_length\0A *                      is 0.\0A * \5Cparam X_limbs       The number of limbs of \5Cp X.\0A * \5Cparam[in] input     The input buffer to import from.\0A *                      May only be #NULL if \5Cp input_length is 0.\0A * \5Cparam input_length  The length in bytes of \5Cp input.\0A *\0A * \5Creturn       \5Cc 0 if successful.\0A * \5Creturn       #MBEDTLS_ERR_MPI_BUFFER_TOO_SMALL if \5Cp X isn't\0A *               large enough to hold the value in \5Cp input.\0A */\0Aint mbedtls_mpi_core_read_be(mbedtls_mpi_uint *X,\0A                             size_t X_limbs,\0A                             const unsigned char *input,\0A                             size_t input_length);\0A\0A/** Export A into unsigned binary data, little-endian.\0A *\0A * \5Cnote If \5Cp output is shorter than \5Cp A the export is still successful if the\0A *       value held in \5Cp A fits in the buffer (that is, if enough of the most\0A *       significant bytes of \5Cp A are 0).\0A *\0A * \5Cparam[in] A         The address of the MPI.\0A * \5Cparam A_limbs       The number of limbs of \5Cp A.\0A * \5Cparam[out] output   The output buffer to export to.\0A * \5Cparam output_length The length in bytes of \5Cp output.\0A *\0A * \5Creturn       \5Cc 0 if successful.\0A * \5Creturn       #MBEDTLS_ERR_MPI_BUFFER_TOO_SMALL if \5Cp output isn't\0A *               large enough to hold the value of \5Cp A.\0A */\0Aint mbedtls_mpi_core_write_le(const mbedtls_mpi_uint *A,\0A                              size_t A_limbs,\0A                              unsigned char *output,\0A                              size_t output_length);\0A\0A/** Export A into unsigned binary data, big-endian.\0A *\0A * \5Cnote If \5Cp output is shorter than \5Cp A the export is still successful if the\0A *       value held in \5Cp A fits in the buffer (that is, if enough of the most\0A *       significant bytes of \5Cp A are 0).\0A *\0A * \5Cparam[in] A         The address of the MPI.\0A * \5Cparam A_limbs       The number of limbs of \5Cp A.\0A * \5Cparam[out] output   The output buffer to export to.\0A * \5Cparam output_length The length in bytes of \5Cp output.\0A *\0A * \5Creturn       \5Cc 0 if successful.\0A * \5Creturn       #MBEDTLS_ERR_MPI_BUFFER_TOO_SMALL if \5Cp output isn't\0A *               large enough to hold the value of \5Cp A.\0A */\0Aint mbedtls_mpi_core_write_be(const mbedtls_mpi_uint *A,\0A                              size_t A_limbs,\0A                              unsigned char *output,\0A                              size_t output_length);\0A\0A/** \5Cbrief              Shift an MPI in-place right by a number of bits.\0A *\0A *                      Shifting by more bits than there are bit positions\0A *                      in \5Cp X is valid and results in setting \5Cp X to 0.\0A *\0A *                      This function's execution time depends on the value\0A *                      of \5Cp count (and of course \5Cp limbs).\0A *\0A * \5Cparam[in,out] X     The number to shift.\0A * \5Cparam limbs         The number of limbs of \5Cp X. This must be at least 1.\0A * \5Cparam count         The number of bits to shift by.\0A */\0Avoid mbedtls_mpi_core_shift_r(mbedtls_mpi_uint *X, size_t limbs,\0A                              size_t count);\0A\0A/**\0A * \5Cbrief               Shift an MPI in-place left by a number of bits.\0A *\0A *                      Shifting by more bits than there are bit positions\0A *                      in \5Cp X will produce an unspecified result.\0A *\0A *                      This function's execution time depends on the value\0A *                      of \5Cp count (and of course \5Cp limbs).\0A * \5Cparam[in,out] X     The number to shift.\0A * \5Cparam limbs         The number of limbs of \5Cp X. This must be at least 1.\0A * \5Cparam count         The number of bits to shift by.\0A */\0Avoid mbedtls_mpi_core_shift_l(mbedtls_mpi_uint *X, size_t limbs,\0A                              size_t count);\0A\0A/**\0A * \5Cbrief Add two fixed-size large unsigned integers, returning the carry.\0A *\0A * Calculates `A + B` where `A` and `B` have the same size.\0A *\0A * This function operates modulo `2^(biL*limbs)` and returns the carry\0A * (1 if there was a wraparound, and 0 otherwise).\0A *\0A * \5Cp X may be aliased to \5Cp A or \5Cp B.\0A *\0A * \5Cparam[out] X    The result of the addition.\0A * \5Cparam[in] A     Little-endian presentation of the left operand.\0A * \5Cparam[in] B     Little-endian presentation of the right operand.\0A * \5Cparam limbs     Number of limbs of \5Cp X, \5Cp A and \5Cp B.\0A *\0A * \5Creturn          1 if `A + B >= 2^(biL*limbs)`, 0 otherwise.\0A */\0Ambedtls_mpi_uint mbedtls_mpi_core_add(mbedtls_mpi_uint *X,\0A                                      const mbedtls_mpi_uint *A,\0A                                      const mbedtls_mpi_uint *B,\0A                                      size_t limbs);\0A\0A/**\0A * \5Cbrief Conditional addition of two fixed-size large unsigned integers,\0A *        returning the carry.\0A *\0A * Functionally equivalent to\0A *\0A * ```\0A * if( cond )\0A *    X += A;\0A * return carry;\0A * ```\0A *\0A * This function operates modulo `2^(biL*limbs)`.\0A *\0A * \5Cparam[in,out] X  The pointer to the (little-endian) array\0A *                   representing the bignum to accumulate onto.\0A * \5Cparam[in] A      The pointer to the (little-endian) array\0A *                   representing the bignum to conditionally add\0A *                   to \5Cp X. This may be aliased to \5Cp X but may not\0A *                   overlap otherwise.\0A * \5Cparam limbs      Number of limbs of \5Cp X and \5Cp A.\0A * \5Cparam cond       Condition bit dictating whether addition should\0A *                   happen or not. This must be \5Cc 0 or \5Cc 1.\0A *\0A * \5Cwarning          If \5Cp cond is neither 0 nor 1, the result of this function\0A *                   is unspecified, and the resulting value in \5Cp X might be\0A *                   neither its original value nor \5Cp X + \5Cp A.\0A *\0A * \5Creturn           1 if `X + cond * A >= 2^(biL*limbs)`, 0 otherwise.\0A */\0Ambedtls_mpi_uint mbedtls_mpi_core_add_if(mbedtls_mpi_uint *X,\0A                                         const mbedtls_mpi_uint *A,\0A                                         size_t limbs,\0A                                         unsigned cond);\0A\0A/**\0A * \5Cbrief Subtract two fixed-size large unsigned integers, returning the borrow.\0A *\0A * Calculate `A - B` where \5Cp A and \5Cp B have the same size.\0A * This function operates modulo `2^(biL*limbs)` and returns the carry\0A * (1 if there was a wraparound, i.e. if `A < B`, and 0 otherwise).\0A *\0A * \5Cp X may be aliased to \5Cp A or \5Cp B, or even both, but may not overlap\0A * either otherwise.\0A *\0A * \5Cparam[out] X    The result of the subtraction.\0A * \5Cparam[in] A     Little-endian presentation of left operand.\0A * \5Cparam[in] B     Little-endian presentation of right operand.\0A * \5Cparam limbs     Number of limbs of \5Cp X, \5Cp A and \5Cp B.\0A *\0A * \5Creturn          1 if `A < B`.\0A *                  0 if `A >= B`.\0A */\0Ambedtls_mpi_uint mbedtls_mpi_core_sub(mbedtls_mpi_uint *X,\0A                                      const mbedtls_mpi_uint *A,\0A                                      const mbedtls_mpi_uint *B,\0A                                      size_t limbs);\0A\0A/**\0A * \5Cbrief Perform a fixed-size multiply accumulate operation: X += b * A\0A *\0A * \5Cp X may be aliased to \5Cp A (when \5Cp X_limbs == \5Cp A_limbs), but may not\0A * otherwise overlap.\0A *\0A * This function operates modulo `2^(biL*X_limbs)`.\0A *\0A * \5Cparam[in,out] X  The pointer to the (little-endian) array\0A *                   representing the bignum to accumulate onto.\0A * \5Cparam X_limbs    The number of limbs of \5Cp X. This must be\0A *                   at least \5Cp A_limbs.\0A * \5Cparam[in] A      The pointer to the (little-endian) array\0A *                   representing the bignum to multiply with.\0A *                   This may be aliased to \5Cp X but may not overlap\0A *                   otherwise.\0A * \5Cparam A_limbs    The number of limbs of \5Cp A.\0A * \5Cparam b          X scalar to multiply with.\0A *\0A * \5Creturn           The carry at the end of the operation.\0A */\0Ambedtls_mpi_uint mbedtls_mpi_core_mla(mbedtls_mpi_uint *X, size_t X_limbs,\0A                                      const mbedtls_mpi_uint *A, size_t A_limbs,\0A                                      mbedtls_mpi_uint b);\0A\0A/**\0A * \5Cbrief Perform a known-size multiplication\0A *\0A * \5Cp X may not be aliased to any of the inputs for this function.\0A * \5Cp A may be aliased to \5Cp B.\0A *\0A * \5Cparam[out] X     The pointer to the (little-endian) array to receive\0A *                   the product of \5Cp A_limbs and \5Cp B_limbs.\0A *                   This must be of length \5Cp A_limbs + \5Cp B_limbs.\0A * \5Cparam[in] A      The pointer to the (little-endian) array\0A *                   representing the first factor.\0A * \5Cparam A_limbs    The number of limbs in \5Cp A.\0A * \5Cparam[in] B      The pointer to the (little-endian) array\0A *                   representing the second factor.\0A * \5Cparam B_limbs    The number of limbs in \5Cp B.\0A */\0Avoid mbedtls_mpi_core_mul(mbedtls_mpi_uint *X,\0A                          const mbedtls_mpi_uint *A, size_t A_limbs,\0A                          const mbedtls_mpi_uint *B, size_t B_limbs);\0A\0A/**\0A * \5Cbrief Calculate initialisation value for fast Montgomery modular\0A *        multiplication\0A *\0A * \5Cparam[in] N  Little-endian presentation of the modulus. This must have\0A *               at least one limb.\0A *\0A * \5Creturn       The initialisation value for fast Montgomery modular multiplication\0A */\0Ambedtls_mpi_uint mbedtls_mpi_core_montmul_init(const mbedtls_mpi_uint *N);\0A\0A/**\0A * \5Cbrief Montgomery multiplication: X = A * B * R^-1 mod N (HAC 14.36)\0A *\0A * \5Cp A and \5Cp B must be in canonical form. That is, < \5Cp N.\0A *\0A * \5Cp X may be aliased to \5Cp A or \5Cp N, or even \5Cp B (if \5Cp AN_limbs ==\0A * \5Cp B_limbs) but may not overlap any parameters otherwise.\0A *\0A * \5Cp A and \5Cp B may alias each other, if \5Cp AN_limbs == \5Cp B_limbs. They may\0A * not alias \5Cp N (since they must be in canonical form, they cannot == \5Cp N).\0A *\0A * \5Cparam[out]    X         The destination MPI, as a little-endian array of\0A *                          length \5Cp AN_limbs.\0A *                          On successful completion, X contains the result of\0A *                          the multiplication `A * B * R^-1` mod N where\0A *                          `R = 2^(biL*AN_limbs)`.\0A * \5Cparam[in]     A         Little-endian presentation of first operand.\0A *                          Must have the same number of limbs as \5Cp N.\0A * \5Cparam[in]     B         Little-endian presentation of second operand.\0A * \5Cparam[in]     B_limbs   The number of limbs in \5Cp B.\0A *                          Must be <= \5Cp AN_limbs.\0A * \5Cparam[in]     N         Little-endian presentation of the modulus.\0A *                          This must be odd, and have exactly the same number\0A *                          of limbs as \5Cp A.\0A *                          It may alias \5Cp X, but must not alias or otherwise\0A *                          overlap any of the other parameters.\0A * \5Cparam[in]     AN_limbs  The number of limbs in \5Cp X, \5Cp A and \5Cp N.\0A * \5Cparam         mm        The Montgomery constant for \5Cp N: -N^-1 mod 2^biL.\0A *                          This can be calculated by `mbedtls_mpi_core_montmul_init()`.\0A * \5Cparam[in,out] T         Temporary storage of size at least 2*AN_limbs+1 limbs.\0A *                          Its initial content is unused and\0A *                          its final content is indeterminate.\0A *                          It must not alias or otherwise overlap any of the\0A *                          other parameters.\0A */\0Avoid mbedtls_mpi_core_montmul(mbedtls_mpi_uint *X,\0A                              const mbedtls_mpi_uint *A,\0A                              const mbedtls_mpi_uint *B, size_t B_limbs,\0A                              const mbedtls_mpi_uint *N, size_t AN_limbs,\0A                              mbedtls_mpi_uint mm, mbedtls_mpi_uint *T);\0A\0A/**\0A * \5Cbrief Calculate the square of the Montgomery constant. (Needed\0A *        for conversion and operations in Montgomery form.)\0A *\0A * \5Cparam[out] X  A pointer to the result of the calculation of\0A *                the square of the Montgomery constant:\0A *                2^{2*n*biL} mod N.\0A * \5Cparam[in]  N  Little-endian presentation of the modulus, which must be odd.\0A *\0A * \5Creturn        0 if successful.\0A * \5Creturn        #MBEDTLS_ERR_MPI_ALLOC_FAILED if there is not enough space\0A *                to store the value of Montgomery constant squared.\0A * \5Creturn        #MBEDTLS_ERR_MPI_DIVISION_BY_ZERO if \5Cp N modulus is zero.\0A * \5Creturn        #MBEDTLS_ERR_MPI_NEGATIVE_VALUE if \5Cp N modulus is negative.\0A */\0Aint mbedtls_mpi_core_get_mont_r2_unsafe(mbedtls_mpi *X,\0A                                        const mbedtls_mpi *N);\0A\0A#if defined(MBEDTLS_TEST_HOOKS)\0A/**\0A * Copy an MPI from a table without leaking the index.\0A *\0A * \5Cparam dest              The destination buffer. This must point to a writable\0A *                          buffer of at least \5Cp limbs limbs.\0A * \5Cparam table             The address of the table. This must point to a readable\0A *                          array of \5Cp count elements of \5Cp limbs limbs each.\0A * \5Cparam limbs             The number of limbs in each table entry.\0A * \5Cparam count             The number of entries in \5Cp table.\0A * \5Cparam index             The (secret) table index to look up. This must be in the\0A *                          range `0 .. count-1`.\0A */\0Avoid mbedtls_mpi_core_ct_uint_table_lookup(mbedtls_mpi_uint *dest,\0A                                           const mbedtls_mpi_uint *table,\0A                                           size_t limbs,\0A                                           size_t count,\0A                                           size_t index);\0A#endif /* MBEDTLS_TEST_HOOKS */\0A\0A/**\0A * \5Cbrief          Fill an integer with a number of random bytes.\0A *\0A * \5Cparam X        The destination MPI.\0A * \5Cparam X_limbs  The number of limbs of \5Cp X.\0A * \5Cparam bytes    The number of random bytes to generate.\0A * \5Cparam f_rng    The RNG function to use. This must not be \5Cc NULL.\0A * \5Cparam p_rng    The RNG parameter to be passed to \5Cp f_rng. This may be\0A *                 \5Cc NULL if \5Cp f_rng doesn't need a context argument.\0A *\0A * \5Creturn         \5Cc 0 if successful.\0A * \5Creturn         #MBEDTLS_ERR_MPI_BAD_INPUT_DATA if \5Cp X does not have\0A *                 enough room for \5Cp bytes bytes.\0A * \5Creturn         A negative error code on RNG failure.\0A *\0A * \5Cnote           The bytes obtained from the RNG are interpreted\0A *                 as a big-endian representation of an MPI; this can\0A *                 be relevant in applications like deterministic ECDSA.\0A */\0Aint mbedtls_mpi_core_fill_random(mbedtls_mpi_uint *X, size_t X_limbs,\0A                                 size_t bytes,\0A                                 int (*f_rng)(void *, unsigned char *, size_t),\0A                                 void *p_rng);\0A\0A/** Generate a random number uniformly in a range.\0A *\0A * This function generates a random number between \5Cp min inclusive and\0A * \5Cp N exclusive.\0A *\0A * The procedure complies with RFC 6979 §3.3 (deterministic ECDSA)\0A * when the RNG is a suitably parametrized instance of HMAC_DRBG\0A * and \5Cp min is \5Cc 1.\0A *\0A * \5Cnote           There are `N - min` possible outputs. The lower bound\0A *                 \5Cp min can be reached, but the upper bound \5Cp N cannot.\0A *\0A * \5Cparam X        The destination MPI, with \5Cp limbs limbs.\0A *                 It must not be aliased with \5Cp N or otherwise overlap it.\0A * \5Cparam min      The minimum value to return.\0A * \5Cparam N        The upper bound of the range, exclusive, with \5Cp limbs limbs.\0A *                 In other words, this is one plus the maximum value to return.\0A *                 \5Cp N must be strictly larger than \5Cp min.\0A * \5Cparam limbs    The number of limbs of \5Cp N and \5Cp X.\0A *                 This must not be 0.\0A * \5Cparam f_rng    The RNG function to use. This must not be \5Cc NULL.\0A * \5Cparam p_rng    The RNG parameter to be passed to \5Cp f_rng.\0A *\0A * \5Creturn         \5Cc 0 if successful.\0A * \5Creturn         #MBEDTLS_ERR_MPI_NOT_ACCEPTABLE if the implementation was\0A *                 unable to find a suitable value within a limited number\0A *                 of attempts. This has a negligible probability if \5Cp N\0A *                 is significantly larger than \5Cp min, which is the case\0A *                 for all usual cryptographic applications.\0A */\0Aint mbedtls_mpi_core_random(mbedtls_mpi_uint *X,\0A                            mbedtls_mpi_uint min,\0A                            const mbedtls_mpi_uint *N,\0A                            size_t limbs,\0A                            int (*f_rng)(void *, unsigned char *, size_t),\0A                            void *p_rng);\0A\0A/**\0A * \5Cbrief          Returns the number of limbs of working memory required for\0A *                 a call to `mbedtls_mpi_core_exp_mod()`.\0A *\0A * \5Cnote           This will always be at least\0A *                 `mbedtls_mpi_core_montmul_working_limbs(AN_limbs)`,\0A *                 i.e. sufficient for a call to `mbedtls_mpi_core_montmul()`.\0A *\0A * \5Cparam AN_limbs The number of limbs in the input `A` and the modulus `N`\0A *                 (they must be the same size) that will be given to\0A *                 `mbedtls_mpi_core_exp_mod()`.\0A * \5Cparam E_limbs  The number of limbs in the exponent `E` that will be given\0A *                 to `mbedtls_mpi_core_exp_mod()`.\0A *\0A * \5Creturn         The number of limbs of working memory required by\0A *                 `mbedtls_mpi_core_exp_mod()`.\0A */\0Asize_t mbedtls_mpi_core_exp_mod_working_limbs(size_t AN_limbs, size_t E_limbs);\0A\0A/**\0A * \5Cbrief            Perform a modular exponentiation with public or secret exponent:\0A *                   X = A^E mod N, where \5Cp A is already in Montgomery form.\0A *\0A * \5Cwarning          This function is not constant time with respect to \5Cp E (the exponent).\0A *\0A * \5Cp X may be aliased to \5Cp A, but not to \5Cp RR or \5Cp E, even if \5Cp E_limbs ==\0A * \5Cp AN_limbs.\0A *\0A * \5Cparam[out] X     The destination MPI, as a little endian array of length\0A *                   \5Cp AN_limbs.\0A * \5Cparam[in] A      The base MPI, as a little endian array of length \5Cp AN_limbs.\0A *                   Must be in Montgomery form.\0A * \5Cparam[in] N      The modulus, as a little endian array of length \5Cp AN_limbs.\0A * \5Cparam AN_limbs   The number of limbs in \5Cp X, \5Cp A, \5Cp N, \5Cp RR.\0A * \5Cparam[in] E      The exponent, as a little endian array of length \5Cp E_limbs.\0A * \5Cparam E_limbs    The number of limbs in \5Cp E.\0A * \5Cparam[in] RR     The precomputed residue of 2^{2*biL} modulo N, as a little\0A *                   endian array of length \5Cp AN_limbs.\0A * \5Cparam[in,out] T  Temporary storage of at least the number of limbs returned\0A *                   by `mbedtls_mpi_core_exp_mod_working_limbs()`.\0A *                   Its initial content is unused and its final content is\0A *                   indeterminate.\0A *                   It must not alias or otherwise overlap any of the other\0A *                   parameters.\0A *                   It is up to the caller to zeroize \5Cp T when it is no\0A *                   longer needed, and before freeing it if it was dynamically\0A *                   allocated.\0A */\0Avoid mbedtls_mpi_core_exp_mod_unsafe(mbedtls_mpi_uint *X,\0A                                     const mbedtls_mpi_uint *A,\0A                                     const mbedtls_mpi_uint *N, size_t AN_limbs,\0A                                     const mbedtls_mpi_uint *E, size_t E_limbs,\0A                                     const mbedtls_mpi_uint *RR,\0A                                     mbedtls_mpi_uint *T);\0A\0A/**\0A * \5Cbrief            Perform a modular exponentiation with secret exponent:\0A *                   X = A^E mod N, where \5Cp A is already in Montgomery form.\0A *\0A * \5Cp X may be aliased to \5Cp A, but not to \5Cp RR or \5Cp E, even if \5Cp E_limbs ==\0A * \5Cp AN_limbs.\0A *\0A * \5Cparam[out] X     The destination MPI, as a little endian array of length\0A *                   \5Cp AN_limbs.\0A * \5Cparam[in] A      The base MPI, as a little endian array of length \5Cp AN_limbs.\0A *                   Must be in Montgomery form.\0A * \5Cparam[in] N      The modulus, as a little endian array of length \5Cp AN_limbs.\0A * \5Cparam AN_limbs   The number of limbs in \5Cp X, \5Cp A, \5Cp N, \5Cp RR.\0A * \5Cparam[in] E      The exponent, as a little endian array of length \5Cp E_limbs.\0A * \5Cparam E_limbs    The number of limbs in \5Cp E.\0A * \5Cparam[in] RR     The precomputed residue of 2^{2*biL} modulo N, as a little\0A *                   endian array of length \5Cp AN_limbs.\0A * \5Cparam[in,out] T  Temporary storage of at least the number of limbs returned\0A *                   by `mbedtls_mpi_core_exp_mod_working_limbs()`.\0A *                   Its initial content is unused and its final content is\0A *                   indeterminate.\0A *                   It must not alias or otherwise overlap any of the other\0A *                   parameters.\0A *                   It is up to the caller to zeroize \5Cp T when it is no\0A *                   longer needed, and before freeing it if it was dynamically\0A *                   allocated.\0A */\0Avoid mbedtls_mpi_core_exp_mod(mbedtls_mpi_uint *X,\0A                              const mbedtls_mpi_uint *A,\0A                              const mbedtls_mpi_uint *N, size_t AN_limbs,\0A                              const mbedtls_mpi_uint *E, size_t E_limbs,\0A                              const mbedtls_mpi_uint *RR,\0A                              mbedtls_mpi_uint *T);\0A\0A/**\0A * \5Cbrief Subtract unsigned integer from known-size large unsigned integers.\0A *        Return the borrow.\0A *\0A * \5Cparam[out] X    The result of the subtraction.\0A * \5Cparam[in] A     The left operand.\0A * \5Cparam b         The unsigned scalar to subtract.\0A * \5Cparam limbs     Number of limbs of \5Cp X and \5Cp A.\0A *\0A * \5Creturn          1 if `A < b`.\0A *                  0 if `A >= b`.\0A */\0Ambedtls_mpi_uint mbedtls_mpi_core_sub_int(mbedtls_mpi_uint *X,\0A                                          const mbedtls_mpi_uint *A,\0A                                          mbedtls_mpi_uint b,\0A                                          size_t limbs);\0A\0A/**\0A * \5Cbrief Determine if a given MPI has the value \5Cc 0 in constant time with\0A *        respect to the value (but not with respect to the number of limbs).\0A *\0A * \5Cparam[in] A   The MPI to test.\0A * \5Cparam limbs   Number of limbs in \5Cp A.\0A *\0A * \5Creturn        MBEDTLS_CT_FALSE if `A == 0`\0A *                MBEDTLS_CT_TRUE  if `A != 0`.\0A */\0Ambedtls_ct_condition_t mbedtls_mpi_core_check_zero_ct(const mbedtls_mpi_uint *A,\0A                                                      size_t limbs);\0A\0A/**\0A * \5Cbrief          Returns the number of limbs of working memory required for\0A *                 a call to `mbedtls_mpi_core_montmul()`.\0A *\0A * \5Cparam AN_limbs The number of limbs in the input `A` and the modulus `N`\0A *                 (they must be the same size) that will be given to\0A *                 `mbedtls_mpi_core_montmul()` or one of the other functions\0A *                 that specifies this as the amount of working memory needed.\0A *\0A * \5Creturn         The number of limbs of working memory required by\0A *                 `mbedtls_mpi_core_montmul()` (or other similar function).\0A */\0Astatic inline size_t mbedtls_mpi_core_montmul_working_limbs(size_t AN_limbs)\0A{\0A    return 2 * AN_limbs + 1;\0A}\0A\0A/** Convert an MPI into Montgomery form.\0A *\0A * \5Cp X may be aliased to \5Cp A, but may not otherwise overlap it.\0A *\0A * \5Cp X may not alias \5Cp N (it is in canonical form, so must be strictly less\0A * than \5Cp N). Nor may it alias or overlap \5Cp rr (this is unlikely to be\0A * required in practice.)\0A *\0A * This function is a thin wrapper around `mbedtls_mpi_core_montmul()` that is\0A * an alternative to calling `mbedtls_mpi_mod_raw_to_mont_rep()` when we\0A * don't want to allocate memory.\0A *\0A * \5Cparam[out]    X         The result of the conversion.\0A *                          Must have the same number of limbs as \5Cp A.\0A * \5Cparam[in]     A         The MPI to convert into Montgomery form.\0A *                          Must have the same number of limbs as the modulus.\0A * \5Cparam[in]     N         The address of the modulus, which gives the size of\0A *                          the base `R` = 2^(biL*N->limbs).\0A * \5Cparam[in]     AN_limbs  The number of limbs in \5Cp X, \5Cp A, \5Cp N and \5Cp rr.\0A * \5Cparam         mm        The Montgomery constant for \5Cp N: -N^-1 mod 2^biL.\0A *                          This can be determined by calling\0A *                          `mbedtls_mpi_core_montmul_init()`.\0A * \5Cparam[in]     rr        The residue for `2^{2*n*biL} mod N`.\0A * \5Cparam[in,out] T         Temporary storage of size at least\0A *                          `mbedtls_mpi_core_montmul_working_limbs(AN_limbs)`\0A *                          limbs.\0A *                          Its initial content is unused and\0A *                          its final content is indeterminate.\0A *                          It must not alias or otherwise overlap any of the\0A *                          other parameters.\0A */\0Avoid mbedtls_mpi_core_to_mont_rep(mbedtls_mpi_uint *X,\0A                                  const mbedtls_mpi_uint *A,\0A                                  const mbedtls_mpi_uint *N,\0A                                  size_t AN_limbs,\0A                                  mbedtls_mpi_uint mm,\0A                                  const mbedtls_mpi_uint *rr,\0A                                  mbedtls_mpi_uint *T);\0A\0A/** Convert an MPI from Montgomery form.\0A *\0A * \5Cp X may be aliased to \5Cp A, but may not otherwise overlap it.\0A *\0A * \5Cp X may not alias \5Cp N (it is in canonical form, so must be strictly less\0A * than \5Cp N).\0A *\0A * This function is a thin wrapper around `mbedtls_mpi_core_montmul()` that is\0A * an alternative to calling `mbedtls_mpi_mod_raw_from_mont_rep()` when we\0A * don't want to allocate memory.\0A *\0A * \5Cparam[out]    X         The result of the conversion.\0A *                          Must have the same number of limbs as \5Cp A.\0A * \5Cparam[in]     A         The MPI to convert from Montgomery form.\0A *                          Must have the same number of limbs as the modulus.\0A * \5Cparam[in]     N         The address of the modulus, which gives the size of\0A *                          the base `R` = 2^(biL*N->limbs).\0A * \5Cparam[in]     AN_limbs  The number of limbs in \5Cp X, \5Cp A and \5Cp N.\0A * \5Cparam         mm        The Montgomery constant for \5Cp N: -N^-1 mod 2^biL.\0A *                          This can be determined by calling\0A *                          `mbedtls_mpi_core_montmul_init()`.\0A * \5Cparam[in,out] T         Temporary storage of size at least\0A *                          `mbedtls_mpi_core_montmul_working_limbs(AN_limbs)`\0A *                          limbs.\0A *                          Its initial content is unused and\0A *                          its final content is indeterminate.\0A *                          It must not alias or otherwise overlap any of the\0A *                          other parameters.\0A */\0Avoid mbedtls_mpi_core_from_mont_rep(mbedtls_mpi_uint *X,\0A                                    const mbedtls_mpi_uint *A,\0A                                    const mbedtls_mpi_uint *N,\0A                                    size_t AN_limbs,\0A                                    mbedtls_mpi_uint mm,\0A                                    mbedtls_mpi_uint *T);\0A\0A#endif /* MBEDTLS_BIGNUM_CORE_H */\0A\00" }
