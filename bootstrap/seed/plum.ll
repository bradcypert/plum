IGHT */\0A\0A#if defined(MBEDTLS_PK_USE_PSA_EC_DATA)\0Astatic void mbedtls_debug_print_ec_coord(const mbedtls_ssl_context *ssl, int level,\0A                                         const char *file, int line, const char *text,\0A                                         const unsigned char *buf, size_t len)\0A{\0A    char str[DEBUG_BUF_SIZE];\0A    size_t i, idx = 0;\0A\0A    mbedtls_snprintf(str + idx, sizeof(str) - idx, \22value of '%s' (%u bits) is:\5Cn\22,\0A                     text, (unsigned int) len * 8);\0A\0A    debug_send_line(ssl, level, file, line, str);\0A\0A    for (i = 0; i < len; i++) {\0A        if (i >= 4096) {\0A            break;\0A        }\0A\0A        if (i % 16 == 0) {\0A            if (i > 0) {\0A                mbedtls_snprintf(str + idx, sizeof(str) - idx, \22\5Cn\22);\0A                debug_send_line(ssl, level, file, line, str);\0A\0A                idx = 0;\0A            }\0A        }\0A\0A        idx += mbedtls_snprintf(str + idx, sizeof(str) - idx, \22 %02x\22,\0A                                (unsigned int) buf[i]);\0A    }\0A\0A    if (len > 0) {\0A        for (/* i = i */; i % 16 != 0; i++) {\0A            idx += mbedtls_snprintf(str + idx, sizeof(str) - idx, \22   \22);\0A        }\0A\0A        mbedtls_snprintf(str + idx, sizeof(str) - idx, \22\5Cn\22);\0A        debug_send_line(ssl, level, file, line, str);\0A    }\0A}\0A\0Avoid mbedtls_debug_print_psa_ec(const mbedtls_ssl_context *ssl, int level,\0A                                const char *file, int line,\0A                                const char *text, const mbedtls_pk_context *pk)\0A{\0A    char str[DEBUG_BUF_SIZE];\0A    const uint8_t *coord_start;\0A    size_t coord_len;\0A\0A    if (NULL == ssl              ||\0A        NULL == ssl->conf        ||\0A        NULL == ssl->conf->f_dbg ||\0A        level > debug_threshold) {\0A        return;\0A    }\0A\0A    /* For the description of pk->pk_raw content please refer to the description\0A     * psa_export_public_key() function. */\0A    coord_len = (pk->pub_raw_len - 1)/2;\0A\0A    /* X coordinate */\0A    coord_start = pk->pub_raw + 1;\0A    mbedtls_snprintf(str, sizeof(str), \22%s(X)\22, text);\0A    mbedtls_debug_print_ec_coord(ssl, level, file, line, str, coord_start, coord_len);\0A\0A    /* Y coordinate */\0A    coord_start = coord_start + coord_len;\0A    mbedtls_snprintf(str, sizeof(str), \22%s(Y)\22, text);\0A    mbedtls_debug_print_ec_coord(ssl, level, file, line, str, coord_start, coord_len);\0A}\0A#endif /* MBEDTLS_PK_USE_PSA_EC_DATA */\0A\0A#if defined(MBEDTLS_BIGNUM_C)\0Avoid mbedtls_debug_print_mpi(const mbedtls_ssl_context *ssl, int level,\0A                             const char *file, int line,\0A                             const char *text, const mbedtls_mpi *X)\0A{\0A    char str[DEBUG_BUF_SIZE];\0A    size_t bitlen;\0A    size_t idx = 0;\0A\0A    if (NULL == ssl              ||\0A        NULL == ssl->conf        ||\0A        NULL == ssl->conf->f_dbg ||\0A        NULL == X                ||\0A        level > debug_threshold) {\0A        return;\0A    }\0A\0A    bitlen = mbedtls_mpi_bitlen(X);\0A\0A    mbedtls_snprintf(str, sizeof(str), \22value of '%s' (%u bits) is:\5Cn\22,\0A                     text, (unsigned) bitlen);\0A    debug_send_line(ssl, level, file, line, str);\0A\0A    if (bitlen == 0) {\0A        str[0] = ' '; str[1] = '0'; str[2] = '0';\0A        idx = 3;\0A    } else {\0A        int n;\0A        for (n = (int) ((bitlen - 1) / 8); n >= 0; n--) {\0A            size_t limb_offset = n / sizeof(mbedtls_mpi_uint);\0A            size_t offset_in_limb = n % sizeof(mbedtls_mpi_uint);\0A            unsigned char octet =\0A                (X->p[limb_offset] >> (offset_in_limb * 8)) & 0xff;\0A            mbedtls_snprintf(str + idx, sizeof(str) - idx, \22 %02x\22, octet);\0A            idx += 3;\0A            /* Wrap lines after 16 octets that each take 3 columns */\0A            if (idx >= 3 * 16) {\0A                mbedtls_snprintf(str + idx, sizeof(str) - idx, \22\5Cn\22);\0A                debug_send_line(ssl, level, file, line, str);\0A                idx = 0;\0A            }\0A        }\0A    }\0A\0A    if (idx != 0) {\0A        mbedtls_snprintf(str + idx, sizeof(str) - idx, \22\5Cn\22);\0A        debug_send_line(ssl, level, file, line, str);\0A    }\0A}\0A#endif /* MBEDTLS_BIGNUM_C */\0A\0A#if defined(MBEDTLS_X509_CRT_PARSE_C) && !defined(MBEDTLS_X509_REMOVE_INFO)\0Astatic void debug_print_pk(const mbedtls_ssl_context *ssl, int level,\0A                           const char *file, int line,\0A                           const char *text, const mbedtls_pk_context *pk)\0A{\0A    size_t i;\0A    mbedtls_pk_debug_item items[MBEDTLS_PK_DEBUG_MAX_ITEMS];\0A    char name[16];\0A\0A    memset(items, 0, sizeof(items));\0A\0A    if (mbedtls_pk_debug(pk, items) != 0) {\0A        debug_send_line(ssl, level, file, line,\0A                        \22invalid PK context\5Cn\22);\0A        return;\0A    }\0A\0A    for (i = 0; i < MBEDTLS_PK_DEBUG_MAX_ITEMS; i++) {\0A        if (items[i].type == MBEDTLS_PK_DEBUG_NONE) {\0A            return;\0A        }\0A\0A        mbedtls_snprintf(name, sizeof(name), \22%s%s\22, text, items[i].name);\0A        name[sizeof(name) - 1] = '\5C0';\0A\0A#if defined(MBEDTLS_RSA_C)\0A        if (items[i].type == MBEDTLS_PK_DEBUG_MPI) {\0A            mbedtls_debug_print_mpi(ssl, level, file, line, name, items[i].value);\0A        } else\0A#endif /* MBEDTLS_RSA_C */\0A#if defined(MBEDTLS_ECP_LIGHT)\0A        if (items[i].type == MBEDTLS_PK_DEBUG_ECP) {\0A            mbedtls_debug_print_ecp(ssl, level, file, line, name, items[i].value);\0A        } else\0A#endif /* MBEDTLS_ECP_LIGHT */\0A#if defined(MBEDTLS_PK_USE_PSA_EC_DATA)\0A        if (items[i].type == MBEDTLS_PK_DEBUG_PSA_EC) {\0A            mbedtls_debug_print_psa_ec(ssl, level, file, line, name, items[i].value);\0A        } else\0A#endif /* MBEDTLS_PK_USE_PSA_EC_DATA */\0A        { debug_send_line(ssl, level, file, line,\0A                        