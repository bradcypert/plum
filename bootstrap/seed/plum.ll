@.str46417 = private global { i64, i64, [30129 x i8] } { i64 -1, i64 30128, [30129 x i8] c"/**\0A * \5Cfile md.c\0A *\0A * \5Cbrief Generic message digest wrapper for Mbed TLS\0A *\0A * \5Cauthor Adriaan de Jong <dejong@fox-it.com>\0A *\0A *  Copyright The Mbed TLS Contributors\0A *  SPDX-License-Identifier: Apache-2.0 OR GPL-2.0-or-later\0A */\0A\0A#include \22common.h\22\0A\0A/*\0A * Availability of functions in this module is controlled by two\0A * feature macros:\0A * - MBEDTLS_MD_C enables the whole module;\0A * - MBEDTLS_MD_LIGHT enables only functions for hashing and accessing\0A * most hash metadata (everything except string names); is it\0A * automatically set whenever MBEDTLS_MD_C is defined.\0A *\0A * In this file, functions from MD_LIGHT are at the top, MD_C at the end.\0A *\0A * In the future we may want to change the contract of some functions\0A * (behaviour with NULL arguments) depending on whether MD_C is defined or\0A * only MD_LIGHT. Also, the exact scope of MD_LIGHT might vary.\0A *\0A * For these reasons, we're keeping MD_LIGHT internal for now.\0A */\0A#if defined(MBEDTLS_MD_LIGHT)\0A\0A#include \22mbedtls/md.h\22\0A#include \22md_wrap.h\22\0A#include \22mbedtls/platform_util.h\22\0A#include \22mbedtls/error.h\22\0A\0A#include \22mbedtls/md5.h\22\0A#include \22mbedtls/ripemd160.h\22\0A#include \22mbedtls/sha1.h\22\0A#include \22mbedtls/sha256.h\22\0A#include \22mbedtls/sha512.h\22\0A#include \22mbedtls/sha3.h\22\0A\0A#if defined(MBEDTLS_PSA_CRYPTO_CLIENT)\0A#include <psa/crypto.h>\0A#include \22md_psa.h\22\0A#include \22psa_util_internal.h\22\0A#endif\0A\0A#if defined(MBEDTLS_MD_SOME_PSA)\0A#include \22psa_crypto_core.h\22\0A#endif\0A\0A#include \22mbedtls/platform.h\22\0A\0A#include <string.h>\0A\0A#if defined(MBEDTLS_FS_IO)\0A#include <stdio.h>\0A#endif\0A\0A/* See comment above MBEDTLS_MD_MAX_SIZE in md.h */\0A#if defined(MBEDTLS_PSA_CRYPTO_C) && MBEDTLS_MD_MAX_SIZE < PSA_HASH_MAX_SIZE\0A#error \22Internal error: MBEDTLS_MD_MAX_SIZE < PSA_HASH_MAX_SIZE\22\0A#endif\0A\0A#if defined(MBEDTLS_MD_C)\0A#define MD_INFO(type, out_size, block_size) type, out_size, block_size,\0A#else\0A#define MD_INFO(type, out_size, block_size) type, out_size,\0A#endif\0A\0A#if defined(MBEDTLS_MD_CAN_MD5)\0Astatic const mbedtls_md_info_t mbedtls_md5_info = {\0A    MD_INFO(MBEDTLS_MD_MD5, 16, 64)\0A};\0A#endif\0A\0A#if defined(MBEDTLS_MD_CAN_RIPEMD160)\0Astatic const mbedtls_md_info_t mbedtls_ripemd160_info = {\0A    MD_INFO(MBEDTLS_MD_RIPEMD160, 20, 64)\0A};\0A#endif\0A\0A#if defined(MBEDTLS_MD_CAN_SHA1)\0Astatic const mbedtls_md_info_t mbedtls_sha1_info = {\0A    MD_INFO(MBEDTLS_MD_SHA1, 20, 64)\0A};\0A#endif\0A\0A#if defined(MBEDTLS_MD_CAN_SHA224)\0Astatic const mbedtls_md_info_t mbedtls_sha224_info = {\0A    MD_INFO(MBEDTLS_MD_SHA224, 28, 64)\0A};\0A#endif\0A\0A#if defined(MBEDTLS_MD_CAN_SHA256)\0Astatic const mbedtls_md_info_t mbedtls_sha256_info = {\0A    MD_INFO(MBEDTLS_MD_SHA256, 32, 64)\0A};\0A#endif\0A\0A#if defined(MBEDTLS_MD_CAN_SHA384)\0Astatic const mbedtls_md_info_t mbedtls_sha384_info = {\0A    MD_INFO(MBEDTLS_MD_SHA384, 48, 128)\0A};\0A#endif\0A\0A#if defined(MBEDTLS_MD_CAN_SHA512)\0Astatic const mbedtls_md_info_t mbedtls_sha512_info = {\0A    MD_INFO(MBEDTLS_MD_SHA512, 64, 128)\0A};\0A#endif\0A\0A#if defined(MBEDTLS_MD_CAN_SHA3_224)\0Astatic const mbedtls_md_info_t mbedtls_sha3_224_info = {\0A    MD_INFO(MBEDTLS_MD_SHA3_224, 28, 144)\0A};\0A#endif\0A\0A#if defined(MBEDTLS_MD_CAN_SHA3_256)\0Astatic const mbedtls_md_info_t mbedtls_sha3_256_info = {\0A    MD_INFO(MBEDTLS_MD_SHA3_256, 32, 136)\0A};\0A#endif\0A\0A#if defined(MBEDTLS_MD_CAN_SHA3_384)\0Astatic const mbedtls_md_info_t mbedtls_sha3_384_info = {\0A    MD_INFO(MBEDTLS_MD_SHA3_384, 48, 104)\0A};\0A#endif\0A\0A#if defined(MBEDTLS_MD_CAN_SHA3_512)\0Astatic const mbedtls_md_info_t mbedtls_sha3_512_info = {\0A    MD_INFO(MBEDTLS_MD_SHA3_512, 64, 72)\0A};\0A#endif\0A\0Aconst mbedtls_md_info_t *mbedtls_md_info_from_type(mbedtls_md_type_t md_type)\0A{\0A    switch (md_type) {\0A#if defined(MBEDTLS_MD_CAN_MD5)\0A        case MBEDTLS_MD_MD5:\0A            return &mbedtls_md5_info;\0A#endif\0A#if defined(MBEDTLS_MD_CAN_RIPEMD160)\0A        case MBEDTLS_MD_RIPEMD160:\0A            return &mbedtls_ripemd160_info;\0A#endif\0A#if defined(MBEDTLS_MD_CAN_SHA1)\0A        case MBEDTLS_MD_SHA1:\0A            return &mbedtls_sha1_info;\0A#endif\0A#if defined(MBEDTLS_MD_CAN_SHA224)\0A        case MBEDTLS_MD_SHA224:\0A            return &mbedtls_sha224_info;\0A#endif\0A#if defined(MBEDTLS_MD_CAN_SHA256)\0A        case MBEDTLS_MD_SHA256:\0A            return &mbedtls_sha256_info;\0A#endif\0A#if defined(MBEDTLS_MD_CAN_SHA384)\0A        case MBEDTLS_MD_SHA384:\0A            return &mbedtls_sha384_info;\0A#endif\0A#if defined(MBEDTLS_MD_CAN_SHA512)\0A        case MBEDTLS_MD_SHA512:\0A            return &mbedtls_sha512_info;\0A#endif\0A#if defined(MBEDTLS_MD_CAN_SHA3_224)\0A        case MBEDTLS_MD_SHA3_224:\0A            return &mbedtls_sha3_224_info;\0A#endif\0A#if defined(MBEDTLS_MD_CAN_SHA3_256)\0A        case MBEDTLS_MD_SHA3_256:\0A            return &mbedtls_sha3_256_info;\0A#endif\0A#if defined(MBEDTLS_MD_CAN_SHA3_384)\0A        case MBEDTLS_MD_SHA3_384:\0A            return &mbedtls_sha3_384_info;\0A#endif\0A#if defined(MBEDTLS_MD_CAN_SHA3_512)\0A        case MBEDTLS_MD_SHA3_512:\0A            return &mbedtls_sha3_512_info;\0A#endif\0A        default:\0A            return NULL;\0A    }\0A}\0A\0A#if defined(MBEDTLS_MD_SOME_PSA)\0Astatic psa_algorithm_t psa_alg_of_md(const mbedtls_md_info_t *info)\0A{\0A    switch (info->type) {\0A#if defined(MBEDTLS_MD_MD5_VIA_PSA)\0A        case MBEDTLS_MD_MD5:\0A            return PSA_ALG_MD5;\0A#endif\0A#if defined(MBEDTLS_MD_RIPEMD160_VIA_PSA)\0A        case MBEDTLS_MD_RIPEMD160:\0A            return PSA_ALG_RIPEMD160;\0A#endif\0A#if defined(MBEDTLS_MD_SHA1_VIA_PSA)\0A        case MBEDTLS_MD_SHA1:\0A            return PSA_ALG_SHA_1;\0A#endif\0A#if defined(MBEDTLS_MD_SHA224_VIA_PSA)\0A        case MB