at kind of cipher it is\0A *       combined with.\0A *\0A * \5Cparam[in] key_type      The key type for which to restrict the policy\0A * \5Cparam[in,out] policy    The policy to restrict.\0A * \5Cparam[in] constraint    The policy constraint to apply.\0A *\0A * \5Cretval #PSA_SUCCESS\0A *         \5Cc *policy contains the intersection of the original value of\0A *         \5Cc *policy and \5Cc *constraint.\0A * \5Cretval #PSA_ERROR_INVALID_ARGUMENT\0A *         \5Cc key_type, \5Cc *policy and \5Cc *constraint are incompatible.\0A *         \5Cc *policy is unchanged.\0A */\0Astatic psa_status_t psa_restrict_key_policy(\0A    psa_key_type_t key_type,\0A    psa_key_policy_t *policy,\0A    const psa_key_policy_t *constraint)\0A{\0A    psa_algorithm_t intersection_alg =\0A        psa_key_policy_algorithm_intersection(key_type, policy->alg,\0A                                              constraint->alg);\0A    psa_algorithm_t intersection_alg2 =\0A        psa_key_policy_algorithm_intersection(key_type, policy->alg2,\0A                                              constraint->alg2);\0A    if (intersection_alg == 0 && policy->alg != 0 && constraint->alg != 0) {\0A        return PSA_ERROR_INVALID_ARGUMENT;\0A    }\0A    if (intersection_alg2 == 0 && policy->alg2 != 0 && constraint->alg2 != 0) {\0A        return PSA_ERROR_INVALID_ARGUMENT;\0A    }\0A    policy->usage &= constraint->usage;\0A    policy->alg = intersection_alg;\0A    policy->alg2 = intersection_alg2;\0A    return PSA_SUCCESS;\0A}\0A\0A/** Get the description of a key given its identifier and policy constraints\0A *  and lock it.\0A *\0A * The key must have allow all the usage flags set in \5Cp usage. If \5Cp alg is\0A * nonzero, the key must allow operations with this algorithm. If \5Cp alg is\0A * zero, the algorithm is not checked.\0A *\0A * In case of a persistent key, the function loads the description of the key\0A * into a key slot if not already done.\0A *\0A * On success, the returned key slot has been registered for reading.\0A * It is the responsibility of the caller to then unregister\0A * once they have finished reading the contents of the slot.\0A * The caller unregisters by calling psa_unregister_read() or\0A * psa_unregister_read_under_mutex(). psa_unregister_read() must be called\0A * if and only if the caller already holds the global key slot mutex\0A * (when mutexes are enabled). psa_unregister_read_under_mutex() encapsulates\0A * the unregister with mutex lock and unlock operations.\0A */\0Astatic psa_status_t psa_get_and_lock_key_slot_with_policy(\0A    mbedtls_svc_key_id_t key,\0A    psa_key_slot_t **p_slot,\0A    psa_key_usage_t usage,\0A    psa_algorithm_t alg)\0A{\0A    psa_status_t status = PSA_ERROR_CORRUPTION_DETECTED;\0A    psa_key_slot_t *slot = NULL;\0A\0A    status = psa_get_and_lock_key_slot(key, p_slot);\0A    if (status != PSA_SUCCESS) {\0A        return status;\0A    }\0A    slot = *p_slot;\0A\0A    /* Enforce that usage policy for the key slot contains all the flags\0A     * required by the usage parameter. There is one exception: public\0A     * keys can always be exported, so we treat public key objects as\0A     * if they had the export flag. */\0A    if (PSA_KEY_TYPE_IS_PUBLIC_KEY(slot->attr.type)) {\0A        usage &= ~PSA_KEY_USAGE_EXPORT;\0A    }\0A\0A    if ((slot->attr.policy.usage & usage) != usage) {\0A        status = PSA_ERROR_NOT_PERMITTED;\0A        goto error;\0A    }\0A\0A    /* Enforce that the usage policy permits the requested algorithm. */\0A    if (alg != 0) {\0A        status = psa_key_policy_permits(&slot->attr.policy,\0A                                        slot->attr.type,\0A                                        alg);\0A        if (status != PSA_SUCCESS) {\0A            goto error;\0A        }\0A    }\0A\0A    return PSA_SUCCESS;\0A\0Aerror:\0A    *p_slot = NULL;\0A    psa_unregister_read_under_mutex(slot);\0A\0A    return status;\0A}\0A\0A/** Get a key slot containing a transparent key and lock it.\0A *\