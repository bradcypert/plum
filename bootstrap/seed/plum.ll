#endif\0A}\0A\0Astatic int ecdh_calc_secret_internal(mbedtls_ecdh_context_mbed *ctx,\0A                                     size_t *olen, unsigned char *buf,\0A                                     size_t blen,\0A                                     int (*f_rng)(void *,\0A                                                  unsigned char *,\0A                                                  size_t),\0A                                     void *p_rng,\0A                                     int restart_enabled)\0A{\0A    int ret = MBEDTLS_ERR_ERROR_CORRUPTION_DETECTED;\0A#if defined(MBEDTLS_ECP_RESTARTABLE)\0A    mbedtls_ecp_restart_ctx *rs_ctx = NULL;\0A#endif\0A\0A    if (ctx == NULL || ctx->grp.pbits == 0) {\0A        return MBEDTLS_ERR_ECP_BAD_INPUT_DATA;\0A    }\0A\0A#if defined(MBEDTLS_ECP_RESTARTABLE)\0A    if (restart_enabled) {\0A        rs_ctx = &ctx->rs;\0A    }\0A#else\0A    (void) restart_enabled;\0A#endif\0A\0A#if defined(MBEDTLS_ECP_RESTARTABLE)\0A    if ((ret = ecdh_compute_shared_restartable(&ctx->grp, &ctx->z, &ctx->Qp,\0A                                               &ctx->d, f_rng, p_rng,\0A                                               rs_ctx)) != 0) {\0A        return ret;\0A    }\0A#else\0A    if ((ret = mbedtls_ecdh_compute_shared(&ctx->grp, &ctx->z, &ctx->Qp,\0A                                           &ctx->d, f_rng, p_rng)) != 0) {\0A        return ret;\0A    }\0A#endif /* MBEDTLS_ECP_RESTARTABLE */\0A\0A    if (mbedtls_mpi_size(&ctx->z) > blen) {\0A        return MBEDTLS_ERR_ECP_BAD_INPUT_DATA;\0A    }\0A\0A    *olen = ctx->grp.pbits / 8 + ((ctx->grp.pbits % 8) != 0);\0A\0A    if (mbedtls_ecp_get_type(&ctx->grp) == MBEDTLS_ECP_TYPE_MONTGOMERY) {\0A        return mbedtls_mpi_write_binary_le(&ctx->z, buf, *olen);\0A    }\0A\0A    return mbedtls_mpi_write_binary(&ctx->z, buf, *olen);\0A}\0A\0A/*\0A * Derive and export the shared secret\0A */\0Aint mbedtls_ecdh_calc_secret(mbedtls_ecdh_context *ctx, size_t *olen,\0A                             un