 ret;\0A}\0A\0A/*\0A * Perform the SSL handshake\0A */\0Aint mbedtls_ssl_handshake(mbedtls_ssl_context *ssl)\0A{\0A    int ret = 0;\0A\0A    /* Sanity checks */\0A\0A    if (ssl == NULL || ssl->conf == NULL) {\0A        return MBEDTLS_ERR_SSL_BAD_INPUT_DATA;\0A    }\0A\0A#if defined(MBEDTLS_SSL_PROTO_DTLS)\0A    if (ssl->conf->transport == MBEDTLS_SSL_TRANSPORT_DATAGRAM &&\0A        (ssl->f_set_timer == NULL || ssl->f_get_timer == NULL)) {\0A        MBEDTLS_SSL_DEBUG_MSG(1, (\22You must use \22\0A                                  \22mbedtls_ssl_set_timer_cb() for DTLS\22));\0A        return MBEDTLS_ERR_SSL_BAD_INPUT_DATA;\0A    }\0A#endif /* MBEDTLS_SSL_PROTO_DTLS */\0A\0A    MBEDTLS_SSL_DEBUG_MSG(2, (\22=> handshake\22));\0A\0A    /* Main handshake loop */\0A    while (ssl->state != MBEDTLS_SSL_HANDSHAKE_OVER) {\0A        ret = mbedtls_ssl_handshake_step(ssl);\0A\0A        if (ret != 0) {\0A            break;\0A        }\0A    }\0A\0A    MBEDTLS_SSL_DEBUG_MSG(2, (\22<= handshake\22));\0A\0A    return ret;\0A}\0A\0A#if defined(MBEDTLS_SSL_RENEGOTIATION)\0A#if defined(MBEDTLS_SSL_SRV_C)\0A/*\0A * Write HelloRequest to request renegotiation on server\0A */\0AMBEDTLS_CHECK_RETURN_CRITICAL\0Astatic int ssl_write_hello_request(mbedtls_ssl_context *ssl)\0A{\0A    int ret = MBEDTLS_ERR_ERROR_CORRUPTION_DETECTED;\0A\0A    MBEDTLS_SSL_DEBUG_MSG(2, (\22=> write hello request\22));\0A\0A    ssl->out_msglen  = 4;\0A    ssl->out_msgtype = MBEDTLS_SSL_MSG_HANDSHAKE;\0A    ssl->out_msg[0]  = MBEDTLS_SSL_HS_HELLO_REQUEST;\0A\0A    if ((ret = mbedtls_ssl_write_handshake_msg(ssl)) != 0) {\0A        MBEDTLS_SSL_DEBUG_RET(1, \22mbedtls_ssl_write_handshake_msg\22, ret);\0A        return ret;\0A    }\0A\0A    MBEDTLS_SSL_DEBUG_MSG(2, (\22<= write hello request\22));\0A\0A    return 0;\0A}\0A#endif /* MBEDTLS_SSL_SRV_C */\0A\0A/*\0A * Actually renegotiate current connection, triggered by either:\0A * - any side: calling mbedtls_ssl_renegotiate(),\0A * - client: receiving a HelloRequest du