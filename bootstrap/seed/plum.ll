ites\22\0A#endif\0A\0A#if defined(MBEDTLS_SSL_VARIABLE_BUFFER_LENGTH) && ( !defined(MBEDTLS_SSL_MAX_FRAGMENT_LENGTH) )\0A#error \22MBEDTLS_SSL_VARIABLE_BUFFER_LENGTH defined, but not all prerequisites\22\0A#endif\0A\0A#if defined(MBEDTLS_SSL_RECORD_SIZE_LIMIT) && ( !defined(MBEDTLS_SSL_PROTO_TLS1_3) )\0A#error \22MBEDTLS_SSL_RECORD_SIZE_LIMIT defined, but not all prerequisites\22\0A#endif\0A\0A#if defined(MBEDTLS_SSL_CONTEXT_SERIALIZATION) && \5C\0A    !( defined(MBEDTLS_SSL_HAVE_CCM) || defined(MBEDTLS_SSL_HAVE_GCM) || \5C\0A    defined(MBEDTLS_SSL_HAVE_CHACHAPOLY) )\0A#error \22MBEDTLS_SSL_CONTEXT_SERIALIZATION defined, but not all prerequisites\22\0A#endif\0A\0A/* Reject attempts to enable options that have been removed and that could\0A * cause a build to succeed but with features removed. */\0A\0A#if defined(MBEDTLS_HAVEGE_C) //no-check-names\0A#error \22MBEDTLS_HAVEGE_C was removed in Mbed TLS 3.0. See https://github.com/Mbed-TLS/mbedtls/issues/2599\22\0A#endif\0A\0A#if defined(MBEDTLS_SSL_HW_RECORD_ACCEL) //no-check-names\0A#error \22MBEDTLS_SSL_HW_RECORD_ACCEL was removed in Mbed TLS 3.0. See https://github.com/Mbed-TLS/mbedtls/issues/4031\22\0A#endif\0A\0A#if defined(MBEDTLS_SSL_PROTO_SSL3) //no-check-names\0A#error \22MBEDTLS_SSL_PROTO_SSL3 (SSL v3.0 support) was removed in Mbed TLS 3.0. See https://github.com/Mbed-TLS/mbedtls/issues/4031\22\0A#endif\0A\0A#if defined(MBEDTLS_SSL_SRV_SUPPORT_SSLV2_CLIENT_HELLO) //no-check-names\0A#error \22MBEDTLS_SSL_SRV_SUPPORT_SSLV2_CLIENT_HELLO (SSL v2 ClientHello support) was removed in Mbed TLS 3.0. See https://github.com/Mbed-TLS/mbedtls/issues/4031\22\0A#endif\0A\0A#if defined(MBEDTLS_SSL_TRUNCATED_HMAC_COMPAT) //no-check-names\0A#error \22MBEDTLS_SSL_TRUNCATED_HMAC_COMPAT (compatibility with the buggy implementation of truncated HMAC in Mbed TLS up to 2.7) was removed in Mbed TLS 3.0. See https://github.com/Mbed-TLS/mbedtls/issues/4031\22\0A#endif\0A\0A#if defined(MBEDTLS_TLS_DEFAULT_ALLOW_SHA1_IN_CERTIFICATES) //no-check-names\0A#error \22MBEDTLS_TLS_DEFAULT_ALLOW_SHA1_IN_CERTIFICATES was removed in Mbed TLS 3.0. See the ChangeLog entry if you really need SHA-1-signed certificates.\22\0A#endif\0A\0A#if defined(MBEDTLS_ZLIB_SUPPORT) //no-check-names\0A#error \22MBEDTLS_ZLIB_SUPPORT was removed in Mbed TLS 3.0. See https://github.com/Mbed-TLS/mbedtls/issues/4031\22\0A#endif\0A\0A#if defined(MBEDTLS_CHECK_PARAMS) //no-check-names\0A#error \22MBEDTLS_CHECK_PARAMS was removed in Mbed TLS 3.0. See https://github.com/Mbed-TLS/mbedtls/issues/4313\22\0A#endif\0A\0A#if defined(MBEDTLS_SSL_CID_PADDING_GRANULARITY) //no-check-names\0A#error \22MBEDTLS_SSL_CID_PADDING_GRANULARITY was removed in Mbed TLS 3.0. See https://github.com/Mbed-TLS/mbedtls/issues/4335\22\0A#endif\0A\0A#if defined(MBEDTLS_SSL_TLS1_3_PADDING_GRANULARITY) //no-check-names\0A#error \22MBEDTLS_SSL_TLS1_3_PADDING_GRANULARITY was removed in Mbed TLS 3.0. See https://github.com/Mbed-TLS/mbedtls/issues/4335\22\0A#endif\0A\0A#if defined(MBEDTLS_SSL_TRUNCATED_HMAC) //no-check-names\0A#error \22MBEDTLS_SSL_TRUNCATED_HMAC was removed in Mbed TLS 3.0. See https://github.com/Mbed-TLS/mbedtls/issues/4341\22\0A#endif\0A\0A#if defined(MBEDTLS_PKCS7_C) && ( ( !defined(MBEDTLS_ASN1_PARSE_C) ) || \5C\0A    ( !defined(MBEDTLS_OID_C) ) || ( !defined(MBEDTLS_PK_PARSE_C) ) || \5C\0A    ( !defined(MBEDTLS_X509_CRT_PARSE_C) ) || \5C\0A    ( !defined(MBEDTLS_X509_CRL_PARSE_C) ) || \5C\0A    ( !defined(MBEDTLS_MD_C) ) )\0A#error  \22MBEDTLS_PKCS7_C is defined, but not all prerequisites\22\0A#endif\0A\0A/*\0A * Avoid warning from -pedantic. This is a convenient place for this\0A * workaround since this is included by every single file before the\0A * #if defined(MBEDTLS_xxx_C) that results in empty translation units.\0A */\0Atypedef int mbedtls_iso_c_forbids_empty_translation_units;\0A\0A/* *INDENT-ON* */\0A#endif /* MBEDTLS_CHECK_CONFIG_H */\0A\00" }
