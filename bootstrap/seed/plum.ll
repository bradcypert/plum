 return MBEDTLS_ERR_ECP_BAD_INPUT_DATA;\0A    }\0A\0A    return 0;\0A}\0A\0A/*\0A * Write a point plus its length to a buffer\0A */\0Astatic int ecjpake_write_len_point(unsigned char **p,\0A                                   const unsigned char *end,\0A                                   const mbedtls_ecp_group *grp,\0A                                   const int pf,\0A                                   const mbedtls_ecp_point *P)\0A{\0A    int ret = MBEDTLS_ERR_ERROR_CORRUPTION_DETECTED;\0A    size_t len;\0A\0A    /* Need at least 4 for length plus 1 for point */\0A    if (end < *p || end - *p < 5) {\0A        return MBEDTLS_ERR_ECP_BUFFER_TOO_SMALL;\0A    }\0A\0A    ret = mbedtls_ecp_point_write_binary(grp, P, pf,\0A                                         &len, *p + 4, (size_t) (end - (*p + 4)));\0A    if (ret != 0) {\0A        return ret;\0A    }\0A\0A    MBEDTLS_PUT_UINT32_BE(len, *p, 0);\0A\0A    *p += 4 + len;\0A\0A    return 0;\0A}\0A\0A/*\0A * Size of the temporary buffer for ecjpake_hash:\0A * 3 EC points plus their length, plus ID and its length (4 + 6 bytes)\0A */\0A#define ECJPAKE_HASH_BUF_LEN    (3 * (4 + MBEDTLS_ECP_MAX_PT_LEN) + 4 + 6)\0A\0A/*\0A * Compute hash for ZKP (7.4.2.2.2.1)\0A */\0Astatic int ecjpake_hash(const mbedtls_md_type_t md_type,\0A                        const mbedtls_ecp_group *grp,\0A                        const int pf,\0A                        const mbedtls_ecp_point *G,\0A                        const mbedtls_ecp_point *V,\0A                        const mbedtls_ecp_point *X,\0A                        const char *id,\0A                        mbedtls_mpi *h)\0A{\0A    int ret = MBEDTLS_ERR_ERROR_CORRUPTION_DETECTED;\0A    unsigned char buf[ECJPAKE_HASH_BUF_LEN];\0A    unsigned char *p = buf;\0A    const unsigned char *end = buf + sizeof(buf);\0A    const size_t id_len = strlen(id);\0A    unsigned char hash[MBEDTLS_MD_MAX_SIZE];\0A\0A    /* Write things to temporary buffer */\0A    MBEDTLS_MPI_CHK(ecjpake_write_len_point(&p, end