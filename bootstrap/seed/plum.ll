@.str40744 = private global { i64, i64, [1917 x i8] } { i64 -1, i64 1916, [1917 x i8] c"/**\0A * \5Cfile mbedtls/config_psa.h\0A * \5Cbrief PSA crypto configuration options (set of defines)\0A *\0A *  This set of compile-time options takes settings defined in\0A *  include/mbedtls/mbedtls_config.h and include/psa/crypto_config.h and uses\0A *  those definitions to define symbols used in the library code.\0A *\0A *  Users and integrators should not edit this file, please edit\0A *  include/mbedtls/mbedtls_config.h for MBEDTLS_XXX settings or\0A *  include/psa/crypto_config.h for PSA_WANT_XXX settings.\0A */\0A/*\0A *  Copyright The Mbed TLS Contributors\0A *  SPDX-License-Identifier: Apache-2.0 OR GPL-2.0-or-later\0A */\0A\0A#ifndef MBEDTLS_CONFIG_PSA_H\0A#define MBEDTLS_CONFIG_PSA_H\0A\0A#include \22psa/crypto_legacy.h\22\0A\0A#include \22psa/crypto_adjust_config_synonyms.h\22\0A\0A#include \22psa/crypto_adjust_config_dependencies.h\22\0A\0A#include \22mbedtls/config_adjust_psa_superset_legacy.h\22\0A\0A#if defined(MBEDTLS_PSA_CRYPTO_CONFIG)\0A\0A/* Require built-in implementations based on PSA requirements */\0A\0A/* We need this to have a complete list of requirements\0A * before we deduce what built-ins are required. */\0A#include \22psa/crypto_adjust_config_key_pair_types.h\22\0A\0A#if defined(MBEDTLS_PSA_CRYPTO_C)\0A/* If we are implementing PSA crypto ourselves, then we want to enable the\0A * required built-ins. Otherwise, PSA features will be provided by the server. */\0A#include \22mbedtls/config_adjust_legacy_from_psa.h\22\0A#endif\0A\0A#else /* MBEDTLS_PSA_CRYPTO_CONFIG */\0A\0A/* Infer PSA requirements from Mbed TLS capabilities */\0A\0A#include \22mbedtls/config_adjust_psa_from_legacy.h\22\0A\0A/* Hopefully the file above will have enabled keypair symbols in a consistent\0A * way, but including this here fixes them if that wasn't the case. */\0A#include \22psa/crypto_adjust_config_key_pair_types.h\22\0A\0A#endif /* MBEDTLS_PSA_CRYPTO_CONFIG */\0A\0A#if defined(PSA_WANT_ALG_JPAKE)\0A#define PSA_WANT_ALG_SOME_PAKE 1\0A#endif\0A\0A#include \22psa/crypto_adjust_auto_enabled.h\22\0A\0A#endif /* MBEDTLS_CONFIG_PSA_H */\0A\00" }
