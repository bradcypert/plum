      49 /* RFC 8446 TLS 1.3 */\0A#define MBEDTLS_TLS_EXT_SIG_ALG_CERT                50 /* RFC 8446 TLS 1.3 */\0A#define MBEDTLS_TLS_EXT_KEY_SHARE                   51 /* RFC 8446 TLS 1.3 */\0A\0A#if MBEDTLS_SSL_DTLS_CONNECTION_ID_COMPAT == 0\0A#define MBEDTLS_TLS_EXT_CID                         54 /* RFC 9146 DTLS 1.2 CID */\0A#else\0A#define MBEDTLS_TLS_EXT_CID                        254 /* Pre-RFC 9146 DTLS 1.2 CID */\0A#endif\0A\0A#define MBEDTLS_TLS_EXT_ECJPAKE_KKPP               256 /* experimental */\0A\0A#define MBEDTLS_TLS_EXT_RENEGOTIATION_INFO      0xFF01\0A\0A/*\0A * Size defines\0A */\0A#if !defined(MBEDTLS_PSK_MAX_LEN)\0A/*\0A * If the library supports TLS 1.3 tickets and the cipher suite\0A * TLS1-3-AES-256-GCM-SHA384, set the PSK maximum length to 48 instead of 32.\0A * That way, the TLS 1.3 client and server are able to resume sessions where\0A * the cipher suite is TLS1-3-AES-256-GCM-SHA384 (pre-shared keys are 48\0A * bytes long in that case).\0A */\0A#if defined(MBEDTLS_SSL_PROTO_TLS1_3) && \5C\0A    defined(MBEDTLS_SSL_SESSION_TICKETS) && \5C\0A    defined(MBEDTLS_SSL_HAVE_AES) && defined(MBEDTLS_SSL_HAVE_GCM) && \5C\0A    defined(MBEDTLS_MD_CAN_SHA384)\0A#define MBEDTLS_PSK_MAX_LEN 48 /* 384 bits */\0A#else\0A#define MBEDTLS_PSK_MAX_LEN 32 /* 256 bits */\0A#endif\0A#endif /* !MBEDTLS_PSK_MAX_LEN */\0A\0A/* Dummy type used only for its size */\0Aunion mbedtls_ssl_premaster_secret {\0A    unsigned char dummy; /* Make the union non-empty even with SSL disabled */\0A#if defined(MBEDTLS_KEY_EXCHANGE_RSA_ENABLED)\0A    unsigned char _pms_rsa[48];                         /* RFC 5246 8.1.1 */\0A#endif\0A#if defined(MBEDTLS_KEY_EXCHANGE_DHE_RSA_ENABLED)\0A    unsigned char _pms_dhm[MBEDTLS_MPI_MAX_SIZE];      /* RFC 5246 8.1.2 */\0A#endif\0A#if defined(MBEDTLS_KEY_EXCHANGE_ECDHE_RSA_ENABLED)    || \5C\0A    defined(MBEDTLS_KEY_EXCHANGE_ECDHE_ECDSA_ENABLED)  || \5C\0A    defined(MBEDTLS_KEY_EXCHANGE_ECDH_RSA_ENABLED)     || \5C\0A    defined(MBEDTLS_KEY_EXCHANGE_ECDH_ECDSA_ENABLED)\0A    unsigned char _pms_ecdh[MBEDTLS_ECP_MAX_BYTES];    /* RFC 4492 5.10 */\0A#endif\0A#if defined(MBEDTLS_KEY_EXCHANGE_PSK_ENABLED)\0A    unsigned char _pms_psk[4 + 2 * MBEDTLS_PSK_MAX_LEN];       /* RFC 4279 2 */\0A#endif\0A#if defined(MBEDTLS_KEY_EXCHANGE_DHE_PSK_ENABLED)\0A    unsigned char _pms_dhe_psk[4 + MBEDTLS_MPI_MAX_SIZE\0A                               + MBEDTLS_PSK_MAX_LEN];         /* RFC 4279 3 */\0A#endif\0A#if defined(MBEDTLS_KEY_EXCHANGE_RSA_PSK_ENABLED)\0A    unsigned char _pms_rsa_psk[52 + MBEDTLS_PSK_MAX_LEN];      /* RFC 4279 4 */\0A#endif\0A#if defined(MBEDTLS_KEY_EXCHANGE_ECDHE_PSK_ENABLED)\0A    unsigned char _pms_ecdhe_psk[4 + MBEDTLS_ECP_MAX_BYTES\0A                                 + MBEDTLS_PSK_MAX_LEN];       /* RFC 5489 2 */\0A#endif\0A#if defined(MBEDTLS_KEY_EXCHANGE_ECJPAKE_ENABLED)\0A    unsigned char _pms_ecjpake[32];     /* Thread spec: SHA-256 output */\0A#endif\0A};\0A\0A#define MBEDTLS_PREMASTER_SIZE     sizeof(union mbedtls_ssl_premaster_secret)\0A\0A#define MBEDTLS_TLS1_3_MD_MAX_SIZE         PSA_HASH_MAX_SIZE\0A\0A\0A/* Length in number of bytes of the TLS sequence number */\0A#define MBEDTLS_SSL_SEQUENCE_NUMBER_LEN 8\0A\0A#ifdef __cplusplus\0Aextern \22C\22 {\0A#endif\0A\0A/*\0A * SSL state machine\0A */\0Atypedef enum {\0A    MBEDTLS_SSL_HELLO_REQUEST,\0A    MBEDTLS_SSL_CLIENT_HELLO,\0A    MBEDTLS_SSL_SERVER_HELLO,\0A    MBEDTLS_SSL_SERVER_CERTIFICATE,\0A    MBEDTLS_SSL_SERVER_KEY_EXCHANGE,\0A    MBEDTLS_SSL_CERTIFICATE_REQUEST,\0A    MBEDTLS_SSL_SERVER_HELLO_DONE,\0A    MBEDTLS_SSL_CLIENT_CERTIFICATE,\0A    MBEDTLS_SSL_CLIENT_KEY_EXCHANGE,\0A    MBEDTLS_SSL_CERTIFICATE_VERIFY,\0A    MBEDTLS_SSL_CLIENT_CHANGE_CIPHER_SPEC,\0A    MBEDTLS_SSL_CLIENT_FINISHED,\0A    MBEDTLS_SSL_SERVER_CHANGE_CIPHER_SPEC,\0A    MBEDTLS_SSL_SERVER_FINISHED,\0A    MBEDTLS_SSL_FLUSH_BUFFERS,\0A    MBEDTLS_SSL_HANDSHAKE_WRAPUP,\0A    MBEDTLS_SSL_NEW_SESSION_TICKET,\0A    MBEDTLS_SSL_SERVER_HELLO_VERIFY_REQUEST_SENT,\0A    MBEDTLS_SSL_HELLO_RETRY_REQUEST,\0A    MBEDTLS_SSL_ENCRYPTED_EXTENSIONS,\0A    MBEDTLS_SSL_END_OF_EARLY_DATA,\0A    MBEDTLS_SSL_CLIENT_CERTIFICATE_VERIFY,\0A    MBEDTLS_SSL_CLIENT_CCS_AFTER_SERVER_FINISHED,\0A    MBEDTLS_SSL_CLIENT_CCS_BEFORE_2ND_CLIENT_HELLO,\0A    MBEDTLS_SSL_SERVER_CCS_AFTER_SERVER_HELLO,\0A    MBEDTLS_SSL_CLIENT_CCS_AFTER_CLIENT_HELLO,\0A    MBEDTLS_SSL_SERVER_CCS_AFTER_HELLO_RETRY_REQUEST,\0A    MBEDTLS_SSL_HANDSHAKE_OVER,\0A    MBEDTLS_SSL_TLS1_3_NEW_SESSION_TICKET,\0A    MBEDTLS_SSL_TLS1_3_NEW_SESSION_TICKET_FLUSH,\0A}\0Ambedtls_ssl_states;\0A\0A/*\0A * Early data status, client side only.\0A */\0A\0A#if defined(MBEDTLS_SSL_EARLY_DATA) && defined(MBEDTLS_SSL_CLI_C)\0Atypedef enum {\0A/*\0A * See documentation of mbedtls_ssl_get_early_data_status().\0A */\0A    MBEDTLS_SSL_EARLY_DATA_STATUS_NOT_INDICATED,\0A    MBEDTLS_SSL_EARLY_DATA_STATUS_ACCEPTED,\0A    MBEDTLS_SSL_EARLY_DATA_STATUS_REJECTED,\0A} mbedtls_ssl_early_data_status;\0A#endif /* MBEDTLS_SSL_EARLY_DATA && MBEDTLS_SSL_CLI_C */\0A\0A/**\0A * \5Cbrief          Callback type: send data on the network.\0A *\0A * \5Cnote           That callback may be either blocking or non-blocking.\0A *\0A * \5Cparam ctx      Context for the send callback (typically a file descriptor)\0A * \5Cparam buf      Buffer holding the data to send\0A * \5Cparam len      Length of the data to send\0A *\0A * \5Creturn         The callback must return the number of bytes sent if any,\0A *                 or a non-zero error code.\0A *                 If performing non-blocking I/O, \5Cc MBEDTLS_ERR_SSL_WANT_WRITE\0A *                 must be returned when the operation would block.\0A *\0A * \5Cnote           The callback is allowed to send fewer bytes than requested.\0A *                 It must always return the number of bytes actually sent.\0A */\0Atypedef int mbedtls_ssl_send_t(void *ctx,\0A                               const unsigned char *buf,\0A                               size_t len);\0A\0A/**\0A * \5Cbrief          Callback type: receive data from the network.\0A *\0A * \5Cnote           That callback may be either blocking or non-blocking.\0A *\0A * \5Cparam ctx      Context for the receive callback (typically a file\0A *                 descriptor)\0A * \5Cparam buf      Buffer to write the received data to\0A * \5Cparam len      Length of the receive buffer\0A *\0A * \5Creturns        If data has been received, the positive number of bytes received.\0A * \5Creturns        \5Cc 0 if the connection has been closed.\0A * \5Creturns        If performing non-blocking I/O, \5Cc MBEDTLS_ERR_SSL_WANT_READ\0A *                 must be returned when the operation would block.\0A * \5Creturns        Another negative error code on other kinds of failures.\0A *\0A * \5Cnote           The callback may receive fewer bytes than the length of the\0A *                 buffer. It must always return the number of bytes actually\0A *                 received and written to the buffer.\0A */\0Atypedef int mbedtls_ssl_recv_t(void *ctx,\0A                               unsigned char *buf,\0A                               size_t len);\0A\0A/**\0A * \5Cbrief          Callback type: receive data from the network, with timeout\0A *\0A * \5Cnote           That callback must block until data is received, or the\0A *                 timeout delay expires, or the operation is interrupted by a\0A *                 signal.\0A *\0A * \5Cparam ctx      Context for the receive callback (typically a file descriptor)\0A * \5Cparam buf      Buffer to write the received data to\0A * \5Cparam len      Length of the receive buffer\0A * \5Cparam timeout  Maximum number of milliseconds to wait for data\0A *                 0 means no timeout (potentially waiting forever)\0A *\0A * \5Creturn         The callback must return the number of bytes received,\0A *                 or a non-zero error code:\0A *                 \5Cc MBEDTLS_ERR_SSL_TIMEOUT if the operation timed out,\0A *                 \5Cc MBEDTLS_ERR_SSL_WANT_READ if interrupted by a signal.\0A *\0A * \5Cnote           The callback may receive fewer bytes than the length of the\0A *                 buffer. It must always return the number of bytes actually\0A *                 received and written to the buffer.\0A */\0Atypedef int mbedtls_ssl_recv_timeout_t(void *ctx,\0A                                       unsigned char *buf,\0A                                       size_t len,\0A                                       uint32_t timeout);\0A/**\0A * \5Cbrief          Callback type: set a pair of timers/delays to watch\0A *\0A * \5Cparam ctx      Context pointer\0A * \5Cparam int_ms   Intermediate delay in milliseconds\0A * \5Cparam fin_ms   Final delay in milliseconds\0A *                 0 cancels the current timer.\0A *\0A * \5Cnote           This callback must at least store the necessary information\0A *                 for the associated \5Cc mbedtls_ssl_get_timer_t callback to\0A *                 return correct information.\0A *\0A * \5Cnote           If using an event-driven style of programming, an event must\0A *                 be generated when the final delay is passed. The event must\0A *                 cause a call to \5Cc mbedtls_ssl_handshake() with the proper\0A *                 SSL context to be scheduled. Care must be taken to ensure\0A *                 that at most one such call happens at a time.\0A *\0A * \5Cnote           Only one timer at a time must be running. Calling this\0A *                 function while a timer is running must cancel it. Cancelled\0A *                 timers must not generate any event.\0A */\0Atypedef void mbedtls_ssl_set_timer_t(void *ctx,\0A                                     uint32_t int_ms,\0A                                     uint32_t fin_ms);\0A\0A/**\0A * \5Cbrief          Callback type: get status of timers/delays\0A *\0A * \5Cparam ctx      Context pointer\0A *\0A * \5Creturn         This callback must return:\0A *                 -1 if cancelled (fin_ms == 0),\0A *                  0 if none of the delays have passed,\0A *                  1 if only the intermediate delay has passed,\0A *                  2 if the final delay has passed.\0A */\0Atypedef int mbedtls_ssl_get_timer_t(void *ctx);\0A\0A/* Defined below */\0Atypedef struct mbedtls_ssl_session mbedtls_ssl_session;\0Atypedef struct mbedtls_ssl_context mbedtls_ssl_context;\0Atypedef struct mbedtls_ssl_config  mbedtls_ssl_config;\0A\0A/* Defined in library/ssl_misc.h */\0Atypedef struct mbedtls_ssl_transform mbedtls_ssl_transform;\0Atypedef struct mbedtls_ssl_handshake_params mbedtls_ssl_handshake_params;\0Atypedef struct mbedtls_ssl_sig_hash_set_t mbedtls_ssl_sig_hash_set_t;\0A#if defined(MBEDTLS_X509_CRT_PARSE_C)\0Atypedef struct mbedtls_ssl_key_cert mbedtls_ssl_key_cert;\0A#endif\0A#if defined(MBEDTLS_SSL_PROTO_DTLS)\0Atypedef struct mbedtls_ssl_flight_item mbedtls_ssl_flight_item;\0A#endif\0A\0A#if defined(MBEDTLS_SSL_PROTO_TLS1_3) && defined(MBEDTLS_SSL_SESSION_TICKETS)\0A#define MBEDTLS_SSL_TLS1_3_TICKET_ALLOW_PSK_RESUMPTION                          \5C\0A    MBEDTLS_SSL_TLS1_3_KEY_EXCHANGE_MODE_PSK                        /* 1U << 0 */\0A#define MBEDTLS_SSL_TLS1_3_TICKET_ALLOW_PSK_EPHEMERAL_RESUMPTION                \5C\0A    MBEDTLS_SSL_TLS1_3_KEY_EXCHANGE_MODE_PSK_EPHEMERAL              /* 1U << 2 */\0A#define MBEDTLS_SSL_TLS1_3_TICKET_ALLOW_EARLY_DATA                  (1U << 3)\0A\0A#define MBEDTLS_SSL_TLS1_3_TICKET_FLAGS_MASK                                    \5C\0A    (MBEDTLS_SSL_TLS1_3_TICKET_ALLOW_PSK_RESUMPTION             |      \5C\0A     MBEDTLS_SSL_TLS1_3_TICKET_ALLOW_PSK_EPHEMERAL_RESUMPTION   |      \5C\0A     MBEDTLS_SSL_TLS1_3_TICKET_ALLOW_EARLY_DATA)\0A#endif /* MBEDTLS_SSL_PROTO_TLS1_3 && MBEDTLS_SSL_SESSION_TICKETS */\0A\0A/**\0A * \5Cbrief          Callback type: server-side session cache getter\0A *\0A *                 The session cache is logically a key value store, with\0A *                 keys being session IDs and values being instances of\0A *                 mbedtls_ssl_session.\0A *\0A *                 This callback retrieves an entry in this key-value store.\0A *\0A * \5Cparam data            The address of the session cache structure to query.\0A * \5Cparam session_id      The buffer holding the session ID to query.\0A * \5Cparam session_id_len  The length of \5Cp session_id in Bytes.\0A * \5Cparam session         The address of the session structure to populate.\0A *                        It is initialized with mbdtls_ssl_session_init(),\0A *                        and the callback must always leave it in a state\0A *                        where it can safely be freed via\0A *                        mbedtls_ssl_session_free() independent of the\0A *                        return code of this function.\0A *\0A * \5Creturn                \5Cc 0 on success\0A * \5Creturn                A non-zero return value on failure.\0A *\0A */\0Atypedef int mbedtls_ssl_cache_get_t(void *data,\0A                                    unsigned char const *session_id,\0A                                    size_t session_id_len,\0A                                    mbedtls_ssl_session *session);\0A/**\0A * \5Cbrief          Callback type: server-side session cache setter\0A *\0A *                 The session cache is logically a key value store, with\0A *                 keys being session IDs and values being instances of\0A *                 mbedtls_ssl_session.\0A *\0A *                 This callback sets an entry in this key-value store.\0A *\0A * \5Cparam data            The address of the session cache structure to modify.\0A * \5Cparam session_id      The buffer holding the session ID to query.\0A * \5Cparam session_id_len  The length of \5Cp session_id in Bytes.\0A * \5Cparam session         The address of the session to be stored in the\0A *                        session cache.\0A *\0A * \5Creturn                \5Cc 0 on success\0A * \5Creturn                A non-zero return value on failure.\0A */\0Atypedef int mbedtls_ssl_cache_set_t(void *data,\0A                                    unsigned char const *session_id,\0A                                    size_t session_id_len,\0A                                    const mbedtls_ssl_session *session);\0A\0A#if defined(MBEDTLS_SSL_ASYNC_PRIVATE)\0A#if defined(MBEDTLS_X509_CRT_PARSE_C)\0A/**\0A * \5Cbrief           Callback type: start external signature operation.\0A *\0A *                  This callback is called during an SSL handshake to start\0A *                  a signature decryption operation using an\0A *                  external processor. The parameter \5Cp cert contains\0A *                  the public key; it is up to the callback function to\0A *                  determine how to access the associated private key.\0A *\0A *                  This function typically sends or enqueues a request, and\0A *                  does not wait for the operation to complete. This allows\0A *                  the handshake step to be non-blocking.\0A *\0A *                  The parameters \5Cp ssl and \5Cp cert are guaranteed to remain\0A *                  valid throughout the handshake. On the other hand, this\0A *                  function must save the contents of \5Cp hash if the value\0A *                  is needed for later processing, because the \5Cp hash buffer\0A *                  is no longer valid after this function returns.\0A *\0A *                  This function may call mbedtls_ssl_set_async_operation_data()\0A *                  to store an operation context for later retrieval\0A *                  by the resume or cancel callback.\0A *\0A * \5Cnote            For RSA signatures, this function must produce output\0A *                  that is consistent with PKCS#1 v1.5 in the same way as\0A *                  mbedtls_rsa_pkcs1_sign(). Before the private key operation,\0A *                  apply the padding steps described in RFC 8017, section 9.2\0A *                  \22EMSA-PKCS1-v1_5\22 as follows.\0A *                  - If \5Cp md_alg is #MBEDTLS_MD_NONE, apply the PKCS#1 v1.5\0A *                    encoding, treating \5Cp hash as the DigestInfo to be\0A *                    padded. In other words, apply EMSA-PKCS1-v1_5 starting\0A *                    from step 3, with `T = hash` and `tLen = hash_len`.\0A *                  - If `md_alg != MBEDTLS_MD_NONE`, apply the PKCS#1 v1.5\0A *                    encoding, treating \5Cp hash as the hash to be encoded and\0A *                    padded. In other words, apply EMSA-PKCS1-v1_5 starting\0A *                    from step 2, with `digestAlgorithm` obtained by calling\0A *                    mbedtls_oid_get_oid_by_md() on \5Cp md_alg.\0A *\0A * \5Cnote            For ECDSA signatures, the output format is the DER encoding\0A *                  `Ecdsa-Sig-Value` defined in\0A *                  [RFC 4492 section 5.4](https://tools.ietf.org/html/rfc4492#section-5.4).\0A *\0A * \5Cparam ssl             The SSL connection instance. It should not be\0A *                        modified other than via\0A *                        mbedtls_ssl_set_async_operation_data().\0A * \5Cparam cert            Certificate containing the public key.\0A *                        In simple cases, this is one of the pointers passed to\0A *                        mbedtls_ssl_conf_own_cert() when configuring the SSL\0A *                        connection. However, if other callbacks are used, this\0A *                        property may not hold. For example, if an SNI callback\0A *                        is registered with mbedtls_ssl_conf_sni(), then\0A *                        this callback determines what certificate is used.\0A * \5Cparam md_alg          Hash algorithm.\0A * \5Cparam hash            Buffer containing the hash. This buffer is\0A *                        no longer valid when the function returns.\0A * \5Cparam hash_len        Size of the \5Cc hash buffer in bytes.\0A *\0A * \5Creturn          0 if the operation was started successfully and the SSL\0A *                  stack should call the resume callback immediately.\0A * \5Creturn          #MBEDTLS_ERR_SSL_ASYNC_IN_PROGRESS if the operation\0A *                  was started successfully and the SSL stack should return\0A *                  immediately without calling the resume callback yet.\0A * \5Creturn          #MBEDTLS_ERR_SSL_HW_ACCEL_FALLTHROUGH if the external\0A *                  processor does not support this key. The SSL stack will\0A *                  use the private key object instead.\0A * \5Creturn          Any other error indicates a fatal failure and is\0A *                  propagated up the call chain. The callback should\0A *                  use \5Cc MBEDTLS_ERR_PK_xxx error codes, and <b>must not</b>\0A *                  use \5Cc MBEDTLS_ERR_SSL_xxx error codes except as\0A *                  directed in the documentation of this callback.\0A */\0Atypedef int mbedtls_ssl_async_sign_t(mbedtls_ssl_context *ssl,\0A                                     mbedtls_x509_crt *cert,\0A                                     mbedtls_md_type_t md_alg,\0A                                     const unsigned char *hash,\0A                                     size_t hash_len);\0A\0A/**\0A * \5Cbrief           Callback type: start external decryption operation.\0A *\0A *                  This callback is called during an SSL handshake to start\0A *                  an RSA decryption operation using an\0A *                  external processor. The parameter \5Cp cert contains\0A *                  the public key; it is up to the callback function to\0A *                  determine how to access the associated private key.\0A *\0A *                  This function typically sends or enqueues a request, and\0A *                  does not wait for the operation to complete. This allows\0A *                  the handshake step to be non-blocking.\0A *\0A *                  The parameters \5Cp ssl and \5Cp cert are guaranteed to remain\0A *                  valid throughout the handshake. On the other hand, this\0A *                  function must save the contents of \5Cp input if the value\0A *                  is needed for later processing, because the \5Cp input buffer\0A *                  is no longer valid after this function returns.\0A *\0A *                  This function may call mbedtls_ssl_set_async_operation_data()\0A *                  to store an operation context for later retrieval\0A *                  by the resume or cancel callback.\0A *\0A * \5Cwarning         RSA decryption as used in TLS is subject to a potential\0A *                  timing side channel attack first discovered by Bleichenbacher\0A *                  in 1998. This attack can be remotely exploitable\0A *                  in practice. To avoid this attack, you must ensure that\0A *                  if the callback performs an RSA decryption, the time it\0A *                  takes to execute and return the result does not depend\0A *                  on whether the RSA decryption succeeded or reported\0A *                  invalid padding.\0A *\0A * \5Cparam ssl             The SSL connection instance. It should not be\0A *                        modified other than via\0A *                        mbedtls_ssl_set_async_operation_data().\0A * \5Cparam cert            Certificate containing the public key.\0A *                        In simple cases, this is one of the pointers passed to\0A *                        mbedtls_ssl_conf_own_cert() when configuring the SSL\0A *                        connection. However, if other callbacks are used, this\0A *                        property may not hold. For example, if an SNI callback\0A *                        is registered with mbedtls_ssl_conf_sni(), then\0A *                        this callback determines what certificate is used.\0A * \5Cparam input           Buffer containing the input ciphertext. This buffer\0A *                        is no longer valid when the function returns.\0A * \5Cparam input_len       Size of the \5Cp input buffer in bytes.\0A *\0A * \5Creturn          0 if the operation was started successfully and the SSL\0A *                  stack should call the resume callback immediately.\0A * \5Creturn          #MBEDTLS_ERR_SSL_ASYNC_IN_PROGRESS if the operation\0A *                  was started successfully and the SSL stack should return\0A *                  immediately without calling the resume callback yet.\0A * \5Creturn          #MBEDTLS_ERR_SSL_HW_ACCEL_FALLTHROUGH if the external\0A *                  processor does not support this key. The SSL stack will\0A *                  use the private key object instead.\0A * \5Creturn          Any other error indicates a fatal failure and is\0A *                  propagated up the call chain. The callback should\0A *                  use \5Cc MBEDTLS_ERR_PK_xxx error codes, and <b>must not</b>\0A *                  use \5Cc MBEDTLS_ERR_SSL_xxx error codes except as\0A *                  directed in the documentation of this callback.\0A */\0Atypedef int mbedtls_ssl_async_decrypt_t(mbedtls_ssl_context *ssl,\0A                                        mbedtls_x509_crt *cert,\0A                                        const unsigned char *input,\0A                                        size_t input_len);\0A#endif /* MBEDTLS_X509_CRT_PARSE_C */\0A\0A/**\0A * \5Cbrief           Callback type: resume external operation.\0A *\0A *                  This callback is called during an SSL handshake to resume\0A *                  an external operation started by the\0A *                  ::mbedtls_ssl_async_sign_t or\0A *                  ::mbedtls_ssl_async_decrypt_t callback.\0A *\0A *                  This function typically checks the status of a pending\0A *                  request or causes the request queue to make progress, and\0A *                  does not wait for the operation to complete. This allows\0A *                  the handshake step to be non-blocking.\0A *\0A *                  This function may call mbedtls_ssl_get_async_operation_data()\0A *                  to retrieve an operation context set by the start callback.\0A *                  It may call mbedtls_ssl_set_async_operation_data() to modify\0A *                  this context.\0A *\0A *                  Note that when this function returns a status other than\0A *                  #MBEDTLS_ERR_SSL_ASYNC_IN_PROGRESS, it must free any\0A *                  resources associated with the operation.\0A *\0A * \5Cparam ssl             The SSL connection instance. It should not be\0A *                        modified other than via\0A *                        mbedtls_ssl_set_async_operation_data().\0A * \5Cparam output          Buffer containing the output (signature or decrypted\0A *                        data) on success.\0A * \5Cparam output_len      On success, number of bytes written to \5Cp output.\0A * \5Cparam output_size     Size of the \5Cp output buffer in bytes.\0A *\0A * \5Creturn          0 if output of the operation is available in the\0A *                  \5Cp output buffer.\0A * \5Creturn          #MBEDTLS_ERR_SSL_ASYNC_IN_PROGRESS if the operation\0A *                  is still in progress. Subsequent requests for progress\0A *                  on the SSL connection will call the resume callback\0A *                  again.\0A * \5Creturn          Any other error means that the operation is aborted.\0A *                  The SSL handshake is aborted. The callback should\0A *                  use \5Cc MBEDTLS_ERR_PK_xxx error codes, and <b>must not</b>\0A *                  use \5Cc MBEDTLS_ERR_SSL_xxx error codes except as\0A *                  directed in the documentation of this callback.\0A */\0Atypedef int mbedtls_ssl_async_resume_t(mbedtls_ssl_context *ssl,\0A                                       unsigned char *output,\0A                                       size_t *output_len,\0A                                       size_t output_size);\0A\0A/**\0A * \5Cbrief           Callback type: cancel external operation.\0A *\0A *                  This callback is called if an SSL connection is closed\0A *                  while an asynchronous operation is in progress. Note that\0A *                  this callback is not called if the\0A *                  ::mbedtls_ssl_async_resume_t callback has run and has\0A *                  returned a value other than\0A *                  #MBEDTLS_ERR_SSL_ASYNC_IN_PROGRESS, since in that case\0A *                  the asynchronous operation has already completed.\0A *\0A *                  This function may call mbedtls_ssl_get_async_operation_data()\0A *                  to retrieve an operation context set by the start callback.\0A *\0A * \5Cparam ssl             The SSL connection instance. It should not be\0A *                        modified.\0A */\0Atypedef void mbedtls_ssl_async_cancel_t(mbedtls_ssl_context *ssl);\0A#endif /* MBEDTLS_SSL_ASYNC_PRIVATE */\0A\0A#if defined(MBEDTLS_KEY_EXCHANGE_WITH_CERT_ENABLED) &&        \5C\0A    !defined(MBEDTLS_SSL_KEEP_PEER_CERTIFICATE)\0A#define MBEDTLS_SSL_PEER_CERT_DIGEST_MAX_LEN  48\0A#if defined(MBEDTLS_MD_CAN_SHA256)\0A#define MBEDTLS_SSL_PEER_CERT_DIGEST_DFL_TYPE MBEDTLS_MD_SHA256\0A#define MBEDTLS_SSL_PEER_CERT_DIGEST_DFL_LEN  32\0A#elif defined(MBEDTLS_MD_CAN_SHA384)\0A#define MBEDTLS_SSL_PEER_CERT_DIGEST_DFL_TYPE MBEDTLS_MD_SHA384\0A#define MBEDTLS_SSL_PEER_CERT_DIGEST_DFL_LEN  48\0A#elif defined(MBEDTLS_MD_CAN_SHA1)\0A#define MBEDTLS_SSL_PEER_CERT_DIGEST_DFL_TYPE MBEDTLS_MD_SHA1\0A#define MBEDTLS_SSL_PEER_CERT_DIGEST_DFL_LEN  20\0A#else\0A/* This is already checked in check_config.h, but be sure. */\0A#error \22Bad configuration - need SHA-1, SHA-256 or SHA-512 enabled to compute digest of peer CRT.\22\0A#endif\0A#endif /* MBEDTLS_KEY_EXCHANGE_WITH_CERT_ENABLED &&\0A          !MBEDTLS_SSL_KEEP_PEER_CERTIFICATE */\0A\0Atypedef struct {\0A    unsigned char client_application_traffic_secret_N[MBEDTLS_TLS1_3_MD_MAX_SIZE];\0A    unsigned char server_application_traffic_secret_N[MBEDTLS_TLS1_3_MD_MAX_SIZE];\0A    unsigned char exporter_master_secret[MBEDTLS_TLS1_3_MD_MAX_SIZE];\0A    unsigned char resumption_master_secret[MBEDTLS_TLS1_3_MD_MAX_SIZE];\0A} mbedtls_ssl_tls13_application_secrets;\0A\0A#if defined(MBEDTLS_SSL_DTLS_SRTP)\0A\0A#define MBEDTLS_TLS_SRTP_MAX_MKI_LENGTH             255\0A#define MBEDTLS_TLS_SRTP_MAX_PROFILE_LIST_LENGTH    4\0A/*\0A * For code readability use a typedef for DTLS-SRTP profiles\0A *\0A * Use_srtp extension protection profiles values as defined in\0A * http://www.iana.org/assignments/srtp-protection/srtp-protection.xhtml\0A *\0A * Reminder: if this list is expanded mbedtls_ssl_check_srtp_profile_value\0A * must be updated too.\0A */\0A#define MBEDTLS_TLS_SRTP_AES128_CM_HMAC_SHA1_80     ((uint16_t) 0x0001)\0A#define MBEDTLS_TLS_SRTP_AES128_CM_HMAC_SHA1_32     ((uint16_t) 0x0002)\0A#define MBEDTLS_TLS_SRTP_NULL_HMAC_SHA1_80          ((uint16_t) 0x0005)\0A#define MBEDTLS_TLS_SRTP_NULL_HMAC_SHA1_32          ((uint16_t) 0x0006)\0A/* This one is not iana defined, but for code readability. */\0A#define MBEDTLS_TLS_SRTP_UNSET                      ((uint16_t) 0x0000)\0A\0Atypedef uint16_t mbedtls_ssl_srtp_profile;\0A\0Atypedef struct mbedtls_dtls_srtp_info_t {\0A    /*! The SRTP profile that was negotiated. */\0A    mbedtls_ssl_srtp_profile MBEDTLS_PRIVATE(chosen_dtls_srtp_profile);\0A    /*! The length of mki_value. */\0A    uint16_t MBEDTLS_PRIVATE(mki_len);\0A    /*! The mki_value used, with max size of 256 bytes. */\0A    unsigned char MBEDTLS_PRIVATE(mki_value)[MBEDTLS_TLS_SRTP_MAX_MKI_LENGTH];\0A}\0Ambedtls_dtls_srtp_info;\0A\0A#endif /* MBEDTLS_SSL_DTLS_SRTP */\0A\0A/** Human-friendly representation of the (D)TLS protocol version. */\0Atypedef enum {\0A    MBEDTLS_SSL_VERSION_UNKNOWN, /*!< Context not in use or version not yet negotiated. */\0A    MBEDTLS_SSL_VERSION_TLS1_2 = 0x0303, /*!< (D)TLS 1.2 */\0A    MBEDTLS_SSL_VERSION_TLS1_3 = 0x0304, /*!< (D)TLS 1.3 */\0A} mbedtls_ssl_protocol_version;\0A\0A/*\0A * This structure is used for storing current session data.\0A *\0A * Note: when changing this definition, we need to check and update:\0A *  - in tests/suites/test_suite_ssl.function:\0A *      ssl_populate_session() and ssl_serialize_session_save_load()\0A *  - in library/ssl_tls.c:\0A *      mbedtls_ssl_session_init() and mbedtls_ssl_session_free()\0A *      mbedtls_ssl_session_save() and ssl_session_load()\0A *      ssl_session_copy()\0A */\0Astruct mbedtls_ssl_session {\0A#if defined(MBEDTLS_SSL_MAX_FRAGMENT_LENGTH)\0A    unsigned char MBEDTLS_PRIVATE(mfl_code);     /*!< MaxFragmentLength negotiated by peer */\0A#endif /* MBEDTLS_SSL_MAX_FRAGMENT_LENGTH */\0A\0A/*!< RecordSizeLimit received from the peer */\0A#if defined(MBEDTLS_SSL_RECORD_SIZE_LIMIT)\0A    uint16_t MBEDTLS_PRIVATE(record_size_limit);\0A#endif /* MBEDTLS_SSL_RECORD_SIZE_LIMIT */\0A\0A    unsigned char MBEDTLS_PRIVATE(exported);\0A    uint8_t MBEDTLS_PRIVATE(endpoint);          /*!< 0: client, 1: server */\0A\0A    /** TLS version negotiated in the session. Used if and when renegotiating\0A     *  or resuming a session instead of the configured minor TLS version.\0A     */\0A    mbedtls_ssl_protocol_version MBEDTLS_PRIVATE(tls_version);\0A\0A#if defined(MBEDTLS_HAVE_TIME)\0A    mbedtls_time_t MBEDTLS_PRIVATE(start);       /*!< start time of current session */\0A#endif\0A    int MBEDTLS_PRIVATE(ciphersuite);            /*!< chosen ciphersuite */\0A    size_t MBEDTLS_PRIVATE(id_len);              /*!< session id length  */\0A    unsigned char MBEDTLS_PRIVATE(id)[32];       /*!< session identifier */\0A    unsigned char MBEDTLS_PRIVATE(master)[48];   /*!< the master secret  */\0A\0A#if defined(MBEDTLS_X509_CRT_PARSE_C)\0A#if defined(MBEDTLS_SSL_KEEP_PEER_CERTIFICATE)\0A    mbedtls_x509_crt *MBEDTLS_PRIVATE(peer_cert);       /*!< peer X.509 cert chain */\