@.str41456 = private global { i64, i64, [3160 x i8] } { i64 -1, i64 3159, [3160 x i8] c"/*\0A *  Copyright The Mbed TLS Contributors\0A *  SPDX-License-Identifier: Apache-2.0 OR GPL-2.0-or-later\0A */\0A\0A/**\0A * \5Cfile mps_error.h\0A *\0A * \5Cbrief Error codes used by MPS\0A */\0A\0A#ifndef MBEDTLS_MPS_ERROR_H\0A#define MBEDTLS_MPS_ERROR_H\0A\0A\0A/* TODO: The error code allocation needs to be revisited:\0A *\0A * - Should we make (some of) the MPS Reader error codes public?\0A *   If so, we need to adjust MBEDTLS_MPS_READER_MAKE_ERROR() to hit\0A *   a gap in the Mbed TLS public error space.\0A *   If not, we have to make sure we don't forward those errors\0A *   at the level of the public API -- no risk at the moment as\0A *   long as MPS is an experimental component not accessible from\0A *   public API.\0A */\0A\0A/**\0A * \5Cname SECTION:       MPS general error codes\0A *\0A * \5C{\0A */\0A\0A#ifndef MBEDTLS_MPS_ERR_BASE\0A#define MBEDTLS_MPS_ERR_BASE (0)\0A#endif\0A\0A#define MBEDTLS_MPS_MAKE_ERROR(code) \5C\0A    (-(MBEDTLS_MPS_ERR_BASE | (code)))\0A\0A#define MBEDTLS_ERR_MPS_OPERATION_UNEXPECTED  MBEDTLS_MPS_MAKE_ERROR(0x1)\0A#define MBEDTLS_ERR_MPS_INTERNAL_ERROR        MBEDTLS_MPS_MAKE_ERROR(0x2)\0A\0A/* \5C} name SECTION: MPS general error codes */\0A\0A/**\0A * \5Cname SECTION:       MPS Reader error codes\0A *\0A * \5C{\0A */\0A\0A#ifndef MBEDTLS_MPS_READER_ERR_BASE\0A#define MBEDTLS_MPS_READER_ERR_BASE (1 << 8)\0A#endif\0A\0A#define MBEDTLS_MPS_READER_MAKE_ERROR(code) \5C\0A    (-(MBEDTLS_MPS_READER_ERR_BASE | (code)))\0A\0A/*! An attempt to reclaim the data buffer from a reader failed because\0A *  the user hasn't yet read and committed all of it. */\0A#define MBEDTLS_ERR_MPS_READER_DATA_LEFT             MBEDTLS_MPS_READER_MAKE_ERROR(0x1)\0A\0A/*! An invalid argument was passed to the reader. */\0A#define MBEDTLS_ERR_MPS_READER_INVALID_ARG           MBEDTLS_MPS_READER_MAKE_ERROR(0x2)\0A\0A/*! An attempt to move a reader to consuming mode through mbedtls_mps_reader_feed()\0A *  after pausing failed because the provided data is not sufficient to serve the\0A *  read requests that led to the pausing. */\0A#define MBEDTLS_ERR_MPS_READER_NEED_MORE             MBEDTLS_MPS_READER_MAKE_ERROR(0x3)\0A\0A/*! A get request failed because not enough data is available in the reader. */\0A#define MBEDTLS_ERR_MPS_READER_OUT_OF_DATA           MBEDTLS_MPS_READER_MAKE_ERROR(0x4)\0A\0A/*!< A get request after pausing and reactivating the reader failed because\0A *   the request is not in line with the request made prior to pausing. The user\0A *   must not change it's 'strategy' after pausing and reactivating a reader. */\0A#define MBEDTLS_ERR_MPS_READER_INCONSISTENT_REQUESTS MBEDTLS_MPS_READER_MAKE_ERROR(0x5)\0A\0A/*! An attempt to reclaim the data buffer from a reader failed because the reader\0A *  has no accumulator it can use to backup the data that hasn't been processed. */\0A#define MBEDTLS_ERR_MPS_READER_NEED_ACCUMULATOR      MBEDTLS_MPS_READER_MAKE_ERROR(0x6)\0A\0A/*! An attempt to reclaim the data buffer from a reader failed because the\0A *  accumulator passed to the reader is not large enough to hold both the\0A *  data that hasn't been processed and the excess of the last read-request. */\0A#define MBEDTLS_ERR_MPS_READER_ACCUMULATOR_TOO_SMALL MBEDTLS_MPS_READER_MAKE_ERROR(0x7)\0A\0A/* \5C} name SECTION: MPS Reader error codes */\0A\0A#endif /* MBEDTLS_MPS_ERROR_H */\0A\00" }
