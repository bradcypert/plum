0A * \5Cwarning        The same serialized data must never be loaded into more\0A *                 that one context. In order to ensure that, after\0A *                 successfully loading serialized data to an SSL context, you\0A *                 should immediately destroy or invalidate all copies of the\0A *                 serialized data that was loaded. Loading the same data in\0A *                 more than one context would cause severe security failures\0A *                 including but not limited to loss of confidentiality.\0A *\0A * \5Cnote           Before calling this function, the SSL context must be\0A *                 prepared in one of the two following ways. The first way is\0A *                 to take a context freshly initialised with\0A *                 mbedtls_ssl_init() and call mbedtls_ssl_setup() on it with\0A *                 the same ::mbedtls_ssl_config structure that was used in\0A *                 the original connection. The second way is to\0A *                 call mbedtls_ssl_session_reset() on a context that was\0A *                 previously prepared as above but used in the meantime.\0A *                 Either way, you must not use the context to perform a\0A *                 handshake between calling mbedtls_ssl_setup() or\0A *                 mbedtls_ssl_session_reset() and calling this function. You\0A *                 may however call other setter functions in that time frame\0A *                 as indicated in the note below.\0A *\0A * \5Cnote           Before or after calling this function successfully, you\0A *                 also need to configure some connection-specific callbacks\0A *                 and settings before you can use the connection again\0A *                 (unless they were already set before calling\0A *                 mbedtls_ssl_session_reset() and the values are suitable for\0A *                 the present connection). Specifically, you want to call\0A *                 at least mbedtls_ssl_set_bio(),\0A *                 mbedtls_ssl_set_timer_cb(), and\0A *                 mbedtls_ssl_set_user_data_n() or\0A *                 mbedtls_ssl_set_user_data_p() if they were set originally.\0A *                 All other SSL setter functions\0A *                 are not necessary to call, either because they're only used\0A *                 in handshakes, or because the setting is already saved. You\0A *                 might choose to call them anyway, for example in order to\0A *                 share code between the cases of establishing a new\0A *                 connection and the case of loading an already-established\0A *                 connection.\0A *\0A * \5Cnote           If you have new information about the path MTU, you want to\0A *                 call mbedtls_ssl_set_mtu() after calling this function, as\0A *                 otherwise this function would overwrite your\0A *                 newly-configured value with the value that was active when\0A *                 the context was saved.\0A *\0A * \5Cnote           When this function returns an error code, it calls\0A *                 mbedtls_ssl_free() on \5Cp ssl. In this case, you need to\0A *                 prepare the context with the usual sequence starting with a\0A *                 call to mbedtls_ssl_init() if you want to use it again.\0A *\0A * \5Cparam ssl      The SSL context structure to be populated. It must have\0A *                 been prepared as described in the note above.\0A * \5Cparam buf      The buffer holding the serialized connection data. It must\0A *                 be a readable buffer of at least \5Cp len bytes.\0A * \5Cparam len      The size of the serialized data in bytes.\0A *\0A * \5Creturn         \5Cc 0 if successful.\0A * \5Creturn         #MBEDTLS_ERR_SSL_ALLOC_FAILED if memory allocation failed.\0A * \5Creturn         #MBEDTLS_ERR_SSL_VERSION_MISMATCH if the serialized data\0A *                 comes from a different Mbed TLS version or build.\0A * \5Creturn         #MBEDTLS_ERR_SSL_BAD_INPUT_DATA if input data is invalid.\0A */\0Aint mbedtls_ssl_context_load(mbedtls_ssl_context *ssl,\0A                             const unsigned char *buf,\0A                             size_t len);\0A#endif /* MBEDTLS_SSL_CONTEXT_SERIALIZATION */\0A\0A/**\0A * \5Cbrief          Initialize an SSL configuration context\0A *                 Just makes the context ready for\0A *                 mbedtls_ssl_config_defaults() or mbedtls_ssl_config_free().\0A *\0A * \5Cnote           You need to call mbedtls_ssl_config_defaults() unless you\0A *                 manually set all of the relevant fields yourself.\0A *\0A * \5Cparam conf     SSL configuration context\0A */\0Avoid mbedtls_ssl_config_init(mbedtls_ssl_config *conf);\0A\0A/**\0A * \5Cbrief          Load reasonable default SSL configuration values.\0A *                 (You need to call mbedtls_ssl_config_init() first.)\0A *\0A * \5Cparam conf     SSL configuration context\0A * \5Cparam endpoint MBEDTLS_SSL_IS_CLIENT or MBEDTLS_SSL_IS_SERVER\0A * \5Cparam transport MBEDTLS_SSL_TRANSPORT_STREAM for TLS, or\0A *                  MBEDTLS_SSL_TRANSPORT_DATAGRAM for DTLS\0A * \5Cparam preset   a MBEDTLS_SSL_PRESET_XXX value\0A *\0A * \5Cnote           See \5Cc mbedtls_ssl_conf_transport() for notes on DTLS.\0A *\0A * \5Creturn         0 if successful, or\0A *                 MBEDTLS_ERR_XXX_ALLOC_FAILED on memory allocation error.\0A */\0Aint mbedtls_ssl_config_defaults(mbedtls_ssl_config *conf,\0A                                int endpoint, int transport, int preset);\0A\0A/**\0A * \5Cbrief          Free an SSL configuration context\0A *\0A * \5Cparam conf     SSL configuration context\0A */\0Avoid mbedtls_ssl_config_free(mbedtls_ssl_config *conf);\0A\0A/**\0A * \5Cbrief          Initialize SSL session structure\0A *\0A * \5Cparam session  SSL session\0A */\0Avoid mbedtls_ssl_session_init(mbedtls_ssl_session *session);\0A\0A/**\0A * \5Cbrief          Free referenced items in an SSL session including the\0A *                 peer certificate and clear memory\0A *\0A * \5Cnote           A session object can be freed even if the SSL context\0A *                 that was used to retrieve the session is still in use.\0A *\0A * \5Cparam session  SSL session\0A */\0Avoid mbedtls_ssl_session_free(mbedtls_ssl_session *session);\0A\0A/**\0A * \5Cbrief          TLS-PRF function for key derivation.\0A *\0A * \5Cparam prf      The tls_prf type function type to be used.\0A * \5Cparam secret   Secret for the key derivation function.\0A * \5Cparam slen     Length of the secret.\0A * \5Cparam label    String label for the key derivation function,\0A *                 terminated with null character.\0A * \5Cparam random   Random bytes.\0A * \5Cparam rlen     Length of the random bytes buffer.\0A * \5Cparam dstbuf   The buffer holding the derived key.\0A * \5Cparam dlen     Length of the output buffer.\0A *\0A * \5Creturn         0 on success. An SSL specific error on failure.\0A */\0Aint  mbedtls_ssl_tls_prf(const mbedtls_tls_prf_types prf,\0A                         const unsigned char *secret, size_t slen,\0A                         const char *label,\0A                         const unsigned char *random, size_t rlen,\0A                         unsigned char *dstbuf, size_t dlen);\0A\0A#ifdef __cplusplus\0A}\0A#endif\0A\0A#endif /* ssl.h */\0A\00" }
