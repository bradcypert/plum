@.str41679 = private global { i64, i64, [11766 x i8] } { i64 -1, i64 11765, [11766 x i8] c"/*\0A *  PSA MAC layer on top of Mbed TLS software crypto\0A */\0A/*\0A *  Copyright The Mbed TLS Contributors\0A *  SPDX-License-Identifier: Apache-2.0 OR GPL-2.0-or-later\0A */\0A\0A#ifndef PSA_CRYPTO_MAC_H\0A#define PSA_CRYPTO_MAC_H\0A\0A#include <psa/crypto.h>\0A\0A/** Calculate the MAC (message authentication code) of a message using Mbed TLS.\0A *\0A * \5Cnote The signature of this function is that of a PSA driver mac_compute\0A *       entry point. This function behaves as a mac_compute entry point as\0A *       defined in the PSA driver interface specification for transparent\0A *       drivers.\0A *\0A * \5Cparam[in] attributes        The attributes of the key to use for the\0A *                              operation.\0A * \5Cparam[in] key_buffer        The buffer containing the key to use for\0A *                              computing the MAC. This buffer contains the key\0A *                              in export representation as defined by\0A *                              psa_export_key() (i.e. the raw key bytes).\0A * \5Cparam key_buffer_size       Size of the \5Cp key_buffer buffer in bytes.\0A * \5Cparam alg                   The MAC algorithm to use (\5Cc PSA_ALG_XXX value\0A *                              such that #PSA_ALG_IS_MAC(\5Cp alg) is true).\0A * \5Cparam[in] input             Buffer containing the input message.\0A * \5Cparam input_length          Size of the \5Cp input buffer in bytes.\0A * \5Cparam[out] mac              Buffer where the MAC value is to be written.\0A * \5Cparam mac_size              Size of the \5Cp mac buffer in bytes.\0A * \5Cparam[out] mac_length       On success, the number of bytes\0A *                              that make up the MAC value.\0A *\0A * \5Cretval #PSA_SUCCESS\0A *         Success.\0A * \5Cretval #PSA_ERROR_NOT_SUPPORTED\0A *         \5Cp alg is not supported.\0A * \5Cretval #PSA_ERROR_BUFFER_TOO_SMALL\0A *         \5Cp mac_size is too small\0A * \5Cretval #PSA_ERROR_INSUFFICIENT_MEMORY \5Cemptydescription\0A * \5Cretval #PSA_ERROR_CORRUPTION_DETECTED \5Cemptydescription\0A */\0Apsa_status_t mbedtls_psa_mac_compute(\0A    const psa_key_attributes_t *attributes,\0A    const uint8_t *key_buffer,\0A    size_t key_buffer_size,\0A    psa_algorithm_t alg,\0A    const uint8_t *input,\0A    size_t input_length,\0A    uint8_t *mac,\0A    size_t mac_size,\0A    size_t *mac_length);\0A\0A/** Set up a multipart MAC calculation operation using Mbed TLS.\0A *\0A * \5Cnote The signature of this function is that of a PSA driver mac_sign_setup\0A *       entry point. This function behaves as a mac_sign_setup entry point as\0A *       defined in the PSA driver interface specification for transparent\0A *       drivers.\0A *\0A * \5Cparam[in,out] operation     The operation object to set up. It must have\0A *                              been initialized and not yet in use.\0A * \5Cparam[in] attributes        The attributes of the key to use for the\0A *                              operation.\0A * \5Cparam[in] key_buffer        The buffer containing the key to use for\0A *                              computing the MAC. This buffer contains the key\0A *                              in export representation as defined by\0A *                              psa_export_key() (i.e. the raw key bytes).\0A * \5Cparam key_buffer_size       Size of the \5Cp key_buffer buffer in bytes.\0A * \5Cparam alg                   The MAC algorithm to use (\5Cc PSA_ALG_XXX value\0A *                              such that #PSA_ALG_IS_MAC(\5Cp alg) is true).\0A *\0A * \5Cretval #PSA_SUCCESS\0A *         Success.\0A * \5Cretval #PSA_ERROR_NOT_SUPPORTED\0A *         \5Cp alg is not supported.\0A * \5Cretval #PSA_ERROR_INSUFFICIENT_MEMORY \5Cemptydescription\0A * \5Cretval #PSA_ERROR_CORRUPTION_DETECTED \5Cemptydescription\0A * \5Cretval #PSA_ERROR_BAD_STATE\0A *         The operation state is not valid (it must be inactive).\0A */\0Apsa_status_t mbedtls_psa_mac_sign_setup(\0A    mbedtls_psa_mac_operation_t *operation,\0A    const psa_key_attributes_t *attributes,\0A    const uint8_t *key_buffer,\0A    size_t key_buffer_size,\0A    psa_algorithm_t alg);\0A\0A/** Set up a multipart MAC verification operation using Mbed TLS.\0A *\0A * \5Cnote The signature of this function is that of a PSA driver mac_verify_setup\0A *       entry point. This function behaves as a mac_verify_setup entry point as\0A *       defined in the PSA driver interface specification for transparent\0A *       drivers.\0A *\0A * \5Cparam[in,out] operation     The operation object to set up. It must have\0A *                              been initialized and not yet in use.\0A * \5Cparam[in] attributes        The attributes of the key to use for the\0A *                              operation.\0A * \5Cparam[in] key_buffer        The buffer containing the key to use for\0A *                              computing the MAC. This buffer contains the key\0A *                              in export representation as defined by\0A *                              psa_export_key() (i.e. the raw key bytes).\0A * \5Cparam key_buffer_size       Size of the \5Cp key_buffer buffer in bytes.\0A * \5Cparam alg                   The MAC algorithm to use (\5Cc PSA_ALG_XXX value\0A *                              such that #PSA_ALG_IS_MAC(\5Cp alg) is true).\0A *\0A * \5Cretval #PSA_SUCCESS\0A *         Success.\0A * \5Cretval #PSA_ERROR_NOT_SUPPORTED\0A *         \5Cp alg is not supported.\0A * \5Cretval #PSA_ERROR_INSUFFICIENT_MEMORY \5Cemptydescription\0A * \5Cretval #PSA_ERROR_CORRUPTION_DETECTED \5Cemptydescription\0A * \5Cretval #PSA_ERROR_BAD_STATE\0A *         The operation state is not valid (it must be inactive).\0A */\0Apsa_status_t mbedtls_psa_mac_verify_setup(\0A    mbedtls_psa_mac_operation_t *operation,\0A    const psa_key_attributes_t *attributes,\0A    const uint8_t *key_buffer,\0A    size_t key_buffer_size,\0A    psa_algorithm_t alg);\0A\0A/** Add a message fragment to a multipart MAC operation using Mbed TLS.\0A *\0A * \5Cnote The signature of this function is that of a PSA driver mac_update\0A *       entry point. This function behaves as a mac_update entry point as\0A *       defined in the PSA driver interface specification for transparent\0A *       drivers.\0A *\0A * The PSA core calls mbedtls_psa_mac_sign_setup() or\0A * mbedtls_psa_mac_verify_setup() before calling this function.\0A *\0A * If this function returns an error status, the PSA core aborts the\0A * operation by calling mbedtls_psa_mac_abort().\0A *\0A * \5Cparam[in,out] operation Active MAC operation.\0A * \5Cparam[in] input         Buffer containing the message fragment to add to\0A *                          the MAC calculation.\0A * \5Cparam input_length      Size of the \5Cp input buffer in bytes.\0A *\0A * \5Cretval #PSA_SUCCESS\0A *         Success.\0A * \5Cretval #PSA_ERROR_BAD_STATE\0A *         The operation state is not valid (it must be active).\0A * \5Cretval #PSA_ERROR_INSUFFICIENT_MEMORY \5Cemptydescription\0A * \5Cretval #PSA_ERROR_CORRUPTION_DETECTED \5Cemptydescription\0A */\0Apsa_status_t mbedtls_psa_mac_update(\0A    mbedtls_psa_mac_operation_t *operation,\0A    const uint8_t *input,\0A    size_t input_length);\0A\0A/** Finish the calculation of the MAC of a message using Mbed TLS.\0A *\0A * \5Cnote The signature of this function is that of a PSA driver mac_sign_finish\0A *       entry point. This function behaves as a mac_sign_finish entry point as\0A *       defined in the PSA driver interface specification for transparent\0A *       drivers.\0A *\0A * The PSA core calls mbedtls_psa_mac_sign_setup() before calling this function.\0A * This function calculates the MAC of the message formed by concatenating\0A * the inputs passed to preceding calls to mbedtls_psa_mac_update().\0A *\0A * Whether this function returns successfully or not, the PSA core subsequently\0A * aborts the operation by calling mbedtls_psa_mac_abort().\0A *\0A * \5Cparam[in,out] operation Active MAC operation.\0A * \5Cparam[out] mac          Buffer where the MAC value is to be written.\0A * \5Cparam mac_size          Output size requested for the MAC algorithm. The PSA\0A *                          core guarantees this is a valid MAC length for the\0A *                          algorithm and key combination passed to\0A *                          mbedtls_psa_mac_sign_setup(). It also guarantees the\0A *                          \5Cp mac buffer is large enough to contain the\0A *                          requested output size.\0A * \5Cparam[out] mac_length   On success, the number of bytes output to buffer\0A *                          \5Cp mac, which will be equal to the requested length\0A *                          \5Cp mac_size.\0A *\0A * \5Cretval #PSA_SUCCESS\0A *         Success.\0A * \5Cretval #PSA_ERROR_BAD_STATE\0A *         The operation state is not valid (it must be an active mac sign\0A *         operation).\0A * \5Cretval #PSA_ERROR_BUFFER_TOO_SMALL\0A *         The size of the \5Cp mac buffer is too small. A sufficient buffer size\0A *         can be determined by calling PSA_MAC_LENGTH().\0A * \5Cretval #PSA_ERROR_INSUFFICIENT_MEMORY \5Cemptydescription\0A * \5Cretval #PSA_ERROR_CORRUPTION_DETECTED \5Cemptydescription\0A */\0Apsa_status_t mbedtls_psa_mac_sign_finish(\0A    mbedtls_psa_mac_operation_t *operation,\0A    uint8_t *mac,\0A    size_t mac_size,\0A    size_t *mac_length);\0A\0A/** Finish the calculation of the MAC of a message and compare it with\0A * an expected value using Mbed TLS.\0A *\0A * \5Cnote The signature of this function is that of a PSA driver\0A *       mac_verify_finish entry point. This function behaves as a\0A *       mac_verify_finish entry point as defined in the PSA driver interface\0A *       specification for transparent drivers.\0A *\0A * The PSA core calls mbedtls_psa_mac_verify_setup() before calling this\0A * function. This function calculates the MAC of the message formed by\0A * concatenating the inputs passed to preceding calls to\0A * mbedtls_psa_mac_update(). It then compares the calculated MAC with the\0A * expected MAC passed as a parameter to this function.\0A *\0A * Whether this function returns successfully or not, the PSA core subsequently\0A * aborts the operation by calling mbedtls_psa_mac_abort().\0A *\0A * \5Cparam[in,out] operation Active MAC operation.\0A * \5Cparam[in] mac           Buffer containing the expected MAC value.\0A * \5Cparam mac_length        Length in bytes of the expected MAC value. The PSA\0A *                          core guarantees that this length is a valid MAC\0A *                          length for the algorithm and key combination passed\0A *                          to mbedtls_psa_mac_verify_setup().\0A *\0A * \5Cretval #PSA_SUCCESS\0A *         The expected MAC is identical to the actual MAC of the message.\0A * \5Cretval #PSA_ERROR_INVALID_SIGNATURE\0A *         The MAC of the message was calculated successfully, but it\0A *         differs from the expected MAC.\0A * \5Cretval #PSA_ERROR_BAD_STATE\0A *         The operation state is not valid (it must be an active mac verify\0A *         operation).\0A * \5Cretval #PSA_ERROR_INSUFFICIENT_MEMORY \5Cemptydescription\0A * \5Cretval #PSA_ERROR_CORRUPTION_DETECTED \5Cemptydescription\0A */\0Apsa_status_t mbedtls_psa_mac_verify_finish(\0A    mbedtls_psa_mac_operation_t *operation,\0A    const uint8_t *mac,\0A    size_t mac_length);\0A\0A/** Abort a MAC operation using Mbed TLS.\0A *\0A * Aborting an operation frees all associated resources except for the\0A * \5Cp operation structure itself. Once aborted, the operation object\0A * can be reused for another operation by calling\0A * mbedtls_psa_mac_sign_setup() or mbedtls_psa_mac_verify_setup() again.\0A *\0A * The PSA core may call this function any time after the operation object has\0A * been initialized by one of the methods described in\0A * #mbedtls_psa_mac_operation_t.\0A *\0A * In particular, calling mbedtls_psa_mac_abort() after the operation has been\0A * terminated by a call to mbedtls_psa_mac_abort(),\0A * mbedtls_psa_mac_sign_finish() or mbedtls_psa_mac_verify_finish() is safe and\0A * has no effect.\0A *\0A * \5Cparam[in,out] operation Initialized MAC operation.\0A *\0A * \5Cretval #PSA_SUCCESS \5Cemptydescription\0A * \5Cretval #PSA_ERROR_CORRUPTION_DETECTED \5Cemptydescription\0A */\0Apsa_status_t mbedtls_psa_mac_abort(\0A    mbedtls_psa_mac_operation_t *operation);\0A\0A#endif /* PSA_CRYPTO_MAC_H */\0A\00" }
