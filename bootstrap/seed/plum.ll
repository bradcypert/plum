ERAL_ENABLED */\0A\0A    /*\0A     * Compute the Handshake Secret\0A     */\0A    ret = mbedtls_ssl_tls13_evolve_secret(\0A        hash_alg, handshake->tls13_master_secrets.early,\0A        shared_secret, shared_secret_len,\0A        handshake->tls13_master_secrets.handshake);\0A    if (ret != 0) {\0A        MBEDTLS_SSL_DEBUG_RET(1, \22mbedtls_ssl_tls13_evolve_secret\22, ret);\0A        goto cleanup;\0A    }\0A\0A    MBEDTLS_SSL_DEBUG_BUF(4, \22Handshake secret\22,\0A                          handshake->tls13_master_secrets.handshake,\0A                          PSA_HASH_LENGTH(hash_alg));\0A\0Acleanup:\0A    if (shared_secret != NULL) {\0A        mbedtls_zeroize_and_free(shared_secret, shared_secret_len);\0A    }\0A\0A    return ret;\0A}\0A\0A/**\0A * \5Cbrief Compute TLS 1.3 application traffic keys.\0A *\0A *        ssl_tls13_generate_application_keys() generates application traffic\0A *        keys, since any record following a 1-RTT Finished message MUST be\0A *        encrypted under the application traffic key.\0A *\0A * \5Cparam ssl  The SSL context to operate on. This must be in\0A *             key schedule stage \5Cc Application, see\0A *             ssl_tls13_key_schedule_stage_application().\0A * \5Cparam traffic_keys The address at which to store the application traffic\0A *                     keys. This must be writable but may be uninitialized.\0A *\0A * \5Creturns    \5Cc 0 on success.\0A * \5Creturns    A negative error code on failure.\0A */\0AMBEDTLS_CHECK_RETURN_CRITICAL\0Astatic int ssl_tls13_generate_application_keys(\0A    mbedtls_ssl_context *ssl,\0A    mbedtls_ssl_key_set *traffic_keys)\0A{\0A    int ret = MBEDTLS_ERR_ERROR_CORRUPTION_DETECTED;\0A    mbedtls_ssl_handshake_params *handshake = ssl->handshake;\0A\0A    /* Address at which to store the application secrets */\0A    mbedtls_ssl_tls13_application_secrets * const app_secrets =\0A        &ssl->session_negotiate->app_secrets;\0A\0A    /* Holding the transcript up to and including the ServerFinished */\0A    unsigned char transcript[MBEDTLS_TLS1_3_MD_MAX_SIZE];\0A    size_t transcript_len;\0A\0A    /* Variables relating to the hash for the chosen ciphersuite. */\0A    mbedtls_md_type_t md_type;\0A\0A    psa_algorithm_t hash_alg;\0A    size_t hash_len;\0A\0A    /* Variables relating to the cipher for the chosen ciphersuite. */\0A    size_t key_len = 0, iv_len = 0;\0A\0A    MBEDTLS_SSL_DEBUG_MSG(2, (\22=> derive application traffic keys\22));\0A\0A    /* Extract basic information about hash and ciphersuite */\0A\0A    ret = ssl_tls13_get_cipher_key_info(handshake->ciphersuite_info,\0A                                        &key_len, &iv_len);\0A    if (ret != 0) {\0A        MBEDTLS_SSL_DEBUG_RET(1, \22ssl_tls13_get_cipher_key_info\22, ret);\0A        goto cleanup;\0A    }\0A\0A    md_type = (mbedtls_md_type_t) handshake->ciphersuite_info->mac;\0A\0A    hash_alg = mbedtls_md_psa_alg_from_type((mbedtls_md_type_t) handshake->ciphersuite_info->mac);\0A    hash_len = PSA_HASH_LENGTH(hash_alg);\0A\0A    /* Compute current handshake transcript. It's the caller's responsibility\0A     * to call this at the right time, that is, after the ServerFinished. */\0A\0A    ret = mbedtls_ssl_get_handshake_transcript(ssl, md_type,\0A                                               transcript, sizeof(transcript),\0A                                               &transcript_len);\0A    if (ret != 0) {\0A        goto cleanup;\0A    }\0A\0A    /* Compute application secrets from master secret and transcript hash. */\0A\0A    ret = mbedtls_ssl_tls13_derive_application_secrets(\0A        hash_alg, handshake->tls13_master_secrets.app,\0A        transcript, transcript_len, app_secrets);\0A    if (ret != 0) {\0A        MBEDTLS_SSL_DEBUG_RET(\0A            1, \22mbedtls_ssl_tls13_derive_application_secrets\22, ret);\0A        goto cleanup;\0A    }\0A\0A    /* Derive first epoch of IV + Key for application traffic. */\0A\0A    ret = mbedtls_ssl_tls13_make_traffic_keys(\0A        hash_alg,\0A        app_secrets->client_application_traffic_secret_N,\0A        app_secrets->server_application_traffic_secret_N,\0A        hash_len, key_len, iv_len, traffic_keys);\0A    if (ret != 0) {\0A        MBEDTLS_SSL_DEBUG_RET(1, \22mbedtls_ssl_tls13_make_traffic_keys\22, ret);\0A        goto cleanup;\0A    }\0A\0A    MBEDTLS_SSL_DEBUG_BUF(4, \22Client application traffic secret\22,\0A                          app_secrets->client_application_traffic_secret_N,\0A                          hash_len);\0A\0A    MBEDTLS_SSL_DEBUG_BUF(4, \22Server application traffic secret\22,\0A                          app_secrets->server_application_traffic_secret_N,\0A                          hash_len);\0A\0A    /*\0A     * Export client/server application traffic secret 0\0A     */\0A    if (ssl->f_export_keys != NULL) {\0A        ssl->f_export_keys(\0A            ssl->p_export_keys,\0A            MBEDTLS_SSL_KEY_EXPORT_TLS1_3_CLIENT_APPLICATION_TRAFFIC_SECRET,\0A            app_secrets->client_application_traffic_secret_N, hash_len,\0A            handshake->randbytes,\0A            handshake->randbytes + MBEDTLS_CLIENT_HELLO_RANDOM_LEN,\0A            MBEDTLS_SSL_TLS_PRF_NONE /* TODO: this should be replaced by\0A                                        a new constant for TLS 1.3! */);\0A\0A        ssl->f_export_keys(\0A            ssl->p_export_keys,\0A            MBEDTLS_SSL_KEY_EXPORT_TLS1_3_SERVER_APPLICATION_TRAFFIC_SECRET,\0A            app_secrets->server_application_traffic_secret_N, hash_len,\0A            handshake->randbytes,\0A            handshake->randbytes + MBEDTLS_CLIENT_HELLO_RANDOM_LEN,\0A            MBEDTLS_SSL_TLS_PRF_NONE /* TODO: this should be replaced by\0A                                        a new constant for TLS 1.3! */);\0A    }\0A\0A    MBEDTLS_SSL_DEBUG_BUF(4, \22client application_write_key:\22,\0A                          traffic_keys->client_write_key, key_len);\0A    MBEDTLS_SSL_DEBUG_BUF(4, \22server application write key\22,\0A                          traffic_keys->server_write_key, key_len);\0A    MBEDTLS_SSL_DEBUG_BUF(4, \22client application write IV\22,\0A                          traffic_keys->client_write_iv, iv_len);\0A    MBEDTLS_SSL_DEBUG_BUF(4, \22server application write IV\22,\0A                          traffic_keys->server_write_iv, iv_len);\0A\0A    MBEDTLS_SSL_DEBUG_MSG(2, (\22<= derive application traffic keys\22));\0A\0Acleanup:\0A    /* randbytes is not used again */\0A    mbedtls_platform_zeroize(ssl->handshake->randbytes,\0A                             sizeof(ssl->handshake->randbytes));\0A\0A    mbedtls_platform_zeroize(transcript, sizeof(transcript));\0A    return ret;\0A}\0A\0Aint mbedtls_ssl_tls13_compute_handshake_transform(mbedtls_ssl_context *ssl)\0A{\0A    int ret = MBEDTLS_ERR_ERROR_CORRUPTION_DETECTED;\0A    mbedtls_ssl_key_set traffic_keys;\0A    mbedtls_ssl_transform *transform_handshake = NULL;\0A    mbedtls_ssl_handshake_params *handshake = ssl->handshake;\0A\0A    /* Compute handshake secret */\0A    ret = ssl_tls13_key_schedule_stage_handshake(ssl);\0A    if (ret != 0) {\0A        MBEDTLS_SSL_DEBUG_RET(1, \22mbedtls_ssl_tls13_derive_master_secret\22, ret);\0A        goto cleanup;\0A    }\0A\0A    /* Next evolution in key schedule: Establish handshake secret and\0A     * key material. */\0A    ret = ssl_tls13_generate_handshake_keys(ssl, &traffic_keys);\0A    if (ret != 0) {\0A        MBEDTLS_SSL_DEBUG_RET(1, \22ssl_tls13_generate_handshake_keys\22,\0A                              ret);\0A        goto cleanup;\0A    }\0A\0A    transform_handshake = mbedtls_calloc(1, sizeof(mbedtls_ssl_transform));\0A    if (transform_handshake == NULL) {\0A        ret = MBEDTLS_ERR_SSL_ALLOC_FAILED;\0A        goto cleanup;\0A    }\0A\0A    ret = mbedtls_ssl_tls13_populate_transform(\0A        transform_handshake,\0A        ssl->conf->endpoint,\0A        handshake->ciphersuite_info->id,\0A        &traffic_keys,\0A        ssl);\0A    if (ret != 0) {\0A        MBEDTLS_SSL_DEBUG_RET(1, \22mbedtls_ssl_tls13_populate_transform\22, ret);\0A        goto cleanup;\0A    }\0A    handshake->transform_handshake = transform_handshake;\0A\0Acleanup:\0A    mbedtls_platform_zeroize(&traffic_keys, sizeof(traffic_keys));\0A    if (ret != 0) {\0A        mbedtls_free(transform_handshake);\0A    }\0A\0A    return ret;\0A}\0A\0Aint mbedtls_ssl_tls13_compute_resumption_master_secret(mbedtls_ssl_context *ssl)\0A{\0A    int ret = MBEDTLS_ERR_ERROR_CORRUPTION_DETECTED;\0A    mbedtls_md_type_t md_type;\0A    mbedtls_ssl_handshake_params *handshake = ssl->handshake;\0A    unsigned char transcript[MBEDTLS_TLS1_3_MD_MAX_SIZE];\0A    size_t transcript_len;\0A\0A    MBEDTLS_SSL_DEBUG_MSG(\0A        2, (\22=> mbedtls_ssl_tls13_compute_resumption_master_secret\22));\0A\0A    md_type = (mbedtls_md_type_t) handshake->ciphersuite_info->mac;\0A\0A    ret = mbedtls_ssl_get_handshake_transcript(ssl, md_type,\0A                                               transcript, sizeof(transcript),\0A                                               &transcript_len);\0A    if (ret != 0) {\0A        return ret;\0A    }\0A\0A    ret = mbedtls_ssl_tls13_derive_resumption_master_secret(\0A        mbedtls_md_psa_alg_from_type(md_type),\0A        handshake->tls13_master_secrets.app,\0A        transcript, transcript_len,\0A        &ssl->session_negotiate->app_secrets);\0A    if (ret != 0) {\0A        return ret;\0A    }\0A\0A    /* Erase master secrets */\0A    mbedtls_platform_zeroize(&handshake->tls13_master_secrets,\0A                             sizeof(handshake->tls13_master_secrets));\0A\0A    MBEDTLS_SSL_DEBUG_BUF(\0A        4, \22Resumption master secret\22,\0A        ssl->session_negotiate->app_secrets.resumption_master_secret,\0A        PSA_HASH_LENGTH(mbedtls_md_psa_alg_from_type(md_type)));\0A\0A    MBEDTLS_SSL_DEBUG_MSG(\0A        2, (\22<= mbedtls_ssl_tls13_compute_resumption_master_secret\22));\0A    return 0;\0A}\0A\0Aint mbedtls_ssl_tls13_compute_application_transform(mbedtls_ssl_context *ssl)\0A{\0A    int ret = MBEDTLS_ERR_ERROR_CORRUPTION_DETECTED;\0A    mbedtls_ssl_key_set traffic_keys;\0A    mbedtls_ssl_transform *transform_application = NULL;\0A\0A    ret = ssl_tls13_key_schedule_stage_application(ssl);\0A    if (ret != 0) {\0A        MBEDTLS_SSL_DEBUG_RET(1,\0A                              \22ssl_tls13_key_schedule_stage_application\22, ret);\0A        goto cleanup;\0A    }\0A\0A    ret = ssl_tls13_generate_application_keys(ssl, &traffic_keys);\0A    if (ret != 0) {\0A        MBEDTLS_SSL_DEBUG_RET(1,\0A                              \22ssl_tls13_generate_application_keys\22, ret);\0A        goto cleanup;\0A    }\0A\0A    transform_application =\0A        mbedtls_calloc(1, sizeof(mbedtls_ssl_transform));\0A    if (transform_application == NULL) {\0A        ret = MBEDTLS_ERR_SSL_ALLOC_FAILED;\0A        goto cleanup;\0A    }\0A\0A    ret = mbedtls_ssl_tls13_populate_transform(\0A        transform_application,\0A        ssl->conf->endpoint,\0A        ssl->handshake->ciphersuite_info->id,\0A        &traffic_keys,\0A        ssl);\0A    if (ret != 0) {\0A        MBEDTLS_SSL_DEBUG_RET(1, \22mbedtls_ssl_tls13_populate_transform\22, ret);\0A        goto cleanup;\0A    }\0A\0A    ssl->transform_application = transform_application;\0A\0Acleanup:\0A\0A    mbedtls_platform_zeroize(&traffic_keys, sizeof(traffic_keys));\0A    if (ret != 0) {\0A        mbedtls_free(transform_application);\0A    }\0A    return ret;\0A}\0A\0A#if defined(MBEDTLS_SSL_TLS1_3_KEY_EXCHANGE_MODE_SOME_PSK_ENABLED)\0Aint mbedtls_ssl_tls13_export_handshake_psk(mbedtls_ssl_context *ssl,\0A                                           unsigned char **psk,\0A                                           size_t *psk_len)\0A{\0A#if defined(MBEDTLS_USE_PSA_CRYPTO)\0A    psa_key_attributes_t key_attributes = PSA_KEY_ATTRIBUTES_INIT;\0A    psa_status_t status = PSA_ERROR_CORRUPTION_DETECTED;\0A\0A    *psk_len = 0;\0A    *psk = NULL;\0A\0A    if (mbedtls_svc_key_id_is_null(ssl->handshake->psk_opaque)) {\0A        return MBEDTLS_ERR_SSL_INTERNAL_ERROR;\0A    }\0A\0A    status = psa_get_key_attributes(ssl->handshake->psk_opaque, &key_attributes);\0A    if (status != PSA_SUCCESS) {\0A        return PSA_TO_MBEDTLS_ERR(status);\0A    }\0A\0A    *psk_len = PSA_BITS_TO_BYTES(psa_get_key_bits(&key_attributes));\0A    *psk = mbedtls_calloc(1, *psk_len);\0A    if (*psk == NULL) {\0A        return MBEDTLS_ERR_SSL_ALLOC_FAILED;\0A    }\0A\0A    status = psa_export_key(ssl->handshake->psk_opaque,\0A                            (uint8_t *) *psk, *psk_len, psk_len);\0A    if (status != PSA_SUCCESS) {\0A        mbedtls_free((void *) *psk);\0A        *psk = NULL;\0A        return PSA_TO_MBEDTLS_ERR(status);\0A    }\0A    return 0;\0A#else\0A    *psk = ssl->handshake->psk;\0A    *psk_len = ssl->handshake->psk_len;\0A    if (*psk == NULL) {\0A        return MBEDTLS_ERR_SSL_INTERNAL_ERROR;\0A    }\0A    return 0;\0A#endif /* !MBEDTLS_USE_PSA_CRYPTO */\0A}\0A#endif /* MBEDTLS_SSL_TLS1_3_KEY_EXCHANGE_MODE_SOME_PSK_ENABLED */\0A\0A#endif /* MBEDTLS_SSL_PROTO_TLS1_3 */\0A\00" }
