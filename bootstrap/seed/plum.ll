= child;\0A    return slot;\0A}\0A\0A// 1 if the child has exited (its result is now readable), 0 if it is\0A// still running, -1 if the handle is not a live child.\0Along long process_poll(long long handle) {\0A    PlumProcessSlot *slot = plum_slot_of(handle);\0A    if (slot == NULL || slot->child == NULL) return -1;\0A    if (slot->child->finished) return 1;\0A#if defined(_WIN32)\0A    HANDLE h = (HANDLE)(intptr_t)slot->child->pid;\0A    DWORD w = WaitForSingleObject(h, 0);\0A    if (w == WAIT_TIMEOUT) return 0;\0A    if (w != WAIT_OBJECT_0) return -1;\0A    DWORD code = 0;\0A    if (!GetExitCodeProcess(h, &code)) code = (DWORD)-1;\0A    plum_child_collect(handle, (long long)(int)code);\0A    return 1;\0A#else\0A    int status = 0;\0A    pid_t r = waitpid((pid_t)slot->child->pid, &status, WNOHANG);\0A    if (r == 0) return 0;\0A    if (r < 0) return -1;\0A    plum_child_collect(handle, WIFEXITED(status) ? (long long)WEXITSTATUS(status) : -1);\0A    return 1;\0A#endif\0A}\0A\0A// Waits for the child. A negative `timeout_nanos` waits forever.\0A// Returns 1 if it exited, 0 if the timeout expired first, -1 on error.\0A//\0A// A bounded wait POLLS with a capped backoff rather than using a timed\0A// wait primitive, because POSIX has no portable one: `waitpid` cannot\0A// take a deadline, and the alternatives (`sigtimedwait` on SIGCHLD,\0A// `pidfd_open`) are per-platform and interact with any other signal\0A// handling in the program. The backoff starts at 1ms and caps at 20ms,\0A// so a short wait stays responsive and a long one costs about fifty\0A// wakeups a second. An UNBOUNDED wait does not poll at all -- it blocks\0A// in `waitpid`, which is the case that would otherwise spin for hours.\0Along long process_child_wait(long long handle, long long timeout_nanos) {\0A    PlumProcessSlot *slot = plum_slot_of(handle);\0A    if (slot == NULL || slot->child == NULL) return -1;\0A    if (slot->child->finished) return 1;\0A\0A    if (timeout_nanos < 0) {\0A#if defined(_W