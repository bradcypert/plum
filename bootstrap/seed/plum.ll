bits;\0A    (void) operation;\0A    (void) data;\0A    return PSA_ERROR_NOT_SUPPORTED;\0A}\0A\0Astatic psa_status_t psa_generate_derived_ecc_key_montgomery_helper(\0A    size_t bits, psa_key_derivation_operation_t *operation, uint8_t **data)\0A{\0A    (void) bits;\0A    (void) operation;\0A    (void) data;\0A    return PSA_ERROR_NOT_SUPPORTED;\0A}\0A#endif /* MBEDTLS_PSA_BUILTIN_KEY_TYPE_ECC_KEY_PAIR_DERIVE */\0A#endif /* PSA_WANT_KEY_TYPE_ECC_KEY_PAIR_DERIVE */\0A\0Astatic psa_status_t psa_generate_derived_key_internal(\0A    psa_key_slot_t *slot,\0A    size_t bits,\0A    psa_key_derivation_operation_t *operation)\0A{\0A    uint8_t *data = NULL;\0A    size_t bytes = PSA_BITS_TO_BYTES(bits);\0A    size_t storage_size = bytes;\0A    psa_status_t status = PSA_ERROR_CORRUPTION_DETECTED;\0A\0A    if (PSA_KEY_TYPE_IS_PUBLIC_KEY(slot->attr.type)) {\0A        return PSA_ERROR_INVALID_ARGUMENT;\0A    }\0A\0A#if defined(PSA_WANT_KEY_TYPE_ECC_KEY_PAIR_DERIVE) || \5C\0A    defined(MBEDTLS_PSA_BUILTIN_KEY_TYPE_ECC_KEY_PAIR_DERIVE)\0A    if (PSA_KEY_TYPE_IS_ECC(slot->attr.type)) {\0A        psa_ecc_family_t curve = PSA_KEY_TYPE_ECC_GET_FAMILY(slot->attr.type);\0A        if (PSA_ECC_FAMILY_IS_WEIERSTRASS(curve)) {\0A            /* Weierstrass elliptic curve */\0A            status = psa_generate_derived_ecc_key_weierstrass_helper(slot, bits, operation, &data);\0A            if (status != PSA_SUCCESS) {\0A                goto exit;\0A            }\0A        } else {\0A            /* Montgomery elliptic curve */\0A            status = psa_generate_derived_ecc_key_montgomery_helper(bits, operation, &data);\0A            if (status != PSA_SUCCESS) {\0A                goto exit;\0A            }\0A        }\0A    } else\0A#endif /* defined(PSA_WANT_KEY_TYPE_ECC_KEY_PAIR_DERIVE) ||\0A          defined(MBEDTLS_PSA_BUILTIN_KEY_TYPE_ECC_KEY_PAIR_DERIVE) */\0A    if (key_type_is_raw_bytes(slot->attr.type)) {\0A        if (bits % 8 != 0) {\0A            return PSA_ERROR_INVALID_ARGUMENT;\0A        }\0A        data = mbedtls_calloc(1, bytes);\0A        if (data == NULL) {\0A            return PSA_ERROR_INSUFFICIENT_MEMORY;\0A        }\0A\0A        status = psa_key_derivation_output_bytes(operation, data, bytes);\0A        if (status != PSA_SUCCESS) {\0A            goto exit;\0A        }\0A#if defined(MBEDTLS_PSA_BUILTIN_KEY_TYPE_DES)\0A        if (slot->attr.type == PSA_KEY_TYPE_DES) {\0A            psa_des_set_key_parity(data, bytes);\0A        }\0A#endif /* defined(MBEDTLS_PSA_BUILTIN_KEY_TYPE_DES) */\0A    } else {\0A        return PSA_ERROR_NOT_SUPPORTED;\0A    }\0A\0A    slot->attr.bits = (psa_key_bits_t) bits;\0A\0A    if (psa_key_lifetime_is_external(slot->attr.lifetime)) {\0A        status = psa_driver_wrapper_get_key_buffer_size(&slot->attr,\0A                                                        &storage_size);\0A        if (status != PSA_SUCCESS) {\0A            goto exit;\0A        }\0A    }\0A    status = psa_allocate_buffer_to_slot(slot, storage_size);\0A    if (status != PSA_SUCCESS) {\0A        goto exit;\0A    }\0A\0A    status = psa_driver_wrapper_import_key(&slot->attr,\0A                                           data, bytes,\0A                                           slot->key.data,\0A                                           slot->key.bytes,\0A                                           &slot->key.bytes, &bits);\0A    if (bits != slot->attr.bits) {\0A        status = PSA_ERROR_INVALID_ARGUMENT;\0A    }\0A\0Aexit:\0A    mbedtls_zeroize_and_free(data, bytes);\0A    return status;\0A}\0A\0Astatic const psa_custom_key_parameters_t default_custom_production =\0A    PSA_CUSTOM_KEY_PARAMETERS_INIT;\0A\0Aint psa_custom_key_parameters_are_default(\0A    const psa_custom_key_parameters_t *custom,\0A    size_t custom_data_length)\0A{\0A    if (custom->flags != 0) {\0A        return 0;\0A    }\0A    if (custom_data_length != 0) {\0A        return 0;\0A    }\0A    return 1;\0A}\0A\0Apsa_status_t psa_key_derivation_output_key_custom(\0A    c