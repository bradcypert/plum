                                   psa_se_drv_table_entry_t **p_drv)\0A{\0A    if (psa_key_lifetime_is_external(lifetime)) {\0A#if defined(MBEDTLS_PSA_CRYPTO_SE_C)\0A        /* Check whether a driver is registered against this lifetime */\0A        psa_se_drv_table_entry_t *driver = psa_get_se_driver_entry(lifetime);\0A        if (driver != NULL) {\0A            if (p_drv != NULL) {\0A                *p_drv = driver;\0A            }\0A            return PSA_SUCCESS;\0A        }\0A#else /* MBEDTLS_PSA_CRYPTO_SE_C */\0A        (void) p_drv;\0A#endif /* MBEDTLS_PSA_CRYPTO_SE_C */\0A\0A        /* Key location for external keys gets checked by the wrapper */\0A        return PSA_SUCCESS;\0A    } else {\0A        /* Local/internal keys are always valid */\0A        return PSA_SUCCESS;\0A    }\0A}\0A\0Apsa_status_t psa_validate_key_persistence(psa_key_lifetime_t lifetime)\0A{\0A    if (PSA_KEY_LIFETIME_IS_VOLATILE(lifetime)) {\0A        /* Volatile keys are always supported */\0A        return PSA_SUCCESS;\0A    } else {\0A        /* Persistent keys require storage support */\0A#if defined(MBEDTLS_PSA_CRYPTO_STORAGE_C)\0A        if (PSA_KEY_LIFETIME_IS_READ_ONLY(lifetime)) {\0A            return PSA_ERROR_INVALID_ARGUMENT;\0A        } else {\0A            return PSA_SUCCESS;\0A        }\0A#else /* MBEDTLS_PSA_CRYPTO_STORAGE_C */\0A        return PSA_ERROR_NOT_SUPPORTED;\0A#endif /* !MBEDTLS_PSA_CRYPTO_STORAGE_C */\0A    }\0A}\0A\0Apsa_status_t psa_open_key(mbedtls_svc_key_id_t key, psa_key_handle_t *handle)\0A{\0A#if defined(MBEDTLS_PSA_CRYPTO_STORAGE_C) || \5C\0A    defined(MBEDTLS_PSA_CRYPTO_BUILTIN_KEYS)\0A    psa_status_t status;\0A    psa_key_slot_t *slot;\0A\0A    status = psa_get_and_lock_key_slot(key, &slot);\0A    if (status != PSA_SUCCESS) {\0A        *handle = PSA_KEY_HANDLE_INIT;\0A        if (status == PSA_ERROR_INVALID_HANDLE) {\0A            status = PSA_ERROR_DOES_NOT_EXIST;\0A        }\0A\0A        return status;\0A    }\0A\0A    *handle = key;\0A\0A    re