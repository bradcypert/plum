  %c = call i32 @memcmp(ptr %hp, ptr %nd, i64 %nlen)
  %eq = icmp eq i32 %c, 0
  br i1 %eq, label %hit, label %next
next:
  %i1 = add i64 %i, 1
  store i64 %i1, ptr %ip
  br label %loop
hit:
  ret i64 %i
miss:
  ret i64 -1
}

