A                p_limbs = CHARS_TO_LIMBS(sizeof(secp192k1_p));\0A            } else {\0A                p = (mbedtls_mpi_uint *) secp192k1_n;\0A                p_limbs = CHARS_TO_LIMBS(sizeof(secp192k1_n));\0A            }\0A            break;\0A#endif\0A\0A#if defined(MBEDTLS_ECP_DP_SECP224K1_ENABLED)\0A        case MBEDTLS_ECP_DP_SECP224K1:\0A            if (ctype == (mbedtls_ecp_modulus_type) MBEDTLS_ECP_MOD_COORDINATE) {\0A                modp = &mbedtls_ecp_mod_p224k1_raw;\0A                p = (mbedtls_mpi_uint *) secp224k1_p;\0A                p_limbs = CHARS_TO_LIMBS(sizeof(secp224k1_p));\0A            } else {\0A                p = (mbedtls_mpi_uint *) secp224k1_n;\0A                p_limbs = CHARS_TO_LIMBS(sizeof(secp224k1_n));\0A            }\0A            break;\0A#endif\0A\0A#if defined(MBEDTLS_ECP_DP_SECP256K1_ENABLED)\0A        case MBEDTLS_ECP_DP_SECP256K1:\0A            if (ctype == (mbedtls_ecp_modulus_type) MBEDTLS_ECP_MOD_COORDINATE) {\0A                modp = &mbedtls_ecp_mod_p256k1_raw;\0A                p = (mbedtls_mpi_uint *) secp256k1_p;\0A                p_limbs = CHARS_TO_LIMBS(sizeof(secp256k1_p));\0A            } else {\0A                p = (mbedtls_mpi_uint *) secp256k1_n;\0A                p_limbs = CHARS_TO_LIMBS(sizeof(secp256k1_n));\0A            }\0A            break;\0A#endif\0A\0A#if defined(MBEDTLS_ECP_DP_CURVE448_ENABLED)\0A        case MBEDTLS_ECP_DP_CURVE448:\0A            if (ctype == (mbedtls_ecp_modulus_type) MBEDTLS_ECP_MOD_COORDINATE) {\0A                modp = &mbedtls_ecp_mod_p448_raw;\0A                p = (mbedtls_mpi_uint *) curve448_p;\0A                p_limbs = CHARS_TO_LIMBS(sizeof(curve448_p));\0A            } else {\0A                p = (mbedtls_mpi_uint *) curve448_n;\0A                p_limbs = CHARS_TO_LIMBS(sizeof(curve448_n));\0A            }\0A            break;\0A#endif\0A\0A        default:\0A        case MBEDTLS_ECP_DP_NONE:\0A            return MBEDTLS_ERR_ECP_BAD_INPUT_DATA;\0A    }\0A\0A    if (modp != NULL) {\0A        if (mbedtls_mpi_mod_optred_modulus_setup(N, p, p_limbs, modp)) {\0A            return MBEDTLS_ERR_ERROR_CORRUPTION_DETECTED;\0A        }\0A    } else {\0A        if (mbedtls_mpi_mod_modulus_setup(N, p, p_limbs)) {\0A            return MBEDTLS_ERR_ERROR_CORRUPTION_DETECTED;\0A        }\0A    }\0A    return 0;\0A}\0A#endif /* MBEDTLS_TEST_HOOKS */\0A\0A#if defined(MBEDTLS_TEST_HOOKS)\0A\0AMBEDTLS_STATIC_TESTABLE\0Ambedtls_ecp_variant mbedtls_ecp_get_variant(void)\0A{\0A    return MBEDTLS_ECP_VARIANT_WITH_MPI_UINT;\0A}\0A\0A#endif /* MBEDTLS_TEST_HOOKS */\0A\0A#endif /* !MBEDTLS_ECP_ALT */\0A#endif /* MBEDTLS_ECP_LIGHT */\0A#endif /* MBEDTLS_ECP_WITH_MPI_UINT */\0A\00" }
