@.str39042 = private global { i64, i64, [53277 x i8] } { i64 -1, i64 53276, [53277 x i8] c"/**\0A * \5Cfile cipher.h\0A *\0A * \5Cbrief This file contains an abstraction interface for use with the cipher\0A * primitives provided by the library. It provides a common interface to all of\0A * the available cipher operations.\0A *\0A * \5Cauthor Adriaan de Jong <dejong@fox-it.com>\0A */\0A/*\0A *  Copyright The Mbed TLS Contributors\0A *  SPDX-License-Identifier: Apache-2.0 OR GPL-2.0-or-later\0A */\0A\0A#ifndef MBEDTLS_CIPHER_H\0A#define MBEDTLS_CIPHER_H\0A#include \22mbedtls/private_access.h\22\0A\0A#include \22mbedtls/build_info.h\22\0A\0A#include <stddef.h>\0A#include \22mbedtls/platform_util.h\22\0A\0A#if defined(MBEDTLS_GCM_C) || defined(MBEDTLS_CCM_C) || defined(MBEDTLS_CHACHAPOLY_C)\0A#define MBEDTLS_CIPHER_MODE_AEAD\0A#endif\0A\0A#if defined(MBEDTLS_CIPHER_MODE_CBC)\0A#define MBEDTLS_CIPHER_MODE_WITH_PADDING\0A#endif\0A\0A#if defined(MBEDTLS_CIPHER_NULL_CIPHER) || \5C\0A    defined(MBEDTLS_CHACHA20_C)\0A#define MBEDTLS_CIPHER_MODE_STREAM\0A#endif\0A\0A/** The selected feature is not available. */\0A#define MBEDTLS_ERR_CIPHER_FEATURE_UNAVAILABLE  -0x6080\0A/** Bad input parameters. */\0A#define MBEDTLS_ERR_CIPHER_BAD_INPUT_DATA       -0x6100\0A/** Failed to allocate memory. */\0A#define MBEDTLS_ERR_CIPHER_ALLOC_FAILED         -0x6180\0A/** Input data contains invalid padding and is rejected. */\0A#define MBEDTLS_ERR_CIPHER_INVALID_PADDING      -0x6200\0A/** Decryption of block requires a full block. */\0A#define MBEDTLS_ERR_CIPHER_FULL_BLOCK_EXPECTED  -0x6280\0A/** Authentication failed (for AEAD modes). */\0A#define MBEDTLS_ERR_CIPHER_AUTH_FAILED          -0x6300\0A/** The context is invalid. For example, because it was freed. */\0A#define MBEDTLS_ERR_CIPHER_INVALID_CONTEXT      -0x6380\0A\0A#define MBEDTLS_CIPHER_VARIABLE_IV_LEN     0x01    /**< Cipher accepts IVs of variable length. */\0A#define MBEDTLS_CIPHER_VARIABLE_KEY_LEN    0x02    /**< Cipher accepts keys of variable length. */\0A\0A#ifdef __cplusplus\0Aextern \22C\22 {\0A#endif\0A\0A/**\0A * \5Cbrief     Supported cipher types.\0A *\0A * \5Cwarning   DES/3DES are considered weak ciphers and their use\0A *            constitutes a security risk. We recommend considering stronger\0A *            ciphers instead.\0A */\0Atypedef enum {\0A    MBEDTLS_CIPHER_ID_NONE = 0,  /**< Placeholder to mark the end of cipher ID lists. */\0A    MBEDTLS_CIPHER_ID_NULL,      /**< The identity cipher, treated as a stream cipher. */\0A    MBEDTLS_CIPHER_ID_AES,       /**< The AES cipher. */\0A    MBEDTLS_CIPHER_ID_DES,       /**< The DES cipher. \5Cwarning DES is considered weak. */\0A    MBEDTLS_CIPHER_ID_3DES,      /**< The Triple DES cipher. \5Cwarning 3DES is considered weak. */\0A    MBEDTLS_CIPHER_ID_CAMELLIA,  /**< The Camellia cipher. */\0A    MBEDTLS_CIPHER_ID_ARIA,      /**< The Aria cipher. */\0A    MBEDTLS_CIPHER_ID_CHACHA20,  /**< The ChaCha20 cipher. */\0A} mbedtls_cipher_id_t;\0A\0A/**\0A * \5Cbrief     Supported {cipher type, cipher mode} pairs.\0A *\0A * \5Cwarning   DES/3DES are considered weak ciphers and their use\0A *            constitutes a security risk. We recommend considering stronger\0A *            ciphers instead.\0A */\0Atypedef enum {\0A    MBEDTLS_CIPHER_NONE = 0,             /**< Placeholder to mark the end of cipher-pair lists. */\0A    MBEDTLS_CIPHER_NULL,                 /**< The identity stream cipher. */\0A    MBEDTLS_CIPHER_AES_128_ECB,          /**< AES cipher with 128-bit ECB mode. */\0A    MBEDTLS_CIPHER_AES_192_ECB,          /**< AES cipher with 192-bit ECB mode. */\0A    MBEDTLS_CIPHER_AES_256_ECB,          /**< AES cipher with 256-bit ECB mode. */\0A    MBEDTLS_CIPHER_AES_128_CBC,          /**< AES cipher with 128-bit CBC mode. */\0A    MBEDTLS_CIPHER_AES_192_CBC,          /**< AES cipher with 192-bit CBC mode. */\0A    MBEDTLS_CIPHER_AES_256_CBC,          /**< AES cipher with 256-bit CBC mode. */\0A    MBEDTLS_CIPHER_AES_128_CFB128,       /**< AES cipher with 128-bit CFB128 mode. */\0A    MBEDTLS_CIPHER_AES_192_CFB128,       /**< AES cipher with 192-bit CFB128 mode. */\0A    MBEDTLS_CIPHER_AES_256_CFB128,       /**< AES cipher with 256-bit CFB128 mode. */\0A    MBEDTLS_CIPHER_AES_128_CTR,          /**< AES cipher with 128-bit CTR mode. */\0A    MBEDTLS_CIPHER_AES_192_CTR,          /**< AES cipher with 192-bit CTR mode. */\0A    MBEDTLS_CIPHER_AES_256_CTR,          /**< AES cipher with 256-bit CTR mode. */\0A    MBEDTLS_CIPHER_AES_128_GCM,          /**< AES cipher with 128-bit GCM mode. */\0A    MBEDTLS_CIPHER_AES_192_GCM,          /**< AES cipher with 192-bit GCM mode. */\0A    MBEDTLS_CIPHER_AES_256_GCM,          /**< AES cipher with 256-bit GCM mode. */\0A    MBEDTLS_CIPHER_CAMELLIA_128_ECB,     /**< Camellia cipher with 128-bit ECB mode. */\0A    MBEDTLS_CIPHER_CAMELLIA_192_ECB,     /**< Camellia cipher with 192-bit ECB mode. */\0A    MBEDTLS_CIPHER_CAMELLIA_256_ECB,     /**< Camellia cipher with 256-bit ECB mode. */\0A    MBEDTLS_CIPHER_CAMELLIA_128_CBC,     /**< Camellia cipher with 128-bit CBC mode. */\0A    MBEDTLS_CIPHER_CAMELLIA_192_CBC,     /**< Camellia cipher with 192-bit CBC mode. */\0A    MBEDTLS_CIPHER_CAMELLIA_256_CBC,     /**< Camellia cipher with 256-bit CBC mode. */\0A    MBEDTLS_CIPHER_CAMELLIA_128_CFB128,  /**< Camellia cipher with 128-bit CFB128 mode. */\0A    MBEDTLS_CIPHER_CAMELLIA_192_CFB128,  /**< Camellia cipher with 192-bit CFB128 mode. */\0A    MBEDTLS_CIPHER_CAMELLIA_256_CFB128,  /**< Camellia cipher with 256-bit CFB128 mode. */\0A    MBEDTLS_CIPHER_CAMELLIA_128_CTR,     /**< Camellia cipher with 128-bit CTR mode. */\0A    MBEDTLS_CIPHER_CAMELLIA_192_CTR,     /**< Camellia cipher with 192-bit CTR mode. */\0A    MBEDTLS_CIPHER_CAMELLIA_256_CTR,     /**< Camellia cipher with 256-bit CTR mode. */\0A    MBEDTLS_CIPHER_CAMELLIA_128_GCM,     /**< Camellia cipher with 128-bit GCM mode. */\0A    MBEDTLS_CIPHER_CAMELLIA_192_GCM,     /**< Camellia cipher with 192-bit GCM mode. */\0A    MBEDTLS_CIPHER_CAMELLIA_256_GCM,     /**< Camellia cipher with 256-bit GCM mode. */\0A    MBEDTLS_CIPHER_DES_ECB,              /**< DES cipher with ECB mode. \5Cwarning DES is considered weak. */\0A    MBEDTLS_CIPHER_DES_CBC,              /**< DES cipher with CBC mode. \5Cwarning DES is considered weak. */\0A    MBEDTLS_CIPHER_DES_EDE_ECB,          /**< DES cipher with EDE ECB mode. \5Cwarning 3DES is considered weak. */\0A    MBEDTLS_CIPHER_DES_EDE_CBC,          /**< DES cipher with EDE CBC mode. \5Cwarning 3DES is considered weak. */\0A    MBEDTLS_CIPHER_DES_EDE3_ECB,         /**< DES cipher with EDE3 ECB mode. \5Cwarning 3DES is considered weak. */\0A    MBEDTLS_CIPHER_DES_EDE3_CBC,         /**< DES cipher with EDE3 CBC mode. \5Cwarning 3DES is considered weak. */\0A    MBEDTLS_CIPHER_AES_128_CCM,          /**< AES cipher with 128-bit CCM mode. */\0A    MBEDTLS_CIPHER_AES_192_CCM,          /**< AES cipher with 192-bit CCM mode. */\0A    MBEDTLS_CIPHER_AES_256_CCM,          /**< AES cipher with 256-bit CCM mode. */\0A    MBEDTLS_CIPHER_AES_128_CCM_STAR_NO_TAG, /**< AES cipher with 128-bit CCM_STAR_NO_TAG mode. */\0A    MBEDTLS_CIPHER_AES_192_CCM_STAR_NO_TAG, /**< AES cipher with 192-bit CCM_STAR_NO_TAG mode. */\0A    MBEDTLS_CIPHER_AES_256_CCM_STAR_NO_TAG, /**< AES cipher with 256-bit CCM_STAR_NO_TAG mode. */\0A    MBEDTLS_CIPHER_CAMELLIA_128_CCM,     /**< Camellia cipher with 128-bit CCM mode. */\0A    MBEDTLS_CIPHER_CAMELLIA_192_CCM,     /**< Camellia cipher with 192-bit CCM mode. */\0A    MBEDTLS_CIPHER_CAMELLIA_256_CCM,     /**< Camellia cipher with 256-bit CCM mode. */\0A    MBEDTLS_CIPHER_CAMELLIA_128_CCM_STAR_NO_TAG, /**< Camellia cipher with 128-bit CCM_STAR_NO_TAG mode. */\0A    MBEDTLS_CIPHER_CAMELLIA_192_CCM_STAR_NO_TAG, /**< Camellia cipher with 192-bit CCM_STAR_NO_TAG mode. */\0A    MBEDTLS_CIPHER_CAMELLIA_256_CCM_STAR_NO_TAG, /**< Camellia cipher with 256-bit CCM_STAR_NO_TAG mode. */\0A    MBEDTLS_CIPHER_ARIA_128_ECB,         /**< Aria cipher with 128-bit key and ECB mode. */\0A    MBEDTLS_CIPHER_ARIA_192_ECB,         /**< Aria cipher with 192-bit key and ECB mode. */\0A    MBEDTLS_CIPHER_ARIA_256_ECB,         /**< Aria cipher with 256-bit key and ECB mode. */\0A    MBEDTLS_CIPHER_ARIA_128_CBC,         /**< Aria cipher with 128-bit key and CBC mode. */\0A    MBEDTLS_CIPHER_ARIA_192_CBC,         /**< Aria cipher with 192-bit key and CBC mode. */\0A    MBEDTLS_CIPHER_ARIA_256_CBC,         /**< Aria cipher with 256-bit key and CBC mode. */\0A    MBEDTLS_CIPHER_ARIA_128_CFB128,      /**< Aria cipher with 128-bit key and CFB-128 mode. */\0A    MBEDTLS_CIPHER_ARIA_192_CFB128,      /**< Aria cipher with 192-bit key and CFB-128 mode. */\0A    MBEDTLS_CIPHER_ARIA_256_CFB128,      /**< Aria cipher with 256-bit key and CFB-128 mode. */\0A    MBEDTLS_CIPHER_ARIA_128_CTR,         /**< Aria cipher with 128-bit key and CTR mode. */\0A    MBEDTLS_CIPHER_ARIA_192_CTR,         /**< Aria cipher with 192-bit key and CTR mode. */\0A    MBEDTLS_CIPHER_ARIA_256_CTR,         /**< Aria cipher with 256-bit key and CTR mode. */\0A    MBEDTLS_CIPHER_ARIA_128_GCM,         /**< Aria cipher with 128-bit key and GCM mode. */\0A    MBEDTLS_CIPHER_ARIA_192_GCM,         /**< Aria cipher with 192-bit key and GCM mode. */\0A    MBEDTLS_CIPHER_ARIA_256_GCM,         /**< Aria cipher with 256-bit key and GCM mode. */\0A    MBEDTLS_CIPHER_ARIA_128_CCM,         /**< Aria cipher with 128-bit key and CCM mode. */\0A    MBEDTLS_CIPHER_ARIA_192_CCM,         /**< Aria cipher with 192-bit key and CCM mode. */\0A    MBEDTLS_CIPHER_ARIA_256_CCM,         /**< Aria cipher with 256-bit key and CCM mode. */\0A    MBEDTLS_CIPHER_ARIA_128_CCM_STAR_NO_TAG, /**< Aria cipher with 128-bit key and CCM_STAR_NO_TAG mode. */\0A    MBEDTLS_CIPHER_ARIA_192_CCM_STAR_NO_TAG, /**< Aria cipher with 192-bit key and CCM_STAR_NO_TAG mode. */\0A    MBEDTLS_CIPHER_ARIA_256_CCM_STAR_NO_TAG, /**< Aria cipher with 256-bit key and CCM_STAR_NO_TAG mode. */\0A    MBEDTLS_CIPHER_AES_128_OFB,          /**< AES 128-bit cipher in OFB mode. */\0A    MBEDTLS_CIPHER_AES_192_OFB,          /**< AES 192-bit cipher in OFB mode. */\0A    MBEDTLS_CIPHER_AES_256_OFB,          /**< AES 256-bit cipher in OFB mode. */\0A    MBEDTLS_CIPHER_AES_128_XTS,          /**< AES 128-bit cipher in XTS block mode. */\0A    MBEDTLS_CIPHER_AES_256_XTS,          /**< AES 256-bit cipher in XTS block mode. */\0A    MBEDTLS_CIPHER_CHACHA20,             /**< ChaCha20 stream cipher. */\0A    MBEDTLS_CIPHER_CHACHA20_POLY1305,    /**< ChaCha20-Poly1305 AEAD cipher. */\0A    MBEDTLS_CIPHER_AES_128_KW,           /**< AES cipher with 128-bit NIST KW mode. */\0A    MBEDTLS_CIPHER_AES_192_KW,           /**< AES cipher with 192-bit NIST KW mode. */\0A    MBEDTLS_CIPHER_AES_256_KW,           /**< AES cipher with 256-bit NIST KW mode. */\0A    MBEDTLS_CIPHER_AES_128_KWP,          /**< AES cipher with 128-bit NIST KWP mode. */\0A    MBEDTLS_CIPHER_AES_192_KWP,          /**< AES cipher with 192-bit NIST KWP mode. */\0A    MBEDTLS_CIPHER_AES_256_KWP,          /**< AES cipher with 256-bit NIST KWP mode. */\0A} mbedtls_cipher_type_t;\0A\0A/** Supported cipher modes. */\0Atypedef enum {\0A    MBEDTLS_MODE_NONE = 0,               /**< None.                        */\0A    MBEDTLS_MODE_ECB,                    /**< The ECB cipher mode.         */\0A    MBEDTLS_MODE_CBC,                    /**< The CBC cipher mode.         */\0A    MBEDTLS_MODE_CFB,                    /**< The CFB cipher mode.         */\0A    MBEDTLS_MODE_OFB,                    /**< The OFB cipher mode.         */\0A    MBEDTLS_MODE_CTR,                    /**< The CTR cipher mode.         */\0A    MBEDTLS_MODE_GCM,                    /**< The GCM cipher mode.         */\0A    MBEDTLS_MODE_STREAM,                 /**< The stream cipher mode.      */\0A    MBEDTLS_MODE_CCM,                    /**< The CCM cipher mode.         */\0A    MBEDTLS_MODE_CCM_STAR_NO_TAG,        /**< The CCM*-no-tag cipher mode. */\0A    MBEDTLS_MODE_XTS,                    /**< The XTS cipher mode.         */\0A    MBEDTLS_MODE_CHACHAPOLY,             /**< The ChaCha-Poly cipher mode. */\0A    MBEDTLS_MODE_KW,                     /**< The SP800-38F KW mode */\0A    MBEDTLS_MODE_KWP,                    /**< The SP800-38F KWP mode */\0A} mbedtls_cipher_mode_t;\0A\0A/** Supported cipher padding types. */\0Atypedef enum {\0A    MBEDTLS_PADDING_PKCS7 = 0,     /**< PKCS7 padding (default).        */\0A    MBEDTLS_PADDING_ONE_AND_ZEROS, /**< ISO/IEC 7816-4 padding.         */\0A    MBEDTLS_PADDING_ZEROS_AND_LEN, /**< ANSI X.923 padding.             */\0A    MBEDTLS_PADDING_ZEROS,         /**< Zero padding (not reversible). */\0A    MBEDTLS_PADDING_NONE,          /**< Never pad (full blocks only).   */\0A} mbedtls_cipher_padding_t;\0A\0A/** Type of operation. */\0Atypedef enum {\0A    MBEDTLS_OPERATION_NONE = -1,\0A    MBEDTLS_DECRYPT = 0,\0A    MBEDTLS_ENCRYPT,\0A} mbedtls_operation_t;\0A\0Aenum {\0A    /** Undefined key length. */\0A    MBEDTLS_KEY_LENGTH_NONE = 0,\0A    /** Key length, in bits (including parity), for DES keys. \5Cwarning DES is considered weak. */\0A    MBEDTLS_KEY_LENGTH_DES  = 64,\0A    /** Key length in bits, including parity, for DES in two-key EDE. \5Cwarning 3DES is considered weak. */\0A    MBEDTLS_KEY_LENGTH_DES_EDE = 128,\0A    /** Key length in bits, including parity, for DES in three-key EDE. \5Cwarning 3DES is considered weak. */\0A    MBEDTLS_KEY_LENGTH_DES_EDE3 = 192,\0A};\0A\0A/** Maximum length of any IV, in Bytes. */\0A/* This should ideally be derived automatically from list of ciphers.\0A * This should be kept in sync with MBEDTLS_SSL_MAX_IV_LENGTH defined\0A * in library/ssl_misc.h. */\0A#define MBEDTLS_MAX_IV_LENGTH      16\0A\0A/** Maximum block size of any cipher, in Bytes. */\0A/* This should ideally be derived automatically from list of ciphers.\0A * This should be kept in sync with MBEDTLS_SSL_MAX_BLOCK_LENGTH defined\0A * in library/ssl_misc.h. */\0A#define MBEDTLS_MAX_BLOCK_LENGTH   16\0A\0A/** Maximum key length, in Bytes. */\0A/* This should ideally be derived automatically from list of ciphers.\0A * For now, only check whether XTS is enabled which uses 64 Byte keys,\0A * and use 32 Bytes as an upper bound for the maximum key length otherwise.\0A * This should be kept in sync with MBEDTLS_SSL_MAX_BLOCK_LENGTH defined\0A * in library/ssl_misc.h, which however deliberately ignores the case of XTS\0A * since the latter isn't used in SSL/TLS. */\0A#if defined(MBEDTLS_CIPHER_MODE_XTS)\0A#define MBEDTLS_MAX_KEY_LENGTH     64\0A#else\0A#define MBEDTLS_MAX_KEY_LENGTH     32\0A#endif /* MBEDTLS_CIPHER_MODE_XTS */\0A\0A/**\0A * Base cipher information (opaque struct).\0A */\0Atypedef struct mbedtls_cipher_base_t mbedtls_cipher_base_t;\0A\0A/**\0A * CMAC context (opaque struct).\0A */\0Atypedef struct mbedtls_cmac_context_t mbedtls_cmac_context_t;\0A\0A/**\0A * Cipher information. Allows calling cipher functions\0A * in a generic way.\0A *\0A * \5Cnote        The library does not support custom cipher info structures,\0A *              only built-in structures returned by the functions\0A *              mbedtls_cipher_info_from_string(),\0A *              mbedtls_cipher_info_from_type(),\0A *              mbedtls_cipher_info_from_values(),\0A *              mbedtls_cipher_info_from_psa().\0A *\0A * \5Cnote        Some fields store a value that has been right-shifted to save\0A *              code-size, so should not be used directly. The accessor\0A *              functions adjust for this and return the \22natural\22 value.\0A */\0Atypedef struct mbedtls_cipher_info_t {\0A    /** Name of the cipher. */\0A    const char *MBEDTLS_PRIVATE(name);\0A\0A    /** The block size, in bytes. */\0A    unsigned int MBEDTLS_PRIVATE(block_size) : 5;\0A\0A    /** IV or nonce size, in bytes (right shifted by #MBEDTLS_IV_SIZE_SHIFT).\0A     * For ciphers that accept variable IV sizes,\0A     * this is the recommended size.\0A     */\0A    unsigned int MBEDTLS_PRIVATE(iv_size) : 3;\0A\0A    /** The cipher key length, in bits (right shifted by #MBEDTLS_KEY_BITLEN_SHIFT).\0A     * This is the default length for variable sized ciphers.\0A     * Includes parity bits for ciphers like DES.\0A     */\0A    unsigned int MBEDTLS_PRIVATE(key_bitlen) : 4;\0A\0A    /** The cipher mode (as per mbedtls_cipher_mode_t).\0A     * For example, MBEDTLS_MODE_CBC.\0A     */\0A    unsigned int MBEDTLS_PRIVATE(mode) : 4;\0A\0A    /** Full cipher identifier (as per mbedtls_cipher_type_t).\0A     * For example, MBEDTLS_CIPHER_AES_256_CBC.\0A     *\0A     * This could be 7 bits, but 8 bits retains byte alignment for the\0A     * next field, which reduces code size to access that field.\0A     */\0A    unsigned int MBEDTLS_PRIVATE(type) : 8;\0A\0A    /** Bitflag comprised of MBEDTLS_CIPHER_VARIABLE_IV_LEN and\0A     *  MBEDTLS_CIPHER_VARIABLE_KEY_LEN indicating whether the\0A     *  cipher supports variable IV or variable key sizes, respectively.\0A     */\0A    unsigned int MBEDTLS_PRIVATE(flags) : 2;\0A\0A    /** Index to LUT for base cipher information and functions. */\0A    unsigned int MBEDTLS_PRIVATE(base_idx) : 5;\0A\0A} mbedtls_cipher_info_t;\0A\0A/* For internal use only.\0A * These are used to more compactly represent the fields above. */\0A#define MBEDTLS_KEY_BITLEN_SHIFT  6\0A#define MBEDTLS_IV_SIZE_SHIFT     2\0A/**\0A * Generic cipher context.\0A */\0Atypedef struct mbedtls_cipher_context_t {\0A    /** Information about the associated cipher. */\0A    const mbedtls_cipher_info_t *MBEDTLS_PRIVATE(cipher_info);\0A\0A    /** Key length to use. */\0A    int MBEDTLS_PRIVATE(key_bitlen);\0A\0A    /** Operation that the key of the context has been\0A     * initialized for.\0A     */\0A    mbedtls_operation_t MBEDTLS_PRIVATE(operation);\0A\0A#if defined(MBEDTLS_CIPHER_MODE_WITH_PADDING)\0A    /** Padding functions to use, if relevant for\0A     * the specific cipher mode.\0A     */\0A    void(*MBEDTLS_PRIVATE(add_padding))(unsigned char *output, size_t olen, size_t data_len);\0A    int(*MBEDTLS_PRIVATE(get_padding))(unsigned char *input, size_t ilen, size_t *data_len);\0A#endif\0A\0A    /** Buffer for input that has not been processed yet. */\0A    unsigned char MBEDTLS_PRIVATE(unprocessed_data)[MBEDTLS_MAX_BLOCK_LENGTH];\0A\0A    /** Number of Bytes that have not been processed yet. */\0A    size_t MBEDTLS_PRIVATE(unprocessed_len);\0A\0A    /** Current IV or NONCE_COUNTER for CTR-mode, data unit (or sector) number\0A     * for XTS-mode. */\0A    unsigned char MBEDTLS_PRIVATE(iv)[MBEDTLS_MAX_IV_LENGTH];\0A\0A    /** IV size in Bytes, for ciphers with variable-length IVs. */\0A    size_t MBEDTLS_PRIVATE(iv_size);\0A\0A    /** The cipher-specific context. */\0A    void *MBEDTLS_PRIVATE(cipher_ctx);\0A\0A#if defined(MBEDTLS_CMAC_C)\0A    /** CMAC-specific context. */\0A    mbedtls_cmac_context_t *MBEDTLS_PRIVATE(cmac_ctx);\0A#endif\0A\0A#if defined(MBEDTLS_USE_PSA_CRYPTO) && !defined(MBEDTLS_DEPRECATED_REMOVED)\0A    /** Indicates whether the cipher operations should be performed\0A     *  by Mbed TLS' own crypto library or an external implementation\0A     *  of the PSA Crypto API.\0A     *  This is unset if the cipher context was established through\0A     *  mbedtls_cipher_setup(), and set if it was established through\0A     *  mbedtls_cipher_setup_psa().\0A     */\0A    unsigned char MBEDTLS_PRIVATE(psa_enabled);\0A#endif /* MBEDTLS_USE_PSA_CRYPTO && !MBEDTLS_DEPRECATED_REMOVED */\0A\0A} mbedtls_cipher_context_t;\0A\0A/**\0A * \5Cbrief This function retrieves the list of ciphers supported\0A *        by the generic cipher module.\0A *\0A *        For any cipher identifier in the returned list, you can\0A *        obtain the corresponding generic cipher information structure\0A *        via mbedtls_cipher_info_from_type(), which can then be used\0A *        to prepare a cipher context via mbedtls_cipher_setup().\0A *\0A *\0A * \5Creturn      A statically-allocated array of cipher identifiers\0A *              of type cipher_type_t. The last entry is zero.\0A */\0Aconst int *mbedtls_cipher_list(void);\0A\0A/**\0A * \5Cbrief               This function retrieves the cipher-information\0A *                      structure associated with the given cipher name.\0A *\0A * \5Cparam cipher_name   Name of the cipher to search for. This must not be\0A *                      \5Cc NULL.\0A *\0A * \5Creturn              The cipher information structure associated with the\0A *                      given \5Cp cipher_name.\0A * \5Creturn              \5Cc NULL if the associated cipher information is not found.\0A */\0Aconst mbedtls_cipher_info_t *mbedtls_cipher_info_from_string(const char *cipher_name);\0A\0A/**\0A * \5Cbrief               This function retrieves the cipher-information\0A *                      structure associated with the given cipher type.\0A *\0A * \5Cparam cipher_type   Type of the cipher to search for.\0A *\0A * \5Creturn              The cipher information structure associated with the\0A *                      given \5Cp cipher_type.\0A * \5Creturn              \5Cc NULL if the associated cipher information is not found.\0A */\0Aconst mbedtls_cipher_info_t *mbedtls_cipher_info_from_type(const mbedtls_cipher_type_t cipher_type);\0A\0A/**\0A * \5Cbrief               This function retrieves the cipher-information\0A *                      structure associated with the given cipher ID,\0A *                      key size and mode.\0A *\0A * \5Cparam cipher_id     The ID of the cipher to search for. For example,\0A *                      #MBEDTLS_CIPHER_ID_AES.\0A * \5Cparam key_bitlen    The length of the key in bits.\0A * \5Cparam mode          The cipher mode. For example, #MBEDTLS_MODE_CBC.\0A *\0A * \5Creturn              The cipher information structure associated with the\0A *                      given \5Cp cipher_id.\0A * \5Creturn              \5Cc NULL if the associated cipher information is not found.\0A */\0Aconst mbedtls_cipher_info_t *mbedtls_ci