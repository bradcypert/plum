@.str39708 = private global { i64, i64, [5556 x i8] } { i64 -1, i64 5555, [5556 x i8] c"/**\0A * \5Cfile sha3.h\0A *\0A * \5Cbrief This file contains SHA-3 definitions and functions.\0A *\0A * The Secure Hash Algorithms cryptographic\0A * hash functions are defined in <em>FIPS 202: SHA-3 Standard:\0A * Permutation-Based Hash and Extendable-Output Functions </em>.\0A */\0A/*\0A *  Copyright The Mbed TLS Contributors\0A *  SPDX-License-Identifier: Apache-2.0 OR GPL-2.0-or-later\0A */\0A\0A#ifndef MBEDTLS_SHA3_H\0A#define MBEDTLS_SHA3_H\0A#include \22mbedtls/private_access.h\22\0A\0A#include \22mbedtls/build_info.h\22\0A\0A#include <stddef.h>\0A#include <stdint.h>\0A\0A#ifdef __cplusplus\0Aextern \22C\22 {\0A#endif\0A\0A/** SHA-3 input data was malformed. */\0A#define MBEDTLS_ERR_SHA3_BAD_INPUT_DATA                 -0x0076\0A\0A/**\0A * SHA-3 family id.\0A *\0A * It identifies the family (SHA3-256, SHA3-512, etc.)\0A */\0A\0Atypedef enum {\0A    MBEDTLS_SHA3_NONE = 0, /*!< Operation not defined. */\0A    MBEDTLS_SHA3_224, /*!< SHA3-224 */\0A    MBEDTLS_SHA3_256, /*!< SHA3-256 */\0A    MBEDTLS_SHA3_384, /*!< SHA3-384 */\0A    MBEDTLS_SHA3_512, /*!< SHA3-512 */\0A} mbedtls_sha3_id;\0A\0A/**\0A * \5Cbrief          The SHA-3 context structure.\0A *\0A *                 The structure is used SHA-3 checksum calculations.\0A */\0Atypedef struct {\0A    uint64_t MBEDTLS_PRIVATE(state[25]);\0A    uint32_t MBEDTLS_PRIVATE(index);\0A    uint16_t MBEDTLS_PRIVATE(olen);\0A    uint16_t MBEDTLS_PRIVATE(max_block_size);\0A}\0Ambedtls_sha3_context;\0A\0A/**\0A * \5Cbrief          This function initializes a SHA-3 context.\0A *\0A * \5Cparam ctx      The SHA-3 context to initialize. This must not be \5Cc NULL.\0A */\0Avoid mbedtls_sha3_init(mbedtls_sha3_context *ctx);\0A\0A/**\0A * \5Cbrief          This function clears a SHA-3 context.\0A *\0A * \5Cparam ctx      The SHA-3 context to clear. This may be \5Cc NULL, in which\0A *                 case this function returns immediately. If it is not \5Cc NULL,\0A *                 it must point to an initialized SHA-3 context.\0A */\0Avoid mbedtls_sha3_free(mbedtls_sha3_context *ctx);\0A\0A/**\0A * \5Cbrief          This function clones the state of a SHA-3 context.\0A *\0A * \5Cparam dst      The destination context. This must be initialized.\0A * \5Cparam src      The context to clone. This must be initialized.\0A */\0Avoid mbedtls_sha3_clone(mbedtls_sha3_context *dst,\0A                        const mbedtls_sha3_context *src);\0A\0A/**\0A * \5Cbrief          This function starts a SHA-3 checksum\0A *                 calculation.\0A *\0A * \5Cparam ctx      The context to use. This must be initialized.\0A * \5Cparam id       The id of the SHA-3 family.\0A *\0A * \5Creturn         \5Cc 0 on success.\0A * \5Creturn         A negative error code on failure.\0A */\0Aint mbedtls_sha3_starts(mbedtls_sha3_context *ctx, mbedtls_sha3_id id);\0A\0A/**\0A * \5Cbrief          This function feeds an input buffer into an ongoing\0A *                 SHA-3 checksum calculation.\0A *\0A * \5Cparam ctx      The SHA-3 context. This must be initialized\0A *                 and have a hash operation started.\0A * \5Cparam input    The buffer holding the data. This must be a readable\0A *                 buffer of length \5Cp ilen Bytes.\0A * \5Cparam ilen     The length of the input data in Bytes.\0A *\0A * \5Creturn         \5Cc 0 on success.\0A * \5Creturn         A negative error code on failure.\0A */\0Aint mbedtls_sha3_update(mbedtls_sha3_context *ctx,\0A                        const uint8_t *input,\0A                        size_t ilen);\0A\0A/**\0A * \5Cbrief          This function finishes the SHA-3 operation, and writes\0A *                 the result to the output buffer.\0A *\0A * \5Cparam ctx      The SHA-3 context. This must be initialized\0A *                 and have a hash operation started.\0A * \5Cparam output   The SHA-3 checksum result.\0A *                 This must be a writable buffer of length \5Cc olen bytes.\0A * \5Cparam olen     Defines the length of output buffer (in bytes). For SHA-3 224, SHA-3 256,\0A *                 SHA-3 384 and SHA-3 512 \5Cc olen must equal to 28, 32, 48 and 64,\0A *                 respectively.\0A *\0A * \5Creturn         \5Cc 0 on success.\0A * \5Creturn         A negative error code on failure.\0A */\0Aint mbedtls_sha3_finish(mbedtls_sha3_context *ctx,\0A                        uint8_t *output, size_t olen);\0A\0A/**\0A * \5Cbrief          This function calculates the SHA-3\0A *                 checksum of a buffer.\0A *\0A *                 The function allocates the context, performs the\0A *                 calculation, and frees the context.\0A *\0A *                 The SHA-3 result is calculated as\0A *                 output = SHA-3(id, input buffer, d).\0A *\0A * \5Cparam id       The id of the SHA-3 family.\0A * \5Cparam input    The buffer holding the data. This must be a readable\0A *                 buffer of length \5Cp ilen Bytes.\0A * \5Cparam ilen     The length of the input data in Bytes.\0A * \5Cparam output   The SHA-3 checksum result.\0A *                 This must be a writable buffer of length \5Cc olen bytes.\0A * \5Cparam olen     Defines the length of output buffer (in bytes). For SHA-3 224, SHA-3 256,\0A *                 SHA-3 384 and SHA-3 512 \5Cc olen must equal to 28, 32, 48 and 64,\0A *                 respectively.\0A *\0A * \5Creturn         \5Cc 0 on success.\0A * \5Creturn         A negative error code on failure.\0A */\0Aint mbedtls_sha3(mbedtls_sha3_id id, const uint8_t *input,\0A                 size_t ilen,\0A                 uint8_t *output,\0A                 size_t olen);\0A\0A#if defined(MBEDTLS_SELF_TEST)\0A/**\0A * \5Cbrief          Checkup routine for the algorithms implemented\0A *                 by this module: SHA3-224, SHA3-256, SHA3-384, SHA3-512.\0A *\0A * \5Creturn         0 if successful, or 1 if the test failed.\0A */\0Aint mbedtls_sha3_self_test(int verbose);\0A#endif /* MBEDTLS_SELF_TEST */\0A\0A#ifdef __cplusplus\0A}\0A#endif\0A\0A#endif /* mbedtls_sha3.h */\0A\00" }
