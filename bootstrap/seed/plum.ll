@.str41962 = private global { i64, i64, [13627 x i8] } { i64 -1, i64 13626, [13627 x i8] c"/*\0A *  Helper functions for the RSA module\0A *\0A *  Copyright The Mbed TLS Contributors\0A *  SPDX-License-Identifier: Apache-2.0 OR GPL-2.0-or-later\0A *\0A */\0A\0A#include \22common.h\22\0A\0A#if defined(MBEDTLS_RSA_C)\0A\0A#include \22mbedtls/rsa.h\22\0A#include \22mbedtls/bignum.h\22\0A#include \22rsa_alt_helpers.h\22\0A\0A/*\0A * Compute RSA prime factors from public and private exponents\0A *\0A * Summary of algorithm:\0A * Setting F := lcm(P-1,Q-1), the idea is as follows:\0A *\0A * (a) For any 1 <= X < N with gcd(X,N)=1, we have X^F = 1 modulo N, so X^(F/2)\0A *     is a square root of 1 in Z/NZ. Since Z/NZ ~= Z/PZ x Z/QZ by CRT and the\0A *     square roots of 1 in Z/PZ and Z/QZ are +1 and -1, this leaves the four\0A *     possibilities X^(F/2) = (+-1, +-1). If it happens that X^(F/2) = (-1,+1)\0A *     or (+1,-1), then gcd(X^(F/2) + 1, N) will be equal to one of the prime\0A *     factors of N.\0A *\0A * (b) If we don't know F/2 but (F/2) * K for some odd (!) K, then the same\0A *     construction still applies since (-)^K is the identity on the set of\0A *     roots of 1 in Z/NZ.\0A *\0A * The public and private key primitives (-)^E and (-)^D are mutually inverse\0A * bijections on Z/NZ if and only if (-)^(DE) is the identity on Z/NZ, i.e.\0A * if and only if DE - 1 is a multiple of F, say DE - 1 = F * L.\0A * Splitting L = 2^t * K with K odd, we have\0A *\0A *   DE - 1 = FL = (F/2) * (2^(t+1)) * K,\0A *\0A * so (F / 2) * K is among the numbers\0A *\0A *   (DE - 1) >> 1, (DE - 1) >> 2, ..., (DE - 1) >> ord\0A *\0A * where ord is the order of 2 in (DE - 1).\0A * We can therefore iterate through these numbers apply the construction\0A * of (a) and (b) above to attempt to factor N.\0A *\0A */\0Aint mbedtls_rsa_deduce_primes(mbedtls_mpi const *N,\0A                              mbedtls_mpi const *E, mbedtls_mpi const *D,\0A                              mbedtls_mpi *P, mbedtls_mpi *Q)\0A{\0A    int ret = 0;\0A\0A    uint16_t attempt;  /* Number of current attempt  */\0A    uint16_t iter;     /* Number of squares computed in the current attempt */\0A\0A    uint16_t order;    /* Order of 2 in DE - 1 */\0A\0A    mbedtls_mpi T;  /* Holds largest odd divisor of DE - 1     */\0A    mbedtls_mpi K;  /* Temporary holding the current candidate */\0A\0A    const unsigned char primes[] = { 2,\0A                                     3,    5,    7,   11,   13,   17,   19,   23,\0A                                     29,   31,   37,   41,   43,   47,   53,   59,\0A                                     61,   67,   71,   73,   79,   83,   89,   97,\0A                                     101,  103,  107,  109,  113,  127,  131,  137,\0A                                     139,  149,  151,  157,  163,  167,  173,  179,\0A                                     181,  191,  193,  197,  199,  211,  223,  227,\0A                                     229,  233,  239,  241,  251 };\0A\0A    const size_t num_primes = sizeof(primes) / sizeof(*primes);\0A\0A    if (P == NULL || Q == NULL || P->p != NULL || Q->p != NULL) {\0A        return MBEDTLS_ERR_MPI_BAD_INPUT_DATA;\0A    }\0A\0A    if (mbedtls_mpi_cmp_int(N, 0) <= 0 ||\0A        mbedtls_mpi_cmp_int(D, 1) <= 0 ||\0A        mbedtls_mpi_cmp_mpi(D, N) >= 0 ||\0A        mbedtls_mpi_cmp_int(E, 1) <= 0 ||\0A        mbedtls_mpi_cmp_mpi(E, N) >= 0) {\0A        return MBEDTLS_ERR_MPI_BAD_INPUT_DATA;\0A    }\0A\0A    /*\0A     * Initializations and temporary changes\0A     */\0A\0A    mbedtls_mpi_init(&K);\0A    mbedtls_mpi_init(&T);\0A\0A    /* T := DE - 1 */\0A    MBEDTLS_MPI_CHK(mbedtls_mpi_mul_mpi(&T, D,  E));\0A    MBEDTLS_MPI_CHK(mbedtls_mpi_sub_int(&T, &T, 1));\0A\0A    if ((order = (uint16_t) mbedtls_mpi_lsb(&T)) == 0) {\0A        ret = MBEDTLS_ERR_MPI_BAD_INPUT_DATA;\0A        goto cleanup;\0A    }\0A\0A    /* After this operation, T holds the largest odd divisor of DE - 1. */\0A    MBEDTLS_MPI_CHK(mbedtls_mpi_shift_r(&T, order));\0A\0A    /*\0A     * Actual work\0A     */\0A\0A    /* Skip trying 2 if N == 1 mod 8 */\0A    attempt = 0;\0A    if (N->p[0] % 8 == 1) {\0A        attempt = 1;\0A    }\0A\0A    for (; attempt < num_primes; ++attempt) {\0A        MBEDTLS_MPI_CHK(mbedtls_mpi_lset(&K, primes[attempt]));\0A\0A        /* Check if gcd(K,N) = 1 */\0A        MBEDTLS_MPI_CHK(mbedtls_mpi_gcd(P, &K, N));\0A        if (mbedtls_mpi_cmp_int(P, 1) != 0) {\0A            continue;\0A        }\0A\0A        /* Go through K^T + 1, K^(2T) + 1, K^(4T) + 1, ...\0A         * and check whether they have nontrivial GCD with N. */\0A        MBEDTLS_MPI_CHK(mbedtls_mpi_exp_mod(&K, &K, &T, N,\0A                                            Q /* temporarily use Q for storing Montgomery\0A                                               * multiplication helper values */));\0A\0A        for (iter = 1; iter <= order; ++iter) {\0A            /* If we reach 1 prematurely, there's no point\0A             * in continuing to square K */\0A            if (mbedtls_mpi_cmp_int(&K, 1) == 0) {\0A                break;\0A            }\0A\0A            MBEDTLS_MPI_CHK(mbedtls_mpi_add_int(&K, &K, 1));\0A            MBEDTLS_MPI_CHK(mbedtls_mpi_gcd(P, &K, N));\0A\0A            if (mbedtls_mpi_cmp_int(P, 1) ==  1 &&\0A                mbedtls_mpi_cmp_mpi(P, N) == -1) {\0A                /*\0A                 * Have found a nontrivial divisor P of N.\0A                 * Set Q := N / P.\0A                 */\0A\0A                MBEDTLS_MPI_CHK(mbedtls_mpi_div_mpi(Q, NULL, N, P));\0A                goto cleanup;\0A            }\0A\0A            MBEDTLS_MPI_CHK(mbedtls_mpi_sub_int(&K, &K, 1));\0A            MBEDTLS_MPI_CHK(mbedtls_mpi_mul_mpi(&K, &K, &K));\0A            MBEDTLS_MPI_CHK(mbedtls_mpi_mod_mpi(&K, &K, N));\0A        }\0A\0A        /*\0A         * If we get here, then either we prematurely aborted the loop because\0A         * we reached 1, or K holds primes[attempt]^(DE - 1) mod N, which must\0A         * be 1 if D,E,N were consistent.\0A         * Check if that's the case and abort if not, to avoid very long,\0A         * yet eventually failing, computations if N,D,E were not sane.\0A         */\0A        if (mbedtls_mpi_cmp_int(&K, 1) != 0) {\0A            break;\0A        }\0A    }\0A\0A    ret = MBEDTLS_ERR_MPI_BAD_INPUT_DATA;\0A\0Acleanup:\0A\0A    mbedtls_mpi_free(&K);\0A    mbedtls_mpi_free(&T);\0A    return ret;\0A}\0A\0A/*\0A * Given P, Q and the public exponent E, deduce D.\0A * This is essentially a modular inversion.\0A */\0Aint mbedtls_rsa_deduce_private_exponent(mbedtls_mpi const *P,\0A                                        mbedtls_mpi const *Q,\0A                                        mbedtls_mpi const *E,\0A                                        mbedtls_mpi *D)\0A{\0A    int ret = 0;\0A    mbedtls_mpi K, L;\0A\0A    if (D == NULL || mbedtls_mpi_cmp_int(D, 0) != 0) {\0A        return MBEDTLS_ERR_MPI_BAD_INPUT_DATA;\0A    }\0A\0A    if (mbedtls_mpi_cmp_int(P, 1) <= 0 ||\0A        mbedtls_mpi_cmp_int(Q, 1) <= 0 ||\0A        mbedtls_mpi_cmp_int(E, 0) == 0) {\0A        return MBEDTLS_ERR_MPI_BAD_INPUT_DATA;\0A    }\0A\0A    mbedtls_mpi_init(&K);\0A    mbedtls_mpi_init(&L);\0A\0A    /* Temporarily put K := P-1 and L := Q-1 */\0A    MBEDTLS_MPI_CHK(mbedtls_mpi_sub_int(&K, P, 1));\0A    MBEDTLS_MPI_CHK(mbedtls_mpi_sub_int(&L, Q, 1));\0A\0A    /* Temporarily put D := gcd(P-1, Q-1) */\0A    MBEDTLS_MPI_CHK(mbedtls_mpi_gcd(D, &K, &L));\0A\0A    /* K := LCM(P-1, Q-1) */\0A    MBEDTLS_MPI_CHK(mbedtls_mpi_mul_mpi(&K, &K, &L));\0A    MBEDTLS_MPI_CHK(mbedtls_mpi_div_mpi(&K, NULL, &K, D));\0A\0A    /* Compute modular inverse of E in LCM(P-1, Q-1) */\0A    MBEDTLS_MPI_CHK(mbedtls_mpi_inv_mod(D, E, &K));\0A\0Acleanup:\0A\0A    mbedtls_mpi_free(&K);\0A    mbedtls_mpi_free(&L);\0A\0A    return ret;\0A}\0A\0Aint mbedtls_rsa_deduce_crt(const mbedtls_mpi *P, const mbedtls_mpi *Q,\0A                           const mbedtls_mpi *D, mbedtls_mpi *DP,\0A                           mbedtls_mpi *DQ, mbedtls_mpi *QP)\0A{\0A    int ret = 0;\0A    mbedtls_mpi K;\0A    mbedtls_mpi_init(&K);\0A\0A    /* DP = D mod P-1 */\0A    if (DP != NULL) {\0A        MBEDTLS_MPI_CHK(mbedtls_mpi_sub_int(&K, P, 1));\0A        MBEDTLS_MPI_CHK(mbedtls_mpi_mod_mpi(DP, D, &K));\0A    }\0A\0A    /* DQ = D mod Q-1 */\0A    if (DQ != NULL) {\0A        MBEDTLS_MPI_CHK(mbedtls_mpi_sub_int(&K, Q, 1));\0A        MBEDTLS_MPI_CHK(mbedtls_mpi_mod_mpi(DQ, D, &K));\0A    }\0A\0A    /* QP = Q^{-1} mod P */\0A    if (QP != NULL) {\0A        MBEDTLS_MPI_CHK(mbedtls_mpi_inv_mod(QP, Q, P));\0A    }\0A\0Acleanup:\0A    mbedtls_mpi_free(&K);\0A\0A    return ret;\0A}\0A\0A/*\0A * Check that core RSA parameters are sane.\0A */\0Aint mbedtls_rsa_validate_params(const mbedtls_mpi *N, const mbedtls_mpi *P,\0A                                const mbedtls_mpi *Q, const mbedtls_mpi *D,\0A                                const mbedtls_mpi *E,\0A                                int (*f_rng)(void *, unsigned char *, size_t),\0A                                void *p_rng)\0A{\0A    int ret = 0;\0A    mbedtls_mpi K, L;\0A\0A    mbedtls_mpi_init(&K);\0A    mbedtls_mpi_init(&L);\0A\0A    /*\0A     * Step 1: If PRNG provided, check that P and Q are prime\0A     */\0A\0A#if defined(MBEDTLS_GENPRIME)\0A    /*\0A     * When generating keys, the strongest security we support aims for an error\0A     * rate of at most 2^-100 and we are aiming for the same certainty here as\0A     * well.\0A     */\0A    if (f_rng != NULL && P != NULL &&\0A        (ret = mbedtls_mpi_is_prime_ext(P, 50, f_rng, p_rng)) != 0) {\0A        ret = MBEDTLS_ERR_RSA_KEY_CHECK_FAILED;\0A        goto cleanup;\0A    }\0A\0A    if (f_rng != NULL && Q != NULL &&\0A        (ret = mbedtls_mpi_is_prime_ext(Q, 50, f_rng, p_rng)) != 0) {\0A        ret = MBEDTLS_ERR_RSA_KEY_CHECK_FAILED;\0A        goto cleanup;\0A    }\0A#else\0A    ((void) f_rng);\0A    ((void) p_rng);\0A#endif /* MBEDTLS_GENPRIME */\0A\0A    /*\0A     * Step 2: Check that 1 < N = P * Q\0A     */\0A\0A    if (P != NULL && Q != NULL && N != NULL) {\0A        MBEDTLS_MPI_CHK(mbedtls_mpi_mul_mpi(&K, P, Q));\0A        if (mbedtls_mpi_cmp_int(N, 1)  <= 0 ||\0A            mbedtls_mpi_cmp_mpi(&K, N) != 0) {\0A            ret = MBEDTLS_ERR_RSA_KEY_CHECK_FAILED;\0A            goto cleanup;\0A        }\0A    }\0A\0A    /*\0A     * Step 3: Check and 1 < D, E < N if present.\0A     */\0A\0A    if (N != NULL && D != NULL && E != NULL) {\0A        if (mbedtls_mpi_cmp_int(D, 1) <= 0 ||\0A            mbedtls_mpi_cmp_int(E, 1) <= 0 ||\0A            mbedtls_mpi_cmp_mpi(D, N) >= 0 ||\0A            mbedtls_mpi_cmp_mpi(E, N) >= 0) {\0A            ret = MBEDTLS_ERR_RSA_KEY_CHECK_FAILED;\0A            goto cleanup;\0A        }\0A    }\0A\0A    /*\0A     * Step 4: Check that D, E are inverse modulo P-1 and Q-1\0A     */\0A\0A    if (P != NULL && Q != NULL && D != NULL && E != NULL) {\0A        if (mbedtls_mpi_cmp_int(P, 1) <= 0 ||\0A            mbedtls_mpi_cmp_int(Q, 1) <= 0) {\0A            ret = MBEDTLS_ERR_RSA_KEY_CHECK_FAILED;\0A            goto cleanup;\0A        }\0A\0A        /* Compute DE-1 mod P-1 */\0A        MBEDTLS_MPI_CHK(mbedtls_mpi_mul_mpi(&K, D, E));\0A        MBEDTLS_MPI_CHK(mbedtls_mpi_sub_int(&K, &K, 1));\0A        MBEDTLS_MPI_CHK(mbedtls_mpi_sub_int(&L, P, 1));\0A        MBEDTLS_MPI_CHK(mbedtls_mpi_mod_mpi(&K, &K, &L));\0A        if (mbedtls_mpi_cmp_int(&K, 0) != 0) {\0A            ret = MBEDTLS_ERR_RSA_KEY_CHECK_FAILED;\0A            goto cleanup;\0A        }\0A\0A        /* Compute DE-1 mod Q-1 */\0A        MBEDTLS_MPI_CHK(mbedtls_mpi_mul_mpi(&K, D, E));\0A        MBEDTLS_MPI_CHK(mbedtls_mpi_sub_int(&K, &K, 1));\0A        MBEDTLS_MPI_CHK(mbedtls_mpi_sub_int(&L, Q, 1));\0A        MBEDTLS_MPI_CHK(mbedtls_mpi_mod_mpi(&K, &K, &L));\0A        if (mbedtls_mpi_cmp_int(&K, 0) != 0) {\0A            ret = MBEDTLS_ERR_RSA_KEY_CHECK_FAILED;\0A            goto cleanup;\0A        }\0A    }\0A\0Acleanup:\0A\0A    mbedtls_mpi_free(&K);\0A    mbedtls_mpi_free(&L);\0A\0A    /* Wrap MPI error codes by RSA check failure error code */\0A    if (ret != 0 && ret != MBEDTLS_ERR_RSA_KEY_CHECK_FAILED) {\0A        ret += MBEDTLS_ERR_RSA_KEY_CHECK_FAILED;\0A    }\0A\0A    return ret;\0A}\0A\0A/*\0A * Check that RSA CRT parameters are in accordance with core parameters.\0A */\0Aint mbedtls_rsa_validate_crt(const mbedtls_mpi *P,  const mbedtls_mpi *Q,\0A                             const mbedtls_mpi *D,  const mbedtls_mpi *DP,\0A                             const mbedtls_mpi *DQ, const mbedtls_mpi *QP)\0A{\0A    int ret = 0;\0A\0A    mbedtls_mpi K, L;\0A    mbedtls_mpi_init(&K);\0A    mbedtls_mpi_init(&L);\0A\0A    /* Check that DP - D == 0 mod P - 1 */\0A    if (DP != NULL) {\0A        if (P == NULL) {\0A            ret = MBEDTLS_ERR_RSA_BAD_INPUT_DATA;\0A            goto cleanup;\0A        }\0A\0A        MBEDTLS_MPI_CHK(mbedtls_mpi_sub_int(&K, P, 1));\0A        MBEDTLS_MPI_CHK(mbedtls_mpi_sub_mpi(&L, DP, D));\0A        MBEDTLS_MPI_CHK(mbedtls_mpi_mod_mpi(&L, &L, &K));\0A\0A        if (mbedtls_mpi_cmp_int(&L, 0) != 0) {\0A            ret = MBEDTLS_ERR_RSA_KEY_CHECK_FAILED;\0A            goto cleanup;\0A        }\0A    }\0A\0A    /* Check that DQ - D == 0 mod Q - 1 */\0A    if (DQ != NULL) {\0A        if (Q == NULL) {\0A            ret = MBEDTLS_ERR_RSA_BAD_INPUT_DATA;\0A            goto cleanup;\0A        }\0A\0A        MBEDTLS_MPI_CHK(mbedtls_mpi_sub_int(&K, Q, 1));\0A        MBEDTLS_MPI_CHK(mbedtls_mpi_sub_mpi(&L, DQ, D));\0A        MBEDTLS_MPI_CHK(mbedtls_mpi_mod_mpi(&L, &L, &K));\0A\0A        if (mbedtls_mpi_cmp_int(&L, 0) != 0) {\0A            ret = MBEDTLS_ERR_RSA_KEY_CHECK_FAILED;\0A            goto cleanup;\0A        }\0A    }\0A\0A    /* Check that QP * Q - 1 == 0 mod P */\0A    if (QP != NULL) {\0A        if (P == NULL || Q == NULL) {\0A            ret = MBEDTLS_ERR_RSA_BAD_INPUT_DATA;\0A            goto cleanup;\0A        }\0A\0A        MBEDTLS_MPI_CHK(mbedtls_mpi_mul_mpi(&K, QP, Q));\0A        MBEDTLS_MPI_CHK(mbedtls_mpi_sub_int(&K, &K, 1));\0A        MBEDTLS_MPI_CHK(mbedtls_mpi_mod_mpi(&K, &K, P));\0A        if (mbedtls_mpi_cmp_int(&K, 0) != 0) {\0A            ret = MBEDTLS_ERR_RSA_KEY_CHECK_FAILED;\0A            goto cleanup;\0A        }\0A    }\0A\0Acleanup:\0A\0A    /* Wrap MPI error codes by RSA check failure error code */\0A    if (ret != 0 &&\0A        ret != MBEDTLS_ERR_RSA_KEY_CHECK_FAILED &&\0A        ret != MBEDTLS_ERR_RSA_BAD_INPUT_DATA) {\0A        ret += MBEDTLS_ERR_RSA_KEY_CHECK_FAILED;\0A    }\0A\0A    mbedtls_mpi_free(&K);\0A    mbedtls_mpi_free(&L);\0A\0A    return ret;\0A}\0A\0A#endif /* MBEDTLS_RSA_C */\0A\00" }
@.const41964 = private global <{ i64, ptr, ptr, i1, [7 x i8] }> <{ i64 -1, ptr @.str41960, ptr @.str41962, i1 1, [7 x i8] zeroinitializer }>
@.str41965 = private global { i64, i64, [34 x i8] } { i64 -1, i64 33, [34 x i8] c"mbedtls/library/rsa_alt_helpers.h\00" }
@.str41967 = private global { i64, i64, [8306 x i8] } { i64 -1, i64 8305, [8306 x i8] c"/**\0A * \5Cfile rsa_alt_helpers.h\0A *\0A * \5Cbrief Context-independent RSA helper functions\0A *\0A *  This module declares some RSA-related helper functions useful when\0A *  implementing the RSA interface. These functions are provided in a separate\0A *  compilation unit in order to make it easy for designers of alternative RSA\0A *  implementations to use them in their own code, as it is conceived that the\0A *  functionality they provide will be necessary for most complete\0A *  implementations.\0A *\0A *  End-users of Mbed TLS who are not providing their own alternative RSA\0A *  implementations should not use these functions directly, and should instead\0A *  use only the functions declared in rsa.h.\0A *\0A *  The interface provided by this module will be maintained through LTS (Long\0A *  Term Support) branches of Mbed TLS, but may otherwise be subject to change,\0A *  and must be considered an internal interface of the library.\0A *\0A *  There are two classes of helper functions:\0A *\0A *  (1) Parameter-generating helpers. These are:\0A *      - mbedtls_rsa_deduce_primes\0A *      - mbedtls_rsa_deduce_private_exponent\0A *      - mbedtls_rsa_deduce_crt\0A *       Each of these functions takes a set of core RSA parameters and\0A *       generates some other, or CRT related parameters.\0A *\0A *  (2) Parameter-checking helpers. These are:\0A *      - mbedtls_rsa_validate_params\0A *      - mbedtls_rsa_validate_crt\0A *      They take a set of core or CRT related RSA parameters and check their\0A *      validity.\0A *\0A */\0A/*\0A *  Copyright The Mbed TLS Contributors\0A *  SPDX-License-Identifier: Apache-2.0 OR GPL-2.0-or-later\0A */\0A#ifndef MBEDTLS_RSA_ALT_HELPERS_H\0A#define MBEDTLS_RSA_ALT_HELPERS_H\0A\0A#include \22mbedtls/build_info.h\22\0A\0A#include \22mbedtls/bignum.h\22\0A\0A#ifdef __cplusplus\0Aextern \22C\22 {\0A#endif\0A\0A\0A/**\0A * \5Cbrief          Compute RSA prime moduli P, Q from public modulus N=PQ\0A *                 and a pair of private and public key.\0A *\0A * \5Cnote           This is a 'static' helper function not operating on\0A *                 an RSA context. Alternative implementations need not\0A *                 overwrite it.\0A *\0A * \5Cparam N        RSA modulus N = PQ, with P, Q to be found\0A * \5Cparam E        RSA public exponent\0A * \5Cparam D        RSA private exponent\0A * \5Cparam P        Pointer to MPI holding first prime factor of N on success\0A * \5Cparam Q        Pointer to MPI holding second prime factor of N on success\0A *\0A * \5Creturn\0A *                 - 0 if successful. In this case, P and Q constitute a\0A *                   factorization of N.\0A *                 - A non-zero error code otherwise.\0A *\0A * \5Cnote           It is neither checked that P, Q are prime nor that\0A *                 D, E are modular inverses wrt. P-1 and Q-1. For that,\0A *                 use the helper function \5Cc mbedtls_rsa_validate_params.\0A *\0A */\0Aint mbedtls_rsa_deduce_primes(mbedtls_mpi const *N, mbedtls_mpi const *E,\0A                              mbedtls_mpi const *D,\0A                              mbedtls_mpi *P, mbedtls_mpi *Q);\0A\0A/**\0A * \5Cbrief          Compute RSA private exponent from\0A *                 prime moduli and public key.\0A *\0A * \5Cnote           This is a 'static' helper function not operating on\0A *                 an RSA context. Alternative implementations need not\0A *                 overwrite it.\0A *\0A * \5Cparam P        First prime factor of RSA modulus\0A * \5Cparam Q        Second prime factor of RSA modulus\0A * \5Cparam E        RSA public exponent\0A * \5Cparam D        Pointer to MPI holding the private exponent on success.\0A *\0A * \5Creturn\0A *                 - 0 if successful. In this case, D is set to a simultaneous\0A *                   modular inverse of E modulo both P-1 and Q-1.\0A *                 - A non-zero error code otherwise.\0A *\0A * \5Cnote           This function does not check whether P and Q are primes.\0A *\0A */\0Aint mbedtls_rsa_deduce_private_exponent(mbedtls_mpi const *P,\0A                                        mbedtls_mpi const *Q,\0A                                        mbedtls_mpi const *E,\0A                                        mbedtls_mpi *D);\0A\0A\0A/**\0A * \5Cbrief          Generate RSA-CRT parameters\0A *\0A * \5Cnote           This is a 'static' helper function not operating on\0A *                 an RSA context. Alternative implementations need not\0A *                 overwrite it.\0A *\0A * \5Cparam P        First prime factor of N\0A * \5Cparam Q        Second prime factor of N\0A * \5Cparam D        RSA private exponent\0A * \5Cparam DP       Output variable for D modulo P-1\0A * \5Cparam DQ       Output variable for D modulo Q-1\0A * \5Cparam QP       Output variable for the modular inverse of Q modulo P.\0A *\0A * \5Creturn         0 on success, non-zero error code otherwise.\0A *\0A * \5Cnote           This function does not check whether P, Q are\0A *                 prime and whether D is a valid private exponent.\0A *\0A */\0Aint mbedtls_rsa_deduce_crt(const mbedtls_mpi *P, const mbedtls_mpi *Q,\0A                           const mbedtls_mpi *D, mbedtls_mpi *DP,\0A                           mbedtls_mpi *DQ, mbedtls_mpi *QP);\0A\0A\0A/**\0A * \5Cbrief          Check validity of core RSA parameters\0A *\0A * \5Cnote           This is a 'static' helper function not operating on\0A *                 an RSA context. Alternative implementations need not\0A *                 overwrite it.\0A *\0A * \5Cparam N        RSA modulus N = PQ\0A * \5Cparam P        First prime factor of N\0A * \5Cparam Q        Second prime factor of N\0A * \5Cparam D        RSA private exponent\0A * \5Cparam E        RSA public exponent\0A * \5Cparam f_rng    PRNG to be used for primality check, or NULL\0A * \5Cparam p_rng    PRNG context for f_rng