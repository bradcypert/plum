@.str40049 = private global { i64, i64, [16905 x i8] } { i64 -1, i64 16904, [16905 x i8] c"/**\0A * \5Cfile chacha20.c\0A *\0A * \5Cbrief ChaCha20 cipher.\0A *\0A * \5Cauthor Daniel King <damaki.gh@gmail.com>\0A *\0A *  Copyright The Mbed TLS Contributors\0A *  SPDX-License-Identifier: Apache-2.0 OR GPL-2.0-or-later\0A */\0A\0A#include \22common.h\22\0A\0A#if defined(MBEDTLS_CHACHA20_C)\0A\0A#include \22mbedtls/chacha20.h\22\0A#include \22mbedtls/platform_util.h\22\0A#include \22mbedtls/error.h\22\0A\0A#include <stddef.h>\0A#include <string.h>\0A\0A#include \22mbedtls/platform.h\22\0A\0A#if !defined(MBEDTLS_CHACHA20_ALT)\0A\0A#define ROTL32(value, amount) \5C\0A    ((uint32_t) ((value) << (amount)) | ((value) >> (32 - (amount))))\0A\0A#define CHACHA20_CTR_INDEX (12U)\0A\0A#define CHACHA20_BLOCK_SIZE_BYTES (4U * 16U)\0A\0A/**\0A * \5Cbrief           ChaCha20 quarter round operation.\0A *\0A *                  The quarter round is defined as follows (from RFC 7539):\0A *                      1.  a += b; d ^= a; d <<<= 16;\0A *                      2.  c += d; b ^= c; b <<<= 12;\0A *                      3.  a += b; d ^= a; d <<<= 8;\0A *                      4.  c += d; b ^= c; b <<<= 7;\0A *\0A * \5Cparam state     ChaCha20 state to modify.\0A * \5Cparam a         The index of 'a' in the state.\0A * \5Cparam b         The index of 'b' in the state.\0A * \5Cparam c         The index of 'c' in the state.\0A * \5Cparam d         The index of 'd' in the state.\0A */\0Astatic inline void chacha20_quarter_round(uint32_t state[16],\0A                                          size_t a,\0A                                          size_t b,\0A                                          size_t c,\0A                                          size_t d)\0A{\0A    /* a += b; d ^= a; d <<<= 16; */\0A    state[a] += state[b];\0A    state[d] ^= state[a];\0A    state[d] = ROTL32(state[d], 16);\0A\0A    /* c += d; b ^= c; b <<<= 12 */\0A    state[c] += state[d];\0A    state[b] ^= state[c];\0A    state[b] = ROTL32(state[b], 12);\0A\0A    /* a += b; d ^= a; d <<<= 8; */\0A    state[a] += state[b];\0A    state[d] ^= state[a];\0A    state[d] = ROTL32(state[d], 8);\0A\0A    /* c += d; b ^= c; b <<<= 7; */\0A    state[c] += state[d];\0A    state[b] ^= state[c];\0A    state[b] = ROTL32(state[b], 7);\0A}\0A\0A/**\0A * \5Cbrief           Perform the ChaCha20 inner block operation.\0A *\0A *                  This function performs two rounds: the column round and the\0A *                  diagonal round.\0A *\0A * \5Cparam state     The ChaCha20 state to update.\0A */\0Astatic void chacha20_inner_block(uint32_t state[16])\0A{\0A    chacha20_quarter_round(state, 0, 4, 8,  12);\0A    chacha20_quarter_round(state, 1, 5, 9,  13);\0A    chacha20_quarter_round(state, 2, 6, 10, 14);\0A    chacha20_quarter_round(state, 3, 7, 11, 15);\0A\0A    chacha20_quarter_round(state, 0, 5, 10, 15);\0A    chacha20_quarter_round(state, 1, 6, 11, 12);\0A    chacha20_quarter_round(state, 2, 7, 8,  13);\0A    chacha20_quarter_round(state, 3, 4, 9,  14);\0A}\0A\0A/**\0A * \5Cbrief               Generates a keystream block.\0A *\0A * \5Cparam initial_state The initial ChaCha20 state (key, nonce, counter).\0A * \5Cparam keystream     Generated keystream bytes are written to this buffer.\0A */\0Astatic void chacha20_block(const uint32_t initial_state[16],\0A                           unsigned char keystream[64])\0A{\0A    uint32_t working_state[16];\0A    size_t i;\0A\0A    memcpy(working_state,\0A           initial_state,\0A           CHACHA20_BLOCK_SIZE_BYTES);\0A\0A    for (i = 0U; i < 10U; i++) {\0A        chacha20_inner_block(working_state);\0A    }\0A\0A    working_state[0] += initial_state[0];\0A    working_state[1] += initial_state[1];\0A    working_state[2] += initial_state[2];\0A    working_state[3] += initial_state[3];\0A    working_state[4] += initial_state[4];\0A    working_state[5] += initial_state[5];\0A    working_state[6] += initial_state[6];\0A    working_state[7] += initial_state[7];\0A    working_state[8] += initial_state[8];\0A    working_state[9] += initial_state[9];\0A    working_state[10] += initial_state[10];\0A    working_state[11] += initial_state[11];\0A    working_state[12] += initial_state[12];\0A    working_state[13] += initial_state[13];\0A    working_state[14] += initial_state[14];\0A    working_state[15] += initial_state[15];\0A\0A    for (i = 0U; i < 16; i++) {\0A        size_t offset = i * 4U;\0A\0A        MBEDTLS_PUT_UINT32_LE(working_state[i], keystream, offset);\0A    }\0A\0A    mbedtls_platform_zeroize(working_state, sizeof(working_state));\0A}\0A\0Avoid mbedtls_chacha20_init(mbedtls_chacha20_context *ctx)\0A{\0A    mbedtls_platform_zeroize(ctx->state, sizeof(ctx->state));\0A    mbedtls_platform_zeroize(ctx->keystream8, sizeof(ctx->keystream8));\0A\0A    /* Initially, there's no keystream bytes available */\0A    ctx->keystream_bytes_used = CHACHA20_BLOCK_SIZE_BYTES;\0A}\0A\0Avoid mbedtls_chacha20_free(mbedtls_chacha20_context *ctx)\0A{\0A    if (ctx != NULL) {\0A        mbedtls_platform_zeroize(ctx, sizeof(mbedtls_chacha20_context));\0A    }\0A}\0A\0Aint mbedtls_chacha20_setkey(mbedtls_chacha20_context *ctx,\0A                            const unsigned char key[32])\0A{\0A    /* ChaCha20 constants - the string \22expand 32-byte k\22 */\0A    ctx->state[0] = 0x61707865;\0A    ctx->state[1] = 0x3320646e;\0A    ctx->state[2] = 0x79622d32;\0A    ctx->state[3] = 0x6b206574;\0A\0A    /* Set key */\0A    ctx->state[4]  = MBEDTLS_GET_UINT32_LE(key, 0);\0A    ctx->state[5]  = MBEDTLS_GET_UINT32_LE(key, 4);\0A    ctx->state[6]  = MBEDTLS_GET_UINT32_LE(key, 8);\0A    ctx->state[7]  = MBEDTLS_GET_UINT32_LE(key, 12);\0A    ctx->state[8]  = MBEDTLS_GET_UINT32_LE(key, 16);\0A    ctx->state[9]  = MBEDTLS_GET_UINT32_LE(key, 20);\0A    ctx->state[10] = MBEDTLS_GET_UINT32_LE(key, 24);\0A    ctx->state[11] = MBEDTLS_GET_UINT32_LE(key, 28);\0A\0A    return 0;\0A}\0A\0Aint mbedtls_chacha20_starts(mbedtls_chacha20_context *ctx,\0A 