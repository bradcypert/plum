;\0A\0A        /* check GCD( E, (P-1)*(Q-1) ) == 1 (FIPS 186-4 §B.3.1 criterion 2(a)) */\0A        MBEDTLS_MPI_CHK(mbedtls_mpi_gcd(&G, &ctx->E, &H));\0A        if (mbedtls_mpi_cmp_int(&G, 1) != 0) {\0A            continue;\0A        }\0A\0A        /* compute smallest possible D = E^-1 mod LCM(P-1, Q-1) (FIPS 186-4 §B.3.1 criterion 3(b)) */\0A        MBEDTLS_MPI_CHK(mbedtls_mpi_gcd(&G, &ctx->P, &ctx->Q));\0A        MBEDTLS_MPI_CHK(mbedtls_mpi_div_mpi(&L, NULL, &H, &G));\0A        MBEDTLS_MPI_CHK(mbedtls_mpi_inv_mod(&ctx->D, &ctx->E, &L));\0A\0A        if (mbedtls_mpi_bitlen(&ctx->D) <= ((nbits + 1) / 2)) {      // (FIPS 186-4 §B.3.1 criterion 3(a))\0A            continue;\0A        }\0A\0A        break;\0A    } while (1);\0A\0A    /* Restore P,Q */\0A    MBEDTLS_MPI_CHK(mbedtls_mpi_add_int(&ctx->P,  &ctx->P, 1));\0A    MBEDTLS_MPI_CHK(mbedtls_mpi_add_int(&ctx->Q,  &ctx->Q, 1));\0A\0A    MBEDTLS_MPI_CHK(mbedtls_mpi_mul_mpi(&ctx->N, &ctx->P, &ctx->Q));\0A\0A    ctx->len = mbedtls_mpi_size(&ctx->N);\0A\0A#if !defined(MBEDTLS_RSA_NO_CRT)\0A    /*\0A     * DP = D mod (P - 1)\0A     * DQ = D mod (Q - 1)\0A     * QP = Q^-1 mod P\0A     */\0A    MBEDTLS_MPI_CHK(mbedtls_rsa_deduce_crt(&ctx->P, &ctx->Q, &ctx->D,\0A                                           &ctx->DP, &ctx->DQ, &ctx->QP));\0A#endif /* MBEDTLS_RSA_NO_CRT */\0A\0A    /* Double-check */\0A    MBEDTLS_MPI_CHK(mbedtls_rsa_check_privkey(ctx));\0A\0Acleanup:\0A\0A    mbedtls_mpi_free(&H);\0A    mbedtls_mpi_free(&G);\0A    mbedtls_mpi_free(&L);\0A\0A    if (ret != 0) {\0A        mbedtls_rsa_free(ctx);\0A\0A        if ((-ret & ~0x7f) == 0) {\0A            ret = MBEDTLS_ERROR_ADD(MBEDTLS_ERR_RSA_KEY_GEN_FAILED, ret);\0A        }\0A        return ret;\0A    }\0A\0A    return 0;\0A}\0A\0A#endif /* MBEDTLS_GENPRIME */\0A\0A/*\0A * Check a public RSA key\0A */\0Aint mbedtls_rsa_check_pubkey(const mbedtls_rsa_context *ctx)\0A{\0A    if (rsa_check_context(ctx, 0 /* public */, 0 /* no blinding */) != 0) {\0A        return MBEDTLS_ERR_RSA_KEY_CHECK_FAILED;\0A    }\0A\0A    if (mbedtls_mpi_bitlen(&ctx->N) < 128) {\0A        return MBEDTLS_ERR_RSA_KEY_CHECK_FAILED;\0A    }\0A\0A    if (mbedtls_mpi_get_bit(&ctx->E, 0) == 0 ||\0A        mbedtls_mpi_bitlen(&ctx->E)     < 2  ||\0A        mbedtls_mpi_cmp_mpi(&ctx->E, &ctx->N) >= 0) {\0A        return MBEDTLS_ERR_RSA_KEY_CHECK_FAILED;\0A    }\0A\0A    return 0;\0A}\0A\0A/*\0A * Check for the consistency of all fields in an RSA private key context\0A */\0Aint mbedtls_rsa_check_privkey(const mbedtls_rsa_context *ctx)\0A{\0A    if (mbedtls_rsa_check_pubkey(ctx) != 0 ||\0A        rsa_check_context(ctx, 1 /* private */, 1 /* blinding */) != 0) {\0A        return MBEDTLS_ERR_RSA_KEY_CHECK_FAILED;\0A    }\0A\0A    if (mbedtls_rsa_validate_params(&ctx->N, &ctx->P, &ctx->Q,\0A                                    &ctx->D, &ctx->E, NULL, NULL) != 0) {\0A        return MBEDTLS_ERR_RSA_KEY_CHECK_FAILED;\0A    }\0A\0A#if !defined(MBEDTLS_RSA_NO_CRT)\0A    else if (mbedtls_rsa_validate_crt(&ctx->P, &ctx->Q, &ctx->D,\0A                                      &ctx->DP, &ctx->DQ, &ctx->QP) != 0) {\0A        return MBEDTLS_ERR_RSA_KEY_CHECK_FAILED;\0A    }\0A#endif\0A\0A    return 0;\0A}\0A\0A/*\0A * Check if contexts holding a public and private key match\0A */\0Aint mbedtls_rsa_check_pub_priv(const mbedtls_rsa_context *pub,\0A                               const mbedtls_rsa_context *prv)\0A{\0A    if (mbedtls_rsa_check_pubkey(pub)  != 0 ||\0A        mbedtls_rsa_check_privkey(prv) != 0) {\0A        return MBEDTLS_ERR_RSA_KEY_CHECK_FAILED;\0A    }\0A\0A    if (mbedtls_mpi_cmp_mpi(&pub->N, &prv->N) != 0 ||\0A        mbedtls_mpi_cmp_mpi(&pub->E, &prv->E) != 0) {\0A        return MBEDTLS_ERR_RSA_KEY_CHECK_FAILED;\0A    }\0A\0A    return 0;\0A}\0A\0A/*\0A * Do an RSA public key operation\0A */\0Aint mbedtls_rsa_public(mbedtls_rsa_context *ctx,\0A                       const unsigned char *input,\0A                       unsigned char *output)\0A{\0A    int ret = MBEDTLS_ERR_ERROR_CORRUPTION_DETECTED;\0A    size_t olen;\0A    mbedtls_mpi T;\0A\0A    if (rsa_check_context(ctx, 0 /* public */, 0 /* no blinding */)) {\0A        return MBEDTLS_ERR_RSA_BAD_INPUT_DATA;\0A    }\0A\0A    mbedtls_mpi_init(&T);\0A\0A#if defined(MBEDTLS_THREADING_C)\0A    if ((ret = mbedtls_mutex_lock(&ctx->mutex)) != 0) {\0A        return ret;\0A    }\0A#endif\0A\0A    MBEDTLS_MPI_CHK(mbedtls_mpi_read_binary(&T, input, ctx->len));\0A\0A    if (mbedtls_mpi_cmp_mpi(&T, &ctx->N) >= 0) {\0A        ret = MBEDTLS_ERR_MPI_BAD_INPUT_DATA;\0A        goto cleanup;\0A    }\0A\0A    olen = ctx->len;\0A    MBEDTLS_MPI_CHK(mbedtls_mpi_exp_mod_unsafe(&T, &T, &ctx->E, &ctx->N, &ctx->RN));\0A    MBEDTLS_MPI_CHK(mbedtls_mpi_write_binary(&T, output, olen));\0A\0Acleanup:\0A#if defined(MBEDTLS_THREADING_C)\0A    if (mbedtls_mutex_unlock(&ctx->mutex) != 0) {\0A        return MBEDTLS_ERR_THREADING_MUTEX_ERROR;\0A    }\0A#endif\0A\0A    mbedtls_mpi_free(&T);\0A\0A    if (ret != 0) {\0A        return MBEDTLS_ERROR_ADD(MBEDTLS_ERR_RSA_PUBLIC_FAILED, ret);\0A    }\0A\0A    return 0;\0A}\0A\0A/*\0A * Generate or update blinding values, see section 10 of:\0A *  KOCHER, Paul C. Timing attacks on implementations of Diffie-Hellman, RSA,\0A *  DSS, and other systems. In : Advances in Cryptology-CRYPTO'96. Springer\0A *  Berlin Heidelberg, 1996. p. 104-113.\0A */\0Astatic int rsa_prepare_blinding(mbedtls_rsa_context *ctx,\0A                                int (*f_rng)(void *, unsigned char *, size_t), void *p_rng)\0A{\0A    int ret, count = 0;\0A    mbedtls_mpi R;\0A\0A    mbedtls_mpi_init(&R);\0A\0A    if (ctx->Vf.p != NULL) {\0A        /* We already have blinding values, just update them by squaring */\0A        MBEDTLS_MPI_CHK(mbedtls_mpi_mul_mpi(&ctx->Vi, &ctx->Vi, &ctx->Vi));\0A        MBEDTLS_MPI_CHK(mbedtls_mpi_mod_mpi(&ctx->Vi, &ctx->Vi, &ctx->N));\0A        MBEDTLS_MPI_CHK(mbedtls_mpi_mul_mpi(&ctx->Vf, &ctx->Vf, &ctx->Vf));\0A        MBEDTLS_MPI_CHK(mbedtls_mpi_mod_mpi(&ctx->Vf, &ctx->Vf, &ctx->N));\0A\0A        goto cleanup;\0A    }\0A\0A    /* Unblinding value: Vf = random number, invertible mod N */\0A    do {\0A        if (count++ > 10) {\0A            ret = MBEDTLS_ERR_RSA_RNG_FAILED;\0A            goto cleanup;\0A        }\0A\0A        MBEDTLS_MPI_CHK(mbedtls_mpi_fill_random(&ctx->Vf, ctx->len - 1, f_rng, p_rng));\0A\0A        /* Compute Vf^-1 as R * (R Vf)^-1 to avoid leaks from inv_mod. */\0A        MBEDTLS_MPI_CHK(mbedtls_mpi_fill_random(&R, ctx->len - 1, f_rng, p_rng));\0A        MBEDTLS_MPI_CHK(mbedtls_mpi_mul_mpi(&ctx->Vi, &ctx->Vf, &R));\0A        MBEDTLS_MPI_CHK(mbedtls_mpi_mod_mpi(&ctx->Vi, &ctx->Vi, &ctx->N));\0A\0A        /* At this point, Vi is invertible mod N if and only if both Vf and R\0A         * are invertible mod N. If one of them isn't, we don't need to know\0A         * which one, we just loop and choose new values for both of them.\0A         * (Each iteration succeeds with overwhelming probability.) */\0A        ret = mbedtls_mpi_inv_mod(&ctx->Vi, &ctx->Vi, &ctx->N);\0A        if (ret != 0 && ret != MBEDTLS_ERR_MPI_NOT_ACCEPTABLE) {\0A            goto cleanup;\0A        }\0A\0A    } while (ret == MBEDTLS_ERR_MPI_NOT_ACCEPTABLE);\0A\0A    /* Finish the computation of Vf^-1 = R * (R Vf)^-1 */\0A    MBEDTLS_MPI_CHK(mbedtls_mpi_mul_mpi(&ctx->Vi, &ctx->Vi, &R));\0A    MBEDTLS_MPI_CHK(mbedtls_mpi_mod_mpi(&ctx->Vi, &ctx->Vi, &ctx->N));\0A\0A    /* Blinding value: Vi = Vf^(-e) mod N\0A     * (Vi already contains Vf^-1 at this point) */\0A    MBEDTLS_MPI_CHK(mbedtls_mpi_exp_mod(&ctx->Vi, &ctx->Vi, &ctx->E, &ctx->N, &ctx->RN));\0A\0A\0Acleanup:\0A    mbedtls_mpi_free(&R);\0A\0A    return ret;\0A}\0A\0A/*\0A * Unblind\0A * T = T * Vf mod N\0A */\0Astatic int rsa_unblind(mbedtls_mpi *T, mbedtls_mpi *Vf, const mbedtls_mpi *N)\0A{\0A    int ret = MBEDTLS_ERR_ERROR_CORRUPTION_DETECTED;\0A    const mbedtls_mpi_uint mm = mbedtls_mpi_core_montmul_init(N->p);\0A    const size_t nlimbs = N->n;\0A    const size_t tlimbs = mbedtls_mpi_core_montmul_working_limbs(nlimbs);\0A    mbedtls_mpi RR, M_T;\0A\0A    mbedtls_mpi_init(&RR);\0A    mbedtls_mpi_init(&M_T);\0A\0A    MBEDTLS_MPI_CHK(mbedtls_mpi_core_get_mont_r2_unsafe(&RR, N));\0A    MBEDTLS_MPI_CHK(mbedtls_mpi_grow(&M_T, tlimbs));\0A\0A    MBEDTLS_MPI_CHK(mbedtls_mpi_grow(T, nlimbs));\0A    MBEDTLS_MPI_CHK(mbedtls_mpi_grow(Vf, nlimbs));\0A\0A    /* T = T * Vf mod N\0A     * Reminder: montmul(A, B, N) = A * B * R^-1 mod N\0A     * Usually both operands are multiplied by R mod N beforehand (by calling\0A     * `to_mont_rep()` on them), yielding a result that's also * R mod N (aka\0A     * \22in the Montgomery domain\22). Here we only multiply one operand by R mod\0A     * N, so the result is directly what we want - no need to call\0A     * `from_mont_rep()` on it. */\0A    mbedtls_mpi_core_to_mont_rep(T->p, T->p, N->p, nlimbs, mm, RR.p, M_T.p);\0A    mbedtls_mpi_core_montmul(T->p, T->p, Vf->p, nlimbs, N->p, nlimbs, mm, M_T.p);\0A\0Acleanup:\0A\0A    mbedtls_mpi_free(&RR);\0A    mbedtls_mpi_free(&M_T);\0A\0A    return ret;\0A}\0A\0A/*\0A * Exponent blinding supposed to prevent side-channel attacks using multiple\0A * traces of measurements to recover the RSA key. The more collisions are there,\0A * the more bits of the key can be recovered. See [3].\0A *\0A * Collecting n collisions with m bit long blinding value requires 2^(m-m/n)\0A * observations on average.\0A *\0A * For example with 28 byte blinding to achieve 2 collisions the adversary has\0A * to make 2^112 observations on average.\0A *\0A * (With the currently (as of 2017 April) known best algorithms breaking 2048\0A * bit RSA requires approximately as much time as trying out 2^112 random keys.\0A * Thus in this sense with 28 byte blinding the security is not reduced by\0A * side-channel attacks like the one in [3])\0A *\0A * This countermeasure does not help if the key recovery is possible with a\0A * single trace.\0A */\0A#define RSA_EXPONENT_BLINDING 28\0A\0A/*\0A * Do an RSA private key ope