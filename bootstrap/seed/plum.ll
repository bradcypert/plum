@.str41594 = private global { i64, i64, [34768 x i8] } { i64 -1, i64 34767, [34768 x i8] c"/*\0A *  TLS 1.2 and 1.3 client-side functions\0A *\0A *  Copyright The Mbed TLS Contributors\0A *  SPDX-License-Identifier: Apache-2.0 OR GPL-2.0-or-later\0A */\0A\0A#include \22common.h\22\0A\0A#if defined(MBEDTLS_SSL_CLI_C)\0A#if defined(MBEDTLS_SSL_PROTO_TLS1_3) || defined(MBEDTLS_SSL_PROTO_TLS1_2)\0A\0A#include <string.h>\0A\0A#include \22debug_internal.h\22\0A#include \22mbedtls/error.h\22\0A#include \22mbedtls/platform.h\22\0A\0A#include \22ssl_client.h\22\0A#include \22ssl_misc.h\22\0A#include \22ssl_tls13_keys.h\22\0A#include \22ssl_debug_helpers.h\22\0A\0A#if defined(MBEDTLS_SSL_SERVER_NAME_INDICATION)\0AMBEDTLS_CHECK_RETURN_CRITICAL\0Astatic int ssl_write_hostname_ext(mbedtls_ssl_context *ssl,\0A                                  unsigned char *buf,\0A                                  const unsigned char *end,\0A                                  size_t *olen)\0A{\0A    unsigned char *p = buf;\0A    const char *hostname = mbedtls_ssl_get_hostname_pointer(ssl);\0A    size_t hostname_len;\0A\0A    *olen = 0;\0A\0A    if (hostname == NULL) {\0A        return 0;\0A    }\0A\0A    MBEDTLS_SSL_DEBUG_MSG(3,\0A                          (\22client hello, adding server name extension: %s\22,\0A                           hostname));\0A\0A    hostname_len = strlen(hostname);\0A\0A    MBEDTLS_SSL_CHK_BUF_PTR(p, end, hostname_len + 9);\0A\0A    /*\0A     * Sect. 3, RFC 6066 (TLS Extensions Definitions)\0A     *\0A     * In order to provide any of the server names, clients MAY include an\0A     * extension of type \22server_name\22 in the (extended) client hello. The\0A     * \22extension_data\22 field of this extension SHALL contain\0A     * \22ServerNameList\22 where:\0A     *\0A     * struct {\0A     *     NameType name_type;\0A     *     select (name_type) {\0A     *         case host_name: HostName;\0A     *     } name;\0A     * } ServerName;\0A     *\0A     * enum {\0A     *     host_name(0), (255)\0A     * } NameType;\0A     *\0A     * opaque HostName<1..2^16-1>;\0A     *\0A     * struct {\0A     *     ServerName server_name_list<1..2^16-1>\0A     * } ServerNameList;\0A     *\0A     */\0A    MBEDTLS_PUT_UINT16_BE(MBEDTLS_TLS_EXT_SERVERNAME, p, 0);\0A    p += 2;\0A\0A    MBEDTLS_PUT_UINT16_BE(hostname_len + 5, p, 0);\0A    p += 2;\0A\0A    MBEDTLS_PUT_UINT16_BE(hostname_len + 3, p, 0);\0A    p += 2;\0A\0A    *p++ = MBEDTLS_BYTE_0(MBEDTLS_TLS_EXT_SERVERNAME_HOSTNAME);\0A\0A    MBEDTLS_PUT_UINT16_BE(hostname_len, p, 0);\0A    p += 2;\0A\0A    memcpy(p, hostname, hostname_len);\0A\0A    *olen = hostname_len + 9;\0A\0A#if defined(MBEDTLS_SSL_PROTO_TLS1_3)\0A    mbedtls_ssl_tls13_set_hs_sent_ext_mask(ssl, MBEDTLS_TLS_EXT_SERVERNAME);\0A#endif /* MBEDTLS_SSL_PROTO_TLS1_3 */\0A    return 0;\0A}\0A#endif /* MBEDTLS_SSL_SERVER_NAME_INDICATION */\0A\0A#if defined(MBEDTLS_SSL_ALPN)\0A/*\0A * ssl_write_alpn_ext()\0A *\0A * Structure of the application_layer_protocol_negotiation extension in\0A * ClientHello:\0A *\0A * opaque ProtocolName<1..2^8-1>;\0A *\0A * struct {\0A *     ProtocolName protocol_name_list<2..2^16-1>\0A * } ProtocolNameList;\0A *\0A */\0AMBEDTLS_CHECK_RETURN_CRITICAL\0Astatic int ssl_write_alpn_ext(mbedtls_ssl_context *ssl,\0A                              unsigned char *buf,\0A                              const unsigned char *end,\0A                              size_t *out_len)\0A{\0A    unsigned char *p = buf;\0A\0A    *out_len = 0;\0A\0A    if (ssl->conf->alpn_list == NULL) {\0A        return 0;\0A    }\0A\0A    MBEDTLS_SSL_DEBUG_MSG(3, (\22client hello, adding alpn extension\22));\0A\0A\0A    /* Check we have enough space for the extension type (2 bytes), the\0A     * extension length (2 bytes) and the protocol_name_list length (2 bytes).\0A     */\0A    MBEDTLS_SSL_CHK_BUF_PTR(p, end, 6);\0A    MBEDTLS_PUT_UINT16_BE(MBEDTLS_TLS_EXT_ALPN, p, 0);\0A    /* Skip writing extension and list length for now */\0A    p += 6;\0A\0A    /*\0A     * opaque ProtocolName<1..2^8-1>;\0A     *\0A     * struct {\0A     *     ProtocolName protocol_name_list<2..2^16-1>\0A     * } ProtocolNameList;\0A     */\0A    for (const char **cur = ssl->conf->alpn_list; *cur != NULL; cur++) {\0A        /*\0A         * mbedtls_ssl_conf_set_alpn_protocols() checked that the length of\0A         * protocol names is less than 255.\0A         */\0A        size_t protocol_name_len = strlen(*cur);\0A\0A        MBEDTLS_SSL_CHK_BUF_PTR(p, end, 1 + protocol_name_len);\0A        *p++ = (unsigned char) protocol_name_len;\0A        memcpy(p, *cur, protocol_name_len);\0A        p += protocol_name_len;\0A    }\0A\0A    *out_len = (size_t) (p - buf);\0A\0A    /* List length = *out_len - 2 (ext_type) - 2 (ext_len) - 2 (list_len) */\0A    MBEDTLS_PUT_UINT16_BE(*out_len - 6, buf, 4);\0A\0A    /* Extension length = *out_len - 2 (ext_type) - 2 (ext_len) */\0A    MBEDTLS_PUT_UINT16_BE(*out_len - 4, buf, 2);\0A\0A#if defined(MBEDTLS_SSL_PROTO_TLS1_3)\0A    mbedtls_ssl_tls13_set_hs_sent_ext_mask(ssl, MBEDTLS_TLS_EXT_ALPN);\0A#endif /* MBEDTLS_SSL_PROTO_TLS1_3 */\0A    return 0;\0A}\0A#endif /* MBEDTLS_SSL_ALPN */\0A\0A#if defined(MBEDTLS_SSL_TLS1_2_SOME_ECC) || \5C\0A    defined(MBEDTLS_SSL_TLS1_3_KEY_EXCHANGE_MODE_SOME_EPHEMERAL_ENABLED)\0A/*\0A * Function for writing a supported groups (TLS 1.3) or supported elliptic\0A * curves (TLS 1.2) extension.\0A *\0A * The \22extension_data\22 field of a supported groups extension contains a\0A * \22NamedGroupList\22 value (TLS 1.3 RFC8446):\0A *      enum {\0A *          secp256r1(0x0017), secp384r1(0x0018), secp521r1(0x0019),\0A *          x25519(0x001D), x448(0x001E),\0A *          ffdhe2048(0x0100), ffdhe3072(0x0101), ffdhe4096(0x0102),\0A *          ffdhe6144(0x0103), ffdhe8192(0x0104),\0A *          ffdhe_private_use(0x01FC..0x01FF),\0A *          ecdhe_private_use(0xFE00..0xFEFF),\0A *          (0xFFFF)\0A *      } NamedGroup;\0A *      struct {\0A *          NamedGroup named_group_list<2..2^16-1>;\0A *      } NamedGroupList;\0A *\0A * The \22extension_data\22 field of a supported elliptic curves extension contains\0A * a \22NamedCurveList\22 value (TLS 1.2 RFC 8422):\0A * enum {\0A *      deprecated(1..22),\0A *      secp256r1 (23), secp384r1 (24), secp521r1 (25),\0A *      x25519(29), x448(30),\0A *      reserved (0xFE00..0xFEFF),\0A *      deprecated(0xFF01..0xFF02),\0A *      (0xFFFF)\0A *  } NamedCurve;\0A * struct {\0A *      NamedCurve named_curve_list<2..2^16-1>\0A *  } NamedCurveList;\0A *\0A * The TLS 1.3 supported groups extension was defined to be a compatible\0A * generalization of the TLS 1.2 supported elliptic curves extension. They both\0A * share the same extension identifier.\0A *\0A */\0A#define SSL_WRITE_SUPPORTED_GROUPS_EXT_TLS1_2_FLAG 1\0A#define SSL_WRITE_SUPPORTED_GROUPS_EXT_TLS1_3_FLAG 2\0A\0AMBEDTLS_CHECK_RETURN_CRITICAL\0Astatic int ssl_write_supported_groups_ext(mbedtls_ssl_context *ssl,\0A                                          unsigned char *buf,\0A                                          const unsigned char *end,\0A                                          int flags,\0A                                          size_t *out_len)\0A{\0A    unsigned char *p = buf;\0A    unsigned char *named_group_list; /* Start of named_group_list */\0A    size_t named_group_list_len;     /* Length of named_group_list */\0A    const uint16_t *group_list = mbedtls_ssl_get_groups(ssl);\0A\0A    *out_len = 0;\0A\0A    MBEDTLS_SSL_DEBUG_MSG(3, (\22client hello, adding supported_groups extension\22));\0A\0A    /* Check if we have space for header and length fields:\0A     * - extension_type            (2 bytes)\0A     * - extension_data_length     (2 bytes)\0A     * - named_group_list_length   (2 bytes)\0A     */\0A    MBEDTLS_SSL_CHK_BUF_PTR(p, end, 6);\0A    p += 6;\0A\0A    named_group_list = p;\0A\0A    if (group_list == NULL) {\0A        return MBEDTLS_ERR_SSL_BAD_CONFIG;\0A    }\0A\0A    for (; *group_list != 0; group_list++) {\0A        int propose_group = 0;\0A\0A        MBEDTLS_SSL_DEBUG_MSG(3, (\22got supported group(%04x)\22, *group_list));\0A\0A#if defined(MBEDTLS_SSL_TLS1_3_KEY_EXCHANGE_MODE_SOME_EPHEMERAL_ENABLED)\0A        if (flags & SSL_WRITE_SUPPORTED_GROUPS_EXT_TLS1_3_FLAG) {\0A#if defined(PSA_WANT_ALG_ECDH)\0A            if (mbedtls_ssl_tls13_named_group_is_ecdhe(*group_list) &&\0A                (mbedtls_ssl_get_ecp_group_id_from_tls_id(*group_list) !=\0A                 MBEDTLS_ECP_DP_NONE)) {\0A                propose_group = 1;\0A            }\0A#endif\0A#if defined(PSA_WANT_ALG_FFDH)\0A            if (mbedtls_ssl_tls13_named_group_is_ffdh(*group_list)) {\0A                propose_group = 1;\0A            }\0A#endif\0A        }\0A#endif /* MBEDTLS_SSL_TLS1_3_KEY_EXCHANGE_MODE_SOME_EPHEMERAL_ENABLED */\0A\0A#if defined(MBEDTLS_SSL_TLS1_2_SOME_ECC)\0A        if ((flags & SSL_WRITE_SUPPORTED_GROUPS_EXT_TLS1_2_FLAG) &&\0A            mbedtls_ssl_tls12_named_group_is_ecdhe(*group_list) &&\0A            (mbedtls_ssl_get_ecp_group_id_from_tls_id(*group_list) !=\0A             MBEDTLS_ECP_DP_NONE)) {\0A            propose_group = 1;\0A        }\0A#endif /* MBEDTLS_SSL_TLS1_2_SOME_ECC */\0A\0A        if (propose_group) {\0A            MBEDTLS_SSL_CHK_BUF_PTR(p, end, 2);\0A            MBEDTLS_PUT_UINT16_BE(*group_list, p, 0);\0A            p += 2;\0A            MBEDTLS_SSL_DEBUG_MSG(3, (\22NamedGroup: %s ( %x )\22,\0A                                      mbedtls_ssl_named_group_to_str(*group_list),\0A                                      *group_list));\0A        }\0A    }\0A\0A    /* Length of named_group_list */\0A    named_group_list_len = (size_t) (p - named_group_list);\0A    if (named_group_list_len == 0) {\0A        MBEDTLS_SSL_DEBUG_MSG(1, (\22No group available.\22));\0A        return MBEDTLS_ERR_SSL_INTERNAL_ERROR;\0A    }\0A\0A    /* Write extension_type */\0A    MBEDTLS_PUT_UINT16_BE(MBEDTLS_TLS_EXT_SUPPORTED_GROUPS, buf, 0);\0A    /* Write extension_data_length */\0A    MBEDTLS_PUT_UINT16_BE(named_group_list_len + 2, buf, 2);\0A    /* Write length of named_group_list */\0A    MBEDTLS_PUT_UINT16_BE(named_group_list_len, buf, 4);\0A\0A    MBEDTLS_SSL_DEBUG_BUF(3, \22Supported groups extension\22,\0A                          buf + 4, named_group_list_len + 2);\0A\0A    *out_len = (size_t) (p - buf);\0A\0A#if defined(MBEDTLS_SSL_PROTO_TLS1_3)\0A    mbedtls_ssl_tls13_set_hs_sent_ext_mask(\0A        ssl, MBEDTLS_TLS_EXT_SUPPORTED_GROUPS);\0A#endif /* MBEDTLS_SSL_PROTO_TLS1_3 */\0A\0A    return 0;\0A}\0A#endif /* MBEDTLS_SSL_TLS1_2_SOME_ECC ||\0A          MBEDTLS_SSL_TLS1_3_KEY_EXCHANGE_MODE_SOME_EPHEMERAL_ENABLED */\0A\0AMBEDTLS_CHECK_RETURN_CRITICAL\0Astatic int ssl_write_client_hello_cipher_suites(\0A    mbedtls_ssl_context *ssl,\0A    unsigned char *buf,\0A    unsigned char *end,\0A    int *tls12_uses_ec,\0A    size_t *out_len)\0A{\0A    unsigned char *p = buf;\0A    const int *ciphersuite_list;\0A    unsigned char *cipher_suites; /* Start of the cipher_suites list */\0A    size_t cipher_suites_len;\0A\0A    *tls12_uses_ec = 0;\0A    *out_len = 0;\0A\0A    /*\0A     * Ciphersuite list\0A     *\0A     * This is a list of the symmetric cipher options supported by\0A     * the client, specifically the record protection algorithm\0A     * ( including secret key length ) and a hash to be used with\0A     * HKDF, in descending order of client preference.\0A     */\0A    ciphersuite_list = ssl->conf->ciphersuite_list;\0A\0A    /* Check there is space for the cipher suite list length (2 bytes). */\0A    MBEDTLS_SSL_CHK_BUF_PTR(p, end, 2);\0A    p += 2;\0A\0A    /* Write cipher_suites\0A     * CipherSuite cipher_suites<2..2^16-2>;\0A     */\0A    cipher_suites = p;\0A    for (size_t i = 0; ciphersuite_list[i] != 0; i++) {\0A        int cipher_suite = ciphersuite_list[i];\0A        const mbedtls_ssl_ciphersuite_t *ciphersuite_info;\0A\0A        ciphersuite_info = mbedtls_ssl_ciphersuite_from_id(cipher_suite);\0A\0A        if (mbedtls_ssl_validate_ciphersuite(ssl, ciphersuite_info,\0A                                             ssl->handshake->min_tls_version,\0A                                             ssl->tls_version) != 0) {\0A            continue;\0A        }\0A\0A#if defined(MBEDTLS_SSL_PROTO_TLS1_2) && \5C\0A        (defined(MBEDTLS_KEY_EXCHANGE_SOME_ECDH_OR_ECDHE_1_2_ENABLED) || \5C\0A        defined(MBEDTLS_KEY_EXCHANGE_ECDSA_CERT_REQ_ALLOWED_ENABLED) || \5C\0A        defined(MBEDTLS_KEY_EXCHANGE_ECJPAKE_ENABLED))\0A        *tls12_uses_ec |= mbedtls_ssl_ciphersuite_uses_ec(ciphersuite_info);\0A#endif\0A\0A        MBEDTLS_SSL_DEBUG_MSG(3, (\22client hello, add ciphersuite: %04x, %s\22,\0A                                  (unsigned int) cipher_suite,\0A                                  ciphersuite_info->name));\0A\0A        /* Check there is space for the cipher suite identifier (2 bytes). */\0A        MBEDTLS_SSL_CHK_BUF_PTR(p, end, 2);\0A        MBEDTLS_PUT_UINT16_BE(cipher_suite, p, 0);\0A        p += 2;\0A    }\0A\0A    /*\0A     * Add TLS_EMPTY_RENEGOTIATION_INFO_SCSV\0A     */\0A    int renegotiating = 0;\0A#if defined(MBEDTLS_SSL_RENEGOTIATION)\0A    renegotiating = (ssl->renego_status != MBEDTLS_SSL_INITIAL_HANDSHAKE);\0A#endif\0A    if (!renegotiating) {\0A        MBEDTLS_SSL_DEBUG_MSG(3, (\22adding EMPTY_RENEGOTIATION_INFO_SCSV\22));\0A        MBEDTLS_SSL_CHK_BUF_PTR(p, end, 2);\0A        MBEDTLS_PUT_UINT16_BE(MBEDTLS_SSL_EMPTY_RENEGOTIATION_INFO, p, 0);\0A        p += 2;\0A    }\0A\0A    /* Write the cipher_suites length in number of bytes */\0A    cipher_suites_len = (size_t) (p - cipher_suites);\0A    MBEDTLS_PUT_UINT16_BE(cipher_suites_len, buf, 0);\0A    MBEDTLS_SSL_DEBUG_MSG(3,\0A                          (\22client hello, got %\22 MBEDTLS_PRINTF_SIZET \22 cipher suites\22,\0A                           cipher_suites_len/2));\0A\0A    /* Output the total length of cipher_suites field. */\0A    *out_len = (size_t) (p - buf);\0A\0A    return 0;\0A}\0A\0A/*\0A * Structure of the TLS 1.3 ClientHell