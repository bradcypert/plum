 - For 3), the loop condition is satisfied and read_record\0A             *   will re-deliver the message that was held back by the client\0A             *   when expecting the ServerHello.\0A             */\0A\0A            continue;\0A        }\0A#if defined(MBEDTLS_SSL_RENEGOTIATION)\0A        else if (ssl->renego_status == MBEDTLS_SSL_RENEGOTIATION_PENDING) {\0A            if (ssl->conf->renego_max_records >= 0) {\0A                if (++ssl->renego_records_seen > ssl->conf->renego_max_records) {\0A                    MBEDTLS_SSL_DEBUG_MSG(1, (\22renegotiation requested, \22\0A                                              \22but not honored by client\22));\0A                    return MBEDTLS_ERR_SSL_UNEXPECTED_MESSAGE;\0A                }\0A            }\0A        }\0A#endif /* MBEDTLS_SSL_RENEGOTIATION */\0A\0A        /* Fatal and closure alerts handled by mbedtls_ssl_read_record() */\0A        if (ssl->in_msgtype == MBEDTLS_SSL_MSG_ALERT) {\0A            MBEDTLS_SSL_DEBUG_MSG(2, (\22ignoring non-fatal non-closure alert\22));\0A            return MBEDTLS_ERR_SSL_WANT_READ;\0A        }\0A\0A        if (ssl->in_msgtype != MBEDTLS_SSL_MSG_APPLICATION_DATA) {\0A            MBEDTLS_SSL_DEBUG_MSG(1, (\22bad application data message\22));\0A            return MBEDTLS_ERR_SSL_UNEXPECTED_MESSAGE;\0A        }\0A\0A        ssl->in_offt = ssl->in_msg;\0A\0A        /* We're going to return something now, cancel timer,\0A         * except if handshake (renegotiation) is in progress */\0A        if (mbedtls_ssl_is_handshake_over(ssl) == 1) {\0A            mbedtls_ssl_set_timer(ssl, 0);\0A        }\0A\0A#if defined(MBEDTLS_SSL_PROTO_DTLS)\0A        /* If we requested renego but received AppData, resend HelloRequest.\0A         * Do it now, after setting in_offt, to avoid taking this branch\0A         * again if ssl_write_hello_request() returns WANT_WRITE */\0A#if defined(MBEDTLS_SSL_SRV_C) && defined(MBEDTLS_SSL_RENEGOTIATION)\0A        if (ssl->conf->endpoint == MBEDTLS_SSL