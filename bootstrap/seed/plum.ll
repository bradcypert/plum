@.str42818 = private global { i64, i64, [60812 x i8] } { i64 -1, i64 60811, [60812 x i8] c"/*\0A *  TLS 1.3 functionality shared between client and server\0A *\0A *  Copyright The Mbed TLS Contributors\0A *  SPDX-License-Identifier: Apache-2.0 OR GPL-2.0-or-later\0A */\0A\0A#include \22common.h\22\0A\0A#if defined(MBEDTLS_SSL_TLS_C) && defined(MBEDTLS_SSL_PROTO_TLS1_3)\0A\0A#include <string.h>\0A\0A#include \22mbedtls/error.h\22\0A#include \22debug_internal.h\22\0A#include \22mbedtls/oid.h\22\0A#include \22mbedtls/platform.h\22\0A#include \22mbedtls/constant_time.h\22\0A#include \22psa/crypto.h\22\0A#include \22mbedtls/psa_util.h\22\0A\0A#include \22ssl_misc.h\22\0A#include \22ssl_tls13_invasive.h\22\0A#include \22ssl_tls13_keys.h\22\0A#include \22ssl_debug_helpers.h\22\0A\0A#include \22psa/crypto.h\22\0A#include \22psa_util_internal.h\22\0A\0A/* Define a local translating function to save code size by not using too many\0A * arguments in each translating place. */\0Astatic int local_err_translation(psa_status_t status)\0A{\0A    return psa_status_to_mbedtls(status, psa_to_ssl_errors,\0A                                 ARRAY_LENGTH(psa_to_ssl_errors),\0A                                 psa_generic_status_to_mbedtls);\0A}\0A#define PSA_TO_MBEDTLS_ERR(status) local_err_translation(status)\0A\0Aint mbedtls_ssl_tls13_crypto_init(mbedtls_ssl_context *ssl)\0A{\0A    psa_status_t status = psa_crypto_init();\0A    if (status != PSA_SUCCESS) {\0A        (void) ssl; // unused when debugging is disabled\0A        MBEDTLS_SSL_DEBUG_RET(1, \22psa_crypto_init\22, status);\0A    }\0A    return PSA_TO_MBEDTLS_ERR(status);\0A}\0A\0Aconst uint8_t mbedtls_ssl_tls13_hello_retry_request_magic[\0A    MBEDTLS_SERVER_HELLO_RANDOM_LEN] =\0A{ 0xCF, 0x21, 0xAD, 0x74, 0xE5, 0x9A, 0x61, 0x11,\0A  0xBE, 0x1D, 0x8C, 0x02, 0x1E, 0x65, 0xB8, 0x91,\0A  0xC2, 0xA2, 0x11, 0x16, 0x7A, 0xBB, 0x8C, 0x5E,\0A  0x07, 0x9E, 0x09, 0xE2, 0xC8, 0xA8, 0x33, 0x9C };\0A\0Aint mbedtls_ssl_tls13_fetch_handshake_msg(mbedtls_ssl_context *ssl,\0A                                          unsigned hs_type,\0A                                          unsigned char **buf,\0A                                          size_t *buf_len)\0A{\0A    int ret;\0A\0A    if ((ret = mbedtls_ssl_read_record(ssl, 0)) != 0) {\0A        MBEDTLS_SSL_DEBUG_RET(1, \22mbedtls_ssl_read_record\22, ret);\0A        goto cleanup;\0A    }\0A\0A    if (ssl->in_msgtype != MBEDTLS_SSL_MSG_HANDSHAKE ||\0A        ssl->in_msg[0]  != hs_type) {\0A        MBEDTLS_SSL_DEBUG_MSG(1, (\22Receive unexpected handshake message.\22));\0A        MBEDTLS_SSL_PEND_FATAL_ALERT(MBEDTLS_SSL_ALERT_MSG_UNEXPECTED_MESSAGE,\0A                                     MBEDTLS_ERR_SSL_UNEXPECTED_MESSAGE);\0A        ret = MBEDTLS_ERR_SSL_UNEXPECTED_MESSAGE;\0A        goto cleanup;\0A    }\0A\0A    /*\0A     * Jump handshake header (4 bytes, see Section 4 of RFC 8446).\0A     *    ...\0A     *    HandshakeType msg_type;\0A     *    uint24 length;\0A     *    ...\0A     */\0A    *buf = ssl->in_msg   + 4;\0A    *buf_len = ssl->in_hslen - 4;\0A\0Acleanup:\0A\0A    return ret;\0A}\0A\0Aint mbedtls_ssl_tls13_is_supported_versions_ext_present_in_exts(\0A    mbedtls_ssl_context *ssl,\0A    const unsigned char *buf, const unsigned char *end,\0A    const unsigned char **supported_versions_data,\0A    const unsigned char **supported_versions_data_end)\0A{\0A    const unsigned char *p = buf;\0A    size_t extensions_len;\0A    const unsigned char *extensions_end;\0A\0A    *supported_versions_data = NULL;\0A    *supported_versions_data_end = NULL;\0A\0A    /* Case of no extension */\0A    if (p == end) {\0A        return 0;\0A    }\0A\0A    /* ...\0A     * Extension extensions<x..2^16-1>;\0A     * ...\0A     * struct {\0A     *      ExtensionType extension_type; (2 bytes)\0A     *      opaque extension_data<0..2^16-1>;\0A     * } Extension;\0A     */\0A    MBEDTLS_SSL_CHK_BUF_READ_PTR(p, end, 2);\0A    extensions_len = MBEDTLS_GET_UINT16_BE(p, 0);\0A    p += 2;\0A\0A    /* Check extensions do not go beyond the buffer of data. */\0A    MBEDTLS_SSL_CHK_BUF_READ_PTR(p, end, extensions_len);\0A    extensions_end = p + extensions_len;\0A\0A    while (p < extensions_end) {\0A        unsigned int extension_type;\0A        size_t extension_data_len;\0A\0A        MBEDTLS_SSL_CHK_BUF_READ_PTR(p, extensions_end, 4);\0A        extension_type = MBEDTLS_GET_UINT16_BE(p, 0);\0A        extension_data_len = MBEDTLS_GET_UINT16_BE(p, 2);\0A        p += 4;\0A        MBEDTLS_SSL_CHK_BUF_READ_PTR(p, extensions_end, extension_data_len);\0A\0A        if (extension_type == MBEDTLS_TLS_EXT_SUPPORTED_VERSIONS) {\0A            *supported_versions_data = p;\0A            *supported_versions_data_end = p + extension_data_len;\0A            return 1;\0A        }\0A        p += extension_data_len;\0A    }\0A\0A    return 0;\0A}\0A\0A#if defined(MBEDTLS_SSL_TLS1_3_KEY_EXCHANGE_MODE_EPHEMERAL_ENABLED)\0A/*\0A * STATE HANDLING: Read CertificateVerify\0A */\0A/* Macro to express the maximum length of the verify structure.\0A *\0A * The structure is computed per TLS 1.3 specification as:\0A *   - 64 bytes of octet 32,\0A *   - 33 bytes for the context string\0A *        (which is either \22TLS 1.3, client CertificateVerify\22\0A *         or \22TLS 1.3, server CertificateVerify\22),\0A *   - 1 byte for the octet 0x0, which serves as a separator,\0A *   - 32 or 48 bytes for the Transcript-Hash(Handshake Context, Certificate)\0A *     (depending on the size of the transcript_hash)\0A *\0A * This results in a total size of\0A * - 130 bytes for a SHA256-based transcript hash, or\0A *   (64 + 33 + 1 + 32 bytes)\0A * - 146 bytes for a SHA384-based transcript hash.\0A *   (64 + 33 + 1 + 48 bytes)\0A *\0A */\0A#define SSL_VERIFY_STRUCT_MAX_SIZE  (64 +                          \5C\0A                                     33 +                          \5C\0A                                     1 +                          \5C\0A                                     MBEDTLS_TLS1_3_MD_MAX_SIZE    \5C\0A                                     )\0A\0A/*\0A * The ssl_tls13_create_verify_structure() creates the verify structure.\0A * As input, it requires the transcript hash.\0A *\0A * The caller has to ensure that the buffer has size at least\0A * SSL_VERIFY_STRUCT_MAX_SIZE bytes.\0A */\0Astatic void ssl_tls13_create_verify_structure(const unsigned char *transcript_hash,\0A                                              size_t transcript_hash_len,\0A                                              unsigned char *verify_buffer,\0A                                              size_t *verify_buffer_len,\0A                                              int from)\0A{\0A    size_t idx;\0A\0A    /* RFC 8446, Section 4.4.3:\0A     *\0A     * The digital signature [in the CertificateVerify message] is then\0A     * computed over the concatenation of:\0A     * -  A string that consists of octet 32 (0x20) repeated 64 times\0A     * -  The context string\0A     * -  A single 0 byte which serves as the separator\0A     * -  The content to be signed\0A     */\0A    memset(verify_buffer, 0x20, 64);\0A    idx = 64;\0A\0A    if (from == MBEDTLS_SSL_IS_CLIENT) {\0A        memcpy(verify_buffer + idx, mbedtls_ssl_tls13_labels.client_cv,\0A               MBEDTLS_SSL_TLS1_3_LBL_LEN(client_cv));\0A        idx += MBEDTLS_SSL_TLS1_3_LBL_LEN(client_cv);\0A    } else { /* from == MBEDTLS_SSL_IS_SERVER */\0A        memcpy(verify_buffer + idx, mbedtls_ssl_tls13_labels.server_cv,\0A               MBEDTLS_SSL_TLS1_3_LBL_LEN(server_cv));\0A        idx += MBEDTLS_SSL_TLS1_3_LBL_LEN(server_cv);\0A    }\0A\0A    verify_buffer[idx++] = 0x0;\0A\0A    memcpy(verify_buffer + idx, transcript_hash, transcript_hash_len);\0A    idx += transcript_hash_len;\0A\0A    *verify_buffer_len = idx;\0A}\0A\0AMBEDTLS_CHECK_RETURN_CRITICAL\0Astatic int ssl_tls13_parse_certificate_verify(mbedtls_ssl_context *ssl,\0A                                              const unsigned char *buf,\0A                                              const unsigned char *end,\0A                                              const unsigned char *verify_buffer,\0A                                              size_t verify_buffer_len)\0A{\0A    int ret = MBEDTLS_ERR_ERROR_CORRUPTION_DETECTED;\0A    psa_status_t status = PSA_ERROR_CORRUPTION_DETECTED;\0A    const unsigned char *p = buf;\0A    uint16_t algorithm;\0A    size_t signature_len;\0A    mbedtls_pk_type_t sig_alg;\0A    mbedtls_md_type_t md_alg;\0A    psa_algorithm_t hash_alg = PSA_ALG_NONE;\0A    unsigned char verify_hash[PSA_HASH_MAX_SIZE];\0A    size_t verify_hash_len;\0A\0A    void const *options = NULL;\0A#if defined(MBEDTLS_X509_RSASSA_PSS_SUPPORT)\0A    mbedtls_pk_rsassa_pss_options rsassa_pss_options;\0A#endif /* MBEDTLS_X509_RSASSA_PSS_SUPPORT */\0A\0A    /*\0A     * struct {\0A     *     SignatureScheme algorithm;\0A     *     opaque signature<0..2^16-1>;\0A     * } CertificateVerify;\0A     */\0A    MBEDTLS_SSL_CHK_BUF_READ_PTR(p, end, 2);\0A    algorithm = MBEDTLS_GET_UINT16_BE(p, 0);\0A    p += 2;\0A\0A    /* RFC 8446 section 4.4.3\0A     *\0A     * If the CertificateVerify message is sent by a server, the signature\0A     * algorithm MUST be one offered in the client's \22signature_algorithms\22\0A     * extension unless no valid certificate chain can be produced without\0A     * unsupported algorithms\0A     *\0A     * RFC 8446 section 4.4.2.2\0A     *\0A     * If the client cannot construct an acceptable chain using the provided\0A     * certificates and decides to abort the handshake, then it MUST abort the\0A     * handshake with an appropriate certificate-related alert\0A     * (by default, \22unsupported_certificate\22).\0A     *\0A     * Check if algorithm is an offered signature algorithm.\0A     */\0A    if (!mbedtls_ssl_sig_alg_is_offered(ssl, algorithm)) {\0A        /* algorithm not in offered signature algorithms list */\0A        MBEDTLS_SSL_DEBUG_MSG(1, (\22Received signature algorithm(%04x) is