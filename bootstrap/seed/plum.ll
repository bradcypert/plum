RAM) {\0A        if ((ret = mbedtls_ssl_flush_output(ssl)) != 0) {\0A            return ret;\0A        }\0A\0A        if (ssl->handshake != NULL &&\0A            ssl->handshake->retransmit_state == MBEDTLS_SSL_RETRANS_SENDING) {\0A            if ((ret = mbedtls_ssl_flight_transmit(ssl)) != 0) {\0A                return ret;\0A            }\0A        }\0A    }\0A#endif\0A\0A    /*\0A     * Check if renegotiation is necessary and/or handshake is\0A     * in process. If yes, perform/continue, and fall through\0A     * if an unexpected packet is received while the client\0A     * is waiting for the ServerHello.\0A     *\0A     * (There is no equivalent to the last condition on\0A     *  the server-side as it is not treated as within\0A     *  a handshake while waiting for the ClientHello\0A     *  after a renegotiation request.)\0A     */\0A\0A#if defined(MBEDTLS_SSL_RENEGOTIATION)\0A    ret = ssl_check_ctr_renegotiate(ssl);\0A    if (ret != MBEDTLS_ERR_SSL_WAITING_SERVER_HELLO_RENEGO &&\0A        ret != 0) {\0A        MBEDTLS_SSL_DEBUG_RET(1, \22ssl_check_ctr_renegotiate\22, ret);\0A        return ret;\0A    }\0A#endif\0A\0A    if (ssl->state != MBEDTLS_SSL_HANDSHAKE_OVER) {\0A        ret = mbedtls_ssl_handshake(ssl);\0A        if (ret != MBEDTLS_ERR_SSL_WAITING_SERVER_HELLO_RENEGO &&\0A            ret != 0) {\0A            MBEDTLS_SSL_DEBUG_RET(1, \22mbedtls_ssl_handshake\22, ret);\0A            return ret;\0A        }\0A    }\0A\0A    /* Loop as long as no application data record is available */\0A    while (ssl->in_offt == NULL) {\0A        /* Start timer if not already running */\0A        if (ssl->f_get_timer != NULL &&\0A            ssl->f_get_timer(ssl->p_timer) == -1) {\0A            mbedtls_ssl_set_timer(ssl, ssl->conf->read_timeout);\0A        }\0A\0A        if ((ret = mbedtls_ssl_read_record(ssl, 1)) != 0) {\0A            if (ret == MBEDTLS_ERR_SSL_CONN_EOF) {\0A                return 0;\0A            }\0A\0A            MBEDTLS_SSL_DEBUG_RET(1, \22mbedtls_ss