    .concat(content_length_line)\0A            .concat(extra_header_lines)\0A            .concat(\22\5Cr\5Cn\22)\0A            .concat(body)\0A    }) }\0A}\0A\0A/// Reads (and accumulates) until the blank-line header/body separator\0A/// has actually arrived — it may take more than one `tcp_read` call to\0A/// see it at all, and a single `tcp_read` may ALSO return part of the\0A/// body past it in the same chunk (`http_parse_head` below splits that\0A/// back out). An empty read here means the peer closed before the\0A/// headers even finished, always a real error, never a legitimate\0A/// empty response.\0Alet http_recv_headers_acc (fd: Int) (secure: Int) (acc: String): Result[String, String] =\0A    match String.index_of(acc, \22\5Cr\5Cn\5Cr\5Cn\22) {\0A        Some(_) => Ok(acc),\0A        None => {\0A            let chunk = if secure == 1 { http_tls_read(fd, 4096) } else { Net.read(fd, 4096) };\0A            if String.is_empty(chunk) { Err(\22http client: connection closed before the response headers were complete\22) }\0A            else { http_recv_headers_acc(fd, secure, acc.concat(chunk)) }\0A        },\0A    }\0A\0Alet http_parse_status_line (line: String): Result[Int, String] = {\0A    let parts = String.trim_end(line).split(\22 \22);\0A    if parts.len() < 2 { Err(\22http client: malformed status line: \22.concat(line)) }\0A    else { match String.parse_int(parts[1]) {\0A        Err(e) => Err(\22http client: malformed status code: \22.concat(e)),\0A        Ok(code) => Ok(code),\0A    } }\0A}\0A\0Alet http_byte (b: Bytes) (i: Int): Int = match b.at(i) { Some(c) => c, None => -1 }\0Alet http_ows (c: Int): Bool = c == 32 || c == 9\0Alet http_ows_start (b: Bytes) (i: Int): Int =\0A    if http_ows(http_byte(b, i)) { http_ows_start(b, i + 1) } else { i }\0Alet http_ows_end (b: Bytes) (i: Int): Int =\0A    if http_ows(http_byte(b, i - 1)) { http_ows_end(b, i - 1) } else { i }\0A\0A// Only SP/HTAB are optional whitespace. Generic Unicode trimming would\0A// erase