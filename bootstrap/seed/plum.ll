A}\0A\0Avoid mbedtls_ssl_transform_free(mbedtls_ssl_transform *transform)\0A{\0A    if (transform == NULL) {\0A        return;\0A    }\0A\0A#if defined(MBEDTLS_USE_PSA_CRYPTO)\0A    psa_destroy_key(transform->psa_key_enc);\0A    psa_destroy_key(transform->psa_key_dec);\0A#else\0A    mbedtls_cipher_free(&transform->cipher_ctx_enc);\0A    mbedtls_cipher_free(&transform->cipher_ctx_dec);\0A#endif /* MBEDTLS_USE_PSA_CRYPTO */\0A\0A#if defined(MBEDTLS_SSL_SOME_SUITES_USE_MAC)\0A#if defined(MBEDTLS_USE_PSA_CRYPTO)\0A    psa_destroy_key(transform->psa_mac_enc);\0A    psa_destroy_key(transform->psa_mac_dec);\0A#else\0A    mbedtls_md_free(&transform->md_ctx_enc);\0A    mbedtls_md_free(&transform->md_ctx_dec);\0A#endif /* MBEDTLS_USE_PSA_CRYPTO */\0A#endif\0A\0A    mbedtls_platform_zeroize(transform, sizeof(mbedtls_ssl_transform));\0A}\0A\0Avoid mbedtls_ssl_set_inbound_transform(mbedtls_ssl_context *ssl,\0A                                       mbedtls_ssl_transform *transform)\0A{\0A    ssl->transform_in = transform;\0A    memset(ssl->in_ctr, 0, MBEDTLS_SSL_SEQUENCE_NUMBER_LEN);\0A}\0A\0Avoid mbedtls_ssl_set_outbound_transform(mbedtls_ssl_context *ssl,\0A                                        mbedtls_ssl_transform *transform)\0A{\0A    ssl->transform_out = transform;\0A    memset(ssl->cur_out_ctr, 0, sizeof(ssl->cur_out_ctr));\0A}\0A\0A#if defined(MBEDTLS_SSL_PROTO_DTLS)\0A\0Avoid mbedtls_ssl_buffering_free(mbedtls_ssl_context *ssl)\0A{\0A    unsigned offset;\0A    mbedtls_ssl_handshake_params * const hs = ssl->handshake;\0A\0A    if (hs == NULL) {\0A        return;\0A    }\0A\0A    ssl_free_buffered_record(ssl);\0A\0A    for (offset = 0; offset < MBEDTLS_SSL_MAX_BUFFERED_HS; offset++) {\0A        ssl_buffering_free_slot(ssl, offset);\0A    }\0A}\0A\0Astatic void ssl_buffering_free_slot(mbedtls_ssl_context *ssl,\0A                                    uint8_t slot)\0A{\0A    mbedtls_ssl_handshake_params * const hs = ssl->handshake;\0A    mbedtls_ssl_hs_buffer * const hs_buf = &hs->buffering.hs[slot];\0A\0A    if (slot >= MBEDTLS_SSL_MAX_BUFFERED_HS) {\0A        return;\0A    }\0A\0A    if (hs_buf->is_valid == 1) {\0A        hs->buffering.total_bytes_buffered -= hs_buf->data_len;\0A        mbedtls_zeroize_and_free(hs_buf->data, hs_buf->data_len);\0A        memset(hs_buf, 0, sizeof(mbedtls_ssl_hs_buffer));\0A    }\0A}\0A\0A#endif /* MBEDTLS_SSL_PROTO_DTLS */\0A\0A/*\0A * Convert version numbers to/from wire format\0A * and, for DTLS, to/from TLS equivalent.\0A *\0A * For TLS this is the identity.\0A * For DTLS, map as follows, then use 1's complement (v -> ~v):\0A * 1.x <-> 3.x+1    for x != 0 (DTLS 1.2 based on TLS 1.2)\0A *                  DTLS 1.0 is stored as TLS 1.1 internally\0A */\0Avoid mbedtls_ssl_write_version(unsigned char version[2], int transport,\0A                               mbedtls_ssl_protocol_version tls_version)\0A{\0A    uint16_t tls_version_formatted;\0A#if defined(MBEDTLS_SSL_PROTO_DTLS)\0A    if (transport == MBEDTLS_SSL_TRANSPORT_DATAGRAM) {\0A        tls_version_formatted =\0A            ~(tls_version - (tls_version == 0x0302 ? 0x0202 : 0x0201));\0A    } else\0A#else\0A    ((void) transport);\0A#endif\0A    {\0A        tls_version_formatted = (uint16_t) tls_version;\0A    }\0A    MBEDTLS_PUT_UINT16_BE(tls_version_formatted, version, 0);\0A}\0A\0Auint16_t mbedtls_ssl_read_version(const unsigned char version[2],\0A                                  int transport)\0A{\0A    uint16_t tls_version = MBEDTLS_GET_UINT16_BE(version, 0);\0A#if defined(MBEDTLS_SSL_PROTO_DTLS)\0A    if (transport == MBEDTLS_SSL_TRANSPORT_DATAGRAM) {\0A        tls_version =\0A            ~(tls_version - (tls_version == 0xfeff ? 0x0202 : 0x0201));\0A    }\0A#else\0A    ((void) transport);\0A#endif\0A    return tls_version;\0A}\0A\0A/*\0A * Send pending fatal alert.\0A * 0,   No alert message.\0A * !0,  if mbedtls_ssl_send_alert_message() returned in error, the error code it\0A *      returned, ssl->alert_reason otherwise.\0A */\0Aint mbedtls_ssl_handle_pending_alert(mbedtls_ssl_context *ssl)\0A{\0A    int ret;\0A\0A    /* No pending alert, return success*/\0A    if (ssl->send_alert == 0) {\0A        return 0;\0A    }\0A\0A    ret = mbedtls_ssl_send_alert_message(ssl,\0A                                         MBEDTLS_SSL_ALERT_LEVEL_FATAL,\0A                                         ssl->alert_type);\0A\0A    /* If mbedtls_ssl_send_alert_message() returned with MBEDTLS_ERR_SSL_WANT_WRITE,\0A     * do not clear the alert to be able to send it later.\0A     */\0A    if (ret != MBEDTLS_ERR_SSL_WANT_WRITE) {\0A        ssl->send_alert = 0;\0A    }\0A\0A    if (ret != 0) {\0A        return ret;\0A    }\0A\0A    return ssl->alert_reason;\0A}\0A\0A/*\0A * Set pending fatal alert flag.\0A */\0Avoid mbedtls_ssl_pend_fatal_alert(mbedtls_ssl_context *ssl,\0A                                  unsigned char alert_type,\0A                                  int alert_reason)\0A{\0A    ssl->send_alert = 1;\0A    ssl->alert_type = alert_type;\0A    ssl->alert_reason = alert_reason;\0A}\0A\0A#endif /* MBEDTLS_SSL_TLS_C */\0A\00" }
@.const46164 = private global <{ i64, ptr, ptr, i1, [7 x i8] }> <{ i64 -1, ptr @.str46160, ptr @.str46162, i1 1, [7 x i8] zeroinitializer }>
@.str46165 = private global { i64, i64, [29 x i8] } { i64 -1, i64 28, [29 x i8] c"mbedtls/library/ssl_ticket.c\00" }
@.str46167 = private global { i64, i64, [16925 x i8] } { i64 -1, i64 16924, [16925 x i8] c"/*\0A *  TLS server tickets callbacks implementation\0A *\0A *  Copyright The Mbed TLS Contributors\0A *  SPDX-License-Identifier: Apache-2.0 OR GPL-2.0-or-later\0A */\0A\0A#include \22common.h\22\0A\0A#if defined(MBEDTLS_SSL_TICKET_C)\0A\0A#include \22mbedtls/platform.h\22\0A\0A#include \22ssl_misc.h\22\0A#include \22mbedtls/ssl_ticket.h\22\0A#include \22mbedtls/error.h\22\0A#include \22mbedtls/platform_util.h\22\0A\0A#include <string.h>\0A\0A#if defined(MBEDTLS_USE_PSA_CRYPTO)\0A/* Define a local translating function to save code size by not using too many\0A * arguments in each translating place. */\0Astatic int local_err_translation(psa_status_t status)\0A{\0A    return psa_status_to_mbedtls(status, psa_to_ssl_errors,\0A                                 ARRAY_LENGTH(psa_to_ssl_errors),\0A                                 psa_generic_status_to_mbedtls);\0A}\0A#define PSA_TO_MBEDTLS_ERR(status) local_err_translation(status)\0A#endif\0A\0A/*\0A * Initialize context\0A */\0Avoid mbedtls_ssl_ticket_init(mbedtls_ssl_ticket_context *ctx)\0A{\0A    memset(ctx, 0, sizeof(mbedtls_ssl_ticket_context));\0A\0A#if defined(MBEDTLS_THREADING_C)\0A    mbedtls_mutex_init(&ctx->mutex);\0A#endif\0A}\0A\0A#define MAX_KEY_BYTES           MBEDTLS_SSL_TICKET_MAX_KEY_BYTES\0A\0A#define TICKET_KEY_NAME_BYTES   MBEDTLS_SSL_TICKET_KEY_NAME_BYTES\0A#define TICKET_IV_BYTES         12\0A#define TICKET_CRYPT_LEN_BYTES   2\0A#define TICKET_AUTH_TAG_BYTES   16\0A\0A#define TICKET_MIN_LEN (TICKET_KEY_NAME_BYTES  +        \5C\0A                        TICKET_IV_BYTES        +        \5C\0A                        TICKET_CRYPT_LEN_BYTES +        \5C\0A                        TICKET_AUTH_TAG_BYTES)\0A#define TICKET_ADD_DATA_LEN (TICKET_KEY_NAME_BYTES  +        \5C\0A                             TICKET_IV_BYTES        +        \5C\0A                             TICKET_CRYPT_LEN_BYTES)\0A\0A/*\0A * Generate/update a key\0A */\0AMBEDTLS_CHECK_RETURN_CRITICAL\0Astatic int ssl_ticket_gen_key(mbedtls_ssl_ticket_context *ctx,\0A                              unsigned char index)\0A{\0A    int ret = MBEDTLS_ERR_ERROR_CORRUPTION_DETECTED;\0A    unsigned char buf[MAX_KEY_BYTES] = { 0 };\0A    mbedtls_ssl_ticket_key *key = ctx->keys + index;\0A\0A#if defined(MBEDTLS_USE_PSA_CRYPTO)\0A    psa_key_attributes_t attributes = PSA_KEY_ATTRIBUTES_INIT;\0A#endif\0A\0A#if defined(MBEDTLS_HAVE_TIME)\0A    key->generation_time = mbedtls_time(NULL);\0A#endif\0A    /* The lifetime of a key is the configured lifetime of the tickets when\0A     * the key is created.\0A     */\0A    key->lifetime = ctx->ticket_lifetime;\0A\0A    if ((ret = ctx->f_rng(ctx->p_rng, key->name, sizeof(key->name))) != 0) {\0A        return ret;\0A    }\0A\0A    if ((ret = ctx->f_rng(ctx->p_rng, buf, sizeof(buf))) != 0) {\0A        return ret;\0A    }\0A\0A#if defined(MBEDTLS_USE_PSA_CRYPTO)\0A    psa_set_key_usage_flags(&attributes,\0A                            PSA_KEY_USAGE_ENCRYPT | PSA_KEY_USAGE_DECRYPT);\0A    psa_set_key_algorithm(&attributes, key->alg);\0A    psa_set_key_type(&attributes, key->key_type);\0A    psa_set_key_bits(&attributes, key->key_bits);\0A\0A    ret = PSA_TO_MBEDTLS_ERR(\0A        psa_import_key(&attributes, buf,\0A                       PSA_BITS_TO_BYTES(key->key_bits),\0A                       &key->key));\0A#else\0A    /* With GCM and CCM, same context can encrypt & decrypt */\0A    ret = mbedtls_cipher_setkey(&key->ctx, buf,\0A                                mbedtls_cipher_get_key_bitlen(&key->ctx),\0A                                MBEDTLS_ENCRYPT);\0A#endif /* MBEDTLS_USE_PSA_CRYPTO */\0A\0A    mbedtls_platform_zeroize(buf, sizeof(buf));\0A\0A    return ret;\0A}\0A\0A/*\0A * Rotate/generate keys if necessary\0A */\0AMBEDTLS_CHECK_RETURN_CRITICAL\0Astatic int ssl_ticket_update_keys(mbedtls_ssl_ticket_context *ctx)\0A{\0A#if !defined(MBEDTLS_HAVE_TIME)\0A    ((void) ctx);\0A#else\0A    mbedtls_ssl_ticket_key * const key = ctx->keys + ctx->active;\0A    if (key->lifetime != 0) {\0A        mbedtls_time_t current_time = mbedtls_time(NULL);\0A        mbedtls_time_t key_time = key->generation_time;\0A\0A#if defined(MBEDTLS_USE_PSA_CRYPTO)\0A        psa_status_t status = PSA_ERROR_CORRUPTION_DETECTED;\0A#endif\0A\0A        if (current_time >= key_time &&\0A            (uint64_t) (current_time - key_time) < key->lifetime) {\0A            return 0;\0A        }\0A\0A        ctx->active = 1 - ctx->active;\0A\0A#if defined(MBEDTLS_USE_PSA_CRYPTO)\0A        if ((status = psa_destroy_key(ctx->keys[ctx->active].key)) != PSA_SUCCESS) {\0A            return PSA_TO_MBEDTLS_ERR(status);\0A        }\0A#endif /* MBEDTLS_USE_PSA_CRYPTO */\0A\0A        return ssl_ticket_gen_key(ctx, ctx->active);\0A    } else\0A#endif /* MBEDTLS_HAVE_TIME */\0A    return 0;\0A}\0A\0A/*\0A * Rotate active session ticket encryption key\0A */\0Aint mbedtls_ssl_ticket_rotate(mbedtls_ssl_ticket_context *ctx,\0A                              const unsigned char *name, size_t nlength,\0A                              const unsigned char *k, size_t klength,\0A                              uint32_t lifetime)\0A{\0A    const unsigned char idx = 1 - ctx->active;\0A    mbedtls_ssl_ticket_key * const key = ctx->keys + idx;\0A    int ret = MBEDTLS_ERR_ERROR_CORRUPTION_DETECTED;\0A\0A#if defined(MBEDTLS_USE_PSA_CRYPTO)\0A    psa_status_t status = PSA_ERROR_CORRUPTION_DETECTED;\0A    psa_key_attributes_t attributes = PSA_KEY_ATTRIBUTES_INIT;\0A    const size_t bitlen = key->key_bits;\0A#else\0A    const int bitlen = mbedtls_cipher_get_key_bitlen(&key->ctx);\0A#endif\0A\0A    if (nlength < TICKET_KEY_NAME_BYTES || klength * 8 < (size_t) bitlen) {\0A        return MBEDTLS_ERR_CIPHER_BAD_INPUT_DATA;\0A    }\0A\0A#if defined(MBEDTLS_USE_PSA_CRYPTO)\0A    if ((status = psa_destroy_key(key->key)) != PSA_SUCCESS) {\0A        ret = PSA_TO_MBEDTLS_ERR(status);\0A        return ret;\0A    }\0A\0A    psa_set_key_usage_flags(&attributes,\0A                            PSA_KEY_USAGE_ENCRYPT | PSA_KEY_USAGE_DECRYPT);\0A    psa_set_key_algorithm(&attributes, key->alg);\0A    psa_set_key_type(&attributes, key->key_type);\0A    psa_set_key_bits(&attributes, key->key_bits);\0A\0A    if ((status = psa_import_key(&attributes, k,\0A                                 PSA_BITS_TO_BYTES(key->key_bits),\0A                                 &key->key)) != PSA_SUCCESS) {\0A        ret = PSA_TO_MBEDTLS_ERR(status);\0A        return ret;\0A    }\0A#else\0A    ret = mbedtls_cipher_setkey(&key->ctx, k, bitlen, MBEDTLS_ENCRYPT);\0A    if (ret != 0) {\0A        return ret;\0A    }\0A#endif /* MBEDTLS_USE_PSA_CRYPTO */\0A\0A    ctx->active = idx;\0A    ctx->ticket_lifetime = lifetime;\0A    memcpy(key->name, name, TICKET_KEY_NAME_BYTES);\0A#if defined(MBEDTLS_HAVE_TIME)\0A    key->generation_time = mbedtls_time(NULL);\0A#endif\0A    key->lifetime = lifetime;\0A\0A    return 0;\0A}\0A\0A/*\0A * Setup context for actual use\0A */\0Aint mbedtls_ssl_ticket_setup(mbedtls_ssl_ticket_context *ctx,\0A                             int (*f_rng)(void *, unsigned char *, size_t), void *p_rng,\0A                             mbedtls_cipher_type_t cipher,\0A                             uint32_t lifetime)\0A{\0A    int ret = MBEDTLS_ERR_ERROR_CORRUPTION_DETECTED;\0A    size_t key_bits;\0A\0A#if defined(MBEDTLS_USE_PSA_CRYPTO)\0A    psa_algorithm_t alg;\0A    psa_key_type_t key_type;\0A#else\0A    const mbedtls_cipher_info_t *cipher_info;\0A#endif /* MBEDTLS_USE_PSA_CRYPTO */\0A\0A#if defined(MBEDTLS_USE_PSA_CRYPTO)\0A    if (mbedtls_ssl_cipher_to_psa(cipher, TICKET_AUTH_TAG_BYTES,\0A                                  &alg, &key_type, &key_bits) != PSA_SUCCESS) {\0A        return MBEDTLS_ERR_SSL_BAD_INPUT_DATA;\0A    }\0A\0A    if (PSA_ALG_IS_AEAD(alg) == 0) {\0A        return MBEDTLS_ERR_SSL_BAD_INPUT_DATA;\0A    }\0A#else\0A    cipher_info = mbedtls_cipher_info_from_type(cipher);\0A\0A    if (mbedtls_cipher_info_get_mode(cipher_info) != MBEDTLS_MODE_GCM &&\0A        mbedtls_cipher_info_get_mode(cipher_info) != MBEDTLS_MODE_CCM &&\0A        mbedtls_cipher_info_get_mode(cipher_info) != MBEDTLS_MODE_CHACHAPOLY) {\0A        return MBEDTLS_ERR_SSL_BAD_INPUT_DATA;\0A    }\0A\0A    key_bits = mbedtls_cipher_info_get_key_bitlen(cipher_info);\0A#endif /* MBEDTLS_USE_PSA_CRYPTO */\0A\0A    if (key_bits > 8 * MAX_KEY_BYTES) {\0A        return MBEDTLS_ERR_SSL_BAD_INPUT_DATA;\0A    }\0A\0A    ctx->f_rng = f_rng;\0A    ctx->p_rng = p_rng;\0A\0A    ctx->ticket_lifetime = lifetime;\0A\0A#if defined(MBEDTLS_USE_PSA_CRYPTO)\0A    ctx->keys[0].alg = alg;\0A    ctx->keys[0].key_type = key_type;\0A    ctx->keys[0].key_bits = key_bits;\0A\0A    ctx->keys[1].alg = alg;\0A    ctx->keys[1].key_type = key_type;\0A    ctx->keys[1].key_bits = key_bits;\0A#else\0A    if ((ret = mbedtls_cipher_setup(&ctx->keys[0].ctx, cipher_info)) != 0) {\0A        return ret;\0A    }\0A\0A    if ((ret = mbedtls_cipher_setup(&ctx->keys[1].ctx, cipher_info)) != 0) {\0A        return ret;\0A    }\0A#endif /* MBEDTLS_USE_PSA_CRYPTO */\0A\0A    if ((ret = ssl_ticket_gen_key(ctx, 0)) != 0 ||\0A        (ret = ssl_ticket_gen_key(ctx, 1)) != 0) {\0A        return ret;\0A    }\0A\0A    return 0;\0A}\0A\0A/*\0A * Create session ticket, with the following structure:\0A *\0A *    struct {\0A *        opaque key_name[4];\0A *        opaque iv[12];\0A *        opaque encrypted_state<0..2^16-1>;\0A *        opaque tag[16];\0A *    } ticket;\0A *\0A * The key_name, iv, and length of encrypted_state are the additional\0A * authenticated data.\0A */\0A\0Aint mbedtls_ssl_ticket_write(void *p_ticket,\0A                             const mbedtls_ssl_session *session,\0A                             unsigned char *start,\0A                             const unsigned char *end,\0A                             size_t *tlen,\0A                             uint32_t *ticket_lifetime)\0A{\0A    int ret = MBEDTLS_ERR_ERROR_CORRUPTION_DETECTED;\0A    mbedtls_ssl_ticket_context *ctx = p_ticket;\0A    mbedtls_ssl_ticket_key *key;\0A    unsigned char *key_name = start;\0A    unsigned char *iv = start + TICKET_KEY_NAME_BYTES;\0A    unsigned char *state_len_bytes = iv + TICKET_IV_BYTES;\0A    unsigned char *state = state_len_bytes + TICKET_CRYPT_LEN_BYTES;\0A    size_t clear_len, ciph_len;\0A\0A#if defined(MBEDTLS_USE_PSA_CRYPTO)\0A    psa_status_t status = PSA_ERROR_CORRUPTION_DETECTED;\0A#endif\0A\0A    *tlen = 0;\0A\0A    if (ctx == NULL || ctx->f_rng == NULL) {\0A        return MBEDTLS_ERR_SSL_BAD_INPUT_DATA;\0A    }\0A\0A    /* We need at least 4 bytes for key_name, 12 for IV, 2 for len 16 for tag,\0A     * in addition to session itself, that will be checked when writing it. */\0A    MBEDTLS_SSL_CHK_BUF_PTR(start, end, TICKET_MIN_LEN);\0A\0A#if defined(MBEDTLS_THREADING_C)\0A    if ((ret = mbedtls_mutex_lock(&ctx->mutex)) != 0) {\0A        return ret;\0A    }\0A#endif\0A\0A    if ((ret = ssl_ticket_update_keys(ctx)) != 0) {\0A        goto cleanup;\0A    }\0A\0A    key = &ctx->keys[ctx->active];\0A\0A    *ticket_lifetime = key->lifetime;\0A\0A    memcpy(key_name, key->name, TICKET_KEY_NAME_BYTES);\0A\0A    if ((ret = ctx->f_rng(ctx->p_rng, iv, TICKET_IV_BYTES)) != 0) {\0A        goto cleanup;\0A    }\0A\0A    /* Dump session state */\0A    if ((ret = mbedtls_ssl_session_save(session,\0A                                        state, (size_t) (end - state),\0A                                        &clear_len)) != 0 ||\0A        (unsigned long) clear_len > 65535) {\0A        goto cleanup;\0A    }\0A    MBEDTLS_PUT_UINT16_BE(clear_len, state_len_bytes, 0);\0A\0A    /* Encrypt and authenticate */\0A#if defined(MBEDTLS_USE_PSA_CRYPTO)\0A    if ((status = psa_aead_encrypt(key->key, key->alg, iv, TICKET_IV_BYTES,\0A                                   key_name, TICKET_ADD_DATA_LEN,\0A                                   state, clear_len,\0A                                   state, end - state,\0A                                   &ciph_len)) != PSA_SUCCESS) {\0A        ret = PSA_TO_MBEDTLS_ERR(status);\0A        goto cleanup;\0A    }\0A#else\0A    if ((ret = mbedtls_cipher_auth_encrypt_ext(&key->ctx,\0A                                               iv, TICKET_IV_BYTES,\0A                                               /* Additional data: key name, IV and length */\0A                                               key_name, TICKET_ADD_DATA_LEN,\0A                                               state, clear_len,\0A                                               state, (size_t) (end - state), &ciph_len,\0A                                               TICKET_AUTH_TAG_BYTES)) != 0) {\0A        goto cleanup;\0A    }\0A#endif /* MBEDTLS_USE_PSA_CRYPTO */\0A\0A    if (ciph_len != clear_len + TICKET_AUTH_TAG_BYTES) {\0A        ret = MBEDTLS_ERR_SSL_INTERNAL_ERROR;\0A        goto cleanup;\0A    }\0A\0A    *tlen = TICKET_MIN_LEN + ciph_len - TICKET_AUTH_TAG_BYTES;\0A\0Acleanup:\0A#if defined(MBEDTLS_THREADING_C)\0A    if (mbedtls_mutex_unlock(&ctx->mutex) != 0) {\0A        return MBEDTLS_ERR_THREADING_MUTEX_ERROR;\0A    }\0A#endif\0A\0A    return ret;\0A}\0A\0A/*\0A * Select key based on name\0A */\0Astatic mbedtls_ssl_ticket_key *ssl_ticket_select_key(\0A    mbedtls_ssl_ticket_context *ctx,\0A    const unsigned char name[4])\0A{\0A    unsigned char i;\0A\0A    for (i = 0; i < sizeof(ctx->keys) / sizeof(*ctx->keys); i++) {\0A        if (memcmp(name, ctx->keys[i].name, 4) == 0) {\0A            return &ctx->keys[i];\0A        }\0A    }\0A\0A    return NULL;\0A}\0A\0A/*\0A * Load session ticket (see mbedtls_ssl_ticket_write for structure)\0A */\0Aint mbedtls_ssl_ticket_parse(void *p_ticket,\0A                             mbedtls_ssl_session *session,\0A                             unsigned char *buf,\0A                             size_t len)\0A{\0A    int ret = MBEDTLS_ERR_ERROR_CORRUPTION_DETECTED;\0A    mbedtls_ssl_ticket_context *ctx = p_ticket;\0A    mbedtls_ssl_ticket_key *key;\0A    unsigned char *key_name = buf;\0A    unsigned char *iv = buf + TICKET_KEY_NAME_BYTES;\0A    unsigned char *enc_len_p = iv + TICKET_IV_BYTES;\0A    unsigned char *ticket = enc_len_p + TICKET_CRYPT_LEN_BYTES;\0A    size_t enc_len, clear_len;\0A\0A#if defined(MBEDTLS_USE_PSA_CRYPTO)\0A    psa_status_t status = PSA_ERROR_CORRUPTION_DETECTED;\0A#endif\0A\0A    if (ctx == NULL || ctx->f_rng == NULL) {\0A        return MBEDTLS_ERR_SSL_BAD_INPUT_DATA;\0A    }\0A\0A    if (len < TICKET_MIN_LEN) {\0A        return MBEDTLS_ERR_SSL_BAD_INPUT_DATA;\0A    }\0A\0A#if defined(MBEDTLS_THREADING_C)\0A    if ((ret = mbedtls_mutex_lock(&ctx->mutex)) != 0) {\0A        return ret;\0A    }\0A#endif\0A\0A    if ((ret = ssl_ticket_update_keys(ctx)) != 0) {\0A        goto cleanup;\0A    }\0A\0A    enc_len = MBEDTLS_GET_UINT16_BE(enc_len_p, 0);\0A\0A    if (len != TICKET_MIN_LEN + enc_len) {\0A        ret = MBEDTLS_ERR_SSL_BAD_INPUT_DATA;\0A        goto cleanup;\0A    }\0A\0A    /* Select key */\0A    if ((key = ssl_ticket_select_key(ctx, key_name)) == NULL) {\0A        /* We can't know for sure but this is a likely option unless we're\0A         * under attack - this is only informative anyway */\0A        ret = MBEDTLS_ERR_SSL_SESSION_TICKET_EXPIRED;\0A        goto cleanup;\0A    }\0A\0A    /* Decrypt and authenticate */\0A#if defined(MBEDTLS_USE_PSA_CRYPTO)\0A    if ((status = psa_aead_decrypt(key->key, key->alg, iv, TICKET_IV_BYTES,\0A                                   key_name, TICKET_ADD_DATA_LEN,\0A                                   ticket, enc_len + TICKET_AUTH_TAG_BYTES,\0A                                   ticket, enc_len, &clear_len)) != PSA_SUCCESS) {\0A        ret = PSA_TO_MBEDTLS_ERR(status);\0A        goto cleanup;\0A    }\0A#else\0A    if ((ret = mbedtls_cipher_auth_decrypt_ext(&key->ctx,\0A                                               iv, TICKET_IV_BYTES,\0A                                               /* Additional data: key name, IV and length */\0A                                               key_name, TICKET_ADD_DATA_LEN,\0A                                               ticket, enc_len + TICKET_AUTH_TAG_BYTES,\0A                                               ticket, enc_len, &clear_len,\0A                                               TICKET_AUTH_TAG_BYTES)) != 0) {\0A        if (ret == MBEDTLS_ERR_CIPHER_AUTH_FAILED) {\0A            ret = MBEDTLS_ERR_SSL_INVALID_MAC;\0A        }\0A\0A        goto cleanup;\0A    }\0A#endif /* MBEDTLS_USE_PSA_CRYPTO */\0A\0A    if (clear_len != enc_len) {\0A        ret = MBEDTLS_ERR_SSL_INTERNAL_ERROR;\0A        goto cleanup;\0A    }\0A\0A    /* Actually load session */\0A    if ((ret = mbedtls_ssl_session_load(session, ticket, clear_len)) != 0) {\0A        goto cleanup;\0A    }\0A\0A#if defined(MBEDTLS_HAVE_TIME)\0A    mbedtls_ms_time_t ticket_creation_time, ticket_age;\0A    mbedtls_ms_time_t ticket_lifetime =\0A        (mbedtls_ms_time_t) key->lifetime * 1000;\0A\0A    ret = mbedtls_ssl_session_get_ticket_creation_time(session,\0A                                                       &ticket_creation_time);\0A    if (ret != 0) {\0A        goto cleanup;\0A    }\0A\0A    ticket_age = mbedtls_ms_time() - ticket_creation_time;\0A    if (ticket_age < 0 || ticket_age > ticket_lifetime) {\0A        ret = MBEDTLS_ERR_SSL_SESSION_TICKET_EXPIRED;\0A        goto cleanup;\0A    }\0A#endif\0A\0Acleanup:\0A#if defined(MBEDTLS_THREADING_C)\0A    if (mbedtls_mutex_unlock(&ctx->mutex) != 0) {\0A        return MBEDTLS_ERR_THREADING_MUTEX_ERROR;\0A    }\0A#endif\0A\0A    return ret;\0A}\0A\0A/*\0A * Free context\0A */\0Avoid mbedtls_ssl_ticket_free(mbedtls_ssl_ticket_context *ctx)\0A{\0A    if (ctx == NULL) {\0A        return;\0A    }\0A\0A#if defined(MBEDTLS_USE_PSA_CRYPTO)\0A    psa_destroy_key(ctx->keys[0].key);\0A    psa_destroy_key(ctx->keys[1].key);\0A#else\0A    mbedtls_cipher_free(&ctx->keys[0].ctx);\0A    mbedtls_cipher_free(&ctx->keys[1].ctx);\0A#endif /* MBEDTLS_USE_PSA_CRYPTO */\0A\0A#if defined(MBEDTLS_THREADING_C)\0A    mb