@.str40500 = private global { i64, i64, [12516 x i8] } { i64 -1, i64 12515, [12516 x i8] c"/*\0A * ASN.1 buffer writing functionality\0A *\0A *  Copyright The Mbed TLS Contributors\0A *  SPDX-License-Identifier: Apache-2.0 OR GPL-2.0-or-later\0A */\0A\0A#include \22common.h\22\0A\0A#if defined(MBEDTLS_ASN1_WRITE_C) || defined(MBEDTLS_X509_USE_C) || \5C\0A    defined(MBEDTLS_PSA_UTIL_HAVE_ECDSA)\0A\0A#include \22mbedtls/asn1write.h\22\0A#include \22mbedtls/error.h\22\0A\0A#include <string.h>\0A\0A#include \22mbedtls/platform.h\22\0A\0A#if defined(MBEDTLS_ASN1_PARSE_C)\0A#include \22mbedtls/asn1.h\22\0A#endif\0A\0Aint mbedtls_asn1_write_len(unsigned char **p, const unsigned char *start, size_t len)\0A{\0A#if SIZE_MAX > 0xFFFFFFFF\0A    if (len > 0xFFFFFFFF) {\0A        return MBEDTLS_ERR_ASN1_INVALID_LENGTH;\0A    }\0A#endif\0A\0A    int required = 1;\0A\0A    if (len >= 0x80) {\0A        for (size_t l = len; l != 0; l >>= 8) {\0A            required++;\0A        }\0A    }\0A\0A    if (required > (*p - start)) {\0A        return MBEDTLS_ERR_ASN1_BUF_TOO_SMALL;\0A    }\0A\0A    do {\0A        *--(*p) = MBEDTLS_BYTE_0(len);\0A        len >>= 8;\0A    } while (len);\0A\0A    if (required > 1) {\0A        *--(*p) = (unsigned char) (0x80 + required - 1);\0A    }\0A\0A    return required;\0A}\0A\0Aint mbedtls_asn1_write_tag(unsigned char **p, const unsigned char *start, unsigned char tag)\0A{\0A    if (*p - start < 1) {\0A        return MBEDTLS_ERR_ASN1_BUF_TOO_SMALL;\0A    }\0A\0A    *--(*p) = tag;\0A\0A    return 1;\0A}\0A#endif /* MBEDTLS_ASN1_WRITE_C || MBEDTLS_X509_USE_C || MBEDTLS_PSA_UTIL_HAVE_ECDSA */\0A\0A#if defined(MBEDTLS_ASN1_WRITE_C)\0Astatic int mbedtls_asn1_write_len_and_tag(unsigned char **p,\0A                                          const unsigned char *start,\0A                                          size_t len,\0A                                          unsigned char tag)\0A{\0A    int ret = MBEDTLS_ERR_ERROR_CORRUPTION_DETECTED;\0A\0A    MBEDTLS_ASN1_CHK_ADD(len, mbedtls_asn1_write_len(p, start, len));\0A    MBEDTLS_ASN1_CHK_ADD(len, mbedtls_asn1_write_tag(p, start, tag));\0A\0A    return (int) len;\0A}\0A\0Aint mbedtls_asn1_write_raw_buffer(unsigned char **p, const unsigned char *start,\0A                                  const unsigned char *buf, size_t size)\0A{\0A    size_t len = 0;\0A\0A    if (*p < start || (size_t) (*p - start) < size) {\0A        return MBEDTLS_ERR_ASN1_BUF_TOO_SMALL;\0A    }\0A\0A    len = size;\0A    (*p) -= len;\0A    memcpy(*p, buf, len);\0A\0A    return (int) len;\0A}\0A\0A#if defined(MBEDTLS_BIGNUM_C)\0Aint mbedtls_asn1_write_mpi(unsigned char **p, const unsigned char *start, const mbedtls_mpi *X)\0A{\0A    int ret = MBEDTLS_ERR_ERROR_CORRUPTION_DETECTED;\0A    size_t len = 0;\0A\0A    // Write the MPI\0A    //\0A    len = mbedtls_mpi_size(X);\0A\0A    /* DER represents 0 with a sign bit (0=nonnegative) and 7 value bits, not\0A     * as 0 digits. We need to end up with 020100, not with 0200. */\0A    if (len == 0) {\0A        len = 1;\0A    }\0A\0A    if (*p < start || (size_t) (*p - start) < len) {\0A        return MBEDTLS_ERR_ASN1_BUF_TOO_SMALL;\0A    }\0A\0A    (*p) -= len;\0A    MBEDTLS_MPI_CHK(mbedtls_mpi_write_binary(X, *p, len));\0A\0A    // DER format assumes 2s complement for numbers, so the leftmost bit\0A    // should be 0 for positive numbers and 1 for negative numbers.\0A    //\0A    if (X->s == 1 && **p & 0x80) {\0A        if (*p - start < 1) {\0A            return MBEDTLS_ERR_ASN1_BUF_TOO_SMALL;\0A        }\0A\0A        *--(*p) = 0x00;\0A        len += 1;\0A    }\0A\0A    ret = mbedtls_asn1_write_len_and_tag(p, start, len, MBEDTLS_ASN1_INTEGER);\0A\0Acleanup:\0A    return ret;\0A}\0A#endif /* MBEDTLS_BIGNUM_C */\0A\0Aint mbedtls_asn1_write_null(unsigned char **p, const unsigned char *start)\0A{\0A    // Write NULL\0A    //\0A    return mbedtls_asn1_write_len_and_tag(p, start, 0, MBEDTLS_ASN1_NULL);\0A}\0A\0Aint mbedtls_asn1_write_oid(unsigned char **p, const unsigned char *start,\0A                           const char *oid, size_t oid_len)\0A{\0A    int ret = MBEDTLS_ERR_ERROR_CORRUPTION_DETECTED;\0A    size_t len = 0;\0A\0A    MBEDTLS_ASN1_CHK_ADD(len, mbedtls_asn1_write_raw_buffer(p, start,\0A                                                            (const unsigned char *) oid, oid_len));\0A    return mbedtls_asn1_write_len_and_tag(p, start, len, MBEDTLS_ASN1_OID);\0A}\0A\0Aint mbedtls_asn1_write_algorithm_identifier(unsigned char **p, const unsigned char *start,\0A                                            const char *oid, size_t oid_len,\0A                                            size_t par_len)\0A{\0A    return mbedtls_asn1_write_algorithm_identifier_ext(p, start, oid, oid_len, par_len, 1);\0A}\0A\0Aint mbedtls_asn1_write_algorithm_identifier_ext(unsigned char **p, const unsigned char *start,\0A                                                const char *oid, size_t oid_len,\0A                                                size_t par_len, int has_par)\0A{\0A    int ret = MBEDTLS_ERR_ERROR_CORRUPTION_DETECTED;\0A    size_t len = 0;\0A\0A    if (has_par) {\0A        if (par_len == 0) {\0A            MBEDTLS_ASN1_CHK_ADD(len, mbedtls_asn1_write_null(p, start));\0A        } else {\0A            len += par_len;\0A        }\0A    }\0A\0A    MBEDTLS_ASN1_CHK_ADD(len, mbedtls_asn1_write_oid(p, start, oid, oid_len));\0A\0A    return mbedtls_asn1_write_len_and_tag(p, start, len,\0A                                          MBEDTLS_ASN1_CONSTRUCTED | MBEDTLS_ASN1_SEQUENCE);\0A}\0A\0Aint mbedtls_asn1_write_bool(unsigned char **p, const unsigned char *start, int boolean)\0A{\0A    size_t len = 0;\0A\0A    if (*p - start < 1) {\0A        return MBEDTLS_ERR_ASN1_BUF_TOO_SMALL;\0A    }\0A\0A    *--(*p) = (boolean) ? 255 : 0;\0A    len++;\0A\0A    return mbedtls_asn1_write_len_and_tag(p, start, len, MBEDTLS_ASN1_BOOLEAN);\0A}\0A\0Astatic int asn1_write_tagged_int(unsigned char **p, const unsigned char *start, int val, int tag)\0A{\0A    size_t len = 0;\0A\0A    do {\0A        if (*p - start < 1) {\0A            return MBEDTLS_ERR_ASN1_BUF_TOO_SMALL;\0A        }\0A        len += 1;\0A        *--(*p) = val & 0xff;\0A        val >>= 8;\0A    } while (val > 0);\0A\0A    if (**p & 0x80) {\0A        if (*p - start < 1) {\0A            return MBEDTLS_ERR_ASN1_BUF_TOO_SMALL;\0A        }\0A        *--(*p) = 0x00;\0A        len += 1;\0A    }\0A\0A    return mbedtls_asn1_write_len_and_tag(p, start, len, tag);\0A}\0A\0Aint mbedtls_asn1_write_int(unsigned char **p, const unsigned char *start, int val)\0A{\0A    return asn1_write_tagged_int(p, start, val, MBEDTLS_ASN1_INTEGER);\0A}\0A\0Aint mbedtls_asn1_write_enum(unsigned char **p, const unsigned char *start, int val)\0A{\0A    return asn1_write_tagged_int(p, start, val, MBEDTLS_ASN1_ENUMERATED);\0A}\0A\0Aint mbedtls_asn1_write_tagged_string(unsigned char **p, const unsigned char *start, int tag,\0A                                     const char *text, size_t text_len)\0A{\0A    int ret = MBEDTLS_ERR_ERROR_CORRUPTION_DETECTED;\0A    size_t len = 0;\0A\0A    MBEDTLS_ASN1_CHK_ADD(len, mbedtls_asn1_write_raw_buffer(p, start,\0A                                                            (const unsigned char *) text,\0A                                                            text_len));\0A\0A    return mbedtls_asn1_write_len_and_tag(p, start, len, tag);\0A}\0A\0Aint mbedtls_asn1_write_utf8_string(unsigned char **p, const unsigned char *start,\0A                                   const char *text, size_t text_len)\0A{\0A    return mbedtls_asn1_write_tagged_string(p, start, MBEDTLS_ASN1_UTF8_STRING, text, text_len);\0A}\0A\0Aint mbedtls_asn1_write_printable_string(unsigned char **p, const unsigned char *start,\0A                                        const char *text, size_t text_len)\0A{\0A    return mbedtls_asn1_write_tagged_string(p, start, MBEDTLS_ASN1_PRINTABLE_STRING, text,\0A                                            text_len);\0A}\0A\0Aint mbedtls_asn1_write_ia5_string(unsigned char **p, const unsigned char *start,\0A                                  const char *text, size_t text_len)\0A{\0A    return mbedtls_asn1_write_tagged_string(p, start, MBEDTLS_ASN1_IA5_STRING, text, text_len);\0A}\0A\0Aint mbedtls_asn1_write_named_bitstring(unsigned char **p,\0A                                       const unsigned char *start,\0A                                       const unsigned char *buf,\0A                                       size_t bits)\0A{\0A    size_t unused_bits, byte_len;\0A    const unsigned char *cur_byte;\0A    unsigned char cur_byte_shifted;\0A    unsigned char bit;\0A\0A    byte_len = (bits + 7) / 8;\0A    unused_bits = (byte_len * 8) - bits;\0A\0A    /*\0A     * Named bitstrings require that trailing 0s are excluded in the encoding\0A     * of the bitstring. Trailing 0s are considered part of the 'unused' bits\0A     * when encoding this value in the first content octet\0A     */\0A    if (bits != 0) {\0A        cur_byte = buf + byte_len - 1;\0A        cur_byte_shifted = *cur_byte >> unused_bits;\0A\0A        for (;;) {\0A            bit = cur_byte_shifted & 0x1;\0A            cur_byte_shifted >>= 1;\0A\0A            if (bit != 0) {\0A                break;\0A            }\0A\0A            bits--;\0A            if (bits == 0) {\0A                break;\0A            }\0A\0A            if (bits % 8 == 0) {\0A                cur_byte_shifted = *--cur_byte;\0A            }\0A        }\0A    }\0A\0A    return mbedtls_asn1_write_bitstring(p, start, buf, bits);\0A}\0A\0Aint mbedtls_asn1_write_bitstring(unsigned char **p, const unsigned char *start,\0A                                 const unsigned char *buf, size_t bits)\0A{\0A    size_t len = 0;\0A    size_t unused_bits, byte_len;\0A\0A    byte_len = (bits + 7) / 8;\0A    unused_bits = (byte_len * 8) - bits;\0A\0A    if (*p < start || (size_t) (*p - start) < byte_len + 1) {\0A        return MBEDTLS_ERR_ASN1_BUF_TOO_SMALL;\0A    }\0A\0A    len = byte_len + 1;\0A\0A    /* Write the bitstring. Ensure the unused bits are zeroed */\0A    if (byte_len > 0) {\0A        byte_len--;\0A        *--(*p) = buf[byte_len] & ~((0x1 << unused_bits) - 1);\0A        (*p) -= byte_len;\0A        memcpy(*p, buf, byte_len);\0A    }\0A\0A    /* Write unused bits */\0A    *--(*p) = (unsigned char) unused_bits;\0A\0A    return mbedtls_asn1_write_len_and_tag(p, start, len, MBEDTLS_ASN1_BIT_STRING);\0A}\0A\0Aint mbedtls_asn1_write_octet_string(unsigned char **p, const unsigned char *start,\0A                                    const unsigned char *buf, size_t size)\0A{\0A    int ret = MBEDTLS_ERR_ERROR_CORRUPTION_DETECTED;\0A    size_t len = 0;\0A\0A    MBEDTLS_ASN1_CHK_ADD(len, mbedtls_asn1_write_raw_buffer(p, start, buf, size));\0A\0A    return mbedtls_asn1_write_len_and_tag(p, start, len, MBEDTLS_ASN1_OCTET_STRING);\0A}\0A\0A\0A#if !defined(MBEDTLS_ASN1_PARSE_C)\0A/* This is a copy of the ASN.1 parsing function mbedtls_asn1_find_named_data(),\0A * which is replicated to avoid a dependency ASN1_WRITE_C on ASN1_PARSE_C. */\0Astatic mbedtls_asn1_named_data *asn1_find_named_data(\0A    mbedtls_asn1_named_data *list,\0A    const char *oid, size_t len)\0A{\0A    while (list != NULL) {\0A        if (list->oid.len == len &&\0A            memcmp(list->oid.p, oid, len) == 0) {\0A            break;\0A        }\0A\0A        list = list->next;\0A    }\0A\0A    return list;\0A}\0A#else\0A#define asn1_find_named_data(list, oid, len) \5C\0A    ((mbedtls_asn1_named_data *) mbedtls_asn1_find_named_data(list, oid, len))\0A#endif\0A\0Ambedtls_asn1_named_data *mbedtls_asn1_store_named_data(\0A    mbedtls_asn1_named_data **head,\0A    const char *oid, size_t oid_len,\0A    const unsigned char *val,\0A    size_t val_len)\0A{\0A    mbedtls_asn1_named_data *cur;\0A\0A    if ((cur = asn1_find_named_data(*head, oid, oid_len)) == NULL) {\0A        // Add new entry if not present yet based on OID\0A        //\0A        cur = (mbedtls_asn1_named_data *) mbedtls_calloc(1,\0A                                                         sizeof(mbedtls_asn1_named_data));\0A        if (cur == NULL) {\0A            return NULL;\0A        }\0A\0A        cur->oid.len = oid_len;\0A        cur->oid.p = mbedtls_calloc(1, oid_len);\0A        if (cur->oid.p == NULL) {\0A            mbedtls_free(cur);\0A            return NULL;\0A        }\0A\0A        memcpy(cur->oid.p, oid, oid_len);\0A\0A        cur->val.len = val_len;\0A        if (val_len != 0) {\0A            cur->val.p = mbedtls_calloc(1, val_len);\0A            if (cur->val.p == NULL) {\0A                mbedtls_free(cur->oid.p);\0A                mbedtls_free(cur);\0A                return NULL;\0A            }\0A        }\0A\0A        cur->next = *head;\0A        *head = cur;\0A    } else if (val_len == 0) {\0A        mbedtls_free(cur->val.p);\0A        cur->val.p = NULL;\0A    } else if (cur->val.len != val_len) {\0A        /*\0A         * Enlarge existing value buffer if needed\0A         * Preserve old data until the allocation succeeded, to leave list in\0A         * a consistent state in case allocation fails.\0A         */\0A        void *p = mbedtls_calloc(1, val_len);\0A        if (p == NULL) {\0A            return NULL;\0A        }\0A\0A        mbedtls_free(cur->val.p);\0A        cur->val.p = p;\0A        cur->val.len = val_len;\0A    }\0A\0A    if (val != NULL && val_len != 0) {\0A        memcpy(cur->val.p, val, val_len);\0A    }\0A\0A    return cur;\0A}\0A#endif /* MBEDTLS_ASN1_WRITE_C */\0A\00" }
