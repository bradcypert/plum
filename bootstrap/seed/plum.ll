ENABLED */\0A\0A        default:\0A            grp->id = MBEDTLS_ECP_DP_NONE;\0A            return MBEDTLS_ERR_ECP_FEATURE_UNAVAILABLE;\0A    }\0A}\0A\0A#if defined(MBEDTLS_ECP_NIST_OPTIM)\0A/*\0A * Fast reduction modulo the primes used by the NIST curves.\0A *\0A * These functions are critical for speed, but not needed for correct\0A * operations. So, we make the choice to heavily rely on the internals of our\0A * bignum library, which creates a tight coupling between these functions and\0A * our MPI implementation.  However, the coupling between the ECP module and\0A * MPI remains loose, since these functions can be deactivated at will.\0A */\0A\0A#if defined(MBEDTLS_ECP_DP_SECP192R1_ENABLED)\0A/*\0A * Compared to the way things are presented in FIPS 186-3 D.2,\0A * we proceed in columns, from right (least significant chunk) to left,\0A * adding chunks to N in place, and keeping a carry for the next chunk.\0A * This avoids moving things around in memory, and uselessly adding zeros,\0A * compared to the more straightforward, line-oriented approach.\0A *\0A * For this prime we need to handle data in chunks of 64 bits.\0A * Since this is always a multiple of our basic mbedtls_mpi_uint, we can\0A * use a mbedtls_mpi_uint * to designate such a chunk, and small loops to handle it.\0A */\0A\0A/* Add 64-bit chunks (dst += src) and update carry */\0Astatic inline void add64(mbedtls_mpi_uint *dst, mbedtls_mpi_uint *src, mbedtls_mpi_uint *carry)\0A{\0A    unsigned char i;\0A    mbedtls_mpi_uint c = 0;\0A    for (i = 0; i < 8 / sizeof(mbedtls_mpi_uint); i++, dst++, src++) {\0A        *dst += c;      c  = (*dst < c);\0A        *dst += *src;   c += (*dst < *src);\0A    }\0A    *carry += c;\0A}\0A\0A/* Add carry to a 64-bit chunk and update carry */\0Astatic inline void carry64(mbedtls_mpi_uint *dst, mbedtls_mpi_uint *carry)\0A{\0A    unsigned char i;\0A    for (i = 0; i < 8 / sizeof(mbedtls_mpi_uint); i++, dst++) {\0A        *dst += *carry;\0A        *carry  = (*dst < *carry);\0A    }\0A}\0A\0A#define WIDTH       8 / sizeof(mbedtls_mpi_uint)\0A#define A(i)        Np + (i) * WIDTH\0A#define ADD(i)      add64(p, A(i), &c)\0A#define NEXT        p += WIDTH; carry64(p, &c)\0A#define LAST        p += WIDTH; do *p = 0; while (++p < end)\0A#define RESET       last_carry[0] = c; c = 0; p = Np\0A#define ADD_LAST    add64(p, last_carry, &c)\0A\0A/*\0A * Fast quasi-reduction modulo p192 (FIPS 186-3 D.2.1)\0A */\0Astatic int ecp_mod_p192(mbedtls_mpi *N)\0A{\0A    int ret = MBEDTLS_ERR_ERROR_CORRUPTION_DETECTED;\0A    size_t expected_width = BITS_TO_LIMBS(192) * 2;\0A    MBEDTLS_MPI_CHK(mbedtls_mpi_grow(N, expected_width));\0A    ret = mbedtls_ecp_mod_p192_raw(N->p, expected_width);\0A\0Acleanup:\0A    return ret;\0A}\0A\0AMBEDTLS_STATIC_TESTABLE\0Aint mbedtls_ecp_mod_p192_raw(mbedtls_mpi_uint *Np, size_t Nn)\0A{\0A    mbedtls_mpi_uint c = 0, last_carry[WIDTH] = { 0 };\0A    mbedtls_mpi_uint *p, *end;\0A\0A    if (Nn != BITS_TO_LIMBS(192) * 2) {\0A        return MBEDTLS_ERR_ECP_BAD_INPUT_DATA;\0A    }\0A\0A    p = Np;\0A    end = p + Nn;\0A\0A    ADD(3); ADD(5);         NEXT;   // A0 += A3 + A5\0A    ADD(3); ADD(4); ADD(5); NEXT;   // A1 += A3 + A4 + A5\0A    ADD(4); ADD(5);                 // A2 += A4 + A5\0A\0A    RESET;\0A\0A    /* Use the reduction for the carry as well:\0A     * 2^192 * last_carry = 2^64 * last_carry + last_carry mod P192\0A     * It can generate a carry. */\0A    ADD_LAST; NEXT;                 // A0 += last_carry\0A    ADD_LAST; NEXT;                 // A1 += last_carry\0A                                    // A2 += carry\0A\0A    RESET;\0A\0A    /* Use the reduction for the carry as well:\0A     * 2^192 * last_carry = 2^64 * last_carry + last_carry mod P192\0A     */\0A    ADD_LAST; NEXT;                 // A0 += last_carry\0A    ADD_LAST; NEXT;                 // A1 += last_carry\0A                                    // A2 += carry\0A\0A    LAST;\0A\0A    return 0;\0A}\0A\0A#undef WIDTH\0A#undef A\0A#undef ADD\0A#undef NEXT\0A#undef LAST\0A#undef RESET\0A#undef ADD_LAST\0A#endif /* MBEDTLS_ECP_DP_SECP192R1_ENABLED */\0A\0A#if defined(MBEDTLS_ECP_DP_SECP224R1_ENABLED) ||   \5C\0A    defined(MBEDTLS_ECP_DP_SECP256R1_ENABLED) ||   \5C\0A    defined(MBEDTLS_ECP_DP_SECP384R1_ENABLED)\0A\0A/*\0A * The reader is advised to first understand ecp_mod_p192() since the same\0A * general structure is used here, but with additional complications:\0A * (1) chunks of 32 bits, and (2) subtractions.\0A */\0A\0A/*\0A * For these primes, we need to handle data in chunks of 32 bits.\0A * This makes it more complicated if we use 64 bits limbs in MPI,\0A * which prevents us from using a uniform access method as for p192.\0A *\0A * So, we define a mini abstraction layer to access 32 bit chunks,\0A * load them in 'cur' for work, and store them back from 'cur' when done.\0A *\0A * While at it, also define the size of N in terms of 32-bit chunks.\0A */\0A#define LOAD32      cur = A(i);\0A\0A#if defined(MBEDTLS_HAVE_INT32)  /* 32 bit */\0A\0A#define MAX32       X_limbs\0A#define A(j)        X[j]\0A#define STORE32     X[i] = (mbedtls_mpi_uint) cur;\0A#define STORE0      X[i] = 0;\0A\0A#else /* 64 bit */\0A\0A#define MAX32   X_limbs * 2\0A#define A(j)                                                \5C\0A    (j) % 2 ?                                               \5C\0A    (uint32_t) (X[(j) / 2] >> 32) :                         \5C\0A    (uint32_t) (X[(j) / 2])\0A#define STORE32                                             \5C\0A    if (i % 2) {                                            \5C\0A        X[i/2] &= 0x00000000FFFFFFFF;                       \5C\0A        X[i/2] |= (uint64_t) (cur) << 32;                   \5C\0A    } else {                                                \5C\0A        X[i/2] &= 0xFFFFFFFF00000000;                       \5C\0A        X[i/2] |= (uint32_t) cur;                           \5C\0A    }\0A\0A#define STORE0                                              \5C\0A    if (i % 2) {          