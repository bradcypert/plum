ess` takes ONE command-line string\0A// and the child pulls its arguments back out, so every argument has to\0A// be quoted here in a way the child's own parser will undo. Getting\0A// this wrong is not cosmetic: a Windows path routinely contains a\0A// space (`C:\5CUsers\5CSome Name\5C...`), and an unquoted one silently\0A// becomes two arguments.\0A//\0A// The rule below is the documented, `CommandLineToArgvW`-compatible\0A// one, and the backslash handling is the part that looks wrong and is\0A// not: a backslash is only an escape when it PRECEDES a quote, so runs\0A// of backslashes are doubled in that position and left alone\0A// everywhere else. `\5C` at the end of an argument is such a position,\0A// because the closing quote follows it.\0A//\0A// `_spawnvp` would have been shorter and is not used: the CRT joins\0A// `argv` with plain spaces and adds no quoting of its own, so it has\0A// this identical problem plus a layer of indirection over it.\0Astatic int plum_win_needs_quotes(const char *s) {\0A    if (*s == '\5C0') return 1; // an empty argument must survive as one\0A    for (const char *c = s; *c != '\5C0'; c++) {\0A        if (*c == ' ' || *c == '\5Ct' || *c == '\22') return 1;\0A    }\0A    return 0;\0A}\0A\0A// Appends one quoted argument. Returns 0 on success, -1 if it would not\0A// fit -- never a truncated command line, which would run something\0A// other than what was asked for.\0Astatic int plum_win_append_arg(char *buf, size_t cap, size_t *len, const char *arg) {\0A    size_t n = *len;\0A    size_t backslashes;\0A    const char *c;\0A\0A#define PLUM_PUT(ch) do { if (n + 1 >= cap) return -1; buf[n++] = (ch); } while (0)\0A\0A    if (n > 0) PLUM_PUT(' ');\0A\0A    if (!plum_win_needs_quotes(arg)) {\0A        for (c = arg; *c != '\5C0'; c++) PLUM_PUT(*c);\0A        *len = n;\0A        return 0;\0A    }\0A\0A    PLUM_PUT('\22');\0A    for (c = arg; *c != '\5C0'; c++) {\0A        backslashes = 0;\0A        while (*c == '\5C\5C') { backslashes++; c