@.str41012 = private global { i64, i64, [20298 x i8] } { i64 -1, i64 20297, [20298 x i8] c"/**\0A * \5Cfile psa/crypto_types.h\0A *\0A * \5Cbrief PSA cryptography module: type aliases.\0A *\0A * \5Cnote This file may not be included directly. Applications must\0A * include psa/crypto.h. Drivers must include the appropriate driver\0A * header file.\0A *\0A * This file contains portable definitions of integral types for properties\0A * of cryptographic keys, designations of cryptographic algorithms, and\0A * error codes returned by the library.\0A *\0A * This header file does not declare any function.\0A */\0A/*\0A *  Copyright The Mbed TLS Contributors\0A *  SPDX-License-Identifier: Apache-2.0 OR GPL-2.0-or-later\0A */\0A\0A#ifndef PSA_CRYPTO_TYPES_H\0A#define PSA_CRYPTO_TYPES_H\0A\0A/*\0A * Include the build-time configuration information header. Here, we do not\0A * include `\22mbedtls/build_info.h\22` directly but `\22psa/build_info.h\22`, which\0A * is basically just an alias to it. This is to ease the maintenance of the\0A * TF-PSA-Crypto repository which has a different build system and\0A * configuration.\0A */\0A#include \22psa/build_info.h\22\0A\0A/* Define the MBEDTLS_PRIVATE macro. */\0A#include \22mbedtls/private_access.h\22\0A\0A#if defined(MBEDTLS_PSA_CRYPTO_PLATFORM_FILE)\0A#include MBEDTLS_PSA_CRYPTO_PLATFORM_FILE\0A#else\0A#include \22crypto_platform.h\22\0A#endif\0A\0A#include <stdint.h>\0A\0A/** \5Cdefgroup error Error codes\0A * @{\0A */\0A\0A/**\0A * \5Cbrief Function return status.\0A *\0A * This is either #PSA_SUCCESS (which is zero), indicating success,\0A * or a small negative value indicating that an error occurred. Errors are\0A * encoded as one of the \5Cc PSA_ERROR_xxx values defined here. */\0A/* If #PSA_SUCCESS is already defined, it means that #psa_status_t\0A * is also defined in an external header, so prevent its multiple\0A * definition.\0A */\0A#ifndef PSA_SUCCESS\0Atypedef int32_t psa_status_t;\0A#endif\0A\0A/**@}*/\0A\0A/** \5Cdefgroup crypto_types Key and algorithm types\0A * @{\0A */\0A\0A/** \5Cbrief Encoding of a key type.\0A *\0A * Values of this type are generally constructed by macros called\0A * `PSA_KEY_TYPE_xxx`.\0A *\0A * \5Cnote Values of this type are encoded in the persistent key store.\0A *       Any changes to existing values will require bumping the storage\0A *       format version and providing a translation when reading the old\0A *       format.\0A */\0Atypedef uint16_t psa_key_type_t;\0A\0A/** The type of PSA elliptic curve family identifiers.\0A *\0A * Values of this type are generally constructed by macros called\0A * `PSA_ECC_FAMILY_xxx`.\0A *\0A * The curve identifier is required to create an ECC key using the\0A * PSA_KEY_TYPE_ECC_KEY_PAIR() or PSA_KEY_TYPE_ECC_PUBLIC_KEY()\0A * macros.\0A *\0A * Values defined by this standard will never be in the range 0x80-0xff.\0A * Vendors who define additional families must use an encoding in this range.\0A *\0A * \5Cnote Values of this type are encoded in the persistent key store.\0A *       Any changes to existing values will require bumping the storage\0A *       format version and providing a translation when reading the old\0A *       format.\0A */\0Atypedef uint8_t psa_ecc_family_t;\0A\0A/** The type of PSA Diffie-Hellman group family identifiers.\0A *\0A * Values of this type are generally constructed by macros called\0A * `PSA_DH_FAMILY_xxx`.\0A *\0A * The group identifier is required to create a Diffie-Hellman key using the\0A * PSA_KEY_TYPE_DH_KEY_PAIR() or PSA_KEY_TYPE_DH_PUBLIC_KEY()\0A * macros.\0A *\0A * Values defined by this standard will never be in the range 0x80-0xff.\0A * Vendors who define additional families must use an encoding in this range.\0A *\0A * \5Cnote Values of this type are encoded in the persistent key store.\0A *       Any changes to existing values will require bumping the storage\0A *       format version and providing a translation when reading the old\0A *       format.\0A */\0Atypedef uint8_t psa_dh_family_t;\0A\0A/** \5Cbrief Encoding of a cryptographic algorithm.\0A *\0A * Values of this type are generally constructed by macros called\0A * `PSA_ALG_xxx`.\0A *\0A * For algorithms that can be applied to multiple key types, this type\0A * does not encode the key type. For example, for symmetric ciphers\0A * based on a block cipher, #psa_algorithm_t encodes the block cipher\0A * mode and the padding mode while the block cipher itself is encoded\0A * via #psa_key_type_t.\0A *\0A * \5Cnote Values of this type are encoded in the persistent key store.\0A *       Any changes to existing values will require bumping the storage\0A *       format version and providing a translation when reading the old\0A *       format.\0A */\0Atypedef uint32_t psa_algorithm_t;\0A\0A/**@}*/\0A\0A/** \5Cdefgroup key_lifetimes Key lifetimes\0A * @{\0A */\0A\0A/** Encoding of key lifetimes.\0A *\0A * The lifetime of a key indicates where it is stored and what system actions\0A * may create and destroy it.\0A *\0A * Lifetime values have the following structure:\0A * - Bits 0-7 (#PSA_KEY_LIFETIME_GET_PERSISTENCE(\5Cc lifetime)):\0A *   persistence level. This value indicates what device management\0A *   actions can cause it to be destroyed. In particular, it indicates\0A *   whether the key is _volatile_ or _persistent_.\0A *   See ::psa_key_persistence_t for more information.\0A * - Bits 8-31 (#PSA_KEY_LIFETIME_GET_LOCATION(\5Cc lifetime)):\0A *   location indicator. This value indicates which part of the system\0A *   has access to the key material and can perform operations using the key.\0A *   See ::psa_key_location_t for more information.\0A *\0A * Volatile keys are automatically destroyed when the application instance\0A * terminates or on a power reset of the device. Persistent keys are\0A * preserved until the application explicitly destroys them or until an\0A * integration-specific device management event occurs (for example,\0A * a factory reset).\0A *\0A * Persistent keys have a key identifier of type #mbedtls_svc_key_id_t.\0A * This identifier remains valid throughout the lifetime of the key,\0A * even if the application instance that created the key terminates.\0A * The application can call psa_open_key() to open a persistent key that\0A * it created previously.\0A *\0A * The default lifetime of a key is #PSA_KEY_LIFETIME_VOLATILE. The lifetime\0A * #PSA_KEY_LIFETIME_PERSISTENT is supported if persistent storage is\0A * available. Other lifetime values may be supported depending on the\0A * library configuration.\0A *\0A * Values of this type are generally constructed by macros called\0A * `PSA_KEY_LIFETIME_xxx`.\0A *\0A * \5Cnote Values of this type are encoded in the persistent key store.\0A *       Any changes to existing values will require bumping the storage\0A *       format version and providing a translation when reading the old\0A *       format.\0A */\0Atypedef uint32_t psa_key_lifetime_t;\0A\0A/** Encoding of key persistence levels.\0A *\0A * What distinguishes different persistence levels is what device management\0A * events may cause keys to be destroyed. _Volatile_ keys are destroyed\0A * by a power reset. Persistent keys may be destroyed by events such as\0A * a transfer of ownership or a factory reset. What management events\0A * actually affect persistent keys at different levels is outside the\0A * scope of the PSA Cryptography specification.\0A *\0A * The PSA Cryptography specification defines the following values of\0A * persistence levels:\0A * - \5Cc 0 = #PSA_KEY_PERSISTENCE_VOLATILE: volatile key.\0A *   A volatile key is automatically destroyed by the implementation when\0A *   the application instance terminates. In particular, a volatile key\0A *   is automatically destroyed on a power reset of the device.\0A * - \5Cc 1 = #PSA_KEY_PERSISTENCE_DEFAULT:\0A *   persistent key with a default lifetime.\0A * - \5Cc 2-254: currently not supported by Mbed TLS.\0A * - \5Cc 255 = #PSA_KEY_PERSISTENCE_READ_ONLY:\0A *   read-only or write-once key.\0A *   A key with this persistence level cannot be destroyed.\0A *   Mbed TLS does not currently offer a way to create such keys, but\0A *   integrations of Mbed TLS can use it for built-in keys that the\0A *   application cannot modify (for example, a hardware unique key (HUK)).\0A *\0A * \5Cnote Key persistence levels are 8-bit values. Key management\0A *       interfaces operate on lifetimes (type ::psa_key_lifetime_t) which\0A *       encode the persistence as the lower 8 bits of a 32-bit value.\0A *\0A * \5Cnote Values of this type are encoded in the persistent key store.\0A *       Any changes to existing values will require bumping the storage\0A *       format version and providing a translation when reading the old\0A *       format.\0A */\0Atypedef uint8_t psa_key_persistence_t;\0A\0A/** Encoding of key location indicators.\0A *\0A * If an integration of Mbed TLS can make calls to external\0A * cryptoprocessors such as secure elements, the location of a key\0A * indicates which secure element performs the operations on the key.\0A * Depending on the design of the secure element, the key\0A * material may be stored either in the secure element, or\0A * in wrapped (encrypted) form alongside the key metadata in the\0A * primary local storage.\0A *\0A * The PSA Cryptography API specification defines the following values of\0A * location indicators:\0A * - \5Cc 0: primary local storage.\0A *   This location is always available.\0A *   The primary local storage is typically the same storage area that\0A *   contains the key metadata.\0A * - \5Cc 1: primary secure element.\0A *   Integrations of Mbed TLS should support this value if there is a secure\0A *   element attached to the operating environment.\0A *   As a guideline, secure elements may provide higher resistance against\0A *   side channel and physical attacks than the primary local storage, but may\0A *   have restrictions on supported key types, sizes, policies and operations\0A *   and may have different performance characteristics.\0A * - \5Cc 2-0x7fffff: other locations defined by a PSA specification.\0A *   The PSA Cryptography API does not currently assign any meaning to these\0A *   locations, but future versions of that specification or other PSA\0A *   specifications may do so.\0A * - \5Cc 0x800000-0xffffff: vendor-defined locations.\0A *   No PSA specification will assign a meaning to locations in this range.\0A *\0A * \5Cnote Key location indicators are 24-bit values. Key management\0A *       interfaces operate on lifetimes (type ::psa_key_lifetime_t) which\0A *       encode the location as the upper 24 bits of a 32-bit value.\0A *\0A * \5Cnote Values of this type are encoded in the persistent key store.\0A *       Any changes to existing values will require bumping the storage\0A *       format version and providing a translation when reading the old\0A *       format.\0A */\0Atypedef uint32_t psa_key_location_t;\0A\0A/** Encoding of identifiers of persistent keys.\0A *\0A * - Applications may freely choose key identifiers in the range\0A *   #PSA_KEY_ID_USER_MIN to #PSA_KEY_ID_USER_MAX.\0A * - The implementation may define additional key identifiers in the range\0A *   #PSA_KEY_ID_VENDOR_MIN to #PSA_KEY_ID_VENDOR_MAX.\0A * - 0 is reserved as an invalid key identifier.\0A * - Key identifiers outside these ranges are reserved for future use.\0A *\0A * \5Cnote Values of this type are encoded in the persistent key store.\0A *       Any changes to how values are allocated must require careful\0A *       consideration to allow backward compatibility.\0A */\0Atypedef uint32_t psa_key_id_t;\0A\0A/** Encoding of key identifiers as seen inside the PSA Crypto implementation.\0A *\0A * When PSA Crypto is built as a library inside an application, this type\0A * is identical to #psa_key_id_t. When PSA Crypto is built as a service\0A * that can store keys on behalf of multiple clients, this type\0A * encodes the #psa_key_id_t value seen by each client application as\0A * well as extra information that identifies the client that owns\0A * the key.\0A *\0A * \5Cnote Values of this type are encoded in the persistent key store.\0A *       Any changes to existing values will require bumping the storage\0A *       format version and providing a translation when reading the old\0A *       format.\0A */\0A#if !defined(MBEDTLS_PSA_CRYPTO_KEY_ID_ENCODES_OWNER)\0Atypedef psa_key_id_t mbedtls_svc_key_id_t;\0A\0A#else /* MBEDTLS_PSA_CRYPTO_KEY_ID_ENCODES_OWNER */\0A/* Implementation-specific: The Mbed TLS library can be built as\0A * part of a multi-client service that exposes the PSA Cryptography API in each\0A * client and encodes the client identity in the key identifier argument of\0A * functions such as psa_open_key().\0A */\0Atypedef struct {\0A    psa_key_id_t MBEDTLS_PRIVATE(key_id);\0A    mbedtls_key_owner_id_t MBEDTLS_PRIVATE(owner);\0A} mbedtls_svc_key_id_t;\0A\0A#endif /* !MBEDTLS_PSA_CRYPTO_KEY_ID_ENCODES_OWNER */\0A\0A/**@}*/\0A\0A/** \5Cdefgroup policy Key policies\0A * @{\0A */\0A\0A/** \5Cbrief Encoding of permitted usage on a key.\0A *\0A * Values of this type are generally constructed as bitwise-ors of macros\0A * called `PSA_KEY_USAGE_xxx`.\0A *\0A * \5Cnote Values of this type are encoded in the persistent key store.\0A *       Any changes to existing values will require bumping the storage\0A *       format version and providing a translation when reading the old\0A *       format.\0A */\0Atypedef uint32_t psa_key_usage_t;\0A\0A/**@}*/\0A\0A/** \5Cdefgroup attributes Key attributes\0A * @{\0A */\0A\0A/** The type of a structure containing key attributes.\0A *\0A * This is an opaque structure that can represent the metadata of a key\0A * object. Metadata that can be stored in attributes includes:\0A * - The location of the key in storage, indicated by its key identifier\0A *   and its lifetime.\0A * - The key's policy, comprising usage flags and a specification of\0A *   the permitted algorithm(s).\0A * - Information about the key itself: the key type and its size.\0A * - Additional implementation-defined attributes.\0A *\0A * The actual key material is not considered an attribute of a key.\0A * Key attributes do not contain information that is generally considered\0A * highly confidential.\0A *\0A * An attribute structure works like a simple data structure where each function\0A * `psa_set_key_xxx` sets a field and the corresponding function\0A * `psa_get_key_xxx` retrieves the value of the corresponding field.\0A * However, a future version of the library  may report values that are\0A * equivalent to the original one, but have a different encoding. Invalid\0A * values may be mapped to different, also invalid values.\0A *\0A * An attribute structure may contain references to auxiliary resources,\0A * for example pointers to allocated memory or indirect references to\0A * pre-calculated values. In order to free such resources, the application\0A * must call psa_reset_key_attributes(). As an exception, calling\0A * psa_reset_key_attributes() on an attribute structure is optional if\0A * the structure has only been modified by the following functions\0A * since it was initialized or last reset with psa_reset_key_attributes():\0A * - psa_set_key_id()\0A * - psa_set_key_lifetime()\0A * - psa_set_key_type()\0A * - psa_set_key_bits()\0A * - psa_set_key_usage_flags()\0A * - psa_set_key_algorithm()\0A *\0A * Before calling any function on a key attribute structure, the application\0A * must initialize it by any of the following means:\0A * - Set the structure to all-bits-zero, for example:\0A *   \5Ccode\0A *   psa_key_attributes_t attributes;\0A *   memset(&attributes, 0, sizeof(attributes));\0A *   \5Cendcode\0A * - Initialize the structure to logical zero values, for example:\0A *   \5Ccode\0A *   psa_key_attributes_t attributes = {0};\0A *   \5Cendcode\0A * - Initialize the structure to the initializer #PSA_KEY_ATTRIBUTES_INIT,\0A *   for example:\0A *   \5Ccode\0A *   psa_key_attributes_t attributes = PSA_KEY_ATTRIBUTES_INIT;\0A *   \5Cendcode\0A * - Assign the result of the function psa_key_attributes_init()\0A *   to the structure, for example:\0A *   \5Ccode\0A *   psa_key_attributes_t attributes;\0A *   attributes = psa_key_attributes_init();\0A *   \5Cendcode\0A *\0A * A freshly initialized attribute structure contains the following\0A * values:\0A *\0A * - lifetime: #PSA_KEY_LIFETIME_VOLATILE.\0A * - key identifier: 0 (which is not a valid key identifier).\0A * - type: \5Cc 0 (meaning that the type is unspecified).\0A * - key size: \5Cc 0 (meaning that the size is unspecified).\0A * - usage flags: \5Cc 0 (which allows no usage except exporting a public key).\0A * - algorithm: \5Cc 0 (which allows no cryptographic usage, but allows\0A *   exporting).\0A *\0A * A typical sequence to create a key is as follows:\0A * -# Create and initialize an attribute structure.\0A * -# If the key is persistent, call psa_set_key_id().\0A *    Also call psa_set_key_lifetime() to place the key in a non-default\0A *    location.\0A * -# Set the key policy with psa_set_key_usage_flags() and\0A *    psa_set_key_algorithm().\0A * -# Set the key type with psa_set_key_type().\0A *    Skip this step if copying an existing key with psa_copy_key().\0A * -# When generating a random key with psa_generate_key() or deriving a key\0A *    with psa_key_derivation_output_key(), set the desired key size with\0A *    psa_set_key_bits().\0A * -# Call a key creation function: psa_import_key(), psa_generate_key(),\0A *    psa_key_derivation_output_key() or psa_copy_key(). This function reads\0A *    the attribute structure, creates a key with these attributes, and\0A *    outputs a key identifier to the newly created key.\0A * -# The attribute structure is now no longer necessary.\0A *    You may call psa_reset_key_attributes(), although this is optional\0A *    with the workflow presented here because the attributes currently\0A *    defined in this specification do not require any additional resources\0A *    beyond the structure itself.\0A *\0A * A typical sequence to query a key's attributes is as follows:\0A * -# Call psa_get_key_attributes().\0A * -# Call `psa_get_key_xxx` functions to retrieve the attribute(s) that\0A *    you are interested in.\0A * -# Call psa_reset_key_attributes() to free any resources that may be\0A *    used by the attribute structure.\0A *\0A * Once a key has been created, it is impossible to change its attributes.\0A */\0Atypedef struct psa_key_attributes_s psa_key_attributes_t;\0A\0A\0A#ifndef __DOXYGEN_ONLY__\0A#if defined(MBEDTLS_PSA_CRYPTO_SE_C)\0A/* Mbed TLS defines this type in crypto_types.h because it is also\0A * visible to applications through an implementation-specific extension.\0A * For the PSA Cryptography specification, this type is only visible\0A * via crypto_se_driver.h. */\0Atypedef uint64_t psa_key_slot_number_t;\0A#endif /* MBEDTLS_PSA_CRYPTO_SE_C */\0A#endif /* !__DOXYGEN_ONLY__ */\0A\0A/**@}*/\0A\0A/** \5Cdefgroup derivation Key derivation\0A * @{\0A */\0A\0A/** \5Cbrief Encoding of the step of a key derivation.\0A *\0A * Values of this type are generally constructed by macros called\0A * `PSA_KEY_DERIVATION_INPUT_xxx`.\0A */\0Atypedef uint16_t psa_key_derivation_step_t;\0A\0A/** \5Cbrief Custom parameters for key generation or key derivation.\0A *\0A * This is a structure type with at least the following field:\0A *\0A * - \5Cc flags: an unsigned integer type. 0 for the default production parameters.\0A *\0A * Functions that take such a structure as input also take an associated\0A * input buffer \5Cc custom_data of length \5Cc custom_data_length.\0A *\0A * The interpretation of this structure and the associated \5Cc custom_data\0A * parameter depend on the type of the created key.\0A *\0A * - #PSA_KEY_TYPE_RSA_KEY_PAIR:\0A *     - \5Cc flags: must be 0.\0A *     - \5Cc custom_data: the public exponent, in little-endian order.\0A *       This must be an odd integer and must not be 1.\0A *       Implementations must support 65537, should support 3 and may\0A *       support other values.\0A *       When not using a driver, Mbed TLS supports values up to \5Cc INT_MAX.\0A *       If this is empty, the default value 65537 is used.\0A * - Other key types: reserved for future use. \5Cc flags must be 0.\0A */\0Atypedef struct psa_custom_key_parameters_s psa_custom_key_parameters_t;\0A\0A/** \5Cbrief Custom parameters for key generation or key derivation.\0A *\0A * This is a structure type with at least the following fields:\0A *\0A * - \5Cc flags: an unsigned integer type. 0 for the default production parameters.\0A * - \5Cc data: a flexible array of bytes.\0A *\0A * The interpretation of this structure depend on the type of the\0A * created key.\0A *\0A * - #PSA_KEY_TYPE_RSA_KEY_PAIR:\0A *     - \5Cc flags: must be 0.\0A *     - \5Cc data: the public exponent, in little-endian order.\0A *       This must be an odd integer and must not be 1.\0A *       Implementations must support 65537, should support 3 and may\0A *       support other values.\0A *       When not using a driver, Mbed TLS supports values up to \5Cc INT_MAX.\0A *       If this is empty or if the custom production parameters are omitted\0A *       altogether, the default value 65537 is used.\0A * - Other key types: reserved for future use. \5Cc flags must be 0.\0A *\0A */\0Atypedef struct psa_key_production_parameters_s psa_key_production_parameters_t;\0A\0A/**@}*/\0A\0A#endif /* PSA_CRYPTO_TYPES_H */\0A\00" }
@.const41014 = private global <{ i64, ptr, ptr, i1, [7 x i8] }> <{ i64 -1, ptr @.str41010, ptr @.str41012, i1 0, [7 x i8] zeroinitializer }>
