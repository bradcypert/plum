@.str40006 = private global { i64, i64, [9618 x i8] } { i64 -1, i64 9617, [9618 x i8] c"/**\0A * \5Cfile pkcs7.h\0A *\0A * \5Cbrief PKCS #7 generic defines and structures\0A *  https://tools.ietf.org/html/rfc2315\0A */\0A/*\0A *  Copyright The Mbed TLS Contributors\0A *  SPDX-License-Identifier: Apache-2.0 OR GPL-2.0-or-later\0A */\0A\0A/**\0A * Note: For the time being, this implementation of the PKCS #7 cryptographic\0A * message syntax is a partial implementation of RFC 2315.\0A * Differences include:\0A *  - The RFC specifies 6 different content types. The only type currently\0A *    supported in Mbed TLS is the signed-data content type.\0A *  - The only supported PKCS #7 Signed Data syntax version is version 1\0A *  - The RFC specifies support for BER. This implementation is limited to\0A *    DER only.\0A *  - The RFC specifies that multiple digest algorithms can be specified\0A *    in the Signed Data type. Only one digest algorithm is supported in Mbed TLS.\0A *  - The RFC specifies the Signed Data type can contain multiple X.509 or PKCS #6 extended\0A *    certificates. In Mbed TLS, this list can only contain 0 or 1 certificates\0A *    and they must be in X.509 format.\0A *  - The RFC specifies the Signed Data type can contain\0A *    certificate-revocation lists (CRLs). This implementation has no support\0A *    for CRLs so it is assumed to be an empty list.\0A *  - The RFC allows for SignerInfo structure to optionally contain\0A *    unauthenticatedAttributes and authenticatedAttributes. In Mbed TLS it is\0A *    assumed these fields are empty.\0A *  - The RFC allows for the signed Data type to contain contentInfo. This\0A *    implementation assumes the type is DATA and the content is empty.\0A */\0A\0A#ifndef MBEDTLS_PKCS7_H\0A#define MBEDTLS_PKCS7_H\0A\0A#include \22mbedtls/private_access.h\22\0A\0A#include \22mbedtls/build_info.h\22\0A\0A#include \22mbedtls/asn1.h\22\0A#include \22mbedtls/x509_crt.h\22\0A\0A/**\0A * \5Cname PKCS #7 Module Error codes\0A * \5C{\0A */\0A#define MBEDTLS_ERR_PKCS7_INVALID_FORMAT                   -0x5300  /**< The format is invalid, e.g. different type expected. */\0A#define MBEDTLS_ERR_PKCS7_FEATURE_UNAVAILABLE              -0x5380  /**< Unavailable feature, e.g. anything other than signed data. */\0A#define MBEDTLS_ERR_PKCS7_INVALID_VERSION                  -0x5400  /**< The PKCS #7 version element is invalid or cannot be parsed. */\0A#define MBEDTLS_ERR_PKCS7_INVALID_CONTENT_INFO             -0x5480  /**< The PKCS #7 content info is invalid or cannot be parsed. */\0A#define MBEDTLS_ERR_PKCS7_INVALID_ALG                      -0x5500  /**< The algorithm tag or value is invalid or cannot be parsed. */\0A#define MBEDTLS_ERR_PKCS7_INVALID_CERT                     -0x5580  /**< The certificate tag or value is invalid or cannot be parsed. */\0A#define MBEDTLS_ERR_PKCS7_INVALID_SIGNATURE                -0x5600  /**< Error parsing the signature */\0A#define MBEDTLS_ERR_PKCS7_INVALID_SIGNER_INFO              -0x5680  /**< Error parsing the signer's info */\0A#define MBEDTLS_ERR_PKCS7_BAD_INPUT_DATA                   -0x5700  /**< Input invalid. */\0A#define MBEDTLS_ERR_PKCS7_ALLOC_FAILED                     -0x5780  /**< Allocation of memory failed. */\0A#define MBEDTLS_ERR_PKCS7_VERIFY_FAIL                      -0x5800  /**< Verification Failed */\0A#define MBEDTLS_ERR_PKCS7_CERT_DATE_INVALID                -0x5880  /**< The PKCS #7 date issued/expired dates are invalid */\0A/* \5C} name */\0A\0A/**\0A * \5Cname PKCS #7 Supported Version\0A * \5C{\0A */\0A#define MBEDTLS_PKCS7_SUPPORTED_VERSION                           0x01\0A/* \5C} name */\0A\0A#ifdef __cplusplus\0Aextern \22C\22 {\0A#endif\0A\0A/**\0A * Type-length-value structure that allows for ASN.1 using DER.\0A */\0Atypedef mbedtls_asn1_buf mbedtls_pkcs7_buf;\0A\0A/**\0A * Container for ASN.1 named information objects.\0A * It allows for Relative Distinguished Names (e.g. cn=localhost,ou=code,etc.).\0A */\0Atypedef mbedtls_asn1_named_data mbedtls_pkcs7_name;\0A\0A/**\0A * Container for a sequence of ASN.1 items\0A */\0Atypedef mbedtls_asn1_sequence mbedtls_pkcs7_sequence;\0A\0A/**\0A * PKCS #7 types\0A */\0Atypedef enum {\0A    MBEDTLS_PKCS7_NONE=0,\0A    MBEDTLS_PKCS7_DATA,\0A    MBEDTLS_PKCS7_SIGNED_DATA,\0A    MBEDTLS_PKCS7_ENVELOPED_DATA,\0A    MBEDTLS_PKCS7_SIGNED_AND_ENVELOPED_DATA,\0A    MBEDTLS_PKCS7_DIGESTED_DATA,\0A    MBEDTLS_PKCS7_ENCRYPTED_DATA,\0A}\0Ambedtls_pkcs7_type;\0A\0A/**\0A * Structure holding PKCS #7 signer info\0A */\0Atypedef struct mbedtls_pkcs7_signer_info {\0A    int MBEDTLS_PRIVATE(version);\0A    mbedtls_x509_buf MBEDTLS_PRIVATE(serial);\0A    mbedtls_x509_name MBEDTLS_PRIVATE(issuer);\0A    mbedtls_x509_buf MBEDTLS_PRIVATE(issuer_raw);\0A    mbedtls_x509_buf MBEDTLS_PRIVATE(alg_identifier);\0A    mbedtls_x509_buf MBEDTLS_PRIVATE(sig_alg_identifier);\0A    mbedtls_x509_buf MBEDTLS_PRIVATE(sig);\0A    struct mbedtls_pkcs7_signer_info *MBEDTLS_PRIVATE(next);\0A}\0Ambedtls_pkcs7_signer_info;\0A\0A/**\0A * Structure holding the signed data section\0A */\0Atypedef struct mbedtls_pkcs7_signed_data {\0A    int MBEDTLS_PRIVATE(version);\0A    mbedtls_pkcs7_buf MBEDTLS_PRIVATE(digest_alg_identifiers);\0A    int MBEDTLS_PRIVATE(no_of_certs);\0A    mbedtls_x509_crt MBEDTLS_PRIVATE(certs);\0A    int MBEDTLS_PRIVATE(no_of_crls);\0A    mbedtls_x509_crl MBEDTLS_PRIVATE(crl);\0A    int MBEDTLS_PRIVATE(no_of_signers);\0A    mbedtls_pkcs7_signer_info MBEDTLS_PRIVATE(signers);\0A}\0Ambedtls_pkcs7_signed_data;\0A\0A/**\0A * Structure holding PKCS #7 structure, only signed data for now\0A */\0Atypedef struct mbedtls_pkcs7 {\0A    mbedtls_pkcs7_buf MBEDTLS_PRIVATE(raw);\0A    mbedtls_pkcs7_signed_data MBEDTLS_PRIVATE(signed_data);\0A}\0Ambedtls_pkcs7;\0A\0A/**\0A * \5Cbrief          Initialize mbedtls_pkcs7 structure.\0A *\0A * \5Cparam pkcs7    mbedtls_pkcs7 structure.\0A */\0Avoid mbedtls_pkcs7_init(mbedtls_pkcs7 *pkcs7);\0A\0A/**\0A * \5Cbrief          Parse a single DER formatted PKCS #7 detached signature.\0A *\0A * \5Cparam pkcs7    The mbedtls_pkcs7 structure to be filled by the parser.\0A * \5Cparam buf      The buffer holding only the DER encoded PKCS #7 content.\0A * \5Cparam buflen   The size in bytes of \5Cp buf. The size must be exactly the\0A *                 length of the DER encoded PKCS #7 content.\0A *\0A * \5Cnote           This function makes an internal copy of the PKCS #7 buffer\0A *                 \5Cp buf. In particular, \5Cp buf may be destroyed or reused\0A *                 after this call returns.\0A * \5Cnote           Signatures with internal data are not supported.\0A *\0A * \5Creturn         The \5Cc mbedtls_pkcs7_type of \5Cp buf, if successful.\0A * \5Creturn         A negative error code on failure.\0A */\0Aint mbedtls_pkcs7_parse_der(mbedtls_pkcs7 *pkcs7, const unsigned char *buf,\0A                            const size_t buflen);\0A\0A/**\0A * \5Cbrief          Verification of PKCS #7 signature against a caller-supplied\0A *                 certificate.\0A *\0A *                 For each signer in the PKCS structure, this function computes\0A *                 a signature over the supplied data, using the supplied\0A *                 certificate and the same digest algorithm as specified by the\0A *                 signer. It then compares this signature against the\0A *                 signer's signature; verification succeeds if any comparison\0A *                 matches.\0A *\0A *                 This function does not use the certificates held within the\0A *                 PKCS #7 structure itself, and does not check that the\0A *                 certificate is signed by a trusted certification authority.\0A *\0A * \5Cparam pkcs7    mbedtls_pkcs7 structure containing signature.\0A * \5Cparam cert     Certificate containing key to verify signature.\0A * \5Cparam data     Plain data on which signature has to be verified.\0A * \5Cparam datalen  Length of the data.\0A *\0A * \5Cnote           This function internally calculates the hash on the supplied\0A *                 plain data for signature verification.\0A *\0A * \5Creturn         0 if the signature verifies, or a negative error code on failure.\0A */\0Aint mbedtls_pkcs7_signed_data_verify(mbedtls_pkcs7 *pkcs7,\0A                                     const mbedtls_x509_crt *cert,\0A                                     const unsigned char *data,\0A                                     size_t datalen);\0A\0A/**\0A * \5Cbrief          Verification of PKCS #7 signature against a caller-supplied\0A *                 certificate.\0A *\0A *                 For each signer in the PKCS structure, this function\0A *                 validates a signature over the supplied hash, using the\0A *                 supplied certificate and the same digest algorithm as\0A *                 specified by the signer. Verification succeeds if any\0A *                 signature is good.\0A *\0A *                 This function does not use the certificates held within the\0A *                 PKCS #7 structure itself, and does not check that the\0A *                 certificate is signed by a trusted certification authority.\0A *\0A * \5Cparam pkcs7    PKCS #7 structure containing signature.\0A * \5Cparam cert     Certificate containing key to verify signature.\0A * \5Cparam hash     Hash of the plain data on which signature has to be verified.\0A * \5Cparam hashlen  Length of the hash.\0A *\0A * \5Cnote           This function is different from mbedtls_pkcs7_signed_data_verify()\0A *                 in that it is directly passed the hash of the data.\0A *\0A * \5Creturn         0 if the signature verifies, or a negative error code on failure.\0A */\0Aint mbedtls_pkcs7_signed_hash_verify(mbedtls_pkcs7 *pkcs7,\0A                                     const mbedtls_x509_crt *cert,\0A                                     const unsigned char *hash, size_t hashlen);\0A\0A/**\0A * \5Cbrief          Unallocate all PKCS #7 data and zeroize the memory.\0A *                 It doesn't free \5Cp pkcs7 itself. This should be done by the caller.\0A *\0A * \5Cparam pkcs7    mbedtls_pkcs7 structure to free.\0A */\0Avoid mbedtls_pkcs7_free(mbedtls_pkcs7 *pkcs7);\0A\0A#ifdef __cplusplus\0A}\0A#endif\0A\0A#endif /* pkcs7.h */\0A\00" }
