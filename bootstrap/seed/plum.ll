rting at 3. https://oeis.org/A001223 */\0Astatic const unsigned char small_prime_gaps[] = {\0A    2, 2, 4, 2, 4, 2, 4, 6,\0A    2, 6, 4, 2, 4, 6, 6, 2,\0A    6, 4, 2, 6, 4, 6, 8, 4,\0A    2, 4, 2, 4, 14, 4, 6, 2,\0A    10, 2, 6, 6, 4, 6, 6, 2,\0A    10, 2, 4, 2, 12, 12, 4, 2,\0A    4, 6, 2, 10, 6, 6, 6, 2,\0A    6, 4, 2, 10, 14, 4, 2, 4,\0A    14, 6, 10, 2, 4, 6, 8, 6,\0A    6, 4, 6, 8, 4, 8, 10, 2,\0A    10, 2, 6, 4, 6, 8, 4, 2,\0A    4, 12, 8, 4, 8, 4, 6, 12,\0A    2, 18, 6, 10, 6, 6, 2, 6,\0A    10, 6, 6, 2, 6, 6, 4, 2,\0A    12, 10, 2, 4, 6, 6, 2, 12,\0A    4, 6, 8, 10, 8, 10, 8, 6,\0A    6, 4, 8, 6, 4, 8, 4, 14,\0A    10, 12, 2, 10, 2, 4, 2, 10,\0A    14, 4, 2, 4, 14, 4, 2, 4,\0A    20, 4, 8, 10, 8, 4, 6, 6,\0A    14, 4, 6, 6, 8, 6, /*reaches 997*/\0A    0 /* the last entry is effectively unused */\0A};\0A\0A/*\0A * Small divisors test (X must be positive)\0A *\0A * Return values:\0A * 0: no small factor (possible prime, more tests needed)\0A * 1: certain prime\0A * MBEDTLS_ERR_MPI_NOT_ACCEPTABLE: certain non-prime\0A * other negative: error\0A */\0Astatic int mpi_check_small_factors(const mbedtls_mpi *X)\0A{\0A    int ret = 0;\0A    size_t i;\0A    mbedtls_mpi_uint r;\0A    unsigned p = 3; /* The first odd prime */\0A\0A    if ((X->p[0] & 1) == 0) {\0A        return MBEDTLS_ERR_MPI_NOT_ACCEPTABLE;\0A    }\0A\0A    for (i = 0; i < sizeof(small_prime_gaps); p += small_prime_gaps[i], i++) {\0A        MBEDTLS_MPI_CHK(mbedtls_mpi_mod_int(&r, X, p));\0A        if (r == 0) {\0A            if (mbedtls_mpi_cmp_int(X, p) == 0) {\0A                return 1;\0A            } else {\0A                return MBEDTLS_ERR_MPI_NOT_ACCEPTABLE;\0A            }\0A        }\0A    }\0A\0Acleanup:\0A    return ret;\0A}\0A\0A/*\0A * Miller-Rabin pseudo-primality test  (HAC 4.24)\0A */\0Astatic int mpi_miller_rabin(const mbedtls_mpi *X, size_t rounds,\0A                            int (*f_rng)(void *, unsigned char *, size_t),\0A                            void *p_rng)\0A{\0A    int ret, count;\0A    size_t i, j, k, s;\0A    mbedtls_mpi W, R, T, A, RR;\0A\0A    mbedtls_mpi_init(&W); mbedtls_mpi_init(&R);\0A    mbedtls_mpi_init(&T); mbedtls_mpi_init(&A);\0A    mbedtls_mpi_init(&RR);\0A\0A    /*\0A     * W = |X| - 1\0A     * R = W >> lsb( W )\0A     */\0A    MBEDTLS_MPI_CHK(mbedtls_mpi_sub_int(&W, X, 1));\0A    s = mbedtls_mpi_lsb(&W);\0A    MBEDTLS_MPI_CHK(mbedtls_mpi_copy(&R, &W));\0A    MBEDTLS_MPI_CHK(mbedtls_mpi_shift_r(&R, s));\0A\0A    for (i = 0; i < rounds; i++) {\0A        /*\0A         * pick a random A, 1 < A < |X| - 1\0A         */\0A        count = 0;\0A        do {\0A            MBEDTLS_MPI_CHK(mbedtls_mpi_fill_random(&A, X->n * ciL, f_rng, p_rng));\0A\0A            j = mbedtls_mpi_bitlen(&A);\0A            k = mbedtls_mpi_bitlen(&W);\0A            if (j > k) {\0A                A.p[A.n - 1] &= ((mbedtls_mpi_uint) 1 << (k - (A.n - 1) * biL - 1)) - 1;\0A            }\0A\0A            if (count++ > 30) {\0A                ret = MBEDTLS_ERR_MPI_NOT_ACCEPTABLE;\0A                goto cleanup;\0A            }\0A\0A        } while (mbedtls_mpi_cmp_mpi(&A, &W) >= 0 ||\0A                 mbedtls_mpi_cmp_int(&A, 1)  <= 0);\0A\0A        /*\0A         * A = A^R mod |X|\0A         */\0A        MBEDTLS_MPI_CHK(mbedtls_mpi_exp_mod(&A, &A, &R, X, &RR));\0A\0A        if (mbedtls_mpi_cmp_mpi(&A, &W) == 0 ||\0A            mbedtls_mpi_cmp_int(&A,  1) == 0) {\0A            continue;\0A        }\0A\0A        j = 1;\0A        while (j < s && mbedtls_mpi_cmp_mpi(&A, &W) != 0) {\0A            /*\0A             * A = A * A mod |X|\0A             */\0A            MBEDTLS_MPI_CHK(mbedtls_mpi_mul_mpi(&T, &A, &A));\0A            MBEDTLS_MPI_CHK(mbedtls_mpi_mod_mpi(&A, &T, X));\0A\0A            if (mbedtls_mpi_cmp_int(&A, 1) == 0) {\0A                break;\0A            }\0A\0A            j++;\0A        }\0A\0A        /*\0A         * not prime if A != |X| - 1 or A == 1\0A         */\0A        if (mbedtls_mpi_cmp_mpi(&A, &W) != 0 ||\0A            mbedtls_mpi_cmp_