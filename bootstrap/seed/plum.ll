@.str39539 = private global { i64, i64, [6630 x i8] } { i64 -1, i64 6629, [6630 x i8] c"/**\0A * \5Cfile block_cipher.c\0A *\0A * \5Cbrief Lightweight abstraction layer for block ciphers with 128 bit blocks,\0A * for use by the GCM and CCM modules.\0A */\0A/*\0A *  Copyright The Mbed TLS Contributors\0A *  SPDX-License-Identifier: Apache-2.0 OR GPL-2.0-or-later\0A */\0A\0A#include \22common.h\22\0A\0A#if defined(MBEDTLS_BLOCK_CIPHER_SOME_PSA)\0A#include \22psa/crypto.h\22\0A#include \22psa_crypto_core.h\22\0A#include \22psa_util_internal.h\22\0A#endif\0A\0A#include \22block_cipher_internal.h\22\0A\0A#if defined(MBEDTLS_BLOCK_CIPHER_C)\0A\0A#if defined(MBEDTLS_BLOCK_CIPHER_SOME_PSA)\0Astatic psa_key_type_t psa_key_type_from_block_cipher_id(mbedtls_block_cipher_id_t cipher_id)\0A{\0A    switch (cipher_id) {\0A#if defined(MBEDTLS_BLOCK_CIPHER_AES_VIA_PSA)\0A        case MBEDTLS_BLOCK_CIPHER_ID_AES:\0A            return PSA_KEY_TYPE_AES;\0A#endif\0A#if defined(MBEDTLS_BLOCK_CIPHER_ARIA_VIA_PSA)\0A        case MBEDTLS_BLOCK_CIPHER_ID_ARIA:\0A            return PSA_KEY_TYPE_ARIA;\0A#endif\0A#if defined(MBEDTLS_BLOCK_CIPHER_CAMELLIA_VIA_PSA)\0A        case MBEDTLS_BLOCK_CIPHER_ID_CAMELLIA:\0A            return PSA_KEY_TYPE_CAMELLIA;\0A#endif\0A        default:\0A            return PSA_KEY_TYPE_NONE;\0A    }\0A}\0A\0Astatic int mbedtls_cipher_error_from_psa(psa_status_t status)\0A{\0A    return PSA_TO_MBEDTLS_ERR_LIST(status, psa_to_cipher_errors,\0A                                   psa_generic_status_to_mbedtls);\0A}\0A#endif /* MBEDTLS_BLOCK_CIPHER_SOME_PSA */\0A\0Avoid mbedtls_block_cipher_free(mbedtls_block_cipher_context_t *ctx)\0A{\0A    if (ctx == NULL) {\0A        return;\0A    }\0A\0A#if defined(MBEDTLS_BLOCK_CIPHER_SOME_PSA)\0A    if (ctx->engine == MBEDTLS_BLOCK_CIPHER_ENGINE_PSA) {\0A        psa_destroy_key(ctx->psa_key_id);\0A        return;\0A    }\0A#endif\0A    switch (ctx->id) {\0A#if defined(MBEDTLS_AES_C)\0A        case MBEDTLS_BLOCK_CIPHER_ID_AES:\0A            mbedtls_aes_free(&ctx->ctx.aes);\0A            break;\0A#endif\0A#if defined(MBEDTLS_ARIA_C)\0A        case MBEDTLS_BLOCK_CIPHER_ID_ARIA:\0A            mbedtls_aria_free(&ctx->ctx.aria);\0A            break;\0A#endif\0A#if defined(MBEDTLS_CAMELLIA_C)\0A        case MBEDTLS_BLOCK_CIPHER_ID_CAMELLIA:\0A            mbedtls_camellia_free(&ctx->ctx.camellia);\0A            break;\0A#endif\0A        default:\0A            break;\0A    }\0A    ctx->id = MBEDTLS_BLOCK_CIPHER_ID_NONE;\0A}\0A\0Aint mbedtls_block_cipher_setup(mbedtls_block_cipher_context_t *ctx,\0A                               mbedtls_cipher_id_t cipher_id)\0A{\0A    ctx->id = (cipher_id == MBEDTLS_CIPHER_ID_AES) ? MBEDTLS_BLOCK_CIPHER_ID_AES :\0A              (cipher_id == MBEDTLS_CIPHER_ID_ARIA) ? MBEDTLS_BLOCK_CIPHER_ID_ARIA :\0A              (cipher_id == MBEDTLS_CIPHER_ID_CAMELLIA) ? MBEDTLS_BLOCK_CIPHER_ID_CAMELLIA :\0A              MBEDTLS_BLOCK_CIPHER_ID_NONE;\0A\0A#if defined(MBEDTLS_BLOCK_CIPHER_SOME_PSA)\0A    psa_key_type_t psa_key_type = psa_key_type_from_block_cipher_id(ctx->id);\0A    if (psa_key_type != PSA_KEY_TYPE_NONE &&\0A        psa_can_do_cipher(psa_key_type, PSA_ALG_ECB_NO_PADDING)) {\0A        ctx->engine = MBEDTLS_BLOCK_CIPHER_ENGINE_PSA;\0A        return 0;\0A    }\0A    ctx->engine = MBEDTLS_BLOCK_CIPHER_ENGINE_LEGACY;\0A#endif\0A\0A    switch (ctx->id) {\0A#if defined(MBEDTLS_AES_C)\0A        case MBEDTLS_BLOCK_CIPHER_ID_AES:\0A            mbedtls_aes_init(&ctx->ctx.aes);\0A            return 0;\0A#endif\0A#if defined(MBEDTLS_ARIA_C)\0A        case MBEDTLS_BLOCK_CIPHER_ID_ARIA:\0A            mbedtls_aria_init(&ctx->ctx.aria);\0A            return 0;\0A#endif\0A#if defined(MBEDTLS_CAMELLIA_C)\0A        case MBEDTLS_BLOCK_CIPHER_ID_CAMELLIA:\0A            mbedtls_camellia_init(&ctx->ctx.camellia);\0A            return 0;\0A#endif\0A        default:\0A            ctx->id = MBEDTLS_BLOCK_CIPHER_ID_NONE;\0A            return MBEDTLS_ERR_CIPHER_BAD_INPUT_DATA;\0A    }\0A}\0A\0Aint mbedtls_block_cipher_setkey(mbedtls_block_cipher_context_t *ctx,\0A                                const unsigned char *key,\0A                                unsigned key_bitlen)\0A{\0A#if defined(MBEDTLS_BLOCK_CIPHER_SOME_PSA)\0A    if (ctx->engine == MBEDTLS_BLOCK_CIPHER_ENGINE_PSA) {\0A        psa_key_attributes_t key_attr = PSA_KEY_ATTRIBUTES_INIT;\0A        psa_status_t status;\0A\0A        psa_set_key_type(&key_attr, psa_key_type_from_block_cipher_id(ctx->id));\0A        psa_set_key_bits(&key_attr, key_bitlen);\0A        psa_set_key_algorithm(&key_attr, PSA_ALG_ECB_NO_PADDING);\0A        psa_set_key_usage_flags(&key_attr, PSA_KEY_USAGE_ENCRYPT);\0A\0A        status = psa_import_key(&key_attr, key, PSA_BITS_TO_BYTES(key_bitlen), &ctx->psa_key_id);\0A        if (status != PSA_SUCCESS) {\0A            return mbedtls_cipher_error_from_psa(status);\0A        }\0A        psa_reset_key_attributes(&key_attr);\0A\0A        return 0;\0A    }\0A#endif /* MBEDTLS_BLOCK_CIPHER_SOME_PSA */\0A\0A    switch (ctx->id) {\0A#if defined(MBEDTLS_AES_C)\0A        case MBEDTLS_BLOCK_CIPHER_ID_AES:\0A            return mbedtls_aes_setkey_enc(&ctx->ctx.aes, key, key_bitlen);\0A#endif\0A#if defined(MBEDTLS_ARIA_C)\0A        case MBEDTLS_BLOCK_CIPHER_ID_ARIA:\0A            return mbedtls_aria_setkey_enc(&ctx->ctx.aria, key, key_bitlen);\0A#endif\0A#if defined(MBEDTLS_CAMELLIA_C)\0A        case MBEDTLS_BLOCK_CIPHER_ID_CAMELLIA:\0A            return mbedtls_camellia_setkey_enc(&ctx->ctx.camellia, key, key_bitlen);\0A#endif\0A        default:\0A            return MBEDTLS_ERR_CIPHER_INVALID_CONTEXT;\0A    }\0A}\0A\0Aint mbedtls_block_cipher_encrypt(mbedtls_block_cipher_context_t *ctx,\0A                                 const unsigned char input[16],\0A                                 unsigned char output[16])\0A{\0A#if defined(MBEDTLS_BLOCK_CIPHER_SOME_PSA)\0A    if (ctx->engine == MBEDTLS_BLOCK_CIPHER_ENGINE_PSA) {\0A        psa_status_t status;\0A        size_t olen;\0A\0A        status = psa_cipher_encrypt(ctx->psa_key_id, PSA_ALG_ECB_NO_PADDING,\0A                                    input, 16, output, 16, &olen);\0A        if (status != PSA_SUCCESS) {\0A            return mbedtls_cipher_error_from_psa(status);\0A        }\0A        return 0;\0A    }\0A#endif /* MBEDTLS_BLOCK_CIPHER_SOME_PSA */\0A\0A    switch (ctx->id) {\0A#if defined(MBEDTLS_AES_C)\0A        case MBEDTLS_BLOCK_CIPHER_ID_AES:\0A            return mbedtls_aes_crypt_ecb(&ctx->ctx.aes, MBEDTLS_AES_ENCRYPT,\0A                                         input, output);\0A#endif\0A#if defined(MBEDTLS_ARIA_C)\0A        case MBEDTLS_BLOCK_CIPHER_ID_ARIA:\0A            return mbedtls_aria_crypt_ecb(&ctx->ctx.aria, input, output);\0A#endif\0A#if defined(MBEDTLS_CAMELLIA_C)\0A        case MBEDTLS_BLOCK_CIPHER_ID_CAMELLIA:\0A            return mbedtls_camellia_crypt_ecb(&ctx->ctx.camellia,\0A                                              MBEDTLS_CAMELLIA_ENCRYPT,\0A                                              input, output);\0A#endif\0A        default:\0A            return MBEDTLS_ERR_CIPHER_INVALID_CONTEXT;\0A    }\0A}\0A\0A#endif /* MBEDTLS_BLOCK_CIPHER_C */\0A\00" }
