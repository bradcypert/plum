o a file, creating it or REPLACING what was there.\0A///\0A/// The `Bytes` counterpart to `Os.write_file`: use this for anything\0A/// that is not text, and for text you have already encoded.\0Apub let write_bytes (path: String) (data: Bytes): Result[Unit, String] =\0A    if write_file_bytes_raw(path, data) { Ok(()) } else { Err(\22could not write \22.concat(path)) }\0A\0A/// Creates the file when it does not exist, the way `>>` does.\0Apub let append_bytes (path: String) (data: Bytes): Result[Unit, String] =\0A    if append_file_bytes_raw(path, data) { Ok(()) } else { Err(\22could not append to \22.concat(path)) }\0A\0A// --- Streaming file I/O ---\0A//\0A// The whole-file calls above are the convenience: one call, no\0A// handle, no cleanup to think about. These are for the cases a\0A// whole-file read cannot serve -- a file too big to hold, a stream\0A// consumed as it arrives, an append-only log kept open.\0A//\0A// `File` is a `handle` (issue #9), so an open file CLOSES ITSELF\0A// when the value dies. `File.close` is still offered, and still\0A// returns a `Result`, because closing can fail -- a buffered write\0A// is flushed by `fclose`, and that is exactly when a full disk is\0A// discovered. So: call `close` when the error matters, and rely on\0A// the handle when it does not. Neither leaks.\0A//\0A// Closing twice is fine and is the NORMAL path, since the handle\0A// runs after an explicit close. `native_stdlib/file_shim.c` owns a\0A// slot table precisely so the second one is harmless.\0Aextern \22C\22 {\0A    fn file_open(path: CStr, mode: Int) -> Int;\0A    fn file_close(h: Int);\0A    fn file_close_checked(h: Int) -> Int;\0A    fn file_read_n(h: Int, max_len: Int) -> Int;\0A    fn file_read_data() -> CStr;\0A    fn file_write(h: Int, buf: CStr, len: Int) -> Int;\0A    fn file_seek(h: Int, offset: Int, whence: Int) -> Int;\0A    fn file_flush(h: Int) -> Int;\0A}\0A\0A/// An open file. **Closed when this value dies**, including on a\0A/// panic, so a file opened in a scope needs no cleanup.\0A///\0A/// `File.close` is still offered and still returns a `Result`, because\0A/// closing can fail: a buffered write is flushed by the close, and that\0A/// is exactly when a full disk is discovered. Call it when that error\0A/// matters; rely on the handle when it does not. Closing twice is\0A/// harmless.\0Apub handle File { on_drop: file_close }\0A\0A/// How to open. A closed set, passed as small integers across the\0A/// extern boundary; an extern taking a mode STRING would let a\0A/// caller hand `fopen` anything at all.\0Apub enum Mode { Read, Write, Append }\0A\0A/// Where a seek measures from.\0Apub enum Seek { Start, Current, End }\0A\0Alet mode_code (m: Mode): Int = match m { Read => 0, Write => 1, Append => 2 }\0Alet seek_code (s: Seek): Int = match s { Start => 0, Current => 1, End => 2 }\0A\0A/// `Write` truncates an existing file; `Append` does not. Both create\0A/// one that is not there, and `Read` does not.\0Apub let open (path: String) (mode: Mode): Result[File, String] = unsafe {\0A    let h = file_open(path.as_cstr(), mode_code(mode));\0A    if h < 0 { Err(\22Os.open: could not open \22.concat(path)) } else { Ok(File.from_raw(h)) }\0A}\0A\0A/// Up to `max_len` bytes. An empty result is END OF FILE, not a\0A/// failure: the same three-way split `Net.read_bytes` makes, and\0A/// for the same reason: a reader looping until the end needs to tell\0A/// \22nothing left\22 from \22something broke\22.\0A/// `max_len` must be positive; zero or negative sizes return `Err`\0A/// without consuming input, even at end of file.\0Apub let File.read (f: File) (max_len: Int): Result[Bytes, String] = unsafe {\0A    let n = file_read_n(File.raw(f), max_len);\0A    if n < 0 { Err(\22File.read: read failed\22) }\0A    else { Ok(Bytes.from_cstr(file_read_data(), n)) }\0A}\0A\0A/// `len` MUST be bound BEFORE `.as_cstr()` runs, the same ordering\0A/// `Net.write` spells out: the pointer is an interior one into the\0A/// cell, and