0A#define SSL_SERIALIZED_SESSION_CONFIG_RECORD_SIZE 1\0A#else\0A#define SSL_SERIALIZED_SESSION_CONFIG_RECORD_SIZE 0\0A#endif /* MBEDTLS_SSL_RECORD_SIZE_LIMIT */\0A\0A#if defined(MBEDTLS_SSL_ALPN) && defined(MBEDTLS_SSL_SRV_C) && \5C\0A    defined(MBEDTLS_SSL_EARLY_DATA)\0A#define SSL_SERIALIZED_SESSION_CONFIG_ALPN 1\0A#else\0A#define SSL_SERIALIZED_SESSION_CONFIG_ALPN 0\0A#endif /* MBEDTLS_SSL_ALPN */\0A\0A#define SSL_SERIALIZED_SESSION_CONFIG_TIME_BIT          0\0A#define SSL_SERIALIZED_SESSION_CONFIG_CRT_BIT           1\0A#define SSL_SERIALIZED_SESSION_CONFIG_CLIENT_TICKET_BIT 2\0A#define SSL_SERIALIZED_SESSION_CONFIG_MFL_BIT           3\0A#define SSL_SERIALIZED_SESSION_CONFIG_ETM_BIT           4\0A#define SSL_SERIALIZED_SESSION_CONFIG_TICKET_BIT        5\0A#define SSL_SERIALIZED_SESSION_CONFIG_KEEP_PEER_CRT_BIT 6\0A#define SSL_SERIALIZED_SESSION_CONFIG_SNI_BIT           7\0A#define SSL_SERIALIZED_SESSION_CONFIG_EARLY_DATA_BIT    8\0A#define SSL_SERIALIZED_SESSION_CONFIG_RECORD_SIZE_BIT   9\0A#define SSL_SERIALIZED_SESSION_CONFIG_ALPN_BIT          10\0A\0A#define SSL_SERIALIZED_SESSION_CONFIG_BITFLAG                           \5C\0A    ((uint16_t) (                                                      \5C\0A         (SSL_SERIALIZED_SESSION_CONFIG_TIME << SSL_SERIALIZED_SESSION_CONFIG_TIME_BIT) | \5C\0A         (SSL_SERIALIZED_SESSION_CONFIG_CRT << SSL_SERIALIZED_SESSION_CONFIG_CRT_BIT) | \5C\0A         (SSL_SERIALIZED_SESSION_CONFIG_CLIENT_TICKET << \5C\0A             SSL_SERIALIZED_SESSION_CONFIG_CLIENT_TICKET_BIT) | \5C\0A         (SSL_SERIALIZED_SESSION_CONFIG_MFL << SSL_SERIALIZED_SESSION_CONFIG_MFL_BIT) | \5C\0A         (SSL_SERIALIZED_SESSION_CONFIG_ETM << SSL_SERIALIZED_SESSION_CONFIG_ETM_BIT) | \5C\0A         (SSL_SERIALIZED_SESSION_CONFIG_TICKET << SSL_SERIALIZED_SESSION_CONFIG_TICKET_BIT) | \5C\0A         (SSL_SERIALIZED_SESSION_CONFIG_KEEP_PEER_CRT << \5C\0A             SSL_SERIALIZED_SESSION_CONFIG_KEEP_PEER_CRT_BIT) | \5C\0A         (SSL_SERIALIZED_SESSION_CONFIG_SNI << SSL_SERIALIZED_SESSION_CONFIG_SNI_BIT) | \5C\0A         (SSL_SERIALIZED_SESSION_CONFIG_EARLY_DATA << \5C\0A             SSL_SERIALIZED_SESSION_CONFIG_EARLY_DATA_BIT) | \5C\0A         (SSL_SERIALIZED_SESSION_CONFIG_RECORD_SIZE << \5C\0A             SSL_SERIALIZED_SESSION_CONFIG_RECORD_SIZE_BIT) | \5C\0A         (SSL_SERIALIZED_SESSION_CONFIG_ALPN << \5C\0A             SSL_SERIALIZED_SESSION_CONFIG_ALPN_BIT)))\0A\0Astatic const unsigned char ssl_serialized_session_header[] = {\0A    MBEDTLS_VERSION_MAJOR,\0A    MBEDTLS_VERSION_MINOR,\0A    MBEDTLS_VERSION_PATCH,\0A    MBEDTLS_BYTE_1(SSL_SERIALIZED_SESSION_CONFIG_BITFLAG),\0A    MBEDTLS_BYTE_0(SSL_SERIALIZED_SESSION_CONFIG_BITFLAG),\0A};\0A\0A/*\0A * Serialize a session in the following format:\0A * (in the presentation language of TLS, RFC 8446 section 3)\0A *\0A * TLS 1.2 session:\0A *\0A * struct {\0A * #if defined(MBEDTLS_SSL_SESSION_TICKETS)\0A *    opaque ticket<0..2^24-1>;       // length 0 means no ticket\0A *    uint32 ticket_lifetime;\0A * #endif\0A * } ClientOnlyData;\0A *\0A * struct {\0A * #if defined(MBEDTLS_HAVE_TIME)\0A *    uint64 start_time;\0A * #endif\0A *     uint8 session_id_len;           // at most 32\0A *     opaque session_id[32];\0A *     opaque master[48];              // fixed length in the standard\0A *     uint32 verify_result;\0A * #if defined(MBEDTLS_SSL_KEEP_PEER_CERTIFICATE\0A *    opaque peer_cert<0..2^24-1>;    // length 0 means no peer cert\0A * #else\0A *    uint8 peer_cert_digest_type;\0A *    opaque peer_cert_digest<0..2^8-1>\0A * #endif\0A *     select (endpoint) {\0A *         case client: ClientOnlyData;\0A *         case server: uint64 ticket_creation_time;\0A *     };\0A * #if defined(MBEDTLS_SSL_MAX_FRAGMENT_LENGTH)\0A *    uint8 mfl_code;                 // up to 255 according to standard\0A * #endif\0A * #if defined(MBEDTLS_SSL_ENCRYPT_THEN_MAC)\0A *    uint8 encrypt_then_mac;         // 0 or 1\0A * #endif\0A * } serialized_session_tls12;\0A *\0A *\0A * TLS 1.3 Session:\0A *\0A * struct {\0A * #if defined(MBEDTLS_SSL_SERVER_NAME_INDICATION)\0A *    opaque hostname<0..2^16-1>;\0A * #endif\0A * #if defined(MBEDTLS_HAVE_TIME)\0A *    uint64 ticket_reception_time;\0A * #endif\0A *    uint32 ticket_lifetime;\0A *    opaque ticket<1..2^16-1>;\0A * } ClientOnlyData;\0A *\0A * struct {\0A *    uint32 ticket_age_add;\0A *    uint8 ticket_flags;\0A *    opaque resumption_key<0..255>;\0A * #if defined(MBEDTLS_SSL_EARLY_DATA)\0A *    uint32 max_early_data_size;\0A * #endif\0A * #if defined(MBEDTLS_SSL_RECORD_SIZE_LIMIT)\0A *    uint16 record_size_limit;\0A * #endif\0A *    select ( endpoint ) {\0A *         case client: ClientOnlyData;\0A *         case server:\0A * #if defined(MBEDTLS_HAVE_TIME)\0A *                      uint64 ticket_creation_time;\0A * #endif\0A * #if defined(MBEDTLS_SSL_EARLY_DATA) && defined(MBEDTLS_SSL_ALPN)\0A *                      opaque ticket_alpn<0..256>;\0A * #endif\0A *     };\0A * } serialized_session_tls13;\0A *\0A *\0A * SSL session:\0A *\0A * struct {\0A *\0A *    opaque mbedtls_version[3];   // library version: major, minor, patch\0A *    opaque session_format[2];    // library-version specific 16-bit field\0A *                                 // determining the format of the remaining\0A *                                 // serialized data.\0A *\0A *          Note: When updating the format, remember to keep\0A *          these version+format bytes.\0A *\0A *                                 // In this version, `session_format` determines\0A *                                 // the setting of those compile-time\0A *                                 // configuration options which influence\0A *                                 // the structure of mbedtls_ssl_session.\0A *\0A *    uint8_t minor_ver;           // Protocol minor version. Possible values:\0A *                                 // - TLS 1.2 (0x0303)\0A *                                 // - TLS 1.3 (0x0304)\0A *    uint8_t endpoint;\0A *    uint16_t ciphersuite;\0A *\0A *    select (serialized_session.tls_version) {\0A *\0A *      case MBEDTLS_SSL_VERSION_TLS1_2:\0A *        serialized_session_tls12 data;\0A *      case MBEDTLS_SSL_VERSION_TLS1_3:\0A *        serialized_session_tls13 data;\0A *\0A *   };\0A *\0A * } serialized_session;\0A *\0A */\0A\0AMBEDTLS_CHECK_RETURN_CRITICAL\0Astatic int ssl_session_save(const mbedtls_ssl_session *session,\0A                            unsigned char omit_header,\0A                            unsigned char *buf,\0A                            size_t buf_len,\0A                            size_t *olen)\0A{\0A    unsigned char *p = buf;\0A    size_t used = 0;\0A    size_t remaining_len;\0A#if defined(MBEDTLS_SSL_PROTO_TLS1_3)\0A    size_t out_len;\0A    int ret = MBEDTLS_ERR_ERROR_CORRUPTION_DETECTED;\0A#endif\0A    if (session == NULL) {\0A        return MBEDTLS_ERR_SSL_INTERNAL_ERROR;\0A    }\0A\0A    if (!omit_header) {\0A        /*\0A         * Add Mbed TLS version identifier\0A         */\0A        used += sizeof(ssl_serialized_session_header);\0A\0A        if (used <= buf_len) {\0A            memcpy(p, ssl_serialized_session_header,\0A                   sizeof(ssl_serialized_session_header));\0A            p += sizeof(ssl_serialized_session_header);\0A        }\0A    }\0A\0A    /*\0A     * TLS version identifier, endpoint, ciphersuite\0A     */\0A    used += 1    /* TLS version */\0A            + 1  /* endpoint */\0A            + 2; /* ciphersuite */\0A    if (used <= buf_len) {\0A        *p++ = MBEDTLS_BYTE_0(session->tls_version);\0A        *p++ = session->endpoint;\0A        MBEDTLS_PUT_UINT16_BE(session->ciphersuite, p, 0);\0A        p += 2;\0A    }\0A\0A    /* Forward to version-specific serialization routine. */\0A    remaining_len = (buf_len >= used) ? buf_len - used : 0;\0A    switch (session->tls_version) {\0A#if defined(MBEDTLS_SSL_PROTO_TLS1_2)\0A        case MBEDTLS_SSL_VERSION_TLS1_2:\0A            used += ssl_tls12_session_save(session, p, remaining_len);\0A            break;\0A#endif /* MBEDTLS_SSL_PROTO_TLS1_2 */\0A\0A#if defined(MBEDTLS_SSL_PROTO_TLS1_3)\0A        case MBEDTLS_SSL_VERSION_TLS1_3:\0A            ret = ssl_tls13_session_save(session, p, remaining_len, &out_len);\0A            if (ret != 0 && ret != MBEDTLS_ERR_SSL_BUFFER_TOO_SMALL) {\0A                return ret;\0A            }\0A            used += out_len;\0A            break;\0A#endif /* MBEDTLS_SSL_PROTO_TLS1_3 */\0A\0A        default:\0A            return MBEDTLS_ERR_SSL_FEATURE_UNAVAILABLE;\0A    }\0A\0A    *olen = used;\0A    if (used > buf_len) {\0A        return MBEDTLS_ERR_SSL_BUFFER_TOO_SMALL;\0A    }\0A\0A    return 0;\0A}\0A\0A/*\0A * Public wrapper for ssl_session_save()\0A */\0Aint mbedtls_ssl_session_save(const mbedtls_ssl_session *session,\0A                             unsigned char *buf,\0A                             size_t buf_len,\0A                             size_t *olen)\0A{\0A    return ssl_session_save(session, 0, buf, buf_len, olen);\0A}\0A\0A/*\0A * Deserialize session, see mbedtls_ssl_session_save() for format.\0A *\0A * This internal version is wrapped by a public function that cleans up in\0A * case of error, and has an extra option omit_header.\0A */\0AMBEDTLS_CHECK_RETURN_CRITICAL\0Astatic int ssl_session_load(mbedtls_ssl_session *session,\0A                            unsigned char omit_header,\0A                            const unsigned char *buf,\0A                            size_t len)\0A{\0A    const unsigned char *p = buf;\0A    const unsigned char * const end = buf + len;\0A    size_t remaining_len;\0A\0A\0A    if (session == NULL) {\0A        return MBEDTLS_ERR_SSL_INTERNAL_ERROR;\0A    }\0A\0A    if (!omit_header) {\0A        /*\0A         * Check Mbed TLS version identifier\0A         */\0A\0A        if ((size_t) (end - p) < sizeof(ssl_serialized_session_header)) {\0A            return MBEDTLS_ERR_SSL_BAD_INPUT_DATA;\0A        }\0A\0A        if (memcmp(p, ssl_serialized_session_header,