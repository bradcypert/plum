@.str40488 = private global { i64, i64, [6748 x i8] } { i64 -1, i64 6747, [6748 x i8] c"/*\0A *  PSA crypto support for secure element drivers\0A */\0A/*\0A *  Copyright The Mbed TLS Contributors\0A *  SPDX-License-Identifier: Apache-2.0 OR GPL-2.0-or-later\0A */\0A\0A#ifndef PSA_CRYPTO_SE_H\0A#define PSA_CRYPTO_SE_H\0A\0A/*\0A * Include the build-time configuration information header. Here, we do not\0A * include `\22mbedtls/build_info.h\22` directly but `\22psa/build_info.h\22`, which\0A * is basically just an alias to it. This is to ease the maintenance of the\0A * TF-PSA-Crypto repository which has a different build system and\0A * configuration.\0A */\0A#include \22psa/build_info.h\22\0A\0A#include \22psa/crypto.h\22\0A#include \22psa/crypto_se_driver.h\22\0A\0A/** The maximum location value that this implementation supports\0A * for a secure element.\0A *\0A * This is not a characteristic that each PSA implementation has, but a\0A * limitation of the current implementation due to the constraints imposed\0A * by storage. See #PSA_CRYPTO_SE_DRIVER_ITS_UID_BASE.\0A *\0A * The minimum location value for a secure element is 1, like on any\0A * PSA implementation (0 means a transparent key).\0A */\0A#define PSA_MAX_SE_LOCATION 255\0A\0A/** The base of the range of ITS file identifiers for secure element\0A * driver persistent data.\0A *\0A * We use a slice of the implementation reserved range 0xffff0000..0xffffffff,\0A * specifically the range 0xfffffe00..0xfffffeff. The length of this range\0A * drives the value of #PSA_MAX_SE_LOCATION. The identifier 0xfffffe00 is\0A * actually not used since it corresponds to #PSA_KEY_LOCATION_LOCAL_STORAGE\0A * which doesn't have a driver.\0A */\0A#define PSA_CRYPTO_SE_DRIVER_ITS_UID_BASE ((psa_key_id_t) 0xfffffe00)\0A\0A/** The maximum number of registered secure element driver locations. */\0A#define PSA_MAX_SE_DRIVERS 4\0A\0A/** Unregister all secure element drivers.\0A *\0A * \5Cwarning Do not call this function while the library is in the initialized\0A *          state. This function is only intended to be called at the end\0A *          of mbedtls_psa_crypto_free().\0A */\0Avoid psa_unregister_all_se_drivers(void);\0A\0A/** Initialize all secure element drivers.\0A *\0A * Called from psa_crypto_init().\0A */\0Apsa_status_t psa_init_all_se_drivers(void);\0A\0A/** A structure that describes a registered secure element driver.\0A *\0A * A secure element driver table entry contains a pointer to the\0A * driver's method table as well as the driver context structure.\0A */\0Atypedef struct psa_se_drv_table_entry_s psa_se_drv_table_entry_t;\0A\0A/** Return the secure element driver information for a lifetime value.\0A *\0A * \5Cparam lifetime              The lifetime value to query.\0A * \5Cparam[out] p_methods        On output, if there is a driver,\0A *                              \5Cc *methods points to its method table.\0A *                              Otherwise \5Cc *methods is \5Cc NULL.\0A * \5Cparam[out] p_drv_context    On output, if there is a driver,\0A *                              \5Cc *drv_context points to its context\0A *                              structure.\0A *                              Otherwise \5Cc *drv_context is \5Cc NULL.\0A *\0A * \5Cretval 1\0A *         \5Cp lifetime corresponds to a registered driver.\0A * \5Cretval 0\0A *         \5Cp lifetime does not correspond to a registered driver.\0A */\0Aint psa_get_se_driver(psa_key_lifetime_t lifetime,\0A                      const psa_drv_se_t **p_methods,\0A                      psa_drv_se_context_t **p_drv_context);\0A\0A/** Return the secure element driver table entry for a lifetime value.\0A *\0A * \5Cparam lifetime      The lifetime value to query.\0A *\0A * \5Creturn The driver table entry for \5Cp lifetime, or\0A *         \5Cp NULL if \5Cp lifetime does not correspond to a registered driver.\0A */\0Apsa_se_drv_table_entry_t *psa_get_se_driver_entry(\0A    psa_key_lifetime_t lifetime);\0A\0A/** Return the method table for a secure element driver.\0A *\0A * \5Cparam[in] driver    The driver table entry to access, or \5Cc NULL.\0A *\0A * \5Creturn The driver's method table.\0A *         \5Cc NULL if \5Cp driver is \5Cc NULL.\0A */\0Aconst psa_drv_se_t *psa_get_se_driver_methods(\0A    const psa_se_drv_table_entry_t *driver);\0A\0A/** Return the context of a secure element driver.\0A *\0A * \5Cparam[in] driver    The driver table entry to access, or \5Cc NULL.\0A *\0A * \5Creturn A pointer to the driver context.\0A *         \5Cc NULL if \5Cp driver is \5Cc NULL.\0A */\0Apsa_drv_se_context_t *psa_get_se_driver_context(\0A    psa_se_drv_table_entry_t *driver);\0A\0A/** Find a free slot for a key that is to be created.\0A *\0A * This function calls the relevant method in the driver to find a suitable\0A * slot for a key with the given attributes.\0A *\0A * \5Cparam[in] attributes    Metadata about the key that is about to be created.\0A * \5Cparam[in] driver        The driver table entry to query.\0A * \5Cparam[out] slot_number  On success, a slot number that is free in this\0A *                          secure element.\0A */\0Apsa_status_t psa_find_se_slot_for_key(\0A    const psa_key_attributes_t *attributes,\0A    psa_key_creation_method_t method,\0A    psa_se_drv_table_entry_t *driver,\0A    psa_key_slot_number_t *slot_number);\0A\0A/** Destroy a key in a secure element.\0A *\0A * This function calls the relevant driver method to destroy a key\0A * and updates the driver's persistent data.\0A */\0Apsa_status_t psa_destroy_se_key(psa_se_drv_table_entry_t *driver,\0A                                psa_key_slot_number_t slot_number);\0A\0A/** Load the persistent data of a secure element driver.\0A *\0A * \5Cparam driver        The driver table entry containing the persistent\0A *                      data to load from storage.\0A *\0A * \5Creturn #PSA_SUCCESS\0A * \5Creturn #PSA_ERROR_NOT_SUPPORTED\0A * \5Creturn #PSA_ERROR_DOES_NOT_EXIST\0A * \5Creturn #PSA_ERROR_STORAGE_FAILURE\0A * \5Creturn #PSA_ERROR_DATA_CORRUPT\0A * \5Creturn #PSA_ERROR_INVALID_ARGUMENT\0A */\0Apsa_status_t psa_load_se_persistent_data(\0A    const psa_se_drv_table_entry_t *driver);\0A\0A/** Save the persistent data of a secure element driver.\0A *\0A * \5Cparam[in] driver    The driver table entry containing the persistent\0A *                      data to save to storage.\0A *\0A * \5Creturn #PSA_SUCCESS\0A * \5Creturn #PSA_ERROR_NOT_SUPPORTED\0A * \5Creturn #PSA_ERROR_NOT_PERMITTED\0A * \5Creturn #PSA_ERROR_NOT_SUPPORTED\0A * \5Creturn #PSA_ERROR_INSUFFICIENT_STORAGE\0A * \5Creturn #PSA_ERROR_STORAGE_FAILURE\0A * \5Creturn #PSA_ERROR_INVALID_ARGUMENT\0A */\0Apsa_status_t psa_save_se_persistent_data(\0A    const psa_se_drv_table_entry_t *driver);\0A\0A/** Destroy the persistent data of a secure element driver.\0A *\0A * This is currently only used for testing.\0A *\0A * \5Cparam[in] location  The location identifier for the driver whose\0A *                      persistent data is to be erased.\0A */\0Apsa_status_t psa_destroy_se_persistent_data(psa_key_location_t location);\0A\0A\0A/** The storage representation of a key whose data is in a secure element.\0A */\0Atypedef struct {\0A    uint8_t slot_number[sizeof(psa_key_slot_number_t)];\0A} psa_se_key_data_storage_t;\0A\0A#endif /* PSA_CRYPTO_SE_H */\0A\00" }
