@.str42782 = private global { i64, i64, [120700 x i8] } { i64 -1, i64 120699, [120700 x i8] c"/**\0A * \5Cfile ssl_misc.h\0A *\0A * \5Cbrief Internal functions shared by the SSL modules\0A */\0A/*\0A *  Copyright The Mbed TLS Contributors\0A *  SPDX-License-Identifier: Apache-2.0 OR GPL-2.0-or-later\0A */\0A#ifndef MBEDTLS_SSL_MISC_H\0A#define MBEDTLS_SSL_MISC_H\0A\0A#include \22mbedtls/build_info.h\22\0A#include \22common.h\22\0A\0A#include \22mbedtls/error.h\22\0A\0A#include \22mbedtls/ssl.h\22\0A#include \22mbedtls/cipher.h\22\0A\0A#if defined(MBEDTLS_USE_PSA_CRYPTO) || defined(MBEDTLS_SSL_PROTO_TLS1_3)\0A#include \22psa/crypto.h\22\0A#include \22psa_util_internal.h\22\0A#endif\0A\0A#if defined(MBEDTLS_MD_CAN_MD5)\0A#include \22mbedtls/md5.h\22\0A#endif\0A\0A#if defined(MBEDTLS_MD_CAN_SHA1)\0A#include \22mbedtls/sha1.h\22\0A#endif\0A\0A#if defined(MBEDTLS_MD_CAN_SHA256)\0A#include \22mbedtls/sha256.h\22\0A#endif\0A\0A#if defined(MBEDTLS_MD_CAN_SHA512)\0A#include \22mbedtls/sha512.h\22\0A#endif\0A\0A#if defined(MBEDTLS_KEY_EXCHANGE_ECJPAKE_ENABLED) && \5C\0A    !defined(MBEDTLS_USE_PSA_CRYPTO)\0A#include \22mbedtls/ecjpake.h\22\0A#endif\0A\0A#include \22mbedtls/pk.h\22\0A#include \22ssl_ciphersuites_internal.h\22\0A#include \22x509_internal.h\22\0A#include \22pk_internal.h\22\0A\0A\0A/* Shorthand for restartable ECC */\0A#if defined(MBEDTLS_ECP_RESTARTABLE) && \5C\0A    defined(MBEDTLS_SSL_CLI_C) && \5C\0A    defined(MBEDTLS_SSL_PROTO_TLS1_2) && \5C\0A    defined(MBEDTLS_KEY_EXCHANGE_ECDHE_ECDSA_ENABLED)\0A#define MBEDTLS_SSL_ECP_RESTARTABLE_ENABLED\0A#endif\0A\0A#define MBEDTLS_SSL_INITIAL_HANDSHAKE           0\0A#define MBEDTLS_SSL_RENEGOTIATION_IN_PROGRESS   1   /* In progress */\0A#define MBEDTLS_SSL_RENEGOTIATION_DONE          2   /* Done or aborted */\0A#define MBEDTLS_SSL_RENEGOTIATION_PENDING       3   /* Requested (server only) */\0A\0A/* Faked handshake message identity for HelloRetryRequest. */\0A#define MBEDTLS_SSL_TLS1_3_HS_HELLO_RETRY_REQUEST (-MBEDTLS_SSL_HS_SERVER_HELLO)\0A\0A/*\0A * Internal identity of handshake extensions\0A */\0A#define MBEDTLS_SSL_EXT_ID_UNRECOGNIZED                0\0A#define MBEDTLS_SSL_EXT_ID_SERVERNAME                  1\0A#define MBEDTLS_SSL_EXT_ID_SERVERNAME_HOSTNAME         1\0A#define MBEDTLS_SSL_EXT_ID_MAX_FRAGMENT_LENGTH         2\0A#define MBEDTLS_SSL_EXT_ID_STATUS_REQUEST              3\0A#define MBEDTLS_SSL_EXT_ID_SUPPORTED_GROUPS            4\0A#define MBEDTLS_SSL_EXT_ID_SUPPORTED_ELLIPTIC_CURVES   4\0A#define MBEDTLS_SSL_EXT_ID_SIG_ALG                     5\0A#define MBEDTLS_SSL_EXT_ID_USE_SRTP                    6\0A#define MBEDTLS_SSL_EXT_ID_HEARTBEAT                   7\0A#define MBEDTLS_SSL_EXT_ID_ALPN                        8\0A#define MBEDTLS_SSL_EXT_ID_SCT                         9\0A#define MBEDTLS_SSL_EXT_ID_CLI_CERT_TYPE              10\0A#define MBEDTLS_SSL_EXT_ID_SERV_CERT_TYPE             11\0A#define MBEDTLS_SSL_EXT_ID_PADDING                    12\0A#define MBEDTLS_SSL_EXT_ID_PRE_SHARED_KEY             13\0A#define MBEDTLS_SSL_EXT_ID_EARLY_DATA                 14\0A#define MBEDTLS_SSL_EXT_ID_SUPPORTED_VERSIONS         15\0A#define MBEDTLS_SSL_EXT_ID_COOKIE                     16\0A#define MBEDTLS_SSL_EXT_ID_PSK_KEY_EXCHANGE_MODES     17\0A#define MBEDTLS_SSL_EXT_ID_CERT_AUTH                  18\0A#define MBEDTLS_SSL_EXT_ID_OID_FILTERS                19\0A#define MBEDTLS_SSL_EXT_ID_POST_HANDSHAKE_AUTH        20\0A#define MBEDTLS_SSL_EXT_ID_SIG_ALG_CERT               21\0A#define MBEDTLS_SSL_EXT_ID_KEY_SHARE                  22\0A#define MBEDTLS_SSL_EXT_ID_TRUNCATED_HMAC             23\0A#define MBEDTLS_SSL_EXT_ID_SUPPORTED_POINT_FORMATS    24\0A#define MBEDTLS_SSL_EXT_ID_ENCRYPT_THEN_MAC           25\0A#define MBEDTLS_SSL_EXT_ID_EXTENDED_MASTER_SECRET     26\0A#define MBEDTLS_SSL_EXT_ID_SESSION_TICKET             27\0A#define MBEDTLS_SSL_EXT_ID_RECORD_SIZE_LIMIT          28\0A\0A/* Utility for translating IANA extension type. */\0Auint32_t mbedtls_ssl_get_extension_id(unsigned int extension_type);\0Auint32_t mbedtls_ssl_get_extension_mask(unsigned int extension_type);\0A/* Macros used to define mask constants */\0A#define MBEDTLS_SSL_EXT_MASK(id)       (1ULL << (MBEDTLS_SSL_EXT_ID_##id))\0A/* Reset value of extension mask */\0A#define MBEDTLS_SSL_EXT_MASK_NONE                                              0\0A\0A/* In messages containing extension requests, we should ignore unrecognized\0A * extensions. In messages containing extension responses, unrecognized\0A * extensions should result in handshake abortion. Messages containing\0A * extension requests include ClientHello, CertificateRequest and\0A * NewSessionTicket. Messages containing extension responses include\0A * ServerHello, HelloRetryRequest, EncryptedExtensions and Certificate.\0A *\0A * RFC 8446 section 4.1.3\0A *\0A * The ServerHello MUST only include extensions which are required to establish\0A * the cryptographic context and negotiate the protocol version.\0A *\0A * RFC 8446 section 4.2\0A *\0A * If an implementation receives an extension which it recognizes and which is\0A * not specified for the message in which it appears, it MUST abort the handshake\0A * with an \22illegal_parameter\22 alert.\0A */\0A\0A/* Extensions that are not recognized by TLS 1.3 */\0A#define MBEDTLS_SSL_TLS1_3_EXT_MASK_UNRECOGNIZED                               \5C\0A    (MBEDTLS_SSL_EXT_MASK(SUPPORTED_POINT_FORMATS)                | \5C\0A     MBEDTLS_SSL_EXT_MASK(ENCRYPT_THEN_MAC)                       | \5C\0A     MBEDTLS_SSL_EXT_MASK(EXTENDED_MASTER_SECRET)                 | \5C\0A     MBEDTLS_SSL_EXT_MASK(SESSION_TICKET)                         | \5C\0A     MBEDTLS_SSL_EXT_MASK(TRUNCATED_HMAC)                         | \5C\0A     MBEDTLS_SSL_EXT_MASK(UNRECOGNIZED))\0A\0A/* RFC 8446 section 4.2. Allowed extensions for ClientHello */\0A#define MBEDTLS_SSL_TLS1_3_ALLOWED_EXTS_OF_CH                                  \5C\0A    (MBEDTLS_SSL_EXT_MASK(SERVERNAME)                             | \5C\0A     MBEDTLS_SSL_EXT_MASK(MAX_FRAGMENT_LENGTH)                    | \5C\0A     MBEDTLS_SSL_EXT_MASK(STATUS_REQUEST)                         | \5C\0A     MBEDTLS_SSL_EXT_MASK(SUPPORTED_GROUPS)                       | \5C\0A     MBEDTLS_SSL_EXT_MASK(SIG_ALG)                                | \5C\0A     MBEDTLS_SSL_EXT_MASK(USE_SRTP)                               | \5C\0A     MBEDTLS_SSL_EXT_MASK(HEARTBEAT)                              | \5C\0A     MBEDTLS_SSL_EXT_MASK(ALPN)                                   | \5C\0A     MBEDTLS_SSL_EXT_MASK(SCT)                                    | \5C\0A     MBEDTLS_SSL_EXT_MASK(CLI_CERT_TYPE)                          | \5C\0A     MBEDTLS_SSL_EXT_MASK(SERV_CERT_TYPE)                         | \5C\0A     MBEDTLS_SSL_EXT_MASK(PADDING)                                | \5C\0A     MBEDTLS_SSL_EXT_MASK(KEY_SHARE)                              | \5C\0A     MBEDTLS_SSL_EXT_MASK(PRE_SHARED_KEY)                         | \5C\0A     MBEDTLS_SSL_EXT_MASK(PSK_KEY_EXCHANGE_MODES)                 | \5C\0A     MBEDTLS_SSL_EXT_MASK(EARLY_DATA)                             | \5C\0A     MBEDTLS_SSL_EXT_MASK(COOKIE)                                 | \5C\0A     MBEDTLS_SSL_EXT_MASK(SUPPORTED_VERSIONS)                     | \5C\0A     MBEDTLS_SSL_EXT_MASK(CERT_AUTH)                              | \5C\0A     MBEDTLS_SSL_EXT_MASK(POST_HANDSHAKE_AUTH)                    | \5C\0A     MBEDTLS_SSL_EXT_MASK(SIG_ALG_CERT)                           | \5C\0A     MBEDTLS_SSL_EXT_MASK(RECORD_SIZE_LIMIT)                      | \5C\0A     MBEDTLS_SSL_TLS1_3_EXT_MASK_UNRECOGNIZED)\0A\0A/* RFC 8446 section 4.2. Allowed extensions for EncryptedExtensions */\0A#define MBEDTLS_SSL_TLS1_3_ALLOWED_EXTS_OF_EE                                  \5C\0A    (MBEDTLS_SSL_EXT_MASK(SERVERNAME)                             | \5C\0A     MBEDTLS_SSL_EXT_MASK(MAX_FRAGMENT_LENGTH)                    | \5C\0A     MBEDTLS_SSL_EXT_MASK(SUPPORTED_GROUPS)                       | \5C\0A     MBEDTLS_SSL_EXT_MASK(USE_SRTP)                               | \5C\0A     MBEDTLS_SSL_EXT_MASK(HEARTBEAT)                              | \5C\0A     MBEDTLS_SSL_EXT_MASK(ALPN)                                   | \5C\0A     MBEDTLS_SSL_EXT_MASK(CLI_CERT_TYPE)                          | \5C\0A     MBEDTLS_SSL_EXT_MASK(SERV_CERT_TYPE)                         | \5C\0A     MBEDTLS_SSL_EXT_MASK(EARLY_DATA)                             | \5C\0A     MBEDTLS_SSL_EXT_MASK(RECORD_SIZE_LIMIT))\0A\0A/* RFC 8446 section 4.2. Allowed extensions for CertificateRequest */\0A#define MBEDTLS_SSL_TLS1_3_ALLOWED_EXTS_OF_CR                                  \5C\0A    (MBEDTLS_SSL_EXT_MASK(STATUS_REQUEST)                         | \5C\0A     MBEDTLS_SSL_EXT_MASK(SIG_ALG)                                | \5C\0A     MBEDTLS_SSL_EXT_MASK(SCT)                                    | \5C\0A     MBEDTLS_SSL_EXT_MASK(CERT_AUTH)                              | \5C\0A     MBEDTLS_SSL_EXT_MASK(OID_FILTERS)                            | \5C\0A     MBEDTLS_SSL_EXT_MASK(SIG_ALG_CERT)                           | \5C\0A     MBEDTLS_SSL_TLS1_3_EXT_MASK_UNRECOGNIZED)\0A\0A/* RFC 8446 section 4.2. Allowed extensions for Certificate */\0A#define MBEDTLS_SSL_TLS1_3_ALLOWED_EXTS_OF_CT                                  \5C\0A    (MBEDTLS_SSL_EXT_MASK(STATUS_REQUEST)                         | \5C\0A     MBEDTLS_SSL_EXT_MASK(SCT))\0A\0A/* RFC 8446 section 4.2. Allowed extensions for ServerHello */\0A#define MBEDTLS_SSL_TLS1_3_ALLOWED_EXTS_OF_SH                                  \5C\0A    (MBEDTLS_SSL_EXT_MASK(KEY_SHARE)                              | \5C\0A     MBEDTLS_SSL_EXT_MASK(PRE_SHARED_KEY)                         | \5C\0A     MBEDTLS_SSL_EXT_MASK(SUPPORTED_VERSIONS))\0A\0A/* RFC 8446 section 4.2. Allowed extensions for HelloRetryRequest */\0A#define MBEDTLS_SSL_TLS1_3_ALLOWED_EXTS_OF_HRR                                 \5C\0A    (MBEDTLS_SSL_EXT_MASK(KEY_SHARE)                              | \5C\0A     MBEDTLS_SSL_EXT_MASK(COOKIE)                                 | \5C\0A     MBEDTLS_SSL_EXT_MASK(SUPPORTED_VERSIONS))\0A\0A/* RFC 8446 section 4.2. Allowed extensions for NewSessionTicket */\0A#define MBEDTLS_SSL_TLS1_3_ALLOWED_EXTS_OF_NST                                 \5C\0A    (MBEDTLS_SSL_EXT_MASK(EARLY_DATA)                             | \5C\0A     MBEDTLS_SSL_TLS1_3_EXT_MASK_UNRECOGNIZED)\0A\0A/*\0A * Helper macros for function call with return check.\0A */\0A/*\0A * Exit when return non-zero value\0A */\0A#define MBEDTLS_SSL_PROC_CHK(f)                               \5C\0A    do {                                                        \5C\0A        ret = (f);                                            \5C\0A        if (ret != 0)                                          \5C\0A        {                                                       \5C\0A            goto cleanup;                                       \5C\0A        }                                                       \5C\0A    } while (0)\0A/*\0A * Exit when return negative value\0A */\0A#define MBEDTLS_SSL_PROC_CHK_NEG(f)                           \5C\0A    do {                                                        \5C\0A        ret = (f);                                            \5C\0A        if (ret < 0)                                           \5C\0A        {                                                       \5C\0A            goto cleanup;                                       \5C\0A        }                                                       \5C\0A    } while (0)\0A\0A/*\0A * DTLS retransmission states, see RFC 6347 4.2.4\0A *\0A * The SENDING state is merged in PREPARING for initial sends,\0A * but is distinct for resends.\0A *\0A * Note: initial state is wrong for server, but is not used anyway.\0A */\0A#define MBEDTLS_SSL_RETRANS_PREPARING       0\0A#define MBEDTLS_SSL_RETRANS_SENDING         1\0A#define MBEDTLS_SSL_RETRANS_WAITING         2\0A#define MBEDTLS_SSL_RETRANS_FINISHED        3\0A\0A/*\0A * Allow extra bytes for record, authentication and encryption overhead:\0A * counter (8) + header (5) + IV(16) + MAC (16-48) + padding (0-256).\0A */\0A\0A#if defined(MBEDTLS_SSL_PROTO_TLS1_2)\0A\0A/* This macro determines whether CBC is supported. */\0A#if defined(MBEDTLS_SSL_HAVE_CBC)      &&                                  \5C\0A    (defined(MBEDTLS_SSL_HAVE_AES)     ||                                  \5C\0A    defined(MBEDTLS_SSL_HAVE_CAMELLIA) ||                                  \5C\0A    defined(MBEDTLS_SSL_HAVE_ARIA))\0A#define MBEDTLS_SSL_SOME_SUITES_USE_CBC\0A#endif\0A\0A/* This macro determines whether a ciphersuite using a\0A * stream cipher can be used. */\0A#if defined(MBEDTLS_CIPHER_NULL_CIPHER)\0A#define MBEDTLS_SSL_SOME_SUITES_USE_STREAM\0A#endif\0A\0A/* This macro determines whether the CBC construct used in TLS 1.2 is supported. */\0A#if defined(MBEDTLS_SSL_SOME_SUITES_USE_CBC) && \5C\0A    defined(MBEDTLS_SSL_PROTO_TLS1_2)\0A#define MBEDTLS_SSL_SOME_SUITES_USE_TLS_CBC\0A#endif\0A\0A#if defined(MBEDTLS_SSL_SOME_SUITES_USE_STREAM) || \5C\0A    defined(MBEDTLS_SSL_SOME_SUITES_USE_CBC)\0A#define MBEDTLS_SSL_SOME_SUITES_USE_MAC\0A#endif\0A\0A/* This macro determines whether a ciphersuite uses Encrypt-then-MAC with CBC */\0A#if defined(MBEDTLS_SSL_SOME_SUITES_USE_CBC) && \5C\0A    defined(MBEDTLS_SSL_ENCRYPT_THEN_MAC)\0A#define MBEDTLS_SSL_SOME_SUITES_USE_CBC_ETM\0A#endif\0A\0A#endif /* MBEDTLS_SSL_PROTO_TLS1_2 */\0A\0A#if defined(MBEDTLS_SSL_SOME_SUITES_USE_MAC)\0A/* Ciphersuites using HMAC */\0A#if defined(MBEDTLS_MD_CAN_SHA384)\0A#define MBEDTLS_SSL_MAC_ADD                 48  /* SHA-384 used for HMAC */\0A#elif defined(MBEDTLS_MD_CAN_SHA256)\0A#define MBEDTLS_SSL_MAC_ADD                 32  /* SHA-256 used for HMAC */\0A#else\0A#define MBEDTLS_SSL_MAC_ADD                 20  /* SHA-1   used for HMAC */\0A#endif\0A#else /* MBEDTLS_SSL_SOME_SUITES_USE_MAC */\0A/* AEAD ciphersuites: GCM and CCM use a 128 bits tag */\0A#define MBEDTLS_SSL_MAC_ADD                 16\0A#endif\0A\0A#if defined(MBEDTLS_SSL_HAVE_CBC)\0A#define MBEDTLS_SSL_PADDING_ADD            256\0A#else\0A#define MBEDTLS_SSL_PADDING_ADD              0\0A#endif\0A\0A#if defined(MBEDTLS_SSL_DTLS_CONNECTION_ID)\0A#define MBEDTLS_SSL_MAX_CID_EXPANSION      MBEDTLS_SSL_CID_TLS1_3_PADDING_GRANULARITY\0A#else\0A#define MBEDTLS_SSL_MAX_CID_EXPANSION        0\0A#endif\0A\0A#define MBEDTLS_SSL_PAYLOAD_OVERHEAD (MBEDTLS_MAX_IV_LENGTH +          \5C\0A                                      MBEDTLS_SSL_MAC_ADD +            \5C\0A                                      MBEDTLS_SSL_PADDING_ADD +        \5C\0A                                      MBEDTLS_SSL_MAX_CID_EXPANSION    \5C\0A                                      )\0A\0A#define MBEDTLS_SSL_IN_PAYLOAD_LEN (MBEDTLS_SSL_PAYLOAD_OVERHEAD + \5C\0A                                    (MBEDTLS_SSL_IN_CONTENT_LEN))\0A\0A#define MBEDTLS_SSL_OUT_PAYLOAD_LEN (MBEDTLS_SSL_PAYLOAD_OVERHEAD + \5C\0A                                     (MBEDTLS_SSL_OUT_CONTENT_LEN))\0A\0A/* The maximum number of buffered handshake messages. */\0A#define MBEDTLS_SSL_MAX_BUFFERED_HS 4\0A\0A/* Maximum length we can advertise as our max content length for\0A   RFC 6066 max_fragment_length extension negotiation purposes\0A   (the lesser of both sizes, if they are unequal.)\0A */\0A#define MBEDTLS_TLS_EXT_ADV_CONTENT_LEN (                            \5C\0A        (MBEDTLS_SSL_IN_CONTENT_LEN > MBEDTLS_SSL_OUT_CONTENT_LEN)   \5C\0A        ? (MBEDTLS_SSL_OUT_CONTENT_LEN)                            \5C\0A        : (MBEDTLS_SSL_IN_CONTENT_LEN)                             \5C\0A        )\0A\0A/* Maximum size in bytes of list in signature algorithms ext., RFC 5246/8446 */\0A#define MBEDTLS_SSL_MAX_SIG_ALG_LIST_LEN       65534\0A\0A/* Minimum size in bytes of list in signature algorithms ext., RFC 5246/8446 */\0A#define MBEDTLS_SSL_MIN_SIG_ALG_LIST_LEN       2\0A\0A/* Maximum size in bytes of list in supported elliptic curve ext., RFC 4492 */\0A#define MBEDTLS_SSL_MAX_CURVE_LIST_LEN         65535\0A\0A#define MBEDTLS_RECEIVED_SIG_ALGS_SIZE         20\0A\0A#if defined(MBEDTLS_SSL_HANDSHAKE_WITH_CERT_ENABLED)\0A\0A#define MBEDTLS_TLS_SIG_NONE MBEDTLS_TLS1_3_SIG_NONE\0A\0A#if defined(MBEDTLS_SSL_PROTO_TLS1_2)\0A#define MBEDTLS_SSL_TLS12_SIG_AND_HASH_ALG(sig, hash) ((hash << 8) | sig)\0A#define MBEDTLS_SSL_TLS12_SIG_ALG_FROM_SIG_AND_HASH_ALG(alg) (alg & 0xFF)\0A#define MBEDTLS_SSL_TLS12_HASH_ALG_FROM_SIG_AND_HASH_ALG(alg) (alg >> 8)\0A#endif /* MBEDTLS_SSL_PROTO_TLS1_2 */\0A\0A#endif /* MBEDTLS_SSL_HANDSHAKE_WITH_CERT_ENABLED */\0A\0A/*\0A * Check that we obey the standard's message size bounds\0A */\0A\0A#if MBEDTLS_SSL_IN_CONTENT_LEN > 16384\0A#error \22Bad configuration - incoming record content too large.\22\0A#endif\0A\0A#if MBEDTLS_SSL_OUT_CONTENT_LEN > 16384\0A#error \22Bad configuration - outgoing record content too large.\22\0A#endif\0A\0A#if MBEDTLS_SSL_IN_PAYLOAD_LEN > MBEDTLS_SSL_IN_CONTENT_LEN + 2048\0A#error \22Bad configuration - incoming protected record payload too large.\22\0A#endif\0A\0A#if MBEDTLS_SSL_OUT_PAYLOAD_LEN > MBEDTLS_SSL_OUT_CONTENT_LEN + 2048\0A#error \22Bad configuration - outgoing protected record payload too large.\22\0A#endif\0A\0A/* Calculate buffer sizes */\0A\0A/* Note: Even though the TLS record header is only 5 bytes\0A   long, we're internally using 8 bytes to store the\0A   implicit sequence number. */\0A#define MBEDTLS_SSL_HEADER_LEN 13\0A\0A#if !defined(MBEDTLS_SSL_DTLS_CONNECTION_ID)\0A#define MBEDTLS_SSL_IN_BUFFER_LEN  \5C\0A    ((MBEDTLS_SSL_HEADER_LEN) + (MBEDTLS_SSL_IN_PAYLOAD_LEN))\0A#else\0A#define MBEDTLS_SSL_IN_BUFFER_LEN  \5C\0A    ((MBEDTLS_SSL_HEADER_LEN) + (MBEDTLS_SSL_IN_PAYLOAD_LEN) \5C\0A     + (MBEDTLS_SSL_CID_IN_LEN_MAX))\0A#endif\0A\0A#if !defined(MBEDTLS_SSL_DTLS_CONNECTION_ID)\0A#define MBEDTLS_SSL_OUT_BUFFER_LEN  \5C\0A    ((MBEDTLS_SSL_HEADER_LEN) + (MBEDTLS_SSL_OUT_PAYLOAD_LEN))\0A#else\0A#define MBEDTLS_SSL_OUT_BUFFER_LEN                               \5C\0A    ((MBEDTLS_SSL_HEADER_LEN) + (MBEDTLS_SSL_OUT_PAYLOAD_LEN)    \5C\0A     + (MBEDTLS_SSL_CID_OUT_LEN_MAX))\0A#endif\0A\0A#define MBEDTLS_CLIENT_HELLO_RANDOM_LEN 32\0A#define MBEDTLS_SERVER_HELLO_RANDOM_LEN 32\0A\0A#if defined(MBEDTLS_SSL_MAX_FRAGMENT_LENGTH)\0A/**\0A * \5Cbrief          Return the maximum fragment length (payload, in bytes) for\0A *                 the output buffer. For the client, this is the configured\0A *                 value. For the server, it is the minimum of two - the\0A *                 configured value and the negotiated one.\0A *\0A * \5Csa             mbedtls_ssl_conf_max_frag_len()\0A * \5Csa             mbedtls_ssl_get_max_out_record_payload()\0A *\0A * \5Cparam ssl      SSL context\0A *\0A * \5Creturn         Current maximum fragment length for the output buffer.\0A */\0Asize_t mbedtls_ssl_get_output_max_frag_len(const mbedtls_ssl_context *ssl);\0A\0A/**\0A * \5Cbrief          Return the maximum fragment length (payload, in bytes) for\0A *                 the input buffer. This is the negotiated maximum fragment\0A *                 length, or, if there is none, MBEDTLS_SSL_IN_CONTENT_LEN.\0A *                 If it is not defined either, the value is 2^14. This function\0A *                 works as its predecessor, \5Cc mbedtls_ssl_get_max_frag_len().\0A *\0A * \5Csa             mbedtls_ssl_conf_max_frag_len()\0A * \5Csa             mbedtls_ssl_get_max_in_record_payload()\0A *\0A * \5Cparam ssl      SSL context\0A *\0A * \5Creturn         Current maximum fragment length for the output buffer.\0A */\0Asize_t mbedtls_ssl_get_input_max_frag_len(const mbedtls_ssl_context *ssl);\0A#endif /* MBEDTLS_SSL_MAX_FRAGMENT_LENGTH */\0A\0A#if defined(MBEDTLS_SSL_RECORD_SIZE_LIMIT)\0A/**\0A * \5Cbrief    Get the size limit in bytes for the protected outgoing records\0A *           as defined in RFC 8449\0A *\0A * \5Cparam ssl      SSL context\0A *\0A * \5Creturn         The size limit in bytes for the protected outgoing\0A *                 records as defined in RFC 8449.\0A */\0Asize_t mbedtls_ssl_get_output_record_size_limit(const mbedtls_ssl_context *ssl);\0A#endif /* MBEDTLS_SSL_RECORD_SIZE_LIMIT */\0A\0A#if defined(MBEDTLS_SSL_VARIABLE_BUFFER_LENGTH)\0Astatic inline size_t mbedtls_ssl_get_output_buflen(const mbedtls_ssl_context *ctx)\0A{\0A#if defined(MBEDTLS_SSL_DTLS_CONNECTION_ID)\0A    return mbedtls_ssl_get_output_max_frag_len(ctx)\0A           + MBEDTLS_SSL_HEADER_LEN + MBEDTLS_SSL_PAYLOAD_OVERHEAD\0A           + MBEDTLS_SSL_CID_OUT_LEN_MAX;\0A#else\0A    return mbedtls_ssl_get_output_max_frag_len(ctx)\0A           + MBEDTLS_SSL_HEADER_LEN + MBEDTLS_SSL_PAYLOAD_OVERHEAD;\0A#endif\0A}\0A\0Astatic inline size_t mbedtls_ssl_get_input_buflen(const mbedtls_ssl_context *ctx)\0A{\0A#if defined(MBEDTLS_SSL_DTLS_CONNECTION_ID)\0A    return mbedtls_ssl_get_input_max_frag_len(ctx)\0A           + MBEDTLS_SSL_HEADER_LEN + MBEDTLS_SSL_PAYLOAD_OVERHEAD\0A           + MBEDTLS_SSL_CID_IN_LEN_MAX;\0A#else\0A    return mbedtls_ssl_get_input_max_frag_len(ctx)\0A           + MBEDTLS_SSL_HEADER_LEN + MBEDTLS_SSL_PAYLOAD_OVERHEAD;\0A#endif\0A}\0A#endif\0A\0A/*\0A * TLS extension flags (for extensions with outgoing ServerHello content\0A * that need it (e.g. for RENEGOTIATION_INFO the server already knows because\0A * of state of the renegotiation flag, so no indicator is required)\0A */\0A#define MBEDTLS_TLS_EXT_SUPPORTED_POINT_FORMATS_PRESENT (1 << 0)\0A#define MBEDTLS_TLS_EXT_ECJPAKE_KKPP_OK                 (1 << 1)\0A\0A/**\0A * \5Cbrief        This function checks if the remaining size in a buffer is\0A *               greater or equal than a needed space.\0A *\0A * \5Cparam cur    Pointer to the current position in the buffer.\0A * \5Cparam end    Pointer to one past the end of the buffer.\0A * \5Cparam need   Needed space in bytes.\0A *\0A * \5Creturn       Zero if the needed space is available in the buffer, non-zero\0A *               otherwise.\0A */\0A#if !defined(MBEDTLS_TEST_HOOKS)\0Astatic inline int mbedtls_ssl_chk_buf_ptr(const uint8_t *cur,\0A                                          const uint8_t *end, size_t need)\0A{\0A    return (cur > end) || (need > (size_t) (end - cur));\0A}\0A#else\0Atypedef struct {\0A    const uint8_t *cur;\0A    const uint8_t *end;\0A    size_t need;\0A} mbedtls_ssl_chk_buf_ptr_args;\0A\0Avoid mbedtls_ssl_set_chk_buf_ptr_fail_args(\0A    const uint8_t *cur, const uint8_t *end, size_t need);\0Avoid mbedtls_ssl_reset_chk_buf_ptr_fail_args(void);\0A\0AMBEDTLS_CHECK_RETURN_CRITICAL\0Aint mbedtls_ssl_cmp_chk_buf_ptr_fail_args(mbedtls_ssl_chk_buf_ptr_args *args);\0A\0Astatic inline int mbedtls_ssl_chk_buf_ptr(const uint8_t *cur,\0A                                          const uint8_t *end, size_t need)\0A{\0A    if ((cur > end) || (need > (size_t) (end - cur))) {\0A        mbedtls_ssl_set_chk_buf_ptr_fail_args(cur, end, need);\0A        return 1;\0A    }\0A    return 0;\0A}\0A#endif /* MBEDTLS_TEST_HOOKS */\0A\0A/**\0A * \5Cbrief        This macro checks if the remaining size in a buffer is\0A *               greater or equal than a needed space. If it is not the case,\0A *               it returns an SSL_BUFFER_TOO_SMALL error.\0A *\0A * \5Cparam cur    Pointer to the current position in the buffer.\0A * \5Cparam end    Pointer to one past the end of the buffer.\0A * \5Cparam need   Needed space in bytes.\0A *\0A */\0A#define MBEDTLS_SSL_CHK_BUF_PTR(cur, end, need)                        \5C\0A    do {                                                                 \5C\0A        if (mbedtls_ssl_chk_buf_ptr((cur), (end), (need)) != 0) \5C\0A        {                                                                \5C\0A            return MBEDTLS_ERR_SSL_BUFFER_TOO_SMALL;                  \5C\0A        }                                                                \5C\0A    } while (0)\0A\0A/**\0A * \5Cbrief        This macro checks if the remaining length in an input buffer is\0A *               greater or equal than a needed length. If it is not the case, it\0A *               returns #MBEDTLS_ERR_SSL_DECODE_ERROR error and pends a\0A *               #MBEDTLS_SSL_ALERT_MSG_DECODE_ERROR alert message.\0A *\0A *               This is a function-like macro. It is guaranteed to evaluate each\0A *               argument exactly once.\0A *\0A * \5Cparam cur    Pointer to the current position in the buffer.\0A * \5Cparam end    Pointer to one past the end of the buffer.\0A * \5Cparam need   Needed length in bytes.\0A *\0A */\0A#define MBEDTLS_SSL_CHK_BUF_READ_PTR(cur, end, need)                          \5C\0A    do {                                                                        \5C\0A        if (mbedtls_ssl_chk_buf_ptr((cur), (end), (need)) != 0)        \5C\0A        {                                                                       \5C\0A            MBEDTLS_SSL_DEBUG_MSG(1,                                           \5C\0A                                  (\22missing input data in %s\22, __func__));  \5C\0A            MBEDTLS_SSL_PEND_FATAL_ALERT(MBEDTLS_SSL_ALERT_MSG_DECODE_ERROR,   \5C\0A                                         MBEDTLS_ERR_SSL_DECODE_ERROR);       \5C\0A            return MBEDTLS_ERR_SSL_DECODE_ERROR;                             \5C\0A        }                                                                       \5C\0A    } while (0)\0A\0A#ifdef __cplusplus\0Aextern \22C\22 {\0A#endif\0A\0Atypedef int  mbedtls_ssl_tls_prf_cb(const unsigned char *secret, size_t slen,\0A                                    const char *label,\0A                                    const unsigned char *random, size_t rlen,\0A                                    unsigned char *dstbuf, size_t dlen);\0A\0A/* cipher.h exports the maximum IV, key and block length from\0A * all ciphers enabled in the config, regardless of whether those\0A * ciphers are actually usable in SSL/TLS. Notably, XTS is enabled\0A * in the default configuration and uses 64 Byte keys, but it is\0A * not used for record protection in SSL/TLS.\0A *\0A * In order to prevent unnecessary inflation of key structures,\0A * we introduce SSL-specific variants of the max-{key,block,IV}\0A * macros here which are meant to only take those ciphers into\0A * account which can be negotiated in SSL/TLS.\0A *\0A * Since the current definitions of MBEDTLS_MAX_{KEY|BLOCK|IV}_LENGTH\0A * in cipher.h are rough overapproximations of the real maxima, here\0A * we content ourselves with replicating those overapproximations\0A * for the maximum block and IV length, and excluding XTS from the\0A * computation of the maximum key length. */\0A#define MBEDTLS_SSL_MAX_BLOCK_LENGTH 16\0A#define MBEDTLS_SSL_MAX_IV_LENGTH    16\0A#define MBEDTLS_SSL_MAX_KEY_LENGTH   32\0A\0A/**\0A * \5Cbrief   The data structure holding the cryptographic material (key and IV)\0A *          used for record protection in TLS 1.3.\0A */\0Astruct mbedtls_ssl_key_set {\0A    /*! The key for client->server records. */\0A    unsigned char client_write_key[MBEDTLS_SSL_MAX_KEY_LENGTH];\0A    /*! The key for server->client records. */\0A    unsigned char server_write_key[MBEDTLS_SSL_MAX_KEY_LENGTH];\0A    /*! The IV  for client->server records. */\0A    unsigned char client_write_iv[MBEDTLS_SSL_MAX_IV_LENGTH];\0A    /*! The IV  for server->client records. */\0A    unsigned char server_write_iv[MBEDTLS_SSL_MAX_IV_LENGTH];\0A\0A    size_t key_len; /*!< The length of client_write_key and\0A                     *   server_write_key, in Bytes. */\0A    size_t iv_len;  /*!< The length of client_write_iv and\0A                     *   server_write_iv, in Bytes. */\0A};\0Atypedef struct mbedtls_ssl_key_set mbedtls_ssl_key_set;\0A\0Atypedef struct {\0A    unsigned char binder_key[MBEDTLS_TLS1_3_MD_MAX_SIZE];\0A    unsigned char client_early_traffic_secret[MBEDTLS_TLS1_3_MD_MAX_SIZE];\0A    unsigned char early_exporter_master_secret[MBEDTLS_TLS1_3_MD_MAX_SIZE];\0A} mbedtls_ssl_tls13_early_secrets;\0A\0Atypedef struct {\0A    unsigned char client_handshake_traffic_secret[MBEDTLS_TLS1_3_MD_MAX_SIZE];\0A    unsigned char server_handshake_traffic_secret[MBEDTLS_TLS1_3_MD_MAX_SIZE];\0A} mbedtls_ssl_tls13_handshake_secrets;\0A\0A/*\0A * This structure contains the parameters only needed during handshake.\0A */\0Astruct mbedtls_ssl_handshake_params {\0A    /* Frequently-used boolean or byte fields (placed early to take\0A     * advantage of smaller code size for indirect access on Arm Thumb) */\0A    uint8_t resume;                     /*!<  session resume indicator*/\0A    uint8_t cli_exts;                   /*!< client extension presence*/\0A\0A#if defined(MBEDTLS_SSL_SERVER_NAME_INDICATION)\0A    uint8_t sni_authmode;               /*!< authmode from SNI callback     */\0A#endif\0A\0A#if defined(MBEDTLS_SSL_SRV_C)\0A    /* Flag indicating if a CertificateRequest message has been sent\0A     * to the client or not. */\0A    uint8_t certificate_request_sent;\0A#if defined(MBEDTLS_SSL_EARLY_DATA)\0A    /* Flag indicating if the server has accepted early data or not. */\0A    uint8_t early_data_accepted;\0A#endif\0A#endif /* MBEDTLS_SSL_SRV_C */\0A\0A#if defined(MBEDTLS_SSL_SESSION_TICKETS)\0A    uint8_t new_session_ticket;         /*!< use NewSessionTicket?    */\0A#endif /* MBEDTLS_SSL_SESSION_TICKETS */\0A\0A#if defined(MBEDTLS_SSL_CLI_C)\0A    /** Minimum TLS version to be negotiated.\0A     *\0A     * It is set up in the ClientHello writing preparation stage and used\0A     * throughout the ClientHello writing. Not relevant anymore as soon as\0A     * the protocol version has been negotiated thus as soon as the\0A     * ServerHello is received.\0A     * For a fresh handshake not linked to any previous handshake, it is\0A     * equal to the configured minimum minor version to be negotiated. When\0A     * renegotiating or resuming a session, it is equal to the previously\0A     * negotiated minor version.\0A     *\0A     * There is no maximum TLS version field in this handshake context.\0A     *