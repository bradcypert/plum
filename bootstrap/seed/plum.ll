n_cid, own_cid_len);\0A    /* Truncation is not an issue here because\0A     * MBEDTLS_SSL_CID_IN_LEN_MAX at most 255. */\0A    ssl->own_cid_len = (uint8_t) own_cid_len;\0A\0A    return 0;\0A}\0A\0Aint mbedtls_ssl_get_own_cid(mbedtls_ssl_context *ssl,\0A                            int *enabled,\0A                            unsigned char own_cid[MBEDTLS_SSL_CID_IN_LEN_MAX],\0A                            size_t *own_cid_len)\0A{\0A    *enabled = MBEDTLS_SSL_CID_DISABLED;\0A\0A    if (ssl->conf->transport != MBEDTLS_SSL_TRANSPORT_DATAGRAM) {\0A        return MBEDTLS_ERR_SSL_BAD_INPUT_DATA;\0A    }\0A\0A    /* We report MBEDTLS_SSL_CID_DISABLED in case the CID length is\0A     * zero as this is indistinguishable from not requesting to use\0A     * the CID extension. */\0A    if (ssl->own_cid_len == 0 || ssl->negotiate_cid == MBEDTLS_SSL_CID_DISABLED) {\0A        return 0;\0A    }\0A\0A    if (own_cid_len != NULL) {\0A        *own_cid_len = ssl->own_cid_len;\0A        if (own_cid != NULL) {\0A            memcpy(own_cid, ssl->own_cid, ssl->own_cid_len);\0A        }\0A    }\0A\0A    *enabled = MBEDTLS_SSL_CID_ENABLED;\0A\0A    return 0;\0A}\0A\0Aint mbedtls_ssl_get_peer_cid(mbedtls_ssl_context *ssl,\0A                             int *enabled,\0A                             unsigned char peer_cid[MBEDTLS_SSL_CID_OUT_LEN_MAX],\0A                             size_t *peer_cid_len)\0A{\0A    *enabled = MBEDTLS_SSL_CID_DISABLED;\0A\0A    if (ssl->conf->transport != MBEDTLS_SSL_TRANSPORT_DATAGRAM ||\0A        mbedtls_ssl_is_handshake_over(ssl) == 0) {\0A        return MBEDTLS_ERR_SSL_BAD_INPUT_DATA;\0A    }\0A\0A    /* We report MBEDTLS_SSL_CID_DISABLED in case the CID extensions\0A     * were used, but client and server requested the empty CID.\0A     * This is indistinguishable from not using the CID extension\0A     * in the first place. */\0A    if (ssl->transform_in->in_cid_len  == 0 &&\0A        ssl->transform_in->out_cid_len == 0) {\0A        return 0;\0A    }\0A\0A    i