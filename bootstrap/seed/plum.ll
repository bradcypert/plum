@.str41480 = private global { i64, i64, [16211 x i8] } { i64 -1, i64 16210, [16211 x i8] c"/*\0A *  PSA persistent key storage\0A */\0A/*\0A *  Copyright The Mbed TLS Contributors\0A *  SPDX-License-Identifier: Apache-2.0 OR GPL-2.0-or-later\0A */\0A\0A#include \22common.h\22\0A\0A#if defined(MBEDTLS_PSA_CRYPTO_STORAGE_C)\0A\0A#include <stdlib.h>\0A#include <string.h>\0A\0A#include \22psa/crypto.h\22\0A#include \22psa_crypto_storage.h\22\0A#include \22mbedtls/platform_util.h\22\0A\0A#if defined(MBEDTLS_PSA_ITS_FILE_C)\0A#include \22psa_crypto_its.h\22\0A#else /* Native ITS implementation */\0A#include \22psa/error.h\22\0A#include \22psa/internal_trusted_storage.h\22\0A#endif\0A\0A#include \22mbedtls/platform.h\22\0A\0A\0A\0A/****************************************************************/\0A/* Key storage */\0A/****************************************************************/\0A\0A/* Determine a file name (ITS file identifier) for the given key identifier.\0A * The file name must be distinct from any file that is used for a purpose\0A * other than storing a key. Currently, the only such file is the random seed\0A * file whose name is PSA_CRYPTO_ITS_RANDOM_SEED_UID and whose value is\0A * 0xFFFFFF52. */\0Astatic psa_storage_uid_t psa_its_identifier_of_slot(mbedtls_svc_key_id_t key)\0A{\0A#if defined(MBEDTLS_PSA_CRYPTO_KEY_ID_ENCODES_OWNER)\0A    /* Encode the owner in the upper 32 bits. This means that if\0A     * owner values are nonzero (as they are on a PSA platform),\0A     * no key file will ever have a value less than 0x100000000, so\0A     * the whole range 0..0xffffffff is available for non-key files. */\0A    uint32_t unsigned_owner_id = MBEDTLS_SVC_KEY_ID_GET_OWNER_ID(key);\0A    return ((uint64_t) unsigned_owner_id << 32) |\0A           MBEDTLS_SVC_KEY_ID_GET_KEY_ID(key);\0A#else\0A    /* Use the key id directly as a file name.\0A     * psa_is_key_id_valid() in psa_crypto_slot_management.c\0A     * is responsible for ensuring that key identifiers do not have a\0A     * value that is reserved for non-key files. */\0A    return key;\0A#endif\0A}\0A\0A/**\0A * \5Cbrief Load persistent data for the given key slot number.\0A *\0A * This function reads data from a storage backend and returns the data in a\0A * buffer.\0A *\0A * \5Cparam key               Persistent identifier of the key to be loaded. This\0A *                          should be an occupied storage location.\0A * \5Cparam[out] data         Buffer where the data is to be written.\0A * \5Cparam data_size         Size of the \5Cc data buffer in bytes.\0A *\0A * \5Cretval #PSA_SUCCESS \5Cemptydescription\0A * \5Cretval #PSA_ERROR_DATA_INVALID \5Cemptydescription\0A * \5Cretval #PSA_ERROR_DATA_CORRUPT \5Cemptydescription\0A * \5Cretval #PSA_ERROR_STORAGE_FAILURE \5Cemptydescription\0A * \5Cretval #PSA_ERROR_DOES_NOT_EXIST \5Cemptydescription\0A */\0Astatic psa_status_t psa_crypto_storage_load(\0A    const mbedtls_svc_key_id_t key, uint8_t *data, size_t data_size)\0A{\0A    psa_status_t status;\0A    psa_storage_uid_t data_identifier = psa_its_identifier_of_slot(key);\0A    struct psa_storage_info_t data_identifier_info;\0A    size_t data_length = 0;\0A\0A    status = psa_its_get_info(data_identifier, &data_identifier_info);\0A    if (status  != PSA_SUCCESS) {\0A        return status;\0A    }\0A\0A    status = psa_its_get(data_identifier, 0, (uint32_t) data_size, data, &data_length);\0A    if (data_size  != data_length) {\0A        return PSA_ERROR_DATA_INVALID;\0A    }\0A\0A    return status;\0A}\0A\0Aint psa_is_key_present_in_storage(const mbedtls_svc_key_id_t key)\0A{\0A    psa_status_t ret;\0A    psa_storage_uid_t data_identifier = psa_its_identifier_of_slot(key);\0A    struct psa_storage_info_t data_identifier_info;\0A\0A    ret = psa_its_get_info(data_identifier, &data_identifier_info);\0A\0A    if (ret == PSA_ERROR_DOES_NOT_EXIST) {\0A        return 0;\0A    }\0A    return 1;\0A}\0A\0A/**\0A * \5Cbrief Store persistent data for the given key slot number.\0A *\0A * This function stores the given data buffer to a persistent storage.\0A *\0A * \5Cparam key           Persistent identifier of the key to be stored. This\0A *                      should be an unoccupied storage location.\0A * \5Cparam[in] data      Buffer containing the data to be stored.\0A * \5Cparam data_length   The number of bytes\0A *                      that make up the data.\0A *\0A * \5Cretval #PSA_SUCCESS \5Cemptydescription\0A * \5Cretval #PSA_ERROR_INSUFFICIENT_STORAGE \5Cemptydescription\0A * \5Cretval #PSA_ERROR_ALREADY_EXISTS \5Cemptydescription\0A * \5Cretval #PSA_ERROR_STORAGE_FAILURE \5Cemptydescription\0A * \5Cretval #PSA_ERROR_DATA_INVALID \5Cemptydescription\0A */\0Astatic psa_status_t psa_crypto_storage_store(const mbedtls_svc_key_id_t key,\0A                                             const uint8_t *data,\0A                                             size_t data_length)\0A{\0A    psa_status_t status;\0A    psa_storage_uid_t data_identifier = psa_its_identifier_of_slot(key);\0A    struct psa_storage_info_t data_identifier_info;\0A\0A    if (psa_is_key_present_in_storage(key) == 1) {\0A        return PSA_ERROR_ALREADY_EXISTS;\0A    }\0A\0A    status = psa_its_set(data_identifier, (uint32_t) data_length, data, 0);\0A    if (status != PSA_SUCCESS) {\0A        return PSA_ERROR_DATA_INVALID;\0A    }\0A\0A    status = psa_its_get_info(data_identifier, &data_identifier_info);\0A    if (status != PSA_SUCCESS) {\0A        goto exit;\0A    }\0A\0A    if (data_identifier_info.size != data_length) {\0A        status = PSA_ERROR_DATA_INVALID;\0A        goto exit;\0A    }\0A\0Aexit:\0A    if (status != PSA_SUCCESS) {\0A        /* Remove the file in case we managed to create it but something\0A         * went wrong. It's ok if the file doesn't exist. If the file exists\0A         * but the removal fails, we're already reporting an error so there's\0A         * nothing else we can do. */\0A        (void) psa_its_remove(data_identifier);\0A    }\0A    return status;\0A}\0A\0Apsa_status_t psa_destroy_persistent_key(const mbedtls_svc_key_id_t key)\0A{\0A    psa_status_t ret;\0A    psa_storage_uid_t data_identifier = psa_its_identifier_of_slot(key);\0A    struct psa_storage_info_t data_identifier_info;\0A\0A    ret = psa_its_get_info(data_identifier, &data_identifier_info);\0A    if (ret == PSA_ERROR_DOES_NOT_EXIST) {\0A        return PSA_SUCCESS;\0A    }\0A\0A    if (psa_its_remove(data_identifier) != PSA_SUCCESS) {\0A        return PSA_ERROR_DATA_INVALID;\0A    }\0A\0A    ret = psa_its_get_info(data_identifier, &data_identifier_info);\0A    if (ret != PSA_ERROR_DOES_NOT_EXIST) {\0A        return PSA_ERROR_DATA_INVALID;\0A    }\0A\0A    return PSA_SUCCESS;\0A}\0A\0A/**\0A * \5Cbrief Get data length for given key slot number.\0A *\0A * \5Cparam key               Persistent identifier whose stored data length\0A *                          is to be obtained.\0A * \5Cparam[out] data_length  The number of bytes that make up the data.\0A *\0A * \5Cretval #PSA_SUCCESS \5Cemptydescription\0A * \5Cretval #PSA_ERROR_STORAGE_FAILURE \5Cemptydescription\0A * \5Cretval #PSA_ERROR_DOES_NOT_EXIST \5Cemptydescription\0A * \5Cretval #PSA_ERROR_DATA_CORRUPT \5Cemptydescription\0A */\0Astatic psa_status_t psa_crypto_storage_get_data_length(\0A    const mbedtls_svc_key_id_t key,\0A    size_t *data_length)\0A{\0A    psa_status_t status;\0A    psa_storage_uid_t data_identifier = psa_its_identifier_of_slot(key);\0A    struct psa_storage_info_t data_identifier_info;\0A\0A    status = psa_its_get_info(data_identifier, &data_identifier_info);\0A    if (status != PSA_SUCCESS) {\0A        return status;\0A    }\0A\0A    *data_length = (size_t) data_identifier_info.size;\0A\0A    return PSA_SUCCESS;\0A}\0A\0A/**\0A * Persistent key storage magic header.\0A */\0A#define PSA_KEY_STORAGE_MAGIC_HEADER \22PSA\5C0KEY\22\0A#define PSA_KEY_STORAGE_MAGIC_HEADER_LENGTH (sizeof(PSA_KEY_STORAGE_MAGIC_HEADER))\0A\0Atypedef struct {\0A    uint8_t magic[PSA_KEY_STORAGE_MAGIC_HEADER_LENGTH];\0A    uint8_t version[4];\0A    uint8_t lifetime[sizeof(psa_key_lifetime_t)];\0A    uint8_t type[2];\0A    uint8_t bits[2];\0A    uint8_t policy[sizeof(psa_key_policy_t)];\0A    uint8_t data_len[4];\0A    uint8_t key_data[];\0A} psa_persistent_key_storage_format;\0A\0Avoid psa_format_key_data_for_storage(const uint8_t *data,\0A                                     const size_t data_length,\0A                                     const psa_key_attributes_t *attr,\0A                                     uint8_t *storage_data)\0A{\0A    psa_persistent_key_storage_format *storage_format =\0A        (psa_persistent_key_storage_format *) storage_data;\0A\0A    memcpy(storage_format->magic, PSA_KEY_STORAGE_MAGIC_HEADER,\0A           PSA_KEY_STORAGE_MAGIC_HEADER_LENGTH);\0A    MBEDTLS_PUT_UINT32_LE(0, storage_format->version, 0);\0A    MBEDTLS_PUT_UINT32_LE(attr->lifetime, storage_format->lifetime, 0);\0A    MBEDTLS_PUT_UINT16_LE((uint16_t) attr->type, storage_format->type, 0);\0A    MBEDTLS_PUT_UINT16_LE((uint16_t) attr->bits, storage_format->bits, 0);\0A    MBEDTLS_PUT_UINT32_LE(attr->policy.usage, storage_format->policy, 0);\0A    MBEDTLS_PUT_UINT32_LE(attr->policy.alg, storage_format->policy, sizeof(uint32_t));\0A    MBEDTLS_PUT_UINT32_LE(attr->policy.alg2, storage_format->policy, 2 * sizeof(uint32_t));\0A    MBEDTLS_PUT_UINT32_LE(data_length, storage_format->data_len, 0);\0A    memcpy(storage_format->key_data, data, data_length);\0A}\0A\0Astatic psa_status_t check_magic_header(const uint8_t *data)\0A{\0A    if (memcmp(data, PSA_KEY_STORAGE_MAGIC_HEADER,\0A               PSA_KEY_STORAGE_MAGIC_HEADER_LENGTH) != 0) {\0A        return PSA_ERROR_DATA_INVALID;\0A    }\0A    return PSA_SUCCESS;\0A}\0A\0Apsa_status_t psa_parse_key_data_from_storage(const uint8_t *storage_data,\0A                                             size_t storage_data_length,\0A                                             uint8_t **key_data,\0A                                             size_t *key_data_length,\0A                                             psa_key_attributes_t *attr)\0A{\0A    psa_status_t status;\0A    const psa_persistent_key_storage_format *storage_format =\0A        (const psa_persistent_key_storage_format *) storage_data;\0A    uint32_t version;\0A\0A    if (storage_data_length < sizeof(*storage_format)) {\0A        return PSA_ERROR_DATA_INVALID;\0A    }\0A\0A    status = check_magic_header(storage_data);\0A    if (status != PSA_SUCCESS) {\0A        return status;\0A    }\0A\0A    version = MBEDTLS_GET_UINT32_LE(storage_format->version, 0);\0A    if (version != 0) {\0A        return PSA_ERROR_DATA_INVALID;\0A    }\0A\0A    *key_data_length = MBEDTLS_GET_UINT32_LE(storage_format->data_len, 0);\0A    if (*key_data_length > (storage_data_length - sizeof(*storage_format)) ||\0A        *key_data_length > PSA_CRYPTO_MAX_STORAGE_SIZE) {\0A        return PSA_ERROR_DATA_INVALID;\0A    }\0A\0A    if (*key_data_length == 0) {\0A        *key_data = NULL;\0A    } else {\0A        *key_data = mbedtls_calloc(1, *key_data_length);\0A        if (*key_data == NULL) {\0A            return PSA_ERROR_INSUFFICIENT_MEMORY;\0A        }\0A        memcpy(*key_data, storage_format->key_data, *key_data_length);\0A    }\0A\0A    attr->lifetime = MBEDTLS_GET_UINT32_LE(storage_format->lifetime, 0);\0A    attr->type = MBEDTLS_GET_UINT16_LE(storage_format->type, 0);\0A    attr->bits = MBEDTLS_GET_UINT16_LE(storage_format->bits, 0);\0A    attr->policy.usage = MBEDTLS_GET_UINT32_LE(storage_format->policy, 0);\0A    attr->policy.alg = MBEDTLS_GET_UINT32_LE(storage_format->policy, sizeof(uint32_t));\0A    attr->policy.alg2 = MBEDTLS_GET_UINT32_LE(storage_format->policy, 2 * sizeof(uint32_t));\0A\0A    return PSA_SUCCESS;\0A}\0A\0Apsa_status_t psa_save_persistent_key(const psa_key_attributes_t *attr,\0A                                     const uint8_t *data,\0A                                     const size_t data_length)\0A{\0A    size_t storage_data_length;\0A    uint8_t *storage_data;\0A    psa_status_t status;\0A\0A    /* All keys saved to persistent storage always have a key context */\0A    if (data == NULL || data_length == 0) {\0A        return PSA_ERROR_INVALID_ARGUMENT;\0A    }\0A\0A    if (data_length > PSA_CRYPTO_MAX_STORAGE_SIZE) {\0A        return PSA_ERROR_INSUFFICIENT_STORAGE;\0A    }\0A    storage_data_length = data_length + sizeof(psa_persistent_key_storage_format);\0A\0A    storage_data = mbedtls_calloc(1, storage_data_length);\0A    if (storage_data == NULL) {\0A        return PSA_ERROR_INSUFFICIENT_MEMORY;\0A    }\0A\0A    psa_format_key_data_for_storage(data, data_length, attr, storage_data);\0A\0A    status = psa_crypto_storage_store(attr->id,\0A                                      storage_data, storage_data_length);\0A\0A    mbedtls_zeroize_and_free(storage_data, storage_data_length);\0A\0A    return status;\0A}\0A\0Avoid psa_free_persistent_key_data(uint8_t *key_data, size_t key_data_length)\0A{\0A    mbedtls_zeroize_and_free(key_data, key_data_length);\0A}\0A\0Apsa_status_t psa_load_persistent_key(psa_key_attributes_t *attr,\0A                                     uint8_t **data,\0A                                     size_t *data_length)\0A{\0A    psa_status_t status = PSA_SUCCESS;\0A    uint8_t *loaded_data;\0A    size_t storage_data_length = 0;\0A    mbedtls_svc_key_id_t key = attr->id;\0A\0A    status = psa_crypto_storage_get_data_length(key, &storage_data_length);\0A    if (status != PSA_SUCCESS) {\0A        return status;\0A    }\0A\0A    loaded_data = mbedtls_calloc(1, storage_data_length);\0A\0A    if (loaded_data == NULL) {\0A        return PSA_ERROR_INSUFFICIENT_MEMORY;\0A    }\0A\0A    status = psa_crypto_storage_load(key, loaded_data, storage_data_length);\0A    if (status != PSA_SUCCESS) {\0A        goto exit;\0A    }\0A\0A    status = psa_parse_key_data_from_storage(loaded_data, storage_data_length,\0A                                             data, data_length, attr);\0A\0A    /* All keys saved to persistent storage always have a key context */\0A    if (status == PSA_SUCCESS &&\0A        (*data == NULL || *data_length == 0)) {\0A        status = PSA_ERROR_STORAGE_FAILURE;\0A    }\0A\0Aexit:\0A    mbedtls_zeroize_and_free(loaded_data, storage_data_length);\0A    return status;\0A}\0A\0A\0A\0A/****************************************************************/\0A/* Transactions */\0A/****************************************************************/\0A\0A#if defined(PSA_CRYPTO_STORAGE_HAS_TRANSACTIONS)\0A\0Apsa_crypto_transaction_t psa_crypto_transaction;\0A\0Apsa_status_t psa_crypto_save_transaction(void)\0A{\0A    struct psa_storage_info_t p_info;\0A    psa_status_t status;\0A    status = psa_its_get_info(PSA_CRYPTO_ITS_TRANSACTION_UID, &p_info);\0A    if (status == PSA_SUCCESS) {\0A        /* This shouldn't happen: we're trying to start a transaction while\0A         * there is still a transaction that hasn't been replayed. */\0A        return PSA_ERROR_CORRUPTION_DETECTED;\0A    } else if (status != PSA_ERROR_DOES_NOT_EXIST) {\0A        return status;\0A    }\0A    return psa_its_set(PSA_CRYPTO_ITS_TRANSACTION_UID,\0A                       sizeof(psa_crypto_transaction),\0A                       &psa_crypto_transaction,\0A                       0);\0A}\0A\0Apsa_status_t psa_crypto_load_transaction(void)\0A{\0A    psa_status_t status;\0A    size_t length;\0A    status = psa_its_get(PSA_CRYPTO_ITS_TRANSACTION_UID, 0,\0A                         sizeof(psa_crypto_transaction),\0A                         &psa_crypto_transaction, &length);\0A    if (status != PSA_SUCCESS) {\0A        return status;\0A    }\0A    if (length != sizeof(psa_crypto_transaction)) {\0A        return PSA_ERROR_DATA_INVALID;\0A    }\0A    return PSA_SUCCESS;\0A}\0A\0Apsa_status_t psa_crypto_stop_transaction(void)\0A{\0A    psa_status_t status = psa_its_remove(PSA_CRYPTO_ITS_TRANSACTION_UID);\0A    /* Whether or not updating the storage succeeded, the transaction is\0A     * finished now. It's too late to go back, so zero out the in-memory\0A     * data. */\0A    memset(&psa_crypto_transaction, 0, sizeof(psa_crypto_transaction));\0A    return status;\0A}\0A\0A#endif /* PSA_CRYPTO_STORAGE_HAS_TRANSACTIONS */\0A\0A\0A\0A/****************************************************************/\0A/* Random generator state */\0A/****************************************************************/\0A\0A#if defined(MBEDTLS_PSA_INJECT_ENTROPY)\0Apsa_status_t mbedtls_psa_storage_inject_entropy(const unsigned char *seed,\0A                                                size_t seed_size)\0A{\0A    psa_status_t status;\0A    struct psa_storage_info_t p_info;\0A\0A    status = psa_its_get_info(PSA_CRYPTO_ITS_RANDOM_SEED_UID, &p_info);\0A\0A    if (PSA_ERROR_DOES_NOT_EXIST == status) { /* No seed exists */\0A        status = psa_its_set(PSA_CRYPTO_ITS_RANDOM_SEED_UID, seed_size, seed, 0);\0A    } else if (PSA_SUCCESS == status) {\0A        /* You should not be here. Seed needs to be injected only once */\0A        status = PSA_ERROR_NOT_PERMITTED;\0A    }\0A    return status;\0A}\0A#endif /* MBEDTLS_PSA_INJECT_ENTROPY */\0A\0A\0A\0A/****************************************************************/\0A/* The end */\0A/****************************************************************/\0A\0A#endif /* MBEDTLS_PSA_CRYPTO_STORAGE_C */\0A\00" }
@.const41482 = private global <{ i64, ptr, ptr, i1, [7 x i8] }> <{ i64 -1, ptr @.str41478, ptr @.str41480, i1 1, [7 x i8] zeroinitializer }>
