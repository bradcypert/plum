@.str7586 = private global { i64, i64, [79509 x i8] } { i64 -1, i64 79508, [79509 x i8] c"/// A value that may not be there.\0A///\0A/// Plum has no null, so absence is spelled here and the checker makes\0A/// you handle it.\0Apub enum Option[T] { Some(T), None }\0A/// A value, or an explanation of why there isn't one.\0A///\0A/// Failure is an ordinary value: no exceptions, so a function that can\0A/// fail says so in its type.\0Apub enum Result[T, E] { Ok(T), Err(E) }\0A\0A/// Whether there is a value.\0Apub let Option.is_some[T] (o: Option[T]): Bool = match o { Some(_) => true, None => false }\0A/// Whether there is no value.\0Apub let Option.is_none[T] (o: Option[T]): Bool = match o { Some(_) => false, None => true }\0A/// The first option when it contains a value, or `fallback` otherwise.\0A///\0A/// `fallback` is evaluated whether or not it is needed. Use `or_else`\0A/// when finding the fallback costs something.\0Apub let Option.or[T] (o: Option[T]) (fallback: Option[T]): Option[T] = match o { Some(_) => o, None => fallback }\0A/// The first option when it contains a value, or the result of calling\0A/// `f` otherwise. The lazy `or`: `f` runs only when it has to.\0Apub let Option.or_else[T] (o: Option[T]) (f: () -> Option[T]): Option[T] = match o { Some(_) => o, None => f() }\0A/// The value, or `fallback` when there is none.\0A///\0A/// `fallback` is evaluated whether or not it is needed. Use\0A/// `unwrap_or_else` when computing it costs something.\0Apub let Option.unwrap_or[T] (o: Option[T]) (fallback: T): T = match o { Some(v) => v, None => fallback }\0A/// The value, or the result of calling `f` when there is none. The\0A/// lazy `unwrap_or`: `f` runs only when it has to.\0Apub let Option.unwrap_or_else[T] (o: Option[T]) (f: () -> T): T = match o { Some(v) => v, None => f() }\0A/// Transforms the value if there is one, leaving `None` alone.\0Apub let Option.map[T, U] (o: Option[T]) (f: (T) -> U): Option[U] = match o { Some(v) => Some(f(v)), None => None }\0A/// Chains an operation that may itself find nothing.\0A///\0A/// `map` with a function returning `Option` would give\0A/// `Option[Option[U]]`; this is the one that keeps it flat.\0Apub let Option.and_then[T, U] (o: Option[T]) (f: (T) -> Option[U]): Option[U] = match o { Some(v) => f(v), None => None }\0A/// Turns nothing into an error, so an `Option` can join a chain of\0A/// `Result`s.\0Apub let Option.ok_or[T, E] (o: Option[T]) (err: E): Result[T, E] = match o { Some(v) => Ok(v), None => Err(err) }\0A\0A/// Whether this succeeded.\0Apub let Result.is_ok[T, E] (r: Result[T, E]): Bool = match r { Ok(_) => true, Err(_) => false }\0A/// Whether this failed.\0Apub let Result.is_err[T, E] (r: Result[T, E]): Bool = match r { Ok(_) => false, Err(_) => true }\0A/// The value, or `fallback` on failure — DISCARDING the error. Reach\0A/// for `unwrap_or_else` when the error should shape the answer.\0Apub let Result.unwrap_or[T, E] (r: Result[T, E]) (fallback: T): T = match r { Ok(v) => v, Err(_) => fallback }\0A/// The value, or the result of calling `f` with the error. The\0A/// recovery that gets to see what went wrong.\0Apub let Result.unwrap_or_else[T, E] (r: Result[T, E]) (f: (E) -> T): T = match r { Ok(v) => v, Err(e) => f(e) }\0A/// Transforms the value on success, leaving an error untouched.\0Apub let Result.map[T, E, U] (r: Result[T, E]) (f: (T) -> U): Result[U, E] = match r { Ok(v) => Ok(f(v)), Err(e) => Err(e) }\0A/// Transforms the ERROR, leaving a success untouched. For adding\0A/// context to a failure on its way up.\0Apub let Result.map_err[T, E, F] (r: Result[T, E]) (f: (E) -> F): Result[T, F] = match r { Ok(v) => Ok(v), Err(e) => Err(f(e)) }\0A/// Chains an operation that may itself fail, stopping at the first\0A/// error. The flat version of `map` over a fallible step.\0Apub let Result.and_then[T, E, U] (r: Result[T, E]) (f: (T) -> Result[U, E]): Result[U, E] = match r { Ok(v) => f(v), Err(e) => Err(e) }\0A\0A/// Whether the array has no elements.\0Apub let Array.is_empty[T] (xs: Array[T]): Bool = xs.len() == 0\0A\0Alet plum__array_concat_acc[T] (a: Array[T]) (b: Array[T]) (i: Int): Array[T] =\0A    if i >= b.len() { a } else { plum__array_concat_acc(a.push(b[i]), b, i + 1) }\0A/// A new array with `b`'s elements after `a`'s. Neither input is\0A/// changed.\0Apub let Array.concat[T] (a: Array[T]) (b: Array[T]): Array[T] = plum__array_concat_acc(a, b, 0)\0A\0Alet plum__array_contains_acc[T] (xs: Array[T]) (needle: T) (i: Int): Bool =\0A    if i >= xs.len() { false } else if xs[i] == needle { true } else { plum__array_contains_acc(xs, needle, i + 1) }\0A/// Whether any element equals `needle`, compared structurally.\0Apub let Array.contains[T] (xs: Array[T]) (needle: T): Bool = plum__array_contains_acc(xs, needle, 0)\0A\0Alet plum__array_any_acc[T] (xs: Array[T]) (f: (T) -> Bool) (i: Int): Bool =\0A    if i >= xs.len() { false } else if f(xs[i]) { true } else { plum__array_any_acc(xs, f, i + 1) }\0A/// Whether `f` holds for at least one element. Stops at the first\0A/// that passes; false for an empty array.\0Apub let Array.any[T] (xs: Array[T]) (f: (T) -> Bool): Bool = plum__array_any_acc(xs, f, 0)\0A\0A/// Clamped at both ends, like the real prelude's own: a slice past\0A/// the end is the tail, not a crash, which matters because this\0A/// backend emits no bounds check of its own.\0Alet plum__array_slice_acc[T] (xs: Array[T]) (i: Int) (end: Int) (acc: Array[T]): Array[T] =\0A    if i >= end { acc } else if i >= xs.len() { acc } else { plum__array_slice_acc(xs, i + 1, end, acc.push(xs[i])) }\0A/// The elements from `start` up to but NOT including `end`.\0A///\0A/// Out-of-range bounds are clamped rather than an error, and a `start`\0A/// past `end` gives an empty array — so slicing near the end of an\0A/// array needs no arithmetic to stay safe.\0Apub let Array.slice[T] (xs: Array[T]) (start: Int) (end: Int): Array[T] =\0A    plum__array_slice_acc(xs, if start < 0 { 0 } else { start }, end, [])\0A\0Alet plum__array_reverse_acc[T] (xs: Array[T]) (i: Int) (acc: Array[T]): Array[T] =\0A    if i < 0 { acc } else { plum__array_reverse_acc(xs, i - 1, acc.push(xs[i])) }\0A/// A new array in the opposite order.\0Apub let Array.reverse[T] (xs: Array[T]): Array[T] = plum__array_reverse_acc(xs, xs.len() - 1, [])\0A\0Alet plum__array_all_acc[T] (xs: Array[T]) (f: (T) -> Bool) (i: Int): Bool =\0A    if i >= xs.len() { true } else if f(xs[i]) { plum__array_all_acc(xs, f, i + 1) } else { false }\0A/// Whether `f` holds for every element. Stops at the first that\0A/// fails; TRUE for an empty array, which is the convention everywhere\0A/// and still surprises people.\0Apub let Array.all[T] (xs: Array[T]) (f: (T) -> Bool): Bool = plum__array_all_acc(xs, f, 0)\0A\0Alet plum__array_find_acc[T] (xs: Array[T]) (f: (T) -> Bool) (i: Int): Option[T] =\0A    if i >= xs.len() { None } else if f(xs[i]) { Some(xs[i]) } else { plum__array_find_acc(xs, f, i + 1) }\0A/// The first element `f` accepts, or `None`.\0Apub let Array.find[T] (xs: Array[T]) (f: (T) -> Bool): Option[T] = plum__array_find_acc(xs, f, 0)\0A\0Alet plum__array_find_index_acc[T] (xs: Array[T]) (f: (T) -> Bool) (i: Int): Option[Int] =\0A    if i >= xs.len() { None } else if f(xs[i]) { Some(i) } else { plum__array_find_index_acc(xs, f, i + 1) }\0A/// The index of the first element `f` accepts, or `None`.\0Apub let Array.find_index[T] (xs: Array[T]) (f: (T) -> Bool): Option[Int] = plum__array_find_index_acc(xs, f, 0)\0A\0A/// The index of the first element equal to `needle`, or `None`.\0Apub let Array.index_of[T] (xs: Array[T]) (needle: T): Option[Int] = Array.find_index(xs, |x| x == needle)\0A/// The first element, or `None` when the array is empty.\0Apub let Array.first[T] (xs: Array[T]): Option[T] = if Array.is_empty(xs) { None } else { Some(xs[0]) }\0A/// The last element, or `None` when the array is empty.\0Apub let Array.last[T] (xs: Array[T]): Option[T] = if Array.is_empty(xs) { None } else { Some(xs[xs.len() - 1]) }\0A/// The first `n` elements, or all of them if there are fewer. Never\0A/// an error.\0Apub let Array.take[T] (xs: Array[T]) (n: Int): Array[T] = Array.slice(xs, 0, n)\0A/// Everything after the first `n` elements, or nothing if there are\0A/// fewer.\0Apub let Array.drop[T] (xs: Array[T]) (n: Int): Array[T] = Array.slice(xs, n, xs.len())\0A\0A/// The sum, which OVERFLOWS like any other addition and stops the\0A/// program rather than wrapping.\0Apub let Array.sum_int (xs: Array[Int]): Int = Array.fold(xs, 0, |acc, x| acc + x)\0A/// The sum, left to right. Floating-point addition is not\0A/// associative, so a different order can give a different last digit.\0Apub let Array.sum_float (xs: Array[Float]): Float = Array.fold(xs, 0.0, |acc, x| acc + x)\0A\0A// --- Numbers ---\0A\0A/// The absolute value.\0A///\0A/// `Int.abs` of the most negative `Int` cannot be represented and\0A/// overflows, which stops the program rather than returning a negative\0A/// \22absolute\22 value.\0Apub let Int.abs (a: Int): Int = if a < 0 { 0 - a } else { a }\0A/// The smaller of two.\0Apub let Int.min (a: Int) (b: Int): Int = if a < b { a } else { b }\0A/// The larger of two.\0Apub let Int.max (a: Int) (b: Int): Int = if a > b { a } else { b }\0A/// `x` held between `lo` and `hi` inclusive. A `lo` above `hi` gives\0A/// `hi`, since the upper bound is applied last.\0Apub let Int.clamp (x: Int) (lo: Int) (hi: Int): Int = Int.min(Int.max(x, lo), hi)\0A\0A/// An UNSIGNED right shift: zeros are shifted in, never the sign\0A/// bit. `>>` is arithmetic, because `Int` is signed and `-8 >> 1`\0A/// should be -4; hashing wants the other one, and writing it by\0A/// hand is exactly the sort of thing that is wrong at n = 0 and\0A/// n = 64 in every codebase that tries.\0A///\0A/// The mask is `~(-1 << (64 - n))` and NOT `(1 << (64 - n)) - 1`,\0A/// which is the spelling everyone reaches for first and which traps\0A/// here: at n = 1 that is `(1 << 63) - 1`, and `1 << 63` is\0A/// `Int`'s most negative value, so