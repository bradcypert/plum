@.str46072 = private global { i64, i64, [83546 x i8] } { i64 -1, i64 83545, [83546 x i8] c"/**\0A * \5Cfile psa/crypto_extra.h\0A *\0A * \5Cbrief PSA cryptography module: Mbed TLS vendor extensions\0A *\0A * \5Cnote This file may not be included directly. Applications must\0A * include psa/crypto.h.\0A *\0A * This file is reserved for vendor-specific definitions.\0A */\0A/*\0A *  Copyright The Mbed TLS Contributors\0A *  SPDX-License-Identifier: Apache-2.0 OR GPL-2.0-or-later\0A */\0A\0A#ifndef PSA_CRYPTO_EXTRA_H\0A#define PSA_CRYPTO_EXTRA_H\0A#include \22mbedtls/private_access.h\22\0A\0A#include \22crypto_types.h\22\0A#include \22crypto_compat.h\22\0A\0A#ifdef __cplusplus\0Aextern \22C\22 {\0A#endif\0A\0A/* UID for secure storage seed */\0A#define PSA_CRYPTO_ITS_RANDOM_SEED_UID 0xFFFFFF52\0A\0A/* See mbedtls_config.h for definition */\0A#if !defined(MBEDTLS_PSA_KEY_SLOT_COUNT)\0A#define MBEDTLS_PSA_KEY_SLOT_COUNT 32\0A#endif\0A\0A/* If the size of static key slots is not explicitly defined by the user, then\0A * set it to the maximum between PSA_EXPORT_KEY_PAIR_OR_PUBLIC_MAX_SIZE and\0A * PSA_CIPHER_MAX_KEY_LENGTH.\0A * See mbedtls_config.h for the definition. */\0A#if !defined(MBEDTLS_PSA_STATIC_KEY_SLOT_BUFFER_SIZE)\0A#define MBEDTLS_PSA_STATIC_KEY_SLOT_BUFFER_SIZE  \5C\0A    ((PSA_EXPORT_KEY_PAIR_OR_PUBLIC_MAX_SIZE > PSA_CIPHER_MAX_KEY_LENGTH) ? \5C\0A     PSA_EXPORT_KEY_PAIR_OR_PUBLIC_MAX_SIZE : PSA_CIPHER_MAX_KEY_LENGTH)\0A#endif /* !MBEDTLS_PSA_STATIC_KEY_SLOT_BUFFER_SIZE*/\0A\0A/** \5Caddtogroup attributes\0A * @{\0A */\0A\0A/** \5Cbrief Declare the enrollment algorithm for a key.\0A *\0A * An operation on a key may indifferently use the algorithm set with\0A * psa_set_key_algorithm() or with this function.\0A *\0A * \5Cparam[out] attributes       The attribute structure to write to.\0A * \5Cparam alg2                  A second algorithm that the key may be used\0A *                              for, in addition to the algorithm set with\0A *                              psa_set_key_algorithm().\0A *\0A * \5Cwarning Setting an enrollment algorithm is not recommended, because\0A *          using the same key with different algorithms can allow some\0A *          attacks based on arithmetic relations between different\0A *          computations made with the same key, or can escalate harmless\0A *          side channels into exploitable ones. Use this function only\0A *          if it is necessary to support a protocol for which it has been\0A *          verified that the usage of the key with multiple algorithms\0A *          is safe.\0A */\0Astatic inline void psa_set_key_enrollment_algorithm(\0A    psa_key_attributes_t *attributes,\0A    psa_algorithm_t alg2)\0A{\0A    attributes->MBEDTLS_PRIVATE(policy).MBEDTLS_PRIVATE(alg2) = alg2;\0A}\0A\0A/** Retrieve the enrollment algorithm policy from key attributes.\0A *\0A * \5Cparam[in] attributes        The key attribute structure to query.\0A *\0A * \5Creturn The enrollment algorithm stored in the attribute structure.\0A */\0Astatic inline psa_algorithm_t psa_get_key_enrollment_algorithm(\0A    const psa_key_attributes_t *attributes)\0A{\0A    return attributes->MBEDTLS_PRIVATE(policy).MBEDTLS_PRIVATE(alg2);\0A}\0A\0A#if defined(MBEDTLS_PSA_CRYPTO_SE_C)\0A\0A/** Retrieve the slot number where a key is stored.\0A *\0A * A slot number is only defined for keys that are stored in a secure\0A * element.\0A *\0A * This information is only useful if the secure element is not entirely\0A * managed through the PSA Cryptography API. It is up to the secure\0A * element driver to decide how PSA slot numbers map to any other interface\0A * that the secure element may have.\0A *\0A * \5Cparam[in] attributes        The key attribute structure to query.\0A * \5Cparam[out] slot_number      On success, the slot number containing the key.\0A *\0A * \5Cretval #PSA_SUCCESS\0A *         The key is located in a secure element, and \5Cp *slot_number\0A *         indicates the slot number that contains it.\0A * \5Cretval #PSA_ERROR_NOT_PERMITTED\0A *         The caller is not permitted to query the slot number.\0A *         Mbed TLS currently does not return this error.\0A * \5Cretval #PSA_ERROR_INVALID_ARGUMENT\0A *         The key is not located in a secure element.\0A */\0Apsa_status_t psa_get_key_slot_number(\0A    const psa_key_attributes_t *attributes,\0A    psa_key_slot_number_t *slot_number);\0A\0A/** Choose the slot number where a key is stored.\0A *\0A * This function declares a slot number in the specified attribute\0A * structure.\0A *\0A * A slot number is only meaningful for keys that are stored in a secure\0A * element. It is up to the secure element driver to decide how PSA slot\0A * numbers map to any other interface that the secure element may have.\0A *\0A * \5Cnote Setting a slot number in key attributes for a key creation can\0A *       cause the following errors when creating the key:\0A *       - #PSA_ERROR_NOT_SUPPORTED if the selected secure element does\0A *         not support choosing a specific slot number.\0A *       - #PSA_ERROR_NOT_PERMITTED if the caller is not permitted to\0A *         choose slot numbers in general or to choose this specific slot.\0A *       - #PSA_ERROR_INVALID_ARGUMENT if the chosen slot number is not\0A *         valid in general or not valid for this specific key.\0A *       - #PSA_ERROR_ALREADY_EXISTS if there is already a key in the\0A *         selected slot.\0A *\0A * \5Cparam[out] attributes       The attribute structure to write to.\0A * \5Cparam slot_number           The slot number to set.\0A */\0Astatic inline void psa_set_key_slot_number(\0A    psa_key_attributes_t *attributes,\0A    psa_key_slot_number_t slot_number)\0A{\0A    attributes->MBEDTLS_PRIVATE(has_slot_number) = 1;\0A    attributes->MBEDTLS_PRIVATE(slot_number) = slot_number;\0A}\0A\0A/** Remove the slot number attribute from a key attribute structure.\0A *\0A * This function undoes the action of psa_set_key_slot_number().\0A *\0A * \5Cparam[out] attributes       The attribute structure to write to.\0A */\0Astatic inline void psa_clear_key_slot_number(\0A    psa_key_attributes_t *attributes)\0A{\0A    attributes->MBEDTLS_PRIVATE(has_slot_number) = 0;\0A}\0A\0A/** Register a key that is already present in a secure element.\0A *\0A * The key must be located in a secure element designated by the\0A * lifetime field in \5Cp attributes, in the slot set with\0A * psa_set_key_slot_number() in the attribute structure.\0A * This function makes the key available through the key identifier\0A * specified in \5Cp attributes.\0A *\0A * \5Cparam[in] attributes        The attributes of the existing key.\0A *                              - The lifetime must be a persistent lifetime\0A *                                in a secure element. Volatile lifetimes are\0A *                                not currently supported.\0A *                              - The key identifier must be in the valid\0A *                                range for persistent keys.\0A *                              - The key type and size must be specified and\0A *                                must be consistent with the key material\0A *                                in the secure element.\0A *\0A * \5Cretval #PSA_SUCCESS\0A *         The key was successfully registered.\0A *         Note that depending on the design of the driver, this may or may\0A *         not guarantee that a key actually exists in the designated slot\0A *         and is compatible with the specified attributes.\0A * \5Cretval #PSA_ERROR_ALREADY_EXISTS\0A *         There is already a key with the identifier specified in\0A *         \5Cp attributes.\0A * \5Cretval #PSA_ERROR_NOT_SUPPORTED\0A *         The secure element driver for the specified lifetime does not\0A *         support registering a key.\0A * \5Cretval #PSA_ERROR_INVALID_ARGUMENT\0A *         The identifier in \5Cp attributes is invalid, namely the identifier is\0A *         not in the user range, or\0A *         \5Cp attributes specifies a lifetime which is not located\0A *         in a secure element, or no slot number is specified in \5Cp attributes,\0A *         or the specified slot number is not valid.\0A * \5Cretval #PSA_ERROR_NOT_PERMITTED\0A *         The caller is not authorized to register the specified key slot.\0A * \5Cretval #PSA_ERROR_INSUFFICIENT_MEMORY \5Cemptydescription\0A * \5Cretval #PSA_ERROR_INSUFFICIENT_STORAGE \5Cemptydescription\0A * \5Cretval #PSA_ERROR_COMMUNICATION_FAILURE \5Cemptydescription\0A * \5Cretval #PSA_ERROR_DATA_INVALID \5Cemptydescription\0A * \5Cretval #PSA_ERROR_DATA_CORRUPT \5Cemptydescription\0A * \5Cretval #PSA_ERROR_CORRUPTION_DETECTED \5Cemptydescription\0A * \5Cretval #PSA_ERROR_BAD_STATE\0A *         The library has not been previously initialized by psa_crypto_init().\0A *         It is implementation-dependent whether a failure to initialize\0A *         results in this error code.\0A */\0Apsa_status_t mbedtls_psa_register_se_key(\0A    const psa_key_attributes_t *attributes);\0A\0A#endif /* MBEDTLS_PSA_CRYPTO_SE_C */\0A\0A/**@}*/\0A\0A/**\0A * \5Cbrief Library deinitialization.\0A *\0A * This function clears all data associated with the PSA layer,\0A * including the whole key store.\0A * This function is not thread safe, it wipes every key slot regardless of\0A * state and reader count. It should only be called when no slot is in use.\0A *\0A * This is an Mbed TLS extension.\0A */\0Avoid mbedtls_psa_crypto_free(void);\0A\0A/** \5Cbrief Statistics about\0A * resource consumption related to the PSA keystore.\0A *\0A * \5Cnote The content of this structure is not part of the stable API and ABI\0A *       of Mbed TLS and may change arbitrarily from version to version.\0A */\0Atypedef struct mbedtls_psa_stats_s {\0A    /** Number of slots containing key material for a volatile key. */\0A    size_t MBEDTLS_PRIVATE(volatile_slots);\0A    /** Number of slots containing key material for a key which is in\0A     * internal persistent storage. */\0A    size_t MBEDTLS_PRIVATE(persistent_slots);\0A    /** Number of slots containing a reference to a key in a\0A     * secure element. */\0A    size_t MBEDTLS_PRIVATE(external_slots);\0A    /** Number of slots which are occupied, but do not contain\0A     * key material yet. */\0A    size_t MBEDTLS_PRIVATE(half_filled_slots);\0A    /** Number of slots that contain cache data. */\0A    size_t MBEDTLS_PRIVATE(cache_slots);\0A    /** Number of slots that are not used for anything. */\0A    size_t MBEDTLS_PRIVATE(empty_slots);\0A    /** Number of slots that are locked. */\0A    size_t MBEDTLS_PRIVATE(locked_slots);\0A    /** Largest key id value among open keys in internal persistent storage. */\0A    psa_key_id_t MBEDTLS_PRIVATE(max_open_internal_key_id);\0A    /** Largest key id value among open keys in secure elements. */\0A    psa_key_id_t MBEDTLS_PRIVATE(max_open_external_key_id);\0A} mbedtls_psa_stats_t;\0A\0A/** \5Cbrief Get statistics about\0A * resource consumption related to the PSA keystore.\0A *\0A * \5Cnote When Mbed TLS is built as part of a service, with isolation\0A *       between the application and the keystore, the service may or\0A *       may not expose this function.\0A */\0Avoid mbedtls_psa_get_stats(mbedtls_psa_stats_t *stats);\0A\0A/**\0A * \5Cbrief Inject an initial entropy seed for the random generator into\0A *        secure storage.\0A *\0A * This function injects data to be used as a seed for the random generator\0A * used by the PSA Crypto implementation. On devices that lack a trusted\0A * entropy source (preferably a hardware random number generator),\0A * the Mbed PSA Crypto implementation uses this value to seed its\0A * random generator.\0A *\0A * On devices without a trusted entropy source, this function must be\0A * called exactly once in the lifetime of the device. On devices with\0A * a trusted entropy source, calling this function is optional.\0A * In all cases, this function may only be called before calling any\0A * other function in the PSA Crypto API, including psa_crypto_init().\0A *\0A * When this function returns successfully, it populates a file in\0A * persistent storage. Once the file has been created, this function\0A * can no longer succeed.\0A *\0A * If any error occurs, this function does not change the system state.\0A * You can call this function again after correcting the reason for the\0A * error if possible.\0A *\0A * \5Cwarning This function **can** fail! Callers MUST check the return status.\0A *\0A * \5Cwarning If you use this function, you should use it as part of a\0A *          factory provisioning process. The value of the injected seed\0A *          is critical to the security of the device. It must be\0A *          *secret*, *unpredictable* and (statistically) *unique per device*.\0A *          You should be generate it randomly using a cryptographically\0A *          secure random generator seeded from trusted entropy sources.\0A *          You should transmit it securely to the device and ensure\0A *          that its value is not leaked or stored anywhere beyond the\0A *          needs of transmitting it from the point of generation to\0A *          the call of this function, and erase all copies of the value\0A *          once this function returns.\0A *\0A * This is an Mbed TLS extension.\0A *\0A * \5Cnote This function is only available on the following platforms:\0A * * If the compile-time option MBEDTLS_PSA_INJECT_ENTROPY is enabled.\0A *   Note that you must provide compatible implementations of\0A *   mbedtls_nv_seed_read and mbedtls_nv_seed_write.\0A * * In a client-server integration of PSA Cryptography, on the client side,\0A *   if the server supports this feature.\0A * \5Cparam[in] seed          Buffer containing the seed value to inject.\0A * \5Cparam[in] seed_size     Size of the \5Cp seed buffer.\0A *                          The size of the seed in bytes must be greater\0A *                          or equal to both #MBEDTLS_ENTROPY_BLOCK_SIZE\0A *                          and the value of \5Cc MBEDTLS_ENTROPY_MIN_PLATFORM\0A *                          in `library/entropy_poll.h` in the Mbed TLS source\0A *                          code.\0A *                          It must be less or equal to\0A *                          #MBEDTLS_ENTROPY_MAX_SEED_SIZE.\0A *\0A * \5Cretval #PSA_SUCCESS\0A *         The seed value was injected successfully. The random generator\0A *         of the PSA Crypto implementation is now ready for use.\0A *         You may now call psa_crypto_init() and use the PSA Crypto\0A *         implementation.\0A * \5Cretval #PSA_ERROR_INVALID_ARGUMENT\0A *         \5Cp seed_size is out of range.\0A * \5Cretval #PSA_ERROR_STORAGE_FAILURE\0A *         There was a failure reading or writing from storage.\0A * \5Cretval #PSA_ERROR_NOT_PERMITTED\0A *         The library has already been initialized. It is no longer\0A *         possible to call this function.\0A */\0Apsa_status_t mbedtls_psa_inject_entropy(const uint8_t *seed,\0A                                        size_t seed_size);\0A\0A/** \5Caddtogroup crypto_types\0A * @{\0A */\0A\0A/** DSA public key.\0A *\0A * The import and export format is the\0A * representation of the public key `y = g^x mod p` as a big-endian byte\0A * string. The length of the byte string is the length of the base prime `p`\0A * in bytes.\0A */\0A#define PSA_KEY_TYPE_DSA_PUBLIC_KEY                 ((psa_key_type_t) 0x4002)\0A\0A/** DSA key pair (private and public key).\0A *\0A * The import and export format is the\0A * representation of the private key `x` as a big-endian byte string. The\0A * length of the byte string is the private key size in bytes (leading zeroes\0A * are not stripped).\0A *\0A * Deterministic DSA key derivation with psa_generate_derived_key follows\0A * FIPS 186-4 &sect;B.1.2: interpret the byte string as integer\0A * in big-endian order. Discard it if it is not in the range\0A * [0, *N* - 2] where *N* is the boundary of the private key domain\0A * (the prime *p* for Diffie-Hellman, the subprime *q* for DSA,\0A * or the order of the curve's base point for ECC).\0A * Add 1 to the resulting integer and use this as the private key *x*.\0A *\0A */\0A#define PSA_KEY_TYPE_DSA_KEY_PAIR                    ((psa_key_type_t) 0x7002)\0A\0A/** Whether a key type is a DSA key (pair or public-only). */\0A#define PSA_KEY_TYPE_IS_DSA(type)                                       \5C\0A    (PSA_KEY_TYPE_PUBLIC_KEY_OF_KEY_PAIR(type) == PSA_KEY_TYPE_DSA_PUBLIC_KEY)\0A\0A#define PSA_ALG_DSA_BASE                        ((psa_algorithm_t) 0x06000400)\0A/** DSA signature with hashing.\0A *\0A * This is the signature scheme defined by FIPS 186-4,\0A * with a random per-message secret number (*k*).\0A *\0A * \5Cparam hash_alg      A hash algorithm (\5Cc PSA_ALG_XXX value such that\0A *                      #PSA_ALG_IS_HASH(\5Cp hash_alg) is true).\0A *                      This includes #PSA_ALG_ANY_HASH\0A *                      when specifying the algorithm in a usage policy.\0A *\0A * \5Creturn              The corresponding DSA signature algorithm.\0A * \5Creturn              Unspecified if \5Cp hash_alg is not a supported\0A *                      hash algorithm.\0A */\0A#define PSA_ALG_DSA(hash_alg)                             \5C\0A    (PSA_ALG_DSA_BASE | ((hash_alg) & PSA_ALG_HASH_MASK))\0A#define PSA_ALG_DETERMINISTIC_DSA_BASE          ((psa_algorithm_t) 0x06000500)\0A#define PSA_ALG_DSA_DETERMINISTIC_FLAG PSA_ALG_ECDSA_DETERMINISTIC_FLAG\0A/** Deterministic DSA signature with hashing.\0A *\0A * This is the deterministic variant defined by RFC 6979 of\0A * the signature scheme defined by FIPS 186-4.\0A *\0A * \5Cparam hash_alg      A hash algorithm (\5Cc PSA_ALG_XXX value such that\0A *                      #PSA_ALG_IS_HASH(\5Cp hash_alg) is true).\0A *                      This includes #PSA_ALG_ANY_HASH\0A *                      when specifying the algorithm in a usage policy.\0A *\0A * \5Creturn              The corresponding DSA signature algorithm.\0A * \5Creturn              Unspecified if \5Cp hash_alg is not a supported\0A *                      hash algorithm.\0A */\0A#define PSA_ALG_DETERMINISTIC_DSA(hash_alg)                             \5C\0A    (PSA_ALG_DETERMINISTIC_DSA_BASE | ((hash_alg) & PSA_ALG_HASH_MASK))\0A#define PSA_ALG_IS_DSA(alg)                                             \5C\0A    (((alg) & ~PSA_ALG_HASH_MASK & ~PSA_ALG_DSA_DETERMINISTIC_FLAG) ==  \5C\0A     PSA_ALG_DSA_BASE)\0A#define PSA_ALG_DSA_IS_DETERMINISTIC(alg)               \5C\0A    (((alg) & PSA_ALG_DSA_DETERMINISTIC_FLAG) != 0)\0A#define PSA_ALG_IS_DETERMINISTIC_DSA(alg)                       \5C\0A    (PSA_ALG_IS_DSA(alg) && PSA_ALG_DSA_IS_DETERMINISTIC(alg))\0A#define PSA_ALG_IS_RANDOMIZED_DSA(alg)                          \5C\0A    (PSA_ALG_IS_DSA(alg) && !PSA_ALG_DSA_IS_DETERMINISTIC(alg))\0A\0A\0A/* We need to expand the sample definition of this macro from\0A * the API definition. */\0A#undef PSA_ALG_IS_VENDOR_HASH_AND_SIGN\0A#define PSA_ALG_IS_VENDOR_HASH_AND_SIGN(alg)    \5C\0A    PSA_ALG_IS_DSA(alg)\0A\0A/**@}*/\0A\0A/** \5Caddtogroup attributes\0A * @{\0A */\0A\0A/** PAKE operation stages. */\0A#define PSA_PAKE_OPERATION_STAGE_SETUP 0\0A#define PSA_PAKE_OPERATION_STAGE_COLLECT_INPUTS 1\0A#define PSA_PAKE_OPERATION_STAGE_COMPUTATION 2\0A\0A/**@}*/\0A\0A\0A/** \5Cdefgroup psa_external_rng External random generator\0A * @{\0A */\0A\0A#if defined(MBEDTLS_PSA_CRYPTO_EXTERNAL_RNG)\0A/** External random generator function, implemented by the platform.\0A *\0A * When the compile-time option #MBEDTLS_PSA_CRYPTO_EXTERNAL_RNG is enabled,\0A * this function replaces Mbed TLS's entropy and DRBG modules for all\0A * random generation triggered via PSA crypto interfaces.\0A *\0A * \5Cnote This random generator must deliver random numbers with cryptographic\0A *       quality and high performance. It must supply unpredictable numbers\0A *       with a uniform distribution. The implementation of this function\0A *       is responsible for ensuring that the random generator is seeded\0A *       with sufficient entropy. If you have a hardware TRNG which is slow\0A *       or delivers non-uniform output, declare it as an entropy source\0A *       with mbedtls_entropy_add_source() instead of enabling this option.\0A *\0A * \5Cparam[in,out] context       Pointer to the random generator context.\0A *                              This is all-bits-zero on the first call\0A *                              and preserved between successive calls.\0A * \5Cparam[out] output           Output buffer. On success, this buffer\0A *                              contains random data with a uniform\0A *                              distribution.\0A * \5Cparam output_size           The size of the \5Cp output buffer in bytes.\0A * \5Cparam[out] output_length    On success, set this value to \5Cp output_size.\0A *\0A * \5Cretval #PSA_SUCCESS\0A *         Success. The output buffer contains \5Cp output_size bytes of\0A *         cryptographic-quality random data, and \5Cc *output_length is\0A *         set to \5Cp output_size.\0A * \5Cretval #PSA_ERROR_INSUFFICIENT_ENTROPY\0A *         The random generator requires extra entropy and there is no\0A *         way to obtain entropy under current environment conditions.\0A *         This error should not happen under normal circumstances since\0A *         this function is responsible for obtaining as much entropy as\0A *         it needs. However implementations of this function may return\0A *         #PSA_ERROR_INSUFFICIENT_ENTROPY if there is no way to obtain\0A *         entropy without blocking indefinitely.\0A * \5Cretval #PSA_ERROR_HARDWARE_FAILURE\0A *         A failure of the random generator hardware that isn't covered\0A *         by #PSA_ERROR_INSUFFICIENT_ENTROPY.\0A */\0Apsa_status_t mbedtls_psa_external_get_random(\0A    mbedtls_psa_external_random_context_t *context,\0A    uint8_t *output, size_t output_size, size_t *output_length);\0A#endif /* MBEDTLS_PSA_CRYPTO_EXTERNAL_RNG */\0A\0A/**@}*/\0A\0A/** \5Cdefgroup psa_builtin_keys Built-in keys\0A * @{\0A */\0A\0A/** The minimum value for a key identifier that is built into the\0A * implementation.\0A *\0A * The range of key identifiers from #MBEDTLS_PSA_KEY_ID_BUILTIN_MIN\0A * to #MBEDTLS_PSA_KEY_ID_BUILTIN_MAX within the range from\0A * #PSA_KEY_ID_VENDOR_MIN and #PSA_KEY_ID_VENDOR_MAX and must not intersect\0A * with any other set of implementation-chosen key identifiers.\0A *\0A * This value is part of the library's API since changing it would invalidate\0A * the values of built-in key identifiers in applications.\0A */\0A#define MBEDTLS_PSA_KEY_ID_BUILTIN_MIN          ((psa_key_id_t) 0x7fff0000)\0A\0A/** The maximum value for a key identifier that is built into the\0A * implementation.\0A *\0A * See #MBEDTLS_PSA_KEY_ID_BUILTIN_MIN for more information.\0A */\0A#define MBEDTLS_PSA_KEY_ID_BUILTIN_MAX          ((psa_key_id_t) 0x7fffefff)\0A\0A/** A slot number identifying a key in a driver.\0A *\0A * Values of this type are used to identify built-in keys.\0A */\0Atypedef uint64_t psa_drv_slot_number_t;\0A\0A#if defined(MBEDTLS_PSA_CRYPTO_BUILTIN_KEYS)\0A/** Test whether a key identifier belongs to the builtin key range.\0A *\0A * \5Cparam key_id  Key identifier to test.\0A *\0A * \5Cretval 1\0A *         The key identifier is a builtin key identifier.\0A * \5Cretval 0\0A *         The key identifier is not a builtin key identifier.\0A */\0Astatic inline int psa_key_id_is_builtin(psa_key_id_t key_id)\0A{\0A    return (key_id >= MBEDTLS_PSA_KEY_ID_BUILTIN_MIN) &&\0A           (key_id <= MBEDTLS_PSA_KEY_ID_BUILTIN_MAX);\0A}\0A\0A/** Platform function to obtain the location and slot number of a built-in key.\0A *\0A * An application-specific implementation of this function must be provided if\0A * #MBEDTLS_PSA_CRYPTO_BUILTIN_KEYS is enabled. This would typically be provided\0A * as part of a platform's system image.\0A *\0A * #MBEDTLS_SVC_KEY_ID_GET_KEY_ID(\5Cp key_id) needs to be in the range from\0A * #MBEDTLS_PSA_KEY_ID_BUILTIN_MIN to #MBEDTLS_PSA_KEY_ID_BUILTIN_MAX.\0A *\0A * In a multi-application configuration\0A * (\5Cc MBEDTLS_PSA_CRYPTO_KEY_ID_ENCODES_OWNER is defined),\0A * this function should check that #MBEDTLS_SVC_KEY_ID_GET_OWNER_ID(\5Cp key_id)\0A * is allowed to use the given key.\0A *\0A * \5Cparam key_id                The key ID for which to retrieve the\0A *                              location and slot attributes.\0A * \5Cparam[out] lifetime         On success, the lifetime associated with the key\0A *                              corresponding to \5Cp key_id. Lifetime is a\0A *                              combination of which driver contains the key,\0A *                              and with what persistence level the key is\0A *                              intended to be used. If the platform\0A *                              implementation does not contain specific\0A *                              information about the intended key persistence\0A *                              level, the persistence level may be reported as\0A *                              #PSA_KEY_PERSISTENCE_DEFAULT.\0A * \5Cparam[out] slot_number      On success, the slot number known to the driver\0A *                              registered at the lifetime location reported\0A *                              through \5Cp lifetime which corresponds to the\0A *                              requested built-in key.\0A *\0A * \5Cretval #PSA_SUCCESS\0A *         The requested key identifier designates a built-in key.\0A *         In a multi-application configuration, the requested owner\0A *         is allowed to access it.\0A * \5Cretval #PSA_ERROR_DOES_NOT_EXIST\0A *         The requested key identifier is not a built-in key which is known\0A *         to this function. If a key exists in the key storage with this\0A *         identifier, the data from the storage will be used.\0A * \5Creturn (any other error)\0A *         Any other error is propagated to the function that requested the key.\0A *         Common errors include:\0A *         - #PSA_ERROR_NOT_PERMITTED: the key exists but the requested owner\0A *           is not allowed to access it.\0A */\0Apsa_status_t mbedtls_psa_platform_get_builtin_key(\0A    mbedtls_svc_key_id_t key_id,\0A    psa_key_lifetime_t *lifetime,\0A    psa_drv_slot_number_t *slot_number);\0A#endif /* MBEDTLS_PSA_CRYPTO_BUILTIN_KEYS */\0A\0A/** @} */\0A\0A/** \5Cdefgroup psa_crypto_client Functions defined by a client provider\0A *\0A * The functions in this group are meant to be implemented by providers of\0A * the PSA Crypto client interface. They are provided by the library when\0A * #MBEDTLS_PSA_CRYPTO_C is enabled.\0A *\0A * \5Cnote All functions in this group are experimental, as using\0A *       alternative client interface providers is experimental.\0A *\0A * @{\0A */\0A\0A/** Check if PSA is capable of handling the specified hash algorithm.\0A *\0A * This means that PSA core was built with the corresponding PSA_WANT_ALG_xxx\0A * set and that psa_crypto_init has already been called.\0A *\0A * \5Cnote When using Mbed TLS version of PSA core (i.e. MBEDTLS_PSA_CRYPTO_C is\0A *       set) for now this function only checks the state of the driver\0A *       subsystem, not the algorithm. This might be improved in the future.\0A *\0A * \5Cparam hash_alg  The hash algorithm.\0A *\0A * \5Creturn 1 if the PSA can handle \5Cp hash_alg, 0 otherwise.\0A */\0Aint psa_can_do_hash(psa_algorithm_t hash_alg);\0A\0A/**@}*/\0A\0A/** \5Caddtogroup crypto_types\0A * @{\0A */\0A\0A#define PSA_ALG_CATEGORY_PAKE                   ((psa_algorithm_t) 0x0a000000)\0A\0A/** Whether the specified algorithm is a password-authenticated key exchange.\0A *\0A * \5Cparam alg An algorithm identifier (value of type #psa_algorithm_t).\0A *\0A * \5Creturn 1 if \5Cp alg is a password-authenticated key exchange (PAKE)\0A *         algorithm, 0 otherwise.\0A *         This macro may return either 0 or 1 if \5Cp alg is not a supported\0A *         algorithm identifier.\0A */\0A#define PSA_ALG_IS_PAKE(alg)                                        \5C\0A    (((alg) & PSA_ALG_CATEGORY_MASK) == PSA_ALG_CATEGORY_PAKE)\0A\0A/** The Password-authenticated key exchange by juggling (J-PAKE) algorithm.\0A *\0A * This is J-PAKE as defined by RFC 8236, instantiated with the following\0A * parameters:\0A *\0A * - The group can be either an elliptic curve or defined over a finite field.\0A * - Schnorr NIZK proof as defined by RFC 8235 and using the same group as the\0A *   J-PAKE algorithm.\0A * - A cryptographic hash function.\0A *\0A * To select these parameters and set up the cipher suite, call these functions\0A * in any order:\0A *\0A * \5Ccode\0A * psa_pake_cs_set_algorithm(cipher_suite, PSA_ALG_JPAKE);\0A * psa_pake_cs_set_primitive(cipher_suite,\0A *                           PSA_PAKE_PRIMITIVE(type, family, bits));\0A * psa_pake_cs_set_hash(cipher_suite, hash);\0A * \5Cendcode\0A *\0A * For more information on how to set a specific curve or field, refer to the\0A * documentation of the individual \5Cc PSA_PAKE_PRIMITIVE_TYPE_XXX constants.\0A *\0A * After initializing a J-PAKE operation, call\0A *\0A * \5Ccode\0A * psa_pake_setup(operation, cipher_suite);\0A * psa_pake_set_user(operation, ...);\0A * psa_pake_set_peer(operation, ...);\0A * psa_pake_set_password_key(operation, ...);\0A * \5Cendcode\0A *\0A * The password is provided as a key. This can be the password text itself,\0A * in an agreed character encoding, or some value derived from the password\0A * as required by a higher level protocol.\0A *\0A * (The implementation converts the key material to a number as described in\0A * Section 2.3.8 of _SEC 1: Elliptic Curve Cryptography_\0A * (https://www.secg.org/sec1-v2.pdf), before reducing it modulo \5Cc q. Here\0A * \5Cc q is order of the group defined by the primitive set in the cipher suite.\0A * The \5Cc psa_pake_set_password_key() function returns an error if the result\0A * of the reduction is 0.)\0A *\0A * The key exchange flow for J-PAKE is as follows:\0A * -# To get the first round data that needs to be sent to the peer, call\0A *    \5Ccode\0A *    // Get g1\0A *    psa_pake_output(operation, #PSA_PAKE_STEP_KEY_SHARE, ...);\0A *    // Get the ZKP public key for x1\0A *    psa_pake_output(operation, #PSA_PAKE_STEP_ZK_PUBLIC, ...);\0A *    // Get the ZKP proof for x1\0A *    psa_pake_output(operation, #PSA_PAKE_STEP_ZK_PROOF, ...);\0A *    // Get g2\0A *    psa_pake_output(operation, #PSA_PAKE_STEP_KEY_SHARE, ...);\0A *    // Get the ZKP public key for x2\0A *    psa_pake_output(operation, #PSA_PAKE_STEP_ZK_PUBLIC, ...);\0A *    // Get the ZKP proof for x2\0A *    psa_pake_output(operation, #PSA_PAKE_STEP_ZK_PROOF, ...);\0A *    \5Cendcode\0A * -# To provide the first round data received from the peer to the operation,\0A *    call\0A *    \5Ccode\0A *    // Set g3\0A *    psa_pake_input(operation, #PSA_PAKE_STEP_KEY_SHARE, ...);\0A *    // Set the ZKP public key for x3\0A *    psa_pake_input(operation, #PSA_PAKE_STEP_ZK_PUBLIC, ...);\0A *    // Set the ZKP proof for x3\0A *    psa_pake_input(operation, #PSA_PAKE_STEP_ZK_PROOF, ...);\0A *    // Set g4\0A *    psa_pake_input(operation, #PSA_PAKE_STEP_KEY_SHARE, ...);\0A *    // Set the ZKP public key for x4\0A *    psa_pake_input(operation, #PSA_PAKE_STEP_ZK_PUBLIC, ...);\0A *    // Set the ZKP proof for x4\0A *    psa_pake_input(operation, #PSA_PAKE_STEP_ZK_PROOF, ...);\0A *    \5Cendcode\0A * -# To get the second round data that needs to be sent to the peer, call\0A *    \5Ccode\0A *    // Get A\0A *    psa_pake_output(operation, #PSA_PAKE_STEP_KEY_SHARE, ...);\0A *    // Get ZKP public key for x2*s\0A *    psa_pake_output(operation, #PSA_PAKE_STEP_ZK_PUBLIC, ...);\0A *    // Get ZKP proof for x2*s\0A *    psa_pake_output(operation, #PSA_PAKE_STEP_ZK_PROOF, ...);\0A *    \5Cendcode\0A * -# To provide the second round data received from the peer to the operation,\0A *    call\0A *    \5Ccode\0A *    // Set B\0A *    psa_pake_input(operation, #PSA_PAKE_STEP_KEY_SHARE, ...);\0A *    // Set ZKP public key for x4*s\0A *    psa_pake_input(operation, #PSA_PAKE_STEP_ZK_PUBLIC, ...);\0A *    // Set ZKP proof for x4*s\0A *    psa_pake_input(operation, #PSA_PAKE_STEP_ZK_PROOF, ...);\0A *    \5Cendcode\0A * -# To access the shared secret call\0A *    \5Ccode\0A *    // Get Ka=Kb=K\0A *    psa_pake_get_implicit_key()\0A *    \5Cendcode\0A *\0A * For more information consult the documentation of the individual\0A * \5Cc PSA_PAKE_STEP_XXX constants.\0A *\0A * At this point there is a cryptographic guarantee that only the authenticated\0A * party who used the same password is able to compute the key. But there is no\0A * guarantee that the peer is the party it claims to be and was able to do so.\0A *\0A * That is, the authentication is only implicit (the peer is not authenticated\0A * at this point, and no action should be taken that assume that they are - like\0A * for example accessing restricted files).\0A *\0A * To make the authentication explicit there are various methods, see Section 5\0A * of RFC 8236 for two examples.\0A *\0A */\0A#define PSA_ALG_JPAKE                   ((psa_algorithm_t) 0x0a000100)\0A\0A/** @} */\0A\0A/** \5Cdefgroup pake Password-authenticated key exchange (PAKE)\0A *\0A * This is a proposed PAKE interface for the PSA Crypto API. It is not part of\0A * the official PSA Crypto API yet.\0A *\0A * \5Cnote The content of this section is not part of the stable API and ABI\0A *       of Mbed TLS and may change arbitrarily from version to version.\0A *       Same holds for the corresponding macros #PSA_ALG_CATEGORY_PAKE and\0A *       #PSA_ALG_JPAKE.\0A * @{\0A */\0A\0A/** \5Cbrief Encoding of the application role of PAKE\0A *\0A * Encodes the application's role in the algorithm is being executed. For more\0A * information see the documentation of individual \5Cc PSA_PAKE_ROLE_XXX\0A * constants.\0A */\0Atypedef uint8_t psa_pake_role_t;\0A\0A/** Encoding of input and output indicators for PAKE.\0A *\0A * Some PAKE algorithms need to exchange more data than just a single key share.\0A * This type is for encoding additional input and output data for such\0A * algorithms.\0A */\0Atypedef uint8_t psa_pake_step_t;\0A\0A/** Encoding of the type of the PAKE's primitive.\0A *\0A * Values defined by this standard will never be in the range 0x80-0xff.\0A * Vendors who define additional types must use an encoding in this range.\0A *\0A * For more information see the documentation of individual\0A * \5Cc PSA_PAKE_PRIMITIVE_TYPE_XXX constants.\0A */\0Atypedef uint8_t psa_pake_primitive_type_t;\0A\0A/** \5Cbrief Encoding of the family of the primitive associated with the PAKE.\0A *\0A * For more information see the documentation of individual\0A * \5Cc PSA_PAKE_PRIMITIVE_TYPE_XXX constants.\0A */\0Atypedef uint8_t psa_pake_family_t;\0A\0A/** \5Cbrief Encoding of the primitive associated with the PAKE.\0A *\0A * For more information see the documentation of the #PSA_PAKE_PRIMITIVE macro.\0A */\0Atypedef uint32_t psa_pake_primitive_t;\0A\0A/** A value to indicate no role in a PAKE algorithm.\0A * This value can be used in a call to psa_pake_set_role() for symmetric PAKE\0A * algorithms which do not assign roles.\0A */\0A#define PSA_PAKE_ROLE_NONE                  ((psa_pake_role_t) 0x00)\0A\0A/** The first peer in a balanced PAKE.\0A *\0A * Although balanced PAKE algorithms are symmetric, some of them needs an\0A * ordering of peers for the transcript calculations. If the algorithm does not\0A * need this, both #PSA_PAKE_ROLE_FIRST and #PSA_PAKE_ROLE_SECOND are\0A * accepted.\0A */\0A#define PSA_PAKE_ROLE_FIRST                ((psa_pake_role_t) 0x01)\0A\0A/** The second peer in a balanced PAKE.\0A *\0A * Although balanced PAKE algorithms are symmetric, some of them needs an\0A * ordering of peers for the transcript calculations. If the algorithm does not\0A * need this, either #PSA_PAKE_ROLE_FIRST or #PSA_PAKE_ROLE_SECOND are\0A * accepted.\0A */\0A#define PSA_PAKE_ROLE_SECOND                ((psa_pake_role_t) 0x02)\0A\0A/** The client in an augmented PAKE.\0A *\0A * Augmented PAKE algorithms need to differentiate between client and server.\0A */\0A#define PSA_PAKE_ROLE_CLIENT                ((psa_pake_role_t) 0x11)\0A\0A/** The server in an augmented PAKE.\0A *\0A * Augmented PAKE algorithms need to differentiate between client and server.\0A */\0A#define PSA_PAKE_ROLE_SERVER                ((psa_pake_role_t) 0x12)\0A\0A/** The PAKE primitive type indicating the use of elliptic curves.\0A *\0A * The values of the \5Cc family and \5Cc bits fields of the cipher suite identify a\0A * specific elliptic curve, using the same mapping that is used for ECC\0A * (::psa_ecc_family_t) keys.\0A *\0A * (Here \5Cc family means the value returned by psa_pake_cs_get_family() and\0A * \5Cc bits means the value returned by psa_pake_cs_get_bits().)\0A *\0A * Input and output during the operation can involve group elements and scalar\0A * values:\0A * -# The format for group elements is the same as for public keys on the\0A *  specific curve would be. For more information, consult the documentation of\0A *  psa_export_public_key().\0A * -# The format for scalars is the same as for private keys on the specific\0A *  curve would be. For more information, consult the documentation of\0A *  psa_export_key().\0A */\0A#define PSA_PAKE_PRIMITIVE_TYPE_ECC       ((psa_pake_primitive_type_t) 0x01)\0A\0A/** The PAKE primitive type indicating the use of Diffie-Hellman groups.\0A *\0A * The values of the \5Cc family and \5Cc bits fields of the cipher suite identify\0A * a specific Diffie-Hellman group, using the same mapping that is used for\0A * Diffie-Hellman (::psa_dh_family_t) keys.\0A *\0A * (Here \5Cc family means the value returned by psa_pake_cs_get_family() and\0A * \5Cc bits means the value returned by psa_pake_cs_get_bits().)\0A *\0A * Input and output during the operation can involve group elements and scalar\0A * values:\0A * -# The format for group elements is the same as for public keys on the\0A *  specific group would be. For more information, consult the documentation of\0A *  psa_export_public_key().\0A * -# The format for scalars is the same as for private keys on the specific\0A *  group would be. For more information, consult the documentation of\0A *  psa_export_key().\0A */\0A#define PSA_PAKE_PRIMITIVE_TYPE_DH       ((psa_pake_primitive_type_t) 0x02)\0A\0A/** Construct a PAKE primitive from type, family and bit-size.\0A *\0A * \5Cparam pake_type     The type of the primitive\0A *                      (value of type ::psa_pake_primitive_type_t).\0A * \5Cparam pake_family   The family of the primitive\0A *                      (the type and interpretation of this parameter depends\0A *                      on \5Cp pake_type, for more information consult the\0A *                      documentation of individual ::psa_pake_primitive_type_t\0A *                      constants).\0A * \5Cparam pake_bits     The bit-size of the primitive\0A *                      (Value of type \5Cc size_t. The interpretation\0A *                      of this parameter depends on \5Cp pake_family, for more\0A *                      information consult the documentation of individual\0A *                      ::psa_pake_primitive_type_t constants).\0A *\0A * \5Creturn The constructed primitive value of type ::psa_pake_primitive_t.\0A *         Return 0 if the requested primitive can't be encoded as\0A *         ::psa_pake_primitive_t.\0A */\0A#define PSA_PAKE_PRIMITIVE(pake_type, pake_family, pake_bits) \5C\0A    ((pake_bits & 0xFFFF) != pake_bits) ? 0 :                 \5C\0A    ((psa_pake_primitive_t) (((pake_type) << 24 |             \5C\0A                              (pake_family) << 16) | (pake_bits)))\0A\0A/** The key share being sent to or received from the peer.\0A *\0A * The format for both input and output at this step is the same as for public\0A * keys on the group determined by the primitive (::psa_pake_primitive_t) would\0A * be.\0A *\0A * For more information on the format, consult the documentation of\0A * psa_export_public_key().\0A *\0A * For information regarding how the group is determined, consult the\0A * documentation #PSA_PAKE_PRIMITIVE.\0A */\0A#define PSA_PAKE_STEP_KEY_SHARE                 ((psa_pake_step_t) 0x01)\0A\0A/** A Schnorr NIZKP public key.\0A *\0A * This is the ephemeral public key in the Schnorr Non-Interactive\0A * Zero-Knowledge Proof (the value denoted by the letter 'V' in RFC 8235).\0A *\0A * The format for both input and output at this step is the same as for public\0A * keys on the group determined by the primitive (::psa_pake_primitive_t) would\0A * be.\0A *\0A * For more information on the format, consult the documentation of\0A * psa_export_public_key().\0A *\0A * For information regarding how the group is determined, consult the\0A * documentation #PSA_PAKE_PRIMITIVE.\0A */\0A#define PSA_PAKE_STEP_ZK_PUBLIC                 ((psa_pake_step_t) 0x02)\0A\0A/** A Schnorr NIZKP proof.\0A *\0A * This is the proof in the Schnorr Non-Interactive Zero-Knowledge Proof (the\0A * value denoted by the letter 'r' in RFC 8235).\0A *\0A * Both for input and output, the value at this step is an integer less than\0A * the order of the group selected in the cipher suite. The format depends on\0A * the group as well:\0A *\0A * - For Montgomery curves, the encoding is little endian.\0A * - For everything else the encoding is big endian (see Section 2.3.8 of\0A *   _SEC 1: Elliptic Curve Cryptography_ at https://www.secg.org/sec1-v2.pdf).\0A *\0A * In both cases leading zeroes are allowed as long as the length in bytes does\0A * not exceed the byte length of the group order.\0A *\0A * For information regarding how the group is determined, consult the\0A * documentation #PSA_PAKE_PRIMITIVE.\0A */\0A#define PSA_PAKE_STEP_ZK_PROOF                  ((psa_pake_step_t) 0x03)\0A\0A/** The type of the data structure for PAKE cipher suites.\0A *\0A * This is an implementation-defined \5Cc struct. Applications should not\0A * make any assumptions about the content of this structure.\0A * Implementation details can change in future versions without notice.\0A */\0Atypedef struct psa_pake_cipher_suite_s psa_pake_cipher_suite_t;\0A\0A/** Return an initial value for a PAKE cipher suite object.\0A */\0Astatic psa_pake_cipher_suite_t psa_pake_cipher_suite_init(void);\0A\0A/** Retrieve the PAKE algorithm from a PAKE cipher suite.\0A *\0A * \5Cparam[in] cipher_suite     The cipher suite structure to query.\0A *\0A * \5Creturn The PAKE algorithm stored in the cipher suite structure.\0A */\0Astatic psa_algorithm_t psa_pake_cs_get_algorithm(\0A    const psa_pake_cipher_suite_t *cipher_suite);\0A\0A/** Declare the PAKE algorithm for the cipher suite.\0A *\0A * This function overwrites any PAKE algorithm\0A * previously set in \5Cp cipher_suite.\0A *\0A * \5Cparam[out] cipher_suite    The cipher suite structure to write to.\0A * \5Cparam algorithm            The PAKE algorithm to write.\0A *                             (`PSA_ALG_XXX` values of type ::psa_algorithm_t\0A *                             such that #PSA_ALG_IS_PAKE(\5Cc alg) is true.)\0A *                             If this is 0, the PAKE algorithm in\0A *                             \5Cp cipher_suite becomes unspecified.\0A */\0Astatic void psa_pake_cs_set_algorithm(psa_pake_cipher_suite_t *cipher_suite,\0A                                      psa_algorithm_t algorithm);\0A\0A/** Retrieve the primitive from a PAKE cipher suite.\0A *\0A * \5Cparam[in] cipher_suite     The cipher suite structure to query.\0A *\0A * \5Creturn The primitive stored in the cipher suite structure.\0A */\0Astatic psa_pake_primitive_t psa_pake_cs_get_primitive(\0A    const psa_pake_cipher_suite_t *cipher_suite);\0A\0A/** Declare the primitive for a PAKE cipher suite.\0A *\0A * This function overwrites any primitive previously set in \5Cp cipher_suite.\0A *\0A * \5Cparam[out] cipher_suite    The cipher suite structure to write to.\0A * \5Cparam primitive            The primitive to write. If this is 0, the\0A *                             primitive type in \5Cp cipher_suite becomes\0A *                             unspecified.\0A */\0Astatic void psa_pake_cs_set_primitive(psa_pake_cipher_suite_t *cipher_suite,\0A                                      psa_pake_primitive_t primitive);\0A\0A/** Retrieve the PAKE family from a PAKE cipher suite.\0A *\0A * \5Cparam[in] cipher_suite     The cipher suite structure to query.\0A *\0A * \5Creturn The PAKE family stored in the cipher suite structure.\0A */\0Astatic psa_pake_family_t psa_pake_cs_get_family(\0A    const psa_pake_cipher_suite_t *cipher_suite);\0A\0A/** Retrieve the PAKE primitive bit-size from a PAKE cipher suite.\0A *\0A * \5Cparam[in] cipher_suite     The cipher suite structure to query.\0A *\0A * \5Creturn The PAKE primitive bit-size stored in the cipher suite structure.\0A */\0Astatic uint16_t psa_pake_cs_get_bits(\0A    const psa_pake_cipher_suite_t *cipher_suite);\0A\0A/** Retrieve the hash algorithm from a PAKE cipher suite.\0A *\0A * \5Cparam[in] cipher_suite      The cipher suite structure to query.\0A *\0A * \5Creturn The hash algorithm stored in the cipher suite structure. The return\0A *         value is 0 if the PAKE is not parametrised by a hash algorithm or if\0A *         the hash algorithm is not set.\0A */\0Astatic psa_algorithm_t psa_pake_cs_get_hash(\0A    const psa_pake_cipher_suite_t *cipher_suite);\0A\0A/** Declare the hash algorithm for a PAKE cipher suite.\0A *\0A * This function overwrites any hash algorithm\0A * previously set in \5Cp cipher_suite.\0A *\0A * Refer to the documentation of individual PAKE algorithm types (`PSA_ALG_XXX`\0A * values of type ::psa_algorithm_t such that #PSA_ALG_IS_PAKE(\5Cc alg) is true)\0A * for more information.\0A *\0A * \5Cparam[out] cipher_suite     The cipher suite structure to write to.\0A * \5Cparam hash                  The hash involved in the cipher suite.\0A *                              (`PSA_ALG_XXX` values of type ::psa_algorithm_t\0A *                              such that #PSA_ALG_IS_HASH(\5Cc alg) is true.)\0A *                              If this is 0, the hash algorithm in\0A *                              \5Cp cipher_suite becomes unspecified.\0A */\0Astatic void psa_pake_cs_set_hash(psa_pake_cipher_suite_t *cipher_suite,\0A                                 psa_algorithm_t hash);\0A\0A/** The type of the state data structure for PAKE operations.\0A *\0A * Before calling any function on a PAKE operation object, the application\0A * must initialize it by any of the following means:\0A * - Set the structure to all-bits-zero, for example:\0A *   \5Ccode\0A *   psa_pake_operation_t operation;\0A *   memset(&operation, 0, sizeof(operation));\0A *   \5Cendcode\0A * - Initialize the structure to logical zero values, for example:\0A *   \5Ccode\0A *   psa_pake_operation_t operation = {0};\0A *   \5Cendcode\0A * - Initialize the structure to the initializer #PSA_PAKE_OPERATION_INIT,\0A *   for example:\0A *   \5Ccode\0A *   psa_pake_operation_t operation = PSA_PAKE_OPERATION_INIT;\0A *   \5Cendcode\0A * - Assign the result of the function psa_pake_operation_init()\0A *   to the structure, for example:\0A *   \5Ccode\0A *   psa_pake_operation_t operation;\0A *   operation = psa_pake_operation_init();\0A *   \5Cendcode\0A *\0A * This is an implementation-defined \5Cc struct. Applications should not\0A * make any assumptions about the content of this structure.\0A * Implementation details can change in future versions without notice. */\0Atypedef struct psa_pake_operation_s psa_pake_operation_t;\0A\0A/** The type of input values for PAKE operations. */\0Atypedef struct psa_crypto_driver_pake_inputs_s psa_crypto_driver_pake_inputs_t;\0A\0A/** The type of computation stage for J-PAKE operations. */\0Atypedef struct psa_jpake_computation_stage_s psa_jpake_computation_stage_t;\0A\0A/** Return an initial value for a PAKE operation object.\0A */\0Astatic psa_pake_operation_t psa_pake_operation_init(void);\0A\0A/** Get the length of the password in bytes from given inputs.\0A *\0A * \5Cparam[in]  inputs           Operation inputs.\0A * \5Cparam[out] password_len     Password length.\0A *\0A * \5Cretval #PSA_SUCCESS\0A *         Success.\0A * \5Cretval #PSA_ERROR_BAD_STATE\0A *         Password hasn't been set yet.\0A */\0Apsa_status_t psa_crypto_driver_pake_get_password_len(\0A    const psa_crypto_driver_pake_inputs_t *inputs,\0A    size_t *password_len);\0A\0A/** Get the password from given inputs.\0A *\0A * \5Cparam[in]  inputs           Operation inputs.\0A * \5Cparam[out] buffer           Return buffer for password.\0A * \5Cparam      buffer_size      Size of the return buffer in bytes.\0A * \5Cparam[out] buffer_length    Actual size of the password in bytes.\0A *\0A * \5Cretval #PSA_SUCCESS\0A *         Success.\0A * \5Cretval #PSA_ERROR_BAD_STATE\0A *         Password hasn't been set yet.\0A */\0Apsa_status_t psa_crypto_driver_pake_get_password(\0A    const psa_crypto_driver_pake_inputs_t *inputs,\0A    uint8_t *buffer, size_t buffer_size, size_t *buffer_length);\0A\0A/** Get the length of the user id in bytes from given inputs.\0A *\0A * \5Cparam[in]  inputs           Operation inputs.\0A * \5Cparam[out] user_len         User id length.\0A *\0A * \5Cretval #PSA_SUCCESS\0A *         Success.\0A * \5Cretval #PSA_ERROR_BAD_STATE\0A *         User id hasn't been set yet.\0A */\0Apsa_status_t psa_crypto_driver_pake_get_user_len(\0A    const psa_crypto_driver_pake_inputs_t *inputs,\0A    size_t *user_len);\0A\0A/** Get the length of the peer id in bytes from given inputs.\0A *\0A * \5Cparam[in]  inputs           Operation inputs.\0A * \5Cparam[out] peer_len         Peer id length.\0A *\0A * \5Cretval #PSA_SUCCESS\0A *         Success.\