ls_mutex_lock(\0A                              &mbedtls_threading_key_slot_mutex));\0A#endif\0A    status = psa_get_and_lock_key_slot_in_memory(key, &slot);\0A    if (status != PSA_SUCCESS) {\0A#if defined(MBEDTLS_THREADING_C)\0A        PSA_THREADING_CHK_RET(mbedtls_mutex_unlock(\0A                                  &mbedtls_threading_key_slot_mutex));\0A#endif\0A        return status;\0A    }\0A\0A    if ((!PSA_KEY_LIFETIME_IS_VOLATILE(slot->attr.lifetime)) &&\0A        (slot->var.occupied.registered_readers == 1)) {\0A        status = psa_wipe_key_slot(slot);\0A    } else {\0A        status = psa_unregister_read(slot);\0A    }\0A#if defined(MBEDTLS_THREADING_C)\0A    PSA_THREADING_CHK_RET(mbedtls_mutex_unlock(\0A                              &mbedtls_threading_key_slot_mutex));\0A#endif\0A\0A    return status;\0A}\0A\0Avoid mbedtls_psa_get_stats(mbedtls_psa_stats_t *stats)\0A{\0A    memset(stats, 0, sizeof(*stats));\0A\0A    for (size_t slice_idx = 0; slice_idx < KEY_SLICE_COUNT; slice_idx++) {\0A#if defined(MBEDTLS_PSA_KEY_STORE_DYNAMIC)\0A        if (global_data.key_slices[slice_idx] == NULL) {\0A            continue;\0A        }\0A#endif  /* MBEDTLS_PSA_KEY_STORE_DYNAMIC */\0A        for (size_t slot_idx = 0; slot_idx < key_slice_length(slice_idx); slot_idx++) {\0A            const psa_key_slot_t *slot = get_key_slot(slice_idx, slot_idx);\0A            if (slot->state == PSA_SLOT_EMPTY) {\0A                ++stats->empty_slots;\0A                continue;\0A            }\0A            if (psa_key_slot_has_readers(slot)) {\0A                ++stats->locked_slots;\0A            }\0A            if (PSA_KEY_LIFETIME_IS_VOLATILE(slot->attr.lifetime)) {\0A                ++stats->volatile_slots;\0A            } else {\0A                psa_key_id_t id = MBEDTLS_SVC_KEY_ID_GET_KEY_ID(slot->attr.id);\0A                ++stats->persistent_slots;\0A                if (id > stats->max_open_internal_key_id) {\0A                    stats->max_open_internal_key_id = id;\0A                }\0A            }\0A            if (PSA_KEY_LIFETIME_GET_LOCATION(slot->attr.lifetime) !=\0A                PSA_KEY_LOCATION_LOCAL_STORAGE) {\0A                psa_key_id_t id = MBEDTLS_SVC_KEY_ID_GET_KEY_ID(slot->attr.id);\0A                ++stats->external_slots;\0A                if (id > stats->max_open_external_key_id) {\0A                    stats->max_open_external_key_id = id;\0A                }\0A            }\0A        }\0A    }\0A}\0A\0A#endif /* MBEDTLS_PSA_CRYPTO_C */\0A\00" }
