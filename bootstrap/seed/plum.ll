rrent datagram.\0A     */\0A\0A#if defined(MBEDTLS_SSL_PROTO_DTLS)\0A    if (ssl->conf->transport == MBEDTLS_SSL_TRANSPORT_DATAGRAM &&\0A        ssl->in_left > ssl->next_record_offset) {\0A        MBEDTLS_SSL_DEBUG_MSG(3, (\22ssl_check_pending: more records within current datagram\22));\0A        return 1;\0A    }\0A#endif /* MBEDTLS_SSL_PROTO_DTLS */\0A\0A    /*\0A     * Case C: A handshake message is being processed.\0A     */\0A\0A    if (ssl->in_hslen > 0 && ssl->in_hslen < ssl->in_msglen) {\0A        MBEDTLS_SSL_DEBUG_MSG(3,\0A                              (\22ssl_check_pending: more handshake messages within current record\22));\0A        return 1;\0A    }\0A\0A    /*\0A     * Case D: An application data message is being processed\0A     */\0A    if (ssl->in_offt != NULL) {\0A        MBEDTLS_SSL_DEBUG_MSG(3, (\22ssl_check_pending: application data record is being processed\22));\0A        return 1;\0A    }\0A\0A    /*\0A     * In all other cases, the rest of the message can be dropped.\0A     * As in ssl_get_next_record, this needs to be adapted if\0A     * we implement support for multiple alerts in single records.\0A     */\0A\0A    MBEDTLS_SSL_DEBUG_MSG(3, (\22ssl_check_pending: nothing pending\22));\0A    return 0;\0A}\0A\0A\0Aint mbedtls_ssl_get_record_expansion(const mbedtls_ssl_context *ssl)\0A{\0A    size_t transform_expansion = 0;\0A    const mbedtls_ssl_transform *transform = ssl->transform_out;\0A    unsigned block_size;\0A#if defined(MBEDTLS_USE_PSA_CRYPTO)\0A    psa_key_attributes_t attr = PSA_KEY_ATTRIBUTES_INIT;\0A    psa_key_type_t key_type;\0A#endif /* MBEDTLS_USE_PSA_CRYPTO */\0A\0A    size_t out_hdr_len = mbedtls_ssl_out_hdr_len(ssl);\0A\0A    if (transform == NULL) {\0A        return (int) out_hdr_len;\0A    }\0A\0A\0A#if defined(MBEDTLS_USE_PSA_CRYPTO)\0A    if (transform->psa_alg == PSA_ALG_GCM ||\0A        transform->psa_alg == PSA_ALG_CCM ||\0A        transform->psa_alg == PSA_ALG_AEAD_WITH_SHORTENED_TAG(PSA_ALG_CCM, 8) ||\0A        tra