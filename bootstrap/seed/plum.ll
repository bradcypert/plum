     case MBEDTLS_ERR_RSA_PRIVATE_FAILED:\0A            return PSA_ERROR_CORRUPTION_DETECTED;\0A        case MBEDTLS_ERR_RSA_VERIFY_FAILED:\0A            return PSA_ERROR_INVALID_SIGNATURE;\0A        case MBEDTLS_ERR_RSA_OUTPUT_TOO_LARGE:\0A            return PSA_ERROR_BUFFER_TOO_SMALL;\0A        case MBEDTLS_ERR_RSA_RNG_FAILED:\0A            return PSA_ERROR_INSUFFICIENT_ENTROPY;\0A#endif\0A\0A#if defined(MBEDTLS_ECP_LIGHT)\0A        case MBEDTLS_ERR_ECP_BAD_INPUT_DATA:\0A        case MBEDTLS_ERR_ECP_INVALID_KEY:\0A            return PSA_ERROR_INVALID_ARGUMENT;\0A        case MBEDTLS_ERR_ECP_BUFFER_TOO_SMALL:\0A            return PSA_ERROR_BUFFER_TOO_SMALL;\0A        case MBEDTLS_ERR_ECP_FEATURE_UNAVAILABLE:\0A            return PSA_ERROR_NOT_SUPPORTED;\0A        case MBEDTLS_ERR_ECP_SIG_LEN_MISMATCH:\0A        case MBEDTLS_ERR_ECP_VERIFY_FAILED:\0A            return PSA_ERROR_INVALID_SIGNATURE;\0A        case MBEDTLS_ERR_ECP_ALLOC_FAILED:\0A            return PSA_ERROR_INSUFFICIENT_MEMORY;\0A        case MBEDTLS_ERR_ECP_RANDOM_FAILED:\0A            return PSA_ERROR_INSUFFICIENT_ENTROPY;\0A\0A#if defined(MBEDTLS_ECP_RESTARTABLE)\0A        case MBEDTLS_ERR_ECP_IN_PROGRESS:\0A            return PSA_OPERATION_INCOMPLETE;\0A#endif\0A#endif\0A\0A        case MBEDTLS_ERR_ERROR_CORRUPTION_DETECTED:\0A            return PSA_ERROR_CORRUPTION_DETECTED;\0A\0A        default:\0A            return PSA_ERROR_GENERIC_ERROR;\0A    }\0A}\0A\0A/**\0A * \5Cbrief                       For output buffers which contain \22tags\22\0A *                              (outputs that may be checked for validity like\0A *                              hashes, MACs and signatures), fill the unused\0A *                              part of the output buffer (the whole buffer on\0A *                              error, the trailing part on success) with\0A *                              something that isn't a valid tag (barring an\0A *                              attack on the tag and deliberately