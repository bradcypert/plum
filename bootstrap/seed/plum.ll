opy,\0A                          const unsigned char *custom,\0A                          size_t len)\0A{\0A    int ret = MBEDTLS_ERR_ERROR_CORRUPTION_DETECTED;\0A    unsigned char key[MBEDTLS_CTR_DRBG_KEYSIZE];\0A    size_t nonce_len;\0A\0A    memset(key, 0, MBEDTLS_CTR_DRBG_KEYSIZE);\0A\0A    /* The mutex is initialized iff f_entropy is set. */\0A#if defined(MBEDTLS_THREADING_C)\0A    mbedtls_mutex_init(&ctx->mutex);\0A#endif\0A\0A    ctx->f_entropy = f_entropy;\0A    ctx->p_entropy = p_entropy;\0A\0A    if (ctx->entropy_len == 0) {\0A        ctx->entropy_len = MBEDTLS_CTR_DRBG_ENTROPY_LEN;\0A    }\0A    /* ctx->reseed_counter contains the desired amount of entropy to\0A     * grab for a nonce (see mbedtls_ctr_drbg_set_nonce_len()).\0A     * If it's -1, indicating that the entropy nonce length was not set\0A     * explicitly, use a sufficiently large nonce for security. */\0A    nonce_len = (ctx->reseed_counter >= 0 ?\0A                 (size_t) ctx->reseed_counter :\0A                 good_nonce_len(ctx->entropy_len));\0A\0A    /* Initialize with an empty key. */\0A#if defined(MBEDTLS_CTR_DRBG_USE_PSA_CRYPTO)\0A    psa_status_t status;\0A\0A    status = ctr_drbg_setup_psa_context(&ctx->psa_ctx, key, MBEDTLS_CTR_DRBG_KEYSIZE);\0A    if (status != PSA_SUCCESS) {\0A        ret = psa_generic_status_to_mbedtls(status);\0A        return status;\0A    }\0A#else\0A    if ((ret = mbedtls_aes_setkey_enc(&ctx->aes_ctx, key,\0A                                      MBEDTLS_CTR_DRBG_KEYBITS)) != 0) {\0A        return ret;\0A    }\0A#endif\0A\0A    /* Do the initial seeding. */\0A    if ((ret = mbedtls_ctr_drbg_reseed_internal(ctx, custom, len,\0A                                                nonce_len)) != 0) {\0A        return ret;\0A    }\0A    return 0;\0A}\0A\0A/* CTR_DRBG_Generate with derivation function (SP 800-90A &sect;10.2.1.5.2)\0A * mbedtls_ctr_drbg_random_with_add(ctx, output, output_len, additional, add_len)\0A * implements\0A * CTR_DRBG_Reseed(working_state, en