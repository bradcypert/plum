@.str45977 = private global { i64, i64, [7322 x i8] } { i64 -1, i64 7321, [7322 x i8] c"/*\0A *  PSA ITS simulator over stdio files.\0A */\0A/*\0A *  Copyright The Mbed TLS Contributors\0A *  SPDX-License-Identifier: Apache-2.0 OR GPL-2.0-or-later\0A */\0A\0A#include \22common.h\22\0A\0A#if defined(MBEDTLS_PSA_ITS_FILE_C)\0A\0A#include \22mbedtls/platform.h\22\0A\0A#if defined(_WIN32)\0A#include <windows.h>\0A#endif\0A\0A#include \22psa_crypto_its.h\22\0A\0A#include <limits.h>\0A#include <stdint.h>\0A#include <stdio.h>\0A#include <string.h>\0A\0A#if !defined(PSA_ITS_STORAGE_PREFIX)\0A#define PSA_ITS_STORAGE_PREFIX \22\22\0A#endif\0A\0A#define PSA_ITS_STORAGE_FILENAME_PATTERN \22%08x%08x\22\0A#define PSA_ITS_STORAGE_SUFFIX \22.psa_its\22\0A#define PSA_ITS_STORAGE_FILENAME_LENGTH         \5C\0A    (sizeof(PSA_ITS_STORAGE_PREFIX) - 1 +    /*prefix without terminating 0*/ \5C\0A     16 +  /*UID (64-bit number in hex)*/                               \5C\0A     sizeof(PSA_ITS_STORAGE_SUFFIX) - 1 +    /*suffix without terminating 0*/ \5C\0A     1 /*terminating null byte*/)\0A#define PSA_ITS_STORAGE_TEMP \5C\0A    PSA_ITS_STORAGE_PREFIX \22tempfile\22 PSA_ITS_STORAGE_SUFFIX\0A\0A/* The maximum value of psa_storage_info_t.size */\0A#define PSA_ITS_MAX_SIZE 0xffffffff\0A\0A#define PSA_ITS_MAGIC_STRING \22PSA\5C0ITS\5C0\22\0A#define PSA_ITS_MAGIC_LENGTH 8\0A\0A/* As rename fails on Windows if the new filepath already exists,\0A * use MoveFileExA with the MOVEFILE_REPLACE_EXISTING flag instead.\0A * Returns 0 on success, nonzero on failure. */\0A#if defined(_WIN32)\0A#define rename_replace_existing(oldpath, newpath) \5C\0A    (!MoveFileExA(oldpath, newpath, MOVEFILE_REPLACE_EXISTING))\0A#else\0A#define rename_replace_existing(oldpath, newpath) rename(oldpath, newpath)\0A#endif\0A\0Atypedef struct {\0A    uint8_t magic[PSA_ITS_MAGIC_LENGTH];\0A    uint8_t size[sizeof(uint32_t)];\0A    uint8_t flags[sizeof(psa_storage_create_flags_t)];\0A} psa_its_file_header_t;\0A\0Astatic void psa_its_fill_filename(psa_storage_uid_t uid, char *filename)\0A{\0A    /* Break up the UID into two 32-bit pieces so as not to rely on\0A     * long long support in snprintf. */\0A    mbedtls_snprintf(filename, PSA_ITS_STORAGE_FILENAME_LENGTH,\0A                     \22%s\22 PSA_ITS_STORAGE_FILENAME_PATTERN \22%s\22,\0A                     PSA_ITS_STORAGE_PREFIX,\0A                     (unsigned) (uid >> 32),\0A                     (unsigned) (uid & 0xffffffff),\0A                     PSA_ITS_STORAGE_SUFFIX);\0A}\0A\0Astatic psa_status_t psa_its_read_file(psa_storage_uid_t uid,\0A                                      struct psa_storage_info_t *p_info,\0A                                      FILE **p_stream)\0A{\0A    char filename[PSA_ITS_STORAGE_FILENAME_LENGTH];\0A    psa_its_file_header_t header;\0A    size_t n;\0A\0A    *p_stream = NULL;\0A    psa_its_fill_filename(uid, filename);\0A    *p_stream = fopen(filename, \22rb\22);\0A    if (*p_stream == NULL) {\0A        return PSA_ERROR_DOES_NOT_EXIST;\0A    }\0A\0A    /* Ensure no stdio buffering of secrets, as such buffers cannot be wiped. */\0A    mbedtls_setbuf(*p_stream, NULL);\0A\0A    n = fread(&header, 1, sizeof(header), *p_stream);\0A    if (n != sizeof(header)) {\0A        return PSA_ERROR_DATA_CORRUPT;\0A    }\0A    if (memcmp(header.magic, PSA_ITS_MAGIC_STRING,\0A               PSA_ITS_MAGIC_LENGTH) != 0) {\0A        return PSA_ERROR_DATA_CORRUPT;\0A    }\0A\0A    p_info->size  = MBEDTLS_GET_UINT32_LE(header.size, 0);\0A    p_info->flags = MBEDTLS_GET_UINT32_LE(header.flags, 0);\0A\0A    return PSA_SUCCESS;\0A}\0A\0Apsa_status_t psa_its_get_info(psa_storage_uid_t uid,\0A                              struct psa_storage_info_t *p_info)\0A{\0A    psa_status_t status;\0A    FILE *stream = NULL;\0A    status = psa_its_read_file(uid, p_info, &stream);\0A    if (stream != NULL) {\0A        fclose(stream);\0A    }\0A    return status;\0A}\0A\0Apsa_status_t psa_its_get(psa_storage_uid_t uid,\0A                         uint32_t data_offset,\0A                         uint32_t data_length,\0A                         void *p_data,\0A                         size_t *p_data_length)\0A{\0A    psa_status_t status;\0A    FILE *stream = NULL;\0A    size_t n;\0A    struct psa_storage_info_t info;\0A\0A    status = psa_its_read_file(uid, &info, &stream);\0A    if (status != PSA_SUCCESS) {\0A        goto exit;\0A    }\0A    status = PSA_ERROR_INVALID_ARGUMENT;\0A    if (data_offset + data_length < data_offset) {\0A        goto exit;\0A    }\0A#if SIZE_MAX < 0xffffffff\0A    if (data_offset + data_length > SIZE_MAX) {\0A        goto exit;\0A    }\0A#endif\0A    if (data_offset + data_length > info.size) {\0A        goto exit;\0A    }\0A\0A    status = PSA_ERROR_STORAGE_FAILURE;\0A#if LONG_MAX < 0xffffffff\0A    while (data_offset > LONG_MAX) {\0A        if (fseek(stream, LONG_MAX, SEEK_CUR) != 0) {\0A            goto exit;\0A        }\0A        data_offset -= LONG_MAX;\0A    }\0A#endif\0A    if (fseek(stream, data_offset, SEEK_CUR) != 0) {\0A        goto exit;\0A    }\0A    n = fread(p_data, 1, data_length, stream);\0A    if (n != data_length) {\0A        goto exit;\0A    }\0A    status = PSA_SUCCESS;\0A    if (p_data_length != NULL) {\0A        *p_data_length = n;\0A    }\0A\0Aexit:\0A    if (stream != NULL) {\0A        fclose(stream);\0A    }\0A    return status;\0A}\0A\0Apsa_status_t psa_its_set(psa_storage_uid_t uid,\0A                         uint32_t data_length,\0A                         const void *p_data,\0A                         psa_storage_create_flags_t create_flags)\0A{\0A    if (uid == 0) {\0A        return PSA_ERROR_INVALID_HANDLE;\0A    }\0A\0A    psa_status_t status = PSA_ERROR_STORAGE_FAILURE;\0A    char filename[PSA_ITS_STORAGE_FILENAME_LENGTH];\0A    FILE *stream = NULL;\0A    psa_its_file_header_t header;\0A    size_t n;\0A\0A    memcpy(header.magic, PSA_ITS_MAGIC_STRING, PSA_ITS_MAGIC_LENGTH);\0A    MBEDTLS_PUT_UINT32_LE(data_length, header.size, 0);\0A    MBEDTLS_PUT_UINT32_LE(create_flags, header.flags, 0);\0A\0A    psa_its_fill_filename(uid, filename);\0A    stream = fopen(PSA_ITS_STORAGE_TEMP, \22wb\22);\0A\0A    if (stream == NULL) {\0A        goto exit;\0A    }\0A\0A    /* Ensure no stdio buffering of secrets, as such buffers cannot be wiped. */\0A    mbedtls_setbuf(stream, NULL);\0A\0A    status = PSA_ERROR_INSUFFICIENT_STORAGE;\0A    n = fwrite(&header, 1, sizeof(header), stream);\0A    if (n != sizeof(header)) {\0A        goto exit;\0A    }\0A    if (data_length != 0) {\0A        n = fwrite(p_data, 1, data_length, stream);\0A        if (n != data_length) {\0A            goto exit;\0A        }\0A    }\0A    status = PSA_SUCCESS;\0A\0Aexit:\0A    if (stream != NULL) {\0A        int ret = fclose(stream);\0A        if (status == PSA_SUCCESS && ret != 0) {\0A            status = PSA_ERROR_INSUFFICIENT_STORAGE;\0A        }\0A    }\0A    if (status == PSA_SUCCESS) {\0A        if (rename_replace_existing(PSA_ITS_STORAGE_TEMP, filename) != 0) {\0A            status = PSA_ERROR_STORAGE_FAILURE;\0A        }\0A    }\0A    /* The temporary file may still exist, but only in failure cases where\0A     * we're already reporting an error. So there's nothing we can do on\0A     * failure. If the function succeeded, and in some error cases, the\0A     * temporary file doesn't exist and so remove() is expected to fail.\0A     * Thus we just ignore the return status of remove(). */\0A    (void) remove(PSA_ITS_STORAGE_TEMP);\0A    return status;\0A}\0A\0Apsa_status_t psa_its_remove(psa_storage_uid_t uid)\0A{\0A    char filename[PSA_ITS_STORAGE_FILENAME_LENGTH];\0A    FILE *stream;\0A    psa_its_fill_filename(uid, filename);\0A    stream = fopen(filename, \22rb\22);\0A    if (stream == NULL) {\0A        return PSA_ERROR_DOES_NOT_EXIST;\0A    }\0A    fclose(stream);\0A    if (remove(filename) != 0) {\0A        return PSA_ERROR_STORAGE_FAILURE;\0A    }\0A    return PSA_SUCCESS;\0A}\0A\0A#endif /* MBEDTLS_PSA_ITS_FILE_C */\0A\00" }
