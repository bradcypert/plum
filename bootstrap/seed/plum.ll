MBEDTLS_ERR_NET_POLL_FAILED;\0A    }\0A#endif\0A\0A    return 0;\0A}\0A\0A/*\0A * Initialize a context\0A */\0Avoid mbedtls_net_init(mbedtls_net_context *ctx)\0A{\0A    ctx->fd = -1;\0A}\0A\0A/*\0A * Initiate a TCP connection with host:port and the given protocol\0A */\0Aint mbedtls_net_connect(mbedtls_net_context *ctx, const char *host,\0A                        const char *port, int proto)\0A{\0A    int ret = MBEDTLS_ERR_ERROR_CORRUPTION_DETECTED;\0A    struct addrinfo hints, *addr_list, *cur;\0A\0A    if ((ret = net_prepare()) != 0) {\0A        return ret;\0A    }\0A\0A    /* Do name resolution with both IPv6 and IPv4 */\0A    memset(&hints, 0, sizeof(hints));\0A    hints.ai_family = AF_UNSPEC;\0A    hints.ai_socktype = proto == MBEDTLS_NET_PROTO_UDP ? SOCK_DGRAM : SOCK_STREAM;\0A    hints.ai_protocol = proto == MBEDTLS_NET_PROTO_UDP ? IPPROTO_UDP : IPPROTO_TCP;\0A\0A    if (getaddrinfo(host, port, &hints, &addr_list) != 0) {\0A        return MBEDTLS_ERR_NET_UNKNOWN_HOST;\0A    }\0A\0A    /* Try the sockaddrs until a connection succeeds */\0A    ret = MBEDTLS_ERR_NET_UNKNOWN_HOST;\0A    for (cur = addr_list; cur != NULL; cur = cur->ai_next) {\0A        ctx->fd = (int) socket(cur->ai_family, cur->ai_socktype,\0A                               cur->ai_protocol);\0A        if (ctx->fd < 0) {\0A            ret = MBEDTLS_ERR_NET_SOCKET_FAILED;\0A            continue;\0A        }\0A\0A        if (connect(ctx->fd, cur->ai_addr, MSVC_INT_CAST cur->ai_addrlen) == 0) {\0A            ret = 0;\0A            break;\0A        }\0A\0A        mbedtls_net_close(ctx);\0A        ret = MBEDTLS_ERR_NET_CONNECT_FAILED;\0A    }\0A\0A    freeaddrinfo(addr_list);\0A\0A    return ret;\0A}\0A\0A/*\0A * Create a listening socket on bind_ip:port\0A */\0Aint mbedtls_net_bind(mbedtls_net_context *ctx, const char *bind_ip, const char *port, int proto)\0A{\0A    int n, ret;\0A    struct addrinfo hints, *addr_list, *cur;\0A\0A    if ((ret = net_prepare()) != 0) {\0A        return ret;\0A    }\0A\0