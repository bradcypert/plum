@.str40946 = private global { i64, i64, [444 x i8] } { i64 -1, i64 443, [444 x i8] c"/**\0A *  TLS 1.2 and 1.3 client-side functions\0A *\0A *  Copyright The Mbed TLS Contributors\0A *  SPDX-License-Identifier: Apache-2.0 OR GPL-2.0-or-later\0A */\0A\0A#ifndef MBEDTLS_SSL_CLIENT_H\0A#define MBEDTLS_SSL_CLIENT_H\0A\0A#include \22common.h\22\0A\0A#if defined(MBEDTLS_SSL_TLS_C)\0A#include \22ssl_misc.h\22\0A#endif\0A\0A#include <stddef.h>\0A\0AMBEDTLS_CHECK_RETURN_CRITICAL\0Aint mbedtls_ssl_write_client_hello(mbedtls_ssl_context *ssl);\0A\0A#endif /* MBEDTLS_SSL_CLIENT_H */\0A\00" }
