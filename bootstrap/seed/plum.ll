e_srtp extension\0A     */\0A    mbedtls_dtls_srtp_info MBEDTLS_PRIVATE(dtls_srtp_info);\0A#endif /* MBEDTLS_SSL_DTLS_SRTP */\0A\0A    /*\0A     * Information for DTLS hello verify\0A     */\0A#if defined(MBEDTLS_SSL_DTLS_HELLO_VERIFY) && defined(MBEDTLS_SSL_SRV_C)\0A    unsigned char  *MBEDTLS_PRIVATE(cli_id);         /*!<  transport-level ID of the client  */\0A    size_t          MBEDTLS_PRIVATE(cli_id_len);     /*!<  length of cli_id                  */\0A#endif /* MBEDTLS_SSL_DTLS_HELLO_VERIFY && MBEDTLS_SSL_SRV_C */\0A\0A    /*\0A     * Secure renegotiation\0A     */\0A    /* needed to know when to send extension on server */\0A    int MBEDTLS_PRIVATE(secure_renegotiation);           /*!<  does peer support legacy or\0A                                                            secure renegotiation           */\0A#if defined(MBEDTLS_SSL_RENEGOTIATION)\0A    size_t MBEDTLS_PRIVATE(verify_data_len);             /*!<  length of verify data stored   */\0A    char MBEDTLS_PRIVATE(own_verify_data)[MBEDTLS_SSL_VERIFY_DATA_MAX_LEN]; /*!<  previous handshake verify data */\0A    char MBEDTLS_PRIVATE(peer_verify_data)[MBEDTLS_SSL_VERIFY_DATA_MAX_LEN]; /*!<  previous handshake verify data */\0A#endif /* MBEDTLS_SSL_RENEGOTIATION */\0A\0A#if defined(MBEDTLS_SSL_DTLS_CONNECTION_ID)\0A    /* CID configuration to use in subsequent handshakes. */\0A\0A    /*! The next incoming CID, chosen by the user and applying to\0A     *  all subsequent handshakes. This may be different from the\0A     *  CID currently used in case the user has re-configured the CID\0A     *  after an initial handshake. */\0A    unsigned char MBEDTLS_PRIVATE(own_cid)[MBEDTLS_SSL_CID_IN_LEN_MAX];\0A    uint8_t MBEDTLS_PRIVATE(own_cid_len);   /*!< The length of \5Cc own_cid. */\0A    uint8_t MBEDTLS_PRIVATE(negotiate_cid); /*!< This indicates whether the CID extension should\0A                                             *   be negotiated in the next handshake or not.\0A                                             *   Possible values are #MBEDTLS_SSL_CID_ENABLED\0A                                             *   and #MBEDTLS_SSL_CID_DISABLED. */\0A#endif /* MBEDTLS_SSL_DTLS_CONNECTION_ID */\0A\0A    /** Callback to export key block and master secret                      */\0A    mbedtls_ssl_export_keys_t *MBEDTLS_PRIVATE(f_export_keys);\0A    void *MBEDTLS_PRIVATE(p_export_keys);            /*!< context for key export callback    */\0A\0A    /** User data pointer or handle.\0A     *\0A     * The library sets this to \5Cp 0 when creating a context and does not\0A     * access it afterwards.\0A     *\0A     * \5Cwarning Serializing and restoring an SSL context with\0A     *          mbedtls_ssl_context_save() and mbedtls_ssl_context_load()\0A     *          does not currently restore the user data.\0A     */\0A    mbedtls_ssl_user_data_t MBEDTLS_PRIVATE(user_data);\0A};\0A\0A/**\0A * \5Cbrief               Return the name of the ciphersuite associated with the\0A *                      given ID\0A *\0A * \5Cparam ciphersuite_id SSL ciphersuite ID\0A *\0A * \5Creturn              a string containing the ciphersuite name\0A */\0Aconst char *mbedtls_ssl_get_ciphersuite_name(const int ciphersuite_id);\0A\0A/**\0A * \5Cbrief               Return the ID of the ciphersuite associated with the\0A *                      given name\0A *\0A * \5Cparam ciphersuite_name SSL ciphersuite name\0A *\0A * \5Creturn              the ID with the ciphersuite or 0 if not found\0A */\0Aint mbedtls_ssl_get_ciphersuite_id(const char *ciphersuite_name);\0A\0A/**\0A * \5Cbrief          Initialize an SSL context\0A *                 Just makes the context ready for mbedtls_ssl_setup() or\0A *                 mbedtls_ssl_free()\0A *\0A * \5Cparam ssl      SSL context\0A */\0Avoid mbedtls_ssl_init(mbedtls_ssl_context *ssl);\0A\0A/**\0A * \5Cbrief          Set up an SSL context for use\0A *\0A * \5Cnote           No copy of the configuration context is made, it can be\0A *                 shared by many mbedtls_ssl_context structures.\0A *\0A * \5Cwarning        The conf structure will be accessed during the session.\0A *                 It must not be modified or freed as long as the session\0A *                 is active.\0A *\0A * \5Cwarning        This function must be called exactly once per context.\0A *                 Calling mbedtls_ssl_setup again is not supported, even\0A *                 if no session is active.\0A *\0A * \5Cwarning        After setting up a client context, if certificate-based\0A *                 authentication is enabled, you should call\0A *                 mbedtls_ssl_set_hostname() to specifiy the expected\0A *                 name of the server. Without this, in most scenarios,\0A *                 the TLS connection is insecure. See\0A *                 #MBEDTLS_ERR_SSL_CERTIFICATE_VERIFICATION_WITHOUT_HOSTNAME\0A *                 for more information.\0A *\0A * \5Cnote           If #MBEDTLS_USE_PSA_CRYPTO is enabled, the PSA crypto\0A *                 subsystem must have been initialized by calling\0A *                 psa_crypto_init() before calling this function.\0A *\0A * \5Cparam ssl      SSL context\0A * \5Cparam conf     SSL configuration to use\0A *\0A * \5Creturn         0 if successful, or MBEDTLS_ERR_SSL_ALLOC_FAILED if\0A *                 memory allocation failed\0A */\0Aint mbedtls_ssl_setup(mbedtls_ssl_context *ssl,\0A                      const mbedtls_ssl_config *conf);\0A\0A/**\0A * \5Cbrief          Reset an already initialized SSL context for re-use\0A *                 while retaining application-set variables, function\0A *                 pointers and data.\0A *\0A * \5Cparam ssl      SSL context\0A * \5Creturn         0 if successful, or MBEDTLS_ERR_SSL_ALLOC_FAILED or\0A                   MBEDTLS_ERR_SSL_HW_ACCEL_FAILED\0A */\0Aint mbedtls_ssl_session_reset(mbedtls_ssl_context *ssl);\0A\0A/**\0A * \5Cbrief          Set the current endpoint type\0A *\0A * \5Cparam conf     SSL configuration\0A * \5Cparam endpoint must be MBEDTLS_SSL_IS_CLIENT or MBEDTLS_SSL_IS_SERVER\0A */\0Avoid mbedtls_ssl_conf_endpoint(mbedtls_ssl_config *conf, int endpoint);\0A\0A/**\0A * \5Cbrief          Get the current endpoint type\0A *\0A * \5Cparam conf     SSL configuration\0A *\0A * \5Creturn         Endpoint type, either MBEDTLS_SSL_IS_CLIENT\0A *                 or MBEDTLS_SSL_IS_SERVER\0A */\0Astatic inline int mbedtls_ssl_conf_get_endpoint(const mbedtls_ssl_config *conf)\0A{\0A    return conf->MBEDTLS_PRIVATE(endpoint);\0A}\0A\0A/**\0A * \5Cbrief           Set the transport type (TLS or DTLS).\0A *                  Default: TLS\0A *\0A * \5Cnote            For DTLS, you must either provide a recv callback that\0A *                  doesn't block, or one that handles timeouts, see\0A *                  \5Cc mbedtls_ssl_set_bio(). You also need to provide timer\0A *                  callbacks with \5Cc mbedtls_ssl_set_timer_cb().\0A *\0A * \5Cparam conf      SSL configuration\0A * \5Cparam transport transport type:\0A *                  MBEDTLS_SSL_TRANSPORT_STREAM for TLS,\0A *                  MBEDTLS_SSL_TRANSPORT_DATAGRAM for DTLS.\0A */\0Avoid mbedtls_ssl_conf_transport(mbedtls_ssl_config *conf, int transport);\0A\0A/**\0A * \5Cbrief          Set the certificate verification mode\0A *                 Default: NONE on server, REQUIRED on client\0A *\0A * \5Cparam conf     SSL configuration\0A * \5Cparam authmode can be:\0A *\0A *  MBEDTLS_SSL_VERIFY_NONE:      peer certificate is not checked\0A *                        (default on server)\0A *                        (insecure on client)\0A *\0A *  MBEDTLS_SSL_VERIFY_OPTIONAL:  peer certificate is checked, however the\0A *                        handshake continues even if verification failed;\0A *                        mbedtls_ssl_get_verify_result() can be called after the\0A *                        handshake is complete.\0A *\0A *  MBEDTLS_SSL_VERIFY_REQUIRED:  peer *must* present a valid certificate,\0A *                        handshake is aborted if verification failed.\0A *                        (default on client)\0A *\0A * \5Cnote On client, MBEDTLS_SSL_VERIFY_REQUIRED is the recommended mode.\0A * With MBEDTLS_SSL_VERIFY_OPTIONAL, the user needs to call mbedtls_ssl_get_verify_result() at\0A * the right time(s), which may not be obvious, while REQUIRED always perform\0A * the verification as soon as possible. For example, REQUIRED was protecting\0A * against the \22triple handshake\22 attack even before it was found.\0A */\0Avoid mbedtls_ssl_conf_authmode(mbedtls_ssl_config *conf, int authmode);\0A\0A#if defined(MBEDTLS_SSL_EARLY_DATA)\0A/**\0A * \5Cbrief    Set the early data mode\0A *           Default: disabled on server and client\0A *\0A * \5Cparam conf   The SSL configuration to use.\0A * \5Cparam early_data_enabled can be:\0A *\0A *  MBEDTLS_SSL_EARLY_DATA_DISABLED:\0A *  Early data functionality is disabled. This is the default on client and\0A *  server.\0A *\0A *  MBEDTLS_SSL_EARLY_DATA_ENABLED:\0A *  Early data functionality is enabled and may be negotiated in the handshake.\0A *  Application using early data functionality needs to be aware that the\0A *  security properties for early data (also refered to as 0-RTT data) are\0A *  weaker than those for other kinds of TLS data. See the documentation of\0A *  mbedtls_ssl_write_early_data() and mbedtls_ssl_read_early_data() for more\0A *  information.\0A *  When early data functionality is enabled on server and only in that case,\0A *  the call to one of the APIs that trigger or resume an handshake sequence,\0A *  namely mbedtls_ssl_handshake(), mbedtls_ssl_handshake_step(),\0A *  mbedtls_ssl_read() or mbedtls_ssl_write() may return with the error code\0A *  MBEDTLS_ERR_SSL_RECEIVED_EARLY_DATA indicating that some early data have\0A *  been received. To read the early data, call mbedtls_ssl_read_early_data()\0A *  before calling the original function again.\0A */\0Avoid mbedtls_ssl_conf_early_data(mbedtls_ssl_config *conf,\0A                                 int early_data_enabled);\0A\0A#if defined(MBEDTLS_SSL_SRV_C)\0A/**\0A * \5Cbrief Set the maximum amount of 0-RTT data in bytes\0A *        Default:  #MBEDTLS_SSL_MAX_EARLY_DATA_SIZE\0A *\0A *        This function sets the value of the max_early_data_size\0A *        field of the early data indication extension included in\0A *        the NewSessionTicket messages that the server may send.\0A *\0A *        The value defines the maximum amount of 0-RTT data\0A *        in bytes that a client will be allowed to send when using\0A *        one of the tickets defined by the NewSessionTicket messages.\0A *\0A * \5Cnote When resuming a session using a ticket, if the server receives more\0A *       early data than allowed for the ticket, it terminates the connection.\0A *       The maximum amount of 0-RTT data should thus be large enough\0A *       to allow a minimum of early data to be exchanged.\0A *\0A * \5Cparam[in] conf                  The SSL configuration to use.\0A * \5Cparam[in] max_early_data_size   The maximum amount of 0-RTT data.\0A *\0A * \5Cwarning This interface DOES NOT influence/limit the amount of early data\0A *          that can be received through previously created and issued tickets,\0A *          which clients may have stored.\0A */\0Avoid mbedtls_ssl_conf_max_early_data_size(\0A    mbedtls_ssl_config *conf, uint32_t max_early_data_size);\0A#endif /* MBEDTLS_SSL_SRV_C */\0A\0A#endif /* MBEDTLS_SSL_EARLY_DATA */\0A\0A#if defined(MBEDTLS_X509_CRT_PARSE_C)\0A/**\0A * \5Cbrief          Set the verification callback (Optional).\0A *\0A *                 If set, the provided verify callback is called for each\0A *                 certificate in the peer's CRT chain, including the trusted\0A *                 root. For more information, please see the documentation of\0A *                 \5Cc mbedtls_x509_crt_verify().\0A *\0A * \5Cnote           For per context callbacks and contexts, please use\0A *                 mbedtls_ssl_set_verify() instead.\0A *\0A * \5Cparam conf     The SSL configuration to use.\0A * \5Cparam f_vrfy   The verification callback to use during CRT verification.\0A * \5Cparam p_vrfy   The opaque context to be passed to the callback.\0A */\0Avoid mbedtls_ssl_conf_verify(mbedtls_ssl_config *conf,\0A                             int (*f_vrfy)(void *, mbedtls_x509_crt *, int, uint32_t *),\0A                             void *p_vrfy);\0A#endif /* MBEDTLS_X509_CRT_PARSE_C */\0A\0A/**\0A * \5Cbrief          Set the random number generator callback\0A *\0A * \5Cparam conf     SSL configuration\0A * \5Cparam f_rng    RNG function (mandatory)\0A * \5Cparam p_rng    RNG parameter\0A */\0Avoid mbedtls_ssl_conf_rng(mbedtls_ssl_config *conf,\0A                          int (*f_rng)(void *, unsigned char *, size_t),\0A                          void *p_rng);\0A\0A/**\0A * \5Cbrief          Set the debug callback\0A *\0A *                 The callback has the following argument:\0A *                 void *           opaque context for the callback\0A *                 int              debug level\0A *                 const char *     file name\0A *                 int              line number\0A *                 const char *     message\0A *\0A * \5Cparam conf     SSL configuration\0A * \5Cparam f_dbg    debug function\0A * \5Cparam p_dbg    debug parameter\0A */\0Avoid mbedtls_ssl_conf_dbg(mbedtls_ssl_config *conf,\0A                          void (*f_dbg)(void *, int, const char *, int, const char *),\0A                          void  *p_dbg);\0A\0A/**\0A * \5Cbrief          Return the SSL configuration structure associated\0A *                 with the given SSL context.\0A *\0A * \5Cnote           The pointer returned by this function is guaranteed to\0A *                 remain valid until the context is freed.\0A *\0A * \5Cparam ssl      The SSL context to query.\0A * \5Creturn         Pointer to the SSL configuration associated with \5Cp ssl.\0A */\0Astatic inline const mbedtls_ssl_config *mbedtls_ssl_context_get_config(\0A    const mbedtls_ssl_context *ssl)\0A{\0A    return ssl->MBEDTLS_PRIVATE(conf);\0A}\0A\0A/**\0A * \5Cbrief          Set the underlying BIO callbacks for write, read and\0A *                 read-with-timeout.\0A *\0A * \5Cparam ssl      SSL context\0A * \5Cparam p_bio    parameter (context) shared by BIO callbacks\0A * \5Cparam f_send   write callback\0A * \5Cparam f_recv   read callback\0A * \5Cparam f_recv_timeout blocking read callback with timeout.\0A *\0A * \5Cnote           One of f_recv or f_recv_timeout can be NULL, in which case\0A *                 the other is used. If both are non-NULL, f_recv_timeout is\0A *                 used and f_recv is ignored (as if it were NULL).\0A *\0A * \5Cnote           The two most common use cases are:\0A *                 - non-blocking I/O, f_recv != NULL, f_recv_timeout == NULL\0A *                 - blocking I/O, f_recv == NULL, f_recv_timeout != NULL\0A *\0A * \5Cnote           For DTLS, you need to provide either a non-NULL\0A *                 f_recv_timeout callback, or a f_recv that doesn't block.\0A *\0A * \5Cnote           See the documentations of \5Cc mbedtls_ssl_send_t,\0A *                 \5Cc mbedtls_ssl_recv_t and \5Cc mbedtls_ssl_recv_timeout_t for\0A *                 the conventions those callbacks must follow.\0A *\0A * \5Cnote           On some platforms, net_sockets.c provides\0A *                 \5Cc mbedtls_net_send(), \5Cc mbedtls_net_recv() and\0A *                 \5Cc mbedtls_net_recv_timeout() that are suitable to be used\0A *                 here.\0A */\0Avoid mbedtls_ssl_set_bio(mbedtls_ssl_context *ssl,\0A                         void *p_bio,\0A                         mbedtls_ssl_send_t *f_send,\0A                         mbedtls_ssl_recv_t *f_recv,\0A                         mbedtls_ssl_recv_timeout_t *f_recv_timeout);\0A\0A#if defined(MBEDTLS_SSL_PROTO_DTLS)\0A\0A#if defined(MBEDTLS_SSL_DTLS_CONNECTION_ID)\0A\0A\0A/**\0A * \5Cbrief             Configure the use of the Connection ID (CID)\0A *                    extension in the next handshake.\0A *\0A *                    Reference: RFC 9146 (or draft-ietf-tls-dtls-connection-id-05\0A *                    https://tools.ietf.org/html/draft-ietf-tls-dtls-connection-id-05\0A *                    for legacy version)\0A *\0A *                    The DTLS CID extension allows the reliable association of\0A *                    DTLS records to DTLS connections across changes in the\0A *                    underlying transport (changed IP and Port metadata) by\0A *                    adding explicit connection identifiers (CIDs) to the\0A *                    headers of encrypted DTLS records. The desired CIDs are\0A *                    configured by the application layer and are exchanged in\0A *                    new `ClientHello` / `ServerHello` extensions during the\0A *                    handshake, where each side indicates the CID it wants the\0A *                    peer to use when writing encrypted messages. The CIDs are\0A *                    put to use once records get encrypted: the stack discards\0A *                    any incoming records that don't include the configured CID\0A *                    in their header, and adds the peer's requested CID to the\0A *                    headers of outgoing messages.\0A *\0A *                    This API enables or disables the use of the CID extension\0A *                    in the next handshake and sets the value of the CID to\0A *                    be used for incoming messages.\0A *\0A * \5Cparam ssl         The SSL context to configure. This must be initialized.\0A * \5Cparam enable      This value determines whether the CID extension should\0A *                    be used or not. Possible values are:\0A *                    - MBEDTLS_SSL_CID_ENABLED to enable the use of the CID.\0A *                    - MBEDTLS_SSL_CID_DISABLED (default) to disable the use\0A *                      of the CID.\0A * \5Cparam own_cid     The address of the readable buffer holding the CID we want\0A *                    the peer to use when sending encrypted messages to us.\0A *                    This may be \5Cc NULL if \5Cp own_cid_len is \5Cc 0.\0A *                    This parameter is unused if \5Cp enable is set to\0A *                    MBEDTLS_SSL_CID_DISABLED.\0A * \5Cparam own_cid_len The length of \5Cp own_cid.\0A *                    This parameter is unused if \5Cp enable is set to\0A *                    MBEDTLS_SSL_CID_DISABLED.\0A *\0A * \5Cnote              The value of \5Cp own_cid_len must match the value of the\0A *                    \5Cc len parameter passed to mbedtls_ssl_conf_cid()\0A *                    when configuring the ::mbedtls_ssl_config that \5Cp ssl\0A *                    is bound to.\0A *\0A * \5Cnote              This CID configuration applies to subsequent handshakes\0A *                    performed on the SSL context \5Cp ssl, but does not trigger\0A *                    one. You still have to call `mbedtls_ssl_handshake()`\0A *                    (for the initial handshake) or `mbedtls_ssl_renegotiate()`\0A *                    (for a renegotiation handshake) explicitly after a\0A *                    successful call to this function to run the handshake.\0A *\0A * \5Cnote              This call cannot guarantee that the use of the CID\0A *                    will be successfully negotiated in the next handshake,\0A *                    because the peer might not support it. Specifically:\0A *                    - On the Client, enabling the use of the CID through\0A *                      this call implies that the `ClientHello` in the next\0A *                      handshake will include the CID extension, thereby\0A *                      offering the use of the CID to the server. Only if\0A *                      the `ServerHello` contains the CID extension, too,\0A *                      the CID extension will actually be put to use.\0A *                    - On the Server, enabling the use of the CID through\0A *                      this call implies that the server will look for\0A *                      the CID extension in a `ClientHello` from the client,\0A *                      and, if present, reply with a CID extension in its\0A *                      `ServerHello`.\0A *\0A * \5Cnote              To check whether the use of the CID was negotiated\0A *                    after the subsequent handshake has completed, please\0A *                    use the API mbedtls_ssl_get_peer_cid().\0A *\0A * \5Cwarning           If the use of the CID extension is enabled in this call\0A *                    and the subsequent handshake negotiates its use, Mbed TLS\0A *                    will silently drop every packet whose CID does not match\0A *                    the CID configured in \5Cp own_cid. It is the responsibility\0A *                    of the user to adapt the underlying transport to take care\0A *                    of CID-based demultiplexing before handing datagrams to\0A *                    Mbed TLS.\0A *\0A * \5Creturn            \5Cc 0 on success. In this case, the CID configuration\0A *                    applies to the next handshake.\0A * \5Creturn            A negative error code on failure.\0A */\0Aint mbedtls_ssl_set_cid(mbedtls_ssl_context *ssl,\0A                        int enable,\0A                        unsigned char const *own_cid,\0A                        size_t own_cid_len);\0A\0A/**\0A * \5Cbrief              Get information about our request for usage of the CID\0A *                     extension in the current connection.\0A *\0A * \5Cparam ssl          The SSL context to query.\0A * \5Cparam enabled      The address at which to store whether the CID extension\0A *                     is requested to be used or not. If the CID is\0A *                     requested, `*enabled` is set to\0A *                     MBEDTLS_SSL_CID_ENABLED; otherwise, it is set to\0A *                     MBEDTLS_SSL_CID_DISABLED.\0A * \5Cparam own_cid      The address of the buffer in which to store our own\0A *                     CID (if the CID extension is requested). This may be\0A *                     \5Cc NULL in case the value of our CID isn't needed. If\0A *                     it is not \5Cc NULL, \5Cp own_cid_len must not be \5Cc NULL.\0A * \5Cparam own_cid_len  The address at which to store the size of our own CID\0A *                     (if the CID extension is requested). This is also the\0A *                     number of Bytes in \5Cp own_cid that have been written.\0A *                     This may be \5Cc NULL in case the length of our own CID\0A *                     isn't needed. If it is \5Cc NULL, \5Cp own_cid must be\0A *                     \5Cc NULL, too.\0A *\0A *\5Cnote                If we are requesting an empty CID this function sets\0A *                     `*enabled` to #MBEDTLS_SSL_CID_DISABLED (the rationale\0A *                     for this is that the resulting outcome is the\0A *                     same as if the CID extensions wasn't requested).\0A *\0A * \5Creturn            \5Cc 0 on success.\0A * \5Creturn            A negative error code on failure.\0A */\0Aint mbedtls_ssl_get_own_cid(mbedtls_ssl_context *ssl,\0A                            int *enabled,\0A                            unsigned char own_cid[MBEDTLS_SSL_CID_IN_LEN_MAX],\0A                            size_t *own_cid_len);\0A\0A/**\0A * \5Cbrief              Get information about the use of the CID extension\0A *                     in the current connection.\0A *\0A * \5Cparam ssl          The SSL context to query.\0A * \5Cparam enabled      The address at which to store whether the CID extension\0A *                     is currently in use or not. If the CID is in use,\0A *                     `*enabled` is set to MBEDTLS_SSL_CID_ENABLED;\0A *                     otherwise, it is set to MBEDTLS_SSL_CID_DISABLED.\0A * \5Cparam peer_cid     The address of the buffer in which to store the CID\0A *                     chosen by the peer (if the CID extension is used).\0A *                     This may be \5Cc NULL in case the value of peer CID\0A *                     isn't needed. If it is not \5Cc NULL, \5Cp peer_cid_len\0A *                     must not be \5Cc NULL.\0A * \5Cparam peer_cid_len The address at which to store the size of the CID\0A *                     chosen by the peer (if the CID extension is used).\0A *                     This is also the number of Bytes in \5Cp peer_cid that\0A *                     have been written.\0A *                     This may be \5Cc NULL in case the length of the peer CID\0A *                     isn't needed. If it is \5Cc NULL, \5Cp peer_cid must be\0A *                     \5Cc NULL, too.\0A *\0A * \5Cnote               This applies to the state of the CID negotiated in\0A *                     the last complete handshake. If a handshake is in\0A *                     progress, this function will attempt to complete\0A *                     the handshake first.\0A *\0A * \5Cnote               If CID extensions have been exchanged but both client\0A *                     and server chose to use an empty CID, this function\0A *                     sets `*enabled` to #MBEDTLS_SSL_CID_DISABLED\0A *                     (the rationale for this is that the resulting\0A *                     communication is the same as if the CID extensions\0A *                     hadn't been used).\0A *\0A * \5Creturn            \5Cc 0 on success.\0A * \5Creturn            A negative error code on failure.\0A */\0Aint mbedtls_ssl_get_peer_cid(mbedtls_ssl_context *ssl,\0A                             int *enabled,\0A                             unsigned char peer_cid[MBEDTLS_SSL_CID_OUT_LEN_MAX],\0A                             size_t *peer_cid_len);\0A\0A#endif /* MBEDTLS_SSL_DTLS_CONNECTION_ID */\0A\0A/**\0A * \5Cbrief          Set the Maximum Transport Unit (MTU).\0A *                 Special value: 0 means unset (no limit).\0A *                 This represents the maximum size of a datagram payload\0A *                 handled by the transport layer (usually UDP) as determined\0A *                 by the network link and stack. In practice, this controls\0A *                 the maximum size datagram the DTLS layer will pass to the\0A *                 \5Cc f_send() callback set using \5Cc mbedtls_ssl_set_bio().\0A *\0A * \5Cnote           The limit on datagram size is converted to a limit on\0A *                 record payload by subtracting the current overhead of\0A *                 encapsulation and encryption/authentication if any.\0A *\0A * \5Cnote           This can be called at any point during the connection, for\0A *                 example when a Path Maximum Transfer Unit (PMTU)\0A *                 estimate becomes available from other sources,\0A *                 such as lower (or higher) protocol layers.\0A *\0A * \5Cnote           This setting only controls the size of the packets we send,\0A *                 and does not restrict the size of the datagrams we're\0A *                 willing to receive. Client-side, you can request the\0A *                 server to use smaller records with \5Cc\0A *                 mbedtls_ssl_conf_max_frag_len().\0A *\0A * \5Cnote           If both a MTU and a maximum fragment length have been\0A *                 configured (or negotiated with the peer), the resulting\0A *                 lower limit on record payload (see first note) is used.\0A *\0A * \5Cnote           This can only be used to decrease the maximum size\0A *                 of datagrams (hence records, see first note) sent. It\0A *                 cannot be used to increase the maximum size of records over\0A *                 the limit set by #MBEDTLS_SSL_OUT_CONTENT_LEN.\0A *\0A * \5Cnote           Values lower than the current record layer expansion will\0A *                 result in an error when trying to send data.\0A *\0A * \5Cparam ssl      SSL context\0A * \5Cparam mtu      Value of the path MTU in bytes\0A */\0Avoid mbedtls_ssl_set_mtu(mbedtls_ssl_context *ssl, uint16_t mtu);\0A#endif /* MBEDTLS_SSL_PROTO_DTLS */\0A\0A#if defined(MBEDTLS_X509_CRT_PARSE_C)\0A/**\0A * \5Cbrief          Set a connection-specific verification callback (optional).\0A *\0A *                 If set, the provided verify callback is called for each\0A *                 certificate in the peer's CRT chain, including the trusted\0A *                 root. For more information, please see the documentation of\0A *                 \5Cc mbedtls_x509_crt_verify().\0A *\0A * \5Cnote           This call is analogous to mbedtls_ssl_conf_verify() but\0A *                 binds the verification callback and context to an SSL context\0A *                 as opposed to an SSL configuration.\0A *                 If mbedtls_ssl_conf_verify() and mbedtls_ssl_set_verify()\0A *                 are both used, mbedtls_ssl_set_verify() takes precedence.\0A *\0A * \5Cparam ssl      The SSL context to use.\0A * \5Cparam f_vrfy   The verification callback to use during CRT verification.\0A * \5Cparam p_vrfy   The opaque context to be passed to the callback.\0A */\0Avoid mbedtls_ssl_set_verify(mbedtls_ssl_context *ssl,\0A                            int (*f_vrfy)(void *, mbedtls_x509_crt *, int, uint32_t *),\0A                            void *p_vrfy);\0A#endif /* MBEDTLS_X509_CRT_PARSE_C */\0A\0A/**\0A * \5Cbrief          Set the timeout period for mbedtls_ssl_read()\0A *                 (Default: no timeout.)\0A *\0A * \5Cparam conf     SSL configuration context\0A * \5Cparam timeout  Timeout value in milliseconds.\0A *                 Use 0 for no timeout (default).\0A *\0A * \5Cnote           With blocking I/O, this will only work if a non-NULL\0A *                 \5Cc f_recv_timeout was set with \5Cc mbedtls_ssl_set_bio().\0A *                 With non-blocking I/O, this will only work if timer\0A *                 callbacks were set with \5Cc mbedtls_ssl_set_timer_cb().\0A *\0A * \5Cnote           With non-blocking I/O, you may also skip this function\0A *                 altogether and handle timeouts at the application layer.\0A */\0Avoid mbedtls_ssl_conf_read_timeout(mbedtls_ssl_config *conf, uint32_t timeout);\0A\0A/**\0A * \5Cbrief          Check whether a buffer contains a valid and authentic record\0A *                 that has not been seen before. (DTLS only).\0A *\0A *                 This function does not change the user-visible state\0A *                 of the SSL context. Its sole purpose is to provide\0A *                 an indication of the legitimacy of an incoming record.\0A *\0A *                 This can be useful e.g. in distributed server environments\0A *                 using the DTLS Connection ID feature, in which connections\0A *                 might need to be passed between service instances on a change\0A *                 of peer address, but where such disruptive operations should\0A *                 only happen after the validity of incoming records has been\0A *                 confirmed.\0A *\0A * \5Cparam ssl      The SSL context to use.\0A * \5Cparam buf      The address of the buffer holding the record to be checked.\0A *                 This must be a read/write buffer of length \5Cp buflen Bytes.\0A * \5Cparam buflen   The length of \5Cp buf in Bytes.\0A *\0A * \5Cnote           This routine only checks whether the provided buffer begins\0A *                 with a valid and authentic record that has not been seen\0A *                 before, but does not check potential data following the\0A *                 initial record. In particular, it is possible to pass DTLS\0A *                 datagrams containing multiple records, in which case only\0A *                 the first record is checked.\0A *\0A * \5Cnote           This function modifies the input buffer \5Cp buf. If you need\0A *                 to preserve the original record, you have to maintain a copy.\0A *\0A * \5Creturn         \5Cc 0 if the record is valid and authentic and has not been\0A *                 seen before.\0A * \5Creturn         MBEDTLS_ERR_SSL_INVALID_MAC if the check completed\0A *                 successfully but the record was found to be not authentic.\0A * \5Creturn         MBEDTLS_ERR_SSL_INVALID_RECORD if the check completed\0A *                 successfully but the record was found to be invalid for\0A *                 a reason different from authenticity checking.\0A * \5Creturn         MBEDTLS_ERR_SSL_UNEXPECTED_RECORD if the check completed\0A *                 successfully but the record was found to be unexpected\0A *                 in the state of the SSL context, including replayed records.\0A * \5Creturn         Another negative error code on different kinds of failure.\0A *                 In this case, the SSL context becomes unusable and needs\0A *                 to be freed or reset before reuse.\0A */\0Aint mbedtls_ssl_check_record(mbedtls_ssl_context const *ssl,\0A                             unsigned char *buf,\0A                             size_t buflen);\0A\0A/**\0A * \5Cbrief          Set the timer callbacks (Mandatory for DTLS.)\0A *\0A * \5Cparam ssl      SSL context\0A * \5Cparam p_timer  parameter (context) shared by timer callbacks\0A * \5Cparam f_set_timer   set timer callback\0A * \5Cparam f_get_timer   get timer callback. Must return:\0A *\0A * \5Cnote           See the documentation of \5Cc mbedtls_ssl_set_timer_t and\0A *                 \5Cc mbedtls_ssl_get_timer_t for the conventions this pair of\0A *                 callbacks must follow.\0A *\0A * \5Cnote           On some platforms, timing.c provides\0A *                 \5Cc mbedtls_timing_set_delay() and\0A *                 \5Cc mbedtls_timing_get_delay() that are suitable for using\0A *                 here, except if using an event-driven style.\0A *\0A * \5Cnote           See also the \22DTLS tutorial\22 article in our knowledge base.\0A *                 https://mbed-tls.readthedocs.io/en/latest/kb/how-to/dtls-tutorial\0A */\0Avoid mbedtls_ssl_set_timer_cb(mbedtls_ssl_context *ssl,\0A                              void *p_timer,\0A                              mbedtls_ssl_set_timer_t *f_set_timer,\0A                              mbedtls_ssl_get_timer_t *f_get_timer);\0A\0A#if defined(MBEDTLS_SSL_SRV_C)\0A/**\0A * \5Cbrief           Set the certificate selection callback (server-side only).\0A *\0A *                  If set, the callback is always called for each handshake,\0A *                  after `ClientHello` processing has finished.\0A *\0A * \5Cparam conf      The SSL configuration to register the callback with.\0A * \5Cparam f_cert_cb The callback for selecting server certificate after\0A *                  `ClientHello` processing has finished.\0A */\0Astatic inline void mbedtls_ssl_conf_cert_cb(mbedtls_ssl_config *conf,\0A                                            mbedtls_ssl_hs_cb_t f_cert_cb)\0A{\0A    conf->MBEDTLS_PRIVATE(f_cert_cb) = f_cert_cb;\0A}\0A#endif /* MBEDTLS_SSL_SRV_C */\0A\0A/**\0A * \5Cbrief           Callback type: generate and write session ticket\0A *\0A * \5Cnote            This describes what a callback implementation should do.\0A *                  This callback should generate an encrypted and\0A *                  authenticated ticket for the session and write it to the\0A *                  output buffer. Here, ticket means the opaque ticket part\0A *                  of the NewSessionTicket structure of RFC 5077.\0A *\0A * \5Cparam p_ticket  Context for the callback\0A * \5Cparam session   SSL session to be written in the ticket\0A * \5Cparam start     Start of the output buffer\0A * \5Cparam end       End of the output buffer\0A * \5Cparam tlen      On exit, holds the length written\0A * \5Cparam lifetime  On exit, holds the lifetime of the ticket in seconds\0A *\0A * \5Creturn          0 if successful, or\0A *                  a specific MBEDTLS_ERR_XXX code.\0A */\0Atypedef int mbedtls_ssl_ticket_write_t(void *p_ticket,\0A                                       const mbedtls_ssl_session *session,\0A                                       unsigned char *start,\0A                                       const unsigned char *end,\0A                                       size_t *tlen,\0A                                       uint32_t *lifetime);\0A\0A/**\0A * \5Cbrief           Callback type: parse and load session ticket\0A *\0A * \5Cnote            This describes what a callback implementation should do.\0A *                  This callback should parse a session ticket as generated\0A *                  by the corresponding mbedtls_ssl_ticket_write_t function,\0A *                  and, if the ticket is authentic and valid, load the\0A *                  session.\0A *\0A * \5Cnote            The implementation is allowed to modify the first len\0A *                  bytes of the input buffer, eg to use it as a temporary\0A *                  area for the decrypted ticket contents.\0A *\0A * \5Cparam p_ticket  Context for the callback\0A * \5Cparam session   SSL session to be loaded\0A * \5Cparam buf       Start of the buffer containing the ticket\0A * \5Cparam len       Length of the ticket.\0A *\0A * \5Creturn          0 if successful, or\0A *                  MBEDTLS_ERR_SSL_INVALID_MAC if not authentic, or\0A *                  MBEDTLS_ERR_SSL_SESSION_TICKET_EXPIRED if expired, or\0A *                  any other non-zero code for other failures.\0A */\0Atypedef int mbedtls_ssl_ticket_parse_t(void *p_ticket,\0A                                       mbedtls_ssl_session *session,\0A                                       unsigned char *buf,\0A                                       size_t len);\0A\0A#if defined(MBEDTLS_SSL_SESSION_TICKETS) && defined(MBEDTLS_SSL_SRV_C)\0A/**\0A * \5Cbrief           Configure SSL session ticket callbacks (server only).\0A *                  (Default: none.)\0A *\0A * \5Cnote            On server, session tickets are enabled by providing\0A *                  non-NULL callbacks.\0A *\0A * \5Cnote            On client, use \5Cc mbedtls_ssl_conf_session_tickets().\0A *\0A * \5Cparam conf      SSL configuration context\0A * \5Cparam f_ticket_write    Callback for writing a ticket\0A * \5Cparam f_ticket_parse    Callback for parsing a ticket\0A * \5Cparam p_ticket          Context shared by the two callbacks\0A */\0Avoid mbedtls_ssl_conf_session_tickets_cb(mbedtls_ssl_config *conf,\0A                                         mbedtls_ssl_ticket_write_t *f_ticket_write,\0A                                         mbedtls_ssl_ticket_parse_t *f_ticket_parse,\0A                                         void *p_ticket);\0A\0A#if defined(MBEDTLS_HAVE_TIME)\0A/**\0A * \5Cbrief Get the creation time of a session ticket.\0A *\0A * \5Cnote See the documentation of \5Cc ticket_creation_time for information about\0A *       the intended usage of this function.\0A *\0A * \5Cparam session  SSL session\0A * \5Cparam ticket_creation_time  On exit, holds the ticket creation time in\0A *                              milliseconds.\0A *\0A * \5Creturn         0 on success,\0A *                 MBEDTLS_ERR_SSL_BAD_INPUT_DATA if an input is not valid.\0A */\0Astatic inline int mbedtls_ssl_session_get_ticket_creation_time(\0A    mbedtls_ssl_session *session, mbedtls_ms_time_t *ticket_creation_time)\0A{\0A    if (session == NULL || ticket_creation_time == NULL ||\0A        session->MBEDTLS_PRIVATE(endpoint) != MBEDTLS_SSL_IS_SERVER) {\0A        return MBEDTLS_ERR_SSL_BAD_INPUT_DATA;\0A    }\0A\0A    *ticket_creation_time = session->MBEDTLS_PRIVATE(ticket_creation_time);\0A\0A    return 0;\0A}\0A#endif /* MBEDTLS_HAVE_TIME */\0A#endif /* MBEDTLS_SSL_SESSION_TICKETS && MBEDTLS_SSL_SRV_C */\0A\0A/**\0A * \5Cbrief          Get the session-id buffer.\0A *\0A * \5Cparam session  SSL session.\0A *\0A * \5Creturn         The address of the session-id buffer.\0A */\0Astatic inline unsigned const char (*mbedtls_ssl_session_get_id(const mbedtls_ssl_session *\0A                                                               session))[32]\0A{\0A    return &session->MBEDTLS_PRIVATE(id);\0A}\0A\0A/**\0A * \5Cbrief          Get the size of the session-id.\0A *\0A * \5Cparam session  SSL session.\0A *\0A * \5Creturn         size_t size of session-id buffer.\0A */\0Astatic inline size_t mbedtls_ssl_session_get_id_len(const mbedtls_ssl_session *session)\0A{\0A    return session->MBEDTLS_PRIVATE(id_len);\0A}\0A\0A/**\0A * \5Cbrief          Get the ciphersuite-id.\0A *\0A * \5Cparam session  SSL session.\0A *\0A * \5Creturn         int represetation for ciphersuite.\0A */\0Astatic inline int mbedtls_ssl_session_get_ciphersuite_id(const mbedtls_ssl_session *session)\0A{\0A    return session->MBEDTLS_PRIVATE(ciphersuite);\0A}\0A\0A/**\0A * \5Cbrief   Configure a key export callback.\0A *          (Default: none.)\0A *\0A *          This API can be used for two purposes:\0A *          - Debugging: Use this API to e.g. generate an NSSKeylog\0A *            file and use it to inspect encrypted traffic in tools\0A *            such as Wireshark.\0A *          - Application-specific export: Use this API to implement\0A *            key exporters, e.g. for EAP-TLS or DTLS-SRTP.\0A *\0A *\0A * \5Cparam ssl            The SSL context to which the export\0A *                       callback should be attached.\0A * \5Cparam f_export_keys  The callback for the key export.\0A * \5Cparam p_export_keys  The opaque context pointer to be passed to the\0A *                       callback \5Cp f_export_keys.\0A */\0Avoid mbedtls_ssl_set_export_keys_cb(mbedtls_ssl_context *ssl,\0A                                    mbedtls_ssl_export_keys_t *f_export_keys,\0A                                    void *p_export_keys);\0A\0A/** \5Cbrief Set the user data in an SSL configuration to a pointer.\0A *\0A * You can retrieve this value later with mbedtls_ssl_conf_get_user_data_p().\0A *\0A * \5Cnote The library stores \5Cc p without accessing it. It is the responsibility\0A *       of the caller to ensure that the pointer remains valid.\0A *\0A * \5Cparam conf           The SSL configuration context to modify.\0A * \5Cparam p              The new value of the user data.\0A */\0Astatic inline void mbedtls_ssl_conf_set_user_data_p(\0A    mbedtls_ssl_config *conf,\0A    void *p)\0A{\0A    conf->MBEDTLS_PRIVATE(user_data).p = p;\0A}\0A\0A/** \5Cbrief Set the user data in an SSL configuration to an integer.\0A *\0A * You can retrieve this value later with mbedtls_ssl_conf_get_user_data_n().\0A *\0A * \5Cparam conf           The SSL configuration context to modify.\0A * \5Cparam n              The new value of the user data.\0A */\0Astatic inline void mbedtls_ssl_conf_set_user_data_n(\0A    mbedtls_ssl_config *conf,\0A    uintptr_t n)\0A{\0A    conf->MBEDTLS_PRIVATE(user_data).n = n;\0A}\0A\0A/** \5Cbrief Retrieve the user data in an SSL configuration as a pointer.\0A *\0A * This is the value last set with mbedtls_ssl_conf_set_user_data_p(), or\0A * \5Cc NULL if mbedtls_ssl_conf_set_user_data_p() has not previously been\0A * called. The value is undefined if mbedtls_ssl_conf_set_user_data_n() has\0A * been called without a subsequent call to mbedtls_ssl_conf_set_user_data_p().\0A *\0A * \5Cparam conf           The SSL configuration context to modify.\0A * \5Creturn               The current value of the user data.\0A */\0Astatic inline void *mbedtls_ssl_conf_get_user_data_p(\0A    mbedtls_ssl_config *conf)\0A{\0A    return conf->MBEDTLS_PRIVATE(user_data).p;\0A}\0A\0A/** \5Cbrief Retrieve the user data in an SSL configuration as an integer.\0A *\0A * This is the value last set with mbedtls_ssl_conf_set_user_data_n(), or\0A * \5Cc 0 if mbedtls_ssl_conf_set_user_data_n() has not previously been\0A * called. The value is undefined if mbedtls_ssl_conf_set_user_data_p() has\0A * been called without