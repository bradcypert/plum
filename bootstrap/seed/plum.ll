LS_ERR_PKCS12_FEATURE_UNAVAILABLE;\0A    }\0A\0A    mbedtls_md_init(&md_ctx);\0A\0A    if ((ret = mbedtls_md_setup(&md_ctx, md_info, 0)) != 0) {\0A        return ret;\0A    }\0A    // Calculate hash( diversifier || salt_block || pwd_block )\0A    if ((ret = mbedtls_md_starts(&md_ctx)) != 0) {\0A        goto exit;\0A    }\0A\0A    if ((ret = mbedtls_md_update(&md_ctx, diversifier, v)) != 0) {\0A        goto exit;\0A    }\0A\0A    if (use_salt != 0) {\0A        if ((ret = mbedtls_md_update(&md_ctx, salt_block, v)) != 0) {\0A            goto exit;\0A        }\0A    }\0A\0A    if (use_password != 0) {\0A        if ((ret = mbedtls_md_update(&md_ctx, pwd_block, v)) != 0) {\0A            goto exit;\0A        }\0A    }\0A\0A    if ((ret = mbedtls_md_finish(&md_ctx, hash_output)) != 0) {\0A        goto exit;\0A    }\0A\0A    // Perform remaining ( iterations - 1 ) recursive hash calculations\0A    for (i = 1; i < (size_t) iterations; i++) {\0A        if ((ret = mbedtls_md(md_info, hash_output, hlen, hash_output))\0A            != 0) {\0A            goto exit;\0A        }\0A    }\0A\0Aexit:\0A    mbedtls_md_free(&md_ctx);\0A    return ret;\0A}\0A\0A\0Aint mbedtls_pkcs12_derivation(unsigned char *data, size_t datalen,\0A                              const unsigned char *pwd, size_t pwdlen,\0A                              const unsigned char *salt, size_t saltlen,\0A                              mbedtls_md_type_t md_type, int id, int iterations)\0A{\0A    int ret = MBEDTLS_ERR_ERROR_CORRUPTION_DETECTED;\0A    unsigned int j;\0A\0A    unsigned char diversifier[128];\0A    unsigned char salt_block[128], pwd_block[128], hash_block[128] = { 0 };\0A    unsigned char hash_output[MBEDTLS_MD_MAX_SIZE];\0A    unsigned char *p;\0A    unsigned char c;\0A    int           use_password = 0;\0A    int           use_salt = 0;\0A\0A    size_t hlen, use_len, v, i;\0A\0A    // This version only allows max of 64 bytes of password or salt\0A    if (datalen > 128 || pwdlen > 64 || saltlen > 64) {\0