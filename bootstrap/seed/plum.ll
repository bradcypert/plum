*/\0A    MBEDTLS_MPI_CHK(mbedtls_mpi_sub_int(&diff_N_2, &ecp_group.N, 2));\0A\0A    /* Note: This function is always called with *data == NULL and it\0A     * allocates memory for the data buffer. */\0A    *data = mbedtls_calloc(1, m_bytes);\0A    if (*data == NULL) {\0A        ret = MBEDTLS_ERR_ASN1_ALLOC_FAILED;\0A        goto cleanup;\0A    }\0A\0A    while (key_out_of_range) {\0A        /* 1. Draw a byte string of length ceiling(m/8) bytes. */\0A        if ((status = psa_key_derivation_output_bytes(operation, *data, m_bytes)) != 0) {\0A            goto cleanup;\0A        }\0A\0A        /* 2. If m is not a multiple of 8 */\0A        if (m % 8 != 0) {\0A            /* Set the most significant\0A             * (8 * ceiling(m/8) - m) bits of the first byte in\0A             * the string to zero.\0A             */\0A            uint8_t clear_bit_mask = (1 << (m % 8)) - 1;\0A            (*data)[0] &= clear_bit_mask;\0A        }\0A\0A        /* 3. Convert the string to integer k by decoding it as a\0A         *    big-endian byte string.\0A         */\0A        MBEDTLS_MPI_CHK(mbedtls_mpi_read_binary(&k, *data, m_bytes));\0A\0A        /* 4. If k > N - 2, discard the result and return to step 1.\0A         *    Result of comparison is returned. When it indicates error\0A         *    then this function is called again.\0A         */\0A        MBEDTLS_MPI_CHK(mbedtls_mpi_lt_mpi_ct(&diff_N_2, &k, &key_out_of_range));\0A    }\0A\0A    /* 5. Output k + 1 as the private key. */\0A    MBEDTLS_MPI_CHK(mbedtls_mpi_add_int(&k, &k, 1));\0A    MBEDTLS_MPI_CHK(mbedtls_mpi_write_binary(&k, *data, m_bytes));\0Acleanup:\0A    if (ret != 0) {\0A        status = mbedtls_to_psa_error(ret);\0A    }\0A    if (status != PSA_SUCCESS) {\0A        mbedtls_zeroize_and_free(*data, m_bytes);\0A        *data = NULL;\0A    }\0A    mbedtls_mpi_free(&k);\0A    mbedtls_mpi_free(&diff_N_2);\0A    return status;\0A}\0A\0A/* ECC keys on a Montgomery elliptic curve draws a byte string whose length\0A * is