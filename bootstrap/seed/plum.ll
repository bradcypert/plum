@.str40024 = private global { i64, i64, [12273 x i8] } { i64 -1, i64 12272, [12273 x i8] c"/*\0A *  PSA crypto support for secure element drivers\0A */\0A/*\0A *  Copyright The Mbed TLS Contributors\0A *  SPDX-License-Identifier: Apache-2.0 OR GPL-2.0-or-later\0A */\0A\0A#include \22common.h\22\0A\0A#if defined(MBEDTLS_PSA_CRYPTO_SE_C)\0A\0A#include <stdint.h>\0A#include <string.h>\0A\0A#include \22psa/crypto_se_driver.h\22\0A\0A#include \22psa_crypto_se.h\22\0A\0A#if defined(MBEDTLS_PSA_ITS_FILE_C)\0A#include \22psa_crypto_its.h\22\0A#else /* Native ITS implementation */\0A#include \22psa/error.h\22\0A#include \22psa/internal_trusted_storage.h\22\0A#endif\0A\0A#include \22mbedtls/platform.h\22\0A\0A\0A\0A/****************************************************************/\0A/* Driver lookup */\0A/****************************************************************/\0A\0A/* This structure is identical to psa_drv_se_context_t declared in\0A * `crypto_se_driver.h`, except that some parts are writable here\0A * (non-const, or pointer to non-const). */\0Atypedef struct {\0A    void *persistent_data;\0A    size_t persistent_data_size;\0A    uintptr_t transient_data;\0A} psa_drv_se_internal_context_t;\0A\0Astruct psa_se_drv_table_entry_s {\0A    psa_key_location_t location;\0A    const psa_drv_se_t *methods;\0A    union {\0A        psa_drv_se_internal_context_t internal;\0A        psa_drv_se_context_t context;\0A    } u;\0A};\0A\0Astatic psa_se_drv_table_entry_t driver_table[PSA_MAX_SE_DRIVERS];\0A\0Apsa_se_drv_table_entry_t *psa_get_se_driver_entry(\0A    psa_key_lifetime_t lifetime)\0A{\0A    size_t i;\0A    psa_key_location_t location = PSA_KEY_LIFETIME_GET_LOCATION(lifetime);\0A    /* In the driver table, location=0 means an entry that isn't used.\0A     * No driver has a location of 0 because it's a reserved value\0A     * (which designates transparent keys). Make sure we never return\0A     * a driver entry for location 0. */\0A    if (location == 0) {\0A        return NULL;\0A    }\0A    for (i = 0; i < PSA_MAX_SE_DRIVERS; i++) {\0A        if (driver_table[i].location == location) {\0A            return &driver_table[i];\0A        }\0A    }\0A    return NULL;\0A}\0A\0Aconst psa_drv_se_t *psa_get_se_driver_methods(\0A    const psa_se_drv_table_entry_t *driver)\0A{\0A    return driver->methods;\0A}\0A\0Apsa_drv_se_context_t *psa_get_se_driver_context(\0A    psa_se_drv_table_entry_t *driver)\0A{\0A    return &driver->u.context;\0A}\0A\0Aint psa_get_se_driver(psa_key_lifetime_t lifetime,\0A                      const psa_drv_se_t **p_methods,\0A                      psa_drv_se_context_t **p_drv_context)\0A{\0A    psa_se_drv_table_entry_t *driver = psa_get_se_driver_entry(lifetime);\0A    if (p_methods != NULL) {\0A        *p_methods = (driver ? driver->methods : NULL);\0A    }\0A    if (p_drv_context != NULL) {\0A        *p_drv_context = (driver ? &driver->u.context : NULL);\0A    }\0A    return driver != NULL;\0A}\0A\0A\0A\0A/****************************************************************/\0A/* Persistent data management */\0A/****************************************************************/\0A\0Astatic psa_status_t psa_get_se_driver_its_file_uid(\0A    const psa_se_drv_table_entry_t *driver,\0A    psa_storage_uid_t *uid)\0A{\0A    if (driver->location > PSA_MAX_SE_LOCATION) {\0A        return PSA_ERROR_NOT_SUPPORTED;\0A    }\0A\0A    /* ITS file sizes are limited to 32 bits. */\0A    if (driver->u.internal.persistent_data_size > UINT32_MAX) {\0A        return PSA_ERROR_NOT_SUPPORTED;\0A    }\0A\0A    /* See the documentation of PSA_CRYPTO_SE_DRIVER_ITS_UID_BASE. */\0A    *uid = PSA_CRYPTO_SE_DRIVER_ITS_UID_BASE + driver->location;\0A    return PSA_SUCCESS;\0A}\0A\0Apsa_status_t psa_load_se_persistent_data(\0A    const psa_se_drv_table_entry_t *driver)\0A{\0A    psa_status_t status;\0A    psa_storage_uid_t uid;\0A    size_t length;\0A\0A    status = psa_get_se_driver_its_file_uid(driver, &uid);\0A    if (status != PSA_SUCCESS) {\0A        return status;\0A    }\0A\0A    /* Read the amount of persistent data that the driver requests.\0A     * If the data in storage is larger, it is truncated. If the data\0A     * in storage is smaller, silently keep what is already at the end\0A     * of the output buffer. */\0A    /* psa_get_se_driver_its_file_uid ensures that the size_t\0A     * persistent_data_size is in range, but compilers don't know that,\0A     * so cast to reassure them. */\0A    return psa_its_get(uid, 0,\0A                       (uint32_t) driver->u.internal.persistent_data_size,\0A                       driver->u.internal.persistent_data,\0A                       &length);\0A}\0A\0Apsa_status_t psa_save_se_persistent_data(\0A    const psa_se_drv_table_entry_t *driver)\0A{\0A    psa_status_t status;\0A    psa_storage_uid_t uid;\0A\0A    status = psa_get_se_driver_its_file_uid(driver, &uid);\0A    if (status != PSA_SUCCESS) {\0A        return status;\0A    }\0A\0A    /* psa_get_se_driver_its_file_uid ensures that the size_t\0A     * persistent_data_size is in range, but compilers don't know that,\0A     * so cast to reassure them. */\0A    return psa_its_set(uid,\0A                       (uint32_t) driver->u.internal.persistent_data_size,\0A                       driver->u.internal.persistent_data,\0A                       0);\0A}\0A\0Apsa_status_t psa_destroy_se_persistent_data(psa_key_location_t location)\0A{\0A    psa_storage_uid_t uid;\0A    if (location > PSA_MAX_SE_LOCATION) {\0A        return PSA_ERROR_NOT_SUPPORTED;\0A    }\0A    uid = PSA_CRYPTO_SE_DRIVER_ITS_UID_BASE + location;\0A    return psa_its_remove(uid);\0A}\0A\0Apsa_status_t psa_find_se_slot_for_key(\0A    const psa_key_attributes_t *attributes,\0A    psa_key_creation_method_t method,\0A    psa_se_drv_table_entry_t *driver,\0A    psa_key_slot_number_t *slot_number)\0A{\0A    psa_status_t status;\0A    psa_key_location_t key_location =\0A        PSA_KEY_LIFETIME_GET_LOCATION(psa_get_key_lifetime(attributes));\0A\0A    /* If the location is wrong, it's a bug in the library. */\0A    if (driver->location != key_location) {\0A        return PSA_ERROR_CORRUPTION_DETECTED;\0A    }\0A\0A    /* If the driver doesn't support key creation in any way, give up now. */\0A    if (driver->methods->key_management == NULL) {\0A        return PSA_ERROR_NOT_SUPPORTED;\0A    }\0A\0A    if (psa_get_key_slot_number(attributes, slot_number) == PSA_SUCCESS) {\0A        /* The application wants to use a specific slot. Allow it if\0A         * the driver supports it. On a system with isolation,\0A         * the crypto service must check that the application is\0A         * permitted to request this slot. */\0A        psa_drv_se_validate_slot_number_t p_validate_slot_number =\0A            driver->methods->key_management->p_validate_slot_number;\0A        if (p_validate_slot_number == NULL) {\0A            return PSA_ERROR_NOT_SUPPORTED;\0A        }\0A        status = p_validate_slot_number(&driver->u.context,\0A                                        driver->u.internal.persistent_data,\0A                                        attributes, method,\0A                                        *slot_number);\0A    } else if (method == PSA_KEY_CREATION_REGISTER) {\0A        /* The application didn't specify a slot number. This doesn't\0A         * make sense when registering a slot. */\0A        return PSA_ERROR_INVALID_ARGUMENT;\0A    } else {\0A        /* The application didn't tell us which slot to use. Let the driver\0A         * choose. This is the normal case. */\0A        psa_drv_se_allocate_key_t p_allocate =\0A            driver->methods->key_management->p_allocate;\0A        if (p_allocate == NULL) {\0A            return PSA_ERROR_NOT_SUPPORTED;\0A        }\0A        status = p_allocate(&driver->u.context,\0A                            driver->u.internal.persistent_data,\0A                            attributes, method,\0A                            slot_number);\0A    }\0A    return status;\0A}\0A\0Apsa_status_t psa_destroy_se_key(psa_se_drv_table_entry_t *driver,\0A                                psa_key_slot_number_t slot_number)\0A{\0A    psa_status_t status;\0A    psa_status_t storage_status;\0A    /* Normally a missing method would mean that the action is not\0A     * supported. But psa_destroy_key() is not supposed to return\0A     * PSA_ERROR_NOT_SUPPORTED: if you can create a key, you should\0A     * be able to destroy it. The only use case for a driver that\0A     * does not have a way to destroy keys at all is if the keys are\0A     * locked in a read-only state: we can use the keys but not\0A     * destroy them. Hence, if the driver doesn't support destroying\0A     * keys, it's really a lack of permission. */\0A    if (driver->methods->key_management == NULL ||\0A        driver->methods->key_management->p_destroy == NULL) {\0A        return PSA_ERROR_NOT_PERMITTED;\0A    }\0A    status = driver->methods->key_management->p_destroy(\0A        &driver->u.context,\0A        driver->u.internal.persistent_data,\0A        slot_number);\0A    storage_status = psa_save_se_persistent_data(driver);\0A    return status == PSA_SUCCESS ? storage_status : status;\0A}\0A\0Apsa_status_t psa_init_all_se_drivers(void)\0A{\0A    size_t i;\0A    for (i = 0; i < PSA_MAX_SE_DRIVERS; i++) {\0A        psa_se_drv_table_entry_t *driver = &driver_table[i];\0A        if (driver->location == 0) {\0A            continue; /* skipping unused entry */\0A        }\0A        const psa_drv_se_t *methods = psa_get_se_driver_methods(driver);\0A        if (methods->p_init != NULL) {\0A            psa_status_t status = methods->p_init(\0A                &driver->u.context,\0A                driver->u.internal.persistent_data,\0A                driver->location);\0A            if (status != PSA_SUCCESS) {\0A                return status;\0A            }\0A            status = psa_save_se_persistent_data(driver);\0A            if (status != PSA_SUCCESS) {\0A                return status;\0A            }\0A        }\0A    }\0A    return PSA_SUCCESS;\0A}\0A\0A\0A\0A/****************************************************************/\0A/* Driver registration */\0A/****************************************************************/\0A\0Apsa_status_t psa_register_se_driver(\0A    psa_key_location_t location,\0A    const psa_drv_se_t *methods)\0A{\0A    size_t i;\0A    psa_status_t status;\0A\0A    if (methods->hal_version != PSA_DRV_SE_HAL_VERSION) {\0A        return PSA_ERROR_NOT_SUPPORTED;\0A    }\0A    /* Driver table entries are 0-initialized. 0 is not a valid driver\0A     * location because it means a transparent key. */\0A    MBEDTLS_STATIC_ASSERT(PSA_KEY_LOCATION_LOCAL_STORAGE == 0,\0A                          \22Secure element support requires 0 to mean a local key\22);\0A\0A    if (location == PSA_KEY_LOCATION_LOCAL_STORAGE) {\0A        return PSA_ERROR_INVALID_ARGUMENT;\0A    }\0A    if (location > PSA_MAX_SE_LOCATION) {\0A        return PSA_ERROR_NOT_SUPPORTED;\0A    }\0A\0A    for (i = 0; i < PSA_MAX_SE_DRIVERS; i++) {\0A        if (driver_table[i].location == 0) {\0A            break;\0A        }\0A        /* Check that location isn't already in use up to the first free\0A         * entry. Since entries are created in order and never deleted,\0A         * there can't be a used entry after the first free entry. */\0A        if (driver_table[i].location == location) {\0A            return PSA_ERROR_ALREADY_EXISTS;\0A        }\0A    }\0A    if (i == PSA_MAX_SE_DRIVERS) {\0A        return PSA_ERROR_INSUFFICIENT_MEMORY;\0A    }\0A\0A    driver_table[i].location = location;\0A    driver_table[i].methods = methods;\0A    driver_table[i].u.internal.persistent_data_size =\0A        methods->persistent_data_size;\0A\0A    if (methods->persistent_data_size != 0) {\0A        driver_table[i].u.internal.persistent_data =\0A            mbedtls_calloc(1, methods->persistent_data_size);\0A        if (driver_table[i].u.internal.persistent_data == NULL) {\0A            status = PSA_ERROR_INSUFFICIENT_MEMORY;\0A            goto error;\0A        }\0A        /* Load the driver's persistent data. On first use, the persistent\0A         * data does not exist in storage, and is initialized to\0A         * all-bits-zero by the calloc call just above. */\0A        status = psa_load_se_persistent_data(&driver_table[i]);\0A        if (status != PSA_SUCCESS && status != PSA_ERROR_DOES_NOT_EXIST) {\0A            goto error;\0A        }\0A    }\0A\0A    return PSA_SUCCESS;\0A\0Aerror:\0A    memset(&driver_table[i], 0, sizeof(driver_table[i]));\0A    return status;\0A}\0A\0Avoid psa_unregister_all_se_drivers(void)\0A{\0A    size_t i;\0A    for (i = 0; i < PSA_MAX_SE_DRIVERS; i++) {\0A        if (driver_table[i].u.internal.persistent_data != NULL) {\0A            mbedtls_free(driver_table[i].u.internal.persistent_data);\0A        }\0A    }\0A    memset(driver_table, 0, sizeof(driver_table));\0A}\0A\0A\0A\0A/****************************************************************/\0A/* The end */\0A/****************************************************************/\0A\0A#endif /* MBEDTLS_PSA_CRYPTO_SE_C */\0A\00" }
@.const40026 = private global <{ i64, ptr, ptr, i1, [7 x i8] }> <{ i64 -1, ptr @.str40022, ptr @.str40024, i1 1, [7 x i8] zeroinitializer }>
@.str40027 = private global { i64, i64, [32 x i8] } { i64 -1, i64 31, [32 x i8] c"mbedtls/library/psa_crypto_se.h\00" }
@.str40029 = private global { i64, i64, [6748 x i8] } { i64 -1, i64 6747, [6748 x i8] c"/*\0A *  PSA crypto support for secure element drivers\0A */\0A/*\0A *  Copyright The Mbed TLS Contributors\0A *  SPDX-License-Identifier: Apache-2.0 OR GPL-2.0-or-later\0A */\0A\0A#ifndef PSA_CRYPTO_SE_H\0A#define PSA_CRYPTO_SE_H\0A\0A/*\0A * Include the build-time configuration information header. Here, we do not\0A * include `\22mbedtls/build_info.h\22` directly but `\22psa/build_info.h\22`, which\0A * is basically just an alias to it. This is to ease the maintenance of the\0A * TF-PSA-Crypto repository which has a different build system and\0A * configuration.\0A */\0A#include \22psa/build_info.h\22\0A\0A#include \22psa/crypto.h\22\0A#include \22psa/crypto_se_driver.h\22\0A\0A/** The maximum location value that this implementation supports\0A * for a secure element.\0A *\0A * This is not a characteristic that each PSA implementation has, but a\0A * limitation of the current implementation due to the constraints imposed\0A * by storage. See #PSA_CRYPTO_SE_DRIVER_ITS_UID_BASE.\0A *\0A * The minimum location value for a secure element is 1, like on any\0A * PSA implementation (0 means a transparent key).\0A */\0A#define PSA_MAX_SE_LOCATION 255\0A\0A/** The base of the range of ITS file identifiers for secure element\0A * driver persistent data.\0A *\0A * We use a slice of the implementation reserved range 0xffff0000..0xffffffff,\0A * specifically the range 0xfffffe00..0xfffffeff. The length of this range\0A * drives the value of #PSA_MAX_SE_LOCATION. The identifier 0xfffffe00 is\0A * actually not used since it corresponds to #PSA_KEY_LOCATION_LOCAL_STORAGE\0A * which doesn't have a driver.\0A */\0A#define PSA_CRYPTO_SE_DRIVER_ITS_UID_BASE ((psa_key_id_t) 0xfffffe00)\0A\0A/** The maximum number of registered secure element driver locations. */\0A#define PSA_MAX_SE_DRIVERS 4\0A\0A/** Unregister all secure element drivers.\0A *\0A * \5Cwarning Do not call this function while the library is in the initialized\0A *          state. This function is only intended to be called at the end\0A *          of mbedtls_psa_crypto_free().\0A */\0Avoid psa_unregister_all_se_drivers(void);\0A\0A/** Initialize all secure element drivers.\0A *\0A * Called from psa_crypto_init().\0A */\0Apsa_status_t psa_init_all_se_drivers(void);\0A\0A/** A structure that describes a registered secure element driver.\0A *\0A * A secure element driver table entry contains a pointer to the\0A * driver's method table as well as the driver context structure.\0A */\0Atypedef struct psa_se_drv_table_entry_s psa_se_drv_table_entry_t;\0A\0A/** Return the secure element driver information for a lifetime value.\0A *\0A * \5Cparam lifetime              The lifetime value to query.\0A * \5Cparam[out] p_methods        On output, if there is a driver,\0A *                              \5Cc *methods points to its method table.\0A *                              Otherwise \5Cc *methods is \5Cc NULL.\0A * \5Cparam[out] p_drv_context    On output, if there is a driver,\0A *                              \5Cc *drv_context points to its context\0A *                              structure.\0A *                              Otherwise \5Cc *drv_context is \5Cc NULL.\0A *\0A * \5Cretval 1\0A *         \5Cp lifetime corresponds to a registered driver.\0A * \5Cretval 0\0A *         \5Cp lifetime does not correspond to a registered driver.\0A */\0Aint psa_get_se_driver(psa_key_lifetime_t lifetime,\0A                      const psa_drv_se_t **p_methods,\0A                      psa_drv_se_context_t **p_drv_context);\0A\0A/** Return the secure element driver table entry for a lifetime value.\0A *\0A * \5Cparam lifetime      The lifetime value to query.\0A *\0A * \5Creturn The driver table entry for \5Cp lifetime, or\0A *         \5Cp NULL if \5Cp lifetime does not correspond to a registered driver.\0A */\0Apsa_se_drv_table_entry_t *psa_get_se_driver_entry(\0A    psa_key_lifetime_t lifetime);\0A\0A/** Return the method table for a secure element driver.\0A *\0A * \5Cparam[in] driver    The driver table entry to access, or \5Cc NULL.\0A *\0A * \5Creturn The driver's method table.\0A *         \5Cc NULL if \5Cp driver is \5Cc NULL.\0A */\0Aconst psa_drv_se_t *psa_get_se_driver_methods(\0A    const psa_se_drv_table_entry_t *driver);\0A\0A/** Return the context of a secure element driver.\0A *\0A * \5Cparam[in] driver    The driver table entry to access, or \5Cc NULL.\0A *\0A * \5Creturn A pointer to the driver context.\0A *         \5Cc NULL if \5Cp driver is \5Cc NULL.\0A */\0Apsa_drv_se_context_t *psa_get_se_driver_context(\0A    psa_se_drv_table_entry_t *driver);\0A\0A/** Find a free slot for a key that is to be created.\0A *\0A * This function calls the relevant method in the driver to find a suitable\0A * slot for a key with the given attributes.\0A *\0A * \5Cparam[in] attributes    Metadata about the key that is about to be created.\0A * \5Cparam[in] driver        The driver table entry to query.\0A * \5Cparam[out] slot_number  On success, a slot number that is free in this\0A *                          secure element.\0A */\0Apsa_status_t psa_find_se_slot_for_key(\0A    const psa_key_attributes_t *attributes,\0A    psa_key_creation_method_t method,\0A    psa_se_drv_table_entry_t *driver,\0A    psa_key_slot_number_t *slot_number);\0A\0A/** Destroy a key in a secure element.\0A *\0A * This function calls the relevant driver method to destroy a key\0A * and updates the driver's persistent data.\0A */\0Apsa_status_t psa_destroy_se_key(psa_se_drv_table_entry_t *driver,\0A                                psa_key_slot_number_t slot_number);\0A\0A/** Load the persistent data of a secure element driver.\0A *\0A * \5Cparam driver        The driver table entry containing the persistent\0A *                      data to load from storage.\0A *\0A * \5Creturn #PSA_SUCCESS\0A * \5Creturn #PSA_ERROR_NOT_SUPPORTED\0A * \5Creturn #PSA_ERROR_DOES_NOT_EXIST\0A * \5Creturn #PSA_ERROR_STORAGE_FAILURE\0A * \5Creturn #PSA_ERROR_DATA_CORRUPT\0A * \5Creturn #PSA_ERROR_INVALID_ARGUMENT\0A */\0Apsa_status_t psa_load_se_persistent_data(\0A    const psa_se_drv_table_entry_t *driver);\0A\0A/** Save the persistent data of a secure element driver.\0A *\0A * \5Cparam[in] driver    The driver table entry containing the persistent\0A *                      data to save to storage.\0A *\0A * \5Creturn #PSA_SUCCESS\0A * \5Creturn #PSA_ERROR_NOT_SUPPORTED\0A * \5Creturn #PSA_ERROR_NOT_PERMITTED\0A * \5Creturn #PSA_ERROR_NOT_SUPPORTED\0A * \5Creturn #PSA_ERROR_INSUFFICIENT_STORAGE\0A * \5Creturn #PSA_ERROR_STORAGE_FAILURE\0A * \5Creturn #PSA_ERROR_INVALID_ARGUMENT\0A */\0Apsa_status_t psa_save_se_persistent_data(\0A    const psa_se_drv_table_entry_t *driver);\0A\0A/** Destroy the persistent data of a secure element driver.\0A *\0A * This is currently only used for testing.\0A *\0A * \5Cparam[in] location  The location identifier for the driver whose\0A *                      persistent data is to be erased.\0A */\0Apsa_status_t psa_destroy_se_persistent_data(psa_key_location_t location);\0A\0A\0A/** The storage representation of a key whose data is in a secure element.\0A */\0Atypedef struct {\0A    uint8_t slot_number[sizeof(psa_key_slot_number_t)];\0A} psa_se_key_data_storage_t;\0A\0A#endif /* PSA_CRYPTO_SE_H */\0A\00" }
