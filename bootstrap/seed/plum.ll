@.str40852 = private global { i64, i64, [6113 x i8] } { i64 -1, i64 6112, [6113 x i8] c"/**\0A * \5Cfile ssl_cache.h\0A *\0A * \5Cbrief SSL session cache implementation\0A */\0A/*\0A *  Copyright The Mbed TLS Contributors\0A *  SPDX-License-Identifier: Apache-2.0 OR GPL-2.0-or-later\0A */\0A#ifndef MBEDTLS_SSL_CACHE_H\0A#define MBEDTLS_SSL_CACHE_H\0A#include \22mbedtls/private_access.h\22\0A\0A#include \22mbedtls/build_info.h\22\0A\0A#include \22mbedtls/ssl.h\22\0A\0A#if defined(MBEDTLS_THREADING_C)\0A#include \22mbedtls/threading.h\22\0A#endif\0A\0A/**\0A * \5Cname SECTION: Module settings\0A *\0A * The configuration options you can set for this module are in this section.\0A * Either change them in mbedtls_config.h or define them on the compiler command line.\0A * \5C{\0A */\0A\0A#if !defined(MBEDTLS_SSL_CACHE_DEFAULT_TIMEOUT)\0A#define MBEDTLS_SSL_CACHE_DEFAULT_TIMEOUT       86400   /*!< 1 day  */\0A#endif\0A\0A#if !defined(MBEDTLS_SSL_CACHE_DEFAULT_MAX_ENTRIES)\0A#define MBEDTLS_SSL_CACHE_DEFAULT_MAX_ENTRIES      50   /*!< Maximum entries in cache */\0A#endif\0A\0A/** \5C} name SECTION: Module settings */\0A\0A#ifdef __cplusplus\0Aextern \22C\22 {\0A#endif\0A\0Atypedef struct mbedtls_ssl_cache_context mbedtls_ssl_cache_context;\0Atypedef struct mbedtls_ssl_cache_entry mbedtls_ssl_cache_entry;\0A\0A/**\0A * \5Cbrief   This structure is used for storing cache entries\0A */\0Astruct mbedtls_ssl_cache_entry {\0A#if defined(MBEDTLS_HAVE_TIME)\0A    mbedtls_time_t MBEDTLS_PRIVATE(timestamp);           /*!< entry timestamp    */\0A#endif\0A\0A    unsigned char MBEDTLS_PRIVATE(session_id)[32];       /*!< session ID         */\0A    size_t MBEDTLS_PRIVATE(session_id_len);\0A\0A    unsigned char *MBEDTLS_PRIVATE(session);             /*!< serialized session */\0A    size_t MBEDTLS_PRIVATE(session_len);\0A\0A    mbedtls_ssl_cache_entry *MBEDTLS_PRIVATE(next);      /*!< chain pointer      */\0A};\0A\0A/**\0A * \5Cbrief Cache context\0A */\0Astruct mbedtls_ssl_cache_context {\0A    mbedtls_ssl_cache_entry *MBEDTLS_PRIVATE(chain);     /*!< start of the chain     */\0A    int MBEDTLS_PRIVATE(timeout);                /*!< cache entry timeout    */\0A    int MBEDTLS_PRIVATE(max_entries);            /*!< maximum entries        */\0A#if defined(MBEDTLS_THREADING_C)\0A    mbedtls_threading_mutex_t MBEDTLS_PRIVATE(mutex);    /*!< mutex                  */\0A#endif\0A};\0A\0A/**\0A * \5Cbrief          Initialize an SSL cache context\0A *\0A * \5Cparam cache    SSL cache context\0A */\0Avoid mbedtls_ssl_cache_init(mbedtls_ssl_cache_context *cache);\0A\0A/**\0A * \5Cbrief          Cache get callback implementation\0A *                 (Thread-safe if MBEDTLS_THREADING_C is enabled)\0A *\0A * \5Cparam data            The SSL cache context to use.\0A * \5Cparam session_id      The pointer to the buffer holding the session ID\0A *                        for the session to load.\0A * \5Cparam session_id_len  The length of \5Cp session_id in bytes.\0A * \5Cparam session         The address at which to store the session\0A *                        associated with \5Cp session_id, if present.\0A *\0A * \5Creturn                \5Cc 0 on success.\0A * \5Creturn                #MBEDTLS_ERR_SSL_CACHE_ENTRY_NOT_FOUND if there is\0A *                        no cache entry with specified session ID found, or\0A *                        any other negative error code for other failures.\0A */\0Aint mbedtls_ssl_cache_get(void *data,\0A                          unsigned char const *session_id,\0A                          size_t session_id_len,\0A                          mbedtls_ssl_session *session);\0A\0A/**\0A * \5Cbrief          Cache set callback implementation\0A *                 (Thread-safe if MBEDTLS_THREADING_C is enabled)\0A *\0A * \5Cparam data            The SSL cache context to use.\0A * \5Cparam session_id      The pointer to the buffer holding the session ID\0A *                        associated to \5Cp session.\0A * \5Cparam session_id_len  The length of \5Cp session_id in bytes.\0A * \5Cparam session         The session to store.\0A *\0A * \5Creturn                \5Cc 0 on success.\0A * \5Creturn                A negative error code on failure.\0A */\0Aint mbedtls_ssl_cache_set(void *data,\0A                          unsigned char const *session_id,\0A                          size_t session_id_len,\0A                          const mbedtls_ssl_session *session);\0A\0A/**\0A * \5Cbrief          Remove the cache entry by the session ID\0A *                 (Thread-safe if MBEDTLS_THREADING_C is enabled)\0A *\0A * \5Cparam data            The SSL cache context to use.\0A * \5Cparam session_id      The pointer to the buffer holding the session ID\0A *                        associated to session.\0A * \5Cparam session_id_len  The length of \5Cp session_id in bytes.\0A *\0A * \5Creturn                \5Cc 0 on success. This indicates the cache entry for\0A *                        the session with provided ID is removed or does not\0A *                        exist.\0A * \5Creturn                A negative error code on failure.\0A */\0Aint mbedtls_ssl_cache_remove(void *data,\0A                             unsigned char const *session_id,\0A                             size_t session_id_len);\0A\0A#if defined(MBEDTLS_HAVE_TIME)\0A/**\0A * \5Cbrief          Set the cache timeout\0A *                 (Default: MBEDTLS_SSL_CACHE_DEFAULT_TIMEOUT (1 day))\0A *\0A *                 A timeout of 0 indicates no timeout.\0A *\0A * \5Cparam cache    SSL cache context\0A * \5Cparam timeout  cache entry timeout in seconds\0A */\0Avoid mbedtls_ssl_cache_set_timeout(mbedtls_ssl_cache_context *cache, int timeout);\0A\0A/**\0A * \5Cbrief          Get the cache timeout\0A *\0A *                 A timeout of 0 indicates no timeout.\0A *\0A * \5Cparam cache    SSL cache context\0A *\0A * \5Creturn         cache entry timeout in seconds\0A */\0Astatic inline int mbedtls_ssl_cache_get_timeout(mbedtls_ssl_cache_context *cache)\0A{\0A    return cache->MBEDTLS_PRIVATE(timeout);\0A}\0A#endif /* MBEDTLS_HAVE_TIME */\0A\0A/**\0A * \5Cbrief          Set the maximum number of cache entries\0A *                 (Default: MBEDTLS_SSL_CACHE_DEFAULT_MAX_ENTRIES (50))\0A *\0A * \5Cparam cache    SSL cache context\0A * \5Cparam max      cache entry maximum\0A */\0Avoid mbedtls_ssl_cache_set_max_entries(mbedtls_ssl_cache_context *cache, int max);\0A\0A/**\0A * \5Cbrief          Free referenced items in a cache context and clear memory\0A *\0A * \5Cparam cache    SSL cache context\0A */\0Avoid mbedtls_ssl_cache_free(mbedtls_ssl_cache_context *cache);\0A\0A#ifdef __cplusplus\0A}\0A#endif\0A\0A#endif /* ssl_cache.h */\0A\00" }
