@.str40598 = private global { i64, i64, [10719 x i8] } { i64 -1, i64 10718, [10719 x i8] c"/*\0A *  DTLS cookie callbacks implementation\0A *\0A *  Copyright The Mbed TLS Contributors\0A *  SPDX-License-Identifier: Apache-2.0 OR GPL-2.0-or-later\0A */\0A/*\0A * These session callbacks use a simple chained list\0A * to store and retrieve the session information.\0A */\0A\0A#include \22common.h\22\0A\0A#if defined(MBEDTLS_SSL_COOKIE_C)\0A\0A#include \22mbedtls/platform.h\22\0A\0A#include \22mbedtls/ssl_cookie.h\22\0A#include \22ssl_misc.h\22\0A#include \22mbedtls/error.h\22\0A#include \22mbedtls/platform_util.h\22\0A#include \22mbedtls/constant_time.h\22\0A\0A#include <string.h>\0A\0A#if defined(MBEDTLS_USE_PSA_CRYPTO)\0A#include \22mbedtls/psa_util.h\22\0A/* Define a local translating function to save code size by not using too many\0A * arguments in each translating place. */\0Astatic int local_err_translation(psa_status_t status)\0A{\0A    return psa_status_to_mbedtls(status, psa_to_ssl_errors,\0A                                 ARRAY_LENGTH(psa_to_ssl_errors),\0A                                 psa_generic_status_to_mbedtls);\0A}\0A#define PSA_TO_MBEDTLS_ERR(status) local_err_translation(status)\0A#endif\0A\0A/*\0A * If DTLS is in use, then at least one of SHA-256 or SHA-384 is\0A * available. Try SHA-256 first as 384 wastes resources\0A */\0A#if defined(MBEDTLS_MD_CAN_SHA256)\0A#define COOKIE_MD           MBEDTLS_MD_SHA256\0A#define COOKIE_MD_OUTLEN    32\0A#define COOKIE_HMAC_LEN     28\0A#elif defined(MBEDTLS_MD_CAN_SHA384)\0A#define COOKIE_MD           MBEDTLS_MD_SHA384\0A#define COOKIE_MD_OUTLEN    48\0A#define COOKIE_HMAC_LEN     28\0A#else\0A#error \22DTLS hello verify needs SHA-256 or SHA-384\22\0A#endif\0A\0A/*\0A * Cookies are formed of a 4-bytes timestamp (or serial number) and\0A * an HMAC of timestamp and client ID.\0A */\0A#define COOKIE_LEN      (4 + COOKIE_HMAC_LEN)\0A\0Avoid mbedtls_ssl_cookie_init(mbedtls_ssl_cookie_ctx *ctx)\0A{\0A#if defined(MBEDTLS_USE_PSA_CRYPTO)\0A    ctx->psa_hmac_key = MBEDTLS_SVC_KEY_ID_INIT;\0A#else\0A    mbedtls_md_init(&ctx->hmac_ctx);\0A#endif /* MBEDTLS_USE_PSA_CRYPTO */\0A#if !defined(MBEDTLS_HAVE_TIME)\0A    ctx->serial = 0;\0A#endif\0A    ctx->timeout = MBEDTLS_SSL_COOKIE_TIMEOUT;\0A\0A#if !defined(MBEDTLS_USE_PSA_CRYPTO)\0A#if defined(MBEDTLS_THREADING_C)\0A    mbedtls_mutex_init(&ctx->mutex);\0A#endif\0A#endif /* !MBEDTLS_USE_PSA_CRYPTO */\0A}\0A\0Avoid mbedtls_ssl_cookie_set_timeout(mbedtls_ssl_cookie_ctx *ctx, unsigned long delay)\0A{\0A    ctx->timeout = delay;\0A}\0A\0Avoid mbedtls_ssl_cookie_free(mbedtls_ssl_cookie_ctx *ctx)\0A{\0A    if (ctx == NULL) {\0A        return;\0A    }\0A\0A#if defined(MBEDTLS_USE_PSA_CRYPTO)\0A    psa_destroy_key(ctx->psa_hmac_key);\0A#else\0A    mbedtls_md_free(&ctx->hmac_ctx);\0A\0A#if defined(MBEDTLS_THREADING_C)\0A    mbedtls_mutex_free(&ctx->mutex);\0A#endif\0A#endif /* MBEDTLS_USE_PSA_CRYPTO */\0A\0A    mbedtls_platform_zeroize(ctx, sizeof(mbedtls_ssl_cookie_ctx));\0A}\0A\0Aint mbedtls_ssl_cookie_setup(mbedtls_ssl_cookie_ctx *ctx,\0A                             int (*f_rng)(void *, unsigned char *, size_t),\0A                             void *p_rng)\0A{\0A#if defined(MBEDTLS_USE_PSA_CRYPTO)\0A    psa_key_attributes_t attributes = PSA_KEY_ATTRIBUTES_INIT;\0A    psa_status_t status = PSA_ERROR_CORRUPTION_DETECTED;\0A    psa_algorithm_t alg;\0A\0A    (void) f_rng;\0A    (void) p_rng;\0A\0A    alg = mbedtls_md_psa_alg_from_type(COOKIE_MD);\0A    if (alg == 0) {\0A        return MBEDTLS_ERR_SSL_BAD_INPUT_DATA;\0A    }\0A\0A    ctx->psa_hmac_alg = PSA_ALG_TRUNCATED_MAC(PSA_ALG_HMAC(alg),\0A                                              COOKIE_HMAC_LEN);\0A\0A    psa_set_key_usage_flags(&attributes, PSA_KEY_USAGE_VERIFY_MESSAGE |\0A                            PSA_KEY_USAGE_SIGN_MESSAGE);\0A    psa_set_key_algorithm(&attributes, ctx->psa_hmac_alg);\0A    psa_set_key_type(&attributes, PSA_KEY_TYPE_HMAC);\0A    psa_set_key_bits(&attributes, PSA_BYTES_TO_BITS(COOKIE_MD_OUTLEN));\0A\0A    if ((status = psa_generate_key(&attributes,\0A                                   &ctx->psa_hmac_key)) != PSA_SUCCESS) {\0A        return PSA_TO_MBEDTLS_ERR(status);\0A    }\0A#else\0A    int ret = MBEDTLS_ERR_ERROR_CORRUPTION_DETECTED;\0A    unsigned char key[COOKIE_MD_OUTLEN];\0A\0A    if ((ret = f_rng(p_rng, key, sizeof(key))) != 0) {\0A        return ret;\0A    }\0A\0A    ret = mbedtls_md_setup(&ctx->hmac_ctx, mbedtls_md_info_from_type(COOKIE_MD), 1);\0A    if (ret != 0) {\0A        return ret;\0A    }\0A\0A    ret = mbedtls_md_hmac_starts(&ctx->hmac_ctx, key, sizeof(key));\0A    if (ret != 0) {\0A        return ret;\0A    }\0A\0A    mbedtls_platform_zeroize(key, sizeof(key));\0A#endif /* MBEDTLS_USE_PSA_CRYPTO */\0A\0A    return 0;\0A}\0A\0A#if !defined(MBEDTLS_USE_PSA_CRYPTO)\0A/*\0A * Generate the HMAC part of a cookie\0A */\0AMBEDTLS_CHECK_RETURN_CRITICAL\0Astatic int ssl_cookie_hmac(mbedtls_md_context_t *hmac_ctx,\0A                           const unsigned char time[4],\0A                           unsigned char **p, unsigned char *end,\0A                           const unsigned char *cli_id, size_t cli_id_len)\0A{\0A    unsigned char hmac_out[COOKIE_MD_OUTLEN];\0A\0A    MBEDTLS_SSL_CHK_BUF_PTR(*p, end, COOKIE_HMAC_LEN);\0A\0A    if (mbedtls_md_hmac_reset(hmac_ctx) != 0 ||\0A        mbedtls_md_hmac_update(hmac_ctx, time, 4) != 0 ||\0A        mbedtls_md_hmac_update(hmac_ctx, cli_id, cli_id_len) != 0 ||\0A        mbedtls_md_hmac_finish(hmac_ctx, hmac_out) != 0) {\0A        return MBEDTLS_ERR_SSL_INTERNAL_ERROR;\0A    }\0A\0A    memcpy(*p, hmac_out, COOKIE_HMAC_LEN);\0A    *p += COOKIE_HMAC_LEN;\0A\0A    return 0;\0A}\0A#endif /* !MBEDTLS_USE_PSA_CRYPTO */\0A\0A/*\0A * Generate cookie for DTLS ClientHello verification\0A */\0Aint mbedtls_ssl_cookie_write(void *p_ctx,\0A                             unsigned char **p, unsigned char *end,\0A                             const unsigned char *cli_id, size_t cli_id_len)\0A{\0A#if defined(MBEDTLS_USE_PSA_CRYPTO)\0A    psa_mac_operation_t operation = PSA_MAC_OPERATION_INIT;\0A    psa_status_t status = PSA_ERROR_CORRUPTION_DETECTED;\0A    size_t sign_mac_length = 0;\0A#endif\0A    int ret = MBEDTLS_ERR_ERROR_CORRUPTION_DETECTED;\0A    mbedtls_ssl_cookie_ctx *ctx = (mbedtls_ssl_cookie_ctx *) p_ctx;\0A    unsigned long t;\0A\0A    if (ctx == NULL || cli_id == NULL) {\0A        return MBEDTLS_ERR_SSL_BAD_INPUT_DATA;\0A    }\0A\0A    MBEDTLS_SSL_CHK_BUF_PTR(*p, end, COOKIE_LEN);\0A\0A#if defined(MBEDTLS_HAVE_TIME)\0A    t = (unsigned long) mbedtls_time(NULL);\0A#else\0A    t = ctx->serial++;\0A#endif\0A\0A    MBEDTLS_PUT_UINT32_BE(t, *p, 0);\0A    *p += 4;\0A\0A#if defined(MBEDTLS_USE_PSA_CRYPTO)\0A    status = psa_mac_sign_setup(&operation, ctx->psa_hmac_key,\0A                                ctx->psa_hmac_alg);\0A    if (status != PSA_SUCCESS) {\0A        ret = PSA_TO_MBEDTLS_ERR(status);\0A        goto exit;\0A    }\0A\0A    status = psa_mac_update(&operation, *p - 4, 4);\0A    if (status != PSA_SUCCESS) {\0A        ret = PSA_TO_MBEDTLS_ERR(status);\0A        goto exit;\0A    }\0A\0A    status = psa_mac_update(&operation, cli_id, cli_id_len);\0A    if (status != PSA_SUCCESS) {\0A        ret = PSA_TO_MBEDTLS_ERR(status);\0A        goto exit;\0A    }\0A\0A    status = psa_mac_sign_finish(&operation, *p, COOKIE_MD_OUTLEN,\0A                                 &sign_mac_length);\0A    if (status != PSA_SUCCESS) {\0A        ret = PSA_TO_MBEDTLS_ERR(status);\0A        goto exit;\0A    }\0A\0A    *p += COOKIE_HMAC_LEN;\0A\0A    ret = 0;\0A#else\0A#if defined(MBEDTLS_THREADING_C)\0A    if ((ret = mbedtls_mutex_lock(&ctx->mutex)) != 0) {\0A        return MBEDTLS_ERROR_ADD(MBEDTLS_ERR_SSL_INTERNAL_ERROR, ret);\0A    }\0A#endif\0A\0A    ret = ssl_cookie_hmac(&ctx->hmac_ctx, *p - 4,\0A                          p, end, cli_id, cli_id_len);\0A\0A#if defined(MBEDTLS_THREADING_C)\0A    if (mbedtls_mutex_unlock(&ctx->mutex) != 0) {\0A        return MBEDTLS_