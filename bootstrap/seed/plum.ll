                       int tag,\0A                                   unsigned char *start,\0A                                   size_t len)\0A{\0A    asn1_get_sequence_of_cb_ctx_t *cb_ctx =\0A        (asn1_get_sequence_of_cb_ctx_t *) ctx;\0A    mbedtls_asn1_sequence *cur =\0A        cb_ctx->cur;\0A\0A    if (cur->buf.p != NULL) {\0A        cur->next =\0A            mbedtls_calloc(1, sizeof(mbedtls_asn1_sequence));\0A\0A        if (cur->next == NULL) {\0A            return MBEDTLS_ERR_ASN1_ALLOC_FAILED;\0A        }\0A\0A        cur = cur->next;\0A    }\0A\0A    cur->buf.p = start;\0A    cur->buf.len = len;\0A    cur->buf.tag = tag;\0A\0A    cb_ctx->cur = cur;\0A    return 0;\0A}\0A\0A/*\0A *  Parses and splits an ASN.1 \22SEQUENCE OF <tag>\22\0A */\0Aint mbedtls_asn1_get_sequence_of(unsigned char **p,\0A                                 const unsigned char *end,\0A                                 mbedtls_asn1_sequence *cur,\0A                                 int tag)\0A{\0A    asn1_get_sequence_of_cb_ctx_t cb_ctx = { tag, cur };\0A    memset(cur, 0, sizeof(mbedtls_asn1_sequence));\0A    return mbedtls_asn1_traverse_sequence_of(\0A        p, end, 0xFF, tag, 0, 0,\0A        asn1_get_sequence_of_cb, &cb_ctx);\0A}\0A\0Aint mbedtls_asn1_get_alg(unsigned char **p,\0A                         const unsigned char *end,\0A                         mbedtls_asn1_buf *alg, mbedtls_asn1_buf *params)\0A{\0A    int ret = MBEDTLS_ERR_ERROR_CORRUPTION_DETECTED;\0A    size_t len;\0A\0A    if ((ret = mbedtls_asn1_get_tag(p, end, &len,\0A                                    MBEDTLS_ASN1_CONSTRUCTED | MBEDTLS_ASN1_SEQUENCE)) != 0) {\0A        return ret;\0A    }\0A\0A    if ((end - *p) < 1) {\0A        return MBEDTLS_ERR_ASN1_OUT_OF_DATA;\0A    }\0A\0A    alg->tag = **p;\0A    end = *p + len;\0A\0A    if ((ret = mbedtls_asn1_get_tag(p, end, &alg->len, MBEDTLS_ASN1_OID)) != 0) {\0A        return ret;\0A    }\0A\0A    alg->p = *p;\0A    *p += alg->len;\0A\0A    if (*p == end) {\0A        mbedt