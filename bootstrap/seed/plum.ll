ecause the parser's own pieces return it; a caller\0A/// wants `json_parse`.\0Apub struct ParseResult[T] { pub value: T, pub next_pos: Int }\0A\0Alet skip_ws (chars: Array[String]) (pos: Int): Int =\0A    if pos >= chars.len() { pos }\0A    else {\0A        let c = chars[pos];\0A        if c == \22 \22 || c == \22\5Ct\22 || c == \22\5Cn\22 || c == \22\5Cr\22 { skip_ws(chars, pos + 1) } else { pos }\0A    }\0A\0Alet digit_value (c: String): Result[Float, String] =\0A    if c == \220\22 { Ok(0.0) }\0A    else if c == \221\22 { Ok(1.0) }\0A    else if c == \222\22 { Ok(2.0) }\0A    else if c == \223\22 { Ok(3.0) }\0A    else if c == \224\22 { Ok(4.0) }\0A    else if c == \225\22 { Ok(5.0) }\0A    else if c == \226\22 { Ok(6.0) }\0A    else if c == \227\22 { Ok(7.0) }\0A    else if c == \228\22 { Ok(8.0) }\0A    else if c == \229\22 { Ok(9.0) }\0A    else { Err(\22not a digit\22) }\0A\0Alet pow10 (n: Int): Float = if n <= 0 { 1.0 } else { pow10(n - 1) * 10.0 }\0Alet pow10_float (n: Float): Float = if n <= 0.0 { 1.0 } else { pow10_float(n - 1.0) * 10.0 }\0A\0Alet parse_digits_acc (chars: Array[String]) (pos: Int) (acc: Float) (any: Bool): Result[ParseResult[Float], String] =\0A    if pos >= chars.len() {\0A        if any { Ok(ParseResult { value: acc, next_pos: pos }) } else { Err(\22expected digit\22) }\0A    } else {\0A        match digit_value(chars[pos]) {\0A            Ok(d) => parse_digits_acc(chars, pos + 1, acc * 10.0 + d, true),\0A            Err(_) => if any { Ok(ParseResult { value: acc, next_pos: pos }) } else { Err(\22expected digit\22) },\0A        }\0A    }\0A\0Alet parse_digits (chars: Array[String]) (pos: Int): Result[ParseResult[Float], String] = parse_digits_acc(chars, pos, 0.0, false)\0A\0Alet parse_number (chars: Array[String]) (pos: Int): Result[ParseResult[Float], String] = {\0A    let neg = pos < chars.len() && chars[pos] == \22-\22;\0A    let start = if neg { pos + 1 } else { pos };\0A    match parse_digits(chars, start) {\0A        Err(e) => Err