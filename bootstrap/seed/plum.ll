@.str39609 = private global { i64, i64, [21203 x i8] } { i64 -1, i64 21202, [21203 x i8] c"/**\0A *  Constant-time functions\0A *\0A *  Copyright The Mbed TLS Contributors\0A *  SPDX-License-Identifier: Apache-2.0 OR GPL-2.0-or-later\0A */\0A\0A#ifndef MBEDTLS_CONSTANT_TIME_IMPL_H\0A#define MBEDTLS_CONSTANT_TIME_IMPL_H\0A\0A#include <stddef.h>\0A\0A#include \22common.h\22\0A\0A#if defined(MBEDTLS_BIGNUM_C)\0A#include \22mbedtls/bignum.h\22\0A#endif\0A\0A/*\0A * To improve readability of constant_time_internal.h, the static inline\0A * definitions are here, and constant_time_internal.h has only the declarations.\0A *\0A * This results in duplicate declarations of the form:\0A *     static inline void f();         // from constant_time_internal.h\0A *     static inline void f() { ... }  // from constant_time_impl.h\0A * when constant_time_internal.h is included.\0A *\0A * This appears to behave as if the declaration-without-definition was not present\0A * (except for warnings if gcc -Wredundant-decls or similar is used).\0A *\0A * Disable -Wredundant-decls so that gcc does not warn about this. This is re-enabled\0A * at the bottom of this file.\0A */\0A#if defined(MBEDTLS_COMPILER_IS_GCC) && (__GNUC__ > 4)\0A    #pragma GCC diagnostic push\0A    #pragma GCC diagnostic ignored \22-Wredundant-decls\22\0A#endif\0A\0A/* armcc5 --gnu defines __GNUC__ but doesn't support GNU's extended asm */\0A#if defined(MBEDTLS_HAVE_ASM) && defined(__GNUC__) && (!defined(__ARMCC_VERSION) || \5C\0A    __ARMCC_VERSION >= 6000000)\0A#define MBEDTLS_CT_ASM\0A#if (defined(__arm__) || defined(__thumb__) || defined(__thumb2__))\0A#define MBEDTLS_CT_ARM_ASM\0A#elif defined(__aarch64__)\0A#define MBEDTLS_CT_AARCH64_ASM\0A#elif defined(__amd64__) || defined(__x86_64__)\0A#define MBEDTLS_CT_X86_64_ASM\0A#elif defined(__i386__)\0A#define MBEDTLS_CT_X86_ASM\0A#endif\0A#endif\0A\0A#define MBEDTLS_CT_SIZE (sizeof(mbedtls_ct_uint_t) * 8)\0A\0A\0A/* ============================================================================\0A * Core const-time primitives\0A */\0A\0A/* Ensure that the compiler cannot know the value of x (i.e., cannot optimise\0A * based on its value) after this function is called.\0A *\0A * If we are not using assembly, this will be fairly inefficient, so its use\0A * should be minimised.\0A */\0A\0A#if !defined(MBEDTLS_CT_ASM)\0Aextern volatile mbedtls_ct_uint_t mbedtls_ct_zero;\0A#endif\0A\0A/**\0A * \5Cbrief   Ensure that a value cannot be known at compile time.\0A *\0A * \5Cparam x        The value to hide from the compiler.\0A * \5Creturn         The same value that was passed in, such that the compiler\0A *                 cannot prove its value (even for calls of the form\0A *                 x = mbedtls_ct_compiler_opaque(1), x will be unknown).\0A *\0A * \5Cnote           This is mainly used in constructing mbedtls_ct_condition_t\0A *                 values and performing operations over them, to ensure that\0A *                 there is no way for the compiler to ever know anything about\0A *                 the value of an mbedtls_ct_condition_t.\0A */\0Astatic inline mbedtls_ct_uint_t mbedtls_ct_compiler_opaque(mbedtls_ct_uint_t x)\0A{\0A#if defined(MBEDTLS_CT_ASM)\0A    asm volatile (\22\22 : [x] \22+r\22 (x) :);\0A    return x;\0A#else\0A    return x ^ mbedtls_ct_zero;\0A#endif\0A}\0A\0A/*\0A * Selecting unified syntax is needed for gcc, and harmless on clang.\0A *\0A * This is needed because on Thumb 1, condition flags are always set, so\0A * e.g. \22negs\22 is supported but \22neg\22 is not (on Thumb 2, both exist).\0A *\0A * Under Thumb 1 unified syntax, only the \22negs\22 form is accepted, and\0A * under divided syntax, only the \22neg\22 form is accepted. clang only\0A * supports unified syntax.\0A *\0A * On Thumb 2 and Arm, both compilers are happy with the \22s\22 suffix,\0A * although we don't actually care about setting the flags.\0A *\0A * For old versions of gcc (see #8516 for details), restore divided\0A * syntax afterwa