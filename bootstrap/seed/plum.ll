@.str39312 = private global { i64, i64, [5153 x i8] } { i64 -1, i64 5152, [5153 x i8] c"/**\0A * \5Cfile threading.h\0A *\0A * \5Cbrief Threading abstraction layer\0A */\0A/*\0A *  Copyright The Mbed TLS Contributors\0A *  SPDX-License-Identifier: Apache-2.0 OR GPL-2.0-or-later\0A */\0A#ifndef MBEDTLS_THREADING_H\0A#define MBEDTLS_THREADING_H\0A#include \22mbedtls/private_access.h\22\0A\0A#include \22mbedtls/build_info.h\22\0A\0A#include <stdlib.h>\0A\0A#ifdef __cplusplus\0Aextern \22C\22 {\0A#endif\0A\0A/** Bad input parameters to function. */\0A#define MBEDTLS_ERR_THREADING_BAD_INPUT_DATA              -0x001C\0A/** Locking / unlocking / free failed with error code. */\0A#define MBEDTLS_ERR_THREADING_MUTEX_ERROR                 -0x001E\0A\0A#if defined(MBEDTLS_THREADING_PTHREAD)\0A#include <pthread.h>\0Atypedef struct mbedtls_threading_mutex_t {\0A    pthread_mutex_t MBEDTLS_PRIVATE(mutex);\0A\0A    /* WARNING - state should only be accessed when holding the mutex lock in\0A     * framework/tests/src/threading_helpers.c, otherwise corruption can occur.\0A     * state will be 0 after a failed init or a free, and nonzero after a\0A     * successful init. This field is for testing only and thus not considered\0A     * part of the public API of Mbed TLS and may change without notice.*/\0A    char MBEDTLS_PRIVATE(state);\0A\0A} mbedtls_threading_mutex_t;\0A#endif\0A\0A#if defined(MBEDTLS_THREADING_ALT)\0A/* You should define the mbedtls_threading_mutex_t type in your header */\0A#include \22threading_alt.h\22\0A\0A/**\0A * \5Cbrief           Set your alternate threading implementation function\0A *                  pointers and initialize global mutexes. If used, this\0A *                  function must be called once in the main thread before any\0A *                  other Mbed TLS function is called, and\0A *                  mbedtls_threading_free_alt() must be called once in the main\0A *                  thread after all other Mbed TLS functions.\0A *\0A * \5Cnote            mutex_init() and mutex_free() don't return a status code.\0A *                  If mutex_init() fails, it should leave its argument (the\0A *                  mutex) in a state such that mutex_lock() will fail when\0A *                  called with this argument.\0A *\0A * \5Cparam mutex_init    the init function implementation\0A * \5Cparam mutex_free    the free function implementation\0A * \5Cparam mutex_lock    the lock function implementation\0A * \5Cparam mutex_unlock  the unlock function implementation\0A */\0Avoid mbedtls_threading_set_alt(void (*mutex_init)(mbedtls_threading_mutex_t *),\0A                               void (*mutex_free)(mbedtls_threading_mutex_t *),\0A                               int (*mutex_lock)(mbedtls_threading_mutex_t *),\0A                               int (*mutex_unlock)(mbedtls_threading_mutex_t *));\0A\0A/**\0A * \5Cbrief               Free global mutexes.\0A */\0Avoid mbedtls_threading_free_alt(void);\0A#endif /* MBEDTLS_THREADING_ALT */\0A\0A#if defined(MBEDTLS_THREADING_C)\0A/*\0A * The function pointers for mutex_init, mutex_free, mutex_ and mutex_unlock\0A *\0A * All these functions are expected to work or the result will be undefined.\0A */\0Aextern void (*mbedtls_mutex_init)(mbedtls_threading_mutex_t *mutex);\0Aextern void (*mbedtls_mutex_free)(mbedtls_threading_mutex_t *mutex);\0Aextern int (*mbedtls_mutex_lock)(mbedtls_threading_mutex_t *mutex);\0Aextern int (*mbedtls_mutex_unlock)(mbedtls_threading_mutex_t *mutex);\0A\0A/*\0A * Global mutexes\0A */\0A#if defined(MBEDTLS_FS_IO)\0Aextern mbedtls_threading_mutex_t mbedtls_threading_readdir_mutex;\0A#endif\0A\0A#if defined(MBEDTLS_HAVE_TIME_DATE) && !defined(MBEDTLS_PLATFORM_GMTIME_R_ALT)\0A/* This mutex may or may not be used in the default definition of\0A * mbedtls_platform_gmtime_r(), but in order to determine that,\0A * we need to check POSIX features, hence modify _POSIX_C_SOURCE.\0A * With the current approach, this declaration is orphaned, lacking\0A * an accompanying definition, in case mbedtls_platform_gmtime_r()\0A * doesn't need it, but that's not a problem. */\0Aextern mbedtls_threading_mutex_t mbedtls_threading_gmtime_mutex;\0A#endif /* MBEDTLS_HAVE_TIME_DATE && !MBEDTLS_PLATFORM_GMTIME_R_ALT */\0A\0A#if defined(MBEDTLS_PSA_CRYPTO_C)\0A/*\0A * A mutex used to make the PSA subsystem thread safe.\0A *\0A * key_slot_mutex protects the registered_readers and\0A * state variable for all key slots in &global_data.key_slots.\0A *\0A * This mutex must be held when any read from or write to a state or\0A * registered_readers field is performed, i.e. when calling functions:\0A * psa_key_slot_state_transition(), psa_register_read(), psa_unregister_read(),\0A * psa_key_slot_has_readers() and psa_wipe_key_slot(). */\0Aextern mbedtls_threading_mutex_t mbedtls_threading_key_slot_mutex;\0A\0A/*\0A * A mutex used to make the non-rng PSA global_data struct members thread safe.\0A *\0A * This mutex must be held when reading or writing to any of the PSA global_data\0A * structure members, other than the rng_state or rng struct. */\0Aextern mbedtls_threading_mutex_t mbedtls_threading_psa_globaldata_mutex;\0A\0A/*\0A * A mutex used to make the PSA global_data rng data thread safe.\0A *\0A * This mutex must be held when reading or writing to the PSA\0A * global_data rng_state or rng struct members. */\0Aextern mbedtls_threading_mutex_t mbedtls_threading_psa_rngdata_mutex;\0A#endif\0A\0A#endif /* MBEDTLS_THREADING_C */\0A\0A#ifdef __cplusplus\0A}\0A#endif\0A\0A#endif /* threading.h */\0A\00" }
