What goes after the method in an HTTP request line: the path, plus\0A/// the query exactly as it arrived. Not the fragment; a fragment is\0A/// never sent to a server.\0Apub let request_target (u: Url): String =\0A    if String.is_empty(u.raw_query) { u.path } else { u.path.concat(\22?\22).concat(u.raw_query) }\0A\0A/// Host, re-bracketed if it is an IPv6 literal, plus the port when\0A/// it is not the scheme's default.\0A///\0A/// This is what an HTTP `Host:` header wants (RFC 7230 section 5.4)\0A/// and what a URL's authority component is, which is the same string\0A/// for the same reasons, so it is written once here rather than\0A/// twice, once in `stringify` and once in the HTTP client.\0A///\0A/// The brackets have to come back: they were stripped on the way in\0A/// because `getaddrinfo` wants `::1`, but any context that puts a\0A/// host next to a `:port` needs them or the colons are ambiguous.\0Apub let authority (u: Url): String = {\0A    let host = if String.contains(u.host, \22:\22) { \22[\22.concat(u.host).concat(\22]\22) } else { u.host };\0A    if u.port == default_port(u.scheme) || u.port == 0 { host }\0A    else { host.concat(\22:\22).concat(u.port.to_string()) }\0A}\0A\0A/// The port is omitted when it is the scheme's default, and an IPv6\0A/// host is re-bracketed, so this is CANONICAL output rather than a\0A/// byte-for-byte reproduction of whatever was parsed. `parse` after\0A/// `stringify` yields the same `Url`, which is the invariant that\0A/// matters and the one the properties check.\0Apub let stringify (u: Url): String = {\0A    let frag = if String.is_empty(u.fragment) { \22\22 } else { \22#\22.concat(u.fragment) };\0A    u.scheme.concat(\22://\22).concat(authority(u)).concat(request_target(u)).concat(frag)\0A}\0A\0A/// --- Query access ---\0A///\0A/// Values come back DECODED. `parse` already proved every escape in\0A/// the query decodes to text, so the fallback below cannot be reached\0A/// for a `Url` that came from `parse`; it exist