ary(-1)` is \22-1\22. Both are right about\0A/// different questions.\0Apub let Int.to_bits (n: Int): String = plum__bits_acc(n, 63, \22\22)\0A\0Alet plum__bits_acc (n: Int) (i: Int) (acc: String): String =\0A    if i < 0 { acc }\0A    else { plum__bits_acc(n, i - 1, acc.concat(if Int.shr_logical(n, i) & 1 == 1 { \221\22 } else { \220\22 })) }\0A\0A/// The same, in hex: sixteen digits, two's complement, zero padded.\0Apub let Int.to_hex_bits (n: Int): String = plum__hex_bits_acc(n, 60, \22\22)\0A\0Alet plum__hex_bits_acc (n: Int) (i: Int) (acc: String): String =\0A    if i < 0 { acc }\0A    else { plum__hex_bits_acc(n, i - 4, acc.concat(plum__radix_digit(Int.shr_logical(n, i) & 15))) }\0A\0Alet plum__pad (s: String) (width: Int) (fill: String) (left: Bool): String = {\0A    let n = String.char_len(s);\0A    if String.char_len(fill) != 1 || n >= width { s }\0A    else {\0A        let padding = String.repeat(fill, width - n);\0A        if left { padding.concat(s) } else { s.concat(padding) }\0A    }\0A}\0A\0A/// `print` is `println` without the newline. Its `env_var` and\0A/// file/process neighbours moved to the `Os` module in 0.0.9;\0A/// output stayed here, because a program that prints is not\0A/// thereby doing operating-system work.\0Alet print_raw (s: String): Bool = false\0A\0A/// Writes to standard output with NO trailing newline. `println` is\0A/// the one that adds one.\0Apub let print (s: String): Unit = { print_raw(s); () }\0A\0Alet wrapping_add_raw (a: Int) (b: Int): Int = 0\0Alet wrapping_sub_raw (a: Int) (b: Int): Int = 0\0Alet wrapping_mul_raw (a: Int) (b: Int): Int = 0\0A\0A/// Addition that WRAPS on overflow, two's complement, instead of\0A/// stopping the program.\0A///\0A/// `+` is the one to reach for. It aborts on overflow, deliberately,\0A/// because an integer that silently became negative is a wrong\0A/// answer that keeps running. This is for the cases where wrapping is\0A/// the SPECIFICATION rather than an accident: hashes, checksums,\0A/// fixed-width binary protocols, and generators like PCG or\0A/// splitmix64 that are defined mod 2^64.\0A///\0A/// It is a named function and not an operator so that it is visible\0A/// at the call site. Wrapping should be asked for, not defaulted to.\0Apub let Int.wrapping_add (a: Int) (b: Int): Int = wrapping_add_raw(a, b)\0A\0A/// Subtraction that WRAPS on overflow. See `Int.wrapping_add`.\0Apub let Int.wrapping_sub (a: Int) (b: Int): Int = wrapping_sub_raw(a, b)\0A\0A/// Multiplication that WRAPS on overflow. See `Int.wrapping_add`.\0A///\0A/// This is the one most algorithms actually need: FNV-1a, xxHash and\0A/// splitmix64 are all a wrapping multiply by a large constant\0A/// followed by a mix.\0Apub let Int.wrapping_mul (a: Int) (b: Int): Int = wrapping_mul_raw(a, b)\0A\0Alet plum__string_hash_acc (b: Bytes) (i: Int) (n: Int) (h: Int): Int =\0A    if i >= n { h & 9223372036854775807 }\0A    else { plum__string_hash_acc(b, i + 1, n, Int.wrapping_mul(h ^ Option.unwrap_or(Bytes.at(b, i), 0), 1099511628211)) }\0A\0A/// A hash of the string's bytes, for bucketing.\0A///\0A/// Not stable across releases and not cryptographic — do not persist\0A/// it, and do not use it for anything security-related.\0A///\0A/// FNV-1a, kept in Plum now that `Int.wrapping_mul` can express its\0A/// modulo-2^64 multiply. The final sign-bit mask is required: `Map`\0A/// uses the result with `%`, which needs a non-negative index.\0Apub let String.hash (s: String): Int = {\0A    let b = s.as_bytes();\0A    plum__string_hash_acc(b, 0, b.len(), -3750763034362895579)\0A}\0A\0A/// Whether a one-character string is an ASCII space, tab, newline or\0A/// carriage return. Unicode spaces are not included.\0Apub let String.is_ascii_ws (c: String): Bool = c == \22 \22 || c == \22\5Ct\22 || c == \22\5Cn\22 || c == \22\5Cr\22\0A\0Alet plum__string_matches_at (cs: Array[String]) (needle: Array[String]) (base: Int) (j: Int): Bool =\0A    if j >= needle.len() { true }\0A    else if cs[base + j] != needle[j] { false }\0A    else { plum__string_matches_at(cs, needle, base, j + 1) }\0A\0Alet plum__string_index_of_acc (cs: Array[String]) (needle: Array[String]) (i: Int): Option[Int] =\0A    if i + needle.len() > cs.len() { None }\0A    else if plum__string_matches_at(cs, needle, i, 0) { Some(i) }\0A    else { plum__string_index_of_acc(cs, needle, i + 1) }\0A/// The CHARACTER index where `needle` first appears, or `None`.\0Apub let String.index_of (s: String) (needle: String): Option[Int] = plum__string_index_of_acc(chars_of(s), chars_of(needle), 0)\0A\0A/// --- Namespaced forms of the string METHODS ---\0A///\0A/// `.len()`, `.split()`, `.replace()` and friends are compiler\0A/// PRIMITIVES lowered straight to IR, so they existed only as\0A/// methods, while `String.slice`/`index_of`/`lines`/`repeat`/\0A/// `trim_start`/`trim_end` are ordinary prelude functions and so\0A/// existed only namespaced. That split tracks how each one happens\0A/// to be implemented, which is invisible from outside and produced\0A/// a genuinely confusing surface: `\22x\22.trim()` worked and\0A/// `String.trim(\22x\22)` did not, while `String.trim_start(\22x\22)`\0A/// worked and `\22x\22.trim_start()` did not. Same family, opposite\0A/// rules, no way to tell which without trying.\0A///\0A/// The rule now: `String.f(s, ..)` always works. Some also have\0A/// method sugar. These wrappers cost nothing when unused --\0A/// dead-function elimination drops them.\0A/// The number of BYTES. `String.char_len` is the character count, and\0A/// the two differ for anything outside ASCII.\0Apub let String.len (s: String): Int = s.len()\0A/// Splits on every occurrence of `sep`.\0A///\0A/// A separator at either end produces an empty piece, so splitting\0A/// `\5C\22,a,\5C\22` on `\5C\22,\5C\22` gives three pieces. Splitting on an empty\0A/// separator gives the characters.\0Apub let String.split (s: String) (sep: String): Array[String] = s.split(sep)\0A/// Whether `needle` appears anywhere.\0Apub let String.contains (s: String) (needle: String): Bool = s.contains(needle)\0A/// Whether the string begins with `prefix`.\0Apub let String.starts_with (s: String) (prefix: String): Bool = s.starts_with(prefix)\0A/// Whether the string ends with `suffix`.\0Apub let String.ends_with (s: String) (suffix: String): Bool = s.ends_with(suffix)\0A/// Every occurrence of `from` replaced with `to`. An empty `from`\0A/// leaves the string alone rather than looping.\0Apub let String.replace (s: String) (from: String) (to: String): String = s.replace(from, to)\0A/// Uppercased. ASCII only: letters outside it are left as they are,\0A/// so this is not a general Unicode case mapping.\0Apub let String.to_upper (s: String): String = s.to_upper()\0A/// Lowercased. ASCII only — see `String.to_upper`.\0Apub let String.to_lower (s: String): String = s.to_lower()\0A/// Whitespace removed from both ends, including Unicode spaces.\0Apub let String.trim (s: String): String = s.trim()\0A\0Alet bytes_of_str_raw (s: String): Bytes = bytes_of_str_raw(s)\0Alet str_of_bytes_raw (b: Bytes): String = \22\22\0Alet bytes_len_raw (b: Bytes): Int = 0\0Alet bytes_at_raw (b: Bytes) (i: Int): Int = 0\0Alet bytes_slice_raw (b: Bytes) (start: Int) (end: Int): Bytes = bytes_slice_raw(b, start, end)\0Alet bytes_concat_raw (a: Bytes) (b: Bytes): Bytes = bytes_concat_raw(a, b)\0Alet bytes_from_array_raw (xs: Array[Int]): Bytes = bytes_from_array_raw(xs)\0A\0A/// No bytes.\0Apub let Bytes.empty (): Bytes = bytes_of_str_raw(\22\22)\0A\0A/// How many bytes.\0Apub let Bytes.len (b: Bytes): Int = bytes_len_raw(b)\0A/// Whether there are no bytes.\0Apub let Bytes.is_empty (b: Bytes): Bool = bytes_len_raw(b) == 0\0A\0A/// Free in both directions at runtime; the DIRECTION is what differs.\0A/// Every String is bytes, so this one is total.\0A/// The string's bytes, as UTF-8. No copy of the text is decoded, so\0A/// this is the cheap direction.\0Apub let String.as_bytes (s: String): Bytes = bytes_of_str_raw(s)\0A/// The string's UTF-8 bytes. The same as `String.as_bytes`, named for\0A/// a caller thinking in bytes.\0Apub let Bytes.from_string (s: String): Bytes = bytes_of_str_raw(s)\0A\0A/// Not every Bytes is a String, so this one is not. This is the ONE\0A/// place the UTF-8 promise is established rather than assumed. The\0A/// reason the two types are distinct at all.\0A/// Written in Plum, not as a runtime primitive, because it needs\0A/// nothing the two byte primitives above do not already provide --\0A/// and this prelude's rule is that only what CANNOT be written here\0A/// goes into hand-written IR.\0A///\0A/// Full UTF-8, not just a lead-byte check: the ranges below reject\0A/// overlong encodings (C0/C1, and E0/F0 with a too-small second\0A/// byte), the UTF-16 surrogate block (ED A0..BF, which is why ED is\0A/// singled out), and anything past U+10FFFF (F5..FF, and F4 with a\0A/// second byte over 8F). A validator that only checked continuation\0A/// bytes would accept all four, and each one is a real way for a\0A/// decoder downstream to disagree about what this buffer says.\0Alet plum__is_cont (b: Bytes) (i: Int): Bool = {\0A    let v = bytes_at_raw(b, i);\0A    v >= 128 && v <= 191\0A}\0A\0Alet plum__utf8_ok (b: Bytes) (i: Int) (n: Int): Bool =\0A    if i >= n { true }\0A    else {\0A        let c = bytes_at_raw(b, i);\0A        // ASCII.\0A        if c < 128 { plum__utf8_ok(b, i + 1, n) }\0A        // A continuation byte with no lead (80..BF), or an overlong\0A        // two-byte form (C0/C1).\0A        else if c < 194 { false }\0A        // Two bytes: C2..DF.\0A        else if c < 224 {\0A            if i + 1 >= n { false }\0A            else if !plum__is_cont(b, i + 1) { false }\0A            else { plum__utf8_ok(b, i + 2, n) }\0A        }\0A        // Three bytes: E0..EF. E0 must not be overlong (second byte\0A        // A0..BF) and ED must not encode a surrogate (second byte\0A        // 80..9F).\0A        else if c < 240 {\0A            if i + 2 >= n { false }\0A            else {\0A                let c1 = bytes_at_raw(b, i + 1);\0A                let lo = if c == 224 { 160 } else { 128 };\0A                let hi = if c == 237 { 159 } else { 191 };\0A                if c1 < lo || c1 > hi { false }\0A                else if !plum__is_cont(b, i + 2) { false }\0A                else { plum__utf8_ok(b, i + 3, n) }\0A            }\0A        }\0A        // Four bytes: F0..F4. F0 must not be overlong (second byte\0A        // 90..BF) and F4 must not exceed U+10FFFF (second byte\0A        // 80..8F).\0A        else if c < 245 {\0A            if i + 3 >= n { false }\0A            else {\0A                let c1 = bytes_at_raw(b, i + 1);\0A                let lo = if c == 240 { 144 } else { 128 };\0A                let hi = if c == 244 { 143 } else { 191 };\0A                if c1 < lo || c1 > hi { false }\0A                else if !plum__is_cont(b, i + 2) { false }\0A                else if !plum__is_cont(b, i + 3) { false }\0A                else { plum__utf8_ok(b, i + 4, n) }\0A            }\0A        }\0A        // F5..FF: past the end of the encodable range.\0A        else { false }\0A    }\0A\0A/// Whether these bytes are valid UTF-8, without building a string.\0Apub let Bytes.is_utf8 (b: Bytes): Bool = plum__utf8_ok(b, 0, bytes_len_raw(b))\0A/// Decodes UTF-8 into a string.\0A///\0A/// `Err` when the bytes are not valid UTF-8 — which is why this is a\0A/// `Result` and `String.as_bytes` is not. Bytes arrive from files and\0A/// sockets, and not all of them are text.\0Apub let Bytes.as_string (b: Bytes): Result[String, String] =\0A    if Bytes.is_utf8(b) { Ok(str_of_bytes_raw(b)) }\0A    else { Err(\22Bytes.as_string: not valid UTF-8\22) }\0A\0A/// BYTE indices, throughout. `Bytes.slice` can and will split a\0A/// multi-byte character in half, which is the operation `String`\0A/// deliberately does not offer, and the reason a program reaching for\0A/// bytes reached for them.\0A///\0A/// Clamped rather than aborting, matching `Array.slice`.\0A/// Bytes from `start` up to but not including `end`, with bounds\0A/// clamped. A slice can split a multi-byte character, so the result is\0A/// not guaranteed to be valid UTF-8.\0Apub let Bytes.slice (b: Bytes) (start: Int) (end: Int): Bytes = {\0A    let n = bytes_len_raw(b);\0A    let lo = if start < 0 { 0 } else if start > n { n } else { start };\0A    let hi = if end < lo { lo } else if end > n { n } else { end };\0A    bytes_slice_raw(b, lo, hi)\0A}\0A\0A/// The two runs of bytes, joined.\0Apub let Bytes.concat (a: Bytes) (b: Bytes): Bytes = bytes_concat_raw(a, b)\0A\0A/// `None` rather than an abort for an out-of-range index: a byte\0A/// buffer is usually being walked by a parser that does not know how\0A/// long it is yet, and `Option` is how the rest of this prelude says\0A/// \22nothing there\22 (`Array.first`, `Map.get`).\0A/// The byte at `i` as a number 0-255, or `None` when out of range.\0Apub let Bytes.at (b: Bytes) (i: Int): Option[Int] =\0A    if i < 0 { None } else if i >= bytes_len_raw(b) { None } else { Some(bytes_at_raw(b, i)) }\0A\0A/// Each element is one byte, 0-255. Values outside that range are\0A/// masked to their low 8 bits rather than rejected. `from_array` is\0A/// a construction helper, and a `Result` here would put error handling\0A/// in front of every literal buffer.\0A/// Bytes from numbers. Values outside 0-255 are truncated to their\0A/// low eight bits.\0Apub let Bytes.from_array (xs: Array[Int]): Bytes = bytes_from_array_raw(xs)\0A\0A/// The way back in from C, and the counterpart to `.as_cstr()`.\0A///\0A/// Takes an explicit LENGTH, which is the whole difference from\0A/// `CStr.as_string()`: that one stops at the first NUL because a\0A/// `char*` alone cannot say how long it is, and any C API returning\0A/// bytes has to hand back a count separately. Given the count, this\0A/// is binary-safe. Given a wrong one, it reads whatever is\0A/// next in memory, exactly as the equivalent C would.\0A///\0A/// COPIES into a fresh cell. C buffers are routinely static, reused\0A/// on the next call, or freed by the callee; the copy is what makes\0A/// the result an ordinary owned Plum value.\0Alet bytes_from_cstr_raw (c: CStr) (len: Int): Bytes = bytes_from_cstr_raw(c, len)\0A/// Copies `len` bytes from a C pointer.\0A///\0A/// For `extern \5C\22C\5C\22` results only, and `unsafe` for the obvious reason:\0A/// nothing checks that the pointer is valid or that `len` is right.\0Apub let Bytes.from_cstr (c: CStr) (len: Int): Bytes =\0A    if len <= 0 { Bytes.empty() } else { bytes_from_cstr_raw(c, len) }\0A\0Alet plum__bytes_to_array_acc (b: Bytes) (i: Int) (n: Int) (acc: Array[Int]): Array[Int] =\0A    if i >= n { acc } else { plum__bytes_to_array_acc(b, i + 1, n, acc.push(bytes_at_raw(b, i))) }\0A/// The bytes as numbers 0-255.\0Apub let Bytes.to_array (b: Bytes): Array[Int] = plum__bytes_to_array_acc(b, 0, bytes_len_raw(b), [])\0A\0A/// Lowercase hex, two characters per byte, no separator.\0A///\0A/// This is what `.to_string()` would have to be if `Bytes` had one,\0A/// and the reason it does not: hex is A rendering, not THE rendering,\0A/// and picking it silently would make `.to_string()` mean something\0A/// different on this type than on every other. Named explicitly, the\0A/// caller decides.\0Alet plum__hex_digit (v: Int): String =\0A    if v == 0 { \220\22 } else if v == 1 { \221\22 } else if v == 2 { \222\22 } else if v == 3 { \223\22 }\0A    else if v == 4 { \224\22 } else if v == 5 { \225\22 } else if v == 6 { \226\22 } else if v == 7 { \227\22 }\0A    else if v == 8 { \228\22 } else if v == 9 { \229\22 } else if v == 10 { \22a\22 } else if v == 11 { \22b\22 }\0A    else if v == 12 { \22c\22 } else if v == 13 { \22d\22 } else if v == 14 { \22e\22 } else { \22f\22 }\0A\0Alet plum__bytes_hex_acc (b: Bytes) (i: Int) (n: Int) (acc: Array[String]): Array[String] =\0A    if i >= n { acc }\0A    else {\0A        let v = bytes_at_raw(b, i);\0A        plum__bytes_hex_acc(b, i + 1, n, acc.push(plum__hex_digit(v / 16)).push(plum__hex_digit(v % 16)))\0A    }\0A/// Lowercase hex, two characters per byte. `Encoding.hex_decode`\0A/// reads it back.\0Apub let Bytes.to_hex (b: Bytes): String = Array.concat_all(plum__bytes_hex_acc(b, 0, bytes_len_raw(b), []))\0A\0A/// The one string operation that had NEITHER form: there was no way\0A/// to join an array of strings with a separator at all.\0Alet plum__join_acc (parts: Array[String]) (sep: String) (i: Int) (acc: Array[String]): Array[String] =\0A    if i >= parts.len() { acc }\0A    else if i == 0 { plum__join_acc(parts, sep, 1, acc.push(parts[0])) }\0A    else { plum__join_acc(parts, sep, i + 1, acc.push(sep).push(parts[i])) }\0A\0A/// Namespaced under `Array`, not `String`, since 2026-08-25: both\0A/// take an `Array[String]`. `String.` used to mean two different\0A/// things, \22first parameter is a String\22 for most of it and\0A/// \22produces a String\22 for these two, and `x.f(a)` = `T.f(x, a)`\0A/// needs it to mean exactly one. `parts.join(\22, \22)` now works and\0A/// reads the right way round.\0Apub let Array.join (parts: Array[String]) (sep: String): String = Array.concat_all(plum__join_acc(parts, sep, 0, []))\0A\0Alet plum__string_digit_value (c: String): Result[Int, String] = match c {\0A    \220\22 => Ok(0), \221\22 => Ok(1), \222\22 => Ok(2), \223\22 => Ok(3), \224\22 => Ok(4),\0A    \225\22 => Ok(5), \226\22 => Ok(6), \227\22 => Ok(7), \228\22 => Ok(8), \229\22 => Ok(9),\0A    _ => Err(\22expected a digit, found \22.concat(c)),\0A}\0A\0A/// Int's minimum, which CANNOT be written as a literal: its\0A/// magnitude is out of range as a positive number, so the lexer\0A/// rejects `9223372036854775808` before any sign is applied.\0Alet plum__int_min (u: Unit): Int = 0 - 9223372036854775807 - 1\0A\0Alet plum__string_parse_int_acc (cs: Array[String]) (i: Int) (acc: Int) (any: Bool) (negative: Bool): Result[Int, String] =\0A    if i >= cs.len() { if any { Ok(acc) } else { Err(\22expected at least one digit\22) } }\0A    else { match plum__string_digit_value(cs[i]) {\0A        // Range is checked BEFORE multiplying, not after. `*` and\0A        // `+` on Int abort the program on overflow (2026-08-21), so\0A        // an out-of-range literal used to KILL a program that had\0A        // asked for a `Result` precisely so it could handle bad\0A        // input -- `String.parse_int(\2299999999999999999999\22)` printed\0A        // `integer overflow` and exited 1 instead of returning Err.\0A        // Before that change the backends wrapped and returned a\0A        // garbage number instead, which was no better.\0A        //\0A        // 922337203685477580 is Int::MAX / 10: one more and `acc * 10`\0A        // itself overflows.\0A        // Accumulated NEGATIVELY for a negative number, rather\0A        // than building the magnitude and negating at the end.\0A        // The magnitude of Int's minimum is one larger than its\0A        // maximum, so `-9223372036854775808` -- a perfectly good\0A        // Int -- overflowed while still positive and came back as\0A        // `integer out of range`. Found by a property test on\0A        // 2026-08-25; the Rust interpreter had the identical bug,\0A        // so `interp-check` agreed with it and saw nothing.\0A        Ok(d) => if negative {\0A            if acc < 0 - 922337203685477580 { Err(\22integer out of range\22) }\0A                     else if acc * 10 < plum__int_min(()) + d { Err(\22integer out of range\22) }\0A                     else { plum__string_parse_int_acc(cs, i + 1, acc * 10 - d, true, negative) }\0A        } else if acc > 922337203685477580 { Err(\22integer out of range\22) }\0A                 else if acc * 10 > 9223372036854775807 - d { Err(\22integer out of range\22) }\0A                 else { plum__string_parse_int_acc(cs, i + 1, acc * 10 + d, true, negative) },\0A        Err(e) => Err(e),\0A    } }\0A\0A/// Parses a decimal integer, with an optional leading `-`.\0A///\0A/// `Err` on anything else, including an empty string, surrounding\0A/// spaces, and a number too large for an `Int`. No `0x` or `0b`\0A/// prefixes — this is the inverse of `to_string`, not a literal\0A/// parser.\0Apub let String.parse_int (s: String): Result[Int, String] = {\0A    let cs = chars_of(s);\0A    if Array.is_empty(cs) { Err(\22empty string\22) }\0A    else if cs[0] == \22-\22 { plum__string_parse_int_acc(Array.slice(cs, 1, cs.len()), 0, 0, false, true) }\0A    else { plum__string_parse_int_acc(cs, 0, 0, false, false) }\0A}\0A\0A/// `String.parse_float` DELEGATES to the JSON number parser below,\0A/// exactly as the real prelude does.\0A///\0A/// It used to have a hand-written parser here, on the reasoning that\0A/// dragging a JSON parser in to read a float would be absurd. That\0A/// reasoning cost twice. The hand-written version accumulated the\0A/// fraction digit by digit against a repeatedly-divided 0.1, so\0A/// `0.000001` parsed as 1.0000000000000002e-06, invisible until\0A/// floats started printing every digit that matters. And its own\0A/// comment admitted the second cost: \22no exponent, which is a real\0A/// narrowing, stated rather than discovered\22. Stated, but it made\0A/// the two compilers DISAGREE. `String.parse_float(\221e3\22)` gave\0A/// 1000 under the real compiler and an error here.\0A///\0A/// The JSON parser was already in this same prelude, already\0A/// handling exponents, already correct. Reusing it is not absurd;\0A/// writing a second one was.\0A/// Overflow returns `Err`; underflow follows binary64 rounding to a\0A/// subnormal value or signed zero.\0Apub let String.parse_float (s: String): Result[Float, String] = {\0A    let cs = bytes_of_str_raw(s);\0A    match parse_number(cs, 0) {\0A        Ok(r) => if r.next_pos == bytes_len_raw(cs) { Ok(r.value) } else { Err(\22trailing characters after number\22) },\0A        Err(e) => Err(e),\0A    }\0A}\0A\0A// --- Sorting ---\0A\0A// Merge into a fresh, uniquely owned accumulator. Tail calls move it\0A// into the next push, so growth is amortized O(1) per element. Taking\0A// the left element on equality preserves the original order of ties.\0Alet plum__array_sort_merge_acc[T] (left: Array[T]) (right: Array[T]) (le: (T, T) -> Bool) (i: Int) (j: Int) (acc: Array[T]): Array[T] =\0A    if i >= left.len() {\0A        if j >= right.len() { acc }\0A        else { plum__array_sort_merge_acc(left, right, le, i, j + 1, acc.push(right[j])) }\0A    } else if j >= right.len() {\0A        plum__array_sort_merge_acc(left, right, le, i + 1, j, acc.push(left[i]))\0A    } else if le(left[i], right[j]) {\0A        plum__array_sort_merge_acc(left, right, le, i + 1, j, acc.push(left[i]))\0A    } else {\0A        plum__array_sort_merge_acc(left, right, le, i, j + 1, acc.push(right[j]))\0A    }\0A\0A// Split index ranges rather than copying slices of the input. Only\0A// the sorted runs and merge output allocate, with O(n) peak storage\0A// and O(log n) stack depth for the recursive splits.\0Alet plum__array_sort_range[T] (arr: Array[T]) (le: (T, T) -> Bool) (lo: Int) (hi: Int): Array[T] =\0A    if hi <= lo { [] }\0A    else if hi - lo == 1 { [arr[lo]] }\0A    else {\0A        let mid = lo + (hi - lo) / 2;\0A        let left = plum__array_sort_range(arr, le, lo, mid);\0A        let right = plum__array_sort_range(arr, le, mid, hi);\0A        plum__array_sort_merge_acc(left, right, le, 0, 0, [])\0A    }\0A\0A/// Sorted by a \5C\22less than or equal\5C\22 predicate.\0A///\0A/// STABLE: elements `le` considers equivalent keep their original\0A/// order, which is what makes sorting by one key and then another\0A/// produce the ordering people expect.\0A///\0A/// Merge sort with O(n log n) comparisons and O(n) auxiliary storage.\0Apub let Array.sort_by[T] (arr: Array[T]) (le: (T, T) -> Bool): Array[T] = plum__array_sort_range(arr, le, 0, arr.len())\0A\0A/// Sorted ascending.\0Apub let Array.sort_int (arr: Array[Int]): Array[Int] = Array.sort_by(arr, |a: Int, b: Int| a <= b)\0A/// Sorted ascending. NaN does not compare, so an array containing one\0A/// has no meaningful order.\0Apub let Array.sort_float (arr: Array[Float]): Array[Float] = Array.sort_by(arr, |a: Float, b: Float| a <= b)\0A\0A// `Array.sort_string` is deliberately ABSENT: the real prelude compares\0A// via `a.runes()`, and this compiler has no `.runes()` primitive. It\0A// belongs with `Float.sqrt` and friends -- the group that needs a\0A// runtime primitive rather than prelude source -- not here.\0A\0A// --- Zip ---\0A\0A/// A named struct, not a tuple, exactly as the real prelude has it.\0Apub struct Zipped[A, B] { pub first: A, pub second: B }\0A\0Alet plum__array_zip_acc[T, U] (a: Array[T]) (b: Array[U]) (i: Int) (acc: Array[Zipped[T, U]]): Array[Zipped[T, U]] =\0A    if i >= a.len() || i >= b.len() { acc } else { plum__array_zip_acc(a, b, i + 1, acc.push(Zipped { first: a[i], second: b[i] })) }\0A\0A/// Pairs elements positionally, stopping at the shorter array.\0Apub let Array.zip[T, U] (a: Array[T]) (b: Array[U]): Array[Zipped[T, U]] = plum__array_zip_acc(a, b, 0, [])\0A\0A// --- String trimming ---\0A\0Alet plum__string_ws_prefix_len_acc (chars: Array[String]) (i: Int): Int =\0A    if i >= chars.len() { i } else if String.is_ascii_ws(chars[i]) { plum__string_ws_prefix_len_acc(chars, i + 1) } else { i }\0A\0A/// Whitespace removed from the start.\0Apub let String.trim_start (s: String): String = {\0A    let chars = chars_of(s);\0A    Array.concat_all(Array.drop(chars, plum__string_ws_prefix_len_acc(chars, 0)))\0A}\0A\0A/// Whitespace removed from the end.\0Apub let String.trim_end (s: String): String = String.reverse(String.trim_start(String.reverse(s)))\0A\0A/// Split on newlines.\0A///\0A/// A trailing newline produces a final empty piece, since the text\0A/// after it is empty — which is what makes joining the result back\0A/// with newlines give the original.\0Apub let String.lines (s: String): Array[String] = s.split(\22\5Cn\22)\0A\0A// --- Numbers that need the runtime ---\0A\0A/// The real prelude writes these as `unsafe { fabs(x) }`,\0A/// `unsafe { sqrt(x) }` and friends.\0A/// This backend has no `extern \22C\22`/`unsafe` support, so they reach the\0A/// same libm functions as runtime primitives instead.\0Alet abs_raw (x: Float): Float = 0.0\0Alet sqrt_raw (x: Float): Float = 0.0\0Alet pow_raw (b: Float) (e: Float): Float = 0.0\0Alet floor_raw (x: Float): Float = 0.0\0Alet ceil_raw (x: Float): Float = 0.0\0Alet round_raw (x: Float): Float = 0.0\0Alet sin_raw (x: Float): Float = 0.0\0Alet cos_raw (x: Float): Float = 0.0\0Alet tan_raw (x: Float): Float = 0.0\0Alet asin_raw (x: Float): Float = 0.0\0Alet acos_raw (x: Float): Float = 0.0\0Alet atan_raw (x: Float): Float = 0.0\0Alet atan2_raw (y: Float) (x: Float): Float = 0.0\0Alet log_raw (x: Float): Float = 0.0\0Alet log2_raw (x: Float): Float = 0.0\0Alet log10_raw (x: Float): Float = 0.0\0Alet exp_raw (x: Float): Float = 0.0\0Alet float_fixed_raw (x: Float) (decimals: Int): String = \22\22\0Alet random_raw (ignored: Bool): Float = 0.0\0A\0A/// The square root. Negative input gives NaN rather than failing.\0Apub let Float.sqrt (x: Float): Float = sqrt_raw(x)\0A/// `base` raised to `exp`. A fractional exponent of a negative base\0A/// gives NaN.\0Apub let Float.pow (base: Float) (exp: Float): Float = pow_raw(base, exp)\0A/// The largest whole number no greater than `x` — toward negative\0A/// infinity, so `floor(-2.5)` is `-3.0`.\0Apub let Float.floor (x: Float): Float = floor_raw(x)\0A/// The smallest whole number no less than `x`.\0Apub let Float.ceil (x: Float): Float = ceil_raw(x)\0A/// The nearest whole number, halves AWAY FROM ZERO: `round(2.5)` is\0A/// `3.0` and `round(-2.5)` is `-3.0`.\0A///\0A/// `Float.to_fixed` rounds halves to EVEN, which is not an\0A/// inconsistency — it is what C, Python, Rust and Java all do, because\0A/// rounding is arithmetic and formatting is rendering.\0Apub let Float.round (x: Float): Float = round_raw(x)\0A\0A/// A float in `[0.0, 1.0)` from a process-wide generator seeded from\0A/// the clock.\0A///\0A/// Different every run, and NOT reproducible. `Rng.from_seed` is the\0A/// one for a test or a replay.\0Apub let Float.random (): Float = random_raw(true)\0A/// A float in `[lo, hi)`, from the same unseeded generator as\0A/// `Float.random`.\0Apub let Float.random_range (lo: Float) (hi: Float): Float = lo + (hi - lo) * Float.random(())\0A\0A/// --- Trigonometry, logs and constants (issue #20) ---\0A///\0A/// Angles are RADIANS everywhere, which is what libm takes and what the\0A/// inverse functions return. `Float.radians` and `Float.degrees` convert\0A/// at the edges, so a program that thinks in degrees converts once\0A/// rather than scattering `* 3.14159 / 180.0`.\0A/// Sine of an angle in RADIANS.\0Apub let Float.sin (x: Float): Float = sin_raw(x)\0A/// Cosine of an angle in radians.\0Apub let Float.cos (x: Float): Float = cos_raw(x)\0A/// Tangent of an angle in radians. Grows without bound near odd\0A/// multiples of pi/2 rather than failing.\0Apub let Float.tan (x: Float): Float = tan_raw(x)\0A/// The angle in radians whose sine is `x`, in `[-pi/2, pi/2]`. NaN\0A/// outside `[-1, 1]`.\0Apub let Float.asin (x: Float): Float = asin_raw(x)\0A/// The angle in radians whose cosine is `x`, in `[0, pi]`. NaN\0A/// outside `[-1, 1]`.\0Apub let Float.acos (x: Float): Float = acos_raw(x)\0A/// The angle in radians whose tangent is `x`. `Float.atan2` is the\0A/// one that knows which quadrant.\0Apub let Float.atan (x: Float): Float = atan_raw(x)\0A\0A/// `atan2(y, x)`, in that order, matching libm, Go, Python\0A/// and Java all use, and the reason it exists: it knows which QUADRANT\0A/// the point is in, which `atan(y / x)` cannot, and it does not divide\0A/// by zero when `x` is 0.\0Apub let Float.atan2 (y: Float) (x: Float): Float = atan2_raw(y, x)\0A\0A/// Natural log. `log2` and `log10` are separate rather than\0A/// `log(x) / log(2.0)`, because libm computes them directly and the\0A/// division loses accuracy at exactly the powers people check.\0A/// The natural logarithm. NaN for a negative argument, and negative\0A/// infinity at zero.\0Apub let Float.log (x: Float): Float = log_raw(x)\0A/// Base-2 logarithm, computed directly rather than as a division —\0A/// which is what keeps `log2(8.0)` exactly `3.0`.\0Apub let Float.log2 (x: Float): Float = log2_raw(x)\0A/// Base-10 logarithm, computed directly. See `Float.log2`.\0Apub let Float.log10 (x: Float): Float = log10_raw(x)\0A/// `e` raised to `x`.\0Apub let Float.exp (x: Float): Float = exp_raw(x)\0A\0A/// Constants as FUNCTIONS, because `Float.` is a type namespace and\0A/// `T.f(x)` is how a name gets into it. Written out to the last digit a\0A/// double can hold rather than computed, so they are exact literals and\0A/// not a rounding of something else.\0A/// Pi, to the last digit a double holds.\0Apub let Float.pi (): Float = 3.141592653589793\0A/// Two pi — a full turn, which is the more useful constant when\0A/// working with angles.\0Apub let Float.tau (): Float = 6.283185307179586\0A/// Euler's number.\0Apub let Float.e (): Float = 2.718281828459045\0A\0A/// Degrees to radians. Every trigonometric function here takes\0A/// radians, so this is the conversion at the edge.\0Apub let Float.radians (degrees: Float): Float = degrees * 3.141592653589793 / 180.0\0A/// Radians to degrees.\0Apub let Float.degrees (radians: Float): Float = radians * 180.0 / 3.141592653589793\0A\0A/// --- Seeded, reproducible random numbers (issue #20) ---\0A///\0A/// `Float.random` reads a process-global generator seeded from the\0A/// clock, which is right for \22give me something different each run\22 and\0A/// useless for a test or a replay. An `Rng` is a VALUE: same seed, same\0A/// sequence, on every platform and every run.\0A///\0A/// Every call returns the NEXT GENERATOR alongside the number, rather\0A/// than mutating in place, so a generator is as ordinary a value as an\0A/// `Int`. Threading it by hand is the cost; being able to replay a game\0A/// from a seed, or write a test that cannot flake, is what it buys. A\0A/// `Ref[Rng]` is the opt-in for in-place update.\0A///\0A/// --- Which generator, and why ---\0A///\0A/// SplitMix64: a small, modern 64-bit generator with a full 2^64\0A/// period. It is fast, has excellent bit diffusion, and is the right\0A/// generator when reproducibility and simple state matter more than\0A/// cryptographic secrecy. The wrapping multiply and logical shifts it\0A/// needs became expressible when `Int.wrapping_mul` and bitwise\0A/// operators landed.\0A///\0A/// **Not for cryptography, keys, tokens or passwords.** It is a\0A/// statistical generator and its entire state is recoverable from two\0A/// outputs.\0Apub struct Rng { state: Int }\0A\0Alet RNG_GAMMA: Int = -7046029254386353131\0Alet RNG_MIX_1: Int = -4658895280553007687\0Alet RNG_MIX_2: Int = -7723592293110705685\0Alet RNG_RANGE: Int = 9223372036854775807\0A\0A/// Any `Int` is a legal seed, including zero and negatives. SplitMix64\0A/// has no forbidden state, unlike generators whose all-zero state gets\0A/// stuck, so the seed is kept exactly rather than folded into a range.\0Apub let Rng.from_seed (seed: Int): Rng = Rng { state: seed }\0A\0Alet plum__mod_floor (a: Int) (m: Int): Int = {\0A    let r = a - (a / m) * m;\0A    if r < 0 { r + m } else { r }\0A}\0A\0A/// The raw step: advance by SplitMix64's golden-ratio increment, then\0A/// mix all 64 bits. Keep the sign bit here: wide integer ranges need\0A/// the full signed domain. Each caller reduces the output as needed.\0Alet rng_step (r: Rng): (Rng, Int) = {\0A    let next = Rng { state: Int.wrapping_add(r.state, RNG_GAMMA) };\0A    let z1 = Int.wrapping_mul(next.state ^ Int.shr_logical(next.state, 30), RNG_MIX_1);\0A    let z2 = Int.wrapping_mul(z1 ^ Int.shr_logical(z1, 27), RNG_MIX_2);\0A    (next, z2 ^ Int.shr_logical(z2, 31))\0A}\0A\0A/// A `Float` in `[0.0, 1.0)`. Use 53 exactly representable bits so\0A/// converting to `Float` cannot round the largest sample up to `1.0`.\0A/// The generator advances exactly once, as for previous versions;\0A/// float samples may differ because the discarded low bits no longer round.\0Apub let Rng.float (r: Rng): (Rng, Float) = {\0A    let (next, z) = rng_step(r);\0A    (next, Int.shr_logical(z & RNG_RANGE, 10).to_float() / 9007199254740992.0)\0A}\0A\0A/// A float in `[lo, hi)`, and the next generator.\0Apub let Rng.float_range (r: Rng) (lo: Float) (hi: Float): (Rng, Float) = {\0A    let (next, f) = Rng.float(r);\0A    (next, lo + (hi - lo) * f)\0A}\0A\0A/// `[lo, hi)`, the upper bound EXCLUDED, so `int_range(r, 0, xs.len())`\0A/// is an index into `xs` and needs no `- 1` anywhere.\0A/// All ordered `Int` bounds are supported, even when `hi - lo` would\0A/// overflow. `hi` must itself be an `Int`, so the maximum `Int` cannot\0A/// be included as a result of this half-open API.\0A///\0A/// Rejection sampling, not `z % span`. The modulo is biased whenever the\0A/// span does not divide the generator's range evenly: the low values\0A/// come up more often, by about one part in `range / span`. That is\0A/// invisible in a game and fatal in a shuffle, and the loop costs an\0A/// extra step only on the fraction of draws that land in the leftover\0A/// tail. Widths through the maximum `Int` preserve their seeded sequences.\0A/// Wider ranges reject full signed samples outside `[lo, hi)` instead;\0A/// they accept at least half of the domain, averaging at most two draws.\0A///\0A/// An empty or backwards range returns `lo` and does not draw, because\0A/// there is no number to return and a panic here would make an ordinary\0A/// off-by-one crash a program at random.\0Apub let Rng.int_range (r: Rng) (lo: Int) (hi: Int): (Rng, Int) = {\0A    if hi <= lo { (r, lo) } else {\0A        let span = Int.wrapping_sub(hi, lo);\0A        if span < 0 { rng_wide(r, lo, hi) } else { rng_below(r, span, lo) }\0A    }\0A}\0A\0A// Tail recursion keeps retries in constant stack space. No span or\0A// offset arithmetic is needed for ranges at least 2^63 wide.\0Alet rng_wide (r: Rng) (lo: Int) (hi: Int): (Rng, Int) = {\0A    let (next, z) = rng_step(r);\0A    if z < lo || z >= hi { rng_wide(next, lo, hi) } else { (next, z) }\0A}\0A\0Alet rng_below (r: Rng) (span: Int) (lo: Int): (Rng, Int) = {\0A    let range = RNG_RANGE;\0A    let limit = range - plum__mod_floor(range, span);\0A    let (next, raw) = rng_step(r);\0A    let z = raw & RNG_RANGE;\0A    if z >= limit { rng_below(next, span, lo) } else { (next, lo + plum__mod_floor(z, span)) }\0A}\0A\0A/// A boolean, evenly, and the next generator.\0Apub let Rng.bool (r: Rng): (Rng, Bool) = {\0A    let (next, v) = Rng.int_range(r, 0, 2);\0A    (next, v == 1)\0A}\0A\0A/// Fisher-Yates, walking from the end so every permutation is equally\0A/// likely. The naive version, swapping each element with any other, is\0A/// not uniform, and looks fine until somebody counts.\0Apub let Rng.shuffle[T] (r: Rng) (xs: Array[T]): (Rng, Array[T]) =\0A    rng_shuffle_acc(r, xs, xs.len() - 1)\0A\0Alet rng_shuffle_acc[T] (r: Rng) (xs: Array[T]) (i: Int): (Rng, Array[T]) =\0A    if i <= 0 { (r, xs) } else {\0A        let (next, j) = Rng.int_range(r, 0, i + 1);\0A        rng_shuffle_acc(next, plum__swap(xs, i, j), i - 1)\0A    }\0A\0Alet plum__swap[T] (xs: Array[T]) (i: Int) (j: Int): Array[T] =\0A    if i == j { xs } else {\0A        let a = xs[i];\0A        let b = xs[j];\0A        xs.set(i, b).set(j, a)\0A    }\0A\0A/// One element, or `None` from an empty array.\0Apub let Rng.choice[T] (r: Rng) (xs: Array[T]): (Rng, Option[T]) =\0A    if Array.is_empty(xs) { (r, None) } else {\0A        let (next, i) = Rng.int_range(r, 0, xs.len());\0A        (next, Some(xs[i]))\0A    }\0A\0A// --- String ordering ---\0A\0A/// Byte-lexicographic, which for UTF-8 IS codepoint order, so this\0A/// agrees with the real prelude's rune-by-rune comparison without\0A/// needing a `.runes()` decoder.\0Alet string_concat_all_raw (parts: Array[String]): String = \22\22\0A\0A/// Joins in ONE allocation. Building a large string by repeated\0A/// `.concat` is quadratic; this is what the compiler's own emitter\0A/// uses for anything that accumulates.\0Apub let Array.concat_all (parts: Array[String]): String = string_concat_all_raw(parts)\0A\0A/// Decimal text to the NEAREST double, via libc `strtod`.\0A///\0A/// `parse_number` below validates the grammar and finds where the\0A/// number ends, and that part was always right. What it got wrong was\0A/// the VALUE: building it as `mantissa * 10^exp` in floating point\0A/// accumulates rounding error, so `9.21258e-07` parsed to a double\0A/// one ulp away and `parse_float(x.to_string()) != x`. `to_string`\0A/// goes to real lengths to guarantee that round trip, retrying\0A/// at 15, 16 and 17 digits until `strtod` agrees, so the inverse\0A/// has to be the same `strtod`, not an approximation of it.\0A///\0A/// Found by a property test on 2026-08-25. The Rust interpreter\0A/// computed the identical wrong double, so `interp-check` agreed\0A/// with it and saw nothing.\0Alet parse_float_raw (s: String): Float = 0.0\0A\0Alet string_cmp_raw (a: String) (b: String): Int = 0\0A\0A/// Sorted by BYTE order, not by any locale's alphabet — so uppercase\0A/// sorts before lowercase, and accented letters sort after `z`.\0Apub let Array.sort_string (arr: Array[String]): Array[String] = Array.sort_by(arr, |a: String, b: String| a <= b)\0A\0A// --- Assertions ---\0A//\0A// Mirrored from the real prelude, message for message: a test that\0A// fails should read the same whichever compiler ran it.\0A\0A/// Stops the program unless `cond` holds.\0A///\0A/// For a condition the code depends on, not for input validation:\0A/// there is no way to catch this.\0Apub let assert (cond: Bool): Unit =\0A    if cond { () } else { panic_raw(\22assertion failed\22) }\0A\0A/// Stops the program unless the two are equal, printing BOTH — which\0A/// is the difference from `assert(a == b)` and the reason to prefer\0A/// it in a test.\0Apub let assert_eq[T] (a: T) (b: T): Unit =\0A    if a == b { () } else {\0A        panic_raw(\22assertion failed: left != right\5Cn  left:  \22.concat(a.to_string()).concat(\22\5Cn  right: \22).concat(b.to_string()))\0A    }\0A\0A/// Stops the program if the two are equal, printing them.\0Apub let assert_ne[T] (a: T) (b: T): Unit =\0A    if a != b { () } else {\0A        panic_raw(\22assertion failed: left == right\5Cn  left:  \22.concat(a.to_string()).concat(\22\5Cn  right: \22).concat(b.to_string()))\0A    }\0A\0A// --- Collections: Map and Set ---\0A\0A/// One key and value stored in a map bucket.\0Apub struct MapEntry[K, V] { key: K, value: V }\0A/// A hash map from `K` to `V`.\0A///\0A/// PERSISTENT: `Map.insert` returns a new map and leaves the original\0A/// alone, so a map can be shared without copying defensively. Keys\0A/// need `Eq` and `Hash`. Equal keys hash identically.\0A/// NaN is not a supported key, including inside aggregates, because\0A/// IEEE equality makes it unequal to itself. References use identity.\0Apub struct Map[K, V] { buckets: Array[Array[MapEntry[K, V]]], size: Int }\0A\0Alet MAP_INITIAL_BUCKETS: Int = 8\0Alet MAP_LOAD_FACTOR_NUM: Int = 3\0Alet MAP_LOAD_FACTOR_DEN: Int = 4\0A\0Alet map_make_buckets[K, V] (n: Int): Array[Array[MapEntry[K, V]]] = {\0A    let mut buckets = [];\0A    for i in 0..n { buckets = buckets.push([]); };\0A    buckets\0A}\0A\0Alet value_hash[T: Hash] (x: T): Int = x.hash()\0A\0Alet map_bucket_index[K: Hash] (k: K) (bucket_count: Int): Int = value_hash(k) % bucket_count\0A\0Alet map_bucket_find_index[K: Eq, V] (bucket: Array[MapEntry[K, V]]) (k: K) (i: Int): Int =\0A    if i >= bucket.len() { -1 }\0A    else if bucket[i].key == k { i }\0A    else { map_bucket_find_index(bucket, k, i + 1) }\0A\0A/// An empty map.\0Apub let Map.new[K, V] (): Map[K, V] = Map { buckets: map_make_buckets(MAP_INITIAL_BUCKETS), size: 0 }\0A\0Alet map_rehash[K: Hash, V] (m: Map[K, V]) (new_bucket_count: Int): Map[K, V] = {\0A    let mut new_buckets = map_make_buckets(new_bucket_count);\0A    for bucket in m.buckets {\0A        for entry in bucket {\0A            let idx = map_bucket_index(entry.key, new_bucket_count);\0A            new_buckets = new_buckets.set(idx, new_buckets[idx].push(entry));\0A        }\0A    };\0A    Map { buckets: new_buckets, size: m.size }\0A}\0A\0A/// A NEW map with `k` set to `v`, replacing any previous value. The\0A/// original is unchanged.\0Apub let Map.insert[K: Eq + Hash, V] (m: Map[K, V]) (k: K) (v: V): Map[K, V] = {\0A    let idx = map_bucket_index(k, m.buckets.len());\0A    let bucket = m.buckets[idx];\0A    let existing_i = map_bucket_find_index(bucket, k, 0);\0A    let inserted = if existing_i >= 0 {\0A        Map { buckets: m.buckets.set(idx, bucket.set(existing_i, MapEntry { key: k, value: v })), size: m.size }\0A    } else {\0A        Map { buckets: m.buckets.set(idx, bucket.push(MapEntry { key: k, value: v })), size: m.size + 1 }\0A    };\0A    if inserted.size * MAP_LOAD_FACTOR_DEN > inserted.buckets.len() * MAP_LOAD_FACTOR_NUM {\0A        map_rehash(inserted, inserted.buckets.len() * 2)\0A    } else {\0A        inserted\0A    }\0A}\0A\0A/// The value for `k`, or `None`.\0Apub let Map.get[K: Eq + Hash, V] (m: Map[K, V]) (k: K): Option[V] = {\0A    let bucket = m.buckets[map_bucket_index(k, m.buckets.len())];\0A    let i = map_bucket_find_index(bucket, k, 0);\0A    if i >= 0 { Some(bucket[i].value) } else { None }\0A}\0A\0A/// Whether `k` has a value.\0Apub let Map.contains[K: Eq + Hash, V] (m: Map[K, V]) (k: K): Bool =\0A    map_bucket_find_index(m.buckets[map_bucket_index(k, m.buckets.len())], k, 0) >= 0\0A\0A/// A new map without `k`. Removing an absent key is not an error.\0Apub let Map.remove[K: Eq + Hash, V] (m: Map[K, V]) (k: K): Map[K, V] = {\0A    let idx = map_bucket_index(k, m.buckets.len());\0A    let bucket = m.buckets[idx];\0A    let i = map_bucket_find_index(bucket, k, 0);\0A    if i >= 0 { Map { buckets: m.buckets.set(idx, bucket.remove(i)), size: m.size - 1 } } else { m }\0A}\0A\0A/// How many entries.\0Apub let Map.len[K, V] (m: Map[K, V]): Int = m.size\0A\0A/// Every key, in no particular order — buckets, not insertion order.\0Apub let Map.keys[K, V] (m: Map[K, V]): Array[K] = {\0A    let mut acc = [];\0A    for bucket in m.buckets { for entry in bucket { acc = acc.push(entry.key); } };\0A    acc\0A}\0A\0A/// Every value, in the same order as `Map.keys`.\0Apub let Map.values[K, V] (m: Map[K, V]): Array[V] = {\0A    let mut acc = [];\0A    for bucket in m.buckets { for entry in bucket { acc = acc.push(entry.value); } };\0A    acc\0A}\0A\0Alet map_from_arrays_acc[K: Eq + Hash, V] (keys: Array[K]) (values: Array[V]) (i: Int) (acc: Map[K, V]): Map[K, V] =\0A    if i >= keys.len() { acc } else { map_from_arrays_acc(keys, values, i + 1, Map.insert(acc, keys[i], values[i])) }\0A/// A map from parallel arrays, stopping at the shorter. A repeated\0A/// key keeps the LAST value.\0Apub let Map.from_arrays[K: Eq + Hash, V] (keys: Array[K]) (values: Array[V]): Map[K, V] = map_from_arrays_acc(keys, values, 0, Map.new(()))\0A\0A/// A set of `T`, persistent like `Map` — `Set.insert` returns a new\0A/// set. Members need `Eq` and `Hash`. Equal keys hash identically.\0A/// NaN is not a supported key, including inside aggregates, because\0A/// IEEE equality makes it unequal to itself. References use identity.\0Apub struct Set[T] { inner: Map[T, Unit] }\0A\0A/// An empty set.\0Apub let Set.new[T] (): Set[T] = Set { inner: Map.new(()) }\0A/// A new set with `x` added. Adding a member twice changes nothing.\0Apub let Set.insert[T: Eq + Hash] (s: Set[T]) (x: T): Set[T] = Set { inner: Map.insert(s.inner, x, ()) }\0A/// Whether `x` is a member.\0Apub let Set.contains[T: Eq + Hash] (s: Set[T]) (x: T): Bool = Map.contains(s.inner, x)\0A/// A new set without `x`.\0Apub let Set.remove[T: Eq + Hash] (s: Set[T]) (x: T): Set[T] = Set { inner: Map.remove(s.inner, x) }\0A/// How many me