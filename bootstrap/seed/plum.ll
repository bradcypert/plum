@.str55783 = private global { i64, i64, [13094 x i8] } { i64 -1, i64 13093, [13094 x i8] c"/// The runtime primitive. Intercepted by `cg_runtime_fn`, which keys\0A/// on the bare name and so does not care that it now lives in a\0A/// module rather than in the prelude.\0Alet os_time_raw (ignored: Bool): Int = 0\0A\0A/// Seconds since the Unix epoch, from the system clock.\0A///\0A/// Seconds, and an `Int`, because that is what every platform's\0A/// `time()` agrees on. Anything richer (a calendar date, a\0A/// timezone, a formatted string) is a library on top of this and\0A/// not a runtime concern; the primitive is the part a program\0A/// cannot write for itself.\0Apub let now (): Int = os_time_raw(true)\0A\0A// --- Durations and clocks ---\0A//\0A// `Time.now()` above stays SECONDS, and every calendar function\0A// below stays arithmetic on it. Changing it would break every\0A// caller and every documented `iso8601` answer to buy precision\0A// that belongs in a separate type anyway.\0Aextern \22C\22 {\0A    fn time_now_millis() -> Int;\0A    fn time_monotonic_nanos() -> Int;\0A    fn time_sleep_nanos(n: Int) -> Int;\0A}\0A\0A/// A length of time, held as NANOSECONDS.\0A///\0A/// A real type rather than an `Int` of milliseconds, because a\0A/// bare number does not say which unit it is and every caller has\0A/// to agree by convention. `#7` will want timeouts, `Http` will\0A/// want them, `Terminal` will want them, and the alternative is\0A/// each module growing its own `timeout_ms: Int` that cannot be\0A/// passed to the others.\0A///\0A/// The field is PRIVATE: a `Duration` is built through a\0A/// constructor that names its unit, which is the whole point of\0A/// having the type. Nanoseconds internally because a signed 64-bit\0A/// count of them spans ~292 years, which is more than any duration\0A/// needs, and because losing sub-millisecond precision would make\0A/// the type useless for the timing code that wants it most.\0Apub struct Duration { nanos: Int }\0A\0A/// A point on the MONOTONIC clock, whose origin is deliberately\0A/// unspecified. Two instants can be subtracted; one on its own\0A/// means nothing, which is why this is a distinct type from a wall\0A/// clock reading rather than another `Int`.\0A///\0A/// Stored as signed 64-bit nanoseconds: readings must fit within about\0A/// 292 years of the platform clock origin; differences must fit in a\0A/// `Duration`. This is independent of the wall clock and the year 2262.\0Apub struct Instant { nanos: Int }\0A\0A/// Constructors, each naming its unit. Multiplication can overflow,\0A/// and Plum aborts on integer overflow rather than wrapping, so\0A/// `Time.seconds(10000000000)` is a crash and not a silently wrong\0A/// duration.\0Apub let nanos (n: Int): Duration = Duration { nanos: n }\0A/// A duration of `n` microseconds. Negative durations are allowed and mean\0A/// what they say.\0Apub let micros (n: Int): Duration = Duration { nanos: n * 1000 }\0A/// A duration of `n` milliseconds. Negative durations are allowed and mean\0A/// what they say.\0Apub let millis (n: Int): Duration = Duration { nanos: n * 1000000 }\0A/// A duration of `n` seconds. Negative durations are allowed and mean\0A/// what they say.\0Apub let seconds (n: Int): Duration = Duration { nanos: n * 1000000000 }\0A/// A duration of `n` minutes. Negative durations are allowed and mean\0A/// what they say.\0Apub let minutes (n: Int): Duration = seconds(n * 60)\0A/// A duration of `n` hours. Negative durations are allowed and mean\0A/// what they say.\0Apub let hours (n: Int): Duration = minutes(n * 60)\0A/// A duration of no time at all.\0Apub let zero (): Duration = Duration { nanos: 0 }\0A\0A/// Accessors, TRUNCATING toward zero the way `/` does: a duration of\0A/// 1500 microseconds is 1 millisecond, not 2. Ask in the unit you\0A/// care about rather than rounding one answer into another.\0Apub let Duration.as_nanos (d: Duration): Int = d.nanos\0A/// The duration in microseconds, TRUNCATED toward zero. Use\0A/// `Duration.as_nanos` when the remainder matters.\0Apub let Duration.as_micros (d: Duration): Int = d.nanos / 1000\0A/// The duration in milliseconds, TRUNCATED toward zero. Use\0A/// `Duration.as_nanos` when the remainder matters.\0Apub let Duration.as_millis (d: Duration): Int = d.nanos / 1000000\0A/// The duration in whole seconds, TRUNCATED toward zero. Use\0A/// `Duration.as_nanos` when the remainder matters.\0Apub let Duration.as_seconds (d: Duration): Int = d.nanos / 1000000000\0A/// Whether this is exactly no time. A negative duration is not zero.\0Apub let Duration.is_zero (d: Duration): Bool = d.nanos == 0\0A\0A/// Adds two durations.\0Apub let Duration.add (a: Duration) (b: Duration): Duration = Duration { nanos: a.nanos + b.nanos }\0A/// Subtracts `b` from `a`. The result may be negative, which is a\0A/// legal duration and is what `Time.between` returns for two instants\0A/// given the other way round.\0Apub let Duration.sub (a: Duration) (b: Duration): Duration = Duration { nanos: a.nanos - b.nanos }\0A/// Multiplies a duration by a whole number.\0Apub let Duration.scale (d: Duration) (n: Int): Duration = Duration { nanos: d.nanos * n }\0A\0A/// A duration can be NEGATIVE. `sub` may produce one, and refusing\0A/// to represent it would only move the problem to every caller of\0A/// `sub`. `sleep` treats a non-positive duration as no wait at all.\0Apub let Duration.negate (d: Duration): Duration = Duration { nanos: 0 - d.nanos }\0A\0A/// --- Comparison ---\0A///\0A/// Functions rather than `<`, because this checker offers ordered\0A/// comparison on `Int`, `Float` and `String` and on nothing else --\0A/// a struct has no `<`. `==` works, since that is structural.\0A///\0A/// If ordered comparison ever reaches single-field wrappers, `<`\0A/// starts working on a `Duration` for free and these stay as the\0A/// spelling that always worked.\0Apub let Duration.compare (a: Duration) (b: Duration): Int =\0A    if a.nanos < b.nanos { 0 - 1 } else if a.nanos > b.nanos { 1 } else { 0 }\0A/// Whether `a` is shorter than `b`.\0A///\0A/// Spelled out rather than `<`, because ordered comparison in this\0A/// language works on `Int`, `Float` and `String` and not on structs.\0A/// `==` does work, since that one is structural.\0Apub let Duration.lt (a: Duration) (b: Duration): Bool = a.nanos < b.nanos\0A/// Whether `a` is no longer than `b`.\0A///\0A/// Spelled out rather than `<`, because ordered comparison in this\0A/// language works on `Int`, `Float` and `String` and not on structs.\0A/// `==` does work, since that one is structural.\0Apub let Duration.le (a: Duration) (b: Duration): Bool = a.nanos <= b.nanos\0A/// Whether `a` is longer than `b`.\0A///\0A/// Spelled out rather than `<`, because ordered comparison in this\0A/// language works on `Int`, `Float` and `String` and not on structs.\0A/// `==` does work, since that one is structural.\0Apub let Duration.gt (a: Duration) (b: Duration): Bool = a.nanos > b.nanos\0A/// Whether `a` is at least as long as `b`.\0A///\0A/// Spelled out rather than `<`, because ordered comparison in this\0A/// language works on `Int`, `Float` and `String` and not on structs.\0A/// `==` does work, since that one is structural.\0Apub let Duration.ge (a: Duration) (b: Duration): Bool = a.nanos >= b.nanos\0A/// The shorter of two durations.\0Apub let Duration.min (a: Duration) (b: Duration): Duration = if a.nanos <= b.nanos { a } else { b }\0A/// The longer of two durations.\0Apub let Duration.max (a: Duration) (b: Duration): Duration = if a.nanos >= b.nanos { a } else { b }\0A\0A// --- Clocks ---\0A\0A/// Wall clock, in milliseconds since the Unix epoch. The same clock\0A/// `now()` reads, at a resolution `now()` cannot express.\0A///\0A/// It can jump: setting the system clock or an NTP correction moves\0A/// it, backwards included. Use it to say WHEN something happened;\0A/// use `instant` to measure how long something took.\0A///\0A/// Converted directly to milliseconds, without a nanosecond timestamp\0A/// intermediate. Sub-millisecond fractions truncate toward zero, even\0A/// before 1970. Values outside `Int` saturate at its limits. A native\0A/// clock-read failure returns zero.\0Apub let now_millis (): Int = unsafe { time_now_millis() }\0A\0A/// A reading of the monotonic clock, for measuring elapsed time.\0A/// Never moves backwards and is unaffected by the system clock being\0A/// set.\0Apub let instant (): Instant = unsafe { Instant { nanos: time_monotonic_nanos() } }\0A\0A/// How long since `t0`. Never negative, because the clock it reads\0A/// cannot go backwards.\0Apub let since (t0: Instant): Duration = unsafe { Duration { nanos: time_monotonic_nanos() - t0.nanos } }\0A\0A/// The time between two instants, `later - earlier`. Negative if they\0A/// are given the wrong way round, which is information rather than an\0A/// error.\0Apub let between (earlier: Instant) (later: Instant): Duration = Duration { nanos: later.nanos - earlier.nanos }\0A\0A/// Sleeps for AT LEAST `d`, never at most: a sleep overshoots by\0A/// whatever the scheduler decides, and no caller can be promised\0A/// otherwise. A non-positive duration returns immediately.\0A///\0A/// Windows sleeps in whole milliseconds, so a sub-millisecond request\0A/// rounds UP to one there rather than down to nothing.\0Apub let sleep (d: Duration): Unit = unsafe { time_sleep_nanos(d.nanos); () }\0A\0A// --- Calendars ---\0A//\0A// Everything below is ordinary Plum on top of `Time.now()`, which is\0A// the line the 0.0.7 notes drew and this keeps: the CLOCK is the part\0A// a program cannot write for itself, and the CALENDAR is arithmetic\0A// anyone could write but nobody should have to. Porting a real CLI\0A// produced 40 lines of `civil_from_days` in a program that wanted a\0A// timestamp in a README, which is what moved it here.\0A//\0A// UTC only. A timezone database is a data-shipping problem, not an\0A// arithmetic one, and Plum ships no data.\0A\0A/// Floor division and modulo, which is NOT what `/` and `%` do: those\0A/// truncate toward zero, so `-1 / 86400` is `0` and the day before the\0A/// epoch would land in 1970. Every calendar function below needs the\0A/// floor, and dates before 1970 are real dates.\0Alet plum__floor_div (a: Int) (b: Int): Int = {\0A    let q = a / b;\0A    if a - q * b != 0 && (a < 0) != (b < 0) { q - 1 } else { q }\0A}\0A\0Alet plum__floor_mod (a: Int) (b: Int): Int = a - plum__floor_div(a, b) * b\0A\0A/// A civil date and time, as UTC. `weekday` is 0 for Sunday.\0Apub struct DateTime {\0A    pub year: Int, pub month: Int, pub day: Int,\0A    pub hour: Int, pub minute: Int, pub second: Int,\0A    pub weekday: Int,\0A}\0A\0A/// Howard Hinnant's `civil_from_days`: exact for every date in the\0A/// proleptic Gregorian calendar, with no lookup table and no leap-year\0A/// special case. It shifts the year to start in March so the leap day\0A/// falls at the END of the cycle, which is what removes the special\0A/// case rather than hiding it.\0A///\0A/// The inner divisions all operate on non-negative values, so plain `/`\0A/// is right there; only `era` can go negative and it uses the floor.\0Apub let utc (epoch: Int): DateTime = {\0A    let days = plum__floor_div(epoch, 86400);\0A    let secs = plum__floor_mod(epoch, 86400);\0A    let z = days + 719468;\0A    let era = plum__floor_div(z, 146097);\0A    let doe = z - era * 146097;\0A    let yoe = (doe - doe / 1460 + doe / 36524 - doe / 146096) / 365;\0A    let doy = doe - (365 * yoe + yoe / 4 - yoe / 100);\0A    let mp = (5 * doy + 2) / 153;\0A    let d = doy - (153 * mp + 2) / 5 + 1;\0A    let m = if mp < 10 { mp + 3 } else { mp - 9 };\0A    DateTime {\0A        year: yoe + era * 400 + (if m <= 2 { 1 } else { 0 }),\0A        month: m,\0A        day: d,\0A        hour: secs / 3600,\0A        minute: secs / 60 - secs / 3600 * 60,\0A        second: secs - secs / 60 * 60,\0A        // 1970-01-01 was a Thursday, which is index 4.\0A        weekday: plum__floor_mod(days + 4, 7),\0A    }\0A}\0A\0A/// The English name of a weekday, 0 being Sunday, as `Time.utc`\0A/// reports it. Out-of-range numbers give an empty string.\0Apub let weekday_name (weekday: Int): String =\0A    [\22Sun\22, \22Mon\22, \22Tue\22, \22Wed\22, \22Thu\22, \22Fri\22, \22Sat\22][plum__floor_mod(weekday, 7)]\0A\0A/// The English name of a month, 1 being January, as `Time.utc` reports\0A/// it. Out-of-range numbers give an empty string.\0Apub let month_name (month: Int): String =\0A    [\22Jan\22, \22Feb\22, \22Mar\22, \22Apr\22, \22May\22, \22Jun\22, \22Jul\22, \22Aug\22, \22Sep\22, \22Oct\22, \22Nov\22, \22Dec\22][plum__floor_mod(month - 1, 12)]\0A\0Alet plum__two (n: Int): String = String.pad_left(n.to_string(), 2, \220\22)\0A\0A/// `2026-08-27T01:40:28Z`, in ISO 8601, which is the one to reach for\0A/// when a machine reads it back or when it needs to sort as text.\0Apub let iso8601 (epoch: Int): String = {\0A    let t = utc(epoch);\0A    let date = String.pad_left(t.year.to_string(), 4, \220\22).concat(\22-\22).concat(plum__two(t.month)).concat(\22-\22).concat(plum__two(t.day));\0A    date.concat(\22T\22).concat(plum__two(t.hour)).concat(\22:\22).concat(plum__two(t.minute)).concat(\22:\22).concat(plum__two(t.second)).concat(\22Z\22)\0A}\0A\0A/// `Thu, 27 Aug 2026 01:40:28 GMT`, the HTTP date format (RFC 7231),\0A/// which is what a `Last-Modified` header and a good many generated\0A/// files want.\0Apub let rfc7231 (epoch: Int): String = {\0A    let t = utc(epoch);\0A    let head = weekday_name(t.weekday).concat(\22, \22).concat(plum__two(t.day)).concat(\22 \22).concat(month_name(t.month));\0A    let time = plum__two(t.hour).concat(\22:\22).concat(plum__two(t.minute)).concat(\22:\22).concat(plum__two(t.second));\0A    head.concat(\22 \22).concat(t.year.to_string()).concat(\22 \22).concat(time).concat(\22 GMT\22)\0A}\0A\00" }
