@.str46172 = private global { i64, i64, [33680 x i8] } { i64 -1, i64 33679, [33680 x i8] c"/*\0A *  Core bignum functions\0A *\0A *  Copyright The Mbed TLS Contributors\0A *  SPDX-License-Identifier: Apache-2.0 OR GPL-2.0-or-later\0A */\0A\0A#include \22common.h\22\0A\0A#if defined(MBEDTLS_BIGNUM_C)\0A\0A#include <string.h>\0A\0A#include \22mbedtls/error.h\22\0A#include \22mbedtls/platform_util.h\22\0A#include \22constant_time_internal.h\22\0A\0A#include \22mbedtls/platform.h\22\0A\0A#include \22bignum_core.h\22\0A#include \22bn_mul.h\22\0A#include \22constant_time_internal.h\22\0A\0Asize_t mbedtls_mpi_core_clz(mbedtls_mpi_uint a)\0A{\0A#if defined(__has_builtin)\0A#if (MBEDTLS_MPI_UINT_MAX == UINT_MAX) && __has_builtin(__builtin_clz)\0A    #define core_clz __builtin_clz\0A#elif (MBEDTLS_MPI_UINT_MAX == ULONG_MAX) && __has_builtin(__builtin_clzl)\0A    #define core_clz __builtin_clzl\0A#elif (MBEDTLS_MPI_UINT_MAX == ULLONG_MAX) && __has_builtin(__builtin_clzll)\0A    #define core_clz __builtin_clzll\0A#endif\0A#endif\0A#if defined(core_clz)\0A    return (size_t) core_clz(a);\0A#else\0A    size_t j;\0A    mbedtls_mpi_uint mask = (mbedtls_mpi_uint) 1 << (biL - 1);\0A\0A    for (j = 0; j < biL; j++) {\0A        if (a & mask) {\0A            break;\0A        }\0A\0A        mask >>= 1;\0A    }\0A\0A    return j;\0A#endif\0A}\0A\0Asize_t mbedtls_mpi_core_bitlen(const mbedtls_mpi_uint *A, size_t A_limbs)\0A{\0A    int i;\0A    size_t j;\0A\0A    for (i = ((int) A_limbs) - 1; i >= 0; i--) {\0A        if (A[i] != 0) {\0A            j = biL - mbedtls_mpi_core_clz(A[i]);\0A            return (i * biL) + j;\0A        }\0A    }\0A\0A    return 0;\0A}\0A\0Astatic mbedtls_mpi_uint mpi_bigendian_to_host(mbedtls_mpi_uint a)\0A{\0A    if (MBEDTLS_IS_BIG_ENDIAN) {\0A        /* Nothing to do on bigendian systems. */\0A        return a;\0A    } else {\0A#if defined(MBEDTLS_HAVE_INT32)\0A        return (mbedtls_mpi_uint) MBEDTLS_BSWAP32(a);\0A#elif defined(MBEDTLS_HAVE_INT64)\0A        return (mbedtls_mpi_uint) MBEDTLS_BSWAP64(a);\0A#endif\0A    }\0A}\0A\0Avoid mbedtls_mpi_core_bigendian_to_host(mbedtls_mpi_uint *A,\0A                                        size_t A_limbs)\0A{\0A    mbedtls_mpi_uint *cur_limb_left;\0A    mbedtls_mpi_uint *cur_limb_right;\0A    if (A_limbs == 0) {\0A        return;\0A    }\0A\0A    /*\0A     * Traverse limbs and\0A     * - adapt byte-order in each limb\0A     * - swap the limbs themselves.\0A     * For that, simultaneously traverse the limbs from left to right\0A     * and from right to left, as long as the left index is not bigger\0A     * than the right index (it's not a problem if limbs is odd and the\0A     * indices coincide in the last iteration).\0A     */\0A    for (cur_limb_left = A, cur_limb_right = A + (A_limbs - 1);\0A         cur_limb_left <= cur_limb_right;\0A         cur_limb_left++, cur_limb_right--) {\0A        mbedtls_mpi_uint tmp;\0A        /* Note that if cur_limb_left == cur_limb_right,\0A         * this code effectively swaps the bytes only once. */\0A        tmp             = mpi_bigendian_to_host(*cur_limb_left);\0A        *cur_limb_left  = mpi_bigendian_to_host(*cur_limb_right);\0A        *cur_limb_right = tmp;\0A    }\0A}\0A\0A/* Whether min <= A, in constant time.\0A * A_limbs must be at least 1. */\0Ambedtls_ct_condition_t mbedtls_mpi_core_uint_le_mpi(mbedtls_mpi_uint min,\0A                                                    const mbedtls_mpi_uint *A,\0A                                                    size_t A_limbs)\0A{\0A    /* min <= least significant limb? */\0A    mbedtls_ct_condition_t min_le_lsl = mbedtls_ct_uint_ge(A[0], min);\0A\0A    /* limbs other than the least significant one are all zero? */\0A    mbedtls_ct_condition_t msll_mask = MBEDTLS_CT_FALSE;\0A    for (size_t i = 1; i < A_limbs; i++) {\0A        msll_mask = mbedtls_ct_bool_or(msll_mask, mbedtls_ct_bool(A[i]));\0A    }\0A\0A    /* min <= A iff the lowest limb of A is >= min or the other limbs\0A     * are not all zero. */\0A    return mbedtls_ct_bool_or(msll_mask, min_le_lsl);\0A}\0A\0Ambedtls_ct_condition_t mbedtls_mpi_core_lt_ct(const mbedtls_mpi_uint *A,\0A                                              const mbedtls_mpi_uint *B,\0A                                              size_t limbs)\0A{\0A    mbedtls_ct_condition_t ret = MBEDTLS_CT_FALSE, cond = MBEDTLS_CT_FALSE, done = MBEDTLS_CT_FALSE;\0A\0A    for (size_t i = limbs; i > 0; i--) {\0A        /*\0A         * If B[i - 1] < A[i - 1] then A < B is false and the result must\0A         * remain 0.\0A         *\0A         * Again even if we can make a decision, we just mark the result and\0A         * the fact that we are done and continue looping.\0A         */\0A        cond = mbedtls_ct_uint_lt(B[i - 1], A[i - 1]);\0A        done = mbedtls_ct_bool_or(done, cond);\0A\0A        /*\0A         * If A[i - 1] < B[i - 1] then A < B is true.\0A         *\0A         * Again even if we can make a decision, we just mark the result and\0A         * the fact that we are done and continue looping.\0A         */\0A        cond = mbedtls_ct_uint_lt(A[i - 1], B[i - 1]);\0A        ret  = mbedtls_ct_bool_or(ret, mbedtls_ct_bool_and(cond, mbedtls_ct_bool_not(done)));\0A        done = mbedtls_ct_bool_or(done, cond);\0A    }\0A\0A    /*\0A     * If all the limbs were equal, then the numbers are equal, A < B is false\0A     * and leaving the result 0 is correct.\0A     */\0A\0A    return ret;\0A}\0A\0Avoid mbedtls_mpi_core_cond_assign(mbedtls_mpi_uint *X,\0A                                  const mbedtls_mpi_uint *A,\0A                                  size_t limbs,\0A                                  mbedtls_ct_condition_t assign)\0A{\0A    if (X == A) {\0A        return;\0A    }\0A\0A    /* This function is very performance-sensitive for RSA. For this reason\0A     * we have the loop below, instead of calling mbedtls_ct_memcpy_if\0A     * (this is more optimal since here we don't have to handle the case where\0A     * we copy awkwardly sized data).\0A     */\0A    for (size_t i = 0; i < limbs; i++) {\0A        X[i] = mbedtls_ct_mpi_uint_if(assign, A[i], X[i]);\0A    }\0A}\0A\0Avoid mbedtls_mpi_core_cond_swap(mbedtls_mpi_uint *X,\0A                                mbedtls_mpi_uint *Y,\0A                                size_t limbs,\0A                                mbedtls_ct_condition_t swap)\0A{\0A    if (X == Y) {\0A        return;\0A    }\0A\0A    for (size_t i = 0; i < limbs; i++) {\0A        mbedtls_mpi_uint tmp = X[i];\0A        X[i] = mbedtls_ct_mpi_uint_if(swap, Y[i], X[i]);\0A        Y[i] = mbedtls_ct_mpi_uint_if(swap, tmp, Y[i]);\0A    }\0A}\0A\0Aint mbedtls_mpi_core_read_le(mbedtls_mpi_uint *X,\0A                             size_t X_limbs,\0A                             const unsigned char *input,\0A                             size_t input_length)\0A{\0A    const size_t limbs = CHARS_TO_LIMBS(input_length);\0A\0A    if (X_limbs < limbs) {\0A        return MBEDTLS_ERR_MPI_BUFFER_TOO_SMALL;\0A    }\0A\0A    if (X != NULL) {\0A        memset(X, 0, X_limbs * ciL);\0A\0A        for (size_t i = 0; i < input_length; i++) {\0A            size_t offset = ((i % ciL) << 3);\0A            X[i / ciL] |= ((mbedtls_mpi_uint) input[i]) << offset;\0A        }\0A    }\0A\0A    return 0;\0A}\0A\0Aint mbedtls_mpi_core_read_be(mbedtls_mpi_uint *X,\0A                             size_t X_limbs,\0A                             const unsigned char *input,\0A                             size_t input_length)\0A{\0A    const size_t limbs = CHARS_TO_LIMBS(input_length);\0A\0A    if (X_limbs < limbs) {\0A        return MBEDTLS_ERR_MPI_BUFFER_TOO_SMALL;\0A    }\0A\0A    /* If X_limbs is 0, input_length must also be 0 (from previous test).\0A     * Nothing to do. */\0A    if (X_limbs == 0) {\0A        return 0;\0A    }\0A\0A    memset(X, 0, X_limbs * ciL);\0A\0A    /* memcpy() with (NULL, 0) is undefined behaviour */\0A    if (input_length != 0) {\0A        size_t overhead = (X_limbs * ciL) - input_length;\0A        unsigned char *Xp = (unsigned char *) X;\0A        memcpy(Xp + overhead, input, input_length);\0A    }\0A\0A    mbedtls_mpi_core_bigendian_to_host(X, X_limbs);\0A\0A    return 0;\0A}\0A\0Aint mbedtls_mpi_core_write_le(const mbedtls_mpi_uint *A,\0A                              size_t A_limbs,\0A                              unsigned char *output,\0A                              size_t output_length)\0A{\0A    size_t stored_bytes = A_limbs * ciL;\0A    size_t bytes_to_copy;\0A\0A    if (stored_bytes < output_length) {\0A        bytes_to_copy = stored_bytes;\0A    } else {\0A        bytes_to_copy = output_length;\0A\0A        /* The output buffer is smaller than the allocated size of A.\0A         * However A may fit if its leading bytes are zero. */\0A        for (size_t i = bytes_to_copy; i < stored_bytes; i++) {\0A            if (GET_BYTE(A, i) != 0) {\0A                return MBEDTLS_ERR_MPI_BUFFER_TOO_SMALL;\0A            }\0A        }\0A    }\0A\0A    for (size_t i = 0; i < bytes_to_copy; i++) {\0A        output[i] = GET_BYTE(A, i);\0A    }\0A\0A    if (stored_bytes < output_length) {\0A        /* Write trailing 0 bytes */\0A        memset(output + stored_bytes, 0, output_length - stored_bytes);\0A    }\0A\0A    return 0;\0A}\0A\0Aint mbedtls_mpi_core_write_be(const mbedtls_mpi_uint *X,\0A                              size_t X_limbs,\0A                              unsigned char *output,\0A                              size_t output_length)\0A{\0A    size_t stored_bytes;\0A    size_t bytes_to_copy;\0A    unsigned char *p;\0A\0A    stored_bytes = X_limbs * ciL;\0A\0A    if (stored_bytes < output_length) {\0A        /* There is enough space in the output buffer. Write initial\0A         * null bytes and record the position at which to start\0A         * writing the significant bytes. In this case, the execution\0A         * trace of this function does not depend on the value of the\0A         * number. */\0A        bytes_to_copy = stored_bytes;\0A        p = output + output_length - stored_bytes;\0A        memset(output, 0, output_length - stored_bytes);\0A    } else {\0A        /* The output buffer is smaller than the allocated size of X.\0A         * However X may fit if its leading bytes are zero. */\0A        bytes_to_copy = output_length;\0A        p = output;\0A        for (size_t i = bytes_to_copy; i < stored_bytes; i++) {\0A            if (GET_BYTE(X, i) != 0) {\0A                return MBEDTLS_ERR_MPI_BUFFER_TOO_SMALL;\0A            }\0A        }\0A    }\0A\0A    for (size_t i = 0; i < bytes_to_copy; i++) {\0A        p[bytes_to_copy - i - 1] = GET_BYTE(X, i);\0A    }\0A\0A    return 0;\0A}\0A\0Avoid mbedtls_mpi_core_shift_r(mbedtls_mpi_uint *X, size_t limbs,\0A                              size_t count)\0A{\0A    size_t i, v0, v1;\0A    mbedtls_mpi_uint r0 = 0, r1;\0A\0A    v0 = count /  biL;\0A    v1 = count & (biL - 1);\0A\0A    if (v0 > limbs || (v0 == limbs && v1 > 0)) {\0A        memset(X, 0, limbs * ciL);\0A        return;\0A    }\0A\0A    /*\0A     * shift by count / limb_size\0A     */\0A    if (v0 > 0) {\0A        for (i = 0; i < limbs - v0; i++) {\0A            X[i] = X[i + v0];\0A        }\0A\0A        for (; i < limbs; i++) {\0A            X[i] = 0;\0A        }\0A    }\0A\0A    /*\0A     * shift by count % limb_size\0A     */\0A    if (v1 > 0) {\0A        for (i = limbs; i > 0; i--) {\0A            r1 = X[i - 1] << (biL - v1);\0A            X[i - 1] >>= v1;\0A            X[i - 1] |= r0;\0A            r0 = r1;\0A        }\0A    }\0A}\0A\0Avoid mbedtls_mpi_core_shift_l(mbedtls_mpi_uint *X, size_t limbs,\0A                              size_t count)\0A{\0A    size_t i, v0, v1;\0A    mbedtls_mpi_uint r0 = 0, r1;\0A\0A    v0 = count / (biL);\0A    v1 = count & (biL - 1);\0A\0A    /*\0A     * shift by count / limb_size\0A     */\0A    if (v0 > 0) {\0A        for (i = limbs; i > v0; i--) {\0A            X[i - 1] = X[i - v0 - 1];\0A        }\0A\0A        for (; i > 0; i--) {\0A            X[i - 1] = 0;\0A        }\0A    }\0A\0A    /*\0A     * shift by count % limb_size\0A     */\0A    if (v1 > 0) {\0A        for (i = v0; i < limbs; i++) {\0A            r1 = X[i] >> (biL - v1);\0A            X[i] <<= v1;\0A            X[i] |= r0;\0A            r0 = r1;\0A        }\0A    }\0A}\0A\0Ambedtls_mpi_uint mbedtls_mpi_core_add(mbedtls_mpi_uint *X,\0A                                      const mbedtls_mpi_uint *A,\0A                                      const mbedtls_mpi_uint *B,\0A                                      size_t limbs)\0A{\0A    mbedtls_mpi_uint c = 0;\0A\0A    for (size_t i = 0; i < limbs; i++) {\0A        mbedtls_mpi_uint t = c + A[i];\0A        c = (t < A[i]);\0A        t += B[i];\0A        c += (t < B[i]);\0A        X[i] = t;\0A    }\0A\0A    return c;\0A}\0A\0Ambedtls_mpi_uint mbedtls_mpi_core_add_if(mbedtls_mpi_uint *X,\0A                                         const mbedtls_mpi_uint *A,\0A                                         size_t limbs,\0A                                         unsigned cond)\0A{\0A    mbedtls_mpi_uint c = 0;\0A\0A    mbedtls_ct_condition_t do_add = mbedtls_ct_bool(cond);\0A\0A    for (size_t i = 0; i < limbs; i++) {\0A        mbedtls_mpi_uint add = mbedtls_ct_mpi_uint_if_else_0(do_add, A[i]);\0A        mbedtls_mpi_uint t = c + X[i];\0A        c = (t < X[i]);\0A        t += add;\0A        c += (t < add);\0A        X[i] = t;\0A    }\0A\0A    return c;\0A}\0A\0Ambedtls_mpi_uint mbedtls_mpi_core_sub(mbedtls_mpi_uint *X,\0A                                      const mbedtls_mpi_uint *A,\0A                                      const mbedtls_mpi_uint *B,\0A                                      size_t limbs)\0A{\0A    mbedtls_mpi_uint c = 0;\0A\0A    for (size_t i = 0; i < limbs; i++) {\0A        mbedtls_mpi_uint z = (A[i] < c);\0A        mbedtls_mpi_uint t = A[i] - c;\0A        c = (t < B[i]) + z;\0A        X[i] = t - B[i];\0A    }\0A\0A    return c;\0A}\0A\0Ambedtls_mpi_uint mbedtls_mpi_core_mla(mbedtls_mpi_uint *d, size_t d_len,\0A                                      const mbedtls_mpi_uint *s, size_t s_len,\0A                                      mbedtls_mpi_uint b)\0A{\0A    mbedtls_mpi_uint c = 0; /* carry */\0A    /*\0A     * It is a documented precondition of this function that d_len >= s_len.\0A     * If that's not the case, we swap these round: this turns what would be\0A     * a buffer overflow into an incorrect result.\0A     */\0A    if (d_len < s_len) {\0A        s_len = d_len;\0A    }\0A    size_t excess_len = d_len - s_len;\0A    size_t steps_x8 = s_len / 8;\0A    size_t steps_x1 = s_len & 7;\0A\0A    while (steps_x8--) {\0A        MULADDC_X8_INIT\0A        MULADDC_X8_CORE\0A            MULADDC_X8_STOP\0A    }\0A\0A    while (steps_x1--) {\0A        MULADDC_X1_INIT\0A        MULADDC_X1_CORE\0A            MULADDC_X1_STOP\0A    }\0A\0A    while (excess_len--) {\0A        *d += c;\0A        c = (*d < c);\0A        d++;\0A    }\0A\0A    return c;\0A}\0A\0Avoid mbedtls_mpi_core_mul(mbedtls_mpi_uint *X,\0A                          const mbedtls_mpi_uint *A, size_t A_limbs,\0A                          const mbedtls_mpi_uint *B, size_t B_limbs)\0A{\0A    memset(X, 0, (A_limbs + B_limbs) * ciL);\0A\0A    for (size_t i = 0; i < B_limbs; i++) {\0A        (void) mbedtls_mpi_core_mla(X + i, A_limbs + 1, A, A_limbs, B[i]);\0A    }\0A}\0A\0A/*\0A * Fast Montgomery initialization (thanks to Tom St Denis).\0A */\0Ambedtls_mpi_uint mbedtls_mpi_core_montmul_init(const mbedtls_mpi_uint *N)\0A{\0A    mbedtls_mpi_uint x = N[0];\0A\0A    x += ((N[0] + 2) & 4) << 1;\0A\0A    for (unsigned int i = biL; i >= 8; i /= 2) {\0A        x *= (2 - (N[0] * x));\0A    }\0A\0A    return ~x + 1;\0A}\0A\0Avoid mbedtls_mpi_core_montmul(mbedtls_mpi_uint *X,\0A                              const mbedtls_mpi_uint *A,\0A                              const mbedtls_mpi_uint *B,\0A                              size_t B_limbs,\0A                              const mbedtls_mpi_uint *N,\0A                              size_t AN_limbs,\0A                              mbedtls_mpi_uint mm,\0A                              mbedtls_mpi_uint *T)\0A{\0A    memset(T, 0, (2 * AN_limbs + 1) * ciL);\0A\0A    for (size_t i = 0; i < AN_limbs; i++) {\0A        /* T = (T + u0*B + u1*N) / 2^biL */\0A        mbedtls_mpi_uint u0 = A[i];\0A        mbedtls_mpi_uint u1 = (T[0] + u0 * B[0]) * mm;\0A\0A        (void) mbedtls_mpi_core_mla(T, AN_limbs + 2, B, B_limbs, u0);\0A        (void) mbedtls_mpi_core_mla(T, AN_limbs + 2, N, AN_limbs, u1);\0A\0A        T++;\0A    }\0A\0A    /*\0A     * The result we want is (T >= N) ? T - N : T.\0A     *\0A     * For better constant-time properties in this function, we always do the\0A     * subtraction, with the result in X.\0A     *\0A     * We also look to see if there was any carry in the final additions in the\0A     * loop above.\0A     */\0A\0A    mbedtls_mpi_uint carry  = T[AN_limbs];\0A    mbedtls_mpi_uint borrow = mbedtls_mpi_core_sub(X, T, N, AN_limbs);\0A\0A    /*\0A     * Using R as the Montgomery radix (auxiliary modulus) i.e. 2^(biL*AN_limbs):\0A     *\0A     * T can be in one of 3 ranges:\0A     *\0A     * 1) T < N      : (carry, borrow) = (0, 1): we want T\0A     * 2) N <= T < R : (carry, borrow) = (0, 0): we want X\0A     * 3) T >= R     : (carry, borrow) = (1, 1): we want X\0A     *\0A     * and (carry, borrow) = (1, 0) can't happen.\0A     *\0A     * So the correct return value is already in X if (carry ^ borrow) = 0,\0A     * but is in (the lower AN_limbs limbs of) T if (carry ^ borrow) = 1.\0A     */\0A    mbedtls_ct_memcpy_if(mbedtls_ct_bool(carry ^ borrow),\0A                         (unsigned char *) X,\0A                         (unsigned char *) T,\0A                         NULL,\0A                         AN_limbs * sizeof(mbedtls_mpi_uint));\0A}\0A\0Aint mbedtls_mpi_core_get_mont_r2_unsafe(mbedtls_mpi *X,\0A                                        const mbedtls_mpi *N)\0A{\0A    int ret = MBEDTLS_ERR_ERROR_CORRUPTION_DETECTED;\0A\0A    MBEDTLS_MPI_CHK(mbedtls_mpi_lset(X, 1));\0A    MBEDTLS_MPI_CHK(mbedtls_mpi_shift_l(X, N->n * 2 * biL));\0A    MBEDTLS_MPI_CHK(mbedtls_mpi_mod_mpi(X, X, N));\0A    MBEDTLS_MPI_CHK(mbedtls_mpi_shrink(X, N->n));\0A\0Acleanup:\0A    return ret;\0A}\0A\0AMBEDTLS_STATIC_TESTABLE\0Avoid mbedtls_mpi_core_ct_uint_table_lookup(mbedtls_mpi_uint *dest,\0A                                           const mbedtls_mpi_uint *table,\0A                                           size_t limbs,\0A                                           size_t count,\0A                                           size_t index)\0A{\0A    for (size_t i = 0; i < count; i++, table += limbs) {\0A        mbedtls_ct_condition_t assign = mbedtls_ct_uint_eq(i, index);\0A        mbedtls_mpi_core_cond_assign(dest, table, limbs, assign);\0A    }\0A}\0A\0A/* Fill X with n_bytes random bytes.\0A * X must already have room for those bytes.\0A * The ordering of the bytes returned from the RNG is suitable for\0A * deterministic ECDSA (see RFC 6979 §3.3 and the specification of\0A * mbedtls_mpi_core_random()).\0A */\0Aint mbedtls_mpi_core_fill_random(\0A    mbedtls_mpi_uint *X, size_t X_limbs,\0A    size_t n_bytes,\0A    int (*f_rng)(void *, unsigned char *, size_t), void *p_rng)\0A{\0A    int ret = MBEDTLS_ERR_ERROR_CORRUPTION_DETECTED;\0A    const size_t limbs = CHARS_TO_LIMBS(n_bytes);\0A    const size_t overhead = (limbs * ciL) - n_bytes;\0A\0A    if (X_limbs < limbs) {\0A        return MBEDTLS_ERR_MPI_BAD_INPUT_DATA;\0A    }\0A\0A    memset(X, 0, overhead);\0A    memset((unsigned char *) X + limbs * ciL, 0, (X_limbs - limbs) * ciL);\0A    MBEDTLS_MPI_CHK(f_rng(p_rng, (unsigned char *) X + overhead, n_bytes));\0A    mbedtls_mpi_core_bigendian_to_host(X, limbs);\0A\0Acleanup:\0A    return ret;\0A}\0A\0Aint mbedtls_mpi_core_random(mbedtls_mpi_uint *X,\0A                            mbedtls_mpi_uint min,\0A                            const mbedtls_mpi_uint *N,\0A                            size_t limbs,\0A                            int (*f_rng)(void *, unsigned char *, size_t),\0A                            void *p_rng)\0A{\0A    mbedtls_ct_condition_t ge_lower = MBEDTLS_CT_TRUE, lt_upper = MBEDTLS_CT_FALSE;\0A    size_t n_bits = mbedtls_mpi_core_bitlen(N, limbs);\0A    size_t n_bytes = (n_bits + 7) / 8;\0A    int ret = MBEDTLS_ERR_ERROR_CORRUPTION_DETECTED;\0A\0A    /*\0A     * When min == 0, each try has at worst a probability 1/2 of failing\0A     * (the msb has a probability 1/2 of being 0, and then the result will\0A     * be < N), so after 30 tries failure probability is a most 2**(-30).\0A     *\0A     * When N is just below a power of 2, as is the case when generating\0A     * a random scalar on most elliptic curves, 1 try is enough with\0A     * overwhelming probability. When N is just above a power of 2,\0A     * as when generating a random scalar on secp224k1, each try has\0A     * a probability of failing that is almost 1/2.\0A     *\0A     * The probabilities are almost the same if min is nonzero but negligible\0A     * compared to N. This is always the case when N is crypto-sized, but\0A     * it's convenient to support small N for testing purposes. When N\0A     * is small, use a higher repeat count, otherwise the probability of\0A     * failure is macroscopic.\0A     */\0A    int count = (n_bytes > 4 ? 30 : 250);\0A\0A    /*\0A     * Match the procedure given in RFC 6979 §3.3 (deterministic ECDSA)\0A     * when f_rng is a suitably parametrized instance of HMAC_DRBG:\0A     * - use the same byte ordering;\0A     * - keep the leftmost n_bits bits of the generated octet string;\0A     * - try until result is in the desired range.\0A     * This also avoids any bias, which is especially important for ECDSA.\0A     */\0A    do {\0A        MBEDTLS_MPI_CHK(mbedtls_mpi_core_fill_random(X, limbs,\0A                                                     n_bytes,\0A                                                     f_rng, p_rng));\0A        mbedtls_mpi_core_shift_r(X, limbs, 8 * n_bytes - n_bits);\0A\0A        if (--count == 0) {\0A            ret = MBEDTLS_ERR_MPI_NOT_ACCEPTABLE;\0A            goto cleanup;\0A        }\0A\0A        ge_lower = mbedtls_mpi_core_uint_le_mpi(min, X, limbs);\0A        lt_upper = mbedtls_mpi_core_lt_ct(X, N, limbs);\0A    } while (mbedtls_ct_bool_and(ge_lower, lt_upper) == MBEDTLS_CT_FALSE);\0A\0Acleanup:\0A    return ret;\0A}\0A\0Astatic size_t exp_mod_get_window_size(size_t Ebits)\0A{\0A#if MBEDTLS_MPI_WINDOW_SIZE >= 6\0A    return (Ebits > 671) ? 6 : (Ebits > 239) ? 5 : (Ebits >  79) ? 4 : 1;\0A#elif MBEDTLS_MPI_WINDOW_SIZE == 5\0A    return (Ebits > 239) ? 5 : (Ebits >  79) ? 4 : 1;\0A#elif MBEDTLS_MPI_WINDOW_SIZE > 1\0A    return (Ebits >  79) ? MBEDTLS_MPI_WINDOW_SIZE : 1;\0A#else\0A    (void) Ebits;\0A    return 1;\0A#endif\0A}\0A\0Asize_t mbedtls_mpi_core_exp_mod_working_limbs(size_t AN_limbs, size_t E_limbs)\0A{\0A    const size_t wsize = exp_mod_get_window_size(E_limbs * biL);\0A    const size_t welem = ((size_t) 1) << wsize;\0A\0A    /* How big does each part of the working memory pool need to be? */\0A    const size_t table_limbs   = welem * AN_limbs;\0A    const size_t select_limbs  = AN_limbs;\0A    const size_t temp_limbs    = 2 * AN_limbs + 1;\0A\0A    return table_limbs + select_limbs + temp_limbs;\0A}\0A\0Astatic void exp_mod_precompute_window(const mbedtls_mpi_uint *A,\0A                                      const mbedtls_mpi_uint *N,\0A                                      size_t AN_limbs,\0A                                      mbedtls_mpi_uint mm,\0A                                      const mbedtls_mpi_uint *RR,\0A                                      size_t welem,\0A                                      mbedtls_mpi_uint *Wtable,\0A                                      mbedtls_mpi_uint *temp)\0A{\0A    /* W[0] = 1 (in Montgomery presentation) */\0A    memset(Wtable, 0, AN_limbs * ciL);\0A    Wtable[0] = 1;\0A    mbedtls_mpi_core_montmul(Wtable, Wtable, RR, AN_limbs, N, AN_limbs, mm, temp);\0A\0A    /* W[1] = A (already in Montgomery presentation) */\0A    mbedtls_mpi_uint *W1 = Wtable + AN_limbs;\0A    memcpy(W1, A, AN_limbs * ciL);\0A\0A    /* W[i+1] = W[i] * W[1], i >= 2 */\0A    mbedtls_mpi_uint *Wprev = W1;\0A    for (size_t i = 2; i < welem; i++) {\0A        mbedtls_mpi_uint *Wcur = Wprev + AN_limbs;\0A        mbedtls_mpi_core_montmul(Wcur, Wprev, W1, AN_limbs, N, AN_limbs, mm, temp);\0A        Wprev = Wcur;\0A    }\0A}\0A\0A#if defined(MBEDTLS_TEST_HOOKS) && !defined(MBEDTLS_THREADING_C)\0Avoid (*mbedtls_safe_codepath_hook)(void) = NULL;\0Avoid (*mbedtls_unsafe_codepath_hook)(void) = NULL;\0A#endif\0A\0A/*\0A * This function calculates the indices of the exponent where the exponentiation algorithm should\0A * start processing.\0A *\0A * Warning! If the parameter E_public has MBEDTLS_MPI_IS_PUBLIC as its value,\0A * this function is not constant time with respect to the exponent (parameter E).\0A */\0Astatic inline void exp_mod_calc_first_bit_optionally_safe(const mbedtls_mpi_uint *E,\0A                                                          size_t E_limbs,\0A                                                          int E_public,\0A                                                          size_t *E_limb_index,\0A                                                          size_t *E_bit_index)\0A{\0A    if (E_public == MBEDTLS_MPI_IS_PUBLIC) {\0A        /*\0A         * Skip leading zero bits.\0A         */\0A        size_t E_bits = mbedtls_mpi_core_bitlen(E, E_limbs);\0A        if (E_bits == 0) {\0A            /*\0A             * If E is 0 mbedtls_mpi_core_bitlen() returns 0. Even if that is the case, we will want\0A             * to represent it as a single 0 bit and as such the bitlength will be 1.\0A             */\0A            E_bits = 1;\0A        }\0A\0A        *E_limb_index = E_bits / biL;\0A        *E_bit_index = E_bits % biL;\0A\0A#if defined(MBEDTLS_TEST_HOOKS) && !defined(MBEDTLS_THREADING_C)\0A        if (mbedtls_unsafe_codepath_hook != NULL) {\0A            mbedtls_unsafe_codepath_hook();\0A        }\0A#endif\0A    } else {\0A        /*\0A         * Here we need to be constant time with respect to E and can't do anything better than\0A         * start at the first allocated bit.\0A         */\0A        *E_limb_index = E_limbs;\0A        *E_bit_index = 0;\0A#if defined(MBEDTLS_TEST_HOOKS) && !defined(MBEDTLS_THREADING_C)\0A        if (mbedtls_safe_codepath_hook != NULL) {\0A            mbedtls_safe_codepath_hook();\0A        }\0A#endif\0A    }\0A}\0A\0A/*\0A * Warning! If the parameter window_public has MBEDTLS_MPI_IS_PUBLIC as its value, this function is\0A * not constant time with respect to the window parameter and consequently the exponent of the\0A * exponentiation (parameter E of mbedtls_mpi_core_exp_mod_optionally_safe).\0A */\0Astatic inline void exp_mod_table_lookup_optionally_safe(mbedtls_mpi_uint *Wselect,\0A                                                        mbedtls_mpi_uint *Wtable,\0A                                                        size_t AN_limbs, size_t welem,\0A                                                        mbedtls_mpi_uint window,\0A                                                        int window_public)\0A{\0A    if (window_public == MBEDTLS_MPI_IS_PUBLIC) {\0A        memcpy(Wselect, Wtable + window * AN_limbs, AN_limbs * ciL);\0A#if defined(MBEDTLS_TEST_HOOKS) && !defined(MBEDTLS_THREADING_C)\0A        if (mbedtls_unsafe_codepath_hook != NULL) {\0A            mbedtls_unsafe_codepath_hook();\0A        }\0A#endif\0A    } else {\0A        /* Select Wtable[window] without leaking window through\0A         * memory access patterns. */\0A        mbedtls_mpi_core_ct_uint_table_lookup(Wselect, Wtable,\0A                                              AN_limbs, welem, window);\0A#if defined(MBEDTLS_TEST_HOOKS) && !defined(MBEDTLS_THREADING_C)\0A        if (mbedtls_safe_codepath_hook != NULL) {\0A            mbedtls_safe_codepath_hook();\0A        }\0A#endif\0A    }\0A}\0A\0A/* Exponentiation: X := A^E mod N.\0A *\0A * Warning! If the parameter E_public has MBEDTLS_MPI_IS_PUBLIC as its value,\0A * this function is not constant time with respect to the exponent (parameter E).\0A *\0A * A must already be in Montgomery form.\0A *\0A * As in other bignum functions, assume that AN_limbs and E_limbs are nonzero.\0A *\0A * RR must contain 2^{2*biL} mod N.\0A *\0A * The algorithm is a variant of Left-to-right k-ary exponentiation: HAC 14.82\0A * (The difference is that the body in our loop processes a single bit instead\0A * of a full window.)\0A */\0Astatic void mbedtls_mpi_core_exp_mod_optionally_safe(mbedtls_mpi_uint *X,\0A                                                     const mbedtls_mpi_uint *A,\0A                                                     const mbedtls_mpi_uint *N,\0A                                                     size_t AN_limbs,\0A                                                     const mbedtls_mpi_uint *E,\0A                                                     size_t E_limbs,\0A                                                     int E_public,\0A                                                     const mbedtls_mpi_uint *RR,\0A                                                     mbedtls_mpi_uint *T)\0A{\0A    /* We'll process the bits of E from most significant\0A     * (limb_index=E_limbs-1, E_bit_index=biL-1) to least significant\0A     * (limb_index=0, E_bit_index=0). */\0A    size_t E_limb_index = E_limbs;\0A    size_t E_bit_index = 0;\0A    exp_mod_calc_first_bit_optionally_safe(E, E_limbs, E_public,\0A                                           &E_limb_index, &E_bit_index);\0A\0A    const size_t wsize = exp_mod_get_window_size(E_limb_index * biL);\0A    const size_t welem = ((size_t) 1) << wsize;\0A\0A    /* This is how we will use the temporary storage T, which must have space\0A     * for table_limbs, select_limbs and (2 * AN_limbs + 1) for montmul. */\0A    const size_t table_limbs  = welem * AN_limbs;\0A    const size_t select_limbs = AN_limbs;\0A\0A    /* Pointers to specific parts of the temporary working memory pool */\0A    mbedtls_mpi_uint *const Wtable  = T;\0A    mbedtls_mpi_uint *const Wselect = Wtable  +  table_limbs;\0A    mbedtls_mpi_uint *const temp    = Wselect + select_limbs;\0A\0A    /*\0A     * Window precomputation\0A     */\0A\0A    const mbedtls_mpi_uint mm = mbedtls_mpi_core_montmul_init(N);\0A\0A    /* Set Wtable[i] = A^i (in Montgomery representation) */\0A    exp_mod_precompute_window(A, N, AN_limbs,\0A                              mm, RR,\0A                              welem, Wtable, temp);\0A\0A    /*\0A     * Fixed window exponentiation\0A     */\0A\0A    /* X = 1 (in Montgomery presentation) initially */\0A    memcpy(X, Wtable, AN_limbs * ciL);\0A\0A    /* At any given time, window contains window_bits bits from E.\0A     * window_bits can go up to wsize. */\0A    size_t window_bits = 0;\0A    mbedtls_mpi_uint window = 0;\0A\0A    do {\0A        /* Square */\0A        mbedtls_mpi_core_montmul(X, X, X, AN_limbs, N, AN_limbs, mm, temp);\0A\0A        /* Move to the next bit of the exponent */\0A        if (E_bit_index == 0) {\0A            --E_limb_index;\0A            E_bit_index = biL - 1;\0A        } else {\0A            --E_bit_index;\0A        }\0A        /* Insert next exponent bit into window */\0A        ++window_bits;\0A        window <<= 1;\0A        window |= (E[E_limb_index] >> E_bit_index) & 1;\0A\0A        /* Clear window if it's full. Also clear the window at the end,\0A         * when we've finished processing the exponent. */\0A        if (window_bits == wsize ||\0A            (E_bit_index == 0 && E_limb_index == 0)) {\0A\0A            exp_mod_table_lookup_optionally_safe(Wselect, Wtable, AN_limbs, welem,\0A                                                 window, E_public);\0A            /* Multiply X by the selected element. */\0A            mbedtls_mpi_core_montmul(X, X, Wselect, AN_limbs, N, AN_limbs, mm,\0A                                     temp);\0A            window = 0;\0A            window_bits = 0;\0A        }\0A    } while (!(E_bit_index == 0 && E_limb_index == 0));\0A}\0A\0Avoid mbedtls_mpi_core_exp_mod(mbedtls_mpi_uint *X,\0A                              const mbedtls_mpi_uint *A,\0A                              const mbedtls_mpi_uint *N, size_t AN_limbs,\0A                              const mbedtls_mpi_uint *E, size_t E_limbs,\0A                              const mbedtls_mpi_uint *RR,\0A                              mbedtls_mpi_uint *T)\0A{\0A    mbedtls_mpi_core_exp_mod_optionally_safe(X,\0A                                             A,\0A                                             N,\0A                                             AN_limbs,\0A                                             E,\0A                                             E_limbs,\0A                                             MBEDTLS_MPI_IS_SECRET,\0A                                             RR,\0A                                             T);\0A}\0A\0Avoid mbedtls_mpi_core_exp_mod_unsafe(mbedtls_mpi_uint *X,\0A                                     const mbedtls_mpi_uint *A,\0A                                     const mbedtls_mpi_uint *N, size_t AN_limbs,\0A                                     const mbedtls_mpi_uint *E, size_t E_limbs,\0A                                     const mbedtls_mpi_uint *RR,\0A                                     mbedtls_mpi_uint *T)\0A{\0A    mbedtls_mpi_core_exp_mod_optionally_safe(X,\0A                                             A,\0A                                             N,\0A                                             AN_limbs,\0A                                             E,\0A                                             E_limbs,\0A                                             MBEDTLS_MPI_IS_PUBLIC,\0A                                             RR,\0A                                             T);\0A}\0A\0Ambedtls_mpi_uint mbedtls_mpi_core_sub_int(mbedtls_mpi_uint *X,\0A                                          const mbedtls_mpi_uint *A,\0A                                          mbedtls_mpi_uint c,  /* doubles as carry */\0A                                          size_t limbs)\0A{\0A    for (size_t i = 0; i < limbs; i++) {\0A        mbedtls_mpi_uint s = A[i];\0A        mbedtls_mpi_uint t = s - c;\0A        c = (t > s);\0A        X[i] = t;\0A    }\0A\0A    return c;\0A}\0A\0Ambedtls_ct_condition_t mbedtls_mpi_core_check_zero_ct(const mbedtls_mpi_uint *A,\0A                                                      size_t limbs)\0A{\0A    volatile const mbedtls_mpi_uint *force_read_A = A;\0A    mbedtls_mpi_uint bits = 0;\0A\0A    for (size_t i = 0; i < limbs; i++) {\0A        bits |= force_read_A[i];\0A    }\0A\0A    return mbedtls_ct_bool(bits);\0A}\0A\0Avoid mbedtls_mpi_core_to_mont_rep(mbedtls_mpi_uint *X,\0A                                  const mbedtls_mpi_uint *A,\0A                                  const mbedtls_mpi_uint *N,\0A                                  size_t AN_limbs,\0A                                  mbedtls_mpi_uint mm,\0A                                  const mbedtls_mpi_uint *rr,\0A                                  mbedtls_mpi_uint *T)\0A{\0A    mbedtls_mpi_core_montmul(X, A, rr, AN_limbs, N, AN_limbs, mm, T);\0A}\0A\0Avoid mbedtls_mpi_core_from_mont_rep(mbedtls_mpi_uint *X,\0A                                    const mbedtls_mpi_uint *A,\0A                                    const mbedtls_mpi_uint *N,\0A                                    size_t AN_limbs,\0A                                    mbedtls_mpi_uint mm,\0A                                    mbedtls_mpi_uint *T)\0A{\0A    const mbedtls_mpi_uint Rinv = 1;    /* 1/R in Mont. rep => 1 */\0A\0A    mbedtls_mpi_core_montmul(X, A, &Rinv, 1, N, AN_limbs, mm, T);\0A}\0A\0A#endif /* MBEDTLS_BIGNUM_C */\0A\00" }
