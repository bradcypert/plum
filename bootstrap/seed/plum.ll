@.str41096 = private global { i64, i64, [8857 x i8] } { i64 -1, i64 8856, [8857 x i8] c"/**\0A *  Constant-time functions\0A *\0A *  Copyright The Mbed TLS Contributors\0A *  SPDX-License-Identifier: Apache-2.0 OR GPL-2.0-or-later\0A */\0A\0A/*\0A * The following functions are implemented without using comparison operators, as those\0A * might be translated to branches by some compilers on some platforms.\0A */\0A\0A#include <stdint.h>\0A#include <limits.h>\0A\0A#include \22common.h\22\0A#include \22constant_time_internal.h\22\0A#include \22mbedtls/constant_time.h\22\0A#include \22mbedtls/error.h\22\0A#include \22mbedtls/platform_util.h\22\0A\0A#include <string.h>\0A\0A#if !defined(MBEDTLS_CT_ASM)\0A/*\0A * Define an object with the value zero, such that the compiler cannot prove that it\0A * has the value zero (because it is volatile, it \22may be modified in ways unknown to\0A * the implementation\22).\0A */\0Avolatile mbedtls_ct_uint_t mbedtls_ct_zero = 0;\0A#endif\0A\0A/*\0A * Define MBEDTLS_EFFICIENT_UNALIGNED_VOLATILE_ACCESS where assembly is present to\0A * perform fast unaligned access to volatile data.\0A *\0A * This is needed because mbedtls_get_unaligned_uintXX etc don't support volatile\0A * memory accesses.\0A *\0A * Some of these definitions could be moved into alignment.h but for now they are\0A * only used here.\0A */\0A#if defined(MBEDTLS_EFFICIENT_UNALIGNED_ACCESS) && \5C\0A    ((defined(MBEDTLS_CT_ARM_ASM) && (UINTPTR_MAX == 0xfffffffful)) || \5C\0A    defined(MBEDTLS_CT_AARCH64_ASM))\0A/* We check pointer sizes to avoid issues with them not matching register size requirements */\0A#define MBEDTLS_EFFICIENT_UNALIGNED_VOLATILE_ACCESS\0A\0Astatic inline uint32_t mbedtls_get_unaligned_volatile_uint32(volatile const unsigned char *p)\0A{\0A    /* This is UB, even where it's safe:\0A     *    return *((volatile uint32_t*)p);\0A     * so instead the same thing is expressed in assembly below.\0A     */\0A    uint32_t r;\0A#if defined(MBEDTLS_CT_ARM_ASM)\0A    asm volatile (\22ldr %0, [%1]\22 : \22=r\22 (r) : \22r\22 (p) :);\0A#elif defined(MBEDTLS_CT_AARCH64_ASM)\0A    asm volatile (\22ldr %w0, [%1]\22 : \22=r\22 (r) : MBEDTLS_ASM_AARCH64_PTR_CONSTRAINT(p) :);\0A#else\0A#error \22No assembly defined for mbedtls_get_unaligned_volatile_uint32\22\0A#endif\0A    return r;\0A}\0A#endif /* defined(MBEDTLS_EFFICIENT_UNALIGNED_ACCESS) &&\0A          (defined(MBEDTLS_CT_ARM_ASM) || defined(MBEDTLS_CT_AARCH64_ASM)) */\0A\0Aint mbedtls_ct_memcmp(const void *a,\0A                      const void *b,\0A                      size_t n)\0A{\0A    size_t i = 0;\0A    /*\0A     * `A` and `B` are cast to volatile to ensure that the compiler\0A     * generates code that always fully reads both buffers.\0A     * Otherwise it could generate a test to exit early if `diff` has all\0A     * bits set early in the loop.\0A     */\0A    volatile const unsigned char *A = (volatile const unsigned char *) a;\0A    volatile const unsigned char *B = (volatile const unsigned char *) b;\0A    uint32_t diff = 0;\0A\0A#if defined(MBEDTLS_EFFICIENT_UNALIGNED_VOLATILE_ACCESS)\0A    for (; (i + 4) <= n; i += 4) {\0A        uint32_t x = mbedtls_get_unaligned_volatile_uint32(A + i);\0A        uint32_t y = mbedtls_get_unaligned_volatile_uint32(B + i);\0A        diff |= x ^ y;\0A    }\0A#endif\0A\0A    for (; i < n; i++) {\0A        /* Read volatile data in order before computing diff.\0A         * This avoids IAR compiler warning:\0A         * 'the order of volatile accesses is undefined ..' */\0A        unsigned char x = A[i], y = B[i];\0A        diff |= x ^ y;\0A    }\0A\0A\0A#if (INT_MAX < INT32_MAX)\0A    /* We don't support int smaller than 32-bits, but if someone tried to build\0A     * with this configuration, there is a risk that, for differing data, the\0A     * only bits set in diff are in the top 16-bits, and would be lost by a\0A     * simple cast from uint32 to int.\0A     * This would have significant security implications, so protect against it. */\0A#error \22mbedtls_ct_memcmp() requires minimum 32-bit ints\22\0A#else\0A    /* The bit-twiddling ensures that when we cast uint32_t to int, we are casting\0A     * a value that is in the range 0..INT_MAX - a value larger than this would\0A     * result in implementation defined behaviour.\0A     *\0A     * This ensures that the value returned by the function is non-zero iff\0A     * diff is non-zero.\0A     */\0A    return (int) ((diff & 0xffff) | (diff >> 16));\0A#endif\0A}\0A\0A#if defined(MBEDTLS_NIST_KW_C)\0A\0Aint mbedtls_ct_memcmp_partial(const void *a,\0A                              const void *b,\0A                              size_t n,\0A                              size_t skip_head,\0A                              size_t skip_tail)\0A{\0A    unsigned int diff = 0;\0A\0A    volatile const unsigned char *A = (volatile const unsigned char *) a;\0A    volatile const unsigned char *B = (volatile const unsigned char *) b;\0A\0A    size_t valid_end = n - skip_tail;\0A\0A    for (size_t i = 0; i < n; i++) {\0A        unsigned char x = A[i], y = B[i];\0A        unsigned int d = x ^ y;\0A        mbedtls_ct_condition_t valid = mbedtls_ct_bool_and(mbedtls_ct_uint_ge(i, skip_head),\0A                                                           mbedtls_ct_uint_lt(i, valid_end));\0A        diff |= mbedtls_ct_uint_if_else_0(valid, d);\0A    }\0A\0A    /* Since we go byte-by-byte, the only bits set will be in the bottom 8 bits, so the\0A     * cast from uint to int is safe. */\0A    return (int) diff;\0A}\0A\0A#endif\0A\0A#if defined(MBEDTLS_PKCS1_V15) && defined(MBEDTLS_RSA_C) && !defined(MBEDTLS_RSA_ALT)\0A\0Avoid mbedtls_ct_memmove_left(void *start, size_t total, size_t offset)\0A{\0A    volatile unsigned char *buf = start;\0A    for (size_t i = 0; i < total; i++) {\0A        mbedtls_ct_condition_t no_op = mbedtls_ct_uint_gt(total - offset, i);\0A        /* The first `total - offset` passes are a no-op. The last\0A         * `offset` passes shift the data one byte to the left and\0A         * zero out the last byte. */\0A        for (size_t n = 0; n < total - 1; n++) {\0A            unsigned char current = buf[n];\0A            unsigned char next    = buf[n+1];\0A            buf[n] = mbedtls_ct_uint_if(no_op, current, next);\0A        }\0A        buf[total-1] = mbedtls_ct_uint_if_else_0(no_op, buf[total-1]);\0A    }\0A}\0A\0A#endif /* MBEDTLS_PKCS1_V15 && MBEDTLS_RSA_C && ! MBEDTLS_RSA_ALT */\0A\0Avoid mbedtls_ct_memcpy_if(mbedtls_ct_condition_t condition,\0A                          unsigned char *dest,\0A                          const unsigned char *src1,\0A                          const unsigned char *src2,\0A                          size_t len)\0A{\0A#if defined(MBEDTLS_CT_SIZE_64)\0A    const uint64_t mask     = (uint64_t) condition;\0A    const uint64_t not_mask = (uint64_t) ~mbedtls_ct_compiler_opaque(condition);\0A#else\0A    const uint32_t mask     = (uint32_t) condition;\0A    const uint32_t not_mask = (uint32_t) ~mbedtls_ct_compiler_opaque(condition);\0A#endif\0A\0A    /* If src2 is NULL, setup src2 so that we read from the destination address.\0A     *\0A     * This means that if src2 == NULL && condition is false, the result will be a\0A     * no-op because we read from dest and write the same data back into dest.\0A     */\0A    if (src2 == NULL) {\0A        src2 = dest;\0A    }\0A\0A    /* dest[i] = c1 == c2 ? src[i] : dest[i] */\0A    size_t i = 0;\0A#if defined(MBEDTLS_EFFICIENT_UNALIGNED_ACCESS)\0A#if defined(MBEDTLS_CT_SIZE_64)\0A    for (; (i + 8) <= len; i += 8) {\0A        uint64_t a = mbedtls_get_unaligned_uint64(src1 + i) & mask;\0A        uint64_t b = mbedtls_get_unaligned_uint64(src2 + i) & not_mask;\0A        mbedtls_put_unaligned_uint64(dest + i, a | b);\0A    }\0A#else\0A    for (; (i + 4) <= len; i += 4) {\0A        uint32_t a = mbedtls_get_unaligned_uint32(src1 + i) & mask;\0A        uint32_t b = mbedtls_get_unaligned_uint32(src2 + i) & not_mask;\0A        mbedtls_put_unaligned_uint32(de