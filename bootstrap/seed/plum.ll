@.str45707 = private global { i64, i64, [19762 x i8] } { i64 -1, i64 19761, [19762 x i8] c"/**\0A * \5Cfile mbedtls/config_adjust_legacy_crypto.h\0A * \5Cbrief Adjust legacy configuration configuration\0A *\0A * This is an internal header. Do not include it directly.\0A *\0A * Automatically enable certain dependencies. Generally, MBEDTLS_xxx\0A * configurations need to be explicitly enabled by the user: enabling\0A * MBEDTLS_xxx_A but not MBEDTLS_xxx_B when A requires B results in a\0A * compilation error. However, we do automatically enable certain options\0A * in some circumstances. One case is if MBEDTLS_xxx_B is an internal option\0A * used to identify parts of a module that are used by other module, and we\0A * don't want to make the symbol MBEDTLS_xxx_B part of the public API.\0A * Another case is if A didn't depend on B in earlier versions, and we\0A * want to use B in A but we need to preserve backward compatibility with\0A * configurations that explicitly activate MBEDTLS_xxx_A but not\0A * MBEDTLS_xxx_B.\0A */\0A/*\0A *  Copyright The Mbed TLS Contributors\0A *  SPDX-License-Identifier: Apache-2.0 OR GPL-2.0-or-later\0A */\0A\0A#ifndef MBEDTLS_CONFIG_ADJUST_LEGACY_CRYPTO_H\0A#define MBEDTLS_CONFIG_ADJUST_LEGACY_CRYPTO_H\0A\0A#if !defined(MBEDTLS_CONFIG_FILES_READ)\0A#error \22Do not include mbedtls/config_adjust_*.h manually! This can lead to problems, \22 \5C\0A    \22up to and including runtime errors such as buffer overflows. \22 \5C\0A    \22If you're trying to fix a complaint from check_config.h, just remove \22 \5C\0A    \22it from your configuration file: since Mbed TLS 3.0, it is included \22 \5C\0A    \22automatically at the right point.\22\0A#endif /* */\0A\0A/* Ideally, we'd set those as defaults in mbedtls_config.h, but\0A * putting an #ifdef _WIN32 in mbedtls_config.h would confuse config.py.\0A *\0A * So, adjust it here.\0A * Not related to crypto, but this is the bottom of the stack. */\0A#if defined(__MINGW32__) || (defined(_MSC_VER) && _MSC_VER <= 1900)\0A#if !defined(MBEDTLS_PLATFORM_SNPRINTF_ALT) && \5C\0A    !defined(MBEDTLS_PLATFORM_SNPRINTF_MACRO)\0A#define MBEDTLS_PLATFORM_SNPRINTF_ALT\0A#endif\0A#if !defined(MBEDTLS_PLATFORM_VSNPRINTF_ALT) && \5C\0A    !defined(MBEDTLS_PLATFORM_VSNPRINTF_MACRO)\0A#define MBEDTLS_PLATFORM_VSNPRINTF_ALT\0A#endif\0A#endif /* _MINGW32__ || (_MSC_VER && (_MSC_VER <= 1900)) */\0A\0A/* If MBEDTLS_PSA_CRYPTO_C is defined, make sure MBEDTLS_PSA_CRYPTO_CLIENT\0A * is defined as well to include all PSA code.\0A */\0A#if defined(MBEDTLS_PSA_CRYPTO_C)\0A#define MBEDTLS_PSA_CRYPTO_CLIENT\0A#endif /* MBEDTLS_PSA_CRYPTO_C */\0A\0A/* Auto-enable CIPHER_C when any of the unauthenticated ciphers is builtin\0A * in PSA. */\0A#if defined(MBEDTLS_PSA_CRYPTO_C) && \5C\0A    (defined(MBEDTLS_PSA_BUILTIN_ALG_STREAM_CIPHER) || \5C\0A    defined(MBEDTLS_PSA_BUILTIN_ALG_CTR) || \5C\0A    defined(MBEDTLS_PSA_BUILTIN_ALG_CFB) || \5C\0A    defined(MBEDTLS_PSA_BUILTIN_ALG_OFB) || \5C\0A    defined(MBEDTLS_PSA_BUILTIN_ALG_ECB_NO_PADDING) || \5C\0A    defined(MBEDTLS_PSA_BUILTIN_ALG_CBC_NO_PADDING) || \5C\0A    defined(MBEDTLS_PSA_BUILTIN_ALG_CBC_PKCS7) || \5C\0A    defined(MBEDTLS_PSA_BUILTIN_ALG_CCM_STAR_NO_TAG) || \5C\0A    defined(MBEDTLS_PSA_BUILTIN_ALG_CMAC))\0A#define MBEDTLS_CIPHER_C\0A#endif\0A\0A/* Auto-enable MBEDTLS_MD_LIGHT based on MBEDTLS_MD_C.\0A * This allows checking for MD_LIGHT rather than MD_LIGHT || MD_C.\0A */\0A#if defined(MBEDTLS_MD_C)\0A#define MBEDTLS_MD_LIGHT\0A#endif\0A\0A/* Auto-enable MBEDTLS_MD_LIGHT if needed by a module that didn't require it\0A * in a previous release, to ensure backwards compatibility.\0A */\0A#if defined(MBEDTLS_ECJPAKE_C) || \5C\0A    defined(MBEDTLS_PEM_PARSE_C) || \5C\0A    defined(MBEDTLS_ENTROPY_C) || \5C\0A    defined(MBEDTLS_PK_C) || \5C\0A    defined(MBEDTLS_PKCS12_C) || \5C\0A    defined(MBEDTLS_RSA_C) || \5C\0A    defined(MBEDTLS_SSL_TLS_C) || \5C\0A    defined(MBEDTLS_X509_USE_C) || \5C\0A    defined(MBEDTLS_X509_CREATE_C)\0A#define MBEDTLS_MD_LIGHT\0A#endif\0A\0A#if defined(MBEDTLS_MD_LIGHT)\0A/*\0A * - MBEDTLS_MD_CAN_xxx is defined if the md module can perform xxx.\0A * - MBEDTLS_MD_xxx_VIA_PSA is defined if the md module may perform xxx via PSA\0A *   (see below).\0A * - MBEDTLS_MD_SOME_PSA is defined if at least one algorithm may be performed\0A *   via PSA (see below).\0A * - MBEDTLS_MD_SOME_LEGACY is defined if at least one algorithm may be performed\0A *   via a direct legacy call (see below).\0A *\0A * The md module performs an algorithm via PSA if there is a PSA hash\0A * accelerator and the PSA driver subsytem is initialized at the time the\0A * operation is started, and makes a direct legacy call otherwise.\0A */\0A\0A/* PSA accelerated implementations */\0A#if defined(MBEDTLS_PSA_CRYPTO_C)\0A\0A#if defined(MBEDTLS_PSA_ACCEL_ALG_MD5)\0A#define MBEDTLS_MD_CAN_MD5\0A#define MBEDTLS_MD_MD5_VIA_PSA\0A#define MBEDTLS_MD_SOME_PSA\0A#endif\0A#if defined(MBEDTLS_PSA_ACCEL_ALG_SHA_1)\0A#define MBEDTLS_MD_CAN_SHA1\0A#define MBEDTLS_MD_SHA1_VIA_PSA\0A#define MBEDTLS_MD_SOME_PSA\0A#endif\0A#if defined(MBEDTLS_PSA_ACCEL_ALG_SHA_224)\0A#define MBEDTLS_MD_CAN_SHA224\0A#define MBEDTLS_MD_SHA224_VIA_PSA\0A#define MBEDTLS_MD_SOME_PSA\0A#endif\0A#if defined(MBEDTLS_PSA_ACCEL_ALG_SHA_256)\0A#define MBEDTLS_MD_CAN_SHA256\0A#define MBEDTLS_MD_SHA256_VIA_PSA\0A#define MBEDTLS_MD_SOME_PSA\0A#endif\0A#if defined(MBEDTLS_PSA_ACCEL_ALG_SHA_384)\0A#define MBEDTLS_MD_CAN_SHA384\0A#define MBEDTLS_MD_SHA384_VIA_PSA\0A#define MBEDTLS_MD_SOME_PSA\0A#endif\0A#if defined(MBEDTLS_PSA_ACCEL_ALG_SHA_512)\0A#define MBEDTLS_MD_CAN_SHA512\0A#define MBEDTLS_MD_SHA512_VIA_PSA\0A#define MBEDTLS_MD_SOME_PSA\0A#endif\0A#if defined(MBEDTLS_PSA_ACCEL_ALG_RIPEMD160)\0A#define MBEDTLS_MD_CAN_RIPEMD160\0A#define MBEDTLS_MD_RIPEMD160_VIA_PSA\0A#define MBEDTLS_MD_SOME_PSA\0A#endif\0A#if defined(MBEDTLS_PSA_ACCEL_ALG_SHA3_224)\0A#define MBEDTLS_MD_CAN_SHA3_224\0A#define MBEDTLS_MD_SHA3_224_VIA_PSA\0A#define MBEDTLS_MD_SOME_PSA\0A#endif\0A#if defined(MBEDTLS_PSA_ACCEL_ALG_SHA3_256)\0A#define MBEDTLS_MD_CAN_SHA3_256\0A#define MBEDTLS_MD_SHA3_256_VIA_PSA\0A#define MBEDTLS_MD_SOME_PSA\0A#endif\0A#if defined(MBEDTLS_PSA_ACCEL_ALG_SHA3_384)\0A#define MBEDTLS_MD_CAN_SHA3_384\0A#define MBEDTLS_MD_SHA3_384_VIA_PSA\0A#define MBEDTLS_MD_SOME_PSA\0A#endif\0A#if defined(MBEDTLS_PSA_ACCEL_ALG_SHA3_512)\0A#define MBEDTLS_MD_CAN_SHA3_512\0A#define MBEDTLS_MD_SHA3_512_VIA_PSA\0A#define MBEDTLS_MD_SOME_PSA\0A#endif\0A\0A#elif defined(MBEDTLS_PSA_CRYPTO_CLIENT)\0A\0A#if defined(PSA_WANT_ALG_MD5)\0A#define MBEDTLS_MD_CAN_MD5\0A#define MBEDTLS_MD_MD5_VIA_PSA\0A#define MBEDTLS_MD_SOME_PSA\0A#endif\0A#if defined(PSA_WANT_ALG_SHA_1)\0A#define MBEDTLS_MD_CAN_SHA1\0A#define MBEDTLS_MD_SHA1_VIA_PSA\0A#define MBEDTLS_MD_SOME_PSA\0A#endif\0A#if defined(PSA_WANT_ALG_SHA_224)\0A#define MBEDTLS_MD_CAN_SHA224\0A#define MBEDTLS_MD_SHA224_VIA_PSA\0A#define MBEDTLS_MD_SOME_PSA\0A#endif\0A#if defined(PSA_WANT_ALG_SHA_256)\0A#define MBEDTLS_MD_CAN_SHA256\0A#define MBEDTLS_MD_SHA256_VIA_PSA\0A#define MBEDTLS_MD_SOME_PSA\0A#endif\0A#if defined(PSA_WANT_ALG_SHA_384)\0A#define MBEDTLS_MD_CAN_SHA384\0A#define MBEDTLS_MD_SHA384_VIA_PSA\0A#define MBEDTLS_MD_SOME_PSA\0A#endif\0A#if defined(PSA_WANT_ALG_SHA_512)\0A#define MBEDTLS_MD_CAN_SHA512\0A#define MBEDTLS_MD_SHA512_VIA_PSA\0A#define MBEDTLS_MD_SOME_PSA\0A#endif\0A#if defined(PSA_WANT_ALG_RIPEMD160)\0A#define MBEDTLS_MD_CAN_RIPEMD160\0A#define MBEDTLS_MD_RIPEMD160_VIA_PSA\0A#define MBEDTLS_MD_SOME_PSA\0A#endif\0A#if defined(PSA_WANT_ALG_SHA3_224)\0A#define MBEDTLS_MD_CAN_SHA3_224\0A#define MBEDTLS_MD_SHA3_224_VIA_PSA\0A#define MBEDTLS_MD_SOME_PSA\0A#endif\0A#if defined(PSA_WANT_ALG_SHA3_256)\0A#define MBEDTLS_MD_CAN_SHA3_256\0A#define MBEDTLS_MD_SHA3_256_VIA_PSA\0A#define MBEDTLS_MD_SOME_PSA\0A#endif\0A#if defined(PSA_WANT_ALG_SHA3_384)\0A#define MBEDTLS_MD_CAN_SHA3_384\0A#define MBEDTLS_MD_SHA3_384_VIA_PSA\0A#define MBEDTLS_MD_SOME_PSA\0A#endif\0A#if defined(PSA_WANT_ALG_SHA3_512)\0A#define MBEDTLS_MD_CAN_SHA3_512\0A#define MBEDTLS_MD_SHA3_512_VIA_PSA\0A#define MBEDTLS_MD_SOME_PSA\0A#endif\0A\0A#endif /* !MBEDTLS_PSA_CRYPTO_CLIENT && !MBEDTLS_PSA_CRYPTO_C */\0A\0A/* Built-in implementations */\0A#if defined(MBEDTLS_MD5_C)\0A#define MBEDTLS_MD_CAN_MD5\0A#define MBEDTLS_MD_SOME_LEGACY\0A#endif\0A#if defined(MBEDTLS_SHA1_C)\0A#define MBEDTLS_MD_CAN_SHA1\0A#define MBEDTLS_MD_SOME_LEGACY\0A#endif\0A#if defined(MBEDTLS_SHA224_C)\0A#define MBEDTLS_MD_CAN_SHA224\0A#define MBEDTLS_MD_SOME_LEGACY\0A#endif\0A#if defined(MBEDTLS_SHA256_C)\0A#define MBEDTLS_MD_CAN_SHA256\0A#define MBEDTLS_MD_SOME_LEGACY\0A#endif\0A#if defined(MBEDTLS_SHA384_C)\0A#define MBEDTLS_MD_CAN_SHA384\0A#define MBEDTLS_MD_SOME_LEGACY\0A#endif\0A#if defined(MBEDTLS_SHA512_C)\0A#define MBEDTLS_MD_CAN_SHA512\0A#define MBEDTLS_MD_SOME_LEGACY\0A#endif\0A#if defined(MBEDTLS_SHA3_C)\0A#define MBEDTLS_MD_CAN_SHA3_224\0A#define MBEDTLS_MD_CAN_SHA3_256\0A#define MBEDTLS_MD_CAN_SHA3_384\0A#define MBEDTLS_MD_CAN_SHA3_512\0A#define MBEDTLS_MD_SOME_LEGACY\0A#endif\0A#if defined(MBEDTLS_RIPEMD160_C)\0A#define MBEDTLS_MD_CAN_RIPEMD160\0A#define MBEDTLS_MD_SOME_LEGACY\0A#endif\0A\0A#endif /* MBEDTLS_MD_LIGHT */\0A\0A/* BLOCK_CIPHER module can dispatch to PSA when:\0A * - PSA is enabled and drivers have been initialized\0A * - desired key type is supported on the PSA side\0A * If the above conditions are not met, but the legacy support is enabled, then\0A * BLOCK_CIPHER will dynamically fallback to it.\0A *\0A * In case BLOCK_CIPHER is defined (see below) the following symbols/helpers\0A * can be used to define its capabilities:\0A * - MBEDTLS_BLOCK_CIPHER_SOME_PSA: there is at least 1 key type between AES,\0A *   ARIA and Camellia which is supported through a driver;\0A * - MBEDTLS_BLOCK_CIPHER_xxx_VIA_PSA: xxx key type is supported through a\0A *   driver;\0A * - MBEDTLS_BLOCK_CIPHER_xxx_VIA_LEGACY: xxx key type is supported through\0A *   a legacy module (i.e. MBEDTLS_xxx_C)\0A */\0A#if defined(MBEDTLS_PSA_CRYPTO_C)\0A#if defined(MBEDTLS_PSA_ACCEL_KEY_TYPE_AES)\0A#define MBEDTLS_BLOCK_CIPHER_AES_VIA_PSA\0A#define MBEDTLS_BLOCK_CIPHER_SOME_PSA\0A#endif\0A#if defined(MBEDTLS_PSA_ACCEL_KEY_TYPE_ARIA)\0A#define MBEDTLS_BLOCK_CIPHER_ARIA_VIA_PSA\0A#define MBEDTLS_BLOCK_CIPHER_SOME_PSA\0A#endif\0A#if defined(MBEDTLS_PSA_ACCEL_KEY_TYPE_CAMELLIA)\0A#define MBEDTLS_BLOCK_CIPHER_CAMELLIA_VIA_PSA\0A#define MBEDTLS_BLOCK_CIPHER_SOME_PSA\0A#endif\0A#endif /* MBEDTLS_PSA_CRYPTO_C */\0A\0A#if defined(MBEDTLS_AES_C)\0A#define MBEDTLS_BLOCK_CIPHER_AES_VIA_LEGACY\0A#endif\0A#if defined(MBEDTLS_ARIA_C)\0A#define MBEDTLS_BLOCK_CIPHER_ARIA_VIA_LEGACY\0A#endif\0A#if defined(MBEDTLS_CAMELLIA_C)\0A#define MBEDTLS_BLOCK_CIPHER_CAMELLIA_VIA_LEGACY\0A#endif\0A\0A/* Helpers to state that BLOCK_CIPHER module supports AES, ARIA and/or Camellia\0A * block ciphers via either PSA or legacy. */\0A#if defined(MBEDTLS_BLOCK_CIPHER_AES_VIA_PSA) || \5C\0A    defined(MBEDTLS_BLOCK_CIPHER_AES_VIA_LEGACY)\0A#define MBEDTLS_BLOCK_CIPHER_CAN_AES\0A#endif\0A#if defined(MBEDTLS_BLOCK_CIPHER_ARIA_VIA_PSA) || \5C\0A    defined(MBEDTLS_BLOCK_CIPHER_ARIA_VIA_LEGACY)\0A#define MBEDTLS_BLOCK_CIPHER_CAN_ARIA\0A#endif\0A#if defined(MBEDTLS_BLOCK_CIPHER_CAMELLIA_VIA_PSA) || \5C\0A    defined(MBEDTLS_BLOCK_CIPHER_CAMELLIA_VIA_LEGACY)\0A#define MBEDTLS_BLOCK_CIPHER_CAN_CAMELLIA\0A#endif\0A\0A/* GCM_C and CCM_C can either depend on (in order of preference) BLOCK_CIPHER_C\0A * or CIPHER_C. The former is auto-enabled when:\0A * - CIPHER_C is not defined, which is also the legacy solution;\0A * - BLOCK_CIPHER_SOME_PSA because in this case BLOCK_CIPHER can take advantage\0A *   of the driver's acceleration.\0A */\0A#if (defined(MBEDTLS_GCM_C) || defined(MBEDTLS_CCM_C)) && \5C\0A    (!defined(MBEDTLS_CIPHER_C) || defined(MBEDTLS_BLOCK_CIPHER_SOME_PSA))\0A#define MBEDTLS_BLOCK_CIPHER_C\0A#endif\0A\0A/* Helpers for GCM/CCM capabilities */\0A#if (defined(MBEDTLS_CIPHER_C) && defined(MBEDTLS_AES_C)) || \5C\0A    (defined(MBEDTLS_BLOCK_CIPHER_C) && defined(MBEDTLS_BLOCK_CIPHER_CAN_AES))\0A#define MBEDTLS_CCM_GCM_CAN_AES\0A#endif\0A\0A#if (defined(MBEDTLS_CIPHER_C) && defined(MBEDTLS_ARIA_C)) || \5C\0A    (defined(MBEDTLS_BLOCK_CIPHER_C) && defined(MBEDTLS_BLOCK_CIPHER_CAN_ARIA))\0A#define MBEDTLS_CCM_GCM_CAN_ARIA\0A#endif\0A\0A#if (defined(MBEDTLS_CIPHER_C) && defined(MBEDTLS_CAMELLIA_C)) || \5C\0A    (defined(MBEDTLS_BLOCK_CIPHER_C) && defined(MBEDTLS_BLOCK_CIPHER_CAN_CAMELLIA))\0A#define MBEDTLS_CCM_GCM_CAN_CAMELLIA\0A#endif\0A\0A/* MBEDTLS_ECP_LIGHT is auto-enabled by the following symbols:\0A * - MBEDTLS_ECP_C because now it consists of MBEDTLS_ECP_LIGHT plus functions\0A *   for curve arithmetic. As a consequence if MBEDTLS_ECP_C is required for\0A *   some reason, then MBEDTLS_ECP_LIGHT should be enabled as well.\0A * - MBEDTLS_PK_PARSE_EC_EXTENDED and MBEDTLS_PK_PARSE_EC_COMPRESSED because\0A *   these features are not supported in PSA so the only way to have them is\0A *   to enable the built-in solution.\0A *   Both of them are temporary dependencies:\0A *   - PK_PARSE_EC_EXTENDED will be removed after #7779 and #7789\0A *   - support for compressed points should also be added to PSA, but in this\0A *     case there is no associated issue to track it yet.\0A * - PSA_WANT_KEY_TYPE_ECC_KEY_PAIR_DERIVE because Weierstrass key derivation\0A *   still depends on ECP_LIGHT.\0A * - PK_C + USE_PSA + PSA_WANT_ALG_ECDSA is a temporary dependency which will\0A *   be fixed by #7453.\0A */\0A#if defined(MBEDTLS_ECP_C) || \5C\0A    defined(MBEDTLS_PK_PARSE_EC_EXTENDED) || \5C\0A    defined(MBEDTLS_PK_PARSE_EC_COMPRESSED) || \5C\0A    defined(MBEDTLS_PSA_BUILTIN_KEY_TYPE_ECC_KEY_PAIR_DERIVE)\0A#define MBEDTLS_ECP_LIGHT\0A#endif\0A\0A/* Backward compatibility: after #8740 the RSA module offers functions to parse\0A * and write RSA private/public keys without relying on the PK one. Of course\0A * this needs ASN1 support to do so, so we enable it here. */\0A#if defined(MBEDTLS_RSA_C)\0A#define MBEDTLS_ASN1_PARSE_C\0A#define MBEDTLS_ASN1_WRITE_C\0A#endif\0A\0A/* MBEDTLS_PK_PARSE_EC_COMPRESSED is introduced in Mbed TLS version 3.5, while\0A * in previous version compressed points were automatically supported as long\0A * as PK_PARSE_C and ECP_C were enabled. As a consequence, for backward\0A * compatibility, we auto-enable PK_PARSE_EC_COMPRESSED when these conditions\0A * are met. */\0A#if defined(MBEDTLS_PK_PARSE_C) && defined(MBEDTLS_ECP_C)\0A#define MBEDTLS_PK_PARSE_EC_COMPRESSED\0A#endif\0A\0A/* Helper symbol to state that there is support for ECDH, either through\0A * library implementation (ECDH_C) or through PSA. */\0A#if (defined(MBEDTLS_USE_PSA_CRYPTO) && defined(PSA_WANT_ALG_ECDH)) || \5C\0A    (!defined(MBEDTLS_USE_PSA_CRYPTO) && defined(MBEDTLS_ECDH_C))\0A#define MBEDTLS_CAN_ECDH\0A#endif\0A\0A/* PK module can achieve ECDSA functionalities by means of either software\0A * implementations (ECDSA_C) or through a PSA driver. The following defines\0A * are meant to list these capabilities in a general way which abstracts how\0A * they are implemented under the hood. */\0A#if !defined(MBEDTLS_USE_PSA_CRYPTO)\0A#if defined(MBEDTLS_ECDSA_C)\0A#define MBEDTLS_PK_CAN_ECDSA_SIGN\0A#define MBEDTLS_PK_CAN_ECDSA_VERIFY\0A#endif /* MBEDTLS_ECDSA_C */\0A#else /* MBEDTLS_USE_PSA_CRYPTO */\0A#if defined(PSA_WANT_ALG_ECDSA)\0A#if defined(PSA_WANT_KEY_TYPE_ECC_KEY_PAIR_BASIC)\0A#define MBEDTLS_PK_CAN_ECDSA_SIGN\0A#endif /* PSA_WANT_KEY_TYPE_ECC_KEY_PAIR_BASIC */\0A#if defined(PSA_WANT_KEY_TYPE_ECC_PUBLIC_KEY)\0A#define MBEDTLS_PK_CAN_ECDSA_VERIFY\0A#endif /* PSA_WANT_KEY_TYPE_ECC_PUBLIC_KEY */\0A#endif /* PSA_WANT_ALG_ECDSA */\0A#endif /* MBEDTLS_USE_PSA_CRYPTO */\0A\0A#if defined(MBEDTLS_PK_CAN_ECDSA_VERIFY) || defined(MBEDTLS_PK_CAN_ECDSA_SIGN)\0A#define MBEDTLS_PK_CAN_ECDSA_SOME\0A#endif\0A\0A/* Helpers to state that each key is supported either on the builtin or PSA side. */\0A#if defined(MBEDTLS_ECP_DP_SECP521R1_ENABLED) || defined(PSA_WANT_ECC_SECP_R1_521)\0A#define MBEDTLS_ECP_HAVE_SECP521R1\0A#endif\0A#if defined(MBEDTLS_ECP_DP_BP512R1_ENABLED) || defined(PSA_WANT_ECC_BRAINPOOL_P_R1_512)\0A#define MBEDTLS_ECP_HAVE_BP512R1\0A#endif\0A#if defined(MBEDTLS_ECP_DP_CURVE448_ENABLED) || defined(PSA_WANT_ECC_MONTGOMERY_448)\0A#define MBEDTLS_ECP_HAVE_CURVE448\0A#endif\0A#if defined(MBEDTLS_ECP_DP_BP384R1_ENABLED) || defined(PSA_WANT_ECC_BRAINPOOL_P_R1_384)\0A#define MBEDTLS_ECP_HAVE_BP384R1\0A#endif\0A#if defined(MBEDTLS_ECP_DP_SECP384R1_ENABLED) || defined(PSA_WANT_ECC_SECP_R1_384)\0A#define MBEDTLS_ECP_HAVE_SECP384R1\0A#endif\0A#if defined(MBEDTLS_ECP_DP_BP256R1_ENABLED) || defined(PSA_WANT_ECC_BRAINPOOL_P_R1_256)\0A#define MBEDTLS_ECP_HAVE_BP256R1\0A#endif\0A#if defined(MBEDTLS_ECP_DP_SECP256K1_ENABLED) || defined(PSA_WANT_ECC_SECP_K1_256)\0A#define MBEDTLS_ECP_HAVE_SECP256K1\0A#endif\0A#if defined(MBEDTLS_ECP_DP_SECP256R1_ENABLED) || defined(PSA_WANT_ECC_SECP_R1_256)\0A#define MBEDTLS_ECP_HAVE_SECP256R1\0A#endif\0A#if defined(MBEDTLS_ECP_DP_CURVE25519_ENABLED) || defined(PSA_WANT_ECC_MONTGOMERY_255)\0A#define MBEDTLS_ECP_HAVE_CURVE25519\0A#endif\0A#if defined(MBEDTLS_ECP_DP_SECP224K1_ENABLED) || defined(PSA_WANT_ECC_SECP_K1_224)\0A#define MBEDTLS_ECP_HAVE_SECP224K1\0A#endif\0A#if defined(MBEDTLS_ECP_DP_SECP224R1_ENABLED) || defined(PSA_WANT_ECC_SECP_R1_224)\0A#define MBEDTLS_ECP_HAVE_SECP224R1\0A#endif\0A#if defined(MBEDTLS_ECP_DP_SECP192K1_ENABLED) || defined(PSA_WANT_ECC_SECP_K1_192)\0A#define MBEDTLS_ECP_HAVE_SECP192K1\0A#endif\0A#if defined(MBEDTLS_ECP_DP_SECP192R1_ENABLED) || defined(PSA_WANT_ECC_SECP_R1_192)\0A#define MBEDTLS_ECP_HAVE_SECP192R1\0A#endif\0A\0A/* Helper symbol to state that the PK module has support for EC keys. This\0A * can either be provided through the legacy ECP solution or through the\0A * PSA friendly MBEDTLS_PK_USE_PSA_EC_DATA (see pk.h for its description). */\0A#if defined(MBEDTLS_ECP_C) || \5C\0A    (defined(MBEDTLS_USE_PSA_CRYPTO) && defined(PSA_WANT_KEY_TYPE_ECC_PUBLIC_KEY))\0A#define MBEDTLS_PK_HAVE_ECC_KEYS\0A#endif /* MBEDTLS_PK_USE_PSA_EC_DATA || MBEDTLS_ECP_C */\0A\0A/* Historically pkparse did not check the CBC padding when decrypting\0A * a key. This was a bug, which is now fixed. As a consequence, pkparse\0A * now needs PKCS7 padding support, but existing configurations might not\0A * enable it, so we enable it here. */\0A#if defined(MBEDTLS_PK_PARSE_C) && defined(MBEDTLS_PKCS5_C) && defined(MBEDTLS_CIPHER_MODE_CBC)\0A#define MBEDTLS_CIPHER_PADDING_PKCS7\0A#endif\0A\0A/* Backwards compatibility for some macros which were renamed to reflect that\0A * they are related to Armv8, not aarch64. */\0A#if defined(MBEDTLS_SHA256_USE_A64_CRYPTO_IF_PRESENT) && \5C\0A    !defined(MBEDTLS_SHA256_USE_ARMV8_A_CRYPTO_IF_PRESENT)\0A#define MBEDTLS_SHA256_USE_ARMV8_A_CRYPTO_IF_PRESENT\0A#endif\0A#if defined(MBEDTLS_SHA256_USE_A64_CRYPTO_ONLY) && !defined(MBEDTLS_SHA256_USE_ARMV8_A_CRYPTO_ONLY)\0A#define MBEDTLS_SHA256_USE_ARMV8_A_CRYPTO_ONLY\0A#endif\0A\0A/* psa_util file features some ECDSA conversion functions, to convert between\0A * legacy's ASN.1 DER format and PSA's raw one. */\0A#if (defined(MBEDTLS_PSA_CRYPTO_CLIENT) && \5C\0A    (defined(PSA_WANT_ALG_ECDSA) || defined(PSA_WANT_ALG_DETERMINISTIC_ECDSA)))\0A#define MBEDTLS_PSA_UTIL_HAVE_ECDSA\0A#endif\0A\0A/* Some internal helpers to determine which keys are available. */\0A#if (!defined(MBEDTLS_USE_PSA_CRYPTO) && defined(MBEDTLS_AES_C)) || \5C\0A    (defined(MBEDTLS_USE_PSA_CRYPTO) && defined(PSA_WANT_KEY_TYPE_AES))\0A#define MBEDTLS_SSL_HAVE_AES\0A#endif\0A#if (!defined(MBEDTLS_USE_PSA_CRYPTO) && defined(MBEDTLS_ARIA_C)) || \5C\0A    (defined(MBEDTLS_USE_PSA_CRYPTO) && defined(PSA_WANT_KEY_TYPE_ARIA))\0A#define MBEDTLS_SSL_HAVE_ARIA\0A#endif\0A#if (!defined(MBEDTLS_USE_PSA_CRYPTO) && defined(MBEDTLS_CAMELLIA_C)) || \5C\0A    (defined(MBEDTLS_USE_PSA_CRYPTO) && defined(PSA_WANT_KEY_TYPE_CAMELLIA))\0A#define MBEDTLS_SSL_HAVE_CAMELLIA\0A#endif\0A\0A/* Some internal helpers to determine which operation modes are available. */\0A#if (!defined(MBEDTLS_USE_PSA_CRYPTO) && defined(MBEDTLS_CIPHER_MODE_CBC)) || \5C\0A    (defined(MBEDTLS_USE_PSA_CRYPTO) && defined(PSA_WANT_ALG_CBC_NO_PADDING))\0A#define MBEDTLS_SSL_HAVE_CBC\0A#endif\0A\0A#if (!defined(MBEDTLS_USE_PSA_CRYPTO) && defined(MBEDTLS_GCM_C)) || \5C\0A    (defined(MBEDTLS_USE_PSA_CRYPTO) && defined(PSA_WANT_ALG_GCM))\0A#define MBEDTLS_SSL_HAVE_GCM\0A#endif\0A\0A#if (!defined(MBEDTLS_USE_PSA_CRYPTO) && defined(MBEDTLS_CCM_C)) || \5C\0A    (defined(MBEDTLS_USE_PSA_CRYPTO) && defined(PSA_WANT_ALG_CCM))\0A#define MBEDTLS_SSL_HAVE_CCM\0A#endif\0A\0A#if (!defined(MBEDTLS_USE_PSA_CRYPTO) && defined(MBEDTLS_CHACHAPOLY_C)) || \5C\0A    (defined(MBEDTLS_USE_PSA_CRYPTO) && defined(PSA_WANT_ALG_CHACHA20_POLY1305))\0A#define MBEDTLS_SSL_HAVE_CHACHAPOLY\0A#endif\0A\0A#if defined(MBEDTLS_SSL_HAVE_GCM) || defined(MBEDTLS_SSL_HAVE_CCM) || \5C\0A    defined(MBEDTLS_SSL_HAVE_CHACHAPOLY)\0A#define MBEDTLS_SSL_HAVE_AEAD\0A#endif\0A\0A#endif /* MBEDTLS_CONFIG_ADJUST_LEGACY_CRYPTO_H */\0A\00" }
