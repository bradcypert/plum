 is not available\22 );\0A        case -(MBEDTLS_ERR_CIPHER_BAD_INPUT_DATA):\0A            return( \22CIPHER - Bad input parameters\22 );\0A        case -(MBEDTLS_ERR_CIPHER_ALLOC_FAILED):\0A            return( \22CIPHER - Failed to allocate memory\22 );\0A        case -(MBEDTLS_ERR_CIPHER_INVALID_PADDING):\0A            return( \22CIPHER - Input data contains invalid padding and is rejected\22 );\0A        case -(MBEDTLS_ERR_CIPHER_FULL_BLOCK_EXPECTED):\0A            return( \22CIPHER - Decryption of block requires a full block\22 );\0A        case -(MBEDTLS_ERR_CIPHER_AUTH_FAILED):\0A            return( \22CIPHER - Authentication failed (for AEAD modes)\22 );\0A        case -(MBEDTLS_ERR_CIPHER_INVALID_CONTEXT):\0A            return( \22CIPHER - The context is invalid. For example, because it was freed\22 );\0A#endif /* MBEDTLS_CIPHER_C */\0A\0A#if defined(MBEDTLS_DHM_C)\0A        case -(MBEDTLS_ERR_DHM_BAD_INPUT_DATA):\0A            return( \22DHM - Bad input parameters\22 );\0A        case -(MBEDTLS_ERR_DHM_READ_PARAMS_FAILED):\0A            return( \22DHM - Reading of the DHM parameters failed\22 );\0A        case -(MBEDTLS_ERR_DHM_MAKE_PARAMS_FAILED):\0A            return( \22DHM - Making of the DHM parameters failed\22 );\0A        case -(MBEDTLS_ERR_DHM_READ_PUBLIC_FAILED):\0A            return( \22DHM - Reading of the public values failed\22 );\0A        case -(MBEDTLS_ERR_DHM_MAKE_PUBLIC_FAILED):\0A            return( \22DHM - Making of the public value failed\22 );\0A        case -(MBEDTLS_ERR_DHM_CALC_SECRET_FAILED):\0A            return( \22DHM - Calculation of the DHM secret failed\22 );\0A        case -(MBEDTLS_ERR_DHM_INVALID_FORMAT):\0A            return( \22DHM - The ASN.1 data is not formatted correctly\22 );\0A        case -(MBEDTLS_ERR_DHM_ALLOC_FAILED):\0A            return( \22DHM - Allocation of memory failed\22 );\0A        case -(MBEDTLS_ERR_DHM_FILE_IO_ERROR):\0A            return( \22DHM - Read or write of file failed\22 );\0A        case