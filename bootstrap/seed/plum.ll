  const mbedtls_mpi *E, const mbedtls_mpi *N,\0A                        mbedtls_mpi *prec_RR)\0A{\0A    return mbedtls_mpi_exp_mod_optionally_safe(X, A, E, MBEDTLS_MPI_IS_SECRET, N, prec_RR);\0A}\0A\0Aint mbedtls_mpi_exp_mod_unsafe(mbedtls_mpi *X, const mbedtls_mpi *A,\0A                               const mbedtls_mpi *E, const mbedtls_mpi *N,\0A                               mbedtls_mpi *prec_RR)\0A{\0A    return mbedtls_mpi_exp_mod_optionally_safe(X, A, E, MBEDTLS_MPI_IS_PUBLIC, N, prec_RR);\0A}\0A\0A/*\0A * Greatest common divisor: G = gcd(A, B)  (HAC 14.54)\0A */\0Aint mbedtls_mpi_gcd(mbedtls_mpi *G, const mbedtls_mpi *A, const mbedtls_mpi *B)\0A{\0A    int ret = MBEDTLS_ERR_ERROR_CORRUPTION_DETECTED;\0A    size_t lz, lzt;\0A    mbedtls_mpi TA, TB;\0A\0A    mbedtls_mpi_init(&TA); mbedtls_mpi_init(&TB);\0A\0A    MBEDTLS_MPI_CHK(mbedtls_mpi_copy(&TA, A));\0A    MBEDTLS_MPI_CHK(mbedtls_mpi_copy(&TB, B));\0A\0A    lz = mbedtls_mpi_lsb(&TA);\0A    lzt = mbedtls_mpi_lsb(&TB);\0A\0A    /* The loop below gives the correct result when A==0 but not when B==0.\0A     * So have a special case for B==0. Leverage the fact that we just\0A     * calculated the lsb and lsb(B)==0 iff B is odd or 0 to make the test\0A     * slightly more efficient than cmp_int(). */\0A    if (lzt == 0 && mbedtls_mpi_get_bit(&TB, 0) == 0) {\0A        ret = mbedtls_mpi_copy(G, A);\0A        goto cleanup;\0A    }\0A\0A    if (lzt < lz) {\0A        lz = lzt;\0A    }\0A\0A    TA.s = TB.s = 1;\0A\0A    /* We mostly follow the procedure described in HAC 14.54, but with some\0A     * minor differences:\0A     * - Sequences of multiplications or divisions by 2 are grouped into a\0A     *   single shift operation.\0A     * - The procedure in HAC assumes that 0 < TB <= TA.\0A     *     - The condition TB <= TA is not actually necessary for correctness.\0A     *       TA and TB have symmetric roles except for the loop termination\0A     *       condition, and the shifts at the beginning of the loop body\0A     *       remove any significance from the ordering of TA vs TB before\0A     *       the shifts.\0A     *     - If TA = 0, the loop goes through 0 iterations and the result is\0A     *       correctly TB.\0A     *     - The case TB = 0 was short-circuited above.\0A     *\0A     * For the correctness proof below, decompose the original values of\0A     * A and B as\0A     *   A = sa * 2^a * A' with A'=0 or A' odd, and sa = +-1\0A     *   B = sb * 2^b * B' with B'=0 or B' odd, and sb = +-1\0A     * Then gcd(A, B) = 2^{min(a,b)} * gcd(A',B'),\0A     * and gcd(A',B') is odd or 0.\0A     *\0A     * At the beginning, we have TA = |A| and TB = |B| so gcd(A,B) = gcd(TA,TB).\0A     * The code maintains the following invariant:\0A     *     gcd(A,B) = 2^k * gcd(TA,TB) for some k   (I)\0A     */\0A\0A    /* Proof that the loop terminates:\0A     * At each iteration, either the right-shift by 1 is made on a nonzero\0A     * value and the nonnegative integer bitlen(TA) + bitlen(TB) decreases\0A     * by at least 1, or the right-shift by 1 is made on zero and then\0A     * TA becomes 0 which ends the loop (TB cannot be 0 if it is right-shifted\0A     * since in that case TB is calculated from TB-TA with the condition TB>TA).\0A     */\0A    while (mbedtls_mpi_cmp_int(&TA, 0) != 0) {\0A        /* Divisions by 2 preserve the invariant (I). */\0A        MBEDTLS_MPI_CHK(mbedtls_mpi_shift_r(&TA, mbedtls_mpi_lsb(&TA)));\0A        MBEDTLS_MPI_CHK(mbedtls_mpi_shift_r(&TB, mbedtls_mpi_lsb(&TB)));\0A\0A        /* Set either TA or TB to |TA-TB|/2. Since TA and TB are both odd,\0A         * TA-TB is even so the division by 2 has an integer result.\0A         * Invariant (I) is preserved since any odd divisor of both TA and TB\0A         * also divides |TA-TB|/2, and any odd divisor of both TA and |TA-TB|/2\0A         * also divides TB, and any odd divisor of both TB and |TA-TB|/2 also\0A         * divides TA.\0A         */\0A        if (mbedtls_mpi_cmp_mpi(&TA, &TB) >= 0) {\0A            MBEDTLS_MPI_CHK(mbedtls_mpi_sub_abs(&TA, &TA, &TB));\0A            MBEDTLS_MPI_CHK(mbedtls_mpi_shift_r(&TA, 1));\0A        } else {\0A            MBEDTLS_MPI_CHK(mbedtls_mpi_sub_abs(&TB, &TB, &TA));\0A            MBEDTLS_MPI_CHK(mbedtls_mpi_shift_r(&TB, 1));\0A        }\0A        /* Note that one of TA or TB is still odd. */\0A    }\0A\0A    /* By invariant (I), gcd(A,B) = 2^k * gcd(TA,TB) for some k.\0A     * At the loop exit, TA = 0, so gcd(TA,TB) = TB.\0A     * - If there was at least one loop iteration, then one of TA or TB is odd,\0A     *   and TA = 0, so TB is odd and gcd(TA,TB) = gcd(A',B'). In this case,\0A     *   lz = min(a,b) so gcd(A,B) = 2^lz * TB.\0A     * - If there was no loop iteration, then A was 0, and gcd(A,B) = B.\0A     *   In this case, lz = 0 and B = TB so gcd(A,B) = B = 2^lz * TB as well.\0A     */\0A\0A    MBEDTLS_MPI_CHK(mbedtls_mpi_shift_l(&TB, lz));\0A    MBEDTLS_MPI_CHK(mbedtls_mpi_copy(G, &TB));\0A\0Acleanup:\0A\0A    mbedtls_mpi_free(&TA); mbedtls_mpi_free(&TB);\0A\0A    return ret;\0A}\0A\0A/*\0A * Fill X with size bytes of random.\0A * The bytes returned from the RNG are used in a specific order which\0A * is suitable for deterministic ECDSA (see the specification of\0A * mbedtls_mpi_random() and the implementation in mbedtls_mpi_fill_random()).\0A */\0Aint mbedtls_mpi_fill_random(mbedtls_mpi *X, size_t size,\0A                            int (*f_rng)(void *, unsigned char *, size_t),\0A                            void *p_rng)\0A{\0A    int ret = MBEDTLS_ERR_ERROR_CORRUPTION_DETECTED;\0A    const size_t limbs = CHARS_TO_LIMBS(size);\0A\0A    /* Ensure that target MPI has exactly the necessary number of limbs */\0A    MBEDTLS_MPI_CHK(mbedtls_mpi_resize_clear(X, limbs));\0A    if (size == 0) {\0A        return 0;\0A    }\0A\0A    ret = mbedtls_mpi_core_fill_random(X->p, X->n, size, f_rng, p_rng);\0A\0Acleanup:\0A    return ret;\0A}\0A\0Aint mbedtls_mpi_random(mbedtls_mpi *X,\0A                       mbedtls_mpi_sint min,\0A                       const mbedtls_mpi *N,\0A                       int (*f_rng)(void *, unsigned char *, size_t),\0A                       void *p_rng)\0A{\0A    if (min < 0) {\0A        return MBEDTLS_ERR_MPI_BAD_INPUT_DATA;\0A    }\0A    if (mbedtls_mpi_cmp_int(N, min) <= 0) {\0A        return MBEDTLS_ERR_MPI_BAD_INPUT_DATA;\0A    }\0A\0A    /* Ensure that target MPI has exactly the same number of limbs\0A     * as the upper bound, even if the upper bound has leading zeros.\0A     * This is necessary for mbedtls_mpi_core_random. */\0A    int ret = mbedtls_mpi_resize_clear(X, N->n);\0A    if (ret != 0) {\0A        return ret;\0A    }\0A\0A    return mbedtls_mpi_core_random(X->p, min, N->p, X->n, f_rng, p_rng);\0A}\0A\0A/*\0A * Modular inverse: X = A^-1 mod N  (HAC 14.61 / 14.64)\0A */\0Aint mbedtls_mpi_inv_mod(mbedtls_mpi *X, const mbedtls_mpi *A, const mbedtls_mpi *N)\0A{\0A    int ret = MBEDTLS_ERR_ERROR_CORRUPTION_DETECTED;\0A    mbedtls_mpi G, TA, TU, U1, U2, TB, TV, V1, V2;\0A\0A    if (mbedtls_mpi_cmp_int(N, 1) <= 0) {\0A        return MBEDTLS_ERR_MPI_BAD_INPUT_DATA;\0A    }\0A\0A    mbedtls_mpi_init(&TA); mbedtls_mpi_init(&TU); mbedtls_mpi_init(&U1); mbedtls_mpi_init(&U2);\0A    mbedtls_mpi_init(&G); mbedtls_mpi_init(&TB); mbedtls_mpi_init(&TV);\0A    mbedtls_mpi_init(&V1); mbedtls_mpi_init(&V2);\0A\0A    MBEDTLS_MPI_CHK(mbedtls_mpi_gcd(&G, A, N));\0A\0A    if (mbedtls_mpi_cmp_int(&G, 1) != 0) {\0A        ret = MBEDTLS_ERR_MPI_NOT_ACCEPTABLE;\0A        goto cleanup;\0A    }\0A\0A    MBEDTLS_MPI_CHK(mbedtls_mpi_mod_mpi(&TA, A, N));\0A    MBEDTLS_MPI_CHK(mbedtls_mpi_copy(&TU, &TA));\0A    MBEDTLS_MPI_CHK(mbedtls_mpi_copy(&TB, N));\0A    MBEDTLS_MPI_CHK(mbedtls_mpi_copy(&TV, N));\0A\0A    MBEDTLS_MPI_CHK(mbedtls_mpi_lset(&U1, 1));\0A    MBEDTLS_MPI_CHK(mbedtls_mpi_lset(&U2, 0));\0A    MBEDTLS_MPI_CHK(mbedtls_mpi_lset(&V1, 0));\0A    MBEDTLS_MPI_CHK(mbedtls_mpi_lset(&V2, 1));\0A\0A    do {\0A        while ((TU.p[0] & 1) == 0) {\0A            MBEDTLS_MPI_CHK(mbedtls_mpi_