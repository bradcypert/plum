annot be combined\22)\0A        } else { Err(\22http: Transfer-Encoding (\22.concat(te).concat(\22) is not supported yet\22)) },\0A        None => http_content_lengths(headers, 0, -1),\0A    }\0A\0A// Whole-message APIs own Host/framing. Reject caller overrides before\0A// connecting rather than emitting a second, potentially conflicting field.\0Alet http_request_headers (headers: Array[Header]) (i: Int): Result[Unit, String] =\0A    if i >= headers.len() { Ok(()) }\0A    else if http_header_named(headers[i], \22Host\22) || http_header_named(headers[i], \22Content-Length\22)\0A        || http_header_named(headers[i], \22Transfer-Encoding\22) {\0A            Err(\22http client: Host, Content-Length and Transfer-Encoding are managed headers\22)\0A        } else { http_request_headers(headers, i + 1) }\0A\0A// Decode exactly the head, never the body. Byte offsets stay byte offsets\0A// even when a header contains multibyte UTF-8.\0Alet http_parse_head (raw: Bytes): Result[Head, String] =\0A    match http_head_separator(raw, 0) {\0A        None => Err(\22http client: incomplete response head\22),\0A        Some(i) => raw.slice(0, i).as_string() |> Result.and_then(_, |text| {\0A            let lines = text.split(\22\5Cr\5Cn\22);\0A            http_parse_status_line(lines[0]) |> Result.and_then(_, |status|\0A                Result.map(http_parse_headers(Array.drop(lines, 1)), |headers| Head {\0A                    status: status, headers: headers, leftover_body: raw.slice(i + 4, raw.len()),\0A                }))\0A        }),\0A    }\0A\0Alet http_recv_body_by_length_acc (fd: Int) (secure: Int) (acc: Bytes) (remaining: Int): Result[Bytes, String] =\0A    if remaining <= 0 { Ok(acc) }\0A    else { match http_read(fd, secure, Int.min(remaining, 16384)) {\0A        Err(e) => Err(e),\0A        Ok(chunk) => if chunk.is_empty() { Err(\22http client: connection closed before the full response body was received\22) }\0A            else { http_recv_body_by_length_acc(fd, secure, acc.concat(chunk), remaining - chunk.len()) },\0A    } }\0A\0Alet http_recv_body_until_close_acc (fd: Int) (secure: Int) (acc: Bytes): Result[Bytes, String] =\0A    match http_read(fd, secure, 4096) {\0A        Err(e) => Err(e),\0A        Ok(chunk) => if chunk.is_empty() { Ok(acc) }\0A            else { http_recv_body_until_close_acc(fd, secure, acc.concat(chunk)) },\0A    }\0A\0A// Ignore bytes beyond the selected message boundary. This server closes\0A// after one request; surplus bytes must never become handler body content.\0Alet http_read_fixed_body (fd: Int) (secure: Int) (length: Int) (pending: Bytes): Result[Bytes, String] =\0A    if length == 0 { Ok(Bytes.empty()) }\0A    else if pending.len() == length { Ok(pending) }\0A    else if pending.len() > length { Ok(pending.slice(0, length)) }\0A    else { http_recv_body_by_length_acc(fd, secure, pending, length - pending.len()) }\0A\0A// Method/status precedence comes before framing metadata (RFC 9112 6.3).\0Alet http_read_body (fd: Int) (secure: Int) (method: String) (status: Int) (headers: Array[Header]) (leftover_body: Bytes): Result[Bytes, String] =\0A    if http_response_bodyless(method, status) { Ok(Bytes.empty()) }\0A    else if http_tunnel(method, status) { Err(\22http client: CONNECT tunnels are not supported\22) }\0A    else { http_framing(headers) |> Result.and_then(_, |length|\0A        if length < 0 { http_recv_body_until_close_acc(fd, secure, leftover_body) }\0A        else { http_read_fixed_body(fd, secure, length, leftover_body) }) }\0A\0A// Requests without framing have zero content, even if another request or\0A// unsolicited bytes arrived in the same network read.\0Alet http_read_request_body (fd: Int) (headers: Array[Header]) (leftover_body: Bytes): Result[Bytes, String] =\0A    http_framing(headers) |> Result.and_then(_, |length|\0A        http_read_fixed_body(fd, 0, Int.max(0, length), leftover_body))\0A\0A// Carry only unread bytes to the next head. A direct tail call releases\0A// the prev