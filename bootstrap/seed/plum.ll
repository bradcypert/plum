ls_aes_xts_context ctx_xts;\0A\0A        mbedtls_aes_xts_init(&ctx_xts);\0A\0A        for (i = 0; i < num_tests << 1; i++) {\0A            const unsigned char *data_unit;\0A            u = i >> 1;\0A            mode = i & 1;\0A\0A            if (verbose != 0) {\0A                mbedtls_printf(\22  AES-XTS-128 (%s): \22,\0A                               (mode == MBEDTLS_AES_DECRYPT) ? \22dec\22 : \22enc\22);\0A            }\0A\0A            memset(key, 0, sizeof(key));\0A            memcpy(key, aes_test_xts_key[u], 32);\0A            data_unit = aes_test_xts_data_unit[u];\0A\0A            len = sizeof(*aes_test_xts_ct32);\0A\0A            if (mode == MBEDTLS_AES_DECRYPT) {\0A                ret = mbedtls_aes_xts_setkey_dec(&ctx_xts, key, 256);\0A                if (ret != 0) {\0A                    goto exit;\0A                }\0A                memcpy(buf, aes_test_xts_ct32[u], len);\0A                aes_tests = aes_test_xts_pt32[u];\0A            } else {\0A                ret = mbedtls_aes_xts_setkey_enc(&ctx_xts, key, 256);\0A                if (ret != 0) {\0A                    goto exit;\0A                }\0A                memcpy(buf, aes_test_xts_pt32[u], len);\0A                aes_tests = aes_test_xts_ct32[u];\0A            }\0A\0A\0A            ret = mbedtls_aes_crypt_xts(&ctx_xts, mode, len, data_unit,\0A                                        buf, buf);\0A            if (ret != 0) {\0A                goto exit;\0A            }\0A\0A            if (memcmp(buf, aes_tests, len) != 0) {\0A                ret = 1;\0A                goto exit;\0A            }\0A\0A            if (verbose != 0) {\0A                mbedtls_printf(\22passed\5Cn\22);\0A            }\0A        }\0A\0A        if (verbose != 0) {\0A            mbedtls_printf(\22\5Cn\22);\0A        }\0A\0A        mbedtls_aes_xts_free(&ctx_xts);\0A    }\0A#endif /* MBEDTLS_CIPHER_MODE_XTS */\0A\0A    ret = 0;\0A\0Aexit:\0A    if (ret != 0 && verbose != 0) {\0A        mbedtls_printf(\22failed\5Cn\22