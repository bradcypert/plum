0A// the same way.\0Aextern \22C\22 {\0A    fn os_stat_load(path: CStr) -> Int;\0A    fn os_stat_size() -> Int;\0A    fn os_stat_mtime() -> Int;\0A    fn os_stat_is_dir() -> Int;\0A    fn os_path_exists(path: CStr) -> Int;\0A}\0A\0A/// No `exists` field: a path that is not there is an `Err`, so a\0A/// `Metadata` in hand always describes something real. That is the\0A/// contract `is_directory` already set, and having one of these\0A/// answer `exists: false` while the other errored would be two\0A/// answers to one question.\0Apub struct Metadata { pub is_directory: Bool, pub size: Int, pub mtime: Int }\0A\0A/// Three-way underneath, and the third case is why this returns a\0A/// `Result` rather than a `Bool`: \22does this exist\22 and \22can I see\0A/// whether this exists\22 are different questions. A permission error\0A/// is an `Err`, not a silent `Ok(false)`.\0A///\0A/// This is the ONE function here where a missing path is `Ok`, and\0A/// deliberately so; it is the function whose whole job is to say\0A/// so.\0Apub let exists (path: String): Result[Bool, String] = unsafe {\0A    let r = os_path_exists(path.as_cstr());\0A    if r < 0 { Err(\22Os.exists: cannot determine whether \22.concat(path).concat(\22 exists\22)) }\0A    else { Ok(r == 1) }\0A}\0A\0A/// A missing path is an `Err`, matching `is_directory`.\0Apub let stat (path: String): Result[Metadata, String] = unsafe {\0A    if os_stat_load(path.as_cstr()) != 0 { Err(\22Os.stat: cannot stat \22.concat(path)) }\0A    else { Ok(Metadata { is_directory: os_stat_is_dir() == 1, size: os_stat_size(), mtime: os_stat_mtime() }) }\0A}\0A\0A/// Bytes. Meaningful for a regular file; for a directory it is\0A/// whatever the filesystem records for the directory itself, which\0A/// is not the size of its contents.\0Apub let file_size (path: String): Result[Int, String] = Result.map(stat(path), |m| m.size)\0A\0A/// Seconds since the Unix epoch, the same unit as `Time.now()`, so\0A/// the two can be compared without a conversion.\0Apub let mtime (path: String): Result[Int, String] = Result.map(stat(path), |m| m.mtime)\0A\0A// --- Directory access ---\0A//\0A// `is_directory`'s three-way result is deliberate: a path that does\0A// not exist is a real `Err`, not silently `Ok(false)`.\0A\0Alet path_is_dir_raw (path: String): Int = 0\0Aextern \22C\22 {\0A    fn dir_open(path: CStr) -> Int;\0A    fn dir_next_size(handle: Int) -> Int;\0A    fn dir_entry_data(handle: Int) -> CStr;\0A    fn dir_close(handle: Int) -> Unit;\0A}\0A\0Alet dir_read_all_acc (handle: Int) (builder: Ref[Array[String]]): Result[Array[String], String] = unsafe {\0A    let n = dir_next_size(handle);\0A    if n < 0 { Err(\22directory read failed\22) }\0A    else if n == 0 { Ok(builder.get()) }\0A    else {\0A        // Copy while the stream still owns this entry, then validate without\0A        // another copy. No unchecked OS bytes enter a Plum String.\0A        match Bytes.from_cstr(dir_entry_data(handle), n).as_string() {\0A            Err(_) => Err(\22directory entry is not valid UTF-8\22),\0A            Ok(name) => {\0A                // Keep the array unique during growth, including across the\0A                // match and recursive call's owning parameter slots.\0A                let mut names = builder.get();\0A                builder.set([]);\0A                names = names.push(name);\0A                builder.set(names);\0A                dir_read_all_acc(handle, builder)\0A            },\0A        }\0A    }\0A}\0A\0A/// Lists a directory's entries by NAME, without `.` or `..`, in\0A/// whatever order the filesystem gives.\0A///\0A/// Names, not paths: join them onto the directory with `Path.join` to\0A/// get something you can open. Returns `Err` if opening or reading fails,\0A/// or an entry name is not valid UTF-8; never returns a partial listing.\0A/// Native entry storage is released before returning, including on errors.\0Apub let list_dir (path: String): Result[Array[String], String] = unsafe {\0A 