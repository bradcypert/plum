r to collect %u bytes before re-opening\22,\0A                                  (unsigned) rd->pending);\0A            }\0A            MBEDTLS_MPS_TRACE_RETURN(MBEDTLS_ERR_MPS_READER_OUT_OF_DATA);\0A        }\0A\0A        desired = frag_remaining;\0A    }\0A\0A    /* There's enough data in the current fragment to serve the\0A     * (potentially modified) read request. */\0A\0A    frag = rd->frag;\0A    frag += frag_fetched;\0A\0A    *buffer = frag;\0A    if (buflen != NULL) {\0A        *buflen = desired;\0A    }\0A\0A    end += desired;\0A    rd->end = end;\0A    rd->pending = 0;\0A    MBEDTLS_MPS_TRACE_RETURN(0);\0A}\0A\0Aint mbedtls_mps_reader_commit(mbedtls_mps_reader *rd)\0A{\0A    mbedtls_mps_size_t end;\0A    MBEDTLS_MPS_TRACE_INIT(\22mbedtls_mps_reader_commit\22);\0A    MBEDTLS_MPS_STATE_VALIDATE_RAW(mps_reader_is_consuming(\0A                                       rd),\0A                                   \22mbedtls_mps_reader_commit() requires reader to be in consuming mode\22);\0A\0A    end = rd->end;\0A    rd->commit = end;\0A\0A    MBEDTLS_MPS_TRACE_RETURN(0);\0A}\0A\0Aint mbedtls_mps_reader_reclaim(mbedtls_mps_reader *rd,\0A                               int *paused)\0A{\0A    unsigned char *frag, *acc;\0A    mbedtls_mps_size_t pending, commit;\0A    mbedtls_mps_size_t acc_len, frag_offset, frag_len;\0A    MBEDTLS_MPS_TRACE_INIT(\22mbedtls_mps_reader_reclaim\22);\0A\0A    if (paused != NULL) {\0A        *paused = 0;\0A    }\0A\0A    MBEDTLS_MPS_STATE_VALIDATE_RAW(mps_reader_is_consuming(\0A                                       rd),\0A                                   \22mbedtls_mps_reader_reclaim() requires reader to be in consuming mode\22);\0A\0A    frag     = rd->frag;\0A    acc      = rd->acc;\0A    pending  = rd->pending;\0A    commit   = rd->commit;\0A    frag_len = rd->frag_len;\0A\0A    frag_offset = mps_reader_get_fragment_offset(rd);\0A\0A    if (pending == 0) {\0A        MBEDTLS_MPS_TRACE(MBEDTLS_MPS_TRACE_TYPE_COMMENT,\0A                          \22No unsatisfied read-request has been logged.\22);\0A\0A        /* Check if there's data left to be consumed. */\0A        if (commit < frag_offset || commit - frag_offset < frag_len) {\0A            MBEDTLS_MPS_TRACE(MBEDTLS_MPS_TRACE_TYPE_COMMENT,\0A                              \22There is data left to be consumed.\22);\0A            rd->end = commit;\0A            MBEDTLS_MPS_TRACE_RETURN(MBEDTLS_ERR_MPS_READER_DATA_LEFT);\0A        }\0A\0A        rd->acc_available = 0;\0A        rd->acc_share.acc_remaining = 0;\0A\0A        MBEDTLS_MPS_TRACE(MBEDTLS_MPS_TRACE_TYPE_COMMENT,\0A                          \22Fragment has been fully processed and committed.\22);\0A    } else {\0A        int overflow;\0A\0A        mbedtls_mps_size_t acc_backup_offset;\0A        mbedtls_mps_size_t acc_backup_len;\0A        mbedtls_mps_size_t frag_backup_offset;\0A        mbedtls_mps_size_t frag_backup_len;\0A\0A        mbedtls_mps_size_t backup_len;\0A        mbedtls_mps_size_t acc_len_needed;\0A\0A        MBEDTLS_MPS_TRACE(MBEDTLS_MPS_TRACE_TYPE_COMMENT,\0A                          \22There has been an unsatisfied read with %u bytes overhead.\22,\0A                          (unsigned) pending);\0A\0A        if (acc == NULL) {\0A            MBEDTLS_MPS_TRACE(MBEDTLS_MPS_TRACE_TYPE_COMMENT,\0A                              \22No accumulator present\22);\0A            MBEDTLS_MPS_TRACE_RETURN(\0A                MBEDTLS_ERR_MPS_READER_NEED_ACCUMULATOR);\0A        }\0A        acc_len = rd->acc_len;\0A\0A        /* Check if the upper layer has already fetched\0A         * and committed the contents of the accumulator. */\0A        if (commit < frag_offset) {\0A            /* No, accumulator is still being processed. */\0A            frag_backup_offset = 0;\0A            frag_backup_len = frag_len;\0A            acc_backup_offset = commit;\0A            acc_backup_len = frag_offset - commit;\0A        } else {\0A            /* Yes, the accumulator is already processed. */\0A            frag_backup_offset = commit - frag_offset;\0A            frag_backup_len = frag_len - frag_backup_offset;\0A            acc_backup_offset = 0;\0A            acc_backup_len = 0;\0A        }\0A\0A        backup_len = acc_backup_len + frag_backup_len;\0A        acc_len_needed = backup_len + pending;\0A\0A        overflow  = 0;\0A        overflow |= (backup_len     < acc_backup_len);\0A        overflow |= (acc_len_needed < backup_len);\0A\0A        if (overflow || acc_len < acc_len_needed) {\0A            /* Except for the different return code, we behave as if\0A             * there hadn't been a call to mbedtls_mps_reader_get()\0A             * since the last commit. */\0A            rd->end = commit;\0A            rd->pending = 0;\0A            MBEDTLS_MPS_TRACE(MBEDTLS_MPS_TRACE_TYPE_ERROR,\0A                              \22The accumulator is too small to handle the backup.\22);\0A            MBEDTLS_MPS_TRACE(MBEDTLS_MPS_TRACE_TYPE_ERROR,\0A                              \22* Size: %u\22, (unsigned) acc_len);\0A            MBEDTLS_MPS_TRACE(MBEDTLS_MPS_TRACE_TYPE_ERROR,\0A                              \22* Needed: %u (%u + %u)\22,\0A                              (unsigned) acc_len_needed,\0A                              (unsigned) backup_len, (unsigned) pending);\0A            MBEDTLS_MPS_TRACE_RETURN(\0A                MBEDTLS_ERR_MPS_READER_ACCUMULATOR_TOO_SMALL);\0A        }\0A\0A        MBEDTLS_MPS_TRACE(MBEDTLS_MPS_TRACE_TYPE_COMMENT,\0A                          \22Fragment backup: %u\22, (unsigned) frag_backup_len);\0A        MBEDTLS_MPS_TRACE(MBEDTLS_MPS_TRACE_TYPE_COMMENT,\0A                          \22Accumulator backup: %u\22, (unsigned) acc_backup_len);\0A\0A        /* Move uncommitted parts from the accumulator to the front\0A         * of the accumulator. */\0A        memmove(acc, acc + acc_backup_offset, acc_backup_len);\0A\0A        /* Copy uncommitted parts of the current fragment to the\0A         * accumulator. */\0A        memcpy(acc + acc_backup_len,\0A               frag + frag_backup_offset, frag_backup_len);\0A\0A        rd->acc_available = backup_len;\0A        rd->acc_share.acc_remaining = pending;\0A\0A        if (paused != NULL) {\0A            *paused = 1;\0A        }\0A    }\0A\0A    rd->frag     = NULL;\0A    rd->frag_len = 0;\0A\0A    rd->commit  = 0;\0A    rd->end     = 0;\0A    rd->pending = 0;\0A\0A    MBEDTLS_MPS_TRACE(MBEDTLS_MPS_TRACE_TYPE_COMMENT,\0A                      \22Final state: aa %u, al %u, ar %u\22,\0A                      (unsigned) rd->acc_available, (unsigned) rd->acc_len,\0A                      (unsigned) rd->acc_share.acc_remaining);\0A    MBEDTLS_MPS_TRACE_RETURN(0);\0A}\0A\0A#endif /* MBEDTLS_SSL_PROTO_TLS1_3 */\0A\00" }
