D_IN_LEN_MAX too large (max 255)\22\0A#endif\0A\0A#if defined(MBEDTLS_SSL_DTLS_CONNECTION_ID)            &&                  \5C\0A    defined(MBEDTLS_SSL_CID_OUT_LEN_MAX) &&                 \5C\0A    MBEDTLS_SSL_CID_OUT_LEN_MAX > 255\0A#error \22MBEDTLS_SSL_CID_OUT_LEN_MAX too large (max 255)\22\0A#endif\0A\0A#if defined(MBEDTLS_SSL_DTLS_CONNECTION_ID_COMPAT)     &&                 \5C\0A    !defined(MBEDTLS_SSL_DTLS_CONNECTION_ID)\0A#error \22MBEDTLS_SSL_DTLS_CONNECTION_ID_COMPAT defined, but not all prerequisites\22\0A#endif\0A\0A#if defined(MBEDTLS_SSL_DTLS_CONNECTION_ID_COMPAT) && MBEDTLS_SSL_DTLS_CONNECTION_ID_COMPAT != 0\0A#if defined(MBEDTLS_DEPRECATED_REMOVED)\0A#error \22MBEDTLS_SSL_DTLS_CONNECTION_ID_COMPAT is deprecated and will be removed in a future version of Mbed TLS\22\0A#elif defined(MBEDTLS_DEPRECATED_WARNING)\0A#warning \22MBEDTLS_SSL_DTLS_CONNECTION_ID_COMPAT is deprecated and will be removed in a future version of Mbed TLS\22\0A#endif\0A#endif /* MBEDTLS_SSL_DTLS_CONNECTION_ID_COMPAT && MBEDTLS_SSL_DTLS_CONNECTION_ID_COMPAT != 0 */\0A\0A#if defined(MBEDTLS_SSL_ENCRYPT_THEN_MAC) &&   \5C\0A    !defined(MBEDTLS_SSL_PROTO_TLS1_2)\0A#error \22MBEDTLS_SSL_ENCRYPT_THEN_MAC defined, but not all prerequisites\22\0A#endif\0A\0A#if defined(MBEDTLS_SSL_EXTENDED_MASTER_SECRET) && \5C\0A    !defined(MBEDTLS_SSL_PROTO_TLS1_2)\0A#error \22MBEDTLS_SSL_EXTENDED_MASTER_SECRET defined, but not all prerequisites\22\0A#endif\0A\0A#if defined(MBEDTLS_SSL_RENEGOTIATION) && \5C\0A    !defined(MBEDTLS_SSL_PROTO_TLS1_2)\0A#error \22MBEDTLS_SSL_RENEGOTIATION defined, but not all prerequisites\22\0A#endif\0A\0A#if defined(MBEDTLS_SSL_TICKET_C) && ( !defined(MBEDTLS_CIPHER_C) && \5C\0A                                       !defined(MBEDTLS_USE_PSA_CRYPTO) )\0A#error \22MBEDTLS_SSL_TICKET_C defined, but not all prerequisites\22\0A#endif\0A\0A#if defined(MBEDTLS_SSL_TICKET_C) && \5C\0A    !( defined(MBEDTLS_SSL_HAVE_CCM) || defined(MBEDTLS_SSL_HAVE_GCM) || \5C\0A    defined(