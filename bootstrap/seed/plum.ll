@.str44995 = private global { i64, i64, [10682 x i8] } { i64 -1, i64 10681, [10682 x i8] c"// Streaming file I/O, behind Plum's `handle` type (issues #16 and #9).\0A//\0A// Same ABI conventions as its neighbours (see `net_shim.c`'s header for\0A// the general pattern): every function takes and returns only\0A// `long long` (Plum `Int`) or `const char *` (Plum `CStr`), because\0A// Plum's extern surface has no raw pointers, no out-parameters and no\0A// multi-value return.\0A//\0A// --- Why a SLOT TABLE and not a cast pointer ---\0A//\0A// `dir_shim.c` casts its `DIR *` straight to a handle, which is simpler\0A// and is fine there because a directory is closed exactly once, by the\0A// one function that reads it to the end.\0A//\0A// A file cannot do that, because closing one happens TWICE by design.\0A// `File.close` is explicit and returns a `Result`, so a caller who cares\0A// whether the final flush succeeded can see it; and the handle's\0A// `on_drop` closes it again on the way out, so a caller who forgets --\0A// or who returns early -- still cannot leak it. That pairing is Rust's\0A// `File`, and it is the shape issue #16 sketched.\0A//\0A// Rust makes the second close impossible: `close` CONSUMES the value.\0A// Plum has no move semantics, so both really do run, and the second one\0A// must be harmless. A cast pointer cannot be: `fclose` on an\0A// already-closed `FILE *` is undefined, and the fd number underneath may\0A// by then belong to a completely different file.\0A//\0A// Each opening gets a positive identity: slot index plus a generation.\0A// Reusing storage never reuses an identity. At Int exhaustion the slot\0A// is retired rather than wrapping to an identity a stale value may hold.\0A// Closed handles need no heap record or tombstone: the slot remembers\0A// only its last identity, so memory stays bounded across repeated opens.\0A//\0A// Each slot has a mutex covering identity checks AND the entire stdio\0A// operation, including fclose. Locking just lookup would leave a FILE *\0A// vulnerable to concurrent close. Separate slots can perform I/O in\0A// parallel; allocation skips reserved slots without waiting on their\0A// I/O locks. Concurrent operations on one file are serialized. The read\0A// buffer remains thread-local, independent of the slot's lifetime.\0A\0A#if defined(__APPLE__)\0A#define _DARWIN_C_SOURCE 1\0A#endif\0A#if !defined(_WIN32)\0A#ifndef _FILE_OFFSET_BITS\0A#define _FILE_OFFSET_BITS 64\0A#endif\0A#ifndef _POSIX_C_SOURCE\0A#define _POSIX_C_SOURCE 200809L\0A#endif\0A#endif\0A\0A#include <limits.h>\0A#include <pthread.h>\0A#include <stdint.h>\0A#include <stdio.h>\0A#include \22path_shim.h\22\0A#include <stdlib.h>\0A#include <string.h>\0A#if !defined(_WIN32)\0A#include <sys/types.h>\0A// Fail at build time if the toolchain disables large-file support.\0A_Static_assert(sizeof(off_t) >= sizeof(long long), \22File.seek requires 64-bit off_t\22);\0A#endif\0A\0A#if defined(_MSC_VER)\0A#define PLUM_TLS __declspec(thread)\0A#else\0A#define PLUM_TLS _Thread_local\0A#endif\0A\0A#define PLUM_MAX_FILES 256\0A\0Atypedef struct {\0A    pthread_mutex_t lock;\0A    FILE *stream;\0A    long long identity;\0A    int reserved; // Protected by slots_allocator, not the I/O lock.\0A} PlumFileSlot;\0A\0Astatic PlumFileSlot slots[PLUM_MAX_FILES];\0A// Allocation never holds this mutex while waiting on I/O or a slot lock.\0Astatic pthread_mutex_t slots_allocator = PTHREAD_MUTEX_INITIALIZER;\0Astatic pthread_once_t slots_once = PTHREAD_ONCE_INIT;\0Astatic int slots_ready;\0A\0Astatic void slots_init(void) {\0A    for (int i = 0; i < PLUM_MAX_FILES; i++) {\0A        if (pthread_mutex_init(&slots[i].lock, NULL) != 0) {\0A            while (i > 0) pthread_mutex_destroy(&slots[--i].lock);\0A            return;\0A        }\0A    }\0A    slots_ready = 1;\0A}\0A\0A// Returns a locked live slot, or NULL. No caller may keep its FILE *\0A// after unlocking. Positive identities encode (identity - 1) % 256.\0Astatic PlumFileSlot *slot_lock(long long h) {\0A    if (h <= 0) return NULL;\0A    pthread_once(&slots_once, slots_init);\0A    if (!slots_ready) return NULL;\0A    PlumFileSlot *slot = &slots[(h - 1) % PLUM_MAX_FILES];\0A    pthread_mutex_lock(&slot->lock);\0A    if (slot->stream == NULL || slot->identity != h) {\0A        pthread_mutex_unlock(&slot->lock);\0A        return NULL;\0A    }\0A    return slot;\0A}\0A\0A// Publish a closed/failed slot for reuse. Called with its I/O lock held.\0Astatic void slot_make_available(PlumFileSlot *slot) {\0A    pthread_mutex_lock(&slots_allocator);\0A    slot->reserved = 0;\0A    pthread_mutex_unlock(&slots_allocator);\0A}\0A\0A// Modes are passed as small integers rather than strings: an extern\0A// taking a `CStr` would mean the caller could hand `fopen` anything at\0A// all, and the set Plum offers is closed. 0 read, 1 write, 2 append.\0A//\0A// All three are BINARY (`b`), which is a no-op on POSIX and load-bearing\0A// on Windows, where a text-mode stream rewrites `\5Cn` on the way through\0A// and would corrupt exactly the payloads `Bytes` exists for.\0Along long file_open(const char *path, long long mode) {\0A    const char *m = mode == 0 ? \22rb\22 : mode == 1 ? \22wb\22 : mode == 2 ? \22ab\22 : NULL;\0A    if (m == NULL) return -1;\0A    pthread_once(&slots_once, slots_init);\0A    if (!slots_ready) return -1;\0A    for (int i = 0; i < PLUM_MAX_FILES; i++) {\0A        PlumFileSlot *slot = &slots[i];\0A        pthread_mutex_lock(&slots_allocator);\0A        int available = !slot->reserved;\0A        if (available) slot->reserved = 1;\0A        pthread_mutex_unlock(&slots_allocator);\0A        if (!available) continue;\0A        pthread_mutex_lock(&slot->lock);\0A        if (slot->identity > LLONG_MAX - PLUM_MAX_FILES) {\0A            // Keep an exhausted slot reserved permanently.\0A            pthread_mutex_unlock(&slot->lock);\0A            continue;\0A        }\0A        FILE *f = plum_path_fopen(path, m);\0A        long long h = -1;\0A        if (f != NULL) {\0A            slot->identity = slot->identity == 0 ? i + 1 : slot->identity + PLUM_MAX_FILES;\0A            slot->stream = f;\0A            h = slot->identity;\0A        } else slot_make_available(slot);\0A        pthread_mutex_unlock(&slot->lock);\0A        return h;\0A    }\0A    return -1;\0A}\0A\0A// 0 on success, -1 on a real error. Closing an already-closed handle is\0A// SUCCESS, not an error: the guard runs after an explicit close on every\0A// well-written program, and reporting that as a failure would make the\0A// safe pattern the noisy one.\0Along long file_close_checked(long long h) {\0A    PlumFileSlot *slot = slot_lock(h);\0A    if (slot == NULL) return 0;\0A    FILE *f = slot->stream;\0A    slot->stream = NULL;\0A    long long result = fclose(f) == 0 ? 0 : -1;\0A    slot_make_available(slot);\0A    pthread_mutex_unlock(&slot->lock);\0A    return result;\0A}\0A\0A// The `on_drop` hook. A release runs while a value is being freed and\0A// has nowhere to report to, so the result is discarded here -- which is\0A// exactly why `file_close_checked` exists alongside it.\0Avoid file_close(long long h) {\0A    file_close_checked(h);\0A}\0A\0A// --- Reading ---\0A//\0A// Split across two calls for the same reason `tcp_recv_n`/\0A// `tcp_recv_data` are: a `CStr` return cannot carry a length, so a\0A// single-call read would have to NUL-terminate and the caller would have\0A// to `strlen` -- which truncates any file containing a zero byte, i.e.\0A// every file this API exists to read.\0A//\0A// Three outcomes, kept apart:\0A//   > 0   that many bytes are in the buffer\0A//   = 0   end of file\0A//   < 0   a read error\0Astatic PLUM_TLS char *read_buf = NULL;\0Astatic PLUM_TLS size_t read_cap = 0;\0A\0Astatic int read_ensure(size_t need) {\0A    if (read_cap >= need) return 1;\0A    size_t next = read_cap ? read_cap : 4096;\0A    while (next < need) {\0A        if (next > SIZE_MAX / 2) { next = need; break; }\0A        next *= 2;\0A    }\0A    char *bigger = (char *)realloc(read_buf, next);\0A    if (bigger == NULL) return 0;\0A    read_buf = bigger;\0A    read_cap = next;\0A    return 1;\0A}\0A\0Along long file_read_n(long long h, long long max_len) {\0A    // Only a positive request can report zero bytes as end of file.\0A    if (max_len <= 0 || (uintmax_t)max_len >= SIZE_MAX) return -1;\0A    PlumFileSlot *slot = slot_lock(h);\0A    if (slot == NULL) return -1;\0A    long long result = -1;\0A    if (read_ensure((size_t)max_len + 1)) {\0A        size_t got = fread(read_buf, 1, (size_t)max_len, slot->stream);\0A        if (got != 0 || !ferror(slot->stream)) {\0A            read_buf[got] = '\5C0';\0A            result = (long long)got;\0A        }\0A    }\0A    pthread_mutex_unlock(&slot->lock);\0A    return result;\0A}\0A\0A// The bytes `file_read_n` just read. Valid until the next read on this\0A// thread, and meaningful only with the count that call returned -- the\0A// buffer is not NUL-delimited data, and reading it with `strlen` is the\0A// bug this pair exists to avoid.\0Aconst char *file_read_data(void) {\0A    return read_buf ? read_buf : \22\22;\0A}\0A\0A// Bytes written, or -1. A short write is possible under real POSIX\0A// semantics and is NOT retried here; the Plum wrapper reports the count\0A// and lets the caller decide, matching `tcp_send`'s own scope note.\0Along long file_write(long long h, const char *buf, long long len) {\0A    if (len < 0 || (uintmax_t)len > SIZE_MAX) return -1;\0A    PlumFileSlot *slot = slot_lock(h);\0A    if (slot == NULL) return -1;\0A    size_t wrote = fwrite(buf, 1, (size_t)len, slot->stream);\0A    pthread_mutex_unlock(&slot->lock);\0A    return (long long)wrote;\0A}\0A\0A// The new absolute position, or -1. `whence` is 0 start, 1 current,\0A// 2 end -- the same order `SEEK_SET`/`SEEK_CUR`/`SEEK_END` are usually\0A// written in, but passed as Plum's own constants rather than assuming\0A// the C macros have those values on every platform.\0Astatic long long file_seek_locked(FILE *stream, long long offset, long long whence) {\0A    int w = whence == 0 ? SEEK_SET : whence == 1 ? SEEK_CUR : whence == 2 ? SEEK_END : -1;\0A    if (w == -1) return -1;\0A#if defined(_WIN32)\0A    if (_fseeki64(stream, offset, w) != 0) return -1;\0A    __int64 position = _ftelli64(stream);\0A#else\0A    if (fseeko(stream, (off_t)offset, w) != 0) return -1;\0A    off_t position = ftello(stream);\0A#endif\0A    // Preserve tell failures and reject positions outside Plum Int's range\0A    // before narrowing, including on platforms with a wider off_t.\0A    if (position < 0 || (uintmax_t)position > (uintmax_t)LLONG_MAX) return -1;\0A    return (long long)position;\0A}\0A\0Along long file_seek(long long h, long long offset, long long whence) {\0A    PlumFileSlot *slot = slot_lock(h);\0A    if (slot == NULL) return -1;\0A    long long result = file_seek_locked(slot->stream, offset, whence);\0A    pthread_mutex_unlock(&slot->lock);\0A    return result;\0A}\0A\0A// Flushes buffered writes without closing, so a caller can make data\0A// visible to another process and keep the handle.\0Along long file_flush(long long h) {\0A    PlumFileSlot *slot = slot_lock(h);\0A    if (slot == NULL) return -1;\0A    long long result = fflush(slot->stream) == 0 ? 0 : -1;\0A    pthread_mutex_unlock(&slot->lock);\0A    return result;\0A}\0A\00" }
