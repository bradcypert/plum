in_path[0] = '\5C0';\0A    if (stdin_mode == 0) {\0A        in_fd = open(\22/dev/null\22, O_RDONLY);\0A        if (in_fd < 0) {\0A            close(out_fd); close(err_fd);\0A            unlink(out_path); unlink(err_path);\0A            return PLUM_SPAWN_FAILED;\0A        }\0A    } else if (stdin_mode > 0) {\0A        if (snprintf(in_path, PLUM_PROC_PATH_MAX, \22%s/plum_proc_in_XXXXXX\22, tmp) >= PLUM_PROC_PATH_MAX) {\0A            close(out_fd); close(err_fd);\0A            unlink(out_path); unlink(err_path);\0A            return PLUM_SPAWN_FAILED;\0A        }\0A        in_fd = mkstemp(in_path);\0A        if (in_fd < 0) {\0A            close(out_fd); close(err_fd);\0A            unlink(out_path); unlink(err_path);\0A            return PLUM_SPAWN_FAILED;\0A        }\0A        long long left = stdin_len;\0A        const char *p = stdin_data != NULL ? stdin_data : \22\22;\0A        while (left > 0) {\0A            ssize_t w = write(in_fd, p, (size_t)left);\0A            if (w <= 0) {\0A                close(in_fd); close(out_fd); close(err_fd);\0A                unlink(in_path); unlink(out_path); unlink(err_path);\0A                return PLUM_SPAWN_FAILED;\0A            }\0A            p += w;\0A            left -= w;\0A        }\0A        if (lseek(in_fd, 0, SEEK_SET) < 0) {\0A            close(in_fd); close(out_fd); close(err_fd);\0A            unlink(in_path); unlink(out_path); unlink(err_path);\0A            return PLUM_SPAWN_FAILED;\0A        }\0A    }\0A\0A    int errpipe[2] = {-1, -1};\0A    if (fail_on_exec) {\0A        if (pipe(errpipe) != 0) {\0A            if (in_fd >= 0) close(in_fd);\0A            if (in_path[0] != '\5C0') unlink(in_path);\0A            close(out_fd); close(err_fd);\0A            unlink(out_path); unlink(err_path);\0A            return PLUM_SPAWN_FAILED;\0A        }\0A        fcntl(errpipe[1], F_SETFD, FD_CLOEXEC);\0A    }\0A\0A    pid_t pid = fork();\0A    if (pid < 0) {\0A        if (in_fd >= 0) close(in_fd);\0A        if (in_path[0] !=