@.str45524 = private global { i64, i64, [2248 x i8] } { i64 -1, i64 2247, [2248 x i8] c"/**\0A * \5Cfile bignum_internal.h\0A *\0A * \5Cbrief Internal-only bignum public-key cryptosystem API.\0A *\0A * This file declares bignum-related functions that are to be used\0A * only from within the Mbed TLS library itself.\0A *\0A */\0A/*\0A *  Copyright The Mbed TLS Contributors\0A *  SPDX-License-Identifier: Apache-2.0 OR GPL-2.0-or-later\0A */\0A#ifndef MBEDTLS_BIGNUM_INTERNAL_H\0A#define MBEDTLS_BIGNUM_INTERNAL_H\0A\0A/**\0A * \5Cbrief          Perform a modular exponentiation: X = A^E mod N\0A *\0A * \5Cwarning        This function is not constant time with respect to \5Cp E (the exponent).\0A *\0A * \5Cparam X        The destination MPI. This must point to an initialized MPI.\0A *                 This must not alias E or N.\0A * \5Cparam A        The base of the exponentiation.\0A *                 This must point to an initialized MPI.\0A * \5Cparam E        The exponent MPI. This must point to an initialized MPI.\0A * \5Cparam N        The base for the modular reduction. This must point to an\0A *                 initialized MPI.\0A * \5Cparam prec_RR  A helper MPI depending solely on \5Cp N which can be used to\0A *                 speed-up multiple modular exponentiations for the same value\0A *                 of \5Cp N. This may be \5Cc NULL. If it is not \5Cc NULL, it must\0A *                 point to an initialized MPI. If it hasn't been used after\0A *                 the call to mbedtls_mpi_init(), this function will compute\0A *                 the helper value and store it in \5Cp prec_RR for reuse on\0A *                 subsequent calls to this function. Otherwise, the function\0A *                 will assume that \5Cp prec_RR holds the helper value set by a\0A *                 previous call to mbedtls_mpi_exp_mod(), and reuse it.\0A *\0A * \5Creturn         \5Cc 0 if successful.\0A * \5Creturn         #MBEDTLS_ERR_MPI_ALLOC_FAILED if a memory allocation failed.\0A * \5Creturn         #MBEDTLS_ERR_MPI_BAD_INPUT_DATA if \5Cc N is negative or\0A *                 even, or if \5Cc E is negative.\0A * \5Creturn         Another negative error code on different kinds of failures.\0A *\0A */\0Aint mbedtls_mpi_exp_mod_unsafe(mbedtls_mpi *X, const mbedtls_mpi *A,\0A                               const mbedtls_mpi *E, const mbedtls_mpi *N,\0A                               mbedtls_mpi *prec_RR);\0A\0A#endif /* bignum_internal.h */\0A\00" }
