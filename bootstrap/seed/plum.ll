tx, t);\0A        if (ret != 0) {\0A            goto exit;\0A        }\0A\0A        num_to_copy = i != n ? hash_len : okm_len - where;\0A        memcpy(okm + where, t, num_to_copy);\0A        where += hash_len;\0A        t_len = hash_len;\0A    }\0A\0Aexit:\0A    mbedtls_md_free(&ctx);\0A    mbedtls_platform_zeroize(t, sizeof(t));\0A\0A    return ret;\0A}\0A\0A#endif /* MBEDTLS_HKDF_C */\0A\00" }
