 String) (argc: Int): Int = 0\0Alet process_exit_code_raw (handle: Int): Int = 0\0Alet process_stdout_raw (handle: Int): String = \22\22\0Alet process_stderr_raw (handle: Int): String = \22\22\0Alet process_free_raw (handle: Int): Bool = false\0A\0A/// What a finished process left behind.\0A///\0A/// `exit_code` is the child's own status: a non-zero one is an ordinary\0A/// result, not an error. Launch or output-capture failures return `Err`.\0Apub struct ProcessResult { pub exit_code: Int, pub stdout: String, pub stderr: String }\0A\0A/// NO leading separator: `process_run` points argv[1] at the WHOLE\0A/// joined string, so a leading tab makes argv[1] empty and pushes the\0A/// last real argument past `argc`, silently dropping it. A plain fold\0A/// that prefixes every element is NOT equivalent.\0Alet join_args_acc (args: Array[String]) (i: Int) (acc: String): String =\0A    if i >= args.len() { acc }\0A    else if i == 0 { join_args_acc(args, i + 1, args[i]) }\0A    else { join_args_acc(args, i + 1, acc.concat(\22\5Ct\22).concat(args[i])) }\0A\0A/// A non-zero exit code is an ordinary `Ok`. `Err` means the process\0A/// could not be started, or its output could not be captured completely.\0Apub let run_process (program: String) (args: Array[String]): Result[ProcessResult, String] = {\0A    let joined = join_args_acc(args, 0, \22\22);\0A    let handle = process_run_raw(program, joined, args.len());\0A    if handle < 0 { Err(\22Os.run_process: could not start process: \22.concat(program)) }\0A    else if unsafe { process_capture_status(handle) } != 0 {\0A        let freed = process_free_raw(handle);\0A        Err(\22Os.run_process: could not read captured output\22)\0A    }\0A    else {\0A        let result = ProcessResult {\0A            exit_code: process_exit_code_raw(handle),\0A            stdout: process_stdout_raw(handle),\0A            stderr: process_stderr_raw(handle),\0A        };\0A        let freed = process_free_raw(handle);\0A        Ok(result)\0A    