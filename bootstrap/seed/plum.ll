@.str40817 = private global { i64, i64, [11565 x i8] } { i64 -1, i64 11564, [11565 x i8] c"/**\0A * \5Cfile mbedtls/config_adjust_psa_from_legacy.h\0A * \5Cbrief Adjust PSA configuration: construct PSA configuration from legacy\0A *\0A * This is an internal header. Do not include it directly.\0A *\0A * When MBEDTLS_PSA_CRYPTO_CONFIG is disabled, we automatically enable\0A * cryptographic mechanisms through the PSA interface when the corresponding\0A * legacy mechanism is enabled. In many cases, this just enables the PSA\0A * wrapper code around the legacy implementation, but we also do this for\0A * some mechanisms where PSA has its own independent implementation so\0A * that high-level modules that can use either cryptographic API have the\0A * same feature set in both cases.\0A */\0A/*\0A *  Copyright The Mbed TLS Contributors\0A *  SPDX-License-Identifier: Apache-2.0 OR GPL-2.0-or-later\0A */\0A\0A#ifndef MBEDTLS_CONFIG_ADJUST_PSA_FROM_LEGACY_H\0A#define MBEDTLS_CONFIG_ADJUST_PSA_FROM_LEGACY_H\0A\0A#if !defined(MBEDTLS_CONFIG_FILES_READ)\0A#error \22Do not include mbedtls/config_adjust_*.h manually! This can lead to problems, \22 \5C\0A    \22up to and including runtime errors such as buffer overflows. \22 \5C\0A    \22If you're trying to fix a complaint from check_config.h, just remove \22 \5C\0A    \22it from your configuration file: since Mbed TLS 3.0, it is included \22 \5C\0A    \22automatically at the right point.\22\0A#endif /* */\0A\0A/*\0A * Ensure PSA_WANT_* defines are setup properly if MBEDTLS_PSA_CRYPTO_CONFIG\0A * is not defined\0A */\0A\0A#if defined(MBEDTLS_CCM_C)\0A#define MBEDTLS_PSA_BUILTIN_ALG_CCM 1\0A#define PSA_WANT_ALG_CCM 1\0A#if defined(MBEDTLS_CIPHER_C)\0A#define MBEDTLS_PSA_BUILTIN_ALG_CCM_STAR_NO_TAG 1\0A#define PSA_WANT_ALG_CCM_STAR_NO_TAG 1\0A#endif /* MBEDTLS_CIPHER_C */\0A#endif /* MBEDTLS_CCM_C */\0A\0A#if defined(MBEDTLS_CMAC_C)\0A#define MBEDTLS_PSA_BUILTIN_ALG_CMAC 1\0A#define PSA_WANT_ALG_CMAC 1\0A#endif /* MBEDTLS_CMAC_C */\0