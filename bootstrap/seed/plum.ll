r with 128-bit key and ECB mode. */\0A    MBEDTLS_CIPHER_ARIA_192_ECB,         /**< Aria cipher with 192-bit key and ECB mode. */\0A    MBEDTLS_CIPHER_ARIA_256_ECB,         /**< Aria cipher with 256-bit key and ECB mode. */\0A    MBEDTLS_CIPHER_ARIA_128_CBC,         /**< Aria cipher with 128-bit key and CBC mode. */\0A    MBEDTLS_CIPHER_ARIA_192_CBC,         /**< Aria cipher with 192-bit key and CBC mode. */\0A    MBEDTLS_CIPHER_ARIA_256_CBC,         /**< Aria cipher with 256-bit key and CBC mode. */\0A    MBEDTLS_CIPHER_ARIA_128_CFB128,      /**< Aria cipher with 128-bit key and CFB-128 mode. */\0A    MBEDTLS_CIPHER_ARIA_192_CFB128,      /**< Aria cipher with 192-bit key and CFB-128 mode. */\0A    MBEDTLS_CIPHER_ARIA_256_CFB128,      /**< Aria cipher with 256-bit key and CFB-128 mode. */\0A    MBEDTLS_CIPHER_ARIA_128_CTR,         /**< Aria cipher with 128-bit key and CTR mode. */\0A    MBEDTLS_CIPHER_ARIA_192_CTR,         /**< Aria cipher with 192-bit key and CTR mode. */\0A    MBEDTLS_CIPHER_ARIA_256_CTR,         /**< Aria cipher with 256-bit key and CTR mode. */\0A    MBEDTLS_CIPHER_ARIA_128_GCM,         /**< Aria cipher with 128-bit key and GCM mode. */\0A    MBEDTLS_CIPHER_ARIA_192_GCM,         /**< Aria cipher with 192-bit key and GCM mode. */\0A    MBEDTLS_CIPHER_ARIA_256_GCM,         /**< Aria cipher with 256-bit key and GCM mode. */\0A    MBEDTLS_CIPHER_ARIA_128_CCM,         /**< Aria cipher with 128-bit key and CCM mode. */\0A    MBEDTLS_CIPHER_ARIA_192_CCM,         /**< Aria cipher with 192-bit key and CCM mode. */\0A    MBEDTLS_CIPHER_ARIA_256_CCM,         /**< Aria cipher with 256-bit key and CCM mode. */\0A    MBEDTLS_CIPHER_ARIA_128_CCM_STAR_NO_TAG, /**< Aria cipher with 128-bit key and CCM_STAR_NO_TAG mode. */\0A    MBEDTLS_CIPHER_ARIA_192_CCM_STAR_NO_TAG, /**< Aria cipher with 192-bit key and CCM_STAR_NO_TAG mode. */\0A    MBEDTLS_CIPHER_ARIA_256_CCM_STAR_NO_TAG, /**< Aria cipher with 256-bit key and CCM_STAR_NO_TAG mode. */\0A    MBEDTLS_CIPHER_AES_128_OFB,          /**< AES 128-bit cipher in OFB mode. */\0A    MBEDTLS_CIPHER_AES_192_OFB,          /**< AES 192-bit cipher in OFB mode. */\0A    MBEDTLS_CIPHER_AES_256_OFB,          /**< AES 256-bit cipher in OFB mode. */\0A    MBEDTLS_CIPHER_AES_128_XTS,          /**< AES 128-bit cipher in XTS block mode. */\0A    MBEDTLS_CIPHER_AES_256_XTS,          /**< AES 256-bit cipher in XTS block mode. */\0A    MBEDTLS_CIPHER_CHACHA20,             /**< ChaCha20 stream cipher. */\0A    MBEDTLS_CIPHER_CHACHA20_POLY1305,    /**< ChaCha20-Poly1305 AEAD cipher. */\0A    MBEDTLS_CIPHER_AES_128_KW,           /**< AES cipher with 128-bit NIST KW mode. */\0A    MBEDTLS_CIPHER_AES_192_KW,           /**< AES cipher with 192-bit NIST KW mode. */\0A    MBEDTLS_CIPHER_AES_256_KW,           /**< AES cipher with 256-bit NIST KW mode. */\0A    MBEDTLS_CIPHER_AES_128_KWP,          /**< AES cipher with 128-bit NIST KWP mode. */\0A    MBEDTLS_CIPHER_AES_192_KWP,          /**< AES cipher with 192-bit NIST KWP mode. */\0A    MBEDTLS_CIPHER_AES_256_KWP,          /**< AES cipher with 256-bit NIST KWP mode. */\0A} mbedtls_cipher_type_t;\0A\0A/** Supported cipher modes. */\0Atypedef enum {\0A    MBEDTLS_MODE_NONE = 0,               /**< None.                        */\0A    MBEDTLS_MODE_ECB,                    /**< The ECB cipher mode.         */\0A    MBEDTLS_MODE_CBC,                    /**< The CBC cipher mode.         */\0A    MBEDTLS_MODE_CFB,                    /**< The CFB cipher mode.         */\0A    MBEDTLS_MODE_OFB,                    /**< The OFB cipher mode.         */\0A    MBEDTLS_MODE_CTR,                    /**< The CTR cipher mode.         */\0A    MBEDTLS_MODE_GCM,                    /**< The GCM cipher mode.         */\0A    MBEDTLS_MODE_STREAM,                 /**< The stream cipher mode.      */\0A    MBEDTLS_MODE_CCM,                    /**< The CCM cipher mode.         */\0A    MBEDTLS_MODE_CCM_STAR_NO_TAG,        /**< The CCM*-no-tag cipher mode. */\0A    MBEDTLS_MODE_XTS,                    /**< The XTS cipher mode.         */\0A    MBEDTLS_MODE_CHACHAPOLY,             /**< The ChaCha-Poly cipher mode. */\0A    MBEDTLS_MODE_KW,                     /**< The SP800-38F KW mode */\0A    MBEDTLS_MODE_KWP,                    /**< The SP800-38F KWP mode */\0A} mbedtls_cipher_mode_t;\0A\0A/** Supported cipher padding types. */\0Atypedef enum {\0A    MBEDTLS_PADDING_PKCS7 = 0,     /**< PKCS7 padding (default).        */\0A    MBEDTLS_PADDING_ONE_AND_ZEROS, /**< ISO/IEC 7816-4 padding.         */\0A    MBEDTLS_PADDING_ZEROS_AND_LEN, /**< ANSI X.923 padding.             */\0A    MBEDTLS_PADDING_ZEROS,         /**< Zero padding (not reversible). */\0A    MBEDTLS_PADDING_NONE,          /**< Never pad (full blocks only).   */\0A} mbedtls_cipher_padding_t;\0A\0A/** Type of operation. */\0Atypedef enum {\0A    MBEDTLS_OPERATION_NONE = -1,\0A    MBEDTLS_DECRYPT = 0,\0A    MBEDTLS_ENCRYPT,\0A} mbedtls_operation_t;\0A\0Aenum {\0A    /** Undefined key length. */\0A    MBEDTLS_KEY_LENGTH_NONE = 0,\0A    /** Key length, in bits (including parity), for DES keys. \5Cwarning DES is considered weak. */\0A    MBEDTLS_KEY_LENGTH_DES  = 64,\0A    /** Key length in bits, including parity, for DES in two-key EDE. \5Cwarning 3DES is considered weak. */\0A    MBEDTLS_KEY_LENGTH_DES_EDE = 128,\0A    /** Key length in bits, including parity, for DES in three-key EDE. \5Cwarning 3DES is considered weak. */\0A    MBEDTLS_KEY_LENGTH_DES_EDE3 = 192,\0A};\0A\0A/** Maximum length of any IV, in Bytes. */\0A/* This should ideally be derived automatically from list of ciphers.\0A * This should be kept in sync with MBEDTLS_SSL_MAX_IV_LENGTH defined\0A * in library/ssl_misc.h. */\0A#define MBEDTLS_MAX_IV_LENGTH      16\0A\0A/** Maximum block size of any cipher, in Bytes. */\0A/* This should ideally be derived automatically from list of ciphers.\0A * This should be kept in sync with MBEDTLS_SSL_MAX_BLOCK_LENGTH defined\0A * in library/ssl_misc.h. */\0A#define MBEDTLS_MAX_BLOCK_LENGTH   16\0A\0A/** Maximum key length, in Bytes. */\0A/* This should ideally be derived automatically from list of ciphers.\0A * For now, only check whether XTS is enabled which uses 64 Byte keys,\0A * and use 32 Bytes as an upper bound for the maximum key length otherwise.\0A * This should be kept in sync with MBEDTLS_SSL_MAX_BLOCK_LENGTH defined\0A * in library/ssl_misc.h, which however deliberately ignores the case of XTS\0A * since the latter isn't used in SSL/TLS. */\0A#if defined(MBEDTLS_CIPHER_MODE_XTS)\0A#define MBEDTLS_MAX_KEY_LENGTH     64\0A#else\0A#define MBEDTLS_MAX_KEY_LENGTH     32\0A#endif /* MBEDTLS_CIPHER_MODE_XTS */\0A\0A/**\0A * Base cipher information (opaque struct).\0A */\0Atypedef struct mbedtls_cipher_base_t mbedtls_cipher_base_t;\0A\0A/**\0A * CMAC context (opaque struct).\0A */\0Atypedef struct mbedtls_cmac_context_t mbedtls_cmac_context_t;\0A\0A/**\0A * Cipher information. Allows calling cipher functions\0A * in a generic way.\0A *\0A * \5Cnote        The library does not support custom cipher info structures,\0A *              only built-in structures returned by the functions\0A *              mbedtls_cipher_info_from_string(),\0A *              mbedtls_cipher_info_from_type(),\0A *              mbedtls_cipher_info_from_values(),\0A *              mbedtls_cipher_info_from_psa().\0A *\0A * \5Cnote        Some fields store a value that has been right-shifted to save\0A *              code-size, so should not be used directly. The accessor\0A *              functions adjust for this and return the \22natural\22 value.\0A */\0Atypedef struct mbedtls_cipher_info_t {\0A    /** Name of the cipher. */\0A    const char *MBEDTLS_PRIVATE(name);\0A\0A    /** The block size, in bytes. */\0A    unsigned int MBEDTLS_PRIVATE(block_size) : 5;\0A\0A    /** IV or nonce size, in bytes (right shifted by #MBEDTLS_IV_SIZE_SHIFT).\0A     * For ciphers that accept variable IV sizes,\0A     * this is the recommended size.\0A     */\0A    unsigned int MBEDTLS_PRIVATE(iv_size) : 3;\0A\0A    /** The cipher key length, in bits (right shifted by #MBEDTLS_KEY_BITLEN_SHIFT).\0A     * This is the default length for variable sized ciphers.\0A     * Includes parity bits for ciphers like DES.\0A     */\0A    unsigned int MBEDTLS_PRIVATE(key_bitlen) : 4;\0A\0A    /** The cipher mode (as per mbedtls_cipher_mode_t).\0A     * For example, MBEDTLS_MODE_CBC.\0A     */\0A    unsigned int MBEDTLS_PRIVATE(mode) : 4;\0A\0A    /** Full cipher identifier (as per mbedtls_cipher_type_t).\0A     * For example, MBEDTLS_CIPHER_AES_256_CBC.\0A     *\0A     * This could be 7 bits, but 8 bits retains byte alignment for the\0A     * next field, which reduces code size to access that field.\0A     */\0A    unsigned int MBEDTLS_PRIVATE(type) : 8;\0A\0A    /** Bitflag comprised of MBEDTLS_CIPHER_VARIABLE_IV_LEN and\0A     *  MBEDTLS_CIPHER_VARIABLE_KEY_LEN indicating whether the\0A     *  cipher supports variable IV or variable key sizes, respectively.\0A     */\0A    unsigned int MBEDTLS_PRIVATE(flags) : 2;\0A\0A    /** Index to LUT for base cipher information and functions. */\0A    unsigned int MBEDTLS_PRIVATE(base_idx) : 5;\0A\0A} mbedtls_cipher_info_t;\0A\0A/* For internal use only.\0A * These are used to more compactly represent the fields above. */\0A#define MBEDTLS_KEY_BITLEN_SHIFT  6\0A#define MBEDTLS_IV_SIZE_SHIFT     2\0A/**\0A * Generic cipher context.\0A */\0Atypedef struct mbedtls_cipher_context_t {\0A    /** Information about the associated cipher. */\0A    const mbedtls_cipher_info_t *MBEDTLS_PRIVATE(cipher_info);\0A\0A    /** Key length to use. */\0A    int MBEDTLS_PRIVATE(key_bitlen);\0A\0A    /** Operation that the key of the context has been\0A     * initialized for.\0A     */\0A    mbedtls_operation_t MBEDTLS_PRIVATE(operation);\0A\0A#if defined(MBEDTLS_CIPHER_MODE_WITH_PADDING)\0A    /** Padding functions to use, if relevant for\0A     * the specific cipher mode.\0A     */\0A    void(*MBEDTLS_PRIVATE(add_padding))(unsigned char *output, size_t olen, size_t data_len);\0A    int(*MBEDTLS_PRIVATE(get_padding))(unsigned char *input, size_t ilen, size_t *data_len);\0A#endif\0A\0A    /** Buffer for input that has not been processed yet. */\0A    unsigned char MBEDTLS_PRIVATE(unprocessed_data)[MBEDTLS_MAX_BLOCK_LENGTH];\0A\0A    /** Number of Bytes that have not been processed yet. */\0A    size_t MBEDTLS_PRIVATE(unprocessed_len);\0A\0A    /** Current IV or NONCE_COUNTER for CTR-mode, data unit (or sector) number\0A     * for XTS-mode. */\0A    unsigned char MBEDTLS_PRIVATE(iv)[MBEDTLS_MAX_IV_LENGTH];\0A\0A    /** IV size in Bytes, for ciphers with variable-length IVs. */\0A    size_t MBEDTLS_PRIVATE(iv_size);\0A\0A    /** The cipher-specific context. */\0A    void *MBEDTLS_PRIVATE(cipher_ctx);\0A\0A#if defined(MBEDTLS_CMAC_C)\0A    /** CMAC-specific context. */\0A    mbedtls_cmac_context_t *MBEDTLS_PRIVATE(cmac_ctx);\0A#endif\0A\0A#if defined(MBEDTLS_USE_PSA_CRYPTO) && !defined(MBEDTLS_DEPRECATED_REMOVED)\0A    /** Indicates whether the cipher operations should be performed\0A     *  by Mbed TLS' own crypto library or an external implementation\0A     *  of the PSA Crypto API.\0A     *  This is unset if the cipher context was established through\0A     *  mbedtls_cipher_setup(), and set if it was established through\0A     *  mbedtls_cipher_setup_psa().\0A     */\0A    unsigned char MBEDTLS_PRIVATE(psa_enabled);\0A#endif /* MBEDTLS_USE_PSA_CRYPTO && !MBEDTLS_DEPRECATED_REMOVED */\0A\0A} mbedtls_cipher_context_t;\0A\0A/**\0A * \5Cbrief This function retrieves the list of ciphers supported\0A *        by the generic cipher module.\0A *\0A *        For any cipher identifier in the returned list, you can\0A *        obtain the corresponding generic cipher information structure\0A *        via mbedtls_cipher_info_from_type(), which can then be used\0A *        to prepare a cipher context via mbedtls_cipher_setup().\0A *\0A *\0A * \5Creturn      A statically-allocated array of cipher identifiers\0A *              of type cipher_type_t. The last entry is zero.\0A */\0Aconst int *mbedtls_cipher_list(void);\0A\0A/**\0A * \5Cbrief               This function retrieves the cipher-information\0A *                      structure associated with the given cipher name.\0A *\0A * \5Cparam cipher_name   Name of the cipher to search for. This must not be\0A *                      \5Cc NULL.\0A *\0A * \5Creturn              The cipher information structure associated with the\0A *                      given \5Cp cipher_name.\0A * \5Creturn              \5Cc NULL if the associated cipher information is not found.\0A */\0Aconst mbedtls_cipher_info_t *mbedtls_cipher_info_from_string(const char *cipher_name);\0A\0A/**\0A * \5Cbrief               This function retrieves the cipher-information\0A *                      structure associated with the given cipher type.\0A *\0A * \5Cparam cipher_type   Type of the cipher to search for.\0A *\0A * \5Creturn              The cipher information structure associated with the\0A *                      given \5Cp cipher_type.\0A * \5Creturn              \5Cc NULL if the associated cipher information is not found.\0A */\0Aconst mbedtls_cipher_info_t *mbedtls_cipher_info_from_type(const mbedtls_cipher_type_t cipher_type);\0A\0A/**\0A * \5Cbrief               This function retrieves the cipher-information\0A *                      structure associated with the given cipher ID,\0A *                      key size and mode.\0A *\0A * \5Cparam cipher_id     The ID of the cipher to search for. For example,\0A *                      #MBEDTLS_CIPHER_ID_AES.\0A * \5Cparam key_bitlen    The length of the key in bits.\0A * \5Cparam mode          The cipher mode. For example, #MBEDTLS_MODE_CBC.\0A *\0A * \5Creturn              The cipher information structure associated with the\0A *                      given \5Cp cipher_id.\0A * \5Creturn              \5Cc NULL if the associated cipher information is not found.\0A */\0Aconst mbedtls_cipher_info_t *mbedtls_cipher_info_from_values(const mbedtls_cipher_id_t cipher_id,\0A                                                             int key_bitlen,\0A                                                             const mbedtls_cipher_mode_t mode);\0A\0A/**\0A * \5Cbrief               Retrieve the identifier for a cipher info structure.\0A *\0A * \5Cparam[in] info      The cipher info structure to query.\0A *                      This may be \5Cc NULL.\0A *\0A * \5Creturn              The full cipher identifier (\5Cc MBEDTLS_CIPHER_xxx).\0A * \5Creturn              #MBEDTLS_CIPHER_NONE if \5Cp info is \5Cc NULL.\0A */\0Astatic inline mbedtls_cipher_type_t mbedtls_cipher_info_get_type(\0A    const mbedtls_cipher_info_t *info)\0A{\0A    if (info == NULL) {\0A        return MBEDTLS_CIPHER_NONE;\0A    } else {\0A        return (mbedtls_cipher_type_t) info->MBEDTLS_PRIVATE(type);\0A    }\0A}\0A\0A/**\0A * \5Cbrief               Retrieve the operation mode for a cipher info structure.\0A *\0A * \5Cparam[in] info      The cipher info structure to query.\0A *                      This may be \5Cc NULL.\0A *\0A * \5Creturn              The cipher mode (\5Cc MBEDTLS_MODE_xxx).\0A * \5Creturn              #MBEDTLS_MODE_NONE if \5Cp info is \5Cc NULL.\0A */\0Astatic inline mbedtls_cipher_mode_t mbedtls_cipher_info_get_mode(\0A    const mbedtls_cipher_info_t *info)\0A{\0A    if (info == NULL) {\0A        return MBEDTLS_MODE_NONE;\0A    } else {\0A        return (mbedtls_cipher_mode_t) info->MBEDTLS_PRIVATE(mode);\0A    }\0A}\0A\0A/**\0A * \5Cbrief               Retrieve the key size for a cipher info structure.\0A *\0A * \5Cparam[in] info      The cipher info structure to query.\0A *                      This may be \5Cc NULL.\0A *\0A * \5Creturn              The key length in bits.\0A *                      For variable-sized ciphers, this is the default length.\0A *                      For DES, this includes the parity bits.\0A * \5Creturn              \5Cc 0 if \5Cp info is \5Cc NULL.\0A */\0Astatic inline size_t mbedtls_cipher_info_get_key_bitlen(\0A    const mbedtls_cipher_info_t *info)\0A{\0A    if (info == NULL) {\0A        return 0;\0A    } else {\0A        return ((size_t) info->MBEDTLS_PRIVATE(key_bitlen)) << MBEDTLS_KEY_BITLEN_SHIFT;\0A    }\0A}\0A\0A/**\0A * \5Cbrief               Retrieve the human-readable name for a\0A *                      cipher info structure.\0A *\0A * \5Cparam[in] info      The cipher info structure to query.\0A *                      This may be \5Cc NULL.\0A *\0A * \5Creturn              The cipher name, which is a human readable string,\0A *                      with static storage duration.\0A * \5Creturn              \5Cc NULL if \5Cp info is \5Cc NULL.\0A */\0Astatic inline const char *mbedtls_cipher_info_get_name(\0A    const mbedtls_cipher_info_t *info)\0A{\0A    if (info == NULL) {\0A        return NULL;\0A    } else {\0A        return info->MBEDTLS_PRIVATE(name);\0A    }\0A}\0A\0A/**\0A * \5Cbrief       This function returns the size of the IV or nonce\0A *              for the cipher info structure, in bytes.\0A *\0A * \5Cparam info  The cipher info structure. This may be \5Cc NULL.\0A *\0A * \5Creturn      The recommended IV size.\0A * \5Creturn      \5Cc 0 for ciphers not using an IV or a nonce.\0A * \5Creturn      \5Cc 0 if \5Cp info is \5Cc NULL.\0A */\0Astatic inline size_t mbedtls_cipher_info_get_iv_size(\0A    const mbedtls_cipher_info_t *info)\0A{\0A    if (info == NULL) {\0A        return 0;\0A    }\0A\0A    return ((size_t) info->MBEDTLS_PRIVATE(iv_size)) << MBEDTLS_IV_SIZE_SHIFT;\0A}\0A\0A/**\0A * \5Cbrief        This function returns the block size of the given\0A *               cipher info structure in bytes.\0A *\0A * \5Cparam info   The cipher info structure. This may be \5Cc NULL.\0A *\0A * \5Creturn       The block size of the cipher.\0A * \5Creturn       \5Cc 1 if the cipher is a stream cipher.\0A * \5Creturn       \5Cc 0 if \5Cp info is \5Cc NULL.\0A */\0Astatic inline size_t mbedtls_cipher_info_get_block_size(\0A    const mbedtls_cipher_info_t *info)\0A{\0A    if (info == NULL) {\0A        return 0;\0A    }\0A\0A    return (size_t) (info->MBEDTLS_PRIVATE(block_size));\0A}\0A\0A/**\0A * \5Cbrief        This function returns a non-zero value if the key length for\0A *               the given cipher is variable.\0A *\0A * \5Cparam info   The cipher info structure. This may be \5Cc NULL.\0A *\0A * \5Creturn       Non-zero if the key length is variable, \5Cc 0 otherwise.\0A * \5Creturn       \5Cc 0 if the given pointer is \5Cc NULL.\0A */\0Astatic inline int mbedtls_cipher_info_has_variable_key_bitlen(\0A    const mbedtls_cipher_info_t *info)\0A{\0A    if (info == NULL) {\0A        return 0;\0A    }\0A\0A    return info->MBEDTLS_PRIVATE(flags) & MBEDTLS_CIPHER_VARIABLE_KEY_LEN;\0A}\0A\0A/**\0A * \5Cbrief        This function returns a non-zero value if the IV size for\0A *               the given cipher is variable.\0A *\0A * \5Cparam info   The cipher info structure. This may be \5Cc NULL.\0A *\0A * \5Creturn       Non-zero if the IV size is variable, \5Cc 0 otherwise.\0A * \5Creturn       \5Cc 0 if the given pointer is \5Cc NULL.\0A */\0Astatic inline int mbedtls_cipher_info_has_variable_iv_size(\0A    const mbedtls_cipher_info_t *info)\0A{\0A    if (info == NULL) {\0A        return 0;\0A    }\0A\0A    return info->MBEDTLS_PRIVATE(flags) & MBEDTLS_CIPHER_VARIABLE_IV_LEN;\0A}\0A\0A/**\0A * \5Cbrief               This function initializes a \5Cp ctx as NONE.\0A *\0A * \5Cparam ctx           The context to be initialized. This must not be \5Cc NULL.\0A */\0Avoid mbedtls_cipher_init(mbedtls_cipher_context_t *ctx);\0A\0A/**\0A * \5Cbrief               This function frees and clears the cipher-specific\0A *                      context of \5Cp ctx. Freeing \5Cp ctx itself remains the\0A *                      responsibility of the caller.\0A *\0A * \5Cparam ctx           The context to be freed. If this is \5Cc NULL, the\0A *                      function has no effect, otherwise this must point to an\0A *                      initialized context.\0A */\0Avoid mbedtls_cipher_free(mbedtls_cipher_context_t *ctx);\0A\0A\0A/**\0A * \5Cbrief               This function prepares a cipher context for\0A *                      use with the given cipher primitive.\0A *\0A * \5Cnote                After calling this function, you should call\0A *                      mbedtls_cipher_setkey() and, if the mode uses padding,\0A *                      mbedtls_cipher_set_padding_mode(), then for each\0A *                      message to encrypt or decrypt with this key, either:\0A *                      - mbedtls_cipher_crypt() for one-shot processing with\0A *                      non-AEAD modes;\0A *                      - mbedtls_cipher_auth_encrypt_ext() or\0A *                      mbedtls_cipher_auth_decrypt_ext() for one-shot\0A *                      processing with AEAD modes or NIST_KW;\0A *                      - for multi-part processing, see the documentation of\0A *                      mbedtls_cipher_reset().\0A *\0A * \5Cparam ctx           The context to prepare. This must be initialized by\0A *                      a call to mbedtls_cipher_init() first.\0A * \5Cparam cipher_info   The cipher to use.\0A *\0A * \5Creturn              \5Cc 0 on success.\0A * \5Creturn              #MBEDTLS_ERR_CIPHER_BAD_INPUT_DATA on\0A *                      parameter-verification failure.\0A * \5Creturn              #MBEDTLS_ERR_CIPHER_ALLOC_FAILED if allocation of the\0A *                      cipher-specific context fails.\0A */\0Aint mbedtls_cipher_setup(mbedtls_cipher_context_t *ctx,\0A                         const mbedtls_cipher_info_t *cipher_info);\0A\0A#if defined(MBEDTLS_USE_PSA_CRYPTO)\0A#if !defined(MBEDTLS_DEPRECATED_REMOVED)\0A/**\0A * \5Cbrief               This function initializes a cipher context for\0A *                      PSA-based use with the given cipher primitive.\0A *\0A * \5Cdeprecated          This function is deprecated and will be removed in a\0A *                      future version of the library.\0A *                      Please use psa_aead_xxx() / psa_cipher_xxx() directly\0A *                      instead.\0A *\0A * \5Cnote                See #MBEDTLS_USE_PSA_CRYPTO for information on PSA.\0A *\0A * \5Cparam ctx           The context to initialize. May not be \5Cc NULL.\0A * \5Cparam cipher_info   The cipher to use.\0A * \5Cparam taglen        For AEAD ciphers, the length in bytes of the\0A *                      authentication tag to use. Subsequent uses of\0A *                      mbedtls_cipher_auth_encrypt_ext() or\0A *                      mbedtls_cipher_auth_decrypt_ext() must provide\0A *                      the same tag length.\0A *                      For non-AEAD ciphers, the value must be \5Cc 0.\0A *\0A * \5Creturn              \5Cc 0 on success.\0A * \5Creturn              #MBEDTLS_ERR_CIPHER_BAD_INPUT_DATA on\0A *                      parameter-verification failure.\0A * \5Creturn              #MBEDTLS_ERR_CIPHER_ALLOC_FAILED if allocation of the\0A *                      cipher-specific context fails.\0A */\0Aint MBEDTLS_DEPRECATED mbedtls_cipher_setup_psa(mbedtls_cipher_context_t *ctx,\0A                                                const mbedtls_cipher_info_t *cipher_info,\0A                                                size_t taglen);\0A#endif /* MBEDTLS_DEPRECATED_REMOVED */\0A#endif /* MBEDTLS_USE_PSA_CRYPTO */\0A\0A/**\0A * \5Cbrief        This function returns the block size of the given cipher\0A *               in bytes.\0A *\0A * \5Cparam ctx    The context of the cipher.\0A *\0A * \5Creturn       The block size of the underlying cipher.\0A * \5Creturn       \5Cc 1 if the cipher is a stream cipher.\0A * \5Creturn       \5Cc 0 if \5Cp ctx has not been initialized.\0A */\0Astatic inline unsigned int mbedtls_cipher_get_block_size(\0A    const mbedtls_cipher_context_t *ctx)\0A{\0A    if (ctx->MBEDTLS_PRIVATE(cipher_info) == NULL) {\0A        return 0;\0A    }\0A\0A    return (unsigned int) ctx->MBEDTLS_PRIVATE(cipher_info)->MBEDTLS_PRIVATE(block_size);\0A}\0A\0A/**\0A * \5Cbrief        This function returns the mode of operation for\0A *               the cipher. For example, MBEDTLS_MODE_CBC.\0A *\0A * \5Cparam ctx    The context of the cipher. This must be initialized.\0A *\0A * \5Creturn       The mode of operation.\0A * \5Creturn       #MBEDTLS_MODE_NONE if \5Cp ctx has not been initialized.\0A */\0Astatic inline mbedtls_cipher_mode_t mbedtls_cipher_get_cipher_mode(\0A    const mbedtls_cipher_context_t *ctx)\0A{\0A    if (ctx->MBEDTLS_PRIVATE(cipher_info) == NULL) {\0A        return MBEDTLS_MODE_NONE;\0A    }\0A\0A    return (mbedtls_cipher_mode_t) ctx->MBEDTLS_PRIVATE(cipher_info)->MBEDTLS_PRIVATE(mode);\0A}\0A\0A/**\0A * \5Cbrief       This function returns the size of the IV or nonce\0A *              of the cipher, in Bytes.\0A *\0A * \5Cparam ctx   The context of the cipher. This must be initialized.\0A *\0A * \5Creturn      The recommended IV size if no IV has been set.\0A * \5Creturn      \5Cc 0 for ciphers not using an IV or a nonce.\0A * \5Creturn      The actual size if an IV has been set.\0A */\0Astatic inline int mbedtls_cipher_get_iv_size(\0A    const mbedtls_cipher_context_t *ctx)\0A{\0A    if (ctx->MBEDTLS_PRIVATE(cipher_info) == NULL) {\0A        return 0;\0A    }\0A\0A    if (ctx->MBEDTLS_PRIVATE(iv_size) != 0) {\0A        return (int) ctx->MBEDTLS_PRIVATE(iv_size);\0A    }\0A\0A    return (int) (((int) ctx->MBEDTLS_PRIVATE(cipher_info)->MBEDTLS_PRIVATE(iv_size)) <<\0A                  MBEDTLS_IV_SIZE_SHIFT);\0A}\0A\0A/**\0A * \5Cbrief               This function returns the type of the given cipher.\0A *\0A * \5Cparam ctx           The context of the cipher. This must be initialized.\0A *\0A * \5Creturn              The type of the cipher.\0A * \5Creturn              #MBEDTLS_CIPHER_NONE if \5Cp ctx has not been initialized.\0A */\0Astatic inline mbedtls_cipher_type_t mbedtls_cipher_get_type(\0A    const mbedtls_cipher_context_t *ctx)\0A{\0A    if (ctx->MBEDTLS_PRIVATE(cipher_info) == NULL) {\0A        return MBEDTLS_CIPHER_NONE;\0A    }\0A\0A    return (mbedtls_cipher_type_t) ctx->MBEDTLS_PRIVATE(cipher_info)->MBEDTLS_PRIVATE(type);\0A}\0A\0A/**\0A * \5Cbrief               This function returns the name of the given cipher\0A *                      as a string.\0A *\0A * \5Cparam ctx           The context of the cipher. This must be initialized.\0A *\0A * \5Creturn              The name of the cipher.\0A * \5Creturn              NULL if \5Cp ctx has not been not initialized.\0A */\0Astatic inline const char *mbedtls_cipher_get_name(\0A    const mbedtls_cipher_context_t *ctx)\0A{\0A    if (ctx->MBEDTLS_PRIVATE(cipher_info) == NULL) {\0A        return 0;\0A    }\0A\0A    return ctx->MBEDTLS_PRIVATE(cipher_info)->MBEDTLS_PRIVATE(name);\0A}\0A\0A/**\0A * \5Cbrief               This function returns the key length of the cipher.\0A *\0A * \5Cparam ctx           The context of the cipher. This must be initialized.\0A *\0A * \5Creturn              The key length of the cipher in bits.\0A * \5Creturn              #MBEDTLS_KEY_LENGTH_NONE if \5Cp ctx has not been\0A *                      initialized.\0A */\0Astatic inline int mbedtls_cipher_get_key_bitlen(\0A    const mbedtls_cipher_context_t *ctx)\0A{\0A    if (ctx->MBEDTLS_PRIVATE(cipher_info) == NULL) {\0A        return MBEDTLS_KEY_LENGTH_NONE;\0A    }\0A\0A    return (int) ctx->MBEDTLS_PRIVATE(cipher_info)->MBEDTLS_PRIVATE(key_bitlen) <<\0A           MBEDTLS_KEY_BITLEN_SHIFT;\0A}\0A\0A/**\0A * \5Cbrief          This function returns the operation of the given cipher.\0A *\0A * \5Cparam ctx      The context of the cipher. This must be initialized.\0A *\0A * \5Creturn         The type of operation: #MBEDTLS_ENCRYPT or #MBEDTLS_DECRYPT.\0A * \5Creturn         #MBEDTLS_OPERATION_NONE if \5Cp ctx has not been initialized.\0A */\0Astatic inline mbedtls_operation_t mbedtls_cipher_get_operation(\0A    const mbedtls_cipher_context_t *ctx)\0A{\0A    if (ctx->MBEDTLS_PRIVATE(cipher_info) == NULL) {\0A        return MBEDTLS_OPERATION_NONE;\0A    }\0A\0A    return ctx->MBEDTLS_PRIVATE(operation);\0A}\0A\0A/**\0A * \5Cbrief               This function sets the key to use with the given context.\0A *\0A * \5Cparam ctx           The generic cipher context. This must be initialized and\0A *                      bound to a cipher information structure.\0A * \5Cparam key           The key to use. This must be a readable buffer of at\0A *                      least \5Cp key_bitlen Bits.\0A * \5Cparam key_bitlen    The key length to use, in Bits.\0A * \5Cparam operation     The operation that the key will be used for:\0A *                      #MBEDTLS_ENCRYPT or #MBEDTLS_DECRYPT.\0A *\0A * \5Creturn              \5Cc 0 on success.\0A * \5Creturn              #MBEDTLS_ERR_CIPHER_BAD_INPUT_DATA on\0A *                      parameter-verification failure.\0A * \5Creturn              A cipher-specific error code on failure.\0A */\0Aint mbedtls_cipher_setkey(mbedtls_cipher_context_t *ctx,\0A                          const unsigned char *key,\0A                          int key_bitlen,\0A                          const mbedtls_operation_t operation);\0A\0A#if defined(MBEDTLS_CIPHER_MODE_WITH_PADDING)\0A/**\0A * \5Cbrief               This function sets the padding mode, for cipher modes\0A *                      that use padding.\0A *\0A *\0A * \5Cparam ctx           The generic cipher context. This must be initialized and\0A *                      bound to a cipher information structure.\0A * \5Cparam mode          The padding mode.\0A *\0A * \5Creturn              \5Cc 0 on success.\0A * \5Creturn              #MBEDTLS_ERR_CIPHER_FEATURE_UNAVAILABLE\0A *                      if the selected padding mode is not supported.\0A * \5Creturn              #MBEDTLS_ERR_CIPHER_BAD_INPUT_DATA if the cipher mode\0A *                      does not support padding.\0A */\0Aint mbedtls_cipher_set_padding_mode(mbedtls_cipher_context_t *ctx,\0A                                    mbedtls_cipher_padding_t mode);\0A#endif /* MBEDTLS_CIPHER_MODE_WITH_PADDING */\0A\0A/**\0A * \5Cbrief           This function sets the initialization vector (IV)\0A *                  or nonce.\0A *\0A * \5Cnote            Some ciphers do not use IVs nor nonce. For these\0A *                  ciphers, this function has no effect.\0A *\0A * \5Cnote            For #MBEDTLS_CIPHER_CHACHA20, the nonce length must\0A *                  be 12, and the initial counter value is 0.\0A *\0A * \5Cnote            For #MBEDTLS_CIPHER_CHACHA20_POLY1305, the nonce length\0A *                  must be 12.\0A *\0A * \5Cparam ctx       The generic cipher context. This must be initialized and\0A *                  bound to a cipher information structure.\0A * \5Cparam iv        The IV to use, or NONCE_COUNTER for CTR-mode ciphers. This\0A *                  must be a readable buffer of at least \5Cp iv_len Bytes.\0A * \5Cparam iv_len    The IV length for ciphers with variable-size IV.\0A *                  This parameter is discarded by ciphers with fixed-size IV.\0A *\0A * \5Creturn          \5Cc 0 on success.\0A * \5Creturn          #MBEDTLS_ERR_CIPHER_BAD_INPUT_DATA on\0A *                  parameter-verification failure.\0A */\0Aint mbedtls_cipher_set_iv(mbedtls_cipher_context_t *ctx,\0A                          const unsigned char *iv,\0A                          size_t iv_len);\0A\0A/**\0A * \5Cbrief         This function resets the cipher state.\0A *\0A * \5Cnote          With non-AEAD ciphers, the order of calls for each message\0A *                is as follows:\0A *                1. mbedtls_cipher_set_iv() if the mode uses an IV/nonce.\0A *                2. mbedtls_cipher_reset()\0A *                3. mbedtls_cipher_update() one or more times\0A *                4. mbedtls_cipher_finish()\0A *                .\0A *                This sequence can be repeated to encrypt or decrypt multiple\0A *                messages with the same key.\0A *\0A * \5Cnote          With AEAD ciphers, the order of calls for each message\0A *                is as follows:\0A *                1. mbedtls_cipher_set_iv() if the mode uses an IV/nonce.\0A *                2. mbedtls_cipher_reset()\0A *                3. mbedtls_cipher_update_ad()\0A *                4. mbedtls_cipher_update() one or more times\0A *                5. mbedtls_cipher_finish()\0A *                6. mbedtls_cipher_check_tag() (for decryption) or\0A *                mbedtls_cipher_write_tag() (for encryption).\0A *                .\0A *                This sequence can be repeated to encrypt or decrypt multiple\0A *                messages with the same key.\0A *\0A * \5Cparam ctx     The generic cipher context. This must be bound to a key.\0A *\0A * \5Creturn        \5Cc 0 on success.\0A * \5Creturn        #MBEDTLS_ERR_CIPHER_BAD_INPUT_DATA on\0A *                parameter-verification failure.\0A */\0Aint mbedtls_cipher_reset(mbedtls_cipher_context_t *ctx);\0A\0A#if defined(MBEDTLS_GCM_C) || defined(MBEDTLS_CHACHAPOLY_C)\0A/**\0A * \5Cbrief               This function adds additional data for AEAD ciphers.\0A *                      Currently supported with GCM and ChaCha20+Poly1305.\0A *\0A * \5Cparam ctx           The generic cipher context. This must be initialized.\0A * \5Cparam ad            The additional data to use. This must be a readable\0A *                      buffer of at least \5Cp ad_len Bytes.\0A * \5Cparam ad_len        The length of \5Cp ad in Bytes.\0A *\0A * \5Creturn              \5Cc 0 on success.\0A * \5Creturn              A specific error code on failure.\0A */\0Aint mbedtls_cipher_update_ad(mbedtls_cipher_context_t *ctx,\0A                             const unsigned char *ad, size_t ad_len);\0A#endif /* MBEDTLS_GCM_C || MBEDTLS_CHACHAPOLY_C */\0A\0A/**\0A * \5Cbrief               The generic cipher update function. It encrypts or\0A *                      decrypts using the given cipher context. Writes as\0A *                      many block-sized blocks of data as possible to output.\0A *                      Any data that cannot be written immediately is either\0A *                      added to the next block, or flushed when\0A *                      mbedtls_cipher_finish() is called.\0A *                      Exception: For MBEDTLS_MODE_ECB, expects a single block\0A *                      in size. For example, 16 Bytes for AES.\0A *\0A * \5Cparam ctx           The generic cipher context. This must be initialized and\0A *                      bound to a key.\0A * \5Cparam input         The buffer holding the input data. This must be a\0A *                      readable buffer of at least \5Cp ilen Bytes.\0A * \5Cparam ilen          The length of the input data.\0A * \5Cparam output        The buffer for the output data. This must be able to\0A *                      hold at least `ilen + block_size`. This must not be the\0A *                      same buffer as \5Cp input.\0A * \5Cparam olen          The length of the output data, to be updated with the\0A *                      actual number of Bytes written. This must not be\0A *                      \5Cc NULL.\0A *\0A * \5Creturn              \5Cc 0 on success.\0A * \5Creturn              #MBEDTLS_ERR_CIPHER_BAD_INPUT_DATA on\0A *                      parameter-verification failure.\0A * \5Creturn              #MBEDTLS_ERR_CIPHER_FEATURE_UNAVAILABLE on an\0A *                      unsupported mode for a cipher.\0A * \5Creturn              A cipher-specific error code on failure.\0A */\0Aint mbedtls_cipher_update(mbedtls_cipher_context_t *ctx,\0A                          const unsigned char *input,\0A                          size_t ilen, unsigned char *output,\0A                          size_t *olen);\0A\0A/**\0A * \5Cbrief               The generic cipher finalization function. If data still\0A *                      needs to be flushed from an incomplete block, the data\0A *                      contained in it is padded to the size of\0A *                      the last block, and written to the \5Cp output buffer.\0A *\0A * \5Cparam ctx           The generic cipher context. This must be initialized and\0A *                      bound to a key.\0A * \5Cparam output        The buffer to write data to. This needs to be a writable\0A *                      buffer of at least block_size Bytes.\0A * \5Cparam olen          The length of the data written to the \5Cp output buffer.\0A *                      This may not be \5Cc NULL.\0A *\0A * \5Creturn              \5Cc 0 on success.\0A * \5Creturn              #MBEDTLS_ERR_CIPHER_BAD_INPUT_DATA on\0A *                      parameter-verification failure.\0A * \5Creturn              #MBEDTLS_ERR_CIPHER_FULL_BLOCK_EXPECTED on decryption\0A *                      expecting a full block but not receiving one.\0A * \5Creturn              #MBEDTLS_ERR_CIPHER_INVALID_PADDING on invalid padding\0A *                      while decrypting.\0A * \5Creturn              A cipher-specific error code on failure.\0A */\0Aint mbedtls_cipher_finish(mbedtls_cipher_context_t *ctx,\0A                          unsigned char *output, size_t *olen);\0A\0A#if defined(MBEDTLS_GCM_C) || defined(MBEDTLS_CHACHAPOLY_C)\0A/**\0A * \5Cbrief               This function writes a tag for AEAD ciphers.\0A *                      Currently supported with GCM and ChaCha20+Poly1305.\0A *                      This must be called after mbedtls_cipher_finish().\0A *\0A * \5Cparam ctx           The generic cipher context. This must be initialized,\0A *                      bound to a key, and have just completed a cipher\0A *                      operation through mbedtls_cipher_finish() the tag for\0A *                      which should be written.\0A * \5Cparam tag           The buffer to write the tag to. This must be a writable\0A *                      buffer of at least \5Cp tag_len Bytes.\0A * \5Cparam tag_len       The length of the tag to write.\0A *\0A * \5Creturn              \5Cc 0 on success.\0A * \5Creturn              A specific error code on failure.\0A */\0Aint mbedtls_cipher_write_tag(mbedtls_cipher_context_t *ctx,\0A                             unsigned char *tag, size_t tag_len);\0A\0A/**\0A * \5Cbrief               This function checks the tag for AEAD ciphers.\0A *                      Currently supported with GCM and ChaCha20+Poly1305.\0A *                      This must be called after mbedtls_cipher_finish().\0A *\0A * \5Cparam ctx           The generic cipher context. This must be initialized.\0A * \5Cparam tag           The buffer holding the tag. This must be a readable\0A *                      buffer of at least \5Cp tag_len Bytes.\0A * \5Cparam tag_len       The length of the tag to check.\0A *\0A * \5Creturn              \5Cc 0 on success.\0A * \5Creturn              A specific error code on failure.\0A */\0Aint mbedtls_cipher_check_tag(mbedtls_cipher_context_t *ctx,\0A                             const unsigned char *tag, size_t tag_len);\0A#endif /* MBEDTLS_GCM_C || MBEDTLS_CHACHAPOLY_C */\0A\0A/**\0A * \5Cbrief               The generic all-in-one encryption/decryption function,\0A *                      for all ciphers except AEAD constructs.\0A *\0A * \5Cparam ctx           The generic cipher context. This must be initialized.\0A * \5Cparam iv            The IV to use, or NONCE_COUNTER for CTR-mode ciphers.\0A *                      This must be a readable buffer of at least \5Cp iv_len\0A *                      Bytes.\0A * \5Cparam iv_len        The IV length for ciphers with variable-size IV.\0A *                      This parameter is discarded by ciphers with fixed-size\0A *                      IV.\0A * \5Cparam input         The buffer holding the input data. This must be a\0A *                      readable buffer of at least \5Cp ilen Bytes.\0A * \5Cparam ilen          The length of the input data in Bytes.\0A * \5Cparam output        The buffer for the output data. This must be able to\0A *                      hold at least `ilen + block_size`. This must not be the\0A *                      same buffer as \5Cp input.\0A * \5Cparam olen          The length of the output data, to be updated with the\0A *                      actual number of Bytes written. This must not be\0A *                      \5Cc NULL.\0A *\0A * \5Cnote                Some ciphers do not use IVs nor nonce. For these\0A *                      ciphers, use \5Cp iv = NULL and \5Cp iv_len = 0.\0A *\0A * \5Creturn              \5Cc 0 on success.\0A * \5Creturn              #MBEDTLS_ERR_CIPHER_BAD_INPUT_DATA on\0A *                      parameter-verification failure.\0A * \5Creturn              #MBEDTLS_ERR_CIPHER_FULL_BLOCK_EXPECTED on decryption\0A *                      expecting a full block but not receiving one.\0A * \5Creturn              #MBEDTLS_ERR_CIPHER_INVALID_PADDING on invalid padding\0A *                      while decrypting.\0A * \5Creturn              A cipher-specific error code on failure.\0A */\0Aint mbedtls_cipher_crypt(mbedtls_cipher_context_t *ctx,\0A                         const unsigned char *iv, size_t iv_len,\0A                         const unsigned char *input, size_t ilen,\0A                         unsigned char *output, size_t *olen);\0A\0A#if defined(MBEDTLS_CIPHER_MODE_AEAD) || defined(MBEDTLS_NIST_KW_C)\0A/**\0A * \5Cbrief               The authenticated encryption (AEAD/NIST_KW) function.\0A *\0A * \5Cnote                For AEAD modes, the tag will be appended to the\0A *                      ciphertext, as recommended by RFC 5116.\0A *                      (NIST_KW doesn't have a separate tag.)\0A *\0A * \5Cparam ctx           The generic cipher context. This must be initialized and\0A *                      bound to a key, with an AEAD algorithm or NIST_KW.\0A * \5Cparam iv            The nonce to use. This must be a readable buffer of\0A *                      at least \5Cp iv_len Bytes and may be \5Cc NULL if \5Cp\0A *                      iv_len is \5Cc 0.\0A * \5Cparam iv_len        The length of the nonce. For AEAD ciphers, this must\0A *                      satisfy the constraints imposed by the cipher used.\0A *                      For NIST_KW, this must be \5Cc 0.\0A * \5Cparam ad            The additional data to authenticate. This must be a\0A *                      readable buffer of at least \5Cp ad_len Bytes, and may\0A *                      be \5Cc NULL is \5Cp ad_len is \5Cc 0.\0A * \5Cparam ad_len        The length of \5Cp ad. For NIST_KW, this must be \5Cc 0.\0A * \5Cparam input         The buffer holding the input data. This must be a\0A *                      readable buffer of at least \5Cp ilen Bytes, and may be\0A *                      \5Cc NULL if \5Cp ilen is \5Cc 0.\0A * \5Cparam ilen          The length of the input data.\0A * \5Cparam output        The buffer for the output data. This must be a\0A *                      writable buffer of at least \5Cp output_len Bytes, and\0A *                      must not be \5Cc NULL.\0A * \5Cparam output_len    The length of the \5Cp output buffer in Bytes. For AEAD\0A *                      ciphers, this must be at least \5Cp ilen + \5Cp tag_len.\0A *                      For NIST_KW, this must be at least \5Cp ilen + 8\0A *                      (rounded up to a multiple of 8 if KWP is used);\0A *                      \5Cp ilen + 15 is always a safe value.\0A * \5Cparam olen          This will be filled with the actual number of Bytes\0A *                      written to the \5Cp output buffer. This must point to a\0A *                      writable object of type \5Cc size_t.\0A * \5Cparam tag_len       The desired length of the authentication tag. For AEAD\0A *                      ciphers, this must match the constraints imposed by\0A *                      the cipher used, and in particular must not be \5Cc 0.\0A *                      For NIST_KW, this must be \5Cc 0.\0A *\0A * \5Creturn              \5Cc 0 on success.\0A * \5Creturn              #MBEDTLS_ERR_CIPHER_BAD_INPUT_DATA on\0A *                      parameter-verification failure.\0A * \5Creturn              A cipher-specific error code on failure.\0A */\0Aint mbedtls_cipher_auth_encrypt_ext(mbedtls_cipher_context_t *ctx,\0A                                    const unsigned char *iv, size_t iv_len,\0A                                    const unsigned char *ad, size_t ad_len,\0A                                    const unsigned char *input, size_t ilen,\0A                                    unsigned char *output, size_t output_len,\0A                                    size_t *olen, size_t tag_len);\0A\0A/**\0A * \5Cbrief               The authenticated encryption (AEAD/NIST_KW) function.\0A *\0A * \5Cnote                If the data is not authentic, then the output buffer\0A *                      is zeroed out to prevent the unauthentic plaintext being\0A *                      used, making this interface safer.\0A *\0A * \5Cnote                For AEAD modes, the tag must be appended to the\0A *                      ciphertext, as recommended by RFC 5116.\0A *                      (NIST_KW doesn't have a separate tag.)\0A *\0A * \5Cparam ctx           The generic cipher context. This must be initialized and\0A *                      bound to a key, with an AEAD algorithm or NIST_KW.\0A * \5Cparam iv            The nonce to use. This must be a readable buffer of\0A *                      at least \5Cp iv_len Bytes and may be \5Cc NULL if \5Cp\0A *                      iv_len is \5Cc 0.\0A * \5Cparam iv_len        The length of the nonce. For AEAD ciphers, this must\0A *                      satisfy the constraints imposed by the cipher used.\0A *                      For NIST_KW, this must be \5Cc 0.\0A * \5Cparam ad            The additional data to authenticate. This must be a\0A *                      readable buffer of at least \5Cp ad_len Bytes, and may\0A *                      be \5Cc NULL is \5Cp ad_len is \5Cc 0.\0A * \5Cparam ad_len        The length of \5Cp ad. For NIST_KW, this must be \5Cc 0.\0A * \5Cparam input         The buffer holding the input data. This must be a\0A *                      readable buffer of at least \5Cp ilen Bytes, and may be\0A *                      \5Cc NULL if \5Cp ilen is \5Cc 0.\0A * \5Cparam ilen          The length of the input data. For AEAD ciphers this\0A *                      must be at least \5Cp tag_len. For NIST_KW this must be\0A *                      at least \5Cc 8.\0A * \5Cparam output        The buffer for the output data. This must be a\0A *                      writable buffer of at least \5Cp output_len Bytes, and\0A *                      may be \5Cc NULL if \5Cp output_len is \5Cc 0.\0A * \5Cparam output_len    The length of the \5Cp output buffer in Bytes. For AEAD\0A *                      ciphers, this must be at least \5Cp ilen - \5Cp tag_len.\0A *                      For NIST_KW, this must be at least \5Cp ilen - 8.\0A * \5Cparam olen          This will be filled with the actual number of Bytes\0A *                      written to the \5Cp output buffer. This must point to a\0A *                      writable object of type \5Cc size_t.\0A * \5Cparam tag_len       The actual length of the authentication tag. For AEAD\0A *                      ciphers, this must match the constraints imposed by\0A *                      the cipher used, and in particular must not be \5Cc 0.\0A *                      For NIST_KW, this must be \5Cc 0.\0A *\0A * \5Creturn              \5Cc 0 on success.\0A * \5Creturn              #MBEDTLS_ERR_CIPHER_BAD_INPUT_DATA on\0A *                      parameter-verification failure.\0A * \5Creturn              #MBEDTLS_ERR_CIPHER_AUTH_FAILED if data is not authentic.\0A * \5Creturn              A cipher-specific error code on failure.\0A */\0Aint mbedtls_cipher_auth_decrypt_ext(mbedtls_cipher_context_t *ctx,\0A                                    const unsigned char *iv, size_t iv_len,\0A                                    const unsigned char *ad, size_t ad_len,\0A                                    const unsigned char *input, size_t ilen,\0A                                    unsigned char *output, size_t output_len,\0A                                    size_t *olen, size_t tag_len);\0A#endif /* MBEDTLS_CIPHER_MODE_AEAD || MBEDTLS_NIST_KW_C */\0A#ifdef __cplusplus\0A}\0A#endif\0A\0A#endif /* MBEDTLS_CIPHER_H */\0A\00" }
