@.str40255 = private global { i64, i64, [1698 x i8] } { i64 -1, i64 1697, [1698 x i8] c"/**\0A * \5Cfile entropy_poll.h\0A *\0A * \5Cbrief Platform-specific and custom entropy polling functions\0A */\0A/*\0A *  Copyright The Mbed TLS Contributors\0A *  SPDX-License-Identifier: Apache-2.0 OR GPL-2.0-or-later\0A */\0A#ifndef MBEDTLS_ENTROPY_POLL_H\0A#define MBEDTLS_ENTROPY_POLL_H\0A\0A#include \22mbedtls/build_info.h\22\0A\0A#include <stddef.h>\0A\0A#ifdef __cplusplus\0Aextern \22C\22 {\0A#endif\0A\0A/*\0A * Default thresholds for built-in sources, in bytes\0A */\0A#define MBEDTLS_ENTROPY_MIN_PLATFORM     32     /**< Minimum for platform source    */\0A#if !defined(MBEDTLS_ENTROPY_MIN_HARDWARE)\0A#define MBEDTLS_ENTROPY_MIN_HARDWARE     32     /**< Minimum for the hardware source */\0A#endif\0A\0A#if !defined(MBEDTLS_NO_PLATFORM_ENTROPY)\0A/**\0A * \5Cbrief           Platform-specific entropy poll callback\0A */\0Aint mbedtls_platform_entropy_poll(void *data,\0A                                  unsigned char *output, size_t len, size_t *olen);\0A#endif\0A\0A#if defined(MBEDTLS_ENTROPY_HARDWARE_ALT)\0A/**\0A * \5Cbrief           Entropy poll callback for a hardware source\0A *\0A * \5Cwarning         This is not provided by Mbed TLS!\0A *                  See \5Cc MBEDTLS_ENTROPY_HARDWARE_ALT in mbedtls_config.h.\0A *\0A * \5Cnote            This must accept NULL as its first argument.\0A */\0Aint mbedtls_hardware_poll(void *data,\0A                          unsigned char *output, size_t len, size_t *olen);\0A#endif\0A\0A#if defined(MBEDTLS_ENTROPY_NV_SEED)\0A/**\0A * \5Cbrief           Entropy poll callback for a non-volatile seed file\0A *\0A * \5Cnote            This must accept NULL as its first argument.\0A */\0Aint mbedtls_nv_seed_poll(void *data,\0A                         unsigned char *output, size_t len, size_t *olen);\0A#endif\0A\0A#ifdef __cplusplus\0A}\0A#endif\0A\0A#endif /* entropy_poll.h */\0A\00" }
