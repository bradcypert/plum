efined in _Standards for Efficient Cryptography_,\0A * _SEC 2: Recommended Elliptic Curve Domain Parameters_.\0A * https://www.secg.org/sec2-v2.pdf\0A */\0A#define PSA_ECC_FAMILY_SECP_R1           ((psa_ecc_family_t) 0x12)\0A/* SECP160R2 (SEC2 v1, obsolete, not supported in Mbed TLS) */\0A#define PSA_ECC_FAMILY_SECP_R2           ((psa_ecc_family_t) 0x1b)\0A\0A/** SEC Koblitz curves over binary fields.\0A *\0A * This family comprises the following curves:\0A * sect163k1, sect233k1, sect239k1, sect283k1, sect409k1, sect571k1.\0A * They are defined in _Standards for Efficient Cryptography_,\0A * _SEC 2: Recommended Elliptic Curve Domain Parameters_.\0A * https://www.secg.org/sec2-v2.pdf\0A *\0A * \5Cnote Mbed TLS does not support any curve in this family.\0A */\0A#define PSA_ECC_FAMILY_SECT_K1           ((psa_ecc_family_t) 0x27)\0A\0A/** SEC random curves over binary fields.\0A *\0A * This family comprises the following curves:\0A * sect163r1, sect233r1, sect283r1, sect409r1, sect571r1.\0A * They are defined in _Standards for Efficient Cryptography_,\0A * _SEC 2: Recommended Elliptic Curve Domain Parameters_.\0A * https://www.secg.org/sec2-v2.pdf\0A *\0A * \5Cnote Mbed TLS does not support any curve in this family.\0A */\0A#define PSA_ECC_FAMILY_SECT_R1           ((psa_ecc_family_t) 0x22)\0A\0A/** SEC additional random curves over binary fields.\0A *\0A * This family comprises the following curve:\0A * sect163r2.\0A * It is defined in _Standards for Efficient Cryptography_,\0A * _SEC 2: Recommended Elliptic Curve Domain Parameters_.\0A * https://www.secg.org/sec2-v2.pdf\0A *\0A * \5Cnote Mbed TLS does not support any curve in this family.\0A */\0A#define PSA_ECC_FAMILY_SECT_R2           ((psa_ecc_family_t) 0x2b)\0A\0A/** Brainpool P random curves.\0A *\0A * This family comprises the following curves:\0A * brainpoolP160r1, brainpoolP192r1, brainpoolP224r1, brainpoolP256r1,\0A * brainpoolP320r1, brainpoolP384r1, brainpoolP512r1.\0A * It is defined in RFC 5639.\0A *\0A * \5Cnote Mbed TLS only supports the 256-bit, 384-bit and 512-bit curves\0A *       in this family.\0A */\0A#define PSA_ECC_FAMILY_BRAINPOOL_P_R1    ((psa_ecc_family_t) 0x30)\0A\0A/** Curve25519 and Curve448.\0A *\0A * This family comprises the following Montgomery curves:\0A * - 255-bit: Bernstein et al.,\0A *   _Curve25519: new Diffie-Hellman speed records_, LNCS 3958, 2006.\0A *   The algorithm #PSA_ALG_ECDH performs X25519 when used with this curve.\0A * - 448-bit: Hamburg,\0A *   _Ed448-Goldilocks, a new elliptic curve_, NIST ECC Workshop, 2015.\0A *   The algorithm #PSA_ALG_ECDH performs X448 when used with this curve.\0A */\0A#define PSA_ECC_FAMILY_MONTGOMERY        ((psa_ecc_family_t) 0x41)\0A\0A/** The twisted Edwards curves Ed25519 and Ed448.\0A *\0A * These curves are suitable for EdDSA (#PSA_ALG_PURE_EDDSA for both curves,\0A * #PSA_ALG_ED25519PH for the 255-bit curve,\0A * #PSA_ALG_ED448PH for the 448-bit curve).\0A *\0A * This family comprises the following twisted Edwards curves:\0A * - 255-bit: Edwards25519, the twisted Edwards curve birationally equivalent\0A *   to Curve25519.\0A *   Bernstein et al., _Twisted Edwards curves_, Africacrypt 2008.\0A * - 448-bit: Edwards448, the twisted Edwards curve birationally equivalent\0A *   to Curve448.\0A *   Hamburg, _Ed448-Goldilocks, a new elliptic curve_, NIST ECC Workshop, 2015.\0A *\0A * \5Cnote Mbed TLS does not support Edwards curves yet.\0A */\0A#define PSA_ECC_FAMILY_TWISTED_EDWARDS   ((psa_ecc_family_t) 0x42)\0A\0A#define PSA_KEY_TYPE_DH_PUBLIC_KEY_BASE             ((psa_key_type_t) 0x4200)\0A#define PSA_KEY_TYPE_DH_KEY_PAIR_BASE               ((psa_key_type_t) 0x7200)\0A#define PSA_KEY_TYPE_DH_GROUP_MASK                  ((psa_key_type_t) 0x00ff)\0A/** Diffie-Hellman key pair.\0A *\0A * \5Cparam group     A value of type ::psa_dh_family_t that identifies the\0A *                  Diffie-Hellman group to be used.\0A */\0A#define PSA_KEY_TYPE_DH_KEY_PAIR(group)          \5C\0A    (PSA_KEY_TYPE_DH_KEY_PAIR_BASE | (group))\0A/** Diffie-Hellman public key.\0A *\0A * \5Cparam group     A value of type ::psa_dh_family_t that identifies the\0A *                  Diffie-Hellman group to be used.\0A */\0A#define PSA_KEY_TYPE_DH_PUBLIC_KEY(group)               \5C\0A    (PSA_KEY_TYPE_DH_PUBLIC_KEY_BASE | (group))\0A\0A/** Whether a key type is a Diffie-Hellman key (pair or public-only). */\0A#define PSA_KEY_TYPE_IS_DH(type)                                        \5C\0A    ((PSA_KEY_TYPE_PUBLIC_KEY_OF_KEY_PAIR(type) &                        \5C\0A      ~PSA_KEY_TYPE_DH_GROUP_MASK) == PSA_KEY_TYPE_DH_PUBLIC_KEY_BASE)\0A/** Whether a key type is a Diffie-Hellman key pair. */\0A#define PSA_KEY_TYPE_IS_DH_KEY_PAIR(type)                               \5C\0A    (((type) & ~PSA_KEY_TYPE_DH_GROUP_MASK) ==                         \5C\0A     PSA_KEY_TYPE_DH_KEY_PAIR_BASE)\0A/** Whether a key type is a Diffie-Hellman public key. */\0A#define PSA_KEY_TYPE_IS_DH_PUBLIC_KEY(type)                            \5C\0A    (((type) & ~PSA_KEY_TYPE_DH_GROUP_MASK) ==                         \5C\0A     PSA_KEY_TYPE_DH_PUBLIC_KEY_BASE)\0A\0A/** Extract the group from a Diffie-Hellman key type. */\0A#define PSA_KEY_TYPE_DH_GET_FAMILY(type)                        \5C\0A    ((psa_dh_family_t) (PSA_KEY_TYPE_IS_DH(type) ?              \5C\0A                        ((type) & PSA_KEY_TYPE_DH_GROUP_MASK) :  \5C\0A                        0))\0A\0A/** Diffie-Hellman groups defined in RFC 7919 Appendix A.\0A *\0A * This family includes groups with the following key sizes (in bits):\0A * 2048, 3072, 4096, 6144, 8192. A given implementation may support\0A * all of these sizes or only a subset.\0A */\0A#define PSA_DH_FAMILY_RFC7919            ((psa_dh_family_t) 0x03)\0A\0A#define PSA_GET_KEY_TYPE_BLOCK_SIZE_EXPONENT(type)      \5C\0A    (((type) >> 8) & 7)\0A/** The block size of a block cipher.\0A *\0A * \5Cparam type  A cipher key type (value of type #psa_key_type_t).\0A *\0A * \5Creturn      The block size for a block cipher, or 1 for a stream cipher.\0A *              The return value is undefined if \5Cp type is not a supported\0A *              cipher key type.\0A *\0A * \5Cnote It is possible to build stream cipher algorithms on top of a block\0A *       cipher, for example CTR mode (#PSA_ALG_CTR).\0A *       This macro only takes the key type into account, so it cannot be\0A *       used to determine the size of the data that #psa_cipher_update()\0A *       might buffer for future processing in general.\0A *\0A * \5Cnote This macro returns a compile-time constant if its argument is one.\0A *\0A * \5Cwarning This macro may evaluate its argument multiple times.\0A */\0A#define PSA_BLOCK_CIPHER_BLOCK_LENGTH(type)                                     \5C\0A    (((type) & PSA_KEY_TYPE_CATEGORY_MASK) == PSA_KEY_TYPE_CATEGORY_SYMMETRIC ? \5C\0A     1u << PSA_GET_KEY_TYPE_BLOCK_SIZE_EXPONENT(type) :                         \5C\0A        0u)\0A\0A/* Note that algorithm values are embedded in the persistent key store,\0A * as part of key metadata. As a consequence, they must not be changed\0A * (unless the storage format version changes).\0A */\0A\0A/** Vendor-defined algorithm flag.\0A *\0A * Algorithms defined by this standard will never have the #PSA_ALG_VENDOR_FLAG\0A * bit set. Vendors who define additional algorithms must use an encoding with\0A * the #PSA_ALG_VENDOR_FLAG bit set and should respect the bitwise structure\0A * used by standard encodings whenever practical.\0A */\0A#define PSA_ALG_VENDOR_FLAG                     ((psa_algorithm_t) 0x80000000)\0A\0A#define PSA_ALG_CATEGORY_MASK                   ((psa_algorithm_t) 0x7f000000)\0A#define PSA_ALG_CATEGORY_HASH                   ((psa_algorithm_t) 0x02000000)\0A#define PSA_ALG_CATEGORY_MAC                    ((psa_algorithm_t) 0x03000000)\0A#define PSA_ALG_CATEGORY_CIPHER                 ((psa_algorithm_t) 0x04000000)\0A#define PSA_ALG_CATEGORY_AEAD                   ((psa_algorithm_t) 0x05000000)\0A#define PSA_ALG_CATEGORY_SIGN                   ((psa_algorithm_t) 0x06000000)\0A#define PSA_ALG_CATEGORY_ASYMMETRIC_ENCRYPTION  ((psa_algorithm_t) 0x07000000)\0A#define PSA_ALG_CATEGORY_KEY_DERIVATION         ((psa_algorithm_t) 0x08000000)\0A#define PSA_ALG_CATEGORY_KEY_AGREEMENT          ((psa_algorithm_t) 0x09000000)\0A\0A/** Whether an algorithm is vendor-defined.\0A *\0A * See also #PSA_ALG_VENDOR_FLAG.\0A */\0A#define PSA_ALG_IS_VENDOR_DEFINED(alg)                                  \5C\0A    (((alg) & PSA_ALG_VENDOR_FLAG) != 0)\0A\0A/** Whether the specified algorithm is a hash algorithm.\0A *\0A * \5Cparam alg An algorithm identifier (value of type #psa_algorithm_t).\0A *\0A * \5Creturn 1 if \5Cp alg is a hash algorithm, 0 otherwise.\0A *         This macro may return either 0 or 1 if \5Cp alg is not a supported\0A *         algorithm identifier.\0A */\0A#define PSA_ALG_IS_HASH(alg)                                            \5C\0A    (((alg) & PSA_ALG_CATEGORY_MASK) == PSA_ALG_CATEGORY_HASH)\0A\0A/** Whether the specified algorithm is a MAC algorithm.\0A *\0A * \5Cparam alg An algorithm identifier (value of type #psa_algorithm_t).\0A *\0A * \5Creturn 1 if \5Cp alg is a MAC algorithm, 0 otherwise.\0A *         This macro may return either 0 or 1 if \5Cp alg is not a supported\0A *         algorithm identifier.\0A */\0A#define PSA_ALG_IS_MAC(alg)                                             \5C\0A    (((alg) & PSA_ALG_CATEGORY_MASK) == PSA_ALG_CATEGORY_MAC)\0A\0A/** Whether the specified algorithm is a symmetric cipher algorithm.\0A *\0A * \5Cparam alg An algorithm identifier (value of type #psa_algorithm_t).\0A *\0A * \5Creturn 1 if \5Cp alg is a symmetric cipher algorithm, 0 otherwise.\0A *         This macro may return either 0 or 1 if \5Cp alg is not a supported\0A *         algorithm identifier.\0A */\0A#define PSA_ALG_IS_CIPHER(alg)                                          \5C\0A    (((alg) & PSA_ALG_CATEGORY_MASK) == PSA_ALG_CATEGORY_CIPHER)\0A\0A/** Whether the specified algorithm is an authenticated encryption\0A * with associated data (AEAD) algorithm.\0A *\0A * \5Cparam alg An algorithm identifier (value of type #psa_algorithm_t).\0A *\0A * \5Creturn 1 if \5Cp alg is an AEAD algorithm, 0 otherwise.\0A *         This macro may return either 0 or 1 if \5Cp alg is not a supported\0A *         algorithm identifier.\0A */\0A#define PSA_ALG_IS_AEAD(alg)                                            \5C\0A    (((alg) & PSA_ALG_CATEGORY_MASK) == PSA_ALG_CATEGORY_AEAD)\0A\0A/** Whether the specified algorithm is an asymmetric signature algorithm,\0A * also known as public-key signature algorithm.\0A *\0A * \5Cparam alg An algorithm identifier (value of type #psa_algorithm_t).\0A *\0A * \5Creturn 1 if \5Cp alg is an asymmetric signature algorithm, 0 otherwise.\0A *         This macro may return either 0 or 1 if \5Cp alg is not a supported\0A *         algorithm identifier.\0A */\0A#define PSA_ALG_IS_SIGN(alg)                                            \5C\0A    (((alg) & PSA_ALG_CATEGORY_MASK) == PSA_ALG_CATEGORY_SIGN)\0A\0A/** Whether the specified algorithm is an asymmetric encryption algorithm,\0A * also known as public-key encryption algorithm.\0A *\0A * \5Cparam alg An algorithm identifier (value of type #psa_algorithm_t).\0A *\0A * \5Creturn 1 if \5Cp alg is an asymmetric encryption algorithm, 0 otherwise.\0A *         This macro may return either 0 or 1 if \5Cp alg is not a supported\0A *         algorithm identifier.\0A */\0A#define PSA_ALG_IS_ASYMMETRIC_ENCRYPTION(alg)                           \5C\0A    (((alg) & PSA_ALG_CATEGORY_MASK) == PSA_ALG_CATEGORY_ASYMMETRIC_ENCRYPTION)\0A\0A/** Whether the specified algorithm is a key agreement algorithm.\0A *\0A * \5Cparam alg An algorithm identifier (value of type #psa_algorithm_t).\0A *\0A * \5Creturn 1 if \5Cp alg is a key agreement algorithm, 0 otherwise.\0A *         This macro may return either 0 or 1 if \5Cp alg is not a supported\0A *         algorithm identifier.\0A */\0A#define PSA_ALG_IS_KEY_AGREEMENT(alg)                                   \5C\0A    (((alg) & PSA_ALG_CATEGORY_MASK) == PSA_ALG_CATEGORY_KEY_AGREEMENT)\0A\0A/** Whether the specified algorithm is a key derivation algorithm.\0A *\0A * \5Cparam alg An algorithm identifier (value of type #psa_algorithm_t).\0A *\0A * \5Creturn 1 if \5Cp alg is a key derivation algorithm, 0 otherwise.\0A *         This macro may return either 0 or 1 if \5Cp alg is not a supported\0A *         algorithm identifier.\0A */\0A#define PSA_ALG_IS_KEY_DERIVATION(alg)                                  \5C\0A    (((alg) & PSA_ALG_CATEGORY_MASK) == PSA_ALG_CATEGORY_KEY_DERIVATION)\0A\0A/** Whether the specified algorithm is a key stretching / password hashing\0A * algorithm.\0A *\0A * A key stretching / password hashing algorithm is a key derivation algorithm\0A * that is suitable for use with a low-entropy secret such as a password.\0A * Equivalently, it's a key derivation algorithm that uses a\0A * #PSA_KEY_DERIVATION_INPUT_PASSWORD input step.\0A *\0A * \5Cparam alg An algorithm identifier (value of type #psa_algorithm_t).\0A *\0A * \5Creturn 1 if \5Cp alg is a key stretching / password hashing algorithm, 0\0A *         otherwise. This macro may return either 0 or 1 if \5Cp alg is not a\0A *         supported algorithm identifier.\0A */\0A#define PSA_ALG_IS_KEY_DERIVATION_STRETCHING(alg)                                  \5C\0A    (PSA_ALG_IS_KEY_DERIVATION(alg) &&              \5C\0A     (alg) & PSA_ALG_KEY_DERIVATION_STRETCHING_FLAG)\0A\0A/** An invalid algorithm identifier value. */\0A/* *INDENT-OFF* (https://github.com/ARM-software/psa-arch-tests/issues/337) */\0A#define PSA_ALG_NONE                            ((psa_algorithm_t)0)\0A/* *INDENT-ON* */\0A\0A#define PSA_ALG_HASH_MASK                       ((psa_algorithm_t) 0x000000ff)\0A/** MD5 */\0A#define PSA_ALG_MD5                             ((psa_algorithm_t) 0x02000003)\0A/** PSA_ALG_RIPEMD160 */\0A#define PSA_ALG_RIPEMD160                       ((psa_algorithm_t) 0x02000004)\0A/** SHA1 */\0A#define PSA_ALG_SHA_1                           ((psa_algorithm_t) 0x02000005)\0A/** SHA2-224 */\0A#define PSA_ALG_SHA_224                         ((psa_algorithm_t) 0x02000008)\0A/** SHA2-256 */\0A#define PSA_ALG_SHA_256                         ((psa_algorithm_t) 0x02000009)\0A/** SHA2-384 */\0A#define PSA_ALG_SHA_384                         ((psa_algorithm_t) 0x0200000a)\0A/** SHA2-512 */\0A#define PSA_ALG_SHA_512                         ((psa_algorithm_t) 0x0200000b)\0A/** SHA2-512/224 */\0A#define PSA_ALG_SHA_512_224                     ((psa_algorithm_t) 0x0200000c)\0A/** SHA2-512/256 */\0A#define PSA_ALG_SHA_512_256                     ((psa_algorithm_t) 0x0200000d)\0A/** SHA3-224 */\0A#define PSA_ALG_SHA3_224                        ((psa_algorithm_t) 0x02000010)\0A/** SHA3-256 */\0A#define PSA_ALG_SHA3_256                        ((psa_algorithm_t) 0x02000011)\0A/** SHA3-384 */\0A#define PSA_ALG_SHA3_384                        ((psa_algorithm_t) 0x02000012)\0A/** SHA3-512 */\0A#define PSA_ALG_SHA3_512                        ((psa_algorithm_t) 0x02000013)\0A/** The first 512 bits (64 bytes) of the SHAKE256 output.\0A *\0A * This is the prehashing for Ed448ph (see #PSA_ALG_ED448PH). For other\0A * scenarios where a hash function based on SHA3/SHAKE is desired, SHA3-512\0A * has the same output size and a (theoretically) higher security strength.\0A */\0A#define PSA_ALG_SHAKE256_512                    ((psa_algorithm_t) 0x02000015)\0A\0A/** In a hash-and-sign algorithm policy, allow any hash algorithm.\0A *\0A * This value may be used to form the algorithm usage field of a policy\0A * for a signature algorithm that is parametrized by a hash. The key\0A * may then be used to perform operations using the same signature\0A * algorithm parametrized with any supported hash.\0A *\0A * That is, suppose that `PSA_xxx_SIGNATURE` is one of the following macros:\0A * - #PSA_ALG_RSA_PKCS1V15_SIGN, #PSA_ALG_RSA_PSS, #PSA_ALG_RSA_PSS_ANY_SALT,\0A * - #PSA_ALG_ECDSA, #PSA_ALG_DETERMINISTIC_ECDSA.\0A * Then you may create and use a key as follows:\0A * - Set the key usage field using #PSA_ALG_ANY_HASH, for example:\0A *   ```\0A *   psa_set_key_usage_flags(&attributes, PSA_KEY_USAGE_SIGN_HASH); // or VERIFY\0A *   psa_set_key_algorithm(&attributes, PSA_xxx_SIGNATURE(PSA_ALG_ANY_HASH));\0A *   ```\0A * - Import or generate key material.\0A * - Call psa_sign_hash() or psa_verify_hash(), passing\0A *   an algorithm built from `PSA_xxx_SIGNATURE` and a specific hash. Each\0A *   call to sign or verify a message may use a different hash.\0A *   ```\0A *   psa_sign_hash(key, PSA_xxx_SIGNATURE(PSA_ALG_SHA_256), ...);\0A *   psa_sign_hash(key, PSA_xxx_SIGNATURE(PSA_ALG_SHA_512), ...);\0A *   psa_sign_hash(key, PSA_xxx_SIGNATURE(PSA_ALG_SHA3_256), ...);\0A *   ```\0A *\0A * This value may not be used to build other algorithms that are\0A * parametrized over a hash. For any valid use of this macro to build\0A * an algorithm \5Cc alg, #PSA_ALG_IS_HASH_AND_SIGN(\5Cc alg) is true.\0A *\0A * This value may not be used to build an algorithm specification to\0A * perform an operation. It is only valid to build policies.\0A */\0A#define PSA_ALG_ANY_HASH                        ((psa_algorithm_t) 0x020000ff)\0A\0A#define PSA_ALG_MAC_SUBCATEGORY_MASK            ((psa_algorithm_t) 0x00c00000)\0A#define PSA_ALG_HMAC_BASE                       ((psa_algorithm_t) 0x03800000)\0A/** Macro to build an HMAC algorithm.\0A *\0A * For example, #PSA_ALG_HMAC(#PSA_ALG_SHA_256) is HMAC-SHA-256.\0A *\0A * \5Cparam hash_alg      A hash algorithm (\5Cc PSA_ALG_XXX value such that\0A *                      #PSA_ALG_IS_HASH(\5Cp hash_alg) is true).\0A *\0A * \5Creturn              The corresponding HMAC algorithm.\0A * \5Creturn              Unspecified if \5Cp hash_alg is not a supported\0A *                      hash algorithm.\0A */\0A#define PSA_ALG_HMAC(hash_alg)                                  \5C\0A    (PSA_ALG_HMAC_BASE | ((hash_alg) & PSA_ALG_HASH_MASK))\0A\0A#define PSA_ALG_HMAC_GET_HASH(hmac_alg)                             \5C\0A    (PSA_ALG_CATEGORY_HASH | ((hmac_alg) & PSA_ALG_HASH_MASK))\0A\0A/** Whether the specified algorithm is an HMAC algorithm.\0A *\0A * HMAC is a family of MAC algorithms that are based on a hash function.\0A *\0A * \5Cparam alg An algorithm identifier (value of type #psa_algorithm_t).\0A *\0A * \5Creturn 1 if \5Cp alg is an HMAC algorithm, 0 otherwise.\0A *         This macro may return either 0 or 1 if \5Cp alg is not a supported\0A *         algorithm identifier.\0A */\0A#define PSA_ALG_IS_HMAC(alg)                                            \5C\0A    (((alg) & (PSA_ALG_CATEGORY_MASK | PSA_ALG_MAC_SUBCATEGORY_MASK)) == \5C\0A     PSA_ALG_HMAC_BASE)\0A\0A/* In the encoding of a MAC algorithm, the bits corresponding to\0A * PSA_ALG_MAC_TRUNCATION_MASK encode the length to which the MAC is\0A * truncated. As an exception, the value 0 means the untruncated algorithm,\0A * whatever its length is. The length is encoded in 6 bits, so it can\0A * reach up to 63; the largest MAC is 64 bytes so its trivial truncation\0A * to full length is correctly encoded as 0 and any non-trivial truncation\0A * is correctly encoded as a value between 1 and 63. */\0A#define PSA_ALG_MAC_TRUNCATION_MASK             ((psa_algorithm_t) 0x003f0000)\0A#define PSA_MAC_TRUNCATION_OFFSET 16\0A\0A/* In the encoding of a MAC algorithm, the bit corresponding to\0A * #PSA_ALG_MAC_AT_LEAST_THIS_LENGTH_FLAG encodes the fact that the algorithm\0A * is a wildcard algorithm. A key with such wildcard algorithm as permitted\0A * algorithm policy can be used with any algorithm corresponding to the\0A * same base class and having a (potentially truncated) MAC length greater or\0A * equal than the one encoded in #PSA_ALG_MAC_TRUNCATION_MASK. */\0A#define PSA_ALG_MAC_AT_LEAST_THIS_LENGTH_FLAG   ((psa_algorithm_t) 0x00008000)\0A\0A/** Macro to build a truncated MAC algorithm.\0A *\0A * A truncated MAC algorithm is identical to the corresponding MAC\0A * algorithm except that the MAC value for the truncated algorithm\0A * consists of only the first \5Cp mac_length bytes of the MAC value\0A * for the untruncated algorithm.\0A *\0A * \5Cnote    This macro may allow constructing algorithm identifiers that\0A *          are not valid, either because the specified length is larger\0A *          than the untruncated MAC or because the specified length is\0A *          smaller than permitted by the implementation.\0A *\0A * \5Cnote    It is implementation-defined whether a truncated MAC that\0A *          is truncated to the same length as the MAC of the untruncated\0A *          algorithm is considered identical to the untruncated algorithm\0A *          for policy comparison purposes.\0A *\0A * \5Cparam mac_alg       A MAC algorithm identifier (value of type\0A *                      #psa_algorithm_t such that #PSA_ALG_IS_MAC(\5Cp mac_alg)\0A *                      is true). This may be a truncated or untruncated\0A *                      MAC algorithm.\0A * \5Cparam mac_length    Desired length of the truncated MAC in bytes.\0A *                      This must be at most the full length of the MAC\0A *                      and must be at least an implementation-specified\0A *                      minimum. The implementation-specified minimum\0A *                      shall not be zero.\0A *\0A * \5Creturn              The corresponding MAC algorithm with the specified\0A *                      length.\0A * \5Creturn              Unspecified if \5Cp mac_alg is not a supported\0A *                      MAC algorithm or if \5Cp mac_length is too small or\0A *                      too large for the specified MAC algorithm.\0A */\0A#define PSA_ALG_TRUNCATED_MAC(mac_alg, mac_length)              \5C\0A    (((mac_alg) & ~(PSA_ALG_MAC_TRUNCATION_MASK |               \5C\0A                    PSA_ALG_MAC_AT_LEAST_THIS_LENGTH_FLAG)) |   \5C\0A     ((mac_length) << PSA_MAC_TRUNCATION_OFFSET & PSA_ALG_MAC_TRUNCATION_MASK))\0A\0A/** Macro to build the base MAC algorithm corresponding to a truncated\0A * MAC algorithm.\0A *\0A * \5Cparam mac_alg       A MAC algorithm identifier (value of type\0A *                      #psa_algorithm_t such that #PSA_ALG_IS_MAC(\5Cp mac_alg)\0A *                      is true). This may be a truncated or untruncated\0A *                      MAC algorithm.\0A *\0A * \5Creturn              The corresponding base MAC algorithm.\0A * \5Creturn              Unspecified if \5Cp mac_alg is not a supported\0A *                      MAC algorithm.\0A */\0A#define PSA_ALG_FULL_LENGTH_MAC(mac_alg)                        \5C\0A    ((mac_alg) & ~(PSA_ALG_MAC_TRUNCATION_MASK |                \5C\0A                   PSA_ALG_MAC_AT_LEAST_THIS_LENGTH_FLAG))\0A\0A/** Length to which a MAC algorithm is truncated.\0A *\0A * \5Cparam mac_alg       A MAC algorithm identifier (value of type\0A *                      #psa_algorithm_t such that #PSA_ALG_IS_MAC(\5Cp mac_alg)\0A *                      is true).\0A *\0A * \5Creturn              Length of the truncated MAC in bytes.\0A * \5Creturn              0 if \5Cp mac_alg is a non-truncated MAC algorithm.\0A * \5Creturn              Unspecified if \5Cp mac_alg is not a supported\0A *                      MAC algorithm.\0A */\0A#define PSA_MAC_TRUNCATED_LENGTH(mac_alg)                               \5C\0A    (((mac_alg) & PSA_ALG_MAC_TRUNCATION_MASK) >> PSA_MAC_TRUNCATION_OFFSET)\0A\0A/** Macro to build a MAC minimum-MAC-length wildcard algorithm.\0A *\0A * A minimum-MAC-length MAC wildcard algorithm permits all MAC algorithms\0A * sharing the same base algorithm, and where the (potentially truncated) MAC\0A * length of the specific algorithm is equal to or larger then the wildcard\0A * algorithm's minimum MAC length.\0A *\0A * \5Cnote    When setting the minimum required MAC length to less than the\0A *          smallest MAC length allowed by the base algorithm, this effectively\0A *          becomes an 'any-MAC-length-allowed' policy for that base algorithm.\0A *\0A * \5Cparam mac_alg         A MAC algorithm identifier (value of type\0A *                        #psa_algorithm_t such that #PSA_ALG_IS_MAC(\5Cp mac_alg)\0A *                        is true).\0A * \5Cparam min_mac_length  Desired minimum length of the message authentication\0A *                        code in bytes. This must be at most the untruncated\0A *                        length of the MAC and must be at least 1.\0A *\0A * \5Creturn                The corresponding MAC wildcard algorithm with the\0A *                        specified minimum length.\0A * \5Creturn                Unspecified if \5Cp mac_alg is not a supported MAC\0A *                        algorithm or if \5Cp min_mac_length is less than 1 or\0A *                        too large for the specified MAC algorithm.\0A */\0A#define PSA_ALG_AT_LEAST_THIS_LENGTH_MAC(mac_alg, min_mac_length)   \5C\0A    (PSA_ALG_TRUNCATED_MAC(mac_alg, min_mac_length) |              \5C\0A     PSA_ALG_MAC_AT_LEAST_THIS_LENGTH_FLAG)\0A\0A#define PSA_ALG_CIPHER_MAC_BASE                 ((psa_algorithm_t) 0x03c00000)\0A/** The CBC-MAC construction over a block cipher\0A *\0A * \5Cwarning CBC-MAC is insecure in many cases.\0A * A more secure mode, such as #PSA_ALG_CMAC, is recommended.\0A */\0A#define PSA_ALG_CBC_MAC                         ((psa_algorithm_t) 0x03c00100)\0A/** The CMAC construction over a block cipher */\0A#define PSA_ALG_CMAC                            ((psa_algorithm_t) 0x03c00200)\0A\0A/** Whether the specified algorithm is a MAC algorithm based on a block cipher.\0A *\0A * \5Cparam alg An algorithm identifier (value of type #psa_algorithm_t).\0A *\0A * \5Creturn 1 if \5Cp alg is a MAC algorithm based on a block cipher, 0 otherwise.\0A *         This macro may return either 0 or 1 if \5Cp alg is not a supported\0A *         algorithm identifier.\0A */\0A#define PSA_ALG_IS_BLOCK_CIPHER_MAC(alg)                                \5C\0A    (((alg) & (PSA_ALG_CATEGORY_MASK | PSA_ALG_MAC_SUBCATEGORY_MASK)) == \5C\0A     PSA_ALG_CIPHER_MAC_BASE)\0A\0A#define PSA_ALG_CIPHER_STREAM_FLAG              ((psa_algorithm_t) 0x00800000)\0A#define PSA_ALG_CIPHER_FROM_BLOCK_FLAG          ((psa_algorithm_t) 0x00400000)\0A\0A/** Whether the specified algorithm is a stream cipher.\0A *\0A * A stream cipher is a symmetric cipher that encrypts or decrypts messages\0A * by applying a bitwise-xor with a stream of bytes that is generated\0A * from a key.\0A *\0A * \5Cparam alg An algorithm identifier (value of type #psa_algorithm_t).\0A *\0A * \5Creturn 1 if \5Cp alg is a stream cipher algorithm, 0 otherwise.\0A *         This macro may return either 0 or 1 if \5Cp alg is not a supported\0A *         algorithm identifier or if it is not a symmetric cipher algorithm.\0A */\0A#define PSA_ALG_IS_STREAM_CIPHER(alg)            \5C\0A    (((alg) & (PSA_ALG_CATEGORY_MASK | PSA_ALG_CIPHER_STREAM_FLAG)) == \5C\0A     (PSA_ALG_CATEGORY_CIPHER | PSA_ALG_CIPHER_STREAM_FLAG))\0A\0A/** The stream cipher mode of a stream cipher algorithm.\0A *\0A * The underlying stream cipher is determined by the key type.\0A * - To use ChaCha20, use a key type of #PSA_KEY_TYPE_CHACHA20.\0A */\0A#define PSA_ALG_STREAM_CIPHER                   ((psa_algorithm_t) 0x04800100)\0A\0A/** The CTR stream cipher mode.\0A *\0A * CTR is a stream cipher which is built from a block cipher.\0A * The underlying block cipher is determined by the key type.\0A * For example, to use AES-128-CTR, use this algorithm with\0A * a key of type #PSA_KEY_TYPE_AES and a length of 128 bits (16 bytes).\0A */\0A#define PSA_ALG_CTR                             ((psa_algorithm_t) 0x04c01000)\0A\0A/** The CFB stream cipher mode.\0A *\0A * The underlying block cipher is determined by the key type.\0A */\0A#define PSA_ALG_CFB                             ((psa_algorithm_t) 0x04c01100)\0A\0A/** The OFB stream cipher mode.\0A *\0A * The underlying block cipher is determined by the key type.\0A */\0A#define PSA_ALG_OFB                             ((psa_algorithm_t) 0x04c01200)\0A\0A/** The XTS cipher mode.\0A *\0A * XTS is a cipher mode which is built from a block cipher. It requires at\0A * least one full block of input, but beyond this minimum the input\0A * does not need to be a whole number of blocks.\0A */\0A#define PSA_ALG_XTS                             ((psa_algorithm_t) 0x0440ff00)\0A\0A/** The Electronic Code Book (ECB) mode of a block cipher, with no padding.\0A *\0A * \5Cwarning ECB mode does not protect the confidentiality of the encrypted data\0A * except in extremely narrow circumstances. It is recommended that applications\0A * only use ECB if they need to construct an operating mode that the\0A * implementation does not provide. Implementations are encouraged to provide\0A * the modes that applications need in preference to supporting direct access\0A * to ECB.\0A *\0A * The underlying block cipher is determined by the key type.\0A *\0A * This symmetric cipher mode can only be used with messages whose lengths are a\0A * multiple of the block size of the chosen block cipher.\0A *\0A * ECB mode does not accept an initialization vector (IV). When using a\0A * multi-part cipher operation with this algorithm, psa_cipher_generate_iv()\0A * and psa_cipher_set_iv() must not be called.\0A */\0A#define PSA_ALG_ECB_NO_PADDING                  ((psa_algorithm_t) 0x04404400)\0A\0A/** The CBC block cipher chaining mode, with no padding.\0A *\0A * The underlying block cipher is determined by the key type.\0A *\0A * This symmetric cipher mode can only be used with messages whose lengths\0A * are whole number of blocks for the chosen block cipher.\0A */\0A#define PSA_ALG_CBC_NO_PADDING                  ((psa_algorithm_t) 0x04404000)\0A\0A/** The CBC block cipher chaining mode with PKCS#7 padding.\0A *\0A * The underlying block cipher is determined by the key type.\0A *\0A * This is the padding method defined by PKCS#7 (RFC 2315) &sect;10.3.\0A */\0A#define PSA_ALG_CBC_PKCS7                       ((psa_algorithm_t) 0x04404100)\0A\0A#define PSA_ALG_AEAD_FROM_BLOCK_FLAG            ((psa_algorithm_t) 0x00400000)\0A\0A/** Whether the specified algorithm is an AEAD mode on a block cipher.\0A *\0A * \5Cparam alg An algorithm identifier (value of type #psa_algorithm_t).\0A *\0A * \5Creturn 1 if \5Cp alg is an AEAD algorithm which is an AEAD mode based on\0A *         a block cipher, 0 otherwise.\0A *         This macro may return either 0 or 1 if \5Cp alg is not a supported\0A *         algorithm identifier.\0A */\0A#define PSA_ALG_IS_AEAD_ON_BLOCK_CIPHER(alg)    \5C\0A    (((alg) & (PSA_ALG_CATEGORY_MASK | PSA_ALG_AEAD_FROM_BLOCK_FLAG)) == \5C\0A     (PSA_ALG_CATEGORY_AEAD | PSA_ALG_AEAD_FROM_BLOCK_FLAG))\0A\0A/** The CCM authenticated encryption algorithm.\0A *\0A * The underlying block cipher is determined by the key type.\0A */\0A#define PSA_ALG_CCM                             ((psa_algorithm_t) 0x05500100)\0A\0A/** The CCM* cipher mode without authentication.\0A *\0A * This is CCM* as specified in IEEE 802.15.4 §7, with a tag length of 0.\0A * For CCM* with a nonzero tag length, use the AEAD algorithm #PSA_ALG_CCM.\0A *\0A * The underlying block cipher is determined by the key type.\0A *\0A * Currently only 13-byte long IV's are supported.\0A */\0A#define PSA_ALG_CCM_STAR_NO_TAG                 ((psa_algorithm_t) 0x04c01300)\0A\0A/** The GCM authenticated encryption algorithm.\0A *\0A * The underlying block cipher is determined by the key type.\0A */\0A#define PSA_ALG_GCM                             ((psa_algorithm_t) 0x05500200)\0A\0A/** The Chacha20-Poly1305 AEAD algorithm.\0A *\0A * The ChaCha20_Poly1305 construction is defined in RFC 7539.\0A *\0A * Implementations must support 12-byte nonces, may support 8-byte nonces,\0A * and should reject other sizes.\0A *\0A * Implementations must support 16-byte tags and should reject other sizes.\0A */\0A#define PSA_ALG_CHACHA20_POLY1305               ((psa_algorithm_t) 0x05100500)\0A\0A/* In the encoding of an AEAD algorithm, the bits corresponding to\0A * PSA_ALG_AEAD_TAG_LENGTH_MASK encode the length of the AEAD tag.\0A * The constants for default lengths follow this encoding.\0A */\0A#define PSA_ALG_AEAD_TAG_LENGTH_MASK            ((psa_algorithm_t) 0x003f0000)\0A#define PSA_AEAD_TAG_LENGTH_OFFSET 16\0A\0A/* In the encoding of an AEAD algorithm, the bit corresponding to\0A * #PSA_ALG_AEAD_AT_LEAST_THIS_LENGTH_FLAG encodes the fact that the algorithm\0A * is a wildcard algorithm. A key with such wildcard algorithm as permitted\0A * algorithm policy can be used with any algorithm corresponding to the\0A * same base class and having a tag length greater than or equal to the one\0A * encoded in #PSA_ALG_AEAD_TAG_LENGTH_MASK. */\0A#define PSA_ALG_AEAD_AT_LEAST_THIS_LENGTH_FLAG  ((psa_algorithm_t) 0x00008000)\0A\0A/** Macro to build a shortened AEAD algorithm.\0A *\0A * A shortened AEAD algorithm is similar to the corresponding AEAD\0A * algorithm, but has an authentication tag that consists of fewer bytes.\0A * Depending on the algorithm, the tag length may affect the calculation\0A * of the ciphertext.\0A *\0A * \5Cparam aead_alg      An AEAD algorithm identifier (value of type\0A *                      #psa_algorithm_t such that #PSA_ALG_IS_AEAD(\5Cp aead_alg)\0A *                      is true).\0A * \5Cparam tag_length    Desired length of the authentication tag in bytes.\0A *\0A * \5Creturn              The corresponding AEAD algorithm with the specified\0A *                      length.\0A * \5Creturn              Unspecified if \5Cp aead_alg is not a supported\0A *                      AEAD algorithm or if \5Cp tag_length is not valid\0A *                      for the specified AEAD algorithm.\0A */\0A#define PSA_ALG_AEAD_WITH_SHORTENED_TAG(aead_alg, tag_length)           \5C\0A    (((aead_alg) & ~(PSA_ALG_AEAD_TAG_LENGTH_MASK |                     \5C\0A                     PSA_ALG_AEAD_AT_LEAST_THIS_LENGTH_FLAG)) |         \5C\0A     ((tag_length) << PSA_AEAD_TAG_LENGTH_OFFSET &                      \5C\0A        PSA_ALG_AEAD_TAG_LENGTH_MASK))\0A\0A/** Retrieve the tag length of a specified AEAD algorithm\0A *\0A * \5Cparam aead_alg      An AEAD algorithm identifier (value of type\0A *                      #psa_algorithm_t such that #PSA_ALG_IS_AEAD(\5Cp aead_alg)\0A *                      is true).\0A *\0A * \5Creturn              The tag length specified by the input algorithm.\0A * \5Creturn              Unspecified if \5Cp aead_alg is not a supported\0A *                      AEAD algorithm.\0A */\0A#define PSA_ALG_AEAD_GET_TAG_LENGTH(aead_alg)                           \5C\0A    (((aead_alg) & PSA_ALG_AEAD_TAG_LENGTH_MASK) >>                     \5C\0A     PSA_AEAD_TAG_LENGTH_OFFSET)\0A\0A/** Calculate the corresponding AEAD algorithm with the default tag length.\0A *\0A * \5Cparam aead_alg      An AEAD algorithm (\5Cc PSA_ALG_XXX value such that\0A *                      #PSA_ALG_IS_AEAD(\5Cp aead_alg) is true).\0A *\0A * \5Creturn              The corresponding AEAD algorithm with the default\0A *                      tag length for that algorithm.\0A */\0A#define PSA_ALG_AEAD_WITH_DEFAULT_LENGTH_TAG(aead_alg)                   \5C\0A    (                                                                    \5C\0A        PSA_ALG_AEAD_WITH_DEFAULT_LENGTH_TAG_CASE(aead_alg, PSA_ALG_CCM) \5C\0A        PSA_ALG_AEAD_WITH_DEFAULT_LENGTH_TAG_CASE(aead_alg, PSA_ALG_GCM) \5C\0A        PSA_ALG_AEAD_WITH_DEFAULT_LENGTH_TAG_CASE(aead_alg, PSA_ALG_CHACHA20_POLY1305) \5C\0A        0)\0A#define PSA_ALG_AEAD_WITH_DEFAULT_LENGTH_TAG_CASE(aead_alg, ref)         \5C\0A    PSA_ALG_AEAD_WITH_SHORTENED_TAG(aead_alg, 0) ==                      \5C\0A    PSA_ALG_AEAD_WITH_SHORTENED_TAG(ref, 0) ?                            \5C\0A    ref :\0A\0A/** Macro to build an AEAD minimum-tag-length wildcard algorithm.\0A *\0A * A minimum-tag-length AEAD wildcard algorithm permits all AEAD algorithms\0A * sharing the same base algorithm, and where the tag length of the specific\0A * algorithm is equal to or larger then the minimum tag length specified by the\0A * wildcard algorithm.\0A *\0A * \5Cnote    When setting the minimum required tag length to less than the\0A *          smallest tag length allowed by the base algorithm, this effectively\0A *          becomes an 'any-tag-length-allowed' policy for that base algorithm.\0A *\0A * \5Cparam aead_alg        An AEAD algorithm identifier (value of type\0A *                        #psa_algorithm_t such that\0A *                        #PSA_ALG_IS_AEAD(\5Cp aead_alg) is true).\0A * \5Cparam min_tag_length  Desired minimum length of the authentication tag in\0A *                        bytes. This must be at least 1 and at most the largest\0A *                        allowed tag length of the algorithm.\0A *\0A * \5Creturn                The corresponding AEAD wildcard algorithm with the\0A *                        specified minimum length.\0A * \5Creturn                Unspecified if \5Cp aead_alg is not a supported\0A *                        AEAD algorithm or if \5Cp min_tag_length is less than 1\0A *                        or too large for the specified AEAD algorithm.\0A */\0A#define PSA_ALG_AEAD_WITH_AT_LEAST_THIS_LENGTH_TAG(aead_alg, min_tag_length) \5C\0A    (PSA_ALG_AEAD_WITH_SHORTENED_TAG(aead_alg, min_tag_length) |            \5C\0A     PSA_ALG_AEAD_AT_LEAST_THIS_LENGTH_FLAG)\0A\0A#define PSA_ALG_RSA_PKCS1V15_SIGN_BASE          ((psa_algorithm_t) 0x06000200)\0A/** RSA PKCS#1 v1.5 signature with hashing.\0A *\0A * This is the signature scheme defined by RFC 8017\0A * (PKCS#1: RSA Cryptography Specifications) under the name\0A * RSASSA-PKCS1-v1_5.\0A *\0A * \5Cparam hash_alg      A hash algorithm (\5Cc PSA_ALG_XXX value such that\0A *                      #PSA_ALG_IS_HASH(\5Cp hash_alg) is true).\0A *                      This includes #PSA_ALG_ANY_HASH\0A *                      when specifying the algorithm in a usage policy.\0A *\0A * \5Creturn              The corresponding RSA PKCS#1 v1.5 signature algorithm.\0A * \5Creturn              Unspecified if \5Cp hash_alg is not a supported\0A *                      hash algorithm.\0A */\0A#define PSA_ALG_RSA_PKCS1V15_SIGN(hash_alg)                             \5C\0A    (PSA_ALG_RSA_PKCS1V15_SIGN_BASE | ((hash_alg) & PSA_ALG_HASH_MASK))\0A/** Raw PKCS#1 v1.5 signature.\0A *\0A * The input to this algorithm is the DigestInfo structure used by\0A * RFC 8017 (PKCS#1: RSA Cryptography Specifications), &sect;9.2\0A * steps 3&ndash;6.\0A */\0A#define PSA_ALG_RSA_PKCS1V15_SIGN_RAW PSA_ALG_RSA_PKCS1V15_SIGN_BASE\0A#define PSA_ALG_IS_RSA_PKCS1V15_SIGN(alg)                               \5C\0A    (((alg) & ~PSA_ALG_HASH_MASK) == PSA_ALG_RSA_PKCS1V15_SIGN_BASE)\0A\0A#define PSA_ALG_RSA_PSS_BASE               ((psa_algorithm_t) 0x06000300)\0A#define PSA_ALG_RSA_PSS_ANY_SALT_BASE      ((psa_algorithm_t) 0x06001300)\0A/** RSA PSS signature with hashing.\0A *\0A * This is the signature scheme defined by RFC 8017\0A * (PKCS#1: RSA Cryptography Specifications) under the name\0A * RSASSA-PSS, with the message generation function MGF1, and with\0A * a salt length equal to the length of the hash, or the largest\0A * possible salt length for the algorithm and key size if that is\0A * smaller than the hash length. The specified hash algorithm is\0A * used to hash the input message, to create the salted hash, and\0A * for the mask generation.\0A *\0A * \5Cparam hash_alg      A hash algorithm (\5Cc PSA_ALG_XXX value such that\0A *                      #PSA_ALG_IS_HASH(\5Cp hash_alg) is true).\0A *                      This includes #PSA_ALG_ANY_HASH\0A *                      when specifying the algorithm in a usage policy.\0A *\0A * \5Creturn              The corresponding RSA PSS signature algorithm.\0A * \5Creturn              Unspecified if \5Cp hash_alg is not a supported\0A *                      hash algorithm.\0A */\0A#define PSA_ALG_RSA_PSS(hash_alg)                               \5C\0A    (PSA_ALG_RSA_PSS_BASE | ((hash_alg) & PSA_ALG_HASH_MASK))\0A\0A/** RSA PSS signature with hashing with relaxed verification.\0A *\0A * This algorithm has the same behavior as #PSA_ALG_RSA_PSS when signing,\0A * but allows an arbitrary salt length (including \5Cc 0) when verifying a\0A * signature.\0A *\0A * \5Cparam hash_alg      A hash algorithm (\5Cc PSA_ALG_XXX value such that\0A *                      #PSA_ALG_IS_HASH(\5Cp hash_alg) is true).\0A *                      This includes #PSA_ALG_ANY_HASH\0A *                      when specifying the algorithm in a usage policy.\0A *\0A * \5Creturn              The corresponding RSA PSS signature algorithm.\0A * \5Creturn              Unspecified if \5Cp hash_alg is not a supported\0A *                      hash algorithm.\0A */\0A#define PSA_ALG_RSA_PSS_ANY_SALT(hash_alg)                      \5C\0A    (PSA_ALG_RSA_PSS_ANY_SALT_BASE | ((hash_alg) & PSA_ALG_HASH_MASK))\0A\0A/** Whether the specified algorithm is RSA PSS with standard salt.\0A *\0A * \5Cparam alg           An algorithm value or an algorithm policy wildcard.\0A *\0A * \5Creturn              1 if \5Cp alg is of the form\0A *                      #PSA_ALG_RSA_PSS(\5Cc hash_alg),\0A *                      where \5Cc hash_alg is a hash algorithm or\0A *                      #PSA_ALG_ANY_HASH. 0 otherwise.\0A *                      This macro may return either 0 or 1 if \5Cp alg is not\0A *                      a supported algorithm identifier or policy.\0A */\0A#define PSA_ALG_IS_RSA_PSS_STANDARD_SALT(alg)                   \5C\0A    (((alg) & ~PSA_ALG_HASH_MASK) == PSA_ALG_RSA_PSS_BASE)\0A\0A/** Whether the specified algorithm is RSA PSS with any salt.\0A *\0A * \5Cparam alg           An algorithm value or an algorithm policy wildcard.\0A *\0A * \5Creturn              1 if \5Cp alg is of the form\0A *                      #PSA_ALG_RSA_PSS_ANY_SALT_BASE(\5Cc hash_alg),\0A *                      where \5Cc hash_alg is a hash algorithm or\0A *                      #PSA_ALG_ANY_HASH. 0 otherwise.\0A *                      This macro may return either 0 or 1 if \5Cp alg is not\0A *                      a supported algorithm identifier or policy.\0A */\0A#define PSA_ALG_IS_RSA_PSS_ANY_SALT(alg)                                \5C\0A    (((alg) & ~PSA_ALG_HASH_MASK) == PSA_ALG_RSA_PSS_ANY_SALT_BASE)\0A\0A/** Whether the specified algorithm is RSA PSS.\0A *\0A * This includes any of the RSA PSS algorithm variants, regardless of the\0A * constraints on salt length.\0A *\0A * \5Cparam alg           An algorithm value or an algorithm policy wildcard.\0A *\0A * \5Creturn              1 if \5Cp alg is of the form\0A *                      #PSA_ALG_RSA_PSS(\5Cc hash_alg) or\0A *                      #PSA_ALG_RSA_PSS_ANY_SALT_BASE(\5Cc hash_alg),\0A *                      where \5Cc hash_alg is a hash algorithm or\0A *                      #PSA_ALG_ANY_HASH. 0 otherwise.\0A *                      This macro may return either 0 or 1 if \5Cp alg is not\0A *                      a supported algorithm identifier or policy.\0A */\0A#define PSA_ALG_IS_RSA_PSS(alg)                                 \5C\0A    (PSA_ALG_IS_RSA_PSS_STANDARD_SALT(alg) ||                   \5C\0A     PSA_ALG_IS_RSA_PSS_ANY_SALT(alg))\0A\0A#define PSA_ALG_ECDSA_BASE                      ((psa_algorithm_t) 0x06000600)\0A/** ECDSA signature with hashing.\0A *\0A * This is the ECDSA signature scheme defined by ANSI X9.62,\0A * with a random per-message secret number (*k*).\0A *\0A * The representation of the signature as a byte string consists of\0A * the concatenation of the signature values *r* and *s*. Each of\0A * *r* and *s* is encoded as an *N*-octet string, where *N* is the length\0A * of the base point of the curve in octets. Each value is represented\0A * in big-endian order (most significant octet first).\0A *\0A * \5Cparam hash_alg      A hash algorithm (\5Cc PSA_ALG_XXX value such that\0A *                      #PSA_ALG_IS_HASH(\5Cp hash_alg) is true).\0A *                      This includes #PSA_ALG_ANY_HASH\0A *                      when specifying the algorithm in a usage policy.\0A *\0A * \5Creturn              The corresponding ECDSA signature algorithm.\0A * \5Creturn              Unspecified if \5Cp hash_alg is not a supported\0A *                      hash algorithm.\0A */\0A#define PSA_ALG_ECDSA(hash_alg)                                 \5C\0A    (PSA_ALG_ECDSA_BASE | ((hash_alg) & PSA_ALG_HASH_MASK))\0A/** ECDSA signature without hashing.\0A *\0A * This is the same signature scheme as #PSA_ALG_ECDSA(), but\0A * without specifying a hash algorithm. This algorithm may only be\0A * used to sign or verify a sequence of bytes that should be an\0A * already-calculated hash. Note that the input is padded with\0A * zeros on the left or truncated on the left as required to fit\0A * the curve size.\0A */\0A#define PSA_ALG_ECDSA_ANY PSA_ALG_ECDSA_BASE\0A#define PSA_ALG_DETERMINISTIC_ECDSA_BASE        ((psa_algorithm_t) 0x06000700)\0A/** Deterministic ECDSA signature with hashing.\0A *\0A * This is the deterministic ECDSA signature scheme defined by RFC 6979.\0A *\0A * The representation of a signature is the same as with #PSA_ALG_ECDSA().\0A *\0A * Note that when this algorithm is used for verification, signatures\0A * made with randomized ECDSA (#PSA_ALG_ECDSA(\5Cp hash_alg)) with the\0A * same private key are accepted. In other words,\0A * #PSA_ALG_DETERMINISTIC_ECDSA(\5Cp hash_alg) differs from\0A * #PSA_ALG_ECDSA(\5Cp hash_alg) only for signature, not for verification.\0A *\0A * \5Cparam hash_alg      A hash algorithm (\5Cc PSA_ALG_XXX value such that\0A *                      #PSA_ALG_IS_HASH(\5Cp hash_alg) is true).\0A *                      This includes #PSA_ALG_ANY_HASH\0A *                      when specifying the algorithm in a usage policy.\0A *\0A * \5Creturn              The corresponding deterministic ECDSA signature\0A *                      algorithm.\0A * \5Creturn              Unspecified if \5Cp hash_alg is not a supported\0A *                      hash algorithm.\0A */\0A#define PSA_ALG_DETERMINISTIC_ECDSA(hash_alg)                           \5C\0A    (PSA_ALG_DETERMINISTIC_ECDSA_BASE | ((hash_alg) & PSA_ALG_HASH_MASK))\0A#define PSA_ALG_ECDSA_DETERMINISTIC_FLAG        ((psa_algorithm_t) 0x00000100)\0A#define PSA_ALG_IS_ECDSA(alg)                                           \5C\0A    (((alg) & ~PSA_ALG_HASH_MASK & ~PSA_ALG_ECDSA_DETERMINISTIC_FLAG) ==  \5C\0A     PSA_ALG_ECDSA_BASE)\0A#define PSA_ALG_ECDSA_IS_DETERMINISTIC(alg)             \5C\0A    (((alg) & PSA_ALG_ECDSA_DETERMINISTIC_FLAG) != 0)\0A#define PSA_ALG_IS_DETERMINISTIC_ECDSA(alg)                             \5C\0A    (PSA_ALG_IS_ECDSA(alg) && PSA_ALG_ECDSA_IS_DETERMINISTIC(alg))\0A#define PSA_ALG_IS_RANDOMIZED_ECDSA(alg)                                \5C\0A    (PSA_ALG_IS_ECDSA(alg) && !PSA_ALG_ECDSA_IS_DETERMINISTIC(alg))\0A\0A/** Edwards-curve digital signature algorithm without prehashing (PureEdDSA),\0A * using standard parameters.\0A *\0A * Contexts are not supported in the current version of this specification\0A * because there is no suitable signature interface that can take the\0A * context as a parameter. A future version of this specification may add\0A * suitable functions and extend this algorithm to support contexts.\0A *\0A * PureEdDSA requires an elliptic curve key on a twisted Edwards curve.\0A * In this specification, the following curves are supported:\0A * - #PSA_ECC_FAMILY_TWISTED_EDWARDS, 255-bit: Ed25519 as specified\0A *   in RFC 8032.\0A *   The curve is Edwards25519.\0A *   The hash function used internally is SHA-512.\0A * - #PSA_ECC_FAMILY_TWISTED_EDWARDS, 448-bit: Ed448 as specified\0A *   in RFC 8032.\0A *   The curve is Edwards448.\0A *   The hash function used internally is the first 114 bytes of the\0A *   SHAKE256 output.\0A *\0A * This algorithm can be used with psa_sign_message() and\0A * psa_verify_message(). Since there is no prehashing, it cannot be used\0A * with psa_sign_hash() or psa_verify_hash().\0A *\0A * The signature format is the concatenation of R and S as defined by\0A * RFC 8032 §5.1.6 and §5.2.6 (a 64-byte string for Ed25519, a 114-byte\0A * string for Ed448).\0A */\0A#define PSA_ALG_PURE_EDDSA                      ((psa_algorithm_t) 0x06000800)\0A\0A#define PSA_ALG_HASH_EDDSA_BASE                 ((psa_algorithm_t) 0x06000900)\0A#define PSA_ALG_IS_HASH_EDDSA(alg)              \5C\0A    (((alg) & ~PSA_ALG_HASH_MASK) == PSA_ALG_HASH_EDDSA_BASE)\0A\0A/** Edwards-curve digital signature algorithm with prehashing (HashEdDSA),\0A * using SHA-512 and the Edwards25519 curve.\0A *\0A * See #PSA_ALG_PURE_EDDSA regarding context support and the signature format.\0A *\0A * This algorithm is Ed25519 as specified in RFC 8032.\0A * The curve is Edwards25519.\0A * The prehash is SHA-512.\0A * The hash function used internally is SHA-512.\0A *\0A * This is a hash-and-sign algorithm: to calculate a signature,\0A * you can either:\0A * - call psa_sign_message() on the message;\0A * - or calculate the SHA-512 hash of the message\0A *   with psa_hash_compute()\0A *   or with a multi-part hash operation started with psa_hash_setup(),\0A *   using the hash algorithm #PSA_ALG_SHA_512,\0A *   then sign the calculated hash with psa_sign_hash().\0A * Verifying a signature is similar, using psa_verify_message() or\0A * psa_verify_hash() instead of the signature function.\0A */\0A#define PSA_ALG_ED25519PH                               \5C\0A    (PSA_ALG_HASH_EDDSA_BASE | (PSA_ALG_SHA_512 & PSA_ALG_HASH_MASK))\0A\0A/** Edwards-curve digital signature algorithm with prehashing (HashEdDSA),\0A * using SHAKE256 and the Edwards448 curve.\0A *\0A * See #PSA_ALG_PURE_EDDSA regarding context support and the signature format.\0A *\0A * This algorithm is Ed448 as specified in RFC 8032.\0A * The curve is Edwards448.\0A * The prehash is the first 64 bytes of the SHAKE256 output.\0A * The hash function used internally is the first 114 bytes of the\0A * SHAKE256 output.\0A *\0A * This is a hash-and-sign algorithm: to calculate a signature,\0A * you can either:\0A * - call psa_sign_message() on the message;\0A * - or calculate the first 64 bytes of the SHAKE256 output of the message\0A *   with psa_hash_compute()\0A *   or with a multi-part hash operation started with psa_hash_setup(),\0A *   using the hash algorithm #PSA_ALG_SHAKE256_512,\0A *   then sign the calculated hash with psa_sign_hash().\0A * Verifying a signature is similar, using psa_verify_message() or\0A * psa_verify_hash() instead of the signature function.\0A */\0A#define PSA_ALG_ED448PH                                 \5C\0A    (PSA_ALG_HASH_EDDSA_BASE | (PSA_ALG_SHAKE256_512 & PSA_ALG_HASH_MASK))\0A\0A/* Default definition, to be overridden if the library is extended with\0A * more hash-and-sign algorithms that we want to keep out of this header\0A * file. */\0A#define PSA_ALG_IS_VENDOR_HASH_AND_SIGN(alg) 0\0A\0A/** Whether the specified algorithm is a signature algorithm that can be used\0A * with psa_sign_hash() and psa_verify_hash().\0A *\0A * This encompasses all strict hash-and-sign algorithms categorized by\0A * PSA_ALG_IS_HASH_AND_SIGN(), as well as algorithms that follow the\0A * paradigm more loosely:\0A * - #PSA_ALG_RSA_PKCS1V15_SIGN_RAW (expects its input to be an encoded hash)\0A * - #PSA_ALG_ECDSA_ANY (doesn't specify what kind of hash the input is)\0A *\0A * \5Cparam alg An algorithm identifier (value of type psa_algorithm_t).\0A *\0A * \5Creturn 1 if alg is a signature algorithm that can be used to sign a\0A *         hash. 0 if alg is a signature algorithm that can only be used\0A *         to sign a message. 0 if alg is not a signature algorithm.\0A *         This macro can return either 0 or 1 if alg is not a\0A *         supported algorithm identifier.\0A */\0A#define PSA_ALG_IS_SIGN_HASH(alg)                                       \5C\0A    (PSA_ALG_IS_RSA_PSS(alg) || PSA_ALG_IS_RSA_PKCS1V15_SIGN(alg) ||    \5C\0A     PSA_ALG_IS_ECDSA(alg) || PSA_ALG_IS_HASH_EDDSA(alg) ||             \5C\0A     PSA_ALG_IS_VENDOR_HASH_AND_SIGN(alg))\0A\0A/** Whether the specified algorithm is a signature algorithm that can be used\0A * with psa_sign_message() and psa_verify_message().\0A *\0A * \5Cparam alg An algorithm identifier (value of type #psa_algorithm_t).\0A *\0A * \5Creturn 1 if alg is a signature algorithm that can be used to sign a\0A *         message. 0 if \5Cp alg is a signature algorithm that can only be used\0A *         to sign an already-calculated hash. 0 if \5Cp alg is not a signature\0A *         algorithm. This macro can return either 0 or 1 if \5Cp alg is not a\0A *         supported algorithm identifier.\0A */\0A#define PSA_ALG_IS_SIGN_MESSAGE(alg)                                    \5C\0A    (PSA_ALG_IS_SIGN_HASH(alg) || (alg) == PSA_ALG_PURE_EDDSA)\0A\0A/** Whether the specified algorithm is a hash-and-sign algorithm.\0A *\0A * Hash-and-sign algorithms are asymmetric (public-key) signature algorithms\0A * structured in two parts: first the calculation of a hash in a way that\0A * does not depend on the key, then the calculation of a signature from the\0A * hash value and the key. Hash-and-sign algorithms encode the hash\0A * used for the hashing step, and you can call #PSA_ALG_SIGN_GET_HASH\0A * to extract this algorithm.\0A *\0A * Thus, for a hash-and-sign algorithm,\0A * `psa_sign_message(key, alg, input, ...)` is equivalent to\0A * ```\0A * psa_hash_compute(PSA_ALG_SIGN_GET_HASH(alg), input, ..., hash, ...);\0A * psa_sign_hash(key, alg, hash, ..., signature, ...);\0A * ```\0A * Most usefully, separating the hash from the signature allows the hash\0A * to be calculated in multiple steps with psa_hash_setup(), psa_hash_update()\0A * and psa_hash_finish(). Likewise psa_verify_message() is equivalent to\0A * calculating the hash and then calling psa_verify_hash().\0A *\0A * \5Cparam alg An algorithm identifier (value of type #psa_algorithm_t).\0A *\0A * \5Creturn 1 if \5Cp alg is a hash-and-sign algorithm, 0 otherwise.\0A *         This macro may return either 0 or 1 if \5Cp alg is not a supported\0A *         algorithm identifier.\0A */\0A#define PSA_ALG_IS_HASH_AND_SIGN(alg)                                   \5C\0A    (PSA_ALG_IS_SIGN_HASH(alg) &&                                       \5C\0A     ((alg) & PSA_ALG_HASH_MASK) != 0)\0A\0A/** Get the hash used by a hash-and-sign signature algorithm.\0A *\0A * A hash-and-sign algorithm is a signature algorithm which is\0A * composed of two phases: first a hashing phase which does not use\0A * the key and produces a hash of the input message, then a signing\0A * phase which only uses the hash and the key and not the message\0A * itself.\0A *\0A * \5Cparam alg   A signature algorithm (\5Cc PSA_ALG_XXX value such that\0A *              #PSA_ALG_IS_SIGN(\5Cp alg) is true).\0A *\0A * \5Creturn      The underlying hash algorithm if \5Cp alg is a hash-and-sign\0A *              algorithm.\0A * \5Creturn      0 if \5Cp alg is a signature algorithm that does not\0A *              follow the hash-and-sign structure.\0A * \5Creturn      Unspecified if \5Cp alg is not a signature algorithm or\0A *              if it is not supported by the implementation.\0A */\0A#define PSA_ALG_SIGN_GET_HASH(alg)                                     \5C\0A    (PSA_ALG_IS_HASH_AND_SIGN(alg) ?                                   \5C\0A     ((alg) & PSA_ALG_HASH_MASK) | PSA_ALG_CATEGORY_HASH :             \5C\0A     0)\0A\0A/** RSA PKCS#1 v1.5 encryption.\0A *\0A * \5Cwarning     Calling psa_asymmetric_decrypt() with this algorithm as a\0A *              parameter is considered an inherently dangerous function\0A *              (CWE-242). Unless it is used in a side channel free and safe\0A *              way (eg. implementing the TLS protocol as per 7.4.7.1 of\0A *              RFC 5246), the calling code is vulnerable.\0A *\0A */\0A#define PSA_ALG_RSA_PKCS1V15_CRYPT              ((psa_algorithm_t) 0x07000200)\0A\0A#define PSA_ALG_RSA_OAEP_BASE                   ((psa_algorithm_t) 0x07000300)\0A/** RSA OAEP encryption.\0A *\0A * This is the encryption scheme defined by RFC 8017\0A * (PKCS#1: RSA Cryptography Specifications) under the name\0A * RSAES-OAEP, with the message generation function MGF1.\0A *\0A * \5Cparam hash_alg      The hash algorithm (\5Cc PSA_ALG_XXX value such that\0A *                      #PSA_ALG_IS_HASH(\5Cp hash_alg) is true) to use\0A *                      for MGF1.\0A *\0A * \5Creturn              The corresponding RSA OAEP encryption algorithm.\0A * \5Creturn              Unspecified if \5Cp hash_alg is not a supported\0A *                      hash algorithm.\0A */\0A#define PSA_ALG_RSA_OAEP(hash_alg)                              \5C\0A    (PSA_ALG_RSA_OAEP_BASE | ((hash_alg) & PSA_ALG_HASH_MASK))\0A#define PSA_ALG_IS_RSA_OAEP(alg)                                \5C\0A    (((alg) & ~PSA_ALG_HASH_MASK) == PSA_ALG_RSA_OAEP_BASE)\0A#define PSA_ALG_RSA_OAEP_GET_HASH(alg)                          \5C\0A    (PSA_ALG_IS_RSA_OAEP(alg) ?                                 \5C\0A     ((alg) & PSA_ALG_HASH_MASK) | PSA_ALG_CATEGORY_HASH :      \5C\0A     0)\0A\0A#define PSA_ALG_HKDF_BASE                       ((psa_algorithm_t) 0x08000100)\0A/** Macro to build an HKDF algorithm.\0A *\0A * For example, `PSA_ALG_HKDF(PSA_ALG_SHA_256)` is HKDF using HMAC-SHA-256.\0A *\0A * This key derivation algorithm uses the following inputs:\0A * - #PSA_KEY_DERIVATION_INPUT_SALT is the salt used in the \22extract\22 step.\0A *   It is optional; if omitted, the derivation uses an empty salt.\0A * - #PSA_KEY_DERIVATION_INPUT_SECRET is the secret key used in the \22extract\22 step.\0A * - #PSA_KEY_DERIVATION_INPUT_INFO is the info string used in the \22expand\22 step.\0A * You must pass #PSA_KEY_DERIVATION_INPUT_SALT before #PSA_KEY_DERIVATION_INPUT_SECRET.\0A * You may pass #PSA_KEY_DERIVATION_INPUT_INFO at any time after steup and before\0A * starting to generate output.\0A *\0A *  \5Cwarning  HKDF processes the salt as follows: first hash it with hash_alg\0A *  if the salt is longer than the block size of the hash algorithm; then\0A *  pad with null bytes up to the block size. As a result, it is possible\0A *  for distinct salt inputs to result in the same outputs. To ensure\0A *  unique outputs, it is recommended to use a fixed length for salt values.\0A *\0A * \5Cparam hash_alg      A hash algorithm (\5Cc PSA_ALG_XXX value such that\0A *                      #PSA_ALG_IS_HASH(\5Cp hash_alg) is true).\0A *\0A * \5Creturn              The corresponding HKDF algorithm.\0A * \5Creturn              Unspecified if \5Cp hash_alg is not a supported\0A *                      hash algorithm.\0A */\0A#define PSA_ALG_HKDF(hash_alg)                                  \5C\0A    (PSA_ALG_HKDF_BASE | ((hash_alg) & PSA_ALG_HASH_MASK))\0A/** Whether the specified algorithm is an HKDF algorithm.\0A *\0A * HKDF is a family of key derivation algorithms that are based on a hash\0A * function and the HMAC construction.\0A *\0A * \5Cparam alg An algorithm identifier (value of type #psa_algorithm_t).\0A *\0A * \5Creturn 1 if \5Cc alg is an HKDF algorithm, 0 otherwise.\0A *         This macro may return either 0 or 1 if \5Cc alg is not a supported\0A *         key derivation algorithm identifier.\0A */\0A#define PSA_ALG_IS_HKDF(alg)                            \5C\0A    (((alg) & ~PSA_ALG_HASH_MASK) == PSA_ALG_HKDF_BASE)\0A#define PSA_ALG_HKDF_GET_HASH(hkdf_alg)                         \5C\0A    (PSA_ALG_CATEGORY_HASH | ((hkdf_alg) & PSA_ALG_HASH_MASK))\0A\0A#define PSA_ALG_HKDF_EXTRACT_BASE                       ((psa_algorithm_t) 0x08000400)\0A/** Macro to build an HKDF-Extract algorithm.\0A *\0A * For example, `PSA_ALG_HKDF_EXTRACT(PSA_ALG_SHA_256)` is\0A * HKDF-Extract using HMAC-SHA-256.\0A *\0A * This key derivation algorithm uses the following inputs:\0A *  - PSA_KEY_DERIVATION_INPUT_SALT is the salt.\0A *  - PSA_KEY_DERIVATION_INPUT_SECRET is the input keying material used in the\0A *    \22extract\22 step.\0A * The inputs are mandatory and must be passed in the order above.\0A * Each input may only be passed once.\0A *\0A *  \5Cwarning HKDF-Extract is not meant to be used on its own. PSA_ALG_HKDF\0A *  should be used instead if possible. PSA_ALG_HKDF_EXTRACT is provided\0A *  as a separate algorithm for the sake of protocols that use it as a\0A *  building block. It may also be a slight performance optimization\0A *  in applications that use HKDF with the same salt and key but many\0A *  different info strings.\0A *\0A *  \5Cwarning  HKDF processes the salt as follows: first hash it with hash_alg\0A *  if the salt is longer than the block size of the hash algorithm; then\0A *  pad with null bytes up to the block size. As a result, it is possible\0A *  for distinct salt inputs to result in the same outputs. To ensure\0A *  unique outputs, it is recommended to use a fixed length for salt values.\0A *\0A * \5Cparam hash_alg      A hash algorithm (\5Cc PSA_ALG_XXX value such that\0A *                      #PSA_ALG_IS_HASH(\5Cp hash_alg) is true).\0A *\0A * \5Creturn              The corresponding HKDF-Extract algorithm.\0A * \5Creturn              Unspecified if \5Cp hash_alg is not a supported\0A *                      hash algorithm.\0A */\0A#define PSA_ALG_HKDF_EXTRACT(hash_alg)                                  \5C\0A    (PSA_ALG_HKDF_EXTRACT_BASE | ((hash_alg) & PSA_ALG_HASH_MASK))\0A/** Whether the specified algorithm is an HKDF-Extract algorithm.\0A *\0A * HKDF-Extract is a family of key derivation algorithms that are based\0A * on a hash function and the HMAC construction.\0A *\0A * \5Cparam alg An algorithm identifier (value of type #psa_algorithm_t).\0A *\0A * \5Creturn 1 if \5Cc alg is an HKDF-Extract algorithm, 0 otherwise.\0A *         This macro may return either 0 or 1 if \5Cc alg is not a supported\0A *         key derivation algorithm identifier.\0A */\0A#define PSA_ALG_IS_HKDF_EXTRACT(alg)                            \5C\0A    (((alg) & ~PSA_ALG_HASH_MASK) == PSA_ALG_HKDF_EXTRACT_BASE)\0A\0A#define PSA_ALG_HKDF_EXPAND_BASE                       ((psa_algorithm_t) 0x08000500)\0A/** Macro to build an HKDF-Expand algorithm.\0A *\0A * For example, `PSA_ALG_HKDF_EXPAND(PSA_ALG_SHA_256)` is\0A * HKDF-Expand using HMAC-SHA-256.\0A *\0A * This key derivation algorithm uses the following inputs:\0A *  - PSA_KEY_DERIVATION_INPUT_SECRET is the pseudorandom key (PRK).\0A *  - PSA_KEY_DERIVATION_INPUT_INFO is the info string.\0A *\0A *  The inputs are mandatory and must be passed in the order above.\0A *  Each input may only be passed once.\0A *\0A *  \5Cwarning HKDF-Expand is not meant to be used on its own. `PSA_ALG_HKDF`\0A *  should be used instead if possible. `PSA_ALG_HKDF_EXPAND` is provided as\0A *  a separate algorithm for the sake of protocols that use it as a building\0A *  block. It may also be a slight performance optimization in applications\0A *  that use HKDF with the same salt and key but many different info strings.\0A *\0A * \5Cparam hash_alg      A hash algorithm (\5Cc PSA_ALG_XXX value such that\0A *                      #PSA_ALG_IS_HASH(\5Cp hash_alg) is true).\0A *\0A * \5Creturn              The corresponding HKDF-Expand algorithm.\0A * \5Creturn              Unspecified if \5Cp hash_alg is not a supported\0A *                      hash algorithm.\0A */\0A#define PSA_ALG_HKDF_EXPAND(hash_alg)                                  \5C\0A    (PSA_ALG_HKDF_EXPAND_BASE | ((hash_alg) & PSA_ALG_HASH_MASK))\0A/** Whether the specified algorithm is an HKDF-Expand algorithm.\0A *\0A * HKDF-Expand is a family of key derivation algorithms that are based\0A * on a hash function and the HMAC construction.\0A *\0A * \5Cparam alg An algorithm identifier (value of type #psa_algorithm_t).\0A *\0A * \5Creturn 1 if \5Cc alg is an HKDF-Expand algorithm, 0 otherwise.\0A *         This macro may return either 0 or 1 if \5Cc alg is not a supported\0A *         key derivation algorithm identifier.\0A */\0A#define PSA_ALG_IS_HKDF_EXPAND(alg)                            \5C\0A    (((alg) & ~PSA_ALG_HASH_MASK) == PSA_ALG_HKDF_EXPAND_BASE)\0A\0A/** Whether the specified algorithm is an HKDF or HKDF-Extract or\0A *  HKDF-Expand algorithm.\0A *\0A *\0A * \5Cparam alg An algorithm identifier (value of type #psa_algorithm_t).\0A *\0A * \5Creturn 1 if \5Cc alg is any HKDF type algorithm, 0 otherwise.\0A *         This macro may return either 0 or 1 if \5Cc alg is not a supported\0A *         key derivation algorithm identifier.\0A */\0A#define PSA_ALG_IS_ANY_HKDF(alg)                                   \5C\0A    (((alg) & ~PSA_ALG_HASH_MASK) == PSA_ALG_HKDF_BASE ||          \5C\0A     ((alg) & ~PSA_ALG_HASH_MASK) == PSA_ALG_HKDF_EXTRACT_BASE ||  \5C\0A     ((alg) & ~PSA_ALG_HASH_MASK) == PSA_ALG_HKDF_EXPAND_BASE)\0A\0A#define PSA_ALG_TLS12_PRF_BASE                  ((psa_algorithm_t) 0x08000200)\0A/** Macro to build a TLS-1.2 PRF algorithm.\0A *\0A * TLS 1.2 uses a custom pseudorandom function (PRF) for key schedule,\0A * specified in Section 5 of RFC 5246. It is based on HMAC and can be\0A * used with either SHA-256 or SHA-384.\0A *\0A * This key derivation algorithm uses the following inputs, which must be\0A * passed in the order given here:\0A * - #PSA_KEY_DERIVATION_INPUT_SEED is the seed.\0A * - #PSA_KEY_DERIVATION_INPUT_SECRET is the secret key.\0A * - #PSA_KEY_DERIVATION_INPUT_LABEL is the label.\0A *\0A * For the application to TLS-1.2 key expansion, the seed is the\0A * concatenation of ServerHello.Random + ClientHello.Random,\0A * and the label is \22key expansion\22.\0A *\0A * For example, `PSA_ALG_TLS12_PRF(PSA_ALG_SHA_256)` represents the\0A * TLS 1.2 PRF using HMAC-SHA-256.\0A *\0A * \5Cparam hash_alg      A hash algorithm (\5Cc PSA_ALG_XXX value such that\0A *                      #PSA_ALG_IS_HASH(\5Cp hash_alg) is true).\0A *\0A * \5Creturn              The corresponding TLS-1.2 PRF algorithm.\0A * \5Creturn              Unspecified if \5Cp hash_alg is not a supported\0A *                      hash algorithm.\0A */\0A#define PSA_ALG_TLS12_PRF(hash_alg)                                  \5C\0A    (PSA_ALG_TLS12_PRF_BASE | ((hash_alg) & PSA_ALG_HASH_MASK))\0A\0A/** Whether the specified algorithm is a TLS-1.2 PRF algorithm.\0A *\0A * \5Cparam alg An algorithm identifier (value of type #psa_algorithm_t).\0A *\0A * \5Creturn 1 if \5Cc alg is a TLS-1.2 PRF algorithm, 0 otherwise.\0A *         This macro may return either 0 or 1 if \5Cc alg is not a supported\0A *         key derivation algorithm identifier.\0A */\0A#define PSA_ALG_IS_TLS12_PRF(alg)                                    \5C\0A    (((alg) & ~PSA_ALG_HASH_MASK) == PSA_ALG_TLS12_PRF_BASE)\0A#define PSA_ALG_TLS12_PRF_GET_HASH(hkdf_alg)                         \5C\0A    (PSA_ALG_CATEGORY_HASH | ((hkdf_alg) & PSA_ALG_HASH_MASK))\0A\0A#define PSA_ALG_TLS12_PSK_TO_MS_BASE            ((psa_algorithm_t) 0x08000300)\0A/** Macro to build a TLS-1.2 PSK-to-MasterSecret algorithm.\0A *\0A * In a pure-PSK handshake in TLS 1.2, the master secret is derived\0A * from the PreSharedKey (PSK) through the application of padding\0A * (RFC 4279, Section 2) and the TLS-1.2 PRF (RFC 5246, Section 5).\0A * The latter is based on HMAC and can be used with either SHA-256\0A * or SHA-384.\0A *\0A * This key derivation algorithm uses the following inputs, which must be\0A * passed in the order given here:\0A * - #PSA_KEY_DERIVATION_INPUT_SEED is the seed.\0A * - #PSA_KEY_DERIVATION_INPUT_OTHER_SECRET is the other secret for the\0A *   computation of the premaster secret. This input is optional;\0A *   if omitted, it defaults to a string of null bytes with the same length\0A *   as the secret (PSK) input.\0A * - #PSA_KEY_DERIVATION_INPUT_SECRET is the secret key.\0A * - #PSA_KEY_DERIVATION_INPUT_LABEL is the label.\0A *\0A * For the application to TLS-1.2, the seed (which is\0A * forwarded to the TLS-1.2 PRF) is the concatenation of the\0A * ClientHello.Random + ServerHello.Random,\0A * the label is \22master secret\22 or \22extended master secret\22 and\0A * the other secret depends on the key exchange specified in the cipher suite:\0A * - for a plain PSK cipher suite (RFC 4279, Section 2), omit\0A *   PSA_KEY_DERIVATION_INPUT_OTHER_SECRET\0A * - for a DHE-PSK (RFC 4279, Section 3) or ECDHE-PSK cipher suite\0A *   (RFC 5489, Section 2), the other secret should be the output of the\0A *   PSA_ALG_FFDH or PSA_ALG_ECDH key agreement performed with the peer.\0A *   The recommended way to pass this input is to use a key derivation\0A *   algorithm constructed as\0A *   PSA_ALG_KEY_AGREEMENT(ka_alg, PSA_ALG_TLS12_PSK_TO_MS(hash_alg))\0A *   and to call psa_key_derivation_key_agreement(). Alternatively,\0A *   this input may be an output of `psa_raw_key_agreement()` passed with\0A *   psa_key_derivation_input_bytes(), or an equivalent input passed with\0A *   psa_key_derivation_input_bytes() or psa_key_derivation_input_key().\0A * - for a RSA-PSK cipher suite (RFC 4279, Section 4), the other secret\0A *   should be the 48-byte client challenge (the PreMasterSecret of\0A *   (RFC 5246, Section 7.4.7.1)) concatenation of the TLS version and\0A *   a 46-byte random string chosen by the client. On the server, this is\0A *   typically an output of psa_asymmetric_decrypt() using\0A *   PSA_ALG_RSA_PKCS1V15_CRYPT, passed to the key derivation operation\0A *   with `psa_key_derivation_input_bytes()`.\0A *\0A * For example, `PSA_ALG_TLS12_PSK_TO_MS(PSA_ALG_SHA_256)` represents the\0A * TLS-1.2 PSK to MasterSecret derivation PRF using HMAC-SHA-256.\0A *\0A * \5Cparam hash_alg      A hash algorithm (\5Cc PSA_ALG_XXX value such that\0A *                      #PSA_ALG_IS_HASH(\5Cp hash_alg) is true).\0A *\0A * \5Creturn              The corresponding TLS-1.2 PSK to MS algorithm.\0A * \5Creturn              Unspecified if \5Cp hash_alg is not a supported\0A *                      hash algorithm.\0A */\0A#define PSA_ALG_TLS12_PSK_TO_MS(hash_alg)                                  \5C\0A    (PSA_ALG_TLS12_PSK_TO_MS_BASE | ((hash_alg) & PSA_ALG_HASH_MASK))\0A\0A/** Whether the specified algorithm is a TLS-1.2 PSK to MS algorithm.\0A *\0A * \5Cparam alg An algorithm identifier (value of type #psa_algorithm_t).\0A *\0A * \5Creturn 1 if \5Cc alg is a TLS-1.2 PSK to MS algorithm, 0 otherwise.\0A *         This macro may return either 0 or 1 if \5Cc alg is not a supported\0A *         key derivation algorithm identifier.\0A */\0A#define PSA_ALG_IS_TLS12_PSK_TO_MS(alg)                                    \5C\0A    (((alg) & ~PSA_ALG_HASH_MASK) == PSA_ALG_TLS12_PSK_TO_MS_BASE)\0A#define PSA_ALG_TLS12_PSK_TO_MS_GET_HASH(hkdf_alg)                         \5C\0A    (PSA_ALG_CATEGORY_HASH | ((hkdf_alg) & PSA_ALG_HASH_MASK))\0A\0A/* The TLS 1.2 ECJPAKE-to-PMS KDF. It takes the shared secret K (an EC point\0A * in case of EC J-PAKE) and calculates SHA256(K.X) that the rest of TLS 1.2\0A * will use to derive the session secret, as defined by step 2 of\0A * https://datatracker.ietf.org/doc/html/draft-cragie-tls-ecjpake-01#section-8.7.\0A * Uses PSA_ALG_SHA_256.\0A * This function takes a single input:\0A * #PSA_KEY_DERIVATION_INPUT_SECRET is the shared secret K from EC J-PAKE.\0A * The only supported curve is secp256r1 (the 256-bit curve in\0A * #PSA_ECC_FAMILY_SECP_R1), so the input must be exactly 65 bytes.\0A * The output has to be read as a single chunk of 32 bytes, defined as\0A * PSA_TLS12_ECJPAKE_TO_PMS_DATA_SIZE.\0A */\0A#define PSA_ALG_TLS12_ECJPAKE_TO_PMS            ((psa_algorithm_t) 0x08000609)\0A\0A/* This flag indicates whether the key derivation algorithm is suitable for\0A * use on low-entropy secrets such as password - these algorithms are also\0A * known as key stretching or password hashing schemes. These are also the\0A * algorithms that accepts inputs of type #PSA_KEY_DERIVATION_INPUT_PASSWORD.\0A *\0A * Those algorithms cannot be combined with a key agreement algorithm.\0A */\0A#define PSA_ALG_KEY_DERIVATION_STRETCHING_FLAG  ((psa_algorithm_t) 0x00800000)\0A\0A#define PSA_ALG_PBKDF2_HMAC_BASE                ((psa_algorithm_t) 0x08800100)\0A/** Macro to build a PBKDF2-HMAC password hashing / key stretching algorithm.\0A *\0A * PBKDF2 is defined by PKCS#5, republished as RFC 8018 (section 5.2).\0A * This macro specifies the PBKDF2 algorithm constructed using a PRF based on\0A * HMAC with the specified hash.\0A * For example, `PSA_ALG_PBKDF2_HMAC(PSA_ALG_SHA_256)` specifies PBKDF2\0A * using the PRF HMAC-SHA-256.\0A *\0A * This key derivation algorithm uses the following inputs, which must be\0A * provided in the following order:\0A * - #PSA_KEY_DERIVATION_INPUT_COST is the iteration count.\0A *   This input step must be used exactly once.\0A * - #PSA_KEY_DERIVATION_INPUT_SALT is the salt.\0A *   This input step must be used one or more times; if used several times, the\0A *   inputs will be concatenated. This can be used to build the final salt\0A *   from multiple sources, both public and secret (also known as pepper).\0A * - #PSA_KEY_DERIVATION_INPUT_PASSWORD is the password to be hashed.\0A *   This input step must be used exactly once.\0A *\0A * \5Cparam hash_alg      A hash algorithm (\5Cc PSA_ALG_XXX value such that\0A *                      #PSA_ALG_IS_HASH(\5Cp hash_alg) is true).\0A *\0A * \5Creturn              The corresponding PBKDF2-HMAC-XXX algorithm.\0A * \5Creturn              Unspecified if \5Cp hash_alg is not a supported\0A *                      hash algorithm.\0A */\0A#define PSA_ALG_PBKDF2_HMAC(hash_alg)                                  \5C\0A    (PSA_ALG_PBKDF2_HMAC_BASE | ((hash_alg) & PSA_ALG_HASH_MASK))\0A\0A/** Whether the specified algorithm is a PBKDF2-HMAC algorithm.\0A *\0A * \5Cparam alg An algorithm identifier (value of type #psa_algorithm_t).\0A *\0A * \5Creturn 1 if \5Cc alg is a PBKDF2-HMAC algorithm, 0 otherwise.\0A *         This macro may return either 0 or 1 if \5Cc alg is not a supported\0A *         key derivation algorithm identifier.\0A */\0A#define PSA_ALG_IS_PBKDF2_HMAC(alg)                                    \5C\0A    (((alg) & ~PSA_ALG_HASH_MASK) == PSA_ALG_PBKDF2_HMAC_BASE)\0A#define PSA_ALG_PBKDF2_HMAC_GET_HASH(pbkdf2_alg)                         \5C\0A    (PSA_ALG_CATEGORY_HASH | ((pbkdf2_alg) & PSA_ALG_HASH_MASK))\0A/** The PBKDF2-AES-CMAC-PRF-128 password hashing / key stretching algorithm.\0A *\0A * PBKDF2 is defined by PKCS#5, republished as RFC 8018 (section 5.2).\0A * This macro specifies the PBKDF2 algorithm constructed using the\0A * AES-CMAC-PRF-128 PRF specified by RFC 4615.\0A *\0A * This key derivation algorithm uses the same inputs as\0A * #PSA_ALG_PBKDF2_HMAC() with the same constraints.\0A */\0A#define PSA_ALG_PBKDF2_AES_CMAC_PRF_128         ((psa_algorithm_t) 0x08800200)\0A\0A#define PSA_ALG_IS_PBKDF2(kdf_alg)                                      \5C\0A    (PSA_ALG_IS_PBKDF2_HMAC(kdf_alg) || \5C\0A     ((kdf_alg) == PSA_ALG_PBKDF2_AES_CMAC_PRF_128))\0A\0A#define PSA_ALG_KEY_DERIVATION_MASK             ((psa_algorithm_t) 0xfe00ffff)\0A#define PSA_ALG_KEY_AGREEMENT_MASK              ((psa_algorithm_t) 0xffff0000)\0A\0A/** Macro to build a combined algorithm that chains a key agreement with\0A * a key derivation.\0A *\0A * \5Cparam ka_alg        A key agreement algorithm (\5Cc PSA_ALG_XXX value such\0A *                      that #PSA_ALG_IS_KEY_AGREEMENT(\5Cp ka_alg) is true).\0A * \5Cparam kdf_alg       A key derivation algorithm (\5Cc PSA_ALG_XXX value such\0A *                      that #PSA_ALG_IS_KEY_DERIVATION(\5Cp kdf_alg) is true).\0A *\0A * \5Creturn              The corresponding key agreement and derivation\0A *                      algorithm.\0A * \5Creturn              Unspecified if \5Cp ka_alg is not a supported\0A *                      key agreement algorithm or \5Cp kdf_alg is not a\0A *                      supported key derivation algorithm.\0A */\0A#define PSA_ALG_KEY_AGREEMENT(ka_alg, kdf_alg)  \5C\0A    ((ka_alg) | (kdf_alg))\0A\0A#define PSA_ALG_KEY_AGREEMENT_GET_KDF(alg)                              \5C\0A    (((alg) & PSA_ALG_KEY_DERIVATION_MASK) | PSA_ALG_CATEGORY_KEY_DERIVATION)\0A\0A#define PSA_ALG_KEY_AGREEMENT_GET_BASE(alg)                             \5C\0A    (((alg) & PSA_ALG_KEY_AGREEMENT_MASK) | PSA_ALG_CATEGORY_KEY_AGREEMENT)\0A\0A/** Whether the specified algorithm is a raw key agreement algorithm.\0A *\0A * A raw key agreement algorithm is one that does not specify\0A * a key derivation function.\0A * Usually, raw key agreement algorithms are constructed directly with\0A * a \5Cc PSA_ALG_xxx macro while non-raw key agreement algorithms are\0A * constructed with #PSA_ALG_KEY_AGREEMENT().\0A *\0A * \5Cparam alg An algorithm identifier (value of type #psa_algorithm_t).\0A *\0A * \5Creturn 1 if \5Cp alg is a raw key agreement algorithm, 0 otherwise.\0A *         This macro may return either 0 or 1 if \5Cp alg is not a supported\0A *         algorithm identifier.\0A */\0A#define PSA_ALG_IS_RAW_KEY_AGREEMENT(alg)                               \5C\0A    (PSA_ALG_IS_KEY_AGREEMENT(alg) &&                                   \5C\0A     PSA_ALG_KEY_AGREEMENT_GET_KDF(alg) == PSA_ALG_CATEGORY_KEY_DERIVATION)\0A\0A#define PSA_ALG_IS_KEY_DERIVATION_OR_AGREEMENT(alg)     \5C\0A    ((PSA_ALG_IS_KEY_DERIVATION(alg) || PSA_ALG_IS_KEY_AGREEMENT(alg)))\0A\0A/** The finite-field Diffie-Hellman (DH) key agreement algorithm.\0A *\0A * The shared secret produced by key agreement is\0A * `g^{ab}` in big-endian format.\0A * It is `ceiling(m / 8)` bytes long where `m` is the size of the prime `p`\0A * in bits.\0A */\0A#define PSA_ALG_FFDH                            ((psa_algorithm_t) 0x09010000)\0A\0A/** Whether the specified algorithm is a finite field Diffie-Hellman algorithm.\0A *\0A * This includes the raw finite field Diffie-Hellman algorithm as well as\0A * finite-field Diffie-Hellman followed by any supporter key derivation\0A * algorithm.\0A *\0A * \5Cparam alg An algorithm identifier (value of type #psa_algorithm_t).\0A *\0A * \5Creturn 1 if \5Cc alg is a finite field Diffie-Hellman algorithm, 0 otherwise.\0A *         This macro may return either 0 or 1 if \5Cc alg is not a supported\0A *         key agreement algorithm identifier.\0A */\0A#define PSA_ALG_IS_FFDH(alg) \5C\0A    (PSA_ALG_KEY_AGREEMENT_GET_BASE(alg) == PSA_ALG_FFDH)\0A\0A/** The elliptic curve Diffie-Hellman (ECDH) key agreement algorithm.\0A *\0A * The shared secret produced by key agreement is the x-coordinate of\0A * the shared secret point. It is always `ceiling(m / 8)` bytes long where\0A * `m` is the bit size associated with the curve, i.e. the bit size of the\0A * order of the curve's coordinate field. When `m` is not a multiple of 8,\0A * the byte containing the most significant bit of the shared secret\0A * is padded with zero bits. The byte order is either little-endian\0A * or big-endian depending on the curve type.\0A *\0A * - For Montgomery curves (curve types `PSA_ECC_FAMILY_CURVEXXX`),\0A *   the shared secret is the x-coordinate of `d_A Q_B = d_B Q_A`\0A *   in little-endian byte order.\0A *   The bit size is 448 for Curve448 and 255 for Curve25519.\0A * - For Weierstrass curves over prime fields (curve types\0A *   `PSA_ECC_FAMILY_SECPXXX` and `PSA_ECC_FAMILY_BRAINPOOL_PXXX`),\0A *   the shared secret is the x-coordinate of `d_A Q_B = d_B Q_A`\0A *   in big-endian byte order.\0A *   The bit size is `m = ceiling(log_2(p))` for the field `F_p`.\0A * - For Weierstrass curves over binary fields (curve types\0A *   `PSA_ECC_FAMILY_SECTXXX`),\0A *   the shared secret is the x-coordinate of `d_A Q_B = d_B Q_A`\0A *   in big-endian byte order.\0A *   The bit size is `m` for the field `F_{2^m}`.\0A */\0A#define PSA_ALG_ECDH                            ((psa_algorithm_t) 0x09020000)\0A\0A/** Whether the specified algorithm is an elliptic curve Diffie-Hellman\0A * algorithm.\0A *\0A * This includes the raw elliptic curve Diffie-Hellman algorithm as well as\0A * elliptic curve Diffie-Hellman followed by any supporter key derivation\0A * algorithm.\0A *\0A * \5Cparam alg An algorithm identifier (value of type #psa_algorithm_t).\0A *\0A * \5Creturn 1 if \5Cc alg is an elliptic curve Diffie-Hellman algorithm,\0A *         0 otherwise.\0A *         This macro may return either 0 or 1 if \5Cc alg is not a supported\0A *         key agreement algorithm identifier.\0A */\0A#define PSA_ALG_IS_ECDH(alg) \5C\0A    (PSA_ALG_KEY_AGREEMENT_GET_BASE(alg) == PSA_ALG_ECDH)\0A\0A/** Whether the specified algorithm encoding is a wildcard.\0A *\0A * Wildcard values may only be used to set the usage algorithm field in\0A * a policy, not to perform an operation.\0A *\0A * \5Cparam alg An algorithm identifier (value of type #psa_algorithm_t).\0A *\0A * \5Creturn 1 if \5Cc alg is a wildcard algorithm encoding.\0A * \5Creturn 0 if \5Cc alg is a non-wildcard algorithm encoding (suitable for\0A *         an operation).\0A * \5Creturn This macro may return either 0 or 1 if \5Cc alg is not a supported\0A *         algorithm identifier.\0A */\0A#define PSA_ALG_IS_WILDCARD(alg)                            \5C\0A    (PSA_ALG_IS_HASH_AND_SIGN(alg) ?                        \5C\0A     PSA_ALG_SIGN_GET_HASH(alg) == PSA_ALG_ANY_HASH :       \5C\0A     PSA_ALG_IS_MAC(alg) ?                                  \5C\0A     (alg & PSA_ALG_MAC_AT_LEAST_THIS_LENGTH_FLAG) != 0 :   \5C\0A     PSA_ALG_IS_AEAD(alg) ?                                 \5C\0A     (alg & PSA_ALG_AEAD_AT_LEAST_THIS_LENGTH_FLAG) != 0 :  \5C\0A     (alg) == PSA_ALG_ANY_HASH)\0A\0A/** Get the hash used by a composite algorithm.\0A *\0A * \5Cparam alg An algorithm identifier (value of type #psa_algorithm_t).\0A *\0A * \5Creturn The underlying hash algorithm if alg is a composite algorithm that\0A * uses a hash algorithm.\0A *\0A * \5Creturn \5Cc 0 if alg is not a composite algorithm that uses a hash.\0A */\0A#define PSA_ALG_GET_HASH(alg) \5C\0A    (((alg) & 0x000000ff) == 0 ? ((psa_algorithm_t) 0) : 0x02000000 | ((alg) & 0x000000ff))\0A\0A/**@}*/\0A\0A/** \5Cdefgroup key_lifetimes Key lifetimes\0A * @{\0A */\0A\0A/* Note that location and persistence level values are embedded in the\0A * persistent key store, as part of key metadata. As a consequence, they\0A * must not be changed (unless the storage format version changes).\0A */\0A\0A/** The default lifetime for volatile keys.\0A *\0A * A volatile key only exists as long as the identifier to it is not destroyed.\0A * The key material is guaranteed to be erased on a power reset.\0A *\0A * A key with this lifetime is typically stored in the RAM area of the\0A * PSA Crypto subsystem. However this is an implementation choice.\0A * If an implementation stores data about the key in a non-volatile memory,\0A * it must release all the resources associated with the key and erase the\0A * key material if the calling application terminates.\0A */\0A#define PSA_KEY_LIFETIME_VOLATILE               ((psa_key_lifetime_t) 0x00000000)\0A\0A/** The default lifetime for persistent keys.\0A *\0A * A persistent key remains in storage until it is explicitly destroyed or\0A * until the corresponding storage area is wiped. This specification does\0A * not define any mechanism to wipe a storage area, but integrations may\0A * provide their own mechanism (for example to perform a factory reset,\0A * to prepare for device refurbishment, or to uninstall an application).\0A *\0A * This lifetime value is the default storage area for the calling\0A * application. Integrations of Mbed TLS may support other persistent lifetimes.\0A * See ::psa_key_lifetime_t for more information.\0A */\0A#define PSA_KEY_LIFETIME_PERSISTENT             ((psa_key_lifetime_t) 0x00000001)\0A\0A/** The persistence level of volatile keys.\0A *\0A * See ::psa_key_persistence_t for more information.\0A */\0A#define PSA_KEY_PERSISTENCE_VOLATILE            ((psa_key_persistence_t) 0x00)\0A\0A/** The default persistence level for persistent keys.\0A *\0A * See ::psa_key_persistence_t for more information.\0A */\0A#define PSA_KEY_PERSISTENCE_DEFAULT             ((psa_key_persistence_t) 0x01)\0A\0A/** A persistence level indicating that a key is never destroyed.\0A *\0A * See ::psa_key_persistence_t for more information.\0A */\0A#define PSA_KEY_PERSISTENCE_READ_ONLY           ((psa_key_persistence_t) 0xff)\0A\0A#define PSA_KEY_LIFETIME_GET_PERSISTENCE(lifetime)      \5C\0A    ((psa_key_persistence_t) ((lifetime) & 0x000000ff))\0A\0A#define PSA_KEY_LIFETIME_GET_LOCATION(lifetime)      \5C\0A    ((psa_key_location_t) ((lifetime) >> 8))\0A\0A/** Whether a key lifetime indicates that the key is volatile.\0A *\0A * A volatile key is automatically destroyed by the implementation when\0A * the application instance terminates. In particular, a volatile key\0A * is automatically destroyed on a power reset of the device.\0A *\0A * A key that is not volatile is persistent. Persistent keys are\0A * preserved until the application explicitly destroys them or until an\0A * implementation-specific device management event occurs (for example,\0A * a factory reset).\0A *\0A * \5Cparam lifetime      The lifetime value to query (value of type\0A *                      ::psa_key_lifetime_t).\0A *\0A * \5Creturn \5Cc 1 if the key is volatile, otherwise \5Cc 0.\0A */\0A#define PSA_KEY_LIFETIME_IS_VOLATILE(lifetime)  \5C\0A    (PSA_KEY_LIFETIME_GET_PERSISTENCE(lifetime) == \5C\0A     PSA_KEY_PERSISTENCE_VOLATILE)\0A\0A/** Whether a key lifetime indicates that the key is read-only.\0A *\0A * Read-only keys cannot be created or destroyed through the PSA Crypto API.\0A * They must be created through platform-specific means that bypass the API.\0A *\0A * Some platforms may offer ways to destroy read-only keys. For example,\0A * consider a platform with multiple levels of privilege, where a\0A * low-privilege application can use a key but is not allowed to destroy\0A * it, and the platform exposes the key to the application with a read-only\0A * lifetime. High-privilege code can destroy the key even though the\0A * application sees the key as read-only.\0A *\0A * \5Cparam lifetime      The lifetime value to query (value of type\0A *                      ::psa_key_lifetime_t).\0A *\0A * \5Creturn \5Cc 1 if the key is read-only, otherwise \5Cc 0.\0A */\0A#define PSA_KEY_LIFETIME_IS_READ_ONLY(lifetime)  \5C\0A    (PSA_KEY_LIFETIME_GET_PERSISTENCE(lifetime) == \5C\0A     PSA_KEY_PERSISTENCE_READ_ONLY)\0A\0A/** Construct a lifetime from a persistence level and a location.\0A *\0A * \5Cparam persistence   The persistence level\0A *                      (value of type ::psa_key_persistence_t).\0A * \5Cparam location      The location indicator\0A *                      (value of type ::psa_key_location_t).\0A *\0A * \5Creturn The constructed lifetime value.\0A */\0A#define PSA_KEY_LIFETIME_FROM_PERSISTENCE_AND_LOCATION(persistence, location) \5C\0A    ((location) << 8 | (persistence))\0A\0A/** The local storage area for persistent keys.\0A *\0A * This storage area is available on all systems that can store persistent\0A * keys without delegating the storage to a third-party cryptoprocessor.\0A *\0A * See ::psa_key_location_t for more information.\0A */\0A#define PSA_KEY_LOCATION_LOCAL_STORAGE          ((psa_key_location_t) 0x000000)\0A\0A#define PSA_KEY_LOCATION_VENDOR_FLAG            ((psa_key_location_t) 0x800000)\0A\0A/* Note that key identifier values are embedded in the\0A * persistent key store, as part of key metadata. As a consequence, they\0A * must not be changed (unless the storage format version changes).\0A */\0A\0A/** The null key identifier.\0A */\0A/* *INDENT-OFF* (https://github.com/ARM-software/psa-arch-tests/issues/337) */\0A#define PSA_KEY_ID_NULL                         ((psa_key_id_t)0)\0A/* *INDENT-ON* */\0A/** The minimum value for a key identifier chosen by the application.\0A */\0A#define PSA_KEY_ID_USER_MIN                     ((psa_key_id_t) 0x00000001)\0A/** The maximum value for a key identifier chosen by the application.\0A */\0A#define PSA_KEY_ID_USER_MAX                     ((psa_key_id_t) 0x3fffffff)\0A/** The minimum value for a key identifier chosen by the implementation.\0A */\0A#define PSA_KEY_ID_VENDOR_MIN                   ((psa_key_id_t) 0x40000000)\0A/** The maximum value for a key identifier chosen by the implementation.\0A */\0A#define PSA_KEY_ID_VENDOR_MAX                   ((psa_key_id_t) 0x7fffffff)\0A\0A\0A#if !defined(MBEDTLS_PSA_CRYPTO_KEY_ID_ENCODES_OWNER)\0A\0A#define MBEDTLS_SVC_KEY_ID_INIT ((psa_key_id_t) 0)\0A#define MBEDTLS_SVC_KEY_ID_GET_KEY_ID(id) (id)\0A#define MBEDTLS_SVC_KEY_ID_GET_OWNER_ID(id) (0)\0A\0A/** Utility to initialize a key identifier at runtime.\0A *\0A * \5Cparam unused  Unused parameter.\0A * \5Cparam key_id  Identifier of the key.\0A */\0Astatic inline mbedtls_svc_key_id_t mbedtls_svc_key_id_make(\0A    unsigned int unused, psa_key_id_t key_id)\0A{\0A    (void) unused;\0A\0A    return key_id;\0A}\0A\0A/** Compare two key identifiers.\0A *\0A * \5Cparam id1 First key identifier.\0A * \5Cparam id2 Second key identifier.\0A *\0A * \5Creturn Non-zero if the two key identifier are equal, zero otherwise.\0A */\0Astatic inline int mbedtls_svc_key_id_equal(mbedtls_svc_key_id_t id1,\0A                                           mbedtls_svc_key_id_t id2)\0A{\0A    return id1 == id2;\0A}\0A\0A/** Check whether a key identifier is null.\0A *\0A * \5Cparam key Key identifier.\0A *\0A * \5Creturn Non-zero if the key identifier is null, zero otherwise.\0A */\0Astatic inline int mbedtls_svc_key_id_is_null(mbedtls_svc_key_id_t key)\0A{\0A    return key == 0;\0A}\0A\0A#else /* MBEDTLS_PSA_CRYPTO_KEY_ID_ENCODES_OWNER */\0A\0A#define MBEDTLS_SVC_KEY_ID_INIT ((mbedtls_svc_key_id_t){ 0, 0 })\0A#define MBEDTLS_SVC_KEY_ID_GET_KEY_ID(id) ((id).MBEDTLS_PRIVATE(key_id))\0A#define MBEDTLS_SVC_KEY_ID_GET_OWNER_ID(id) ((id).MBEDTLS_PRIVATE(owner))\0A\0A/** Utility to initialize a key identifier at runtime.\0A *\0A * \5Cparam owner_id Identifier of the key owner.\0A * \5Cparam key_id   Identifier of the key.\0A */\0Astatic inline mbedtls_svc_key_id_t mbedtls_svc_key_id_make(\0A    mbedtls_key_owner_id_t owner_id, psa_key_id_t key_id)\0A{\0A    return (mbedtls_svc_key_id_t){ .MBEDTLS_PRIVATE(key_id) = key_id,\0A                                   .MBEDTLS_PRIVATE(owner) = owner_id };\0A}\0A\0A/** Compare two key identifiers.\0A *\0A * \5Cparam id1 First key identifier.\0A * \5Cparam id2 Second key identifier.\0A *\0A * \5Creturn Non-zero if the two key identifier are equal, zero otherwise.\0A */\0Astatic inline int mbedtls_svc_key_id_equal(mbedtls_svc_key_id_t id1,\0A                                           mbedtls_svc_key_id_t id2)\0A{\0A    return (id1.MBEDTLS_PRIVATE(key_id) == id2.MBEDTLS_PRIVATE(key_id)) &&\0A           mbedtls_key_owner_id_equal(id1.MBEDTLS_PRIVATE(owner), id2.MBEDTLS_PRIVATE(owner));\0A}\0A\0A/** Check whether a key identifier is null.\0A *\0A * \5Cparam key Key identifier.\0A *\0A * \5Creturn Non-zero if the key identifier is null, zero otherwise.\0A */\0Astatic inline int mbedtls_svc_key_id_is_null(mbedtls_svc_key_id_t key)\0A{\0A    return key.MBEDTLS_PRIVATE(key_id) == 0;\0A}\0A\0A#endif /* !MBEDTLS_PSA_CRYPTO_KEY_ID_ENCODES_OWNER */\0A\0A/**@}*/\0A\0A/** \5Cdefgroup policy Key policies\0A * @{\0A */\0A\0A/* Note that key usage flags are embedded in the\0A * persistent key store, as part of key metadata. As a consequence, they\0A * must not be changed (unless the storage format version changes).\0A */\0A\0A/** Whether the key may be exported.\0A *\0A * A public key or the public part of a key pair may always be exported\0A * regardless of the value of this permission flag.\0A *\0A * If a key does not have export permission, implementations shall not\0A * allow the key to be exported in plain form from the cryptoprocessor,\0A * whether through psa_export_key() or through a proprietary interface.\0A * The key may however be exportable in a wrapped form, i.e. in a form\0