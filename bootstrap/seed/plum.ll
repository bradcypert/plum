\0A\0A        default:\0A            return MBEDTLS_ERR_RSA_INVALID_PADDING;\0A    }\0A}\0A\0A/*\0A * Copy the components of an RSA key\0A */\0Aint mbedtls_rsa_copy(mbedtls_rsa_context *dst, const mbedtls_rsa_context *src)\0A{\0A    int ret = MBEDTLS_ERR_ERROR_CORRUPTION_DETECTED;\0A\0A    dst->len = src->len;\0A\0A    MBEDTLS_MPI_CHK(mbedtls_mpi_copy(&dst->N, &src->N));\0A    MBEDTLS_MPI_CHK(mbedtls_mpi_copy(&dst->E, &src->E));\0A\0A    MBEDTLS_MPI_CHK(mbedtls_mpi_copy(&dst->D, &src->D));\0A    MBEDTLS_MPI_CHK(mbedtls_mpi_copy(&dst->P, &src->P));\0A    MBEDTLS_MPI_CHK(mbedtls_mpi_copy(&dst->Q, &src->Q));\0A\0A#if !defined(MBEDTLS_RSA_NO_CRT)\0A    MBEDTLS_MPI_CHK(mbedtls_mpi_copy(&dst->DP, &src->DP));\0A    MBEDTLS_MPI_CHK(mbedtls_mpi_copy(&dst->DQ, &src->DQ));\0A    MBEDTLS_MPI_CHK(mbedtls_mpi_copy(&dst->QP, &src->QP));\0A    MBEDTLS_MPI_CHK(mbedtls_mpi_copy(&dst->RP, &src->RP));\0A    MBEDTLS_MPI_CHK(mbedtls_mpi_copy(&dst->RQ, &src->RQ));\0A#endif\0A\0A    MBEDTLS_MPI_CHK(mbedtls_mpi_copy(&dst->RN, &src->RN));\0A\0A    MBEDTLS_MPI_CHK(mbedtls_mpi_copy(&dst->Vi, &src->Vi));\0A    MBEDTLS_MPI_CHK(mbedtls_mpi_copy(&dst->Vf, &src->Vf));\0A\0A    dst->padding = src->padding;\0A    dst->hash_id = src->hash_id;\0A\0Acleanup:\0A    if (ret != 0) {\0A        mbedtls_rsa_free(dst);\0A    }\0A\0A    return ret;\0A}\0A\0A/*\0A * Free the components of an RSA key\0A */\0Avoid mbedtls_rsa_free(mbedtls_rsa_context *ctx)\0A{\0A    if (ctx == NULL) {\0A        return;\0A    }\0A\0A    mbedtls_mpi_free(&ctx->Vi);\0A    mbedtls_mpi_free(&ctx->Vf);\0A    mbedtls_mpi_free(&ctx->RN);\0A    mbedtls_mpi_free(&ctx->D);\0A    mbedtls_mpi_free(&ctx->Q);\0A    mbedtls_mpi_free(&ctx->P);\0A    mbedtls_mpi_free(&ctx->E);\0A    mbedtls_mpi_free(&ctx->N);\0A\0A#if !defined(MBEDTLS_RSA_NO_CRT)\0A    mbedtls_mpi_free(&ctx->RQ);\0A    mbedtls_mpi_free(&ctx->RP);\0A    mbedtls_mpi_free(&ctx->QP);\0A    mbedtls_mpi_free(&ctx->DQ);\0A    mbedtls_mpi_free(&ctx->DP);\0A#endif /* MBEDTLS_RSA_NO_CRT */\0