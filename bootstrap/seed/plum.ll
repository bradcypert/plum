et.new(()))\0A\0A// --- JSON ---\0A\0A/// Mirrored from `crates/plumc/src/lib.rs`'s STDLIB_JSON_SRC, minus its\0A/// own `chars_of` (the runtime already provides that one, since it is the\0A/// single thing this prelude cannot write in Plum). Everything else is\0A/// character-for-character the real compiler's, so the two agree on\0A/// number formatting, escape handling and parse errors by construction\0A/// rather than by inspection.\0Apub struct JsonEntry { pub key: String, pub value: JsonValue }\0A/// A parsed JSON document.\0A///\0A/// Faithful to what was written: numbers are all `Float`, since JSON\0A/// has one number type. `use Json;` brings in decoders that turn one\0A/// of these into your own types.\0Apub enum JsonValue {\0A    JsonNull,\0A    JsonBool(Bool),\0A    JsonNumber(Float),\0A    JsonString(String),\0A    JsonArray(Array[JsonValue]),\0A    JsonObject(Array[JsonEntry]),\0A}\0A/// What a JSON parse step consumed: a value, and where to carry on\0A/// from. Public because the parser's own pieces return it; a caller\0A/// wants `json_parse`.\0Apub struct ParseResult[T] { pub value: T, pub next_pos: Int }\0A\0Alet skip_ws (chars: Array[String]) (pos: Int): Int =\0A    if pos >= chars.len() { pos }\0A    else {\0A        let c = chars[pos];\0A        if c == \22 \22 || c == \22\5Ct\22 || c == \22\5Cn\22 || c == \22\5Cr\22 { skip_ws(chars, pos + 1) } else { pos }\0A    }\0A\0Alet digit_value (c: String): Result[Float, String] =\0A    if c == \220\22 { Ok(0.0) }\0A    else if c == \221\22 { Ok(1.0) }\0A    else if c == \222\22 { Ok(2.0) }\0A    else if c == \223\22 { Ok(3.0) }\0A    else if c == \224\22 { Ok(4.0) }\0A    else if c == \225\22 { Ok(5.0) }\0A    else if c == \226\22 { Ok(6.0) }\0A    else if c == \227\22 { Ok(7.0) }\0A    else if c == \228\22 { Ok(8.0) }\0A    else if c == \229\22 { Ok(9.0) }\0A    else { Err(\22not a digit\22) }\0A\0Alet pow10 (n: Int): Float = if n <= 0 { 1.0 } else { pow10(n - 1) * 10.0 }\0Alet pow10_float (n: Float): F