s are incompatible, allow nothing. */\0A    return 0;\0A}\0A\0Astatic int psa_key_algorithm_permits(psa_key_type_t key_type,\0A                                     psa_algorithm_t policy_alg,\0A                                     psa_algorithm_t requested_alg)\0A{\0A    /* Common case: the policy only allows requested_alg. */\0A    if (requested_alg == policy_alg) {\0A        return 1;\0A    }\0A    /* If policy_alg is a hash-and-sign with a wildcard for the hash,\0A     * and requested_alg is the same hash-and-sign family with any hash,\0A     * then requested_alg is compliant with policy_alg. */\0A    if (PSA_ALG_IS_SIGN_HASH(requested_alg) &&\0A        PSA_ALG_SIGN_GET_HASH(policy_alg) == PSA_ALG_ANY_HASH) {\0A        return (policy_alg & ~PSA_ALG_HASH_MASK) ==\0A               (requested_alg & ~PSA_ALG_HASH_MASK);\0A    }\0A    /* If policy_alg is a wildcard AEAD algorithm of the same base as\0A     * the requested algorithm, check the requested tag length to be\0A     * equal-length or longer than the wildcard-specified length. */\0A    if (PSA_ALG_IS_AEAD(policy_alg) &&\0A        PSA_ALG_IS_AEAD(requested_alg) &&\0A        (PSA_ALG_AEAD_WITH_SHORTENED_TAG(policy_alg, 0) ==\0A         PSA_ALG_AEAD_WITH_SHORTENED_TAG(requested_alg, 0)) &&\0A        ((policy_alg & PSA_ALG_AEAD_AT_LEAST_THIS_LENGTH_FLAG) != 0)) {\0A        return PSA_ALG_AEAD_GET_TAG_LENGTH(policy_alg) <=\0A               PSA_ALG_AEAD_GET_TAG_LENGTH(requested_alg);\0A    }\0A    /* If policy_alg is a MAC algorithm of the same base as the requested\0A     * algorithm, check whether their MAC lengths are compatible. */\0A    if (PSA_ALG_IS_MAC(policy_alg) &&\0A        PSA_ALG_IS_MAC(requested_alg) &&\0A        (PSA_ALG_FULL_LENGTH_MAC(policy_alg) ==\0A         PSA_ALG_FULL_LENGTH_MAC(requested_alg))) {\0A        /* Validate the combination of key type and algorithm. Since the policy\0A         * and requested algorithms are the same, we only need this once. */\0A        if (PSA_SUCCESS != psa_mac_key_can_do(policy_alg, key_type)) {\0A            return 0;\0A        }\0A\0A        /* Get both the requested output length for the algorithm which is to be\0A         * verified, and the default output length for the base algorithm.\0A         * Note that none of the currently supported algorithms have an output\0A         * length dependent on actual key size, so setting it to a bogus value\0A         * of 0 is currently OK. */\0A        size_t requested_output_length = PSA_MAC_LENGTH(\0A            key_type, 0, requested_alg);\0A        size_t default_output_length = PSA_MAC_LENGTH(\0A            key_type, 0,\0A            PSA_ALG_FULL_LENGTH_MAC(requested_alg));\0A\0A        /* If the policy is default-length, only allow an algorithm with\0A         * a declared exact-length matching the default. */\0A        if (PSA_MAC_TRUNCATED_LENGTH(policy_alg) == 0) {\0A            return requested_output_length == default_output_length;\0A        }\0A\0A        /* If the requested algorithm is default-length, allow it if the policy\0A         * length exactly matches the default length. */\0A        if (PSA_MAC_TRUNCATED_LENGTH(requested_alg) == 0 &&\0A            PSA_MAC_TRUNCATED_LENGTH(policy_alg) == default_output_length) {\0A            return 1;\0A        }\0A\0A        /* If policy_alg is an at-least-this-length wildcard MAC algorithm,\0A         * check for the requested MAC length to be equal to or longer than the\0A         * minimum allowed length. */\0A        if ((policy_alg & PSA_ALG_MAC_AT_LEAST_THIS_LENGTH_FLAG) != 0) {\0A            return PSA_MAC_TRUNCATED_LENGTH(policy_alg) <=\0A                   requested_output_length;\0A        }\0A    }\0A    /* If policy_alg is a generic key agreement operation, then using it for\0A     * a key derivation with that key agreement should also be allowed. This\0A     * behaviour is expected to be defined in a future specification version. */\0A    if (PSA_ALG_IS_RAW_KEY_AGREEMENT(policy_alg) &&\0A        PSA_ALG_IS_K