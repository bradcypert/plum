_len != 0) {\0A            return MBEDTLS_ERR_CIPHER_BAD_INPUT_DATA;\0A        }\0A\0A        (void) iv;\0A        (void) ad;\0A\0A        return mbedtls_nist_kw_unwrap(ctx->cipher_ctx, mode, input, ilen,\0A                                      output, olen, output_len);\0A    }\0A#endif /* MBEDTLS_NIST_KW_C */\0A\0A#if defined(MBEDTLS_CIPHER_MODE_AEAD)\0A    /* AEAD case: check length before passing on to shared function */\0A    if (ilen < tag_len || output_len < ilen - tag_len) {\0A        return MBEDTLS_ERR_CIPHER_BAD_INPUT_DATA;\0A    }\0A\0A    return mbedtls_cipher_aead_decrypt(ctx, iv, iv_len, ad, ad_len,\0A                                       input, ilen - tag_len, output, olen,\0A                                       input + ilen - tag_len, tag_len);\0A#else\0A    return MBEDTLS_ERR_CIPHER_FEATURE_UNAVAILABLE;\0A#endif /* MBEDTLS_CIPHER_MODE_AEAD */\0A}\0A#endif /* MBEDTLS_CIPHER_MODE_AEAD || MBEDTLS_NIST_KW_C */\0A\0A#endif /* MBEDTLS_CIPHER_C */\0A\00" }
