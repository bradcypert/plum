@.str45300 = private global { i64, i64, [7502 x i8] } { i64 -1, i64 7501, [7502 x i8] c"/**\0A * \5Cfile sha1.h\0A *\0A * \5Cbrief This file contains SHA-1 definitions and functions.\0A *\0A * The Secure Hash Algorithm 1 (SHA-1) cryptographic hash function is defined in\0A * <em>FIPS 180-4: Secure Hash Standard (SHS)</em>.\0A *\0A * \5Cwarning   SHA-1 is considered a weak message digest and its use constitutes\0A *            a security risk. We recommend considering stronger message\0A *            digests instead.\0A */\0A/*\0A *  Copyright The Mbed TLS Contributors\0A *  SPDX-License-Identifier: Apache-2.0 OR GPL-2.0-or-later\0A */\0A#ifndef MBEDTLS_SHA1_H\0A#define MBEDTLS_SHA1_H\0A#include \22mbedtls/private_access.h\22\0A\0A#include \22mbedtls/build_info.h\22\0A\0A#include <stddef.h>\0A#include <stdint.h>\0A\0A/** SHA-1 input data was malformed. */\0A#define MBEDTLS_ERR_SHA1_BAD_INPUT_DATA                   -0x0073\0A\0A#ifdef __cplusplus\0Aextern \22C\22 {\0A#endif\0A\0A#if !defined(MBEDTLS_SHA1_ALT)\0A// Regular implementation\0A//\0A\0A/**\0A * \5Cbrief          The SHA-1 context structure.\0A *\0A * \5Cwarning        SHA-1 is considered a weak message digest and its use\0A *                 constitutes a security risk. We recommend considering\0A *                 stronger message digests instead.\0A *\0A */\0Atypedef struct mbedtls_sha1_context {\0A    uint32_t MBEDTLS_PRIVATE(total)[2];          /*!< The number of Bytes processed.  */\0A    uint32_t MBEDTLS_PRIVATE(state)[5];          /*!< The intermediate digest state.  */\0A    unsigned char MBEDTLS_PRIVATE(buffer)[64];   /*!< The data block being processed. */\0A}\0Ambedtls_sha1_context;\0A\0A#else  /* MBEDTLS_SHA1_ALT */\0A#include \22sha1_alt.h\22\0A#endif /* MBEDTLS_SHA1_ALT */\0A\0A/**\0A * \5Cbrief          This function initializes a SHA-1 context.\0A *\0A * \5Cwarning        SHA-1 is considered a weak message digest and its use\0A *                 constitutes a security risk. We recommend considering\0A *                 stronger message digests instead.\0A *\0A * \5Cparam ctx      The SHA-1 context to initialize.\0A *                 This must not be \5Cc NULL.\0A *\0A */\0Avoid mbedtls_sha1_init(mbedtls_sha1_context *ctx);\0A\0A/**\0A * \5Cbrief          This function clears a SHA-1 context.\0A *\0A * \5Cwarning        SHA-1 is considered a weak message digest and its use\0A *                 constitutes a security risk. We recommend considering\0A *                 stronger message digests instead.\0A *\0A * \5Cparam ctx      The SHA-1 context to clear. This may be \5Cc NULL,\0A *                 in which case this function does nothing. If it is\0A *                 not \5Cc NULL, it must point to an initialized\0A *                 SHA-1 context.\0A *\0A */\0Avoid mbedtls_sha1_free(mbedtls_sha1_context *ctx);\0A\0A/**\0A * \5Cbrief          This function clones the state of a SHA-1 context.\0A *\0A * \5Cwarning        SHA-1 is considered a weak message digest and its use\0A *                 constitutes a security risk. We recommend considering\0A *                 stronger message digests instead.\0A *\0A * \5Cparam dst      The SHA-1 context to clone to. This must be initialized.\0A * \5Cparam src      The SHA-1 context to clone from. This must be initialized.\0A *\0A */\0Avoid mbedtls_sha1_clone(mbedtls_sha1_context *dst,\0A                        const mbedtls_sha1_context *src);\0A\0A/**\0A * \5Cbrief          This function starts a SHA-1 checksum calculation.\0A *\0A * \5Cwarning        SHA-1 is considered a weak message digest and its use\0A *                 constitutes a security risk. We recommend considering\0A *                 stronger message digests instead.\0A *\0A * \5Cparam ctx      The SHA-1 context to initialize. This must be initialized.\0A *\0A * \5Creturn         \5Cc 0 on success.\0A * \5Creturn         A negative error code on failure.\0A *\0A */\0Aint mbedtls_sha1_starts(mbedtls_sha1_context *ctx);\0A\0A/**\0A * \5Cbrief          This function feeds an input buffer into an ongoing SHA-1\0A *                 checksum calculation.\0A *\0A * \5Cwarning        SHA-1 is considered a weak message digest and its use\0A *                 constitutes a security risk. We recommend considering\0A *                 stronger message digests instead.\0A *\0A * \5Cparam ctx      The SHA-1 context. This must be initialized\0A *                 and have a hash operation started.\0A * \5Cparam input    The buffer holding the input data.\0A *                 This must be a readable buffer of length \5Cp ilen Bytes.\0A * \5Cparam ilen     The length of the input data \5Cp input in Bytes.\0A *\0A * \5Creturn         \5Cc 0 on success.\0A * \5Creturn         A negative error code on failure.\0A */\0Aint mbedtls_sha1_update(mbedtls_sha1_context *ctx,\0A                        const unsigned char *input,\0A                        size_t ilen);\0A\0A/**\0A * \5Cbrief          This function finishes the SHA-1 operation, and writes\0A *                 the result to the output buffer.\0A *\0A * \5Cwarning        SHA-1 is considered a weak message digest and its use\0A *                 constitutes a security risk. We recommend considering\0A *                 stronger message digests instead.\0A *\0A * \5Cparam ctx      The SHA-1 context to use. This must be initialized and\0A *                 have a hash operation started.\0A * \5Cparam output   The SHA-1 checksum result. This must be a writable\0A *                 buffer of length \5Cc 20 Bytes.\0A *\0A * \5Creturn         \5Cc 0 on success.\0A * \5Creturn         A negative error code on failure.\0A */\0Aint mbedtls_sha1_finish(mbedtls_sha1_context *ctx,\0A                        unsigned char output[20]);\0A\0A/**\0A * \5Cbrief          SHA-1 process data block (internal use only).\0A *\0A * \5Cwarning        SHA-1 is considered a weak message digest and its use\0A *                 constitutes a security risk. We recommend considering\0A *                 stronger message digests instead.\0A *\0A * \5Cparam ctx      The SHA-1 context to use. This must be initialized.\0A * \5Cparam data     The data block being processed. This must be a\0A *                 readable buffer of length \5Cc 64 Bytes.\0A *\0A * \5Creturn         \5Cc 0 on success.\0A * \5Creturn         A negative error code on failure.\0A *\0A */\0Aint mbedtls_internal_sha1_process(mbedtls_sha1_context *ctx,\0A                                  const unsigned char data[64]);\0A\0A/**\0A * \5Cbrief          This function calculates the SHA-1 checksum of a buffer.\0A *\0A *                 The function allocates the context, performs the\0A *                 calculation, and frees the context.\0A *\0A *                 The SHA-1 result is calculated as\0A *                 output = SHA-1(input buffer).\0A *\0A * \5Cwarning        SHA-1 is considered a weak message digest and its use\0A *                 constitutes a security risk. We recommend considering\0A *                 stronger message digests instead.\0A *\0A * \5Cparam input    The buffer holding the input data.\0A *                 This must be a readable buffer of length \5Cp ilen Bytes.\0A * \5Cparam ilen     The length of the input data \5Cp input in Bytes.\0A * \5Cparam output   The SHA-1 checksum result.\0A *                 This must be a writable buffer of length \5Cc 20 Bytes.\0A *\0A * \5Creturn         \5Cc 0 on success.\0A * \5Creturn         A negative error code on failure.\0A *\0A */\0Aint mbedtls_sha1(const unsigned char *input,\0A                 size_t ilen,\0A                 unsigned char output[20]);\0A\0A#if defined(MBEDTLS_SELF_TEST)\0A\0A/**\0A * \5Cbrief          The SHA-1 checkup routine.\0A *\0A * \5Cwarning        SHA-1 is considered a weak message digest and its use\0A *                 constitutes a security risk. We recommend considering\0A *                 stronger message digests instead.\0A *\0A * \5Creturn         \5Cc 0 on success.\0A * \5Creturn         \5Cc 1 on failure.\0A *\0A */\0Aint mbedtls_sha1_self_test(int verbose);\0A\0A#endif /* MBEDTLS_SELF_TEST */\0A\0A#ifdef __cplusplus\0A}\0A#endif\0A\0A#endif /* mbedtls_sha1.h */\0A\00" }
