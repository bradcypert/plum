        rs_ctx->ecp.depth--;                                         \5C\0A} while (0)\0A\0A#else /* MBEDTLS_ECP_RESTARTABLE */\0A\0A#define ECDSA_RS_ECP    NULL\0A\0A#define ECDSA_BUDGET(ops)     /* no-op; for compatibility */\0A\0A#define ECDSA_RS_ENTER(SUB)   (void) rs_ctx\0A#define ECDSA_RS_LEAVE(SUB)   (void) rs_ctx\0A\0A#endif /* MBEDTLS_ECP_RESTARTABLE */\0A\0A#if defined(MBEDTLS_ECDSA_DETERMINISTIC) || \5C\0A    !defined(MBEDTLS_ECDSA_SIGN_ALT)     || \5C\0A    !defined(MBEDTLS_ECDSA_VERIFY_ALT)\0A/*\0A * Derive a suitable integer for group grp from a buffer of length len\0A * SEC1 4.1.3 step 5 aka SEC1 4.1.4 step 3\0A */\0Astatic int derive_mpi(const mbedtls_ecp_group *grp, mbedtls_mpi *x,\0A                      const unsigned char *buf, size_t blen)\0A{\0A    int ret = MBEDTLS_ERR_ERROR_CORRUPTION_DETECTED;\0A    size_t n_size = (grp->nbits + 7) / 8;\0A    size_t use_size = blen > n_size ? n_size : blen;\0A\0A    MBEDTLS_MPI_CHK(mbedtls_mpi_read_binary(x, buf, use_size));\0A    if (use_size * 8 > grp->nbits) {\0A        MBEDTLS_MPI_CHK(mbedtls_mpi_shift_r(x, use_size * 8 - grp->nbits));\0A    }\0A\0A    /* While at it, reduce modulo N */\0A    if (mbedtls_mpi_cmp_mpi(x, &grp->N) >= 0) {\0A        MBEDTLS_MPI_CHK(mbedtls_mpi_sub_mpi(x, x, &grp->N));\0A    }\0A\0Acleanup:\0A    return ret;\0A}\0A#endif /* ECDSA_DETERMINISTIC || !ECDSA_SIGN_ALT || !ECDSA_VERIFY_ALT */\0A\0Aint mbedtls_ecdsa_can_do(mbedtls_ecp_group_id gid)\0A{\0A    switch (gid) {\0A#ifdef MBEDTLS_ECP_DP_CURVE25519_ENABLED\0A        case MBEDTLS_ECP_DP_CURVE25519: return 0;\0A#endif\0A#ifdef MBEDTLS_ECP_DP_CURVE448_ENABLED\0A        case MBEDTLS_ECP_DP_CURVE448: return 0;\0A#endif\0A        default: return 1;\0A    }\0A}\0A\0A#if !defined(MBEDTLS_ECDSA_SIGN_ALT)\0A/*\0A * Compute ECDSA signature of a hashed message (SEC1 4.1.3)\0A * Obviously, compared to SEC1 4.1.3, we skip step 4 (hash message)\0A */\0Aint mbedtls_ecdsa_sign_restartable(mbedtls_ecp_group *grp,\0A                           