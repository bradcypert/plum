@.str40095 = private global { i64, i64, [25450 x i8] } { i64 -1, i64 25449, [25450 x i8] c"/**\0A * \5Cfile ctr_drbg.h\0A *\0A * \5Cbrief    This file contains definitions and functions for the\0A *           CTR_DRBG pseudorandom generator.\0A *\0A * CTR_DRBG is a standardized way of building a PRNG from a block-cipher\0A * in counter mode operation, as defined in <em>NIST SP 800-90A:\0A * Recommendation for Random Number Generation Using Deterministic Random\0A * Bit Generators</em>.\0A *\0A * The Mbed TLS implementation of CTR_DRBG uses AES-256 (default) or AES-128\0A * (if \5Cc MBEDTLS_CTR_DRBG_USE_128_BIT_KEY is enabled at compile time)\0A * as the underlying block cipher, with a derivation function.\0A *\0A * The security strength as defined in NIST SP 800-90A is\0A * 128 bits when AES-128 is used (\5Cc MBEDTLS_CTR_DRBG_USE_128_BIT_KEY enabled)\0A * and 256 bits otherwise, provided that #MBEDTLS_CTR_DRBG_ENTROPY_LEN is\0A * kept at its default value (and not overridden in mbedtls_config.h) and that the\0A * DRBG instance is set up with default parameters.\0A * See the documentation of mbedtls_ctr_drbg_seed() for more\0A * information.\0A */\0A/*\0A *  Copyright The Mbed TLS Contributors\0A *  SPDX-License-Identifier: Apache-2.0 OR GPL-2.0-or-later\0A */\0A\0A#ifndef MBEDTLS_CTR_DRBG_H\0A#define MBEDTLS_CTR_DRBG_H\0A#include \22mbedtls/private_access.h\22\0A\0A#include \22mbedtls/build_info.h\22\0A\0A/* The CTR_DRBG implementation can either directly call the low-level AES\0A * module (gated by MBEDTLS_AES_C) or call the PSA API to perform AES\0A * operations. Calling the AES module directly is the default, both for\0A * maximum backward compatibility and because it's a bit more efficient\0A * (less glue code).\0A *\0A * When MBEDTLS_AES_C is disabled, the CTR_DRBG module calls PSA crypto and\0A * thus benefits from the PSA AES accelerator driver.\0A * It is technically possible to enable MBEDTLS_CTR_DRBG_USE_PSA_CRYPTO\0A * to use PSA even when MBEDTLS_AES_C is enabled, but there is very little\0A * reason to do so other than testing purposes and this is not officially\0A * supported.\0A */\0A#if !defined(MBEDTLS_AES_C)\0A#define MBEDTLS_CTR_DRBG_USE_PSA_CRYPTO\0A#endif\0A\0A#if defined(MBEDTLS_CTR_DRBG_USE_PSA_CRYPTO)\0A#include \22psa/crypto.h\22\0A#else\0A#include \22mbedtls/aes.h\22\0A#endif\0A\0A#include \22entropy.h\22\0A\0A#if defined(MBEDTLS_THREADING_C)\0A#include \22mbedtls/threading.h\22\0A#endif\0A\0A/** The entropy source failed. */\0A#define MBEDTLS_ERR_CTR_DRBG_ENTROPY_SOURCE_FAILED        -0x0034\0A/** The requested random buffer length is too big. */\0A#define MBEDTLS_ERR_CTR_DRBG_REQUEST_TOO_BIG              -0x0036\0A/** The input (entropy + additional data) is too large. */\0A#define MBEDTLS_ERR_CTR_DRBG_INPUT_TOO_BIG                -0x0038\0A/** Read or write error in file. */\0A#define MBEDTLS_ERR_CTR_DRBG_FILE_IO_ERROR                -0x003A\0A\0A#define MBEDTLS_CTR_DRBG_BLOCKSIZE          16 /**< The block size used by the cipher. */\0A\0A#if defined(MBEDTLS_CTR_DRBG_USE_128_BIT_KEY)\0A#define MBEDTLS_CTR_DRBG_KEYSIZE            16\0A/**< The key size in bytes used by the cipher.\0A *\0A * Compile-time choice: 16 bytes (128 bits)\0A * because #MBEDTLS_CTR_DRBG_USE_128_BIT_KEY is enabled.\0A */\0A#else\0A#define MBEDTLS_CTR_DRBG_KEYSIZE            32\0A/**< The key size in bytes used by the cipher.\0A *\0A * Compile-time choice: 32 bytes (256 bits)\0A * because \5Cc MBEDTLS_CTR_DRBG_USE_128_BIT_KEY is disabled.\0A */\0A#endif\0A\0A#define MBEDTLS_CTR_DRBG_KEYBITS            (MBEDTLS_CTR_DRBG_KEYSIZE * 8)   /**< The key size for the DRBG operation, in bits. */\0A#define MBEDTLS_CTR_DRBG_SEEDLEN            (MBEDTLS_CTR_DRBG_KEYSIZE + MBEDTLS_CTR_DRBG_BLOCKSIZE)   /**< The seed length, calculated as (counter + AES key). */\0A\0A/**\0A * \5Cname SECTION: Module settings\0A *\0A * The configuration options you can set for this module are in this section.\0A * Either change them in mbedtls_config.h or define them using the compiler command\0A * line.\0A * \5C{\0A */\0A\0A/** \5Cdef MBEDTLS_CTR_DRBG_ENTROPY_LEN\0A *\0A * \5Cbrief The amount of entropy used per seed by default, in bytes.\0A */\0A#if !defined(MBEDTLS_CTR_DRBG_ENTROPY_LEN)\0A#if defined(MBEDTLS_ENTROPY_SHA512_ACCUMULATOR)\0A/** This is 48 bytes because the entropy module uses SHA-512.\0A */\0A#define MBEDTLS_CTR_DRBG_ENTROPY_LEN        48\0A\0A#else /* MBEDTLS_ENTROPY_SHA512_ACCUMULATOR */\0A\0A/** This is 32 bytes because the entropy module uses SHA-256.\0A */\0A#if !defined(MBEDTLS_CTR_DRBG_USE_128_BIT_KEY)\0A/** \5Cwarning To achieve a 256-bit security strength, you must pass a nonce\0A *           to mbedtls_ctr_drbg_seed().\0A */\0A#endif /* !defined(MBEDTLS_CTR_DRBG_USE_128_BIT_KEY) */\0A#define MBEDTLS_CTR_DRBG_ENTROPY_LEN        32\0A#endif /* MBEDTLS_ENTROPY_SHA512_ACCUMULATOR */\0A#endif /* !defined(MBEDTLS_CTR_DRBG_ENTROPY_LEN) */\0A\0A#if !defined(MBEDTLS_CTR_DRBG_RESEED_INTERVAL)\0A#define MBEDTLS_CTR_DRBG_RESEED_INTERVAL    10000\0A/**< The interval before reseed is performed by default. */\0A#endif\0A\0A#if !defined(MBEDTLS_CTR_DRBG_MAX_INPUT)\0A#define MBEDTLS_CTR_DRBG_MAX_INPUT          256\0A/**< The maximum number of additional input Bytes. */\0A#endif\0A\0A#if !defined(MBEDTLS_CTR_DRBG_MAX_REQUEST)\0A#define MBEDTLS_CTR_DRBG_MAX_REQUEST        1024\0A/**< The maximum number of requested Bytes per call. */\0A#endif\0A\0A#if !defined(MBEDTLS_CTR_DRBG_MAX_SEED_INPUT)\0A#define MBEDTLS_CTR_DRBG_MAX_SEED_INPUT     384\0A/**< The maximum size of seed or reseed buffer in bytes. */\0A#endif\0A\0A/** \5C} name SECTION: Module settings */\0A\0A#define MBEDTLS_CTR_DRBG_PR_OFF             0\0A/**< Prediction resistance is disabled. */\0A#define MBEDTLS_CTR_DRBG_PR_ON              1\0A/**< Prediction resistance is enabled. */\0A\0A#ifdef __cplusplus\0Aextern \22C\22 {\0A#endif\0A\0A#if MBEDTLS_CTR_DRBG_ENTROPY_LEN >= MBEDTLS_CTR_DRBG_KEYSIZE * 3 / 2\0A/** The default length of the nonce read from the entropy source.\0A *\0A * This is \5Cc 0 because a single read from the entropy source is sufficient\0A * to include a nonce.\0A * See the documentation of mbedtls_ctr_drbg_seed() for more information.\0A */\0A#define MBEDTLS_CTR_DRBG_ENTROPY_NONCE_LEN 0\0A#else\0A/** The default length of the nonce read from the entropy source.\0A *\0A * This is half of the default entropy length because a single read from\0A * the entropy source does not provide enough material to form a nonce.\0A * See the documentation of mbedtls_ctr_drbg_seed() for more information.\0A */\0A#define MBEDTLS_CTR_DRBG_ENTROPY_NONCE_LEN (MBEDTLS_CTR_DRBG_ENTROPY_LEN + 1) / 2\0A#endif\0A\0A#if defined(MBEDTLS_CTR_DRBG_USE_PSA_CRYPTO)\0Atypedef struct mbedtls_ctr_drbg_psa_context {\0A    mbedtls_svc_key_id_t key_id;\0A    psa_cipher_operation_t operation;\0A} mbedtls_ctr_drbg_psa_context;\0A#endif\0A\0A/**\0A * \5Cbrief          The CTR_DRBG context structure.\0A */\0Atypedef struct mbedtls_ctr_drbg_context {\0A    unsigned char MBEDTLS_PRIVATE(counter)[16];  /*!< The counter (V). */\0A    int MBEDTLS_PRIVATE(reseed_counter);         /*!< The reseed counter.\0A                                                  * This is the number of requests that have\0A                                                  * been made since the last (re)seeding,\0A                                                  * minus one.\0A                                                  * Before the initial seeding, this field\0A                                                  * contains the amount of entropy in bytes\0A                                                  * to use as a nonce for the initial seeding,\0A                                                  * or -1 if no nonce length has been explicitly\0A                                                  * set (see mbedtls_ctr_drbg_set_nonce_len()).\0A                                                  */\0A    int MBEDTLS_PRIVATE(prediction_resistance);  /*!< This determines whether prediction\0A                                                    resistance is enabled, that is\0A                                                    whether to systematically reseed before\0A                                                    each random generation. */\0A    size_t MBEDTLS_PRIVATE(entropy_len);         /*!< The amount of entropy grabbed on each\0A                                                    seed or reseed operation, in bytes. */\0A    int MBEDTLS_PRIVATE(reseed_interval);        /*!< The reseed interval.\0A                                                  * This is the maximum number of requests\0A                                                  * that can be made between reseedings. */\0A\0A#if defined(MBEDTLS_CTR_DRBG_USE_PSA_CRYPTO)\0A    mbedtls_ctr_drbg_psa_context MBEDTLS_PRIVATE(psa_ctx); /*!< The PSA context. */\0A#else\0A    mbedtls_aes_context MBEDTLS_PRIVATE(aes_ctx);        /*!< The AES context. */\0A#endif\0A\0A    /*\0A     * Callbacks (Entropy)\0A     */\0A    int(*MBEDTLS_PRIVATE(f_entropy))(void *, unsigned char *, size_t);\0A    /*!< The entropy callback function. */\0A\0A    void *MBEDTLS_PRIVATE(p_entropy);            /*!< The context for the entropy function. */\0A\0A#if defined(MBEDTLS_THREADING_C)\0A    /* Invariant: the mutex is initialized if and only if f_entropy != NULL.\0A     * This means that the mutex is initialized during the initial seeding\0A     * in mbedtls_ctr_drbg_seed() and freed in mbedtls_ctr_drbg_free().\0A     *\0A     * Note that this invariant may change without notice. Do not rely on it\0A     * and do not access the mutex directly in application code.\0A     */\0A    mbedtls_threading_mutex_t MBEDTLS_PRIVATE(mutex);\0A#endif\0A}\0Ambedtls_ctr_drbg_context;\0A\0A/**\0A * \5Cbrief               This function initializes the CTR_DRBG context,\0A *                      and prepares it for mbedtls_ctr_drbg_seed()\0A *                      or mbedtls_ctr_drbg_free().\0A *\0A * \5Cnote                The reseed interval is\0A *                      #MBEDTLS_CTR_DRBG_RESEED_INTERVAL by default.\0A *                      You can override it by calling\0A *                      mbedtls_ctr_drbg_set_reseed_interval().\0A *\0A * \5Cparam ctx           The CTR_DRBG context to initialize.\0A */\0Avoid mbedtls_ctr_drbg_init(mbedtls_ctr_drbg_context *ctx);\0A\0A/**\0A * \5Cbrief               This function seeds and sets up the CTR_DRBG\0A *                      entropy source for future reseeds.\0A *\0A * A typical choice for the \5Cp f_entropy and \5Cp p_entropy parameters is\0A * to use the entropy module:\0A * - \5Cp f_entropy is mbedtls_entropy_func();\0A * - \5Cp p_entropy is an instance of ::mbedtls_entropy_context initialized\0A *   with mbedtls_entropy_init() (which registers the platform's default\0A *   entropy sources).\0A *\0A * The entropy length is #MBEDTLS_CTR_DRBG_ENTROPY_LEN by default.\0A * You can override it by calling mbedtls_ctr_drbg_set_entropy_len().\0A *\0A * The entropy nonce length is:\0A * - \5Cc 0 if the entropy length is at least 3/2 times the entropy length,\0A *   which guarantees that the security strength is the maximum permitted\0A *   by the key size and entropy length according to NIST SP 800-90A §10.2.1;\0A * - Half the entropy length otherwise.\0A * You can override it by calling mbedtls_ctr_drbg_set_nonce_len().\0A * With the default entropy length, the entropy nonce length is\0A * #MBEDTLS_CTR_DRBG_ENTROPY_NONCE_LEN.\0A *\0A * You can provide a nonce and personalization string in addition to the\0A * entropy source, to make this instantiation as unique as possible.\0A * See SP 800-90A §8.6.7 for more details about nonces.\0A *\0A * The _seed_material_ value passed to the derivation function in\0A * the CTR_DRBG Instantiate Process described in NIST SP 800-90A §10.2.1.3.2\0A * is the concatenation of the following strings:\0A * - A string obtained by calling \5Cp f_entropy function for the entropy\0A *   length.\0A */\0A#if MBEDTLS_CTR_DRBG_ENTROPY_NONCE_LEN == 0\0A/**\0A * - If mbedtls_ctr_drbg_set_nonce_len() has been called, a string\0A *   obtained by calling \5Cp f_entropy function for the specified length.\0A */\0A#else\0A/**\0A * - A string obtained by calling \5Cp f_entropy function for the entropy nonce\0A *   length. If the entropy nonce length is \5Cc 0, this function does not\0A *   make a second call to \5Cp f_entropy.\0A */\0A#endif\0A#if defined(MBEDTLS_THREADING_C)\0A/**\0A * \5Cnote                When Mbed TLS is built with threading support,\0A *                      after this function returns successfully,\0A *                      it is safe to call mbedtls_ctr_drbg_random()\0A *                      from multiple threads. Other operations, including\0A *                      reseeding, are not thread-safe.\0A */\0A#endif /* MBEDTLS_THREADING_C */\0A/**\0A * - The \5Cp custom string.\0A *\0A * \5Cnote                To achieve the nominal security strength permitted\0A *                      by CTR_DRBG, the entropy length must be:\0A *                      - at least 16 bytes for a 128-bit strength\0A *                      (maximum achievable strength when using AES-128);\0A *                      - at least 32 bytes for a 256-bit strength\0A *                      (maximum achievable strength when using AES-256).\0A *\0A *                      In addition, if you do not pass a nonce in \5Cp custom,\0A *                      the sum of the entropy length\0A *                      and the entropy nonce length must be:\0A *                      - at least 24 bytes for a 128-bit strength\0A *                      (maximum achievable strength when using AES-128);\0A *                      - at least 48 bytes for a 256-bit strength\0A *                      (maximum achievable strength when using AES-256).\0A *\0A * \5Cparam ctx           The CTR_DRBG context to seed.\0A *                      It must have been initialized with\0A *                      mbedtls_ctr_drbg_init().\0A *                      After a successful call to mbedtls_ctr_drbg_seed(),\0A *                      you may not call mbedtls_ctr_drbg_seed() again on\0A *                      the same context unless you call\0A *                      mbedtls_ctr_drbg_free() and mbedtls_ctr_drbg_init()\0A *                      again first.\0A *                      After a failed call to mbedtls_ctr_drbg_seed(),\0A *                      you must call mbedtls_ctr_drbg_free().\0A * \5Cparam f_entropy     The entropy callback, taking as arguments the\0A *                      \5Cp p_entropy context, the buffer to fill, and the\0A *                      length of the buffer.\0A *                      \5Cp f_entropy is always called with a buffer size\0A *                      less than or equal to the entropy length.\0A * \5Cparam p_entropy     The entropy context to pass to \5Cp f_entropy.\0A * \5Cparam custom        The personalization string.\0A *                      This can be \5Cc NULL, in which case the personalization\0A *                      string is empty regardless of the value of \5Cp len.\0A * \5Cparam len           The length of the personalization string.\0A *                      This must be at most\0A *                      #MBEDTLS_CTR_DRBG_MAX_SEED_INPUT\0A *                      - #MBEDTLS_CTR_DRBG_ENTROPY_LEN.\0A *\0A * \5Creturn              \5Cc 0 on success.\0A * \5Creturn              #MBEDTLS_ERR_CTR_DRBG_ENTROPY_SOURCE_FAILED on failure.\0A */\0Aint mbedtls_ctr_drbg_seed(mbedtls_ctr_drbg_context *ctx,\0A                          int (*f_entropy)(void *, unsigned char *, size_t),\0A                          void *p_entropy,\0A                          const unsigned char *custom,\0A                          size_t len);\0A\0A/**\0A * \5Cbrief               This function resets CTR_DRBG context to the state immediately\0A *                      after initial call of mbedtls_ctr_drbg_init().\0A *\0A * \5Cparam ctx           The CTR_DRBG context to clear.\0A */\0Avoid mbedtls_ctr_drbg_free(mbedtls_ctr_drbg_context *ctx);\0A\0A/**\0A * \5Cbrief               This function turns prediction resistance on or off.\0A *                      The default value is off.\0A *\0A * \5Cnote                If enabled, entropy is gathered at the beginning of\0A *                      every call to mbedtls_ctr_drbg_random_with_add()\0A *                      or mbedtls_ctr_drbg_random().\0A *                      Only use this if your entropy source has sufficient\0A *                      throughput.\0A *\0A * \5Cparam ctx           The CTR_DRBG context.\0A * \5Cparam resistance    #MBEDTLS_CTR_DRBG_PR_ON or #MBEDTLS_CTR_DRBG_PR_OFF.\0A */\0Avoid mbedtls_ctr_drbg_set_prediction_resistance(mbedtls_ctr_drbg_context *ctx,\0A                                                int resistance);\0A\0A/**\0A * \5Cbrief               This function sets the amount of entropy grabbed on each\0A *                      seed or reseed.\0A *\0A * The default value is #MBEDTLS_CTR_DRBG_ENTROPY_LEN.\0A *\0A * \5Cnote                The security strength of CTR_DRBG is bounded by the\0A *                      entropy length. Thus:\0A *                      - When using AES-256\0A *                        (\5Cc MBEDTLS_CTR_DRBG_USE_128_BIT_KEY is disabled,\0A *                        which is the default),\0A *                        \5Cp len must be at least 32 (in bytes)\0A *                        to achieve a 256-bit strength.\0A *                      - When using AES-128\0A *                        (\5Cc MBEDTLS_CTR_DRBG_USE_128_BIT_KEY is enabled)\0A *                        \5Cp len must be at least 16 (in bytes)\0A *                        to achieve a 128-bit strength.\0A *\0A * \5Cparam ctx           The CTR_DRBG context.\0A * \5Cparam len           The amount of entropy to grab, in bytes.\0A *                      This must be at most #MBEDTLS_CTR_DRBG_MAX_SEED_INPUT\0A *                      and at most the maximum length accepted by the\0A *                      entropy function that is set in the context.\0A */\0Avoid mbedtls_ctr_drbg_set_entropy_len(mbedtls_ctr_drbg_context *ctx,\0A                                      size_t len);\0A\0A/**\0A * \5Cbrief               This function sets the amount of entropy grabbed\0A *                      as a nonce for the initial seeding.\0A *\0A * Call this function before calling mbedtls_ctr_drbg_seed() to read\0A * a nonce from the entropy source during the initial seeding.\0A *\0A * \5Cparam ctx           The CTR_DRBG context.\0A * \5Cparam len           The amount of entropy to grab for the nonce, in bytes.\0A *                      This must be at most #MBEDTLS_CTR_DRBG_MAX_SEED_INPUT\0A *                      and at most the maximum length accepted by the\0A *                      entropy function that is set in the context.\0A *\0A * \5Creturn              \5Cc 0 on success.\0A * \5Creturn              #MBEDTLS_ERR_CTR_DRBG_INPUT_TOO_BIG if \5Cp len is\0A *                      more than #MBEDTLS_CTR_DRBG_MAX_SEED_INPUT.\0A * \5Creturn              #MBEDTLS_ERR_CTR_DRBG_ENTROPY_SOURCE_FAILED\0A *                      if the initial seeding has already taken place.\0A */\0Aint mbedtls_ctr_drbg_set_nonce_len(mbedtls_ctr_drbg_context *ctx,\0A                                   size_t len);\0A\0A/**\0A * \5Cbrief               This function sets the reseed interval.\0A *\0A * The reseed interval is the number of calls to mbedtls_ctr_drbg_random()\0A * or mbedtls_ctr_drbg_random_with_add() after which the entropy function\0A * is called again.\0A *\0A * The default value is #MBEDTLS_CTR_DRBG_RESEED_INTERVAL.\0A *\0A * \5Cparam ctx           The CTR_DRBG context.\0A * \5Cparam interval      The reseed interval.\0A */\0Avoid mbedtls_ctr_drbg_set_reseed_interval(mbedtls_ctr_drbg_context *ctx,\0A                                          int interval);\0A\0A/**\0A * \5Cbrief               This function reseeds the CTR_DRBG context, that is\0A *                      extracts data from the entropy source.\0A *\0A * \5Cnote                This function is not thread-safe. It is not safe\0A *                      to call this function if another thread might be\0A *                      concurrently obtaining random numbers from the same\0A *                      context or updating or reseeding the same context.\0A *\0A * \5Cparam ctx           The CTR_DRBG context.\0A * \5Cparam additional    Additional data to add to the state. Can be \5Cc NULL.\0A * \5Cparam len           The length of the additional data.\0A *                      This must be less than\0A *                      #MBEDTLS_CTR_DRBG_MAX_SEED_INPUT - \5Cc entropy_len\0A *                      where \5Cc entropy_len is the entropy length\0A *                      configured for the context.\0A *\0A * \5Creturn              \5Cc 0 on success.\0A * \5Creturn              #MBEDTLS_ERR_CTR_DRBG_ENTROPY_SOURCE_FAILED on failure.\0A */\0Aint mbedtls_ctr_drbg_reseed(mbedtls_ctr_drbg_context *ctx,\0A                            const unsigned char *additional, size_t len);\0A\0A/**\0A * \5Cbrief              This function updates the state of the CTR_DRBG context.\0A *\0A * \5Cnote                This function is not thread-safe. It is not safe\0A *                      to call this function if another thread might be\0A *                      concurrently obtaining random numbers from the same\0A *                      context or updating or reseeding the same context.\0A *\0A * \5Cparam ctx          The CTR_DRBG context.\0A * \5Cparam additional   The data to update the state with. This must not be\0A *                     \5Cc NULL unless \5Cp add_len is \5Cc 0.\0A * \5Cparam add_len      Length of \5Cp additional in bytes. This must be at\0A *                     most #MBEDTLS_CTR_DRBG_MAX_SEED_INPUT.\0A *\0A * \5Creturn             \5Cc 0 on success.\0A * \5Creturn             #MBEDTLS_ERR_CTR_DRBG_INPUT_TOO_BIG if\0A *                     \5Cp add_len is more than\0A *                     #MBEDTLS_CTR_DRBG_MAX_SEED_INPUT.\0A * \5Creturn             An error from the underlying AES cipher on failure.\0A */\0Aint mbedtls_ctr_drbg_update(mbedtls_ctr_drbg_context *ctx,\0A                            const unsigned char *additional,\0A                            size_t add_len);\0A\0A/**\0A * \5Cbrief   This function updates a CTR_DRBG instance with additional\0A *          data and uses it to generate random data.\0A *\0A * This function automatically reseeds if the reseed counter is exceeded\0A * or prediction resistance is enabled.\0A *\0A * \5Cnote                This function is not thread-safe. It is not safe\0A *                      to call this function if another thread might be\0A *                      concurrently obtaining random numbers from the same\0A *                      context or updating or reseeding the same context.\0A *\0A * \5Cparam p_rng         The CTR_DRBG context. This must be a pointer to a\0A *                      #mbedtls_ctr_drbg_context structure.\0A * \5Cparam output        The buffer to fill.\0A * \5Cparam output_len    The length of the buffer in bytes.\0A * \5Cparam additional    Additional data to update. Can be \5Cc NULL, in which\0A *                      case the additional data is empty regardless of\0A *                      the value of \5Cp add_len.\0A * \5Cparam add_len       The length of the additional data\0A *                      if \5Cp additional is not \5Cc NULL.\0A *                      This must be less than #MBEDTLS_CTR_DRBG_MAX_INPUT\0A *                      and less than\0A *                      #MBEDTLS_CTR_DRBG_MAX_SEED_INPUT - \5Cc entropy_len\0A *                      where \5Cc entropy_len is the entropy length\0A *                      configured for the context.\0A *\0A * \5Creturn    \5Cc 0 on success.\0A * \5Creturn    #MBEDTLS_ERR_CTR_DRBG_ENTROPY_SOURCE_FAILED or\0A *            #MBEDTLS_ERR_CTR_DRBG_REQUEST_TOO_BIG on failure.\0A */\0Aint mbedtls_ctr_drbg_random_with_add(void *p_rng,\0A                                     unsigned char *output, size_t output_len,\0A                                     const unsigned char *additional, size_t add_len);\0A\0A/**\0A * \5Cbrief   This function uses CTR_DRBG to generate random data.\0A *\0A * This function automatically reseeds if the reseed counter is exceeded\0A * or prediction resistance is enabled.\0A */\0A#if defined(MBEDTLS_THREADING_C)\0A/**\0A * \5Cnote                When Mbed TLS is built with threading support,\0A *                      it is safe to call mbedtls_ctr_drbg_random()\0A *                      from multiple threads. Other operations, including\0A *                      reseeding, are not thread-safe.\0A */\0A#endif /* MBEDTLS_THREADING_C */\0A/**\0A * \5Cparam p_rng         The CTR_DRBG context. This must be a pointer to a\0A *                      #mbedtls_ctr_drbg_context structure.\0A * \5Cparam output        The buffer to fill.\0A * \5Cparam output_len    The length of the buffer in bytes.\0A *\0A * \5Creturn              \5Cc 0 on success.\0A * \5Creturn              #MBEDTLS_ERR_CTR_DRBG_ENTROPY_SOURCE_FAILED or\0A *                      #MBEDTLS_ERR_CTR_DRBG_REQUEST_TOO_BIG on failure.\0A */\0Aint mbedtls_ctr_drbg_random(void *p_rng,\0A                            unsigned char *output, size_t output_len);\0A\0A#if defined(MBEDTLS_FS_IO)\0A/**\0A * \5Cbrief               This function writes a seed file.\0A *\0A * \5Cparam ctx           The CTR_DRBG context.\0A * \5Cparam path          The name of the file.\0A *\0A * \5Creturn              \5Cc 0 on success.\0A * \5Creturn              #MBEDTLS_ERR_CTR_DRBG_FILE_IO_ERROR on file error.\0A * \5Creturn              #MBEDTLS_ERR_CTR_DRBG_ENTROPY_SOURCE_FAILED on reseed\0A *                      failure.\0A */\0Aint mbedtls_ctr_drbg_write_seed_file(mbedtls_ctr_drbg_context *ctx, const char *path);\0A\0A/**\0A * \5Cbrief               This function reads and updates a seed file. The seed\0A *                      is added to this instance.\0A *\0A * \5Cparam ctx           The CTR_DRBG context.\0A * \5Cparam path          The name of the file.\0A *\0A * \5Creturn              \5Cc 0 on success.\0A * \5Creturn              #MBEDTLS_ERR_CTR_DRBG_FILE_IO_ERROR on file error.\0A * \5Creturn              #MBEDTLS_ERR_CTR_DRBG_ENTROPY_SOURCE_FAILED on\0A *                      reseed failure.\0A * \5Creturn              #MBEDTLS_ERR_CTR_DRBG_INPUT_TOO_BIG if the existing\0A *                      seed file is too large.\0A */\0Aint mbedtls_ctr_drbg_update_seed_file(mbedtls_ctr_drbg_context *ctx, const char *path);\0A#endif /* MBEDTLS_FS_IO */\0A\0A#if defined(MBEDTLS_SELF_TEST)\0A\0A/**\0A * \5Cbrief               The CTR_DRBG checkup routine.\0A *\0A * \5Creturn              \5Cc 0 on success.\0A * \5Creturn              \5Cc 1 on failure.\0A */\0Aint mbedtls_ctr_drbg_self_test(int verbose);\0A\0A#endif /* MBEDTLS_SELF_TEST */\0A\0A#ifdef __cplusplus\0A}\0A#endif\0A\0A#endif /* ctr_drbg.h */\0A\00" }
