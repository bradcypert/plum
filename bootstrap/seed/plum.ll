@.str40608 = private global { i64, i64, [234226 x i8] } { i64 -1, i64 234225, [234226 x i8] c"/*\0A *  Generic SSL/TLS messaging layer functions\0A *  (record layer + retransmission state machine)\0A *\0A *  Copyright The Mbed TLS Contributors\0A *  SPDX-License-Identifier: Apache-2.0 OR GPL-2.0-or-later\0A */\0A/*\0A *  http://www.ietf.org/rfc/rfc2246.txt\0A *  http://www.ietf.org/rfc/rfc4346.txt\0A */\0A\0A#include \22common.h\22\0A\0A#if defined(MBEDTLS_SSL_TLS_C)\0A\0A#include \22mbedtls/platform.h\22\0A\0A#include \22mbedtls/ssl.h\22\0A#include \22ssl_misc.h\22\0A#include \22debug_internal.h\22\0A#include \22mbedtls/error.h\22\0A#include \22mbedtls/platform_util.h\22\0A#include \22mbedtls/version.h\22\0A#include \22constant_time_internal.h\22\0A#include \22mbedtls/constant_time.h\22\0A\0A#include <limits.h>\0A#include <string.h>\0A\0A#if defined(MBEDTLS_USE_PSA_CRYPTO)\0A#include \22psa_util_internal.h\22\0A#include \22psa/crypto.h\22\0A#endif\0A\0A#if defined(MBEDTLS_X509_CRT_PARSE_C)\0A#include \22mbedtls/oid.h\22\0A#endif\0A\0A#if defined(MBEDTLS_USE_PSA_CRYPTO)\0A/* Define a local translating function to save code size by not using too many\0A * arguments in each translating place. */\0Astatic int local_err_translation(psa_status_t status)\0A{\0A    return psa_status_to_mbedtls(status, psa_to_ssl_errors,\0A                                 ARRAY_LENGTH(psa_to_ssl_errors),\0A                                 psa_generic_status_to_mbedtls);\0A}\0A#define PSA_TO_MBEDTLS_ERR(status) local_err_translation(status)\0A#endif\0A\0A#if defined(MBEDTLS_SSL_SOME_SUITES_USE_MAC)\0A\0A#if defined(MBEDTLS_USE_PSA_CRYPTO)\0A\0A#if defined(PSA_WANT_ALG_SHA_384)\0A#define MAX_HASH_BLOCK_LENGTH PSA_HASH_BLOCK_LENGTH(PSA_ALG_SHA_384)\0A#elif defined(PSA_WANT_ALG_SHA_256)\0A#define MAX_HASH_BLOCK_LENGTH PSA_HASH_BLOCK_LENGTH(PSA_ALG_SHA_256)\0A#else /* See check_config.h */\0A#define MAX_HASH_BLOCK_LENGTH PSA_HASH_BLOCK_LENGTH(PSA_ALG_SHA_1)\0A#endif\0A\0AMBEDTLS_STATIC_TESTABLE\0Aint mbedtls_ct_hmac(mbedtls_svc_key_id_t key,\0A                    psa_algorithm_t mac_alg,\0A                    const unsigned char *add_data,\0A                    size_t add_data_len,\0A                    const unsigned char *data,\0A                    size_t data_len_secret,\0A                    size_t min_data_len,\0A                    size_t max_data_len,\0A                    unsigned char *output)\0A{\0A    /*\0A     * This function breaks the HMAC abstraction and uses psa_hash_clone()\0A     * extension in order to get constant-flow behaviour.\0A     *\0A     * HMAC(msg) is defined as HASH(okey + HASH(ikey + msg)) where + means\0A     * concatenation, and okey/ikey are the XOR of the key with some fixed bit\0A     * patterns (see RFC 2104, sec. 2).\0A     *\0A     * We'll first compute ikey/okey, then inner_hash = HASH(ikey + msg) by\0A     * hashing up to minlen, then cloning the context, and for each byte up\0A     * to maxlen finishing up the hash computation, keeping only the\0A     * correct result.\0A     *\0A     * Then we only need to compute HASH(okey + inner_hash) and we're done.\0A     */\0A    psa_algorithm_t hash_alg = PSA_ALG_HMAC_GET_HASH(mac_alg);\0A    const size_t block_size = PSA_HASH_BLOCK_LENGTH(hash_alg);\0A    unsigned char key_buf[MAX_HASH_BLOCK_LENGTH];\0A    const size_t hash_size = PSA_HASH_LENGTH(hash_alg);\0A    psa_hash_operation_t operation = PSA_HASH_OPERATION_INIT;\0A    size_t hash_length;\0A\0A    unsigned char aux_out[PSA_HASH_MAX_SIZE];\0A    psa_hash_operation_t aux_operation = PSA_HASH_OPERATION_INIT;\0A    size_t offset;\0A    psa_status_t status = PSA_ERROR_CORRUPTION_DETECTED;\0A\0A    size_t mac_key_length;\0A    size_t i;\0A\0A#define PSA_CHK(func_call)        \5C\0A    do {                            \5C\0A        status = (func_call);       \5C\0A        if (status != PSA_SUCCESS) \5C\0A        goto cleanup;           \5C\0A    } while (0)\0A\0A    /* Export MAC key\0A     * We assume key length is always exactly the output size\0A     * which is never more than the block size, thus we use block_size\0A     * as the key buffer size.\0A     */\0A    PSA_CHK(psa_export_key(key, key_buf, block_size, &mac_key_length));\0A\0A    /* Calculate ikey */\0A    for (i = 0; i < mac_key_length; i++) {\0A        key_buf[i] = (unsigned char) (key_buf[i] ^ 0x36);\0A    }\0A    for (; i < block_size; ++i) {\0A        key_buf[i] = 0x36;\0A    }\0A\0A    PSA_CHK(psa_hash_setup(&operation, hash_alg));\0A\0A    /* Now compute inner_hash = HASH(ikey + msg) */\0A    PSA_CHK(psa_hash_update(&operation, key_buf, block_size));\0A    PSA_CHK(psa_hash_update(&operation, add_data, add_data_len));\0A    PSA_CHK(psa_hash_update(&operation, data, min_data_len));\0A\0A    /* Fill the hash buffer in advance with something that is\0A     * not a valid hash (barring an attack on the hash and\0A     * deliberately-crafted input), in case the caller doesn't\0A     * check the return status properly. */\0A    memset(output, '!', hash_size);\0A\0A    /* For each possible length, compute the hash up to that point */\0A    for (offset = min_data_len; offset <= max_data_len; offset++) {\0A        PSA_CHK(psa_hash_clone(&operation, &aux_operation));\0A        PSA_CHK(psa_hash_finish(&aux_operation, aux_out,\0A                                PSA_HASH_MAX_SIZE, &hash_length));\0A        /* Keep only the correct inner_hash in the output buffer */\0A        mbedtls_ct_memcpy_if(mbedtls_ct_uint_eq(offset, data_len_secret),\0A                             output, aux_out, NULL, hash_size);\0A\0A        if (offset < max_data_len) {\0A            PSA_CHK(psa_hash_update(&operation, data + offset, 1));\0A        }\0A    }\0A\0A    /* Abort current operation to prepare for final operation */\0A    PSA_CHK(psa_hash_abort(&operation));\0A\0A    /* Calculate okey */\0A    for (i = 0; i < mac_key_length; i++) {\0A        key_buf[i] = (unsigned char) ((key_buf[i] ^ 0x36) ^ 0x5C);\0A    }\0A    for (; i < block_size; ++i) {\0A        key_buf[i] = 0x5C;\0A    }\0A\0A    /* Now compute HASH(okey + inner_hash) */\0A    PSA_CHK(psa_hash_setup(&operation, hash_alg));\0A    PSA_CHK(psa_hash_update(&operation, key_buf, block_size));\0A    PSA_CHK(psa_hash_update(&operation, output, hash_size));\0A    PSA_CHK(psa_hash_finish(&operation, output, hash_size, &hash_length));\0A\0A#undef PSA_CHK\0A\0Acleanup:\0A    mbedtls_platform_zeroize(key_buf, MAX_HASH_BLOCK_LENGTH);\0A    mbedtls_platform_zeroize(aux_out, PSA_HASH_MAX_SIZE);\0A\0A    psa_hash_abort(&operation);\0A    psa_hash_abort(&aux_operation);\0A    return PSA_TO_MBEDTLS_ERR(status);\0A}\0A\0A#undef MAX_HASH_BLOCK_LENGTH\0A\0A#else\0AMBEDTLS_STATIC_TESTABLE\0Aint mbedtls_ct_hmac(mbedtls_md_context_t *ctx,\0A                    const unsigned char *add_data,\0A                    size_t add_data_len,\0A                    const unsigned char *data,\0A                    size_t data_len_secret,\0A                    size_t min_data_len,\0A                    size_t max_data_len,\0A                    unsigned char *output)\0A{\0A    /*\0A     * This function breaks the HMAC abstraction and uses the md_clone()\0A     * extension to the MD API in order to get constant-flow behaviour.\0A     *\0A     * HMAC(msg) is defined as HASH(okey + HASH(ikey + msg)) where + means\0A     * concatenation, and okey/ikey are the XOR of the key with some fixed bit\0A     * patterns (see RFC 2104, sec. 2), which are stored in ctx->hmac_ctx.\0A     *\0A     * We'll first compute inner_hash = HASH(ikey + msg) by hashing up to\0A     * minlen, then cloning the context, and for each byte up to maxlen\0A     * finishing up the hash computation, keeping only the correct result.\0A     *\0A     * Then we only need to compute HASH(okey + inner_hash) and we're done.\0A     */\0A    const mbedtls_md_type_t md_alg = mbedtls_md_get_type(ctx->md_info);\0A    /* TLS 1.2 only supports SHA-384, SHA-256, SHA-1, MD-5,\0A     * all of which have the same block size except SHA-384. */\0A    const size_t block_size = md_alg == MBEDTLS_MD_SHA384 ? 128 : 64;\0A    const unsigned char * const ikey = ctx->hmac_ctx;\0A    const unsigned char * const okey = ikey + block_size;\0A    const size_t hash_size = mbedtls_md_get_size(ctx->md_info);\0A\0A    unsigned char aux_out[MBEDTLS_MD_MAX_SIZE];\0A    mbedtls_md_context_t aux;\0A    size_t offset;\0A    int ret = MBEDTLS_ERR_ERROR_CORRUPTION_DETECTED;\0A\0A    mbedtls_md_init(&aux);\0A\0A#define MD_CHK(func_call) \5C\0A    do {                    \5C\0A        ret = (func_call);  \5C\0A        if (ret != 0)      \5C\0A        goto cleanup;   \5C\0A    } while (0)\0A\0A    MD_CHK(mbedtls_md_setup(&aux, ctx->md_info, 0));\0A\0A    /* After hmac_start() of hmac_reset(), ikey has already been hashed,\0A     * so we can start directly with the message */\0A    MD_CHK(mbedtls_md_update(ctx, add_data, add_data_len));\0A    MD_CHK(mbedtls_md_update(ctx, data, min_data_len));\0A\0A    /* Fill the hash buffer in advance with something that is\0A     * not a valid hash (barring an attack on the hash and\0A     * deliberately-crafted input), in case the caller doesn't\0A     * check the return status properly. */\0A    memset(output, '!', hash_size);\0A\0A    /* For each possible length, compute the hash up to that point */\0A    for (offset = min_data_len; offset <= max_data_len; offset++) {\0A        MD_CHK(mbedtls_md_clone(&aux, ctx));\0A        MD_CHK(mbedtls_md_finish(&aux, aux_out));\0A        /* Keep only the correct inner_hash in the output buffer */\0A        mbedtls_ct_memcpy_if(mbedtls_ct_uint_eq(offset, data_len_secret),\0A                             output, aux_out, NULL, hash_size);\0A\0A        if (offset < max_data_len) {\0A            MD_CHK(mbedtls_md_update(ctx, data + offset, 1));\0A        }\0A    }\0A\0A    /* The context needs to finish() before it starts() again */\0A    MD_CHK(mbedtls_md_finish(ctx, aux_out));\0A\0A    /* Now compute HASH(okey + inner_hash) */\0A    MD_CHK(mbedtls_md_starts(ctx));\0A    MD_CHK(mbedtls_md_update(ctx, okey, block_size));\0A    MD_CHK(mbedtls_md_update(ctx, output, hash_size));\0A    MD_CHK(mbedtls_md_finish(ctx, output));\0A\0A    /* Done, get ready for next time */\0A    MD_CHK(mbedtls_md_hmac_reset(ctx));\0A\0A#undef MD_CHK\0A\0Acleanup:\0A    mbedtls_md_free(&aux);\0A    return ret;\0A}\0A\0A#endif /* MBEDTLS_USE_PSA_CRYPTO */\0A\0A#endif /* MBEDTLS_SSL_SOME_SUITES_USE_MAC */\0A\0Astatic uint32_t ssl_get_hs_total_len(mbedtls_ssl_context const *ssl);\0A\0A/*\0A * Start a timer.\0A * Passing millisecs = 0 cancels a running timer.\0A */\0Avoid mbedtls_ssl_set_timer(mbedtls_ssl_context *ssl, uint32_t millisecs)\0A{\0A    if (ssl->f_set_timer == NULL) {\0A        return;\0A    }\0A\0A    MBEDTLS_SSL_DEBUG_MSG(3, (\22set_timer to %d ms\22, (int) millisecs));\0A    ssl->f_set_timer(ssl->p_timer, millisecs / 4, millisecs);\0A}\0A\0A/*\0A * Return -1 is timer is expired, 0 if it isn't.\0A */\0Aint mbedtls_ssl_check_timer(mbedtls_ssl_context *ssl)\0A{\0A    if (ssl->f_get_timer == NULL) {\0A        return 0;\0A    }\0A\0A    if (ssl->f_get_timer(ssl->p_timer) == 2) {\0A        MBEDTLS_SSL_DEBUG_MSG(3, (\22timer expired\22));\0A        return -1;\0A    }\0A\0A    return 0;\0A}\0A\0AMBEDTLS_CHECK_RETURN_CRITICAL\0Astatic int ssl_parse_record_header(mbedtls_ssl_context const *ssl,\0A                                   unsigned char *buf,\0A                                   size_t len,\0A                                   mbedtls_record *rec);\0A\0Aint mbedtls_ssl_check_record(mbedtls_ssl_context const *ssl,\0A                             unsigned char *buf,\0A                             size_t buflen)\0A{\0A    int ret = 0;\0A    MBEDTLS_SSL_DEBUG_MSG(1, (\22=> mbedtls_ssl_check_record\22));\0A    MBEDTLS_SSL_DEBUG_BUF(3, \22record buffer\22, buf, buflen);\0A\0A    /* We don't support record checking in TLS because\0A     * there doesn't seem to be a usecase for it.\0A     */\0A    if (ssl->conf->transport == MBEDTLS_SSL_TRANSPORT_STREAM) {\0A        ret = MBEDTLS_ERR_SSL_FEATURE_UNAVAILABLE;\0A        goto exit;\0A    }\0A#if defined(MBEDTLS_SSL_PROTO_DTLS)\0A    else {\0A        mbedtls_record rec;\0A\0A        ret = ssl_parse_record_header(ssl, buf, buflen, &rec);\0A        if (ret != 0) {\0A            MBEDTLS_SSL_DEBUG_RET(3, \22ssl_parse_record_header\22, ret);\0A            goto exit;\0A        }\0A\0A        if (ssl->transform_in != NULL) {\0A            ret = mbedtls_ssl_decrypt_buf(ssl, ssl->transform_in, &rec);\0A            if (ret != 0) {\0A                MBEDTLS_SSL_DEBUG_RET(3, \22mbedtls_ssl_decrypt_buf\22, ret);\0A                goto exit;\0A            }\0A        }\0A    }\0A#endif /* MBEDTLS_SSL_PROTO_DTLS */\0A\0Aexit:\0A    /* On success, we have decrypted the buffer in-place, so make\0A     * sure we don't leak any plaintext data. */\0A    mbedtls_platform_zeroize(buf, buflen);\0A\0A    /* For the purpose of this API, treat messages with unexpected CID\0A     * as well as such from future epochs as unexpected. */\0A    if (ret == MBEDTLS_ERR_SSL_UNEXPECTED_CID ||\0A        ret == MBEDTLS_ERR_SSL_EARLY_MESSAGE) {\0A        ret = MBEDTLS_ERR_SSL_UNEXPECTED_RECORD;\0A    }\0A\0A    MBEDTLS_SSL_DEBUG_MSG(1, (\22<= mbedtls_ssl_check_record\22));\0A    return ret;\0A}\0A\0A#define SSL_DONT_FORCE_FLUSH 0\0A#define SSL_FORCE_FLUSH      1\0A\0A#if defined(MBEDTLS_SSL_PROTO_DTLS)\0A\0A/* Forward declarations for functions related to message buffering. */\0Astatic void ssl_buffering_free_slot(mbedtls_ssl_context *ssl,\0A                                    uint8_t slot);\0Astatic void ssl_free_buffered_record(mbedtls_ssl_context *ssl);\0AMBEDTLS_CHECK_RETURN_CRITICAL\0Astatic int ssl_load_buffered_message(mbedtls_ssl_context *ssl);\0AMBEDTLS_CHECK_RETURN_CRITICAL\0Astatic int ssl_load_buffered_record(mbedtls_ssl_context *ssl);\0AMBEDTLS_CHECK_RETURN_CRITICAL\0Astatic int ssl_buffer_message(mbedtls_ssl_context *ssl);\0AMBEDTLS_CHECK_RETURN_CRITICAL\0Astatic int ssl_buffer_future_record(mbedtls_ssl_context *ssl,\0A                                    mbedtls_record const *rec);\0AMBEDTLS_CHECK_RETURN_CRITICAL\0Astatic int ssl_next_record_is_in_datagram(mbedtls_ssl_context *ssl);\0A\0Astatic size_t ssl_get_maximum_datagram_size(mbedtls_ssl_context const *ssl)\0A{\0A    size_t mtu = mbedtls_ssl_get_current_mtu(ssl);\0A#if defined(MBEDTLS_SSL_VARIABLE_BUFFER_LENGTH)\0A    size_t out_buf_len = ssl->out_buf_len;\0A#else\0A    size_t out_buf_len = MBEDTLS_SSL_OUT_BUFFER_LEN;\0A#endif\0A\0A    if (mtu != 0 && mtu < out_buf_len) {\0A        return mtu;\0A    }\0A\0A    return out_buf_len;\0A}\0A\0AMBEDTLS_CHECK_RETURN_CRITICAL\0Astatic int ssl_get_remaining_space_in_datagram(mbedtls_ssl_context const *ssl)\0A{\0A    size_t const bytes_written = ssl->out_left;\0A    size_t const mtu           = ssl_get_maximum_datagram_size(ssl);\0A\0A    /* Double-check that the write-index hasn't gone\0A     * past what we can transmit in a single datagram. */\0A    if (bytes_written > mtu) {\0A        /* Should never happen... */\0A        return MBEDTLS_ERR_SSL_INTERNAL_ERROR;\0A    }\0A\0A    return (int) (mtu - bytes_written);\0A}\0A\0AMBEDTLS_CHECK_RETURN_CRITICAL\0Astatic int ssl_get_remaining_payload_in_datagram(mbedtls_ssl_context const *ssl)\0A{\0A    int ret = MBEDTLS_ERR_ERROR_CORRUPTION_DETECTED;\0A    size_t remaining, expansion;\0A    size_t max_len = MBEDTLS_SSL_OUT_CONTENT_LEN;\0A\0A#if defined(MBEDTLS_SSL_MAX_FRAGMENT_LENGTH)\0A    const size_t mfl = mbedtls_ssl_get_output_max_frag_len(ssl);\0A\0A    if (max_len > mfl) {\0A        max_len = mfl;\0A    }\0A\0A    /* By the standard (RFC 6066 Sect. 4), the MFL extension\0A     * only limits the maximum record payload size, so in theory\0A     * we would be allowed to pack multiple records of payload size\0A     * MFL into a single datagram. However, this would mean that there's\0A     * no way to explicitly communicate MTU restrictions to the peer.\0A     *\0A     * The following reduction of max_len makes sure that we never\0A     * write datagrams larger than MFL + Record Expansion Overhead.\0A     */\0A    if (max_len <= ssl->out_left) {\0A        return 0;\0A    }\0A\0A    max_len -= ssl->out_left;\0A#endif\0A\0A    ret = ssl_get_remaining_space_in_datagram(ssl);\0A    if (ret < 0) {\0A        return ret;\0A    }\0A    remaining = (size_t) ret;\0A\0A    ret = mbedtls_ssl_get_record_expansion(ssl);\0A    if (ret < 0) {\0A        return ret;\0A    }\0A    expansion = (size_t) ret;\0A\0A    if (remaining <= expansion) {\0A        return 0;\0A    }\0A\0A    remaining -= expansion;\0A    if (remaining >= max_len) {\0A        remaining = max_len;\0A    }\0A\0A    return (int) remaining;\0A}\0A\0A/*\0A * Double the retransmit timeout value, within the allowed range,\0A * returning -1 if the maximum value has already been reached.\0A */\0AMBEDTLS_CHECK_RETURN_CRITICAL\0Astatic int ssl_double_retransmit_timeout(mbedtls_ssl_context *ssl)\0A{\0A    uint32_t new_timeout;\0A\0A    if (ssl->handshake->retransmit_timeout >= ssl->conf->hs_timeout_max) {\0A        return -1;\0A    }\0A\0A    /* Implement the final paragraph of RFC 6347 section 4.1.1.1\0A     * in the following way: after the initial transmission and a first\0A     * retransmission, back off to a temporary estimated MTU of 508 bytes.\0A     * This value is guaranteed to be deliverable (if not guaranteed to be\0A     * delivered) of any compliant IPv4 (and IPv6) network, and should work\0A     * on most non-IP stacks too. */\0A    if (ssl->handshake->retransmit_timeout != ssl->conf->hs_timeout_min) {\0A        ssl->handshake->mtu = 508;\0A        MBEDTLS_SSL_DEBUG_MSG(2, (\22mtu autoreduction to %d bytes\22, ssl->handshake->mtu));\0A    }\0A\0A    new_timeout = 2 * ssl->handshake->retransmit_timeout;\0A\0A    /* Avoid arithmetic overflow and range overflow */\0A    if (new_timeout < ssl->handshake->retransmit_timeout ||\0A        new_timeout > ssl->conf->hs_timeout_max) {\0A        new_timeout = ssl->conf->hs_timeout_max;\0A    }\0A\0A    ssl->handshake->retransmit_timeout = new_timeout;\0A    MBEDTLS_SSL_DEBUG_MSG(3, (\22update timeout value to %lu millisecs\22,\0A                              (unsigned long) ssl->handshake->retransmit_timeout));\0A\0A    return 0;\0A}\0A\0Astatic void ssl_reset_retransmit_timeout(mbedtls_ssl_context *ssl)\0A{\0A    ssl->handshake->retransmit_timeout = ssl->conf->hs_timeout_min;\0A    MBEDTLS_SSL_DEBUG_MSG(3, (\22update timeout value to %lu millisecs\22,\0A                              (unsigned long) ssl->handshake->retransmit_timeout));\0A}\0A#endif /* MBEDTLS_SSL_PROTO_DTLS */\0A\0A/*\0A * Encryption/decryption functions\0A */\0A\0A#if defined(MBEDTLS_SSL_DTLS_CONNECTION_ID) || defined(MBEDTLS_SSL_PROTO_TLS1_3)\0A\0Astatic size_t ssl_compute_padding_length(size_t len,\0A                                         size_t granularity)\0A{\0A    return (granularity - (len + 1) % granularity) % granularity;\0A}\0A\0A/* This functions transforms a (D)TLS plaintext fragment and a record content\0A * type into an instance of the (D)TLSInnerPlaintext structure. This is used\0A * in DTLS 1.2 + CID and within TLS 1.3 to allow flexible padding and to protect\0A * a record's content type.\0A *\0A *        struct {\0A *            opaque content[DTLSPlaintext.length];\0A *            ContentType real_type;\0A *            uint8 zeros[length_of_padding];\0A *        } (D)TLSInnerPlaintext;\0A *\0A *  Input:\0A *  - `content`: The beginning of the buffer holding the\0A *               plaintext to be wrapped.\0A *  - `*content_size`: The length of the plaintext in Bytes.\0A *  - `max_len`: The number of Bytes available starting from\0A *               `content`. This must be `>= *content_size`.\0A *  - `rec_type`: The desired record content type.\0A *\0A *  Output:\0A *  - `content`: The beginning of the resulting (D)TLSInnerPlaintext structure.\0A *  - `*content_size`: The length of the resulting (D)TLSInnerPlaintext structure.\0A *\0A *  Returns:\0A *  - `0` on success.\0A *  - A negative error code if `max_len` didn't offer enough space\0A *    for the expansion.\0A */\0AMBEDTLS_CHECK_RETURN_CRITICAL\0Astatic int ssl_build_inner_plaintext(unsigned char *content,\0A                                     size_t *content_size,\0A                                     size_t remaining,\0A                                     uint8_t rec_type,\0A                                     size_t pad)\0A{\0A    size_t len = *content_size;\0A\0A    /* Write real content type */\0A    if (remaining == 0) {\0A        return -1;\0A    }\0A    content[len] = rec_type;\0A    len++;\0A    remaining--;\0A\0A    if (remaining < pad) {\0A        return -1;\0A    }\0A    memset(content + len, 0, pad);\0A    len += pad;\0A    remaining -= pad;\0A\0A    *content_size = len;\0A    return 0;\0A}\0A\0A/* This function parses a (D)TLSInnerPlaintext structure.\0A * See ssl_build_inner_plaintext() for details. */\0AMBEDTLS_CHECK_RETURN_CRITICAL\0Astatic int ssl_parse_inner_plaintext(unsigned char const *content,\0A                                     size_t *content_size,\0A                                     uint8_t *rec_type)\0A{\0A    size_t remaining = *content_size;\0A\0A    /* Determine length of padding by skipping zeroes from the back. */\0A    do {\0A        if (remaining == 0) {\0A            return -1;\0A        }\0A        remaining--;\0A    } while (content[remaining] == 0);\0A\0A    *content_size = remaining;\0A    *rec_type = content[remaining];\0A\0A    return 0;\0A}\0A#endif /* MBEDTLS_SSL_DTLS_CONNECTION_ID || MBEDTLS_SSL_PROTO_TLS1_3 */\0A\0A/* The size of the `add_data` structure depends on various\0A * factors, namely\0A *\0A * 1) CID functionality disabled\0A *\0A * additional_data =\0A *    8:                    seq_num +\0A *    1:                       type +\0A *    2:                    version +\0A *    2:  length of inner plaintext +\0A *\0A * size = 13 bytes\0A *\0A * 2) CID functionality based on RFC 9146 e