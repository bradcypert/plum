@.str45530 = private global { i64, i64, [11243 x i8] } { i64 -1, i64 11242, [11243 x i8] c"/*\0A *  Generic ASN.1 parsing\0A *\0A *  Copyright The Mbed TLS Contributors\0A *  SPDX-License-Identifier: Apache-2.0 OR GPL-2.0-or-later\0A */\0A\0A#include \22common.h\22\0A\0A#if defined(MBEDTLS_ASN1_PARSE_C) || defined(MBEDTLS_X509_CREATE_C) || \5C\0A    defined(MBEDTLS_PSA_UTIL_HAVE_ECDSA)\0A\0A#include \22mbedtls/asn1.h\22\0A#include \22mbedtls/platform_util.h\22\0A#include \22mbedtls/error.h\22\0A\0A#include <string.h>\0A\0A#if defined(MBEDTLS_BIGNUM_C)\0A#include \22mbedtls/bignum.h\22\0A#endif\0A\0A#include \22mbedtls/platform.h\22\0A\0A/*\0A * ASN.1 DER decoding routines\0A */\0Aint mbedtls_asn1_get_len(unsigned char **p,\0A                         const unsigned char *end,\0A                         size_t *len)\0A{\0A    if ((end - *p) < 1) {\0A        return MBEDTLS_ERR_ASN1_OUT_OF_DATA;\0A    }\0A\0A    if ((**p & 0x80) == 0) {\0A        *len = *(*p)++;\0A    } else {\0A        int n = (**p) & 0x7F;\0A        if (n == 0 || n > 4) {\0A            return MBEDTLS_ERR_ASN1_INVALID_LENGTH;\0A        }\0A        if ((end - *p) <= n) {\0A            return MBEDTLS_ERR_ASN1_OUT_OF_DATA;\0A        }\0A        *len = 0;\0A        (*p)++;\0A        while (n--) {\0A            *len = (*len << 8) | **p;\0A            (*p)++;\0A        }\0A    }\0A\0A    if (*len > (size_t) (end - *p)) {\0A        return MBEDTLS_ERR_ASN1_OUT_OF_DATA;\0A    }\0A\0A    return 0;\0A}\0A\0Aint mbedtls_asn1_get_tag(unsigned char **p,\0A                         const unsigned char *end,\0A                         size_t *len, int tag)\0A{\0A    if ((end - *p) < 1) {\0A        return MBEDTLS_ERR_ASN1_OUT_OF_DATA;\0A    }\0A\0A    if (**p != tag) {\0A        return MBEDTLS_ERR_ASN1_UNEXPECTED_TAG;\0A    }\0A\0A    (*p)++;\0A\0A    return mbedtls_asn1_get_len(p, end, len);\0A}\0A#endif /* MBEDTLS_ASN1_PARSE_C || MBEDTLS_X509_CREATE_C || MBEDTLS_PSA_UTIL_HAVE_ECDSA */\0A\0A#if defined(MBEDTLS_ASN1_PAR