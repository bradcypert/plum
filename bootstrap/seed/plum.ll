 out += use_len;\0A        left -= use_len;\0A    }\0A\0A    /* 6. Update */\0A    if ((ret = mbedtls_hmac_drbg_update(ctx,\0A                                        additional, add_len)) != 0) {\0A        goto exit;\0A    }\0A\0A    /* 7. Update reseed counter */\0A    ctx->reseed_counter++;\0A\0Aexit:\0A    /* 8. Done */\0A    return ret;\0A}\0A\0A/*\0A * HMAC_DRBG random function\0A */\0Aint mbedtls_hmac_drbg_random(void *p_rng, unsigned char *output, size_t out_len)\0A{\0A    int ret = MBEDTLS_ERR_ERROR_CORRUPTION_DETECTED;\0A    mbedtls_hmac_drbg_context *ctx = (mbedtls_hmac_drbg_context *) p_rng;\0A\0A#if defined(MBEDTLS_THREADING_C)\0A    if ((ret = mbedtls_mutex_lock(&ctx->mutex)) != 0) {\0A        return ret;\0A    }\0A#endif\0A\0A    ret = mbedtls_hmac_drbg_random_with_add(ctx, output, out_len, NULL, 0);\0A\0A#if defined(MBEDTLS_THREADING_C)\0A    if (mbedtls_mutex_unlock(&ctx->mutex) != 0) {\0A        return MBEDTLS_ERR_THREADING_MUTEX_ERROR;\0A    }\0A#endif\0A\0A    return ret;\0A}\0A\0A/*\0A *  This function resets HMAC_DRBG context to the state immediately\0A *  after initial call of mbedtls_hmac_drbg_init().\0A */\0Avoid mbedtls_hmac_drbg_free(mbedtls_hmac_drbg_context *ctx)\0A{\0A    if (ctx == NULL) {\0A        return;\0A    }\0A\0A#if defined(MBEDTLS_THREADING_C)\0A    /* The mutex is initialized iff the md context is set up. */\0A    if (ctx->md_ctx.md_info != NULL) {\0A        mbedtls_mutex_free(&ctx->mutex);\0A    }\0A#endif\0A    mbedtls_md_free(&ctx->md_ctx);\0A    mbedtls_platform_zeroize(ctx, sizeof(mbedtls_hmac_drbg_context));\0A    ctx->reseed_interval = MBEDTLS_HMAC_DRBG_RESEED_INTERVAL;\0A}\0A\0A#if defined(MBEDTLS_FS_IO)\0Aint mbedtls_hmac_drbg_write_seed_file(mbedtls_hmac_drbg_context *ctx, const char *path)\0A{\0A    int ret = MBEDTLS_ERR_ERROR_CORRUPTION_DETECTED;\0A    FILE *f;\0A    unsigned char buf[MBEDTLS_HMAC_DRBG_MAX_INPUT];\0A\0A    if ((f = fopen(path, \22wb\22)) == NULL) {\0A        return MBEDTLS_ERR_HMAC_DRBG_FILE_IO_ERROR;\0A    }\0A\0A    /* Ensure no stdio buffering of secrets, as such buffers cannot be wiped. */\0A    mbedtls_setbuf(f, NULL);\0A\0A    if ((ret = mbedtls_hmac_drbg_random(ctx, buf, sizeof(buf))) != 0) {\0A        goto exit;\0A    }\0A\0A    if (fwrite(buf, 1, sizeof(buf), f) != sizeof(buf)) {\0A        ret = MBEDTLS_ERR_HMAC_DRBG_FILE_IO_ERROR;\0A        goto exit;\0A    }\0A\0A    ret = 0;\0A\0Aexit:\0A    fclose(f);\0A    mbedtls_platform_zeroize(buf, sizeof(buf));\0A\0A    return ret;\0A}\0A\0Aint mbedtls_hmac_drbg_update_seed_file(mbedtls_hmac_drbg_context *ctx, const char *path)\0A{\0A    int ret = 0;\0A    FILE *f = NULL;\0A    size_t n;\0A    unsigned char buf[MBEDTLS_HMAC_DRBG_MAX_INPUT];\0A    unsigned char c;\0A\0A    if ((f = fopen(path, \22rb\22)) == NULL) {\0A        return MBEDTLS_ERR_HMAC_DRBG_FILE_IO_ERROR;\0A    }\0A\0A    /* Ensure no stdio buffering of secrets, as such buffers cannot be wiped. */\0A    mbedtls_setbuf(f, NULL);\0A\0A    n = fread(buf, 1, sizeof(buf), f);\0A    if (fread(&c, 1, 1, f) != 0) {\0A        ret = MBEDTLS_ERR_HMAC_DRBG_INPUT_TOO_BIG;\0A        goto exit;\0A    }\0A    if (n == 0 || ferror(f)) {\0A        ret = MBEDTLS_ERR_HMAC_DRBG_FILE_IO_ERROR;\0A        goto exit;\0A    }\0A    fclose(f);\0A    f = NULL;\0A\0A    ret = mbedtls_hmac_drbg_update(ctx, buf, n);\0A\0Aexit:\0A    mbedtls_platform_zeroize(buf, sizeof(buf));\0A    if (f != NULL) {\0A        fclose(f);\0A    }\0A    if (ret != 0) {\0A        return ret;\0A    }\0A    return mbedtls_hmac_drbg_write_seed_file(ctx, path);\0A}\0A#endif /* MBEDTLS_FS_IO */\0A\0A\0A#if defined(MBEDTLS_SELF_TEST)\0A\0A#if !defined(MBEDTLS_MD_CAN_SHA1)\0A/* Dummy checkup routine */\0Aint mbedtls_hmac_drbg_self_test(int verbose)\0A{\0A    (void) verbose;\0A    return 0;\0A}\0A#else\0A\0A#define OUTPUT_LEN  80\0A\0A/* From a NIST PR=true test vector */\0Astatic const unsigned char entropy_pr[] = {\0A    0xa0, 0xc9, 0xab, 0x58, 0xf1, 0xe2, 0xe5, 0xa4, 0xde, 0x3e, 0xbd, 0x4f,\0A    0xf7,