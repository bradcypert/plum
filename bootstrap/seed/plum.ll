A_224 1\0A#endif\0A\0A#if defined(MBEDTLS_SHA256_C)\0A#define PSA_WANT_ALG_SHA_256 1\0A#endif\0A\0A#if defined(MBEDTLS_SHA384_C)\0A#define PSA_WANT_ALG_SHA_384 1\0A#endif\0A\0A#if defined(MBEDTLS_SHA512_C)\0A#define PSA_WANT_ALG_SHA_512 1\0A#endif\0A\0A#if defined(MBEDTLS_SHA3_C)\0A#define PSA_WANT_ALG_SHA3_224 1\0A#define PSA_WANT_ALG_SHA3_256 1\0A#define PSA_WANT_ALG_SHA3_384 1\0A#define PSA_WANT_ALG_SHA3_512 1\0A#endif\0A\0A/* Ensure that the PSA's supported curves (PSA_WANT_ECC_xxx) are always a\0A * superset of the builtin ones (MBEDTLS_ECP_DP_xxx). */\0A#if defined(MBEDTLS_ECP_DP_BP256R1_ENABLED)\0A#if !defined(PSA_WANT_ECC_BRAINPOOL_P_R1_256)\0A#define PSA_WANT_ECC_BRAINPOOL_P_R1_256 1\0A#endif /* PSA_WANT_ECC_BRAINPOOL_P_R1_256 */\0A#endif /* MBEDTLS_ECP_DP_BP256R1_ENABLED */\0A\0A#if defined(MBEDTLS_ECP_DP_BP384R1_ENABLED)\0A#if !defined(PSA_WANT_ECC_BRAINPOOL_P_R1_384)\0A#define PSA_WANT_ECC_BRAINPOOL_P_R1_384 1\0A#endif /* PSA_WANT_ECC_BRAINPOOL_P_R1_384 */\0A#endif /*MBEDTLS_ECP_DP_BP384R1_ENABLED  */\0A\0A#if defined(MBEDTLS_ECP_DP_BP512R1_ENABLED)\0A#if !defined(PSA_WANT_ECC_BRAINPOOL_P_R1_512)\0A#define PSA_WANT_ECC_BRAINPOOL_P_R1_512 1\0A#endif /* PSA_WANT_ECC_BRAINPOOL_P_R1_512 */\0A#endif /* MBEDTLS_ECP_DP_BP512R1_ENABLED */\0A\0A#if defined(MBEDTLS_ECP_DP_CURVE25519_ENABLED)\0A#if !defined(PSA_WANT_ECC_MONTGOMERY_255)\0A#define PSA_WANT_ECC_MONTGOMERY_255 1\0A#endif /* PSA_WANT_ECC_MONTGOMERY_255 */\0A#endif /* MBEDTLS_ECP_DP_CURVE25519_ENABLED */\0A\0A#if defined(MBEDTLS_ECP_DP_CURVE448_ENABLED)\0A#if !defined(PSA_WANT_ECC_MONTGOMERY_448)\0A#define PSA_WANT_ECC_MONTGOMERY_448 1\0A#endif /* PSA_WANT_ECC_MONTGOMERY_448 */\0A#endif /* MBEDTLS_ECP_DP_CURVE448_ENABLED */\0A\0A#if defined(MBEDTLS_ECP_DP_SECP192R1_ENABLED)\0A#if !defined(PSA_WANT_ECC_SECP_R1_192)\0A#define PSA_WANT_ECC_SECP_R1_192 1\0A#endif /* PSA_WANT_ECC_SECP_R1_192 */\0A#endif /* MBEDTLS_ECP_DP_SECP192R1_ENABLED */\0A\0A#if defined(MBEDTLS_ECP_DP_SECP224R1_ENABLED)\0A#if !defined(PS