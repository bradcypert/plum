EVEREST_ENABLED)\0A        case MBEDTLS_ECDH_VARIANT_EVEREST:\0A            return mbedtls_everest_make_public(&ctx->ctx.everest_ecdh, olen,\0A                                               buf, blen, f_rng, p_rng);\0A#endif\0A        case MBEDTLS_ECDH_VARIANT_MBEDTLS_2_0:\0A            return ecdh_make_public_internal(&ctx->ctx.mbed_ecdh, olen,\0A                                             ctx->point_format, buf, blen,\0A                                             f_rng, p_rng,\0A                                             restart_enabled);\0A        default:\0A            return MBEDTLS_ERR_ECP_BAD_INPUT_DATA;\0A    }\0A#endif\0A}\0A\0Astatic int ecdh_read_public_internal(mbedtls_ecdh_context_mbed *ctx,\0A                                     const unsigned char *buf, size_t blen)\0A{\0A    int ret = MBEDTLS_ERR_ERROR_CORRUPTION_DETECTED;\0A    const unsigned char *p = buf;\0A\0A    if ((ret = mbedtls_ecp_tls_read_point(&ctx->grp, &ctx->Qp, &p,\0A                                          blen)) != 0) {\0A        return ret;\0A    }\0A\0A    if ((size_t) (p - buf) != blen) {\0A        return MBEDTLS_ERR_ECP_BAD_INPUT_DATA;\0A    }\0A\0A    return 0;\0A}\0A\0A/*\0A * Parse and import the client's public value\0A */\0Aint mbedtls_ecdh_read_public(mbedtls_ecdh_context *ctx,\0A                             const unsigned char *buf, size_t blen)\0A{\0A#if defined(MBEDTLS_ECDH_LEGACY_CONTEXT)\0A    return ecdh_read_public_internal(ctx, buf, blen);\0A#else\0A    switch (ctx->var) {\0A#if defined(MBEDTLS_ECDH_VARIANT_EVEREST_ENABLED)\0A        case MBEDTLS_ECDH_VARIANT_EVEREST:\0A            return mbedtls_everest_read_public(&ctx->ctx.everest_ecdh,\0A                                               buf, blen);\0A#endif\0A        case MBEDTLS_ECDH_VARIANT_MBEDTLS_2_0:\0A            return ecdh_read_public_internal(&ctx->ctx.mbed_ecdh,\0A                                             buf, blen);\0A        default:\0A            return MBEDTLS_ERR_ECP_BAD_INPUT_DATA;\0A    }\0A#endif\0A}\0A\0Astatic int ecdh_calc_secret_internal(mbedtls_ecdh_context_mbed *ctx,\0A                                     size_t *olen, unsigned char *buf,\0A                                     size_t blen,\0A                                     int (*f_rng)(void *,\0A                                                  unsigned char *,\0A                                                  size_t),\0A                                     void *p_rng,\0A                                     int restart_enabled)\0A{\0A    int ret = MBEDTLS_ERR_ERROR_CORRUPTION_DETECTED;\0A#if defined(MBEDTLS_ECP_RESTARTABLE)\0A    mbedtls_ecp_restart_ctx *rs_ctx = NULL;\0A#endif\0A\0A    if (ctx == NULL || ctx->grp.pbits == 0) {\0A        return MBEDTLS_ERR_ECP_BAD_INPUT_DATA;\0A    }\0A\0A#if defined(MBEDTLS_ECP_RESTARTABLE)\0A    if (restart_enabled) {\0A        rs_ctx = &ctx->rs;\0A    }\0A#else\0A    (void) restart_enabled;\0A#endif\0A\0A#if defined(MBEDTLS_ECP_RESTARTABLE)\0A    if ((ret = ecdh_compute_shared_restartable(&ctx->grp, &ctx->z, &ctx->Qp,\0A                                               &ctx->d, f_rng, p_rng,\0A                                               rs_ctx)) != 0) {\0A        return ret;\0A    }\0A#else\0A    if ((ret = mbedtls_ecdh_compute_shared(&ctx->grp, &ctx->z, &ctx->Qp,\0A                                           &ctx->d, f_rng, p_rng)) != 0) {\0A        return ret;\0A    }\0A#endif /* MBEDTLS_ECP_RESTARTABLE */\0A\0A    if (mbedtls_mpi_size(&ctx->z) > blen) {\0A        return MBEDTLS_ERR_ECP_BAD_INPUT_DATA;\0A    }\0A\0A    *olen = ctx->grp.pbits / 8 + ((ctx->grp.pbits % 8) != 0);\0A\0A    if (mbedtls_ecp_get_type(&ctx->grp) == MBEDTLS_ECP_TYPE_MONTGOMERY) {\0A        return mbedtls_mpi_write_binary_le(&ctx->z, buf, *olen);\0A    }\0A\0A    return mbedtls_mpi_write_binary(&ctx->z, buf, *olen);\0A}\0A\0A/*\0A * Derive and export the shared secret\0A */\0Aint mbedtls_ecdh_calc_secret(mbedtls_ecdh_context *ctx, size_t *olen,\0A                             un