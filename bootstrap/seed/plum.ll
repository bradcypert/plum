r_cipher_operation_t;\0A\0A#define MBEDTLS_TRANSPARENT_TEST_DRIVER_CIPHER_OPERATION_INIT \5C\0A    MBEDTLS_PSA_CIPHER_OPERATION_INIT\0A#endif /* MBEDTLS_TEST_LIBTESTDRIVER1 &&\0A          LIBTESTDRIVER1_MBEDTLS_PSA_BUILTIN_CIPHER */\0A\0A#if defined(MBEDTLS_TEST_LIBTESTDRIVER1) && \5C\0A    defined(LIBTESTDRIVER1_MBEDTLS_PSA_BUILTIN_HASH)\0Atypedef libtestdriver1_mbedtls_psa_hash_operation_t\0A    mbedtls_transparent_test_driver_hash_operation_t;\0A\0A#define MBEDTLS_TRANSPARENT_TEST_DRIVER_HASH_OPERATION_INIT \5C\0A    LIBTESTDRIVER1_MBEDTLS_PSA_HASH_OPERATION_INIT\0A#else\0Atypedef mbedtls_psa_hash_operation_t\0A    mbedtls_transparent_test_driver_hash_operation_t;\0A\0A#define MBEDTLS_TRANSPARENT_TEST_DRIVER_HASH_OPERATION_INIT \5C\0A    MBEDTLS_PSA_HASH_OPERATION_INIT\0A#endif /* MBEDTLS_TEST_LIBTESTDRIVER1 &&\0A          LIBTESTDRIVER1_MBEDTLS_PSA_BUILTIN_HASH */\0A\0Atypedef struct {\0A    unsigned int initialised : 1;\0A    mbedtls_transparent_test_driver_cipher_operation_t ctx;\0A} mbedtls_opaque_test_driver_cipher_operation_t;\0A\0A#define MBEDTLS_OPAQUE_TEST_DRIVER_CIPHER_OPERATION_INIT \5C\0A    { 0, MBEDTLS_TRANSPARENT_TEST_DRIVER_CIPHER_OPERATION_INIT }\0A\0A#endif /* PSA_CRYPTO_DRIVER_TEST */\0A\0A/* Define the context to be used for an operation that is executed through the\0A * PSA Driver wrapper layer as the union of all possible driver's contexts.\0A *\0A * The union members are the driver's context structures, and the member names\0A * are formatted as `'drivername'_ctx`. This allows for procedural generation\0A * of both this file and the content of psa_crypto_driver_wrappers.h */\0A\0Atypedef union {\0A    unsigned dummy; /* Make sure this union is always non-empty */\0A    mbedtls_psa_hash_operation_t mbedtls_ctx;\0A#if defined(PSA_CRYPTO_DRIVER_TEST)\0A    mbedtls_transparent_test_driver_hash_operation_t test_driver_ctx;\0A#endif\0A} psa_driver_hash_context_t;\0A\0Atypedef union {\0A    unsigned dummy; /* Make sure this union is always non-empty */\0A    mbedtls_psa_cipher_operation_t mbedtls_ctx;\0A#if defined(PSA_CRYPTO_DRIVER_TEST)\0A    mbedtls_transparent_test_driver_cipher_operation_t transparent_test_driver_ctx;\0A    mbedtls_opaque_test_driver_cipher_operation_t opaque_test_driver_ctx;\0A#endif\0A} psa_driver_cipher_context_t;\0A\0A#endif /* PSA_CRYPTO_DRIVER_CONTEXTS_PRIMITIVES_H */\0A/* End of automatically generated file. */\0A\00" }
