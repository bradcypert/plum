A    const uint8_t *signature, size_t signature_length);\0A\0A/**\0A * \5Cbrief Continue and eventually complete the action of signing a hash or\0A *        short message with a private key, in an interruptible manner.\0A *\0A * \5Cnote The signature of this function is that of a PSA driver\0A *       sign_hash_complete entry point. This function behaves as a\0A *       sign_hash_complete entry point as defined in the PSA driver interface\0A *       specification for transparent drivers.\0A *\0A * \5Cparam[in]  operation        The \5Cc\0A *                              mbedtls_psa_sign_hash_interruptible_operation_t\0A *                              to use. This must be initialized first.\0A *\0A * \5Cretval #PSA_SUCCESS\0A *         Operation completed successfully, and the passed signature is valid.\0A *\0A * \5Cretval #PSA_OPERATION_INCOMPLETE\0A *         Operation was interrupted due to the setting of \5Cc\0A *         psa_interruptible_set_max_ops(), there is still work to be done,\0A *         please call this function again with the same operation object.\0A *\0A * \5Cretval #PSA_ERROR_INVALID_SIGNATURE\0A *         The calculation was performed successfully, but the passed\0A *         signature is not a valid signature.\0A *\0A * \5Cretval #PSA_ERROR_NOT_SUPPORTED \5Cemptydescription\0A * \5Cretval #PSA_ERROR_INVALID_ARGUMENT \5Cemptydescription\0A * \5Cretval #PSA_ERROR_INSUFFICIENT_MEMORY \5Cemptydescription\0A */\0Apsa_status_t mbedtls_psa_verify_hash_complete(\0A    mbedtls_psa_verify_hash_interruptible_operation_t *operation);\0A\0A/**\0A * \5Cbrief Abort a verify signed hash operation.\0A *\0A * \5Cnote The signature of this function is that of a PSA driver\0A *       verify_hash_abort entry point. This function behaves as a\0A *       verify_hash_abort entry point as defined in the PSA driver interface\0A *       specification for transparent drivers.\0A *\0A * \5Cparam[in]  operation        The \5Cc\0A *                              mbedtls_psa_verify_hash_interruptible_operation_t\0A *                              to abort.\0A *\0A * \5Cretval #PSA_SUCCESS\0A *         The operation was aborted successfully.\0A */\0Apsa_status_t mbedtls_psa_verify_hash_abort(\0A    mbedtls_psa_verify_hash_interruptible_operation_t *operation);\0A\0Atypedef struct psa_crypto_local_input_s {\0A    uint8_t *buffer;\0A    size_t length;\0A} psa_crypto_local_input_t;\0A\0A#define PSA_CRYPTO_LOCAL_INPUT_INIT ((psa_crypto_local_input_t) { NULL, 0 })\0A\0A/** Allocate a local copy of an input buffer and copy the contents into it.\0A *\0A * \5Cparam[in] input             Pointer to input buffer.\0A * \5Cparam[in] input_len         Length of the input buffer.\0A * \5Cparam[out] local_input      Pointer to a psa_crypto_local_input_t struct\0A *                              containing a local input copy.\0A * \5Creturn                      #PSA_SUCCESS, if the buffer was successfully\0A *                              copied.\0A * \5Creturn                      #PSA_ERROR_INSUFFICIENT_MEMORY, if a copy of\0A *                              the buffer cannot be allocated.\0A */\0Apsa_status_t psa_crypto_local_input_alloc(const uint8_t *input, size_t input_len,\0A                                          psa_crypto_local_input_t *local_input);\0A\0A/** Free a local copy of an input buffer.\0A *\0A * \5Cparam[in] local_input       Pointer to a psa_crypto_local_input_t struct\0A *                              populated by a previous call to\0A *                              psa_crypto_local_input_alloc().\0A */\0Avoid psa_crypto_local_input_free(psa_crypto_local_input_t *local_input);\0A\0Atypedef struct psa_crypto_local_output_s {\0A    uint8_t *original;\0A    uint8_t *buffer;\0A    size_t length;\0A} psa_crypto_local_output_t;\0A\0A#define PSA_CRYPTO_LOCAL_OUTPUT_INIT ((psa_crypto_local_output_t) { NULL, NULL, 0 })\0A\0A/** Allocate a local copy of an output buffer.\0A *\0A * \5Cnote                        This does not copy any data from the original\0A *                              output buffer but only allocates a buffer\0A *                              whose contents will be copied back to the\0A *                              original in a future call to\0A *                              psa_crypto_local_output_free().\0A *\0A * \5Cparam[in] output            Pointer to output buffer.\0A * \5Cparam[in] output_len        Length of the output buffer.\0A * \5Cparam[out] local_output     Pointer to a psa_crypto_local_output_t struct to\0A *                              populate with the local output copy.\0A * \5Creturn                      #PSA_SUCCESS, if the buffer was successfully\0A *                              copied.\0A * \5Creturn                      #PSA_ERROR_INSUFFICIENT_MEMORY, if a copy of\0A *                              the buffer cannot be allocated.\0A */\0Apsa_status_t psa_crypto_local_output_alloc(uint8_t *output, size_t output_len,\0A                                           psa_crypto_local_output_t *local_output);\0A\0A/** Copy from a local copy of an output buffer back to the original, then\0A *  free the local copy.\0A *\0A * \5Cparam[in] local_output      Pointer to a psa_crypto_local_output_t struct\0A *                              populated by a previous call to\0A *                              psa_crypto_local_output_alloc().\0A * \5Creturn                      #PSA_SUCCESS, if the local output was\0A *                              successfully copied back to the original.\0A * \5Creturn                      #PSA_ERROR_CORRUPTION_DETECTED, if the output\0A *                              could not be copied back to the original.\0A */\0Apsa_status_t psa_crypto_local_output_free(psa_crypto_local_output_t *local_output);\0A\0A#endif /* PSA_CRYPTO_CORE_H */\0A\00" }
