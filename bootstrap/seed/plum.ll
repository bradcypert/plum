@.str39926 = private global { i64, i64, [6544 x i8] } { i64 -1, i64 6543, [6544 x i8] c"/**\0A * \5Cfile error.h\0A *\0A * \5Cbrief Error to string translation\0A */\0A/*\0A *  Copyright The Mbed TLS Contributors\0A *  SPDX-License-Identifier: Apache-2.0 OR GPL-2.0-or-later\0A */\0A#ifndef MBEDTLS_ERROR_H\0A#define MBEDTLS_ERROR_H\0A\0A#include \22mbedtls/build_info.h\22\0A\0A#include <stddef.h>\0A\0A/**\0A * Error code layout.\0A *\0A * Currently we try to keep all error codes within the negative space of 16\0A * bits signed integers to support all platforms (-0x0001 - -0x7FFF). In\0A * addition we'd like to give two layers of information on the error if\0A * possible.\0A *\0A * For that purpose the error codes are segmented in the following manner:\0A *\0A * 16 bit error code bit-segmentation\0A *\0A * 1 bit  - Unused (sign bit)\0A * 3 bits - High level module ID\0A * 5 bits - Module-dependent error code\0A * 7 bits - Low level module errors\0A *\0A * For historical reasons, low-level error codes are divided in even and odd,\0A * even codes were assigned first, and -1 is reserved for other errors.\0A *\0A * Low-level module errors (0x0002-0x007E, 0x0001-0x007F)\0A *\0A * Module   Nr  Codes assigned\0A * ERROR     2  0x006E          0x0001\0A * MPI       7  0x0002-0x0010\0A * GCM       3  0x0012-0x0016   0x0013-0x0013\0A * THREADING 3  0x001A-0x001E\0A * AES       5  0x0020-0x0022   0x0021-0x0025\0A * CAMELLIA  3  0x0024-0x0026   0x0027-0x0027\0A * BASE64    2  0x002A-0x002C\0A * OID       1  0x002E-0x002E   0x000B-0x000B\0A * PADLOCK   1  0x0030-0x0030\0A * DES       2  0x0032-0x0032   0x0033-0x0033\0A * CTR_DBRG  4  0x0034-0x003A\0A * ENTROPY   3  0x003C-0x0040   0x003D-0x003F\0A * NET      13  0x0042-0x0052   0x0043-0x0049\0A * ARIA      4  0x0058-0x005E\0A * ASN1      7  0x0060-0x006C\0A * CMAC      1  0x007A-0x007A\0A * PBKDF2    1  0x007C-0x007C\0A * HMAC_DRBG 4                  0x0003-0x0009\0A * CCM       3                  0x000D-0x0011\0A * MD5       1                  0x002F-0x002F\0A * RIPEMD160 1                  0x0031-0x0031\0A * SHA1      1                  0x0035-0x0035 0x0073-0x0073\0A * SHA256    1                  0x0037-0x0037 0x0074-0x0074\0A * SHA512    1                  0x0039-0x0039 0x0075-0x0075\0A * SHA-3     1                  0x0076-0x0076\0A * CHACHA20  3                  0x0051-0x0055\0A * POLY1305  3                  0x0057-0x005B\0A * CHACHAPOLY 2 0x0054-0x0056\0A * PLATFORM  2  0x0070-0x0072\0A * LMS       5  0x0011-0x0019\0A *\0A * High-level module nr (3 bits - 0x0...-0x7...)\0A * Name      ID  Nr of Errors\0A * PEM       1   9\0A * PKCS#12   1   4 (Started from top)\0A * X509      2   20\0A * PKCS5     2   4 (Started from top)\0A * DHM       3   11\0A * PK        3   15 (Started from top)\0A * RSA       4   11\0A * ECP       4   10 (Started from top)\0A * MD        5   5\0A * HKDF      5   1 (Started from top)\0A * PKCS7     5   12 (Started from 0x5300)\0A * SSL       5   3 (Started from 0x5F00)\0A * CIPHER    6   8 (Started from 0x6080)\0A * SSL       6   22 (Started from top, plus 0x6000)\0A * SSL       7   20 (Started from 0x7000, gaps at\0A *                   0x7380, 0x7900-0x7980, 0x7A80-0x7E80)\0A *\0A * Module dependent error code (5 bits 0x.00.-0x.F8.)\0A */\0A\0A#ifdef __cplusplus\0Aextern \22C\22 {\0A#endif\0A\0A/** Generic error */\0A#define MBEDTLS_ERR_ERROR_GENERIC_ERROR       -0x0001\0A/** This is a bug in the library */\0A#define MBEDTLS_ERR_ERROR_CORRUPTION_DETECTED -0x006E\0A\0A/** Hardware accelerator failed */\0A#define MBEDTLS_ERR_PLATFORM_HW_ACCEL_FAILED     -0x0070\0A/** The requested feature is not supported by the platform */\0A#define MBEDTLS_ERR_PLATFORM_FEATURE_UNSUPPORTED -0x0072\0A\0A/**\0A * \5Cbrief Combines a high-level and low-level error code together.\0A *\0A *        Wrapper macro for mbedtls_error_add(). See that function for\0A *        more details.\0A */\0A#define MBEDTLS_ERROR_ADD(high, low) \5C\0A    mbedtls_error_add(high, low, __FILE__, __LINE__)\0A\0A#if defined(MBEDTLS_TEST_HOOKS)\0A/**\0A * \5Cbrief Testing hook called before adding/combining two error codes together.\0A *        Only used when invasive testing is enabled via MBEDTLS_TEST_HOOKS.\0A */\0Aextern void (*mbedtls_test_hook_error_add)(int, int, const char *, int);\0A#endif\0A\0A/**\0A * \5Cbrief Combines a high-level and low-level error code together.\0A *\0A *        This function can be called directly however it is usually\0A *        called via the #MBEDTLS_ERROR_ADD macro.\0A *\0A *        While a value of zero is not a negative error code, it is still an\0A *        error code (that denotes success) and can be combined with both a\0A *        negative error code or another value of zero.\0A *\0A * \5Cnote  When invasive testing is enabled via #MBEDTLS_TEST_HOOKS, also try to\0A *        call \5Clink mbedtls_test_hook_error_add \5Cendlink.\0A *\0A * \5Cparam high      high-level error code. See error.h for more details.\0A * \5Cparam low       low-level error code. See error.h for more details.\0A * \5Cparam file      file where this error code addition occurred.\0A * \5Cparam line      line where this error code addition occurred.\0A */\0Astatic inline int mbedtls_error_add(int high, int low,\0A                                    const char *file, int line)\0A{\0A#if defined(MBEDTLS_TEST_HOOKS)\0A    if (*mbedtls_test_hook_error_add != NULL) {\0A        (*mbedtls_test_hook_error_add)(high, low, file, line);\0A    }\0A#endif\0A    (void) file;\0A    (void) line;\0A\0A    return high + low;\0A}\0A\0A/**\0A * \5Cbrief Translate an Mbed TLS error code into a string representation.\0A *        The result is truncated if necessary and always includes a\0A *        terminating null byte.\0A *\0A * \5Cparam errnum    error code\0A * \5Cparam buffer    buffer to place representation in\0A * \5Cparam buflen    length of the buffer\0A */\0Avoid mbedtls_strerror(int errnum, char *buffer, size_t buflen);\0A\0A/**\0A * \5Cbrief Translate the high-level part of an Mbed TLS error code into a string\0A *        representation.\0A *\0A * This function returns a const pointer to an un-modifiable string. The caller\0A * must not try to modify the string. It is intended to be used mostly for\0A * logging purposes.\0A *\0A * \5Cparam error_code    error code\0A *\0A * \5Creturn The string representation of the error code, or \5Cc NULL if the error\0A *         code is unknown.\0A */\0Aconst char *mbedtls_high_level_strerr(int error_code);\0A\0A/**\0A * \5Cbrief Translate the low-level part of an Mbed TLS error code into a string\0A *        representation.\0A *\0A * This function returns a const pointer to an un-modifiable string. The caller\0A * must not try to modify the string. It is intended to be used mostly for\0A * logging purposes.\0A *\0A * \5Cparam error_code    error code\0A *\0A * \5Creturn The string representation of the error code, or \5Cc NULL if the error\0A *         code is unknown.\0A */\0Aconst char *mbedtls_low_level_strerr(int error_code);\0A\0A#ifdef __cplusplus\0A}\0A#endif\0A\0A#endif /* error.h */\0A\00" }
