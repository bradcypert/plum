@.str41582 = private global { i64, i64, [14997 x i8] } { i64 -1, i64 14996, [14997 x i8] c"/**\0A * \5Cfile aria.h\0A *\0A * \5Cbrief ARIA block cipher\0A *\0A *        The ARIA algorithm is a symmetric block cipher that can encrypt and\0A *        decrypt information. It is defined by the Korean Agency for\0A *        Technology and Standards (KATS) in <em>KS X 1213:2004</em> (in\0A *        Korean, but see http://210.104.33.10/ARIA/index-e.html in English)\0A *        and also described by the IETF in <em>RFC 5794</em>.\0A */\0A/*\0A *  Copyright The Mbed TLS Contributors\0A *  SPDX-License-Identifier: Apache-2.0 OR GPL-2.0-or-later\0A */\0A\0A#ifndef MBEDTLS_ARIA_H\0A#define MBEDTLS_ARIA_H\0A#include \22mbedtls/private_access.h\22\0A\0A#include \22mbedtls/build_info.h\22\0A\0A#include <stddef.h>\0A#include <stdint.h>\0A\0A#include \22mbedtls/platform_util.h\22\0A\0A#define MBEDTLS_ARIA_ENCRYPT     1 /**< ARIA encryption. */\0A#define MBEDTLS_ARIA_DECRYPT     0 /**< ARIA decryption. */\0A\0A#define MBEDTLS_ARIA_BLOCKSIZE   16 /**< ARIA block size in bytes. */\0A#define MBEDTLS_ARIA_MAX_ROUNDS  16 /**< Maximum number of rounds in ARIA. */\0A#define MBEDTLS_ARIA_MAX_KEYSIZE 32 /**< Maximum size of an ARIA key in bytes. */\0A\0A/** Bad input data. */\0A#define MBEDTLS_ERR_ARIA_BAD_INPUT_DATA -0x005C\0A\0A/** Invalid data input length. */\0A#define MBEDTLS_ERR_ARIA_INVALID_INPUT_LENGTH -0x005E\0A\0A#ifdef __cplusplus\0Aextern \22C\22 {\0A#endif\0A\0A#if !defined(MBEDTLS_ARIA_ALT)\0A// Regular implementation\0A//\0A\0A/**\0A * \5Cbrief The ARIA context-type definition.\0A */\0Atypedef struct mbedtls_aria_context {\0A    unsigned char MBEDTLS_PRIVATE(nr);           /*!< The number of rounds (12, 14 or 16) */\0A    /*! The ARIA round keys. */\0A    uint32_t MBEDTLS_PRIVATE(rk)[MBEDTLS_ARIA_MAX_ROUNDS + 1][MBEDTLS_ARIA_BLOCKSIZE / 4];\0A}\0Ambedtls_aria_context;\0A\0A#else  /* MBEDTLS_ARIA_ALT */\0A#include \22aria_alt.h\22\0A#endif /* MBEDTLS_ARIA_ALT */\0A\0A/**\0A * \5Cbrief          This function initializes the specified ARIA context.\0A *\0A *                 It must be the first API called before using\0A *                 the context.\0A *\0A * \5Cparam ctx      The ARIA context to initialize. This must not be \5Cc NULL.\0A */\0Avoid mbedtls_aria_init(mbedtls_aria_context *ctx);\0A\0A/**\0A * \5Cbrief          This function releases and clears the specified ARIA context.\0A *\0A * \5Cparam ctx      The ARIA context to clear. This may be \5Cc NULL, in which\0A *                 case this function returns immediately. If it is not \5Cc NULL,\0A *                 it must point to an initialized ARIA context.\0A */\0Avoid mbedtls_aria_free(mbedtls_aria_context *ctx);\0A\0A/**\0A * \5Cbrief          This function sets the encryption key.\0A *\0A * \5Cparam ctx      The ARIA context to which the key should be bound.\0A *                 This must be initialized.\0A * \5Cparam key      The encryption key. This must be a readable buffer\0A *                 of size \5Cp keybits Bits.\0A * \5Cparam keybits  The size of \5Cp key in Bits. Valid options are:\0A *                 <ul><li>128 bits</li>\0A *                 <li>192 bits</li>\0A *                 <li>256 bits</li></ul>\0A *\0A * \5Creturn         \5Cc 0 on success.\0A * \5Creturn         A negative error code on failure.\0A */\0Aint mbedtls_aria_setkey_enc(mbedtls_aria_context *ctx,\0A                            const unsigned char *key,\0A                            unsigned int keybits);\0A\0A#if !defined(MBEDTLS_BLOCK_CIPHER_NO_DECRYPT)\0A/**\0A * \5Cbrief          This function sets the decryption key.\0A *\0A * \5Cparam ctx      The ARIA context to which the key should be bound.\0A *                 This must be initialized.\0A * \5Cparam key      The decryption key. This must be a readable buffer\0A *                 of size \5Cp keybits Bits.\0A * \5Cparam keybits  The size of data passed. Valid options are:\0A *                 <ul><li>128 bits</li>\0A *                 <li>192 bits</li>\0A *                 <li>256 bits</li></ul>\0A *\0A * \5Creturn         \5Cc 0 on success.\0A * \5Creturn         A negative error code on failure.\0A */\0Aint mbedtls_aria_setkey_dec(mbedtls_aria_context *ctx,\0A                            const unsigned char *key,\0A                            unsigned int keybits);\0A#endif /* !MBEDTLS_BLOCK_CIPHER_NO_DECRYPT */\0A\0A/**\0A * \5Cbrief          This function performs an ARIA single-block encryption or\0A *                 decryption operation.\0A *\0A *                 It performs encryption or decryption (depending on whether\0A *                 the key was set for encryption on decryption) on the input\0A *                 data buffer defined in the \5Cp input parameter.\0A *\0A *                 mbedtls_aria_init(), and either mbedtls_aria_setkey_enc() or\0A *                 mbedtls_aria_setkey_dec() must be called before the first\0A *                 call to this API with the same context.\0A *\0A * \5Cparam ctx      The ARIA context to use for encryption or decryption.\0A *                 This must be initialized and bound to a key.\0A * \5Cparam input    The 16-Byte buffer holding the input data.\0A * \5Cparam output   The 16-Byte buffer holding the output data.\0A\0A * \5Creturn         \5Cc 0 on success.\0A * \5Creturn         A negative error code on failure.\0A */\0Aint mbedtls_aria_crypt_ecb(mbedtls_aria_context *ctx,\0A                           const unsigned char input[MBEDTLS_ARIA_BLOCKSIZE],\0A                           unsigned char output[MBEDTLS_ARIA_BLOCKSIZE]);\0A\0A#if defined(MBEDTLS_CIPHER_MODE_CBC)\0A/**\0A * \5Cbrief  This function performs an ARIA-CBC encryption or decryption operation\0A *         on full blocks.\0A *\0A *         It performs the operation defined in the \5Cp mode\0A *         parameter (encrypt/decrypt), on the input data buffer defined in\0A *         the \5Cp input parameter.\0A *\0A *         It can be called as many times as needed, until all the input\0A *         data is processed. mbedtls_aria_init(), and either\0A *         mbedtls_aria_setkey_enc() or mbedtls_aria_setkey_dec() must be called\0A *         before the first call to this API with the same context.\0A *\0A * \5Cnote   This function operates on aligned blocks, that is, the input size\0A *         must be a multiple of the ARIA block size of 16 Bytes.\0A *\0A * \5Cnote   Upon exit, the content of the IV is updated so that you can\0A *         call the same function again on the next\0A *         block(s) of data and get the same result as if it was\0A *         encrypted in one call. This allows a \22streaming\22 usage.\0A *         If you need to retain the contents of the IV, you should\0A *         either save it manually or use the cipher module instead.\0A *\0A *\0A * \5Cparam ctx      The ARIA context to use for encryption or decryption.\0A *                 This must be initialized and bound to a key.\0A * \5Cparam mode     The mode of operation. This must be either\0A *                 #MBEDTLS_ARIA_ENCRYPT for encryption, or\0A *                 #MBEDTLS_ARIA_DECRYPT for decryption.\0A * \5Cparam length   The length of the input data in Bytes. This must be a\0A *                 multiple of the block size (16 Bytes).\0A * \5Cparam iv       Initialization vector (updated after use).\0A *                 This must be a readable buffer of size 16 Bytes.\0A * \5Cparam input    The buffer holding the input data. This must\0A *                 be a readable buffer of length \5Cp length Bytes.\0A * \5Cparam output   The buffer holding the output data. This must\0A *                 be a writable buffer of length \5Cp length Bytes.\0A *\0A * \5Creturn         \5Cc 0 on success.\0A * \5Creturn         A negative error code on failure.\0A */\0Aint mbedtls_aria_crypt_cbc(mbedtls_aria_context *ctx,\0A                           int mode,\0A                           size_t length,\0A                           unsigned char iv[MBEDTLS_ARIA_BLOCKSIZE],\0A                           const unsigned char *input,\0A                           unsigned char *output);\0A#endif /* MBEDTLS_CIPHER_MODE_CBC */\0A\0A#if defined(MBEDTLS_CIPHER_MODE_CFB)\0A/**\0A * \5Cbrief This function performs an ARIA-CFB128 encryption or decryption\0A *        operation.\0A *\0A *        It performs the operation defined in the \5Cp mode\0A *        parameter (encrypt or decrypt), on the input data buffer\0A *        defined in the \5Cp input parameter.\0A *\0A *        For CFB, you must set up the context with mbedtls_aria_setkey_enc(),\0A *        regardless of whether you are performing an encryption or decryption\0A *        operation, that is, regardless of the \5Cp mode parameter. This is\0A *        because CFB mode uses the same key schedule for encryption and\0A *        decryption.\0A *\0A * \5Cnote  Upon exit, the content of the IV is updated so that you can\0A *        call the same function again on the next\0A *        block(s) of data and get the same result as if it was\0A *        encrypted in one call. This allows a \22streaming\22 usage.\0A *        If you need to retain the contents of the\0A *        IV, you must either save it manually or use the cipher\0A *        module instead.\0A *\0A *\0A * \5Cparam ctx      The ARIA context to use for encryption or decryption.\0A *                 This must be initialized and bound to a key.\0A * \5Cparam mode     The mode of operation. This must be either\0A *                 #MBEDTLS_ARIA_ENCRYPT for encryption, or\0A *                 #MBEDTLS_ARIA_DECRYPT for decryption.\0A * \5Cparam length   The length of the input data \5Cp input in Bytes.\0A * \5Cparam iv_off   The offset in IV (updated after use).\0A *                 This must not be larger than 15.\0A * \5Cparam iv       The initialization vector (updated after use).\0A *                 This must be a readable buffer of size 16 Bytes.\0A * \5Cparam input    The buffer holding the input data. This must\0A *                 be a readable buffer of length \5Cp length Bytes.\0A * \5Cparam output   The buffer holding the output data. This must\0A *                 be a writable buffer of length \5Cp length Bytes.\0A *\0A * \5Creturn         \5Cc 0 on success.\0A * \5Creturn         A negative error code on failure.\0A */\0Aint mbedtls_aria_crypt_cfb128(mbedtls_aria_context *ctx,\0A                              int mode,\0A                              size_t length,\0A                              size_t *iv_off,\0A                              unsigned char iv[MBEDTLS_ARIA_BLOCKSIZE],\0A                              const unsigned char *input,\0A                              unsigned char *output);\0A#endif /* MBEDTLS_CIPHER_MODE_CFB */\0A\0A#if defined(MBEDTLS_CIPHER_MODE_CTR)\0A/**\0A * \5Cbrief      This function performs an ARIA-CTR encryption or decryption\0A *             operation.\0A *\0A *             Due to the nature of CTR, you must use the same key schedule\0A *             for both encryption and decryption operations. Therefore, you\0A *             must use the context initialized with mbedtls_aria_setkey_enc()\0A *             for both #MBEDTLS_ARIA_ENCRYPT and #MBEDTLS_ARIA_DECRYPT.\0A *\0A * \5Cwarning    You must never reuse a nonce value with the same key. Doing so\0A *             would void the encryption for the two messages encrypted with\0A *             the same nonce and key.\0A *\0A *             There are two common strategies for managing nonces with CTR:\0A *\0A *             1. You can handle everything as a single message processed over\0A *             successive calls to this function. In that case, you want to\0A *             set \5Cp nonce_counter and \5Cp nc_off to 0 for the first call, and\0A *             then preserve the values of \5Cp nonce_counter, \5Cp nc_off and \5Cp\0A *             stream_block across calls to this function as they will be\0A *             updated by this function.\0A *\0A *             With this strategy, you must not encrypt more than 2**128\0A *             blocks of data with the same key.\0A *\0A *             2. You can encrypt separate messages by dividing the \5Cp\0A *             nonce_counter buffer in two areas: the first one used for a\0A *             per-message nonce, handled by yourself, and the second one\0A *             updated by this function internally.\0A *\0A *             For example, you might reserve the first 12 bytes for the\0A *             per-message nonce, and the last 4 bytes for internal use. In that\0A *             case, before calling this function on a new message you need to\0A *             set the first 12 bytes of \5Cp nonce_counter to your chosen nonce\0A *             value, the last 4 to 0, and \5Cp nc_off to 0 (which will cause \5Cp\0A *             stream_block to be ignored). That way, you can encrypt at most\0A *             2**96 messages of up to 2**32 blocks each with the same key.\0A *\0A *             The per-message nonce (or information sufficient to reconstruct\0A *             it) needs to be communicated with the ciphertext and must be unique.\0A *             The recommended way to ensure uniqueness is to use a message\0A *             counter. An alternative is to generate random nonces, but this\0A *             limits the number of messages that can be securely encrypted:\0A *             for example, with 96-bit random nonces, you should not encrypt\0A *             more than 2**32 messages with the same key.\0A *\0A *             Note that for both strategies, sizes are measured in blocks and\0A *             that an ARIA block is 16 bytes.\0A *\0A * \5Cwarning    Upon return, \5Cp stream_block contains sensitive data. Its\0A *             content must not be written to insecure storage and should be\0A *             securely discarded as soon as it's no longer needed.\0A *\0A * \5Cparam ctx              The ARIA context to use for encryption or decryption.\0A *                         This must be initialized and bound to a key.\0A * \5Cparam length           The length of the input data \5Cp input in Bytes.\0A * \5Cparam nc_off           The offset in Bytes in the current \5Cp stream_block,\0A *                         for resuming within the current cipher stream. The\0A *                         offset pointer should be \5Cc 0 at the start of a\0A *                         stream. This must not be larger than \5Cc 15 Bytes.\0A * \5Cparam nonce_counter    The 128-bit nonce and counter. This must point to\0A *                         a read/write buffer of length \5Cc 16 bytes.\0A * \5Cparam stream_block     The saved stream block for resuming. This must\0A *                         point to a read/write buffer of length \5Cc 16 bytes.\0A *                         This is overwritten by the function.\0A * \5Cparam input            The buffer holding the input data. This must\0A *                         be a readable buffer of length \5Cp length Bytes.\0A * \5Cparam output           The buffer holding the output data. This must\0A *                         be a writable buffer of length \5Cp length Bytes.\0A *\0A * \5Creturn                 \5Cc 0 on success.\0A * \5Creturn                 A negative error code on failure.\0A */\0Aint mbedtls_aria_crypt_ctr(mbedtls_aria_context *ctx,\0A                           size_t length,\0A                           size_t *nc_off,\0A                           unsigned char nonce_counter[MBEDTLS_ARIA_BLOCKSIZE],\0A                           unsigned char stream_block[MBEDTLS_ARIA_BLOCKSIZE],\0A                           const unsigned char *input,\0A                           unsigned char *output);\0A#endif /* MBEDTLS_CIPHER_MODE_CTR */\0A\0A#if defined(MBEDTLS_SELF_TEST)\0A/**\0A * \5Cbrief          Checkup routine.\0A *\0A * \5Creturn         \5Cc 0 on success, or \5Cc 1 on failure.\0A */\0Aint mbedtls_aria_self_test(int verbose);\0A#endif /* MBEDTLS_SELF_TEST */\0A\0A#ifdef __cplusplus\0A}\0A#endif\0A\0A#endif /* aria.h */\0A\00" }
