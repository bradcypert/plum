@.str46375 = private global { i64, i64, [4700 x i8] } { i64 -1, i64 4699, [4700 x i8] c"// TLS transport boundary for Http.  This is intentionally separate from\0A// net_shim.c: a TLS connection is an opaque session, not a socket fd.\0A//\0A// The first implementation uses Mbed TLS' client API.  The Plum ABI sees\0A// only Int handles, CStrs, and byte counts; certificate loading, hostname\0A// verification, and the underlying socket remain native details.\0A\0A#include <stdlib.h>\0A#include <string.h>\0A#include <stdio.h>\0A#include <stdint.h>\0A\0A#include <mbedtls/net_sockets.h>\0A#include <mbedtls/ssl.h>\0A#include <mbedtls/error.h>\0A#include <mbedtls/x509_crt.h>\0A\0A#if defined(_WIN32)\0A#include <windows.h>\0A#include <wincrypt.h>\0A#endif\0A\0Atypedef struct {\0A    mbedtls_net_context net;\0A    mbedtls_ssl_context ssl;\0A    mbedtls_ssl_config config;\0A    mbedtls_x509_crt ca;\0A} plum_tls;\0A\0Astatic int plum_load_ca(mbedtls_x509_crt *ca) {\0A#if defined(_WIN32)\0A    HCERTSTORE store = CertOpenSystemStoreA(0, \22ROOT\22);\0A    if (store == NULL) return -1;\0A    int loaded = 0;\0A    PCCERT_CONTEXT cert = NULL;\0A    while ((cert = CertEnumCertificatesInStore(store, cert)) != NULL) {\0A        if (mbedtls_x509_crt_parse_der(ca, cert->pbCertEncoded,\0A                                       cert->cbCertEncoded) == 0) {\0A            loaded++;\0A        }\0A    }\0A    CertCloseStore(store, 0);\0A    return loaded == 0 ? -1 : 0;\0A#else\0A    static const char *paths[] = {\0A        \22/etc/ssl/certs/ca-certificates.crt\22,\0A        \22/etc/ssl/cert.pem\22,\0A        \22/etc/pki/tls/certs/ca-bundle.crt\22,\0A        NULL,\0A    };\0A    for (int i = 0; paths[i] != NULL; ++i) {\0A        FILE *f = fopen(paths[i], \22rb\22);\0A        if (f != NULL) {\0A            fclose(f);\0A            return mbedtls_x509_crt_parse_file(ca, paths[i]);\0A        }\0A    }\0A    return -1;\0A#endif\0A}\0A\0Along long tls_connect(const char *host, long long port) {\0A    plum_tls *t = (plum_tls *)calloc(1, sizeof(*t));\0A    if (t == NULL) return -1;\0A    mbedtls_net_init(&t->net);\0A    mbedtls_ssl_init(&t->ssl);\0A    mbedtls_ssl_config_init(&t->config);\0A    mbedtls_x509_crt_init(&t->ca);\0A\0A    char service[32];\0A    (void)snprintf(service, sizeof(service), \22%lld\22, port);\0A    int rc = mbedtls_net_connect(&t->net, host, service, MBEDTLS_NET_PROTO_TCP);\0A    if (rc != 0 || (rc = plum_load_ca(&t->ca)) != 0 ||\0A        (rc = mbedtls_ssl_config_defaults(&t->config,\0A             MBEDTLS_SSL_IS_CLIENT, MBEDTLS_SSL_TRANSPORT_STREAM,\0A             MBEDTLS_SSL_PRESET_DEFAULT)) != 0) {\0A        goto fail;\0A    }\0A    mbedtls_ssl_conf_authmode(&t->config, MBEDTLS_SSL_VERIFY_REQUIRED);\0A    mbedtls_ssl_conf_ca_chain(&t->config, &t->ca, NULL);\0A    if ((rc = mbedtls_ssl_setup(&t->ssl, &t->config)) != 0 ||\0A        (rc = mbedtls_ssl_set_hostname(&t->ssl, host)) != 0) goto fail;\0A    mbedtls_ssl_set_bio(&t->ssl, &t->net, mbedtls_net_send,\0A                        mbedtls_net_recv, NULL);\0A    do { rc = mbedtls_ssl_handshake(&t->ssl); }\0A    while (rc == MBEDTLS_ERR_SSL_WANT_READ || rc == MBEDTLS_ERR_SSL_WANT_WRITE);\0A    if (rc != 0 || mbedtls_ssl_get_verify_result(&t->ssl) != 0) goto fail;\0A    return (long long)(intptr_t)t;\0A\0Afail:\0A    mbedtls_x509_crt_free(&t->ca);\0A    mbedtls_ssl_config_free(&t->config);\0A    mbedtls_ssl_free(&t->ssl);\0A    mbedtls_net_free(&t->net);\0A    free(t);\0A    return -1;\0A}\0A\0Along long tls_send(long long handle, const char *buf, long long len) {\0A    plum_tls *t = (plum_tls *)(intptr_t)handle;\0A    if (t == NULL || len < 0) return -1;\0A    long long done = 0;\0A    while (done < len) {\0A        int n = mbedtls_ssl_write(&t->ssl, (const unsigned char *)buf + done,\0A                                  (size_t)(len - done));\0A        if (n <= 0) return -1;\0A        done += n;\0A    }\0A    return done;\0A}\0A\0Astatic _Thread_local unsigned char *tls_buf;\0Astatic _Thread_local size_t tls_cap;\0A\0Along long tls_recv_n(long long handle, long long max_len) {\0A    plum_tls *t = (plum_tls *)(intptr_t)handle;\0A    if (t == NULL || max_len < 0) return -1;\0A    size_t need = (size_t)max_len + 1;\0A    if (tls_cap < need) {\0A        unsigned char *p = (unsigned char *)realloc(tls_buf, need);\0A        if (p == NULL) return -1;\0A        tls_buf = p; tls_cap = need;\0A    }\0A    int n;\0A    do { n = mbedtls_ssl_read(&t->ssl, tls_buf, (size_t)max_len); }\0A    while (n == MBEDTLS_ERR_SSL_WANT_READ || n == MBEDTLS_ERR_SSL_WANT_WRITE);\0A    if (n == MBEDTLS_ERR_SSL_PEER_CLOSE_NOTIFY || n == 0) return 0;\0A    return n < 0 ? -1 : n;\0A}\0A\0Aconst char *tls_recv_data(void) { return tls_buf ? (const char *)tls_buf : \22\22; }\0A\0Avoid tls_close(long long handle) {\0A    plum_tls *t = (plum_tls *)(intptr_t)handle;\0A    if (t == NULL) return;\0A    (void)mbedtls_ssl_close_notify(&t->ssl);\0A    mbedtls_x509_crt_free(&t->ca);\0A    mbedtls_ssl_config_free(&t->config);\0A    mbedtls_ssl_free(&t->ssl);\0A    mbedtls_net_free(&t->net);\0A    free(t);\0A}\0A\00" }
