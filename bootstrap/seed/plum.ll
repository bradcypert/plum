 if i >= b.len() { true }\0A    else if http_hex(http_byte(b, i)) { http_hex_ok(b, i + 1) } else { false }\0A\0A// IPv4 is special only as an IPv6 suffix: exactly four decimal octets,\0A// no leading zeroes. Elsewhere dotted text can also be a reg-name.\0Alet http_ipv4_ok (s: String): Bool = {\0A    let parts = s.split(\22.\22);\0A    parts.len() == 4 && Array.all(parts, |part| {\0A        let b = part.as_bytes();\0A        b.len() >= 1 && b.len() <= 3 && (b.len() == 1 || http_byte(b, 0) != 48)\0A            && http_port_ok(b, 0) && match String.parse_int(part) { Ok(n) => n <= 255, Err(_) => false }\0A    })\0A}\0A\0Alet http_ipv6_groups (parts: Array[String]) (i: Int) (allow_ipv4: Bool) (count: Int): Int =\0A    if i >= parts.len() { count }\0A    else {\0A        let part = parts[i];\0A        if allow_ipv4 && i == parts.len() - 1 && String.contains(part, \22.\22) {\0A            if http_ipv4_ok(part) { count + 2 } else { -1 }\0A        } else if part.len() >= 1 && part.len() <= 4 && http_hex_ok(part.as_bytes(), 0) {\0A            http_ipv6_groups(parts, i + 1, allow_ipv4, count + 1)\0A        } else { -1 }\0A    }\0A\0Alet http_ipv6_side (s: String) (allow_ipv4: Bool): Int =\0A    if String.is_empty(s) { 0 } else { http_ipv6_groups(s.split(\22:\22), 0, allow_ipv4, 0) }\0A\0Alet http_ipv6_ok (s: String): Bool =\0A    if s.len() > 45 { false }\0A    else { match String.index_of(s, \22::\22) {\0A        None => http_ipv6_side(s, true) == 8,\0A        Some(i) => {\0A            let left = http_ipv6_side(String.slice(s, 0, i), false);\0A            let right = http_ipv6_side(String.slice(s, i + 2, String.char_len(s)), true);\0A            left >= 0 && right >= 0 && left + right < 8\0A        },\0A    } }\0A\0Alet http_ipvfuture_tail (b: Bytes) (i: Int): Bool =\0A    if i >= b.len() { true }\0A    else if http_reg_name_byte(http_byte(b, i)) || http_byte(b, i) == 58 { http_ipvfuture_tail(b, i + 1) } else { false }\0A\0Alet http_ip_literal_ok (s: String): Bool =\0A    if