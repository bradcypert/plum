@.str62552 = private global { i64, i64, [27390 x i8] } { i64 -1, i64 27389, [27390 x i8] c"/// Filesystem and self-location. These replaced shelling out to\0A/// `mktemp -d`, `rm -rf`, `rm -f`, `cp -r` and `mkdir`, and reading\0A/// `/proc/self/exe`. See `native_stdlib/os_shim.c`.\0A///\0A/// The `..._raw` forms are runtime primitives whose Plum bodies\0A/// exist only to give the checker a signature. They travel with the\0A/// module: `cg_runtime_fn` keys on the bare name and does not care\0A/// which module the call was written in.\0Alet os_temp_dir_raw (ignored: Bool): String = \22\22\0Alet os_self_exe_raw (ignored: Bool): String = \22\22\0Alet os_make_dir_raw (path: String): Int = 0\0Alet os_remove_file_raw (path: String): Int = 0\0Alet os_rename_file_raw (from: String) (to: String): Int = 0\0Alet os_remove_tree_raw (path: String): Int = 0\0Alet os_copy_tree_raw (src: String) (dst: String): Int = 0\0Alet os_platform_raw (ignored: Bool): String = \22\22\0A\0A/// Which platform this program is running on: \22linux\22, \22macos\22 or\0A/// \22windows\22. Compiled in, not detected at runtime; a binary\0A/// cannot move between platforms, so there is nothing to detect.\0Apub let platform (): String = os_platform_raw(true)\0A\0A/// A fresh, empty, private directory. The caller owns it and is\0A/// responsible for `Os.remove_tree` on it.\0Apub let temp_dir (): Result[String, String] = {\0A    let d = os_temp_dir_raw(true);\0A    if String.is_empty(d) { Err(\22Os.temp_dir: could not create a temporary directory\22) }\0A    else { Ok(d) }\0A}\0A\0A/// The path of the running executable, for a program that needs to\0A/// re-invoke itself.\0Apub let self_exe (): Result[String, String] = {\0A    let p = os_self_exe_raw(true);\0A    if String.is_empty(p) { Err(\22Os.self_exe: could not determine the executable path\22) }\0A    else { Ok(p) }\0A}\0A\0A/// Creates one directory. The PARENT must already exist; this makes a\0A/// single level, not a path.\0A///\0A/// `Err` when the parent is missing, when the name is taken by a file,\0A/// or when permission is refused. A directory that already exists is\0A/// also an `Err`, so a caller who does not care should check\0A/// `Os.exists` first.\0Apub let make_dir (path: String): Result[Unit, String] =\0A    if os_make_dir_raw(path) == 0 { Ok(()) }\0A    else { Err(\22Os.make_dir: could not create \22.concat(path)) }\0A\0A/// Atomic within one filesystem, and an error rather than a silent\0A/// copy across two. The point is that the destination is never a\0A/// half-written file.\0Apub let rename_file (from: String) (to: String): Result[Unit, String] =\0A    if os_rename_file_raw(from, to) == 0 { Ok(()) }\0A    else { Err(\22Os.rename_file: could not rename \22.concat(from).concat(\22 to \22).concat(to)) }\0A\0A/// Deletes a file. `Err` when it is not there, when it is a directory,\0A/// or when permission is refused — `Os.remove_tree` is the one for\0A/// directories.\0Apub let remove_file (path: String): Result[Unit, String] =\0A    if os_remove_file_raw(path) == 0 { Ok(()) }\0A    else { Err(\22Os.remove_file: could not remove \22.concat(path)) }\0A\0A/// Deletes a file or directory tree. A final symlink is removed even\0A/// with trailing separators; links encountered in the tree are never\0A/// followed. Ancestors of the requested path resolve normally when the\0A/// starting directory is acquired; traversal then uses held directories.\0A/// Concurrent changes or resource exhaustion can return `Err` after partial\0A/// removal. Traversal is limited to 128 directory levels to bound native\0A/// stack, enumeration storage, and open handles. Empty paths and final\0A/// `.` or `..` components are rejected.\0Apub let remove_tree (path: String): Result[Unit, String] =\0A    if os_remove_tree_raw(path) == 0 { Ok(()) }\0A    else { Err(\22Os.remove_tree: could not remove \22.concat(path)) }\0A\0A/// Copies the contents of `src` into the existing directory `dst`.\0A/// Both roots must be ordinary directories, even with trailing separators;\0A/// their ancestors resolve normally. Identical or nested roots return `Err`\0A/// before changing `dst`. Links inside `src` are copied as links, including\0A/// dangling links, without reading their targets. Destination links and\0A/// unsupported Windows reparse points are rejected. Failure to recreate a\0A/// link returns `Err` rather than substituting its target or link text.\0A/// Regular destination files are replaced, so other hardlinks are unchanged.\0A/// Traversal uses held directories, at most 128 levels, and a 64 KiB transfer\0A/// buffer independent of file size. Errors can leave partial output; the\0A/// caller owns cleanup. File modes are not preserved.\0Apub let copy_tree (src: String) (dst: String): Result[Unit, String] =\0A    if os_copy_tree_raw(src, dst) == 0 { Ok(()) }\0A    else { Err(\22Os.copy_tree: could not copy \22.concat(src).concat(\22 to \22).concat(dst)) }\0A\0A// --- Environment and process ---\0A//\0A// Folded in from the flat prelude in 0.0.9. `Os` already owned the\0A// filesystem calls that shell out to `os_shim.c`, so putting\0A// `read_file` in a separate `Fs` would have split the filesystem\0A// across two modules. This is the shape Go settled on -- `os.ReadFile`,\0A// `os.Getenv`, `os.Exit`, `os.MkdirAll` in one place, with `net`\0A// separate and string helpers on the type.\0A\0Alet exit_raw (code: Int): Bool = false\0Alet env_var_raw (name: String): Array[Bytes] = []\0A\0A/// Exit with a status code, printing nothing. `panic_raw` also exits\0A/// non-zero but prints its message first, which is wrong when the\0A/// report has already been written.\0Apub let exit_with (code: Int): Unit = { exit_raw(code); () }\0A\0A// The raw runtime returns an array (empty when unset), so variant tags\0A// remain the compiler's responsibility. OS bytes become text only through\0A// the same checked conversion used by read_file.\0A/// Reads an environment value as bytes, preserving non-UTF-8 data.\