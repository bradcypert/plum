t char *) name,\0A                                                               name_len));\0A    // Write OID\0A    //\0A    MBEDTLS_ASN1_CHK_ADD(len, mbedtls_asn1_write_oid(p, start, oid,\0A                                                     oid_len));\0A\0A    MBEDTLS_ASN1_CHK_ADD(len, mbedtls_asn1_write_len(p, start, len));\0A    MBEDTLS_ASN1_CHK_ADD(len, mbedtls_asn1_write_tag(p, start,\0A                                                     MBEDTLS_ASN1_CONSTRUCTED |\0A                                                     MBEDTLS_ASN1_SEQUENCE));\0A\0A    MBEDTLS_ASN1_CHK_ADD(len, mbedtls_asn1_write_len(p, start, len));\0A    MBEDTLS_ASN1_CHK_ADD(len, mbedtls_asn1_write_tag(p, start,\0A                                                     MBEDTLS_ASN1_CONSTRUCTED |\0A                                                     MBEDTLS_ASN1_SET));\0A\0A    return (int) len;\0A}\0A\0Aint mbedtls_x509_write_names(unsigned char **p, unsigned char *start,\0A                             mbedtls_asn1_named_data *first)\0A{\0A    int ret = MBEDTLS_ERR_ERROR_CORRUPTION_DETECTED;\0A    size_t len = 0;\0A    mbedtls_asn1_named_data *cur = first;\0A\0A    while (cur != NULL) {\0A        MBEDTLS_ASN1_CHK_ADD(len, x509_write_name(p, start, cur));\0A        cur = cur->next;\0A    }\0A\0A    MBEDTLS_ASN1_CHK_ADD(len, mbedtls_asn1_write_len(p, start, len));\0A    MBEDTLS_ASN1_CHK_ADD(len, mbedtls_asn1_write_tag(p, start, MBEDTLS_ASN1_CONSTRUCTED |\0A                                                     MBEDTLS_ASN1_SEQUENCE));\0A\0A    return (int) len;\0A}\0A\0Aint mbedtls_x509_write_sig(unsigned char **p, unsigned char *start,\0A                           const char *oid, size_t oid_len,\0A                           unsigned char *sig, size_t size,\0A                           mbedtls_pk_type_t pk_alg)\0A{\0A    int ret = MBEDTLS_ERR_ERROR_CORRUPTION_DETECTED;\0A    int write_null_par;\0A    size_t len = 0;\0A\0A    if (*p < start || (size_t) (*p - start) < size) {\0A        return MBEDTLS_ERR_ASN1_BUF_TOO_SMALL;\0A    }\0A\0A    len = size;\0A    (*p) -= len;\0A    memcpy(*p, sig, len);\0A\0A    if (*p - start < 1) {\0A        return MBEDTLS_ERR_ASN1_BUF_TOO_SMALL;\0A    }\0A\0A    *--(*p) = 0;\0A    len += 1;\0A\0A    MBEDTLS_ASN1_CHK_ADD(len, mbedtls_asn1_write_len(p, start, len));\0A    MBEDTLS_ASN1_CHK_ADD(len, mbedtls_asn1_write_tag(p, start, MBEDTLS_ASN1_BIT_STRING));\0A\0A    // Write OID\0A    //\0A    if (pk_alg == MBEDTLS_PK_ECDSA) {\0A        /*\0A         * The AlgorithmIdentifier's parameters field must be absent for DSA/ECDSA signature\0A         * algorithms, see https://www.rfc-editor.org/rfc/rfc5480#page-17 and\0A         * https://www.rfc-editor.org/rfc/rfc5758#section-3.\0A         */\0A        write_null_par = 0;\0A    } else {\0A        write_null_par = 1;\0A    }\0A    MBEDTLS_ASN1_CHK_ADD(len,\0A                         mbedtls_asn1_write_algorithm_identifier_ext(p, start, oid, oid_len,\0A                                                                     0, write_null_par));\0A\0A    return (int) len;\0A}\0A\0Astatic int x509_write_extension(unsigned char **p, unsigned char *start,\0A                                mbedtls_asn1_named_data *ext)\0A{\0A    int ret = MBEDTLS_ERR_ERROR_CORRUPTION_DETECTED;\0A    size_t len = 0;\0A\0A    MBEDTLS_ASN1_CHK_ADD(len, mbedtls_asn1_write_raw_buffer(p, start, ext->val.p + 1,\0A                                                            ext->val.len - 1));\0A    MBEDTLS_ASN1_CHK_ADD(len, mbedtls_asn1_write_len(p, start, ext->val.len - 1));\0A    MBEDTLS_ASN1_CHK_ADD(len, mbedtls_asn1_write_tag(p, start, MBEDTLS_ASN1_OCTET_STRING));\0A\0A    if (ext->val.p[0] != 0) {\0A        MBEDTLS_ASN1_CHK_ADD(len, mbedtls_asn1_write_bool(p, start, 1));\0A    }\0A\0A    MBEDTLS_ASN1_CHK_ADD(len, mbedtls_asn1_write_raw_buffer(p, start, ext->oid.p,\0A                                                            ext->oid.len));\0A    MBEDTLS_ASN1_CHK_ADD(len, mbedtls_asn1_write_len(p, start, ext->oid.len));\0A    MBEDTLS_ASN1_CHK_ADD(len, mbedtls_asn1_write_tag(p, start, MBEDTLS_ASN1_OID));\0A\0A    MBEDTLS_ASN1_CHK_ADD(len, mbedtls_asn1_write_len(p, start, len));\0A    MBEDTLS_ASN1_CHK_ADD(len, mbedtls_asn1_write_tag(p, start, MBEDTLS_ASN1_CONSTRUCTED |\0A                                                     MBEDTLS_ASN1_SEQUENCE));\0A\0A    return (int) len;\0A}\0A\0A/*\0A * Extension  ::=  SEQUENCE  {\0A *     extnID      OBJECT IDENTIFIER,\0A *     critical    BOOLEAN DEFAULT FALSE,\0A *     extnValue   OCTET STRING\0A *                 -- contains the DER encoding of an ASN.1 value\0A *                 -- corresponding to the extension type identified\0A *                 -- by extnID\0A *     }\0A */\0Aint mbedtls_x509_write_extensions(unsigned char **p, unsigned char *start,\0A                                  mbedtls_asn1_named_data *first)\0A{\0A    int ret = MBEDTLS_ERR_ERROR_CORRUPTION_DETECTED;\0A    size_t len = 0;\0A    mbedtls_asn1_named_data *cur_ext = first;\0A\0A    while (cur_ext != NULL) {\0A        MBEDTLS_ASN1_CHK_ADD(len, x509_write_extension(p, start, cur_ext));\0A        cur_ext = cur_ext->next;\0A    }\0A\0A    return (int) len;\0A}\0A\0A#endif /* MBEDTLS_X509_CREATE_C */\0A\00" }
