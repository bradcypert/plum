@.str40642 = private global { i64, i64, [1518 x i8] } { i64 -1, i64 1517, [1518 x i8] c"/**\0A * \5Cfile mbedtls/config_adjust_x509.h\0A * \5Cbrief Adjust X.509 configuration\0A *\0A * This is an internal header. Do not include it directly.\0A *\0A * Automatically enable certain dependencies. Generally, MBEDTLS_xxx\0A * configurations need to be explicitly enabled by the user: enabling\0A * MBEDTLS_xxx_A but not MBEDTLS_xxx_B when A requires B results in a\0A * compilation error. However, we do automatically enable certain options\0A * in some circumstances. One case is if MBEDTLS_xxx_B is an internal option\0A * used to identify parts of a module that are used by other module, and we\0A * don't want to make the symbol MBEDTLS_xxx_B part of the public API.\0A * Another case is if A didn't depend on B in earlier versions, and we\0A * want to use B in A but we need to preserve backward compatibility with\0A * configurations that explicitly activate MBEDTLS_xxx_A but not\0A * MBEDTLS_xxx_B.\0A */\0A/*\0A *  Copyright The Mbed TLS Contributors\0A *  SPDX-License-Identifier: Apache-2.0 OR GPL-2.0-or-later\0A */\0A\0A#ifndef MBEDTLS_CONFIG_ADJUST_X509_H\0A#define MBEDTLS_CONFIG_ADJUST_X509_H\0A\0A#if !defined(MBEDTLS_CONFIG_FILES_READ)\0A#error \22Do not include mbedtls/config_adjust_*.h manually! This can lead to problems, \22 \5C\0A    \22up to and including runtime errors such as buffer overflows. \22 \5C\0A    \22If you're trying to fix a complaint from check_config.h, just remove \22 \5C\0A    \22it from your configuration file: since Mbed TLS 3.0, it is included \22 \5C\0A    \22automatically at the right point.\22\0A#endif /* */\0A\0A#endif /* MBEDTLS_CONFIG_ADJUST_X509_H */\0A\00" }
