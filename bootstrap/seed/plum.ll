@.str45077 = private global { i64, i64, [5137 x i8] } { i64 -1, i64 5136, [5137 x i8] c"/**\0A * \5Cfile debug.h\0A *\0A * \5Cbrief Functions for controlling and providing debug output from the library.\0A */\0A/*\0A *  Copyright The Mbed TLS Contributors\0A *  SPDX-License-Identifier: Apache-2.0 OR GPL-2.0-or-later\0A */\0A#ifndef MBEDTLS_DEBUG_H\0A#define MBEDTLS_DEBUG_H\0A\0A#include \22mbedtls/build_info.h\22\0A\0A#include \22mbedtls/ssl.h\22\0A\0A#if defined(MBEDTLS_ECP_C)\0A#include \22mbedtls/ecp.h\22\0A#endif\0A\0A#if defined(MBEDTLS_DEBUG_C)\0A\0A#define MBEDTLS_DEBUG_STRIP_PARENS(...)   __VA_ARGS__\0A\0A#define MBEDTLS_SSL_DEBUG_MSG(level, args)                    \5C\0A    mbedtls_debug_print_msg(ssl, level, __FILE__, __LINE__,    \5C\0A                            MBEDTLS_DEBUG_STRIP_PARENS args)\0A\0A#define MBEDTLS_SSL_DEBUG_RET(level, text, ret)                \5C\0A    mbedtls_debug_print_ret(ssl, level, __FILE__, __LINE__, text, ret)\0A\0A#define MBEDTLS_SSL_DEBUG_BUF(level, text, buf, len)           \5C\0A    mbedtls_debug_print_buf(ssl, level, __FILE__, __LINE__, text, buf, len)\0A\0A#if defined(MBEDTLS_BIGNUM_C)\0A#define MBEDTLS_SSL_DEBUG_MPI(level, text, X)                  \5C\0A    mbedtls_debug_print_mpi(ssl, level, __FILE__, __LINE__, text, X)\0A#endif\0A\0A#if defined(MBEDTLS_ECP_C)\0A#define MBEDTLS_SSL_DEBUG_ECP(level, text, X)                  \5C\0A    mbedtls_debug_print_ecp(ssl, level, __FILE__, __LINE__, text, X)\0A#endif\0A\0A#if defined(MBEDTLS_X509_CRT_PARSE_C)\0A#if !defined(MBEDTLS_X509_REMOVE_INFO)\0A#define MBEDTLS_SSL_DEBUG_CRT(level, text, crt)                \5C\0A    mbedtls_debug_print_crt(ssl, level, __FILE__, __LINE__, text, crt)\0A#else\0A#define MBEDTLS_SSL_DEBUG_CRT(level, text, crt)       do { } while (0)\0A#endif /* MBEDTLS_X509_REMOVE_INFO */\0A#endif /* MBEDTLS_X509_CRT_PARSE_C */\0A\0A#if defined(MBEDTLS_ECDH_C)\0A#define MBEDTLS_SSL_DEBUG_ECDH(level, ecdh, attr)               \5C\0A    mbedtls_debug_printf_ecdh(ssl, level, __FILE__, __LINE__, ecdh, attr)\0A#endif\0A\0A#else /* MBEDTLS_DEBUG_C */\0A\0A#define MBEDTLS_SSL_DEBUG_MSG(level, args)            do { } while (0)\0A#define MBEDTLS_SSL_DEBUG_RET(level, text, ret)       do { } while (0)\0A#define MBEDTLS_SSL_DEBUG_BUF(level, text, buf, len)  do { } while (0)\0A#define MBEDTLS_SSL_DEBUG_MPI(level, text, X)         do { } while (0)\0A#define MBEDTLS_SSL_DEBUG_ECP(level, text, X)         do { } while (0)\0A#define MBEDTLS_SSL_DEBUG_CRT(level, text, crt)       do { } while (0)\0A#define MBEDTLS_SSL_DEBUG_ECDH(level, ecdh, attr)     do { } while (0)\0A\0A#endif /* MBEDTLS_DEBUG_C */\0A\0A/**\0A * \5Cdef MBEDTLS_PRINTF_ATTRIBUTE\0A *\0A * Mark a function as having printf attributes, and thus enable checking\0A * via -wFormat and other flags. This does nothing on builds with compilers\0A * that do not support the format attribute\0A *\0A * Module:  library/debug.c\0A * Caller:\0A *\0A * This module provides debugging functions.\0A */\0A#if defined(__has_attribute)\0A#if __has_attribute(format)\0A#if defined(__MINGW32__) && __USE_MINGW_ANSI_STDIO == 1\0A#define MBEDTLS_PRINTF_ATTRIBUTE(string_index, first_to_check)    \5C\0A    __attribute__((__format__(gnu_printf, string_index, first_to_check)))\0A#else /* defined(__MINGW32__) && __USE_MINGW_ANSI_STDIO == 1 */\0A#define MBEDTLS_PRINTF_ATTRIBUTE(string_index, first_to_check)    \5C\0A    __attribute__((format(printf, string_index, first_to_check)))\0A#endif\0A#else /* __has_attribute(format) */\0A#define MBEDTLS_PRINTF_ATTRIBUTE(string_index, first_to_check)\0A#endif /* __has_attribute(format) */\0A#else /* defined(__has_attribute) */\0A#define MBEDTLS_PRINTF_ATTRIBUTE(string_index, first_to_check)\0A#endif\0A\0A/**\0A * \5Cdef MBEDTLS_PRINTF_SIZET\0A *\0A * MBEDTLS_PRINTF_xxx: Due to issues with older window compilers\0A * and MinGW we need to define the printf specifier for size_t\0A * and long long per platform.\0A *\0A * Module:  library/debug.c\0A * Caller:\0A *\0A * This module provides debugging functions.\0A */\0A#if defined(__MINGW32__) || (defined(_MSC_VER) && _MSC_VER < 1900)\0A   #include <inttypes.h>\0A   #define MBEDTLS_PRINTF_SIZET     PRIuPTR\0A   #define MBEDTLS_PRINTF_LONGLONG  \22I64d\22\0A#else \5C\0A    /* defined(__MINGW32__) || (defined(_MSC_VER) && _MSC_VER < 1900) */\0A   #define MBEDTLS_PRINTF_SIZET     \22zu\22\0A   #define MBEDTLS_PRINTF_LONGLONG  \22lld\22\0A#endif \5C\0A    /* defined(__MINGW32__) || (defined(_MSC_VER) && _MSC_VER < 1900) */\0A\0A#if !defined(MBEDTLS_PRINTF_MS_TIME)\0A#include <inttypes.h>\0A#if !defined(PRId64)\0A#define MBEDTLS_PRINTF_MS_TIME MBEDTLS_PRINTF_LONGLONG\0A#else\0A#define MBEDTLS_PRINTF_MS_TIME PRId64\0A#endif\0A#endif /* MBEDTLS_PRINTF_MS_TIME */\0A\0A#ifdef __cplusplus\0Aextern \22C\22 {\0A#endif\0A\0A/**\0A * \5Cbrief   Set the threshold error level to handle globally all debug output.\0A *          Debug messages that have a level over the threshold value are\0A *          discarded.\0A *          (Default value: 0 = No debug )\0A *\0A * \5Cparam threshold     threshold level of messages to filter on. Messages at a\0A *                      higher level will be discarded.\0A *                          - Debug levels\0A *                              - 0 No debug\0A *                              - 1 Error\0A *                              - 2 State change\0A *                              - 3 Informational\0A *                              - 4 Verbose\0A */\0Avoid mbedtls_debug_set_threshold(int threshold);\0A\0A#ifdef __cplusplus\0A}\0A#endif\0A\0A#endif /* MBEDTLS_DEBUG_H */\0A\00" }
