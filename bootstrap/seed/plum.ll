                   int ep_before_zwj, int ri_count) {\0A    if (prev == PLUM_GCB_CR && next == PLUM_GCB_LF) return 0;\0A    if (prev == PLUM_GCB_CR || prev == PLUM_GCB_LF || prev == PLUM_GCB_CONTROL ||\0A        next == PLUM_GCB_CR || next == PLUM_GCB_LF || next == PLUM_GCB_CONTROL) return 1;\0A    if (prev == PLUM_GCB_L && (next == PLUM_GCB_L || next == PLUM_GCB_V || next == PLUM_GCB_LV || next == PLUM_GCB_LVT)) return 0;\0A    if ((prev == PLUM_GCB_LV || prev == PLUM_GCB_V) && (next == PLUM_GCB_V || next == PLUM_GCB_T)) return 0;\0A    if ((prev == PLUM_GCB_LVT || prev == PLUM_GCB_T) && next == PLUM_GCB_T) return 0;\0A    if (next == PLUM_GCB_EXTEND || next == PLUM_GCB_ZWJ || next == PLUM_GCB_SPACING) return 0;\0A    if (prev == PLUM_GCB_PREPEND) return 0;\0A    if (ep_before_zwj && next == PLUM_GCB_EP) return 0;\0A    if (prev == PLUM_GCB_RI && next == PLUM_GCB_RI && (ri_count % 2) == 1) return 0;\0A    return 1;\0A}\0A\0A// Skips one ECMA-48 escape sequence. Escape bytes do not occupy cells.\0Astatic size_t plum_term_skip_escape(const unsigned char *s, size_t n, size_t i) {\0A    if (i + 1 >= n || s[i] != 0x1b) return i;\0A    if (s[i + 1] == '[') {\0A        i += 2;\0A        while (i < n && (s[i] < 0x40 || s[i] > 0x7e)) i++;\0A        return i < n ? i + 1 : n;\0A    }\0A    if (s[i + 1] == ']') {\0A        i += 2;\0A        while (i < n && s[i] != 0x07 && !(s[i] == 0x1b && i + 1 < n && s[i + 1] == '\5C\5C')) i++;\0A        return i < n && s[i] == 0x1b ? i + 2 : (i < n ? i + 1 : n);\0A    }\0A    return i + 2;\0A}\0A\0A// Returns the display-cell width of UTF-8 text. It applies the UAX #29 rules\0A// that matter to terminal text -- combining marks, Hangul, emoji ZWJ\0A// sequences, and flags -- and gives each cluster its widest visible scalar.\0A// Thus an emoji ZWJ sequence and a flag remain two cells rather than being\0A// counted component by component.\0Along long term_display_width(const char *text) {\0A    const unsigned char *s = (const unsigned char *)text;\0A    if (!s) return 0;\0A    size_t n = strlen(text), i = 0, used;\0A    long long total = 0;\0A    int have = 0, cluster = 0, ri_count = 0, ep_seen = 0, ep_before_zwj = 0;\0A    enum plum_term_gcb prev = PLUM_GCB_OTHER;\0A    while (i < n) {\0A        if (s[i] == 0x1b) { i = plum_term_skip_escape(s, n, i); continue; }\0A        uint32_t cp = plum_term_utf8(s + i, &used);\0A        enum plum_term_gcb kind = plum_term_gcb(cp);\0A        int is_break = have && plum_term_breaks(prev, kind, ep_before_zwj, ri_count);\0A        if (is_break) { total += cluster; cluster = 0; ri_count = 0; ep_seen = 0; ep_before_zwj = 0; }\0A        int width = plum_term_char_width(cp, kind);\0A        if (width > cluster) cluster = width;\0A        if (cp == 0xfe0f && cluster < 2) cluster = 2;\0A        if (kind == PLUM_GCB_RI) ri_count++; else if (kind != PLUM_GCB_EXTEND) ri_count = 0;\0A        if (kind == PLUM_GCB_EP) { ep_seen = 1; ep_before_zwj = 0; }\0A        else if (kind == PLUM_GCB_EXTEND && ep_seen) { }\0A        else if (kind == PLUM_GCB_ZWJ) { ep_before_zwj = ep_seen; ep_seen = 0; }\0A        else { ep_seen = 0; ep_before_zwj = 0; }\0A        prev = kind; have = 1; i += used;\0A    }\0A    return total + (have ? cluster : 0);\0A}\0A\0A// Byte offset after the longest whole grapheme cluster that fits in `cells`.\0A// A Plum String may slice at this offset safely: it is always a UTF-8 and\0A// grapheme boundary. ANSI escapes are carried through but never consume a\0A// cell; an escape immediately before an omitted cluster is omitted too.\0Along long term_truncate_bytes(const char *text, long long cells) {\0A    const unsigned char *s = (const unsigned char *)text;\0A    if (!s || cells <= 0) return 0;\0A    size_t n = strlen(text), i = 0, used, accepted = 0;\0A    long long total = 0;\0A    int have = 0, cluster = 0, ri_count = 0, ep_seen = 0, ep_before_zwj = 0;\0A    enum plum_term_gcb prev = PLUM_GCB_OTHER;\0A    while (i < n) {\0A        if (s[i] == 0x1b) { i = plum_term_skip_escape(s, n, i); continue; }\0A        uint32_t cp = plum_term_utf8(s + i, &used);\0A        enum plum_term_gcb kind = plum_term_gcb(cp);\0A        int is_break = have && plum_term_breaks(prev, kind, ep_before_zwj, ri_count);\0A        if (is_break) {\0A            if (total + cluster > cells) return (long long)accepted;\0A            total += cluster; accepted = i;\0A            cluster = 0; ri_count = 0; ep_seen = 0; ep_before_zwj = 0;\0A        }\0A        int width = plum_term_char_width(cp, kind);\0A        if (width > cluster) cluster = width;\0A        if (cp == 0xfe0f && cluster < 2) cluster = 2;\0A        if (kind == PLUM_GCB_RI) ri_count++; else if (kind != PLUM_GCB_EXTEND) ri_count = 0;\0A        if (kind == PLUM_GCB_EP) { ep_seen = 1; ep_before_zwj = 0; }\0A        else if (kind == PLUM_GCB_EXTEND && ep_seen) { }\0A        else if (kind == PLUM_GCB_ZWJ) { ep_before_zwj = ep_seen; ep_seen = 0; }\0A        else { ep_seen = 0; ep_before_zwj = 0; }\0A        prev = kind; have = 1; i += used;\0A    }\0A    return total + cluster <= cells ? (long long)n : (long long)accepted;\0A}\0A\0A// 0 stdin, 1 stdout, 2 stderr -- the numbers Plum's `Stream` enum maps\0A// to. Anything else is not a terminal, which is the safe answer.\0Along long term_is_tty(long long which) {\0A    if (which < 0 || which > 2) return 0;\0A#if defined(_WIN32)\0A    return _isatty((int)which) ? 1 : 0;\0A#else\0A    return isatty((int)which) ? 1 : 0;\0A#endif\0A}\0A\0A// Asks the terminal how big it is, storing the answer for the two\0A// readers below. Returns 0 on success and -1 when there is no terminal\0A// to ask -- output redirected to a file, for instance, which is not an\0A// error the caller did anything wrong to cause.\0A//\0A// Measured on STDOUT, not stdin: the size that matters is the one of\0A// the thing being drawn to. A program whose stdin is a pipe and whose\0A// stdout is a terminal still has a size worth knowing.\0Along long term_size_query(void) {\0A#if defined(_WIN32)\0A    CONSOLE_SCREEN_BUFFER_INFO info;\0A    HANDLE h = GetStdHandle(STD_OUTPUT_HANDLE);\0A    if (h == INVALID_HANDLE_VALUE || h == NULL) return -1;\0A    if (!GetConsoleScreenBufferInfo(h, &info)) return -1;\0A    // The WINDOW, not the buffer. A Windows console's buffer is\0A    // routinely taller than the window -- that is what the scrollback\0A    // is -- so `dwSize` would report a height nobody can see.\0A    plum_term_cols = (long long)(info.srWindow.Right - info.srWindow.Left + 1);\0A    plum_term_rows = (long long)(info.srWindow.Bottom - info.srWindow.Top + 1);\0A#else\0A    struct winsize ws;\0A    if (ioctl(STDOUT_FILENO, TIOCGWINSZ, &ws) != 0) return -1;\0A    plum_term_cols = (long long)ws.ws_col;\0A    plum_term_rows = (long long)ws.ws_row;\0A#endif\0A    // A terminal reporting zero is a terminal that does not know, and a\0A    // caller dividing by it would be worse off than one told no.\0A    if (plum_term_cols <= 0 || plum_term_rows <= 0) return -1;\0A    return 0;\0A}\0A\0Along long term_size_cols(void) { return plum_term_cols; }\0Along long term_size_rows(void) { return plum_term_rows; }\0A\0A// Writes to stdout with NO trailing newline and NO flush.\0A//\0A// Both omissions are the point. A terminal program positions its own\0A// output with escape sequences, so an automatic newline would corrupt\0A// every frame it draws; and flushing per write turns one redraw into\0A// hundreds of syscalls. `term_flush` is separate so a caller can build\0A// a frame and publish it in one go.\0A//\0A// Returns -1 if the write failed -- a closed pipe, most likely, which a\0A// long-running program should notice rather than draw into forever.\0Along long term_write(const char *s) {\0A    if (s == NULL) return 0;\0A    if (fputs(s, stdout) == EOF) return -1;\0A    return 0;\0A}\0A\0Along long term_flush(void) { return fflush(stdout) == 0 ? 0 : -1; }\0A\0A// --- Raw mode, the alternate screen, and the cursor ---\0A//\0A// Each of these is entered by a call that SAVES what it is about to\0A// change, and left by one that puts it back. On the Plum side each is a\0A// `handle`, so leaving happens when the value dies -- including on a\0A// panic, which is what issue #1 added and what a terminal program needs\0A// more than most: a crash that leaves a terminal in raw mode with no\0A// cursor is a crash that also takes the user's shell with it.\0A//\0A// --- Why entering is COUNTED rather than refused ---\0A//\0A// Entering twice must not save the already-changed state as the thing\0A// to restore, or leaving puts the terminal back to raw. The first entry\0A// saves and applies; later ones only count; the last leave restores.\0A// Counting rather than refusing means a library and its caller can both\0A// ask without knowing about each other, and it is order-independent,\0A// which matters because handles in different scopes need not die in the\0A// order they were born.\0A\0Astatic int plum_raw_depth = 0;\0Astatic int plum_alt_depth = 0;\0Astatic int plum_cursor_depth = 0;\0A\0A#if !defined(_WIN32)\0Astatic struct termios plum_saved_termios;\0A#else\0Astatic DWORD plum_saved_in_mode = 0;\0Astatic DWORD plum_saved_out_mode = 0;\0A#endif\0A\0A// Returns 0 on success, -1 if there is no terminal to change.\0A//\0A// **`ISIG` is cleared, so Ctrl+C arrives as a BYTE (0x03) rather than a\0A// signal.** That is what raw mode means, and here it is also what makes\0A// cleanup work: the default action for SIGINT terminates the process\0A// WITHOUT running `atexit` handlers, so a Ctrl+C in raw mode with\0A// signals still enabled would leave the terminal raw and the cursor\0A// hidden. Delivered as a byte, the program can exit through `exit()`,\0A// which restores everything on the way out. A raw-mode program is\0A// responsible for noticing 0x03 and quitting.\0A//\0A// `VMIN=1, VTIME=0`: a read blocks until at least one byte. The timeout\0A// belongs to `poll`, which is what `Os.read_stdin_timeout` already\0A// uses; asking termios for a timeout as well would give two mechanisms\0A// racing over one deadline.\0Along long term_enter_raw(void) {\0A#if defined(_WIN32)\0A    HANDLE h = GetStdHandle(STD_INPUT_HANDLE);\0A    if (h == INVALID_HANDLE_VALUE || h == NULL) return -1;\0A    if (plum_raw_depth == 0) {\0A        if (!GetConsoleMode(h, &plum_saved_in_mode)) return -1;\0A        DWORD mode = plum_saved_in_mode;\0A        mode &= ~(ENABLE_LINE_INPUT | ENABLE_ECHO_INPUT | ENABLE_PROCESSED_INPUT);\0A        // The reason one decoder can serve every platform: with this\0A        // set, the console delivers the same VT escape sequences a\0A        // POSIX terminal does, instead of INPUT_RECORD structures.\0A        mode |= ENABLE_VIRTUAL_TERMINAL_INPUT;\0A        if (!SetConsoleMode(h, mode)) return -1;\0A    }\0A    plum_raw_depth++;\0A    return 0;\0A#else\0A    if (!isatty(STDIN_FILENO)) return -1;\0A    if (plum_raw_depth == 0) {\0A        if (tcgetattr(STDIN_FILENO, &plum_saved_termios) != 0) return -1;\0A        struct termios raw = plum_saved_termios;\0A        raw.c_iflag &= (tcflag_t)~(IXON | ICRNL | BRKINT | INPCK | ISTRIP);\0A        raw.c_oflag &= (tcflag_t)~(OPOST);\0A        raw.c_lflag &= (tcflag_t)~(ECHO | ICANON | IEXTEN | ISIG);\0A        raw.c_cflag |= (tcflag_t)CS8;\0A        raw.c_cc[VMIN] = 1;\0A        raw.c_cc[VTIME] = 0;\0A        if (tcsetattr(STDIN_FILENO, TCSAFLUSH, &raw) != 0) return -1;\0A    }\0A    plum_raw_depth++;\0A    return 0;\0A#endif\0A}\0A\0A// Takes no argument it uses: a `handle`'s cleanup is called with the\0A// number the cell holds, and these have no per-instance state -- the\0A// depth counter is what decides whether this one is the last.\0Avoid term_leave_raw(long long ignored) {\0A    (void)ignored;\0A    if (plum_raw_depth <= 0) return;\0A    plum_raw_depth--;\0A    if (plum_raw_depth > 0) return;\0A#if defined(_WIN32)\0A    HANDLE h = GetStdHandle(STD_INPUT_HANDLE);\0A    if (h != INVALID_HANDLE_VALUE && h != NULL) SetConsoleMode(h, plum_saved_in_mode);\0A#else\0A    tcsetattr(STDIN_FILENO, TCSAFLUSH, &plum_saved_termios);\0A#endif\0A}\0A\0A// Windows needs telling that escape sequences written to stdout are\0A// escape sequences. POSIX terminals need no equivalent.\0A#if defined(_WIN32)\0Astatic int plum_enable_vt_output(void) {\0A    HANDLE h = GetStdHandle(STD_OUTPUT_HANDLE);\0A    if (h == INVALID_HANDLE_VALUE || h == NULL) return -1;\0A    if (!GetConsoleMode(h, &plum_saved_out_mode)) return -1;\0A    return SetConsoleMode(h, plum_saved_out_mode | ENABLE_VIRTUAL_TERMINAL_PROCESSING) ? 0 : -1;\0A}\0A#endif\0A\0A// `\5C033[?1049h` and `?1049l`: the xterm alternate screen. Entering\0A// leaves the user's scrollback untouched and leaving puts their shell\0A// back exactly as it was, which is why a full-screen program should use\0A// it rather than clearing.\0A//\0A// Flushed immediately, unlike `term_write`. A mode change that has not\0A// reached the terminal yet is a mode change that has not happened, and\0A// everything drawn after it would land on the wrong screen.\0Along long term_enter_alt(void) {\0A    // Refused when stdout is not a terminal. Escape sequences written\0A    // into a file or a pipe are not invisible -- they are corruption,\0A    // and the caller gets an `Err` they can act on instead.\0A    if (!term_is_tty(1)) return -1;\0A    if (plum_alt_depth == 0) {\0A#if defined(_WIN32)\0A        if (plum_enable_vt_output() != 0) return -1;\0A#endif\0A        if (fputs(\22\5C033[?1049h\22, stdout) == EOF) return -1;\0A        if (fflush(stdout) != 0) return -1;\0A    }\0A    plum_alt_depth++;\0A    return 0;\0A}\0A\0Avoid term_leave_alt(long long ignored) {\0A    (void)ignored;\0A    if (plum_alt_depth <= 0) return;\0A    plum_alt_depth--;\0A    if (plum_alt_depth > 0) return;\0A    fputs(\22\5C033[?1049l\22, stdout);\0A    fflush(stdout);\0A}\0A\0Along long term_hide_cursor(void) {\0A    if (!term_is_tty(1)) return -1;\0A    if (plum_cursor_depth == 0) {\0A#if defined(_WIN32)\0A        if (plum_enable_vt_output() != 0) return -1;\0A#endif\0A        if (fputs(\22\5C033[?25l\22, stdout) == EOF) return -1;\0A        if (fflush(stdout) != 0) return -1;\0A    }\0A    plum_cursor_depth++;\0A    return 0;\0A}\0A\0Avoid term_show_cursor(long long ignored) {\0A    (void)ignored;\0A    if (plum_cursor_depth <= 0) return;\0A    plum_cursor_depth--;\0A    if (plum_cursor_depth > 0) return;\0A    fputs(\22\5C033[?25h\22, stdout);\0A    fflush(stdout);\0A}\0A\00" }
