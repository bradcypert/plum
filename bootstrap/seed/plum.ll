ix to emit prior to the MPI data.\0A *                 For example, this might be a label, or \220x\22 when\0A *                 printing in base \5Cc 16. This may be \5Cc NULL if no prefix\0A *                 is needed.\0A * \5Cparam X        The source MPI. This must point to an initialized MPI.\0A * \5Cparam radix    The numeric base to be used in the emitted string.\0A * \5Cparam fout     The output file handle. This may be \5Cc NULL, in which case\0A *                 the output is written to \5Cc stdout.\0A *\0A * \5Creturn         \5Cc 0 if successful.\0A * \5Creturn         A negative error code on failure.\0A */\0Aint mbedtls_mpi_write_file(const char *p, const mbedtls_mpi *X,\0A                           int radix, FILE *fout);\0A#endif /* MBEDTLS_FS_IO */\0A\0A/**\0A * \5Cbrief          Import an MPI from unsigned big endian binary data.\0A *\0A * \5Cparam X        The destination MPI. This must point to an initialized MPI.\0A * \5Cparam buf      The input buffer. This must be a readable buffer of length\0A *                 \5Cp buflen Bytes.\0A * \5Cparam buflen   The length of the input buffer \5Cp buf in Bytes.\0A *\0A * \5Creturn         \5Cc 0 if successful.\0A * \5Creturn         #MBEDTLS_ERR_MPI_ALLOC_FAILED if memory allocation failed.\0A * \5Creturn         Another negative error code on different kinds of failure.\0A */\0Aint mbedtls_mpi_read_binary(mbedtls_mpi *X, const unsigned char *buf,\0A                            size_t buflen);\0A\0A/**\0A * \5Cbrief          Import X from unsigned binary data, little endian\0A *\0A * \5Cparam X        The destination MPI. This must point to an initialized MPI.\0A * \5Cparam buf      The input buffer. This must be a readable buffer of length\0A *                 \5Cp buflen Bytes.\0A * \5Cparam buflen   The length of the input buffer \5Cp buf in Bytes.\0A *\0A * \5Creturn         \5Cc 0 if successful.\0A * \5Creturn         #MBEDTLS_ERR_MPI_ALLOC_FAILED if memory allocation failed.\0A * \5Creturn         Another negative error code on different kinds of failure.\0A */\0Aint mbedtls_mpi_read_binary_le(mbedtls_mpi *X,\0A                               const unsigned char *buf, size_t buflen);\0A\0A/**\0A * \5Cbrief          Export X into unsigned binary data, big endian.\0A *                 Always fills the whole buffer, which will start with zeros\0A *                 if the number is smaller.\0A *\0A * \5Cparam X        The source MPI. This must point to an initialized MPI.\0A * \5Cparam buf      The output buffer. This must be a writable buffer of length\0A *                 \5Cp buflen Bytes.\0A * \5Cparam buflen   The size of the output buffer \5Cp buf in Bytes.\0A *\0A * \5Creturn         \5Cc 0 if successful.\0A * \5Creturn         #MBEDTLS_ERR_MPI_BUFFER_TOO_SMALL if \5Cp buf isn't\0A *                 large enough to hold the value of \5Cp X.\0A * \5Creturn         Another negative error code on different kinds of failure.\0A */\0Aint mbedtls_mpi_write_binary(const mbedtls_mpi *X, unsigned char *buf,\0A                             size_t buflen);\0A\0A/**\0A * \5Cbrief          Export X into unsigned binary data, little endian.\0A *                 Always fills the whole buffer, which will end with zeros\0A *                 if the number is smaller.\0A *\0A * \5Cparam X        The source MPI. This must point to an initialized MPI.\0A * \5Cparam buf      The output buffer. This must be a writable buffer of length\0A *                 \5Cp buflen Bytes.\0A * \5Cparam buflen   The size of the output buffer \5Cp buf in Bytes.\0A *\0A * \5Creturn         \5Cc 0 if successful.\0A * \5Creturn         #MBEDTLS_ERR_MPI_BUFFER_TOO_SMALL if \5Cp buf isn't\0A *                 large enough to hold the value of \5Cp X.\0A * \5Creturn         Another negative error code on different kinds of failure.\0A */\0Aint mbedtls_mpi_write_binary_le(const mbedtls_mpi *X,\0A                                unsigned char *buf, size_t buflen);\0A\0A/**\0A * \5Cbrief          Perform a left-shift on an MPI: X <<= count\0A *\0A * \5Cparam X        The MPI to shift. This must point to an initialized MPI.\0A *                 The MPI pointed by \5Cp X may be resized to fit\0A *                 the resulting number.\0A * \5Cparam count    The number of bits to shift by.\0A *\0A * \5Creturn         \5Cc 0 if successful.\0A * \5Creturn         #MBEDTLS_ERR_MPI_ALLOC_FAILED if a memory allocation failed.\0A * \5Creturn         Another negative error code on different kinds of failure.\0A */\0Aint mbedtls_mpi_shift_l(mbedtls_mpi *X, size_t count);\0A\0A/**\0A * \5Cbrief          Perform a right-shift on an MPI: X >>= count\0A *\0A * \5Cparam X        The MPI to shift. This must point to an initialized MPI.\0A * \5Cparam count    The number of bits to shift by.\0A *\0A * \5Creturn         \5Cc 0 if successful.\0A * \5Creturn         #MBEDTLS_ERR_MPI_ALLOC_FAILED if a memory allocation failed.\0A * \5Creturn         Another negative error code on different kinds of failure.\0A */\0Aint mbedtls_mpi_shift_r(mbedtls_mpi *X, size_t count);\0A\0A/**\0A * \5Cbrief          Compare the absolute values of two MPIs.\0A *\0A * \5Cparam X        The left-hand MPI. This must point to an initialized MPI.\0A * \5Cparam Y        The right-hand MPI. This must point to an initialized MPI.\0A *\0A * \5Creturn         \5Cc 1 if `|X|` is greater than `|Y|`.\0A * \5Creturn         \5Cc -1 if `|X|` is lesser than `|Y|`.\0A * \5Creturn         \5Cc 0 if `|X|` is equal to `|Y|`.\0A */\0Aint mbedtls_mpi_cmp_abs(const mbedtls_mpi *X, const mbedtls_mpi *Y);\0A\0A/**\0A * \5Cbrief          Compare two MPIs.\0A *\0A * \5Cparam X        The left-hand MPI. This must point to an initialized MPI.\0A * \5Cparam Y        The right-hand MPI. This must point to an initialized MPI.\0A *\0A * \5Creturn         \5Cc 1 if \5Cp X is greater than \5Cp Y.\0A * \5Creturn         \5Cc -1 if \5Cp X is lesser than \5Cp Y.\0A * \5Creturn         \5Cc 0 if \5Cp X is equal to \5Cp Y.\0A */\0Aint mbedtls_mpi_cmp_mpi(const mbedtls_mpi *X, const mbedtls_mpi *Y);\0A\0A/**\0A * \5Cbrief          Check if an MPI is less than the other in constant time.\0A *\0A * \5Cparam X        The left-hand MPI. This must point to an initialized MPI\0A *                 with the same allocated length as Y.\0A * \5Cparam Y        The right-hand MPI. This must point to an initialized MPI\0A *                 with the same allocated length as X.\0A * \5Cparam ret      The result of the comparison:\0A *                 \5Cc 1 if \5Cp X is less than \5Cp Y.\0A *                 \5Cc 0 if \5Cp X is greater than or equal to \5Cp Y.\0A *\0A * \5Creturn         0 on success.\0A * \5Creturn         MBEDTLS_ERR_MPI_BAD_INPUT_DATA if the allocated length of\0A *                 the two input MPIs is not the same.\0A */\0Aint mbedtls_mpi_lt_mpi_ct(const mbedtls_mpi *X, const mbedtls_mpi *Y,\0A                          unsigned *ret);\0A\0A/**\0A * \5Cbrief          Compare an MPI with an integer.\0A *\0A * \5Cparam X        The left-hand MPI. This must point to an initialized MPI.\0A * \5Cparam z        The integer value to compare \5Cp X to.\0A *\0A * \5Creturn         \5Cc 1 if \5Cp X is greater than \5Cp z.\0A * \5Creturn         \5Cc -1 if \5Cp X is lesser than \5Cp z.\0A * \5Creturn         \5Cc 0 if \5Cp X is equal to \5Cp z.\0A */\0Aint mbedtls_mpi_cmp_int(const mbedtls_mpi *X, mbedtls_mpi_sint z);\0A\0A/**\0A * \5Cbrief          Perform an unsigned addition of MPIs: X = |A| + |B|\0A *\0A * \5Cparam X        The destination MPI. This must point to an initialized MPI.\0A * \5Cparam A        The first summand. This must point to an initialized MPI.\0A * \5Cparam B        The second summand. This must point to an initialized MPI.\0A *\0A * \5Creturn         \5Cc 0 if successful.\0A * \5Creturn         #MBEDTLS_ERR_MPI_ALLOC_FAILED if a memory allocation failed.\0A * \5Creturn         Another negative error code on different kinds of failure.\0A */\0Aint mbedtls_mpi_add_abs(mbedtls_mpi *X, const mbedtls_mpi *A,\0A                        const mbedtls_mpi *B);\0A\0A/**\0A * \5Cbrief          Perform an unsigned subtraction of MPIs: X = |A| - |B|\0A *\0A * \5Cparam X        The destination MPI. This must point to an initialized MPI.\0A * \5Cparam A        The minuend. This must point to an initialized MPI.\0A * \5Cparam B        The subtrahend. This must point to an initialized MPI.\0A *\0A * \5Creturn         \5Cc 0 if successful.\0A * \5Creturn         #MBEDTLS_ERR_MPI_NEGATIVE_VALUE if \5Cp B is greater than \5Cp A.\0A * \5Creturn         Another negative error code on different kinds of failure.\0A *\0A */\0Aint mbedtls_mpi_sub_abs(mbedtls_mpi *X, const mbedtls_mpi *A,\0A                        const mbedtls_mpi *B);\0A\0A/**\0A * \5Cbrief          Perform a signed addition of MPIs: X = A + B\0A *\0A * \5Cparam X        The destination MPI. This must point to an initialized MPI.\0A * \5Cparam A        The first summand. This must point to an initialized MPI.\0A * \5Cparam B        The second summand. This must point to an initialized MPI.\0A *\0A * \5Creturn         \5Cc 0 if successful.\0A * \5Creturn         #MBEDTLS_ERR_MPI_ALLOC_FAILED if a memory allocation failed.\0A * \5Creturn         Another negative error code on different kinds of failure.\0A */\0Aint mbedtls_mpi_add_mpi(mbedtls_mpi *X, const mbedtls_mpi *A,\0A                        const mbedtls_mpi *B);\0A\0A/**\0A * \5Cbrief          Perform a signed subtraction of MPIs: X = A - B\0A *\0A * \5Cparam X        The destination MPI. This must point to an initialized MPI.\0A * \5Cparam A        The minuend. This must point to an initialized MPI.\0A * \5Cparam B        The subtrahend. This must point to an initialized MPI.\0A *\0A * \5Creturn         \5Cc 0 if successful.\0A * \5Creturn         #MBEDTLS_ERR_MPI_ALLOC_FAILED if a memory allocation failed.\0A * \5Creturn         Another negative error code on different kinds of failure.\0A */\0Aint mbedtls_mpi_sub_mpi(mbedtls_mpi *X, const mbedtls_mpi *A,\0A                        const mbedtls_mpi *B);\0A\0A/**\0A * \5Cbrief          Perform a signed addition of an MPI and an integer: X = A + b\0A *\0A * \5Cparam X        The destination MPI. This must point to an initialized MPI.\0A * \5Cparam A        The first summand. This must point to an initialized MPI.\0A * \5Cparam b        The second summand.\0A *\0A * \5Creturn         \5Cc 0 if successful.\0A * \5Creturn         #MBEDTLS_ERR_MPI_ALLOC_FAILED if a memory allocation failed.\0A * \5Creturn         Another negative error code on different kinds of failure.\0A */\0Aint mbedtls_mpi_add_int(mbedtls_mpi *X, const mbedtls_mpi *A,\0A                        mbedtls_mpi_sint b);\0A\0A/**\0A * \5Cbrief          Perform a signed subtraction of an MPI and an integer:\0A *                 X = A - b\0A *\0A * \5Cparam X        The destination MPI. This must point to an initialized MPI.\0A * \5Cparam A        The minuend. This must point to an initialized MPI.\0A * \5Cparam b        The subtrahend.\0A *\0A * \5Creturn         \5Cc 0 if successful.\0A * \5Creturn         #MBEDTLS_ERR_MPI_ALLOC_FAILED if a memory allocation failed.\0A * \5Creturn         Another negative error code on different kinds of failure.\0A */\0Aint mbedtls_mpi_sub_int(mbedtls_mpi *X, const mbedtls_mpi *A,\0A                        mbedtls_mpi_sint b);\0A\0A/**\0A * \5Cbrief          Perform a multiplication of two MPIs: X = A * B\0A *\0A * \5Cparam X        The destination MPI. This must point to an initialized MPI.\0A * \5Cparam A        The first factor. This must point to an initialized MPI.\0A * \5Cparam B        The second factor. This must point to an initialized MPI.\0A *\0A * \5Creturn         \5Cc 0 if successful.\0A * \5Creturn         #MBEDTLS_ERR_MPI_ALLOC_FAILED if a memory allocation failed.\0A * \5Creturn         Another negative error code on different kinds of failure.\0A *\0A */\0Aint mbedtls_mpi_mul_mpi(mbedtls_mpi *X, const mbedtls_mpi *A,\0A                        const mbedtls_mpi *B);\0A\0A/**\0A * \5Cbrief          Perform a multiplication of an MPI with an unsigned integer:\0A *                 X = A * b\0A *\0A * \5Cparam X        The destination MPI. This must point to an initialized MPI.\0A * \5Cparam A        The first factor. This must point to an initialized MPI.\0A * \5Cparam b        The second factor.\0A *\0A * \5Creturn         \5Cc 0 if successful.\0A * \5Creturn         #MBEDTLS_ERR_MPI_ALLOC_FAILED if a memory allocation failed.\0A * \5Creturn         Another negative error code on different kinds of failure.\0A *\0A */\0Aint mbedtls_mpi_mul_int(mbedtls_mpi *X, const mbedtls_mpi *A,\0A                        mbedtls_mpi_uint b);\0A\0A/**\0A * \5Cbrief          Perform a division with remainder of two MPIs:\0A *                 A = Q * B + R\0A *\0A * \5Cparam Q        The destination MPI for the quotient.\0A *                 This may be \5Cc NULL if the value of the\0A *                 quotient is not needed. This must not alias A or B.\0A * \5Cparam R        The destination MPI for the remainder value.\0A *                 This may be \5Cc NULL if the value of the\0A *                 remainder is not needed. This must not alias A or B.\0A * \5Cparam A        The dividend. This must point to an initialized MPI.\0A * \5Cparam B        The divisor. This must point to an initialized MPI.\0A *\0A * \5Creturn         \5Cc 0 if successful.\0A * \5Creturn         #MBEDTLS_ERR_MPI_ALLOC_FAILED if memory allocation failed.\0A * \5Creturn         #MBEDTLS_ERR_MPI_DIVISION_BY_ZERO if \5Cp B equals zero.\0A * \5Creturn         Another negative error code on different kinds of failure.\0A */\0Aint mbedtls_mpi_div_mpi(mbedtls_mpi *Q, mbedtls_mpi *R, const mbedtls_mpi *A,\0A                        const mbedtls_mpi *B);\0A\0A/**\0A * \5Cbrief          Perform a division with remainder of an MPI by an integer:\0A *                 A = Q * b + R\0A *\0A * \5Cparam Q        The destination MPI for the quotient.\0A *                 This may be \5Cc NULL if the value of the\0A *                 quotient is not needed.  This must not alias A.\0A * \5Cparam R        The destination MPI for the remainder value.\0A *                 This may be \5Cc NULL if the value of the\0A *                 remainder is not needed.  This must not alias A.\0A * \5Cparam A        The dividend. This must point to an initialized MPi.\0A * \5Cparam b        The divisor.\0A *\0A * \5Creturn         \5Cc 0 if successful.\0A * \5Creturn         #MBEDTLS_ERR_MPI_ALLOC_FAILED if memory allocation failed.\0A * \5Creturn         #MBEDTLS_ERR_MPI_DIVISION_BY_ZERO if \5Cp b equals zero.\0A * \5Creturn         Another negative error code on different kinds of failure.\0A */\0Aint mbedtls_mpi_div_int(mbedtls_mpi *Q, mbedtls_mpi *R, const mbedtls_mpi *A,\0A                        mbedtls_mpi_sint b);\0A\0A/**\0A * \5Cbrief          Perform a modular reduction. R = A mod B\0A *\0A * \5Cparam R        The destination MPI for the residue value.\0A *                 This must point to an initialized MPI.\0A * \5Cparam A        The MPI to compute the residue of.\0A *                 This must point to an initialized MPI.\0A * \5Cparam B        The base of the modular reduction.\0A *                 This must point to an initialized MPI.\0A *\0A * \5Creturn         \5Cc 0 if successful.\0A * \5Creturn         #MBEDTLS_ERR_MPI_ALLOC_FAILED if a memory allocation failed.\0A * \5Creturn         #MBEDTLS_ERR_MPI_DIVISION_BY_ZERO if \5Cp B equals zero.\0A * \5Creturn         #MBEDTLS_ERR_MPI_NEGATIVE_VALUE if \5Cp B is negative.\0A * \5Creturn         Another negative error code on different kinds of failure.\0A *\0A */\0Aint mbedtls_mpi_mod_mpi(mbedtls_mpi *R, const mbedtls_mpi *A,\0A                        const mbedtls_mpi *B);\0A\0A/**\0A * \5Cbrief          Perform a modular reduction with respect to an integer.\0A *                 r = A mod b\0A *\0A * \5Cparam r        The address at which to store the residue.\0A *                 This must not be \5Cc NULL.\0A * \5Cparam A        The MPI to compute the residue of.\0A *                 This must point to an initialized MPi.\0A * \5Cparam b        The integer base of the modular reduction.\0A *\0A * \5Creturn         \5Cc 0 if successful.\0A * \5Creturn         #MBEDTLS_ERR_MPI_ALLOC_FAILED if a memory allocation failed.\0A * \5Creturn         #MBEDTLS_ERR_MPI_DIVISION_BY_ZERO if \5Cp b equals zero.\0A * \5Creturn         #MBEDTLS_ERR_MPI_NEGATIVE_VALUE if \5Cp b is negative.\0A * \5Creturn         Another negative error code on different kinds of failure.\0A */\0Aint mbedtls_mpi_mod_int(mbedtls_mpi_uint *r, const mbedtls_mpi *A,\0A                        mbedtls_mpi_sint b);\0A\0A/**\0A * \5Cbrief          Perform a modular exponentiation: X = A^E mod N\0A *\0A * \5Cparam X        The destination MPI. This must point to an initialized MPI.\0A *                 This must not alias E or N.\0A * \5Cparam A        The base of the exponentiation.\0A *                 This must point to an initialized MPI.\0A * \5Cparam E        The exponent MPI. This must point to an initialized MPI.\0A * \5Cparam N        The base for the modular reduction. This must point to an\0A *                 initialized MPI.\0A * \5Cparam prec_RR  A helper MPI depending solely on \5Cp N which can be used to\0A *                 speed-up multiple modular exponentiations for the same value\0A *                 of \5Cp N. This may be \5Cc NULL. If it is not \5Cc NULL, it must\0A *                 point to an initialized MPI. If it hasn't been used after\0A *                 the call to mbedtls_mpi_init(), this function will compute\0A *                 the helper value and store it in \5Cp prec_RR for reuse on\0A *                 subsequent calls to this function. Otherwise, the function\0A *                 will assume that \5Cp prec_RR holds the helper value set by a\0A *                 previous call to mbedtls_mpi_exp_mod(), and reuse it.\0A *\0A * \5Creturn         \5Cc 0 if successful.\0A * \5Creturn         #MBEDTLS_ERR_MPI_ALLOC_FAILED if a memory allocation failed.\0A * \5Creturn         #MBEDTLS_ERR_MPI_BAD_INPUT_DATA if \5Cc N is negative or\0A *                 even, or if \5Cc E is negative.\0A * \5Creturn         Another negative error code on different kinds of failures.\0A *\0A */\0Aint mbedtls_mpi_exp_mod(mbedtls_mpi *X, const mbedtls_mpi *A,\0A                        const mbedtls_mpi *E, const mbedtls_mpi *N,\0A                        mbedtls_mpi *prec_RR);\0A\0A/**\0A * \5Cbrief          Fill an MPI with a number of random bytes.\0A *\0A * \5Cparam X        The destination MPI. This must point to an initialized MPI.\0A * \5Cparam size     The number of random bytes to generate.\0A * \5Cparam f_rng    The RNG function to use. This must not be \5Cc NULL.\0A * \5Cparam p_rng    The RNG parameter to be passed to \5Cp f_rng. This may be\0A *                 \5Cc NULL if \5Cp f_rng doesn't need a context argument.\0A *\0A * \5Creturn         \5Cc 0 if successful.\0A * \5Creturn         #MBEDTLS_ERR_MPI_ALLOC_FAILED if a memory allocation failed.\0A * \5Creturn         Another negative error code on failure.\0A *\0A * \5Cnote           The bytes obtained from the RNG are interpreted\0A *                 as a big-endian representation of an MPI; this can\0A *                 be relevant in applications like deterministic ECDSA.\0A */\0Aint mbedtls_mpi_fill_random(mbedtls_mpi *X, size_t size,\0A                            int (*f_rng)(void *, unsigned char *, size_t),\0A                            void *p_rng);\0A\0A/** Generate a random number uniformly in a range.\0A *\0A * This function generates a random number between \5Cp min inclusive and\0A * \5Cp N exclusive.\0A *\0A * The procedure complies with RFC 6979 §3.3 (deterministic ECDSA)\0A * when the RNG is a suitably parametrized instance of HMAC_DRBG\0A * and \5Cp min is \5Cc 1.\0A *\0A * \5Cnote           There are `N - min` possible outputs. The lower bound\0A *                 \5Cp min can be reached, but the upper bound \5Cp N cannot.\0A *\0A * \5Cparam X        The destination MPI. This must point to an initialized MPI.\0A * \5Cparam min      The minimum value to return.\0A *                 It must be nonnegative.\0A * \5Cparam N        The upper bound of the range, exclusive.\0A *                 In other words, this is one plus the maximum value to return.\0A *                 \5Cp N must be strictly larger than \5Cp min.\0A * \5Cparam f_rng    The RNG function to use. This must not be \5Cc NULL.\0A * \5Cparam p_rng    The RNG parameter to be passed to \5Cp f_rng.\0A *\0A * \5Creturn         \5Cc 0 if successful.\0A * \5Creturn         #MBEDTLS_ERR_MPI_ALLOC_FAILED if a memory allocation failed.\0A * \5Creturn         #MBEDTLS_ERR_MPI_BAD_INPUT_DATA if \5Cp min or \5Cp N is invalid\0A *                 or if they are incompatible.\0A * \5Creturn         #MBEDTLS_ERR_MPI_NOT_ACCEPTABLE if the implementation was\0A *                 unable to find a suitable value within a limited number\0A *                 of attempts. This has a negligible probability if \5Cp N\0A *                 is significantly larger than \5Cp min, which is the case\0A *                 for all usual cryptographic applications.\0A * \5Creturn         Another negative error code on failure.\0A */\0Aint mbedtls_mpi_random(mbedtls_mpi *X,\0A                       mbedtls_mpi_sint min,\0A                       const mbedtls_mpi *N,\0A                       int (*f_rng)(void *, unsigned char *, size_t),\0A                       void *p_rng);\0A\0A/**\0A * \5Cbrief          Compute the greatest common divisor: G = gcd(A, B)\0A *\0A * \5Cparam G        The destination MPI. This must point to an initialized MPI.\0A * \5Cparam A        The first operand. This must point to an initialized MPI.\0A * \5Cparam B        The second operand. This must point to an initialized MPI.\0A *\0A * \5Creturn         \5Cc 0 if successful.\0A * \5Creturn         #MBEDTLS_ERR_MPI_ALLOC_FAILED if a memory allocation failed.\0A * \5Creturn         Another negative error code on different kinds of failure.\0A */\0Aint mbedtls_mpi_gcd(mbedtls_mpi *G, const mbedtls_mpi *A,\0A                    const mbedtls_mpi *B);\0A\0A/**\0A * \5Cbrief          Compute the modular inverse: X = A^-1 mod N\0A *\0A * \5Cparam X        The destination MPI. This must point to an initialized MPI.\0A * \5Cparam A        The MPI to calculate the modular inverse of. This must point\0A *                 to an initialized MPI.\0A * \5Cparam N        The base of the modular inversion. This must point to an\0A *                 initialized MPI.\0A *\0A * \5Creturn         \5Cc 0 if successful.\0A * \5Creturn         #MBEDTLS_ERR_MPI_ALLOC_FAILED if a memory allocation failed.\0A * \5Creturn         #MBEDTLS_ERR_MPI_BAD_INPUT_DATA if \5Cp N is less than\0A *                 or equal to one.\0A * \5Creturn         #MBEDTLS_ERR_MPI_NOT_ACCEPTABLE if \5Cp A has no modular\0A *                 inverse with respect to \5Cp N.\0A */\0Aint mbedtls_mpi_inv_mod(mbedtls_mpi *X, const mbedtls_mpi *A,\0A                        const mbedtls_mpi *N);\0A\0A/**\0A * \5Cbrief          Miller-Rabin primality test.\0A *\0A * \5Cwarning        If \5Cp X is potentially generated by an adversary, for example\0A *                 when validating cryptographic parameters that you didn't\0A *                 generate yourself and that are supposed to be prime, then\0A *                 \5Cp rounds should be at least the half of the security\0A *                 strength of the cryptographic algorithm. On the other hand,\0A *                 if \5Cp X is chosen uniformly or non-adversarially (as is the\0A *                 case when mbedtls_mpi_gen_prime calls this function), then\0A *                 \5Cp rounds can be much lower.\0A *\0A * \5Cparam X        The MPI to check for primality.\0A *                 This must point to an initialized MPI.\0A * \5Cparam rounds   The number of bases to perform the Miller-Rabin primality\0A *                 test for. The probability of returning 0 on a composite is\0A *                 at most 2<sup>-2*\5Cp rounds </sup>.\0A * \5Cparam f_rng    The RNG function to use. This must not be \5Cc NULL.\0A * \5Cparam p_rng    The RNG parameter to be passed to \5Cp f_rng.\0A *                 This may be \5Cc NULL if \5Cp f_rng doesn't use\0A *                 a context parameter.\0A *\0A * \5Creturn         \5Cc 0 if successful, i.e. \5Cp X is probably prime.\0A * \5Creturn         #MBEDTLS_ERR_MPI_ALLOC_FAILED if a memory allocation failed.\0A * \5Creturn         #MBEDTLS_ERR_MPI_NOT_ACCEPTABLE if \5Cp X is not prime.\0A * \5Creturn         Another negative error code on other kinds of failure.\0A */\0Aint mbedtls_mpi_is_prime_ext(const mbedtls_mpi *X, int rounds,\0A                             int (*f_rng)(void *, unsigned char *, size_t),\0A                             void *p_rng);\0A/**\0A * \5Cbrief Flags for mbedtls_mpi_gen_prime()\0A *\0A * Each of these flags is a constraint on the result X returned by\0A * mbedtls_mpi_gen_prime().\0A */\0Atypedef enum {\0A    MBEDTLS_MPI_GEN_PRIME_FLAG_DH =      0x0001, /**< (X-1)/2 is prime too */\0A    MBEDTLS_MPI_GEN_PRIME_FLAG_LOW_ERR = 0x0002, /**< lower error rate from 2<sup>-80</sup> to 2<sup>-128</sup> */\0A} mbedtls_mpi_gen_prime_flag_t;\0A\0A/**\0A * \5Cbrief          Generate a prime number.\0A *\0A * \5Cparam X        The destination MPI to store the generated prime in.\0A *                 This must point to an initialized MPi.\0A * \5Cparam nbits    The required size of the destination MPI in bits.\0A *                 This must be between \5Cc 3 and #MBEDTLS_MPI_MAX_BITS.\0A * \5Cparam flags    A mask of flags of type #mbedtls_mpi_gen_prime_flag_t.\0A * \5Cparam f_rng    The RNG function to use. This must not be \5Cc NULL.\0A * \5Cparam p_rng    The RNG parameter to be passed to \5Cp f_rng.\0A *                 This may be \5Cc NULL if \5Cp f_rng doesn't use\0A *                 a context parameter.\0A *\0A * \5Creturn         \5Cc 0 if successful, in which case \5Cp X holds a\0A *                 probably prime number.\0A * \5Creturn         #MBEDTLS_ERR_MPI_ALLOC_FAILED if a memory allocation failed.\0A * \5Creturn         #MBEDTLS_ERR_MPI_BAD_INPUT_DATA if `nbits` is not between\0A *                 \5Cc 3 and #MBEDTLS_MPI_MAX_BITS.\0A */\0Aint mbedtls_mpi_gen_prime(mbedtls_mpi *X, size_t nbits, int flags,\0A                          int (*f_rng)(void *, unsigned char *, size_t),\0A                          void *p_rng);\0A\0A#if defined(MBEDTLS_SELF_TEST)\0A\0A/**\0A * \5Cbrief          Checkup routine\0A *\0A * \5Creturn         0 if successful, or 1 if the test failed\0A */\0Aint mbedtls_mpi_self_test(int verbose);\0A\0A#endif /* MBEDTLS_SELF_TEST */\0A\0A#ifdef __cplusplus\0A}\0A#endif\0A\0A#endif /* bignum.h */\0A\00" }
