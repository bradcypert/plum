@.str41771 = private global { i64, i64, [8306 x i8] } { i64 -1, i64 8305, [8306 x i8] c"/**\0A * \5Cfile rsa_alt_helpers.h\0A *\0A * \5Cbrief Context-independent RSA helper functions\0A *\0A *  This module declares some RSA-related helper functions useful when\0A *  implementing the RSA interface. These functions are provided in a separate\0A *  compilation unit in order to make it easy for designers of alternative RSA\0A *  implementations to use them in their own code, as it is conceived that the\0A *  functionality they provide will be necessary for most complete\0A *  implementations.\0A *\0A *  End-users of Mbed TLS who are not providing their own alternative RSA\0A *  implementations should not use these functions directly, and should instead\0A *  use only the functions declared in rsa.h.\0A *\0A *  The interface provided by this module will be maintained through LTS (Long\0A *  Term Support) branches of Mbed TLS, but may otherwise be subject to change,\0A *  and must be considered an internal interface of the library.\0A *\0A *  There are two classes of helper functions:\0A *\0A *  (1) Parameter-generating helpers. These are:\0A *      - mbedtls_rsa_deduce_primes\0A *      - mbedtls_rsa_deduce_private_exponent\0A *      - mbedtls_rsa_deduce_crt\0A *       Each of these functions takes a set of core RSA parameters and\0A *       generates some other, or CRT related parameters.\0A *\0A *  (2) Parameter-checking helpers. These are:\0A *      - mbedtls_rsa_validate_params\0A *      - mbedtls_rsa_validate_crt\0A *      They take a set of core or CRT related RSA parameters and check their\0A *      validity.\0A *\0A */\0A/*\0A *  Copyright The Mbed TLS Contributors\0A *  SPDX-License-Identifier: Apache-2.0 OR GPL-2.0-or-later\0A */\0A#ifndef MBEDTLS_RSA_ALT_HELPERS_H\0A#define MBEDTLS_RSA_ALT_HELPERS_H\0A\0A#include \22mbedtls/build_info.h\22\0A\0A#include \22mbedtls/bignum.h\22\0A\0A#ifdef __cplusplus\0Aextern \22C\22 {\0A#endif\0A\0A\0A/**\0A * \5Cbrief          Compute RSA prime moduli P, Q from public modulus N=PQ\0A *                 and a pair of private and public key.\0A *\0A * \5Cnote           This is a 'static' helper function not operating on\0A *                 an RSA context. Alternative implementations need not\0A *                 overwrite it.\0A *\0A * \5Cparam N        RSA modulus N = PQ, with P, Q to be found\0A * \5Cparam E        RSA public exponent\0A * \5Cparam D        RSA private exponent\0A * \5Cparam P        Pointer to MPI holding first prime factor of N on success\0A * \5Cparam Q        Pointer to MPI holding second prime factor of N on success\0A *\0A * \5Creturn\0A *                 - 0 if successful. In this case, P and Q constitute a\0A *                   factorization of N.\0A *                 - A non-zero error code otherwise.\0A *\0A * \5Cnote           It is neither checked that P, Q are prime nor that\0A *                 D, E are modular inverses wrt. P-1 and Q-1. For that,\0A *                 use the helper function \5Cc mbedtls_rsa_validate_params.\0A *\0A */\0Aint mbedtls_rsa_deduce_primes(mbedtls_mpi const *N, mbedtls_mpi const *E,\0A                              mbedtls_mpi const *D,\0A                              mbedtls_mpi *P, mbedtls_mpi *Q);\0A\0A/**\0A * \5Cbrief          Compute RSA private exponent from\0A *                 prime moduli and public key.\0A *\0A * \5Cnote           This is a 'static' helper function not operating on\0A *                 an RSA context. Alternative implementations need not\0A *                 overwrite it.\0A *\0A * \5Cparam P        First prime factor of RSA modulus\0A * \5Cparam Q        Second prime factor of RSA modulus\0A * \5Cparam E        RSA public exponent\0A * \5Cparam D        Pointer to MPI holding the private exponent on success.\0A *\0A * \5Creturn\0A *                 - 0 if successful. In this case, D is set to a simultaneous\0A *                   modular inverse of E modulo both P-1 and Q-1.\0A *                 - A non-zero error code otherwise.\0A *\0A * \5Cnote           This function does not check whether P and Q are primes.\0A *\0A */\0Aint mbedtls_rsa_deduce_private_exponent(mbedtls_mpi const *P,\0A                                        mbedtls_mpi const *Q,\0A                                        mbedtls_mpi const *E,\0A                                        mbedtls_mpi *D);\0A\0A\0A/**\0A * \5Cbrief          Generate RSA-CRT parameters\0A *\0A * \5Cnote           This is a 'static' helper function not operating on\0A *                 an RSA context. Alternative implementations need not\0A *                 overwrite it.\0A *\0A * \5Cparam P        First prime factor of N\0A * \5Cparam Q        Second prime factor of N\0A * \5Cparam D        RSA private exponent\0A * \5Cparam DP       Output variable for D modulo P-1\0A * \5Cparam DQ       Output variable for D modulo Q-1\0A * \5Cparam QP       Output variable for the modular inverse of Q modulo P.\0A *\0A * \5Creturn         0 on success, non-zero error code otherwise.\0A *\0A * \5Cnote           This function does not check whether P, Q are\0A *                 prime and whether D is a valid private exponent.\0A *\0A */\0Aint mbedtls_rsa_deduce_crt(const mbedtls_mpi *P, const mbedtls_mpi *Q,\0A                           const mbedtls_mpi *D, mbedtls_mpi *DP,\0A                           mbedtls_mpi *DQ, mbedtls_mpi *QP);\0A\0A\0A/**\0A * \5Cbrief          Check validity of core RSA parameters\0A *\0A * \5Cnote           This is a 'static' helper function not operating on\0A *                 an RSA context. Alternative implementations need not\0A *                 overwrite it.\0A *\0A * \5Cparam N        RSA modulus N = PQ\0A * \5Cparam P        First prime factor of N\0A * \5Cparam Q        Second prime factor of N\0A * \5Cparam D        RSA private exponent\0A * \5Cparam E        RSA public exponent\0A * \5Cparam f_rng    PRNG to be used for primality check, or NULL\0A * \5Cparam p_rng    PRNG context for f_rng