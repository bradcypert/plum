@.str46292 = private global { i64, i64, [4768 x i8] } { i64 -1, i64 4767, [4768 x i8] c"/**\0A * \5Cfile pk_wrap.h\0A *\0A * \5Cbrief Public Key abstraction layer: wrapper functions\0A */\0A/*\0A *  Copyright The Mbed TLS Contributors\0A *  SPDX-License-Identifier: Apache-2.0 OR GPL-2.0-or-later\0A */\0A\0A#ifndef MBEDTLS_PK_WRAP_H\0A#define MBEDTLS_PK_WRAP_H\0A\0A#include \22mbedtls/build_info.h\22\0A\0A#include \22mbedtls/pk.h\22\0A\0A#if defined(MBEDTLS_USE_PSA_CRYPTO)\0A#include \22psa/crypto.h\22\0A#endif\0A\0Astruct mbedtls_pk_info_t {\0A    /** Public key type */\0A    mbedtls_pk_type_t type;\0A\0A    /** Type name */\0A    const char *name;\0A\0A    /** Get key size in bits */\0A    size_t (*get_bitlen)(mbedtls_pk_context *pk);\0A\0A    /** Tell if the context implements this type (e.g. ECKEY can do ECDSA) */\0A    int (*can_do)(mbedtls_pk_type_t type);\0A\0A    /** Verify signature */\0A    int (*verify_func)(mbedtls_pk_context *pk, mbedtls_md_type_t md_alg,\0A                       const unsigned char *hash, size_t hash_len,\0A                       const unsigned char *sig, size_t sig_len);\0A\0A    /** Make signature */\0A    int (*sign_func)(mbedtls_pk_context *pk, mbedtls_md_type_t md_alg,\0A                     const unsigned char *hash, size_t hash_len,\0A                     unsigned char *sig, size_t sig_size, size_t *sig_len,\0A                     int (*f_rng)(void *, unsigned char *, size_t),\0A                     void *p_rng);\0A\0A#if defined(MBEDTLS_ECDSA_C) && defined(MBEDTLS_ECP_RESTARTABLE)\0A    /** Verify signature (restartable) */\0A    int (*verify_rs_func)(mbedtls_pk_context *pk, mbedtls_md_type_t md_alg,\0A                          const unsigned char *hash, size_t hash_len,\0A                          const unsigned char *sig, size_t sig_len,\0A                          void *rs_ctx);\0A\0A    /** Make signature (restartable) */\0A    int (*sign_rs_func)(mbedtls_pk_context *pk, mbedtls_md_type_t md_alg,\0A                        const unsigned char *hash, size_t hash_len,\0A                        unsigned char *sig, size_t sig_size, size_t *sig_len,\0A                        int (*f_rng)(void *, unsigned char *, size_t),\0A                        void *p_rng, void *rs_ctx);\0A#endif /* MBEDTLS_ECDSA_C && MBEDTLS_ECP_RESTARTABLE */\0A\0A    /** Decrypt message */\0A    int (*decrypt_func)(mbedtls_pk_context *pk, const unsigned char *input, size_t ilen,\0A                        unsigned char *output, size_t *olen, size_t osize,\0A                        int (*f_rng)(void *, unsigned char *, size_t),\0A                        void *p_rng);\0A\0A    /** Encrypt message */\0A    int (*encrypt_func)(mbedtls_pk_context *pk, const unsigned char *input, size_t ilen,\0A                        unsigned char *output, size_t *olen, size_t osize,\0A                        int (*f_rng)(void *, unsigned char *, size_t),\0A                        void *p_rng);\0A\0A    /** Check public-private key pair */\0A    int (*check_pair_func)(mbedtls_pk_context *pub, mbedtls_pk_context *prv,\0A                           int (*f_rng)(void *, unsigned char *, size_t),\0A                           void *p_rng);\0A\0A    /** Allocate a new context */\0A    void * (*ctx_alloc_func)(void);\0A\0A    /** Free the given context */\0A    void (*ctx_free_func)(void *ctx);\0A\0A#if defined(MBEDTLS_ECDSA_C) && defined(MBEDTLS_ECP_RESTARTABLE)\0A    /** Allocate the restart context */\0A    void *(*rs_alloc_func)(void);\0A\0A    /** Free the restart context */\0A    void (*rs_free_func)(void *rs_ctx);\0A#endif /* MBEDTLS_ECDSA_C && MBEDTLS_ECP_RESTARTABLE */\0A\0A    /** Interface with the debug module */\0A    void (*debug_func)(mbedtls_pk_context *pk, mbedtls_pk_debug_item *items);\0A\0A};\0A#if defined(MBEDTLS_PK_RSA_ALT_SUPPORT)\0A/* Container for RSA-alt */\0Atypedef struct {\0A    void *key;\0A    mbedtls_pk_rsa_alt_decrypt_func decrypt_func;\0A    mbedtls_pk_rsa_alt_sign_func sign_func;\0A    mbedtls_pk_rsa_alt_key_len_func key_len_func;\0A} mbedtls_rsa_alt_context;\0A#endif\0A\0A#if defined(MBEDTLS_RSA_C)\0Aextern const mbedtls_pk_info_t mbedtls_rsa_info;\0A#endif\0A\0A#if defined(MBEDTLS_PK_HAVE_ECC_KEYS)\0Aextern const mbedtls_pk_info_t mbedtls_eckey_info;\0Aextern const mbedtls_pk_info_t mbedtls_eckeydh_info;\0A#endif\0A\0A#if defined(MBEDTLS_PK_CAN_ECDSA_SOME)\0Aextern const mbedtls_pk_info_t mbedtls_ecdsa_info;\0A#endif\0A\0A#if defined(MBEDTLS_PK_RSA_ALT_SUPPORT)\0Aextern const mbedtls_pk_info_t mbedtls_rsa_alt_info;\0A#endif\0A\0A#if defined(MBEDTLS_USE_PSA_CRYPTO)\0Aextern const mbedtls_pk_info_t mbedtls_ecdsa_opaque_info;\0Aextern const mbedtls_pk_info_t mbedtls_rsa_opaque_info;\0A\0A#if defined(MBEDTLS_RSA_C)\0Aint mbedtls_pk_psa_rsa_sign_ext(psa_algorithm_t psa_alg_md,\0A                                mbedtls_rsa_context *rsa_ctx,\0A                                const unsigned char *hash, size_t hash_len,\0A                                unsigned char *sig, size_t sig_size,\0A                                size_t *sig_len);\0A#endif /* MBEDTLS_RSA_C */\0A\0A#endif /* MBEDTLS_USE_PSA_CRYPTO */\0A\0A#endif /* MBEDTLS_PK_WRAP_H */\0A\00" }
