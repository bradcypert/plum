@.str40488 = private global { i64, i64, [13305 x i8] } { i64 -1, i64 13304, [13305 x i8] c"/*\0A *  PSA crypto layer on top of Mbed TLS crypto\0A */\0A/*\0A *  Copyright The Mbed TLS Contributors\0A *  SPDX-License-Identifier: Apache-2.0 OR GPL-2.0-or-later\0A */\0A\0A#ifndef PSA_CRYPTO_SLOT_MANAGEMENT_H\0A#define PSA_CRYPTO_SLOT_MANAGEMENT_H\0A\0A#include \22psa/crypto.h\22\0A#include \22psa_crypto_core.h\22\0A#include \22psa_crypto_se.h\22\0A\0A/** Range of volatile key identifiers.\0A *\0A *  The first #MBEDTLS_PSA_KEY_SLOT_COUNT identifiers of the implementation\0A *  range of key identifiers are reserved for volatile key identifiers.\0A *\0A *  If \5Cc id is a a volatile key identifier, #PSA_KEY_ID_VOLATILE_MIN - \5Cc id\0A *  indicates the key slot containing the volatile key definition. See\0A *  psa_crypto_slot_management.c for details.\0A */\0A\0A/** The minimum value for a volatile key identifier.\0A */\0A#define PSA_KEY_ID_VOLATILE_MIN  PSA_KEY_ID_VENDOR_MIN\0A\0A/** The maximum value for a volatile key identifier.\0A */\0A#if defined(MBEDTLS_PSA_KEY_STORE_DYNAMIC)\0A#define PSA_KEY_ID_VOLATILE_MAX (MBEDTLS_PSA_KEY_ID_BUILTIN_MIN - 1)\0A#else /* MBEDTLS_PSA_KEY_STORE_DYNAMIC */\0A#define PSA_KEY_ID_VOLATILE_MAX                                 \5C\0A    (PSA_KEY_ID_VOLATILE_MIN + MBEDTLS_PSA_KEY_SLOT_COUNT - 1)\0A#endif /* MBEDTLS_PSA_KEY_STORE_DYNAMIC */\0A\0A/** Test whether a key identifier is a volatile key identifier.\0A *\0A * \5Cparam key_id  Key identifier to test.\0A *\0A * \5Cretval 1\0A *         The key identifier is a volatile key identifier.\0A * \5Cretval 0\0A *         The key identifier is not a volatile key identifier.\0A */\0Astatic inline int psa_key_id_is_volatile(psa_key_id_t key_id)\0A{\0A    return (key_id >= PSA_KEY_ID_VOLATILE_MIN) &&\0A           (key_id <= PSA_KEY_ID_VOLATILE_MAX);\0A}\0A\0A/** Get the description of a key given its identifier and lock it.\0A *\0A * The descriptions of volatile keys and loaded persistent keys are stored in\0A * key slots. This function returns a pointer to the key slot containing the\0A * description of a key given its identifier.\0A *\0A * In case of a persistent key, the function loads the description of the key\0A * into a key slot if not already done.\0A *\0A * On success, the returned key slot has been registered for reading.\0A * It is the responsibility of the caller to call psa_unregister_read(slot)\0A * when they have finished reading the contents of the slot.\0A *\0A * On failure, `*p_slot` is set to NULL. This ensures that it is always valid\0A * to call psa_unregister_read on the returned slot.\0A *\0A * \5Cparam key           Key identifier to query.\0A * \5Cparam[out] p_slot   On success, `*p_slot` contains a pointer to the\0A *                      key slot containing the description of the key\0A *                      identified by \5Cp key.\0A *\0A * \5Cretval #PSA_SUCCESS\0A *         \5Cp *p_slot contains a pointer to the key slot containing the\0A *         description of the key identified by \5Cp key.\0A *         The key slot counter has been incremented.\0A * \5Cretval #PSA_ERROR_BAD_STATE\0A *         The library has not been initialized.\0A * \5Cretval #PSA_ERROR_INVALID_HANDLE\0A *         \5Cp key is not a valid key identifier.\0A * \5Cretval #PSA_ERROR_INSUFFICIENT_MEMORY\0A *         \5Cp key is a persistent key identifier. The implementation does not\0A *         have sufficient resources to load the persistent key. This can be\0A *         due to a lack of empty key slot, or available memory.\0A * \5Cretval #PSA_ERROR_DOES_NOT_EXIST\0A *         There is no key with key identifier \5Cp key.\0A * \5Cretval #PSA_ERROR_CORRUPTION_DETECTED \5Cemptydescription\0A * \5Cretval #PSA_ERROR_STORAGE_FAILURE \5Cemptydescription\0A * \5Cretval #PSA_ERROR_DATA_CORRUPT \5Cemptydescription\0A */\0Apsa_status_t psa_get_and_lock_key_slot(mbedtls_svc_key_id_t key,\0A                                       psa_key_slot_t **p_slot);\0A\0A/** Initialize the key slot structures.\0A *\0A * \5Cretval #PSA_SUCCESS\0A *         Currently this function always succeeds.\0A */\0Apsa_status_t psa_initialize_key_slots(void);\0A\0A#if defined(MBEDTLS_TEST_HOOKS) && defined(MBEDTLS_PSA_KEY_STORE_DYNAMIC)\0A/* Allow test code to customize the key slice length. We use this in tests\0A * that exhaust the key store to reach a full key store in reasonable time\0A * and memory.\0A *\0A * The length of each slice must be between 1 and\0A * (1 << KEY_ID_SLOT_INDEX_WIDTH) inclusive.\0A *\0A * The length for a given slice index must not change while\0A * the key store is initialized.\0A */\0Aextern size_t (*mbedtls_test_hook_psa_volatile_key_slice_length)(\0A    size_t slice_idx);\0A\0A/* The number of volatile key slices. */\0Asize_t psa_key_slot_volatile_slice_count(void);\0A#endif\0A\0A/** Delete all data from key slots in memory.\0A * This function is not thread safe, it wipes every key slot regardless of\0A * state and reader count. It should only be called when no slot is in use.\0A *\0A * This does not affect persistent storage. */\0Avoid psa_wipe_all_key_slots(void);\0A\0A/** Find a free key slot and reserve it to be filled with a key.\0A *\0A * This function finds a key slot that is free,\0A * sets its state to PSA_SLOT_FILLING and then returns the slot.\0A *\0A * On success, the key slot's state is PSA_SLOT_FILLING.\0A * It is the responsibility of the caller to change the slot's state to\0A * PSA_SLOT_EMPTY/FULL once key creation has finished.\0A *\0A * If multi-threading is enabled, the caller must hold the\0A * global key slot mutex.\0A *\0A * \5Cparam[out] volatile_key_id   - If null, reserve a cache slot for\0A *                                 a persistent or built-in key.\0A *                               - If non-null, allocate a slot for\0A *                                 a volatile key. On success,\0A *                                 \5Cp *volatile_key_id is the\0A *                                 identifier corresponding to the\0A *                                 returned slot. It is the caller's\0A *                                 responsibility to set this key identifier\0A *                                 in the attributes.\0A * \5Cparam[out] p_slot            On success, a pointer to the slot.\0A *\0A * \5Cretval #PSA_SUCCESS \5Cemptydescription\0A * \5Cretval #PSA_ERROR_INSUFFICIENT_MEMORY\0A *         There were no free key slots.\0A *         When #MBEDTLS_PSA_KEY_STORE_DYNAMIC is enabled, there was not\0A *         enough memory to allocate more slots.\0A * \5Cretval #PSA_ERROR_BAD_STATE \5Cemptydescription\0A * \5Cretval #PSA_ERROR_CORRUPTION_DETECTED\0A *         This function attempted to operate on a key slot which was in an\0A *         unexpected state.\0A */\0Apsa_status_t psa_reserve_free_key_slot(psa_key_id_t *volatile_key_id,\0A                                       psa_key_slot_t **p_slot);\0A\0A#if defined(MBEDTLS_PSA_KEY_STORE_DYNAMIC)\0A/** Return a key slot to the free list.\0A *\0A * Call this function when a slot obtained from psa_reserve_free_key_slot()\0A * is no longer in use.\0A *\0A * If multi-threading is enabled, the caller must hold the\0A * global key slot mutex.\0A *\0A * \5Cparam slice_idx             The slice containing the slot.\0A *                              This is `slot->slice_index` when the slot\0A *                              is obtained from psa_reserve_free_key_slot().\0A * \5Cparam slot                  The key slot.\0A *\0A * \5Cretval #PSA_SUCCESS \5Cemptydescription\0A * \5Cretval #PSA_ERROR_CORRUPTION_DETECTED\0A *         This function attempted to operate on a key slot which was in an\0A *         unexpected state.\0A */\0Apsa_status_t psa_free_key_slot(size_t slice_idx,\0A                               psa_key_slot_t *slot);\0A#endif /* MBEDTLS_PSA_KEY_STORE_DYNAMIC */\0A\0A/** Change the state of a key slot.\0A *\0A * This function changes the state of the key slot from expected_state to\0A * new state. If the state of the slot was not expected_state, the state is\0A * unchanged.\0A *\0A * If multi-threading is enabled, the caller must hold the\0A * global key slot mutex.\0A *\0A * \5Cparam[in] slot            The key slot.\0A * \5Cparam[in] expected_state  The current state of the slot.\0A * \5Cparam[in] new_state       The new state of the slot.\0A *\0A * \5Cretval #PSA_SUCCESS\0A               The key slot's state variable is new_state.\0A * \5Cretval #PSA_ERROR_CORRUPTION_DETECTED\0A *             The slot's state was not expected_state.\0A */\0Astatic inline psa_status_t psa_key_slot_state_transition(\0A    psa_key_slot_t *slot, psa_key_slot_state_t expected_state,\0A    psa_key_slot_state_t new_state)\0A{\0A    if (slot->state != expected_state) {\0A        return PSA_ERROR_CORRUPTION_DETECTED;\0A    }\0A    slot->state = new_state;\0A    return PSA_SUCCESS;\0A}\0A\0A/** Register as a reader of a key slot.\0A *\0A * This function increments the key slot registered reader counter by one.\0A * If multi-threading is enabled, the caller must hold the\0A * global key slot mutex.\0A *\0A * \5Cparam[in] slot  The key slot.\0A *\0A * \5Cretval #PSA_SUCCESS\0A               The key slot registered reader counter was incremented.\0A * \5Cretval #PSA_ERROR_CORRUPTION_DETECTED\0A *             The reader counter already reached its maximum value and was not\0A *             increased, or the slot's state was not PSA_SLOT_FULL.\0A */\0Astatic inline psa_status_t psa_register_read(psa_key_slot_t *slot)\0A{\0A    if ((slot->state != PSA_SLOT_FULL) ||\0A        (slot->var.occupied.registered_readers >= SIZE_MAX)) {\0A        return PSA_ERROR_CORRUPTION_DETECTED;\0A    }\0A    slot->var.occupied.registered_readers++;\0A\0A    return PSA_SUCCESS;\0A}\0A\0A/** Unregister from reading a key slot.\0A *\0A * This function decrements the key slot registered reader counter by one.\0A * If the state of the slot is PSA_SLOT_PENDING_DELETION,\0A * and there is only one registered reader (the caller),\0A * this function will call psa_wipe_key_slot().\0A * If multi-threading is enabled, the caller must hold the\0A * global key slot mutex.\0A *\0A * \5Cnote To ease the handling of errors in retrieving a key slot\0A *       a NULL input pointer is valid, and the function returns\0A *       successfully without doing anything in that case.\0A *\0A * \5Cparam[in] slot  The key slot.\0A * \5Cretval #PSA_SUCCESS\0A *             \5Cp slot is NULL or the key slot reader counter has been\0A *             decremented (and potentially wiped) successfully.\0A * \5Cretval #PSA_ERROR_CORRUPTION_DETECTED\0A *             The slot's state was neither PSA_SLOT_FULL nor\0A *             PSA_SLOT_PENDING_DELETION.\0A *             Or a wipe was attempted and the slot's state was not\0A *             PSA_SLOT_PENDING_DELETION.\0A *             Or registered_readers was equal to 0.\0A */\0Apsa_status_t psa_unregister_read(psa_key_slot_t *slot);\0A\0A/** Wrap a call to psa_unregister_read in the global key slot mutex.\0A *\0A * If threading is disabled, this simply calls psa_unregister_read.\0A *\0A * \5Cnote To ease the handling of errors in retrieving a key slot\0A *       a NULL input pointer is valid, and the function returns\0A *       successfully without doing anything in that case.\0A *\0A * \5Cparam[in] slot  The key slot.\0A * \5Cretval #PSA_SUCCESS\0A *             \5Cp slot is NULL or the key slot reader counter has been\0A *             decremented (and potentially wiped) successfully.\0A * \5Cretval #PSA_ERROR_CORRUPTION_DETECTED\0A *             The slot's state was neither PSA_SLOT_FULL nor\0A *             PSA_SLOT_PENDING_DELETION.\0A *             Or a wipe was attempted and the slot's state was not\0A *             PSA_SLOT_PENDING_DELETION.\0A *             Or registered_readers was equal to 0.\0A */\0Apsa_status_t psa_unregister_read_under_mutex(psa_key_slot_t *slot);\0A\0A/** Test whether a lifetime designates a key in an external cryptoprocessor.\0A *\0A * \5Cparam lifetime      The lifetime to test.\0A *\0A * \5Cretval 1\0A *         The lifetime designates an external key. There should be a\0A *         registered driver for this lifetime, otherwise the key cannot\0A *         be created or manipulated.\0A * \5Cretval 0\0A *         The lifetime designates a key that is volatile or in internal\0A *         storage.\0A */\0Astatic inline int psa_key_lifetime_is_external(psa_key_lifetime_t lifetime)\0A{\0A    return PSA_KEY_LIFETIME_GET_LOCATION(lifetime)\0A           != PSA_KEY_LOCATION_LOCAL_STORAGE;\0A}\0A\0A/** Validate a key's location.\0A *\0A * This function checks whether the key's attributes point to a location that\0A * is known to the PSA Core, and returns the driver function table if the key\0A * is to be found in an external location.\0A *\0A * \5Cparam[in] lifetime      The key lifetime attribute.\0A * \5Cparam[out] p_drv        On success, when a key is located in external\0A *                          storage, returns a pointer to the driver table\0A *                          associated with the key's storage location.\0A *\0A * \5Cretval #PSA_SUCCESS \5Cemptydescription\0A * \5Cretval #PSA_ERROR_INVALID_ARGUMENT \5Cemptydescription\0A */\0Apsa_status_t psa_validate_key_location(psa_key_lifetime_t lifetime,\0A                                       psa_se_drv_table_entry_t **p_drv);\0A\0A/** Validate the persistence of a key.\0A *\0A * \5Cparam[in] lifetime  The key lifetime attribute.\0A *\0A * \5Cretval #PSA_SUCCESS \5Cemptydescription\0A * \5Cretval #PSA_ERROR_NOT_SUPPORTED The key is persistent but persistent keys\0A *             are not supported.\0A */\0Apsa_status_t psa_validate_key_persistence(psa_key_lifetime_t lifetime);\0A\0A/** Validate a key identifier.\0A *\0A * \5Cparam[in] key           The key identifier.\0A * \5Cparam[in] vendor_ok     Non-zero to indicate that key identifiers in the\0A *                          vendor range are allowed, volatile key identifiers\0A *                          excepted \5Cc 0 otherwise.\0A *\0A * \5Cretval <> 0 if the key identifier is valid, 0 otherwise.\0A */\0Aint psa_is_valid_key_id(mbedtls_svc_key_id_t key, int vendor_ok);\0A\0A#endif /* PSA_CRYPTO_SLOT_MANAGEMENT_H */\0A\00" }
