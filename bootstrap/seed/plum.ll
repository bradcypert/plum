: Map[K, V]) (new_bucket_count: Int): Map[K, V] = {\0A    let mut new_buckets = map_make_buckets(new_bucket_count);\0A    for bucket in m.buckets {\0A        for entry in bucket {\0A            let idx = map_bucket_index(entry.key, new_bucket_count);\0A            new_buckets = new_buckets.set(idx, new_buckets[idx].push(entry));\0A        }\0A    };\0A    Map { buckets: new_buckets, size: m.size }\0A}\0A\0A/// A NEW map with `k` set to `v`, replacing any previous value. The\0A/// original is unchanged.\0Apub let Map.insert[K: Eq, V] (m: Map[K, V]) (k: K) (v: V): Map[K, V] = {\0A    let idx = map_bucket_index(k, m.buckets.len());\0A    let bucket = m.buckets[idx];\0A    let existing_i = map_bucket_find_index(bucket, k, 0);\0A    let inserted = if existing_i >= 0 {\0A        Map { buckets: m.buckets.set(idx, bucket.set(existing_i, MapEntry { key: k, value: v })), size: m.size }\0A    } else {\0A        Map { buckets: m.buckets.set(idx, bucket.push(MapEntry { key: k, value: v })), size: m.size + 1 }\0A    };\0A    if inserted.size * MAP_LOAD_FACTOR_DEN > inserted.buckets.len() * MAP_LOAD_FACTOR_NUM {\0A        map_rehash(inserted, inserted.buckets.len() * 2)\0A    } else {\0A        inserted\0A    }\0A}\0A\0A/// The value for `k`, or `None`.\0Apub let Map.get[K: Eq, V] (m: Map[K, V]) (k: K): Option[V] = {\0A    let bucket = m.buckets[map_bucket_index(k, m.buckets.len())];\0A    let i = map_bucket_find_index(bucket, k, 0);\0A    if i >= 0 { Some(bucket[i].value) } else { None }\0A}\0A\0A/// Whether `k` has a value.\0Apub let Map.contains[K: Eq, V] (m: Map[K, V]) (k: K): Bool =\0A    map_bucket_find_index(m.buckets[map_bucket_index(k, m.buckets.len())], k, 0) >= 0\0A\0A/// A new map without `k`. Removing an absent key is not an error.\0Apub let Map.remove[K: Eq, V] (m: Map[K, V]) (k: K): Map[K, V] = {\0A    let idx = map_bucket_index(k, m.buckets.len());\0A    let bucket = m.buckets[idx];\0A    let i = map_bucket_find_index(bucket, k, 0);\0A    if i >= 0 { Map { buckets: m.buckets.set(idx, bucket.remove(i)), size: m.size - 1 } } else { m }\0A}\0A\0A/// How many entries.\0Apub let Map.len[K, V] (m: Map[K, V]): Int = m.size\0A\0A/// Every key, in no particular order — buckets, not insertion order.\0Apub let Map.keys[K, V] (m: Map[K, V]): Array[K] = {\0A    let mut acc = [];\0A    for bucket in m.buckets { for entry in bucket { acc = acc.push(entry.key); } };\0A    acc\0A}\0A\0A/// Every value, in the same order as `Map.keys`.\0Apub let Map.values[K, V] (m: Map[K, V]): Array[V] = {\0A    let mut acc = [];\0A    for bucket in m.buckets { for entry in bucket { acc = acc.push(entry.value); } };\0A    acc\0A}\0A\0Alet map_from_arrays_acc[K: Eq, V] (keys: Array[K]) (values: Array[V]) (i: Int) (acc: Map[K, V]): Map[K, V] =\0A    if i >= keys.len() { acc } else { map_from_arrays_acc(keys, values, i + 1, Map.insert(acc, keys[i], values[i])) }\0A/// A map from parallel arrays, stopping at the shorter. A repeated\0A/// key keeps the LAST value.\0Apub let Map.from_arrays[K: Eq, V] (keys: Array[K]) (values: Array[V]): Map[K, V] = map_from_arrays_acc(keys, values, 0, Map.new(()))\0A\0A/// A set of `T`, persistent like `Map` — `Set.insert` returns a new\0A/// set. Members need `Eq`.\0Apub struct Set[T] { inner: Map[T, Unit] }\0A\0A/// An empty set.\0Apub let Set.new[T] (): Set[T] = Set { inner: Map.new(()) }\0A/// A new set with `x` added. Adding a member twice changes nothing.\0Apub let Set.insert[T: Eq] (s: Set[T]) (x: T): Set[T] = Set { inner: Map.insert(s.inner, x, ()) }\0A/// Whether `x` is a member.\0Apub let Set.contains[T: Eq] (s: Set[T]) (x: T): Bool = Map.contains(s.inner, x)\0A/// A new set without `x`.\0Apub let Set.remove[T: Eq] (s: Set[T]) (x: T): Set[T] = Set { inner: Map.remove(s.inner, x) }\0A/// How many members.\0Apub let Set.len[T] (s: Set[T]): Int = Map.len(s.inner)\0A/// Every member, in no particular order.\0Apub let Set.to_array[T] (s: Set[T]): Array[T] = Map.keys(s.inner)\0A\0A/// Everything in either set.\0Apub let Set.union[T: Eq] (a: Set[T]) (b: Set[T]): Set[T] = {\0A    let mut result = b;\0A    for x in Set.to_array(a) { result = Set.insert(result, x); };\0A    result\0A}\0A\0A/// Only what is in both.\0Apub let Set.intersection[T: Eq] (a: Set[T]) (b: Set[T]): Set[T] = {\0A    let mut result = Set.new(());\0A    for x in Set.to_array(a) { if Set.contains(b, x) { result = Set.insert(result, x); } };\0A    result\0A}\0A\0A/// What is in `a` and not in `b`.\0Apub let Set.difference[T: Eq] (a: Set[T]) (b: Set[T]): Set[T] = {\0A    let mut result = Set.new(());\0A    for x in Set.to_array(a) { if !Set.contains(b, x) { result = Set.insert(result, x); } };\0A    result\0A}\0A\0Alet set_from_array_acc[T: Eq] (arr: Array[T]) (i: Int) (acc: Set[T]): Set[T] =\0A    if i >= arr.len() { acc } else { set_from_array_acc(arr, i + 1, Set.insert(acc, arr[i])) }\0A/// A set of the array's elements, discarding duplicates.\0Apub let Set.from_array[T: Eq] (arr: Array[T]): Set[T] = set_from_array_acc(arr, 0, Set.new(()))\0A\0A// --- JSON ---\0A\0A/// Mirrored from `crates/plumc/src/lib.rs`'s STDLIB_JSON_SRC, minus its\0A/// own `chars_of` (the runtime already provides that one, since it is the\0A/// single thing this prelude cannot write in Plum). Everything else is\0A/// character-for-character the real compiler's, so the two agree on\0A/// number formatting, escape handling and parse errors by construction\0A/// rather than by inspection.\0Apub struct JsonEntry { pub key: String, pub value: JsonValue }\0A/// A parsed JSON document.\0A///\0A/// Numbers are binary64 `Float`s and may lose precision when parsed.\0A/// `use Json;` brings in decoders that turn one of these into your own\0A/// types; `Json.int` rejects values outside the safe integer range.\0Apub enum JsonValue {\0A    JsonNull,\0A    JsonBool(Bool),\0A    JsonNumber(Float),\0A    JsonString(String),\0A    JsonArray(Array[JsonValue]),\0A    JsonObject(Array[JsonEntry]),\0A}\0A/// What a JSON parse step consumed: a value, and where to carry on\0A/// from. Public because the parser's own pieces return it; a caller\0A/// wants `json_parse`.\0Apub struct ParseResult[T] { pub value: T, pub next_pos: Int }\0A\0Alet skip_ws (chars: Array[String]) (pos: Int): Int =\0A    if pos >= chars.len() { pos }\0A    else {\0A        let c = chars[pos];\0A        if c == \22 \22 || c == \22\5Ct\22 || c == \22\5Cn\22 || c == \22\5Cr\22 { skip_ws(chars, pos + 1) } else { pos }\0A    }\0A\0Alet digit_value (c: String): Result[Float, String] =\0A    if c == \220\22 { Ok(0.0) }\0A    else if c == \221\22 { Ok(1.0) }\0A    else if c == \222\22 { Ok(2.0) }\0A    else if c == \223\22 { Ok(3.0) }\0A    else if c == \224\22 { Ok(4.0) }\0A    else if c == \225\22 { Ok(5.0) }\0A    else if c == \226\22 { Ok(6.0) }\0A    else if c == \227\22 { Ok(7.0) }\0A    else if c == \228\22 { Ok(8.0) }\0A    else if c == \229\22 { Ok(9.0) }\0A    else { Err(\22not a digit\22) }\0A\0Alet pow10 (n: Int): Float = if n <= 0 { 1.0 } else { pow10(n - 1) * 10.0 }\0Alet pow10_float (n: Float): Float = if n <= 0.0 { 1.0 } else { pow10_float(n - 1.0) * 10.0 }\0A\0Alet parse_digits_acc (chars: Array[String]) (pos: Int) (acc: Float) (any: Bool): Result[ParseResult[Float], String] =\0A    if pos >= chars.len() {\0A        if any { Ok(ParseResult { value: acc, next_pos: pos }) } else { Err(\22expected digit\22) }\0A    } else {\0A        match digit_value(chars[pos]) {\0A            Ok(d) => parse_digits_acc(chars, pos + 1, acc * 10.0 + d, true),\0A            Err(_) => if any { Ok(ParseResult { value: acc, next_pos: pos }) } else { Err(\22expected digit\22) },\0A        }\0A    }\0A\0Alet parse_digits (chars: Array[String]) (pos: Int): Result[ParseResult[Float], String] = parse_digits_acc(chars, pos, 0.0, false)\0A\0Alet parse_number (chars: Array[String]) (pos: Int): Result[ParseResult[Float], String] = {\0A    let neg = pos < chars.len() && chars[pos] == \22-\22;\0A    let start = if neg { pos + 1 } else { pos };\0A    match parse_digits(chars, start) {\0A        Err(e) => Err(e),\0A        Ok(int_r) => {\0A            let has_frac = int_r.next_pos < chars.len() && chars[int_r.next_pos] == \22.\22;\0A            match (if has_frac { parse_digits(chars, int_r.next_pos + 1) } else { Ok(ParseResult { value: 0.0, next_pos: int_r.next_pos }) }) {\0A                Err(e) => Err(e),\0A                Ok(frac_r) => {\0A                    let frac_digit_count = if has_frac { frac_r.next_pos - (int_r.next_pos + 1) } else { 0 };\0A                    let frac_val = if has_frac { frac_r.value / pow10(frac_digit_count) } else { 0.0 };\0A                    let mag_no_exp = int_r.value + frac_val;\0A                    let exp_pos = frac_r.next_pos;\0A                    let has_exp = exp_pos < chars.len() && (chars[exp_pos] == \22e\22 || chars[exp_pos] == \22E\22);\0A                    if !has_exp {\0A                        Ok(ParseResult { value: parse_float_raw(Array.concat_all(Array.slice(chars, pos, exp_pos))), next_pos: exp_pos })\0A                    } else {\0A                        let after_e = exp_pos + 1;\0A                        let exp_neg = after_e < chars.len() && chars[after_e] == \22-\22;\0A                        let exp_pos_sign = after_e < chars.len() && chars[after_e] == \22+\22;\0A                        let exp_digit_start = if exp_neg || exp_pos_sign { after_e + 1 } else { after_e };\0A                        match parse_digits(chars, exp_digit_start) {\0A                            Err(e) => Err(e),\0A                            Ok(exp_r) => {\0A                                let exp_count = exp_r.value;\0A                                let factor = pow10_float(exp_count);\0A                                Ok(ParseResult { value: parse_float_raw(Array.concat_all(Array.slice(chars, pos, exp_r.next_pos))), next_pos: exp_r.next_pos })\0A                            }\0A                        }\0A                    }\0A                }\0A            }\0A        }\0A    }\0A}\0A\0Alet match_literal_at (chars: Array[String]) (pos: Int) (lit: Array[String]) (i: Int): Bool =\0A    if i >= lit.len() { true }\0A    else if pos + i >= chars.len() { false }\0A    else if chars[pos + i] == lit[i] { match_literal_at(chars, pos, lit, i + 1) }\0A    else { false }\0A\0Alet parse_literal (chars: Array[String]) (pos: Int) (word: String) (value: JsonValue): Result[ParseResult[JsonValue], String] = {\0A    let lit = chars_of(word);\0A    if match_literal_at(chars, pos, lit, 0) { Ok(ParseResult { value: value, next_pos: pos + lit.len() }) }\0A    else { Err(\22invalid literal\22) }\0A}\0A\0Alet parse_string_body (chars: Array[String]) (pos: Int) (acc: String): Result[ParseResult[String], String] =\0A    if pos >= chars.len() { Err(\22unterminated string\22) }\0A    else {\0A        let c = chars[pos];\0A        if c == \22\5C\22\22 { Ok(ParseResult { value: acc, next_pos: pos + 1 }) }\0A        else if c == \22\5C\5C\22 {\0A            if pos + 1 >= chars.len() { Err(\22unterminated escape\22) }\0A            else {\0A                let e = chars[pos + 1];\0A                if e == \22\5C\22\22 { parse_string_body(chars, pos + 2, acc.concat(\22\5C\22\22)) }\0A                else if e == \22\5C\5C\22 { parse_string_body(chars, pos + 2, acc.concat(\22\5C\5C\22)) }\0A                else if e == \22/\22 { parse_string_body(chars, pos + 2, acc.concat(\22/\22)) }\0A                else if e == \22n\22 { parse_string_body(chars, pos + 2, acc.concat(\22\5Cn\22)) }\0A                else if e == \22r\22 { parse_string_body(chars, pos + 2, acc.concat(\22\5Cr\22)) }\0A                else if e == \22t\22 { parse_string_body(chars, pos + 2, acc.concat(\22\5Ct\22)) }\0A                else { Err(\22unsupported escape sequence\22) }\0A            }\0A        }\0A        else { parse_string_body(chars, pos + 1, acc.concat(c)) }\0A    }\0A\0Alet parse_string (chars: Array[String]) (pos: Int): Result[ParseResult[String], String] =\0A    if pos >= chars.len() || chars[pos] != \22\5C\22\22 { Err(\22expected opening quote\22) }\0A    else { parse_string_body(chars, pos + 1, \22\22) }\0A\0Alet parse_value (chars: Array[String]) (pos: Int): Result[ParseResult[JsonValue], String] =\0A    if pos >= chars.len() { Err(\22unexpected end of input\22) }\0A    else {\0A        let c = chars[pos];\0A        if c == \22\5C\22\22 {\0A            match parse_string(chars, pos) {\0A                Ok(r) => Ok(ParseResult { value: JsonString(r.value), next_pos: r.next_pos }),\0A                Err(e) => Err(e),\0A            }\0A        }\0A        else if c == \22{\22 { parse_object(chars, pos) }\0A        else if c == \22[\22 { parse_array(chars, pos) }\0A        else if c == \22t\22 { parse_literal(chars, pos, \22true\22, JsonBool(true)) }\0A        else if c == \22f\22 { parse_literal(chars, pos, \22false\22, JsonBool(false)) }\0A        else if c == \22n\22 { parse_literal(chars, pos, \22null\22, JsonNull) }\0A        else {\0A            match digit_value(c) {\0A                Ok(_) => match parse_number(chars, pos) {\0A                    Ok(r) => Ok(ParseResult { value: JsonNumber(r.value), next_pos: r.next_pos }),\0A                    Err(e) => Err(e),\0A                },\0A                Err(_) => if c == \22-\22 {\0A                    match parse_number(chars, pos) {\0A                        Ok(r) => Ok(ParseResult { value: JsonNumber(r.value), next_pos: r.next_pos }),\0A                        Err(e) => Err(e),\0A                    }\0A                } else { Err(\22unexpected character\22) },\0A            }\0A        }\0A    }\0A\0Alet parse_array (chars: Array[String]) (pos: Int): Result[ParseResult[JsonValue], String] = {\0A    let p1 = skip_ws(chars, pos + 1);\0A    if p1 < chars.len() && chars[p1] == \22]\22 { Ok(ParseResult { value: JsonArray([]), next_pos: p1 + 1 }) }\0A    else { parse_array_entries(chars, p1, []) }\0A}\0A\0Alet parse_array_entries (chars: Array[String]) (pos: Int) (acc: Array[JsonValue]): Result[ParseResult[JsonValue], S