rv_slot_number_t slot_number,\0A    psa_key_attributes_t *attributes,\0A    uint8_t *key_buffer, size_t key_buffer_size, size_t *key_buffer_length )\0A{\0A\0A    psa_key_location_t location = PSA_KEY_LIFETIME_GET_LOCATION( psa_get_key_lifetime(attributes) );\0A    switch( location )\0A    {\0A#if defined(PSA_CRYPTO_ACCELERATOR_DRIVER_PRESENT)\0A\0A#if (defined(PSA_CRYPTO_DRIVER_TEST) )\0A        case 0x7fffff:\0A            return( mbedtls_test_opaque_get_builtin_key\0A            (slot_number,\0A                            attributes,\0A                            key_buffer,\0A                            key_buffer_size,\0A                            key_buffer_length\0A        ));\0A#endif\0A\0A\0A#endif /* PSA_CRYPTO_ACCELERATOR_DRIVER_PRESENT */\0A        default:\0A            (void) slot_number;\0A            (void) key_buffer;\0A            (void) key_buffer_size;\0A            (void) key_buffer_length;\0A            return( PSA_ERROR_DOES_NOT_EXIST );\0A    }\0A\0A}\0A\0A#endif /* MBEDTLS_PSA_CRYPTO_C */\0A\00" }
