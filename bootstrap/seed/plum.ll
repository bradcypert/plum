0A    }\0A};\0A\0Astatic const signed char transposes[2][20] =\0A{\0A    {\0A        21, 22, 23, 20,\0A        -1, -1, -1, -1,\0A        18, 19, 16, 17,\0A        11,  8,  9, 10,\0A        15, 12, 13, 14\0A    },\0A    {\0A        25, 26, 27, 24,\0A        29, 30, 31, 28,\0A        18, 19, 16, 17,\0A        -1, -1, -1, -1,\0A        -1, -1, -1, -1\0A    }\0A};\0A\0A/* Shift macro for 128 bit strings with rotation smaller than 32 bits (!) */\0A#define ROTL(DEST, SRC, SHIFT)                                      \5C\0A    {                                                                   \5C\0A        (DEST)[0] = (SRC)[0] << (SHIFT) ^ (SRC)[1] >> (32 - (SHIFT));   \5C\0A        (DEST)[1] = (SRC)[1] << (SHIFT) ^ (SRC)[2] >> (32 - (SHIFT));   \5C\0A        (DEST)[2] = (SRC)[2] << (SHIFT) ^ (SRC)[3] >> (32 - (SHIFT));   \5C\0A        (DEST)[3] = (SRC)[3] << (SHIFT) ^ (SRC)[0] >> (32 - (SHIFT));   \5C\0A    }\0A\0A#define FL(XL, XR, KL, KR)                                          \5C\0A    {                                                                   \5C\0A        (XR) = ((((XL) &(KL)) << 1) | (((XL) &(KL)) >> 31)) ^ (XR);   \5C\0A        (XL) = ((XR) | (KR)) ^ (XL);                                    \5C\0A    }\0A\0A#define FLInv(YL, YR, KL, KR)                                       \5C\0A    {                                                                   \5C\0A        (YL) = ((YR) | (KR)) ^ (YL);                                    \5C\0A        (YR) = ((((YL) &(KL)) << 1) | (((YL) &(KL)) >> 31)) ^ (YR);   \5C\0A    }\0A\0A#define SHIFT_AND_PLACE(INDEX, OFFSET)                      \5C\0A    {                                                           \5C\0A        TK[0] = KC[(OFFSET) * 4 + 0];                           \5C\0A        TK[1] = KC[(OFFSET) * 4 + 1];                           \5C\0A        TK[2] = KC[(OFFSET) * 4 + 2];                           \5C\0A        TK[3] = KC[(OFFSET) * 4 + 3];                           \5C\0A                            