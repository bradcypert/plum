@.str40768 = private global { i64, i64, [28 x i8] } { i64 -1, i64 27, [28 x i8] c"mbedtls/library/threading.c\00" }
@.str40770 = private global { i64, i64, [6390 x i8] } { i64 -1, i64 6389, [6390 x i8] c"/*\0A *  Threading abstraction layer\0A *\0A *  Copyright The Mbed TLS Contributors\0A *  SPDX-License-Identifier: Apache-2.0 OR GPL-2.0-or-later\0A */\0A\0A/*\0A * Ensure gmtime_r is available even with -std=c99; must be defined before\0A * mbedtls_config.h, which pulls in glibc's features.h. Harmless on other platforms.\0A */\0A#if !defined(_POSIX_C_SOURCE)\0A#define _POSIX_C_SOURCE 200112L\0A#endif\0A\0A#include \22common.h\22\0A\0A#if defined(MBEDTLS_THREADING_C)\0A\0A#include \22mbedtls/threading.h\22\0A\0A#if defined(MBEDTLS_HAVE_TIME_DATE) && !defined(MBEDTLS_PLATFORM_GMTIME_R_ALT)\0A\0A#if !defined(_WIN32) && (defined(unix) || \5C\0A    defined(__unix) || defined(__unix__) || (defined(__APPLE__) && \5C\0A    defined(__MACH__)))\0A#include <unistd.h>\0A#endif /* !_WIN32 && (unix || __unix || __unix__ ||\0A        * (__APPLE__ && __MACH__)) */\0A\0A#if !((defined(_POSIX_VERSION) && _POSIX_VERSION >= 200809L) ||     \5C\0A    (defined(_POSIX_THREAD_SAFE_FUNCTIONS) &&                     \5C\0A    _POSIX_THREAD_SAFE_FUNCTIONS >= 200112L))\0A/*\0A * This is a convenience shorthand macro to avoid checking the long\0A * preprocessor conditions above. Ideally, we could expose this macro in\0A * platform_util.h and simply use it in platform_util.c, threading.c and\0A * threading.h. However, this macro is not part of the Mbed TLS public API, so\0A * we keep it private by only defining it in this file\0A */\0A\0A#if !(defined(_WIN32) && !defined(EFIX64) && !defined(EFI32))\0A#define THREADING_USE_GMTIME\0A#endif /* ! ( defined(_WIN32) && !defined(EFIX64) && !defined(EFI32) ) */\0A\0A#endif /* !( ( defined(_POSIX_VERSION) && _POSIX_VERSION >= 200809L ) || \5C\0A             ( defined(_POSIX_THREAD_SAFE_FUNCTIONS ) && \5C\0A                _POSIX_THREAD_SAFE_FUNCTIONS >= 200112L ) ) */\0A\0A#endif /* MBEDTLS_HAVE_TIME_DATE && !MBEDTLS_PLATFORM_GMTIME_R_ALT */\0A\0A#if defined(MBEDTLS_THREADING_PTHREAD)\0Astatic void threading_mutex_init_pthread(mbedtls_threading_mutex_t *mutex)\0A{\0A    if (mutex == NULL) {\0A        return;\0A    }\0A\0A    /* One problem here is that calling lock on a pthread mutex without first\0A     * having initialised it is undefined behaviour. Obviously we cannot check\0A     * this here in a thread safe manner without a significant performance\0A     * hit, so state transitions are checked in tests only via the state\0A     * variable. Please make sure any new mutex that gets added is exercised in\0A     * tests; see framework/tests/src/threading_helpers.c for more details. */\0A    (void) pthread_mutex_init(&mutex->mutex, NULL);\0A}\0A\0Astatic void threading_mutex_free_pthread(mbedtls_threading_mutex_t *mutex)\0A{\0A    if (mutex == NULL) {\0A        return;\0A    }\0A\0A    (void) pthread_mutex_destroy(&mutex->mutex);\0A}\0A\0Astatic int threading_mutex_lock_pthread(mbedtls_threading_mutex_t *mutex)\0A{\0A    if (mutex == NULL) {\0A        return MBEDTLS_ERR_THREADING_BAD_INPUT_DATA;\0A    }\0A\0A    if (pthread_mutex_lock(&mutex->mutex) != 0) {\0A        return MBEDTLS_ERR_THREADING_MUTEX_ERROR;\0A    }\0A\0A    return 0;\0A}\0A\0Astatic int threading_mutex_unlock_pthread(mbedtls_threading_mutex_t *mutex)\0A{\0A    if (mutex == NULL) {\0A        return MBEDTLS_ERR_THREADING_BAD_INPUT_DATA;\0A    }\0A\0A    if (pthread_mutex_unlock(&mutex->mutex) != 0) {\0A        return MBEDTLS_ERR_THREADING_MUTEX_ERROR;\0A    }\0A\0A    return 0;\0A}\0A\0Avoid (*mbedtls_mutex_init)(mbedtls_threading_mutex_t *) = threading_mutex_init_pthread;\0Avoid (*mbedtls_mutex_free)(mbedtls_threading_mutex_t *) = threading_mutex_free_pthread;\0Aint (*mbedtls_mutex_lock)(mbedtls_threading_mutex_t *) = threading_mutex_lock_pthread;\0Aint (*mbedtls_mutex_unlock)(mbedtls_threading_mutex_t *) = threading_mutex_unlock_pthread;\0A\0A/*\0A * With pthreads we can statically initialize mutexes\0A */\0A#define MUTEX_INIT  = { PTHREAD_MUTEX_INITIALIZER, 1 }\0A\0A#endif /* MBEDTLS_THREADING_PTHREAD */\0A\0A#if defined(MBEDTLS_THREADING_ALT)\0Astatic int threading_mutex_fail(mbedtls_threading_mutex_t *mutex)\0A{\0A    ((void) mutex);\0A    return MBEDTLS_ERR_THREADING_BAD_INPUT_DATA;\0A}\0Astatic void threading_mutex_dummy(mbedtls_threading_mutex_t *mutex)\0A{\0A    ((void) mutex);\0A    return;\0A}\0A\0Avoid (*mbedtls_mutex_init)(mbedtls_threading_mutex_t *) = threading_mutex_dummy;\0Avoid (*mbedtls_mutex_free)(mbedtls_threading_mutex_t *) = threading_mutex_dummy;\0Aint (*mbedtls_mutex_lock)(mbedtls_threading_mutex_t *) = threading_mutex_fail;\0Aint (*mbedtls_mutex_unlock)(mbedtls_threading_mutex_t *) = threading_mutex_fail;\0A\0A/*\0A * Set functions pointers and initialize global mutexes\0A */\0Avoid mbedtls_threading_set_alt(void (*mutex_init)(mbedtls_threading_mutex_t *),\0A                               void (*mutex_free)(mbedtls_threading_mutex_t *),\0A                               int (*mutex_lock)(mbedtls_threading_mutex_t *),\0A                               int (*mutex_unlock)(mbedtls_threading_mutex_t *))\0A{\0A    mbedtls_mutex_init = mutex_init;\0A    mbedtls_mutex_free = mutex_free;\0A    mbedtls_mutex_lock = mutex_lock;\0A    mbedtls_mutex_unlock = mutex_unlock;\0A\0A#if defined(MBEDTLS_FS_IO)\0A    mbedtls_mutex_init(&mbedtls_threading_readdir_mutex);\0A#endif\0A#if defined(THREADING_USE_GMTIME)\0A    mbedtls_mutex_init(&mbedtls_threading_gmtime_mutex);\0A#endif\0A#if defined(MBEDTLS_PSA_CRYPTO_C)\0A    mbedtls_mutex_init(&mbedtls_threading_key_slot_mutex);\0A    mbedtls_mutex_init(&mbedtls_threading_psa_globaldata_mutex);\0A    mbedtls_mutex_init(&mbedtls_threading_psa_rngdata_mutex);\0A#endif\0A}\0A\0A/*\0A * Free global mutexes\0A */\0Avoid mbedtls_threading_free_alt(void)\0A{\0A#if defined(MBEDTLS_FS_IO)\0A    mbedtls_mutex_free(&mbedtls_threading_readdir_mutex);\0A#endif\0A#if defined(THREADING_USE_GMTIME)\0A    mbedtls_mutex_free(&mbedtls_threading_gmtime_mutex);\0A#endif\0A#if defined(MBEDTLS_