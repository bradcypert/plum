@.str45262 = private global { i64, i64, [3870 x i8] } { i64 -1, i64 3869, [3870 x i8] c"/**\0A * \5Cfile psa/crypto_adjust_config_key_pair_types.h\0A * \5Cbrief Adjust PSA configuration for key pair types.\0A *\0A * This is an internal header. Do not include it directly.\0A *\0A * See docs/proposed/psa-conditional-inclusion-c.md.\0A * - Support non-basic operations in a keypair type implicitly enables basic\0A *   support for that keypair type.\0A * - Support for a keypair type implicitly enables the corresponding public\0A *   key type.\0A * - Basic support for a keypair type implicilty enables import/export support\0A *   for that keypair type. Warning: this is implementation-specific (mainly\0A *   for the benefit of testing) and may change in the future!\0A */\0A/*\0A *  Copyright The Mbed TLS Contributors\0A *  SPDX-License-Identifier: Apache-2.0 OR GPL-2.0-or-later\0A */\0A\0A#ifndef PSA_CRYPTO_ADJUST_KEYPAIR_TYPES_H\0A#define PSA_CRYPTO_ADJUST_KEYPAIR_TYPES_H\0A\0A#if !defined(MBEDTLS_CONFIG_FILES_READ)\0A#error \22Do not include psa/crypto_adjust_*.h manually! This can lead to problems, \22 \5C\0A    \22up to and including runtime errors such as buffer overflows. \22 \5C\0A    \22If you're trying to fix a complaint from check_config.h, just remove \22 \5C\0A    \22it from your configuration file: since Mbed TLS 3.0, it is included \22 \5C\0A    \22automatically at the right point.\22\0A#endif /* */\0A\0A/*****************************************************************\0A * ANYTHING -> BASIC\0A ****************************************************************/\0A\0A#if defined(PSA_WANT_KEY_TYPE_ECC_KEY_PAIR_IMPORT) || \5C\0A    defined(PSA_WANT_KEY_TYPE_ECC_KEY_PAIR_EXPORT) || \5C\0A    defined(PSA_WANT_KEY_TYPE_ECC_KEY_PAIR_GENERATE) || \5C\0A    defined(PSA_WANT_KEY_TYPE_ECC_KEY_PAIR_DERIVE)\0A#define PSA_WANT_KEY_TYPE_ECC_KEY_PAIR_BASIC 1\0A#endif\0A\0A#if defined(PSA_WANT_KEY_TYPE_RSA_KEY_PAIR_IMPORT) || \5C\0A    defined(PSA_WANT_KEY_TYPE_RSA_KEY_PAIR_EXPORT) || \5C\0A    defined(PSA_WANT_KEY_TYPE_RSA_KEY_PAIR_GENERATE) || \5C\0A    defined(PSA_WANT_KEY_TYPE_RSA_KEY_PAIR_DERIVE)\0A#define PSA_WANT_KEY_TYPE_RSA_KEY_PAIR_BASIC 1\0A#endif\0A\0A#if defined(PSA_WANT_KEY_TYPE_DH_KEY_PAIR_IMPORT) || \5C\0A    defined(PSA_WANT_KEY_TYPE_DH_KEY_PAIR_EXPORT) || \5C\0A    defined(PSA_WANT_KEY_TYPE_DH_KEY_PAIR_GENERATE) || \5C\0A    defined(PSA_WANT_KEY_TYPE_DH_KEY_PAIR_DERIVE)\0A#define PSA_WANT_KEY_TYPE_DH_KEY_PAIR_BASIC 1\0A#endif\0A\0A/*****************************************************************\0A * BASIC -> corresponding PUBLIC\0A ****************************************************************/\0A\0A#if defined(PSA_WANT_KEY_TYPE_ECC_KEY_PAIR_BASIC)\0A#define PSA_WANT_KEY_TYPE_ECC_PUBLIC_KEY 1\0A#endif\0A\0A#if defined(PSA_WANT_KEY_TYPE_RSA_KEY_PAIR_BASIC)\0A#define PSA_WANT_KEY_TYPE_RSA_PUBLIC_KEY 1\0A#endif\0A\0A#if defined(PSA_WANT_KEY_TYPE_DH_KEY_PAIR_BASIC)\0A#define PSA_WANT_KEY_TYPE_DH_PUBLIC_KEY 1\0A#endif\0A\0A/*****************************************************************\0A * BASIC -> IMPORT+EXPORT\0A *\0A * (Implementation-specific, may change in the future.)\0A ****************************************************************/\0A\0A/* Even though KEY_PAIR symbols' feature several level of support (BASIC, IMPORT,\0A * EXPORT, GENERATE, DERIVE) we're not planning to have support only for BASIC\0A * without IMPORT/EXPORT since these last 2 features are strongly used in tests.\0A * In general it is allowed to include more feature than what is strictly\0A * requested.\0A * As a consequence IMPORT and EXPORT features will be automatically enabled\0A * as soon as the BASIC one is. */\0A#if defined(PSA_WANT_KEY_TYPE_ECC_KEY_PAIR_BASIC)\0A#define PSA_WANT_KEY_TYPE_ECC_KEY_PAIR_IMPORT 1\0A#define PSA_WANT_KEY_TYPE_ECC_KEY_PAIR_EXPORT 1\0A#endif\0A\0A#if defined(PSA_WANT_KEY_TYPE_RSA_KEY_PAIR_BASIC)\0A#define PSA_WANT_KEY_TYPE_RSA_KEY_PAIR_IMPORT 1\0A#define PSA_WANT_KEY_TYPE_RSA_KEY_PAIR_EXPORT 1\0A#endif\0A\0A#if defined(PSA_WANT_KEY_TYPE_DH_KEY_PAIR_BASIC)\0A#define PSA_WANT_KEY_TYPE_DH_KEY_PAIR_IMPORT 1\0A#define PSA_WANT_KEY_TYPE_DH_KEY_PAIR_EXPORT 1\0A#endif\0A\0A#endif /* PSA_CRYPTO_ADJUST_KEYPAIR_TYPES_H */\0A\00" }
