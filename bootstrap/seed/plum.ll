@.str44852 = private global { i64, i64, [18976 x i8] } { i64 -1, i64 18975, [18976 x i8] c"/*\0A *  HMAC_DRBG implementation (NIST SP 800-90)\0A *\0A *  Copyright The Mbed TLS Contributors\0A *  SPDX-License-Identifier: Apache-2.0 OR GPL-2.0-or-later\0A */\0A\0A/*\0A *  The NIST SP 800-90A DRBGs are described in the following publication.\0A *  http://csrc.nist.gov/publications/nistpubs/800-90A/SP800-90A.pdf\0A *  References below are based on rev. 1 (January 2012).\0A */\0A\0A#include \22common.h\22\0A\0A#if defined(MBEDTLS_HMAC_DRBG_C)\0A\0A#include \22mbedtls/hmac_drbg.h\22\0A#include \22mbedtls/platform_util.h\22\0A#include \22mbedtls/error.h\22\0A\0A#include <string.h>\0A\0A#if defined(MBEDTLS_FS_IO)\0A#include <stdio.h>\0A#endif\0A\0A#include \22mbedtls/platform.h\22\0A\0A/*\0A * HMAC_DRBG context initialization\0A */\0Avoid mbedtls_hmac_drbg_init(mbedtls_hmac_drbg_context *ctx)\0A{\0A    memset(ctx, 0, sizeof(mbedtls_hmac_drbg_context));\0A\0A    ctx->reseed_interval = MBEDTLS_HMAC_DRBG_RESEED_INTERVAL;\0A}\0A\0A/*\0A * HMAC_DRBG update, using optional additional data (10.1.2.2)\0A */\0Aint mbedtls_hmac_drbg_update(mbedtls_hmac_drbg_context *ctx,\0A                             const unsigned char *additional,\0A                             size_t add_len)\0A{\0A    size_t md_len = mbedtls_md_get_size(ctx->md_ctx.md_info);\0A    unsigned char rounds = (additional != NULL && add_len != 0) ? 2 : 1;\0A    unsigned char sep[1];\0A    unsigned char K[MBEDTLS_MD_MAX_SIZE];\0A    int ret = MBEDTLS_ERR_MD_BAD_INPUT_DATA;\0A\0A    for (sep[0] = 0; sep[0] < rounds; sep[0]++) {\0A        /* Step 1 or 4 */\0A        if ((ret = mbedtls_md_hmac_reset(&ctx->md_ctx)) != 0) {\0A            goto exit;\0A        }\0A        if ((ret = mbedtls_md_hmac_update(&ctx->md_ctx,\0A                                          ctx->V, md_len)) != 0) {\0A            goto exit;\0A        }\0A        if ((ret = mbedtls_md_hmac_update(&ctx->md_ctx,\0A                                          sep, 1)) != 0) {\0A            goto exit;\0A        }\0A        if (rounds == 2) {\0A            if ((ret = mbedtls_md_hmac_update(&ctx->md_ctx,\0A                                              additional, add_len)) != 0) {\0A                goto exit;\0A            }\0A        }\0A        if ((ret = mbedtls_md_hmac_finish(&ctx->md_ctx, K)) != 0) {\0A            goto exit;\0A        }\0A\0A        /* Step 2 or 5 */\0A        if ((ret = mbedtls_md_hmac_starts(&ctx->md_ctx, K, md_len)) != 0) {\0A            goto exit;\0A        }\0A        if ((ret = mbedtls_md_hmac_update(&ctx->md_ctx,\0A                                          ctx->V, md_len)) != 0) {\0A            goto exit;\0A        }\0A        if ((ret = mbedtls_md_hmac_finish(&ctx->md_ctx, ctx->V)) != 0) {\0A            goto exit;\0A        }\0A    }\0A\0Aexit:\0A    mbedtls_platform_zeroize(K, sizeof(K));\0A    return ret;\0A}\0A\0A/*\0A * Simplified HMAC_DRBG initialisation (for use with deterministic ECDSA)\0A */\0Aint mbedtls_hmac_drbg_seed_buf(mbedtls_hmac_drbg_context *ctx,\0A                               const mbedtls_md_info_t *md_info,\0A                               const unsigned char *data, size_t data_len)\0A{\0A    int ret = MBEDTLS_ERR_ERROR_CORRUPTION_DETECTED;\0A\0A    if ((ret = mbedtls_md_setup(&ctx->md_ctx, md_info, 1)) != 0) {\0A        return ret;\0A    }\0A\0A#if defined(MBEDTLS_THREADING_C)\0A    mbedtls_mutex_init(&ctx->mutex);\0A#endif\0A\0A    /*\0A     * Set initial working state.\0A     * Use the V memory location, which is currently all 0, to initialize the\0A     * MD context with an all-zero key. Then set V to its initial value.\0A     */\0A    if ((ret = mbedtls_md_hmac_starts(&ctx->md_ctx, ctx->V,\0A                                      mbedtls_md_get_size(md_info))) != 0) {\0A        return ret;\0A    }\0A    memset(ctx->V, 0x01, mbedtls_md_get_size(md_info));\0A\0A    if ((ret = mbedtls_hmac_drbg_update(ctx, data, data_len)) != 0) {\0A        return ret;\0A    }\0A\0A    return 0;\0A}\0A\0A/*\0A * Internal function used both for seeding and reseeding the DRBG.\0A * Comments starting with arabic numbers refer to section 10.1.2.4\0A * of SP800-90A, while roman numbers refer to section 9.2.\0A */\0Astatic int hmac_drbg_reseed_core(mbedtls_hmac_drbg_context *ctx,\0A                                 const unsigned char *additional, size_t len,\0A                                 int use_nonce)\0A{\0A    unsigned char seed[MBEDTLS_HMAC_DRBG_MAX_SEED_INPUT];\0A    size_t seedlen = 0;\0A    int ret = MBEDTLS_ERR_ERROR_CORRUPTION_DETECTED;\0A\0A    {\0A        size_t total_entropy_len;\0A\0A        if (use_nonce == 0) {\0A            total_entropy_len = ctx->entropy_len;\0A        } else {\0A            total_entropy_len = ctx->entropy_len * 3 / 2;\0A        }\0A\0A        /* III. Check input length */\0A        if (len > MBEDTLS_HMAC_DRBG_MAX_INPUT ||\0A            total_entropy_len + len > MBEDTLS_HMAC_DRBG_MAX_SEED_INPUT) {\0A            return MBEDTLS_ERR_HMAC_DRBG_INPUT_TOO_BIG;\0A        }\0A    }\0A\0A    memset(seed, 0, MBEDTLS_HMAC_DRBG_MAX_SEED_INPUT);\0A\0A    /* IV. Gather entropy_len bytes of entropy for the seed */\0A    if ((ret = ctx->f_entropy(ctx->p_entropy,\0A                              seed, ctx->entropy_len)) != 0) {\0A        return MBEDTLS_ERR_HMAC_DRBG_ENTROPY_SOURCE_FAILED;\0A    }\0A    seedlen += ctx->entropy_len;\0A\0A    /* For initial seeding, allow adding of nonce generated\0A     * from the entropy source. See Sect 8.6.7 in SP800-90A. */\0A    if (use_nonce) {\0A        /* Note: We don't merge the two calls to f_entropy() in order\0A         *       to avoid requesting too much entropy from f_entropy()\0A         *       at once. Specifically, if the underlying digest is not\0A         *       SHA-1, 3 / 2 * entropy_len is at least 36 Bytes, which\0A         *       is larger than the maximum of 32 Bytes that our own\0A         *       entropy source implementation can emit in a single\0A         *       call in co