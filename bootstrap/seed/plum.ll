ION_DISABLED ||\0A          (ssl->secure_renegotiation == MBEDTLS_SSL_LEGACY_RENEGOTIATION &&\0A           ssl->conf->allow_legacy_renegotiation ==\0A           MBEDTLS_SSL_LEGACY_NO_RENEGOTIATION))) {\0A        /*\0A         * Accept renegotiation request\0A         */\0A\0A        /* DTLS clients need to know renego is server-initiated */\0A#if defined(MBEDTLS_SSL_PROTO_DTLS)\0A        if (ssl->conf->transport == MBEDTLS_SSL_TRANSPORT_DATAGRAM &&\0A            ssl->conf->endpoint == MBEDTLS_SSL_IS_CLIENT) {\0A            ssl->renego_status = MBEDTLS_SSL_RENEGOTIATION_PENDING;\0A        }\0A#endif\0A        ret = mbedtls_ssl_start_renegotiation(ssl);\0A        if (ret != MBEDTLS_ERR_SSL_WAITING_SERVER_HELLO_RENEGO &&\0A            ret != 0) {\0A            MBEDTLS_SSL_DEBUG_RET(1, \22mbedtls_ssl_start_renegotiation\22,\0A                                  ret);\0A            return ret;\0A        }\0A    } else\0A#endif /* MBEDTLS_SSL_RENEGOTIATION */\0A    {\0A        /*\0A         * Refuse renegotiation\0A         */\0A\0A        MBEDTLS_SSL_DEBUG_MSG(3, (\22refusing renegotiation, sending alert\22));\0A\0A        if ((ret = mbedtls_ssl_send_alert_message(ssl,\0A                                                  MBEDTLS_SSL_ALERT_LEVEL_WARNING,\0A                                                  MBEDTLS_SSL_ALERT_MSG_NO_RENEGOTIATION)) != 0) {\0A            return ret;\0A        }\0A    }\0A\0A    return 0;\0A}\0A#endif /* MBEDTLS_SSL_PROTO_TLS1_2 */\0A\0AMBEDTLS_CHECK_RETURN_CRITICAL\0Astatic int ssl_handle_hs_message_post_handshake(mbedtls_ssl_context *ssl)\0A{\0A    /* Check protocol version and dispatch accordingly. */\0A#if defined(MBEDTLS_SSL_PROTO_TLS1_3)\0A    if (ssl->tls_version == MBEDTLS_SSL_VERSION_TLS1_3) {\0A        return ssl_tls13_handle_hs_message_post_handshake(ssl);\0A    }\0A#endif /* MBEDTLS_SSL_PROTO_TLS1_3 */\0A\0A#if defined(MBEDTLS_SSL_PROTO_TLS1_2)\0A    if (ssl->tls_version <= MBEDTLS_SSL_VERSION_TLS1_2) {\0A        return ssl_tls12_hand