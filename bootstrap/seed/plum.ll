384R1_ENABLED */\0A\0A#if defined(MBEDTLS_ECP_DP_SECP521R1_ENABLED)\0A        case MBEDTLS_ECP_DP_SECP521R1:\0A            NIST_MODP(p521);\0A            return LOAD_GROUP(secp521r1);\0A#endif /* MBEDTLS_ECP_DP_SECP521R1_ENABLED */\0A\0A#if defined(MBEDTLS_ECP_DP_SECP192K1_ENABLED)\0A        case MBEDTLS_ECP_DP_SECP192K1:\0A            grp->modp = ecp_mod_p192k1;\0A            return LOAD_GROUP_A(secp192k1);\0A#endif /* MBEDTLS_ECP_DP_SECP192K1_ENABLED */\0A\0A#if defined(MBEDTLS_ECP_DP_SECP224K1_ENABLED)\0A        case MBEDTLS_ECP_DP_SECP224K1:\0A            grp->modp = ecp_mod_p224k1;\0A            return LOAD_GROUP_A(secp224k1);\0A#endif /* MBEDTLS_ECP_DP_SECP224K1_ENABLED */\0A\0A#if defined(MBEDTLS_ECP_DP_SECP256K1_ENABLED)\0A        case MBEDTLS_ECP_DP_SECP256K1:\0A            grp->modp = ecp_mod_p256k1;\0A            return LOAD_GROUP_A(secp256k1);\0A#endif /* MBEDTLS_ECP_DP_SECP256K1_ENABLED */\0A\0A#if defined(MBEDTLS_ECP_DP_BP256R1_ENABLED)\0A        case MBEDTLS_ECP_DP_BP256R1:\0A            return LOAD_GROUP_A(brainpoolP256r1);\0A#endif /* MBEDTLS_ECP_DP_BP256R1_ENABLED */\0A\0A#if defined(MBEDTLS_ECP_DP_BP384R1_ENABLED)\0A        case MBEDTLS_ECP_DP_BP384R1:\0A            return LOAD_GROUP_A(brainpoolP384r1);\0A#endif /* MBEDTLS_ECP_DP_BP384R1_ENABLED */\0A\0A#if defined(MBEDTLS_ECP_DP_BP512R1_ENABLED)\0A        case MBEDTLS_ECP_DP_BP512R1:\0A            return LOAD_GROUP_A(brainpoolP512r1);\0A#endif /* MBEDTLS_ECP_DP_BP512R1_ENABLED */\0A\0A#if defined(MBEDTLS_ECP_DP_CURVE25519_ENABLED)\0A        case MBEDTLS_ECP_DP_CURVE25519:\0A            grp->modp = ecp_mod_p255;\0A            return ecp_use_curve25519(grp);\0A#endif /* MBEDTLS_ECP_DP_CURVE25519_ENABLED */\0A\0A#if defined(MBEDTLS_ECP_DP_CURVE448_ENABLED)\0A        case MBEDTLS_ECP_DP_CURVE448:\0A            grp->modp = ecp_mod_p448;\0A            return ecp_use_curve448(grp);\0A#endif /* MBEDTLS_ECP_DP_CURVE448_ENABLED */\0A\0A        default:\0A            grp->id = MBEDTLS_ECP_DP_NONE;\0A            return MBEDTLS_ERR_ECP_FEATURE_UNAVAILABLE;\0A    }\0A}\0A\0A#if defined(MBEDTLS_ECP_NIST_OPTIM)\0A/*\0A * Fast reduction modulo the primes used by the NIST curves.\0A *\0A * These functions are critical for speed, but not needed for correct\0A * operations. So, we make the choice to heavily rely on the internals of our\0A * bignum library, which creates a tight coupling between these functions and\0A * our MPI implementation.  However, the coupling between the ECP module and\0A * MPI remains loose, since these functions can be deactivated at will.\0A */\0A\0A#if defined(MBEDTLS_ECP_DP_SECP192R1_ENABLED)\0A/*\0A * Compared to the way things are presented in FIPS 186-3 D.2,\0A * we proceed in columns, from right (least significant chunk) to left,\0A * adding chunks to N in place, and keeping a carry for the next chunk.\0A * This avoids moving things around in memory, and uselessly adding zeros,\0A * compared to the more straightforward, line-oriented approach.\0A *\0A * For this prime we need to handle data in chunks of 64 bits.\0A * Since this is always a multiple of our basic mbedtls_mpi_uint, we can\0A * use a mbedtls_mpi_uint * to designate such a chunk, and small loops to handle it.\0A */\0A\0A/* Add 64-bit chunks (dst += src) and update carry */\0Astatic inline void add64(mbedtls_mpi_uint *dst, mbedtls_mpi_uint *src, mbedtls_mpi_uint *carry)\0A{\0A    unsigned char i;\0A    mbedtls_mpi_uint c = 0;\0A    for (i = 0; i < 8 / sizeof(mbedtls_mpi_uint); i++, dst++, src++) {\0A        *dst += c;      c  = (*dst < c);\0A        *dst += *src;   c += (*dst < *src);\0A    }\0A    *carry += c;\0A}\0A\0A/* Add carry to a 64-bit chunk and update carry */\0Astatic inline void carry64(mbedtls_mpi_uint *dst, mbedtls_mpi_uint *carry)\0A{\0A    unsigned char i;\0A    for (i = 0; i < 8 / sizeof(mbedtls_mpi_uint); i++, dst++) {\0A        *dst += *carry;\0A        *carry  = (*dst < *carry);\0A    }\0A}\0A\0A#define WIDTH       8 / sizeof(mbedtls_mpi_uint)\0A#define A(i)      N->p + (i) * WIDTH\0A#define ADD(i)    add64(p, A(i), &c)\0A#define NEXT        p += WIDTH; carry64(p, &c)\0A#define LAST        p += WIDTH; *p = c; while (++p < end) *p = 0\0A\0A/*\0A * Fast quasi-reduction modulo p192 (FIPS 186-3 D.2.1)\0A */\0Astatic int ecp_mod_p192(mbedtls_mpi *N)\0A{\0A    int ret = MBEDTLS_ERR_ERROR_CORRUPTION_DETECTED;\0A    mbedtls_mpi_uint c = 0;\0A    mbedtls_mpi_uint *p, *end;\0A\0A    /* Make sure we have enough blocks so that A(5) is legal */\0A    MBEDTLS_MPI_CHK(mbedtls_mpi_grow(N, 6 * WIDTH));\0A\0A    p = N->p;\0A    end = p + N->n;\0A\0A    ADD(3); ADD(5);             NEXT;     // A0 += A3 + A5\0A    ADD(3); ADD(4); ADD(5);   NEXT;       // A1 += A3 + A4 + A5\0A    ADD(4); ADD(5);             LAST;     // A2 += A4 + A5\0A\0Acleanup:\0A    return ret;\0A}\0A\0A#undef WIDTH\0A#undef A\0A#undef ADD\0A#undef NEXT\0A#undef LAST\0A#endif /* MBEDTLS_ECP_DP_SECP192R1_ENABLED */\0A\0A#if defined(MBEDTLS_ECP_DP_SECP224R1_ENABLED) ||   \5C\0A    defined(MBEDTLS_ECP_DP_SECP256R1_ENABLED) ||   \5C\0A    defined(MBEDTLS_ECP_DP_SECP384R1_ENABLED)\0A/*\0A * The reader is advised to first understand ecp_mod_p192() since the same\0A * general structure is used here, but with additional complications:\0A * (1) chunks of 32 bits, and (2) subtractions.\0A */\0A\0A/*\0A * For these primes, we need to handle data in chunks of 32 bits.\0A * This makes it more complicated if we use 64 bits limbs in MPI,\0A * which prevents us from using a uniform access method as for p192.\0A *\0A * So, we define a mini abstraction layer to access 32 bit chunks,\0A * load them in 'cur' for work, and store them back from 'cur' when done.\0A *\0A * While at it, also define the size of N in terms of 32-bit chunks.\0A */\0A#define LOAD32      cur = A(i);\0A\0A#if defined(MBEDTLS_HAVE_INT32)  /* 32 bit */\0A\0A#define MAX32       N->n\0A#define A(j)      N->p[j]\0A#define STORE32     N->p[i] = cur;\0A\0A#else                               /* 64-bit */\0A\0A#define MAX32       N->n * 2\0A#define A(j) (j) % 2 ? (uint32_t) (N->p[(j)/2] >> 32) : \5C\0A    (uint32_t) (N->p[(j)/2])\0A#define STORE32                                   \5C\0A    if (i % 2) {                                 \5C\0A        N->p[i/2] &= 0x00000000FFFFFFFF;          \5C\0A        N->p[i/2] |= ((mbedtls_mpi_uint) cur) << 32;        \5C\0A    } else {                                      \5C\0A        N->p[i/2] &= 0xFFFFFFFF00000000;          \5C\0A        N->p[i/2] |= (mbedtls_mpi_uint) cur;                \5C\0A    }\0A\0A#endif /* sizeof( mbedtls_mpi_uint ) */\0A\0A/*\0A * Helpers for addition and subtraction of chunks, with signed carry.\0A */\0Astatic inline void add32(uint32_t *dst, uint32_t src, signed char *carry)\0A{\0A    *dst += src;\0A    *carry += (*dst < src);\0A}\0A\0Astatic inline void sub32(uint32_t *dst, uint32_t src, signed char *carry)\0A{\0A    *carry -= (*dst < src);\0A    *dst -= src;\0A}\0A\0A#define ADD(j)    add32(&cur, A(j), &c);\0A#define SUB(j)    sub32(&cur, A(j), &c);\0A\0A/*\0A * Helpers for the main 'loop'\0A */\0A#define INIT(b)                                                       \5C\0A    int ret = MBEDTLS_ERR_ERROR_CORRUPTION_DETECTED;                    \5C\0A    signed char c = 0, cc;                                              \5C\0A    uint32_t cur;                                                       \5C\0A    size_t i = 0, bits = (b);                                           \5C\0A    /* N is the size of the product of two b-bit numbers, plus one */   \5C\0A    /* limb for fix_negative */                                         \5C\0A    MBEDTLS_MPI_CHK(mbedtls_mpi_grow(N, (b) * 2 / biL + 1));      \5C\0A    LOAD32;\0A\0A#define NEXT                    \5C\0A    STORE32; i++; LOAD32;       \5C\0A    cc = c; c = 0;              \5C\0A    if (cc < 0)                \5C\0A    sub32(&cur, -cc, &c); \5C\0A    else                        \5C\0A    add32(&cur, cc, &c);  \5C\0A\0A#define LAST                                    \5C\0A    STORE32; i++;                               \5C\0A    cur = c > 0 ? c : 0; STORE32;               \5C\0A    cur = 0; while (++i < MAX32) { STORE32; }  \5C\0A    if (c < 0) mbedtls_ecp_fix_negative(N, c, bits);\0A\0A/*\0A * If the result is negative, we get it in the form\0A * c * 2^bits + N, with c negative and N positive shorter than 'bits'\0A */\0Astatic void mbedtls_ecp_fix_negative(mbedtls_mpi *N, signed char c, size_t bits)\0A{\0A    size_t i;\0A\0A    /* Set N := 2^bits - 1 - N. We know that 0 <= N < 2^bits, so\0A     * set the absolute value to 0xfff...fff - N. There is no carry\0A     * since we're subtracting from all-bits-one.  */\0A    for (i = 0; i <= bits / 8 / sizeof(mbedtls_mpi_uint); i++) {\0A        N->p[i] = ~(mbedtls_mpi_uint) 0 - N->p[i];\0A    }\0A    /* Add 1, taking care of the carry. */\0A    i = 0;\0A    do {\0A        ++N->p[i];\0A    } while (N->p[i++] == 0 && i <= bits / 8 / sizeof(mbedtls_mpi_uint));\0A    /* Invert the sign.\0A     * Now N = N0 - 2^bits where N0 is the initial value of N. */\0A    N->s = -1;\0A\0A    /* Add |c| * 2^bits to the absolute value. Since c and N are\0A     * negative, this adds c * 2^bits. */\0A    mbedtls_mpi_uint msw = (mbedtls_mpi_uint) -c;\0A#if defined(MBEDTLS_HAVE_INT64)\0A    if (bits == 224) {\0A        msw <<= 32;\0A    }\0A#endif\0A    N->p[bits / 8 / sizeof(mbedtls_mpi_uint)] += msw;\0A}\0A\0A#if defined(MBEDTLS_ECP_DP_SECP224R1_ENABLED)\0A/*\0A * Fast quasi-reduction modulo p224 (FIPS 186-3 D.2.2)\0A */\0Astatic int ecp_mod_p224(mbedtls_mpi *N)\0A{\0A    INIT(224);\0A\0A    SUB(7); SUB(11);               NEXT;      // A0 += -A7 - A11\0A    SUB(8); SUB(12);               NEXT;      // A1 += -A8 - A12\0A    SUB(9); SUB(13);               NEXT;      // A2 += -A9 - A13\0A    SUB(10); ADD(7); ADD(11);    NEXT;        // A3 += -A10 + A7 + A11\0A    SUB(11); ADD(8); ADD(12);    NEXT;        // A4 += -A11 + A8 + A12\0A    SUB(12); ADD(9); ADD(13);    NEXT;        // A5 += -A12 + A9 + A13\0A    SUB(13); ADD(10);               LAST;     // A6 += -A13 + A10\0A\0Acleanup:\0A    return ret;\0A}\0A#endif /* MBEDTLS_ECP_DP_SECP224R1_ENABLED */\0A\0A#if defined(MBEDTLS_ECP_DP_SECP256R1_ENABLED)\0A/*\0A * Fast quasi-reduction modulo p256 (FIPS 186-3 D.2.3)\0A */\0Astatic int ecp_mod_p256(mbedtls_mpi *N)\0A{\0A    INIT(256);\0A\0A    ADD(8); ADD(9);\0A    SUB(11); SUB(12); SUB(13); SUB(14);             NEXT;         // A0\0A\0A    ADD(9); ADD(10);\0A    SUB(12); SUB(13); SUB(14); SUB(15);             NEXT;         // A1\0A\0A    ADD(10); ADD(11);\0A    SUB(13); SUB(14); SUB(15);                        NEXT;       // A2\0A\0A    ADD(11); ADD(11); ADD(12); ADD(12); ADD(13);\0A    SUB(15); SUB(8); SUB(9);                        NEXT;         // A3\0A\0A    ADD(12); ADD(12); ADD(13); ADD(13); ADD(14);\0A    SUB(9); SUB(10);                                   NEXT;      // A4\0A\0A    ADD(13); ADD(13); ADD(14); ADD(14); ADD(15);\0A    SUB(10); SUB(11);                                   NEXT;     // A5\0A\0A    ADD(14); ADD(14); ADD(15); ADD(15); ADD(14); ADD(13);\0A    SUB(8); SUB(9);                                   NEXT;       // A6\0A\0A    ADD(15); ADD(15); ADD(15); ADD(8);\0A    SUB(10); SUB(11); SUB(12); SUB(13);             LAST;         // A7\0A\0Acleanup:\0A    return ret;\0A}\0A#endif /* MBEDTLS_ECP_DP_SECP256R1_ENABLED */\0A\0A#if defined(MBEDTLS_ECP_DP_SECP384R1_ENABLED)\0A/*\0A * Fast quasi-reduction modulo p384 (FIPS 186-3 D.2.4)\0A */\0Astatic int ecp_mod_p384(mbedtls_mpi *N)\0A{\0A    INIT(384);\0A\0A    ADD(12); ADD(21); ADD(20);\0A    SUB(23);                                              NEXT;   // A0\0A\0A    ADD(13); ADD(22); ADD(23);\0A    SUB(12); SUB(20);                                   NEXT;     // A2\0A\0A    ADD(14); ADD(23);\0A    SUB(13); SUB(21);                                   NEXT;     // A2\0A\0A    ADD(15); ADD(12); ADD(20); ADD(21);\0A    SUB(14); SUB(22); SUB(23);                        NEXT;       // A3\0A\0A    ADD(21); ADD(21); ADD(16); ADD(13); ADD(12); ADD(20); ADD(22);\0A    SUB(15); SUB(23); SUB(23);                        NEXT;       // A4\0A\0A    ADD(22); ADD(22); ADD(17); ADD(14); ADD(13); ADD(21); ADD(23);\0A    SUB(16);                                              NEXT;   // A5\0A\0A    ADD(23); ADD(23); ADD(18); ADD(15); ADD(14); ADD(22);\0A    SUB(17);                                              NEXT;   // A6\0A\0A    ADD(19); ADD(16); ADD(15); ADD(23);\0A    SUB(18);                                              NEXT;   // A7\0A\0A    ADD(20); ADD(17); ADD(16);\0A    SUB(19);                                              NEXT;   // A8\0A\0A    ADD(21); ADD(18); ADD(17);\0A    SUB(20);                                              NEXT;   // A9\0A\0A    ADD(22); ADD(19); ADD(18);\0A    SUB(21);                                              NEXT;   // A10\0A\0A    ADD(23); ADD(20); ADD(19);\0A    SUB(22);                                              LAST;   // A11\0A\0Acleanup:\0A    return ret;\0A}\0A#endif /* MBEDTLS_ECP_DP_SECP384R1_ENABLED */\0A\0A#undef A\0A#undef LOAD32\0A#undef STORE32\0A#undef MAX32\0A#undef INIT\0A#undef NEXT\0A#undef LAST\0A\0A#endif /* MBEDTLS_ECP_DP_SECP224R1_ENABLED ||\0A          MBEDTLS_ECP_DP_SECP256R1_ENABLED ||\0A          MBEDTLS_ECP_DP_SECP384R1_ENABLED */\0A\0A#if defined(MBEDTLS_ECP_DP_SECP521R1_ENABLED)\0A/*\0A * Here we have an actual Mersenne prime, so things are more straightforward.\0A * However, chunks are aligned on a 'weird' boundary (521 bits).\0A */\0A\0A/* Size of p521 in terms of mbedtls_mpi_uint */\0A#define P521_WIDTH      (521 / 8 / sizeof(mbedtls_mpi_uint) + 1)\0A\0A/* Bits to keep in the most significant mbedtls_mpi_uint */\0A#define P521_MASK       0x01FF\0A\0A/*\0A * Fast quasi-reduction modulo p521 (FIPS 186-3 D.2.5)\0A * Write N as A1 + 2^521 A0, return A0 + A1\0A */\0Astatic int ecp_mod_p521(mbedtls_mpi *N)\0A{\0A    int ret = MBEDTLS_ERR_ERROR_CORRUPTION_DETECTED;\0A    size_t i;\0A    mbedtls_mpi M;\0A    mbedtls_mpi_uint Mp[P521_WIDTH + 1];\0A    /* Worst case for the size of M is when mbedtls_mpi_uint is 16 bits:\0A     * we need to hold bits 513 to 1056, which is 34 limbs, that is\0A     * P521_WIDTH + 1. Otherwise P521_WIDTH is enough. */\0A\0A    if (N->n < P521_WIDTH) {\0A        return 0;\0A    }\0A\0A    /* M = A1 */\0A    M.s = 1;\0A    M.n = N->n - (P521_WIDTH - 1);\0A    if (M.n > P521_WIDTH + 1) {\0A        M.n = P521_WIDTH + 1;\0A    }\0A    M.p = Mp;\0A    memcpy(Mp, N->p + P521_WIDTH - 1, M.n * sizeof(mbedtls_mpi_uint));\0A    MBEDTLS_MPI_CHK(mbedtls_mpi_shift_r(&M, 521 % (8 * sizeof(mbedtls_mpi_uint))));\0A\0A    /* N = A0 */\0A    N->p[P521_WIDTH - 1] &= P521_MASK;\0A    for (i = P521_WIDTH; i < N->n; i++) {\0A        N->p[i] = 0;\0A    }\0A\0A    /* N = A0 + A1 */\0A    MBEDTLS_MPI_CHK(mbedtls_mpi_add_abs(N, N, &M));\0A\0Acleanup:\0A    return ret;\0A}\0A\0A#undef P521_WIDTH\0A#undef P521_MASK\0A#endif /* MBEDTLS_ECP_DP_SECP521R1_ENABLED */\0A\0A#endif /* MBEDTLS_ECP_NIST_OPTIM */\0A\0A#if defined(MBEDTLS_ECP_DP_CURVE25519_ENABLED)\0A\0A/* Size of p255 in terms of mbedtls_mpi_uint */\0A#define P255_WIDTH      (255 / 8 / sizeof(mbedtls_mpi_uint) + 1)\0A\0A/*\0A * Fast quasi-reduction modulo p255 = 2^255 - 19\0A * Write N as A0 + 2^256 A1, return A0 + 38 * A1\0A */\0Astatic int ecp_mod_p255(mbedtls_mpi *N)\0A{\0A    mbedtls_mpi_uint Mp[P255_WIDTH];\0A\0A    /* Helper references for top part of N */\0A    mbedtls_mpi_uint * const NT_p = N->p + P255_WIDTH;\0A    const size_t NT_n = N->n - P255_WIDTH;\0A    if (N->n <= P255_WIDTH) {\0A        return 0;\0A    }\0A    if (NT_n > P255_WIDTH) {\0A        return MBEDTLS_ERR_ECP_BAD_INPUT_DATA;\0A    }\0A\0A    /* Split N as N + 2^256 M */\0A    memcpy(Mp,   NT_p, sizeof(mbedtls_mpi_uint) * NT_n);\0A    memset(NT_p, 0,    sizeof(mbedtls_mpi_uint) * NT_n);\0A\0A    /* N = A0 + 38 * A1 */\0A    mbedtls_mpi_core_mla(N->p, P255_WIDTH + 1,\0A                         Mp, NT_n,\0A                         38);\0A\0A    return 0;\0A}\0A#endif /* MBEDTLS_ECP_DP_CURVE25519_ENABLED */\0A\0A#if defined(MBEDTLS_ECP_DP_CURVE448_ENABLED)\0A\0A/* Size of p448 in terms of mbedtls_mpi_uint */\0A#define P448_WIDTH      (448 / 8 / sizeof(mbedtls_mpi_uint))\0A\0A/* Number of limbs fully occupied by 2^224 (max), and limbs used by it (min) */\0A#define DIV_ROUND_UP(X, Y) (((X) + (Y) -1) / (Y))\0A#define P224_SIZE        (224 / 8)\0A#define P224_WIDTH_MIN   (P224_SIZE / sizeof(mbedtls_mpi_uint))\0A#define P224_WIDTH_MAX   DIV_ROUND_UP(P224_SIZE, sizeof(mbedtls_mpi_uint))\0A#define P224_UNUSED_BITS ((P224_WIDTH_MAX * sizeof(mbedtls_mpi_uint) * 8) - 224)\0A\0A/*\0A * Fast quasi-reduction modulo p448 = 2^448 - 2^224 - 1\0A * Write N as A0 + 2^448 A1 and A1 as B0 + 2^224 B1, and return\0A * A0 + A1 + B1 + (B0 + B1) * 2^224.  This is different to the reference\0A * implementation of Curve448, which uses its own special 56-bit limbs rather\0A * than a generic bignum library.  We could squeeze some extra speed out on\0A * 32-bit machines by splitting N up into 32-bit limbs and doing the\0A * arithmetic using the limbs directly as we do for the NIST primes above,\0A * but for 64-bit targets it should use half the number of operations if we do\0A * the reduction with 224-bit limbs, since mpi_add_mpi will then use 64-bit adds.\0A */\0Astatic int ecp_mod_p448(mbedtls_mpi *N)\0A{\0A    int ret = MBEDTLS_ERR_ERROR_CORRUPTION_DETECTED;\0A    size_t i;\0A    mbedtls_mpi M, Q;\0A    mbedtls_mpi_uint Mp[P448_WIDTH + 1], Qp[P448_WIDTH];\0A\0A    if (N->n <= P448_WIDTH) {\0A        return 0;\0A    }\0A\0A    /* M = A1 */\0A    M.s = 1;\0A    M.n = N->n - (P448_WIDTH);\0A    if (M.n > P448_WIDTH) {\0A        /* Shouldn't be called with N larger than 2^896! */\0A        return MBEDTLS_ERR_ECP_BAD_INPUT_DATA;\0A    }\0A    M.p = Mp;\0A    memset(Mp, 0, sizeof(Mp));\0A    memcpy(Mp, N->p + P448_WIDTH, M.n * sizeof(mbedtls_mpi_uint));\0A\0A    /* N = A0 */\0A    for (i = P448_WIDTH; i < N->n; i++) {\0A        N->p[i] = 0;\0A    }\0A\0A    /* N += A1 */\0A    MBEDTLS_MPI_CHK(mbedtls_mpi_add_mpi(N, N, &M));\0A\0A    /* Q = B1, N += B1 */\0A    Q = M;\0A    Q.p = Qp;\0A    memcpy(Qp, Mp, sizeof(Qp));\0A    MBEDTLS_MPI_CHK(mbedtls_mpi_shift_r(&Q, 224));\0A    MBEDTLS_MPI_CHK(mbedtls_mpi_add_mpi(N, N, &Q));\0A\0A    /* M = (B0 + B1) * 2^224, N += M */\0A    if (sizeof(mbedtls_mpi_uint) > 4) {\0A        Mp[P224_WIDTH_MIN] &= ((mbedtls_mpi_uint)-1) >> (P224_UNUSED_BITS);\0A    }\0A    for (i = P224_WIDTH_MAX; i < M.n; ++i) {\0A        Mp[i] = 0;\0A    }\0A    MBEDTLS_MPI_CHK(mbedtls_mpi_add_mpi(&M, &M, &Q));\0A    M.n = P448_WIDTH + 1; /* Make room for shifted carry bit from the addition */\0A    MBEDTLS_MPI_CHK(mbedtls_mpi_shift_l(&M, 224));\0A    MBEDTLS_MPI_CHK(mbedtls_mpi_add_mpi(N, N, &M));\0A\0Acleanup:\0A    return ret;\0A}\0A#endif /* MBEDTLS_ECP_DP_CURVE448_ENABLED */\0A\0A#if defined(MBEDTLS_ECP_DP_SECP192K1_ENABLED) ||   \5C\0A    defined(MBEDTLS_ECP_DP_SECP224K1_ENABLED) ||   \5C\0A    defined(MBEDTLS_ECP_DP_SECP256K1_ENABLED)\0A/*\0A * Fast quasi-reduction modulo P = 2^s - R,\0A * with R about 33 bits, used by the Koblitz curves.\0A *\0A * Write N as A0 + 2^224 A1, return A0 + R * A1.\0A * Actually do two passes, since R is big.\0A */\0A#define P_KOBLITZ_MAX   (256 / 8 / sizeof(mbedtls_mpi_uint))      // Max limbs in P\0A#define P_KOBLITZ_R     (8 / sizeof(mbedtls_mpi_uint))            // Limbs in R\0Astatic inline int ecp_mod_koblitz(mbedtls_mpi *N, const mbedtls_mpi_uint *Rp, size_t p_limbs,\0A                                  size_t adjust, size_t shift, mbedtls_mpi_uint mask)\0A{\0A    int ret = MBEDTLS_ERR_ERROR_CORRUPTION_DETECTED;\0A    size_t i;\0A    mbedtls_mpi M, R;\0A    mbedtls_mpi_uint Mp[P_KOBLITZ_MAX + P_KOBLITZ_R + 1];\0A\0A    if (N->n < p_limbs) {\0A        return 0;\0A    }\0A\0A    /* Init R */\0A    R.s = 1;\0A    R.p = (mbedtls_mpi_uint *) Rp; /* R.p will not be modified so the cast is safe */\0A    R.n = P_KOBLITZ_R;\0A\0A    /* Common setup for M */\0A    M.s = 1;\0A    M.p = Mp;\0A\0A    /* M = A1 */\0A    M.n = (unsigned short) (N->n - (p_limbs - adjust));\0A    if (M.n > p_limbs + adjust) {\0A        M.n = (unsigned short) (p_limbs + adjust);\0A    }\0A    memset(Mp, 0, sizeof(Mp));\0A    memcpy(Mp, N->p + p_limbs - adjust, M.n * sizeof(mbedtls_mpi_uint));\0A    if (shift != 0) {\0A        MBEDTLS_MPI_CHK(mbedtls_mpi_shift_r(&M, shift));\0A    }\0A    M.n += R.n; /* Make room for multiplication by R */\0A\0A    /* N = A0 */\0A    if (mask != 0) {\0A        N->p[p_limbs - 1] &= mask;\0A    }\0A    for (i = p_limbs; i < N->n; i++) {\0A        N->p[i] = 0;\0A    }\0A\0A    /* N = A0 + R * A1 */\0A    MBEDTLS_MPI_CHK(mbedtls_mpi_mul_mpi(&M, &M, &R));\0A    MBEDTLS_MPI_CHK(mbedtls_mpi_add_abs(N, N, &M));\0A\0A    /* Second pass */\0A\0A    /* M = A1 */\0A    M.n = (unsigned short) (N->n - (p_limbs - adjust));\0A    if (M.n > p_limbs + adjust) {\0A        M.n = (unsigned short) (p_limbs + adjust);\0A    }\0A    memset(Mp, 0, sizeof(Mp));\0A    memcpy(Mp, N->p + p_limbs - adjust, M.n * sizeof(mbedtls_mpi_uint));\0A    if (shift != 0) {\0A        MBEDTLS_MPI_CHK(mbedtls_mpi_shift_r(&M, shift));\0A    }\0A    M.n += R.n; /* Make room for multiplication by R */\0A\0A    /* N = A0 */\0A    if (mask != 0) {\0A        N->p[p_limbs - 1] &= mask;\0A    }\0A    for (i = p_limbs; i < N->n; i++) {\0A        N->p[i] = 0;\0A    }\0A\0A    /* N = A0 + R * A1 */\0A    MBEDTLS_MPI_CHK(mbedtls_mpi_mul_mpi(&M, &M, &R));\0A    MBEDTLS_MPI_CHK(mbedtls_mpi_add_abs(N, N, &M));\0A\0Acleanup:\0A    return ret;\0A}\0A#endif /* MBEDTLS_ECP_DP_SECP192K1_ENABLED) ||\0A          MBEDTLS_ECP_DP_SECP224K1_ENABLED) ||\0A          MBEDTLS_ECP_DP_SECP256K1_ENABLED) */\0A\0A#if defined(MBEDTLS_ECP_DP_SECP192K1_ENABLED)\0A/*\0A * Fast quasi-reduction modulo p192k1 = 2^192 - R,\0A * with R = 2^32 + 2^12 + 2^8 + 2^7 + 2^6 + 2^3 + 1 = 0x01000011C9\0A */\0Astatic int ecp_mod_p192k1(mbedtls_mpi *N)\0A{\0A    static const mbedtls_mpi_uint Rp[] = {\0A        MBEDTLS_BYTES_TO_T_UINT_8(0xC9, 0x11, 0x00, 0x00, 0x01, 0x00, 0x00,\0A                                  0x00)\0A    };\0A\0A    return ecp_mod_koblitz(N, Rp, 192 / 8 / sizeof(mbedtls_mpi_uint), 0, 0,\0A                           0);\0A}\0A#endif /* MBEDTLS_ECP_DP_SECP192K1_ENABLED */\0A\0A#if defined(MBEDTLS_ECP_DP_SECP224K1_ENABLED)\0A/*\0A * Fast quasi-reduction modulo p224k1 = 2^224 - R,\0A * with R = 2^32 + 2^12 + 2^11 + 2^9 + 2^7 + 2^4 + 2 + 1 = 0x0100001A93\0A */\0Astatic int ecp_mod_p224k1(mbedtls_mpi *N)\0A{\0A    static const mbedtls_mpi_uint Rp[] = {\0A        MBEDTLS_BYTES_TO_T_UINT_8(0x93, 0x1A, 0x00, 0x00, 0x01, 0x00, 0x00,\0A                                  0x00)\0A    };\0A\0A#if defined(MBEDTLS_HAVE_INT64)\0A    return ecp_mod_koblitz(N, Rp, 4, 1, 32, 0xFFFFFFFF);\0A#else\0A    return ecp_mod_koblitz(N, Rp, 224 / 8 / sizeof(mbedtls_mpi_uint), 0, 0,\0A                           0);\0A#endif\0A}\0A\0A#endif /* MBEDTLS_ECP_DP_SECP224K1_ENABLED */\0A\0A#if defined(MBEDTLS_ECP_DP_SECP256K1_ENABLED)\0A/*\0A * Fast quasi-reduction modulo p256k1 = 2^256 - R,\0A * with R = 2^32 + 2^9 + 2^8 + 2^7 + 2^6 + 2^4 + 1 = 0x01000003D1\0A */\0Astatic int ecp_mod_p256k1(mbedtls_mpi *N)\0A{\0A    static const mbedtls_mpi_uint Rp[] = {\0A        MBEDTLS_BYTES_TO_T_UINT_8(0xD1, 0x03, 0x00, 0x00, 0x01, 0x00, 0x00,\0A                                  0x00)\0A    };\0A    return ecp_mod_koblitz(N, Rp, 256 / 8 / sizeof(mbedtls_mpi_uint), 0, 0,\0A                           0);\0A}\0A#endif /* MBEDTLS_ECP_DP_SECP256K1_ENABLED */\0A\0A#if defined(MBEDTLS_TEST_HOOKS)\0A\0AMBEDTLS_STATIC_TESTABLE\0Ambedtls_ecp_variant mbedtls_ecp_get_variant(void)\0A{\0A    return MBEDTLS_ECP_VARIANT_WITH_MPI_STRUCT;\0A}\0A\0A#endif /* MBEDTLS_TEST_HOOKS */\0A\0A#endif /* !MBEDTLS_ECP_ALT */\0A\0A#endif /* MBEDTLS_ECP_LIGHT */\0A#endif /* MBEDTLS_ECP_WITH_MPI_UINT */\0A\00" }
