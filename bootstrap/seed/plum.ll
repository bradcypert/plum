(iv_len != mbedtls_cipher_info_get_iv_size(ctx->cipher_info)) ||\0A            (tag_len != 16U)) {\0A            return MBEDTLS_ERR_CIPHER_BAD_INPUT_DATA;\0A        }\0A\0A        *olen = ilen;\0A        return mbedtls_chachapoly_encrypt_and_tag(ctx->cipher_ctx,\0A                                                  ilen, iv, ad, ad_len, input, output, tag);\0A    }\0A#endif /* MBEDTLS_CHACHAPOLY_C */\0A\0A    return MBEDTLS_ERR_CIPHER_FEATURE_UNAVAILABLE;\0A}\0A\0A/*\0A * Packet-oriented encryption for AEAD modes: internal function used by\0A * mbedtls_cipher_auth_encrypt_ext().\0A */\0Astatic int mbedtls_cipher_aead_decrypt(mbedtls_cipher_context_t *ctx,\0A                                       const unsigned char *iv, size_t iv_len,\0A                                       const unsigned char *ad, size_t ad_len,\0A                                       const unsigned char *input, size_t ilen,\0A                                       unsigned char *output, size_t *olen,\0A                                       const unsigned char *tag, size_t tag_len)\0A{\0A#if defined(MBEDTLS_USE_PSA_CRYPTO) && !defined(MBEDTLS_DEPRECATED_REMOVED)\0A    if (ctx->psa_enabled == 1) {\0A        /* As in the non-PSA case, we don't check that\0A         * a key has been set. If not, the key slot will\0A         * still be in its default state of 0, which is\0A         * guaranteed to be invalid, hence the PSA-call\0A         * below will gracefully fail. */\0A        mbedtls_cipher_context_psa * const cipher_psa =\0A            (mbedtls_cipher_context_psa *) ctx->cipher_ctx;\0A\0A        psa_status_t status;\0A\0A        /* PSA Crypto API always writes the authentication tag\0A         * at the end of the encrypted message. */\0A        if (input == NULL || tag != input + ilen) {\0A            return MBEDTLS_ERR_CIPHER_FEATURE_UNAVAILABLE;\0A        }\0A\0A        status = psa_aead_decrypt(cipher_psa->slot,\0A                                  cipher_psa->alg,\0A                                  iv, iv_len,\0A                                  ad, ad_len,\0A                                  input, ilen + tag_len,\0A                                  output, ilen, olen);\0A        if (status == PSA_ERROR_INVALID_SIGNATURE) {\0A            return MBEDTLS_ERR_CIPHER_AUTH_FAILED;\0A        } else if (status != PSA_SUCCESS) {\0A            return MBEDTLS_ERR_PLATFORM_HW_ACCEL_FAILED;\0A        }\0A\0A        return 0;\0A    }\0A#endif /* MBEDTLS_USE_PSA_CRYPTO && !MBEDTLS_DEPRECATED_REMOVED */\0A\0A#if defined(MBEDTLS_GCM_C)\0A    if (MBEDTLS_MODE_GCM == ((mbedtls_cipher_mode_t) ctx->cipher_info->mode)) {\0A        int ret = MBEDTLS_ERR_ERROR_CORRUPTION_DETECTED;\0A\0A        *olen = ilen;\0A        ret = mbedtls_gcm_auth_decrypt(ctx->cipher_ctx, ilen,\0A                                       iv, iv_len, ad, ad_len,\0A                                       tag, tag_len, input, output);\0A\0A        if (ret == MBEDTLS_ERR_GCM_AUTH_FAILED) {\0A            ret = MBEDTLS_ERR_CIPHER_AUTH_FAILED;\0A        }\0A\0A        return ret;\0A    }\0A#endif /* MBEDTLS_GCM_C */\0A#if defined(MBEDTLS_CCM_C)\0A    if (MBEDTLS_MODE_CCM == ((mbedtls_cipher_mode_t) ctx->cipher_info->mode)) {\0A        int ret = MBEDTLS_ERR_ERROR_CORRUPTION_DETECTED;\0A\0A        *olen = ilen;\0A        ret = mbedtls_ccm_auth_decrypt(ctx->cipher_ctx, ilen,\0A                                       iv, iv_len, ad, ad_len,\0A                                       input, output, tag, tag_len);\0A\0A        if (ret == MBEDTLS_ERR_CCM_AUTH_FAILED) {\0A            ret = MBEDTLS_ERR_CIPHER_AUTH_FAILED;\0A        }\0A\0A        return ret;\0A    }\0A#endif /* MBEDTLS_CCM_C */\0A#if defined(MBEDTLS_CHACHAPOLY_C)\0A    if (MBEDTLS_CIPHER_CHACHA20_POLY1305 == ((mbedtls_cipher_type_t) ctx->cipher_info->type)) {\0A        int ret = MBEDTLS_ERR_ERROR_CORRUPTION_DETECTED;\0A\0A        /* ChachaPoly has fixed length nonce and MAC (tag) */\0A        if ((iv_len != mbedtls_cipher_info_get_iv_size(ctx->cipher_info)) ||\0A            (tag_len != 16U)) {\0A            return MBEDTLS_ERR_CIPHER_BAD_INPUT_DATA;\0A        }\0A\0A        *olen = ilen;\0A        ret = mbedtls_chachapoly_auth_decrypt(ctx->cipher_ctx, ilen,\0A                                              iv, ad, ad_len, tag, input, output);\0A\0A        if (ret == MBEDTLS_ERR_CHACHAPOLY_AUTH_FAILED) {\0A            ret = MBEDTLS_ERR_CIPHER_AUTH_FAILED;\0A        }\0A\0A        return ret;\0A    }\0A#endif /* MBEDTLS_CHACHAPOLY_C */\0A\0A    return MBEDTLS_ERR_CIPHER_FEATURE_UNAVAILABLE;\0A}\0A#endif /* MBEDTLS_CIPHER_MODE_AEAD */\0A\0A#if defined(MBEDTLS_CIPHER_MODE_AEAD) || defined(MBEDTLS_NIST_KW_C)\0A/*\0A * Packet-oriented encryption for AEAD/NIST_KW: public function.\0A */\0Aint mbedtls_cipher_auth_encrypt_ext(mbedtls_cipher_context_t *ctx,\0A                                    const unsigned char *iv, size_t iv_len,\0A                                    const unsigned char *ad, size_t ad_len,\0A                                    const unsigned char *input, size_t ilen,\0A                                    unsigned char *output, size_t output_len,\0A                                    size_t *olen, size_t tag_len)\0A{\0A#if defined(MBEDTLS_NIST_KW_C)\0A    if (\0A#if defined(MBEDTLS_USE_PSA_CRYPTO) && !defined(MBEDTLS_DEPRECATED_REMOVED)\0A        ctx->psa_enabled == 0 &&\0A#endif\0A        (MBEDTLS_MODE_KW == ((mbedtls_cipher_mode_t) ctx->cipher_info->mode) ||\0A         MBEDTLS_MODE_KWP == ((mbedtls_cipher_mode_t) ctx->cipher_info->mode))) {\0A        mbedtls_nist_kw_mode_t mode =\0A            (MBEDTLS_MODE_KW == ((mbedtls_cipher_mode_t) ctx->cipher_info->mode)) ?\0A            MBEDTLS_KW_MODE_KW : MBEDTLS_KW_MODE_KWP;\0A\0A        /* There is no iv, tag or ad associated with KW and KWP,\0A         * so these length should be 0 as documented. */\0A        if (iv_len != 0 || tag_len != 0 || ad_len != 0) {\0A            return MBEDTLS_ERR_CIPHER_BAD_INPUT_DATA;\0A        }\0A\0A        (void) iv;\0A        (