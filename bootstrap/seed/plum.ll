@.str62466 = private global { i64, i64, [29096 x i8] } { i64 -1, i64 29095, [29096 x i8] c"/// Filesystem and self-location. These replaced shelling out to\0A/// `mktemp -d`, `rm -rf`, `rm -f`, `cp -r` and `mkdir`, and reading\0A/// `/proc/self/exe`. See `native_stdlib/os_shim.c`.\0A///\0A/// The `..._raw` forms are runtime primitives whose Plum bodies\0A/// exist only to give the checker a signature. They travel with the\0A/// module: `cg_runtime_fn` keys on the bare name and does not care\0A/// which module the call was written in.\0Alet os_temp_dir_raw (ignored: Bool): String = \22\22\0Alet os_self_exe_raw (ignored: Bool): String = \22\22\0Alet os_make_dir_raw (path: String): Int = 0\0Alet os_remove_file_raw (path: String): Int = 0\0Alet os_rename_file_raw (from: String) (to: String): Int = 0\0Alet os_remove_tree_raw (path: String): Int = 0\0Alet os_copy_tree_raw (src: String) (dst: String): Int = 0\0Alet os_platform_raw (ignored: Bool): String = \22\22\0Aextern \22C\22 { fn plum_tree_last_error() -> CStr; }\0A\0A/// Which platform this program is running on: \22linux\22, \22macos\22 or\0A/// \22windows\22. Compiled in, not detected at runtime; a binary\0A/// cannot move between platforms, so there is nothing to detect.\0Apub let platform (): String = os_platform_raw(true)\0A\0A/// A fresh, empty, private directory. The caller owns it and is\0A/// responsible for `Os.remove_tree` on it.\0Apub let temp_dir (): Result[String, String] = {\0A    let d = os_temp_dir_raw(true);\0A    if String.is_empty(d) { Err(\22Os.temp_dir: could not create a temporary directory\22) }\0A    else { Ok(d) }\0A}\0A\0A/// The path of the running executable, for a program that needs to\0A/// re-invoke itself.\0Apub let self_exe (): Result[String, String] = {\0A    let p = os_self_exe_raw(true);\0A    if String.is_empty(p) { Err(\22Os.self_exe: could not determine the executable path\22) }\0A    else { Ok(p) }\0A}\0A\0A/// Creates one directory. The PARENT must already exist; this makes a