@.str40745 = private global { i64, i64, [18976 x i8] } { i64 -1, i64 18975, [18976 x i8] c"/*\0A *  HMAC_DRBG implementation (NIST SP 800-90)\0A *\0A *  Copyright The Mbed TLS Contributors\0A *  SPDX-License-Identifier: Apache-2.0 OR GPL-2.0-or-later\0A */\0A\0A/*\0A *  The NIST SP 800-90A DRBGs are described in the following publication.\0A *  http://csrc.nist.gov/publications/nistpubs/800-90A/SP800-90A.pdf\0A *  References below are based on rev. 1 (January 2012).\0A */\0A\0A#include \22common.h\22\0A\0A#if defined(MBEDTLS_HMAC_DRBG_C)\0A\0A#include \22mbedtls/hmac_drbg.h\22\0A#include \22mbedtls/platform_util.h\22\0A#include \22mbedtls/error.h\22\0A\0A#include <string.h>\0A\0A#if defined(MBEDTLS_FS_IO)\0A#include <stdio.h>\0A#endif\0A\0A#include \22mbedtls/platform.h\22\0A\0A/*\0A * HMAC_DRBG context initialization\0A */\0Avoid mbedtls_hmac_drbg_init(mbedtls_hmac_drbg_context *ctx)\0A{\0A    memset(ctx, 0, sizeof(mbedtls_hmac_drbg_context));\0A\0A    ctx->reseed_interval = MBEDTLS_HMAC_DRBG_RESEED_INTERVAL;\0A}\0A\0A/*\0A * HMAC_DRBG update, using optional additional data (10.1.2.2)\0A */\0Aint mbedtls_hmac_drbg_update(mbedtls_hmac_drbg_context *ctx,\0A                             const unsigned char *additional,\0A                             size_t add_len)\0A{\0A    size_t md_len = mbedtls_md_get_size(ctx->md_ctx.md_info);\0A    unsigned char rounds = (additional != NULL && add_len != 0) ? 2 : 1;\0A    unsigned char sep[1];\0A    unsigned char K[MBEDTLS_MD_MAX_SIZE];\0A    int ret = MBEDTLS_ERR_MD_BAD_INPUT_DATA;\0A\0A    for (sep[0] = 0; sep[0] < rounds; sep[0]++) {\0A        /* Step 1 or 4 */\0A        if ((ret = mbedtls_md_hmac_reset(&ctx->md_ctx)) != 0) {\0A            goto exit;\0A        }\0A        if ((ret = mbedtls_md_hmac_update(&ctx->md_ctx,\0A                                          ctx->V, md_len)) != 0) {\0A            goto exit;\0A        }\0A        if ((ret = mbedtls_md_hmac_update(&ctx->md_ctx,\0A                                          sep, 1)) != 0) {\0A            goto exit;\0A        }\0A        if (rounds == 2) {\0A            if ((ret = mbedtls_md_hmac_update(&ctx->md_ctx,\0A                                              additional, add_len)) != 0) {\0A                goto exit;\0A            }\0A        }\0A        if ((ret = mbedtls_md_hmac_finish(&ctx->md_ctx, K)) != 0) {\0A            goto exit;\0A        }\0A\0A        /* Step 2 or 5 */\0A        if ((ret = mbedtls_md_hmac_starts(&ctx->md_ctx, K, md_len)) != 0) {\0A            goto exit;\0A        }\0A        if ((ret = mbedtls_md_hmac_update(&ctx->md_ctx,\0A                                          ctx->V, md_len)) != 0) {\0A            goto exit;\0A        }\0A        if ((ret = mbedtls_md_hmac_finish(&ctx->md_ctx, ctx->V)) != 0) {\0A            goto exit;\0A        }\0A    }\0A\0Aexit:\0A    mbedtls_platform_zeroize(K, sizeof(K));\0A    return ret;\0A}\0A\0A/*\0A * Simplified HMAC_DRBG initialisation (for use with deterministic ECDSA)\0A */\0Aint mbedtls_hmac_drbg_seed_buf(mbedtls_hmac_drbg_context *ctx,\0A                               const mbedtls_md_info_t *md_info,\0A                               const unsigned char *data, size_t data_len)\0A{\0A    int ret = MBEDTLS_ERR_ERROR_CORRUPTION_DETECTED;\0A\0A    if ((ret = mbedtls_md_setup(&ctx->md_ctx, md_info, 1)) != 0) {\0A        return ret;\0A    }\0A\0A#if defined(MBEDTLS_THREADING_C)\0A    mbedtls_mutex_init(&ctx->mutex);\0A#endif\0A\0A    /*\0A     * Set initial working state.\0A     * Use the V memory location, which is currently all 0, to initialize the\0A     * MD context with an all-zero key. Then set V to its initial value.\0A     */\0A    if ((ret = mbedtls_md_hmac_starts(&ctx->md_ctx, ctx->V,\0A                                      mbedtls_md_get_size(md_info))) != 0) {\0A        return ret;\0A    }\0A    memset(ctx->V, 0x01, mbedtls_md_get_size(md_info));\0A\0A    if ((ret = mbedtls_hmac_drbg_update(ctx, data, data_len)) != 0) {\0A        return ret;\0A    }\0A\0A    return 0;\0A}\0A\0A/*\0A * Internal function used both for seeding and reseeding the DRBG.\0A * Comments starting with arabic numbers refer to section 10.1.2.4\0A * of SP800-90A, while roman numbers refer to section 9.2.\0A */\0Astatic int hmac_drbg_reseed_core(mbedtls_hmac_drbg_context *ctx,\0A                                 const unsigned char *additional, size_t len,\0A                                 int use_nonce)\0A{\0A    unsigned char seed[MBEDTLS_HMAC_DRBG_MAX_SEED_INPUT];\0A    size_t seedlen = 0;\0A    int ret = MBEDTLS_ERR_ERROR_CORRUPTION_DETECTED;\0A\0A    {\0A        size_t total_entropy_len;\0A\0A        if (use_nonce == 0) {\0A            total_entropy_len = ctx->entropy_len;\0A        } else {\0A            total_entropy_len = ctx->entropy_len * 3 / 2;\0A        }\0A\0A        /* III. Check input length */\0A        if (len > MBEDTLS_HMAC_DRBG_MAX_INPUT ||\0A            total_entropy_len + len > MBEDTLS_HMAC_DRBG_MAX_SEED_INPUT) {\0A            return MBEDTLS_ERR_HMAC_DRBG_INPUT_TOO_BIG;\0A        }\0A    }\0A\0A    memset(seed, 0, MBEDTLS_HMAC_DRBG_MAX_SEED_INPUT);\0A\0A    /* IV. Gather entropy_len bytes of entropy for the seed */\0A    if ((ret = ctx->f_entropy(ctx->p_entropy,\0A                              seed, ctx->entropy_len)) != 0) {\0A        return MBEDTLS_ERR_HMAC_DRBG_ENTROPY_SOURCE_FAILED;\0A    }\0A    seedlen += ctx->entropy_len;\0A\0A    /* For initial seeding, allow adding of nonce generated\0A     * from the entropy source. See Sect 8.6.7 in SP800-90A. */\0A    if (use_nonce) {\0A        /* Note: We don't merge the two calls to f_entropy() in order\0A         *       to avoid requesting too much entropy from f_entropy()\0A         *       at once. Specifically, if the underlying digest is not\0A         *       SHA-1, 3 / 2 * entropy_len is at least 36 Bytes, which\0A         *       is larger than the maximum of 32 Bytes that our own\0A         *       entropy source implementation can emit in a single\0A         *       call in configurations disabling SHA-512. */\0A        if ((ret = ctx->f_entropy(ctx->p_entropy,\0A                                  seed + seedlen,\0A                                  ctx->entropy_len / 2)) != 0) {\0A            return MBEDTLS_ERR_HMAC_DRBG_ENTROPY_SOURCE_FAILED;\0A        }\0A\0A        seedlen += ctx->entropy_len / 2;\0A    }\0A\0A\0A    /* 1. Concatenate entropy and additional data if any */\0A    if (additional != NULL && len != 0) {\0A        memcpy(seed + seedlen, additional, len);\0A        seedlen += len;\0A    }\0A\0A    /* 2. Update state */\0A    if ((ret = mbedtls_hmac_drbg_update(ctx, seed, seedlen)) != 0) {\0A        goto exit;\0A    }\0A\0A    /* 3. Reset reseed_counter */\0A    ctx->reseed_counter = 1;\0A\0Aexit:\0A    /* 4. Done */\0A    mbedtls_platform_zeroize(seed, seedlen);\0A    return ret;\0A}\0A\0A/*\0A * HMAC_DRBG reseeding: 10.1.2.4 + 9.2\0A */\0Aint mbedtls_hmac_drbg_reseed(mbedtls_hmac_drbg_context *ctx,\0A                             const unsigned char *additional, size_t len)\0A{\0A    return hmac_drbg_reseed_core(ctx, additional, len, 0);\0A}\0A\0A/*\0A * HMAC_DRBG initialisation (10.1.2.3 + 9.1)\0A *\0A * The nonce is not passed as a separate parameter but extracted\0A * from the entropy source as suggested in 8.6.7.\0A */\0Aint mbedtls_hmac_drbg_seed(mbedtls_hmac_drbg_context *ctx,\0A                           const mbedtls_md_info_t *md_info,\0A                           int (*f_entropy)(void *, unsigned char *, size_t),\0A                           void *p_entropy,\0A                           const unsigned char *custom,\0A                           size_t len)\0A{\0A    int ret = MBEDTLS_ERR_ERROR_CORRUPTION_DETECTED;\0A    size_t md_size;\0A\0A    if ((ret = mbedtls_md_setup(&ctx->md_ctx, md_info, 1)) != 0) {\0A        return ret;\0A    }\0A\0A    /* The mutex is initialized iff the md context is set up. */\0A#if defined(MBEDTLS_THREADING_C)\0A    mbedtls_mutex_init(&ctx->mutex);\0A#endif\0A\0A    md_size = mbedtls_md_get_size(md_info);\0A\0A    /*\0A     * Set initial working state.\0A     * Use the V memory location, which is currently all 0, to initialize the\0A     * MD context with an all-zero key. Then set V to its initial value.\0A     */\0A    if ((ret = mbedtls_md_hmac_starts(&ctx->md_ctx, ctx->V, md_size)) != 0) {\0A        return ret;\0A    }\0A    memset(ctx->V, 0x01, md_size);\0A\0A    ctx->f_entropy = f_entropy;\0A    ctx->p_entropy = p_entropy;\0A\0A    if (ctx->entropy_len == 0) {\0A        /*\0A         * See SP800-57 5.6.1 (p. 65-66) for the security strength provided by\0A         * each hash function, then according to SP800-90A rev1 10.1 table 2,\0A         * min_entropy_len (in bits) is security_strength.\0A         *\0A         * (This also matches the sizes used in the NIST test vectors.)\0A         */\0A        ctx->entropy_len = md_size <= 20 ? 16 : /* 160-bits hash -> 128 bits */\0A                           md_size <= 28 ? 24 : /* 224-bits hash -> 192 bits */\0A                           32;  /* better (256+) -> 256 bits */\0A    }\0A\0A    if ((ret = hmac_drbg_reseed_core(ctx, custom, len,\0A                                     1 /* add nonce */)) != 0) {\0A        return ret;\0A    }\0A\0A    return 0;\0A}\0A\0A/*\0A * Set prediction resistance\0A */\0Avoid mbedtls_hmac_drbg_set_prediction_resistance(mbedtls_hmac_drbg_context *ctx,\0A                                                 int resistance)\0A{\0A    ctx->prediction_resistance = resistance;\0A}\0A\0A/*\0A * Set entropy length grabbed for seeding\0A */\0Avoid mbedtls_hmac_drbg_set_entropy_len(mbedtls_hmac_drbg_context *ctx, size_t len)\0A{\0A    ctx->entropy_len = len;\0A}\0A\0A/*\0A * Set reseed interval\0A */\0Avoid mbedtls_hmac_drbg_set_reseed_interval(mbedtls_hmac_drbg_context *ctx, int interval)\0A{\0A    ctx->reseed_interval = interval;\0A}\0A\0A/*\0A * HMAC_DRBG random function with optional additional data:\0A * 10.1.2.5 (arabic) + 9.3 (Roman)\0A */\0Aint mbedtls_hmac_drbg_random_with_add(void *p_rng,\0A                                      unsigned char *output, size_t out_len,\0A                                      const unsigned char *additional, size_t add_len)\0A{\0A    int ret = MBEDTLS_ERR_ERROR_CORRUPTION_DETECTED;\0A    mbedtls_hmac_drbg_context *ctx = (mbedtls_hmac_drbg_context *) p_rng;\0A    size_t md_len = mbedtls_md_get_size(ctx->md_ctx.md_info);\0A    size_t left = out_len;\0A    unsigned char *out = output;\0A\0A    /* II. Check request length */\0A    if (out_len > MBEDTLS_HMAC_DRBG_MAX_REQUEST) {\0A        return MBEDTLS_ERR_HMAC_DRBG_REQUEST_TOO_BIG;\0A    }\0A\0A    /* III. Check input length */\0A    if (add_len > MBEDTLS_HMAC_DRBG_MAX_INPUT) {\0A        return MBEDTLS_ERR_HMAC_DRBG_INPUT_TOO_BIG;\0A    }\0A\0A    /* 1. (aka VII and IX) Check reseed counter and PR */\0A    if (ctx->f_entropy != NULL && /* For no-reseeding instances */\0A        (ctx->prediction_resistance == MBEDTLS_HMAC_DRBG_PR_ON ||\0A         ctx->reseed_counter > ctx->reseed_interval)) {\0A        if ((ret = mbedtls_hmac_drbg_reseed(ctx, additional, add_len)) != 0) {\0A            return ret;\0A        }\0A\0A        add_len = 0; /* VII.4 */\0A    }\0A\0A    /* 2. Use additional data if any */\0A    if (additional != NULL && add_len != 0) {\0A        if ((ret = mbedtls_hmac_drbg_update(ctx,\0A                                            additional, add_len)) != 0) {\0A            goto exit;\0A        }\0A    }\0A\0A    /* 3, 4, 5. Generate bytes */\0A    while (left != 0) {\0A        size_t use_len = left > md_len ? md_len : left;\0A\0A        if ((ret = mbedtls_md_hmac_reset(&ctx->md_ctx)) != 0) {\0A            goto exit;\0A        }\0A        if ((ret = mbedtls_md_hmac_update(&ctx->md_ctx,\0A                                          ctx->V, md_len)) != 0) {\0A            goto exit;\0A        }\0A        if ((ret = mbedtls_md_hmac_finish(&ctx->md_ctx, ctx->V)) != 0) {\0A            goto exit;\0A        }\0A\0A        memcpy(out, ctx->V, use_len);\0A        out += use_len;\0A        left -= use_len;\0A    }\0A\0A    /* 6. Update */\0A    if ((ret = mbedtls_hmac_drbg_update(ctx,\0A                                        additional, add_len)) != 0) {\0A        goto exit;\0A    }\0A\0A    /* 7. Update reseed counter */\0A    ctx->reseed_counter++;\0A\0Aexit:\0A    /* 8. Done */\0A    return ret;\0A}\0A\0A/*\0A * HMAC_DRBG random function\0A */\0Aint mbedtls_hmac_drbg_random(void *p_rng, unsigned char *output, size_t out_len)\0A{\0A    int ret = MBEDTLS_ERR_ERROR_CORRUPTION_DETECTED;\0A    mbedtls_hmac_drbg_context *ctx = (mbedtls_hmac_drbg_context *) p_rng;\0A\0A#if defined(MBEDTLS_THREADING_C)\0A    if ((ret = mbedtls_mutex_lock(&ctx->mutex)) != 0) {\0A        return ret;\0A    }\0A#endif\0A\0A    ret = mbedtls_hmac_drbg_random_with_add(ctx, output, out_len, NULL, 0);\0A\0A#if defined(MBEDTLS_THREADING_C)\0A    if (mbedtls_mutex_unlock(&ctx->mutex) != 0) {\0A        return MBEDTLS_ERR_THREADING_MUTEX_ERROR;\0A    }\0A#endif\0A\0A    return ret;\0A}\0A\0A/*\0A *  This function resets HMAC_DRBG context to the state immediately\0A *  after initial call of mbedtls_hmac_drbg_init().\0A */\0Avoid mbedtls_hmac_drbg_free(mbedtls_hmac_drbg_context *ctx)\0A{\0A    if (ctx == NULL) {\0A        return;\0A    }\0A\0A#if defined(MBEDTLS_THREADING_C)\0A    /* The mutex is initialized iff the md context is set up. */\0A    if (ctx->md_ctx.md_info != NULL) {\0A        mbedtls_mutex_free(&ctx->mutex);\0A    }\0A#endif\0A    mbedtls_md_free(&ctx->md_ctx);\0A    mbedtls_platform_zeroize(ctx, sizeof(mbedtls_hmac_drbg_context));\0A    ctx->reseed_interval = MBEDTLS_HMAC_DRBG_RESEED_INTERVAL;\0A}\0A\0A#if defined(MBEDTLS_FS_IO)\0Aint mbedtls_hmac_drbg_write_seed_file(mbedtls_hmac_drbg_context *ctx, const char *path)\0A{\0A    int ret = MBEDTLS_ERR_ERROR_CORRUPTION_DETECTED;\0A    FILE *f;\0A    unsigned char buf[MBEDTLS_HMAC_DRBG_MAX_INPUT];\0A\0A    if ((f = fopen(path, \22wb\22)) == NULL) {\0A        return MBEDTLS_ERR_HMAC_DRBG_FILE_IO_ERROR;\0A    }\0A\0A    /* Ensure no stdio buffering of secrets, as such buffers cannot be wiped. */\0A    mbedtls_setbuf(f, NULL);\0A\0A    if ((ret = mbedtls_hmac_drbg_random(ctx, buf, sizeof(buf))) != 0) {\0A        goto exit;\0A    }\0A\0A    if (fwrite(buf, 1, sizeof(buf), f) != sizeof(buf)) {\0A        ret = MBEDTLS_ERR_HMAC_DRBG_FILE_IO_ERROR;\0A        goto exit;\0A    }\0A\0A    ret = 0;\0A\0Aexit:\0A    fclose(f);\0A    mbedtls_platform_zeroize(buf, sizeof(buf));\0A\0A    return ret;\0A}\0A\0Aint mbedtls_hmac_drbg_update_seed_file(mbedtls_hmac_drbg_context *ctx, const char *path)\0A{\0A    int ret = 0;\0A    FILE *f = NULL;\0A    size_t n;\0A    unsigned char buf[MBEDTLS_HMAC_DRBG_MAX_INPUT];\0A    unsigned char c;\0A\0A    if ((f = fopen(path, \22rb\22)) == NULL) {\0A        return MBEDTLS_ERR_HMAC_DRBG_FILE_IO_ERROR;\0A    }\0A\0A    /* Ensure no stdio buffering of secrets, as such buffers cannot be wiped. */\0A    mbedtls_setbuf(f, NULL);\0A\0A    n = fread(buf, 1, sizeof(buf), f);\0A    if (fread(&c, 1, 1, f) != 0) {\0A        ret = MBEDTLS_ERR_HMAC_DRBG_INPUT_TOO_BIG;\0A        goto exit;\0A    }\0A    if (n == 0 || ferror(f)) {\0A        ret = MBEDTLS_ERR_HMAC_DRBG_FILE_IO_ERROR;\0A        goto exit;\0A    }\0A    fclose(f);\0A    f = NULL;\0A\0A    ret = mbedtls_hmac_drbg_update(ctx, buf, n);\0A\0Aexit:\0A    mbedtls_platform_zeroize(buf, sizeof(buf));\0A    if (f != NULL) {\0A        fclose(f);\0A    }\0A    if (ret != 0) {\0A        return ret;\0A    }\0A    return mbedtls_hmac_drbg_write_seed_file(ctx, path);\0A}\0A#endif /* MBEDTLS_FS_IO */\0A\0A\0A#if defined(MBEDTLS_SELF_TEST)\0A\0A#if !defined(MBEDTLS_MD_CAN_SHA1)\0A/* Dummy checkup routine */\0Aint mbedtls_hmac_drbg_self_test(int verbose)\0A{\0A    (void) verbose;\0A    return 0;\0A}\0A#else\0A\0A#define OUTPUT_LEN  80\0A\0A/* From a NIST PR=true test vector */\0Astatic const unsigned char entropy_pr[] = {\0A    0xa0, 0xc9, 0xab, 0x58, 0xf1, 0xe2, 0xe5, 0xa4, 0xde, 0x3e, 0xbd, 0x4f,\0A    0xf7, 0x3e, 0x9c, 0x5b, 0x64, 0xef, 0xd8, 0xca, 0x02, 0x8c, 0xf8, 0x11,\0A    0x48, 0xa5, 0x84, 0xfe, 0x69, 0xab, 0x5a, 0xee, 0x42, 0xaa, 0x4d, 0x42,\0A    0x17, 0x60, 0x99, 0xd4, 0x5e, 0x13, 0x97, 0xdc, 0x40, 0x4d, 0x86, 0xa3,\0A    0x7b, 0xf5, 0x59, 0x54, 0x75, 0x69, 0x51, 0xe4\0A};\0Astatic const unsigned char result_pr[OUTPUT_LEN] = {\0A    0x9a, 0x00, 0xa2, 0xd0, 0x0e, 0xd5, 0x9b, 0xfe, 0x31, 0xec, 0xb1, 0x39,\0A    0x9b, 0x60, 0x81, 0x48, 0xd1, 0x96, 0x9d, 0x25, 0x0d, 0x3c, 0x1e, 0x94,\0A    0x10, 0x10, 0x98, 0x12, 0x93, 0x25, 0xca, 0xb8, 0xfc, 0xcc, 0x2d, 0x54,\0A    0x73, 0x19, 0x70, 0xc0, 0x10, 0x7a, 0xa4, 0x89, 0x25, 0x19, 0x95, 0x5e,\0A    0x4b, 0xc6, 0x00, 0x1d, 0x7f, 0x4e, 0x6a, 0x2b, 0xf8, 0xa3, 0x01, 0xab,\0A    0x46, 0x05, 0x5c, 0x09, 0xa6, 0x71, 0x88, 0xf1, 0xa7, 0x40, 0xee, 0xf3,\0A    0xe1, 0x5c, 0x02, 0x9b, 0x44, 0xaf, 0x03, 0x44\0A};\0A\0A/* From a NIST PR=false test vector */\0Astatic const unsigned char entropy_nopr[] = {\0A    0x79, 0x34, 0x9b, 0xbf, 0x7c, 0xdd, 0xa5, 0x79, 0x95, 0x57, 0x86, 0x66,\0A    0x21, 0xc9, 0x13, 0x83, 0x11, 0x46, 0x73, 0x3a, 0xbf, 0x8c, 0x35, 0xc8,\0A    0xc7, 0x21, 0x5b, 0x5b, 0x96, 0xc4, 0x8e, 0x9b, 0x33, 0x8c, 0x74, 0xe3,\0A    0xe9, 0x9d, 0xfe, 0xdf\0A};\0Astatic const unsigned char result_nopr[OUTPUT_LEN] = {\0A    0xc6, 0xa1, 0x6a, 0xb8, 0xd4, 0x20, 0x70, 0x6f, 0x0f, 0x34, 0xab, 0x7f,\0A    0xec, 0x5a, 0xdc, 0xa9, 0xd8, 0xca, 0x3a, 0x13, 0x3e, 0x15, 0x9c, 0xa6,\0A    0xac, 0x43, 0xc6, 0xf8, 0xa2, 0xbe, 0x22, 0x83, 0x4a, 0x4c, 0x0a, 0x0a,\0A    0xff, 0xb1, 0x0d, 0x71, 0x94, 0xf1, 0xc1, 0xa5, 0xcf, 0x73, 0x22, 0xec,\0A    0x1a, 0xe0, 0x96, 0x4e, 0xd4, 0xbf, 0x12, 0x27, 0x46, 0xe0, 0x87, 0xfd,\0A    0xb5, 0xb3, 0xe9, 0x1b, 0x34, 0x93, 0xd5, 0xbb, 0x98, 0xfa, 0xed, 0x49,\0A    0xe8, 0x5f, 0x13, 0x0f, 0xc8, 0xa4, 0x59, 0xb7\0A};\0A\0A/* \22Entropy\22 from buffer */\0Astatic size_t test_offset;\0Astatic int hmac_drbg_self_test_entropy(void *data,\0A                                       unsigned char *buf, size_t len)\0A{\0A    const unsigned char *p = data;\0A    memcpy(buf, p + test_offset, len);\0A    test_offset += len;\0A    return 0;\0A}\0A\0A#define CHK(c)    if ((c) != 0)                          \5C\0A    {                                       \5C\0A        if (verbose != 0)                  \5C\0A        mbedtls_printf(\22failed\5Cn\22);  \5C\0A        return 1;                        \5C\0A    }\0A\0A/*\0A * Checkup routine for HMAC_DRBG with SHA-1\0A */\0Aint mbedtls_hmac_drbg_self_test(int verbose)\0A{\0A    mbedtls_hmac_drbg_context ctx;\0A    unsigned char buf[OUTPUT_LEN];\0A    const mbedtls_md_info_t *md_info = mbedtls_md_info_from_type(MBEDTLS_MD_SHA1);\0A\0A    mbedtls_hmac_drbg_init(&ctx);\0A\0A    /*\0A     * PR = True\0A     */\0A    if (verbose != 0) {\0A        mbedtls_printf(\22  HMAC_DRBG (PR = True) : \22);\0A    }\0A\0A    test_offset = 0;\0A    CHK(mbedtls_hmac_drbg_seed(&ctx, md_info,\0A                               hmac_drbg_self_test_entropy, (void *) entropy_pr,\0A                               NULL, 0));\0A    mbedtls_hmac_drbg_set_prediction_resistance(&ctx, MBEDTLS_HMAC_DRBG_PR_ON);\0A    CHK(mbedtls_hmac_drbg_random(&ctx, buf, OUTPUT_LEN));\0A    CHK(mbedtls_hmac_drbg_random(&ctx, buf, OUTPUT_LEN));\0A    CHK(memcmp(buf, result_pr, OUTPUT_LEN));\0A    mbedtls_hmac_drbg_free(&ctx);\0A\0A    mbedtls_hmac_drbg_free(&ctx);\0A\0A    if (verbose != 0) {\0A        mbedtls_printf(\22passed\5Cn\22);\0A    }\0A\0A    /*\0A     * PR = False\0A     */\0A    if (verbose != 0) {\0A        mbedtls_printf(\22  HMAC_DRBG (PR = False) : \22);\0A    }\0A\0A    mbedtls_hmac_drbg_init(&ctx);\0A\0A    test_offset = 0;\0A    CHK(mbedtls_hmac_drbg_seed(&ctx, md_info,\0A                               hmac_drbg_self_test_entropy, (void *) entropy_nopr,\0A                               NULL, 0));\0A    CHK(mbedtls_hmac_drbg_reseed(&ctx, NULL, 0));\0A    CHK(mbedtls_hmac_drbg_random(&ctx, buf, OUTPUT_LEN));\0A    CHK(mbedtls_hmac_drbg_random(&ctx, buf, OUTPUT_LEN));\0A    CHK(memcmp(buf, result_nopr, OUTPUT_LEN));\0A    mbedtls_hmac_drbg_free(&ctx);\0A\0A    mbedtls_hmac_drbg_free(&ctx);\0A\0A    if (verbose != 0) {\0A        mbedtls_printf(\22passed\5Cn\22);\0A    }\0A\0A    if (verbose != 0) {\0A        mbedtls_printf(\22\5Cn\22);\0A    }\0A\0A    return 0;\0A}\0A#endif /* MBEDTLS_MD_CAN_SHA1 */\0A#endif /* MBEDTLS_SELF_TEST */\0A\0A#endif /* MBEDTLS_HMAC_DRBG_C */\0A\00" }
