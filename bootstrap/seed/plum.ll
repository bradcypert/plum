@.str40950 = private global { i64, i64, [44877 x i8] } { i64 -1, i64 44876, [44877 x i8] c"/*\0A *  PSA crypto core internal interfaces\0A */\0A/*\0A *  Copyright The Mbed TLS Contributors\0A *  SPDX-License-Identifier: Apache-2.0 OR GPL-2.0-or-later\0A */\0A\0A#ifndef PSA_CRYPTO_CORE_H\0A#define PSA_CRYPTO_CORE_H\0A\0A/*\0A * Include the build-time configuration information header. Here, we do not\0A * include `\22mbedtls/build_info.h\22` directly but `\22psa/build_info.h\22`, which\0A * is basically just an alias to it. This is to ease the maintenance of the\0A * TF-PSA-Crypto repository which has a different build system and\0A * configuration.\0A */\0A#include \22psa/build_info.h\22\0A\0A#include \22psa/crypto.h\22\0A#include \22psa/crypto_se_driver.h\22\0A#if defined(MBEDTLS_THREADING_C)\0A#include \22mbedtls/threading.h\22\0A#endif\0A\0A/**\0A * Tell if PSA is ready for this cipher.\0A *\0A * \5Cnote            For now, only checks the state of the driver subsystem,\0A *                  not the algorithm. Might do more in the future.\0A *\0A * \5Cparam cipher_alg  The cipher algorithm (ignored for now).\0A *\0A * \5Creturn 1 if the driver subsytem is ready, 0 otherwise.\0A */\0Aint psa_can_do_cipher(psa_key_type_t key_type, psa_algorithm_t cipher_alg);\0A\0Atypedef enum {\0A    PSA_SLOT_EMPTY = 0,\0A    PSA_SLOT_FILLING,\0A    PSA_SLOT_FULL,\0A    PSA_SLOT_PENDING_DELETION,\0A} psa_key_slot_state_t;\0A\0A/** The data structure representing a key slot, containing key material\0A * and metadata for one key.\0A */\0Atypedef struct {\0A    /* This field is accessed in a lot of places. Putting it first\0A     * reduces the code size. */\0A    psa_key_attributes_t attr;\0A\0A    /*\0A     * The current state of the key slot, as described in\0A     * docs/architecture/psa-thread-safety/psa-thread-safety.md.\0A     *\0A     * Library functions can modify the state of a key slot by calling\0A     * psa_key_slot_state_transition.\0A     *\0A     * The state variable is used to help determine whether library functions\0A     * which operate on the slot succeed. For example, psa_finish_key_creation,\0A     * which transfers the state of a slot from PSA_SLOT_FILLING to\0A     * PSA_SLOT_FULL, must fail with error code PSA_ERROR_CORRUPTION_DETECTED\0A     * if the state of the slot is not PSA_SLOT_FILLING.\0A     *\0A     * Library functions which traverse the array of key slots only consider\0A     * slots that are in a suitable state for the function.\0A     * For example, psa_get_and_lock_key_slot_in_memory, which finds a slot\0A     * containing a given key ID, will only check slots whose state variable is\0A     * PSA_SLOT_FULL.\0A     */\0A    psa_key_slot_state_t state;\0A\0A#if defined(MBEDTLS_PSA_KEY_STORE_DYNAMIC)\0A    /* The index of the slice containing this slot.\0A     * This field must be filled if the slot contains a key\0A     * (including keys being created or destroyed), and can be either\0A     * filled or 0 when the slot is free.\0A     *\0A     * In most cases, the slice index can be deduced from the key identifer.\0A     * We keep it in a separate field for robustness (it reduces the chance\0A     * that a coding mistake in the key store will result in accessing the\0A     * wrong slice), and also so that it's available even on code paths\0A     * during creation or destruction where the key identifier might not be\0A     * filled in.\0A     * */\0A    uint8_t slice_index;\0A#endif /* MBEDTLS_PSA_KEY_STORE_DYNAMIC */\0A\0A    union {\0A        struct {\0A            /* The index of the next slot in the free list for this\0A             * slice, relative * to the next array element.\0A             *\0A             * That is, 0 means the next slot, 1 means the next slot\0A             * but one, etc. -1 would mean the slot itself. -2 means\0A             * the previous slot, etc.\0A             *\0A             * If this is beyond the array length, the free list ends with the\0A             * current element.\0A             *\0A             * The reason for this strange encoding is that 0 means the next\0A             * element. This way, when we allocate a slice and initialize it\0A             * to all-zero, the slice is ready for use, with a free list that\0A             * consists of all the slots in order.\0A             */\0A            int32_t next_free_relative_to_next;\0A        } free;\0A\0A        struct {\0A            /*\0A             * Number of functions registered as reading the material in the key slot.\0A             *\0A             * Library functions must not write directly to registered_readers\0A             *\0A             * A function must call psa_register_read(slot) before reading\0A             * the current contents of the slot for an operation.\0A             * They then must call psa_unregister_read(slot) once they have\0A             * finished reading the current contents of the slot. If the key\0A             * slot mutex is not held (when mutexes are enabled), this call\0A             * must be done via a call to\0A             * psa_unregister_read_under_mutex(slot).\0A             * A function must call psa_key_slot_has_readers(slot) to check if\0A             * the slot is in use for reading.\0A             *\0A             * This counter is used to prevent resetting the key slot while\0A             * the library may access it. For example, such control is needed\0A             * in the following scenarios:\0A             * . In case of key slot starvation, all key slots contain the\0A             *   description of a key, and the library asks for the\0A             *   description of a persistent key not present in the\0A             *   key slots, the key slots currently accessed by the\0A             *   library cannot be reclaimed to free a key slot to load\0A             *   the persistent key.\0A             * . In case of a multi-threaded application where one thread\0A             *   asks to close or purge or destroy a key while it is in use\0A             *   by the library through another thread. */\0A            size_t registered_readers;\0A        } occupied;\0A    } var;\0A\0A    /* Dynamically allocated key data buffer.\0A     * Format as specified in psa_export_key(). */\0A    struct key_data {\0A#if defined(MBEDTLS_PSA_STATIC_KEY_SLOTS)\0A        uint8_t data[MBEDTLS_PSA_STATIC_KEY_SLOT_BUFFER_SIZE];\0A#else\0A        uint8_t *data;\0A#endif\0A        size_t bytes;\0A    } key;\0A} psa_key_slot_t;\0A\0A#if defined(MBEDTLS_THREADING_C)\0A\0A/** Perform a mutex operation and return immediately upon failure.\0A *\0A * Returns PSA_ERROR_SERVICE_FAILURE if the operation fails\0A * and status was PSA_SUCCESS.\0A *\0A * Assumptions:\0A *  psa_status_t status exists.\0A *  f is a mutex operation which returns 0 upon success.\0A */\0A#define PSA_THREADING_CHK_RET(f)                       \5C\0A    do                                                 \5C\0A    {                                                  \5C\0A        if ((f) != 0) {                                \5C\0A            if (status == PSA_SUCCESS) {               \5C\0A                return PSA_ERROR_SERVICE_FAILURE;      \5C\0A            }                                          \5C\0A            return status;                             \5C\0A        }                                              \5C\0A    } while (0);\0A\0A/** Perform a mutex operation and goto exit on failure.\0A *\0A * Sets status to PSA_ERROR_SERVICE_FAILURE if status was PSA_SUCCESS.\0A *\0A * Assumptions:\0A *  psa_status_t status exists.\0A *  Label exit: exists.\0A *  f is a mutex operation which returns 0 upon success.\0A */\0A#define PSA_THREADING_CHK_GOTO_EXIT(f)                 \5C\0A    do                                                 \5C\0A    {                                                  \5C\0A        if ((f) != 0) {                                \5C\0A            if (status == PSA_SUCCESS) {               \5C\0A              