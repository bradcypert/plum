t been previously initialized by psa_crypto_init().\0A *         It is implementation-dependent whether a failure to initialize\0A *         results in this error code.\0A */\0Apsa_status_t psa_generate_key_ext(const psa_key_attributes_t *attributes,\0A                                  const psa_key_production_parameters_t *params,\0A                                  size_t params_data_length,\0A                                  mbedtls_svc_key_id_t *key);\0A#endif /* !__cplusplus */\0A\0A/**@}*/\0A\0A/** \5Cdefgroup interruptible_hash Interruptible sign/verify hash\0A * @{\0A */\0A\0A/** The type of the state data structure for interruptible hash\0A *  signing operations.\0A *\0A * Before calling any function on a sign hash operation object, the\0A * application must initialize it by any of the following means:\0A * - Set the structure to all-bits-zero, for example:\0A *   \5Ccode\0A *   psa_sign_hash_interruptible_operation_t operation;\0A *   memset(&operation, 0, sizeof(operation));\0A *   \5Cendcode\0A * - Initialize the structure to logical zero values, for example:\0A *   \5Ccode\0A *   psa_sign_hash_interruptible_operation_t operation = {0};\0A *   \5Cendcode\0A * - Initialize the structure to the initializer\0A *   #PSA_SIGN_HASH_INTERRUPTIBLE_OPERATION_INIT, for example:\0A *   \5Ccode\0A *   psa_sign_hash_interruptible_operation_t operation =\0A *   PSA_SIGN_HASH_INTERRUPTIBLE_OPERATION_INIT;\0A *   \5Cendcode\0A * - Assign the result of the function\0A *   psa_sign_hash_interruptible_operation_init() to the structure, for\0A *   example:\0A *   \5Ccode\0A *   psa_sign_hash_interruptible_operation_t operation;\0A *   operation = psa_sign_hash_interruptible_operation_init();\0A *   \5Cendcode\0A *\0A * This is an implementation-defined \5Cc struct. Applications should not\0A * make any assumptions about the content of this structure.\0A * Implementation details can change in future versions without notice. */\0Atypedef struct psa_sign_hash_interruptible_operation_s psa_sign_hash_interruptible_operation_t;\0A\0A/** The type of the state data structure for interruptible hash\0A *  verification operations.\0A *\0A * Before calling any function on a sign hash operation object, the\0A * application must initialize it by any of the following means:\0A * - Set the structure to all-bits-zero, for example:\0A *   \5Ccode\0A *   psa_verify_hash_interruptible_operation_t operation;\0A *   memset(&operation, 0, sizeof(operation));\0A *   \5Cendcode\0A * - Initialize the structure to logical zero values, for example:\0A *   \5Ccode\0A *   psa_verify_hash_interruptible_operation_t operation = {0};\0A *   \5Cendcode\0A * - Initialize the structure to the initializer\0A *   #PSA_VERIFY_HASH_INTERRUPTIBLE_OPERATION_INIT, for example:\0A *   \5Ccode\0A *   psa_verify_hash_interruptible_operation_t operation =\0A *   PSA_VERIFY_HASH_INTERRUPTIBLE_OPERATION_INIT;\0A *   \5Cendcode\0A * - Assign the result of the function\0A *   psa_verify_hash_interruptible_operation_init() to the structure, for\0A *   example:\0A *   \5Ccode\0A *   psa_verify_hash_interruptible_operation_t operation;\0A *   operation = psa_verify_hash_interruptible_operation_init();\0A *   \5Cendcode\0A *\0A * This is an implementation-defined \5Cc struct. Applications should not\0A * make any assumptions about the content of this structure.\0A * Implementation details can change in future versions without notice. */\0Atypedef struct psa_verify_hash_interruptible_operation_s psa_verify_hash_interruptible_operation_t;\0A\0A/**\0A * \5Cbrief                       Set the maximum number of ops allowed to be\0A *                              executed by an interruptible function in a\0A *                              single call.\0A *\0A * \5Cwarning                     This is a beta API, and thus subject to change\0A *                              at any point. It is not bound by the usual\0A *                              interface stability promises.\0A *\0A * \5Cnote                        The time taken to execute a single op is\0A *                              implementation specific and depends on\0A *                              software, hardware, the algorithm, key type and\0A *                              curve chosen. Even within a single operation,\0A *                              successive ops can take differing amounts of\0A *                              time. The only guarantee is that lower values\0A *                              for \5Cp max_ops means functions will block for a\0A *                              lesser maximum amount of time. The functions\0A *                              \5Cc psa_sign_interruptible_get_num_ops() and\0A *                              \5Cc psa_verify_interruptible_get_num_ops() are\0A *                              provided to help with tuning this value.\0A *\0A * \5Cnote                        This value defaults to\0A *                              #PSA_INTERRUPTIBLE_MAX_OPS_UNLIMITED, which\0A *                              means the whole operation will be done in one\0A *                              go, regardless of the number of ops required.\0A *\0A * \5Cnote                        If more ops are needed to complete a\0A *                              computation, #PSA_OPERATION_INCOMPLETE will be\0A *                              returned by the function performing the\0A *                              computation. It is then the caller's\0A *                              responsibility to either call again with the\0A *                              same operation context until it returns 0 or an\0A *                              error code; or to call the relevant abort\0A *                              function if the answer is no longer required.\0A *\0A * \5Cnote                        The interpretation of \5Cp max_ops is also\0A *                              implementation defined. On a hard real time\0A *                              system, this can indicate a hard deadline, as a\0A *                              real-time system needs a guarantee of not\0A *                              spending more than X time, however care must be\0A *                              taken in such an implementation to avoid the\0A *                              situation whereby calls just return, not being\0A *                              able to do any actual work within the allotted\0A *                              time.  On a non-real-time system, the\0A *                              implementation can be more relaxed, but again\0A *                              whether this number should be interpreted as as\0A *                              hard or soft limit or even whether a less than\0A *                              or equals as regards to ops executed in a\0A *                              single call is implementation defined.\0A *\0A * \5Cnote                        For keys in local storage when no accelerator\0A *                              driver applies, please see also the\0A *                              documentation for \5Cc mbedtls_ecp_set_max_ops(),\0A *                              which is the internal implementation in these\0A *                              cases.\0A *\0A * \5Cwarning                     With implementations that interpret this number\0A *                              as a hard limit, setting this number too small\0A *                              may result in an infinite loop, whereby each\0A *                              call results in immediate return with no ops\0A *                              done (as there is not enough time to execute\0A *                              any), and thus no result will ever be achieved.\0A *\0A * \5Cnote                        This only applies to functions whose\0A *                              documentation mentions they may return\0A *                              #PSA_OPERATION_INCOMPLETE.\0A *\0A * \5Cparam max_ops               The maximum number of ops to be executed in a\0A *                              single call. This can be a number from 0 to\0A *                              #PSA_INTERRUPTIBLE_MAX_OPS_UNLIMITED, where 0\0A *                              is the least amount of work done per call.\0A */\0Avoid psa_interruptible_set_max_ops(uint32_t max_ops);\0A\0A/**\0A * \5Cbrief                       Get the maximum number of ops allowed to be\0A *                              executed by an interruptible function in a\0A *                              single call. This will return the last\0A *                              value set by\0A *                              \5Cc psa_interruptible_set_max_ops() or\0A *                              #PSA_INTERRUPTIBLE_MAX_OPS_UNLIMITED if\0A *                              that function has never been called.\0A *\0A * \5Cwarning                     This is a beta API, and thus subject to change\0A *                              at any point. It is not bound by the usual\0A *                              interface stability promises.\0A *\0A * \5Creturn                      Maximum number of ops allowed to be\0A *                              executed by an interruptible function in a\0A *                              single call.\0A */\0Auint32_t psa_interruptible_get_max_ops(void);\0A\0A/**\0A * \5Cbrief                       Get the number of ops that a hash signing\0A *                              operation has taken so far. If the operation\0A *                              has completed, then this will represent the\0A *                              number of ops required for the entire\0A *                              operation. After initialization or calling\0A *                              \5Cc psa_sign_hash_interruptible_abort() on\0A *                              the operation, a value of 0 will be returned.\0A *\0A * \5Cnote                        This interface is guaranteed re-entrant and\0A *                              thus may be called from driver code.\0A *\0A * \5Cwarning                     This is a beta API, and thus subject to change\0A *                              at any point. It is not bound by the usual\0A *                              interface stability promises.\0A *\0A *                              This is a helper provided to help you tune the\0A *                              value passed to \5Cc\0A *                              psa_interruptible_set_max_ops().\0A *\0A * \5Cparam operation             The \5Cc psa_sign_hash_interruptible_operation_t\0A *                              to use. This must be initialized first.\0A *\0A * \5Creturn                      Number of ops that the operation has taken so\0A *                              far.\0A */\0Auint32_t psa_sign_hash_get_num_ops(\0A    const psa_sign_hash_interruptible_operation_t *operation);\0A\0A/**\0A * \5Cbrief                       Get the number of ops that a hash verification\0A *                              operation has taken so far. If the operation\0A *                              has completed, then this will represent the\0A *                              number of ops required for the entire\0A *                              operation. After initialization or calling \5Cc\0A *                              psa_verify_hash_interruptible_abort() on the\0A *                              operation, a value of 0 will be returned.\0A *\0A * \5Cwarning                     This is a beta API, and thus subject to change\0A *                              at any point. It is not bound by the usual\0A *                              interface stability promises.\0A *\0A *                              This is a helper provided to help you tune the\0A *                              value passed to \5Cc\0A *                              psa_interruptible_set_max_ops().\0A *\0A * \5Cparam operation             The \5Cc\0A *                              psa_verify_hash_interruptible_operation_t to\0A *                              use. This must be initialized first.\0A *\0A * \5Creturn                      Number of ops that the operation has taken so\0A *                              far.\0A */\0Auint32_t psa_verify_hash_get_num_ops(\0A    const psa_verify_hash_interruptible_operation_t *operation);\0A\0A/**\0A * \5Cbrief                       Start signing a hash or short message with a\0A *                              private key, in an interruptible manner.\0A *\0A * \5Csee                         \5Cc psa_sign_hash_complete()\0A *\0A * \5Cwarning                     This is a beta API, and thus subject to change\0A *                              at any point. It is not bound by the usual\0A *                              interface stability promises.\0A *\0A * \5Cnote                        This function combined with \5Cc\0A *                              psa_sign_hash_complete() is equivalent to\0A *                              \5Cc psa_sign_hash() but\0A *                              \5Cc psa_sign_hash_complete() can return early and\0A *                              resume according to the limit set with \5Cc\0A *                              psa_interruptible_set_max_ops() to reduce the\0A *                              maximum time spent in a function call.\0A *\0A * \5Cnote                        Users should call \5Cc psa_sign_hash_complete()\0A *                              repeatedly on the same context after a\0A *                              successful call to this function until \5Cc\0A *                              psa_sign_hash_complete() either returns 0 or an\0A *                              error. \5Cc psa_sign_hash_complete() will return\0A *                              #PSA_OPERATION_INCOMPLETE if there is more work\0A *                              to do. Alternatively users can call\0A *                              \5Cc psa_sign_hash_abort() at any point if they no\0A *                              longer want the result.\0A *\0A * \5Cnote                        If this function returns an error status, the\0A *                              operation enters an error state and must be\0A *                              aborted by calling \5Cc psa_sign_hash_abort().\0A *\0A * \5Cparam[in, out] operation    The \5Cc psa_sign_hash_interruptible_operation_t\0A *                              to use. This must be initialized first.\0A *\0A * \5Cparam key                   Identifier of the key to use for the operation.\0A *                              It must be an asymmetric key pair. The key must\0A *                              allow the usage #PSA_KEY_USAGE_SIGN_HASH.\0A * \5Cparam alg                   A signature algorithm (\5Cc PSA_ALG_XXX\0A *                              value such that #PSA_ALG_IS_SIGN_HASH(\5Cp alg)\0A *                              is true), that is compatible with\0A *                              the type of \5Cp key.\0A * \5Cparam[in] hash              The hash or message to sign.\0A * \5Cparam hash_length           Size of the \5Cp hash buffer in bytes.\0A *\0A * \5Cretval #PSA_SUCCESS\0A *         The operation started successfully - call \5Cc psa_sign_hash_complete()\0A *         with the same context to complete the operation\0A *\0A * \5Cretval #PSA_ERROR_INVALID_HANDLE \5Cemptydescription\0A * \5Cretval #PSA_ERROR_NOT_PERMITTED\0A *         The key does not have the #PSA_KEY_USAGE_SIGN_HASH flag, or it does\0A *         not permit the requested algorithm.\0A * \5Cretval #PSA_ERROR_BAD_STATE\0A *         An operation has previously been started on this context, and is\0A *         still in progress.\0A * \5Cretval #PSA_ERROR_NOT_SUPPORTED \5Cemptydescription\0A * \5Cretval #PSA_ERROR_INVALID_ARGUMENT \5Cemptydescription\0A * \5Cretval #PSA_ERROR_INSUFFICIENT_MEMORY \5Cemptydescription\0A * \5Cretval #PSA_ERROR_COMMUNICATION_FAILURE \5Cemptydescription\0A * \5Cretval #PSA_ERROR_HARDWARE_FAILURE \5Cemptydescription\0A * \5Cretval #PSA_ERROR_CORRUPTION_DETECTED \5Cemptydescription\0A * \5Cretval #PSA_ERROR_STORAGE_FAILURE \5Cemptydescription\0A * \5Cretval #PSA_ERROR_DATA_CORRUPT \5Cemptydescription\0A * \5Cretval #PSA_ERROR_DATA_INVALID \5Cemptydescription\0A * \5Cretval #PSA_ERROR_INSUFFICIENT_ENTROPY \5Cemptydescription\0A * \5Cretval #PSA_ERROR_BAD_STATE\0A *         The library has not been previously initialized by psa_crypto_init().\0A *         It is implementation-dependent whether a failure to initialize\0A *         results in this error code.\0A */\0Apsa_status_t psa_sign_hash_start(\0A    psa_sign_hash_interruptible_operation_t *operation,\0A    mbedtls_svc_key_id_t key, psa_algorithm_t alg,\0A    const uint8_t *hash, size_t hash_length);\0A\0A/**\0A * \5Cbrief                       Continue and eventually complete the action of\0A *                              signing a hash or short message with a private\0A *                              key, in an interruptible manner.\0A *\0A * \5Csee                         \5Cc psa_sign_hash_start()\0A *\0A * \5Cwarning                     This is a beta API, and thus subject to change\0A *                              at any point. It is not bound by the usual\0A *                              interface stability promises.\0A *\0A * \5Cnote                        This function combined with \5Cc\0A *                              psa_sign_hash_start() is equivalent to\0A *                              \5Cc psa_sign_hash() but this function can return\0A *                              early and resume according to the limit set with\0A *                              \5Cc psa_interruptible_set_max_ops() to reduce the\0A *                              maximum time spent in a function call.\0A *\0A * \5Cnote                        Users should call this function on the same\0A *                              operation object repeatedly until it either\0A *                              returns 0 or an error. This function will return\0A *                              #PSA_OPERATION_INCOMPLETE if there is more work\0A *                              to do. Alternatively users can call\0A *                              \5Cc psa_sign_hash_abort() at any point if they no\0A *                              longer want the result.\0A *\0A * \5Cnote                        When this function returns successfully, the\0A *                              operation becomes inactive. If this function\0A *                              returns an error status, the operation enters an\0A *                              error state and must be aborted by calling\0A *                              \5Cc psa_sign_hash_abort().\0A *\0A * \5Cparam[in, out] operation    The \5Cc psa_sign_hash_interruptible_operation_t\0A *                              to use. This must be initialized first, and have\0A *                              had \5Cc psa_sign_hash_start() called with it\0A *                              first.\0A *\0A * \5Cparam[out] signature        Buffer where the signature is to be written.\0A * \5Cparam signature_size        Size of the \5Cp signature buffer in bytes. This\0A *                              must be appropriate for the selected\0A *                              algorithm and key:\0A *                              - The required signature size is\0A *                                #PSA_SIGN_OUTPUT_SIZE(\5Cc key_type, \5Cc\0A *                                key_bits, \5Cc alg) where \5Cc key_type and \5Cc\0A *                                key_bits are the type and bit-size\0A *                                respectively of key.\0A *                              - #PSA_SIGNATURE_MAX_SIZE evaluates to the\0A *                                maximum signature size of any supported\0A *                                signature algorithm.\0A * \5Cparam[out] signature_length On success, the number of bytes that make up\0A *                              the returned signature value.\0A *\0A * \5Cretval #PSA_SUCCESS\0A *         Operation completed successfully\0A *\0A * \5Cretval #PSA_OPERATION_INCOMPLETE\0A *         Operation was interrupted due to the setting of \5Cc\0A *         psa_interruptible_set_max_ops(). There is still work to be done.\0A *         Call this function again with the same operation object.\0A *\0A * \5Cretval #PSA_ERROR_BUFFER_TOO_SMALL\0A *         The size of the \5Cp signature buffer is too small. You can\0A *         determine a sufficient buffer size by calling\0A *         #PSA_SIGN_OUTPUT_SIZE(\5Cc key_type, \5Cc key_bits, \5Cc alg)\0A *         where \5Cc key_type and \5Cc key_bits are the type and bit-size\0A *         respectively of \5Cc key.\0A *\0A * \5Cretval #PSA_ERROR_BAD_STATE\0A *         An operation was not previously started on this context via\0A *         \5Cc psa_sign_hash_start().\0A *\0A * \5Cretval #PSA_ERROR_NOT_SUPPORTED \5Cemptydescription\0A * \5Cretval #PSA_ERROR_INVALID_ARGUMENT \5Cemptydescription\0A * \5Cretval #PSA_ERROR_INSUFFICIENT_MEMORY \5Cemptydescription\0A * \5Cretval #PSA_ERROR_COMMUNICATION_FAILURE \5Cemptydescription\0A * \5Cretval #PSA_ERROR_HARDWARE_FAILURE \5Cemptydescription\0A * \5Cretval #PSA_ERROR_CORRUPTION_DETECTED \5Cemptydescription\0A * \5Cretval #PSA_ERROR_STORAGE_FAILURE \5Cemptydescription\0A * \5Cretval #PSA_ERROR_DATA_CORRUPT \5Cemptydescription\0A * \5Cretval #PSA_ERROR_DATA_INVALID \5Cemptydescription\0A * \5Cretval #PSA_ERROR_INSUFFICIENT_ENTROPY \5Cemptydescription\0A * \5Cretval #PSA_ERROR_BAD_STATE\0A *         The library has either not been previously initialized by\0A *         psa_crypto_init() or you did not previously call\0A *         psa_sign_hash_start() with this operation object. It is\0A *         implementation-dependent whether a failure to initialize results in\0A *         this error code.\0A */\0Apsa_status_t psa_sign_hash_complete(\0A    psa_sign_hash_interruptible_operation_t *operation,\0A    uint8_t *signature, size_t signature_size,\0A    size_t *signature_length);\0A\0A/**\0A * \5Cbrief                       Abort a sign hash operation.\0A *\0A * \5Cwarning                     This is a beta API, and thus subject to change\0A *                              at any point. It is not bound by the usual\0A *                              interface stability promises.\0A *\0A * \5Cnote                        This function is the only function that clears\0A *                              the number of ops completed as part of the\0A *                              operation. Please ensure you copy this value via\0A *                              \5Cc psa_sign_hash_get_num_ops() if required\0A *                              before calling.\0A *\0A * \5Cnote                        Aborting an operation frees all associated\0A *                              resources except for the \5Cp operation structure\0A *                              itself. Once aborted, the operation object can\0A *                              be reused for another operation by calling \5Cc\0A *                              psa_sign_hash_start() again.\0A *\0A * \5Cnote                        You may call this function any time after the\0A *                              operation object has been initialized. In\0A *                              particular, calling \5Cc psa_sign_hash_abort()\0A *                              after the operation has already been terminated\0A *                              by a call to \5Cc psa_sign_hash_abort() or\0A *                              psa_sign_hash_complete() is safe.\0A *\0A * \5Cparam[in,out] operation     Initialized sign hash operation.\0A *\0A * \5Cretval #PSA_SUCCESS\0A *         The operation was aborted successfully.\0A *\0A * \5Cretval #PSA_ERROR_NOT_SUPPORTED \5Cemptydescription\0A * \5Cretval #PSA_ERROR_BAD_STATE\0A *         The library has not been previously initialized by psa_crypto_init().\0A *         It is implementation-dependent whether a failure to initialize\0A *         results in this error code.\0A */\0Apsa_status_t psa_sign_hash_abort(\0A    psa_sign_hash_interruptible_operation_t *operation);\0A\0A/**\0A * \5Cbrief                       Start reading and verifying a hash or short\0A *                              message, in an interruptible manner.\0A *\0A * \5Csee                         \5Cc psa_verify_hash_complete()\0A *\0A * \5Cwarning                     This is a beta API, and thus subject to change\0A *                              at any point. It is not bound by the usual\0A *                              interface stability promises.\0A *\0A * \5Cnote                        This function combined with \5Cc\0A *                              psa_verify_hash_complete() is equivalent to\0A *                              \5Cc psa_verify_hash() but \5Cc\0A *                              psa_verify_hash_complete() can return early and\0A *                              resume according to the limit set with \5Cc\0A *                              psa_interruptible_set_max_ops() to reduce the\0A *                              maximum time spent in a function.\0A *\0A * \5Cnote                        Users should call \5Cc psa_verify_hash_complete()\0A *                              repeatedly on the same operation object after a\0A *                              successful call to this function until \5Cc\0A *                              psa_verify_hash_complete() either returns 0 or\0A *                              an error. \5Cc psa_verify_hash_complete() will\0A *                              return #PSA_OPERATION_INCOMPLETE if there is\0A *                              more work to do. Alternatively users can call\0A *                              \5Cc psa_verify_hash_abort() at any point if they\0A *                              no longer want the result.\0A *\0A * \5Cnote                        If this function returns an error status, the\0A *                              operation enters an error state and must be\0A *                              aborted by calling \5Cc psa_verify_hash_abort().\0A *\0A * \5Cparam[in, out] operation    The \5Cc psa_verify_hash_interruptible_operation_t\0A *                              to use. This must be initialized first.\0A *\0A * \5Cparam key                   Identifier of the key to use for the operation.\0A *                              The key must allow the usage\0A *                              #PSA_KEY_USAGE_VERIFY_HASH.\0A * \5Cparam alg                   A signature algorithm (\5Cc PSA_ALG_XXX\0A *                              value such that #PSA_ALG_IS_SIGN_HASH(\5Cp alg)\0A *                              is true), that is compatible with\0A *                              the type of \5Cp key.\0A * \5Cparam[in] hash              The hash whose signature is to be verified.\0A * \5Cparam hash_length           Size of the \5Cp hash buffer in bytes.\0A * \5Cparam[in] signature         Buffer containing the signature to verify.\0A * \5Cparam signature_length      Size of the \5Cp signature buffer in bytes.\0A *\0A * \5Cretval #PSA_SUCCESS\0A *         The operation started successfully - please call \5Cc\0A *         psa_verify_hash_complete() with the same context to complete the\0A *         operation.\0A *\0A * \5Cretval #PSA_ERROR_BAD_STATE\0A *         Another operation has already been started on this context, and is\0A *         still in progress.\0A *\0A * \5Cretval #PSA_ERROR_NOT_PERMITTED\0A *         The key does not have the #PSA_KEY_USAGE_VERIFY_HASH flag, or it does\0A *         not permit the requested algorithm.\0A *\0A * \5Cretval #PSA_ERROR_NOT_SUPPORTED \5Cemptydescription\0A * \5Cretval #PSA_ERROR_INVALID_ARGUMENT \5Cemptydescription\0A * \5Cretval #PSA_ERROR_INSUFFICIENT_MEMORY \5Cemptydescription\0A * \5Cretval #PSA_ERROR_COMMUNICATION_FAILURE \5Cemptydescription\0A * \5Cretval #PSA_ERROR_HARDWARE_FAILURE \5Cemptydescription\0A * \5Cretval #PSA_ERROR_CORRUPTION_DETECTED \5Cemptydescription\0A * \5Cretval #PSA_ERROR_STORAGE_FAILURE \5Cemptydescription\0A * \5Cretval PSA_ERROR_DATA_CORRUPT \5Cemptydescription\0A * \5Cretval PSA_ERROR_DATA_INVALID \5Cemptydescription\0A * \5Cretval #PSA_ERROR_BAD_STATE\0A *         The library has not been previously initialized by psa_crypto_init().\0A *         It is implementation-dependent whether a failure to initialize\0A *         results in this error code.\0A */\0Apsa_status_t psa_verify_hash_start(\0A    psa_verify_hash_interruptible_operation_t *operation,\0A    mbedtls_svc_key_id_t key, psa_algorithm_t alg,\0A    const uint8_t *hash, size_t hash_length,\0A    const uint8_t *signature, size_t signature_length);\0A\0A/**\0A * \5Cbrief                       Continue and eventually complete the action of\0A *                              reading and verifying a hash or short message\0A *                              signed with a private key, in an interruptible\0A *                              manner.\0A *\0A * \5Csee                         \5Cc psa_verify_hash_start()\0A *\0A * \5Cwarning                     This is a beta API, and thus subject to change\0A *                              at any point. It is not bound by the usual\0A *                              interface stability promises.\0A *\0A * \5Cnote                        This function combined with \5Cc\0A *                              psa_verify_hash_start() is equivalent to\0A *                              \5Cc psa_verify_hash() but this function can\0A *                              return early and resume according to the limit\0A *                              set with \5Cc psa_interruptible_set_max_ops() to\0A *                              reduce the maximum time spent in a function\0A *                              call.\0A *\0A * \5Cnote                        Users should call this function on the same\0A *                              operation object repeatedly until it either\0A *                              returns 0 or an error. This function will return\0A *                              #PSA_OPERATION_INCOMPLETE if there is more work\0A *                              to do. Alternatively users can call\0A *                              \5Cc psa_verify_hash_abort() at any point if they\0A *                              no longer want the result.\0A *\0A * \5Cnote                        When this function returns successfully, the\0A *                              operation becomes inactive. If this function\0A *                              returns an error status, the operation enters an\0A *                              error state and must be aborted by calling\0A *                              \5Cc psa_verify_hash_abort().\0A *\0A * \5Cparam[in, out] operation    The \5Cc psa_verify_hash_interruptible_operation_t\0A *                              to use. This must be initialized first, and have\0A *                              had \5Cc psa_verify_hash_start() called with it\0A *                              first.\0A *\0A * \5Cretval #PSA_SUCCESS\0A *         Operation completed successfully, and the passed signature is valid.\0A *\0A * \5Cretval #PSA_OPERATION_INCOMPLETE\0A *         Operation was interrupted due to the setting of \5Cc\0A *         psa_interruptible_set_max_ops(). There is still work to be done.\0A *         Call this function again with the same operation object.\0A *\0A * \5Cretval #PSA_ERROR_INVALID_HANDLE \5Cemptydescription\0A * \5Cretval #PSA_ERROR_INVALID_SIGNATURE\0A *         The calculation was performed successfully, but the passed\0A *         signature is not a valid signature.\0A * \5Cretval #PSA_ERROR_BAD_STATE\0A *         An operation was not previously started on this context via\0A *         \5Cc psa_verify_hash_start().\0A * \5Cretval #PSA_ERROR_NOT_SUPPORTED \5Cemptydescription\0A * \5Cretval #PSA_ERROR_INVALID_ARGUMENT \5Cemptydescription\0A * \5Cretval #PSA_ERROR_INSUFFICIENT_MEMORY \5Cemptydescription\0A * \5Cretval #PSA_ERROR_COMMUNICATION_FAILURE \5Cemptydescription\0A * \5Cretval #PSA_ERROR_HARDWARE_FAILURE \5Cemptydescription\0A * \5Cretval #PSA_ERROR_CORRUPTION_DETECTED \5Cemptydescription\0A * \5Cretval #PSA_ERROR_STORAGE_FAILURE \5Cemptydescription\0A * \5Cretval #PSA_ERROR_DATA_CORRUPT \5Cemptydescription\0A * \5Cretval #PSA_ERROR_DATA_INVALID \5Cemptydescription\0A * \5Cretval #PSA_ERROR_INSUFFICIENT_ENTROPY \5Cemptydescription\0A * \5Cretval #PSA_ERROR_BAD_STATE\0A *         The library has either not been previously initialized by\0A *         psa_crypto_init() or you did not previously call\0A *         psa_verify_hash_start() on this object. It is\0A *         implementation-dependent whether a failure to initialize results in\0A *         this error code.\0A */\0Apsa_status_t psa_verify_hash_complete(\0A    psa_verify_hash_interruptible_operation_t *operation);\0A\0A/**\0A * \5Cbrief                     Abort a verify hash operation.\0A *\0A * \5Cwarning                   This is a beta API, and thus subject to change at\0A *                            any point. It is not bound by the usual interface\0A *                            stability promises.\0A *\0A * \5Cnote                      This function is the only function that clears the\0A *                            number of ops completed as part of the operation.\0A *                            Please ensure you copy this value via\0A *                            \5Cc psa_verify_hash_get_num_ops() if required\0A *                            before calling.\0A *\0A * \5Cnote                      Aborting an operation frees all associated\0A *                            resources except for the operation structure\0A *                            itself. Once aborted, the operation object can be\0A *                            reused for another operation by calling \5Cc\0A *                            psa_verify_hash_start() again.\0A *\0A * \5Cnote                      You may call this function any time after the\0A *                            operation object has been initialized.\0A *                            In particular, calling \5Cc psa_verify_hash_abort()\0A *                            after the operation has already been terminated by\0A *                            a call to \5Cc psa_verify_hash_abort() or\0A *                            psa_verify_hash_complete() is safe.\0A *\0A * \5Cparam[in,out] operation   Initialized verify hash operation.\0A *\0A * \5Cretval #PSA_SUCCESS\0A *         The operation was aborted successfully.\0A *\0A * \5Cretval #PSA_ERROR_NOT_SUPPORTED \5Cemptydescription\0A * \5Cretval #PSA_ERROR_BAD_STATE\0A *         The library has not been previously initialized by psa_crypto_init().\0A *         It is implementation-dependent whether a failure to initialize\0A *         results in this error code.\0A */\0Apsa_status_t psa_verify_hash_abort(\0A    psa_verify_hash_interruptible_operation_t *operation);\0A\0A\0A/**@}*/\0A\0A#ifdef __cplusplus\0A}\0A#endif\0A\0A/* The file \22crypto_sizes.h\22 contains definitions for size calculation\0A * macros whose definitions are implementation-specific. */\0A#include \22crypto_sizes.h\22\0A\0A/* The file \22crypto_struct.h\22 contains definitions for\0A * implementation-specific structs that are declared above. */\0A#if defined(MBEDTLS_PSA_CRYPTO_STRUCT_FILE)\0A#include MBEDTLS_PSA_CRYPTO_STRUCT_FILE\0A#else\0A#include \22crypto_struct.h\22\0A#endif\0A\0A/* The file \22crypto_extra.h\22 contains vendor-specific definitions. This\0A * can include vendor-defined algorithms, extra functions, etc. */\0A#include \22crypto_extra.h\22\0A\0A#endif /* PSA_CRYPTO_H */\0A\00" }
