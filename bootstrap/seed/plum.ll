@.str46957 = private global { i64, i64, [15530 x i8] } { i64 -1, i64 15529, [15530 x i8] c"// A thin ABI-adapter shim between Plum's `extern \22C\22` surface (Int/\0A// Float/Bool/CStr/qualifying-struct only — no raw pointers, no\0A// out-parameters) and POSIX BSD sockets, whose real API needs\0A// `struct sockaddr`/`struct addrinfo`/`socklen_t *` — none of which fit\0A// Plum's extern type surface, same reason `raylib_shim.c` exists (see\0A// examples/asteroids/native/raylib_shim.c's own doc comment for the\0A// general pattern). Every function here takes/returns only `long long`\0A// (Plum `Int`) or `const char *` (Plum `CStr`), building the real\0A// `sockaddr`/`addrinfo` structs internally before calling through.\0A//\0A// **Unix-only (Linux/macOS) — a deliberate, documented v1 scope\0A// boundary, not an oversight.** Windows' Winsock is a genuinely\0A// different API in the details that matter here (needs `WSAStartup`,\0A// `SOCKET` isn't `int`, `closesocket()` not `close()`) — see DESIGN.md's\0A// \22TCP sockets\22 section for the full reasoning, which mirrors the\0A// existing extern-symbol-resolution Unix-only precedent exactly.\0A//\0A// This shim is compiled into TWO separate places, unlike a per-project\0A// shim (raylib's): once into `plum-interp`/`plumc`'s OWN process (via\0A// their `build.rs`, alongside how `libm` is force-linked in — see\0A// those files' doc comments) so `plum run`'s extern-call resolution\0A// against the CURRENT PROCESS's symbol table finds these symbols too;\0A// and once into every `plumc build` output binary unconditionally\0A// (`clang_compile` in `codegen_cli.rs`), the same way `-lm` is passed\0A// unconditionally — both backends need to agree these functions exist,\0A// same \22both backends behave identically\22 story as everything else.\0A//\0A// **`tcp_recv`'s own real scope trade**: it returns a `CStr` (a\0A// NUL-terminated, shim-owned buffer) rather than an `Int` count, so\0A// received data can become a usable Plum `String` via `.as_string()`\0A// (see DESIGN.md's \22CStr -> String\22 note — `Type::CStr` otherwise has\0A// no way back into a real Plum value). That makes this NUL-terminated,\0A// i.e. NOT binary-safe: an embedded `\5C0` byte in a response silently\0A// truncates it. Acceptable, honestly-documented for a v1 scoped at\0A// line-oriented HTTP/1.1 (headers + mostly-text bodies), not something\0A// that would hold up for arbitrary binary payloads. `tcp_recv` also\0A// deliberately returns `\22\22` — an empty, non-null `CStr` — on BOTH a\0A// clean peer-close (`recv` returns 0) AND a hard socket error (`recv`\0A// returns < 0): a null `CStr` return is a hard runtime abort under\0A// Plum's existing FFI semantics (see DESIGN.md's `CStr` null-return\0A// note), which would crash the whole program on an ordinary connection\0A// close — not acceptable for a `Result`-shaped Net API where \22stop\0A// reading\22 (from either cause) should be an ordinary, catchable\0A// outcome, not a language-level abort. The real distinction (clean\0A// close vs. genuine error) is discarded — a real, documented v1\0A// limitation, not silently swept.\0A//\0A// **`tcp_recv_n`/`tcp_recv_data` are the binary-safe pair**, added\0A// alongside rather than by changing `tcp_recv`, whose contract callers\0A// depend on. They split the answer across two calls because Plum's\0A// extern surface has no out-parameter and no multi-value return: the\0A// first returns a COUNT (and tells a clean close from an error, which\0A// `tcp_recv` cannot), the second hands back the buffer those bytes are\0A// in. Together they carry a length, so nothing has to `strlen` a\0A// payload that may legitimately contain a zero byte.\0A#include <string.h>\0A#include <stdlib.h>\0A#include <stdio.h>\0A#include <limits.h>\0A\0A// Winsock is a different API in the details, not in the shape: the same\0A// `socket`/`bind`/`listen`/`accept`/`send`/`recv` calls with a\0A// different handle type, a different close, a different error\0A// sentinel, and a mandatory one-time initialisation. Those four\0A// differences are abstracted here and NOTHING below is written twice --\0A// the alternative, a whole second copy of each function, is how the two\0A// halves drift apart.\0A//\0A#if defined(_WIN32)\0A// winsock2.h must precede windows.h, which ws2tcpip.h pulls in.\0A#include <winsock2.h>\0A#include <ws2tcpip.h>\0A#include <windows.h>\0A\0Atypedef SOCKET plum_sock;\0A#define PLUM_BAD_SOCK       INVALID_SOCKET\0A#define PLUM_CLOSESOCK(s)   closesocket(s)\0A#define PLUM_SOCKOPT(v)     ((const char *)(v))\0A// Winsock takes an `int` byte count. Preserve the socket API's existing\0A// partial-I/O behavior by limiting each call to its largest representable\0A// count instead of allowing a large Plum Int to wrap when narrowed.\0A#define PLUM_IO_LEN(n)      ((n) > INT_MAX ? INT_MAX : (n))\0A#define PLUM_ADDRLEN(n)     ((int)PLUM_IO_LEN(n))\0A\0A// Serialize lazy startup and publish success to all calling threads.\0A// FALSE leaves the once object uninitialized: this caller gets an error,\0A// and a waiting or later caller may retry. Never loop on startup failure.\0A// Keep exactly one successful Winsock reference for this adapter's process\0A// lifetime; per-socket cleanup must not shut down other threads' sockets.\0Astatic INIT_ONCE plum_net_once = INIT_ONCE_STATIC_INIT;\0A\0Astatic BOOL CALLBACK plum_net_start(PINIT_ONCE once, PVOID param, PVOID *context) {\0A    (void)once;\0A    (void)param;\0A    (void)context;\0A    WSADATA wsa;\0A    return WSAStartup(MAKEWORD(2, 2), &wsa) == 0;\0A}\0A\0Astatic int plum_net_init(void) {\0A    return InitOnceExecuteOnce(&plum_net_once, plum_net_start, NULL, NULL) ? 0 : -1;\0A}\0A#else\0A#include <sys/types.h>\0A#include <sys/socket.h>\0A#include <netinet/in.h>\0A#include <netdb.h>\0A#include <arpa/inet.h>\0A#include <unistd.h>\0A\0Atypedef int plum_sock;\0A#define PLUM_BAD_SOCK       (-1)\0A#define PLUM_CLOSESOCK(s)   close(s)\0A#define PLUM_SOCKOPT(v)     (v)\0A#define PLUM_ADDRLEN(n)     (n)\0A#define PLUM_IO_LEN(n)      (n)\0A#define plum_net_init()     0\0A#endif\0A\0A// `INVALID_SOCKET` is `(SOCKET)~0`, which reinterpreted as a signed\0A// 64-bit value is exactly -1 -- so the -1 the Plum wrappers already\0A// treat as failure keeps working on both platforms without a second\0A// sentinel. Checked here rather than assumed.\0Astatic long long plum_sock_out(plum_sock s) {\0A    return (s == PLUM_BAD_SOCK) ? -1 : (long long)s;\0A}\0A\0A// Resolves `host`/`port` via `getaddrinfo` (so both hostnames and\0A// literal IPs work, IPv4 or IPv6) and connects to the first address\0A// that succeeds. Returns the connected fd, or -1 on any failure —\0A// callers (the `Net`/`tcp_connect_to` Plum wrapper) turn that sentinel\0A// into a `Result::Err`, no extern-level error detail is lost here since\0A// there IS no richer detail to lose (a DNS failure and a refused\0A// connection are indistinguishable at this level either way).\0Along long tcp_connect(const char *host, long long port) {\0A    struct addrinfo hints;\0A    if (plum_net_init() != 0) return -1;\0A    memset(&hints, 0, sizeof(hints));\0A    hints.ai_family = AF_UNSPEC;\0A    hints.ai_socktype = SOCK_STREAM;\0A\0A    char port_str[16];\0A    snprintf(port_str, sizeof(port_str), \22%lld\22, port);\0A\0A    struct addrinfo *res = NULL;\0A    if (getaddrinfo(host, port_str, &hints, &res) != 0) {\0A        return -1;\0A    }\0A\0A    long long fd = -1;\0A    for (struct addrinfo *rp = res; rp != NULL; rp = rp->ai_next) {\0A        plum_sock s = socket(rp->ai_family, rp->ai_socktype, rp->ai_protocol);\0A        if (s == PLUM_BAD_SOCK) {\0A            continue;\0A        }\0A        if (connect(s, rp->ai_addr, PLUM_ADDRLEN(rp->ai_addrlen)) == 0) {\0A            fd = (long long)s;\0A            break;\0A        }\0A        PLUM_CLOSESOCK(s);\0A    }\0A    freeaddrinfo(res);\0A    return fd;\0A}\0A\0A// Binds+listens on `port` across all local interfaces (`INADDR_ANY`,\0A// IPv4 only — a real, deliberate v1 scope trade, matches `tcp_connect`\0A// not being IPv6-exclusive-only either way since `getaddrinfo` there\0A// picks whatever resolves). POSIX uses `SO_REUSEADDR` for server restarts\0A// across TIME_WAIT. Winsock gives that option different semantics: another\0A// process can forcibly bind the same port. Require `SO_EXCLUSIVEADDRUSE`\0A// there before binding, even though accepted connections can delay reuse\0A// after closure. Never publish a listener if its binding policy failed.\0A// Returns the listening fd, or -1 on failure.\0Along long tcp_listen(long long port) {\0A    plum_sock s;\0A    if (plum_net_init() != 0) return -1;\0A    s = socket(AF_INET, SOCK_STREAM, 0);\0A    if (s == PLUM_BAD_SOCK) {\0A        return -1;\0A    }\0A    int one = 1;\0A#if defined(_WIN32)\0A    int option = SO_EXCLUSIVEADDRUSE;\0A#else\0A    int option = SO_REUSEADDR;\0A#endif\0A    if (setsockopt(s, SOL_SOCKET, option, PLUM_SOCKOPT(&one), sizeof(one)) != 0) {\0A        PLUM_CLOSESOCK(s);\0A        return -1;\0A    }\0A\0A    struct sockaddr_in addr;\0A    memset(&addr, 0, sizeof(addr));\0A    addr.sin_family = AF_INET;\0A    addr.sin_addr.s_addr = INADDR_ANY;\0A    addr.sin_port = htons((unsigned short)port);\0A\0A    if (bind(s, (struct sockaddr *)&addr, sizeof(addr)) != 0) {\0A        PLUM_CLOSESOCK(s);\0A        return -1;\0A    }\0A    if (listen(s, 128) != 0) {\0A        PLUM_CLOSESOCK(s);\0A        return -1;\0A    }\0A    return (long long)s;\0A}\0A\0A// `accept(2)`, discarding the peer's own address (Plum has no way to\0A// receive it back — same \22no multi-value FFI return\22 limit that ruled\0A// UDP's `recvfrom` out of this v1 pass entirely, see DESIGN.md). Blocks\0A// until a connection arrives. Returns the new connection's fd, or -1.\0Along long tcp_accept(long long fd) {\0A    return plum_sock_out(accept((plum_sock)fd, NULL, NULL));\0A}\0A\0A// Blocking send of exactly `len` bytes of `buf`. Returns the number of\0A// bytes actually sent, or -1 on error — a short write (fewer bytes sent\0A// than `len`, without an outright error) is possible under real POSIX\0A// semantics and is NOT retried here; the Plum-level wrapper is\0A// responsible for looping if it cares (matches this shim's own\0A// \22thin adapter, no retry policy of its own\22 scope elsewhere).\0Along long tcp_send(long long fd, const char *buf, long long len) {\0A    // Winsock's length is `int`, POSIX's is `size_t`; the macro keeps\0A    // the one narrowing cast in a single place.\0A    return (long long)send((plum_sock)fd, buf, PLUM_ADDRLEN(len), 0);\0A}\0A\0A// --- The receive buffer ---\0A//\0A// **Owned HERE**, grown on demand and reused across calls, valid until\0A// the next call to either receive function. Same convention as\0A// `io_shim.c`, and adopted for the same reason its header gives: the\0A// extern boundary hands Plum no way to free a caller-owned buffer, so\0A// `malloc`-and-hand-over is a leak of one buffer per read.\0A//\0A// `tcp_recv` DID that -- it `malloc`ed a fresh buffer per call and\0A// returned it, and nothing ever freed one. A server looping on reads\0A// leaked its whole traffic volume. Nothing caught it because\0A// `net-smoke` is the only harness that runs socket code and it does not\0A// run under ASan. Both receive functions share this buffer now, which\0A// removes the leak as a side effect of needing the buffer anyway.\0A//\0A// The contract change for `tcp_recv` is real but narrow: its result is\0A// now only valid until the next receive on any socket. Its one caller,\0A// `Net.read`, does `.as_string()` immediately -- which COPIES, because\0A// whatever C handed back may be a static buffer, which is exactly the\0A// case the copy exists for.\0A//\0A// **Thread-local**, which `io_shim.c`'s buffers are not and do not need\0A// to be -- a language server reads its requests on one thread, in order.\0A// Sockets are the opposite: `Http.serve_once` runs inside a `spawn`\0A// while the client reads on another thread, so a shared buffer is two\0A// threads writing one array.\0A//\0A// Measured, not anticipated. A single shared buffer failed `net-smoke`'s\0A// HTTP round trip 1 run in 10, against 10 for 10 on the previous\0A// `malloc`-per-call version -- the old code was leaky AND thread-safe,\0A// and the first version of this fix traded one for the other. One\0A// buffer per reading thread keeps both.\0A//\0A// Never freed, deliberately, and now bounded by the number of threads\0A// that read from a socket rather than by the number of reads -- which\0A// is the actual difference from what this replaced. There is no\0A// portable thread-exit hook to free it from (`pthread_key_t` with a\0A// destructor is POSIX-only, and this file already compiles for\0A// Winsock), and process exit reclaims it.\0A#if defined(_MSC_VER)\0A#define PLUM_TLS __declspec(thread)\0A#else\0A#define PLUM_TLS _Thread_local\0A#endif\0A\0Astatic PLUM_TLS char *recv_buf = NULL;\0Astatic PLUM_TLS size_t recv_cap = 0;\0A\0Astatic int recv_ensure(size_t need) {\0A    if (recv_cap >= need) return 1;\0A    size_t next = recv_cap ? recv_cap : 4096;\0A    while (next < need) next *= 2;\0A    char *bigger = (char *)realloc(recv_buf, next);\0A    if (bigger == NULL) return 0;\0A    recv_buf = bigger;\0A    recv_cap = next;\0A    return 1;\0A}\0A\0A// See this file's own top doc comment for the full \22why CStr, why\0A// always non-null\22 reasoning. Never returns NULL: an allocation failure\0A// falls back to a real (still non-null) empty-string static buffer\0A// rather than ever tripping Plum's null-CStr-return abort.\0A//\0A// Still NUL-terminated and still not binary-safe. That is deliberate\0A// and its contract is unchanged: `Net.read` returns a `String`, and a\0A// `String` is a promise about encoding that arbitrary socket bytes do\0A// not keep. `tcp_recv_n` below is the binary-safe path, added ALONGSIDE\0A// rather than by changing this one.\0Aconst char *tcp_recv(long long fd, long long max_len) {\0A    if (max_len < 0) {\0A        max_len = 0;\0A    }\0A    max_len = PLUM_IO_LEN(max_len);\0A    if (!recv_ensure((size_t)max_len + 1)) {\0A        return \22\22;\0A    }\0A    long long n = (long long)recv((plum_sock)fd, recv_buf, PLUM_ADDRLEN(max_len), 0);\0A    if (n < 0) {\0A        n = 0;\0A    }\0A    recv_buf[n] = '\5C0';\0A    return recv_buf;\0A}\0A\0A// The binary-safe receive: up to `max_len` bytes into the shared buffer,\0A// returning the COUNT rather than a pointer.\0A//\0A// A count is the whole point. A `CStr` return cannot carry a length, so\0A// `tcp_recv` has to NUL-terminate and the caller has to `strlen` -- which\0A// silently truncates any payload containing a zero byte. Splitting the\0A// answer across two calls (`tcp_recv_n` then `tcp_recv_data`) is what\0A// Plum's extern surface allows: no out-parameters, no multi-value\0A// return, and no raw pointers with a separate length.\0A//\0A// Three outcomes, kept DISTINCT, which is the other thing `tcp_recv`\0A// cannot express:\0A//\0A//   > 0   that many bytes are in the buffer\0A//   = 0   the peer closed cleanly -- end of stream, not a failure\0A//   < 0   a real socket error\0A//\0A// `tcp_recv` collapses the last two into `\22\22`, documented as a v1 trade.\0A// A binary reader cannot live with that collapse: an empty read is an\0A// ordinary event in the middle of a length-framed protocol.\0Along long tcp_recv_n(long long fd, long long max_len) {\0A    if (max_len < 0) {\0A        max_len = 0;\0A    }\0A    max_len = PLUM_IO_LEN(max_len);\0A    if (!recv_ensure((size_t)max_len + 1)) {\0A        return -1;\0A    }\0A    long long n = (long long)recv((plum_sock)fd, recv_buf, PLUM_ADDRLEN(max_len), 0);\0A    if (n < 0) {\0A        return -1;\0A    }\0A    recv_buf[n] = '\5C0';\0A    return n;\0A}\0A\0A// The bytes `tcp_recv_n` just read. Valid until the next receive, and\0A// meaningful only together with the count that call returned -- the\0A// buffer is NOT NUL-delimited data, and reading it with `strlen` is\0A// exactly the bug this pair exists to avoid.\0A//\0A// Never NULL, for the same reason nothing else here is: a null `CStr`\0A// return is a hard runtime abort under Plum's FFI semantics.\0Aconst char *tcp_recv_data(void) {\0A    return recv_buf ? recv_buf : \22\22;\0A}\0A\0Avoid tcp_close(long long fd) {\0A    PLUM_CLOSESOCK((plum_sock)fd);\0A}\0A\00" }
