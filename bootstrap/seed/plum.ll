on an <tt>\5C#include</tt> line.\0A *\0A * The value of this symbol is typically a path in double quotes, either\0A * absolute or relative to a directory on the include search path.\0A */\0A//#define MBEDTLS_PSA_CRYPTO_USER_CONFIG_FILE \22/dev/null\22\0A\0A/**\0A * \5Cdef MBEDTLS_PSA_CRYPTO_PLATFORM_FILE\0A *\0A * If defined, this is a header which will be included instead of\0A * `\22psa/crypto_platform.h\22`. This file should declare the same identifiers\0A * as the one in Mbed TLS, but with definitions adapted to the platform on\0A * which the library code will run.\0A *\0A * \5Cnote The required content of this header can vary from one version of\0A *       Mbed TLS to the next. Integrators who provide an alternative file\0A *       should review the changes in the original file whenever they\0A *       upgrade Mbed TLS.\0A *\0A * This macro is expanded after an <tt>\5C#include</tt> directive. This is a popular but\0A * non-standard feature of the C language, so this feature is only available\0A * with compilers that perform macro expansion on an <tt>\5C#include</tt> line.\0A *\0A * The value of this symbol is typically a path in double quotes, either\0A * absolute or relative to a directory on the include search path.\0A */\0A//#define MBEDTLS_PSA_CRYPTO_PLATFORM_FILE \22psa/crypto_platform_alt.h\22\0A\0A/**\0A * \5Cdef MBEDTLS_PSA_CRYPTO_STRUCT_FILE\0A *\0A * If defined, this is a header which will be included instead of\0A * `\22psa/crypto_struct.h\22`. This file should declare the same identifiers\0A * as the one in Mbed TLS, but with definitions adapted to the environment\0A * in which the library code will run. The typical use for this feature\0A * is to provide alternative type definitions on the client side in\0A * client-server integrations of PSA crypto, where operation structures\0A * contain handles instead of cryptographic data.\0A *\0A * \5Cnote The required content of this header can vary from one version of\0A *       Mbed TLS to the next. Integrators who provide an alternative file\0A *       should review the changes in the original file whenever they\0A *       upgrade Mbed TLS.\0A *\0A * This macro is expanded after an <tt>\5C#include</tt> directive. This is a popular but\0A * non-standard feature of the C language, so this feature is only available\0A * with compilers that perform macro expansion on an <tt>\5C#include</tt> line.\0A *\0A * The value of this symbol is typically a path in double quotes, either\0A * absolute or relative to a directory on the include search path.\0A */\0A//#define MBEDTLS_PSA_CRYPTO_STRUCT_FILE \22psa/crypto_struct_alt.h\22\0A\0A/** \5C} name SECTION: General configuration options */\0A\0A/**\0A * \5Cname SECTION: Module configuration options\0A *\0A * This section allows for the setting of module specific sizes and\0A * configuration options. The default values are already present in the\0A * relevant header files and should suffice for the regular use cases.\0A *\0A * Our advice is to enable options and change their values here\0A * only if you have a good reason and know the consequences.\0A * \5C{\0A */\0A/* The Doxygen documentation here is used when a user comments out a\0A * setting and runs doxygen themselves. On the other hand, when we typeset\0A * the full documentation including disabled settings, the documentation\0A * in specific modules' header files is used if present. When editing this\0A * file, make sure that each option is documented in exactly one place,\0A * plus optionally a same-line Doxygen comment here if there is a Doxygen\0A * comment in the specific module. */\0A\0A/* MPI / BIGNUM options */\0A//#define MBEDTLS_MPI_WINDOW_SIZE            2 /**< Maximum window size used. */\0A//#define MBEDTLS_MPI_MAX_SIZE            1024 /**< Maximum number of bytes for usable MPIs. */\0A\0A/* CTR_DRBG options */\0A//#define MBEDTLS_CTR_DRBG_ENTROPY_LEN               48 /**< Amount of entropy used per seed by default (48 with SHA-512, 32 with SHA-256) */\0A//#define MBEDTLS_CTR_DRBG_RESEED_INTERVAL        10000 /**< Interval before reseed is performed by default */\0A//#define MBEDTLS_CTR_DRBG_MAX_INPUT                256 /**< Maximum number of additional input bytes */\0A//#define MBEDTLS_CTR_DRBG_MAX_REQUEST             1024 /**< Maximum number of requested bytes per call */\0A//#define MBEDTLS_CTR_DRBG_MAX_SEED_INPUT           384 /**< Maximum size of (re)seed buffer */\0A\0A/* HMAC_DRBG options */\0A//#define MBEDTLS_HMAC_DRBG_RESEED_INTERVAL   10000 /**< Interval before reseed is performed by default */\0A//#define MBEDTLS_HMAC_DRBG_MAX_INPUT           256 /**< Maximum number of additional input bytes */\0A//#define MBEDTLS_HMAC_DRBG_MAX_REQUEST        1024 /**< Maximum number of requested bytes per call */\0A//#define MBEDTLS_HMAC_DRBG_MAX_SEED_INPUT      384 /**< Maximum size of (re)seed buffer */\0A\0A/* ECP options */\0A//#define MBEDTLS_ECP_WINDOW_SIZE            4 /**< Maximum window size used */\0A//#define MBEDTLS_ECP_FIXED_POINT_OPTIM      1 /**< Enable fixed-point speed-up */\0A\0A/* Entropy options */\0A//#define MBEDTLS_ENTROPY_MAX_SOURCES                20 /**< Maximum number of sources supported */\0A//#define MBEDTLS_ENTROPY_MAX_GATHER                128 /**< Maximum amount requested from entropy sources */\0A//#define MBEDTLS_ENTROPY_MIN_HARDWARE               32 /**< Default minimum number of bytes required for the hardware entropy source mbedtls_hardware_poll() before entropy is released */\0A\0A/* Memory buffer allocator options */\0A//#define MBEDTLS_MEMORY_ALIGN_MULTIPLE      4 /**< Align on multiples of this value */\0A\0A/* Platform options */\0A//#define MBEDTLS_PLATFORM_STD_MEM_HDR   <stdlib.h> /**< Header to include if MBEDTLS_PLATFORM_NO_STD_FUNCTIONS is defined. Don't define if no header is needed. */\0A\0A/** \5Cdef MBEDTLS_PLATFORM_STD_CALLOC\0A *\0A * Default allocator to use, can be undefined.\0A * It must initialize the allocated buffer memory to zeroes.\0A * The size of the buffer is the product of the two parameters.\0A * The calloc function returns either a null pointer or a pointer to the allocated space.\0A * If the product is 0, the function may either return NULL or a valid pointer to an array of size 0 which is a valid input to the deallocation function.\0A * An uninitialized #MBEDTLS_PLATFORM_STD_CALLOC always fails, returning a null pointer.\0A * See the description of #MBEDTLS_PLATFORM_MEMORY for more details.\0A * The corresponding deallocation function is #MBEDTLS_PLATFORM_STD_FREE.\0A */\0A//#define MBEDTLS_PLATFORM_STD_CALLOC        calloc\0A\0A/** \5Cdef MBEDTLS_PLATFORM_STD_FREE\0A *\0A * Default free to use, can be undefined.\0A * NULL is a valid parameter, and the function must do nothing.\0A * A non-null parameter will always be a pointer previously returned by #MBEDTLS_PLATFORM_STD_CALLOC and not yet freed.\0A * An uninitialized #MBEDTLS_PLATFORM_STD_FREE does not do anything.\0A * See the description of #MBEDTLS_PLATFORM_MEMORY for more details (same principles as for MBEDTLS_PLATFORM_STD_CALLOC apply).\0A */\0A//#define MBEDTLS_PLATFORM_STD_FREE            free\0A//#define MBEDTLS_PLATFORM_STD_SETBUF      setbuf /**< Default setbuf to use, can be undefined */\0A//#define MBEDTLS_PLATFORM_STD_EXIT            exit /**< Default exit to use, can be undefined */\0A//#define MBEDTLS_PLATFORM_STD_TIME            time /**< Default time to use, can be undefined. MBEDTLS_HAVE_TIME must be enabled */\0A//#define MBEDTLS_PLATFORM_STD_FPRINTF      fprintf /**< Default fprintf to use, can be undefined */\0A//#define MBEDTLS_PLATFORM_STD_PRINTF        printf /**< Default printf to use, can be undefined */\0A/* Note: your snprintf must correctly zero-terminate the buffer! */\0A//#define MBEDTLS_PLATFORM_STD_SNPRINTF    snprintf /**< Default snprintf to use, can be undefined */\0A//#define MBEDTLS_PLATFORM_STD_EXIT_SUCCESS       0 /**< Default exit value to use, can be undefined */\0A//#define MBEDTLS_PLATFORM_STD_EXIT_FAILURE       1 /**< Default exit value to use, can be undefined */\0A//#define MBEDTLS_PLATFORM_STD_NV_SEED_READ   mbedtls_platform_std_nv_seed_read /**< Default nv_seed_read function to use, can be undefined */\0A//#define MBEDTLS_PLATFORM_STD_NV_SEED_WRITE  mbedtls_platform_std_nv_seed_write /**< Default nv_seed_write function to use, can be undefined */\0A//#define MBEDTLS_PLATFORM_STD_NV_SEED_FILE  \22seedfile\22 /**< Seed file to read/write with default implementation */\0A\0A/* To use the following function macros, MBEDTLS_PLATFORM_C must be enabled. */\0A/* MBEDTLS_PLATFORM_XXX_MACRO and MBEDTLS_PLATFORM_XXX_ALT cannot both be defined */\0A//#define MBEDTLS_PLATFORM_CALLOC_MACRO        calloc /**< Default allocator macro to use, can be undefined. See MBEDTLS_PLATFORM_STD_CALLOC for requirements. */\0A//#define MBEDTLS_PLATFORM_FREE_MACRO            free /**< Default free macro to use, can be undefined. See MBEDTLS_PLATFORM_STD_FREE for requirements. */\0A//#define MBEDTLS_PLATFORM_EXIT_MACRO            exit /**< Default exit macro to use, can be undefined */\0A//#define MBEDTLS_PLATFORM_SETBUF_MACRO      setbuf /**< Default setbuf macro to use, can be undefined */\0A//#define MBEDTLS_PLATFORM_TIME_MACRO            time /**< Default time macro to use, can be undefined. MBEDTLS_HAVE_TIME must be enabled */\0A//#define MBEDTLS_PLATFORM_TIME_TYPE_MACRO       time_t /**< Default time macro to use, can be undefined. MBEDTLS_HAVE_TIME must be enabled */\0A//#define MBEDTLS_PLATFORM_FPRINTF_MACRO      fprintf /**< Default fprintf macro to use, can be undefined */\0A//#define MBEDTLS_PLATFORM_PRINTF_MACRO        printf /**< Default printf macro to use, can be undefined */\0A/* Note: your snprintf must correctly zero-terminate the buffer! */\0A//#define MBEDTLS_PLATFORM_SNPRINTF_MACRO    snprintf /**< Default snprintf macro to use, can be undefined */\0A//#define MBEDTLS_PLATFORM_VSNPRINTF_MACRO    vsnprintf /**< Default vsnprintf macro to use, can be undefined */\0A//#define MBEDTLS_PLATFORM_NV_SEED_READ_MACRO   mbedtls_platform_std_nv_seed_read /**< Default nv_seed_read function to use, can be undefined */\0A//#define MBEDTLS_PLATFORM_NV_SEED_WRITE_MACRO  mbedtls_platform_std_nv_seed_write /**< Default nv_seed_write function to use, can be undefined */\0A//#define MBEDTLS_PLATFORM_MS_TIME_TYPE_MACRO   int64_t //#define MBEDTLS_PLATFORM_MS_TIME_TYPE_MACRO   int64_t /**< Default milliseconds time macro to use, can be undefined. MBEDTLS_HAVE_TIME must be enabled. It must be signed, and at least 64 bits. If it is changed from the default, MBEDTLS_PRINTF_MS_TIME must be updated to match.*/\0A//#define MBEDTLS_PRINTF_MS_TIME    PRId64 /**< Default fmt for printf. That's avoid compiler warning if mbedtls_ms_time_t is redefined */\0A\0A/** \5Cdef MBEDTLS_CHECK_RETURN\0A *\0A * This macro is used at the beginning of the declaration of a function\0A * to indicate that its return value should be checked. It should\0A * instruct the compiler to emit a warning or an error if the function\0A * is called without checking its return value.\0A *\0A * There is a default implementation for popular compilers in platform_util.h.\0A * You can override the default implementation by defining your own here.\0A *\0A * If the implementation here is empty, this will effectively disable the\0A * checking of functions' return values.\0A */\0A//#define MBEDTLS_CHECK_RETURN __attribute__((__warn_unused_result__))\0A\0A/** \5Cdef MBEDTLS_IGNORE_RETURN\0A *\0A * This macro requires one argument, which should be a C function call.\0A * If that function call would cause a #MBEDTLS_CHECK_RETURN warning, this\0A * warning is suppressed.\0A */\0A//#define MBEDTLS_IGNORE_RETURN( result ) ((void) !(result))\0A\0A/* PSA options */\0A/**\0A * Use HMAC_DRBG with the specified hash algorithm for HMAC_DRBG for the\0A * PSA crypto subsystem.\0A *\0A * If this option is unset, the library chooses a hash (currently between\0A * #MBEDTLS_MD_SHA512 and #MBEDTLS_MD_SHA256) based on availability and\0A * unspecified heuristics.\0A *\0A * \5Cnote The PSA crypto subsystem uses the first available mechanism amongst\0A *       the following:\0A *       - #MBEDTLS_PSA_CRYPTO_EXTERNAL_RNG if enabled;\0A *       - Entropy from #MBEDTLS_ENTROPY_C plus CTR_DRBG with AES\0A *         if #MBEDTLS_CTR_DRBG_C is enabled;\0A *       - Entropy from #MBEDTLS_ENTROPY_C plus HMAC_DRBG.\0A *\0A *       A future version may reevaluate the prioritization of DRBG mechanisms.\0A */\0A//#define MBEDTLS_PSA_HMAC_DRBG_MD_TYPE MBEDTLS_MD_SHA256\0A\0A/** \5Cdef MBEDTLS_PSA_KEY_SLOT_COUNT\0A *\0A * When #MBEDTLS_PSA_KEY_STORE_DYNAMIC is disabled,\0A * the maximum amount of PSA keys simultaneously in memory. This counts all\0A * volatile keys, plus loaded persistent keys.\0A *\0A * When #MBEDTLS_PSA_KEY_STORE_DYNAMIC is enabled,\0A * the maximum number of loaded persistent keys.\0A *\0A * Currently, persistent keys do not need to be loaded all the time while\0A * a multipart operation is in progress, only while the operation is being\0A * set up. This may change in future versions of the library.\0A *\0A * Currently, the library traverses of the whole table on each access to a\0A * persistent key. Therefore large values may cause poor performance.\0A *\0A * This option has no effect when #MBEDTLS_PSA_CRYPTO_C is disabled.\0A */\0A//#define MBEDTLS_PSA_KEY_SLOT_COUNT 32\0A\0A/**\0A * \5Cdef MBEDTLS_PSA_STATIC_KEY_SLOT_BUFFER_SIZE\0A *\0A * Define the size (in bytes) of each static key buffer when\0A * #MBEDTLS_PSA_STATIC_KEY_SLOTS is set. If not\0A * explicitly defined then it's automatically guessed from available PSA keys\0A * enabled in the build through PSA_WANT_xxx symbols.\0A * If required by the application this parameter can be set to higher values\0A * in order to store larger objects (ex: raw keys), but please note that this\0A * will increase RAM usage.\0A */\0A//#define MBEDTLS_PSA_STATIC_KEY_SLOT_BUFFER_SIZE       256\0A\0A/* RSA OPTIONS */\0A//#define MBEDTLS_RSA_GEN_KEY_MIN_BITS            1024 /**<  Minimum RSA key size that can be generated in bits (Minimum possible value is 128 bits) */\0A\0A/* SSL Cache options */\0A//#define MBEDTLS_SSL_CACHE_DEFAULT_TIMEOUT       86400 /**< 1 day  */\0A//#define MBEDTLS_SSL_CACHE_DEFAULT_MAX_ENTRIES      50 /**< Maximum entries in cache */\0A\0A/* SSL options */\0A\0A/** \5Cdef MBEDTLS_SSL_IN_CONTENT_LEN\0A *\0A * Maximum length (in bytes) of incoming plaintext fragments.\0A *\0A * This determines the size of the incoming TLS I/O buffer in such a way\0A * that it is capable of holding the specified amount of plaintext data,\0A * regardless of the protection mechanism used.\0A *\0A * \5Cnote When using a value less than the default of 16KB on the client, it is\0A *       recommended to use the Maximum Fragment Length (MFL) extension to\0A *       inform the server about this limitation. On the server, there\0A *       is no supported, standardized way of informing the client about\0A *       restriction on the maximum size of incoming messages, and unless\0A *       the limitation has been communicated by other means, it is recommended\0A *       to only change the outgoing buffer size #MBEDTLS_SSL_OUT_CONTENT_LEN\0A *       while keeping the default value of 16KB for the incoming buffer.\0A *\0A * Uncomment to set the maximum plaintext size of the incoming I/O buffer.\0A */\0A//#define MBEDTLS_SSL_IN_CONTENT_LEN              16384\0A\0A/** \5Cdef MBEDTLS_SSL_CID_IN_LEN_MAX\0A *\0A * The maximum length of CIDs used for incoming DTLS messages.\0A *\0A */\0A//#define MBEDTLS_SSL_CID_IN_LEN_MAX 32\0A\0A/** \5Cdef MBEDTLS_SSL_CID_OUT_LEN_MAX\0A *\0A * The maximum length of CIDs used for outgoing DTLS messages.\0A *\0A */\0A//#define MBEDTLS_SSL_CID_OUT_LEN_MAX 32\0A\0A/** \5Cdef MBEDTLS_SSL_CID_TLS1_3_PADDING_GRANULARITY\0A *\0A * This option controls the use of record plaintext padding\0A * in TLS 1.3 and when using the Connection ID extension in DTLS 1.2.\0A *\0A * The padding will always be chosen so that the length of the\0A * padded plaintext is a multiple of the value of this option.\0A *\0A * Note: A value of \5Cc 1 means that no padding will be used\0A *       for outgoing records.\0A *\0A * Note: On systems lacking division instructions,\0A *       a power of two should be preferred.\0A */\0A//#define MBEDTLS_SSL_CID_TLS1_3_PADDING_GRANULARITY 16\0A\0A/** \5Cdef MBEDTLS_SSL_OUT_CONTENT_LEN\0A *\0A * Maximum length (in bytes) of outgoing plaintext fragments.\0A *\0A * This determines the size of the outgoing TLS I/O buffer in such a way\0A * that it is capable of holding the specified amount of plaintext data,\0A * regardless of the protection mechanism used.\0A *\0A * It is possible to save RAM by setting a smaller outward buffer, while keeping\0A * the default inward 16384 byte buffer to conform to the TLS specification.\0A *\0A * The minimum required outward buffer size is determined by the handshake\0A * protocol's usage. Handshaking will fail if the outward buffer is too small.\0A * The specific size requirement depends on the configured ciphers and any\0A * certificate data which is sent during the handshake.\0A *\0A * Uncomment to set the maximum plaintext size of the outgoing I/O buffer.\0A */\0A//#define MBEDTLS_SSL_OUT_CONTENT_LEN             16384\0A\0A/** \5Cdef MBEDTLS_SSL_DTLS_MAX_BUFFERING\0A *\0A * Maximum number of heap-allocated bytes for the purpose of\0A * DTLS handshake message reassembly and future message buffering.\0A *\0A * This should be at least 9/8 * MBEDTLS_SSL_IN_CONTENT_LEN\0A * to account for a reassembled handshake message of maximum size,\0A * together with its reassembly bitmap.\0A *\0A * A value of 2 * MBEDTLS_SSL_IN_CONTENT_LEN (32768 by default)\0A * should be sufficient for all practical situations as it allows\0A * to reassembly a large handshake message (such as a certificate)\0A * while buffering multiple smaller handshake messages.\0A *\0A */\0A//#define MBEDTLS_SSL_DTLS_MAX_BUFFERING             32768\0A\0A//#define MBEDTLS_PSK_MAX_LEN               32 /**< Max size of TLS pre-shared keys, in bytes (default 256 or 384 bits) */\0A//#define MBEDTLS_SSL_COOKIE_TIMEOUT        60 /**< Default expiration delay of DTLS cookies, in seconds if HAVE_TIME, or in number of cookies issued */\0A\0A/**\0A * Complete list of ciphersuites to use, in order of preference.\0A *\0A * \5Cwarning No dependency checking is done on that field! This option can only\0A * be used to restrict the set of available ciphersuites. It is your\0A * responsibility to make sure the needed modules are active.\0A *\0A * Use this to save a few hundred bytes of ROM (default ordering of all\0A * available ciphersuites) and a few to a few hundred bytes of RAM.\0A *\0A * The value below is only an example, not the default.\0A */\0A//#define MBEDTLS_SSL_CIPHERSUITES MBEDTLS_TLS_ECDHE_ECDSA_WITH_AES_256_GCM_SHA384,MBEDTLS_TLS_ECDHE_ECDSA_WITH_AES_128_GCM_SHA256\0A\0A/**\0A * \5Cdef MBEDTLS_SSL_MAX_EARLY_DATA_SIZE\0A *\0A * The default maximum amount of 0-RTT data. See the documentation of\0A * \5Cc mbedtls_ssl_conf_max_early_data_size() for more information.\0A *\0A * It must be positive and smaller than UINT32_MAX.\0A *\0A * If MBEDTLS_SSL_EARLY_DATA is not defined, this default value does not\0A * have any impact on the build.\0A */\0A//#define MBEDTLS_SSL_MAX_EARLY_DATA_SIZE        1024\0A\0A/**\0A * \5Cdef MBEDTLS_SSL_TLS1_3_TICKET_AGE_TOLERANCE\0A *\0A * Maximum allowed ticket age difference in milliseconds tolerated between\0A * server and client. Default value is 6000. This is not used in TLS 1.2.\0A *\0A * - The client ticket age is the time difference between the time when the\0A *   client proposes to the server to use the ticket and the time the client\0A *   received the ticket from the server.\0A * - The server ticket age is the time difference between the time when the\0A *   server receives a proposition from the client to use the ticket and the\0A *   time when the ticket was created by the server.\0A *\0A * The ages might be different due to the client and server clocks not running\0A * at the same pace. The typical accuracy of an RTC crystal is ±100 to ±20 parts\0A * per million (360 to 72 milliseconds per hour). Default tolerance window is\0A * 6s, thus in the worst case clients and servers must sync up their system time\0A * every 6000/360/2~=8 hours.\0A *\0A * See section 8.3 of the TLS 1.3 specification(RFC 8446) for more information.\0A */\0A//#define MBEDTLS_SSL_TLS1_3_TICKET_AGE_TOLERANCE 6000\0A\0A/**\0A * \5Cdef MBEDTLS_SSL_TLS1_3_TICKET_NONCE_LENGTH\0A *\0A * Size in bytes of a ticket nonce. This is not used in TLS 1.2.\0A *\0A * This must be less than 256.\0A */\0A//#define MBEDTLS_SSL_TLS1_3_TICKET_NONCE_LENGTH 32\0A\0A/**\0A * \5Cdef MBEDTLS_SSL_TLS1_3_DEFAULT_NEW_SESSION_TICKETS\0A *\0A * Default number of NewSessionTicket messages to be sent by a TLS 1.3 server\0A * after handshake completion. This is not used in TLS 1.2 and relevant only if\0A * the MBEDTLS_SSL_SESSION_TICKETS option is enabled.\0A *\0A */\0A//#define MBEDTLS_SSL_TLS1_3_DEFAULT_NEW_SESSION_TICKETS 1\0A\0A/* X509 options */\0A//#define MBEDTLS_X509_MAX_INTERMEDIATE_CA   8   /**< Maximum number of intermediate CAs in a verification chain. */\0A//#define MBEDTLS_X509_MAX_FILE_PATH_LEN     512 /**< Maximum length of a path/filename string in bytes including the null terminator character ('\5C0'). */\0A\0A/** \5C} name SECTION: Module configuration options */\0A\00" }
