@.str40233 = private global { i64, i64, [19419 x i8] } { i64 -1, i64 19418, [19419 x i8] c"/*\0A *  Message Processing Stack, Reader implementation\0A *\0A *  Copyright The Mbed TLS Contributors\0A *  SPDX-License-Identifier: Apache-2.0 OR GPL-2.0-or-later\0A */\0A\0A#include \22common.h\22\0A\0A#if defined(MBEDTLS_SSL_PROTO_TLS1_3)\0A\0A#include \22mps_reader.h\22\0A#include \22mps_common.h\22\0A#include \22mps_trace.h\22\0A\0A#include <string.h>\0A\0A#if defined(MBEDTLS_MPS_ENABLE_TRACE)\0Astatic int mbedtls_mps_trace_id = MBEDTLS_MPS_TRACE_BIT_READER;\0A#endif /* MBEDTLS_MPS_ENABLE_TRACE */\0A\0A/*\0A * GENERAL NOTE ON CODING STYLE\0A *\0A * The following code intentionally separates memory loads\0A * and stores from other operations (arithmetic or branches).\0A * This leads to the introduction of many local variables\0A * and significantly increases the C-code line count, but\0A * should not increase the size of generated assembly.\0A *\0A * The reason for this is twofold:\0A * (1) It will ease verification efforts using the VST\0A *     (Verified Software Toolchain)\0A *     whose program logic cannot directly reason\0A *     about instructions containing a load or store in\0A *     addition to other operations (e.g. *p = *q or\0A *     tmp = *p + 42).\0A * (2) Operating on local variables and writing the results\0A *     back to the target contexts on success only\0A *     allows to maintain structure invariants even\0A *     on failure - this in turn has two benefits:\0A *     (2.a) If for some reason an error code is not caught\0A *           and operation continues, functions are nonetheless\0A *           called with sane contexts, reducing the risk\0A *           of dangerous behavior.\0A *     (2.b) Randomized testing is easier if structures\0A *           remain intact even in the face of failing\0A *           and/or non-sensical calls.\0A *     Moreover, it might even reduce code-size because\0A *     the compiler need not write back temporary results\0A *     to memory in case of failure.\0A *\0A */\0A\0Astatic inline int mps_reader_is_accumulating(\0A    mbedtls_mps_reader const *rd)\0A{\0A    mbedtls_mps_size_t acc_remaining;\0A    if (rd->acc == NULL) {\0A        return 0;\0A    }\0A\0A    acc_remaining = rd->acc_share.acc_remaining;\0A    return acc_remaining > 0;\0A}\0A\0Astatic inline int mps_reader_is_producing(\0A    mbedtls_mps_reader const *rd)\0A{\0A    unsigned char *frag = rd->frag;\0A    return frag == NULL;\0A}\0A\0Astatic inline int mps_reader_is_consuming(\0A    mbedtls_mps_reader const *rd)\0A{\0A    return !mps_reader_is_producing(rd);\0A}\0A\0Astatic inline mbedtls_mps_size_t mps_reader_get_fragment_offset(\0A    mbedtls_mps_reader const *rd)\0A{\0A    unsigned char *acc = rd->acc;\0A    mbedtls_mps_size_t frag_offset;\0A\0A    if (acc == NULL) {\0A        return 0;\0A    }\0A\0A    frag_offset = rd->acc_share.frag_offset;\0A    return frag_offset;\0A}\0A\0Astatic inline mbedtls_mps_size_t mps_reader_serving_from_accumulator(\0A    mbedtls_mps_reader const *rd)\0A{\0A    mbedtls_mps_size_t frag_offset, end;\0A\0A    frag_offset = mps_reader_get_fragment_offset(rd);\0A    end = rd->end;\0A\0A    return end < frag_offset;\0A}\0A\0Astatic inline void mps_reader_zero(mbedtls_mps_reader *rd)\0A{\0A    /* A plain memset() would likely be more efficient,\0A     * but the current way of zeroing makes it harder\0A     * to overlook fields which should not be zero-initialized.\0A     * It's also more suitable for FV efforts since it\0A     * doesn't require reasoning about structs being\0A     * interpreted as unstructured binary blobs. */\0A    static mbedtls_mps_reader const zero =\0A    { .frag          = NULL,\0A      .frag_len      = 0,\0A      .commit        = 0,\0A      .end           = 0,\0A      .pending       = 0,\0A      .acc           = NULL,\0A      .acc_len       = 0,\0A      .acc_available = 0,\0A      .acc_share     = { .acc_remaining = 0 } };\0A    *rd = zero;\0A}\0A\0Aint mbedtls_mps_reader_init(mbedtls_mps_reader *rd,\0A                            unsigned char *acc,\0A                            mbedtls_mps_size_t acc_len)\0A{\0A    MBEDTLS_MPS_TRACE_INIT(\22mbedtls_mps_reader_init\22);\0A    MBEDTLS_MPS_TRACE(MBEDTLS_MPS_TRACE_TYPE_COMMENT,\0A                      \22* Accumulator size: %u bytes\22, (unsigned) acc_len);\0A    mps_reader_zero(rd);\0A    rd->acc = acc;\0A    rd->acc_len = acc_len;\0A    MBEDTLS_MPS_TRACE_RETURN(0);\0A}\0A\0Aint mbedtls_mps_reader_free(mbedtls_mps_reader *rd)\0A{\0A    MBEDTLS_MPS_TRACE_INIT(\22mbedtls_mps_reader_free\22);\0A    mps_reader_zero(rd);\0A    MBEDTLS_MPS_TRACE_RETURN(0);\0A}\0A\0Aint mbedtls_mps_reader_feed(mbedtls_mps_reader *rd,\0A                            unsigned char *new_frag,\0A                            mbedtls_mps_size_t new_frag_len)\0A{\0A    mbedtls_mps_size_t copy_to_acc;\0A    MBEDTLS_MPS_TRACE_INIT(\22mbedtls_mps_reader_feed\22);\0A    MBEDTLS_MPS_TRACE(MBEDTLS_MPS_TRACE_TYPE_COMMENT,\0A                      \22* Fragment length: %u bytes\22, (unsigned) new_frag_len);\0A\0A    if (new_frag == NULL) {\0A        MBEDTLS_MPS_TRACE_RETURN(MBEDTLS_ERR_MPS_READER_INVALID_ARG);\0A    }\0A\0A    MBEDTLS_MPS_STATE_VALIDATE_RAW(mps_reader_is_producing(\0A                                       rd),\0A                                   \22mbedtls_mps_reader_feed() requires reader to be in producing mode\22);\0A\0A    if (mps_reader_is_accumulating(rd)) {\0A        unsigned char *acc    = rd->acc;\0A        mbedtls_mps_size_t acc_remaining = rd->acc_share.acc_remaining;\0A        mbedtls_mps_size_t acc_available = rd->acc_available;\0A\0A        /* Skip over parts of the accumulator that have already been filled. */\0A        acc += acc_available;\0A\0A        copy_to_acc = acc_remaining;\0A        if (copy_to_acc > new_frag_len) {\0A            copy_to_acc = new_frag_len;\0A        }\0A\0A        /* Copy new contents to accumulator. */\0A        memcpy(acc, new_frag, copy_to_acc);\0A\0A        MBEDTLS_MPS_TRACE(MBEDTLS_MPS_TRACE_TYPE_COMMENT,\0A                          \22Copy new data of size %u of %u into accumulator at offset %u\22,\0A                          (unsigned) copy_to_acc, (unsigned) new_frag_len,\0A                          (unsigned) acc_available);\0A\0A        /* Check if, with the new fragment, we have enough data. */\0A        acc_remaining -= copy_to_acc;\0A        if (acc_remaining > 0) {\0A            /* We need to accumulate more data. Stay in producing mode. */\0A            acc_available += copy_to_acc;\0A            rd->acc_share.acc_remaining = acc_remaining;\0A            rd->acc_available = acc_available;\0A            MBEDTLS_MPS_TRACE_RETURN(MBEDTLS_ERR_MPS_READER_NEED_MORE);\0A        }\0A\0A        /* We have filled the accumulator: Move to consuming mode. */\0A\0A        MBEDTLS_MPS_TRACE(MBEDTLS_MPS_TRACE_TYPE_COMMENT,\0A                          \22Enough data available to serve user request\22);\0A\0A        /* Remember overlap of accumulator and fragment. */\0A        rd->acc_share.frag_offset = acc_available;\0A        acc_available += copy_to_acc;\0A        rd->acc_available = acc_available;\0A    } else { /* Not accumulating */\0A        rd->acc_share.frag_offset = 0;\0A    }\0A\0A    rd->frag = new_frag;\0A    rd->frag_len = new_frag_len;\0A    rd->commit = 0;\0A    rd->end = 0;\0A    MBEDTLS_MPS_TRACE_RETURN(0);\0A}\0A\0A\0Aint mbedtls_mps_reader_get(mbedtls_mps_reader *rd,\0A                           mbedtls_mps_size_t desired,\0A                           unsigned char **buffer,\0A                           mbedtls_mps_size_t *buflen)\0A{\0A    unsigned char *frag;\0A    mbedtls_mps_size_t frag_len, frag_offset, end, frag_fetched, frag_remaining;\0A    MBEDTLS_MPS_TRACE_INIT(\22mbedtls_mps_reader_get\22);\0A    MBEDTLS_MPS_TRACE(MBEDTLS_MPS_TRACE_TYPE_COMMENT,\0A                      \22* Bytes requested: %u\22, (unsigned) desired);\0A\0A    MBEDTLS_MPS_STATE_VALIDATE_RAW(mps_reader_is_consuming(\0A                                       rd),\0A                                   \22mbedtls_mps_reader_get() requires reader to be in consuming mode\22);\0A\0A    end = rd->end;\0A    frag_offset = mps_reader_get_fragment_offset(rd);\0A\0A    /* Check if we're still serving from the accumulator. */\0A    if (mps_reader_serving_from_accumulator(rd)) {\0A        /* Illustration of supported and unsupported cases:\0A         *\0A         * - Allowed #1\0A         *\0A         *                          +-----------------------------------+\0A         *                          |               frag                |\0A         *                          +-----------------------------------+\0A         *\0A         *             end end+desired\0A         *              |       |\0A         *        +-----v-------v-------------+\0A         *        |          acc              |\0A         *        +---------------------------+\0A         *                          |         |\0A         *                     frag_offset  acc_available\0A         *\0A         * - Allowed #2\0A         *\0A         *                          +-----------------------------------+\0A         *                          |               frag                |\0A         *                          +-----------------------------------+\0A         *\0A         *                  end          end+desired\0A         *                   |                |\0A         *        +----------v----------------v\0A         *        |          acc              |\0A         *        +---------------------------+\0A         *                          |         |\0A         *                   frag_offset acc_available\0A         *\0A         * - Not allowed #1 (could be served, but we don't actually use it):\0A         *\0A         *                      +-----------------------------------+\0A         *                      |               frag                |\0A         *                      +-----------------------------------+\0A         *\0A         *              end        end+desired\0A         *               |             |\0A         *        +------v-------------v------+\0A         *        |          acc              |\0A         *        +---------------------------+\0A         *                      |             |\0A         *                frag_offset   acc_available\0A         *\0A         *\0A         * - Not allowed #2 (can't be served with a contiguous buffer):\0A         *\0A         *                      +-----------------------------------+\0A         *                      |               frag                |\0A         *                      +-----------------------------------+\0A         *\0A         *              end                 end + desired\0A         *               |                        |\0A         *        +------v--------------------+   v\0A         *        |            acc            |\0A         *        +---------------------------+\0A         *                      |             |\0A         *                frag_offset   acc_available\0A         *\0A         * In case of Allowed #2 we're switching to serve from\0A         * `frag` starting from the next call to mbedtls_mps_reader_get().\0A         */\0A\0A        unsigned char *acc;\0A\0A        MBEDTLS_MPS_TRACE(MBEDTLS_MPS_TRACE_TYPE_COMMENT,\0A                          \22Serve the request from the accumulator\22);\0A        if (frag_offset - end < desired) {\0A            mbedtls_mps_size_t acc_available;\0A            acc_available = rd->acc_available;\0A            if (acc_available - end != desired) {\0A                /* It might be possible to serve some of these situations by\0A                 * making additional space in the accumulator, removing those\0A                 * parts that have already been committed.\0A                 * On the other hand, this brings additional complexity and\0A                 * enlarges the code size, while there doesn't seem to be a