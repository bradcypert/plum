@.str41567 = private global { i64, i64, [13651 x i8] } { i64 -1, i64 13650, [13651 x i8] c"/**\0A * \5Cfile ecp_invasive.h\0A *\0A * \5Cbrief ECP module: interfaces for invasive testing only.\0A *\0A * The interfaces in this file are intended for testing purposes only.\0A * They SHOULD NOT be made available in library integrations except when\0A * building the library for testing.\0A */\0A/*\0A *  Copyright The Mbed TLS Contributors\0A *  SPDX-License-Identifier: Apache-2.0 OR GPL-2.0-or-later\0A */\0A#ifndef MBEDTLS_ECP_INVASIVE_H\0A#define MBEDTLS_ECP_INVASIVE_H\0A\0A#include \22common.h\22\0A#include \22mbedtls/bignum.h\22\0A#include \22bignum_mod.h\22\0A#include \22mbedtls/ecp.h\22\0A\0A/*\0A * Curve modulus types\0A */\0Atypedef enum {\0A    MBEDTLS_ECP_MOD_NONE = 0,\0A    MBEDTLS_ECP_MOD_COORDINATE,\0A    MBEDTLS_ECP_MOD_SCALAR\0A} mbedtls_ecp_modulus_type;\0A\0Atypedef enum {\0A    MBEDTLS_ECP_VARIANT_NONE = 0,\0A    MBEDTLS_ECP_VARIANT_WITH_MPI_STRUCT,\0A    MBEDTLS_ECP_VARIANT_WITH_MPI_UINT\0A} mbedtls_ecp_variant;\0A\0A#if defined(MBEDTLS_TEST_HOOKS) && defined(MBEDTLS_ECP_LIGHT)\0A\0A/** Queries the ecp variant.\0A *\0A * \5Creturn  The id of the ecp variant.\0A */\0AMBEDTLS_STATIC_TESTABLE\0Ambedtls_ecp_variant mbedtls_ecp_get_variant(void);\0A\0A#if defined(MBEDTLS_ECP_MONTGOMERY_ENABLED)\0A/** Generate a private key on a Montgomery curve (Curve25519 or Curve448).\0A *\0A * This function implements key generation for the set of secret keys\0A * specified in [Curve25519] p. 5 and in [Curve448]. The resulting value\0A * has the lower bits masked but is not necessarily canonical.\0A *\0A * \5Cnote            - [Curve25519] http://cr.yp.to/ecdh/curve25519-20060209.pdf\0A *                  - [RFC7748] https://tools.ietf.org/html/rfc7748\0A *\0A * \5Cp high_bit      The position of the high-order bit of the key to generate.\0A *                  This is the bit-size of the key minus 1:\0A *                  254 for Curve25519 or 447 for Curve448.\0A * \5Cparam d         The randomly generated key. This is a number of size\0A *                  exactly \5Cp high_bit + 1 bits, with the least significant bits\0A *                  masked as specified in [Curve25519] and in [RFC7748] §5.\0A * \5Cparam f_rng     The RNG function.\0A * \5Cparam p_rng     The RNG context to be passed to \5Cp f_rng.\0A *\0A * \5Creturn          \5Cc 0 on success.\0A * \5Creturn          \5Cc MBEDTLS_ERR_ECP_xxx or MBEDTLS_ERR_MPI_xxx on failure.\0A */\0Aint mbedtls_ecp_gen_privkey_mx(size_t high_bit,\0A                               mbedtls_mpi *d,\0A                               int (*f_rng)(void *, unsigned char *, size_t),\0A                               void *p_rng);\0A\0A#endif /* MBEDTLS_ECP_MONTGOMERY_ENABLED */\0A\0A#if defined(MBEDTLS_ECP_DP_SECP192R1_ENABLED)\0A\0A/** Fast quasi-reduction modulo p192 (FIPS 186-3 D.2.1)\0A *\0A * This operation expects a 384 bit MPI and the result of the reduction\0A * is a 192 bit MPI.\0A *\0A * \5Cparam[in,out]   Np  The address of the MPI to be converted.\0A *                      Must have twice as many limbs as the modulus.\0A *                      Upon return this holds the reduced value. The bitlength\0A *                      of the reduced value is the same as that of the modulus\0A *                      (192 bits).\0A * \5Cparam[in]       Nn  The length of \5Cp Np in limbs.\0A */\0AMBEDTLS_STATIC_TESTABLE\0Aint mbedtls_ecp_mod_p192_raw(mbedtls_mpi_uint *Np, size_t Nn);\0A\0A#endif /* MBEDTLS_ECP_DP_SECP192R1_ENABLED */\0A\0A#if defined(MBEDTLS_ECP_DP_SECP224R1_ENABLED)\0A\0A/** Fast quasi-reduction modulo p224 (FIPS 186-3 D.2.2)\0A *\0A * \5Cparam[in,out]   X       The address of the MPI to be converted.\0A *                          Must have exact limb size that stores a 448-bit MPI\0A *                          (double the bitlength of the modulus).\0A *                          Upon return holds the reduced value which is\0A *                          in range `0 <= X < 2 * N` (where N is the modulus).\0A *                          The bitlength of the reduced value is the same as\0A *                          that of the modulus (224 bits).\0A * \5Cparam[in]       X_limbs The length of \5Cp X in limbs.\0A *\0A * \5Creturn          \5Cc 0 on success.\0A * \5Creturn          #MBEDTLS_ERR_ECP_BAD_INPUT_DATA if \5Cp X_limbs is not the\0A *                  limb size that sores a 448-bit MPI.\0A */\0AMBEDTLS_STATIC_TESTABLE\0Aint mbedtls_ecp_mod_p224_raw(mbedtls_mpi_uint *X, size_t X_limbs);\0A\0A#endif /* MBEDTLS_ECP_DP_SECP224R1_ENABLED */\0A\0A#if defined(MBEDTLS_ECP_DP_SECP256R1_ENABLED)\0A\0A/** Fast quasi-reduction modulo p256 (FIPS 186-3 D.2.3)\0A *\0A * \5Cparam[in,out]   X       The address of the MPI to be converted.\0A *                          Must have exact limb size that stores a 512-bit MPI\0A *                          (double the bitlength of the modulus).\0A *                          Upon return holds the reduced value which is\0A *                          in range `0 <= X < 2 * N` (where N is the modulus).\0A *                          The bitlength of the reduced value is the same as\0A *                          that of the modulus (256 bits).\0A * \5Cparam[in]       X_limbs The length of \5Cp X in limbs.\0A *\0A * \5Creturn          \5Cc 0 on success.\0A * \5Creturn          #MBEDTLS_ERR_ECP_BAD_INPUT_DATA if \5Cp X_limbs is not the\0A *                  limb size that sores a 512-bit MPI.\0A */\0AMBEDTLS_STATIC_TESTABLE\0Aint mbedtls_ecp_mod_p256_raw(mbedtls_mpi_uint *X, size_t X_limbs);\0A\0A#endif\0A\0A#if defined(MBEDTLS_ECP_DP_SECP521R1_ENABLED)\0A\0A/** Fast quasi-reduction modulo p521 = 2^521 - 1 (FIPS 186-3 D.2.5)\0A *\0A * \5Cparam[in,out]   X       The address of the MPI to be converted.\0A *                          Must have twice as many limbs as the modulus\0A *                          (the modulus is 521 bits long). Upon return this\0A *                          holds the reduced value. The reduced value is\0A *                          in range `0 <= X < 2 * N` (where N is the modulus).\0A *                          and its the bitlength is one plus the bitlength\0A *                          of the modulus.\0A * \5Cparam[in]       X_limbs The length of \5Cp X in limbs.\0A *\0A * \5Creturn          \5Cc 0 on success.\0A * \5Creturn          #MBEDTLS_ERR_ECP_BAD_INPUT_DATA if \5Cp X_limbs does not have\0A *                  twice as many limbs as the modulus.\0A */\0AMBEDTLS_STATIC_TESTABLE\0Aint mbedtls_ecp_mod_p521_raw(mbedtls_mpi_uint *X, size_t X_limbs);\0A\0A#endif /* MBEDTLS_ECP_DP_SECP521R1_ENABLED */\0A\0A#if defined(MBEDTLS_ECP_DP_SECP384R1_ENABLED)\0A\0A/** Fast quasi-reduction modulo p384 (FIPS 186-3 D.2.4)\0A *\0A * \5Cparam[in,out]   X       The address of the MPI to be converted.\0A *                          Must have exact limb size that stores a 768-bit MPI\0A *                          (double the bitlength of the modulus).\0A *                          Upon return holds the reduced value which is\0A *                          in range `0 <= X < 2 * N` (where N is the modulus).\0A *                          The bitlength of the reduced value is the same as\0A *                          that of the modulus (384 bits).\0A * \5Cparam[in]       X_limbs The length of \5Cp N in limbs.\0A *\0A * \5Creturn          \5Cc 0 on success.\0A * \5Creturn          #MBEDTLS_ERR_ECP_BAD_INPUT_DATA if \5Cp N_n does not have\0A *                  twice as many limbs as the modulus.\0A */\0AMBEDTLS_STATIC_TESTABLE\0Aint  mbedtls_ecp_mod_p384_raw(mbedtls_mpi_uint *X, size_t X_limbs);\0A\0A#endif /* MBEDTLS_ECP_DP_SECP384R1_ENABLED */\0A\0A#if defined(MBEDTLS_ECP_DP_SECP192K1_ENABLED)\0A\0A/** Fast quasi-reduction modulo p192k1 = 2^192 - R,\0A * with R = 2^32 + 2^12 + 2^8 + 2^7 + 2^6 + 2^3 + 1 = 0x01000011C9\0A *\0A * \5Cparam[in,out]   X       The address of the MPI to be converted.\0A *                          Must have exact limb size that stores a 384-bit MPI\0A *                          (double the bitlength of the modulus).\0A *                          Upon return holds the reduced value which is\0A *                          in range `0 <= X < 2 * N` (where N is the modulus).\0A *                          The bitlength of the reduced value is the same as\0A *                          that of the modulus (192 bits).\0A * \5Cparam[in]       X_limbs The length of \5Cp X in limbs.\0A *\0A * \5Creturn          \5Cc 0 on success.\0A * \5Creturn          #MBEDTLS_ERR_ECP_BAD_INPUT_DATA if \5Cp X does not have\0A *                  twice as many limbs as the modulus.\0A * \5Creturn          #MBEDTLS_ERR_ECP_ALLOC_FAILED if memory allocation failed.\0A */\0AMBEDTLS_STATIC_TESTABLE\0Aint mbedtls_ecp_mod_p192k1_raw(mbedtls_mpi_uint *X, size_t X_limbs);\0A\0A#endif /* MBEDTLS_ECP_DP_SECP192K1_ENABLED */\0A\0A#if defined(MBEDTLS_ECP_DP_SECP224K1_ENABLED)\0A\0A/** Fast quasi-reduction modulo p224k1 = 2^224 - R,\0A * with R = 2^32 + 2^12 + 2^11 + 2^9 + 2^7 + 2^4 + 2 + 1 = 0x0100001A93\0A *\0A * \5Cparam[in,out]   X       The address of the MPI to be converted.\0A *                          Must have exact limb size that stores a 448-bit MPI\0A *                          (double the bitlength of the modulus).\0A *                          Upon return holds the reduced value which is\0A *                          in range `0 <= X < 2 * N` (where N is the modulus).\0A *                          The bitlength of the reduced value is the same as\0A *                          that of the modulus (224 bits).\0A * \5Cparam[in]       X_limbs The length of \5Cp X in limbs.\0A *\0A * \5Creturn          \5Cc 0 on success.\0A * \5Creturn          #MBEDTLS_ERR_ECP_BAD_INPUT_DATA if \5Cp X does not have\0A *                  twice as many limbs as the modulus.\0A * \5Creturn          #MBEDTLS_ERR_ECP_ALLOC_FAILED if memory allocation failed.\0A */\0AMBEDTLS_STATIC_TESTABLE\0Aint mbedtls_ecp_mod_p224k1_raw(mbedtls_mpi_uint *X, size_t X_limbs);\0A\0A#endif /* MBEDTLS_ECP_DP_SECP224K1_ENABLED */\0A\0A#if defined(MBEDTLS_ECP_DP_SECP256K1_ENABLED)\0A\0A/** Fast quasi-reduction modulo p256k1 = 2^256 - R,\0A * with R = 2^32 + 2^9 + 2^8 + 2^7 + 2^6 + 2^4 + 1 = 0x01000003D1\0A *\0A * \5Cparam[in,out]   X       The address of the MPI to be converted.\0A *                          Must have exact limb size that stores a 512-bit MPI\0A *                          (double the bitlength of the modulus).\0A *                          Upon return holds the reduced value which is\0A *                          in range `0 <= X < 2 * N` (where N is the modulus).\0A *                          The bitlength of the reduced value is the same as\0A *                          that of the modulus (256 bits).\0A * \5Cparam[in]       X_limbs The length of \5Cp X in limbs.\0A *\0A * \5Creturn          \5Cc 0 on success.\0A * \5Creturn          #MBEDTLS_ERR_ECP_BAD_INPUT_DATA if \5Cp X does not have\0A *                  twice as many limbs as the modulus.\0A * \5Creturn          #MBEDTLS_ERR_ECP_ALLOC_FAILED if memory allocation failed.\0A */\0AMBEDTLS_STATIC_TESTABLE\0Aint mbedtls_ecp_mod_p256k1_raw(mbedtls_mpi_uint *X, size_t X_limbs);\0A\0A#endif /* MBEDTLS_ECP_DP_SECP256K1_ENABLED */\0A\0A#if defined(MBEDTLS_ECP_DP_CURVE25519_ENABLED)\0A\0A/** Fast quasi-reduction modulo p255 = 2^255 - 19\0A *\0A * \5Cparam[in,out]   X       The address of the MPI to be converted.\0A *                          Must have exact limb size that stores a 510-bit MPI\0A *                          (double the bitlength of the modulus).\0A *                          Upon return holds the reduced value which is\0A *                          in range `0 <= X < 2 * N` (where N is the modulus).\0A * \5Cparam[in]       X_limbs The length of \5Cp X in limbs.\0A *\0A * \5Creturn          \5Cc 0 on success.\0A * \5Creturn          #MBEDTLS_ERR_ECP_BAD_INPUT_DATA if \5Cp X does not have\0A *                  twice as many limbs as the modulus.\0A * \5Creturn          #MBEDTLS_ERR_ECP_ALLOC_FAILED if memory allocation failed.\0A */\0AMBEDTLS_STATIC_TESTABLE\0Aint mbedtls_ecp_mod_p255_raw(mbedtls_mpi_uint *X, size_t X_limbs);\0A\0A#endif /* MBEDTLS_ECP_DP_CURVE25519_ENABLED */\0A\0A#if defined(MBEDTLS_ECP_DP_CURVE448_ENABLED)\0A\0A/** Fast quasi-reduction modulo p448 = 2^448 - 2^224 - 1\0A * Write X as A0 + 2^448 A1 and A1 as B0 + 2^224 B1, and return A0 + A1 + B1 +\0A * (B0 + B1) * 2^224.\0A *\0A * \5Cparam[in,out]   X       The address of the MPI to be converted.\0A *                          Must have exact limb size that stores a 896-bit MPI\0A *                          (double the bitlength of the modulus). Upon return\0A *                          holds the reduced value which is in range `0 <= X <\0A *                          N` (where N is the modulus). The bitlength of the\0A *                          reduced value is the same as that of the modulus\0A *                          (448 bits).\0A * \5Cparam[in]       X_limbs The length of \5Cp X in limbs.\0A *\0A * \5Creturn          \5Cc 0 on Success.\0A * \5Creturn          #MBEDTLS_ERR_ECP_BAD_INPUT_DATA if \5Cp X does not have\0A *                  twice as many limbs as the modulus.\0A * \5Creturn          #MBEDTLS_ERR_ECP_ALLOC_FAILED if memory allocation\0A *                  failed.\0A */\0AMBEDTLS_STATIC_TESTABLE\0Aint mbedtls_ecp_mod_p448_raw(mbedtls_mpi_uint *X, size_t X_limbs);\0A\0A#endif /* MBEDTLS_ECP_DP_CURVE448_ENABLED */\0A\0A/** Initialise a modulus with hard-coded const curve data.\0A *\0A * \5Cnote            The caller is responsible for the \5Cp N modulus' memory.\0A *                  mbedtls_mpi_mod_modulus_free(&N) should be invoked at the\0A *                  end of its lifecycle.\0A *\0A * \5Cparam[in,out] N The address of the modulus structure to populate.\0A *                  Must be initialized.\0A * \5Cparam[in] id    The mbedtls_ecp_group_id for which to initialise the modulus.\0A * \5Cparam[in] ctype The mbedtls_ecp_modulus_type identifier for a coordinate modulus (P)\0A *                  or a scalar modulus (N).\0A *\0A * \5Creturn          \5Cc 0 if successful.\0A * \5Creturn          #MBEDTLS_ERR_ECP_BAD_INPUT_DATA if the given MPIs do not\0A *                  have the correct number of limbs.\0A *\0A */\0AMBEDTLS_STATIC_TESTABLE\0Aint mbedtls_ecp_modulus_setup(mbedtls_mpi_mod_modulus *N,\0A                              const mbedtls_ecp_group_id id,\0A                              const mbedtls_ecp_modulus_type ctype);\0A\0A#endif /* MBEDTLS_TEST_HOOKS && MBEDTLS_ECP_C */\0A\0A#endif /* MBEDTLS_ECP_INVASIVE_H */\0A\00" }
