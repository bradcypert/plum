@.str39683 = private global { i64, i64, [56894 x i8] } { i64 -1, i64 56893, [56894 x i8] c"/**\0A * \5Cfile rsa.h\0A *\0A * \5Cbrief This file provides an API for the RSA public-key cryptosystem.\0A *\0A * The RSA public-key cryptosystem is defined in <em>Public-Key\0A * Cryptography Standards (PKCS) #1 v1.5: RSA Encryption</em>\0A * and <em>Public-Key Cryptography Standards (PKCS) #1 v2.1:\0A * RSA Cryptography Specifications</em>.\0A *\0A */\0A/*\0A *  Copyright The Mbed TLS Contributors\0A *  SPDX-License-Identifier: Apache-2.0 OR GPL-2.0-or-later\0A */\0A#ifndef MBEDTLS_RSA_H\0A#define MBEDTLS_RSA_H\0A#include \22mbedtls/private_access.h\22\0A\0A#include \22mbedtls/build_info.h\22\0A\0A#include \22mbedtls/bignum.h\22\0A#include \22mbedtls/md.h\22\0A\0A#if defined(MBEDTLS_THREADING_C)\0A#include \22mbedtls/threading.h\22\0A#endif\0A\0A/*\0A * RSA Error codes\0A */\0A/** Bad input parameters to function. */\0A#define MBEDTLS_ERR_RSA_BAD_INPUT_DATA                    -0x4080\0A/** Input data contains invalid padding and is rejected. */\0A#define MBEDTLS_ERR_RSA_INVALID_PADDING                   -0x4100\0A/** Something failed during generation of a key. */\0A#define MBEDTLS_ERR_RSA_KEY_GEN_FAILED                    -0x4180\0A/** Key failed to pass the validity check of the library. */\0A#define MBEDTLS_ERR_RSA_KEY_CHECK_FAILED                  -0x4200\0A/** The public key operation failed. */\0A#define MBEDTLS_ERR_RSA_PUBLIC_FAILED                     -0x4280\0A/** The private key operation failed. */\0A#define MBEDTLS_ERR_RSA_PRIVATE_FAILED                    -0x4300\0A/** The PKCS#1 verification failed. */\0A#define MBEDTLS_ERR_RSA_VERIFY_FAILED                     -0x4380\0A/** The output buffer for decryption is not large enough. */\0A#define MBEDTLS_ERR_RSA_OUTPUT_TOO_LARGE                  -0x4400\0A/** The random generator failed to generate non-zeros. */\0A#define MBEDTLS_ERR_RSA_RNG_FAILED                        -0x4480\0A\0A/*\0A * RSA constants\0A */\0A\0A#define MBEDTLS_RSA_PKCS_V15    0 /**< Use PKCS#1 v1.5 encoding. */\0A#define MBEDTLS_RSA_PKCS_V21    1 /**< Use PKCS#1 v2.1 encoding. */\0A\0A#define MBEDTLS_RSA_SIGN        1 /**< Identifier for RSA signature operations. */\0A#define MBEDTLS_RSA_CRYPT       2 /**< Identifier for RSA encryption and decryption operations. */\0A\0A#define MBEDTLS_RSA_SALT_LEN_ANY    -1\0A\0A/*\0A * The above constants may be used even if the RSA module is compile out,\0A * eg for alternative (PKCS#11) RSA implementations in the PK layers.\0A */\0A\0A#ifdef __cplusplus\0Aextern \22C\22 {\0A#endif\0A\0A#if !defined(MBEDTLS_RSA_ALT)\0A// Regular implementation\0A//\0A\0A#if !defined(MBEDTLS_RSA_GEN_KEY_MIN_BITS)\0A#define MBEDTLS_RSA_GEN_KEY_MIN_BITS 1024\0A#elif MBEDTLS_RSA_GEN_KEY_MIN_BITS < 128\0A#error \22MBEDTLS_RSA_GEN_KEY_MIN_BITS must be at least 128 bits\22\0A#endif\0A\0A/**\0A * \5Cbrief   The RSA context structure.\0A */\0Atypedef struct mbedtls_rsa_context {\0A    int MBEDTLS_PRIVATE(ver);                    /*!<  Reserved for internal purposes.\0A                                                  *    Do not set this field in application\0A                                                  *    code. Its meaning might change without\0A                                                  *    notice. */\0A    size_t MBEDTLS_PRIVATE(len);                 /*!<  The size of \5Cp N in Bytes. */\0A\0A    mbedtls_mpi MBEDTLS_PRIVATE(N);              /*!<  The public modulus. */\0A    mbedtls_mpi MBEDTLS_PRIVATE(E);              /*!<  The public exponent. */\0A\0A    mbedtls_mpi MBEDTLS_PRIVATE(D);              /*!<  The private exponent. */\0A    mbedtls_mpi MBEDTLS_PRIVATE(P);              /*!<  The first prime factor. */\0A    mbedtls_mpi MBEDTLS_PRIVATE(Q);              /*!<  The second prime factor. */\0A\0A    mbedtls_mpi MBEDTLS_PRIVATE(DP);             /*!<  <code>D % (P - 1)</code>. */\0A    mbedtls_mpi MBEDTLS_PRIVATE(DQ);             /*!<  <code>D % (Q - 1)</code>. */\0A    mbedtls_mpi MBEDTLS_PRIVATE(QP);             /*!<  <code>1 / (Q % P)</code>. */\0A\0A    mbedtls_mpi MBEDTLS_PRIVATE(RN);             /*!<  cached <code>R^2 mod N</code>. */\0A\0A    mbedtls_mpi MBEDTLS_PRIVATE(RP);             /*!<  cached <code>R^2 mod P</code>. */\0A    mbedtls_mpi MBEDTLS_PRIVATE(RQ);             /*!<  cached <code>R^2 mod Q</code>. */\0A\0A    mbedtls_mpi MBEDTLS_PRIVATE(Vi);             /*!<  The cached blinding value. */\0A    mbedtls_mpi MBEDTLS_PRIVATE(Vf);             /*!<  The cached un-blinding value. */\0A\0A    int MBEDTLS_PRIVATE(padding);                /*!< Selects padding mode:\0A                                                  #MBEDTLS_RSA_PKCS_V15 for 1.5 padding and\0A                                                  #MBEDTLS_RSA_PKCS_V21 for OAEP or PSS. */\0A    int MBEDTLS_PRIVATE(hash_id);                /*!< Hash identifier of mbedtls_md_type_t type,\0A                                                    as specified in md.h for use in the MGF\0A                                                    mask generating function used in the\0A                                                    EME-OAEP and EMSA-PSS encodings. */\0A#if defined(MBEDTLS_THREADING_C)\0A    /* Invariant: the mutex is initialized iff ver != 0. */\0A    mbedtls_threading_mutex_t MBEDTLS_PRIVATE(mutex);    /*!<  Thread-safety mutex. */\0A#endif\0A}\0Ambedtls_rsa_context;\0A\0A#else  /* MBEDTLS_RSA_ALT */\0A#include \22rsa_alt.h\22\0A#endif /* MBEDTLS_RSA_ALT */\0A\0A/**\0A * \5Cbrief          This function initializes an RSA context.\0A *\0A * \5Cnote           This function initializes the padding and the hash\0A *                 identifier to respectively #MBEDTLS_RSA_PKCS_V15 and\0A *                 #MBEDTLS_MD_NONE. See mbedtls_rsa_set_padding() for more\0A *                 information about those parameters.\0A *\0A * \5Cparam ctx      The RSA context to initialize. This must not be \5Cc NULL.\0A */\0Avoid mbedtls_rsa_init(mbedtls_rsa_context *ctx);\0A\0A/**\0A * \5Cbrief          This function sets padding for an already initialized RSA\0A *                 context.\0A *\0A * \5Cnote           Set padding to #MBEDTLS_RSA_PKCS_V21 for the RSAES-OAEP\0A *                 encryption scheme and the RSASSA-PSS signature scheme.\0A *\0A * \5Cnote           The \5Cp hash_id parameter is ignored when using\0A *                 #MBEDTLS_RSA_PKCS_V15 padding.\0A *\0A * \5Cnote           The choice of padding mode is strictly enforced for private\0A *                 key operations, since there might be security concerns in\0A *                 mixing padding modes. For public key operations it is\0A *                 a default value, which can be overridden by calling specific\0A *                 \5Cc mbedtls_rsa_rsaes_xxx or \5Cc mbedtls_rsa_rsassa_xxx\0A *                 functions.\0A *\0A * \5Cnote           The hash selected in \5Cp hash_id is always used for OEAP\0A *                 encryption. For PSS signatures, it is always used for\0A *                 making signatures, but can be overridden for verifying them.\0A *                 If set to #MBEDTLS_MD_NONE, it is always overridden.\0A *\0A * \5Cparam ctx      The initialized RSA context to be configured.\0A * \5Cparam padding  The padding mode to use. This must be either\0A *                 #MBEDTLS_RSA_PKCS_V15 or #MBEDTLS_RSA_PKCS_V21.\0A * \5Cparam hash_id  The hash identifier for PSS or OAEP, if \5Cp padding is\0A *                 #MBEDTLS_RSA_PKCS_V21. #MBEDTLS_MD_NONE is accepted by this\0A *                 function but may be not suitable for some operations.\0A *                 Ignored if \5Cp padding is #MBEDTLS_RSA_PKCS_V15.\0A *\0A * \5Creturn         \5Cc 0 on success.\0A * \5Creturn         #MBEDTLS_ERR_RSA_INVALID_PADDING failure:\0A *                 \5Cp padding or \5Cp hash_id is invalid.\0A */\0Aint mbedtls_rsa_set_padding(mbedtls_rsa_context *ctx, int padding,\0A                            mbedtls_md_type_t hash_id);\0A\0A/**\0A * \5Cbrief          This function retrieves padding mode of initialized\0A *                 RSA context.\0A *\0A * \5Cparam ctx      The initialized RSA context.\0A *\0A * \5Creturn         RSA padding mode.\0A *\0A */\0Aint mbedtls_rsa_get_padding_mode(const mbedtls_rsa_context *ctx);\0A\0A/**\0A * \5Cbrief          This function retrieves hash identifier of mbedtls_md_type_t\0A *                 type.\0A *\0A * \5Cparam ctx      The initialized RSA context.\0A *\0A * \5Creturn         Hash identifier of mbedtls_md_type_t type.\0A *\0A */\0Aint mbedtls_rsa_get_md_alg(const mbedtls_rsa_context *ctx);\0A\0A/**\0A * \5Cbrief          This function imports a set of core parameters into an\0A *                 RSA context.\0A *\0A * \5Cnote           This function can be called multiple times for successive\0A *                 imports, if the parameters are not simultaneously present.\0A *\0A *                 Any sequence of calls to this function should be followed\0A *                 by a call to mbedtls_rsa_complete(), which checks and\0A *                 completes the provided information to a ready-for-use\0A *                 public or private RSA key.\0A *\0A * \5Cnote           See mbedtls_rsa_complete() for more information on which\0A *                 parameters are necessary to set up a private or public\0A *                 RSA key.\0A *\0A * \5Cnote           The imported parameters are copied and need not be preserved\0A *                 for the lifetime of the RSA context being set up.\0A *\0A * \5Cparam ctx      The initialized RSA context to store the parameters in.\0A * \5Cparam N        The RSA modulus. This may be \5Cc NULL.\0A * \5Cparam P        The first prime factor of \5Cp N. This may be \5Cc NULL.\0A * \5Cparam Q        The second prime factor of \5Cp N. This may be \5Cc NULL.\0A * \5Cparam D        The private exponent. This may be \5Cc NULL.\0A * \5Cparam E        The public exponent. This may be \5Cc NULL.\0A *\0A * \5Creturn         \5Cc 0 on success.\0A * \5Creturn         A non-zero error code on failure.\0A */\0Aint mbedtls_rsa_import(mbedtls_rsa_context *ctx,\0A                       const mbedtls_mpi *N,\0A                       const mbedtls_mpi *P, const mbedtls_mpi *Q,\0A                       const mbedtls_mpi *D, const mbedtls_mpi *E);\0A\0A/**\0A * \5Cbrief          This function imports core RSA parameters, in raw big-endian\0A *                 binary format, into an RSA context.\0A *\0A * \5Cnote           This function can be called multiple times for successive\0A *                 imports, if the parameters are not simultaneously present.\0A *\0A *                 Any sequence of calls to this function should be followed\0A *                 by a call to mbedtls_rsa_complete(), which checks and\0A *                 completes the provided information to a ready-for-use\0A *                 public or private RSA key.\0A *\0A * \5Cnote           See mbedtls_rsa_complete() for more information on which\0A *                 parameters are necessary to set up a private or public\0A *                 RSA key.\0A *\0A * \5Cnote           The imported parameters are copied and need not be preserved\0A *                 for the lifetime of the RSA context being set up.\0A *\0A * \5Cparam ctx      The initialized RSA context to store the parameters in.\0A * \5Cparam N        The RSA modulus. This may be \5Cc NULL.\0A * \5Cparam N_len    The Byte length of \5Cp N; it is ignored if \5Cp N == NULL.\0A * \5Cparam P        The first prime factor of \5Cp N. This may be \5Cc NULL.\0A * \5Cparam P_len    The Byte length of \5Cp P; it is ignored if \5Cp P == NULL.\0A * \5Cparam Q        The second prime factor of \5Cp N. This may be \5Cc NULL.\0A * \5Cparam Q_len    The Byte length of \5Cp Q; it is ignored if \5Cp Q == NULL.\0A * \5Cparam D        The private exponent. This may be \5Cc NULL.\0A * \5Cparam D_len    The Byte length of \5Cp D; it is ignored if \5Cp D == NULL.\0A * \5Cparam E        The public exponent. This may be \5Cc NULL.\0A * \5Cparam E_len    The Byte length of \5Cp E; it is ignored if \5Cp E == NULL.\0A *\0A * \5Creturn         \5Cc 0 on success.\0A * \5Creturn         A non-zero error code on failure.\0A */\0Aint mbedtls_rsa_import_raw(mbedtls_rsa_context *ctx,\0A                           unsigned char const *N, size_t N_len,\0A                           unsigned char const *P, size_t P_len,\0A                           unsigned char const *Q, size_t Q_len,\0A                           unsigned char const *D, size_t D_len,\0A                           unsigned char const *E, size_t E_len);\0A\0A/**\0A * \5Cbrief          This function completes an RSA context from\0A *                 a set of imported core parameters.\0A *\0A *                 To setup an RSA public key, precisely \5Cc N and \5Cc E\0A *                 must have been imported.\0A *\0A *                 To setup an RSA private key, sufficient information must\0A *                 be present for the other parameters to be derivable.\0A *\0A *                 The default implementation supports the following:\0A *                 <ul><li>Derive \5Cc P, \5Cc Q from \5Cc N, \5Cc D, \5Cc E.</li>\0A *                 <li>Derive \5Cc N, \5Cc D from \5Cc P, \5Cc Q, \5Cc E.</li></ul>\0A *                 Alternative implementations need not support these.\0A *\0A *                 If this function runs successfully, it guarantees that\0A *                 the RSA context can be used for RSA operations without\0A *                 the risk of failure or crash.\0A *\0A * \5Cwarning        This function need not perform consistency checks\0A *                 for the imported parameters. In particular, parameters that\0A *                 are not needed by the implementation might be silently\0A *                 discarded and left unchecked. To check the consistency\0A *                 of the key material, see mbedtls_rsa_check_privkey().\0A *\0A * \5Cparam ctx      The initialize