@.str39504 = private global { i64, i64, [10224 x i8] } { i64 -1, i64 10223, [10224 x i8] c"/**\0A * \5Cfile cmac.h\0A *\0A * \5Cbrief This file contains CMAC definitions and functions.\0A *\0A * The Cipher-based Message Authentication Code (CMAC) Mode for\0A * Authentication is defined in <em>RFC-4493: The AES-CMAC Algorithm</em>.\0A * It is supported with AES and DES.\0A */\0A/*\0A *  Copyright The Mbed TLS Contributors\0A *  SPDX-License-Identifier: Apache-2.0 OR GPL-2.0-or-later\0A */\0A\0A#ifndef MBEDTLS_CMAC_H\0A#define MBEDTLS_CMAC_H\0A#include \22mbedtls/private_access.h\22\0A\0A#include \22mbedtls/build_info.h\22\0A\0A#include \22mbedtls/cipher.h\22\0A\0A#ifdef __cplusplus\0Aextern \22C\22 {\0A#endif\0A\0A#define MBEDTLS_AES_BLOCK_SIZE          16\0A#define MBEDTLS_DES3_BLOCK_SIZE         8\0A\0A/* We don't support Camellia or ARIA in this module */\0A#if defined(MBEDTLS_AES_C)\0A#define MBEDTLS_CMAC_MAX_BLOCK_SIZE      16  /**< The longest block used by CMAC is that of AES. */\0A#else\0A#define MBEDTLS_CMAC_MAX_BLOCK_SIZE      8   /**< The longest block used by CMAC is that of 3DES. */\0A#endif\0A\0A#if !defined(MBEDTLS_DEPRECATED_REMOVED)\0A/** The longest block supported by the cipher module.\0A *\0A * \5Cdeprecated\0A * For the maximum block size of a cipher supported by the CMAC module,\0A * use #MBEDTLS_CMAC_MAX_BLOCK_SIZE.\0A * For the maximum block size of a cipher supported by the cipher module,\0A * use #MBEDTLS_MAX_BLOCK_LENGTH.\0A */\0A/* Before Mbed TLS 3.5, this was the maximum block size supported by the CMAC\0A * module, so it didn't take Camellia or ARIA into account. Since the name\0A * of the macro doesn't even convey \22CMAC\22, this was misleading. Now the size\0A * is sufficient for any cipher, but the name is defined in cmac.h for\0A * backward compatibility. */\0A#define MBEDTLS_CIPHER_BLKSIZE_MAX MBEDTLS_MAX_BLOCK_LENGTH\0A#endif /* MBEDTLS_DEPRECATED_REMOVED */\0A\0A#if !defined(MBEDTLS_CMAC_ALT)\0A\0A/**\0A * The CMAC context structure.\0A */\0Astruct mbedtls_cmac_context_t {\0A    /** The internal state of the CMAC algorithm.  */\0A    unsigned char       MBEDTLS_PRIVATE(state)[MBEDTLS_CMAC_MAX_BLOCK_SIZE];\0A\0A    /** Unprocessed data - either data that was not block aligned and is still\0A     *  pending processing, or the final block. */\0A    unsigned char       MBEDTLS_PRIVATE(unprocessed_block)[MBEDTLS_CMAC_MAX_BLOCK_SIZE];\0A\0A    /** The length of data pending processing. */\0A    size_t              MBEDTLS_PRIVATE(unprocessed_len);\0A};\0A\0A#else  /* !MBEDTLS_CMAC_ALT */\0A#include \22cmac_alt.h\22\0A#endif /* !MBEDTLS_CMAC_ALT */\0A\0A/**\0A * \5Cbrief               This function starts a new CMAC computation\0A *                      by setting the CMAC key, and preparing to authenticate\0A *                      the input data.\0A *                      It must be called with an initialized cipher context.\0A *\0A *                      Once this function has completed, data can be supplied\0A *                      to the CMAC computation by calling\0A *                      mbedtls_cipher_cmac_update().\0A *\0A *                      To start a CMAC computation using the same key as a previous\0A *                      CMAC computation, use mbedtls_cipher_cmac_finish().\0A *\0A * \5Cnote                When the CMAC implementation is supplied by an alternate\0A *                      implementation (through #MBEDTLS_CMAC_ALT), some ciphers\0A *                      may not be supported by that implementation, and thus\0A *                      return an error. Alternate implementations must support\0A *                      AES-128 and AES-256, and may support AES-192 and 3DES.\0A *\0A * \5Cparam ctx           The cipher context used for the CMAC operation, initialized\0A *                      as one of the following types: MBEDTLS_CIPHER_AES_128_ECB,\0A *                      MBEDTLS_CIPHER_AES_192_ECB, MBEDTLS_CIPHER_AES_256_ECB,\0A *                      or MBEDTLS_CIPHER_DES_EDE3_ECB.\0A * \5Cparam key           The CMAC key.\0A * \5Cparam keybits       The length of the CMAC key in bits.\0A *                      Must be supported by the cipher.\0A *\0A * \5Creturn              \5Cc 0 on success.\0A * \5Creturn              A cipher-specific error code on failure.\0A */\0Aint mbedtls_cipher_cmac_starts(mbedtls_cipher_context_t *ctx,\0A                               const unsigned char *key, size_t keybits);\0A\0A/**\0A * \5Cbrief               This function feeds an input buffer into an ongoing CMAC\0A *                      computation.\0A *\0A *                      The CMAC computation must have previously been started\0A *                      by calling mbedtls_cipher_cmac_starts() or\0A *                      mbedtls_cipher_cmac_reset().\0A *\0A *                      Call this function as many times as needed to input the\0A *                      data to be authenticated.\0A *                      Once all of the required data has been input,\0A *                      call mbedtls_cipher_cmac_finish() to obtain the result\0A *                      of the CMAC operation.\0A *\0A * \5Cparam ctx           The cipher context used for the CMAC operation.\0A * \5Cparam input         The buffer holding the input data.\0A * \5Cparam ilen          The length of the input data.\0A *\0A * \5Creturn             \5Cc 0 on success.\0A * \5Creturn             #MBEDTLS_ERR_MD_BAD_INPUT_DATA\0A *                     if parameter verification fails.\0A */\0Aint mbedtls_cipher_cmac_update(mbedtls_cipher_context_t *ctx,\0A                               const unsigned char *input, size_t ilen);\0A\0A/**\0A * \5Cbrief               This function finishes an ongoing CMAC operation, and\0A *                      writes the result to the output buffer.\0A *\0A *                      It should be followed either by\0A *                      mbedtls_cipher_cmac_reset(), which starts another CMAC\0A *                      operation with the same key, or mbedtls_cipher_free(),\0A *                      which clears the cipher context.\0A *\0A * \5Cparam ctx           The cipher context used for the CMAC operation.\0A * \5Cparam output        The output buffer for the CMAC checksum result.\0A *\0A * \5Creturn              \5Cc 0 on success.\0A * \5Creturn              #MBEDTLS_ERR_MD_BAD_INPUT_DATA\0A *                      if parameter verification fails.\0A */\0Aint mbedtls_cipher_cmac_finish(mbedtls_cipher_context_t *ctx,\0A                               unsigned char *output);\0A\0A/**\0A * \5Cbrief               This function starts a new CMAC operation with the same\0A *                      key as the previous one.\0A *\0A *                      It should be called after finishing the previous CMAC\0A *                      operation with mbedtls_cipher_cmac_finish().\0A *                      After calling this function,\0A *                      call mbedtls_cipher_cmac_update() to supply the new\0A *                      CMAC operation with data.\0A *\0A * \5Cparam ctx           The cipher context used for the CMAC operation.\0A *\0A * \5Creturn              \5Cc 0 on success.\0A * \5Creturn              #MBEDTLS_ERR_MD_BAD_INPUT_DATA\0A *                      if parameter verification fails.\0A */\0Aint mbedtls_cipher_cmac_reset(mbedtls_cipher_context_t *ctx);\0A\0A/**\0A * \5Cbrief               This function calculates the full generic CMAC\0A *                      on the input buffer with the provided key.\0A *\0A *                      The function allocates the context, performs the\0A *                      calculation, and frees the context.\0A *\0A *                      The CMAC result is calculated as\0A *                      output = generic CMAC(cmac key, input buffer).\0A *\0A * \5Cnote                When the CMAC implementation is supplied by an alternate\0A *                      implementation (through #MBEDTLS_CMAC_ALT), some ciphers\0A *                      may not be supported by that implementation, and thus\0A *                      return an error. Alternate implementations must support\0A *                      AES-128 and AES-256, and may support AES-192 and 3DES.\0A *\0A * \5Cparam cipher_info   The cipher information.\0A * \5Cparam key           The CMAC key.\0A * \5Cparam keylen        The length of the CMAC key in bits.\0A * \5Cparam input         The buffer holding the input data.\0A * \5Cparam ilen          The length of the input data.\0A * \5Cparam output        The buffer for the generic CMAC result.\0A *\0A * \5Creturn              \5Cc 0 on success.\0A * \5Creturn              #MBEDTLS_ERR_MD_BAD_INPUT_DATA\0A *                      if parameter verification fails.\0A */\0Aint mbedtls_cipher_cmac(const mbedtls_cipher_info_t *cipher_info,\0A                        const unsigned char *key, size_t keylen,\0A                        const unsigned char *input, size_t ilen,\0A                        unsigned char *output);\0A\0A#if defined(MBEDTLS_AES_C)\0A/**\0A * \5Cbrief           This function implements the AES-CMAC-PRF-128 pseudorandom\0A *                  function, as defined in\0A *                  <em>RFC-4615: The Advanced Encryption Standard-Cipher-based\0A *                  Message Authentication Code-Pseudo-Random Function-128\0A *                  (AES-CMAC-PRF-128) Algorithm for the Internet Key\0A *                  Exchange Protocol (IKE).</em>\0A *\0A * \5Cparam key       The key to use.\0A * \5Cparam key_len   The key length in Bytes.\0A * \5Cparam input     The buffer holding the input data.\0A * \5Cparam in_len    The length of the input data in Bytes.\0A * \5Cparam output    The buffer holding the generated 16 Bytes of\0A *                  pseudorandom output.\0A *\0A * \5Creturn          \5Cc 0 on success.\0A */\0Aint mbedtls_aes_cmac_prf_128(const unsigned char *key, size_t key_len,\0A                             const unsigned char *input, size_t in_len,\0A                             unsigned char output[16]);\0A#endif /* MBEDTLS_AES_C */\0A\0A#if defined(MBEDTLS_SELF_TEST) && (defined(MBEDTLS_AES_C) || defined(MBEDTLS_DES_C))\0A/**\0A * \5Cbrief          The CMAC checkup routine.\0A *\0A * \5Cnote           In case the CMAC routines are provided by an alternative\0A *                 implementation (i.e. #MBEDTLS_CMAC_ALT is defined), the\0A *                 checkup routine will succeed even if the implementation does\0A *                 not support the less widely used AES-192 or 3DES primitives.\0A *                 The self-test requires at least AES-128 and AES-256 to be\0A *                 supported by the underlying implementation.\0A *\0A * \5Creturn         \5Cc 0 on success.\0A * \5Creturn         \5Cc 1 on failure.\0A */\0Aint mbedtls_cmac_self_test(int verbose);\0A#endif /* MBEDTLS_SELF_TEST && ( MBEDTLS_AES_C || MBEDTLS_DES_C ) */\0A\0A#ifdef __cplusplus\0A}\0A#endif\0A\0A#endif /* MBEDTLS_CMAC_H */\0A\00" }
