@.str46024 = private global { i64, i64, [4331 x i8] } { i64 -1, i64 4330, [4331 x i8] c"/**\0A * \5Cfile x509.h\0A *\0A * \5Cbrief Internal part of the public \22x509.h\22.\0A */\0A/*\0A *  Copyright The Mbed TLS Contributors\0A *  SPDX-License-Identifier: Apache-2.0 OR GPL-2.0-or-later\0A */\0A#ifndef MBEDTLS_X509_INTERNAL_H\0A#define MBEDTLS_X509_INTERNAL_H\0A#include \22mbedtls/private_access.h\22\0A\0A#include \22mbedtls/build_info.h\22\0A\0A#include \22mbedtls/x509.h\22\0A#include \22mbedtls/asn1.h\22\0A#include \22pk_internal.h\22\0A\0A#if defined(MBEDTLS_RSA_C)\0A#include \22mbedtls/rsa.h\22\0A#endif\0A\0Aint mbedtls_x509_get_name(unsigned char **p, const unsigned char *end,\0A                          mbedtls_x509_name *cur);\0Aint mbedtls_x509_get_alg_null(unsigned char **p, const unsigned char *end,\0A                              mbedtls_x509_buf *alg);\0Aint mbedtls_x509_get_alg(unsigned char **p, const unsigned char *end,\0A                         mbedtls_x509_buf *alg, mbedtls_x509_buf *params);\0A#if defined(MBEDTLS_X509_RSASSA_PSS_SUPPORT)\0Aint mbedtls_x509_get_rsassa_pss_params(const mbedtls_x509_buf *params,\0A                                       mbedtls_md_type_t *md_alg, mbedtls_md_type_t *mgf_md,\0A                                       int *salt_len);\0A#endif\0Aint mbedtls_x509_get_sig(unsigned char **p, const unsigned char *end, mbedtls_x509_buf *sig);\0Aint mbedtls_x509_get_sig_alg(const mbedtls_x509_buf *sig_oid, const mbedtls_x509_buf *sig_params,\0A                             mbedtls_md_type_t *md_alg, mbedtls_pk_type_t *pk_alg,\0A                             void **sig_opts);\0Aint mbedtls_x509_get_time(unsigned char **p, const unsigned char *end,\0A                          mbedtls_x509_time *t);\0Aint mbedtls_x509_get_serial(unsigned char **p, const unsigned char *end,\0A                            mbedtls_x509_buf *serial);\0Aint mbedtls_x509_get_ext(unsigned char **p, const unsigned char *end,\0A                         mbedtls_