@.str40929 = private global { i64, i64, [34882 x i8] } { i64 -1, i64 34881, [34882 x i8] c"/*\0A *  ARIA implementation\0A *\0A *  Copyright The Mbed TLS Contributors\0A *  SPDX-License-Identifier: Apache-2.0 OR GPL-2.0-or-later\0A */\0A\0A/*\0A * This implementation is based on the following standards:\0A * [1] http://210.104.33.10/ARIA/doc/ARIA-specification-e.pdf\0A * [2] https://tools.ietf.org/html/rfc5794\0A */\0A\0A#include \22common.h\22\0A\0A#if defined(MBEDTLS_ARIA_C)\0A\0A#include \22mbedtls/aria.h\22\0A\0A#include <string.h>\0A\0A#include \22mbedtls/platform.h\22\0A\0A#if !defined(MBEDTLS_ARIA_ALT)\0A\0A#include \22mbedtls/platform_util.h\22\0A\0A/*\0A * modify byte order: ( A B C D ) -> ( B A D C ), i.e. swap pairs of bytes\0A *\0A * This is submatrix P1 in [1] Appendix B.1\0A *\0A * Common compilers fail to translate this to minimal number of instructions,\0A * so let's provide asm versions for common platforms with C fallback.\0A */\0A#if defined(MBEDTLS_HAVE_ASM)\0A#if defined(__arm__) /* rev16 available from v6 up */\0A/* armcc5 --gnu defines __GNUC__ but doesn't support GNU's extended asm */\0A#if defined(__GNUC__) && \5C\0A    (!defined(__ARMCC_VERSION) || __ARMCC_VERSION >= 6000000) && \5C\0A    __ARM_ARCH >= 6\0Astatic inline uint32_t aria_p1(uint32_t x)\0A{\0A    uint32_t r;\0A    __asm(\22rev16 %0, %1\22 : \22=l\22 (r) : \22l\22 (x));\0A    return r;\0A}\0A#define ARIA_P1 aria_p1\0A#elif defined(__ARMCC_VERSION) && __ARMCC_VERSION < 6000000 && \5C\0A    (__TARGET_ARCH_ARM >= 6 || __TARGET_ARCH_THUMB >= 3)\0Astatic inline uint32_t aria_p1(uint32_t x)\0A{\0A    uint32_t r;\0A    __asm(\22rev16 r, x\22);\0A    return r;\0A}\0A#define ARIA_P1 aria_p1\0A#endif\0A#endif /* arm */\0A#if defined(__GNUC__) && \5C\0A    defined(__i386__) || defined(__amd64__) || defined(__x86_64__)\0A/* I couldn't find an Intel equivalent of rev16, so two instructions */\0A#define ARIA_P1(x) ARIA_P2(ARIA_P3(x))\0A#endif /* x86 gnuc */\0A#endif /* MBEDTLS_HAVE_ASM && GNUC */\0A#if !defined(ARIA_P1)\0A#define ARIA_P1(x) ((((x) >> 8) & 0x00FF00FF) ^ (((x) & 0x00FF00FF) << 8))\0A#endif\0A\0A/*\0A * modify byte order: ( A B C D ) -> ( C D A B ), i.e. rotate by 16 bits\0A *\0A * This is submatrix P2 in [1] Appendix B.1\0A *\0A * Common compilers will translate this to a single instruction.\0A */\0A#define ARIA_P2(x) (((x) >> 16) ^ ((x) << 16))\0A\0A/*\0A * modify byte order: ( A B C D ) -> ( D C B A ), i.e. change endianness\0A *\0A * This is submatrix P3 in [1] Appendix B.1\0A */\0A#define ARIA_P3(x) MBEDTLS_BSWAP32(x)\0A\0A/*\0A * ARIA Affine Transform\0A * (a, b, c, d) = state in/out\0A *\0A * If we denote the first byte of input by 0, ..., the last byte by f,\0A * then inputs are: a = 0123, b = 4567, c = 89ab, d = cdef.\0A *\0A * Reading [1] 2.4 or [2] 2.4.3 in columns and performing simple\0A * rearrangements on adjacent pairs, output is:\0A *\0A * a = 3210 + 4545 + 6767 + 88aa + 99bb + dccd + effe\0A *   = 3210 + 4567 + 6745 + 89ab + 98ba + dcfe + efcd\0A * b = 0101 + 2323 + 5476 + 8998 + baab + eecc + ffdd\0A *   = 0123 + 2301 + 5476 + 89ab + ba98 + efcd + fedc\0A * c = 0022 + 1133 + 4554 + 7667 + ab89 + dcdc + fefe\0A *   = 0123 + 1032 + 4567 + 7654 + ab89 + dcfe + fedc\0A * d = 1001 + 2332 + 6644 + 7755 + 9898 + baba + cdef\0A *   = 1032 + 2301 + 6745 + 7654 + 98ba + ba98 + cdef\0A *\0A * Note: another presentation of the A transform can be found as the first\0A * half of App. B.1 in [1] in terms of 4-byte operators P1, P2, P3 and P4.\0A * The implementation below uses only P1 and P2 as they are sufficient.\0A */\0Astatic inline void aria_a(uint32_t *a, uint32_t *b,\0A                          uint32_t *c, uint32_t *d)\0A{\0A    uint32_t ta, tb, tc;\0A    ta  =  *b;                      // 4567\0A    *b  =  *a;                      // 0123\0A    *a  =  ARIA_P2(ta);             // 6745\0A    tb  =  ARIA_P2(*d);             // efcd\0A    *d  =  ARIA_P1(*c);             // 98ba\0A    *c  =  ARIA_P1(tb);             // fedc\0A    ta