ode;\0A    plum_process_capture(&plum_process_slots[slot], out_path, err_path);\0A\0A    remove(out_path);\0A    remove(err_path);\0A    free(args_copy);\0A    free(argv);\0A    free(env_copy);\0A    free(envp);\0A    return slot;\0A}\0A\0Along long process_exit_code(long long handle) {\0A    if (handle < 0 || handle >= PLUM_PROC_MAX_SLOTS || !plum_process_slots[handle].in_use) {\0A        return -1;\0A    }\0A    return plum_process_slots[handle].exit_code;\0A}\0A\0Aconst char *process_stdout_data(long long handle) {\0A    if (handle < 0 || handle >= PLUM_PROC_MAX_SLOTS || !plum_process_slots[handle].in_use) {\0A        return \22\22;\0A    }\0A    return plum_process_slots[handle].out_data != NULL ? plum_process_slots[handle].out_data : \22\22;\0A}\0A\0Aconst char *process_stderr_data(long long handle) {\0A    if (handle < 0 || handle >= PLUM_PROC_MAX_SLOTS || !plum_process_slots[handle].in_use) {\0A        return \22\22;\0A    }\0A    return plum_process_slots[handle].err_data != NULL ? plum_process_slots[handle].err_data : \22\22;\0A}\0A\0A// A completed capture failure is sticky, independent of the exit status.\0Along long process_capture_status(long long handle) {\0A    if (handle < 0 || handle >= PLUM_PROC_MAX_SLOTS || !plum_process_slots[handle].in_use) return -1;\0A    return plum_process_slots[handle].capture_failed ? -1 : 0;\0A}\0A\0Along long process_stdout_length(long long handle) {\0A    if (handle < 0 || handle >= PLUM_PROC_MAX_SLOTS || !plum_process_slots[handle].in_use) return 0;\0A    return plum_process_slots[handle].out_length;\0A}\0A\0Along long process_stderr_length(long long handle) {\0A    if (handle < 0 || handle >= PLUM_PROC_MAX_SLOTS || !plum_process_slots[handle].in_use) return 0;\0A    return plum_process_slots[handle].err_length;\0A}\0A\0Avoid process_free(long long handle) {\0A    if (handle < 0 || handle >= PLUM_PROC_MAX_SLOTS || !plum_process_slots[handle].in_use) {\0A        return;\0A    }\0A    // A slot filled by `process_spawn` 