;\0A#endif\0A\0A    mbedtls_fprintf(stderr, \22HDR:  PTR(%10zu), PREV(%10zu), NEXT(%10zu), \22\0A                            \22ALLOC(%zu), SIZE(%10zu)\5Cn\22,\0A                    (size_t) hdr, (size_t) hdr->prev, (size_t) hdr->next,\0A                    hdr->alloc, hdr->size);\0A    mbedtls_fprintf(stderr, \22      FPREV(%10zu), FNEXT(%10zu)\5Cn\22,\0A                    (size_t) hdr->prev_free, (size_t) hdr->next_free);\0A\0A#if defined(MBEDTLS_MEMORY_BACKTRACE)\0A    mbedtls_fprintf(stderr, \22TRACE: \5Cn\22);\0A    for (i = 0; i < hdr->trace_count; i++) {\0A        mbedtls_fprintf(stderr, \22%s\5Cn\22, hdr->trace[i]);\0A    }\0A    mbedtls_fprintf(stderr, \22\5Cn\22);\0A#endif\0A}\0A\0Astatic void debug_chain(void)\0A{\0A    memory_header *cur = heap.first;\0A\0A    mbedtls_fprintf(stderr, \22\5CnBlock list\5Cn\22);\0A    while (cur != NULL) {\0A        debug_header(cur);\0A        cur = cur->next;\0A    }\0A\0A    mbedtls_fprintf(stderr, \22Free list\5Cn\22);\0A    cur = heap.first_free;\0A\0A    while (cur != NULL) {\0A        debug_header(cur);\0A        cur = cur->next_free;\0A    }\0A}\0A#endif /* MBEDTLS_MEMORY_DEBUG */\0A\0Astatic int verify_header(memory_header *hdr)\0A{\0A    if (hdr->magic1 != MAGIC1) {\0A#if defined(MBEDTLS_MEMORY_DEBUG)\0A        mbedtls_fprintf(stderr, \22FATAL: MAGIC1 mismatch\5Cn\22);\0A#endif\0A        return 1;\0A    }\0A\0A    if (hdr->magic2 != MAGIC2) {\0A#if defined(MBEDTLS_MEMORY_DEBUG)\0A        mbedtls_fprintf(stderr, \22FATAL: MAGIC2 mismatch\5Cn\22);\0A#endif\0A        return 1;\0A    }\0A\0A    if (hdr->alloc > 1) {\0A#if defined(MBEDTLS_MEMORY_DEBUG)\0A        mbedtls_fprintf(stderr, \22FATAL: alloc has illegal value\5Cn\22);\0A#endif\0A        return 1;\0A    }\0A\0A    if (hdr->prev != NULL && hdr->prev == hdr->next) {\0A#if defined(MBEDTLS_MEMORY_DEBUG)\0A        mbedtls_fprintf(stderr, \22FATAL: prev == next\5Cn\22);\0A#endif\0A        return 1;\0A    }\0A\0A    if (hdr->prev_free != NULL && hdr->prev_free == hdr->next_free) {\0A#if defined(MBEDTLS_MEMORY_DEBUG)\0A        mbedtls_fprintf(stderr, \22FATAL: prev_free == next_free\5Cn\22);\0A#endif\0A        return 1;\0A    }\0A\0A    return 0;\0A}\0A\0Astatic int verify_chain(void)\0A{\0A    memory_header *prv = heap.first, *cur;\0A\0A    if (prv == NULL || verify_header(prv) != 0) {\0A#if defined(MBEDTLS_MEMORY_DEBUG)\0A        mbedtls_fprintf(stderr, \22FATAL: verification of first header \22\0A                                \22failed\5Cn\22);\0A#endif\0A        return 1;\0A    }\0A\0A    if (heap.first->prev != NULL) {\0A#if defined(MBEDTLS_MEMORY_DEBUG)\0A        mbedtls_fprintf(stderr, \22FATAL: verification failed: \22\0A                                \22first->prev != NULL\5Cn\22);\0A#endif\0A        return 1;\0A    }\0A\0A    cur = heap.first->next;\0A\0A    while (cur != NULL) {\0A        if (verify_header(cur) != 0) {\0A#if defined(MBEDTLS_MEMORY_DEBUG)\0A            mbedtls_fprintf(stderr, \22FATAL: verification of header \22\0A                                    \22failed\5Cn\22);\0A#endif\0A            return 1;\0A        }\0A\0A        if (cur->prev != prv) {\0A#if defined(MBEDTLS_MEMORY_DEBUG)\0A            mbedtls_fprintf(stderr, \22FATAL: verification failed: \22\0A                                    \22cur->prev != prv\5Cn\22);\0A#endif\0A            return 1;\0A        }\0A\0A        prv = cur;\0A        cur = cur->next;\0A    }\0A\0A    return 0;\0A}\0A\0Astatic void *buffer_alloc_calloc(size_t n, size_t size)\0A{\0A    memory_header *new, *cur = heap.first_free;\0A    unsigned char *p;\0A    void *ret;\0A    size_t original_len, len;\0A#if defined(MBEDTLS_MEMORY_BACKTRACE)\0A    void *trace_buffer[MAX_BT];\0A    size_t trace_cnt;\0A#endif\0A\0A    if (heap.buf == NULL || heap.first == NULL) {\0A        return NULL;\0A    }\0A\0A    original_len = len = n * size;\0A\0A    if (n == 0 || size == 0 || len / n != size) {\0A        return NULL;\0A    } else if (len > (size_t) -MBEDTLS_MEMORY_ALIGN_MULTIPLE) {\0A        return NULL;\0A    }\0A\0A    if (len % MBEDTLS_MEMORY_ALIGN_MULTIPLE) {\0A        len -= len % MBEDTLS_MEMORY_ALIGN_MULTIPLE;\0A        len += MBEDTLS_MEMORY_ALIGN_MULTIPLE;\0A    }\0A\0A    // Find block that fits\0A    //\0A    while (cur != NULL) {\0A        if (cur->size >= len) {\0A            break;\0A        }\0A\0A        cur = cur->next_free;\0A    }\0A\0A    if (cur == NULL) {\0A        return NULL;\0A    }\0A\0A    if (cur->alloc != 0) {\0A#if defined(MBEDTLS_MEMORY_DEBUG)\0A        mbedtls_fprintf(stderr, \22FATAL: block in free_list but allocated \22\0A                                \22data\5Cn\22);\0A#endif\0A        mbedtls_exit(1);\0A    }\0A\0A#if defined(MBEDTLS_MEMORY_DEBUG)\0A    heap.alloc_count++;\0A#endif\0A\0A    // Found location, split block if > memory_header + 4 room left\0A    //\0A    if (cur->size - len < sizeof(memory_header) +\0A        MBEDTLS_MEMORY_ALIGN_MULTIPLE) {\0A        cur->alloc = 1;\0A\0A        // Remove from free_list\0A        //\0A        if (cur->prev_free != NULL) {\0A            cur->prev_free->next_free = cur->next_free;\0A        } else {\0A            heap.first_free = cur->next_free;\0A        }\0A\0A        if (cur->next_free != NULL) {\0A            cur->next_free->prev_free = cur->prev_free;\0A        }\0A\0A        cur->prev_free = NULL;\0A        cur->next_free = NULL;\0A\0A#if defined(MBEDTLS_MEMORY_DEBUG)\0A        heap.total_used += cur->size;\0A        if (heap.total_used > heap.maximum_used) {\0A            heap.maximum_used = heap.total_used;\0A        }\0A#endif\0A#if defined(MBEDTLS_MEMORY_BACKTRACE)\0A        trace_cnt = backtrace(trace_buffer, MAX_BT);\0A        cur->trace = backtrace_symbols(trace_buffer, trace_cnt);\0A        cur->trace_count = trace_cnt;\0A#endif\0A\0A        if ((heap.verify & MBEDTLS_MEMORY_VERIFY_ALLOC) && verify_chain() != 0) {\0A            mbedtls_exit(1);\0A        }\0A\0A        ret = (unsigned char *) cur + sizeof(memory_header);\0A        memset(ret, 0, original_len);\0A\0A        return ret;\0A    }\0A\0A    p = ((unsigned char *) cur) + sizeof(memory_header) + len;\0A    new = (memory_header *) p;\0A\0A    new->size = cur->size - len - sizeof(memory_header);\0A    new->alloc = 0;\0A    new->prev = cur;\0A    new->next = cur->next;\0A#if defined(MBEDTLS_MEMORY_BACKTRACE)\0A    new->trace = NULL;\0A    new->trace_count = 0;\0A#endif\0A    new->magic1 = MAGIC1;\0A    new->magic2 = MAGIC2;\0A\0A    if (new->next != NULL) {\0A        new->next->prev = new;\0A    }\0A\0A    // Replace cur with new in free_list\0A    //\0A    new->prev_free = cur->prev_free;\0A    new->next_free = cur->next_free;\0A    if (new->prev_free != NULL) {\0A        new->prev_free->next_free = new;\0A    } else {\0A        heap.first_free = new;\0A    }\0A\0A    if (new->next_free != NULL) {\0A        new->next_free->prev_free = new;\0A    }\0A\0A    cur->alloc = 1;\0A    cur->size = len;\0A    cur->next = new;\0A    cur->prev_free = NULL;\0A    cur->next_free = NULL;\0A\0A#if defined(MBEDTLS_MEMORY_DEBUG)\0A    heap.header_count++;\0A    if (heap.header_count > heap.maximum_header_count) {\0A        heap.maximum_header_count = heap.header_count;\0A    }\0A    heap.total_used += cur->size;\0A    if (heap.total_used > heap.maximum_used) {\0A        heap.maximum_used = heap.total_used;\0A    }\0A#endif\0A#if defined(MBEDTLS_MEMORY_BACKTRACE)\0A    trace_cnt = backtrace(trace_buffer, MAX_BT);\0A    cur->trace = backtrace_symbols(trace_buffer, trace_cnt);\0A    cur->trace_count = trace_cnt;\0A#endif\0A\0A    if ((heap.verify & MBEDTLS_MEMORY_VERIFY_ALLOC) && verify_chain() != 0) {\0A        mbedtls_exit(1);\0A    }\0A\0A    ret = (unsigned char *) cur + sizeof(memory_header);\0A    memset(ret, 0, original_len);\0A\0A    return ret;\0A}\0A\0Astatic void buffer_alloc_free(void *ptr)\0A{\0A    memory_header *hdr, *old = NULL;\0A    unsigned char *p = (unsigned char *) ptr;\0A\0A    if (ptr == NULL || heap.buf == NULL || heap.first == NULL) {\0A        return;\0A    }\0A\0A    if (p < heap.buf || p >= heap.buf + heap.len) {\0A#if defined(MBEDTLS_MEMORY_DEBUG)\0A        mbedtls_fprintf(stderr, \22FATAL: mbedtls_free() outside of managed \22\0A                                \22space\5Cn\22);\0A#endif\0A        mbedtls_exit(1);\0A    }\0A\0A    p -= sizeof(memory_header);\0A    hdr = (memory_header *) p;\0A\0A    if (verify_header(hdr) != 0) {\0A        mbedtls_exit(1);\0A    }\0A\0A    if (hdr->alloc != 1) {\0A#if defined(MBEDTLS_MEMORY_DEBUG)\0A        mbedtls_fprintf(stderr, \22FATAL: mbedtls_free() on unallocated \22\0A                                \22data\5Cn\22);\0A#endif\0A        mbedtls_exit(1);\0A    }\0A\0A    hdr->alloc = 0;\0A\0A#if defined(MBEDTLS_MEMORY_DEBUG)\0A    heap.free_count++;\0A    heap.total_used -= hdr->size;\0A#endif\0A\0A#if defined(MBEDTLS_MEMORY_BACKTRACE)\0A    free(hdr->trace);\0A    hdr->trace = NULL;\0A    hdr->trace_count = 0;\0A#endif\0A\0A    // Regroup with block before\0A    //\0A    if (hdr->prev != NULL && hdr->prev->alloc == 0) {\0A#if defined(MBEDTLS_MEMORY_DEBUG)\0A        heap.header_count--;\0A#endif\0A        hdr->prev->size += sizeof(memory_header) + hdr->size;\0A        hdr->prev->next = hdr->next;\0A        old = hdr;\0A        hdr = hdr->prev;\0A\0A        if (hdr->next != NULL) {\0A            hdr->next->prev = hdr;\0A        }\0A\0A        memset(old, 0, sizeof(memory_header));\0A    }\0A\0A    // Regroup with block after\0A    //\0A    if (hdr->next != NULL && hdr->next->alloc == 0) {\0A#if defined(MBEDTLS_MEMORY_DEBUG)\0A        heap.header_count--;\0A#endif\0A        hdr->size += sizeof(memory_header) + hdr->next->size;\0A        old = hdr->next;\0A        hdr->next = hdr->next->next;\0A\0A        if (hdr->prev_free != NULL || hdr->next_free != NULL) {\0A            if (hdr->prev_free != NULL) {\0A                hdr->prev_free->next_free = hdr->next_free;\0A            } else {\0A                heap.first_free = hdr->next_free;\0A            }\0A\0A            if (hdr->next_free != NULL) {\0A                hdr->next_free->prev_free = hdr->prev_free;\0A            }\0A        }\0A\0A        hdr->prev_free = old->prev_free;\0A        hdr->next_free = old->next_free;\0A\0A        if (hdr->prev_free != NULL) {\0A            hdr->prev_free->next_free = hdr;\0A        } else {\0A            heap.first_free = hdr;\0A        }\0A\0A        if (hdr->next_free != NULL) {\0A            hdr->next_free->prev_free = hdr;\0A        }\0A\0A        if (hdr->next != NULL) {\0A            hdr->next->prev = hdr;\0A        }\0A\0A        memset(old, 0, sizeof(memory_header));\0A    }\0A\0A    // Prepend to free_list if we have not merged\0A    // (Does not have to stay in same order as prev / next list)\0A    //\0A    if (old == NULL) {\0A        hdr->next_free = heap.first_free;\0A        if (heap.first_free != NULL) {\0A            heap.first_free->prev_free = hdr;\0A        }\0A        heap.first_free = hdr;\0A    }\0A\0A    if ((heap.verify & MBEDTLS_MEMORY_VERIFY_FREE) && verify_chain() != 0) {\0A        mbedtls_exit(1);\0A    }\0A}\0A\0Avoid mbedtls_memory_buffer_set_verify(int verify)\0A{\0A    heap.verify = verify;\0A}\0A\0Aint mbedtls_memory_buffer_alloc_verify(void)\0A{\0A    return verify_chain();\0A}\0A\0A#if defined(MBEDTLS_MEMORY_DEBUG)\0Avoid mbedtls_memory_buffer_alloc_status(void)\0A{\0A    mbedtls_fprintf(stderr,\0A                    \22Current use: %zu blocks / %zu bytes, max: %zu blocks / \22\0A                    \22%zu bytes (total %zu bytes), alloc / free: %zu / %zu\5Cn\22,\0A                    heap.header_count, heap.total_used,\0A                    heap.maximum_header_count, heap.maximum_used,\0A                    heap.maximum_header_count * sizeof(memory_header)\0A                    + heap.maximum_used,\0A                    heap.alloc_count, heap.free_count);\0A\0A    if (heap.first->next == NULL) {\0A        mbedtls_fprintf(stderr, \22All memory de-allocated in stack buffer\5Cn\22);\0A    } else {\0A        mbedtls_fprintf(stderr, \22Memory currently allocated:\5Cn\22);\0A        debug_chain();\0A    }\0A}\0A\0Avoid mbedtls_memory_buffer_alloc_count_get(size_t *alloc_count, size_t *free_count)\0A{\0A    *alloc_count = heap.alloc_count;\0A    *free_count = heap.free_count;\0A}\0A\0Avoid mbedtls_memory_buffer_alloc_max_get(size_t *max_used, size_t *max_blocks)\0A{\0A    *max_used   = heap.maximum_used;\0A    *max_blocks = heap.maximum_header_count;\0A}\0A\0Avoid mbedtls_memory_buffer_alloc_max_reset(void)\0A{\0A    heap.maximum_used = 0;\0A    heap.maximum_header_count = 0;\0A}\0A\0Avoid mbedtls_memory_buffer_alloc_cur_get(size_t *cur_used, size_t *cur_blocks)\0A{\0A    *cur_used   = heap.total_used;\0A    *cur_blocks = heap.header_count;\0A}\0A#endif /* MBEDTLS_MEMORY_DEBUG */\0A\0A#if defined(MBEDTLS_THREADING_C)\0Astatic void *buffer_alloc_calloc_mutexed(size_t n, size_t size)\0A{\0A    void *buf;\0A    if (mbedtls_mutex_lock(&heap.mutex) != 0) {\0A        return NULL;\0A    }\0A    buf = buffer_alloc_calloc(n, size);\0A    if (mbedtls_mutex_unlock(&heap.mutex)) {\0A        return NULL;\0A    }\0A    return buf;\0A}\0A\0Astatic void buffer_alloc_free_mutexed(void *ptr)\0A{\0A    /* We have no good option here, but corrupting the heap seems\0A     * worse than losing memory. */\0A    if (mbedtls_mutex_lock(&heap.mutex)) {\0A        return;\0A    }\0A    buffer_alloc_free(ptr);\0A    (void) mbedtls_mutex_unlock(&heap.mutex);\0A}\0A#endif /* MBEDTLS_THREADING_C */\0A\0Avoid mbedtls_memory_buffer_alloc_init(unsigned char *buf, size_t len)\0A{\0A    memset(&heap, 0, sizeof(buffer_alloc_ctx));\0A\0A#if defined(MBEDTLS_THREADING_C)\0A    mbedtls_mutex_init(&heap.mutex);\0A    mbedtls_platform_set_calloc_free(buffer_alloc_calloc_mutexed,\0A                                     buffer_alloc_free_mutexed);\0A#else\0A    mbedtls_platform_set_calloc_free(buffer_alloc_calloc, buffer_alloc_free);\0A#endif\0A\0A    if (len < sizeof(memory_header) + MBEDTLS_MEMORY_ALIGN_MULTIPLE) {\0A        return;\0A    } else if ((size_t) buf % MBEDTLS_MEMORY_ALIGN_MULTIPLE) {\0A        /* Adjust len first since buf is used in the computation */\0A        len -= MBEDTLS_MEMORY_ALIGN_MULTIPLE\0A               - (size_t) buf % MBEDTLS_MEMORY_ALIGN_MULTIPLE;\0A        buf += MBEDTLS_MEMORY_ALIGN_MULTIPLE\0A               - (size_t) buf % MBEDTLS_MEMORY_ALIGN_MULTIPLE;\0A    }\0A\0A    memset(buf, 0, len);\0A\0A    heap.buf = buf;\0A    heap.len = len;\0A\0A    heap.first = (memory_header *) buf;\0A    heap.first->size = len - sizeof(memory_header);\0A    heap.first->magic1 = MAGIC1;\0A    heap.first->magic2 = MAGIC2;\0A    heap.first_free = heap.first;\0A}\0A\0Avoid mbedtls_memory_buffer_alloc_free(void)\0A{\0A#if defined(MBEDTLS_THREADING_C)\0A    mbedtls_mutex_free(&heap.mutex);\0A#endif\0A    mbedtls_platform_zeroize(&heap, sizeof(buffer_alloc_ctx));\0A}\0A\0A#if defined(MBEDTLS_SELF_TEST)\0Astatic int check_pointer(void *p)\0A{\0A    if (p == NULL) {\0A        return -1;\0A    }\0A\0A    if ((size_t) p % MBEDTLS_MEMORY_ALIGN_MULTIPLE != 0) {\0A        return -1;\0A    }\0A\0A    return 0;\0A}\0A\0Astatic int check_all_free(void)\0A{\0A    if (\0A#if defined(MBEDTLS_MEMORY_DEBUG)\0A        heap.total_used != 0 ||\0A#endif\0A        heap.first != heap.first_free ||\0A        (void *) heap.first != (void *) heap.buf) {\0A        return -1;\0A    }\0A\0A    return 0;\0A}\0A\0A#define TEST_ASSERT(condition)            \5C\0A    if (!(condition))                     \5C\0A    {                                       \5C\0A        if (verbose != 0)                  \5C\0A        mbedtls_printf(\22failed\5Cn\22);  \5C\0A                                            \5C\0A        ret = 1;                            \5C\0A        goto cleanup;                       \5C\0A    }\0A\0Aint mbedtls_memory_buffer_alloc_self_test(int verbose)\0A{\0A    unsigned char buf[1024];\0A    unsigned char *p, *q, *r, *end;\0A    int ret = 0;\0A\0A    if (verbose != 0) {\0A        mbedtls_printf(\22  MBA test #1 (basic alloc-free cycle): \22);\0A    }\0A\0A    mbedtls_memory_buffer_alloc_init(buf, sizeof(buf));\0A\0A    p = mbedtls_calloc(1, 1);\0A    q = mbedtls_calloc(1, 128);\0A    r = mbedtls_calloc(1, 16);\0A\0A    TEST_ASSERT(check_pointer(p) == 0 &&\0A                check_pointer(q) == 0 &&\0A                check_pointer(r) == 0);\0A\0A    mbedtls_free(r);\0A    mbedtls_free(q);\0A    mbedtls_free(p);\0A\0A    TEST_ASSERT(check_all_free() == 0);\0A\0A    /* Memorize end to compare with the next test */\0A    end = heap.buf + heap.len;\0A\0A    mbedtls_memory_buffer_alloc_free();\0A\0A    if (verbose != 0) {\0A        mbedtls_printf(\22passed\5Cn\22);\0A    }\0A\0A    if (verbose != 0) {\0A        mbedtls_printf(\22  MBA test #2 (buf not aligned): \22);\0A    }\0A\0A    mbedtls_memory_buffer_alloc_init(buf + 1, sizeof(buf) - 1);\0A\0A    TEST_ASSERT(heap.buf + heap.len == end);\0A\0A    p = mbedtls_calloc(1, 1);\0A    q = mbedtls_calloc(1, 128);\0A    r = mbedtls_calloc(1, 16);\0A\0A    TEST_ASSERT(check_pointer(p) == 0 &&\0A                check_pointer(q) == 0 &&\0A                check_pointer(r) == 0);\0A\0A    mbedtls_free(r);\0A    mbedtls_free(q);\0A    mbedtls_free(p);\0A\0A    TEST_ASSERT(check_all_free() == 0);\0A\0A    mbedtls_memory_buffer_alloc_free();\0A\0A    if (verbose != 0) {\0A        mbedtls_printf(\22passed\5Cn\22);\0A    }\0A\0A    if (verbose != 0) {\0A        mbedtls_printf(\22  MBA test #3 (full): \22);\0A    }\0A\0A    mbedtls_memory_buffer_alloc_init(buf, sizeof(buf));\0A\0A    p = mbedtls_calloc(1, sizeof(buf) - sizeof(memory_header));\0A\0A    TEST_ASSERT(check_pointer(p) == 0);\0A    TEST_ASSERT(mbedtls_calloc(1, 1) == NULL);\0A\0A    mbedtls_free(p);\0A\0A    p = mbedtls_calloc(1, sizeof(buf) - 2 * sizeof(memory_header) - 16);\0A    q = mbedtls_calloc(1, 16);\0A\0A    TEST_ASSERT(check_pointer(p) == 0 && check_pointer(q) == 0);\0A    TEST_ASSERT(mbedtls_calloc(1, 1) == NULL);\0A\0A    mbedtls_free(q);\0A\0A    TEST_ASSERT(mbedtls_calloc(1, 17) == NULL);\0A\0A    mbedtls_free(p);\0A\0A    TEST_ASSERT(check_all_free() == 0);\0A\0A    mbedtls_memory_buffer_alloc_free();\0A\0A    if (verbose != 0) {\0A        mbedtls_printf(\22passed\5Cn\22);\0A    }\0A\0Acleanup:\0A    mbedtls_memory_buffer_alloc_free();\0A\0A    return ret;\0A}\0A#endif /* MBEDTLS_SELF_TEST */\0A\0A#endif /* MBEDTLS_MEMORY_BUFFER_ALLOC_C */\0A\00" }
