@.str42227 = private global { i64, i64, [16615 x i8] } { i64 -1, i64 16614, [16615 x i8] c"/**\0A * \5Cfile common.h\0A *\0A * \5Cbrief Utility macros for internal use in the library\0A */\0A/*\0A *  Copyright The Mbed TLS Contributors\0A *  SPDX-License-Identifier: Apache-2.0 OR GPL-2.0-or-later\0A */\0A\0A#ifndef MBEDTLS_LIBRARY_COMMON_H\0A#define MBEDTLS_LIBRARY_COMMON_H\0A\0A#include \22mbedtls/build_info.h\22\0A#include \22alignment.h\22\0A\0A#include <assert.h>\0A#include <stddef.h>\0A#include <stdint.h>\0A#include <stddef.h>\0A\0A#if defined(__ARM_NEON)\0A#include <arm_neon.h>\0A#define MBEDTLS_HAVE_NEON_INTRINSICS\0A#elif defined(MBEDTLS_PLATFORM_IS_WINDOWS_ON_ARM64)\0A#include <arm64_neon.h>\0A#define MBEDTLS_HAVE_NEON_INTRINSICS\0A#endif\0A\0A/** Helper to define a function as static except when building invasive tests.\0A *\0A * If a function is only used inside its own source file and should be\0A * declared `static` to allow the compiler to optimize for code size,\0A * but that function has unit tests, define it with\0A * ```\0A * MBEDTLS_STATIC_TESTABLE int mbedtls_foo(...) { ... }\0A * ```\0A * and declare it in a header in the `library/` directory with\0A * ```\0A * #if defined(MBEDTLS_TEST_HOOKS)\0A * int mbedtls_foo(...);\0A * #endif\0A * ```\0A */\0A#if defined(MBEDTLS_TEST_HOOKS)\0A#define MBEDTLS_STATIC_TESTABLE\0A#else\0A#define MBEDTLS_STATIC_TESTABLE static\0A#endif\0A\0A#if defined(MBEDTLS_TEST_HOOKS)\0Aextern void (*mbedtls_test_hook_test_fail)(const char *test, int line, const char *file);\0A#define MBEDTLS_TEST_HOOK_TEST_ASSERT(TEST) \5C\0A    do { \5C\0A        if ((!(TEST)) && ((*mbedtls_test_hook_test_fail) != NULL)) \5C\0A        { \5C\0A            (*mbedtls_test_hook_test_fail)( #TEST, __LINE__, __FILE__); \5C\0A        } \5C\0A    } while (0)\0A#else\0A#define MBEDTLS_TEST_HOOK_TEST_ASSERT(TEST)\0A#endif /* defined(MBEDTLS_TEST_HOOKS) */\0A\0A/** \5Cdef ARRAY_LENGTH\0A * Return the number of elements of a static or stack array.\0A *\0A * \5Cparam array         A value of array (not pointer) type.\0A *\0A * \5Creturn The number of elements of the array.\0A */\0A/* A correct implementation of ARRAY_LENGTH, but which silently gives\0A * a nonsensical result if called with a pointer rather than an array. */\0A#define ARRAY_LENGTH_UNSAFE(array)            \5C\0A    (sizeof(array) / sizeof(*(array)))\0A\0A#if defined(__GNUC__)\0A/* Test if arg and &(arg)[0] have the same type. This is true if arg is\0A * an array but not if it's a pointer. */\0A#define IS_ARRAY_NOT_POINTER(arg)                                     \5C\0A    (!__builtin_types_compatible_p(__typeof__(arg),                \5C\0A                                   __typeof__(&(arg)[0])))\0A/* A compile-time constant with the value 0. If `const_expr` is not a\0A * compile-time constant with a nonzero value, cause a compile-time error. */\0A#define STATIC_ASSERT_EXPR(const_expr)                                \5C\0A    (0 && sizeof(struct { unsigned int STATIC_ASSERT : 1 - 2 * !(const_expr); }))\0A\0A/* Return the scalar value `value` (possibly promoted). This is a compile-time\0A * constant if `value` is. `condition` must be a compile-time constant.\0A * If `condition` is false, arrange to cause a compile-time error. */\0A#define STATIC_ASSERT_THEN_RETURN(condition, value)   \5C\0A    (STATIC_ASSERT_EXPR(condition) ? 0 : (value))\0A\0A#define ARRAY_LENGTH(array)                                           \5C\0A    (STATIC_ASSERT_THEN_RETURN(IS_ARRAY_NOT_POINTER(array),         \5C\0A                               ARRAY_LENGTH_UNSAFE(array)))\0A\0A#else\0A/* If we aren't sure the compiler supports our non-standard tricks,\0A * fall back to the unsafe implementation. */\0A#define ARRAY_LENGTH(array) ARRAY_LENGTH_UNSAFE(array)\0A#endif\0A/** Allow library to access its structs' private members.\0A *\0A * Although structs defined in header files are publicly available,\0A * their members are private and should not be accessed by the user.\0A */\0A#define MBEDTLS_ALLOW_PRIVATE_ACCESS\0A\0A/**\0A * \5Cbrief       Securely zeroize a buffer then free it.\0A *\0A *              Similar to making consecutive calls to\0A *              \5Cc mbedtls_platform_zeroize() and \5Cc mbedtls_free(), but has\0A *              code size savings, and potential for optimisation in the future.\0A *\0A *              Guaranteed to be a no-op if \5Cp buf is \5Cc NULL and \5Cp len is 0.\0A *\0A * \5Cparam buf   Buffer to be zeroized then freed.\0A * \5Cparam len   Length of the buffer in bytes\0A */\0Avoid mbedtls_zeroize_and_free(void *buf, size_t len);\0A\0A/** Return an offset into a buffer.\0A *\0A * This is just the addition of an offset to a pointer, except that this\0A * function also accepts an offset of 0 into a buffer whose pointer is null.\0A * (`p + n` has undefined behavior when `p` is null, even when `n == 0`.\0A * A null pointer is a valid buffer pointer when the size is 0, for example\0A * as the result of `malloc(0)` on some platforms.)\0A *\0A * \5Cparam p     Pointer to a buffer of at least n bytes.\0A *              This may be \5Cp NULL if \5Cp n is zero.\0A * \5Cparam n     An offset in bytes.\0A * \5Creturn      Pointer to offset \5Cp n in the buffer \5Cp p.\0A *              Note that this is only a valid pointer if the size of the\0A *              buffer is at least \5Cp n + 1.\0A */\0Astatic inline unsigned char *mbedtls_buffer_offset(\0A    unsigned char *p, size_t n)\0A{\0A    return p == NULL ? NULL : p + n;\0A}\0A\0A/** Return an offset into a read-only buffer.\0A *\0A * Similar to mbedtls_buffer_offset(), but for const pointers.\0A *\0A * \5Cparam p     Pointer to a buffer of at least n bytes.\0A *              This may be \5Cp NULL if \5Cp n is zero.\0A * \5Cparam n     An offset in bytes.\0A * \5Creturn      Pointer to offset \5Cp n in the buffer \5Cp p.\0A *              Note that this is only a valid pointer if the size of the\0A *              buffer is at least \5Cp n + 1.\0A */\0Astatic inline const unsigned char *mbedtls_buffer_offset_const(\0A    const unsigned char *p, size_t n)\0A{\0A    return p == NULL ? NULL : p + n;\0A}\0A\0A/* Always inline mbedtls_xor() for similar reasons as mbedtls_xor_no_simd(). */\0A#if defined(__IAR_SYSTEMS_ICC__)\0A#pragma inline = forced\0A#elif defined(__GNUC__)\0A__attribute__((always_inline))\0A#endif\0A/**\0A * Perform a fast block XOR operation, such that\0A * r[i] = a[i] ^ b[i] where 0 <= i < n\0A *\0A * \5Cparam   r Pointer to result (buffer of at least \5Cp n bytes). \5Cp r\0A *            may be equal to either \5Cp a or \5Cp b, but behaviour when\0A *            it overlaps in other ways is undefined.\0A * \5Cparam   a Pointer to input (buffer of at least \5Cp n bytes)\0A * \5Cparam   b Pointer to input (buffer of at least \5Cp n bytes)\0A * \5Cparam   n Number of bytes to process.\0A *\0A * \5Cnote      Depending on the situation, it may be faster to use either mbedtls_xor() or\0A *            mbedtls_xor_no_simd() (these are functionally equivalent).\0A *            If the result is used immediately after the xor operation in non-SIMD code (e.g, in\0A *            AES-CBC), there may be additional latency to transfer the data from SIMD to scalar\0A *            registers, and in this case, mbedtls_xor_no_simd() may be faster. In other cases where\0A *            the result is not used immediately (e.g., in AES-CTR), mbedtls_xor() may be faster.\0A *            For targets without SIMD support, they will behave the same.\0A */\0Astatic inline void mbedtls_xor(unsigned char *r,\0A                               const unsigned char *a,\0A                               const unsigned char *b,\0A                               size_t n)\0A{\0A    size_t i = 0;\0A#if defined(MBEDTLS_EFFICIENT_UNALIGNED_ACCESS)\0A#if defined(MBEDTLS_HAVE_NEON_INTRINSICS) && \5C\0A    (!(defined(MBEDTLS_COMPILER_IS_GCC) && MBEDTLS_GCC_VERSION < 70300))\0A    /* Old GCC versions generate a warning here, so disable the NEON path for these compilers */\0A    for (; (i + 16) <= n; i += 16) {\0A        uint8x16_t v1 = vld1q_u8(a + i);\0A        uint8x16_t v2 = vld1q_u8(b + i);\0A        uint8x16_t x = veorq_u8(v1, v2);\0A        vst1q_u8(r + i, x);\0A    }\0A#if defined(__IAR_SYSTEMS_ICC__)\0A    /* This if statement helps some compilers (e.g., IAR) optimise out the byte-by-byte tail case\0A     * where n is a constant multiple of 16.\0A     * For other compilers (e.g. recent gcc and clang) it makes no difference if n is a compile-time\0A     * constant, and is a very small perf regression if n is not a compile-time constant. */\0A    if (n % 16 == 0) {\0A        return;\0A    }\0A#endif\0A#elif defined(MBEDTLS_ARCH_IS_X64) || defined(MBEDTLS_ARCH_IS_ARM64)\0A    /* This codepath probably only makes sense on architectures with 64-bit registers */\0A    for (; (i + 8) <= n; i += 8) {\0A        uint64_t x = mbedtls_get_unaligned_uint64(a + i) ^ mbedtls_get_unaligned_uint64(b + i);\0A        mbedtls_put_unaligned_uint64(r + i, x);\0A    }\0A#if defined(__IAR_SYSTEMS_ICC__)\0A    if (n % 8 == 0) {\0A        return;\0A    }\0A#endif\0A#else\0A    for (; (i + 4) <= n; i += 4) {\0A        uint32_t x = mbedtls_get_unaligned_uint32(a + i) ^ mbedtls_get_unaligned_uint32(b + i);\0A        mbedtls_put_unaligned_uint32(r + i, x);\0A    }\0A#if defined(__IAR_SYSTEMS_ICC__)\0A    if (n % 4 == 0) {\0A        return;\0A    }\0A#endif\0A#endif\0A#endif\0A    for (; i < n; i++) {\0A        r[i] = a[i] ^ b[i];\0A    }\0A}\0A\0A/* Always inline mbedtls_xor_no_simd() as we see significant perf regressions when it does not get\0A * inlined (e.g., observed about 3x perf difference in gcm_mult_largetable with gcc 7 - 12) */\0A#if defined(__IAR_SYSTEMS_ICC__)\0A#pragma inline = forced\0A#elif defined(__GNUC__)\0A__attribute__((always_inline))\0A#endif\0A/**\0A * Perform a fast block XOR operation, such that\0A * r[i] = a[i] ^ b[i] where 0 <= i < n\0A *\0A * In some situations, this can perform better than mbedtls_xor() (e.g., it's about 5%\0A * better in AES-CBC).\0A *\0A * \5Cparam   r Pointer to result (buffer of at least \5Cp n bytes). \5Cp r\0A *            may be equal to either \5Cp a or \5Cp b, but behaviour when\0A *            it overlaps in other ways is undefined.\0A * \5Cparam   a Pointer to input (buffer of at least \5Cp n bytes)\0A * \5Cparam   b Pointer to input (buffer of at least \5Cp n bytes)\0A * \5Cparam   n Number of bytes to process.\0A *\0A * \5Cnote      Depending on the situation, it may be faster to use either mbedtls_xor() or\0A *            mbedtls_xor_no_simd() (these are functionally equivalent).\0A *            If the result is used immediately after the xor operation in non-SIMD code (e.g, in\0A *            AES-CBC), there may be additional latency to transfer the data from SIMD to scalar\0A *            registers, and in this case, mbedtls_xor_no_simd() may be faster. In other cases where\0A *            the result is not used immediately (e.g., in AES-CTR), mbedtls_xor() may be faster.\0A *            For targets without SIMD support, they will behave the same.\0A */\0Astatic inline void mbedtls_xor_no_simd(unsigned char *r,\0A                                       const unsigned char *a,\0A                                       const unsigned char *b,\0A                                       size_t n)\0A{\0A    size_t i = 0;\0A#if defined(MBEDTLS_EFFICIENT_UNALIGNED_ACCESS)\0A#if defined(MBEDTLS_ARCH_IS_X64) || defined(MBEDTLS_ARCH_IS_ARM64)\0A    /* This codepath probably only makes sense on architectures with 64-bit registers */\0A    for (; (i + 8) <= n; i += 8) {\0A        uint64_t x = mbedtls_get_unaligned_uint64(a + i) ^ mbedtls_get_unaligned_uint64(b + i);\0A        mbedtls_put_unaligned_uint64(r + i, x);\0A    }\0A#if defined(__IAR_SYSTEMS_ICC__)\0A    /* This if statement helps some compilers (e.g., IAR) optimise out the byte-by-byte tail case\0A     * where n is a constant multiple of 8.\0A     * For other compilers (e.g. recent gcc and clang) it makes no difference if n is a compile-time\0A     * constant, and is a very small perf regression if n is not a compile-time constant. */\0A    if (n % 8 == 0) {\0A        return;\0A    }\0A#endif\0A#else\0A    for (; (i + 4) <= n; i += 4) {\0A        uint32_t x = mbedtls_get_unaligned_uint32(a + i) ^ mbedtls_get_unaligned_uint32(b + i);\0A        mbedtls_put_unaligned_uint32(r + i, x);\0A    }\0A#if defined(__IAR_SYSTEMS_ICC__)\0A    if (n % 4 == 0) {\0A        return;\0A    }\0A#endif\0A#endif\0A#endif\0A    for (; i < n; i++) {\0A        r[i] = a[i] ^ b[i];\0A    }\0A}\0A\0A/* Fix MSVC C99 compatible issue\0A *      MSVC support __func__ from visual studio 2015( 1900 )\0A *      Use MSVC predefine macro to avoid name check fail.\0A */\0A#if (defined(_MSC_VER) && (_MSC_VER <= 1900))\0A#define /*no-check-names*/ __func__ __FUNCTION__\0A#endif\0A\0A/* Define `asm` for compilers which don't define it. */\0A/* *INDENT-OFF* */\0A#ifndef asm\0A#if defined(__IAR_SYSTEMS_ICC__)\0A#define asm __asm\0A#else\0A#define asm __asm__\0A#endif\0A#endif\0A/* *INDENT-ON* */\0A\0A/*\0A * Define the constraint used for read-only pointer operands to aarch64 asm.\0A *\0A * This is normally the usual \22r\22, but for aarch64_32 (aka ILP32,\0A * as found in watchos), \22p\22 is required to avoid warnings from clang.\0A *\0A * Note that clang does not recognise '+p' or '=p', and armclang\0A * does not recognise 'p' at all. Therefore, to update a pointer from\0A * aarch64 assembly, it is necessary to use something like:\0A *\0A * uintptr_t uptr = (uintptr_t) ptr;\0A * asm( \22ldr x4, [%x0], #8\22 ... : \22+r\22 (uptr) : : )\0A * ptr = (void*) uptr;\0A *\0A * Note that the \22x\22 in \22%x0\22 is neccessary; writing \22%0\22 will cause warnings.\0A */\0A#if defined(__aarch64__) && defined(MBEDTLS_HAVE_ASM)\0A#if UINTPTR_MAX == 0xfffffffful\0A/* ILP32: Specify the pointer operand slightly differently, as per #7787. */\0A#define MBEDTLS_ASM_AARCH64_PTR_CONSTRAINT \22p\22\0A#elif UINTPTR_MAX == 0xfffffffffffffffful\0A/* Normal case (64-bit pointers): use \22r\22 as the constraint for pointer operands to asm */\0A#define MBEDTLS_ASM_AARCH64_PTR_CONSTRAINT \22r\22\0A#else\0A#error \22Unrecognised pointer size for aarch64\22\0A#endif\0A#endif\0A\0A/* Always provide a static assert macro, so it can be used unconditionally.\0A * It does nothing on systems where we don't know how to define a static assert.\0A */\0A/* Can't use the C11-style `defined(static_assert)` on FreeBSD, since it\0A * defines static_assert even with -std=c99, but then complains about it.\0A */\0A#if defined(static_assert) && !defined(__FreeBSD__)\0A#define MBEDTLS_STATIC_ASSERT(expr, msg)    static_assert(expr, msg)\0A#else\0A/* Make sure `MBEDTLS_STATIC_ASSERT(expr, msg);` is valid both inside and\0A * outside a function. We choose a struct declaration, which can be repeated\0A * any number of times and does not need a matching definition. */\0A#define MBEDTLS_STATIC_ASSERT(expr, msg)                                \5C\0A    struct ISO_C_does_not_allow_extra_semicolon_outside_of_a_function\0A#endif\0A\0A#if defined(__has_builtin)\0A#define MBEDTLS_HAS_BUILTIN(x) __has_builtin(x)\0A#else\0A#define MBEDTLS_HAS_BUILTIN(x) 0\0A#endif\0A\0A/* Define compiler branch hints */\0A#if MBEDTLS_HAS_BUILTIN(__builtin_expect)\0A#define MBEDTLS_LIKELY(x)       __builtin_expect(!!(x), 1)\0A#define MBEDTLS_UNLIKELY(x)     __builtin_expect(!!(x), 0)\0A#else\0A#define MBEDTLS_LIKELY(x)       x\0A#define MBEDTLS_UNLIKELY(x)     x\0A#endif\0A\0A/* MBEDTLS_ASSUME may be used to provide additional information to the compiler\0A * which can result in smaller code-size. */\0A#if MBEDTLS_HAS_BUILTIN(__builtin_assume)\0A/* clang provides __builtin_assume */\0A#define MBEDTLS_ASSUME(x)       __builtin_assume(x)\0A#elif MBEDTLS_HAS_BUILTIN(__builtin_unreachable)\0A/* gcc and IAR can use __builtin_unreachable */\0A#define MBEDTLS_ASSUME(x)       do { if (!(x)) __builtin_unreachable(); } while (0)\0A#elif d