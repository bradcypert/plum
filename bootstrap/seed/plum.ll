if (bind(bind_ctx->fd, (struct sockaddr *) &local_addr, n) != 0) {\0A            return MBEDTLS_ERR_NET_BIND_FAILED;\0A        }\0A    }\0A\0A    if (client_ip != NULL) {\0A        if (client_addr.ss_family == AF_INET) {\0A            struct sockaddr_in *addr4 = (struct sockaddr_in *) &client_addr;\0A            *cip_len = sizeof(addr4->sin_addr.s_addr);\0A\0A            if (buf_size < *cip_len) {\0A                return MBEDTLS_ERR_NET_BUFFER_TOO_SMALL;\0A            }\0A\0A            memcpy(client_ip, &addr4->sin_addr.s_addr, *cip_len);\0A        } else {\0A            struct sockaddr_in6 *addr6 = (struct sockaddr_in6 *) &client_addr;\0A            *cip_len = sizeof(addr6->sin6_addr.s6_addr);\0A\0A            if (buf_size < *cip_len) {\0A                return MBEDTLS_ERR_NET_BUFFER_TOO_SMALL;\0A            }\0A\0A            memcpy(client_ip, &addr6->sin6_addr.s6_addr, *cip_len);\0A        }\0A    }\0A\0A    return 0;\0A}\0A\0A/*\0A * Set the socket blocking or non-blocking\0A */\0Aint mbedtls_net_set_block(mbedtls_net_context *ctx)\0A{\0A#if (defined(_WIN32) || defined(_WIN32_WCE)) && !defined(EFIX64) && \5C\0A    !defined(EFI32)\0A    u_long n = 0;\0A    return ioctlsocket(ctx->fd, FIONBIO, &n);\0A#else\0A    return fcntl(ctx->fd, F_SETFL, fcntl(ctx->fd, F_GETFL) & ~O_NONBLOCK);\0A#endif\0A}\0A\0Aint mbedtls_net_set_nonblock(mbedtls_net_context *ctx)\0A{\0A#if (defined(_WIN32) || defined(_WIN32_WCE)) && !defined(EFIX64) && \5C\0A    !defined(EFI32)\0A    u_long n = 1;\0A    return ioctlsocket(ctx->fd, FIONBIO, &n);\0A#else\0A    return fcntl(ctx->fd, F_SETFL, fcntl(ctx->fd, F_GETFL) | O_NONBLOCK);\0A#endif\0A}\0A\0A/*\0A * Check if data is available on the socket\0A */\0A\0Aint mbedtls_net_poll(mbedtls_net_context *ctx, uint32_t rw, uint32_t timeout)\0A{\0A    int ret = MBEDTLS_ERR_ERROR_CORRUPTION_DETECTED;\0A    struct timeval tv;\0A\0A    fd_set read_fds;\0A    fd_set write_fds;\0A\0A    int fd = ctx->fd;\0A\0A    ret = check_fd(fd, 1);\0A    if (ret != 0) {\0A        return ret;\0A    }\0A\0A#if defined(__has_feature)\0A#if __has_feature(memory_sanitizer)\0A    /* Ensure that memory sanitizers consider read_fds and write_fds as\0A     * initialized even on platforms such as Glibc/x86_64 where FD_ZERO\0A     * is implemented in assembly. */\0A    memset(&read_fds, 0, sizeof(read_fds));\0A    memset(&write_fds, 0, sizeof(write_fds));\0A#endif\0A#endif\0A\0A    FD_ZERO(&read_fds);\0A    if (rw & MBEDTLS_NET_POLL_READ) {\0A        rw &= ~MBEDTLS_NET_POLL_READ;\0A        FD_SET((SOCKET) fd, &read_fds);\0A    }\0A\0A    FD_ZERO(&write_fds);\0A    if (rw & MBEDTLS_NET_POLL_WRITE) {\0A        rw &= ~MBEDTLS_NET_POLL_WRITE;\0A        FD_SET((SOCKET) fd, &write_fds);\0A    }\0A\0A    if (rw != 0) {\0A        return MBEDTLS_ERR_NET_BAD_INPUT_DATA;\0A    }\0A\0A    tv.tv_sec  = timeout / 1000;\0A    tv.tv_usec = (timeout % 1000) * 1000;\0A\0A    do {\0A        ret = select(fd + 1, &read_fds, &write_fds, NULL,\0A                     timeout == (uint32_t) -1 ? NULL : &tv);\0A    } while (IS_EINTR(ret));\0A\0A    if (ret < 0) {\0A        return MBEDTLS_ERR_NET_POLL_FAILED;\0A    }\0A\0A    ret = 0;\0A    if (FD_ISSET(fd, &read_fds)) {\0A        ret |= MBEDTLS_NET_POLL_READ;\0A    }\0A    if (FD_ISSET(fd, &write_fds)) {\0A        ret |= MBEDTLS_NET_POLL_WRITE;\0A    }\0A\0A    return ret;\0A}\0A\0A/*\0A * Portable usleep helper\0A */\0Avoid mbedtls_net_usleep(unsigned long usec)\0A{\0A#if defined(_WIN32)\0A    Sleep((usec + 999) / 1000);\0A#else\0A    struct timeval tv;\0A    tv.tv_sec  = usec / 1000000;\0A#if (defined(__unix__) || defined(__unix) || \5C\0A    (defined(__APPLE__) && defined(__MACH__))) && !defined(__DJGPP__)\0A    tv.tv_usec = (suseconds_t) usec % 1000000;\0A#else\0A    tv.tv_usec = usec % 1000000;\0A#endif\0A    select(0, NULL, NULL, NULL, &tv);\0A#endif\0A}\0A\0A/*\0A * Read at most 'len' characters\0A */\0Aint mbedtls_net_recv(void *ctx, unsigned char *buf, size_t len)\0A{\0A    int ret = MBEDTLS_ERR_ERROR_CORRUPTION_DETECTED;\0A    int fd = ((mbedtls_net_context *) ctx)->fd;\0A\0A    ret = check_fd(fd, 0);\0A    if (ret != 0) {\0A        return ret;\0A    }\0A\0A    ret = (int) read(fd, buf, len);\0A\0A    if (ret < 0) {\0A        if (net_would_block(ctx) != 0) {\0A            return MBEDTLS_ERR_SSL_WANT_READ;\0A        }\0A\0A#if (defined(_WIN32) || defined(_WIN32_WCE)) && !defined(EFIX64) && \5C\0A        !defined(EFI32)\0A        if (WSAGetLastError() == WSAECONNRESET) {\0A            return MBEDTLS_ERR_NET_CONN_RESET;\0A        }\0A#else\0A        if (errno == EPIPE || errno == ECONNRESET) {\0A            return MBEDTLS_ERR_NET_CONN_RESET;\0A        }\0A\0A        if (errno == EINTR) {\0A            return MBEDTLS_ERR_SSL_WANT_READ;\0A        }\0A#endif\0A\0A        return MBEDTLS_ERR_NET_RECV_FAILED;\0A    }\0A\0A    return ret;\0A}\0A\0A/*\0A * Read at most 'len' characters, blocking for at most 'timeout' ms\0A */\0Aint mbedtls_net_recv_timeout(void *ctx, unsigned char *buf,\0A                             size_t len, uint32_t timeout)\0A{\0A    int ret = MBEDTLS_ERR_ERROR_CORRUPTION_DETECTED;\0A    struct timeval tv;\0A    fd_set read_fds;\0A    int fd = ((mbedtls_net_context *) ctx)->fd;\0A\0A    ret = check_fd(fd, 1);\0A    if (ret != 0) {\0A        return ret;\0A    }\0A\0A    FD_ZERO(&read_fds);\0A    FD_SET((SOCKET) fd, &read_fds);\0A\0A    tv.tv_sec  = timeout / 1000;\0A    tv.tv_usec = (timeout % 1000) * 1000;\0A\0A    ret = select(fd + 1, &read_fds, NULL, NULL, timeout == 0 ? NULL : &tv);\0A\0A    /* Zero fds ready means we timed out */\0A    if (ret == 0) {\0A        return MBEDTLS_ERR_SSL_TIMEOUT;\0A    }\0A\0A    if (ret < 0) {\0A#if (defined(_WIN32) || defined(_WIN32_WCE)) && !defined(EFIX64) && \5C\0A        !defined(EFI32)\0A        if (WSAGetLastError() == WSAEINTR) {\0A            return MBEDTLS_ERR_SSL_WANT_READ;\0A        }\0A#else\0A        if (errno == EINTR) {\0A            return MBEDTLS_ERR_SSL_WANT_READ;\0A        }\0A#endif\0A\0A        return MBEDTLS_ERR_NET_RECV_FAILED;\0A    }\0A\0A    /* This call will not block */\0A    return mbedtls_net_recv(ctx, buf, len);\0A}\0A\0A/*\0A * Write at most 'len' characters\0A */\0Aint mbedtls_net_send(void *ctx, const unsigned char *buf, size_t len)\0A{\0A    int ret = MBEDTLS_ERR_ERROR_CORRUPTION_DETECTED;\0A    int fd = ((mbedtls_net_context *) ctx)->fd;\0A\0A    ret = check_fd(fd, 0);\0A    if (ret != 0) {\0A        return ret;\0A    }\0A\0A    ret = (int) write(fd, buf, len);\0A\0A    if (ret < 0) {\0A        if (net_would_block(ctx) != 0) {\0A            return MBEDTLS_ERR_SSL_WANT_WRITE;\0A        }\0A\0A#if (defined(_WIN32) || defined(_WIN32_WCE)) && !defined(EFIX64) && \5C\0A        !defined(EFI32)\0A        if (WSAGetLastError() == WSAECONNRESET) {\0A            return MBEDTLS_ERR_NET_CONN_RESET;\0A        }\0A#else\0A        if (errno == EPIPE || errno == ECONNRESET) {\0A            return MBEDTLS_ERR_NET_CONN_RESET;\0A        }\0A\0A        if (errno == EINTR) {\0A            return MBEDTLS_ERR_SSL_WANT_WRITE;\0A        }\0A#endif\0A\0A        return MBEDTLS_ERR_NET_SEND_FAILED;\0A    }\0A\0A    return ret;\0A}\0A\0A/*\0A * Close the connection\0A */\0Avoid mbedtls_net_close(mbedtls_net_context *ctx)\0A{\0A    if (ctx->fd == -1) {\0A        return;\0A    }\0A\0A    close(ctx->fd);\0A\0A    ctx->fd = -1;\0A}\0A\0A/*\0A * Gracefully close the connection\0A */\0Avoid mbedtls_net_free(mbedtls_net_context *ctx)\0A{\0A    if (ctx == NULL || ctx->fd == -1) {\0A        return;\0A    }\0A\0A    shutdown(ctx->fd, 2);\0A    close(ctx->fd);\0A\0A    ctx->fd = -1;\0A}\0A\0A#endif /* MBEDTLS_NET_C */\0A\00" }
