rse certificate verify\22));\0A        ssl->state++;\0A        return 0;\0A    }\0A\0A#if defined(MBEDTLS_SSL_KEEP_PEER_CERTIFICATE)\0A    if (ssl->session_negotiate->peer_cert == NULL) {\0A        MBEDTLS_SSL_DEBUG_MSG(2, (\22<= skip parse certificate verify\22));\0A        ssl->state++;\0A        return 0;\0A    }\0A#else /* MBEDTLS_SSL_KEEP_PEER_CERTIFICATE */\0A    if (ssl->session_negotiate->peer_cert_digest == NULL) {\0A        MBEDTLS_SSL_DEBUG_MSG(2, (\22<= skip parse certificate verify\22));\0A        ssl->state++;\0A        return 0;\0A    }\0A#endif /* !MBEDTLS_SSL_KEEP_PEER_CERTIFICATE */\0A\0A    /* Read the message without adding it to the checksum */\0A    ret = mbedtls_ssl_read_record(ssl, 0 /* no checksum update */);\0A    if (0 != ret) {\0A        MBEDTLS_SSL_DEBUG_RET(1, (\22mbedtls_ssl_read_record\22), ret);\0A        return ret;\0A    }\0A\0A    ssl->state++;\0A\0A    /* Process the message contents */\0A    if (ssl->in_msgtype != MBEDTLS_SSL_MSG_HANDSHAKE ||\0A        ssl->in_msg[0] != MBEDTLS_SSL_HS_CERTIFICATE_VERIFY) {\0A        MBEDTLS_SSL_DEBUG_MSG(1, (\22bad certificate verify message\22));\0A        return MBEDTLS_ERR_SSL_UNEXPECTED_MESSAGE;\0A    }\0A\0A    i = mbedtls_ssl_hs_hdr_len(ssl);\0A\0A#if !defined(MBEDTLS_SSL_KEEP_PEER_CERTIFICATE)\0A    peer_pk = &ssl->handshake->peer_pubkey;\0A#else /* !MBEDTLS_SSL_KEEP_PEER_CERTIFICATE */\0A    if (ssl->session_negotiate->peer_cert == NULL) {\0A        /* Should never happen */\0A        return MBEDTLS_ERR_SSL_INTERNAL_ERROR;\0A    }\0A    peer_pk = &ssl->session_negotiate->peer_cert->pk;\0A#endif /* MBEDTLS_SSL_KEEP_PEER_CERTIFICATE */\0A\0A    /*\0A     *  struct {\0A     *     SignatureAndHashAlgorithm algorithm; -- TLS 1.2 only\0A     *     opaque signature<0..2^16-1>;\0A     *  } DigitallySigned;\0A     */\0A    if (i + 2 > ssl->in_hslen) {\0A        MBEDTLS_SSL_DEBUG_MSG(1, (\22bad certificate verify message\22));\0A        return MBEDTLS_ERR_SSL_DECODE_ERROR;\0A    }\0A\0A    /*\0A  