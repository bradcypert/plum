s_recv_n(fd, max_len);\0A        if n < 0 { Err(\22https client: read failed\22) }\0A        else { Ok(Bytes.from_cstr(tls_recv_data(), n)) }\0A    } }\0A\0Alet http_write (fd: Int) (secure: Int) (data: Bytes): Result[Int, String] =\0A    if secure == 0 { Net.write_bytes(fd, data) }\0A    else { unsafe {\0A        let len = data.len();\0A        let n = tls_send(fd, data.as_cstr(), len);\0A        if n < 0 { Err(\22https client: write failed\22) } else { Ok(n) }\0A    } }\0A\0A// Bytes.slice copies. Slice only a bounded chunk, never the whole unsent\0A// suffix, so repeated short writes do not copy the body quadratically.\0Alet http_write_all (fd: Int) (secure: Int) (data: Bytes) (offset: Int): Result[Unit, String] =\0A    if offset >= data.len() { Ok(()) }\0A    else {\0A        let end = offset + Int.min(16384, data.len() - offset);\0A        match http_write(fd, secure, data.slice(offset, end)) {\0A            Err(e) => Err(e),\0A            Ok(n) => if n <= 0 || n > end - offset { Err(\22http: write made invalid progress\22) }\0A                else { http_write_all(fd, secure, data, offset + n) },\0A        }\0A    }\0A\0A// Serialize only the head. Keep the body as its existing RC buffer rather\0A// than allocating another whole-body copy just to prepend HTTP metadata.\0Astruct HttpWire { head: Bytes, body: Bytes }\0Alet http_send (fd: Int) (secure: Int) (wire: HttpWire): Result[Unit, String] =\0A    http_write_all(fd, secure, wire.head, 0)\0A        |> Result.and_then(_, |ignored| http_write_all(fd, secure, wire.body, 0))\0A\0A/// Decodes the request body as UTF-8. Invalid UTF-8 returns Err; the raw\0A/// body remains available as Bytes. No Content-Type or charset conversion\0A/// is inferred, and valid text shares the body's reference-counted storage.\0Apub let Request.text (req: Request): Result[String, String] = req.body.as_string()\0A\0A/// Decodes the response body as UTF-8, returning Err for invalid text.\0A/// This validates without copying the payload; it does not decompress or\0A/// interpret Content-Type. Use body directly for arbitrary binary data.\0Apub let Response.text (resp: Response): Result[String, String] = resp.body.as_string()\0A\0A/// URL parsing lives in `Url` now; this only decides which URLs an\0A/// HTTP CLIENT is willing to act on, which is a different question\0A/// and the only part that ever belonged here.\0A///\0A/// The two rejection messages are unchanged, deliberately: they are\0A/// what a user sees and what `bootstrap/net-smoke` asserts. What did\0A/// change is that a URL this client cannot USE is now told apart from\0A/// a URL that is not well-formed. `nope://h/x` parses fine and is\0A/// refused for its scheme, while `h/x` is refused for having none,\0A/// and those used to be the same message.\0A///\0Alet http_parse_url (url: String): Result[Url.Url, String] =\0A    match Url.parse(url) {\0A        Err(e) => Err(\22http client: \22.concat(e)),\0A        Ok(u) =>\0A            if u.scheme == \22https\22 || u.scheme == \22http\22 { Ok(u) }\0A            else { Err(\22http client: url must start with http:// or https://\22) },\0A    }\0A\0A// RFC 9110 token syntax, shared by methods and field names. Scan bytes:\0A// tokens are ASCII even when the surrounding String contains UTF-8.\0Alet http_token_byte (c: Int): Bool =\0A    (c >= 65 && c <= 90) || (c >= 97 && c <= 122) || (c >= 48 && c <= 57)\0A        || c == 33 || c == 35 || c == 36 || c == 37 || c == 38 || c == 39\0A        || c == 42 || c == 43 || c == 45 || c == 46 || c == 94 || c == 95\0A        || c == 96 || c == 124 || c == 126\0A\0Alet http_token_ok_acc (b: Bytes) (i: Int): Bool =\0A    if i >= b.len() { true }\0A    else { match b.at(i) {\0A        Some(c) => if http_token_byte(c) { http_token_ok_acc(b, i + 1) } else { false },\0A        None => false,\0A    } }\0A\0Alet http_token_ok (text: String): Bool =\0A    !String.is_empty(text) && http_token_ok_acc(text.as_bytes(), 0)\0A\0A// Field values allow SP and HTAB; targets and authorities allow neither.\0A// Bytes above ASCII are preserved, including existing UTF-8 field values.\0Alet http_text_ok_acc (b: Bytes) (i: Int) (field_value: Bool): Bool =\0A    if i >= b.len() { true }\0A    else { match b.at(i) {\0A        Some(c) => {\0A            let ok = if field_value { c == 9 || (c >= 32 && c != 127) } else { c > 32 && c != 127 };\0A            if ok { http_text_ok_acc(b, i + 1, field_value) } else { false }\0A        },\0A        None => false,\0A    } }\0A\0Alet http_validate_headers (headers: Array[Header]) (i: Int): Result[Unit, String] =\0A    if i >= headers.len() { Ok(()) }\0A    else if !http_token_ok(headers[i].name) { Err(\22http: invalid header name\22) }\0A    else if !http_text_ok_acc(headers[i].value.as_bytes(), 0, true) { Err(\22http: invalid header value\22) }\0A    else { http_validate_headers(headers, i + 1) }\0A\0A// Public structs are unchecked data. Validate the actual interpolated fields\0A// here, even when a Url was constructed without going through Url.parse.\0Alet http_build_request (method: String) (parsed: Url.Url) (headers: Array[Header]) (body: Bytes): Result[HttpWire, String] = {\0A    let target = Url.request_target(parsed);\0A    let authority = Url.authority(parsed);\0A    if !http_token_ok(method) { Err(\22http client: invalid method\22) }\0A    else if String.is_empty(target) || !http_text_ok_acc(target.as_bytes(), 0, false) { Err(\22http client: invalid request target\22) }\0A    else if String.is_empty(authority) || !http_text_ok_acc(authority.as_bytes(), 0, false) { Err(\22http client: invalid authority\22) }\0A    else { Result.map(http_validate_headers(headers, 0)\0A        |> Result.and_then(_, |ignored| http_request_headers(headers, 0)), |ignored| {\0A            let extra_header_lines = Array.fold(headers, \22\22, |acc, h| acc.concat(h.name).concat(\22: \22).concat(h.value).concat(\22\5Cr\5Cn\22));\0A            let content_length_line = if body.is_empty() { \22\22 } else { \22Content-Length: \22.concat(body.len().to_string()).concat(\22\5Cr\5Cn\22) };\0A            let head = method.concat(\22 \22).concat(target).concat(\22 HTTP/1.1\5Cr\5Cn\22)\0A            .concat(\22Host: \22).concat(authority).concat(\22\5Cr\5Cn\22)\0A            .concat(\22Connection: close\5Cr\5Cn\22)\0A            .concat(content_length_line)\0A            .concat(extra_header_lines)\0A            .concat(\22\5Cr\5Cn\22);\0A            HttpWire { head: head.as_bytes(), body: body }\0A        }) }\0A}\0A\0A// Search byte offsets, retaining the last three bytes as overlap after a\0A// read. Only the head is decoded later: a body coalesced with the head may\0A// begin with NUL, invalid UTF-8, or half of a multibyte character.\0Alet http_head_separator (raw: Bytes) (i: Int): Option[Int] =\0A    if i + 3 >= raw.len() { None }\0A    else if http_byte(raw, i) == 13 && http_byte(raw, i + 1) == 10\0A        && http_byte(raw, i + 2) == 13 && http_byte(raw, i + 3) == 10 { Some(i) }\0A    else { http_head_separator(raw, i + 1) }\0A\0Alet http_recv_headers_from (fd: Int) (secure: Int) (acc: Bytes) (start: Int): Result[Bytes, String] =\0A    match http_head_separator(acc, start) {\0A        Some(_) => Ok(acc),\0A        None => match http_read(fd, secure, 4096) {\0A            Err(e) => Err(e),\0A            Ok(chunk) => if chunk.is_empty() { Err(\22http client: connection closed before the response headers were complete\22) }\0A                else { http_recv_headers_from(fd, secure, acc.concat(chunk), Int.max(0, acc.len() - 3)) },\0A        },\0A    }\0A\0Alet http_recv_headers_acc (fd: Int) (secure: Int) (acc: Bytes): Result[Bytes, String] =\0A    http_recv_headers_from(fd, secure, acc, 0)\0A\0Alet http_status_valid (status: Int): Bool = status >= 100 && status <= 599\0Alet http_informational (status: Int): Bool = status >= 100 && status < 200\0A\0A// RFC 9112 section 6.3: these responses end at the header terminator,\0A// before Content-Length or Transfer-Encoding can select body framing.\0Alet http_response_bodyless (method: String) (status: Int): Bool =\0A    method == \22HEAD\22 || http_informational(status) || status == 204 || status == 304\0A\0Alet http_tunnel (method: String) (status: Int): Bool =\0A    method == \22CONNECT\22 && status >= 200 && status < 300\0A\0Alet http_parse_status_line (line: String): Result[Int, String] = {\0A    let parts = line.split(\22 \22);\0A    if parts.len() < 2 { Err(\22http client: malformed status line: \22.concat(line)) }\0A    else if parts[0] != \22HTTP/1.0\22 && parts[0] != \22HTTP/1.1\22 {\0A        Err(\22http client: unsupported HTTP version\22)\0A    } else {\0A        let code = parts[1].as_bytes();\0A        if code.len() != 3 || !http_digit(http_byte(code, 0)) || !http_digit(http_byte(code, 1)) || !http_digit(http_byte(code, 2)) {\0A            Err(\22http client: malformed status code\22)\0A        } else { match String.parse_int(parts[1]) {\0A            Err(e) => Err(\22http client: malformed status code: \22.concat(e)),\0A            Ok(status) => if http_status_valid(status) { Ok(status) } else { Err(\22http client: invalid response status\22) },\0A        } }\0A    }\0A}\0A\0Alet http_byte (b: Bytes) (i: Int): Int = match b.at(i) { Some(c) => c, None => -1 }\0Alet http_ows (c: Int): Bool = c == 32 || c == 9\0Alet http_ows_start (b: Bytes) (i: Int): Int =\0A    if http_ows(http_byte(b, i)) { http_ows_start(b, i + 1) } else { i }\0Alet http_ows_end (b: Bytes) (i: Int): Int =\0A    if http_ows(http_byte(b, i - 1)) { http_ows_end(b, i - 1) } else { i }\0A\0A// Only SP/HTAB are optional whitespace. Generic Unicode trimming would\0A// erase malformed controls. String.slice uses codepoints, Bytes uses octets.\0Alet http_trim_ows (s: String): String = {\0A    let b = s.as_bytes();\0A    let start = http_ows_start(b, 0);\0A    let end = http_ows_end(b, b.len());\0A    String.slice(s, start, String.char_len(s) - (b.len() - end))\0A}\0A\0Alet http_parse_header_line (line: String): Result[Header, String] =\0A    match String.index_of(line, \22:\22) {\0A        None => Err(\22http: malformed header line\22),\0A        Some(i) => {\0A            let name = String.slice(line, 0, i);\0A            let value = http_trim_ows(String.slice(line, i + 1, String.char_len(line)));\0A            if !http_token_ok(name) { Err(\22http: invalid header name\22) }\0A            else if !http_text_ok_acc(value.as_bytes(), 0, true) { Err(\22http: invalid header value\22) }\0A            else { Ok(Header { name: name, value: value }) }\0A        },\0A    }\0A\0A// Tail recursion keeps the stack bounded and moves the accumulator into\0A// push. Never silently discard a malformed field (including obs-fold).\0Alet http_parse_headers_acc (lines: Array[String]) (i: Int) (acc: Array[Header]): Result[Array[Header], String] =\0A    if i >= lines.len() { Ok(acc) }\0A    else { match http_parse_header_line(lines[i]) {\0A        Err(e) => Err(e),\0A        Ok(h) => http_parse_headers_acc(lines, i + 1, acc.push(h)),\0A    } }\0A\0Alet http_parse_headers (lines: Array[String]): Result[Array[Header], String] =\0A    http_parse_headers_acc(lines, 0, [])\0A\0A// Parsed names are ASCII tokens; folding never changes their spelling in\0A// the public Header. The same comparison serves Host and body framing.\0Alet http_ascii_lower (c: Int): Int = if c >= 65 && c <= 90 { c + 32 } else { c }\0Alet http_ascii_equal (a: Bytes) (b: Bytes) (i: Int): Bool =\0A    if i >= a.len() { true }\0A    else if http_ascii_lower(http_byte(a, i)) != http_ascii_lower(http_byte(b, i)) { false }\0A    else { http_ascii_equal(a, b, i + 1) }\0A\0Alet http_header_named (header: Header) (name: String): Bool =\0A    header.name.len() == name.len() && http_ascii_equal(header.name.as_bytes(), name.as_bytes(), 0)\0A\0Alet http_find_header (headers: Array[Header]) (name: String): Option[String] =\0A    Option.map(Array.find(headers, |h| http_header_named(h, name)), |h| h.value)\0A\0A// Parse decimal lists directly from bytes: no split array or magnitude-sized\0A// recursion/allocation. The -1 sentinel means no length has been seen yet.\0A// SP/HTAB may surround list members, never interrupt a decimal number.\0Alet http_lengths (b: Bytes) (i: Int) (n: Int) (phase: Int) (known: Int): Result[Int, String] = {\0A    let c = http_byte(b, i);\0A    if i == b.len() || c == 44 {\0A        if phase == 0 { Err(\22http: invalid Content-Length header\22) }\0A        else if known >= 0 && known != n { Err(\22http: conflicting Content-Length headers\22) }\0A        else if i == b.len() { Ok(n) }\0A        else { http_lengths(b, i + 1, 0, 0, n) }\0A    } else if http_digit(c) && phase != 2 {\0A        let digit = c - 48;\0A        if n > (9223372036854775807 - digit) / 10 { Err(\22http: Content-Length out of range\22) }\0A        else { http_lengths(b, i + 1, n * 10 + digit, 1, known) }\0A    } else if http_ows(c) {\0A        http_lengths(b, i + 1, n, if phase == 1 { 2 } else { phase }, known)\0A    } else { Err(\22http: invalid Content-Length header\22) }\0A}\0A\0Alet http_content_lengths (headers: Array[Header]) (i: Int) (known: Int): Result[Int, String] =\0A    if i >= headers.len() { Ok(known) }\0A    else if http_header_named(headers[i], \22Content-Length\22) {\0A        match http_lengths(headers[i].value.as_bytes(), 0, 0, 0, known) {\0A            Err(e) => Err(e),\0A            Ok(n) => http_content_lengths(headers, i + 1, n),\0A        }\0A    } else { http_content_lengths(headers, i + 1, known) }\0A\0A// Resolve metadata before reading or acknowledging any body. Chunked\0A// decoding is unsupported; never fall back to Content-Length for a coding.\0A// -1 is unframed: empty for requests, close-delimited for responses.\0Alet http_framing (headers: Array[Header]): Result[Int, String] =\0A    match http_find_header(headers, \22Transfer-Encoding\22) {\0A        Some(te) => if Option.is_some(http_find_header(headers, \22Content-Length\22)) {\0A            Err(\22http: Content-Length and Transfer-Encoding cannot be combined\22)\0A        } else { Err(\22http: Transfer-Encoding (\22.concat(te).concat(\22) is not supported yet\22)) },\0A        None => http_content_lengths(headers, 0, -1),\0A    }\0A\0A// Whole-message APIs own Host/framing. Reject caller overrides before\0A// connecting rather than emitting a second, potentially conflicting field.\0Alet http_request_headers (headers: Array[Header]) (i: Int): Result[Unit, String] =\0A    if i >= headers.len() { Ok(()) }\0A    else if http_header_named(headers[i], \22Host\22) || http_header_named(headers[i], \22Content-Length\22)\0A        || http_header_named(headers[i], \22Transfer-Encoding\22) {\0A            Err(\22http client: Host, Content-Length and Transfer-Encoding are managed headers\22)\0A        } else { http_request_headers(headers, i + 1) }\0A\0A// Decode exactly the head, never the body. Byte offsets stay byte offsets\0A// even when a header contains multibyte UTF-8.\0Alet http_parse_head (raw: Bytes): Result[Head, String] =\0A    match http_head_separator(raw, 0) {\0A        None => Err(\22http client: incomplete response head\22),\0A        Some(i) => raw.slice(0, i).as_string() |> Result.and_then(_, |text| {\0A            let lines = text.split(\22\5Cr\5Cn\22);\0A            http_parse_status_line(lines[0]) |> Result.and_then(_, |status|\0A                Result.map(http_parse_headers(Array.drop(lines, 1)), |headers| Head {\0A                    status: status, headers: headers, leftover_body: raw.slice(i + 4, raw.len()),\0A                }))\0A        }),\0A    }\0A\0Alet http_recv_body_by_length_acc (fd: Int) (secure: Int) (acc: Bytes) (remaining: Int): Result[Bytes, String] =\0A    if remaining <= 0 { Ok(acc) }\0A    else { match http_read(fd, secure, Int.min(remaining, 16384)) {\0A        Err(e) => Err(e),\0A        Ok(chunk) => if chunk.is_empty() { Err(\22http client: connection closed before the full response body was received\22) }\0A            else { http_recv_body_by_length_acc(fd, secure, acc.concat(chunk), remaining - chunk.len()) },\0A    } }\0A\0Alet http_recv_body_until_close_acc (fd: Int) (secure: Int) (acc: Bytes): Result[Bytes, String] =\0A    match http_read(fd, secure, 4096) {\0A        Err(e) => Err(e),\0A        Ok(chunk) => if chunk.is_empty() { Ok(acc) }\0A            else { http_recv_body_until_close_acc(fd, secure, acc.concat(chunk)) },\0A    }\0A\0A// Ignore bytes beyond the selected message boundary. This server closes\0A// after one request; surplus bytes must never become handler body content.\0Alet http_read_fixed_body (fd: Int) (secure: Int) (length: Int) (pending: Bytes): Result[Bytes, String] =\0A    if length == 0 { Ok(Bytes.empty()) }\0A    else if pending.len() == length { Ok(pending) }\0A    else if pending.len() > length { Ok(pending.slice(0, length)) }\0A    else { http_recv_body_by_length_acc(fd, secure, pending, length - pending.len()) }\0A\0A// Method/status precedence comes before framing metadata (RFC 9112 6.3).\0Alet http_read_body (fd: Int) (secure: Int) (method: String) (status: Int) (headers: Array[Header]) (leftover_body: Bytes): Result[Bytes, String] =\0A    if http_response_bodyless(method, status) { Ok(Bytes.empty()) }\0A    else if http_tunnel(method, status) { Err(\22http client: CONNECT tunnels are not supported\22) }\0A    else { http_framing(headers) |> Result.and_then(_, |length|\0A        if length < 0 { http_recv_body_until_close_acc(fd, secure, leftover_body) }\0A        else { http_read_fixed_body(fd, secure, length, leftover_body) }) }\0A\0A// Requests without framing have zero content, even if another request or\0A// unsolicited bytes arrived in the same network read.\0Alet http_read_request_body (fd: Int) (headers: Array[Header]) (leftover_body: Bytes): Result[Bytes, String] =\0A    http_framing(headers) |> Result.and_then(_, |length|\0A        http_read_fixed_body(fd, 0, Int.max(0, length), leftover_body))\0A\0A// Carry only unread bytes to the next head. A direct tail call releases\0A// the prev