@.str41401 = private global { i64, i64, [23210 x i8] } { i64 -1, i64 23209, [23210 x i8] c"/*\0A *  PSA cipher driver entry points\0A */\0A/*\0A *  Copyright The Mbed TLS Contributors\0A *  SPDX-License-Identifier: Apache-2.0 OR GPL-2.0-or-later\0A */\0A\0A#include \22common.h\22\0A\0A#if defined(MBEDTLS_PSA_CRYPTO_C)\0A\0A#include \22psa_crypto_cipher.h\22\0A#include \22psa_crypto_core.h\22\0A#include \22psa_crypto_random_impl.h\22\0A\0A#include \22mbedtls/cipher.h\22\0A#include \22mbedtls/error.h\22\0A\0A#include <string.h>\0A\0A/* mbedtls_cipher_values_from_psa() below only checks if the proper build symbols\0A * are enabled, but it does not provide any compatibility check between them\0A * (i.e. if the specified key works with the specified algorithm). This helper\0A * function is meant to provide this support.\0A * mbedtls_cipher_info_from_psa() might be used for the same purpose, but it\0A * requires CIPHER_C to be enabled.\0A */\0Astatic psa_status_t mbedtls_cipher_validate_values(\0A    psa_algorithm_t alg,\0A    psa_key_type_t key_type)\0A{\0A    /* Reduce code size - hinting to the compiler about what it can assume allows the compiler to\0A       eliminate bits of the logic below. */\0A#if !defined(PSA_WANT_KEY_TYPE_AES)\0A    MBEDTLS_ASSUME(key_type != PSA_KEY_TYPE_AES);\0A#endif\0A#if !defined(PSA_WANT_KEY_TYPE_ARIA)\0A    MBEDTLS_ASSUME(key_type != PSA_KEY_TYPE_ARIA);\0A#endif\0A#if !defined(PSA_WANT_KEY_TYPE_CAMELLIA)\0A    MBEDTLS_ASSUME(key_type != PSA_KEY_TYPE_CAMELLIA);\0A#endif\0A#if !defined(PSA_WANT_KEY_TYPE_CHACHA20)\0A    MBEDTLS_ASSUME(key_type != PSA_KEY_TYPE_CHACHA20);\0A#endif\0A#if !defined(PSA_WANT_KEY_TYPE_DES)\0A    MBEDTLS_ASSUME(key_type != PSA_KEY_TYPE_DES);\0A#endif\0A#if !defined(PSA_WANT_ALG_CCM)\0A    MBEDTLS_ASSUME(alg != PSA_ALG_AEAD_WITH_SHORTENED_TAG(PSA_ALG_CCM, 0));\0A#endif\0A#if !defined(PSA_WANT_ALG_GCM)\0A    MBEDTLS_ASSUME(alg != PSA_ALG_AEAD_WITH_SHORTENED_TAG(PSA_ALG_GCM, 0));\0A#endif\0A#if !defined(PSA_WANT_ALG_STREAM_CIPHER)\0A    MBEDTLS_ASSUME(alg != PSA_ALG_STREAM_CIPHER);\0A#endif\0A#if !defined(PSA_WANT_ALG_CHACHA20_POLY1305)\0A    MBEDTLS_ASSUME(alg != PSA_ALG_AEAD_WITH_SHORTENED_TAG(PSA_ALG_CHACHA20_POLY1305, 0));\0A#endif\0A#if !defined(PSA_WANT_ALG_CCM_STAR_NO_TAG)\0A    MBEDTLS_ASSUME(alg != PSA_ALG_CCM_STAR_NO_TAG);\0A#endif\0A#if !defined(PSA_WANT_ALG_CTR)\0A    MBEDTLS_ASSUME(alg != PSA_ALG_CTR);\0A#endif\0A#if !defined(PSA_WANT_ALG_CFB)\0A    MBEDTLS_ASSUME(alg != PSA_ALG_CFB);\0A#endif\0A#if !defined(PSA_WANT_ALG_OFB)\0A    MBEDTLS_ASSUME(alg != PSA_ALG_OFB);\0A#endif\0A#if !defined(PSA_WANT_ALG_ECB_NO_PADDING)\0A    MBEDTLS_ASSUME(alg != PSA_ALG_ECB_NO_PADDING);\0A#endif\0A#if !defined(PSA_WANT_ALG_CBC_NO_PADDING)\0A    MBEDTLS_ASSUME(alg != PSA_ALG_CBC_NO_PADDING);\0A#endif\0A#if !defined(PSA_WANT_ALG_CBC_PKCS7)\0A    MBEDTLS_ASSUME(alg != PSA_ALG_CBC_PKCS7);\0A#endif\0A#if !defined(PSA_WANT_ALG_CMAC)\0A    MBEDTLS_ASSUME(alg != PSA_ALG_CMAC);\0A#endif\0A\0A    if (alg == PSA_ALG_STREAM_CIPHER ||\0A        alg == PSA_ALG_AEAD_WITH_SHORTENED_TAG(PSA_ALG_CHACHA20_POLY1305, 0)) {\0A        if (key_type == PSA_KEY_TYPE_CHACHA20) {\0A            return PSA_SUCCESS;\0A        }\0A    }\0A\0A    if (alg == PSA_ALG_AEAD_WITH_SHORTENED_TAG(PSA_ALG_CCM, 0) ||\0A        alg == PSA_ALG_AEAD_WITH_SHORTENED_TAG(PSA_ALG_GCM, 0) ||\0A        alg == PSA_ALG_CCM_STAR_NO_TAG) {\0A        if (key_type == PSA_KEY_TYPE_AES ||\0A            key_type == PSA_KEY_TYPE_ARIA ||\0A            key_type == PSA_KEY_TYPE_CAMELLIA) {\0A            return PSA_SUCCESS;\0A        }\0A    }\0A\0A    if (alg == PSA_ALG_CTR ||\0A        alg == PSA_ALG_CFB ||\0A        alg == PSA_ALG_OFB ||\0A        alg == PSA_ALG_XTS ||\0A        alg == PSA_ALG_ECB_NO_PADDING ||\0A        alg == PSA_ALG_CBC_NO_PADDING ||\0A        alg == PSA_ALG_CBC_PKCS7 ||\0A        alg == PSA_ALG_CMAC) {\0A        if (key_type == PSA_KEY_TYPE_AES ||\0A            key_type == PSA_KEY_TYPE_ARIA ||\0A            key_type == PSA_KEY_TYPE_DES ||\0A            key_type == PSA_KEY_TYPE_CAMELLIA) {\0A            return PSA_SUCCESS;\0A        }\0A    }\0A\0A    return PSA_ERROR_NOT_SUPPORTED;\0A}\0A\0Apsa_status_t mbedtls_cipher_values_from_psa(\0A    psa_algorithm_t alg,\0A    psa_key_type_t key_type,\0A    size_t *key_bits,\0A    mbedtls_cipher_mode_t *mode,\0A    mbedtls_cipher_id_t *cipher_id)\0A{\0A    mbedtls_cipher_id_t cipher_id_tmp;\0A    /* Only DES modifies key_bits */\0A#if !defined(MBEDTLS_PSA_BUILTIN_KEY_TYPE_DES)\0A    (void) key_bits;\0A#endif\0A\0A    if (PSA_ALG_IS_AEAD(alg)) {\0A        alg = PSA_ALG_AEAD_WITH_SHORTENED_TAG(alg, 0);\0A    }\0A\0A    if (PSA_ALG_IS_CIPHER(alg) || PSA_ALG_IS_AEAD(alg)) {\0A        switch (alg) {\0A#if defined(MBEDTLS_PSA_BUILTIN_ALG_STREAM_CIPHER)\0A            case PSA_ALG_STREAM_CIPHER:\0A                *mode = MBEDTLS_MODE_STREAM;\0A                break;\0A#endif\0A#if defined(MBEDTLS_PSA_BUILTIN_ALG_CTR)\0A            case PSA_ALG_CTR:\0A                *mode = MBEDTLS_MODE_CTR;\0A                break;\0A#endif\0A#if defined(MBEDTLS_PSA_BUILTIN_ALG_CFB)\0A            case PSA_ALG_CFB:\0A                *mode = MBEDTLS_MODE_CFB;\0A                break;\0A#endif\0A#if defined(MBEDTLS_PSA_BUILTIN_ALG_OFB)\0A            case PSA_ALG_OFB:\0A                *mode = MBEDTLS_MODE_OFB;\0A                break;\0A#endif\0A#if defined(MBEDTLS_PSA_BUILTIN_ALG_ECB_NO_PADDING)\0A            case PSA_ALG_ECB_NO_PADDING:\0A                *mode = MBEDTLS_MODE_ECB;\0A                break;\0A#endif\0A#if defined(MBEDTLS_PSA_BUILTIN_ALG_CBC_NO_PADDING)\0A            case PSA_ALG_CBC_NO_PADDING:\0A                *mode = MBEDTLS_MODE_CBC;\0A                break;\0A#endif\0A#if defined(MBEDTLS_PSA_BUILTIN_ALG_CBC_PKCS7)\0A            case PSA_ALG_CBC_PKCS7:\0A                *mode = MBEDTLS_MODE_CBC;\0A                break;\0A#endif\0A#if defined(MBEDTLS_PSA_BUILTIN_ALG_CCM_STAR_NO_TAG)\0A            case PSA_ALG_CCM_STAR_NO_TAG:\0A                *mode = MBEDTLS_MODE_CCM_STAR_NO_TAG;\0A                break;\0A#endif\0A#if defined(MBEDTLS_PSA_BUILTIN_ALG_CCM)\0A            case PSA_ALG_AEAD_WITH_SHORTENED_TAG(PSA_ALG_CCM, 0):\0A                *mode = MBEDTLS_MODE_CCM;\0A                break;\0A#endif\0A#if defined(MBEDTLS_PSA_BUILTIN_ALG_GCM)\0A            case PSA_ALG_AEAD_WITH_SHORTENED_TAG(PSA_ALG_GCM, 0):\0A                *mode = MBEDTLS_MODE_GCM;\0A                break;\0A#endif\0A#if defined(MBEDTLS_PSA_BUILTIN_ALG_CHACHA20_POLY1305)\0A            case PSA_ALG_AEAD_WITH_SHORTENED_TAG(PSA_ALG_CHACHA20_POLY1305, 0):\0A                *mode = MBEDTLS_MODE_CHACHAPOLY;\0A                break;\0A#endif\0A            default:\0A                return PSA_ERROR_NOT_SUPPORTED;\0A        }\0A    } else if (alg == PSA_ALG_CMAC) {\0A        *mode = MBEDTLS_MODE_ECB;\0A    } else {\0A        return PSA_ERROR_NOT_SUPPORTED;\0A    }\0A\0A    switch (key_type) {\0A#if defined(MBEDTLS_PSA_BUILTIN_KEY_TYPE_AES)\0A        case PSA_KEY_TYPE_AES:\0A            cipher_id_tmp = MBEDTLS_CIPHER_ID_AES;\0A            break;\0A#endif\0A#if defined(MBEDTLS_PSA_BUILTIN_KEY_TYPE_ARIA)\0A        case PSA_KEY_TYPE_ARIA:\0A            cipher_id_tmp = MBEDTLS_CIPHER_ID_ARIA;\0A            break;\0A#endif\0A#if defined(MBEDTLS_PSA_BUILTIN_KEY_TYPE_DES)\0A        case PSA_KEY_TYPE_DES:\0A            /* key_bits is 64 for Single-DES, 128 for two-key Triple-DES,\0A             * and 192 for three-key Triple-DES. */\0A            if (*key_bits == 64) {\0A                cipher_id_tmp = MBEDTLS_CIPHER_ID_DES;\0A            } else {\0A                cipher_id_tmp = MBEDTLS_CIPHER_ID_3DES;\0A            }\0A            /* mbedtls doesn't recognize two-key Triple-DES as an algorithm,\0A             * but two-key Triple-DES is functionally three-key Triple-DES\0A             * with K1=K3, so that's how we present it to mbedtls. */\0A            if (*key_bits == 128) {\0A                *key_bits = 192;\0A            }\0A            break;\0A#endif\0A#if defined(MBEDTLS_PSA_BUILTIN_KEY_TYPE_CAMELLIA)\0A        case PSA_KEY_TYPE_CAMELLIA:\0A            cipher_id_tmp = MBEDTLS_CIPHER_ID_CAMELLIA;\0A            break;\0A#endif\0A#if defined(MBEDTLS_PSA_BUILTIN_KEY_TYPE_CHACHA20)\0A        case PSA_KEY_TYPE_CHACHA20:\0A            cipher_id_tmp = MBEDTLS_CIPHER_ID_CHACHA20;\0A            break;\0A#endif\0A        default:\0A            return PSA_ERROR_NOT_SUPPORTED;\0A    }\0A    if (cipher_id != NULL) {\0A        *cipher_id = cipher_id_tmp;\0A    }\0A\0A    return mbedtls_cipher_validate_values(alg, key_type);\0A}\0A\0A#if defined(MBEDTLS_CIPHER_C)\0Aconst mbedtls_cipher_info_t *mbedtls_cipher_info_from_psa(\0A    psa_algorithm_t alg,\0A    psa_key_type_t key_type,\0A    size_t key_bits,\0A    mbedtls_cipher_id_t *cipher_id)\0A{\0A    mbedtls_cipher_mode_t mode;\0A    psa_status_t status;\0A    mbedtls_cipher_id_t cipher_id_tmp = MBEDTLS_CIPHER_ID_NONE;\0A\0A    status = mbedtls_cipher_values_from_psa(alg, key_type, &key_bits, &mode, &cipher_id_tmp);\0A    if (status != PSA_SUCCESS) {\0A        return NULL;\0A    }\0A    if (cipher_id != NULL) {\0A        *cipher_id = cipher_id_tmp;\0A    }\0A\0A    return mbedtls_cipher_info_from_values(cipher_id_tmp, (int) key_bits, mode);\0A}\0A#endif /* MBEDTLS_CIPHER_C */\0A\0A#if defined(MBEDTLS_PSA_BUILTIN_CIPHER)\0A\0Astatic psa_status_t psa_cipher_setup(\0A    mbedtls_psa_cipher_operation_t *operation,\0A    const psa_key_attributes_t *attributes,\0A    const uint8_t *key_buffer, size_t key_buffer_size,\0A    psa_algorithm_t alg,\0A    mbedtls_operation_t cipher_operation)\0A{\0A    int ret = 0;\0A    size_t key_bits;\0A    const mbedtls_cipher_info_t *cipher_info = NULL;\0A    psa_key_type_t key_type = attributes->type;\0A\0A    (void) key_buffer_size;\0A\0A    mbedtls_cipher_init(&operation->ctx.cipher);\0A\0A    operation->alg = alg;\0A    key_bits = attributes->bits;\0A    cipher_info = mbedtls_cipher_info_from_psa(alg, key_type,\0A                                               key_bits, NULL);\0A    if (cipher_info == NULL) {\0A        return PSA_ERROR_NOT_SUPPORTED;\0A    }\0A\0A    ret = mbedtls_cipher_setup(&operation->ctx.cipher, cipher_info);\0A    if (ret != 0) {\0A        goto exit;\0A    }\0A\0A#if defined(MBEDTLS_PSA_BUILTIN_KEY_TYPE_DES)\0A    if (key_type == PSA_KEY_TYPE_DES && key_bits == 128) {\0A        /* Two-key Triple-DES is 3-key Triple-DES with K1=K3 */\0A        uint8_t keys[24];\0A        memcpy(keys, key_buffer, 16);\0A        memcpy(keys + 16, key_buffer, 8);\0A        ret = mbedtls_cipher_setkey(&operation->ctx.cipher,\0A                                    keys,\0A                                    192, cipher_operation);\0A    } else\0A#endif\0A    {\0A        ret = mbedtls_cipher_setkey(&operation->ctx.cipher, key_buffer,\0A                                    (int) key_bits, cipher_operation);\0A    }\0A    if (ret != 0) {\0A        goto exit;\0A    }\0A\0A#if defined(MBEDTLS_PSA_BUILTIN_ALG_CBC_NO_PADDING) || \5C\0A    defined(MBEDTLS_PSA_BUILTIN_ALG_CBC_PKCS7)\0A    switch (alg) {\0A        case PSA_ALG_CBC_NO_PADDING:\0A            ret = mbedtls_cipher_set_padding_mode(&operation->ctx.cipher,\0A                                                  MBEDTLS_PADDING_NONE);\0A            break;\0A        case PSA_ALG_CBC_PKCS7:\0A            ret = mbedtls_cipher_set_padding_mode(&operation->ctx.cipher,\0A                                                  MBEDTLS_PADDING_PKCS7);\0A            break;\0A        default:\0A            /* The algorithm doesn't involve padding. */\0A            ret = 0;\0A            break;\0A    }\0A    if (ret != 0) {\0A        goto exit;\0A    }\0A#endif /* MBEDTLS_PSA_BUILTIN_ALG_CBC_NO_PADDING ||\0A          MBEDTLS_PSA_BUILTIN_ALG_CBC_PKCS7 */\0A\0A    operation->block_length = (PSA_ALG_IS_STREAM_CIPHER(alg) ? 1 :\0A                               PSA_BLOCK_CIPHER_BLOCK_LENGTH(key_type));\0A    operation->iv_length = PSA_CIPHER_IV_LENGTH(key_type, alg);\0A\0Aexit:\0A    return mbedtls_to_psa_error(ret);\0A}\0A\0Apsa_status_t mbedtls_psa_cipher_encrypt_setup(\0A    mbedtls_psa_cipher_operation_t *operation,\0A    const psa_key_attributes_t *attributes,\0A    const uint8_t *key_buffer, size_t key_buffer_size,\0A    psa_algorithm_t alg)\0A{\0A    return psa_cipher_setup(operation, attributes,\0A                            key_buffer, key_buffer_size,\0A                            alg, MBEDTLS_ENCRYPT);\0A}\0A\0Apsa_status_t mbedtls_psa_cipher_decrypt_setup(\0A    mbedtls_psa_cipher_operation_t *operation,\0A    const psa_key_attributes_t *attributes,\0A    const uint8_t *key_buffer, size_t key_buffer_size,\0A    psa_algorithm_t alg)\0A{\0A    return psa_cipher_setup(operation, attributes,\0A                            key_buffer, key_buffer_size,\0A                            alg, MBEDTLS_DECRYPT);\0A}\0A\0Apsa_status_t mbedtls_psa_cipher_set_iv(\0A    mbedtls_psa_cipher_operation_t *operation,\0A    const uint8_t *iv, size_t iv_length)\0A{\0A    if (iv_length != operation->iv_length) {\0A        return PSA_ERROR_INVALID_ARGUMENT;\0A    }\0A\0A    return mbedtls_to_psa_error(\0A        mbedtls_cipher_set_iv(&operation->ctx.cipher,\0A                              iv, iv_length));\0A}\0A\0A#if defined(MBEDTLS_PSA_BUILTIN_ALG_ECB_NO_PADDING)\0A/** Process input for which the algorithm is set to ECB mode.\0A *\0A * This requires manual processing, since the PSA API is defined as being\0A * able to process arbitrary-length calls to psa_cipher_update() with ECB mode,\0A * but the underlying mbedtls_cipher_update only takes full blocks.\0A *\0A * \5Cparam ctx           The mbedtls cipher context to use. It must have been\0A *                      set up for ECB.\0A * \5Cparam[in] input     The input plaintext or ciphertext to process.\0A * \5Cparam input_length  The number of bytes to process from \5Cp input.\0A *                      This does not need to be aligned to a block boundary.\0A *                      If there is a partial block at the end of the input,\0A *                      it is stored in \5Cp ctx for future processing.\0A * \5Cparam output        The buffer where the output is written. It must be\0A *                      at least `BS * floor((p + input_length) / BS)` bytes\0A *                      long, where `p` is the number of bytes in the\0A *                      unprocessed partial block in \5Cp ctx (with\0A *                      `0 <= p <= BS - 1`) and `BS` is the block size.\0A * \5Cparam output_length On success, the number of bytes written to \5Cp output.\0A *                      \5Cc 0 on error.\0A *\0A * \5Creturn #PSA_SUCCESS or an error from a hardware accelerator\0A */\0Astatic psa_status_t psa_cipher_update_ecb(\0A    mbedtls_cipher_context_t *ctx,\0A    const uint8_t *input,\0A    size_t input_length,\0A    uint8_t *output,\0A    size_t *output_length)\0A{\0A    psa_status_t status = PSA_ERROR_CORRUPTION_DETECTED;\0A    size_t block_size = mbedtls_cipher_info_get_block_size(ctx->cipher_info);\0A    size_t internal_output_length = 0;\0A    *output_length = 0;\0A\0A    if (input_length == 0) {\0A        status = PSA_SUCCESS;\0A        goto exit;\0A    }\0A\0A    if (ctx->unprocessed_len > 0) {\0A        /* Fill up to block size, and run the block if there's a full one. */\0A        size_t bytes_to_copy = block_size - ctx->unprocessed_len;\0A\0A        if (input_length < bytes_to_copy) {\0A            bytes_to_copy = input_length;\0A        }\0A\0A        memcpy(&(ctx->unprocessed_data[ctx->unprocessed_len]),\0A               input, bytes_to_copy);\0A        input_length -= bytes_to_copy;\0A        input += bytes_to_copy;\0A        ctx->unprocessed_len += bytes_to_copy;\0A\0A        if (ctx->unprocessed_len == block_size) {\0A            status = mbedtls_to_psa_error(\0A                mbedtls_cipher_update(ctx,\0A                                      ctx->unprocessed_data,\0A                                      block_size,\0A                                      output, &internal_output_length));\0A\0A            if (status != PSA_SUCCESS) {\0A                goto exit;\0A            }\0A\0A            output += internal_output_length;\0A            *output_length += internal_output_length;\0A            ctx->unprocessed_len = 0;\0A        }\0A    }\0A\0A    while (input_length >= block_size) {\0A        /* Run all full blocks we have, one by one */\0A        status = mbedtls_to_psa_error(\0A            mbedtls_cipher_update(ctx, input,\0A                                  block_size,\0A                                  output, &internal_output_length));\0A\0A        if (status != PSA_SUCCESS) {\0A            goto exit;\0A        }\0A\0A        input_length -= block_size;\0A        input += block_size;\0A\0A        output += internal_output_length;\0A        *output_length += internal_output_length;\0A    }\0A\0A    if (input_length > 0) {\0A        /* Save unprocessed bytes for later processing */\0A        memcpy(&(ctx->unprocessed_data[ctx->unprocessed_len]),\0A               input, input_length);\0A        ctx->unprocessed_len += input_length;\0A    }\0A\0A    status = PSA_SUCCESS;\0A\0Aexit:\0A    return status;\0A}\0A#endif /* MBEDTLS_PSA_BUILTIN_ALG_ECB_NO_PADDING */\0A\0Apsa_status_t mbedtls_psa_cipher_update(\0A    mbedtls_psa_cipher_operation_t *operation,\0A    const uint8_t *input, size_t input_length,\0A    uint8_t *output, size_t output_size, size_t *output_length)\0A{\0A    psa_status_t status = PSA_ERROR_CORRUPTION_DETECTED;\0A    size_t expected_output_size;\0A\0A    if (!PSA_ALG_IS_STREAM_CIPHER(operation->alg)) {\0A        /* Take the unprocessed partial block left over from previous\0A         * update calls, if any, plus the input to this call. Remove\0A         * the last partial block, if any. You get the data that will be\0A         * output in this call. */\0A        expected_output_size =\0A            (operation->ctx.cipher.unprocessed_len + input_length)\0A            / operation->block_length * operation->block_length;\0A    } else {\0A        expected_output_size = input_length;\0A    }\0A\0A    if (output_size < expected_output_size) {\0A        return PSA_ERROR_BUFFER_TOO_SMALL;\0A    }\0A\0A#if defined(MBEDTLS_PSA_BUILTIN_ALG_ECB_NO_PADDING)\0A    if (operation->alg == PSA_ALG_ECB_NO_PADDING) {\0A        /* mbedtls_cipher_update has an API inconsistency: it will only\0A         * process a single block at a time in ECB mode. Abstract away that\0A         * inconsistency here to match the PSA API behaviour. */\0A        status = psa_cipher_update_ecb(&operation->ctx.cipher,\0A                                       input,\0A                                       input_length,\0A                                       output,\0A                                       output_length);\0A    } else\0A#endif /* MBEDTLS_PSA_BUILTIN_ALG_ECB_NO_PADDING */\0A    if (input_length == 0) {\0A        /* There is no input, nothing to be done */\0A        *output_length = 0;\0A        status = PSA_SUCCESS;\0A    } else {\0A        status = mbedtls_to_psa_error(\0A            mbedtls_cipher_update(&operation->ctx.cipher, input,\0A                                  input_length, output, output_length));\0A\0A        if (*output_length > output_size) {\0A            return PSA_ERROR_CORRUPTION_DETECTED;\0A        }\0A    }\0A\0A    return status;\0A}\0A\0Apsa_status_t mbedtls_psa_cipher_finish(\0A    mbedtls_psa_cipher_operation_t *operation,\0A    uint8_t *output, size_t output_size, size_t *output_length)\0A{\0A    psa_status_t status = PSA_ERROR_GENERIC_ERROR;\0A    uint8_t temp_output_buffer[MBEDTLS_MAX_BLOCK_LENGTH];\0A\0A    if (operation->ctx.cipher.unprocessed_len != 0) {\0A        if (operation->alg == PSA_ALG_ECB_NO_PADDING ||\0A            operation->alg == PSA_ALG_CBC_NO_PADDING) {\0A            status = PSA_ERROR_INVALID_ARGUMENT;\0A            goto exit;\0A        }\0A    }\0A\0A    status = mbedtls_to_psa_error(\0A        mbedtls_cipher_finish(&operation->ctx.cipher,\0A                              temp_output_buffer,\0A                              output_length));\0A    if (status != PSA_SUCCESS) {\0A        goto exit;\0A    }\0A\0A    if (*output_length == 0) {\0A        ; /* Nothing to copy. Note that output may be NULL in this case. */\0A    } else if (output_size >= *output_length) {\0A        memcpy(output, temp_output_buffer, *output_length);\0A    } else {\0A        status = PSA_ERROR_BUFFER_TOO_SMALL;\0A    }\0A\0Aexit:\0A    mbedtls_platform_zeroize(temp_output_buffer,\0A                             sizeof(temp_output_buffer));\0A\0A    return status;\0A}\0A\0Apsa_status_t mbedtls_psa_cipher_abort(\0A    mbedtls_psa_cipher_operation_t *operation)\0A{\0A    /* Sanity check (shouldn't happen: operation->alg should\0A     * always have been initialized to a valid value). */\0A    if (!PSA_ALG_IS_CIPHER(operation->alg)) {\0A        return PSA_ERROR_BAD_STATE;\0A    }\0A\0A    mbedtls_cipher_free(&operation->ctx.cipher);\0A\0A    return PSA_SUCCESS;\0A}\0A\0Apsa_status_t mbedtls_psa_cipher_encrypt(\0A    const psa_key_attributes_t *attributes,\0A    const uint8_t *key_buffer,\0A    size_t key_buffer_size,\0A    psa_algorithm_t alg,\0A    const uint8_t *iv,\0A    size_t iv_length,\0A    const uint8_t *input,\0A    size_t input_length,\0A    uint8_t *output,\0A    size_t output_size,\0A    size_t *output_length)\0A{\0A    psa_status_t status = PSA_ERROR_CORRUPTION_DETECTED;\0A    mbedtls_psa_cipher_operation_t operation = MBEDTLS_PSA_CIPHER_OPERATION_INIT;\0A    size_t update_output_length, finish_output_length;\0A\0A    status = mbedtls_psa_cipher_encrypt_setup(&operation, attributes,\0A                                              key_buffer, key_buffer_size,\0A                                              alg);\0A    if (status != PSA_SUCCESS) {\0A        goto exit;\0A    }\0A\0A    if (iv_length > 0) {\0A        status = mbedtls_psa_cipher_set_iv(&operation, iv, iv_length);\0A        if (status != PSA_SUCCESS) {\0A            goto exit;\0A        }\0A    }\0A\0A    status = mbedtls_psa_cipher_update(&operation, input, input_length,\0A                                       output, output_size,\0A                                       &update_output_length);\0A    if (status != PSA_SUCCESS) {\0A        goto exit;\0A    }\0A\0A    status = mbedtls_psa_cipher_finish(\0A        &operation,\0A        mbedtls_buffer_offset(output, update_output_length),\0A        output_size - update_output_length, &finish_output_length);\0A    if (status != PSA_SUCCESS) {\0A        goto exit;\0A    }\0A\0A    *output_length = update_output_length + finish_output_length;\0A\0Aexit:\0A    if (status == PSA_SUCCESS) {\0A        status = mbedtls_psa_cipher_abort(&operation);\0A    } else {\0A        mbedtls_psa_cipher_abort(&operation);\0A    }\0A\0A    return status;\0A}\0A\0Apsa_status_t mbedtls_psa_cipher_decrypt(\0A    const psa_key_attributes_t *attributes,\0A    const uint8_t *key_buffer,\0A    size_t key_buffer_size,\0A    psa_algorithm_t alg,\0A    const uint8_t *input,\0A    size_t input_length,\0A    uint8_t *output,\0A    size_t output_size,\0A    size_t *output_length)\0A{\0A    psa_status_t status = PSA_ERROR_CORRUPTION_DETECTED;\0A    mbedtls_psa_cipher_operation_t operation = MBEDTLS_PSA_CIPHER_OPERATION_INIT;\0A    size_t olength, accumulated_length;\0A\0A    status = mbedtls_psa_cipher_decrypt_setup(&operation, attributes,\0A                                              key_buffer, key_buffer_size,\0A                                              alg);\0A    if (status != PSA_SUCCESS) {\0A        goto exit;\0A    }\0A\0A    if (operation.iv_length > 0) {\0A        status = mbedtls_psa_cipher_set_iv(&operation,\0A                                           input, operation.iv_length);\0A        if (status != PSA_SUCCESS) {\0A            goto exit;\0A        }\0A    }\0A\0A    status = mbedtls_psa_cipher_update(\0A        &operation,\0A        mbedtls_buffer_offset_const(input, operation.iv_length),\0A        input_length - operation.iv_length,\0A        output, output_size, &olength);\0A    if (status != PSA_SUCCESS) {\0A        goto exit;\0A    }\0A\0A    accumulated_length = olength;\0A\0A    status = mbedtls_psa_cipher_finish(\0A        &operation,\0A        mbedtls_buffer_offset(output, accumulated_length),\0A        output_size - accumulated_length, &olength);\0A    if (status != PSA_SUCCESS) {\0A        goto exit;\0A    }\0A\0A    *output_length = accumulated_length + olength;\0A\0Aexit:\0A    if (status == PSA_SUCCESS) {\0A        status = mbedtls_psa_cipher_abort(&operation);\0A    } else {\0A        mbedtls_psa_cipher_abort(&operation);\0A    }\0A\0A    return status;\0A}\0A#endif /* MBEDTLS_PSA_BUILTIN_CIPHER */\0A\0A#endif /* MBEDTLS_PSA_CRYPTO_C */\0A\00" }
