@.str41766 = private global { i64, i64, [10970 x i8] } { i64 -1, i64 10969, [10970 x i8] c"/*\0A *  X.509 Certificate Signing Request writing\0A *\0A *  Copyright The Mbed TLS Contributors\0A *  SPDX-License-Identifier: Apache-2.0 OR GPL-2.0-or-later\0A */\0A/*\0A * References:\0A * - CSRs: PKCS#10 v1.7 aka RFC 2986\0A * - attributes: PKCS#9 v2.0 aka RFC 2985\0A */\0A\0A#include \22common.h\22\0A\0A#if defined(MBEDTLS_X509_CSR_WRITE_C)\0A\0A#include \22x509_internal.h\22\0A#include \22mbedtls/x509_csr.h\22\0A#include \22mbedtls/asn1write.h\22\0A#include \22mbedtls/error.h\22\0A#include \22mbedtls/oid.h\22\0A#include \22mbedtls/platform_util.h\22\0A\0A#if defined(MBEDTLS_USE_PSA_CRYPTO)\0A#include \22psa/crypto.h\22\0A#include \22psa_util_internal.h\22\0A#include \22mbedtls/psa_util.h\22\0A#endif /* MBEDTLS_USE_PSA_CRYPTO */\0A\0A#include <string.h>\0A#include <stdlib.h>\0A\0A#if defined(MBEDTLS_PEM_WRITE_C)\0A#include \22mbedtls/pem.h\22\0A#endif\0A\0A#include \22mbedtls/platform.h\22\0A\0Avoid mbedtls_x509write_csr_init(mbedtls_x509write_csr *ctx)\0A{\0A    memset(ctx, 0, sizeof(mbedtls_x509write_csr));\0A}\0A\0Avoid mbedtls_x509write_csr_free(mbedtls_x509write_csr *ctx)\0A{\0A    if (ctx == NULL) {\0A        return;\0A    }\0A\0A    mbedtls_asn1_free_named_data_list(&ctx->subject);\0A    mbedtls_asn1_free_named_data_list(&ctx->extensions);\0A\0A    mbedtls_platform_zeroize(ctx, sizeof(mbedtls_x509write_csr));\0A}\0A\0Avoid mbedtls_x509write_csr_set_md_alg(mbedtls_x509write_csr *ctx, mbedtls_md_type_t md_alg)\0A{\0A    ctx->md_alg = md_alg;\0A}\0A\0Avoid mbedtls_x509write_csr_set_key(mbedtls_x509write_csr *ctx, mbedtls_pk_context *key)\0A{\0A    ctx->key = key;\0A}\0A\0Aint mbedtls_x509write_csr_set_subject_name(mbedtls_x509write_csr *ctx,\0A                                           const char *subject_name)\0A{\0A    return mbedtls_x509_string_to_names(&ctx->subject, subject_name);\0A}\0A\0Aint mbedtls_x509write_csr_set_extension(mbedtls_x509write_csr *ctx,\0A                                        const char *oid, size_t oid_len,\0A                                        int critical,\0A                                        const unsigned char *val, size_t val_len)\0A{\0A    return mbedtls_x509_set_extension(&ctx->extensions, oid, oid_len,\0A                                      critical, val, val_len);\0A}\0A\0Aint mbedtls_x509write_csr_set_subject_alternative_name(mbedtls_x509write_csr *ctx,\0A                                                       const mbedtls_x509_san_list *san_list)\0A{\0A    return mbedtls_x509_write_set_san_common(&ctx->extensions, san_list);\0A}\0A\0Aint mbedtls_x509write_csr_set_key_usage(mbedtls_x509write_csr *ctx, unsigned char key_usage)\0A{\0A    unsigned char buf[4] = { 0 };\0A    unsigned char *c;\0A    int ret = MBEDTLS_ERR_ERROR_CORRUPTION_DETECTED;\0A\0A    c = buf + 4;\0A\0A    ret = mbedtls_asn1_write_named_bitstring(&c, buf, &key_usage, 8);\0A    if (ret < 3 || ret > 4) {\0A        return ret;\0A    }\0A\0A    ret = mbedtls_x509write_csr_set_extension(ctx, MBEDTLS_OID_KEY_USAGE,\0A                                              MBEDTLS_OID_SIZE(MBEDTLS_OID_KEY_USAGE),\0A                                              0, c, (size_t) ret);\0A    if (ret != 0) {\0A        return ret;\0A    }\0A\0A    return 0;\0A}\0A\0Aint mbedtls_x509write_csr_set_ns_cert_type(mbedtls_x509write_csr *ctx,\0A                                           unsigned char ns_cert_type)\0A{\0A    unsigned char buf[4] = { 0 };\0A    unsigned char *c;\0A    int ret = MBEDTLS_ERR_ERROR_CORRUPTION_DETECTED;\0A\0A    c = buf + 4;\0A\0A    ret = mbedtls_asn1_write_named_bitstring(&c, buf, &ns_cert_type, 8);\0A    if (ret < 3 || ret > 4) {\0A        return ret;\0A    }\0A\0A    ret = mbedtls_x509write_csr_set_extension(ctx, MBEDTLS_OID_NS_CERT_TYPE,\0A                                              MBEDTLS_OID_SIZE(MBEDTLS_OID_NS_CERT_TYPE),\0A                                              0, c, (size_t) ret);\0A    if (ret != 0) {\0A        return ret;\0A    }\0A\0A    return 0;\0A}\0A\0Astatic int x509write_csr_der_internal(mbedtls_x509write_csr *ctx,\0A                                      unsigned char *buf,\0A                                      size_t size,\0A                                      unsigned char *sig, size_t sig_size,\0A                                      int (*f_rng)(void *, unsigned char *, size_t),\0A                                      void *p_rng)\0A{\0A    int ret = MBEDTLS_ERR_ERROR_CORRUPTION_DETECTED;\0A    const char *sig_oid;\0A    size_t sig_oid_len = 0;\0A    unsigned char *c, *c2;\0A    unsigned char hash[MBEDTLS_MD_MAX_SIZE];\0A    size_t pub_len = 0, sig_and_oid_len = 0, sig_len;\0A    size_t len = 0;\0A    mbedtls_pk_type_t pk_alg;\0A#if defined(MBEDTLS_USE_PSA_CRYPTO)\0A    size_t hash_len;\0A    psa_algorithm_t hash_alg = mbedtls_md_psa_alg_from_type(ctx->md_alg);\0A#endif /* MBEDTLS_USE_PSA_CRYPTO */\0A\0A    /* Write the CSR backwards starting from the end of buf */\0A    c = buf + size;\0A\0A    MBEDTLS_ASN1_CHK_ADD(len, mbedtls_x509_write_extensions(&c, buf,\0A                                                            ctx->extensions));\0A\0A    if (len) {\0A        MBEDTLS_ASN1_CHK_ADD(len, mbedtls_asn1_write_len(&c, buf, len));\0A        MBEDTLS_ASN1_CHK_ADD(len,\0A                             mbedtls_asn1_write_tag(\0A                                 &c, buf,\0A                                 MBEDTLS_ASN1_CONSTRUCTED | MBEDTLS_ASN1_SEQUENCE));\0A\0A        MBEDTLS_ASN1_CHK_ADD(len, mbedtls_asn1_write_len(&c, buf, len));\0A        MBEDTLS_ASN1_CHK_ADD(len,\0A                             mbedtls_asn1_write_tag(\0A                                 &c, buf,\0A                                 MBEDTLS_ASN1_CONSTRUCTED | MBEDTLS_ASN1_SET));\0A\0A        MBEDTLS_ASN1_CHK_ADD(len,\0A                             mbedtls_asn1_write_oid(\0A                                 &c, buf, MBEDTLS_OID_PKCS9_CSR_EXT_REQ,\0A                                 MBEDTLS_OID_SIZE(MBEDTLS_OID_PKCS9_CSR_EXT_REQ)));\0A\0A        MBEDTLS_ASN1_CHK_ADD(len, mbedtls_asn1_write_len(&c, buf, len));\0A        MBEDTLS_ASN1_CHK_ADD(len,\0A                             mbedtls_asn1_write_tag(\0A                                 &c, buf,\0A                                 MBEDTLS_ASN1_CONSTRUCTED | MBEDTLS_ASN1_SEQUENCE));\0A    }\0A\0A    MBEDTLS_ASN1_CHK_ADD(len, mbedtls_asn1_write_len(&c, buf, len));\0A    MBEDTLS_ASN1_CHK_ADD(len,\0A                         mbedtls_asn1_write_tag(\0A                             &c, buf,\0A                             MBEDTLS_ASN1_CONSTRUCTED | MBEDTLS_ASN1_CONTEXT_SPECIFIC));\0A\0A    MBEDTLS_ASN1_CHK_ADD(pub_len, mbedtls_pk_write_pubkey_der(ctx->key,\0A                                                              buf, (size_t) (c - buf)));\0A    c -= pub_len;\0A    len += pub_len;\0A\0A    /*\0A     *  Subject  ::=  Name\0A     */\0A    MBEDTLS_ASN1_CHK_ADD(len, mbedtls_x509_write_names(&c, buf,\0A                                                       ctx->subject));\0A\0A    /*\0A     *  Version  ::=  INTEGER  {  v1(0), v2(1), v3(2)  }\0A     */\0A    MBEDTLS_ASN1_CHK_ADD(len, mbedtls_asn1_write_int(&c, buf, 0));\0A\0A    MBEDTLS_ASN1_CHK_ADD(len, mbedtls_asn1_write_len(&c, buf, len));\0A    MBEDTLS_ASN1_CHK_ADD(len,\0A                         mbedtls_asn1_write_tag(\0A                             &c, buf,\0A                             MBEDTLS_ASN1_CONSTRUCTED | MBEDTLS_ASN1_SEQUENCE));\0A\0A    /*\0A     * Sign the written CSR data into the sig buffer\0A     * Note: hash errors can happen only after an internal error\0A     */\0A#if defined(MBEDTLS_USE_PSA_CRYPTO)\0A    if (psa_hash_compute(hash_alg,\0A                         c,\0A                         len,\0A                         hash,\0A                         sizeof(hash),\0A                         &hash_len) != PSA_SUCCESS) {\0A        return MBEDTLS_ERR_PLATFORM_HW_ACCEL_FAILED;\0A    }\0A#else /* MBEDTLS_USE_PSA_CRYPTO */\0A    ret = mbedtls_md(mbedtls_md_info_from_type(ctx->md_alg), c, len, hash);\0A    if (ret != 0) {\0A        return ret;\0A    }\0A#endif\0A    if ((ret = mbedtls_pk_sign(ctx->key, ctx->md_alg, hash, 0,\0A                               sig, sig_size, &sig_len,\0A                               f_rng, p_rng)) != 0) {\0A        return ret;\0A    }\0A\0A    if (mbedtls_pk_can_do(ctx->key, MBEDTLS_PK_RSA)) {\0A        pk_alg = MBEDTLS_PK_RSA;\0A    } else if (mbedtls_pk_can_do(ctx->key, MBEDTLS_PK_ECDSA)) {\0A        pk_alg = MBEDTLS_PK_ECDSA;\0A    } else {\0A        return MBEDTLS_ERR_X509_INVALID_ALG;\0A    }\0A\0A    if ((ret = mbedtls_oid_get_oid_by_sig_alg(pk_alg, ctx->md_alg,\0A                                              &sig_oid, &sig_oid_len)) != 0) {\0A        return ret;\0A    }\0A\0A    /*\0A     * Move the written CSR data to the start of buf to create space for\0A     * writing the signature into buf.\0A     */\0A    memmove(buf, c, len);\0A\0A    /*\0A     * Write sig and its OID into buf backwards from the end of buf.\0A     * Note: mbedtls_x509_write_sig will check for c2 - ( buf + len ) < sig_len\0A     * and return MBEDTLS_ERR_ASN1_BUF_TOO_SMALL if needed.\0A     */\0A    c2 = buf + size;\0A    MBEDTLS_ASN1_CHK_ADD(sig_and_oid_len,\0A                         mbedtls_x509_write_sig(&c2, buf + len, sig_oid, sig_oid_len,\0A                                                sig, sig_len, pk_alg));\0A\0A    /*\0A     * Compact the space between the CSR data and signature by moving the\0A     * CSR data to the start of the signature.\0A     */\0A    c2 -= len;\0A    memmove(c2, buf, len);\0A\0A    /* ASN encode the total size and tag the CSR data with it. */\0A    len += sig_and_oid_len;\0A    MBEDTLS_ASN1_CHK_ADD(len, mbedtls_asn1_write_len(&c2, buf, len));\0A    MBEDTLS_ASN1_CHK_ADD(len,\0A                         mbedtls_asn1_write_tag(\0A                             &c2, buf,\0A                             MBEDTLS_ASN1_CONSTRUCTED | MBEDTLS_ASN1_SEQUENCE));\0A\0A    /* Zero the unused bytes at the start of buf */\0A    memset(buf, 0, (size_t) (c2 - buf));\0A\0A    return (int) len;\0A}\0A\0Aint mbedtls_x509write_csr_der(mbedtls_x509write_csr *ctx, unsigned char *buf,\0A                              size_t size,\0A                              int (*f_rng)(void *, unsigned char *, size_t),\0A                              void *p_rng)\0A{\0A    int ret;\0A    unsigned char *sig;\0A\0A    if ((sig = mbedtls_calloc(1, MBEDTLS_PK_SIGNATURE_MAX_SIZE)) == NULL) {\0A        return MBEDTLS_ERR_X509_ALLOC_FAILED;\0A    }\0A\0A    ret = x509write_csr_der_internal(ctx, buf, size,\0A                                     sig, MBEDTLS_PK_SIGNATURE_MAX_SIZE,\0A                                     f_rng, p_rng);\0A\0A    mbedtls_free(sig);\0A\0A    return ret;\0A}\0A\0A#define PEM_BEGIN_CSR           \22-----BEGIN CERTIFICATE REQUEST-----\5Cn\22\0A#define PEM_END_CSR             \22-----END CERTIFICATE REQUEST-----\5Cn\22\0A\0A#if defined(MBEDTLS_PEM_WRITE_C)\0Aint mbedtls_x509write_csr_pem(mbedtls_x509write_csr *ctx, unsigned char *buf, size_t size,\0A                              int (*f_rng)(void *, unsigned char *, size_t),\0A                              void *p_rng)\0A{\0A    int ret = MBEDTLS_ERR_ERROR_CORRUPTION_DETECTED;\0A    size_t olen = 0;\0A\0A    if ((ret = mbedtls_x509write_csr_der(ctx, buf, size,\0A                                         f_rng, p_rng)) < 0) {\0A        return ret;\0A    }\0A\0A    if ((ret = mbedtls_pem_write_buffer(PEM_BEGIN_CSR, PEM_END_CSR,\0A                                        buf + size - ret,\0A                                        ret, buf, size, &olen)) != 0) {\0A        return ret;\0A    }\0A\0A    return 0;\0A}\0A#endif /* MBEDTLS_PEM_WRITE_C */\0A\0A#endif /* MBEDTLS_X509_CSR_WRITE_C */\0A\00" }
