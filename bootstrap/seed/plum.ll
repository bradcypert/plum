bal_data_t global_data;\0A\0Astatic uint8_t psa_get_initialized(void)\0A{\0A    uint8_t initialized;\0A\0A#if defined(MBEDTLS_THREADING_C)\0A    mbedtls_mutex_lock(&mbedtls_threading_psa_rngdata_mutex);\0A#endif /* defined(MBEDTLS_THREADING_C) */\0A\0A    initialized = global_data.rng_state == RNG_SEEDED;\0A\0A#if defined(MBEDTLS_THREADING_C)\0A    mbedtls_mutex_unlock(&mbedtls_threading_psa_rngdata_mutex);\0A#endif /* defined(MBEDTLS_THREADING_C) */\0A\0A#if defined(MBEDTLS_THREADING_C)\0A    mbedtls_mutex_lock(&mbedtls_threading_psa_globaldata_mutex);\0A#endif /* defined(MBEDTLS_THREADING_C) */\0A\0A    initialized =\0A        (initialized && (global_data.initialized == PSA_CRYPTO_SUBSYSTEM_ALL_INITIALISED));\0A\0A#if defined(MBEDTLS_THREADING_C)\0A    mbedtls_mutex_unlock(&mbedtls_threading_psa_globaldata_mutex);\0A#endif /* defined(MBEDTLS_THREADING_C) */\0A\0A    return initialized;\0A}\0A\0Astatic uint8_t psa_get_drivers_initialized(void)\0A{\0A    uint8_t initialized;\0A\0A#if defined(MBEDTLS_THREADING_C)\0A    mbedtls_mutex_lock(&mbedtls_threading_psa_globaldata_mutex);\0A#endif /* defined(MBEDTLS_THREADING_C) */\0A\0A    initialized = (global_data.initialized & PSA_CRYPTO_SUBSYSTEM_DRIVER_WRAPPERS_INITIALIZED) != 0;\0A\0A#if defined(MBEDTLS_THREADING_C)\0A    mbedtls_mutex_unlock(&mbedtls_threading_psa_globaldata_mutex);\0A#endif /* defined(MBEDTLS_THREADING_C) */\0A\0A    return initialized;\0A}\0A\0A#define GUARD_MODULE_INITIALIZED        \5C\0A    if (psa_get_initialized() == 0)     \5C\0A    return PSA_ERROR_BAD_STATE;\0A\0A#if !defined(MBEDTLS_PSA_ASSUME_EXCLUSIVE_BUFFERS)\0A\0A/* Declare a local copy of an input buffer and a variable that will be used\0A * to store a pointer to the start of the buffer.\0A *\0A * Note: This macro must be called before any operations which may jump to\0A * the exit label, so that the local input copy object is safe to be freed.\0A *\0A * Assumptions:\0A * - input is the name of a pointer to the buffer to be copied\0A * - The name LOCAL_INPUT_COPY_OF_input is unused in the current scope\0A * - input_copy_name is a name that is unused in the current scope\0A */\0A#define LOCAL_INPUT_DECLARE(input, input_copy_name) \5C\0A    psa_crypto_local_input_t LOCAL_INPUT_COPY_OF_##input = PSA_CRYPTO_LOCAL_INPUT_INIT; \5C\0A    const uint8_t *input_copy_name = NULL;\0A\0A/* Allocate a copy of the buffer input and set the pointer input_copy to\0A * point to the start of the copy.\0A *\0A * Assumptions:\0A * - psa_status_t status exists\0A * - An exit label is declared\0A * - input is the name of a pointer to the buffer to be copied\0A * - LOCAL_INPUT_DECLARE(input, input_copy) has previously been called\0A */\0A#define LOCAL_INPUT_ALLOC(input, length, input_copy) \5C\0A    status = psa_crypto_local_input_alloc(input, length, \5C\0A                                          &LOCAL_INPUT_COPY_OF_##input); \5C\0A    if (status != PSA_SUCCESS) { \5C\0A        goto exit; \5C\0A    } \5C\0A    input_copy = LOCAL_INPUT_COPY_OF_##input.buffer;\0A\0A/* Free the local input copy allocated previously by LOCAL_INPUT_ALLOC()\0A *\0A * Assumptions:\0A * - input_copy is the name of the input copy pointer set by LOCAL_INPUT_ALLOC()\0A * - input is the name of the original buffer that was copied\0A */\0A#define LOCAL_INPUT_FREE(input, input_copy) \5C\0A    input_copy = NULL; \5C\0A    psa_crypto_local_input_free(&LOCAL_INPUT_COPY_OF_##input);\0A\0A/* Declare a local copy of an output buffer and a variable that will be used\0A * to store a pointer to the start of the buffer.\0A *\0A * Note: This macro must be called before any operations which may jump to\0A * the exit label, so that the local output copy object is safe to be freed.\0A *\0A * Assumptions:\0A * - output is the name of a pointer to the buffer to be copied\0A * - The name LOCAL_OUTPUT_COPY_OF_output is unused in the current scope\0A * - output_copy_name is a name that is unused in the current scope\0A */\0A#define LOCAL_OUTPUT_DECLARE(output, output_copy_name) \5C\0A    psa_crypto_local_output_t LOCAL_OUTPUT_COPY_OF_##output = PSA_CRYPTO_LOCAL_OUTPUT_INIT; \5C\0A    uint8_t *output_copy_name = NULL;\0A\0A/* Allocate a copy of the buffer output and set the pointer output_copy to\0A * point to the start of the copy.\0A *\0A * Assumptions:\0A * - psa_status_t status exists\0A * - An exit label is declared\0A * - output is the name of a pointer to the buffer to be copied\0A * - LOCAL_OUTPUT_DECLARE(output, output_copy) has previously been called\0A */\0A#define LOCAL_OUTPUT_ALLOC(output, length, output_copy) \5C\0A    status = psa_crypto_local_output_alloc(output, length, \5C\0A                                           &LOCAL_OUTPUT_COPY_OF_##output); \5C\0A    if (status != PSA_SUCCESS) { \5C\0A        goto exit; \5C\0A    } \5C\0A    output_copy = LOCAL_OUTPUT_COPY_OF_##output.buffer;\0A\0A/* Free the local output copy allocated previously by LOCAL_OUTPUT_ALLOC()\0A * after first copying back its contents to the original buffer.\0A *\0A * Assumptions:\0A * - psa_status_t status exists\0A * - output_copy is the name of the output copy pointer set by LOCAL_OUTPUT_ALLOC()\0A * - output is the name of the original buffer that was copied\0A */\0A#define LOCAL_OUTPUT_FREE(output, output_copy) \5C\0A    output_copy = NULL; \5C\0A    do { \5C\0A        psa_status_t local_output_status; \5C\0A        local_output_status = psa_crypto_local_output_free(&LOCAL_OUTPUT_COPY_OF_##output); \5C\0A        if (local_output_status != PSA_SUCCESS) { \5C\0A            /* Since this error case is an internal error, it's more serious than \5C\0A             * any existing error code and so it's fine to overwrite the existing \5C\0A             * status. */ \5C\0A            status = local_output_status; \5C\0A        } \5C\0A    } while (0)\0A#else /* !MBEDTLS_PSA_ASSUME_EXCLUSIVE_BUFFERS */\0A#define LOCAL_INPUT_DECLARE(input, input_copy_name) \5C\0A    const uint8_t *input_copy_name = NULL;\0A#define LOCAL_INPUT_ALLOC(input, length, input_copy) \5C\0A    input_copy = input;\0A#define LOCAL_INPUT_FREE(input, input_copy) \5C\0A    input_copy = NULL;\0A#define LOCAL_OUTPUT_DECLARE(output, output_copy_name) \5C\0A    uint8_t *output_copy_name = NULL;\0A#define LOCAL_OUTPUT_ALLOC(output, length, output_copy) \5C\0A    output_copy = output;\0A#define LOCAL_OUTPUT_FREE(output, output_copy) \5C\0A    output_copy = NULL;\0A#endif /* !MBEDTLS_PSA_ASSUME_EXCLUSIVE_BUFFERS */\0A\0A\0Aint psa_can_do_hash(psa_algorithm_t hash_alg)\0A{\0A    (void) hash_alg;\0A    return psa_get_drivers_initialized();\0A}\0A\0Aint psa_can_do_cipher(psa_key_type_t key_type, psa_algorithm_t cipher_alg)\0A{\0A    (void) key_type;\0A    (void) cipher_alg;\0A    return psa_get_drivers_initialized();\0A}\0A\0A\0A#if defined(MBEDTLS_PSA_BUILTIN_KEY_TYPE_DH_KEY_PAIR_IMPORT) ||       \5C\0A    defined(MBEDTLS_PSA_BUILTIN_KEY_TYPE_DH_PUBLIC_KEY) ||     \5C\0A    defined(PSA_WANT_KEY_TYPE_DH_KEY_PAIR_GENERATE)\0Astatic int psa_is_dh_key_size_valid(size_t bits)\0A{\0A    switch (bits) {\0A#if defined(PSA_WANT_DH_RFC7919_2048)\0A        case 2048:\0A            return 1;\0A#endif /* PSA_WANT_DH_RFC7919_2048 */\0A#if defined(PSA_WANT_DH_RFC7919_3072)\0A        case 3072:\0A            return 1;\0A#endif /* PSA_WANT_DH_RFC7919_3072 */\0A#if defined(PSA_WANT_DH_RFC7919_4096)\0A        case 4096:\0A            return 1;\0A#endif /* PSA_WANT_DH_RFC7919_4096 */\0A#if defined(PSA_WANT_DH_RFC7919_6144)\0A        case 6144:\0A            return 1;\0A#endif /* PSA_WANT_DH_RFC7919_6144 */\0A#if defined(PSA_WANT_DH_RFC7919_8192)\0A        case 8192:\0A            return 1;\0A#endif /* PSA_WANT_DH_RFC7919_8192 */\0A        default:\0A            return 0;\0A    }\0A}\0A#endif /* MBEDTLS_PSA_BUILTIN_KEY_TYPE_DH_KEY_PAIR_IMPORT ||\0A          MBEDTLS_PSA_BUILTIN_KEY_TYPE_DH_PUBLIC_KEY ||\0A          PSA_WANT_KEY_TYPE_DH_KEY_PAIR_GENERATE */\0A\0Apsa_status_t mbedtls_to_psa_error(int ret)\0A{\0A    /* Mbed TLS error codes can combine a high-level error code and a\0A     * low-level error code. The low-level error usually reflects the\0A     * root cause better, so dispatch on that preferably. */\0A    int low_level_ret = -(-ret & 0x007f);\0A    switch (low_level_ret != 0 ? low_level_ret : ret) {\0A        case 0:\0A            return PSA_SUCCESS;\0A\0A#if defined(MBEDTLS_AES_C)\0A        case MBEDTLS_ERR_AES_INVALID_KEY_LENGTH:\0A        case MBEDTLS_ERR_AES_INVALID_INPUT_LENGTH:\0A            return PSA_ERROR_NOT_SUPPORTED;\0A        case MBEDTLS_ERR_AES_BAD_INPUT_DATA:\0A            return PSA_ERROR_INVALID_ARGUMENT;\0A#endif\0A\0A#if defined(MBEDTLS_ASN1_PARSE_C) || defined(MBEDTLS_ASN1_WRITE_C)\0A        case MBEDTLS_ERR_ASN1_OUT_OF_DATA:\0A        case MBEDTLS_ERR_ASN1_UNEXPECTED_TAG:\0A        case MBEDTLS_ERR_ASN1_INVALID_LENGTH:\0A        case MBEDTLS_ERR_ASN1_LENGTH_MISMATCH:\0A        case MBEDTLS_ERR_ASN1_INVALID_DATA:\0A            return PSA_ERROR_INVALID_ARGUMENT;\0A        case MBEDTLS_ERR_ASN1_ALLOC_FAILED:\0A            return PSA_ERROR_INSUFFICIENT_MEMORY;\0A        case MBEDTLS_ERR_ASN1_BUF_TOO_SMALL:\0A            return PSA_ERROR_BUFFER_TOO_SMALL;\0A#endif\0A\0A#if defined(MBEDTLS_CAMELLIA_C)\0A        case MBEDTLS_ERR_CAMELLIA_BAD_INPUT_DATA:\0A        case MBEDTLS_ERR_CAMELLIA_INVALID_INPUT_LENGTH:\0A            return PSA_ERROR_NOT_SUPPORTED;\0A#endif\0A\0A#if defined(MBEDTLS_CCM_C)\0A        case MBEDTLS_ERR_CCM_BAD_INPUT:\0A            return PSA_ERROR_INVALID_ARGUMENT;\0A        case MBEDTLS_ERR_CCM_AUTH_FAILED:\0A            return PSA_ERROR_INVALID_SIGNATURE;\0A#endif\0A\0A#if defined(MBEDTLS_CHACHA20_C)\0A        case MBEDTLS_ERR_CHACHA20_BAD_INPUT_DATA:\0A            return PSA_ERROR_INVALID_ARGUMENT;\0A#endif\0A\0A#if defined(MBEDTLS_CHACHAPOLY_C)\0A        case MBEDTLS_ERR_CHACHAPOLY_BAD_STATE:\0A            return PSA_ERROR_BAD_STATE;\0A        case MBEDTLS_ERR_CHACHAPOLY_AUTH_FAILED:\0A            return PSA_ERROR_INVALID_SIGNATURE;\0A#endif\0A\0A#if defined(MBEDTLS_CIPHER_C)\0A  