@.str39533 = private global { i64, i64, [49444 x i8] } { i64 -1, i64 49443, [49444 x i8] c"/**\0A * \5Cfile dhm.h\0A *\0A * \5Cbrief   This file contains Diffie-Hellman-Merkle (DHM) key exchange\0A *          definitions and functions.\0A *\0A * Diffie-Hellman-Merkle (DHM) key exchange is defined in\0A * <em>RFC-2631: Diffie-Hellman Key Agreement Method</em> and\0A * <em>Public-Key Cryptography Standards (PKCS) #3: Diffie\0A * Hellman Key Agreement Standard</em>.\0A *\0A * <em>RFC-3526: More Modular Exponential (MODP) Diffie-Hellman groups for\0A * Internet Key Exchange (IKE)</em> defines a number of standardized\0A * Diffie-Hellman groups for IKE.\0A *\0A * <em>RFC-5114: Additional Diffie-Hellman Groups for Use with IETF\0A * Standards</em> defines a number of standardized Diffie-Hellman\0A * groups that can be used.\0A *\0A * \5Cwarning  The security of the DHM key exchange relies on the proper choice\0A *           of prime modulus - optimally, it should be a safe prime. The usage\0A *           of non-safe primes both decreases the difficulty of the underlying\0A *           discrete logarithm problem and can lead to small subgroup attacks\0A *           leaking private exponent bits when invalid public keys are used\0A *           and not detected. This is especially relevant if the same DHM\0A *           parameters are reused for multiple key exchanges as in static DHM,\0A *           while the criticality of small-subgroup attacks is lower for\0A *           ephemeral DHM.\0A *\0A * \5Cwarning  For performance reasons, the code does neither perform primality\0A *           nor safe primality tests, nor the expensive checks for invalid\0A *           subgroups. Moreover, even if these were performed, non-standardized\0A *           primes cannot be trusted because of the possibility of backdoors\0A *           that can't be effectively checked for.\0A *\0A * \5Cwarning  Diffie-Hellman-Merkle is therefore a security risk when not using\0A *           standardized primes generated using a trustworthy (\22nothing up\0A *           my sleeve\22) method, such as the RFC 3526 / 7919 primes. In the TLS\0A *           protocol, DH parameters need to be negotiated, so using the default\0A *           primes systematically is not always an option. If possible, use\0A *           Elliptic Curve Diffie-Hellman (ECDH), which has better performance,\0A *           and for which the TLS protocol mandates the use of standard\0A *           parameters.\0A *\0A */\0A/*\0A *  Copyright The Mbed TLS Contributors\0A *  SPDX-License-Identifier: Apache-2.0 OR GPL-2.0-or-later\0A */\0A\0A#ifndef MBEDTLS_DHM_H\0A#define MBEDTLS_DHM_H\0A#include \22mbedtls/private_access.h\22\0A\0A#include \22mbedtls/build_info.h\22\0A#include \22mbedtls/bignum.h\22\0A\0A/*\0A * DHM Error codes\0A */\0A/** Bad input parameters. */\0A#define MBEDTLS_ERR_DHM_BAD_INPUT_DATA                    -0x3080\0A/** Reading of the DHM parameters failed. */\0A#define MBEDTLS_ERR_DHM_READ_PARAMS_FAILED                -0x3100\0A/** Making of the DHM parameters failed. */\0A#define MBEDTLS_ERR_DHM_MAKE_PARAMS_FAILED                -0x3180\0A/** Reading of the public values failed. */\0A#define MBEDTLS_ERR_DHM_READ_PUBLIC_FAILED                -0x3200\0A/** Making of the public value failed. */\0A#define MBEDTLS_ERR_DHM_MAKE_PUBLIC_FAILED                -0x3280\0A/** Calculation of the DHM secret failed. */\0A#define MBEDTLS_ERR_DHM_CALC_SECRET_FAILED                -0x3300\0A/** The ASN.1 data is not formatted correctly. */\0A#define MBEDTLS_ERR_DHM_INVALID_FORMAT                    -0x3380\0A/** Allocation of memory failed. */\0A#define MBEDTLS_ERR_DHM_ALLOC_FAILED                      -0x3400\0A/** Read or write of file failed. */\0A#define MBEDTLS_ERR_DHM_FILE_IO_ERROR                     -0x3480\0A/** Setting the modulus and generator failed. */\0A#define MBEDTLS_ERR_DHM_SET_GROUP_FAILED                  -0x3580\0A\0A/** Which parameter to access in mbedtls_dhm_get_value(). */\0Atypedef enum {\0A    MBEDTLS_DHM_PARAM_P,  /*!<  The prime modulus. */\0A    MBEDTLS_DHM_PARAM_G,  /*!<  The generator. */\0A    MBEDTLS_DHM_PARAM_X,  /*!<  Our secret value. */\0A    MBEDTLS_DHM_PARAM_GX, /*!<  Our public key = \5Cc G^X mod \5Cc P. */\0A    MBEDTLS_DHM_PARAM_GY, /*!<  The public key of the peer = \5Cc G^Y mod \5Cc P. */\0A    MBEDTLS_DHM_PARAM_K,  /*!<  The shared secret = \5Cc G^(XY) mod \5Cc P. */\0A} mbedtls_dhm_parameter;\0A\0A#ifdef __cplusplus\0Aextern \22C\22 {\0A#endif\0A\0A#if !defined(MBEDTLS_DHM_ALT)\0A\0A/**\0A * \5Cbrief          The DHM context structure.\0A */\0Atypedef struct mbedtls_dhm_context {\0A    mbedtls_mpi MBEDTLS_PRIVATE(P);      /*!<  The prime modulus. */\0A    mbedtls_mpi MBEDTLS_PRIVATE(G);      /*!<  The generator. */\0A    mbedtls_mpi MBEDTLS_PRIVATE(X);      /*!<  Our secret value. */\0A    mbedtls_mpi MBEDTLS_PRIVATE(GX);     /*!<  Our public key = \5Cc G^X mod \5Cc P. */\0A    mbedtls_mpi MBEDTLS_PRIVATE(GY);     /*!<  The public key of the peer = \5Cc G^Y mod \5Cc P. */\0A    mbedtls_mpi MBEDTLS_PRIVATE(K);      /*!<  The shared secret = \5Cc G^(XY) mod \5Cc P. */\0A    mbedtls_mpi MBEDTLS_PRIVATE(RP);     /*!<  The cached value = \5Cc R^2 mod \5Cc P. */\0A    mbedtls_mpi MBEDTLS_PRIVATE(Vi);     /*!<  The blinding value. */\0A    mbedtls_mpi MBEDTLS_PRIVATE(Vf);     /*!<  The unblinding value. */\0A    mbedtls_mpi MBEDTLS_PRIVATE(pX);     /*!<  The previous \5Cc X. */\0A}\0Ambedtls_dhm_context;\0A\0A#else /* MBEDTLS_DHM_ALT */\0A#include \22dhm_alt.h\22\0A#endif /* MBEDTLS_DHM_ALT */\0A\0A/**\0A * \5Cbrief          This function initializes the DHM context.\0A *\0A * \5Cparam ctx      The DHM context to initialize.\0A */\0Avoid mbedtls_dhm_init(mbedtls_dhm_context *ctx);\0A\0A/**\0A * \5Cbrief          This function parses the DHM parameters in a\0A *                 TLS ServerKeyExchange handshake message\0A *                 (DHM modulus, generator, and public key).\0A *\0A * \5Cnote           In a TLS handshake, this is the how the client\0A *                 sets up its DHM context from the server's public\0A *                 DHM key material.\0A *\0A * \5Cparam ctx      The DHM context to use. This must be initialized.\0A * \5Cparam p        On input, *p must be the start of the input buffer.\0A *                 On output, *p is updated to point to the end of the data\0A *                 that has been read. On success, this is the first byte\0A *                 past the end of the ServerKeyExchange parameters.\0A *                 On error, this is the point at which an error has been\0A *                 detected, which is usually not useful except to debug\0A *                 failures.\0A * \5Cparam end      The end of the input buffer.\0A *\0A * \5Creturn         \5Cc 0 on success.\0A * \5Creturn         An \5Cc MBEDTLS_ERR_DHM_XXX error code on failure.\0A */\0Aint mbedtls_dhm_read_params(mbedtls_dhm_context *ctx,\0A                            unsigned char **p,\0A                            const unsigned char *end);\0A\0A/**\0A * \5Cbrief          This function generates a DHM key pair and exports its\0A *                 public part together with the DHM parameters in the format\0A *                 used in a TLS ServerKeyExchange handshake message.\0A *\0A * \5Cnote           This function assumes that the DHM parameters \5Cc ctx->P\0A *                 and \5Cc ctx->G have already been properly set. For that, use\0A *                 mbedtls_dhm_set_group() below in conjunction with\0A *                 mbedtls_mpi_read_binary() and mbedtls_mpi_read_string().\0A *\0A * \5Cnote           In a TLS handshake, this is the how the server generates\0A *                 and exports its DHM key material.\0A *\0A * \5Cparam ctx      The DHM context to use. This must be initialized\0A *                 and have the DHM parameters set. It may or may not\0A *                 already have imported the peer's public key.\0A * \5Cparam x_size   The private key size in Bytes.\0A * \5Cparam olen     The address at which to store the number of Bytes\0A *                 written on success. This must not be \5Cc NULL.\0A * \5Cparam output   The destination buffer. This must be a writable buffer of\0A *                 sufficient size to hold the reduced binary presentation of\0A *                 the modulus, the generator and the public key, each wrapped\0A *                 with a 2-byte length field. It is the responsibility of the\0A *                 caller to ensure that enough space is available. Refer to\0A *                 mbedtls_mpi_size() to computing the byte-size of an MPI.\0A * \5Cparam f_rng    The RNG function. Must not be \5Cc NULL.\0A * \5Cparam p_rng    The RNG context to be passed to \5Cp f_rng. This may be\0A *                 \5Cc NULL if \5Cp f_rng doesn't need a context parameter.\0A *\0A * \5Creturn         \5Cc 0 on success.\0A * \5Creturn         An \5Cc MBEDTLS_ERR_DHM_XXX error code on failure.\0A */\0Aint mbedtls_dhm_make_params(mbedtls_dhm_context *ctx, int x_size,\0A                            unsigned char *output, size_t *olen,\0A                            int (*f_rng)(void *, unsigned char *, size_t),\0A                            void *p_rng);\0A\0A/**\0A * \5Cbrief          This function sets the prime modulus and generator.\0A *\0A * \5Cnote           This function can be used to set \5Cc ctx->P, \5Cc ctx->G\0A *                 in preparation for mbedtls_dhm_make_params().\0A *\0A * \5Cparam ctx      The DHM context to configure. This must be initialized.\0A * \5Cparam P        The MPI holding the DHM prime modulus. This must be\0A *                 an initialized MPI.\0A * \5Cparam G        The MPI holding the DHM generator. This must be an\0A *                 initialized MPI.\0A *\0A * \5Creturn         \5Cc 0 if successful.\0A * \5Creturn         An \5Cc MBEDTLS_ERR_DHM_XXX error code on failure.\0A */\0Aint mbedtls_dhm_set_group(mbedtls_dhm_context *ctx,\0A                          const mbedtls_mpi *P,\0A                          const mbedtls_mpi *G);\0A\0A/**\0A * \5Cbrief          This function imports the raw public value of the peer.\0A *\0A * \5Cnote           In a TLS handshake, this is the how the server imports\0A *                 the Client's public DHM key.\0A *\0A * \5Cparam ctx      The DHM context to use. This must be initialized and have\0A *                 its DHM parameters set, e.g. via mbedtls_dhm_set_group().\0A *                 It may or may not already have generated its own private key.\0A * \5Cparam input    The input buffer containing the \5Cc G^Y value of the peer.\0A *                 This must be a readable buffer of size \5Cp ilen Bytes.\0A * \5Cparam ilen     The size of the input buffer \5Cp input in Bytes.\0A *\0A * \5Creturn         \5Cc 0 on success.\0A * \5Creturn         An \5Cc MBEDTLS_ERR_DHM_XXX error code on failure.\0A */\0Aint mbedtls_dhm_read_public(mbedtls_dhm_context *ctx,\0A                            const unsigned char *input, size_t ilen);\0A\0A/**\0A * \5Cbrief          This function creates a DHM key pair and exports\0A *                 the raw public key in big-endian format.\0A *\0A * \5Cnote           The destination buffer is always fully written\0A *                 so as to contain a big-endian representation of G^X mod P.\0A *                 If it is larger than \5Cc ctx->len, it is padded accordingly\0A *                 with zero-bytes at the beginning.\0A *\0A * \5Cparam ctx      The DHM context to use. This must be initialized and\0A *                 have the DHM parameters set. It may or may not already\0A *                 have imported the peer's public key.\0A * \5Cparam x_size   The private key size in Bytes.\0A * \5Cparam output   The destination buffer. This must be a writable buffer of\0A *                 size \5Cp olen Bytes.\0A * \5Cparam olen     The length of the destination buffer. This must be at least\0A *                 equal to `ctx->len` (the size of \5Cc P).\0A * \5Cparam f_rng    The RNG function. This must not be \5Cc NULL.\0A * \5Cparam p_rng    The RNG context to be passed to \5Cp f_rng. This may be \5Cc NULL\0A *                 if \5Cp f_rng doesn't need a context argument.\0A *\0A * \5Creturn         \5Cc 0 on success.\0A * \5Creturn         An \5Cc MBEDTLS_ERR_DHM_XXX error code on failure.\0A */\0Aint mbedtls_dhm_make_public(mbedtls_dhm_context *ctx, int x_size,\0A                            unsigned char *output, size_t olen,\0A                            int (*f_rng)(void *, unsigned char *, size_t),\0A                            void *p_rng);\0A\0A/**\0A * \5Cbrief          This function derives and exports the shared secret\0A *                 \5Cc (G^Y)^X mod \5Cc P.\0A *\0A * \5Cnote           If \5Cp f_rng is not \5Cc NULL, it is used to blind the input as\0A *                 a countermeasure against timing attacks. Blinding is used\0A *                 only if our private key \5Cc X is re-used, and not used\0A *                 otherwise. We recommend always passing a non-NULL\0A *                 \5Cp f_rng argument.\0A *\0A * \5Cparam ctx           The DHM context to use. This must be initialized\0A *                      and have its own private key generated and the peer's\0A *                      public key imported.\0A * \5Cparam output        The buffer to write the generated shared key to. This\0A *                      must be a writable buffer of size \5Cp output_size Bytes.\0A * \5Cparam output_size   The size of the destination buffer. This must be at\0A *                      least the size of \5Cc ctx->len (the size of \5Cc P).\0A * \5Cparam olen          On exit, holds the actual number of Bytes written.\0A * \5Cparam f_rng         The RNG function. Must not be \5Cc NULL. Used for\0A *                      blinding.\0A * \5Cparam p_rng         The RNG context to be passed to \5Cp f_rng. This may be\0A *                      \5Cc NULL if \5Cp f_rng doesn't need a context parameter.\0A *\0A * \5Creturn              \5Cc 0 on success.\0A * \5Creturn              An \5Cc MBEDTLS_ERR_DHM_XXX error code on failure.\0A */\0Aint mbedtls_dhm_calc_secret(mbedtls_dhm_context *ctx,\0A                            unsigned char *output, size_t output_size, size_t *olen,\0A                            int (*f_rng)(void *, unsigned char *, size_t),\0A                            void *p_rng);\0A\0A/**\0A * \5Cbrief          This function returns the size of the prime modulus in bits.\0A *\0A * \5Cparam ctx      The DHM context to query.\0A *\0A * \5Creturn         The size of the prime modulus in bits,\0A *                 i.e. the number n such that 2^(n-1) <= P < 2^n.\0A */\0Asize_t mbedtls_dhm_get_bitlen(const mbedtls_dhm_context *ctx);\0A\0A/**\0A * \5Cbrief          This function returns the size of the prime modulus in bytes.\0A *\0A * \5Cparam ctx      The DHM context to query.\0A *\0A * \5Creturn         The size of the prime modulus in bytes,\0A *                 i.e. the number n such that 2^(8*(n-1)) <= P < 2^(8*n).\0A */\0Asize_t mbedtls_dhm_get_len(const mbedtls_dhm_context *ctx);\0A\0A/**\0A * \5Cbrief          This function copies a parameter of a DHM key.\0A *\0A * \5Cparam ctx      The DHM context to query.\0A * \5Cparam param    The parameter to copy.\0A * \5Cparam dest     The MPI object to copy the value into. It must be\0A *                 initialized.\0A *\0A * \5Creturn         \5Cc 0 on success.\0A * \5Creturn         #MBEDTLS_ERR_DHM_BAD_INPUT_DATA if \5Cp param is invalid.\0A * \5Creturn         An \5Cc MBEDTLS_ERR_MPI_XXX error code if the copy fails.\0A */\0Aint mbedtls_dhm_get_value(const mbedtls_dhm_context *ctx,\0A                          mbedtls_dhm_parameter param,\0A                          mbedtls_mpi *dest);\0A\0A/**\0A * \5Cbrief          This function frees and clears the components\0A *                 of a DHM context.\0A *\0A * \5Cparam ctx      The DHM context to free and clear. This may be \5Cc NULL,\0A *           