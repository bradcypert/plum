str_bound);\0A    if (ret != 0) {\0A        goto error;\0A    }\0A    if ((component1 < 2) && (component2 > 39)) {\0A        /* Root nodes 0 and 1 may have up to 40 children, numbered 0-39 */\0A        ret = MBEDTLS_ERR_ASN1_INVALID_DATA;\0A        goto error;\0A    }\0A    if (str_ptr < str_bound) {\0A        if (*str_ptr == '.') {\0A            str_ptr++;\0A        } else {\0A            ret = MBEDTLS_ERR_ASN1_INVALID_DATA;\0A            goto error;\0A        }\0A    }\0A\0A    if (component2 > (UINT_MAX - (component1 * 40))) {\0A        ret = MBEDTLS_ERR_ASN1_INVALID_DATA;\0A        goto error;\0A    }\0A    ret = oid_subidentifier_encode_into(&out_ptr, out_bound,\0A                                        (component1 * 40) + component2);\0A    if (ret != 0) {\0A        goto error;\0A    }\0A\0A    while (str_ptr < str_bound) {\0A        ret = oid_parse_number(&val, &str_ptr, str_bound);\0A        if (ret != 0) {\0A            goto error;\0A        }\0A        if (str_ptr < str_bound) {\0A            if (*str_ptr == '.') {\0A                str_ptr++;\0A            } else {\0A                ret = MBEDTLS_ERR_ASN1_INVALID_DATA;\0A                goto error;\0A            }\0A        }\0A\0A        ret = oid_subidentifier_encode_into(&out_ptr, out_bound, val);\0A        if (ret != 0) {\0A            goto error;\0A        }\0A    }\0A\0A    encoded_len = (size_t) (out_ptr - oid->p);\0A    resized_mem = mbedtls_calloc(encoded_len, 1);\0A    if (resized_mem == NULL) {\0A        ret = MBEDTLS_ERR_ASN1_ALLOC_FAILED;\0A        goto error;\0A    }\0A    memcpy(resized_mem, oid->p, encoded_len);\0A    mbedtls_free(oid->p);\0A    oid->p = resized_mem;\0A    oid->len = encoded_len;\0A\0A    oid->tag = MBEDTLS_ASN1_OID;\0A\0A    return 0;\0A\0Aerror:\0A    mbedtls_free(oid->p);\0A    oid->p = NULL;\0A    oid->len = 0;\0A    return ret;\0A}\0A\0A#endif /* MBEDTLS_OID_C */\0A\00" }
