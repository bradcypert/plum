@.str40431 = private global { i64, i64, [6594 x i8] } { i64 -1, i64 6593, [6594 x i8] c"// Cleanup for handles the program never got to release (issue #1).\0A//\0A// A `handle` runs its `on_drop` when the value dies, which covers every\0A// ordinary exit: a normal return, a block ending, an `Err` being\0A// returned. Plum has no early `return`, so those really are all the\0A// paths a function can take -- except one.\0A//\0A// **A panic does not unwind.** `panic_raw` prints and calls `exit`, so\0A// nothing between the failure and the process ending runs, and a\0A// `Child` outlived its parent's panic and kept working. That is not\0A// untidiness the operating system tidies up: the OS reclaims file\0A// descriptors and memory, and does not kill your grandchildren, remove\0A// your lock file, or take the terminal out of raw mode.\0A//\0A// So live handles are tracked, and released on the way out.\0A//\0A// --- Why `atexit` and not a hook in `plum_panic` ---\0A//\0A// Every exit this needs to cover goes through `exit()`: `panic_raw`\0A// does, `Os.exit_with` does, and returning from `main` does. One\0A// `atexit` handler therefore covers all three, and covers any future\0A// path that exits properly, without the panic code knowing this exists.\0A//\0A// Only declared native handles are registered, not ordinary heap values.\0A// The registry borrows cell identities; it never retains a cell or changes\0A// its reference count. Geometric growth removes the old 256-handle limit.\0A// Sixteen inline entries avoid heap allocation for small programs. Extra\0A// storage shrinks after a burst and is freed when the last entry leaves.\0A// Registration/removal and exit cleanup share one mutex. Drop callbacks\0A// run outside it: they may release or create other handles, or call exit.\0A\0A#include <pthread.h>\0A#include <stdint.h>\0A#include <stdio.h>\0A#include <stdlib.h>\0A#include <string.h>\0A\0Atypedef struct {\0A    void *cell;\0A    void (*on_drop)(long long);\0A    long long value;\0A} PlumTrackedHandle;\0A\0Astatic pthread_mutex_t plum_tracked_lock = PTHREAD_MUTEX_INITIALIZER;\0Astatic PlumTrackedHandle plum_tracked_inline[16];\0Astatic PlumTrackedHandle *plum_tracked = plum_tracked_inline;\0Astatic size_t plum_tracked_n, plum_tracked_capacity = 16;\0Astatic int plum_tracked_armed, plum_tracked_running, plum_tracked_closed;\0A\0A// Called with the lock held. Shrinking is optional; failure keeps the\0A// existing allocation and all registrations intact.\0Astatic void plum_handle_trim(void) {\0A    if (plum_tracked_n == 0) {\0A        if (plum_tracked != plum_tracked_inline) free(plum_tracked);\0A        plum_tracked = plum_tracked_inline;\0A        plum_tracked_capacity = 16;\0A    } else if (plum_tracked_capacity > 16 &&\0A               plum_tracked_n <= plum_tracked_capacity / 4) {\0A        size_t capacity = plum_tracked_capacity / 2;\0A        PlumTrackedHandle *next;\0A        if (capacity == 16) {\0A            next = plum_tracked_inline;\0A            memcpy(next, plum_tracked, plum_tracked_n * sizeof(*next));\0A            free(plum_tracked);\0A        } else next = realloc(plum_tracked, capacity * sizeof(*next));\0A        if (next) {\0A            plum_tracked = next;\0A            plum_tracked_capacity = capacity;\0A        }\0A    }\0A}\0A\0A// LIFO among entries still registered. Claim a record under the lock,\0A// then use a COPY outside it, since callbacks can resize the registry.\0A// Ordinary release uses the same claim, so only one path calls on_drop.\0Astatic void plum_handle_cleanup_all(void) {\0A    pthread_mutex_lock(&plum_tracked_lock);\0A    if (plum_tracked_running || plum_tracked_closed) {\0A        pthread_mutex_unlock(&plum_tracked_lock);\0A        return;\0A    }\0A    plum_tracked_running = 1;\0A    while (plum_tracked_n > 0) {\0A        PlumTrackedHandle t = plum_tracked[--plum_tracked_n];\0A        plum_handle_trim();\0A        pthread_mutex_unlock(&plum_tracked_lock);\0A        if (t.on_drop) t.on_drop(t.value);\0A        pthread_mutex_lock(&plum_tracked_lock);\0A    }\0A    plum_tracked_closed = 1;\0A    plum_tracked_running = 0;\0A    pthread_mutex_unlock(&plum_tracked_lock);\0A}\0A\0A// No error channel exists in the generated from_raw ABI. Never return an\0A// unregistered resource on failure: release it, report why, and exit via\0A// the already-armed cleanup for older registrations. No allocation is\0A// needed on this path. The callback runs without the registry lock.\0Astatic void plum_handle_track_fail(void (*on_drop)(long long), long long value,\0A                                   const char *reason) {\0A    fprintf(stderr, \22panic: handle tracking failed: %s\5Cn\22, reason);\0A    if (on_drop) on_drop(value);\0A    exit(1);\0A}\0A\0Avoid plum_handle_track(void *cell, void (*on_drop)(long long), long long value) {\0A    const char *failure = NULL;\0A    pthread_mutex_lock(&plum_tracked_lock);\0A    if (plum_tracked_closed) failure = \22process cleanup already completed\22;\0A    else if (!plum_tracked_armed) {\0A        if (atexit(plum_handle_cleanup_all) != 0)\0A            failure = \22cannot register exit cleanup\22;\0A        else plum_tracked_armed = 1;\0A    }\0A    if (!failure && plum_tracked_n == plum_tracked_capacity) {\0A        size_t capacity = plum_tracked_capacity * 2;\0A        if (capacity < plum_tracked_capacity || capacity > SIZE_MAX / sizeof(*plum_tracked))\0A            failure = \22registry size overflow\22;\0A        else {\0A            PlumTrackedHandle *next = realloc(\0A                plum_tracked == plum_tracked_inline ? NULL : plum_tracked,\0A                capacity * sizeof(*next));\0A            if (!next) failure = \22out of memory\22;\0A            else {\0A                if (plum_tracked == plum_tracked_inline)\0A                    memcpy(next, plum_tracked_inline, plum_tracked_n * sizeof(*next));\0A                plum_tracked = next;\0A                plum_tracked_capacity = capacity;\0A            }\0A        }\0A    }\0A    if (!failure)\0A        plum_tracked[plum_tracked_n++] = (PlumTrackedHandle){cell, on_drop, value};\0A    pthread_mutex_unlock(&plum_tracked_lock);\0A    if (failure) plum_handle_track_fail(on_drop, value, failure);\0A}\0A\0A// Return whether ordinary release owns the callback. A missing entry\0A// has already been claimed by exit cleanup; the caller still frees the\0A// refcounted cell but must not drop the underlying resource again.\0Aint plum_handle_untrack(void *cell) {\0A    pthread_mutex_lock(&plum_tracked_lock);\0A    for (size_t i = plum_tracked_n; i > 0; i--) {\0A        if (plum_tracked[i - 1].cell == cell) {\0A            memmove(&plum_tracked[i - 1], &plum_tracked[i],\0A                    (plum_tracked_n - i) * sizeof(*plum_tracked));\0A            plum_tracked_n--;\0A            plum_handle_trim();\0A            pthread_mutex_unlock(&plum_tracked_lock);\0A            return 1;\0A        }\0A    }\0A    pthread_mutex_unlock(&plum_tracked_lock);\0A    return 0;\0A}\0A\00" }
