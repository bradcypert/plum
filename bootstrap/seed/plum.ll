  %ad = getelementptr i8, ptr %args, i64 16
  %ed = getelementptr i8, ptr %env, i64 16
  %sd = getelementptr i8, ptr %stdin, i64 16
  %h = call i64 @process_run_ex(ptr %pd, ptr %ad, i64 %argc, ptr %ed, i64 %envc, ptr %sd, i64 %stdin_len, i64 %has_stdin)
  ret i64 %h
}

