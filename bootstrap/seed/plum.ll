  if (status != PSA_SUCCESS) {\0A        goto exit;\0A    }\0A\0A    status = mbedtls_to_psa_error(\0A        mbedtls_ecdh_get_params(&ecdh, their_key, MBEDTLS_ECDH_THEIRS));\0A    if (status != PSA_SUCCESS) {\0A        goto exit;\0A    }\0A    status = mbedtls_to_psa_error(\0A        mbedtls_ecdh_get_params(&ecdh, ecp, MBEDTLS_ECDH_OURS));\0A    if (status != PSA_SUCCESS) {\0A        goto exit;\0A    }\0A\0A    status = mbedtls_to_psa_error(\0A        mbedtls_ecdh_calc_secret(&ecdh,\0A                                 shared_secret_length,\0A                                 shared_secret, shared_secret_size,\0A                                 mbedtls_psa_get_random,\0A                                 MBEDTLS_PSA_RANDOM_STATE));\0A    if (status != PSA_SUCCESS) {\0A        goto exit;\0A    }\0A    if (PSA_BITS_TO_BYTES(bits) != *shared_secret_length) {\0A        status = PSA_ERROR_CORRUPTION_DETECTED;\0A    }\0Aexit:\0A    if (status != PSA_SUCCESS) {\0A        mbedtls_platform_zeroize(shared_secret, shared_secret_size);\0A    }\0A    mbedtls_ecdh_free(&ecdh);\0A    mbedtls_ecp_keypair_free(their_key);\0A    mbedtls_free(their_key);\0A    mbedtls_ecp_keypair_free(ecp);\0A    mbedtls_free(ecp);\0A    return status;\0A}\0A#endif /* MBEDTLS_PSA_BUILTIN_ALG_ECDH */\0A\0A\0A#endif /* MBEDTLS_PSA_CRYPTO_C */\0A\00" }
