@.str39799 = private global { i64, i64, [14576 x i8] } { i64 -1, i64 14575, [14576 x i8] c"/**\0A * \5Cfile x509_csr.h\0A *\0A * \5Cbrief X.509 certificate signing request parsing and writing\0A */\0A/*\0A *  Copyright The Mbed TLS Contributors\0A *  SPDX-License-Identifier: Apache-2.0 OR GPL-2.0-or-later\0A */\0A#ifndef MBEDTLS_X509_CSR_H\0A#define MBEDTLS_X509_CSR_H\0A#include \22mbedtls/private_access.h\22\0A\0A#include \22mbedtls/build_info.h\22\0A\0A#include \22mbedtls/x509.h\22\0A\0A#ifdef __cplusplus\0Aextern \22C\22 {\0A#endif\0A\0A/**\0A * \5Caddtogroup x509_module\0A * \5C{ */\0A\0A/**\0A * \5Cname Structures and functions for X.509 Certificate Signing Requests (CSR)\0A * \5C{\0A */\0A\0A/**\0A * Certificate Signing Request (CSR) structure.\0A *\0A * Some fields of this structure are publicly readable. Do not modify\0A * them except via Mbed TLS library functions: the effect of modifying\0A * those fields or the data that those fields point to is unspecified.\0A */\0Atypedef struct mbedtls_x509_csr {\0A    mbedtls_x509_buf raw;           /**< The raw CSR data (DER). */\0A    mbedtls_x509_buf cri;           /**< The raw CertificateRequestInfo body (DER). */\0A\0A    int version;            /**< CSR version (1=v1). */\0A\0A    mbedtls_x509_buf  subject_raw;  /**< The raw subject data (DER). */\0A    mbedtls_x509_name subject;      /**< The parsed subject data (named information object). */\0A\0A    mbedtls_pk_context pk;          /**< Container for the public key context. */\0A\0A    unsigned int key_usage;     /**< Optional key usage extension value: See the values in x509.h */\0A    unsigned char ns_cert_type; /**< Optional Netscape certificate type extension value: See the values in x509.h */\0A    mbedtls_x509_sequence subject_alt_names; /**< Optional list of raw entries of Subject Alternative Names extension. These can be later parsed by mbedtls_x509_parse_subject_alt_name. */\0A\0A    int MBEDTLS_PRIVATE(ext_types);              /**< Bit string containing detected and parsed extensions */\0A\0A    mbedtls_x509_buf sig_oid;\0A    mbedtls_x509_buf MBEDTLS_PRIVATE(sig);\0A    mbedtls_md_type_t MBEDTLS_PRIVATE(sig_md);       /**< Internal representation of the MD algorithm of the signature algorithm, e.g. MBEDTLS_MD_SHA256 */\0A    mbedtls_pk_type_t MBEDTLS_PRIVATE(sig_pk);       /**< Internal representation of the Public Key algorithm of the signature algorithm, e.g. MBEDTLS_PK_RSA */\0A    void *MBEDTLS_PRIVATE(sig_opts);         /**< Signature options to be passed to mbedtls_pk_verify_ext(), e.g. for RSASSA-PSS */\0A}\0Ambedtls_x509_csr;\0A\0A/**\0A * Container for writing a CSR\0A */\0Atypedef struct mbedtls_x509write_csr {\0A    mbedtls_pk_context *MBEDTLS_PRIVATE(key);\0A    mbedtls_asn1_named_data *MBEDTLS_PRIVATE(subject);\0A    mbedtls_md_type_t MBEDTLS_PRIVATE(md_alg);\0A    mbedtls_asn1_named_data *MBEDTLS_PRIVATE(extensions);\0A}\0Ambedtls_x509write_csr;\0A\0A#if defined(MBEDTLS_X509_CSR_PARSE_C)\0A/**\0A * \5Cbrief          Load a Certificate Signing Request (CSR) in DER format\0A *\0A * \5Cnote           Any unsupported requested extensions are silently\0A *                 ignored, unless the critical flag is set, in which case\0A *                 the CSR is rejected.\0A *\0A * \5Cnote           If #MBEDTLS_USE_PSA_CRYPTO is enabled, the PSA crypto\0A *                 subsystem must have been initialized by calling\0A *                 psa_crypto_init() before calling this function.\0A *\0A * \5Cparam csr      CSR context to fill\0A * \5Cparam buf      buffer holding the CRL data\0A * \5Cparam buflen   size of the buffer\0A *\0A * \5Creturn         0 if successful, or a specific X509 error code\0A */\0Aint mbedtls_x509_csr_parse_der(mbedtls_x509_csr *csr,\0A                               const unsigned char *buf, size_t buflen);\0A\0A/**\0A * \5Cbrief          The type of certificate extension callbacks.\0A *\0A *                 Callbacks of this type are passed to and used by the\0A *                 mbedtls_x509_csr_parse_der_with_ext_cb() routine when\0A *                 it encounters either an unsupported extension.\0A *                 Future versions of the library may invoke the callback\0A *                 in other cases, if and when the need arises.\0A *\0A * \5Cparam p_ctx    An opaque context passed to the callback.\0A * \5Cparam csr      The CSR being parsed.\0A * \5Cparam oid      The OID of the extension.\0A * \5Cparam critical Whether the extension is critical.\0A * \5Cparam p        Pointer to the start of the extension value\0A *                 (the content of the OCTET STRING).\0A * \5Cparam end      End of extension value.\0A *\0A * \5Cnote           The callback must fail and return a negative error code\0A *                 if it can not parse or does not support the extension.\0A *                 When the callback fails to parse a critical extension\0A *                 mbedtls_x509_csr_parse_der_with_ext_cb() also fails.\0A *                 When the callback fails to parse a non critical extension\0A *                 mbedtls_x509_csr_parse_der_with_ext_cb() simply skips\0A *                 the extension and continues parsing.\0A *\0A * \5Creturn         \5Cc 0 on success.\0A * \5Creturn         A negative error code on failure.\0A */\0Atypedef int (*mbedtls_x509_csr_ext_cb_t)(void *p_ctx,\0A                                         mbedtls_x509_csr const *csr,\0A                                         mbedtls_x509_buf const *oid,\0A                                         int critical,\0A                                         const unsigned char *p,\0A                                         const unsigned char *end);\0A\0A/**\0A * \5Cbrief          Load a Certificate Signing Request (CSR) in DER format\0A *\0A * \5Cnote           Any unsupported requested extensions are silently\0A *                 ignored, unless the critical flag is set, in which case\0A *                 the result of the callback function decides whether\0A *                 CSR is rejected.\0A *\0A * \5Cnote           If #MBEDTLS_USE_PSA_CRYPTO is enabled, the PSA crypto\0A *                 subsystem must have been initialized by calling\0A *                 psa_crypto_init() before calling this function.\0A *\0A * \5Cparam csr      CSR context to fill\0A * \5Cparam buf      buffer holding the CRL data\0A * \5Cparam buflen   size of the buffer\0A * \5Cparam cb       A callback invoked for every unsupported certificate\0A *                 extension.\0A * \5Cparam p_ctx    An opaque context passed to the callback.\0A *\0A * \5Creturn         0 if successful, or a specific X509 error code\0A */\0Aint mbedtls_x509_csr_parse_der_with_ext_cb(mbedtls_x509_csr *csr,\0A                                           const unsigned char *buf, size_t buflen,\0A                                           mbedtls_x509_csr_ext_cb_t cb,\0A                                           void *p_ctx);\0A\0A/**\0A * \5Cbrief          Load a Certificate Signing Request (CSR), DER or PEM format\0A *\0A * \5Cnote           See notes for \5Cc mbedtls_x509_csr_parse_der()\0A *\0A * \5Cnote           If #MBEDTLS_USE_PSA_CRYPTO is enabled, the PSA crypto\0A *                 subsystem must have been initialized by calling\0A *                 psa_crypto_init() before calling this function.\0A *\0A * \5Cparam csr      CSR context to fill\0A * \5Cparam buf      buffer holding the CRL data\0A * \5Cparam buflen   size of the buffer\0A *                 (including the terminating null byte for PEM data)\0A *\0A * \5Creturn         0 if successful, or a specific X509 or PEM error code\0A */\0Aint mbedtls_x509_csr_parse(mbedtls_x509_csr *csr, const unsigned char *buf, size_t buflen);\0A\0A#if defined(MBEDTLS_FS_IO)\0A/**\0A * \5Cbrief          Load a Certificate Signing Request (CSR)\0A *\0A * \5Cnote           See notes for \5Cc mbedtls_x509_csr_parse()\0A *\0A * \5Cparam csr      CSR context to fill\0A * \5Cparam path     filename to read the CSR from\0A *\0A * \5Creturn         0 if successful, or a specific X509 or PEM error code\0A */\0Aint mbedtls_x509_csr_parse_file(mbedtls_x509_csr *csr, const char *path);\0A#endif /* MBEDTLS_FS_IO */\0A\0A#if !defined(MBEDTLS_X509_REMOVE_INFO)\0A/**\0A * \5Cbrief          Returns an informational string about the\0A *                 CSR.\0A *\0A * \5Cparam buf      Buffer to write to\0A * \5Cparam size     Maximum size of buffer\0A * \5Cparam prefix   A line prefix\0A * \5Cparam csr      The X509 CSR to represent\0A *\0A * \5Creturn         The length of the string written (not including the\0A *                 terminated nul byte), or a negative error code.\0A */\0Aint mbedtls_x509_csr_info(char *buf, size_t size, const char *prefix,\0A                          const mbedtls_x509_csr *csr);\0A#endif /* !MBEDTLS_X509_REMOVE_INFO */\0A\0A/**\0A * \5Cbrief          Initialize a CSR\0A *\0A * \5Cparam csr      CSR to initialize\0A */\0Avoid mbedtls_x509_csr_init(mbedtls_x509_csr *csr);\0A\0A/**\0A * \5Cbrief          Unallocate all CSR data\0A *\0A * \5Cparam csr      CSR to free\0A */\0Avoid mbedtls_x509_csr_free(mbedtls_x509_csr *csr);\0A#endif /* MBEDTLS_X509_CSR_PARSE_C */\0A\0A/** \5C} name Structures and functions for X.509 Certificate Signing Requests (CSR) */\0A\0A#if defined(MBEDTLS_X509_CSR_WRITE_C)\0A/**\0A * \5Cbrief           Initialize a CSR context\0A *\0A * \5Cparam ctx       CSR context to initialize\0A */\0Avoid mbedtls_x509write_csr_init(mbedtls_x509write_csr *ctx);\0A\0A/**\0A * \5Cbrief           Set the subject name for a CSR\0A *                  Subject names should contain a comma-separated list\0A *                  of OID types and values:\0A *                  e.g. \22C=UK,O=ARM,CN=Mbed TLS Server 1\22\0A *\0A * \5Cparam ctx           CSR context to use\0A * \5Cparam subject_name  subject name to set\0A *\0A * \5Creturn          0 if subject name was parsed successfully, or\0A *                  a specific error code\0A */\0Aint mbedtls_x509write_csr_set_subject_name(mbedtls_x509write_csr *ctx,\0A                                           const char *subject_name);\0A\0A/**\0A * \5Cbrief           Set the key for a CSR (public key will be included,\0A *                  private key used to sign the CSR when writing it)\0A *\0A * \5Cparam ctx       CSR context to use\0A * \5Cparam key       Asymmetric key to include\0A */\0Avoid mbedtls_x509write_csr_set_key(mbedtls_x509write_csr *ctx, mbedtls_pk_context *key);\0A\0A/**\0A * \5Cbrief           Set the MD algorithm to use for the signature\0A *                  (e.g. MBEDTLS_MD_SHA1)\0A *\0A * \5Cparam ctx       CSR context to use\0A * \5Cparam md_alg    MD algorithm to use\0A */\0Avoid mbedtls_x509write_csr_set_md_alg(mbedtls_x509write_csr *ctx, mbedtls_md_type_t md_alg);\0A\0A/**\0A * \5Cbrief           Set the Key Usage Extension flags\0A *                  (e.g. MBEDTLS_X509_KU_DIGITAL_SIGNATURE | MBEDTLS_X509_KU_KEY_CERT_SIGN)\0A *\0A * \5Cparam ctx       CSR context to use\0A * \5Cparam key_usage key usage flags to set\0A *\0A * \5Creturn          0 if successful, or MBEDTLS_ERR_X509_ALLOC_FAILED\0A *\0A * \5Cnote            The <code>decipherOnly</code> flag from the Key Usage\0A *                  extension is represented by bit 8 (i.e.\0A *                  <code>0x8000</code>), which cannot typically be represented\0A *                  in an unsigned char. Therefore, the flag\0A *                  <code>decipherOnly</code> (i.e.\0A *                  #MBEDTLS_X509_KU_DECIPHER_ONLY) cannot be set using this\0A *                  function.\0A */\0Aint mbedtls_x509write_csr_set_key_usage(mbedtls_x509write_csr *ctx, unsigned char key_usage);\0A\0A/**\0A * \5Cbrief           Set Subject Alternative Name\0A *\0A * \5Cparam ctx       CSR context to use\0A * \5Cparam san_list  List of SAN values\0A *\0A * \5Creturn          0 if successful, or MBEDTLS_ERR_X509_ALLOC_FAILED\0A *\0A * \5Cnote            Only \22dnsName\22, \22uniformResourceIdentifier\22 and \22otherName\22,\0A *                  as defined in RFC 5280, are supported.\0A */\0Aint mbedtls_x509write_csr_set_subject_alternative_name(mbedtls_x509write_csr *ctx,\0A                                                       const mbedtls_x509_san_list *san_list);\0A\0A/**\0A * \5Cbrief           Set the Netscape Cert Type flags\0A *                  (e.g. MBEDTLS_X509_NS_CERT_TYPE_SSL_CLIENT | MBEDTLS_X509_NS_CERT_TYPE_EMAIL)\0A *\0A * \5Cparam ctx           CSR context to use\0A * \5Cparam ns_cert_type  Netscape Cert Type flags to set\0A *\0A * \5Creturn          0 if successful, or MBEDTLS_ERR_X509_ALLOC_FAILED\0A */\0Aint mbedtls_x509write_csr_set_ns_cert_type(mbedtls_x509write_csr *ctx,\0A                                           unsigned char ns_cert_type);\0A\0A/**\0A * \5Cbrief           Generic function to add to or replace an extension in the\0A *                  CSR\0A *\0A * \5Cparam ctx       CSR context to use\0A * \5Cparam oid       OID of the extension\0A * \5Cparam oid_len   length of the OID\0A * \5Cparam critical  Set to 1 to mark the extension as critical, 0 otherwise.\0A * \5Cparam val       value of the extension OCTET STRING\0A * \5Cparam val_len   length of the value data\0A *\0A * \5Creturn          0 if successful, or a MBEDTLS_ERR_X509_ALLOC_FAILED\0A */\0Aint mbedtls_x509write_csr_set_extension(mbedtls_x509write_csr *ctx,\0A                                        const char *oid, size_t oid_len,\0A                                        int critical,\0A                                        const unsigned char *val, size_t val_len);\0A\0A/**\0A * \5Cbrief           Free the contents of a CSR context\0A *\0A * \5Cparam ctx       CSR context to free\0A */\0Avoid mbedtls_x509write_csr_free(mbedtls_x509write_csr *ctx);\0A\0A/**\0A * \5Cbrief           Write a CSR (Certificate Signing Request) to a\0A *                  DER structure\0A *                  Note: data is written at the end of the buffer! Use the\0A *                        return value to determine where you should start\0A *                        using the buffer\0A *\0A * \5Cparam ctx       CSR to write away\0A * \5Cparam buf       buffer to write to\0A * \5Cparam size      size of the buffer\0A * \5Cparam f_rng     RNG function. This must not be \5Cc NULL.\0A * \5Cparam p_rng     RNG parameter\0A *\0A * \5Creturn          length of data written if successful, or a specific\0A *                  error code\0A *\0A * \5Cnote            \5Cp f_rng is used for the signature operation.\0A */\0Aint mbedtls_x509write_csr_der(mbedtls_x509write_csr *ctx, unsigned char *buf, size_t size,\0A                              int (*f_rng)(void *, unsigned char *, size_t),\0A                              void *p_rng);\0A\0A#if defined(MBEDTLS_PEM_WRITE_C)\0A/**\0A * \5Cbrief           Write a CSR (Certificate Signing Request) to a\0A *                  PEM string\0A *\0A * \5Cparam ctx       CSR to write away\0A * \5Cparam buf       buffer to write to\0A * \5Cparam size      size of the buffer\0A * \5Cparam f_rng     RNG function. This must not be \5Cc NULL.\0A * \5Cparam p_rng     RNG parameter\0A *\0A * \5Creturn          0 if successful, or a specific error code\0A *\0A * \5Cnote            \5Cp f_rng is used for the signature operation.\0A */\0Aint mbedtls_x509write_csr_pem(mbedtls_x509write_csr *ctx, unsigned char *buf, size_t size,\0A                              int (*f_rng)(void *, unsigned char *, size_t),\0A                              void *p_rng);\0A#endif /* MBEDTLS_PEM_WRITE_C */\0A#endif /* MBEDTLS_X509_CSR_WRITE_C */\0A\0A/** \5C} addtogroup x509_module */\0A\0A#ifdef __cplusplus\0A}\0A#endif\0A\0A#endif /* mbedtls_x509_csr.h */\0A\00" }
