, 1)) != 0) {\0A            goto exit;\0A        }\0A        if (rounds == 2) {\0A            if ((ret = mbedtls_md_hmac_update(&ctx->md_ctx,\0A                                              additional, add_len)) != 0) {\0A                goto exit;\0A            }\0A        }\0A        if ((ret = mbedtls_md_hmac_finish(&ctx->md_ctx, K)) != 0) {\0A            goto exit;\0A        }\0A\0A        /* Step 2 or 5 */\0A        if ((ret = mbedtls_md_hmac_starts(&ctx->md_ctx, K, md_len)) != 0) {\0A            goto exit;\0A        }\0A        if ((ret = mbedtls_md_hmac_update(&ctx->md_ctx,\0A                                          ctx->V, md_len)) != 0) {\0A            goto exit;\0A        }\0A        if ((ret = mbedtls_md_hmac_finish(&ctx->md_ctx, ctx->V)) != 0) {\0A            goto exit;\0A        }\0A    }\0A\0Aexit:\0A    mbedtls_platform_zeroize(K, sizeof(K));\0A    return ret;\0A}\0A\0A/*\0A * Simplified HMAC_DRBG initialisation (for use with deterministic ECDSA)\0A */\0Aint mbedtls_hmac_drbg_seed_buf(mbedtls_hmac_drbg_context *ctx,\0A                               const mbedtls_md_info_t *md_info,\0A                               const unsigned char *data, size_t data_len)\0A{\0A    int ret = MBEDTLS_ERR_ERROR_CORRUPTION_DETECTED;\0A\0A    if ((ret = mbedtls_md_setup(&ctx->md_ctx, md_info, 1)) != 0) {\0A        return ret;\0A    }\0A\0A#if defined(MBEDTLS_THREADING_C)\0A    mbedtls_mutex_init(&ctx->mutex);\0A#endif\0A\0A    /*\0A     * Set initial working state.\0A     * Use the V memory location, which is currently all 0, to initialize the\0A     * MD context with an all-zero key. Then set V to its initial value.\0A     */\0A    if ((ret = mbedtls_md_hmac_starts(&ctx->md_ctx, ctx->V,\0A                                      mbedtls_md_get_size(md_info))) != 0) {\0A        return ret;\0A    }\0A    memset(ctx->V, 0x01, mbedtls_md_get_size(md_info));\0A\0A    if ((ret = mbedtls_hmac_drbg_update(ctx, data, data_len)) != 0) {\0A        return ret;\0A    }\0A\0A    return 0;\0A}\0A\0A/*\0A * Internal function used both for seeding and reseeding the DRBG.\0A * Comments starting with arabic numbers refer to section 10.1.2.4\0A * of SP800-90A, while roman numbers refer to section 9.2.\0A */\0Astatic int hmac_drbg_reseed_core(mbedtls_hmac_drbg_context *ctx,\0A                                 const unsigned char *additional, size_t len,\0A                                 int use_nonce)\0A{\0A    unsigned char seed[MBEDTLS_HMAC_DRBG_MAX_SEED_INPUT];\0A    size_t seedlen = 0;\0A    int ret = MBEDTLS_ERR_ERROR_CORRUPTION_DETECTED;\0A\0A    {\0A        size_t total_entropy_len;\0A\0A        if (use_nonce == 0) {\0A            total_entropy_len = ctx->entropy_len;\0A        } else {\0A            total_entropy_len = ctx->entropy_len * 3 / 2;\0A        }\0A\0A        /* III. Check input length */\0A        if (len > MBEDTLS_HMAC_DRBG_MAX_INPUT ||\0A            total_entropy_len + len > MBEDTLS_HMAC_DRBG_MAX_SEED_INPUT) {\0A            return MBEDTLS_ERR_HMAC_DRBG_INPUT_TOO_BIG;\0A        }\0A    }\0A\0A    memset(seed, 0, MBEDTLS_HMAC_DRBG_MAX_SEED_INPUT);\0A\0A    /* IV. Gather entropy_len bytes of entropy for the seed */\0A    if ((ret = ctx->f_entropy(ctx->p_entropy,\0A                              seed, ctx->entropy_len)) != 0) {\0A        return MBEDTLS_ERR_HMAC_DRBG_ENTROPY_SOURCE_FAILED;\0A    }\0A    seedlen += ctx->entropy_len;\0A\0A    /* For initial seeding, allow adding of nonce generated\0A     * from the entropy source. See Sect 8.6.7 in SP800-90A. */\0A    if (use_nonce) {\0A        /* Note: We don't merge the two calls to f_entropy() in order\0A         *       to avoid requesting too much entropy from f_entropy()\0A         *       at once. Specifically, if the underlying digest is not\0A         *       SHA-1, 3 / 2 * entropy_len is at least 36 Bytes, which\0A         *       is larger than the maximum of 32 Bytes that our own\0A         *       entropy source implementation can emit in a single\0A         *       call in configurations disabling SHA-512. */\0A        if ((ret = ctx->f_entropy(ctx->p_entropy,\0A                                  seed + seedlen,\0A                                  ctx->entropy_len / 2)) != 0) {\0A            return MBEDTLS_ERR_HMAC_DRBG_ENTROPY_SOURCE_FAILED;\0A        }\0A\0A        seedlen += ctx->entropy_len / 2;\0A    }\0A\0A\0A    /* 1. Concatenate entropy and additional data if any */\0A    if (additional != NULL && len != 0) {\0A        memcpy(seed + seedlen, additional, len);\0A        seedlen += len;\0A    }\0A\0A    /* 2. Update state */\0A    if ((ret = mbedtls_hmac_drbg_update(ctx, seed, seedlen)) != 0) {\0A        goto exit;\0A    }\0A\0A    /* 3. Reset reseed_counter */\0A    ctx->reseed_counter = 1;\0A\0Aexit:\0A    /* 4. Done */\0A    mbedtls_platform_zeroize(seed, seedlen);\0A    return ret;\0A}\0A\0A/*\0A * HMAC_DRBG reseeding: 10.1.2.4 + 9.2\0A */\0Aint mbedtls_hmac_drbg_reseed(mbedtls_hmac_drbg_context *ctx,\0A                             const unsigned char *additional, size_t len)\0A{\0A    return hmac_drbg_reseed_core(ctx, additional, len, 0);\0A}\0A\0A/*\0A * HMAC_DRBG initialisation (10.1.2.3 + 9.1)\0A *\0A * The nonce is not passed as a separate parameter but extracted\0A * from the entropy source as suggested in 8.6.7.\0A */\0Aint mbedtls_hmac_drbg_seed(mbedtls_hmac_drbg_context *ctx,\0A                           const mbedtls_md_info_t *md_info,\0A                           int (*f_entropy)(void *, unsigned char *, size_t),\0A                           void *p_entropy,\0A                           const unsigned char *custom,\0A                           size_t len)\0A{\0A    int ret = MBEDTLS_ERR_ERROR_CORRUPTION_DETECTED;\0A    size_t md_size;\0A\0A    if ((ret = mbedtls_md_setup(&ctx->md_ctx, md_info, 1)) != 0) {\0A        return ret;\0A    }\0A\0A    /* The mutex is initialized iff the md context is set up. */\0A#if defined(MBEDTLS_THREADING_C)\0A    mbedtls_mutex_init(&ctx->mutex);\0A#endif\0A\0A    md_size = mbedtls_md_get_size(md_info);\0A\0A    /*\0A     * Set initial working state.\0A     * Use the V memory location, which is currently all 0, to initialize the\0A     * MD context with an all-zero key. Then set V to its initial value.\0A     */\0A    if ((ret = mbedtls_md_hmac_starts(&ctx->md_ctx, ctx->V, md_size)) != 0) {\0A        return ret;\0A    }\0A    memset(ctx->V, 0x01, md_size);\0A\0A    ctx->f_entropy = f_entropy;\0A    ctx->p_entropy = p_entropy;\0A\0A    if (ctx->entropy_len == 0) {\0A        /*\0A         * See SP800-57 5.6.1 (p. 65-66) for the security strength provided by\0A         * each hash function, then according to SP800-90A rev1 10.1 table 2,\0A         * min_entropy_len (in bits) is security_strength.\0A         *\0A         * (This also matches the sizes used in the NIST test vectors.)\0A         */\0A        ctx->entropy_len = md_size <= 20 ? 16 : /* 160-bits hash -> 128 bits */\0A                           md_size <= 28 ? 24 : /* 224-bits hash -> 192 bits */\0A                           32;  /* better (256+) -> 256 bits */\0A    }\0A\0A    if ((ret = hmac_drbg_reseed_core(ctx, custom, len,\0A                                     1 /* add nonce */)) != 0) {\0A        return ret;\0A    }\0A\0A    return 0;\0A}\0A\0A/*\0A * Set prediction resistance\0A */\0Avoid mbedtls_hmac_drbg_set_prediction_resistance(mbedtls_hmac_drbg_context *ctx,\0A                                                 int resistance)\0A{\0A    ctx->prediction_resistance = resistance;\0A}\0A\0A/*\0A * Set entropy length grabbed for seeding\0A */\0Avoid mbedtls_hmac_drbg_set_entropy_len(mbedtls_hmac_drbg_context *ctx, size_t len)\0A{\0A    ctx->entropy_len = len;\0A}\0A\0A/*\0A * Set reseed interval\0A */\0Avoid mbedtls_hmac_drbg_set_reseed_interval(mbedtls_hmac_drbg_context *ctx, int interval)\0A{\0A    ctx->reseed_interval = interval;\0A}\0A\0A/*\0A * HMAC_DRBG random function with optional additional data:\0A * 10.1.2.5 (arabic) + 9.3 (Roman)\0A */\0Aint mbedtls_hmac_drbg_random_with_add(void *p_rng,\0A                                      unsigned char *output, size_t out_len,\0A                                      const unsigned char *additional, size_t add_len)\0A{\0A    int ret = MBEDTLS_ERR_ERROR_CORRUPTION_DETECTED;\0A    mbedtls_hmac_drbg_context *ctx = (mbedtls_hmac_drbg_context *) p_rng;\0A    size_t md_len = mbedtls_md_get_size(ctx->md_ctx.md_info);\0A    size_t left = out_len;\0A    unsigned char *out = output;\0A\0A    /* II. Check request length */\0A    if (out_len > MBEDTLS_HMAC_DRBG_MAX_REQUEST) {\0A        return MBEDTLS_ERR_HMAC_DRBG_REQUEST_TOO_BIG;\0A    }\0A\0A    /* III. Check input length */\0A    if (add_len > MBEDTLS_HMAC_DRBG_MAX_INPUT) {\0A        return MBEDTLS_ERR_HMAC_DRBG_INPUT_TOO_BIG;\0A    }\0A\0A    /* 1. (aka VII and IX) Check reseed counter and PR */\0A    if (ctx->f_entropy != NULL && /* For no-reseeding instances */\0A        (ctx->prediction_resistance == MBEDTLS_HMAC_DRBG_PR_ON ||\0A         ctx->reseed_counter > ctx->reseed_interval)) {\0A        if ((ret = mbedtls_hmac_drbg_reseed(ctx, additional, add_len)) != 0) {\0A            return ret;\0A        }\0A\0A        add_len = 0; /* VII.4 */\0A    }\0A\0A    /* 2. Use additional data if any */\0A    if (additional != NULL && add_len != 0) {\0A        if ((ret = mbedtls_hmac_drbg_update(ctx,\0A                                            additional, add_len)) != 0) {\0A            goto exit;\0A        }\0A    }\0A\0A    /* 3, 4, 5. Generate bytes */\0A    while (left != 0) {\0A        size_t use_len = left > md_len ? md_len : left;\0A\0A        if ((ret = mbedtls_md_hmac_reset(&ctx->md_ctx)) != 0) {\0A            goto exit;\0A        }\0A        if ((ret = mbedtls_md_hmac_update(&ctx->md_ctx,\0A                                          ctx->V, md_len)) != 0) {\0A            goto exit;\0A        }\0A        if ((ret = mbedtls_md_hmac_finish(&ctx->md_ctx, ctx->V)) != 0) {\0A            goto exit;\0A        }\0A\0A        memcpy(out, ctx->V, use_len);\0A        out += use_len;\0A        left -= use_len;\0A    }\0A\0A    /* 6. Update */\0A    if ((ret = mbedtls_hmac_drbg_update(ctx,\0A                                        additional, add_len)) != 0) {\0A        goto exit;\0A    }\0A\0A    /* 7. Update reseed counter */\0A    ctx->reseed_counter++;\0A\0Aexit:\0A    /* 8. Done */\0A    return ret;\0A}\0A\0A/*\0A * HMAC_DRBG random function\0A */\0Aint mbedtls_hmac_drbg_random(void *p_rng, unsigned char *output, size_t out_len)\0A{\0A    int ret = MBEDTLS_ERR_ERROR_CORRUPTION_DETECTED;\0A    mbedtls_hmac_drbg_context *ctx = (mbedtls_hmac_drbg_context *) p_rng;\0A\0A#if defined(MBEDTLS_THREADING_C)\0A    if ((ret = mbedtls_mutex_lock(&ctx->mutex)) != 0) {\0A        return ret;\0A    }\0A#endif\0A\0A    ret = mbedtls_hmac_drbg_random_with_add(ctx, output, out_len, NULL, 0);\0A\0A#if defined(MBEDTLS_THREADING_C)\0A    if (mbedtls_mutex_unlock(&ctx->mutex) != 0) {\0A        return MBEDTLS_ERR_THREADING_MUTEX_ERROR;\0A    }\0A#endif\0A\0A    return ret;\0A}\0A\0A/*\0A *  This function resets HMAC_DRBG context to the state immediately\0A *  after initial call of mbedtls_hmac_drbg_init().\0A */\0Avoid mbedtls_hmac_drbg_free(mbedtls_hmac_drbg_context *ctx)\0A{\0A    if (ctx == NULL) {\0A        return;\0A    }\0A\0A#if defined(MBEDTLS_THREADING_C)\0A    /* The mutex is initialized iff the md context is set up. */\0A    if (ctx->md_ctx.md_info != NULL) {\0A        mbedtls_mutex_free(&ctx->mutex);\0A    }\0A#endif\0A    mbedtls_md_free(&ctx->md_ctx);\0A    mbedtls_platform_zeroize(ctx, sizeof(mbedtls_hmac_drbg_context));\0A    ctx->reseed_interval = MBEDTLS_HMAC_DRBG_RESEED_INTERVAL;\0A}\0A\0A#if defined(MBEDTLS_FS_IO)\0Aint mbedtls_hmac_drbg_write_seed_file(mbedtls_hmac_drbg_context *ctx, const char *path)\0A{\0A    int ret = MBEDTLS_ERR_ERROR_CORRUPTION_DETECTED;\0A    FILE *f;\0A    unsigned char buf[MBEDTLS_HMAC_DRBG_MAX_INPUT];\0A\0A    if ((f = fopen(path, \22wb\22)) == NULL) {\0A        return MBEDTLS_ERR_HMAC_DRBG_FILE_IO_ERROR;\0A    }\0A\0A    /* Ensure no stdio buffering of secrets, as such buffers cannot be wiped. */\0A    mbedtls_setbuf(f, NULL);\0A\0A    if ((ret = mbedtls_hmac_drbg_random(ctx, buf, sizeof(buf))) != 0) {\0A        goto exit;\0A    }\0A\0A    if (fwrite(buf, 1, sizeof(buf), f) != sizeof(buf)) {\0A        ret = MBEDTLS_ERR_HMAC_DRBG_FILE_IO_ERROR;\0A        goto exit;\0A    }\0A\0A    ret = 0;\0A\0Aexit:\0A    fclose(f);\0A    mbedtls_platform_zeroize(buf, sizeof(buf));\0A\0A    return ret;\0A}\0A\0Aint mbedtls_hmac_drbg_update_seed_file(mbedtls_hmac_drbg_context *ctx, const char *path)\0A{\0A    int ret = 0;\0A    FILE *f = NULL;\0A    size_t n;\0A    unsigned char buf[MBEDTLS_HMAC_DRBG_MAX_INPUT];\0A    unsigned char c;\0A\0A    if ((f = fopen(path, \22rb\22)) == NULL) {\0A        return MBEDTLS_ERR_HMAC_DRBG_FILE_IO_ERROR;\0A    }\0A\0A    /* Ensure no stdio buffering of secrets, as such buffers cannot be wiped. */\0A    mbedtls_setbuf(f, NULL);\0A\0A    n = fread(buf, 1, sizeof(buf), f);\0A    if (fread(&c, 1, 1, f) != 0) {\0A        ret = MBEDTLS_ERR_HMAC_DRBG_INPUT_TOO_BIG;\0A        goto exit;\0A    }\0A    if (n == 0 || ferror(f)) {\0A        ret = MBEDTLS_ERR_HMAC_DRBG_FILE_IO_ERROR;\0A        goto exit;\0A    }\0A    fclose(f);\0A    f = NULL;\0A\0A    ret = mbedtls_hmac_drbg_update(ctx, buf, n);\0A\0Aexit:\0A    mbedtls_platform_zeroize(buf, sizeof(buf));\0A    if (f != NULL) {\0A        fclose(f);\0A    }\0A    if (ret != 0) {\0A        return ret;\0A    }\0A    return mbedtls_hmac_drbg_write_seed_file(ctx, path);\0A}\0A#endif /* MBEDTLS_FS_IO */\0A\0A\0A#if defined(MBEDTLS_SELF_TEST)\0A\0A#if !defined(MBEDTLS_MD_CAN_SHA1)\0A/* Dummy checkup routine */\0Aint mbedtls_hmac_drbg_self_test(int verbose)\0A{\0A    (void) verbose;\0A    return 0;\0A}\0A#else\0A\0A#define OUTPUT_LEN  80\0A\0A/* From a NIST PR=true test vector */\0Astatic const unsigned char entropy_pr[] = {\0A    0xa0, 0xc9, 0xab, 0x58, 0xf1, 0xe2, 0xe5, 0xa4, 0xde, 0x3e, 0xbd, 0x4f,\0A    0xf7,