@.str44829 = private global { i64, i64, [1226 x i8] } { i64 -1, i64 1225, [1226 x i8] c"/**\0A *  Constant-time functions\0A */\0A/*\0A *  Copyright The Mbed TLS Contributors\0A *  SPDX-License-Identifier: Apache-2.0 OR GPL-2.0-or-later\0A */\0A\0A#ifndef MBEDTLS_CONSTANT_TIME_H\0A#define MBEDTLS_CONSTANT_TIME_H\0A\0A#include <stddef.h>\0A\0A/** Constant-time buffer comparison without branches.\0A *\0A * This is equivalent to the standard memcmp function, but is likely to be\0A * compiled to code using bitwise operations rather than a branch, such that\0A * the time taken is constant w.r.t. the data pointed to by \5Cp a and \5Cp b,\0A * and w.r.t. whether \5Cp a and \5Cp b are equal or not. It is not constant-time\0A * w.r.t. \5Cp n .\0A *\0A * This function can be used to write constant-time code by replacing branches\0A * with bit operations using masks.\0A *\0A * \5Cparam a     Pointer to the first buffer, containing at least \5Cp n bytes. May not be NULL.\0A * \5Cparam b     Pointer to the second buffer, containing at least \5Cp n bytes. May not be NULL.\0A * \5Cparam n     The number of bytes to compare.\0A *\0A * \5Creturn      Zero if the contents of the two buffers are the same,\0A *              otherwise non-zero.\0A */\0Aint mbedtls_ct_memcmp(const void *a,\0A                      const void *b,\0A                      size_t n);\0A\0A#endif /* MBEDTLS_CONSTANT_TIME_H */\0A\00" }
