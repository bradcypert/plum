@.str41447 = private global { i64, i64, [22730 x i8] } { i64 -1, i64 22729, [22730 x i8] c"/*\0A *  Copyright The Mbed TLS Contributors\0A *  SPDX-License-Identifier: Apache-2.0 OR GPL-2.0-or-later\0A */\0A#include \22common.h\22\0A\0A#include \22mbedtls/build_info.h\22\0A#if defined(MBEDTLS_PKCS7_C)\0A#include \22mbedtls/pkcs7.h\22\0A#include \22x509_internal.h\22\0A#include \22mbedtls/asn1.h\22\0A#include \22mbedtls/x509_crt.h\22\0A#include \22mbedtls/x509_crl.h\22\0A#include \22mbedtls/oid.h\22\0A#include \22mbedtls/error.h\22\0A\0A#if defined(MBEDTLS_FS_IO)\0A#include <sys/types.h>\0A#include <sys/stat.h>\0A#endif\0A\0A#include \22mbedtls/platform.h\22\0A#include \22mbedtls/platform_util.h\22\0A\0A#if defined(MBEDTLS_HAVE_TIME)\0A#include \22mbedtls/platform_time.h\22\0A#endif\0A#if defined(MBEDTLS_HAVE_TIME_DATE)\0A#include <time.h>\0A#endif\0A\0A/**\0A * Initializes the mbedtls_pkcs7 structure.\0A */\0Avoid mbedtls_pkcs7_init(mbedtls_pkcs7 *pkcs7)\0A{\0A    memset(pkcs7, 0, sizeof(*pkcs7));\0A}\0A\0Astatic int pkcs7_get_next_content_len(unsigned char **p, unsigned char *end,\0A                                      size_t *len)\0A{\0A    int ret = MBEDTLS_ERR_ERROR_CORRUPTION_DETECTED;\0A\0A    ret = mbedtls_asn1_get_tag(p, end, len, MBEDTLS_ASN1_CONSTRUCTED\0A                               | MBEDTLS_ASN1_CONTEXT_SPECIFIC);\0A    if (ret != 0) {\0A        ret = MBEDTLS_ERROR_ADD(MBEDTLS_ERR_PKCS7_INVALID_CONTENT_INFO, ret);\0A    } else if ((size_t) (end - *p) != *len) {\0A        ret = MBEDTLS_ERROR_ADD(MBEDTLS_ERR_PKCS7_INVALID_CONTENT_INFO,\0A                                MBEDTLS_ERR_ASN1_LENGTH_MISMATCH);\0A    }\0A\0A    return ret;\0A}\0A\0A/**\0A * version Version\0A * Version ::= INTEGER\0A **/\0Astatic int pkcs7_get_version(unsigned char **p, unsigned char *end, int *ver)\0A{\0A    int ret = MBEDTLS_ERR_ERROR_CORRUPTION_DETECTED;\0A\0A    ret = mbedtls_asn1_get_int(p, end, ver);\0A    if (ret != 0) {\0A        ret = MBEDTLS_ERROR_ADD(MBEDTLS_ERR_PKCS