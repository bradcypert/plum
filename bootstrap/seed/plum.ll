@.str45732 = private global { i64, i64, [4314 x i8] } { i64 -1, i64 4313, [4314 x i8] c"/*\0A *  VIA PadLock support functions\0A *\0A *  Copyright The Mbed TLS Contributors\0A *  SPDX-License-Identifier: Apache-2.0 OR GPL-2.0-or-later\0A */\0A/*\0A *  This implementation is based on the VIA PadLock Programming Guide:\0A *\0A *  http://www.via.com.tw/en/downloads/whitepapers/initiatives/padlock/\0A *  programming_guide.pdf\0A */\0A\0A#include \22common.h\22\0A\0A#if defined(MBEDTLS_PADLOCK_C)\0A\0A#include \22padlock.h\22\0A\0A#include <string.h>\0A\0A#if defined(MBEDTLS_VIA_PADLOCK_HAVE_CODE)\0A\0A/*\0A * PadLock detection routine\0A */\0Aint mbedtls_padlock_has_support(int feature)\0A{\0A    static int flags = -1;\0A    int ebx = 0, edx = 0;\0A\0A    if (flags == -1) {\0A        asm (\22movl  %%ebx, %0           \5Cn\5Ct\22\0A             \22movl  $0xC0000000, %%eax  \5Cn\5Ct\22\0A             \22cpuid                     \5Cn\5Ct\22\0A             \22cmpl  $0xC0000001, %%eax  \5Cn\5Ct\22\0A             \22movl  $0, %%edx           \5Cn\5Ct\22\0A             \22jb    1f                  \5Cn\5Ct\22\0A             \22movl  $0xC0000001, %%eax  \5Cn\5Ct\22\0A             \22cpuid                     \5Cn\5Ct\22\0A             \221:                        \5Cn\5Ct\22\0A             \22movl  %%edx, %1           \5Cn\5Ct\22\0A             \22movl  %2, %%ebx           \5Cn\5Ct\22\0A             : \22=m\22 (ebx), \22=m\22 (edx)\0A             :  \22m\22 (ebx)\0A             : \22eax\22, \22ecx\22, \22edx\22);\0A\0A        flags = edx;\0A    }\0A\0A    return flags & feature;\0A}\0A\0A/*\0A * PadLock AES-ECB block en(de)cryption\0A */\0Aint mbedtls_padlock_xcryptecb(mbedtls_aes_context *ctx,\0A                              int mode,\0A                              const unsigned char input[16],\0A                              unsigned char output[16])\0A{\0A    int ebx = 0;\0A    uint32_t *rk;\0A    uint32_t *blk;\0A    uint32_t *ctrl;\0A    unsigned char buf[256];\0A\0A    rk = ctx->buf + ctx->rk_offset;\0A\0A    if (((long) rk & 15) != 0) {\0A        return MBEDTLS_ERR_PADLOCK_DATA_MISALIGNED;\0A    }\0A\0A    blk = MBEDTLS_PADLOCK_ALIGN16(buf);\0A    memcpy(blk, input, 16);\0A\0A    ctrl = blk + 4;\0A    *ctrl = 0x80 | ctx->nr | ((ctx->nr + (mode^1) - 10) << 9);\0A\0A    asm (\22pushfl                        \5Cn\5Ct\22\0A         \22popfl                         \5Cn\5Ct\22\0A         \22movl    %%ebx, %0             \5Cn\5Ct\22\0A         \22movl    $1, %%ecx             \5Cn\5Ct\22\0A         \22movl    %2, %%edx             \5Cn\5Ct\22\0A         \22movl    %3, %%ebx             \5Cn\5Ct\22\0A         \22movl    %4, %%esi             \5Cn\5Ct\22\0A         \22movl    %4, %%edi             \5Cn\5Ct\22\0A         \22.byte  0xf3,0x0f,0xa7,0xc8    \5Cn\5Ct\22\0A         \22movl    %1, %%ebx             \5Cn\5Ct\22\0A         : \22=m\22 (ebx)\0A         :  \22m\22 (ebx), \22m\22 (ctrl), \22m\22 (rk), \22m\22 (blk)\0A         : \22memory\22, \22ecx\22, \22edx\22, \22esi\22, \22edi\22);\0A\0A    memcpy(output, blk, 16);\0A\0A    return 0;\0A}\0A\0A#if defined(MBEDTLS_CIPHER_MODE_CBC)\0A/*\0A * PadLock AES-CBC buffer en(de)cryption\0A */\0Aint mbedtls_padlock_xcryptcbc(mbedtls_aes_context *ctx,\0A                              int mode,\0A                              size_t length,\0A                              unsigned char iv[16],\0A                              const unsigned char *input,\0A                              unsigned char *output)\0A{\0A    int ebx = 0;\0A    size_t count;\0A    uint32_t *rk;\0A    uint32_t *iw;\0A    uint32_t *ctrl;\0A    unsigned char buf[256];\0A\0A    rk = ctx->buf + ctx->rk_offset;\0A\0A    if (((long) input  & 15) != 0 ||\0A        ((long) output & 15) != 0 ||\0A        ((long) rk & 15) != 0) {\0A        return MBEDTLS_ERR_PADLOCK_DATA_MISALIGNED;\0A    }\0A\0A    iw = MBEDTLS_PADLOCK_ALIGN16(buf);\0A    memcpy(iw, iv, 16);\0A\0A    ctrl = iw + 4;\0A    *ctrl = 0x80 | ctx->nr | ((ctx->nr + (mode ^ 1) - 10) << 9);\0A\0A    count = (length + 15) >> 4;\0A\0A    asm (\22pushfl                        \5Cn\5Ct\22\0A         \22popfl                         \5Cn\5Ct\22\0A         \22movl    %%ebx, %0             \5Cn\5Ct\22\0A         \22movl    %2, %%ecx             \5Cn\5Ct\22\0A         \22movl    %3, %%edx             \5Cn\5Ct\22\0A         \22movl    %4, %%ebx             \5Cn\5Ct\22\0A         \22movl    %5, %%esi             \5Cn\5Ct\22\0A         \22movl    %6, %%edi             \5Cn\5Ct\22\0A         \22movl    %7, %%eax             \5Cn\5Ct\22\0A         \22.byte  0xf3,0x0f,0xa7,0xd0    \5Cn\5Ct\22\0A         \22movl    %1, %%ebx             \5Cn\5Ct\22\0A         : \22=m\22 (ebx)\0A         :  \22m\22 (ebx), \22m\22 (count), \22m\22 (ctrl),\0A         \22m\22  (rk), \22m\22 (input), \22m\22 (output), \22m\22 (iw)\0A         : \22memory\22, \22eax\22, \22ecx\22, \22edx\22, \22esi\22, \22edi\22);\0A\0A    memcpy(iv, iw, 16);\0A\0A    return 0;\0A}\0A#endif /* MBEDTLS_CIPHER_MODE_CBC */\0A\0A#endif /* MBEDTLS_VIA_PADLOCK_HAVE_CODE */\0A\0A#endif /* MBEDTLS_PADLOCK_C */\0A\00" }
