, output_length ) );\0A#endif /* MBEDTLS_PSA_BUILTIN_PAKE */\0A\0A#if defined(PSA_CRYPTO_ACCELERATOR_DRIVER_PRESENT)\0A#if defined(PSA_CRYPTO_DRIVER_TEST)\0A        case MBEDTLS_TEST_TRANSPARENT_DRIVER_ID:\0A            return( mbedtls_test_transparent_pake_output(\0A                        &operation->data.ctx.transparent_test_driver_ctx,\0A                        step, output, output_size, output_length ) );\0A#endif /* PSA_CRYPTO_DRIVER_TEST */\0A#endif /* PSA_CRYPTO_ACCELERATOR_DRIVER_PRESENT */\0A        default:\0A            (void) step;\0A            (void) output;\0A            (void) output_size;\0A            (void) output_length;\0A            return( PSA_ERROR_INVALID_ARGUMENT );\0A    }\0A}\0A\0Astatic inline psa_status_t psa_driver_wrapper_pake_input(\0A    psa_pake_operation_t *operation,\0A    psa_crypto_driver_pake_step_t step,\0A    const uint8_t *input,\0A    size_t input_length )\0A{\0A    switch( operation->id )\0A    {\0A#if defined(MBEDTLS_PSA_BUILTIN_PAKE)\0A        case PSA_CRYPTO_MBED_TLS_DRIVER_ID:\0A            return( mbedtls_psa_pake_input( &operation->data.ctx.mbedtls_ctx,\0A                                            step, input,\0A                                            input_length ) );\0A#endif /* MBEDTLS_PSA_BUILTIN_PAKE */\0A\0A#if defined(PSA_CRYPTO_ACCELERATOR_DRIVER_PRESENT)\0A#if defined(PSA_CRYPTO_DRIVER_TEST)\0A        case MBEDTLS_TEST_TRANSPARENT_DRIVER_ID:\0A            return( mbedtls_test_transparent_pake_input(\0A                        &operation->data.ctx.transparent_test_driver_ctx,\0A                        step,\0A                        input, input_length ) );\0A#endif /* PSA_CRYPTO_DRIVER_TEST */\0A#endif /* PSA_CRYPTO_ACCELERATOR_DRIVER_PRESENT */\0A        default:\0A            (void) step;\0A            (void) input;\0A            (void) input_length;\0A            return( PSA_ERROR_INVALID_ARGUMENT );\0A    }\0A}\0A\0Astatic inline psa_status_t psa_driver_wrapper_pake_get_implicit_key(\0A    psa_pake