s_rsa_context *rsa, const unsigned char *key, size_t keylen);\0A\0A/**\0A * \5Cbrief           Write a PKCS#1 (ASN.1) encoded private RSA key.\0A *\0A * \5Cparam rsa       The RSA context which contains the data to be written.\0A * \5Cparam start     Beginning of the buffer that will be filled with the\0A *                  private key.\0A * \5Cparam p         End of the buffer that will be filled with the private key.\0A *                  On successful return, the referenced pointer will be\0A *                  updated in order to point to the beginning of written data.\0A *\0A * \5Creturn          On success, the number of bytes written to the output buffer\0A *                  (i.e. a value > 0).\0A * \5Creturn          MBEDTLS_ERR_RSA_BAD_INPUT_DATA if the RSA context does not\0A *                  contain a valid key pair.\0A * \5Creturn          MBEDTLS_ERR_ASN1_xxx in case of failure while writing to the\0A *                  output buffer.\0A *\0A * \5Cnote            The output buffer is filled backward, i.e. starting from its\0A *                  end and moving toward its start.\0A */\0Aint mbedtls_rsa_write_key(const mbedtls_rsa_context *rsa, unsigned char *start,\0A                          unsigned char **p);\0A\0A/**\0A * \5Cbrief           Parse a PKCS#1 (ASN.1) encoded public RSA key.\0A *\0A * \5Cparam rsa       The RSA context which contains the data to be written.\0A * \5Cparam start     Beginning of the buffer that will be filled with the\0A *                  private key.\0A * \5Cparam p         End of the buffer that will be filled with the private key.\0A *                  On successful return, the referenced pointer will be\0A *                  updated in order to point to the beginning of written data.\0A *\0A * \5Creturn          On success, the number of bytes written to the output buffer\0A *                  (i.e. a value > 0).\0A * \5Creturn          MBEDTLS_ERR_RSA_BAD_INPUT_DATA if the RSA context does not\0A *                  contain a valid public key.\0A * \5Creturn          MBEDTLS_ERR_ASN1_xxx in case of failure while writing to the\0A *                  output buffer.\0A *\0A * \5Cnote            The output buffer is filled backward, i.e. starting from its\0A *                  end and moving toward its start.\0A */\0Aint mbedtls_rsa_write_pubkey(const mbedtls_rsa_context *rsa, unsigned char *start,\0A                             unsigned char **p);\0A\0A#if defined(MBEDTLS_PKCS1_V21)\0A/**\0A * \5Cbrief This function is analogue to \5Cc mbedtls_rsa_rsassa_pss_sign().\0A *        The only difference between them is that this function is more flexible\0A *        on the parameters of \5Cp ctx that are set with \5Cc mbedtls_rsa_set_padding().\0A *\0A * \5Cnote  Compared to its counterpart, this function:\0A *        - does not check the padding setting of \5Cp ctx.\0A *        - allows the hash_id of \5Cp ctx to be MBEDTLS_MD_NONE,\0A *          in which case it uses \5Cp md_alg as the hash_id.\0A *\0A * \5Cnote  Refer to \5Cc mbedtls_rsa_rsassa_pss_sign() for a description\0A *        of the functioning and parameters of this function.\0A */\0Aint mbedtls_rsa_rsassa_pss_sign_no_mode_check(mbedtls_rsa_context *ctx,\0A                                              int (*f_rng)(void *, unsigned char *, size_t),\0A                                              void *p_rng,\0A                                              mbedtls_md_type_t md_alg,\0A                                              unsigned int hashlen,\0A                                              const unsigned char *hash,\0A                                              unsigned char *sig);\0A#endif /* MBEDTLS_PKCS1_V21 */\0A\0A#endif /* rsa_internal.h */\0A\00" }
