@.str39833 = private global { i64, i64, [1560 x i8] } { i64 -1, i64 1559, [1560 x i8] c"/**\0A * \5Cfile psa/crypto_driver_common.h\0A * \5Cbrief Definitions for all PSA crypto drivers\0A *\0A * This file contains common definitions shared by all PSA crypto drivers.\0A * Do not include it directly: instead, include the header file(s) for\0A * the type(s) of driver that you are implementing. For example, if\0A * you are writing a dynamically registered driver for a secure element,\0A * include `psa/crypto_se_driver.h`.\0A *\0A * This file is part of the PSA Crypto Driver Model, containing functions for\0A * driver developers to implement to enable hardware to be called in a\0A * standardized way by a PSA Cryptographic API implementation. The functions\0A * comprising the driver model, which driver authors implement, are not\0A * intended to be called by application developers.\0A */\0A\0A/*\0A *  Copyright The Mbed TLS Contributors\0A *  SPDX-License-Identifier: Apache-2.0 OR GPL-2.0-or-later\0A */\0A#ifndef PSA_CRYPTO_DRIVER_COMMON_H\0A#define PSA_CRYPTO_DRIVER_COMMON_H\0A\0A#include <stddef.h>\0A#include <stdint.h>\0A\0A/* Include type definitions (psa_status_t, psa_algorithm_t,\0A * psa_key_type_t, etc.) and macros to build and analyze values\0A * of these types. */\0A#include \22crypto_types.h\22\0A#include \22crypto_values.h\22\0A/* Include size definitions which are used to size some arrays in operation\0A * structures. */\0A#include <psa/crypto_sizes.h>\0A\0A/** For encrypt-decrypt functions, whether the operation is an encryption\0A * or a decryption. */\0Atypedef enum {\0A    PSA_CRYPTO_DRIVER_DECRYPT,\0A    PSA_CRYPTO_DRIVER_ENCRYPT\0A} psa_encrypt_or_decrypt_t;\0A\0A#endif /* PSA_CRYPTO_DRIVER_COMMON_H */\0A\00" }
