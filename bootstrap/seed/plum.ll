LS_PSA_STATIC_KEY_SLOTS */\0A\0A    slot->key.bytes = 0;\0A\0A    return PSA_SUCCESS;\0A}\0A\0A/** Completely wipe a slot in memory, including its policy.\0A * Persistent storage is not affected. */\0Apsa_status_t psa_wipe_key_slot(psa_key_slot_t *slot)\0A{\0A    psa_status_t status = psa_remove_key_data_from_memory(slot);\0A\0A    /*\0A     * As the return error code may not be handled in case of multiple errors,\0A     * do our best to report an unexpected amount of registered readers or\0A     * an unexpected state.\0A     * Assert with MBEDTLS_TEST_HOOK_TEST_ASSERT that the slot is valid for\0A     * wiping.\0A     * if the MBEDTLS_TEST_HOOKS configuration option is enabled and the\0A     * function is called as part of the execution of a test suite, the\0A     * execution of the test suite is stopped in error if the assertion fails.\0A     */\0A    switch (slot->state) {\0A        case PSA_SLOT_FULL:\0A        /* In this state psa_wipe_key_slot() must only be called if the\0A         * caller is the last reader. */\0A        case PSA_SLOT_PENDING_DELETION:\0A            /* In this state psa_wipe_key_slot() must only be called if the\0A             * caller is the last reader. */\0A            if (slot->var.occupied.registered_readers != 1) {\0A                MBEDTLS_TEST_HOOK_TEST_ASSERT(slot->var.occupied.registered_readers == 1);\0A                status = PSA_ERROR_CORRUPTION_DETECTED;\0A            }\0A            break;\0A        case PSA_SLOT_FILLING:\0A            /* In this state registered_readers must be 0. */\0A            if (slot->var.occupied.registered_readers != 0) {\0A                MBEDTLS_TEST_HOOK_TEST_ASSERT(slot->var.occupied.registered_readers == 0);\0A                status = PSA_ERROR_CORRUPTION_DETECTED;\0A            }\0A            break;\0A        case PSA_SLOT_EMPTY:\0A            /* The slot is already empty, it cannot be wiped. */\0A            MBEDTLS_TEST_HOOK_TEST_ASSERT(slot->state != PSA_SLOT_EMPTY);\0A            status = PSA_ERROR_CORRUPTION_DETECTED;\0A            break;\0A        default:\0A            /* The slot's state is invalid. */\0A            status = PSA_ERROR_CORRUPTION_DETECTED;\0A    }\0A\0A#if defined(MBEDTLS_PSA_KEY_STORE_DYNAMIC)\0A    size_t slice_index = slot->slice_index;\0A#endif /* MBEDTLS_PSA_KEY_STORE_DYNAMIC */\0A\0A\0A    /* Multipart operations may still be using the key. This is safe\0A     * because all multipart operation objects are independent from\0A     * the key slot: if they need to access the key after the setup\0A     * phase, they have a copy of the key. Note that this means that\0A     * key material can linger until all operations are completed. */\0A    /* At this point, key material and other type-specific content has\0A     * been wiped. Clear remaining metadata. We can call memset and not\0A     * zeroize because the metadata is not particularly sensitive.\0A     * This memset also sets the slot's state to PSA_SLOT_EMPTY. */\0A    memset(slot, 0, sizeof(*slot));\0A\0A#if defined(MBEDTLS_PSA_KEY_STORE_DYNAMIC)\0A    /* If the slot is already corrupted, something went deeply wrong,\0A     * like a thread still using the slot or a stray pointer leading\0A     * to the slot's memory being used for another object. Let the slot\0A     * leak rather than make the corruption worse. */\0A    if (status == PSA_SUCCESS) {\0A        status = psa_free_key_slot(slice_index, slot);\0A    }\0A#endif /* MBEDTLS_PSA_KEY_STORE_DYNAMIC */\0A\0A    return status;\0A}\0A\0Apsa_status_t psa_destroy_key(mbedtls_svc_key_id_t key)\0A{\0A    psa_key_slot_t *slot;\0A    psa_status_t status; /* status of the last operation */\0A    psa_status_t overall_status = PSA_SUCCESS;\0A#if defined(MBEDTLS_PSA_CRYPTO_SE_C)\0A    psa_se_drv_table_entry_t *driver;\0A#endif /* MBEDTLS_PSA_CRYPTO_SE_C */\0A\0A    if (mbedtls_svc_key_id_is_null(key)) {\0A        return PSA_SUCCESS;\0A    }\0A\0A    /*\0A     * Get the description of the key in a key slot, and register to read it.\0