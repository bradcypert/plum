0A            if (ret != 0) {\0A                MBEDTLS_SSL_DEBUG_RET(1, \22Random bytes generation failed\22, ret);\0A                return ret;\0A            }\0A        }\0A    }\0A\0A    /*\0A     * Prepare session identifier. At that point, the length of the session\0A     * identifier in the SSL context `ssl->session_negotiate->id_len` is equal\0A     * to zero, except in the case of a TLS 1.2 session renegotiation or\0A     * session resumption.\0A     */\0A    session_id_len = session_negotiate->id_len;\0A\0A#if defined(MBEDTLS_SSL_PROTO_TLS1_2)\0A    if (ssl->tls_version == MBEDTLS_SSL_VERSION_TLS1_2) {\0A        if (session_id_len < 16 || session_id_len > 32 ||\0A#if defined(MBEDTLS_SSL_RENEGOTIATION)\0A            ssl->renego_status != MBEDTLS_SSL_INITIAL_HANDSHAKE ||\0A#endif\0A            ssl->handshake->resume == 0) {\0A            session_id_len = 0;\0A        }\0A\0A#if defined(MBEDTLS_SSL_SESSION_TICKETS)\0A        /*\0A         * RFC 5077 section 3.4: \22When presenting a ticket, the client MAY\0A         * generate and include a Session ID in the TLS ClientHello.\22\0A         */\0A        int renegotiating = 0;\0A#if defined(MBEDTLS_SSL_RENEGOTIATION)\0A        if (ssl->renego_status != MBEDTLS_SSL_INITIAL_HANDSHAKE) {\0A            renegotiating = 1;\0A        }\0A#endif\0A        if (!renegotiating) {\0A            if ((session_negotiate->ticket != NULL) &&\0A                (session_negotiate->ticket_len != 0)) {\0A                session_id_len = 32;\0A            }\0A        }\0A#endif /* MBEDTLS_SSL_SESSION_TICKETS */\0A    }\0A#endif /* MBEDTLS_SSL_PROTO_TLS1_2 */\0A\0A#if defined(MBEDTLS_SSL_TLS1_3_COMPATIBILITY_MODE)\0A    if (ssl->tls_version == MBEDTLS_SSL_VERSION_TLS1_3) {\0A        /*\0A         * Create a legacy session identifier for the purpose of middlebox\0A         * compatibility only if one has not been created already, which is\0A         * the case if we are here for the TLS 1.3 second ClientHello.\0A         *\0A         