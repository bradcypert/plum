_DEBUG_MSG(2, (\22<= free\22));\0A\0A    /* Actually clear after last debug message */\0A    mbedtls_platform_zeroize(ssl, sizeof(mbedtls_ssl_context));\0A}\0A\0A/*\0A * Initialize mbedtls_ssl_config\0A */\0Avoid mbedtls_ssl_config_init(mbedtls_ssl_config *conf)\0A{\0A    memset(conf, 0, sizeof(mbedtls_ssl_config));\0A}\0A\0A/* The selection should be the same as mbedtls_x509_crt_profile_default in\0A * x509_crt.c, plus Montgomery curves for ECDHE. Here, the order matters:\0A * curves with a lower resource usage come first.\0A * See the documentation of mbedtls_ssl_conf_curves() for what we promise\0A * about this list.\0A */\0Astatic const uint16_t ssl_preset_default_groups[] = {\0A#if defined(MBEDTLS_ECP_HAVE_CURVE25519)\0A    MBEDTLS_SSL_IANA_TLS_GROUP_X25519,\0A#endif\0A#if defined(MBEDTLS_ECP_HAVE_SECP256R1)\0A    MBEDTLS_SSL_IANA_TLS_GROUP_SECP256R1,\0A#endif\0A#if defined(MBEDTLS_ECP_HAVE_SECP384R1)\0A    MBEDTLS_SSL_IANA_TLS_GROUP_SECP384R1,\0A#endif\0A#if defined(MBEDTLS_ECP_HAVE_CURVE448)\0A    MBEDTLS_SSL_IANA_TLS_GROUP_X448,\0A#endif\0A#if defined(MBEDTLS_ECP_HAVE_SECP521R1)\0A    MBEDTLS_SSL_IANA_TLS_GROUP_SECP521R1,\0A#endif\0A#if defined(MBEDTLS_ECP_HAVE_BP256R1)\0A    MBEDTLS_SSL_IANA_TLS_GROUP_BP256R1,\0A#endif\0A#if defined(MBEDTLS_ECP_HAVE_BP384R1)\0A    MBEDTLS_SSL_IANA_TLS_GROUP_BP384R1,\0A#endif\0A#if defined(MBEDTLS_ECP_HAVE_BP512R1)\0A    MBEDTLS_SSL_IANA_TLS_GROUP_BP512R1,\0A#endif\0A#if defined(PSA_WANT_ALG_FFDH)\0A    MBEDTLS_SSL_IANA_TLS_GROUP_FFDHE2048,\0A    MBEDTLS_SSL_IANA_TLS_GROUP_FFDHE3072,\0A    MBEDTLS_SSL_IANA_TLS_GROUP_FFDHE4096,\0A    MBEDTLS_SSL_IANA_TLS_GROUP_FFDHE6144,\0A    MBEDTLS_SSL_IANA_TLS_GROUP_FFDHE8192,\0A#endif\0A    MBEDTLS_SSL_IANA_TLS_GROUP_NONE\0A};\0A\0Astatic const int ssl_preset_suiteb_ciphersuites[] = {\0A    MBEDTLS_TLS_ECDHE_ECDSA_WITH_AES_128_GCM_SHA256,\0A    MBEDTLS_TLS_ECDHE_ECDSA_WITH_AES_256_GCM_SHA384,\0A    0\0A};\0A\0A#if defined(MBEDTLS_SSL_HANDSHAKE_WITH_CERT_ENABLED)\0A\0A/* NOTICE:\0A *   Fo