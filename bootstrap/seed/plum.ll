ta.key_slices[slice_idx];\0A    psa_key_slot_t *slice_end = slice + key_slice_length(slice_idx);\0A    if (slot < slice || slot >= slice_end) {\0A        /* The slot isn't actually in the slice! We can't detect that\0A         * condition for sure, because the pointer comparison itself is\0A         * undefined behavior in that case. That same condition makes the\0A         * subtraction to calculate the slot index also UB.\0A         * Give up now to avoid causing further corruption.\0A         */\0A        return PSA_ERROR_CORRUPTION_DETECTED;\0A    }\0A    size_t slot_idx = slot - slice;\0A\0A    size_t next_free = global_data.first_free_slot_index[slice_idx];\0A    if (next_free >= key_slice_length(slice_idx)) {\0A        /* The slot was full. The newly freed slot thus becomes the\0A         * end of the free list. */\0A        next_free = key_slice_length(slice_idx);\0A    }\0A    global_data.first_free_slot_index[slice_idx] = slot_idx;\0A    slot->var.free.next_free_relative_to_next =\0A        (int32_t) next_free - (int32_t) slot_idx - 1;\0A\0A    return PSA_SUCCESS;\0A}\0A#endif /* MBEDTLS_PSA_KEY_STORE_DYNAMIC */\0A\0Apsa_status_t psa_reserve_free_key_slot(psa_key_id_t *volatile_key_id,\0A                                       psa_key_slot_t **p_slot)\0A{\0A    psa_status_t status = PSA_ERROR_CORRUPTION_DETECTED;\0A    size_t slot_idx;\0A    psa_key_slot_t *selected_slot, *unused_persistent_key_slot;\0A\0A    if (!psa_get_key_slots_initialized()) {\0A        status = PSA_ERROR_BAD_STATE;\0A        goto error;\0A    }\0A\0A#if defined(MBEDTLS_PSA_KEY_STORE_DYNAMIC)\0A    if (volatile_key_id != NULL) {\0A        return psa_allocate_volatile_key_slot(volatile_key_id, p_slot);\0A    }\0A#endif /* MBEDTLS_PSA_KEY_STORE_DYNAMIC */\0A\0A    /* With a dynamic key store, allocate an entry in the cache slice,\0A     * applicable only to non-volatile keys that get cached in RAM.\0A     * With a static key store, allocate an entry in the sole slice,\0A     * applicable