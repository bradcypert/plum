{\0A        const char *env=getenv(\22PATH\22); if (!env) return plum_os_buf;\0A        char *paths=strdup(env); if (!paths) return plum_os_buf;\0A        char *p=paths;\0A        while (p) {\0A            char *next=strchr(p,':'); if (next) *next++='\5C0';\0A            char candidate[PLUM_PATH_MAX];\0A            int n=snprintf(candidate,sizeof(candidate),\22%s/%s\22,*p ? p : \22.\22,name);\0A            if (n >= 0 && n < (int)sizeof(candidate) && access(candidate,X_OK) == 0\0A                && realpath(candidate,plum_os_buf)) break;\0A            p=next;\0A        }\0A        free(paths);\0A    }\0A#endif\0A    return plum_os_buf;\0A}\0A\0A// Inspect trusted Clang JSON AST output, not C source spellings: adjacent\0A// literals and escapes can conceal assembler file-reading directives.\0A// Ordinary asm symbol labels are safe only when their emitted names have\0A// no quoting/whitespace/control characters that could inject assembly.\0Astatic const char *plum_cache_json_value(const char *p) {\0A    while (*p && isspace((unsigned char)*p)) p++;\0A    if (*p++ != ':') return NULL;\0A    while (*p && isspace((unsigned char)*p)) p++;\0A    return *p == '\22' ? p+1 : NULL;\0A}\0Along long plum_cache_safe_ast(const char *ast) {\0A    if (*ast != '{' || !strstr(ast,\22\5C\22TranslationUnitDecl\5C\22\22)) return 0;\0A    const char *p=ast;\0A    while ((p=strstr(p,\22\5C\22kind\5C\22\22)) != NULL) {\0A        p+=6; const char *value=plum_cache_json_value(p);\0A        if (!value) continue;\0A        const char *end=strchr(value,'\22'); if (!end) return 0;\0A        size_t size=(size_t)(end-value);\0A        for (size_t i=0; i+3<=size; i++) {\0A            if (!memcmp(value+i,\22Asm\22,3)\0A                && !(size == 12 && !memcmp(value,\22AsmLabelAttr\22,12))) return 0;\0A        }\0A        p=end+1;\0A    }\0A    p=ast;\0A    while ((p=strstr(p,\22\5C\22mangledName\5C\22\22)) != NULL) {\0A        p+=13; const char *value=plum_cache_json_value(p);\0A        if (!value) return 0;\0A        for (; *value && *value != '\22'; value++) {\0A            unsigned char c=(unsigned char)*value;\0A            if (!((c>='a' && c<='z') || (c>='A' && c<='Z')\0A                || (c>='0' && c<='9') || c=='_' || c=='.' || c=='$')) return 0;\0A        }\0A        if (*value != '\22') return 0;\0A    }\0A    return 1;\0A}\0A\0A// Generated LLVM contains quoted IR strings and identifiers, and comments.\0A// Only a bare `asm` token can introduce assembly. Do not mistake embedded\0A// C source or an application's string data for an LLVM assembly operand.\0Astatic int plum_cache_ir_word(unsigned char c) {\0A    return (c>='a' && c<='z') || (c>='A' && c<='Z') || (c>='0' && c<='9')\0A        || c=='_' || c=='.' || c=='$' || c=='-' || c=='@' || c=='%' || c=='!';\0A}\0Along long plum_cache_safe_ir(const char *ir) {\0A    const char *p=ir;\0A    while (*p) {\0A        if (*p == ';') { while (*p && *p!='\5Cn') p++; }\0A        else if (*p == '\22') {\0A            p++;\0A            while (*p && *p!='\22') {\0A                if (*p=='\5C\5C') { p++; if (!*p) return 0; }\0A                p++;\0A            }\0A            if (!*p) return 0;\0A            p++;\0A        } else if (plum_cache_ir_word((unsigned char)*p)) {\0A            const char *start=p;\0A            while (plum_cache_ir_word((unsigned char)*p)) p++;\0A            if (p-start == 3 && !memcmp(start,\22asm\22,3)) return 0;\0A        } else { p++; }\0A    }\0A    return 1;\0A}\0A\0A// Creates a fresh, empty, private directory and returns its path.\0A// Returns \22\22 -- an empty, non-null CStr -- on failure, because a null\0A// CStr return is a hard runtime abort under Plum's FFI semantics (see\0A// `net_shim.c`'s `tcp_recv` note, the same trade for the same reason).\0Aconst char *os_temp_dir(void) {\0A#if defined(_WIN32)\0A    char base[PLUM_PATH_MAX];\0A    DWORD n = GetTempPathA((DWORD)sizeof(base), base);\0A    if (n == 0 || n >= sizeof(base)) { plum_os_buf[0] = '\5C0'; return plum_os_buf