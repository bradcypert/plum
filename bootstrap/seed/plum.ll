 *create)(BCRYPT_ALG_HANDLE,BCRYPT_HASH_HANDLE *,PUCHAR,ULONG,PUCHAR,ULONG,ULONG);\0A    NTSTATUS (WINAPI *update)(BCRYPT_HASH_HANDLE,PUCHAR,ULONG,ULONG);\0A    NTSTATUS (WINAPI *finish)(BCRYPT_HASH_HANDLE,PUCHAR,ULONG,ULONG);\0A    NTSTATUS (WINAPI *destroy)(BCRYPT_HASH_HANDLE);\0A    NTSTATUS (WINAPI *close)(BCRYPT_ALG_HANDLE,ULONG);\0A} plum_win_sha;\0A\0Astatic void plum_win_sha_close(plum_win_sha *s) {\0A    if (s->alg) s->close(s->alg,0);\0A    if (s->dll) FreeLibrary(s->dll);\0A    memset(s,0,sizeof(*s));\0A}\0A\0Astatic void plum_win_sha_open(plum_win_sha *s) {\0A    memset(s,0,sizeof(*s));\0A    s->dll=LoadLibraryExW(L\22bcrypt.dll\22,NULL,LOAD_LIBRARY_SEARCH_SYSTEM32);\0A    if (!s->dll) return;\0A#define PLUM_WIN_PROC(member, name) do { \5C\0A    FARPROC p=GetProcAddress(s->dll,name); \5C\0A    memcpy(&s->member,&p,sizeof(p)); \5C\0A    if (!p) { plum_win_sha_close(s); return; } \5C\0A} while (0)\0A    PLUM_WIN_PROC(open,\22BCryptOpenAlgorithmProvider\22);\0A    PLUM_WIN_PROC(create,\22BCryptCreateHash\22);\0A    PLUM_WIN_PROC(update,\22BCryptHashData\22);\0A    PLUM_WIN_PROC(finish,\22BCryptFinishHash\22);\0A    PLUM_WIN_PROC(destroy,\22BCryptDestroyHash\22);\0A    PLUM_WIN_PROC(close,\22BCryptCloseAlgorithmProvider\22);\0A#undef PLUM_WIN_PROC\0A    if (s->open(&s->alg,BCRYPT_SHA256_ALGORITHM,NULL,0) < 0) plum_win_sha_close(s);\0A}\0A\0Astatic int plum_win_hash(HANDLE f, plum_win_sha *provider, char out[65]) {\0A    LARGE_INTEGER zero; zero.QuadPart=0;\0A    if (!SetFilePointerEx(f,zero,NULL,FILE_BEGIN)) return 0;\0A    BCRYPT_HASH_HANDLE hash=NULL;\0A    int fast=provider && provider->alg && provider->create(provider->alg,&hash,NULL,0,NULL,0,0) >= 0;\0A    plum_cache_sha portable; plum_cache_init(&portable);\0A    unsigned char buf[32768], digest[32]; DWORD n;\0A    int good=1, retry=0;\0A    for (;;) {\0A        if (!ReadFile(f,buf,sizeof(buf),&n,NULL)) { good=0; break; }\0A        if (!n) break;\0A        if (fast) {\0A            if (provider->update