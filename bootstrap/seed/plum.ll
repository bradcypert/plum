@.str40645 = private global { i64, i64, [948 x i8] } { i64 -1, i64 947, [948 x i8] c"/**\0A * \5Cfile ctr.h\0A *\0A * \5Cbrief    This file contains common functionality for counter algorithms.\0A *\0A *  Copyright The Mbed TLS Contributors\0A *  SPDX-License-Identifier: Apache-2.0 OR GPL-2.0-or-later\0A */\0A\0A#ifndef MBEDTLS_CTR_H\0A#define MBEDTLS_CTR_H\0A\0A#include \22common.h\22\0A\0A/**\0A * \5Cbrief               Increment a big-endian 16-byte value.\0A *                      This is quite performance-sensitive for AES-CTR and CTR-DRBG.\0A *\0A * \5Cparam n             A 16-byte value to be incremented.\0A */\0Astatic inline void mbedtls_ctr_increment_counter(uint8_t n[16])\0A{\0A    // The 32-bit version seems to perform about the same as a 64-bit version\0A    // on 64-bit architectures, so no need to define a 64-bit version.\0A    for (int i = 3;; i--) {\0A        uint32_t x = MBEDTLS_GET_UINT32_BE(n, i << 2);\0A        x += 1;\0A        MBEDTLS_PUT_UINT32_BE(x, n, i << 2);\0A        if (x != 0 || i == 0) {\0A            break;\0A        }\0A    }\0A}\0A\0A#endif /* MBEDTLS_CTR_H */\0A\00" }
