@.str44932 = private global { i64, i64, [22863 x i8] } { i64 -1, i64 22862, [22863 x i8] c"/*\0A *  Implementation of NIST SP 800-38F key wrapping, supporting KW and KWP modes\0A *  only\0A *\0A *  Copyright The Mbed TLS Contributors\0A *  SPDX-License-Identifier: Apache-2.0 OR GPL-2.0-or-later\0A */\0A/*\0A * Definition of Key Wrapping:\0A * https://nvlpubs.nist.gov/nistpubs/SpecialPublications/NIST.SP.800-38F.pdf\0A * RFC 3394 \22Advanced Encryption Standard (AES) Key Wrap Algorithm\22\0A * RFC 5649 \22Advanced Encryption Standard (AES) Key Wrap with Padding Algorithm\22\0A *\0A * Note: RFC 3394 defines different methodology for intermediate operations for\0A * the wrapping and unwrapping operation than the definition in NIST SP 800-38F.\0A */\0A\0A#include \22common.h\22\0A\0A#if defined(MBEDTLS_NIST_KW_C)\0A\0A#include \22mbedtls/nist_kw.h\22\0A#include \22mbedtls/platform_util.h\22\0A#include \22mbedtls/error.h\22\0A#include \22mbedtls/constant_time.h\22\0A#include \22constant_time_internal.h\22\0A\0A#include <stdint.h>\0A#include <string.h>\0A\0A#include \22mbedtls/platform.h\22\0A\0A#if !defined(MBEDTLS_NIST_KW_ALT)\0A\0A#define KW_SEMIBLOCK_LENGTH    8\0A#define MIN_SEMIBLOCKS_COUNT   3\0A\0A/*! The 64-bit default integrity check value (ICV) for KW mode. */\0Astatic const unsigned char NIST_KW_ICV1[] = { 0xA6, 0xA6, 0xA6, 0xA6, 0xA6, 0xA6, 0xA6, 0xA6 };\0A/*! The 32-bit default integrity check value (ICV) for KWP mode. */\0Astatic const  unsigned char NIST_KW_ICV2[] = { 0xA6, 0x59, 0x59, 0xA6 };\0A\0A/*\0A * Initialize context\0A */\0Avoid mbedtls_nist_kw_init(mbedtls_nist_kw_context *ctx)\0A{\0A    memset(ctx, 0, sizeof(mbedtls_nist_kw_context));\0A}\0A\0Aint mbedtls_nist_kw_setkey(mbedtls_nist_kw_context *ctx,\0A                           mbedtls_cipher_id_t cipher,\0A                           const unsigned char *key,\0A                           unsigned int keybits,\0A                           const int is_wrap)\0A{\0A    int ret = MBEDTLS_ERR_ERROR_CORRUPTION_DETECTED;\0A    const mbedtls_cipher_info_t *cipher_info;\0A\0A    cipher_info = mbedtls_cipher_info_from_values(cipher,\0A                                                  keybits,\0A                                                  MBEDTLS_MODE_ECB);\0A    if (cipher_info == NULL) {\0A        return MBEDTLS_ERR_CIPHER_BAD_INPUT_DATA;\0A    }\0A\0A    if (mbedtls_cipher_info_get_block_size(cipher_info) != 16) {\0A        return MBEDTLS_ERR_CIPHER_BAD_INPUT_DATA;\0A    }\0A\0A    /*\0A     * SP 800-38F currently defines AES cipher as the only block cipher allowed:\0A     * \22For KW and KWP, the underlying block cipher shall be approved, and the\0A     *  block size shall be 128 bits. Currently, the AES block cipher, with key\0A     *  lengths of 128, 192, or 256 bits, is the only block cipher that fits\0A     *  this profile.\22\0A     *  Currently we don't support other 128 bit block ciphers for key wrapping,\0A     *  such as Camellia and Aria.\0A     */\0A    if (cipher != MBEDTLS_CIPHER_ID_AES) {\0A        return MBEDTLS_ERR_CIPHER_FEATURE_UNAVAILABLE;\0A    }\0A\0A    mbedtls_cipher_free(&ctx->cipher_ctx);\0A\0A    if ((ret = mbedtls_cipher_setup(&ctx->cipher_ctx, cipher_info)) != 0) {\0A        return ret;\0A    }\0A\0A    if ((ret = mbedtls_cipher_setkey(&ctx->cipher_ctx, key, keybits,\0A                                     is_wrap ? MBEDTLS_ENCRYPT :\0A                                     MBEDTLS_DECRYPT)\0A         ) != 0) {\0A        return ret;\0A    }\0A\0A    return 0;\0A}\0A\0A/*\0A * Free context\0A */\0Avoid mbedtls_nist_kw_free(mbedtls_nist_kw_context *ctx)\0A{\0A    if (ctx == NULL) {\0A        return;\0A    }\0A\0A    mbedtls_cipher_free(&ctx->cipher_ctx);\0A    mbedtls_platform_zeroize(ctx, sizeof(mbedtls_nist_kw_context));\0A}\0A\0A/*\0A * Helper function for Xoring the uint64_t \22t\22 with the encrypted A.\0A * Defined in NIST SP 800-38F section 6.1\0A */\0Astatic void calc_a_xor_t(unsigned char A[KW_SEMIBLOCK_LENGTH], uint64_t t)\0A{\0A    size_t i = 0;\0A    for (i = 0; i < sizeof(t); i++) {\0A        A[i] ^= (t >> ((sizeof(t) - 1 - i) * 8)) & 0xff;\0A    }\0A}\0A\0A/*\0A * KW-AE as defined in SP 800-38F section 6.2\0A * KWP-AE as defined in SP 800-38F section 6.3\0A */\0Aint mbedtls_nist_kw_wrap(mbedtls_nist_kw_context *ctx,\0A                         mbedtls_nist_kw_mode_t mode,\0A                         const unsigned char *input, size_t in_len,\0A                         unsigned char *output, size_t *out_len, size_t out_size)\0A{\0A    int ret = 0;\0A    size_t semiblocks = 0;\0A    size_t s;\0A    size_t olen, padlen = 0;\0A    uint64_t t = 0;\0A    unsigned char outbuff[KW_SEMIBLOCK_LENGTH * 2];\0A    unsigned char inbuff[KW_SEMIBLOCK_LENGTH * 2];\0A\0A    *out_len = 0;\0A    /*\0A     * Generate the String to work on\0A     */\0A    if (mode == MBEDTLS_KW_MODE_KW) {\0A        if (out_size < in_len + KW_SEMIBLOCK_LENGTH) {\0A            return MBEDTLS_ERR_CIPHER_BAD_INPUT_DATA;\0A        }\0A\0A        /*\0A         * According to SP 800-38F Table 1, the plaintext length for KW\0A         * must be between 2 to 2^54-1 semiblocks inclusive.\0A         */\0A        if (in_len < 16 ||\0A#if SIZE_MAX > 0x1FFFFFFFFFFFFF8\0A            in_len > 0x1FFFFFFFFFFFFF8 ||\0A#endif\0A            in_len % KW_SEMIBLOCK_LENGTH != 0) {\0A            return MBEDTLS_ERR_CIPHER_BAD_INPUT_DATA;\0A        }\0A\0A        memcpy(output, NIST_KW_ICV1, KW_SEMIBLOCK_LENGTH);\0A        memmove(output + KW_SEMIBLOCK_LENGTH, input, in_len);\0A    } else {\0A        if (in_len % 8 != 0) {\0A            padlen = (8 - (in_len % 8));\0A        }\0A\0A        if (out_size < in_len + KW_SEMIBLOCK_LENGTH + padlen) {\0A            return MBEDTLS_ERR_CIPHER_BAD_INPUT_DATA;\0A        }\0A\0A        /*\0A         * According to SP 800-38F Table 1, the plaintext length for KWP\0A         * must be between 1 and 2^32-1 octets inclusive.\0A         */\0A        if (in_len < 1\0A#if SIZE_MAX > 0xFFFFFFFF\0A            || in_len > 0xFFFFFFFF\0A#endif\0A            ) {\0A            return MBEDTLS_ERR_CIPHER_BAD_INPUT_DATA;\0A        }\0A\0A        memcpy(output, NIST_KW_ICV2, KW_SEMIBLOCK_LENGTH / 2);\0A        MBEDTLS_PUT_UINT32_BE((in_len & 0xffffffff), output,\0A                              KW_SEMIBLOCK_LENGTH / 2);\0A\0A        memcpy(output + KW_SEMIBLOCK_LENGTH, input, in_len);\0A        memset(output + KW_SEMIBLOCK_LENGTH + in_len, 0, padlen);\0A    }\0A    semiblocks = ((in_len + padlen) / KW_SEMIBLOCK_LENGTH) + 1;\0A\0A    s = 6 * (semiblocks - 1);\0A\0A    if (mode == MBEDTLS_KW_MODE_KWP\0A        && in_len <= KW_SEMIBLOCK_LENGTH) {\0A        memcpy(inbuff, output, 16);\0A        ret = mbedtls_cipher_update(&ctx->cipher_ctx,\0A                                    inbuff, 16, output, &olen);\0A        if (ret != 0) {\0A            goto cleanup;\0A        }\0A    } else {\0A        unsigned char *R2 = output + KW_SEMIBLOCK_LENGTH;\0A        unsigned char *A = output;\0A\0A        /*\0A         * Do the wrapping function W, as defined in RFC 3394 section 2.2.1\0A         */\0A        if (semiblocks < MIN_SEMIBLOCKS_COUNT) {\0A            ret = MBEDTLS_ERR_CIPHER_BAD_INPUT_DATA;\0A            goto cleanup;\0A        }\0A\0A        /* Calculate intermediate values */\0A        for (t = 1; t <= s; t++) {\0A            memcpy(inbuff, A, KW_SEMIBLOCK_LENGTH);\0A            memcpy(inbuff + KW_SEMIBLOCK_LENGTH, R2, KW_SEMIBLOCK_LENGTH);\0A\0A            ret = mbedtls_cipher_update(&ctx->cipher_ctx,\0A                                        inbuff, 16, outbuff, &olen);\0A            if (ret != 0) {\0A                goto cleanup;\0A            }\0A\0A            memcpy(A, outbuff, KW_SEMIBLOCK_LENGTH);\0A            calc_a_xor_t(A, t);\0A\0A            memcpy(R2, outbuff + KW_SEMIBLOCK_LENGTH, KW_SEMIBLOCK_LENGTH);\0A            R2 += KW_SEMIBLOCK_LENGTH;\0A            if (R2 >= output + (semiblocks * KW_SEMIBLOCK_LENGTH)) {\0A                R2 = output + KW_SEMIBLOCK_LENGTH;\0A            }\0A        }\0A    }\0A\0A    *out_len = semiblocks * KW_SEMIBLOCK_LENGTH;\0A\0Acleanup:\0A\0A    if (ret != 0) {\0A        memset(output, 0, semiblocks * KW_SEMIBLOCK_LENGTH);\0A    }\0A    mbedtls_platform_zeroize(inbuff, KW_SEMIBLOCK_LENGTH * 2);\0A    mbedtls_platform_zeroize(outbuff, KW_SEMIBLOCK_LENGTH * 2);\0A\0A    return ret;\0A}\0A\0A/*\0A * W-1 function as defined in RFC 3394 section 2.2.2\0A * This function assumes the following:\0A * 1. Output buffer is at least of size ( semiblocks - 1 ) * KW_SEMIBLOCK_LENGTH.\0A * 2. The input buffer is of size semiblocks * KW_SEMIBLOCK_LENGTH.\0A * 3. Minimal number of semiblocks is 3.\0A * 4. A is a buffer to hold the first semiblock of the input buffer.\0A */\0Astatic int unwrap(mbedtls_nist_kw_context *ctx,\0A                  const unsigned char *input, size_t semiblocks,\0A                  unsigned char A[KW_SEMIBLOCK_LENGTH],\0A                  unsigned char *output, size_t *out_len)\0A{\0A    int ret = 0;\0A    const size_t s = 6 * (semiblocks - 1);\0A    size_t olen;\0A    uint64_t t = 0;\0A    unsigned char outbuff[KW_SEMIBLOCK_LENGTH * 2];\0A    unsigned char inbuff[KW_SEMIBLOCK_LENGTH * 2];\0A    unsigned char *R = NULL;\0A    *out_len = 0;\0A\0A    if (semiblocks < MIN_SEMIBLOCKS_COUNT) {\0A        return MBEDTLS_ERR_CIPHER_BAD_INPUT_DATA;\0A    }\0A\0A    memcpy(A, input, KW_SEMIBLOCK_LENGTH);\0A    memmove(output, input + KW_SEMIBLOCK_LENGTH, (semiblocks - 1) * KW_SEMIBLOCK_LENGTH);\0A    R = output + (semiblocks - 2) * KW_SEMIBLOCK_LENGTH;\0A\0A    /* Calculate intermediate values */\0A    for (t = s; t >= 1; t--) {\0A        calc_a_xor_t(A, t);\0A\0A        memcpy(inbuff, A, KW_SEMIBLOCK_LENGTH);\0A        memcpy(inbuff + KW_SEMIBLOCK_LENGTH, R, KW_SEMIBLOCK_LENGTH);\0A\0A        ret = mbedtls_cipher_update(&ctx->cipher_ctx,\0A                                    inbuff, 16, outbuff, &olen);\0A        if (ret != 0) {\0A            goto cleanup;\0A        }\0A\0A        memcpy(A, outbuff, KW_SEMIBLOCK_LENGTH);\0A\0A        /* Set R as LSB64 of outbuff */\0A        memcpy(R, outbuff + KW_SEMIBLOCK_LENGTH, KW_SEMIBLOCK_LENGTH);\0A\0A        if (R == output) {\0A            R = output + (semiblocks - 2) * KW_SEMIBLOCK_LENGTH;\0A        } else {\0A            R -= KW_SEMIBLOCK_LENGTH;\0A        }\0A    }\0A\0A    *out_len = (semiblocks - 1) * KW_SEMIBLOCK_LENGTH;\0A\0Acleanup:\0A    if (ret != 0) {\0A        memset(output, 0, (semiblocks - 1) * KW_SEMIBLOCK_LENGTH);\0A    }\0A    mbedtls_platform_zeroize(inbuff, sizeof(inbuff));\0A    mbedtls_platform_zeroize(outbuff, sizeof(outbuff));\0A\0A    return ret;\0A}\0A\0A/*\0A * KW-AD as defined in SP 800-38F section 6.2\0A * KWP-AD as defined in SP 800-38F section 6.3\0A */\0Aint mbedtls_nist_kw_unwrap(mbedtls_nist_kw_context *ctx,\0A                           mbedtls_nist_kw_mode_t mode,\0A                           const unsigned char *input, size_t in_len,\0A                           unsigned char *output, size_t *out_len, size_t out_size)\0A{\0A    int ret = 0;\0A    size_t olen;\0A    unsigned char A[KW_SEMIBLOCK_LENGTH];\0A    int diff;\0A\0A    *out_len = 0;\0A    if (out_size < in_len - KW_SEMIBLOCK_LENGTH) {\0A        return MBEDTLS_ERR_CIPHER_BAD_INPUT_DATA;\0A    }\0A\0A    if (mode == MBEDTLS_KW_MODE_KW) {\0A        /*\0A         * According to SP 800-38F Table 1, the ciphertext length for KW\0A         * must be between 3 to 2^54 semiblocks inclusive.\0A         */\0A        if (in_len < 24 ||\0A#if SIZE_MAX > 0x200000000000000\0A            in_len > 0x200000000000000 ||\0A#endif\0A            in_len % KW_SEMIBLOCK_LENGTH != 0) {\0A            return MBEDTLS_ERR_CIPHER_BAD_INPUT_DATA;\0A        }\0A\0A        ret = unwrap(ctx, input, in_len / KW_SEMIBLOCK_LENGTH,\0A                     A, output, out_len);\0A        if (ret != 0) {\0A            goto cleanup;\0A        }\0A\0A        /* Check ICV in \22constant-time\22 */\0A        diff = mbedtls_ct_memcmp(NIST_KW_ICV1, A, KW_SEMIBLOCK_LENGTH);\0A\0A        if (diff != 0) {\0A            ret = MBEDTLS_ERR_CIPHER_AUTH_FAILED;\0A            goto cleanup;\0A        }\0A\0A    } else if (mode == MBEDTLS_KW_MODE_KWP) {\0A        size_t padlen = 0;\0A        uint32_t Plen;\0A        /*\0A         * According to SP 800-38F Table 1, the ciphertext length for KWP\0A         * must be between 2 to 2^29 semiblocks inclusive.\0A         */\0A        if (in_len < KW_SEMIBLOCK_LENGTH * 2 ||\0A#if SIZE_MAX > 0x100000000\0A            in_len > 0x100000000 ||\0A#endif\0A            in_len % KW_SEMIBLOCK_LENGTH != 0) {\0A            return MBEDTLS_ERR_CIPHER_BAD_INPUT_DATA;\0A        }\0A\0A        if (in_len == KW_SEMIBLOCK_LENGTH * 2) {\0A            unsigned char outbuff[KW_SEMIBLOCK_LENGTH * 2];\0A            ret = mbedtls_cipher_update(&ctx->cipher_ctx,\0A                                        input, 16, outbuff, &olen);\0A            if (ret != 0) {\0A                goto cleanup;\0A            }\0A\0A            memcpy(A, outbuff, KW_SEMIBLOCK_LENGTH);\0A            memcpy(output, outbuff + KW_SEMIBLOCK_LENGTH, KW_SEMIBLOCK_LENGTH);\0A            mbedtls_platform_zeroize(outbuff, sizeof(outbuff));\0A            *out_len = KW_SEMIBLOCK_LENGTH;\0A        } else {\0A            /* in_len >=  KW_SEMIBLOCK_LENGTH * 3 */\0A            ret = unwrap(ctx, input, in_len / KW_SEMIBLOCK_LENGTH,\0A                         A, output, out_len);\0A            if (ret != 0) {\0A                goto cleanup;\0A            }\0A        }\0A\0A        /* Check ICV in \22constant-time\22 */\0A        diff = mbedtls_ct_memcmp(NIST_KW_ICV2, A, KW_SEMIBLOCK_LENGTH / 2);\0A\0A        if (diff != 0) {\0A            ret = MBEDTLS_ERR_CIPHER_AUTH_FAILED;\0A        }\0A\0A        Plen = MBEDTLS_GET_UINT32_BE(A, KW_SEMIBLOCK_LENGTH / 2);\0A\0A        /*\0A         * Plen is the length of the plaintext, when the input is valid.\0A         * If Plen is larger than the plaintext and padding, padlen will be\0A         * larger than 8, because of the type wrap a