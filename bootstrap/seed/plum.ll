urn ret;\0A    }\0A#endif\0A\0A    ret = ssl_cache_find_entry(cache, session_id, session_id_len, &entry);\0A    /* No valid entry found, exit with success */\0A    if (ret != 0) {\0A        ret = 0;\0A        goto exit;\0A    }\0A\0A    /* Now we remove the entry from the chain */\0A    if (entry == cache->chain) {\0A        cache->chain = entry->next;\0A        goto free;\0A    }\0A    for (prev = cache->chain; prev->next != NULL; prev = prev->next) {\0A        if (prev->next == entry) {\0A            prev->next = entry->next;\0A            break;\0A        }\0A    }\0A\0Afree:\0A    ssl_cache_entry_zeroize(entry);\0A    mbedtls_free(entry);\0A    ret = 0;\0A\0Aexit:\0A#if defined(MBEDTLS_THREADING_C)\0A    if (mbedtls_mutex_unlock(&cache->mutex) != 0) {\0A        ret = MBEDTLS_ERR_THREADING_MUTEX_ERROR;\0A    }\0A#endif\0A\0A    return ret;\0A}\0A\0A#if defined(MBEDTLS_HAVE_TIME)\0Avoid mbedtls_ssl_cache_set_timeout(mbedtls_ssl_cache_context *cache, int timeout)\0A{\0A    if (timeout < 0) {\0A        timeout = 0;\0A    }\0A\0A    cache->timeout = timeout;\0A}\0A#endif /* MBEDTLS_HAVE_TIME */\0A\0Avoid mbedtls_ssl_cache_set_max_entries(mbedtls_ssl_cache_context *cache, int max)\0A{\0A    if (max < 0) {\0A        max = 0;\0A    }\0A\0A    cache->max_entries = max;\0A}\0A\0Avoid mbedtls_ssl_cache_free(mbedtls_ssl_cache_context *cache)\0A{\0A    mbedtls_ssl_cache_entry *cur, *prv;\0A\0A    cur = cache->chain;\0A\0A    while (cur != NULL) {\0A        prv = cur;\0A        cur = cur->next;\0A\0A        ssl_cache_entry_zeroize(prv);\0A        mbedtls_free(prv);\0A    }\0A\0A#if defined(MBEDTLS_THREADING_C)\0A    mbedtls_mutex_free(&cache->mutex);\0A#endif\0A    cache->chain = NULL;\0A}\0A\0A#endif /* MBEDTLS_SSL_CACHE_C */\0A\00" }
