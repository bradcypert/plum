@.str45019 = private global { i64, i64, [15598 x i8] } { i64 -1, i64 15597, [15598 x i8] c"/**\0A * \5Cfile chachapoly.h\0A *\0A * \5Cbrief   This file contains the AEAD-ChaCha20-Poly1305 definitions and\0A *          functions.\0A *\0A *          ChaCha20-Poly1305 is an algorithm for Authenticated Encryption\0A *          with Associated Data (AEAD) that can be used to encrypt and\0A *          authenticate data. It is based on ChaCha20 and Poly1305 by Daniel\0A *          Bernstein and was standardized in RFC 7539.\0A *\0A * \5Cauthor Daniel King <damaki.gh@gmail.com>\0A */\0A\0A/*\0A *  Copyright The Mbed TLS Contributors\0A *  SPDX-License-Identifier: Apache-2.0 OR GPL-2.0-or-later\0A */\0A\0A#ifndef MBEDTLS_CHACHAPOLY_H\0A#define MBEDTLS_CHACHAPOLY_H\0A#include \22mbedtls/private_access.h\22\0A\0A#include \22mbedtls/build_info.h\22\0A\0A/* for shared error codes */\0A#include \22mbedtls/poly1305.h\22\0A\0A/** The requested operation is not permitted in the current state. */\0A#define MBEDTLS_ERR_CHACHAPOLY_BAD_STATE            -0x0054\0A/** Authenticated decryption failed: data was not authentic. */\0A#define MBEDTLS_ERR_CHACHAPOLY_AUTH_FAILED          -0x0056\0A\0A#ifdef __cplusplus\0Aextern \22C\22 {\0A#endif\0A\0Atypedef enum {\0A    MBEDTLS_CHACHAPOLY_ENCRYPT,     /**< The mode value for performing encryption. */\0A    MBEDTLS_CHACHAPOLY_DECRYPT      /**< The mode value for performing decryption. */\0A}\0Ambedtls_chachapoly_mode_t;\0A\0A#if !defined(MBEDTLS_CHACHAPOLY_ALT)\0A\0A#include \22mbedtls/chacha20.h\22\0A\0Atypedef struct mbedtls_chachapoly_context {\0A    mbedtls_chacha20_context MBEDTLS_PRIVATE(chacha20_ctx);  /**< The ChaCha20 context. */\0A    mbedtls_poly1305_context MBEDTLS_PRIVATE(poly1305_ctx);  /**< The Poly1305 context. */\0A    uint64_t MBEDTLS_PRIVATE(aad_len);                       /**< The length (bytes) of the Additional Authenticated Data. */\0A    uint64_t MBEDTLS_PRIVATE(ciphertext_len);                /**< The length (bytes) of the ciphertext. */\0A    int MBEDTLS_PRIVATE(state);                              /**< The current state of the context. */\0A    mbedtls_chachapoly_mode_t MBEDTLS_PRIVATE(mode);         /**< Cipher mode (encrypt or decrypt). */\0A}\0Ambedtls_chachapoly_context;\0A\0A#else /* !MBEDTLS_CHACHAPOLY_ALT */\0A#include \22chachapoly_alt.h\22\0A#endif /* !MBEDTLS_CHACHAPOLY_ALT */\0A\0A/**\0A * \5Cbrief           This function initializes the specified ChaCha20-Poly1305 context.\0A *\0A *                  It must be the first API called before using\0A *                  the context. It must be followed by a call to\0A *                  \5Cc mbedtls_chachapoly_setkey() before any operation can be\0A *                  done, and to \5Cc mbedtls_chachapoly_free() once all\0A *                  operations with that context have been finished.\0A *\0A *                  In order to encrypt or decrypt full messages at once, for\0A *                  each message you should make a single call to\0A *                  \5Cc mbedtls_chachapoly_crypt_and_tag() or\0A *                  \5Cc mbedtls_chachapoly_auth_decrypt().\0A *\0A *                  In order to encrypt messages piecewise, for each\0A *                  message you should make a call to\0A *                  \5Cc mbedtls_chachapoly_starts(), then 0 or more calls to\0A *                  \5Cc mbedtls_chachapoly_update_aad(), then 0 or more calls to\0A *                  \5Cc mbedtls_chachapoly_update(), then one call to\0A *                  \5Cc mbedtls_chachapoly_finish().\0A *\0A * \5Cwarning         Decryption with the piecewise API is discouraged! Always\0A *                  use \5Cc mbedtls_chachapoly_auth_decrypt() when possible!\0A *\0A *                  If however this is not possible because the data is too\0A *                  large to fit in memory, you need to:\0A *\0A *                  - call \5Cc mbedtls_chachapoly_starts() and (if needed)\0A *                  \5Cc mbedtls_chachapoly_update_aad() as above,\0A *                  - call \5Cc mbedtls_chachapoly_update() multiple times and\0A *                  ensure its output (the plaintext) is NOT used in any other\0A *                  way than placing it in temporary storage at this point,\0A *                  - call \5Cc mbedtls_chachapoly_finish() to compute the\0A *                  authentication tag and compared it in constant time to the\0A *                  tag received with the ciphertext.\0A *\0A *                  If the tags are not equal, you must immediately discard\0A *                  all previous outputs of \5Cc mbedtls_chachapoly_update(),\0A *                  otherwise you can now safely use the plaintext.\0A *\0A * \5Cparam ctx       The ChachaPoly context to initialize. Must not be \5Cc NULL.\0A */\0Avoid mbedtls_chachapoly_init(mbedtls_chachapoly_context *ctx);\0A\0A/**\0A * \5Cbrief           This function releases and clears the specified\0A *                  ChaCha20-Poly1305 context.\0A *\0A * \5Cparam ctx       The ChachaPoly context to clear. This may be \5Cc NULL, in which\0A *                  case this function is a no-op.\0A */\0Avoid mbedtls_chachapoly_free(mbedtls_chachapoly_context *ctx);\0A\0A/**\0A * \5Cbrief           This function sets the ChaCha20-Poly1305\0A *                  symmetric encryption key.\0A *\0A * \5Cparam ctx       The ChaCha20-Poly1305 context to which the key should be\0A *                  bound. This must be initialized.\0A * \5Cparam key       The \5Cc 256 Bit (\5Cc 32 Bytes) key.\0A *\0A * \5Creturn          \5Cc 0 on success.\0A * \5Creturn          A negative error code on failure.\0A */\0Aint mbedtls_chachapoly_setkey(mbedtls_chachapoly_context *ctx,\0A                              const unsigned char key[32]);\0A\0A/**\0A * \5Cbrief           This function starts a ChaCha20-Poly1305 encryption or\0A *                  decryption operation.\0A *\0A * \5Cwarning         You must never use the same nonce twice with the same key.\0A *                  This would void any confidentiality and authenticity\0A *                  guarantees for the messages encrypted with the same nonce\0A *                  and key.\0A *\0A * \5Cnote            If the context is being used for AAD only (no data to\0A *                  encrypt or decrypt) then \5Cp mode can be set to any value.\0A *\0A * \5Cwarning         Decryption with the piecewise API is discouraged, see the\0A *                  warning on \5Cc mbedtls_chachapoly_init().\0A *\0A * \5Cparam ctx       The ChaCha20-Poly1305 context. This must be initialized\0A *                  and bound to a key.\0A * \5Cparam nonce     The nonce/IV to use for the message.\0A *                  This must be a readable buffer of length \5Cc 12 Bytes.\0A * \5Cparam mode      The operation to perform: #MBEDTLS_CHACHAPOLY_ENCRYPT or\0A *                  #MBEDTLS_CHACHAPOLY_DECRYPT (discouraged, see warning).\0A *\0A * \5Creturn          \5Cc 0 on success.\0A * \5Creturn          A negative error code on failure.\0A */\0Aint mbedtls_chachapoly_starts(mbedtls_chachapoly_context *ctx,\0A                              const unsigned char nonce[12],\0A                              mbedtls_chachapoly_mode_t mode);\0A\0A/**\0A * \5Cbrief           This function feeds additional data to be authenticated\0A *                  into an ongoing ChaCha20-Poly1305 operation.\0A *\0A *                  The Additional Authenticated Data (AAD), also called\0A *                  Associated Data (AD) is only authenticated but not\0A *                  encrypted nor included in the encrypted output. It is\0A *                  usually transmitted separately from the ciphertext or\0A *                  computed locally by each party.\0A *\0A * \5Cnote            This function is called before data is encrypted/decrypted.\0A *                  I.e. call this function to process the AAD before calling\0A *                  \5Cc mbedtls_chachapoly_update().\0A *\0A *                  You may call this function multiple times to process\0A *                  an arbitrary amount of AAD. It is permitted to call\0A *                  this function 0 times, if no AAD is used.\0A *\0A *                  This function cannot be called any more if data has\0A *                  been processed by \5Cc mbedtls_chachapoly_update(),\0A *                  or if the context has been finished.\0A *\0A * \5Cwarning         Decryption with the piecewise API is discouraged, see the\0A *                  warning on \5Cc mbedtls_chachapoly_init().\0A *\0A * \5Cparam ctx       The ChaCha20-Poly1305 context. This must be initialized\0A *                  and bound to a key.\0A * \5Cparam aad_len   The length in Bytes of the AAD. The length has no\0A *                  restrictions.\0A * \5Cparam aad       Buffer containing the AAD.\0A *                  This pointer can be \5Cc NULL if `aad_len == 0`.\0A *\0A * \5Creturn          \5Cc 0 on success.\0A * \5Creturn          #MBEDTLS_ERR_POLY1305_BAD_INPUT_DATA\0A *                  if \5Cp ctx or \5Cp aad are NULL.\0A * \5Creturn          #MBEDTLS_ERR_CHACHAPOLY_BAD_STATE\0A *                  if the operations has not been started or has been\0A *                  finished, or if the AAD has been finished.\0A */\0Aint mbedtls_chachapoly_update_aad(mbedtls_chachapoly_context *ctx,\0A                                  const unsigned char *aad,\0A                                  size_t aad_len);\0A\0A/**\0A * \5Cbrief           Thus function feeds data to be encrypted or decrypted\0A *                  into an on-going ChaCha20-Poly1305\0A *                  operation.\0A *\0A *                  The direction (encryption or decryption) depends on the\0A *                  mode that was given when calling\0A *                  \5Cc mbedtls_chachapoly_starts().\0A *\0A *                  You may call this function multiple times to process\0A *                  an arbitrary amount of data. It is permitted to call\0A *                  this function 0 times, if no data is to be encrypted\0A *                  or decrypted.\0A *\0A * \5Cwarning         Decryption with the piecewise API is discouraged, see the\0A *                  warning on \5Cc mbedtls_chachapoly_init().\0A *\0A * \5Cparam ctx       The ChaCha20-Poly1305 context to use. This must be initialized.\0A * \5Cparam len       The length (in bytes) of the data to encrypt or decrypt.\0A * \5Cparam input     The buffer containing the data to encrypt or decrypt.\0A *                  This pointer can be \5Cc NULL if `len == 0`.\0A * \5Cparam output    The buffer to where the encrypted or decrypted data is\0A *                  written. This must be able to hold \5Cp len bytes.\0A *                  This pointer can be \5Cc NULL if `len == 0`.\0A *\0A * \5Creturn          \5Cc 0 on success.\0A * \5Creturn          #MBEDTLS_ERR_CHACHAPOLY_BAD_STATE\0A *                  if the operation has not been started or has been\0A *                  finished.\0A * \5Creturn          Another negative error code on other kinds of failure.\0A */\0Aint mbedtls_chachapoly_update(mbedtls_chachapoly_context *ctx,\0A                              size_t len,\0A                              const unsigned char *input,\0A                              unsigned char *output);\0A\0A/**\0A * \5Cbrief           This function finished the ChaCha20-Poly1305 operation and\0A *                  generates the MAC (authentication tag).\0A *\0A * \5Cparam ctx       The ChaCha20-Poly1305 context to use. This must be initialized.\0A * \5Cparam mac       The buffer to where the 128-bit (16 bytes) MAC is written.\0A *\0A * \5Cwarning         Decryption with the piecewise API is discouraged, see the\0A *                  warning on \5Cc mbedtls_chachapoly_init().\0A *\0A * \5Creturn          \5Cc 0 on success.\0A * \5Creturn          #MBEDTLS_ERR_CHACHAPOLY_BAD_STATE\0A *                  if the operation has not been started or has been\0A *                  finished.\0A * \5Creturn          Another negative error code on other kinds of failure.\0A */\0Aint mbedtls_chachapoly_finish(mbedtls_chachapoly_context *ctx,\0A                              unsigned char mac[16]);\0A\0A/**\0A * \5Cbrief           This function performs a complete ChaCha20-Poly1305\0A *                  authenticated encryption with the previously-set key.\0A *\0A * \5Cnote            Before using this function, you must set the key with\0A *                  \5Cc mbedtls_chachapoly_setkey().\0A *\0A * \5Cwarning         You must never use the same nonce twice with the same key.\0A *                  This would void any confidentiality and authenticity\0A *                  guarantees for the messages encrypted with the same nonce\0A *                  and key.\0A *\0A * \5Cparam ctx       The ChaCha20-Poly1305 context to use (holds the key).\0A *                  This must be initialized.\0A * \5Cparam length    The length (in bytes) of the data to encrypt or decrypt.\0A * \5Cparam nonce     The 96-bit (12 bytes) nonce/IV to use.\0A * \5Cparam aad       The buffer containing the additional authenticated\0A *                  data (AAD). This pointer can be \5Cc NULL if `aad_len == 0`.\0A * \5Cparam aad_len   The length (in bytes) of the AAD data to process.\0A * \5Cparam input     The buffer containing the data to encrypt or decrypt.\0A *                  This pointer can be \5Cc NULL if `ilen == 0`.\0A * \5Cparam output    The buffer to where the encrypted or decrypted data\0A *                  is written. This pointer can be \5Cc NULL if `ilen == 0`.\0A * \5Cparam tag       The buffer to where the computed 128-bit (16 bytes) MAC\0A *                  is written. This must not be \5Cc NULL.\0A *\0A * \5Creturn          \5Cc 0 on success.\0A * \5Creturn          A negative error code on failure.\0A */\0Aint mbedtls_chachapoly_encrypt_and_tag(mbedtls_chachapoly_context *ctx,\0A                                       size_t length,\0A                                       const unsigned char nonce[12],\0A                                       const unsigned char *aad,\0A                                       size_t aad_len,\0A                                       const unsigned char *input,\0A                                       unsigned char *output,\0A                                       unsigned char tag[16]);\0A\0A/**\0A * \5Cbrief           This function performs a complete ChaCha20-Poly1305\0A *                  authenticated decryption with the previously-set key.\0A *\0A * \5Cnote            Before using this function, you must set the key with\0A *                  \5Cc mbedtls_chachapoly_setkey().\0A *\0A * \5Cparam ctx       The ChaCha20-Poly1305 context to use (holds the key).\0A * \5Cparam length    The length (in Bytes) of the data to decrypt.\0A * \5Cparam nonce     The \5Cc 96 Bit (\5Cc 12 bytes) nonce/IV to use.\0A * \5Cparam aad       The buffer containing the additional authenticated data (AAD).\0A *                  This pointer can be \5Cc NULL if `aad_len == 0`.\0A * \5Cparam aad_len   The length (in bytes) of the AAD data to process.\0A * \5Cparam tag       The buffer holding the authentication tag.\0A *                  This must be a readable buffer of length \5Cc 16 Bytes.\0A * \5Cparam input     The buffer containing the data to decrypt.\0A *                  This pointer can be \5Cc NULL if `ilen == 0`.\0A * \5Cparam output    The buffer to where the decrypted data is written.\0A *                  This pointer can be \5Cc NULL if `ilen == 0`.\0A *\0A * \5Creturn          \5Cc 0 on success.\0A * \5Creturn          #MBEDTLS_ERR_CHACHAPOLY_AUTH_FAILED\0A *                  if the data was not authentic.\0A * \5Creturn          Another negative error code on other kinds of failure.\0A */\0Aint mbedtls_chachapoly_auth_decrypt(mbedtls_chachapoly_context *ctx,\0A                                    size_t length,\0A                                    const unsigned char nonce[12],\0A                                    const unsigned char *aad,\0A                                    size_t aad_len,\0A                                    const unsigned char tag[16],\0A                                    const unsigned char *input,\0A                                    unsigned char *output);\0A\0A#if defined(MBEDTLS_SELF_TEST)\0A/**\0A * \5Cbrief           The ChaCha20-Poly1305 checkup routine.\0A *\0A * \5Creturn          \5Cc 0 on success.\0A * \5Creturn          \5Cc 1 on failure.\0A */\0Aint mbedtls_chachapoly_self_test(int verbose);\0A#endif /* MBEDTLS_SELF_TEST */\0A\0A#ifdef __cplusplus\0A}\0A#endif\0A\0A#endif /* MBEDTLS_CHACHAPOLY_H */\0A\00" }
