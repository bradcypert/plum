@.str41040 = private global { i64, i64, [14 x i8] } { i64 -1, i64 13, [14 x i8] c"thread_shim.c\00" }
@.str41042 = private global { i64, i64, [16729 x i8] } { i64 -1, i64 16728, [16729 x i8] c"// Threads and channels for the SELF-HOSTED backend.\0A//\0A// The real backend emits its own pthread calls and a channel queue\0A// directly as LLVM IR (`plum_codegen::emit_channel_runtime`). The\0A// self-hosted backend reaches the same primitives through this shim\0A// instead, for the same reason it reaches directories and processes\0A// through `dir_shim.c`/`process_shim.c`: writing a mutex/condvar queue\0A// by hand in LLVM IR is a great deal of fiddly text to get right, and\0A// none of it is Plum-specific.\0A//\0A// Handles are opaque `long long`s rather than pointers so the Plum side\0A// can hold them in an ordinary `Int`-shaped slot with no lifetime of\0A// its own. The values happen to BE pointers; nothing on the Plum side\0A// may assume that.\0A//\0A// Values crossing a channel are `void *`. What they point at is the\0A// caller's business -- the self-hosted backend boxes each sent value\0A// into one malloc'd word, because a channel is typed on the Plum side\0A// and the box's contents are therefore always the same shape for a\0A// given channel.\0A\0A#include <errno.h>\0A#include <pthread.h>\0A#include <time.h>\0A#include <stdint.h>\0A#include <stdio.h>\0A#include <stdlib.h>\0A\0A// --- Threads ---\0A\0A// `refs` is 2 at birth: one for the running thread, one for the Plum\0A// `Task` cell. Whichever lets go LAST frees the struct, which is what\0A// makes \22the task outlives the handle\22 and \22the handle outlives the\0A// task\22 both work without either side knowing which happened.\0A//\0A// `joined` says `.join()` has already taken the result. It is what\0A// turns a second join from undefined behaviour into a clean abort, now\0A// that a refcounted `Task` cell can be copied and joined twice.\0Atypedef struct {\0A    void (*fn)(void *, void *);\0A    void *arg;\0A    void *result;\0A    void (*result_release)(void *);\0A    pthread_t id;\0A    pthread_mutex_t lock;\0A    int refs;\0A    int joined;\0A    int detached;\0A} plum_task;\0A\0A// Drops one reference and frees at zero. The caller must NOT hold\0A// `t->lock`.\0Astatic void plum_task_unref(plum_task *t) {\0A    pthread_mutex_lock(&t->lock);\0A    t->refs--;\0A    int dead = (t->refs == 0);\0A    pthread_mutex_unlock(&t->lock);\0A    if (!dead) return;\0A    // Nobody joined, so the boxed result is nobody's -- release what it\0A    // holds and free the box, or it leaks exactly the way the whole\0A    // change is meant to stop.\0A    if (t->result && !t->joined) {\0A        if (t->result_release) t->result_release(*(void **)t->result);\0A        free(t->result);\0A    }\0A    pthread_mutex_destroy(&t->lock);\0A    free(t);\0A}\0A\0Astatic void *plum_task_trampoline(void *raw) {\0A    plum_task *t = (plum_task *)raw;\0A    t->fn(t->arg, t->result);\0A    // The callback was installed before pthread_create, so either final\0A    // owner can release an unjoined result, including a detached worker.\0A    plum_task_unref(t);\0A    return NULL;\0A}\0A\0A// On failure, the caller still owns arg. On success, the worker owns it.\0A// Allocate the result box BEFORE starting the worker: no allocation can\0A// fail between running the body and storing its returned owned value.\0Along long thread_spawn(void (*fn)(void *, void *), void *arg,\0A                       void (*result_release)(void *)) {\0A    plum_task *t = (plum_task *)malloc(sizeof(plum_task));\0A    if (!t) return 0;\0A    t->result = malloc(8);\0A    if (!t->result) {\0A        free(t);\0A        return 0;\0A    }\0A    t->fn = fn;\0A    t->arg = arg;\0A    t->result_release = result_release;\0A    if (pthread_mutex_init(&t->lock, NULL) != 0) {\0A        free(t->result);\0A        free(t);\0A        return 0;\0A    }\0A    t->refs = 2;\0A    t->joined = 0;\0A    t->detached = 0;\0A    if (pthread_create(&t->id, NULL, plum_task_trampoline, t) != 0) {\0A        pthread_mutex_destroy(&t->lock);\0A        free(t->result);\0A        free(t);\0A        return 0;\0A    }\0A    return (long long)(intptr_t)t;\0A}\0A\0A// Fixed diagnostics need no allocation, including under memory pressure.\0A// Generated code releases untransferred inputs before calling this.\0Avoid thread_fail(long long operation) {\0A    const char *message = operation == 0 ? \22panic: task creation failed\5Cn\22 :\0A                          operation == 1 ? \22panic: channel creation failed\5Cn\22 :\0A                                           \22panic: channel send failed\5Cn\22;\0A    fputs(message, stdout);\0A    exit(1);\0A}\0A\0A// A second join is an ERROR, not undefined. It used to be prevented by\0A// `.join()` consuming the task; a refcounted `Task` cell can be copied,\0A// so the guarantee moved here where it can actually be enforced.\0A//\0A// The struct is NOT freed here -- the Plum cell still holds a\0A// reference, and `task_release` frees it when that goes.\0Avoid *thread_join(long long handle) {\0A    plum_task *t = (plum_task *)(intptr_t)handle;\0A    if (!t) return NULL;\0A    pthread_mutex_lock(&t->lock);\0A    if (t->joined) {\0A        pthread_mutex_unlock(&t->lock);\0A        // Same shape as the runtime's own `@plum_bounds_fail`: say\0A        // what happened on stdout and stop. There is no error channel\0A        // back into Plum from a shim.\0A        printf(\22panic: task already joined\5Cn\22);\0A        exit(1);\0A        return NULL;\0A    }\0A    t->joined = 1;\0A    pthread_mutex_unlock(&t->lock);\0A    pthread_join(t->id, NULL);\0A    return t->result;\0A}\0A\0A// The Plum `Task` cell's last reference is gone.\0A//\0A// If nobody joined, the thread is DETACHED rather than waited for: a\0A// scope exit that blocked for an unbounded time with nothing at the\0A// call site saying so would be worse than the leak this replaces. The\0A// body keeps running and its result is dropped.\0Avoid task_release(long long handle) {\0A    plum_task *t = (plum_task *)(intptr_t)handle;\0A    if (!t) return;\0A    pthread_mutex_lock(&t->lock);\0A    int detach = (!t->joined && !t->detached);\0A    if (detach) t->detached = 1;\0A    pthread_mutex_unlock(&t->lock);\0A    if (detach) pthread_detach(t->id);\0A    plum_task_unref(t);\0A}\0A\0A// --- Channels ---\0A//\0A// An unbounded queue with a mutex and a condition variable. Unbounded\0A// because a bounded one needs a second condvar and a policy for what a\0A// full channel does to a sender, and neither compiler's surface syntax\0A// exposes a capacity to choose one with.\0A\0Atypedef struct plum_chan_node {\0A    void *value;\0A    struct plum_chan_node *next;\0A} plum_chan_node;\0A\0A// Counts track wrapper cells, not aliases of a cell. Spawned copies retain\0A// their own endpoint kind. Zero senders means EOF after draining; zero\0A// receivers means queued values can never be delivered.\0Atypedef struct {\0A    pthread_mutex_t lock;\0A    pthread_cond_t ready;\0A    plum_chan_node *head;\0A    plum_chan_node *tail;\0A    int senders;\0A    int receivers;\0A} plum_chan;\0A\0Astatic pthread_mutex_t plum_sel_lock = PTHREAD_MUTEX_INITIALIZER;\0Astatic pthread_cond_t plum_sel_ready = PTHREAD_COND_INITIALIZER;\0A\0Along long channel_new(void) {\0A    plum_chan *c = (plum_chan *)malloc(sizeof(plum_chan));\0A    if (!c) return 0;\0A    if (pthread_mutex_init(&c->lock, NULL) != 0) {\0A        free(c);\0A        return 0;\0A    }\0A    if (pthread_cond_init(&c->ready, NULL) != 0) {\0A        pthread_mutex_destroy(&c->lock);\0A        free(c);\0A        return 0;\0A    }\0A    c->head = NULL;\0A    c->tail = NULL;\0A    c->senders = 1;\0A    c->receivers = 1;\0A    return (long long)(intptr_t)c;\0A}\0A\0A// A channel end's Plum wrapper cell is copied into each spawned closure,\0A// but every copy still points at this one queue. Retain the queue under\0A// its mutex so the per-thread wrapper cells can be released independently.\0Avoid channel_retain(long long handle, long long receiver) {\0A    plum_chan *c = (plum_chan *)(intptr_t)handle;\0A    if (!c) return;\0A    pthread_mutex_lock(&c->lock);\0A    if (receiver) c->receivers++; else c->senders++;\0A    pthread_mutex_unlock(&c->lock);\0A}\0A\0A// 1 transfers value into the queue; -1 is disconnected; 0 is allocation\0A// failure. Both failures leave ownership with the caller.\0Along long channel_send(long long handle, void *value) {\0A    plum_chan *c = (plum_chan *)(intptr_t)handle;\0A    if (!c) return 0;\0A    plum_chan_node *n = (plum_chan_node *)malloc(sizeof(plum_chan_node));\0A    if (!n) return 0;\0A    n->value = value;\0A    n->next = NULL;\0A    pthread_mutex_lock(&c->lock);\0A    if (!c->receivers) {\0A        pthread_mutex_unlock(&c->lock);\0A        free(n);\0A        return -1; // Disconnected: caller still owns the payload.\0A    }\0A    if (c->tail) c->tail->next = n; else c->head = n;\0A    c->tail = n;\0A    // Signalled while the lock is HELD: a receiver woken before the\0A    // queue pointers were published would find an empty queue and, with\0A    // the predicate loop below, simply wait again -- correct but\0A    // wasteful. Holding it also keeps the wakeup ordered with the\0A    // enqueue for anyone reasoning about this later.\0A    pthread_cond_signal(&c->ready);\0A    pthread_mutex_unlock(&c->lock);\0A    // Woken AFTER this channel's lock is dropped, which is what keeps\0A    // the lock order one-way -- see `plum_sel_lock`. Broadcast rather\0A    // than signal because the waiters are selecting on different sets\0A    // of channels, so there is no such thing as \22the right one\22 to\0A    // wake; each rechecks its own arms.\0A    pthread_mutex_lock(&plum_sel_lock);\0A    pthread_cond_broadcast(&plum_sel_ready);\0A    pthread_mutex_unlock(&plum_sel_lock);\0A    return 1;\0A}\0A\0A// --- Selecting over several channels ---\0A//\0A// A channel's own condvar cannot express \22wait until ANY of these has\0A// something\22, so there is one process-wide condvar that every send\0A// broadcasts on, and a `select` that finds nothing sleeps on it.\0A//\0A// The cost is one uncontended mutex per send, paid even by programs\0A// that never select. The alternative that avoids it -- registering a\0A// waiter on each channel -- is the only version with cross-channel lock\0A// ordering to get wrong, and this queue is unbounded and mutex-based\0A// already; it is not the place to spend that risk.\0A//\0A// LOCK ORDER is `sel_lock` then a channel's `lock`, and only ever that\0A// way round. `channel_select` holds `sel_lock` across its sweep, and\0A// the sweep takes each channel lock in turn. `channel_send` takes its\0A// channel lock and RELEASES it before taking `sel_lock`, so it never\0A// holds both in the other order and there is no cycle.\0A// Non-blocking readiness probe: a queued box or drained EOF is ready.\0A// A ready NULL box means EOF; an actual message always has a nonnull box.\0Astatic int plum_chan_try_recv(long long handle, void **out) {\0A    plum_chan *c = (plum_chan *)(intptr_t)handle;\0A    if (!c) { *out = NULL; return 1; }\0A    pthread_mutex_lock(&c->lock);\0A    plum_chan_node *n = c->head;\0A    if (n) {\0A        c->head = n->next;\0A        if (!c->head) c->tail = NULL;\0A    }\0A    int ready = n || !c->senders;\0A    pthread_mutex_unlock(&c->lock);\0A    *out = n ? n->value : NULL;\0A    free(n);\0A    return ready;\0A}\0A\0A// Blocks until one of `handles` has a value or reaches EOF. Returns the\0A// winning INDEX and stores its box (NULL for EOF) through `out`.\0A//\0A// The whole loop is here rather than in generated code because every\0A// payload crosses as a `void *` box, so C can do all of it, and because\0A// the sweep has to happen with `sel_lock` HELD. That is what closes the\0A// missed-wakeup window: a send that arrives after the sweep looked at\0A// its channel cannot broadcast until this thread is already waiting.\0A//\0A// Arms are swept in index order, so an earlier arm wins a tie. That is\0A// a real fairness choice -- a hot arm 0 can starve arm 1 -- and it is\0A// the same order the retired backend used.\0Along long channel_select(const long long *handles, long long n, void **out) {\0A    *out = NULL;\0A    if (n <= 0) return -1;\0A    pthread_mutex_lock(&plum_sel_lock);\0A    for (;;) {\0A        for (long long i = 0; i < n; i++) {\0A            void *v;\0A            if (plum_chan_try_recv(handles[i], &v)) {\0A                pthread_mutex_unlock(&plum_sel_lock);\0A                *out = v;\0A                return i;\0A            }\0A        }\0A        pthread_cond_wait(&plum_sel_ready, &plum_sel_lock);\0A    }\0A}\0A\0A// `channel_select`, bounded by a deadline. Returns the winning index,\0A// or -1 if `nanos` elapsed with nothing ready.\0A//\0A// A `nanos` of zero is a SWEEP AND GIVE UP, which is what `select`'s\0A// `else` arm compiles to: the deadline is already past, so the wait\0A// below returns `ETIMEDOUT` at once and nothing blocks. One code path\0A// serves \22take one if ready, otherwise continue\22 and \22wait this long\22,\0A// and the difference between them is a number.\0A//\0A// The deadline is computed ONCE, before the loop, and re-waited against\0A// on every wakeup. Computing a fresh `nanos`-from-now inside the loop\0A// would restart the clock on each spurious wakeup or each send on an\0A// unrelated channel, so a select could wait far longer than it was\0A// asked to and, under a busy enough process, never return.\0A//\0A// `CLOCK_REALTIME` because that is what `pthread_cond_timedwait` is\0A// specified against by default. It can therefore be lengthened or\0A// shortened by the system clock being set, which is a real limitation\0A// and the reason `Time.since` reads the monotonic clock instead --\0A// measuring elapsed time and bounding a wait are different jobs, and\0A// only one of them can use a condition variable.\0Along long channel_select_timeout(const long long *handles, long long n, void **out, long long nanos) {\0A    struct timespec deadline;\0A    *out = NULL;\0A    if (n <= 0) return -1;\0A    if (nanos < 0) nanos = 0;\0A    clock_gettime(CLOCK_REALTIME, &deadline);\0A    deadline.tv_sec += (time_t)(nanos / 1000000000LL);\0A    deadline.tv_nsec += (long)(nanos % 1000000000LL);\0A    if (deadline.tv_nsec >= 1000000000L) {\0A        deadline.tv_sec += 1;\0A        deadline.tv_nsec -= 1000000000L;\0A    }\0A    pthread_mutex_lock(&plum_sel_lock);\0A    for (;;) {\0A        for (long long i = 0; i < n; i++) {\0A            void *v;\0A            if (plum_chan_try_recv(handles[i], &v)) {\0A                pthread_mutex_unlock(&plum_sel_lock);\0A                *out = v;\0A                return i;\0A            }\0A        }\0A        // A sweep happens BEFORE the first wait and after every wakeup,\0A        // so a value that arrived before this call is still seen even\0A        // when the deadline has already passed.\0A        if (pthread_cond_timedwait(&plum_sel_ready, &plum_sel_lock, &deadline) == ETIMEDOUT) {\0A            // One last sweep: a send may have landed between the last\0A            // one and the deadline expiring, and reporting a timeout\0A            // while a value sits in the queue would lose it.\0A            for (long long i = 0; i < n; i++) {\0A                void *v;\0A                if (plum_chan_try_recv(handles[i], &v)) {\0A                    pthread_mutex_unlock(&plum_sel_lock);\0A                    *out = v;\0A                    return i;\0A                }\0A            }\0A            pthread_mutex_unlock(&plum_sel_lock);\0A            return -1;\0A        }\0A    }\0A}\0A\0A// Blocks until a value or EOF is available; NULL means drained EOF.\0A// The `while` (not `if`) is the\0A// standard guard against spurious wakeups, which pthread condition\0A// variables are explicitly permitted to produce.\0Avoid *channel_recv(long long handle) {\0A    plum_chan *c = (plum_chan *)(intptr_t)handle;\0A    if (!c) return NULL;\0A    pthread_mutex_lock(&c->lock);\0A    while (!c->head && c->senders) {\0A        pthread_cond_wait(&c->ready, &c->lock);\0A    }\0A    plum_chan_node *n = c->head;\0A    if (!n) { pthread_mutex_unlock(&c->lock); return NULL; }\0A    c->head = n->next;\0A    if (!c->head) c->tail = NULL;\0A    pthread_mutex_unlock(&c->lock);\0A    void *v = n->value;\0A    free(n);\0A    return v;\0A}\0A\0A// One end of the channel has let go.\0A//\0A// Anything still QUEUED when the last receiver goes is undeliverable\0A// and holds references of its own -- so the drain\0A// releases each value through `rel` rather than just freeing boxes.\0A// `rel` is null for an element type that owns nothing.\0Avoid channel_release(long long handle, long long receiver, void (*rel)(void *)) {\0A    plum_chan *c = (plum_chan *)(intptr_t)handle;\0A    if (!c) return;\0A    pthread_mutex_lock(&c->lock);\0A    if (receiver) c->receivers--; else c->senders--;\0A    int closed = !receiver && !c->senders;\0A    int dead = !c->senders && !c->receivers;\0A    plum_chan_node *n = !c->receivers ? c->head : NULL;\0A    if (!c->receivers) { c->head = NULL; c->tail = NULL; }\0A    if (closed) pthread_cond_broadcast(&c->ready);\0A    pthread_mutex_unlock(&c->lock);\0A    if (closed) {\0A        pthread_mutex_lock(&plum_sel_lock);\0A        pthread_cond_broadcast(&plum_sel_ready);\0A        pthread_mutex_unlock(&plum_sel_lock);\0A    }\0A    // Run destructors outside both locks: payloads may own channel ends.\0A    while (n) {\0A        plum_chan_node *next = n->next;\0A        if (rel) rel(*(void **)n->value);\0A        free(n->value);\0A        free(n);\0A        n = next;\0A    }\0A    if (!dead) return;\0A    pthread_mutex_destroy(&c->lock);\0A    pthread_cond_destroy(&c->ready);\0A    free(c);\0A}\0A\00" }
