@.str45740 = private global { i64, i64, [10787 x i8] } { i64 -1, i64 10786, [10787 x i8] c"/**\0A * \5Cfile ecp_internal_alt.h\0A *\0A * \5Cbrief Function declarations for alternative implementation of elliptic curve\0A * point arithmetic.\0A */\0A/*\0A *  Copyright The Mbed TLS Contributors\0A *  SPDX-License-Identifier: Apache-2.0 OR GPL-2.0-or-later\0A */\0A\0A/*\0A * References:\0A *\0A * [1] BERNSTEIN, Daniel J. Curve25519: new Diffie-Hellman speed records.\0A *     <http://cr.yp.to/ecdh/curve25519-20060209.pdf>\0A *\0A * [2] CORON, Jean-S'ebastien. Resistance against differential power analysis\0A *     for elliptic curve cryptosystems. In : Cryptographic Hardware and\0A *     Embedded Systems. Springer Berlin Heidelberg, 1999. p. 292-302.\0A *     <http://link.springer.com/chapter/10.1007/3-540-48059-5_25>\0A *\0A * [3] HEDABOU, Mustapha, PINEL, Pierre, et B'EN'ETEAU, Lucien. A comb method to\0A *     render ECC resistant against Side Channel Attacks. IACR Cryptology\0A *     ePrint Archive, 2004, vol. 2004, p. 342.\0A *     <http://eprint.iacr.org/2004/342.pdf>\0A *\0A * [4] Certicom Research. SEC 2: Recommended Elliptic Curve Domain Parameters.\0A *     <http://www.secg.org/sec2-v2.pdf>\0A *\0A * [5] HANKERSON, Darrel, MENEZES, Alfred J., VANSTONE, Scott. Guide to Elliptic\0A *     Curve Cryptography.\0A *\0A * [6] Digital Signature Standard (DSS), FIPS 186-4.\0A *     <http://nvlpubs.nist.gov/nistpubs/FIPS/NIST.FIPS.186-4.pdf>\0A *\0A * [7] Elliptic Curve Cryptography (ECC) Cipher Suites for Transport Layer\0A *     Security (TLS), RFC 4492.\0A *     <https://tools.ietf.org/search/rfc4492>\0A *\0A * [8] <http://www.hyperelliptic.org/EFD/g1p/auto-shortw-jacobian.html>\0A *\0A * [9] COHEN, Henri. A Course in Computational Algebraic Number Theory.\0A *     Springer Science & Business Media, 1 Aug 2000\0A */\0A\0A#ifndef MBEDTLS_ECP_INTERNAL_H\0A#define MBEDTLS_ECP_INTERNAL_H\0A\0A#include \22mbedtls/build_info.h\22\0A\0A#if defined(MBEDTLS_ECP_INTERNAL_ALT)\0A\0A/**\0A * \5Cbrief           Indicate if the Elliptic Curve Point module extension can\0A *                  handle the group.\0A *\0A * \5Cparam grp       The pointer to the elliptic curve group that will be the\0A *                  basis of the cryptographic computations.\0A *\0A * \5Creturn          Non-zero if successful.\0A */\0Aunsigned char mbedtls_internal_ecp_grp_capable(const mbedtls_ecp_group *grp);\0A\0A/**\0A * \5Cbrief           Initialise the Elliptic Curve Point module extension.\0A *\0A *                  If mbedtls_internal_ecp_grp_capable returns true for a\0A *                  group, this function has to be able to initialise the\0A *                  module for it.\0A *\0A *                  This module can be a driver to a crypto hardware\0A *                  accelerator, for which this could be an initialise function.\0A *\0A * \5Cparam grp       The pointer to the group the module needs to be\0A *                  initialised for.\0A *\0A * \5Creturn          0 if successful.\0A */\0Aint mbedtls_internal_ecp_init(const mbedtls_ecp_group *grp);\0A\0A/**\0A * \5Cbrief           Frees and deallocates the Elliptic Curve Point module\0A *                  extension.\0A *\0A * \5Cparam grp       The pointer to the group the module was initialised for.\0A */\0Avoid mbedtls_internal_ecp_free(const mbedtls_ecp_group *grp);\0A\0A#if defined(MBEDTLS_ECP_SHORT_WEIERSTRASS_ENABLED)\0A\0A#if defined(MBEDTLS_ECP_RANDOMIZE_JAC_ALT)\0A/**\0A * \5Cbrief           Randomize jacobian coordinates:\0A *                  (X, Y, Z) -> (l^2 X, l^3 Y, l Z) for random l.\0A *\0A * \5Cparam grp       Pointer to the group representing the curve.\0A *\0A * \5Cparam pt        The point on the curve to be randomised, given with Jacobian\0A *                  coordinates.\0A *\0A * \5Cparam f_rng     A function pointer to the random number generator.\0A *\0A * \5Cparam p_rng     A pointer to the random number generator state.\0A *\0A * \5Creturn          0 if successful.\0A */\0Aint mbedtls_internal_ecp_randomize_jac(const mbedtls_ecp_group *grp,\0A                                       mbedtls_ecp_point *pt, int (*f_rng)(void *,\0A                                                                           unsigned char *,\0A                                                                           size_t),\0A                                       void *p_rng);\0A#endif\0A\0A#if defined(MBEDTLS_ECP_ADD_MIXED_ALT)\0A/**\0A * \5Cbrief           Addition: R = P + Q, mixed affine-Jacobian coordinates.\0A *\0A *                  The coordinates of Q must be normalized (= affine),\0A *                  but those of P don't need to. R is not normalized.\0A *\0A *                  This function is used only as a subrutine of\0A *                  ecp_mul_comb().\0A *\0A *                  Special cases: (1) P or Q is zero, (2) R is zero,\0A *                      (3) P == Q.\0A *                  None of these cases can happen as intermediate step in\0A *                  ecp_mul_comb():\0A *                      - at each step, P, Q and R are multiples of the base\0A *                      point, the factor being less than its order, so none of\0A *                      them is zero;\0A *                      - Q is an odd multiple of the base point, P an even\0A *                      multiple, due to the choice of precomputed points in the\0A *                      modified comb method.\0A *                  So branches for these cases do not leak secret information.\0A *\0A *                  We accept Q->Z being unset (saving memory in tables) as\0A *                  meaning 1.\0A *\0A *                  Cost in field operations if done by [5] 3.22:\0A *                      1A := 8M + 3S\0A *\0A * \5Cparam grp       Pointer to the group representing the curve.\0A *\0A * \5Cparam R         Pointer to a point structure to hold the result.\0A *\0A * \5Cparam P         Pointer to the first summand, given with Jacobian\0A *                  coordinates\0A *\0A * \5Cparam Q         Pointer to the second summand, given with affine\0A *                  coordinates.\0A *\0A * \5Creturn          0 if successful.\0A */\0Aint mbedtls_internal_ecp_add_mixed(const mbedtls_ecp_group *grp,\0A                                   mbedtls_ecp_point *R, const mbedtls_ecp_point *P,\0A                                   const mbedtls_ecp_point *Q);\0A#endif\0A\0A/**\0A * \5Cbrief           Point doubling R = 2 P, Jacobian coordinates.\0A *\0A *                  Cost:   1D := 3M + 4S    (A ==  0)\0A *                          4M + 4S          (A == -3)\0A *                          3M + 6S + 1a     otherwise\0A *                  when the implementation is based on the \22dbl-1998-cmo-2\22\0A *                  doubling formulas in [8] and standard optimizations are\0A *                  applied when curve parameter A is one of { 0, -3 }.\0A *\0A * \5Cparam grp       Pointer to the group representing the curve.\0A *\0A * \5Cparam R         Pointer to a point structure to hold the result.\0A *\0A * \5Cparam P         Pointer to the point that has to be doubled, given with\0A *                  Jacobian coordinates.\0A *\0A * \5Creturn          0 if successful.\0A */\0A#if defined(MBEDTLS_ECP_DOUBLE_JAC_ALT)\0Aint mbedtls_internal_ecp_double_jac(const mbedtls_ecp_group *grp,\0A                                    mbedtls_ecp_point *R, const mbedtls_ecp_point *P);\0A#endif\0A\0A/**\0A * \5Cbrief           Normalize jacobian coordinates of an array of (pointers to)\0A *                  points.\0A *\0A *                  Using Montgomery's trick to perform only one inversion mod P\0A *                  the cost is:\0A *                      1N(t) := 1I + (6t - 3)M + 1S\0A *                  (See for example Algorithm 10.3.4. in [9])\0A *\0A *                  This function is used only as a subrutine of\0A *                  ecp_mul_comb().\0A *\0A *                  Warning: fails (returning an error) if one of the points is\0A *                  zero!\0A *                  This should never happen, see choice of w in ecp_mul_comb().\0A *\0A * \5Cparam grp       Pointer to the group representing the curve.\0A *\0A * \5Cparam T         Array of pointers to the points to normalise.\0A *\0A * \5Cparam t_len     Number of elements in the array.\0A *\0A * \5Creturn          0 if successful,\0A *                      an error if one of the points is zero.\0A */\0A#if defined(MBEDTLS_ECP_NORMALIZE_JAC_MANY_ALT)\0Aint mbedtls_internal_ecp_normalize_jac_many(const mbedtls_ecp_group *grp,\0A                                            mbedtls_ecp_point *T[], size_t t_len);\0A#endif\0A\0A/**\0A * \5Cbrief           Normalize jacobian coordinates so that Z == 0 || Z == 1.\0A *\0A *                  Cost in field operations if done by [5] 3.2.1:\0A *                      1N := 1I + 3M + 1S\0A *\0A * \5Cparam grp       Pointer to the group representing the curve.\0A *\0A * \5Cparam pt        pointer to the point to be normalised. This is an\0A *                  input/output parameter.\0A *\0A * \5Creturn          0 if successful.\0A */\0A#if defined(MBEDTLS_ECP_NORMALIZE_JAC_ALT)\0Aint mbedtls_internal_ecp_normalize_jac(const mbedtls_ecp_group *grp,\0A                                       mbedtls_ecp_point *pt);\0A#endif\0A\0A#endif /* MBEDTLS_ECP_SHORT_WEIERSTRASS_ENABLED */\0A\0A#if defined(MBEDTLS_ECP_MONTGOMERY_ENABLED)\0A\0A#if defined(MBEDTLS_ECP_DOUBLE_ADD_MXZ_ALT)\0Aint mbedtls_internal_ecp_double_add_mxz(const mbedtls_ecp_group *grp,\0A                                        mbedtls_ecp_point *R,\0A                                        mbedtls_ecp_point *S,\0A                                        const mbedtls_ecp_point *P,\0A                                        const mbedtls_ecp_point *Q,\0A                                        const mbedtls_mpi *d);\0A#endif\0A\0A/**\0A * \5Cbrief           Randomize projective x/z coordinates:\0A *                      (X, Z) -> (l X, l Z) for random l\0A *\0A * \5Cparam grp       pointer to the group representing the curve\0A *\0A * \5Cparam P         the point on the curve to be randomised given with\0A *                  projective coordinates. This is an input/output parameter.\0A *\0A * \5Cparam f_rng     a function pointer to the random number generator\0A *\0A * \5Cparam p_rng     a pointer to the random number generator state\0A *\0A * \5Creturn          0 if successful\0A */\0A#if defined(MBEDTLS_ECP_RANDOMIZE_MXZ_ALT)\0Aint mbedtls_internal_ecp_randomize_mxz(const mbedtls_ecp_group *grp,\0A                                       mbedtls_ecp_point *P, int (*f_rng)(void *,\0A                                                                          unsigned char *,\0A                                                                          size_t),\0A                                       void *p_rng);\0A#endif\0A\0A/**\0A * \5Cbrief           Normalize Montgomery x/z coordinates: X = X/Z, Z = 1.\0A *\0A * \5Cparam grp       pointer to the group representing the curve\0A *\0A * \5Cparam P         pointer to the point to be normalised. This is an\0A *                  input/output parameter.\0A *\0A * \5Creturn          0 if successful\0A */\0A#if defined(MBEDTLS_ECP_NORMALIZE_MXZ_ALT)\0Aint mbedtls_internal_ecp_normalize_mxz(const mbedtls_ecp_group *grp,\0A                                       mbedtls_ecp_point *P);\0A#endif\0A\0A#endif /* MBEDTLS_ECP_MONTGOMERY_ENABLED */\0A\0A#endif /* MBEDTLS_ECP_INTERNAL_ALT */\0A\0A#endif /* ecp_internal_alt.h */\0A\00" }
