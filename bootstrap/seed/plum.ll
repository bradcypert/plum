long removed=0; time_t now=time(NULL);\0A    char parent[PLUM_PATH_MAX], path[PLUM_PATH_MAX]; struct stat st;\0A    for (size_t k=0;k<3;k++) {\0A        if (plum_join(parent,sizeof(parent),root,kinds[k]) != 0\0A            || plum_cache_stat_private(parent,&st) != 0 || !S_ISDIR(st.st_mode)) continue;\0A        DIR *d=opendir(parent); if (!d) continue;\0A        struct dirent *e;\0A        while ((e=readdir(d)) != NULL) {\0A            if (plum_join(path,sizeof(path),parent,e->d_name) != 0\0A                || plum_cache_stat_private(path,&st) != 0 || !S_ISDIR(st.st_mode)) continue;\0A            // Windows GetTempFileName uses pcb*.tmp; POSIX uses .partial-*.\0A            if (!strncmp(e->d_name,\22.partial-\22,9) || !strncmp(e->d_name,\22pcb\22,3)) {\0A                if (now > st.st_mtime && now-st.st_mtime > 86400 && plum_cache_owner_gone(path)) {\0A                    if (plum_remove_tree(path) == 0) removed++;\0A                }\0A                continue;\0A            }\0A            if (strlen(e->d_name) != 64) continue;\0A            int hex=1;\0A            for (size_t i=0;i<64;i++) {\0A                if (!((e->d_name[i]>='0' && e->d_name[i]<='9')\0A                    || (e->d_name[i]>='a' && e->d_name[i]<='f'))) { hex=0; break; }\0A            }\0A            if (!hex) continue;\0A            if (count == capacity) {\0A                size_t next=capacity ? capacity*2 : 32;\0A                plum_cache_entry *grown=realloc(entries,next*sizeof(*entries));\0A                if (!grown) break;\0A                entries=grown; capacity=next;\0A            }\0A            char *saved=strdup(path); if (!saved) break;\0A            uint64_t bytes=plum_cache_tree_bytes(path);\0A            entries[count++]=(plum_cache_entry){saved,bytes,st.st_mtime}; total+=bytes;\0A        }\0A        closedir(d);\0A    }\0A    if (count > 1) qsort(entries,count,sizeof(*entries),plum_cache_oldest);\0A    for (size_t i=0;i<count;i++) {\0A        if (total > (uint64_t)limit && plum_remove_tree(entries[i].path) == 0) {\0A            total=total >= entries[i].bytes ? total-entries[i].bytes : 0; removed++;\0A        }\0A        free(entries[i].path);\0A    }\0A    free(entries); return removed;\0A}\0A\0A// Three-way, and the third case is the point: 1 present, 0 absent, -1\0A// CANNOT SAY.\0A//\0A// \22Does this exist\22 and \22can I see whether this exists\22 are different\0A// questions, and collapsing them is how a permission error becomes a\0A// silent \22no\22. Only `ENOENT` and `ENOTDIR` mean absent -- the latter\0A// because a path under a non-directory (`a/b` where `a` is a file)\0A// cannot exist either. Anything else is a real failure to report.\0Along long os_path_exists(const char *path) {\0A    struct stat st;\0A    if (stat(path, &st) == 0) {\0A        return 1;\0A    }\0A    if (errno == ENOENT || errno == ENOTDIR) {\0A        return 0;\0A    }\0A    return -1;\0A}\0A\0A// --- Working directory (issue #17) ---\0A//\0A// Its own buffer rather than `plum_os_buf`: that one holds the result of\0A// `os_temp_dir`/`os_self_exe`, and a caller holding one of those across\0A// a `cwd()` would silently get the wrong string back.\0Astatic char plum_cwd_buf[PLUM_PATH_MAX];\0A\0A// \22\22 on failure, never NULL -- a null `CStr` return is a hard runtime\0A// abort under Plum's FFI semantics, the same trade every other shim\0A// here makes.\0Aconst char *os_cwd(void) {\0A#if defined(_WIN32)\0A    if (_getcwd(plum_cwd_buf, (int)sizeof(plum_cwd_buf)) == NULL) plum_cwd_buf[0] = '\5C0';\0A#else\0A    if (getcwd(plum_cwd_buf, sizeof(plum_cwd_buf)) == NULL) plum_cwd_buf[0] = '\5C0';\0A#endif\0A    return plum_cwd_buf;\0A}\0A\0Along long os_chdir(const char *path) {\0A#if defined(_WIN32)\0A    return _chdir(path) == 0 ? 0 : -1;\0A#else\0A    return chdir(path) == 0 ? 0 : -1;\0A#endif\0A}\0A\00" }
