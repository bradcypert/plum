@.str45157 = private global { i64, i64, [12273 x i8] } { i64 -1, i64 12272, [12273 x i8] c"/*\0A *  PSA crypto support for secure element drivers\0A */\0A/*\0A *  Copyright The Mbed TLS Contributors\0A *  SPDX-License-Identifier: Apache-2.0 OR GPL-2.0-or-later\0A */\0A\0A#include \22common.h\22\0A\0A#if defined(MBEDTLS_PSA_CRYPTO_SE_C)\0A\0A#include <stdint.h>\0A#include <string.h>\0A\0A#include \22psa/crypto_se_driver.h\22\0A\0A#include \22psa_crypto_se.h\22\0A\0A#if defined(MBEDTLS_PSA_ITS_FILE_C)\0A#include \22psa_crypto_its.h\22\0A#else /* Native ITS implementation */\0A#include \22psa/error.h\22\0A#include \22psa/internal_trusted_storage.h\22\0A#endif\0A\0A#include \22mbedtls/platform.h\22\0A\0A\0A\0A/****************************************************************/\0A/* Driver lookup */\0A/****************************************************************/\0A\0A/* This structure is identical to psa_drv_se_context_t declared in\0A * `crypto_se_driver.h`, except that some parts are writable here\0A * (non-const, or pointer to non-const). */\0Atypedef struct {\0A    void *persistent_data;\0A    size_t persistent_data_size;\0A    uintptr_t transient_data;\0A} psa_drv_se_internal_context_t;\0A\0Astruct psa_se_drv_table_entry_s {\0A    psa_key_location_t location;\0A    const psa_drv_se_t *methods;\0A    union {\0A        psa_drv_se_internal_context_t internal;\0A        psa_drv_se_context_t context;\0A    } u;\0A};\0A\0Astatic psa_se_drv_table_entry_t driver_table[PSA_MAX_SE_DRIVERS];\0A\0Apsa_se_drv_table_entry_t *psa_get_se_driver_entry(\0A    psa_key_lifetime_t lifetime)\0A{\0A    size_t i;\0A    psa_key_location_t location = PSA_KEY_LIFETIME_GET_LOCATION(lifetime);\0A    /* In the driver table, location=0 means an entry that isn't used.\0A     * No driver has a location of 0 because it's a reserved value\0A     * (which designates transparent keys). Make sure we never return\0A     * a driver entry for location 0. */\0A    if (location == 0) {\0A        return NULL;\0A    }\0A    for (i = 0; i < PSA_MAX_SE_DRIVERS; i++) {\0A        if (driver_table[i].location == location) {\0A            return &driver_table[i];\0A        }\0A    }\0A    return NULL;\0A}\0A\0Aconst psa_drv_se_t *psa_get_se_driver_methods(\0A    const psa_se_drv_table_entry_t *driver)\0A{\0A    return driver->methods;\0A}\0A\0Apsa_drv_se_context_t *psa_get_se_driver_context(\0A    psa_se_drv_table_entry_t *driver)\0A{\0A    return &driver->u.context;\0A}\0A\0Aint psa_get_se_driver(psa_key_lifetime_t lifetime,\0A                      const psa_drv_se_t **p_methods,\0A                      psa_drv_se_context_t **p_drv_context)\0A{\0A    psa_se_drv_table_entry_t *driver = psa_get_se_driver_entry(lifetime);\0A    if (p_methods != NULL) {\0A        *p_methods = (driver ? driver->methods : NULL);\0A    }\0A    if (p_drv_context != NULL) {\0A        *p_drv_context = (driver ? &driver->u.context : NULL);\0A    }\0A    return driver != NULL;\0A}\0A\0A\0A\0A/****************************************************************/\0A/* Persistent data management */\0A/****************************************************************/\0A\0Astatic psa_status_t psa_get_se_driver_its_file_uid(\0A    const psa_se_drv_table_entry_t *driver,\0A    psa_storage_uid_t *uid)\0A{\0A    if (driver->location > PSA_MAX_SE_LOCATION) {\0A        return PSA_ERROR_NOT_SUPPORTED;\0A    }\0A\0A    /* ITS file sizes are limited to 32 bits. */\0A    if (driver->u.internal.persistent_data_size > UINT32_MAX) {\0A        return PSA_ERROR_NOT_SUPPORTED;\0A    }\0A\0A    /* See the documentation of PSA_CRYPTO_SE_DRIVER_ITS_UID_BASE. */\0A    *uid = PSA_CRYPTO_SE_DRIVER_ITS_UID_BASE + driver->location;\0A    return PSA_SUCCESS;\0A}\0A\0Apsa_status_t psa_load_se_persistent_data(\0A    const psa_se_drv_table_entry_t *driver)\0A{\0A    psa_status_t status;\0A    psa_storage_uid_t uid;\0A    size_t length;\0A\0A    status = psa_get_se_driver_its_file_uid(driver, &uid);\0A    if (status != PSA_SUCCESS) {\0A        return status;\0A    }\0A\0A    /* Read the amount of persistent data that the driver requests.\0A     * If the data in storage is larger, it is truncated. If the data\0A     * in storage is smaller, silently keep what is already at the end\0A     * of the output buffer. */\0A    /* psa_get_se_driver_its_file_uid ensures that the size_t\0A     * persistent_data_size is in range, but compilers don't know that,\0A     * so cast to reassure them. */\0A    return psa_its_get(uid, 0,\0A                       (uint32_t) driver->u.internal.persistent_data_size,\0A                       driver->u.internal.persistent_data,\0A                       &length);\0A}\0A\0Apsa_status_t psa_save_se_persistent_data(\0A    const psa_se_drv_table_entry_t *driver)\0A{\0A    psa_status_t status;\0A    psa_storage_uid_t uid;\0A\0A    status = psa_get_se_driver_its_file_uid(driver, &uid);\0A    if (status != PSA_SUCCESS) {\0A        return status;\0A    }\0A\0A    /* psa_get_se_driver_its_file_uid ensures that the size_t\0A     * persistent_data_size is in range, but compilers don't know that,\0A     * so cast to reassure them. */\0A    return psa_its_set(uid,\0A                       (uint32_t) driver->u.internal.persistent_data_size,\0A                       driver->u.internal.persistent_data,\0A                       0);\0A}\0A\0Apsa_status_t psa_destroy_se_persistent_data(psa_key_location_t location)\0A{\0A    psa_storage_uid_t uid;\0A    if (location > PSA_MAX_SE_LOCATION) {\0A        return PSA_ERROR_NOT_SUPPORTED;\0A    }\0A    uid = PSA_CRYPTO_SE_DRIVER_ITS_UID_BASE + location;\0A    return psa_its_remove(uid);\0A}\0A\0Apsa_status_t psa_find_se_slot_for_key(\0A    const psa_key_attributes_t *attributes,\0A    psa_key_creation_method_t method,\0A    psa_se_drv_table_entry_t *driver,\0A    psa_key_slot_number_t *slot_number)\0A{\0A    psa_status_t status;\0A    psa_key_location_t key_location =\0A        PSA_KEY_LIFETIME_GET_LOCATION(psa_get_key_lifetime(attributes));\0A\0A    /* If the location is wrong, it's a bug in the library. */\0A    if (driver->location != key_location) {\0A        return PSA_ERROR_CORRUPTION_DETECTED;\0A    }\0A\0A    /* If the driver doesn't support key creation in any way, give up now. */\0A    if (driver->methods->key_management == NULL) {\0A        return PSA_ERROR_NOT_SUPPORTED;\0A    }\0A\0A    if (psa_get_key_slot_number(attributes, slot_number) == PSA_SUCCESS) {\0A        /* The application wants to use a specific slot. Allow it if\0A         * the driver supports it. On a system with isolation,\0A         * the crypto service must check that the application is\0A         * permitted to request this slot. */\0A        psa_drv_se_validate_slot_number_t p_validate_slot_number =\0A            driver->methods->key_management->p_validate_slot_number;\0A        if (p_validate_slot_number == NULL) {\0A            return PSA_ERROR_NOT_SUPPORTED;\0A        }\0A        status = p_validate_slot_number(&driver->u.context,\0A                                        driver->u.internal.persistent_data,\0A                                        attributes, method,\0A                                        *slot_number);\0A    } else if (method == PSA_KEY_CREATION_REGISTER) {\0A        /* The application didn't specify a slot number. This doesn't\0A         * make sense when registering a slot. */\0A        return PSA_ERROR_INVALID_ARGUMENT;\0A    } else {\0A        /* The application didn't tell us which slot to use. Let the driver\0A         * choose. This is the normal case. */\0A        psa_drv_se_allocate_key_t p_allocate =\0A            driver->methods->key_management->p_allocate;\0A        if (p_allocate == NULL) {\0A            return PSA_ERROR_NOT_SUPPORTED;\0A        }\0A        status = p_allocate(&driver->u.context,\0A                            driver->u.internal.persistent_data,\0A                            attributes, method,\0A                            slot_number);\0A    }\0A    return status;\0A}\0A\0Apsa_status_t psa_destroy_se_key(psa_se_drv_table_entry_t *driver,\0A                                psa_key_slot_number_t slot_number)\0A{\0A    psa_status_t status;\0A    psa_status_t storage_status;\0A    /* Normally a missing method would mean that the action is not\0A     * supported. But psa_destroy_key() is not supposed to return\0A     * PSA_ERROR_NOT_SUPPORTED: if you can create a key, you should\0A     * be able to destroy it. The only use case for a driver that\0A     * does not have a way to destroy keys at all is if the keys are\0A     * locked in a read-only state: we can use the keys but not\0A     * destroy them. Hence, if the driver doesn't support destroying\0A     * keys, it's really a lack of permission. */\0A    if (driver->methods->key_management == NULL ||\0A        driver->methods->key_management->p_destroy == NULL) {\0A        return PSA_ERROR_NOT_PERMITTED;\0A    }\0A    status = driver->methods->key_management->p_destroy(\0A        &driver->u.context,\0A        driver->u.internal.persistent_data,\0A        slot_number);\0A    storage_status = psa_save_se_persistent_data(driver);\0A    return status == PSA_SUCCESS ? storage_status : status;\0A}\0A\0Apsa_status_t psa_init_all_se_drivers(void)\0A{\0A    size_t i;\0A    for (i = 0; i < PSA_MAX_SE_DRIVERS; i++) {\0A        psa_se_drv_table_entry_t *driver = &driver_table[i];\0A        if (driver->location == 0) {\0A            continue; /* skipping unused entry */\0A        }\0A        const psa_drv_se_t *methods = psa_get_se_driver_methods(driver);\0A        if (methods->p_init != NULL) {\0A            psa_status_t status = methods->p_init(\0A                &driver->u.context,\0A                driver->u.internal.persistent_data,\0A                driver->location);\0A            if (status != PSA_SUCCESS) {\0A                return status;\0A            }\0A            status = psa_save_se_persistent_data(driver);\0A            if (status != PSA_SUCCESS) {\0A                return status;\0A            }\0A        }\0A    }\0A    return PSA_SUCCESS;\0A}\0A\0A\0A\0A/****************************************************************/\0A/* Driver registration */\0A/****************************************************************/\0A\0Apsa_status_t psa_register_se_driver(\0A    psa_key_location_t location,\0A    const psa_drv_se_t *methods)\0A{\0A    size_t i;\0A    psa_status_t status;\0A\0A    if (methods->hal_version != PSA_DRV_SE_HAL_VERSION) {\0A        return PSA_ERROR_NOT_SUPPORTED;\0A    }\0A    /* Driver table entries are 0-initialized. 0 is not a valid driver\0A     * location because it means a transparent key. */\0A    MBEDTLS_STATIC_ASSERT(PSA_KEY_LOCATION_LOCAL_STORAGE == 0,\0A                          \22Secure element support requires 0 to mean a local key\22);\0A\0A    if (location == PSA_KEY_LOCATION_LOCAL_STORAGE) {\0A        return PSA_ERROR_INVALID_ARGUMENT;\0A    }\0A    if (location > PSA_MAX_SE_LOCATION) {\0A        return PSA_ERROR_NOT_SUPPORTED;\0A    }\0A\0A    for (i = 0; i < PSA_MAX_SE_DRIVERS; i++) {\0A        if (driver_table[i].location == 0) {\0A            break;\0A        }\0A        /* Check that location isn't already in use up to the first free\0A         * entry. Since entries are created in order and never deleted,\0A         * there can't be a used entry after the first free entry. */\0A        if (driver_table[i].location == location) {\0A            return PSA_ERROR_ALREADY_EXISTS;\0A        }\0A    }\0A    if (i == PSA_MAX_SE_DRIVERS) {\0A        return PSA_ERROR_INSUFFICIENT_MEMORY;\0A    }\0A\0A    driver_table[i].location = location;\0A    driver_table[i].methods = methods;\0A    driver_table[i].u.internal.persistent_data_size =\0A        methods->persistent_data_size;\0A\0A    if (methods->persistent_data_size != 0) {\0A        driver_table[i].u.internal.persistent_data =\0A            mbedtls_calloc(1, methods->persistent_data_size);\0A        if (driver_table[i].u.internal.persistent_data == NULL) {\0A            status = PSA_ERROR_INSUFFICIENT_MEMORY;\0A            goto error;\0A        }\0A        /* Load the driver's persistent data. On first use, the persistent\0A         * data does not exist in storage, and is initialized to\0A         * all-bits-zero by the calloc call just above. */\0A        status = psa_load_se_persistent_data(&driver_table[i]);\0A        if (status != PSA_SUCCESS && status != PSA_ERROR_DOES_NOT_EXIST) {\0A            goto error;\0A        }\0A    }\0A\0A    return PSA_SUCCESS;\0A\0Aerror:\0A    memset(&driver_table[i], 0, sizeof(driver_table[i]));\0A    return status;\0A}\0A\0Avoid psa_unregister_all_se_drivers(void)\0A{\0A    size_t i;\0A    for (i = 0; i < PSA_MAX_SE_DRIVERS; i++) {\0A        if (driver_table[i].u.internal.persistent_data != NULL) {\0A            mbedtls_free(driver_table[i].u.internal.persistent_data);\0A        }\0A    }\0A    memset(driver_table, 0, sizeof(driver_table));\0A}\0A\0A\0A\0A/****************************************************************/\0A/* The end */\0A/****************************************************************/\0A\0A#endif /* MBEDTLS_PSA_CRYPTO_SE_C */\0A\00" }
