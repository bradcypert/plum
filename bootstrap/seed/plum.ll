@.str42258 = private global { i64, i64, [14573 x i8] } { i64 -1, i64 14572, [14573 x i8] c"/*\0A *  Debugging routines\0A *\0A *  Copyright The Mbed TLS Contributors\0A *  SPDX-License-Identifier: Apache-2.0 OR GPL-2.0-or-later\0A */\0A\0A#include \22common.h\22\0A\0A#if defined(MBEDTLS_DEBUG_C)\0A\0A#include \22mbedtls/platform.h\22\0A\0A#include \22debug_internal.h\22\0A#include \22mbedtls/error.h\22\0A\0A#include <stdarg.h>\0A#include <stdio.h>\0A#include <string.h>\0A\0A/* DEBUG_BUF_SIZE must be at least 2 */\0A#define DEBUG_BUF_SIZE      512\0A\0Astatic int debug_threshold = 0;\0A\0Avoid mbedtls_debug_set_threshold(int threshold)\0A{\0A    debug_threshold = threshold;\0A}\0A\0A/*\0A * All calls to f_dbg must be made via this function\0A */\0Astatic inline void debug_send_line(const mbedtls_ssl_context *ssl, int level,\0A                                   const char *file, int line,\0A                                   const char *str)\0A{\0A    /*\0A     * If in a threaded environment, we need a thread identifier.\0A     * Since there is no portable way to get one, use the address of the ssl\0A     * context instead, as it shouldn't be shared between threads.\0A     */\0A#if defined(MBEDTLS_THREADING_C)\0A    char idstr[20 + DEBUG_BUF_SIZE]; /* 0x + 16 nibbles + ': ' */\0A    mbedtls_snprintf(idstr, sizeof(idstr), \22%p: %s\22, (void *) ssl, str);\0A    ssl->conf->f_dbg(ssl->conf->p_dbg, level, file, line, idstr);\0A#else\0A    ssl->conf->f_dbg(ssl->conf->p_dbg, level, file, line, str);\0A#endif\0A}\0A\0AMBEDTLS_PRINTF_ATTRIBUTE(5, 6)\0Avoid mbedtls_debug_print_msg(const mbedtls_ssl_context *ssl, int level,\0A                             const char *file, int line,\0A                             const char *format, ...)\0A{\0A    va_list argp;\0A    char str[DEBUG_BUF_SIZE];\0A    int ret = MBEDTLS_ERR_ERROR_CORRUPTION_DETECTED;\0A\0A    MBEDTLS_STATIC_ASSERT(DEBUG_BUF_SIZE >= 2, \22DEBUG_BUF_SIZE too small\22);\0A\0A    if (NULL == ssl              ||\0A        NULL == ssl->conf        ||\0A        NULL == ssl->conf->f_dbg ||\0A        level > debug_threshold) {\0A        return;\0A    }\0A\0A    va_start(argp, format);\0A    ret = mbedtls_vsnprintf(str, DEBUG_BUF_SIZE, format, argp);\0A    va_end(argp);\0A\0A    if (ret < 0) {\0A        ret = 0;\0A    } else {\0A        if (ret >= DEBUG_BUF_SIZE - 1) {\0A            ret = DEBUG_BUF_SIZE - 2;\0A        }\0A    }\0A    str[ret]     = '\5Cn';\0A    str[ret + 1] = '\5C0';\0A\0A    debug_send_line(ssl, level, file, line, str);\0A}\0A\0Avoid mbedtls_debug_print_ret(const mbedtls_ssl_context *ssl, int level,\0A                             const char *file, int line,\0A                             const char *text, int ret)\0A{\0A    char str[DEBUG_BUF_SIZE];\0A\0A    if (NULL == ssl              ||\0A        NULL == ssl->conf        ||\0A        NULL == ssl->conf->f_dbg ||\0A        level > debug_threshold) {\0A        return;\0A    }\0A\0A    /*\0A     * With non-blocking I/O and examples that just retry immediately,\0A     * the logs would be quickly flooded with WANT_READ, so ignore that.\0A     * Don't ignore WANT_WRITE however, since it is usually rare.\0A     */\0A    if (ret == MBEDTLS_ERR_SSL_WANT_READ) {\0A        return;\0A    }\0A\0A    mbedtls_snprintf(str, sizeof(str), \22%s() returned %d (-0x%04x)\5Cn\22,\0A                     text, ret, (unsigned int) -ret);\0A\0A    debug_send_line(ssl, level, file, line, str);\0A}\0A\0Avoid mbedtls_debug_print_buf(const mbedtls_ssl_context *ssl, int level,\0A                             const char *file, int line, const char *text,\0A                             const unsigned char *buf, size_t len)\0A{\0A    char str[DEBUG_BUF_SIZE];\0A    char txt[17];\0A    size_t i, idx = 0;\0A\0A    if (NULL == ssl              ||\0A        NULL == ssl->conf        ||\0A        NULL == ssl->conf->f_dbg ||\0A        level > debug_threshold) {\0A        return;\0A    }\0A\0A    mbedtls_snprintf(str + idx, sizeof(str) - idx, \22dumping '%s' (%u bytes)\5Cn\22,\0A                     text, (unsigned int) len);\0A\0A    debug_send_line(ssl, level, file, line, str);\0A\0A    memset(txt, 0, sizeof(txt));\0A    for (i = 0; i < len; i++) {\0A        if (i >= 4096) {\0A            break;\0A        }\0A\0A        if (i % 16 == 0) {\0A            if (i > 0) {\0A                mbedtls_snprintf(str + idx, sizeof(str) - idx, \22  %s\5Cn\22, txt);\0A                debug_send_line(ssl, level, file, line, str);\0A\0A                idx = 0;\0A                memset(txt, 0, sizeof(txt));\0A            }\0A\0A            idx += mbedtls_snprintf(str + idx, sizeof(str) - idx, \22%04x: \22,\0A                                    (unsigned int) i);\0A\0A        }\0A\0A        idx += mbedtls_snprintf(str + idx, sizeof(str) - idx, \22 %02x\22,\0A                                (unsigned int) buf[i]);\0A        txt[i % 16] = (buf[i] > 31 && buf[i] < 127) ? buf[i] : '.';\0A    }\0A\0A    if (len > 0) {\0A        for (/* i = i */; i % 16 != 0; i++) {\0A            idx += mbedtls_snprintf(str + idx, sizeof(str) - idx, \22   \22);\0A        }\0A\0A        mbedtls_snprintf(str + idx, sizeof(str) - idx, \22  %s\5Cn\22, txt);\0A        debug_send_line(ssl, level, file, line, str);\0A    }\0A}\0A\0A#if defined(MBEDTLS_ECP_LIGHT)\0Avoid mbedtls_debug_print_ecp(const mbedtls_ssl_context *ssl, int level,\0A                             const char *file, int line,\0A                             const char *text, const mbedtls_ecp_point *X)\0A{\0A    char str[DEBUG_BUF_SIZE];\0A\0A    if (NULL == ssl              ||\0A        NULL == ssl->conf        ||\0A        NULL == ssl->conf->f_dbg ||\0A        level > debug_threshold) {\0A        return;\0A    }\0A\0A    mbedtls_snprintf(str, sizeof(str), \22%s(X)\22, text);\0A    mbedtls_debug_print_mpi(ssl, level, file, line, str, &X->X);\0A\0A    mbedtls_snprintf(str, sizeof(str), \22%s(Y)\22, text);\0A    mbedtls_debug_print_mpi(ssl, level, file, line, str, &X->Y);\0A}\0A#endif /* MBEDTLS_ECP_LIGHT */\0A\0A#if defined(MBEDTLS_PK_USE_PSA_EC_DATA)\0Astatic void mbedtls_debug_print_ec_coord(const mbedtls_ssl_context *ssl, int level,\0A                                         const char *file, int line, const char *text,\0A                                         const unsigned char *buf, size_t len)\0A{\0A    char str[DEBUG_BUF_SIZE];\0A    size_t i, idx = 0;\0A\0A    mbedtls_snprintf(str + idx, sizeof(str) - idx, \22value of '%s' (%u bits) is:\5Cn\22,\0A                     text, (unsigned int) len * 8);\0A\0A    debug_send_line(ssl, level, file, line, str);\0A\0A    for (i = 0; i < len; i++) {\0A        if (i >= 4096) {\0A            break;\0A        }\0A\0A        if (i % 16 == 0) {\0A            if (i > 0) {\0A                mbedtls_snprintf(str + idx, sizeof(str) - idx, \22\5Cn\22);\0A                debug_send_line(ssl, level, file, line, str);\0A\0A                idx = 0;\0A            }\0A        }\0A\0A        idx += mbedtls_snprintf(str + idx, sizeof(str) - idx, \22 %02x\22,\0A                                (unsigned int) buf[i]);\0A    }\0A\0A    if (len > 0) {\0A        for (/* i = i */; i % 16 != 0; i++) {\0A            idx += mbedtls_snprintf(str + idx, sizeof(str) - idx, \22   \22);\0A        }\0A\0A        mbedtls_snprintf(str + idx, sizeof(str) - idx, \22\5Cn\22);\0A        debug_send_line(ssl, level, file, line, str);\0A    }\0A}\0A\0Avoid mbedtls_debug_print_psa_ec(const mbedtls_ssl_context *ssl, int level,\0A                                const char *file, int line,\0A                                const char *text, const mbedtls_pk_context *pk)\0A{\0A    char str[DEBUG_BUF_SIZE];\0A    const uint8_t *coord_start;\0A    size_t coord_len;\0A\0A    if (NULL == ssl              ||\0A        NULL == ssl->conf        ||\0A        NULL == ssl->conf->f_dbg ||\0A        level > debug_threshold) {\0A        return;\0A    }\0A\0A    /* For the description of pk->pk_raw content please refer to the description\0A     * psa_export_public_key() function. */\0A    coord_len = (pk->pub_raw_len - 1)/2;\0A\0A    /* X coordinate */\0A    coord_start = pk->pub_raw + 1;\0A    mbedtls_snprintf(str, sizeof(str), \22%s(X)\22, text);\0A    mbedtls_debug_print_ec_coord(ssl, level, file, line, str, coord_start, coord_len);\0A\0A    /* Y coordinate */\0A    coord_start = coord_start + coord_len;\0A    mbedtls_snprintf(str, sizeof(str), \22%s(Y)\22, text);\0A    mbedtls_debug_print_ec_coord(ssl, level, file, line, str, coord_start, coord_len);\0A}\0A#endif /* MBEDTLS_PK_USE_PSA_EC_DATA */\0A\0A#if defined(MBEDTLS_BIGNUM_C)\0Avoid mbedtls_debug_print_mpi(const mbedtls_ssl_context *ssl, int level,\0A                             const char *file, int line,\0A                             const char *text, const mbedtls_mpi *X)\0A{\0A    char str[DEBUG_BUF_SIZE];\0A    size_t bitlen;\0A    size_t idx = 0;\0A\0A    if (NULL == ssl              ||\0A        NULL == ssl->conf        ||\0A        NULL == ssl->conf->f_dbg ||\0A        NULL == X                ||\0A        level > debug_threshold) {\0A        return;\0A    }\0A\0A    bitlen = mbedtls_mpi_bitlen(X);\0A\0A    mbedtls_snprintf(str, sizeof(str), \22value of '%s' (%u bits) is:\5Cn\22,\0A                     text, (unsigned) bitlen);\0A    debug_send_line(ssl, level, file, line, str);\0A\0A    if (bitlen == 0) {\0A        str[0] = ' '; str[1] = '0'; str[2] = '0';\0A        idx = 3;\0A    } else {\0A        int n;\0A        for (n = (int) ((bitlen - 1) / 8); n >= 0; n--) {\0A            size_t limb_offset = n / sizeof(mbedtls_mpi_uint);\0A            size_t offset_in_limb = n % sizeof(mbedtls_mpi_uint);\0A            unsigned char octet =\0A                (X->p[limb_offset] >> (offset_in_limb * 8)) & 0xff;\0A            mbedtls_snprintf(str + idx, sizeof(str) - idx, \22 %02x\22, octet);\0A            idx += 3;\0A            /* Wrap lines after 16 octets that each take 3 columns */\0A            if (idx >= 3 * 16) {\0A                mbedtls_snprintf(str + idx, sizeof(str) - idx, \22\5Cn\22);\0A                debug_send_line(ssl, level, file, line, str);\0A                idx = 0;\0A            }\0A        }\0A    }\0A\0A    if (idx != 0) {\0A        mbedtls_snprintf(str + idx, sizeof(str) - idx, \22\5Cn\22);\0A        debug_send_line(ssl, level, file, line, str);\0A    }\0A}\0A#endif /* MBEDTLS_BIGNUM_C */\0A\0A#if defined(MBEDTLS_X509_CRT_PARSE_C) && !defined(MBEDTLS_X509_REMOVE_INFO)\0Astatic void debug_print_pk(const mbedtls_ssl_context *ssl, int level,\0A                           const char *file, int line,\0A                           const char *text, const mbedtls_pk_context *pk)\0A{\0A    size_t i;\0A    mbedtls_pk_debug_item items[MBEDTLS_PK_DEBUG_MAX_ITEMS];\0A    char name[16];\0A\0A    memset(items, 0, sizeof(items));\0A\0A    if (mbedtls_pk_debug(pk, items) != 0) {\0A        debug_send_line(ssl, level, file, line,\0A                        \22invalid PK context\5Cn\22);\0A        return;\0A    }\0A\0A    for (i = 0; i < MBEDTLS_PK_DEBUG_MAX_ITEMS; i++) {\0A        if (items[i].type == MBEDTLS_PK_DEBUG_NONE) {\0A            return;\0A        }\0A\0A        mbedtls_snprintf(name, sizeof(name), \22%s%s\22, text, items[i].name);\0A        name[sizeof(name) - 1] = '\5C0';\0A\0A#if defined(MBEDTLS_RSA_C)\0A        if (items[i].type == MBEDTLS_PK_DEBUG_MPI) {\0A            mbedtls_debug_print_mpi(ssl, level, file, line, name, items[i].value);\0A        } else\0A#endif /* MBEDTLS_RSA_C */\0A#if defined(MBEDTLS_ECP_LIGHT)\0A        if (items[i].type == MBEDTLS_PK_DEBUG_ECP) {\0A            mbedtls_debug_print_ecp(ssl, level, file, line, name, items[i].value);\0A        } else\0A#endif /* MBEDTLS_ECP_LIGHT */\0A#if defined(MBEDTLS_PK_USE_PSA_EC_DATA)\0A        if (items[i].type == MBEDTLS_PK_DEBUG_PSA_EC) {\0A            mbedtls_debug_print_psa_ec(ssl, level, file, line, name, items[i].value);\0A        } else\0A#endif /* MBEDTLS_PK_USE_PSA_EC_DATA */\0A        { debug_send_line(ssl, level, file, line,\0A                          \22should not happen\5Cn\22); }\0A    }\0A}\0A\0Astatic void debug_print_line_by_line(const mbedtls_ssl_context *ssl, int level,\0A                                     const char *file, int line, const char *text)\0A{\0A    char str[DEBUG_BUF_SIZE];\0A    const char *start, *cur;\0A\0A    start = text;\0A    for (cur = text; *cur != '\5C0'; cur++) {\0A        if (*cur == '\5Cn') {\0A            size_t len = (size_t) (cur - start) + 1;\0A            if (len > DEBUG_BUF_SIZE - 1) {\0A                len = DEBUG_BUF_SIZE - 1;\0A            }\0A\0A            memcpy(str, start, len);\0A            str[len] = '\5C0';\0A\0A            debug_send_line(ssl, level, file, line, str);\0A\0A            start = cur + 1;\0A        }\0A    }\0A}\0A\0Avoid mbedtls_debug_print_crt(const mbedtls_ssl_context *ssl, int level,\0A                             const char *file, int line,\0A                             const char *text, const mbedtls_x509_crt *crt)\0A{\0A    char str[DEBUG_BUF_SIZE];\0A    int i = 0;\0A\0A    if (NULL == ssl              ||\0A        NULL == ssl->conf        ||\0A        NULL == ssl->conf->f_dbg ||\0A        NULL == crt              ||\0A        level > debug_threshold) {\0A        return;\0A    }\0A\0A    while (crt != NULL) {\0A        char buf[1024];\0A\0A        mbedtls_snprintf(str, sizeof(str), \22%s #%d:\5Cn\22, text, ++i);\0A        debug_send_line(ssl, level, file, line, str);\0A\0A        mbedtls_x509_crt_info(buf, sizeof(buf) - 1, \22\22, crt);\0A        debug_print_line_by_line(ssl, level, file, line, buf);\0A\0A        debug_print_pk(ssl, level, file, line, \22crt->\22, &crt->pk);\0A\0A        crt = crt->next;\0A    }\0A}\0A#endif /* MBEDTLS_X509_CRT_PARSE_C && MBEDTLS_X509_REMOVE_INFO */\0A\0A#if defined(MBEDTLS_KEY_EXCHANGE_SOME_ECDH_OR_ECDHE_ANY_ENABLED) && \5C\0A    defined(MBEDTLS_ECDH_C)\0Astatic void mbedtls_debug_printf_ecdh_internal(const mbedtls_ssl_context *ssl,\0A                                               int level, const char *file,\0A                                               int line,\0A                                               const mbedtls_ecdh_context *ecdh,\0A                                               mbedtls_debug_ecdh_attr attr)\0A{\0A#if defined(MBEDTLS_ECDH_LEGACY_CONTEXT)\0A    const mbedtls_ecdh_context *ctx = ecdh;\0A#else\0A    const mbedtls_ecdh_context_mbed *ctx = &ecdh->ctx.mbed_ecdh;\0A#endif\0A\0A    switch (attr) {\0A        case MBEDTLS_DEBUG_ECDH_Q:\0A            mbedtls_debug_print_ecp(ssl, level, file, line, \22ECDH: Q\22,\0A                                    &ctx->Q);\0A            break;\0A        case MBEDTLS_DEBUG_ECDH_QP:\0A            mbedtls_debug_print_ecp(ssl, level, file, line, \22ECDH: Qp\22,\0A                                    &ctx->Qp);\0A            break;\0A        case MBEDTLS_DEBUG_ECDH_Z:\0A            mbedtls_debug_print_mpi(ssl, level, file, line, \22ECDH: z\22,\0A                                    &ctx->z);\0A            break;\0A        default:\0A            break;\0A    }\0A}\0A\0Avoid mbedtls_debug_printf_ecdh(const mbedtls_ssl_context *ssl, int level,\0A                               const char *file, int line,\0A                               const mbedtls_ecdh_context *ecdh,\0A                               mbedtls_debug_ecdh_attr attr)\0A{\0A#if defined(MBEDTLS_ECDH_LEGACY_CONTEXT)\0A    mbedtls_debug_printf_ecdh_internal(ssl, level, file, line, ecdh, attr);\0A#else\0A    switch (ecdh->var) {\0A        default:\0A            mbedtls_debug_printf_ecdh_internal(ssl, level, file, line, ecdh,\0A                                               attr);\0A    }\0A#endif\0A}\0A#endif /* MBEDTLS_KEY_EXCHANGE_SOME_ECDH_OR_ECDHE_ANY_ENABLED &&\0A          MBEDTLS_ECDH_C */\0A\0A#endif /* MBEDTLS_DEBUG_C */\0A\00" }
