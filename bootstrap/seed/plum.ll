@.str39860 = private global { i64, i64, [6377 x i8] } { i64 -1, i64 6376, [6377 x i8] c"/**\0A * \5Cfile x509_crl.h\0A *\0A * \5Cbrief X.509 certificate revocation list parsing\0A */\0A/*\0A *  Copyright The Mbed TLS Contributors\0A *  SPDX-License-Identifier: Apache-2.0 OR GPL-2.0-or-later\0A */\0A#ifndef MBEDTLS_X509_CRL_H\0A#define MBEDTLS_X509_CRL_H\0A#include \22mbedtls/private_access.h\22\0A\0A#include \22mbedtls/build_info.h\22\0A\0A#include \22mbedtls/x509.h\22\0A\0A#ifdef __cplusplus\0Aextern \22C\22 {\0A#endif\0A\0A/**\0A * \5Caddtogroup x509_module\0A * \5C{ */\0A\0A/**\0A * \5Cname Structures and functions for parsing CRLs\0A * \5C{\0A */\0A\0A/**\0A * Certificate revocation list entry.\0A * Contains the CA-specific serial numbers and revocation dates.\0A *\0A * Some fields of this structure are publicly readable. Do not modify\0A * them except via Mbed TLS library functions: the effect of modifying\0A * those fields or the data that those fields points to is unspecified.\0A */\0Atypedef struct mbedtls_x509_crl_entry {\0A    /** Direct access to the whole entry inside the containing buffer. */\0A    mbedtls_x509_buf raw;\0A    /** The serial number of the revoked certificate. */\0A    mbedtls_x509_buf serial;\0A    /** The revocation date of this entry. */\0A    mbedtls_x509_time revocation_date;\0A    /** Direct access to the list of CRL entry extensions\0A     * (an ASN.1 constructed sequence).\0A     *\0A     * If there are no extensions, `entry_ext.len == 0` and\0A     * `entry_ext.p == NULL`. */\0A    mbedtls_x509_buf entry_ext;\0A\0A    /** Next element in the linked list of entries.\0A     * \5Cp NULL indicates the end of the list.\0A     * Do not modify this field directly. */\0A    struct mbedtls_x509_crl_entry *next;\0A}\0Ambedtls_x509_crl_entry;\0A\0A/**\0A * Certificate revocation list structure.\0A * Every CRL may have multiple entries.\0A */\0Atypedef struct mbedtls_x509_crl {\0A    mbedtls_x509_buf raw;           /**< The raw certificate data (DER). */\0A    mbedtls_x509_buf tbs;           /**< The raw certificate body (DER). The part that is To Be Signed. */\0A\0A    int version;            /**< CRL version (1=v1, 2=v2) */\0A    mbedtls_x509_buf sig_oid;       /**< CRL signature type identifier */\0A\0A    mbedtls_x509_buf issuer_raw;    /**< The raw issuer data (DER). */\0A\0A    mbedtls_x509_name issuer;       /**< The parsed issuer data (named information object). */\0A\0A    mbedtls_x509_time this_update;\0A    mbedtls_x509_time next_update;\0A\0A    mbedtls_x509_crl_entry entry;   /**< The CRL entries containing the certificate revocation times for this CA. */\0A\0A    mbedtls_x509_buf crl_ext;\0A\0A    mbedtls_x509_buf MBEDTLS_PRIVATE(sig_oid2);\0A    mbedtls_x509_buf MBEDTLS_PRIVATE(sig);\0A    mbedtls_md_type_t MBEDTLS_PRIVATE(sig_md);           /**< Internal representation of the MD algorithm of the signature algorithm, e.g. MBEDTLS_MD_SHA256 */\0A    mbedtls_pk_type_t MBEDTLS_PRIVATE(sig_pk);           /**< Internal representation of the Public Key algorithm of the signature algorithm, e.g. MBEDTLS_PK_RSA */\0A    void *MBEDTLS_PRIVATE(sig_opts);             /**< Signature options to be passed to mbedtls_pk_verify_ext(), e.g. for RSASSA-PSS */\0A\0A    /** Next element in the linked list of CRL.\0A     * \5Cp NULL indicates the end of the list.\0A     * Do not modify this field directly. */\0A    struct mbedtls_x509_crl *next;\0A}\0Ambedtls_x509_crl;\0A\0A/**\0A * \5Cbrief          Parse a DER-encoded CRL and append it to the chained list\0A *\0A * \5Cnote           If #MBEDTLS_USE_PSA_CRYPTO is enabled, the PSA crypto\0A *                 subsystem must have been initialized by calling\0A *                 psa_crypto_init() before calling this function.\0A *\0A * \5Cparam chain    points to the start of the chain\0A * \5Cparam buf      buffer holding the CRL data in DER format\0A * \5Cparam buflen   size of the buffer\0A *                 (including the terminating null byte for PEM data)\0A *\0A * \5Creturn         0 if successful, or a specific X509 or PEM error code\0A */\0Aint mbedtls_x509_crl_parse_der(mbedtls_x509_crl *chain,\0A                               const unsigned char *buf, size_t buflen);\0A/**\0A * \5Cbrief          Parse one or more CRLs and append them to the chained list\0A *\0A * \5Cnote           Multiple CRLs are accepted only if using PEM format\0A *\0A * \5Cnote           If #MBEDTLS_USE_PSA_CRYPTO is enabled, the PSA crypto\0A *                 subsystem must have been initialized by calling\0A *                 psa_crypto_init() before calling this function.\0A *\0A * \5Cparam chain    points to the start of the chain\0A * \5Cparam buf      buffer holding the CRL data in PEM or DER format\0A * \5Cparam buflen   size of the buffer\0A *                 (including the terminating null byte for PEM data)\0A *\0A * \5Creturn         0 if successful, or a specific X509 or PEM error code\0A */\0Aint mbedtls_x509_crl_parse(mbedtls_x509_crl *chain, const unsigned char *buf, size_t buflen);\0A\0A#if defined(MBEDTLS_FS_IO)\0A/**\0A * \5Cbrief          Load one or more CRLs and append them to the chained list\0A *\0A * \5Cnote           Multiple CRLs are accepted only if using PEM format\0A *\0A * \5Cnote           If #MBEDTLS_USE_PSA_CRYPTO is enabled, the PSA crypto\0A *                 subsystem must have been initialized by calling\0A *                 psa_crypto_init() before calling this function.\0A *\0A * \5Cparam chain    points to the start of the chain\0A * \5Cparam path     filename to read the CRLs from (in PEM or DER encoding)\0A *\0A * \5Creturn         0 if successful, or a specific X509 or PEM error code\0A */\0Aint mbedtls_x509_crl_parse_file(mbedtls_x509_crl *chain, const char *path);\0A#endif /* MBEDTLS_FS_IO */\0A\0A#if !defined(MBEDTLS_X509_REMOVE_INFO)\0A/**\0A * \5Cbrief          Returns an informational string about the CRL.\0A *\0A * \5Cparam buf      Buffer to write to\0A * \5Cparam size     Maximum size of buffer\0A * \5Cparam prefix   A line prefix\0A * \5Cparam crl      The X509 CRL to represent\0A *\0A * \5Creturn         The length of the string written (not including the\0A *                 terminated nul byte), or a negative error code.\0A */\0Aint mbedtls_x509_crl_info(char *buf, size_t size, const char *prefix,\0A                          const mbedtls_x509_crl *crl);\0A#endif /* !MBEDTLS_X509_REMOVE_INFO */\0A\0A/**\0A * \5Cbrief          Initialize a CRL (chain)\0A *\0A * \5Cparam crl      CRL chain to initialize\0A */\0Avoid mbedtls_x509_crl_init(mbedtls_x509_crl *crl);\0A\0A/**\0A * \5Cbrief          Unallocate all CRL data\0A *\0A * \5Cparam crl      CRL chain to free\0A */\0Avoid mbedtls_x509_crl_free(mbedtls_x509_crl *crl);\0A\0A/** \5C} name Structures and functions for parsing CRLs */\0A/** \5C} addtogroup x509_module */\0A\0A#ifdef __cplusplus\0A}\0A#endif\0A\0A#endif /* mbedtls_x509_crl.h */\0A\00" }
