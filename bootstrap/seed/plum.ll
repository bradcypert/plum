@.str40738 = private global { i64, i64, [49361 x i8] } { i64 -1, i64 49360, [49361 x i8] c"// A thin ABI-adapter shim for running a child process and capturing\0A// its exit code + stdout + stderr — needed for `plum build` to shell\0A// out to `clang` (already how THIS compiler's own native codegen\0A// works, see `codegen_cli.rs`'s `clang_compile`) from a Plum program\0A// itself, the other hard blocker (alongside `dir_shim.c`) toward ever\0A// self-hosting. Same `net_shim.c`/`dir_shim.c` shim pattern (see their\0A// own doc comments) — Plum's extern surface has no raw pointers, no\0A// arrays, and no multi-value return, so a \22run a process, get back\0A// THREE things (exit code/stdout/stderr)\22 operation needs the same\0A// two adaptations those files already established:\0A//\0A// **A handle-based, multi-call return** (mirrors `net_shim.c`'s socket\0A// fds, `dir_shim.c`'s directory handles): `process_run` blocks until\0A// the child exits, captures everything, and returns an opaque `Int`\0A// handle; `process_exit_code`/`process_stdout`/`process_stderr` read\0A// the ALREADY-CAPTURED result back out, any number of times, until\0A// `process_free` releases it. No result is ever recomputed or re-read\0A// from the child (which has already exited by the time `process_run`\0A// returns) — these are just accessors into a small in-process table.\0A//\0A// **Arguments packed into a single delimited `CStr`** (extern has no\0A// `Array[String]` at all): each argument separated by a TAB character.\0A// The natural choice here would be a rarer control byte (e.g. ASCII\0A// Unit Separator, `0x1F`) — genuinely safer against a real argument\0A// containing it — but Plum's own string-literal lexer only supports\0A// `\5Cn`/`\5Ct`/`\5Cr`/`\5C\5C`/`\5C\22` escapes, no `\5CxNN` hex byte escape, so the\0A// PLUM-side wrapper that joins an `Array[String]` into this shim's\0A// input literally cannot produce anything else. A real, honest trade\0A// forced by that limitation, not the ideal choice — a tab character\0A// appearing inside a real file path or flag is still rare, just not\0A// AS rare as a genuinely obscure control byte would have been. An\0A// argument that DOES contain a literal tab will be mis-split — not\0A// handled, not worth more complexity for something this unlikely.\0A//\0A// **Captures stdout/stderr via TEMP FILES, not pipes — deliberately.**\0A// A naive `pipe()` + `fork()` + `waitpid()` implementation has a\0A// classic, well-known deadlock: if the child writes more than the\0A// pipe's kernel buffer (~64KB on Linux) to a pipe NOBODY is draining\0A// yet (because the parent is blocked in `waitpid` first), the child\0A// blocks on `write()`, the parent blocks on `waitpid()` waiting for a\0A// child that's now blocked on the parent — a real hang, not a\0A// hypothetical (draining pipes concurrently, e.g. via `select()`/\0A// `poll()`, avoids it but adds real complexity this shim doesn't need\0A// to take on). Redirecting the child's stdout/stderr to real temp\0A// files via `dup2` sidesteps the whole class of bug: a file has no\0A// fixed-size buffer to fill, so there is no writer/reader ordering\0A// dependency at all — the parent just reads both files back, in full,\0A// AFTER `waitpid` confirms the child is done.\0A//\0A// **Not thread-safe** (a single, static, unlocked slot table) —\0A// acceptable for v1: every other blocking `native_stdlib` primitive\0A// (`net_shim.c`'s sockets included) is already scoped to single-\0A// threaded/sequential use, and a compiler shelling out to `clang` one\0A// invocation at a time (the actual motivating use case) never needs\0A// concurrent calls anyway.\0A//\0A// **Windows support is written but UNVERIFIED.** Everything above\0A// describes the POSIX path, which is tested by every harness in this\0A// repo. The Windows path below has never been compiled by a Windows\0A// toolchain, let alone run; it is a starting point, not working code,\0A// and is marked as such in PORTING.md. It keeps the temp-file capture\0A// strategy verbatim, because the pipe-deadlock reasoning above is not\0A// platform-specific -- Windows anonymous pipes have a fixed buffer and\0A// the identical failure mode.\0A//\0A// The two paths are split behind ONE function, `plum_spawn_capture`.\0A// Slot bookkeeping, argument splitting, checked capture reads and\0A// cleanup are shared by both platforms.\0A#include <stdio.h>\0A#include <stdlib.h>\0A#include <string.h>\0A#include <stdint.h>\0A#include <limits.h>\0A#include <wchar.h>\0A\0A#if defined(_WIN32)\0A#include <windows.h>\0A#else\0A#include <unistd.h>\0A#include <sys/wait.h>\0A#include <errno.h>\0A#include <fcntl.h>\0A#include <signal.h>\0A#include <time.h>\0A#endif\0A\0A#define PLUM_PROC_PATH_MAX 4096\0A\0A#define PLUM_PROC_ARG_SEP '\5Ct'\0A#define PLUM_PROC_MAX_SLOTS 256\0A\0A// The extra state an ASYNCHRONOUS child needs, and a synchronous run\0A// does not have to carry. NULL on a slot filled by `process_run`.\0A//\0A// A running child is the one case where the captured output cannot be\0A// read yet, so the PATHS have to outlive the spawn call -- which is\0A// the whole difference between this and the blocking path. Everything\0A// else here is what has to be closed or deleted once the child is\0A// gone, held so that `process_child_free` can do it without asking\0A// the caller to.\0Atypedef struct {\0A    long long pid;       // POSIX: pid_t. Windows: (intptr_t)HANDLE.\0A    void *h_out;         // Windows only: the child's stdout file handle.\0A    void *h_err;         // Windows only: the child's stderr file handle.\0A    char *out_path;\0A    char *err_path;\0A    char *in_path;       // Windows only; POSIX unlinks it at spawn.\0A    int finished;        // exit status collected, output read back\0A    // The policy `process_child_free` applies to a child still running.\0A    // 0 kills and reaps it. There is no way to set this from Plum yet\0A    // and that is deliberate -- it exists so that offering one later is\0A    // an addition rather than a redesign. See DESIGN.md.\0A    int drop_policy;\0A} PlumChildState;\0A\0Atypedef struct {\0A    int in_use;\0A    long long exit_code;\0A    char *out_data;\0A    char *err_data;\0A    long long out_length;\0A    long long err_length;\0A    int capture_failed;\0A    PlumChildState *child;\0A} PlumProcessSlot;\0A\0Astatic PlumProcessSlot plum_process_slots[PLUM_PROC_MAX_SLOTS];\0A\0A// Defined further down with the asynchronous children. Declared here\0A// because `process_free` has to hand a spawned slot over to it, and\0A// that appears first.\0Avoid process_child_free(long long handle);\0Along long process_terminate(long long handle, long long hard);\0A\0Astatic char *plum_strdup_or_null(const char *s) {\0A    if (s == NULL) return NULL;\0A    size_t n = strlen(s) + 1;\0A    char *p = malloc(n);\0A    if (p != NULL) memcpy(p, s, n);\0A    return p;\0A}\0A\0A// Shared checked reader: 64-bit positioning, checked allocation/read/close,\0A// and explicit length. NULL is an error, never a successful empty capture.\0Aextern char *plum_read_whole_file(const char *path, long long *length);\0A\0A// Publish both streams atomically. On failure retain only the error state;\0A// no successful prefix or sibling buffer should linger until Child is dropped.\0Astatic void plum_process_capture(PlumProcessSlot *slot, const char *out, const char *err) {\0A    slot->out_data = plum_read_whole_file(out, &slot->out_length);\0A    slot->err_data = slot->out_data == NULL ? NULL :\0A        plum_read_whole_file(err, &slot->err_length);\0A    slot->capture_failed = slot->out_data == NULL || slot->err_data == NULL;\0A    if (slot->capture_failed) {\0A        free(slot->out_data);\0A        free(slot->err_data);\0A        slot->out_data = slot->err_data = NULL;\0A        slot->out_length = slot->err_length = 0;\0A    }\0A}\0A\0A// A sentinel distinct from every real exit code. It cannot be -1:\0A// `process_run` already uses -1 as the exit code of a child killed by a\0A// signal, which is a SUCCESSFUL run with an unusual outcome, not a\0A// failure to start anything.\0A#define PLUM_SPAWN_FAILED (-1000000000LL)\0A\0A// `stdin_mode`: -1 inherit the parent's stdin, 0 empty (`/dev/null` /\0A// `NUL`), 1 feed `stdin_data` of length `stdin_len`.\0A// `fail_on_exec`: when set, an `execvp` failure is `PLUM_SPAWN_FAILED`\0A// rather than a child that exited 127 -- so `Process.run` can tell\0A// \22never started\22 from \22started and the program itself returned 127\22.\0A\0Astatic char **plum_split_args(const char *program, const char *args_joined, long long argc, char **copy_out) {\0A    char *args_copy = strdup(args_joined != NULL ? args_joined : \22\22);\0A    char **argv = (char **)malloc(sizeof(char *) * (size_t)(argc + 2));\0A    if (args_copy == NULL || argv == NULL) {\0A        free(args_copy);\0A        free(argv);\0A        *copy_out = NULL;\0A        return NULL;\0A    }\0A    argv[0] = (char *)program;\0A    long long idx = 1;\0A    if (argc > 0) {\0A        argv[idx++] = args_copy;\0A        for (char *c = args_copy; *c != '\5C0'; c++) {\0A            if (*c == PLUM_PROC_ARG_SEP) {\0A                *c = '\5C0';\0A                if (idx <= argc) {\0A                    argv[idx++] = c + 1;\0A                }\0A            }\0A        }\0A    }\0A    argv[idx] = NULL;\0A    *copy_out = args_copy;\0A    return argv;\0A}\0A\0Astatic char **plum_split_joined(const char *joined, long long n, char **copy_out) {\0A    if (n <= 0) {\0A        *copy_out = NULL;\0A        return NULL;\0A    }\0A    char *copy = strdup(joined != NULL ? joined : \22\22);\0A    char **items = (char **)malloc(sizeof(char *) * (size_t)(n + 1));\0A    if (copy == NULL || items == NULL) {\0A        free(copy);\0A        free(items);\0A        *copy_out = NULL;\0A        return NULL;\0A    }\0A    long long idx = 0;\0A    items[idx++] = copy;\0A    for (char *c = copy; *c != '\5C0'; c++) {\0A        if (*c == PLUM_PROC_ARG_SEP) {\0A     