@.str39965 = private global { i64, i64, [67909 x i8] } { i64 -1, i64 67908, [67909 x i8] c"/**\0A * \5Cfile psa/crypto_se_driver.h\0A * \5Cbrief PSA external cryptoprocessor driver module\0A *\0A * This header declares types and function signatures for cryptography\0A * drivers that access key material via opaque references.\0A * This is meant for cryptoprocessors that have a separate key storage from the\0A * space in which the PSA Crypto implementation runs, typically secure\0A * elements (SEs).\0A *\0A * This file is part of the PSA Crypto Driver HAL (hardware abstraction layer),\0A * containing functions for driver developers to implement to enable hardware\0A * to be called in a standardized way by a PSA Cryptography API\0A * implementation. The functions comprising the driver HAL, which driver\0A * authors implement, are not intended to be called by application developers.\0A */\0A\0A/*\0A *  Copyright The Mbed TLS Contributors\0A *  SPDX-License-Identifier: Apache-2.0 OR GPL-2.0-or-later\0A */\0A#ifndef PSA_CRYPTO_SE_DRIVER_H\0A#define PSA_CRYPTO_SE_DRIVER_H\0A#include \22mbedtls/private_access.h\22\0A\0A#include \22crypto_driver_common.h\22\0A\0A#ifdef __cplusplus\0Aextern \22C\22 {\0A#endif\0A\0A/** \5Cdefgroup se_init Secure element driver initialization\0A */\0A/**@{*/\0A\0A/** \5Cbrief Driver context structure\0A *\0A * Driver functions receive a pointer to this structure.\0A * Each registered driver has one instance of this structure.\0A *\0A * Implementations must include the fields specified here and\0A * may include other fields.\0A */\0Atypedef struct {\0A    /** A read-only pointer to the driver's persistent data.\0A     *\0A     * Drivers typically use this persistent data to keep track of\0A     * which slot numbers are available. This is only a guideline:\0A     * drivers may use the persistent data for any purpose, keeping\0A     * in mind the restrictions on when the persistent data is saved\0A     * to storage: the persistent data is only saved after calling\0A     * certain functions that receive a writable pointer to the\0A     * persistent data.\0A     *\0A     * The core allocates a memory buffer for the persistent data.\0A     * The pointer is guaranteed to be suitably aligned for any data type,\0A     * like a pointer returned by `malloc` (but the core can use any\0A     * method to allocate the buffer, not necessarily `malloc`).\0A     *\0A     * The size of this buffer is in the \5Cc persistent_data_size field of\0A     * this structure.\0A     *\0A     * Before the driver is initialized for the first time, the content of\0A     * the persistent data is all-bits-zero. After a driver upgrade, if the\0A     * size of the persistent data has increased, the original data is padded\0A     * on the right with zeros; if the size has decreased, the original data\0A     * is truncated to the new size.\0A     *\0A     * This pointer is to read-only data. Only a few driver functions are\0A     * allowed to modify the persistent data. These functions receive a\0A     * writable pointer. These functions are:\0A     * - psa_drv_se_t::p_init\0A     * - psa_drv_se_key_management_t::p_allocate\0A     * - psa_drv_se_key_management_t::p_destroy\0A     *\0A     * The PSA Cryptography core saves the persistent data from one\0A     * session to the next. It does this before returning from API functions\0A     * that call a driver method that is allowed to modify the persistent\0A     * data, specifically:\0A     * - psa_crypto_init() causes a call to psa_drv_se_t::p_init, and may call\0A     *   psa_drv_se_key_management_t::p_destroy to complete an action\0A     *   that was interrupted by a power failure.\0A     * - Key creation functions cause a call to\0A     *   psa_drv_se_key_management_t::p_allocate, and may cause a call to\0A     *   psa_drv_se_key_management_t::p_destroy in case an error occurs.\0A     * - psa_destroy_key() causes a call to\0A     *   psa_drv_se_key_management_t::p_destroy.\0A     */\0A    const void *const MBEDTLS_PRIVATE(persistent_data);\0A\0A    /** The size of \5Cc persistent_data in bytes.\0A     *\0A     * This is always equal to the value of the `persistent_data_size` field\0A     * of the ::psa_drv_se_t structure when the driver is registered.\0A     */\0A    const size_t MBEDTLS_PRIVATE(persistent_data_size);\0A\0A    /** Driver transient data.\0A     *\0A     * The core initializes this value to 0 and does not read or modify it\0A     * afterwards. The driver may store whatever it wants in this field.\0A     */\0A    uintptr_t MBEDTLS_PRIVATE(transient_data);\0A} psa_drv_se_context_t;\0A\0A/** \5Cbrief A driver initialization function.\0A *\0A * \5Cparam[in,out] drv_context       The driver context structure.\0A * \5Cparam[in,out] persistent_data   A pointer to the persistent data\0A *                                  that allows writing.\0A * \5Cparam location                  The location value for which this driver\0A *                                  is registered. The driver will be invoked\0A *                                  for all keys whose lifetime is in this\0A *                                  location.\0A *\0A * \5Cretval #PSA_SUCCESS\0A *         The driver is operational.\0A *         The core will update the persistent data in storage.\0A * \5Creturn\0A *         Any other return value prevents the driver from being used in\0A *         this session.\0A *         The core will NOT update the persistent data in storage.\0A */\0Atypedef psa_status_t (*psa_drv_se_init_t)(psa_drv_se_context_t *drv_context,\0A                                          void *persistent_data,\0A                                          psa_key_location_t location);\0A\0A#if defined(__DOXYGEN_ONLY__) || !defined(MBEDTLS_PSA_CRYPTO_SE_C)\0A/* Mbed TLS with secure element support enabled defines this type in\0A * crypto_types.h because it is also visible to applications through an\0A * implementation-specific extension.\0A * For the PSA Cryptography specification, this type is only visible\0A * via crypto_se_driver.h. */\0A/** An internal designation of a key slot between the core part of the\0A * PSA Crypto implementation and the driver. The meaning of this value\0A * is driver-dependent. */\0Atypedef uint64_t psa_key_slot_number_t;\0A#endif /* __DOXYGEN_ONLY__ || !MBEDTLS_PSA_CRYPTO_SE_C */\0A\0A/**@}*/\0A\0A/** \5Cdefgroup se_mac Secure Element Message Authentication Codes\0A * Generation and authentication of Message Authentication Codes (MACs) using\0A * a secure element can be done either as a single function call (via the\0A * `psa_drv_se_mac_generate_t` or `psa_drv_se_mac_verify_t` functions), or in\0A * parts using the following sequence:\0A * - `psa_drv_se_mac_setup_t`\0A * - `psa_drv_se_mac_update_t`\0A * - `psa_drv_se_mac_update_t`\0A * - ...\0A * - `psa_drv_se_mac_finish_t` or `psa_drv_se_mac_finish_verify_t`\0A *\0A * If a previously started secure element MAC operation needs to be terminated,\0A * it should be done so by the `psa_drv_se_mac_abort_t`. Failure to do so may\0A * result in allocated resources not being freed or in other undefined\0A * behavior.\0A */\0A/**@{*/\0A/** \5Cbrief A function that starts a secure element  MAC operation for a PSA\0A * Crypto Driver implementation\0A *\0A * \5Cparam[in,out] drv_context   The driver context structure.\0A * \5Cparam[in,out] op_context    A structure that will contain the\0A *                              hardware-specific MAC context\0A * \5Cparam[in] key_slot          The slot of the key to be used for the\0A *                              operation\0A * \5Cparam[in] algorithm         The algorithm to be used to underly the MAC\0A *                              operation\0A *\0A * \5Cretval  #PSA_SUCCESS\0A *          Success.\0A */\0Atypedef psa_status_t (*psa_drv_se_mac_setup_t)(psa_drv_se_context_t *drv_context,\0A                                               void *op_context,\0A                                               psa_key_slot_number_t key_slot,\0A                                               psa_algorithm_t algorithm);\0A\0A/** \5Cbrief A function that continues a previously started secure element MAC\0A * operation\0A *\0A * \5Cparam[in,out] op_context    A hardware-specific structure for the\0A *                              previously-established MAC operation to be\0A *                              updated\0A * \5Cparam[in] p_input           A buffer containing the message to be appended\0A *                              to the MAC operation\0A * \5Cparam[in] input_length      The size in bytes of the input message buffer\0A */\0Atypedef psa_status_t (*psa_drv_se_mac_update_t)(void *op_context,\0A                                                const uint8_t *p_input,\0A                                                size_t input_length);\0A\0A/** \5Cbrief a function that completes a previously started secure element MAC\0A * operation by returning the resulting MAC.\0A *\0A * \5Cparam[in,out] op_context    A hardware-specific structure for the\0A *                              previously started MAC operation to be\0A *                              finished\0A * \5Cparam[out] p_mac            A buffer where the generated MAC will be\0A *                              placed\0A * \5Cparam[in] mac_size          The size in bytes of the buffer that has been\0A *                              allocated for the `output` buffer\0A * \5Cparam[out] p_mac_length     After completion, will contain the number of\0A *                              bytes placed in the `p_mac` buffer\0A *\0A * \5Cretval  #PSA_SUCCESS\0A *          Success.\0A */\0Atypedef psa_status_t (*psa_drv_se_mac_finish_t)(void *op_context,\0A                                                uint8_t *p_mac,\0A                                                size_t mac_size,\0A                                                size_t *p_mac_length);\0A\0A/** \5Cbrief A function that completes a previously started secure element MAC\0A * operation by comparing the resulting MAC against a provided value\0A *\0A * \5Cparam[in,out] op_context    A hardware-specific structure for the previously\0A *                              started MAC operation to be finished\0A * \5Cparam[in] p_mac             The MAC value against which the resulting MAC\0A *                              will be compared against\0A * \5Cparam[in] mac_length        The size in bytes of the value stored in `p_mac`\0A *\0A * \5Cretval #PSA_SUCCESS\0A *         The operation completed successfully and the MACs matched each\0A *         other\0A * \5Cretval #PSA_ERROR_INVALID_SIGNATURE\0A *         The operation completed successfully, but the calculated MAC did\0A *         not match the provided MAC\0A */\0Atypedef psa_status_t (*psa_drv_se_mac_finish_verify_t)(void *op_context,\0A                                                       const uint8_t *p_mac,\0A                                                       size_t mac_length);\0A\0A/** \5Cbrief A function that aborts a previous started secure element MAC\0A * operation\0A *\0A * \5Cparam[in,out] op_context    A hardware-specific structure for the previously\0A *                              started MAC operation to be aborted\0A */\0Atypedef psa_status_t (*psa_drv_se_mac_abort_t)(void *op_context);\0A\0A/** \5Cbrief A function that performs a secure element MAC operation in one\0A * command and returns the calculated MAC\0A *\0A * \5Cparam[in,out] drv_context   The driver context structure.\0A * \5Cparam[in] p_input           A buffer containing the message to be MACed\0A * \5Cparam[in] input_length      The size in bytes of `p_input`\0A * \5Cparam[in] key_slot          The slot of the key to be used\0A * \5Cparam[in] alg               The algorithm to be used to underlie the MAC\0A *                              operation\0A * \5Cparam[out] p_mac            A buffer where the generated MAC will be\0A *                              placed\0A * \5Cparam[in] mac_size          The size in bytes of the `p_mac` buffer\0A * \5Cparam[out] p_mac_length     After completion, will contain the number of\0A *                              bytes placed in the `output` buffer\0A *\0A * \5Cretval #PSA_SUCCESS\0A *         Success.\0A */\0Atypedef psa_status_t (*psa_drv_se_mac_generate_t)(psa_drv_se_context_t *drv_context,\0A                                                  const uint8_t *p_input,\0A                                                  size_t input_length,\0A                                                  psa_key_slot_number_t key_slot,\0A                                                  psa_algorithm_t alg,\0A                                                  uint8_t *p_mac,\0A                                                  size_t mac_size,\0A                                                  size_t *p_mac_length);\0A\0A/** \5Cbrief A function that performs a secure element MAC operation in one\0A * command and compares the resulting MAC against a provided value\0A *\0A * \5Cparam[in,out] drv_context       The driver context structure.\0A * \5Cparam[in] p_input       A buffer containing the message to be MACed\0A * \5Cparam[in] input_length  The size in bytes of `input`\0A * \5Cparam[in] key_slot      The slot of the key to be used\0A * \5Cparam[in] alg           The algorithm to be used to underlie the MAC\0A *                          operation\0A * \5Cparam[in] p_mac         The MAC value against which the resulting MAC will\0A *                          be compared against\0A * \5Cparam[in] mac_length   The size in bytes of `mac`\0A *\0A * \5Cretval #PSA_SUCCESS\0A *         The operation completed successfully and the MACs matched each\0A *         other\0A * \5Cretval #PSA_ERROR_INVALID_SIGNATURE\0A *         The operation completed successfully, but the calculated MAC did\0A *         not match the provided MAC\0A */\0Atypedef psa_status_t (*psa_drv_se_mac_verify_t)(psa_drv_se_context_t *drv_context,\0A                                                const uint8_t *p_input,\0A                                                size_t input_length,\0A                                                psa_key_slot_number_t key_slot,\0A                                                psa_algorithm_t alg,\0A                                                const uint8_t *p_mac,\0A                                                size_t mac_length);\0A\0A/** \5Cbrief A struct containing all of the function pointers needed to\0A * perform secure element MAC operations\0A *\0A * PSA Crypto API implementations should populate the table as appropriate\0A * upon startup.\0A *\0A * If one of the functions is not implemented (such as\0A * `psa_drv_se_mac_generate_t`), it should be set to NULL.\0A *\0A * Driver implementers should ensure that they implement all of the functions\0A * that make sense for their hardware, and that they provide a full solution\0A * (for example, if they support `p_setup`, they should also support\0A * `p_update` and at least one of `p_finish` or `p_finish_verify`).\0A *\0A */\0Atypedef struct {\0A    /**The size in bytes of the hardware-specific secure element MAC context\0A     * structure\0A     */\0A    size_t                    MBEDTLS_PRIVATE(context_size);\0A    /** Function that performs a MAC setup operation\0A     */\0A    psa_drv_se_mac_setup_t          MBEDTLS_PRIVATE(p_setup);\0A    /** Function that performs a MAC update operation\0A     */\0A    psa_drv_se_mac_update_t         MBEDTLS_PRIVATE(p_update);\0A    /** Function that completes a MAC operation\0A     */\0A    psa_drv_se_mac_finish_t         MBEDTLS_PRIVATE(p_finish);\0A    /** Function that completes a MAC operation with a verify check\0A     */\0A    psa_drv_se_mac_finish_verify_t  MBEDTLS_PRIVATE(p_finish_verify);\0A    /** Function that aborts a previously started MAC operation\0A     */\0A    psa_drv_se_mac_abort_t          MBEDTLS_PRIVATE(p_abort);\0A    /** Function that performs a MAC operation in one call\0A     */\0A    psa_drv_se_mac_generate_t       MBEDTLS_PRIVATE(p_mac);\0A    /** Function that performs a MAC and verify operation in one call\0A     */\0A    psa_drv_se_mac_verify_t         MBEDTLS_PRIVATE(p_mac_verify);\0A} psa_drv_se_mac_t;\0A/**@}*/\0A\0A/** \5Cdefgroup se_cipher Secure Element Symmetric Ciphers\0A *\0A * Encryption and Decryption using secure element keys in block modes other\0A * than ECB must be done in multiple parts, using the following flow:\0A * - `psa_drv_se_cipher_setup_t`\0A * - `psa_drv_se_cipher_set_iv_t` (optional depending upon block mode)\0A * - `psa_drv_se_cipher_update_t`\0A * - `psa_drv_se_cipher_update_t`\0A * - ...\0A * - `psa_drv_se_cipher_finish_t`\0A *\0A * If a previously started secure element Cipher operation needs to be\0A * terminated, it should be done so by the `psa_drv_se_cipher_abort_t`. Failure\0A * to do so may result in allocated resources not being freed or in other\0A * undefined behavior.\0A *\0A * In situations where a PSA Cryptographic API implementation is using a block\0A * mode not-supported by the underlying hardware or driver, it can construct\0A * the block mode itself, while calling the `psa_drv_se_cipher_ecb_t` function\0A * for the cipher operations.\0A */\0A/**@{*/\0A\0A/** \5Cbrief A function that provides the cipher setup function for a\0A * secure element driver\0A *\0A * \5Cparam[in,out] drv_context   The driver context structure.\0A * \5Cparam[in,out] op_context    A structure that will contain the\0A *                              hardware-specific cipher context.\0A * \5Cparam[in] key_slot          The slot of the key to be used for the\0A *                              operation\0A * \5Cparam[in] algorithm         The algorithm to be used in the cipher\0A *                              operation\0A * \5Cparam[in] direction         Indicates whether the operation is an encrypt\0A *                              or decrypt\0A *\0A * \5Cretval #PSA_SUCCESS \5Cemptydescription\0A * \5Cretval #PSA_ERROR_NOT_SUPPORTED \5Cemptydescription\0A */\0Atypedef psa_status_t (*psa_drv_se_cipher_setup_t)(psa_drv_se_context_t *drv_context,\0A                                                  void *op_context,\0A                                                  psa_key_slot_number_t key_slot,\0A                                                  psa_algorithm_t algorithm,\0A                                                  psa_encrypt_or_decrypt_t direction);\0A\0A/** \5Cbrief A function that sets the initialization vector (if\0A * necessary) for a secure element cipher operation\0A *\0A * Rationale: The `psa_se_cipher_*` operation in the PSA Cryptographic API has\0A * two IV functions: one to set the IV, and one to generate it internally. The\0A * generate function is not necessary for the drivers to implement as the PSA\0A * Crypto implementation can do the generation using its RNG features.\0A *\0A * \5Cparam[in,out] op_context    A structure that contains the previously set up\0A *                              hardware-specific cipher context\0A * \5Cparam[in] p_iv              A buffer containing the initialization vector\0A * \5Cparam[in] iv_length         The size (in bytes) of the `p_iv` buffer\0A *\0A * \5Cretval #PSA_SUCCESS \5Cemptydescription\0A */\0Atypedef psa_status_t (*psa_drv_se_cipher_set_iv_t)(void *op_context,\0A                                                   const uint8_t *p_iv,\0A                                                   size_t iv_length);\0A\0A/** \5Cbrief A function that continues a previously started secure element cipher\0A * operation\0A *\0A * \5Cparam[in,out] op_context        A hardware-specific structure for the\0A *                                  previously started cipher operation\0A * \5Cparam[in] p_input               A buffer containing the data to be\0A *                                  encrypted/decrypted\0A * \5Cparam[in] input_size            The size in bytes of the buffer pointed to\0A *                                  by `p_input`\0A * \5Cparam[out] p_output             The caller-allocated buffer where the\0A *                                  output will be placed\0A * \5Cparam[in] output_size           The allocated size in bytes of the\0A *                                  `p_output` buffer\0A * \5Cparam[out] p_output_length      After completion, will contain the number\0A *                                  of bytes placed in the `p_output` buffer\0A *\0A * \5Cretval #PSA_SUCCESS \5Cemptydescription\0A */\0Atypedef psa_status_t (*psa_drv_se_cipher_update_t)(void *op_context,\0A                                                   const uint8_t *p_input,\0A                                                   size_t input_size,\0A                                                   uint8_t *p_output,\0A                                                   size_t output_size,\0A                                                   size_t *p_output_length);\0A\0A/** \5Cbrief A function that completes a previously started secure element cipher\0A * operation\0A *\0A * \5Cparam[in,out] op_context    A hardware-specific structure for the\0A *                              previously started cipher operation\0A * \5Cparam[out] p_output         The caller-allocated buffer where the output\0A *                              will be placed\0A * \5Cparam[in] output_size       The allocated size in bytes of the `p_output`\0A *                              buffer\0A * \5Cparam[out] p_output_length  After completion, will contain the number of\0A *                              bytes placed in the `p_output` buffer\0A *\0A * \5Cretval #PSA_SUCCESS \5Cemptydescription\0A */\0Atypedef psa_status_t (*psa_drv_se_cipher_finish_t)(void *op_context,\0A                                                   uint8_t *p_output,\0A                                                   size_t output_size,\0A                                                   size_t *p_output_length);\0A\0A/** \5Cbrief A function that aborts a previously started secure element cipher\0A * operation\0A *\0A * \5Cparam[in,out] op_context    A hardware-specific structure for the\0A *                              previously started cipher operation\0A */\0Atypedef psa_status_t (*psa_drv_se_cipher_abort_t)(void *op_context);\0A\0A/** \5Cbrief A function that performs the ECB block mode for secure element\0A * cipher operations\0A *\0A * Note: this function should only be used with implementations that do not\0A * provide a needed higher-level operation.\0A *\0A * \5Cparam[in,out] drv_context   The driver context structure.\0A * \5Cparam[in] key_slot          The slot of the key to be used for the operation\0A * \5Cparam[in] algorithm         The algorithm to be used in the cipher operation\0A * \5Cparam[in] direction         Indicates whether the operation is an encrypt or\0A *                              decrypt\0A * \5Cparam[in] p_input           A buffer containing the data to be\0A *                              encrypted/decrypted\0A * \5Cparam[in] input_size        The size in bytes of the buffer pointed to by\0A *                              `p_input`\0A * \5Cparam[out] p_output         The caller-allocated buffer where the output\0A *                              will be placed\0A * \5Cparam[in] output_size       The allocated size in bytes of the `p_output`\0A *                              buffer\0A *\0A * \5Cretval #PSA_SUCCESS \5Cemptydescription\0A * \5Cretval #PSA_ERROR_NOT_SUPPORTED \5Cemptydescription\0A */\0Atypedef psa_status_t (*psa_drv_se_cipher_ecb_t)(psa_drv_se_context_t *drv_context,\0A                                                psa_key_slot_number_t key_slot,\0A                                                psa_algorithm_t algorithm,\0A                                                psa_encrypt_or_decrypt_t direction,\0A                                                const uint8_t *p_input,\0A                                                size_t input_size,\0A                                                uint8_t *p_output,\0A                                                size_t output_size);\0A\0A/**\0A * \5Cbrief A struct containing all of the function pointers needed to implement\0A * cipher operations using secure elements.\0A *\0A * PSA Crypto API implementations should populate instances of the table as\0A * appropriate upon startup or at build time.\0A *\0A * If one of the functions is not implemented (such as\0A * `psa_drv_se_cipher_ecb_t`), it should be set to NULL.\0A */\0Atypedef struct {\0A    /** The size in bytes of the hardware-specific secure element cipher\0A     * context structure\0A     */\0A    size_t               MBEDTLS_PRIVATE(context_size);\0A    /** Function that performs a cipher setup operation */\0A    psa_drv_se_cipher_setup_t  MBEDTLS_PRIVATE(p_setup);\0A    /** Function that sets a cipher IV (if necessary) */\0A    psa_drv_se_cipher_set_iv_t MBEDTLS_PRIVATE(p_set_iv);\0A    /** Function that performs a cipher update operation */\0A    psa_drv_se_cipher_update_t MBEDTLS_PRIVATE(p_update);\0A    /** Function that completes a cipher operation */\0A    psa_drv_se_cipher_finish_t MBEDTLS_PRIVATE(p_finish);\0A    /** Function that aborts a cipher operation */\0A    psa_drv_se_cipher_abort_t  MBEDTLS_PRIVATE(p_abort);\0A    /** Function that performs ECB mode for a cipher operation\0A     * (Danger: ECB mode should not be used directly by clients of the PSA\0A     * Crypto Client API)\0A     */\0A    psa_drv_se_cipher_ecb_t    MBEDTLS_PRIVATE(p_ecb);\0A} psa_drv_se_cipher_t;\0A\0A/**@}*/\0A\0A/** \5Cdefgroup se_asymmetric Secure Element Asymmetric Cryptography\0A *\0A * Since the amount of data that can (or should) be encrypted or signed using\0A * asymmetric keys is limited by the key size, asymmetric key operations using\0A * keys in a secure element must be done in single function calls.\0A */\0A/**@{*/\0A\0A/**\0A * \5Cbrief A function that signs a hash or short message with a private key in\0A * a secure element\0A *\0A * \5Cparam[in,out] drv_context       The driver context structure.\0A * \5Cparam[in] key_slot              Key slot of an asymmetric key pair\0A * \5Cparam[in] alg                   A signature algorithm that is compatible\0A *                                  with the type of `key`\0A * \5Cparam[in] p_hash                The hash to sign\0A * \5Cparam[in] hash_length           Size of the `p_hash` buffer in bytes\0A * \5Cparam[out] p_signature          Buffer where the signature is to be written\0A * \5Cparam[in] signature_size        Size of the `p_signature` buffer in bytes\0A * \5Cparam[out] p_signature_length   On success, the number of bytes\0A *                                  that make up the returned signature value\0A *\0A * \5Cretval #PSA_SUCCESS \5Cemptydescription\0A */\0Atypedef psa_status_t (*psa_drv_se_asymmetric_sign_t)(psa_drv_se_context_t *drv_context,\0A                                                     psa_key_slot_number_t key_slot,\0A                                                     psa_algorithm_t alg,\0A                                                     const uint8_t *p_hash,\0A                                                     size_t hash_length,\0A                                                     uint8_t *p_signature,\0A                                                     size_t signature_size,\0A                                                     size_t *p_signature_length);\0A\0A/**\0A * \5Cbrief A function that verifies the signature a hash or short message using\0A * an asymmetric public key in a secure element\0A *\0A * \5Cparam[in,out] drv_context   The driver context structure.\0A * \5Cparam[in] key_slot          Key slot of a public key or an asymmetric key\0A *                              pair\0A * \5Cparam[in] alg               A signature algorithm that is compatible with\0A *                              the type of `key`\0A * \5Cparam[in] p_hash            The hash whose signature is to be verified\0A * \5Cparam[in] hash_length       Size of the `p_hash` buffer in bytes\0A * \5Cparam[in] p_signature       Buffer containing the signature to verify\0A * \5Cparam[in] signature_length  Size of the `p_signature` buffer in bytes\0A *\0A * \5Cretval #PSA_SUCCESS\0A *         The signature is valid.\0A */\0Atypedef psa_status_t (*psa_drv_se_asymmetric_verify_t)(psa_drv_se_context_t *drv_context,\0A                                                       psa_key_slot_number_t key_slot,\0A                                                       psa_algorithm_t alg,\0A                                                       const uint8_t *p_hash,\0A                                                       size_t hash_length,\0A                                                       const uint8_t *p_signature,\0A                                                       size_t signature_length);\0A\0A/**\0A * \5Cbrief A function that encrypts a short message with an asymmetric public\0A * key in a secure element\0A *\0A * \5Cparam[in,out] drv_context   The driver context structure.\0A * \5Cparam[in] key_slot          Key slot of a public key or an asymmetric key\0A *                              pair\0A * \5Cparam[in] alg               An asymmetric encryption algorithm that is\0A *                              compatible with the type of `key`\0A * \5Cparam[in] p_input           The message to encrypt\0A * \5Cparam[in] input_length      Size of the `p_input` buffer in bytes\0A * \5Cparam[in] p_salt            A salt or label, if supported by the\0A *                              encryption algorithm\0A *                              If the algorithm does not support a\0A *                              salt, pass `NULL`.\0A *                              If the algorithm supports an optional\0A *                              salt and you do not want to pass a salt,\0A *                              pass `NULL`.\0A *                              For #PSA_ALG_RSA_PKCS1V15_CRYPT, no salt is\0A *                              supported.\0A * \5Cparam[in] salt_length       Size of the `p_salt` buffer in bytes\0A *                              If `p_salt` is `NULL`, pass 0.\0A * \5Cparam[out] p_output         Buffer where the encrypted message is to\0A *                              be written\0A * \5Cparam[in] output_size       Size of the `p_output` buffer in bytes\0A * \5Cparam[out] p_output_length  On success, the number of bytes that make up\0A *                              the returned output\0A *\0A * \5Cretval #PSA_SUCCESS \5Cemptydescription\0A */\0Atypedef psa_status_t (*psa_drv_se_asymmetric_encrypt_t)(psa_drv_se_context_t *drv_context,\0A                                                        psa_key_slot_number_t key_slot,\0A                                                        psa_algorithm_t alg,\0A                                                        const uint8_t *p_input,\0A                                                        size_t input_length,\0A                                                        const uint8_t *p_salt,\0A                                                        size_t salt_length,\0A                                                        uint8_t *p_output,\0A                                                        size_t output_size,\0A                                                        size_t *p_output_length);\0A\0A/**\0A * \5Cbrief A function that decrypts a short message with an asymmetric private\0A * key in a secure element.\0A *\0A * \5Cparam[in,out] drv_context   The driver context structure.\0A * \5Cparam[in] key_slot          Key slot of an asymmetric key pair\0A * \5Cparam[in] alg               An asymmetric encryption algorithm that is\0A *                              compatible with the type of `key`\0A * \5Cparam[in] p_input           The message to decrypt\0A * \5Cparam[in] input_length      Size of the `p_input` buffer in bytes\0A * \5Cparam[in] p_salt            A salt or label, if supported by the\0A *                              encryption algorithm\0A *                              If the algorithm does not support a\0A *                              salt, pass `NULL`.\0A *                              If the algorithm supports an optional\0A *                              salt and you do not want to pass a salt,\0A *                              pass `NULL`.\0A *                              For #PSA_ALG_RSA_PKCS1V15_CRYPT, no salt is\0A *                              supported.\0A * \5Cparam[in] salt_length       Size of the `p_salt` buffer in bytes\0A *                              If `p_salt` is `NULL`, pass 0.\0A * \5Cparam[out] p_output         Buffer where the decrypted message is to\0A *                              be written\0A * \5Cparam[in] output_size       Size of the `p_output` buffer in bytes\0A * \5Cparam[out] p_output_length  On success, the number of bytes\0A *                              that make up the returned output\0A *\0A * \5Cretval #PSA_SUCCESS \5Cemptydescription\0A */\0Atypedef psa_status_t (*psa_drv_se_asymmetric_decrypt_t)(psa_drv_se_context_t *drv_context,\0A                                                        psa_key_slot_number_t key_slot,\0A                                                        psa_algorithm_t alg,\0A                                                        const uint8_t *p_input,\0A                                                        size_t input_length,\0A                                                        const uint8_t *p_salt,\0A                                                        size_t salt_length,\0A                                                        uint8_t *p_output,\0A                                                        size_t output_size,\0A                                                        size_t *p_output_length);\0A\0A/**\0A * \5Cbrief A struct containing all of the function pointers needed to implement\0A * asymmetric cryptographic operations using secure elements.\0A *\0A * PSA Crypto API implementations should populate instances of the table as\0A * appropriate upon startup or at build time.\0A *\0A * If one of the functions is not implemented, it should be set to NULL.\0A */\0Atypedef struct {\0A    /** Function that performs an asymmetric sign operation */\0A    psa_drv_se_asymmetric_sign_t    MBEDTLS_PRIVATE(p_sign);\0A    /** Function that performs an asymmetric verify operation */\0A    psa_drv_se_asymmetric_verify_t  MBEDTLS_PRIVATE(p_verify);\0A    /** Function that performs an asymmetric encrypt operation */\0A    psa_drv_se_asymmetric_encrypt_t MBEDTLS_PRIVATE(p_encrypt);\0A    /** Function that performs an asymmetric decrypt operation */\0A    psa_drv_se_asymmetric_decrypt_t MBEDTLS_PRIVATE(p_decrypt);\0A} psa_drv_se_asymmetric_t;\0A\0A/**@}*/\0A\0A/** \5Cdefgroup se_aead Secure Element Authenticated Encryption with Additional Data\0A * Authenticated Encryption with Additional Data (AEAD) operations with secure\0A * elements must be done in one function call. While this creates a burden for\0A * implementers as there must be sufficient space in memory for the entire\0A * message, it prevents decrypted data from being made available before the\0A * authentication operation is complete and the data is known to be authentic.\0A */\0A/**@{*/\0A\0A/** \5Cbrief A function that performs a secure element authenticated encryption\0A * operation\0A *\0A * \5Cparam[in,out] drv_context           The driver context structure.\0A * \5Cparam[in] key_slot                  Slot containing the key to use.\0A * \5Cparam[in] algorithm                 The AEAD algorithm to compute\0A *                                      (\5Cc PSA_ALG_XXX value such that\0A *                                      #PSA_ALG_IS_AEAD(`alg`) is true)\0A * \5Cparam[in] p_nonce                   Nonce or IV to use\0A * \5Cparam[in] nonce_length              Size of the `p_nonce` buffer in bytes\0A * \5Cparam[in] p_additional_data         Additional data that will be\0A *                                      authenticated but not encrypted\0A * \5Cparam[in] additional_data_length    Size of `p_additional_data` in bytes\0A * \5Cparam[in] p_plaintext               Data that will be authenticated and\0A *                                      encrypted\0A * \5Cparam[in] plaintext_length          Size of `p_plaintext` in bytes\0A * \5Cparam[out] p_ciphertext             Output buffer for the authenticated and\0A *                                      encrypted data. The additional data is\0A *                                      not part of this output. For algorithms\0A *                                      where the encrypted data and the\0A *                                      authentication tag are defined as\0A *                                      separate outputs, the authentication\0A *                                      tag is appended to the encrypted data.\0A * \5Cparam[in] ciphertext_size           Size of the `p_ciphertext` buffer in\0A *                                      bytes\0A * \5Cparam[out] p_ciphertext_length      On success, the size of the output in\0A *                                      the `p_ciphertext` buffer\0A *\0A * \5Cretval #PSA_SUCCESS\0A *         Success.\0A */\0Atypedef psa_status_t (*psa_drv_se_aead_encrypt_t)(psa_drv_se_context_t *drv_context,\0A                                                  psa_key_slot_number_t key_slot,\0A                                                  psa_algorithm_t algorithm,\0A                                                  const uint8_t *p_nonce,\0A                                                  size_t nonce_length,\0A                                                  const uint8_t *p_additional_data,\0A                                                  size_t additional_data_length,\0A                                                  const uint8_t *p_plaintext,\0A                                                  size_t plaintext_length,\0A                                                  uint8_t *p_ciphertext,\0A                                                  size_t ciphertext_size,\0A                                                  size_t *p_ciphertext_length);\0A\0A/** A function that performs a secure element authenticated decryption operation\0A *\0A * \5Cparam[in,out] drv_context           The driver context structure.\0A * \5Cparam[in] key_slot                  Slot containing the key to use\0A * \5Cparam[in] algorithm                 The AEAD algorithm to compute\0A *                                      (\5Cc PSA_ALG_XXX value such that\0A *                                      #PSA_ALG_IS_AEAD(`alg`) is true)\0A * \5Cparam[in] p_nonce                   Nonce or IV to use\0A * \5Cparam[in] nonce_length              Size of the `p_nonce` buffer in bytes\0A * \5Cparam[in] p_additional_data         Additional data that has been\0A *                                      authenticated but not encrypted\0A * \5Cparam[in] additional_data_length    Size of `p_additional_data` in bytes\0A * \5Cparam[in] p_ciphertext              Data that has been authenticated and\0A *                                      encrypted.\0A *                                      For algorithms where the encrypted data\0A *                                      and the authentication tag are defined\0A *                                      as separate inputs, the buffer must\0A *                                      contain the encrypted data followed by\0A *                                      the authentication tag.\0A * \5Cparam[in] ciphertext_length         Size of `p_ciphertext` in bytes\0A * \5Cparam[out] p_plaintext              Output buffer for the decrypted data\0A * \5Cparam[in] plaintext_size            Size of the `p_plaintext` buffer in\0A *                                      bytes\0A * \5Cparam[out] p_plaintext_length       On success, the size of the output in\0A *                                      the `p_plaintext` buffer\0A *\0A * \5Cretval #PSA_SUCCESS\0A *         Success.\0A */\0Atypedef psa_status_t (*psa_drv_se_aead_decrypt_t)(psa_drv_se_context_t *drv_context,\0A                                                  psa_key_slot_number_t key_slot,\0A                                                  psa_algorithm_t algorithm,\0A                                                  const uint8_t *p_nonce,\0A                                                  size_t nonce_length,\0A                                                  const uint8_t *p_additional_data,\0A                                                  size_t additional_data_length,\0A                                                  const uint8_t *p_ciphertext,\0A                                                  size_t ciphertext_length,\0A                                                  uint8_t *p_plaintext,\0A                                                  size_t plaintext_size,\0A                                                  size_t *p_plaintext_length);\0A\0A/**\0A * \5Cbrief A struct containing all of the function pointers needed to implement\0A * secure element Authenticated Encryption with Additional Data operations\0A *\0A * PSA Crypto API implementations should populate instances of the table as\0A * appropriate upon startup.\0A *\0A * If one of the functions is not implemented, it should be set to NULL.\0A */\0Atypedef struct {\0A    /** Function that performs the AEAD encrypt operation */\0A    psa_drv_se_aead_encrypt_t MBEDTLS_PRIVATE(p_encrypt);\0A    /** Function that performs the AEAD decrypt operation */\0A    psa_drv_se_aead_decrypt_t MBEDTLS_PRIVATE(p_decrypt);\0A} psa_drv_se_aead_t;\0A/**@}*/\0A\0A/** \5Cdefgroup se_key_management Secure Element Key Management\0A * Currently, key management is limited to importing keys in the clear,\0A * destroying keys, and exporting keys in the clear.\0A * Whether a key may be exported is determined by the key policies in place\0A * on the key slot.\0A */\0A/**@{*/\0A\0A/** An enumeration indicating how a key is created.\0A */\0Atypedef enum {\0A    PSA_KEY_CREATION_IMPORT, /**< During psa_import_key() */\0A    PSA_KEY_CREATION_GENERATE, /**< During psa_generate_key() */\0A    PSA_KEY_CREATION_DERIVE, /**< During psa_key_derivation_output_key() */\0A    PSA_KEY_CREATION_COPY, /**< During psa_copy_key() */\0A\0A#ifndef __DOXYGEN_ONLY__\0A    /** A key is being registered with mbedtls_psa_register_se_key().\0A     *\0A     * The core only passes this value to\0A     * psa_drv_se_key_management_t::p_validate_slot_number, not to\0A     * psa_drv_se_key_management_t::p_allocate. The call to\0A     * `p_validate_slot_number` is not followed by any other call to the\0A     * driver: the key is considered successfully registered if the call to\0A     * `p_validate_slot_number` succeeds, or if `p_validate_slot_number` is\0A     * null.\0A     *\0A     * With this creation method, the driver must return #PSA_SUCCESS if\0A     * the given attributes are compatible with the existing key in the slot,\0A     * and #PSA_ERROR_DOES_NOT_EXIST if the driver can determine that there\0A     * is no key with the specified slot number.\0A     *\0A     * This is an Mbed TLS extension.\0A     */\0A    PSA_KEY_CREATION_REGISTER,\0A#endif\0A} psa_key_creation_method_t;\0A\0A/** \5Cbrief A function that allocates a slot for a key.\0A *\0A * To create a key in a specific slot in a secure element, the core\0A * first calls this function to determine a valid slot number,\0A * then calls a function to create the key material in that slot.\0A * In nominal conditions (that is, if no error occurs),\0A * the effect of a call to a key creation function in the PSA Cryptography\0A * API with a lifetime that places the key in a secure element is the\0A * following:\0A * -# The core calls psa_drv_se_key_management_t::p_allocate\0A *    (or in some implementations\0A *    psa_drv_se_key_management_t::p_validate_slot_number). The driver\0A *    selects (or validates) a suitable slot number given the key attributes\0A *    and the state of the secure element.\0A * -# The core calls a key creation function in the driver.\0A *\0A * The key creation functions in the PSA Cryptography API are:\0A * - psa_import_key(), which causes\0A *   a call to `p_allocate` with \5Cp method = #PSA_KEY_CREATION_IMPORT\0A *   then a call to psa_drv_se_key_management_t::p_import.\0A * - psa_generate_key(), which causes\0A *   a call to `p_allocate` with \5Cp method = #PSA_KEY_CREATION_GENERATE\0A *   then a call to psa_drv_se_key_management_t::p_import.\0A * - psa_key_derivation_output_key(), which causes\0A *   a call to `p_allocate` with \5Cp method = #PSA_KEY_CREATION_DERIVE\0A *   then a call to psa_drv_se_key_derivation_t::p_derive.\0A * - psa_copy_key(), which causes\0A *   a call to `p_allocate` with \5Cp method = #PSA_KEY_CREATION_COPY\0A *   then a call to psa_drv_se_key_management_t::p_export.\0A *\0A * In case of errors, other behaviors are possible.\0A * - If the PSA Cryptography subsystem dies after the first step,\0A *   for example because the device has lost power abruptly,\0A *   the second step may never happen, or may happen after a reset\0A *   and re-initialization. Alternatively, after a reset and\0A *   re-initialization, the core may call\0A *   psa_drv_se_key_management_t::p_destroy on the slot number that\0A *   was allocated (or validated) instead of calling a key creation function.\0A * - If an error occurs, the core may call\0A *   psa_drv_se_key_management_t::p_destroy on the slot number that\0A *   was allocated (or validated) instead of calling a key creation function.\0A *\0A * Errors and system resets also have an impact on the driver's persistent\0A * data. If a reset happens before the overall key creation process is\0A * completed (before or after the second step above), it is unspecified\0A * whether the persistent data after the reset is identical to what it\0A * was before or after the call to `p_allocate` (or `p_validate_slot_number`).\0A *\0A * \5Cparam[in,out] drv_context       The driver context structure.\0A * \5Cparam[in,out] persistent_data   A pointer to the persistent data\0A *                                  that allows writing.\0A * \5Cparam[in] attributes            Attributes of the key.\0A * \5Cparam method                    The way in which the key is being created.\0A * \5Cparam[out] key_slot             Slot where the key will be stored.\0A *                                  This must be a valid slot for a key of the\0A *                                  chosen type. It must be unoccupied.\0A *\0A * \5Cretval #PSA_SUCCESS\0A *         Success.\0A *         The core will record \5Cc *key_slot as the key slot where the key\0A *         is stored and will update the persistent data in storage.\0A * \5Cretval #PSA_ERROR_NOT_SUPPORTED \5Cemptydescription\0A * \5Cretval #PSA_ERROR_INSUFFICIENT_STORAGE \5Cemptydescription\0A */\0Atypedef psa_status_t (*psa_drv_se_allocate_key_t)(\0A    psa_drv_se_context_t *drv_context,\0A    void *persistent_data,\0A    const psa_key_attributes_t *attributes,\0A    psa_key_creation_method_t method,\0A    psa_key_slot_number_t *key_slot);\0A\0A/** \5Cbrief A function that determines whether a slot number is valid\0A * for a key.\0A *\0A * To create a key in a specific slot in a secure element, the core\0A * first calls this function to validate the choice of slot number,\0A * then calls a function to create the key material in that slot.\0A * See the documentation of #psa_drv_se_allocate_key_t for more details.\0A *\0A * As of the PSA Cryptography API specification version 1.0, there is no way\0A * for applications to trigger a call to this function. However some\0A * implementations offer the capability to create or declare a key in\0A * a specific slot via implementation-specific means, generally for the\0A * sake of initial device provisioning or onboarding. Such a mechanism may\0A * be added to a future version of the PSA Cryptography API specification.\0A *\0A * This function may update the driver's persistent data through\0A * \5Cp persistent_data. The core will save the updated persistent data at the\0A * end of the key creation process. See the description of\0A * ::psa_drv_se_allocate_key_t for more information.\0A *\0A * \5Cparam[in,out] drv_context   The driver context structure.\0A * \5Cparam[in,out] persistent_data   A pointer to the persistent data\0A *                                  that allows writing.\0A * \5Cparam[in] attributes        Attributes of the key.\0A * \5Cparam method                The way in which the key is being created.\0A * \5Cparam[in] key_slot          Slot where the key is to be stored.\0A *\0A * \5Cretval #PSA_SUCCESS\0A *         The given slot number is valid for a key with the given\0A *         attributes.\0A * \5Cretval #PSA_ERROR_INVALID_ARGUMENT\0A *         The given slot number is not valid for a key with the\0A *         given attributes. This includes the case where the slot\0A *         number is not valid at all.\0A * \5Cretval #PSA_ERROR_ALREADY_EXISTS\0A *         There is already a key with the specified slot number.\0A *         Drivers may choose to return this error from the key\0A *         creation function instead.\0A */\0Atypedef psa_status_t (*psa_drv_se_validate_slot_number_t)(\0A    psa_drv_se_context_t *drv_context,\0A    void *persistent_data,\0A    const psa_key_attributes_t *attributes,\0A    psa_key_creation_method_t method,\0A    psa_key_slot_number_t key_slot);\0A\0A/** \5Cbrief A function that imports a key into a secure element in binary format\0A *\0A * This function can support any output from psa_export_key(). Refer to the\0A * documentation of psa_export_key() for the format for each key type.\0A *\0A * \5Cparam[in,out] drv_context   The driver context structure.\0A * \5Cparam key_slot              Slot where the key will be stored.\0A *                              This must be a valid slot for a key of the\0A *                              chosen type. It must be unoccupied.\0A * \5Cparam[in] attributes        The key attributes, including the lifetime,\0A *                              the key type and the usage policy.\0A *                              Drivers should not access the key size stored\0A *                              in the attributes: it may not match the\0A *                              data passed in \5Cp data.\0A *                              Drivers can call psa_get_key_lifetime(),\0A *                              psa_get_key_type(),\0A *                              psa_get_key_usage_flags() and\0A *                              psa_get_key_algorithm() to access this\0A *                              information.\0A * \5Cparam[in] data              Buffer containing the key data.\0A * \5Cparam[in] data_length       Size of the \5Cp data buffer in bytes.\0A * \5Cparam[out] bits             On success, the key size in bits. The driver\0A *                              must determine this value after parsing the\0A *                              key according to the key type.\0A *                              This value is not used if the function fails.\0A *\0A * \5Cretval #PSA_SUCCESS\0A *         Success.\0A */\0Atypedef psa_status_t (*psa_drv_se_import_key_t)(\0A    psa_drv_se_context_t *drv_context,\0A    psa_key_slot_number_t key_slot,\0A    const psa_key_attributes_t *attributes,\0A    const uint8_t *data,\0A    size_t data_length,\0A    size_t *bits);\0A\0A/**\0A * \5Cbrief A function that destroys a secure element key and restore the slot to\0A * its default state\0A *\0A * This function destroys the content of the key from a secure element.\0A * Implementations shall make a best effort to ensure that any previous content\0A * of the slot is unrecoverable.\0A *\0A * This function returns the specified slot to its default state.\0A *\0A * \5Cparam[in,out] drv_context       The driver context structure.\0A * \5Cparam[in,out] persistent_data   A pointer to the persistent data\0A *                                  that allows writing.\0A * \5Cparam key_slot                  The key slot to erase.\0A *\0A * \5Cretval #PSA_SUCCESS\0A *         The slot's content, if any, has been erased.\0A */\0Atypedef psa_status_t (*psa_drv_se_destroy_key_t)(\0A    psa_drv_se_context_t *drv_context,\0A    void *persistent_data,\0A    psa_key_slot_number_t key_slot);\0A\0A/**\0A * \5Cbrief A function that exports a secure element key in binary format\0A *\0A * The output of this function can be passed to psa_import_key() to\0A * create an equivalent object.\0A *\0A * If a key is created with `psa_import_key()` and then exported with\0A * this function, it is not guaranteed that the resulting data is\0A * identical: the implementation may choose a different representation\0A * of the same key if the format permits it.\0A *\0A * This function should generate output in the same format that\0A * `psa_export_key()` does. Refer to the\0A * documentation of `psa_export_key()` for the format for each key type.\0A *\0A * \5Cparam[in,out] drv_context   The driver context structure.\0A * \5Cparam[in] key               Slot whose content is to be exported. This must\0A *                              be an occupied key slot.\0A * \5Cparam[out] p_data           Buffer where the key data is to be written.\0A * \5Cparam[in] data_size         Size of the `p_data` buffer in bytes.\0A * \5Cparam[out] p_data_length    On success, the number of bytes\0A *                              that make up the key data.\0A *\0A * \5Cretval #PSA_SUCCESS \5Cemptydescription\0A * \5Cretval #PSA_ERROR_DOES_NOT_EXIST \5Cemptydescription\0A * \5Cretval #PSA_ERROR_NOT_PERMITTED \5Cemptydescription\0A * \5Cretval #PSA_ERROR_NOT_SUPPORTED \5Cemptydescription\0A * \5Cretval #PSA_ERROR_COMMUNICATION_FAILURE \5Cemptydescription\0A * \5Cretval #PSA_ERROR_HARDWARE_FAILURE \5Cemptydescription\0A * \5Cretval #PSA_ERROR_CORRUPTION_DETECTED \5Cemptydescription\0A */\0Atypedef psa_status_t (*psa_drv_se_export_key_t)(psa_drv_se_context_t *drv_context,\0A                                                psa_key_slot_number_t key,\0A                                                uint8_t *p_data,\0A                                                size_t data_size,\0A                                                size_t *p_data_length);\0A\0A/**\0A * \5Cbrief A function that generates a symmetric or asymmetric key on a secure\0A * element\0A *\0A * If the key type \5Cc type recorded in \5Cp attributes\0A * is asymmetric (#PSA_KEY_TYPE_IS_ASYMMETRIC(\5Cc type) = 1),\0A * the driver may export the public key at the time of generation,\0A * in the format documented for psa_export_public_key() by writing it\0A * to the \5Cp pubkey buffer.\0A * This is optional, intended for secure elements that output the\0A * public key at generation time and that cannot export the public key\0A * later. Drivers that do not need this feature should leave\0A * \5Cp *pubkey_length set to 0 and should\0A * implement the psa_drv_key_management_t::p_export_public function.\0A * Some implementations do not support this feature, in which case\0A * \5Cp pubkey is \5Cc NULL and \5Cp pubkey_size is 0.\0A *\0A * \5Cparam[in,out] drv_context   The driver context structure.\0A * \5Cparam key_slot              Slot where the key will be stored.\0A *                              This must be a valid slot for a key of the\0A *                              chosen type. It must be unoccupied.\0A * \5Cparam[in] attributes        The key attributes, including the lifetime,\0A *                              the key type and size, and the usage policy.\0A *                              Drivers can call psa_get_key_lifetime(),\0A *                              psa_get_key_type(), psa_get_key_bits(),\0A *                              psa_get_key_usage_flags() and\0A *                              psa_get_key_algorithm() to access this\0A *                              information.\0A * \5Cparam[out] pubkey           A buffer where the driver can write the\0A *                              public key, when generating an asymmetric\0A *                              key pair.\0A *                              This is \5Cc NULL when generating a symmetric\0A *                              key or if the core does not support\0A *                              exporting the public key at generation time.\0A * \5Cparam pubkey_size           The size of the `pubkey` buffer in bytes.\0A *                              This is 0 when generating a symmetric\0A *                              key or if the core does not support\0A *                              exporting the public key at generation time.\0A * \5Cparam[out] pubkey_length    On entry, this is always 0.\0A *                              On success, the number of bytes written to\0A *                              \5Cp pubkey. If this is 0 or unchanged on return,\0A *                              the core will not read the \5Cp pubkey buffer,\0A *                              and will instead call the driver's\0A *                              psa_drv_key_management_t::p_export_public\0A *                              function to export the public key when needed.\0A */\0Atypedef psa_status_t (*psa_drv_se_generate_key_t)(\0A    psa_drv_se_context_t *drv_context,\0A    psa_key_slot_number_t key_slot,\0A    const psa_key_attributes_t *attributes,\0A    uint8_t *pubkey, size_t pubkey_size, size_t *pubkey_length);\0A\0A/**\0A * \5Cbrief A struct containing all of the function pointers needed to for secure\0A * element key management\0A *\0A * PSA Crypto API implementations should populate instances of the table as\0A * appropriate upon startup or at build time.\0A *\0A * If one of the functions is not implemented, it should be set to NULL.\0A */\0Atypedef struct {\0A    /** Function that allocates a slot for a key. */\0A    psa_drv_se_allocate_key_t   MBEDTLS_PRIVATE(p_allocate);\0A    /** Function that checks the validity of a slot for a key. */\0A    psa_drv_se_validate_slot_number_t MBEDTLS_PRIVATE(p_validate_slot_number);\0A    /** Function that performs a key import operation */\0A    psa_drv_se_import_key_t     MBEDTLS_PRIVATE(p_import);\0A    /** Function that performs a generation */\0A    psa_drv_se_generate_key_t   MBEDTLS_PRIVATE(p_generate);\0A    /** Function that performs a key destroy operation */\0A    psa_drv_se_destroy_key_t    MBEDTLS_PRIVATE(p_destroy);\0A    /** Function that performs a key export operation */\0A    psa_drv_se_export_key_t     MBEDTLS_PRIVATE(p_export);\0A    /** Function that performs a public key export operation */\0A    psa_drv_se_export_key_t     MBEDTLS_PRIVATE(p_export_public);\0A} psa_drv_se_key_management_t;\0A\0A/**@}*/\0A\0A/** \5Cdefgroup driver_derivation Secure Element Key Derivation and Agreement\0A * Key derivation is the process of generating new key material using an\0A * existing key and additional parameters, iterating through a basic\0A * cryptographic function, such as a hash.\0A * Key agreement is a part of cryptographic protocols that allows two parties\0A * to agree on the same key value, but starting from different original key\0A * material.\0A * The flows are similar, and the PSA Crypto Driver Model uses the same functions\0A * for both of the flows.\0A *\0A * There are two different final functions for the flows,\0A * `psa_drv_se_key_derivation_derive` and `psa_drv_se_key_derivation_export`.\0A * `psa_drv_se_key_derivation_derive` is used when the key material should be\0A * placed in a slot on the hardware and not exposed to the caller.\0A * `psa_drv_se_key_derivation_export` is used when the key material should be\0A * returned to the PSA Cryptographic API implementation.\0A *\0A * Different key derivation algorithms require a different number of inputs.\0A * Instead of having an API that takes as input variable length arrays, which\0A * can be problematic to manage on embedded platforms, the inputs are passed\0A * to the driver via a function, `psa_drv_se_key_derivation_collateral`, that\0A * is called multiple times with different `collateral_id`s. Thus, for a key\0A * derivation algorithm that required 3 parameter inputs, the flow would look\0A * something like:\0A * ~~~~~~~~~~~~~{.c}\0A * psa_drv_se_key_derivation_setup(kdf_algorithm, source_key, dest_key_size_bytes);\0A * psa_drv_se_key_derivation_collateral(kdf_algorithm_collateral_id_0,\0A *                                      p_collateral_0,\0A *                                      collateral_0_size);\0A * psa_drv_se_key_derivation_collateral(kdf_algorithm_collateral_id_1,\0A *                                      p_collateral_1,\0A *                                      collateral_1_size);\0A * psa_drv_se_key_derivation_collateral(kdf_algorithm_collateral_id_2,\0A *                                      p_collateral_2,\0A *                                      collateral_2_size);\0A * psa_drv_se_key_derivation_derive();\0A * ~~~~~~~~~~~~~\0A *\0A * key agreement example:\0A * ~~~~~~~~~~~~~{.c}\0A * psa_drv_se_key_derivation_setup(alg, source_key. dest_key_size_bytes);\0A * psa_drv_se_key_derivation_collateral(DHE_PUBKEY, p_pubkey, pubkey_size);\0A * psa_drv_se_key_derivation_export(p_session_key,\0A *                                  session_key_size,\0A *                                  &session_key_length);\0A * ~~~~~~~~~~~~~\0A */\0A/**@{*/\0A\0A/** \5Cbrief A function that Sets up a secure element key derivation operation by\0A * specifying the algorithm and the source key sot\0A *\0A * \5Cparam[in,out] drv_context   The driver context structure.\0A * \5Cparam[in,out] op_context    A hardware-specific structure containing any\0A *                              context information for the implementation\0A * \5Cparam[in] kdf_alg           The algorithm to be used for the key derivation\0A * \5Cparam[in] source_key        The key to be used as the source material for\0A *                              the key derivation\0A *\0A * \5Cretval #PSA_SUCCESS \5Cemptydescription\0A */\0Atypedef psa_status_t (*psa_drv_se_key_derivation_setup_t)(psa_drv_se_context_t *drv_context,\0A                                                          void *op_context,\0A                                                          psa_algorithm_t kdf_alg,\0A                                                          psa_key_slot_number_t source_key);\0A\0A/** \5Cbrief A function that provides collateral (parameters) needed for a secure\0A * element key derivation or key agreement operation\0A *\0A * Since many key derivation algorithms require multiple parameters, it is\0A * expected that this function may be called multiple times for the same\0A * operation, each with a different algorithm-specific `collateral_id`\0A *\0A * \5Cparam[in,out] op_context    A hardware-specific structure containing any\0A *                              context information for the implementation\0A * \5Cparam[in] collateral_id     An ID for the collateral being provided\0A * \5Cparam[in] p_collateral      A buffer containing the collateral data\0A * \5Cparam[in] collateral_size   The size in bytes of the collateral\0A *\0A * \5Cretval #PSA_SUCCESS \5Cemptydescription\0A */\0Atypedef psa_status_t (*psa_drv_se_key_derivation_collateral_t)(void *op_context,\0A                                                               uint32_t collateral_id,\0A                                                               const uint8_t *p_collateral,\0A                                                               size_t collateral_size);\0A\0A/** \5Cbrief A function that performs the final secure element key derivation\0A * step and place the generated key material in a slot\0A *\0A * \5Cparam[in,out] op_context    A hardware-specific structure containing any\0A *                              context information for the implementation\0A * \5Cparam[in] dest_key          The slot where the generated key material\0A *                              should be placed\0A *\0A * \5Cretval #PSA_SUCCESS \5Cemptydescription\0A */\0Atypedef psa_status_t (*psa_drv_se_key_derivation_derive_t)(void *op_context,\0A                                                           psa_key_slot_number_t dest_key);\0A\0A/** \5Cbrief A function that performs the final step of a secure element key\0A * agreement and place the generated key material in a buffer\0A *\0A * \5Cparam[out] p_output         Buffer in which to place the generated key\0A *                              material\0A * \5Cparam[in] output_size       The size in bytes of `p_output`\0A * \5Cparam[out] p_output_length  Upon success, contains the number of bytes of\0A *                              key material placed in `p_output`\0A *\0A * \5Cretval #PSA_SUCCESS \5Cemptydescription\0A */\0Atypedef psa_status_t (*psa_drv_se_key_derivation_export_t)(void *op_context,\0A                                                           uint8_t *p_output,\0A                                                           size_t output_size,\0A                                                           size_t *p_output_length);\0A\0A/**\0A * \5Cbrief A struct containing all of the function pointers needed to for secure\0A * element key derivation and agreement\0A *\0A * PSA Crypto API implementations should populate instances of the table as\0A * appropriate upon startup.\0A *\0A * If one of the functions is not implemented, it should be set to NULL.\0A */\0Atypedef struct {\0A    /** The driver-specific size of the key derivation context */\0A    size_t                           MBEDTLS_PRIVATE(context_size);\0A    /** Function that performs a key derivation setup */\0A    psa_drv_se_key_derivation_setup_t      MBEDTLS_PRIVATE(p_setup);\0A    /** Function that sets key derivation collateral */\0A    psa_drv_se_key_derivation_collateral_t MBEDTLS_PRIVATE(p_collateral);\0A    /** Function that performs a final key derivation step */\0A    psa_drv_se_key_derivation_derive_t     MBEDTLS_PRIVATE(p_derive);\0A    /** Function that performs a final key derivation or agreement and\0A     * exports the key */\0A    psa_drv_se_key_derivation_export_t     MBEDTLS_PRIVATE(p_export);\0A} psa_drv_se_key_derivation_t;\0A\0A/**@}*/\0A\0A/** \5Cdefgroup se_registration Secure element driver registration\0A */\0A/**@{*/\0A\0A/** A structure containing pointers to all the entry points of a\0A * secure element driver.\0A *\0A * Future versions of this specification may add extra substructures at\0A * the end of this structure.\0A */\0Atypedef struct {\0A    /** The version of the driver HAL that this driver implements.\0A     * This is a protection against loading driver binaries built against\0A     * a different version of this specification.\0A     * Use #PSA_DRV_SE_HAL_VERSION.\0A     */\0A    uint32_t MBEDTLS_PRIVATE(hal_version);\0A\0A    /** The size of the driver's persistent data in bytes.\0A     *\0A     * This can be 0 if the driver does not need persistent data.\0A     *\0A     * See the documentation of psa_drv_se_context_t::persistent_data\0A     * for more information about why and how a driver can use\0A     * persistent data.\0A     */\0A    size_t MBEDTLS_PRIVATE(persistent_data_size);\0A\0A    /** The driver initialization function.\0A     *\0A     * This function is called once during the initialization of the\0A     * PSA Cryptography subsystem, before any other function of the\0A     * driver is called. If this function returns a failure status,\0A     * the driver will be unusable, at least until the next system reset.\0A     *\0A     * If this field is \5Cc NULL, it is equivalent to a function that does\0A     * nothing and returns #PSA_SUCCESS.\0A     */\0A    psa_drv_se_init_t MBEDTLS_PRIVATE(p_init);\0A\0A    const psa_drv_se_key_management_t *MBEDTLS_PRIVATE(key_management);\0A    const psa_drv_se_mac_t *MBEDTLS_PRIVATE(mac);\0A    const psa_drv_se_cipher_t *MBEDTLS_PRIVATE(cipher);\0A    const psa_drv_se_aead_t *MBEDTLS_PRIVATE(aead);\0A    const psa_drv_se_asymmetric_t *MBEDTLS_PRIVATE(asymmetric);\0A    const psa_drv_se_key_derivation_t *MBEDTLS_PRIVATE(derivation);\0A} psa_drv_se_t;\0A\0A/** The current version of the secure element driver HAL.\0A */\0A/* 0.0.0 patchlevel 5 */\0A#define PSA_DRV_SE_HAL_VERSION 0x00000005\0A\0A/** Register an external cryptoprocessor (secure element) driver.\0A *\0A * This function is only intended to be used by driver code, not by\0A * application code. In implementations with separation between the\0A * PSA cryptography module and applications, this function should\0A * only be available to callers that run in the same memory space as\0A * the cryptography module, and should not be exposed to applications\0A * running in a different memory space.\0A *\0A * This function may be called before psa_crypto_init(). It is\0A * implementation-defined whether this function may be called\0A * after psa_crypto_init().\0A *\0A * \5Cnote Implementations store metadata about keys including the lifetime\0A *       value, which contains the driver's location indicator. Therefore,\0A *       from one instantiation of the PSA Cryptography\0A *       library to the next one, if there is a key in storage with a certain\0A *       lifetime value, you must always register the same driver (or an\0A *       updated version that communicates with the same secure element)\0A *       with the same location value.\0A *\0A * \5Cparam location      The location value through which this driver will\0A *                      be exposed to applications.\0A *                      This driver will be used for all keys such that\0A *                      `location == #PSA_KEY_LIFETIME_GET_LOCATION( lifetime )`.\0A *                      The value #PSA_KEY_LOCATION_LOCAL_STORAGE is reserved\0A *                      and may not be used for drivers. Implementations\0A *                      may reserve other values.\0A * \5Cparam[in] methods   The method table of the driver. This structure must\0A *                      remain valid for as long as the cryptography\0A *                      module keeps running. It is typically a global\0A *                      constant.\0A *\0A * \5Creturn #PSA_SUCCESS\0A *         The driver was successfully registered. Applications can now\0A *         use \5Cp location to access keys through the methods passed to\0A *         this function.\0A * \5Creturn #PSA_ERROR_BAD_STATE\0A *         This function was called after the initialization of the\0A *         cryptography module, and this implementation does not support\0A *         driver registration at this stage.\0A * \5Creturn #PSA_ERROR_ALREADY_EXISTS\0A *         There is already a registered driver for this value of \5Cp location.\0A * \5Creturn #PSA_ERROR_INVALID_ARGUMENT\0A *         \5Cp location is a reserved value.\0A * \5Creturn #PSA_ERROR_NOT_SUPPORTED\0A *         `methods->hal_version` is not supported by this implementation.\0A * \5Creturn #PSA_ERROR_INSUFFICIENT_MEMORY\0A * \5Creturn #PSA_ERROR_NOT_PERMITTED\0A * \5Creturn #PSA_ERROR_STORAGE_FAILURE\0A * \5Creturn #PSA_ERROR_DATA_CORRUPT\0A */\0Apsa_status_t psa_register_se_driver(\0A    psa_key_location_t location,\0A    const psa_drv_se_t *methods);\0A\0A/**@}*/\0A\0A#ifdef __cplusplus\0A}\0A#endif\0A\0A#endif /* PSA_CRYPTO_SE_DRIVER_H */\0A\00" }
