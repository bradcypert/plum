@.str45352 = private global { i64, i64, [122593 x i8] } { i64 -1, i64 122592, [122593 x i8] c"/**\0A * \5Cfile psa/crypto_values.h\0A *\0A * \5Cbrief PSA cryptography module: macros to build and analyze integer values.\0A *\0A * \5Cnote This file may not be included directly. Applications must\0A * include psa/crypto.h. Drivers must include the appropriate driver\0A * header file.\0A *\0A * This file contains portable definitions of macros to build and analyze\0A * values of integral types that encode properties of cryptographic keys,\0A * designations of cryptographic algorithms, and error codes returned by\0A * the library.\0A *\0A * Note that many of the constants defined in this file are embedded in\0A * the persistent key store, as part of key metadata (including usage\0A * policies). As a consequence, they must not be changed (unless the storage\0A * format version changes).\0A *\0A * This header file only defines preprocessor macros.\0A */\0A/*\0A *  Copyright The Mbed TLS Contributors\0A *  SPDX-License-Identifier: Apache-2.0 OR GPL-2.0-or-later\0A */\0A\0A#ifndef PSA_CRYPTO_VALUES_H\0A#define PSA_CRYPTO_VALUES_H\0A#include \22mbedtls/private_access.h\22\0A\0A/** \5Cdefgroup error Error codes\0A * @{\0A */\0A\0A/* PSA error codes */\0A\0A/* Error codes are standardized across PSA domains (framework, crypto, storage,\0A * etc.). Do not change the values in this section or even the expansions\0A * of each macro: it must be possible to `#include` both this header\0A * and some other PSA component's headers in the same C source,\0A * which will lead to duplicate definitions of the `PSA_SUCCESS` and\0A * `PSA_ERROR_xxx` macros, which is ok if and only if the macros expand\0A * to the same sequence of tokens.\0A *\0A * If you must add a new\0A * value, check with the Arm PSA framework group to pick one that other\0A * domains aren't already using. */\0A\0A/* Tell uncrustify not to touch the constant definitions, otherwise\0A * it might change the spacing to something that is not PSA-compliant\0A * (e.g. adding a space after casts).\0A *\0A * *INDENT-OFF*\0A */\0A\0A/** The action was completed successfully. */\0A#define PSA_SUCCESS ((psa_status_t)0)\0A\0A/** An error occurred that does not correspond to any defined\0A * failure cause.\0A *\0A * Implementations may use this error code if none of the other standard\0A * error codes are applicable. */\0A#define PSA_ERROR_GENERIC_ERROR         ((psa_status_t)-132)\0A\0A/** The requested operation or a parameter is not supported\0A * by this implementation.\0A *\0A * Implementations should return this error code when an enumeration\0A * parameter such as a key type, algorithm, etc. is not recognized.\0A * If a combination of parameters is recognized and identified as\0A * not valid, return #PSA_ERROR_INVALID_ARGUMENT instead. */\0A#define PSA_ERROR_NOT_SUPPORTED         ((psa_status_t)-134)\0A\0A/** The requested action is denied by a policy.\0A *\0A * Implementations should return this error code when the parameters\0A * are recognized as valid and supported, and a policy explicitly\0A * denies the requested operation.\0A *\0A * If a subset of the parameters of a function call identify a\0A * forbidden operation, and another subset of the parameters are\0A * not valid or not supported, it is unspecified whether the function\0A * returns #PSA_ERROR_NOT_PERMITTED, #PSA_ERROR_NOT_SUPPORTED or\0A * #PSA_ERROR_INVALID_ARGUMENT. */\0A#define PSA_ERROR_NOT_PERMITTED         ((psa_status_t)-133)\0A\0A/** An output buffer is too small.\0A *\0A * Applications can call the \5Cc PSA_xxx_SIZE macro listed in the function\0A * description to determine a sufficient buffer size.\0A *\0A * Implementations should preferably return this error code only\0A * in cases when performing the operation with a larger output\0A * buffer would succeed. However implementations may return this\0A * error if a function has invalid or unsupported parameters in addition\0A * to the parameters that determine the necessary output buffer size. */\0A#define PSA_ERROR_BUFFER_TOO_SMALL      ((psa_status_t)-138)\0A\0A/** Asking for an item that already exists\0A *\0A * Implementations should return this error, when attempting\0A * to write an item (like a key) that already exists. */\0A#define PSA_ERROR_ALREADY_EXISTS        ((psa_status_t)-139)\0A\0A/** Asking for an item that doesn't exist\0A *\0A * Implementations should return this error, if a requested item (like\0A * a key) does not exist. */\0A#define PSA_ERROR_DOES_NOT_EXIST        ((psa_status_t)-140)\0A\0A/** The requested action cannot be performed in the current state.\0A *\0A * Multipart operations return this error when one of the\0A * functions is called out of sequence. Refer to the function\0A * descriptions for permitted sequencing of functions.\0A *\0A * Implementations shall not return this error code to indicate\0A * that a key either exists or not,\0A * but shall instead return #PSA_ERROR_ALREADY_EXISTS or #PSA_ERROR_DOES_NOT_EXIST\0A * as applicable.\0A *\0A * Implementations shall not return this error code to indicate that a\0A * key identifier is invalid, but shall return #PSA_ERROR_INVALID_HANDLE\0A * instead. */\0A#define PSA_ERROR_BAD_STATE             ((psa_status_t)-137)\0A\0A/** The parameters passed to the function are invalid.\0A *\0A * Implementations may return this error any time a parameter or\0A * combination of parameters are recognized as invalid.\0A *\0A * Implementations shall not return this error code to indicate that a\0A * key identifier is invalid, but shall return #PSA_ERROR_INVALID_HANDLE\0A * instead.\0A */\0A#define PSA_ERROR_INVALID_ARGUMENT      ((psa_status_t)-135)\0A\0A/** There is not enough runtime memory.\0A *\0A * If the action is carried out across multiple security realms, this\0A * error can refer to available memory in any of the security realms. */\0A#define PSA_ERROR_INSUFFICIENT_MEMORY   ((psa_status_t)-141)\0A\0A/** There is not enough persistent storage.\0A *\0A