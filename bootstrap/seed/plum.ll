@.str45707 = private global { i64, i64, [277134 x i8] } { i64 -1, i64 277133, [277134 x i8] c"/**\0A * \5Cfile ssl.h\0A *\0A * \5Cbrief SSL/TLS functions.\0A */\0A/*\0A *  Copyright The Mbed TLS Contributors\0A *  SPDX-License-Identifier: Apache-2.0 OR GPL-2.0-or-later\0A */\0A#ifndef MBEDTLS_SSL_H\0A#define MBEDTLS_SSL_H\0A#include \22mbedtls/platform_util.h\22\0A#include \22mbedtls/private_access.h\22\0A\0A#include \22mbedtls/build_info.h\22\0A\0A#include \22mbedtls/bignum.h\22\0A#include \22mbedtls/ecp.h\22\0A\0A#include \22mbedtls/ssl_ciphersuites.h\22\0A\0A#if defined(MBEDTLS_X509_CRT_PARSE_C)\0A#include \22mbedtls/x509_crt.h\22\0A#include \22mbedtls/x509_crl.h\22\0A#endif\0A\0A#if defined(MBEDTLS_DHM_C)\0A#include \22mbedtls/dhm.h\22\0A#endif\0A\0A#include \22mbedtls/md.h\22\0A\0A#if defined(MBEDTLS_KEY_EXCHANGE_SOME_ECDH_OR_ECDHE_ANY_ENABLED)\0A#include \22mbedtls/ecdh.h\22\0A#endif\0A\0A#if defined(MBEDTLS_HAVE_TIME)\0A#include \22mbedtls/platform_time.h\22\0A#endif\0A\0A#include \22psa/crypto.h\22\0A\0A/*\0A * SSL Error codes\0A */\0A/** A cryptographic operation is in progress. Try again later. */\0A#define MBEDTLS_ERR_SSL_CRYPTO_IN_PROGRESS                -0x7000\0A/** The requested feature is not available. */\0A#define MBEDTLS_ERR_SSL_FEATURE_UNAVAILABLE               -0x7080\0A/** Bad input parameters to function. */\0A#define MBEDTLS_ERR_SSL_BAD_INPUT_DATA                    -0x7100\0A/** Verification of the message MAC failed. */\0A#define MBEDTLS_ERR_SSL_INVALID_MAC                       -0x7180\0A/** An invalid SSL record was received. */\0A#define MBEDTLS_ERR_SSL_INVALID_RECORD                    -0x7200\0A/** The connection indicated an EOF. */\0A#define MBEDTLS_ERR_SSL_CONN_EOF                          -0x7280\0A/** A message could not be parsed due to a syntactic error. */\0A#define MBEDTLS_ERR_SSL_DECODE_ERROR                      -0x7300\0A/* Error space gap */\0A/** No RNG was provided to the SSL module. */\0A#define MBEDTLS_ERR_SSL_NO_RNG                            -0x7400\0A/** No client certification received from the client, but required by the authentication mode. */\0A#define MBEDTLS_ERR_SSL_NO_CLIENT_CERTIFICATE             -0x7480\0A/** Client received an extended server hello containing an unsupported extension */\0A#define MBEDTLS_ERR_SSL_UNSUPPORTED_EXTENSION             -0x7500\0A/** No ALPN protocols supported that the client advertises */\0A#define MBEDTLS_ERR_SSL_NO_APPLICATION_PROTOCOL           -0x7580\0A/** The own private key or pre-shared key is not set, but needed. */\0A#define MBEDTLS_ERR_SSL_PRIVATE_KEY_REQUIRED              -0x7600\0A/** No CA Chain is set, but required to operate. */\0A#define MBEDTLS_ERR_SSL_CA_CHAIN_REQUIRED                 -0x7680\0A/** An unexpected message was received from our peer. */\0A#define MBEDTLS_ERR_SSL_UNEXPECTED_MESSAGE                -0x7700\0A/** A fatal alert message was received from our peer. */\0A#define MBEDTLS_ERR_SSL_FATAL_ALERT_MESSAGE               -0x7780\0A/** No server could be identified matching the client's SNI. */\0A#define MBEDTLS_ERR_SSL_UNRECOGNIZED_NAME                 -0x7800\0A/** The peer notified us that the connection is going to be closed. */\0A#define MBEDTLS_ERR_SSL_PEER_CLOSE_NOTIFY                 -0x7880\0A/* Error space gap */\0A/* Error space gap */\0A/** Processing of the Certificate handshake message failed. */\0A#define MBEDTLS_ERR_SSL_BAD_CERTIFICATE                   -0x7A00\0A/* Error space gap */\0A/** A TLS 1.3 NewSessionTicket message has been received. */\0A#define MBEDTLS_ERR_SSL_RECEIVED_NEW_SESSION_TICKET       -0x7B00\0A/** Not possible to read early data */\0A#define MBEDTLS_ERR_SSL_CANNOT_READ_EARLY_DATA            -0x7B80\0A/**\0A * Early data has been received as part of an on-going handshake.\0A * This error code can be returned only on server side if and only if early\0A * data has been enabled by means of the mbedtls_ssl_conf_early_data() API.\0A * This error code can then be returned by mbedtls_ssl_handshake(),\0A * mbedtls_ssl_handshake_step(), mbedtls_ssl_read() or mbedtls_ssl_write() if\0A * early data has been received as part of the handshake sequence they\0A * triggered. To read the early data, call mbedtls_ssl_read_early_data().\0A */\0A#define MBEDTLS_ERR_SSL_RECEIVED_EARLY_DATA               -0x7C00\0A/** Not possible to write early data */\0A#define MBEDTLS_ERR_SSL_CANNOT_WRITE_EARLY_DATA           -0x7C80\0A/* Error space gap */\0A/* Error space gap */\0A/* Error space gap */\0A/* Error space gap */\0A/** Cache entry not found */\0A#define MBEDTLS_ERR_SSL_CACHE_ENTRY_NOT_FOUND             -0x7E80\0A/** Memory allocation failed */\0A#define MBEDTLS_ERR_SSL_ALLOC_FAILED                      -0x7F00\0A/** Hardware acceleration function returned with error */\0A#define MBEDTLS_ERR_SSL_HW_ACCEL_FAILED                   -0x7F80\0A/** Hardware acceleration function skipped / left alone data */\0A#define MBEDTLS_ERR_SSL_HW_ACCEL_FALLTHROUGH              -0x6F80\0A/** Handshake protocol not within min/max boundaries */\0A#define MBEDTLS_ERR_SSL_BAD_PROTOCOL_VERSION              -0x6E80\0A/** The handshake negotiation failed. */\0A#define MBEDTLS_ERR_SSL_HANDSHAKE_FAILURE                 -0x6E00\0A/** Session ticket has expired. */\0A#define MBEDTLS_ERR_SSL_SESSION_TICKET_EXPIRED            -0x6D80\0A/** Public key type mismatch (eg, asked for RSA key exchange and presented EC key) */\0A#define MBEDTLS_ERR_SSL_PK_TYPE_MISMATCH                  -0x6D00\0A/** Unknown identity received (eg, PSK identity) */\0A#define MBEDTLS_ERR_SSL_UNKNOWN_IDENTITY                  -0x6C80\0A/** Internal error (eg, unexpected failure in lower-level module) */\0A#define MBEDTLS_ERR_SSL_INTERNAL_ERROR                    -0x6C00\0A/** A counter would wrap (eg, too many messages exchanged). */\0A#define MBEDTLS_ERR_SSL_COUNTER_WRAPPING                  -0x6B80\0A/** Unexpected message at ServerHello in renegotiation. */\0A#define MBEDTLS_ERR_SSL_WAITING_SERVER_HELLO_RENEGO       -0x6B00\0A/** DTLS client must retry for hello verification */\0A#define MBEDTLS_ERR_SSL_HELLO_VERIFY_REQUIRED             -0x6A80\0A/** A buffer is too small to receive or write a message */\0A#define MBEDTLS_ERR_SSL_BUFFER_TOO_SMALL                  -0x6A00\0A/* Error space gap */\0A/** No data of requested type currently available on underlying transport. */\0A#define MBEDTLS_ERR_SSL_WANT_READ                         -0x6900\0A/** Connection requires a write call. */\0A#define MBEDTLS_ERR_SSL_WANT_WRITE                        -0x6880\0A/** The operation timed out. */\0A#define MBEDTLS_ERR_SSL_TIMEOUT                           -0x6800\0A/** The client initiated a reconnect from the same port. */\0A#define MBEDTLS_ERR_SSL_CLIENT_RECONNECT                  -0x6780\0A/** Record header looks valid but is not expected. */\0A#define MBEDTLS_ERR_SSL_UNEXPECTED_RECORD                 -0x6700\0A/** The alert message received indicates a non-fatal error. */\0A#define MBEDTLS_ERR_SSL_NON_FATAL                         -0x6680\0A/** A field in a message was incorrect or inconsistent with other fields. */\0A#define MBEDTLS_ERR_SSL_ILLEGAL_PARAMETER                 -0x6600\0A/** Internal-only message signaling that further message-processing should be done */\0A#define MBEDTLS_ERR_SSL_CONTINUE_PROCESSING               -0x6580\0A/** The asynchronous operation is not completed yet. */\0A#define MBEDTLS_ERR_SSL_ASYNC_IN_PROGRESS                 -0x6500\0A/** Internal-only message signaling that a message arrived early. */\0A#define MBEDTLS_ERR_SSL_EARLY_MESSAGE                     -0x6480\0A/* Error space gap */\0A/* Error space gap */\0A/* Error space gap */\0A/* Error space gap */\0A/* Error space gap */\0A/* Error space gap */\0A/* Error space gap */\0A/* Error space gap */\0A/** An encrypted DTLS-frame with an unexpected CID was received. */\0A#define MBEDTLS_ERR_SSL_UNEXPECTED_CID                    -0x6000\0A/** An operation failed due to an unexpected version or configuration. */\0A#define MBEDTLS_ERR_SSL_VERSION_MISMATCH                  -0x5F00\0A/** Invalid value in SSL config */\0A#define MBEDTLS_ERR_SSL_BAD_CONFIG                        -0x5E80\0A/* Error space gap */\0A/** Attempt to verify a certificate without an expected hostname.\0A * This is usually insecure.\0A *\0A * In TLS clients, when a client authenticates a server through its\0A * certificate, the client normally checks three things:\0A * - the certificate chain must be valid;\0A * - the chain must start from a trusted CA;\0A * - the certificate must cover the server name that is expected by the client.\0A *\0A * Omitting any of these checks is generally insecure, and can allow a\0A * malicious server to impersonate a legitimate server.\0A *\0A * The third check may be safely skipped in some unusual scenarios,\0A * such as networks where eavesdropping is a risk but not active attacks,\0A * or a private PKI where the client equally trusts all servers that are\0A * accredited by the root CA.\0A *\0A * You should call mbedtls_ssl_set_hostname() with the expected server name\0A * before starting a TLS handshake on a client (unless the client is\0A * set up to only use PSK-based authentication, which does not rely on the\0A * host name). If you have determined that server name verification is not\0A * required for security in your scenario, call mbedtls_ssl_set_hostname()\0A * with \5Cp NULL as the server name.\0A *\0A * This error is raised if all of the following conditions are met:\0A *\0A * - A TLS client is configured with the authentication mode\0A *   #MBEDTLS_SSL_VERIFY_REQUIRED (default).\0A * - Certificate authentication is enabled.\0A * - The client does not call mbedtls_ssl_set_hostname().\0A * - The configuration option\0A *   #MBEDTLS_SSL_CLI_ALLOW_WEAK_CERTIFICATE_VERIFICATION_WITHOUT_HOSTNAME\0A *   is not enabled.\0A */\0A#define MBEDTLS_ERR_SSL_CERTIFICATE_VERIFICATION_WITHOUT_HOSTNAME  -0x5D80\0A\0A/*\0A * Constants from RFC 8446 for TLS 1.3 PSK modes\0A *\0A * Those are used in the Pre-Shared Key Exchange Modes extension.\0A * See Section 4.2.9 in RFC 8446.\0A */\0A#define MBEDTLS_SSL_TLS1_3_PSK_MODE_PURE  0 /* Pure PSK-based exchange  */\0A#define MBEDTLS_SSL_TLS1_3_PSK_MODE_ECDHE 1 /* PSK+ECDHE-based exchange */\0A\0A/*\0A * TLS 1.3 NamedGroup values\0A *\0A * From RF 8446\0A *    enum {\0A *         // Elliptic Curve Groups (ECDHE)\0A *         secp256r1(0x0017), secp384r1(0x0018), secp521r1(0x0019),\0A *         x25519(0x001D), x448(0x001E),\0A *         // Finite Field Groups (DHE)\0A *         ffdhe2048(0x0100), ffdhe3072(0x0101), ffdhe4096(0x0102),\0A *         ffdhe6144(0x0103), ffdhe8192(0x0104),\0A *         // Reserved Code Points\0A *         ffdhe_private_use(0x01FC..0x01FF),\0A *         ecdhe_private_use(0xFE00..0xFEFF),\0A *         (0xFFFF)\0A *     } NamedGroup;\0A *\0A */\0A\0A/* Elliptic Curve Groups (ECDHE) */\0A#define MBEDTLS_SSL_IANA_TLS_GROUP_NONE               0\0A#define MBEDTLS_SSL_IANA_TLS_GROUP_SECP192K1     0x0012\0A#define MBEDTLS_SSL_IANA_TLS_GROUP_SECP192R1     0x0013\0A#define MBEDTLS_SSL_IANA_TLS_GROUP_SECP224K1     0x0014\0A#define MBEDTLS_SSL_IANA_TLS_GROUP_SECP224R1     0x0015\0A#define MBEDTLS_SSL_IANA_TLS_GROUP_SECP256K1     0x0016\0A#define MBEDTLS_SSL_IANA_TLS_GROUP_SECP256R1     0x0017\0A#define MBEDTLS_SSL_IANA_TLS_GROUP_SECP384R1     0x0018\0A#define MBEDTLS_SSL_IANA_TLS_GROUP_SECP521R1     0x0019\0A#define MBEDTLS_SSL_IANA_TLS_GROUP_BP256R1       0x001A\0A#define MBEDTLS_SSL_IANA_TLS_GROUP_BP384R1       0x001B\0A#define MBEDTLS_SSL_IANA_TLS_GROUP_BP512R1       0x001C\0A#define MBEDTLS_SSL_IANA_TLS_GROUP_X25519        0x001D\0A#define MBEDTLS_SSL_IANA_TLS_GROUP_X448          0x001E\0A/* Finite Field Groups (DHE) */\0A#define MBEDTLS_SSL_IANA_TLS_GROUP_FFDHE2048     0x0100\0A#define MBEDTLS_SSL_IANA_TLS_GROUP_FFDHE3072     0x0101\0A#define MBEDTLS_SSL_IANA_TLS_GROUP_FFDHE4096     0x0102\0A#define MBEDTLS_SSL_IANA_TLS_GROUP_FFDHE6144     0x0103\0A#define MBEDTLS_SSL_IANA_TLS_GROUP_FFDHE8192     0x0104\0A\0A/*\0A * TLS 1.3 Key Exchange Modes\0A *\0A * Mbed TLS internal identifiers for use with the SSL configuration API\0A * mbedtls_ssl_conf_tls13_key_exchange_modes().\0A */\0A\0A#define MBEDTLS_SSL_TLS1_3_KEY_EXCHANGE_MODE_PSK            (1u << 0)   /*!< Pure-PSK TLS 1.3 key exchange,\0A                                                                         *   encompassing both externally agreed PSKs\0A                                                                         *   as well as resumption PSKs. */\0A#define MBEDTLS_SSL_TLS1_3_KEY_EXCHANGE_MODE_EPHEMERAL      (1u << 1)   /*!< Pure-Ephemeral TLS 1.3 key exchanges,\0A                                                                         *   including for example ECDHE and DHE\0A                                                                         *   key exchanges. */\0A#define MBEDTLS_SSL_TLS1_3_KEY_EXCHANGE_MODE_PSK_EPHEMERAL  (1u << 2)   /*!< PSK-Ephemeral TLS 1.3 key exchanges,\0A                                                                         *   using both a PSK and an ephemeral\0A                                                                         *   key exchange. */\0A\0A/* Convenience macros for sets of key exchanges. */\0A#define MBEDTLS_SSL_TLS1_3_KEY_EXCHANGE_MODE_ALL                         \5C\0A    (MBEDTLS_SSL_TLS1_3_KEY_EXCHANGE_MODE_PSK              |            \5C\0A     MBEDTLS_SSL_TLS1_3_KEY_EXCHANGE_MODE_PSK_EPHEMERAL    |            \5C\0A     MBEDTLS_SSL_TLS1_3_KEY_EXCHANGE_MODE_EPHEMERAL)          /*!< All TLS 1.3 key exchanges           */\0A#define MBEDTLS_SSL_TLS1_3_KEY_EXCHANGE_MODE_PSK_ALL                     \5C\0A    (MBEDTLS_SSL_TLS1_3_KEY_EXCHANGE_MODE_PSK              |            \5C\0A     MBEDTLS_SSL_TLS1_3_KEY_EXCHANGE_MODE_PSK_EPHEMERAL)      /*!< All PSK-based TLS 1.3 key exchanges */\0A#define MBEDTLS_SSL_TLS1_3_KEY_EXCHANGE_MODE_EPHEMERAL_ALL               \5C\0A    (MBEDTLS_SSL_TLS1_3_KEY_EXCHANGE_MODE_EPHEMERAL        |            \5C\0A     MBEDTLS_SSL_TLS1_3_KEY_EXCHANGE_MODE_PSK_EPHEMERAL)      /*!< All ephemeral TLS 1.3 key exchanges */\0A\0A#define MBEDTLS_SSL_TLS1_3_KEY_EXCHANGE_MODE_NONE   (0)\0A\0A/*\0A * Various constants\0A */\0A\0A#if !defined(MBEDTLS_DEPRECATED_REMOVED)\0A/* These are the high and low bytes of ProtocolVersion as defined by:\0A * - RFC 5246: ProtocolVersion version = { 3, 3 };     // TLS v1.2\0A * - RFC 8446: see section 4.2.1\0A */\0A#define MBEDTLS_SSL_MAJOR_VERSION_3             3\0A#define MBEDTLS_SSL_MINOR_VERSION_3             3   /*!< TLS v1.2 */\0A#define MBEDTLS_SSL_MINOR_VERSION_4             4   /*!< TLS v1.3 */\0A#endif /* MBEDTLS_DEPRECATED_REMOVED */\0A\0A#define MBEDTLS_SSL_TRANSPORT_STREAM            0   /*!< TLS      */\0A#define MBEDTLS_SSL_TRANSPORT_DATAGRAM          1   /*!< DTLS     */\0A\0A#define MBEDTLS_SSL_MAX_HOST_NAME_LEN           255 /*!< Maximum host name defined in RFC 1035 */\0A#define MBEDTLS_SSL_MAX_ALPN_NAME_LEN           255 /*!< Maximum size in bytes of a protocol name in alpn ext., RFC 7301 */\0A\0A#define MBEDTLS_SSL_MAX_ALPN_LIST_LEN           65535 /*!< Maximum size in bytes of list in alpn ext., RFC 7301          */\0A\0A/* RFC 6066 section 4, see also mfl_code_to_length in ssl_tls.c\0A * NONE must be zero so that memset()ing structure to zero works */\0A#define MBEDTLS_SSL_MAX_FRAG_LEN_NONE           0   /*!< don't use this extension   */\0A#define MBEDTLS_SSL_MAX_FRAG_LEN_512            1   /*!< MaxFragmentLength 2^9      */\0A#define MBEDTLS_SSL_MAX_FRAG_LEN_1024           2   /*!< MaxFragmentLength 2^10     */\0A#define MBEDTLS_SSL_MAX_FRAG_LEN_2048           3   /*!< MaxFragmentLength 2^11     */\0A#define MBEDTLS_SSL_MAX_FRAG_LEN_4096           4   /*!< MaxFragmentLength 2^12     */\0A#define MBEDTLS_SSL_MAX_FRAG_LEN_INVALID        5   /*!< first invalid value        */\0A\0A#define MBEDTLS_SSL_IS_CLIENT                   0\0A#define MBEDTLS_SSL_IS_SERVER                   1\0A\0A#define MBEDTLS_SSL_EXTENDED_MS_DISABLED        0\0A#define MBEDTLS_SSL_EXTENDED_MS_ENABLED         1\0A\0A#define MBEDTLS_SSL_CID_DISABLED                0\0A#define MBEDTLS_SSL_CID_ENABLED                 1\0A\0A#define MBEDTLS_SSL_ETM_DISABLED                0\0A#define MBEDTLS_SSL_ETM_ENABLED                 1\0A\0A#define MBEDTLS_SSL_COMPRESS_NULL               0\0A\0A#define MBEDTLS_SSL_VERIFY_NONE                 0\0A#define MBEDTLS_SSL_VERIFY_OPTIONAL             1\0A#define MBEDTLS_SSL_VERIFY_REQUIRED             2\0A#define MBEDTLS_SSL_VERIFY_UNSET                3 /* Used only for sni_authmode */\0A\0A#define MBEDTLS_SSL_LEGACY_RENEGOTIATION        0\0A#define MBEDTLS_SSL_SECURE_RENEGOTIATION        1\0A\0A#define MBEDTLS_SSL_RENEGOTIATION_DISABLED      0\0A#define MBEDTLS_SSL_RENEGOTIATION_ENABLED       1\0A\0A#define MBEDTLS_SSL_ANTI_REPLAY_DISABLED        0\0A#define MBEDTLS_SSL_ANTI_REPLAY_ENABLED         1\0A\0A#define MBEDTLS_SSL_RENEGOTIATION_NOT_ENFORCED  -1\0A#define MBEDTLS_SSL_RENEGO_MAX_RECORDS_DEFAULT  16\0A\0A#define MBEDTLS_SSL_LEGACY_NO_RENEGOTIATION     0\0A#define MBEDTLS_SSL_LEGACY_ALLOW_RENEGOTIATION  1\0A#define MBEDTLS_SSL_LEGACY_BREAK_HANDSHAKE      2\0A\0A#define MBEDTLS_SSL_TRUNC_HMAC_DISABLED         0\0A#define MBEDTLS_SSL_TRUNC_HMAC_ENABLED          1\0A#define MBEDTLS_SSL_TRUNCATED_HMAC_LEN          10  /* 80 bits, rfc 6066 section 7 */\0A\0A#define MBEDTLS_SSL_SESSION_TICKETS_DISABLED     0\0A#define MBEDTLS_SSL_SESSION_TICKETS_ENABLED      1\0A\0A#define MBEDTLS_SSL_TLS1_3_SIGNAL_NEW_SESSION_TICKETS_DISABLED  0\0A#define MBEDTLS_SSL_TLS1_3_SIGNAL_NEW_SESSION_TICKETS_ENABLED   1\0A\0A#define MBEDTLS_SSL_PRESET_DEFAULT              0\0A#define MBEDTLS_SSL_PRESET_SUITEB               2\0A\0A#define MBEDTLS_SSL_CERT_REQ_CA_LIST_ENABLED       1\0A#define MBEDTLS_SSL_CERT_REQ_CA_LIST_DISABLED      0\0A\0A#define MBEDTLS_SSL_EARLY_DATA_DISABLED        0\0A#define MBEDTLS_SSL_EARLY_DATA_ENABLED         1\0A\0A#define MBEDTLS_SSL_DTLS_SRTP_MKI_UNSUPPORTED    0\0A#define MBEDTLS_SSL_DTLS_SRTP_MKI_SUPPORTED      1\0A\0A#define MBEDTLS_SSL_SRV_CIPHERSUITE_ORDER_CLIENT  1\0A#define MBEDTLS_SSL_SRV_CIPHERSUITE_ORDER_SERVER  0\0A\0A#if defined(MBEDTLS_SSL_PROTO_TLS1_3) && defined(MBEDTLS_SSL_SESSION_TICKETS)\0A#if defined(PSA_WANT_ALG_SHA_384)\0A#define MBEDTLS_SSL_TLS1_3_TICKET_RESUMPTION_KEY_LEN        48\0A#elif defined(PSA_WANT_ALG_SHA_256)\0A#define MBEDTLS_SSL_TLS1_3_TICKET_RESUMPTION_KEY_LEN        32\0A#endif\0A#endif /* MBEDTLS_SSL_PROTO_TLS1_3 && MBEDTLS_SSL_SESSION_TICKETS */\0A/*\0A * Default range for DTLS retransmission timer value, in milliseconds.\0A * RFC 6347 4.2.4.1 says from 1 second to 60 seconds.\0A */\0A#define MBEDTLS_SSL_DTLS_TIMEOUT_DFL_MIN    1000\0A#define MBEDTLS_SSL_DTLS_TIMEOUT_DFL_MAX   60000\0A\0A/*\0A * Whether early data record should be discarded or not and how.\0A *\0A * The client has indicated early data and the server has rejected them.\0A * The server has then to skip past early data by either:\0A * - attempting to deprotect received records using the handshake traffic\0A *   key, discarding records which fail deprotection (up to the configured\0A *   max_early_data_size). Once a record is deprotected successfully,\0A *   it is treated as the start of the client's second flight and the\0A *   server proceeds as with an ordinary 1-RTT handshake.\0A * - skipping all records with an external content type of\0A *   \22application_data\22 (indicating that they are encrypted), up to the\0A *   configured max_early_data_size. This is the expected behavior if the\0A *   server has sent an HelloRetryRequest message. The server ignores\0A *   application data message before 2nd ClientHello.\0A */\0A#define MBEDTLS_SSL_EARLY_DATA_NO_DISCARD 0\0A#define MBEDTLS_SSL_EARLY_DATA_TRY_TO_DEPROTECT_AND_DISCARD 1\0A#define MBEDTLS_SSL_EARLY_DATA_DISCARD 2\0A\0A/**\0A * \5Cname SECTION: Module settings\0A *\0A * The configuration options you can set for this module are in this section.\0A * Either change them in mbedtls_config.h or define them on the compiler command line.\0A * \5C{\0A */\0A\0A/*\0A * Maximum fragment length in bytes,\0A * determines the size of each of the two internal I/O buffers.\0A *\0A * Note: the RFC defines the default size of SSL / TLS messages. If you\0A * change the value here, other clients / servers may not be able to\0A * communicate with you anymore. Only change this value if you control\0A * both sides of the connection and have it reduced at both sides, or\0A * if you're using the Max Fragment Length extension and you know all your\0A * peers are using it too!\0A */\0A#if !defined(MBEDTLS_SSL_IN_CONTENT_LEN)\0A#define MBEDTLS_SSL_IN_CONTENT_LEN 16384\0A#endif\0A\0A#if !defined(MBEDTLS_SSL_OUT_CONTENT_LEN)\0A#define MBEDTLS_SSL_OUT_CONTENT_LEN 16384\0A#endif\0A\0A/*\0A * Maximum number of heap-allocated bytes for the purpose of\0A * DTLS handshake message reassembly and future message buffering.\0A */\0A#if !defined(MBEDTLS_SSL_DTLS_MAX_BUFFERING)\0A#define MBEDTLS_SSL_DTLS_MAX_BUFFERING 32768\0A#endif\0A\0A/*\0A * Maximum length of CIDs for incoming and outgoing messages.\0A */\0A#if !defined(MBEDTLS_SSL_CID_IN_LEN_MAX)\0A#define MBEDTLS_SSL_CID_IN_LEN_MAX          32\0A#endif\0A\0A#if !defined(MBEDTLS_SSL_CID_OUT_LEN_MAX)\0A#define MBEDTLS_SSL_CID_OUT_LEN_MAX         32\0A#endif\0A\0A#if !defined(MBEDTLS_SSL_CID_TLS1_3_PADDING_GRANULARITY)\0A#define MBEDTLS_SSL_CID_TLS1_3_PADDING_GRANULARITY 16\0A#endif\0A\0A#if !defined(MBEDTLS_SSL_MAX_EARLY_DATA_SIZE)\0A#define MBEDTLS_SSL_MAX_EARLY_DATA_SIZE        1024\0A#endif\0A\0A#if !defined(MBEDTLS_SSL_TLS1_3_TICKET_AGE_TOLERANCE)\0A#define MBEDTLS_SSL_TLS1_3_TICKET_AGE_TOLERANCE 6000\0A#endif\0A\0A#if !defined(MBEDTLS_SSL_TLS1_3_TICKET_NONCE_LENGTH)\0A#define MBEDTLS_SSL_TLS1_3_TICKET_NONCE_LENGTH 32\0A#endif\0A\0A#if !defined(MBEDTLS_SSL_TLS1_3_DEFAULT_NEW_SESSION_TICKETS)\0A#define MBEDTLS_SSL_TLS1_3_DEFAULT_NEW_SESSION_TICKETS 1\0A#endif\0A\0A/** \5C} name SECTION: Module settings */\0A\0A/*\0A * Default to standard CID mode\0A */\0A#if defined(MBEDTLS_SSL_DTLS_CONNECTION_ID) && \5C\0A    !defined(MBEDTLS_SSL_DTLS_CONNECTION_ID_COMPAT)\0A#define MBEDTLS_SSL_DTLS_CONNECTION_ID_COMPAT 0\0A#endif\0A\0A/*\0A * Length of the verify data for secure renegotiation\0A */\0A#define MBEDTLS_SSL_VERIFY_DATA_MAX_LEN 12\0A\0A/*\0A * Signaling ciphersuite values (SCSV)\0A */\0A#define MBEDTLS_SSL_EMPTY_RENEGOTIATION_INFO    0xFF   /**< renegotiation info ext */\0A\0A/*\0A * Supported Signature and Hash algorithms (For TLS 1.2)\0A * RFC 5246 section 7.4.1.4.1\0A */\0A#define MBEDTLS_SSL_HASH_NONE                0\0A#define MBEDTLS_SSL_HASH_MD5                 1\0A#define MBEDTLS_SSL_HASH_SHA1                2\0A#define MBEDTLS_SSL_HASH_SHA224              3\0A#define MBEDTLS_SSL_HASH_SHA256              4\0A#define MBEDTLS_SSL_HASH_SHA384              5\0A#define MBEDTLS_SSL_HASH_SHA512              6\0A\0A#define MBEDTLS_SSL_SIG_ANON                 0\0A#define MBEDTLS_SSL_SIG_RSA                  1\0A#define MBEDTLS_SSL_SIG_ECDSA                3\0A\0A/*\0A * TLS 1.3 signature algorithms\0A * RFC 8446, Section 4.2.3\0A */\0A\0A/* RSASSA-PKCS1-v1_5 algorithms */\0A#define MBEDTLS_TLS1_3_SIG_RSA_PKCS1_SHA256 0x0401\0A#define MBEDTLS_TLS1_3_SIG_RSA_PKCS1_SHA384 0x0501\0A#define MBEDTLS_TLS1_3_SIG_RSA_PKCS1_SHA512 0x0601\0A\0A/* ECDSA algorithms */\0A#define MBEDTLS_TLS1_3_SIG_ECDSA_SECP256R1_SHA256 0x0403\0A#define MBEDTLS_TLS1_3_SIG_ECDSA_SECP384R1_SHA384 0x0503\0A#define MBEDTLS_TLS1_3_SIG_ECDSA_SECP521R1_SHA512 0x0603\0A\0A/* RSASSA-PSS algorithms with public key OID rsaEncryption */\0A#define MBEDTLS_TLS1_3_SIG_RSA_PSS_RSAE_SHA256 0x0804\0A#define MBEDTLS_TLS1_3_SIG_RSA_PSS_RSAE_SHA384 0x0805\0A#define MBEDTLS_TLS1_3_SIG_RSA_PSS_RSAE_SHA512 0x0806\0A\0A/* EdDSA algorithms */\0A#define MBEDTLS_TLS1_3_SIG_ED25519 0x0807\0A#define MBEDTLS_TLS1_3_SIG_ED448 0x0808\0A\0A/* RSASSA-PSS algorithms with public key OID RSASSA-PSS  */\0A#define MBEDTLS_TLS1_3_SIG_RSA_PSS_PSS_SHA256 0x0809\0A#define MBEDTLS_TLS1_3_SIG_RSA_PSS_PSS_SHA384 0x080A\0A#define MBEDTLS_TLS1_3_SIG_RSA_PSS_PSS_SHA512 0x080B\0A\0A/* LEGACY ALGORITHMS */\0A#define MBEDTLS_TLS1_3_SIG_RSA_PKCS1_SHA1 0x0201\0A#define MBEDTLS_TLS1_3_SIG_ECDSA_SHA1     0x0203\0A\0A#define MBEDTLS_TLS1_3_SIG_NONE 0x0\0A\0A/*\0A * Client Certificate Types\0A * RFC 5246 section 7.4.4 plus RFC 4492 section 5.5\0A */\0A#define MBEDTLS_SSL_CERT_TYPE_RSA_SIGN       1\0A#define MBEDTLS_SSL_CERT_TYPE_ECDSA_SIGN    64\0A\0A/*\0A * Message, alert and handshake types\0A */\0A#define MBEDTLS_SSL_MSG_CHANGE_CIPHER_SPEC     20\0A#define MBEDTLS_SSL_MSG_ALERT                  21\0A#define MBEDTLS_SSL_MSG_HANDSHAKE              22\0A#define MBEDTLS_SSL_MSG_APPLICATION_DATA       23\0A#define MBEDTLS_SSL_MSG_CID                    25\0A\0A#define MBEDTLS_SSL_ALERT_LEVEL_WARNING         1\0A#define MBEDTLS_SSL_ALERT_LEVEL_FATAL           2\0A\0A#define MBEDTLS_SSL_ALERT_MSG_CLOSE_NOTIFY           0  /* 0x00 */\0A#define MBEDTLS_SSL_ALERT_MSG_UNEXPECTED_MESSAGE    10  /* 0x0A */\0A#define MBEDTLS_SSL_ALERT_MSG_BAD_RECORD_MAC        20  /* 0x14 */\0A#define MBEDTLS_SSL_ALERT_MSG_DECRYPTION_FAILED     21  /* 0x15 */\0A#define MBEDTLS_SSL_ALERT_MSG_RECORD_OVERFLOW       22  /* 0x16 */\0A#define MBEDTLS_SSL_ALERT_MSG_DECOMPRESSION_FAILURE 30  /* 0x1E */\0A#define MBEDTLS_SSL_ALERT_MSG_HANDSHAKE_FAILURE     40  /* 0x28 */\0A#define MBEDTLS_SSL_ALERT_MSG_NO_CERT               41  /* 0x29 */\0A#define MBEDTLS_SSL_ALERT_MSG_BAD_CERT              42  /* 0x2A */\0A#define MBEDTLS_SSL_ALERT_MSG_UNSUPPORTED_CERT      43  /* 0x2B */\0A#define MBEDTLS_SSL_ALERT_MSG_CERT_REVOKED          44  /* 0x2C */\0A#define MBEDTLS_SSL_ALERT_MSG_CERT_EXPIRED          45  /* 0x2D */\0A#define MBEDTLS_SSL_ALERT_MSG_CERT_UNKNOWN          46  /* 0x2E */\0A#define MBEDTLS_SSL_ALERT_MSG_ILLEGAL_PARAMETER     47  /* 0x2F */\0A#define MBEDTLS_SSL_ALERT_MSG_UNKNOWN_CA            48  /* 0x30 */\0A#define MBEDTLS_SSL_ALERT_MSG_ACCESS_DENIED         49  /* 0x31 */\0A#define MBEDTLS_SSL_ALERT_MSG_DECODE_ERROR          50  /* 0x32 */\0A#define MBEDTLS_SSL_ALERT_MSG_DECRYPT_ERROR         51  /* 0x33 */\0A#define MBEDTLS_SSL_ALERT_MSG_EXPORT_RESTRICTION    60  /* 0x3C */\0A#define MBEDTLS_SSL_ALERT_MSG_PROTOCOL_VERSION      70  /* 0x46 */\0A#define MBEDTLS_SSL_ALERT_MSG_INSUFFICIENT_SECURITY 71  /* 0x47 */\0A#define MBEDTLS_SSL_ALERT_MSG_INTERNAL_ERROR        80  /* 0x50 */\0A#define MBEDTLS_SSL_ALERT_MSG_INAPROPRIATE_FALLBACK 86  /* 0x56 */\0A#define MBEDTLS_SSL_ALERT_MSG_USER_CANCELED         90  /* 0x5A */\0A#define MBEDTLS_SSL_ALERT_MSG_NO_RENEGOTIATION     100  /* 0x64 */\0A#define MBEDTLS_SSL_ALERT_MSG_MISSING_EXTENSION    109  /* 0x6d -- new in TLS 1.3 */\0A#define MBEDTLS_SSL_ALERT_MSG_UNSUPPORTED_EXT      110  /* 0x6E */\0A#define MBEDTLS_SSL_ALERT_MSG_UNRECOGNIZED_NAME    112  /* 0x70 */\0A#define MBEDTLS_SSL_ALERT_MSG_UNKNOWN_PSK_IDENTITY 115  /* 0x73 */\0A#define MBEDTLS_SSL_ALERT_MSG_CERT_REQUIRED        116  /* 0x74 */\0A#define MBEDTLS_SSL_ALERT_MSG_NO_APPLICATION_PROTOCOL 120 /* 0x78 */\0A\0A#define MBEDTLS_SSL_HS_HELLO_REQUEST            0\0A#define MBEDTLS_SSL_HS_CLIENT_HELLO             1\0A#define MBEDTLS_SSL_HS_SERVER_HELLO             2\0A#define MBEDTLS_SSL_HS_HELLO_VERIFY_REQUEST     3\0A#define MBEDTLS_SSL_HS_NEW_SESSION_TICKET       4\0A#define MBEDTLS_SSL_HS_END_OF_EARLY_DATA        5\0A#define MBEDTLS_SSL_HS_ENCRYPTED_EXTENSIONS     8\0A#define MBEDTLS_SSL_HS_CERTIFICATE             11\0A#define MBEDTLS_SSL_HS_SERVER_KEY_EXCHANGE     12\0A#define MBEDTLS_SSL_HS_CERTIFICATE_REQUEST     13\0A#define MBEDTLS_SSL_HS_SERVER_HELLO_DONE       14\0A#define MBEDTLS_SSL_HS_CERTIFICATE_VERIFY      15\0A#define MBEDTLS_SSL_HS_CLIENT_KEY_EXCHANGE     16\0A#define MBEDTLS_SSL_HS_FINISHED                20\0A#define MBEDTLS_SSL_HS_MESSAGE_HASH           254\0A\0A/*\0A * TLS extensions\0A */\0A#define MBEDTLS_TLS_EXT_SERVERNAME                   0\0A#define MBEDTLS_TLS_EXT_SERVERNAME_HOSTNAME          0\0A\0A#define MBEDTLS_TLS_EXT_MAX_FRAGMENT_LENGTH          1\0A\0A#define MBEDTLS_TLS_EXT_TRUNCATED_HMAC               4\0A#define MBEDTLS_TLS_EXT_STATUS_REQUEST               5 /* RFC 6066 TLS 1.2 and 1.3 */\0A\0A#define MBEDTLS_TLS_EXT_SUPPORTED_ELLIPTIC_CURVES   10\0A#define MBEDTLS_TLS_EXT_SUPPORTED_GROUPS            10 /* RFC 8422,7919 TLS 1.2 and 1.3 */\0A#define MBEDTLS_TLS_EXT_SUPPORTED_POINT_FORMATS     11\0A\0A#define MBEDTLS_TLS_EXT_SIG_ALG                     13 /* RFC 8446 TLS 1.3 */\0A#define MBEDTLS_TLS_EXT_USE_SRTP                    14\0A#define MBEDTLS_TLS_EXT_HEARTBEAT                   15 /* RFC 6520 TLS 1.2 and 1.3 */\0A#define MBEDTLS_TLS_EXT_ALPN                        16\0A\0A#define MBEDTLS_TLS_EXT_SCT                         18 /* RFC 6962 TLS 1.2 and 1.3 */\0A#define MBEDTLS_TLS_EXT_CLI_CERT_TYPE               19 /* RFC 7250 TLS 1.2 and 1.3 */\0A#define MBEDTLS_TLS_EXT_SERV_CERT_TYPE              20 /* RFC 7250 TLS 1.2 and 1.3 */\0A#define MBEDTLS_TLS_EXT_PADDING                     21 /* RFC 7685 TLS 1.2 and 1.3 */\0A#define MBEDTLS_TLS_EXT_ENCRYPT_THEN_MAC            22 /* 0x16 */\0A#define MBEDTLS_TLS_EXT_EXTENDED_MASTER_SECRET  0x0017 /* 23 */\0A\0A#define MBEDTLS_TLS_EXT_RECORD_SIZE_LIMIT           28 /* RFC 8449 (implemented for TLS 1.3 only) */\0A\0A#define MBEDTLS_TLS_EXT_SESSION_TICKET              35\0A\0A#define MBEDTLS_TLS_EXT_PRE_SHARED_KEY              41 /* RFC 8446 TLS 1.3 */\0A#define MBEDTLS_TLS_EXT_EARLY_DATA                  42 /* RFC 8446 TLS 1.3 */\0A#define MBEDTLS_TLS_EXT_SUPPORTED_VERSIONS          43 /* RFC 8446 TLS 1.3 */\0A#define MBEDTLS_TLS_EXT_COOKIE                      44 /* RFC 8446 TLS 1.3 */\0A#define MBEDTLS_TLS_EXT_PSK_KEY_EXCHANGE_MODES      45 /* RFC 8446 TLS 1.3 */\0A\0A#define MBEDTLS_TLS_EXT_CERT_AUTH                   47 /* RFC 8446 TLS 1.3 */\0A#define MBEDTLS_TLS_EXT_OID_FILTERS                 48 /* RFC 8446 TLS 1.3 */\0A#define MBEDTLS_TLS_EXT_POST_HANDSHAKE_AUTH         49 /* RFC 8446 TLS 1.3 */\0A#define MBEDTLS_TLS_EXT_SIG_ALG_CERT                50 /* RFC 8446 TLS 1.3 */\0A#define MBEDTLS_TLS_EXT_KEY_SHARE                   51 /* RFC 8446 TLS 1.3 */\0A\0A#if MBEDTLS_SSL_DTLS_CONNECTION_ID_COMPAT == 0\0A#define MBEDTLS_TLS_EXT_CID                         54 /* RFC 9146 DTLS 1.2 CID */\0A#else\0A#define MBEDTLS_TLS_EXT_CID                        254 /* Pre-RFC 9146 DTLS 1.2 CID */\0A#endif\0A\0A#define MBEDTLS_TLS_EXT_ECJPAKE_KKPP               256 /* experimental */\0A\0A#define MBEDTLS_TLS_EXT_RENEGOTIATION_INFO      0xFF01\0A\0A/*\0A * Size defines\0A */\0A#if !defined(MBEDTLS_PSK_MAX_LEN)\0A/*\0A * If the library supports TLS 1.3 tickets and the cipher suite\0A * TLS1-3-AES-256-GCM-SHA384, set the PSK maximum length to 48 instead of 32.\0A * That way, the TLS 1.3 client and server are able to resume sessions where\0A * the cipher suite is TLS1-3-AES-256-GCM-SHA384 (pre-shared keys are 48\0A * bytes long in that case).\0A */\0A#if defined(MBEDTLS_SSL_PROTO_TLS1_3) && \5C\0A    defined(MBEDTLS_SSL_SESSION_TICKETS) && \5C\0A    defined(MBEDTLS_SSL_HAVE_AES) && defined(MBEDTLS_SSL_HAVE_GCM) && \5C\0A    defined(MBEDTLS_MD_CAN_SHA384)\0A#define MBEDTLS_PSK_MAX_LEN 48 /* 384 bits */\0A#else\0A#define MBEDTLS_PSK_MAX_LEN 32 /* 256 bits */\0A#endif\0A#endif /* !MBEDTLS_PSK_MAX_LEN */\0A\0A/* Dummy type used only for its size */\0Aunion mbedtls_ssl_premaster_secret {\0A    unsigned char dummy; /* Make the union non-empty even with SSL disabled */\0A#if defined(MBEDTLS_KEY_EXCHANGE_RSA_ENABLED)\0A    unsigned char _pms_rsa[48];                         /* RFC 5246 8.1.1 */\0A#endif\0A#if defined(MBEDTLS_KEY_EXCHANGE_DHE_RSA_ENABLED)\0A    unsigned char _pms_dhm[MBEDTLS_MPI_MAX_SIZE];      /* RFC 5246 8.1.2 */\0A#endif\0A#if defined(MBEDTLS_KEY_EXCHANGE_ECDHE_RSA_ENABLED)    || \5C\0A    defined(MBEDTLS_KEY_EXCHANGE_ECDHE_ECDSA_ENABLED)  || \5C\0A    defined(MBEDTLS_KEY_EXCHANGE_ECDH_RSA_ENABLED)     || \5C\0A    defined(MBEDTLS_KEY_EXCHANGE_ECDH_ECDSA_ENABLED)\0A    unsigned char _pms_ecdh[MBEDTLS_ECP_MAX_BYTES];    /* RFC 4492 5.10 */\0A#endif\0A#if defined(MBEDTLS_KEY_EXCHANGE_PSK_ENABLED)\0A    unsigned char _pms_psk[4 + 2 * MBEDTLS_PSK_MAX_LEN];       /* RFC 4279 2 */\0A#endif\0A#if defined(MBEDTLS_KEY_EXCHANGE_DHE_PSK_ENABLED)\0A    unsigned char _pms_dhe_psk[4 + MBEDTLS_MPI_MAX_SIZE\0A                               + MBEDTLS_PSK_MAX_LEN];         /* RFC 4279 3 */\0A#endif\0A#if defined(MBEDTLS_KEY_EXCHANGE_RSA_PSK_ENABLED)\0A    unsigned char _pms_rsa_psk[52 + MBEDTLS_PSK_MAX_LEN];      /* RFC 4279 4 */\0A#endif\0A#if defined(MBEDTLS_KEY_EXCHANGE_ECDHE_PSK_ENABLED)\0A    unsigned char _pms_ecdhe_psk[4 + MBEDTLS_ECP_MAX_BYTES\0A                                 + MBEDTLS_PSK_MAX_LEN];       /* RFC 5489 2 */\0A#endif\0A#if defined(MBEDTLS_KEY_EXCHANGE_ECJPAKE_ENABLED)\0A    unsigned char _pms_ecjpake[32];     /* Thread spec: SHA-256 output */\0A#endif\0A};\0A\0A#define MBEDTLS_PREMASTER_SIZE     sizeof(union mbedtls_ssl_premaster_secret)\0A\0A#define MBEDTLS_TLS1_3_MD_MAX_SIZE         PSA_HASH_MAX_SIZE\0A\0A\0A/* Length in number of bytes of the TLS sequence number */\0A#define MBEDTLS_SSL_SEQUENCE_NUMBER_LEN 8\0A\0A#ifdef __cplusplus\0Aextern \22C\22 {\0A#endif\0A\0A/*\0A * SSL state machine\0A */\0Atypedef enum {\0A    MBEDTLS_SSL_HELLO_REQUEST,\0A    MBEDTLS_SSL_CLIENT_HELLO,\0A    MBEDTLS_SSL_SERVER_HELLO,\0A    MBEDTLS_SSL_SERVER_CERTIFICATE,\0A    MBEDTLS_SSL_SERVER_KEY_EXCHANGE,\0A    MBEDTLS_SSL_CERTIFICATE_REQUEST,\0A    MBEDTLS_SSL_SERVER_HELLO_DONE,\0A    MBEDTLS_SSL_CLIENT_CERTIFICATE,\0A    MBEDTLS_SSL_CLIENT_KEY_EXCHANGE,\0A    MBEDTLS_SSL_CERTIFICATE_VERIFY,\0A    MBEDTLS_SSL_CLIENT_CHANGE_CIPHER_SPEC,\0A    MBEDTLS_SSL_CLIENT_FINISHED,\0A    MBEDTLS_SSL_SERVER_CHANGE_CIPHER_SPEC,\0A    MBEDTLS_SSL_SERVER_FINISHED,\0A    MBEDTLS_SSL_FLUSH_BUFFERS,\0A    MBEDTLS_SSL_HANDSHAKE_WRAPUP,\0A    MBEDTLS_SSL_NEW_SESSION_TICKET,\0A    MBEDTLS_SSL_SERVER_HELLO_VERIFY_REQUEST_SENT,\0A    MBEDTLS_SSL_HELLO_RETRY_REQUEST,\0A    MBEDTLS_SSL_ENCRYPTED_EXTENSIONS,\0A    MBEDTLS_SSL_END_OF_EARLY_DATA,\0A    MBEDTLS_SSL_CLIENT_CERTIFICATE_VERIFY,\0A    MBEDTLS_SSL_CLIENT_CCS_AFTER_SERVER_FINISHED,\0A    MBEDTLS_SSL_CLIENT_CCS_BEFORE_2ND_CLIENT_HELLO,\0A    MBEDTLS_SSL_SERVER_CCS_AFTER_SERVER_HELLO,\0A    MBEDTLS_SSL_CLIENT_CCS_AFTER_CLIENT_HELLO,\0A    MBEDTLS_SSL_SERVER_CCS_AFTER_HELLO_RETRY_REQUEST,\0A    MBEDTLS_SSL_HANDSHAKE_OVER,\0A    MBEDTLS_SSL_TLS1_3_NEW_SESSION_TICKET,\0A    MBEDTLS_SSL_TLS1_3_NEW_SESSION_TICKET_FLUSH,\0A}\0Ambedtls_ssl_states;\0A\0A/*\0A * Early data status, client side only.\0A */\0A\0A#if defined(MBEDTLS_SSL_EARLY_DATA) && defined(MBEDTLS_SSL_CLI_C)\0Atypedef enum {\0A/*\0A * See documentation of mbedtls_ssl_get_early_data_status().\0A */\0A    MBEDTLS_SSL_EARLY_DATA_STATUS_NOT_INDICATED,\0A    MBEDTLS_SSL_EARLY_DATA_STATUS_ACCEPTED,\0A    MBEDTLS_SSL_EARLY_DATA_STATUS_REJECTED,\0A} mbedtls_ssl_early_data_status;\0A#endif /* MBEDTLS_SSL_EARLY_DATA && MBEDTLS_SSL_CLI_C */\0A\0A/**\0A * \5Cbrief          Callback type: send data on the network.\0A *\0A * \5Cnote           That callback may be either blocking or non-blocking.\0A *\0A * \5Cparam ctx      Context for the send callback (typically a file descriptor)\0A * \5Cparam buf      Buffer holding the data to send\0A * \5Cparam len      Length of the data to send\0A *\0A * \5Creturn         The callback must return the number of bytes sent if any,\0A *                 or a non-zero error code.\0A *                 If performing non-blocking I/O, \5Cc MBEDTLS_ERR_SSL_WANT_WRITE\0A *                 must be returned when the operation would block.\0A *\0A * \5Cnote           The callback is allowed to send fewer bytes than requested.\0A *                 It must always return the number of bytes actually sent.\0A */\0Atypedef int mbedtls_ssl_send_t(void *ctx,\0A                               const unsigned char *buf,\0A                               size_t len);\0A\0A/**\0A * \5Cbrief          Callback type: receive data from the network.\0A *\0A * \5Cnote           That callback may be either blocking or non-blocking.\0A *\0A * \5Cparam ctx      Context for the receive callback (typically a file\0A *                 descriptor)\0A * \5Cparam buf      Buffer to write the received data to\0A * \5Cparam len      Length of the receive buffer\0A *\0A * \5Creturns        If data has been received, the positive number of bytes received.\0A * \5Creturns        \5Cc 0 if the connection has been closed.\0A * \5Creturns        If performing non-blocking I/O, \5Cc MBEDTLS_ERR_SSL_WANT_READ\0A *                 must be returned when the operation would block.\0A * \5Creturns        Another negative error code on other kinds of failures.\0A *\0A * \5Cnote           The callback may receive fewer bytes than the length of the\0A *                 buffer. It must always return the number of bytes actually\0A *                 received and written to the buffer.\0A */\0Atypedef int mbedtls_ssl_recv_t(void *ctx,\0A                               unsigned char *buf,\0A                               size_t len);\0A\0A/**\0A * \5Cbrief          Callback type: receive data from the network, with timeout\0A *\0A * \5Cnote           That callback must block until data is received, or the\0A *                 timeout delay expires, or the operation is interrupted by a\0A *                 signal.\0A *\0A * \5Cparam ctx      Context for the receive callback (typically a file descriptor)\0A * \5Cparam buf      Buffer to write the received data to\0A * \5Cparam len      Length of the receive buffer\0A * \5Cparam timeout  Maximum number of milliseconds to wait for data\0A *                 0 means no timeout (potentially waiting forever)\0A *\0A * \5Creturn         The callback must return the number of bytes received,\0A *                 or a non-zero error code:\0A *                 \5Cc MBEDTLS_ERR_SSL_TIMEOUT if the operation timed out,\0A *                 \5Cc MBEDTLS_ERR_SSL_WANT_READ if interrupted by a signal.\0A *\0A * \5Cnote           The callback may receive fewer bytes than the length of the\0A *                 buffer. It must always return the number of bytes actually\0A *                 received and written to the buffer.\0A */\0Atypedef int mbedtls_ssl_recv_timeout_t(void *ctx,\0A                                       unsigned char *buf,\0A                                       size_t len,\0A                                       uint32_t timeout);\0A/**\0A * \5Cbrief          Callback type: set a pair of timers/delays to watch\0A *\0A * \5Cparam ctx      Context pointer\0A * \5Cparam int_ms   Intermediate delay in milliseconds\0A * \5Cparam fin_ms   Final delay in milliseconds\0A *                 0 cancels the current timer.\0A *\0A * \5Cnote           This callback must at least store the necessary information\0A *                 for the associated \5Cc mbedtls_ssl_get_timer_t callback to\0A *                 return correct information.\0A *\0A * \5Cnote           If using an event-driven style of programming, an event must\0A *                 be generated when the final delay is passed. The event must\0A *                 cause a call to \5Cc mbedtls_ssl_handshake() with the proper\0A *                 SSL context to be scheduled. Care must be taken to ensure\0A *                 that at most one such call happens at a time.\0A *\0A * \5Cnote           Only one timer at a time must be running. Calling this\0A *                 function while a timer is running must cancel it. Cancelled\0A *                 timers must not generate any event.\0A */\0Atypedef void mbedtls_ssl_set_timer_t(void *ctx,\0A                                     uint32_t int_ms,\0A                                     uint32_t fin_ms);\0A\0A/**\0A * \5Cbrief          Callback type: get status of timers/delays\0A *\0A * \5Cparam ctx      Context pointer\0A *\0A * \5Creturn         This callback must return:\0A *                 -1 if cancelled (fin_ms == 0),\0A *                  0 if none of the delays have passed,\0A *                  1 if only the intermediate delay has passed,\0A *                  2 if the final delay has passed.\0A */\0Atypedef int mbedtls_ssl_get_timer_t(void *ctx);\0A\0A/* Defined below */\0Atypedef struct mbedtls_ssl_session mbedtls_ssl_session;\0Atypedef struct mbedtls_ssl_context mbedtls_ssl_context;\0Atypedef struct mbedtls_ssl_config  mbedtls_ssl_config;\0A\0A/* Defined in library/ssl_misc.h */\0Atypedef struct mbedtls_ssl_transform mbedtls_ssl_transform;\0Atypedef struct mbedtls_ssl_handshake_params mbedtls_ssl_handshake_params;\0Atypedef struct mbedtls_ssl_sig_hash_set_t mbedtls_ssl_sig_hash_set_t;\0A#if defined(MBEDTLS_X509_CRT_PARSE_C)\0Atypedef struct mbedtls_ssl_key_cert mbedtls_ssl_key_cert;\0A#endif\0A#if defined(MBEDTLS_SSL_PROTO_DTLS)\0Atypedef struct mbedtls_ssl_flight_item mbedtls_ssl_flight_item;\0A#endif\0A\0A#if defined(MBEDTLS_SSL_PROTO_TLS1_3) && defined(MBEDTLS_SSL_SESSION_TICKETS)\0A#define MBEDTLS_SSL_TLS1_3_TICKET_ALLOW_PSK_RESUMPTION                          \5C\0A    MBEDTLS_SSL_TLS1_3_KEY_EXCHANGE_MODE_PSK                        /* 1U << 0 */\0A#define MBEDTLS_SSL_TLS1_3_TICKET_ALLOW_PSK_EPHEMERAL_RESUMPTION                \5C\0A    MBEDTLS_SSL_TLS1_3_KEY_EXCHANGE_MODE_PSK_EPHEMERAL              /* 1U << 2 */\0A#define MBEDTLS_SSL_TLS1_3_TICKET_ALLOW_EARLY_DATA                  (1U << 3)\0A\0A#define MBEDTLS_SSL_TLS1_3_TICKET_FLAGS_MASK                                    \5C\0A    (MBEDTLS_SSL_TLS1_3_TICKET_ALLOW_PSK_RESUMPTION             |      \5C\0A     MBEDTLS_SSL_TLS1_3_TICKET_ALLOW_PSK_EPHEMERAL_RESUMPTION   |      \5C\0A     MBEDTLS_SSL_TLS1_3_TICKET_ALLOW_EARLY_DATA)\0A#endif /* MBEDTLS_SSL_PROTO_TLS1_3 && MBEDTLS_SSL_SESSION_TICKETS */\0A\0A/**\0A * \5Cbrief          Callback type: server-side session cache getter\0A *\0A *                 The session cache is logically a key value store, with\0A *                 keys being session IDs and values being instances of\0A *                 mbedtls_ssl_session.\0A *\0A *                 This callback retrieves an entry in this key-value store.\0A *\0A * \5Cparam data            The address of the session cache structure to query.\0A * \5Cparam session_id      The buffer holding the session ID to query.\0A * \5Cparam session_id_len  The length of \5Cp session_id in Bytes.\0A * \5Cparam session         The address of the session structure to populate.\0A *                        It is initialized with mbdtls_ssl_session_init(),\0A *                        and the callback must always leave it in a state\0A *                        where it can safely be freed via\0A *                        mbedtls_ssl_session_free() independent of the\0A *                        return code of this function.\0A *\0A * \5Creturn                \5Cc 0 on success\0A * \5Creturn                A non-zero return value on failure.\0A *\0A */\0Atypedef int mbedtls_ssl_cache_get_t(void *data,\0A                                    unsigned char const *session_id,\0A                                    size_t session_id_len,\0A                                    mbedtls_ssl_session *session);\0A/**\0A * \5Cbrief          Callback type: server-side session cache setter\0A *\0A *                 The session cache is logically a key value store, with\0A *                 keys being session IDs and values being instances of\0A *                 mbedtls_ssl_session.\0A *\0A *                 This callback sets an entry in this key-value store.\0A *\0A * \5Cparam data            The address of the session cache structure to modify.\0A * \5Cparam session_id      The buffer holding the session ID to query.\0A * \5Cparam session_id_len  The length of \5Cp session_id in Bytes.\0A * \5Cparam session         The address of the session to be stored in the\0A *                        session cache.\0A *\0A * \5Creturn                \5Cc 0 on success\0A * \5Creturn                A non-zero return value on failure.\0A */\0Atypedef int mbedtls_ssl_cache_set_t(void *data,\0A                                    unsigned char const *session_id,\0A                                    size_t session_id_len,\0A                                    const mbedtls_ssl_session *session);\0A\0A#if defined(MBEDTLS_SSL_ASYNC_PRIVATE)\0A#if defined(MBEDTLS_X509_CRT_PARSE_C)\0A/**\0A * \5Cbrief           Callback type: start external signature operation.\0A *\0A *                  This callback is called during an SSL handshake to start\0A *                  a signature decryption operation using an\0A *                  external processor. The parameter \5Cp cert contains\0A *                  the public key; it is up to the callback function to\0A *                  determine how to access the associated private key.\0A *\0A *                  This function typically sends or enqueues a request, and\0A *                  does not wait for the operation to complete. This allows\0A *                  the handshake step to be non-blocking.\0A *\0A *                  The parameters \5Cp ssl and \5Cp cert are guaranteed to remain\0A *                  valid throughout the handshake. On the other hand, this\0A *                  function must save the contents of \5Cp hash if the value\0A *                  is needed for later processing, because the \5Cp hash buffer\0A *                  is no longer valid after this function returns.\0A *\0A *                  This function may call mbedtls_ssl_set_async_operation_data()\0A *                  to store an operation context for later retrieval\0A *                  by the resume or cancel callback.\0A *\0A * \5Cnote            For RSA signatures, this function must produce output\0A *                  that is consistent with PKCS#1 v1.5 in the same way as\0A *                  mbedtls_rsa_pkcs1_sign(). Before the private key operation,\0A *                  apply the padding steps described in RFC 8017, section 9.2\0A *                  \22EMSA-PKCS1-v1_5\22 as follows.\0A *                  - If \5Cp md_alg is #MBEDTLS_MD_NONE, apply the PKCS#1 v1.5\0A *                    encoding, treating \5Cp hash as the DigestInfo to be\0A *                    padded. In other words, apply EMSA-PKCS1-v1_5 starting\0A *                    from step 3, with `T = hash` and `tLen = hash_len`.\0A *                  - If `md_alg != MBEDTLS_MD_NONE`, apply the PKCS#1 v1.5\0A *                    encoding, treating \5Cp hash as the hash to be encoded and\0A *                    padded. In other words, apply EMSA-PKCS1-v1_5 starting\0A *                    from step 2, with `digestAlgorithm` obtained by calling\0A *                    mbedtls_oid_get_oid_by_md() on \5Cp md_alg.\0A *\0A * \5Cnote            For ECDSA signatures, the output format is the DER encoding\0A *                  `Ecdsa-Sig-Value` defined in\0A *                  [RFC 4492 section 5.4](https://tools.ietf.org/html/rfc4492#section-5.4).\0A *\0A * \5Cparam ssl             The SSL connection instance. It should not be\0A *                        modified other than via\0A *                        mbedtls_ssl_set_async_operation_data().\0A * \5Cparam cert            Certificate containing the public key.\0A *                        In simple cases, this is one of the pointers passed to\0A *                        mbedtls_ssl_conf_own_cert() when configuring the SSL\0A *                        connection. However, if other callbacks are used, this\0A *                        property may not hold. For example, if an SNI callback\0A *                        is registered with mbedtls_ssl_conf_sni(), then\0A *                        this callback determines what certificate is used.\0A * \5Cparam md_alg          Hash algorithm.\0A * \5Cparam hash            Buffer containing the hash. This buffer is\0A *                        no longer valid when the function returns.\0A * \5Cparam hash_len        Size of the \5Cc hash buffer in bytes.\0A *\0A * \5Creturn          0 if the operation was started successfully and the SSL\0A *                  stack should call the resume callback immediately.\0A * \5Creturn          #MBEDTLS_ERR_SSL_ASYNC_IN_PROGRESS if the operation\0A *                  was started successfully and the SSL stack should return\0A *                  immediately without calling the resume callback yet.\0A * \5Creturn          #MBEDTLS_ERR_SSL_HW_ACCEL_FALLTHROUGH if the external\0A *                  processor does not support this key. The SSL stack will\0A *                  use the private key object instead.\0A * \5Creturn          Any other error indicates a fatal failure and is\0A *                  propagated up the call chain. The callback should\0A *                  use \5Cc MBEDTLS_ERR_PK_xxx error codes, and <b>must not</b>\0A *                  use \5Cc MBEDTLS_ERR_SSL_xxx error codes except as\0A *                  directed in the documentation of this callback.\0A */\0Atypedef int mbedtls_ssl_async_sign_t(mbedtls_ssl_context *ssl,\0A                                     mbedtls_x509_crt *cert,\0A                                     mbedtls_md_type_t md_alg,\0A                                     const unsigned char *hash,\0A                                     size_t hash_len);\0A\0A/**\0A * \5Cbrief           Callback type: start external decryption operation.\0A *\0A *                  This callback is called during an SSL handshake to start\0A *                  an RSA decryption operation using an\0A *                  external processor. The parameter \5Cp cert contains\0A *                  the public key; it is up to the callback function to\0A *                  determine how to access the associated private key.\0A *\0A *                  This function typically sends or enqueues a request, and\0A *                  does not wait for the operation to complete. This allows\0A *                  the handshake step to be non-blocking.\0A *\0A *                  The parameters \5Cp ssl and \5Cp cert are guaranteed to remain\0A *                  valid throughout the handshake. On the other hand, this\0A *                  function must save the contents of \5Cp input if the value\0A *                  is needed for later processing, because the \5Cp input buffer\0A *                  is no longer valid after this function returns.\0A *\0A *                  This function may call mbedtls_ssl_set_async_operation_data()\0A *                  to store an operation context for later retrieval\0A *                  by the resume or cancel callback.\0A *\0A * \5Cwarning         RSA decryption as used in TLS is subject to a potential\0A *                  timing side channel attack first discovered by Bleichenbacher\0A *                  in 1998. This attack can be remotely exploitable\0A *                  in practice. To avoid this attack, you must ensure that\0A *                  if the callback performs an RSA decryption, the time it\0A *                  takes to execute and return the result does not depend\0A *                  on whether the RSA decryption succeeded or reported\0A *                  invalid padding.\0A *\0A * \5Cparam ssl             The SSL connection instance. It should not be\0A *                        modified other than via\0A *                        mbedtls_ssl_set_async_operation_data().\0A * \5Cparam cert            Certificate containing the public key.\0A *                        In simple cases, this is one of the pointers passed to\0A *                        mbedtls_ssl_conf_own_cert() when configuring the SSL\0A *                        connection. However, if other callbacks are used, this\0A *                        property may not hold. For example, if an SNI callback\0A *                        is registered with mbedtls_ssl_conf_sni(), then\0A *                        this callback determines what certificate is used.\0A * \5Cparam input           Buffer containing the input ciphertext. This buffer\0A *                        is no longer valid when the function returns.\0A * \5Cparam input_len       Size of the \5Cp input buffer in bytes.\0A *\0A * \5Creturn          0 if the operation was started successfully and the SSL\0A *                  stack should call the resume callback immediately.\0A * \5Creturn          #MBEDTLS_ERR_SSL_ASYNC_IN_PROGRESS if the operation\0A *                  was started successfully and the SSL stack should return\0A *                  immediately without calling the resume callback yet.\0A * \5Creturn          #MBEDTLS_ERR_SSL_HW_ACCEL_FALLTHROUGH if the external\0A *                  processor does not support this key. The SSL stack will\0A *                  use the private key object instead.\0A * \5Creturn          Any other error indicates a fatal failure and is\0A *                  propagated up the call chain. The callback should\0A *                  use \5Cc MBEDTLS_ERR_PK_xxx error codes, and <b>must not</b>\0A *                  use \5Cc MBEDTLS_ERR_SSL_xxx error codes except as\0A *                  directed in the documentation of this callback.\0A */\0Atypedef int mbedtls_ssl_async_decrypt_t(mbedtls_ssl_context *ssl,\0A                                        mbedtls_x509_crt *cert,\0A                                        const unsigned char *input,\0A                                        size_t input_len);\0A#endif /* MBEDTLS_X509_CRT_PARSE_C */\0A\0A/**\0A * \5Cbrief           Callback type: resume external operation.\0A *\0A *                  This callback is called during an SSL handshake to resume\0A *                  an external operation started by the\0A *                  ::mbedtls_ssl_async_sign_t or\0A *                  ::mbedtls_ssl_async_decrypt_t callback.\0A *\0A *                  This function typically checks the status of a pending\0A *                  request or causes the request queue to make progress, and\0A *                  does not wait for the operation to complete. This allows\0A *                  the handshake step to be non-blocking.\0A *\0A *                  This function may call mbedtls_ssl_get_async_operation_data()\0A *                  to retrieve an operation context set by the start callback.\0A *                  It may call mbedtls_ssl_set_async_operation_data() to modify\0A *                  this context.\0A *\0A *                  Note that when this function returns a status other than\0A *                  #MBEDTLS_ERR_SSL_ASYNC_IN_PROGRESS, it must free any\0A *                  resources associated with the operation.\0A *\0A * \5Cparam ssl             The SSL connection instance. It should not be\0A *                        modified other than via\0A *                        mbedtls_ssl_set_async_operation_data().\0A * \5Cparam output          Buffer containing the output (signature or decrypted\0A *                        data) on success.\0A * \5Cparam output_len      On success, number of bytes written to \5Cp output.\0A * \5Cparam output_size     Size of the \5Cp output buffer in bytes.\0A *\0A * \5Creturn          0 if output of the operation is available in the\0A *                  \5Cp output buffer.\0A * \5Creturn          #MBEDTLS_ERR_SSL_ASYNC_IN_PROGRESS if the operation\0A *                  is still in progress. Subsequent requests for progress\0A *                  on the SSL connection will call the resume callback\0A *                  again.\0A * \5Creturn          Any other error means that the operation is aborted.\0A *                  The SSL handshake is aborted. The callback should\0A *                  use \5Cc MBEDTLS_ERR_PK_xxx error codes, and <b>must not</b>\0A *                  use \5Cc MBEDTLS_ERR_SSL_xxx error codes except as\0A *                  directed in the documentation of this callback.\0A */\0Atypedef int mbedtls_ssl_async_resume_t(mbedtls_ssl_context *ssl,\0A                                       unsigned char *output,\0A                                       size_t *output_len,\0A                                       size_t output_size);\0A\0A/**\0A * \5Cbrief           Callback type: cancel external operation.\0A *\0A *                  This callback is called if an SSL connection is closed\0A *                  while an asynchronous operation is in progress. Note that\0A *                  this callback is not called if the\0A *                  ::mbedtls_ssl_async_resume_t callback has run and has\0A *                  returned a value other than\0A *                  #MBEDTLS_ERR_SSL_ASYNC_IN_PROGRESS, since in that case\0A *                  the asynchronous operation has already completed.\0A *\0A *                  This function may call mbedtls_ssl_get_async_operation_data()\0A *                  to retrieve an operation context set by the start callback.\0A *\0A * \5Cparam ssl             The SSL connection instance. It should not be\0A *                        modified.\0A */\0Atypedef void mbedtls_ssl_async_cancel_t(mbedtls_ssl_context *ssl);\0A#endif /* MBEDTLS_SSL_ASYNC_PRIVATE */\0A\0A#if defined(MBEDTLS_KEY_EXCHANGE_WITH_CERT_ENABLED) &&        \5C\0A    !defined(MBEDTLS_SSL_KEEP_PEER_CERTIFICATE)\0A#define MBEDTLS_SSL_PEER_CERT_DIGEST_MAX_LEN  48\0A#if defined(MBEDTLS_MD_CAN_SHA256)\0A#define MBEDTLS_SSL_PEER_CERT_DIGEST_DFL_TYPE MBEDTLS_MD_SHA256\0A#define MBEDTLS_SSL_PEER_CERT_DIGEST_DFL_LEN  32\0A#elif defined(MBEDTLS_MD_CAN_SHA384)\0A#define MBEDTLS_SSL_PEER_CERT_DIGEST_DFL_TYPE MBEDTLS_MD_SHA384\0A#define MBEDTLS_SSL_PEER_CERT_DIGEST_DFL_LEN  48\0A#elif defined(MBEDTLS_MD_CAN_SHA1)\0A#define MBEDTLS_SSL_PEER_CERT_DIGEST_DFL_TYPE MBEDTLS_MD_SHA1\0A#define MBEDTLS_SSL_PEER_CERT_DIGEST_DFL_LEN  20\0A#else\0A/* This is already checked in check_config.h, but be sure. */\0A#error \22Bad configuration - need SHA-1, SHA-256 or SHA-512 enabled to compute digest of peer CRT.\22\0A#endif\0A#endif /* MBEDTLS_KEY_EXCHANGE_WITH_CERT_ENABLED &&\0A          !MBEDTLS_SSL_KEEP_PEER_CERTIFICATE */\0A\0Atypedef struct {\0A    unsigned char client_application_traffic_secret_N[MBEDTLS_TLS1_3_MD_MAX_SIZE];\0A    unsigned char server_application_traffic_secret_N[MBEDTLS_TLS1_3_MD_MAX_SIZE];\0A    unsigned char exporter_master_secret[MBEDTLS_TLS1_3_MD_MAX_SIZE];\0A    unsigned char resumption_master_secret[MBEDTLS_TLS1_3_MD_MAX_SIZE];\0A} mbedtls_ssl_tls13_application_secrets;\0A\0A#if defined(MBEDTLS_SSL_DTLS_SRTP)\0A\0A#define MBEDTLS_TLS_SRTP_MAX_MKI_LENGTH             255\0A#define MBEDTLS_TLS_SRTP_MAX_PROFILE_LIST_LENGTH    4\0A/*\0A * For code readability use a typedef for DTLS-SRTP profiles\0A *\0A * Use_srtp extension protection profiles values as defined in\0A * http://www.iana.org/assignments/srtp-protection/srtp-protection.xhtml\0A *\0A * Reminder: if this list is expanded mbedtls_ssl_check_srtp_profile_value\0A * must be updated too.\0A */\0A#define MBEDTLS_TLS_SRTP_AES128_CM_HMAC_SHA1_80     ((uint16_t) 0x0001)\0A#define MBEDTLS_TLS_SRTP_AES128_CM_HMAC_SHA1_32     ((uint16_t) 0x0002)\0A#define MBEDTLS_TLS_SRTP_NULL_HMAC_SHA1_80          ((uint16_t) 0x0005)\0A#define MBEDTLS_TLS_SRTP_NULL_HMAC_SHA1_32          ((uint16_t) 0x0006)\0A/* This one is not iana defined, but for code readability. */\0A#define MBEDTLS_TLS_SRTP_UNSET                      ((uint16_t) 0x0000)\0A\0Atypedef uint16_t mbedtls_ssl_srtp_profile;\0A\0Atypedef struct mbedtls_dtls_srtp_info_t {\0A    /*! The SRTP profile that was negotiated. */\0A    mbedtls_ssl_srtp_profile MBEDTLS_PRIVATE(chosen_dtls_srtp_profile);\0A    /*! The length of mki_value. */\0A    uint16_t MBEDTLS_PRIVATE(mki_len);\0A    /*! The mki_value used, with max size of 256 bytes. */\0A    unsigned char MBEDTLS_PRIVATE(mki_value)[MBEDTLS_TLS_SRTP_MAX_MKI_LENGTH];\0A}\0Ambedtls_dtls_srtp_info;\0A\0A#endif /* MBEDTLS_SSL_DTLS_SRTP */\0A\0A/** Human-friendly representation of the (D)TLS protocol version. */\0Atypedef enum {\0A    MBEDTLS_SSL_VERSION_UNKNOWN, /*!< Context not in use or version not yet negotiated. */\0A    MBEDTLS_SSL_VERSION_TLS1_2 = 0x0303, /*!< (D)TLS 1.2 */\0A    MBEDTLS_SSL_VERSION_TLS1_3 = 0x0304, /*!< (D)TLS 1.3 */\0A} mbedtls_ssl_protocol_version;\0A\0A/*\0A * This structure is used for storing current session data.\0A *\0A * Note: when changing this definition, we need to check and update:\0A *  - in tests/suites/test_suite_ssl.function:\0A *      ssl_populate_session() and ssl_serialize_session_save_load()\0A *  - in library/ssl_tls.c:\0A *      mbedtls_ssl_session_init() and mbedtls_ssl_session_free()\0A *      mbedtls_ssl_session_save() and ssl_session_load()\0A *      ssl_session_copy()\0A */\0Astruct mbedtls_ssl_session {\0A#if defined(MBEDTLS_SSL_MAX_FRAGMENT_LENGTH)\0A    unsigned char MBEDTLS_PRIVATE(mfl_code);     /*!< MaxFragmentLength negotiated by peer */\0A#endif /* MBEDTLS_SSL_MAX_FRAGMENT_LENGTH */\0A\0A/*!< RecordSizeLimit received from the peer */\0A#if defined(MBEDTLS_SSL_RECORD_SIZE_LIMIT)\0A    uint16_t MBEDTLS_PRIVATE(record_size_limit);\0A#endif /* MBEDTLS_SSL_RECORD_SIZE_LIMIT */\0A\0A    unsigned char MBEDTLS_PRIVATE(exported);\0A    uint8_t MBEDTLS_PRIVATE(endpoint);          /*!< 0: client, 1: server */\0A\0A    /** TLS version negotiated in the session. Used if and when renegotiating\0A     *  or resuming a session instead of the configured minor TLS version.\0A     */\0A    mbedtls_ssl_protocol_version MBEDTLS_PRIVATE(tls_version);\0A\0A#if defined(MBEDTLS_HAVE_TIME)\0A    mbedtls_time_t MBEDTLS_PRIVATE(start);       /*!< start time of current session */\0A#endif\0A    int MBEDTLS_PRIVATE(ciphersuite);            /*!< chosen ciphersuite */\0A    size_t MBEDTLS_PRIVATE(id_len);              /*!< session id length  */\0A    unsigned char MBEDTLS_PRIVATE(id)[32];       /*!< session identifier */\0A    unsigned char MBEDTLS_PRIVATE(master)[48];   /*!< the master secret  */\0A\0A#if defined(MBEDTLS_X509_CRT_PARSE_C)\0A#if defined(MBEDTLS_SSL_KEEP_PEER_CERTIFICATE)\0A    mbedtls_x509_crt *MBEDTLS_PRIVATE(peer_cert);       /*!< peer X.509 cert chain */\0A#else /* MBEDTLS_SSL_KEEP_PEER_CERTIFICATE */\0A    /*! The digest of the peer's end-CRT. This must be kept to detect CRT\0A     *  changes during renegotiation, mitigating the triple handshake attack. */\0A    unsigned char *MBEDTLS_PRIVATE(peer_cert_digest);\0A    size_t MBEDTLS_PRIVATE(peer_cert_digest_len);\0A    mbedtls_md_type_t MBEDTLS_PRIVATE(peer_cert_digest_type);\0A#endif /* !MBEDTLS_SSL_KEEP_PEER_CERTIFICATE */\0A#endif /* MBEDTLS_X509_CRT_PARSE_C */\0A    uint32_t MBEDTLS_PRIVATE(verify_result);          /*!<  verification result     */\0A\0A#if defined(MBEDTLS_SSL_SESSION_TICKETS) && defined(MBEDTLS_SSL_CLI_C)\0A    unsigned char *MBEDTLS_PRIVATE(ticket);      /*!< RFC 5077 session ticket */\0A    size_t MBEDTLS_PRIVATE(ticket_len);          /*!< session ticket length   */\0A    uint32_t MBEDTLS_PRIVATE(ticket_lifetime);   /*!< ticket lifetime hint    */\0A#endif /* MBEDTLS_SSL_SESSION_TICKETS && MBEDTLS_SSL_CLI_C */\0A\0A#if defined(MBEDTLS_SSL_SESSION_TICKETS) && defined(MBEDTLS_SSL_SRV_C) && \5C\0A    defined(MBEDTLS_HAVE_TIME)\0A    /*! When a ticket is created by a TLS server as part of an established TLS\0A     *  session, the ticket creation time may need to be saved for the ticket\0A     *  module to be able to check the ticket age when the ticket is used.\0A     *  That's the purpose of this field.\0A     *  Before creating a new ticket, an Mbed TLS server set this field with\0A     *  its current time in milliseconds. This time may then be saved in the\0A     *  session ticket data by the session ticket writing function and\0A     *  recovered by the ticket parsing function later when the ticket is used.\0A     *  The ticket module may then use this time to compute the ticket age and\0A     *  determine if it has expired or not.\0A     *  The Mbed TLS implementations of the session ticket writing and parsing\0A     *  functions save and retrieve the ticket creation time as part of the\0A     *  session ticket data. The session ticket parsing function relies on\0A     *  the mbedtls_ssl_session_get_ticket_creation_time() API to get the\0A     *  ticket creation time from the session ticket data.\0A     */\0A    mbedtls_ms_time_t MBEDTLS_PRIVATE(ticket_creation_time);\0A#endif\0A\0A#if defined(MBEDTLS_SSL_PROTO_TLS1_3) && defined(MBEDTLS_SSL_SESSION_TICKETS)\0A    uint32_t MBEDTLS_PRIVATE(ticket_age_add);     /*!< Randomly generated value used to obscure the age of the ticket */\0A    uint8_t MBEDTLS_PRIVATE(ticket_flags);        /*!< Ticket flags */\0A    uint8_t MBEDTLS_PRIVATE(resumption_key_len);  /*!< resumption_key length */\0A    unsigned char MBEDTLS_PRIVATE(resumption_key)[MBEDTLS_SSL_TLS1_3_TICKET_RESUMPTION_KEY_LEN];\0A\0A#if defined(MBEDTLS_SSL_SERVER_NAME_INDICATION) && defined(MBEDTLS_SSL_CLI_C)\0A    char *MBEDTLS_PRIVATE(hostname);             /*!< host name binded with tickets */\0A#endif /* MBEDTLS_SSL_SERVER_NAME_INDICATION && MBEDTLS_SSL_CLI_C */\0A\0A#if defined(MBEDTLS_SSL_EARLY_DATA) && defined(MBEDTLS_SSL_ALPN) && defined(MBEDTLS_SSL_SRV_C)\0A    char *ticket_alpn;                      /*!< ALPN negotiated in the session\0A                                                 during which the ticket was generated. */\0A#endif\0A\0A#if defined(MBEDTLS_HAVE_TIME) && defined(MBEDTLS_SSL_CLI_C)\0A    /*! Time in milliseconds when the last ticket was received. */\0A    mbedtls_ms_time_t MBEDTLS_PRIVATE(ticket_reception_time);\0A#endif\0A#endif /*  MBEDTLS_SSL_PROTO_TLS1_3 && MBEDTLS_SSL_SESSION_TICKETS */\0A\0A#if defined(MBEDTLS_SSL_EARLY_DATA)\0A    uint32_t MBEDTLS_PRIVATE(max_early_data_size);          /*!< maximum amount of early data in tickets */\0A#endif\0A\0A#if defined(MBEDTLS_SSL_ENCRYPT_THEN_MAC)\0A    int MBEDTLS_PRIVATE(encrypt_then_mac);       /*!< flag for EtM activation                */\0A#endif\0A\0A#if defined(MBEDTLS_SSL_PROTO_TLS1_3)\0A    mbedtls_ssl_tls13_application_secrets MBEDTLS_PRIVATE(app_secrets);\0A#endif\0A};\0A\0A/*\0A * Identifiers for PRFs used in various versions of TLS.\0A */\0Atypedef enum {\0A    MBEDTLS_SSL_TLS_PRF_NONE,\0A    MBEDTLS_SSL_TLS_PRF_SHA384,\0A    MBEDTLS_SSL_TLS_PRF_SHA256,\0A    MBEDTLS_SSL_HKDF_EXPAND_SHA384,\0A    MBEDTLS_SSL_HKDF_EXPAND_SHA256\0A}\0Ambedtls_tls_prf_types;\0A\0Atypedef enum {\0A    MBEDTLS_SSL_KEY_EXPORT_TLS12_MASTER_SECRET = 0,\0A#if defined(MBEDTLS_SSL_PROTO_TLS1_3)\0A    MBEDTLS_SSL_KEY_EXPORT_TLS1_3_CLIENT_EARLY_SECRET,\0A    MBEDTLS_SSL_KEY_EXPORT_TLS1_3_EARLY_EXPORTER_SECRET,\0A    MBEDTLS_SSL_KEY_EXPORT_TLS1_3_CLIENT_HANDSHAKE_TRAFFIC_SECRET,\0A    MBEDTLS_SSL_KEY_EXPORT_TLS1_3_SERVER_HANDSHAKE_TRAFFIC_SECRET,\0A    MBEDTLS_SSL_KEY_EXPORT_TLS1_3_CLIENT_APPLICATION_TRAFFIC_SECRET,\0A    MBEDTLS_SSL_KEY_EXPORT_TLS1_3_SERVER_APPLICATION_TRAFFIC_SECRET,\0A#endif /* MBEDTLS_SSL_PROTO_TLS1_3 */\0A} mbedtls_ssl_key_export_type;\0A\0A/**\0A * \5Cbrief           Callback type: Export key alongside random values for\0A *                                 session identification, and PRF for\0A *                                 implementation of TLS key exporters.\0A *\0A * \5Cparam p_expkey   Context for the callback.\0A * \5Cparam type       The type of the key that is being exported.\0A * \5Cparam secret     The address of the buffer holding the secret\0A *                   that's being exporterd.\0A * \5Cparam secret_len The length of \5Cp secret in bytes.\0A * \5Cparam client_random The client random bytes.\0A * \5Cparam server_random The server random bytes.\0A * \5Cparam tls_prf_type The identifier for the PRF used in the handshake\0A *                     to which the key belongs.\0A */\0Atypedef void mbedtls_ssl_export_keys_t(void *p_expkey,\0A                                       mbedtls_ssl_key_export_type type,\0A                                       const unsigned char *secret,\0A                                       size_t secret_len,\0A                                       const unsigned char client_random[32],\0A                                       const unsigned char server_random[32],\0A                                       mbedtls_tls_prf_types tls_prf_type);\0A\0A#if defined(MBEDTLS_SSL_SRV_C)\0A/**\0A * \5Cbrief           Callback type: generic handshake callback\0A *\0A * \5Cnote            Callbacks may use user_data funcs to set/get app user data.\0A *                  See \5Cc mbedtls_ssl_get_user_data_p()\0A *                      \5Cc mbedtls_ssl_get_user_data_n()\0A *                      \5Cc mbedtls_ssl_conf_get_user_data_p()\0A *                      \5Cc mbedtls_ssl_conf_get_user_data_n()\0A *\0A * \5Cparam ssl       \5Cc mbedtls_ssl_context on which the callback is run\0A *\0A * \5Creturn          The return value of the callback is 0 if successful,\0A *                  or a specific MBEDTLS_ERR_XXX code, which will cause\0A *                  the handshake to be aborted.\0A */\0Atypedef int (*mbedtls_ssl_hs_cb_t)(mbedtls_ssl_context *ssl);\0A#endif\0A\0A/* A type for storing user data in a library structure.\0A *\0A * The representation of type may change in future versions of the library.\0A * Only the behaviors guaranteed by documented accessor functions are\0A * guaranteed to remain stable.\0A */\0Atypedef union {\0A    uintptr_t n;                /* typically a handle to an associated object */\0A    void *p;                    /* typically a pointer to extra data */\0A} mbedtls_ssl_user_data_t;\0A\0A/**\0A * SSL/TLS configuration to be shared between mbedtls_ssl_context structures.\0A */\0Astruct mbedtls_ssl_config {\0A    /* Group items mostly by size. This helps to reduce memory wasted to\0A     * padding. It also helps to keep smaller fields early in the structure,\0A     * so that elements tend to be in the 128-element direct access window\0A     * on Arm Thumb, which reduces the code size. */\0A\0A    mbedtls_ssl_protocol_version MBEDTLS_PRIVATE(max_tls_version);  /*!< max. TLS version used */\0A    mbedtls_ssl_protocol_version MBEDTLS_PRIVATE(min_tls_version);  /*!< min. TLS version used */\0A\0A    /*\0A     * Flags (could be bit-fields to save RAM, but separate bytes make\0A     * the code smaller on architectures with an instruction for direct\0A     * byte access).\0A     */\0A\0A    uint8_t MBEDTLS_PRIVATE(endpoint);      /*!< 0: client, 1: server               */\0A    uint8_t MBEDTLS_PRIVATE(transport);     /*!< 0: stream (TLS), 1: datagram (DTLS)    */\0A    uint8_t MBEDTLS_PRIVATE(authmode);      /*!< MBEDTLS_SSL_VERIFY_XXX             */\0A    /* needed even with renego disabled for LEGACY_BREAK_HANDSHAKE          */\0A    uint8_t MBEDTLS_PRIVATE(allow_legacy_renegotiation); /*!< MBEDTLS_LEGACY_XXX   */\0A#if defined(MBEDTLS_SSL_MAX_FRAGMENT_LENGTH)\0A    uint8_t MBEDTLS_PRIVATE(mfl_code);      /*!< desired fragment length indicator\0A                                                 (MBEDTLS_SSL_MAX_FRAG_LEN_XXX) */\0A#endif\0A#if defined(MBEDTLS_SSL_ENCRYPT_THEN_MAC)\0A    uint8_t MBEDTLS_PRIVATE(encrypt_then_mac); /*!< negotiate encrypt-then-mac?    */\0A#endif\0A#if defined(MBEDTLS_SSL_EXTENDED_MASTER_SECRET)\0A    uint8_t MBEDTLS_PRIVATE(extended_ms);   /*!< negotiate extended master secret?  */\0A#endif\0A#if defined(MBEDTLS_SSL_DTLS_ANTI_REPLAY)\0A    uint8_t MBEDTLS_PRIVATE(anti_replay);   /*!< detect and prevent replay?         */\0A#endif\0A#if defined(MBEDTLS_SSL_RENEGOTIATION)\0A    uint8_t MBEDTLS_PRIVATE(disable_renegotiation); /*!< disable renegotiation?     */\0A#endif\0A#if defined(MBEDTLS_SSL_SESSION_TICKETS) && \5C\0A    defined(MBEDTLS_SSL_CLI_C)\0A    /** Encodes two booleans, one stating whether TLS 1.2 session tickets are\0A     *  enabled or not, the other one whether the handling of TLS 1.3\0A     *  NewSessionTicket messages is enabled or not. They are respectively set\0A     *  by mbedtls_ssl_conf_session_tickets() and\0A     *  mbedtls_ssl_conf_tls13_enable_signal_new_session_tickets().\0A     */\0A    uint8_t MBEDTLS_PRIVATE(session_tickets);   /*!< use session tickets? */\0A#endif\0A\0A#if defined(MBEDTLS_SSL_SESSION_TICKETS) && \5C\0A    defined(MBEDTLS_SSL_SRV_C) && \5C\0A    defined(MBEDTLS_SSL_PROTO_TLS1_3)\0A    uint16_t MBEDTLS_PRIVATE(new_session_tickets_count);   /*!< number of NewSessionTicket */\0A#endif\0A\0A#if defined(MBEDTLS_SSL_SRV_C)\0A    uint8_t MBEDTLS_PRIVATE(cert_req_ca_list);  /*!< enable sending CA list in\0A                                                     Certificate Request messages? */\0A    uint8_t MBEDTLS_PRIVATE(respect_cli_pref);  /*!< pick the ciphersuite according to\0A                                                     the client's preferences rather\0A                                                     than ours? */\0A#endif\0A#if defined(MBEDTLS_SSL_DTLS_CONNECTION_ID)\0A    uint8_t MBEDTLS_PRIVATE(ignore_unexpected_cid); /*!< Should DTLS record with\0A                                                     *   unexpected CID\0A                                                     *   lead to failure? */\0A#endif /* MBEDTLS_SSL_DTLS_CONNECTION_ID */\0A#if defined(MBEDTLS_SSL_DTLS_SRTP)\0A    uint8_t MBEDTLS_PRIVATE(dtls_srtp_mki_support); /* support having mki_value\0A                                                       in the use_srtp extension? */\0A#endif\0A\0A    /*\0A     * Pointers\0A     */\0A\0A    /** Allowed ciphersuites for (D)TLS 1.2 (0-terminated)                  */\0A    const int *MBEDTLS_PRIVATE(ciphersuite_list);\0A\0A#if defined(MBEDTLS_SSL_PROTO_TLS1_3)\0A    /** Allowed TLS 1.3 key exchange modes.                                 */\0A    int MBEDTLS_PRIVATE(tls13_kex_modes);\0A#endif /* MBEDTLS_SSL_PROTO_TLS1_3 */\0A\0A    /** Callback for printing debug output                                  */\0A    void(*MBEDTLS_PRIVATE(f_dbg))(void *, int, const char *, int, const char *);\0A    void *MBEDTLS_PRIVATE(p_dbg);                    /*!< context for the debug function     */\0A\0A    /** Callback for getting (pseudo-)random numbers                        */\0A    int(*MBEDTLS_PRIVATE(f_rng))(void *, unsigned char *, size_t);\0A    void *MBEDTLS_PRIVATE(p_rng);                    /*!< context for the RNG function       */\0A\0A    /** Callback to retrieve a session from the cache                       */\0A    mbedtls_ssl_cache_get_t *MBEDTLS_PRIVATE(f_get_cache);\0A    /** Callback to store a session into the cache                          */\0A    mbedtls_ssl_cache_set_t *MBEDTLS_PRIVATE(f_set_cache);\0A    void *MBEDTLS_PRIVATE(p_cache);                  /*!< context for cache callbacks        */\0A\0A#if defined(MBEDTLS_SSL_SERVER_NAME_INDICATION)\0A    /** Callback for setting cert according to SNI extension                */\0A    int(*MBEDTLS_PRIVATE(f_sni))(void *, mbedtls_ssl_context *, const unsigned char *, size_t);\0A    void *MBEDTLS_PRIVATE(p_sni);                    /*!< context for SNI callback           */\0A#endif\0A\0A#if defined(MBEDTLS_X509_CRT_PARSE_C)\0A    /** Callback to customize X.509 certificate chain verification          */\0A    int(*MBEDTLS_PRIVATE(f_vrfy))(void *, mbedtls_x509_crt *, int, uint32_t *);\0A    void *MBEDTLS_PRIVATE(p_vrfy);                   /*!< context for X.509 verify calllback */\0A#endif\0A\0A#if defined(MBEDTLS_SSL_HANDSHAKE_WITH_PSK_ENABLED)\0A#if defined(MBEDTLS_SSL_SRV_C)\0A    /** Callback to retrieve PSK key from identity                          */\0A    int(*MBEDTLS_PRIVATE(f_psk))(void *, mbedtls_ssl_context *, const unsigned char *, size_t);\0A    void *MBEDTLS_PRIVATE(p_psk);                    /*!< context for PSK callback           */\0A#endif\0A#endif\0A\0A#if defined(MBEDTLS_SSL_DTLS_HELLO_VERIFY) && defined(MBEDTLS_SSL_SRV_C)\0A    /** Callback to create & write a cookie for ClientHello verification    */\0A    int(*MBEDTLS_PRIVATE(f_cookie_write))(void *, unsigned char **, unsigned char *,\0A                                          const unsigned char *, size_t);\0A    /** Callback to verify validity of a ClientHello cookie                 */\0A    int(*MBEDTLS_PRIVATE(f_cookie_check))(void *, const unsigned char *, size_t,\0A                                          const unsigned char *, size_t);\0A    void *MBEDTLS_PRIVATE(p_cookie);                 /*!< context for the cookie callbacks   */\0A#endif\0A\0A#if defined(MBEDTLS_SSL_SESSION_TICKETS) && defined(MBEDTLS_SSL_SRV_C)\0A    /** Callback to create & write a session ticket                         */\0A    int(*MBEDTLS_PRIVATE(f_ticket_write))(void *, const mbedtls_ssl_session *,\0A                                          unsigned char *, const unsigned char *, size_t *,\0A                                          uint32_t *);\0A    /** Callback to parse a session ticket into a session structure         */\0A    int(*MBEDTLS_PRIVATE(f_ticket_parse))(void *, mbedtls_ssl_session *, unsigned char *, size_t);\0A    void *MBEDTLS_PRIVATE(p_ticket);                 /*!< context for the ticket callbacks   */\0A#endif /* MBEDTLS_SSL_SESSION_TICKETS && MBEDTLS_SSL_SRV_C */\0A#if defined(MBEDTLS_SSL_DTLS_CONNECTION_ID)\0A    size_t MBEDTLS_PRIVATE(cid_len); /*!< The length of CIDs for incoming DTLS records.      */\0A#endif /* MBEDTLS_SSL_DTLS_CONNECTION_ID */\0A\0A#if defined(MBEDTLS_X509_CRT_PARSE_C)\0A    const mbedtls_x509_crt_profile *MBEDTLS_PRIVATE(cert_profile); /*!< verification profile */\0A    mbedtls_ssl_key_cert *MBEDTLS_PRIVATE(key_cert); /*!< own certificate/key pair(s)        */\0A    mbedtls_x509_crt *MBEDTLS_PRIVATE(ca_chain);     /*!< trusted CAs                        */\0A    mbedtls_x509_crl *MBEDTLS_PRIVATE(ca_crl);       /*!< trusted CAs CRLs                   */\0A#if defined(MBEDTLS_X509_TRUSTED_CERTIFICATE_CALLBACK)\0A    mbedtls_x509_crt_ca_cb_t MBEDTLS_PRIVATE(f_ca_cb);\0A    void *MBEDTLS_PRIVATE(p_ca_cb);\0A#endif /* MBEDTLS_X509_TRUSTED_CERTIFICATE_CALLBACK */\0A#endif /* MBEDTLS_X509_CRT_PARSE_C */\0A\0A#if defined(MBEDTLS_SSL_ASYNC_PRIVATE)\0A#if defined(MBEDTLS_X509_CRT_PARSE_C)\0A    mbedtls_ssl_async_sign_t *MBEDTLS_PRIVATE(f_async_sign_start); /*!< start asynchronous signature operatio