@.str41296 = private global { i64, i64, [38476 x i8] } { i64 -1, i64 38475, [38476 x i8] c"/**\0A * \5Cfile oid.c\0A *\0A * \5Cbrief Object Identifier (OID) database\0A *\0A *  Copyright The Mbed TLS Contributors\0A *  SPDX-License-Identifier: Apache-2.0 OR GPL-2.0-or-later\0A */\0A\0A#include \22common.h\22\0A\0A#if defined(MBEDTLS_OID_C)\0A\0A#include \22mbedtls/oid.h\22\0A#include \22mbedtls/rsa.h\22\0A#include \22mbedtls/error.h\22\0A#include \22mbedtls/pk.h\22\0A\0A#include <stdio.h>\0A#include <string.h>\0A\0A#include \22mbedtls/platform.h\22\0A\0A/*\0A * Macro to automatically add the size of #define'd OIDs\0A */\0A#define ADD_LEN(s)      s, MBEDTLS_OID_SIZE(s)\0A\0A/*\0A * Macro to generate mbedtls_oid_descriptor_t\0A */\0A#if !defined(MBEDTLS_X509_REMOVE_INFO)\0A#define OID_DESCRIPTOR(s, name, description)  { ADD_LEN(s), name, description }\0A#define NULL_OID_DESCRIPTOR                   { NULL, 0, NULL, NULL }\0A#else\0A#define OID_DESCRIPTOR(s, name, description)  { ADD_LEN(s) }\0A#define NULL_OID_DESCRIPTOR                   { NULL, 0 }\0A#endif\0A\0A/*\0A * Macro to generate an internal function for oid_XXX_from_asn1() (used by\0A * the other functions)\0A */\0A#define FN_OID_TYPED_FROM_ASN1(TYPE_T, NAME, LIST)                    \5C\0A    static const TYPE_T *oid_ ## NAME ## _from_asn1(                   \5C\0A        const mbedtls_asn1_buf *oid)     \5C\0A    {                                                                   \5C\0A        const TYPE_T *p = (LIST);                                       \5C\0A        const mbedtls_oid_descriptor_t *cur =                           \5C\0A            (const mbedtls_oid_descriptor_t *) p;                       \5C\0A        if (p == NULL || oid == NULL) return NULL;                  \5C\0A        while (cur->asn1 != NULL) {                                    \5C\0A            if (cur->asn1_len == oid->len &&                            \5C\0A                memcmp(cur->asn1, oid->p, oid->len) == 0) {          \5C\0A                return p;                                            \5C\0A            }                                                           \5C\0A            p++;                                                        \5C\0A            cur = (const mbedtls_oid_descriptor_t *) p;                 \5C\0A        }                                                               \5C\0A        return NULL;                                                 \5C\0A    }\0A\0A#if !defined(MBEDTLS_X509_REMOVE_INFO)\0A/*\0A * Macro to generate a function for retrieving a single attribute from the\0A * descriptor of an mbedtls_oid_descriptor_t wrapper.\0A */\0A#define FN_OID_GET_DESCRIPTOR_ATTR1(FN_NAME, TYPE_T, TYPE_NAME, ATTR1_TYPE, ATTR1) \5C\0A    int FN_NAME(const mbedtls_asn1_buf *oid, ATTR1_TYPE * ATTR1)                  \5C\0A    {                                                                       \5C\0A        const TYPE_T *data = oid_ ## TYPE_NAME ## _from_asn1(oid);        \5C\0A        if (data == NULL) return MBEDTLS_ERR_OID_NOT_FOUND;            \5C\0A        *ATTR1 = data->descriptor.ATTR1;                                    \5C\0A        return 0;                                                        \5C\0A    }\0A#endif /* MBEDTLS_X509_REMOVE_INFO */\0A\0A/*\0A * Macro to generate a function for retrieving a single attribute from an\0A * mbedtls_oid_descriptor_t wrapper.\0A */\0A#define FN_OID_GET_ATTR1(FN_NAME, TYPE_T, TYPE_NAME, ATTR1_TYPE, ATTR1) \5C\0A    int FN_NAME(const mbedtls_asn1_buf *oid, ATTR1_TYPE * ATTR1)                  \5C\0A    {                                                                       \5C\0A        const TYPE_T *data = oid_ ## TYPE_NAME ## _from_asn1(oid);        \5C\0A        if (data == NULL) return MBEDTLS_ERR_OID_NOT_FOUND;            \5C\0A        *ATTR1 = data->ATTR1;                                               \5C\0A        return 0;                                                        \5C\0A    }\0A\0A/*