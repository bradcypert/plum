@.str40640 = private global { i64, i64, [20736 x i8] } { i64 -1, i64 20735, [20736 x i8] c"/**\0A *  Constant-time functions\0A *\0A *  Copyright The Mbed TLS Contributors\0A *  SPDX-License-Identifier: Apache-2.0 OR GPL-2.0-or-later\0A */\0A\0A#ifndef MBEDTLS_CONSTANT_TIME_INTERNAL_H\0A#define MBEDTLS_CONSTANT_TIME_INTERNAL_H\0A\0A#include <stdint.h>\0A#include <stddef.h>\0A\0A#include \22common.h\22\0A\0A#if defined(MBEDTLS_BIGNUM_C)\0A#include \22mbedtls/bignum.h\22\0A#endif\0A\0A/* The constant-time interface provides various operations that are likely\0A * to result in constant-time code that does not branch or use conditional\0A * instructions for secret data (for secret pointers, this also applies to\0A * the data pointed to).\0A *\0A * It has three main parts:\0A *\0A * - boolean operations\0A *   These are all named mbedtls_ct_<type>_<operation>.\0A *   They operate over <type> and return mbedtls_ct_condition_t.\0A *   All arguments are considered secret.\0A *   example: bool x = y | z          =>    x = mbedtls_ct_bool_or(y, z)\0A *   example: bool x = y == z         =>    x = mbedtls_ct_uint_eq(y, z)\0A *\0A * - conditional data selection\0A *   These are all named mbedtls_ct_<type>_if and mbedtls_ct_<type>_if_else_0\0A *   All arguments are considered secret.\0A *   example: size_t a = x ? b : c    =>    a = mbedtls_ct_size_if(x, b, c)\0A *   example: unsigned a = x ? b : 0  =>    a = mbedtls_ct_uint_if_else_0(x, b)\0A *\0A * - block memory operations\0A *   Only some arguments are considered secret, as documented for each\0A *   function.\0A *   example: if (x) memcpy(...)      =>    mbedtls_ct_memcpy_if(x, ...)\0A *\0A * mbedtls_ct_condition_t must be treated as opaque and only created and\0A * manipulated via the functions in this header. The compiler should never\0A * be able to prove anything about its value at compile-time.\0A *\0A * mbedtls_ct_uint_t is an unsigned integer type over which constant time\0A * operations may be performed via the functions in this header. It is as big\0A * as the larger of size_t and mbedtls_mpi_uint, i.e. it is safe to cast\0A * to/from \22unsigned int\22, \22size_t\22, and \22mbedtls_mpi_uint\22 (and any other\0A * not-larger integer types).\0A *\0A * For Arm (32-bit, 64-bit and Thumb), x86 and x86-64, assembly implementations\0A * are used to ensure that the generated code is constant time. For other\0A * architectures, it uses a plain C fallback designed to yield constant-time code\0A * (this has been observed to be constant-time on latest gcc, clang and MSVC\0A * as of May 2023).\0A *\0A * For readability, the static inline definitions are separated out into\0A * constant_time_impl.h.\0A */\0A\0A#if (SIZE_MAX > 0xffffffffffffffffULL)\0A/* Pointer size > 64-bit */\0Atypedef size_t    mbedtls_ct_condition_t;\0Atypedef size_t    mbedtls_ct_uint_t;\0Atypedef ptrdiff_t mbedtls_ct_int_t;\0A#define MBEDTLS_CT_TRUE  ((mbedtls_ct_condition_t) mbedtls_ct_compiler_opaque(SIZE_MAX))\0A#elif (SIZE_MAX > 0xffffffff) || defined(MBEDTLS_HAVE_INT64)\0A/* 32-bit < pointer size <= 64-bit, or 64-bit MPI */\0Atypedef uint64_t  mbedtls_ct_condition_t;\0Atypedef uint64_t  mbedtls_ct_uint_t;\0Atypedef int64_t   mbedtls_ct_int_t;\0A#define MBEDTLS_CT_SIZE_64\0A#define MBEDTLS_CT_TRUE  ((mbedtls_ct_condition_t) mbedtls_ct_compiler_opaque(UINT64_MAX))\0A#else\0A/* Pointer size <= 32-bit, and no 64-bit MPIs */\0Atypedef uint32_t  mbedtls_ct_condition_t;\0Atypedef uint32_t  mbedtls_ct_uint_t;\0Atypedef int32_t   mbedtls_ct_int_t;\0A#define MBEDTLS_CT_SIZE_32\0A#define MBEDTLS_CT_TRUE  ((mbedtls_ct_condition_t) mbedtls_ct_compiler_opaque(UINT32_MAX))\0A#endif\0A#define MBEDTLS_CT_FALSE ((mbedtls_ct_condition_t) mbedtls_ct_compiler_opaque(0))\0A\0A/* ============================================================================\0A * Boolean operations\0A */\0A\0A/** Convert a number into a mbedtls_ct_condition_t.\0A *\0A * \5Cparam x Number to convert.\0A *\0A * \5Creturn MBEDTLS_CT_TRUE if \5Cp x != 0, or MBEDTLS_CT_FALSE if \5Cp x == 0\0A *\0A */\0Astatic inline mbedtls_ct_condition_t mbedtls_ct_bool(mbedtls_ct_uint_t x);\0A\0A/** Boolean \22not equal\22 operation.\0A *\0A * Functionally equivalent to:\0A *\0A * \5Cp x != \5Cp y\0A *\0A * \5Cparam x     The first value to analyze.\0A * \5Cparam y     The second value to analyze.\0A *\0A * \5Creturn      MBEDTLS_CT_TRUE if \5Cp x != \5Cp y, otherwise MBEDTLS_CT_FALSE.\0A */\0Astatic inline mbedtls_ct_condition_t mbedtls_ct_uint_ne(mbedtls_ct_uint_t x, mbedtls_ct_uint_t y);\0A\0A/** Boolean \22equals\22 operation.\0A *\0A * Functionally equivalent to:\0A *\0A * \5Cp x == \5Cp y\0A *\0A * \5Cparam x     The first value to analyze.\0A * \5Cparam y     The second value to analyze.\0A *\0A * \5Creturn      MBEDTLS_CT_TRUE if \5Cp x == \5Cp y, otherwise MBEDTLS_CT_FALSE.\0A */\0Astatic inline mbedtls_ct_condition_t mbedtls_ct_uint_eq(mbedtls_ct_uint_t x,\0A                                                        mbedtls_ct_uint_t y);\0A\0A/** Boolean \22less than\22 operation.\0A *\0A * Functionally equivalent to:\0A *\0A * \5Cp x < \5Cp y\0A *\0A * \5Cparam x     The first value to analyze.\0A * \5Cparam y     The second value to analyze.\0A *\0A * \5Creturn      MBEDTLS_CT_TRUE if \5Cp x < \5Cp y, otherwise MBEDTLS_CT_FALSE.\0A */\0Astatic inline mbedtls_ct_condition_t mbedtls_ct_uint_lt(mbedtls_ct_uint_t x, mbedtls_ct_uint_t y);\0A\0A/** Boolean \22greater than\22 operation.\0A *\0A * Functionally equivalent to:\0A *\0A * \5Cp x > \5Cp y\0A *\0A * \5Cparam x     The first value to analyze.\0A * \5Cparam y     The second value to analyze.\0A *\0A * \5Creturn      MBEDTLS_CT_TRUE if \5Cp x > \5Cp y, otherwise MBEDTLS_CT_FALSE.\0A */\0Astatic inline mbedtls_ct_condition_t mbedtls_ct_uint_gt(mbedtls_ct_uint_t x,\0A                                                        mbedtls_ct_uint_t y);\0A\0A/** Boolean \22greater or equal\22 operation.\0A *\0A * Functionally equivalent to:\0A *\0A * \5Cp x >= \5Cp y\0A *\0A * \5Cparam x     The first value to analyze.\0A * \5Cparam y     The second value to analyze.\0A *\0A * \5Creturn      MBEDTLS_CT_TRUE if \5Cp x >= \5Cp y,\0A *              otherwise MBEDTLS_CT_FALSE.\0A */\0Astatic inline mbedtls_ct_condition_t mbedtls_ct_uint_ge(mbedtls_ct_uint_t x,\0A                                                        mbedtls_ct_uint_t y);\0A\0A/** Boolean \22less than or equal\22 operation.\0A *\0A * Functionally equivalent to:\0A *\0A * \5Cp x <= \5Cp y\0A *\0A * \5Cparam x     The first value to analyze.\0A * \5Cparam y     The second value to analyze.\0A *\0A * \5Creturn      MBEDTLS_CT_TRUE if \5Cp x <= \5Cp y,\0A *              otherwise MBEDTLS_CT_FALSE.\0A */\0Astatic inline mbedtls_ct_condition_t mbedtls_ct_uint_le(mbedtls_ct_uint_t x,\0A                                                        mbedtls_ct_uint_t y);\0A\0A/** Boolean not-equals operation.\0A *\0A * Functionally equivalent to:\0A *\0A * \5Cp x != \5Cp y\0A *\0A * \5Cparam x     The first value to analyze.\0A * \5Cparam y     The second value to analyze.\0A *\0A * \5Cnote        This is more efficient than mbedtls_ct_uint_ne if both arguments are\0A *              mbedtls_ct_condition_t.\0A *\0A * \5Creturn      MBEDTLS_CT_TRUE if \5Cp x != \5Cp y,\0A *              otherwise MBEDTLS_CT_FALSE.\0A */\0Astatic inline mbedtls_ct_condition_t mbedtls_ct_bool_ne(mbedtls_ct_condition_t x,\0A                                                        mbedtls_ct_condition_t y);\0A\0A/** Boolean \22and\22 operation.\0A *\0A * Functionally equivalent to:\0A *\0A * \5Cp x && \5Cp y\0A *\0A * \5Cparam x     The first value to analyze.\0A * \5Cparam y     The second value to analyze.\0A *\0A * \5Creturn      MBEDTLS_CT_TRUE if \5Cp x && \5Cp y,\0A *              otherwise MBEDTLS_CT_FALSE.\0A */\0Astatic inline mbedtls_ct_condition_t mbedtls_ct_bool_and(mbedtls_ct_condition_t x,\0A                                                         mbedtls_ct_condition_t y);\0A\0A/** Boolean \22or\22 operation.\0A *\0A * Functionally equivalent to:\0A *\0A * \5Cp x || \5Cp y\0A *\0A * \5Cparam x     The first value to analyze.\0A * \5Cparam y     The second value to analyze.\0A *\0A * \5Creturn      MBEDTLS_CT_TRUE if \5Cp x || \5Cp y,\0A *              otherwise MBEDTLS_CT_FALSE.\0A */\0Astatic inline mbedtls_ct_condition_t mbedtls_ct_bool_or(mbedtls_ct_condition_t x,\0A                                                        mbedtls_ct_condition_t y);\0A\0A/** Boolean \22not\22 operation.\0A *\0A * Functionally equivalent to:\0A *\0A * ! \5Cp x\0A *\0A * \5Cparam x     The value to invert\0A *\0A * \5Creturn      MBEDTLS_CT_FALSE if \5Cp x, otherwise MBEDTLS_CT_TRUE.\0A */\0Astatic inline mbedtls_ct_condition_t mbedtls_ct_bool_not(mbedtls_ct_condition_t x);\0A\0A\0A/* ============================================================================\0A * Data selection operations\0A */\0A\0A/** Choose between two size_t values.\0A *\0A * Functionally equivalent to:\0A *\0A * condition ? if1 : if0.\0A *\0A * \5Cparam condition     Condition to test.\0A * \5Cparam if1           Value to use if \5Cp condition == MBEDTLS_CT_TRUE.\0A * \5Cparam if0           Value to use if \5Cp condition == MBEDTLS_CT_FALSE.\0A *\0A * \5Creturn  \5Cc if1 if \5Cp condition == MBEDTLS_CT_TRUE, otherwise \5Cc if0.\0A */\0Astatic inline size_t mbedtls_ct_size_if(mbedtls_ct_condition_t condition,\0A                                        size_t if1,\0A                                        size_t if0);\0A\0A/** Choose between two unsigned values.\0A *\0A * Functionally equivalent to:\0A *\0A * condition ? if1 : if0.\0A *\0A * \5Cparam condition     Condition to test.\0A * \5Cparam if1           Value to use if \5Cp condition == MBEDTLS_CT_TRUE.\0A * \5Cparam if0           Value to use if \5Cp condition == MBEDTLS_CT_FALSE.\0A *\0A * \5Creturn  \5Cc if1 if \5Cp condition == MBEDTLS_CT_TRUE, otherwise \5Cc if0.\0A */\0Astatic inline unsigned mbedtls_ct_uint_if(mbedtls_ct_condition_t condition,\0A                                          unsigned if1,\0A                                          unsigned if0);\0A\0A/** Choose between two mbedtls_ct_condition_t values.\0A *\0A * Functionally equivalent to:\0A *\0A * condition ? if1 : if0.\0A *\0A * \5Cparam condition     Condition to test.\0A * \5Cparam if1           Value to use if \5Cp condition == MBEDTLS_CT_TRUE.\0A * \5Cparam if0           Value to use if \5Cp condition == MBEDTLS_CT_FALSE.\0A *\0A * \5Creturn  \5Cc if1 if \5Cp condition == MBEDTLS_CT_TRUE, otherwise \5Cc if0.\0A */\0Astatic inline mbedtls_ct_condition_t mbedtls_ct_bool_if(mbedtls_ct_condition_t condition,\0A                                                        mbedtls_ct_condition_t if1,\0A                                                        mbedtls_ct_condition_t if0);\0A\0A#if defined(MBEDTLS_BIGNUM_C)\0A\0A/** Choose between two mbedtls_mpi_uint values.\0A *\0A * Functionally equivalent to:\0A *\0A * condition ? if1 : if0.\0A *\0A * \5Cparam condition     Condition to test.\0A * \5Cparam if1           Value to use if \5Cp condition == MBEDTLS_CT_TRUE.\0A * \5Cparam if0           Value to use if \5Cp condition == MBEDTLS_CT_FALSE.\0A *\0A * \5Creturn  \5Cc if1 if \5Cp condition == MBEDTLS_CT_TRUE, otherwise \5Cc if0.\0A */\0Astatic inline mbedtls_mpi_uint mbedtls_ct_mpi_uint_if(mbedtls_ct_condition_t condition, \5C\0A                                                      mbedtls_mpi_uint if1, \5C\0A                                                      mbedtls_mpi_uint if0);\0A\0A#endif\0A\0A/** Choose between an unsigned value and 0.\0A *\0A * Functionally equivalent to:\0A *\0A * condition ? if1 : 0.\0A *\0A * Functionally equivalent to mbedtls_ct_uint_if(condition, if1, 0) but\0A * results in smaller code size.\0A *\0A * \5Cparam condition     Condition to test.\0A * \5Cparam if1           Value to use if \5Cp condition == MBEDTLS_CT_TRUE.\0A *\0A * \5Creturn  \5Cc if1 if \5Cp condition == MBEDTLS_CT_TRUE, otherwise 0.\0A */\0Astatic inline unsigned mbedtls_ct_uint_if_else_0(mbedtls_ct_condition_t condition, unsigned if1);\0A\0A/** Choose between an mbedtls_ct_condition_t and 0.\0A *\0A * Functionally equivalent to:\0A *\0A * condition ? if1 : 0.\0A *\0A * Functionally equivalent to mbedtls_ct_bool_if(condition, if1, 0) but\0A * results in smaller code size.\0A *\0A * \5Cparam condition     Condition to test.\0A * \5Cparam if1           Value to use if \5Cp condition == MBEDTLS_CT_TRUE.\0A *\0A * \5Creturn  \5Cc if1 if \5Cp condition == MBEDTLS_CT_TRUE, otherwise 0.\0A */\0Astatic inline mbedtls_ct_condition_t mbedtls_ct_bool_if_else_0(mbedtls_ct_condition_t condition,\0A                                                               mbedtls_ct_condition_t if1);\0A\0A/** Choose between a size_t value and 0.\0A *\0A * Functionally equivalent to:\0A *\0A * condition ? if1 : 0.\0A *\0A * Functionally equivalent to mbedtls_ct_size_if(condition, if1, 0) but\0A * results in smaller code size.\0A *\0A * \5Cparam condition     Condition to test.\0A * \5Cparam if1           Value to use if \5Cp condition == MBEDTLS_CT_TRUE.\0A *\0A * \5Creturn  \5Cc if1 if \5Cp condition == MBEDTLS_CT_TRUE, otherwise 0.\0A */\0Astatic inline size_t mbedtls_ct_size_if_else_0(mbedtls_ct_condition_t condition, size_t if1);\0A\0A#if defined(MBEDTLS_BIGNUM_C)\0A\0A/** Choose between an mbedtls_mpi_uint value and 0.\0A *\0A * Functionally equivalent to:\0A *\0A * condition ? if1 : 0.\0A *\0A * Functionally equivalent to mbedtls_ct_mpi_uint_if(condition, if1, 0) but\0A * results in smaller code size.\0A *\0A * \5Cparam condition     Condition to test.\0A * \5Cparam if1           Value to use if \5Cp condition == MBEDTLS_CT_TRUE.\0A *\0A * \5Creturn  \5Cc if1 if \5Cp condition == MBEDTLS_CT_TRUE, otherwise 0.\0A */\0Astatic inline mbedtls_mpi_uint mbedtls_ct_mpi_uint_if_else_0(mbedtls_ct_condition_t condition,\0A                                                             mbedtls_mpi_uint if1);\0A\0A#endif\0A\0A/** Constant-flow char selection\0A *\0A * \5Cparam low   Secret. Bottom of range\0A * \5Cparam high  Secret. Top of range\0A * \5Cparam c     Secret. Value to compare to range\0A * \5Cparam t     Secret. Value to return, if in range\0A *\0A * \5Creturn      \5Cp t if \5Cp low <= \5Cp c <= \5Cp high, 0 otherwise.\0A */\0Astatic inline unsigned char mbedtls_ct_uchar_in_range_if(unsigned char low,\0A                                                         unsigned char high,\0A                                                         unsigned char c,\0A                                                         unsigned char t);\0A\0A/** Choose between two error values. The values must be in the range [-32767..0].\0A *\0A * Functionally equivalent to:\0A *\0A * condition ? if1 : if0.\0A *\0A * \5Cparam condition     Condition to test.\0A * \5Cparam if1           Value to use if \5Cp condition == MBEDTLS_CT_TRUE.\0A * \5Cparam if0           Value to use if \5Cp condition == MBEDTLS_CT_FALSE.\0A *\0A * \5Creturn  \5Cc if1 if \5Cp condition == MBEDTLS_CT_TRUE, otherwise \5Cc if0.\0A */\0Astatic inline int mbedtls_ct_error_if(mbedtls_ct_condition_t condition, int if1, int if0);\0A\0A/** Choose between an error value and 0. The error value must be in the range [-32767..0].\0A *\0A * Functionally equivalent to:\0A *\0A * condition ? if1 : 0.\0A *\0A * Functionally equivalent to mbedtls_ct_error_if(condition, if1, 0) but\0A * results in smaller code size.\0A *\0A * \5Cparam condition     Condition to test.\0A * \5Cparam if1           Value to use if \5Cp condition == MBEDTLS_CT_TRUE.\0A *\0A * \5Creturn  \5Cc if1 if \5Cp condition == MBEDTLS_CT_TRUE, otherwise 0.\0A */\0Astatic inline int mbedtls_ct_error_if_else_0(mbedtls_ct_condition_t condition, int if1);\0A\0A/* ============================================================================\0A * Block memory operations\0A */\0A\0A#if defined(MBEDTLS_PKCS1_V15) && defined(MBEDTLS_RSA_C) && !defined(MBEDTLS_RSA_ALT)\0A\0A/** Conditionally set a block of memory to zero.\0A *\0A * Regardless of the condition, every byte will be read once and written to\0A * once.\0A *\0A * \5Cparam condition     Secret. Condition to test.\0A * \5Cparam buf           Secret. Pointer to the start of the buffer.\0A * \5Cparam len           Number of bytes to set to zero.\0A *\0A * \5Cwarning Unlike mbedtls_platform_zeroize, this does not have the same guarantees\0A * about not being optimised away if the memory is never read again.\0A */\0Avoid mbedtls_ct_zeroize_if(mbedtls_ct_condition_t condition, void *buf, size_t len);\0A\0A/** Shift some data towards the left inside a buffer.\0A *\0A * Functionally equivalent to:\0A *\0A * memmove(start, start + offset, total - offset);\0A * memset(start + (total - offset), 0, offset);\0A *\0A * Timing independence comes at the expense of performance.\0A *\0A * \5Cparam start     Secret. Pointer to the start of the buffer.\0A * \5Cparam total     Total size of the buffer.\0A * \5Cparam offset    Secret. Offset from which to copy \5Cp total - \5Cp offset bytes.\0A */\0Avoid mbedtls_ct_memmove_left(void *start,\0A                             size_t total,\0A                             size_t offset);\0A\0A#endif /* defined(MBEDTLS_PKCS1_V15) && defined(MBEDTLS_RSA_C) && !defined(MBEDTLS_RSA_ALT) */\0A\0A/** Conditional memcpy.\0A *\0A * Functionally equivalent to:\0A *\0A * if (condition) {\0A *      memcpy(dest, src1, len);\0A * } else {\0A *      if (src2 != NULL)\0A *          memcpy(dest, src2, len);\0A * }\0A *\0A * It will always read len bytes from src1.\0A * If src2 != NULL, it will always read len bytes from src2.\0A * If src2 == NULL, it will instead read len bytes from dest (as if src2 == dest).\0A *\0A * \5Cparam condition The condition\0A * \5Cparam dest      Secret. Destination pointer.\0A * \5Cparam src1      Secret. Pointer to copy from (if \5Cp condition == MBEDTLS_CT_TRUE).\0A *                  This may be equal to \5Cp dest, but may not overlap in other ways.\0A * \5Cparam src2      Secret (contents only - may branch to determine if this parameter is NULL).\0A *                  Pointer to copy from (if \5Cp condition == MBEDTLS_CT_FALSE and \5Cp src2 is not NULL). May be NULL.\0A *                  This may be equal to \5Cp dest, but may not overlap it in other ways. It may overlap with \5Cp src1.\0A * \5Cparam len       Number of bytes to copy.\0A */\0Avoid mbedtls_ct_memcpy_if(mbedtls_ct_condition_t condition,\0A                          unsigned char *dest,\0A                          const unsigned char *src1,\0A                          const unsigned char *src2,\0A                          size_t len\0A                          );\0A\0A/** Copy data from a secret position.\0A *\0A * Functionally equivalent to:\0A *\0A * memcpy(dst, src + offset, len)\0A *\0A * This function copies \5Cp len bytes from \5Cp src + \5Cp offset to\0A * \5Cp dst, with a code flow and memory access pattern that does not depend on\0A * \5Cp offset, but only on \5Cp offset_min, \5Cp offset_max and \5Cp len.\0A *\0A * \5Cnote                This function reads from \5Cp dest, but the value that\0A *                      is read does not influence the result and this\0A *                      function's behavior is well-defined regardless of the\0A *                      contents of the buffers. This may result in false\0A *                      positives from static or dynamic analyzers, especially\0A *                      if \5Cp dest is not initialized.\0A *\0A * \5Cparam dest          Secret. The destination buffer. This must point to a writable\0A *                      buffer of at least \5Cp len bytes.\0A * \5Cparam src           Secret. The base of the source buffer. This must point to a\0A *                      readable buffer of at least \5Cp offset_max + \5Cp len\0A *                      bytes. Shouldn't overlap with \5Cp dest\0A * \5Cparam offset        Secret. The offset in the source buffer from which to copy.\0A *                      This must be no less than \5Cp offset_min and no greater\0A *                      than \5Cp offset_max.\0A * \5Cparam offset_min    The minimal value of \5Cp offset.\0A * \5Cparam offset_max    The maximal value of \5Cp offset.\0A * \5Cparam len           The number of bytes to copy.\0A */\0Avoid mbedtls_ct_memcpy_offset(unsigned char *dest,\0A                              const unsigned char *src,\0A                              size_t offset,\0A                              size_t offset_min,\0A                              size_t offset_max,\0A                              size_t len);\0A\0A/* Documented in include/mbedtls/constant_time.h. a and b are secret.\0A\0A   int mbedtls_ct_memcmp(const void *a,\0A                         const void *b,\0A                         size_t n);\0A */\0A\0A#if defined(MBEDTLS_NIST_KW_C)\0A\0A/** Constant-time buffer comparison without branches.\0A *\0A * Similar to mbedtls_ct_memcmp, except that the result only depends on part of\0A * the input data - differences in the head or tail are ignored. Functionally equivalent to:\0A *\0A * memcmp(a + skip_head, b + skip_head, size - skip_head - skip_tail)\0A *\0A * Time taken depends on \5Cp n, but not on \5Cp skip_head or \5Cp skip_tail .\0A *\0A * Behaviour is undefined if ( \5Cp skip_head + \5Cp skip_tail) > \5Cp n.\0A *\0A * \5Cparam a         Secret. Pointer to the first buffer, containing at least \5Cp n bytes. May not be NULL.\0A * \5Cparam b         Secret. Pointer to the second buffer, containing at least \5Cp n bytes. May not be NULL.\0A * \5Cparam n         The number of bytes to examine (total size of the buffers).\0A * \5Cparam skip_head Secret. The number of bytes to treat as non-significant at the start of the buffer.\0A *                  These bytes will still be read.\0A * \5Cparam skip_tail Secret. The number of bytes to treat as non-significant at the end of the buffer.\0A *                  These bytes will still be read.\0A *\0A * \5Creturn          Zero if the contents of the two buffers are the same, otherwise non-zero.\0A */\0Aint mbedtls_ct_memcmp_partial(const void *a,\0A                              const void *b,\0A                              size_t n,\0A                              size_t skip_head,\0A                              size_t skip_tail);\0A\0A#endif\0A\0A/* Include the implementation of static inline functions above. */\0A#include \22constant_time_impl.h\22\0A\0A#endif /* MBEDTLS_CONSTANT_TIME_INTERNAL_H */\0A\00" }
