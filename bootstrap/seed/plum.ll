@.str63023 = private global { i64, i64, [15140 x i8] } { i64 -1, i64 15139, [15140 x i8] c"/// A decoder is a value that turns a `JsonValue` into a `T`, or says\0A/// why it cannot, carrying the PATH it is currently looking at so a\0A/// failure names the field rather than the document.\0Apub struct Decoder[T] { run: (JsonValue, String) -> Result[T, String] }\0A\0A// --- Paths ---\0A//\0A// The empty path is the document itself, and reads as \22the root\22\0A// rather than as an empty string in a message.\0A\0Alet at_str (p: String): String = if String.is_empty(p) { \22the root\22 } else { p }\0A\0Alet expected (what: String) (p: String): String =\0A    \22expected \22.concat(what).concat(\22 at \22).concat(at_str(p))\0A\0A// Only ASCII identifiers can be bare path segments. Everything else\0A// uses the JSON writer's string escaping, including empty keys and controls.\0Alet key_is_bare (bytes: Bytes) (i: Int): Bool =\0A    if i >= bytes.len() { i > 0 }\0A    else {\0A        let b = Option.unwrap_or(bytes.at(i), 0);\0A        if (b >= 65 && b <= 90) || (b >= 97 && b <= 122) || b == 95\0A            || (i > 0 && b >= 48 && b <= 57) {\0A                key_is_bare(bytes, i + 1)\0A            } else { false }\0A    }\0A\0Alet key_segment (key: String): String =\0A    if key_is_bare(String.as_bytes(key), 0) { key }\0A    else { match json_stringify(JsonString(key)) {\0A        Ok(quoted) => \22[\22.concat(quoted).concat(\22]\22),\0A        // A JsonString cannot contain the writer's only error: a non-finite number.\0A        Err(e) => { panic_raw(e); \22\22 },\0A    } }\0A\0Alet join_key (p: String) (segment: String): String =\0A    if String.is_empty(p) { segment }\0A    else if String.starts_with(segment, \22[\22) { p.concat(segment) }\0A    else { p.concat(\22.\22).concat(segment) }\0A\0Alet join_index (p: String) (i: Int): String =\0A    p.concat(\22[\22).concat(i.to_string()).concat(\22]\22)\0A\0A// --- Primitives ---\0A\0A/// The `JsonValue` itself, undecoded. Fo