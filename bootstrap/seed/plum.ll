ETECTED;\0A    unsigned char *tree = NULL;\0A\0A    if (!priv_ctx->have_private_key) {\0A        return MBEDTLS_ERR_LMS_BAD_INPUT_DATA;\0A    }\0A\0A    if (priv_ctx->params.type\0A        != MBEDTLS_LMS_SHA256_M32_H10) {\0A        return MBEDTLS_ERR_LMS_BAD_INPUT_DATA;\0A    }\0A\0A    if (priv_ctx->params.otstype\0A        != MBEDTLS_LMOTS_SHA256_N32_W8) {\0A        return MBEDTLS_ERR_LMS_BAD_INPUT_DATA;\0A    }\0A\0A    tree = mbedtls_calloc((size_t) MERKLE_TREE_NODE_AM(priv_ctx->params.type),\0A                          node_bytes);\0A    if (tree == NULL) {\0A        return MBEDTLS_ERR_LMS_ALLOC_FAILED;\0A    }\0A\0A    memcpy(&ctx->params, &priv_ctx->params,\0A           sizeof(mbedtls_lmots_parameters_t));\0A\0A    ret = calculate_merkle_tree(priv_ctx, tree);\0A    if (ret != 0) {\0A        goto exit;\0A    }\0A\0A    /* Root node is always at position 1, due to 1-based indexing */\0A    memcpy(ctx->T_1_pub_key, &tree[node_bytes], node_bytes);\0A\0A    ctx->have_public_key = 1;\0A\0A    ret = 0;\0A\0Aexit:\0A    mbedtls_zeroize_and_free(tree, node_bytes *\0A                             (size_t) MERKLE_TREE_NODE_AM(priv_ctx->params.type));\0A\0A    return ret;\0A}\0A\0A\0Aint mbedtls_lms_sign(mbedtls_lms_private_t *ctx,\0A                     int (*f_rng)(void *, unsigned char *, size_t),\0A                     void *p_rng, const unsigned char *msg,\0A                     unsigned int msg_size, unsigned char *sig, size_t sig_size,\0A                     size_t *sig_len)\0A{\0A    uint32_t q_leaf_identifier;\0A    int ret = MBEDTLS_ERR_ERROR_CORRUPTION_DETECTED;\0A\0A    if (!ctx->have_private_key) {\0A        return MBEDTLS_ERR_LMS_BAD_INPUT_DATA;\0A    }\0A\0A    if (sig_size < MBEDTLS_LMS_SIG_LEN(ctx->params.type, ctx->params.otstype)) {\0A        return MBEDTLS_ERR_LMS_BUFFER_TOO_SMALL;\0A    }\0A\0A    if (ctx->params.type != MBEDTLS_LMS_SHA256_M32_H10) {\0A        return MBEDTLS_ERR_LMS_BAD_INPUT_DATA;\0A    }\0A\0A    if (ctx->params.otstype\0A        !=