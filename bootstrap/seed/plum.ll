@.str44840 = private global { i64, i64, [12 x i8] } { i64 -1, i64 11, [12 x i8] c"argv_shim.c\00" }
@.str44842 = private global { i64, i64, [2795 x i8] } { i64 -1, i64 2794, [2795 x i8] c"// args() copies each borrowed native argument into a Plum cell. On Windows,\0A// parse the Unicode command line and keep the vector/conversion scratch scoped\0A// to that one args() call. POSIX argv remains borrowed, including non-UTF-8.\0A#include <stdio.h>\0A#include <stdlib.h>\0A#include <string.h>\0A#if defined(_WIN32)\0A#include \22path_shim.h\22\0A\0Atypedef struct { int count; wchar_t **wide; char *text; } PlumArgs;\0Astatic void plum_args_failure(void) {\0A    fputs(\22plum: cannot read Windows command-line arguments (invalid Unicode or allocation failure)\5Cn\22, stderr);\0A    exit(1);\0A}\0A#endif\0A\0Avoid *plum_args_native_open(void) {\0A#if defined(_WIN32)\0A    // Use the documented Windows parser without adding a static Shell32\0A    // dependency to every seed/harness link. The returned LocalAlloc block\0A    // is independent of the module and is released with LocalFree.\0A    HMODULE module = LoadLibraryExW(L\22shell32.dll\22, NULL, LOAD_LIBRARY_SEARCH_SYSTEM32);\0A    typedef wchar_t **(WINAPI *ParseArgs)(LPCWSTR, int *);\0A    ParseArgs parse = NULL;\0A    FARPROC symbol = module ? GetProcAddress(module, \22CommandLineToArgvW\22) : NULL;\0A    memcpy(&parse, &symbol, sizeof(parse));\0A    int count = 0;\0A    wchar_t **wide = parse ? parse(GetCommandLineW(), &count) : NULL;\0A    if (module) FreeLibrary(module);\0A    if (!wide) { plum_args_failure(); return NULL; }\0A    PlumArgs *args = malloc(sizeof(*args));\0A    if (!args) { LocalFree(wide); plum_args_failure(); return NULL; }\0A    args->count = count; args->wide = wide; args->text = NULL;\0A    return args;\0A#else\0A    return NULL;\0A#endif\0A}\0A\0Along long plum_args_native_count(void *context, long long fallback) {\0A#if defined(_WIN32)\0A    (void)fallback;\0A    return ((PlumArgs *)context)->count;\0A#else\0A    (void)context;\0A    return fallback;\0A#endif\0A}\0A\0Avoid plum_args_native_drop(void *context) {\0A#if defined(_WIN32)\0A    PlumArgs *args = context;\0A    free(args->text); args->text = NULL;\0A#else\0A    (void)context;\0A#endif\0A}\0Avoid plum_args_native_close(void *context) {\0A#if defined(_WIN32)\0A    PlumArgs *args = context;\0A    if (args) { plum_args_native_drop(args); LocalFree(args->wide); free(args); }\0A#else\0A    (void)context;\0A#endif\0A}\0A\0Aconst char *plum_args_native_data(void *context, long long index, char **fallback) {\0A#if defined(_WIN32)\0A    (void)fallback;\0A    PlumArgs *args = context;\0A    plum_args_native_drop(args);\0A    int n = index >= 0 && index < args->count ? WideCharToMultiByte(CP_UTF8, WC_ERR_INVALID_CHARS,\0A        args->wide[index], -1, NULL, 0, NULL, NULL) : 0;\0A    if (n > 0) {\0A        args->text = malloc((size_t)n);\0A        if (args->text && plum_path_utf8(args->wide[index], args->text, (size_t)n)) return args->text;\0A    }\0A    plum_args_native_close(args);\0A    plum_args_failure(); return NULL;\0A#else\0A    (void)context;\0A    return fallback[index];\0A#endif\0A}\0A\00" }
