   mbedtls_mpi_init(&s);\0A\0A    if (signature_size < 2 * curve_bytes) {\0A        ret = MBEDTLS_ERR_ECP_BUFFER_TOO_SMALL;\0A        goto cleanup;\0A    }\0A\0A    if (PSA_ALG_ECDSA_IS_DETERMINISTIC(alg)) {\0A#if defined(MBEDTLS_PSA_BUILTIN_ALG_DETERMINISTIC_ECDSA)\0A        psa_algorithm_t hash_alg = PSA_ALG_SIGN_GET_HASH(alg);\0A        mbedtls_md_type_t md_alg = mbedtls_md_type_from_psa_alg(hash_alg);\0A        MBEDTLS_MPI_CHK(mbedtls_ecdsa_sign_det_ext(\0A                            &ecp->grp, &r, &s,\0A                            &ecp->d, hash,\0A                            hash_length, md_alg,\0A                            mbedtls_psa_get_random,\0A                            MBEDTLS_PSA_RANDOM_STATE));\0A#else\0A        ret = MBEDTLS_ERR_ECP_FEATURE_UNAVAILABLE;\0A        goto cleanup;\0A#endif /* defined(MBEDTLS_PSA_BUILTIN_ALG_DETERMINISTIC_ECDSA) */\0A    } else {\0A        (void) alg;\0A        MBEDTLS_MPI_CHK(mbedtls_ecdsa_sign(&ecp->grp, &r, &s, &ecp->d,\0A                                           hash, hash_length,\0A                                           mbedtls_psa_get_random,\0A                                           MBEDTLS_PSA_RANDOM_STATE));\0A    }\0A\0A    MBEDTLS_MPI_CHK(mbedtls_mpi_write_binary(&r,\0A                                             signature,\0A                                             curve_bytes));\0A    MBEDTLS_MPI_CHK(mbedtls_mpi_write_binary(&s,\0A                                             signature + curve_bytes,\0A                                             curve_bytes));\0Acleanup:\0A    mbedtls_mpi_free(&r);\0A    mbedtls_mpi_free(&s);\0A    if (ret == 0) {\0A        *signature_length = 2 * curve_bytes;\0A    }\0A\0A    mbedtls_ecp_keypair_free(ecp);\0A    mbedtls_free(ecp);\0A\0A    return mbedtls_to_psa_error(ret);\0A}\0A\0Apsa_status_t mbedtls_psa_ecp_load_public_part(mbedtls_ecp_keypair *ecp)\0A{\0A    int ret = 0;\0A\0A    /* Check whether the public part is loaded. If not, load it. */\0A    if (mbedt