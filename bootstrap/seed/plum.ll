ze \5Cp length Bytes.\0A *\0A * \5Creturn         \5Cc 0 on success.\0A */\0AMBEDTLS_CHECK_RETURN_TYPICAL\0Aint mbedtls_aes_crypt_cfb8(mbedtls_aes_context *ctx,\0A                           int mode,\0A                           size_t length,\0A                           unsigned char iv[16],\0A                           const unsigned char *input,\0A                           unsigned char *output);\0A#endif /*MBEDTLS_CIPHER_MODE_CFB */\0A\0A#if defined(MBEDTLS_CIPHER_MODE_OFB)\0A/**\0A * \5Cbrief       This function performs an AES-OFB (Output Feedback Mode)\0A *              encryption or decryption operation.\0A *\0A *              For OFB, you must set up the context with\0A *              mbedtls_aes_setkey_enc(), regardless of whether you are\0A *              performing an encryption or decryption operation. This is\0A *              because OFB mode uses the same key schedule for encryption and\0A *              decryption.\0A *\0A *              The OFB operation is identical for encryption or decryption,\0A *              therefore no operation mode needs to be specified.\0A *\0A * \5Cnote        Upon exit, the content of iv, the Initialisation Vector, is\0A *              updated so that you can call the same function again on the next\0A *              block(s) of data and get the same result as if it was encrypted\0A *              in one call. This allows a \22streaming\22 usage, by initialising\0A *              iv_off to 0 before the first call, and preserving its value\0A *              between calls.\0A *\0A *              For non-streaming use, the iv should be initialised on each call\0A *              to a unique value, and iv_off set to 0 on each call.\0A *\0A *              If you need to retain the contents of the initialisation vector,\0A *              you must either save it manually or use the cipher module\0A *              instead.\0A *\0A * \5Cwarning     For the OFB mode, the initialisation vector must be unique\0A *              every encryption operation. Reuse of an initialisation vector\0A *              will compromise security.\0A *\0A * \5Cparam ctx      The AES context to use for encryption or decryption.\0A *                 It must be initialized and bound to a key.\0A * \5Cparam length   The length of the input data.\0A * \5Cparam iv_off   The offset in IV (updated after use).\0A *                 It must point to a valid \5Cc size_t.\0A * \5Cparam iv       The initialization vector (updated after use).\0A *                 It must be a readable and writeable buffer of \5Cc 16 Bytes.\0A * \5Cparam input    The buffer holding the input data.\0A *                 It must be readable and of size \5Cp length Bytes.\0A * \5Cparam output   The buffer holding the output data.\0A *                 It must be writeable and of size \5Cp length Bytes.\0A *\0A * \5Creturn         \5Cc 0 on success.\0A */\0AMBEDTLS_CHECK_RETURN_TYPICAL\0Aint mbedtls_aes_crypt_ofb(mbedtls_aes_context *ctx,\0A                          size_t length,\0A                          size_t *iv_off,\0A                          unsigned char iv[16],\0A                          const unsigned char *input,\0A                          unsigned char *output);\0A\0A#endif /* MBEDTLS_CIPHER_MODE_OFB */\0A\0A#if defined(MBEDTLS_CIPHER_MODE_CTR)\0A/**\0A * \5Cbrief      This function performs an AES-CTR encryption or decryption\0A *             operation.\0A *\0A *             Due to the nature of CTR, you must use the same key schedule\0A *             for both encryption and decryption operations. Therefore, you\0A *             must use the context initialized with mbedtls_aes_setkey_enc()\0A *             for both #MBEDTLS_AES_ENCRYPT and #MBEDTLS_AES_DECRYPT.\0A *\0A * \5Cwarning    You must never reuse a nonce value with the same key. Doing so\0A *             would void the encryption for the two messages encrypted with\0A *             the same nonce and key.\0A *\0A *             There are two common strategies for managing nonces with CTR:\0A *\0A *             1. You can handle everything as a single message processed over\0A *             successive calls to this function. In that case, you want to\0A *             set \5Cp nonce_counter and \5Cp nc_off to 0 for the first call, and\0A *             then preserve the values of \5Cp nonce_counter, \5Cp nc_off and \5Cp\0A *             stream_block across calls to this function as they will be\0A *             updated by this function.\0A *\0A *             With this strategy, you must not encrypt more than 2**128\0A *             blocks of data with the same key.\0A *\0A *             2. You can encrypt separate messages by dividing the \5Cp\0A *             nonce_counter buffer in two areas: the first one used for a\0A *             per-message nonce, handled by yourself, and the second one\0A *             updated by this function internally.\0A *\0A *             For example, you might reserve the first 12 bytes for the\0A *             per-message nonce, and the last 4 bytes for internal use. In that\0A *             case, before calling this function on a new message you need to\0A *             set the first 12 bytes of \5Cp nonce_counter to your chosen nonce\0A *             value, the last 4 to 0, and \5Cp nc_off to 0 (which will cause \5Cp\0A *             stream_block to be ignored). That way, you can encrypt at most\0A *             2**96 messages of up to 2**32 blocks each with the same key.\0A *\0A *             The per-message nonce (or information sufficient to reconstruct\0A *             it) needs to be communicated with the ciphertext and must be unique.\0A *             The recommended way to ensure uniqueness is to use a message\0A *             counter. An alternative is to generate random nonces, but this\0A *             limits the number of messages that can be securely encrypted:\0A *             for example, with 96-bit random nonces, you should not encrypt\0A *             more than 2**32 messages with the same key.\0A *\0A *             Note that for both strategies, sizes are measured in blocks and\0A *             that an AES block is 16 bytes.\0A *\0A * \5Cwarning    Upon return, \5Cp stream_block contains sensitive data. Its\0A *             content must not be written to insecure storage and should be\0A *             securely discarded as soon as it's no longer needed.\0A *\0A * \5Cparam ctx              The AES context to use for encryption or decryption.\0A *                         It must be initialized and bound to a key.\0A * \5Cparam length           The length of the input data.\0A * \5Cparam nc_off           The offset in the current \5Cp stream_block, for\0A *                         resuming within the current cipher stream. The\0A *                         offset pointer should be 0 at the start of a stream.\0A *                         It must point to a valid \5Cc size_t.\0A * \5Cparam nonce_counter    The 128-bit nonce and counter.\0A *                         It must be a readable-writeable buffer of \5Cc 16 Bytes.\0A * \5Cparam stream_block     The saved stream block for resuming. This is\0A *                         overwritten by the function.\0A *                         It must be a readable-writeable buffer of \5Cc 16 Bytes.\0A * \5Cparam input            The buffer holding the input data.\0A *                         It must be readable and of size \5Cp length Bytes.\0A * \5Cparam output           The buffer holding the output data.\0A *                         It must be writeable and of size \5Cp length Bytes.\0A *\0A * \5Creturn                 \5Cc 0 on success.\0A */\0AMBEDTLS_CHECK_RETURN_TYPICAL\0Aint mbedtls_aes_crypt_ctr(mbedtls_aes_context *ctx,\0A                          size_t length,\0A                          size_t *nc_off,\0A                          unsigned char nonce_counter[16],\0A                          unsigned char stream_block[16],\0A                          const unsigned char *input,\0A                          unsigned char *output);\0A#endif /* MBEDTLS_CIPHER_MODE_CTR */\0A\0A/**\0A * \5Cbrief           Internal AES block encryption function. This is only\0A *                  exposed to allow overriding it using\0A *                  \5Cc MBEDTLS_AES_ENCRYPT_ALT.\0A *\0A * \5Cparam ctx       The AES context to use for encryption.\0A * \5Cparam input     The plaintext block.\0A * \5Cparam output    The output (ciphertext) block.\0A *\0A * \5Creturn          \5Cc 0 on success.\0A */\0AMBEDTLS_CHECK_RETURN_TYPICAL\0Aint mbedtls_internal_aes_encrypt(mbedtls_aes_context *ctx,\0A                                 const unsigned char input[16],\0A                                 unsigned char output[16]);\0A\0A#if !defined(MBEDTLS_BLOCK_CIPHER_NO_DECRYPT)\0A/**\0A * \5Cbrief           Internal AES block decryption function. This is only\0A *                  exposed to allow overriding it using see\0A *                  \5Cc MBEDTLS_AES_DECRYPT_ALT.\0A *\0A * \5Cparam ctx       The AES context to use for decryption.\0A * \5Cparam input     The ciphertext block.\0A * \5Cparam output    The output (plaintext) block.\0A *\0A * \5Creturn          \5Cc 0 on success.\0A */\0AMBEDTLS_CHECK_RETURN_TYPICAL\0Aint mbedtls_internal_aes_decrypt(mbedtls_aes_context *ctx,\0A                                 const unsigned char input[16],\0A                                 unsigned char output[16]);\0A#endif /* !MBEDTLS_BLOCK_CIPHER_NO_DECRYPT */\0A\0A#if defined(MBEDTLS_SELF_TEST)\0A/**\0A * \5Cbrief          Checkup routine.\0A *\0A * \5Creturn         \5Cc 0 on success.\0A * \5Creturn         \5Cc 1 on failure.\0A */\0AMBEDTLS_CHECK_RETURN_CRITICAL\0Aint mbedtls_aes_self_test(int verbose);\0A\0A#endif /* MBEDTLS_SELF_TEST */\0A\0A#ifdef __cplusplus\0A}\0A#endif\0A\0A#endif /* aes.h */\0A\00" }
