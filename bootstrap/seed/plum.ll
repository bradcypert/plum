tial_state[7];\0A    working_state[8] += initial_state[8];\0A    working_state[9] += initial_state[9];\0A    working_state[10] += initial_state[10];\0A    working_state[11] += initial_state[11];\0A    working_state[12] += initial_state[12];\0A    working_state[13] += initial_state[13];\0A    working_state[14] += initial_state[14];\0A    working_state[15] += initial_state[15];\0A\0A    for (i = 0U; i < 16; i++) {\0A        size_t offset = i * 4U;\0A\0A        MBEDTLS_PUT_UINT32_LE(working_state[i], keystream, offset);\0A    }\0A\0A    mbedtls_platform_zeroize(working_state, sizeof(working_state));\0A}\0A\0Avoid mbedtls_chacha20_init(mbedtls_chacha20_context *ctx)\0A{\0A    mbedtls_platform_zeroize(ctx->state, sizeof(ctx->state));\0A    mbedtls_platform_zeroize(ctx->keystream8, sizeof(ctx->keystream8));\0A\0A    /* Initially, there's no keystream bytes available */\0A    ctx->keystream_bytes_used = CHACHA20_BLOCK_SIZE_BYTES;\0A}\0A\0Avoid mbedtls_chacha20_free(mbedtls_chacha20_context *ctx)\0A{\0A    if (ctx != NULL) {\0A        mbedtls_platform_zeroize(ctx, sizeof(mbedtls_chacha20_context));\0A    }\0A}\0A\0Aint mbedtls_chacha20_setkey(mbedtls_chacha20_context *ctx,\0A                            const unsigned char key[32])\0A{\0A    /* ChaCha20 constants - the string \22expand 32-byte k\22 */\0A    ctx->state[0] = 0x61707865;\0A    ctx->state[1] = 0x3320646e;\0A    ctx->state[2] = 0x79622d32;\0A    ctx->state[3] = 0x6b206574;\0A\0A    /* Set key */\0A    ctx->state[4]  = MBEDTLS_GET_UINT32_LE(key, 0);\0A    ctx->state[5]  = MBEDTLS_GET_UINT32_LE(key, 4);\0A    ctx->state[6]  = MBEDTLS_GET_UINT32_LE(key, 8);\0A    ctx->state[7]  = MBEDTLS_GET_UINT32_LE(key, 12);\0A    ctx->state[8]  = MBEDTLS_GET_UINT32_LE(key, 16);\0A    ctx->state[9]  = MBEDTLS_GET_UINT32_LE(key, 20);\0A    ctx->state[10] = MBEDTLS_GET_UINT32_LE(key, 24);\0A    ctx->state[11] = MBEDTLS_GET_UINT32_LE(key, 28);\0A\0A    return 0;\0A}\0A\0Aint mbedtls_chacha20_starts(mbedtls_chacha20_context *ctx,\0A 