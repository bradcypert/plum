 [MGV]\0A */\0Astatic const uint16_t last4[16] =\0A{\0A    0x0000, 0x1c20, 0x3840, 0x2460,\0A    0x7080, 0x6ca0, 0x48c0, 0x54e0,\0A    0xe100, 0xfd20, 0xd940, 0xc560,\0A    0x9180, 0x8da0, 0xa9c0, 0xb5e0\0A};\0A\0Astatic void gcm_mult_smalltable(uint8_t *output, const uint8_t *x, uint64_t H[16][2])\0A{\0A    int i = 0;\0A    unsigned char lo, hi, rem;\0A    uint64_t u64z[2];\0A    const uint64_t *pu64z = NULL;\0A    uint8_t *u8z = (uint8_t *) u64z;\0A\0A    lo = x[15] & 0xf;\0A    hi = (x[15] >> 4) & 0xf;\0A\0A    pu64z = H[lo];\0A\0A    rem = (unsigned char) pu64z[1] & 0xf;\0A    u64z[1] = (pu64z[0] << 60) | (pu64z[1] >> 4);\0A    u64z[0] = (pu64z[0] >> 4);\0A    u64z[0] ^= (uint64_t) last4[rem] << 48;\0A    mbedtls_xor_no_simd(u8z, u8z, (uint8_t *) H[hi], 16);\0A\0A    for (i = 14; i >= 0; i--) {\0A        lo = x[i] & 0xf;\0A        hi = (x[i] >> 4) & 0xf;\0A\0A        rem = (unsigned char) u64z[1] & 0xf;\0A        u64z[1] = (u64z[0] << 60) | (u64z[1] >> 4);\0A        u64z[0] = (u64z[0] >> 4);\0A        u64z[0] ^= (uint64_t) last4[rem] << 48;\0A        mbedtls_xor_no_simd(u8z, u8z, (uint8_t *) H[lo], 16);\0A\0A        rem = (unsigned char) u64z[1] & 0xf;\0A        u64z[1] = (u64z[0] << 60) | (u64z[1] >> 4);\0A        u64z[0] = (u64z[0] >> 4);\0A        u64z[0] ^= (uint64_t) last4[rem] << 48;\0A        mbedtls_xor_no_simd(u8z, u8z, (uint8_t *) H[hi], 16);\0A    }\0A\0A    MBEDTLS_PUT_UINT64_BE(u64z[0], output, 0);\0A    MBEDTLS_PUT_UINT64_BE(u64z[1], output, 8);\0A}\0A#endif\0A\0A/*\0A * Sets output to x times H using the precomputed tables.\0A * x and output are seen as elements of GF(2^128) as in [MGV].\0A */\0Astatic void gcm_mult(mbedtls_gcm_context *ctx, const unsigned char x[16],\0A                     unsigned char output[16])\0A{\0A    switch (ctx->acceleration) {\0A#if defined(MBEDTLS_AESNI_HAVE_CODE)\0A        case MBEDTLS_GCM_ACC_AESNI:\0A            mbedtls_aesni_gcm_mult(output, x, (uint8_t *) ctx->H[MBEDTLS_GCM_HTABLE_SIZE/2]);\0A            break;\0A#endif\0A\0A#if defined(MBEDTLS_AESCE_HAVE_CODE)\0A        case MBEDTLS_GCM_ACC_AESCE:\0A            mbedtls_aesce_gcm_mult(output, x, (uint8_t *) ctx->H[MBEDTLS_GCM_HTABLE_SIZE/2]);\0A            break;\0A#endif\0A\0A#if defined(MBEDTLS_GCM_LARGE_TABLE)\0A        case MBEDTLS_GCM_ACC_LARGETABLE:\0A            gcm_mult_largetable(output, x, ctx->H);\0A            break;\0A#else\0A        case MBEDTLS_GCM_ACC_SMALLTABLE:\0A            gcm_mult_smalltable(output, x, ctx->H);\0A            break;\0A#endif\0A    }\0A\0A    return;\0A}\0A\0Aint mbedtls_gcm_starts(mbedtls_gcm_context *ctx,\0A                       int mode,\0A                       const unsigned char *iv, size_t iv_len)\0A{\0A    int ret = MBEDTLS_ERR_ERROR_CORRUPTION_DETECTED;\0A    unsigned char work_buf[16];\0A    const unsigned char *p;\0A    size_t use_len;\0A    uint64_t iv_bits;\0A#if !defined(MBEDTLS_BLOCK_CIPHER_C)\0A    size_t olen = 0;\0A#endif\0A\0A    /* IV is limited to 2^64 bits, so 2^61 bytes */\0A    /* IV is not allowed to be zero length */\0A    if (iv_len == 0 || (uint64_t) iv_len >> 61 != 0) {\0A        return MBEDTLS_ERR_GCM_BAD_INPUT;\0A    }\0A\0A    memset(ctx->y, 0x00, sizeof(ctx->y));\0A    memset(ctx->buf, 0x00, sizeof(ctx->buf));\0A\0A    ctx->mode = mode;\0A    ctx->len = 0;\0A    ctx->add_len = 0;\0A\0A    if (iv_len == 12) {\0A        memcpy(ctx->y, iv, iv_len);\0A        ctx->y[15] = 1;\0A    } else {\0A        memset(work_buf, 0x00, 16);\0A        iv_bits = (uint64_t) iv_len * 8;\0A        MBEDTLS_PUT_UINT64_BE(iv_bits, work_buf, 8);\0A\0A        p = iv;\0A        while (iv_len > 0) {\0A            use_len = (iv_len < 16) ? iv_len : 16;\0A\0A#if defined(MBEDTLS_COMPILER_IS_GCC) && (MBEDTLS_GCC_VERSION >= 70110)\0A#pragma GCC diagnostic push\0A#pragma GCC diagnostic warning \22-Wstringop-overflow=0\22\0A#endif\0A\0A            mbedtls_xor(ctx->y, ctx->y, p, use_len);\0A\0A#if defined(MBEDTLS_COMPILER_IS_GCC) && (MBEDTLS_GCC_VERSION >= 70110)\0A#pragma GCC diagnostic pop\0