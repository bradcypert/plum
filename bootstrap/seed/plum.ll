f(out+i*8,9,\22%08x\22,(unsigned)s->h[i]);\0A    out[64]='\5C0';\0A}\0A\0Aconst char *plum_cache_hash_text(const char *p, long long n) {\0A    static char out[65];\0A    if (n < 0) { out[0]='\5C0'; return out; }\0A    plum_cache_sha s; plum_cache_init(&s);\0A    plum_cache_update(&s,(const unsigned char *)p,(size_t)n);\0A    plum_cache_final(&s,out); return out;\0A}\0A\0A// Linux's optional kernel SHA provider uses CPU acceleration when available.\0A// No new library/tool dependency; an unavailable provider falls back to the\0A// portable implementation. Cache correctness is independent of the provider.\0Astatic int plum_cache_kernel_hash(const char *path, char out[65]) {\0A#if defined(PLUM_CACHE_AF_ALG)\0A    struct sockaddr_alg sa;\0A    memset(&sa,0,sizeof(sa)); sa.salg_family=AF_ALG;\0A    memcpy(sa.salg_type,\22hash\22,5); memcpy(sa.salg_name,\22sha256\22,7);\0A    int parent=socket(AF_ALG,SOCK_SEQPACKET,0);\0A    if (parent < 0) return 0;\0A    if (bind(parent,(struct sockaddr *)&sa,sizeof(sa)) != 0) { close(parent); return 0; }\0A    int fd=accept(parent,NULL,NULL); close(parent);\0A    if (fd < 0) return 0;\0A    FILE *f=fopen(path,\22rb\22);\0A    if (!f) { close(fd); return 0; }\0A    unsigned char buf[65536], digest[32]; size_t n; int bad=0;\0A    while ((n=fread(buf,1,sizeof(buf),f)) != 0) {\0A        size_t at=0;\0A        while (at < n) {\0A            ssize_t sent=send(fd,buf+at,n-at,MSG_MORE);\0A            if (sent <= 0) { bad=1; break; }\0A            at+=(size_t)sent;\0A        }\0A        if (bad) break;\0A    }\0A    if (ferror(f)) bad=1;\0A    if (fclose(f) != 0) bad=1;\0A    if (!bad && send(fd,NULL,0,0) != 0) bad=1;\0A    if (!bad && recv(fd,digest,sizeof(digest),0) != (ssize_t)sizeof(digest)) bad=1;\0A    close(fd);\0A    if (bad) return 0;\0A    for (unsigned i=0;i<32;i++) snprintf(out+i*2,3,\22%02x\22,(unsigned)digest[i]);\0A    out[64]='\5C0'; return 1;\0A#else\0A    (void)path; (void)out; return 0;\0A#endif\0A}\0A\0Aconst char *plum_cach