et != 0) {\0A        MBEDTLS_SSL_DEBUG_RET(2,\0A                              \22Creating the ticket-resumed PSK failed\22,\0A                              ret);\0A        return ret;\0A    }\0A\0A    session->resumption_key_len = hash_length;\0A\0A    MBEDTLS_SSL_DEBUG_BUF(3, \22Ticket-resumed PSK\22,\0A                          session->resumption_key,\0A                          session->resumption_key_len);\0A\0A    /* Set ticket_flags depends on the selected key exchange modes */\0A    mbedtls_ssl_tls13_session_set_ticket_flags(\0A        session, ssl->conf->tls13_kex_modes);\0A    MBEDTLS_SSL_PRINT_TICKET_FLAGS(4, session->ticket_flags);\0A\0A    return POSTPROCESS_NEW_SESSION_TICKET_SIGNAL;\0A}\0A\0A/*\0A * Handler for MBEDTLS_SSL_TLS1_3_NEW_SESSION_TICKET\0A */\0AMBEDTLS_CHECK_RETURN_CRITICAL\0Astatic int ssl_tls13_process_new_session_ticket(mbedtls_ssl_context *ssl)\0A{\0A    int ret = MBEDTLS_ERR_ERROR_CORRUPTION_DETECTED;\0A    unsigned char *buf;\0A    size_t buf_len;\0A    unsigned char *ticket_nonce;\0A    size_t ticket_nonce_len;\0A\0A    MBEDTLS_SSL_DEBUG_MSG(2, (\22=> parse new session ticket\22));\0A\0A    MBEDTLS_SSL_PROC_CHK(mbedtls_ssl_tls13_fetch_handshake_msg(\0A                             ssl, MBEDTLS_SSL_HS_NEW_SESSION_TICKET,\0A                             &buf, &buf_len));\0A\0A    /*\0A     * We are about to update (maybe only partially) ticket data thus block\0A     * any session export for the time being.\0A     */\0A    ssl->session->exported = 1;\0A\0A    MBEDTLS_SSL_PROC_CHK(ssl_tls13_parse_new_session_ticket(\0A                             ssl, buf, buf + buf_len,\0A                             &ticket_nonce, &ticket_nonce_len));\0A\0A    MBEDTLS_SSL_PROC_CHK_NEG(ssl_tls13_postprocess_new_session_ticket(\0A                                 ssl, ticket_nonce, ticket_nonce_len));\0A\0A    switch (ret) {\0A        case POSTPROCESS_NEW_SESSION_TICKET_SIGNAL:\0A            /*\0A             * All good, we have received a new valid ticket