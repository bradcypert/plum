DE_CFB */\0A\0A#if defined(MBEDTLS_CIPHER_MODE_OFB)\0A    /*\0A     * OFB mode\0A     */\0A    {\0A        static const int num_tests =\0A            sizeof(aes_test_ofb_key) / sizeof(*aes_test_ofb_key);\0A\0A        for (i = 0; i < num_tests << 1; i++) {\0A            u = i >> 1;\0A            keybits = 128 + u * 64;\0A            mode = i & 1;\0A\0A            if (verbose != 0) {\0A                mbedtls_printf(\22  AES-OFB-%3u (%s): \22, keybits,\0A                               (mode == MBEDTLS_AES_DECRYPT) ? \22dec\22 : \22enc\22);\0A            }\0A\0A            memcpy(iv,  aes_test_ofb_iv, 16);\0A            memcpy(key, aes_test_ofb_key[u], keybits / 8);\0A\0A            offset = 0;\0A            ret = mbedtls_aes_setkey_enc(&ctx, key, keybits);\0A            /*\0A             * AES-192 is an optional feature that may be unavailable when\0A             * there is an alternative underlying implementation i.e. when\0A             * MBEDTLS_AES_ALT is defined.\0A             */\0A            if (ret == MBEDTLS_ERR_PLATFORM_FEATURE_UNSUPPORTED && keybits == 192) {\0A                mbedtls_printf(\22skipped\5Cn\22);\0A                continue;\0A            } else if (ret != 0) {\0A                goto exit;\0A            }\0A\0A            if (mode == MBEDTLS_AES_DECRYPT) {\0A                memcpy(buf, aes_test_ofb_ct[u], 64);\0A                aes_tests = aes_test_ofb_pt;\0A            } else {\0A                memcpy(buf, aes_test_ofb_pt, 64);\0A                aes_tests = aes_test_ofb_ct[u];\0A            }\0A\0A            ret = mbedtls_aes_crypt_ofb(&ctx, 64, &offset, iv, buf, buf);\0A            if (ret != 0) {\0A                goto exit;\0A            }\0A\0A            if (memcmp(buf, aes_tests, 64) != 0) {\0A                ret = 1;\0A                goto exit;\0A            }\0A\0A            if (verbose != 0) {\0A                mbedtls_printf(\22passed\5Cn\22);\0A            }\0A        }\0A\0A        if (verbose != 0) {\0A            mbedtls_printf(\22\5Cn\22);\0A        }\0A    }\0A#endif /* MBEDTLS_CIPHER_MODE_OFB */\0A\0A#if defined(MBEDTLS_CIPHER_MODE_CTR)\0A    /*\0A     * CTR mode\0A     */\0A    {\0A        static const int num_tests =\0A            sizeof(aes_test_ctr_key) / sizeof(*aes_test_ctr_key);\0A\0A        for (i = 0; i < num_tests << 1; i++) {\0A            u = i >> 1;\0A            mode = i & 1;\0A\0A            if (verbose != 0) {\0A                mbedtls_printf(\22  AES-CTR-128 (%s): \22,\0A                               (mode == MBEDTLS_AES_DECRYPT) ? \22dec\22 : \22enc\22);\0A            }\0A\0A            memcpy(nonce_counter, aes_test_ctr_nonce_counter[u], 16);\0A            memcpy(key, aes_test_ctr_key[u], 16);\0A\0A            offset = 0;\0A            if ((ret = mbedtls_aes_setkey_enc(&ctx, key, 128)) != 0) {\0A                goto exit;\0A            }\0A\0A            len = aes_test_ctr_len[u];\0A\0A            if (mode == MBEDTLS_AES_DECRYPT) {\0A                memcpy(buf, aes_test_ctr_ct[u], len);\0A                aes_tests = aes_test_ctr_pt[u];\0A            } else {\0A                memcpy(buf, aes_test_ctr_pt[u], len);\0A                aes_tests = aes_test_ctr_ct[u];\0A            }\0A\0A            ret = mbedtls_aes_crypt_ctr(&ctx, len, &offset, nonce_counter,\0A                                        stream_block, buf, buf);\0A            if (ret != 0) {\0A                goto exit;\0A            }\0A\0A            if (memcmp(buf, aes_tests, len) != 0) {\0A                ret = 1;\0A                goto exit;\0A            }\0A\0A            if (verbose != 0) {\0A                mbedtls_printf(\22passed\5Cn\22);\0A            }\0A        }\0A    }\0A\0A    if (verbose != 0) {\0A        mbedtls_printf(\22\5Cn\22);\0A    }\0A#endif /* MBEDTLS_CIPHER_MODE_CTR */\0A\0A#if defined(MBEDTLS_CIPHER_MODE_XTS)\0A    /*\0A     * XTS mode\0A     */\0A    {\0A        static const int num_tests =\0A            sizeof(aes_test_xts_key) / sizeof(*aes_test_xts_key);\0A        mbedtls_aes_xts_context ctx_xts;\0A\0A        mbedtls_aes_xts_init(&ctx_xts);\0A\0A        for (i = 0; i < num_tests << 1; i++) {\0A            const unsigned char *data_unit;\0A            u = i >> 1;\0A            mode = i & 1;\0A\0A            if (verbose != 0) {\0A                mbedtls_printf(\22  AES-XTS-128 (%s): \22,\0A                               (mode == MBEDTLS_AES_DECRYPT) ? \22dec\22 : \22enc\22);\0A            }\0A\0A            memset(key, 0, sizeof(key));\0A            memcpy(key, aes_test_xts_key[u], 32);\0A            data_unit = aes_test_xts_data_unit[u];\0A\0A            len = sizeof(*aes_test_xts_ct32);\0A\0A            if (mode == MBEDTLS_AES_DECRYPT) {\0A                ret = mbedtls_aes_xts_setkey_dec(&ctx_xts, key, 256);\0A                if (ret != 0) {\0A                    goto exit;\0A                }\0A                memcpy(buf, aes_test_xts_ct32[u], len);\0A                aes_tests = aes_test_xts_pt32[u];\0A            } else {\0A                ret = mbedtls_aes_xts_setkey_enc(&ctx_xts, key, 256);\0A                if (ret != 0) {\0A                    goto exit;\0A                }\0A                memcpy(buf, aes_test_xts_pt32[u], len);\0A                aes_tests = aes_test_xts_ct32[u];\0A            }\0A\0A\0A            ret = mbedtls_aes_crypt_xts(&ctx_xts, mode, len, data_unit,\0A                                        buf, buf);\0A            if (ret != 0) {\0A                goto exit;\0A            }\0A\0A            if (memcmp(buf, aes_tests, len) != 0) {\0A                ret = 1;\0A                goto exit;\0A            }\0A\0A            if (verbose != 0) {\0A                mbedtls_printf(\22passed\5Cn\22);\0A            }\0A        }\0A\0A        if (verbose != 0) {\0A            mbedtls_printf(\22\5Cn\22);\0A        }\0A\0A        mbedtls_aes_xts_free(&ctx_xts);\0A    }\0A#endif /* MBEDTLS_CIPHER_MODE_XTS */\0A\0A    ret = 0;\0A\0Aexit:\0A    if (ret != 0 && verbose != 0) {\0A        mbedtls_printf(\22failed\5Cn\22);\0A    }\0A\0A    mbedtls_aes_free(&ctx);\0A\0A    return ret;\0A}\0A\0A#endif /* MBEDTLS_SELF_TEST */\0A\0A#endif /* MBEDTLS_AES_C */\0A\00" }
