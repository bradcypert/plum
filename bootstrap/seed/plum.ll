@.str45687 = private global { i64, i64, [48197 x i8] } { i64 -1, i64 48196, [48197 x i8] c"/**\0A * \5Cfile check_config.h\0A *\0A * \5Cbrief Consistency checks for configuration options\0A *\0A * This is an internal header. Do not include it directly.\0A *\0A * This header is included automatically by all public Mbed TLS headers\0A * (via mbedtls/build_info.h). Do not include it directly in a configuration\0A * file such as mbedtls/mbedtls_config.h or #MBEDTLS_USER_CONFIG_FILE!\0A * It would run at the wrong time due to missing derived symbols.\0A */\0A/*\0A *  Copyright The Mbed TLS Contributors\0A *  SPDX-License-Identifier: Apache-2.0 OR GPL-2.0-or-later\0A */\0A\0A#ifndef MBEDTLS_CHECK_CONFIG_H\0A#define MBEDTLS_CHECK_CONFIG_H\0A\0A/* *INDENT-OFF* */\0A\0A#if !defined(MBEDTLS_CONFIG_IS_FINALIZED)\0A#warning \22Do not include mbedtls/check_config.h manually! \22 \5C\0A         \22This may cause spurious errors. \22 \5C\0A         \22It is included automatically at the right point since Mbed TLS 3.0.\22\0A#endif /* !MBEDTLS_CONFIG_IS_FINALIZED */\0A\0A/*\0A * We assume CHAR_BIT is 8 in many places. In practice, this is true on our\0A * target platforms, so not an issue, but let's just be extra sure.\0A */\0A#include <limits.h>\0A#if CHAR_BIT != 8\0A#error \22Mbed TLS requires a platform with 8-bit chars\22\0A#endif\0A\0A#include <stdint.h>\0A\0A#if defined(__MINGW32__) || (defined(_MSC_VER) && _MSC_VER <= 1900)\0A#if !defined(MBEDTLS_PLATFORM_C)\0A#error \22MBEDTLS_PLATFORM_C is required on Windows\22\0A#endif\0A/* See auto-enabling SNPRINTF_ALT and VSNPRINTF_ALT\0A * in * config_adjust_legacy_crypto.h */\0A#endif /* _MINGW32__ || (_MSC_VER && (_MSC_VER <= 1900)) */\0A\0A#if defined(TARGET_LIKE_MBED) && defined(MBEDTLS_NET_C)\0A#error \22The NET module is not available for mbed OS - please use the network functions provided by Mbed OS\22\0A#endif\0A\0A#if defined(MBEDTLS_DEPRECATED_WARNING) && \5C\0A    !defined(__GNUC__) && !defined(__clang__)\0A#error \22MBEDTL