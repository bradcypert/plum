     int *salt_len)\0A{\0A    int ret = MBEDTLS_ERR_ERROR_CORRUPTION_DETECTED;\0A    unsigned char *p;\0A    const unsigned char *end, *end2;\0A    size_t len;\0A    mbedtls_x509_buf alg_id, alg_params;\0A\0A    /* First set everything to defaults */\0A    *md_alg = MBEDTLS_MD_SHA1;\0A    *mgf_md = MBEDTLS_MD_SHA1;\0A    *salt_len = 20;\0A\0A    /* Make sure params is a SEQUENCE and setup bounds */\0A    if (params->tag != (MBEDTLS_ASN1_CONSTRUCTED | MBEDTLS_ASN1_SEQUENCE)) {\0A        return MBEDTLS_ERROR_ADD(MBEDTLS_ERR_X509_INVALID_ALG,\0A                                 MBEDTLS_ERR_ASN1_UNEXPECTED_TAG);\0A    }\0A\0A    p = (unsigned char *) params->p;\0A    end = p + params->len;\0A\0A    if (p == end) {\0A        return 0;\0A    }\0A\0A    /*\0A     * HashAlgorithm\0A     */\0A    if ((ret = mbedtls_asn1_get_tag(&p, end, &len,\0A                                    MBEDTLS_ASN1_CONTEXT_SPECIFIC | MBEDTLS_ASN1_CONSTRUCTED |\0A                                    0)) == 0) {\0A        end2 = p + len;\0A\0A        /* HashAlgorithm ::= AlgorithmIdentifier (without parameters) */\0A        if ((ret = mbedtls_x509_get_alg_null(&p, end2, &alg_id)) != 0) {\0A            return ret;\0A        }\0A\0A        if ((ret = mbedtls_oid_get_md_alg(&alg_id, md_alg)) != 0) {\0A            return MBEDTLS_ERROR_ADD(MBEDTLS_ERR_X509_INVALID_ALG, ret);\0A        }\0A\0A        if (p != end2) {\0A            return MBEDTLS_ERROR_ADD(MBEDTLS_ERR_X509_INVALID_ALG,\0A                                     MBEDTLS_ERR_ASN1_LENGTH_MISMATCH);\0A        }\0A    } else if (ret != MBEDTLS_ERR_ASN1_UNEXPECTED_TAG) {\0A        return MBEDTLS_ERROR_ADD(MBEDTLS_ERR_X509_INVALID_ALG, ret);\0A    }\0A\0A    if (p == end) {\0A        return 0;\0A    }\0A\0A    /*\0A     * MaskGenAlgorithm\0A     */\0A    if ((ret = mbedtls_asn1_get_tag(&p, end, &len,\0A                                    MBEDTLS_ASN1_CONTEXT_SPECIFIC | MBEDTLS_ASN1_CONSTRUCTED |\0A                                    1)) == 0) {\0A     