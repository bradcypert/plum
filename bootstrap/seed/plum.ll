_WANT_ALG_JPAKE)\0Astatic psa_status_t psa_jpake_prologue(\0A    psa_pake_operation_t *operation,\0A    psa_pake_step_t step,\0A    psa_jpake_io_mode_t io_mode)\0A{\0A    if (step != PSA_PAKE_STEP_KEY_SHARE &&\0A        step != PSA_PAKE_STEP_ZK_PUBLIC &&\0A        step != PSA_PAKE_STEP_ZK_PROOF) {\0A        return PSA_ERROR_INVALID_ARGUMENT;\0A    }\0A\0A    psa_jpake_computation_stage_t *computation_stage =\0A        &operation->computation_stage.jpake;\0A\0A    if (computation_stage->round != PSA_JPAKE_FIRST &&\0A        computation_stage->round != PSA_JPAKE_SECOND) {\0A        return PSA_ERROR_BAD_STATE;\0A    }\0A\0A    /* Check that the step we are given is the one we were expecting */\0A    if (step != computation_stage->step) {\0A        return PSA_ERROR_BAD_STATE;\0A    }\0A\0A    if (step == PSA_PAKE_STEP_KEY_SHARE &&\0A        computation_stage->inputs == 0 &&\0A        computation_stage->outputs == 0) {\0A        /* Start of the round, so function decides whether we are inputting\0A         * or outputting */\0A        computation_stage->io_mode = io_mode;\0A    } else if (computation_stage->io_mode != io_mode) {\0A        /* Middle of the round so the mode we are in must match the function\0A         * called by the user */\0A        return PSA_ERROR_BAD_STATE;\0A    }\0A\0A    return PSA_SUCCESS;\0A}\0A\0Astatic psa_status_t psa_jpake_epilogue(\0A    psa_pake_operation_t *operation,\0A    psa_jpake_io_mode_t io_mode)\0A{\0A    psa_jpake_computation_stage_t *stage =\0A        &operation->computation_stage.jpake;\0A\0A    if (stage->step == PSA_PAKE_STEP_ZK_PROOF) {\0A        /* End of an input/output */\0A        if (io_mode == PSA_JPAKE_INPUT) {\0A            stage->inputs++;\0A            if (stage->inputs == PSA_JPAKE_EXPECTED_INPUTS(stage->round)) {\0A                stage->io_mode = PSA_JPAKE_OUTPUT;\0A            }\0A        }\0A        if (io_mode == PSA_JPAKE_OUTPUT) {\0A            stage->outputs++;\0A            if (stage->outputs == PSA_JPAKE_