ss.\0A * \5Cretval          #MBEDTLS_ERR_CIPHER_INVALID_CONTEXT if the context was not\0A *                  properly set up before calling this function.\0A * \5Cretval          One of #MBEDTLS_ERR_AES_INVALID_KEY_LENGTH,\0A *                  #MBEDTLS_ERR_ARIA_BAD_INPUT_DATA,\0A *                  #MBEDTLS_ERR_CAMELLIA_BAD_INPUT_DATA if \5Cp key_bitlen is\0A *                  invalid.\0A */\0Aint mbedtls_block_cipher_setkey(mbedtls_block_cipher_context_t *ctx,\0A                                const unsigned char *key,\0A                                unsigned key_bitlen);\0A\0A/**\0A * \5Cbrief           Encrypt one block (16 bytes) with the configured key.\0A *\0A * \5Cparam ctx       The context holding the key.\0A * \5Cparam input     The buffer holding the input block. Must be 16 bytes.\0A * \5Cparam output    The buffer to which the output block will be written.\0A *                  Must be writable and 16 bytes long.\0A *                  This must either not overlap with \5Cp input, or be equal.\0A *\0A * \5Cretval          \5Cc 0 on success.\0A * \5Cretval          #MBEDTLS_ERR_CIPHER_INVALID_CONTEXT if the context was not\0A *                  properly set up before calling this function.\0A * \5Cretval          Another negative value if encryption failed.\0A */\0Aint mbedtls_block_cipher_encrypt(mbedtls_block_cipher_context_t *ctx,\0A                                 const unsigned char input[16],\0A                                 unsigned char output[16]);\0A/**\0A * \5Cbrief           Clear the context.\0A *\0A * \5Cparam ctx       The context to clear.\0A */\0Avoid mbedtls_block_cipher_free(mbedtls_block_cipher_context_t *ctx);\0A\0A#ifdef __cplusplus\0A}\0A#endif\0A\0A#endif /* MBEDTLS_BLOCK_CIPHER_INTERNAL_H */\0A\00" }
