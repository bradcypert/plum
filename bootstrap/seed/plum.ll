                           const unsigned char *end,\0A                                mbedtls_mpi *X)\0A{\0A    int ret;\0A\0A    ret = mbedtls_asn1_get_mpi(p, end, X);\0A    if (ret != 0) {\0A        return ret;\0A    }\0A\0A    if (mbedtls_mpi_cmp_int(X, 0) == 0) {\0A        return MBEDTLS_ERR_RSA_BAD_INPUT_DATA;\0A    }\0A\0A    return 0;\0A}\0A\0Aint mbedtls_rsa_parse_key(mbedtls_rsa_context *rsa, const unsigned char *key, size_t keylen)\0A{\0A    int ret, version;\0A    size_t len;\0A    unsigned char *p, *end;\0A\0A    mbedtls_mpi T;\0A    mbedtls_mpi_init(&T);\0A\0A    p = (unsigned char *) key;\0A    end = p + keylen;\0A\0A    /*\0A     * This function parses the RSAPrivateKey (PKCS#1)\0A     *\0A     *  RSAPrivateKey ::= SEQUENCE {\0A     *      version           Version,\0A     *      modulus           INTEGER,  -- n\0A     *      publicExponent    INTEGER,  -- e\0A     *      privateExponent   INTEGER,  -- d\0A     *      prime1            INTEGER,  -- p\0A     *      prime2            INTEGER,  -- q\0A     *      exponent1         INTEGER,  -- d mod (p-1)\0A     *      exponent2         INTEGER,  -- d mod (q-1)\0A     *      coefficient       INTEGER,  -- (inverse of q) mod p\0A     *      otherPrimeInfos   OtherPrimeInfos OPTIONAL\0A     *  }\0A     */\0A    if ((ret = mbedtls_asn1_get_tag(&p, end, &len,\0A                                    MBEDTLS_ASN1_CONSTRUCTED | MBEDTLS_ASN1_SEQUENCE)) != 0) {\0A        return ret;\0A    }\0A\0A    if (end != p + len) {\0A        return MBEDTLS_ERR_RSA_BAD_INPUT_DATA;\0A    }\0A\0A    if ((ret = mbedtls_asn1_get_int(&p, end, &version)) != 0) {\0A        return ret;\0A    }\0A\0A    if (version != 0) {\0A        return MBEDTLS_ERR_RSA_BAD_INPUT_DATA;\0A    }\0A\0A    /* Import N */\0A    if ((ret = asn1_get_nonzero_mpi(&p, end, &T)) != 0 ||\0A        (ret = mbedtls_rsa_import(rsa, &T, NULL, NULL,\0A                                  NULL, NULL)) != 0) {\0A        goto cleanup;\0A    }\0A\0A    /* Import E */\0A    if ((ret = asn1_get_nonzero_mpi(&p, end, &T)) != 0 ||\0A        (ret = mbedtls_rsa_import(rsa, NULL, NULL, NULL,\0A                                  NULL, &T)) != 0) {\0A        goto cleanup;\0A    }\0A\0A    /* Import D */\0A    if ((ret = asn1_get_nonzero_mpi(&p, end, &T)) != 0 ||\0A        (ret = mbedtls_rsa_import(rsa, NULL, NULL, NULL,\0A                                  &T, NULL)) != 0) {\0A        goto cleanup;\0A    }\0A\0A    /* Import P */\0A    if ((ret = asn1_get_nonzero_mpi(&p, end, &T)) != 0 ||\0A        (ret = mbedtls_rsa_import(rsa, NULL, &T, NULL,\0A                                  NULL, NULL)) != 0) {\0A        goto cleanup;\0A    }\0A\0A    /* Import Q */\0A    if ((ret = asn1_get_nonzero_mpi(&p, end, &T)) != 0 ||\0A        (ret = mbedtls_rsa_import(rsa, NULL, NULL, &T,\0A                                  NULL, NULL)) != 0) {\0A        goto cleanup;\0A    }\0A\0A#if !defined(MBEDTLS_RSA_NO_CRT) && !defined(MBEDTLS_RSA_ALT)\0A    /*\0A     * The RSA CRT parameters DP, DQ and QP are nominally redundant, in\0A     * that they can be easily recomputed from D, P and Q. However by\0A     * parsing them from the PKCS1 structure it is possible to avoid\0A     * recalculating them which both reduces the overhead of loading\0A     * RSA private keys into memory and also avoids side channels which\0A     * can arise when computing those values, since all of D, P, and Q\0A     * are secret. See https://eprint.iacr.org/2020/055 for a\0A     * description of one such attack.\0A     */\0A\0A    /* Import DP */\0A    if ((ret = asn1_get_nonzero_mpi(&p, end, &T)) != 0 ||\0A        (ret = mbedtls_mpi_copy(&rsa->DP, &T)) != 0) {\0A        goto cleanup;\0A    }\0A\0A    /* Import DQ */\0A    if ((ret = asn1_get_nonzero_mpi(&p, end, &T)) != 0 ||\0A        (ret = mbedtls_mpi_copy(&rsa->DQ, &T)) != 0) {\0A        goto cleanup;\0A    }\0A\0A    /* Import QP */\0A    if ((ret = asn1_get_nonzero_mpi(&p, end, &T)) != 0 ||\0A        (ret = mbedtls_mpi_copy(&rsa->QP, &T)) != 0) {\0A        goto cleanup;\0A    }\0A\0A#else\0A    /* Verify existence of the CRT params */\0A    if ((ret = asn1_get_nonzero_mpi(&p, end, &T)) != 0 ||\0A        (ret = asn1_get_nonzero_mpi(&p, end, &T)) != 0 ||\0A        (ret = asn1_get_nonzero_mpi(&p, end, &T)) != 0) {\0A        goto cleanup;\0A    }\0A#endif\0A\0A    /* rsa_complete() doesn't complete anything with the default\0A     * implementation but is still called:\0A     * - for the benefit of alternative implementation that may want to\0A     *   pre-compute stuff beyond what's provided (eg Montgomery factors)\0A     * - as is also sanity-checks the key\0A     *\0A     * Furthermore, we also check the public part for consistency with\0A     * mbedtls_pk_parse_pubkey(), as it includes size minima for example.\0A     */\0A    if ((ret = mbedtls_rsa_complete(rsa)) != 0 ||\0A        (ret = mbedtls_rsa_check_pubkey(rsa)) != 0) {\0A        goto cleanup;\0A    }\0A\0A    if (p != end) {\0A        ret = MBEDTLS_ERR_ASN1_LENGTH_MISMATCH;\0A    }\0A\0Acleanup:\0A\0A    mbedtls_mpi_free(&T);\0A\0A    if (ret != 0) {\0A        mbedtls_rsa_free(rsa);\0A    }\0A\0A    return ret;\0A}\0A\0Aint mbedtls_rsa_parse_pubkey(mbedtls_rsa_context *rsa, const unsigned char *key, size_t keylen)\0A{\0A    unsigned char *p = (unsigned char *) key;\0A    unsigned char *end = (unsigned char *) (key + keylen);\0A    int ret = MBEDTLS_ERR_ERROR_CORRUPTION_DETECTED;\0A    size_t len;\0A\0A    /*\0A     *  RSAPublicKey ::= SEQUENCE {\0A     *      modulus           INTEGER,  -- n\0A     *      publicExponent    INTEGER   -- e\0A     *  }\0A     */\0A\0A    if ((ret = mbedtls_asn1_get_tag(&p, end, &len,\0A                                    MBEDTLS_ASN1_CONSTRUCTED | MBEDTLS_ASN1_SEQUENCE)) != 0) {\0A        return ret;\0A    }\0A\0A    if (end != p + len) {\0A        return MBEDTLS_ERR_RSA_BAD_INPUT_DATA;\0A    }\0A\0A    /* Import N */\0A    if ((ret = mbedtls_asn1_get_tag(&p, end, &len, MBEDTLS_ASN1_INTEGER)) != 0) {\0A        return ret;\0A    }\0A\0A    if ((ret = mbedtls_rsa_import_raw(rsa, p, len, NULL, 0, NULL, 0,\0A                                      NULL, 0, NULL, 0)) != 0) {\0A        return MBEDTLS_ERR_RSA_BAD_INPUT_DATA;\0A    }\0A\0A    p += len;\0A\0A    /* Import E */\0A    if ((ret = mbedtls_asn1_get_tag(&p, end, &len, MBEDTLS_ASN1_INTEGER)) != 0) {\0A        return ret;\0A    }\0A\0A    if ((ret = mbedtls_rsa_import_raw(rsa, NULL, 0, NULL, 0, NULL, 0,\0A                                      NULL, 0, p, len)) != 0) {\0A        return MBEDTLS_ERR_RSA_BAD_INPUT_DATA;\0A    }\0A\0A    p += len;\0A\0A    if (mbedtls_rsa_complete(rsa) != 0 ||\0A        mbedtls_rsa_check_pubkey(rsa) != 0) {\0A        return MBEDTLS_ERR_RSA_BAD_INPUT_DATA;\0A    }\0A\0A    if (p != end) {\0A        return MBEDTLS_ERR_ASN1_LENGTH_MISMATCH;\0A    }\0A\0A    return 0;\0A}\0A\0Aint mbedtls_rsa_write_key(const mbedtls_rsa_context *rsa, unsigned char *start,\0A                          unsigned char **p)\0A{\0A    size_t len = 0;\0A    int ret;\0A\0A    mbedtls_mpi T; /* Temporary holding the exported parameters */\0A\0A    /*\0A     * Export the parameters one after another to avoid simultaneous copies.\0A     */\0A\0A    mbedtls_mpi_init(&T);\0A\0A    /* Export QP */\0A    if ((ret = mbedtls_rsa_export_crt(rsa, NULL, NULL, &T)) != 0 ||\0A        (ret = mbedtls_asn1_write_mpi(p, start, &T)) < 0) {\0A        goto end_of_export;\0A    }\0A    len += ret;\0A\0A    /* Export DQ */\0A    if ((ret = mbedtls_rsa_export_crt(rsa, NULL, &T, NULL)) != 0 ||\0A        (ret = mbedtls_asn1_write_mpi(p, start, &T)) < 0) {\0A        goto end_of_export;\0A    }\0A    len += ret;\0A\0A    /* Export DP */\0A    if ((ret = mbedtls_rsa_export_crt(rsa, &T, NULL, NULL)) != 0 ||\0A        (ret = mbedtls_asn1_write_mpi(p, start, &T)) < 0) {\0A        goto end_of_export;\0A    }\0A    len += ret;\0A\0A    /* Export Q */\0A    if ((ret = mbedtls_rsa_export(rsa, NULL, NULL, &T, NULL, NULL)) != 0 ||\0A        (ret = mbedtls_asn1_write_mpi(p, start, &T)) < 0) {\0A        goto end_of_export;\0A    }\0A    len += ret;\0A\0A    /* Export P */\0A    if ((ret = mbedtls_rsa_export(rsa, NULL, &T, NULL, NULL, NULL)) != 0 ||\0A        (ret = mbedtls_asn1_write_mpi(p, start, &T)) < 0) {\0A        goto end_of_export;\0A    }\0A    len += ret;\0A\0A    /* Export D */\0A    if ((ret = mbedtls_rsa_export(rsa, NULL, NULL, NULL, &T, NULL)) != 0 ||\0A        (ret = mbedtls_asn1_write_mpi(p, start, &T)) < 0) {\0A        goto end_of_export;\0A    }\0A    len += ret;\0A\0A    /* Export E */\0A    if ((ret = mbedtls_rsa_export(rsa, NULL, NULL, NULL, NULL, &T)) != 0 ||\0A        (ret = mbedtls_asn1_write_mpi(p, start, &T)) < 0) {\0A        goto end_of_export;\0A    }\0A    len += ret;\0A\0A    /* Export N */\0A    if ((ret = mbedtls_rsa_export(rsa, &T, NULL, NULL, NULL, NULL)) != 0 ||\0A        (ret = mbedtls_asn1_write_mpi(p, start, &T)) < 0) {\0A        goto end_of_export;\0A    }\0A    len += ret;\0A\0Aend_of_export:\0A\0A    mbedtls_mpi_free(&T);\0A    if (ret < 0) {\0A        return ret;\0A    }\0A\0A    MBEDTLS_ASN1_CHK_ADD(len, mbedtls_asn1_write_int(p, start, 0));\0A    MBEDTLS_ASN1_CHK_ADD(len, mbedtls_asn1_write_len(p, start, len));\0A    MBEDTLS_ASN1_CHK_ADD(len, mbedtls_asn1_write_tag(p, start,\0A                                                     MBEDTLS_ASN1_CONSTRUCTED |\0A                                                     MBEDTLS_ASN1_SEQUENCE));\0A\0A    return (int) len;\0A}\0A\0A/*\0A *  RSAPublicKey ::= SEQUENCE {\0A *      modulus           INTEGER,  -- n\0A *      publicExponent    INTEGER   -- e\0A *  }\0A */\0Aint mbedtls_rsa_write_pubkey(const mbedtls_rsa_context *rsa, unsigned char *start,\0A                             unsigned char **p)\0A{\0A    int ret = MBEDTLS_ERR_ERROR_CORRUPTION_DETECTED;\0A    size_t len = 0;\0A    mbedtls_mpi T;\0A\0A    mbedtls_mpi_init(&T);\0A\0A    /* Export E */\0A    if ((ret = mbedtls_rsa_export(rsa, NULL, NULL, NULL, NULL, &T)) != 0 ||\0A        (ret = mbedtls_asn1_write_mpi(p, start, &T)) < 0) {\0A        goto end_of_export;\0A    }\0A    len += ret;\0A\0A    /* Export N */\0A    if ((ret = mbedtls_rsa_export(rsa, &T, NULL, NULL, NULL, NULL)) != 0 ||\0A        (ret = mbedtls_asn1_write_mpi(p, start, &T)) < 0) {\0A        goto end_of_export;\0A    }\0A    len += ret;\0A\0Aend_of_export:\0A\0A    mbedtls_mpi_free(&T);\0A    if (ret < 0) {\0A        return ret;\0A    }\0A\0A    MBEDTLS_ASN1_CHK_ADD(len, mbedtls_asn1_write_len(p, start, len));\0A    MBEDTLS_ASN1_CHK_ADD(len, mbedtls_asn1_write_tag(p, start, MBEDTLS_ASN1_CONSTRUCTED |\0A                                                     MBEDTLS_ASN1_SEQUENCE));\0A\0A    return (int) len;\0A}\0A\0A#if defined(MBEDTLS_PKCS1_V15) && defined(MBEDTLS_RSA_C) && !defined(MBEDTLS_RSA_ALT)\0A\0A/** This function performs the unpadding part of a PKCS#1 v1.5 decryption\0A *  operation (EME-PKCS1-v1_5 decoding).\0A *\0A * \5Cnote The return value from this function is a sensitive value\0A *       (this is unusual). #MBEDTLS_ERR_RSA_OUTPUT_TOO_LARGE shouldn't happen\0A *       in a well-written application, but 0 vs #MBEDTLS_ERR_RSA_INVALID_PADDING\0A *       is often a situation that an attacker can provoke and leaking which\0A *       one is the result is precisely the information the attacker wants.\0A *\0A * \5Cparam input          The input buffer which is the payload inside PKCS#1v1.5\0A *                       encryption padding, called the \22encoded message EM\22\0A *                       by the terminology.\0A * \5Cparam ilen           The length of the payload in the \5Cp input buffer.\0A * \5Cparam output         The buffer for the payload, called \22message M\22 by the\0A *                       PKCS#1 terminology. This must be a writable buffer of\0A *                       length \5Cp output_max_len bytes.\0A * \5Cparam olen           The address at which to store the length of\0A *                       the payload. This must not be \5Cc NULL.\0A * \5Cparam output_max_len The length in bytes of the output buffer \5Cp output.\0A *\0A * \5Creturn      \5Cc 0 on success.\0A * \5Creturn      #MBEDTLS_ERR_RSA_OUTPUT_TOO_LARGE\0A *              The output buffer is too small for the unpadded payload.\0A * \5Creturn      #MBEDTLS_ERR_RSA_INVALID_PADDING\0A *              The input doesn't contain properly formatted padding.\0A */\0Astatic int mbedtls_ct_rsaes_pkcs1_v15_unpadding(unsigned char *input,\0A                                                size_t ilen,\0A                                                unsigned char *output,\0A                                                size_t output_max_len,\0A                                                size_t *olen)\0A{\0A    int ret = MBEDTLS_ERR_ERROR_CORRUPTION_DETECTED;\0A    size_t i, plaintext_max_size;\0A\0A    /* The following variables take sensitive values: their value must\0A     * not leak into the observable behavior of the function other than\0A     * the designated outputs (output, olen, return value). Otherwise\0A     * this would open the execution of the function to\0A     * side-channel-based variants of the Bleichenbacher padding oracle\0A     * attack. Potential side channels include overall timing, memory\0A     * access patterns (especially visible to an adversary who has access\0A     * to a shared memory cache), and branches (especially visible to\0A     * an adversary who has access to a shared code cache or to a shared\0A     * branch predictor). */\0A    size_t pad_count = 0;\0A    mbedtls_ct_condition_t bad;\0A    mbedtls_ct_condition_t pad_done;\0A    size_t plaintext_size = 0;\0A    mbedtls_ct_condition_t output_too_large;\0A\0A    plaintext_max_size = (output_max_len > ilen - 11) ? ilen - 11\0A                                                        : output_max_len;\0A\0A    /* Check and get padding length in constant time and constant\0A     * memory trace. The first byte must be 0. */\0A    bad = mbedtls_ct_bool(input[0]);\0A\0A\0A    /* Decode EME-PKCS1-v1_5 padding: 0x00 || 0x02 || PS || 0x00\0A     * where PS must be at least 8 nonzero bytes. */\0A    bad = mbedtls_ct_bool_or(bad, mbedtls_ct_uint_ne(input[1], MBEDTLS_RSA_CRYPT));\0A\0A    /* Read the whole buffer. Set pad_done to nonzero if we find\0A     * the 0x00 byte and remember the padding length in pad_count. */\0A    pad_done = MBEDTLS_CT_FALSE;\0A    for (i = 2; i < ilen; i++) {\0A        mbedtls_ct_condition_t found = mbedtls_ct_uint_eq(input[i], 0);\0A        pad_done   = mbedtls_ct_bool_or(pad_done, found);\0A        pad_count += mbedtls_ct_uint_if_else_0(mbedtls_ct_bool_not(pad_done), 1);\0A    }\0A\0A    /* If pad_done is still zero, there's no data, only unfinished padding. */\0A    bad = mbedtls_ct_bool_or(bad, mbedtls_ct_bool_not(pad_done));\0A\0A    /* There must be at least 8 bytes of padding. */\0A    bad = mbedtls_ct_bool_or(bad, mbedtls_ct_uint_gt(8, pad_count));\0A\0A    /* If the padding is valid, set plaintext_size to the number of\0A     * remaining bytes after stripping the padding. If the padding\0A     * is invalid, avoid leaking this fact through the size of the\0A     * output: use the maximum message size that fits in the output\0A     * buffer. Do it without branches to avoid leaking the padding\0A     * validity through timing. RSA keys are small enough that all the\0A     * size_t values involved fit in unsigned int. */\0A    plaintext_size = mbedtls_ct_uint_if(\0A        bad, (unsigned) plaintext_max_size,\0A        (unsigned) (ilen - pad_count - 3));\0A\0A    /* Set output_too_large to 0 if the plaintext fits in the output\0A     * buffer and to 1 otherwise. */\0A    output_too_large = mbedtls_ct_uint_gt(plaintext_size,\0A                                          plaintext_max_size);\0A\0A    /* Set ret without branches to avoid timing attacks. Return:\0A     * - INVALID_PADDING if the padding is bad (bad != 0).\0A     * - OUTPUT_TOO_LARGE if the padding is good but the decrypted\0A     *   plaintext does not fit in the