@.str40378 = private global { i64, i64, [435 x i8] } { i64 -1, i64 434, [435 x i8] c"/*\0A *  PSA crypto client code\0A */\0A/*\0A *  Copyright The Mbed TLS Contributors\0A *  SPDX-License-Identifier: Apache-2.0 OR GPL-2.0-or-later\0A */\0A\0A#include \22common.h\22\0A#include \22psa/crypto.h\22\0A\0A#if defined(MBEDTLS_PSA_CRYPTO_CLIENT)\0A\0A#include <string.h>\0A#include \22mbedtls/platform.h\22\0A\0Avoid psa_reset_key_attributes(psa_key_attributes_t *attributes)\0A{\0A    memset(attributes, 0, sizeof(*attributes));\0A}\0A\0A#endif /* MBEDTLS_PSA_CRYPTO_CLIENT */\0A\00" }
