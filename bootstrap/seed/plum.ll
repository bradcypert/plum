st be due to a build issue */\0A        return MBEDTLS_ERR_CIPHER_FEATURE_UNAVAILABLE;\0A    }\0A\0A    for (i = 0; i < num_tests; i++) {\0A        if (verbose != 0) {\0A            mbedtls_printf(\22  %s CMAC subkey #%d: \22, testname, i + 1);\0A        }\0A\0A        mbedtls_cipher_init(&ctx);\0A\0A        if ((ret = mbedtls_cipher_setup(&ctx, cipher_info)) != 0) {\0A            if (verbose != 0) {\0A                mbedtls_printf(\22test execution failed\5Cn\22);\0A            }\0A\0A            goto cleanup;\0A        }\0A\0A        if ((ret = mbedtls_cipher_setkey(&ctx, key, keybits,\0A                                         MBEDTLS_ENCRYPT)) != 0) {\0A            /* When CMAC is implemented by an alternative implementation, or\0A             * the underlying primitive itself is implemented alternatively,\0A             * AES-192 may be unavailable. This should not cause the selftest\0A             * function to fail. */\0A            if ((ret == MBEDTLS_ERR_PLATFORM_FEATURE_UNSUPPORTED ||\0A                 ret == MBEDTLS_ERR_CIPHER_FEATURE_UNAVAILABLE) &&\0A                cipher_type == MBEDTLS_CIPHER_AES_192_ECB) {\0A                if (verbose != 0) {\0A                    mbedtls_printf(\22skipped\5Cn\22);\0A                }\0A                goto next_test;\0A            }\0A\0A            if (verbose != 0) {\0A                mbedtls_printf(\22test execution failed\5Cn\22);\0A            }\0A\0A            goto cleanup;\0A        }\0A\0A        ret = cmac_generate_subkeys(&ctx, K1, K2);\0A        if (ret != 0) {\0A            if (verbose != 0) {\0A                mbedtls_printf(\22failed\5Cn\22);\0A            }\0A\0A            goto cleanup;\0A        }\0A\0A        if ((ret = memcmp(K1, subkeys, block_size)) != 0  ||\0A            (ret = memcmp(K2, &subkeys[block_size], block_size)) != 0) {\0A            if (verbose != 0) {\0A                mbedtls_printf(\22failed\5Cn\22);\0A            }\0A\0A            goto cleanup;\0A        }\0A\0A        if (verbose != 0) {\0A            mbedtls_printf(\22passed\5Cn\22);\0A        }\0A\0Anext_test:\0A        mbedtls_cipher_free(&ctx);\0A    }\0A\0A    ret = 0;\0A    goto exit;\0A\0Acleanup:\0A    mbedtls_cipher_free(&ctx);\0A\0Aexit:\0A    return ret;\0A}\0A\0Astatic int cmac_test_wth_cipher(int verbose,\0A                                const char *testname,\0A                                const unsigned char *key,\0A                                int keybits,\0A                                const unsigned char *messages,\0A                                const unsigned int message_lengths[4],\0A                                const unsigned char *expected_result,\0A                                mbedtls_cipher_type_t cipher_type,\0A                                int block_size,\0A                                int num_tests)\0A{\0A    const mbedtls_cipher_info_t *cipher_info;\0A    int i, ret = 0;\0A    unsigned char output[MBEDTLS_CMAC_MAX_BLOCK_SIZE];\0A\0A    cipher_info = mbedtls_cipher_info_from_type(cipher_type);\0A    if (cipher_info == NULL) {\0A        /* Failing at this point must be due to a build issue */\0A        ret = MBEDTLS_ERR_CIPHER_FEATURE_UNAVAILABLE;\0A        goto exit;\0A    }\0A\0A    for (i = 0; i < num_tests; i++) {\0A        if (verbose != 0) {\0A            mbedtls_printf(\22  %s CMAC #%d: \22, testname, i + 1);\0A        }\0A\0A        if ((ret = mbedtls_cipher_cmac(cipher_info, key, keybits, messages,\0A                                       message_lengths[i], output)) != 0) {\0A            /* When CMAC is implemented by an alternative implementation, or\0A             * the underlying primitive itself is implemented alternatively,\0A             * AES-192 and/or 3DES may be unavailable. This should not cause\0A             * the selftest function to fail. */\0A            if ((ret == MBEDTLS_ERR_PLATFORM_FEATURE_UNSUPPORTED ||\0A                 ret == MBEDTLS_ERR_CIPHER_FEATURE_UNAVAILABLE) &&\0A                (cipher_type == MBEDTLS_CIPHER_AES_192_ECB ||\0A                 cipher_type == MBEDTLS_CIPHER_DES_EDE3_ECB)) {\0A                if (verbose != 0) {\0A                    mbedtls_printf(\22skipped\5Cn\22);\0A                }\0A                continue;\0A            }\0A\0A            if (verbose != 0) {\0A                mbedtls_printf(\22failed\5Cn\22);\0A            }\0A            goto exit;\0A        }\0A\0A        if ((ret = memcmp(output, &expected_result[i * block_size], block_size)) != 0) {\0A            if (verbose != 0) {\0A                mbedtls_printf(\22failed\5Cn\22);\0A            }\0A            goto exit;\0A        }\0A\0A        if (verbose != 0) {\0A            mbedtls_printf(\22passed\5Cn\22);\0A        }\0A    }\0A    ret = 0;\0A\0Aexit:\0A    return ret;\0A}\0A\0A#if defined(MBEDTLS_AES_C)\0Astatic int test_aes128_cmac_prf(int verbose)\0A{\0A    int i;\0A    int ret = MBEDTLS_ERR_ERROR_CORRUPTION_DETECTED;\0A    unsigned char output[MBEDTLS_AES_BLOCK_SIZE];\0A\0A    for (i = 0; i < NB_PRF_TESTS; i++) {\0A        mbedtls_printf(\22  AES CMAC 128 PRF #%d: \22, i);\0A        ret = mbedtls_aes_cmac_prf_128(PRFK, PRFKlen[i], PRFM, 20, output);\0A        if (ret != 0 ||\0A            memcmp(output, PRFT[i], MBEDTLS_AES_BLOCK_SIZE) != 0) {\0A\0A            if (verbose != 0) {\0A                mbedtls_printf(\22failed\5Cn\22);\0A            }\0A\0A            return ret;\0A        } else if (verbose != 0) {\0A            mbedtls_printf(\22passed\5Cn\22);\0A        }\0A    }\0A    return ret;\0A}\0A#endif /* MBEDTLS_AES_C */\0A\0Aint mbedtls_cmac_self_test(int verbose)\0A{\0A    int ret = MBEDTLS_ERR_ERROR_CORRUPTION_DETECTED;\0A\0A#if defined(MBEDTLS_AES_C)\0A    /* AES-128 */\0A    if ((ret = cmac_test_subkeys(verbose,\0A                                 \22AES 128\22,\0A                                 aes_128_key,\0A                                 128,\0A                                 (const unsigned char *) aes_128_subkeys,\0A                                 MBEDTLS_CIPHER_AES_128_ECB,\0A                                 MBEDTLS_AES_BLOCK_SIZE,\0A                                 NB_CMAC_TESTS_PER_KEY)) != 0) {\0A        return ret;\0A    }\0A\0A    if ((ret = cmac_test_wth_cipher(verbose,\0A                                    \22AES 128\22,\0A                                    aes_128_key,\0A                                    128,\0A                                    test_message,\0A                                    aes_message_lengths,\0A                                    (const unsigned char *) aes_128_expected_result,\0A                                    MBEDTLS_CIPHER_AES_128_ECB,\0A                                    MBEDTLS_AES_BLOCK_SIZE,\0A                                    NB_CMAC_TESTS_PER_KEY)) != 0) {\0A        return ret;\0A    }\0A\0A    /* AES-192 */\0A#if !defined(MBEDTLS_AES_ONLY_128_BIT_KEY_LENGTH)\0A    if ((ret = cmac_test_subkeys(verbose,\0A                                 \22AES 192\22,\0A                                 aes_192_key,\0A                                 192,\0A                                 (const unsigned char *) aes_192_subkeys,\0A                                 MBEDTLS_CIPHER_AES_192_ECB,\0A                                 MBEDTLS_AES_BLOCK_SIZE,\0A                                 NB_CMAC_TESTS_PER_KEY)) != 0) {\0A        return ret;\0A    }\0A\0A    if ((ret = cmac_test_wth_cipher(verbose,\0A                                    \22AES 192\22,\0A                                    aes_192_key,\0A                                    192,\0A                                    test_message,\0A                                    aes_message_lengths,\0A                                    (const unsigned char *) aes_192_expected_result,\0A                                    MBEDTLS_CIPHER_AES_192_ECB,\0A                                    MBEDTLS_AES_BLOCK_SIZE,\0A                                    NB_CMAC_TESTS_PER_KEY)) != 0) {\0A        return ret;\0A    }\0A#endif /* !MBEDTLS_AES_ONLY_128_BIT_KEY_LENGTH */\0A\0A    /* AES-256 */\0A#if !defined(MBEDTLS_AES_ONLY_128_BIT_KEY_LENGTH)\0A    if ((ret = cmac_test_subkeys(verbose,\0A                                 \22AES 256\22,\0A                                 aes_256_key,\0A                                 256,\0A                                 (const unsigned char *) aes_256_subkeys,\0A                                 MBEDTLS_CIPHER_AES_256_ECB,\0A                                 MBEDTLS_AES_BLOCK_SIZE,\0A                                 NB_CMAC_TESTS_PER_KEY)) != 0) {\0A        return ret;\0A    }\0A\0A    if ((ret = cmac_test_wth_cipher(verbose,\0A                                    \22AES 256\22,\0A                                    aes_256_key,\0A                                    256,\0A                                    test_message,\0A                                    aes_message_lengths,\0A                                    (const unsigned char *) aes_256_expected_result,\0A                                    MBEDTLS_CIPHER_AES_256_ECB,\0A                                    MBEDTLS_AES_BLOCK_SIZE,\0A                                    NB_CMAC_TESTS_PER_KEY)) != 0) {\0A        return ret;\0A    }\0A#endif /* !MBEDTLS_AES_ONLY_128_BIT_KEY_LENGTH */\0A#endif /* MBEDTLS_AES_C */\0A\0A#if defined(MBEDTLS_DES_C)\0A    /* 3DES 2 key */\0A    if ((ret = cmac_test_subkeys(verbose,\0A                                 \223DES 2 key\22,\0A                                 des3_2key_key,\0A                                 192,\0A                                 (const unsigned char *) des3_2key_subkeys,\0A                                 MBEDTLS_CIPHER_DES_EDE3_ECB,\0A                                 MBEDTLS_DES3_BLOCK_SIZE,\0A                                 NB_CMAC_TESTS_PER_KEY)) != 0) {\0A        return ret;\0A    }\0A\0A    if ((ret = cmac_test_wth_cipher(verbose,\0A                                    \223DES 2 key\22,\0A                                    des3_2key_key,\0A                                    192,\0A                                    test_message,\0A                                    des3_message_lengths,\0A                                    (const unsigned char *) des3_2key_expected_result,\0A                                    MBEDTLS_CIPHER_DES_EDE3_ECB,\0A                                    MBEDTLS_DES3_BLOCK_SIZE,\0A                                    NB_CMAC_TESTS_PER_KEY)) != 0) {\0A        return ret;\0A    }\0A\0A    /* 3DES 3 key */\0A    if ((ret = cmac_test_subkeys(verbose,\0A                                 \223DES 3 key\22,\0A                                 des3_3key_key,\0A                                 192,\0A                                 (const unsigned char *) des3_3key_subkeys,\0A                                 MBEDTLS_CIPHER_DES_EDE3_ECB,\0A                                 MBEDTLS_DES3_BLOCK_SIZE,\0A                                 NB_CMAC_TESTS_PER_KEY)) != 0) {\0A        return ret;\0A    }\0A\0A    if ((ret = cmac_test_wth_cipher(verbose,\0A                                    \223DES 3 key\22,\0A                                    des3_3key_key,\0A                                    192,\0A                                    test_message,\0A                                    des3_message_lengths,\0A                                    (const unsigned char *) des3_3key_expected_result,\0A                                    MBEDTLS_CIPHER_DES_EDE3_ECB,\0A                                    MBEDTLS_DES3_BLOCK_SIZE,\0A                                    NB_CMAC_TESTS_PER_KEY)) != 0) {\0A        return ret;\0A    }\0A#endif /* MBEDTLS_DES_C */\0A\0A#if defined(MBEDTLS_AES_C)\0A    if ((ret = test_aes128_cmac_prf(verbose)) != 0) {\0A        return ret;\0A    }\0A#endif /* MBEDTLS_AES_C */\0A\0A    if (verbose != 0) {\0A        mbedtls_printf(\22\5Cn\22);\0A    }\0A\0A    return 0;\0A}\0A\0A#endif /* MBEDTLS_SELF_TEST */\0A\0A#endif /* MBEDTLS_CMAC_C */\0A\00" }
