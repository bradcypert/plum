DTLS_SSL_KEEP_PEER_CERTIFICATE)\0A    if (src->peer_cert != NULL) {\0A        int ret = MBEDTLS_ERR_ERROR_CORRUPTION_DETECTED;\0A\0A        dst->peer_cert = mbedtls_calloc(1, sizeof(mbedtls_x509_crt));\0A        if (dst->peer_cert == NULL) {\0A            return MBEDTLS_ERR_SSL_ALLOC_FAILED;\0A        }\0A\0A        mbedtls_x509_crt_init(dst->peer_cert);\0A\0A        if ((ret = mbedtls_x509_crt_parse_der(dst->peer_cert, src->peer_cert->raw.p,\0A                                              src->peer_cert->raw.len)) != 0) {\0A            mbedtls_free(dst->peer_cert);\0A            dst->peer_cert = NULL;\0A            return ret;\0A        }\0A    }\0A#else /* MBEDTLS_SSL_KEEP_PEER_CERTIFICATE */\0A    if (src->peer_cert_digest != NULL) {\0A        dst->peer_cert_digest =\0A            mbedtls_calloc(1, src->peer_cert_digest_len);\0A        if (dst->peer_cert_digest == NULL) {\0A            return MBEDTLS_ERR_SSL_ALLOC_FAILED;\0A        }\0A\0A        memcpy(dst->peer_cert_digest, src->peer_cert_digest,\0A               src->peer_cert_digest_len);\0A        dst->peer_cert_digest_type = src->peer_cert_digest_type;\0A        dst->peer_cert_digest_len = src->peer_cert_digest_len;\0A    }\0A#endif /* MBEDTLS_SSL_KEEP_PEER_CERTIFICATE */\0A\0A#endif /* MBEDTLS_X509_CRT_PARSE_C */\0A\0A#if defined(MBEDTLS_SSL_SRV_C) && defined(MBEDTLS_SSL_ALPN) && \5C\0A    defined(MBEDTLS_SSL_EARLY_DATA)\0A    {\0A        int ret = mbedtls_ssl_session_set_ticket_alpn(dst, src->ticket_alpn);\0A        if (ret != 0) {\0A            return ret;\0A        }\0A    }\0A#endif /* MBEDTLS_SSL_SRV_C && MBEDTLS_SSL_ALPN && MBEDTLS_SSL_EARLY_DATA */\0A\0A#if defined(MBEDTLS_SSL_SESSION_TICKETS) && defined(MBEDTLS_SSL_CLI_C)\0A    if (src->ticket != NULL) {\0A        dst->ticket = mbedtls_calloc(1, src->ticket_len);\0A        if (dst->ticket == NULL) {\0A            return MBEDTLS_ERR_SSL_ALLOC_FAILED;\0A        }\0A\0A        memcpy(dst->ticket, src->ticket, src->ticket_len);\0A    }\0A\0A#if defined