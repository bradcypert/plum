n;\0A#elif defined(MBEDTLS_CT_X86_64_ASM) && (defined(MBEDTLS_CT_SIZE_32) || defined(MBEDTLS_CT_SIZE_64))\0A    asm volatile (\22and  %[condition], %[if1]                      \5Cn\5Ct\22\0A                  \22not  %[condition]                              \5Cn\5Ct\22\0A                  \22and  %[condition], %[if0]                      \5Cn\5Ct\22\0A                  \22or   %[if1], %[if0]                            \5Cn\5Ct\22\0A                  :\0A                  [condition] \22+&D\22 (condition),\0A                  [if1] \22+&S\22 (if1),\0A                  [if0] \22+&a\22 (if0)\0A                  :\0A                  :\0A                  );\0A    return if0;\0A#elif defined(MBEDTLS_CT_X86_ASM) && defined(MBEDTLS_CT_SIZE_32)\0A    asm volatile (\22and %[condition], %[if1]                       \5Cn\5Ct\22\0A                  \22not %[condition]                               \5Cn\5Ct\22\0A                  \22and %[if0], %[condition]                       \5Cn\5Ct\22\0A                  \22or %[condition], %[if1]                        \5Cn\5Ct\22\0A                  :\0A                  [condition] \22+&c\22 (condition),\0A                  [if1] \22+&a\22 (if1)\0A                  :\0A                  [if0] \22b\22 (if0)\0A                  :\0A                  );\0A    return if1;\0A#else\0A    mbedtls_ct_condition_t not_cond =\0A        (mbedtls_ct_condition_t) (~mbedtls_ct_compiler_opaque(condition));\0A    return (mbedtls_ct_uint_t) ((condition & if1) | (not_cond & if0));\0A#endif\0A}\0A\0Astatic inline mbedtls_ct_condition_t mbedtls_ct_uint_lt(mbedtls_ct_uint_t x, mbedtls_ct_uint_t y)\0A{\0A#if defined(MBEDTLS_CT_AARCH64_ASM) && (defined(MBEDTLS_CT_SIZE_32) || defined(MBEDTLS_CT_SIZE_64))\0A    uint64_t s1;\0A    asm volatile (\22eor     %x[s1], %x[y], %x[x]                   \5Cn\5Ct\22\0A                  \22sub     %x[x], %x[x], %x[y]                    \5Cn\5Ct\22\0A                  \22bic     %x[x], %x[x], %x[s1]                   \5Cn\5Ct\22\0A                  \22and     %x[s1], %x[s1], %x[y]                  \5Cn\5Ct\22\0A                  \22orr     %x[s1], %x[x], %x[s1]                  \5Cn\5Ct\22\0A                  \22asr     %x[x], %x[s1], 63\22\0A                  :\0A                  [s1] \22=&r\22 (s1),\0A                  [x] \22+&r\22 (x)\0A                  :\0A                  [y] \22r\22 (y)\0A                  :\0A                  );\0A    return (mbedtls_ct_condition_t) x;\0A#elif defined(MBEDTLS_CT_ARM_ASM) && defined(MBEDTLS_CT_SIZE_32)\0A    uint32_t s1;\0A    asm volatile (\0A        \22.syntax unified                                          \5Cn\5Ct\22\0A#if defined(__thumb__) && !defined(__thumb2__)\0A        \22movs     %[s1], %[x]                                     \5Cn\5Ct\22\0A        \22eors     %[s1], %[s1], %[y]                              \5Cn\5Ct\22\0A#else\0A        \22eors     %[s1], %[x], %[y]                               \5Cn\5Ct\22\0A#endif\0A        \22subs    %[x], %[x], %[y]                                 \5Cn\5Ct\22\0A        \22bics    %[x], %[x], %[s1]                                \5Cn\5Ct\22\0A        \22ands    %[y], %[s1], %[y]                                \5Cn\5Ct\22\0A        \22orrs    %[x], %[x], %[y]                                 \5Cn\5Ct\22\0A        \22asrs    %[x], %[x], #31                                  \5Cn\5Ct\22\0A        RESTORE_ASM_SYNTAX\0A        :\0A        [s1] \22=&l\22 (s1),\0A        [x] \22+&l\22 (x),\0A        [y] \22+&l\22 (y)\0A        :\0A        :\0A        \22cc\22\0A        );\0A    return (mbedtls_ct_condition_t) x;\0A#elif defined(MBEDTLS_CT_X86_64_ASM) && (defined(MBEDTLS_CT_SIZE_32) || defined(MBEDTLS_CT_SIZE_64))\0A    uint64_t s;\0A    asm volatile (\22mov %[x], %[s]                                 \5Cn\5Ct\22\0A                  \22xor %[y], %[s]                                 \5Cn\5Ct\22\0A                  \22sub %[y], %[x]                                 \5Cn\5Ct\22\0A                  \22and %[s], %[y]                                 \5Cn\5Ct\22\0A                  \22not %[s]                                       \5Cn\5Ct\22\0A                  \22and %[s], %[x]                                 \5Cn\5Ct\22\0A                  \22or %[y], %[x]                                  \5Cn\5Ct\22\0A                  \22sar $63, %[x]                                  \5Cn\5Ct\22\0A                  :\0A                  [s] \22=&a\22 (s),\0A                  [x] \22+&D\22 (x),\0A                  [y] \22+&S\22 (y)\0A                  :\0A                  :\0A                  );\0A    return (mbedtls_ct_condition_t) x;\0A#elif defined(MBEDTLS_CT_X86_ASM) && defined(MBEDTLS_CT_SIZE_32)\0A    uint32_t s;\0A    asm volatile (\22mov %[x], %[s]                                 \5Cn\5Ct\22\0A                  \22xor %[y], %[s]                                 \5Cn\5Ct\22\0A                  \22sub %[y], %[x]                                 \5Cn\5Ct\22\0A                  \22and %[s], %[y]                                 \5Cn\5Ct\22\0A                  \22not %[s]                                       \5Cn\5Ct\22\0A                  \22and %[s], %[x]                                 \5Cn\5Ct\22\0A                  \22or  %[y], %[x]                                 \5Cn\5Ct\22\0A                  \22sar $31, %[x]                                  \5Cn\5Ct\22\0A                  :\0A                  [s] \22=&b\22 (s),\0A                  [x] \22+&a\22 (x),\0A                  [y] \22+&c\22 (y)\0A                  :\0A                  :\0A                  );\0A    return (mbedtls_ct_condition_t) x;\0A#else\0A    /* Ensure that the compiler cannot optimise the following operations over x and y,\0A     * even if it knows the value of x and y.\0A     */\0A    const mbedtls_ct_uint_t xo = mbedtls_ct_compiler_opaque(x);\0A    const mbedtls_ct_uint_t yo = mbedtls_ct_compiler_opaque(y);\0A    /*\0A     * Check if the most significant bits (MSB) of the operands are different.\0A     * cond is true iff the MSBs differ.\0A     */\0A    mbedtls_ct_condition_t cond = mbedtls_ct_bool((xo ^ yo) >> (MBEDTLS_CT_SIZE - 1));\0A\0A    /*\0A     * If the MSB are the same then the difference x-y will be negative (and\0A     * have its MSB set to 1 during conversion to unsigned) if and only if x<y.\0A     *\0A     * If the MSB are different, then the operand with the MSB of 1 is the\0A     * bigger. (That is if y has MSB of 1, then x<y is true and it is false if\0A     * the MSB of y is 0.)\0A     */\0A\0A    // Select either y, or x - y\0A    mbedtls_ct_uint_t ret = mbedtls_ct_if(cond, yo, (mbedtls_ct_uint_t) (xo - yo));\0A\0A    // Extract only the MSB of ret\0A    ret = ret >> (MBEDTLS_CT_SIZE - 1);\0A\0A    // Convert to a condition (i.e., all bits set iff non-zero)\0A    return mbedtls_ct_bool(ret);\0A#endif\0A}\0A\0Astatic inline mbedtls_ct_condition_t mbedtls_ct_uint_ne(mbedtls_ct_uint_t x, mbedtls_ct_uint_t y)\0A{\0A    /* diff = 0 if x == y, non-zero otherwise */\0A    const mbedtls_ct_uint_t diff = mbedtls_ct_compiler_opaque(x) ^ mbedtls_ct_compiler_opaque(y);\0A\0A    /* all ones if x != y, 0 otherwise */\0A    return mbedtls_ct_bool(diff);\0A}\0A\0Astatic inline unsigned char mbedtls_ct_uchar_in_range_if(unsigned char low,\0A                                                         unsigned char high,\0A                                                         unsigned char c,\0A                                                         unsigned char t)\0A{\0A    const unsigned char co = (unsigned char) mbedtls_ct_compiler_opaque(c);\0A    const unsigned char to = (unsigned char) mbedtls_ct_compiler_opaque(t);\0A\0A    /* low_mask is: 0 if low <= c, 0x...ff if low > c */\0A    unsigned low_mask = ((unsigned) co - low) >> 8;\0A    /* high_mask is: 0 if c <= high, 0x...ff if c > high */\0A    unsigned high_mask = ((unsigned) high - co) >> 8;\0A\0A    return (unsigned char) (~(low_mask | high_mask)) & to;\0A}\0A\0A/* ============================================================================\0A * Everything below here is trivial wrapper functions\0A */\0A\0Astatic inline size_t mbedtls_ct_size_if(mbedtls_ct_condition_t condition,\0A                                        size_t if1,\0A                                        size_t if0)\0A{\0A    return (size_t) mbedtls_ct_if(condition, (mbedtls_ct_uint_t) if1, (mbedtls_ct_uint_t) if0);\0A}\0A\0Astatic inline unsigned mbedtls_ct_uint_if(mbedtls_ct_condition_t condition,\0A                                          unsigned if1,\0A                                          unsigned if0)\0A{\0A    return (unsigned) mbedtls_ct_if(condition, (mbedtls_ct_uint_t) if1, (mbedtls_ct_uint_t) if0);\0A}\0A\0Astatic inline mbedtls_ct_condition_t mbedtls_ct_bool_if(mbedtls_ct_condition_t condition,\0A                                                        mbedtls_ct_condition_t if1,\0A                                                        mbedtls_ct_condition_t if0)\0A{\0A    return (mbedtls_ct_condition_t) mbedtls_ct_if(condition, (mbedtls_ct_uint_t) if1,\0A                                                  (mbedtls_ct_uint_t) if0);\0A}\0A\0A#if defined(MBEDTLS_BIGNUM_C)\0A\0Astatic inline mbedtls_mpi_uint mbedtls_ct_mpi_uint_if(mbedtls_ct_condition_t condition,\0A                                                      mbedtls_mpi_uint if1,\0A                                                      mbedtls_mpi_uint if0)\0A{\0A    return (mbedtls_mpi_uint) mbedtls_ct_if(condition,\0A                                            (mbedtls_ct_uint_t) if1,\0A                                            (mbedtls_ct_uint_t) if0);\0A}\0A\0A#endif\0A\0Astatic inline size_t mbedtls_ct_size_if_else_0(mbedtls_ct_condition_t condition, size_t if1)\0A{\0A    return (size_t) (condition & if1);\0A}\0A\0Astatic inline unsigned mbedtls_ct_uint_if_else_0(mbedtls_ct_condition_t condition, unsigned if1)\0A{\0A    return (unsigned) (condition & if1);\0A}\0A\0Astatic inline mbedtls_ct_condition_t mbedtls_ct_bool_if_else_0(mbedtls_ct_condition_t condition,\0A                                                               mbedtls_ct_condition_t if1)\0A{\0A    return (mbedtls_ct_condition_t) (condition & if1);\0A}\0A\0A#if defined(MBEDTLS_BIGNUM_C)\0A\0Astatic inline mbedtls_mpi_uint mbedtls_ct_mpi_uint_if_else_0(mbedtls_ct_condition_t condition,\0A                                                             mbedtls_mpi_uint if1)\0A{\0A    return (mbedtls_mpi_uint) (condition & if1);\0A}\0A\0A#endif /* MBEDTLS_BIGNUM_C */\0A\0Astatic inline int mbedtls_ct_error_if(mbedtls_ct_condition_t condition, int if1, int if0)\0A{\0A    /* Coverting int -> uint -> int here is safe, because we require if1 and if0 to be\0A     * in the range -32767..0, and we require 32-bit int and uint types.\0A     *\0A     * This means that (0 <= -if0 < INT_MAX), so negating if0 is safe, and similarly for\0A     * converting back to int.\0A     */\0A    return -((int) mbedtls_ct_if(condition, (mbedtls_ct_uint_t) (-if1),\0A                                 (mbedtls_ct_uint_t) (-if0)));\0A}\0A\0Astatic inline int mbedtls_ct_error_if_else_0(mbedtls_ct_condition_t condition, int if1)\0A{\0A    return -((int) (condition & (-if1)));\0A}\0A\0Astatic inline mbedtls_ct_condition_t mbedtls_ct_uint_eq(mbedtls_ct_uint_t x,\0A                                                        mbedtls_ct_uint_t y)\0A{\0A    return ~mbedtls_ct_uint_ne(x, y);\0A}\0A\0Astatic inline mbedtls_ct_condition_t mbedtls_ct_uint_gt(mbedtls_ct_uint_t x,\0A                                                        mbedtls_ct_uint_t y)\0A{\0A    return mbedtls_ct_uint_lt(y, x);\0A}\0A\0Astatic inline mbedtls_ct_condition_t mbedtls_ct_uint_ge(mbedtls_ct_uint_t x,\0A                                                        mbedtls_ct_uint_t y)\0A{\0A    return ~mbedtls_ct_uint_lt(x, y);\0A}\0A\0Astatic inline mbedtls_ct_condition_t mbedtls_ct_uint_le(mbedtls_ct_uint_t x,\0A                                                        mbedtls_ct_uint_t y)\0A{\0A    return ~mbedtls_ct_uint_gt(x, y);\0A}\0A\0Astatic inline mbedtls_ct_condition_t mbedtls_ct_bool_ne(mbedtls_ct_condition_t x,\0A                                                        mbedtls_ct_condition_t y)\0A{\0A    return (mbedtls_ct_condition_t) (x ^ y);\0A}\0A\0Astatic inline mbedtls_ct_condition_t mbedtls_ct_bool_and(mbedtls_ct_condition_t x,\0A                                                         mbedtls_ct_condition_t y)\0A{\0A    return (mbedtls_ct_condition_t) (x & y);\0A}\0A\0Astatic inline mbedtls_ct_condition_t mbedtls_ct_bool_or(mbedtls_ct_condition_t x,\0A                                                        mbedtls_ct_condition_t y)\0A{\0A    return (mbedtls_ct_condition_t) (x | y);\0A}\0A\0Astatic inline mbedtls_ct_condition_t mbedtls_ct_bool_not(mbedtls_ct_condition_t x)\0A{\0A    return (mbedtls_ct_condition_t) (~x);\0A}\0A\0A#if defined(MBEDTLS_COMPILER_IS_GCC) && (__GNUC__ > 4)\0A/* Restore warnings for -Wredundant-decls on gcc */\0A    #pragma GCC diagnostic pop\0A#endif\0A\0A#endif /* MBEDTLS_CONSTANT_TIME_IMPL_H */\0A\00" }
