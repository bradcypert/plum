@.str45652 = private global { i64, i64, [1939 x i8] } { i64 -1, i64 1938, [1939 x i8] c"/**\0A * \5Cfile platform_time.h\0A *\0A * \5Cbrief Mbed TLS Platform time abstraction\0A */\0A/*\0A *  Copyright The Mbed TLS Contributors\0A *  SPDX-License-Identifier: Apache-2.0 OR GPL-2.0-or-later\0A */\0A#ifndef MBEDTLS_PLATFORM_TIME_H\0A#define MBEDTLS_PLATFORM_TIME_H\0A\0A#include \22mbedtls/build_info.h\22\0A\0A#ifdef __cplusplus\0Aextern \22C\22 {\0A#endif\0A\0A/*\0A * The time_t datatype\0A */\0A#if defined(MBEDTLS_PLATFORM_TIME_TYPE_MACRO)\0Atypedef MBEDTLS_PLATFORM_TIME_TYPE_MACRO mbedtls_time_t;\0A#else\0A/* For time_t */\0A#include <time.h>\0Atypedef time_t mbedtls_time_t;\0A#endif /* MBEDTLS_PLATFORM_TIME_TYPE_MACRO */\0A\0A#if defined(MBEDTLS_PLATFORM_MS_TIME_TYPE_MACRO)\0Atypedef MBEDTLS_PLATFORM_MS_TIME_TYPE_MACRO mbedtls_ms_time_t;\0A#else\0A#include <stdint.h>\0A#include <inttypes.h>\0Atypedef int64_t mbedtls_ms_time_t;\0A#endif /* MBEDTLS_PLATFORM_MS_TIME_TYPE_MACRO */\0A\0A/**\0A * \5Cbrief   Get time in milliseconds.\0A *\0A * \5Creturn Monotonically-increasing current time in milliseconds.\0A *\0A * \5Cnote Define MBEDTLS_PLATFORM_MS_TIME_ALT to be able to provide an\0A *       alternative implementation\0A *\0A * \5Cwarning This function returns a monotonically-increasing time value from a\0A *          start time that will differ from platform to platform, and possibly\0A *          from run to run of the process.\0A *\0A */\0Ambedtls_ms_time_t mbedtls_ms_time(void);\0A\0A/*\0A * The function pointers for time\0A */\0A#if defined(MBEDTLS_PLATFORM_TIME_ALT)\0Aextern mbedtls_time_t (*mbedtls_time)(mbedtls_time_t *time);\0A\0A/**\0A * \5Cbrief   Set your own time function pointer\0A *\0A * \5Cparam   time_func   the time function implementation\0A *\0A * \5Creturn              0\0A */\0Aint mbedtls_platform_set_time(mbedtls_time_t (*time_func)(mbedtls_time_t *time));\0A#else\0A#if defined(MBEDTLS_PLATFORM_TIME_MACRO)\0A#define mbedtls_time    MBEDTLS_PLATFORM_TIME_MACRO\0A#else\0A#define mbedtls_time   time\0A#endif /* MBEDTLS_PLATFORM_TIME_MACRO */\0A#endif /* MBEDTLS_PLATFORM_TIME_ALT */\0A\0A#ifdef __cplusplus\0A}\0A#endif\0A\0A#endif /* platform_time.h */\0A\00" }
