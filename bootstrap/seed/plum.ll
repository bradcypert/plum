0A\0A    status = psa_reserve_free_key_slot(NULL, p_slot);\0A    if (status != PSA_SUCCESS) {\0A#if defined(MBEDTLS_THREADING_C)\0A        PSA_THREADING_CHK_RET(mbedtls_mutex_unlock(\0A                                  &mbedtls_threading_key_slot_mutex));\0A#endif\0A        return status;\0A    }\0A\0A    (*p_slot)->attr.id = key;\0A    (*p_slot)->attr.lifetime = PSA_KEY_LIFETIME_PERSISTENT;\0A\0A    status = PSA_ERROR_DOES_NOT_EXIST;\0A#if defined(MBEDTLS_PSA_CRYPTO_BUILTIN_KEYS)\0A    /* Load keys in the 'builtin' range through their own interface */\0A    status = psa_load_builtin_key_into_slot(*p_slot);\0A#endif /* MBEDTLS_PSA_CRYPTO_BUILTIN_KEYS */\0A\0A#if defined(MBEDTLS_PSA_CRYPTO_STORAGE_C)\0A    if (status == PSA_ERROR_DOES_NOT_EXIST) {\0A        status = psa_load_persistent_key_into_slot(*p_slot);\0A    }\0A#endif /* defined(MBEDTLS_PSA_CRYPTO_STORAGE_C) */\0A\0A    if (status != PSA_SUCCESS) {\0A        psa_wipe_key_slot(*p_slot);\0A\0A        /* If the key does not exist, we need to return\0A         * PSA_ERROR_INVALID_HANDLE. */\0A        if (status == PSA_ERROR_DOES_NOT_EXIST) {\0A            status = PSA_ERROR_INVALID_HANDLE;\0A        }\0A    } else {\0A        /* Add implicit usage flags. */\0A        psa_extend_key_usage_flags(&(*p_slot)->attr.policy.usage);\0A\0A        psa_key_slot_state_transition((*p_slot), PSA_SLOT_FILLING,\0A                                      PSA_SLOT_FULL);\0A        status = psa_register_read(*p_slot);\0A    }\0A\0A#else /* MBEDTLS_PSA_CRYPTO_STORAGE_C || MBEDTLS_PSA_CRYPTO_BUILTIN_KEYS */\0A    status = PSA_ERROR_INVALID_HANDLE;\0A#endif /* MBEDTLS_PSA_CRYPTO_STORAGE_C || MBEDTLS_PSA_CRYPTO_BUILTIN_KEYS */\0A\0A    if (status != PSA_SUCCESS) {\0A        *p_slot = NULL;\0A    }\0A#if defined(MBEDTLS_THREADING_C)\0A    PSA_THREADING_CHK_RET(mbedtls_mutex_unlock(\0A                              &mbedtls_threading_key_slot_mutex));\0A#endif\0A    return status;\0A}\0A\0Apsa_status_t psa_unregister_read(psa_key_slot_t *slot)\0A{\0A    if (slot == NULL) {\0A        return PSA_SUCCESS;\0A    }\0A    if ((slot->state != PSA_SLOT_FULL) &&\0A        (slot->state != PSA_SLOT_PENDING_DELETION)) {\0A        return PSA_ERROR_CORRUPTION_DETECTED;\0A    }\0A\0A    /* If we are the last reader and the slot is marked for deletion,\0A     * we must wipe the slot here. */\0A    if ((slot->state == PSA_SLOT_PENDING_DELETION) &&\0A        (slot->var.occupied.registered_readers == 1)) {\0A        return psa_wipe_key_slot(slot);\0A    }\0A\0A    if (psa_key_slot_has_readers(slot)) {\0A        slot->var.occupied.registered_readers--;\0A        return PSA_SUCCESS;\0A    }\0A\0A    /*\0A     * As the return error code may not be handled in case of multiple errors,\0A     * do our best to report if there are no registered readers. Assert with\0A     * MBEDTLS_TEST_HOOK_TEST_ASSERT that there are registered readers:\0A     * if the MBEDTLS_TEST_HOOKS configuration option is enabled and\0A     * the function is called as part of the execution of a test suite, the\0A     * execution of the test suite is stopped in error if the assertion fails.\0A     */\0A    MBEDTLS_TEST_HOOK_TEST_ASSERT(psa_key_slot_has_readers(slot));\0A    return PSA_ERROR_CORRUPTION_DETECTED;\0A}\0A\0Apsa_status_t psa_unregister_read_under_mutex(psa_key_slot_t *slot)\0A{\0A    psa_status_t status = PSA_ERROR_CORRUPTION_DETECTED;\0A#if defined(MBEDTLS_THREADING_C)\0A    /* We need to set status as success, otherwise CORRUPTION_DETECTED\0A     * would be returned if the lock fails. */\0A    status = PSA_SUCCESS;\0A    PSA_THREADING_CHK_RET(mbedtls_mutex_lock(\0A                              &mbedtls_threading_key_slot_mutex));\0A#endif\0A    status = psa_unregister_read(slot);\0A#if defined(MBEDTLS_THREADING_C)\0A    PSA_THREADING_CHK_RET(mbedtls_mutex_unlock(\0A                              &mbedtls_threading_key_slot_mutex));\0A#endif\0A    return status;\0A}\0A\0Apsa_status_t psa_validate_key_location(psa_key_lifetime_t lifetime,\0A                                       psa_se_drv_table_entry_t **p_drv)\0A{\0A    if (psa_key_lifetime_is_external(lifetime)) {\0A#if defined(MBEDTLS_PSA_CRYPTO_SE_C)\0A        /* Check whether a driver is registered against this lifetime */\0A        psa_se_drv_table_entry_t *driver = psa_get_se_driver_entry(lifetime);\0A        if (driver != NULL) {\0A            if (p_drv != NULL) {\0A                *p_drv = driver;\0A            }\0A            return PSA_SUCCESS;\0A        }\0A#else /* MBEDTLS_PSA_CRYPTO_SE_C */\0A        (void) p_drv;\0A#endif /* MBEDTLS_PSA_CRYPTO_SE_C */\0A\0A        /* Key location for external keys gets checked by the wrapper */\0A        return PSA_SUCCESS;\0A    } else {\0A        /* Local/internal keys are always valid */\0A        return PSA_SUCCESS;\0A    }\0A}\0A\0Apsa_status_t psa_validate_key_persistence(psa_key_lifetime_t lifetime)\0A{\0A    if (PSA_KEY_LIFETIME_IS_VOLATILE(lifetime)) {\0A        /* Volatile keys are always supported */\0A        return PSA_SUCCESS;\0A    } else {\0A        /* Persistent keys require storage support */\0A#if defined(MBEDTLS_PSA_CRYPTO_STORAGE_C)\0A        if (PSA_KEY_LIFETIME_IS_READ_ONLY(lifetime)) {\0A            return PSA_ERROR_INVALID_ARGUMENT;\0A        } else {\0A            return PSA_SUCCESS;\0A        }\0A#else /* MBEDTLS_PSA_CRYPTO_STORAGE_C */\0A        return PSA_ERROR_NOT_SUPPORTED;\0A#endif /* !MBEDTLS_PSA_CRYPTO_STORAGE_C */\0A    }\0A}\0A\0Apsa_status_t psa_open_key(mbedtls_svc_key_id_t key, psa_key_handle_t *handle)\0A{\0A#if defined(MBEDTLS_PSA_CRYPTO_STORAGE_C) || \5C\0A    defined(MBEDTLS_PSA_CRYPTO_BUILTIN_KEYS)\0A    psa_status_t status;\0A    psa_key_slot_t *slot;\0A\0A    status = psa_get_and_lock_key_slot(key, &slot);\0A    if (status != PSA_SUCCESS) {\0A        *handle = PSA_KEY_HANDLE_INIT;\0A        if (status == PSA_ERROR_INVALID_HANDLE) {\0A            status = PSA_ERROR_DOES_NOT_EXIST;\0A        }\0A\0A        return status;\0A    }\0A\0A    *handle = key;\0A\0A    return psa_unregister_read_under_mutex(slot);\0A\0A#else /* MBEDTLS_PSA_CRYPTO_STORAGE_C || MBEDTLS_PSA_CRYPTO_BUILTIN_KEYS */\0A    (void) key;\0A    *handle = PSA_KEY_HANDLE_INIT;\0A    return PSA_ERROR_NOT_SUPPORTED;\0A#endif /* MBEDTLS_PSA_CRYPTO_STORAGE_C || MBEDTLS_PSA_CRYPTO_BUILTIN_KEYS */\0A}\0A\0Apsa_status_t psa_close_key(psa_key_handle_t handle)\0A{\0A    psa_status_t status = PSA_ERROR_CORRUPTION_DETECTED;\0A    psa_key_slot_t *slot;\0A\0A    if (psa_key_handle_is_null(handle)) {\0A        return PSA_SUCCESS;\0A    }\0A\0A#if defined(MBEDTLS_THREADING_C)\0A    /* We need to set status as success, otherwise CORRUPTION_DETECTED\0A     * would be returned if the lock fails. */\0A    status = PSA_SUCCESS;\0A    PSA_THREADING_CHK_RET(mbedtls_mutex_lock(\0A                              &mbedtls_threading_key_slot_mutex));\0A#endif\0A    status = psa_get_and_lock_key_slot_in_memory(handle, &slot);\0A    if (status != PSA_SUCCESS) {\0A        if (status == PSA_ERROR_DOES_NOT_EXIST) {\0A            status = PSA_ERROR_INVALID_HANDLE;\0A        }\0A#if defined(MBEDTLS_THREADING_C)\0A        PSA_THREADING_CHK_RET(mbedtls_mutex_unlock(\0A                                  &mbedtls_threading_key_slot_mutex));\0A#endif\0A        return status;\0A    }\0A\0A    if (slot->var.occupied.registered_readers == 1) {\0A        status = psa_wipe_key_slot(slot);\0A    } else {\0A        status = psa_unregister_read(slot);\0A    }\0A#if defined(MBEDTLS_THREADING_C)\0A    PSA_THREADING_CHK_RET(mbedtls_mutex_unlock(\0A                              &mbedtls_threading_key_slot_mutex));\0A#endif\0A\0A    return status;\0A}\0A\0Apsa_status_t psa_purge_key(mbedtls_svc_key_id_t key)\0A{\0A    psa_status_t status = PSA_ERROR_CORRUPTION_DETECTED;\0A    psa_key_slot_t *slot;\0A\0A#if defined(MBEDTLS_THREADING_C)\0A    /* We need to set status as success, otherwise CORRUPTION_DETECTED\0A     * would be returned if the lock fails. */\0A    status = PSA_SUCCESS;\0A    PSA_THREADING_CHK_RET(mbedtls_mutex_lock(\0A                              &mbedtls_threading_key_slot_mutex));\0A#endif\0A    status = psa_get_and_lock_key_slot_in_memory(key, &slot);\0A    if (status != PSA_SUCCESS) {\0A#if defined(MBEDTLS_THREADING_C)\0A        PSA_THREADING_CHK_RET(mbedtls_mutex_unlock(\0A                                  &mbedtls_threading_key_slot_mutex));\0A#endif\0A        return status;\0A    }\0A\0A    if ((!PSA_KEY_LIFETIME_IS_VOLATILE(slot->attr.lifetime)) &&\0A        (slot->var.occupied.registered_readers == 1)) {\0A        status = psa_wipe_key_slot(slot);\0A    } else {\0A        status = psa_unregister_read(slot);\0A    }\0A#if defined(MBEDTLS_THREADING_C)\0A    PSA_THREADING_CHK_RET(mbedtls_mutex_unlock(\0A                              &mbedtls_threading_key_slot_mutex));\0A#endif\0A\0A    return status;\0A}\0A\0Avoid mbedtls_psa_get_stats(mbedtls_psa_stats_t *stats)\0A{\0A    memset(stats, 0, sizeof(*stats));\0A\0A    for (size_t slice_idx = 0; slice_idx < KEY_SLICE_COUNT; slice_idx++) {\0A#if defined(MBEDTLS_PSA_KEY_STORE_DYNAMIC)\0A        if (global_data.key_slices[slice_idx] == NULL) {\0A            continue;\0A        }\0A#endif  /* MBEDTLS_PSA_KEY_STORE_DYNAMIC */\0A        for (size_t slot_idx = 0; slot_idx < key_slice_length(slice_idx); slot_idx++) {\0A            const psa_key_slot_t *slot = get_key_slot(slice_idx, slot_idx);\0A            if (slot->state == PSA_SLOT_EMPTY) {\0A                ++stats->empty_slots;\0A                continue;\0A            }\0A            if (psa_key_slot_has_readers(slot)) {\0A                ++stats->locked_slots;\0A            }\0A            if (PSA_KEY_LIFETIME_IS_VOLATILE(slot->attr.lifetime)) {\0A                ++stats->volatile_slots;\0A            } else {\0A                psa_key_id_t id = MBEDTLS_SVC_KEY_ID_GET_KEY_ID(slot->attr.id);\0A                ++stats->persistent_slots;\0A                if (id > stats->max_open_internal_key_id) {\0A                    stats->max_open_internal_key_id = id;\0A                }\0A            }\0A            if (PSA_KEY_LIFETIME_GET_LOCATION(slot->attr.lifetime) !=\0A                PSA_KEY_LOCATION_LOCAL_STORAGE) {\0A                psa_key_id_t id = MBEDTLS_SVC_KEY_ID_GET_KEY_ID(slot->attr.id);\0A                ++stats->external_slots;\0A                if (id > stats->max_open_external_key_id) {\0A                    stats->max_open_external_key_id = id;\0A                }\0A            }\0A        }\0A    }\0A}\0A\0A#endif /* MBEDTLS_PSA_CRYPTO_C */\0A\00" }
