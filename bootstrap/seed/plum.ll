s versions of TLS.\0A */\0Atypedef enum {\0A    MBEDTLS_SSL_TLS_PRF_NONE,\0A    MBEDTLS_SSL_TLS_PRF_SHA384,\0A    MBEDTLS_SSL_TLS_PRF_SHA256,\0A    MBEDTLS_SSL_HKDF_EXPAND_SHA384,\0A    MBEDTLS_SSL_HKDF_EXPAND_SHA256\0A}\0Ambedtls_tls_prf_types;\0A\0Atypedef enum {\0A    MBEDTLS_SSL_KEY_EXPORT_TLS12_MASTER_SECRET = 0,\0A#if defined(MBEDTLS_SSL_PROTO_TLS1_3)\0A    MBEDTLS_SSL_KEY_EXPORT_TLS1_3_CLIENT_EARLY_SECRET,\0A    MBEDTLS_SSL_KEY_EXPORT_TLS1_3_EARLY_EXPORTER_SECRET,\0A    MBEDTLS_SSL_KEY_EXPORT_TLS1_3_CLIENT_HANDSHAKE_TRAFFIC_SECRET,\0A    MBEDTLS_SSL_KEY_EXPORT_TLS1_3_SERVER_HANDSHAKE_TRAFFIC_SECRET,\0A    MBEDTLS_SSL_KEY_EXPORT_TLS1_3_CLIENT_APPLICATION_TRAFFIC_SECRET,\0A    MBEDTLS_SSL_KEY_EXPORT_TLS1_3_SERVER_APPLICATION_TRAFFIC_SECRET,\0A#endif /* MBEDTLS_SSL_PROTO_TLS1_3 */\0A} mbedtls_ssl_key_export_type;\0A\0A/**\0A * \5Cbrief           Callback type: Export key alongside random values for\0A *                                 session identification, and PRF for\0A *                                 implementation of TLS key exporters.\0A *\0A * \5Cparam p_expkey   Context for the callback.\0A * \5Cparam type       The type of the key that is being exported.\0A * \5Cparam secret     The address of the buffer holding the secret\0A *                   that's being exporterd.\0A * \5Cparam secret_len The length of \5Cp secret in bytes.\0A * \5Cparam client_random The client random bytes.\0A * \5Cparam server_random The server random bytes.\0A * \5Cparam tls_prf_type The identifier for the PRF used in the handshake\0A *                     to which the key belongs.\0A */\0Atypedef void mbedtls_ssl_export_keys_t(void *p_expkey,\0A                                       mbedtls_ssl_key_export_type type,\0A                                       const unsigned char *secret,\0A                                       size_t secret_len,\0A                                       const unsigned char client_random[32],\0A                                       const unsigned char server_random[32],\0A                                       mbedtls_tls_prf_types tls_prf_type);\0A\0A#if defined(MBEDTLS_SSL_SRV_C)\0A/**\0A * \5Cbrief           Callback type: generic handshake callback\0A *\0A * \5Cnote            Callbacks may use user_data funcs to set/get app user data.\0A *                  See \5Cc mbedtls_ssl_get_user_data_p()\0A *                      \5Cc mbedtls_ssl_get_user_data_n()\0A *                      \5Cc mbedtls_ssl_conf_get_user_data_p()\0A *                      \5Cc mbedtls_ssl_conf_get_user_data_n()\0A *\0A * \5Cparam ssl       \5Cc mbedtls_ssl_context on which the callback is run\0A *\0A * \5Creturn          The return value of the callback is 0 if successful,\0A *                  or a specific MBEDTLS_ERR_XXX code, which will cause\0A *                  the handshake to be aborted.\0A */\0Atypedef int (*mbedtls_ssl_hs_cb_t)(mbedtls_ssl_context *ssl);\0A#endif\0A\0A/* A type for storing user data in a library structure.\0A *\0A * The representation of type may change in future versions of the library.\0A * Only the behaviors guaranteed by documented accessor functions are\0A * guaranteed to remain stable.\0A */\0Atypedef union {\0A    uintptr_t n;                /* typically a handle to an associated object */\0A    void *p;                    /* typically a pointer to extra data */\0A} mbedtls_ssl_user_data_t;\0A\0A/**\0A * SSL/TLS configuration to be shared between mbedtls_ssl_context structures.\0A */\0Astruct mbedtls_ssl_config {\0A    /* Group items mostly by size. This helps to reduce memory wasted to\0A     * padding. It also helps to keep smaller fields early in the structure,\0A     * so that elements tend to be in the 128-element direct access window\0A     * on Arm Thumb, which reduces the code size. */\0A\0A    mbedtls_ssl_protocol_version MBEDTLS_PRIVATE(max_tls_version);  /*!< max. TLS version used */\0A    mbedtls_ssl_protocol_version MBEDTLS_PRIVATE(min_tls_version);  /*!< min. TLS version used */\