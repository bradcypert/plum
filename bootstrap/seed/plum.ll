@.str45505 = private global { i64, i64, [4598 x i8] } { i64 -1, i64 4597, [4598 x i8] c"/**\0A * \5Cfile aesce.h\0A *\0A * \5Cbrief Support hardware AES acceleration on Armv8-A processors with\0A *        the Armv8-A Cryptographic Extension.\0A *\0A * \5Cwarning These functions are only for internal use by other library\0A *          functions; you must not call them directly.\0A */\0A/*\0A *  Copyright The Mbed TLS Contributors\0A *  SPDX-License-Identifier: Apache-2.0 OR GPL-2.0-or-later\0A */\0A#ifndef MBEDTLS_AESCE_H\0A#define MBEDTLS_AESCE_H\0A\0A#include \22mbedtls/build_info.h\22\0A#include \22common.h\22\0A\0A#include \22mbedtls/aes.h\22\0A\0A\0A#if defined(MBEDTLS_AESCE_C) \5C\0A    && defined(MBEDTLS_ARCH_IS_ARMV8_A) && defined(MBEDTLS_HAVE_NEON_INTRINSICS) \5C\0A    && (defined(MBEDTLS_COMPILER_IS_GCC) || defined(__clang__) || defined(MSC_VER))\0A\0A/* MBEDTLS_AESCE_HAVE_CODE is defined if we have a suitable target platform, and a\0A * potentially suitable compiler (compiler version & flags are not checked when defining\0A * this). */\0A#define MBEDTLS_AESCE_HAVE_CODE\0A\0A#ifdef __cplusplus\0Aextern \22C\22 {\0A#endif\0A\0A#if defined(__linux__) && !defined(MBEDTLS_AES_USE_HARDWARE_ONLY)\0A\0Aextern signed char mbedtls_aesce_has_support_result;\0A\0A/**\0A * \5Cbrief          Internal function to detect the crypto extension in CPUs.\0A *\0A * \5Creturn         1 if CPU has support for the feature, 0 otherwise\0A */\0Aint mbedtls_aesce_has_support_impl(void);\0A\0A#define MBEDTLS_AESCE_HAS_SUPPORT() (mbedtls_aesce_has_support_result == -1 ? \5C\0A                                     mbedtls_aesce_has_support_impl() : \5C\0A                                     mbedtls_aesce_has_support_result)\0A\0A#else /* defined(__linux__) && !defined(MBEDTLS_AES_USE_HARDWARE_ONLY) */\0A\0A/* If we are not on Linux, we can't detect support so assume that it's supported.\0A * Similarly, assume support if MBEDTLS_AES_USE_HARDWARE_ONLY is set.\0A */\0A#define MBEDTLS_AESCE_HAS_SUPPORT() 1\0A\0A#endif /* defined(__linux__) && !defined(MBEDTLS_AES_USE_HARDWARE_ONLY) */\0A\0A/**\0A * \5Cbrief          Internal AES-ECB block encryption and decryption\0A *\0A * \5Cwarning        This assumes that the context specifies either 10, 12 or 14\0A *                 rounds and will behave incorrectly if this is not the case.\0A *\0A * \5Cparam ctx      AES context\0A * \5Cparam mode     MBEDTLS_AES_ENCRYPT or MBEDTLS_AES_DECRYPT\0A * \5Cparam input    16-byte input block\0A * \5Cparam output   16-byte output block\0A *\0A * \5Creturn         0 on success (cannot fail)\0A */\0Aint mbedtls_aesce_crypt_ecb(mbedtls_aes_context *ctx,\0A                            int mode,\0A                            const unsigned char input[16],\0A                            unsigned char output[16]);\0A\0A/**\0A * \5Cbrief          Internal GCM multiplication: c = a * b in GF(2^128)\0A *\0A * \5Cnote           This function is only for internal use by other library\0A *                 functions; you must not call it directly.\0A *\0A * \5Cparam c        Result\0A * \5Cparam a        First operand\0A * \5Cparam b        Second operand\0A *\0A * \5Cnote           Both operands and result are bit strings interpreted as\0A *                 elements of GF(2^128) as per the GCM spec.\0A */\0Avoid mbedtls_aesce_gcm_mult(unsigned char c[16],\0A                            const unsigned char a[16],\0A                            const unsigned char b[16]);\0A\0A\0A#if !defined(MBEDTLS_BLOCK_CIPHER_NO_DECRYPT)\0A/**\0A * \5Cbrief           Internal round key inversion. This function computes\0A *                  decryption round keys from the encryption round keys.\0A *\0A * \5Cparam invkey    Round keys for the equivalent inverse cipher\0A * \5Cparam fwdkey    Original round keys (for encryption)\0A * \5Cparam nr        Number of rounds (that is, number of round keys minus one)\0A */\0Avoid mbedtls_aesce_inverse_key(unsigned char *invkey,\0A                               const unsigned char *fwdkey,\0A                               int nr);\0A#endif /* !MBEDTLS_BLOCK_CIPHER_NO_DECRYPT */\0A\0A/**\0A * \5Cbrief           Internal key expansion for encryption\0A *\0A * \5Cparam rk        Destination buffer where the round keys are written\0A * \5Cparam key       Encryption key\0A * \5Cparam bits      Key size in bits (must be 128, 192 or 256)\0A *\0A * \5Creturn          0 if successful, or MBEDTLS_ERR_AES_INVALID_KEY_LENGTH\0A */\0Aint mbedtls_aesce_setkey_enc(unsigned char *rk,\0A                             const unsigned char *key,\0A                             size_t bits);\0A\0A#ifdef __cplusplus\0A}\0A#endif\0A\0A#else\0A\0A#if defined(MBEDTLS_AES_USE_HARDWARE_ONLY) && defined(MBEDTLS_ARCH_IS_ARMV8_A)\0A#error \22AES hardware acceleration not supported on this platform / compiler\22\0A#endif\0A\0A#endif /* MBEDTLS_AESCE_C && MBEDTLS_ARCH_IS_ARMV8_A && MBEDTLS_HAVE_NEON_INTRINSICS &&\0A          (MBEDTLS_COMPILER_IS_GCC || __clang__ || MSC_VER) */\0A\0A#endif /* MBEDTLS_AESCE_H */\0A\00" }
