0A                                        void *p_vrfy,\0A                                        mbedtls_x509_crt_restart_ctx *rs_ctx)\0A{\0A    return x509_crt_verify_restartable_ca_cb(crt, trust_ca, ca_crl,\0A                                             NULL, NULL,\0A                                             profile, cn, flags,\0A                                             f_vrfy, p_vrfy, rs_ctx);\0A}\0A\0A\0A/*\0A * Initialize a certificate chain\0A */\0Avoid mbedtls_x509_crt_init(mbedtls_x509_crt *crt)\0A{\0A    memset(crt, 0, sizeof(mbedtls_x509_crt));\0A}\0A\0A/*\0A * Unallocate all certificate data\0A */\0Avoid mbedtls_x509_crt_free(mbedtls_x509_crt *crt)\0A{\0A    mbedtls_x509_crt *cert_cur = crt;\0A    mbedtls_x509_crt *cert_prv;\0A\0A    while (cert_cur != NULL) {\0A        mbedtls_pk_free(&cert_cur->pk);\0A\0A#if defined(MBEDTLS_X509_RSASSA_PSS_SUPPORT)\0A        mbedtls_free(cert_cur->sig_opts);\0A#endif\0A\0A        mbedtls_asn1_free_named_data_list_shallow(cert_cur->issuer.next);\0A        mbedtls_asn1_free_named_data_list_shallow(cert_cur->subject.next);\0A        mbedtls_asn1_sequence_free(cert_cur->ext_key_usage.next);\0A        mbedtls_asn1_sequence_free(cert_cur->subject_alt_names.next);\0A        mbedtls_asn1_sequence_free(cert_cur->certificate_policies.next);\0A        mbedtls_asn1_sequence_free(cert_cur->authority_key_id.authorityCertIssuer.next);\0A\0A        if (cert_cur->raw.p != NULL && cert_cur->own_buffer) {\0A            mbedtls_zeroize_and_free(cert_cur->raw.p, cert_cur->raw.len);\0A        }\0A\0A        cert_prv = cert_cur;\0A        cert_cur = cert_cur->next;\0A\0A        mbedtls_platform_zeroize(cert_prv, sizeof(mbedtls_x509_crt));\0A        if (cert_prv != crt) {\0A            mbedtls_free(cert_prv);\0A        }\0A    }\0A}\0A\0A#if defined(MBEDTLS_ECDSA_C) && defined(MBEDTLS_ECP_RESTARTABLE)\0A/*\0A * Initialize a restart context\0A */\0Avoid mbedtls_x509_crt_restart_init(mbedtls_x509_crt_restart_ctx *ctx)\0A{\0A    mbedtls_pk_restart_init(&ctx->pk);\0A\0A    ctx->parent = NULL;\0A    ctx->fallback_parent = NULL;\0A    ctx->fallback_signature_is_good = 0;\0A\0A    ctx->parent_is_trusted = -1;\0A\0A    ctx->in_progress = x509_crt_rs_none;\0A    ctx->self_cnt = 0;\0A    x509_crt_verify_chain_reset(&ctx->ver_chain);\0A}\0A\0A/*\0A * Free the components of a restart context\0A */\0Avoid mbedtls_x509_crt_restart_free(mbedtls_x509_crt_restart_ctx *ctx)\0A{\0A    if (ctx == NULL) {\0A        return;\0A    }\0A\0A    mbedtls_pk_restart_free(&ctx->pk);\0A    mbedtls_x509_crt_restart_init(ctx);\0A}\0A#endif /* MBEDTLS_ECDSA_C && MBEDTLS_ECP_RESTARTABLE */\0A\0Aint mbedtls_x509_crt_get_ca_istrue(const mbedtls_x509_crt *crt)\0A{\0A    if ((crt->ext_types & MBEDTLS_X509_EXT_BASIC_CONSTRAINTS) != 0) {\0A        return crt->MBEDTLS_PRIVATE(ca_istrue);\0A    }\0A    return MBEDTLS_ERR_X509_INVALID_EXTENSIONS;\0A}\0A\0A#endif /* MBEDTLS_X509_CRT_PARSE_C */\0A\00" }
