@.str41009 = private global { i64, i64, [3401 x i8] } { i64 -1, i64 3400, [3401 x i8] c"/**\0A * \5Cfile block_cipher_internal.h\0A *\0A * \5Cbrief Lightweight abstraction layer for block ciphers with 128 bit blocks,\0A * for use by the GCM and CCM modules.\0A */\0A/*\0A *  Copyright The Mbed TLS Contributors\0A *  SPDX-License-Identifier: Apache-2.0 OR GPL-2.0-or-later\0A */\0A#ifndef MBEDTLS_BLOCK_CIPHER_INTERNAL_H\0A#define MBEDTLS_BLOCK_CIPHER_INTERNAL_H\0A\0A#include \22mbedtls/build_info.h\22\0A\0A#include \22mbedtls/cipher.h\22\0A\0A#include \22mbedtls/block_cipher.h\22\0A\0A#ifdef __cplusplus\0Aextern \22C\22 {\0A#endif\0A\0A/**\0A * \5Cbrief           Initialize the context.\0A *                  This must be the first API call before using the context.\0A *\0A * \5Cparam ctx       The context to initialize.\0A */\0Astatic inline void mbedtls_block_cipher_init(mbedtls_block_cipher_context_t *ctx)\0A{\0A    memset(ctx, 0, sizeof(*ctx));\0A}\0A\0A/**\0A * \5Cbrief           Set the block cipher to use with this context.\0A *                  This must be called after mbedtls_block_cipher_init().\0A *\0A * \5Cparam ctx       The context to set up.\0A * \5Cparam cipher_id The identifier of the cipher to use.\0A *                  This must be either AES, ARIA or Camellia.\0A *                  Warning: this is a ::mbedtls_cipher_id_t,\0A *                  not a ::mbedtls_block_cipher_id_t!\0A *\0A * \5Cretval          \5Cc 0 on success.\0A * \5Cretval          #MBEDTLS_ERR_CIPHER_BAD_INPUT_DATA if \5Cp cipher_id was\0A *                  invalid.\0A */\0Aint mbedtls_block_cipher_setup(mbedtls_block_cipher_context_t *ctx,\0A                               mbedtls_cipher_id_t cipher_id);\0A\0A/**\0A * \5Cbrief           Set the key into the context.\0A *\0A * \5Cparam ctx       The context to configure.\0A * \5Cparam key       The buffer holding the key material.\0A * \5Cparam key_bitlen    The size of the key in bits.\0A *\0A * \5Cretval          \5Cc 0 on success.\0A * \5Cretval          #MBEDTLS_ERR_CIPHER_INVALID_CONTEXT if the context was not\0A *                  properly set up before calling this function.\0A * \5Cretval          One of #MBEDTLS_ERR_AES_INVALID_KEY_LENGTH,\0A *                  #MBEDTLS_ERR_ARIA_BAD_INPUT_DATA,\0A *                  #MBEDTLS_ERR_CAMELLIA_BAD_INPUT_DATA if \5Cp key_bitlen is\0A *                  invalid.\0A */\0Aint mbedtls_block_cipher_setkey(mbedtls_block_cipher_context_t *ctx,\0A                                const unsigned char *key,\0A                                unsigned key_bitlen);\0A\0A/**\0A * \5Cbrief           Encrypt one block (16 bytes) with the configured key.\0A *\0A * \5Cparam ctx       The context holding the key.\0A * \5Cparam input     The buffer holding the input block. Must be 16 bytes.\0A * \5Cparam output    The buffer to which the output block will be written.\0A *                  Must be writable and 16 bytes long.\0A *                  This must either not overlap with \5Cp input, or be equal.\0A *\0A * \5Cretval          \5Cc 0 on success.\0A * \5Cretval          #MBEDTLS_ERR_CIPHER_INVALID_CONTEXT if the context was not\0A *                  properly set up before calling this function.\0A * \5Cretval          Another negative value if encryption failed.\0A */\0Aint mbedtls_block_cipher_encrypt(mbedtls_block_cipher_context_t *ctx,\0A                                 const unsigned char input[16],\0A                                 unsigned char output[16]);\0A/**\0A * \5Cbrief           Clear the context.\0A *\0A * \5Cparam ctx       The context to clear.\0A */\0Avoid mbedtls_block_cipher_free(mbedtls_block_cipher_context_t *ctx);\0A\0A#ifdef __cplusplus\0A}\0A#endif\0A\0A#endif /* MBEDTLS_BLOCK_CIPHER_INTERNAL_H */\0A\00" }
