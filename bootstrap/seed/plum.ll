onst size_t plen_test_data[MAX_TESTS] =\0A{ 8, 8, 8, 24, 9 };\0A\0Astatic const unsigned char password_test_data[MAX_TESTS][32] =\0A{\0A    \22password\22,\0A    \22password\22,\0A    \22password\22,\0A    \22passwordPASSWORDpassword\22,\0A    \22pass\5C0word\22,\0A};\0A\0Astatic const size_t slen_test_data[MAX_TESTS] =\0A{ 4, 4, 4, 36, 5 };\0A\0Astatic const unsigned char salt_test_data[MAX_TESTS][40] =\0A{\0A    \22salt\22,\0A    \22salt\22,\0A    \22salt\22,\0A    \22saltSALTsaltSALTsaltSALTsaltSALTsalt\22,\0A    \22sa\5C0lt\22,\0A};\0A\0Astatic const uint32_t it_cnt_test_data[MAX_TESTS] =\0A{ 1, 2, 4096, 4096, 4096 };\0A\0Astatic const uint32_t key_len_test_data[MAX_TESTS] =\0A{ 20, 20, 20, 25, 16 };\0A\0Astatic const unsigned char result_key_test_data[MAX_TESTS][32] =\0A{\0A    { 0x0c, 0x60, 0xc8, 0x0f, 0x96, 0x1f, 0x0e, 0x71,\0A      0xf3, 0xa9, 0xb5, 0x24, 0xaf, 0x60, 0x12, 0x06,\0A      0x2f, 0xe0, 0x37, 0xa6 },\0A    { 0xea, 0x6c, 0x01, 0x4d, 0xc7, 0x2d, 0x6f, 0x8c,\0A      0xcd, 0x1e, 0xd9, 0x2a, 0xce, 0x1d, 0x41, 0xf0,\0A      0xd8, 0xde, 0x89, 0x57 },\0A    { 0x4b, 0x00, 0x79, 0x01, 0xb7, 0x65, 0x48, 0x9a,\0A      0xbe, 0xad, 0x49, 0xd9, 0x26, 0xf7, 0x21, 0xd0,\0A      0x65, 0xa4, 0x29, 0xc1 },\0A    { 0x3d, 0x2e, 0xec, 0x4f, 0xe4, 0x1c, 0x84, 0x9b,\0A      0x80, 0xc8, 0xd8, 0x36, 0x62, 0xc0, 0xe4, 0x4a,\0A      0x8b, 0x29, 0x1a, 0x96, 0x4c, 0xf2, 0xf0, 0x70,\0A      0x38 },\0A    { 0x56, 0xfa, 0x6a, 0xa7, 0x55, 0x48, 0x09, 0x9d,\0A      0xcc, 0x37, 0xd7, 0xf0, 0x34, 0x25, 0xe0, 0xc3 },\0A};\0A\0Aint mbedtls_pkcs5_self_test(int verbose)\0A{\0A    int ret, i;\0A    unsigned char key[64];\0A\0A    for (i = 0; i < MAX_TESTS; i++) {\0A        if (verbose != 0) {\0A            mbedtls_printf(\22  PBKDF2 (SHA1) #%d: \22, i);\0A        }\0A\0A        ret = mbedtls_pkcs5_pbkdf2_hmac_ext(MBEDTLS_MD_SHA1, password_test_data[i],\0A                                            plen_test_data[i], salt_test_data[i],\0A                                            slen_tes