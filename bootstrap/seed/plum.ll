LL }\0A};\0A#undef X509_CRT_ERROR_INFO\0A\0Aint mbedtls_x509_crt_verify_info(char *buf, size_t size, const char *prefix,\0A                                 uint32_t flags)\0A{\0A    int ret = MBEDTLS_ERR_ERROR_CORRUPTION_DETECTED;\0A    const struct x509_crt_verify_string *cur;\0A    char *p = buf;\0A    size_t n = size;\0A\0A    for (cur = x509_crt_verify_strings; cur->string != NULL; cur++) {\0A        if ((flags & cur->code) == 0) {\0A            continue;\0A        }\0A\0A        ret = mbedtls_snprintf(p, n, \22%s%s\5Cn\22, prefix, cur->string);\0A        MBEDTLS_X509_SAFE_SNPRINTF;\0A        flags ^= cur->code;\0A    }\0A\0A    if (flags != 0) {\0A        ret = mbedtls_snprintf(p, n, \22%sUnknown reason \22\0A                                     \22(this should not happen)\5Cn\22, prefix);\0A        MBEDTLS_X509_SAFE_SNPRINTF;\0A    }\0A\0A    return (int) (size - n);\0A}\0A#endif /* MBEDTLS_X509_REMOVE_INFO */\0A\0Aint mbedtls_x509_crt_check_key_usage(const mbedtls_x509_crt *crt,\0A                                     unsigned int usage)\0A{\0A    unsigned int usage_must, usage_may;\0A    unsigned int may_mask = MBEDTLS_X509_KU_ENCIPHER_ONLY\0A                            | MBEDTLS_X509_KU_DECIPHER_ONLY;\0A\0A    if ((crt->ext_types & MBEDTLS_X509_EXT_KEY_USAGE) == 0) {\0A        return 0;\0A    }\0A\0A    usage_must = usage & ~may_mask;\0A\0A    if (((crt->key_usage & ~may_mask) & usage_must) != usage_must) {\0A        return MBEDTLS_ERR_X509_BAD_INPUT_DATA;\0A    }\0A\0A    usage_may = usage & may_mask;\0A\0A    if (((crt->key_usage & may_mask) | usage_may) != usage_may) {\0A        return MBEDTLS_ERR_X509_BAD_INPUT_DATA;\0A    }\0A\0A    return 0;\0A}\0A\0Aint mbedtls_x509_crt_check_extended_key_usage(const mbedtls_x509_crt *crt,\0A                                              const char *usage_oid,\0A                                              size_t usage_len)\0A{\0A    const mbedtls_x509_sequence *cur;\0A\0A    /* Extension is not mandatory, absent mean