priate X.509 verification function\0A     */\0A    int (*f_vrfy)(void *, mbedtls_x509_crt *, int, uint32_t *);\0A    void *p_vrfy;\0A    if (ssl->f_vrfy != NULL) {\0A        MBEDTLS_SSL_DEBUG_MSG(3, (\22Use context-specific verification callback\22));\0A        f_vrfy = ssl->f_vrfy;\0A        p_vrfy = ssl->p_vrfy;\0A    } else {\0A        MBEDTLS_SSL_DEBUG_MSG(3, (\22Use configuration-specific verification callback\22));\0A        f_vrfy = ssl->conf->f_vrfy;\0A        p_vrfy = ssl->conf->p_vrfy;\0A    }\0A\0A    const char *hostname = \22\22;\0A    int ret = get_hostname_for_verification(ssl, &hostname);\0A    if (ret != 0) {\0A        MBEDTLS_SSL_DEBUG_RET(1, \22get_hostname_for_verification\22, ret);\0A        return ret;\0A    }\0A\0A    int have_ca_chain_or_callback = 0;\0A#if defined(MBEDTLS_X509_TRUSTED_CERTIFICATE_CALLBACK)\0A    if (ssl->conf->f_ca_cb != NULL) {\0A        ((void) rs_ctx);\0A        have_ca_chain_or_callback = 1;\0A\0A        MBEDTLS_SSL_DEBUG_MSG(3, (\22use CA callback for X.509 CRT verification\22));\0A        ret = mbedtls_x509_crt_verify_with_ca_cb(\0A            chain,\0A            ssl->conf->f_ca_cb,\0A            ssl->conf->p_ca_cb,\0A            ssl->conf->cert_profile,\0A            hostname,\0A            &ssl->session_negotiate->verify_result,\0A            f_vrfy, p_vrfy);\0A    } else\0A#endif /* MBEDTLS_X509_TRUSTED_CERTIFICATE_CALLBACK */\0A    {\0A        mbedtls_x509_crt *ca_chain;\0A        mbedtls_x509_crl *ca_crl;\0A#if defined(MBEDTLS_SSL_SERVER_NAME_INDICATION)\0A        if (ssl->handshake->sni_ca_chain != NULL) {\0A            ca_chain = ssl->handshake->sni_ca_chain;\0A            ca_crl   = ssl->handshake->sni_ca_crl;\0A        } else\0A#endif\0A        {\0A            ca_chain = ssl->conf->ca_chain;\0A            ca_crl   = ssl->conf->ca_crl;\0A        }\0A\0A        if (ca_chain != NULL) {\0A            have_ca_chain_or_callback = 1;\0A        }\0A\0A        ret = mbedtls_x509_crt_verify_restartable(\0A            chain,\0A            ca_chain, ca_crl,\0A            ssl->conf->cert_profile,\0A            hostname,\0A            &ssl->session_negotiate->verify_result,\0A            f_vrfy, p_vrfy, rs_ctx);\0A    }\0A\0A    if (ret != 0) {\0A        MBEDTLS_SSL_DEBUG_RET(1, \22x509_verify_cert\22, ret);\0A    }\0A\0A#if defined(MBEDTLS_SSL_ECP_RESTARTABLE_ENABLED)\0A    if (ret == MBEDTLS_ERR_ECP_IN_PROGRESS) {\0A        return MBEDTLS_ERR_SSL_CRYPTO_IN_PROGRESS;\0A    }\0A#endif\0A\0A    /*\0A     * Secondary checks: always done, but change 'ret' only if it was 0\0A     */\0A\0A    /* With TLS 1.2 and ECC certs, check that the curve used by the\0A     * certificate is on our list of acceptable curves.\0A     *\0A     * With TLS 1.3 this is not needed because the curve is part of the\0A     * signature algorithm (eg ecdsa_secp256r1_sha256) which is checked when\0A     * we validate the signature made with the key associated to this cert.\0A     */\0A#if defined(MBEDTLS_SSL_PROTO_TLS1_2) && \5C\0A    defined(MBEDTLS_PK_HAVE_ECC_KEYS)\0A    if (ssl->tls_version == MBEDTLS_SSL_VERSION_TLS1_2 &&\0A        mbedtls_pk_can_do(&chain->pk, MBEDTLS_PK_ECKEY)) {\0A        if (mbedtls_ssl_check_curve(ssl, mbedtls_pk_get_ec_group_id(&chain->pk)) != 0) {\0A            MBEDTLS_SSL_DEBUG_MSG(1, (\22bad certificate (EC key curve)\22));\0A            ssl->session_negotiate->verify_result |= MBEDTLS_X509_BADCERT_BAD_KEY;\0A            if (ret == 0) {\0A                ret = MBEDTLS_ERR_SSL_BAD_CERTIFICATE;\0A            }\0A        }\0A    }\0A#endif /* MBEDTLS_SSL_PROTO_TLS1_2 && MBEDTLS_PK_HAVE_ECC_KEYS */\0A\0A    /* Check X.509 usage extensions (keyUsage, extKeyUsage) */\0A    if (mbedtls_ssl_check_cert_usage(chain,\0A                                     ciphersuite_info,\0A                                     ssl->conf->endpoint,\0A                                     ssl->tls_version,\0A                                     &ssl->session_negotiate->verify_result) != 0) {\0A        MBEDTLS_SSL_DEBUG_MSG(1, (\22bad certificate (usage extensions)\22));\0A        if (ret == 0) {\0A            ret = MBEDTLS_ERR_SSL_BAD_CERTIFICATE;\0A        }\0A    }\0A\0A    /* With authmode optional, we want to keep going if the certificate was\0A     * unacceptable, but still fail on other errors (out of memory etc),\0A     * including fatal errors from the f_vrfy callback.\0A     *\0A     * The only acceptable errors are:\0A     * - MBEDTLS_ERR_X509_CERT_VERIFY_FAILED: cert rejected by primary check;\0A     * - MBEDTLS_ERR_SSL_BAD_CERTIFICATE: cert rejected by secondary checks.\0A     * Anything else is a fatal error. */\0A    if (authmode == MBEDTLS_SSL_VERIFY_OPTIONAL &&\0A        (ret == MBEDTLS_ERR_X509_CERT_VERIFY_FAILED ||\0A         ret == MBEDTLS_ERR_SSL_BAD_CERTIFICATE)) {\0A        ret = 0;\0A    }\0A\0A    /* Return a specific error as this is a user error: inconsistent\0A     * configuration - can't verify without trust anchors. */\0A    if (have_ca_chain_or_callback == 0 && authmode == MBEDTLS_SSL_VERIFY_REQUIRED) {\0A        MBEDTLS_SSL_DEBUG_MSG(1, (\22got no CA chain\22));\0A        ret = MBEDTLS_ERR_SSL_CA_CHAIN_REQUIRED;\0A    }\0A\0A    if (ret != 0) {\0A        uint8_t alert;\0A\0A        /* The certificate may have been rejected for several reasons.\0A           Pick one and send the corresponding alert. Which alert to send\0A           may be a subject of debate in some cases. */\0A        if (ssl->session_negotiate->verify_result & MBEDTLS_X509_BADCERT_OTHER) {\0A            alert = MBEDTLS_SSL_ALERT_MSG_ACCESS_DENIED;\0A        } else if (ssl->session_negotiate->verify_result & MBEDTLS_X509_BADCERT_CN_MISMATCH) {\0A            alert = MBEDTLS_SSL_ALERT_MSG_BAD_CERT;\0A        } else if (ssl->session_negotiate->verify_result & MBEDTLS_X509_BADCERT_KEY_USAGE) {\0A            alert = MBEDTLS_SSL_ALERT_MSG_UNSUPPORTED_CERT;\0A        } else if (ssl->session_negotiate->verify_result & MBEDTLS_X509_BADCERT_EXT_KEY_USAGE) {\0A            alert = MBEDTLS_SSL_ALERT_MSG_UNSUPPORTED_CERT;\0A        } else if (ssl->session_negotiate->verify_result & MBEDTLS_X509_BADCERT_BAD_PK) {\0A            alert = MBEDTLS_SSL_ALERT_MSG_UNSUPPORTED_CERT;\0A        } else if (ssl->session_negotiate->verify_result & MBEDTLS_X509_BADCERT_BAD_KEY) {\0A            alert = MBEDTLS_SSL_ALERT_MSG_UNSUPPORTED_CERT;\0A        } else if (ssl->session_negotiate->verify_result & MBEDTLS_X509_BADCERT_EXPIRED) {\0A            alert = MBEDTLS_SSL_ALERT_MSG_CERT_EXPIRED;\0A        } else if (ssl->session_negotiate->verify_result & MBEDTLS_X509_BADCERT_REVOKED) {\0A            alert = MBEDTLS_SSL_ALERT_MSG_CERT_REVOKED;\0A        } else if (ssl->session_negotiate->verify_result & MBEDTLS_X509_BADCERT_NOT_TRUSTED) {\0A            alert = MBEDTLS_SSL_ALERT_MSG_UNKNOWN_CA;\0A        } else {\0A            alert = MBEDTLS_SSL_ALERT_MSG_CERT_UNKNOWN;\0A        }\0A        mbedtls_ssl_send_alert_message(ssl, MBEDTLS_SSL_ALERT_LEVEL_FATAL,\0A                                       alert);\0A    }\0A\0A#if defined(MBEDTLS_DEBUG_C)\0A    if (ssl->session_negotiate->verify_result != 0) {\0A        MBEDTLS_SSL_DEBUG_MSG(3, (\22! Certificate verification flags %08x\22,\0A                                  (unsigned int) ssl->session_negotiate->verify_result));\0A    } else {\0A        MBEDTLS_SSL_DEBUG_MSG(3, (\22Certificate verification flags clear\22));\0A    }\0A#endif /* MBEDTLS_DEBUG_C */\0A\0A    return ret;\0A}\0A#endif /* MBEDTLS_SSL_HANDSHAKE_WITH_CERT_ENABLED */\0A\0A#endif /* MBEDTLS_SSL_TLS_C */\0A\00" }
