n */\0A        if (verbose) {\0A            mbedtls_printf(\22  ARIA-ECB-%d (enc): \22, 128 + 64 * i);\0A        }\0A        mbedtls_aria_setkey_enc(&ctx, aria_test1_ecb_key, 128 + 64 * i);\0A        mbedtls_aria_crypt_ecb(&ctx, aria_test1_ecb_pt, blk);\0A        ARIA_SELF_TEST_ASSERT(\0A            memcmp(blk, aria_test1_ecb_ct[i], MBEDTLS_ARIA_BLOCKSIZE)\0A            != 0);\0A\0A        /* test ECB decryption */\0A        if (verbose) {\0A            mbedtls_printf(\22  ARIA-ECB-%d (dec): \22, 128 + 64 * i);\0A#if defined(MBEDTLS_BLOCK_CIPHER_NO_DECRYPT)\0A            mbedtls_printf(\22skipped\5Cn\22);\0A#endif\0A        }\0A\0A#if !defined(MBEDTLS_BLOCK_CIPHER_NO_DECRYPT)\0A        mbedtls_aria_setkey_dec(&ctx, aria_test1_ecb_key, 128 + 64 * i);\0A        mbedtls_aria_crypt_ecb(&ctx, aria_test1_ecb_ct[i], blk);\0A        ARIA_SELF_TEST_ASSERT(\0A            memcmp(blk, aria_test1_ecb_pt, MBEDTLS_ARIA_BLOCKSIZE)\0A            != 0);\0A#endif\0A    }\0A    if (verbose) {\0A        mbedtls_printf(\22\5Cn\22);\0A    }\0A\0A    /*\0A     * Test set 2\0A     */\0A#if defined(MBEDTLS_CIPHER_MODE_CBC)\0A    for (i = 0; i < 3; i++) {\0A        /* Test CBC encryption */\0A        if (verbose) {\0A            mbedtls_printf(\22  ARIA-CBC-%d (enc): \22, 128 + 64 * i);\0A        }\0A        mbedtls_aria_setkey_enc(&ctx, aria_test2_key, 128 + 64 * i);\0A        memcpy(iv, aria_test2_iv, MBEDTLS_ARIA_BLOCKSIZE);\0A        memset(buf, 0x55, sizeof(buf));\0A        mbedtls_aria_crypt_cbc(&ctx, MBEDTLS_ARIA_ENCRYPT, 48, iv,\0A                               aria_test2_pt, buf);\0A        ARIA_SELF_TEST_ASSERT(memcmp(buf, aria_test2_cbc_ct[i], 48)\0A                              != 0);\0A\0A        /* Test CBC decryption */\0A        if (verbose) {\0A            mbedtls_printf(\22  ARIA-CBC-%d (dec): \22, 128 + 64 * i);\0A        }\0A        mbedtls_aria_setkey_dec(&ctx, aria_test2_key, 128 + 64 * i);\0A        memcpy(iv, aria_test2_iv, MBEDTLS_ARIA_BLOCKSIZE);\0A        memset(buf, 0xAA, sizeof(buf));\0A        mbedtls_aria_crypt_cbc(&ctx, MBEDTLS_ARIA_DECRYPT, 48, iv,\0A                               aria_test2_cbc_ct[i], buf);\0A        ARIA_SELF_TEST_ASSERT(memcmp(buf, aria_test2_pt, 48) != 0);\0A    }\0A    if (verbose) {\0A        mbedtls_printf(\22\5Cn\22);\0A    }\0A\0A#endif /* MBEDTLS_CIPHER_MODE_CBC */\0A\0A#if defined(MBEDTLS_CIPHER_MODE_CFB)\0A    for (i = 0; i < 3; i++) {\0A        /* Test CFB encryption */\0A        if (verbose) {\0A            mbedtls_printf(\22  ARIA-CFB-%d (enc): \22, 128 + 64 * i);\0A        }\0A        mbedtls_aria_setkey_enc(&ctx, aria_test2_key, 128 + 64 * i);\0A        memcpy(iv, aria_test2_iv, MBEDTLS_ARIA_BLOCKSIZE);\0A        memset(buf, 0x55, sizeof(buf));\0A        j = 0;\0A        mbedtls_aria_crypt_cfb128(&ctx, MBEDTLS_ARIA_ENCRYPT, 48, &j, iv,\0A                                  aria_test2_pt, buf);\0A        ARIA_SELF_TEST_ASSERT(memcmp(buf, aria_test2_cfb_ct[i], 48) != 0);\0A\0A        /* Test CFB decryption */\0A        if (verbose) {\0A            mbedtls_printf(\22  ARIA-CFB-%d (dec): \22, 128 + 64 * i);\0A        }\0A        mbedtls_aria_setkey_enc(&ctx, aria_test2_key, 128 + 64 * i);\0A        memcpy(iv, aria_test2_iv, MBEDTLS_ARIA_BLOCKSIZE);\0A        memset(buf, 0xAA, sizeof(buf));\0A        j = 0;\0A        mbedtls_aria_crypt_cfb128(&ctx, MBEDTLS_ARIA_DECRYPT, 48, &j,\0A                                  iv, aria_test2_cfb_ct[i], buf);\0A        ARIA_SELF_TEST_ASSERT(memcmp(buf, aria_test2_pt, 48) != 0);\0A    }\0A    if (verbose) {\0A        mbedtls_printf(\22\5Cn\22);\0A    }\0A#endif /* MBEDTLS_CIPHER_MODE_CFB */\0A\0A#if defined(MBEDTLS_CIPHER_MODE_CTR)\0A    for (i = 0; i < 3; i++) {\0A        /* Test CTR encryption */\0A        if (verbose) {\0A            mbedtls_printf(\22  ARIA-CTR-%d (enc): \22, 128 + 64 * i);\0A        }\0A        mbedtls_aria_setkey_enc(&ctx, aria_test2_key, 128 + 64 * i);\0A        memset(iv, 0, MBEDTLS_ARIA_BLOCKSIZE);                      // IV = 0\0A        memset(buf, 0x55, sizeof(buf));\0A        j = 0;\0A        mbedtls_aria_crypt_ctr(&ctx, 48, &j, iv, blk,\0A                               aria_test2_pt, buf);\0A        ARIA_SELF_TEST_ASSERT(memcmp(buf, aria_test2_ctr_ct[i], 48) != 0);\0A\0A        /* Test CTR decryption */\0A        if (verbose) {\0A            mbedtls_printf(\22  ARIA-CTR-%d (dec): \22, 128 + 64 * i);\0A        }\0A        mbedtls_aria_setkey_enc(&ctx, aria_test2_key, 128 + 64 * i);\0A        memset(iv, 0, MBEDTLS_ARIA_BLOCKSIZE);                      // IV = 0\0A        memset(buf, 0xAA, sizeof(buf));\0A        j = 0;\0A        mbedtls_aria_crypt_ctr(&ctx, 48, &j, iv, blk,\0A                               aria_test2_ctr_ct[i], buf);\0A        ARIA_SELF_TEST_ASSERT(memcmp(buf, aria_test2_pt, 48) != 0);\0A    }\0A    if (verbose) {\0A        mbedtls_printf(\22\5Cn\22);\0A    }\0A#endif /* MBEDTLS_CIPHER_MODE_CTR */\0A\0A    ret = 0;\0A\0Aexit:\0A    mbedtls_aria_free(&ctx);\0A    return ret;\0A}\0A\0A#endif /* MBEDTLS_SELF_TEST */\0A\0A#endif /* MBEDTLS_ARIA_C */\0A\00" }
