CHK(mbedtls_ctr_drbg_seed(&ctx,\0A                              ctr_drbg_self_test_entropy,\0A                              (void *) entropy_source_nopr,\0A                              pers_nopr, MBEDTLS_CTR_DRBG_KEYSIZE));\0A    CHK(mbedtls_ctr_drbg_reseed(&ctx, NULL, 0));\0A    CHK(mbedtls_ctr_drbg_random(&ctx, buf, SELF_TEST_OUTPUT_DISCARD_LENGTH));\0A    CHK(mbedtls_ctr_drbg_random(&ctx, buf, sizeof(result_nopr)));\0A    CHK(memcmp(buf, result_nopr, sizeof(result_nopr)));\0A\0A    mbedtls_ctr_drbg_free(&ctx);\0A\0A    if (verbose != 0) {\0A        mbedtls_printf(\22passed\5Cn\22);\0A    }\0A\0A    if (verbose != 0) {\0A        mbedtls_printf(\22\5Cn\22);\0A    }\0A\0A    return 0;\0A}\0A#endif /* MBEDTLS_SELF_TEST */\0A\0A#endif /* MBEDTLS_CTR_DRBG_C */\0A\00" }
