_t max_len = (size_t) ret;\0A\0A    if (ret < 0) {\0A        MBEDTLS_SSL_DEBUG_RET(1, \22mbedtls_ssl_get_max_out_record_payload\22, ret);\0A        return ret;\0A    }\0A\0A    if (len > max_len) {\0A#if defined(MBEDTLS_SSL_PROTO_DTLS)\0A        if (ssl->conf->transport == MBEDTLS_SSL_TRANSPORT_DATAGRAM) {\0A            MBEDTLS_SSL_DEBUG_MSG(1, (\22fragment larger than the (negotiated) \22\0A                                      \22maximum fragment length: %\22 MBEDTLS_PRINTF_SIZET\0A                                      \22 > %\22 MBEDTLS_PRINTF_SIZET,\0A                                      len, max_len));\0A            return MBEDTLS_ERR_SSL_BAD_INPUT_DATA;\0A        } else\0A#endif\0A        len = max_len;\0A    }\0A\0A    if (ssl->out_left != 0) {\0A        /*\0A         * The user has previously tried to send the data and\0A         * MBEDTLS_ERR_SSL_WANT_WRITE or the message was only partially\0A         * written. In this case, we expect the high-level write function\0A         * (e.g. mbedtls_ssl_write()) to be called with the same parameters\0A         */\0A        if ((ret = mbedtls_ssl_flush_output(ssl)) != 0) {\0A            MBEDTLS_SSL_DEBUG_RET(1, \22mbedtls_ssl_flush_output\22, ret);\0A            return ret;\0A        }\0A    } else {\0A        /*\0A         * The user is trying to send a message the first time, so we need to\0A         * copy the data into the internal buffers and setup the data structure\0A         * to keep track of partial writes\0A         */\0A        ssl->out_msglen  = len;\0A        ssl->out_msgtype = MBEDTLS_SSL_MSG_APPLICATION_DATA;\0A        if (len > 0) {\0A            memcpy(ssl->out_msg, buf, len);\0A        }\0A\0A        if ((ret = mbedtls_ssl_write_record(ssl, SSL_FORCE_FLUSH)) != 0) {\0A            MBEDTLS_SSL_DEBUG_RET(1, \22mbedtls_ssl_write_record\22, ret);\0A            return ret;\0A        }\0A    }\0A\0A    return (int) len;\0A}\0A\0A/*\0A * Write application data (public-facing wrapper)\0A */\0Aint mbedtls_ssl_write(mbedtls_ssl_context *ssl, const unsigned char *buf, size_t len)\0A{\0A    int ret = MBEDTLS_ERR_ERROR_CORRUPTION_DETECTED;\0A\0A    MBEDTLS_SSL_DEBUG_MSG(2, (\22=> write\22));\0A\0A    if (ssl == NULL || ssl->conf == NULL) {\0A        return MBEDTLS_ERR_SSL_BAD_INPUT_DATA;\0A    }\0A\0A#if defined(MBEDTLS_SSL_RENEGOTIATION)\0A    if ((ret = ssl_check_ctr_renegotiate(ssl)) != 0) {\0A        MBEDTLS_SSL_DEBUG_RET(1, \22ssl_check_ctr_renegotiate\22, ret);\0A        return ret;\0A    }\0A#endif\0A\0A    if (ssl->state != MBEDTLS_SSL_HANDSHAKE_OVER) {\0A        if ((ret = mbedtls_ssl_handshake(ssl)) != 0) {\0A            MBEDTLS_SSL_DEBUG_RET(1, \22mbedtls_ssl_handshake\22, ret);\0A            return ret;\0A        }\0A    }\0A\0A    ret = ssl_write_real(ssl, buf, len);\0A\0A    MBEDTLS_SSL_DEBUG_MSG(2, (\22<= write\22));\0A\0A    return ret;\0A}\0A\0A#if defined(MBEDTLS_SSL_EARLY_DATA) && defined(MBEDTLS_SSL_CLI_C)\0Aint mbedtls_ssl_write_early_data(mbedtls_ssl_context *ssl,\0A                                 const unsigned char *buf, size_t len)\0A{\0A    int ret = MBEDTLS_ERR_ERROR_CORRUPTION_DETECTED;\0A    const struct mbedtls_ssl_config *conf;\0A    uint32_t remaining;\0A\0A    MBEDTLS_SSL_DEBUG_MSG(2, (\22=> write early_data\22));\0A\0A    if (ssl == NULL || (conf = ssl->conf) == NULL) {\0A        return MBEDTLS_ERR_SSL_BAD_INPUT_DATA;\0A    }\0A\0A    if (conf->endpoint != MBEDTLS_SSL_IS_CLIENT) {\0A        return MBEDTLS_ERR_SSL_BAD_INPUT_DATA;\0A    }\0A\0A    if ((!mbedtls_ssl_conf_is_tls13_enabled(conf)) ||\0A        (conf->transport == MBEDTLS_SSL_TRANSPORT_DATAGRAM) ||\0A        (conf->early_data_enabled != MBEDTLS_SSL_EARLY_DATA_ENABLED)) {\0A        return MBEDTLS_ERR_SSL_CANNOT_WRITE_EARLY_DATA;\0A    }\0A\0A    if (ssl->tls_version != MBEDTLS_SSL_VERSION_TLS1_3) {\0A        return MBEDTLS_ERR_SSL_CANNOT_WRITE_EARLY_DATA;\0A    }\0A\0A    /*\0A     * If we are at the beginning of the handshake, the early data state being\0A     * equal to MBEDT