@.str44117 = private global { i64, i64, [6164 x i8] } { i64 -1, i64 6163, [6164 x i8] c"/**\0A * \5Cfile mbedtls/build_info.h\0A *\0A * \5Cbrief Build-time configuration info\0A *\0A *  Include this file if you need to depend on the\0A *  configuration options defined in mbedtls_config.h or MBEDTLS_CONFIG_FILE\0A */\0A/*\0A *  Copyright The Mbed TLS Contributors\0A *  SPDX-License-Identifier: Apache-2.0 OR GPL-2.0-or-later\0A */\0A\0A#ifndef MBEDTLS_BUILD_INFO_H\0A#define MBEDTLS_BUILD_INFO_H\0A\0A/*\0A * This set of compile-time defines can be used to determine the version number\0A * of the Mbed TLS library used. Run-time variables for the same can be found in\0A * version.h\0A */\0A\0A/**\0A * The version number x.y.z is split into three parts.\0A * Major, Minor, Patchlevel\0A */\0A#define MBEDTLS_VERSION_MAJOR  3\0A#define MBEDTLS_VERSION_MINOR  6\0A#define MBEDTLS_VERSION_PATCH  3\0A\0A/**\0A * The single version number has the following structure:\0A *    MMNNPP00\0A *    Major version | Minor version | Patch version\0A */\0A#define MBEDTLS_VERSION_NUMBER         0x03060300\0A#define MBEDTLS_VERSION_STRING         \223.6.3\22\0A#define MBEDTLS_VERSION_STRING_FULL    \22Mbed TLS 3.6.3\22\0A\0A/* Macros for build-time platform detection */\0A\0A#if !defined(MBEDTLS_ARCH_IS_ARM64) && \5C\0A    (defined(__aarch64__) || defined(_M_ARM64) || defined(_M_ARM64EC))\0A#define MBEDTLS_ARCH_IS_ARM64\0A#endif\0A\0A#if !defined(MBEDTLS_ARCH_IS_ARM32) && \5C\0A    (defined(__arm__) || defined(_M_ARM) || \5C\0A    defined(_M_ARMT) || defined(__thumb__) || defined(__thumb2__))\0A#define MBEDTLS_ARCH_IS_ARM32\0A#endif\0A\0A#if !defined(MBEDTLS_ARCH_IS_X64) && \5C\0A    (defined(__amd64__) || defined(__x86_64__) || \5C\0A    ((defined(_M_X64) || defined(_M_AMD64)) && !defined(_M_ARM64EC)))\0A#define MBEDTLS_ARCH_IS_X64\0A#endif\0A\0A#if !defined(MBEDTLS_ARCH_IS_X86) && \5C\0A    (defined(__i386__) || defined(_X86_) || \5C\0A    (defined(_M_IX86) && !defined(_M_I86)))\0A#define MBEDTLS_ARCH_IS_X86\0A#endif\0A\0A#if !defined(MBEDTLS_PLATFORM_IS_WINDOWS_ON_ARM64) && \5C\0A    (defined(_M_ARM64) || defined(_M_ARM64EC))\0A#define MBEDTLS_PLATFORM_IS_WINDOWS_ON_ARM64\0A#endif\0A\0A/* This is defined if the architecture is Armv8-A, or higher */\0A#if !defined(MBEDTLS_ARCH_IS_ARMV8_A)\0A#if defined(__ARM_ARCH) && defined(__ARM_ARCH_PROFILE)\0A#if (__ARM_ARCH >= 8) && (__ARM_ARCH_PROFILE == 'A')\0A/* GCC, clang, armclang and IAR */\0A#define MBEDTLS_ARCH_IS_ARMV8_A\0A#endif\0A#elif defined(__ARM_ARCH_8A)\0A/* Alternative defined by clang */\0A#define MBEDTLS_ARCH_IS_ARMV8_A\0A#elif defined(_M_ARM64) || defined(_M_ARM64EC)\0A/* MSVC ARM64 is at least Armv8.0-A */\0A#define MBEDTLS_ARCH_IS_ARMV8_A\0A#endif\0A#endif\0A\0A#if defined(__GNUC__) && !defined(__ARMCC_VERSION) && !defined(__clang__) \5C\0A    && !defined(__llvm__) && !defined(__INTEL_COMPILER)\0A/* Defined if the compiler really is gcc and not clang, etc */\0A#define MBEDTLS_COMPILER_IS_GCC\0A#define MBEDTLS_GCC_VERSION \5C\0A    (__GNUC__ * 10000 + __GNUC_MINOR__ * 100 + __GNUC_PATCHLEVEL__)\0A#endif\0A\0A#if defined(_MSC_VER) && !defined(_CRT_SECURE_NO_DEPRECATE)\0A#define _CRT_SECURE_NO_DEPRECATE 1\0A#endif\0A\0A/* Define `inline` on some non-C99-compliant compilers. */\0A#if (defined(__ARMCC_VERSION) || defined(_MSC_VER)) && \5C\0A    !defined(inline) && !defined(__cplusplus)\0A#define inline __inline\0A#endif\0A\0A#if defined(MBEDTLS_CONFIG_FILES_READ)\0A#error \22Something went wrong: MBEDTLS_CONFIG_FILES_READ defined before reading the config files!\22\0A#endif\0A#if defined(MBEDTLS_CONFIG_IS_FINALIZED)\0A#error \22Something went wrong: MBEDTLS_CONFIG_IS_FINALIZED defined before reading the config files!\22\0A#endif\0A\0A/* X.509, TLS and non-PSA crypto configuration */\0A#if !defined(MBEDTLS_CONFIG_FILE)\0A#include \22mbedtls/mbedtls_config.h\22\0A#else\0A#include MBEDTLS_CONFIG_FILE\0A#endif\0A\0A#if defined(MBEDTLS_CONFIG_VERSION) && ( \5C\0A    MBEDTLS_CONFIG_VERSION < 0x03000000 || \5C\0A                             MBEDTLS_CONFIG_VERSION > MBEDTLS_VERSION_NUMBER)\0A#error \22Invalid config version, defined value of MBEDTLS_CONFIG_VERSION is unsupported\22\0A#endif\0A\0A/* Target and application specific configurations\0A *\0A * Allow user to override any previous default.\0A *\0A */\0A#if defined(MBEDTLS_USER_CONFIG_FILE)\0A#include MBEDTLS_USER_CONFIG_FILE\0A#endif\0A\0A/* PSA crypto configuration */\0A#if defined(MBEDTLS_PSA_CRYPTO_CONFIG)\0A#if defined(MBEDTLS_PSA_CRYPTO_CONFIG_FILE)\0A#include MBEDTLS_PSA_CRYPTO_CONFIG_FILE\0A#else\0A#include \22psa/crypto_config.h\22\0A#endif\0A#if defined(MBEDTLS_PSA_CRYPTO_USER_CONFIG_FILE)\0A#include MBEDTLS_PSA_CRYPTO_USER_CONFIG_FILE\0A#endif\0A#endif /* defined(MBEDTLS_PSA_CRYPTO_CONFIG) */\0A\0A/* Indicate that all configuration files have been read.\0A * It is now time to adjust the configuration (follow through on dependencies,\0A * make PSA and legacy crypto consistent, etc.).\0A */\0A#define MBEDTLS_CONFIG_FILES_READ\0A\0A/* Auto-enable MBEDTLS_CTR_DRBG_USE_128_BIT_KEY if\0A * MBEDTLS_AES_ONLY_128_BIT_KEY_LENGTH and MBEDTLS_CTR_DRBG_C defined\0A * to ensure a 128-bit key size in CTR_DRBG.\0A */\0A#if defined(MBEDTLS_AES_ONLY_128_BIT_KEY_LENGTH) && defined(MBEDTLS_CTR_DRBG_C)\0A#define MBEDTLS_CTR_DRBG_USE_128_BIT_KEY\0A#endif\0A\0A/* Auto-enable MBEDTLS_MD_C if needed by a module that didn't require it\0A * in a previous release, to ensure backwards compatibility.\0A */\0A#if defined(MBEDTLS_PKCS5_C)\0A#define MBEDTLS_MD_C\0A#endif\0A\0A/* PSA crypto specific configuration options\0A * - If config_psa.h reads a configuration option in preprocessor directive,\0A *   this symbol should be set before its inclusion. (e.g. MBEDTLS_MD_C)\0A * - If config_psa.h writes a configuration option in conditional directive,\0A *   this symbol should be consulted after its inclusion.\0A *   (e.g. MBEDTLS_MD_LIGHT)\0A */\0A#if defined(MBEDTLS_PSA_CRYPTO_CONFIG) /* PSA_WANT_xxx influences MBEDTLS_xxx */ || \5C\0A    defined(MBEDTLS_PSA_CRYPTO_C) /* MBEDTLS_xxx influences PSA_WANT_xxx */ || \5C\0A    defined(MBEDTLS_PSA_CRYPTO_CLIENT) /* The same as the previous, but with separation only */\0A#include \22mbedtls/config_psa.h\22\0A#endif\0A\0A#include \22mbedtls/config_adjust_legacy_crypto.h\22\0A\0A#include \22mbedtls/config_adjust_x509.h\22\0A\0A#include \22mbedtls/config_adjust_ssl.h\22\0A\0A/* Indicate that all configuration symbols are set,\0A * even the ones that are calculated programmatically.\0A * It is now safe to query the configuration (to check it, to size buffers,\0A * etc.).\0A */\0A#define MBEDTLS_CONFIG_IS_FINALIZED\0A\0A#include \22mbedtls/check_config.h\22\0A\0A#endif /* MBEDTLS_BUILD_INFO_H */\0A\00" }
