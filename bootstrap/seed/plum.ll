@.str45190 = private global { i64, i64, [18526 x i8] } { i64 -1, i64 18525, [18526 x i8] c"/**\0A * \5Cfile hmac_drbg.h\0A *\0A * \5Cbrief The HMAC_DRBG pseudorandom generator.\0A *\0A * This module implements the HMAC_DRBG pseudorandom generator described\0A * in <em>NIST SP 800-90A: Recommendation for Random Number Generation Using\0A * Deterministic Random Bit Generators</em>.\0A */\0A/*\0A *  Copyright The Mbed TLS Contributors\0A *  SPDX-License-Identifier: Apache-2.0 OR GPL-2.0-or-later\0A */\0A#ifndef MBEDTLS_HMAC_DRBG_H\0A#define MBEDTLS_HMAC_DRBG_H\0A#include \22mbedtls/private_access.h\22\0A\0A#include \22mbedtls/build_info.h\22\0A\0A#include \22mbedtls/md.h\22\0A\0A#if defined(MBEDTLS_THREADING_C)\0A#include \22mbedtls/threading.h\22\0A#endif\0A\0A/*\0A * Error codes\0A */\0A/** Too many random requested in single call. */\0A#define MBEDTLS_ERR_HMAC_DRBG_REQUEST_TOO_BIG              -0x0003\0A/** Input too large (Entropy + additional). */\0A#define MBEDTLS_ERR_HMAC_DRBG_INPUT_TOO_BIG                -0x0005\0A/** Read/write error in file. */\0A#define MBEDTLS_ERR_HMAC_DRBG_FILE_IO_ERROR                -0x0007\0A/** The entropy source failed. */\0A#define MBEDTLS_ERR_HMAC_DRBG_ENTROPY_SOURCE_FAILED        -0x0009\0A\0A/**\0A * \5Cname SECTION: Module settings\0A *\0A * The configuration options you can set for this module are in this section.\0A * Either change them in mbedtls_config.h or define them on the compiler command line.\0A * \5C{\0A */\0A\0A#if !defined(MBEDTLS_HMAC_DRBG_RESEED_INTERVAL)\0A#define MBEDTLS_HMAC_DRBG_RESEED_INTERVAL   10000   /**< Interval before reseed is performed by default */\0A#endif\0A\0A#if !defined(MBEDTLS_HMAC_DRBG_MAX_INPUT)\0A#define MBEDTLS_HMAC_DRBG_MAX_INPUT         256     /**< Maximum number of additional input bytes */\0A#endif\0A\0A#if !defined(MBEDTLS_HMAC_DRBG_MAX_REQUEST)\0A#define MBEDTLS_HMAC_DRBG_MAX_REQUEST       1024    /**< Maximum number of requested bytes per call */\0A#endif\0A\0A#if !defined(MBEDTLS_HMAC_DRBG_MAX_SEED_INPUT)\0A#define MBEDTLS_HMAC_DRBG_MAX_SEED_INPUT    384     /**< Maximum size of (re)seed buffer */\0A#endif\0A\0A/** \5C} name SECTION: Module settings */\0A\0A#define MBEDTLS_HMAC_DRBG_PR_OFF   0   /**< No prediction resistance       */\0A#define MBEDTLS_HMAC_DRBG_PR_ON    1   /**< Prediction resistance enabled  */\0A\0A#ifdef __cplusplus\0Aextern \22C\22 {\0A#endif\0A\0A/**\0A * HMAC_DRBG context.\0A */\0Atypedef struct mbedtls_hmac_drbg_context {\0A    /* Working state: the key K is not stored explicitly,\0A     * but is implied by the HMAC context */\0A    mbedtls_md_context_t MBEDTLS_PRIVATE(md_ctx);                    /*!< HMAC context (inc. K)  */\0A    unsigned char MBEDTLS_PRIVATE(V)[MBEDTLS_MD_MAX_SIZE];  /*!< V in the spec          */\0A    int MBEDTLS_PRIVATE(reseed_counter);                     /*!< reseed counter         */\0A\0A    /* Administrative state */\0A    size_t MBEDTLS_PRIVATE(entropy_len);         /*!< entropy bytes grabbed on each (re)seed */\0A    int MBEDTLS_PRIVATE(prediction_resistance);  /*!< enable prediction resistance (Automatic\0A                                                    reseed before every random generation) */\0A    int MBEDTLS_PRIVATE(reseed_interval);        /*!< reseed interval   */\0A\0A    /* Callbacks */\0A    int(*MBEDTLS_PRIVATE(f_entropy))(void *, unsigned char *, size_t);  /*!< entropy function */\0A    void *MBEDTLS_PRIVATE(p_entropy);            /*!< context for the entropy function        */\0A\0A#if defined(MBEDTLS_THREADING_C)\0A    /* Invariant: the mutex is initialized if and only if\0A     * md_ctx->md_info != NULL. This means that the mutex is initialized\0A     * during the initial seeding in mbedtls_hmac_drbg_seed() or\0A     * mbedtls_hmac_drbg_seed_buf() and freed in mbedtls_ctr_drbg_free().\0A     *\0A     * Note that this invariant may change without notice. Do not rely on it\0A     * and do not access the mutex directly in application code.\0A     */\0A    mbedtls_threading_mutex_t MBEDTLS_PRIVATE(mutex);\0A#endif\0A} mbedtls_hmac_drbg_context;\0A\0A/**\0A * \5Cbrief               HMAC_DRBG context initialization.\0A *\0A * This function makes the context ready for mbedtls_hmac_drbg_seed(),\0A * mbedtls_hmac_drbg_seed_buf() or mbedtls_hmac_drbg_free().\0A *\0A * \5Cnote                The reseed interval is #MBEDTLS_HMAC_DRBG_RESEED_INTERVAL\0A *                      by default. Override this value by calling\0A *                      mbedtls_hmac_drbg_set_reseed_interval().\0A *\0A * \5Cparam ctx           HMAC_DRBG context to be initialized.\0A */\0Avoid mbedtls_hmac_drbg_init(mbedtls_hmac_drbg_context *ctx);\0A\0A/**\0A * \5Cbrief               HMAC_DRBG initial seeding.\0A *\0A * Set the initial seed and set up the entropy source for future reseeds.\0A *\0A * A typical choice for the \5Cp f_entropy and \5Cp p_entropy parameters is\0A * to use the entropy module:\0A * - \5Cp f_entropy is mbedtls_entropy_func();\0A * - \5Cp p_entropy is an instance of ::mbedtls_entropy_context initialized\0A *   with mbedtls_entropy_init() (which registers the platform's default\0A *   entropy sources).\0A *\0A * You can provide a personalization string in addition to the\0A * entropy source, to make this instantiation as unique as possible.\0A *\0A * \5Cnote                By default, the security strength as defined by NIST is:\0A *                      - 128 bits if \5Cp md_info is SHA-1;\0A *                      - 192 bits if \5Cp md_info is SHA-224;\0A *                      - 256 bits if \5Cp md_info is SHA-256, SHA-384 or SHA-512.\0A *                      Note that SHA-256 is just as efficient as SHA-224.\0A *                      The security strength can be reduced if a smaller\0A *                      entropy length is set with\0A *                      mbedtls_hmac_drbg_set_entropy_len().\0A *\0A * \5Cnote                The default entropy length is the security strength\0A *                      (converted from bits to bytes). You can override\0A *                      it by calling mbedtls_hmac_drbg_set_entropy_len().\0A *\0A * \5Cnote                During the initial seeding, this function calls\0A *                      the entropy source to obtain a nonce\0A *                      whose length is half the entropy length.\0A */\0A#if defined(MBEDTLS_THREADING_C)\0A/**\0A * \5Cnote                When Mbed TLS is built with threading support,\0A *                      after this function returns successfully,\0A *                      it is safe to call mbedtls_hmac_drbg_random()\0A *                      from multiple threads. Other operations, including\0A *                      reseeding, are not thread-safe.\0A */\0A#endif /* MBEDTLS_THREADING_C */\0A/**\0A * \5Cparam ctx           HMAC_DRBG context to be seeded.\0A * \5Cparam md_info       MD algorithm to use for HMAC_DRBG.\0A * \5Cparam f_entropy     The entropy callback, taking as arguments the\0A *                      \5Cp p_entropy context, the buffer to fill, and the\0A *                      length of the buffer.\0A *                      \5Cp f_entropy is always called with a length that is\0A *                      less than or equal to the entropy length.\0A * \5Cparam p_entropy     The entropy context to pass to \5Cp f_entropy.\0A * \5Cparam custom        The personalization string.\0A *                      This can be \5Cc NULL, in which case the personalization\0A *                      string is empty regardless of the value of \5Cp len.\0A * \5Cparam len           The length of the personalization string.\0A *                      This must be at most #MBEDTLS_HMAC_DRBG_MAX_INPUT\0A *                      and also at most\0A *                      #MBEDTLS_HMAC_DRBG_MAX_SEED_INPUT - \5Cc entropy_len * 3 / 2\0A *                      where \5Cc entropy_len is the entropy length\0A *                      described above.\0A *\0A * \5Creturn              \5Cc 0 if successful.\0A * \5Creturn              #MBEDTLS_ERR_MD_BAD_INPUT_DATA if \5Cp md_info is\0A *                      invalid.\0A * \5Creturn              #MBEDTLS_ERR_MD_ALLOC_FAILED if there was not enough\0A *                      memory to allocate context data.\0A * \5Creturn              #MBEDTLS_ERR_HMAC_DRBG_ENTROPY_SOURCE_FAILED\0A *                      if the call to \5Cp f_entropy failed.\0A */\0Aint mbedtls_hmac_drbg_seed(mbedtls_hmac_drbg_context *ctx,\0A                           const mbedtls_md_info_t *md_info,\0A                           int (*f_entropy)(void *, unsigned char *, size_t),\0A                           void *p_entropy,\0A                           const unsigned char *custom,\0A                           size_t len);\0A\0A/**\0A * \5Cbrief               Initialisation of simplified HMAC_DRBG (never reseeds).\0A *\0A * This function is meant for use in algorithms that need a pseudorandom\0A * input such as deterministic ECDSA.\0A */\0A#if defined(MBEDTLS_THREADING_C)\0A/**\0A * \5Cnote                When Mbed TLS is built with threading support,\0A *                      after this function returns successfully,\0A *                      it is safe to call mbedtls_hmac_drbg_random()\0A *                      from multiple threads. Other operations, including\0A *                      reseeding, are not thread-safe.\0A */\0A#endif /* MBEDTLS_THREADING_C */\0A/**\0A * \5Cparam ctx           HMAC_DRBG context to be initialised.\0A * \5Cparam md_info       MD algorithm to use for HMAC_DRBG.\0A * \5Cparam data          Concatenation of the initial entropy string and\0A *                      the additional data.\0A * \5Cparam data_len      Length of \5Cp data in bytes.\0A *\0A * \5Creturn              \5Cc 0 if successful. or\0A * \5Creturn              #MBEDTLS_ERR_MD_BAD_INPUT_DATA if \5Cp md_info is\0A *                      invalid.\0A * \5Creturn              #MBEDTLS_ERR_MD_ALLOC_FAILED if there was not enough\0A *                      memory to allocate context data.\0A */\0Aint mbedtls_hmac_drbg_seed_buf(mbedtls_hmac_drbg_context *ctx,\0A                               const mbedtls_md_info_t *md_info,\0A                               const unsigned char *data, size_t data_len);\0A\0A/**\0A * \5Cbrief               This function turns prediction resistance on or off.\0A *                      The default value is off.\0A *\0A * \5Cnote                If enabled, entropy is gathered at the beginning of\0A *                      every call to mbedtls_hmac_drbg_random_with_add()\0A *                      or mbedtls_hmac_drbg_random().\0A *                      Only use this if your entropy source has sufficient\0A *                      throughput.\0A *\0A * \5Cparam ctx           The HMAC_DRBG context.\0A * \5Cparam resistance    #MBEDTLS_HMAC_DRBG_PR_ON or #MBEDTLS_HMAC_DRBG_PR_OFF.\0A */\0Avoid mbedtls_hmac_drbg_set_prediction_resistance(mbedtls_hmac_drbg_context *ctx,\0A                                                 int resistance);\0A\0A/**\0A * \5Cbrief               This function sets the amount of entropy grabbed on each\0A *                      seed or reseed.\0A *\0A * See the documentation of mbedtls_hmac_drbg_seed() for the default value.\0A *\0A * \5Cparam ctx           The HMAC_DRBG context.\0A * \5Cparam len           The amount of entropy to grab, in bytes.\0A */\0Avoid mbedtls_hmac_drbg_set_entropy_len(mbedtls_hmac_drbg_context *ctx,\0A                                       size_t len);\0A\0A/**\0A * \5Cbrief               Set the reseed interval.\0A *\0A * The reseed interval is the number of calls to mbedtls_hmac_drbg_random()\0A * or mbedtls_hmac_drbg_random_with_add() after which the entropy function\0A * is called again.\0A *\0A * The default value is #MBEDTLS_HMAC_DRBG_RESEED_INTERVAL.\0A *\0A * \5Cparam ctx           The HMAC_DRBG context.\0A * \5Cparam interval      The reseed interval.\0A */\0Avoid mbedtls_hmac_drbg_set_reseed_interval(mbedtls_hmac_drbg_context *ctx,\0A                                           int interval);\0A\0A/**\0A * \5Cbrief               This function updates the state of the HMAC_DRBG context.\0A *\0A * \5Cnote                This function is not thread-safe. It is not safe\0A *                      to call this function if another thread might be\0A *                      concurrently obtaining random numbers from the same\0A *                      context or updating or reseeding the same context.\0A *\0A * \5Cparam ctx           The HMAC_DRBG context.\0A * \5Cparam additional    The data to update the state with.\0A *                      If this is \5Cc NULL, there is no additional data.\0A * \5Cparam add_len       Length of \5Cp additional in bytes.\0A *                      Unused if \5Cp additional is \5Cc NULL.\0A *\0A * \5Creturn              \5Cc 0 on success, or an error from the underlying\0A *                      hash calculation.\0A */\0Aint mbedtls_hmac_drbg_update(mbedtls_hmac_drbg_context *ctx,\0A                             const unsigned char *additional, size_t add_len);\0A\0A/**\0A * \5Cbrief               This function reseeds the HMAC_DRBG context, that is\0A *                      extracts data from the entropy source.\0A *\0A * \5Cnote                This function is not thread-safe. It is not safe\0A *                      to call this function if another thread might be\0A *                      concurrently obtaining random numbers from the same\0A *                      context or updating or reseeding the same context.\0A *\0A * \5Cparam ctx           The HMAC_DRBG context.\0A * \5Cparam additional    Additional data to add to the state.\0A *                      If this is \5Cc NULL, there is no additional data\0A *                      and \5Cp len should be \5Cc 0.\0A * \5Cparam len           The length of the additional data.\0A *                      This must be at most #MBEDTLS_HMAC_DRBG_MAX_INPUT\0A *                      and also at most\0A *                      #MBEDTLS_HMAC_DRBG_MAX_SEED_INPUT - \5Cc entropy_len\0A *                      where \5Cc entropy_len is the entropy length\0A *                      (see mbedtls_hmac_drbg_set_entropy_len()).\0A *\0A * \5Creturn              \5Cc 0 if successful.\0A * \5Creturn              #MBEDTLS_ERR_HMAC_DRBG_ENTROPY_SOURCE_FAILED\0A *                      if a call to the entropy function failed.\0A */\0Aint mbedtls_hmac_drbg_reseed(mbedtls_hmac_drbg_context *ctx,\0A                             const unsigned char *additional, size_t len);\0A\0A/**\0A * \5Cbrief   This function updates an HMAC_DRBG instance with additional\0A *          data and uses it to generate random data.\0A *\0A * This function automatically reseeds if the reseed counter is exceeded\0A * or prediction resistance is enabled.\0A *\0A * \5Cnote                This function is not thread-safe. It is not safe\0A *                      to call this function if another thread might be\0A *                      concurrently obtaining random numbers from the same\0A *                      context or updating or reseeding the same context.\0A *\0A * \5Cparam p_rng         The HMAC_DRBG context. This must be a pointer to a\0A *                      #mbedtls_hmac_drbg_context structure.\0A * \5Cparam output        The buffer to fill.\0A * \5Cparam output_len    The length of the buffer in bytes.\0A *                      This must be at most #MBEDTLS_HMAC_DRBG_MAX_REQUEST.\0A * \5Cparam additional    Additional data to update with.\0A *                      If this is \5Cc NULL, there is no additional data\0A *                      and \5Cp add_len should be \5Cc 0.\0A * \5Cparam add_len       The length of the additional data.\0A *                      This must be at most #MBEDTLS_HMAC_DRBG_MAX_INPUT.\0A *\0A * \5Creturn              \5Cc 0 if successful.\0A * \5Creturn              #MBEDTLS_ERR_HMAC_DRBG_ENTROPY_SOURCE_FAILED\0A *                      if a call to the entropy source failed.\0A * \5Creturn              #MBEDTLS_ERR_HMAC_DRBG_REQUEST_TOO_BIG if\0A *                      \5Cp output_len > #MBEDTLS_HMAC_DRBG_MAX_REQUEST.\0A * \5Creturn              #MBEDTLS_ERR_HMAC_DRBG_INPUT_TOO_BIG if\0A *                      \5Cp add_len > #MBEDTLS_HMAC_DRBG_MAX_INPUT.\0A */\0Aint mbedtls_hmac_drbg_random_with_add(void *p_rng,\0A                                      unsigned char *output, size_t output_len,\0A                                      const unsigned char *additional,\0A                                      size_t add_len);\0A\0A/**\0A * \5Cbrief   This function uses HMAC_DRBG to generate random data.\0A *\0A * This function automatically reseeds if the reseed counter is exceeded\0A * or prediction resistance is enabled.\0A */\0A#if defined(MBEDTLS_THREADING_C)\0A/**\0A * \5Cnote                When Mbed TLS is built with threading support,\0A *                      it is safe to call mbedtls_ctr_drbg_random()\0A *                      from multiple threads. Other operations, including\0A *                      reseeding, are not thread-safe.\0A */\0A#endif /* MBEDTLS_THREADING_C */\0A/**\0A * \5Cparam p_rng         The HMAC_DRBG context. This must be a pointer to a\0A *                      #mbedtls_hmac_drbg_context structure.\0A * \5Cparam output        The buffer to fill.\0A * \5Cparam out_len       The length of the buffer in bytes.\0A *                      This must be at most #MBEDTLS_HMAC_DRBG_MAX_REQUEST.\0A *\0A * \5Creturn              \5Cc 0 if successful.\0A * \5Creturn              #MBEDTLS_ERR_HMAC_DRBG_ENTROPY_SOURCE_FAILED\0A *                      if a call to the entropy source failed.\0A * \5Creturn              #MBEDTLS_ERR_HMAC_DRBG_REQUEST_TOO_BIG if\0A *                      \5Cp out_len > #MBEDTLS_HMAC_DRBG_MAX_REQUEST.\0A */\0Aint mbedtls_hmac_drbg_random(void *p_rng, unsigned char *output, size_t out_len);\0A\0A/**\0A * \5Cbrief               This function resets HMAC_DRBG context to the state immediately\0A *                      after initial call of mbedtls_hmac_drbg_init().\0A *\0A * \5Cparam ctx           The HMAC_DRBG context to free.\0A */\0Avoid mbedtls_hmac_drbg_free(mbedtls_hmac_drbg_context *ctx);\0A\0A#if defined(MBEDTLS_FS_IO)\0A/**\0A * \5Cbrief               This function writes a seed file.\0A *\0A * \5Cparam ctx           The HMAC_DRBG context.\0A * \5Cparam path          The name of the file.\0A *\0A * \5Creturn              \5Cc 0 on success.\0A * \5Creturn              #MBEDTLS_ERR_HMAC_DRBG_FILE_IO_ERROR on file error.\0A * \5Creturn              #MBEDTLS_ERR_HMAC_DRBG_ENTROPY_SOURCE_FAILED on reseed\0A *                      failure.\0A */\0Aint mbedtls_hmac_drbg_write_seed_file(mbedtls_hmac_drbg_context *ctx, const char *path);\0A\0A/**\0A * \5Cbrief               This function reads and updates a seed file. The seed\0A *                      is added to this instance.\0A *\0A * \5Cparam ctx           The HMAC_DRBG context.\0A * \5Cparam path          The name of the file.\0A *\0A * \5Creturn              \5Cc 0 on success.\0A * \5Creturn              #MBEDTLS_ERR_HMAC_DRBG_FILE_IO_ERROR on file error.\0A * \5Creturn              #MBEDTLS_ERR_HMAC_DRBG_ENTROPY_SOURCE_FAILED on\0A *                      reseed failure.\0A * \5Creturn              #MBEDTLS_ERR_HMAC_DRBG_INPUT_TOO_BIG if the existing\0A *                      seed file is too large.\0A */\0Aint mbedtls_hmac_drbg_update_seed_file(mbedtls_hmac_drbg_context *ctx, const char *path);\0A#endif /* MBEDTLS_FS_IO */\0A\0A\0A#if defined(MBEDTLS_SELF_TEST)\0A/**\0A * \5Cbrief               The HMAC_DRBG Checkup routine.\0A *\0A * \5Creturn              \5Cc 0 if successful.\0A * \5Creturn              \5Cc 1 if the test failed.\0A */\0Aint mbedtls_hmac_drbg_self_test(int verbose);\0A#endif\0A\0A#ifdef __cplusplus\0A}\0A#endif\0A\0A#endif /* hmac_drbg.h */\0A\00" }
