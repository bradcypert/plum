@.str45746 = private global { i64, i64, [18091 x i8] } { i64 -1, i64 18090, [18091 x i8] c"/*\0A *  TCP/IP or UDP/IP networking functions\0A *\0A *  Copyright The Mbed TLS Contributors\0A *  SPDX-License-Identifier: Apache-2.0 OR GPL-2.0-or-later\0A */\0A\0A/* Enable definition of getaddrinfo() even when compiling with -std=c99. Must\0A * be set before mbedtls_config.h, which pulls in glibc's features.h indirectly.\0A * Harmless on other platforms. */\0A#ifndef _POSIX_C_SOURCE\0A#define _POSIX_C_SOURCE 200112L\0A#endif\0A#ifndef _XOPEN_SOURCE\0A#define _XOPEN_SOURCE 600 /* sockaddr_storage */\0A#endif\0A\0A#include \22common.h\22\0A\0A#if defined(MBEDTLS_NET_C)\0A\0A#if !defined(unix) && !defined(__unix__) && !defined(__unix) && \5C\0A    !defined(__APPLE__) && !defined(_WIN32) && !defined(__QNXNTO__) && \5C\0A    !defined(__HAIKU__) && !defined(__midipix__)\0A#error \22This module only works on Unix and Windows, see MBEDTLS_NET_C in mbedtls_config.h\22\0A#endif\0A\0A#include \22mbedtls/platform.h\22\0A\0A#include \22mbedtls/net_sockets.h\22\0A#include \22mbedtls/error.h\22\0A\0A#include <string.h>\0A\0A#if (defined(_WIN32) || defined(_WIN32_WCE)) && !defined(EFIX64) && \5C\0A    !defined(EFI32)\0A\0A#define IS_EINTR(ret) ((ret) == WSAEINTR)\0A\0A#include <ws2tcpip.h>\0A\0A#include <winsock2.h>\0A#include <windows.h>\0A#if (_WIN32_WINNT < 0x0501)\0A#include <wspiapi.h>\0A#endif\0A\0A#if defined(_MSC_VER)\0A#if defined(_WIN32_WCE)\0A#pragma comment( lib, \22ws2.lib\22 )\0A#else\0A#pragma comment( lib, \22ws2_32.lib\22 )\0A#endif\0A#endif /* _MSC_VER */\0A\0A#define read(fd, buf, len)        recv(fd, (char *) (buf), (int) (len), 0)\0A#define write(fd, buf, len)       send(fd, (char *) (buf), (int) (len), 0)\0A#define close(fd)               closesocket(fd)\0A\0Astatic int wsa_init_done = 0;\0A\0A#else /* ( _WIN32 || _WIN32_WCE ) && !EFIX64 && !EFI32 */\0A\0A#include <sys/types.h>\0A#include <sys/socket.h>\0A#include <netinet/in.h>\0A#include <arpa/inet.h>\0A#include <sys/time.h>\0A#include <unistd.h>\0A#include <signal.h>\0A#include <fcntl.h>\0A#include <netdb.h>\0A#include <errno.h>\0A\0A#define IS_EINTR(ret) ((ret) == EINTR)\0A#define SOCKET int\0A\0A#endif /* ( _WIN32 || _WIN32_WCE ) && !EFIX64 && !EFI32 */\0A\0A/* Some MS functions want int and MSVC warns if we pass size_t,\0A * but the standard functions use socklen_t, so cast only for MSVC */\0A#if defined(_MSC_VER)\0A#define MSVC_INT_CAST   (int)\0A#else\0A#define MSVC_INT_CAST\0A#endif\0A\0A#include <stdio.h>\0A\0A#if defined(MBEDTLS_HAVE_TIME)\0A#include <time.h>\0A#endif\0A\0A#include <stdint.h>\0A\0A/*\0A * Prepare for using the sockets interface\0A */\0Astatic int net_prepare(void)\0A{\0A#if (defined(_WIN32) || defined(_WIN32_WCE)) && !defined(EFIX64) && \5C\0A    !defined(EFI32)\0A    WSADATA wsaData;\0A\0A    if (wsa_init_done == 0) {\0A        if (WSAStartup(MAKEWORD(2, 0), &wsaData) != 0) {\0A            return MBEDTLS_ERR_NET_SOCKET_FAILED;\0A        }\0A\0A        wsa_init_done = 1;\0A    }\0A#else\0A#if !defined(EFIX64) && !defined(EFI32)\0A    signal(SIGPIPE, SIG_IGN);\0A#endif\0A#endif\0A    return 0;\0A}\0A\0A/*\0A * Return 0 if the file descriptor is valid, an error otherwise.\0A * If for_select != 0, check whether the file descriptor is within the range\0A * allowed for fd_set used for the FD_xxx macros and the select() function.\0A */\0Astatic int check_fd(int fd, int for_select)\0A{\0A    if (fd < 0) {\0A        return MBEDTLS_ERR_NET_INVALID_CONTEXT;\0A    }\0A\0A#if (defined(_WIN32) || defined(_WIN32_WCE)) && !defined(EFIX64) && \5C\0A    !defined(EFI32)\0A    (void) for_select;\0A#else\0A    /* A limitation of select() is that it only works with file descriptors\0A     * that are strictly less than FD_SETSIZE. This is a limitation of the\0A     * fd_set type. Error out early, because attempting to call FD_SET on a\0A     * large file descriptor is a buffer overflow on typical platforms. */\0A    if (for_select && fd >= FD_SETSIZE) {\0A        return 