@.str45969 = private global { i64, i64, [28539 x i8] } { i64 -1, i64 28538, [28539 x i8] c"/*\0A *  TLS 1.3 key schedule\0A *\0A *  Copyright The Mbed TLS Contributors\0A *  SPDX-License-Identifier: Apache-2.0 OR GPL-2.0-or-later\0A */\0A#if !defined(MBEDTLS_SSL_TLS1_3_KEYS_H)\0A#define MBEDTLS_SSL_TLS1_3_KEYS_H\0A\0A/* This requires MBEDTLS_SSL_TLS1_3_LABEL( idx, name, string ) to be defined at\0A * the point of use. See e.g. the definition of mbedtls_ssl_tls13_labels_union\0A * below. */\0A#define MBEDTLS_SSL_TLS1_3_LABEL_LIST                                             \5C\0A    MBEDTLS_SSL_TLS1_3_LABEL(finished, \22finished\22) \5C\0A    MBEDTLS_SSL_TLS1_3_LABEL(resumption, \22resumption\22) \5C\0A    MBEDTLS_SSL_TLS1_3_LABEL(traffic_upd, \22traffic upd\22) \5C\0A    MBEDTLS_SSL_TLS1_3_LABEL(exporter, \22exporter\22) \5C\0A    MBEDTLS_SSL_TLS1_3_LABEL(key, \22key\22) \5C\0A    MBEDTLS_SSL_TLS1_3_LABEL(iv, \22iv\22) \5C\0A    MBEDTLS_SSL_TLS1_3_LABEL(c_hs_traffic, \22c hs traffic\22) \5C\0A    MBEDTLS_SSL_TLS1_3_LABEL(c_ap_traffic, \22c ap traffic\22) \5C\0A    MBEDTLS_SSL_TLS1_3_LABEL(c_e_traffic, \22c e traffic\22) \5C\0A    MBEDTLS_SSL_TLS1_3_LABEL(s_hs_traffic, \22s hs traffic\22) \5C\0A    MBEDTLS_SSL_TLS1_3_LABEL(s_ap_traffic, \22s ap traffic\22) \5C\0A    MBEDTLS_SSL_TLS1_3_LABEL(s_e_traffic, \22s e traffic\22) \5C\0A    MBEDTLS_SSL_TLS1_3_LABEL(e_exp_master, \22e exp master\22) \5C\0A    MBEDTLS_SSL_TLS1_3_LABEL(res_master, \22res master\22) \5C\0A    MBEDTLS_SSL_TLS1_3_LABEL(exp_master, \22exp master\22) \5C\0A    MBEDTLS_SSL_TLS1_3_LABEL(ext_binder, \22ext binder\22) \5C\0A    MBEDTLS_SSL_TLS1_3_LABEL(res_binder, \22res binder\22) \5C\0A    MBEDTLS_SSL_TLS1_3_LABEL(derived, \22derived\22) \5C\0A    MBEDTLS_SSL_TLS1_3_LABEL(client_cv, \22TLS 1.3, client CertificateVerify\22) \5C\0A    MBEDTLS_SSL_TLS1_3_LABEL(server_cv, \22TLS 1.3, server CertificateVerify\22)\0A\0A#define MBEDTLS_SSL_TLS1_3_CONTEXT_UNHASHED 0\0A#define MBEDTLS_SSL_TLS1_3_CONTEXT_HASHED   1\0A\0A#define MBEDTLS_SSL_TLS1_3_PSK_EXTERNAL   0\0A#define MBEDTLS_SSL_TLS1_3_PSK_RESUMPTION 1\0A\0A#if defined(MBEDTLS_SSL_PROTO_TLS1_3)\0A\0A#define MBEDTLS_SSL_TLS1_3_LABEL(name, string)       \5C\0A    const unsigned char name    [sizeof(string) - 1];\0A\0Aunion mbedtls_ssl_tls13_labels_union {\0A    MBEDTLS_SSL_TLS1_3_LABEL_LIST\0A};\0Astruct mbedtls_ssl_tls13_labels_struct {\0A    MBEDTLS_SSL_TLS1_3_LABEL_LIST\0A};\0A#undef MBEDTLS_SSL_TLS1_3_LABEL\0A\0Aextern const struct mbedtls_ssl_tls13_labels_struct mbedtls_ssl_tls13_labels;\0A\0A#define MBEDTLS_SSL_TLS1_3_LBL_LEN(LABEL)  \5C\0A    sizeof(mbedtls_ssl_tls13_labels.LABEL)\0A\0A#define MBEDTLS_SSL_TLS1_3_LBL_WITH_LEN(LABEL)  \5C\0A    mbedtls_ssl_tls13_labels.LABEL,              \5C\0A    MBEDTLS_SSL_TLS1_3_LBL_LEN(LABEL)\0A\0A#define MBEDTLS_SSL_TLS1_3_KEY_SCHEDULE_MAX_LABEL_LEN  \5C\0A    sizeof(union mbedtls_ssl_tls13_labels_union)\0A\0A/* The maximum length of HKDF contexts used in the TLS 1.3 standard.\0A * Since contexts are always hashes of message transcripts, this can\0A * be approximated from above by the maximum hash size. */\0A#define MBEDTLS_SSL_TLS1_3_KEY_SCHEDULE_MAX_CONTEXT_LEN  \5C\0A    PSA_HASH_MAX_SIZE\0A\0A/* Maximum desired length for expanded key material generated\0A * by HKDF-Expand-Label.\0A *\0A * Warning: If this ever needs to be increased, the implementation\0A * ssl_tls13_hkdf_encode_label() in ssl_tls13_keys.c needs to be\0A * adjusted since it currently assumes that HKDF key expansion\0A * is never used with more than 255 Bytes of output. */\0A#define MBEDTLS_SSL_TLS1_3_KEY_SCHEDULE_MAX_EXPANSION_LEN 255\0A\0A/**\0A * \5Cbrief            The \5Cc HKDF-Expand-Label function from\0A *                   the TLS 1.3 standard RFC 8446.\0A *\0A * <tt>\0A *                   HKDF-Expand-Label( Secret, Label, Context, Length ) =\0A *                       HKDF-Expand( Secret, HkdfLabel, Length )\0A * </tt>\0A *\0A * \5Cparam hash_alg   The identifier for the hash algorithm to use.\0A * \5Cparam secret     The \5Cc Secret argument to \5Cc HKDF-Expand-Label.\0A *                   This must be a readable buffer of length\0A *                   \5Cp secret_len Bytes.\0A * \5Cparam secret_len The length of \5Cp secret in Bytes.\0A * \5Cparam label      The \5Cc Label argument to \5Cc HKDF-Expand-Label.\0A *                   This must be a readable buffer of length\0A *                   \5Cp label_len Bytes.\0A * \5Cparam label_len  The length of \5Cp label in Bytes.\0A * \5Cparam ctx        The \5Cc Context argument to \5Cc HKDF-Expand-Label.\0A *                   This must be a readable buffer of length \5Cp ctx_len Bytes.\0A * \5Cparam ctx_len    The length of \5Cp context in Bytes.\0A * \5Cparam buf        The destination buffer to hold the expanded secret.\0A *                   This must be a writable buffer of length \5Cp buf_len Bytes.\0A * \5Cparam buf_len    The desired size of the expanded secret in Bytes.\0A *\0A * \5Creturns          \5Cc 0 on success.\0A * \5Creturn           A negative error code on failure.\0A */\0A\0AMBEDTLS_CHECK_RETURN_CRITICAL\0Aint mbedtls_ssl_tls13_hkdf_expand_label(\0A    psa_algorithm_t hash_alg,\0A    const unsigned char *secret, size_t secret_len,\0A    const unsigned char *label, size_t label_len,\0A    const unsigned char *ctx, size_t ctx_len,\0A    unsigned char *buf, size_t buf_len);\0A\0A/**\0A * \5Cbrief           This function is part of the TLS 1.3 key schedule.\0A *                  It extracts key and IV for the actual client/server traffic\0A *                  from the client/server traffic secrets.\0A *\0A * From RFC 8446:\0A *\0A * <tt>\0A *   [sender]_write_key = HKDF-Expand-Label(Secret, \22key\22, \22\22, key_length)\0A *   [sender]_write_iv  = HKDF-Expand-Label(Secret, \22iv\22, \22\22, iv_length)*\0A * </tt>\0A *\0A * \5Cparam hash_alg      The identifier for the hash algorithm to be used\0A *                      for the HKDF-based expansion of the secret.\0A * \5Cparam client_secret The client traffic secret.\0A *                      This must be a readable buffer of size\0A *                      \5Cp secret_len Bytes\0A * \5Cparam server_secret The server traffic secret.\0A *                      This must be a readable buffer of size\0A *                      \5Cp secret_len Bytes\0A * \5Cparam secret_len    Length of the secrets \5Cp client_secret and\0A *                      \5Cp server_secret in Bytes.\0A * \5Cparam key_len       The desired length of the key to be extracted in Bytes.\0A * \5Cparam iv_len        The desired length of the IV to be extracted in Bytes.\0A * \5Cparam keys          The address of the structure holding the generated\0A *                      keys and IVs.\0A *\0A * \5Creturns             \5Cc 0 on success.\0A * \5Creturns             A negative error code on failure.\0A */\0A\0AMBEDTLS_CHECK_RETURN_CRITICAL\0Aint mbedtls_ssl_tls13_make_traffic_keys(\0A    psa_algorithm_t hash_alg,\0A    const unsigned char *client_secret,\0A    const unsigned char *server_secret, size_t secret_len,\0A    size_t key_len, size_t iv_len,\0A    mbedtls_ssl_key_set *keys);\0A\0A/**\0A * \5Cbrief The \5Cc Derive-Secret function from the TLS 1.3 standard RFC 8446.\0A *\0A * <tt>\0A *   Derive-Secret( Secret, Label, Messages ) =\0A *      HKDF-Expand-Label( Secret, Label,\0A *                         Hash( Messages ),\0A *                         Hash.Length ) )\0A * </tt>\0A *\0A * \5Cparam hash_alg   The identifier for the hash function used for the\0A *                   applications of HKDF.\0A * \5Cparam secret     The \5Cc Secret argument to the \5Cc Derive-Secret function.\0A *                   This must be a readable buffer of length\0A *                   \5Cp secret_len Bytes.\0A * \5Cparam secret_len The length of \5Cp secret in Bytes.\0A * \5Cparam label      The \5Cc Label argument to the \5Cc Derive-Secret function.\0A *                   This must be a readable buffer of length\0A *                   \5Cp label_len Bytes.\0A * \5Cparam label_len  The length of \5Cp label in Bytes.\0A * \5Cparam ctx        The hash of the \5Cc Messages argument to the\0A *                   \5Cc Derive-Secret function, or the \5Cc Messages argument\0A *                   itself, depending on \5Cp ctx_hashed.\0A * \5Cparam ctx_len    The length of \5Cp ctx in Bytes.\0A * \5Cparam ctx_hashed This indicates whether the \5Cp ctx contains the hash of\0A *                   the \5Cc Messages argument in the application of the\0A *                   \5Cc Derive-Secret function\0A *                   (value MBEDTLS_SSL_TLS1_3_CONTEXT_HASHED), or whether\0A *                   it is the content of \5Cc Messages itself, in which case\0A *                   the function takes care of the hashing\0A *                   (value MBEDTLS_SSL_TLS1_3_CONTEXT_UNHASHED).\0A * \5Cparam dstbuf     The target buffer to write the output of\0A *                   \5Cc Derive-Secret to. This must be a writable buffer of\0A *                   size \5Cp dtsbuf_len Bytes.\0A * \5Cparam dstbuf_len The length of \5Cp dstbuf in Bytes.\0A *\0A * \5Creturns        \5Cc 0 on success.\0A * \5Creturns        A negative error code on failure.\0A */\0AMBEDTLS_CHECK_RETURN_CRITICAL\0Aint mbedtls_ssl_tls13_derive_secret(\0A    psa_algorithm_t hash_alg,\0A    const unsigned char *secret, size_t secret_len,\0A    const unsigned char *label, size_t label_len,\0A    const unsigned char *ctx, size_t ctx_len,\0A    int ctx_hashed,\0A    unsigned char *dstbuf, size_t dstbuf_len);\0A\0A/**\0A * \5Cbrief Derive TLS 1.3 early data key material from early secret.\0A *\0A *        This is a small wrapper invoking mbedtls_ssl_tls13_derive_secret()\0A *        with the appropriate labels.\0A *\0A * <tt>\0A *        Early Secret\0A *             |\0A *             +-----> Derive-Secret(., \22c e traffic\22, ClientHello)\0A *             |                      = client_early_traffic_secret\0A *             |\0A *             +-----> Derive-Secret(., \22e exp master\22, ClientHello)\0A *             .                      = early_exporter_master_secret\0A *             .\0A *             .\0A * </tt>\0A *\0A * \5Cnote  To obtain the actual key and IV for the early data traffic,\0A *        the client secret derived by this function need to be\0A *        further processed by mbedtls_ssl_tls13_make_traffic_keys().\0A *\0A * \5Cnote  The binder key, which is also generated from the early secret,\0A *        is omitted here. Its calculation is part of the separate routine\0A *        mbedtls_ssl_tls13_create_psk_binder().\0A *\0A * \5Cparam hash_alg     The hash algorithm associated with the PSK for which\0A *                     early data key material is being derived.\0A * \5Cparam early_secret The early secret from which the early data key material\0A *                     should be derived. This must be a readable buffer whose\0A *                     length is the digest size of the hash algorithm\0A *                     represented by \5Cp md_size.\0A * \5Cparam transcript   The transcript of the handshake so far, calculated with\0A *                     respect to \5Cp hash_alg. This must be a readable buffer\0A *                     whose length is the digest size of the hash algorithm\0A *                     represented by \5Cp md_size.\0A * \5Cparam derived      The address of the structure in which to store\0A *                     the early data key material.\0A *\0A * \5Creturns        \5Cc 0 on success.\0A * \5Creturns        A negative error code on failure.\0A */\0AMBEDTLS_CHECK_RETURN_CRITICAL\0Aint mbedtls_ssl_tls13_derive_early_secrets(\0A    psa_algorithm_t hash_alg,\0A    unsigned char const *early_secret,\0A    unsigned char const *transcript, size_t transcript_len,\0A    mbedtls_ssl_tls13_early_secrets *derived);\0A\0A/**\0A * \5Cbrief Derive TLS 1.3 handshake key material from the handshake secret.\0A *\0A *        This is a small wrapper invoking mbedtls_ssl_tls13_derive_secret()\0A *        with the appropriate labels from the standard.\0A *\0A * <tt>\0A *        Handshake Secret\0A *              |\0A *              +-----> Derive-Secret( ., \22c hs traffic\22,\0A *              |                      ClientHello...ServerHello )\0A *              |                      = client_handshake_traffic_secret\0A *              |\0A *              +-----> Derive-Secret( ., \22s hs traffic\22,\0A *              .                      ClientHello...ServerHello )\0A *              .                      = server_handshake_traffic_secret\0A *              .\0A * </tt>\0A *\0A * \5Cnote  To obtain the actual key and IV for the encrypted handshake traffic,\0A *        the client and server secret derived by this function need to be\0A *        further processed by mbedtls_ssl_tls13_make_traffic_keys().\0A *\0A * \5Cparam hash_alg          The hash algorithm associated with the ciphersuite\0A *                          that's being used for the connection.\0A * \5Cparam handshake_secret  The handshake secret from which the handshake key\0A *                          material should be derived. This must be a readable\0A *                          buffer whose length is the digest size of the hash\0A *                          algorithm represented by \5Cp md_size.\0A * \5Cparam transcript        The transcript of the handshake so far, calculated\0A *                          with respect to \5Cp hash_alg. This must be a readable\0A *                          buffer whose length is the digest size of the hash\0A *                          algorithm represented by \5Cp md_size.\0A * \5Cparam derived           The address of the structure in which to\0A *                          store the handshake key material.\0A *\0A * \5Creturns        \5Cc 0 on success.\0A * \5Creturns        A negative error code on failure.\0A */\0AMBEDTLS_CHECK_RETURN_CRITICAL\0Aint mbedtls_ssl_tls13_derive_handshake_secrets(\0A    psa_algorithm_t hash_alg,\0A    unsigned char const *handshake_secret,\0A    unsigned char const *transcript, size_t transcript_len,\0A    mbedtls_ssl_tls13_handshake_secrets *derived);\0A\0A/**\0A * \5Cbrief Derive TLS 1.3 application key material from the master secret.\0A *\0A *        This is a small wrapper invoking mbedtls_ssl_tls13_derive_secret()\0A *        with the appropriate labels from the standard.\0A *\0A * <tt>\0A *        Master Secret\0A *              |\0A *              +-----> Derive-Secret( ., \22c ap traffic\22,\0A *              |                      ClientHello...server Finished )\0A *              |                      = client_application_traffic_secret_0\0A *              |\0A *              +-----> Derive-Secret( ., \22s ap traffic\22,\0A *              |                      ClientHello...Server Finished )\0A *              |                      = server_application_traffic_secret_0\0A *              |\0A *              +-----> Derive-Secret( ., \22exp master\22,\0A *              .                      ClientHello...server Finished)\0A *              .                      = exporter_master_secret\0A *              .\0A * </tt>\0A *\0A * \5Cnote  To obtain the actual key and IV for the (0-th) application traffic,\0A *        the client and server secret derived by this function need to be\0A *        further processed by mbedtls_ssl_tls13_make_traffic_keys().\0A *\0A * \5Cparam hash_alg          The hash algorithm associated with the ciphersuite\0A *                          that's being used for the connection.\0A * \5Cparam master_secret     The master secret from which the application key\0A *                          material should be derived. This must be a readable\0A *                          buffer whose length is the digest size of the hash\0A *                          algorithm represented by \5Cp md_size.\0A * \5Cparam transcript        The transcript of the handshake up to and including\0A *                          the ServerFinished message, calculated with respect\0A *                          to \5Cp hash_alg. This must be a readable buffer whose\0A *                          length is the digest size of the hash algorithm\0A *                          represented by \5Cp hash_alg.\0A * \5Cparam derived           The address of the structure in which to\0A *                          store the application key material.\0A *\0A * \5Creturns        \5Cc 0 on success.\0A * \5Creturns        A negative error code on failure.\0A */\0AMBEDTLS_CHECK_RETURN_CRITICAL\0Aint mbedtls_ssl_tls13_derive_application_secrets(\0A    psa_algorithm_t hash_alg,\0A    unsigned char const *master_secret,\0A    unsigned char const *transcript, size_t transcript_len,\0A    mbedtls_ssl_tls13_application_secrets *derived);\0A\0A/**\0A * \5Cbrief Derive TLS 1.3 resumption master secret from the master secret.\0A *\0A *        This is a small wrapper invoking mbedtls_ssl_tls13_derive_secret()\0A *        with the appropriate labels from the standard.\0A *\0A * \5Cparam hash_alg          The hash algorithm used in the application for which\0A *                          key material is being derived.\0A * \5Cparam application_secret The application secret from which the resumption master\0A *                          secret should be derived. This must be a readable\0A *                          buffer whose length is the digest size of the hash\0A *                          algorithm represented by \5Cp md_size.\0A * \5Cparam transcript        The transcript of the handshake up to and including\0A *                          the ClientFinished message, calculated with respect\0A *                          to \5Cp hash_alg. This must be a readable buffer whose\0A *                          length is the digest size of the hash algorithm\0A *                          represented by \5Cp hash_alg.\0A * \5Cparam transcript_len    The length of \5Cp transcript in Bytes.\0A * \5Cparam derived           The address of the structure in which to\0A *                          store the resumption master secret.\0A *\0A * \5Creturns        \5Cc 0 on success.\0A * \5Creturns        A negative error code on failure.\0A */\0AMBEDTLS_CHECK_RETURN_CRITICAL\0Aint mbedtls_ssl_tls13_derive_resumption_master_secret(\0A    psa_algorithm_t hash_alg,\0A    unsigned char const *application_secret,\0A    unsigned char const *transcript, size_t transcript_len,\0A    mbedtls_ssl_tls13_application_secrets *derived);\0A\0A/**\0A * \5Cbrief Compute the next secret in the TLS 1.3 key schedule\0A *\0A * The TLS 1.3 key schedule proceeds as follows to compute\0A * the three main secrets during the handshake: The early\0A * secret for early data, the handshake secret for all\0A * other encrypted handshake messages, and the master\0A * secret for all application traffic.\0A *\0A * <tt>\0A *                    0\0A *                    |\0A *                    v\0A *     PSK ->  HKDF-Extract = Early Secret\0A *                    |\0A *                    v\0A *     Derive-Secret( ., \22derived\22, \22\22 )\0A *                    |\0A *                    v\0A *  (EC)DHE -> HKDF-Extract = Handshake Secret\0A *                    |\0A *                    v\0A *     Derive-Secret( ., \22derived\22, \22\22 )\0A *                    |\0A *                    v\0A *     0 -> HKDF-Extract = Master Secret\0A * </tt>\0A *\0A * Each of the three secrets in turn is the basis for further\0A * key derivations, such as the derivation of traffic keys and IVs;\0A * see e.g. mbedtls_ssl_tls13_make_traffic_keys().\0A *\0A * This function implements one step in this evolution of secrets:\0A *\0A * <tt>\0A *                old_secret\0A *                    |\0A *                    v\0A *     Derive-Secret( ., \22derived\22, \22\22 )\0A *                    |\0A *                    v\0A *     input -> HKDF-Extract = new_secret\0A * </tt>\0A *\0A * \5Cparam hash_alg    The identifier for the hash function used for the\0A *                    applications of HKDF.\0A * \5Cparam secret_old  The address of the buffer holding the old secret\0A *                    on function entry. If not \5Cc NULL, this must be a\0A *                    readable buffer whose size matches the output size\0A *                    of the hash function represented by \5Cp hash_alg.\0A *                    If \5Cc NULL, an all \5Cc 0 array will be used instead.\0A * \5Cparam input       The address of the buffer holding the additional\0A *                    input for the key derivation (e.g., the PSK or the\0A *                    ephemeral (EC)DH secret). If not \5Cc NULL, this must be\0A *                    a readable buffer whose size \5Cp input_len Bytes.\0A *                    If \5Cc NULL, an all \5Cc 0 array will be used instead.\0A * \5Cparam input_len   The length of \5Cp input in Bytes.\0A * \5Cparam secret_new  The address of the buffer holding the new secret\0A *                    on function exit. This must be a writable buffer\0A *                    whose size matches the output size of the hash\0A *                    function represented by \5Cp hash_alg.\0A *                    This may be the same as \5Cp secret_old.\0A *\0A * \5Creturns           \5Cc 0 on success.\0A * \5Creturns           A negative error code on failure.\0A */\0A\0AMBEDTLS_CHECK_RETURN_CRITICAL\0Aint mbedtls_ssl_tls13_evolve_secret(\0A    psa_algorithm_t hash_alg,\0A    const unsigned char *secret_old,\0A    const unsigned char *input, size_t input_len,\0A    unsigned char *secret_new);\0A\0A/**\0A * \5Cbrief             Calculate a TLS 1.3 PSK binder.\0A *\0A * \5Cparam ssl         The SSL context. This is used for debugging only and may\0A *                    be \5Cc NULL if MBEDTLS_DEBUG_C is disabled.\0A * \5Cparam hash_alg    The hash algorithm associated to the PSK \5Cp psk.\0A * \5Cparam psk         The buffer holding the PSK for which to create a binder.\0A * \5Cparam psk_len     The size of \5Cp psk in bytes.\0A * \5Cparam psk_type    This indicates whether the PSK \5Cp psk is externally\0A *                    provisioned (#MBEDTLS_SSL_TLS1_3_PSK_EXTERNAL) or a\0A *                    resumption PSK (#MBEDTLS_SSL_TLS1_3_PSK_RESUMPTION).\0A * \5Cparam transcript  The handshake transcript up to the point where the\0A *                    PSK binder calculation happens. This must be readable,\0A *                    and its size must be equal to the digest size of\0A *                    the hash algorithm represented by \5Cp hash_alg.\0A * \5Cparam result      The address at which to store the PSK binder on success.\0A *                    This must be writable, and its size must be equal to the\0A *                    digest size of  the hash algorithm represented by\0A *                    \5Cp hash_alg.\0A *\0A * \5Creturns           \5Cc 0 on success.\0A * \5Creturns           A negative error code on failure.\0A */\0AMBEDTLS_CHECK_RETURN_CRITICAL\0Aint mbedtls_ssl_tls13_create_psk_binder(mbedtls_ssl_context *ssl,\0A                                        const psa_algorithm_t hash_alg,\0A                                        unsigned char const *psk, size_t psk_len,\0A                                        int psk_type,\0A                                        unsigned char const *transcript,\0A                                        unsigned char *result);\0A\0A/**\0A * \5Cbref Setup an SSL transform structure representing the\0A *       record protection mechanism used by TLS 1.3\0A *\0A * \5Cparam transform    The SSL transform structure to be created. This must have\0A *                     been initialized through mbedtls_ssl_transform_init() and\0A *                     not used in any other way prior to calling this function.\0A *                     In particular, this function does not clean up the\0A *                     transform structure prior to installing the new keys.\0A * \5Cparam endpoint     Indicates whether the transform is for the client\0A *                     (value #MBEDTLS_SSL_IS_CLIENT) or the server\0A *                     (value #MBEDTLS_SSL_IS_SERVER).\0A * \5Cparam ciphersuite  The numerical identifier for the ciphersuite to use.\0A *                     This must be one of the identifiers listed in\0A *                     ssl_ciphersuites.h.\0A * \5Cparam traffic_keys The key material to use. No reference is stored in\0A *                     the SSL transform being generated, and the caller\0A *                     should destroy the key material afterwards.\0A * \5Cparam ssl          (Debug-only) The SSL context to use for debug output\0A *                     in case of failure. This parameter is only needed if\0A *                     #MBEDTLS_DEBUG_C is set, and is ignored otherwise.\0A *\0A * \5Creturn             \5Cc 0 on success. In this case, \5Cp transform is ready to\0A *                     be used with mbedtls_ssl_transform_decrypt() and\0A *                     mbedtls_ssl_transform_encrypt().\0A * \5Creturn             A negative error code on failure.\0A */\0AMBEDTLS_CHECK_RETURN_CRITICAL\0Aint mbedtls_ssl_tls13_populate_transform(mbedtls_ssl_transform *transform,\0A                                         int endpoint,\0A                                         int ciphersuite,\0A                                         mbedtls_ssl_key_set const *traffic_keys,\0A                                         mbedtls_ssl_context *ssl);\0A\0A/*\0A * TLS 1.3 key schedule evolutions\0A *\0A *   Early -> Handshake -> Application\0A *\0A * Small wrappers around mbedtls_ssl_tls13_evolve_secret().\0A */\0A\0A/**\0A * \5Cbrief Begin TLS 1.3 key schedule by calculating early secret.\0A *\0A *        The TLS 1.3 key schedule can be viewed as a simple state machine\0A *        with states Initial -> Early -> Handshake -> Application, and\0A *        this function represents the Initial -> Early transition.\0A *\0A * \5Cparam ssl  The SSL context to operate on.\0A *\0A * \5Creturns    \5Cc 0 on success.\0A * \5Creturns    A negative error code on failure.\0A */\0AMBEDTLS_CHECK_RETURN_CRITICAL\0Aint mbedtls_ssl_tls13_key_schedule_stage_early(mbedtls_ssl_context *ssl);\0A\0A/**\0A * \5Cbrief Compute TLS 1.3 resumption master secret.\0A *\0A * \5Cparam ssl  The SSL context to operate on. This must be in\0A *             key schedule stage \5Cc Application, see\0A *             mbedtls_ssl_tls13_key_schedule_stage_application().\0A *\0A * \5Creturns    \5Cc 0 on success.\0A * \5Creturns    A negative error code on failure.\0A */\0AMBEDTLS_CHECK_RETURN_CRITICAL\0Aint mbedtls_ssl_tls13_compute_resumption_master_secret(mbedtls_ssl_context *ssl);\0A\0A/**\0A * \5Cbrief Calculate the verify_data value for the client or server TLS 1.3\0A * Finished message.\0A *\0A * \5Cparam ssl  The SSL context to operate on. This must be in\0A *             key schedule stage \5Cc Handshake, see\0A *             mbedtls_ssl_tls13_key_schedule_stage_application().\0A * \5Cparam dst        The address at which to write the verify_data value.\0A * \5Cparam dst_len    The size of \5Cp dst in bytes.\0A * \5Cparam actual_len The address at which to store the amount of data\0A *                   actually written to \5Cp dst upon success.\0A * \5Cparam which      The message to calculate the `verify_data` for:\0A *                   - #MBEDTLS_SSL_IS_CLIENT for the Client's Finished message\0A *                   - #MBEDTLS_SSL_IS_SERVER for the Server's Finished message\0A *\0A * \5Cnote       Both client and server call this function twice, once to\0A *             generate their own Finished message, and once to verify the\0A *             peer's Finished message.\0A\0A * \5Creturns    \5Cc 0 on success.\0A * \5Creturns    A negative error code on failure.\0A */\0AMBEDTLS_CHECK_RETURN_CRITICAL\0Aint mbedtls_ssl_tls13_calculate_verify_data(mbedtls_ssl_context *ssl,\0A                                            unsigned char *dst,\0A                                            size_t dst_len,\0A                                            size_t *actual_len,\0A                                            int which);\0A\0A#if defined(MBEDTLS_SSL_EARLY_DATA)\0A/**\0A * \5Cbrief Compute TLS 1.3 early transform\0A *\0A * \5Cparam ssl  The SSL context to operate on.\0A *\0A * \5Creturns    \5Cc 0 on success.\0A * \5Creturns    A negative error code on failure.\0A *\0A * \5Cwarning    The function does not compute the early master secret. Call\0A *             mbedtls_ssl_tls13_key_schedule_stage_early() before to\0A *             call this function to generate the early master secret.\0A * \5Cnote       For a client/server endpoint, the function computes only the\0A *             encryption/decryption part of the transform as the decryption/\0A *             encryption part is not defined by the specification (no early\0A *             traffic from the server to the client).\0A */\0AMBEDTLS_CHECK_RETURN_CRITICAL\0Aint mbedtls_ssl_tls13_compute_early_transform(mbedtls_ssl_context *ssl);\0A#endif /* MBEDTLS_SSL_EARLY_DATA */\0A\0A/**\0A * \5Cbrief Compute TLS 1.3 handshake transform\0A *\0A * \5Cparam ssl  The SSL context to operate on. The early secret must have been\0A *             computed.\0A *\0A * \5Creturns    \5Cc 0 on success.\0A * \5Creturns    A negative error code on failure.\0A */\0AMBEDTLS_CHECK_RETURN_CRITICAL\0Aint mbedtls_ssl_tls13_compute_handshake_transform(mbedtls_ssl_context *ssl);\0A\0A/**\0A * \5Cbrief Compute TLS 1.3 application transform\0A *\0A * \5Cparam ssl  The SSL context to operate on. The early secret must have been\0A *             computed.\0A *\0A * \5Creturns    \5Cc 0 on success.\0A * \5Creturns    A negative error code on failure.\0A */\0AMBEDTLS_CHECK_RETURN_CRITICAL\0Aint mbedtls_ssl_tls13_compute_application_transform(mbedtls_ssl_context *ssl);\0A\0A#if defined(MBEDTLS_SSL_TLS1_3_KEY_EXCHANGE_MODE_SOME_PSK_ENABLED)\0A/**\0A * \5Cbrief Export TLS 1.3 PSK from handshake context\0A *\0A * \5Cparam[in]   ssl  The SSL context to operate on.\0A * \5Cparam[out]  psk  PSK output pointer.\0A * \5Cparam[out]  psk_len Length of PSK.\0A *\0A * \5Creturns     \5Cc 0 if there is a configured PSK and it was exported\0A *              successfully.\0A * \5Creturns     A negative error code on failure.\0A */\0AMBEDTLS_CHECK_RETURN_CRITICAL\0Aint mbedtls_ssl_tls13_export_handshake_psk(mbedtls_ssl_context *ssl,\0A                                           unsigned char **psk,\0A                                           size_t *psk_len);\0A#endif\0A\0A#endif /* MBEDTLS_SSL_PROTO_TLS1_3 */\0A\0A#endif /* MBEDTLS_SSL_TLS1_3_KEYS_H */\0A\00" }
@.const45971 = private global <{ i64, ptr, ptr, i1, [7 x i8] }> <{ i64 -1, ptr @.str45967, ptr @.str45969, i1 0, [7 x i8] zeroinitializer }>
