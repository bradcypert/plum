ty */\0A    mbedtls_psa_cipher_operation_t mbedtls_ctx;\0A#if defined(PSA_CRYPTO_DRIVER_TEST)\0A    mbedtls_transparent_test_driver_cipher_operation_t transparent_test_driver_ctx;\0A    mbedtls_opaque_test_driver_cipher_operation_t opaque_test_driver_ctx;\0A#endif\0A} psa_driver_cipher_context_t;\0A\0A#endif /* PSA_CRYPTO_DRIVER_CONTEXTS_PRIMITIVES_H */\0A/* End of automatically generated file. */\0A\00" }
