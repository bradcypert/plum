ontext *ssl);\0A\0A#if defined(PSA_WANT_ALG_ECDH) || defined(PSA_WANT_ALG_FFDH)\0AMBEDTLS_CHECK_RETURN_CRITICAL\0Aint mbedtls_ssl_tls13_generate_and_write_xxdh_key_exchange(\0A    mbedtls_ssl_context *ssl,\0A    uint16_t named_group,\0A    unsigned char *buf,\0A    unsigned char *end,\0A    size_t *out_len);\0A#endif /* PSA_WANT_ALG_ECDH || PSA_WANT_ALG_FFDH */\0A\0A#if defined(MBEDTLS_SSL_EARLY_DATA)\0Aint mbedtls_ssl_tls13_write_early_data_ext(mbedtls_ssl_context *ssl,\0A                                           int in_new_session_ticket,\0A                                           unsigned char *buf,\0A                                           const unsigned char *end,\0A                                           size_t *out_len);\0A\0Aint mbedtls_ssl_tls13_check_early_data_len(mbedtls_ssl_context *ssl,\0A                                           size_t early_data_len);\0A\0Atypedef enum {\0A/*\0A * The client has not sent the first ClientHello yet, the negotiation of early\0A * data has not started yet.\0A */\0A    MBEDTLS_SSL_EARLY_DATA_STATE_IDLE,\0A\0A/*\0A * In its ClientHello, the client has not included an early data indication\0A * extension.\0A */\0A    MBEDTLS_SSL_EARLY_DATA_STATE_NO_IND_SENT,\0A\0A/*\0A * The client has sent an early data indication extension in its first\0A * ClientHello, it has not received the response (ServerHello or\0A * HelloRetryRequest) from the server yet. The transform to protect early data\0A * is not set either as for middlebox compatibility a dummy CCS may have to be\0A * sent in clear. Early data cannot be sent to the server yet.\0A */\0A    MBEDTLS_SSL_EARLY_DATA_STATE_IND_SENT,\0A\0A/*\0A * The client has sent an early data indication extension in its first\0A * ClientHello, it has not received the response (ServerHello or\0A * HelloRetryRequest) from the server yet. The transform to protect early data\0A * has been set and early data can be written now.\0A */\0A    MBEDTLS_SSL_EARLY_DATA_STATE_CAN_WRITE,\0A\0A/*\0A * The client has indicated the use of early data and the server has accepted\0A * it.\0A */\0A    MBEDTLS_SSL_EARLY_DATA_STATE_ACCEPTED,\0A\0A/*\0A * The client has indicated the use of early data but the server has rejected\0A * it.\0A */\0A    MBEDTLS_SSL_EARLY_DATA_STATE_REJECTED,\0A\0A/*\0A * The client has sent an early data indication extension in its first\0A * ClientHello, the server has accepted them and the client has received the\0A * server Finished message. It cannot send early data to the server anymore.\0A */\0A    MBEDTLS_SSL_EARLY_DATA_STATE_SERVER_FINISHED_RECEIVED,\0A\0A} mbedtls_ssl_early_data_state;\0A#endif /* MBEDTLS_SSL_EARLY_DATA */\0A\0A#endif /* MBEDTLS_SSL_PROTO_TLS1_3 */\0A\0A#if defined(MBEDTLS_SSL_HANDSHAKE_WITH_CERT_ENABLED)\0A/*\0A * Write Signature Algorithm extension\0A */\0AMBEDTLS_CHECK_RETURN_CRITICAL\0Aint mbedtls_ssl_write_sig_alg_ext(mbedtls_ssl_context *ssl, unsigned char *buf,\0A                                  const unsigned char *end, size_t *out_len);\0A/*\0A * Parse TLS Signature Algorithm extension\0A */\0AMBEDTLS_CHECK_RETURN_CRITICAL\0Aint mbedtls_ssl_parse_sig_alg_ext(mbedtls_ssl_context *ssl,\0A                                  const unsigned char *buf,\0A                                  const unsigned char *end);\0A#endif /* MBEDTLS_SSL_HANDSHAKE_WITH_CERT_ENABLED */\0A\0A/* Get handshake transcript */\0AMBEDTLS_CHECK_RETURN_CRITICAL\0Aint mbedtls_ssl_get_handshake_transcript(mbedtls_ssl_context *ssl,\0A                                         const mbedtls_md_type_t md,\0A                                         unsigned char *dst,\0A                                         size_t dst_len,\0A                                         size_t *olen);\0A\0A/*\0A * Return supported groups.\0A *\0A * In future, invocations can be changed to ssl->conf->group_list\0A * when mbedtls_ssl_conf_curves() is deleted.\0A *\0A * ssl->handshake->group_list is either a translation of curve_list to IANA TLS group\0A * identifiers when mbedtls_ssl_conf_curves() has been used, or a pointer to\0A * ssl->conf->group_list when mbedtls_ssl_conf_groups() has been more recently invoked.\0A *\0A */\0Astatic inline const void *mbedtls_ssl_get_groups(const mbedtls_ssl_context *ssl)\0A{\0A    #if defined(MBEDTLS_DEPRECATED_REMOVED) || !defined(MBEDTLS_ECP_C)\0A    return ssl->conf->group_list;\0A    #else\0A    if ((ssl->handshake != NULL) && (ssl->handshake->group_list != NULL)) {\0A        return ssl->handshake->group_list;\0A    } else {\0A        return ssl->conf->group_list;\0A    }\0A    #endif\0A}\0A\0A/*\0A * Helper functions for NamedGroup.\0A */\0Astatic inline int mbedtls_ssl_tls12_named_group_is_ecdhe(uint16_t named_group)\0A{\0A    /*\0A     * RFC 8422 section 5.1.1\0A     */\0A    return named_group == MBEDTLS_SSL_IANA_TLS_GROUP_X25519    ||\0A           named_group == MBEDTLS_SSL_IANA_TLS_GROUP_BP256R1   ||\0A           named_group == MBEDTLS_SSL_IANA_TLS_GROUP_BP384R1   ||\0A           named_group == MBEDTLS_SSL_IANA_TLS_GROUP_BP512R1   ||\0A           named_group == MBEDTLS_SSL_IANA_TLS_GROUP_X448      ||\0A           /* Below deprecated curves should be removed with notice to users */\0A           named_group == MBEDTLS_SSL_IANA_TLS_GROUP_SECP192K1 ||\0A           named_group == MBEDTLS_SSL_IANA_TLS_GROUP_SECP192R1 ||\0A           named_group == MBEDTLS_SSL_IANA_TLS_GROUP_SECP224K1 ||\0A           named_group == MBEDTLS_SSL_IANA_TLS_GROUP_SECP224R1 ||\0A           named_group == MBEDTLS_SSL_IANA_TLS_GROUP_SECP256K1 ||\0A           named_group == MBEDTLS_SSL_IANA_TLS_GROUP_SECP256R1 ||\0A           named_group == MBEDTLS_SSL_IANA_TLS_GROUP_SECP384R1 ||\0A           named_group == MBEDTLS_SSL_IANA_TLS_GROUP_SECP521R1;\0A}\0A\0Astatic inline int mbedtls_ssl_tls13_named_group_is_ecdhe(uint16_t named_group)\0A{\0A    return named_group == MBEDTLS_SSL_IANA_TLS_GROUP_X25519    ||\0A           named_group == MBEDTLS_SSL_IANA_TLS_GROUP_SECP256R1 ||\0A           named_group == MBEDTLS_SSL_IANA_TLS_GROUP_SECP384R1 ||\0A           named_group == MBEDTLS_SSL_IANA_TLS_GROUP_SECP521R1 ||\0A           named_group == MBEDTLS_SSL_IANA_TLS_GROUP_X448;\0A}\0A\0Astatic inline int mbedtls_ssl_tls13_named_group_is_ffdh(uint16_t named_group)\0A{\0A    return named_group >= MBEDTLS_SSL_IANA_TLS_GROUP_FFDHE2048 &&\0A           named_group <= MBEDTLS_SSL_IANA_TLS_GROUP_FFDHE8192;\0A}\0A\0Astatic inline int mbedtls_ssl_named_group_is_offered(\0A    const mbedtls_ssl_context *ssl, uint16_t named_group)\0A{\0A    const uint16_t *group_list = mbedtls_ssl_get_groups(ssl);\0A\0A    if (group_list == NULL) {\0A        return 0;\0A    }\0A\0A    for (; *group_list != 0; group_list++) {\0A        if (*group_list == named_group) {\0A            return 1;\0A        }\0A    }\0A\0A    return 0;\0A}\0A\0Astatic inline int mbedtls_ssl_named_group_is_supported(uint16_t named_group)\0A{\0A#if defined(PSA_WANT_ALG_ECDH)\0A    if (mbedtls_ssl_tls13_named_group_is_ecdhe(named_group)) {\0A        if (mbedtls_ssl_get_ecp_group_id_from_tls_id(named_group) !=\0A            MBEDTLS_ECP_DP_NONE) {\0A            return 1;\0A        }\0A    }\0A#endif\0A#if defined(PSA_WANT_ALG_FFDH)\0A    if (mbedtls_ssl_tls13_named_group_is_ffdh(named_group)) {\0A        return 1;\0A    }\0A#endif\0A#if !defined(PSA_WANT_ALG_ECDH) && !defined(PSA_WANT_ALG_FFDH)\0A    (void) named_group;\0A#endif\0A    return 0;\0A}\0A\0A/*\0A * Return supported signature algorithms.\0A *\0A * In future, invocations can be changed to ssl->conf->sig_algs when\0A * mbedtls_ssl_conf_sig_hashes() is deleted.\0A *\0A * ssl->handshake->sig_algs is either a translation of sig_hashes to IANA TLS\0A * signature algorithm identifiers when mbedtls_ssl_conf_sig_hashes() has been\0A * used, or a pointer to ssl->conf->sig_algs when mbedtls_ssl_conf_sig_algs() has\0A * been more recently invoked.\0A *\0A */\0Astatic inline const void *mbedtls_ssl_get_sig_algs(\0A    const mbedtls_ssl_context *ssl)\0A{\0A#if defined(MBEDTLS_SSL_HANDSHAKE_WITH_CERT_ENABLED)\0A\0A#if !defined(MBEDTLS_DEPRECATED_REMOVED)\0A    if (ssl->handshake != NULL &&\0A        ssl->handshake->sig_algs_heap_allocated == 1 &&\0A        ssl->handshake->sig_algs != NULL) {\0A        return ssl->handshake->sig_algs;\0A    }\0A#endif\0A    return ssl->conf->sig_algs;\0A\0A#else /* MBEDTLS_SSL_HANDSHAKE_WITH_CERT_ENABLED */\0A\0A    ((void) ssl);\0A    return NULL;\0A#endif /* MBEDTLS_SSL_HANDSHAKE_WITH_CERT_ENABLED */\0A}\0A\0A#if defined(MBEDTLS_SSL_TLS1_3_KEY_EXCHANGE_MODE_EPHEMERAL_ENABLED)\0Astatic inline int mbedtls_ssl_sig_alg_is_received(const mbedtls_ssl_context *ssl,\0A                                                  uint16_t own_sig_alg)\0A{\0A    const uint16_t *sig_alg = ssl->handshake->received_sig_algs;\0A    if (sig_alg == NULL) {\0A        return 0;\0A    }\0A\0A    for (; *sig_alg != MBEDTLS_TLS_SIG_NONE; sig_alg++) {\0A        if (*sig_alg == own_sig_alg) {\0A            return 1;\0A        }\0A    }\0A    return 0;\0A}\0A\0Astatic inline int mbedtls_ssl_tls13_sig_alg_for_cert_verify_is_supported(\0A    const uint16_t sig_alg)\0A{\0A    switch (sig_alg) {\0A#if defined(MBEDTLS_PK_CAN_ECDSA_SOME)\0A#if defined(PSA_WANT_ALG_SHA_256) && defined(PSA_WANT_ECC_SECP_R1_256)\0A        case MBEDTLS_TLS1_3_SIG_ECDSA_SECP256R1_SHA256:\0A            break;\0A#endif /* PSA_WANT_ALG_SHA_256 && MBEDTLS_ECP_DP_SECP256R1_ENABLED */\0A#if defined(PSA_WANT_ALG_SHA_384) && defined(PSA_WANT_ECC_SECP_R1_384)\0A        case MBEDTLS_TLS1_3_SIG_ECDSA_SECP384R1_SHA384:\0A            break;\0A#endif /* PSA_WANT_ALG_SHA_384 && MBEDTLS_ECP_DP_SECP384R1_ENABLED */\0A#if defined(PSA_WANT_ALG_SHA_512) && defined(PSA_WANT_ECC_SECP_R1_521)\0A        case MBEDTLS_TLS1_3_SIG_ECDSA_SECP521R1_SHA512:\0A            break;\0A#endif /* PSA_WANT_ALG_SHA_512 && MBEDTLS_ECP_DP_SECP521R1_ENABLED */\0A#endif /* MBEDTLS_PK_CAN_ECDSA_SOME */\0A\0A#if defined(MBEDTLS_PKCS1_V21)\0A#if defined(PSA_WANT_ALG_SHA_256)\0A        case MBEDTLS_TLS1_3_SIG_RSA_PSS_RSAE_SHA256:\0A            break;\0A#endif /* PSA_WANT_ALG_SHA_256  */\0A#if defined(PSA_WANT_ALG_SHA_384)\0A        case MBEDTLS_TLS1_3_SIG_RSA_PSS_RSAE_SHA384:\0A            break;\0A#endif /* PSA_WANT_ALG_SHA_384 */\0A#if defined(PSA_WANT_ALG_SHA_512)\0A        case MBEDTLS_TLS1_3_SIG_RSA_PSS_RSAE_SHA512:\0A            break;\0A#endif /* PSA_WANT_ALG_SHA_512 */\0A#endif /* MBEDTLS_PKCS1_V21 */\0A        default:\0A            return 0;\0A    }\0A    return 1;\0A\0A}\0A\0Astatic inline int mbedtls_ssl_tls13_sig_alg_is_supported(\0A    const uint16_t sig_alg)\0A{\0A    switch (sig_alg) {\0A#if defined(MBEDTLS_PKCS1_V15)\0A#if defined(MBEDTLS_MD_CAN_SHA256)\0A        case MBEDTLS_TLS1_3_SIG_RSA_PKCS1_SHA256:\0A            break;\0A#endif /* MBEDTLS_MD_CAN_SHA256 */\0A#if defined(MBEDTLS_MD_CAN_SHA384)\0A        case MBEDTLS_TLS1_3_SIG_RSA_PKCS1_SHA384:\0A            break;\0A#endif /* MBEDTLS_MD_CAN_SHA384 */\0A#if defined(MBEDTLS_MD_CAN_SHA512)\0A        case MBEDTLS_TLS1_3_SIG_RSA_PKCS1_SHA512:\0A            break;\0A#endif /* MBEDTLS_MD_CAN_SHA512 */\0A#endif /* MBEDTLS_PKCS1_V15 */\0A        default:\0A            return mbedtls_ssl_tls13_sig_alg_for_cert_verify_is_supported(\0A                sig_alg);\0A    }\0A    return 1;\0A}\0A\0AMBEDTLS_CHECK_RETURN_CRITICAL\0Aint mbedtls_ssl_tls13_check_sig_alg_cert_key_match(uint16_t sig_alg,\0A                                                   mbedtls_pk_context *key);\0A#endif /* MBEDTLS_SSL_TLS1_3_KEY_EXCHANGE_MODE_EPHEMERAL_ENABLED */\0A\0A#if defined(MBEDTLS_SSL_HANDSHAKE_WITH_CERT_ENABLED)\0Astatic inline int mbedtls_ssl_sig_alg_is_offered(const mbedtls_ssl_context *ssl,\0A                                                 uint16_t proposed_sig_alg)\0A{\0A    const uint16_t *sig_alg = mbedtls_ssl_get_sig_algs(ssl);\0A    if (sig_alg == NULL) {\0A        return 0;\0A    }\0A\0A    for (; *sig_alg != MBEDTLS_TLS_SIG_NONE; sig_alg++) {\0A        if (*sig_alg == proposed_sig_alg) {\0A            return 1;\0A        }\0A    }\0A    return 0;\0A}\0A\0Astatic inline int mbedtls_ssl_get_pk_type_and_md_alg_from_sig_alg(\0A    uint16_t sig_alg, mbedtls_pk_type_t *pk_type, mbedtls_md_type_t *md_alg)\0A{\0A    *pk_type = mbedtls_ssl_pk_alg_from_sig(sig_alg & 0xff);\0A    *md_alg = mbedtls_ssl_md_alg_from_hash((sig_alg >> 8) & 0xff);\0A\0A    if (*pk_type != MBEDTLS_PK_NONE && *md_alg != MBEDTLS_MD_NONE) {\0A        return 0;\0A    }\0A\0A    switch (sig_alg) {\0A#if defined(MBEDTLS_PKCS1_V21)\0A#if defined(MBEDTLS_MD_CAN_SHA256)\0A        case MBEDTLS_TLS1_3_SIG_RSA_PSS_RSAE_SHA256:\0A            *md_alg = MBEDTLS_MD_SHA256;\0A            *pk_type = MBEDTLS_PK_RSASSA_PSS;\0A            break;\0A#endif /* MBEDTLS_MD_CAN_SHA256  */\0A#if defined(MBEDTLS_MD_CAN_SHA384)\0A        case MBEDTLS_TLS1_3_SIG_RSA_PSS_RSAE_SHA384:\0A            *md_alg = MBEDTLS_MD_SHA384;\0A            *pk_type = MBEDTLS_PK_RSASSA_PSS;\0A            break;\0A#endif /* MBEDTLS_MD_CAN_SHA384 */\0A#if defined(MBEDTLS_MD_CAN_SHA512)\0A        case MBEDTLS_TLS1_3_SIG_RSA_PSS_RSAE_SHA512:\0A            *md_alg = MBEDTLS_MD_SHA512;\0A            *pk_type = MBEDTLS_PK_RSASSA_PSS;\0A            break;\0A#endif /* MBEDTLS_MD_CAN_SHA512 */\0A#endif /* MBEDTLS_PKCS1_V21 */\0A        default:\0A            return MBEDTLS_ERR_SSL_FEATURE_UNAVAILABLE;\0A    }\0A    return 0;\0A}\0A\0A#if defined(MBEDTLS_SSL_PROTO_TLS1_2)\0Astatic inline int mbedtls_ssl_tls12_sig_alg_is_supported(\0A    const uint16_t sig_alg)\0A{\0A    /* High byte is hash */\0A    unsigned char hash = MBEDTLS_BYTE_1(sig_alg);\0A    unsigned char sig = MBEDTLS_BYTE_0(sig_alg);\0A\0A    switch (hash) {\0A#if defined(MBEDTLS_MD_CAN_MD5)\0A        case MBEDTLS_SSL_HASH_MD5:\0A            break;\0A#endif\0A\0A#if defined(MBEDTLS_MD_CAN_SHA1)\0A        case MBEDTLS_SSL_HASH_SHA1:\0A            break;\0A#endif\0A\0A#if defined(MBEDTLS_MD_CAN_SHA224)\0A        case MBEDTLS_SSL_HASH_SHA224:\0A            break;\0A#endif\0A\0A#if defined(MBEDTLS_MD_CAN_SHA256)\0A        case MBEDTLS_SSL_HASH_SHA256:\0A            break;\0A#endif\0A\0A#if defined(MBEDTLS_MD_CAN_SHA384)\0A        case MBEDTLS_SSL_HASH_SHA384:\0A            break;\0A#endif\0A\0A#if defined(MBEDTLS_MD_CAN_SHA512)\0A        case MBEDTLS_SSL_HASH_SHA512:\0A            break;\0A#endif\0A\0A        default:\0A            return 0;\0A    }\0A\0A    switch (sig) {\0A#if defined(MBEDTLS_RSA_C)\0A        case MBEDTLS_SSL_SIG_RSA:\0A            break;\0A#endif\0A\0A#if defined(MBEDTLS_KEY_EXCHANGE_ECDSA_CERT_REQ_ALLOWED_ENABLED)\0A        case MBEDTLS_SSL_SIG_ECDSA:\0A            break;\0A#endif\0A\0A        default:\0A            return 0;\0A    }\0A\0A    return 1;\0A}\0A#endif /* MBEDTLS_SSL_PROTO_TLS1_2 */\0A\0Astatic inline int mbedtls_ssl_sig_alg_is_supported(\0A    const mbedtls_ssl_context *ssl,\0A    const uint16_t sig_alg)\0A{\0A\0A#if defined(MBEDTLS_SSL_PROTO_TLS1_2)\0A    if (ssl->tls_version == MBEDTLS_SSL_VERSION_TLS1_2) {\0A        return mbedtls_ssl_tls12_sig_alg_is_supported(sig_alg);\0A    }\0A#endif /* MBEDTLS_SSL_PROTO_TLS1_2 */\0A\0A#if defined(MBEDTLS_SSL_TLS1_3_KEY_EXCHANGE_MODE_EPHEMERAL_ENABLED)\0A    if (ssl->tls_version == MBEDTLS_SSL_VERSION_TLS1_3) {\0A        return mbedtls_ssl_tls13_sig_alg_is_supported(sig_alg);\0A    }\0A#endif\0A    ((void) ssl);\0A    ((void) sig_alg);\0A    return 0;\0A}\0A#endif /* MBEDTLS_SSL_HANDSHAKE_WITH_CERT_ENABLED */\0A\0A#if defined(MBEDTLS_USE_PSA_CRYPTO) || defined(MBEDTLS_SSL_PROTO_TLS1_3)\0A/* Corresponding PSA algorithm for MBEDTLS_CIPHER_NULL.\0A * Same value is used for PSA_ALG_CATEGORY_CIPHER, hence it is\0A * guaranteed to not be a valid PSA algorithm identifier.\0A */\0A#define MBEDTLS_SSL_NULL_CIPHER 0x04000000\0A\0A/**\0A * \5Cbrief       Translate mbedtls cipher type/taglen pair to psa:\0A *              algorithm, key type and key size.\0A *\0A * \5Cparam  mbedtls_cipher_type [in] given mbedtls cipher type\0A * \5Cparam  taglen              [in] given tag length\0A *                                  0 - default tag length\0A * \5Cparam  alg                 [out] corresponding PSA alg\0A *                                   There is no corresponding PSA\0A *                                   alg for MBEDTLS_CIPHER_NULL, so\0A *                                   in this case MBEDTLS_SSL_NULL_CIPHER\0A *                                   is returned via this parameter\0A * \5Cparam  key_type            [out] corresponding PSA key type\0A * \5Cparam  key_size            [out] corresponding PSA key size\0A *\0A * \5Creturn                     PSA_SUCCESS on success or PSA_ERROR_NOT_SUPPORTED if\0A *                             conversion is not supported.\0A */\0Apsa_status_t mbedtls_ssl_cipher_to_psa(mbedtls_cipher_type_t mbedtls_cipher_type,\0A                                       size_t taglen,\0A                                       psa_algorithm_t *alg,\0A                                       psa_key_type_t *key_type,\0A                                       size_t *key_size);\0A\0A#if !defined(MBEDTLS_DEPRECATED_REMOVED)\0A/**\0A * \5Cbrief       Convert given PSA status to mbedtls error code.\0A *\0A * \5Cparam  status      [in] given PSA status\0A *\0A * \5Creturn             corresponding mbedtls error code\0A */\0Astatic inline MBEDTLS_DEPRECATED int psa_ssl_status_to_mbedtls(psa_status_t status)\0A{\0A    switch (status) {\0A        case PSA_SUCCESS:\0A            return 0;\0A        case PSA_ERROR_INSUFFICIENT_MEMORY:\0A            return MBEDTLS_ERR_SSL_ALLOC_FAILED;\0A        case PSA_ERROR_NOT_SUPPORTED:\0A            return MBEDTLS_ERR_SSL_FEATURE_UNAVAILABLE;\0A        case PSA_ERROR_INVALID_SIGNATURE:\0A            return MBEDTLS_ERR_SSL_INVALID_MAC;\0A        case PSA_ERROR_INVALID_ARGUMENT:\0A            return MBEDTLS_ERR_SSL_BAD_INPUT_DATA;\0A        case PSA_ERROR_BAD_STATE:\0A            return MBEDTLS_ERR_SSL_INTERNAL_ERROR;\0A        case PSA_ERROR_BUFFER_TOO_SMALL:\0A            return MBEDTLS_ERR_SSL_BUFFER_TOO_SMALL;\0A        default:\0A            return MBEDTLS_ERR_PLATFORM_HW_ACCEL_FAILED;\0A    }\0A}\0A#endif /* !MBEDTLS_DEPRECATED_REMOVED */\0A#endif /* MBEDTLS_USE_PSA_CRYPTO || MBEDTLS_SSL_PROTO_TLS1_3 */\0A\0A#if defined(MBEDTLS_KEY_EXCHANGE_ECJPAKE_ENABLED) && \5C\0A    defined(MBEDTLS_USE_PSA_CRYPTO)\0A\0Atypedef enum {\0A    MBEDTLS_ECJPAKE_ROUND_ONE,\0A    MBEDTLS_ECJPAKE_ROUND_TWO\0A} mbedtls_ecjpake_rounds_t;\0A\0A/**\0A * \5Cbrief       Parse the provided input buffer for getting the first round\0A *              of key exchange. This code is common between server and client\0A *\0A * \5Cparam  pake_ctx [in] the PAKE's operation/context structure\0A * \5Cparam  buf      [in] input buffer to parse\0A * \5Cparam  len      [in] length of the input buffer\0A * \5Cparam  round    [in] either MBEDTLS_ECJPAKE_ROUND_ONE or\0A *                       MBEDTLS_ECJPAKE_ROUND_TWO\0A *\0A * \5Creturn               0 on success or a negative error code in case of failure\0A */\0Aint mbedtls_psa_ecjpake_read_round(\0A    psa_pake_operation_t *pake_ctx,\0A    const unsigned char *buf,\0A    size_t len, mbedtls_ecjpake_rounds_t round);\0A\0A/**\0A * \5Cbrief       Write the first round of key exchange into the provided output\0A *              buffer. This code is common between server and client\0A *\0A * \5Cparam  pake_ctx [in] the PAKE's operation/context structure\0A * \5Cparam  buf      [out] the output buffer in which data will be written to\0A * \5Cparam  len      [in] length of the output buffer\0A * \5Cparam  olen     [out] the length of the data really written on the buffer\0A * \5Cparam  round    [in] either MBEDTLS_ECJPAKE_ROUND_ONE or\0A *                       MBEDTLS_ECJPAKE_ROUND_TWO\0A *\0A * \5Creturn               0 on success or a negative error code in case of failure\0A */\0Aint mbedtls_psa_ecjpake_write_round(\0A    psa_pake_operation_t *pake_ctx,\0A    unsigned char *buf,\0A    size_t len, size_t *olen,\0A    mbedtls_ecjpake_rounds_t round);\0A\0A#endif //MBEDTLS_KEY_EXCHANGE_ECJPAKE_ENABLED && MBEDTLS_USE_PSA_CRYPTO\0A\0A/**\0A * \5Cbrief       TLS record protection modes\0A */\0Atypedef enum {\0A    MBEDTLS_SSL_MODE_STREAM = 0,\0A    MBEDTLS_SSL_MODE_CBC,\0A    MBEDTLS_SSL_MODE_CBC_ETM,\0A    MBEDTLS_SSL_MODE_AEAD\0A} mbedtls_ssl_mode_t;\0A\0Ambedtls_ssl_mode_t mbedtls_ssl_get_mode_from_transform(\0A    const mbedtls_ssl_transform *transform);\0A\0A#if defined(MBEDTLS_SSL_SOME_SUITES_USE_CBC_ETM)\0Ambedtls_ssl_mode_t mbedtls_ssl_get_mode_from_ciphersuite(\0A    int encrypt_then_mac,\0A    const mbedtls_ssl_ciphersuite_t *suite);\0A#else\0Ambedtls_ssl_mode_t mbedtls_ssl_get_mode_from_ciphersuite(\0A    const mbedtls_ssl_ciphersuite_t *suite);\0A#endif /* MBEDTLS_SSL_SOME_SUITES_USE_CBC_ETM */\0A\0A#if defined(PSA_WANT_ALG_ECDH) || defined(PSA_WANT_ALG_FFDH)\0A\0AMBEDTLS_CHECK_RETURN_CRITICAL\0Aint mbedtls_ssl_tls13_read_public_xxdhe_share(mbedtls_ssl_context *ssl,\0A                                              const unsigned char *buf,\0A                                              size_t buf_len);\0A\0A#endif /* PSA_WANT_ALG_ECDH || PSA_WANT_ALG_FFDH */\0A\0Astatic inline int mbedtls_ssl_tls13_cipher_suite_is_offered(\0A    mbedtls_ssl_context *ssl, int cipher_suite)\0A{\0A    const int *ciphersuite_list = ssl->conf->ciphersuite_list;\0A\0A    /* Check whether we have offered this ciphersuite */\0A    for (size_t i = 0; ciphersuite_list[i] != 0; i++) {\0A        if (ciphersuite_list[i] == cipher_suite) {\0A            return 1;\0A        }\0A    }\0A    return 0;\0A}\0A\0A/**\0A * \5Cbrief Validate cipher suite against config in SSL context.\0A *\0A * \5Cparam ssl              SSL context\0A * \5Cparam suite_info       Cipher suite to validate\0A * \5Cparam min_tls_version  Minimal TLS version to accept a cipher suite\0A * \5Cparam max_tls_version  Maximal TLS version to accept a cipher suite\0A *\0A * \5Creturn 0 if valid, negative value otherwise.\0A */\0AMBEDTLS_CHECK_RETURN_CRITICAL\0Aint mbedtls_ssl_validate_ciphersuite(\0A    const mbedtls_ssl_context *ssl,\0A    const mbedtls_ssl_ciphersuite_t *suite_info,\0A    mbedtls_ssl_protocol_version min_tls_version,\0A    mbedtls_ssl_protocol_version max_tls_version);\0A\0A#if defined(MBEDTLS_SSL_SERVER_NAME_INDICATION)\0AMBEDTLS_CHECK_RETURN_CRITICAL\0Aint mbedtls_ssl_parse_server_name_ext(mbedtls_ssl_context *ssl,\0A                                      const unsigned char *buf,\0A                                      const unsigned char *end);\0A#endif /* MBEDTLS_SSL_SERVER_NAME_INDICATION */\0A\0A#if defined(MBEDTLS_SSL_RECORD_SIZE_LIMIT)\0A#define MBEDTLS_SSL_RECORD_SIZE_LIMIT_EXTENSION_DATA_LENGTH (2)\0A#define MBEDTLS_SSL_RECORD_SIZE_LIMIT_MIN (64)      /* As defined in RFC 8449 */\0A\0AMBEDTLS_CHECK_RETURN_CRITICAL\0Aint mbedtls_ssl_tls13_parse_record_size_limit_ext(mbedtls_ssl_context *ssl,\0A                                                  const unsigned char *buf,\0A                                                  const unsigned char *end);\0A\0AMBEDTLS_CHECK_RETURN_CRITICAL\0Aint mbedtls_ssl_tls13_write_record_size_limit_ext(mbedtls_ssl_context *ssl,\0A                                                  unsigned char *buf,\0A                                                  const unsigned char *end,\0A                                                  size_t *out_len);\0A#endif /* MBEDTLS_SSL_RECORD_SIZE_LIMIT */\0A\0A#if defined(MBEDTLS_SSL_ALPN)\0AMBEDTLS_CHECK_RETURN_CRITICAL\0Aint mbedtls_ssl_parse_alpn_ext(mbedtls_ssl_context *ssl,\0A                               const unsigned char *buf,\0A                               const unsigned char *end);\0A\0A\0AMBEDTLS_CHECK_RETURN_CRITICAL\0Aint mbedtls_ssl_write_alpn_ext(mbedtls_ssl_context *ssl,\0A                               unsigned char *buf,\0A                               unsigned char *end,\0A                               size_t *out_len);\0A#endif /* MBEDTLS_SSL_ALPN */\0A\0A#if defined(MBEDTLS_TEST_HOOKS)\0Aint mbedtls_ssl_check_dtls_clihlo_cookie(\0A    mbedtls_ssl_context *ssl,\0A    const unsigned char *cli_id, size_t cli_id_len,\0A    const unsigned char *in, size_t in_len,\0A    unsigned char *obuf, size_t buf_len, size_t *olen);\0A#endif\0A\0A#if defined(MBEDTLS_SSL_TLS1_3_KEY_EXCHANGE_MODE_SOME_PSK_ENABLED)\0A/**\0A * \5Cbrief Given an SSL context and its associated configuration, write the TLS\0A *        1.3 specific Pre-Shared key extension.\0A *\0A * \5Cparam[in]   ssl     SSL context\0A * \5Cparam[in]   buf     Base address of the buffer where to write the extension\0A * \5Cparam[in]   end     End address of the buffer where to write the extension\0A * \5Cparam[out]  out_len Length in bytes of the Pre-Shared key extension: data\0A *                      written into the buffer \5Cp buf by this function plus\0A *                      the length of the binders to be written.\0A * \5Cparam[out]  binders_len Length of the binders to be written at the end of\0A *                          the extension.\0A */\0AMBEDTLS_CHECK_RETURN_CRITICAL\0Aint mbedtls_ssl_tls13_write_identities_of_pre_shared_key_ext(\0A    mbedtls_ssl_context *ssl,\0A    unsigned char *buf, unsigned char *end,\0A    size_t *out_len, size_t *binders_len);\0A\0A/**\0A * \5Cbrief Given an SSL context and its associated configuration, write the TLS\0A *        1.3 specific Pre-Shared key extension binders at the end of the\0A *        ClientHello.\0A *\0A * \5Cparam[in]   ssl     SSL context\0A * \5Cparam[in]   buf     Base address of the buffer where to write the binders\0A * \5Cparam[in]   end     End address of the buffer where to write the binders\0A */\0AMBEDTLS_CHECK_RETURN_CRITICAL\0Aint mbedtls_ssl_tls13_write_binders_of_pre_shared_key_ext(\0A    mbedtls_ssl_context *ssl,\0A    unsigned char *buf, unsigned char *end);\0A#endif /* MBEDTLS_SSL_TLS1_3_KEY_EXCHANGE_MODE_SOME_PSK_ENABLED */\0A\0A#if defined(MBEDTLS_SSL_SERVER_NAME_INDICATION)\0A/** Get the host name from the SSL context.\0A *\0A * \5Cparam[in]   ssl     SSL context\0A *\0A * \5Creturn The \5Cp hostname pointer from the SSL context.\0A *         \5Cc NULL if mbedtls_ssl_set_hostname() has never been called on\0A *         \5Cp ssl or if it was last called with \5Cp NULL.\0A */\0Aconst char *mbedtls_ssl_get_hostname_pointer(const mbedtls_ssl_context *ssl);\0A#endif /* MBEDTLS_SSL_SERVER_NAME_INDICATION */\0A\0A#if defined(MBEDTLS_SSL_PROTO_TLS1_3) && \5C\0A    defined(MBEDTLS_SSL_SESSION_TICKETS) && \5C\0A    defined(MBEDTLS_SSL_SERVER_NAME_INDICATION) && \5C\0A    defined(MBEDTLS_SSL_CLI_C)\0AMBEDTLS_CHECK_RETURN_CRITICAL\0Aint mbedtls_ssl_session_set_hostname(mbedtls_ssl_session *session,\0A                                     const char *hostname);\0A#endif\0A\0A#if defined(MBEDTLS_SSL_SRV_C) && defined(MBEDTLS_SSL_EARLY_DATA) && \5C\0A    defined(MBEDTLS_SSL_ALPN)\0AMBEDTLS_CHECK_RETURN_CRITICAL\0Aint mbedtls_ssl_session_set_ticket_alpn(mbedtls_ssl_session *session,\0A                                        const char *alpn);\0A#endif\0A\0A#if defined(MBEDTLS_SSL_PROTO_TLS1_3) && defined(MBEDTLS_SSL_SESSION_TICKETS)\0A\0A#define MBEDTLS_SSL_TLS1_3_MAX_ALLOWED_TICKET_LIFETIME (604800)\0A\0Astatic inline unsigned int mbedtls_ssl_tls13_session_get_ticket_flags(\0A    mbedtls_ssl_session *session, unsigned int flags)\0A{\0A    return session->ticket_flags &\0A           (flags & MBEDTLS_SSL_TLS1_3_TICKET_FLAGS_MASK);\0A}\0A\0A/**\0A * Check if at least one of the given flags is set in\0A * the session ticket. See the definition of\0A * `MBEDTLS_SSL_TLS1_3_TICKET_FLAGS_MASK` to get all\0A * permitted flags.\0A */\0Astatic inline int mbedtls_ssl_tls13_session_ticket_has_flags(\0A    mbedtls_ssl_session *session, unsigned int flags)\0A{\0A    return mbedtls_ssl_tls13_session_get_ticket_flags(session, flags) != 0;\0A}\0A\0Astatic inline int mbedtls_ssl_tls13_session_ticket_allow_psk(\0A    mbedtls_ssl_session *session)\0A{\0A    return mbedtls_ssl_tls13_session_ticket_has_flags(\0A        session, MBEDTLS_SSL_TLS1_3_TICKET_ALLOW_PSK_RESUMPTION);\0A}\0A\0Astatic inline int mbedtls_ssl_tls13_session_ticket_allow_psk_ephemeral(\0A    mbedtls_ssl_session *session)\0A{\0A    return mbedtls_ssl_tls13_session_ticket_has_flags(\0A        session, MBEDTLS_SSL_TLS1_3_TICKET_ALLOW_PSK_EPHEMERAL_RESUMPTION);\0A}\0A\0Astatic inline unsigned int mbedtls_ssl_tls13_session_ticket_allow_early_data(\0A    mbedtls_ssl_session *session)\0A{\0A    return mbedtls_ssl_tls13_session_ticket_has_flags(\0A        session, MBEDTLS_SSL_TLS1_3_TICKET_ALLOW_EARLY_DATA);\0A}\0A\0Astatic inline void mbedtls_ssl_tls13_session_set_ticket_flags(\0A    mbedtls_ssl_session *session, unsigned int flags)\0A{\0A    session->ticket_flags |= (flags & MBEDTLS_SSL_TLS1_3_TICKET_FLAGS_MASK);\0A}\0A\0Astatic inline void mbedtls_ssl_tls13_session_clear_ticket_flags(\0A    mbedtls_ssl_session *session, unsigned int flags)\0A{\0A    session->ticket_flags &= ~(flags & MBEDTLS_SSL_TLS1_3_TICKET_FLAGS_MASK);\0A}\0A\0A#endif /* MBEDTLS_SSL_PROTO_TLS1_3 && MBEDTLS_SSL_SESSION_TICKETS */\0A\0A#if defined(MBEDTLS_SSL_SESSION_TICKETS) && defined(MBEDTLS_SSL_CLI_C)\0A#define MBEDTLS_SSL_SESSION_TICKETS_TLS1_2_BIT 0\0A#define MBEDTLS_SSL_SESSION_TICKETS_TLS1_3_BIT 1\0A\0A#define MBEDTLS_SSL_SESSION_TICKETS_TLS1_2_MASK \5C\0A    (1 << MBEDTLS_SSL_SESSION_TICKETS_TLS1_2_BIT)\0A#define MBEDTLS_SSL_SESSION_TICKETS_TLS1_3_MASK \5C\0A    (1 << MBEDTLS_SSL_SESSION_TICKETS_TLS1_3_BIT)\0A\0A#if defined(MBEDTLS_SSL_PROTO_TLS1_2)\0Astatic inline int mbedtls_ssl_conf_get_session_tickets(\0A    const mbedtls_ssl_config *conf)\0A{\0A    return conf->session_tickets & MBEDTLS_SSL_SESSION_TICKETS_TLS1_2_MASK ?\0A           MBEDTLS_SSL_SESSION_TICKETS_ENABLED :\0A           MBEDTLS_SSL_SESSION_TICKETS_DISABLED;\0A}\0A#endif /* MBEDTLS_SSL_PROTO_TLS1_2 */\0A\0A#if defined(MBEDTLS_SSL_PROTO_TLS1_3)\0Astatic inline int mbedtls_ssl_conf_is_signal_new_session_tickets_enabled(\0A    const mbedtls_ssl_config *conf)\0A{\0A    return conf->session_tickets & MBEDTLS_SSL_SESSION_TICKETS_TLS1_3_MASK ?\0A           MBEDTLS_SSL_TLS1_3_SIGNAL_NEW_SESSION_TICKETS_ENABLED :\0A           MBEDTLS_SSL_TLS1_3_SIGNAL_NEW_SESSION_TICKETS_DISABLED;\0A}\0A#endif /* MBEDTLS_SSL_PROTO_TLS1_3 */\0A#endif /* MBEDTLS_SSL_SESSION_TICKETS && MBEDTLS_SSL_CLI_C */\0A\0A#if defined(MBEDTLS_SSL_CLI_C) && defined(MBEDTLS_SSL_PROTO_TLS1_3)\0Aint mbedtls_ssl_tls13_finalize_client_hello(mbedtls_ssl_context *ssl);\0A#endif\0A\0A#if defined(MBEDTLS_TEST_HOOKS) && defined(MBEDTLS_SSL_SOME_SUITES_USE_MAC)\0A\0A/** Compute the HMAC of variable-length data with constant flow.\0A *\0A * This function computes the HMAC of the concatenation of \5Cp add_data and \5Cp\0A * data, and does with a code flow and memory access pattern that does not\0A * depend on \5Cp data_len_secret, but only on \5Cp min_data_len and \5Cp\0A * max_data_len. In particular, this function always reads exactly \5Cp\0A * max_data_len bytes from \5Cp data.\0A *\0A * \5Cparam ctx               The HMAC context. It must have keys configured\0A *                          with mbedtls_md_hmac_starts() and use one of the\0A *                          following hashes: SHA-384, SHA-256, SHA-1 or MD-5.\0A *                          It is reset using mbedtls_md_hmac_reset() after\0A *                          the computation is complete to prepare for the\0A *                          next computation.\0A * \5Cparam add_data          The first part of the message whose HMAC is being\0A *                          calculated. This must point to a readable buffer\0A *                          of \5Cp add_data_len bytes.\0A * \5Cparam add_data_len      The length of \5Cp add_data in bytes.\0A * \5Cparam data              The buffer containing the second part of the\0A *                          message. This must point to a readable buffer\0A *                          of \5Cp max_data_len bytes.\0A * \5Cparam data_len_secret   The length of the data to process in \5Cp data.\0A *                          This must be no less than \5Cp min_data_len and no\0A *                          greater than \5Cp max_data_len.\0A * \5Cparam min_data_len      The minimal length of the second part of the\0A *                          message, read from \5Cp data.\0A * \5Cparam max_data_len      The maximal length of the second part of the\0A *                          message, read from \5Cp data.\0A * \5Cparam output            The HMAC will be written here. This must point to\0A *                          a writable buffer of sufficient size to hold the\0A *                          HMAC value.\0A *\0A * \5Cretval 0 on success.\0A * \5Cretval #MBEDTLS_ERR_PLATFORM_HW_ACCEL_FAILED\0A *         The hardware accelerator failed.\0A */\0A#if defined(MBEDTLS_USE_PSA_CRYPTO)\0Aint mbedtls_ct_hmac(mbedtls_svc_key_id_t key,\0A                    psa_algorithm_t mac_alg,\0A                    const unsigned char *add_data,\0A                    size_t add_data_len,\0A                    const unsigned char *data,\0A                    size_t data_len_secret,\0A                    size_t min_data_len,\0A                    size_t max_data_len,\0A                    unsigned char *output);\0A#else\0Aint mbedtls_ct_hmac(mbedtls_md_context_t *ctx,\0A                    const unsigned char *add_data,\0A                    size_t add_data_len,\0A                    const unsigned char *data,\0A                    size_t data_len_secret,\0A                    size_t min_data_len,\0A                    size_t max_data_len,\0A                    unsigned char *output);\0A#endif /* defined(MBEDTLS_USE_PSA_CRYPTO) */\0A#endif /* MBEDTLS_TEST_HOOKS && defined(MBEDTLS_SSL_SOME_SUITES_USE_MAC) */\0A\0A#endif /* ssl_misc.h */\0A\00" }
