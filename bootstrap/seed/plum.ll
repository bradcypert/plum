            for (i = MBEDTLS_GCM_HTABLE_SIZE/4; i > 0; i >>= 1) {\0A                gcm_gen_table_rightshift(ctx->H[i], ctx->H[i*2]);\0A            }\0A\0A#if !defined(MBEDTLS_GCM_LARGE_TABLE)\0A            /* pack elements of H as 64-bits ints, big-endian */\0A            for (i = MBEDTLS_GCM_HTABLE_SIZE/2; i > 0; i >>= 1) {\0A                MBEDTLS_PUT_UINT64_BE(ctx->H[i][0], &ctx->H[i][0], 0);\0A                MBEDTLS_PUT_UINT64_BE(ctx->H[i][1], &ctx->H[i][1], 0);\0A            }\0A#endif\0A\0A            for (i = 2; i < MBEDTLS_GCM_HTABLE_SIZE; i <<= 1) {\0A                for (j = 1; j < i; j++) {\0A                    mbedtls_xor_no_simd((unsigned char *) ctx->H[i+j],\0A                                        (unsigned char *) ctx->H[i],\0A                                        (unsigned char *) ctx->H[j],\0A                                        16);\0A                }\0A            }\0A    }\0A\0A    return 0;\0A}\0A\0Aint mbedtls_gcm_setkey(mbedtls_gcm_context *ctx,\0A                       mbedtls_cipher_id_t cipher,\0A                       const unsigned char *key,\0A                       unsigned int keybits)\0A{\0A    int ret = MBEDTLS_ERR_ERROR_CORRUPTION_DETECTED;\0A\0A    if (keybits != 128 && keybits != 192 && keybits != 256) {\0A        return MBEDTLS_ERR_GCM_BAD_INPUT;\0A    }\0A\0A#if defined(MBEDTLS_BLOCK_CIPHER_C)\0A    mbedtls_block_cipher_free(&ctx->block_cipher_ctx);\0A\0A    if ((ret = mbedtls_block_cipher_setup(&ctx->block_cipher_ctx, cipher)) != 0) {\0A        return ret;\0A    }\0A\0A    if ((ret = mbedtls_block_cipher_setkey(&ctx->block_cipher_ctx, key, keybits)) != 0) {\0A        return ret;\0A    }\0A#else\0A    const mbedtls_cipher_info_t *cipher_info;\0A\0A    cipher_info = mbedtls_cipher_info_from_values(cipher, keybits,\0A                                                  MBEDTLS_MODE_ECB);\0A    if (cipher_info == NULL) {\0A        return MBEDTLS_ERR_GCM_BAD_INPUT;\0A    }\0A\0A    if (mbedtls_cipher_info_get_block_size(cipher_info) != 16) {\0A        return MBEDTLS_ERR_GCM_BAD_INPUT;\0A    }\0A\0A    mbedtls_cipher_free(&ctx->cipher_ctx);\0A\0A    if ((ret = mbedtls_cipher_setup(&ctx->cipher_ctx, cipher_info)) != 0) {\0A        return ret;\0A    }\0A\0A    if ((ret = mbedtls_cipher_setkey(&ctx->cipher_ctx, key, keybits,\0A                                     MBEDTLS_ENCRYPT)) != 0) {\0A        return ret;\0A    }\0A#endif\0A\0A    if ((ret = gcm_gen_table(ctx)) != 0) {\0A        return ret;\0A    }\0A\0A    return 0;\0A}\0A\0A#if defined(MBEDTLS_GCM_LARGE_TABLE)\0Astatic const uint16_t last8[256] = {\0A    0x0000, 0xc201, 0x8403, 0x4602, 0x0807, 0xca06, 0x8c04, 0x4e05,\0A    0x100e, 0xd20f, 0x940d, 0x560c, 0x1809, 0xda08, 0x9c0a, 0x5e0b,\0A    0x201c, 0xe21d, 0xa41f, 0x661e, 0x281b, 0xea1a, 0xac18, 0x6e19,\0A    0x3012, 0xf213, 0xb411, 0x7610, 0x3815, 0xfa14, 0xbc16, 0x7e17,\0A    0x4038, 0x8239, 0xc43b, 0x063a, 0x483f, 0x8a3e, 0xcc3c, 0x0e3d,\0A    0x5036, 0x9237, 0xd435, 0x1634, 0x5831, 0x9a30, 0xdc32, 0x1e33,\0A    0x6024, 0xa225, 0xe427, 0x2626, 0x6823, 0xaa22, 0xec20, 0x2e21,\0A    0x702a, 0xb22b, 0xf429, 0x3628, 0x782d, 0xba2c, 0xfc2e, 0x3e2f,\0A    0x8070, 0x4271, 0x0473, 0xc672, 0x8877, 0x4a76, 0x0c74, 0xce75,\0A    0x907e, 0x527f, 0x147d, 0xd67c, 0x9879, 0x5a78, 0x1c7a, 0xde7b,\0A    0xa06c, 0x626d, 0x246f, 0xe66e, 0xa86b, 0x6a6a, 0x2c68, 0xee69,\0A    0xb062, 0x7263, 0x3461, 0xf660, 0xb865, 0x7a64, 0x3c66, 0xfe67,\0A    0xc048, 0x0249, 0x444b, 0x864a, 0xc84f, 0x0a4e, 0x4c4c, 0x8e4d,\0A    0xd046, 0x1247, 0x5445, 0x9644, 0xd841, 0x1a40, 0x5c42, 0x9e43,\0A    0xe054, 0x2255, 0x6457, 0xa656, 0xe853, 0x2a52, 0x6c50, 0xae51,\0A    0xf05a, 0x325b, 0x7459, 0xb658, 0xf85d, 0x3a5c, 0x7c5e, 0xbe5f,\0A    0x00e1, 0xc2e0, 0x84e2, 0x46e3, 0x08e6, 0xcae7, 0x8ce5, 0x4ee4,\0A    0x10ef, 0xd2ee, 0x94ec, 0x56ed, 0x18e8, 0xdae9, 0x9ceb, 0x5eea,\0A    0x20fd, 0xe2fc, 0xa4fe, 0x66ff, 0x28fa, 0xeafb, 0xacf9, 0x6ef8,\0A    0x30f3, 0xf2f2, 0xb4f0, 0x76f1, 0x38f4, 0xfaf5, 0xbcf7, 0x7ef6,\0A    0x40d9, 0x82d8, 0xc4da, 0x06db, 0x48de, 0x8adf, 0xccdd, 0x0edc,\0A    0x50d7, 0x92d6, 0xd4d4, 0x16d5, 0x58d0, 0x9ad1, 0xdcd3, 0x1ed2,\0A    0x60c5, 0xa2c4, 0xe4c6, 0x26c7, 0x68c2, 0xaac3, 0xecc1, 0x2ec0,\0A    0x70cb, 0xb2ca, 0xf4c8, 0x36c9, 0x78cc, 0xbacd, 0xfccf, 0x3ece,\0A    0x8091, 0x4290, 0x0492, 0xc693, 0x8896, 0x4a97, 0x0c95, 0xce94,\0A    0x909f, 0x529e, 0x149c, 0xd69d, 0x9898, 0x5a99, 0x1c9b, 0xde9a,\0A    0xa08d, 0x628c, 0x248e, 0xe68f, 0xa88a, 0x6a8b, 0x2c89, 0xee88,\0A    0xb083, 0x7282, 0x3480, 0xf681, 0xb884, 0x7a85, 0x3c87, 0xfe86,\0A    0xc0a9, 0x02a8, 0x44aa, 0x86ab, 0xc8ae, 0x0aaf, 0x4cad, 0x8eac,\0A    0xd0a7, 0x12a6, 0x54a4, 0x96a5, 0xd8a0, 0x1aa1, 0x5ca3, 0x9ea2,\0A    0xe0b5, 0x22b4, 0x64b6, 0xa6b7, 0xe8b2, 0x2ab3, 0x6cb1, 0xaeb0,\0A    0xf0bb, 0x32ba, 0x74b8, 0xb6b9, 0xf8bc, 0x3abd, 0x7cbf, 0xbebe\0A};\0A\0Astatic void gcm_mult_largetable(uint8_t *output, const uint8_t *x, uint64_t H[256][2])\0A{\0A    int i;\0A    uint64_t u64z[2];\0A    uint16_t *u16z = (uint16_t *) u64z;\0A    uint8_t *u8z = (uint8_t *) u64z;\0A    uint8_t rem;\0A\0A    u64z[0] = 0;\0A    u64z[1] = 0;\0A\0A    if (MBEDTLS_IS_BIG_ENDIAN) {\0A        for (i = 15; i > 0; i--) {\0A            mbedtls_xor_no_simd(u8z, u8z, (uint8_t *) H[x[i]], 16);\0A            rem = u8z[15];\0A\0A            u64z[1] >>= 8;\0A            u8z[8] = u8z[7];\0A            u64z[0] >>= 8;\0A\0A            u16z[0] ^= MBEDTLS_GET_UINT16_LE(&last8[rem], 0);\0A        }\0A    } else {\0A        for (i = 15; i > 0; i--) {\0A            mbedtls_xor_no_simd(u8z, u8z, (uint8_t *) H[x[i]], 16);\0A            rem = u8z[15];\0A\0A            u64z[1] <<= 8;\0A            u8z[8] = u8z[7];\0A            u64z[0] <<= 8;\0A\0A            u16z[0] ^= last8[rem];\0A        }\0A    }\0A\0A    mbedtls_xor_no_simd(output, u8z, (uint8_t *) H[x[0]], 16);\0A}\0A#else\0A/*\0A * Shoup's method for multiplication use this table with\0A *      last4[x] = x times P^128\0A * where x and last4[x] are seen as elements of GF(2^128) as in [MGV]\0A */\0Astatic const uint16_t last4[16] =\0A{\0A    0x0000, 0x1c20, 0x3840, 0x2460,\0A    0x7080, 0x6ca0, 0x48c0, 0x54e0,\0A    0xe100, 0xfd20, 0xd940, 0xc560,\0A    0x9180, 0x8da0, 0xa9c0, 0xb5e0\0A};\0A\0Astatic void gcm_mult_smalltable(uint8_t *output, const uint8_t *x, uint64_t H[16][2])\0A{\0A    int i = 0;\0A    unsigned char lo, hi, rem;\0A    uint64_t u64z[2];\0A    const uint64_t *pu64z = NULL;\0A    uint8_t *u8z = (uint8_t *) u64z;\0A\0A    lo = x[15] & 0xf;\0A    hi = (x[15] >> 4) & 0xf;\0A\0A    pu64z = H[lo];\0A\0A    rem = (unsigned char) pu64z[1] & 0xf;\0A    u64z[1] = (pu64z[0] << 60) | (pu64z[1] >> 4);\0A    u64z[0] = (pu64z[0] >> 4);\0A    u64z[0] ^= (uint64_t) last4[rem] << 48;\0A    mbedtls_xor_no_simd(u8z, u8z, (uint8_t *) H[hi], 16);\0A\0A    for (i = 14; i >= 0; i--) {\0A        lo = x[i] & 0xf;\0A        hi = (x[i] >> 4) & 0xf;\0A\0A        rem = (unsigned char) u64z[1] & 0xf;\0A        u64z[1] = (u64z[0] << 60) | (u64z[1] >> 4);\0A        u64z[0] = (u64z[0] >> 4);\0A        u64z[0] ^= (uint64_t) last4[rem] << 48;\0A        mbedtls_xor_no_simd(u8z, u8z, (uint8_t *) H[lo], 16);\0A\0A        rem = (unsigned char) u64z[1] & 0xf;\0A        u64z[1] = (u64z[0] << 60) | (u64z[1] >> 4);\0A        u64z[0] = (u64z[0] >> 4);\0A        u64z[0] ^= (uint64_t) last4[rem] << 48;\0A        mbedtls_xor_no_simd(u8z, u8z, (uint8_t *) H[hi], 16);\0A    }\0A\0A    MBEDTLS_PUT_UINT64_BE(u64z[0], output, 0);\0A    MBEDTLS_PUT_UINT64_BE(u64z[1], output, 8);\0A}\0A#endif\0A\0A/*\0A * Sets output to x times H using the precomputed tables.\0A * x and output are seen as elements of GF(2^128) as in [MGV].\0A */\0Astatic void gcm_mult(mbedtls_gcm_context *ctx, const unsigned char x[16],\0A                     unsigned char output[16])\0A{\0A    switch (ctx->acceleration) {\0A#if defined(MBEDTLS_AESNI_HAVE_CODE)\0A        case MBEDTLS_GCM_ACC_AESNI:\0A            mbedtls_aesni_gcm_mult(output, x, (uint8_t *) ctx->H[MBEDTLS_GCM_HTABLE_SIZE/2]);\0A            break;\0A#endif\0A\0A#if defined(MBEDTLS_AESCE_HAVE_CODE)\0A        case MBEDTLS_GCM_ACC_AESCE:\0A            mbedtls_aesce_gcm_mult(output, x, (uint8_t *) ctx->H[MBEDTLS_GCM_HTABLE_SIZE/2]);\0A            break;\0A#endif\0A\0A#if defined(MBEDTLS_GCM_LARGE_TABLE)\0A        case MBEDTLS_GCM_ACC_LARGETABLE:\0A            gcm_mult_largetable(output, x, ctx->H);\0A            break;\0A#else\0A        case MBEDTLS_GCM_ACC_SMALLTABLE:\0A            gcm_mult_smalltable(output, x, ctx->H);\0A            break;\0A#endif\0A    }\0A\0A    return;\0A}\0A\0Aint mbedtls_gcm_starts(mbedtls_gcm_context *ctx,\0A                       int mode,\0A                       const unsigned char *iv, size_t iv_len)\0A{\0A    int ret = MBEDTLS_ERR_ERROR_CORRUPTION_DETECTED;\0A    unsigned char work_buf[16];\0A    const unsigned char *p;\0A    size_t use_len;\0A    uint64_t iv_bits;\0A#if !defined(MBEDTLS_BLOCK_CIPHER_C)\0A    size_t olen = 0;\0A#endif\0A\0A    /* IV is limited to 2^64 bits, so 2^61 bytes */\0A    /* IV is not allowed to be zero length */\0A    if (iv_len == 0 || (uint64_t) iv_len >> 61 != 0) {\0A        return MBEDTLS_ERR_GCM_BAD_INPUT;\0A    }\0A\0A    memset(ctx->y, 0x00, sizeof(ctx->y));\0A    memset(ctx->buf, 0x00, sizeof(ctx->buf));\0A\0A    ctx->mode = mode;\0A    ctx->len = 0;\0A    ctx->add_len = 0;\0A\0A    if (iv_len == 12) {\0A        memcpy(ctx->y, iv, iv_len);\0A        ctx->y[15] = 1;\0A    } else {\0A        memset(work_buf, 0x00, 16);\0A        iv_bits = (uint64_t) iv_len * 8;\0A        MBEDTLS_PUT_UINT64_BE(iv_bits, work_buf, 8);\0A\0A        p = iv;\0A        while (iv_len > 0) {\0A            use_len = (iv_len < 16) ? iv_len : 16;\0A\0A#if defined(MBEDTLS_COMPILER_IS_GCC) && (MBEDTLS_GCC_VERSION >= 70110)\0A#pragma GCC diagnostic push\0A#pragma GCC diagnostic warning \22-Wstringop-overflow=0\22\0A#endif\0A\0A            mbedtls_xor(ctx->y, ctx->y, p, use_len);\0A\0A#if defined(MBEDTLS_COMPILER_IS_GCC) && (MBEDTLS_GCC_VERSION >= 70110)\0A#pragma GCC diagnostic pop\0