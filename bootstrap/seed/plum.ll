@.str45889 = private global { i64, i64, [4942 x i8] } { i64 -1, i64 4941, [4942 x i8] c"/**\0A * \5Cfile ssl_ciphersuites_internal.h\0A *\0A * \5Cbrief Internal part of the public \22ssl_ciphersuites.h\22.\0A */\0A/*\0A *  Copyright The Mbed TLS Contributors\0A *  SPDX-License-Identifier: Apache-2.0 OR GPL-2.0-or-later\0A */\0A#ifndef MBEDTLS_SSL_CIPHERSUITES_INTERNAL_H\0A#define MBEDTLS_SSL_CIPHERSUITES_INTERNAL_H\0A\0A#include \22mbedtls/pk.h\22\0A\0A#if defined(MBEDTLS_PK_C)\0Ambedtls_pk_type_t mbedtls_ssl_get_ciphersuite_sig_pk_alg(const mbedtls_ssl_ciphersuite_t *info);\0A#if defined(MBEDTLS_USE_PSA_CRYPTO)\0Apsa_algorithm_t mbedtls_ssl_get_ciphersuite_sig_pk_psa_alg(const mbedtls_ssl_ciphersuite_t *info);\0Apsa_key_usage_t mbedtls_ssl_get_ciphersuite_sig_pk_psa_usage(const mbedtls_ssl_ciphersuite_t *info);\0A#endif /* MBEDTLS_USE_PSA_CRYPTO */\0Ambedtls_pk_type_t mbedtls_ssl_get_ciphersuite_sig_alg(const mbedtls_ssl_ciphersuite_t *info);\0A#endif /* MBEDTLS_PK_C */\0A\0Aint mbedtls_ssl_ciphersuite_uses_ec(const mbedtls_ssl_ciphersuite_t *info);\0Aint mbedtls_ssl_ciphersuite_uses_psk(const mbedtls_ssl_ciphersuite_t *info);\0A\0A#if defined(MBEDTLS_KEY_EXCHANGE_SOME_PFS_ENABLED)\0Astatic inline int mbedtls_ssl_ciphersuite_has_pfs(const mbedtls_ssl_ciphersuite_t *info)\0A{\0A    switch (info->MBEDTLS_PRIVATE(key_exchange)) {\0A        case MBEDTLS_KEY_EXCHANGE_DHE_RSA:\0A        case MBEDTLS_KEY_EXCHANGE_DHE_PSK:\0A        case MBEDTLS_KEY_EXCHANGE_ECDHE_RSA:\0A        case MBEDTLS_KEY_EXCHANGE_ECDHE_PSK:\0A        case MBEDTLS_KEY_EXCHANGE_ECDHE_ECDSA:\0A        case MBEDTLS_KEY_EXCHANGE_ECJPAKE:\0A            return 1;\0A\0A        default:\0A            return 0;\0A    }\0A}\0A#endif /* MBEDTLS_KEY_EXCHANGE_SOME_PFS_ENABLED */\0A\0A#if defined(MBEDTLS_KEY_EXCHANGE_SOME_NON_PFS_ENABLED)\0Astatic inline int mbedtls_ssl_ciphersuite_no_pfs(const mbedtls_ssl_ciphersuite_t *info)\0A{\0A    switch (info->MBEDTLS_PRIVATE(key_exchange)) {\0A        case MBEDTLS_KEY_EXCHANGE_ECDH_RSA:\0A        case MBEDTLS_KEY_EXCHANGE_ECDH_ECDSA:\0A        case MBEDTLS_KEY_EXCHANGE_RSA:\0A        case MBEDTLS_KEY_EXCHANGE_PSK:\0A        case MBEDTLS_KEY_EXCHANGE_RSA_PSK:\0A            return 1;\0A\0A        default:\0A            return 0;\0A    }\0A}\0A#endif /* MBEDTLS_KEY_EXCHANGE_SOME_NON_PFS_ENABLED */\0A\0A#if defined(MBEDTLS_KEY_EXCHANGE_SOME_ECDH_ENABLED)\0Astatic inline int mbedtls_ssl_ciphersuite_uses_ecdh(const mbedtls_ssl_ciphersuite_t *info)\0A{\0A    switch (info->MBEDTLS_PRIVATE(key_exchange)) {\0A        case MBEDTLS_KEY_EXCHANGE_ECDH_RSA:\0A        case MBEDTLS_KEY_EXCHANGE_ECDH_ECDSA:\0A            return 1;\0A\0A        default:\0A            return 0;\0A    }\0A}\0A#endif /* MBEDTLS_KEY_EXCHANGE_SOME_ECDH_ENABLED */\0A\0Astatic inline int mbedtls_ssl_ciphersuite_cert_req_allowed(const mbedtls_ssl_ciphersuite_t *info)\0A{\0A    switch (info->MBEDTLS_PRIVATE(key_exchange)) {\0A        case MBEDTLS_KEY_EXCHANGE_RSA:\0A        case MBEDTLS_KEY_EXCHANGE_DHE_RSA:\0A        case MBEDTLS_KEY_EXCHANGE_ECDH_RSA:\0A        case MBEDTLS_KEY_EXCHANGE_ECDHE_RSA:\0A        case MBEDTLS_KEY_EXCHANGE_ECDH_ECDSA:\0A        case MBEDTLS_KEY_EXCHANGE_ECDHE_ECDSA:\0A            return 1;\0A\0A        default:\0A            return 0;\0A    }\0A}\0A\0Astatic inline int mbedtls_ssl_ciphersuite_uses_srv_cert(const mbedtls_ssl_ciphersuite_t *info)\0A{\0A    switch (info->MBEDTLS_PRIVATE(key_exchange)) {\0A        case MBEDTLS_KEY_EXCHANGE_RSA:\0A        case MBEDTLS_KEY_EXCHANGE_RSA_PSK:\0A        case MBEDTLS_KEY_EXCHANGE_DHE_RSA:\0A        case MBEDTLS_KEY_EXCHANGE_ECDH_RSA:\0A        case MBEDTLS_KEY_EXCHANGE_ECDHE_RSA:\0A        case MBEDTLS_KEY_EXCHANGE_ECDH_ECDSA:\0A        case MBEDTLS_KEY_EXCHANGE_ECDHE_ECDSA:\0A            return 1;\0A\0A        default:\0A            return 0;\0A    }\0A}\0A\0A#if defined(MBEDTLS_KEY_EXCHANGE_SOME_DHE_ENABLED)\0Astatic inline int mbedtls_ssl_ciphersuite_uses_dhe(const mbedtls_ssl_ciphersuite_t *info)\0A{\0A    switch (info->MBEDTLS_PRIVATE(key_exchange)) {\0A        case MBEDTLS_KEY_EXCHANGE_DHE_RSA:\0A        case MBEDTLS_KEY_EXCHANGE_DHE_PSK:\0A            return 1;\0A\0A        default:\0A            return 0;\0A    }\0A}\0A#endif /* MBEDTLS_KEY_EXCHANGE_SOME_DHE_ENABLED) */\0A\0A#if defined(MBEDTLS_KEY_EXCHANGE_SOME_ECDHE_ENABLED)\0Astatic inline int mbedtls_ssl_ciphersuite_uses_ecdhe(const mbedtls_ssl_ciphersuite_t *info)\0A{\0A    switch (info->MBEDTLS_PRIVATE(key_exchange)) {\0A        case MBEDTLS_KEY_EXCHANGE_ECDHE_ECDSA:\0A        case MBEDTLS_KEY_EXCHANGE_ECDHE_RSA:\0A        case MBEDTLS_KEY_EXCHANGE_ECDHE_PSK:\0A            return 1;\0A\0A        default:\0A            return 0;\0A    }\0A}\0A#endif /* MBEDTLS_KEY_EXCHANGE_SOME_ECDHE_ENABLED) */\0A\0A#if defined(MBEDTLS_KEY_EXCHANGE_WITH_SERVER_SIGNATURE_ENABLED)\0Astatic inline int mbedtls_ssl_ciphersuite_uses_server_signature(\0A    const mbedtls_ssl_ciphersuite_t *info)\0A{\0A    switch (info->MBEDTLS_PRIVATE(key_exchange)) {\0A        case MBEDTLS_KEY_EXCHANGE_DHE_RSA:\0A        case MBEDTLS_KEY_EXCHANGE_ECDHE_RSA:\0A        case MBEDTLS_KEY_EXCHANGE_ECDHE_ECDSA:\0A            return 1;\0A\0A        default:\0A            return 0;\0A    }\0A}\0A#endif /* MBEDTLS_KEY_EXCHANGE_WITH_SERVER_SIGNATURE_ENABLED */\0A\0A#endif /* MBEDTLS_SSL_CIPHERSUITES_INTERNAL_H */\0A\00" }
