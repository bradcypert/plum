eak;\0A#endif\0A#if defined(PSA_WANT_KEY_TYPE_ARIA)\0A        case PSA_KEY_TYPE_ARIA:\0A            if (bits != 128 && bits != 192 && bits != 256) {\0A                return PSA_ERROR_INVALID_ARGUMENT;\0A            }\0A            break;\0A#endif\0A#if defined(PSA_WANT_KEY_TYPE_CAMELLIA)\0A        case PSA_KEY_TYPE_CAMELLIA:\0A            if (bits != 128 && bits != 192 && bits != 256) {\0A                return PSA_ERROR_INVALID_ARGUMENT;\0A            }\0A            break;\0A#endif\0A#if defined(PSA_WANT_KEY_TYPE_DES)\0A        case PSA_KEY_TYPE_DES:\0A            if (bits != 64 && bits != 128 && bits != 192) {\0A                return PSA_ERROR_INVALID_ARGUMENT;\0A            }\0A            break;\0A#endif\0A#if defined(PSA_WANT_KEY_TYPE_CHACHA20)\0A        case PSA_KEY_TYPE_CHACHA20:\0A            if (bits != 256) {\0A                return PSA_ERROR_INVALID_ARGUMENT;\0A            }\0A            break;\0A#endif\0A        default:\0A            return PSA_ERROR_NOT_SUPPORTED;\0A    }\0A    if (bits % 8 != 0) {\0A        return PSA_ERROR_INVALID_ARGUMENT;\0A    }\0A\0A    return PSA_SUCCESS;\0A}\0A\0A/** Check whether a given key type is valid for use with a given MAC algorithm\0A *\0A * Upon successful return of this function, the behavior of #PSA_MAC_LENGTH\0A * when called with the validated \5Cp algorithm and \5Cp key_type is well-defined.\0A *\0A * \5Cparam[in] algorithm     The specific MAC algorithm (can be wildcard).\0A * \5Cparam[in] key_type      The key type of the key to be used with the\0A *                          \5Cp algorithm.\0A *\0A * \5Cretval #PSA_SUCCESS\0A *         The \5Cp key_type is valid for use with the \5Cp algorithm\0A * \5Cretval #PSA_ERROR_INVALID_ARGUMENT\0A *         The \5Cp key_type is not valid for use with the \5Cp algorithm\0A */\0AMBEDTLS_STATIC_TESTABLE psa_status_t psa_mac_key_can_do(\0A    psa_algorithm_t algorithm,\0A    psa_key_type_t key_type)\0A{\0A    if (PSA_ALG_IS_HMAC(algorithm)) {\0A        if (key_type == 