@.str40516 = private global { i64, i64, [38652 x i8] } { i64 -1, i64 38651, [38652 x i8] c"/*\0A *  Error message information\0A *\0A *  Copyright The Mbed TLS Contributors\0A *  SPDX-License-Identifier: Apache-2.0 OR GPL-2.0-or-later\0A */\0A\0A#include \22common.h\22\0A\0A#include \22mbedtls/error.h\22\0A\0A#if defined(MBEDTLS_ERROR_C) || defined(MBEDTLS_ERROR_STRERROR_DUMMY)\0A\0A#if defined(MBEDTLS_ERROR_C)\0A\0A#include \22mbedtls/platform.h\22\0A\0A#include <stdio.h>\0A#include <string.h>\0A\0A#if defined(MBEDTLS_AES_C)\0A#include \22mbedtls/aes.h\22\0A#endif\0A\0A#if defined(MBEDTLS_ARIA_C)\0A#include \22mbedtls/aria.h\22\0A#endif\0A\0A#if defined(MBEDTLS_ASN1_PARSE_C)\0A#include \22mbedtls/asn1.h\22\0A#endif\0A\0A#if defined(MBEDTLS_BASE64_C)\0A#include \22mbedtls/base64.h\22\0A#endif\0A\0A#if defined(MBEDTLS_BIGNUM_C)\0A#include \22mbedtls/bignum.h\22\0A#endif\0A\0A#if defined(MBEDTLS_CAMELLIA_C)\0A#include \22mbedtls/camellia.h\22\0A#endif\0A\0A#if defined(MBEDTLS_CCM_C)\0A#include \22mbedtls/ccm.h\22\0A#endif\0A\0A#if defined(MBEDTLS_CHACHA20_C)\0A#include \22mbedtls/chacha20.h\22\0A#endif\0A\0A#if defined(MBEDTLS_CHACHAPOLY_C)\0A#include \22mbedtls/chachapoly.h\22\0A#endif\0A\0A#if defined(MBEDTLS_CIPHER_C)\0A#include \22mbedtls/cipher.h\22\0A#endif\0A\0A#if defined(MBEDTLS_CTR_DRBG_C)\0A#include \22mbedtls/ctr_drbg.h\22\0A#endif\0A\0A#if defined(MBEDTLS_DES_C)\0A#include \22mbedtls/des.h\22\0A#endif\0A\0A#if defined(MBEDTLS_DHM_C)\0A#include \22mbedtls/dhm.h\22\0A#endif\0A\0A#if defined(MBEDTLS_ECP_C)\0A#include \22mbedtls/ecp.h\22\0A#endif\0A\0A#if defined(MBEDTLS_ENTROPY_C)\0A#include \22mbedtls/entropy.h\22\0A#endif\0A\0A#if defined(MBEDTLS_ERROR_C)\0A#include \22mbedtls/error.h\22\0A#endif\0A\0A#if defined(MBEDTLS_PLATFORM_C)\0A#include \22mbedtls/platform.h\22\0A#endif\0A\0A#if defined(MBEDTLS_GCM_C)\0A#include \22mbedtls/gcm.h\22\0A#endif\0A\0A#if defined(MBEDTLS_HKDF_C)\0A#include \22mbedtls/hkdf.h\22\0A#endif\0A\0A#if defined(MBEDTLS_HMAC_DRBG_C)\0A#include \22mbedtls/hmac_drbg.h\22\0A#endif\0A\0A#if defined(MBEDTLS_LMS_C)\0A#include \22mbedtls/lms.h\22\0A#endif\0A\0A#if defined(MBEDTLS_MD_C)\0A#include \22mbedtls/md.h\22\0A#endif\0A\0A#if defined(MBEDTLS_NET_C)\0A#include \22mbedtls/net_sockets.h\22\0A#endif\0A\0A#if defined(MBEDTLS_OID_C)\0A#include \22mbedtls/oid.h\22\0A#endif\0A\0A#if defined(MBEDTLS_PEM_PARSE_C) || defined(MBEDTLS_PEM_WRITE_C)\0A#include \22mbedtls/pem.h\22\0A#endif\0A\0A#if defined(MBEDTLS_PK_C)\0A#include \22mbedtls/pk.h\22\0A#endif\0A\0A#if defined(MBEDTLS_PKCS12_C)\0A#include \22mbedtls/pkcs12.h\22\0A#endif\0A\0A#if defined(MBEDTLS_PKCS5_C)\0A#include \22mbedtls/pkcs5.h\22\0A#endif\0A\0A#if defined(MBEDTLS_PKCS7_C)\0A#include \22mbedtls/pkcs7.h\22\0A#endif\0A\0A#if defined(MBEDTLS_POLY1305_C)\0A#include \22mbedtls/poly1305.h\22\0A#endif\0A\0A#if defined(MBEDTLS_RSA_C)\0A#include \22mbedtls/rsa.h\22\0A#endif\0A\0A#if defined(MBEDTLS_SHA1_C)\0A#include \22mbedtls/sha1.h\22\0A#endif\0A\0A#if defined(MBEDTLS_SHA256_C)\0A#include \22mbedtls/sha256.h\22\0A#endif\0A\0A#if defined(MBEDTLS_SHA3_C)\0A#include \22mbedtls/sha3.h\22\0A#endif\0A\0A#if defined(MBEDTLS_SHA512_C)\0A#include \22mbedtls/sha512.h\22\0A#endif\0A\0A#if defined(MBEDTLS_SSL_TLS_C)\0A#include \22mbedtls/ssl.h\22\0A#endif\0A\0A#if defined(MBEDTLS_THREADING_C)\0A#include \22mbedtls/threading.h\22\0A#endif\0A\0A#if defined(MBEDTLS_X509_USE_C) || defined(MBEDTLS_X509_CREATE_C)\0A#include \22mbedtls/x509.h\22\0A#endif\0A\0A\0Aconst char *mbedtls_high_level_strerr(int error_code)\0A{\0A    int high_level_error_code;\0A\0A    if (error_code < 0) {\0A        error_code = -error_code;\0A    }\0A\0A    /* Extract the high-level part from the error code. */\0A    high_level_error_code = error_code & 0xFF80;\0A\0A    switch (high_level_error_code) {\0A    /* Begin Auto-Generated Code. */\0A    #if defined(MBEDTLS_CIPHER_C)\0A        case -(MBEDTLS_ERR_CIPHER_FEATURE_UNAVAILABLE):\0A            return( \22CIPHER - The selected feature is not available\22 );\0A        case -(MBEDTLS_ERR_CIPHER_BAD_INPUT_DATA):\0A            return( \22CIPHER - Bad input parameters\22 );\0A        case -(MBEDTLS_ERR_CIPHER_ALLOC_FAILED):\0A            return( \22CIPHER - Failed to allocate memory\22 );\0A        case -(MBEDTLS_ERR_CIPHER_INVALID_PADDING):\0A            return( \22CIPHER - Input data contains invalid padding and is rejected\22 );\0A        case -(MBEDTLS_ERR_CIPHER_FULL_BLOCK_EXPECTED):\0A            return( \22CIPHER - Decryption of block requires a full block\22 );\0A        case -(MBEDTLS_ERR_CIPHER_AUTH_FAILED):\0A            return( \22CIPHER - Authentication failed (for AEAD modes)\22 );\0A        case -(MBEDTLS_ERR_CIPHER_INVALID_CONTEXT):\0A            return( \22CIPHER - The context is invalid. For example, because it was freed\22 );\0A#endif /* MBEDTLS_CIPHER_C */\0A\0A#if defined(MBEDTLS_DHM_C)\0A        case -(MBEDTLS_ERR_DHM_BAD_INPUT_DATA):\0A            return( \22DHM - Bad input parameters\22 );\0A        case -(MBEDTLS_ERR_DHM_READ_PARAMS_FAILED):\0A            return( \22DHM - Reading of the DHM parameters failed\22 );\0A        case -(MBEDTLS_ERR_DHM_MAKE_PARAMS_FAILED):\0A            return( \22DHM - Making of the DHM parameters failed\22 );\0A        case -(MBEDTLS_ERR_DHM_READ_PUBLIC_FAILED):\0A            return( \22DHM - Reading of the public values failed\22 );\0A        case -(MBEDTLS_ERR_DHM_MAKE_PUBLIC_FAILED):\0A            return( \22DHM - Making of the public value failed\22 );\0A        case -(MBEDTLS_ERR_DHM_CALC_SECRET_FAILED):\0A            return( \22DHM - Calculation of the DHM secret failed\22 );\0A        case -(MBEDTLS_ERR_DHM_INVALID_FORMAT):\0A            return( \22DHM - The ASN.1 data is not formatted correctly\22 );\0A        case -(MBEDTLS_ERR_DHM_ALLOC_FAILED):\0A            return( \22DHM - Allocation of memory failed\22 );\0A        case -(MBEDTLS_ERR_DHM_FILE_IO_ERROR):\0A            return( \22DHM - Read or write of file failed\22 );\0A        case