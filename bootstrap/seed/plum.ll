@.str44899 = private global { i64, i64, [20726 x i8] } { i64 -1, i64 20725, [20726 x i8] c"/**\0A * \5Cfile lms.h\0A *\0A * \5Cbrief This file provides an API for the LMS post-quantum-safe stateful-hash\0A          public-key signature scheme as defined in RFC8554 and NIST.SP.200-208.\0A *        This implementation currently only supports a single parameter set\0A *        MBEDTLS_LMS_SHA256_M32_H10 in order to reduce complexity. This is one\0A *        of the signature schemes recommended by the IETF draft SUIT standard\0A *        for IOT firmware upgrades (RFC9019).\0A */\0A/*\0A *  Copyright The Mbed TLS Contributors\0A *  SPDX-License-Identifier: Apache-2.0 OR GPL-2.0-or-later\0A */\0A#ifndef MBEDTLS_LMS_H\0A#define MBEDTLS_LMS_H\0A\0A#include <stdint.h>\0A#include <stddef.h>\0A\0A#include \22mbedtls/private_access.h\22\0A#include \22mbedtls/build_info.h\22\0A\0A#define MBEDTLS_ERR_LMS_BAD_INPUT_DATA   -0x0011 /**< Bad data has been input to an LMS function */\0A#define MBEDTLS_ERR_LMS_OUT_OF_PRIVATE_KEYS -0x0013 /**< Specified LMS key has utilised all of its private keys */\0A#define MBEDTLS_ERR_LMS_VERIFY_FAILED    -0x0015 /**< LMS signature verification failed */\0A#define MBEDTLS_ERR_LMS_ALLOC_FAILED     -0x0017 /**< LMS failed to allocate space for a private key */\0A#define MBEDTLS_ERR_LMS_BUFFER_TOO_SMALL -0x0019 /**< Input/output buffer is too small to contain requited data */\0A\0A/* Currently only defined for SHA256, 32 is the max hash output size */\0A#define MBEDTLS_LMOTS_N_HASH_LEN_MAX           (32u)\0A#define MBEDTLS_LMOTS_P_SIG_DIGIT_COUNT_MAX    (34u)\0A#define MBEDTLS_LMOTS_N_HASH_LEN(type)         ((type) == MBEDTLS_LMOTS_SHA256_N32_W8 ? 32u : 0)\0A#define MBEDTLS_LMOTS_I_KEY_ID_LEN             (16u)\0A#define MBEDTLS_LMOTS_Q_LEAF_ID_LEN            (4u)\0A#define MBEDTLS_LMOTS_TYPE_LEN                 (4u)\0A#define MBEDTLS_LMOTS_P_SIG_DIGIT_COUNT(type)  ((type) == MBEDTLS_LMOTS_SHA256_N32_W8 ? 34u : 0)\0A#define MBEDTLS_LMOTS_C_RANDOM_VALUE_LEN(type) (MBEDTLS_LMOTS_N_HASH_LEN(type))\0A\0A#define MBEDTLS_LMOTS_SIG_LEN(type) (MBEDTLS_LMOTS_TYPE_LEN + \5C\0A                                     MBEDTLS_LMOTS_C_RANDOM_VALUE_LEN(type) + \5C\0A                                     (MBEDTLS_LMOTS_P_SIG_DIGIT_COUNT(type) * \5C\0A                                      MBEDTLS_LMOTS_N_HASH_LEN(type)))\0A\0A\0A#define MBEDTLS_LMS_TYPE_LEN            (4)\0A#define MBEDTLS_LMS_H_TREE_HEIGHT(type) ((type) == MBEDTLS_LMS_SHA256_M32_H10 ? 10u : 0)\0A\0A/* The length of a hash output, Currently only implemented for SHA256.\0A * Max is 32 bytes.\0A */\0A#define MBEDTLS_LMS_M_NODE_BYTES(type) ((type) == MBEDTLS_LMS_SHA256_M32_H10 ? 32 : 0)\0A#define MBEDTLS_LMS_M_NODE_BYTES_MAX 32\0A\0A#define MBEDTLS_LMS_SIG_LEN(type, otstype) (MBEDTLS_LMOTS_Q_LEAF_ID_LEN + \5C\0A                                            MBEDTLS_LMOTS_SIG_LEN(otstype) + \5C\0A                                            MBEDTLS_LMS_TYPE_LEN + \5C\0A                                            (MBEDTLS_LMS_H_TREE_HEIGHT(type) * \5C\0A                                             MBEDTLS_LMS_M_NODE_BYTES(type)))\0A\0A#define MBEDTLS_LMS_PUBLIC_KEY_LEN(type) (MBEDTLS_LMS_TYPE_LEN + \5C\0A                                          MBEDTLS_LMOTS_TYPE_LEN + \5C\0A                                          MBEDTLS_LMOTS_I_KEY_ID_LEN + \5C\0A                                          MBEDTLS_LMS_M_NODE_BYTES(type))\0A\0A\0A#ifdef __cplusplus\0Aextern \22C\22 {\0A#endif\0A\0A/** The Identifier of the LMS parameter set, as per\0A * https://www.iana.org/assignments/leighton-micali-signatures/leighton-micali-signatures.xhtml\0A * We are only implementing a subset of the types, particularly H10, for the sake of simplicity.\0A */\0Atypedef enum {\0A    MBEDTLS_LMS_SHA256_M32_H10 = 0x6,\0A} mbedtls_lms_algorithm_type_t;\0A\0A/** The Identifier of the LMOTS parameter set, as per\0A *  https://www.iana.org/assignments/leighton-micali-signatures/leighton-micali-signatures.xhtml.\0A *  We are only implementing a subset of the types, particularly N32_W8, for the sake of simplicity.\0A */\0Atypedef enum {\0A    MBEDTLS_LMOTS_SHA256_N32_W8 = 4\0A} mbedtls_lmots_algorithm_type_t;\0A\0A/** LMOTS parameters structure.\0A *\0A * This contains the metadata associated with an LMOTS key, detailing the\0A * algorithm type, the key ID, and the leaf identifier should be key be part of\0A * a LMS key.\0A */\0Atypedef struct {\0A    unsigned char MBEDTLS_PRIVATE(I_key_identifier[MBEDTLS_LMOTS_I_KEY_ID_LEN]); /*!< The key\0A                                                                                    identifier. */\0A    unsigned char MBEDTLS_PRIVATE(q_leaf_identifier[MBEDTLS_LMOTS_Q_LEAF_ID_LEN]); /*!< Which\0A                                                                                      leaf of the LMS key this is.\0A                                                                                      0 if the key is not part of an LMS key. */\0A    mbedtls_lmots_algorithm_type_t MBEDTLS_PRIVATE(type); /*!< The LM-OTS key type identifier as\0A                                                               per IANA. Only SHA256_N32_W8 is\0A                                                               currently supported. */\0A} mbedtls_lmots_parameters_t;\0A\0A/** LMOTS public context structure.\0A *\0A * A LMOTS public key is a hash output, and the applicable parameter set.\0A *\0A * The context must be initialized before it is used. A public key must either\0A * be imported or generated from a private context.\0A *\0A * \5Cdot\0A * digraph lmots_public_t {\0A *   UNINITIALIZED -> INIT [label=\22init\22];\0A *   HAVE_PUBLIC_KEY -> INIT [label=\22free\22];\0A *   INIT -> HAVE_PUBLIC_KEY [label=\22import_public_key\22];\0A *   INIT -> HAVE_PUBLIC_KEY [label=\22calculate_public_key from private key\22];\0A *   HAVE_PUBLIC_KEY -> HAVE_PUBLIC_KEY [label=\22export_public_key\22];\0A * }\0A * \5Cenddot\0A */\0Atypedef struct {\0A    mbedtls_lmots_parameters_t MBEDTLS_PRIVATE(params);\0A    unsigned char MBEDTLS_PRIVATE(public_key)[MBEDTLS_LMOTS_N_HASH_LEN_MAX];\0A    unsigned char MBEDTLS_PRIVATE(have_public_key); /*!< Whether the context contains a public key.\0A                                                       Boolean values only. */\0A} mbedtls_lmots_public_t;\0A\0A#if defined(MBEDTLS_LMS_PRIVATE)\0A/** LMOTS private context structure.\0A *\0A * A LMOTS private key is one hash output for each of digit of the digest +\0A * checksum, and the applicable parameter set.\0A *\0A * The context must be initialized before it is used. A public key must either\0A * be imported or generated from a private context.\0A *\0A * \5Cdot\0A * digraph lmots_public_t {\0A *   UNINITIALIZED -> INIT [label=\22init\22];\0A *   HAVE_PRIVATE_KEY -> INIT [label=\22free\22];\0A *   INIT -> HAVE_PRIVATE_KEY [label=\22generate_private_key\22];\0A *   HAVE_PRIVATE_KEY -> INIT [label=\22sign\22];\0A * }\0A * \5Cenddot\0A */\0Atypedef struct {\0A    mbedtls_lmots_parameters_t MBEDTLS_PRIVATE(params);\0A    unsigned char MBEDTLS_PRIVATE(private_key)[MBEDTLS_LMOTS_P_SIG_DIGIT_COUNT_MAX][\0A        MBEDTLS_LMOTS_N_HASH_LEN_MAX];\0A    unsigned char MBEDTLS_PRIVATE(have_private_key); /*!< Whether the context contains a private key.\0A                                                        Boolean values only. */\0A} mbedtls_lmots_private_t;\0A#endif /* defined(MBEDTLS_LMS_PRIVATE) */\0A\0A\0A/** LMS parameters structure.\0A *\0A * This contains the metadata associated with an LMS key, detailing the\0A * algorithm type, the type of the underlying OTS algorithm, and the key ID.\0A */\0Atypedef struct {\0A    unsigned char MBEDTLS_PRIVATE(I_key_identifier[MBEDTLS_LMOTS_I_KEY_ID_LEN]); /*!< The key\0A                                                                                    identifier. */\0A    mbedtls_lmots_algorithm_type_t MBEDTLS_PRIVATE(otstype); /*!< The LM-OTS key type identifier as\0A                                                                per IANA. Only SHA256_N32_W8 is\0A                                                                currently supported. */\0A    mbedtls_lms_algorithm_type_t MBEDTLS_PRIVATE(type); /*!< The LMS key type identifier as per\0A                                                             IANA. Only SHA256_M32_H10 is currently\0A                                                             supported. */\0A} mbedtls_lms_parameters_t;\0A\0A/** LMS public context structure.\0A *\0A * A LMS public key is the hash output that is the root of the Merkle tree, and\0A * the applicable parameter set\0A *\0A * The context must be initialized before it is used. A public key must either\0A * be imported or generated from a private context.\0A *\0A * \5Cdot\0A * digraph lms_public_t {\0A *   UNINITIALIZED -> INIT [label=\22init\22];\0A *   HAVE_PUBLIC_KEY -> INIT [label=\22free\22];\0A *   INIT -> HAVE_PUBLIC_KEY [label=\22import_public_key\22];\0A *   INIT -> HAVE_PUBLIC_KEY [label=\22calculate_public_key from private key\22];\0A *   HAVE_PUBLIC_KEY -> HAVE_PUBLIC_KEY [label=\22export_public_key\22];\0A * }\0A * \5Cenddot\0A */\0Atypedef struct {\0A    mbedtls_lms_parameters_t MBEDTLS_PRIVATE(params);\0A    unsigned char MBEDTLS_PRIVATE(T_1_pub_key)[MBEDTLS_LMS_M_NODE_BYTES_MAX]; /*!< The public key, in\0A                                                                                 the form of the Merkle tree root node. */\0A    unsigned char MBEDTLS_PRIVATE(have_public_key); /*!< Whether the context contains a public key.\0A                                                       Boolean values only. */\0A} mbedtls_lms_public_t;\0A\0A\0A#if defined(MBEDTLS_LMS_PRIVATE)\0A/** LMS private context structure.\0A *\0A * A LMS private key is a set of LMOTS private keys, an index to the next usable\0A * key, and the applicable parameter set.\0A *\0A * The context must be initialized before it is used. A public key must either\0A * be imported or generated from a private context.\0A *\0A * \5Cdot\0A * digraph lms_public_t {\0A *   UNINITIALIZED -> INIT [label=\22init\22];\0A *   HAVE_PRIVATE_KEY -> INIT [label=\22free\22];\0A *   INIT -> HAVE_PRIVATE_KEY [label=\22generate_private_key\22];\0A * }\0A * \5Cenddot\0A */\0Atypedef struct {\0A    mbedtls_lms_parameters_t MBEDTLS_PRIVATE(params);\0A    uint32_t MBEDTLS_PRIVATE(q_next_usable_key); /*!< The index of the next OTS key that has not\0A                                                      been used. */\0A    mbedtls_lmots_private_t *MBEDTLS_PRIVATE(ots_private_keys); /*!< The private key material. One OTS key\0A                                                                   for each leaf node in the Merkle tree. NULL\0A                                                                   when have_private_key is 0 and non-NULL otherwise.\0A                                                                   is 2^MBEDTLS_LMS_H_TREE_HEIGHT(type) in length. */\0A    mbedtls_lmots_public_t *MBEDTLS_PRIVATE(ots_public_keys); /*!< The OTS key public keys, used to\0A                                                                   build the Merkle tree. NULL\0A                                                                   when have_private_key is 0 and\0A                                                                   non-NULL otherwise.\0A                                                                   Is 2^MBEDTLS_LMS_H_TREE_HEIGHT(type)\0A                                                                   in length. */\0A    unsigned char MBEDTLS_PRIVATE(have_private_key); /*!< Whether the context contains a private key.\0A                                                        Boolean values only. */\0A} mbedtls_lms_private_t;\0A#endif /* defined(MBEDTLS_LMS_PRIVATE) */\0A\0A/**\0A * \5Cbrief                    This function initializes an LMS public context\0A *\0A * \5Cparam ctx                The uninitialized LMS context that will then be\0A *                           initialized.\0A */\0Avoid mbedtls_lms_public_init(mbedtls_lms_public_t *ctx);\0A\0A/**\0A * \5Cbrief                    This function uninitializes an LMS public context\0A *\0A * \5Cparam ctx                The initialized LMS context that will then be\0A *                           uninitialized.\0A */\0Avoid mbedtls_lms_public_free(mbedtls_lms_public_t *ctx);\0A\0A/**\0A * \5Cbrief                    This function imports an LMS public key into a\0A *                           public LMS context.\0A *\0A * \5Cnote                     Before this function is called, the context must\0A *                           have been initialized.\0A *\0A * \5Cnote                     See IETF RFC8554 for details of the encoding of\0A *                           this public key.\0A *\0A * \5Cparam ctx                The initialized LMS context store the key in.\0A * \5Cparam key                The buffer from which the key will be read.\0A *                           #MBEDTLS_LMS_PUBLIC_KEY_LEN bytes will be read from\0A *                           this.\0A * \5Cparam key_size           The size of the key being imported.\0A *\0A * \5Creturn         \5Cc 0 on success.\0A * \5Creturn         A non-zero error code on failure.\0A */\0Aint mbedtls_lms_import_public_key(mbedtls_lms_public_t *ctx,\0A                                  const unsigned char *key, size_t key_size);\0A\0A/**\0A * \5Cbrief                    This function exports an LMS public key from a\0A *                           LMS public context that already contains a public\0A *                           key.\0A *\0A * \5Cnote                     Before this function is called, the context must\0A *                           have been initialized and the context must contain\0A *                           a public key.\0A *\0A * \5Cnote                     See IETF RFC8554 for details of the encoding of\0A *                           this public key.\0A *\0A * \5Cparam ctx                The initialized LMS public context that contains\0A *                           the public key.\0A * \5Cparam key                The buffer into which the key will be output. Must\0A *                           be at least #MBEDTLS_LMS_PUBLIC_KEY_LEN in size.\0A * \5Cparam key_size           The size of the key buffer.\0A * \5Cparam key_len            If not NULL, will be written with the size of the\0A *                           key.\0A *\0A * \5Creturn         \5Cc 0 on success.\0A * \5Creturn         A non-zero error code on failure.\0A */\0Aint mbedtls_lms_export_public_key(const mbedtls_lms_public_t *ctx,\0A                                  unsigned char *key, size_t key_size,\0A                                  size_t *key_len);\0A\0A/**\0A * \5Cbrief                    This function verifies a LMS signature, using a\0A *                           LMS context that contains a public key.\0A *\0A * \5Cnote                     Before this function is called, the context must\0A *                           have been initialized and must contain a public key\0A *                           (either by import or generation).\0A *\0A * \5Cparam ctx                The initialized LMS public context from which the\0A *                           public key will be read.\0A * \5Cparam msg                The buffer from which the message will be read.\0A * \5Cparam msg_size           The size of the message that will be read.\0A * \5Cparam sig                The buf from which the signature will be read.\0A *                           #MBEDTLS_LMS_SIG_LEN bytes will be read from\0A *                           this.\0A * \5Cparam sig_size           The size of the signature to be verified.\0A *\0A * \5Creturn         \5Cc 0 on successful verification.\0A * \5Creturn         A non-zero error code on failure.\0A */\0Aint mbedtls_lms_verify(const mbedtls_lms_public_t *ctx,\0A                       const unsigned char *msg, size_t msg_size,\0A                       const unsigned char *sig, size_t sig_size);\0A\0A#if defined(MBEDTLS_LMS_PRIVATE)\0A/**\0A * \5Cbrief                    This function initializes an LMS private context\0A *\0A * \5Cparam ctx                The uninitialized LMS private context that will\0A *                           then be initialized. */\0Avoid mbedtls_lms_private_init(mbedtls_lms_private_t *ctx);\0A\0A/**\0A * \5Cbrief                    This function uninitializes an LMS private context\0A *\0A * \5Cparam ctx                The initialized LMS private context that will then\0A *                           be uninitialized.\0A */\0Avoid mbedtls_lms_private_free(mbedtls_lms_private_t *ctx);\0A\0A/**\0A * \5Cbrief                    This function generates an LMS private key, and\0A *                           stores in into an LMS private context.\0A *\0A * \5Cwarning                  This function is **not intended for use in\0A *                           production**, due to as-yet unsolved problems with\0A *                           handling stateful keys. The API for this function\0A *                           may change considerably in future versions.\0A *\0A * \5Cnote                     The seed must have at least 256 bits of entropy.\0A *\0A * \5Cparam ctx                The initialized LMOTS context to generate the key\0A *                           into.\0A * \5Cparam type               The LMS parameter set identifier.\0A * \5Cparam otstype            The LMOTS parameter set identifier.\0A * \5Cparam f_rng              The RNG function to be used to generate the key ID.\0A * \5Cparam p_rng              The RNG context to be passed to f_rng\0A * \5Cparam seed               The seed used to deterministically generate the\0A *                           key.\0A * \5Cparam seed_size          The length of the seed.\0A *\0A * \5Creturn         \5Cc 0 on success.\0A * \5Creturn         A non-zero error code on failure.\0A */\0Aint mbedtls_lms_generate_private_key(mbedtls_lms_private_t *ctx,\0A                                     mbedtls_lms_algorithm_type_t type,\0A                                     mbedtls_lmots_algorithm_type_t otstype,\0A                                     int (*f_rng)(void *, unsigned char *, size_t),\0A                                     void *p_rng, const unsigned char *seed,\0A                                     size_t seed_size);\0A\0A/**\0A * \5Cbrief                    This function calculates an LMS public key from a\0A *                           LMS context that already contains a private key.\0A *\0A * \5Cnote                     Before this function is called, the context must\0A *                           have been initialized and the context must contain\0A *                           a private key.\0A *\0A * \5Cparam ctx                The initialized LMS public context to calculate the key\0A *                           from and store it into.\0A *\0A * \5Cparam priv_ctx           The LMS private context to read the private key\0A *                           from. This must have been initialized and contain a\0A *                           private key.\0A *\0A * \5Creturn         \5Cc 0 on success.\0A * \5Creturn         A non-zero error code on failure.\0A */\0Aint mbedtls_lms_calculate_public_key(mbedtls_lms_public_t *ctx,\0A                                     const mbedtls_lms_private_t *priv_ctx);\0A\0A/**\0A * \5Cbrief                    This function creates a LMS signature, using a\0A *                           LMS context that contains unused private keys.\0A *\0A * \5Cwarning                  This function is **not intended for use in\0A *                           production**, due to as-yet unsolved problems with\0A *                           handling stateful keys. The API for this function\0A *                           may change considerably in future versions.\0A *\0A * \5Cnote                     Before this function is called, the context must\0A *                           have been initialized and must contain a private\0A *                           key.\0A *\0A * \5Cnote                     Each of the LMOTS private keys inside a LMS private\0A *                           key can only be used once. If they are reused, then\0A *                           attackers may be able to forge signatures with that\0A *                           key. This is all handled transparently, but it is\0A *                           important to not perform copy operations on LMS\0A *                           contexts that contain private key material.\0A *\0A * \5Cparam ctx                The initialized LMS private context from which the\0A *                           private key will be read.\0A * \5Cparam f_rng              The RNG function to be used for signature\0A *                           generation.\0A * \5Cparam p_rng              The RNG context to be passed to f_rng\0A * \5Cparam msg                The buffer from which the message will be read.\0A * \5Cparam msg_size           The size of the message that will be read.\0A * \5Cparam sig                The buf into which the signature will be stored.\0A *                           Must be at least #MBEDTLS_LMS_SIG_LEN in size.\0A * \5Cparam sig_size           The size of the buffer the signature will be\0A *                           written into.\0A * \5Cparam sig_len            If not NULL, will be written with the size of the\0A *                           signature.\0A *\0A * \5Creturn         \5Cc 0 on success.\0A * \5Creturn         A non-zero error code on failure.\0A */\0Aint mbedtls_lms_sign(mbedtls_lms_private_t *ctx,\0A                     int (*f_rng)(void *, unsigned char *, size_t),\0A                     void *p_rng, const unsigned char *msg,\0A                     unsigned int msg_size, unsigned char *sig, size_t sig_size,\0A                     size_t *sig_len);\0A#endif /* defined(MBEDTLS_LMS_PRIVATE) */\0A\0A#ifdef __cplusplus\0A}\0A#endif\0A\0A#endif /* MBEDTLS_LMS_H */\0A\00" }
