@.str44362 = private global { i64, i64, [3442 x i8] } { i64 -1, i64 3441, [3442 x i8] c"/**\0A * \5Cfile ripemd160.h\0A *\0A * \5Cbrief RIPE MD-160 message digest\0A */\0A/*\0A *  Copyright The Mbed TLS Contributors\0A *  SPDX-License-Identifier: Apache-2.0 OR GPL-2.0-or-later\0A */\0A#ifndef MBEDTLS_RIPEMD160_H\0A#define MBEDTLS_RIPEMD160_H\0A#include \22mbedtls/private_access.h\22\0A\0A#include \22mbedtls/build_info.h\22\0A\0A#include <stddef.h>\0A#include <stdint.h>\0A\0A#ifdef __cplusplus\0Aextern \22C\22 {\0A#endif\0A\0A#if !defined(MBEDTLS_RIPEMD160_ALT)\0A// Regular implementation\0A//\0A\0A/**\0A * \5Cbrief          RIPEMD-160 context structure\0A */\0Atypedef struct mbedtls_ripemd160_context {\0A    uint32_t MBEDTLS_PRIVATE(total)[2];          /*!< number of bytes processed  */\0A    uint32_t MBEDTLS_PRIVATE(state)[5];          /*!< intermediate digest state  */\0A    unsigned char MBEDTLS_PRIVATE(buffer)[64];   /*!< data block being processed */\0A}\0Ambedtls_ripemd160_context;\0A\0A#else  /* MBEDTLS_RIPEMD160_ALT */\0A#include \22ripemd160_alt.h\22\0A#endif /* MBEDTLS_RIPEMD160_ALT */\0A\0A/**\0A * \5Cbrief          Initialize RIPEMD-160 context\0A *\0A * \5Cparam ctx      RIPEMD-160 context to be initialized\0A */\0Avoid mbedtls_ripemd160_init(mbedtls_ripemd160_context *ctx);\0A\0A/**\0A * \5Cbrief          Clear RIPEMD-160 context\0A *\0A * \5Cparam ctx      RIPEMD-160 context to be cleared\0A */\0Avoid mbedtls_ripemd160_free(mbedtls_ripemd160_context *ctx);\0A\0A/**\0A * \5Cbrief          Clone (the state of) a RIPEMD-160 context\0A *\0A * \5Cparam dst      The destination context\0A * \5Cparam src      The context to be cloned\0A */\0Avoid mbedtls_ripemd160_clone(mbedtls_ripemd160_context *dst,\0A                             const mbedtls_ripemd160_context *src);\0A\0A/**\0A * \5Cbrief          RIPEMD-160 context setup\0A *\0A * \5Cparam ctx      context to be initialized\0A *\0A * \5Creturn         0 if successful\0A */\0Aint mbedtls_ripemd160_starts(mbedtls_ripemd160_context *ctx);\0A\0A/**\0A * \5Cbrief          RIPEMD-160 process buffer\0A *\0A * \5Cparam ctx      RIPEMD-160 context\0A * \5Cparam input    buffer holding the data\0A * \5Cparam ilen     length of the input data\0A *\0A * \5Creturn         0 if successful\0A */\0Aint mbedtls_ripemd160_update(mbedtls_ripemd160_context *ctx,\0A                             const unsigned char *input,\0A                             size_t ilen);\0A\0A/**\0A * \5Cbrief          RIPEMD-160 final digest\0A *\0A * \5Cparam ctx      RIPEMD-160 context\0A * \5Cparam output   RIPEMD-160 checksum result\0A *\0A * \5Creturn         0 if successful\0A */\0Aint mbedtls_ripemd160_finish(mbedtls_ripemd160_context *ctx,\0A                             unsigned char output[20]);\0A\0A/**\0A * \5Cbrief          RIPEMD-160 process data block (internal use only)\0A *\0A * \5Cparam ctx      RIPEMD-160 context\0A * \5Cparam data     buffer holding one block of data\0A *\0A * \5Creturn         0 if successful\0A */\0Aint mbedtls_internal_ripemd160_process(mbedtls_ripemd160_context *ctx,\0A                                       const unsigned char data[64]);\0A\0A/**\0A * \5Cbrief          Output = RIPEMD-160( input buffer )\0A *\0A * \5Cparam input    buffer holding the data\0A * \5Cparam ilen     length of the input data\0A * \5Cparam output   RIPEMD-160 checksum result\0A *\0A * \5Creturn         0 if successful\0A */\0Aint mbedtls_ripemd160(const unsigned char *input,\0A                      size_t ilen,\0A                      unsigned char output[20]);\0A\0A#if defined(MBEDTLS_SELF_TEST)\0A\0A/**\0A * \5Cbrief          Checkup routine\0A *\0A * \5Creturn         0 if successful, or 1 if the test failed\0A */\0Aint mbedtls_ripemd160_self_test(int verbose);\0A\0A#endif /* MBEDTLS_SELF_TEST */\0A\0A#ifdef __cplusplus\0A}\0A#endif\0A\0A#endif /* mbedtls_ripemd160.h */\0A\00" }
