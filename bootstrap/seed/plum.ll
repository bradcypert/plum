@.str39453 = private global { i64, i64, [25573 x i8] } { i64 -1, i64 25572, [25573 x i8] c"/**\0A * \5Cfile ccm.h\0A *\0A * \5Cbrief This file provides an API for the CCM authenticated encryption\0A *        mode for block ciphers.\0A *\0A * CCM combines Counter mode encryption with CBC-MAC authentication\0A * for 128-bit block ciphers.\0A *\0A * Input to CCM includes the following elements:\0A * <ul><li>Payload - data that is both authenticated and encrypted.</li>\0A * <li>Associated data (Adata) - data that is authenticated but not\0A * encrypted, For example, a header.</li>\0A * <li>Nonce - A unique value that is assigned to the payload and the\0A * associated data.</li></ul>\0A *\0A * Definition of CCM:\0A * http://csrc.nist.gov/publications/nistpubs/800-38C/SP800-38C_updated-July20_2007.pdf\0A * RFC 3610 \22Counter with CBC-MAC (CCM)\22\0A *\0A * Related:\0A * RFC 5116 \22An Interface and Algorithms for Authenticated Encryption\22\0A *\0A * Definition of CCM*:\0A * IEEE 802.15.4 - IEEE Standard for Local and metropolitan area networks\0A * Integer representation is fixed most-significant-octet-first order and\0A * the representation of octets is most-significant-bit-first order. This is\0A * consistent with RFC 3610.\0A */\0A/*\0A *  Copyright The Mbed TLS Contributors\0A *  SPDX-License-Identifier: Apache-2.0 OR GPL-2.0-or-later\0A */\0A\0A#ifndef MBEDTLS_CCM_H\0A#define MBEDTLS_CCM_H\0A#include \22mbedtls/private_access.h\22\0A\0A#include \22mbedtls/build_info.h\22\0A\0A#include \22mbedtls/cipher.h\22\0A\0A#if defined(MBEDTLS_BLOCK_CIPHER_C)\0A#include \22mbedtls/block_cipher.h\22\0A#endif\0A\0A#define MBEDTLS_CCM_DECRYPT       0\0A#define MBEDTLS_CCM_ENCRYPT       1\0A#define MBEDTLS_CCM_STAR_DECRYPT  2\0A#define MBEDTLS_CCM_STAR_ENCRYPT  3\0A\0A/** Bad input parameters to the function. */\0A#define MBEDTLS_ERR_CCM_BAD_INPUT       -0x000D\0A/** Authenticated decryption failed. */\0A#define MBEDTLS_ERR_CCM_AUTH_FAILED     -0x000F\0A\0A#ifdef __cplusplus\0Aextern \22C\22 {\0A#endif\0A\0A#if !defined(MBEDTLS_CCM_ALT)\0A// Regular implementation\0A//\0A\0A/**\0A * \5Cbrief    The CCM context-type definition. The CCM context is passed\0A *           to the APIs called.\0A */\0Atypedef struct mbedtls_ccm_context {\0A    unsigned char MBEDTLS_PRIVATE(y)[16];    /*!< The Y working buffer */\0A    unsigned char MBEDTLS_PRIVATE(ctr)[16];  /*!< The counter buffer */\0A    size_t MBEDTLS_PRIVATE(plaintext_len);   /*!< Total plaintext length */\0A    size_t MBEDTLS_PRIVATE(add_len);         /*!< Total authentication data length */\0A    size_t MBEDTLS_PRIVATE(tag_len);         /*!< Total tag length */\0A    size_t MBEDTLS_PRIVATE(processed);       /*!< Track how many bytes of input data\0A                                                  were processed (chunked input).\0A                                                  Used independently for both auth data\0A                                                  and plaintext/ciphertext.\0A                                                  This variable is set to zero after\0A                                                  auth data input is finished. */\0A    unsigned int MBEDTLS_PRIVATE(q);         /*!< The Q working value */\0A    unsigned int MBEDTLS_PRIVATE(mode);      /*!< The operation to perform:\0A                                              #MBEDTLS_CCM_ENCRYPT or\0A                                              #MBEDTLS_CCM_DECRYPT or\0A                                              #MBEDTLS_CCM_STAR_ENCRYPT or\0A                                              #MBEDTLS_CCM_STAR_DECRYPT. */\0A#if defined(MBEDTLS_BLOCK_CIPHER_C)\0A    mbedtls_block_cipher_context_t MBEDTLS_PRIVATE(block_cipher_ctx);    /*!< The cipher context used. */\0A#else\0A    mbedtls_cipher_context_t MBEDTLS_PRIVATE(cipher_ctx);    /*!< The cipher context used. */\0A#endif\0A    int MBEDTLS_PRIVATE(state);              /*!< Working value holding context's\0A                                                  state. Used for chunked data input */\0A}\0Ambedtls_ccm_context;\0A\0A#else  /* MBEDTLS_CCM_ALT */\0A#include \22ccm_alt.h\22\0A#endif /* MBEDTLS_CCM_ALT */\0A\0A/**\0A * \5Cbrief           This function initializes the specified CCM context,\0A *                  to make references valid, and prepare the context\0A *                  for mbedtls_ccm_setkey() or mbedtls_ccm_free().\0A *\0A * \5Cparam ctx       The CCM context to initialize. This must not be \5Cc NULL.\0A */\0Avoid mbedtls_ccm_init(mbedtls_ccm_context *ctx);\0A\0A/**\0A * \5Cbrief           This function initializes the CCM context set in the\0A *                  \5Cp ctx parameter and sets the encryption key.\0A *\0A * \5Cparam ctx       The CCM context to initialize. This must be an initialized\0A *                  context.\0A * \5Cparam cipher    The 128-bit block cipher to use.\0A * \5Cparam key       The encryption key. This must not be \5Cc NULL.\0A * \5Cparam keybits   The key size in bits. This must be acceptable by the cipher.\0A *\0A * \5Creturn          \5Cc 0 on success.\0A * \5Creturn          A CCM or cipher-specific error code on failure.\0A */\0Aint mbedtls_ccm_setkey(mbedtls_ccm_context *ctx,\0A                       mbedtls_cipher_id_t cipher,\0A                       const unsigned char *key,\0A                       unsigned int keybits);\0A\0A/**\0A * \5Cbrief   This function releases and clears the specified CCM context\0A *          and underlying cipher sub-context.\0A *\0A * \5Cparam ctx       The CCM context to clear. If this is \5Cc NULL, the function\0A *                  has no effect. Otherwise, this must be initialized.\0A */\0Avoid mbedtls_ccm_free(mbedtls_ccm_context *ctx);\0A\0A/**\0A * \5Cbrief           This function encrypts a buffer using CCM.\0A *\0A * \5Cnote            The tag is written to a separate buffer. To concatenate\0A *                  the \5Cp tag with the \5Cp output, as done in <em>RFC-3610:\0A *                  Counter with CBC-MAC (CCM)</em>, use\0A *                  \5Cp tag = \5Cp output + \5Cp length, and make sure that the\0A *                  output buffer is at least \5Cp length + \5Cp tag_len wide.\0A *\0A * \5Cparam ctx       The CCM context to use for encryption. This must be\0A *                  initialized and bound to a key.\0A * \5Cparam length    The length of the input data in Bytes.\0A * \5Cparam iv        The initialization vector (nonce). This must be a readable\0A *                  buffer of at least \5Cp iv_len Bytes.\0A * \5Cparam iv_len    The length of the nonce in Bytes: 7, 8, 9, 10, 11, 12,\0A *                  or 13. The length L of the message length field is\0A *                  15 - \5Cp iv_len.\0A * \5Cparam ad        The additional data field. If \5Cp ad_len is greater than\0A *                  zero, \5Cp ad must be a readable buffer of at least that\0A *                  length.\0A * \5Cparam ad_len    The length of additional data in Bytes.\0A *                  This must be less than `2^16 - 2^8`.\0A * \5Cparam input     The buffer holding the input data. If \5Cp length is greater\0A *                  than zero, \5Cp input must be a readable buffer of at least\0A *                  that length.\0A * \5Cparam output    The buffer holding the output data. If \5Cp length is greater\0A *                  than zero, \5Cp output must be a writable buffer of at least\0A *                  that length.\0A * \5Cparam tag       The buffer holding the authentication field. This must be a\0A *                  writable buffer of at least \5Cp tag_len Bytes.\0A * \5Cparam tag_len   The length of the authentication field to generate in Bytes:\0A *                  4, 6, 8, 10, 12, 14 or 16.\0A *\0A * \5Creturn          \5Cc 0 on success.\0A * \5Creturn          A CCM or cipher-specific error code on failure.\0A */\0Aint mbedtls_ccm_encrypt_and_tag(mbedtls_ccm_context *ctx, size_t length,\0A                                const unsigned char *iv, size_t iv_len,\0A                                const unsigned char *ad, size_t ad_len,\0A                                const unsigned char *input, unsigned char *output,\0A                                unsigned char *tag, size_t tag_len);\0A\0A/**\0A * \5Cbrief           This function encrypts a buffer using CCM*.\0A *\0A * \5Cnote            The tag is written to a separate buffer. To concatenate\0A *                  the \5Cp tag with the \5Cp output, as done in <em>RFC-3610:\0A *                  Counter with CBC-MAC (CCM)</em>, use\0A *                  \5Cp tag = \5Cp output + \5Cp length, and make sure that the\0A *                  output buffer is at least \5Cp length + \5Cp tag_len wide.\0A *\0A * \5Cnote            When using this function in a variable tag length context,\0A *                  the tag length has to be encoded into the \5Cp iv passed to\0A *                  this function.\0A *\0A * \5Cparam ctx       The CCM context to use for encryption. This must be\0A *                  initialized and bound to a key.\0A * \5Cparam length    The length of the input data in Bytes.\0A *                  For tag length = 0, input length is ignored.\0A * \5Cparam iv        The initialization vector (nonce). This must be a readable\0A *                  buffer of at least \5Cp iv_len Bytes.\0A * \5Cparam iv_len    The length of the nonce in Bytes: 7, 8, 9, 10, 11, 12,\0A *                  or 13. The length L of the message length field is\0A *                  15 - \5Cp iv_len.\0A * \5Cparam ad        The additional data field. This must be a readable buffer of\0A *                  at least \5Cp ad_len Bytes.\0A * \5Cparam ad_len    The length of additional data in Bytes.\0A *                  This must be less than 2^16 - 2^8.\0A * \5Cparam input     The buffer holding the input data. If \5Cp length is greater\0A *                  than zero, \5Cp input must be a readable buffer of at least\0A *                  that length.\0A * \5Cparam output    The buffer holding the output data. If \5Cp length is greater\0A *                  than zero, \5Cp output must be a writable buffer of at least\0A *                  that length.\0A * \5Cparam tag       The buffer holding the authentication field. This must be a\0A *                  writable buffer of at least \5Cp tag_len Bytes.\0A * \5Cparam tag_len   The length of the authentication field to generate in Bytes:\0A *                  0, 4, 6, 8, 10, 12, 14 or 16.\0A *\0A * \5Cwarning         Passing \5Cc 0 as \5Cp tag_len means that the message is no\0A *                  longer authenticated.\0A *\0A * \5Creturn          \5Cc 0 on success.\0A * \5Creturn          A CCM or cipher-specific error code on failure.\0A */\0Aint mbedtls_ccm_star_encrypt_and_tag(mbedtls_ccm_context *ctx, size_t length,\0A                                     const unsigned char *iv, size_t iv_len,\0A                                     const unsigned char *ad, size_t ad_len,\0A                                     const unsigned char *input, unsigned char *output,\0A                                     unsigned char *tag, size_t tag_len);\0A\0A/**\0A * \5Cbrief           This function performs a CCM authenticated decryption of a\0A *                  buffer.\0A *\0A * \5Cparam ctx       The CCM context to use for decryption. This must be\0A *                  initialized and bound to a key.\0A * \5Cparam length    The length of the input data in Bytes.\0A * \5Cparam iv        The initialization vector (nonce). This must be a readable\0A *                  buffer of at least \5Cp iv_len Bytes.\0A * \5Cparam iv_len    The length of the nonce in Bytes: 7, 8, 9, 10, 11, 12,\0A *                  or 13. The length L of the message length field is\0A *                  15 - \5Cp iv_len.\0A * \5Cparam ad        The additional data field. This must be a readable buffer\0A *                  of at least that \5Cp ad_len Bytes..\0A * \5Cparam ad_len    The length of additional data in Bytes.\0A *                  This must be less than 2^16 - 2^8.\0A * \5Cparam input     The buffer holding the input data. If \5Cp length is greater\0A *                  than zero, \5Cp input must be a readable buffer of at least\0A *                  that length.\0A * \5Cparam output    The buffer holding the output data. If \5Cp length is greater\0A *                  than zero, \5Cp output must be a writable buffer of at least\0A *                  that length.\0A * \5Cparam tag       The buffer holding the authentication field. This must be a\0A *                  readable buffer of at least \5Cp tag_len Bytes.\0A * \5Cparam tag_len   The length of the authentication field to generate in Bytes:\0A *                  4, 6, 8, 10, 12, 14 or 16.\0A *\0A * \5Creturn          \5Cc 0 on success. This indicates that the message is authentic.\0A * \5Creturn          #MBEDTLS_ERR_CCM_AUTH_FAILED if the tag does not match.\0A * \5Creturn          A cipher-specific error code on calculation failure.\0A */\0Aint mbedtls_ccm_auth_decrypt(mbedtls_ccm_context *ctx, size_t length,\0A                             const unsigned char *iv, size_t iv_len,\0A                             const unsigned char *ad, size_t ad_len,\0A                             const unsigned char *input, unsigned char *output,\0A                             const unsigned char *tag, size_t tag_len);\0A\0A/**\0A * \5Cbrief           This function performs a CCM* authenticated decryption of a\0A *                  buffer.\0A *\0A * \5Cnote            When using this function in a variable tag length context,\0A *                  the tag length has to be decoded from \5Cp iv and passed to\0A *                  this function as \5Cp tag_len. (\5Cp tag needs to be adjusted\0A *                  accordingly.)\0A *\0A * \5Cparam ctx       The CCM context to use for decryption. This must be\0A *                  initialized and bound to a key.\0A * \5Cparam length    The length of the input data in Bytes.\0A *                  For tag length = 0, input length is ignored.\0A * \5Cparam iv        The initialization vector (nonce). This must be a readable\0A *                  buffer of at least \5Cp iv_len Bytes.\0A * \5Cparam iv_len    The length of the nonce in Bytes: 7, 8, 9, 10, 11, 12,\0A *                  or 13. The length L of the message length field is\0A *                  15 - \5Cp iv_len.\0A * \5Cparam ad        The additional data field. This must be a readable buffer of\0A *                  at least that \5Cp ad_len Bytes.\0A * \5Cparam ad_len    The length of additional data in Bytes.\0A *                  This must be less than 2^16 - 2^8.\0A * \5Cparam input     The buffer holding the input data. If \5Cp length is greater\0A *                  than zero, \5Cp input must be a readable buffer of at least\0A *                  that length.\0A * \5Cparam output    The buffer holding the output data. If \5Cp length is greater\0A *                  than zero, \5Cp output must be a writable buffer of at least\0A *                  that length.\0A * \5Cparam tag       The buffer holding the authentication field. This must be a\0A *                  readable buffer of at least \5Cp tag_len Bytes.\0A * \5Cparam tag_len   The length of the authentication field in Bytes.\0A *                  0, 4, 6, 8, 10, 12, 14 or 16.\0A *\0A * \5Cwarning         Passing \5Cc 0 as \5Cp tag_len means that the message is nos\0A *                  longer authenticated.\0A *\0A * \5Creturn          \5Cc 0 on success.\0A * \5Creturn          #MBEDTLS_ERR_CCM_AUTH_FAILED if the tag does not match.\0A * \5Creturn          A cipher-specific error code on calculation failure.\0A */\0Aint mbedtls_ccm_star_auth_decrypt(mbedtls_ccm_context *ctx, size_t length,\0A                                  const unsigned char *iv, size_t iv_len,\0A                                  const unsigned char *ad, size_t ad_len,\0A                                  const unsigned char *input, unsigned char *output,\0A                                  const unsigned char *tag, size_t tag_len);\0A\0A/**\0A * \5Cbrief           This function starts a CCM encryption or decryption\0A *                  operation.\0A *\0A *                  This function and mbedtls_ccm_set_lengths() must be called\0A *                  before calling mbedtls_ccm_update_ad() or\0A *                  mbedtls_ccm_update(). This function can be called before\0A *                  or after mbedtls_ccm_set_lengths().\0A *\0A * \5Cnote            This function is not implemented in Mbed TLS yet.\0A *\0A * \5Cparam ctx       The CCM context. This must be initialized.\0A * \5Cparam mode      The operation to perform: #MBEDTLS_CCM_ENCRYPT or\0A *                  #MBEDTLS_CCM_DECRYPT or #MBEDTLS_CCM_STAR_ENCRYPT or\0A *                  #MBEDTLS_CCM_STAR_DECRYPT.\0A * \5Cparam iv        The initialization vector. This must be a readable buffer\0A *                  of at least \5Cp iv_len Bytes.\0A * \5Cparam iv_len    The length of the nonce in Bytes: 7, 8, 9, 10, 11, 12,\0A *                  or 13. The length L of the message length field is\0A *                  15 - \5Cp iv_len.\0A *\0A * \5Creturn          \5Cc 0 on success.\0A * \5Creturn          #MBEDTLS_ERR_CCM_BAD_INPUT on failure:\0A *                  \5Cp ctx is in an invalid state,\0A *                  \5Cp mode is invalid,\0A *                  \5Cp iv_len is invalid (lower than \5Cc 7 or greater than\0A *                  \5Cc 13).\0A */\0Aint mbedtls_ccm_starts(mbedtls_ccm_context *ctx,\0A                       int mode,\0A                       const unsigned char *iv,\0A                       size_t iv_len);\0A\0A/**\0A * \5Cbrief           This function declares the lengths of the message\0A *                  and additional data for a CCM encryption or decryption\0A *                  operation.\0A *\0A *                  This function and mbedtls_ccm_starts() must be called\0A *                  before calling mbedtls_ccm_update_ad() or\0A *                  mbedtls_ccm_update(). This function can be called before\0A *                  or after mbedtls_ccm_starts().\0A *\0A * \5Cnote            This function is not implemented in Mbed TLS yet.\0A *\0A * \5Cparam ctx       The CCM context. This must be initialized.\0A * \5Cparam total_ad_len   The total length of additional data in bytes.\0A *                       This must be less than `2^16 - 2^8`.\0A * \5Cparam plaintext_len  The length in bytes of the plaintext to encrypt or\0A *                       result of the decryption (thus not encompassing the\0A *                       additional data that are not encrypted).\0A * \5Cparam tag_len   The length of the tag to generate in Bytes:\0A *                  4, 6, 8, 10, 12, 14 or 16.\0A *                  For CCM*, zero is also valid.\0A *\0A * \5Creturn          \5Cc 0 on success.\0A * \5Creturn          #MBEDTLS_ERR_CCM_BAD_INPUT on failure:\0A *                  \5Cp ctx is in an invalid state,\0A *                  \5Cp total_ad_len is greater than \5Cc 0xFF00.\0A */\0Aint mbedtls_ccm_set_lengths(mbedtls_ccm_context *ctx,\0A                            size_t total_ad_len,\0A                            size_t plaintext_len,\0A                            size_t tag_len);\0A\0A/**\0A * \5Cbrief           This function feeds an input buffer as associated data\0A *                  (authenticated but not encrypted data) in a CCM\0A *                  encryption or decryption operation.\0A *\0A *                  You may call this function zero, one or more times\0A *                  to pass successive parts of the additional data. The\0A *                  lengths \5Cp ad_len of the data parts should eventually add\0A *                  up exactly to the total length of additional data\0A *                  \5Cc total_ad_len passed to mbedtls_ccm_set_lengths(). You\0A *                  may not call this function after calling\0A *                  mbedtls_ccm_update().\0A *\0A * \5Cnote            This function is not implemented in Mbed TLS yet.\0A *\0A * \5Cparam ctx       The CCM context. This must have been started with\0A *                  mbedtls_ccm_starts(), the lengths of the message and\0A *                  additional data must have been declared with\0A *                  mbedtls_ccm_set_lengths() and this must not have yet\0A *                  received any input with mbedtls_ccm_update().\0A * \5Cparam ad        The buffer holding the additional data, or \5Cc NULL\0A *                  if \5Cp ad_len is \5Cc 0.\0A * \5Cparam ad_len    The length of the additional data. If \5Cc 0,\0A *                  \5Cp ad may be \5Cc NULL.\0A *\0A * \5Creturn          \5Cc 0 on success.\0A * \5Creturn          #MBEDTLS_ERR_CCM_BAD_INPUT on failure:\0A *                  \5Cp ctx is in an invalid state,\0A *                  total input length too long.\0A */\0Aint mbedtls_ccm_update_ad(mbedtls_ccm_context *ctx,\0A                          const unsigned char *ad,\0A                          size_t ad_len);\0A\0A/**\0A * \5Cbrief           This function feeds an input buffer into an ongoing CCM\0A *                  encryption or decryption operation.\0A *\0A *                  You may call this function zero, one or more times\0A *                  to pass successive parts of the input: the plaintext to\0A *                  encrypt, or the ciphertext (not including the tag) to\0A *                  decrypt. After the last part of the input, call\0A *                  mbedtls_ccm_finish(). The lengths \5Cp input_len of the\0A *                  data parts should eventually add up exactly to the\0A *                  plaintext length \5Cc plaintext_len passed to\0A *                  mbedtls_ccm_set_lengths().\0A *\0A *                  This function may produce output in one of the following\0A *                  ways:\0A *                  - Immediate output: the output length is always equal\0A *                    to the input length.\0A *                  - Buffered output: except for the last part of input data,\0A *                    the output consists of a whole number of 16-byte blocks.\0A *                    If the total input length so far (not including\0A *                    associated data) is 16 \5C* *B* + *A* with *A* < 16 then\0A *                    the total output length is 16 \5C* *B*.\0A *                    For the last part of input data, the output length is\0A *                    equal to the input length plus the number of bytes (*A*)\0A *                    buffered in the previous call to the function (if any).\0A *                    The function uses the plaintext length\0A *                    \5Cc plaintext_len passed to mbedtls_ccm_set_lengths()\0A *                    to detect the last part of input data.\0A *\0A *                  In particular:\0A *                  - It is always correct to call this function with\0A *                    \5Cp output_size >= \5Cp input_len + 15.\0A *                  - If \5Cp input_len is a multiple of 16 for all the calls\0A *                    to this function during an operation (not necessary for\0A *                    the last one) then it is correct to use \5Cp output_size\0A *                    =\5Cp input_len.\0A *\0A * \5Cnote            This function is not implemented in Mbed TLS yet.\0A *\0A * \5Cparam ctx           The CCM context. This must have been started with\0A *                      mbedtls_ccm_starts() and the lengths of the message and\0A *                      additional data must have been declared with\0A *                      mbedtls_ccm_set_lengths().\0A * \5Cparam input         The buffer holding the input data. If \5Cp input_len\0A *                      is greater than zero, this must be a readable buffer\0A *                      of at least \5Cp input_len bytes.\0A * \5Cparam input_len     The length of the input data in bytes.\0A * \5Cparam output        The buffer for the output data. If \5Cp output_size\0A *                      is greater than zero, this must be a writable buffer of\0A *                      at least \5Cp output_size bytes.\0A * \5Cparam output_size   The size of the output buffer in bytes.\0A *                      See the function description regarding the output size.\0A * \5Cparam output_len    On success, \5Cp *output_len contains the actual\0A *                      length of the output written in \5Cp output.\0A *                      On failure, the content of \5Cp *output_len is\0A *                      unspecified.\0A *\0A * \5Creturn         \5Cc 0 on success.\0A * \5Creturn         #MBEDTLS_ERR_CCM_BAD_INPUT on failure:\0A *                 \5Cp ctx is in an invalid state,\0A *                 total input length too long,\0A *                 or \5Cp output_size too small.\0A */\0Aint mbedtls_ccm_update(mbedtls_ccm_context *ctx,\0A                       const unsigned char *input, size_t input_len,\0A                       unsigned char *output, size_t output_size,\0A                       size_t *output_len);\0A\0A/**\0A * \5Cbrief           This function finishes the CCM operation and generates\0A *                  the authentication tag.\0A *\0A *                  It wraps up the CCM stream, and generates the\0A *                  tag. The tag can have a maximum length of 16 Bytes.\0A *\0A * \5Cnote            This function is not implemented in Mbed TLS yet.\0A *\0A * \5Cparam ctx       The CCM context. This must have been started with\0A *                  mbedtls_ccm_starts() and the lengths of the message and\0A *                  additional data must have been declared with\0A *                  mbedtls_ccm_set_lengths().\0A * \5Cparam tag       The buffer for holding the tag. If \5Cp tag_len is greater\0A *                  than zero, this must be a writable buffer of at least \5Cp\0A *                  tag_len Bytes.\0A * \5Cparam tag_len   The length of the tag. Must match the tag length passed to\0A *                  mbedtls_ccm_set_lengths() function.\0A *\0A * \5Creturn          \5Cc 0 on success.\0A * \5Creturn          #MBEDTLS_ERR_CCM_BAD_INPUT on failure:\0A *                  \5Cp ctx is in an invalid state,\0A *                  invalid value of \5Cp tag_len,\0A *                  the total amount of additional data passed to\0A *                  mbedtls_ccm_update_ad() was lower than the total length of\0A *                  additional data \5Cc total_ad_len passed to\0A *                  mbedtls_ccm_set_lengths(),\0A *                  the total amount of input data passed to\0A *                  mbedtls_ccm_update() was lower than the plaintext length\0A *                  \5Cc plaintext_len passed to mbedtls_ccm_set_lengths().\0A */\0Aint mbedtls_ccm_finish(mbedtls_ccm_context *ctx,\0A                       unsigned char *tag, size_t tag_len);\0A\0A#if defined(MBEDTLS_SELF_TEST) && defined(MBEDTLS_CCM_GCM_CAN_AES)\0A/**\0A * \5Cbrief          The CCM checkup routine.\0A *\0A * \5Creturn         \5Cc 0 on success.\0A * \5Creturn         \5Cc 1 on failure.\0A */\0Aint mbedtls_ccm_self_test(int verbose);\0A#endif /* MBEDTLS_SELF_TEST && MBEDTLS_AES_C */\0A\0A#ifdef __cplusplus\0A}\0A#endif\0A\0A#endif /* MBEDTLS_CCM_H */\0A\00" }
