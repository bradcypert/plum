 /* Remember the client asked us to send a new ticket */\0A    ssl->handshake->new_session_ticket = 1;\0A\0A    MBEDTLS_SSL_DEBUG_MSG(3, (\22ticket length: %\22 MBEDTLS_PRINTF_SIZET, len));\0A\0A    if (len == 0) {\0A        return 0;\0A    }\0A\0A#if defined(MBEDTLS_SSL_RENEGOTIATION)\0A    if (ssl->renego_status != MBEDTLS_SSL_INITIAL_HANDSHAKE) {\0A        MBEDTLS_SSL_DEBUG_MSG(3, (\22ticket rejected: renegotiating\22));\0A        return 0;\0A    }\0A#endif /* MBEDTLS_SSL_RENEGOTIATION */\0A\0A    /*\0A     * Failures are ok: just ignore the ticket and proceed.\0A     */\0A    if ((ret = ssl->conf->f_ticket_parse(ssl->conf->p_ticket, &session,\0A                                         buf, len)) != 0) {\0A        mbedtls_ssl_session_free(&session);\0A\0A        if (ret == MBEDTLS_ERR_SSL_INVALID_MAC) {\0A            MBEDTLS_SSL_DEBUG_MSG(3, (\22ticket is not authentic\22));\0A        } else if (ret == MBEDTLS_ERR_SSL_SESSION_TICKET_EXPIRED) {\0A            MBEDTLS_SSL_DEBUG_MSG(3, (\22ticket is expired\22));\0A        } else {\0A            MBEDTLS_SSL_DEBUG_RET(1, \22mbedtls_ssl_ticket_parse\22, ret);\0A        }\0A\0A        return 0;\0A    }\0A\0A    /*\0A     * Keep the session ID sent by the client, since we MUST send it back to\0A     * inform them we're accepting the ticket  (RFC 5077 section 3.4)\0A     */\0A    session.id_len = ssl->session_negotiate->id_len;\0A    memcpy(&session.id, ssl->session_negotiate->id, session.id_len);\0A\0A    mbedtls_ssl_session_free(ssl->session_negotiate);\0A    memcpy(ssl->session_negotiate, &session, sizeof(mbedtls_ssl_session));\0A\0A    /* Zeroize instead of free as we copied the content */\0A    mbedtls_platform_zeroize(&session, sizeof(mbedtls_ssl_session));\0A\0A    MBEDTLS_SSL_DEBUG_MSG(3, (\22session successfully restored from ticket\22));\0A\0A    ssl->handshake->resume = 1;\0A\0A    /* Don't send a new ticket after all, this one is OK */\0A    ssl->handshake->new_session_ticket = 0;\0A\0A    return 0;\0A}\0A#end