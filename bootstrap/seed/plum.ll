@.str40616 = private global { i64, i64, [2403 x i8] } { i64 -1, i64 2402, [2403 x i8] c"// Directory streams own their borrowed entry storage. No entry allocation\0A// escapes the shim: callers copy dir_entry_data before advancing or closing\0A// that handle. Separate handles have independent storage (no global/TLS buffer).\0A#include <dirent.h>\0A#include <sys/stat.h>\0A#include <string.h>\0A#include <stdlib.h>\0A#include <stdint.h>\0A#include <errno.h>\0A\0Atypedef struct {\0A    DIR *stream;\0A    const char *name;\0A} PlumDir;\0A\0Along long dir_open(const char *path) {\0A    DIR *stream = opendir(path);\0A    if (stream == NULL) return -1;\0A    PlumDir *dir = malloc(sizeof(*dir));\0A    if (dir == NULL) {\0A        closedir(stream);\0A        return -1;\0A    }\0A    dir->stream = stream;\0A    dir->name = \22\22;\0A    return (long long)(intptr_t)dir;\0A}\0A\0A// Positive byte length = entry; zero = exhaustion; -1 = read failure.\0A// Clear errno immediately before EACH read: skipped entries and callers\0A// can leave unrelated errors behind. Never turn a failed read into EOF.\0Along long dir_next_size(long long handle) {\0A    PlumDir *dir = (PlumDir *)(intptr_t)handle;\0A    if (dir == NULL) return -1;\0A    dir->name = \22\22;\0A    for (;;) {\0A        errno = 0;\0A        struct dirent *entry = readdir(dir->stream);\0A        if (entry == NULL) return errno == 0 ? 0 : -1;\0A        if (strcmp(entry->d_name, \22.\22) == 0 || strcmp(entry->d_name, \22..\22) == 0)\0A            continue;\0A        dir->name = entry->d_name;\0A        return (long long)strlen(dir->name);\0A    }\0A}\0A\0Aconst char *dir_entry_data(long long handle) {\0A    PlumDir *dir = (PlumDir *)(intptr_t)handle;\0A    return dir == NULL ? \22\22 : dir->name;\0A}\0A\0Avoid dir_close(long long handle) {\0A    PlumDir *dir = (PlumDir *)(intptr_t)handle;\0A    if (dir != NULL) {\0A        closedir(dir->stream);\0A        free(dir);\0A    }\0A}\0A\0A// `stat(2)`-based — tells a caller (module resolution, walking a\0A// project tree) whether to recurse into an entry `list_dir` returned.\0A// Returns 1 (is a directory), 0 (exists, isn't a directory), or -1\0A// (`stat` itself failed — most commonly: the path doesn't exist at\0A// all). The three-way return (not a plain `Bool`) is what lets the\0A// Plum-level `is_directory` wrapper distinguish \22doesn't exist\22 from\0A// \22exists but isn't a directory\22 as a real `Err`, not silently\0A// collapse both into `false`.\0Along long path_is_dir(const char *path) {\0A    struct stat st;\0A    if (stat(path, &st) != 0) {\0A        return -1;\0A    }\0A    return S_ISDIR(st.st_mode) ? 1 : 0;\0A}\0A\00" }
