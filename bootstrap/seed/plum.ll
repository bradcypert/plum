rse certificate verify\22));\0A        ssl->state++;\0A        return 0;\0A    }\0A\0A#if defined(MBEDTLS_SSL_KEEP_PEER_CERTIFICATE)\0A    if (ssl->session_negotiate->peer_cert == NULL) {\0A        MBEDTLS_SSL_DEBUG_MSG(2, (\22<= skip parse certificate verify\22));\0A        ssl->state++;\0A        return 0;\0A    }\0A#else /* MBEDTLS_SSL_KEEP_PEER_CERTIFICATE */\0A    if (ssl->session_negotiate->peer_cert_digest == NULL) {\0A        MBEDTLS_SSL_DEBUG_MSG(2, (\22<= skip parse certificate verify\22));\0A        ssl->state++;\0A        return 0;\0A    }\0A#endif /* !MBEDTLS_SSL_KEEP_PEER_CERTIFICATE */\0A\0A    /* Read the message without adding it to the checksum */\0A    ret = mbedtls_ssl_read_record(ssl, 0 /* no checksum update */);\0A    if (0 != ret) {\0A        MBEDTLS_SSL_DEBUG_RET(1, (\22mbedtls_ssl_read_record\22), ret);\0A        return ret;\0A    }\0A\0A    ssl->state++;\0A\0A    /* Process the message contents */\0A    if (ssl->in_msgtype != MBEDTLS_SSL_MSG_HANDSHAKE ||\0A        ssl->in_msg[0] != MBEDTLS_SSL_HS_CERTIFICATE_VERIFY) {\0A        MBEDTLS_SSL_DEBUG_MSG(1, (\22bad certificate verify message\22));\0A        return MBEDTLS_ERR_SSL_UNEXPECTED_MESSAGE;\0A    }\0A\0A    i = mbedtls_ssl_hs_hdr_len(ssl);\0A\0A#if !defined(MBEDTLS_SSL_KEEP_PEER_CERTIFICATE)\0A    peer_pk = &ssl->handshake->peer_pubkey;\0A#else /* !MBEDTLS_SSL_KEEP_PEER_CERTIFICATE */\0A    if (ssl->session_negotiate->peer_cert == NULL) {\0A        /* Should never happen */\0A        return MBEDTLS_ERR_SSL_INTERNAL_ERROR;\0A    }\0A    peer_pk = &ssl->session_negotiate->peer_cert->pk;\0A#endif /* MBEDTLS_SSL_KEEP_PEER_CERTIFICATE */\0A\0A    /*\0A     *  struct {\0A     *     SignatureAndHashAlgorithm algorithm; -- TLS 1.2 only\0A     *     opaque signature<0..2^16-1>;\0A     *  } DigitallySigned;\0A     */\0A    if (i + 2 > ssl->in_hslen) {\0A        MBEDTLS_SSL_DEBUG_MSG(1, (\22bad certificate verify message\22));\0A        return MBEDTLS_ERR_SSL_DECODE_ERROR;\0A    }\0A\0A    /*\0A     * Hash\0A     */\0A    md_alg = mbedtls_ssl_md_alg_from_hash(ssl->in_msg[i]);\0A\0A    if (md_alg == MBEDTLS_MD_NONE || mbedtls_ssl_set_calc_verify_md(ssl, ssl->in_msg[i])) {\0A        MBEDTLS_SSL_DEBUG_MSG(1, (\22peer not adhering to requested sig_alg\22\0A                                  \22 for verify message\22));\0A        return MBEDTLS_ERR_SSL_ILLEGAL_PARAMETER;\0A    }\0A\0A#if !defined(MBEDTLS_MD_SHA1)\0A    if (MBEDTLS_MD_SHA1 == md_alg) {\0A        hash_start += 16;\0A    }\0A#endif\0A\0A    /* Info from md_alg will be used instead */\0A    hashlen = 0;\0A\0A    i++;\0A\0A    /*\0A     * Signature\0A     */\0A    if ((pk_alg = mbedtls_ssl_pk_alg_from_sig(ssl->in_msg[i]))\0A        == MBEDTLS_PK_NONE) {\0A        MBEDTLS_SSL_DEBUG_MSG(1, (\22peer not adhering to requested sig_alg\22\0A                                  \22 for verify message\22));\0A        return MBEDTLS_ERR_SSL_ILLEGAL_PARAMETER;\0A    }\0A\0A    /*\0A     * Check the certificate's key type matches the signature alg\0A     */\0A    if (!mbedtls_pk_can_do(peer_pk, pk_alg)) {\0A        MBEDTLS_SSL_DEBUG_MSG(1, (\22sig_alg doesn't match cert key\22));\0A        return MBEDTLS_ERR_SSL_ILLEGAL_PARAMETER;\0A    }\0A\0A    i++;\0A\0A    if (i + 2 > ssl->in_hslen) {\0A        MBEDTLS_SSL_DEBUG_MSG(1, (\22bad certificate verify message\22));\0A        return MBEDTLS_ERR_SSL_DECODE_ERROR;\0A    }\0A\0A    sig_len = MBEDTLS_GET_UINT16_BE(ssl->in_msg, i);\0A    i += 2;\0A\0A    if (i + sig_len != ssl->in_hslen) {\0A        MBEDTLS_SSL_DEBUG_MSG(1, (\22bad certificate verify message\22));\0A        return MBEDTLS_ERR_SSL_DECODE_ERROR;\0A    }\0A\0A    /* Calculate hash and verify signature */\0A    {\0A        size_t dummy_hlen;\0A        ret = ssl->handshake->calc_verify(ssl, hash, &dummy_hlen);\0A        if (0 != ret) {\0A            MBEDTLS_SSL_DEBUG_RET(1, (\22calc_verify\22), ret);\0A            return ret;\0A        }\0A    }\0A\0A    if ((ret = mbedtls_pk_verify(peer_pk,\0A                 