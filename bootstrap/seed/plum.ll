       data_length,\0A                                           data,\0A                                           data_size));\0A        if (status != PSA_SUCCESS) {\0A            memset(data, 0, data_size);\0A        }\0A\0A        return status;\0A    } else {\0A        status = mbedtls_to_psa_error(\0A            mbedtls_ecp_write_key_ext(ecp, data_length, data, data_size));\0A        return status;\0A    }\0A}\0A\0Apsa_status_t mbedtls_psa_ecp_export_public_key(\0A    const psa_key_attributes_t *attributes,\0A    const uint8_t *key_buffer, size_t key_buffer_size,\0A    uint8_t *data, size_t data_size, size_t *data_length)\0A{\0A    psa_status_t status = PSA_ERROR_CORRUPTION_DETECTED;\0A    mbedtls_ecp_keypair *ecp = NULL;\0A\0A    status = mbedtls_psa_ecp_load_representation(\0A        attributes->type, attributes->bits,\0A        key_buffer, key_buffer_size, &ecp);\0A    if (status != PSA_SUCCESS) {\0A        return status;\0A    }\0A\0A    status = mbedtls_psa_ecp_export_key(\0A        PSA_KEY_TYPE_ECC_PUBLIC_KEY(\0A            PSA_KEY_TYPE_ECC_GET_FAMILY(attributes->type)),\0A        ecp, data, data_size, data_length);\0A\0A    mbedtls_ecp_keypair_free(ecp);\0A    mbedtls_free(ecp);\0A\0A    return status;\0A}\0A#endif /* defined(MBEDTLS_PSA_BUILTIN_KEY_TYPE_ECC_KEY_PAIR_IMPORT) ||\0A        * defined(MBEDTLS_PSA_BUILTIN_KEY_TYPE_ECC_KEY_PAIR_EXPORT) ||\0A        * defined(MBEDTLS_PSA_BUILTIN_KEY_TYPE_ECC_PUBLIC_KEY) */\0A\0A#if defined(MBEDTLS_PSA_BUILTIN_KEY_TYPE_ECC_KEY_PAIR_GENERATE)\0Apsa_status_t mbedtls_psa_ecp_generate_key(\0A    const psa_key_attributes_t *attributes,\0A    uint8_t *key_buffer, size_t key_buffer_size, size_t *key_buffer_length)\0A{\0A    psa_ecc_family_t curve = PSA_KEY_TYPE_ECC_GET_FAMILY(\0A        attributes->type);\0A    mbedtls_ecp_group_id grp_id =\0A        mbedtls_ecc_group_from_psa(curve, attributes->bits);\0A    if (grp_id == MBEDTLS_ECP_DP_NONE) {\0A        return PSA_ERROR_NOT_SUPPORTED;\0A    }\0A\0A    mbedtls_ecp_key