wikipedia.org/wiki/Linear_congruential_generator#Parameters_in_common_use\0A */\0Astatic int self_test_rng(void *ctx, unsigned char *out, size_t len)\0A{\0A    static uint32_t state = 42;\0A\0A    (void) ctx;\0A\0A    for (size_t i = 0; i < len; i++) {\0A        state = state * 1664525u + 1013904223u;\0A        out[i] = (unsigned char) state;\0A    }\0A\0A    return 0;\0A}\0A\0A/* Load my private keys and generate the corresponding public keys */\0Astatic int ecjpake_test_load(mbedtls_ecjpake_context *ctx,\0A                             const unsigned char *xm1, size_t len1,\0A                             const unsigned char *xm2, size_t len2)\0A{\0A    int ret = MBEDTLS_ERR_ERROR_CORRUPTION_DETECTED;\0A\0A    MBEDTLS_MPI_CHK(mbedtls_mpi_read_binary(&ctx->xm1, xm1, len1));\0A    MBEDTLS_MPI_CHK(mbedtls_mpi_read_binary(&ctx->xm2, xm2, len2));\0A    MBEDTLS_MPI_CHK(mbedtls_ecp_mul(&ctx->grp, &ctx->Xm1, &ctx->xm1,\0A                                    &ctx->grp.G, self_test_rng, NULL));\0A    MBEDTLS_MPI_CHK(mbedtls_ecp_mul(&ctx->grp, &ctx->Xm2, &ctx->xm2,\0A                                    &ctx->grp.G, self_test_rng, NULL));\0A\0Acleanup:\0A    return ret;\0A}\0A\0A#endif /* ! MBEDTLS_ECJPAKE_ALT */\0A\0A/* For tests we don't need a secure RNG;\0A * use the LGC from Numerical Recipes for simplicity */\0Astatic int ecjpake_lgc(void *p, unsigned char *out, size_t len)\0A{\0A    static uint32_t x = 42;\0A    (void) p;\0A\0A    while (len > 0) {\0A        size_t use_len = len > 4 ? 4 : len;\0A        x = 1664525 * x + 1013904223;\0A        memcpy(out, &x, use_len);\0A        out += use_len;\0A        len -= use_len;\0A    }\0A\0A    return 0;\0A}\0A\0A#define TEST_ASSERT(x)    \5C\0A    do {                    \5C\0A        if (x)             \5C\0A        ret = 0;        \5C\0A        else                \5C\0A        {                   \5C\0A            ret = 1;        \5C\0A            goto cleanup;   \5C\0A        }                   \5C\0A    } while (0)\0A\0A/*\0A * Checkup routine\0A */\0Aint mbedtls_ecjpake_self_test(int verbose)\0A{\0A    int ret = MBEDTLS_ERR_ERROR_CORRUPTION_DETECTED;\0A    mbedtls_ecjpake_context cli;\0A    mbedtls_ecjpake_context srv;\0A    unsigned char buf[512], pms[32];\0A    size_t len, pmslen;\0A\0A    mbedtls_ecjpake_init(&cli);\0A    mbedtls_ecjpake_init(&srv);\0A\0A    if (verbose != 0) {\0A        mbedtls_printf(\22  ECJPAKE test #0 (setup): \22);\0A    }\0A\0A    TEST_ASSERT(mbedtls_ecjpake_setup(&cli, MBEDTLS_ECJPAKE_CLIENT,\0A                                      MBEDTLS_MD_SHA256, MBEDTLS_ECP_DP_SECP256R1,\0A                                      ecjpake_test_password,\0A                                      sizeof(ecjpake_test_password)) == 0);\0A\0A    TEST_ASSERT(mbedtls_ecjpake_setup(&srv, MBEDTLS_ECJPAKE_SERVER,\0A                                      MBEDTLS_MD_SHA256, MBEDTLS_ECP_DP_SECP256R1,\0A                                      ecjpake_test_password,\0A                                      sizeof(ecjpake_test_password)) == 0);\0A\0A    if (verbose != 0) {\0A        mbedtls_printf(\22passed\5Cn\22);\0A    }\0A\0A    if (verbose != 0) {\0A        mbedtls_printf(\22  ECJPAKE test #1 (random handshake): \22);\0A    }\0A\0A    TEST_ASSERT(mbedtls_ecjpake_write_round_one(&cli,\0A                                                buf, sizeof(buf), &len, ecjpake_lgc, NULL) == 0);\0A\0A    TEST_ASSERT(mbedtls_ecjpake_read_round_one(&srv, buf, len) == 0);\0A\0A    TEST_ASSERT(mbedtls_ecjpake_write_round_one(&srv,\0A                                                buf, sizeof(buf), &len, ecjpake_lgc, NULL) == 0);\0A\0A    TEST_ASSERT(mbedtls_ecjpake_read_round_one(&cli, buf, len) == 0);\0A\0A    TEST_ASSERT(mbedtls_ecjpake_write_round_two(&srv,\0A                                                buf, sizeof(buf), &len, ecjpake_lgc, NULL) == 0);\0A\0A    TEST_ASSERT(mbedtls_ecjpake_read_round_two(&cli, buf, len) == 0);\0A\0A    TEST_ASSERT(mbedtls_ecjpake_derive_secret(&cli,\0A                                              pms, sizeof(pms), &pmslen, ecjpake_lgc, NULL) == 0);\0A\0A    TEST_ASSERT(mbedtls_ecjpake_write_round_two(&cli,\0A                                                buf, sizeof(buf), &len, ecjpake_lgc, NULL) == 0);\0A\0A    TEST_ASSERT(mbedtls_ecjpake_read_round_two(&srv, buf, len) == 0);\0A\0A    TEST_ASSERT(mbedtls_ecjpake_derive_secret(&srv,\0A                                              buf, sizeof(buf), &len, ecjpake_lgc, NULL) == 0);\0A\0A    TEST_ASSERT(len == pmslen);\0A    TEST_ASSERT(memcmp(buf, pms, len) == 0);\0A\0A    if (verbose != 0) {\0A        mbedtls_printf(\22passed\5Cn\22);\0A    }\0A\0A#if !defined(MBEDTLS_ECJPAKE_ALT)\0A    /* 'reference handshake' tests can only be run against implementations\0A     * for which we have 100% control over how the random ephemeral keys\0A     * are generated. This is only the case for the internal Mbed TLS\0A     * implementation, so these tests are skipped in case the internal\0A     * implementation is swapped out for an alternative one. */\0A    if (verbose != 0) {\0A        mbedtls_printf(\22  ECJPAKE test #2 (reference handshake): \22);\0A    }\0A\0A    /* Simulate generation of round one */\0A    MBEDTLS_MPI_CHK(ecjpake_test_load(&cli,\0A                                      ecjpake_test_x1, sizeof(ecjpake_test_x1),\0A                                      ecjpake_test_x2, sizeof(ecjpake_test_x2)));\0A\0A    MBEDTLS_MPI_CHK(ecjpake_test_load(&srv,\0A                                      ecjpake_test_x3, sizeof(ecjpake_test_x3),\0A                                      ecjpake_test_x4, sizeof(ecjpake_test_x4)));\0A\0A    /* Read round one */\0A    TEST_ASSERT(mbedtls_ecjpake_read_round_one(&srv,\0A                                               ecjpake_test_cli_one,\0A                                               sizeof(ecjpake_test_cli_one)) == 0);\0A\0A    TEST_ASSERT(mbedtls_ecjpake_read_round_one(&cli,\0A                                               ecjpake_test_srv_one,\0A                                               sizeof(ecjpake_test_srv_one)) == 0);\0A\0A    /* Skip generation of round two, read round two */\0A    TEST_ASSERT(mbedtls_ecjpake_read_round_two(&cli,\0A                                               ecjpake_test_srv_two,\0A                                               sizeof(ecjpake_test_srv_two)) == 0);\0A\0A    TEST_ASSERT(mbedtls_ecjpake_read_round_two(&srv,\0A                                               ecjpake_test_cli_two,\0A                                               sizeof(ecjpake_test_cli_two)) == 0);\0A\0A    /* Server derives PMS */\0A    TEST_ASSERT(mbedtls_ecjpake_derive_secret(&srv,\0A                                              buf, sizeof(buf), &len, ecjpake_lgc, NULL) == 0);\0A\0A    TEST_ASSERT(len == sizeof(ecjpake_test_pms));\0A    TEST_ASSERT(memcmp(buf, ecjpake_test_pms, len) == 0);\0A\0A    /* Server derives K as unsigned binary data */\0A    TEST_ASSERT(mbedtls_ecjpake_write_shared_key(&srv,\0A                                                 buf, sizeof(buf), &len, ecjpake_lgc, NULL) == 0);\0A\0A    TEST_ASSERT(len == sizeof(ecjpake_test_shared_key));\0A    TEST_ASSERT(memcmp(buf, ecjpake_test_shared_key, len) == 0);\0A\0A    memset(buf, 0, len);   /* Avoid interferences with next step */\0A\0A    /* Client derives PMS */\0A    TEST_ASSERT(mbedtls_ecjpake_derive_secret(&cli,\0A                                              buf, sizeof(buf), &len, ecjpake_lgc, NULL) == 0);\0A\0A    TEST_ASSERT(len == sizeof(ecjpake_test_pms));\0A    TEST_ASSERT(memcmp(buf, ecjpake_test_pms, len) == 0);\0A\0A    /* Client derives K as unsigned binary data */\0A    TEST_ASSERT(mbedtls_ecjpake_write_shared_key(&cli,\0A                                                 buf, sizeof(buf), &len, ecjpake_lgc, NULL) == 0);\0A\0A    TEST_ASSERT(len == sizeof(ecjpake_test_shared_key));\0A    TEST_ASSERT(memcmp(buf, ecjpake_test_shared_key, len) == 0);\0A\0A    if (verbose != 0) {\0A        mbedtls_printf(\22passed\5Cn\22);\0A    }\0A#endif /* ! MBEDTLS_ECJPAKE_ALT */\0A\0Acleanup:\0A    mbedtls_ecjpake_free(&cli);\0A    mbedtls_ecjpake_free(&srv);\0A\0A    if (ret != 0) {\0A        if (verbose != 0) {\0A            mbedtls_printf(\22failed\5Cn\22);\0A        }\0A\0A        ret = 1;\0A    }\0A\0A    if (verbose != 0) {\0A        mbedtls_printf(\22\5Cn\22);\0A    }\0A\0A    return ret;\0A}\0A\0A#undef TEST_ASSERT\0A\0A#endif /* MBEDTLS_ECP_DP_SECP256R1_ENABLED && MBEDTLS_MD_CAN_SHA256 */\0A\0A#endif /* MBEDTLS_SELF_TEST */\0A\0A#endif /* MBEDTLS_ECJPAKE_C */\0A\00" }
