@.str41056 = private global { i64, i64, [6401 x i8] } { i64 -1, i64 6400, [6401 x i8] c"/**\0A * \5Cfile psa/crypto_config.h\0A * \5Cbrief PSA crypto configuration options (set of defines)\0A *\0A */\0A#if defined(MBEDTLS_PSA_CRYPTO_CONFIG)\0A/**\0A * When #MBEDTLS_PSA_CRYPTO_CONFIG is enabled in mbedtls_config.h,\0A * this file determines which cryptographic mechanisms are enabled\0A * through the PSA Cryptography API (\5Cc psa_xxx() functions).\0A *\0A * To enable a cryptographic mechanism, uncomment the definition of\0A * the corresponding \5Cc PSA_WANT_xxx preprocessor symbol.\0A * To disable a cryptographic mechanism, comment out the definition of\0A * the corresponding \5Cc PSA_WANT_xxx preprocessor symbol.\0A * The names of cryptographic mechanisms correspond to values\0A * defined in psa/crypto_values.h, with the prefix \5Cc PSA_WANT_ instead\0A * of \5Cc PSA_.\0A *\0A * Note that many cryptographic mechanisms involve two symbols: one for\0A * the key type (\5Cc PSA_WANT_KEY_TYPE_xxx) and one for the algorithm\0A * (\5Cc PSA_WANT_ALG_xxx). Mechanisms with additional parameters may involve\0A * additional symbols.\0A */\0A#else\0A/**\0A * When \5Cc MBEDTLS_PSA_CRYPTO_CONFIG is disabled in mbedtls_config.h,\0A * this file is not used, and cryptographic mechanisms are supported\0A * through the PSA API if and only if they are supported through the\0A * mbedtls_xxx API.\0A */\0A#endif\0A/*\0A *  Copyright The Mbed TLS Contributors\0A *  SPDX-License-Identifier: Apache-2.0 OR GPL-2.0-or-later\0A */\0A\0A#ifndef PSA_CRYPTO_CONFIG_H\0A#define PSA_CRYPTO_CONFIG_H\0A\0A#define PSA_WANT_ALG_CBC_NO_PADDING             1\0A#define PSA_WANT_ALG_CBC_PKCS7                  1\0A#define PSA_WANT_ALG_CCM                        1\0A#define PSA_WANT_ALG_CCM_STAR_NO_TAG            1\0A#define PSA_WANT_ALG_CMAC                       1\0A#define PSA_WANT_ALG_CFB                        1\0A#define PSA_WANT_ALG_CHACHA20_POLY1305          1\0A#define PSA_WANT_ALG_CTR                        1\0A#define PSA_WANT_ALG_DETERMINISTIC_ECDSA        1\0A#define PSA_WANT_ALG_ECB_NO_PADDING             1\0A#define PSA_WANT_ALG_ECDH                       1\0A#define PSA_WANT_ALG_FFDH                       1\0A#define PSA_WANT_ALG_ECDSA                      1\0A#define PSA_WANT_ALG_JPAKE                      1\0A#define PSA_WANT_ALG_GCM                        1\0A#define PSA_WANT_ALG_HKDF                       1\0A#define PSA_WANT_ALG_HKDF_EXTRACT               1\0A#define PSA_WANT_ALG_HKDF_EXPAND                1\0A#define PSA_WANT_ALG_HMAC                       1\0A#define PSA_WANT_ALG_MD5                        1\0A#define PSA_WANT_ALG_OFB                        1\0A#define PSA_WANT_ALG_PBKDF2_HMAC                1\0A#define PSA_WANT_ALG_PBKDF2_AES_CMAC_PRF_128    1\0A#define PSA_WANT_ALG_RIPEMD160                  1\0A#define PSA_WANT_ALG_RSA_OAEP                   1\0A#define PSA_WANT_ALG_RSA_PKCS1V15_CRYPT         1\0A#define PSA_WANT_ALG_RSA_PKCS1V15_SIGN          1\0A#define PSA_WANT_ALG_RSA_PSS                    1\0A#define PSA_WANT_ALG_SHA_1                      1\0A#define PSA_WANT_ALG_SHA_224                    1\0A#define PSA_WANT_ALG_SHA_256                    1\0A#define PSA_WANT_ALG_SHA_384                    1\0A#define PSA_WANT_ALG_SHA_512                    1\0A#define PSA_WANT_ALG_SHA3_224                   1\0A#define PSA_WANT_ALG_SHA3_256                   1\0A#define PSA_WANT_ALG_SHA3_384                   1\0A#define PSA_WANT_ALG_SHA3_512                   1\0A#define PSA_WANT_ALG_STREAM_CIPHER              1\0A#define PSA_WANT_ALG_TLS12_PRF                  1\0A#define PSA_WANT_ALG_TLS12_PSK_TO_MS            1\0A#define PSA_WANT_ALG_TLS12_ECJPAKE_TO_PMS       1\0A\0A#define PSA_WANT_ECC_BRAINPOOL_P_R1_256         1\0A#define PSA_WANT_ECC_BRAINPOOL_P_R1_384         1\0A#define PSA_WANT_ECC_BRAINPOOL_P_R1_512         1\0A#define PSA_WANT_ECC_MONTGOMERY_255             1\0A#define PSA_WANT_ECC_MONTGOMERY_448             1\0A#define PSA_WANT_ECC_SECP_K1_192                1\0A#define PSA_WANT_ECC_SECP_K1_256                1\0A#define PSA_WANT_ECC_SECP_R1_192                1\0A#define PSA_WANT_ECC_SECP_R1_224                1\0A/* For secp256r1, consider enabling #MBEDTLS_PSA_P256M_DRIVER_ENABLED\0A * (see the description in mbedtls/mbedtls_config.h for details). */\0A#define PSA_WANT_ECC_SECP_R1_256                1\0A#define PSA_WANT_ECC_SECP_R1_384                1\0A#define PSA_WANT_ECC_SECP_R1_521                1\0A\0A#define PSA_WANT_DH_RFC7919_2048                1\0A#define PSA_WANT_DH_RFC7919_3072                1\0A#define PSA_WANT_DH_RFC7919_4096                1\0A#define PSA_WANT_DH_RFC7919_6144                1\0A#define PSA_WANT_DH_RFC7919_8192                1\0A\0A#define PSA_WANT_KEY_TYPE_DERIVE                1\0A#define PSA_WANT_KEY_TYPE_PASSWORD              1\0A#define PSA_WANT_KEY_TYPE_PASSWORD_HASH         1\0A#define PSA_WANT_KEY_TYPE_HMAC                  1\0A#define PSA_WANT_KEY_TYPE_AES                   1\0A#define PSA_WANT_KEY_TYPE_ARIA                  1\0A#define PSA_WANT_KEY_TYPE_CAMELLIA              1\0A#define PSA_WANT_KEY_TYPE_CHACHA20              1\0A#define PSA_WANT_KEY_TYPE_DES                   1\0A//#define PSA_WANT_KEY_TYPE_ECC_KEY_PAIR          1 /* Deprecated */\0A#define PSA_WANT_KEY_TYPE_ECC_PUBLIC_KEY        1\0A#define PSA_WANT_KEY_TYPE_DH_PUBLIC_KEY         1\0A#define PSA_WANT_KEY_TYPE_RAW_DATA              1\0A//#define PSA_WANT_KEY_TYPE_RSA_KEY_PAIR          1 /* Deprecated */\0A#define PSA_WANT_KEY_TYPE_RSA_PUBLIC_KEY        1\0A\0A/*\0A * The following symbols extend and deprecate the legacy\0A * PSA_WANT_KEY_TYPE_xxx_KEY_PAIR ones. They include the usage of that key in\0A * the name's suffix. \22_USE\22 is the most generic and it can be used to describe\0A * a generic suport, whereas other ones add more features on top of that and\0A * they are more specific.\0A */\0A#define PSA_WANT_KEY_TYPE_ECC_KEY_PAIR_BASIC      1\0A#define PSA_WANT_KEY_TYPE_ECC_KEY_PAIR_IMPORT   1\0A#define PSA_WANT_KEY_TYPE_ECC_KEY_PAIR_EXPORT   1\0A#define PSA_WANT_KEY_TYPE_ECC_KEY_PAIR_GENERATE 1\0A#define PSA_WANT_KEY_TYPE_ECC_KEY_PAIR_DERIVE   1\0A\0A#define PSA_WANT_KEY_TYPE_RSA_KEY_PAIR_BASIC      1\0A#define PSA_WANT_KEY_TYPE_RSA_KEY_PAIR_IMPORT   1\0A#define PSA_WANT_KEY_TYPE_RSA_KEY_PAIR_EXPORT   1\0A#define PSA_WANT_KEY_TYPE_RSA_KEY_PAIR_GENERATE 1\0A//#define PSA_WANT_KEY_TYPE_RSA_KEY_PAIR_DERIVE   1 /* Not supported */\0A\0A#define PSA_WANT_KEY_TYPE_DH_KEY_PAIR_BASIC       1\0A#define PSA_WANT_KEY_TYPE_DH_KEY_PAIR_IMPORT    1\0A#define PSA_WANT_KEY_TYPE_DH_KEY_PAIR_EXPORT    1\0A#define PSA_WANT_KEY_TYPE_DH_KEY_PAIR_GENERATE  1\0A//#define PSA_WANT_KEY_TYPE_DH_KEY_PAIR_DERIVE    1 /* Not supported */\0A\0A#endif /* PSA_CRYPTO_CONFIG_H */\0A\00" }
