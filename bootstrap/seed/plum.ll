sys/time.h>\0A#include <unistd.h>\0A#include <signal.h>\0A#include <fcntl.h>\0A#include <netdb.h>\0A#include <errno.h>\0A\0A#define IS_EINTR(ret) ((ret) == EINTR)\0A#define SOCKET int\0A\0A#endif /* ( _WIN32 || _WIN32_WCE ) && !EFIX64 && !EFI32 */\0A\0A/* Some MS functions want int and MSVC warns if we pass size_t,\0A * but the standard functions use socklen_t, so cast only for MSVC */\0A#if defined(_MSC_VER)\0A#define MSVC_INT_CAST   (int)\0A#else\0A#define MSVC_INT_CAST\0A#endif\0A\0A#include <stdio.h>\0A\0A#if defined(MBEDTLS_HAVE_TIME)\0A#include <time.h>\0A#endif\0A\0A#include <stdint.h>\0A\0A/*\0A * Prepare for using the sockets interface\0A */\0Astatic int net_prepare(void)\0A{\0A#if (defined(_WIN32) || defined(_WIN32_WCE)) && !defined(EFIX64) && \5C\0A    !defined(EFI32)\0A    WSADATA wsaData;\0A\0A    if (wsa_init_done == 0) {\0A        if (WSAStartup(MAKEWORD(2, 0), &wsaData) != 0) {\0A            return MBEDTLS_ERR_NET_SOCKET_FAILED;\0A        }\0A\0A        wsa_init_done = 1;\0A    }\0A#else\0A#if !defined(EFIX64) && !defined(EFI32)\0A    signal(SIGPIPE, SIG_IGN);\0A#endif\0A#endif\0A    return 0;\0A}\0A\0A/*\0A * Return 0 if the file descriptor is valid, an error otherwise.\0A * If for_select != 0, check whether the file descriptor is within the range\0A * allowed for fd_set used for the FD_xxx macros and the select() function.\0A */\0Astatic int check_fd(int fd, int for_select)\0A{\0A    if (fd < 0) {\0A        return MBEDTLS_ERR_NET_INVALID_CONTEXT;\0A    }\0A\0A#if (defined(_WIN32) || defined(_WIN32_WCE)) && !defined(EFIX64) && \5C\0A    !defined(EFI32)\0A    (void) for_select;\0A#else\0A    /* A limitation of select() is that it only works with file descriptors\0A     * that are strictly less than FD_SETSIZE. This is a limitation of the\0A     * fd_set type. Error out early, because attempting to call FD_SET on a\0A     * large file descriptor is a buffer overflow on typical platforms. */\0A    if (for_select && fd >= FD_SETSIZE) {\0A        return 