@.str41302 = private global { i64, i64, [3962 x i8] } { i64 -1, i64 3961, [3962 x i8] c"/*\0A *  HKDF implementation -- RFC 5869\0A *\0A *  Copyright The Mbed TLS Contributors\0A *  SPDX-License-Identifier: Apache-2.0 OR GPL-2.0-or-later\0A */\0A#include \22common.h\22\0A\0A#if defined(MBEDTLS_HKDF_C)\0A\0A#include <string.h>\0A#include \22mbedtls/hkdf.h\22\0A#include \22mbedtls/platform_util.h\22\0A#include \22mbedtls/error.h\22\0A\0Aint mbedtls_hkdf(const mbedtls_md_info_t *md, const unsigned char *salt,\0A                 size_t salt_len, const unsigned char *ikm, size_t ikm_len,\0A                 const unsigned char *info, size_t info_len,\0A                 unsigned char *okm, size_t okm_len)\0A{\0A    int ret = MBEDTLS_ERR_ERROR_CORRUPTION_DETECTED;\0A    unsigned char prk[MBEDTLS_MD_MAX_SIZE];\0A\0A    ret = mbedtls_hkdf_extract(md, salt, salt_len, ikm, ikm_len, prk);\0A\0A    if (ret == 0) {\0A        ret = mbedtls_hkdf_expand(md, prk, mbedtls_md_get_size(md),\0A                                  info, info_len, okm, okm_len);\0A    }\0A\0A    mbedtls_platform_zeroize(prk, sizeof(prk));\0A\0A    return ret;\0A}\0A\0Aint mbedtls_hkdf_extract(const mbedtls_md_info_t *md,\0A                         const unsigned char *salt, size_t salt_len,\0A                         const unsigned char *ikm, size_t ikm_len,\0A                         unsigned char *prk)\0A{\0A    unsigned char null_salt[MBEDTLS_MD_MAX_SIZE] = { '\5C0' };\0A\0A    if (salt == NULL) {\0A        size_t hash_len;\0A\0A        if (salt_len != 0) {\0A            return MBEDTLS_ERR_HKDF_BAD_INPUT_DATA;\0A        }\0A\0A        hash_len = mbedtls_md_get_size(md);\0A\0A        if (hash_len == 0) {\0A            return MBEDTLS_ERR_HKDF_BAD_INPUT_DATA;\0A        }\0A\0A        salt = null_salt;\0A        salt_len = hash_len;\0A    }\0A\0A    return mbedtls_md_hmac(md, salt, salt_len, ikm, ikm_len, prk);\0A}\0A\0Aint mbedtls_hkdf_expand(const mbedtls_md_info_t *md, const unsigned char *prk,\0A           