@.str40185 = private global { i64, i64, [14573 x i8] } { i64 -1, i64 14572, [14573 x i8] c"/*\0A *  Debugging routines\0A *\0A *  Copyright The Mbed TLS Contributors\0A *  SPDX-License-Identifier: Apache-2.0 OR GPL-2.0-or-later\0A */\0A\0A#include \22common.h\22\0A\0A#if defined(MBEDTLS_DEBUG_C)\0A\0A#include \22mbedtls/platform.h\22\0A\0A#include \22debug_internal.h\22\0A#include \22mbedtls/error.h\22\0A\0A#include <stdarg.h>\0A#include <stdio.h>\0A#include <string.h>\0A\0A/* DEBUG_BUF_SIZE must be at least 2 */\0A#define DEBUG_BUF_SIZE      512\0A\0Astatic int debug_threshold = 0;\0A\0Avoid mbedtls_debug_set_threshold(int threshold)\0A{\0A    debug_threshold = threshold;\0A}\0A\0A/*\0A * All calls to f_dbg must be made via this function\0A */\0Astatic inline void debug_send_line(const mbedtls_ssl_context *ssl, int level,\0A                                   const char *file, int line,\0A                                   const char *str)\0A{\0A    /*\0A     * If in a threaded environment, we need a thread identifier.\0A     * Since there is no portable way to get one, use the address of the ssl\0A     * context instead, as it shouldn't be shared between threads.\0A     */\0A#if defined(MBEDTLS_THREADING_C)\0A    char idstr[20 + DEBUG_BUF_SIZE]; /* 0x + 16 nibbles + ': ' */\0A    mbedtls_snprintf(idstr, sizeof(idstr), \22%p: %s\22, (void *) ssl, str);\0A    ssl->conf->f_dbg(ssl->conf->p_dbg, level, file, line, idstr);\0A#else\0A    ssl->conf->f_dbg(ssl->conf->p_dbg, level, file, line, str);\0A#endif\0A}\0A\0AMBEDTLS_PRINTF_ATTRIBUTE(5, 6)\0Avoid mbedtls_debug_print_msg(const mbedtls_ssl_context *ssl, int level,\0A                             const char *file, int line,\0A                             const char *format, ...)\0A{\0A    va_list argp;\0A    char str[DEBUG_BUF_SIZE];\0A    int ret = MBEDTLS_ERR_ERROR_CORRUPTION_DETECTED;\0A\0A    MBEDTLS_STATIC_ASSERT(DEBUG_BUF_SIZE >= 2, \22DEBUG_BUF_SIZE too small\22);\0A\0A    if (NULL == ssl              ||\0A        NULL == ssl->conf        ||\0A        NULL == ssl->conf->f_dbg ||\0A        level > debug_threshold) {\0A        return;\0A    }\0A\0A    va_start(argp, format);\0A    ret = mbedtls_vsnprintf(str, DEBUG_BUF_SIZE, format, argp);\0A    va_end(argp);\0A\0A    if (ret < 0) {\0A        ret = 0;\0A    } else {\0A        if (ret >= DEBUG_BUF_SIZE - 1) {\0A            ret = DEBUG_BUF_SIZE - 2;\0A        }\0A    }\0A    str[ret]     = '\5Cn';\0A    str[ret + 1] = '\5C0';\0A\0A    debug_send_line(ssl, level, file, line, str);\0A}\0A\0Avoid mbedtls_debug_print_ret(const mbedtls_ssl_context *ssl, int level,\0A                             const char *file, int line,\0A                             const char *text, int ret)\0A{\0A    char str[DEBUG_BUF_SIZE];\0A\0A    if (NULL == ssl              ||\0A        NULL == ssl->conf        ||\0A        NULL == ssl->conf->f_dbg ||\0A        level > debug_threshold) {\0A        return;\0A    }\0A\0A    /*\0A     * With non-blocking I/O and examples that just retry immediately,\0A     * the logs would be quickly flooded with WANT_READ, so ignore that.\0A     * Don't ignore WANT_WRITE however, since it is usually rare.\0A     */\0A    if (ret == MBEDTLS_ERR_SSL_WANT_READ) {\0A        return;\0A    }\0A\0A    mbedtls_snprintf(str, sizeof(str), \22%s() returned %d (-0x%04x)\5Cn\22,\0A                     text, ret, (unsigned int) -ret);\0A\0A    debug_send_line(ssl, level, file, line, str);\0A}\0A\0Avoid mbedtls_debug_print_buf(const mbedtls_ssl_context *ssl, int level,\0A                             const char *file, int line, const char *text,\0A                             const unsigned char *buf, size_t len)\0A{\0A    char str[DEBUG_BUF_SIZE];\0A    char txt[17];\0A    size_t i, idx = 0;\0A\0A    if (NULL == ssl              ||\0A        NULL == ssl->conf        ||\0A        NULL == ssl->conf->f_dbg ||\0A        level > debug_threshold) {\0A        return;\0A    }\0A\0A    mbedtls_snprintf(str + idx, sizeof(str) - idx, \22dumping '%s'