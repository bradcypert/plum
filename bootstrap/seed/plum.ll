@.str41512 = private global { i64, i64, [26134 x i8] } { i64 -1, i64 26133, [26134 x i8] c"/*\0A *  The LMS stateful-hash public-key signature scheme\0A *\0A *  Copyright The Mbed TLS Contributors\0A *  SPDX-License-Identifier: Apache-2.0 OR GPL-2.0-or-later\0A */\0A\0A/*\0A *  The following sources were referenced in the design of this implementation\0A *  of the LMS algorithm:\0A *\0A *  [1] IETF RFC8554\0A *      D. McGrew, M. Curcio, S.Fluhrer\0A *      https://datatracker.ietf.org/doc/html/rfc8554\0A *\0A *  [2] NIST Special Publication 800-208\0A *      David A. Cooper et. al.\0A *      https://nvlpubs.nist.gov/nistpubs/SpecialPublications/NIST.SP.800-208.pdf\0A */\0A\0A#include \22common.h\22\0A\0A#if defined(MBEDTLS_LMS_C)\0A\0A#include <string.h>\0A\0A#include \22lmots.h\22\0A\0A#include \22psa/crypto.h\22\0A#include \22psa_util_internal.h\22\0A#include \22mbedtls/lms.h\22\0A#include \22mbedtls/error.h\22\0A#include \22mbedtls/platform_util.h\22\0A\0A#include \22mbedtls/platform.h\22\0A\0A/* Define a local translating function to save code size by not using too many\0A * arguments in each translating place. */\0Astatic int local_err_translation(psa_status_t status)\0A{\0A    return psa_status_to_mbedtls(status, psa_to_lms_errors,\0A                                 ARRAY_LENGTH(psa_to_lms_errors),\0A                                 psa_generic_status_to_mbedtls);\0A}\0A#define PSA_TO_MBEDTLS_ERR(status) local_err_translation(status)\0A\0A#define SIG_Q_LEAF_ID_OFFSET     (0)\0A#define SIG_OTS_SIG_OFFSET       (SIG_Q_LEAF_ID_OFFSET + \5C\0A                                  MBEDTLS_LMOTS_Q_LEAF_ID_LEN)\0A#define SIG_TYPE_OFFSET(otstype) (SIG_OTS_SIG_OFFSET   + \5C\0A                                  MBEDTLS_LMOTS_SIG_LEN(otstype))\0A#define SIG_PATH_OFFSET(otstype) (SIG_TYPE_OFFSET(otstype) + \5C\0A                                  MBEDTLS_LMS_TYPE_LEN)\0A\0A#define PUBLIC_KEY_TYPE_OFFSET      (0)\0A#define PUBLIC_KEY_OTSTYPE_OFFSET   (PUBLIC_KEY_TYPE_OFFSET + \5C\0A                                     MBEDTLS_LMS_TYPE_LEN)\0A#define PUBLIC_KEY_I_KEY_ID_OFFSET  (PUBLIC_KEY_OTSTYPE_OFFSET  + \5C\0A                                     MBEDTLS_LMOTS_TYPE_LEN)\0A#define PUBLIC_KEY_ROOT_NODE_OFFSET (PUBLIC_KEY_I_KEY_ID_OFFSET + \5C\0A                                     MBEDTLS_LMOTS_I_KEY_ID_LEN)\0A\0A\0A/* Currently only support H=10 */\0A#define H_TREE_HEIGHT_MAX                  10\0A#define MERKLE_TREE_NODE_AM(type)          ((size_t) 1 << (MBEDTLS_LMS_H_TREE_HEIGHT(type) + 1u))\0A#define MERKLE_TREE_LEAF_NODE_AM(type)     ((size_t) 1 << MBEDTLS_LMS_H_TREE_HEIGHT(type))\0A#define MERKLE_TREE_INTERNAL_NODE_AM(type) ((unsigned int) \5C\0A                                            (1u << MBEDTLS_LMS_H_TREE_HEIGHT(type)))\0A\0A#define D_CONST_LEN           (2)\0Astatic const unsigned char D_LEAF_CONSTANT_BYTES[D_CONST_LEN] = { 0x82, 0x82 };\0Astatic const unsigned char D_INTR_CONSTANT_BYTES[D_CONST_LEN] = { 0x83, 0x83 };\0A\0A\0A/* Calculate the value of a leaf node of the Merkle tree (which is a hash of a\0A * public key and some other parameters like the leaf index). This function\0A * implements RFC8554 section 5.3, in the case where r >= 2^h.\0A *\0A *  params              The LMS parameter set, the underlying LMOTS\0A *                      parameter set, and I value which describe the key\0A *                      being used.\0A *\0A *  pub_key             The public key of the private whose index\0A *                      corresponds to the index of this leaf node. This\0A *                      is a hash output.\0A *\0A *  r_node_idx          The index of this node in the Merkle tree. Note\0A *                      that the root node of the Merkle tree is\0A *                      1-indexed.\0A *\0A *  out                 The output node value, which is a hash output.\0A */\0Astatic int create_merkle_leaf_value(const mbedtls_lms_parameters_t *params,\0A                                    unsigned char *pub_key,\0A                                    unsigned int r_node_idx,\0A                                    unsigned char *out)\0A{\0A    psa_hash_operation_t op;\0A    psa_status_t status = PSA_ERROR_CORRUPTION_DETECTED;\0A    size_t output_hash_len;\0A    unsigned char r_node_idx_bytes[4];\0A\0A    op = psa_hash_operation_init();\0A    status = psa_hash_setup(&op, PSA_ALG_SHA_256);\0A    if (status != PSA_SUCCESS) {\0A        goto exit;\0A    }\0A\0A    status = psa_hash_update(&op, params->I_key_identifier,\0A                             MBEDTLS_LMOTS_I_KEY_ID_LEN);\0A    if (status != PSA_SUCCESS) {\0A        goto exit;\0A    }\0A\0A    MBEDTLS_PUT_UINT32_BE(r_node_idx, r_node_idx_bytes, 0);\0A    status = psa_hash_update(&op, r_node_idx_bytes, 4);\0A    if (status != PSA_SUCCESS) {\0A        goto exit;\0A    }\0A\0A    status = psa_hash_update(&op, D_LEAF_CONSTANT_BYTES, D_CONST_LEN);\0A    if (status != PSA_SUCCESS) {\0A        goto exit;\0A    }\0A\0A    status = psa_hash_update(&op, pub_key,\0A                             MBEDTLS_LMOTS_N_HASH_LEN(params->otstype));\0A    if (status != PSA_SUCCESS) {\0A        goto exit;\0A    }\0A\0A    status = psa_hash_finish(&op, out, MBEDTLS_LMS_M_NODE_BYTES(params->type),\0A                             &output_hash_len);\0A    if (status != PSA_SUCCESS) {\0A        goto exit;\0A    }\0A\0Aexit:\0A    psa_hash_abort(&op);\0A\0A    return PSA_TO_MBEDTLS_ERR(status);\0A}\0A\0A/* Calculate the value of an internal node of the Merkle tree (which is a hash\0A * of a public key and some other parameters like the node index). This function\0A * implements RFC8554 section 5.3, in the case where r < 2^h.\0A *\0A *  params              The LMS parameter set, the underlying LMOTS\0A *                      parameter set, and I value which describe the key\0A *                      being used.\0A *\0A *  left_node           The value of the child of this node which is on\0A *                      the left-hand side. As with all nodes on the\0A *                      Merkle tree, this is a hash output.\0A *\0A *  right_node          The value of the child of this node which is on\0A *                      the right-hand side. As with all nodes on the\0A *                      Merkle tree, this is a hash output.\0A *\0A *  r_node_idx          The index of this node in the Merkle tree. Note\0A *                      that the root node of the Merkle tree is\0A *                      1-indexed.\0A *\0A *  out                 The output node value, which is a hash output.\0A */\0Astatic int create_merkle_internal_value(const mbedtls_lms_parameters_t *params,\0A                                        const unsigned char *left_node,\0A                                        const unsigned char *right_node,\0A                                        unsigned int r_node_idx,\0A                                        unsigned char *out)\0A{\0A    psa_hash_operation_t op;\0A    psa_status_t status = PSA_ERROR_CORRUPTION_DETECTED;\0A    size_t output_hash_len;\0A    unsigned char r_node_idx_bytes[4];\0A\0A    op = psa_hash_operation_init();\0A    status = psa_hash_setup(&op, PSA_ALG_SHA_256);\0A    if (status != PSA_SUCCESS) {\0A        goto exit;\0A    }\0A\0A    status = psa_hash_update(&op, params->I_key_identifier,\0A                             MBEDTLS_LMOTS_I_KEY_ID_LEN);\0A    if (status != PSA_SUCCESS) {\0A        goto exit;\0A    }\0A\0A    MBEDTLS_PUT_UINT32_BE(r_node_idx, r_node_idx_bytes, 0);\0A    status = psa_hash_update(&op, r_node_idx_bytes, 4);\0A    if (status != PSA_SUCCESS) {\0A        goto exit;\0A    }\0A\0A    status = psa_hash_update(&op, D_INTR_CONSTANT_BYTES, D_CONST_LEN);\0A    if (status != PSA_SUCCESS) {\0A        goto exit;\0A    }\0A\0A    status = psa_hash_update(&op, left_node,\0A                             MBEDTLS_LMS_M_NODE_BYTES(params->type));\0A    if (status != PSA_SUCCESS) {\0A        goto exit;\0A    }\0A\0A    status = psa_hash_update(&op, right_node,\0A                             MBEDTLS_LMS_M_NODE_BYTES(params->type));\0A    if (status != PSA_SUCCESS) {\0A        goto exit;\0A    }\0A\0A    status = psa_hash_finish(&op, out, MBEDTLS_LMS_M_NODE_BYTES(params->type),\0A                             &output_hash_len);\0A    if (status != PSA_SUCCESS) {\0A        goto exit;\0A    }\0A\0Aexit:\0A    psa_hash_abort(&op);\0A\0A    return PSA_TO_MBEDTLS_ERR(status);\0A}\0A\0Avoid mbedtls_lms_public_init(mbedtls_lms_public_t *ctx)\0A{\0A    memset(ctx, 0, sizeof(*ctx));\0A}\0A\0Avoid mbedtls_lms_public_free(mbedtls_lms_public_t *ctx)\0A{\0A    if (ctx == NULL) {\0A        return;\0A    }\0A\0A    mbedtls_platform_zeroize(ctx, sizeof(*ctx));\0A}\0A\0Aint mbedtls_lms_import_public_key(mbedtls_lms_public_t *ctx,\0A                                  const unsigned char *key, size_t key_size)\0A{\0A    mbedtls_lms_algorithm_type_t type;\0A    mbedtls_lmots_algorithm_type_t otstype;\0A\0A    type = (mbedtls_lms_algorithm_type_t) MBEDTLS_GET_UINT32_BE(key, PUBLIC_KEY_TYPE_OFFSET);\0A    if (type != MBEDTLS_LMS_SHA256_M32_H10) {\0A        return MBEDTLS_ERR_LMS_BAD_INPUT_DATA;\0A    }\0A    ctx->params.type = type;\0A\0A    if (key_size != MBEDTLS_LMS_PUBLIC_KEY_LEN(ctx->params.type)) {\0A        return MBEDTLS_ERR_LMS_BAD_INPUT_DATA;\0A    }\0A\0A    otstype = (mbedtls_lmots_algorithm_type_t)\0A              MBEDTLS_GET_UINT32_BE(key, PUBLIC_KEY_OTSTYPE_OFFSET);\0A    if (otstype != MBEDTLS_LMOTS_SHA256_N32_W8) {\0A        return MBEDTLS_ERR_LMS_BAD_INPUT_DATA;\0A    }\0A    ctx->params.otstype = otstype;\0A\0A    memcpy(ctx->params.I_key_identifier,\0A           key + PUBLIC_KEY_I_KEY_ID_OFFSET,\0A           MBEDTLS_LMOTS_I_KEY_ID_LEN);\0A    memcpy(ctx->T_1_pub_key, key + PUBLIC_KEY_ROOT_NODE_OFFSET,\0A           MBEDTLS_LMS_M_NODE_BYTES(ctx->params.type));\0A\0A    ctx->have_public_key = 1;\0A\0A    return 0;\0A}\0A\0Aint mbedtls_lms_export_public_key(const mbedtls_lms_public_t *ctx,\0A                                  unsigned char *key,\0A                                  size_t key_size, size_t *key_len)\0A{\0A    if (key_size < MBEDTLS_LMS_PUBLIC_KEY_LEN(ctx->params.type)) {\0A        return MBEDTLS_ERR_LMS_BUFFER_TOO_SMALL;\0A    }\0A\0A    if (!ctx->have_public_key) {\0A        return MBEDTLS_ERR_LMS_BAD_INPUT_DATA;\0A    }\0A\0A    MBEDTLS_PUT_UINT32_BE(ctx->params.type, key, PUBLIC_KEY_TYPE_OFFSET);\0A    MBEDTLS_PUT_UINT32_BE(ctx->params.otstype, key, PUBLIC_KEY_OTSTYPE_OFFSET);\0A    memcpy(key + PUBLIC_KEY_I_KEY_ID_OFFSET,\0A           ctx->params.I_key_identifier,\0A           MBEDTLS_LMOTS_I_KEY_ID_LEN);\0A    memcpy(key +PUBLIC_KEY_ROOT_NODE_OFFSET,\0A           ctx->T_1_pub_key,\0A           MBEDTLS_LMS_M_NODE_BYTES(ctx->params.type));\0A\0A    if (key_len != NULL) {\0A        *key_len = MBEDTLS_LMS_PUBLIC_KEY_LEN(ctx->params.type);\0A    }\0A\0A    return 0;\0A}\0A\0Aint mbedtls_lms_verify(const mbedtls_lms_public_t *ctx,\0A                       const unsigned char *msg, size_t msg_size,\0A                       const unsigned char *sig, size_t sig_size)\0A{\0A    unsigned int q_leaf_identifier;\0A    unsigned char Kc_candidate_ots_pub_key[MBEDTLS_LMOTS_N_HASH_LEN_MAX];\0A    unsigned char Tc_candidate_root_node[MBEDTLS_LMS_M_NODE_BYTES_MAX];\0A    unsigned int height;\0A    unsigned int curr_node_id;\0A    unsigned int parent_node_id;\0A    const unsigned char *left_node;\0A    const unsigned char *right_node;\0A    mbedtls_lmots_parameters_t ots_params;\0A    int ret = MBEDTLS_ERR_ERROR_CORRUPTION_DETECTED;\0A\0A    if (!ctx->have_public_key) {\0A        return MBEDTLS_ERR_LMS_BAD_INPUT_DATA;\0A    }\0A\0A    if (ctx->params.type\0A        != MBEDTLS_LMS_SHA256_M32_H10) {\0A        return MBEDTLS_ERR_LMS_BAD_INPUT_DATA;\0A    }\0A\0A    if (ctx->params.otstype\0A        != MBEDTLS_LMOTS_SHA256_N32_W8) {\0A        return MBEDTLS_ERR_LMS_BAD_INPUT_DATA;\0A    }\0A\0A    if (sig_size != MBEDTLS_LMS_SIG_LEN(ctx->params.type, ctx->params.otstype)) {\0A        return MBEDTLS_ERR_LMS_VERIFY_FAILED;\0A    }\0A\0A    if (sig_size < SIG_OTS_SIG_OFFSET + MBEDTLS_LMOTS_TYPE_LEN) {\0A        return MBEDTLS_ERR_LMS_VERIFY_FAILED;\0A    }\0A\0A    if (MBEDTLS_GET_UINT32_BE(sig, SIG_OTS_SIG_OFFSET + MBEDTLS_LMOTS_SIG_TYPE_OFFSET)\0A        != MBEDTLS_LMOTS_SHA256_N32_W8) {\0A        return MBEDTLS_ERR_LMS_VERIFY_FAILED;\0A    }\0A\0A    if (sig_size < SIG_TYPE_OFFSET(ctx->params.otstype) + MBEDTLS_LMS_TYPE_LEN) {\0A        return MBEDTLS_ERR_LMS_VERIFY_FAILED;\0A    }\0A\0A    if (MBEDTLS_GET_UINT32_BE(sig, SIG_TYPE_OFFSET(ctx->params.otstype))\0A        != MBEDTLS_LMS_SHA256_M32_H10) {\0A        return MBEDTLS_ERR_LMS_VERIFY_FAILED;\0A    }\0A\0A\0A    q_leaf_identifier = MBEDTLS_GET_UINT32_BE(sig, SIG_Q_LEAF_ID_OFFSET);\0A\0A    if (q_leaf_identifier >= MERKLE_TREE_LEAF_NODE_AM(ctx->params.type)) {\0A        return MBEDTLS_ERR_LMS_VERIFY_FAILED;\0A    }\0A\0A    memcpy(ots_params.I_key_identifier,\0A           ctx->params.I_key_identifier,\0A           MBEDTLS_LMOTS_I_KEY_ID_LEN);\0A    MBEDTLS_PUT_UINT32_BE(q_leaf_identifier, ots_params.q_leaf_identifier, 0);\0A    ots_params.type = ctx->params.otstype;\0A\0A    ret = mbedtls_lmots_calculate_public_key_candidate(&ots_params,\0A                                                       msg,\0A                                                       msg_size,\0A                                                       sig + SIG_OTS_SIG_OFFSET,\0A                                                       MBEDTLS_LMOTS_SIG_LEN(ctx->params.otstype),\0A                                                       Kc_candidate_ots_pub_key,\0A                                                       sizeof(Kc_candidate_ots_pub_key),\0A                                                       NULL);\0A    if (ret != 0) {\0A        return MBEDTLS_ERR_LMS_VERIFY_FAILED;\0A    }\0A\0A    create_merkle_leaf_value(\0A        &ctx->params,\0A        Kc_candidate_ots_pub_key,\0A        MERKLE_TREE_INTERNAL_NODE_AM(ctx->params.type) + q_leaf_identifier,\0A        Tc_candidate_root_node);\0A\0A    curr_node_id = MERKLE_TREE_INTERNAL_NODE_AM(ctx->params.type) +\0A                   q_leaf_identifier;\0A\0A    for (height = 0; height < MBEDTLS_LMS_H_TREE_HEIGHT(ctx->params.type);\0A         height++) {\0A        parent_node_id = curr_node_id / 2;\0A\0A        /* Left/right node ordering matters for the hash */\0A        if (curr_node_id & 1) {\0A            left_node = sig + SIG_PATH_OFFSET(ctx->params.otstype) +\0A                        height * MBEDTLS_LMS_M_NODE_BYTES(ctx->params.type);\0A            right_node = Tc_candidate_root_node;\0A        } else {\0A            left_node = Tc_candidate_root_node;\0A            right_node = sig + SIG_PATH_OFFSET(ctx->params.otstype) +\0A                         height * MBEDTLS_LMS_M_NODE_BYTES(ctx->params.type);\0A        }\0A\0A        create_merkle_internal_value(&ctx->params, left_node, right_node,\0A                                     parent_node_id, Tc_candidate_root_node);\0A\0A        curr_node_id /= 2;\0A    }\0A\0A    if (memcmp(Tc_candidate_root_node, ctx->T_1_pub_key,\0A               MBEDTLS_LMS_M_NODE_BYTES(ctx->params.type))) {\0A        return MBEDTLS_ERR_LMS_VERIFY_FAILED;\0A    }\0A\0A    return 0;\0A}\0A\0A#if defined(MBEDTLS_LMS_PRIVATE)\0A\0A/* Calculate a full Merkle tree based on a private key. This function\0A * implements RFC8554 section 5.3, and is used to generate a public key (as the\0A * public key is the root node of the Merkle tree).\0A *\0A *  ctx                 The LMS private context, containing a parameter\0A *                      set and private key material consisting of both\0A *                      public and private OTS.\0A *\0A *  tree                The output tree, which is 2^(H + 1) hash outputs.\0A *                      In the case of H=10 we have 2048 tree nodes (of\0A *                      which 1024 of them are leaf nodes). Note that\0A *                      because the Merkle tree root is 1-indexed, the 0\0A *                      index tree node is never used.\0A */\0Astatic int calculate_merkle_tree(const mbedtls_lms_private_t *ctx,\0A                                 unsigned char *tree)\0A{\0A    unsigned int priv_key_idx;\0A    unsigned int r_node_idx;\0A    int ret = MBEDTLS_ERR_ERROR_CORRUPTION_DETECTED;\0A\0A    /* First create the leaf nodes, in ascending order */\0A    for (priv_key_idx = 0;\0A         priv_key_idx < MERKLE_TREE_INTERNAL_NODE_AM(ctx->params.type);\0A         priv_key_idx++) {\0A        r_node_idx = MERKLE_TREE_INTERNAL_NODE_AM(ctx->params.type) + priv_key_idx;\0A\0A        ret = create_merkle_leaf_value(&ctx->params,\0A                                       ctx->ots_public_keys[priv_key_idx].public_key,\0A                                       r_node_idx,\0A                                       &tree[r_node_idx * MBEDTLS_LMS_M_NODE_BYTES(\0A                                                 ctx->params.type)]);\0A        if (ret != 0) {\0A            return ret;\0A        }\0A    }\0A\0A    /* Then the internal nodes, in reverse order so that we can guarantee the\0A     * parent has been created */\0A    for (r_node_idx = MERKLE_TREE_INTERNAL_NODE_AM(ctx->params.type) - 1;\0A         r_node_idx > 0;\0A         r_node_idx--) {\0A        ret = create_merkle_internal_value(&ctx->params,\0A                                           &tree[(r_node_idx * 2) *\0A                                                 MBEDTLS_LMS_M_NODE_BYTES(ctx->params.type)],\0A                                           &tree[(r_node_idx * 2 + 1) *\0A                                                 MBEDTLS_LMS_M_NODE_BYTES(ctx->params.type)],\0A                                           r_node_idx,\0A                                           &tree[r_node_idx *\0A                                                 MBEDTLS_LMS_M_NODE_BYTES(ctx->params.type)]);\0A        if (ret != 0) {\0A            return ret;\0A        }\0A    }\0A\0A    return 0;\0A}\0A\0A/* Calculate a path from a leaf node of the Merkle tree to the root of the tree,\0A * and return the full path. This function implements RFC8554 section 5.4.1, as\0A * the Merkle path is the main component of an LMS signature.\0A *\0A *  ctx                 The LMS private context, containing a parameter\0A *                      set and private key material consisting of both\0A *                      public and private OTS.\0A *\0A *  leaf_node_id        Which leaf node to calculate the path from.\0A *\0A *  path                The output path, which is H hash outputs.\0A */\0Astatic int get_merkle_path(mbedtls_lms_private_t *ctx,\0A                           unsigned int leaf_node_id,\0A                           unsigned char *path)\0A{\0A    const size_t node_bytes = MBEDTLS_LMS_M_NODE_BYTES(ctx->params.type);\0A    unsigned int curr_node_id = leaf_node_id;\0A    unsigned int adjacent_node_id;\0A    unsigned char *tree = NULL;\0A    unsigned int height;\0A    int ret = MBEDTLS_ERR_ERROR_CORRUPTION_DETECTED;\0A\0A    tree = mbedtls_calloc((size_t) MERKLE_TREE_NODE_AM(ctx->params.type),\0A                          node_bytes);\0A    if (tree == NULL) {\0A        return MBEDTLS_ERR_LMS_ALLOC_FAILED;\0A    }\0A\0A    ret = calculate_merkle_tree(ctx, tree);\0A    if (ret != 0) {\0A        goto exit;\0A    }\0A\0A    for (height = 0; height < MBEDTLS_LMS_H_TREE_HEIGHT(ctx->params.type);\0A         height++) {\0A        adjacent_node_id = curr_node_id ^ 1;\0A\0A        memcpy(&path[height * node_bytes],\0A               &tree[adjacent_node_id * node_bytes], node_bytes);\0A\0A        curr_node_id >>= 1;\0A    }\0A\0A    ret = 0;\0A\0Aexit:\0A    mbedtls_zeroize_and_free(tree, node_bytes *\0A                             (size_t) MERKLE_TREE_NODE_AM(ctx->params.type));\0A\0A    return ret;\0A}\0A\0Avoid mbedtls_lms_private_init(mbedtls_lms_private_t *ctx)\0A{\0A    memset(ctx, 0, sizeof(*ctx));\0A}\0A\0Avoid mbedtls_lms_private_free(mbedtls_lms_private_t *ctx)\0A{\0A    if (ctx == NULL) {\0A        return;\0A    }\0A\0A    unsigned int idx;\0A\0A    if (ctx->have_private_key) {\0A        if (ctx->ots_private_keys != NULL) {\0A            for (idx = 0; idx < MERKLE_TREE_LEAF_NODE_AM(ctx->params.type); idx++) {\0A                mbedtls_lmots_private_free(&ctx->ots_private_keys[idx]);\0A            }\0A        }\0A\0A        if (ctx->ots_public_keys != NULL) {\0A            for (idx = 0; idx < MERKLE_TREE_LEAF_NODE_AM(ctx->params.type); idx++) {\0A                mbedtls_lmots_public_free(&ctx->ots_public_keys[idx]);\0A            }\0A        }\0A\0A        mbedtls_free(ctx->ots_private_keys);\0A        mbedtls_free(ctx->ots_public_keys);\0A    }\0A\0A    mbedtls_platform_zeroize(ctx, sizeof(*ctx));\0A}\0A\0A\0Aint mbedtls_lms_generate_private_key(mbedtls_lms_private_t *ctx,\0A                                     mbedtls_lms_algorithm_type_t type,\0A                                     mbedtls_lmots_algorithm_type_t otstype,\0A                                     int (*f_rng)(void *, unsigned char *, size_t),\0A                                     void *p_rng, const unsigned char *seed,\0A                                     size_t seed_size)\0A{\0A    unsigned int idx = 0;\0A    int ret = MBEDTLS_ERR_ERROR_CORRUPTION_DETECTED;\0A\0A    if (type != MBEDTLS_LMS_SHA256_M32_H10) {\0A        return MBEDTLS_ERR_LMS_BAD_INPUT_DATA;\0A    }\0A\0A    if (otstype != MBEDTLS_LMOTS_SHA256_N32_W8) {\0A        return MBEDTLS_ERR_LMS_BAD_INPUT_DATA;\0A    }\0A\0A    if (ctx->have_private_key) {\0A        return MBEDTLS_ERR_LMS_BAD_INPUT_DATA;\0A    }\0A\0A    ctx->params.type = type;\0A    ctx->params.otstype = otstype;\0A    ctx->have_private_key = 1;\0A\0A    ret = f_rng(p_rng,\0A                ctx->params.I_key_identifier,\0A                MBEDTLS_LMOTS_I_KEY_ID_LEN);\0A    if (ret != 0) {\0A        goto exit;\0A    }\0A\0A    /* Requires a cast to size_t to avoid an implicit cast warning on certain\0A     * platforms (particularly Windows) */\0A    ctx->ots_private_keys = mbedtls_calloc((size_t) MERKLE_TREE_LEAF_NODE_AM(ctx->params.type),\0A                                           sizeof(*ctx->ots_private_keys));\0A    if (ctx->ots_private_keys == NULL) {\0A        ret = MBEDTLS_ERR_LMS_ALLOC_FAILED;\0A        goto exit;\0A    }\0A\0A    /* Requires a cast to size_t to avoid an implicit cast warning on certain\0A     * platforms (particularly Windows) */\0A    ctx->ots_public_keys = mbedtls_calloc((size_t) MERKLE_TREE_LEAF_NODE_AM(ctx->params.type),\0A                                          sizeof(*ctx->ots_public_keys));\0A    if (ctx->ots_public_keys == NULL) {\0A        ret = MBEDTLS_ERR_LMS_ALLOC_FAILED;\0A        goto exit;\0A    }\0A\0A    for (idx = 0; idx < MERKLE_TREE_LEAF_NODE_AM(ctx->params.type); idx++) {\0A        mbedtls_lmots_private_init(&ctx->ots_private_keys[idx]);\0A        mbedtls_lmots_public_init(&ctx->ots_public_keys[idx]);\0A    }\0A\0A\0A    for (idx = 0; idx < MERKLE_TREE_LEAF_NODE_AM(ctx->params.type); idx++) {\0A        ret = mbedtls_lmots_generate_private_key(&ctx->ots_private_keys[idx],\0A                                                 otstype,\0A                                                 ctx->params.I_key_identifier,\0A                                                 idx, seed, seed_size);\0A        if (ret != 0) {\0A            goto exit;\0A        }\0A\0A        ret = mbedtls_lmots_calculate_public_key(&ctx->ots_public_keys[idx],\0A                                                 &ctx->ots_private_keys[idx]);\0A        if (ret != 0) {\0A            goto exit;\0A        }\0A    }\0A\0A    ctx->q_next_usable_key = 0;\0A\0Aexit:\0A    if (ret != 0) {\0A        mbedtls_lms_private_free(ctx);\0A    }\0A\0A    return ret;\0A}\0A\0Aint mbedtls_lms_calculate_public_key(mbedtls_lms_public_t *ctx,\0A                                     const mbedtls_lms_private_t *priv_ctx)\0A{\0A    const size_t node_bytes = MBEDTLS_LMS_M_NODE_BYTES(priv_ctx->params.type);\0A    int ret = MBEDTLS_ERR_ERROR_CORRUPTION_DETECTED;\0A    unsigned char *tree = NULL;\0A\0A    if (!priv_ctx->have_private_key) {\0A        return MBEDTLS_ERR_LMS_BAD_INPUT_DATA;\0A    }\0A\0A    if (priv_ctx->params.type\0A        != MBEDTLS_LMS_SHA256_M32_H10) {\0A        return MBEDTLS_ERR_LMS_BAD_INPUT_DATA;\0A    }\0A\0A    if (priv_ctx->params.otstype\0A        != MBEDTLS_LMOTS_SHA256_N32_W8) {\0A        return MBEDTLS_ERR_LMS_BAD_INPUT_DATA;\0A    }\0A\0A    tree = mbedtls_calloc((size_t) MERKLE_TREE_NODE_AM(priv_ctx->params.type),\0A                          node_bytes);\0A    if (tree == NULL) {\0A        return MBEDTLS_ERR_LMS_ALLOC_FAILED;\0A    }\0A\0A    memcpy(&ctx->params, &priv_ctx->params,\0A           sizeof(mbedtls_lmots_parameters_t));\0A\0A    ret = calculate_merkle_tree(priv_ctx, tree);\0A    if (ret != 0) {\0A        goto exit;\0A    }\0A\0A    /* Root node is always at position 1, due to 1-based indexing */\0A    memcpy(ctx->T_1_pub_key, &tree[node_bytes], node_bytes);\0A\0A    ctx->have_public_key = 1;\0A\0A    ret = 0;\0A\0Aexit:\0A    mbedtls_zeroize_and_free(tree, node_bytes *\0A                             (size_t) MERKLE_TREE_NODE_AM(priv_ctx->params.type));\0A\0A    return ret;\0A}\0A\0A\0Aint mbedtls_lms_sign(mbedtls_lms_private_t *ctx,\0A                     int (*f_rng)(void *, unsigned char *, size_t),\0A                     void *p_rng, const unsigned char *msg,\0A                     unsigned int msg_size, unsigned char *sig, size_t sig_size,\0A                     size_t *sig_len)\0A{\0A    uint32_t q_leaf_identifier;\0A    int ret = MBEDTLS_ERR_ERROR_CORRUPTION_DETECTED;\0A\0A    if (!ctx->have_private_key) {\0A        return MBEDTLS_ERR_LMS_BAD_INPUT_DATA;\0A    }\0A\0A    if (sig_size < MBEDTLS_LMS_SIG_LEN(ctx->params.type, ctx->params.otstype)) {\0A        return MBEDTLS_ERR_LMS_BUFFER_TOO_SMALL;\0A    }\0A\0A    if (ctx->params.type != MBEDTLS_LMS_SHA256_M32_H10) {\0A        return MBEDTLS_ERR_LMS_BAD_INPUT_DATA;\0A    }\0A\0A    if (ctx->params.otstype\0A        != MBEDTLS_LMOTS_SHA256_N32_W8) {\0A        return MBEDTLS_ERR_LMS_BAD_INPUT_DATA;\0A    }\0A\0A    if (ctx->q_next_usable_key >= MERKLE_TREE_LEAF_NODE_AM(ctx->params.type)) {\0A        return MBEDTLS_ERR_LMS_OUT_OF_PRIVATE_KEYS;\0A    }\0A\0A\0A    q_leaf_identifier = ctx->q_next_usable_key;\0A    /* This new value must _always_ be written back to the disk before the\0A     * signature is returned.\0A     */\0A    ctx->q_next_usable_key += 1;\0A\0A    if (MBEDTLS_LMS_SIG_LEN(ctx->params.type, ctx->params.otstype)\0A        < SIG_OTS_SIG_OFFSET) {\0A        return MBEDTLS_ERR_LMS_BAD_INPUT_DATA;\0A    }\0A\0A    ret = mbedtls_lmots_sign(&ctx->ots_private_keys[q_leaf_identifier],\0A                             f_rng,\0A                             p_rng,\0A                             msg,\0A                             msg_size,\0A                             sig + SIG_OTS_SIG_OFFSET,\0A                             MBEDTLS_LMS_SIG_LEN(ctx->params.type,\0A                                                 ctx->params.otstype) - SIG_OTS_SIG_OFFSET,\0A                             NULL);\0A    if (ret != 0) {\0A        return ret;\0A    }\0A\0A    MBEDTLS_PUT_UINT32_BE(ctx->params.type, sig, SIG_TYPE_OFFSET(ctx->params.otstype));\0A    MBEDTLS_PUT_UINT32_BE(q_leaf_identifier, sig, SIG_Q_LEAF_ID_OFFSET);\0A\0A    ret = get_merkle_path(ctx,\0A                          MERKLE_TREE_INTERNAL_NODE_AM(ctx->params.type) + q_leaf_identifier,\0A                          sig + SIG_PATH_OFFSET(ctx->params.otstype));\0A    if (ret != 0) {\0A        return ret;\0A    }\0A\0A    if (sig_len != NULL) {\0A        *sig_len = MBEDTLS_LMS_SIG_LEN(ctx->params.type, ctx->params.otstype);\0A    }\0A\0A\0A    return 0;\0A}\0A\0A#endif /* defined(MBEDTLS_LMS_PRIVATE) */\0A#endif /* defined(MBEDTLS_LMS_C) */\0A\00" }
