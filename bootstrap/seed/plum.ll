@.str45356 = private global { i64, i64, [3555 x i8] } { i64 -1, i64 3554, [3555 x i8] c"/**\0A * \5Cfile psa/crypto_platform.h\0A *\0A * \5Cbrief PSA cryptography module: Mbed TLS platform definitions\0A *\0A * \5Cnote This file may not be included directly. Applications must\0A * include psa/crypto.h.\0A *\0A * This file contains platform-dependent type definitions.\0A *\0A * In implementations with isolation between the application and the\0A * cryptography module, implementers should take care to ensure that\0A * the definitions that are exposed to applications match what the\0A * module implements.\0A */\0A/*\0A *  Copyright The Mbed TLS Contributors\0A *  SPDX-License-Identifier: Apache-2.0 OR GPL-2.0-or-later\0A */\0A\0A#ifndef PSA_CRYPTO_PLATFORM_H\0A#define PSA_CRYPTO_PLATFORM_H\0A#include \22mbedtls/private_access.h\22\0A\0A/*\0A * Include the build-time configuration information header. Here, we do not\0A * include `\22mbedtls/build_info.h\22` directly but `\22psa/build_info.h\22`, which\0A * is basically just an alias to it. This is to ease the maintenance of the\0A * TF-PSA-Crypto repository which has a different build system and\0A * configuration.\0A */\0A#include \22psa/build_info.h\22\0A\0A/* PSA requires several types which C99 provides in stdint.h. */\0A#include <stdint.h>\0A\0A#if defined(MBEDTLS_PSA_CRYPTO_KEY_ID_ENCODES_OWNER)\0A\0A/* Building for the PSA Crypto service on a PSA platform, a key owner is a PSA\0A * partition identifier.\0A *\0A * The function psa_its_identifier_of_slot() in psa_crypto_storage.c that\0A * translates a key identifier to a key storage file name assumes that\0A * mbedtls_key_owner_id_t is a 32-bit integer. This function thus needs\0A * reworking if mbedtls_key_owner_id_t is not defined as a 32-bit integer\0A * here anymore.\0A */\0Atypedef int32_t mbedtls_key_owner_id_t;\0A\0A/** Compare two key owner identifiers.\0A *\0A * \5Cparam id1 First key owner identifier.\0A * \5Cparam id2 Second key owner identifier.\0A *\0A * \5Creturn Non-zero if the two key owner identifiers are equal, zero otherwise.\0A */\0Astatic inline int mbedtls_key_owner_id_equal(mbedtls_key_owner_id_t id1,\0A                                             mbedtls_key_owner_id_t id2)\0A{\0A    return id1 == id2;\0A}\0A\0A#endif /* MBEDTLS_PSA_CRYPTO_KEY_ID_ENCODES_OWNER */\0A\0A/*\0A * When MBEDTLS_PSA_CRYPTO_SPM is defined, the code is being built for SPM\0A * (Secure Partition Manager) integration which separates the code into two\0A * parts: NSPE (Non-Secure Processing Environment) and SPE (Secure Processing\0A * Environment). When building for the SPE, an additional header file should be\0A * included.\0A */\0A#if defined(MBEDTLS_PSA_CRYPTO_SPM)\0A#define PSA_CRYPTO_SECURE 1\0A#include \22crypto_spe.h\22\0A#endif // MBEDTLS_PSA_CRYPTO_SPM\0A\0A#if defined(MBEDTLS_PSA_CRYPTO_EXTERNAL_RNG)\0A/** The type of the context passed to mbedtls_psa_external_get_random().\0A *\0A * Mbed TLS initializes the context to all-bits-zero before calling\0A * mbedtls_psa_external_get_random() for the first time.\0A *\0A * The definition of this type in the Mbed TLS source code is for\0A * demonstration purposes. Implementers of mbedtls_psa_external_get_random()\0A * are expected to replace it with a custom definition.\0A */\0Atypedef struct {\0A    uintptr_t MBEDTLS_PRIVATE(opaque)[2];\0A} mbedtls_psa_external_random_context_t;\0A#endif /* MBEDTLS_PSA_CRYPTO_EXTERNAL_RNG */\0A\0A#if defined(MBEDTLS_PSA_CRYPTO_CLIENT) && !defined(MBEDTLS_PSA_CRYPTO_C)\0A/** The type of the client handle used in context structures\0A *\0A * When a client view of the multipart context structures is required,\0A * this handle is used to keep a mapping with the service side of the\0A * context which contains the actual data.\0A */\0Atypedef uint32_t mbedtls_psa_client_handle_t;\0A#endif\0A\0A#endif /* PSA_CRYPTO_PLATFORM_H */\0A\00" }
