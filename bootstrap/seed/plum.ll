@.str41469 = private global { i64, i64, [7260 x i8] } { i64 -1, i64 7259, [7260 x i8] c"/*\0A *  PSA PAKE layer on top of Mbed TLS software crypto\0A */\0A/*\0A *  Copyright The Mbed TLS Contributors\0A *  SPDX-License-Identifier: Apache-2.0 OR GPL-2.0-or-later\0A */\0A\0A#ifndef PSA_CRYPTO_PAKE_H\0A#define PSA_CRYPTO_PAKE_H\0A\0A#include <psa/crypto.h>\0A\0A/** Set the session information for a password-authenticated key exchange.\0A *\0A * \5Cnote The signature of this function is that of a PSA driver\0A *       pake_setup entry point. This function behaves as a pake_setup\0A *       entry point as defined in the PSA driver interface specification for\0A *       transparent drivers.\0A *\0A * \5Cparam[in,out] operation     The operation object to set up. It must have\0A *                              been initialized but not set up yet.\0A * \5Cparam[in] inputs            Inputs required for PAKE operation (role, password,\0A *                              key lifetime, cipher suite)\0A *\0A * \5Cretval #PSA_SUCCESS\0A *         Success.\0A * \5Cretval #PSA_ERROR_NOT_SUPPORTED\0A *         The algorithm in \5Cp cipher_suite is not a supported PAKE algorithm,\0A *         or the PAKE primitive in \5Cp cipher_suite is not supported or not\0A *         compatible with the PAKE algorithm, or the hash algorithm in\0A *         \5Cp cipher_suite is not supported or not compatible with the PAKE\0A *         algorithm and primitive.\0A * \5Cretval #PSA_ERROR_INSUFFICIENT_MEMORY   \5Cemptydescription\0A * \5Cretval #PSA_ERROR_CORRUPTION_DETECTED   \5Cemptydescription\0A */\0Apsa_status_t mbedtls_psa_pake_setup(mbedtls_psa_pake_operation_t *operation,\0A                                    const psa_crypto_driver_pake_inputs_t *inputs);\0A\0A\0A/** Get output for a step of a password-authenticated key exchange.\0A *\0A * \5Cnote The signature of this function is that of a PSA driver\0A *       pake_output entry point. This function behaves as a pake_output\0A *       entry point as defined in the PSA driver interface specification for\0A *       transparent drivers.\0A *\0A * \5Cparam[in,out] operation    Active PAKE operation.\0A * \5Cparam step                 The step of the algorithm for which the output is\0A *                             requested.\0A * \5Cparam[out] output          Buffer where the output is to be written in the\0A *                             format appropriate for this driver \5Cp step. Refer to\0A *                             the documentation of psa_crypto_driver_pake_step_t for\0A *                             more information.\0A * \5Cparam output_size          Size of the \5Cp output buffer in bytes. This must\0A *                             be at least #PSA_PAKE_OUTPUT_SIZE(\5Cp alg, \5Cp\0A *                             primitive, \5Cp step) where \5Cp alg and\0A *                             \5Cp primitive are the PAKE algorithm and primitive\0A *                             in the operation's cipher suite, and \5Cp step is\0A *                             the output step.\0A *\0A * \5Cparam[out] output_length   On success, the number of bytes of the returned\0A *                             output.\0A *\0A * \5Cretval #PSA_SUCCESS\0A *         Success.\0A * \5Cretval #PSA_ERROR_BUFFER_TOO_SMALL\0A *         The size of the \5Cp output buffer is too small.\0A * \5Cretval #PSA_ERROR_INSUFFICIENT_ENTROPY  \5Cemptydescription\0A * \5Cretval #PSA_ERROR_CORRUPTION_DETECTED   \5Cemptydescription\0A * \5Cretval #PSA_ERROR_DATA_CORRUPT          \5Cemptydescription\0A * \5Cretval #PSA_ERROR_DATA_INVALID          \5Cemptydescription\0A */\0Apsa_status_t mbedtls_psa_pake_output(mbedtls_psa_pake_operation_t *operation,\0A                                     psa_crypto_driver_pake_step_t step,\0A                                     uint8_t *output,\0A                                     size_t output_size,\0A                                     size_t *output_length);\0A\0A/** Provide input for a step of a password-authenticated key exchange.\0A *\0A * \5Cnote The signature of this function is that of a PSA driver\0A *       pake_input entry point. This function behaves as a pake_input\0A *       entry point as defined in the PSA driver interface specification for\0A *       transparent drivers.\0A *\0A * \5Cnote The core checks that input_length is smaller than PSA_PAKE_INPUT_MAX_SIZE.\0A *\0A * \5Cparam[in,out] operation    Active PAKE operation.\0A * \5Cparam step                 The driver step for which the input is provided.\0A * \5Cparam[in] input            Buffer containing the input in the format\0A *                             appropriate for this \5Cp step. Refer to the\0A *                             documentation of psa_crypto_driver_pake_step_t\0A *                             for more information.\0A * \5Cparam input_length         Size of the \5Cp input buffer in bytes.\0A *\0A * \5Cretval #PSA_SUCCESS\0A *         Success.\0A * \5Cretval #PSA_ERROR_INVALID_SIGNATURE\0A *         The verification fails for a zero-knowledge input step.\0A * \5Cretval #PSA_ERROR_INVALID_ARGUMENT\0A *         the \5Cp input is not valid for the \5Cp operation's algorithm, cipher suite\0A *         or \5Cp step.\0A * \5Cretval #PSA_ERROR_NOT_SUPPORTED\0A *         the \5Cp input is not supported for the \5Cp operation's algorithm, cipher\0A *         suite or \5Cp step.\0A * \5Cretval #PSA_ERROR_INSUFFICIENT_MEMORY   \5Cemptydescription\0A * \5Cretval #PSA_ERROR_CORRUPTION_DETECTED   \5Cemptydescription\0A * \5Cretval #PSA_ERROR_DATA_CORRUPT          \5Cemptydescription\0A * \5Cretval #PSA_ERROR_DATA_INVALID          \5Cemptydescription\0A */\0Apsa_status_t mbedtls_psa_pake_input(mbedtls_psa_pake_operation_t *operation,\0A                                    psa_crypto_driver_pake_step_t step,\0A                                    const uint8_t *input,\0A                                    size_t input_length);\0A\0A/** Get implicitly confirmed shared secret from a PAKE.\0A *\0A * \5Cnote The signature of this function is that of a PSA driver\0A *       pake_get_implicit_key entry point. This function behaves as a\0A *       pake_get_implicit_key entry point as defined in the PSA driver\0A *       interface specification for transparent drivers.\0A *\0A * \5Cparam[in,out] operation    Active PAKE operation.\0A * \5Cparam[out] output          Output buffer for implicit key.\0A * \5Cparam      output_size     Size of the output buffer in bytes.\0A * \5Cparam[out] output_length   On success, the number of bytes of the implicit key.\0A *\0A * \5Cretval #PSA_SUCCESS\0A *         Success.\0A * \5Cretval #PSA_ERROR_NOT_SUPPORTED\0A *         Input from a PAKE is not supported by the algorithm in the \5Cp output\0A *         key derivation operation.\0A * \5Cretval #PSA_ERROR_INSUFFICIENT_MEMORY   \5Cemptydescription\0A * \5Cretval #PSA_ERROR_CORRUPTION_DETECTED   \5Cemptydescription\0A * \5Cretval #PSA_ERROR_DATA_CORRUPT          \5Cemptydescription\0A * \5Cretval #PSA_ERROR_DATA_INVALID          \5Cemptydescription\0A */\0Apsa_status_t mbedtls_psa_pake_get_implicit_key(\0A    mbedtls_psa_pake_operation_t *operation,\0A    uint8_t *output, size_t output_size,\0A    size_t *output_length);\0A\0A/** Abort a PAKE operation.\0A *\0A * \5Cnote The signature of this function is that of a PSA driver\0A *       pake_abort entry point. This function behaves as a pake_abort\0A *       entry point as defined in the PSA driver interface specification for\0A *       transparent drivers.\0A *\0A * \5Cparam[in,out] operation    The operation to abort.\0A *\0A * \5Cretval #PSA_SUCCESS\0A *         Success.\0A * \5Cretval #PSA_ERROR_CORRUPTION_DETECTED   \5Cemptydescription\0A */\0Apsa_status_t mbedtls_psa_pake_abort(mbedtls_psa_pake_operation_t *operation);\0A\0A#endif /* PSA_CRYPTO_PAKE_H */\0A\00" }
