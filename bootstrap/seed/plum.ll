@.str46277 = private global { i64, i64, [8923 x i8] } { i64 -1, i64 8922, [8923 x i8] c"/*\0A *  ECC setters for PK.\0A *\0A *  Copyright The Mbed TLS Contributors\0A *  SPDX-License-Identifier: Apache-2.0 OR GPL-2.0-or-later\0A */\0A\0A#include \22common.h\22\0A\0A#include \22mbedtls/pk.h\22\0A#include \22mbedtls/error.h\22\0A#include \22mbedtls/ecp.h\22\0A#include \22pk_internal.h\22\0A\0A#if defined(MBEDTLS_PK_C) && defined(MBEDTLS_PK_HAVE_ECC_KEYS)\0A\0Aint mbedtls_pk_ecc_set_group(mbedtls_pk_context *pk, mbedtls_ecp_group_id grp_id)\0A{\0A#if defined(MBEDTLS_PK_USE_PSA_EC_DATA)\0A    size_t ec_bits;\0A    psa_ecc_family_t ec_family = mbedtls_ecc_group_to_psa(grp_id, &ec_bits);\0A\0A    /* group may already be initialized; if so, make sure IDs match */\0A    if ((pk->ec_family != 0 && pk->ec_family != ec_family) ||\0A        (pk->ec_bits != 0 && pk->ec_bits != ec_bits)) {\0A        return MBEDTLS_ERR_PK_KEY_INVALID_FORMAT;\0A    }\0A\0A    /* set group */\0A    pk->ec_family = ec_family;\0A    pk->ec_bits = ec_bits;\0A\0A    return 0;\0A#else /* MBEDTLS_PK_USE_PSA_EC_DATA */\0A    mbedtls_ecp_keypair *ecp = mbedtls_pk_ec_rw(*pk);\0A\0A    /* grp may already be initialized; if so, make sure IDs match */\0A    if (mbedtls_pk_ec_ro(*pk)->grp.id != MBEDTLS_ECP_DP_NONE &&\0A        mbedtls_pk_ec_ro(*pk)->grp.id != grp_id) {\0A        return MBEDTLS_ERR_PK_KEY_INVALID_FORMAT;\0A    }\0A\0A    /* set group */\0A    return mbedtls_ecp_group_load(&(ecp->grp), grp_id);\0A#endif /* MBEDTLS_PK_USE_PSA_EC_DATA */\0A}\0A\0Aint mbedtls_pk_ecc_set_key(mbedtls_pk_context *pk, unsigned char *key, size_t key_len)\0A{\0A#if defined(MBEDTLS_PK_USE_PSA_EC_DATA)\0A    psa_key_attributes_t attributes = PSA_KEY_ATTRIBUTES_INIT;\0A    psa_key_usage_t flags;\0A    psa_status_t status;\0A\0A    psa_set_key_type(&attributes, PSA_KEY_TYPE_ECC_KEY_PAIR(pk->ec_family));\0A    if (pk->ec_family == PSA_ECC_FAMILY_MONTGOMERY) {\0A        /* Do not set algorithm here because Montgomery keys cannot do ECDSA and\0A         * the PK module cannot do ECDH. When the key will be used in TLS for\0A         * ECDH, it will be exported and then re-imported with proper flags\0A         * and algorithm. */\0A        flags = PSA_KEY_USAGE_EXPORT;\0A    } else {\0A        psa_set_key_algorithm(&attributes,\0A                              MBEDTLS_PK_PSA_ALG_ECDSA_MAYBE_DET(PSA_ALG_ANY_HASH));\0A        flags = PSA_KEY_USAGE_SIGN_HASH | PSA_KEY_USAGE_SIGN_MESSAGE |\0A                PSA_KEY_USAGE_EXPORT;\0A    }\0A    psa_set_key_usage_flags(&attributes, flags);\0A\0A    status = psa_import_key(&attributes, key, key_len, &pk->priv_id);\0A    return psa_pk_status_to_mbedtls(status);\0A\0A#else /* MBEDTLS_PK_USE_PSA_EC_DATA */\0A\0A    mbedtls_ecp_keypair *eck = mbedtls_pk_ec_rw(*pk);\0A    int ret = mbedtls_ecp_read_key(eck->grp.id, eck, key, key_len);\0A    if (ret != 0) {\0A        return MBEDTLS_ERROR_ADD(MBEDTLS_ERR_PK_KEY_INVALID_FORMAT, ret);\0A    }\0A    return 0;\0A#endif /* MBEDTLS_PK_USE_PSA_EC_DATA */\0A}\0A\0Aint mbedtls_pk_ecc_set_pubkey_from_prv(mbedtls_pk_context *pk,\0A                                       const unsigned char *prv, size_t prv_len,\0A                                       int (*f_rng)(void *, unsigned char *, size_t), void *p_rng)\0A{\0A#if defined(MBEDTLS_PK_USE_PSA_EC_DATA)\0A\0A    (void) f_rng;\0A    (void) p_rng;\0A    (void) prv;\0A    (void) prv_len;\0A    psa_status_t status;\0A\0A    status = psa_export_public_key(pk->priv_id, pk->pub_raw, sizeof(pk->pub_raw),\0A                                   &pk->pub_raw_len);\0A    return psa_pk_status_to_mbedtls(status);\0A\0A#elif defined(MBEDTLS_USE_PSA_CRYPTO) /* && !MBEDTLS_PK_USE_PSA_EC_DATA */\0A\0A    (void) f_rng;\0A    (void) p_rng;\0A    psa_status_t status;\0A\0A    mbedtls_ecp_keypair *eck = (mbedtls_ecp_keypair *) pk->pk_ctx;\0A    size_t curve_bits;\0A    psa_ecc_family_t curve = mbedtls_ecc_group_to_psa(eck->grp.id, &curve_bits);\0A\0A    /* Import private key into PSA, from serialized input */\0A    mbedtls_svc_key_id_t key_id = MBEDTLS_SVC_KEY_ID_INIT;\0A    psa_key_attributes_t key_attr = PSA_KEY_ATTRIBUTES_INIT;\0A    psa_set_key_type(&key_attr, PSA_KEY_TYPE_ECC_KEY_PAIR(curve));\0A    psa_set_key_usage_flags(&key_attr, PSA_KEY_USAGE_EXPORT);\0A    status = psa_import_key(&key_attr, prv, prv_len, &key_id);\0A    if (status != PSA_SUCCESS) {\0A        return psa_pk_status_to_mbedtls(status);\0A    }\0A\0A    /* Export public key from PSA */\0A    unsigned char pub[MBEDTLS_PSA_MAX_EC_PUBKEY_LENGTH];\0A    size_t pub_len;\0A    status = psa_export_public_key(key_id, pub, sizeof(pub), &pub_len);\0A    psa_status_t destruction_status = psa_destroy_key(key_id);\0A    if (status != PSA_SUCCESS) {\0A        return psa_pk_status_to_mbedtls(status);\0A    } else if (destruction_status != PSA_SUCCESS) {\0A        return psa_pk_status_to_mbedtls(destruction_status);\0A    }\0A\0A    /* Load serialized public key into ecp_keypair structure */\0A    return mbedtls_ecp_point_read_binary(&eck->grp, &eck->Q, pub, pub_len);\0A\0A#else /* MBEDTLS_USE_PSA_CRYPTO */\0A\0A    (void) prv;\0A    (void) prv_len;\0A\0A    mbedtls_ecp_keypair *eck = (mbedtls_ecp_keypair *) pk->pk_ctx;\0A    return mbedtls_ecp_mul(&eck->grp, &eck->Q, &eck->d, &eck->grp.G, f_rng, p_rng);\0A\0A#endif /* MBEDTLS_USE_PSA_CRYPTO */\0A}\0A\0A#if defined(MBEDTLS_PK_USE_PSA_EC_DATA)\0A/*\0A * Set the public key: fallback using ECP_LIGHT in the USE_PSA_EC_DATA case.\0A *\0A * Normally, when MBEDTLS_PK_USE_PSA_EC_DATA is enabled, we only use PSA\0A * functions to handle keys. However, currently psa_import_key() does not\0A * support compressed points. In case that support was explicitly requested,\0A * this fallback uses ECP functions to get the job done. This is the reason\0A * why MBEDTLS_PK_PARSE_EC_COMPRESSED auto-enables MBEDTLS_ECP_LIGHT.\0A *\0A * [in/out] pk: in: must have the group set, see mbedtls_pk_ecc_set_group().\0A *              out: will have the public key set.\0A * [in] pub, pub_len: the public key as an ECPoint,\0A *                    in any format supported by ECP.\0A *\0A * Return:\0A * - 0 on success;\0A * - MBEDTLS_ERR_ECP_FEATURE_UNAVAILABLE if the format is potentially valid\0A *   but not supported;\0A * - another error code otherwise.\0A */\0Astatic int pk_ecc_set_pubkey_psa_ecp_fallback(mbedtls_pk_context *pk,\0A                                              const unsigned char *pub,\0A                                              size_t pub_len)\0A{\0A#if !defined(MBEDTLS_PK_PARSE_EC_COMPRESSED)\0A    (void) pk;\0A    (void) pub;\0A    (void) pub_len;\0A    return MBEDTLS_ERR_ECP_FEATURE_UNAVAILABLE;\0A#else /* MBEDTLS_PK_PARSE_EC_COMPRESSED */\0A    mbedtls_ecp_keypair ecp_key;\0A    mbedtls_ecp_group_id ecp_group_id;\0A    int ret;\0A\0A    ecp_group_id = mbedtls_ecc_group_from_psa(pk->ec_family, pk->ec_bits);\0A\0A    mbedtls_ecp_keypair_init(&ecp_key);\0A    ret = mbedtls_ecp_group_load(&(ecp_key.grp), ecp_group_id);\0A    if (ret != 0) {\0A        goto exit;\0A    }\0A    ret = mbedtls_ecp_point_read_binary(&(ecp_key.grp), &ecp_key.Q,\0A                                        pub, pub_len);\0A    if (ret != 0) {\0A        goto exit;\0A    }\0A    ret = mbedtls_ecp_point_write_binary(&(ecp_key.grp), &ecp_key.Q,\0A                                         MBEDTLS_ECP_PF_UNCOMPRESSED,\0A                                         &pk->pub_raw_len, pk->pub_raw,\0A                                         sizeof(pk->pub_raw));\0A\0Aexit:\0A    mbedtls_ecp_keypair_free(&ecp_key);\0A    return ret;\0A#endif /* MBEDTLS_PK_PARSE_EC_COMPRESSED */\0A}\0A#endif /* MBEDTLS_PK_USE_PSA_EC_DATA */\0A\0Aint mbedtls_pk_ecc_set_pubkey(mbedtls_pk_context *pk, const unsigned char *pub, size_t pub_len)\0A{\0A#if defined(MBEDTLS_PK_USE_PSA_EC_DATA)\0A\0A    /* Load the key */\0A    if (!PSA_ECC_FAMILY_IS_WEIERSTRASS(pk->ec_family) || *pub == 0x04) {\0A        /* Format directly supported by PSA:\0A         * - non-Weierstrass curves that only have one format;\0A         * - uncompressed format for Weierstrass curves. */\0A        if (pub_len > sizeof(pk->pub_raw)) {\0A            return MBEDTLS_ERR_PK_BUFFER_TOO_SMALL;\0A        }\0A        memcpy(pk->pub_raw, pub, pub_len);\0A        pk->pub_raw_len = pub_len;\0A    } else {\0A        /* Other format, try the fallback */\0A        int ret = pk_ecc_set_pubkey_psa_ecp_fallback(pk, pub, pub_len);\0A        if (ret != 0) {\0A            return ret;\0A        }\0A    }\0A\0A    /* Validate the key by trying to import it */\0A    mbedtls_svc_key_id_t key_id = MBEDTLS_SVC_KEY_ID_INIT;\0A    psa_key_attributes_t key_attrs = PSA_KEY_ATTRIBUTES_INIT;\0A\0A    psa_set_key_usage_flags(&key_attrs, 0);\0A    psa_set_key_type(&key_attrs, PSA_KEY_TYPE_ECC_PUBLIC_KEY(pk->ec_family));\0A    psa_set_key_bits(&key_attrs, pk->ec_bits);\0A\0A    if ((psa_import_key(&key_attrs, pk->pub_raw, pk->pub_raw_len,\0A                        &key_id) != PSA_SUCCESS) ||\0A        (psa_destroy_key(key_id) != PSA_SUCCESS)) {\0A        return MBEDTLS_ERR_PK_INVALID_PUBKEY;\0A    }\0A\0A    return 0;\0A\0A#else /* MBEDTLS_PK_USE_PSA_EC_DATA */\0A\0A    int ret;\0A    mbedtls_ecp_keypair *ec_key = (mbedtls_ecp_keypair *) pk->pk_ctx;\0A    ret = mbedtls_ecp_point_read_binary(&ec_key->grp, &ec_key->Q, pub, pub_len);\0A    if (ret != 0) {\0A        return ret;\0A    }\0A    return mbedtls_ecp_check_pubkey(&ec_key->grp, &ec_key->Q);\0A\0A#endif /* MBEDTLS_PK_USE_PSA_EC_DATA */\0A}\0A\0A#endif /* MBEDTLS_PK_C && MBEDTLS_PK_HAVE_ECC_KEYS */\0A\00" }
@.const46279 = private global <{ i64, ptr, ptr, i1, [7 x i8] }> <{ i64 -1, ptr @.str46275, ptr @.str46277, i1 1, [7 x i8] zeroinitializer }>
@.str46280 = private global { i64, i64, [30 x i8] } { i64 -1, i64 29, [30 x i8] c"mbedtls/library/pk_internal.h\00" }
@.str46282 = private global { i64, i64, [8004 x i8] } { i64 -1, i64 8003, [8004 x i8] c"/**\0A * \5Cfile pk_internal.h\0A *\0A * \5Cbrief Public Key abstraction layer: internal (i.e. library only) functions\0A *        and definitions.\0A */\0A/*\0A *  Copyright The Mbed TLS Contributors\0A *  SPDX-License-Identifier: Apache-2.0 OR GPL-2.0-or-later\0A */\0A#ifndef MBEDTLS_PK_INTERNAL_H\0A#define MBEDTLS_PK_INTERNAL_H\0A\0A#include \22mbedtls/pk.h\22\0A\0A#if defined(MBEDTLS_PK_HAVE_ECC_KEYS)\0A#include \22mbedtls/ecp.h\22\0A#endif\0A\0A#if defined(MBEDTLS_PSA_CRYPTO_CLIENT)\0A#include \22psa/crypto.h\22\0A\0A#include \22psa_util_internal.h\22\0A#define PSA_PK_TO_MBEDTLS_ERR(status) psa_pk_status_to_mbedtls(status)\0A#define PSA_PK_RSA_TO_MBEDTLS_ERR(status) PSA_TO_MBEDTLS_ERR_LIST(status,     \5C\0A                                                                  psa_to_pk_rsa_errors,            \5C\0A                                                                  psa_pk_status_to_mbedtls)\0A#define PSA_PK_ECDSA_TO_MBEDTLS_ERR(status) PSA_TO_MBEDTLS_ERR_LIST(status,   \5C\0A                                                                    psa_to_pk_ecdsa_errors,        \5C\0A                                                                    psa_pk_status_to_mbedtls)\0A#endif /* MBEDTLS_PSA_CRYPTO_CLIENT */\0A\0A/* Headers/footers for PEM files */\0A#define PEM_BEGIN_PUBLIC_KEY    \22-----BEGIN PUBLIC KEY-----\22\0A#define PEM_END_PUBLIC_KEY      \22-----END PUBLIC KEY-----\22\0A#define PEM_BEGIN_PRIVATE_KEY_RSA   \22-----BEGIN RSA PRIVATE KEY-----\22\0A#define PEM_END_PRIVATE_KEY_RSA     \22-----END RSA PRIVATE KEY-----\22\0A#define PEM_BEGIN_PUBLIC_KEY_RSA     \22-----BEGIN RSA PUBLIC KEY-----\22\0A#define PEM_END_PUBLIC_KEY_RSA     \22-----END RSA PUBLIC KEY-----\22\0A#define PEM_BEGIN_PRIVATE_KEY_EC    \22-----BEGIN EC PRIVATE KEY-----\22\0A#define PEM_END_PRIVATE_KEY_EC      \22-----END EC PRIVATE KEY-----\22\0A#define PEM_BEGIN_PRIVATE_KEY_PKCS8 \22-----BEGIN PRIVATE KEY-----\22\0A#define PEM_END_PRIVATE_KEY_PKCS8   \22-----END PRIVATE KEY-----\22\0A#define PEM_BEGIN_ENCRYPTED_PRIVATE_KEY_PKCS8 \22-----BEGIN ENCRYPTED PRIVATE KEY-----\22\0A#define PEM_END_ENCRYPTED_PRIVATE_KEY_PKCS8   \22-----END ENCRYPTED PRIVATE KEY-----\22\0A\0A#if defined(MBEDTLS_PK_HAVE_ECC_KEYS) && !defined(MBEDTLS_PK_USE_PSA_EC_DATA)\0A/**\0A * Public function mbedtls_pk_ec() can be used to get direct access to the\0A * wrapped ecp_keypair structure pointed to the pk_ctx. However this is not\0A * ideal because it bypasses the PK module on the control of its internal\0A * structure (pk_context) fields.\0A * For backward compatibility we keep mbedtls_pk_ec() when ECP_C is defined, but\0A * we provide 2 very similar functions when only ECP_LIGHT is enabled and not\0A * ECP_C.\0A * These variants embed the \22ro\22 or \22rw\22 keywords in their name to make the\0A * usage of the returned pointer explicit. Of course the returned value is\0A * const or non-const accordingly.\0A */\0Astatic inline const mbedtls_ecp_keypair *mbedtls_pk_ec_ro(const mbedtls_pk_context pk)\0A{\0A    switch (mbedtls_pk_get_type(&pk)) {\0A        case MBEDTLS_PK_ECKEY:\0A        case MBEDTLS_PK_ECKEY_DH:\0A        case MBEDTLS_PK_ECDSA:\0A            return (const mbedtls_ecp_keypair *) (pk).MBEDTLS_PRIVATE(pk_ctx);\0A        default:\0A            return NULL;\0A    }\0A}\0A\0Astatic inline mbedtls_ecp_keypair *mbedtls_pk_ec_rw(const mbedtls_pk_context pk)\0A{\0A    switch (mbedtls_pk_get_type(&pk)) {\0A        case MBEDTLS_PK_ECKEY:\0A        case MBEDTLS_PK_ECKEY_DH:\0A        case MBEDTLS_PK_ECDSA:\0A            return (mbedtls_ecp_keypair *) (pk).MBEDTLS_PRIVATE(pk_ctx);\0A        default:\0A            return NULL;\0A    }\0A}\0A#endif /* MBEDTLS_PK_HAVE_ECC_KEYS && !MBEDTLS_PK_USE_PSA_EC_DATA */\0A\0A#if defined(MBEDTLS_PK_HAVE_ECC_KEYS)\0Astatic inline mbedtls_ecp_group_id mbedtls_pk_get_ec_group_id(const mbedtls_pk_context *pk)\0A{\0A    mbedtls_ecp_group_id id;\0A\0A#if defined(MBEDTLS_USE_PSA_CRYPTO)\0A    if (mbedtls_pk_get_type(pk) == MBEDTLS_PK_OPAQUE) {\0A        psa_key_attributes_t opaque_attrs = PSA_KEY_ATTRIBUTES_INIT;\0A        psa_key_type_t opaque_key_type;\0A        psa_ecc_family_t curve;\0A\0A        if (psa_get_key_attributes(pk->priv_id, &opaque_attrs) != PSA_SUCCESS) {\0A            return MBEDTLS_ECP_DP_NONE;\0A        }\0A        opaque_key_type = psa_get_key_type(&opaque_attrs);\0A        curve = PSA_KEY_TYPE_ECC_GET_FAMILY(opaque_key_type);\0A        id = mbedtls_ecc_group_from_psa(curve, psa_get_key_bits(&opaque_attrs));\0A        psa_reset_key_attributes(&opaque_attrs);\0A    } else\0A#endif /* MBEDTLS_USE_PSA_CRYPTO */\0A    {\0A#if defined(MBEDTLS_PK_USE_PSA_EC_DATA)\0A        id = mbedtls_ecc_group_from_psa(pk->ec_family, pk->ec_bits);\0A#else /* MBEDTLS_PK_USE_PSA_EC_DATA */\0A        id = mbedtls_pk_ec_ro(*pk)->grp.id;\0A#endif /* MBEDTLS_PK_USE_PSA_EC_DATA */\0A    }\0A\0A    return id;\0A}\0A\0A/* Helper for Montgomery curves */\0A#if defined(MBEDTLS_ECP_HAVE_CURVE25519) || defined(MBEDTLS_ECP_HAVE_CURVE448)\0A#define MBEDTLS_PK_HAVE_RFC8410_CURVES\0A#endif /* MBEDTLS_ECP_HAVE_CURVE25519 || MBEDTLS_ECP_DP_CURVE448 */\0A\0A#define MBEDTLS_PK_IS_RFC8410_GROUP_ID(id)  \5C\0A    ((id == MBEDTLS_ECP_DP_CURVE25519) || (id == MBEDTLS_ECP_DP_CURVE448))\0A\0Astatic inline int mbedtls_pk_is_rfc8410(const mbedtls_pk_context *pk)\0A{\0A    mbedtls_ecp_group_id id = mbedtls_pk_get_ec_group_id(pk);\0A\0A    return MBEDTLS_PK_IS_RFC8410_GROUP_ID(id);\0A}\0A\0A/*\0A * Set the group used by this key.\0A *\0A * [in/out] pk: in: must have been pk_setup() to an ECC type\0A *              out: will have group (curve) information set\0A * [in] grp_in: a supported group ID (not NONE)\0A */\0Aint mbedtls_pk_ecc_set_group(mbedtls_pk_context *pk, mbedtls_ecp_group_id grp_id);\0A\0A/*\0A * Set the private key material\0A *\0A * [in/out] pk: in: must have the group set already, see mbedtls_pk_ecc_set_group().\0A *              out: will have the private key set.\0A * [in] key, key_len: the raw private key (no ASN.1 wrapping).\0A */\0Aint mbedtls_pk_ecc_set_key(mbedtls_pk_context *pk, unsigned char *key, size_t key_len);\0A\0A/*\0A * Set the public key.\0A *\0A * [in/out] pk: in: must have its group set, see mbedtls_pk_ecc_set_group().\0A *              out: will have the public key set.\0A * [in] pub, pub_len: the raw public key (an ECPoint).\0A *\0A * Return:\0A * - 0 on success;\0A * - MBEDTLS_ERR_ECP_FEATURE_UNAVAILABLE if the format is potentially valid\0A *   but not supported;\0A * - another error code otherwise.\0A */\0Aint mbedtls_pk_ecc_set_pubkey(mbedtls_pk_context *pk, const unsigned char *pub, size_t pub_len);\0A\0A/*\0A * Derive a public key from its private counterpart.\0A * Computationally intensive, only use when public key is not available.\0A *\0A * [in/out] pk: in: must have the private key set, see mbedtls_pk_ecc_set_key().\0A *              out: will have the public key set.\0A * [in] prv, prv_len: the raw private key (see note below).\0A * [in] f_rng, p_rng: RNG function and context.\0A *\0A * Note: the private key information is always available from pk,\0A * however for convenience the serialized version is also passed,\0A * as it's available at each calling site, and useful in some configs\0A * (as otherwise we would have to re-serialize it from the pk context).\0A *\0A * There are three implementations of this function:\0A * 1. MBEDTLS_PK_USE_PSA_EC_DATA,\0A * 2. MBEDTLS_USE_PSA_CRYPTO but not MBEDTLS_PK_USE_PSA_EC_DATA,\0A * 3. not MBEDTLS_USE_PSA_CRYPTO.\0A */\0Aint mbedtls_pk_ecc_set_pubkey_from_prv(mbedtls_pk_context *pk,\0A                                       const unsigned char *prv, size_t prv_len,\0A                                       int (*f_rng)(void *, unsigned char *, size_t), void *p_rng);\0A#endif /* MBEDTLS_PK_HAVE_ECC_KEYS */\0A\0A/* Helper for (deterministic) ECDSA */\0A#if defined(MBEDTLS_ECDSA_DETERMINISTIC)\0A#define MBEDTLS_PK_PSA_ALG_ECDSA_MAYBE_DET  PSA_ALG_DETERMINISTIC_ECDSA\0A#else\0A#define MBEDTLS_PK_PSA_ALG_ECDSA_MAYBE_DET  PSA_ALG_ECDSA\0A#endif\0A\0A#if defined(MBEDTLS_TEST_HOOKS)\0AMBEDTLS_STATIC_TESTABLE int mbedtls_pk_parse_key_pkcs8_encrypted_der(\0A    mbedtls_pk_context *pk,\0A    unsigned char *key, size_t keylen,\0A    const unsigned char *pwd, size_t pwdlen,\0A    int (*f_rng)(void *, unsigned char *, size_t), void *p_rng);\0A#endif\0A\0A#if defined(MBEDTLS_FS_IO)\0Aint mbedtls_pk_load_file(const char *path, unsigned char **buf, size_t *n);\0A#endif\0A\0A#endif /* MBEDTLS_PK_INTERNAL_H */\0A\00" }
