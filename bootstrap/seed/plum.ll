|\0A        mbedtls_rsa_check_privkey(&rsa) != 0) {\0A        if (verbose != 0) {\0A            mbedtls_printf(\22failed\5Cn\22);\0A        }\0A\0A        ret = 1;\0A        goto cleanup;\0A    }\0A\0A    if (verbose != 0) {\0A        mbedtls_printf(\22passed\5Cn  PKCS#1 encryption : \22);\0A    }\0A\0A    memcpy(rsa_plaintext, RSA_PT, PT_LEN);\0A\0A    if (mbedtls_rsa_pkcs1_encrypt(&rsa, myrand, NULL,\0A                                  PT_LEN, rsa_plaintext,\0A                                  rsa_ciphertext) != 0) {\0A        if (verbose != 0) {\0A            mbedtls_printf(\22failed\5Cn\22);\0A        }\0A\0A        ret = 1;\0A        goto cleanup;\0A    }\0A\0A    if (verbose != 0) {\0A        mbedtls_printf(\22passed\5Cn  PKCS#1 decryption : \22);\0A    }\0A\0A    if (mbedtls_rsa_pkcs1_decrypt(&rsa, myrand, NULL,\0A                                  &len, rsa_ciphertext, rsa_decrypted,\0A                                  sizeof(rsa_decrypted)) != 0) {\0A        if (verbose != 0) {\0A            mbedtls_printf(\22failed\5Cn\22);\0A        }\0A\0A        ret = 1;\0A        goto cleanup;\0A    }\0A\0A    if (memcmp(rsa_decrypted, rsa_plaintext, len) != 0) {\0A        if (verbose != 0) {\0A            mbedtls_printf(\22failed\5Cn\22);\0A        }\0A\0A        ret = 1;\0A        goto cleanup;\0A    }\0A\0A    if (verbose != 0) {\0A        mbedtls_printf(\22passed\5Cn\22);\0A    }\0A\0A#if defined(MBEDTLS_MD_CAN_SHA1)\0A    if (verbose != 0) {\0A        mbedtls_printf(\22  PKCS#1 data sign  : \22);\0A    }\0A\0A    if (mbedtls_md(mbedtls_md_info_from_type(MBEDTLS_MD_SHA1),\0A                   rsa_plaintext, PT_LEN, sha1sum) != 0) {\0A        if (verbose != 0) {\0A            mbedtls_printf(\22failed\5Cn\22);\0A        }\0A\0A        return 1;\0A    }\0A\0A    if (mbedtls_rsa_pkcs1_sign(&rsa, myrand, NULL,\0A                               MBEDTLS_MD_SHA1, 20,\0A                               sha1sum, rsa_ciphertext) != 0) {\0A        if (verbose != 0) {\0A            mbedtls_printf(\22failed\5Cn\22);\0A        }\0A\0A        ret = 1;\0A        goto cleanup;\0A    }\0A\0A    if (verbose != 0) {\0A        mbedtls_printf(\22passed\5Cn  PKCS#1 sig. verify: \22);\0A    }\0A\0A    if (mbedtls_rsa_pkcs1_verify(&rsa, MBEDTLS_MD_SHA1, 20,\0A                                 sha1sum, rsa_ciphertext) != 0) {\0A        if (verbose != 0) {\0A            mbedtls_printf(\22failed\5Cn\22);\0A        }\0A\0A        ret = 1;\0A        goto cleanup;\0A    }\0A\0A    if (verbose != 0) {\0A        mbedtls_printf(\22passed\5Cn\22);\0A    }\0A#endif /* MBEDTLS_MD_CAN_SHA1 */\0A\0A    if (verbose != 0) {\0A        mbedtls_printf(\22\5Cn\22);\0A    }\0A\0Acleanup:\0A    mbedtls_mpi_free(&K);\0A    mbedtls_rsa_free(&rsa);\0A#else /* MBEDTLS_PKCS1_V15 */\0A    ((void) verbose);\0A#endif /* MBEDTLS_PKCS1_V15 */\0A    return ret;\0A}\0A\0A#endif /* MBEDTLS_SELF_TEST */\0A\0A#endif /* MBEDTLS_RSA_C */\0A\00" }
