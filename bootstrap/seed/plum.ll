@.str40703 = private global { i64, i64, [20977 x i8] } { i64 -1, i64 20976, [20977 x i8] c"/*\0A *  X.509 Certificate Revocation List (CRL) parsing\0A *\0A *  Copyright The Mbed TLS Contributors\0A *  SPDX-License-Identifier: Apache-2.0 OR GPL-2.0-or-later\0A */\0A/*\0A *  The ITU-T X.509 standard defines a certificate format for PKI.\0A *\0A *  http://www.ietf.org/rfc/rfc5280.txt (Certificates and CRLs)\0A *  http://www.ietf.org/rfc/rfc3279.txt (Alg IDs for CRLs)\0A *  http://www.ietf.org/rfc/rfc2986.txt (CSRs, aka PKCS#10)\0A *\0A *  http://www.itu.int/ITU-T/studygroups/com17/languages/X.680-0207.pdf\0A *  http://www.itu.int/ITU-T/studygroups/com17/languages/X.690-0207.pdf\0A */\0A\0A#include \22common.h\22\0A\0A#if defined(MBEDTLS_X509_CRL_PARSE_C)\0A\0A#include \22mbedtls/x509_crl.h\22\0A#include \22x509_internal.h\22\0A#include \22mbedtls/error.h\22\0A#include \22mbedtls/oid.h\22\0A#include \22mbedtls/platform_util.h\22\0A\0A#include <string.h>\0A\0A#if defined(MBEDTLS_PEM_PARSE_C)\0A#include \22mbedtls/pem.h\22\0A#endif\0A\0A#include \22mbedtls/platform.h\22\0A\0A#if defined(MBEDTLS_HAVE_TIME)\0A#if defined(_WIN32) && !defined(EFIX64) && !defined(EFI32)\0A#include <windows.h>\0A#else\0A#include <time.h>\0A#endif\0A#endif\0A\0A#if defined(MBEDTLS_FS_IO) || defined(EFIX64) || defined(EFI32)\0A#include <stdio.h>\0A#endif\0A\0A/*\0A *  Version  ::=  INTEGER  {  v1(0), v2(1)  }\0A */\0Astatic int x509_crl_get_version(unsigned char **p,\0A                                const unsigned char *end,\0A                                int *ver)\0A{\0A    int ret = MBEDTLS_ERR_ERROR_CORRUPTION_DETECTED;\0A\0A    if ((ret = mbedtls_asn1_get_int(p, end, ver)) != 0) {\0A        if (ret == MBEDTLS_ERR_ASN1_UNEXPECTED_TAG) {\0A            *ver = 0;\0A            return 0;\0A        }\0A\0A        return MBEDTLS_ERROR_ADD(MBEDTLS_ERR_X509_INVALID_VERSION, ret);\0A    }\0A\0A    return 0;\0A}\0A\0A/*\0A * X.509 CRL v2 extensions\0A *\0A * We currently don't parse any extension's content, but we do check that the\0A * list of extensions is well-formed and abort on critical extensions (that\0A * are unsupported as we don't support any extension so far)\0A */\0Astatic int x509_get_crl_ext(unsigned char **p,\0A                            const unsigned char *end,\0A                            mbedtls_x509_buf *ext)\0A{\0A    int ret = MBEDTLS_ERR_ERROR_CORRUPTION_DETECTED;\0A\0A    if (*p == end) {\0A        return 0;\0A    }\0A\0A    /*\0A     * crlExtensions           [0]  EXPLICIT Extensions OPTIONAL\0A     *                              -- if present, version MUST be v2\0A     */\0A    if ((ret = mbedtls_x509_get_ext(p, end, ext, 0)) != 0) {\0A        return ret;\0A    }\0A\0A    end = ext->p + ext->len;\0A\0A    while (*p < end) {\0A        /*\0A         * Extension  ::=  SEQUENCE  {\0A         *      extnID      OBJECT IDENTIFIER,\0A         *      critical    BOOLEAN DEFAULT FALSE,\0A         *      extnValue   OCTET STRING  }\0A         */\0A        int is_critical = 0;\0A        const unsigned char *end_ext_data;\0A        size_t len;\0A\0A        /* Get enclosing sequence tag */\0A        if ((ret = mbedtls_asn1_get_tag(p, end, &len,\0A                                        MBEDTLS_ASN1_CONSTRUCTED | MBEDTLS_ASN1_SEQUENCE)) != 0) {\0A            return MBEDTLS_ERROR_ADD(MBEDTLS_ERR_X509_INVALID_EXTENSIONS, ret);\0A        }\0A\0A        end_ext_data = *p + len;\0A\0A        /* Get OID (currently ignored) */\0A        if ((ret = mbedtls_asn1_get_tag(p, end_ext_data, &len,\0A                                        MBEDTLS_ASN1_OID)) != 0) {\0A            return MBEDTLS_ERROR_ADD(MBEDTLS_ERR_X509_INVALID_EXTENSIONS, ret);\0A        }\0A        *p += len;\0A\0A        /* Get optional critical */\0A        if ((ret = mbedtls_asn1_get_bool(p, end_ext_data,\0A                                         &is_critical)) != 0 &&\0A            (ret != MBEDTLS_ERR_ASN1_UNEXPECTED_TAG)) {\0A            return MBEDTLS_ERROR_ADD(MBEDTLS_ERR_X509_INVALID_EXTENSIONS, ret);\0A        }\0A\0A        /* Data should be octet string type */\0A        if ((ret = mbedtls_asn1_get_tag(p, end_ext_data, &len,\0A                                        MBEDTLS_ASN1_OCTET_STRING)) != 0) {\0A            return MBEDTLS_ERROR_ADD(MBEDTLS_ERR_X509_INVALID_EXTENSIONS, ret);\0A        }\0A\0A        /* Ignore data so far and just check its length */\0A        *p += len;\0A        if (*p != end_ext_data) {\0A            return MBEDTLS_ERROR_ADD(MBEDTLS_ERR_X509_INVALID_EXTENSIONS,\0A                                     MBEDTLS_ERR_ASN1_LENGTH_MISMATCH);\0A        }\0A\0A        /* Abort on (unsupported) critical extensions */\0A        if (is_critical) {\0A            return MBEDTLS_ERROR_ADD(MBEDTLS_ERR_X509_INVALID_EXTENSIONS,\0A                                     MBEDTLS_ERR_ASN1_UNEXPECTED_TAG);\0A        }\0A    }\0A\0A    if (*p != end) {\0A        return MBEDTLS_ERROR_ADD(MBEDTLS_ERR_X509_INVALID_EXTENSIONS,\0A                                 MBEDTLS_ERR_ASN1_LENGTH_MISMATCH);\0A    }\0A\0A    return 0;\0A}\0A\0A/*\0A * X.509 CRL v2 entry extensions (no extensions parsed yet.)\0A */\0Astatic int x509_get_crl_entry_ext(unsigned char **p,\0A                                  const unsigned char *end,\0A                                  mbedtls_x509_buf *ext)\0A{\0A    int ret = MBEDTLS_ERR_ERROR_CORRUPTION_DETECTED;\0A    size_t len = 0;\0A\0A    /* OPTIONAL */\0A    if (end <= *p) {\0A        return 0;\0A    }\0A\0A    ext->tag = **p;\0A    ext->p = *p;\0A\0A    /*\0A     * Get CRL-entry extension sequence header\0A     * crlEntryExtensions      Extensions OPTIONAL  -- if present, MUST be v2\0A     */\0A    if ((ret = mbedtls_asn1_get_tag(p, end, &ext->len,\0A                                    MBEDTLS_ASN1_CONSTRUCTED | MBEDTLS_ASN1_SEQUENCE)) != 0) {\0A        if (ret == MBEDTLS_ERR_ASN1_UNEXPECTED_TAG) {\0A            ext->p = NULL;\0A            return 0;\0A        }\0A        return MBEDTLS_ERROR_ADD(MBEDTLS_ERR_X509_INVALID_EXTENSIONS, ret);\0A    }\0A\0A    end = *p + ext->len;\0A\0A    if (end != *p + ext->len) {\0A        return MBEDTLS_ERROR_ADD(MBEDTLS_ERR_X509_INVALID_EXTENSIONS,\0A                                 MBEDTLS_ERR_ASN1_LENGTH_MISMATCH);\0A    }\0A\0A    while (*p < end) {\0A        if ((ret = mbedtls_asn1_get_tag(p, end, &len,\0A                                        MBEDTLS_ASN1_CONSTRUCTED | MBEDTLS_ASN1_SEQUENCE)) != 0) {\0A            return MBEDTLS_ERROR_ADD(MBEDTLS_ERR_X509_INVALID_EXTENSIONS, ret);\0A        }\0A\0A        *p += len;\0A    }\0A\0A    if (*p != end) {\0A        return MBEDTLS_ERROR_ADD(MBEDTLS_ERR_X509_INVALID_EXTENSIONS,\0A                                 MBEDTLS_ERR_ASN1_LENGTH_MISMATCH);\0A    }\0A\0A    return 0;\0A}\0A\0A/*\0A * X.509 CRL Entries\0A */\0Astatic int x509_get_entries(unsigned char **p,\0A                            const unsigned char *end,\0A                            mbedtls_x509_crl_entry *entry)\0A{\0A    int ret = MBEDTLS_ERR_ERROR_CORRUPTION_DETECTED;\0A    size_t entry_len;\0A    mbedtls_x509_crl_entry *cur_entry = entry;\0A\0A    if (*p == end) {\0A        return 0;\0A    }\0A\0A    if ((ret = mbedtls_asn1_get_tag(p, end, &entry_len,\0A                                    MBEDTLS_ASN1_SEQUENCE | MBEDTLS_ASN1_CONSTRUCTED)) != 0) {\0A        if (ret == MBEDTLS_ERR_ASN1_UNEXPECTED_TAG) {\0A            return 0;\0A        }\0A\0A        return ret;\0A    }\0A\0A    end = *p + entry_len;\0A\0A    while (*p < end) {\0A        size_t len2;\0A        const unsigned char *end2;\0A\0A        cur_entry->raw.tag = **p;\0A        if ((ret = mbedtls_asn1_get_tag(p, end, &len2,\0A                                        MBEDTLS_ASN1_SEQUENCE | MBEDTLS_ASN1_CONSTRUCTED)) != 0) {\0A            return ret;\0A        }\0A\0A        cur_entry->raw.p = *p;\0A        cur_entry->raw.len = len2;\0A        end2 = *p + len2;\0A\0A        if ((ret = mbedtls_x509_get_serial(p, end2, &cur_entry->serial)) != 0) {\0A            return ret;\0A        }\0A\0A        if ((ret = mbedtls_x509_get_time(p, end2,\0A                                         &cur_entry->revocation_date)) != 0) {\0A            return ret;\0A        }\0A\0A        if ((ret = x509_get_crl_entry_ext(p, end2,\0A                                          &cur_entry->entry_ext)) != 0) {\0A            return ret;\0A        }\0A\0A        if (*p < end) {\0A            cur_entry->next = mbedtls_calloc(1, sizeof(mbedtls_x509_crl_entry));\0A\0A            if (cur_entry->next == NULL) {\0A                return MBEDTLS_ERR_X509_ALLOC_FAILED;\0A            }\0A\0A            cur_entry = cur_entry->next;\0A        }\0A    }\0A\0A    return 0;\0A}\0A\0A/*\0A * Parse one  CRLs in DER format and append it to the chained list\0A */\0Aint mbedtls_x509_crl_parse_der(mbedtls_x509_crl *chain,\0A                               const unsigned char *buf, size_t buflen)\0A{\0A    int ret = MBEDTLS_ERR_ERROR_CORRUPTION_DETECTED;\0A    size_t len;\0A    unsigned char *p = NULL, *end = NULL;\0A    mbedtls_x509_buf sig_params1, sig_params2, sig_oid2;\0A    mbedtls_x509_crl *crl = chain;\0A\0A    /*\0A     * Check for valid input\0A     */\0A    if (crl == NULL || buf == NULL) {\0A        return MBEDTLS_ERR_X509_BAD_INPUT_DATA;\0A    }\0A\0A    memset(&sig_params1, 0, sizeof(mbedtls_x509_buf));\0A    memset(&sig_params2, 0, sizeof(mbedtls_x509_buf));\0A    memset(&sig_oid2, 0, sizeof(mbedtls_x509_buf));\0A\0A    /*\0A     * Add new CRL on the end of the chain if needed.\0A     */\0A    while (crl->version != 0 && crl->next != NULL) {\0A        crl = crl->next;\0A    }\0A\0A    if (crl->version != 0 && crl->next == NULL) {\0A        crl->next = mbedtls_calloc(1, sizeof(mbedtls_x509_crl));\0A\0A        if (crl->next == NULL) {\0A            mbedtls_x509_crl_free(crl);\0A            return MBEDTLS_ERR_X509_ALLOC_FAILED;\0A        }\0A\0A        mbedtls_x509_crl_init(crl->next);\0A        crl = crl->next;\0A    }\0A\0A    /*\0A     * Copy raw DER-encoded CRL\0A     */\0A    if (buflen == 0) {\0A        return MBEDTLS_ERR_X509_INVALID_FORMAT;\0A    }\0A\0A    p = mbedtls_calloc(1, buflen);\0A    if (p == NULL) {\0A        return MBEDTLS_ERR_X509_ALLOC_FAILED;\0A    }\0A\0A    memcpy(p, buf, buflen);\0A\0A    crl->raw.p = p;\0A    crl->raw.len = buflen;\0A\0A    end = p + buflen;\0A\0A    /*\0A     * CertificateList  ::=  SEQUENCE  {\0A     *      tbsCertList          TBSCertList,\0A     *      signatureAlgorithm   AlgorithmIdentifier,\0A     *      signatureValue       BIT STRING  }\0A     */\0A    if ((ret = mbedtls_asn1_get_tag(&p, end, &len,\0A                                    MBEDTLS_ASN1_CONSTRUCTED | MBEDTLS_ASN1_SEQUENCE)) != 0) {\0A        mbedtls_x509_crl_free(crl);\0A        return MBEDTLS_ERR_X509_INVALID_FORMAT;\0A    }\0A\0A    if (len != (size_t) (end - p)) {\0A        mbedtls_x509_crl_free(crl);\0A        return MBEDTLS_ERROR_ADD(MBEDTLS_ERR_X509_INVALID_FORMAT,\0A                                 MBEDTLS_ERR_ASN1_LENGTH_MISMATCH);\0A    }\0A\0A    /*\0A     * TBSCertList  ::=  SEQUENCE  {\0A     */\0A    crl->tbs.p = p;\0A\0A    if ((ret = mbedtls_asn1_get_tag(&p, end, &len,\0A                                    MBEDTLS_ASN1_CONSTRUCTED | MBEDTLS_ASN1_SEQUENCE)) != 0) {\0A        mbedtls_x509_crl_free(crl);\0A        return MBEDTLS_ERROR_ADD(MBEDTLS_ERR_X509_INVALID_FORMAT, ret);\0A    }\0A\0A    end = p + len;\0A    crl->tbs.len = (size_t) (end - crl->tbs.p);\0A\0A    /*\0A     * Version  ::=  INTEGER  OPTIONAL {  v1(0), v2(1)  }\0A     *               -- if present, MUST be v2\0A     *\0A     * signature            AlgorithmIdentifier\0A     */\0A    if ((ret = x509_crl_get_version(&p, end, &crl->version)) != 0 ||\0A        (ret = mbedtls_x509_get_alg(&p, end, &crl->sig_oid, &sig_params1)) != 0) {\0A        mbedtls_x509_crl_free(crl);\0A        return ret;\0A    }\0A\0A    if (crl->version < 0 || crl->version > 1) {\0A        mbedtls_x509_crl_free(crl);\0A        return MBEDTLS_ERR_X509_UNKNOWN_VERSION;\0A    }\0A\0A    crl->version++;\0A\0A    if ((ret = mbedtls_x509_get_sig_alg(&crl->sig_oid, &sig_params1,\0A                                        &crl->sig_md, &crl->sig_pk,\0A                                        &crl->sig_opts)) != 0) {\0A        mbedtls_x509_crl_free(crl);\0A        return MBEDTLS_ERR_X509_UNKNOWN_SIG_ALG;\0A    }\0A\0A    /*\0A     * issuer               Name\0A     */\0A    crl->issuer_raw.p = p;\0A\0A    if ((ret = mbedtls_asn1_get_tag(&p, end, &len,\0A                                    MBEDTLS_ASN1_CONSTRUCTED | MBEDTLS_ASN1_SEQUENCE)) != 0) {\0A        mbedtls_x509_crl_free(crl);\0A        return MBEDTLS_ERROR_ADD(MBEDTLS_ERR_X509_INVALID_FORMAT, ret);\0A    }\0A\0A    if ((ret = mbedtls_x509_get_name(&p, p + len, &crl->issuer)) != 0) {\0A        mbedtls_x509_crl_free(crl);\0A        return ret;\0A    }\0A\0A    crl->issuer_raw.len = (size_t) (p - crl->issuer_raw.p);\0A\0A    /*\0A     * thisUpdate          Time\0A     * nextUpdate          Time OPTIONAL\0A     */\0A    if ((ret = mbedtls_x509_get_time(&p, end, &crl->this_update)) != 0) {\0A        mbedtls_x509_crl_free(crl);\0A        return ret;\0A    }\0A\0A    if ((ret = mbedtls_x509_get_time(&p, end, &crl->next_update)) != 0) {\0A        if (ret != (MBEDTLS_ERROR_ADD(MBEDTLS_ERR_X509_INVALID_DATE,\0A                                      MBEDTLS_ERR_ASN1_UNEXPECTED_TAG)) &&\0A            ret != (MBEDTLS_ERROR_ADD(MBEDTLS_ERR_X509_INVALID_DATE,\0A                                      MBEDTLS_ERR_ASN1_OUT_OF_DATA))) {\0A            mbedtls_x509_crl_free(crl);\0A            return ret;\0A        }\0A    }\0A\0A    /*\0A     * revokedCertificates    SEQUENCE OF SEQUENCE   {\0A     *      userCertificate        CertificateSerialNumber,\0A     *      revocationDate         Time,\0A     *      crlEntryExtensions     Extensions OPTIONAL\0A     *                                   -- if present, MUST be v2\0A     *                        } OPTIONAL\0A     */\0A    if ((ret = x509_get_entries(&p, end, &crl->entry)) != 0) {\0A        mbedtls_x509_crl_free(crl);\0A        return ret;\0A    }\0A\0A    /*\0A     * crlExtensions          EXPLICIT Extensions OPTIONAL\0A     *                              -- if present, MUST be v2\0A     */\0A    if (crl->version == 2) {\0A        ret = x509_get_crl_ext(&p, end, &crl->crl_ext);\0A\0A        if (ret != 0) {\0A            mbedtls_x509_crl_free(crl);\0A            return ret;\0A        }\0A    }\0A\0A    if (p != end) {\0A        mbedtls_x509_crl_free(crl);\0A        return MBEDTLS_ERROR_ADD(MBEDTLS_ERR_X509_INVALID_FORMAT,\0A                                 MBEDTLS_ERR_ASN1_LENGTH_MISMATCH);\0A    }\0A\0A    end = crl->raw.p + crl->raw.len;\0A\0A    /*\0A     *  signatureAlgorithm   AlgorithmIdentifier,\0A     *  signatureValue       BIT STRING\0A     */\0A    if ((ret = mbedtls_x509_get_alg(&p, end, &sig_oid2, &sig_params2)) != 0) {\0A        mbedtls_x509_crl_free(crl);\0A        return ret;\0A    }\0A\0A    if (crl->sig_oid.len != sig_oid2.len ||\0A        memcmp(crl->sig_oid.p, sig_oid2.p, crl->sig_oid.len) != 0 ||\0A        sig_params1.len != sig_params2.len ||\0A        (sig_params1.len != 0 &&\0A         memcmp(sig_params1.p, sig_params2.p, sig_params1.len) != 0)) {\0A        mbedtls_x509_crl_free(crl);\0A        return MBEDTLS_ERR_X509_SIG_MISMATCH;\0A    }\0A\0A    if ((ret = mbedtls_x509_get_sig(&p, end, &crl->sig)) != 0) {\0A        mbedtls_x509_crl_free(crl);\0A        return ret;\0A    }\0A\0A    if (p != end) {\0A        mbedtls_x509_crl_free(crl);\0A        return MBEDTLS_ERROR_ADD(MBEDTLS_ERR_X509_INVALID_FORMAT,\0A                                 MBEDTLS_ERR_ASN1_LENGTH_MISMATCH);\0A    }\0A\0A    return 0;\0A}\0A\0A/*\0A * Parse one or more CRLs and add them to the chained list\0A */\0Aint mbedtls_x509_crl_parse(mbedtls_x509_crl *chain, const unsigned char *buf, size_t buflen)\0A{\0A#if defined(MBEDTLS_PEM_PARSE_C)\0A    int ret = MBEDTLS_ERR_ERROR_CORRUPTION_DETECTED;\0A    size_t use_len = 0;\0A    mbedtls_pem_context pem;\0A    int is_pem = 0;\0A\0A    if (chain == NULL || buf == NULL) {\0A        return MBEDTLS_ERR_X509_BAD_INPUT_DATA;\0A    }\0A\0A    do {\0A        mbedtls_pem_init(&pem);\0A\0A        // Avoid calling mbedtls_pem_read_buffer() on non-null-terminated\0A        // string\0A        if (buflen == 0 || buf[buflen - 1] != '\5C0') {\0A            ret = MBEDTLS_ERR_PEM_NO_HEADER_FOOTER_PRESENT;\0A        } else {\0A            ret = mbedtls_pem_read_buffer(&pem,\0A                                          \22-----BEGIN X509 CRL-----\22,\0A                                          \22-----END X509 CRL-----\22,\0A                                          buf, NULL, 0, &use_len);\0A        }\0A\0A        if (ret == 0) {\0A            /*\0A             * Was PEM encoded\0A             */\0A            is_pem = 1;\0A\0A            buflen -= use_len;\0A            buf += use_len;\0A\0A            if ((ret = mbedtls_x509_crl_parse_der(chain,\0A                                                  pem.buf, pem.buflen)) != 0) {\0A                mbedtls_pem_free(&pem);\0A                return ret;\0A            }\0A        } else if (is_pem) {\0A            mbedtls_pem_free(&pem);\0A            return ret;\0A        }\0A\0A        mbedtls_pem_free(&pem);\0A    }\0A    /* In the PEM case, buflen is 1 at the end, for the terminated NULL byte.\0A     * And a valid CRL cannot be less than 1 byte anyway. */\0A    while (is_pem && buflen > 1);\0A\0A    if (is_pem) {\0A        return 0;\0A    } else\0A#endif /* MBEDTLS_PEM_PARSE_C */\0A    return mbedtls_x509_crl_parse_der(chain, buf, buflen);\0A}\0A\0A#if defined(MBEDTLS_FS_IO)\0A/*\0A * Load one or more CRLs and add them to the chained list\0A */\0Aint mbedtls_x509_crl_parse_file(mbedtls_x509_crl *chain, const char *path)\0A{\0A    int ret = MBEDTLS_ERR_ERROR_CORRUPTION_DETECTED;\0A    size_t n;\0A    unsigned char *buf;\0A\0A    if ((ret = mbedtls_pk_load_file(path, &buf, &n)) != 0) {\0A        return ret;\0A    }\0A\0A    ret = mbedtls_x509_crl_parse(chain, buf, n);\0A\0A    mbedtls_zeroize_and_free(buf, n);\0A\0A    return ret;\0A}\0A#endif /* MBEDTLS_FS_IO */\0A\0A#if !defined(MBEDTLS_X509_REMOVE_INFO)\0A/*\0A * Return an informational string about the certificate.\0A */\0A#define BEFORE_COLON    14\0A#define BC              \2214\22\0A/*\0A * Return an informational string about the CRL.\0A */\0Aint mbedtls_x509_crl_info(char *buf, size_t size, const char *prefix,\0A                          const mbedtls_x509_crl *crl)\0A{\0A    int ret = MBEDTLS_ERR_ERROR_CORRUPTION_DETECTED;\0A    size_t n;\0A    char *p;\0A    const mbedtls_x509_crl_entry *entry;\0A\0A    p = buf;\0A    n = size;\0A\0A    ret = mbedtls_snprintf(p, n, \22%sCRL version   : %d\22,\0A                           prefix, crl->version);\0A    MBEDTLS_X509_SAFE_SNPRINTF;\0A\0A    ret = mbedtls_snprintf(p, n, \22\5Cn%sissuer name   : \22, prefix);\0A    MBEDTLS_X509_SAFE_SNPRINTF;\0A    ret = mbedtls_x509_dn_gets(p, n, &crl->issuer);\0A    MBEDTLS_X509_SAFE_SNPRINTF;\0A\0A    ret = mbedtls_snprintf(p, n, \22\5Cn%sthis update   : \22 \5C\0A                                 \22%04d-%02d-%02d %02d:%02d:%02d\22, prefix,\0A                           crl->this_update.year, crl->this_update.mon,\0A                           crl->this_update.day,  crl->this_update.hour,\0A                           crl->this_update.min,  crl->this_update.sec);\0A    MBEDTLS_X509_SAFE_SNPRINTF;\0A\0A    ret = mbedtls_snprintf(p, n, \22\5Cn%snext update   : \22 \5C\0A                                 \22%04d-%02d-%02d %02d:%02d:%02d\22, prefix,\0A                           crl->next_update.year, crl->next_update.mon,\0A                           crl->next_update.day,  crl->next_update.hour,\0A                           crl->next_update.min,  crl->next_update.sec);\0A    MBEDTLS_X509_SAFE_SNPRINTF;\0A\0A    entry = &crl->entry;\0A\0A    ret = mbedtls_snprintf(p, n, \22\5Cn%sRevoked certificates:\22,\0A                           prefix);\0A    MBEDTLS_X509_SAFE_SNPRINTF;\0A\0A    while (entry != NULL && entry->raw.len != 0) {\0A        ret = mbedtls_snprintf(p, n, \22\5Cn%sserial number: \22,\0A                               prefix);\0A        MBEDTLS_X509_SAFE_SNPRINTF;\0A\0A        ret = mbedtls_x509_serial_gets(p, n, &entry->serial);\0A        MBEDTLS_X509_SAFE_SNPRINTF;\0A\0A        ret = mbedtls_snprintf(p, n, \22 revocation date: \22 \5C\0A                                     \22%04d-%02d-%02d %02d:%02d:%02d\22,\0A                               entry->revocation_date.year, entry->revocation_date.mon,\0A                               entry->revocation_date.day,  entry->revocation_date.hour,\0A                               entry->revocation_date.min,  entry->revocation_date.sec);\0A        MBEDTLS_X509_SAFE_SNPRINTF;\0A\0A        entry = entry->next;\0A    }\0A\0A    ret = mbedtls_snprintf(p, n, \22\5Cn%ssigned using  : \22, prefix);\0A    MBEDTLS_X509_SAFE_SNPRINTF;\0A\0A    ret = mbedtls_x509_sig_alg_gets(p, n, &crl->sig_oid, crl->sig_pk, crl->sig_md,\0A                                    crl->sig_opts);\0A    MBEDTLS_X509_SAFE_SNPRINTF;\0A\0A    ret = mbedtls_snprintf(p, n, \22\5Cn\22);\0A    MBEDTLS_X509_SAFE_SNPRINTF;\0A\0A    return (int) (size - n);\0A}\0A#endif /* MBEDTLS_X509_REMOVE_INFO */\0A\0A/*\0A * Initialize a CRL chain\0A */\0Avoid mbedtls_x509_crl_init(mbedtls_x509_crl *crl)\0A{\0A    memset(crl, 0, sizeof(mbedtls_x509_crl));\0A}\0A\0A/*\0A * Unallocate all CRL data\0A */\0Avoid mbedtls_x509_crl_free(mbedtls_x509_crl *crl)\0A{\0A    mbedtls_x509_crl *crl_cur = crl;\0A    mbedtls_x509_crl *crl_prv;\0A    mbedtls_x509_crl_entry *entry_cur;\0A    mbedtls_x509_crl_entry *entry_prv;\0A\0A    while (crl_cur != NULL) {\0A#if defined(MBEDTLS_X509_RSASSA_PSS_SUPPORT)\0A        mbedtls_free(crl_cur->sig_opts);\0A#endif\0A\0A        mbedtls_asn1_free_named_data_list_shallow(crl_cur->issuer.next);\0A\0A        entry_cur = crl_cur->entry.next;\0A        while (entry_cur != NULL) {\0A            entry_prv = entry_cur;\0A            entry_cur = entry_cur->next;\0A            mbedtls_zeroize_and_free(entry_prv,\0A                                     sizeof(mbedtls_x509_crl_entry));\0A        }\0A\0A        if (crl_cur->raw.p != NULL) {\0A            mbedtls_zeroize_and_free(crl_cur->raw.p, crl_cur->raw.len);\0A        }\0A\0A        crl_prv = crl_cur;\0A        crl_cur = crl_cur->next;\0A\0A        mbedtls_platform_zeroize(crl_prv, sizeof(mbedtls_x509_crl));\0A        if (crl_prv != crl) {\0A            mbedtls_free(crl_prv);\0A        }\0A    }\0A}\0A\0A#endif /* MBEDTLS_X509_CRL_PARSE_C */\0A\00" }
