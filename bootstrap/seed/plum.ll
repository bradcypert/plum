@.str40984 = private global { i64, i64, [21221 x i8] } { i64 -1, i64 21220, [21221 x i8] c"/**\0A * \5Cfile x509.h\0A *\0A * \5Cbrief X.509 generic defines and structures\0A */\0A/*\0A *  Copyright The Mbed TLS Contributors\0A *  SPDX-License-Identifier: Apache-2.0 OR GPL-2.0-or-later\0A */\0A#ifndef MBEDTLS_X509_H\0A#define MBEDTLS_X509_H\0A#include \22mbedtls/private_access.h\22\0A\0A#include \22mbedtls/build_info.h\22\0A\0A#include \22mbedtls/asn1.h\22\0A#include \22mbedtls/pk.h\22\0A\0A#if defined(MBEDTLS_RSA_C)\0A#include \22mbedtls/rsa.h\22\0A#endif\0A\0A/**\0A * \5Caddtogroup x509_module\0A * \5C{\0A */\0A\0A#if !defined(MBEDTLS_X509_MAX_INTERMEDIATE_CA)\0A/**\0A * Maximum number of intermediate CAs in a verification chain.\0A * That is, maximum length of the chain, excluding the end-entity certificate\0A * and the trusted root certificate.\0A *\0A * Set this to a low value to prevent an adversary from making you waste\0A * resources verifying an overlong certificate chain.\0A */\0A#define MBEDTLS_X509_MAX_INTERMEDIATE_CA   8\0A#endif\0A\0A/**\0A * \5Cname X509 Error codes\0A * \5C{\0A */\0A/** Unavailable feature, e.g. RSA hashing/encryption combination. */\0A#define MBEDTLS_ERR_X509_FEATURE_UNAVAILABLE              -0x2080\0A/** Requested OID is unknown. */\0A#define MBEDTLS_ERR_X509_UNKNOWN_OID                      -0x2100\0A/** The CRT/CRL/CSR format is invalid, e.g. different type expected. */\0A#define MBEDTLS_ERR_X509_INVALID_FORMAT                   -0x2180\0A/** The CRT/CRL/CSR version element is invalid. */\0A#define MBEDTLS_ERR_X509_INVALID_VERSION                  -0x2200\0A/** The serial tag or value is invalid. */\0A#define MBEDTLS_ERR_X509_INVALID_SERIAL                   -0x2280\0A/** The algorithm tag or value is invalid. */\0A#define MBEDTLS_ERR_X509_INVALID_ALG                      -0x2300\0A/** The name tag or value is invalid. */\0A#define MBEDTLS_ERR_X509_INVALID_NAME                     -0x2380\0A/** The date tag or value is invalid. */\0A#define MBEDTLS_ERR_X509_INVALID_DATE                     -0x2400\0A/** The signature tag or value invalid. */\0A#define MBEDTLS_ERR_X509_INVALID_SIGNATURE                -0x2480\0A/** The extension tag or value is invalid. */\0A#define MBEDTLS_ERR_X509_INVALID_EXTENSIONS               -0x2500\0A/** CRT/CRL/CSR has an unsupported version number. */\0A#define MBEDTLS_ERR_X509_UNKNOWN_VERSION                  -0x2580\0A/** Signature algorithm (oid) is unsupported. */\0A#define MBEDTLS_ERR_X509_UNKNOWN_SIG_ALG                  -0x2600\0A/** Signature algorithms do not match. (see \5Cc ::mbedtls_x509_crt sig_oid) */\0A#define MBEDTLS_ERR_X509_SIG_MISMATCH                     -0x2680\0A/** Certificate verification failed, e.g. CRL, CA or signature check failed. */\0A#define MBEDTLS_ERR_X509_CERT_VERIFY_FAILED               -0x2700\0A/** Format not recognized as DER or PEM. */\0A#define MBEDTLS_ERR_X509_CERT_UNKNOWN_FORMAT              -0x2780\0A/** Input invalid. */\0A#define MBEDTLS_ERR_X509_BAD_INPUT_DATA                   -0x2800\0A/** Allocation of memory failed. */\0A#define MBEDTLS_ERR_X509_ALLOC_FAILED                     -0x2880\0A/** Read/write of file failed. */\0A#define MBEDTLS_ERR_X509_FILE_IO_ERROR                    -0x2900\0A/** Destination buffer is too small. */\0A#define MBEDTLS_ERR_X509_BUFFER_TOO_SMALL                 -0x2980\0A/** A fatal error occurred, eg the chain is too long or the vrfy callback failed. */\0A#define MBEDTLS_ERR_X509_FATAL_ERROR                      -0x3000\0A/** \5C} name X509 Error codes */\0A\0A/**\0A * \5Cname X509 Verify codes\0A * \5C{\0A */\0A/* Reminder: update x509_crt_verify_strings[] in library/x509_crt.c */\0A#define MBEDTLS_X509_BADCERT_EXPIRED             0x01  /**< The certificate validity has expired. */\0A#define MBEDTLS_X509_BADCERT_REVOKED             0x02  /**< The certificate has been revoked (is on a CRL). */\0A#define MBEDTLS_X509_BADCERT_CN_MISMATCH         0x04  /**< The certificate Common Name (CN) does not match with the expected CN. */\0A#define MBEDTLS_X509_BADCERT_NOT_TRUSTED         0x08  /**< The certificate is not correctly signed by the trusted CA. */\0A#define MBEDTLS_X509_BADCRL_NOT_TRUSTED          0x10  /**< The CRL is not correctly signed by the trusted CA. */\0A#define MBEDTLS_X509_BADCRL_EXPIRED              0x20  /**< The CRL is expired. */\0A#define MBEDTLS_X509_BADCERT_MISSING             0x40  /**< Certificate was missing. */\0A#define MBEDTLS_X509_BADCERT_SKIP_VERIFY         0x80  /**< Certificate verification was skipped. */\0A#define MBEDTLS_X509_BADCERT_OTHER             0x0100  /**< Other reason (can be used by verify callback) */\0A#define MBEDTLS_X509_BADCERT_FUTURE            0x0200  /**< The certificate validity starts in the future. */\0A#define MBEDTLS_X509_BADCRL_FUTURE             0x0400  /**< The CRL is from the future */\0A#define MBEDTLS_X509_BADCERT_KEY_USAGE         0x0800  /**< Usage does not match the keyUsage extension. */\0A#define MBEDTLS_X509_BADCERT_EXT_KEY_USAGE     0x1000  /**< Usage does not match the extendedKeyUsage extension. */\0A#define MBEDTLS_X509_BADCERT_NS_CERT_TYPE      0x2000  /**< Usage does not match the nsCertType extension. */\0A#define MBEDTLS_X509_BADCERT_BAD_MD            0x4000  /**< The certificate is signed with an unacceptable hash. */\0A#define MBEDTLS_X509_BADCERT_BAD_PK            0x8000  /**< The certificate is signed with an unacceptable PK alg (eg RSA vs ECDSA). */\0A#define MBEDTLS_X509_BADCERT_BAD_KEY         0x010000  /**< The certificate is signed with an unacceptable key (eg bad curve, RSA too short). */\0A#define MBEDTLS_X509_BADCRL_BAD_MD           0x020000  /**< The CRL is signed with an unacceptable hash. */\0A#define MBEDTLS_X509_BADCRL_BAD_PK           0x040000  /**< The CRL is signed with an unacceptable PK alg (eg RSA vs ECDSA). */\0A#define MBEDTLS_X509_BADCRL_BAD_KEY          0x080000  /**< The CRL is signed with an unacceptable key (eg bad curve, RSA too short). */\0A\0A/** \5C} name X509 Verify codes */\0A/** \5C} addtogroup x509_module */\0A\0A/*\0A * X.509 v3 Subject Alternative Name types.\0A *      otherName                       [0]     OtherName,\0A *      rfc822Name                      [1]     IA5String,\0A *      dNSName                         [2]     IA5String,\0A *      x400Address                     [3]     ORAddress,\0A *      directoryName                   [4]     Name,\0A *      ediPartyName                    [5]     EDIPartyName,\0A *      uniformResourceIdentifier       [6]     IA5String,\0A *      iPAddress                       [7]     OCTET STRING,\0A *      registeredID                    [8]     OBJECT IDENTIFIER\0A */\0A#define MBEDTLS_X509_SAN_OTHER_NAME                      0\0A#define MBEDTLS_X509_SAN_RFC822_NAME                     1\0A#define MBEDTLS_X509_SAN_DNS_NAME                        2\0A#define MBEDTLS_X509_SAN_X400_ADDRESS_NAME               3\0A#define MBEDTLS_X509_SAN_DIRECTORY_NAME                  4\0A#define MBEDTLS_X509_SAN_EDI_PARTY_NAME                  5\0A#define MBEDTLS_X509_SAN_UNIFORM_RESOURCE_IDENTIFIER     6\0A#define MBEDTLS_X509_SAN_IP_ADDRESS                      7\0A#define MBEDTLS_X509_SAN_REGISTERED_ID                   8\0A\0A/*\0A * X.509 v3 Key Usage Extension flags\0A * Reminder: update mbedtls_x509_info_key_usage() when adding new flags.\0A */\0A#define MBEDTLS_X509_KU_DIGITAL_SIGNATURE            (0x80)  /* bit 0 */\0A#define MBEDTLS_X509_KU_NON_REPUDIATION              (0x40)  /* bit 1 */\0A#define MBEDTLS_X509_KU_KEY_ENCIPHERMENT             (0x20)  /* bit 2 */\0A#define MBEDTLS_X509_KU_DATA_ENCIPHERMENT            (0x10)  /* bit 3 */\0A#define MBEDTLS_X509_KU_KEY_AGREEMENT                (0x08)  /* bit 4 */\0A#define MBEDTLS_X509_KU_KEY_CERT_SIGN                (0x04)  /* bit 5 */\0A#define MBEDTLS_X509_KU_CRL_SIGN                     (0x02)  /* bit 6 */\0A#define MBEDTLS_X509_KU_ENCIPHER_ONLY                (0x01)  /* bit 7 */\0A#define MBEDTLS_X509_KU_DECIPHER_ONLY              (0x8000)  /* bit 8 */\0A\0A/*\0A * Netscape certificate types\0A * (http://www.mozilla.org/projects/security/pki/nss/tech-notes/tn3.html)\0A */\0A\0A#define MBEDTLS_X509_NS_CERT_TYPE_SSL_CLIENT         (0x80)  /* bit 0 */\0A#define MBEDTLS_X509_NS_CERT_TYPE_SSL_SERVER         (0x40)  /* bit 1 */\0A#define MBEDTLS_X509_NS_CERT_TYPE_EMAIL              (0x20)  /* bit 2 */\0A#define MBEDTLS_X509_NS_CERT_TYPE_OBJECT_SIGNING     (0x10)  /* bit 3 */\0A#define MBEDTLS_X509_NS_CERT_TYPE_RESERVED           (0x08)  /* bit 4 */\0A#define MBEDTLS_X509_NS_CERT_TYPE_SSL_CA             (0x04)  /* bit 5 */\0A#define MBEDTLS_X509_NS_CERT_TYPE_EMAIL_CA           (0x02)  /* bit 6 */\0A#define MBEDTLS_X509_NS_CERT_TYPE_OBJECT_SIGNING_CA  (0x01)  /* bit 7 */\0A\0A/*\0A * X.509 extension types\0A *\0A * Comments refer to the status for using certificates. Status can be\0A * different for writing certificates or reading CRLs or CSRs.\0A *\0A * Those are defined in oid.h as oid.c needs them in a data structure. Since\0A * these were previously defined here, let's have aliases for compatibility.\0A */\0A#define MBEDTLS_X509_EXT_AUTHORITY_KEY_IDENTIFIER MBEDTLS_OID_X509_EXT_AUTHORITY_KEY_IDENTIFIER\0A#define MBEDTLS_X509_EXT_SUBJECT_KEY_IDENTIFIER   MBEDTLS_OID_X509_EXT_SUBJECT_KEY_IDENTIFIER\0A#define MBEDTLS_X509_EXT_KEY_USAGE                MBEDTLS_OID_X509_EXT_KEY_USAGE\0A#define MBEDTLS_X509_EXT_CERTIFICATE_POLICIES     MBEDTLS_OID_X509_EXT_CERTIFICATE_POLICIES\0A#define MBEDTLS_X509_EXT_POLICY_MAPPINGS          MBEDTLS_OID_X509_EXT_POLICY_MAPPINGS\0A#define MBEDTLS_X509_EXT_SUBJECT_ALT_NAME         MBEDTLS_OID_X509_EXT_SUBJECT_ALT_NAME         /* Supported (DNS) */\0A#define MBEDTLS_X509_EXT_ISSUER_ALT_NAME          MBEDTLS_OID_X509_EXT_ISSUER_ALT_NAME\0A#define MBEDTLS_X509_EXT_SUBJECT_DIRECTORY_ATTRS  MBEDTLS_OID_X509_EXT_SUBJECT_DIRECTORY_ATTRS\0A#define MBEDTLS_X509_EXT_BASIC_CONSTRAINTS        MBEDTLS_OID_X509_EXT_BASIC_CONSTRAINTS        /* Supported */\0A#define MBEDTLS_X509_EXT_NAME_CONSTRAINTS         MBEDTLS_OID_X509_EXT_NAME_CONSTRAINTS\0A#define MBEDTLS_X509_EXT_POLICY_CONSTRAINTS       MBEDTLS_OID_X509_EXT_POLICY_CONSTRAINTS\0A#define MBEDTLS_X509_EXT_EXTENDED_KEY_USAGE       MBEDTLS_OID_X509_EXT_EXTENDED_KEY_USAGE\0A#define MBEDTLS_X509_EXT_CRL_DISTRIBUTION_POINTS  MBEDTLS_OID_X509_EXT_CRL_DISTRIBUTION_POINTS\0A#define MBEDTLS_X509_EXT_INIHIBIT_ANYPOLICY       MBEDTLS_OID_X509_EXT_INIHIBIT_ANYPOLICY\0A#define MBEDTLS_X509_EXT_FRESHEST_CRL             MBEDTLS_OID_X509_EXT_FRESHEST_CRL\0A#define MBEDTLS_X509_EXT_NS_CERT_TYPE             MBEDTLS_OID_X509_EXT_NS_CERT_TYPE\0A\0A/*\0A * Storage format identifiers\0A * Recognized formats: PEM and DER\0A */\0A#define MBEDTLS_X509_FORMAT_DER                 1\0A#define MBEDTLS_X509_FORMAT_PEM                 2\0A\0A#define MBEDTLS_X509_MAX_DN_NAME_SIZE         256 /**< Maximum value size of a DN entry */\0A\0A#ifdef __cplusplus\0Aextern \22C\22 {\0A#endif\0A\0A/**\0A * \5Caddtogroup x509_module\0A * \5C{ */\0A\0A/**\0A * \5Cname Structures for parsing X.509 certificates, CRLs and CSRs\0A * \5C{\0A */\0A\0A/**\0A * Type-length-value structure that allows for ASN1 using DER.\0A */\0Atypedef mbedtls_asn1_buf mbedtls_x509_buf;\0A\0A/**\0A * Container for ASN1 bit strings.\0A */\0Atypedef mbedtls_asn1_bitstring mbedtls_x509_bitstring;\0A\0A/**\0A * Container for ASN1 named information objects.\0A * It allows for Relative Distinguished Names (e.g. cn=localhost,ou=code,etc.).\0A */\0Atypedef mbedtls_asn1_named_data mbedtls_x509_name;\0A\0A/**\0A * Container for a sequence of ASN.1 items\0A */\0Atypedef mbedtls_asn1_sequence mbedtls_x509_sequence;\0A\0A/*\0A * Container for the fields of the Authority Key Identifier object\0A */\0Atypedef struct mbedtls_x509_authority {\0A    mbedtls_x509_buf keyIdentifier;\0A    mbedtls_x509_sequence authorityCertIssuer;\0A    mbedtls_x509_buf authorityCertSerialNumber;\0A    mbedtls_x509_buf raw;\0A}\0Ambedtls_x509_authority;\0A\0A/** Container for date and time (precision in seconds). */\0Atypedef struct mbedtls_x509_time {\0A    int year, mon, day;         /**< Date. */\0A    int hour, min, sec;         /**< Time. */\0A}\0Ambedtls_x509_time;\0A\0A/**\0A * From RFC 5280 section 4.2.1.6:\0A * OtherName ::= SEQUENCE {\0A *      type-id    OBJECT IDENTIFIER,\0A *      value      [0] EXPLICIT ANY DEFINED BY type-id }\0A *\0A * Future versions of the library may add new fields to this structure or\0A * to its embedded union and structure.\0A */\0Atypedef struct mbedtls_x509_san_other_name {\0A    /**\0A     * The type_id is an OID as defined in RFC 5280.\0A     * To check the value of the type id, you should use\0A     * \5Cp MBEDTLS_OID_CMP with a known OID mbedtls_x509_buf.\0A     */\0A    mbedtls_x509_buf type_id;                   /**< The type id. */\0A    union {\0A        /**\0A         * From RFC 4108 section 5:\0A         * HardwareModuleName ::= SEQUENCE {\0A         *                         hwType OBJECT IDENTIFIER,\0A         *                         hwSerialNum OCTET STRING }\0A         */\0A        struct {\0A            mbedtls_x509_buf oid;               /**< The object identifier. */\0A            mbedtls_x509_buf val;               /**< The named value. */\0A        }\0A        hardware_module_name;\0A    }\0A    value;\0A}\0Ambedtls_x509_san_other_name;\0A\0A/**\0A * A structure for holding the parsed Subject Alternative Name,\0A * according to type.\0A *\0A * Future versions of the library may add new fields to this structure or\0A * to its embedded union and structure.\0A */\0Atypedef struct mbedtls_x509_subject_alternative_name {\0A    int type;                              /**< The SAN type, value of MBEDTLS_X509_SAN_XXX. */\0A    union {\0A        mbedtls_x509_san_other_name other_name;\0A        mbedtls_x509_name directory_name;\0A        mbedtls_x509_buf unstructured_name; /**< The buffer for the unstructured types. rfc822Name, dnsName and uniformResourceIdentifier are currently supported. */\0A    }\0A    san; /**< A union of the supported SAN types */\0A}\0Ambedtls_x509_subject_alternative_name;\0A\0Atypedef struct mbedtls_x509_san_list {\0A    mbedtls_x509_subject_alternative_name node;\0A    struct mbedtls_x509_san_list *next;\0A}\0Ambedtls_x509_san_list;\0A\0A/** \5C} name Structures for parsing X.509 certificates, CRLs and CSRs */\0A/** \5C} addtogroup x509_module */\0A\0A/**\0A * \5Cbrief          Store the certificate DN in printable form into buf;\0A *                 no more than size characters will be written.\0A *\0A * \5Cparam buf      Buffer to write to\0A * \5Cparam size     Maximum size of buffer\0A * \5Cparam dn       The X509 name to represent\0A *\0A * \5Creturn         The length of the string written (not including the\0A *                 terminated nul byte), or a negative error code.\0A */\0Aint mbedtls_x509_dn_gets(char *buf, size_t size, const mbedtls_x509_name *dn);\0A\0A/**\0A * \5Cbrief            Convert the certificate DN string \5Cp name into\0A *                   a linked list of mbedtls_x509_name (equivalent to\0A *                   mbedtls_asn1_named_data).\0A *\0A * \5Cnote             This function allocates a linked list, and places the head\0A *                   pointer in \5Cp head. This list must later be freed by a\0A *                   call to mbedtls_asn1_free_named_data_list().\0A *\0A * \5Cparam[out] head  Address in which to store the pointer to the head of the\0A *                   allocated list of mbedtls_x509_name\0A * \5Cparam[in] name   The string representation of a DN to convert\0A *\0A * \5Creturn           0 on success, or a negative error code.\0A */\0Aint mbedtls_x509_string_to_names(mbedtls_asn1_named_data **head, const char *name);\0A\0A/**\0A * \5Cbrief          Return the next relative DN in an X509 name.\0A *\0A * \5Cnote           Intended use is to compare function result to dn->next\0A *                 in order to detect boundaries of multi-valued RDNs.\0A *\0A * \5Cparam dn       Current node in the X509 name\0A *\0A * \5Creturn         Pointer to the first attribute-value pair of the\0A *                 next RDN in sequence, or NULL if end is reached.\0A */\0Astatic inline mbedtls_x509_name *mbedtls_x509_dn_get_next(\0A    mbedtls_x509_name *dn)\0A{\0A    while (dn->MBEDTLS_PRIVATE(next_merged) && dn->next != NULL) {\0A        dn = dn->next;\0A    }\0A    return dn->next;\0A}\0A\0A/**\0A * \5Cbrief          Store the certificate serial in printable form into buf;\0A *                 no more than size characters will be written.\0A *\0A * \5Cparam buf      Buffer to write to\0A * \5Cparam size     Maximum size of buffer\0A * \5Cparam serial   The X509 serial to represent\0A *\0A * \5Creturn         The length of the string written (not including the\0A *                 terminated nul byte), or a negative error code.\0A */\0Aint mbedtls_x509_serial_gets(char *buf, size_t size, const mbedtls_x509_buf *serial);\0A\0A/**\0A * \5Cbrief          Compare pair of mbedtls_x509_time.\0A *\0A * \5Cparam t1       mbedtls_x509_time to compare\0A * \5Cparam t2       mbedtls_x509_time to compare\0A *\0A * \5Creturn         < 0 if t1 is before t2\0A *                   0 if t1 equals t2\0A *                 > 0 if t1 is after t2\0A */\0Aint mbedtls_x509_time_cmp(const mbedtls_x509_time *t1, const mbedtls_x509_time *t2);\0A\0A#if defined(MBEDTLS_HAVE_TIME_DATE)\0A/**\0A * \5Cbrief          Fill mbedtls_x509_time with provided mbedtls_time_t.\0A *\0A * \5Cparam tt       mbedtls_time_t to convert\0A * \5Cparam now      mbedtls_x509_time to fill with converted mbedtls_time_t\0A *\0A * \5Creturn         \5Cc 0 on success\0A * \5Creturn         A non-zero return value on failure.\0A */\0Aint mbedtls_x509_time_gmtime(mbedtls_time_t tt, mbedtls_x509_time *now);\0A#endif /* MBEDTLS_HAVE_TIME_DATE */\0A\0A/**\0A * \5Cbrief          Check a given mbedtls_x509_time against the system time\0A *                 and tell if it's in the past.\0A *\0A * \5Cnote           Intended usage is \22if( is_past( valid_to ) ) ERROR\22.\0A *                 Hence the return value of 1 if on internal errors.\0A *\0A * \5Cparam to       mbedtls_x509_time to check\0A *\0A * \5Creturn         1 if the given time is in the past or an error occurred,\0A *                 0 otherwise.\0A */\0Aint mbedtls_x509_time_is_past(const mbedtls_x509_time *to);\0A\0A/**\0A * \5Cbrief          Check a given mbedtls_x509_time against the system time\0A *                 and tell if it's in the future.\0A *\0A * \5Cnote           Intended usage is \22if( is_future( valid_from ) ) ERROR\22.\0A *                 Hence the return value of 1 if on internal errors.\0A *\0A * \5Cparam from     mbedtls_x509_time to check\0A *\0A * \5Creturn         1 if the given time is in the future or an error occurred,\0A *                 0 otherwise.\0A */\0Aint mbedtls_x509_time_is_future(const mbedtls_x509_time *from);\0A\0A/**\0A * \5Cbrief          This function parses an item in the SubjectAlternativeNames\0A *                 extension. Please note that this function might allocate\0A *                 additional memory for a subject alternative name, thus\0A *                 mbedtls_x509_free_subject_alt_name has to be called\0A *                 to dispose of this additional memory afterwards.\0A *\0A * \5Cparam san_buf  The buffer holding the raw data item of the subject\0A *                 alternative name.\0A * \5Cparam san      The target structure to populate with the parsed presentation\0A *                 of the subject alternative name encoded in \5Cp san_buf.\0A *\0A * \5Cnote           Supported GeneralName types, as defined in RFC 5280:\0A *                 \22rfc822Name\22, \22dnsName\22, \22directoryName\22,\0A *                 \22uniformResourceIdentifier\22 and \22hardware_module_name\22\0A *                 of type \22otherName\22, as defined in RFC 4108.\0A *\0A * \5Cnote           This function should be called on a single raw data of\0A *                 subject alternative name. For example, after successful\0A *                 certificate parsing, one must iterate on every item in the\0A *                 \5Cc crt->subject_alt_names sequence, and pass it to\0A *                 this function.\0A *\0A * \5Cwarning        The target structure contains pointers to the raw data of the\0A *                 parsed certificate, and its lifetime is restricted by the\0A *                 lifetime of the certificate.\0A *\0A * \5Creturn         \5Cc 0 on success\0A * \5Creturn         #MBEDTLS_ERR_X509_FEATURE_UNAVAILABLE for an unsupported\0A *                 SAN type.\0A * \5Creturn         Another negative value for any other failure.\0A */\0Aint mbedtls_x509_parse_subject_alt_name(const mbedtls_x509_buf *san_buf,\0A                                        mbedtls_x509_subject_alternative_name *san);\0A/**\0A * \5Cbrief          Unallocate all data related to subject alternative name\0A *\0A * \5Cparam san      SAN structure - extra memory owned by this structure will be freed\0A */\0Avoid mbedtls_x509_free_subject_alt_name(mbedtls_x509_subject_alternative_name *san);\0A\0A/**\0A * \5Cbrief          This function parses a CN string as an IP address.\0A *\0A * \5Cparam cn       The CN string to parse. CN string MUST be null-terminated.\0A * \5Cparam dst      The target buffer to populate with the binary IP address.\0A *                 The buffer MUST be 16 bytes to save IPv6, and should be\0A *                 4-byte aligned if the result will be used as struct in_addr.\0A *                 e.g. uint32_t dst[4]\0A *\0A * \5Cnote           \5Cp cn is parsed as an IPv6 address if string contains ':',\0A *                 else \5Cp cn is parsed as an IPv4 address.\0A *\0A * \5Creturn         Length of binary IP address; num bytes written to target.\0A * \5Creturn         \5Cc 0 on failure to parse CN string as an IP address.\0A */\0Asize_t mbedtls_x509_crt_parse_cn_inet_pton(const char *cn, void *dst);\0A\0A#define MBEDTLS_X509_SAFE_SNPRINTF                          \5C\0A    do {                                                    \5C\0A        if (ret < 0 || (size_t) ret >= n)                  \5C\0A        return MBEDTLS_ERR_X509_BUFFER_TOO_SMALL;    \5C\0A                                                          \5C\0A        n -= (size_t) ret;                                  \5C\0A        p += (size_t) ret;                                  \5C\0A    } while (0)\0A\0A#ifdef __cplusplus\0A}\0A#endif\0A\0A#endif /* MBEDTLS_X509_H */\0A\00" }
