f (size > MAXDWORD) return -1;\0A    FILE_RENAME_INFORMATION *rename_info = malloc(size);\0A    if (!rename_info) return -1;\0A    memset(rename_info, 0, size);\0A    rename_info->ReplaceIfExists = TRUE;\0A    rename_info->RootDirectory = NULL;\0A    rename_info->FileNameLength = (DWORD)bytes;\0A    memcpy(rename_info->FileName, leaf, bytes);\0A    typedef NTSTATUS (NTAPI *Rename)(HANDLE, PIO_STATUS_BLOCK, PVOID, ULONG, FILE_INFORMATION_CLASS);\0A    HMODULE ntdll = GetModuleHandleW(L\22ntdll.dll\22);\0A    Rename rename_file = ntdll ? (Rename)(void *)GetProcAddress(ntdll, \22NtSetInformationFile\22) : NULL;\0A    if (!rename_file) { free(rename_info); return -1; }\0A    HANDLE file = CreateFileW(from, DELETE | FILE_READ_ATTRIBUTES,\0A        FILE_SHARE_READ | FILE_SHARE_WRITE | FILE_SHARE_DELETE, NULL, OPEN_EXISTING,\0A        FILE_FLAG_OPEN_REPARSE_POINT, NULL);\0A    int ok = 0;\0A    if (file != INVALID_HANDLE_VALUE) {\0A        BY_HANDLE_FILE_INFORMATION info;\0A        IO_STATUS_BLOCK status;\0A        ok = GetFileInformationByHandle(file, &info) &&\0A            !(info.dwFileAttributes & (FILE_ATTRIBUTE_DIRECTORY | FILE_ATTRIBUTE_REPARSE_POINT)) &&\0A            rename_file(file, &status, rename_info, (ULONG)size, FileRenameInformation) >= 0;\0A        CloseHandle(file);\0A    }\0A    free(rename_info);\0A    return ok ? 0 : -1;\0A}\0A#endif\0A\0A// Borrow the payload; do not copy it into another file-sized buffer.\0A// Only the sibling name (O(path length)) and libc's bounded FILE buffer\0A// are allocated here. Every ordinary failure releases both before return.\0Astatic long long plum_write_whole_file_impl(const char *path, const char *data, long long length,\0A                                            int strict) {\0A#if !defined(_WIN32)\0A    (void)strict;\0A#endif\0A    if (length < 0 || (uint64_t)length > SIZE_MAX) return -1;\0A    size_t n = strlen(path);\0A    if (n > SIZE_MAX - 64) return -1;\0A    char *tmp = malloc(n + 64);\0A    if (tmp == NULL