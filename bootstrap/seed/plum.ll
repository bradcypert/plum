clang) it makes no difference if n is a compile-time\0A     * constant, and is a very small perf regression if n is not a compile-time constant. */\0A    if (n % 8 == 0) {\0A        return;\0A    }\0A#endif\0A#else\0A    for (; (i + 4) <= n; i += 4) {\0A        uint32_t x = mbedtls_get_unaligned_uint32(a + i) ^ mbedtls_get_unaligned_uint32(b + i);\0A        mbedtls_put_unaligned_uint32(r + i, x);\0A    }\0A#if defined(__IAR_SYSTEMS_ICC__)\0A    if (n % 4 == 0) {\0A        return;\0A    }\0A#endif\0A#endif\0A#endif\0A    for (; i < n; i++) {\0A        r[i] = a[i] ^ b[i];\0A    }\0A}\0A\0A/* Fix MSVC C99 compatible issue\0A *      MSVC support __func__ from visual studio 2015( 1900 )\0A *      Use MSVC predefine macro to avoid name check fail.\0A */\0A#if (defined(_MSC_VER) && (_MSC_VER <= 1900))\0A#define /*no-check-names*/ __func__ __FUNCTION__\0A#endif\0A\0A/* Define `asm` for compilers which don't define it. */\0A/* *INDENT-OFF* */\0A#ifndef asm\0A#if defined(__IAR_SYSTEMS_ICC__)\0A#define asm __asm\0A#else\0A#define asm __asm__\0A#endif\0A#endif\0A/* *INDENT-ON* */\0A\0A/*\0A * Define the constraint used for read-only pointer operands to aarch64 asm.\0A *\0A * This is normally the usual \22r\22, but for aarch64_32 (aka ILP32,\0A * as found in watchos), \22p\22 is required to avoid warnings from clang.\0A *\0A * Note that clang does not recognise '+p' or '=p', and armclang\0A * does not recognise 'p' at all. Therefore, to update a pointer from\0A * aarch64 assembly, it is necessary to use something like:\0A *\0A * uintptr_t uptr = (uintptr_t) ptr;\0A * asm( \22ldr x4, [%x0], #8\22 ... : \22+r\22 (uptr) : : )\0A * ptr = (void*) uptr;\0A *\0A * Note that the \22x\22 in \22%x0\22 is neccessary; writing \22%0\22 will cause warnings.\0A */\0A#if defined(__aarch64__) && defined(MBEDTLS_HAVE_ASM)\0A#if UINTPTR_MAX == 0xfffffffful\0A/* ILP32: Specify the pointer operand slightly differently, as per #7787. */\0A#define MBEDTLS_ASM_AARCH64_PTR_CONSTRAINT \22p\22\0A#elif UIN