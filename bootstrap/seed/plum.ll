SEEK_SET) != 0) goto fail;\0A\0A    buf = malloc((size_t)size + 1);\0A    if (buf == NULL) goto fail;\0A    size_t got = fread(buf, 1, (size_t)size, f);\0A    if (ferror(f) || got != (size_t)size) goto fail;\0A    if (fclose(f) != 0) {\0A        free(buf);\0A        return NULL;\0A    }\0A    buf[got] = '\5C0';\0A    *length = size;\0A    return buf;\0A\0Afail:\0A    fclose(f);\0A    free(buf);\0A    return NULL;\0A}\0A\0A// Shared with Os.rename_file. Never falls back to a cross-volume copy.\0Aextern long long os_rename_file(const char *from, const char *to);\0A\0A// Complete the stream before publication. Both ordinary whole-file writes\0A// and strict generated-output writes use this transaction boundary.\0Astatic int plum_whole_finish(FILE *f, const char *data, size_t length,\0A                             int preserve_mode, unsigned mode) {\0A    size_t wrote = fwrite(data, 1, length, f);\0A    int ok = wrote == length && !ferror(f);\0A#if !defined(_WIN32)\0A    if (ok && preserve_mode && fchmod(fileno(f), mode & 0777) != 0) ok = 0;\0A#else\0A    (void)preserve_mode;\0A    (void)mode;\0A#endif\0A    if (fclose(f) != 0) ok = 0;\0A    return ok;\0A}\0A\0A#if defined(_WIN32)\0A// Both MoveFileEx and an NT rename with RootDirectory reopen the destination\0A// directory for write access, conflicting with the ancestor locks. The NT\0A// same-directory form (bare filename, NULL RootDirectory) instead renames\0A// within the source handle's directory, without resolving another parent.\0Astatic int plum_whole_rename_in_place(const wchar_t *from, const wchar_t *to) {\0A    const wchar_t *leaf = wcsrchr(to, L'\5C\5C');\0A    if (!leaf || !*++leaf) return -1;\0A    size_t bytes = wcslen(leaf) * sizeof(wchar_t);\0A    size_t size = sizeof(FILE_RENAME_INFORMATION) + bytes;\0A    if (size > MAXDWORD) return -1;\0A    FILE_RENAME_INFORMATION *rename_info = malloc(size);\0A    if (!rename_info) return -1;\0A    memset(rename_info, 0, size);\0A    rename_info->ReplaceIfExists = 