tls_ssl_tls13_session_ticket_allow_psk_ephemeral(\0A    mbedtls_ssl_session *session)\0A{\0A    return mbedtls_ssl_tls13_session_ticket_has_flags(\0A        session, MBEDTLS_SSL_TLS1_3_TICKET_ALLOW_PSK_EPHEMERAL_RESUMPTION);\0A}\0A\0Astatic inline unsigned int mbedtls_ssl_tls13_session_ticket_allow_early_data(\0A    mbedtls_ssl_session *session)\0A{\0A    return mbedtls_ssl_tls13_session_ticket_has_flags(\0A        session, MBEDTLS_SSL_TLS1_3_TICKET_ALLOW_EARLY_DATA);\0A}\0A\0Astatic inline void mbedtls_ssl_tls13_session_set_ticket_flags(\0A    mbedtls_ssl_session *session, unsigned int flags)\0A{\0A    session->ticket_flags |= (flags & MBEDTLS_SSL_TLS1_3_TICKET_FLAGS_MASK);\0A}\0A\0Astatic inline void mbedtls_ssl_tls13_session_clear_ticket_flags(\0A    mbedtls_ssl_session *session, unsigned int flags)\0A{\0A    session->ticket_flags &= ~(flags & MBEDTLS_SSL_TLS1_3_TICKET_FLAGS_MASK);\0A}\0A\0A#endif /* MBEDTLS_SSL_PROTO_TLS1_3 && MBEDTLS_SSL_SESSION_TICKETS */\0A\0A#if defined(MBEDTLS_SSL_SESSION_TICKETS) && defined(MBEDTLS_SSL_CLI_C)\0A#define MBEDTLS_SSL_SESSION_TICKETS_TLS1_2_BIT 0\0A#define MBEDTLS_SSL_SESSION_TICKETS_TLS1_3_BIT 1\0A\0A#define MBEDTLS_SSL_SESSION_TICKETS_TLS1_2_MASK \5C\0A    (1 << MBEDTLS_SSL_SESSION_TICKETS_TLS1_2_BIT)\0A#define MBEDTLS_SSL_SESSION_TICKETS_TLS1_3_MASK \5C\0A    (1 << MBEDTLS_SSL_SESSION_TICKETS_TLS1_3_BIT)\0A\0A#if defined(MBEDTLS_SSL_PROTO_TLS1_2)\0Astatic inline int mbedtls_ssl_conf_get_session_tickets(\0A    const mbedtls_ssl_config *conf)\0A{\0A    return conf->session_tickets & MBEDTLS_SSL_SESSION_TICKETS_TLS1_2_MASK ?\0A           MBEDTLS_SSL_SESSION_TICKETS_ENABLED :\0A           MBEDTLS_SSL_SESSION_TICKETS_DISABLED;\0A}\0A#endif /* MBEDTLS_SSL_PROTO_TLS1_2 */\0A\0A#if defined(MBEDTLS_SSL_PROTO_TLS1_3)\0Astatic inline int mbedtls_ssl_conf_is_signal_new_session_tickets_enabled(\0A    const mbedtls_ssl_config *conf)\0A{\0A    return conf->session_tickets & MBEDTLS_SSL_SESSION_TICKETS_TLS1_3_MASK ?\0A           MBEDTLS_SSL_TLS1_3_SIGNAL_NEW_SESSION_TICKETS_ENABLED :\0A           MBEDTLS_SSL_TLS1_3_SIGNAL_NEW_SESSION_TICKETS_DISABLED;\0A}\0A#endif /* MBEDTLS_SSL_PROTO_TLS1_3 */\0A#endif /* MBEDTLS_SSL_SESSION_TICKETS && MBEDTLS_SSL_CLI_C */\0A\0A#if defined(MBEDTLS_SSL_CLI_C) && defined(MBEDTLS_SSL_PROTO_TLS1_3)\0Aint mbedtls_ssl_tls13_finalize_client_hello(mbedtls_ssl_context *ssl);\0A#endif\0A\0A#if defined(MBEDTLS_TEST_HOOKS) && defined(MBEDTLS_SSL_SOME_SUITES_USE_MAC)\0A\0A/** Compute the HMAC of variable-length data with constant flow.\0A *\0A * This function computes the HMAC of the concatenation of \5Cp add_data and \5Cp\0A * data, and does with a code flow and memory access pattern that does not\0A * depend on \5Cp data_len_secret, but only on \5Cp min_data_len and \5Cp\0A * max_data_len. In particular, this function always reads exactly \5Cp\0A * max_data_len bytes from \5Cp data.\0A *\0A * \5Cparam ctx               The HMAC context. It must have keys configured\0A *                          with mbedtls_md_hmac_starts() and use one of the\0A *                          following hashes: SHA-384, SHA-256, SHA-1 or MD-5.\0A *                          It is reset using mbedtls_md_hmac_reset() after\0A *                          the computation is complete to prepare for the\0A *                          next computation.\0A * \5Cparam add_data          The first part of the message whose HMAC is being\0A *                          calculated. This must point to a readable buffer\0A *                          of \5Cp add_data_len bytes.\0A * \5Cparam add_data_len      The length of \5Cp add_data in bytes.\0A * \5Cparam data              The buffer containing the second part of the\0A *                          message. This must point to a readable buffer\0A *                          of \5Cp max_data_len bytes.\0A * \5Cparam data_len_secret   The length of the data to process in \5Cp data.\0A *                          This must be no less than \5Cp min_data_len and no\0A *                          greater than \5Cp max_data_len.\0A * \5Cparam min_data_len      The minimal length of the second part of the\0A *                          message, read from \5Cp data.\0A * \5Cparam max_data_len      The maximal length of the second part of the\0A *                          message, read from \5Cp data.\0A * \5Cparam output            The HMAC will be written here. This must point to\0A *                          a writable buffer of sufficient size to hold the\0A *                          HMAC value.\0A *\0A * \5Cretval 0 on success.\0A * \5Cretval #MBEDTLS_ERR_PLATFORM_HW_ACCEL_FAILED\0A *         The hardware accelerator failed.\0A */\0A#if defined(MBEDTLS_USE_PSA_CRYPTO)\0Aint mbedtls_ct_hmac(mbedtls_svc_key_id_t key,\0A                    psa_algorithm_t mac_alg,\0A                    const unsigned char *add_data,\0A                    size_t add_data_len,\0A                    const unsigned char *data,\0A                    size_t data_len_secret,\0A                    size_t min_data_len,\0A                    size_t max_data_len,\0A                    unsigned char *output);\0A#else\0Aint mbedtls_ct_hmac(mbedtls_md_context_t *ctx,\0A                    const unsigned char *add_data,\0A                    size_t add_data_len,\0A                    const unsigned char *data,\0A                    size_t data_len_secret,\0A                    size_t min_data_len,\0A                    size_t max_data_len,\0A                    unsigned char *output);\0A#endif /* defined(MBEDTLS_USE_PSA_CRYPTO) */\0A#endif /* MBEDTLS_TEST_HOOKS && defined(MBEDTLS_SSL_SOME_SUITES_USE_MAC) */\0A\0A#endif /* ssl_misc.h */\0A\00" }
