@.str41992 = private global { i64, i64, [37512 x i8] } { i64 -1, i64 37511, [37512 x i8] c"/*\0A *  FIPS-180-2 compliant SHA-384/512 implementation\0A *\0A *  Copyright The Mbed TLS Contributors\0A *  SPDX-License-Identifier: Apache-2.0 OR GPL-2.0-or-later\0A */\0A/*\0A *  The SHA-512 Secure Hash Standard was published by NIST in 2002.\0A *\0A *  http://csrc.nist.gov/publications/fips/fips180-2/fips180-2.pdf\0A */\0A\0A#if defined(__aarch64__) && !defined(__ARM_FEATURE_SHA512) && \5C\0A    defined(__clang__) && __clang_major__ >= 7\0A/* TODO: Re-consider above after https://reviews.llvm.org/D131064 merged.\0A *\0A * The intrinsic declaration are guarded by predefined ACLE macros in clang:\0A * these are normally only enabled by the -march option on the command line.\0A * By defining the macros ourselves we gain access to those declarations without\0A * requiring -march on the command line.\0A *\0A * `arm_neon.h` is included by common.h, so we put these defines\0A * at the top of this file, before any includes.\0A */\0A#define __ARM_FEATURE_SHA512 1\0A#define MBEDTLS_ENABLE_ARM_SHA3_EXTENSIONS_COMPILER_FLAG\0A#endif\0A\0A#include \22common.h\22\0A\0A#if defined(MBEDTLS_SHA512_C) || defined(MBEDTLS_SHA384_C)\0A\0A#include \22mbedtls/sha512.h\22\0A#include \22mbedtls/platform_util.h\22\0A#include \22mbedtls/error.h\22\0A\0A#if defined(_MSC_VER) || defined(__WATCOMC__)\0A  #define UL64(x) x##ui64\0A#else\0A  #define UL64(x) x##ULL\0A#endif\0A\0A#include <string.h>\0A\0A#include \22mbedtls/platform.h\22\0A\0A#if defined(__aarch64__)\0A#  if defined(MBEDTLS_SHA512_USE_A64_CRYPTO_IF_PRESENT) || \5C\0A    defined(MBEDTLS_SHA512_USE_A64_CRYPTO_ONLY)\0A/* *INDENT-OFF* */\0A#   if !defined(MBEDTLS_HAVE_NEON_INTRINSICS)\0A#       error \22Target does not support NEON instructions\22\0A#   endif\0A/*\0A * Best performance comes from most recent compilers, with intrinsics and -O3.\0A * Must compile with -march=armv8.2-a+sha3, but we can't detect armv8.2-a, and\0A * can't always d