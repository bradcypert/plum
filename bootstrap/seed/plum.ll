@.str56418 = private global { i64, i64, [40119 x i8] } { i64 -1, i64 40118, [40119 x i8] c"/// One header. `name` is as it appeared on the wire; header names are\0A/// case-insensitive in HTTP, so compare with care.\0Apub struct Header { pub name: String, pub value: String }\0A/// A complete response: status, headers, and the whole body as raw bytes.\0A/// Use Response.text to decode UTF-8 explicitly.\0Apub struct Response { pub status: Int, pub headers: Array[Header], pub body: Bytes }\0A/// A response's head, before the body has been read.\0A///\0A/// `leftover_body` is whatever arrived in the same read as the headers\0A/// — a body does not begin on a tidy packet boundary, so those bytes\0A/// have to be handed on rather than dropped.\0Apub struct Head { pub status: Int, pub headers: Array[Header], pub leftover_body: Bytes }\0A/// An incoming request, with its body preserved as raw bytes.\0A/// Use Request.text to decode UTF-8 explicitly.\0Apub struct Request { pub method: String, pub path: String, pub headers: Array[Header], pub body: Bytes }\0A/// A request's first line, split.\0Apub struct RequestLine { pub method: String, pub path: String }\0A/// A request's head, before its body has been read. `leftover_body`\0A/// carries the bytes that arrived alongside the headers.\0Apub struct RequestHead { pub method: String, pub path: String, pub headers: Array[Header], pub leftover_body: Bytes }\0A\0Aextern \22C\22 {\0A    fn tls_connect(host: CStr, port: Int) -> Int;\0A    fn tls_send(handle: Int, buf: CStr, len: Int) -> Int;\0A    fn tls_recv_n(handle: Int, max_len: Int) -> Int;\0A    fn tls_recv_data() -> CStr;\0A    fn tls_close(handle: Int) -> Unit;\0A}\0A\0A// Keep transport policy in one place: explicit byte counts, clean EOF,\0A// and errors have identical meanings for plain TCP and TLS.\0Alet http_read (fd: Int) (secure: Int) (max_len: Int): Result[Bytes, String] =\0A    if secure == 0 { Net.read_bytes(fd, max_len) }\0A    else { unsafe {\0A        let n = tls_recv_n(fd, max_len);\0A        if n < 0 { Err(\22https client: read failed\22) }\0A        else { Ok(Bytes.from_cstr(tls_recv_data(), n)) }\0A    } }\0A\0Alet http_write (fd: Int) (secure: Int) (data: Bytes): Result[Int, String] =\0A    if secure == 0 { Net.write_bytes(fd, data) }\0A    else { unsafe {\0A        let len = data.len();\0A        let n = tls_send(fd, data.as_cstr(), len);\0A        if n < 0 { Err(\22https client: write failed\22) } else { Ok(n) }\0A    } }\0A\0A// Bytes.slice copies. Slice only a bounded chunk, never the whole unsent\0A// suffix, so repeated short writes do not copy the body quadratically.\0Alet http_write_all (fd: Int) (secure: Int) (data: Bytes) (offset: Int): Result[Unit, String] =\0A    if offset >= data.len() { Ok(()) }\0A    else {\0A        let end = offset + Int.min(16384, data.len() - offset);\0A        match http_write(fd, secure, data.slice(offset, end)) {\0A            Err(e) => Err(e),\0A            Ok(n) => if n <= 0 || n > end - offset { Err(\22http: write made invalid progress\22) }\0A                else { http_write_all(fd, secure, data, offset + n) },\0A        }\0A    }\0A\0A// Serialize only the head. Keep the body as its existing RC buffer rather\0A// than allocating another whole-body copy just to prepend HTTP metadata.\0Astruct HttpWire { head: Bytes, body: Bytes }\0Alet http_send (fd: Int) (secure: Int) (wire: HttpWire): Result[Unit, String] =\0A    http_write_all(fd, secure, wire.head, 0)\0A        |> Result.and_then(_, |ignored| http_write_all(fd, secure, wire.body, 0))\0A\0A/// Decodes the request body as UTF-8. Invalid UTF-8 returns Err; the raw\0A/// body remains available as Bytes. No Content-Type or charset conversion\0A/// is inferred, and valid text shares the body's reference-counted storage.\0Apub let Request.text (req: Request): Result[String, String] = req.body.as_string()\0A\0A/// Decodes the response body as UTF-8, returning Err for invalid text.\0A/// This validates without copying the payload