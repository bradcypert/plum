@.str40712 = private global { i64, i64, [5211 x i8] } { i64 -1, i64 5210, [5211 x i8] c"/**\0A * \5Cfile hkdf.h\0A *\0A * \5Cbrief   This file contains the HKDF interface.\0A *\0A *          The HMAC-based Extract-and-Expand Key Derivation Function (HKDF) is\0A *          specified by RFC 5869.\0A */\0A/*\0A *  Copyright The Mbed TLS Contributors\0A *  SPDX-License-Identifier: Apache-2.0 OR GPL-2.0-or-later\0A */\0A#ifndef MBEDTLS_HKDF_H\0A#define MBEDTLS_HKDF_H\0A\0A#include \22mbedtls/build_info.h\22\0A\0A#include \22mbedtls/md.h\22\0A\0A/**\0A *  \5Cname HKDF Error codes\0A *  \5C{\0A */\0A/** Bad input parameters to function. */\0A#define MBEDTLS_ERR_HKDF_BAD_INPUT_DATA  -0x5F80\0A/** \5C} name */\0A\0A#ifdef __cplusplus\0Aextern \22C\22 {\0A#endif\0A\0A/**\0A *  \5Cbrief  This is the HMAC-based Extract-and-Expand Key Derivation Function\0A *          (HKDF).\0A *\0A *  \5Cparam  md        A hash function; md.size denotes the length of the hash\0A *                    function output in bytes.\0A *  \5Cparam  salt      An optional salt value (a non-secret random value);\0A *                    if the salt is not provided, a string of all zeros of\0A *                    md.size length is used as the salt.\0A *  \5Cparam  salt_len  The length in bytes of the optional \5Cp salt.\0A *  \5Cparam  ikm       The input keying material.\0A *  \5Cparam  ikm_len   The length in bytes of \5Cp ikm.\0A *  \5Cparam  info      An optional context and application specific information\0A *                    string. This can be a zero-length string.\0A *  \5Cparam  info_len  The length of \5Cp info in bytes.\0A *  \5Cparam  okm       The output keying material of \5Cp okm_len bytes.\0A *  \5Cparam  okm_len   The length of the output keying material in bytes. This\0A *                    must be less than or equal to 255 * md.size bytes.\0A *\0A *  \5Creturn 0 on success.\0A *  \5Creturn #MBEDTLS_ERR_HKDF_BAD_INPUT_DATA when the parameters are invalid.\0A *  \5Creturn An MBEDTLS_ERR_MD_* error for errors returned from the underlying\0A *          MD layer.\0A */\0Aint mbedtls_hkdf(const mbedtls_md_info_t *md, const unsigned char *salt,\0A                 size_t salt_len, const unsigned char *ikm, size_t ikm_len,\0A                 const unsigned char *info, size_t info_len,\0A                 unsigned char *okm, size_t okm_len);\0A\0A/**\0A *  \5Cbrief  Take the input keying material \5Cp ikm and extract from it a\0A *          fixed-length pseudorandom key \5Cp prk.\0A *\0A *  \5Cwarning    This function should only be used if the security of it has been\0A *              studied and established in that particular context (eg. TLS 1.3\0A *              key schedule). For standard HKDF security guarantees use\0A *              \5Cc mbedtls_hkdf instead.\0A *\0A *  \5Cparam       md        A hash function; md.size denotes the length of the\0A *                         hash function output in bytes.\0A *  \5Cparam       salt      An optional salt value (a non-secret random value);\0A *                         if the salt is not provided, a string of all zeros\0A *                         of md.size length is used as the salt.\0A *  \5Cparam       salt_len  The length in bytes of the optional \5Cp salt.\0A *  \5Cparam       ikm       The input keying material.\0A *  \5Cparam       ikm_len   The length in bytes of \5Cp ikm.\0A *  \5Cparam[out]  prk       A pseudorandom key of at least md.size bytes.\0A *\0A *  \5Creturn 0 on success.\0A *  \5Creturn #MBEDTLS_ERR_HKDF_BAD_INPUT_DATA when the parameters are invalid.\0A *  \5Creturn An MBEDTLS_ERR_MD_* error for errors returned from the underlying\0A *          MD layer.\0A */\0Aint mbedtls_hkdf_extract(const mbedtls_md_info_t *md,\0A                         const unsigned char *salt, size_t salt_len,\0A                         const unsigned char *ikm, size_t ikm_len,\0A                         unsigned char *prk);\0A\0A/**\0A *  \5Cbrief  Expand the supplied \5Cp prk into several additional pseudorandom\0A *          keys, which is the output of the HKDF.\0A *\0A *  \5Cwarning    This function should only be used if the security of it has been\0A *              studied and established in that particular context (eg. TLS 1.3\0A *              key schedule). For standard HKDF security guarantees use\0A *              \5Cc mbedtls_hkdf instead.\0A *\0A *  \5Cparam  md        A hash function; md.size denotes the length of the hash\0A *                    function output in bytes.\0A *  \5Cparam  prk       A pseudorandom key of at least md.size bytes. \5Cp prk is\0A *                    usually the output from the HKDF extract step.\0A *  \5Cparam  prk_len   The length in bytes of \5Cp prk.\0A *  \5Cparam  info      An optional context and application specific information\0A *                    string. This can be a zero-length string.\0A *  \5Cparam  info_len  The length of \5Cp info in bytes.\0A *  \5Cparam  okm       The output keying material of \5Cp okm_len bytes.\0A *  \5Cparam  okm_len   The length of the output keying material in bytes. This\0A *                    must be less than or equal to 255 * md.size bytes.\0A *\0A *  \5Creturn 0 on success.\0A *  \5Creturn #MBEDTLS_ERR_HKDF_BAD_INPUT_DATA when the parameters are invalid.\0A *  \5Creturn An MBEDTLS_ERR_MD_* error for errors returned from the underlying\0A *          MD layer.\0A */\0Aint mbedtls_hkdf_expand(const mbedtls_md_info_t *md, const unsigned char *prk,\0A                        size_t prk_len, const unsigned char *info,\0A                        size_t info_len, unsigned char *okm, size_t okm_len);\0A\0A#ifdef __cplusplus\0A}\0A#endif\0A\0A#endif /* hkdf.h */\0A\00" }
