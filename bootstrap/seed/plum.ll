;\0A    }\0A\0A    if (ctx->pk_info == NULL || pk_hashlen_helper(md_alg, &hash_len) != 0) {\0A        return MBEDTLS_ERR_PK_BAD_INPUT_DATA;\0A    }\0A\0A#if defined(MBEDTLS_ECDSA_C) && defined(MBEDTLS_ECP_RESTARTABLE)\0A    /* optimization: use non-restartable version if restart disabled */\0A    if (rs_ctx != NULL &&\0A        mbedtls_ecp_restart_is_enabled() &&\0A        ctx->pk_info->sign_rs_func != NULL) {\0A        int ret = MBEDTLS_ERR_ERROR_CORRUPTION_DETECTED;\0A\0A        if ((ret = pk_restart_setup(rs_ctx, ctx->pk_info)) != 0) {\0A            return ret;\0A        }\0A\0A        ret = ctx->pk_info->sign_rs_func(ctx, md_alg,\0A                                         hash, hash_len,\0A                                         sig, sig_size, sig_len,\0A                                         f_rng, p_rng, rs_ctx->rs_ctx);\0A\0A        if (ret != MBEDTLS_ERR_ECP_IN_PROGRESS) {\0A            mbedtls_pk_restart_free(rs_ctx);\0A        }\0A\0A        return ret;\0A    }\0A#else /* MBEDTLS_ECDSA_C && MBEDTLS_ECP_RESTARTABLE */\0A    (void) rs_ctx;\0A#endif /* MBEDTLS_ECDSA_C && MBEDTLS_ECP_RESTARTABLE */\0A\0A    if (ctx->pk_info->sign_func == NULL) {\0A        return MBEDTLS_ERR_PK_TYPE_MISMATCH;\0A    }\0A\0A    return ctx->pk_info->sign_func(ctx, md_alg,\0A                                   hash, hash_len,\0A                                   sig, sig_size, sig_len,\0A                                   f_rng, p_rng);\0A}\0A\0A/*\0A * Make a signature\0A */\0Aint mbedtls_pk_sign(mbedtls_pk_context *ctx, mbedtls_md_type_t md_alg,\0A                    const unsigned char *hash, size_t hash_len,\0A                    unsigned char *sig, size_t sig_size, size_t *sig_len,\0A                    int (*f_rng)(void *, unsigned char *, size_t), void *p_rng)\0A{\0A    return mbedtls_pk_sign_restartable(ctx, md_alg, hash, hash_len,\0A                                       sig, sig_size, sig_len,\0A                                       f_rng, p_rng, NULL);\0A}\0A\0A/*\0A 