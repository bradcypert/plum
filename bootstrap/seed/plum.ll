@.str40766 = private global { i64, i64, [12872 x i8] } { i64 -1, i64 12871, [12872 x i8] c"/*\0A *  PSA ECP layer on top of Mbed TLS crypto\0A */\0A/*\0A *  Copyright The Mbed TLS Contributors\0A *  SPDX-License-Identifier: Apache-2.0 OR GPL-2.0-or-later\0A */\0A\0A#ifndef PSA_CRYPTO_ECP_H\0A#define PSA_CRYPTO_ECP_H\0A\0A#include <psa/crypto.h>\0A#include <mbedtls/ecp.h>\0A\0A/** Load the contents of a key buffer into an internal ECP representation\0A *\0A * \5Cparam[in] type          The type of key contained in \5Cp data.\0A * \5Cparam[in] curve_bits    The nominal bit-size of the curve.\0A *                          It must be consistent with the representation\0A *                          passed in \5Cp data.\0A *                          This can be 0, in which case the bit-size\0A *                          is inferred from \5Cp data_length (which is possible\0A *                          for all key types and representation formats\0A *                          formats that are currently supported or will\0A *                          be in the foreseeable future).\0A * \5Cparam[in] data          The buffer from which to load the representation.\0A * \5Cparam[in] data_length   The size in bytes of \5Cp data.\0A * \5Cparam[out] p_ecp        Returns a pointer to an ECP context on success.\0A *                          The caller is responsible for freeing both the\0A *                          contents of the context and the context itself\0A *                          when done.\0A */\0Apsa_status_t mbedtls_psa_ecp_load_representation(psa_key_type_t type,\0A                                                 size_t curve_bits,\0A                                                 const uint8_t *data,\0A                                                 size_t data_length,\0A                                                 mbedtls_ecp_keypair **p_ecp);\0A\0A/** Load the public part of an internal ECP, if required.\0A *\0A * \5Cparam ecp               The ECP context to load the public part for.\0A *\0A * \5Creturn PSA_SUCCESS on success, otherwise an MPI error.\0A */\0A\0Apsa_status_t mbedtls_psa_ecp_load_public_part(mbedtls_ecp_keypair *ecp);\0A\0A/** Import an ECP key in binary format.\0A *\0A * \5Cnote The signature of this function is that of a PSA driver\0A *       import_key entry point. This function behaves as an import_key\0A *       entry point as defined in the PSA driver interface specification for\0A *       transparent drivers.\0A *\0A * \5Cparam[in]  attributes       The attributes for the key to import.\0A * \5Cparam[in]  data             The buffer containing the key data in import\0A *                              format.\0A * \5Cparam[in]  data_length      Size of the \5Cp data buffer in bytes.\0A * \5Cparam[out] key_buffer       The buffer containing the key data in output\0A *                              format.\0A * \5Cparam[in]  key_buffer_size  Size of the \5Cp key_buffer buffer in bytes. This\0A *                              size is greater or equal to \5Cp data_length.\0A * \5Cparam[out] key_buffer_length  The length of the data written in \5Cp\0A *                                key_buffer in bytes.\0A * \5Cparam[out] bits             The key size in number of bits.\0A *\0A * \5Cretval #PSA_SUCCESS  The ECP key was imported successfully.\0A * \5Cretval #PSA_ERROR_INVALID_ARGUMENT\0A *         The key data is not correctly formatted.\0A * \5Cretval #PSA_ERROR_NOT_SUPPORTED \5Cemptydescription\0A * \5Cretval #PSA_ERROR_INSUFFICIENT_MEMORY \5Cemptydescription\0A * \5Cretval #PSA_ERROR_CORRUPTION_DETECTED \5Cemptydescription\0A */\0Apsa_status_t mbedtls_psa_ecp_import_key(\0A    const psa_key_attributes_t *attributes,\0A    const uint8_t *data, size_t data_length,\0A    uint8_t *key_buffer, size_t key_buffer_size,\0A    size_t *key_buffer_length, size_t *bits);\0A\0A/** Export an ECP key to export representation\0A *\0A * \5Cparam[in] type          The type of key (public/private) to export\0A * \5Cparam[in] ecp           The internal ECP representation from which to export\0A * \5Cparam[out] data         The buffer to export to\0A * \5Cparam[in] data_size     The length of the buffer to export to\0A * \5Cparam[out] data_length  The amount of bytes written to \5Cp data\0A */\0Apsa_status_t mbedtls_psa_ecp_export_key(psa_key_type_t type,\0A                                        mbedtls_ecp_keypair *ecp,\0A                                        uint8_t *data,\0A                                        size_t data_size,\0A                                        size_t *data_length);\0A\0A/** Export an ECP public key or the public part of an ECP key pair in binary\0A *  format.\0A *\0A * \5Cnote The signature of this function is that of a PSA driver\0A *       export_public_key entry point. This function behaves as an\0A *       export_public_key entry point as defined in the PSA driver interface\0A *       specification.\0A *\0A * \5Cparam[in]  attributes       The attributes for the key to export.\0A * \5Cparam[in]  key_buffer       Material or context of the key to export.\0A * \5Cparam[in]  key_buffer_size  Size of the \5Cp key_buffer buffer in bytes.\0A * \5Cparam[out] data             Buffer where the key data is to be written.\0A * \5Cparam[in]  data_size        Size of the \5Cp data buffer in bytes.\0A * \5Cparam[out] data_length      On success, the number of bytes written in\0A *                              \5Cp data\0A *\0A * \5Cretval #PSA_SUCCESS  The ECP public key was exported successfully.\0A * \5Cretval #PSA_ERROR_NOT_SUPPORTED \5Cemptydescription\0A * \5Cretval #PSA_ERROR_COMMUNICATION_FAILURE \5Cemptydescription\0A * \5Cretval #PSA_ERROR_HARDWARE_FAILURE \5Cemptydescription\0A * \5Cretval #PSA_ERROR_CORRUPTION_DETECTED \5Cemptydescription\0A * \5Cretval #PSA_ERROR_STORAGE_FAILURE \5Cemptydescription\0A * \5Cretval #PSA_ERROR_INSUFFICIENT_MEMORY \5Cemptydescription\0A */\0Apsa_status_t mbedtls_psa_ecp_export_public_key(\0A    const psa_key_attributes_t *attributes,\0A    const uint8_t *key_buffer, size_t key_buffer_size,\0A    uint8_t *data, size_t data_size, size_t *data_length);\0A\0A/**\0A * \5Cbrief Generate an ECP key.\0A *\0A * \5Cnote The signature of the function is that of a PSA driver generate_key\0A *       entry point.\0A *\0A * \5Cparam[in]  attributes         The attributes for the ECP key to generate.\0A * \5Cparam[out] key_buffer         Buffer where the key data is to be written.\0A * \5Cparam[in]  key_buffer_size    Size of \5Cp key_buffer in bytes.\0A * \5Cparam[out] key_buffer_length  On success, the number of bytes written in\0A *                                \5Cp key_buffer.\0A *\0A * \5Cretval #PSA_SUCCESS\0A *         The key was successfully generated.\0A * \5Cretval #PSA_ERROR_NOT_SUPPORTED\0A *         Key length or type not supported.\0A * \5Cretval #PSA_ERROR_BUFFER_TOO_SMALL\0A *         The size of \5Cp key_buffer is too small.\0A */\0Apsa_status_t mbedtls_psa_ecp_generate_key(\0A    const psa_key_attributes_t *attributes,\0A    uint8_t *key_buffer, size_t key_buffer_size, size_t *key_buffer_length);\0A\0A/** Sign an already-calculated hash with ECDSA.\0A *\0A * \5Cnote The signature of this function is that of a PSA driver\0A *       sign_hash entry point. This function behaves as a sign_hash\0A *       entry point as defined in the PSA driver interface specification for\0A *       transparent drivers.\0A *\0A * \5Cparam[in]  attributes       The attributes of the ECC key to use for the\0A *                              operation.\0A * \5Cparam[in]  key_buffer       The buffer containing the ECC key context.\0A *                              format.\0A * \5Cparam[in]  key_buffer_size  Size of the \5Cp key_buffer buffer in bytes.\0A * \5Cparam[in]  alg              Randomized or deterministic ECDSA algorithm.\0A * \5Cparam[in]  hash             The hash or message to sign.\0A * \5Cparam[in]  hash_length      Size of the \5Cp hash buffer in bytes.\0A * \5Cparam[out] signature        Buffer where the signature is to be written.\0A * \5Cparam[in]  signature_size   Size of the \5Cp signature buffer in bytes.\0A * \5Cparam[out] signature_length On success, the number of bytes\0A *                              that make up the returned signature value.\0A *\0A * \5Cretval #PSA_SUCCESS \5Cemptydescription\0A * \5Cretval #PSA_ERROR_BUFFER_TOO_SMALL\0A *         The size of the \5Cp signature buffer is too small. You can\0A *         determine a sufficient buffer size by calling\0A *         #PSA_SIGN_OUTPUT_SIZE(\5Cc PSA_KEY_TYPE_ECC_KEY_PAIR, \5Cc key_bits,\0A *         \5Cp alg) where \5Cc key_bits is the bit-size of the ECC key.\0A * \5Cretval #PSA_ERROR_NOT_SUPPORTED \5Cemptydescription\0A * \5Cretval #PSA_ERROR_INVALID_ARGUMENT \5Cemptydescription\0A * \5Cretval #PSA_ERROR_INSUFFICIENT_MEMORY \5Cemptydescription\0A * \5Cretval #PSA_ERROR_CORRUPTION_DETECTED \5Cemptydescription\0A * \5Cretval #PSA_ERROR_INSUFFICIENT_ENTROPY \5Cemptydescription\0A */\0Apsa_status_t mbedtls_psa_ecdsa_sign_hash(\0A    const psa_key_attributes_t *attributes,\0A    const uint8_t *key_buffer, size_t key_buffer_size,\0A    psa_algorithm_t alg, const uint8_t *hash, size_t hash_length,\0A    uint8_t *signature, size_t signature_size, size_t *signature_length);\0A\0A/**\0A * \5Cbrief Verify an ECDSA hash or short message signature.\0A *\0A * \5Cnote The signature of this function is that of a PSA driver\0A *       verify_hash entry point. This function behaves as a verify_hash\0A *       entry point as defined in the PSA driver interface specification for\0A *       transparent drivers.\0A *\0A * \5Cparam[in]  attributes       The attributes of the ECC key to use for the\0A *                              operation.\0A * \5Cparam[in]  key_buffer       The buffer containing the ECC key context.\0A *                              format.\0A * \5Cparam[in]  key_buffer_size  Size of the \5Cp key_buffer buffer in bytes.\0A * \5Cparam[in]  alg              Randomized or deterministic ECDSA algorithm.\0A * \5Cparam[in]  hash             The hash or message whose signature is to be\0A *                              verified.\0A * \5Cparam[in]  hash_length      Size of the \5Cp hash buffer in bytes.\0A * \5Cparam[in]  signature        Buffer containing the signature to verify.\0A * \5Cparam[in]  signature_length Size of the \5Cp signature buffer in bytes.\0A *\0A * \5Cretval #PSA_SUCCESS\0A *         The signature is valid.\0A * \5Cretval #PSA_ERROR_INVALID_SIGNATURE\0A *         The calculation was performed successfully, but the passed\0A *         signature is not a valid signature.\0A * \5Cretval #PSA_ERROR_NOT_SUPPORTED \5Cemptydescription\0A * \5Cretval #PSA_ERROR_INVALID_ARGUMENT \5Cemptydescription\0A * \5Cretval #PSA_ERROR_INSUFFICIENT_MEMORY \5Cemptydescription\0A */\0Apsa_status_t mbedtls_psa_ecdsa_verify_hash(\0A    const psa_key_attributes_t *attributes,\0A    const uint8_t *key_buffer, size_t key_buffer_size,\0A    psa_algorithm_t alg, const uint8_t *hash, size_t hash_length,\0A    const uint8_t *signature, size_t signature_length);\0A\0A\0A/** Perform a key agreement and return the raw ECDH shared secret.\0A *\0A * \5Cnote The signature of this function is that of a PSA driver\0A *       key_agreement entry point. This function behaves as a key_agreement\0A *       entry point as defined in the PSA driver interface specification for\0A *       transparent drivers.\0A *\0A * \5Cparam[in]  attributes           The attributes of the key to use for the\0A *                                  operation.\0A * \5Cparam[in]  key_buffer           The buffer containing the private key\0A *                                  context.\0A * \5Cparam[in]  key_buffer_size      Size of the \5Cp key_buffer buffer in\0A *                                  bytes.\0A * \5Cparam[in]  alg                  A key agreement algorithm that is\0A *                                  compatible with the type of the key.\0A * \5Cparam[in]  peer_key             The buffer containing the key context\0A *                                  of the peer's public key.\0A * \5Cparam[in]  peer_key_length      Size of the \5Cp peer_key buffer in\0A *                                  bytes.\0A * \5Cparam[out] shared_secret        The buffer to which the shared secret\0A *                                  is to be written.\0A * \5Cparam[in]  shared_secret_size   Size of the \5Cp shared_secret buffer in\0A *                                  bytes.\0A * \5Cparam[out] shared_secret_length On success, the number of bytes that make\0A *                                  up the returned shared secret.\0A * \5Cretval #PSA_SUCCESS\0A *         Success. Shared secret successfully calculated.\0A * \5Cretval #PSA_ERROR_INVALID_HANDLE \5Cemptydescription\0A * \5Cretval #PSA_ERROR_NOT_PERMITTED \5Cemptydescription\0A * \5Cretval #PSA_ERROR_INVALID_ARGUMENT\0A *         \5Cp alg is not a key agreement algorithm, or\0A *         \5Cp private_key is not compatible with \5Cp alg,\0A *         or \5Cp peer_key is not valid for \5Cp alg or not compatible with\0A *         \5Cp private_key.\0A * \5Cretval #PSA_ERROR_BUFFER_TOO_SMALL\0A *         \5Cp shared_secret_size is too small\0A * \5Cretval #PSA_ERROR_NOT_SUPPORTED\0A *         \5Cp alg is not a supported key agreement algorithm.\0A * \5Cretval #PSA_ERROR_INSUFFICIENT_MEMORY \5Cemptydescription\0A * \5Cretval #PSA_ERROR_CORRUPTION_DETECTED \5Cemptydescription\0A */\0Apsa_status_t mbedtls_psa_key_agreement_ecdh(\0A    const psa_key_attributes_t *attributes,\0A    const uint8_t *key_buffer, size_t key_buffer_size,\0A    psa_algorithm_t alg, const uint8_t *peer_key, size_t peer_key_length,\0A    uint8_t *shared_secret, size_t shared_secret_size,\0A    size_t *shared_secret_length);\0A#endif /* PSA_CRYPTO_ECP_H */\0A\00" }
