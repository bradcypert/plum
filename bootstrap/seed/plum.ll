link[0] = 0; dir->kind = 0;\0A    for (;;) {\0A#if defined(_WIN32)\0A        if (dir->refill) {\0A            FILE_INFO_BY_HANDLE_CLASS kind = dir->first ? FileIdBothDirectoryRestartInfo : FileIdBothDirectoryInfo;\0A            if (!GetFileInformationByHandleEx(dir->entry, kind, dir->entries, sizeof(dir->entries)))\0A                return GetLastError() == ERROR_NO_MORE_FILES ? 0 : -1;\0A            dir->first = 0; dir->refill = 0; dir->offset = 0;\0A        }\0A        FILE_ID_BOTH_DIR_INFO *item = (FILE_ID_BOTH_DIR_INFO *)(dir->entries + dir->offset);\0A        DWORD bytes = item->FileNameLength, next = item->NextEntryOffset;\0A        if (!bytes || bytes % sizeof(WCHAR) || bytes > sizeof(dir->entries) - dir->offset - offsetof(FILE_ID_BOTH_DIR_INFO, FileName)) return -1;\0A        if (next) {\0A            if (next % 8 || next < offsetof(FILE_ID_BOTH_DIR_INFO, FileName) + bytes ||\0A                next > sizeof(dir->entries) - dir->offset - sizeof(FILE_ID_BOTH_DIR_INFO)) return -1;\0A            dir->offset += next;\0A        } else dir->refill = 1;\0A        WCHAR *name = item->FileName;\0A        if ((bytes == 2 && name[0] == L'.') || (bytes == 4 && name[0] == L'.' && name[1] == L'.')) continue;\0A        int n = WideCharToMultiByte(CP_UTF8, WC_ERR_INVALID_CHARS, name, (int)(bytes / sizeof(WCHAR)),\0A            dir->name, sizeof(dir->name) - 1, NULL, NULL);\0A        if (n <= 0) return -1;\0A        dir->name[n] = 0;\0A        if (!dir->read_links) {\0A            // Enumeration metadata is enough for exclusions; resolve selected\0A            // entries later through the held root, with fresh type checks.\0A            dir->kind = (item->FileAttributes & FILE_ATTRIBUTE_REPARSE_POINT) ? 3 :\0A                (item->FileAttributes & FILE_ATTRIBUTE_DIRECTORY) ? 2 : 1;\0A            return dir->kind;\0A        }\0A        HANDLE child = plum_tree_win_child(dir->entry, name, bytes, FILE_READ_ATTRIBUTES, FILE_OPEN, 0, NULL);\0A        if (child == INVALID_HANDLE_VALUE) return -1;\0A        FILE_ATTRIBUTE_TAG_INFO attrs;\0A        if (plum_tree_win_attrs(child, &attrs)) { CloseHandle(child); return -1; }\0A        if (attrs.FileAttributes & FILE_ATTRIBUTE_REPARSE_POINT) {\0A            WCHAR target[PLUM_PATH_MAX];\0A            if (dir->read_links && (plum_tree_win_link(child, target, PLUM_PATH_MAX, 1) ||\0A                !WideCharToMultiByte(CP_UTF8, WC_ERR_INVALID_CHARS, target, -1, dir->link, sizeof(dir->link), NULL, NULL))) {\0A                CloseHandle(child); return -1;\0A            }\0A            dir->kind = 3;\0A        } else dir->kind = (attrs.FileAttributes & FILE_ATTRIBUTE_DIRECTORY) ? 2 : 1;\0A        if (!CloseHandle(child)) return -1;\0A#else\0A        errno = 0;\0A        struct dirent *item = readdir(dir->stream);\0A        if (!item) return errno ? -1 : 0;\0A        if (!strcmp(item->d_name, \22.\22) || !strcmp(item->d_name, \22..\22)) continue;\0A        size_t n = strlen(item->d_name);\0A        if (n >= sizeof(dir->name)) return -1;\0A        memcpy(dir->name, item->d_name, n + 1);\0A        struct stat st;\0A        int parent = dirfd(dir->stream);\0A        if (fstatat(parent, dir->name, &st, AT_SYMLINK_NOFOLLOW)) return -1;\0A        dir->kind = S_ISREG(st.st_mode) ? 1 : S_ISDIR(st.st_mode) ? 2 : S_ISLNK(st.st_mode) ? 3 : 4;\0A        if (dir->kind == 3 && dir->read_links) {\0A            ssize_t count = readlinkat(parent, dir->name, dir->link, sizeof(dir->link));\0A            if (count < 0 || (size_t)count >= sizeof(dir->link)) return -1;\0A            dir->link[count] = 0;\0A            struct stat after;\0A            if (fstatat(parent, dir->name, &after, AT_SYMLINK_NOFOLLOW) || !plum_copy_same(&st, &after)) return -1;\0A        }\0A#endif\0A        return dir->kind;\0A    }\0A}\0Aconst char *plum_tree_dir_name(long long handle) {\0A    plum_tree_directory *dir = (plum_tree_directory *)(intptr_t)handle;\0A    return dir ? dir->name : \22\22;\0A}\0Aconst char *plum_tree_dir_link(long long handle) {\0A    plum_tree_directory *dir = (plum_tree_directory *)(intptr_t)handle;\0A    return dir ? dir->link : \22\22;\0A}\0Avoid plum_tree_dir_close(long long handle) {\0A    plum_tree_directory *dir = (plum_tree_directory *)(intptr_t)handle;\0A    if (!dir) return;\0A#if defined(_WIN32)\0A    CloseHandle(dir->entry);\0A#else\0A    closedir(dir->stream);\0A#endif\0A    free(dir);\0A}\0A\0Along long os_copy_tree(const char *src, const char *dst) {\0A    return plum_copy_tree(src, dst) == 0 ? 0 : -1;\0A}\0A\0A// --- File metadata (issue #24) ---\0A//\0A// `stat(2)`, the rest of it. `path_is_dir` in `dir_shim.c` was the first\0A// caller and stays where it is; these are its siblings, here because\0A// this is the filesystem shim.\0A//\0A// Loaded into a thread-local record and then read field by field, so\0A// `Os.stat` costs ONE `stat` rather than one per field. Plum's extern\0A// surface has no multi-value return, which is the same constraint\0A// `tcp_recv_n`/`tcp_recv_data` and `file_read_n`/`file_read_data` work\0A// around the same way.\0A//\0A// Thread-local rather than plain static: `net_shim.c` learned what a\0A// shared buffer costs when two threads use it at once, and a per-thread\0A// record is cheap enough not to repeat that.\0A#include <errno.h>\0A#include <time.h>\0A\0Astatic PLUM_OS_TLS long long stat_size = 0;\0Astatic PLUM_OS_TLS long long stat_mtime = 0;\0Astatic PLUM_OS_TLS long long stat_is_dir = 0;\0A\0A// 0 on success, -1 if the path cannot be stat'ed at all (most commonly\0A// because it is not there). Follows symlinks, matching `path_is_dir`.\0Along long os_stat_load(const char *path) {\0A    struct stat st;\0A    if (stat(path, &st) != 0) {\0A        stat_size = 0;\0A        stat_mtime = 0;\0A        stat_is_dir = 0;\0A        return -1;\0A    }\0A    stat_size = (long long)st.st_size;\0A    stat_mtime = (long long)st.st_mtime;\0A    stat_is_dir = S_ISDIR(st.st_mode) ? 1 : 0;\0A    return 0;\0A}\0A\0Along long os_stat_size(void) { return stat_size; }\0Along long os_stat_mtime(void) { return stat_mtime; }\0Along long os_stat_is_dir(void) { return stat_is_dir; }\0A\0A// Retention is best effort and runs after compilation. Only complete hash\0A// entries are eviction candidates; staging is protected by its live owner.\0A// Cache roots must be private to this host/user (not a shared network store).\0Atypedef struct { char *path; uint64_t bytes; time_t age; } plum_cache_entry;\0A\0Astatic int plum_cache_stat_private(const char *path, struct stat *st) {\0A#if defined(_WIN32)\0A    DWORD attrs=GetFileAttributesA(path);\0A    if (attrs == INVALID_FILE_ATTRIBUTES || (attrs & FILE_ATTRIBUTE_REPARSE_POINT)) return -1;\0A    return stat(path,st);\0A#else\0A    return lstat(path,st);\0A#endif\0A}\0A\0Astatic uint64_t plum_cache_tree_bytes(const char *path) {\0A    struct stat st;\0A    if (plum_cache_stat_private(path,&st) != 0) return 0;\0A    if (S_ISREG(st.st_mode)) return st.st_size > 0 ? (uint64_t)st.st_size : 0;\0A    if (!S_ISDIR(st.st_mode)) return 0;\0A    DIR *d=opendir(path); if (!d) return 0;\0A    uint64_t bytes=0; struct dirent *e; char child[PLUM_PATH_MAX];\0A    while ((e=readdir(d)) != NULL) {\0A        if (!strcmp(e->d_name,\22.\22) || !strcmp(e->d_name,\22..\22)) continue;\0A        if (plum_join(child,sizeof(child),path,e->d_name) == 0) bytes+=plum_cache_tree_bytes(child);\0A    }\0A    closedir(d); return bytes;\0A}\0A\0Astatic int plum_cache_owner_gone(const char *path) {\0A    char owner[PLUM_PATH_MAX]; long pid=0;\0A    if (plum_join(owner,sizeof(owner),path,\22.owner\22) != 0) return 0;\0A    FILE *f=fopen(owner,\22r\22); if (!f) return 0;\0A    int parsed=fscanf(f,\22%ld\22,&pid); fclose(f);\0A    if (parsed != 1 || pid <= 0 || pid > 2147483647L) return 0;\0A#if defined(_WIN32)\0A    HANDLE process=OpenProcess(PROCESS_QUERY_LIMITED_INFORMATION,FALSE,(DWORD)pid);\0A    if (!process) return GetLastError() == ERROR_INVALID_PARAMETER;\0A    DWORD code=STILL_ACTIVE;\0A    int gone=GetExitCodeProcess(process,&code) && code != STILL_ACTIVE;\0A    CloseHandle(process); return gone;\0A#else\0A    return kill((pid_t)pid,0) != 0 && errno == ESRCH;\0A#endif\0A}\0A\0Astatic int plum_cache_oldest(const void *a, const void *b) {\0A    const plum_cache_entry *x=a, *y=b;\0A    if (x->age != y->age) return x->age < y->age ? -1 : 1;\0A    return strcmp(x->path,y->path);\0A}\0A\0Along long plum_cache_prune(const char *root, long long limit) {\0A    if (limit < 0) return 0;\0A    const char *kinds[]={\22ir\22,\22obj\22,\22shims\22,\22staging\22};\0A    plum_cache_entry *entries=NULL; size_t count=0, capacity=0;\0A    uint64_t total=0; long long removed=0; time_t now=time(NULL);\0A    char parent[PLUM_PATH_MAX], path[PLUM_PATH_MAX]; struct stat st;\0A    for (size_t k=0;k<sizeof(kinds)/sizeof(kinds[0]);k++) {\0A        if (plum_join(parent,sizeof(parent),root,kinds[k]) != 0\0A            || plum_cache_stat_private(parent,&st) != 0 || !S_ISDIR(st.st_mode)) continue;\0A        DIR *d=opendir(parent); if (!d) continue;\0A        struct dirent *e;\0A        while ((e=readdir(d)) != NULL) {\0A            if (plum_join(path,sizeof(path),parent,e->d_name) != 0\0A                || plum_cache_stat_private(path,&st) != 0 || !S_ISDIR(st.st_mode)) continue;\0A            // Keep recognizing legacy Windows pcb*.tmp staging entries too.\0A            if (!strncmp(e->d_name,\22.partial-\22,9) || !strncmp(e->d_name,\22pcb\22,3)) {\0A                if (now > st.st_mtime && now-st.st_mtime > 86400 && plum_cache_owner_gone(path)) {\0A                    if (plum_remove_tree(path) == 0) removed++;\0A                }\0A                continue;\0A            }\0A            if (strlen(e->d_name) != 64) continue;\0A            int hex=1;\0A            for (size_t i=0;i<64;i++) {\0A                if (!((e->d_name[i]>='0' && e->d_name[i]<='9')\0A                    || (e->d_name[i]>='a' && e->d_name[i]<='f'))) { hex=0; break; }\0A            }\0A            if (!hex) continue;\0A            if (count == capacity) {\0A                size_t next=capacity ? capacity*2 : 32;\0A                plum_cache_entry *grown=realloc(entries,next*sizeof(*entries));\0A                if (!grown) break;\0A                entries=grown; capacity=next;\0A            }\0A            char *saved=strdup(path); if (!saved) break;\0A            uint64_t bytes=plum_cache_tree_bytes(path);\0A            entries[count++]=(plum_cache_entry){saved,bytes,st.st_mtime}; total+=bytes;\0A        }\0A        closedir(d);\0A    }\0A    if (count > 1) qsort(entries,count,sizeof(*entries),plum_cache_oldest);\0A    for (size_t i=0;i<count;i++) {\0A        if (total > (uint64_t)limit && plum_remove_tree(entries[i].path) == 0) {\0A            total=total >= entries[i].bytes ? total-entries[i].bytes : 0; removed++;\0A        }\0A        free(entries[i].path);\0A    }\0A    free(entries); return removed;\0A}\0A\0A// Three-way, and the third case is the point: 1 present, 0 absent, -1\0A// CANNOT SAY.\0A//\0A// \22Does this exist\22 and \22can I see whether this exists\22 are different\0A// questions, and collapsing them is how a permission error becomes a\0A// silent \22no\22. Only `ENOENT` and `ENOTDIR` mean absent -- the latter\0A// because a path under a non-directory (`a/b` where `a` is a file)\0A// cannot exist either. Anything else is a real failure to report.\0Along long os_path_exists(const char *path) {\0A    struct stat st;\0A    if (stat(path, &st) == 0) {\0A        return 1;\0A    }\0A    if (errno == ENOENT || errno == ENOTDIR) {\0A        return 0;\0A    }\0A    return -1;\0A}\0A\0A// --- Working directory (issue #17) ---\0A//\0A// Its own buffer rather than `plum_os_buf`: that one holds the result of\0A// `os_temp_dir`/`os_self_exe`, and a caller holding one of those across\0A// a `cwd()` would silently get the wrong string back.\0Astatic PLUM_OS_TLS char plum_cwd_buf[PLUM_PATH_MAX];\0A\0A// \22\22 on failure, never NULL -- a null `CStr` return is a hard runtime\0A// abort under Plum's FFI semantics, the same trade every other shim\0A// here makes.\0Aconst char *os_cwd(void) {\0A#if defined(_WIN32)\0A    if (_getcwd(plum_cwd_buf, (int)sizeof(plum_cwd_buf)) == NULL) plum_cwd_buf[0] = '\5C0';\0A#else\0A    if (getcwd(plum_cwd_buf, sizeof(plum_cwd_buf)) == NULL) plum_cwd_buf[0] = '\5C0';\0A#endif\0A    return plum_cwd_buf;\0A}\0A\0Along long os_chdir(const char *path) {\0A#if defined(_WIN32)\0A    return _chdir(path) == 0 ? 0 : -1;\0A#else\0A    return chdir(path) == 0 ? 0 : -1;\0A#endif\0A}\0A\00" }
