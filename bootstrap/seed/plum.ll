 }\0A    memset(operation, 0, sizeof(psa_pake_operation_t));\0A\0A    return status;\0A}\0A#endif /* PSA_WANT_ALG_SOME_PAKE */\0A\0A/* Memory copying test hooks. These are called before input copy, after input\0A * copy, before output copy and after output copy, respectively.\0A * They are used by memory-poisoning tests to temporarily unpoison buffers\0A * while they are copied. */\0A#if defined(MBEDTLS_TEST_HOOKS)\0Avoid (*psa_input_pre_copy_hook)(const uint8_t *input, size_t input_len) = NULL;\0Avoid (*psa_input_post_copy_hook)(const uint8_t *input, size_t input_len) = NULL;\0Avoid (*psa_output_pre_copy_hook)(const uint8_t *output, size_t output_len) = NULL;\0Avoid (*psa_output_post_copy_hook)(const uint8_t *output, size_t output_len) = NULL;\0A#endif\0A\0A/** Copy from an input buffer to a local copy.\0A *\0A * \5Cparam[in] input             Pointer to input buffer.\0A * \5Cparam[in] input_len         Length of the input buffer.\0A * \5Cparam[out] input_copy       Pointer to a local copy in which to store the input data.\0A * \5Cparam[out] input_copy_len   Length of the local copy buffer.\0A * \5Creturn                      #PSA_SUCCESS, if the buffer was successfully\0A *                              copied.\0A * \5Creturn                      #PSA_ERROR_CORRUPTION_DETECTED, if the local\0A *                              copy is too small to hold contents of the\0A *                              input buffer.\0A */\0AMBEDTLS_STATIC_TESTABLE\0Apsa_status_t psa_crypto_copy_input(const uint8_t *input, size_t input_len,\0A                                   uint8_t *input_copy, size_t input_copy_len)\0A{\0A    if (input_len > input_copy_len) {\0A        return PSA_ERROR_CORRUPTION_DETECTED;\0A    }\0A\0A#if defined(MBEDTLS_TEST_HOOKS)\0A    if (psa_input_pre_copy_hook != NULL) {\0A        psa_input_pre_copy_hook(input, input_len);\0A    }\0A#endif\0A\0A    if (input_len > 0) {\0A        memcpy(input_copy, input, input_len);\0A    }\0A\0A#if defined(MBEDTLS_TEST_HOOKS)\0A    if (psa_input_post_copy_hook != NULL) {\0A        psa_input_post_copy_hook(input, input_len);\0A    }\0A#endif\0A\0A    return PSA_SUCCESS;\0A}\0A\0A/** Copy from a local output buffer into a user-supplied one.\0A *\0A * \5Cparam[in] output_copy       Pointer to a local buffer containing the output.\0A * \5Cparam[in] output_copy_len   Length of the local buffer.\0A * \5Cparam[out] output           Pointer to user-supplied output buffer.\0A * \5Cparam[out] output_len       Length of the user-supplied output buffer.\0A * \5Creturn                      #PSA_SUCCESS, if the buffer was successfully\0A *                              copied.\0A * \5Creturn                      #PSA_ERROR_BUFFER_TOO_SMALL, if the\0A *                              user-supplied output buffer is too small to\0A *                              hold the contents of the local buffer.\0A */\0AMBEDTLS_STATIC_TESTABLE\0Apsa_status_t psa_crypto_copy_output(const uint8_t *output_copy, size_t output_copy_len,\0A                                    uint8_t *output, size_t output_len)\0A{\0A    if (output_len < output_copy_len) {\0A        return PSA_ERROR_BUFFER_TOO_SMALL;\0A    }\0A\0A#if defined(MBEDTLS_TEST_HOOKS)\0A    if (psa_output_pre_copy_hook != NULL) {\0A        psa_output_pre_copy_hook(output, output_len);\0A    }\0A#endif\0A\0A    if (output_copy_len > 0) {\0A        memcpy(output, output_copy, output_copy_len);\0A    }\0A\0A#if defined(MBEDTLS_TEST_HOOKS)\0A    if (psa_output_post_copy_hook != NULL) {\0A        psa_output_post_copy_hook(output, output_len);\0A    }\0A#endif\0A\0A    return PSA_SUCCESS;\0A}\0A\0Apsa_status_t psa_crypto_local_input_alloc(const uint8_t *input, size_t input_len,\0A                                          psa_crypto_local_input_t *local_input)\0A{\0A    psa_status_t status;\0A\0A    *local_input = PSA_CRYPTO_LOCAL_INPUT_INIT;\0A\0A    if (input_len == 0) {\0A        return PSA_SUCCESS;\0A    }\0A\0A    local_input->buffer = mbedtls_calloc(input_len, 1);\0A    if (local_input->buffer == NULL) {\0A        /* Since we dealt with the zero-length case above, we know that\0A         * a NULL return value means a failure of allocation. */\0A        return PSA_ERROR_INSUFFICIENT_MEMORY;\0A    }\0A    /* From now on, we must free local_input->buffer on error. */\0A\0A    local_input->length = input_len;\0A\0A    status = psa_crypto_copy_input(input, input_len,\0A                                   local_input->buffer, local_input->length);\0A    if (status != PSA_SUCCESS) {\0A        goto error;\0A    }\0A\0A    return PSA_SUCCESS;\0A\0Aerror:\0A    mbedtls_zeroize_and_free(local_input->buffer, local_input->length);\0A    local_input->buffer = NULL;\0A    local_input->length = 0;\0A    return status;\0A}\0A\0Avoid psa_crypto_local_input_free(psa_crypto_local_input_t *local_input)\0A{\0A    mbedtls_zeroize_and_free(local_input->buffer, local_input->length);\0A    local_input->buffer = NULL;\0A    local_input->length = 0;\0A}\0A\0Apsa_status_t psa_crypto_local_output_alloc(uint8_t *output, size_t output_len,\0A                                           psa_crypto_local_output_t *local_output)\0A{\0A    *local_output = PSA_CRYPTO_LOCAL_OUTPUT_INIT;\0A\0A    if (output_len == 0) {\0A        return PSA_SUCCESS;\0A    }\0A    local_output->buffer = mbedtls_calloc(output_len, 1);\0A    if (local_output->buffer == NULL) {\0A        /* Since we dealt with the zero-length case above, we know that\0A         * a NULL return value means a failure of allocation. */\0A        return PSA_ERROR_INSUFFICIENT_MEMORY;\0A    }\0A    local_output->length = output_len;\0A    local_output->original = output;\0A\0A    return PSA_SUCCESS;\0A}\0A\0Apsa_status_t psa_crypto_local_output_free(psa_crypto_local_output_t *local_output)\0A{\0A    psa_status_t status;\0A\0A    if (local_output->buffer == NULL) {\0A        local_output->length = 0;\0A        return PSA_SUCCESS;\0A    }\0A    if (local_output->original == NULL) {\0A        /* We have an internal copy but nothing to copy back to. */\0A        return PSA_ERROR_CORRUPTION_DETECTED;\0A    }\0A\0A    status = psa_crypto_copy_output(local_output->buffer, local_output->length,\0A                                    local_output->original, local_output->length);\0A    if (status != PSA_SUCCESS) {\0A        return status;\0A    }\0A\0A    mbedtls_zeroize_and_free(local_output->buffer, local_output->length);\0A    local_output->buffer = NULL;\0A    local_output->length = 0;\0A\0A    return PSA_SUCCESS;\0A}\0A\0A#endif /* MBEDTLS_PSA_CRYPTO_C */\0A\00" }
