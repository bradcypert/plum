@.str41101 = private global { i64, i64, [47927 x i8] } { i64 -1, i64 47926, [47927 x i8] c"// A thin ABI-adapter shim for running a child process and capturing\0A// its exit code + stdout + stderr — needed for `plum build` to shell\0A// out to `clang` (already how THIS compiler's own native codegen\0A// works, see `codegen_cli.rs`'s `clang_compile`) from a Plum program\0A// itself, the other hard blocker (alongside `dir_shim.c`) toward ever\0A// self-hosting. Same `net_shim.c`/`dir_shim.c` shim pattern (see their\0A// own doc comments) — Plum's extern surface has no raw pointers, no\0A// arrays, and no multi-value return, so a \22run a process, get back\0A// THREE things (exit code/stdout/stderr)\22 operation needs the same\0A// two adaptations those files already established:\0A//\0A// **A handle-based, multi-call return** (mirrors `net_shim.c`'s socket\0A// fds, `dir_shim.c`'s directory handles): `process_run` blocks until\0A// the child exits, captures everything, and returns an opaque `Int`\0A// handle; `process_exit_code`/`process_stdout`/`process_stderr` read\0A// the ALREADY-CAPTURED result back out, any number of times, until\0A// `process_free` releases it. No result is ever recomputed or re-read\0A// from the child (which has already exited by the time `process_run`\0A// returns) — these are just accessors into a small in-process table.\0A//\0A// **Arguments packed into a single delimited `CStr`** (extern has no\0A// `Array[String]` at all): each argument separated by a TAB character.\0A// The natural choice here would be a rarer control byte (e.g. ASCII\0A// Unit Separator, `0x1F`) — genuinely safer against a real argument\0A// containing it — but Plum's own string-literal lexer only supports\0A// `\5Cn`/`\5Ct`/`\5Cr`/`\5C\5C`/`\5C\22` escapes, no `\5CxNN` hex byte escape, so the\0A// PLUM-side wrapper that joins an `Array[String]` into this shim's\0A// input literally cannot produce anything else. A real, honest trade\0A// forced by that limitation, not the ideal choice — a tab character\0A// appearing inside a real file path or flag is still rare, just not\0A// AS rare as a genuinely obscure control byte would have been. An\0A// argument that DOES contain a literal tab will be mis-split — not\0A// handled, not worth more complexity for something this unlikely.\0A//\0A// **Captures stdout/stderr via TEMP FILES, not pipes — deliberately.**\0A// A naive `pipe()` + `fork()` + `waitpid()` implementation has a\0A// classic, well-known deadlock: if the child writes more than the\0A// pipe's kernel buffer (~64KB on Linux) to a pipe NOBODY is draining\0A// yet (because the parent is blocked in `waitpid` first), the child\0A// blocks on `write()`, the parent blocks on `waitpid()` waiting for a\0A// child that's now blocked on the parent — a real hang, not a\0A// hypothetical (draining pipes concurrently, e.g. via `select()`/\0A// `poll()`, avoids it but adds real complexity this shim doesn't need\0A// to take on). Redirecting the child's stdout/stderr to real temp\0A// files via `dup2` sidesteps the whole class of bug: a file has no\0A// fixed-size buffer to fill, so there is no writer/reader ordering\0A// dependency at all — the parent just reads both files back, in full,\0A// AFTER `waitpid` confirms the child is done.\0A//\0A// **Not thread-safe** (a single, static, unlocked slot table) —\0A// acceptable for v1: every other blocking `native_stdlib` primitive\0A// (`net_shim.c`'s sockets included) is already scoped to single-\0A// threaded/sequential use, and a compiler shelling out to `clang` one\0A// invocation at a time (the actual motivating use case) never needs\0A// concurrent calls anyway.\0A//\0A// **Windows support is written but UNVERIFIED.** Everything above\0A// describes the POSIX path, which is tested by every harness in this\0A// repo. The Windows path below has never been compiled by a Windows\0A// toolchain, let alone run; it is a starting point, not working code,\0A// and is marked as such in PORTING.md. It keeps the temp-file capture\0A// strategy verbatim, because the pipe-deadlock reasoning above is not\0A// platform-specific -- Windows anonymous pipes have a fixed buffer and\0A// the identical failure mode.\0A//\0A// The two paths are split behind ONE function, `plum_spawn_capture`.\0A// Slot bookkeeping, argument splitting, reading the captured output\0A// back and cleaning up are shared and were not touched, so the POSIX\0A// behaviour is unchanged by the port rather than merely believed to\0A// be.\0A#include <stdio.h>\0A#include <stdlib.h>\0A#include <string.h>\0A#include <stdint.h>\0A#include <limits.h>\0A#include <wchar.h>\0A\0A#if defined(_WIN32)\0A#include <windows.h>\0A#else\0A#include <unistd.h>\0A#include <sys/wait.h>\0A#include <errno.h>\0A#include <fcntl.h>\0A#include <signal.h>\0A#include <time.h>\0A#endif\0A\0A#define PLUM_PROC_PATH_MAX 4096\0A\0A#define PLUM_PROC_ARG_SEP '\5Ct'\0A#define PLUM_PROC_MAX_SLOTS 256\0A\0A// The extra state an ASYNCHRONOUS child needs, and a synchronous run\0A// does not have to carry. NULL on a slot filled by `process_run`.\0A//\0A// A running child is the one case where the captured output cannot be\0A// read yet, so the PATHS have to outlive the spawn call -- which is\0A// the whole difference between this and the blocking path. Everything\0A// else here is what has to be closed or deleted once the child is\0A// gone, held so that `process_child_free` can do it without asking\0A// the caller to.\0Atypedef struct {\0A    long long pid;       // POSIX: pid_t. Windows: (intptr_t)HANDLE.\0A    void *h_out;         // Windows only: the child's stdout file handle.\0A    void *h_err;         // Windows only: the child's stderr file handle.\0A    char *out_path;\0A    char *err_path;\0A    char *in_path;       // Windows only; POSIX unlinks it at spawn.\0A    int finished;        // exit status collected, output read back\0A    // The policy `process_child_free` applies to a child still running.\0A    // 0 kills and reaps it. There is no way to set this from Plum yet\0A    // and that is deliberate -- it exists so that offering one later is\0A    // an addition rather than a redesign. See DESIGN.md.\0A    int drop_policy;\0A} PlumChildState;\0A\0Atypedef struct {\0A    int in_use;\0A    long long exit_code;\0A    char *out_data;\0A    char *err_data;\0A    PlumChildState *child;\0A} PlumProcessSlot;\0A\0Astatic PlumProcessSlot plum_process_slots[PLUM_PROC_MAX_SLOTS];\0A\0A// Defined further down with the asynchronous children. Declared here\0A// because `process_free` has to hand a spawned slot over to it, and\0A// that appears first.\0Avoid process_child_free(long long handle);\0Along long process_terminate(long long handle, long long hard);\0A\0Astatic char *plum_strdup_or_null(const char *s) {\0A    if (s == NULL) return NULL;\0A    size_t n = strlen(s) + 1;\0A    char *p = malloc(n);\0A    if (p != NULL) memcpy(p, s, n);\0A    return p;\0A}\0A\0Astatic char *plum_read_whole_file_or_empty(const char *path) {\0A    FILE *fp = fopen(path, \22rb\22);\0A    if (fp == NULL) {\0A        return strdup(\22\22);\0A    }\0A    fseek(fp, 0, SEEK_END);\0A    long size = ftell(fp);\0A    rewind(fp);\0A    if (size < 0) {\0A        fclose(fp);\0A        return strdup(\22\22);\0A    }\0A    char *buf = malloc((size_t)size + 1);\0A    if (buf == NULL) {\0A        fclose(fp);\0A        return strdup(\22\22);\0A    }\0A    size_t n = fread(buf, 1, (size_t)size, fp);\0A    buf[n] = '\5C0';\0A    fclose(fp);\0A    return buf;\0A}\0A\0A// A sentinel distinct from every real exit code. It cannot be -1:\0A// `process_run` already uses -1 as the exit code of a child killed by a\0A// signal, which is a SUCCESSFUL run with an unusual outcome, not a\0A// failure to start anything.\0A#define PLUM_SPAWN_FAILED (-1000000000LL)\0A\0A// `stdin_mode`: -1 inherit the parent's stdin, 0 empty (`/dev/null` /\0A// `NUL`), 1 feed `stdin_data` of length `stdin_len`.\0A// `fail_on_exec`: when set, an `execvp` failure is `PLUM_SPAWN_FAILED`\0A// rather than a child that exited 127 -- so `Process.run` can tell\0A// \22never started\22 from \22started and the program itself returned 127\22.\0A\0Astatic char **plum_split_args(const char *program, const char *args_joined, long long argc, char **copy_out) {\0A    char *args_copy = strdup(args_joined != NULL ? args_joined : \22\22);\0A    char **argv = (char **)malloc(sizeof(char *) * (size_t)(argc + 2));\0A    if (args_copy == NULL || argv == NULL) {\0A        free(args_copy);\0A        free(argv);\0A        *copy_out = NULL;\0A        return NULL;\0A    }\0A    argv[0] = (char *)program;\0A    long long idx = 1;\0A    if (argc > 0) {\0A        argv[idx++] = args_copy;\0A        for (char *c = args_copy; *c != '\5C0'; c++) {\0A            if (*c == PLUM_PROC_ARG_SEP) {\0A                *c = '\5C0';\0A                if (idx <= argc) {\0A                    argv[idx++] = c + 1;\0A                }\0A            }\0A        }\0A    }\0A    argv[idx] = NULL;\0A    *copy_out = args_copy;\0A    return argv;\0A}\0A\0Astatic char **plum_split_joined(const char *joined, long long n, char **copy_out) {\0A    if (n <= 0) {\0A        *copy_out = NULL;\0A        return NULL;\0A    }\0A    char *copy = strdup(joined != NULL ? joined : \22\22);\0A    char **items = (char **)malloc(sizeof(char *) * (size_t)(n + 1));\0A    if (copy == NULL || items == NULL) {\0A        free(copy);\0A        free(items);\0A        *copy_out = NULL;\0A        return NULL;\0A    }\0A    long long idx = 0;\0A    items[idx++] = copy;\0A    for (char *c = copy; *c != '\5C0'; c++) {\0A        if (*c == PLUM_PROC_ARG_SEP) {\0A            *c = '\5C0';\0A            if (idx < n) {\0A                items[idx++] = c + 1;\0A            }\0A        }\0A    }\0A    items[idx] = NULL;\0A    *copy_out = copy;\0A    return items;\0A}\0A\0A#if !defined(_WIN32)\0A\0Astatic void plum_apply_env(char **envp) {\0A    if (envp == NULL) return;\0A    for (int i = 0; envp[i] != NULL; i++) {\0A        char *eq = strchr(envp[i], '=');\0A        if (eq == NULL) continue;\0A        *eq = '\5C0';\0A        setenv(envp[i], eq + 1, 1);\0A        *eq = '=';\0A    }\0A}\0A\0A// Runs `argv` to completion with stdout and stderr captured into two\0A// fresh temp files, whose paths are written into the caller's buffers.\0A// Returns the child's exit code, or `PLUM_SPAWN_FAILED` if the child\0A// could never be started -- in which case no temp files are left behind\0A// and the path buffers hold nothing worth reading.\0A//\0A// This is the ONLY platform-specific part of this shim. Everything\0A// around it is shared.\0A\0Astatic long long plum_spawn_capture(const char *program, char **argv, char *out_path, char *err_path,\0A                                    char **envp, const char *stdin_data, long long stdin_len,\0A                                    int stdin_mode, int fail_on_exec, PlumChildState *async) {\0A    const char *tmp = getenv(\22TMPDIR\22);\0A    if (tmp == NULL || tmp[0] == '\5C0') tmp = \22/tmp\22;\0A    if (snprintf(out_path, PLUM_PROC_PATH_MAX, \22%s/plum_proc_out_XXXXXX\22, tmp) >= PLUM_PROC_PATH_MAX ||\0A        snprintf(err_path, PLUM_PROC_PATH_MAX, \22%s/plum_proc_err_XXXXXX\22, tmp) >= PLUM_PROC_PATH_MAX) {\0A        return PLUM_SPAWN_FAILED;\0A    }\0A\0A    int out_fd = mkstemp(out_path);\0A    int err_fd = (out_fd >= 0) ? mkstemp(err_path) : -1;\0A    if (out_fd < 0 || err_fd < 0) {\0A        if (out_fd >= 0) {\0A            close(out_fd);\0A            unlink(out_path);\0A        }\0A        return PLUM_SPAWN_FAILED;\0A    }\0A\0A    int in_fd = -1;\0A    char in_path[PLUM_PROC_PATH_MAX];\0A    in_path[0] = '\5C0';\0A    if (stdin_mode == 0) {\0A        in_fd = open(\22/dev/null\22, O_RDONLY);\0A        if (in_fd < 0) {\0A            close(out_fd); close(err_fd);\0A            unlink(out_path); unlink(err_path);\0A            return PLUM_SPAWN_FAILED;\0A        }\0A    } else if (stdin_mode > 0) {\0A        if (snprintf(in_path, PLUM_PROC_PATH_MAX, \22%s/plum_proc_in_XXXXXX\22, tmp) >= PLUM_PROC_PATH_MAX) {\0A            close(out_fd); close(err_fd);\0A            unlink(out_path); unlink(err_path);\0A            return PLUM_SPAWN_FAILED;\0A        }\0A        in_fd = mkstemp(in_path);\0A        if (in_fd < 0) {\0A            close(out_fd); close(err_fd);\0A            unlink(out_path); unlink(err_path);\0A            return PLUM_SPAWN_FAILED;\0A        }\0A        long long left = stdin_len;\0A        const char *p = stdin_data != NULL ? stdin_data : \22\22;\0A        while (left > 0) {\0A            ssize_t w = write(in_fd, p, (size_t)left);\0A            if (w <= 0) {\0A                close(in_fd); close(out_fd); close(err_fd);\0A                unlink(in_path); unlink(out_path); unlink(err_path);\0A                return PLUM_SPAWN_FAILED;\0A            }\0A            p += w;\0A            left -= w;\0A        }\0A        if (lseek(in_fd, 0, SEEK_SET) < 0) {\0A            close(in_fd); close(out_fd); close(err_fd);\0A            unlink(in_path); unlink(out_path); unlink(err_path);\0A            return PLUM_SPAWN_FAILED;\0A        }\0A    }\0A\0A    int errpipe[2] = {-1, -1};\0A    if (fail_on_exec) {\0A        if (pipe(errpipe) != 0) {\0A            if (in_fd >= 0) close(in_fd);\0A            if (in_path[0] != '\5C0') unlink(in_path);\0A            close(out_fd); close(err_fd);\0A            unlink(out_path); unlink(err_path);\0A            return PLUM_SPAWN_FAILED;\0A        }\0A        fcntl(errpipe[1], F_SETFD, FD_CLOEXEC);\0A    }\0A\0A    pid_t pid = fork();\0A    if (pid < 0) {\0A        if (in_fd >= 0) close(in_fd);\0A        if (in_path[0] != '\5C0') unlink(in_path);\0A        if (errpipe[0] >= 0) { close(errpipe[0]); close(errpipe[1]); }\0A        close(out_fd);\0A        close(err_fd);\0A        unlink(out_path);\0A        unlink(err_path);\0A        return PLUM_SPAWN_FAILED;\0A    }\0A    if (pid == 0) {\0A        if (in_fd >= 0) {\0A            dup2(in_fd, STDIN_FILENO);\0A          