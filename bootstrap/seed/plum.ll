@.str41211 = private global { i64, i64, [9337 x i8] } { i64 -1, i64 9336, [9337 x i8] c"/*\0A *  Low-level modular bignum functions\0A *\0A *  Copyright The Mbed TLS Contributors\0A *  SPDX-License-Identifier: Apache-2.0 OR GPL-2.0-or-later\0A */\0A\0A#include \22common.h\22\0A\0A#if defined(MBEDTLS_BIGNUM_C) && defined(MBEDTLS_ECP_WITH_MPI_UINT)\0A\0A#include <string.h>\0A\0A#include \22mbedtls/error.h\22\0A#include \22mbedtls/platform_util.h\22\0A\0A#include \22mbedtls/platform.h\22\0A\0A#include \22bignum_core.h\22\0A#include \22bignum_mod_raw.h\22\0A#include \22bignum_mod.h\22\0A#include \22constant_time_internal.h\22\0A\0A#include \22bignum_mod_raw_invasive.h\22\0A\0Avoid mbedtls_mpi_mod_raw_cond_assign(mbedtls_mpi_uint *X,\0A                                     const mbedtls_mpi_uint *A,\0A                                     const mbedtls_mpi_mod_modulus *N,\0A                                     unsigned char assign)\0A{\0A    mbedtls_mpi_core_cond_assign(X, A, N->limbs, mbedtls_ct_bool(assign));\0A}\0A\0Avoid mbedtls_mpi_mod_raw_cond_swap(mbedtls_mpi_uint *X,\0A                                   mbedtls_mpi_uint *Y,\0A                                   const mbedtls_mpi_mod_modulus *N,\0A                                   unsigned char swap)\0A{\0A    mbedtls_mpi_core_cond_swap(X, Y, N->limbs, mbedtls_ct_bool(swap));\0A}\0A\0Aint mbedtls_mpi_mod_raw_read(mbedtls_mpi_uint *X,\0A                             const mbedtls_mpi_mod_modulus *N,\0A                             const unsigned char *input,\0A                             size_t input_length,\0A                             mbedtls_mpi_mod_ext_rep ext_rep)\0A{\0A    int ret = MBEDTLS_ERR_ERROR_CORRUPTION_DETECTED;\0A\0A    switch (ext_rep) {\0A        case MBEDTLS_MPI_MOD_EXT_REP_LE:\0A            ret = mbedtls_mpi_core_read_le(X, N->limbs,\0A                                           input, input_length);\0A            break;\0A        case MBEDTLS_MPI_MOD_EXT_REP_BE:\0A            ret = mbedtls_mpi_core_read_be(X, N->limbs,\0A                                           input, input_length);\0A            break;\0A        default:\0A            return MBEDTLS_ERR_MPI_BAD_INPUT_DATA;\0A    }\0A\0A    if (ret != 0) {\0A        goto cleanup;\0A    }\0A\0A    if (!mbedtls_mpi_core_lt_ct(X, N->p, N->limbs)) {\0A        ret = MBEDTLS_ERR_MPI_BAD_INPUT_DATA;\0A        goto cleanup;\0A    }\0A\0Acleanup:\0A\0A    return ret;\0A}\0A\0Aint mbedtls_mpi_mod_raw_write(const mbedtls_mpi_uint *A,\0A                              const mbedtls_mpi_mod_modulus *N,\0A                              unsigned char *output,\0A                              size_t output_length,\0A                              mbedtls_mpi_mod_ext_rep ext_rep)\0A{\0A    switch (ext_rep) {\0A        case MBEDTLS_MPI_MOD_EXT_REP_LE:\0A            return mbedtls_mpi_core_write_le(A, N->limbs,\0A                                             output, output_length);\0A        case MBEDTLS_MPI_MOD_EXT_REP_BE:\0A            return mbedtls_mpi_core_write_be(A, N->limbs,\0A                                             output, output_length);\0A        default:\0A            return MBEDTLS_ERR_MPI_BAD_INPUT_DATA;\0A    }\0A}\0A\0Avoid mbedtls_mpi_mod_raw_sub(mbedtls_mpi_uint *X,\0A                             const mbedtls_mpi_uint *A,\0A                             const mbedtls_mpi_uint *B,\0A                             const mbedtls_mpi_mod_modulus *N)\0A{\0A    mbedtls_mpi_uint c = mbedtls_mpi_core_sub(X, A, B, N->limbs);\0A\0A    (void) mbedtls_mpi_core_add_if(X, N->p, N->limbs, (unsigned) c);\0A}\0A\0AMBEDTLS_STATIC_TESTABLE\0Avoid mbedtls_mpi_mod_raw_fix_quasi_reduction(mbedtls_mpi_uint *X,\0A                                             const mbedtls_mpi_mod_modulus *N)\0A{\0A    mbedtls_mpi_uint c = mbedtls_mpi_core_sub(X, X, N->p, N->limbs);\0A\0A    (void) mbedtls_mpi_core_add_if(X, N->p, N->limbs, (unsigned) c);\0A}\0A\0A\0Avoid mbedtls_mpi_mod_raw_mul(mbedtls_mpi_uint *X,\0A                             const mbedtls_mpi_uint *A,\0A                             const mbedtls_mpi_uint *B,\0A                             const mbedtls_mpi_mod_modulus *N,\0A                             mbedtls_mpi_uint *T)\0A{\0A    /* Standard (A * B) multiplication stored into pre-allocated T\0A     * buffer of fixed limb size of (2N + 1).\0A     *\0A     * The space may not not fully filled by when\0A     * MBEDTLS_MPI_MOD_REP_OPT_RED is used. */\0A    const size_t T_limbs = BITS_TO_LIMBS(N->bits) * 2;\0A    switch (N->int_rep) {\0A        case MBEDTLS_MPI_MOD_REP_MONTGOMERY:\0A            mbedtls_mpi_core_montmul(X, A, B, N->limbs, N->p, N->limbs,\0A                                     N->rep.mont.mm, T);\0A            break;\0A        case MBEDTLS_MPI_MOD_REP_OPT_RED:\0A            mbedtls_mpi_core_mul(T, A, N->limbs, B, N->limbs);\0A\0A            /* Optimised Reduction */\0A            (*N->rep.ored.modp)(T, T_limbs);\0A\0A            /* Convert back to canonical representation */\0A            mbedtls_mpi_mod_raw_fix_quasi_reduction(T, N);\0A            memcpy(X, T, N->limbs * sizeof(mbedtls_mpi_uint));\0A            break;\0A        default:\0A            break;\0A    }\0A\0A}\0A\0Asize_t mbedtls_mpi_mod_raw_inv_prime_working_limbs(size_t AN_limbs)\0A{\0A    /* mbedtls_mpi_mod_raw_inv_prime() needs a temporary for the exponent,\0A     * which will be the same size as the modulus and input (AN_limbs),\0A     * and additional space to pass to mbedtls_mpi_core_exp_mod(). */\0A    return AN_limbs +\0A           mbedtls_mpi_core_exp_mod_working_limbs(AN_limbs, AN_limbs);\0A}\0A\0Avoid mbedtls_mpi_mod_raw_inv_prime(mbedtls_mpi_uint *X,\0A                                   const mbedtls_mpi_uint *A,\0A                                   const mbedtls_mpi_uint *N,\0A                                   size_t AN_limbs,\0A                                   const mbedtls_mpi_uint *RR,\0A                                   mbedtls_mpi_uint *T)\0A{\0A    /* Inversion by power: g^|G| = 1 => g^(-1) = g^(|G|-1), and\0A     *                       |G| = N - 1, so we want\0A     *                 g^(|G|-1) = g^(N - 2)\0A     */\0A\0A    /* Use the first AN_limbs of T to hold N - 2 */\0A    mbedtls_mpi_uint *Nminus2 = T;\0A    (void) mbedtls_mpi_core_sub_int(Nminus2, N, 2, AN_limbs);\0A\0A    /* Rest of T is given to exp_mod for its working space */\0A    mbedtls_mpi_core_exp_mod(X,\0A                             A, N, AN_limbs, Nminus2, AN_limbs,\0A                             RR, T + AN_limbs);\0A}\0A\0Avoid mbedtls_mpi_mod_raw_add(mbedtls_mpi_uint *X,\0A                             const mbedtls_mpi_uint *A,\0A                             const mbedtls_mpi_uint *B,\0A                             const mbedtls_mpi_mod_modulus *N)\0A{\0A    mbedtls_mpi_uint carry, borrow;\0A    carry  = mbedtls_mpi_core_add(X, A, B, N->limbs);\0A    borrow = mbedtls_mpi_core_sub(X, X, N->p, N->limbs);\0A    (void) mbedtls_mpi_core_add_if(X, N->p, N->limbs, (unsigned) (carry ^ borrow));\0A}\0A\0Aint mbedtls_mpi_mod_raw_canonical_to_modulus_rep(\0A    mbedtls_mpi_uint *X,\0A    const mbedtls_mpi_mod_modulus *N)\0A{\0A    switch (N->int_rep) {\0A        case MBEDTLS_MPI_MOD_REP_MONTGOMERY:\0A            return mbedtls_mpi_mod_raw_to_mont_rep(X, N);\0A        case MBEDTLS_MPI_MOD_REP_OPT_RED:\0A            return 0;\0A        default:\0A            return MBEDTLS_ERR_MPI_BAD_INPUT_DATA;\0A    }\0A}\0A\0Aint mbedtls_mpi_mod_raw_modulus_to_canonical_rep(\0A    mbedtls_mpi_uint *X,\0A    const mbedtls_mpi_mod_modulus *N)\0A{\0A    switch (N->int_rep) {\0A        case MBEDTLS_MPI_MOD_REP_MONTGOMERY:\0A            return mbedtls_mpi_mod_raw_from_mont_rep(X, N);\0A        case MBEDTLS_MPI_MOD_REP_OPT_RED:\0A            return 0;\0A        default:\0A            return MBEDTLS_ERR_MPI_BAD_INPUT_DATA;\0A    }\0A}\0A\0Aint mbedtls_mpi_mod_raw_random(mbedtls_mpi_uint *X,\0A                               mbedtls_mpi_uint min,\0A                               const mbedtls_mpi_mod_modulus *N,\0A                               int (*f_rng)(void *, unsigned char *, size_t),\0A                               void *p_rng)\0A{\0A    int ret = mbedtls_mpi_core_random(X, min, N->p, N->limbs, f_rng, p_rng);\0A    if (ret != 0) {\0A        return ret;\0A    }\0A    return mbedtls_mpi_mod_raw_canonical_to_modulus_rep(X, N);\0A}\0A\0Aint mbedtls_mpi_mod_raw_to_mont_rep(mbedtls_mpi_uint *X,\0A                                    const mbedtls_mpi_mod_modulus *N)\0A{\0A    mbedtls_mpi_uint *T;\0A    const size_t t_limbs = mbedtls_mpi_core_montmul_working_limbs(N->limbs);\0A\0A    if ((T = (mbedtls_mpi_uint *) mbedtls_calloc(t_limbs, ciL)) == NULL) {\0A        return MBEDTLS_ERR_MPI_ALLOC_FAILED;\0A    }\0A\0A    mbedtls_mpi_core_to_mont_rep(X, X, N->p, N->limbs,\0A                                 N->rep.mont.mm, N->rep.mont.rr, T);\0A\0A    mbedtls_zeroize_and_free(T, t_limbs * ciL);\0A    return 0;\0A}\0A\0Aint mbedtls_mpi_mod_raw_from_mont_rep(mbedtls_mpi_uint *X,\0A                                      const mbedtls_mpi_mod_modulus *N)\0A{\0A    const size_t t_limbs = mbedtls_mpi_core_montmul_working_limbs(N->limbs);\0A    mbedtls_mpi_uint *T;\0A\0A    if ((T = (mbedtls_mpi_uint *) mbedtls_calloc(t_limbs, ciL)) == NULL) {\0A        return MBEDTLS_ERR_MPI_ALLOC_FAILED;\0A    }\0A\0A    mbedtls_mpi_core_from_mont_rep(X, X, N->p, N->limbs, N->rep.mont.mm, T);\0A\0A    mbedtls_zeroize_and_free(T, t_limbs * ciL);\0A    return 0;\0A}\0A\0Avoid mbedtls_mpi_mod_raw_neg(mbedtls_mpi_uint *X,\0A                             const mbedtls_mpi_uint *A,\0A                             const mbedtls_mpi_mod_modulus *N)\0A{\0A    mbedtls_mpi_core_sub(X, N->p, A, N->limbs);\0A\0A    /* If A=0 initially, then X=N now. Detect this by\0A     * subtracting N and catching the carry. */\0A    mbedtls_mpi_uint borrow = mbedtls_mpi_core_sub(X, X, N->p, N->limbs);\0A    (void) mbedtls_mpi_core_add_if(X, N->p, N->limbs, (unsigned) borrow);\0A}\0A\0A#endif /* MBEDTLS_BIGNUM_C && MBEDTLS_ECP_WITH_MPI_UINT */\0A\00" }
@.const41213 = private global <{ i64, ptr, ptr, i1, [7 x i8] }> <{ i64 -1, ptr @.str41209, ptr @.str41211, i1 1, [7 x i8] zeroinitializer }>
