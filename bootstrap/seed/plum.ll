DE_CFB */\0A\0A#if defined(MBEDTLS_CIPHER_MODE_OFB)\0A    /*\0A     * OFB mode\0A     */\0A    {\0A        static const int num_tests =\0A            sizeof(aes_test_ofb_key) / sizeof(*aes_test_ofb_key);\0A\0A        for (i = 0; i < num_tests << 1; i++) {\0A            u = i >> 1;\0A            keybits = 128 + u * 64;\0A            mode = i & 1;\0A\0A            if (verbose != 0) {\0A                mbedtls_printf(\22  AES-OFB-%3u (%s): \22, keybits,\0A                               (mode == MBEDTLS_AES_DECRYPT) ? \22dec\22 : \22enc\22);\0A            }\0A\0A            memcpy(iv,  aes_test_ofb_iv, 16);\0A            memcpy(key, aes_test_ofb_key[u], keybits / 8);\0A\0A            offset = 0;\0A            ret = mbedtls_aes_setkey_enc(&ctx, key, keybits);\0A            /*\0A             * AES-192 is an optional feature that may be unavailable when\0A             * there is an alternative underlying implementation i.e. when\0A             * MBEDTLS_AES_ALT is defined.\0A             */\0A            if (ret == MBEDTLS_ERR_PLATFORM_FEATURE_UNSUPPORTED && keybits == 192) {\0A                mbedtls_printf(\22skipped\5Cn\22);\0A                continue;\0A            } else if (ret != 0) {\0A                goto exit;\0A            }\0A\0A            if (mode == MBEDTLS_AES_DECRYPT) {\0A                memcpy(buf, aes_test_ofb_ct[u], 64);\0A                aes_tests = aes_test_ofb_pt;\0A            } else {\0A                memcpy(buf, aes_test_ofb_pt, 64);\0A                aes_tests = aes_test_ofb_ct[u];\0A            }\0A\0A            ret = mbedtls_aes_crypt_ofb(&ctx, 64, &offset, iv, buf, buf);\0A            if (ret != 0) {\0A                goto exit;\0A            }\0A\0A            if (memcmp(buf, aes_tests, 64) != 0) {\0A                ret = 1;\0A                goto exit;\0A            }\0A\0A            if (verbose != 0) {\0A                mbedtls_printf(\22passed\5Cn\22);\0A            }\0A        }\0A\0A        if (verbose != 0) {\0A            mbedtls_pr