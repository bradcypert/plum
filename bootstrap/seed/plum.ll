efine MBEDTLS_SSL_CID_LEN_MAX MBEDTLS_SSL_CID_IN_LEN_MAX\0A#endif\0A\0Atypedef struct {\0A    uint8_t ctr[MBEDTLS_SSL_SEQUENCE_NUMBER_LEN];  /* In TLS:  The implicit record sequence number.\0A                                                    * In DTLS: The 2-byte epoch followed by\0A                                                    *          the 6-byte sequence number.\0A                                                    * This is stored as a raw big endian byte array\0A                                                    * as opposed to a uint64_t because we rarely\0A                                                    * need to perform arithmetic on this, but do\0A                                                    * need it as a Byte array for the purpose of\0A                                                    * MAC computations.                             */\0A    uint8_t type;           /* The record content type.                      */\0A    uint8_t ver[2];         /* SSL/TLS version as present on the wire.\0A                             * Convert to internal presentation of versions\0A                             * using mbedtls_ssl_read_version() and\0A                             * mbedtls_ssl_write_version().\0A                             * Keep wire-format for MAC computations.        */\0A\0A    unsigned char *buf;     /* Memory buffer enclosing the record content    */\0A    size_t buf_len;         /* Buffer length                                 */\0A    size_t data_offset;     /* Offset of record content                      */\0A    size_t data_len;        /* Length of record content                      */\0A\0A#if defined(MBEDTLS_SSL_DTLS_CONNECTION_ID)\0A    uint8_t cid_len;        /* Length of the CID (0 if not present)          */\0A    unsigned char cid[MBEDTLS_SSL_CID_LEN_MAX];   /* The CID                 */\0A#endif /* MBEDTLS_SSL_DTLS_CONNECTION_ID */\0A} mbedtls_record;\0A\0A#if defined(MBEDTLS_X509_CRT_PARSE_C)\0A/*\0A * List of c