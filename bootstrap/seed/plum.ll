@.str41296 = private global { i64, i64, [21203 x i8] } { i64 -1, i64 21202, [21203 x i8] c"/**\0A *  Constant-time functions\0A *\0A *  Copyright The Mbed TLS Contributors\0A *  SPDX-License-Identifier: Apache-2.0 OR GPL-2.0-or-later\0A */\0A\0A#ifndef MBEDTLS_CONSTANT_TIME_IMPL_H\0A#define MBEDTLS_CONSTANT_TIME_IMPL_H\0A\0A#include <stddef.h>\0A\0A#include \22common.h\22\0A\0A#if defined(MBEDTLS_BIGNUM_C)\0A#include \22mbedtls/bignum.h\22\0A#endif\0A\0A/*\0A * To improve readability of constant_time_internal.h, the static inline\0A * definitions are here, and constant_time_internal.h has only the declarations.\0A *\0A * This results in duplicate declarations of the form:\0A *     static inline void f();         // from constant_time_internal.h\0A *     static inline void f() { ... }  // from constant_time_impl.h\0A * when constant_time_internal.h is included.\0A *\0A * This appears to behave as if the declaration-without-definition was not present\0A * (except for warnings if gcc -Wredundant-decls or similar is used).\0A *\0A * Disable -Wredundant-decls so that gcc does not warn about this. This is re-enabled\0A * at the bottom of this file.\0A */\0A#if defined(MBEDTLS_COMPILER_IS_GCC) && (__GNUC__ > 4)\0A    #pragma GCC diagnostic push\0A    #pragma GCC diagnostic ignored \22-Wredundant-decls\22\0A#endif\0A\0A/* armcc5 --gnu defines __GNUC__ but doesn't support GNU's extended asm */\0A#if defined(MBEDTLS_HAVE_ASM) && defined(__GNUC__) && (!defined(__ARMCC_VERSION) || \5C\0A    __ARMCC_VERSION >= 6000000)\0A#define MBEDTLS_CT_ASM\0A#if (defined(__arm__) || defined(__thumb__) || defined(__thumb2__))\0A#define MBEDTLS_CT_ARM_ASM\0A#elif defined(__aarch64__)\0A#define MBEDTLS_CT_AARCH64_ASM\0A#elif defined(__amd64__) || defined(__x86_64__)\0A#define MBEDTLS_CT_X86_64_ASM\0A#elif defined(__i386__)\0A#define MBEDTLS_CT_X86_ASM\0A#endif\0A#endif\0A\0A#define MBEDTLS_CT_SIZE (sizeof(mbedtls_ct_uint_t) * 8)\0A\0A\0A/* =======================================================