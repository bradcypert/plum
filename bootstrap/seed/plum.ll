o a file, creating it or REPLACING what was there.\0A///\0A/// The `Bytes` counterpart to `Os.write_file`: use this for anything\0A/// that is not text, and for text you have already encoded.\0Apub let write_bytes (path: String) (data: Bytes): Result[Unit, String] =\0A    if write_file_bytes_raw(path, data) { Ok(()) } else { Err(\22could not write \22.concat(path)) }\0A\0A/// Creates the file when it does not exist, the way `>>` does.\0Apub let append_bytes (path: String) (data: Bytes): Result[Unit, String] =\0A    if append_file_bytes_raw(path, data) { Ok(()) } else { Err(\22could not append to \22.concat(path)) }\0A\0A// --- Streaming file I/O ---\0A//\0A// The whole-file calls above are the convenience: one call, no\0A// handle, no cleanup to think about. These are for the cases a\0A// whole-file read cannot serve -- a file too big to hold, a stream\0A// consumed as it arrives, an append-only log kept open.\0A//\0A// `File` is a `handle` (issue #9), so an open file CLOSES ITSELF\0A// when the value dies. `File.close` is still offered, and still\0A// returns a `Result`, because closing can fail -- a buffered write\0A// is flushed by `fclose`, and that is exactly when a full disk is\0A// discovered. So: call `close` when the error matters, and rely on\0A// the handle when it does not. Neither leaks.\0A//\0A// Closing twice is fine and is the NORMAL path, since the handle\0A// runs after an explicit close. `native_stdlib/file_shim.c` owns a\0A// slot table precisely so the second one is harmless.\0Aextern \22C\22 {\0A    fn file_open(path: CStr, mode: Int) -> Int;\0A    fn file_close(h: Int);\0A    fn file_close_checked(h: Int) -> Int;\0A    fn file_read_n(h: Int, max_len: Int) -> Int;\0A    fn file_read_data() -> CStr;\0A    fn file_write(h: Int, buf: CStr, len: Int) -> Int;\0A    fn file_seek(h: Int, offset: Int, whence: Int) -> Int;\0A    fn file_flush(h: Int) -> Int;\0A}\0A\0A/// An open file. **Closed when this value dies**, including on a\0A/// panic, so a fil