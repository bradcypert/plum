ward zero. Use\0A/// `Duration.as_nanos` when the remainder matters.\0Apub let Duration.as_micros (d: Duration): Int = d.nanos / 1000\0A/// The duration in milliseconds, TRUNCATED toward zero. Use\0A/// `Duration.as_nanos` when the remainder matters.\0Apub let Duration.as_millis (d: Duration): Int = d.nanos / 1000000\0A/// The duration in whole seconds, TRUNCATED toward zero. Use\0A/// `Duration.as_nanos` when the remainder matters.\0Apub let Duration.as_seconds (d: Duration): Int = d.nanos / 1000000000\0A/// Whether this is exactly no time. A negative duration is not zero.\0Apub let Duration.is_zero (d: Duration): Bool = d.nanos == 0\0A\0A/// Adds two durations.\0Apub let Duration.add (a: Duration) (b: Duration): Duration = Duration { nanos: a.nanos + b.nanos }\0A/// Subtracts `b` from `a`. The result may be negative, which is a\0A/// legal duration and is what `Time.between` returns for two instants\0A/// given the other way round.\0Apub let Duration.sub (a: Duration) (b: Duration): Duration = Duration { nanos: a.nanos - b.nanos }\0A/// Multiplies a duration by a whole number.\0Apub let Duration.scale (d: Duration) (n: Int): Duration = Duration { nanos: d.nanos * n }\0A\0A/// A duration can be NEGATIVE. `sub` may produce one, and refusing\0A/// to represent it would only move the problem to every caller of\0A/// `sub`. `sleep` treats a non-positive duration as no wait at all.\0Apub let Duration.negate (d: Duration): Duration = Duration { nanos: 0 - d.nanos }\0A\0A/// --- Comparison ---\0A///\0A/// Functions rather than `<`, because this checker offers ordered\0A/// comparison on `Int`, `Float` and `String` and on nothing else --\0A/// a struct has no `<`. `==` works, since that is structural.\0A///\0A/// If ordered comparison ever reaches single-field wrappers, `<`\0A/// starts working on a `Duration` for free and these stay as the\0A/// spelling that always worked.\0Apub let Duration.compare (a: Duration) (b: Duration): Int =\0A    if a.nanos < b.nanos { 0 - 1 } 