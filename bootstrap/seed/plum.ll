@.str41022 = private global { i64, i64, [6880 x i8] } { i64 -1, i64 6879, [6880 x i8] c"/**\0A * \5Cfile sha256.h\0A *\0A * \5Cbrief This file contains SHA-224 and SHA-256 definitions and functions.\0A *\0A * The Secure Hash Algorithms 224 and 256 (SHA-224 and SHA-256) cryptographic\0A * hash functions are defined in <em>FIPS 180-4: Secure Hash Standard (SHS)</em>.\0A */\0A/*\0A *  Copyright The Mbed TLS Contributors\0A *  SPDX-License-Identifier: Apache-2.0 OR GPL-2.0-or-later\0A */\0A#ifndef MBEDTLS_SHA256_H\0A#define MBEDTLS_SHA256_H\0A#include \22mbedtls/private_access.h\22\0A\0A#include \22mbedtls/build_info.h\22\0A\0A#include <stddef.h>\0A#include <stdint.h>\0A\0A/** SHA-256 input data was malformed. */\0A#define MBEDTLS_ERR_SHA256_BAD_INPUT_DATA                 -0x0074\0A\0A#ifdef __cplusplus\0Aextern \22C\22 {\0A#endif\0A\0A#if !defined(MBEDTLS_SHA256_ALT)\0A// Regular implementation\0A//\0A\0A/**\0A * \5Cbrief          The SHA-256 context structure.\0A *\0A *                 The structure is used both for SHA-256 and for SHA-224\0A *                 checksum calculations. The choice between these two is\0A *                 made in the call to mbedtls_sha256_starts().\0A */\0Atypedef struct mbedtls_sha256_context {\0A    unsigned char MBEDTLS_PRIVATE(buffer)[64];   /*!< The data block being processed. */\0A    uint32_t MBEDTLS_PRIVATE(total)[2];          /*!< The number of Bytes processed.  */\0A    uint32_t MBEDTLS_PRIVATE(state)[8];          /*!< The intermediate digest state.  */\0A#if defined(MBEDTLS_SHA224_C)\0A    int MBEDTLS_PRIVATE(is224);                  /*!< Determines which function to use:\0A                                                    0: Use SHA-256, or 1: Use SHA-224. */\0A#endif\0A}\0Ambedtls_sha256_context;\0A\0A#else  /* MBEDTLS_SHA256_ALT */\0A#include \22sha256_alt.h\22\0A#endif /* MBEDTLS_SHA256_ALT */\0A\0A/**\0A * \5Cbrief          This function initializes a SHA-256 context.\0A *\0A * \5Cparam ctx      The SHA-256 context to initialize. This must not be \5Cc NULL.\0A */\0Avoid mbedtls_sha256_init(mbedtls_sha256_context *ctx);\0A\0A/**\0A * \5Cbrief          This function clears a SHA-256 context.\0A *\0A * \5Cparam ctx      The SHA-256 context to clear. This may be \5Cc NULL, in which\0A *                 case this function returns immediately. If it is not \5Cc NULL,\0A *                 it must point to an initialized SHA-256 context.\0A */\0Avoid mbedtls_sha256_free(mbedtls_sha256_context *ctx);\0A\0A/**\0A * \5Cbrief          This function clones the state of a SHA-256 context.\0A *\0A * \5Cparam dst      The destination context. This must be initialized.\0A * \5Cparam src      The context to clone. This must be initialized.\0A */\0Avoid mbedtls_sha256_clone(mbedtls_sha256_context *dst,\0A                          const mbedtls_sha256_context *src);\0A\0A/**\0A * \5Cbrief          This function starts a SHA-224 or SHA-256 checksum\0A *                 calculation.\0A *\0A * \5Cparam ctx      The context to use. This must be initialized.\0A * \5Cparam is224    This determines which function to use. This must be\0A *                 either \5Cc 0 for SHA-256, or \5Cc 1 for SHA-224.\0A *\0A * \5Cnote           is224 must be defined accordingly to the enabled\0A *                 MBEDTLS_SHA224_C/MBEDTLS_SHA256_C symbols otherwise the\0A *                 function will return #MBEDTLS_ERR_SHA512_BAD_INPUT_DATA.\0A *\0A * \5Creturn         \5Cc 0 on success.\0A * \5Creturn         A negative error code on failure.\0A */\0Aint mbedtls_sha256_starts(mbedtls_sha256_context *ctx, int is224);\0A\0A/**\0A * \5Cbrief          This function feeds an input buffer into an ongoing\0A *                 SHA-256 checksum calculation.\0A *\0A * \5Cparam ctx      The SHA-256 context. This must be initialized\0A *                 and have a hash operation started.\0A * \5Cparam input    The buffer holding the data. This must be a readable\0A *                 buffer of length \5Cp ilen Bytes.\0A * \5Cparam ilen     The length of the input data in Bytes.\0A *\0A * \5Creturn         \5Cc 0 on success.\0A * \5Creturn         A negative error code on failure.\0A */\0Aint mbedtls_sha256_update(mbedtls_sha256_context *ctx,\0A                          const unsigned char *input,\0A                          size_t ilen);\0A\0A/**\0A * \5Cbrief          This function finishes the SHA-256 operation, and writes\0A *                 the result to the output buffer.\0A *\0A * \5Cparam ctx      The SHA-256 context. This must be initialized\0A *                 and have a hash operation started.\0A * \5Cparam output   The SHA-224 or SHA-256 checksum result.\0A *                 This must be a writable buffer of length \5Cc 32 bytes\0A *                 for SHA-256, \5Cc 28 bytes for SHA-224.\0A *\0A * \5Creturn         \5Cc 0 on success.\0A * \5Creturn         A negative error code on failure.\0A */\0Aint mbedtls_sha256_finish(mbedtls_sha256_context *ctx,\0A                          unsigned char *output);\0A\0A/**\0A * \5Cbrief          This function processes a single data block within\0A *                 the ongoing SHA-256 computation. This function is for\0A *                 internal use only.\0A *\0A * \5Cparam ctx      The SHA-256 context. This must be initialized.\0A * \5Cparam data     The buffer holding one block of data. This must\0A *                 be a readable buffer of length \5Cc 64 Bytes.\0A *\0A * \5Creturn         \5Cc 0 on success.\0A * \5Creturn         A negative error code on failure.\0A */\0Aint mbedtls_internal_sha256_process(mbedtls_sha256_context *ctx,\0A                                    const unsigned char data[64]);\0A\0A/**\0A * \5Cbrief          This function calculates the SHA-224 or SHA-256\0A *                 checksum of a buffer.\0A *\0A *                 The function allocates the context, performs the\0A *                 calculation, and frees the context.\0A *\0A *                 The SHA-256 result is calculated as\0A *                 output = SHA-256(input buffer).\0A *\0A * \5Cparam input    The buffer holding the data. This must be a readable\0A *                 buffer of length \5Cp ilen Bytes.\0A * \5Cparam ilen     The length of the input data in Bytes.\0A * \5Cparam output   The SHA-224 or SHA-256 checksum result.\0A *                 This must be a writable buffer of length \5Cc 32 bytes\0A *                 for SHA-256, \5Cc 28 bytes for SHA-224.\0A * \5Cparam is224    Determines which function to use. This must be\0A *                 either \5Cc 0 for SHA-256, or \5Cc 1 for SHA-224.\0A *\0A * \5Creturn         \5Cc 0 on success.\0A * \5Creturn         A negative error code on failure.\0A */\0Aint mbedtls_sha256(const unsigned char *input,\0A                   size_t ilen,\0A                   unsigned char *output,\0A                   int is224);\0A\0A#if defined(MBEDTLS_SELF_TEST)\0A\0A#if defined(MBEDTLS_SHA224_C)\0A/**\0A * \5Cbrief          The SHA-224 checkup routine.\0A *\0A * \5Creturn         \5Cc 0 on success.\0A * \5Creturn         \5Cc 1 on failure.\0A */\0Aint mbedtls_sha224_self_test(int verbose);\0A#endif /* MBEDTLS_SHA224_C */\0A\0A#if defined(MBEDTLS_SHA256_C)\0A/**\0A * \5Cbrief          The SHA-256 checkup routine.\0A *\0A * \5Creturn         \5Cc 0 on success.\0A * \5Creturn         \5Cc 1 on failure.\0A */\0Aint mbedtls_sha256_self_test(int verbose);\0A#endif /* MBEDTLS_SHA256_C */\0A\0A#endif /* MBEDTLS_SELF_TEST */\0A\0A#ifdef __cplusplus\0A}\0A#endif\0A\0A#endif /* mbedtls_sha256.h */\0A\00" }
