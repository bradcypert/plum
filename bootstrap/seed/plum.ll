se != 0) {\0A                mbedtls_printf(\22passed\5Cn\22);\0A            }\0A\0A            mbedtls_gcm_init(&ctx);\0A\0A            if (verbose != 0) {\0A                mbedtls_printf(\22  AES-GCM-%3d #%d split (%s): \22,\0A                               key_len, i, \22dec\22);\0A            }\0A\0A            ret = mbedtls_gcm_setkey(&ctx, cipher,\0A                                     key_test_data[key_index_test_data[i]],\0A                                     key_len);\0A            if (ret != 0) {\0A                goto exit;\0A            }\0A\0A            ret = mbedtls_gcm_starts(&ctx, MBEDTLS_GCM_DECRYPT,\0A                                     iv_test_data[iv_index_test_data[i]],\0A                                     iv_len_test_data[i]);\0A            if (ret != 0) {\0A                goto exit;\0A            }\0A            ret = mbedtls_gcm_update_ad(&ctx,\0A                                        additional_test_data[add_index_test_data[i]],\0A                                        add_len_test_data[i]);\0A            if (ret != 0) {\0A                goto exit;\0A            }\0A\0A            if (pt_len_test_data[i] > 32) {\0A                size_t rest_len = pt_len_test_data[i] - 32;\0A                ret = mbedtls_gcm_update(&ctx,\0A                                         ct_test_data[j * 6 + i], 32,\0A                                         buf, sizeof(buf), &olen);\0A                if (ret != 0) {\0A                    goto exit;\0A                }\0A                if (olen != 32) {\0A                    goto exit;\0A                }\0A\0A                ret = mbedtls_gcm_update(&ctx,\0A                                         ct_test_data[j * 6 + i] + 32,\0A                                         rest_len,\0A                                         buf + 32, sizeof(buf) - 32, &olen);\0A                if (ret != 0) {\0A                    goto exit;\0A                }\0A                if (olen != rest_len) {\0A                   