@.str40470 = private global { i64, i64, [15582 x i8] } { i64 -1, i64 15581, [15582 x i8] c"/*\0A *  PSA cipher driver entry points and associated auxiliary functions\0A */\0A/*\0A *  Copyright The Mbed TLS Contributors\0A *  SPDX-License-Identifier: Apache-2.0 OR GPL-2.0-or-later\0A */\0A\0A#ifndef PSA_CRYPTO_CIPHER_H\0A#define PSA_CRYPTO_CIPHER_H\0A\0A#include <mbedtls/cipher.h>\0A#include <psa/crypto.h>\0A\0A/** Get Mbed TLS cipher information given the cipher algorithm PSA identifier\0A *  as well as the PSA type and size of the key to be used with the cipher\0A *  algorithm.\0A *\0A * \5Cparam[in]      alg          PSA cipher algorithm identifier\0A * \5Cparam[in]      key_type     PSA key type\0A * \5Cparam[in,out]  key_bits     Size of the key in bits. The value provided in input\0A *                              might be updated if necessary.\0A * \5Cparam[out]     mode         Mbed TLS cipher mode\0A * \5Cparam[out]     cipher_id    Mbed TLS cipher algorithm identifier\0A *\0A * \5Creturn  On success \5Cc PSA_SUCCESS is returned and key_bits, mode and cipher_id\0A *          are properly updated.\0A *          \5Cc PSA_ERROR_NOT_SUPPORTED is returned if the cipher algorithm is not\0A *          supported.\0A */\0A\0Apsa_status_t mbedtls_cipher_values_from_psa(psa_algorithm_t alg, psa_key_type_t key_type,\0A                                            size_t *key_bits, mbedtls_cipher_mode_t *mode,\0A                                            mbedtls_cipher_id_t *cipher_id);\0A\0A#if defined(MBEDTLS_CIPHER_C)\0A/** Get Mbed TLS cipher information given the cipher algorithm PSA identifier\0A *  as well as the PSA type and size of the key to be used with the cipher\0A *  algorithm.\0A *\0A * \5Cparam       alg        PSA cipher algorithm identifier\0A * \5Cparam       key_type   PSA key type\0A * \5Cparam       key_bits   Size of the key in bits\0A * \5Cparam[out]  cipher_id  Mbed TLS cipher algorithm identifier\0A *\0A * \5Creturn  The Mbed TLS cipher information of the cipher algorithm.\0A *          \5Cc NULL if the PSA cipher algorithm is not supported.\0A */\0Aconst mbedtls_cipher_info_t *mbedtls_cipher_info_from_psa(\0A    psa_algorithm_t alg, psa_key_type_t key_type, size_t key_bits,\0A    mbedtls_cipher_id_t *cipher_id);\0A#endif /* MBEDTLS_CIPHER_C */\0A\0A/**\0A * \5Cbrief Set the key for a multipart symmetric encryption operation.\0A *\0A * \5Cnote The signature of this function is that of a PSA driver\0A *       cipher_encrypt_setup entry point. This function behaves as a\0A *       cipher_encrypt_setup entry point as defined in the PSA driver\0A *       interface specification for transparent drivers.\0A *\0A * \5Cparam[in,out] operation     The operation object to set up. It has been\0A *                              initialized as per the documentation for\0A *                              #psa_cipher_operation_t and not yet in use.\0A * \5Cparam[in] attributes        The attributes of the key to use for the\0A *                              operation.\0A * \5Cparam[in] key_buffer        The buffer containing the key context.\0A * \5Cparam[in] key_buffer_size   Size of the \5Cp key_buffer buffer in bytes.\0A * \5Cparam[in] alg               The cipher algorithm to compute\0A *                              (\5Cc PSA_ALG_XXX value such that\0A *                              #PSA_ALG_IS_CIPHER(\5Cp alg) is true).\0A *\0A * \5Cretval #PSA_SUCCESS \5Cemptydescription\0A * \5Cretval #PSA_ERROR_NOT_SUPPORTED \5Cemptydescription\0A * \5Cretval #PSA_ERROR_INSUFFICIENT_MEMORY \5Cemptydescription\0A * \5Cretval #PSA_ERROR_CORRUPTION_DETECTED \5Cemptydescription\0A */\0Apsa_status_t mbedtls_psa_cipher_encrypt_setup(\0A    mbedtls_psa_cipher_operation_t *operation,\0A    const psa_key_attributes_t *attributes,\0A    const uint8_t *key_buffer, size_t key_buffer_size,\0A    psa_algorithm_t alg);\0A\0A/**\0A * \5Cbrief Set the key for a multipart symmetric decryption operation.\0A *\0A * \5Cnote The signature of this function is that of a PSA driver\0A *       cipher_decrypt_setup entry point. This function behaves as a\0A *       cipher_decrypt_setup entry point as defined in the PSA driver\0A *       interface specification for transparent drivers.\0A *\0A * \5Cparam[in,out] operation     The operation object to set up. It has been\0A *                              initialized as per the documentation for\0A *                              #psa_cipher_operation_t and not yet in use.\0A * \5Cparam[in] attributes        The attributes of the key to use for the\0A *                              operation.\0A * \5Cparam[in] key_buffer        The buffer containing the key context.\0A * \5Cparam[in] key_buffer_size   Size of the \5Cp key_buffer buffer in bytes.\0A * \5Cparam[in] alg               The cipher algorithm to compute\0A *                              (\5Cc PSA_ALG_XXX value such that\0A *                              #PSA_ALG_IS_CIPHER(\5Cp alg) is true).\0A *\0A * \5Cretval #PSA_SUCCESS \5Cemptydescription\0A * \5Cretval #PSA_ERROR_NOT_SUPPORTED \5Cemptydescription\0A * \5Cretval #PSA_ERROR_INSUFFICIENT_MEMORY \5Cemptydescription\0A * \5Cretval #PSA_ERROR_CORRUPTION_DETECTED \5Cemptydescription\0A */\0Apsa_status_t mbedtls_psa_cipher_decrypt_setup(\0A    mbedtls_psa_cipher_operation_t *operation,\0A    const psa_key_attributes_t *attributes,\0A    const uint8_t *key_buffer, size_t key_buffer_size,\0A    psa_algorithm_t alg);\0A\0A/** Set the IV for a symmetric encryption or decryption operation.\0A *\0A * This function sets the IV (initialization vector), nonce\0A * or initial counter value for the encryption or decryption operation.\0A *\0A * \5Cnote The signature of this function is that of a PSA driver\0A *       cipher_set_iv entry point. This function behaves as a\0A *       cipher_set_iv entry point as defined in the PSA driver\0A *       interface specification for transparent drivers.\0A *\0A * \5Cparam[in,out] operation     Active cipher operation.\0A * \5Cparam[in] iv                Buffer containing the IV to use.\0A * \5Cparam[in] iv_length         Size of the IV in bytes. It is guaranteed by\0A *                              the core to be less or equal to\0A *                              PSA_CIPHER_IV_MAX_SIZE.\0A *\0A * \5Cretval #PSA_SUCCESS \5Cemptydescription\0A * \5Cretval #PSA_ERROR_INVALID_ARGUMENT\0A *         The size of \5Cp iv is not acceptable for the chosen algorithm,\0A *         or the chosen algorithm does not use an IV.\0A * \5Cretval #PSA_ERROR_INSUFFICIENT_MEMORY \5Cemptydescription\0A */\0Apsa_status_t mbedtls_psa_cipher_set_iv(\0A    mbedtls_psa_cipher_operation_t *operation,\0A    const uint8_t *iv, size_t iv_length);\0A\0A/** Encrypt or decrypt a message fragment in an active cipher operation.\0A *\0A * \5Cnote The signature of this function is that of a PSA driver\0A *       cipher_update entry point. This function behaves as a\0A *       cipher_update entry point as defined in the PSA driver\0A *       interface specification for transparent drivers.\0A *\0A * \5Cparam[in,out] operation     Active cipher operation.\0A * \5Cparam[in] input             Buffer containing the message fragment to\0A *                              encrypt or decrypt.\0A * \5Cparam[in] input_length      Size of the \5Cp input buffer in bytes.\0A * \5Cparam[out] output           Buffer where the output is to be written.\0A * \5Cparam[in]  output_size      Size of the \5Cp output buffer in bytes.\0A * \5Cparam[out] output_length    On success, the number of bytes\0A *                              that make up the returned output.\0A *\0A * \5Cretval #PSA_SUCCESS \5Cemptydescription\0A * \5Cretval #PSA_ERROR_BUFFER_TOO_SMALL\0A *         The size of the \5Cp output buffer is too small.\0A * \5Cretval #PSA_ERROR_INSUFFICIENT_MEMORY \5Cemptydescription\0A */\0Apsa_status_t mbedtls_psa_cipher_update(\0A    mbedtls_psa_cipher_operation_t *operation,\0A    const uint8_t *input, size_t input_length,\0A    uint8_t *output, size_t output_size, size_t *output_length);\0A\0A/** Finish encrypting or decrypting a message in a cipher operation.\0A *\0A * \5Cnote The signature of this function is that of a PSA driver\0A *       cipher_finish entry point. This function behaves as a\0A *       cipher_finish entry point as defined in the PSA driver\0A *       interface specification for transparent drivers.\0A *\0A * \5Cparam[in,out] operation     Active cipher operation.\0A * \5Cparam[out] output           Buffer where the output is to be written.\0A * \5Cparam[in]  output_size      Size of the \5Cp output buffer in bytes.\0A * \5Cparam[out] output_length    On success, the number of bytes\0A *                              that make up the returned output.\0A *\0A * \5Cretval #PSA_SUCCESS \5Cemptydescription\0A * \5Cretval #PSA_ERROR_INVALID_ARGUMENT\0A *         The total input size passed to this operation is not valid for\0A *         this particular algorithm. For example, the algorithm is a based\0A *         on block cipher and requires a whole number of blocks, but the\0A *         total input size is not a multiple of the block size.\0A * \5Cretval #PSA_ERROR_INVALID_PADDING\0A *         This is a decryption operation for an algorithm that includes\0A *         padding, and the ciphertext does not contain valid padding.\0A * \5Cretval #PSA_ERROR_BUFFER_TOO_SMALL\0A *         The size of the \5Cp output buffer is too small.\0A * \5Cretval #PSA_ERROR_INSUFFICIENT_MEMORY \5Cemptydescription\0A */\0Apsa_status_t mbedtls_psa_cipher_finish(\0A    mbedtls_psa_cipher_operation_t *operation,\0A    uint8_t *output, size_t output_size, size_t *output_length);\0A\0A/** Abort a cipher operation.\0A *\0A * Aborting an operation frees all associated resources except for the\0A * \5Cp operation structure itself. Once aborted, the operation object\0A * can be reused for another operation.\0A *\0A * \5Cnote The signature of this function is that of a PSA driver\0A *       cipher_abort entry point. This function behaves as a\0A *       cipher_abort entry point as defined in the PSA driver\0A *       interface specification for transparent drivers.\0A *\0A * \5Cparam[in,out] operation     Initialized cipher operation.\0A *\0A * \5Cretval #PSA_SUCCESS \5Cemptydescription\0A */\0Apsa_status_t mbedtls_psa_cipher_abort(mbedtls_psa_cipher_operation_t *operation);\0A\0A/** Encrypt a message using a symmetric cipher.\0A *\0A * \5Cnote The signature of this function is that of a PSA driver\0A *       cipher_encrypt entry point. This function behaves as a\0A *       cipher_encrypt entry point as defined in the PSA driver\0A *       interface specification for transparent drivers.\0A *\0A * \5Cparam[in] attributes        The attributes of the key to use for the\0A *                              operation.\0A * \5Cparam[in] key_buffer        The buffer containing the key context.\0A * \5Cparam[in] key_buffer_size   Size of the \5Cp key_buffer buffer in bytes.\0A * \5Cparam[in] alg               The cipher algorithm to compute\0A *                              (\5Cc PSA_ALG_XXX value such that\0A *                              #PSA_ALG_IS_CIPHER(\5Cp alg) is true).\0A * \5Cparam[in] iv                Buffer containing the IV for encryption. The\0A *                              IV has been generated by the core.\0A * \5Cparam[in] iv_length         Size of the \5Cp iv in bytes.\0A * \5Cparam[in] input             Buffer containing the message to encrypt.\0A * \5Cparam[in] input_length      Size of the \5Cp input buffer in bytes.\0A * \5Cparam[in,out] output        Buffer where the output is to be written.\0A * \5Cparam[in]  output_size      Size of the \5Cp output buffer in bytes.\0A * \5Cparam[out] output_length    On success, the number of bytes that make up\0A *                              the returned output. Initialized to zero\0A *                              by the core.\0A *\0A * \5Cretval #PSA_SUCCESS \5Cemptydescription\0A * \5Cretval #PSA_ERROR_NOT_SUPPORTED \5Cemptydescription\0A * \5Cretval #PSA_ERROR_INSUFFICIENT_MEMORY \5Cemptydescription\0A * \5Cretval #PSA_ERROR_CORRUPTION_DETECTED \5Cemptydescription\0A * \5Cretval #PSA_ERROR_BUFFER_TOO_SMALL\0A *         The size of the \5Cp output buffer is too small.\0A * \5Cretval #PSA_ERROR_INVALID_ARGUMENT\0A *         The size \5Cp iv_length is not acceptable for the chosen algorithm,\0A *         or the chosen algorithm does not use an IV.\0A *         The total input size passed to this operation is not valid for\0A *         this particular algorithm. For example, the algorithm is a based\0A *         on block cipher and requires a whole number of blocks, but the\0A *         total input size is not a multiple of the block size.\0A * \5Cretval #PSA_ERROR_INVALID_PADDING\0A *         This is a decryption operation for an algorithm that includes\0A *         padding, and the ciphertext does not contain valid padding.\0A */\0Apsa_status_t mbedtls_psa_cipher_encrypt(const psa_key_attributes_t *attributes,\0A                                        const uint8_t *key_buffer,\0A                                        size_t key_buffer_size,\0A                                        psa_algorithm_t alg,\0A                                        const uint8_t *iv,\0A                                        size_t iv_length,\0A                                        const uint8_t *input,\0A                                        size_t input_length,\0A                                        uint8_t *output,\0A                                        size_t output_size,\0A                                        size_t *output_length);\0A\0A/** Decrypt a message using a symmetric cipher.\0A *\0A * \5Cnote The signature of this function is that of a PSA driver\0A *       cipher_decrypt entry point. This function behaves as a\0A *       cipher_decrypt entry point as defined in the PSA driver\0A *       interface specification for transparent drivers.\0A *\0A * \5Cparam[in]  attributes       The attributes of the key to use for the\0A *                              operation.\0A * \5Cparam[in]  key_buffer       The buffer containing the key context.\0A * \5Cparam[in]  key_buffer_size  Size of the \5Cp key_buffer buffer in bytes.\0A * \5Cparam[in]  alg              The cipher algorithm to compute\0A *                              (\5Cc PSA_ALG_XXX value such that\0A *                              #PSA_ALG_IS_CIPHER(\5Cp alg) is true).\0A * \5Cparam[in]  input            Buffer containing the iv and the ciphertext.\0A * \5Cparam[in]  input_length     Size of the \5Cp input buffer in bytes.\0A * \5Cparam[out] output           Buffer where the output is to be written.\0A * \5Cparam[in]  output_size      Size of the \5Cp output buffer in bytes.\0A * \5Cparam[out] output_length    On success, the number of bytes that make up\0A *                              the returned output. Initialized to zero\0A *                              by the core.\0A *\0A * \5Cretval #PSA_SUCCESS \5Cemptydescription\0A * \5Cretval #PSA_ERROR_NOT_SUPPORTED \5Cemptydescription\0A * \5Cretval #PSA_ERROR_INSUFFICIENT_MEMORY \5Cemptydescription\0A * \5Cretval #PSA_ERROR_CORRUPTION_DETECTED \5Cemptydescription\0A * \5Cretval #PSA_ERROR_BUFFER_TOO_SMALL\0A *         The size of the \5Cp output buffer is too small.\0A * \5Cretval #PSA_ERROR_INVALID_ARGUMENT\0A *         The size of \5Cp iv is not acceptable for the chosen algorithm,\0A *         or the chosen algorithm does not use an IV.\0A *         The total input size passed to this operation is not valid for\0A *         this particular algorithm. For example, the algorithm is a based\0A *         on block cipher and requires a whole number of blocks, but the\0A *         total input size is not a multiple of the block size.\0A * \5Cretval #PSA_ERROR_INVALID_PADDING\0A *         This is a decryption operation for an algorithm that includes\0A *         padding, and the ciphertext does not contain valid padding.\0A */\0Apsa_status_t mbedtls_psa_cipher_decrypt(const psa_key_attributes_t *attributes,\0A                                        const uint8_t *key_buffer,\0A                                        size_t key_buffer_size,\0A                                        psa_algorithm_t alg,\0A                                        const uint8_t *input,\0A                                        size_t input_length,\0A                                        uint8_t *output,\0A                                        size_t output_size,\0A                                        size_t *output_length);\0A\0A#endif /* PSA_CRYPTO_CIPHER_H */\0A\00" }
