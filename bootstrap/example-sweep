#!/usr/bin/env bash
# THE DEPRECATION SCOREBOARD.
#
# Runs every `examples/` project and reports where the self-hosted
# compiler still falls short. This exists because the hand-maintained
# gap table in DESIGN.md was wrong three times running, always in the
# direction of understating what was left: it listed four rows while six
# of nine examples failed, and it named causes ("check rejects
# contracts") that had not been true for some time. A list you have to
# remember to update is not a source of truth. This is.
#
# The reference is each example's CHECKED-IN `expected.txt`, not a live
# run of the other compiler. That is what lets this work with no Rust
# toolchain present, which it could not do before 2026-08-21.
#
# For each example:
#   1. the SELF-HOSTED compiler emits IR, which is linked and run
#   2. its output must match `expected.txt` exactly
#   3. IF the real compiler is present, it is built and run too, and ITS
#      output must match `expected.txt` as well
#
# Step 3 is what preserves the differential test. Two implementations
# both required to match one fixed recording are two implementations
# required to agree with each other -- and unlike a live comparison,
# this also catches the case where BOTH drift together, because the
# recording does not move with them.
#
# A self-hosted failure is reported with its first error line, which is
# the whole point — the output is a to-do list, not a pass/fail gate.
#
# Run from the repo root after `plum build bootstrap/self_host -o
# sh.real`. `cargo build --release` is optional and only adds step 3.
set -uo pipefail

root="$(cd "$(dirname "${BASH_SOURCE[0]}")/.." && pwd)"
cd "$root"
work="$(mktemp -d -t plum-sweep-XXXXXX)"
trap 'rm -rf "$work"' EXIT

plum=./target/release/plum

# Examples that cannot be run non-interactively, with the reason. They
# are still EMITTED and reported on — only the output comparison is
# skipped, so a compile regression in one is still caught.
declare -A no_run=(
    [asteroids]="opens a window (raylib)"
)

# Examples the self-hosted compiler is not expected to build YET, with
# the reason. These still report FAIL and still count as failing -- the
# annotation only saves the reader from re-deriving why. Silencing them
# is what turned the old gap table into fiction; the point here is that
# the reason travels WITH the failure instead of in a list somewhere
# else.
# Empty, for now: every example builds under both compilers. Kept
# rather than deleted because the next gap found should be annotated
# here, next to its reason, instead of in a list somewhere else.
declare -A known=()

# Extra flags an example needs to LINK, passed to both compilers. Kept
# here rather than inferred: `asteroids` reaches raylib through its own
# `native/` shim, and which library that shim needs is a property of the
# example, not something a compiler can work out.
declare -A link_flags=(
    [asteroids]="--link-lib raylib"
)

ok=0
fail=0
skipped_link=0
emit_only=0

# A project is a DIRECTORY, so this walks directories -- and for a long
# time it walked ONLY directories, which meant a loose `.plum` file
# sitting beside them was swept up by nothing at all. `overview.plum`
# lived there for months, did not compile against the language as it now
# is, and the sweep reported "8 matching, 0 failing" the whole time
# without mentioning it existed.
#
# A file here is either a project that lost its directory or something
# nobody is checking. Either way it should be said out loud rather than
# skipped in silence.
loose="$(find examples -maxdepth 1 -name '*.plum' 2>/dev/null)"
if [ -n "$loose" ]; then
    for f in $loose; do
        printf 'FAIL  %-24s a loose .plum file under examples/ is checked by nothing
' "$(basename "$f")"
        fail=$((fail + 1))
    done
fi

for dir in examples/*/; do
    name="$(basename "$dir")"
    [ -f "$dir/main.plum" ] || continue

    # `--link-c` only when the example actually HAS a native shim: most
    # do not, and clang is happy to fail on a path that is not there.
    # `compile-ir` wants the C FILES, unlike `build`, which scans the
    # directory itself. Most examples have no shim at all.
    native_flag=""
    if [ -d "$dir/native" ]; then
        for c in "$dir"/native/*.c; do
            [ -e "$c" ] && native_flag="$native_flag --link-c $c"
        done
    fi

    # 1. self-hosted emit
    if ! SH_MEM="${SH_MEM:-256M}" SH_TIMEOUT="${SH_TIMEOUT:-240}" ./sh emit-llvm "$dir" > "$work/$name.ll" 2>"$work/$name.emit_err"; then
        reason="$(head -n 1 "$work/$name.emit_err" 2>/dev/null)"
        [ -n "$reason" ] || reason="$(grep -m1 -v '^;' "$work/$name.ll" 2>/dev/null)"
        printf 'FAIL  %-24s %s%s\n' "$name" "${reason:-emit failed}" "${known[$name]:+  [known: ${known[$name]}]}"
        fail=$((fail + 1))
        continue
    fi
    # `sh` reports checker errors on stdout and still exits 0, so the
    # emitted text is what says whether it really worked.
    if ! head -n 1 "$work/$name.ll" | grep -q '^;'; then
        printf 'FAIL  %-24s %s%s\n' "$name" "$(head -n 1 "$work/$name.ll")" "${known[$name]:+  [known: ${known[$name]}]}"
        fail=$((fail + 1))
        continue
    fi

    # An example that cannot be run non-interactively is still LINKED by
    # both compilers -- "the self-hosted output is a working binary" is
    # most of what running it would have told us, and it catches a
    # codegen regression that emit alone would not.
    # The self-hosted IR is linked with clang directly. This used to go
    # through `plum compile-ir`, which meant a Rust binary was needed
    # for a step that is just a call to clang.
    # `link_flags` is written in the REAL compiler's spelling, since it
    # is passed to `plum build` too. clang wants the C spelling:
    # `--link-lib raylib` is `-lraylib`, and `--link-c foo.c` is just
    # the path.
    clang_flags="$(printf '%s %s' "${link_flags[$name]:-}" "$native_flag" | sed 's/--link-lib */-l/g; s/--link-c *//g')"

    # An example may reach a SYSTEM library through its own `native/`
    # shim -- `asteroids` includes `raylib.h`. Those headers are not
    # installed everywhere, and notably not on a clean CI runner: this
    # harness passed locally and failed there on exactly that, because
    # raylib happened to be installed on the developer's machine.
    #
    # The IR is still emitted and still checked, which is the COMPILER
    # coverage. Only the final link is skipped, and the reason is
    # printed rather than the example quietly disappearing.
    headers_missing=""
    if [ -d "$dir/native" ]; then
        for c in "$dir"/native/*.c; do
            [ -e "$c" ] || continue
            if ! clang -fsyntax-only "$c" > "$work/$name.hdr" 2>&1; then
                headers_missing="$(grep -oE "'[^']+\.h' file not found" "$work/$name.hdr" | head -1)"
                [ -n "$headers_missing" ] || headers_missing="$(head -1 "$work/$name.hdr")"
                break
            fi
        done
    fi

    link_self() {
        clang -O2 -Wno-override-module "$work/$name.ll" \
            native_stdlib/compat_shim.c native_stdlib/dir_shim.c \
            native_stdlib/io_shim.c native_stdlib/os_shim.c \
            native_stdlib/process_shim.c native_stdlib/thread_shim.c \
            $clang_flags -lm -o "$work/$name.bin"
    }

    if [ -n "$headers_missing" ]; then
        printf 'EMIT  %-24s IR ok; link skipped (%s)\n' "$name" "$headers_missing"
        skipped_link=$((skipped_link + 1))
        continue
    fi

    if [ -n "${no_run[$name]:-}" ]; then
        if ! link_self > "$work/$name.link_err" 2>&1; then
            printf 'FAIL  %-24s emitted IR did not link: %s\n' "$name" "$(head -n 1 "$work/$name.link_err")"
            fail=$((fail + 1))
            continue
        fi
        printf 'LINK  %-24s produces a binary (not run: %s)\n' "$name" "${no_run[$name]}"
        emit_only=$((emit_only + 1))
        continue
    fi

    # The reference is the CHECKED-IN recording, not a live run of the
    # other compiler -- see this script's own header for why.
    if [ ! -f "$dir/expected.txt" ]; then
        printf 'FAIL  %-24s no expected.txt (regenerate with bootstrap/record-examples)\n' "$name"
        fail=$((fail + 1))
        continue
    fi
    ref_out="$(cat "$dir/expected.txt")"

    if ! link_self > "$work/$name.link_err" 2>&1; then
        printf 'FAIL  %-24s emitted IR did not link: %s\n' "$name" "$(head -n 1 "$work/$name.link_err")"
        fail=$((fail + 1))
        continue
    fi
    act_out="$(cd "$work" && "./$name.bin" 2>&1)"

    if [ "$ref_out" == "$act_out" ]; then
        printf 'OK    %-24s\n' "$name"
        ok=$((ok + 1))
    else
        printf 'DIFF  %-24s output differs from expected.txt\n' "$name"
        diff <(printf '%s\n' "$ref_out") <(printf '%s\n' "$act_out") | head -n 10 | sed 's/^/        /'
        fail=$((fail + 1))
    fi
done

echo
if [ "$skipped_link" -gt 0 ]; then
    echo "examples: $ok matching, $emit_only emit-only, $skipped_link emitted-but-not-linked, $fail failing"
else
    echo "examples: $ok matching, $emit_only emit-only, $fail failing"
fi
[ "$fail" -eq 0 ]
