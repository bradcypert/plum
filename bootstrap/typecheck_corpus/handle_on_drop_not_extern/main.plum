// Rejected: `on_drop` must be an `extern "C"` function. A Plum one runs
// while the value is being freed, and requiring extern is also what
// makes the `declare` come from exactly one place -- the extern block --
// so the handle declaration cannot emit a duplicate.
handle Res { on_drop: my_close }
let my_close (h: Int): Unit = println(h.to_string())
let main (): Unit = println("unreachable")
