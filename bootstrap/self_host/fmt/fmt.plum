use Os;

// `plum fmt` -- the formatter.
//
// It is `lexer.relex` with opinions. They are:
//   * the line a statement, item or match arm begins on is indented
//     four spaces per enclosing block, and a closing brace one level
//     out from what it closes;
//   * a run of comment lines is indented with what it documents;
//   * a run of blank lines collapses to one;
//   * a comma has no space before it and one space after, and so does
//     a colon -- except that a colon's LEADING space is left alone,
//     because `require c : "msg"` spells it that way and nothing at the
//     token level separates that from `x: Int`;
//   * nothing sits just inside a bracket: `f( a )` becomes `f(a)`;
//   * a binary operator gets one space on each side, and a UNARY minus
//     does not -- `a-b` becomes `a - b` while `-n` is left alone;
//   * a line that CONTINUES a construct begun on an earlier line is
//     indented four past the line that construct started on.
//
// Everything else in the file is passed through byte for byte.
//
// Every one of those was MEASURED against the corpus before being
// written, not imported from another language. The comma rule, for
// instance: 20,585 commas, and the only ones not already followed by a
// space were inside string literals but for a single `[1,2,3]`.
//
// It also places CLOSING BRACES, and `} else {` with them: a `}` sits
// one level out from the statements it closes, which is exact rather
// than guessed because `PBlock` records where its own braces are.
//
// Match and `select` arms are placed by the SAME rule and the same
// function. An arm sits inside braces exactly as a statement does, so
// once `MatchArmNode` carried a start offset and `EMatch` carried its
// closing brace, arms needed no rule of their own -- they call
// `block_indent` and inherit its refusals too.
//
// The last of those rules is newer than the rest, and for most of this
// file's life the header said the opposite: that a line belonging to a
// construct with no braces of its own -- the `=` continuation of a long
// `let`, a `|>` chain broken across lines, a multi-line call's
// arguments -- could not be placed, because statements and items carried
// source ranges and EXPRESSIONS DID NOT. That was true, and it was the
// right restraint while it held: a formatter that reflows inside an
// expression it cannot see the shape of will move code it has
// mis-attributed.
//
// `parser.ExprSpan` is what changed. The parser now records where every
// expression begins and ends, so the construct a continuation line
// belongs to has a name, and the line can be placed by measuring rather
// than guessed at.
//
// What did NOT change is the stance. This still only moves lines it can
// name, and it still refuses four kinds it cannot: a line inside a
// multi-line string token, a line whose anchor construct starts partway
// along its own line, a hand-aligned line sitting deeper than the grid
// answer, and an item's `require`/`ensure`/`=` header lines. Each
// refusal is there because the corpus either said nothing or disagreed
// with itself, and each is written down where it happens.
//
// It still REFLOWS nothing: no line is ever split or joined. Every rule
// here changes leading whitespace and the gaps between tokens on a
// line, and that is the whole of it.
//
// The rule is not invented. Across the 242 `.plum` files in this repo,
// indentation is already a multiple of four everywhere, there is not one
// tab, not one line with trailing whitespace, and not one file missing
// its final newline. The corpus IS the style guide; this encodes what it
// already does. The test of that is `bootstrap/fmt-check`: formatting
// every file in the repo must change nothing.

// `owns_comments` says whether the run of comment lines above this one
// belongs to it. A statement and an item own theirs -- a comment above
// them documents them. A CLOSING BRACE does not: the comments above a
// `}` are the last thing inside the block, documenting the code they
// follow, and pulling them out to the brace's level moves them out of
// the body they belong to. That is a regression this had before the
// flag existed, and five files in the repo caught it.
pub struct Edit { pub line_start: Int, pub old_indent: Int, pub indent: Int, pub owns_comments: Bool }

// The indentation edits an item implies, innermost last. An item's own
// line goes to column zero; the statements of a block found at depth `d`
// go to `4 * d`.
pub let item_edits (chars: Array[String]) (it: parser.ItemNode) (acc: Array[Edit]): Array[Edit] =
    if it.start < 0 { acc }
    else {
        let a = acc.push(edit_at(chars, it.start, 0));
        match it.kind {
            IKLet(def) => expr_edits(chars, def.body, 1, a),
            _ => a,
        }
    }

// `depth` is the indent level for statements of a block encountered
// HERE. A block's own statements sit at `depth`, and anything nested
// inside one of them at `depth + 1`.
let expr_edits (chars: Array[String]) (e: parser.PExpr) (depth: Int) (acc: Array[Edit]): Array[Edit] =
    match e {
        EBlock(b) => block_edits(chars, b, depth, acc),
        EIf(c, t, els) => {
            let a1 = expr_edits(chars, c, depth, acc);
            let a2 = block_edits(chars, t, depth, a1);
            match els { Some(x) => expr_edits(chars, x, depth, a2), None => a2 }
        },
        EMatch(sc, arms, close) => arm_edits(chars, arms, 0, depth, arm_line_edits(chars, arm_starts(arms, 0, []), close, expr_edits(chars, sc, depth, acc))),
        ESelect(arms, close) => select_edits(chars, arms, 0, depth, arm_line_edits(chars, select_arm_starts(arms, 0, []), close, acc)),
        EFor(_, iter, body) => block_edits(chars, body, depth, expr_edits(chars, iter, depth, acc)),
        EUnsafe(b) => block_edits(chars, b, depth, acc),
        ESpawn(b) => block_edits(chars, b, depth, acc),
        EClosure(_, body) => expr_edits(chars, body, depth, acc),
        EUnary(_, a) => expr_edits(chars, a, depth, acc),
        EBinary(_, l, r) => expr_edits(chars, r, depth, expr_edits(chars, l, depth, acc)),
        EField(b, _) => expr_edits(chars, b, depth, acc),
        ECall(callee, args) => list_edits(chars, args, 0, depth, expr_edits(chars, callee, depth, acc)),
        EGenericInst(b, _) => expr_edits(chars, b, depth, acc),
        EIndex(b, i) => expr_edits(chars, i, depth, expr_edits(chars, b, depth, acc)),
        ETuple(xs) => list_edits(chars, xs, 0, depth, acc),
        EArray(xs) => list_edits(chars, xs, 0, depth, acc),
        EStructLit(_, fields, spread) => {
            let a = field_edits(chars, fields, 0, depth, acc);
            match spread { Some(x) => expr_edits(chars, x, depth, a), None => a }
        },
        EInt(_) => acc,
        EFloat(_) => acc,
        EStr(_) => acc,
        EBool(_) => acc,
        EIdent(_, _) => acc,
    }

// A block's statements all share one indent, and it is read from the
// source rather than counted: it is the indent of the line the block's
// OPENING BRACE sits on, plus four.
//
// Counting depth instead was the first attempt and it was wrong, in a
// way worth recording. It assumed a construct begins at `4 * depth`,
// which is false the moment a body is written on a continuation line:
//
//     let drain (..): Int =
//         if left <= 0 { acc }
//         else {
//             let got = select { .. };
//
// The `else` block is at depth 1 by the tree and at column 8 on the
// page, because the author put the `if` on its own line at column 4 --
// an indent chosen by hand that no span records. Anchoring to the brace
// needs no expression spans at all, and gets both shapes right.
//
// If the character before the first statement is not a brace, this
// block's shape is not one we can position, and it is left alone.
// Refusing is always available and never wrong.
let block_edits (chars: Array[String]) (b: parser.PBlock) (depth: Int) (acc: Array[Edit]): Array[Edit] = {
    let a = match block_indent(chars, b.starts) {
        None => acc,
        // The closing brace belongs one level OUT from the statements
        // it closes -- which is known exactly, because it is the indent
        // just computed minus four. No scanning and no guessing: the
        // block records where its own brace is.
        Some(indent) => close_brace_edit(chars, b.close, indent - 4, stmt_line_edits(chars, b.starts, 0, indent, acc)),
    };
    let a2 = stmt_body_edits(chars, b.stmts, 0, depth + 1, a);
    match b.tail { Some(t) => expr_edits(chars, t, depth + 1, a2), None => a2 }
}

// Only when the brace BEGINS its line. A `}` that shares a line with
// code -- `if a { b } else { c }` -- has no indent of its own, exactly
// as a statement in that position has none.
let close_brace_edit (chars: Array[String]) (close: Int) (indent: Int) (acc: Array[Edit]): Array[Edit] =
    if close < 0 || indent < 0 { acc }
    else if !first_on_line(chars, close) { acc }
    else { acc.push(edit_kind(chars, close, indent, false)) }

let block_indent (chars: Array[String]) (starts: Array[Int]): Option[Int] =
    if Array.is_empty(starts) || starts[0] < 0 { None }
    else {
        let brace = back_over_trivia(chars, starts[0] - 1);
        if brace < 0 { None }
        else if chars[brace] != "{" { None }
        else {
            let col = count_spaces(chars, line_start_of(chars, brace), 0);
            // A brace whose line is indented off the four-space grid is
            // sitting on a CONTINUATION line, not on the line its
            // construct began:
            //
            //     else if nodes[i].path == path && nodes[i].def_offset >= 0
            //          && nodes[i].def_offset <= off && !seen.contains(..) {
            //
            // That `{` is on a line indented nine, aligned under the
            // condition by hand. Anchoring to it would indent the body
            // to thirteen. The construct really begins on the `else if`
            // line, which is four -- and finding THAT means knowing
            // where the `if` starts.
            //
            // That span EXISTS now (`parser.ExprSpan`), and this still
            // refuses, on purpose. The body of such a block is written
            // relative to a column its author chose; the corpus has two
            // of these and they are consistent with themselves and with
            // nothing else. Refusing leaves them exactly as written,
            // which is the outcome the measurement supports.
            //
            // So this refuses. Every statement indent in the corpus is a
            // multiple of four; a brace line that is not is one of these
            // alignment lines, and a formatter that cannot name the
            // construct should leave the body alone rather than move it
            // somewhere confidently wrong.
            if col % 4 != 0 { None } else { Some(col + 4) }
        }
    }

// Backwards over whitespace and whole comment LINES. A `//` comment
// runs to the end of its line, so anything to the left of one on the
// same line is code -- which is why this steps to the line start and
// keeps going rather than trying to scan a comment right to left.
let back_over_trivia (chars: Array[String]) (at: Int): Int =
    if at < 0 { 0 - 1 }
    else if String.is_ascii_ws(chars[at]) { back_over_trivia(chars, at - 1) }
    else if in_line_comment(chars, line_start_of(chars, at), at) { back_over_trivia(chars, line_start_of(chars, at) - 1) }
    else { at }

let in_line_comment (chars: Array[String]) (ls: Int) (at: Int): Bool =
    if ls >= at { false }
    else if chars[ls] == "/" && ls + 1 <= at && chars[ls + 1] == "/" { true }
    else { in_line_comment(chars, ls + 1, at) }

let stmt_line_edits (chars: Array[String]) (starts: Array[Int]) (i: Int) (indent: Int) (acc: Array[Edit]): Array[Edit] =
    if i >= starts.len() { acc }
    // A synthetic statement -- contract sugar builds those -- has no
    // source to indent.
    else if starts[i] < 0 { stmt_line_edits(chars, starts, i + 1, indent, acc) }
    // Only a statement that BEGINS its line owns that line's indent.
    // `if n <= 0 { xs } else { .. }` has a block whose one statement
    // shares a line with the brace and with the `if`; moving that line
    // would be moving the `if`, which this cannot see and does not own.
    else if !first_on_line(chars, starts[i]) { stmt_line_edits(chars, starts, i + 1, indent, acc) }
    else { stmt_line_edits(chars, starts, i + 1, indent, acc.push(edit_at(chars, starts[i], indent))) }

let first_on_line (chars: Array[String]) (offset: Int): Bool = {
    let ls = line_start_of(chars, offset);
    ls + count_spaces(chars, ls, 0) == offset
}

let stmt_body_edits (chars: Array[String]) (stmts: Array[parser.PStmt]) (i: Int) (depth: Int) (acc: Array[Edit]): Array[Edit] =
    if i >= stmts.len() { acc }
    else {
        let a = match stmts[i] {
            SLet(_, _, _, v) => expr_edits(chars, v, depth, acc),
            SAssign(_, v) => expr_edits(chars, v, depth, acc),
            SExpr(v) => expr_edits(chars, v, depth, acc),
        };
        stmt_body_edits(chars, stmts, i + 1, depth, a)
    }

let list_edits (chars: Array[String]) (xs: Array[parser.PExpr]) (i: Int) (depth: Int) (acc: Array[Edit]): Array[Edit] =
    if i >= xs.len() { acc } else { list_edits(chars, xs, i + 1, depth, expr_edits(chars, xs[i], depth, acc)) }

let field_edits (chars: Array[String]) (fs: Array[parser.FieldInitNode]) (i: Int) (depth: Int) (acc: Array[Edit]): Array[Edit] =
    if i >= fs.len() { acc } else { field_edits(chars, fs, i + 1, depth, expr_edits(chars, fs[i].value, depth, acc)) }

// An arm is positioned exactly the way a statement is, and by the same
// function: arms sit inside braces, so the indent is the one their
// opening brace's line implies. `block_indent` already knows how to
// work that out, and how to REFUSE when the brace is on a continuation
// line -- so arms inherit both behaviours instead of getting a second,
// slightly different rule.
let arm_line_edits (chars: Array[String]) (starts: Array[Int]) (close: Int) (acc: Array[Edit]): Array[Edit] =
    match block_indent(chars, starts) {
        None => acc,
        // And the match's own closing brace, one level out from its
        // arms -- the same relationship a block's `}` has to its
        // statements, so the same call closes it.
        Some(indent) => close_brace_edit(chars, close, indent - 4, stmt_line_edits(chars, starts, 0, indent, acc)),
    }

let arm_starts (arms: Array[parser.MatchArmNode]) (i: Int) (acc: Array[Int]): Array[Int] =
    if i >= arms.len() { acc } else { arm_starts(arms, i + 1, acc.push(arms[i].start)) }

let select_arm_starts (arms: Array[parser.SelectArmNode]) (i: Int) (acc: Array[Int]): Array[Int] =
    if i >= arms.len() { acc } else { select_arm_starts(arms, i + 1, acc.push(arms[i].start)) }

let arm_edits (chars: Array[String]) (arms: Array[parser.MatchArmNode]) (i: Int) (depth: Int) (acc: Array[Edit]): Array[Edit] =
    if i >= arms.len() { acc }
    else {
        let a = match arms[i].guard { Some(g) => expr_edits(chars, g, depth, acc), None => acc };
        arm_edits(chars, arms, i + 1, depth, expr_edits(chars, arms[i].body, depth + 1, a))
    }

let select_edits (chars: Array[String]) (arms: Array[parser.SelectArmNode]) (i: Int) (depth: Int) (acc: Array[Edit]): Array[Edit] =
    if i >= arms.len() { acc }
    else {
        let a = expr_edits(chars, arms[i].expr, depth, acc);
        select_edits(chars, arms, i + 1, depth, expr_edits(chars, arms[i].body, depth + 1, a))
    }

// --- Applying edits ---

// The edit for the line `offset` sits on. `old_indent` is how many
// leading spaces that line already has, so applying an edit is a
// splice rather than a re-render.
let edit_at (chars: Array[String]) (offset: Int) (indent: Int): Edit = edit_kind(chars, offset, indent, true)

let edit_kind (chars: Array[String]) (offset: Int) (indent: Int) (owns: Bool): Edit = {
    let ls = line_start_of(chars, offset);
    Edit { line_start: ls, old_indent: count_spaces(chars, ls, 0), indent: indent, owns_comments: owns }
}

let line_start_of (chars: Array[String]) (offset: Int): Int =
    if offset <= 0 { 0 } else if chars[offset - 1] == "\n" { offset } else { line_start_of(chars, offset - 1) }

let count_spaces (chars: Array[String]) (at: Int) (n: Int): Int =
    if at + n >= chars.len() { n } else if chars[at + n] == " " { count_spaces(chars, at, n + 1) } else { n }

pub let spaces (n: Int): String = if n <= 0 { "" } else { " ".concat(spaces(n - 1)) }

// Rebuilds the source with each edited line's leading spaces replaced.
//
// The walk produces edits depth-first, not in source order, so rather
// than sorting them they go into a map keyed by the line they affect
// and the SOURCE is walked once, in order, asking each line whether it
// has an edit. That also settles duplicates for free: an item whose
// whole body is on one line produces an edit for that line from the
// item and another from the block, and the first one written wins,
// which is the outer construct -- the one that decides where the line
// starts.
pub let apply_edits (chars: Array[String]) (edits: Array[Edit]): String = {
    let empty: Map[Int, Int] = Map.new(());
    let by_line = index_edits(with_comment_runs(chars, edits, 0, edits), 0, empty);
    walk_lines(chars, by_line, 0, false, "")
}

// A comment belongs to what it documents, so it is indented with it.
//
// For every line this is about to indent, the run of comment-ONLY lines
// directly above it gets the same indent. The run stops at anything
// that is not a comment, and so at a blank line -- a blank line is how
// people separate a comment from the code below it, so a comment above
// one is documenting something else, or nothing.
//
// A comment sharing a line with code is not touched: that line's indent
// belongs to the code, and has already been decided.
let with_comment_runs (chars: Array[String]) (edits: Array[Edit]) (i: Int) (acc: Array[Edit]): Array[Edit] =
    if i >= edits.len() { acc }
    else if !edits[i].owns_comments { with_comment_runs(chars, edits, i + 1, acc) }
    else { with_comment_runs(chars, edits, i + 1, run_above(chars, edits[i].line_start, edits[i].indent, acc)) }

let run_above (chars: Array[String]) (line_start: Int) (indent: Int) (acc: Array[Edit]): Array[Edit] =
    if line_start <= 0 { acc }
    else {
        let prev = line_start_of(chars, line_start - 1);
        if !is_comment_line(chars, prev) { acc }
        else {
            run_above(chars, prev, indent,
                acc.push(Edit { line_start: prev, old_indent: count_spaces(chars, prev, 0), indent: indent, owns_comments: true }))
        }
    }

// Comment-only: the first thing on the line is `//`. A blank line is
// NOT one, which is what stops a run at a paragraph break.
let is_comment_line (chars: Array[String]) (ls: Int): Bool = {
    let at = ls + count_spaces(chars, ls, 0);
    at + 1 < chars.len() && chars[at] == "/" && chars[at + 1] == "/"
}

let index_edits (edits: Array[Edit]) (i: Int) (m: Map[Int, Int]): Map[Int, Int] =
    if i >= edits.len() { m }
    else if Map.contains(m, edits[i].line_start) { index_edits(edits, i + 1, m) }
    else { index_edits(edits, i + 1, Map.insert(m, edits[i].line_start, edits[i].indent)) }

// One pass over the source. At the start of each line, either the line
// has an edit -- in which case its existing leading spaces are dropped
// and the wanted indent written instead -- or it is copied untouched.
// `prev_blank` carries the second opinion: a run of blank lines
// collapses to one.
//
// The corpus is nearly unanimous -- 1,586 runs of a single blank line
// against two runs of a double -- which is why this is a rule at all
// rather than a preference. It is also the first rule here that changes
// something other than leading whitespace, which is why `fmt-check`
// checks the TOKEN sequence rather than comparing stripped lines.
let walk_lines (chars: Array[String]) (by_line: Map[Int, Int]) (at: Int) (prev_blank: Bool) (acc: String): String =
    if at >= chars.len() { acc }
    else if is_blank_line(chars, at) {
        let e = line_end(chars, at);
        if prev_blank { walk_lines(chars, by_line, e, true, acc) }
        else { walk_lines(chars, by_line, e, true, acc.concat(slice(chars, at, e))) }
    }
    else {
        match Map.get(by_line, at) {
            None => {
                let e = line_end(chars, at);
                walk_lines(chars, by_line, e, false, acc.concat(slice(chars, at, e)))
            },
            Some(indent) => {
                let sp = count_spaces(chars, at, 0);
                let e = line_end(chars, at);
                // A blank line is left alone: it has no content to
                // indent, and writing spaces into it would be the
                // trailing whitespace this repo does not have.
                if at + sp >= e { walk_lines(chars, by_line, e, false, acc.concat(slice(chars, at, e))) }
                else { walk_lines(chars, by_line, e, false, acc.concat(spaces(indent)).concat(slice(chars, at + sp, e))) }
            },
        }
    }

// Whitespace to the end of the line, and nothing else.
let is_blank_line (chars: Array[String]) (at: Int): Bool = at + count_spaces_ws(chars, at, 0) >= line_end_no_nl(chars, at)

let count_spaces_ws (chars: Array[String]) (at: Int) (n: Int): Int =
    if at + n >= chars.len() { n }
    else if chars[at + n] == "\n" { n }
    else if String.is_ascii_ws(chars[at + n]) { count_spaces_ws(chars, at, n + 1) }
    else { n }

let line_end_no_nl (chars: Array[String]) (at: Int): Int =
    if at >= chars.len() { at } else if chars[at] == "\n" { at } else { line_end_no_nl(chars, at + 1) }

// Through the newline, so the caller always resumes at a line start.
let line_end (chars: Array[String]) (at: Int): Int =
    if at >= chars.len() { at } else if chars[at] == "\n" { at + 1 } else { line_end(chars, at + 1) }

let slice (chars: Array[String]) (from: Int) (to: Int): String =
    Array.concat_all(Array.slice(chars, from, to))

// The whole formatter: parse, collect what the spans say each line's
// indent should be, apply -- and repeat until nothing moves.
//
// One pass is not enough, and the reason is worth stating. A block
// anchors to the indent of the line its brace is on, read from the
// SOURCE. So when a pass moves an outer construct, every block inside
// it was anchored to where that construct used to be, and needs another
// pass to follow. Each pass settles one more level of nesting, so this
// converges; the cap is there because a formatter that does not
// terminate is worse than one that gives up.
//
// Threading the newly ASSIGNED indent down instead of re-reading the
// source would settle it in one pass. That is the better design and it
// is not this one: it needs to know which line a block's brace will end
// up on, which is an expression-span question again.
pub let format (path: String) (src: String): String = format_pass(path, src, 8)

let format_pass (path: String) (src: String) (fuel: Int): String =
    if fuel <= 0 { src }
    else {
        let next = format_once(path, normalize_gaps(src));
        if next == src { src } else { format_pass(path, next, fuel - 1) }
    }

// --- Spacing between tokens, on one line ---
//
// The second kind of rule here, and the first that rewrites INSIDE a
// line rather than at the front of one. It works on the gaps between
// tokens, which is what makes it safe to state: a gap is by definition
// not inside a string or a comment, so "no space before a comma" cannot
// reach into `",a".split(",")` the way a text substitution would.
//
// Two rules, both measured rather than imported. Across the corpus,
// with comments stripped: 20,585 commas, of which the only ones not
// followed by a space are inside string literals but for a single
// `[1,2,3]`; and no space appears before a comma or before a closing
// paren anywhere outside a string.
//
// A gap containing a NEWLINE is left alone -- that is line structure,
// and belongs to the indent pass. So is a gap containing a comment: a
// trailing `// ...` sets its own distance from the code.
pub let normalize_gaps (src: String): String = {
    let lexed = lexer.tokenize_spanned(src);
    let chars = chars_of(src);
    gaps_acc(chars, lexed, 0, "")
}

let gaps_acc (chars: Array[String]) (lexed: lexer.LexedSource) (i: Int) (acc: String): String =
    if i >= lexed.tokens.len() { acc }
    else {
        let text = slice(chars, lexed.starts[i], lexed.ends[i]);
        let from = if i == 0 { 0 } else { lexed.ends[i - 1] };
        let gap = slice(chars, from, lexed.starts[i]);
        let prev = if i == 0 { "" } else { slice(chars, lexed.starts[i - 1], lexed.ends[i - 1]) };
        // Two tokens back, because deciding whether `prev` was a BINARY
        // operator needs what came before IT -- `a - 1` and `(-1)`
        // differ only there.
        let prev2 = if i < 2 { "" } else { slice(chars, lexed.starts[i - 2], lexed.ends[i - 2]) };
        gaps_acc(chars, lexed, i + 1, acc.concat(canonical_gap(gap, prev, text, prev2)).concat(text))
    }

let canonical_gap (gap: String) (prev: String) (next: String) (prev2: String): String =
    if gap.contains("\n") || gap.contains("//") { gap }
    // Nothing before a separator or a closing bracket, and nothing
    // after an opening one. Unanimous in the corpus: not one space
    // appears after `(` or before `)` outside a string.
    //
    // `:` is NOT in this list, and the corpus is why. A colon is a type
    // annotation in `x: Int` and a SEPARATOR in `require b != 0 :
    // "message"`, and every contract in the repository writes the
    // second one spaced. Nothing at the token level tells the two
    // apart, so the space before a colon is left as written and only
    // the space after it is normalised.
    else if next == "," || next == ")" || next == "]" { "" }
    else if prev == "(" || prev == "[" { "" }
    // One after. `x: Int` and `f(a, b)`.
    else if prev == "," || prev == ":" { " " }
    // A BINARY operator gets one space on each side. `a+b` becomes
    // `a + b`, and `n*2 + (n-1)/3` becomes `n * 2 + (n - 1) / 3`.
    else if is_binary_op(next, prev) || is_binary_op(prev, prev2) { " " }
    else { gap }

// Is this token a binary operator HERE?
//
// `-` is the whole difficulty. It is binary in `a - 1` and unary in
// `-1`, and the difference is entirely what comes before it: an
// operand, or something that cannot end one. `(`, `,`, `=`, another
// operator and the start of the file all mean unary, so `let x = -1`
// keeps its shape while `a-1` gains its spaces.
//
// `|` is excluded outright. It opens and closes a closure's parameter
// list -- `|x| x + 1` -- and spacing that as an operator would give
// `| x | x + 1`. `.` is excluded because `a.b` is not an expression
// with operands, it is a name.
let is_binary_op (tok: String) (before: String): Bool =
    if tok == "-" { ends_an_operand(before) }
    else { tok == "+" || tok == "*" || tok == "/" || tok == "%"
        || tok == "==" || tok == "!=" || tok == "<" || tok == ">"
        || tok == "<=" || tok == ">=" || tok == "&&" || tok == "||"
        || tok == "|>" }

// Can this token END an operand? Only then is a following `-` binary.
let ends_an_operand (tok: String): Bool =
    tok != "" && tok != "(" && tok != "[" && tok != "{" && tok != ","
        && tok != ";" && tok != "=" && tok != "=>" && tok != ":"
        && tok != "return" && tok != "|"
        // An operator cannot end an operand, so `a * -1` keeps the `-`
        // unary. `is_binary_op` is not consulted here because it would
        // recurse; the list is the operators that are never unary.
        && tok != "+" && tok != "*" && tok != "/" && tok != "%"
        && tok != "==" && tok != "!=" && tok != "<" && tok != ">"
        && tok != "<=" && tok != ">=" && tok != "&&" && tok != "||"
        && tok != "|>" && tok != "-"

let format_once (path: String) (src: String): String = {
    let lexed = lexer.tokenize_spanned(src);
    parser.set_source_context(path, src, lexed.starts, lexed.ends);
    parser.record_spans(true);
    let items = parser.parse_program(lexed.tokens).items;
    let spans = parser.recorded_spans();
    parser.record_spans(false);
    let chars = chars_of(src);
    // Structural edits FIRST, continuation edits after, because
    // `index_edits` keeps the first edit it sees for a line. A line that
    // a block or an arm can place is placed by that, and the
    // continuation rule only ever speaks for lines nothing else claims.
    apply_edits(chars, continuation_edits(chars, lexed, spans, all_item_edits(chars, items, 0, [])))
}

// --- Continuation lines ---
//
// A line that continues a construct begun on an earlier line, and that
// no brace positions: the `=` body of a `let` written on the next line,
// a `|>` chain broken across lines, a multi-line call's arguments.
// These are the lines the header above used to say were unplaceable,
// and they were -- until the parser recorded where each expression
// begins.
//
// The rule is one sentence: a continuation line is indented four past
// the line its innermost enclosing construct STARTED on.
//
// It was measured, not chosen. Of the 1,484 continuation lines in this
// repo, 936 are indented four past the line above and 526 are level
// with it -- 98.5% between them, and both fall out of that one
// sentence. A `|>` chain is the case that shows why:
//
//     xs                            <- the chain starts here, at four
//         |> Array.map(f)           <- inside it, so four past: eight
//         |> Array.join(", ")       <- inside the SAME chain: eight
//
// The second and third lines are both inside the one extent that began
// at `xs`, so both get eight -- "+4 then +0" without either number
// appearing in the rule.
//
// "Innermost" is the enclosing extent with the LATEST start, which is
// what makes nesting work: an argument inside a call inside a statement
// answers to the call, not to the statement.
//
// Three refusals, each for a reason the corpus gave:
//
//   * a comment-only line is left to `run_above`, which already
//     indents a comment with the thing below it;
//   * a line beginning `=`, `require` or `ensure` is an item HEADER
//     line, not part of any expression -- and the corpus does not agree
//     with itself about them, writing `require` at two spaces in
//     `bootstrap/corpus/contracts` and four in `examples/contracts`,
//     with `= a / b` at column zero in both. A rule that has to pick a
//     side of a disagreement is not a rule the corpus dictated;
//   * an anchor line that is not on the four-space grid is a hand
//     aligned line, and `block_indent` already refuses those for the
//     same reason. Whatever a construct is doing under such a line, it
//     was not put there by counting.
let continuation_edits (chars: Array[String]) (lexed: lexer.LexedSource) (spans: Array[parser.ExprSpan]) (acc: Array[Edit]): Array[Edit] =
    cont_acc(chars, multiline_only(chars, spans, 0, []), spanning_tokens(chars, lexed, 0, []), 0, acc)

// Tokens that themselves cross a line -- which in Plum means one thing,
// a string literal with a real newline in it:
//
//     .concat("
//     ")
//
// The second line begins INSIDE that token. Writing an indent there
// would put the spaces between the newline and the closing quote, so
// the string would gain characters and the program would print
// something different. `fmt-check`'s token-sequence property caught
// this on `codegen.plum` and `shims.plum` the first time the
// continuation rule ran, which is exactly what that property is for.
//
// Every rule before this one worked from AST offsets, which are always
// at token boundaries; this is the first that walks raw lines, so it is
// the first that has to know a line start can be inside a token.
let spanning_tokens (chars: Array[String]) (lexed: lexer.LexedSource) (i: Int) (acc: Array[parser.ExprSpan]): Array[parser.ExprSpan] =
    if i >= lexed.tokens.len() || i >= lexed.starts.len() { acc }
    else if lexed.ends[i] > lexed.starts[i] && line_start_of(chars, lexed.starts[i]) != line_start_of(chars, lexed.ends[i] - 1) {
        spanning_tokens(chars, lexed, i + 1, acc.push(parser.ExprSpan { start: lexed.starts[i], end: lexed.ends[i] }))
    } else { spanning_tokens(chars, lexed, i + 1, acc) }

let inside_token (toks: Array[parser.ExprSpan]) (i: Int) (ls: Int): Bool =
    if i >= toks.len() { false }
    else if toks[i].start < ls && toks[i].end > ls { true }
    else { inside_token(toks, i + 1, ls) }

// Only extents that CROSS a line can anchor a continuation line -- a
// span that opens and closes on one line has nothing below it. Almost
// every recorded span is single-line, so dropping them here is what
// keeps the per-line scan short.
let multiline_only (chars: Array[String]) (spans: Array[parser.ExprSpan]) (i: Int) (acc: Array[parser.ExprSpan]): Array[parser.ExprSpan] =
    if i >= spans.len() { acc }
    else {
        let last = if spans[i].end >= chars.len() { chars.len() - 1 } else { spans[i].end };
        if last <= spans[i].start || line_start_of(chars, spans[i].start) == line_start_of(chars, last) {
            multiline_only(chars, spans, i + 1, acc)
        } else { multiline_only(chars, spans, i + 1, acc.push(spans[i])) }
    }

let cont_acc (chars: Array[String]) (spans: Array[parser.ExprSpan]) (toks: Array[parser.ExprSpan]) (at: Int) (acc: Array[Edit]): Array[Edit] =
    if at >= chars.len() { acc }
    else { cont_acc(chars, spans, toks, line_end(chars, at), cont_line(chars, spans, toks, at, acc)) }

let cont_line (chars: Array[String]) (spans: Array[parser.ExprSpan]) (toks: Array[parser.ExprSpan]) (ls: Int) (acc: Array[Edit]): Array[Edit] = {
    let ind = count_spaces(chars, ls, 0);
    let first = ls + ind;
    if is_blank_line(chars, ls) { acc }
    else if is_comment_line(chars, ls) { acc }
    else if is_header_line(chars, first) { acc }
    else if is_closer_line(chars, first) { acc }
    else if inside_token(toks, 0, ls) { acc }
    // A line whose own indent is off the four-space grid was aligned by
    // hand, under an opening bracket or a condition:
    //
    //     else if nodes[i].path == path && nodes[i].def_offset >= 0
    //          && nodes[i].def_offset <= off {
    //
    // Nine spaces, chosen to put `&&` under the `if`'s condition. The
    // grid has no opinion about that column and moving the line to four
    // would destroy the alignment without improving anything -- the
    // same reason `block_indent` refuses a brace on such a line.
    //
    // But only when the line sits DEEPER than the grid answer, which is
    // what alignment always is: you align to a column of something on
    // the line above, and that column is to the right of where nesting
    // would have put you. All four off-grid lines in this repo are.
    // An off-grid line that is SHALLOWER aligns with nothing -- it is
    // just mis-indented, and refusing to fix it would be refusing to do
    // the job.
    else if ind % 4 != 0 && ind > anchor_indent(chars, spans, ls, first) { acc }
    else {
        let want = anchor_indent(chars, spans, ls, first);
        if want < 0 { acc }
        else { acc.push(Edit { line_start: ls, old_indent: ind, indent: want, owns_comments: true }) }
    }
}

// `else` is the one word that continues a construct WITHOUT going
// inside it, so it is the one line that takes its anchor's own indent
// rather than four past:
//
//     if n <= 0 { c }
//     else { bump(..) }
//
// The `else` line is inside the `if` expression's extent -- the extent
// ends after it -- so without this it would be indented as if it were
// part of the body, which is what the first version of this did to
// three files. An `else if` chain falls out of the same rule: each
// `else` answers to the nearest `if` that began on an earlier line,
// which is the one it belongs to.
let continues_level (chars: Array[String]) (at: Int): Int = if word_at(chars, at, "else") { 0 } else { 4 }

// A line that OPENS with a closing bracket is left alone. `}` is placed
// by `close_brace_edit`, which knows exactly what it closes because
// `PBlock` records its braces; the ones that reach here are the braces
// of a `struct`, `enum` or `extern` declaration, which are not
// expressions and have no extent of their own. Pushing them in by the
// continuation rule indented the closing brace of every extern block in
// the corpus.
//
// The measurement never covered these -- it excluded lines beginning
// with a closing bracket, so it said nothing about them, and a rule the
// corpus did not dictate is not one to guess at.
let is_closer_line (chars: Array[String]) (at: Int): Bool =
    at < chars.len() && (chars[at] == "}" || chars[at] == ")" || chars[at] == "]")

// What the continuation rule WOULD say this line's indent is, or -1
// where it has nothing to say. Consulted by the off-grid guard above,
// which needs the answer before deciding whether to allow it.
let anchor_indent (chars: Array[String]) (spans: Array[parser.ExprSpan]) (ls: Int) (first: Int): Int = {
    let anchor = innermost_start(spans, 0, ls, first, 0 - 1);
    // An anchor that does not BEGIN its own line has no indent of its
    // own to measure from, only a column someone typed:
    //
    //     IKUse(u) => if !Array.is_empty(u.path) .. { true }
    //                 else { cg_uses_module(items, name, i + 1) },
    //
    // That `else` is under the `if`, at column 24, and the `if` starts a
    // third of the way along the line above. `infer.plum` writes the
    // same shape the other way, putting `else` four past the ARM's
    // indent. Two files, two answers -- and where the corpus does not
    // agree with itself, this does not choose. It refuses rather than
    // falling back to the next anchor out, because falling back would
    // be picking one of the two sides.
    if anchor < 0 || !first_on_line(chars, anchor) { 0 - 1 }
    else {
        let col = count_spaces(chars, line_start_of(chars, anchor), 0);
        if col % 4 != 0 { 0 - 1 } else { col + continues_level(chars, first) }
    }
}

// The enclosing extent that begins latest: it started before this line
// and has not ended by this line's first character.
let innermost_start (spans: Array[parser.ExprSpan]) (i: Int) (ls: Int) (first: Int) (best: Int): Int =
    if i >= spans.len() { best }
    else if spans[i].start < ls && spans[i].end > first && spans[i].start > best {
        innermost_start(spans, i + 1, ls, first, spans[i].start)
    } else { innermost_start(spans, i + 1, ls, first, best) }

// A contract clause, or the `=` that introduces a body after one. They
// sit between an item's first token and its body, inside no expression
// at all -- so nothing would place them anyway were it not for the
// item's own extent, which covers them.
let is_header_line (chars: Array[String]) (at: Int): Bool =
    at < chars.len() && (chars[at] == "=" || word_at(chars, at, "require") || word_at(chars, at, "ensure"))

let word_at (chars: Array[String]) (at: Int) (w: String): Bool = word_eq(chars, at, chars_of(w), 0)

let word_eq (chars: Array[String]) (at: Int) (w: Array[String]) (i: Int): Bool =
    if i >= w.len() { true }
    else if at + i >= chars.len() { false }
    else if chars[at + i] != w[i] { false }
    else { word_eq(chars, at, w, i + 1) }

let all_item_edits (chars: Array[String]) (items: Array[parser.ItemNode]) (i: Int) (acc: Array[Edit]): Array[Edit] =
    if i >= items.len() { acc } else { all_item_edits(chars, items, i + 1, item_edits(chars, items[i], acc)) }
