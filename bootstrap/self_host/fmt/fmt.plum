use Os;

// `plum fmt` -- the formatter.
//
// It is `lexer.relex` with opinions. They are:
//   * the line a statement, item or match arm begins on is indented
//     four spaces per enclosing block, and a closing brace one level
//     out from what it closes;
//   * a run of comment lines is indented with what it documents;
//   * a run of blank lines collapses to one;
//   * a comma has no space before it and one space after, and so does
//     a colon -- except that a colon's LEADING space is left alone,
//     because `require c : "msg"` spells it that way and nothing at the
//     token level separates that from `x: Int`;
//   * nothing sits just inside a bracket: `f( a )` becomes `f(a)`;
//   * a binary operator gets one space on each side, and a UNARY minus
//     does not -- `a-b` becomes `a - b` while `-n` is left alone;
//   * a line that CONTINUES a construct begun on an earlier line is
//     indented four past the line that construct started on.
//
// Everything else in the file is passed through byte for byte.
//
// Every one of those was MEASURED against the corpus before being
// written, not imported from another language. The comma rule, for
// instance: 20,585 commas, and the only ones not already followed by a
// space were inside string literals but for a single `[1,2,3]`.
//
// It also places CLOSING BRACES, and `} else {` with them: a `}` sits
// one level out from the statements it closes, which is exact rather
// than guessed because `PBlock` records where its own braces are.
//
// Match and `select` arms are placed by the SAME rule and the same
// function. An arm sits inside braces exactly as a statement does, so
// once `MatchArmNode` carried a start offset and `EMatch` carried its
// closing brace, arms needed no rule of their own -- they call
// `resolve_candidate` and inherit its refusals too.
//
// The last of those rules is newer than the rest, and for most of this
// file's life the header said the opposite: that a line belonging to a
// construct with no braces of its own -- the `=` continuation of a long
// `let`, a `|>` chain broken across lines, a multi-line call's
// arguments -- could not be placed, because statements and items carried
// source ranges and EXPRESSIONS DID NOT. That was true, and it was the
// right restraint while it held: a formatter that reflows inside an
// expression it cannot see the shape of will move code it has
// mis-attributed.
//
// `parser.ExprSpan` is what changed. The parser now records where every
// expression begins and ends, so the construct a continuation line
// belongs to has a name, and the line can be placed by measuring rather
// than guessed at.
//
// What did NOT change is the stance. This still only moves lines it can
// name, and it still refuses four kinds it cannot: a line inside a
// multi-line string token, a line whose anchor construct starts partway
// along its own line, a hand-aligned line sitting deeper than the grid
// answer, and an item's `require`/`ensure`/`=` header lines. Each
// refusal is there because the corpus either said nothing or disagreed
// with itself, and each is written down where it happens.
//
// It still REFLOWS nothing: no line is ever split or joined. Every rule
// here changes leading whitespace and the gaps between tokens on a
// line, and that is the whole of it.
//
// The rule is not invented. Across the 242 `.plum` files in this repo,
// indentation is already a multiple of four everywhere, there is not one
// tab, not one line with trailing whitespace, and not one file missing
// its final newline. The corpus IS the style guide; this encodes what it
// already does. The test of that is `bootstrap/fmt-check`: formatting
// every file in the repo must change nothing.

// Source positions are codepoint offsets, matching lexer/parser spans. Keep
// one offset per line, rather than a table entry per character. All offset
// lookups use binary search; dense lines never rescan their growing prefix.
struct Source { text: Array[String], lines: Array[Int], token_starts: Array[Int] }

let source_of (src: String) (token_starts: Array[Int]): Source = {
    let text = chars_of(src);
    Source { text: text, lines: collect_lines(text, 0, [0]), token_starts: token_starts }
}

let collect_lines (text: Array[String]) (at: Int) (acc: Array[Int]): Array[Int] =
    if at >= text.len() { acc }
    else { collect_lines(text, at + 1, if text[at] == "\n" { acc.push(at + 1) } else { acc }) }

// A negative anchor is an absolute indent. Otherwise `indent` is a delta
// from an EARLIER line's assigned indent. Structural rules precede
// continuation rules; a refused rule leaves the next candidate available.
// `owns_comments` says whether the run of comment lines above this one
// belongs to it. A statement and an item own theirs -- a comment above
// them documents them. A CLOSING BRACE does not: the comments above a
// `}` are the last thing inside the block, documenting the code they
// follow, and pulling them out to the brace's level moves them out of
// the body they belong to. That is a regression this had before the
// flag existed, and five files in the repo caught it.
struct Edit { line_start: Int, anchor: Int, indent: Int, owns_comments: Bool, continuation: Bool }

// Collect structural indentation dependencies, outer constructs first.
// An item owns column zero; block bodies depend on their brace line.
let item_edits (chars: Source) (it: parser.ItemNode) (acc: Array[Edit]): Array[Edit] =
    if it.start < 0 { acc }
    else {
        let a = if first_on_line(chars, it.start) { acc.push(edit_at(chars, it.start, 0)) } else { acc };
        match it.kind {
            IKLet(def) => expr_edits(chars, def.body, a),
            _ => a,
        }
    }

let expr_edits (chars: Source) (e: parser.PExpr) (acc: Array[Edit]): Array[Edit] =
    match e {
        EBlock(b) => block_edits(chars, b, acc),
        EIf(c, t, els) => {
            let a1 = expr_edits(chars, c, acc);
            let a2 = block_edits(chars, t, a1);
            match els { Some(x) => expr_edits(chars, x, a2), None => a2 }
        },
        EMatch(sc, arms, close) => arm_edits(chars, arms, 0, arm_line_edits(chars, arm_starts(arms, 0, []), close, expr_edits(chars, sc, acc))),
        ESelect(arms, close) => select_edits(chars, arms, 0, arm_line_edits(chars, select_arm_starts(arms, 0, []), close, acc)),
        EFor(_, iter, body) => block_edits(chars, body, expr_edits(chars, iter, acc)),
        EUnsafe(b) => block_edits(chars, b, acc),
        ESpawn(b) => block_edits(chars, b, acc),
        EClosure(_, body) => expr_edits(chars, body, acc),
        EUnary(_, a) => expr_edits(chars, a, acc),
        EBinary(_, l, r) => expr_edits(chars, r, expr_edits(chars, l, acc)),
        EField(b, _) => expr_edits(chars, b, acc),
        ECall(callee, args) => list_edits(chars, args, 0, expr_edits(chars, callee, acc)),
        EGenericInst(b, _) => expr_edits(chars, b, acc),
        EIndex(b, i) => expr_edits(chars, i, expr_edits(chars, b, acc)),
        ETuple(xs) => list_edits(chars, xs, 0, acc),
        EArray(xs) => list_edits(chars, xs, 0, acc),
        EStructLit(_, fields, spread) => {
            let a = field_edits(chars, fields, 0, acc);
            match spread { Some(x) => expr_edits(chars, x, a), None => a }
        },
        EInt(_, _) => acc,
        EFloat(_) => acc,
        EStr(_) => acc,
        EBool(_) => acc,
        EIdent(_, _) => acc,
    }

// Bodies depend on the opening brace's LINE, rather than AST depth:
// a brace may live on a continuation line. Resolve that line first so
// nested bodies follow its assigned indentation in this same traversal.
let block_edits (chars: Source) (b: parser.PBlock) (acc: Array[Edit]): Array[Edit] = {
    let a = match block_anchor(chars, b.starts) {
        None => acc,
        Some(anchor) => close_brace_edit(chars, b.close, anchor, stmt_line_edits(chars, b.starts, 0, anchor, acc)),
    };
    let a2 = stmt_body_edits(chars, b.stmts, 0, a);
    match b.tail { Some(t) => expr_edits(chars, t, a2), None => a2 }
}

// Only a closing brace that begins its line owns that line's indent.
let close_brace_edit (chars: Source) (close: Int) (anchor: Int) (acc: Array[Edit]): Array[Edit] =
    if close < 0 { acc }
    else if !first_on_line(chars, close) { acc }
    else { acc.push(relative_edit(chars, close, anchor, 0, false, false)) }

let block_anchor (chars: Source) (starts: Array[Int]): Option[Int] =
    if Array.is_empty(starts) || starts[0] < 0 { None }
    else {
        // The preceding token skips whitespace/comments without scanning
        // raw text (or mistaking `//` inside a string for a comment).
        let i = offset_index(chars.token_starts, starts[0], 0, chars.token_starts.len());
        if i <= 0 { None }
        else {
            let brace = chars.token_starts[i - 1];
            if chars.text[brace] != "{" { None }
            else { Some(line_start_of(chars, brace)) }
        }
    }

let stmt_line_edits (chars: Source) (starts: Array[Int]) (i: Int) (anchor: Int) (acc: Array[Edit]): Array[Edit] =
    if i >= starts.len() { acc }
    // Synthetic statements have no source. A statement sharing a line
    // with its brace does not own that line's indentation either.
    else if starts[i] < 0 { stmt_line_edits(chars, starts, i + 1, anchor, acc) }
    else if !first_on_line(chars, starts[i]) { stmt_line_edits(chars, starts, i + 1, anchor, acc) }
    else { stmt_line_edits(chars, starts, i + 1, anchor, acc.push(relative_edit(chars, starts[i], anchor, 4, true, false))) }

let first_on_line (chars: Source) (offset: Int): Bool = {
    let ls = line_start_of(chars, offset);
    ls + indent_length(chars, ls, 0) == offset
}

let stmt_body_edits (chars: Source) (stmts: Array[parser.PStmt]) (i: Int) (acc: Array[Edit]): Array[Edit] =
    if i >= stmts.len() { acc }
    else {
        let a = match stmts[i] {
            SLet(_, _, _, v) => expr_edits(chars, v, acc),
            SAssign(_, v) => expr_edits(chars, v, acc),
            SExpr(v) => expr_edits(chars, v, acc),
        };
        stmt_body_edits(chars, stmts, i + 1, a)
    }

let list_edits (chars: Source) (xs: Array[parser.PExpr]) (i: Int) (acc: Array[Edit]): Array[Edit] =
    if i >= xs.len() { acc } else { list_edits(chars, xs, i + 1, expr_edits(chars, xs[i], acc)) }

let field_edits (chars: Source) (fs: Array[parser.FieldInitNode]) (i: Int) (acc: Array[Edit]): Array[Edit] =
    if i >= fs.len() { acc } else { field_edits(chars, fs, i + 1, expr_edits(chars, fs[i].value, acc)) }

// Match/select arms use the same brace dependency as block statements.
let arm_line_edits (chars: Source) (starts: Array[Int]) (close: Int) (acc: Array[Edit]): Array[Edit] =
    match block_anchor(chars, starts) {
        None => acc,
        Some(anchor) => close_brace_edit(chars, close, anchor, stmt_line_edits(chars, starts, 0, anchor, acc)),
    }

let arm_starts (arms: Array[parser.MatchArmNode]) (i: Int) (acc: Array[Int]): Array[Int] =
    if i >= arms.len() { acc } else { arm_starts(arms, i + 1, acc.push(arms[i].start)) }

let select_arm_starts (arms: Array[parser.SelectArmNode]) (i: Int) (acc: Array[Int]): Array[Int] =
    if i >= arms.len() { acc } else { select_arm_starts(arms, i + 1, acc.push(arms[i].start)) }

let arm_edits (chars: Source) (arms: Array[parser.MatchArmNode]) (i: Int) (acc: Array[Edit]): Array[Edit] =
    if i >= arms.len() { acc }
    else {
        let a = match arms[i].guard { Some(g) => expr_edits(chars, g, acc), None => acc };
        arm_edits(chars, arms, i + 1, expr_edits(chars, arms[i].body, a))
    }

let select_edits (chars: Source) (arms: Array[parser.SelectArmNode]) (i: Int) (acc: Array[Edit]): Array[Edit] =
    if i >= arms.len() { acc }
    else {
        let a = match arms[i].kind {
            SARecv(_, chan) => expr_edits(chars, chan, acc),
            SAAfter(d) => expr_edits(chars, d, acc),
            SAElse => acc,
        };
        select_edits(chars, arms, i + 1, expr_edits(chars, arms[i].body, a))
    }

// --- Applying edits ---

let edit_at (chars: Source) (offset: Int) (indent: Int): Edit =
    Edit { line_start: line_start_of(chars, offset), anchor: -1, indent: indent, owns_comments: true, continuation: false }

let relative_edit (chars: Source) (offset: Int) (anchor: Int) (delta: Int) (owns: Bool) (cont: Bool): Edit =
    Edit { line_start: line_start_of(chars, offset), anchor: anchor, indent: delta, owns_comments: owns, continuation: cont }

let line_start_of (chars: Source) (offset: Int): Int =
    chars.lines[offset_index(chars.lines, offset, 0, chars.lines.len())]

// Upper bound minus one: newline offsets belong to the preceding line,
// while EOF after a final newline belongs to the empty last line.
let offset_index (lines: Array[Int]) (offset: Int) (lo: Int) (hi: Int): Int =
    if lo + 1 >= hi { lo }
    else {
        let mid = lo + (hi - lo) / 2;
        if lines[mid] <= offset { offset_index(lines, offset, mid, hi) }
        else { offset_index(lines, offset, lo, mid) }
    }

let indent_length (chars: Source) (at: Int) (n: Int): Int =
    if at + n >= chars.text.len() { n } else if chars.text[at + n] == " " || chars.text[at + n] == "\t" { indent_length(chars, at, n + 1) } else { n }

// Prefix length is a source offset; columns are layout. Tabs advance to
// the next four-column stop, matching the formatter's indentation grid.
let indent_columns (chars: Source) (at: Int) (col: Int): Int =
    if at >= chars.text.len() { col }
    else if chars.text[at] == " " { indent_columns(chars, at + 1, col + 1) }
    else if chars.text[at] == "\t" { indent_columns(chars, at + 1, col + 4 - col % 4) }
    else { col }

pub let spaces (n: Int): String = if n <= 0 { "" } else { " ".concat(spaces(n - 1)) }

// Collect candidates in AST priority order, resolve them in source order,
// then render once. Relative code indentation never depends on comments.
let apply_edits (chars: Source) (edits: Array[Edit]) (toks: Array[parser.ExprSpan]): String = {
    let empty: Map[Int, Int] = Map.new(());
    let candidates: Map[Int, Array[Edit]] = Map.new(());
    let by_line = resolve_lines(chars, index_candidates(edits, 0, candidates), 0, empty);
    walk_lines(chars, by_line, toks, 0, false, "")
}

// A comment run immediately above code inherits its owner's RESOLVED
// indent. Blank lines stop the run; closing braces do not own comments.
let run_above (chars: Source) (line_start: Int) (indent: Int) (acc: Map[Int, Int]): Map[Int, Int] =
    if line_start <= 0 { acc }
    else {
        let prev = line_start_of(chars, line_start - 1);
        if !is_comment_line(chars, prev) { acc }
        else { run_above(chars, prev, indent, Map.insert(acc, prev, indent)) }
    }

// Comment-only: the first thing on the line is `//`. A blank line is
// NOT one, which is what stops a run at a paragraph break.
let is_comment_line (chars: Source) (ls: Int): Bool = {
    let at = ls + indent_length(chars, ls, 0);
    at + 1 < chars.text.len() && chars.text[at] == "/" && chars.text[at + 1] == "/"
}

// Retain candidate order so an outer structural rule owns its line.
// A structural rule whose anchor remains hand-aligned may refuse; only
// then can a continuation rule place that line.
let index_candidates (edits: Array[Edit]) (i: Int) (m: Map[Int, Array[Edit]]): Map[Int, Array[Edit]] =
    if i >= edits.len() { m }
    else {
        let prior = match Map.get(m, edits[i].line_start) { Some(xs) => xs, None => [] };
        index_candidates(edits, i + 1, Map.insert(m, edits[i].line_start, prior.push(edits[i])))
    }

let assigned_indent (chars: Source) (assigned: Map[Int, Int]) (ls: Int): Int =
    match Map.get(assigned, ls) {
        Some(col) => col,
        None => indent_columns(chars, ls, 0),
    }

// All anchors precede their dependent line. This makes source order a
// topological order, including braces on continuation and `else` lines.
// Attach comments only once their owner's indentation is known; comment
// lines are never anchors for code, so these forward references are safe.
let resolve_lines (chars: Source) (candidates: Map[Int, Array[Edit]]) (i: Int) (assigned: Map[Int, Int]): Map[Int, Int] =
    if i >= chars.lines.len() { assigned }
    else {
        let ls = chars.lines[i];
        let chosen = match Map.get(candidates, ls) {
            None => None,
            Some(xs) => resolve_candidate(chars, assigned, xs, 0),
        };
        match chosen {
            None => resolve_lines(chars, candidates, i + 1, assigned),
            Some(edit) => {
                let next = Map.insert(assigned, ls, edit.indent);
                let comments = if edit.owns_comments { run_above(chars, ls, edit.indent, next) } else { next };
                resolve_lines(chars, candidates, i + 1, comments)
            },
        }
    }

let resolve_candidate (chars: Source) (assigned: Map[Int, Int]) (xs: Array[Edit]) (i: Int): Option[Edit] =
    if i >= xs.len() { None }
    else {
        let e = xs[i];
        if e.anchor < 0 { Some(e) }
        else if e.anchor >= e.line_start { resolve_candidate(chars, assigned, xs, i + 1) }
        else {
            let col = assigned_indent(chars, assigned, e.anchor);
            let want = col + e.indent;
            let old = indent_columns(chars, e.line_start, 0);
            // Keep hand-aligned anchors. A continuation line also keeps
            // its own off-grid alignment when deeper than the answer.
            if col % 4 != 0 || (e.continuation && old % 4 != 0 && old > want) {
                resolve_candidate(chars, assigned, xs, i + 1)
            } else {
                Some(Edit { line_start: e.line_start, anchor: -1, indent: want, owns_comments: e.owns_comments, continuation: false })
            }
        }
    }

// One pass over the source. At the start of each line, either the line
// has an edit -- in which case its existing indentation is dropped and
// the wanted indent written instead -- or it is copied untouched.
// `prev_blank` carries the second opinion: a run of blank lines
// collapses to one.
//
// The corpus is nearly unanimous -- 1,586 runs of a single blank line
// against two runs of a double -- which is why this is a rule at all
// rather than a preference. It is also the first rule here that changes
// something other than leading whitespace, which is why `fmt-check`
// checks the TOKEN sequence rather than comparing stripped lines.
let walk_lines (chars: Source) (by_line: Map[Int, Int]) (toks: Array[parser.ExprSpan]) (at: Int) (prev_blank: Bool) (acc: String): String =
    if at >= chars.text.len() { acc }
    // Literal contents must bypass every whitespace rule, including blank
    // line collapse. They also break runs of blank source lines.
    else if inside_token(toks, 0, at) {
        let e = line_end(chars, at);
        walk_lines(chars, by_line, toks, e, false, acc.concat(slice(chars, at, e)))
    }
    else if is_blank_line(chars, at) {
        let e = line_end(chars, at);
        // Strip indentation while retaining the source line ending.
        let nl = if e >= at + 2 && chars.text[e - 2] == "\r" && chars.text[e - 1] == "\n" { e - 2 } else { line_end_no_nl(chars, at) };
        if prev_blank { walk_lines(chars, by_line, toks, e, true, acc) }
        else { walk_lines(chars, by_line, toks, e, true, acc.concat(slice(chars, nl, e))) }
    }
    else {
        match Map.get(by_line, at) {
            None => {
                let e = line_end(chars, at);
                walk_lines(chars, by_line, toks, e, false, acc.concat(slice(chars, at, e)))
            },
            Some(indent) => {
                let sp = indent_length(chars, at, 0);
                let e = line_end(chars, at);
                walk_lines(chars, by_line, toks, e, false, acc.concat(spaces(indent)).concat(slice(chars, at + sp, e)))
            },
        }
    }

// Whitespace to the end of the line, and nothing else.
let is_blank_line (chars: Source) (at: Int): Bool = at + count_spaces_ws(chars, at, 0) >= line_end_no_nl(chars, at)

let count_spaces_ws (chars: Source) (at: Int) (n: Int): Int =
    if at + n >= chars.text.len() { n }
    else if chars.text[at + n] == "\n" { n }
    else if String.is_ascii_ws(chars.text[at + n]) { count_spaces_ws(chars, at, n + 1) }
    else { n }

let line_end_no_nl (chars: Source) (at: Int): Int =
    if at >= chars.text.len() { at } else if chars.text[at] == "\n" { at } else { line_end_no_nl(chars, at + 1) }

// Through the newline, so the caller always resumes at a line start.
let line_end (chars: Source) (at: Int): Int =
    if at >= chars.text.len() { at } else if chars.text[at] == "\n" { at + 1 } else { line_end(chars, at + 1) }

let slice (chars: Source) (from: Int) (to: Int): String = text_slice(chars.text, from, to)

let text_slice (chars: Array[String]) (from: Int) (to: Int): String =
    Array.concat_all(Array.slice(chars, from, to))

// Normalize token gaps once, then parse and resolve layout once. Every
// relative rule points backward in source order, so there is no fixed
// point iteration, pass budget, or successful partially formatted result.
pub let format (path: String) (src: String): String =
    format_once(path, normalize_gaps(path, src))

// --- Spacing between tokens, on one line ---
//
// The second kind of rule here, and the first that rewrites INSIDE a
// line rather than at the front of one. It works on the gaps between
// tokens, which is what makes it safe to state: a gap is by definition
// not inside a string or a comment, so "no space before a comma" cannot
// reach into `",a".split(",")` the way a text substitution would.
//
// Two rules, both measured rather than imported. Across the corpus,
// with comments stripped: 20,585 commas, of which the only ones not
// followed by a space are inside string literals but for a single
// `[1,2,3]`; and no space appears before a comma or before a closing
// paren anywhere outside a string.
//
// A gap containing a NEWLINE is left alone -- that is line structure,
// and belongs to the indent pass. So is a gap containing a comment: a
// trailing `// ...` sets its own distance from the code.
pub let normalize_gaps (path: String) (src: String): String = {
    let lexed = lexer.tokenize_spanned_at(src, path);
    let chars = chars_of(src);
    gaps_acc(chars, lexed, 0, "")
}

let gaps_acc (chars: Array[String]) (lexed: lexer.LexedSource) (i: Int) (acc: String): String =
    if i >= lexed.tokens.len() { acc }
    else {
        let text = text_slice(chars, lexed.starts[i], lexed.ends[i]);
        let from = if i == 0 { 0 } else { lexed.ends[i - 1] };
        let gap = text_slice(chars, from, lexed.starts[i]);
        let prev = if i == 0 { "" } else { text_slice(chars, lexed.starts[i - 1], lexed.ends[i - 1]) };
        // Two tokens back, because deciding whether `prev` was a BINARY
        // operator needs what came before IT -- `a - 1` and `(-1)`
        // differ only there.
        let prev2 = if i < 2 { "" } else { text_slice(chars, lexed.starts[i - 2], lexed.ends[i - 2]) };
        gaps_acc(chars, lexed, i + 1, acc.concat(canonical_gap(gap, prev, text, prev2)).concat(text))
    }

let canonical_gap (gap: String) (prev: String) (next: String) (prev2: String): String =
    if gap.contains("\n") || gap.contains("//") { gap }
    // Nothing before a separator or a closing bracket, and nothing
    // after an opening one. Unanimous in the corpus: not one space
    // appears after `(` or before `)` outside a string.
    //
    // `:` is NOT in this list, and the corpus is why. A colon is a type
    // annotation in `x: Int` and a SEPARATOR in `require b != 0 :
    // "message"`, and every contract in the repository writes the
    // second one spaced. Nothing at the token level tells the two
    // apart, so the space before a colon is left as written and only
    // the space after it is normalised.
    else if next == "," || next == ")" || next == "]" { "" }
    else if prev == "(" || prev == "[" { "" }
    // One after. `x: Int` and `f(a, b)`.
    else if prev == "," || prev == ":" { " " }
    // A BINARY operator gets one space on each side. `a+b` becomes
    // `a + b`, and `n*2 + (n-1)/3` becomes `n * 2 + (n - 1) / 3`.
    else if is_binary_op(next, prev) || is_binary_op(prev, prev2) { " " }
    else { gap }

// Is this token a binary operator HERE?
//
// `-` is the whole difficulty. It is binary in `a - 1` and unary in
// `-1`, and the difference is entirely what comes before it: an
// operand, or something that cannot end one. `(`, `,`, `=`, another
// operator and the start of the file all mean unary, so `let x = -1`
// keeps its shape while `a-1` gains its spaces.
//
// `|` is excluded outright. It opens and closes a closure's parameter
// list -- `|x| x + 1` -- and spacing that as an operator would give
// `| x | x + 1`. `.` is excluded because `a.b` is not an expression
// with operands, it is a name.
let is_binary_op (tok: String) (before: String): Bool =
    if tok == "-" { ends_an_operand(before) }
    else { tok == "+" || tok == "*" || tok == "/" || tok == "%"
        || tok == "==" || tok == "!=" || tok == "<" || tok == ">"
        || tok == "<=" || tok == ">=" || tok == "&&" || tok == "||"
        || tok == "|>" }

// Can this token END an operand? Only then is a following `-` binary.
let ends_an_operand (tok: String): Bool =
    tok != "" && tok != "(" && tok != "[" && tok != "{" && tok != ","
        && tok != ";" && tok != "=" && tok != "=>" && tok != ":"
        && tok != "return" && tok != "|"
        // An operator cannot end an operand, so `a * -1` keeps the `-`
        // unary. `is_binary_op` is not consulted here because it would
        // recurse; the list is the operators that are never unary.
        && tok != "+" && tok != "*" && tok != "/" && tok != "%"
        && tok != "==" && tok != "!=" && tok != "<" && tok != ">"
        && tok != "<=" && tok != ">=" && tok != "&&" && tok != "||"
        && tok != "|>" && tok != "-"

let format_once (path: String) (src: String): String = {
    let lexed = lexer.tokenize_spanned_at(src, path);
    parser.set_source_context(path, src, lexed.starts, lexed.ends);
    parser.record_spans(true);
    let items = parser.parse_program(lexed.tokens).items;
    let spans = parser.recorded_spans();
    parser.record_spans(false);
    let chars = source_of(src, lexed.starts);
    // Structural edits FIRST, continuation edits after, because
    // resolution takes the first applicable edit for a line. A line that
    // a block or an arm can place is placed by that, and the
    // continuation rule only ever speaks for lines nothing else claims.
    let toks = spanning_tokens(chars, lexed, 0, []);
    apply_edits(chars, continuation_edits(chars, toks, spans, all_item_edits(chars, items, 0, [])), toks)
}

// --- Continuation lines ---
//
// A line that continues a construct begun on an earlier line, and that
// no brace positions: the `=` body of a `let` written on the next line,
// a `|>` chain broken across lines, a multi-line call's arguments.
// These are the lines the header above used to say were unplaceable,
// and they were -- until the parser recorded where each expression
// begins.
//
// The rule is one sentence: a continuation line is indented four past
// the line its innermost enclosing construct STARTED on.
//
// It was measured, not chosen. Of the 1,484 continuation lines in this
// repo, 936 are indented four past the line above and 526 are level
// with it -- 98.5% between them, and both fall out of that one
// sentence. A `|>` chain is the case that shows why:
//
//     xs                            <- the chain starts here, at four
//         |> Array.map(f)           <- inside it, so four past: eight
//         |> Array.join(", ")       <- inside the SAME chain: eight
//
// The second and third lines are both inside the one extent that began
// at `xs`, so both get eight -- "+4 then +0" without either number
// appearing in the rule.
//
// "Innermost" is the enclosing extent with the LATEST start, which is
// what makes nesting work: an argument inside a call inside a statement
// answers to the call, not to the statement.
//
// Three refusals, each for a reason the corpus gave:
//
//   * a comment-only line is left to `run_above`, which already
//     indents a comment with the thing below it;
//   * a line beginning `=`, `require` or `ensure` is an item HEADER
//     line, not part of any expression -- and the corpus does not agree
//     with itself about them, writing `require` at two spaces in
//     `bootstrap/corpus/contracts` and four in `examples/contracts`,
//     with `= a / b` at column zero in both. A rule that has to pick a
//     side of a disagreement is not a rule the corpus dictated;
//   * an anchor line that is not on the four-space grid is a hand
//     aligned line, and `resolve_candidate` already refuses those for the
//     same reason. Whatever a construct is doing under such a line, it
//     was not put there by counting.
let continuation_edits (chars: Source) (toks: Array[parser.ExprSpan]) (spans: Array[parser.ExprSpan]) (acc: Array[Edit]): Array[Edit] =
    cont_acc(chars, multiline_only(chars, spans, 0, []), toks, 0, acc)

// Tokens that themselves cross a line -- which in Plum means one thing,
// a string literal with a real newline in it:
//
//     .concat("
//     ")
//
// The second line begins INSIDE that token. Writing an indent there
// would put the spaces between the newline and the closing quote, so
// the string would gain characters and the program would print
// something different. `fmt-check`'s token-sequence property caught
// this on `codegen.plum` and `shims.plum` the first time the
// continuation rule ran, which is exactly what that property is for.
//
// Every rule before this one worked from AST offsets, which are always
// at token boundaries; this is the first that walks raw lines, so it is
// the first that has to know a line start can be inside a token.
let spanning_tokens (chars: Source) (lexed: lexer.LexedSource) (i: Int) (acc: Array[parser.ExprSpan]): Array[parser.ExprSpan] =
    if i >= lexed.tokens.len() || i >= lexed.starts.len() { acc }
    else if lexed.ends[i] > lexed.starts[i] && line_start_of(chars, lexed.starts[i]) != line_start_of(chars, lexed.ends[i] - 1) {
        spanning_tokens(chars, lexed, i + 1, acc.push(parser.ExprSpan { start: lexed.starts[i], end: lexed.ends[i] }))
    } else { spanning_tokens(chars, lexed, i + 1, acc) }

let inside_token (toks: Array[parser.ExprSpan]) (i: Int) (ls: Int): Bool =
    if i >= toks.len() { false }
    else if toks[i].start < ls && toks[i].end > ls { true }
    else { inside_token(toks, i + 1, ls) }

// Only extents that CROSS a line can anchor a continuation line -- a
// span that opens and closes on one line has nothing below it. Almost
// every recorded span is single-line, so dropping them here is what
// keeps the per-line scan short.
let multiline_only (chars: Source) (spans: Array[parser.ExprSpan]) (i: Int) (acc: Array[parser.ExprSpan]): Array[parser.ExprSpan] =
    if i >= spans.len() { acc }
    else {
        let last = if spans[i].end >= chars.text.len() { chars.text.len() - 1 } else { spans[i].end };
        if last <= spans[i].start || line_start_of(chars, spans[i].start) == line_start_of(chars, last) {
            multiline_only(chars, spans, i + 1, acc)
        } else { multiline_only(chars, spans, i + 1, acc.push(spans[i])) }
    }

let cont_acc (chars: Source) (spans: Array[parser.ExprSpan]) (toks: Array[parser.ExprSpan]) (at: Int) (acc: Array[Edit]): Array[Edit] =
    if at >= chars.text.len() { acc }
    else { cont_acc(chars, spans, toks, line_end(chars, at), cont_line(chars, spans, toks, at, acc)) }

let cont_line (chars: Source) (spans: Array[parser.ExprSpan]) (toks: Array[parser.ExprSpan]) (ls: Int) (acc: Array[Edit]): Array[Edit] = {
    let ind = indent_length(chars, ls, 0);
    let first = ls + ind;
    if is_blank_line(chars, ls) { acc }
    else if is_comment_line(chars, ls) { acc }
    else if is_header_line(chars, first) { acc }
    else if is_closer_line(chars, first) { acc }
    else if inside_token(toks, 0, ls) { acc }
    else {
        let anchor = innermost_start(spans, 0, ls, first, -1);
        // Mid-line expressions have no independent indent to anchor to.
        if anchor < 0 || !first_on_line(chars, anchor) { acc }
        else { acc.push(relative_edit(chars, ls, line_start_of(chars, anchor), continues_level(chars, first), true, true)) }
    }
}

// `else` is the one word that continues a construct WITHOUT going
// inside it, so it is the one line that takes its anchor's own indent
// rather than four past:
//
//     if n <= 0 { c }
//     else { bump(..) }
//
// The `else` line is inside the `if` expression's extent -- the extent
// ends after it -- so without this it would be indented as if it were
// part of the body, which is what the first version of this did to
// three files. An `else if` chain falls out of the same rule: each
// `else` answers to the nearest `if` that began on an earlier line,
// which is the one it belongs to.
let continues_level (chars: Source) (at: Int): Int = if word_at(chars, at, "else") { 0 } else { 4 }

// A line that OPENS with a closing bracket is left alone. `}` is placed
// by `close_brace_edit`, which knows exactly what it closes because
// `PBlock` records its braces; the ones that reach here are the braces
// of a `struct`, `enum` or `extern` declaration, which are not
// expressions and have no extent of their own. Pushing them in by the
// continuation rule indented the closing brace of every extern block in
// the corpus.
//
// The measurement never covered these -- it excluded lines beginning
// with a closing bracket, so it said nothing about them, and a rule the
// corpus did not dictate is not one to guess at.
let is_closer_line (chars: Source) (at: Int): Bool =
    at < chars.text.len() && (chars.text[at] == "}" || chars.text[at] == ")" || chars.text[at] == "]")

// The enclosing extent that begins latest: it started before this line
// and has not ended by this line's first character.
let innermost_start (spans: Array[parser.ExprSpan]) (i: Int) (ls: Int) (first: Int) (best: Int): Int =
    if i >= spans.len() { best }
    else if spans[i].start < ls && spans[i].end > first && spans[i].start > best {
        innermost_start(spans, i + 1, ls, first, spans[i].start)
    } else { innermost_start(spans, i + 1, ls, first, best) }

// A contract clause, or the `=` that introduces a body after one. They
// sit between an item's first token and its body, inside no expression
// at all -- so nothing would place them anyway were it not for the
// item's own extent, which covers them.
let is_header_line (chars: Source) (at: Int): Bool =
    at < chars.text.len() && (chars.text[at] == "=" || word_at(chars, at, "require") || word_at(chars, at, "ensure"))

let word_at (chars: Source) (at: Int) (w: String): Bool = word_eq(chars, at, chars_of(w), 0)

let word_eq (chars: Source) (at: Int) (w: Array[String]) (i: Int): Bool =
    if i >= w.len() { true }
    else if at + i >= chars.text.len() { false }
    else if chars.text[at + i] != w[i] { false }
    else { word_eq(chars, at, w, i + 1) }

let all_item_edits (chars: Source) (items: Array[parser.ItemNode]) (i: Int) (acc: Array[Edit]): Array[Edit] =
    if i >= items.len() { acc } else { all_item_edits(chars, items, i + 1, item_edits(chars, items[i], acc)) }
