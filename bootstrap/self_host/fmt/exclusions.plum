// Preservation is indexed by lossless token ordinal, so whitespace edits in
// one stage cannot move the boundaries used by another. `after` is exclusive
// for tokens; its preceding trivia is kept through the last newline only,
// leaving the following code's indentation to the formatter.
struct KeptRange { first: Int, after: Int }

struct FmtDirective { kind: Int, token: Int }

let format_exclusions (path: String) (src: String): String =
    if !src.contains("fmt:") { format_layout(path, src) }
    else {
        let lexed = lexer.tokenize_spanned_at(src, path);
        let source = source_of(src, lexed.starts);
        let directives = source_directives(source, lexed, 0, []);
        if directives.is_empty() { format_layout(path, src) }
        else {
            let ends: Map[Int, Int] = Map.new(());
            let regions = directive_ranges(directives, lexed, ends, 0, 0, 0, []);
            if regions.len() == 1 && regions[0].first == 0
                && regions[0].after == lexed.tokens.len() - 1 { src }
            else {
                let kept = if !has_skip(directives, 0, 0) { regions } else {
                    directive_ranges(
                        directives,
                        lexed,
                        skipped_constructs(path, src, lexed, ends),
                        0,
                        0,
                        0,
                        []
                    )
                };
                if kept.len() == 1 && kept[0].first == 0
                    && kept[0].after == lexed.tokens.len() - 1 { src }
                else { format_layout_kept(path, src, kept) }
            }
        }
    }

// Only lexer-owned trivia is inspected. A directive occupies its own line;
// documentation comments, trailing comments and string contents are ordinary
// text. Leading/trailing horizontal whitespace around the comment is allowed.
let source_directives
    (source: Source)
    (lexed: lexer.LexedSource)
    (i: Int)
    (acc: Array[FmtDirective]): Array[FmtDirective]
=
    if i >= lexed.tokens.len() { acc }
    else {
        source_directives(
            source,
            lexed,
            i + 1,
            gap_directives(
                source,
                if i == 0 { 0 } else { lexed.ends[i - 1] },
                lexed.starts[i],
                i,
                acc
            )
        )
    }

let gap_directives
    (source: Source)
    (at: Int)
    (end: Int)
    (token: Int)
    (acc: Array[FmtDirective]): Array[FmtDirective]
=
    if at >= end { acc }
    else if at + 1 < end && source.text[at] == "/" && source.text[at + 1] == "/" {
        let finish = line_end_no_nl(source, at);
        let own_line = slice(source, line_start_of(source, at), at).trim() == "";
        let kind = if !own_line { 0 } else {
            match slice(source, at + 2, finish).trim() {
                "fmt: off" => 1,
                "fmt: on" => 2,
                "fmt: skip" => 3,
                _ => 0
            }
        };
        gap_directives(
            source,
            finish,
            end,
            token,
            if kind == 0 { acc } else {
                acc.push(FmtDirective { kind: kind, token: token })
            }
        )
    } else { gap_directives(source, at + 1, end, token, acc) }

let has_skip (directives: Array[FmtDirective]) (i: Int) (depth: Int): Bool =
    if i >= directives.len() { false }
    else {
        let kind = directives[i].kind;
        if kind == 3 && depth == 0 { true }
        else {
            has_skip(
                directives,
                i + 1,
                if kind == 1 { depth + 1 }
                else if kind == 2 { Int.max(0, depth - 1) } else { depth }
            )
        }
    }

let skipped_constructs
    (path: String)
    (src: String)
    (lexed: lexer.LexedSource)
    (acc: Map[Int, Int]): Map[Int, Int]
= {
    parser.set_source_context(path, src, lexed.starts, lexed.ends);
    parser.record_spans(true);
    let items = parser.parse_program(lexed.tokens).items;
    let spans = parser.recorded_spans();
    parser.record_spans(false);
    let ends = acc;
    for span in spans {
        ends = Map.insert(
            ends,
            span.start,
            Int.max(span.end, Map.get(ends, span.start).unwrap_or(-1))
        );
    };
    for item in items {
        ends = Map.insert(
            ends,
            item.start,
            Int.max(item.end, Map.get(ends, item.start).unwrap_or(-1))
        );
    };
    ends
}

let append_kept (kept: Array[KeptRange]) (next: KeptRange): Array[KeptRange] =
    if kept.is_empty() { kept.push(next) }
    else {
        let last = kept[kept.len() - 1];
        if next.first > last.after { kept.push(next) }
        else {
            kept.set(kept.len() - 1, KeptRange {
                first: last.first,
                after: Int.max(last.after, next.after)
            })
        }
    }

let directive_ranges
    (directives: Array[FmtDirective])
    (lexed: lexer.LexedSource)
    (ends: Map[Int, Int])
    (i: Int)
    (depth: Int)
    (first: Int)
    (kept: Array[KeptRange]): Array[KeptRange]
=
    if i >= directives.len() {
        if depth == 0 { kept }
        else { append_kept(kept, KeptRange { first: first, after: lexed.tokens.len() - 1 }) }
    } else {
        let d = directives[i];
        if d.kind == 1 {
            directive_ranges(
                directives,
                lexed,
                ends,
                i + 1,
                depth + 1,
                if depth == 0 { d.token } else { first },
                kept
            )
        } else if d.kind == 2 && depth > 0 {
            directive_ranges(
                directives,
                lexed,
                ends,
                i + 1,
                depth - 1,
                first,
                if depth == 1 { append_kept(kept, KeptRange { first: first, after: d.token }) }
                else { kept }
            )
        } else if d.kind == 3 && depth == 0 && d.token < lexed.tokens.len() - 1 {
            let end = Map.get(ends, lexed.starts[d.token]).unwrap_or(-1);
            let next = if end <= lexed.starts[d.token] { kept } else {
                append_kept(kept, KeptRange {
                    first: d.token,
                    after: offset_index(lexed.starts, end - 1, 0, lexed.starts.len()) + 1
                })
            };
            directive_ranges(directives, lexed, ends, i + 1, depth, first, next)
        } else { directive_ranges(directives, lexed, ends, i + 1, depth, first, kept) }
    }

let kept_at (kept: Array[KeptRange]) (token: Int) (lo: Int) (hi: Int): Option[KeptRange] =
    if lo >= hi { None }
    else {
        let mid = lo + (hi - lo) / 2;
        let range = kept[mid];
        if token < range.first { kept_at(kept, token, lo, mid) }
        else if token > range.after { kept_at(kept, token, mid + 1, hi) }
        else { Some(range) }
    }

let kept_token (kept: Array[KeptRange]) (token: Int): Bool =
    match kept_at(kept, token, 0, kept.len()) {
        Some(range) => token < range.after,
        None => false
    }

let kept_gap
    (kept: Array[KeptRange])
    (token: Int)
    (eof: Int)
    (original: String)
    (formatted: String): String
=
    match kept_at(kept, token, 0, kept.len()) {
        None => formatted,
        Some(range) => if token < range.after || token == eof { original }
        else if !original.contains("\n") { formatted }
        else {
            let lines = original.split("\n");
            let tail = formatted.split("\n");
            Array.join(lines.slice(0, lines.len() - 1), "\n").concat("\n")
                .concat(tail[tail.len() - 1])
        }
    }

let keep_start (lexed: lexer.LexedSource) (range: KeptRange): Int =
    if range.first == 0 { 0 } else { lexed.ends[range.first - 1] }

let keep_end (source: Source) (lexed: lexer.LexedSource) (range: KeptRange) (lines: Bool): Int =
    if range.after == lexed.tokens.len() - 1 { source.text.len() }
    else if !lines { if range.after == 0 { 0 } else { lexed.ends[range.after - 1] } }
    else {
        Int.max(
            if range.after == 0 { 0 } else { lexed.ends[range.after - 1] },
            line_start_of(source, lexed.starts[range.after])
        )
    }

// Restore after each layout stage, so later stages see the preserved layout
// rather than a temporary reformatted version of it. Width emission also keeps
// protected gaps live, so subsequent columns/continuations use their real text.
let restore_kept (path: String) (src: String) (out: String) (kept: Array[KeptRange]): String =
    if kept.is_empty() { out }
    else {
        let before = lexer.tokenize_spanned_at(src, path);
        let after = lexer.tokenize_spanned_at(out, path);
        if before.tokens.len() != after.tokens.len() {
            panic_raw("formatter preservation requires an unchanged token stream");
            src
        } else {
            let original = source_of(src, before.starts);
            let formatted = source_of(out, after.starts);
            restore_ranges(original, before, formatted, after, kept, 0, 0, "")
        }
    }

let restore_ranges
    (original: Source)
    (before: lexer.LexedSource)
    (formatted: Source)
    (after: lexer.LexedSource)
    (kept: Array[KeptRange])
    (i: Int)
    (at: Int)
    (acc: String): String
=
    if i >= kept.len() { acc.concat(slice(formatted, at, formatted.text.len())) }
    else {
        let range = kept[i];
        let lines = lexer.trivia_before_at(original.text, before, range.after).contains("\n");
        restore_ranges(
            original,
            before,
            formatted,
            after,
            kept,
            i + 1,
            keep_end(formatted, after, range, lines),
            acc.concat(slice(formatted, at, keep_start(after, range)))
                .concat(
                    slice(
                        original,
                        keep_start(before, range),
                        keep_end(original, before, range, lines)
                    )
                )
        )
    }
