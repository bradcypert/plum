// A Language Server, in Plum.
//
// Diagnostics, hover, go-to-definition, completion, formatting, and
// expand-selection.
//
// This header used to say the scope was diagnostics ALONE, because the
// position queries "need spans on every expression, where this compiler
// records them per statement". Hover, definition and completion arrived
// before that was true, answered from the name index and from the
// checker's recorded types -- neither of which needs to know where an
// expression begins.
//
// `textDocument/selectionRange` is the one that did need it, and it is
// the reason expression spans were worth building: the chain it returns
// IS the nesting of expressions around a cursor. It arrived with them.
//
// Spans also ended the other half of that sentence's legacy. Every range
// this server produced was ZERO WIDTH -- legal LSP, and the reason a
// diagnostic underlined nothing and a jump selected nothing.
//
// **Diagnostics come from a SUBPROCESS**, not from calling the checker
// in-process. `fail_tc` reports by aborting (`panic_raw`), so an
// in-process check would take the server down with the first type error
// a user typed — which is every keystroke of a half-written program.
// The same reason `test` runs each test in its own process. The child
// is this binary re-invoked as `check`, and its own diagnostic text,
// already carrying `path:line:col`, is what becomes the diagnostic.
//
// That rule is not only about the CHECKER, which is what it took a
// crash to notice. The PARSER aborts the same way, so anything in this
// server that parses has to be a subprocess too. Formatting was not,
// and a format request on a buffer with a syntax error exited the
// process mid-session -- after printing a compiler error onto the
// JSON-RPC stream. Format-on-save runs while you are still typing.
// `plum fmt` and `plum spans` are both children now, and
// `bootstrap/lsp-smoke` asserts the server answers a `shutdown` sent
// after an unformattable buffer.
//
// **Synchronous, one message at a time.** A language server is a
// request loop; nothing here needs concurrency, and the debouncing the
// real LSP does exists to fix a race that a single-threaded loop cannot
// have.
//
// **Unsaved buffers are supported.** This note used to say they were
// not: "`didChange` does not re-check, because the checker reads from
// disk and reporting disk state against an edited buffer means
// reporting the wrong lines." The constraint was real -- the checker
// does read from disk -- but the conclusion was not forced. The fix is
// to give it a disk to read that matches the buffer: `didChange`
// snapshots the project into a temp directory, substitutes the edited
// file's unsaved text, and checks THAT. See `lsp_check_buffer`.

// --- JSON helpers ---
//
// `json_parse`/`json_stringify` come from the prelude; these are the
// small accessors that make an object usable as a record.

pub let json_field (v: JsonValue) (key: String): Option[JsonValue] =
    match v {
        JsonObject(entries) => json_field_acc(entries, key, 0),
        _ => None,
    }

let json_field_acc (entries: Array[JsonEntry]) (key: String) (i: Int): Option[JsonValue] =
    if i >= entries.len() { None }
    else if entries[i].key == key { Some(entries[i].value) }
    else { json_field_acc(entries, key, i + 1) }

pub let json_str (v: JsonValue): String = match v { JsonString(s) => s, _ => "" }

pub let json_field_str (v: JsonValue) (key: String): String =
    match json_field(v, key) { Some(f) => json_str(f), None => "" }

// --- Framing ---
//
// `Content-Length: N\r\n\r\n<N bytes>`. Parsing a header line is pure;
// READING them is not, and lives in `main.plum` -- an `extern "C"`
// block only works in the root module, because the real compiler
// prefixes a module's item names and the linker then looks for
// `lsp.stdout_write`.

// The byte count from a `Content-Length:` header, or -1 for any other
// header line. Every other header is ignored, which the protocol allows.
pub let content_length (line: String): Int =
    if line.starts_with("Content-Length:") {
        Result.unwrap_or(String.parse_int(String.trim_start(String.slice(line, 15, line.len()))), 0 - 1)
    } else { 0 - 1 }

// `Content-Length` is in BYTES. `.len()` is the string cell's byte
// length in this backend, so the two agree here -- but the real
// compiler counts CHARACTERS, so a server built with it would frame a
// diagnostic quoting a non-ASCII identifier differently. Recorded
// rather than papered over: the fix is a byte-length primitive, and no
// diagnostic this server emits today is non-ASCII.
pub let frame (body: String): String =
    "Content-Length: ".concat(body.len().to_string()).concat("\r\n\r\n").concat(body)

// --- Requests ---

pub struct Request { pub method: String, pub id: Option[JsonValue], pub params: JsonValue }

pub let parse_request (body: String): Option[Request] =
    match json_parse(body) {
        Err(_) => None,
        Ok(v) => Some(Request {
            method: json_field_str(v, "method"),
            id: json_field(v, "id"),
            params: match json_field(v, "params") { Some(p) => p, None => JsonNull },
        }),
    }

// --- Responses ---

pub let response (id: JsonValue) (result: JsonValue): String =
    json_stringify(JsonObject([
        JsonEntry { key: "jsonrpc", value: JsonString("2.0") },
        JsonEntry { key: "id", value: id },
        JsonEntry { key: "result", value: result },
    ]))

pub let notification (method: String) (params: JsonValue): String =
    json_stringify(JsonObject([
        JsonEntry { key: "jsonrpc", value: JsonString("2.0") },
        JsonEntry { key: "method", value: JsonString(method) },
        JsonEntry { key: "params", value: params },
    ]))

// `textDocumentSync: 1` is FULL sync. Nothing here uses the document
// text the client sends, but announcing incremental sync would be a
// promise this server does not keep.
pub let capabilities (): JsonValue =
    JsonObject([
        JsonEntry { key: "capabilities", value: JsonObject([
            // 1 = FULL sync: the client sends the whole document on
            // every change. That is what makes live diagnostics
            // possible without this server keeping its own buffer --
            // see `change_text`.
            JsonEntry { key: "textDocumentSync", value: JsonNumber(1.0) },
            JsonEntry { key: "hoverProvider", value: JsonBool(true) },
            JsonEntry { key: "definitionProvider", value: JsonBool(true) },
            // `plum fmt`, over LSP. The formatter is a pure
            // `String -> String`, so the whole of this capability is
            // one whole-file `TextEdit` -- see `format_result`.
            JsonEntry { key: "documentFormattingProvider", value: JsonBool(true) },
            // Expand-selection. The editor asks for a position and gets
            // back the chain of constructs around it, innermost first,
            // so pressing the key repeatedly grows the selection by one
            // real construct at a time rather than by a word or a line.
            //
            // It is the one request that could not be answered at all
            // until expression spans existed -- the chain IS the nesting
            // of expressions, and nothing else in the server needs the
            // whole of it.
            JsonEntry { key: "selectionRangeProvider", value: JsonBool(true) },
            // No `triggerCharacters`: this server offers NAMES, so
            // completion is invoked the ordinary way -- as an
            // identifier is typed, or explicitly. A trigger character
            // would be a promise about `.`, which needs the type of
            // whatever precedes it and is not implemented.
            //
            // `resolveProvider: false` says every item is complete as
            // sent; there is no second round trip to fill in
            // documentation, because the detail IS the signature.
            JsonEntry { key: "completionProvider", value: JsonObject([
                JsonEntry { key: "resolveProvider", value: JsonBool(false) },
                // `.` is a trigger character now that there is
                // something to say about it: the members of whatever
                // precedes the dot. Without it an editor only asks
                // while an identifier is being typed, and `p.` is not
                // an identifier.
                JsonEntry { key: "triggerCharacters", value: JsonArray([JsonString(".")]) },
            ]) },
        ]) },
    ])

// --- Diagnostics ---

// `path` is the file the error is IN, which is not always the file
// being edited: a project is several files and a mistake in one is
// reported while you type in another. It used to be parsed off the
// `-->` line and thrown away, so every diagnostic was attributed to
// whatever document triggered the check -- harmless when that only
// happened on save, actively misleading once it happens per keystroke.
// `end_line`/`end_col` start out equal to `line`/`col`: the checker's
// text reports one position and that is all it reports. `widen` fills
// them in from the spans, and a diagnostic nobody widened is exactly
// the zero-width point this published before.
pub struct Diagnostic { pub path: String, pub line: Int, pub col: Int, pub end_line: Int, pub end_col: Int, pub message: String }

// The same diagnostic, ending somewhere else.
pub let with_end (d: Diagnostic) (line: Int) (col: Int): Diagnostic =
    Diagnostic { path: d.path, line: d.line, col: d.col, end_line: line, end_col: col, message: d.message }

// The checker's own output, parsed back. It looks like
//
//     error: <message>
//       --> <path>:<line>:<col>
//
// which this reads rather than duplicating the checker's knowledge of
// what an error is. Coupled to that format on purpose: one renderer,
// one parser, and `lexer.render_at` is where the format lives.
pub let parse_diagnostic (output: String): Option[Diagnostic] = {
    let lines = String.lines(output);
    if Array.is_empty(lines) { None }
    else {
        let message = strip_prefix(lines[0], "error: ");
        find_arrow(lines, message, 1)
    }
}

let find_arrow (lines: Array[String]) (message: String) (i: Int): Option[Diagnostic] =
    if i >= lines.len() {
        // A message with no `-->` still deserves to be reported; it just
        // has nowhere better to point than the top of the file.
        Some(Diagnostic { path: "", line: 1, col: 1, end_line: 1, end_col: 1, message: message })
    } else {
        let t = String.trim_start(lines[i]);
        if t.starts_with("--> ") {
            let rest = String.slice(t, 4, t.len());
            let parts = rest.split(":");
            if parts.len() >= 3 {
                Some(Diagnostic {
                    // Everything before the final two colons. A path may
                    // contain colons of its own, so this rejoins rather
                    // than taking `parts[0]`.
                    path: Array.join(Array.slice(parts, 0, parts.len() - 2), ":"),
                    line: Result.unwrap_or(String.parse_int(parts[parts.len() - 2]), 1),
                    col: Result.unwrap_or(String.parse_int(parts[parts.len() - 1]), 1),
                    end_line: Result.unwrap_or(String.parse_int(parts[parts.len() - 2]), 1),
                    end_col: Result.unwrap_or(String.parse_int(parts[parts.len() - 1]), 1),
                    message: message,
                })
            } else { Some(Diagnostic { path: "", line: 1, col: 1, end_line: 1, end_col: 1, message: message }) }
        } else { find_arrow(lines, message, i + 1) }
    }

let strip_prefix (s: String) (p: String): String =
    if s.starts_with(p) { String.slice(s, p.len(), s.len()) } else { s }

// A source range, 1-based and half-open at the end, the way the
// compiler counts everywhere else. `pos_json` does the conversion to
// LSP's 0-based line and character exactly once, here.
//
// Every range this server produced before 2026-08-31 was ZERO WIDTH --
// `start` and `end` the same point. That is legal LSP and it is why a
// diagnostic underlined nothing, a jump-to-definition selected nothing,
// and hover highlighted nothing. Spans are what makes a real range
// available; this is the type that carries one.
pub struct Rng { pub sl: Int, pub sc: Int, pub el: Int, pub ec: Int }

pub let pos_json (line: Int) (col: Int): JsonValue =
    JsonObject([
        JsonEntry { key: "line", value: JsonNumber((line - 1).to_float()) },
        JsonEntry { key: "character", value: JsonNumber((col - 1).to_float()) },
    ])

pub let range_json (r: Rng): JsonValue =
    JsonObject([
        JsonEntry { key: "start", value: pos_json(r.sl, r.sc) },
        JsonEntry { key: "end", value: pos_json(r.el, r.ec) },
    ])

// A `SelectionRange` is a range plus its PARENT, nested all the way
// out, so the whole chain is one object. `chain` is innermost first,
// which means this builds from the outside in and hands back the head.
pub let selection_range_json (chain: Array[Rng]) (i: Int): JsonValue =
    if i >= chain.len() { JsonNull }
    else {
        let parent = selection_range_json(chain, i + 1);
        match parent {
            JsonNull => JsonObject([JsonEntry { key: "range", value: range_json(chain[i]) }]),
            p => JsonObject([
                JsonEntry { key: "range", value: range_json(chain[i]) },
                JsonEntry { key: "parent", value: p },
            ]),
        }
    }

// LSP positions are 0-based; the compiler's are 1-based.
// `end_col` is where the reported construct STOPS -- the caller works
// it out from the spans, and passes the start column again when it
// cannot, which reproduces the old zero-width point exactly. A
// diagnostic that underlines nothing is still better than one that
// underlines the wrong thing.
pub let diagnostic_json (d: Diagnostic): JsonValue =
    JsonObject([
        JsonEntry { key: "range", value: range_json(Rng { sl: d.line, sc: d.col, el: d.end_line, ec: d.end_col }) },
        JsonEntry { key: "severity", value: JsonNumber(1.0) },
        JsonEntry { key: "source", value: JsonString("plum") },
        JsonEntry { key: "message", value: JsonString(d.message) },
    ])

pub let publish_message (uri: String) (diagnostics: Array[JsonValue]): String =
    notification("textDocument/publishDiagnostics", JsonObject([
        JsonEntry { key: "uri", value: JsonString(uri) },
        JsonEntry { key: "diagnostics", value: JsonArray(diagnostics) },
    ]))

// --- Paths ---

// `file:///a/b/c.plum` -> `/a/b/c.plum`. No percent-decoding: a path
// with an escaped character comes back wrong, a real limitation and a
// small one next to not having a server at all.
// `file:///home/x/a.plum` -> `/home/x/a.plum`.
// `file:///C:/x/a.plum`     -> `C:/x/a.plum`.
//
// A `file:` URI has an empty authority, so the path component always
// begins with `/`. On Unix that slash IS the root and must be kept. On
// Windows the path begins with a drive letter instead, and the slash
// in front of it belongs to the URI, not to the path -- `/C:/x` opens
// nothing. Stripping a fixed seven characters was right on one
// platform and silently wrong on the other.
pub let uri_to_path (uri: String): String =
    if uri.starts_with("file://") {
        let rest = String.slice(uri, 7, uri.len());
        if starts_with_drive(rest) { String.slice(rest, 1, rest.len()) } else { rest }
    } else { uri }

// `/C:/...` -- a slash, then a letter, then a colon.
let starts_with_drive (s: String): Bool =
    s.len() >= 3 && String.slice(s, 0, 1) == "/" && String.slice(s, 2, 3) == ":"

// `C:/...` -- the same shape without the leading slash.
let is_drive_path (p: String): Bool =
    p.len() >= 2 && String.slice(p, 1, 2) == ":"

// No `String.last_index_of` in either prelude, and one call site does
// not justify adding one.
pub let dir_of (path: String): String = {
    let cs = chars_of(path);
    let i = last_slash(cs, cs.len() - 1);
    if i < 0 { "." } else { String.slice(path, 0, i) }
}

// The filename alone -- `/a/b/c.plum` -> `c.plum`. The counterpart of
// `dir_of`, and used to place a buffer's text inside the scratch copy.
pub let base_of (path: String): String = {
    let cs = chars_of(path);
    let i = last_slash(cs, cs.len() - 1);
    if i < 0 { path } else { String.slice(path, i + 1, path.len()) }
}

let last_slash (cs: Array[String]) (i: Int): Int =
    if i < 0 { 0 - 1 } else if cs[i] == "/" { i } else { last_slash(cs, i - 1) }

// --- Hover and go-to-definition ---
//
// Both are NAME-based, and that is a real limitation worth stating up
// front: the identifier under the cursor is looked up among the
// project's TOP-LEVEL definitions by name. So `scale` jumps to `let
// scale`, and hovering it shows that signature -- but a local variable
// that shadows a top-level name resolves to the top-level one, and a
// local with no top-level namesake resolves to nothing.
//
// The precise version needs a position on every expression, which this
// compiler records per STATEMENT (see DESIGN.md's "AST positions"):
// 181 match sites and 113 constructions away, against roughly zero for
// this. Name-based go-to-definition is also what the overwhelming
// majority of real use is -- jump to the function or type under the
// cursor -- so this buys most of the value at a fraction of the risk,
// and the precise version remains additive on top.

// --- Completion ---

// No path or line, unlike `Def`: completion inserts a name, it does not
// navigate to one. Most candidates come from the prelude, which has no
// file to navigate to at all.
pub struct Completion { pub name: String, pub kind: String, pub detail: String }

pub let parse_completions (text: String): Array[Completion] =
    match json_parse(text) {
        Err(_) => [],
        Ok(v) => match v {
            JsonArray(items) => parse_completions_acc(items, 0, []),
            _ => [],
        },
    }

let parse_completions_acc (items: Array[JsonValue]) (i: Int) (acc: Array[Completion]): Array[Completion] =
    if i >= items.len() { acc }
    else {
        parse_completions_acc(items, i + 1, acc.push(Completion {
            name: json_field_str(items[i], "name"),
            kind: json_field_str(items[i], "kind"),
            detail: json_field_str(items[i], "detail"),
        }))
    }

// `CompletionItemKind` from the LSP specification. The numbers are the
// protocol's, not ours -- an editor picks the icon from them, so a
// wrong one is a wrong picture next to a right name.
let completion_kind (kind: String): Float =
    if kind == "function" { 3.0 }
    else if kind == "field" { 5.0 }
    else if kind == "variable" { 6.0 }
    else if kind == "keyword" { 14.0 }
    else if kind == "struct" { 22.0 }
    else if kind == "enum" { 13.0 }
    else if kind == "variant" { 20.0 }
    else { 1.0 }

// `isIncomplete: false` tells the client the list is the WHOLE list, so
// it may filter what it already has as the user keeps typing instead of
// asking again on every keystroke. That is what makes returning all of
// them affordable.
pub let completion_result (items: Array[Completion]): JsonValue =
    JsonObject([
        JsonEntry { key: "isIncomplete", value: JsonBool(false) },
        JsonEntry { key: "items", value: JsonArray(completion_items(items, 0, [])) },
    ])

let completion_items (items: Array[Completion]) (i: Int) (acc: Array[JsonValue]): Array[JsonValue] =
    if i >= items.len() { acc }
    else {
        completion_items(items, i + 1, acc.push(JsonObject([
            JsonEntry { key: "label", value: JsonString(items[i].name) },
            JsonEntry { key: "kind", value: JsonNumber(completion_kind(items[i].kind)) },
            JsonEntry { key: "detail", value: JsonString(items[i].detail) },
        ])))
    }

pub struct Def { pub name: String, pub path: String, pub line: Int, pub col: Int, pub kind: String, pub detail: String }

pub let parse_defs (text: String): Array[Def] =
    match json_parse(text) {
        Err(_) => [],
        Ok(v) => match v {
            JsonArray(items) => parse_defs_acc(items, 0, []),
            _ => [],
        },
    }

let parse_defs_acc (items: Array[JsonValue]) (i: Int) (acc: Array[Def]): Array[Def] =
    if i >= items.len() { acc }
    else {
        parse_defs_acc(items, i + 1, acc.push(Def {
            name: json_field_str(items[i], "name"),
            path: json_field_str(items[i], "path"),
            line: json_field_int(items[i], "line"),
            col: json_field_int(items[i], "col"),
            kind: json_field_str(items[i], "kind"),
            detail: json_field_str(items[i], "detail"),
        }))
    }

pub let json_field_int (v: JsonValue) (key: String): Int =
    match json_field(v, key) {
        Some(f) => match f { JsonNumber(n) => float_to_int(n), _ => 0 },
        None => 0,
    }

// `Float.floor` then a cast would be the obvious route, but there is no
// float-to-int conversion in either prelude; JSON numbers that came
// from line/column integers round-trip exactly, so a subtraction loop
// is both correct and small.
let float_to_int (f: Float): Int = float_to_int_acc(f, 0)
let float_to_int_acc (f: Float) (acc: Int): Int =
    if f < 1.0 { acc } else { float_to_int_acc(f - 1.0, acc + 1) }

pub let find_def (defs: Array[Def]) (name: String) (i: Int): Option[Def] =
    if i >= defs.len() { None }
    else if defs[i].name == name { Some(defs[i]) }
    else { find_def(defs, name, i + 1) }

// One field of a `query` answer, or ""/0 when it answered `{}`.
pub let query_field (out: String) (key: String): String =
    match json_parse(out) {
        Err(_) => "",
        Ok(v) => json_field_str(v, key),
    }

pub let query_int (out: String) (key: String): Int =
    match json_parse(out) {
        Err(_) => 0,
        Ok(v) => json_field_int(v, key),
    }

// A location in a file the client already has open, from a line and
// column rather than from an indexed definition.
// `len` is the length of the name being jumped to, so the editor lands
// with that name SELECTED rather than with a bare caret before it.
pub let location_at (path: String) (line: Int) (col: Int) (len: Int): JsonValue =
    JsonObject([
        JsonEntry { key: "uri", value: JsonString("file://".concat(path)) },
        JsonEntry { key: "range", value: range_json(Rng { sl: line, sc: col, el: line, ec: col + len }) },
    ])

// The optional `range` on a hover says WHAT is being described, and
// editors highlight it while the tooltip is up. Without it the user is
// told a type and left to guess which of the three names under the
// pointer it belongs to.
pub let hover_text (text: String) (r: Rng): JsonValue =
    JsonObject([
        JsonEntry { key: "contents", value: JsonObject([
            JsonEntry { key: "kind", value: JsonString("plaintext") },
            JsonEntry { key: "value", value: JsonString(text) },
        ]) },
        JsonEntry { key: "range", value: range_json(r) },
    ])

pub let hover_result (d: Def) (r: Rng): JsonValue =
    JsonObject([
        JsonEntry { key: "contents", value: JsonObject([
            JsonEntry { key: "kind", value: JsonString("plaintext") },
            JsonEntry { key: "value", value: JsonString(d.detail) },
        ]) },
        JsonEntry { key: "range", value: range_json(r) },
    ])

pub let location_result (d: Def): JsonValue = location_at(d.path, d.line, d.col, d.name.len())

// `selectionRange` asks about SEVERAL positions at once and expects one
// chain back per position, in order.
pub let params_positions (params: JsonValue): Array[JsonValue] =
    match json_field(params, "positions") {
        Some(JsonArray(items)) => items,
        _ => [],
    }

pub let position_line (p: JsonValue): Int = json_field_int(p, "line") + 1
pub let position_col (p: JsonValue): Int = json_field_int(p, "character") + 1

// LSP positions are 0-based; everything inside the compiler is 1-based.
pub let params_line (params: JsonValue): Int =
    match json_field(params, "position") { Some(p) => json_field_int(p, "line") + 1, None => 1 }

pub let params_col (params: JsonValue): Int =
    match json_field(params, "position") { Some(p) => json_field_int(p, "character") + 1, None => 1 }

// The inverse of `uri_to_path`, including the slash a drive letter
// needs putting back: `C:/x` is `file:///C:/x`, and `file://C:/x` would
// make `C:` the AUTHORITY -- a host name -- rather than part of the
// path.
pub let path_to_uri (path: String): String =
    if path.starts_with("file://") { path }
    else if is_drive_path(path) { "file:///".concat(path) }
    else { "file://".concat(path) }

// `didChange` under FULL sync (`textDocumentSync: 1`) carries the whole
// document in the last content change, which is why full sync is what
// this server asks for: an incremental range would have to be applied
// to a buffer this server does not keep.
// One `TextEdit` replacing the entire document.
//
// A minimal diff would be less text on the wire and is not worth it:
// the edits an editor applies have to be computed against the exact
// text the server formatted, and a whole-file replacement is the one
// shape that cannot be wrong about a range. Editors preserve the
// cursor across it.
//
// The end position is `(lines, 0)` -- one past the last line, column
// zero -- which is how LSP spells "to the end" for a document that
// ends in a newline. Overshooting the line count is legal and clients
// clamp, but being exact means a client that does not clamp is not
// relying on charity.
pub let format_result (formatted: String) (lines: Int): JsonValue =
    JsonArray([
        JsonObject([
            JsonEntry { key: "range", value: JsonObject([
                JsonEntry { key: "start", value: position_json(0, 0) },
                JsonEntry { key: "end", value: position_json(lines, 0) },
            ]) },
            JsonEntry { key: "newText", value: JsonString(formatted) },
        ]),
    ])

let position_json (line: Int) (col: Int): JsonValue =
    JsonObject([
        JsonEntry { key: "line", value: JsonNumber(line.to_float()) },
        JsonEntry { key: "character", value: JsonNumber(col.to_float()) },
    ])

pub let change_text (params: JsonValue): Option[String] =
    match json_field(params, "contentChanges") {
        Some(JsonArray(changes)) =>
            if Array.is_empty(changes) { None }
            else { Some(json_field_str(changes[changes.len() - 1], "text")) },
        _ => None,
    }

// The full text a `didOpen` carries. `didChange` has its own shape --
// an array of content changes -- which is why the two are separate.
pub let open_text (params: JsonValue): Option[String] =
    match json_field(params, "textDocument") {
        Some(doc) => match json_field(doc, "text") { Some(JsonString(t)) => Some(t), _ => None },
        None => None,
    }

pub let document_uri (params: JsonValue): String =
    match json_field(params, "textDocument") {
        Some(doc) => json_field_str(doc, "uri"),
        None => "",
    }
