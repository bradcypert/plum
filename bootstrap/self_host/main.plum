// Self-hosting bootstrap — project root. See DESIGN.md's "Self-hosting
// bootstrap corpus" and "Stage 1/2/3/4: self-hosted lexer/parser/
// interpreter/type checker" sections, and the project roadmap, for the
// full story.
//
// `lexer/`, `parser/`, `interp/`, and `typecheck/` are library MODULES
// (Go-style directory modules — see DESIGN.md's "Module system"
// section), not their own runnable projects; this file is the one real
// entry point tying them together.
//
// Modes (dispatched on the first process arg):
//   plum build bootstrap/self_host -o sh && ./sh tokens <file>
//     — tokenize <file>, print `lexer.render_tokens`'s output.
//     Validate against bootstrap/corpus/*/*.tokens.
//   ./sh ast <file>
//     — tokenize + parse <file>, print `parser.render_program`'s
//     output. Validate against bootstrap/corpus/*/*.expected.
//   ./sh run <file-or-project-dir> [args...]
//     — tokenize + parse + TYPE-CHECK + INTERPRET <file>'s `main()`,
//     printing whatever the program itself prints (nothing extra — no
//     return-value echo). Matches the real `plum run`'s own order
//     (type-check first, only interpret a program that passes) — an
//     ill-typed program never reaches the interpreter at all, the same
//     `fail_tc`/`panic_raw` `./sh check` alone already produces.
//     A project DIRECTORY works too, loaded exactly the way `check`
//     loads one, with everything after it passed to the interpreted
//     program as its own `args()` — which is how the self-hosted
//     compiler gets run under the self-hosted interpreter:
//       ./sh run bootstrap/self_host check bootstrap/self_host  -> ok
//     Validate against bootstrap/exec_corpus/*/expected.txt (14 of 15
//     — `tuples/` fails type-checking specifically, see `typecheck_
//     corpus/README.md`, so it no longer reaches "run" successfully
//     either; that one fixture is now `check`/`run`-exempt, tracked as
//     a real, documented exception, not a regression). Includes
//     closures-as-values (`closures/`, `closures_in_structs/`) and
//     arrays (`arrays/`) — both the interpreter and type checker
//     support them now.
//   ./sh check <file>
//     — tokenize + parse + TYPE-CHECK every top-level function's body
//     against its own declared signature, printing "ok" on success (a
//     real `panic_raw` on any type error — see `typecheck/infer.plum`'s
//     own top comment for why). Validate against bootstrap/exec_corpus
//     (every fixture is well-typed, "ok" expected) and bootstrap/
//     typecheck_corpus (a mix of well-typed and deliberately-ill-typed
//     snippets). Kept as its OWN mode, not folded away now that `run`
//     also type-checks — useful on its own for a program whose `main`
//     you don't actually want to execute yet.
//
// **Validate via the NATIVE build, not `plum run`** — see `lexer/
// lexer.plum`'s own top comment for why (a real, documented
// interpreter scaling limit hit while validating Stage 1, not a
// correctness bug).

use lexer;
use parser;
use lsp;
use interp;
use typecheck;
use codegen;

// `defs <project>` -- every top-level definition, as JSON, for the
// language server to answer hover and go-to-definition with.
//
// A SUBCOMMAND rather than something the server does in-process, for
// the same reason `check` is: the parser reports by aborting, so a file
// with a syntax error -- which is most files, most of the time, while
// someone is typing -- would take the server down. A child that dies
// simply yields no index.
let cmd_defs (dir: String): Unit = {
    let items = collect_project(dir);
    println(json_stringify(JsonArray(defs_of(items, 0, []))));
}

let defs_of (items: Array[parser.ItemNode]) (i: Int) (acc: Array[JsonValue]): Array[JsonValue] =
    if i >= items.len() { acc }
    else {
        match def_entry(items[i]) {
            Some(e) => defs_of(items, i + 1, acc.push(e)),
            None => defs_of(items, i + 1, acc),
        }
    }

let def_entry (item: parser.ItemNode): Option[JsonValue] =
    match item.kind {
        IKLet(def) => Some(def_json(item, def.name, "function", def_signature(def))),
        IKStruct(decl) => Some(def_json(item, decl.name, "struct", "struct ".concat(decl.name))),
        IKEnum(decl) => Some(def_json(item, decl.name, "enum", "enum ".concat(decl.name))),
        _ => None,
    }

// The position is stored as a character OFFSET; the server wants a
// line and column, and resolving one needs the file the item came
// from. Read per item: an index is built once per request, and a
// project is a handful of files.
let def_json (item: parser.ItemNode) (name: String) (kind: String) (detail: String): JsonValue = {
    let lc = match read_file(item.path) {
        Ok(src) => lexer.line_col(src, item.start),
        Err(_) => lexer.LineCol { line: 1, col: 1 },
    };
    JsonObject([
        JsonEntry { key: "name", value: JsonString(name) },
        JsonEntry { key: "path", value: JsonString(item.path) },
        JsonEntry { key: "line", value: JsonNumber(lc.line.to_float()) },
        JsonEntry { key: "col", value: JsonNumber(lc.col.to_float()) },
        JsonEntry { key: "kind", value: JsonString(kind) },
        JsonEntry { key: "detail", value: JsonString(detail) },
    ])
}

// What hover shows: the declaration as written, near enough to be
// recognisable without re-rendering the whole AST.
let def_signature (def: parser.LetDefNode): String =
    "let ".concat(def.name).concat(" ").concat(param_list(def.params, 0, ""))
        .concat(match def.ret_ty { Some(t) => ": ".concat(parser.render_type(t)), None => "" })

let param_list (ps: Array[parser.ParamNode]) (i: Int) (acc: String): String =
    if i >= ps.len() { acc }
    else {
        let one = match ps[i] {
            ParamIdent(n) => "(".concat(n).concat(")"),
            ParamPatternTy(pat, t) => match t {
                Some(ty) => "(".concat(parser.render_pattern(pat)).concat(": ").concat(parser.render_type(ty)).concat(")"),
                None => "(".concat(parser.render_pattern(pat)).concat(")"),
            },
        };
        param_list(ps, i + 1, if acc == "" { one } else { acc.concat(" ").concat(one) })
    }

// --- The language server's I/O ---
//
// The extern block lives HERE, in the root module, not in `lsp/`: the
// real compiler prefixes a module's item names, so an extern declared
// in `lsp.plum` is looked up as `lsp.stdout_write` and never found.
// `lsp.plum` is the pure protocol logic; this is the part that talks.
extern "C" {
    fn stdin_read_line() -> CStr;
    fn stdin_read_n(n: Int) -> CStr;
    fn stdout_write(s: CStr);
    fn stdout_flush();
}

// The shim owns and reuses its buffers, so `.as_string()` must copy
// before the next read overwrites them -- which it does. Nothing frees:
// see `native_stdlib/io_shim.c` for why caller-owned buffers are not
// portable across the two compilers.
let lsp_read_line (): String = unsafe { stdin_read_line().as_string() }
let lsp_read_bytes (n: Int): String = unsafe { stdin_read_n(n).as_string() }
let lsp_write (s: String): Unit = unsafe { stdout_write(s.as_cstr()) }
// stdout is block-buffered when it is a pipe; a server that never
// flushes deadlocks against a client waiting for a reply it has
// already written.
let lsp_flush (): Unit = unsafe { stdout_flush() }

let lsp_send (body: String): Unit = { lsp_write(lsp.frame(body)); lsp_flush(()) }

// Headers until the blank line; the body is length-prefixed.
let lsp_read_message (): String = {
    let len = lsp_read_headers(0 - 1);
    if len <= 0 { "" } else { lsp_read_bytes(len) }
}

let lsp_read_headers (len: Int): Int = {
    let line = lsp_read_line(());
    if line == "" { len }
    else {
        let n = lsp.content_length(line);
        lsp_read_headers(if n >= 0 { n } else { len })
    }
}

// Diagnostics come from a SUBPROCESS: `fail_tc` reports by aborting, so
// checking in-process would take the server down on the first type
// error a user typed. `/proc/self/exe` is the same trick `cmd_test`
// uses -- no path to look up, and no chance of running a different
// build than this one.
let lsp_check (path: String): Array[JsonValue] =
    match run_process("/proc/self/exe", ["check", lsp.dir_of(path)]) {
        Err(_) => [],
        Ok(r) =>
            if r.exit_code == 0 { [] }
            else {
                match lsp.parse_diagnostic(r.stdout.concat(r.stderr)) {
                    Some(d) => [lsp.diagnostic_json(d)],
                    None => [],
                }
            },
    }

let lsp_serve (): Unit = lsp_loop(true)

let lsp_loop (running: Bool): Unit =
    if !running { () }
    else {
        let body = lsp_read_message(());
        if body == "" { () } else { lsp_loop(lsp_handle(body)) }
    }

// Returns whether to keep serving.
let lsp_handle (body: String): Bool =
    match lsp.parse_request(body) {
        None => true,
        Some(req) =>
            if req.method == "initialize" {
                lsp_reply(req.id, lsp.capabilities(()));
                true
            } else if req.method == "shutdown" {
                lsp_reply(req.id, JsonNull);
                true
            } else if req.method == "exit" {
                false
            } else if req.method == "textDocument/hover" || req.method == "textDocument/definition" {
                lsp_reply(req.id, lsp_answer_query(req.method, req.params));
                true
            } else if req.method == "textDocument/didOpen" || req.method == "textDocument/didSave" {
                let uri = lsp.document_uri(req.params);
                if uri == "" { () }
                else { lsp_send(lsp.publish_message(uri, lsp_check(lsp.uri_to_path(uri)))) };
                true
            } else {
                // An unknown NOTIFICATION is ignored; an unknown REQUEST
                // would hang a client waiting for a reply, so it gets an
                // empty result instead of silence.
                lsp_reply(req.id, JsonNull);
                true
            },
    }

// Hover and go-to-definition share everything but the last step: find
// the identifier under the cursor, look it up in the project's
// definition index, and answer.
//
// The index comes from a subprocess (`defs`), rebuilt per request. That
// is not free, but a project here is a handful of files, and a cache
// would need invalidating on every edit -- which is exactly the kind of
// stale-state bug a language server is prone to. Correct and simple
// first; the cache is measurable later if it matters.
let lsp_answer_query (method: String) (params: JsonValue): JsonValue = {
    let uri = lsp.document_uri(params);
    let path = lsp.uri_to_path(uri);
    if uri == "" { JsonNull }
    else {
        match read_file(path) {
            Err(_) => JsonNull,
            Ok(src) => {
                let off = lexer.offset_of(src, lsp.params_line(params), lsp.params_col(params));
                let name = lexer.ident_at(src, off);
                if name == "" { JsonNull }
                else {
                    match lsp.find_def(lsp_defs(path), name, 0) {
                        None => JsonNull,
                        Some(d) => if method == "textDocument/hover" { lsp.hover_result(d) } else { lsp.location_result(d) },
                    }
                }
            },
        }
    }
}

let lsp_defs (path: String): Array[lsp.Def] =
    match run_process("/proc/self/exe", ["defs", lsp.dir_of(path)]) {
        Err(_) => [],
        Ok(r) => if r.exit_code == 0 { lsp.parse_defs(r.stdout) } else { [] },
    }

let lsp_reply (id: Option[JsonValue]) (result: JsonValue): Unit =
    match id { Some(i) => lsp_send(lsp.response(i, result)), None => () }

let usage (): Unit = println("usage: self_host (tokens|dump-tokens|ast|dump-ast|run|emit-llvm) <file> | check <file-or-project-dir> | build <project-dir> [-o <out>] | test <project-dir> | new <name> | lsp")

// Every top-level `let` whose name's LAST segment starts with `test_`.
// The last-segment rule is what makes a module-qualified
// `lexer.test_foo` discoverable — the same rule the real compiler's
// `discover_tests` uses.
let discover_tests (items: Array[parser.ItemNode]) (i: Int) (acc: Array[String]): Array[String] =
    if i >= items.len() { acc }
    else {
        let next = match items[i].kind {
            IKLet(def) => {
                let parts = def.name.split(".");
                let last = parts[parts.len() - 1];
                // The NAME is not enough: a helper that merely starts
                // with `test_` and takes real arguments is not a test,
                // and calling it with none reads out of bounds instead
                // of reporting a failure. Caught immediately -- this
                // compiler's own `cmd_test`/`cmd_test_one` were named
                // `test_*` at first and were "discovered".
                if last.starts_with("test_") && takes_no_args(def.params) { acc.push(def.name) } else { acc }
            },
            _ => acc,
        };
        discover_tests(items, i + 1, next)
    }

// `let f ()` parses as ONE parameter holding the empty-tuple pattern,
// not as zero parameters -- the unit-argument convention. So "callable
// with no arguments" is that shape, or genuinely no parameters at all.
let takes_no_args (params: Array[parser.ParamNode]): Bool =
    if Array.is_empty(params) { true }
    else if params.len() > 1 { false }
    else {
        match params[0] {
            ParamPatternTy(pat, _) => match pat { PTuple(elems) => Array.is_empty(elems), _ => false },
            _ => false,
        }
    }

// A test PASSES unless running it ERRORS; its return value is ignored.
// That is the real compiler's rule, and it is why these are typically
// `Bool`-returning functions nothing inspects: the assertion mechanism
// is `require`/`panic`, not the result.
//
// Each test runs in its OWN PROCESS. `panic_raw` aborts rather than
// returning a catchable error, so a harness that ran every test in one
// process would stop at the first failure and could not report the
// rest -- which is precisely why the real compiler's NATIVE test path
// is structured the same way (see `testing.rs`: "there is no way to
// run more than one test per compiled PROCESS and still observe every
// test's own outcome"). The child is this same binary re-invoked
// through `/proc/self/exe`, since `args()` does not include the
// program's own path.
struct TestRun { failed: Int, detail: String }

let run_tests (dir: String) (names: Array[String]) (i: Int) (acc: TestRun): TestRun =
    if i >= names.len() { acc }
    else {
        let r = run_process("/proc/self/exe", ["test-one", dir, names[i]]);
        let outcome = match r {
            Err(e) => TestRun { failed: 1, detail: e },
            Ok(pr) => if pr.exit_code == 0 { TestRun { failed: 0, detail: "" } }
                      else { TestRun { failed: 1, detail: if pr.stderr == "" { pr.stdout } else { pr.stderr } } },
        };
        if outcome.failed == 0 {
            println("test ".concat(names[i]).concat(" ... ok"));
            run_tests(dir, names, i + 1, acc)
        } else {
            println("test ".concat(names[i]).concat(" ... FAILED"));
            // The child's own output IS the failure report -- the panic
            // message it died with. Captured rather than let through so
            // it lands under the test's name instead of interleaved
            // with the progress lines.
            run_tests(dir, names, i + 1, TestRun {
                failed: acc.failed + 1,
                detail: acc.detail.concat("---- ").concat(names[i]).concat(" ----\n").concat(outcome.detail).concat("\n"),
            })
        }
    }

let cmd_test (dir: String): Unit = {
    let program = parser.ProgramNode { items: collect_project(dir) };
    // Checked ONCE here, in the parent. The children skip it: the
    // program they load is the same one, and re-checking it per test
    // would dominate the run.
    typecheck.check_program(program);
    let names = discover_tests(program.items, 0, []);
    println("running ".concat(names.len().to_string()).concat(" tests"));
    let run = run_tests(dir, names, 0, TestRun { failed: 0, detail: "" });
    println("");
    if run.failed == 0 {
        println("test result: ok. ".concat(names.len().to_string()).concat(" passed; 0 failed"));
    } else {
        println("failures:");
        println("");
        println(run.detail);
        println("test result: FAILED. ".concat((names.len() - run.failed).to_string()).concat(" passed; ").concat(run.failed.to_string()).concat(" failed"));
        // Non-zero exit. `panic_raw` is the only mechanism this
        // language exposes for that, so its message is deliberately
        // terse -- the real report is above.
        panic_raw("");
    }
}

// One test, in its own process -- see `run_tests`. Exits non-zero by
// ABORTING if the test panics, which is the signal the parent reads.
let cmd_test_one (dir: String) (name: String): Unit = {
    let program = parser.ProgramNode { items: collect_project(dir) };
    let state = interp.build_program_state(program);
    let ignored = interp.run_named(state, name);
    ()
}

// The C shims every self-hosted binary links against: `process_run`
// and friends are declared by the runtime preamble but IMPLEMENTED in
// `native_stdlib/*.c`, so a produced binary does not link without
// them. Discovered rather than hard-coded as a list, since the set has
// grown before and the directory is the authority.
let native_c_files (dir: String): Array[String] =
    match list_dir(dir) {
        Err(_) => [],
        Ok(entries) => Array.fold(entries, [], |acc, e|
            if e.ends_with(".c") { acc.push(dir.concat("/").concat(e)) } else { acc }),
    }

// `-o` if given, else the project directory's own basename -- the same
// convention `plum build` uses.
let output_path (argv: Array[String]): String =
    if argv.len() >= 4 && argv[2] == "-o" { argv[3] } else { basename_of(argv[1]) }

let basename_of (path: String): String = {
    let parts = path.split("/");
    if Array.is_empty(parts) { "a.out" } else {
        let last = parts[parts.len() - 1];
        if last == "" { "a.out" } else { last }
    }
}

// `build` = `emit-llvm` + `clang`. The IR was already being produced
// correctly; what was missing was only the link step, which is why the
// self-hosted compiler could compile itself to IR but not to a BINARY
// -- and so could not replace the compiler that builds it.
let build_project (argv: Array[String]): Unit = {
    let out = output_path(argv);
    let ll = out.concat(".ll");
    let ir = codegen.cg_emit_program(parser.ProgramNode { items: collect_project(argv[1]) });
    match write_file(ll, ir) {
        Err(e) => println("build failed: ".concat(e)),
        Ok(_) => {
            let cfiles = native_c_files("native_stdlib");
            let base = ["-O2", "-Wno-override-module", ll];
            let argv2 = Array.concat(Array.concat(base, cfiles), ["-lm", "-o", out]);
            match run_process("clang", argv2) {
                Err(e) => println("build failed: ".concat(e)),
                Ok(r) => if r.exit_code == 0 {
                    println("wrote ".concat(out));
                } else {
                    println("clang failed (exit ".concat(r.exit_code.to_string()).concat("):"));
                    println(r.stderr);
                },
            }
        },
    }
}

// --- Project loading (`check` only) ---
//
// `check` accepts a DIRECTORY as well as a single file, because a
// module can't be type-checked alone: `parser/parser.plum` references
// `lexer.Token`, `interp/interp.plum` references `parser.PExpr`, and so
// on, so checking one file in isolation fails with "unknown type"
// through no fault of the program. Given a directory, every `.plum`
// file under it is parsed and their items CONCATENATED into one
// program, which is then checked as a unit.
//
// Items are still concatenated into one program, but each one now
// carries the MODULE it came from — the name of the directory holding
// its file, or "" for a file at the project root. `collect_project`
// assigns those; the parser writes "" and knows nothing about it.
//
// FUNCTIONS and GLOBALS are scoped by module: an unqualified name
// resolves in its own module, then in the root module (where the
// prelude lives), and never in a sibling. Crossing a module boundary
// means naming it — `lexer.tokenize` resolves IN `lexer`. Two modules
// can therefore declare the same function name with different types,
// which is exactly what `interp.plum` and `typecheck/infer.plum` both
// wanting a `bind_params` needed, and what forced a rename before.
//
// TYPES and VARIANT TAGS remain flat, deliberately: `parser.PExpr` and
// a bare `PExpr` resolve identically because `resolve_named` keys off a
// path's last segment, and `parser.plum` matches on `TokLet` — a tag
// declared in `lexer` — without qualifying it. Scoping those would be a
// language change, not a checker change, and the sources depend on the
// current rule. DESIGN.md's module-system section documents the flat
// tag namespace as a deliberate boundary.
let parse_file_items (path: String) (module_name: String): Array[parser.ItemNode] =
    match read_file(path) {
        // The source context is set per FILE, immediately before that
        // file is parsed, so a parse error can report `path:line:col`
        // with a caret instead of a bare message. See
        // `parser.set_source_context`.
        Ok(src) => {
            let lexed = lexer.tokenize_spanned(src);
            parser.set_source_context(path, src, lexed.starts);
            parser.with_module(parser.parse_program(lexed.tokens).items, module_name)
        },
        Err(e) => { panic_raw("failed to read ".concat(path).concat(": ").concat(e)); [] },
    }

// A project's MODULES are its immediate subdirectories, Go-style: every
// `.plum` file under `lexer/` belongs to module `lexer`, and a file at
// the project root belongs to the root module `""`. Nesting deeper does
// not create a deeper module — a file in `a/b/` is still in module `a`,
// which matches how the sources are actually laid out and avoids
// inventing a path syntax nothing writes.
let collect_path_items (path: String) (module_name: String): Array[parser.ItemNode] =
    if Result.unwrap_or(is_directory(path), false) {
        collect_entries(path, module_name, Result.unwrap_or(list_dir(path), []), 0, [])
    } else if path.ends_with(".plum") {
        parse_file_items(path, module_name)
    } else {
        []
    }

// The project ROOT: each subdirectory names a module, each root-level
// file belongs to `""`.
let collect_project (root: String): Array[parser.ItemNode] =
    if Result.unwrap_or(is_directory(root), false) {
        collect_root_entries(root, Result.unwrap_or(list_dir(root), []), 0, [])
    } else {
        collect_path_items(root, "")
    }

let collect_root_entries (root: String) (entries: Array[String]) (i: Int) (acc: Array[parser.ItemNode]): Array[parser.ItemNode] =
    if i >= entries.len() { acc }
    else if entries[i] == "." || entries[i] == ".." { collect_root_entries(root, entries, i + 1, acc) }
    else {
        let full = root.concat("/").concat(entries[i]);
        let m = if Result.unwrap_or(is_directory(full), false) { entries[i] } else { "" };
        collect_root_entries(root, entries, i + 1, Array.concat(acc, collect_path_items(full, m)))
    }

// `.`/`..` are skipped explicitly — `list_dir` surfaces raw `readdir`
// entries, so descending into them would recurse forever.
let collect_entries (dir: String) (module_name: String) (entries: Array[String]) (i: Int) (acc: Array[parser.ItemNode]): Array[parser.ItemNode] =
    if i >= entries.len() { acc }
    else if entries[i] == "." || entries[i] == ".." { collect_entries(dir, module_name, entries, i + 1, acc) }
    else {
        let full = dir.concat("/").concat(entries[i]);
        collect_entries(dir, module_name, entries, i + 1, Array.concat(acc, collect_path_items(full, module_name)))
    }

// `new <name>` — scaffold a project, mirroring the real compiler's own
// `run_new`/`new_project`, including refusing to overwrite.
//
// The directory is created by shelling out to `mkdir`, not by a runtime
// primitive. A `mkdir_raw` primitive was written first and then removed:
// this file is compiled by BOTH compilers, and the real one has no such
// builtin, so it would have had to gain a whole IR node -- ir.rs,
// lowering, the interpreter, codegen, the prelude -- to scaffold a
// directory. `build` already shells out to `clang`, so this uses the
// mechanism that exists in both rather than adding one that exists in
// neither. A primitive that only one compiler could exercise would rot
// unnoticed until the Rust backend goes away.
let cmd_new (name: String): Unit =
    if Result.unwrap_or(is_directory(name), false) {
        new_failed(name.concat(" already exists — refusing to overwrite it"))
    } else if !mkdir_ok(name) {
        new_failed("failed to create ".concat(name))
    } else {
        match write_file(name.concat("/main.plum"), "let main (): Unit = println(\"hello, plum\")\n") {
            Err(e) => new_failed("failed to write main.plum: ".concat(e)),
            Ok(_) => println("created ".concat(name)),
        }
    }

// The real `plum new` exits 1 on every one of these, so this does too.
// `panic_raw` is the only non-zero exit this language exposes (see
// `run_tests`), so the message is printed first and the panic carries
// nothing -- otherwise the abort message would double-report it.
let new_failed (msg: String): Unit = { println(msg); panic_raw("") }

let mkdir_ok (name: String): Bool =
    match run_process("mkdir", [name]) {
        Ok(r) => r.exit_code == 0,
        Err(_) => false,
    }

let main (): Unit = {
    let argv = args();
    if argv.len() >= 1 && argv[0] == "lsp" {
        // No file argument: the server talks over stdin/stdout.
        lsp_serve(())
    } else if argv.len() < 2 {
        usage(());
    } else if argv[0] == "defs" {
        cmd_defs(argv[1]);
    } else if argv[0] == "new" {
        cmd_new(argv[1]);
    } else if argv[0] == "check" {
        // Handled before `read_file` below: the argument may be a
        // DIRECTORY, which `read_file` can't open at all.
        typecheck.check_program(parser.ProgramNode { items: collect_project(argv[1]) });
        println("ok");
    } else if argv[0] == "test-one" && argv.len() >= 3 {
        cmd_test_one(argv[1], argv[2]);
    } else if argv[0] == "test" && Result.unwrap_or(is_directory(argv[1]), false) {
        cmd_test(argv[1]);
    } else if argv[0] == "build" && Result.unwrap_or(is_directory(argv[1]), false) {
        build_project(argv);
    } else if argv[0] == "emit-llvm" && Result.unwrap_or(is_directory(argv[1]), false) {
        // Same directory loading `check` and `run` use. A real Plum
        // project is several modules, so a backend that only accepted
        // one file could never compile one.
        println(codegen.cg_emit_program(parser.ProgramNode { items: collect_project(argv[1]) }));
    } else if argv[0] == "run" && Result.unwrap_or(is_directory(argv[1]), false) {
        // Same directory-loading path `check` uses, for the same
        // reason: a module can't be RUN alone either — `main.plum`'s
        // `main` calls into `lexer`/`parser`/`interp`/`typecheck`, so
        // every module's items have to be present in the one program
        // this interpreter walks. Concatenation is again the whole
        // mechanism (`find_fn` scans a flat list, exactly as
        // `find_sig` does), with the same flat-namespace consequence.
        let program = parser.ProgramNode { items: collect_project(argv[1]) };
        typecheck.check_program(program);
        // Everything after the project directory becomes the
        // INTERPRETED program's own `args()` — so `./sh run bootstrap/
        // self_host ast foo.plum` runs the self-hosted compiler under
        // the self-hosted interpreter and asks IT for `foo.plum`'s AST.
        let state = interp.build_program_state_argv(program, Array.slice(argv, 2, argv.len()));
        interp.run_main(state);
    } else {
        match read_file(argv[1]) {
            Err(e) => println("failed to read file: ".concat(e)),
            Ok(src) => {
                // `dump-tokens`/`dump-ast` are the REAL compiler's names for
                // these, and `bootstrap/corpus`'s goldens were generated with
                // them. Accepting both means a corpus regeneration command
                // can be pointed at either compiler unchanged.
                // Same context, for the single-file commands.
                let lexed0 = lexer.tokenize_spanned(src);
                parser.set_source_context(argv[1], src, lexed0.starts);
                if argv[0] == "tokens" || argv[0] == "dump-tokens" {
                    println(lexer.render_tokens(lexer.tokenize(src)));
                } else if argv[0] == "ast" || argv[0] == "dump-ast" {
                    println(parser.render_program(parser.parse_program(lexer.tokenize(src))));
                } else if argv[0] == "emit-llvm" {
                    // Stage 5. NO separate `check_program` call: the
                    // backend prepends the prelude and then type-checks
                    // the combined program itself (`typed_program` IS
                    // `check_program` with the results kept). Checking
                    // here as well would check the WRONG program — the
                    // user's items without the prelude — and reject any
                    // call to a prelude function that has no
                    // `builtin_sig` entry.
                    println(codegen.cg_emit_program(parser.parse_program(lexer.tokenize(src))));
                } else if argv[0] == "run" {
                    let program = parser.parse_program(lexer.tokenize(src));
                    typecheck.check_program(program);
                    let state = interp.build_program_state(program);
                    interp.run_main(state);
                } else {
                    usage(());
                }
            }
        }
    }
}
