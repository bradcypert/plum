// Self-hosting bootstrap — project root. See DESIGN.md's "Self-hosting
// bootstrap corpus" and "Stage 1/2/3/4: self-hosted lexer/parser/
// interpreter/type checker" sections, and the project roadmap, for the
// full story.
//
// `lexer/`, `parser/`, `interp/`, and `typecheck/` are library MODULES
// (Go-style directory modules — see DESIGN.md's "Module system"
// section), not their own runnable projects; this file is the one real
// entry point tying them together.
//
// Modes (dispatched on the first process arg):
//   plum build bootstrap/self_host -o sh && ./sh tokens <file>
//     — tokenize <file>, print `lexer.render_tokens`'s output.
//     Validate against bootstrap/corpus/*/*.tokens.
//   ./sh ast <file>
//     — tokenize + parse <file>, print `parser.render_program`'s
//     output. Validate against bootstrap/corpus/*/*.expected.
//   ./sh run <file-or-project-dir> [args...]
//     — tokenize + parse + TYPE-CHECK + INTERPRET <file>'s `main()`,
//     printing whatever the program itself prints (nothing extra — no
//     return-value echo). Matches the real `plum run`'s own order
//     (type-check first, only interpret a program that passes) — an
//     ill-typed program never reaches the interpreter at all, the same
//     `fail_tc`/`panic_raw` `./sh check` alone already produces.
//     A project DIRECTORY works too, loaded exactly the way `check`
//     loads one, with everything after it passed to the interpreted
//     program as its own `args()` — which is how the self-hosted
//     compiler gets run under the self-hosted interpreter:
//       ./sh run bootstrap/self_host check bootstrap/self_host  -> ok
//     Validate against bootstrap/exec_corpus/*/expected.txt (14 of 15
//     — `tuples/` fails type-checking specifically, see `typecheck_
//     corpus/README.md`, so it no longer reaches "run" successfully
//     either; that one fixture is now `check`/`run`-exempt, tracked as
//     a real, documented exception, not a regression). Includes
//     closures-as-values (`closures/`, `closures_in_structs/`) and
//     arrays (`arrays/`) — both the interpreter and type checker
//     support them now.
//   ./sh check <file>
//     — tokenize + parse + TYPE-CHECK every top-level function's body
//     against its own declared signature, printing "ok" on success (a
//     real `panic_raw` on any type error — see `typecheck/infer.plum`'s
//     own top comment for why). Validate against bootstrap/exec_corpus
//     (every fixture is well-typed, "ok" expected) and bootstrap/
//     typecheck_corpus (a mix of well-typed and deliberately-ill-typed
//     snippets). Kept as its OWN mode, not folded away now that `run`
//     also type-checks — useful on its own for a program whose `main`
//     you don't actually want to execute yet.
//
// **Validate via the NATIVE build, not `plum run`** — see `lexer/
// lexer.plum`'s own top comment for why (a real, documented
// interpreter scaling limit hit while validating Stage 1, not a
// correctness bug).

use Os;
use lexer;
use parser;
use lsp;
use typecheck;
use codegen;
use shims;

// `query <project> <path> <line> <col>` -- what is the type of the
// identifier at that position?
//
// This is what `defs` cannot do. A name-based lookup finds top-level
// definitions and nothing else: a local resolves to whatever top-level
// name it happens to share, or to nothing. Here the CHECKER answers,
// with the type it actually inferred, so hovering a local shows its
// real type and a shadowed name shows the shadow.
//
// A subcommand, like `check` and `defs`, because the checker reports by
// aborting -- and a query runs against a file someone is editing, which
// is the state most likely to be broken.
let cmd_query (dir: String) (path: String) (line: Int) (col: Int): Unit = {
    typecheck.record_types(true);
    let items = codegen.cg_with_prelude(parser.ProgramNode { items: collect_project(dir) }).items;
    typecheck.check_program(parser.ProgramNode { items: items });
    match Os.read_file(path) {
        Err(_) => println("{}"),
        Ok(src) => {
            let off = lexer.offset_of(src, line, col);
            // A FIELD or METHOD -- the `x` in `p.x` -- is answered from
            // what owns it, because the checker records identifiers and
            // a field is not one. Hovering `.x` used to answer for `p`,
            // which is the sort of almost-right that reads as a bug in
            // the type rather than in the hover.
            match member_answer(items, chars_of(src), path, off) {
                Some(js) => println(js),
                None => println(query_answer(typecheck.recorded_types(()), path, off, 0)),
            }
        },
    }
}

// `Some(json)` when the cursor is on an identifier that is immediately
// preceded by a dot AND the thing before that dot has a known type.
// `None` for everything else, which falls through to the ordinary
// identifier lookup -- including for the BASE of an access, so
// hovering `p` in `p.x` still answers about `p`.
let member_answer (items: Array[parser.ItemNode]) (cs: Array[String]) (path: String) (off: Int): Option[String] =
    if off < 0 || off >= cs.len() || !is_ident_char(cs[off]) { None }
    else {
        let start = ident_start(cs, off);
        let dot = start - 1;
        if dot < 0 || cs[dot] != "." { None }
        else {
            let base_start = ident_start(cs, dot - 1);
            if base_start >= dot { None }
            else {
                match recorded_type_at(typecheck.recorded_types(()), path, base_start, 0) {
                    None => None,
                    Some(base_ty) => {
                        let name = ident_text(cs, start, "");
                        match member_detail(items, type_namespace(base_ty), name, 0) {
                            None => None,
                            Some(detail) => Some(json_stringify(JsonObject([
                                JsonEntry { key: "name", value: JsonString(name) },
                                JsonEntry { key: "type", value: JsonString(detail) },
                            ]))),
                        }
                    },
                }
            }
        }
    }

let ident_text (cs: Array[String]) (i: Int) (acc: String): String =
    if i >= cs.len() || !is_ident_char(cs[i]) { acc }
    else { ident_text(cs, i + 1, acc.concat(cs[i])) }

// A struct field's DECLARED TYPE, or a namespaced function's signature.
let member_detail (items: Array[parser.ItemNode]) (ns: String) (name: String) (i: Int): Option[String] =
    if i >= items.len() { None }
    else {
        let here = match items[i].kind {
            IKStruct(decl) => if decl.name == ns { field_type_named(decl, name, 0) } else { None },
            IKLet(def) => if def.name == ns.concat(".").concat(name) { Some(def_signature(def)) } else { None },
            _ => None,
        };
        match here { Some(d) => Some(d), None => member_detail(items, ns, name, i + 1) }
    }

let field_type_named (decl: parser.StructDeclNode) (name: String) (i: Int): Option[String] =
    if i >= decl.fields.len() { None }
    else if decl.fields[i].name == name { Some(parser.render_type_source(decl.fields[i].ty)) }
    else { field_type_named(decl, name, i + 1) }

// The recorded entry whose identifier CONTAINS the offset. Recorded
// entries store the identifier's start; its length is its own name.
let query_answer (nodes: Array[typecheck.NodeType]) (path: String) (off: Int) (i: Int): String =
    if i >= nodes.len() { "{}" }
    else if nodes[i].path == path && off >= nodes[i].offset && off < nodes[i].offset + nodes[i].name.len() {
        json_stringify(JsonObject(Array.concat(
            [
                JsonEntry { key: "name", value: JsonString(nodes[i].name) },
                JsonEntry { key: "type", value: JsonString(nodes[i].ty) },
            ],
            // The BINDING's position, when the checker knows one. A
            // top-level name has none here -- the name index answers
            // for those, and it knows which file they live in.
            if nodes[i].def_offset >= 0 { def_position_fields(path, nodes[i].def_offset) } else { [] })))
    }
    else { query_answer(nodes, path, off, i + 1) }

let def_position_fields (path: String) (off: Int): Array[JsonEntry] =
    match Os.read_file(path) {
        Err(_) => [],
        Ok(src) => {
            let lc = lexer.line_col(src, off);
            [
                JsonEntry { key: "defLine", value: JsonNumber(lc.line.to_float()) },
                JsonEntry { key: "defCol", value: JsonNumber(lc.col.to_float()) },
            ]
        },
    }

// `defs <project>` -- every top-level definition, as JSON, for the
// language server to answer hover and go-to-definition with.
//
// A SUBCOMMAND rather than something the server does in-process, for
// the same reason `check` is: the parser reports by aborting, so a file
// with a syntax error -- which is most files, most of the time, while
// someone is typing -- would take the server down. A child that dies
// simply yields no index.
let cmd_defs (dir: String): Unit = {
    let items = collect_project(dir);
    println(json_stringify(JsonArray(defs_of(items, 0, []))));
}

// Members of whatever is immediately before a `.` -- the struct's own
// fields, and every function namespaced under its type.
//
// The type comes from the CHECKER, the same recorded-type table hover
// reads, so `p.` after `let p = make_point()` knows what `p` is without
// the user having written it down. Deliberately narrow: the base must
// be a plain identifier. `foo().bar.` needs the type of an arbitrary
// expression, which is a different problem, and returning nothing there
// is better than returning something wrong -- the caller falls back to
// the whole-project name list.
//
// Prints `[]` for anything it cannot answer, including "the cursor is
// not after a dot at all", which is how the language server decides
// which kind of completion this is without duplicating the lexing.
let cmd_members (dir: String) (path: String) (line: Int) (col: Int): Unit = {
    typecheck.record_types(true);
    let items = codegen.cg_with_prelude(parser.ProgramNode { items: collect_project(dir) }).items;
    typecheck.check_program(parser.ProgramNode { items: items });
    match Os.read_file(path) {
        Err(_) => println("[]"),
        Ok(src) => {
            let cs = chars_of(src);
            let off = lexer.offset_of(src, line, col);
            // `off` sits just after the `.`; step back over it, then
            // over the identifier that owns it.
            let dot = off - 1;
            if dot < 0 || dot >= cs.len() || cs[dot] != "." { println("[]") }
            else {
                let end = dot;
                let start = ident_start(cs, end - 1);
                if start >= end { println("[]") }
                else {
                    match recorded_type_at(typecheck.recorded_types(()), path, start, 0) {
                        None => println("[]"),
                        Some(ty) => println(json_stringify(JsonArray(
                            members_of(items, type_namespace(ty), 0,
                                builtin_members(typecheck.builtin_methods(), type_namespace(ty), 0, []))))),
                    }
                }
            }
        },
    }
}

// Walks back over identifier characters, returning the offset one past
// the last non-identifier character -- i.e. where the name starts.
let ident_start (cs: Array[String]) (i: Int): Int =
    if i < 0 { 0 }
    else if is_ident_char(cs[i]) { ident_start(cs, i - 1) }
    else { i + 1 }

let is_ident_char (c: String): Bool =
    (c >= "a" && c <= "z") || (c >= "A" && c <= "Z") || (c >= "0" && c <= "9") || c == "_"

// The recorded entry that BEGINS at this offset. `query_answer` looks
// for one that contains an offset; here the start is known exactly.
let recorded_type_at (nodes: Array[typecheck.NodeType]) (path: String) (off: Int) (i: Int): Option[String] =
    if i >= nodes.len() { None }
    else if nodes[i].path == path && nodes[i].offset == off { Some(nodes[i].ty) }
    else { recorded_type_at(nodes, path, off, i + 1) }

// `Array[Int]` -> `Array`, `Point` -> `Point`. A namespace is the type
// CONSTRUCTOR, not the instantiation: `Array.map` serves every
// `Array[T]`.
let type_namespace (ty: String): String =
    match String.index_of(ty, "[") {
        Some(i) => String.slice(ty, 0, i),
        None => ty,
    }

let members_of (items: Array[parser.ItemNode]) (ns: String) (i: Int) (acc: Array[JsonValue]): Array[JsonValue] =
    if i >= items.len() { acc }
    else {
        let next = match items[i].kind {
            // A field is offered as a field, with its declared type as
            // the detail -- `x: Int`, not a signature.
            IKStruct(decl) => if decl.name == ns { fields_of(decl, 0, acc) } else { acc },
            IKLet(def) => if def.name.starts_with(ns.concat(".")) {
                acc.push(completion_json(method_name_of(def.name), "function", def_signature(def)))
            } else { acc },
            _ => acc,
        };
        members_of(items, ns, i + 1, next)
    }

// The compiler's own methods for this receiver, which no source item
// declares. Without these, typing `xs.` offered twenty-three prelude
// functions and not `map`.
let builtin_members (ms: Array[typecheck.BuiltinMethod]) (ns: String) (i: Int) (acc: Array[JsonValue]): Array[JsonValue] =
    if i >= ms.len() { acc }
    else if ms[i].recv == ns || ms[i].recv == "" {
        builtin_members(ms, ns, i + 1, acc.push(completion_json(ms[i].name, "function", ms[i].detail)))
    } else { builtin_members(ms, ns, i + 1, acc) }

let fields_of (decl: parser.StructDeclNode) (i: Int) (acc: Array[JsonValue]): Array[JsonValue] =
    if i >= decl.fields.len() { acc }
    else {
        fields_of(decl, i + 1, acc.push(completion_json(decl.fields[i].name, "field",
            decl.fields[i].name.concat(": ").concat(parser.render_type_source(decl.fields[i].ty)))))
    }

// `String.trim_end` is offered as `trim_end`: the receiver is already
// typed, so inserting the namespace again would produce
// `s.String.trim_end()`.
let method_name_of (full: String): String = {
    let parts = full.split(".");
    parts[parts.len() - 1]
}

// Completion candidates: every name a user can write, which is their
// own project's items plus the prelude's public surface plus the
// VARIANTS of every enum in either.
//
// Deliberately a separate command rather than more rows from `defs`.
// `defs` answers "go to definition", and a prelude item has no file to
// go to -- the prelude is embedded source, not something on disk. Rows
// for it there would make jump-to-definition land nowhere.
//
// The whole list is returned unfiltered. LSP clients fuzzy-match
// against what has been typed themselves, so the server never has to
// work out where a partial identifier starts -- which is the thing
// that would make this need cursor-position analysis.
// Plum's keywords. A static list, and the only place in this file that
// is: they are a property of the LANGUAGE, not of the project being
// edited, so there is nothing to derive them from. Kept in the lexer's
// own order so the two can be diffed by eye.
let keyword_completions (ignored: Unit): Array[JsonValue] =
    keyword_items(["true", "false", "let", "mut", "fn", "struct", "enum",
                   "match", "if", "else", "for", "in", "pub", "use", "mod",
                   "extern", "unsafe", "spawn", "select"], 0, [])

let keyword_items (ks: Array[String]) (i: Int) (acc: Array[JsonValue]): Array[JsonValue] =
    if i >= ks.len() { acc }
    else { keyword_items(ks, i + 1, acc.push(completion_json(ks[i], "keyword", ks[i]))) }

// The locals and parameters visible at `off`: every identifier the
// checker recorded a BINDING SITE for, inside the same top-level item
// as the cursor, bound at or before it.
//
// Approximate on purpose, in one direction. Block scoping is ignored,
// so a name bound in a branch the cursor is not inside is still
// offered. Over-offering a name that exists a few lines away is a much
// smaller problem than omitting one that is genuinely in scope, and
// tracking real scope extents would mean the checker recording them --
// which is a change to the checker for the benefit of completion.
//
// `def_offset < 0` means "no binding site", which is how the checker
// marks a TOP-LEVEL name. Those come from the project index instead, so
// they are skipped here rather than offered twice.
struct Span { start: Int, end: Int }

let locals_in_scope (items: Array[parser.ItemNode]) (nodes: Array[typecheck.NodeType]) (path: String) (off: Int): Array[JsonValue] = {
    let span = enclosing_span(items, path, off, Span { start: 0, end: 0 });
    locals_acc(nodes, path, off, span, 0, [], [])
}

// The top-level item containing `off`: the one with the greatest start
// at or before it, ending where the next item in the same file begins.
let enclosing_span (items: Array[parser.ItemNode]) (path: String) (off: Int) (best: Span): Span =
    enclosing_acc(items, path, off, 0, Span { start: 0 - 1, end: 2147483647 })

let enclosing_acc (items: Array[parser.ItemNode]) (path: String) (off: Int) (i: Int) (best: Span): Span =
    if i >= items.len() { best }
    else if items[i].path != path { enclosing_acc(items, path, off, i + 1, best) }
    else if items[i].start <= off && items[i].start > best.start {
        enclosing_acc(items, path, off, i + 1, Span { start: items[i].start, end: best.end })
    }
    else if items[i].start > off && items[i].start < best.end {
        enclosing_acc(items, path, off, i + 1, Span { start: best.start, end: items[i].start })
    }
    else { enclosing_acc(items, path, off, i + 1, best) }

let locals_acc (nodes: Array[typecheck.NodeType]) (path: String) (off: Int) (span: Span) (i: Int) (seen: Array[String]) (acc: Array[JsonValue]): Array[JsonValue] =
    if i >= nodes.len() { acc }
    else if nodes[i].path == path && nodes[i].def_offset >= 0
         && nodes[i].def_offset >= span.start && nodes[i].def_offset < span.end
         && nodes[i].def_offset <= off && !seen.contains(nodes[i].name) {
        locals_acc(nodes, path, off, span, i + 1, seen.push(nodes[i].name),
            acc.push(completion_json(nodes[i].name, "variable", nodes[i].name.concat(": ").concat(nodes[i].ty))))
    }
    else { locals_acc(nodes, path, off, span, i + 1, seen, acc) }

// --- `plum stdlib-reference` ---
//
// The standard library, listed by the compiler that implements it.
//
// The README documents the library as hand-written prose, which means
// it can be incomplete without looking incomplete: 32 of 142 functions
// were never mentioned, including `Ref.get`, `Ref.set`, `Sender.send`
// and `Receiver.recv` -- both halves of two headline features.
// `check-doc-names` proves every name the docs MENTION is real; nothing
// could prove the reverse, because "everything that exists" was not
// written down anywhere a check could read.
//
// It is now, and it is generated rather than maintained. Every entry
// comes from the same place completion reads, so a function that exists
// is in this document by construction, with the signature it actually
// has.
pub let cmd_stdlib_reference (unit: Unit): Unit = {
    let prelude = codegen.cg_with_prelude(parser.ProgramNode { items: [] }).items;
    let std = codegen.cg_std_items(all_std_uses(()));
    println("# Plum standard library");
    println("");
    println("Generated by `plum stdlib-reference`; do not edit by hand.");
    println("`bootstrap/check-stdlib-reference` fails when it is out of date.");
    println("");
    println("Everything here is available with no `use` unless its section says");
    println("otherwise -- `Os`, `Time`, `Net`, `Http` and `Process` are modules and need one.");
    println("");
    println("A declared function is shown as it is written, receiver first:");
    println("`let Array.reverse (xs: Array[T]): Array[T]`. A function the compiler");
    println("implements itself is marked `(built in)` and shown in method form:");
    println("`Array.map(f: (T) -> U): Array[U]`. Both are callable either way --");
    println("`Array.reverse(xs)` and `xs.reverse()` are the same call.");
    println("");
    println("See README.md for the prose introduction.");
    reference_sections(Array.concat(prelude, std))
}

// A program that `use`s every stdlib module, so `cg_std_items` yields
// all of them rather than the none an empty program asks for.
let all_std_uses (unit: Unit): Array[parser.ItemNode] = {
    let src = "use Os;\nuse Time;\nuse Net;\nuse Http;\nuse Process;\nlet main (): Unit = ()";
    let lexed = lexer.tokenize_spanned(src);
    parser.set_source_context("<stdlib-reference>", src, lexed.starts, lexed.ends);
    let items = parser.parse_program(lexed.tokens).items;
    parser.set_source_context("", "", [], []);
    items
}

let reference_sections (items: Array[parser.ItemNode]): Unit = {
    let ms = typecheck.builtin_methods();
    reference_ns_acc(items, ms, sorted_namespaces(with_builtin_ns(ms, 0, namespaces_of(items, 0, [])), 0), 0);
    // `to_string` is the one method with no receiver TYPE -- it works on
    // every value, so it belongs to no namespace and would otherwise be
    // the one entry this document silently dropped.
    println("");
    println("## Any type");
    println("");
    reference_builtins(ms, "", 0)
}

let with_builtin_ns (ms: Array[typecheck.BuiltinMethod]) (i: Int) (acc: Array[String]): Array[String] =
    if i >= ms.len() { acc }
    else if ms[i].recv != "" && !Array.contains(acc, ms[i].recv) { with_builtin_ns(ms, i + 1, acc.push(ms[i].recv)) }
    else { with_builtin_ns(ms, i + 1, acc) }

let reference_ns_acc (items: Array[parser.ItemNode]) (ms: Array[typecheck.BuiltinMethod]) (nss: Array[String]) (i: Int): Unit =
    if i >= nss.len() { () }
    else {
        println("");
        println("## ".concat(nss[i]));
        println("");
        reference_entries(items, nss[i], 0);
        reference_builtins(ms, nss[i], 0);
        reference_ns_acc(items, ms, nss, i + 1)
    }

// The methods the compiler implements itself. They are not source
// items, so nothing that reads declarations can find them -- which is
// how `Array.map` came to be missing from the editor's completion list
// as well.
let reference_builtins (ms: Array[typecheck.BuiltinMethod]) (ns: String) (i: Int): Unit =
    if i >= ms.len() { () }
    else {
        if ms[i].recv == ns {
            let call = if ns == "" { ms[i].detail } else { ns.concat(".").concat(ms[i].detail) };
            println("- `".concat(call).concat("`  (built in)"))
        } else { () };
        reference_builtins(ms, ns, i + 1)
    }

let reference_entries (items: Array[parser.ItemNode]) (ns: String) (i: Int): Unit =
    if i >= items.len() { () }
    else {
        match items[i].kind {
            IKLet(def) =>
                if reference_ns_of(items[i], def.name) == ns && reference_visible(items[i], def.name) {
                    println("- `".concat(def_signature(def)).concat("`"))
                } else { () },
            _ => (),
        };
        reference_entries(items, ns, i + 1)
    }

// A prelude item is public API only when it says `pub`; a stdlib
// module's items are reached through their module, so they carry one.
// `pub`, and not a name the compiler generates for itself. Contract
// desugaring declares `__contract_require`/`__contract_ensure`, which
// are `pub` because the generated code calls them across modules and
// are not API anybody may write.
let reference_visible (item: parser.ItemNode) (name: String): Bool =
    item.is_pub && !name.starts_with("__")

// `Array.reverse` is grouped under `Array`; `Os.read_file` -- declared
// as a bare `read_file` inside module `Os` -- under `Os`.
let reference_ns_of (item: parser.ItemNode) (name: String): String =
    if item.module != "" && item.module != parser.PRELUDE_MODULE(()) { item.module }
    else { match String.index_of(name, ".") { Some(i) => String.slice(name, 0, i), None => "(prelude)" } }

let namespaces_of (items: Array[parser.ItemNode]) (i: Int) (acc: Array[String]): Array[String] =
    if i >= items.len() { acc }
    else {
        let next = match items[i].kind {
            IKLet(def) => {
                let ns = reference_ns_of(items[i], def.name);
                if reference_visible(items[i], def.name) && !Array.contains(acc, ns) { acc.push(ns) } else { acc }
            },
            _ => acc,
        };
        namespaces_of(items, i + 1, next)
    }

let sorted_namespaces (nss: Array[String]) (i: Int): Array[String] =
    if i >= nss.len() { nss } else { sorted_namespaces(bubble_ns(nss, 0), i + 1) }

let bubble_ns (nss: Array[String]) (i: Int): Array[String] =
    if i + 1 >= nss.len() { nss }
    // Written in the DOT form on purpose. `Array.set(xs, i, v)` became
    // legal in 0.0.18, and `bootstrap/seed/plum.ll` is an older
    // compiler that has to be able to build this source -- so the
    // compiler cannot use a spelling it only just started accepting.
    // `bootstrap/check-seed` catches it; it caught this line.
    else if nss[i] > nss[i + 1] { bubble_ns(nss.set(i, nss[i + 1]).set(i + 1, nss[i]), i + 1) }
    else { bubble_ns(nss, i + 1) }

let cmd_complete (dir: String): Unit = {
    let project = collect_project(dir);
    // `cg_with_prelude` over an EMPTY program yields the prelude on its
    // own. Reusing it means this does not need a second copy of the
    // knowledge of where the prelude lives or how it is parsed.
    let prelude = codegen.cg_with_prelude(parser.ProgramNode { items: [] }).items;
    // The stdlib modules this project actually asked for by `use`.
    //
    // The line above passes an EMPTY program on purpose -- it wants the
    // prelude alone -- and that quietly discarded the other half of
    // what `cg_with_prelude` does. `use Os;` put nothing in the
    // completion list, so `Os.read_file` was not offered in any project,
    // ever. `cmd_members` passed the real project all along and was
    // fine, which is why this showed up only on the namespace path.
    let std = codegen.cg_std_items(project);
    let mine = completions_of(project, 0, [], false);
    let with_std = completions_of(std, 0, mine, true);
    let with_prelude = completions_of(prelude, 0, with_std, true);
    let with_builtins = Array.concat(with_prelude, builtin_completions(()));
    println(json_stringify(JsonArray(Array.concat(with_builtins, keyword_completions(())))))
}

// Locals in scope, as their OWN command, and deliberately not part of
// `complete`.
//
// Finding them needs the project type-checked, and `fail_tc` ABORTS.
// Completion is wanted most while the buffer is broken -- that is when
// you are typing -- so folding this into `complete` would mean a
// program with one type error offers NO completions at all, which is
// worse than the behaviour it replaced. Kept separate, a failure here
// costs the locals and nothing else; the language server merges what
// it gets.
let cmd_locals (dir: String) (path: String) (line: Int) (col: Int): Unit =
    match Os.read_file(path) {
        Err(_) => println("[]"),
        Ok(src) => {
            typecheck.record_types(true);
            let all = codegen.cg_with_prelude(parser.ProgramNode { items: collect_project(dir) }).items;
            typecheck.check_program(parser.ProgramNode { items: all });
            println(json_stringify(JsonArray(
                locals_in_scope(all, typecheck.recorded_types(()), path, lexer.offset_of(src, line, col)))))
        },
    }

// The handful of names the CHECKER knows and no source file declares.
// `println` is the most-typed word in the language and would otherwise
// be the one thing completion could not offer.
//
// **This is a second copy of knowledge, and the only one here.** These
// signatures live in `typecheck/infer.plum` -- `builtin_sig`, plus the
// names special-cased in `infer_call` -- as code rather than as data,
// so there is nothing to read them out of. If one changes there and
// not here, completion shows a stale signature; it cannot cause a
// miscompile, which is why this is an acceptable trade rather than a
// good one. Sorted to match the order they appear in the checker.
let builtin_completions (ignored: Unit): Array[JsonValue] =
    Array.concat([
        completion_json("println", "function", "println(value: T): Unit"),
        completion_json("args", "function", "args(): Array[String]"),
        completion_json("panic_raw", "function", "panic_raw(message: String): Unit"),
        completion_json("chars_of", "function", "chars_of(s: String): Array[String]"),
        completion_json("ref", "function", "ref(value: T): Ref[T]"),
        completion_json("channel", "function", "channel(): (Sender[T], Receiver[T])"),
    ], builtin_method_items(typecheck.builtin_methods(), 0, []))

// The compiler's own methods, offered under the type they belong to:
// `Array.map`, `String.split`. A method with no receiver type -- only
// `to_string` -- belongs to every type and to no namespace, so it is
// offered bare.
let builtin_method_items (ms: Array[typecheck.BuiltinMethod]) (i: Int) (acc: Array[JsonValue]): Array[JsonValue] =
    if i >= ms.len() { acc }
    else {
        let label = if ms[i].recv == "" { ms[i].name } else { ms[i].recv.concat(".").concat(ms[i].name) };
        let detail = if ms[i].recv == "" { ms[i].detail } else { ms[i].recv.concat(".").concat(ms[i].detail) };
        builtin_method_items(ms, i + 1, acc.push(completion_json(label, "function", detail)))
    }

// `pub_only` is true for the prelude: a non-`pub` prelude item is an
// implementation detail no user program may name. Everything in the
// user's OWN project is offered, `pub` or not.
let completions_of (items: Array[parser.ItemNode]) (i: Int) (acc: Array[JsonValue]) (pub_only: Bool): Array[JsonValue] =
    if i >= items.len() { acc }
    else if pub_only && !items[i].is_pub { completions_of(items, i + 1, acc, pub_only) }
    else { completions_of(items, i + 1, push_completion(items[i], acc), pub_only) }

// A name is offered the way it has to be WRITTEN. A module's members
// are qualified -- `use Os;` then `Os.read_file`, never a bare
// `read_file` -- so a completion labelled with the bare name is one the
// user cannot type. The prelude is the exception, and the reason it
// went unnoticed: prelude names ARE written bare, and until stdlib
// modules reached this list at all there was nothing else here with a
// module to speak of.
let completion_label (item: parser.ItemNode) (name: String): String =
    if item.module == "" || item.module == parser.PRELUDE_MODULE(()) { name }
    else { item.module.concat(".").concat(name) }

let push_completion (item: parser.ItemNode) (acc: Array[JsonValue]): Array[JsonValue] =
    match item.kind {
        IKLet(def) => acc.push(completion_json(completion_label(item, def.name), "function", def_signature(def))),
        IKStruct(decl) => acc.push(completion_json(completion_label(item, decl.name), "struct", "struct ".concat(decl.name))),
        // An enum offers its own name AND each variant. Without the
        // variants you can complete `Shape` and then have to remember
        // `Circle` yourself, which is the half you actually write.
        IKEnum(decl) => variants_of(decl, 0, acc.push(completion_json(completion_label(item, decl.name), "enum", "enum ".concat(decl.name)))),
        _ => acc,
    }

let variants_of (decl: parser.EnumDeclNode) (i: Int) (acc: Array[JsonValue]): Array[JsonValue] =
    if i >= decl.variants.len() { acc }
    else {
        variants_of(decl, i + 1,
            acc.push(completion_json(decl.variants[i].name, "variant",
                variant_detail(decl.name, decl.variants[i]))))
    }

let variant_detail (ename: String) (v: parser.EnumVariantNode): String = {
    let ps = payload_list(v, 0, "");
    ename.concat(".").concat(v.name)
        .concat(if String.is_empty(ps) { "" } else { "(".concat(ps).concat(")") })
}

// Indexed over the VARIANT rather than over its payload array, so this
// never has to name the parser's `Ty` from here.
let payload_list (v: parser.EnumVariantNode) (i: Int) (acc: String): String =
    if i >= v.payload.len() { acc }
    else if i == 0 { payload_list(v, i + 1, parser.render_type_source(v.payload[i])) }
    else { payload_list(v, i + 1, acc.concat(", ").concat(parser.render_type_source(v.payload[i]))) }

let completion_json (name: String) (kind: String) (detail: String): JsonValue =
    JsonObject([
        JsonEntry { key: "name", value: JsonString(name) },
        JsonEntry { key: "kind", value: JsonString(kind) },
        JsonEntry { key: "detail", value: JsonString(detail) },
    ])

let defs_of (items: Array[parser.ItemNode]) (i: Int) (acc: Array[JsonValue]): Array[JsonValue] =
    if i >= items.len() { acc }
    else {
        match def_entry(items[i]) {
            Some(e) => defs_of(items, i + 1, acc.push(e)),
            None => defs_of(items, i + 1, acc),
        }
    }

let def_entry (item: parser.ItemNode): Option[JsonValue] =
    match item.kind {
        IKLet(def) => Some(def_json(item, def.name, "function", def_signature(def))),
        IKStruct(decl) => Some(def_json(item, decl.name, "struct", "struct ".concat(decl.name))),
        IKEnum(decl) => Some(def_json(item, decl.name, "enum", "enum ".concat(decl.name))),
        _ => None,
    }

// The position is stored as a character OFFSET; the server wants a
// line and column, and resolving one needs the file the item came
// from. Read per item: an index is built once per request, and a
// project is a handful of files.
let def_json (item: parser.ItemNode) (name: String) (kind: String) (detail: String): JsonValue = {
    let lc = match Os.read_file(item.path) {
        Ok(src) => lexer.line_col(src, name_offset(src, item.start, item.end, name)),
        Err(_) => lexer.LineCol { line: 1, col: 1 },
    };
    JsonObject([
        JsonEntry { key: "name", value: JsonString(name) },
        JsonEntry { key: "path", value: JsonString(item.path) },
        JsonEntry { key: "line", value: JsonNumber(lc.line.to_float()) },
        JsonEntry { key: "col", value: JsonNumber(lc.col.to_float()) },
        JsonEntry { key: "kind", value: JsonString(kind) },
        JsonEntry { key: "detail", value: JsonString(detail) },
    ])
}

// Where the item's NAME is written. `item.start` is the `let`, the
// `struct`, or -- since `pub` joined the item's span -- the `pub`, so
// jumping there put the caret before a keyword and the range this now
// returns would have highlighted the keyword's first letter.
//
// Scanned forward from the item's start rather than recorded, because
// the name follows its keyword immediately and the scan is over a dozen
// characters. Bounded by the item's own end so a name that somehow is
// not there stops at the item rather than running into the next one.
let name_offset (src: String) (from: Int) (to: Int) (name: String): Int =
    if from >= to { from }
    else if lexer.ident_at(src, from) == name { from }
    else { name_offset(src, from + 1, to, name) }

// What hover shows: the declaration as written, near enough to be
// recognisable without re-rendering the whole AST.
let def_signature (def: parser.LetDefNode): String =
    "let ".concat(def.name).concat(" ").concat(param_list(def.params, 0, ""))
        .concat(match def.ret_ty { Some(t) => ": ".concat(parser.render_type_source(t)), None => "" })

// `parser.render_pattern` produces S-EXPRESSIONS. That is correct for
// what it was written for -- `dump-ast` -- and wrong for a signature
// shown to a person. A zero-argument function's parameter is the unit
// pattern, so every hover over one read `let main ((tuple)): Unit`
// until 2026-08-25. Completion made it obvious by putting it in a popup
// next to a hundred correct signatures.
let render_sig_pattern (p: parser.PPattern): String =
    match p {
        PTuple(elems) => "(".concat(sig_pattern_list(elems, 0, "")).concat(")"),
        _ => parser.render_pattern(p),
    }

let sig_pattern_list (elems: Array[parser.PPattern]) (i: Int) (acc: String): String =
    if i >= elems.len() { acc }
    else if i == 0 { sig_pattern_list(elems, i + 1, render_sig_pattern(elems[i])) }
    else { sig_pattern_list(elems, i + 1, acc.concat(", ").concat(render_sig_pattern(elems[i]))) }

let param_list (ps: Array[parser.ParamNode]) (i: Int) (acc: String): String =
    if i >= ps.len() { acc }
    else {
        let one = match ps[i] {
            ParamIdent(n) => "(".concat(n).concat(")"),
            ParamPatternTy(pat, t) => match t {
                Some(ty) => "(".concat(render_sig_pattern(pat)).concat(": ").concat(parser.render_type_source(ty)).concat(")"),
                // A zero-argument function's parameter IS the unit
                // pattern, written `()` in source. Wrapping an
                // already-parenthesised pattern in parentheses gives
                // `(())`, which is not something anyone writes.
                None => {
                    let inner = render_sig_pattern(pat);
                    if inner == "()" { inner } else { "(".concat(inner).concat(")") }
                },
            },
        };
        param_list(ps, i + 1, if acc == "" { one } else { acc.concat(" ").concat(one) })
    }

// --- The language server's I/O ---
//
// The extern block lives HERE, in the root module, not in `lsp/`: the
// real compiler prefixes a module's item names, so an extern declared
// in `lsp.plum` is looked up as `lsp.stdout_write` and never found.
// `lsp.plum` is the pure protocol logic; this is the part that talks.
extern "C" {
    // Runs a command with stdio inherited and waits. Reached through
    // the extern boundary rather than the prelude because this file is
    // compiled by BOTH compilers, and only the self-hosted prelude has
    // a wrapper for it.
    fn process_run_inherit(program: CStr, joined: CStr, argc: Int) -> Int;
    fn stdin_read_line() -> CStr;
    fn stdin_read_n(n: Int) -> CStr;
    fn stdout_write(s: CStr);
    fn stdout_flush();
}

// The shim owns and reuses its buffers, so `.as_string()` must copy
// before the next read overwrites them -- which it does. Nothing frees:
// see `native_stdlib/io_shim.c` for why caller-owned buffers are not
// portable across the two compilers.
let lsp_read_line (): String = unsafe { stdin_read_line().as_string() }
let lsp_read_bytes (n: Int): String = unsafe { stdin_read_n(n).as_string() }
let lsp_write (s: String): Unit = unsafe { stdout_write(s.as_cstr()) }
// stdout is block-buffered when it is a pipe; a server that never
// flushes deadlocks against a client waiting for a reply it has
// already written.
let lsp_flush (): Unit = unsafe { stdout_flush() }

let lsp_send (body: String): Unit = { lsp_write(lsp.frame(body)); lsp_flush(()) }

// Headers until the blank line; the body is length-prefixed.
let lsp_read_message (): String = {
    let len = lsp_read_headers(0 - 1);
    if len <= 0 { "" } else { lsp_read_bytes(len) }
}

let lsp_read_headers (len: Int): Int = {
    let line = lsp_read_line(());
    if line == "" { len }
    else {
        let n = lsp.content_length(line);
        lsp_read_headers(if n >= 0 { n } else { len })
    }
}

// Where this executable lives, so it can re-invoke itself.
//
// This was the literal string `/proc/self/exe` until 2026-08-23, which
// is Linux-only -- so the language server, whose every check is a
// self-invocation, did not work on macOS at all. `Os.self_exe` asks the
// same question through `native_stdlib/os_shim.c`, which knows the
// three different calls the three platforms need.
//
// The fallback is the old path rather than an error: on Linux it is
// exactly what this used to do, and on a platform where the shim cannot
// answer there was nothing working to lose.
let self_exe (): String =
    match Os.self_exe() {
        Ok(path) => path,
        Err(_) => "/proc/self/exe",
    }

// Diagnostics come from a SUBPROCESS: `fail_tc` reports by aborting, so
// checking in-process would take the server down on the first type
// error a user typed. Re-invoking THIS executable is the same trick
// `cmd_test` uses -- no path to look up, and no chance of running a
// different build than this one.
let lsp_check (dir: String): Option[lsp.Diagnostic] =
    match Os.run_process(self_exe(), ["check", dir]) {
        Err(_) => None,
        Ok(r) => if r.exit_code == 0 { None } else { lsp.parse_diagnostic(r.stdout.concat(r.stderr)) },
    }

// Check a project whose edited file has UNSAVED content.
//
// The checker reads from disk, so it is given a disk that matches the
// buffer: the project is copied into a temp directory and the edited
// file is overwritten there with the text the editor sent. Nothing in
// the user's tree is touched -- writing the buffer into the real file
// would be a language server silently saving on your behalf, which is
// never acceptable.
//
// The copy is per keystroke. A Plum project is a handful of small
// files, and the alternative -- threading an in-memory overlay through
// `collect_project` and every path it resolves -- is a much larger
// change for a cost that has not been shown to matter. Measurable
// later if it does.
//
// Paths in the resulting diagnostic point INTO the temp directory, so
// the caller maps them back; see `lsp_real_path`.
struct BufferCheck { diagnostic: Option[lsp.Diagnostic], scratch: String }

let lsp_check_buffer (path: String) (text: String): BufferCheck =
    match Os.temp_dir() {
        Err(_) => BufferCheck { diagnostic: None, scratch: "" },
        Ok(scratch) => {
            let dir = lsp.dir_of(path);
            // `Os.copy_tree` copies the CONTENTS of `dir`, so the
            // project lands directly in the scratch dir rather than
            // nested inside a directory named after it -- module paths
            // depend on that. It replaced `cp -r <dir>/. <scratch>`,
            // which meant the same thing and needed a `cp` binary.
            let copied = Os.copy_tree(dir, scratch);
            let target = scratch.concat("/").concat(lsp.base_of(path));
            match Os.write_file(target, text) {
                Err(_) => { let c = Os.remove_tree(scratch); BufferCheck { diagnostic: None, scratch: "" } },
                Ok(_) => BufferCheck { diagnostic: lsp_check(scratch), scratch: scratch },
            }
        },
    }

// A diagnostic underlines the construct it is about, rather than
// marking a point.
//
// The checker reports ONE position. Which construct starts there is a
// span question, so this asks the span table for the narrowest one
// containing it -- and CLAMPS the answer to the end of that construct's
// first line. Most type errors are reported at the item's own position,
// and squiggling forty lines of a function body says less than
// underlining its signature does.
//
// Everything here degrades to the old zero-width point: a file that
// does not parse has no spans, and an error with no construct around it
// keeps the position it came with.
let widen (d: lsp.Diagnostic) (scratch: String) (dir: String): lsp.Diagnostic = {
    let real = lsp_real_path(d, scratch, dir);
    if real == "" { d }
    else {
        match Os.read_file(if scratch == "" { real } else { d.path }) {
            Err(_) => d,
            Ok(src) => {
                let off = lexer.offset_of(src, d.line, d.col);
                let chain = span_chain(lsp_spans(real, src), off, 0 - 1, []);
                if Array.is_empty(chain) { d }
                else {
                    let e = lexer.line_col(src, chain[0].end);
                    if e.line == d.line { lsp.with_end(d, e.line, e.col) }
                    else { lsp.with_end(d, d.line, line_width(src, d.line) + 1) }
                }
            },
        }
    }
}

// How many characters line `line` has, so a multi-line construct can be
// underlined to the end of the line it starts on and no further.
let line_width (src: String) (line: Int): Int = {
    let ls = String.lines(src);
    if line - 1 >= ls.len() || line < 1 { 1 } else { ls[line - 1].len() }
}

// A diagnostic reported inside the scratch copy, mapped back to the
// file the user is actually editing. Without this every error would
// point at a temp directory that will not exist a moment later.
let lsp_real_path (d: lsp.Diagnostic) (scratch: String) (dir: String): String =
    if scratch != "" && d.path.starts_with(scratch) {
        dir.concat(String.slice(d.path, scratch.len(), d.path.len()))
    } else { d.path }

// Publish for the edited document AND, when the error lives in another
// file of the same project, for that one too.
//
// The empty publish for `uri` is what CLEARS a stale error: an editor
// keeps showing the last diagnostics it was given until it is told
// otherwise, so a fixed mistake stays on screen unless the fix
// publishes an empty list.
let lsp_publish (uri: String) (d0: Option[lsp.Diagnostic]) (scratch: String): Unit = {
    let dir = lsp.dir_of(lsp.uri_to_path(uri));
    let d = match d0 { Some(x) => Some(widen(x, scratch, dir)), None => None };
    match d {
        None => lsp_send(lsp.publish_message(uri, [])),
        Some(diag) => {
            let real = lsp_real_path(diag, scratch, dir);
            let target = if real == "" { uri } else { lsp.path_to_uri(real) };
            if target == uri { lsp_send(lsp.publish_message(uri, [lsp.diagnostic_json(diag)])) }
            else {
                lsp_send(lsp.publish_message(uri, []));
                lsp_send(lsp.publish_message(target, [lsp.diagnostic_json(diag)]))
            }
        },
    }
}

let lsp_serve (): Unit = lsp_loop(true)

let lsp_loop (running: Bool): Unit =
    if !running { () }
    else {
        let body = lsp_read_message(());
        if body == "" { () } else { lsp_loop(lsp_handle(body)) }
    }

// Returns whether to keep serving.
let lsp_handle (body: String): Bool =
    match lsp.parse_request(body) {
        None => true,
        Some(req) =>
            if req.method == "initialize" {
                lsp_reply(req.id, lsp.capabilities(()));
                true
            } else if req.method == "shutdown" {
                lsp_reply(req.id, JsonNull);
                true
            } else if req.method == "exit" {
                false
            } else if req.method == "textDocument/completion" {
                let path = lsp.uri_to_path(lsp.document_uri(req.params));
                // MEMBERS first. `plum members` answers with an empty
                // list for anything that is not a position just after a
                // dot, so this one call decides which kind of
                // completion the request is -- the lexing lives in the
                // compiler, where the lexer is, rather than being
                // reimplemented over here.
                let members = lsp_members(path, lsp.params_line(req.params), lsp.params_col(req.params));
                // Names, keywords and LOCALS, merged. Locals come from
                // their own process because finding them type-checks
                // the project and a type error aborts -- see
                // `cmd_locals`. If that half fails you still get the
                // other one.
                let general = Array.concat(
                    lsp_completions(path),
                    lsp_locals(path, lsp.params_line(req.params), lsp.params_col(req.params)));
                lsp_reply(req.id, lsp.completion_result(
                    if Array.is_empty(members) { general } else { members }));
                true
            } else if req.method == "textDocument/formatting" {
                let uri = lsp.document_uri(req.params);
                let path = lsp.uri_to_path(uri);
                match buffer_text(uri, path) {
                    // No text and no file: answer with no edits rather
                    // than an error. A client that asked about a
                    // document nobody can see gets "nothing to change",
                    // which is true.
                    None => lsp_reply(req.id, JsonArray([])),
                    Some(text) => {
                        // Formatted by a CHILD process, not here. `fmt`
                        // parses, and a parse error is a `panic_raw`
                        // that would take the server down -- which it
                        // did: a format request on a buffer with a
                        // syntax error exited the process mid-session,
                        // after printing a compiler error onto the
                        // JSON-RPC stream. Format-on-save runs while you
                        // are still typing, so that is not a rare state.
                        //
                        // An unformattable buffer now answers "no
                        // edits", which is what a formatter should say
                        // about a file it cannot read.
                        let out = lsp_fmt(path, text);
                        // The same guarantee `plum fmt --write` gives,
                        // for the same reason: this hands the editor a
                        // replacement for the WHOLE file, so a rule
                        // that changed the tokens would silently
                        // rewrite the user's program. Refuse instead.
                        if lexer.token_texts(out) != lexer.token_texts(text) { lsp_reply(req.id, JsonArray([])) }
                        else if out == text { lsp_reply(req.id, JsonArray([])) }
                        else { lsp_reply(req.id, lsp.format_result(out, count_lines(text, 0, 0))) }
                    },
                };
                true
            } else if req.method == "textDocument/selectionRange" {
                lsp_reply(req.id, lsp_selection_ranges(req.params));
                true
            } else if req.method == "textDocument/hover" || req.method == "textDocument/definition" {
                lsp_reply(req.id, lsp_answer_query(req.method, req.params));
                true
            } else if req.method == "textDocument/didOpen" || req.method == "textDocument/didSave" {
                let uri = lsp.document_uri(req.params);
                if uri == "" { () }
                else {
                    match lsp.open_text(req.params) { Some(t) => remember_buffer(uri, t), None => () };
                    lsp_publish(uri, lsp_check(lsp.dir_of(lsp.uri_to_path(uri))), "")
                };
                true
            } else if req.method == "textDocument/didChange" {
                // Errors AS YOU TYPE. The buffer is unsaved, so the
                // check runs against a snapshot of the project with
                // this file's text substituted -- see
                // `lsp_check_buffer`.
                let uri = lsp.document_uri(req.params);
                if uri == "" { () }
                else {
                    match lsp.change_text(req.params) {
                        // No full text means the client negotiated
                        // incremental sync despite this server asking
                        // for full. Checking the stale file on disk
                        // would report the wrong lines, which is worse
                        // than reporting nothing.
                        None => (),
                        Some(text) => {
                            remember_buffer(uri, text);
                            let bc = lsp_check_buffer(lsp.uri_to_path(uri), text);
                            lsp_publish(uri, bc.diagnostic, bc.scratch);
                            if bc.scratch == "" { () } else { let c = Os.remove_tree(bc.scratch); () }
                        },
                    }
                };
                true
            } else {
                // An unknown NOTIFICATION is ignored; an unknown REQUEST
                // would hang a client waiting for a reply, so it gets an
                // empty result instead of silence.
                lsp_reply(req.id, JsonNull);
                true
            },
    }

// The text of every open document, by URI.
//
// This server deliberately keeps no buffer for DIAGNOSTICS -- full sync
// means every `didChange` carries the whole file, so a check can run
// against what arrived and nothing needs remembering.
//
// Formatting is different, and the difference is not academic. An
// editor asks to format the buffer it is showing, which for
// format-on-save is DIRTY: the file on disk is one edit behind, or
// several. Formatting that stale text and handing back a whole-file
// replacement would revert whatever the user had just typed. So the
// last text seen for a document is kept, and formatting uses it.
// ONE document, not a map of them. An editor formats the document it is
// showing, so the one that matters is the one last touched.
//
// A `Ref[Map[String, String]]` would work now -- the compiler bug that
// first forced this shape is fixed (see DESIGN.md, "A global's type
// does not reach its uses"). It stays one document because that is the
// right amount: an editor formats what it is showing.
let BUFFER_URI: Ref[String] = ref("")
let BUFFER_TEXT: Ref[String] = ref("")

let remember_buffer (uri: String) (text: String): Unit = { BUFFER_URI.set(uri); BUFFER_TEXT.set(text) }

// Falls back to disk for a document this server has never been told
// about -- a client that formats without opening first. Being one edit
// behind is only a hazard when there IS an edit it never sent.
let buffer_text (uri: String) (path: String): Option[String] =
    if uri != "" && BUFFER_URI.get() == uri { Some(BUFFER_TEXT.get()) }
    else { match Os.read_file(path) { Ok(t) => Some(t), Err(_) => None } }

let count_lines (s: String) (i: Int) (n: Int): Int =
    if i >= s.len() { n } else if String.slice(s, i, i + 1) == "\n" { count_lines(s, i + 1, n + 1) } else { count_lines(s, i + 1, n) }

// Hover and go-to-definition share everything but the last step: find
// the identifier under the cursor, look it up in the project's
// definition index, and answer.
//
// The index comes from a subprocess (`defs`), rebuilt per request. That
// is not free, but a project here is a handful of files, and a cache
// would need invalidating on every edit -- which is exactly the kind of
// stale-state bug a language server is prone to. Correct and simple
// first; the cache is measurable later if it matters.
// The CHECKER's answer for the identifier at a position -- the real
// inferred type, including for a local, which the name index cannot
// give. Empty when the position is not on an identifier USE, or when
// the project does not currently type-check.
let lsp_query (path: String) (line: Int) (col: Int): String =
    match Os.run_process(self_exe(), ["query", lsp.dir_of(path), path, line.to_string(), col.to_string()]) {
        Err(_) => "",
        Ok(r) => if r.exit_code == 0 { String.trim_end(r.stdout) } else { "" },
    }

let lsp_answer_query (method: String) (params: JsonValue): JsonValue = {
    let uri = lsp.document_uri(params);
    let path = lsp.uri_to_path(uri);
    if uri == "" { JsonNull }
    else {
        match Os.read_file(path) {
            Err(_) => JsonNull,
            Ok(src) => {
                let off = lexer.offset_of(src, lsp.params_line(params), lsp.params_col(params));
                let name = lexer.ident_at(src, off);
                if name == "" { JsonNull }
                else {
                    // Hover prefers the checker: it knows a local's type,
                    // where the name index only knows top-level
                    // definitions and would answer for whatever
                    // top-level name a local happens to shadow.
                    // Go-to-definition still uses the index -- the
                    // checker records types, not binding SITES.
                    let answer = lsp_query(path, lsp.params_line(params), lsp.params_col(params));
                    let inferred = lsp.query_field(answer, "type");
                    let def_line = lsp.query_int(answer, "defLine");
                    // What the answer is ABOUT: the name under the
                    // cursor. `ident_at` already found it, so its extent
                    // is the cursor's line and the name's own length --
                    // no span table needed for this one, and no parse.
                    let here = ident_range(src, off, name);
                    if method == "textDocument/hover" && inferred != "" { lsp.hover_text(name.concat(": ").concat(inferred), here) }
                    // A LOCAL's binding site, which the name index does
                    // not have: it only knows top-level definitions, so
                    // without this a local jumps to whatever top-level
                    // name it happens to share.
                    else if method == "textDocument/definition" && def_line > 0 {
                        lsp.location_at(path, def_line, lsp.query_int(answer, "defCol"), name.len())
                    }
                    else {
                        match lsp.find_def(lsp_defs(path), name, 0) {
                            None => JsonNull,
                            Some(d) => if method == "textDocument/hover" { lsp.hover_result(d, here) } else { lsp.location_result(d) },
                        }
                    }
                }
            },
        }
    }
}

// The extent of the identifier that `lexer.ident_at` matched. It starts
// at or before `off` -- the cursor may be in the middle of the word --
// so this walks back to the name's first character rather than assuming
// the cursor is on it.
let ident_range (src: String) (off: Int) (name: String): lsp.Rng = {
    let start = name_start(src, off, name);
    let a = lexer.line_col(src, start);
    lsp.Rng { sl: a.line, sc: a.col, el: a.line, ec: a.col + name.len() }
}

let name_start (src: String) (off: Int) (name: String): Int = name_start_acc(src, off, name, 0)

let name_start_acc (src: String) (off: Int) (name: String) (back: Int): Int =
    if back >= name.len() || off - back < 0 { off }
    else if lexer.ident_at(src, off - back) == name && (off - back == 0 || lexer.ident_at(src, off - back - 1) != name) { off - back }
    else { name_start_acc(src, off, name, back + 1) }

let lsp_locals (path: String) (line: Int) (col: Int): Array[lsp.Completion] =
    match Os.run_process(self_exe(), ["locals", lsp.dir_of(path), path, line.to_string(), col.to_string()]) {
        Err(_) => [],
        Ok(r) => if r.exit_code == 0 { lsp.parse_completions(r.stdout) } else { [] },
    }

// The members of whatever sits before the cursor's `.`, or an empty
// list when the cursor is not after a dot at all.
let lsp_members (path: String) (line: Int) (col: Int): Array[lsp.Completion] =
    match Os.run_process(self_exe(), ["members", lsp.dir_of(path), path, line.to_string(), col.to_string()]) {
        Err(_) => [],
        Ok(r) => if r.exit_code == 0 { lsp.parse_completions(r.stdout) } else { [] },
    }

// Candidates for the project the edited file belongs to.
//
// Read from DISK, not from the unsaved buffer, unlike diagnostics. A
// name you are halfway through typing is not a name you want offered
// back to you, and a project whose buffer does not currently parse
// would otherwise offer nothing at all -- which is exactly when
// completion is most wanted. The cost is that a function added and not
// yet saved is missing from the list until you save.
let lsp_completions (path: String): Array[lsp.Completion] =
    match Os.run_process(self_exe(), ["complete", lsp.dir_of(path)]) {
        Err(_) => [],
        Ok(r) => if r.exit_code == 0 { lsp.parse_completions(r.stdout) } else { [] },
    }

// --- Construct spans, for the LSP ---
//
// Every span the parser recorded for one file, as `start,end` character
// offsets, innermost-finished first. `plum spans <file>` exists so the
// LANGUAGE SERVER can have them without parsing in its own process.
//
// That is not a style preference. `fail_at` reports by `panic_raw`, so
// a parse error takes the whole process down -- which is why
// diagnostics have always come from a subprocess, and it is why the
// formatting handler below now does too. A user pressing
// expand-selection is a user in the middle of an edit, which is exactly
// when the buffer does not parse.
pub let cmd_spans (path: String): Unit =
    match Os.read_file(path) {
        Err(_) => (),
        Ok(src) => {
            let lexed = lexer.tokenize_spanned(src);
            parser.set_source_context(path, src, lexed.starts, lexed.ends);
            parser.record_spans(true);
            let prog = parser.parse_program(lexed.tokens);
            let sp = parser.recorded_spans();
            parser.record_spans(false);
            // `prog` is not used for anything -- parsing is what fills
            // the table. Naming it keeps the call from looking dead.
            if Array.is_empty(prog.items) { () } else { () };
            print(spans_text(sp, 0, ""))
        },
    }

let spans_text (sp: Array[parser.ExprSpan]) (i: Int) (acc: String): String =
    if i >= sp.len() { acc }
    else { spans_text(sp, i + 1, acc.concat(sp[i].start.to_string()).concat(",").concat(sp[i].end.to_string()).concat("\n")) }

pub struct OffSpan { pub start: Int, pub end: Int }

// The spans of `text`, obtained by writing it to a scratch file and
// asking a CHILD process for them. An empty answer -- the child failed,
// the text does not parse -- means every caller here falls back to what
// it did before spans existed, which is a narrower answer and never a
// wrong one.
let lsp_spans (path: String) (text: String): Array[OffSpan] =
    match Os.temp_dir() {
        Err(_) => [],
        Ok(scratch) => {
            let target = scratch.concat("/").concat(lsp.base_of(path));
            let out = match Os.write_file(target, text) {
                Err(_) => [],
                Ok(_) => match Os.run_process(self_exe(), ["spans", target]) {
                    Err(_) => [],
                    Ok(r) => if r.exit_code == 0 { parse_off_spans(String.lines(r.stdout), 0, []) } else { [] },
                },
            };
            let c = Os.remove_tree(scratch);
            out
        },
    }

let parse_off_spans (lines: Array[String]) (i: Int) (acc: Array[OffSpan]): Array[OffSpan] =
    if i >= lines.len() { acc }
    else {
        let parts = lines[i].split(",");
        if parts.len() != 2 { parse_off_spans(lines, i + 1, acc) }
        else {
            let a = Result.unwrap_or(String.parse_int(parts[0]), 0 - 1);
            let b = Result.unwrap_or(String.parse_int(parts[1]), 0 - 1);
            if a < 0 || b <= a { parse_off_spans(lines, i + 1, acc) }
            else { parse_off_spans(lines, i + 1, acc.push(OffSpan { start: a, end: b })) }
        }
    }

// The constructs containing `off`, INNERMOST FIRST -- which is the
// order `textDocument/selectionRange` wants, and the order a chain of
// enclosing scopes reads in.
//
// Built by repeatedly taking the narrowest span wider than the last one
// taken, rather than by sorting: the list is short (one entry per level
// of nesting), and this drops the duplicates that the precedence chain
// records for free.
let span_chain (spans: Array[OffSpan]) (off: Int) (last_w: Int) (acc: Array[OffSpan]): Array[OffSpan] = {
    let best = narrowest_wider(spans, off, last_w, 0, 0 - 1);
    if best < 0 { acc }
    else { span_chain(spans, off, spans[best].end - spans[best].start, acc.push(spans[best])) }
}

let narrowest_wider (spans: Array[OffSpan]) (off: Int) (last_w: Int) (i: Int) (best: Int): Int =
    if i >= spans.len() { best }
    else {
        let w = spans[i].end - spans[i].start;
        let holds = spans[i].start <= off && spans[i].end > off && w > last_w;
        if holds && (best < 0 || w < spans[best].end - spans[best].start) { narrowest_wider(spans, off, last_w, i + 1, i) }
        else { narrowest_wider(spans, off, last_w, i + 1, best) }
    }

// `plum fmt` in a child process, so a buffer that does not parse
// answers with no edits instead of killing the server.
let lsp_fmt (path: String) (text: String): String =
    match Os.temp_dir() {
        Err(_) => text,
        Ok(scratch) => {
            let target = scratch.concat("/").concat(lsp.base_of(path));
            let out = match Os.write_file(target, text) {
                Err(_) => text,
                Ok(_) => match Os.run_process(self_exe(), ["fmt", target]) {
                    Err(_) => text,
                    // A non-zero exit is a file the formatter refused.
                    // Handing back the input unchanged makes the caller's
                    // `out == text` test answer "no edits".
                    Ok(r) => if r.exit_code == 0 { r.stdout } else { text },
                },
            };
            let c = Os.remove_tree(scratch);
            out
        },
    }

// One chain of enclosing constructs per requested position.
let lsp_selection_ranges (params: JsonValue): JsonValue = {
    let uri = lsp.document_uri(params);
    let path = lsp.uri_to_path(uri);
    match buffer_text(uri, path) {
        None => JsonArray([]),
        Some(text) => {
            let spans = lsp_spans(path, text);
            JsonArray(selection_acc(text, spans, lsp.params_positions(params), 0, []))
        },
    }
}

let selection_acc (text: String) (spans: Array[OffSpan]) (ps: Array[JsonValue]) (i: Int) (acc: Array[JsonValue]): Array[JsonValue] =
    if i >= ps.len() { acc }
    else {
        let off = lexer.offset_of(text, lsp.position_line(ps[i]), lsp.position_col(ps[i]));
        selection_acc(text, spans, ps, i + 1, acc.push(lsp.selection_range_json(chain_rngs(text, spans, off), 0)))
    }

// The word under the cursor is the innermost step, ahead of any
// expression: selecting `xs` before `xs.len()` is what makes the first
// keypress useful. It comes from the LEXER, so it is there even when
// the file does not parse and the span table came back empty.
let chain_rngs (text: String) (spans: Array[OffSpan]) (off: Int): Array[lsp.Rng] = {
    let name = lexer.ident_at(text, off);
    let seed = if name == "" { [] } else { [ident_range(text, off, name)] };
    // Seeded with the NAME's own width, so a recorded span that is
    // exactly the identifier -- the leaf the precedence chain also
    // records -- is not offered again as a second, identical step.
    rngs_of(text, span_chain(spans, off, if name == "" { 0 - 1 } else { name.len() }, []), 0, seed)
}

let rngs_of (text: String) (sp: Array[OffSpan]) (i: Int) (acc: Array[lsp.Rng]): Array[lsp.Rng] =
    if i >= sp.len() { acc }
    else {
        let a = lexer.line_col(text, sp[i].start);
        let b = lexer.line_col(text, sp[i].end);
        rngs_of(text, sp, i + 1, acc.push(lsp.Rng { sl: a.line, sc: a.col, el: b.line, ec: b.col }))
    }

let lsp_defs (path: String): Array[lsp.Def] =
    match Os.run_process(self_exe(), ["defs", lsp.dir_of(path)]) {
        Err(_) => [],
        Ok(r) => if r.exit_code == 0 { lsp.parse_defs(r.stdout) } else { [] },
    }

let lsp_reply (id: Option[JsonValue]) (result: JsonValue): Unit =
    match id { Some(i) => lsp_send(lsp.response(i, result)), None => () }

// THE version string, and the only one. `bootstrap/check-version`
// fails if a release tag disagrees with it, so a `v0.0.2` tag can
// never ship a binary that says 0.0.1 -- the same class of drift this
// project has been closing everywhere else.
pub let plum_version (): String = "0.0.19"

let usage (): Unit = {
    println("plum ".concat(plum_version()));
    println("usage: plum (tokens|dump-tokens|ast|dump-ast|run|emit-llvm) <file> | check <file-or-project-dir> | build <project-dir> [-o <out>] [--release] [--trace] [--target <triple>] | test <project-dir> [--release] | new <name> | version | help | lsp | complete <project-dir>");
    println("");
    println("  --trace             a stack trace on stderr when the program dies.");
    println("                      Tail recursion still runs in constant stack space.");
    println("  --release           optimise (-O2). The default is a DEBUG build:");
    println("                      -Og -g, which keeps frames and debug information.");
    println("  --target <triple>   build for another platform, e.g. aarch64-linux-musl.");
    println("                      Needs a C compiler that can link for it: set PLUM_CC,");
    println("                      e.g. PLUM_CC=\"zig cc\". Plum ships no sysroot.")
}

// Every top-level `let` whose name's LAST segment starts with `test_`.
// The last-segment rule is what makes a module-qualified
// `lexer.test_foo` discoverable — the same rule the real compiler's
// `discover_tests` uses.
let discover_tests (items: Array[parser.ItemNode]) (i: Int) (acc: Array[String]): Array[String] =
    if i >= items.len() { acc }
    else {
        let next = match items[i].kind {
            IKLet(def) => {
                let parts = def.name.split(".");
                let last = parts[parts.len() - 1];
                // The NAME is not enough: a helper that merely starts
                // with `test_` and takes real arguments is not a test,
                // and calling it with none reads out of bounds instead
                // of reporting a failure. Caught immediately -- this
                // compiler's own `cmd_test`/`cmd_test_one` were named
                // `test_*` at first and were "discovered".
                if last.starts_with("test_") && takes_no_args(def.params) { acc.push(def.name) } else { acc }
            },
            _ => acc,
        };
        discover_tests(items, i + 1, next)
    }

// `let f ()` parses as ONE parameter holding the empty-tuple pattern,
// not as zero parameters -- the unit-argument convention. So "callable
// with no arguments" is that shape, or genuinely no parameters at all.
let takes_no_args (params: Array[parser.ParamNode]): Bool =
    if Array.is_empty(params) { true }
    else if params.len() > 1 { false }
    else {
        match params[0] {
            ParamPatternTy(pat, _) => match pat { PTuple(elems) => Array.is_empty(elems), _ => false },
            _ => false,
        }
    }

// A test PASSES unless running it ERRORS; its return value is ignored.
// That is the real compiler's rule, and it is why these are typically
// `Bool`-returning functions nothing inspects: the assertion mechanism
// is `require`/`panic`, not the result.
//
// Each test runs in its OWN PROCESS. `panic_raw` aborts rather than
// returning a catchable error, so a harness that ran every test in one
// process would stop at the first failure and could not report the
// rest -- which is precisely why the real compiler's NATIVE test path
// is structured the same way (see `testing.rs`: "there is no way to
// run more than one test per compiled PROCESS and still observe every
// test's own outcome"). The child is the COMPILED TEST BINARY, named
// on the command line with the test to run -- not this compiler
// re-invoked, which is what this comment claimed until 2026-08-23. See
// `run_tests` immediately below: the program it runs is `bin`.
struct TestRun { failed: Int, detail: String }

let run_tests (bin: String) (names: Array[String]) (i: Int) (acc: TestRun): TestRun =
    if i >= names.len() { acc }
    else {
        let r = Os.run_process(bin, [names[i]]);
        let outcome = match r {
            Err(e) => TestRun { failed: 1, detail: e },
            Ok(pr) => if pr.exit_code == 0 { TestRun { failed: 0, detail: "" } }
                      else { TestRun { failed: 1, detail: if pr.stderr == "" { pr.stdout } else { pr.stderr } } },
        };
        if outcome.failed == 0 {
            println("test ".concat(names[i]).concat(" ... ok"));
            run_tests(bin, names, i + 1, acc)
        } else {
            println("test ".concat(names[i]).concat(" ... FAILED"));
            // The child's own output IS the failure report -- the panic
            // message it died with. Captured rather than let through so
            // it lands under the test's name instead of interleaved
            // with the progress lines.
            run_tests(bin, names, i + 1, TestRun {
                failed: acc.failed + 1,
                detail: acc.detail.concat("---- ").concat(names[i]).concat(" ----\n").concat(outcome.detail).concat("\n"),
            })
        }
    }

// `test` COMPILES the project once, against a synthesized dispatcher
// main, and runs each test as a child of the resulting binary.
//
// It used to interpret each test instead, which quietly meant `sh test`
// inherited every limitation of the tree-walking interpreter: no `Ref`,
// no stdlib, and -- because the interpreter path never loads the
// prelude -- not even `assert_eq`. Every realistic test failed with
// "unbound function: assert_eq" while the same code compiled and ran
// fine. Compiling means `test`, `run` and `build` are one path, so a
// test cannot fail for a reason the program would not.
//
// Each test still runs in its OWN process: `panic_raw` aborts rather
// than returning, so a single-process harness stops at the first
// failure and cannot report the rest. That was the original reason for
// the design and it is unchanged -- only the child is different, an
// argument to a compiled binary rather than an interpreter invocation.
let compile_and_run_tests (dir: String) (program: parser.ProgramNode) (names: Array[String]) (release: Bool) (trace: Bool): TestRun =
    match Os.temp_dir() {
        Err(e) => TestRun { failed: 1, detail: "could not create a scratch directory: ".concat(e) },
        Ok(scratch) => {
            let bin = scratch.concat("/tests");
            let ll = bin.concat(".ll");
            codegen.set_debug_frames(trace);
            let ir = codegen.cg_emit_program_entry(program, "__plum_test_main");
            let outcome = match Os.write_file(ll, ir) {
                Err(e) => TestRun { failed: 1, detail: "could not write test IR: ".concat(e) },
                Ok(_) => {
                    let cfiles = write_shims(scratch);
                    // Native, for the same reason `run` is: each test
                    // runs as a child of this binary.
                    let argv = Array.concat(Array.concat(Array.concat(cc_prefix_args(), Array.concat(cc_mode_args(release), ["-Wno-override-module", ll])), cfiles),
                        Array.concat(link_args([], dir), Array.concat(platform_libs(native_target()), ["-o", bin])));
                    match Os.run_process(cc_program(), argv) {
                        Err(e) => TestRun { failed: 1, detail: "could not link tests: ".concat(e) },
                        Ok(r) => if r.exit_code == 0 { run_tests(bin, names, 0, TestRun { failed: 0, detail: "" }) }
                            else { TestRun { failed: 1, detail: "could not link tests:\n".concat(r.stderr) } },
                    }
                },
            };
            let cleaned = Os.remove_tree(scratch);
            outcome
        },
    }

let cmd_test (dir: String) (release: Bool) (trace: Bool): Unit = {
    let items = collect_project(dir);
    let names = discover_tests(items, 0, []);
    let src = test_dispatcher_src(names);
    let dispatcher = parser.parse_program(lexer.tokenize(src)).items;
    let program = parser.ProgramNode { items: Array.concat(items, dispatcher) };
    // NO separate check here. The compile below type-checks the
    // combined program -- user items PLUS the prelude -- and checking
    // the user's items alone would check the WRONG program and reject
    // every call to a prelude function, `assert_eq` first among them.
    // The same note `emit-llvm` already carries, for the same reason.
    println("running ".concat(names.len().to_string()).concat(" tests"));
    let run = compile_and_run_tests(dir, program, names, release, trace);
    println("");
    if run.failed == 0 {
        println("test result: ok. ".concat(names.len().to_string()).concat(" passed; 0 failed"));
    } else {
        println("failures:");
        println("");
        // `print`, not `println`. Each failure block in `run.detail`
        // already ends with its own newline (see the `.concat("\n")`
        // where it is built), so `println` added a SECOND one and every
        // failure was followed by a doubled blank line -- a small
        // divergence from the real compiler's report, which
        // `bootstrap/test-smoke` compares.
        print(run.detail);
        println("test result: FAILED. ".concat((names.len() - run.failed).to_string()).concat(" passed; ").concat(run.failed.to_string()).concat(" failed"));
        // Non-zero exit, printing nothing: the report is already
        // written. This used to be `panic_raw("")`, the only mechanism
        // the language had -- and it printed its (empty) message,
        // leaving a stray blank line the real compiler's report does
        // not have. `exit_with` was added for this.
        Os.exit_with(1);
    }
}

// The dispatcher `test` compiles into the project: a `main` that reads
// the test name from `args()` and calls it.
//
// Synthesized as SOURCE and parsed, rather than built as an AST by
// hand. Two hundred characters of Plum is easier to read, and to be
// sure is correct, than the equivalent tree of `EIf`/`ECall` nodes.
let test_dispatcher_src (names: Array[String]): String =
    "let __plum_test_main (): Unit = {\n    let which = args()[0];\n"
        .concat(test_dispatch_arms(names, 0, ""))
        .concat("    ()\n}\n")

let test_dispatch_arms (names: Array[String]) (i: Int) (acc: String): String =
    if i >= names.len() { acc }
    else {
        test_dispatch_arms(names, i + 1,
            acc.concat("    if which == \"").concat(names[i]).concat("\" { ").concat(names[i]).concat("(()) } else { () };\n"))
    }

// The C shims every self-hosted binary links against: `process_run`
// and friends are declared by the runtime preamble but IMPLEMENTED in
// `native_stdlib/*.c`, so a produced binary does not link without
// them. Discovered rather than hard-coded as a list, since the set has
// grown before and the directory is the authority.
let native_c_files (dir: String): Array[String] =
    match Os.list_dir(dir) {
        Err(_) => [],
        Ok(entries) => Array.fold(entries, [], |acc, e|
            if e.ends_with(".c") { acc.push(dir.concat("/").concat(e)) } else { acc }),
    }

// `-o` if given, else the project directory's own basename -- the same
// convention `plum build` uses.
// `-o` is found wherever it appears, not just at position 2: link
// flags may precede it, and a positional check silently ignored the
// output name the moment they did.
// An explicit `-o` is taken literally. Without one the binary is named
// after the project directory -- plus `.exe` when the TARGET is
// Windows, because a PE that is not named `.exe` will not run there and
// nothing downstream would have told you why.
let output_path (argv: Array[String]) (target: String): String =
    match find_flag_value(argv, "-o", 0) {
        Some(v) => v,
        None => {
            let base = basename_of(argv[1]);
            if target_os(target) == "windows" && !base.ends_with(".exe") { base.concat(".exe") } else { base }
        },
    }

let find_flag_value (argv: Array[String]) (flag: String) (i: Int): Option[String] =
    if i + 1 >= argv.len() { None }
    else if argv[i] == flag { Some(argv[i + 1]) }
    else { find_flag_value(argv, flag, i + 1) }

let basename_of (path: String): String = {
    let parts = path.split("/");
    if Array.is_empty(parts) { "a.out" } else {
        let last = parts[parts.len() - 1];
        if last == "" { "a.out" } else { last }
    }
}

// `build` = `emit-llvm` + `clang`. The IR was already being produced
// correctly; what was missing was only the link step, which is why the
// self-hosted compiler could compile itself to IR but not to a BINARY
// -- and so could not replace the compiler that builds it.
// `--link-lib <name>` becomes `-l<name>`; `--link-c <file>` adds a C
// source to the link. A project's own `native/*.c` is picked up
// automatically, which is how `examples/asteroids` reaches its raylib
// shim without being told to -- the same convention `plum build` uses.
let collect_flag (argv: Array[String]) (flag: String) (i: Int) (acc: Array[String]): Array[String] =
    if i + 1 >= argv.len() { acc }
    else if argv[i] == flag { collect_flag(argv, flag, i + 2, acc.push(argv[i + 1])) }
    else { collect_flag(argv, flag, i + 1, acc) }

// --- Targets ---
//
// Plum does not IMPLEMENT cross-compilation; it stops preventing it.
// See DESIGN.md's "Cross-compilation: not bundled, and not blocked
// either" section for the measurements behind that split. The short
// version: the emitted IR carries no target triple and no datalayout,
// so `clang --target=X` retargets it with no help from us, and
// `Os.platform()` is compiled in by the C compiler's own `#ifdef` in
// `compat_shim.c` -- so it, too, is already right on a cross-build.
// The single thing that was host-specific was `platform_libs` below.
//
// The empty string means "this machine", and is what every native
// build passes. It is NOT a valid triple and never reaches clang.
let native_target (): String = ""

// The OS component of a target triple, as one of the strings
// `Os.platform()` itself returns.
//
// Matched by SUBSTRING rather than by position, because the number of
// components varies in the wild and all three spellings are real:
// `aarch64-macos`, `x86_64-unknown-linux-gnu`, `x86_64-pc-windows-msvc`.
// Anything unrecognized is treated as Linux-shaped, which is what a
// bare `aarch64-none-elf` or a BSD wants from this list anyway.
let target_os (triple: String): String =
    if triple == native_target() { Os.platform() }
    else if triple.contains("windows") { "windows" }
    else if triple.contains("macos") || triple.contains("darwin") || triple.contains("apple") { "macos" }
    else { "linux" }

// The libraries every produced binary links against, which are not the
// same on every platform.
//
// `-lm` alone was enough while this was Linux-only. Windows needs two
// more: `-lws2_32` because Winsock lives in its own import library
// rather than in libc, and `-lpthread` because MinGW keeps pthreads in
// a separate `libwinpthread` where modern glibc has folded them into
// libc. Adding either on Linux or macOS would be harmless but untrue,
// and this list is read as documentation of what a platform needs.
//
// A C `#ifdef` cannot reach here -- this is Plum source building a
// command line -- which is the whole reason `Os.platform` exists.
//
// Keyed off the TARGET, not the host. Reading `Os.platform()` here was
// the one line that made a cross-build impossible: a Windows binary
// built on Linux was handed the host's bare `-lm` and failed to link.
// Mach-O keeps DEBUG INFORMATION somewhere else than ELF does, and
// this is the one line that accounts for it.
//
// A Mach-O linker does not copy DWARF into the executable. It leaves it
// in the `.o` files and writes a debug map pointing at them, and
// `dsymutil` is what follows that map and produces the `.dSYM` bundle a
// debugger reads. `plum build` compiles and links in ONE clang
// invocation with the objects in a scratch directory it then removes,
// so without this the map points at files that no longer exist and the
// line information is gone the moment a build finishes.
//
// Measured rather than assumed, and the assumption would have been
// wrong in both directions: clang's driver does NOT do this for a
// one-step compile-and-link, and `bootstrap/debug-info-check` on the
// macOS runner is what said so -- "no Plum line information, in itself
// or a .dSYM", after passing every check on the IR.
//
// Failure is deliberately NOT fatal. The binary is already built,
// correct and runnable; a missing debugger convenience must not fail a
// build over it. What stops that from being the silent degradation
// this project keeps getting bitten by is that CI asserts the result on
// a real Mac, so a `dsymutil` that stops working is caught there rather
// than discovered by someone trying to debug.
// COMPILE, then LINK, then `dsymutil` -- the Mach-O debug path, and
// the only place this compiler does not hand clang everything at once.
//
// A Mach-O linker does not copy DWARF into the executable. It writes a
// DEBUG MAP naming the object files it came from, and `dsymutil`
// follows that map to build the `.dSYM` bundle a debugger reads. Doing
// the whole build in one clang invocation puts those objects in clang's
// own temporary directory, which clang deletes as it exits -- so
// `dsymutil` afterwards follows the map to files that are already gone.
//
// That is not a guess. Running `dsymutil` after a one-shot build on a
// real Mac produced a bundle and this, which is what sent this code
// here:
//
//     debug map (OSO) entries: 7
//     warning: (arm64) /var/.../compat_shim-e25a27.o
//              unable to open object file: No such file or directory
//
// Compiling to objects in the build's OWN scratch directory keeps them
// alive until `dsymutil` has copied their DWARF into the bundle. The
// scratch is removed afterwards, by which point the bundle no longer
// needs them.
//
// Only here: every other platform links debug information into the
// executable and wants the single faster invocation.
struct ObjBuild { err: String, objs: Array[String] }

let compile_objs (srcs: Array[String]) (i: Int) (scratch: String) (flags: Array[String]) (acc: Array[String]): ObjBuild =
    if i >= srcs.len() { ObjBuild { err: "", objs: acc } }
    else {
        let obj = scratch.concat("/obj").concat(i.to_string()).concat(".o");
        let argv = Array.concat(Array.concat(cc_prefix_args(), flags), ["-c", srcs[i], "-o", obj]);
        match Os.run_process(cc_program(), argv) {
            Err(e) => ObjBuild { err: "build failed: ".concat(e), objs: acc },
            Ok(r) => if r.exit_code == 0 { compile_objs(srcs, i + 1, scratch, flags, acc.push(obj)) }
                else { ObjBuild { err: Array.join(cc_words(), " ").concat(" failed on ").concat(srcs[i])
                    .concat(" (exit ").concat(r.exit_code.to_string()).concat("):\n").concat(r.stderr), objs: acc } },
        }
    }

let compile_two_phase (srcs: Array[String]) (out: String) (extra: Array[String]) (scratch: String) (target: String) (release: Bool): String = {
    let flags = Array.concat(target_args(target), Array.concat(cc_mode_args(release), ["-Wno-override-module"]));
    let built = compile_objs(srcs, 0, scratch, flags, []);
    if built.err != "" { built.err }
    else {
        let argv = Array.concat(Array.concat(Array.concat(Array.concat(cc_prefix_args(), target_args(target)), built.objs), extra),
            Array.concat(platform_libs(target), ["-o", out]));
        match Os.run_process(cc_program(), argv) {
            Err(e) => "build failed: ".concat(e),
            Ok(r) => if r.exit_code != 0 {
                Array.join(cc_words(), " ").concat(" failed to link (exit ").concat(r.exit_code.to_string()).concat("):\n").concat(r.stderr)
            } else {
                // The objects are still in `scratch`, so the map resolves.
                let bundled = run_dsymutil(out);
                let cleaned = Os.remove_file(srcs[0]);
                ""
            },
        }
    }
}

let run_dsymutil (out: String): Unit =
    match Os.run_process("dsymutil", [out]) { Ok(r) => (), Err(e) => () }

let platform_libs (target: String): Array[String] =
    if target_os(target) == "windows" { ["-lm", "-lpthread", "-lws2_32"] } else { ["-lm"] }

// Every 64-bit architecture this compiler is willing to emit for.
//
// An ALLOW-list, deliberately, and the one piece of this feature that
// is a real restriction rather than a pass-through. Cell layout assumes
// 8-byte slots throughout codegen, so a 32-bit target does not fail --
// it MISCOMPILES, silently, into a binary that reads half a pointer.
// An unknown architecture is refused for the same reason: being wrong
// about the width is unrecoverable, and being wrong about the name
// costs one line here.
let known_64_bit_arches (): Array[String] =
    ["x86_64", "amd64", "aarch64", "arm64", "riscv64", "powerpc64", "powerpc64le", "ppc64", "ppc64le", "s390x", "loongarch64", "mips64", "mips64el", "sparc64"]

// The architecture component of a triple: everything before the first
// `-`, which is the one position that IS fixed across every spelling.
let target_arch (triple: String): String = {
    let parts = triple.split("-");
    if Array.is_empty(parts) { triple } else { parts[0] }
}

// An error message for a target we must not build, or "" to proceed.
let target_error (triple: String): String =
    if triple == native_target() { "" }
    else if Array.contains(known_64_bit_arches(), target_arch(triple)) { "" }
    else {
        "unsupported target `".concat(triple).concat("`: Plum emits 64-bit code only, and `")
            .concat(target_arch(triple))
            .concat("` is not a 64-bit architecture this compiler knows.\n")
            .concat("Known: ").concat(Array.join(known_64_bit_arches(), ", "))
    }

// --- The C driver ---
//
// `clang` unless `PLUM_CC` says otherwise. A native build needs nothing
// but clang and that is unchanged; the hook exists because clang can
// EMIT code for any target but cannot LINK one without that target's
// libc, and Plum ships no sysroot. In practice this is set to
// `zig cc`, or to a corporate cross toolchain:
//
//   PLUM_CC="zig cc" plum build . --target aarch64-linux-musl
//
// Split on spaces, because the useful values are two words. The tail
// becomes leading arguments; `run_process` takes a program and its
// arguments separately and does not go through a shell, so a single
// string would be looked up as one long filename.
let cc_words (): Array[String] =
    match Os.env_var("PLUM_CC") {
        None => ["clang"],
        Some(v) => {
            let words = non_empty(v.split(" "), 0, []);
            if Array.is_empty(words) { ["clang"] } else { words }
        },
    }

let non_empty (xs: Array[String]) (i: Int) (acc: Array[String]): Array[String] =
    if i >= xs.len() { acc }
    else { non_empty(xs, i + 1, if xs[i] == "" { acc } else { acc.push(xs[i]) }) }

let cc_program (): String = cc_words()[0]

// The rest of `PLUM_CC` -- the `cc` in `zig cc` -- as leading arguments.
let cc_prefix_args (): Array[String] = {
    let words = cc_words();
    Array.slice(words, 1, words.len())
}

// The `--target=` flag itself, as zero or one argument. Empty for a
// native build, so nothing changes on the path everyone uses.
let target_args (target: String): Array[String] =
    if target == native_target() { [] } else { ["--target=".concat(target)] }

let link_args (argv: Array[String]) (dir: String): Array[String] = {
    let libs = Array.map(collect_flag(argv, "--link-lib", 0, []), |l| "-l".concat(l));
    let cs = Array.concat(collect_flag(argv, "--link-c", 0, []), native_c_files(dir.concat("/native")));
    Array.concat(cs, libs)
}

// Compiles a project to `out`. Returns an error message, or "" on
// success -- shared by `build` and `run`, which differ only in what
// they do with the binary afterwards.
// Writes every embedded shim into `dir`, returning their paths. A
// failure to write one is reported as an empty path list, which clang
// then fails on with a message naming the missing symbol -- not ideal,
// but strictly better than the silent wrong-directory behaviour this
// replaced.
let write_shims (dir: String): Array[String] =
    write_shims_acc(shims.shim_files(()), dir, 0, [])

let write_shims_acc (files: Array[shims.ShimFile]) (dir: String) (i: Int) (acc: Array[String]): Array[String] =
    if i >= files.len() { acc }
    else {
        let path = dir.concat("/").concat(files[i].name);
        match Os.write_file(path, files[i].source) {
            Err(_) => write_shims_acc(files, dir, i + 1, acc),
            Ok(_) => write_shims_acc(files, dir, i + 1, acc.push(path)),
        }
    }

// --- Build modes ---
//
// `plum build` is a DEBUG build unless told otherwise. A debug binary
// keeps its frames and carries debug information; `--release` is the
// optimised one.
//
// Debug is the default because the cost of guessing wrong runs one way.
// A person who wanted the fast binary and got the debuggable one has a
// slow program and a flag to learn. A person who wanted to debug and
// got the optimised one has inlined frames, no line information, and
// nothing to tell them why -- and this compiler produced only that,
// with no way to ask for anything else, until 2026-09-01.
//
// `-g` alone gives a debugger the C shims and not much else: the
// emitted IR carries no `!dbg` metadata yet, so there is no Plum line
// information for it to read. What the debug build DOES buy immediately
// is frames that still exist, which is the half a stack trace needs.
//
// `-Og`, not `-O0`, and the difference is not a preference. This
// backend emits no `musttail`, so a tail-recursive function is a real
// call chain in the IR and stays one unless the C compiler turns it
// into a loop. `-O0` does not, and
//
//     let count (n: Int) (acc: Int): Int =
//         if n == 0 { acc } else { count(n - 1, acc + n) }
//
// segfaults at three million deep in a `-O0` build and returns in an
// `-O2` one. Making debug the default with `-O0` would have introduced
// that crash into every default build -- for a language whose README
// promises tail calls run in constant stack space.
//
// `-Og` is "optimise for debugging experience": it keeps the debug
// information and does the sibling-call transform. Measured, all with
// `-g`: `-O0` crashes, `-Og` and `-O1` return, and all three carry
// DWARF. `bootstrap/check-build-modes` runs that program in BOTH modes
// so this cannot regress quietly.
let cc_mode_args (release: Bool): Array[String] =
    if release { ["-O2"] } else { ["-Og", "-g"] }

// `--release` anywhere in the argument list. A flag, not a manifest
// key: a Plum project is a directory with no configuration file, and
// adding one to hold a single boolean would be the tail wagging the
// dog.
pub let wants_release (argv: Array[String]): Bool = Array.contains(argv, "--release")

// `--trace`: a stack trace when the program dies.
//
// A flag rather than part of the debug build, because a shadow call
// stack costs a push and a pop per call. It does NOT cost tail-call
// elimination any more: the pop is paid per PATH, and a self-call in
// tail position pops before calling rather than after returning, so
// nothing sits between that call and the `ret`. DESIGN.md's "Traces
// AND tail calls" entry has the measurements, `cg_expr_t` in
// `codegen/codegen.plum` the emission, and `native_stdlib/io_shim.c`
// the runtime.
pub let wants_trace (argv: Array[String]): Bool = Array.contains(argv, "--trace")

let compile_project (dir: String) (out: String) (extra: Array[String]) (target: String) (release: Bool) (trace: Bool): String = {
    let bad = target_error(target);
    if bad != "" { bad }
    else {
        match Os.temp_dir() {
            Err(e) => "build failed: ".concat(e),
            Ok(scratch) => {
                let err = compile_with_scratch(dir, out, extra, scratch, target, release, trace);
                let cleaned = Os.remove_tree(scratch);
                err
            },
        }
    }
}

let compile_with_scratch (dir: String) (out: String) (extra: Array[String]) (scratch: String) (target: String) (release: Bool) (trace: Bool): String = {
    let ll = out.concat(".ll");
    // Debug builds carry the shadow call stack; release builds do not.
    codegen.set_debug_frames(trace);
    // DWARF line tables, so a debugger and a profiler can name Plum
    // lines. A DEBUG build only: `--release` is compiled without `-g`
    // and has nothing to read them.
    codegen.set_debug_info(!release);
    let ir = codegen.cg_emit_program(parser.ProgramNode { items: collect_project(dir) });
    match Os.write_file(ll, ir) {
        Err(e) => "build failed: ".concat(e),
        Ok(_) => {
            // The shims are EMBEDDED and written out per build, not read
            // from `native_stdlib/` on disk: that path was relative to
            // the current directory, so this compiler only worked when
            // run from the repo root. See `shims/shims.plum`.
            let cfiles = write_shims(scratch);
            let base = Array.concat(target_args(target), Array.concat(cc_mode_args(release), ["-Wno-override-module", ll]));
            let argv2 = Array.concat(Array.concat(Array.concat(Array.concat(cc_prefix_args(), base), cfiles), extra), Array.concat(platform_libs(target), ["-o", out]));
            // Mach-O debug builds take a different route entirely -- see
            // `compile_two_phase`. Everything else compiles and links in
            // one clang invocation, which is both faster and what every
            // platform but this one wants.
            if !release && target_os(target) == "macos" {
                compile_two_phase(Array.concat([ll], cfiles), out, extra, scratch, target, release)
            } else {
                match Os.run_process(cc_program(), argv2) {
                    Err(e) => "build failed: ".concat(e),
                    Ok(r) => if r.exit_code == 0 {
                        // The scratch `.ll` is removed on SUCCESS and kept on
                        // failure, where it is the thing you want to look at.
                        // Leaving it always is the same leak `plum build` had
                        // (see DESIGN.md) -- several MB per build, forever.
                        let cleaned = Os.remove_file(ll);
                        ""
                    } else {
                        Array.join(cc_words(), " ").concat(" failed (exit ").concat(r.exit_code.to_string()).concat("):\n").concat(r.stderr)
                            .concat("\nIR left at ").concat(ll)
                    },
                } }
        },
    }
}

let build_project (argv: Array[String]): Unit = {
    let target = match find_flag_value(argv, "--target", 0) { Some(t) => t, None => native_target() };
    let out = output_path(argv, target);
    let err = compile_project(argv[1], out, link_args(argv, argv[1]), target, wants_release(argv), wants_trace(argv));
    if err == "" { println("wrote ".concat(out)) } else { println(err) }
}

// `run` COMPILES and executes, rather than walking the AST.
//
// The tree-walking interpreter it replaces had fallen seven features
// behind the backend -- no `Ref`, no `spawn`, no FFI, no JSON, most
// methods missing -- because every feature this compiler gained had to
// be written for the backend and then AGAIN for the interpreter, and
// the second half kept not happening. Two implementations of one
// language's semantics is a standing invitation to exactly that drift.
// Compiling means `run` and `build` cannot disagree, because they are
// the same path.
//
// Costs a compile before anything runs, which for a project this size
// is well under a second, and the honest comparison is against a `run`
// that failed on seven of nine examples.
//
// Output is INHERITED, not captured: the program's output appears as it
// happens and it can read stdin, neither of which `run_process` allows.
// The shim splits its argument string on TABs (`PLUM_PROC_ARG_SEP`),
// and the FIRST element must not be preceded by one -- a leading
// separator makes `argv[1]` empty and pushes the last argument past
// `argc`, which is a bug this project has already made once.
let tab_join (args: Array[String]) (i: Int) (acc: String): String =
    if i >= args.len() { acc }
    else { tab_join(args, i + 1, if i == 0 { args[i] } else { acc.concat("\t").concat(args[i]) }) }

let run_project (argv: Array[String]): Unit = {
    match Os.temp_dir() {
        Err(e) => println("run failed: ".concat(e)),
        Ok(dir) => {
            let out = dir.concat("/a.out");
            // Always NATIVE: `run` executes what it builds, and this
            // machine cannot execute a foreign binary. Anything that
            // looks like `--target` after the project directory is one
            // of the PROGRAM's own arguments, not ours.
            let err = compile_project(argv[1], out, link_args(argv, argv[1]), native_target(), wants_release(argv), wants_trace(argv));
            if err != "" { println(err) }
            else {
                let args = Array.slice(argv, 2, argv.len());
                let code = unsafe { process_run_inherit(out.as_cstr(), tab_join(args, 0, "").as_cstr(), args.len()) };
                let cleaned = Os.remove_tree(dir);
                // The child's exit code is this process's exit code, so
                // `plum run` composes in a shell the way anything else
                // would. `panic_raw` is the only non-zero exit this
                // language exposes.
                if code != 0 { panic_raw("") } else { () }
            }
        },
    }
}

// --- Project loading (`check` only) ---
//
// `check` accepts a DIRECTORY as well as a single file, because a
// module can't be type-checked alone: `parser/parser.plum` references
// `lexer.Token`, `interp/interp.plum` references `parser.PExpr`, and so
// on, so checking one file in isolation fails with "unknown type"
// through no fault of the program. Given a directory, every `.plum`
// file under it is parsed and their items CONCATENATED into one
// program, which is then checked as a unit.
//
// Items are still concatenated into one program, but each one now
// carries the MODULE it came from — the name of the directory holding
// its file, or "" for a file at the project root. `collect_project`
// assigns those; the parser writes "" and knows nothing about it.
//
// FUNCTIONS and GLOBALS are scoped by module: an unqualified name
// resolves in its own module, then in the root module (where the
// prelude lives), and never in a sibling. Crossing a module boundary
// means naming it — `lexer.tokenize` resolves IN `lexer`. Two modules
// can therefore declare the same function name with different types,
// which is exactly what `interp.plum` and `typecheck/infer.plum` both
// wanting a `bind_params` needed, and what forced a rename before.
//
// TYPES and VARIANT TAGS remain flat, deliberately: `parser.PExpr` and
// a bare `PExpr` resolve identically because `resolve_named` keys off a
// path's last segment, and `parser.plum` matches on `TokLet` — a tag
// declared in `lexer` — without qualifying it. Scoping those would be a
// language change, not a checker change, and the sources depend on the
// current rule. DESIGN.md's module-system section documents the flat
// tag namespace as a deliberate boundary.
let parse_file_items (path: String) (module_name: String): Array[parser.ItemNode] =
    match Os.read_file(path) {
        // The source context is set per FILE, immediately before that
        // file is parsed, so a parse error can report `path:line:col`
        // with a caret instead of a bare message. See
        // `parser.set_source_context`.
        Ok(src) => {
            let lexed = lexer.tokenize_spanned(src);
            parser.set_source_context(path, src, lexed.starts, lexed.ends);
            parser.with_module(parser.parse_program(lexed.tokens).items, module_name)
        },
        Err(e) => { panic_raw("failed to read ".concat(path).concat(": ").concat(e)); [] },
    }

// The same reconstruction as `lexer.relex`, one level up: the file
// rebuilt from ITEM spans and the gaps between them, rather than from
// token spans.
//
// Same argument, same falsifiability. An item whose end is wrong
// donates the missing text to the next gap and the file still comes
// back byte-identical -- so the gap between two items is also checked
// to be trivia, which is what a wrong boundary would break. An item
// that overlaps its neighbour is caught by the same check, from the
// other side: the gap would be negative-width and the slice would
// repeat text.
let relex_items (path: String) (src: String): String = {
    let lexed = lexer.tokenize_spanned(src);
    parser.set_source_context(path, src, lexed.starts, lexed.ends);
    let items = parser.parse_program(lexed.tokens).items;
    let chars = chars_of(src);
    relex_items_acc(chars, items, 0, 0, "")
}

let relex_items_acc (chars: Array[String]) (items: Array[parser.ItemNode]) (i: Int) (at: Int) (acc: String): String =
    if i >= items.len() { acc.concat(Array.concat_all(Array.slice(chars, at, chars.len()))) }
    else {
        let it = items[i];
        if it.start < at { panic_raw("item ".concat(i.to_string()).concat(" overlaps the one before it")) } else { () };
        if !lexer.gap_is_trivia(chars, at, it.start) {
            panic_raw("item ".concat(i.to_string()).concat(" has non-trivia before it: an item boundary is wrong"))
        } else { () };
        relex_items_acc(chars, items, i + 1, it.end,
            acc.concat(Array.concat_all(Array.slice(chars, at, it.end))))
    }

// `plum fmt` -- to stdout by default, `--write` in place, `--check` to
// report without touching anything.
//
// Printing to stdout was the only mode for a while, which made the
// formatter unusable: the way to apply it would be `plum fmt f > f`,
// and the shell truncates `f` before this program ever runs. A
// formatter you cannot safely point at your own file is a demo.
let cmd_fmt (argv: Array[String]): Unit = {
    let write = fmt_has_flag(argv, "--write", 1);
    let check = fmt_has_flag(argv, "--check", 1);
    let target = fmt_target(argv, 1);
    if target == "" { { println("usage: plum fmt [--write|--check] <file-or-directory>"); Os.exit_with(1) } }
    else {
        let files = fmt_files(target);
        if Array.is_empty(files) { { println("fmt: no .plum files under ".concat(target)); Os.exit_with(1) } }
        else { fmt_each(files, 0, write, check, 0) }
    }
}

let fmt_has_flag (argv: Array[String]) (flag: String) (i: Int): Bool =
    if i >= argv.len() { false } else if argv[i] == flag { true } else { fmt_has_flag(argv, flag, i + 1) }

let fmt_target (argv: Array[String]) (i: Int): String =
    if i >= argv.len() { "" }
    else if argv[i].starts_with("--") { fmt_target(argv, i + 1) }
    else { argv[i] }

// Every `.plum` file under a path, or the path itself when it is a
// file. A directory argument is the difference between formatting a
// project and formatting a file at a time.
let fmt_files (target: String): Array[String] =
    if Result.unwrap_or(Os.is_directory(target), false) { fmt_walk(target, Result.unwrap_or(Os.list_dir(target), []), 0, []) }
    else if target.ends_with(".plum") { [target] }
    else { [] }

let fmt_walk (dir: String) (entries: Array[String]) (i: Int) (acc: Array[String]): Array[String] =
    if i >= entries.len() { acc }
    else if entries[i] == "." || entries[i] == ".." { fmt_walk(dir, entries, i + 1, acc) }
    else {
        let full = dir.concat("/").concat(entries[i]);
        if Result.unwrap_or(Os.is_directory(full), false) {
            fmt_walk(dir, entries, i + 1, Array.concat(acc, fmt_walk(full, Result.unwrap_or(Os.list_dir(full), []), 0, [])))
        } else if entries[i].ends_with(".plum") { fmt_walk(dir, entries, i + 1, acc.push(full)) }
        else { fmt_walk(dir, entries, i + 1, acc) }
    }

let fmt_each (files: Array[String]) (i: Int) (write: Bool) (check: Bool) (unformatted: Int): Unit =
    if i >= files.len() {
        if check && unformatted > 0 {
            println(unformatted.to_string().concat(" file(s) need formatting"));
            Os.exit_with(1)
        } else { () }
    } else {
        let n = fmt_one(files[i], write, check);
        fmt_each(files, i + 1, write, check, unformatted + n)
    }

// Returns 1 when the file was not already formatted.
//
// The token stream is compared BEFORE anything is written. `fmt-check`
// asserts that property across the repo, but a user running `--write`
// is not running `fmt-check`, and this is the moment where being wrong
// costs them their source file. So the guarantee is enforced here too:
// if formatting changed the tokens, something is wrong with a rule and
// the file is left exactly as it was.
let fmt_one (path: String) (write: Bool) (check: Bool): Int =
    match Os.read_file(path) {
        Err(e) => { println("fmt: ".concat(e)); Os.exit_with(1); 0 },
        Ok(src) => {
            let out = fmt.format(path, src);
            // An already-formatted file still gets PRINTED in stdout
            // mode. Returning early here skipped that, so `plum fmt f`
            // on a tidy file emitted nothing at all -- which anything
            // piping the output reads as an empty file.
            if out == src { { if !write && !check { print(out) } else { () }; 0 } }
            else if lexer.token_texts(out) != lexer.token_texts(src) {
                println("fmt: refusing to write ".concat(path).concat(": formatting changed the token stream, which is a bug in a rule"));
                Os.exit_with(1);
                0
            }
            else if check { { println(path); 1 } }
            else if write { { fmt_write(path, out); 1 } }
            else { { print(out); 1 } }
        },
    }

// Written BESIDE the original and renamed into place, because `rename`
// is atomic within a filesystem: the path is either the old file or the
// new one and never a half-written mixture. Writing straight over the
// original would mean an interrupted run -- a full disk, a Ctrl-C --
// could leave somebody's source truncated, which is the one thing a
// formatter must never do.
//
// Beside it, not in a temp directory, for two reasons: `rename` across
// filesystems fails, and the neighbouring directory is the one place
// guaranteed to be on the same one.
let fmt_write (path: String) (out: String): Unit = {
    let tmp = path.concat(".fmt-tmp");
    match Os.write_file(tmp, out) {
        Err(e) => { println("fmt: ".concat(e)); Os.exit_with(1) },
        Ok(_) => match Os.rename_file(tmp, path) {
            Ok(_) => println("formatted ".concat(path)),
            Err(e) => { Os.remove_file(tmp); println("fmt: ".concat(e)); Os.exit_with(1) },
        },
    }
}

// A project's MODULES are its immediate subdirectories, Go-style: every
// `.plum` file under `lexer/` belongs to module `lexer`, and a file at
// the project root belongs to the root module `""`. Nesting deeper does
// not create a deeper module — a file in `a/b/` is still in module `a`,
// which matches how the sources are actually laid out and avoids
// inventing a path syntax nothing writes.
let collect_path_items (path: String) (module_name: String): Array[parser.ItemNode] =
    if Result.unwrap_or(Os.is_directory(path), false) {
        collect_entries(path, module_name, Result.unwrap_or(Os.list_dir(path), []), 0, [])
    } else if path.ends_with(".plum") {
        parse_file_items(path, module_name)
    } else {
        []
    }

// The project ROOT: each subdirectory names a module, each root-level
// file belongs to `""`.
let collect_project (root: String): Array[parser.ItemNode] =
    if Result.unwrap_or(Os.is_directory(root), false) {
        collect_root_entries(root, Result.unwrap_or(Os.list_dir(root), []), 0, [])
    } else {
        collect_path_items(root, "")
    }

let collect_root_entries (root: String) (entries: Array[String]) (i: Int) (acc: Array[parser.ItemNode]): Array[parser.ItemNode] =
    if i >= entries.len() { acc }
    else if entries[i] == "." || entries[i] == ".." { collect_root_entries(root, entries, i + 1, acc) }
    else {
        let full = root.concat("/").concat(entries[i]);
        let m = if Result.unwrap_or(Os.is_directory(full), false) { entries[i] } else { "" };
        collect_root_entries(root, entries, i + 1, Array.concat(acc, collect_path_items(full, m)))
    }

// `.`/`..` are skipped explicitly — `list_dir` surfaces raw `readdir`
// entries, so descending into them would recurse forever.
let collect_entries (dir: String) (module_name: String) (entries: Array[String]) (i: Int) (acc: Array[parser.ItemNode]): Array[parser.ItemNode] =
    if i >= entries.len() { acc }
    else if entries[i] == "." || entries[i] == ".." { collect_entries(dir, module_name, entries, i + 1, acc) }
    else {
        let full = dir.concat("/").concat(entries[i]);
        collect_entries(dir, module_name, entries, i + 1, Array.concat(acc, collect_path_items(full, module_name)))
    }

// `new <name>` — scaffold a project, mirroring the real compiler's own
// `run_new`/`new_project`, including refusing to overwrite.
//
// The directory is created by shelling out to `mkdir`, not by a runtime
// primitive. A `mkdir_raw` primitive was written first and then removed:
// this file is compiled by BOTH compilers, and the real one has no such
// builtin, so it would have had to gain a whole IR node -- ir.rs,
// lowering, the interpreter, codegen, the prelude -- to scaffold a
// directory. `build` already shells out to `clang`, so this uses the
// mechanism that exists in both rather than adding one that exists in
// neither. A primitive that only one compiler could exercise would rot
// unnoticed until the Rust backend goes away.
// What a new project starts as. Deliberately more than `hello, plum`:
// a function, a string method, and a TEST -- so `plum test` does
// something on a fresh project instead of reporting zero tests, and so
// the first file anyone reads shows what a test looks like.
let new_template (unit: Unit): String = "// Generated by `plum new`.\n\nlet greet (who: String): String = \"hello, \".concat(who)\n\nlet main (): Unit = println(greet(\"plum\"))\n\n// `plum test` runs every zero-argument function whose name starts with\n// `test_`, each in its own process.\nlet test_greet (): Unit = assert_eq(greet(\"plum\"), \"hello, plum\")\n"

let cmd_new (name: String): Unit =
    if Result.unwrap_or(Os.is_directory(name), false) {
        new_failed(name.concat(" already exists — refusing to overwrite it"))
    } else if !mkdir_ok(name) {
        new_failed("failed to create ".concat(name))
    } else {
        match Os.write_file(name.concat("/main.plum"), new_template(())) {
            Err(e) => new_failed("failed to write main.plum: ".concat(e)),
            // The three commands, named at the moment they are wanted.
            // A scaffold that leaves you at a prompt with one line of
            // code and no idea what to type next is most of the way to
            // being no help at all.
            Ok(_) => {
                println("created ".concat(name));
                println("");
                println("  plum run ".concat(name).concat("      compile and run it"));
                println("  plum test ".concat(name).concat("     run its tests"));
                println("  plum build ".concat(name).concat("    compile to a binary"))
            },
        }
    }

// The real `plum new` exits 1 on every one of these, so this does too.
// `panic_raw` is the only non-zero exit this language exposes (see
// `run_tests`), so the message is printed first and the panic carries
// nothing -- otherwise the abort message would double-report it.
let new_failed (msg: String): Unit = { println(msg); panic_raw("") }

let mkdir_ok (name: String): Bool =
    match Os.make_dir(name) {
        Ok(_) => true,
        Err(_) => false,
    }

let main (): Unit = {
    let argv = args();
    // Before the `argv.len() < 2` guard below, alongside `lsp`: both
    // are complete with no second argument. Placed after it at first,
    // where it was unreachable -- `version` fell into the usage branch
    // instead.
    if argv.len() >= 1 && (argv[0] == "version" || argv[0] == "--version" || argv[0] == "-V") {
        println("plum ".concat(plum_version()));
    } else if argv.len() >= 1 && (argv[0] == "help" || argv[0] == "--help" || argv[0] == "-h") {
        // Same placement as `version`: a command complete with no
        // second argument. Without this branch, `plum help` happens
        // to print usage because argv.len() is 1, but `plum help
        // build` tries to open `build` as a file.
        usage(());
    } else if argv.len() >= 1 && argv[0] == "lsp" {
        // No file argument: the server talks over stdin/stdout.
        lsp_serve(())
    } else if argv.len() >= 1 && argv[0] == "stdlib-reference" {
        // Before the `argv.len() < 2` guard for the same reason
        // `version` is, and the comment above is why this was checked
        // rather than assumed: it takes no argument either.
        cmd_stdlib_reference(())
    } else if argv.len() < 2 {
        usage(());
    } else if argv[0] == "query" && argv.len() >= 5 {
        cmd_query(argv[1], argv[2],
            Result.unwrap_or(String.parse_int(argv[3]), 1),
            Result.unwrap_or(String.parse_int(argv[4]), 1));
    } else if argv[0] == "defs" {
        cmd_defs(argv[1]);
    } else if argv[0] == "complete" {
        cmd_complete(argv[1]);
    } else if argv[0] == "locals" && argv.len() >= 5 {
        cmd_locals(argv[1], argv[2],
            Result.unwrap_or(String.parse_int(argv[3]), 1),
            Result.unwrap_or(String.parse_int(argv[4]), 1));
    } else if argv[0] == "members" && argv.len() >= 5 {
        cmd_members(argv[1], argv[2],
            Result.unwrap_or(String.parse_int(argv[3]), 1),
            Result.unwrap_or(String.parse_int(argv[4]), 1));
    } else if argv[0] == "new" {
        cmd_new(argv[1]);
    } else if argv[0] == "check" {
        // Handled before `read_file` below: the argument may be a
        // DIRECTORY, which `read_file` can't open at all.
        //
        // The PRELUDE is prepended, exactly as the backend does before
        // it checks (`cg_emit_program_entry`). Before 2026-08-20 this
        // checked the user's items ALONE, against a hand-written table
        // of prelude signatures in `typecheck/infer.plum` -- a second
        // copy of a list that already exists as source. The two copies
        // disagreed, silently and for a long time: `Map`, `Set`,
        // `String.contains` and `String.repeat` were missing from the
        // table, so `check` rejected four groups of programs that
        // `build` compiled and ran correctly.
        //
        // Reading the real thing costs ~20ms. The table cost four
        // wrong answers.
        typecheck.check_program(codegen.cg_with_prelude(parser.ProgramNode { items: collect_project(argv[1]) }));
        println("ok");
    } else if argv[0] == "test" && Result.unwrap_or(Os.is_directory(argv[1]), false) {
        cmd_test(argv[1], wants_release(argv), wants_trace(argv));
    } else if argv[0] == "build" && Result.unwrap_or(Os.is_directory(argv[1]), false) {
        build_project(argv);
    } else if argv[0] == "emit-llvm" && Result.unwrap_or(Os.is_directory(argv[1]), false) {
        // Same directory loading `check` and `run` use. A real Plum
        // project is several modules, so a backend that only accepted
        // one file could never compile one.
        codegen.set_debug_frames(wants_trace(argv));
        codegen.set_debug_info(!wants_release(argv));
        println(codegen.cg_emit_program(parser.ProgramNode { items: collect_project(argv[1]) }));
    } else if argv[0] == "fmt" {
        cmd_fmt(argv);
    } else if argv[0] == "spans" {
        // Every construct span in one file, `start,end` per line. Read
        // by the LSP out of a child process -- see `cmd_spans`.
        if argv.len() < 2 { usage() } else { cmd_spans(argv[1]) };
    } else if argv[0] == "relex" {
        // Reads a FILE and writes back what the token stream says it
        // was. The identity formatter: no opinions, no reflow, just
        // proof that nothing between the tokens was lost.
        //
        // A development command, not a user-facing one -- it exists so
        // `bootstrap/lossless-check` can diff the answer against the
        // input, and because `plum fmt` will be this function with
        // opinions added. If the version WITHOUT opinions cannot
        // reproduce a file byte for byte, the version with them has
        // nothing sound to build on.
        match Os.read_file(argv[1]) {
            Ok(src) =>
                if argv.len() > 2 && argv[2] == "--items" { print(relex_items(argv[1], src)) }
                // One token's own source text per line. No token can
                // contain a newline -- there are no block comments and
                // a string literal cannot span lines -- so a line per
                // token is unambiguous.
                //
                // This is what makes a formatting rule that touches
                // more than leading whitespace checkable: two files
                // whose token texts agree, in order, are the same
                // program however the whitespace between them differs.
                else if argv.len() > 2 && argv[2] == "--tokens" { print(lexer.token_texts(src)) }
                else { print(lexer.relex(src)) },
            Err(e) => { println("relex: ".concat(e)); Os.exit_with(1) },
        };
    } else if argv[0] == "run" && Result.unwrap_or(Os.is_directory(argv[1]), false) {
        run_project(argv);
    } else {
        match Os.read_file(argv[1]) {
            Err(e) => println("failed to read file: ".concat(e)),
            Ok(src) => {
                // Same source context the project path sets, so a parse
                // error in a single file reports its location too.
                let lexed0 = lexer.tokenize_spanned(src);
                parser.set_source_context(argv[1], src, lexed0.starts, lexed0.ends);
                if argv[0] == "tokens" || argv[0] == "dump-tokens" {
                    println(lexer.render_tokens(lexer.tokenize(src)));
                } else if argv[0] == "ast" || argv[0] == "dump-ast" {
                    println(parser.render_program(parser.parse_program(lexer.tokenize(src))));
                } else if argv[0] == "emit-llvm" {
                    // Stage 5. NO separate `check_program` call: the
                    // backend prepends the prelude and then type-checks
                    // the combined program itself (`typed_program` IS
                    // `check_program` with the results kept), so a
                    // second call here would check the same program
                    // twice.
                    //
                    // This comment used to warn that checking here
                    // would check the WRONG program -- the user's items
                    // WITHOUT the prelude -- and reject calls to
                    // prelude functions absent from a hand-written
                    // `builtin_sig` table. That hazard is gone: `check`
                    // prepends the prelude too now, and the table with
                    // it. See DESIGN.md's "One prelude, not two".
                    println(codegen.cg_emit_program(parser.parse_program(lexer.tokenize(src))));
                } else if argv[0] == "run" {
                    // A single FILE runs the same way a project does --
                    // compiled. `collect_project` accepts either, so
                    // there is no second path to keep in step.
                    run_project(argv);
                } else {
                    usage(());
                }
            }
        }
    }
}
