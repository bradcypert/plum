use lexer;

// `plum highlight` -- Plum source as marked-up HTML.
//
// This exists because the documentation is generated by the compiler it
// documents, and syntax highlighting was the one part that wanted to be
// a SECOND implementation of the lexer. Every highlighter for every
// static-site generator is exactly that: a regex approximation of the
// language, maintained separately, wrong about the corners, and updated
// (or not) when the language changes. Bitwise operators went in this
// month; a regex highlighter would still be painting `^` as an unknown
// character.
//
// So it is the REAL lexer, and the reason that is even possible is that
// `lexer.tokenize_spanned` is LOSSLESS: it records where every token
// starts and ends, and `bootstrap/lossless-check` asserts that every gap
// between two tokens contains nothing but trivia. Walk the tokens in
// order, emit the gap then the token, and you have the file back. This
// module emits the gap then the token WRAPPED IN A SPAN, and has the
// file back with markup.
//
// The practical consequence is that a token this file does not classify
// is a token rendered plain -- never a token dropped, never a character
// invented. Highlighting cannot corrupt the code it highlights, which
// is the property that matters when the output is a tutorial someone
// will copy and paste.
//
// --- On snippets that do not lex ---
//
// Documentation contains illustrative fragments: an elided body, a
// pseudo-code line, a deliberately wrong program next to the error it
// produces. Those must still RENDER. So a lexer failure is not an
// error here -- it falls back to the escaped source, unhighlighted, and
// the page is merely plainer. Refusing to render a fenced block because
// it is not a whole compilable program would make this useless for the
// exact documents it was written for.

// --- Classes ------------------------------------------------------
//
// Short names because they repeat once per token across every page.
//
//   k   keyword          n   number          t   type or constructor
//   s   string           c   comment         d   doc comment
//   f   name being defined               o   operator or punctuation
//
// Anything unclassified is emitted bare, with no span at all, rather
// than as a `plain` class -- most tokens in most code are identifiers,
// and a span around each one would roughly double the size of every
// page to say nothing.
let hl_class (t: lexer.Token) (text: String): String =
    match t {
        TokInt(_) => "n",
        TokFloat(_) => "n",
        TokStr(_) => "s",
        TokInterpStr(_) => "s",
        TokTrue => "k",
        TokFalse => "k",
        TokLet => "k",
        TokMut => "k",
        TokFn => "k",
        TokStruct => "k",
        TokEnum => "k",
        TokMatch => "k",
        TokIf => "k",
        TokElse => "k",
        TokFor => "k",
        TokIn => "k",
        TokPub => "k",
        TokUse => "k",
        TokMod => "k",
        TokExtern => "k",
        TokUnsafe => "k",
        TokSpawn => "k",
        TokSelect => "k",
        TokBuiltin(_) => "k",
        // `handle`, `require` and `ensure` are CONTEXTUAL keywords --
        // the lexer hands them over as plain identifiers because they
        // are legal variable names, and only the parser's position
        // tells them apart. Highlighting them by name is therefore a
        // deliberate over-approximation: a variable called `require`
        // would be painted as a keyword. That is the right trade for a
        // highlighter, where a rare false positive costs a colour and
        // the alternative costs a parse.
        TokIdent(name) => if hl_is_contextual_keyword(name) { "k" }
            else if hl_starts_upper(name) { "t" }
            else { "" },
        TokUnderscore => "k",
        TokEof => "",
        // Everything left is punctuation and operators. Listing them
        // one by one would be fifty arms that all say the same thing,
        // and the wildcard cannot go wrong: the arms above have already
        // claimed every token that carries a payload.
        _ => "o",
    }

let hl_is_contextual_keyword (name: String): Bool =
    Array.contains(["handle", "require", "ensure", "on_drop"], name)

// A leading capital means a type or a variant, by convention that the
// whole standard library follows. There is no other signal available
// without running the type checker, and running the type checker to
// colour a fenced snippet -- which may not even be a whole program --
// would be the wrong trade.
let hl_starts_upper (name: String): Bool =
    if String.is_empty(name) { false }
    else { Array.contains(HL_UPPER, String.slice(name, 0, 1)) }

let HL_UPPER: Array[String] = String.split("ABCDEFGHIJKLMNOPQRSTUVWXYZ", "")

// --- Escaping -----------------------------------------------------
//
// Ampersand FIRST, or the escapes escape each other's escapes.
pub let hl_escape (s: String): String =
    String.replace(
        String.replace(
            String.replace(s, "&", "&amp;"),
            "<", "&lt;"),
        ">", "&gt;")

// --- Pieces -------------------------------------------------------
//
// The walk produces a flat list of (class, text) pieces and a second
// pass renders them, rather than emitting a span per token directly.
//
// That is not tidiness -- it is what lets ADJACENT PIECES OF THE SAME
// CLASS MERGE. Almost every character of punctuation is its own token,
// so a span-per-token renderer emits `<span class="o">(</span><span
// class="o">)</span>` for `()`, and roughly half of every generated
// page ends up being repeated span tags that say nothing. Merging runs
// is worth the extra pass on every page this ships on.
struct HlPiece { cls: String, text: String }

// Marked-up HTML for a whole snippet. The caller wraps it in whatever
// `<pre><code>` it wants; this emits the inside and nothing else, so
// the same function serves a documentation page and a website.
pub let hl_html (source: String): String =
    hl_render(hl_pieces(source))

// --- A note on the loops below ---
//
// Every accumulator here is a `let mut` rebound in place -- `acc =
// acc.push(x)` -- rather than a tail-recursive `f(acc.push(x))`, which
// is how most of this compiler is written and is what the first version
// of this file did.
//
// That is not a style preference. A SELF-REBINDING assignment is the
// one shape where the old value is provably dead (the slot is
// overwritten with the result, so nothing can observe a mutation), and
// the backend uses exactly that to grow the array in place. Threaded
// through a recursive call it cannot know that, so it copies -- and an
// accumulator that copies itself once per token is quadratic. The
// recursive version worked fine on every snippet and hung the harness
// on `parser.plum`, which is 69KB. Same for the string accumulator in
// `hl_render`: one `Array.concat_all` at the end, not a `concat` per
// piece.
//
// This is the fourth accidental O(n^2) in this project and the second
// caused by this exact distinction. See DESIGN.md.
let hl_pieces (source: String): Array[HlPiece] = {
    let lexed = lexer.tokenize_spanned(source);
    // Split ONCE. `lexer.token_text` would re-split the whole file per
    // token -- see the note on `lexer.source_chars`.
    let chars = lexer.source_chars(source);
    let mut acc = [];
    // True while the walk is inside a declaration HEAD -- between
    // `let`/`fn` and the first token that is not part of the name being
    // declared. It is a flag rather than a look-at-the-previous-token
    // rule because a name can be qualified: in `let Array.is_empty`,
    // the token after `let` is `Array`, and the name being declared is
    // two tokens further on. Every heading in the generated reference
    // has that shape, so it is worth getting right.
    let mut in_def = false;
    for i in 0..lexed.tokens.len() {
        acc = hl_gap_pieces(lexer.trivia_before_at(chars, lexed, i), acc);
        match lexed.tokens[i] {
            // The end-of-file token has no text. Emitting the trivia
            // before it still matters -- that is the file's trailing
            // newline, and a snippet that loses it renders with its
            // last line jammed against the fence.
            TokEof => {},
            tok => {
                let text = lexer.token_text_at(chars, lexed, i);
                acc = hl_token_pieces(hl_class_in(in_def, tok, text), tok, text, acc);
                in_def = hl_still_in_def(in_def, tok);
            },
        };
    };
    acc
}

// A declaration head starts at `let` or `fn` and ends at the first
// token that is not part of the name -- an open paren, a colon, an `=`.
// A qualified name is an identifier, a dot, and an identifier, so those
// three keep it open and nothing else does.
let hl_still_in_def (in_def: Bool) (tok: lexer.Token): Bool =
    match tok {
        TokLet => true,
        TokFn => true,
        TokDot => in_def,
        TokMut => in_def,
        TokIdent(_) => in_def,
        _ => false,
    }

// Inside a declaration head, a lower-case identifier is the name being
// DEFINED, and reads better picked out from the uses of it below.
let hl_class_in (in_def: Bool) (tok: lexer.Token) (text: String): String =
    if !in_def { hl_class(tok, text) }
    else {
        match tok {
            // `let mut x` -- `mut` follows `let`, and is a keyword, not
            // a name.
            TokIdent(name) => if hl_is_contextual_keyword(name) { "k" }
                else if hl_starts_upper(name) { "t" }
                else { "f" },
            _ => hl_class(tok, text),
        }
    }

// An interpolated string is ONE token whose text spans the quotes, so
// without this the expressions inside `"..."` would be painted as
// string content. Splitting on the hole markers is exactly right rather
// than approximately right, because an interpolation in Plum cannot
// contain a brace of its own -- the first closing brace is always the
// end of the hole.
let hl_token_pieces (cls: String) (tok: lexer.Token) (text: String) (acc: Array[HlPiece]): Array[HlPiece] =
    match tok {
        TokInterpStr(_) => hl_interp_pieces(text, 0, acc),
        _ => acc.push(HlPiece { cls: cls, text: text }),
    }

// Recursive rather than a loop, unlike the accumulators above, and
// deliberately: this recurses once per HOLE in one string literal --
// a handful, never thousands -- so the copying that made the token
// walk quadratic is not a factor, and the recursion reads better.
let hl_interp_pieces (text: String) (from: Int) (acc: Array[HlPiece]): Array[HlPiece] =
    if from >= text.len() { acc }
    else {
        let rest_all = String.slice(text, from, text.len());
        match String.index_of(rest_all, "\${") {
            None => acc.push(HlPiece { cls: "s", text: rest_all }),
            Some(rel) => {
                let open = from + rel;
                match String.index_of(String.slice(text, open + 2, text.len()), "}") {
                    // An unterminated hole cannot happen in a token the
                    // lexer accepted, but the slicing below would be
                    // wrong if it did, so it is handled rather than
                    // assumed away.
                    None => acc.push(HlPiece { cls: "s", text: rest_all }),
                    Some(close_rel) => {
                        let close = open + 2 + close_rel;
                        // The hole's own delimiters stay
                        // string-coloured -- they are part of the
                        // literal's syntax, and only the expression
                        // between them changes colour.
                        let opened = acc.push(HlPiece { cls: "s", text: String.slice(text, from, open + 2) });
                        let inner = Array.concat(opened, hl_pieces(String.slice(text, open + 2, close)));
                        hl_interp_pieces(text, close + 1, inner.push(HlPiece { cls: "s", text: "}" }))
                    },
                }
            },
        }
    }

// --- Trivia -------------------------------------------------------
//
// A gap is whitespace and comments. The whitespace is emitted as-is --
// `<pre>` preserves it, and rewriting it would change the indentation
// of code a reader is about to copy. The comments are what need
// picking out, and they run to end of line.
let hl_gap_pieces (gap: String) (acc: Array[HlPiece]): Array[HlPiece] =
    if String.is_empty(gap) { acc }
    else {
        match String.index_of(gap, "//") {
        None => acc.push(HlPiece { cls: "", text: gap }),
        Some(at) => {
            let head = acc.push(HlPiece { cls: "", text: String.slice(gap, 0, at) });
            let rest = String.slice(gap, at, gap.len());
            match String.index_of(rest, "\n") {
                // A trailing comment with no newline after it: the
                // last line of the snippet.
                None => head.push(HlPiece { cls: hl_comment_class(rest), text: rest }),
                Some(nl) => {
                    let line = String.slice(rest, 0, nl);
                    hl_gap_pieces(String.slice(rest, nl, rest.len()),
                        head.push(HlPiece { cls: hl_comment_class(line), text: line }))
                },
            }
        },
    }
    }

// A doc comment is a different thing from an aside to the next
// maintainer -- it is the published description of the declaration
// under it -- so it gets its own class and can be styled apart.
let hl_comment_class (text: String): String =
    if String.starts_with(text, "///") { "d" } else { "c" }

// --- Rendering ----------------------------------------------------
//
// One span per RUN of same-classed pieces. `cur` is the run being
// accumulated; it is flushed when the class changes and once at the
// end.
//
// A run with an empty class is emitted bare, with no span at all,
// rather than as a `plain` class -- most tokens in most code are
// identifiers, and a span around each one would say nothing at
// considerable length.
let hl_render (ps: Array[HlPiece]): String = {
    let mut parts = [];
    let mut cls = "";
    let mut cur = "";
    for p in ps {
        if p.cls == cls { cur = cur.concat(p.text); }
        else {
            parts = parts.push(hl_span(cls, cur));
            cls = p.cls;
            cur = p.text;
        };
    };
    Array.concat_all(parts.push(hl_span(cls, cur)))
}

let hl_span (cls: String) (text: String): String =
    if String.is_empty(text) { "" }
    else if String.is_empty(cls) { hl_escape(text) }
    else { "<span class=\"${cls}\">${hl_escape(text)}</span>" }
