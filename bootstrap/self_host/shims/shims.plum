        "/**",
        " * \\file camellia.h",
        " *",
        " * \\brief Camellia block cipher",
        " */",
        "/*",
        " *  Copyright The Mbed TLS Contributors",
        " *  SPDX-License-Identifier: Apache-2.0 OR GPL-2.0-or-later",
        " */",
        "#ifndef MBEDTLS_CAMELLIA_H",
        "#define MBEDTLS_CAMELLIA_H",
