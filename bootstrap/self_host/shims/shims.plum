        "static inline unsigned char mbedtls_ct_uchar_in_range_if(unsigned char low,",
        "                                                         unsigned char high,",
        "                                                         unsigned char c,",
        "                                                         unsigned char t);",
        "",
        "/** Choose between two error values. The values must be in the range [-32767..0].",
