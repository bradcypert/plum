        "                                                       const char *oid, size_t oid_len,",
        "                                                       const unsigned char *val,",
        "                                                       size_t val_len);",
        "",
        "#ifdef __cplusplus",
        "}",
        "#endif",
        "",
        "#endif /* MBEDTLS_ASN1_WRITE_C */",
        "",
        "#endif /* MBEDTLS_ASN1_WRITE_H */",
