        "#if defined(MBEDTLS_ECP_DP_BP512R1_ENABLED)",
        "        case MBEDTLS_ECP_DP_BP512R1:",
        "            if (ctype == (mbedtls_ecp_modulus_type) MBEDTLS_ECP_MOD_COORDINATE) {",
