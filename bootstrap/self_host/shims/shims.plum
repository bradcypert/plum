        " * Definition of CCM:",
        " * http://csrc.nist.gov/publications/nistpubs/800-38C/SP800-38C_updated-July20_2007.pdf",
        " * RFC 3610 \"Counter with CBC-MAC (CCM)\"",
        " *",
        " * Related:",
        " * RFC 5116 \"An Interface and Algorithms for Authenticated Encryption\"",
        " */",
        "",
        "#include \"common.h\"",
