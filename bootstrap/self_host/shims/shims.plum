        "#endif /* !MBEDTLS_PLATFORM_STD_TIME */",
        "",
        "mbedtls_time_t (*mbedtls_time)(mbedtls_time_t *timer) = MBEDTLS_PLATFORM_STD_TIME;",
        "",
        "int mbedtls_platform_set_time(mbedtls_time_t (*time_func)(mbedtls_time_t *timer))",
        "{",
