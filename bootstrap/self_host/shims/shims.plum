        " * \\brief          The CCM checkup routine.",
        " *",
        " * \\return         \\c 0 on success.",
        " * \\return         \\c 1 on failure.",
        " */",
        "int mbedtls_ccm_self_test(int verbose);",
        "#endif /* MBEDTLS_SELF_TEST && MBEDTLS_AES_C */",
        "",
        "#ifdef __cplusplus",
        "}",
        "#endif",
        "",
        "#endif /* MBEDTLS_CCM_H */",
