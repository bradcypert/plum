        " *",
        " * \\return      The number of bits in \\p A.",
        " */",
        "size_t mbedtls_mpi_core_bitlen(const mbedtls_mpi_uint *A, size_t A_limbs);",
        "",
        "/** Convert a big-endian byte array aligned to the size of mbedtls_mpi_uint",
