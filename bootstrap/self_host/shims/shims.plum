        "#if defined(MBEDTLS_PSA_BUILTIN_ALG_MD5)",
        "        mbedtls_md5_context md5;",
        "#endif",
        "#if defined(MBEDTLS_PSA_BUILTIN_ALG_RIPEMD160)",
