        "#endif",
        "#if defined(MBEDTLS_PSA_BUILTIN_ALG_SHA_1)",
        "        mbedtls_sha1_context sha1;",
        "#endif",
        "#if defined(MBEDTLS_PSA_BUILTIN_ALG_SHA_256) || \\",
        "        defined(MBEDTLS_PSA_BUILTIN_ALG_SHA_224)",
