        "/* Make sure no other definition is already present. */",
        "#undef ASSERT",
        "",
        "#define ASSERT(cond, args)            \\",
        "    do                                  \\",
        "    {                                   \\",
        "        if (!(cond))                \\",
        "        {                               \\",
