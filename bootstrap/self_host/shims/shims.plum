        "#define MBEDTLS_ECP_C",
        "#define MBEDTLS_BIGNUM_C",
        "#endif /* missing accel */",
        "#endif /* PSA_WANT_ALG_ECDH */",
        "",
        "#if defined(PSA_WANT_ALG_ECDSA)",
        "#if !defined(MBEDTLS_PSA_ACCEL_ALG_ECDSA) || \\",
        "    defined(MBEDTLS_PSA_ECC_ACCEL_INCOMPLETE_WEIERSTRASS_CURVES) || \\",
