        " *",
        " * \\return         0 if successful, or 1 if the test failed",
        " */",
        "MBEDTLS_CHECK_RETURN_CRITICAL",
        "int mbedtls_des_self_test(int verbose);",
        "",
        "#endif /* MBEDTLS_SELF_TEST */",
        "",
        "#ifdef __cplusplus",
        "}",
        "#endif",
        "",
        "#endif /* des.h */",
        "",
