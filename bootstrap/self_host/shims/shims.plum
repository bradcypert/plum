        "    0x01, 0x23, 0x45, 0x67,     0x89, 0xaa, 0xcd, 0xef,",
        "    /* Key2 */",
        "    0x23, 0x45, 0x67, 0x89,     0xab, 0xcd, 0xef, 0x01,",
        "    /* Key3 */",
        "    0x45, 0x67, 0x89, 0xab,     0xcd, 0xef, 0x01, 0x23",
        "};",
        "static const unsigned char des3_3key_subkeys[2][8] = {",
