        "                            const mbedtls_pk_context *key);",
        "#endif /* MBEDTLS_PK_WRITE_C */",
        "",
        "#ifdef __cplusplus",
        "}",
        "#endif",
        "",
        "#endif /* MBEDTLS_PK_H */",
        "",
