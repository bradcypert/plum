        "",
        "#define V(a, b, c, d) 0x##a##b##c##d",
        "MBEDTLS_MAYBE_UNUSED static const uint32_t RT0[256] = { RT };",
        "#undef V",
        "",
        "#define V(a, b, c, d) 0x##b##c##d##a",
