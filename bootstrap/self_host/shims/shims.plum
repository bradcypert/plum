        "#endif",
        "#if defined(MBEDTLS_MD_CAN_SHA224)",
        "    {",
        "        OID_DESCRIPTOR(MBEDTLS_OID_DIGEST_ALG_SHA224,    \"id-sha224\",    \"SHA-224\"),",
        "        MBEDTLS_MD_SHA224,",
