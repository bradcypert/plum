        " */",
        "",
        "#ifndef PSA_CRYPTO_BUILTIN_PRIMITIVES_H",
        "#define PSA_CRYPTO_BUILTIN_PRIMITIVES_H",
        "#include \"mbedtls/private_access.h\"",
        "",
