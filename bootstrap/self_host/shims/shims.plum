        "",
        "#include \"mbedtls/platform.h\"",
        "",
        "#if defined(MBEDTLS_USE_PSA_CRYPTO)",
        "#include \"psa/crypto.h\"",
        "#endif",
        "",
        "#if defined(MBEDTLS_MD_CAN_MD5) &&  \\",
        "    defined(MBEDTLS_CIPHER_MODE_CBC) &&                             \\",
        "    (defined(MBEDTLS_DES_C) || defined(MBEDTLS_AES_C))",
