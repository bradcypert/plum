        "static inline mbedtls_ct_condition_t mbedtls_ct_bool_if_else_0(mbedtls_ct_condition_t condition,",
        "                                                               mbedtls_ct_condition_t if1);",
        "",
        "/** Choose between a size_t value and 0.",
        " *",
