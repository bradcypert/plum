        "static const oid_md_hmac_t oid_md_hmac[] =",
        "{",
        "#if defined(MBEDTLS_MD_CAN_SHA1)",
        "    {",
        "        OID_DESCRIPTOR(MBEDTLS_OID_HMAC_SHA1,      \"hmacSHA1\",      \"HMAC-SHA-1\"),",
        "        MBEDTLS_MD_SHA1,",
        "    },",
