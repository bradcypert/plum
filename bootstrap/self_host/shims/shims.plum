        "#if defined(MBEDTLS_SSL_DTLS_SRTP)",
        "#if defined(MBEDTLS_DEBUG_C)",
        "static inline const char *mbedtls_ssl_get_srtp_profile_as_string(mbedtls_ssl_srtp_profile profile)",
        "{",
        "    switch (profile) {",
        "        case MBEDTLS_TLS_SRTP_AES128_CM_HMAC_SHA1_80:",
