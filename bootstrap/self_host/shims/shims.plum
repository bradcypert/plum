        source: join_lines([
        "/**",
        " * \\file des.h",
        " *",
        " * \\brief DES block cipher",
        " *",
        " * \\warning   DES/3DES are considered weak ciphers and their use constitutes a",
        " *            security risk. We recommend considering stronger ciphers",
        " *            instead.",
        " */",
        "/*",
        " *  Copyright The Mbed TLS Contributors",
