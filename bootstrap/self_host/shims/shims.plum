        "int mbedtls_rsa_self_test(int verbose);",
        "",
        "#endif /* MBEDTLS_SELF_TEST */",
        "",
        "#ifdef __cplusplus",
        "}",
        "#endif",
        "",
        "#endif /* rsa.h */",
        "",
