        "};",
        "static const mbedtls_mpi_uint secp192r1_gy[] = {",
        "    MBEDTLS_BYTES_TO_T_UINT_8(0x11, 0x48, 0x79, 0x1E, 0xA1, 0x77, 0xF9, 0x73),",
