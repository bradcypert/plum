        " *                              in bytes.",
        " */",
        "int psa_custom_key_parameters_are_default(",
        "    const psa_custom_key_parameters_t *custom,",
        "    size_t custom_data_length);",
        "",
        "/**",
        " * \\brief Generate a key.",
        " *",
        " * \\note The signature of the function is that of a PSA driver generate_key",
