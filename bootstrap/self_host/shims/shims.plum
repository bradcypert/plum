        "            return( mbedtls_psa_aead_set_nonce( &operation->ctx.mbedtls_ctx,",
        "                                                nonce,",
        "                                                nonce_length ) );",
        "",
        "#endif /* MBEDTLS_PSA_BUILTIN_AEAD */",
