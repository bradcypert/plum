        "    if (((long) input  & 15) != 0 ||",
        "        ((long) output & 15) != 0 ||",
        "        ((long) rk & 15) != 0) {",
        "        return MBEDTLS_ERR_PADLOCK_DATA_MISALIGNED;",
        "    }",
        "",
        "    iw = MBEDTLS_PADLOCK_ALIGN16(buf);",
        "    memcpy(iw, iv, 16);",
