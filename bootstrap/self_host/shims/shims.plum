        "  0xf7, 0xef, 0x06, 0xb8, 0xd6, 0x9c, 0x9d, 0xe8 };",
        "",
        "static const unsigned char entropy_source_nopr[] =",
        "{ 0x07, 0x0d, 0x59, 0x63, 0x98, 0x73, 0xa5, 0x45,",
