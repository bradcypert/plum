        "",
        "int mbedtls_chacha20_self_test(int verbose)",
        "{",
        "    unsigned char output[381];",
        "    unsigned i;",
        "    int ret = MBEDTLS_ERR_ERROR_CORRUPTION_DETECTED;",
        "",
        "    for (i = 0U; i < 2U; i++) {",
        "        if (verbose != 0) {",
