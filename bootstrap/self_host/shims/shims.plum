        "            return \"MBEDTLS_TLS_SRTP_NULL_HMAC_SHA1_80\";",
        "        case MBEDTLS_TLS_SRTP_NULL_HMAC_SHA1_32:",
        "            return \"MBEDTLS_TLS_SRTP_NULL_HMAC_SHA1_32\";",
