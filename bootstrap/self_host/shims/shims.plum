        " *                  mbedtls_ccm_update() was lower than the plaintext length",
        " *                  \\c plaintext_len passed to mbedtls_ccm_set_lengths().",
        " */",
        "int mbedtls_ccm_finish(mbedtls_ccm_context *ctx,",
        "                       unsigned char *tag, size_t tag_len);",
