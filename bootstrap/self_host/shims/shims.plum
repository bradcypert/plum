        " * \\return      NULL if not found, or a pointer to the existing entry.",
        " */",
        "const mbedtls_asn1_named_data *mbedtls_asn1_find_named_data(const mbedtls_asn1_named_data *list,",
        "                                                            const char *oid, size_t len);",
        "",
