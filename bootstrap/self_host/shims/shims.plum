        "                                     test_nonces[i],",
        "                                     test_counters[i],",
        "                                     test_lengths[i],",
        "                                     test_input[i],",
        "                                     output);",
        "",
        "        ASSERT(0 == ret, (\"error code: %i\\n\", ret));",
        "",
        "        ASSERT(0 == memcmp(output, test_output[i], test_lengths[i]),",
        "               (\"failed (output)\\n\"));",
        "",
        "        if (verbose != 0) {",
        "            mbedtls_printf(\"passed\\n\");",
        "        }",
        "    }",
        "",
        "    if (verbose != 0) {",
        "        mbedtls_printf(\"\\n\");",
        "    }",
        "",
        "    return 0;",
        "}",
