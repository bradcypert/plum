        "    ((void) buf_len);",
        "    return -1;",
        "}",
        "",
        "#define MBEDTLS_PLATFORM_STD_NV_SEED_READ   platform_nv_seed_read_uninit",
        "#endif /* !MBEDTLS_PLATFORM_STD_NV_SEED_READ */",
