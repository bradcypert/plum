        "        session, MBEDTLS_SSL_TLS1_3_TICKET_ALLOW_PSK_RESUMPTION);",
        "}",
        "",
        "static inline int mbedtls_ssl_tls13_session_ticket_allow_psk_ephemeral(",
        "    mbedtls_ssl_session *session)",
        "{",
