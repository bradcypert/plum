        "}",
        "",
        "void mbedtls_ssl_set_timer_cb(mbedtls_ssl_context *ssl,",
        "                              void *p_timer,",
        "                              mbedtls_ssl_set_timer_t *f_set_timer,",
        "                              mbedtls_ssl_get_timer_t *f_get_timer)",
        "{",
        "    ssl->p_timer        = p_timer;",
        "    ssl->f_set_timer    = f_set_timer;",
        "    ssl->f_get_timer    = f_get_timer;",
        "",
