        "    MBEDTLS_BLOCK_CIPHER_ID_NONE = 0,  /**< Unset. */",
        "    MBEDTLS_BLOCK_CIPHER_ID_AES,       /**< The AES cipher. */",
        "    MBEDTLS_BLOCK_CIPHER_ID_CAMELLIA,  /**< The Camellia cipher. */",
        "    MBEDTLS_BLOCK_CIPHER_ID_ARIA,      /**< The Aria cipher. */",
        "} mbedtls_block_cipher_id_t;",
        "",
