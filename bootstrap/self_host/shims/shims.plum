        "        OID_DESCRIPTOR(MBEDTLS_OID_HMAC_RIPEMD160,    \"hmacRIPEMD160\",    \"HMAC-RIPEMD160\"),",
        "        MBEDTLS_MD_RIPEMD160,",
        "    },",
        "#endif /* MBEDTLS_MD_CAN_RIPEMD160 */",
