        " *                  context.",
        " *",
        " * \\return          \\c 0 on success.",
        " * \\return          #MBEDTLS_ERR_MD_BAD_INPUT_DATA on parameter-verification",
        " *                  failure.",
        " */",
        "MBEDTLS_CHECK_RETURN_TYPICAL",
        "int mbedtls_md_hmac_reset(mbedtls_md_context_t *ctx);",
