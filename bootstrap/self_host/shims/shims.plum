        " */",
        "psa_status_t mbedtls_psa_cipher_encrypt(const psa_key_attributes_t *attributes,",
        "                                        const uint8_t *key_buffer,",
        "                                        size_t key_buffer_size,",
        "                                        psa_algorithm_t alg,",
        "                                        const uint8_t *iv,",
