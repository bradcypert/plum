        "#define mbedtls_time    MBEDTLS_PLATFORM_TIME_MACRO",
        "#else",
        "#define mbedtls_time   time",
        "#endif /* MBEDTLS_PLATFORM_TIME_MACRO */",
        "#endif /* MBEDTLS_PLATFORM_TIME_ALT */",
        "",
        "#ifdef __cplusplus",
        "}",
        "#endif",
        "",
        "#endif /* platform_time.h */",
        "",
