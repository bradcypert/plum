    ShimFile {
        name: "mbedtls/library/pem.c",
        compile: true,
        source: join_lines([
        "/*",
        " *  Privacy Enhanced Mail (PEM) decoding",
        " *",
        " *  Copyright The Mbed TLS Contributors",
        " *  SPDX-License-Identifier: Apache-2.0 OR GPL-2.0-or-later",
