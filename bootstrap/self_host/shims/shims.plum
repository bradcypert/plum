        " */",
        "mbedtls_ssl_cookie_check_t mbedtls_ssl_cookie_check;",
        "",
        "#ifdef __cplusplus",
        "}",
        "#endif",
        "",
        "#endif /* ssl_cookie.h */",
        "",
        ]),
