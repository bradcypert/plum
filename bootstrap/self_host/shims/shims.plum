        "#endif /* !MBEDTLS_AES_ONLY_128_BIT_KEY_LENGTH */",
        "#endif /* MBEDTLS_AES_C */",
        "",
        "#if defined(MBEDTLS_DES_C)",
        "/* Truncation point of message for 3DES CMAC tests  */",
        "static const unsigned int des3_message_lengths[NB_CMAC_TESTS_PER_KEY] = {",
        "    0,",
        "    16,",
        "    20,",
