        "        case MBEDTLS_KEY_EXCHANGE_DHE_PSK:",
        "        case MBEDTLS_KEY_EXCHANGE_ECDHE_PSK:",
        "            return 1;",
        "",
        "        default:",
        "            return 0;",
        "    }",
        "}",
        "#endif /* MBEDTLS_KEY_EXCHANGE_SOME_PSK_ENABLED */",
        "",
        "#endif /* MBEDTLS_SSL_TLS_C */",
