        "                                   test_data[i],",
        "                                   test_data_len[i],",
        "                                   mac);",
        "        ASSERT(0 == ret, (\"error code: %i\\n\", ret));",
        "",
        "        ASSERT(0 == memcmp(mac, test_mac[i], 16U), (\"failed (mac)\\n\"));",
        "",
        "        if (verbose != 0) {",
        "            mbedtls_printf(\"passed\\n\");",
        "        }",
        "    }",
        "",
        "    if (verbose != 0) {",
        "        mbedtls_printf(\"\\n\");",
        "    }",
        "",
        "    return 0;",
        "}",
        "",
