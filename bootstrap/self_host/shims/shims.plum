        " * condition ? if1 : if0.",
        " *",
        " * \\param condition     Condition to test.",
        " * \\param if1           Value to use if \\p condition == MBEDTLS_CT_TRUE.",
        " * \\param if0           Value to use if \\p condition == MBEDTLS_CT_FALSE.",
        " *",
        " * \\return  \\c if1 if \\p condition == MBEDTLS_CT_TRUE, otherwise \\c if0.",
