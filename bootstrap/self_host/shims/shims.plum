        "    if ((n = fwrite(buf, 1, buf_len, file)) != buf_len) {",
        "        fclose(file);",
        "        return -1;",
        "    }",
        "",
        "    fclose(file);",
        "    return (int) n;",
        "}",
        "#endif /* MBEDTLS_PLATFORM_NO_STD_FUNCTIONS */",
        "",
        "#if defined(MBEDTLS_PLATFORM_NV_SEED_ALT)",
        "#if !defined(MBEDTLS_PLATFORM_STD_NV_SEED_READ)",
