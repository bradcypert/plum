use lsp;

// A check observes the whole project, including its live dependency buffers.
// Keep only its latest result, never a snapshot, source text, or edit history.
// Separate projects may report on the same dependency URI: their publications
// must be combined before replacing that URI's editor diagnostics.
struct LspDiagnostics { roots: Array[String], target: String, items: Array[JsonValue] }
let LSP_DIAGNOSTICS: Ref[Map[String, LspDiagnostics]] = ref(empty_lsp_diagnostics(()))
let empty_lsp_diagnostics (): Map[String, LspDiagnostics] = Map.new(())

let lsp_publish_target (uri: String): Unit = {
    let mut items = [];
    let results = LSP_DIAGNOSTICS.get();
    for project in Array.sort_string(Map.keys(results)) {
        match Map.get(results, project) {
            Some(result) => if result.target == uri {
                for item in result.items {
                    if !Array.contains(items, item) { items = items.push(item); () };
                };
            },
            None => (),
        };
    };
    if uri == "" { () } else { lsp_send(lsp.publish_message(uri, items)) }
}

let lsp_replace_diagnostics (project: String) (result: LspDiagnostics): Unit = {
    let previous = Map.get(LSP_DIAGNOSTICS.get(), project);
    LSP_DIAGNOSTICS.set(Map.insert(LSP_DIAGNOSTICS.get(), project, result));
    match previous {
        Some(old) => if old.target != result.target { lsp_publish_target(old.target) },
        None => (),
    };
    lsp_publish_target(result.target)
}

let lsp_remove_diagnostics (project: String): Unit = {
    let previous = Map.get(LSP_DIAGNOSTICS.get(), project);
    let remaining = Map.remove(LSP_DIAGNOSTICS.get(), project);
    // Map.remove keeps bucket capacity; release it after the final project.
    LSP_DIAGNOSTICS.set(if Map.len(remaining) == 0 { empty_lsp_diagnostics(()) } else { remaining });
    match previous { Some(old) => lsp_publish_target(old.target), None => () }
}

// Called after removing the closed buffer. Its disk contents replace the
// overlay in every affected project, including consumers of a dependency.
// Recheck through a remaining open document; retire projects with none left.
let lsp_close_diagnostics (uri: String): Unit = {
    let path = lsp.uri_to_path(uri);
    let results = LSP_DIAGNOSTICS.get();
    for project in Array.sort_string(Map.keys(results)) {
        match Map.get(results, project) {
            None => (),
            Some(result) => {
                let affected = Array.any(result.roots, |root| Option.is_some(source_relative_option(root, path)));
                if affected {
                    let candidates = Array.filter(Map.keys(BUFFERS.get()), |open_uri| Option.is_some(source_relative_option(project, lsp.uri_to_path(open_uri))));
                    lsp_remove_diagnostics(project);
                    if candidates.len() > 0 { lsp_diagnose_document(Array.sort_string(candidates)[0]) };
                };
            },
        };
    };
    // Preserve other projects' reports when the closed URI is their target.
    lsp_publish_target(uri)
}
