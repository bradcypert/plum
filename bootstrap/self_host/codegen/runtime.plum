// Stage 5's RUNTIME — the fixed block of LLVM IR every program this
// backend emits is prefixed with. See `codegen.plum`'s own top comment
// for the backend as a whole.
//
// This is deliberately OURS, not borrowed from the real compiler.
// `crates/plum-codegen`'s runtime is ~3,000 lines and is parameterized
// by the program's own tag tables (it generates per-type `to_string`/
// equality/release functions), so there is no clean "just link against
// it" boundary to reuse — and writing this one is a few dozen lines,
// because Stage 5 leaks.
//
// **Stage 5 never frees.** No refcount word, no `plum_rc_inc`/`dec`, no
// FBIP. That is the single biggest simplification versus the real
// backend (3,293 lines of `plum-ir/src/fbip.rs`), and it is a legitimate
// choice for a bootstrap compiler: the workload is "start, compile one
// program, exit," where the OS reclaims everything at once. It is a
// scope cut, stated up front, not an oversight — and it is the first
// thing that would have to change for this backend to be used for
// long-running programs.
//
// **Cell layouts** (deliberately NOT the real backend's — those carry a
// refcount word this one has no use for):
//   Str:    { i64 len, i8 bytes[len], i8 0 }   — data at offset 8
//   Struct: { field0, field1, ... }            — 8 bytes per field
//   Enum:   { i64 tag, payload0, ... }         — payload at offset 8
// Every string keeps a trailing NUL that `.len()` never counts, purely
// so `printf("%s")` can be pointed straight at the bytes — the same
// trick, and the same reasoning, as the real backend's own string cells.

// One allocation, not one per line. The runtime block alone is ~1200
// lines, and folding `concat` over it copied the whole accumulated
// prefix each time.
pub let cg_lines (lines: Array[String]): String =
    Array.concat_all(cg_newline_terminate(lines, 0, []))

let cg_newline_terminate (lines: Array[String]) (i: Int) (acc: Array[String]): Array[String] =
    if i >= lines.len() { acc } else { cg_newline_terminate(lines, i + 1, acc.push(lines[i]).push("\n")) }

// The self-referential tail of `@plum_pat_safe` -- `n` copies of
// `ptr @plum_pat_safe`, comma-separated. A global is allowed to name
// itself in its own initializer, which is what makes one fixed cell
// stand in for a payload chain of unbounded depth.
let cg_pat_safe_words (n: Int) (acc: String): String =
    if n <= 0 { acc }
    else { cg_pat_safe_words(n - 1, if acc == "" { "ptr @plum_pat_safe" } else { acc.concat(", ptr @plum_pat_safe") }) }

pub let cg_runtime (unit: Unit): String = cg_lines([
    "; --- Stage 5 runtime (self-hosted backend) ---",
    "declare ptr @malloc(i64)",
    "declare i32 @printf(ptr, ...)",
    "declare i32 @snprintf(ptr, i64, ptr, ...)",
    "declare double @strtod(ptr, ptr)",
    // `getenv` is NOT declared here: the runtime already declares it
    // further down. A second `declare` of the same symbol is an LLVM
    // error, and this file has produced that collision four times
    // (memcmp, strlen, stdout_flush, process_run_inherit). Check
    // before adding.
    "declare i32 @fflush(ptr)",
    "; Case mapping goes through compat_shim.c, NOT straight to libc:",
    "; `wint_t` is 16 bits on Windows, so `i32 @towupper(i32)` was an",
    "; ABI mismatch there, and MINGW64's legacy CRT has no UTF-8 locale",
    "; for it to work in anyway.",
    "declare i32 @plum_toupper_cp(i32)",
    "declare i32 @plum_tolower_cp(i32)",
    "declare void @plum_set_utf8_locale()",
    "declare void @plum_set_binary_stdio()",
    "declare ptr @plum_host_platform()",
    "declare i32 @plum_format_g(ptr, i64, i32, double)",
    "; Checked `+`/`-`/`*` on Int -- see `cg_overflow_guard`.",
    "declare { i64, i1 } @llvm.sadd.with.overflow.i64(i64, i64)",
    "declare { i64, i1 } @llvm.ssub.with.overflow.i64(i64, i64)",
    "declare { i64, i1 } @llvm.smul.with.overflow.i64(i64, i64)",
    "declare ptr @memcpy(ptr, ptr, i64)",
    "declare i32 @memcmp(ptr, ptr, i64)",
    "declare void @exit(i32)",
    "declare void @free(ptr)",
    "declare i64 @malloc_usable_size(ptr)",
    "declare ptr @getenv(ptr)",
    "declare i32 @dprintf(i32, ptr, ...)",
    "declare i32 @atexit(ptr)",
    "",
    "; Allocation counters, dumped at exit when PLUM_RT_STATS is set.",
    "; The real backend grew the same thing (PLUM_ALLOC_STATS) and it is",
    "; what turned three guessed-at performance problems into measured",
    "; ones -- so this backend gets it before guessing rather than after.",
    "@plum_n_alloc = global i64 0",
    "@plum_n_str = global i64 0",
    "@plum_n_concat = global i64 0",
    "@plum_n_array = global i64 0",
    "@plum_b_alloc = global i64 0",
    "@.plum_stats_env = private constant [14 x i8] c\"PLUM_RT_STATS\\00\"",
    "@.plum_stats_fmt = private constant [69 x i8] c\"[plum-rt] alloc n=%lld bytes=%lld | str=%lld concat=%lld array=%lld\\0A\\00\"",
    "declare ptr @fopen(ptr, ptr)",
    "declare i64 @fread(ptr, i64, i64, ptr)",
    "declare i32 @fclose(ptr)",
    "declare i64 @fwrite(ptr, i64, i64, ptr)",
    // Already linked alongside every self-hosted binary via
    // `native_stdlib/process_shim.c` -- the same shim the real
    // compiler's own `run_process` uses. Declaring it here is all that
    // is needed to reach it.
    "declare i64 @process_run(ptr, ptr, i64)",
    "declare i64 @process_exit_code(i64)",
    "declare ptr @process_stdout_data(i64)",
    "declare ptr @process_stderr_data(i64)",
    "declare void @process_free(i64)",
    "declare i32 @fseek(ptr, i64, i32)",
    "declare i64 @ftell(ptr)",
    "declare i64 @strlen(ptr)",
    "",
    "; argc/argv, stashed by the C entry point so `args()` can reach",
    "; them. The real backend keeps the same pair of globals for the same",
    "; reason -- there is nowhere else for a process's own arguments to",
    "; live.",
    "@plum_argc = global i32 0",
    "@plum_argv = global ptr null",
    "@.plum_mode_r = private constant [3 x i8] c\"rb\\00\"",
    "@.plum_mode_w = private constant [3 x i8] c\"wb\\00\"",
    "",
    "; Directory access, via the SAME C shims the real compiler uses",
    "; (`dir_shim.c`). They are already linked into every binary `plum",
    "; compile-ir` produces, so declaring them is all it takes -- no",
    "; second copy of the platform code, and no divergence between what",
    "; the two backends mean by `list_dir`.",
    "declare i64 @dir_open(ptr)",
    "declare ptr @dir_read_next(i64)",
    "declare void @dir_close(i64)",
    "declare i64 @path_is_dir(ptr)",
    "",
    "; Filesystem and self-location, from native_stdlib/os_shim.c. These",
    "; exist so the compiler does not shell out to `mktemp`, `rm`, `cp`",
    "; and `mkdir` to do them, and does not read `/proc/self/exe` to find",
    "; itself -- none of which is portable off Linux. See that file.",
    "declare ptr @os_temp_dir()",
    "declare ptr @os_self_exe()",
    "declare i64 @os_make_dir(ptr)",
    "declare i64 @os_remove_file(ptr)",
    "declare i64 @os_remove_tree(ptr)",
    "declare i64 @os_copy_tree(ptr, ptr)",
    "",
    "; Threads and channels, from native_stdlib/thread_shim.c. The real",
    "; backend emits its own pthread calls as IR; this backend reaches",
    "; the same primitives through a shim, exactly as it does for",
    "; directories and processes.",
    "declare i64 @thread_spawn(ptr, ptr)",
    "declare ptr @thread_join(i64)",
    "declare i64 @channel_new()",
    "declare void @channel_send(i64, ptr)",
    "declare ptr @channel_recv(i64)",
    "; `select`: the arms' handles in an array, the winner's index back,",
    "; its boxed value through the out-pointer. The whole poll-and-wait",
    "; loop is in C because every payload crosses as a box, so there is",
    "; nothing type-dependent for the backend to contribute.",
    "declare i64 @channel_select(ptr, i64, ptr)",
    "; The two ends of a channel, and a task handle, are refcounted CELLS",
    "; on the Plum side. These are what the last reference dying calls:",
    "; the queue is freed when its second end goes, and an unjoined task",
    "; is detached. Both take the element's release function, because a",
    "; value can still be in flight when the handle dies.",
    "declare void @channel_release(i64, ptr)",
    "declare void @task_release(i64, ptr)",
    "",
    "; libm, for the Float functions the real prelude writes as",
    "; `unsafe { sqrt(x) }`. This backend has no `extern \"C\"`/`unsafe`",
    "; support, so they are runtime primitives here instead -- same",
    "; functions, same results, reached a different way.",
    "declare double @sqrt(double)",
    "declare double @pow(double, double)",
    "declare double @floor(double)",
    "declare double @ceil(double)",
    "declare double @round(double)",
    "; libc's RNG, matching the real NATIVE backend exactly (its own",
    "; `random_raw` is `rand()` over `RAND_MAX + 1`, seeded once from",
    "; `time(0)`). The real INTERPRETER uses splitmix64 instead, so the",
    "; two real backends already disagree on the actual numbers -- there",
    "; is no output parity to preserve here, only the distribution.",
    "declare i32 @rand()",
    "declare void @srand(i32)",
    "declare i64 @time(ptr)",
    "",
    "@.plum_fmt_int = private constant [5 x i8] c\"%lld\\00\"",
    "@.plum_fmt_line = private constant [4 x i8] c\"%s\\0A\\00\"",
    "@.plum_true = private constant [5 x i8] c\"true\\00\"",
    "@.plum_false = private constant [6 x i8] c\"false\\00\"",
    "",
    // A stand-in cell for a payload load that is about to be
    // DEREFERENCED by a nested pattern while the enclosing tag has
    // already failed to match. Over-allocation makes the payload LOAD
    // itself safe (see `cg_payload_offset`), but the word it loads is
    // another variant's data -- an integer, say -- and following it as
    // a pointer to read an inner tag is not safe at all. So a
    // mismatched load is redirected here instead (`cg_pat_payloads`).
    //
    // Word 0 is the reference count, word 1 doubles as the tag (an
    // enum), the length (a string), and the length (an array) -- all
    // zero, so an inner tag test simply fails, an inner string compare
    // sees length 0, and nothing walks off the end. Every remaining
    // word points back at this same cell, so nesting of ANY depth stays
    // in bounds rather than needing a fixed number of levels. Writable,
    // not `constant`: a stray increment through it must corrupt a dead
    // word, not fault on a read-only page.
    "@plum_pat_safe = internal global [16 x ptr] [ptr null, ptr null, ".concat(cg_pat_safe_words(14, "")).concat("]"),
    "",
    "; The one allocation point. Every cell begins with a reference",
    "; count, initialised to 1: the caller of an allocating expression",
    "; owns the result. Nothing decrements it yet -- the ownership",
    "; discipline is a separate change -- so this still leaks, but every",
    "; cell is now SHAPED for it.",
    "define void @plum_dump_stats() {",
    "entry:",
    "  %e = call ptr @getenv(ptr @.plum_stats_env)",
    "  %off = icmp eq ptr %e, null",
    "  br i1 %off, label %skip, label %dump",
    "skip:",
    "  ret void",
    "dump:",
    "  %n = load i64, ptr @plum_n_alloc",
    "  %b = load i64, ptr @plum_b_alloc",
    "  %s1 = load i64, ptr @plum_n_str",
    "  %c1 = load i64, ptr @plum_n_concat",
    "  %a1 = load i64, ptr @plum_n_array",
    "  %r = call i32 (i32, ptr, ...) @dprintf(i32 2, ptr @.plum_stats_fmt, i64 %n, i64 %b, i64 %s1, i64 %c1, i64 %a1)",
    "  ret void",
    "}",
    "",
    "define ptr @plum_alloc(i64 %size) {",
    "entry:",
    "  %pn = load i64, ptr @plum_n_alloc",
    "  %pn1 = add i64 %pn, 1",
    "  store i64 %pn1, ptr @plum_n_alloc",
    "  %pb = load i64, ptr @plum_b_alloc",
    "  %pb1 = add i64 %pb, %size",
    "  store i64 %pb1, ptr @plum_b_alloc",
    "  %cell = call ptr @malloc(i64 %size)",
    "  store i64 1, ptr %cell",
    "  ret ptr %cell",
    "}",
    "",
    "; Can this cell be recycled instead of asking malloc for a new one?",
    "; The whole of functional-but-in-place, in one predicate.",
    ";",
    "; The caller has MOVED its reference in -- the slot it came from is",
    "; nulled -- so a refcount of 1 means nobody else can see this cell",
    "; and overwriting it is unobservable. Checked at RUNTIME rather than",
    "; proved, exactly like @plum_str_concat_reuse: being wrong about it",
    "; is impossible, only useless.",
    ";",
    "; A PREDICATE rather than an allocator, because what has to happen on",
    "; each answer is type-dependent and only the backend knows it: the",
    "; reuse path drops the old cell's children, the giveup path releases",
    "; it through its own generated release function. A reused cell is",
    "; deliberately never counted in the allocation stats -- not counting",
    "; it is the measurement bootstrap/alloc-check reads.",
    "define i1 @plum_reuse_ok(ptr %v, i64 %size) {",
    "entry:",
    "  %isnull = icmp eq ptr %v, null",
    "  br i1 %isnull, label %no, label %check",
    "check:",
    "  %rc = load i64, ptr %v",
    "  %sole = icmp eq i64 %rc, 1",
    "  br i1 %sole, label %sized, label %no",
    "sized:",
    "  %usable = call i64 @malloc_usable_size(ptr %v)",
    "  %fits = icmp uge i64 %usable, %size",
    "  ret i1 %fits",
    "no:",
    "  ret i1 false",
    "}",
    "",
    "; Every inc/release is NULL-TOLERANT. Heap slots are initialised to",
    "; null so that a slot inside a loop can release its previous value",
    "; before storing a new one without the first iteration reading",
    "; uninitialised stack -- the null check is what makes that safe.",
    "define void @plum_rc_inc(ptr %p) {",
    "entry:",
    "  %isnull = icmp eq ptr %p, null",
    "  br i1 %isnull, label %skip, label %live",
    "skip:",
    "  ret void",
    "live:",
    "  %rc = load i64, ptr %p",
    "  %static = icmp slt i64 %rc, 0",
    "  br i1 %static, label %skip, label %bump",
    "bump:",
    "  %rc1 = add i64 %rc, 1",
    "  store i64 %rc1, ptr %p",
    "  ret void",
    "}",
    "",
    "; A closure cell carries a pointer to a release function generated",
    "; at its own literal's creation site, which is the only place that",
    "; knows what it captured -- a closure's captures are invisible from",
    "; its type. That companion releases the captures; this frees the",
    "; cell.",
    "define void @plum_rel_closure(ptr %p) {",
    "entry:",
    "  %isnull = icmp eq ptr %p, null",
    "  br i1 %isnull, label %skip, label %live",
    "skip:",
    "  ret void",
    "live:",
    "  %rc = load i64, ptr %p",
    "  %static = icmp slt i64 %rc, 0",
    "  br i1 %static, label %skip, label %dec",
    "dec:",
    "  %rc1 = sub i64 %rc, 1",
    "  store i64 %rc1, ptr %p",
    "  %dead = icmp sle i64 %rc1, 0",
    "  br i1 %dead, label %free, label %alive",
    "alive:",
    "  ret void",
    "free:",
    "  %relp = getelementptr i8, ptr %p, i64 16",
    "  %rel = load ptr, ptr %relp",
    "  call void %rel(ptr %p)",
    "  call void @free(ptr %p)",
    "  ret void",
    "}",
    "",
    "; A String owns nothing, so its release needs no generated",
    "; per-type function.",
    "define void @plum_rel_str(ptr %p) {",
    "entry:",
    "  %isnull = icmp eq ptr %p, null",
    "  br i1 %isnull, label %skip, label %live",
    "skip:",
    "  ret void",
    "live:",
    "  %rc = load i64, ptr %p",
    "  %static = icmp slt i64 %rc, 0",
    "  br i1 %static, label %skip, label %dec",
    "dec:",
    "  %rc1 = sub i64 %rc, 1",
    "  store i64 %rc1, ptr %p",
    "  %dead = icmp sle i64 %rc1, 0",
    "  br i1 %dead, label %free, label %alive",
    "alive:",
    "  ret void",
    "free:",
    "  call void @free(ptr %p)",
    "  ret void",
    "}",
    "",
    "; A string cell from raw bytes + a byte length.",
    "define ptr @plum_str_new(ptr %bytes, i64 %len) {",
    "entry:",
    "  %sn = load i64, ptr @plum_n_str",
    "  %sn1 = add i64 %sn, 1",
    "  store i64 %sn1, ptr @plum_n_str",
    "  %size = add i64 %len, 17",
    "  %cell = call ptr @plum_alloc(i64 %size)",
    "  %lenp = getelementptr i8, ptr %cell, i64 8",
    "  store i64 %len, ptr %lenp",
    "  %data = getelementptr i8, ptr %cell, i64 16",
    "  %ignore = call ptr @memcpy(ptr %data, ptr %bytes, i64 %len)",
    "  %endp = getelementptr i8, ptr %data, i64 %len",
    "  store i8 0, ptr %endp",
    "  ret ptr %cell",
    "}",
    "",
    "; Joins an Array[String] in ONE allocation: sum the lengths, allocate",
    "; once, memcpy each piece into place.",
    ";",
    "; The emitter used to build its output by repeated `.concat`, which",
    "; is quadratic -- appending function number N copies the N-1",
    "; already-appended ones. Compiling this compiler did 8.6 million",
    "; concatenations and allocated 3.5GB to produce 6MB of IR. This turns",
    "; the top-level accumulators linear.",
    "define ptr @plum_str_concat_all(ptr %arr) {",
    "entry:",
    "  %np = getelementptr i8, ptr %arr, i64 8",
    "  %n = load i64, ptr %np",
    "  %ip = alloca i64",
    "  %tp = alloca i64",
    "  store i64 0, ptr %ip",
    "  store i64 0, ptr %tp",
    "  br label %sum",
    "sum:",
    "  %i = load i64, ptr %ip",
    "  %more = icmp slt i64 %i, %n",
    "  br i1 %more, label %sumb, label %alloc",
    "sumb:",
    "  %soff = mul i64 %i, 8",
    "  %sp0 = getelementptr i8, ptr %arr, i64 %soff",
    "  %sp = getelementptr i8, ptr %sp0, i64 16",
    "  %se = load ptr, ptr %sp",
    "  %slp = getelementptr i8, ptr %se, i64 8",
    "  %sl = load i64, ptr %slp",
    "  %t = load i64, ptr %tp",
    "  %t2 = add i64 %t, %sl",
    "  store i64 %t2, ptr %tp",
    "  %i2 = add i64 %i, 1",
    "  store i64 %i2, ptr %ip",
    "  br label %sum",
    "alloc:",
    "  %total = load i64, ptr %tp",
    "  %size = add i64 %total, 17",
    "  %cell = call ptr @plum_alloc(i64 %size)",
    "  %ltp = getelementptr i8, ptr %cell, i64 8",
    "  store i64 %total, ptr %ltp",
    "  %data = getelementptr i8, ptr %cell, i64 16",
    "  store i64 0, ptr %ip",
    "  store i64 0, ptr %tp",
    "  br label %cp",
    "cp:",
    "  %j = load i64, ptr %ip",
    "  %more2 = icmp slt i64 %j, %n",
    "  br i1 %more2, label %cpb, label %fin",
    "cpb:",
    "  %joff = mul i64 %j, 8",
    "  %jp0 = getelementptr i8, ptr %arr, i64 %joff",
    "  %jp = getelementptr i8, ptr %jp0, i64 16",
    "  %je = load ptr, ptr %jp",
    "  %jlp = getelementptr i8, ptr %je, i64 8",
    "  %jl = load i64, ptr %jlp",
    "  %jd = getelementptr i8, ptr %je, i64 16",
    "  %w = load i64, ptr %tp",
    "  %dst = getelementptr i8, ptr %data, i64 %w",
    "  %cpr = call ptr @memcpy(ptr %dst, ptr %jd, i64 %jl)",
    "  %w2 = add i64 %w, %jl",
    "  store i64 %w2, ptr %tp",
    "  %j2 = add i64 %j, 1",
    "  store i64 %j2, ptr %ip",
    "  br label %cp",
    "fin:",
    "  %endp = getelementptr i8, ptr %data, i64 %total",
    "  store i8 0, ptr %endp",
    "  ret ptr %cell",
    "}",
    "",
    "define ptr @plum_str_concat(ptr %a, ptr %b) {",
    "entry:",
    "  %cn = load i64, ptr @plum_n_concat",
    "  %cn1 = add i64 %cn, 1",
    "  store i64 %cn1, ptr @plum_n_concat",
    "  %lap = getelementptr i8, ptr %a, i64 8",
    "  %la = load i64, ptr %lap",
    "  %lbp = getelementptr i8, ptr %b, i64 8",
    "  %lb = load i64, ptr %lbp",
    "  %lt = add i64 %la, %lb",
    "  %size = add i64 %lt, 17",
    "  %cell = call ptr @plum_alloc(i64 %size)",
    "  %ltp = getelementptr i8, ptr %cell, i64 8",
    "  store i64 %lt, ptr %ltp",
    "  %data = getelementptr i8, ptr %cell, i64 16",
    "  %da = getelementptr i8, ptr %a, i64 16",
    "  %db = getelementptr i8, ptr %b, i64 16",
    "  %i1 = call ptr @memcpy(ptr %data, ptr %da, i64 %la)",
    "  %d2 = getelementptr i8, ptr %data, i64 %la",
    "  %i2 = call ptr @memcpy(ptr %d2, ptr %db, i64 %lb)",
    "  %endp = getelementptr i8, ptr %data, i64 %lt",
    "  store i8 0, ptr %endp",
    "  ret ptr %cell",
    "}",
    "",
    "; `a.concat(b)` where `a` is provably DEAD afterwards -- emitted",
    "; only for a self-rebinding assignment (`acc = acc.concat(x)`),",
    "; where the slot is overwritten with the result and so cannot",
    "; observe a mutation.",
    ";",
    "; Two conditions, both checked at RUNTIME: the cell must be",
    "; uniquely referenced (rc == 1, which the slot's own reference",
    "; accounts for), and its allocation must have room. Capacity is",
    "; DERIVED with `malloc_usable_size` rather than stored -- the same",
    "; trick, and the same reasoning, as the real backend's own",
    "; `StrConcatReuse`: a stored capacity word would move every",
    "; string's data offset for the benefit of one operation.",
    ";",
    "; It CONSUMES %a either way. In the reuse path that is free (the",
    "; reference moves into the result); in the copy path it releases,",
    "; so the caller never has to know which happened.",
    "define ptr @plum_str_concat_reuse(ptr %a, ptr %b) {",
    "entry:",
    "  %rc = load i64, ptr %a",
    "  %uniq = icmp eq i64 %rc, 1",
    "  br i1 %uniq, label %maybe, label %copy",
    "maybe:",
    "  %lap = getelementptr i8, ptr %a, i64 8",
    "  %la = load i64, ptr %lap",
    "  %lbp = getelementptr i8, ptr %b, i64 8",
    "  %lb = load i64, ptr %lbp",
    "  %need = add i64 %la, %lb",
    "  %need17 = add i64 %need, 17",
    "  %usable = call i64 @malloc_usable_size(ptr %a)",
    "  %fits = icmp sle i64 %need17, %usable",
    "  br i1 %fits, label %inplace, label %copy",
    "inplace:",
    "  %dst0 = getelementptr i8, ptr %a, i64 16",
    "  %dst = getelementptr i8, ptr %dst0, i64 %la",
    "  %src = getelementptr i8, ptr %b, i64 16",
    "  %ig = call ptr @memcpy(ptr %dst, ptr %src, i64 %lb)",
    "  store i64 %need, ptr %lap",
    "  %endp = getelementptr i8, ptr %dst, i64 %lb",
    "  store i8 0, ptr %endp",
    "  ret ptr %a",
    "copy:",
    "  %new = call ptr @plum_str_concat(ptr %a, ptr %b)",
    "  call void @plum_rel_str(ptr %a)",
    "  ret ptr %new",
    "}",
    "",
    "define i64 @plum_str_len(ptr %s) {",
    "entry:",
    "  %lp = getelementptr i8, ptr %s, i64 8",
    "  %l = load i64, ptr %lp",
    "  ret i64 %l",
    "}",
    "",
    "; Byte-exact equality: same length, then memcmp. Not a collation",
    "; comparison -- Plum's own `==` on String is byte equality too.",
    "define i1 @plum_str_eq(ptr %a, ptr %b) {",
    "entry:",
    "  %lap = getelementptr i8, ptr %a, i64 8",
    "  %la = load i64, ptr %lap",
    "  %lbp = getelementptr i8, ptr %b, i64 8",
    "  %lb = load i64, ptr %lbp",
    "  %same_len = icmp eq i64 %la, %lb",
    "  br i1 %same_len, label %cmp, label %no",
    "cmp:",
    "  %da = getelementptr i8, ptr %a, i64 16",
    "  %db = getelementptr i8, ptr %b, i64 16",
    "  %c = call i32 @memcmp(ptr %da, ptr %db, i64 %la)",
    "  %eq = icmp eq i32 %c, 0",
    "  ret i1 %eq",
    "no:",
    "  ret i1 0",
    "}",
    "",
    "define ptr @plum_int_to_string(i64 %n) {",
    "entry:",
    "  %buf = call ptr @malloc(i64 32)",
    "  %len32 = call i32 (ptr, i64, ptr, ...) @snprintf(ptr %buf, i64 32, ptr @.plum_fmt_int, i64 %n)",
    "  %len = sext i32 %len32 to i64",
    "  %s = call ptr @plum_str_new(ptr %buf, i64 %len)",
    // `plum_str_new` COPIES the bytes into the new cell, so the
    // scratch buffer is dead the moment it returns. Leaving it
    // unfreed leaked 32 bytes per `.to_string()` call -- invisible in
    // a fixture, unbounded in a loop.
    "  call void @free(ptr %buf)",
    "  ret ptr %s",
    "}",
    "",
    "; The SHORTEST decimal rendering that reads back as the same",
    "; double: try 15 significant digits, then 16, then 17, and stop at",
    "; the first that survives a round trip through `strtod`. 17 always",
    "; suffices for an IEEE double, so the last attempt needs no check.",
    ";",
    "; `%.15g` alone was wrong, and wrong in a way that made the",
    "; language look like it was lying:",
    ";",
    ";     let sum = 0.1 + 0.2;",
    ";     println(sum.to_string())        ->  0.3",
    ";     println((sum == 0.3).to_string) ->  false",
    ";",
    "; It printed a number, then denied that number equalled itself.",
    "; The interpreter had it right all along (Rust's own `{}` for f64",
    "; is shortest-round-trip), so this closes a divergence rather than",
    "; inventing a rule -- the same shape as the division fix.",
    ";",
    "; NaN costs three `snprintf` calls rather than one, since `nan`",
    "; never compares equal to itself and so never satisfies the round",
    "; trip. The output is the same either way, and NaN is not on any",
    "; path worth optimizing.",
    "@.plum_nan_text = private constant [4 x i8] c\"nan\\00\"",
    "@.plum_fmt_s = private constant [3 x i8] c\"%s\\00\"",
    "",
    "define i64 @plum_fmt_double(double %f, ptr %buf) {",
    "entry:",
    "; `%.Ng` goes through `@plum_format_g` in compat_shim.c rather than",
    "; straight to `snprintf`, because Microsoft's CRT pads the exponent",
    "; to three digits -- `1e-006` where everything else prints `1e-06`.",
    "; Float text is compared byte for byte by the corpus, so that is a",
    "; real difference, not a cosmetic one.",
    "; NaN's SIGN BIT carries no information and is not consistent",
    "; across engines: `0.0 / 0.0` computed at RUNTIME on x86 yields a",
    "; NaN with the sign set, which glibc prints as `-nan`, while the",
    "; same expression constant-folded by LLVM yields a positive one.",
    "; Normalized here, in the real backend, and in the interpreter, so",
    "; all three agree.",
    "  %isnan = fcmp uno double %f, %f",
    "  br i1 %isnan, label %nanout, label %num",
    "nanout:",
    "  %nn = call i32 (ptr, i64, ptr, ...) @snprintf(ptr %buf, i64 64, ptr @.plum_fmt_s, ptr @.plum_nan_text)",
    "  %nr = sext i32 %nn to i64",
    "  ret i64 %nr",
    "num:",
    "  %n15 = call i32 @plum_format_g(ptr %buf, i64 64, i32 15, double %f)",
    "  %b15 = call double @strtod(ptr %buf, ptr null)",
    "  %ok15 = fcmp oeq double %b15, %f",
    "  br i1 %ok15, label %d15, label %t16",
    "d15:",
    "  %r15 = sext i32 %n15 to i64",
    "  ret i64 %r15",
    "t16:",
    "  %n16 = call i32 @plum_format_g(ptr %buf, i64 64, i32 16, double %f)",
    "  %b16 = call double @strtod(ptr %buf, ptr null)",
    "  %ok16 = fcmp oeq double %b16, %f",
    "  br i1 %ok16, label %d16, label %t17",
    "d16:",
    "  %r16 = sext i32 %n16 to i64",
    "  ret i64 %r16",
    "t17:",
    "  %n17 = call i32 @plum_format_g(ptr %buf, i64 64, i32 17, double %f)",
    "  %r17 = sext i32 %n17 to i64",
    "  ret i64 %r17",
    "}",
    "",
    "define ptr @plum_float_to_string(double %f) {",
    "entry:",
    "  %buf = call ptr @malloc(i64 64)",
    "  %len = call i64 @plum_fmt_double(double %f, ptr %buf)",
    "  %s = call ptr @plum_str_new(ptr %buf, i64 %len)",
    // `plum_str_new` COPIES the bytes into the new cell, so the
    // scratch buffer is dead the moment it returns. Leaving it
    // unfreed leaked 32 bytes per `.to_string()` call -- invisible in
    // a fixture, unbounded in a loop.
    "  call void @free(ptr %buf)",
    "  ret ptr %s",
    "}",
    "",
    "define ptr @plum_bool_to_string(i1 %b) {",
    "entry:",
    "  br i1 %b, label %t, label %f",
    "t:",
    "  %st = call ptr @plum_str_new(ptr @.plum_true, i64 4)",
    "  ret ptr %st",
    "f:",
    "  %sf = call ptr @plum_str_new(ptr @.plum_false, i64 5)",
    "  ret ptr %sf",
    "}",
    "",
    "; Array cell: { i64 len, elem0, elem1, ... } -- 8 bytes per element",
    "; regardless of the element's own width, so an element address is",
    "; 8 + 8*index with no alignment arithmetic. Same trade the struct",
    "; layout makes: space for a one-line offset rule.",
    "; An array cell whose CAPACITY may exceed its length. Only the",
    "; growth path needs this; `plum_array_new` is the exact-fit case.",
    "define ptr @plum_array_new_cap(i64 %len, i64 %cap) {",
    "entry:",
    "  %an0 = load i64, ptr @plum_n_array",
    "  %an01 = add i64 %an0, 1",
    "  store i64 %an01, ptr @plum_n_array",
    "  %bytes0 = mul i64 %cap, 8",
    "  %size0 = add i64 %bytes0, 16",
    "  %cell0 = call ptr @plum_alloc(i64 %size0)",
    "  %lenp0 = getelementptr i8, ptr %cell0, i64 8",
    "  store i64 %len, ptr %lenp0",
    "  ret ptr %cell0",
    "}",
    "",
    "define ptr @plum_array_new(i64 %len) {",
    "entry:",
    "  %an = load i64, ptr @plum_n_array",
    "  %an1 = add i64 %an, 1",
    "  store i64 %an1, ptr @plum_n_array",
    "  %bytes = mul i64 %len, 8",
    "  %size = add i64 %bytes, 16",
    "  %cell = call ptr @plum_alloc(i64 %size)",
    "  %lenp = getelementptr i8, ptr %cell, i64 8",
    "  store i64 %len, ptr %lenp",
    "  ret ptr %cell",
    "}",
    "",
    "; Copies %n ELEMENTS (not bytes) from one array cell's data region",
    "; into another's. Used by push/set, which are pure: they build a new",
    "; cell rather than mutating the old one, matching Plum's semantics.",
    "define i1 @plum_array_copy(ptr %dst, ptr %src, i64 %n) {",
    "entry:",
    "  %bytes = mul i64 %n, 8",
    "  %d = getelementptr i8, ptr %dst, i64 16",
    "  %s = getelementptr i8, ptr %src, i64 16",
    "  %i = call ptr @memcpy(ptr %d, ptr %s, i64 %bytes)",
    "  ret i1 0",
    "}",
    "",
    "; Increments the first %n element slots. `push`/`set` build a new",
    "; cell and `memcpy` the old elements into it -- which copies",
    "; POINTERS, so both arrays now reference the same children and both",
    "; will release them. The copy needs its own references.",
    "define i1 @plum_array_inc_elems(ptr %a, i64 %n) {",
    "entry:",
    "  %ip = alloca i64",
    "  store i64 0, ptr %ip",
    "  br label %loop",
    "loop:",
    "  %i = load i64, ptr %ip",
    "  %more = icmp slt i64 %i, %n",
    "  br i1 %more, label %body, label %done",
    "body:",
    "  %off = mul i64 %i, 8",
    "  %ep0 = getelementptr i8, ptr %a, i64 %off",
    "  %ep = getelementptr i8, ptr %ep0, i64 16",
    "  %ev = load ptr, ptr %ep",
    "  call void @plum_rc_inc(ptr %ev)",
    "  %i1 = add i64 %i, 1",
    "  store i64 %i1, ptr %ip",
    "  br label %loop",
    "done:",
    "  ret i1 0",
    "}",
    "",
    "; `Array.concat` as a single allocation. The prelude's version is",
    "; `array_concat_acc(a.push(b[i]), b, i + 1)` -- one `push` per",
    "; element, and every `push` copies the whole array, so concatenating",
    "; an n-element array costs O(n^2) BYTES. That shape has caused three",
    "; separate blowups in this project already.",
    ";",
    "; Two variants because the elements' ownership differs: a result",
    "; holding heap elements needs its own reference to each, and one",
    "; holding Ints must not touch them. The call site picks by the",
    "; instantiated type argument -- see `cg_fn_call`.",
    "define ptr @plum_array_concat(ptr %a, ptr %b) {",
    "entry:",
    "  %lap = getelementptr i8, ptr %a, i64 8",
    "  %la = load i64, ptr %lap",
    "  %lbp = getelementptr i8, ptr %b, i64 8",
    "  %lb = load i64, ptr %lbp",
    "  %lt = add i64 %la, %lb",
    "  %out = call ptr @plum_array_new(i64 %lt)",
    "  %i1 = call i1 @plum_array_copy(ptr %out, ptr %a, i64 %la)",
    "  %aoff = mul i64 %la, 8",
    "  %d0 = getelementptr i8, ptr %out, i64 16",
    "  %d = getelementptr i8, ptr %d0, i64 %aoff",
    "  %s = getelementptr i8, ptr %b, i64 16",
    "  %bbytes = mul i64 %lb, 8",
    "  %i2 = call ptr @memcpy(ptr %d, ptr %s, i64 %bbytes)",
    "  ret ptr %out",
    "}",
    "",
    "define ptr @plum_array_concat_heap(ptr %a, ptr %b) {",
    "entry:",
    "  %out = call ptr @plum_array_concat(ptr %a, ptr %b)",
    "  %lt = call i64 @plum_array_len(ptr %out)",
    "  %ig = call i1 @plum_array_inc_elems(ptr %out, i64 %lt)",
    "  ret ptr %out",
    "}",
    "",
    "; Makes room for ONE more element in an array that is provably dead",
    "; afterwards -- emitted only for `acc = acc.push(x)`, where the slot",
    "; is overwritten with the result and so cannot observe a mutation.",
    ";",
    "; Same two runtime conditions as the string version: uniquely",
    "; referenced, and the allocation has room. Capacity is DERIVED with",
    "; `malloc_usable_size`, so growing in place happens exactly when",
    "; malloc already handed us the space -- no capacity word, and no",
    "; growth policy of our own.",
    ";",
    "; `%heap` says whether the elements are themselves counted; on the",
    "; COPY path they gain a reference each, on the reuse path nothing",
    "; moves. The caller cannot make that choice because it does not know",
    "; which path ran.",
    ";",
    "; It CONSUMES %a either way, and returns a cell whose length has",
    "; already been bumped -- the caller stores the new element at the",
    "; last index.",
    "define ptr @plum_array_push_grow(ptr %a, i1 %heap, ptr %rel) {",
    "entry:",
    "  %rc = load i64, ptr %a",
    "  %uniq = icmp eq i64 %rc, 1",
    "  br i1 %uniq, label %maybe, label %copy",
    "maybe:",
    "  %lp = getelementptr i8, ptr %a, i64 8",
    "  %len = load i64, ptr %lp",
    "  %newlen = add i64 %len, 1",
    "  %need = mul i64 %newlen, 8",
    "  %need16 = add i64 %need, 16",
    "  %usable = call i64 @malloc_usable_size(ptr %a)",
    "  %fits = icmp sle i64 %need16, %usable",
    "  br i1 %fits, label %inplace, label %copy",
    "inplace:",
    "  store i64 %newlen, ptr %lp",
    "  ret ptr %a",
    "copy:",
    "  %clp = getelementptr i8, ptr %a, i64 8",
    "  %clen = load i64, ptr %clp",
    "  %cnew = add i64 %clen, 1",
    "  ; DOUBLE, so the next pushes hit the in-place path and the whole",
    "  ; accumulation is amortized O(1) rather than accidentally so. The",
    "  ; extra space is invisible: `len` is still the true element count,",
    "  ; and capacity is whatever malloc_usable_size reports.",
    "  %dbl = mul i64 %cnew, 2",
    "  %out = call ptr @plum_array_new_cap(i64 %cnew, i64 %dbl)",
    "  %ig = call i1 @plum_array_copy(ptr %out, ptr %a, i64 %clen)",
    "  br i1 %heap, label %bump, label %release",
    "bump:",
    "  %ig2 = call i1 @plum_array_inc_elems(ptr %out, i64 %clen)",
    "  br label %release",
    "release:",
    "  ; The old array was consumed. Its release function is passed in",
    "  ; because the runtime cannot name it: it depends on the element",
    "  ; type. Forgetting this leaked every intermediate array and cost",
    "  ; 3.1GB of peak RSS.",
    "  call void %rel(ptr %a)",
    "  ret ptr %out",
    "}",
    "",
    "; Empty a dead array cell: release every element it holds, then set",
    "; its length to 0, so the cell can be recycled -- or freed -- without",
    "; its children being released a second time. The element release",
    "; function is passed in because the runtime cannot name it, the same",
    "; reason `@plum_array_push_grow` takes one.",
    ";",
    "; Null-safe: a `let` slot that has not been written yet is the",
    "; ordinary first-iteration case, not an error.",
    "define void @plum_array_clear(ptr %a, ptr %rel) {",
    "entry:",
    "  %ip = alloca i64",
    "  %isnull = icmp eq ptr %a, null",
    "  br i1 %isnull, label %done, label %go",
    "go:",
    "  %lp = getelementptr i8, ptr %a, i64 8",
    "  %len = load i64, ptr %lp",
    "  store i64 0, ptr %ip",
    "  br label %loop",
    "loop:",
    "  %i = load i64, ptr %ip",
    "  %more = icmp slt i64 %i, %len",
    "  br i1 %more, label %body, label %fin",
    "body:",
    "  %off = mul i64 %i, 8",
    "  %b = getelementptr i8, ptr %a, i64 %off",
    "  %ep = getelementptr i8, ptr %b, i64 16",
    "  %el = load ptr, ptr %ep",
    "  call void %rel(ptr %el)",
    "  %inext = add i64 %i, 1",
    "  store i64 %inext, ptr %ip",
    "  br label %loop",
    "fin:",
    "  store i64 0, ptr %lp",
    "  br label %done",
    "done:",
    "  ret void",
    "}",
    "",
    "; Recycle a dead array cell for a same-length result, or allocate.",
    "; The caller MOVED its reference in, so rc == 1 means nobody else can",
    "; see the cell.",
    ";",
    "; This does NOT release the source when it declines, and that is not",
    "; an oversight: the caller goes on to READ the source in the loop",
    "; that fills the result. Releasing here would hand back a fresh array",
    "; and free the memory the loop is about to read. The caller compares",
    "; the returned pointer against the one it passed and releases the",
    "; source only when they differ.",
    ";",
    "; The elements are the CALLER's business, not this function's. When",
    "; they need releasing the caller's loop drops the source's reference",
    "; to each one as it goes -- but only when this returned the same",
    "; pointer, because only then is the caller the sole owner.",
    "define ptr @plum_array_reuse(ptr %a, i64 %len) {",
    "entry:",
    "  %isnull = icmp eq ptr %a, null",
    "  br i1 %isnull, label %fresh, label %check",
    "check:",
    "  %rc = load i64, ptr %a",
    "  %sole = icmp eq i64 %rc, 1",
    "  br i1 %sole, label %sized, label %fresh",
    "sized:",
    "  %bytes = mul i64 %len, 8",
    "  %want = add i64 %bytes, 16",
    "  %usable = call i64 @malloc_usable_size(ptr %a)",
    "  %fits = icmp uge i64 %usable, %want",
    "  br i1 %fits, label %reuse, label %fresh",
    "reuse:",
    "  %lenp = getelementptr i8, ptr %a, i64 8",
    "  store i64 %len, ptr %lenp",
    "  ret ptr %a",
    "fresh:",
    "  %new = call ptr @plum_array_new(i64 %len)",
    "  ret ptr %new",
    "}",
    "",
    "define i64 @plum_array_len(ptr %a) {",
    "entry:",
    "  %lp = getelementptr i8, ptr %a, i64 8",
    "  %l = load i64, ptr %lp",
    "  ret i64 %l",
    "}",
    "",
    "; `chars_of(s)` -- one single-codepoint String per UTF-8 codepoint.",
    ";",
    "; A PRIMITIVE, not prelude Plum, because it is where codepoint",
    "; awareness has to live: the real compiler spells it `s.split(\"\")`",
    "; and gets the same behaviour from its own split primitive. Every",
    "; other string routine in the prelude (`String.slice`,",
    "; `String.index_of`, `String.parse_int`, ...) is built on top of",
    "; this, so getting it right here is what makes all of them",
    "; multi-byte-safe rather than each needing its own care.",
    ";",
    "; A continuation byte is `10xxxxxx`; anything else starts a",
    "; codepoint. The output array is allocated at the BYTE length (an",
    "; upper bound on the codepoint count) and its length header patched",
    "; down afterwards -- the same over-allocate-and-shrink shape",
    "; `Array.filter` uses.",
    "define ptr @plum_chars_of(ptr %s) {",
    "entry:",
    "  %lenp = getelementptr i8, ptr %s, i64 8",
    "  %len = load i64, ptr %lenp",
    "  %data = getelementptr i8, ptr %s, i64 16",
    "  %out = call ptr @plum_array_new(i64 %len)",
    "  %ip = alloca i64",
    "  %np = alloca i64",
    "  store i64 0, ptr %ip",
    "  store i64 0, ptr %np",
    "  br label %outer",
    "outer:",
    "  %i = load i64, ptr %ip",
    "  %more = icmp slt i64 %i, %len",
    "  br i1 %more, label %chstart, label %done",
    "chstart:",
    "  %start = load i64, ptr %ip",
    "  %i1 = add i64 %start, 1",
    "  store i64 %i1, ptr %ip",
    "  br label %cont",
    "cont:",
    "  %j = load i64, ptr %ip",
    "  %inrange = icmp slt i64 %j, %len",
    "  br i1 %inrange, label %checkbyte, label %emit",
    "checkbyte:",
    "  %bp = getelementptr i8, ptr %data, i64 %j",
    "  %b = load i8, ptr %bp",
    "  %masked = and i8 %b, -64",
    "  %iscont = icmp eq i8 %masked, -128",
    "  br i1 %iscont, label %advance, label %emit",
    "advance:",
    "  %j1 = add i64 %j, 1",
    "  store i64 %j1, ptr %ip",
    "  br label %cont",
    "emit:",
    "  %end = load i64, ptr %ip",
    "  %clen = sub i64 %end, %start",
    "  %cstart = getelementptr i8, ptr %data, i64 %start",
    "  %ch = call ptr @plum_str_new(ptr %cstart, i64 %clen)",
    "  %n = load i64, ptr %np",
    "  %noff = mul i64 %n, 8",
    "  %slot0 = getelementptr i8, ptr %out, i64 %noff",
    "  %slot = getelementptr i8, ptr %slot0, i64 16",
    "  store ptr %ch, ptr %slot",
    "  %n1 = add i64 %n, 1",
    "  store i64 %n1, ptr %np",
    "  br label %outer",
    "done:",
    "  %final = load i64, ptr %np",
    "  %outlen = getelementptr i8, ptr %out, i64 8",
    "  store i64 %final, ptr %outlen",
    "  ret ptr %out",
    "}",
    "",
    "; `panic_raw` is a hard process abort, matching the real backend",
    "; (`@plum_abort`: print then `exit(1)`) rather than the",
    "; interpreter's catchable error. The message goes to stdout, which",
    "; is where the real one puts it too, so a panicking program's output",
    "; compares byte-for-byte across both backends.",
    "define i1 @plum_panic(ptr %s) {",
    "entry:",
    "  %d = getelementptr i8, ptr %s, i64 16",
    "  %r = call i32 (ptr, ...) @printf(ptr @.plum_fmt_line, ptr %d)",
    "  call void @exit(i32 1)",
    "  ret i1 0",
    "}",
    "",
    "; `args()` -- the process arguments AFTER the program name,",
    "; matching the real `args()` exactly (which is why the loop starts",
    "; at 1). Each is copied into a Plum string cell rather than",
    "; aliasing the C one, since a Plum string is length-prefixed.",
    "define ptr @plum_args() {",
    "entry:",
    "  %argc32 = load i32, ptr @plum_argc",
    "  %argc = sext i32 %argc32 to i64",
    "  %argv = load ptr, ptr @plum_argv",
    "  %n = sub i64 %argc, 1",
    "  %neg = icmp slt i64 %n, 0",
    "  %count = select i1 %neg, i64 0, i64 %n",
    "  %out = call ptr @plum_array_new(i64 %count)",
    "  %ip = alloca i64",
    "  store i64 0, ptr %ip",
    "  br label %loop",
    "loop:",
    "  %i = load i64, ptr %ip",
    "  %more = icmp slt i64 %i, %count",
    "  br i1 %more, label %body, label %done",
    "body:",
    "  %ai = add i64 %i, 1",
    "  %aoff = mul i64 %ai, 8",
    "  %ap = getelementptr i8, ptr %argv, i64 %aoff",
    "  %cstr = load ptr, ptr %ap",
    "  %clen = call i64 @strlen(ptr %cstr)",
    "  %cell = call ptr @plum_str_new(ptr %cstr, i64 %clen)",
    "  %ooff = mul i64 %i, 8",
    "  %op0 = getelementptr i8, ptr %out, i64 %ooff",
    "  %op = getelementptr i8, ptr %op0, i64 16",
    "  store ptr %cell, ptr %op",
    "  %i1 = add i64 %i, 1",
    "  store i64 %i1, ptr %ip",
    "  br label %loop",
    "done:",
    "  ret ptr %out",
    "}",
    "",
    "; `read_file_raw` returns an ARRAY: empty on failure, one element",
    "; holding the contents on success.",
    ";",
    "; It does NOT return a `Result` directly, deliberately. A `Result`",
    "; is an ordinary enum whose tag numbers are assigned per program by",
    "; the backend, so hand-written runtime IR cannot construct one",
    "; without hard-coding a layout decision made elsewhere. Returning a",
    "; plain array lets the PRELUDE wrap it in Plum, where `Ok`/`Err`",
    "; mean what the program says they mean.",
    "; Writes a whole string to a path. Returns 1 on success, 0 on",
    "; failure -- the prelude wraps that into a `Result`, the same way",
    "; `read_file_raw`'s array-of-0-or-1 is wrapped, and for the same",
    "; reason: hand-written IR cannot build a Result without hard-coding",
    "; the tag numbers the backend assigns per program.",
    "; FNV-1a, byte for byte the same algorithm BOTH real backends",
    "; implement (`plum_interp::fnv1a_hash` and codegen's own hash",
    "; loop). Matching them is not optional: `Map`'s bucket index is",
    "; `hash % bucket_count`, so `Map.keys` enumerates in hash order --",
    "; a different hash here would mean the two compilers printed the",
    "; same map in different orders, and the example sweep compares",
    "; output byte for byte.",
    "; -3750763034362895579 is the 64-bit offset basis 0xcbf29ce484222325",
    "; as a signed i64; 1099511628211 is the FNV prime 0x100000001b3.",
    "; The final mask clears the SIGN bit (`& i64::MAX`), which is not",
    "; decoration: `Map` indexes with `hash % bucket_count`, and a",
    "; negative hash would index out of bounds. Leaving it off produced",
    "; hashes that disagreed with the real compiler on every input --",
    "; caught immediately, because `String.hash(\"\")` is the offset",
    "; basis only if you forget the mask.",
    "define i64 @plum_str_hash_raw(ptr %s) {",
    "entry:",
    "  %lp = getelementptr i8, ptr %s, i64 8",
    "  %len = load i64, ptr %lp",
    "  %d = getelementptr i8, ptr %s, i64 16",
    "  %ip = alloca i64",
    "  %hp = alloca i64",
    "  store i64 0, ptr %ip",
    "  store i64 -3750763034362895579, ptr %hp",
    "  br label %hcond",
    "hcond:",
    "  %i = load i64, ptr %ip",
    "  %more = icmp slt i64 %i, %len",
    "  br i1 %more, label %hbody, label %hdone",
    "hbody:",
    "  %bp = getelementptr i8, ptr %d, i64 %i",
    "  %b = load i8, ptr %bp",
    "  %be = zext i8 %b to i64",
    "  %h = load i64, ptr %hp",
    "  %x = xor i64 %h, %be",
    "  %m = mul i64 %x, 1099511628211",
    "  store i64 %m, ptr %hp",
    "  %i1 = add i64 %i, 1",
    "  store i64 %i1, ptr %ip",
    "  br label %hcond",
    "hdone:",
    "  %r = load i64, ptr %hp",
    "  %masked = and i64 %r, 9223372036854775807",
    "  ret i64 %masked",
    "}",
    "",
    "; `xs.remove(i)` -- a NEW array with element `i` dropped; the",
    "; source is untouched, like every other array operation here.",
    "; Copies word by word around the hole rather than memcpy'ing two",
    "; ranges: the element count is small in every use this backend has",
    "; (hash-map buckets), and one loop is easier to see is correct.",
    "define ptr @plum_array_remove(ptr %a, i64 %idx) {",
    "entry:",
    "  %lp = getelementptr i8, ptr %a, i64 8",
    "  %len = load i64, ptr %lp",
    "  %nlen = sub i64 %len, 1",
    "  %out = call ptr @plum_array_new(i64 %nlen)",
    "  %jp = alloca i64",
    "  %kp = alloca i64",
    "  store i64 0, ptr %jp",
    "  store i64 0, ptr %kp",
    "  br label %rcond",
    "rcond:",
    "  %j = load i64, ptr %jp",
    "  %more = icmp slt i64 %j, %len",
    "  br i1 %more, label %rbody, label %rdone",
    "rbody:",
    "  %skip = icmp eq i64 %j, %idx",
    "  br i1 %skip, label %rnext, label %rcopy",
    "rcopy:",
    "  %soff = mul i64 %j, 8",
    "  %sp0 = getelementptr i8, ptr %a, i64 %soff",
    "  %sp = getelementptr i8, ptr %sp0, i64 16",
    "  %val = load ptr, ptr %sp",
    "  %k = load i64, ptr %kp",
    "  %doff = mul i64 %k, 8",
    "  %dp0 = getelementptr i8, ptr %out, i64 %doff",
    "  %dp = getelementptr i8, ptr %dp0, i64 16",
    "  store ptr %val, ptr %dp",
    "  %k1 = add i64 %k, 1",
    "  store i64 %k1, ptr %kp",
    "  br label %rnext",
    "rnext:",
    "  %j1 = add i64 %j, 1",
    "  store i64 %j1, ptr %jp",
    "  br label %rcond",
    "rdone:",
    "  ret ptr %out",
    "}",
    "",
    "define double @plum_sqrt_raw(double %x) {",
    "entry:",
    "  %r = call double @sqrt(double %x)",
    "  ret double %r",
    "}",
    "",
    "define double @plum_pow_raw(double %b, double %e) {",
    "entry:",
    "  %r = call double @pow(double %b, double %e)",
    "  ret double %r",
    "}",
    "",
    "define double @plum_floor_raw(double %x) {",
    "entry:",
    "  %r = call double @floor(double %x)",
    "  ret double %r",
    "}",
    "",
    "define double @plum_ceil_raw(double %x) {",
    "entry:",
    "  %r = call double @ceil(double %x)",
    "  ret double %r",
    "}",
    "",
    "define double @plum_round_raw(double %x) {",
    "entry:",
    "  %r = call double @round(double %x)",
    "  ret double %r",
    "}",
    "",
    "; `2147483648.0` is RAND_MAX + 1 as glibc defines it -- the same",
    "; glibc-specific constant, and the same documented Linux-first",
    "; scope, the real backend uses.",
    "define double @plum_random_raw(i1 %ignored) {",
    "entry:",
    "  %r = call i32 @rand()",
    "  %f = sitofp i32 %r to double",
    "  %d = fdiv double %f, 2147483648.0",
    "  ret double %d",
    "}",
    "",
    "; Byte-lexicographic string comparison, which for UTF-8 is exactly",
    "; CODEPOINT order -- that equivalence is a designed property of the",
    "; encoding. The real prelude gets the same ordering by decoding to",
    "; runes first (`a.runes()`); this reaches it without a decoder.",
    "; Returns <0, 0 or >0 like `memcmp`, comparing the shared prefix",
    "; first and falling back to length, so \"ab\" < \"abc\".",
    "define i64 @plum_str_cmp_raw(ptr %a, ptr %b) {",
    "entry:",
    "  %lap = getelementptr i8, ptr %a, i64 8",
    "  %la = load i64, ptr %lap",
    "  %lbp = getelementptr i8, ptr %b, i64 8",
    "  %lb = load i64, ptr %lbp",
    "  %alt = icmp slt i64 %la, %lb",
    "  %min = select i1 %alt, i64 %la, i64 %lb",
    "  %da = getelementptr i8, ptr %a, i64 16",
    "  %db = getelementptr i8, ptr %b, i64 16",
    "  %c = call i32 @memcmp(ptr %da, ptr %db, i64 %min)",
    "  %c64 = sext i32 %c to i64",
    "  %eq = icmp eq i64 %c64, 0",
    "  br i1 %eq, label %bylen, label %done",
    "bylen:",
    "  %diff = sub i64 %la, %lb",
    "  ret i64 %diff",
    "done:",
    "  ret i64 %c64",
    "}",
    "",
    "; `c.as_string()` -- COPIES the C bytes into a fresh Plum cell.",
    "; Copying is the point: what C returned may be a static buffer, a",
    "; stack temporary, or freed on the next call, none of which a",
    "; refcounted Plum string can borrow from safely.",
    "define ptr @plum_cstr_to_string(ptr %c) {",
    "entry:",
    "  %n = call i64 @strlen(ptr %c)",
    "  %s = call ptr @plum_str_new(ptr %c, i64 %n)",
    "  ret ptr %s",
    "}",
    "",
    "define i1 @plum_write_file_raw(ptr %path, ptr %contents) {",
    "entry:",
    "  %pd = getelementptr i8, ptr %path, i64 16",
    "  %f = call ptr @fopen(ptr %pd, ptr @.plum_mode_w)",
    "  %bad = icmp eq ptr %f, null",
    "  br i1 %bad, label %fail, label %open",
    "open:",
    "  %lp = getelementptr i8, ptr %contents, i64 8",
    "  %len = load i64, ptr %lp",
    "  %cd = getelementptr i8, ptr %contents, i64 16",
    "  %wrote = call i64 @fwrite(ptr %cd, i64 1, i64 %len, ptr %f)",
    "  %closed = call i32 @fclose(ptr %f)",
    "  %ok = icmp eq i64 %wrote, %len",
    "  ret i1 %ok",
    "fail:",
    "  ret i1 0",
    "}",
    "",
    "; Process execution, handle-based -- the same shape the real",
    "; compiler's prelude uses, because `main.plum` is compiled by BOTH",
    "; compilers and so `run_process` must mean the same thing in each.",
    "; The shims themselves are already linked (process_shim.c).",
    "define i64 @plum_process_run_raw(ptr %prog, ptr %args, i64 %argc) {",
    "entry:",
    "  %pd = getelementptr i8, ptr %prog, i64 16",
    "  %ad = getelementptr i8, ptr %args, i64 16",
    "  %h = call i64 @process_run(ptr %pd, ptr %ad, i64 %argc)",
    "  ret i64 %h",
    "}",
    "",
    "define i64 @plum_process_exit_code_raw(i64 %h) {",
    "entry:",
    "  %c = call i64 @process_exit_code(i64 %h)",
    "  ret i64 %c",
    "}",
    "",
    "; The shim hands back a NUL-terminated C string it still owns; this",
    "; copies it into a Plum cell, which is what makes it safe to keep",
    "; after `process_free`.",
    "define ptr @plum_process_stdout_raw(i64 %h) {",
    "entry:",
    "  %c = call ptr @process_stdout_data(i64 %h)",
    "  %n = call i64 @strlen(ptr %c)",
    "  %s = call ptr @plum_str_new(ptr %c, i64 %n)",
    "  ret ptr %s",
    "}",
    "",
    "define ptr @plum_process_stderr_raw(i64 %h) {",
    "entry:",
    "  %c = call ptr @process_stderr_data(i64 %h)",
    "  %n = call i64 @strlen(ptr %c)",
    "  %s = call ptr @plum_str_new(ptr %c, i64 %n)",
    "  ret ptr %s",
    "}",
    "",
    "define i1 @plum_process_free_raw(i64 %h) {",
    "entry:",
    "  call void @process_free(i64 %h)",
    "  ret i1 0",
    "}",
    "",
    "define ptr @plum_read_file_raw(ptr %path) {",
    "entry:",
    "  %pd = getelementptr i8, ptr %path, i64 16",
    "  %f = call ptr @fopen(ptr %pd, ptr @.plum_mode_r)",
    "  %isnull = icmp eq ptr %f, null",
    "  br i1 %isnull, label %fail, label %open",
    "open:",
    "  %seek = call i32 @fseek(ptr %f, i64 0, i32 2)",
    "  %size = call i64 @ftell(ptr %f)",
    "  %rew = call i32 @fseek(ptr %f, i64 0, i32 0)",
    "  %bufsize = add i64 %size, 1",
    "  %buf = call ptr @malloc(i64 %bufsize)",
    "  %got = call i64 @fread(ptr %buf, i64 1, i64 %size, ptr %f)",
    "  %closed = call i32 @fclose(ptr %f)",
    "  %cell = call ptr @plum_str_new(ptr %buf, i64 %got)",
    // Same as the `to_string` buffers: the cell owns a copy now. This
    // one leaked the WHOLE FILE on every read.
    "  call void @free(ptr %buf)",
    "  %out = call ptr @plum_array_new(i64 1)",
    "  %slot = getelementptr i8, ptr %out, i64 16",
    "  store ptr %cell, ptr %slot",
    "  ret ptr %out",
    "fail:",
    "  %empty = call ptr @plum_array_new(i64 0)",
    "  ret ptr %empty",
    "}",
    "",
    "define i64 @plum_path_is_dir(ptr %path) {",
    "entry:",
    "  %pd = getelementptr i8, ptr %path, i64 16",
    "  %r = call i64 @path_is_dir(ptr %pd)",
    "  ret i64 %r",
    "}",
    "",
    "define i64 @plum_dir_open(ptr %path) {",
    "entry:",
    "  %pd = getelementptr i8, ptr %path, i64 16",
    "  %h = call i64 @dir_open(ptr %pd)",
    "  ret i64 %h",
    "}",
    "",
    "; The shim hands back a NUL-terminated C string, empty when the",
    "; directory is exhausted; this copies it into a Plum string cell.",
    "define ptr @plum_dir_next(i64 %h) {",
    "entry:",
    "  %c = call ptr @dir_read_next(i64 %h)",
    "  %n = call i64 @strlen(ptr %c)",
    "  %s = call ptr @plum_str_new(ptr %c, i64 %n)",
    "  ret ptr %s",
    "}",
    "",
    "define i1 @plum_dir_close(i64 %h) {",
    "entry:",
    "  call void @dir_close(i64 %h)",
    "  ret i1 0",
    "}",
    "", "; The shim returns a NUL-terminated C string in a STATIC buffer, so",
    "; this must copy it into a Plum cell before anything else can call",
    "; back in. Empty means failure -- see `os_shim.c` on why a null",
    "; return is not an option here. The `ignored` parameter mirrors",
    "; `random_raw`: this backend reaches runtime primitives through a",
    "; prelude stub, and the stubs all take at least one argument.",
    "define ptr @plum_os_temp_dir(i1 %ignored) {",
    "entry:",
    "  %c = call ptr @os_temp_dir()",
    "  %n = call i64 @strlen(ptr %c)",
    "  %s = call ptr @plum_str_new(ptr %c, i64 %n)",
    "  ret ptr %s",
    "}",
    "",
    "define ptr @plum_os_self_exe(i1 %ignored) {",
    "entry:",
    "  %c = call ptr @os_self_exe()",
    "  %n = call i64 @strlen(ptr %c)",
    "  %s = call ptr @plum_str_new(ptr %c, i64 %n)",
    "  ret ptr %s",
    "}",
    "",
    "; The system clock, in seconds since the Unix epoch.",
    ";",
    "; `time(NULL)` rather than anything with sub-second resolution: it",
    "; is the one clock call that is identical on Linux, macOS and",
    "; Windows with no shim at all. `@time` was already declared here and",
    "; used by nothing, which had the unhappy side effect of making the",
    "; symbol unbindable from a user `extern \"C\"` block -- LLVM rejects",
    "; the duplicate declare. Now it is used.",
    "define i64 @plum_os_time(i64 %ignored) {",
    "entry:",
    "  %r = call i64 @time(ptr null)",
    "  ret i64 %r",
    "}",
    "",
    "define i64 @plum_os_make_dir(ptr %path) {",
    "entry:",
    "  %pd = getelementptr i8, ptr %path, i64 16",
    "  %r = call i64 @os_make_dir(ptr %pd)",
    "  ret i64 %r",
    "}",
    "",
    "define i64 @plum_os_remove_file(ptr %path) {",
    "entry:",
    "  %pd = getelementptr i8, ptr %path, i64 16",
    "  %r = call i64 @os_remove_file(ptr %pd)",
    "  ret i64 %r",
    "}",
    "",
    "define i64 @plum_os_remove_tree(ptr %path) {",
    "entry:",
    "  %pd = getelementptr i8, ptr %path, i64 16",
    "  %r = call i64 @os_remove_tree(ptr %pd)",
    "  ret i64 %r",
    "}",
    "",
    "; Decimal text to the nearest double. See `parse_float_raw` in the",
    "; prelude for why this is libc's and not arithmetic.",
    "define double @plum_parse_float_raw(ptr %s) {",
    "entry:",
    "  %sd = getelementptr i8, ptr %s, i64 16",
    "  %v = call double @strtod(ptr %sd, ptr null)",
    "  ret double %v",
    "}",
    "",
    "define ptr @plum_os_platform(i1 %ignored) {",
    "entry:",
    "  %c = call ptr @plum_host_platform()",
    "  %n = call i64 @strlen(ptr %c)",
    "  %s = call ptr @plum_str_new(ptr %c, i64 %n)",
    "  ret ptr %s",
    "}",
    "",
    "define i64 @plum_os_copy_tree(ptr %src, ptr %dst) {",
    "entry:",
    "  %sd = getelementptr i8, ptr %src, i64 16",
    "  %dd = getelementptr i8, ptr %dst, i64 16",
    "  %r = call i64 @os_copy_tree(ptr %sd, ptr %dd)",
    "  ret i64 %r",
    "}",
    "",
    "@.plum_oob = private constant [26 x i8] c\"array index out of bounds\\00\"",
    "",
    "; A failed bounds check aborts with the SAME message the real",
    "; backend produces (`emit_runtime_check`'s \"array index out of",
    "; bounds\") -- a program that indexes past the end must behave",
    "; identically under both, including what it prints.",
    "define void @plum_bounds_fail() {",
    "entry:",
    "  %r = call i32 (ptr, ...) @printf(ptr @.plum_fmt_line, ptr @.plum_oob)",
    "  call void @exit(i32 1)",
    "  ret void",
    "}",
    "",
    "@.plum_divzero = private constant [17 x i8] c\"division by zero\\00\"",
    "@.plum_overflow = private constant [17 x i8] c\"integer overflow\\00\"",
    "",
    "; LLVM's `sdiv`/`srem` are UNDEFINED for a zero divisor and for",
    "; `i64::MIN / -1`, and undefined means the optimizer may do",
    "; anything with the surrounding code. It did: `10 / d` with a",
    "; runtime zero `d` printed a different wrong number under each",
    "; backend and then CARRIED ON, while the same program built",
    "; unoptimized died of SIGFPE with no message at all.",
    ";",
    "; The messages are the INTERPRETER's (`eval_arith`, which has used",
    "; `checked_div` all along), so this closes a divergence rather",
    "; than inventing a rule -- and README.md already promised that a",
    "; division by zero was an ordinary runtime error, like an",
    "; out-of-bounds index.",
    "define void @plum_div_zero_fail() {",
    "entry:",
    "  %r = call i32 (ptr, ...) @printf(ptr @.plum_fmt_line, ptr @.plum_divzero)",
    "  call void @exit(i32 1)",
    "  ret void",
    "}",
    "",
    "define void @plum_div_overflow_fail() {",
    "entry:",
    "  %r = call i32 (ptr, ...) @printf(ptr @.plum_fmt_line, ptr @.plum_overflow)",
    "  call void @exit(i32 1)",
    "  ret void",
    "}",
    "",

    "",
    "; --- Unicode string operations ---",
    ";",
    "; `.to_upper()`, `.to_lower()`, `.trim()` and `.replace()`, PORTED",
    "; VERBATIM from what `crates/plum-codegen` emits rather than",
    "; reimplemented. Both backends emit LLVM IR text, so copying the",
    "; function bodies is possible here in a way it is not for anything",
    "; written in Rust -- and it makes the two agree by construction",
    "; instead of by two careful implementations kept in step. This",
    "; repository has paid twice for the alternative (DESIGN.md's \"One",
    "; prelude, not two\").",
    ";",
    "; That includes inheriting the documented caveat exactly: case",
    "; mapping goes through libc's `towupper`/`towlower`, which are",
    "; one-codepoint-in-one-codepoint-out, so multi-codepoint expansions",
    "; (German `\xc3\x9f` -> `SS`) cannot happen and the character is left",
    "; alone. The interpreter's `str::to_uppercase()` does expand it.",
    "; A divergence, unchanged by this port, and stated where the real",
    "; backend states it.",
    "",
    "; The self-hosted counterpart of the real backend's",
    "; `@plum_alloc_str`: same cell layout ({ rc, len, bytes.., nul },",
    "; data at offset 16 -- verified identical before relying on it),",
    "; but allocating through this runtime's own `@plum_alloc` so the",
    "; heap statistics stay correct.",
    "define ptr @plum_alloc_str(i64 %len) {",
    "entry:",
    "  %sn = load i64, ptr @plum_n_str",
    "  %sn1 = add i64 %sn, 1",
    "  store i64 %sn1, ptr @plum_n_str",
    "  %size = add i64 %len, 17",
    "  %cell = call ptr @plum_alloc(i64 %size)",
    "  %lenp = getelementptr i8, ptr %cell, i64 8",
    "  store i64 %len, ptr %lenp",
    "  %data = getelementptr i8, ptr %cell, i64 16",
    "  %endp = getelementptr i8, ptr %data, i64 %len",
    "  store i8 0, ptr %endp",
    "  ret ptr %cell",
    "}",
    "",
    "; Called from `@main` before anything else. Without it `towupper`",
    "; runs in the default \"C\" locale and touches ASCII only, which is a",
    "; silent divergence from the real backend rather than a loud one.",
    "",
    "; The category constant and the locale NAME both live in",
    "; `native_stdlib/compat_shim.c` rather than here, because neither is",
    "; portable: `LC_ALL` is 6 on glibc and 0 on macOS, and `C.utf8` is a",
    "; glibc-only name. This used to emit `setlocale(6, \"C.utf8\")`",
    "; directly, which on macOS set LC_MESSAGES to a locale that does not",
    "; exist -- two bugs, both silent.",
    "define void @plum_locale_init() {",
    "entry:",
    "  call void @plum_set_utf8_locale()",
    "  ; Windows opens stdout in TEXT mode, which rewrites every `\\n`",
    "  ; as `\\r\\n`. Plum writes UTF-8 bytes and compares output byte",
    "  ; for byte, so that translation corrupts it. A no-op elsewhere.",
    "  call void @plum_set_binary_stdio()",
    "  ret void",
    "}",
    "",
    "",
    "define i64 @plum_utf8_len_at(ptr %base, i64 %pos) {",
    "entry:",
    "  %addr = getelementptr i8, ptr %base, i64 %pos",
    "  %b0_i8 = load i8, ptr %addr",
    "  %b0 = zext i8 %b0_i8 to i64",
    "  %and80 = and i64 %b0, 128",
    "  %is1 = icmp eq i64 %and80, 0",
    "  br i1 %is1, label %len1, label %check2",
    "len1:",
    "  ret i64 1",
    "check2:",
    "  %andE0 = and i64 %b0, 224",
    "  %is2 = icmp eq i64 %andE0, 192",
    "  br i1 %is2, label %len2, label %check3",
    "len2:",
    "  ret i64 2",
    "check3:",
    "  %andF0 = and i64 %b0, 240",
    "  %is3 = icmp eq i64 %andF0, 224",
    "  br i1 %is3, label %len3, label %len4",
    "len3:",
    "  ret i64 3",
    "len4:",
    "  ret i64 4",
    "}",
    "",
    "define i64 @plum_utf8_decode(ptr %base, i64 %pos, ptr %out_nbytes) {",
    "entry:",
    "  %addr = getelementptr i8, ptr %base, i64 %pos",
    "  %b0_i8 = load i8, ptr %addr",
    "  %b0 = zext i8 %b0_i8 to i64",
    "  %and80 = and i64 %b0, 128",
    "  %is1 = icmp eq i64 %and80, 0",
    "  br i1 %is1, label %len1, label %check2",
    "len1:",
    "  store i64 1, ptr %out_nbytes",
    "  ret i64 %b0",
    "check2:",
    "  %andE0 = and i64 %b0, 224",
    "  %is2 = icmp eq i64 %andE0, 192",
    "  br i1 %is2, label %len2, label %check3",
    "len2:",
    "  %pos1_2 = add i64 %pos, 1",
    "  %addr1_2 = getelementptr i8, ptr %base, i64 %pos1_2",
    "  %b1_2_i8 = load i8, ptr %addr1_2",
    "  %b1_2 = zext i8 %b1_2_i8 to i64",
    "  %b1_2low = and i64 %b1_2, 63",
    "  %lead5 = and i64 %b0, 31",
    "  %lead5sh = shl i64 %lead5, 6",
    "  %cp2 = or i64 %lead5sh, %b1_2low",
    "  store i64 2, ptr %out_nbytes",
    "  ret i64 %cp2",
    "check3:",
    "  %andF0 = and i64 %b0, 240",
    "  %is3 = icmp eq i64 %andF0, 224",
    "  br i1 %is3, label %len3, label %len4",
    "len3:",
    "  %pos1_3 = add i64 %pos, 1",
    "  %addr1_3 = getelementptr i8, ptr %base, i64 %pos1_3",
    "  %b1_3_i8 = load i8, ptr %addr1_3",
    "  %b1_3 = zext i8 %b1_3_i8 to i64",
    "  %b1_3low = and i64 %b1_3, 63",
    "  %pos2_3 = add i64 %pos, 2",
    "  %addr2_3 = getelementptr i8, ptr %base, i64 %pos2_3",
    "  %b2_3_i8 = load i8, ptr %addr2_3",
    "  %b2_3 = zext i8 %b2_3_i8 to i64",
    "  %b2_3low = and i64 %b2_3, 63",
    "  %lead4 = and i64 %b0, 15",
    "  %lead4sh = shl i64 %lead4, 12",
    "  %b1_3sh = shl i64 %b1_3low, 6",
    "  %tmp3 = or i64 %lead4sh, %b1_3sh",
    "  %cp3 = or i64 %tmp3, %b2_3low",
    "  store i64 3, ptr %out_nbytes",
    "  ret i64 %cp3",
    "len4:",
    "  %pos1_4 = add i64 %pos, 1",
    "  %addr1_4 = getelementptr i8, ptr %base, i64 %pos1_4",
    "  %b1_4_i8 = load i8, ptr %addr1_4",
    "  %b1_4 = zext i8 %b1_4_i8 to i64",
    "  %b1_4low = and i64 %b1_4, 63",
    "  %pos2_4 = add i64 %pos, 2",
    "  %addr2_4 = getelementptr i8, ptr %base, i64 %pos2_4",
    "  %b2_4_i8 = load i8, ptr %addr2_4",
    "  %b2_4 = zext i8 %b2_4_i8 to i64",
    "  %b2_4low = and i64 %b2_4, 63",
    "  %pos3_4 = add i64 %pos, 3",
    "  %addr3_4 = getelementptr i8, ptr %base, i64 %pos3_4",
    "  %b3_4_i8 = load i8, ptr %addr3_4",
    "  %b3_4 = zext i8 %b3_4_i8 to i64",
    "  %b3_4low = and i64 %b3_4, 63",
    "  %lead3 = and i64 %b0, 7",
    "  %lead3sh = shl i64 %lead3, 18",
    "  %b1_4sh = shl i64 %b1_4low, 12",
    "  %b2_4sh = shl i64 %b2_4low, 6",
    "  %tmp4a = or i64 %lead3sh, %b1_4sh",
    "  %tmp4b = or i64 %tmp4a, %b2_4sh",
    "  %cp4 = or i64 %tmp4b, %b3_4low",
    "  store i64 4, ptr %out_nbytes",
    "  ret i64 %cp4",
    "}",
    "",
    "define i64 @plum_utf8_encoded_len(i64 %cp) {",
    "entry:",
    "  %is1 = icmp ult i64 %cp, 128",
    "  br i1 %is1, label %len1, label %check2",
    "len1:",
    "  ret i64 1",
    "check2:",
    "  %is2 = icmp ult i64 %cp, 2048",
    "  br i1 %is2, label %len2, label %check3",
    "len2:",
    "  ret i64 2",
    "check3:",
    "  %is3 = icmp ult i64 %cp, 65536",
    "  br i1 %is3, label %len3, label %len4",
    "len3:",
    "  ret i64 3",
    "len4:",
    "  ret i64 4",
    "}",
    "",
    "define i64 @plum_utf8_encode(ptr %dst, i64 %cp) {",
    "entry:",
    "  %is1 = icmp ult i64 %cp, 128",
    "  br i1 %is1, label %len1, label %check2",
    "len1:",
    "  %b0_1 = trunc i64 %cp to i8",
    "  store i8 %b0_1, ptr %dst",
    "  ret i64 1",
    "check2:",
    "  %is2 = icmp ult i64 %cp, 2048",
    "  br i1 %is2, label %len2, label %check3",
    "len2:",
    "  %hi_2 = lshr i64 %cp, 6",
    "  %hi_2m = or i64 %hi_2, 192",
    "  %b0_2 = trunc i64 %hi_2m to i8",
    "  store i8 %b0_2, ptr %dst",
    "  %lo_2 = and i64 %cp, 63",
    "  %lo_2m = or i64 %lo_2, 128",
    "  %b1_2 = trunc i64 %lo_2m to i8",
    "  %addr1_2 = getelementptr i8, ptr %dst, i64 1",
    "  store i8 %b1_2, ptr %addr1_2",
    "  ret i64 2",
    "check3:",
    "  %is3 = icmp ult i64 %cp, 65536",
    "  br i1 %is3, label %len3, label %len4",
    "len3:",
    "  %hi_3 = lshr i64 %cp, 12",
    "  %hi_3m = or i64 %hi_3, 224",
    "  %b0_3 = trunc i64 %hi_3m to i8",
    "  store i8 %b0_3, ptr %dst",
    "  %mid_3 = lshr i64 %cp, 6",
    "  %mid_3a = and i64 %mid_3, 63",
    "  %mid_3m = or i64 %mid_3a, 128",
    "  %b1_3 = trunc i64 %mid_3m to i8",
    "  %addr1_3 = getelementptr i8, ptr %dst, i64 1",
    "  store i8 %b1_3, ptr %addr1_3",
    "  %lo_3 = and i64 %cp, 63",
    "  %lo_3m = or i64 %lo_3, 128",
    "  %b2_3 = trunc i64 %lo_3m to i8",
    "  %addr2_3 = getelementptr i8, ptr %dst, i64 2",
    "  store i8 %b2_3, ptr %addr2_3",
    "  ret i64 3",
    "len4:",
    "  %hi_4 = lshr i64 %cp, 18",
    "  %hi_4m = or i64 %hi_4, 240",
    "  %b0_4 = trunc i64 %hi_4m to i8",
    "  store i8 %b0_4, ptr %dst",
    "  %mid1_4 = lshr i64 %cp, 12",
    "  %mid1_4a = and i64 %mid1_4, 63",
    "  %mid1_4m = or i64 %mid1_4a, 128",
    "  %b1_4 = trunc i64 %mid1_4m to i8",
    "  %addr1_4 = getelementptr i8, ptr %dst, i64 1",
    "  store i8 %b1_4, ptr %addr1_4",
    "  %mid2_4 = lshr i64 %cp, 6",
    "  %mid2_4a = and i64 %mid2_4, 63",
    "  %mid2_4m = or i64 %mid2_4a, 128",
    "  %b2_4 = trunc i64 %mid2_4m to i8",
    "  %addr2_4 = getelementptr i8, ptr %dst, i64 2",
    "  store i8 %b2_4, ptr %addr2_4",
    "  %lo_4 = and i64 %cp, 63",
    "  %lo_4m = or i64 %lo_4, 128",
    "  %b3_4 = trunc i64 %lo_4m to i8",
    "  %addr3_4 = getelementptr i8, ptr %dst, i64 3",
    "  store i8 %b3_4, ptr %addr3_4",
    "  ret i64 4",
    "}",
    "",
    "define i1 @plum_is_unicode_whitespace(i64 %cp) {",
    "entry:",
    "  %r1a = icmp sge i64 %cp, 9",
    "  %r1b = icmp sle i64 %cp, 13",
    "  %r1 = and i1 %r1a, %r1b",
    "  %r2 = icmp eq i64 %cp, 32",
    "  %r3 = icmp eq i64 %cp, 133",
    "  %r4 = icmp eq i64 %cp, 160",
    "  %r5 = icmp eq i64 %cp, 5760",
    "  %r6a = icmp sge i64 %cp, 8192",
    "  %r6b = icmp sle i64 %cp, 8202",
    "  %r6 = and i1 %r6a, %r6b",
    "  %r7 = icmp eq i64 %cp, 8232",
    "  %r8 = icmp eq i64 %cp, 8233",
    "  %r9 = icmp eq i64 %cp, 8239",
    "  %r10 = icmp eq i64 %cp, 8287",
    "  %r11 = icmp eq i64 %cp, 12288",
    "  %o1 = or i1 %r1, %r2",
    "  %o2 = or i1 %o1, %r3",
    "  %o3 = or i1 %o2, %r4",
    "  %o4 = or i1 %o3, %r5",
    "  %o5 = or i1 %o4, %r6",
    "  %o6 = or i1 %o5, %r7",
    "  %o7 = or i1 %o6, %r8",
    "  %o8 = or i1 %o7, %r9",
    "  %o9 = or i1 %o8, %r10",
    "  %o10 = or i1 %o9, %r11",
    "  ret i1 %o10",
    "}",
    "",
    "define void @plum_str_trim_bounds(ptr %s, ptr %out_start, ptr %out_end) {",
    "entry:",
    "  %len_addr = getelementptr i8, ptr %s, i64 8",
    "  %len = load i64, ptr %len_addr",
    "  %base = getelementptr i8, ptr %s, i64 16",
    "  br label %fwd_check",
    "fwd_check:",
    "  %pos = phi i64 [ 0, %entry ], [ %pos_next, %fwd_advance ]",
    "  %fwd_cont = icmp slt i64 %pos, %len",
    "  br i1 %fwd_cont, label %fwd_body, label %fwd_done",
    "fwd_body:",
    "  %fwd_nbytes_slot = alloca i64",
    "  %fwd_cp = call i64 @plum_utf8_decode(ptr %base, i64 %pos, ptr %fwd_nbytes_slot)",
    "  %fwd_is_ws = call i1 @plum_is_unicode_whitespace(i64 %fwd_cp)",
    "  br i1 %fwd_is_ws, label %fwd_advance, label %fwd_done",
    "fwd_advance:",
    "  %fwd_nbytes = load i64, ptr %fwd_nbytes_slot",
    "  %pos_next = add i64 %pos, %fwd_nbytes",
    "  br label %fwd_check",
    "fwd_done:",
    "  %start = phi i64 [ %pos, %fwd_check ], [ %pos, %fwd_body ]",
    "  store i64 %start, ptr %out_start",
    "  br label %bwd_check",
    "bwd_check:",
    "  %end = phi i64 [ %len, %fwd_done ], [ %end_next, %bwd_advance ]",
    "  %bwd_cont = icmp sgt i64 %end, %start",
    "  br i1 %bwd_cont, label %bwd_scan_start, label %bwd_done",
    "bwd_scan_start:",
    "  %last = sub i64 %end, 1",
    "  br label %bwd_scan",
    "bwd_scan:",
    "  %scan_pos = phi i64 [ %last, %bwd_scan_start ], [ %scan_pos_next, %bwd_scan_cont ]",
    "  %scan_addr = getelementptr i8, ptr %base, i64 %scan_pos",
    "  %scan_byte_i8 = load i8, ptr %scan_addr",
    "  %scan_byte = zext i8 %scan_byte_i8 to i64",
    "  %scan_and = and i64 %scan_byte, 192",
    "  %is_cont = icmp eq i64 %scan_and, 128",
    "  br i1 %is_cont, label %bwd_scan_cont, label %bwd_char_start",
    "bwd_scan_cont:",
    "  %scan_pos_next = sub i64 %scan_pos, 1",
    "  br label %bwd_scan",
    "bwd_char_start:",
    "  %bwd_nbytes_slot = alloca i64",
    "  %bwd_cp = call i64 @plum_utf8_decode(ptr %base, i64 %scan_pos, ptr %bwd_nbytes_slot)",
    "  %bwd_is_ws = call i1 @plum_is_unicode_whitespace(i64 %bwd_cp)",
    "  br i1 %bwd_is_ws, label %bwd_advance, label %bwd_done",
    "bwd_advance:",
    "  %end_next = phi i64 [ %scan_pos, %bwd_char_start ]",
    "  br label %bwd_check",
    "bwd_done:",
    "  %final_end = phi i64 [ %end, %bwd_check ], [ %end, %bwd_char_start ]",
    "  store i64 %final_end, ptr %out_end",
    "  ret void",
    "}",
    "",
    "define ptr @plum_str_trim(ptr %s) {",
    "entry:",
    "  %start_slot = alloca i64",
    "  %end_slot = alloca i64",
    "  call void @plum_str_trim_bounds(ptr %s, ptr %start_slot, ptr %end_slot)",
    "  %start = load i64, ptr %start_slot",
    "  %end = load i64, ptr %end_slot",
    "  %newlen = sub i64 %end, %start",
    "  %cell = call ptr @plum_alloc_str(i64 %newlen)",
    "  %sbase = getelementptr i8, ptr %s, i64 16",
    "  %src = getelementptr i8, ptr %sbase, i64 %start",
    "  %dst = getelementptr i8, ptr %cell, i64 16",
    "  call ptr @memcpy(ptr %dst, ptr %src, i64 %newlen)",
    "  ret ptr %cell",
    "}",
    "",
    "define i64 @plum_str_count_matches(ptr %s, ptr %needle) {",
    "entry:",
    "  %slen_addr = getelementptr i8, ptr %s, i64 8",
    "  %slen = load i64, ptr %slen_addr",
    "  %nlen_addr = getelementptr i8, ptr %needle, i64 8",
    "  %nlen = load i64, ptr %nlen_addr",
    "  %is_empty_needle = icmp eq i64 %nlen, 0",
    "  br i1 %is_empty_needle, label %zero_result, label %check_fits",
    "zero_result:",
    "  ret i64 0",
    "check_fits:",
    "  %fits = icmp sge i64 %slen, %nlen",
    "  br i1 %fits, label %outer_init, label %no_match_return",
    "no_match_return:",
    "  ret i64 0",
    "outer_init:",
    "  %max_start = sub i64 %slen, %nlen",
    "  br label %outer",
    "outer:",
    "  %start = phi i64 [ 0, %outer_init ], [ %start_next_m, %match_advance ], [ %start_next_x, %mismatch_advance ]",
    "  %count = phi i64 [ 0, %outer_init ], [ %count_next, %match_advance ], [ %count, %mismatch_advance ]",
    "  %outer_done = icmp sgt i64 %start, %max_start",
    "  br i1 %outer_done, label %finished, label %inner_init",
    "inner_init:",
    "  br label %inner",
    "inner:",
    "  %j = phi i64 [ 0, %inner_init ], [ %j_next, %inner_cont ]",
    "  %inner_done = icmp eq i64 %j, %nlen",
    "  br i1 %inner_done, label %found, label %inner_check",
    "inner_check:",
    "  %s_idx = add i64 %start, %j",
    "  %s_base = getelementptr i8, ptr %s, i64 16",
    "  %s_addr = getelementptr i8, ptr %s_base, i64 %s_idx",
    "  %s_byte = load i8, ptr %s_addr",
    "  %n_base = getelementptr i8, ptr %needle, i64 16",
    "  %n_addr = getelementptr i8, ptr %n_base, i64 %j",
    "  %n_byte = load i8, ptr %n_addr",
    "  %beq = icmp eq i8 %s_byte, %n_byte",
    "  br i1 %beq, label %inner_cont, label %mismatch_advance",
    "inner_cont:",
    "  %j_next = add i64 %j, 1",
    "  br label %inner",
    "found:",
    "  br label %match_advance",
    "match_advance:",
    "  %count_next = add i64 %count, 1",
    "  %start_next_m = add i64 %start, %nlen",
    "  br label %outer",
    "mismatch_advance:",
    "  %start_next_x = add i64 %start, 1",
    "  br label %outer",
    "finished:",
    "  ret i64 %count",
    "}",
    "",
    "define ptr @plum_str_replace(ptr %s, ptr %from, ptr %to) {",
    "entry:",
    "  %fromlen_addr = getelementptr i8, ptr %from, i64 8",
    "  %fromlen = load i64, ptr %fromlen_addr",
    "  %tolen_addr = getelementptr i8, ptr %to, i64 8",
    "  %tolen = load i64, ptr %tolen_addr",
    "  %slen_addr = getelementptr i8, ptr %s, i64 8",
    "  %slen = load i64, ptr %slen_addr",
    "  %sbase = getelementptr i8, ptr %s, i64 16",
    "  %tobase = getelementptr i8, ptr %to, i64 16",
    "  %is_empty_from = icmp eq i64 %fromlen, 0",
    "  br i1 %is_empty_from, label %empty_from_path, label %nonempty_from_path",
    "nonempty_from_path:",
    "  %frombase = getelementptr i8, ptr %from, i64 16",
    "  %match_count = call i64 @plum_str_count_matches(ptr %s, ptr %from)",
    "  %delta = sub i64 %tolen, %fromlen",
    "  %grow = mul i64 %match_count, %delta",
    "  %newlen = add i64 %slen, %grow",
    "  %cell = call ptr @plum_alloc_str(i64 %newlen)",
    "  %dbase = getelementptr i8, ptr %cell, i64 16",
    "  br label %scan_check",
    "scan_check:",
    "  %spos = phi i64 [ 0, %nonempty_from_path ], [ %spos_next, %after_copy ]",
    "  %dpos = phi i64 [ 0, %nonempty_from_path ], [ %dpos_next, %after_copy ]",
    "  %scan_cont = icmp slt i64 %spos, %slen",
    "  br i1 %scan_cont, label %try_match, label %scan_done",
    "try_match:",
    "  %remaining = sub i64 %slen, %spos",
    "  %fits = icmp sge i64 %remaining, %fromlen",
    "  br i1 %fits, label %match_check_loop_init, label %copy_one_byte",
    "match_check_loop_init:",
    "  br label %match_check_loop",
    "match_check_loop:",
    "  %j = phi i64 [ 0, %match_check_loop_init ], [ %j_next, %match_check_cont ]",
    "  %j_done = icmp eq i64 %j, %fromlen",
    "  br i1 %j_done, label %is_match, label %match_check_body",
    "match_check_body:",
    "  %s_idx = add i64 %spos, %j",
    "  %s_addr = getelementptr i8, ptr %sbase, i64 %s_idx",
    "  %s_byte = load i8, ptr %s_addr",
    "  %f_addr = getelementptr i8, ptr %frombase, i64 %j",
    "  %f_byte = load i8, ptr %f_addr",
    "  %beq = icmp eq i8 %s_byte, %f_byte",
    "  br i1 %beq, label %match_check_cont, label %copy_one_byte",
    "match_check_cont:",
    "  %j_next = add i64 %j, 1",
    "  br label %match_check_loop",
    "is_match:",
    "  %ddst_m = getelementptr i8, ptr %dbase, i64 %dpos",
    "  call ptr @memcpy(ptr %ddst_m, ptr %tobase, i64 %tolen)",
    "  %spos_next_m = add i64 %spos, %fromlen",
    "  %dpos_next_m = add i64 %dpos, %tolen",
    "  br label %after_copy",
    "copy_one_byte:",
    "  %s1addr = getelementptr i8, ptr %sbase, i64 %spos",
    "  %s1byte = load i8, ptr %s1addr",
    "  %d1addr = getelementptr i8, ptr %dbase, i64 %dpos",
    "  store i8 %s1byte, ptr %d1addr",
    "  %spos_next_b = add i64 %spos, 1",
    "  %dpos_next_b = add i64 %dpos, 1",
    "  br label %after_copy",
    "after_copy:",
    "  %spos_next = phi i64 [ %spos_next_m, %is_match ], [ %spos_next_b, %copy_one_byte ]",
    "  %dpos_next = phi i64 [ %dpos_next_m, %is_match ], [ %dpos_next_b, %copy_one_byte ]",
    "  br label %scan_check",
    "scan_done:",
    "  ret ptr %cell",
    "empty_from_path:",
    "  br label %ecount_check",
    "ecount_check:",
    "  %epos = phi i64 [ 0, %empty_from_path ], [ %epos_next, %ecount_body ]",
    "  %echars = phi i64 [ 0, %empty_from_path ], [ %echars_next, %ecount_body ]",
    "  %econt = icmp slt i64 %epos, %slen",
    "  br i1 %econt, label %ecount_body, label %ecount_done",
    "ecount_body:",
    "  %eclen = call i64 @plum_utf8_len_at(ptr %sbase, i64 %epos)",
    "  %epos_next = add i64 %epos, %eclen",
    "  %echars_next = add i64 %echars, 1",
    "  br label %ecount_check",
    "ecount_done:",
    "  %pieces = add i64 %echars, 1",
    "  %insert_bytes = mul i64 %pieces, %tolen",
    "  %newlen2 = add i64 %slen, %insert_bytes",
    "  %cell2 = call ptr @plum_alloc_str(i64 %newlen2)",
    "  %dbase2 = getelementptr i8, ptr %cell2, i64 16",
    "  br label %efill_check",
    "efill_check:",
    "  %fpos = phi i64 [ 0, %ecount_done ], [ %fpos_next, %efill_body ]",
    "  %fdst = phi i64 [ 0, %ecount_done ], [ %fdst_next, %efill_body ]",
    "  %ins_dst = getelementptr i8, ptr %dbase2, i64 %fdst",
    "  call ptr @memcpy(ptr %ins_dst, ptr %tobase, i64 %tolen)",
    "  %fdst_ins = add i64 %fdst, %tolen",
    "  %fcont = icmp slt i64 %fpos, %slen",
    "  br i1 %fcont, label %efill_body, label %efill_done",
    "efill_body:",
    "  %flen = call i64 @plum_utf8_len_at(ptr %sbase, i64 %fpos)",
    "  %csrc = getelementptr i8, ptr %sbase, i64 %fpos",
    "  %cdst = getelementptr i8, ptr %dbase2, i64 %fdst_ins",
    "  call ptr @memcpy(ptr %cdst, ptr %csrc, i64 %flen)",
    "  %fpos_next = add i64 %fpos, %flen",
    "  %fdst_next = add i64 %fdst_ins, %flen",
    "  br label %efill_check",
    "efill_done:",
    "  ret ptr %cell2",
    "}",
    "",
    "define ptr @plum_str_to_upper(ptr %s) {",
    "entry:",
    "  %slen_addr = getelementptr i8, ptr %s, i64 8",
    "  %slen = load i64, ptr %slen_addr",
    "  %sbase = getelementptr i8, ptr %s, i64 16",
    "  br label %count_check",
    "count_check:",
    "  %pos1 = phi i64 [ 0, %entry ], [ %pos1_next, %count_body ]",
    "  %total = phi i64 [ 0, %entry ], [ %total_next, %count_body ]",
    "  %cont1 = icmp slt i64 %pos1, %slen",
    "  br i1 %cont1, label %count_body, label %count_done",
    "count_body:",
    "  %cnbytes_slot = alloca i64",
    "  %ccp = call i64 @plum_utf8_decode(ptr %sbase, i64 %pos1, ptr %cnbytes_slot)",
    "  %ccp32 = trunc i64 %ccp to i32",
    "  %cmapped32 = call i32 @plum_toupper_cp(i32 %ccp32)",
    "  %cmapped = zext i32 %cmapped32 to i64",
    "  %cmlen = call i64 @plum_utf8_encoded_len(i64 %cmapped)",
    "  %total_next = add i64 %total, %cmlen",
    "  %cnbytes = load i64, ptr %cnbytes_slot",
    "  %pos1_next = add i64 %pos1, %cnbytes",
    "  br label %count_check",
    "count_done:",
    "  %cell = call ptr @plum_alloc_str(i64 %total)",
    "  %dst = getelementptr i8, ptr %cell, i64 16",
    "  br label %fill_check",
    "fill_check:",
    "  %pos2 = phi i64 [ 0, %count_done ], [ %pos2_next, %fill_body ]",
    "  %dcur = phi i64 [ 0, %count_done ], [ %dcur_next, %fill_body ]",
    "  %cont2 = icmp slt i64 %pos2, %slen",
    "  br i1 %cont2, label %fill_body, label %fill_done",
    "fill_body:",
    "  %fnbytes_slot = alloca i64",
    "  %fcp = call i64 @plum_utf8_decode(ptr %sbase, i64 %pos2, ptr %fnbytes_slot)",
    "  %fcp32 = trunc i64 %fcp to i32",
    "  %fmapped32 = call i32 @plum_toupper_cp(i32 %fcp32)",
    "  %fmapped = zext i32 %fmapped32 to i64",
    "  %fdaddr = getelementptr i8, ptr %dst, i64 %dcur",
    "  %fwritten = call i64 @plum_utf8_encode(ptr %fdaddr, i64 %fmapped)",
    "  %dcur_next = add i64 %dcur, %fwritten",
    "  %fnbytes = load i64, ptr %fnbytes_slot",
    "  %pos2_next = add i64 %pos2, %fnbytes",
    "  br label %fill_check",
    "fill_done:",
    "  ret ptr %cell",
    "}",
    "",
    "define ptr @plum_str_to_lower(ptr %s) {",
    "entry:",
    "  %slen_addr = getelementptr i8, ptr %s, i64 8",
    "  %slen = load i64, ptr %slen_addr",
    "  %sbase = getelementptr i8, ptr %s, i64 16",
    "  br label %count_check",
    "count_check:",
    "  %pos1 = phi i64 [ 0, %entry ], [ %pos1_next, %count_body ]",
    "  %total = phi i64 [ 0, %entry ], [ %total_next, %count_body ]",
    "  %cont1 = icmp slt i64 %pos1, %slen",
    "  br i1 %cont1, label %count_body, label %count_done",
    "count_body:",
    "  %cnbytes_slot = alloca i64",
    "  %ccp = call i64 @plum_utf8_decode(ptr %sbase, i64 %pos1, ptr %cnbytes_slot)",
    "  %ccp32 = trunc i64 %ccp to i32",
    "  %cmapped32 = call i32 @plum_tolower_cp(i32 %ccp32)",
    "  %cmapped = zext i32 %cmapped32 to i64",
    "  %cmlen = call i64 @plum_utf8_encoded_len(i64 %cmapped)",
    "  %total_next = add i64 %total, %cmlen",
    "  %cnbytes = load i64, ptr %cnbytes_slot",
    "  %pos1_next = add i64 %pos1, %cnbytes",
    "  br label %count_check",
    "count_done:",
    "  %cell = call ptr @plum_alloc_str(i64 %total)",
    "  %dst = getelementptr i8, ptr %cell, i64 16",
    "  br label %fill_check",
    "fill_check:",
    "  %pos2 = phi i64 [ 0, %count_done ], [ %pos2_next, %fill_body ]",
    "  %dcur = phi i64 [ 0, %count_done ], [ %dcur_next, %fill_body ]",
    "  %cont2 = icmp slt i64 %pos2, %slen",
    "  br i1 %cont2, label %fill_body, label %fill_done",
    "fill_body:",
    "  %fnbytes_slot = alloca i64",
    "  %fcp = call i64 @plum_utf8_decode(ptr %sbase, i64 %pos2, ptr %fnbytes_slot)",
    "  %fcp32 = trunc i64 %fcp to i32",
    "  %fmapped32 = call i32 @plum_tolower_cp(i32 %fcp32)",
    "  %fmapped = zext i32 %fmapped32 to i64",
    "  %fdaddr = getelementptr i8, ptr %dst, i64 %dcur",
    "  %fwritten = call i64 @plum_utf8_encode(ptr %fdaddr, i64 %fmapped)",
    "  %dcur_next = add i64 %dcur, %fwritten",
    "  %fnbytes = load i64, ptr %fnbytes_slot",
    "  %pos2_next = add i64 %pos2, %fnbytes",
    "  br label %fill_check",
    "fill_done:",
    "  ret ptr %cell",
    "}",
    "; Byte-level substring search: the index of %nd within %h at or",
    "; after %from, or -1. Naive O(n*m) -- the real backend is no",
    "; cleverer, and a Boyer-Moore here would be optimizing a compiler",
    "; that leaks all its memory.",
    "define i64 @plum_str_find(ptr %h, i64 %hlen, ptr %nd, i64 %nlen, i64 %from) {",
    "entry:",
    "  %last = sub i64 %hlen, %nlen",
    "  %ip = alloca i64",
    "  store i64 %from, ptr %ip",
    "  br label %loop",
    "loop:",
    "  %i = load i64, ptr %ip",
    "  %ok = icmp sle i64 %i, %last",
    "  br i1 %ok, label %test, label %miss",
    "test:",
    "  %hp = getelementptr i8, ptr %h, i64 %i",
    "  %c = call i32 @memcmp(ptr %hp, ptr %nd, i64 %nlen)",
    "  %eq = icmp eq i32 %c, 0",
    "  br i1 %eq, label %hit, label %next",
    "next:",
    "  %i1 = add i64 %i, 1",
    "  store i64 %i1, ptr %ip",
    "  br label %loop",
    "hit:",
    "  ret i64 %i",
    "miss:",
    "  ret i64 -1",
    "}",
    "",
    "define i1 @plum_str_contains(ptr %s, ptr %n) {",
    "entry:",
    "  %slp = getelementptr i8, ptr %s, i64 8",
    "  %sl = load i64, ptr %slp",
    "  %nlp = getelementptr i8, ptr %n, i64 8",
    "  %nl = load i64, ptr %nlp",
    "  %sd = getelementptr i8, ptr %s, i64 16",
    "  %nd = getelementptr i8, ptr %n, i64 16",
    "  %at = call i64 @plum_str_find(ptr %sd, i64 %sl, ptr %nd, i64 %nl, i64 0)",
    "  %found = icmp sge i64 %at, 0",
    "  ret i1 %found",
    "}",
    "",
    "define i1 @plum_str_starts_with(ptr %s, ptr %n) {",
    "entry:",
    "  %slp = getelementptr i8, ptr %s, i64 8",
    "  %sl = load i64, ptr %slp",
    "  %nlp = getelementptr i8, ptr %n, i64 8",
    "  %nl = load i64, ptr %nlp",
    "  %fits = icmp sle i64 %nl, %sl",
    "  br i1 %fits, label %cmp, label %no",
    "cmp:",
    "  %sd = getelementptr i8, ptr %s, i64 16",
    "  %nd = getelementptr i8, ptr %n, i64 16",
    "  %c = call i32 @memcmp(ptr %sd, ptr %nd, i64 %nl)",
    "  %eq = icmp eq i32 %c, 0",
    "  ret i1 %eq",
    "no:",
    "  ret i1 0",
    "}",
    "",
    "define i1 @plum_str_ends_with(ptr %s, ptr %n) {",
    "entry:",
    "  %slp = getelementptr i8, ptr %s, i64 8",
    "  %sl = load i64, ptr %slp",
    "  %nlp = getelementptr i8, ptr %n, i64 8",
    "  %nl = load i64, ptr %nlp",
    "  %fits = icmp sle i64 %nl, %sl",
    "  br i1 %fits, label %cmp, label %no",
    "cmp:",
    "  %off = sub i64 %sl, %nl",
    "  %sd0 = getelementptr i8, ptr %s, i64 16",
    "  %sd = getelementptr i8, ptr %sd0, i64 %off",
    "  %nd = getelementptr i8, ptr %n, i64 16",
    "  %c = call i32 @memcmp(ptr %sd, ptr %nd, i64 %nl)",
    "  %eq = icmp eq i32 %c, 0",
    "  ret i1 %eq",
    "no:",
    "  ret i1 0",
    "}",
    "",
    "; `s.split(sep)`. An EMPTY separator splits at every position,",
    "; which yields an empty string at each END as well as one codepoint",
    "; each in between -- `\"abc\".split(\"\")` is five elements, not three.",
    "; That is the real compiler's behaviour, and it is why its own",
    "; `chars_of` is `s.split(\"\").filter(|c| c != \"\")` rather than just",
    "; `s.split(\"\")`. Matching it exactly matters more than picking the",
    "; tidier semantics: a program that splits on \"\" must not behave",
    "; differently under the two backends.",
    "define ptr @plum_str_split(ptr %s, ptr %sep) {",
    "entry:",
    "  %seplenp = getelementptr i8, ptr %sep, i64 8",
    "  %seplen = load i64, ptr %seplenp",
    "  %isempty = icmp eq i64 %seplen, 0",
    "  br i1 %isempty, label %chars, label %split",
    "chars:",
    "  %cs = call ptr @plum_chars_of(ptr %s)",
    "  %clen = call i64 @plum_array_len(ptr %cs)",
    "  %olen = add i64 %clen, 2",
    "  %co = call ptr @plum_array_new(i64 %olen)",
    "  %empty1 = call ptr @plum_str_new(ptr @.plum_fmt_line, i64 0)",
    "  %e0 = getelementptr i8, ptr %co, i64 16",
    "  store ptr %empty1, ptr %e0",
    "  %cip = alloca i64",
    "  store i64 0, ptr %cip",
    "  br label %cloop",
    "cloop:",
    "  %ci = load i64, ptr %cip",
    "  %cmore = icmp slt i64 %ci, %clen",
    "  br i1 %cmore, label %cbody, label %cdone",
    "cbody:",
    "  %csoff = mul i64 %ci, 8",
    "  %csp0 = getelementptr i8, ptr %cs, i64 %csoff",
    "  %csp = getelementptr i8, ptr %csp0, i64 16",
    "  %cval = load ptr, ptr %csp",
    "  %cdi = add i64 %ci, 1",
    "  %cdoff = mul i64 %cdi, 8",
    "  %cdp0 = getelementptr i8, ptr %co, i64 %cdoff",
    "  %cdp = getelementptr i8, ptr %cdp0, i64 16",
    "  store ptr %cval, ptr %cdp",
    "  %ci1 = add i64 %ci, 1",
    "  store i64 %ci1, ptr %cip",
    "  br label %cloop",
    "cdone:",
    "  %lasti = add i64 %clen, 1",
    "  %lastoff = mul i64 %lasti, 8",
    "  %lastp0 = getelementptr i8, ptr %co, i64 %lastoff",
    "  %lastp = getelementptr i8, ptr %lastp0, i64 16",
    "  %empty2 = call ptr @plum_str_new(ptr @.plum_fmt_line, i64 0)",
    "  store ptr %empty2, ptr %lastp",
    "  ret ptr %co",
    "split:",
    "  %slenp = getelementptr i8, ptr %s, i64 8",
    "  %slen = load i64, ptr %slenp",
    "  %cap = add i64 %slen, 1",
    "  %out = call ptr @plum_array_new(i64 %cap)",
    "  %sd = getelementptr i8, ptr %s, i64 16",
    "  %nd = getelementptr i8, ptr %sep, i64 16",
    "  %posp = alloca i64",
    "  %np = alloca i64",
    "  store i64 0, ptr %posp",
    "  store i64 0, ptr %np",
    "  br label %loop",
    "loop:",
    "  %pos = load i64, ptr %posp",
    "  %at = call i64 @plum_str_find(ptr %sd, i64 %slen, ptr %nd, i64 %seplen, i64 %pos)",
    "  %found = icmp sge i64 %at, 0",
    "  br i1 %found, label %piece, label %tail",
    "piece:",
    "  %plen = sub i64 %at, %pos",
    "  %pstart = getelementptr i8, ptr %sd, i64 %pos",
    "  %pc = call ptr @plum_str_new(ptr %pstart, i64 %plen)",
    "  %n = load i64, ptr %np",
    "  %noff = mul i64 %n, 8",
    "  %sl0 = getelementptr i8, ptr %out, i64 %noff",
    "  %sl = getelementptr i8, ptr %sl0, i64 16",
    "  store ptr %pc, ptr %sl",
    "  %n1 = add i64 %n, 1",
    "  store i64 %n1, ptr %np",
    "  %nextpos = add i64 %at, %seplen",
    "  store i64 %nextpos, ptr %posp",
    "  br label %loop",
    "tail:",
    "  %tpos = load i64, ptr %posp",
    "  %tlen = sub i64 %slen, %tpos",
    "  %tstart = getelementptr i8, ptr %sd, i64 %tpos",
    "  %tc = call ptr @plum_str_new(ptr %tstart, i64 %tlen)",
    "  %tn = load i64, ptr %np",
    "  %tnoff = mul i64 %tn, 8",
    "  %tsl0 = getelementptr i8, ptr %out, i64 %tnoff",
    "  %tsl = getelementptr i8, ptr %tsl0, i64 16",
    "  store ptr %tc, ptr %tsl",
    "  %tn1 = add i64 %tn, 1",
    "  %toutlen = getelementptr i8, ptr %out, i64 8",
    "  store i64 %tn1, ptr %toutlen",
    "  ret ptr %out",
    "}",
    "",
    "define i1 @plum_println(ptr %s) {",
    "entry:",
    "  %d = getelementptr i8, ptr %s, i64 16",
    "  %r = call i32 (ptr, ...) @printf(ptr @.plum_fmt_line, ptr %d)",
    "  ret i1 0",
    "}",
    "",
    "@.plum_fmt_bare = private constant [3 x i8] c\"%s\\00\"",
    "",
    "; `print` -- `println` without the newline. Deliberately UNBUFFERED",
    "; beyond what libc does: the real compiler's own `print` writes",
    "; through the same `printf`, and a prompt written with `print` has",
    "; to appear before the read that follows it.",
    "; Exit with a status code and print NOTHING. `panic_raw` was the",
    "; only way this language could exit non-zero, and it prints its",
    "; message -- so `panic_raw(\"\")`, used to fail a test run, emitted a",
    "; stray blank line that the real compiler's report does not have.",
    "define i1 @plum_exit_raw(i64 %code) {",
    "entry:",
    "  %c = trunc i64 %code to i32",
    "  call void @exit(i32 %c)",
    "  ret i1 0",
    "}",
    "",
    "; Named for the STUB (`print_raw`), not for the visible `print`.",
    "; A Plum function mangles to `plum_` + its name, so a runtime",
    "; symbol `@plum_print` collides with the prelude's own `print` --",
    "; `invalid redefinition of function 'plum_print'`. Naming it after",
    "; the intercepted stub is what keeps `@plum_read_file_raw` and the",
    "; rest safe: a stub is never emitted, so its mangled name is free.",
    "define i1 @plum_print_raw(ptr %s) {",
    "entry:",
    "  %d = getelementptr i8, ptr %s, i64 16",
    "  %r = call i32 (ptr, ...) @printf(ptr @.plum_fmt_bare, ptr %d)",
    "  %f = call i32 @fflush(ptr null)",
    "  ret i1 0",
    "}",
    "",
    "; `env_var_raw` returns an ARRAY -- empty when the variable is",
    "; unset, one element when it is set. Same shape as",
    "; `@plum_read_file_raw`, and for the same reason: an array is a",
    "; representation this backend already has, where a `Result` at the",
    "; runtime boundary would need one built by hand.",
    "define ptr @plum_env_var_raw(ptr %name) {",
    "entry:",
    "  %n = getelementptr i8, ptr %name, i64 16",
    "  %v = call ptr @getenv(ptr %n)",
    "  %missing = icmp eq ptr %v, null",
    "  br i1 %missing, label %none, label %some",
    "none:",
    "  %empty = call ptr @plum_array_new(i64 0)",
    "  ret ptr %empty",
    "some:",
    "  %len = call i64 @strlen(ptr %v)",
    "  %cell = call ptr @plum_str_new(ptr %v, i64 %len)",
    "  %arr = call ptr @plum_array_new(i64 1)",
    // Element slot at 16, not 24: this runtime's array header differs
    // from the real backend's. Copying `@plum_alloc_array(..)` and a
    // 24-byte offset straight over from there produced an undefined
    // symbol AND would have been the wrong offset if it had linked.
    "  %slot = getelementptr i8, ptr %arr, i64 16",
    "  store ptr %cell, ptr %slot",
    "  ret ptr %arr",
    "}",
    "; --- end runtime ---",
    "",
])
