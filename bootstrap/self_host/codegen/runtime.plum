// Stage 5's RUNTIME — the fixed block of LLVM IR every program this
// backend emits is prefixed with. See `codegen.plum`'s own top comment
// for the backend as a whole.
//
// This is deliberately OURS, not borrowed from the real compiler.
// `crates/plum-codegen`'s runtime is ~3,000 lines and is parameterized
// by the program's own tag tables (it generates per-type `to_string`/
// equality/release functions), so there is no clean "just link against
// it" boundary to reuse — and writing this one is a few dozen lines,
// because Stage 5 leaks.
//
// **Stage 5 never frees.** No refcount word, no `plum_rc_inc`/`dec`, no
// FBIP. That is the single biggest simplification versus the real
// backend (3,293 lines of `plum-ir/src/fbip.rs`), and it is a legitimate
// choice for a bootstrap compiler: the workload is "start, compile one
// program, exit," where the OS reclaims everything at once. It is a
// scope cut, stated up front, not an oversight — and it is the first
// thing that would have to change for this backend to be used for
// long-running programs.
//
// **Cell layouts** (deliberately NOT the real backend's — those carry a
// refcount word this one has no use for):
//   Str:    { i64 len, i8 bytes[len], i8 0 }   — data at offset 8
//   Struct: { field0, field1, ... }            — 8 bytes per field
//   Enum:   { i64 tag, payload0, ... }         — payload at offset 8
// Every string keeps a trailing NUL that `.len()` never counts, purely
// so `printf("%s")` can be pointed straight at the bytes — the same
// trick, and the same reasoning, as the real backend's own string cells.

pub let cg_lines (lines: Array[String]): String = Array.fold(lines, "", |acc, l| acc.concat(l).concat("\n"))

pub let cg_runtime (unit: Unit): String = cg_lines([
    "; --- Stage 5 runtime (self-hosted backend) ---",
    "declare ptr @malloc(i64)",
    "declare i32 @printf(ptr, ...)",
    "declare i32 @snprintf(ptr, i64, ptr, ...)",
    "declare ptr @memcpy(ptr, ptr, i64)",
    "declare i32 @memcmp(ptr, ptr, i64)",
    "declare void @exit(i32)",
    "declare void @free(ptr)",
    "declare i64 @malloc_usable_size(ptr)",
    "declare ptr @getenv(ptr)",
    "declare i32 @dprintf(i32, ptr, ...)",
    "declare i32 @atexit(ptr)",
    "",
    "; Allocation counters, dumped at exit when PLUM_RT_STATS is set.",
    "; The real backend grew the same thing (PLUM_ALLOC_STATS) and it is",
    "; what turned three guessed-at performance problems into measured",
    "; ones -- so this backend gets it before guessing rather than after.",
    "@plum_n_alloc = global i64 0",
    "@plum_n_str = global i64 0",
    "@plum_n_concat = global i64 0",
    "@plum_n_array = global i64 0",
    "@plum_b_alloc = global i64 0",
    "@.plum_stats_env = private constant [14 x i8] c\"PLUM_RT_STATS\\00\"",
    "@.plum_stats_fmt = private constant [69 x i8] c\"[plum-rt] alloc n=%lld bytes=%lld | str=%lld concat=%lld array=%lld\\0A\\00\"",
    "declare ptr @fopen(ptr, ptr)",
    "declare i64 @fread(ptr, i64, i64, ptr)",
    "declare i32 @fclose(ptr)",
    "declare i32 @fseek(ptr, i64, i32)",
    "declare i64 @ftell(ptr)",
    "declare i64 @strlen(ptr)",
    "",
    "; argc/argv, stashed by the C entry point so `args()` can reach",
    "; them. The real backend keeps the same pair of globals for the same",
    "; reason -- there is nowhere else for a process's own arguments to",
    "; live.",
    "@plum_argc = global i32 0",
    "@plum_argv = global ptr null",
    "@.plum_mode_r = private constant [3 x i8] c\"rb\\00\"",
    "",
    "; Directory access, via the SAME C shims the real compiler uses",
    "; (`dir_shim.c`). They are already linked into every binary `plum",
    "; compile-ir` produces, so declaring them is all it takes -- no",
    "; second copy of the platform code, and no divergence between what",
    "; the two backends mean by `list_dir`.",
    "declare i64 @dir_open(ptr)",
    "declare ptr @dir_read_next(i64)",
    "declare void @dir_close(i64)",
    "declare i64 @path_is_dir(ptr)",
    "",
    "@.plum_fmt_int = private constant [5 x i8] c\"%lld\\00\"",
    "@.plum_fmt_float = private constant [6 x i8] c\"%.15g\\00\"",
    "@.plum_fmt_line = private constant [4 x i8] c\"%s\\0A\\00\"",
    "@.plum_true = private constant [5 x i8] c\"true\\00\"",
    "@.plum_false = private constant [6 x i8] c\"false\\00\"",
    "",
    "; The one allocation point. Every cell begins with a reference",
    "; count, initialised to 1: the caller of an allocating expression",
    "; owns the result. Nothing decrements it yet -- the ownership",
    "; discipline is a separate change -- so this still leaks, but every",
    "; cell is now SHAPED for it.",
    "define void @plum_dump_stats() {",
    "entry:",
    "  %e = call ptr @getenv(ptr @.plum_stats_env)",
    "  %off = icmp eq ptr %e, null",
    "  br i1 %off, label %skip, label %dump",
    "skip:",
    "  ret void",
    "dump:",
    "  %n = load i64, ptr @plum_n_alloc",
    "  %b = load i64, ptr @plum_b_alloc",
    "  %s1 = load i64, ptr @plum_n_str",
    "  %c1 = load i64, ptr @plum_n_concat",
    "  %a1 = load i64, ptr @plum_n_array",
    "  %r = call i32 (i32, ptr, ...) @dprintf(i32 2, ptr @.plum_stats_fmt, i64 %n, i64 %b, i64 %s1, i64 %c1, i64 %a1)",
    "  ret void",
    "}",
    "",
    "define ptr @plum_alloc(i64 %size) {",
    "entry:",
    "  %pn = load i64, ptr @plum_n_alloc",
    "  %pn1 = add i64 %pn, 1",
    "  store i64 %pn1, ptr @plum_n_alloc",
    "  %pb = load i64, ptr @plum_b_alloc",
    "  %pb1 = add i64 %pb, %size",
    "  store i64 %pb1, ptr @plum_b_alloc",
    "  %cell = call ptr @malloc(i64 %size)",
    "  store i64 1, ptr %cell",
    "  ret ptr %cell",
    "}",
    "",
    "; Every inc/release is NULL-TOLERANT. Heap slots are initialised to",
    "; null so that a slot inside a loop can release its previous value",
    "; before storing a new one without the first iteration reading",
    "; uninitialised stack -- the null check is what makes that safe.",
    "define void @plum_rc_inc(ptr %p) {",
    "entry:",
    "  %isnull = icmp eq ptr %p, null",
    "  br i1 %isnull, label %skip, label %live",
    "skip:",
    "  ret void",
    "live:",
    "  %rc = load i64, ptr %p",
    "  %static = icmp slt i64 %rc, 0",
    "  br i1 %static, label %skip, label %bump",
    "bump:",
    "  %rc1 = add i64 %rc, 1",
    "  store i64 %rc1, ptr %p",
    "  ret void",
    "}",
    "",
    "; A closure cell carries a pointer to a release function generated",
    "; at its own literal's creation site, which is the only place that",
    "; knows what it captured -- a closure's captures are invisible from",
    "; its type. That companion releases the captures; this frees the",
    "; cell.",
    "define void @plum_rel_closure(ptr %p) {",
    "entry:",
    "  %isnull = icmp eq ptr %p, null",
    "  br i1 %isnull, label %skip, label %live",
    "skip:",
    "  ret void",
    "live:",
    "  %rc = load i64, ptr %p",
    "  %static = icmp slt i64 %rc, 0",
    "  br i1 %static, label %skip, label %dec",
    "dec:",
    "  %rc1 = sub i64 %rc, 1",
    "  store i64 %rc1, ptr %p",
    "  %dead = icmp sle i64 %rc1, 0",
    "  br i1 %dead, label %free, label %alive",
    "alive:",
    "  ret void",
    "free:",
    "  %relp = getelementptr i8, ptr %p, i64 16",
    "  %rel = load ptr, ptr %relp",
    "  call void %rel(ptr %p)",
    "  call void @free(ptr %p)",
    "  ret void",
    "}",
    "",
    "; A String owns nothing, so its release needs no generated",
    "; per-type function.",
    "define void @plum_rel_str(ptr %p) {",
    "entry:",
    "  %isnull = icmp eq ptr %p, null",
    "  br i1 %isnull, label %skip, label %live",
    "skip:",
    "  ret void",
    "live:",
    "  %rc = load i64, ptr %p",
    "  %static = icmp slt i64 %rc, 0",
    "  br i1 %static, label %skip, label %dec",
    "dec:",
    "  %rc1 = sub i64 %rc, 1",
    "  store i64 %rc1, ptr %p",
    "  %dead = icmp sle i64 %rc1, 0",
    "  br i1 %dead, label %free, label %alive",
    "alive:",
    "  ret void",
    "free:",
    "  call void @free(ptr %p)",
    "  ret void",
    "}",
    "",
    "; A string cell from raw bytes + a byte length.",
    "define ptr @plum_str_new(ptr %bytes, i64 %len) {",
    "entry:",
    "  %sn = load i64, ptr @plum_n_str",
    "  %sn1 = add i64 %sn, 1",
    "  store i64 %sn1, ptr @plum_n_str",
    "  %size = add i64 %len, 17",
    "  %cell = call ptr @plum_alloc(i64 %size)",
    "  %lenp = getelementptr i8, ptr %cell, i64 8",
    "  store i64 %len, ptr %lenp",
    "  %data = getelementptr i8, ptr %cell, i64 16",
    "  %ignore = call ptr @memcpy(ptr %data, ptr %bytes, i64 %len)",
    "  %endp = getelementptr i8, ptr %data, i64 %len",
    "  store i8 0, ptr %endp",
    "  ret ptr %cell",
    "}",
    "",
    "define ptr @plum_str_concat(ptr %a, ptr %b) {",
    "entry:",
    "  %cn = load i64, ptr @plum_n_concat",
    "  %cn1 = add i64 %cn, 1",
    "  store i64 %cn1, ptr @plum_n_concat",
    "  %lap = getelementptr i8, ptr %a, i64 8",
    "  %la = load i64, ptr %lap",
    "  %lbp = getelementptr i8, ptr %b, i64 8",
    "  %lb = load i64, ptr %lbp",
    "  %lt = add i64 %la, %lb",
    "  %size = add i64 %lt, 17",
    "  %cell = call ptr @plum_alloc(i64 %size)",
    "  %ltp = getelementptr i8, ptr %cell, i64 8",
    "  store i64 %lt, ptr %ltp",
    "  %data = getelementptr i8, ptr %cell, i64 16",
    "  %da = getelementptr i8, ptr %a, i64 16",
    "  %db = getelementptr i8, ptr %b, i64 16",
    "  %i1 = call ptr @memcpy(ptr %data, ptr %da, i64 %la)",
    "  %d2 = getelementptr i8, ptr %data, i64 %la",
    "  %i2 = call ptr @memcpy(ptr %d2, ptr %db, i64 %lb)",
    "  %endp = getelementptr i8, ptr %data, i64 %lt",
    "  store i8 0, ptr %endp",
    "  ret ptr %cell",
    "}",
    "",
    "; `a.concat(b)` where `a` is provably DEAD afterwards -- emitted",
    "; only for a self-rebinding assignment (`acc = acc.concat(x)`),",
    "; where the slot is overwritten with the result and so cannot",
    "; observe a mutation.",
    ";",
    "; Two conditions, both checked at RUNTIME: the cell must be",
    "; uniquely referenced (rc == 1, which the slot's own reference",
    "; accounts for), and its allocation must have room. Capacity is",
    "; DERIVED with `malloc_usable_size` rather than stored -- the same",
    "; trick, and the same reasoning, as the real backend's own",
    "; `StrConcatReuse`: a stored capacity word would move every",
    "; string's data offset for the benefit of one operation.",
    ";",
    "; It CONSUMES %a either way. In the reuse path that is free (the",
    "; reference moves into the result); in the copy path it releases,",
    "; so the caller never has to know which happened.",
    "define ptr @plum_str_concat_reuse(ptr %a, ptr %b) {",
    "entry:",
    "  %rc = load i64, ptr %a",
    "  %uniq = icmp eq i64 %rc, 1",
    "  br i1 %uniq, label %maybe, label %copy",
    "maybe:",
    "  %lap = getelementptr i8, ptr %a, i64 8",
    "  %la = load i64, ptr %lap",
    "  %lbp = getelementptr i8, ptr %b, i64 8",
    "  %lb = load i64, ptr %lbp",
    "  %need = add i64 %la, %lb",
    "  %need17 = add i64 %need, 17",
    "  %usable = call i64 @malloc_usable_size(ptr %a)",
    "  %fits = icmp sle i64 %need17, %usable",
    "  br i1 %fits, label %inplace, label %copy",
    "inplace:",
    "  %dst0 = getelementptr i8, ptr %a, i64 16",
    "  %dst = getelementptr i8, ptr %dst0, i64 %la",
    "  %src = getelementptr i8, ptr %b, i64 16",
    "  %ig = call ptr @memcpy(ptr %dst, ptr %src, i64 %lb)",
    "  store i64 %need, ptr %lap",
    "  %endp = getelementptr i8, ptr %dst, i64 %lb",
    "  store i8 0, ptr %endp",
    "  ret ptr %a",
    "copy:",
    "  %new = call ptr @plum_str_concat(ptr %a, ptr %b)",
    "  call void @plum_rel_str(ptr %a)",
    "  ret ptr %new",
    "}",
    "",
    "define i64 @plum_str_len(ptr %s) {",
    "entry:",
    "  %lp = getelementptr i8, ptr %s, i64 8",
    "  %l = load i64, ptr %lp",
    "  ret i64 %l",
    "}",
    "",
    "; Byte-exact equality: same length, then memcmp. Not a collation",
    "; comparison -- Plum's own `==` on String is byte equality too.",
    "define i1 @plum_str_eq(ptr %a, ptr %b) {",
    "entry:",
    "  %lap = getelementptr i8, ptr %a, i64 8",
    "  %la = load i64, ptr %lap",
    "  %lbp = getelementptr i8, ptr %b, i64 8",
    "  %lb = load i64, ptr %lbp",
    "  %same_len = icmp eq i64 %la, %lb",
    "  br i1 %same_len, label %cmp, label %no",
    "cmp:",
    "  %da = getelementptr i8, ptr %a, i64 16",
    "  %db = getelementptr i8, ptr %b, i64 16",
    "  %c = call i32 @memcmp(ptr %da, ptr %db, i64 %la)",
    "  %eq = icmp eq i32 %c, 0",
    "  ret i1 %eq",
    "no:",
    "  ret i1 0",
    "}",
    "",
    "define ptr @plum_int_to_string(i64 %n) {",
    "entry:",
    "  %buf = call ptr @malloc(i64 32)",
    "  %len32 = call i32 (ptr, i64, ptr, ...) @snprintf(ptr %buf, i64 32, ptr @.plum_fmt_int, i64 %n)",
    "  %len = sext i32 %len32 to i64",
    "  %s = call ptr @plum_str_new(ptr %buf, i64 %len)",
    // `plum_str_new` COPIES the bytes into the new cell, so the
    // scratch buffer is dead the moment it returns. Leaving it
    // unfreed leaked 32 bytes per `.to_string()` call -- invisible in
    // a fixture, unbounded in a loop.
    "  call void @free(ptr %buf)",
    "  ret ptr %s",
    "}",
    "",
    "; `%.15g` matches the real backend's own float formatting exactly",
    "; (crates/plum-codegen's @plum_tostr_fmt_float) -- chosen so both",
    "; backends print a Float identically and exec_corpus goldens can be",
    "; shared between them without a second set of expectations.",
    "define ptr @plum_float_to_string(double %f) {",
    "entry:",
    "  %buf = call ptr @malloc(i64 64)",
    "  %len32 = call i32 (ptr, i64, ptr, ...) @snprintf(ptr %buf, i64 64, ptr @.plum_fmt_float, double %f)",
    "  %len = sext i32 %len32 to i64",
    "  %s = call ptr @plum_str_new(ptr %buf, i64 %len)",
    // `plum_str_new` COPIES the bytes into the new cell, so the
    // scratch buffer is dead the moment it returns. Leaving it
    // unfreed leaked 32 bytes per `.to_string()` call -- invisible in
    // a fixture, unbounded in a loop.
    "  call void @free(ptr %buf)",
    "  ret ptr %s",
    "}",
    "",
    "define ptr @plum_bool_to_string(i1 %b) {",
    "entry:",
    "  br i1 %b, label %t, label %f",
    "t:",
    "  %st = call ptr @plum_str_new(ptr @.plum_true, i64 4)",
    "  ret ptr %st",
    "f:",
    "  %sf = call ptr @plum_str_new(ptr @.plum_false, i64 5)",
    "  ret ptr %sf",
    "}",
    "",
    "; Array cell: { i64 len, elem0, elem1, ... } -- 8 bytes per element",
    "; regardless of the element's own width, so an element address is",
    "; 8 + 8*index with no alignment arithmetic. Same trade the struct",
    "; layout makes: space for a one-line offset rule.",
    "; An array cell whose CAPACITY may exceed its length. Only the",
    "; growth path needs this; `plum_array_new` is the exact-fit case.",
    "define ptr @plum_array_new_cap(i64 %len, i64 %cap) {",
    "entry:",
    "  %an0 = load i64, ptr @plum_n_array",
    "  %an01 = add i64 %an0, 1",
    "  store i64 %an01, ptr @plum_n_array",
    "  %bytes0 = mul i64 %cap, 8",
    "  %size0 = add i64 %bytes0, 16",
    "  %cell0 = call ptr @plum_alloc(i64 %size0)",
    "  %lenp0 = getelementptr i8, ptr %cell0, i64 8",
    "  store i64 %len, ptr %lenp0",
    "  ret ptr %cell0",
    "}",
    "",
    "define ptr @plum_array_new(i64 %len) {",
    "entry:",
    "  %an = load i64, ptr @plum_n_array",
    "  %an1 = add i64 %an, 1",
    "  store i64 %an1, ptr @plum_n_array",
    "  %bytes = mul i64 %len, 8",
    "  %size = add i64 %bytes, 16",
    "  %cell = call ptr @plum_alloc(i64 %size)",
    "  %lenp = getelementptr i8, ptr %cell, i64 8",
    "  store i64 %len, ptr %lenp",
    "  ret ptr %cell",
    "}",
    "",
    "; Copies %n ELEMENTS (not bytes) from one array cell's data region",
    "; into another's. Used by push/set, which are pure: they build a new",
    "; cell rather than mutating the old one, matching Plum's semantics.",
    "define i1 @plum_array_copy(ptr %dst, ptr %src, i64 %n) {",
    "entry:",
    "  %bytes = mul i64 %n, 8",
    "  %d = getelementptr i8, ptr %dst, i64 16",
    "  %s = getelementptr i8, ptr %src, i64 16",
    "  %i = call ptr @memcpy(ptr %d, ptr %s, i64 %bytes)",
    "  ret i1 0",
    "}",
    "",
    "; Increments the first %n element slots. `push`/`set` build a new",
    "; cell and `memcpy` the old elements into it -- which copies",
    "; POINTERS, so both arrays now reference the same children and both",
    "; will release them. The copy needs its own references.",
    "define i1 @plum_array_inc_elems(ptr %a, i64 %n) {",
    "entry:",
    "  %ip = alloca i64",
    "  store i64 0, ptr %ip",
    "  br label %loop",
    "loop:",
    "  %i = load i64, ptr %ip",
    "  %more = icmp slt i64 %i, %n",
    "  br i1 %more, label %body, label %done",
    "body:",
    "  %off = mul i64 %i, 8",
    "  %ep0 = getelementptr i8, ptr %a, i64 %off",
    "  %ep = getelementptr i8, ptr %ep0, i64 16",
    "  %ev = load ptr, ptr %ep",
    "  call void @plum_rc_inc(ptr %ev)",
    "  %i1 = add i64 %i, 1",
    "  store i64 %i1, ptr %ip",
    "  br label %loop",
    "done:",
    "  ret i1 0",
    "}",
    "",
    "; `Array.concat` as a single allocation. The prelude's version is",
    "; `array_concat_acc(a.push(b[i]), b, i + 1)` -- one `push` per",
    "; element, and every `push` copies the whole array, so concatenating",
    "; an n-element array costs O(n^2) BYTES. That shape has caused three",
    "; separate blowups in this project already.",
    ";",
    "; Two variants because the elements' ownership differs: a result",
    "; holding heap elements needs its own reference to each, and one",
    "; holding Ints must not touch them. The call site picks by the",
    "; instantiated type argument -- see `cg_fn_call`.",
    "define ptr @plum_array_concat(ptr %a, ptr %b) {",
    "entry:",
    "  %lap = getelementptr i8, ptr %a, i64 8",
    "  %la = load i64, ptr %lap",
    "  %lbp = getelementptr i8, ptr %b, i64 8",
    "  %lb = load i64, ptr %lbp",
    "  %lt = add i64 %la, %lb",
    "  %out = call ptr @plum_array_new(i64 %lt)",
    "  %i1 = call i1 @plum_array_copy(ptr %out, ptr %a, i64 %la)",
    "  %aoff = mul i64 %la, 8",
    "  %d0 = getelementptr i8, ptr %out, i64 16",
    "  %d = getelementptr i8, ptr %d0, i64 %aoff",
    "  %s = getelementptr i8, ptr %b, i64 16",
    "  %bbytes = mul i64 %lb, 8",
    "  %i2 = call ptr @memcpy(ptr %d, ptr %s, i64 %bbytes)",
    "  ret ptr %out",
    "}",
    "",
    "define ptr @plum_array_concat_heap(ptr %a, ptr %b) {",
    "entry:",
    "  %out = call ptr @plum_array_concat(ptr %a, ptr %b)",
    "  %lt = call i64 @plum_array_len(ptr %out)",
    "  %ig = call i1 @plum_array_inc_elems(ptr %out, i64 %lt)",
    "  ret ptr %out",
    "}",
    "",
    "; Makes room for ONE more element in an array that is provably dead",
    "; afterwards -- emitted only for `acc = acc.push(x)`, where the slot",
    "; is overwritten with the result and so cannot observe a mutation.",
    ";",
    "; Same two runtime conditions as the string version: uniquely",
    "; referenced, and the allocation has room. Capacity is DERIVED with",
    "; `malloc_usable_size`, so growing in place happens exactly when",
    "; malloc already handed us the space -- no capacity word, and no",
    "; growth policy of our own.",
    ";",
    "; `%heap` says whether the elements are themselves counted; on the",
    "; COPY path they gain a reference each, on the reuse path nothing",
    "; moves. The caller cannot make that choice because it does not know",
    "; which path ran.",
    ";",
    "; It CONSUMES %a either way, and returns a cell whose length has",
    "; already been bumped -- the caller stores the new element at the",
    "; last index.",
    "define ptr @plum_array_push_grow(ptr %a, i1 %heap, ptr %rel) {",
    "entry:",
    "  %rc = load i64, ptr %a",
    "  %uniq = icmp eq i64 %rc, 1",
    "  br i1 %uniq, label %maybe, label %copy",
    "maybe:",
    "  %lp = getelementptr i8, ptr %a, i64 8",
    "  %len = load i64, ptr %lp",
    "  %newlen = add i64 %len, 1",
    "  %need = mul i64 %newlen, 8",
    "  %need16 = add i64 %need, 16",
    "  %usable = call i64 @malloc_usable_size(ptr %a)",
    "  %fits = icmp sle i64 %need16, %usable",
    "  br i1 %fits, label %inplace, label %copy",
    "inplace:",
    "  store i64 %newlen, ptr %lp",
    "  ret ptr %a",
    "copy:",
    "  %clp = getelementptr i8, ptr %a, i64 8",
    "  %clen = load i64, ptr %clp",
    "  %cnew = add i64 %clen, 1",
    "  ; DOUBLE, so the next pushes hit the in-place path and the whole",
    "  ; accumulation is amortized O(1) rather than accidentally so. The",
    "  ; extra space is invisible: `len` is still the true element count,",
    "  ; and capacity is whatever malloc_usable_size reports.",
    "  %dbl = mul i64 %cnew, 2",
    "  %out = call ptr @plum_array_new_cap(i64 %cnew, i64 %dbl)",
    "  %ig = call i1 @plum_array_copy(ptr %out, ptr %a, i64 %clen)",
    "  br i1 %heap, label %bump, label %release",
    "bump:",
    "  %ig2 = call i1 @plum_array_inc_elems(ptr %out, i64 %clen)",
    "  br label %release",
    "release:",
    "  ; The old array was consumed. Its release function is passed in",
    "  ; because the runtime cannot name it: it depends on the element",
    "  ; type. Forgetting this leaked every intermediate array and cost",
    "  ; 3.1GB of peak RSS.",
    "  call void %rel(ptr %a)",
    "  ret ptr %out",
    "}",
    "",
    "define i64 @plum_array_len(ptr %a) {",
    "entry:",
    "  %lp = getelementptr i8, ptr %a, i64 8",
    "  %l = load i64, ptr %lp",
    "  ret i64 %l",
    "}",
    "",
    "; `chars_of(s)` -- one single-codepoint String per UTF-8 codepoint.",
    ";",
    "; A PRIMITIVE, not prelude Plum, because it is where codepoint",
    "; awareness has to live: the real compiler spells it `s.split(\"\")`",
    "; and gets the same behaviour from its own split primitive. Every",
    "; other string routine in the prelude (`String.slice`,",
    "; `String.index_of`, `String.parse_int`, ...) is built on top of",
    "; this, so getting it right here is what makes all of them",
    "; multi-byte-safe rather than each needing its own care.",
    ";",
    "; A continuation byte is `10xxxxxx`; anything else starts a",
    "; codepoint. The output array is allocated at the BYTE length (an",
    "; upper bound on the codepoint count) and its length header patched",
    "; down afterwards -- the same over-allocate-and-shrink shape",
    "; `Array.filter` uses.",
    "define ptr @plum_chars_of(ptr %s) {",
    "entry:",
    "  %lenp = getelementptr i8, ptr %s, i64 8",
    "  %len = load i64, ptr %lenp",
    "  %data = getelementptr i8, ptr %s, i64 16",
    "  %out = call ptr @plum_array_new(i64 %len)",
    "  %ip = alloca i64",
    "  %np = alloca i64",
    "  store i64 0, ptr %ip",
    "  store i64 0, ptr %np",
    "  br label %outer",
    "outer:",
    "  %i = load i64, ptr %ip",
    "  %more = icmp slt i64 %i, %len",
    "  br i1 %more, label %chstart, label %done",
    "chstart:",
    "  %start = load i64, ptr %ip",
    "  %i1 = add i64 %start, 1",
    "  store i64 %i1, ptr %ip",
    "  br label %cont",
    "cont:",
    "  %j = load i64, ptr %ip",
    "  %inrange = icmp slt i64 %j, %len",
    "  br i1 %inrange, label %checkbyte, label %emit",
    "checkbyte:",
    "  %bp = getelementptr i8, ptr %data, i64 %j",
    "  %b = load i8, ptr %bp",
    "  %masked = and i8 %b, -64",
    "  %iscont = icmp eq i8 %masked, -128",
    "  br i1 %iscont, label %advance, label %emit",
    "advance:",
    "  %j1 = add i64 %j, 1",
    "  store i64 %j1, ptr %ip",
    "  br label %cont",
    "emit:",
    "  %end = load i64, ptr %ip",
    "  %clen = sub i64 %end, %start",
    "  %cstart = getelementptr i8, ptr %data, i64 %start",
    "  %ch = call ptr @plum_str_new(ptr %cstart, i64 %clen)",
    "  %n = load i64, ptr %np",
    "  %noff = mul i64 %n, 8",
    "  %slot0 = getelementptr i8, ptr %out, i64 %noff",
    "  %slot = getelementptr i8, ptr %slot0, i64 16",
    "  store ptr %ch, ptr %slot",
    "  %n1 = add i64 %n, 1",
    "  store i64 %n1, ptr %np",
    "  br label %outer",
    "done:",
    "  %final = load i64, ptr %np",
    "  %outlen = getelementptr i8, ptr %out, i64 8",
    "  store i64 %final, ptr %outlen",
    "  ret ptr %out",
    "}",
    "",
    "; `panic_raw` is a hard process abort, matching the real backend",
    "; (`@plum_abort`: print then `exit(1)`) rather than the",
    "; interpreter's catchable error. The message goes to stdout, which",
    "; is where the real one puts it too, so a panicking program's output",
    "; compares byte-for-byte across both backends.",
    "define i1 @plum_panic(ptr %s) {",
    "entry:",
    "  %d = getelementptr i8, ptr %s, i64 16",
    "  %r = call i32 (ptr, ...) @printf(ptr @.plum_fmt_line, ptr %d)",
    "  call void @exit(i32 1)",
    "  ret i1 0",
    "}",
    "",
    "; `args()` -- the process arguments AFTER the program name,",
    "; matching the real `args()` exactly (which is why the loop starts",
    "; at 1). Each is copied into a Plum string cell rather than",
    "; aliasing the C one, since a Plum string is length-prefixed.",
    "define ptr @plum_args() {",
    "entry:",
    "  %argc32 = load i32, ptr @plum_argc",
    "  %argc = sext i32 %argc32 to i64",
    "  %argv = load ptr, ptr @plum_argv",
    "  %n = sub i64 %argc, 1",
    "  %neg = icmp slt i64 %n, 0",
    "  %count = select i1 %neg, i64 0, i64 %n",
    "  %out = call ptr @plum_array_new(i64 %count)",
    "  %ip = alloca i64",
    "  store i64 0, ptr %ip",
    "  br label %loop",
    "loop:",
    "  %i = load i64, ptr %ip",
    "  %more = icmp slt i64 %i, %count",
    "  br i1 %more, label %body, label %done",
    "body:",
    "  %ai = add i64 %i, 1",
    "  %aoff = mul i64 %ai, 8",
    "  %ap = getelementptr i8, ptr %argv, i64 %aoff",
    "  %cstr = load ptr, ptr %ap",
    "  %clen = call i64 @strlen(ptr %cstr)",
    "  %cell = call ptr @plum_str_new(ptr %cstr, i64 %clen)",
    "  %ooff = mul i64 %i, 8",
    "  %op0 = getelementptr i8, ptr %out, i64 %ooff",
    "  %op = getelementptr i8, ptr %op0, i64 16",
    "  store ptr %cell, ptr %op",
    "  %i1 = add i64 %i, 1",
    "  store i64 %i1, ptr %ip",
    "  br label %loop",
    "done:",
    "  ret ptr %out",
    "}",
    "",
    "; `read_file_raw` returns an ARRAY: empty on failure, one element",
    "; holding the contents on success.",
    ";",
    "; It does NOT return a `Result` directly, deliberately. A `Result`",
    "; is an ordinary enum whose tag numbers are assigned per program by",
    "; the backend, so hand-written runtime IR cannot construct one",
    "; without hard-coding a layout decision made elsewhere. Returning a",
    "; plain array lets the PRELUDE wrap it in Plum, where `Ok`/`Err`",
    "; mean what the program says they mean.",
    "define ptr @plum_read_file_raw(ptr %path) {",
    "entry:",
    "  %pd = getelementptr i8, ptr %path, i64 16",
    "  %f = call ptr @fopen(ptr %pd, ptr @.plum_mode_r)",
    "  %isnull = icmp eq ptr %f, null",
    "  br i1 %isnull, label %fail, label %open",
    "open:",
    "  %seek = call i32 @fseek(ptr %f, i64 0, i32 2)",
    "  %size = call i64 @ftell(ptr %f)",
    "  %rew = call i32 @fseek(ptr %f, i64 0, i32 0)",
    "  %bufsize = add i64 %size, 1",
    "  %buf = call ptr @malloc(i64 %bufsize)",
    "  %got = call i64 @fread(ptr %buf, i64 1, i64 %size, ptr %f)",
    "  %closed = call i32 @fclose(ptr %f)",
    "  %cell = call ptr @plum_str_new(ptr %buf, i64 %got)",
    // Same as the `to_string` buffers: the cell owns a copy now. This
    // one leaked the WHOLE FILE on every read.
    "  call void @free(ptr %buf)",
    "  %out = call ptr @plum_array_new(i64 1)",
    "  %slot = getelementptr i8, ptr %out, i64 16",
    "  store ptr %cell, ptr %slot",
    "  ret ptr %out",
    "fail:",
    "  %empty = call ptr @plum_array_new(i64 0)",
    "  ret ptr %empty",
    "}",
    "",
    "define i64 @plum_path_is_dir(ptr %path) {",
    "entry:",
    "  %pd = getelementptr i8, ptr %path, i64 16",
    "  %r = call i64 @path_is_dir(ptr %pd)",
    "  ret i64 %r",
    "}",
    "",
    "define i64 @plum_dir_open(ptr %path) {",
    "entry:",
    "  %pd = getelementptr i8, ptr %path, i64 16",
    "  %h = call i64 @dir_open(ptr %pd)",
    "  ret i64 %h",
    "}",
    "",
    "; The shim hands back a NUL-terminated C string, empty when the",
    "; directory is exhausted; this copies it into a Plum string cell.",
    "define ptr @plum_dir_next(i64 %h) {",
    "entry:",
    "  %c = call ptr @dir_read_next(i64 %h)",
    "  %n = call i64 @strlen(ptr %c)",
    "  %s = call ptr @plum_str_new(ptr %c, i64 %n)",
    "  ret ptr %s",
    "}",
    "",
    "define i1 @plum_dir_close(i64 %h) {",
    "entry:",
    "  call void @dir_close(i64 %h)",
    "  ret i1 0",
    "}",
    "",
    "@.plum_oob = private constant [26 x i8] c\"array index out of bounds\\00\"",
    "",
    "; A failed bounds check aborts with the SAME message the real",
    "; backend produces (`emit_runtime_check`'s \"array index out of",
    "; bounds\") -- a program that indexes past the end must behave",
    "; identically under both, including what it prints.",
    "define void @plum_bounds_fail() {",
    "entry:",
    "  %r = call i32 (ptr, ...) @printf(ptr @.plum_fmt_line, ptr @.plum_oob)",
    "  call void @exit(i32 1)",
    "  ret void",
    "}",
    "",
    "; Byte-level substring search: the index of %nd within %h at or",
    "; after %from, or -1. Naive O(n*m) -- the real backend is no",
    "; cleverer, and a Boyer-Moore here would be optimizing a compiler",
    "; that leaks all its memory.",
    "define i64 @plum_str_find(ptr %h, i64 %hlen, ptr %nd, i64 %nlen, i64 %from) {",
    "entry:",
    "  %last = sub i64 %hlen, %nlen",
    "  %ip = alloca i64",
    "  store i64 %from, ptr %ip",
    "  br label %loop",
    "loop:",
    "  %i = load i64, ptr %ip",
    "  %ok = icmp sle i64 %i, %last",
    "  br i1 %ok, label %test, label %miss",
    "test:",
    "  %hp = getelementptr i8, ptr %h, i64 %i",
    "  %c = call i32 @memcmp(ptr %hp, ptr %nd, i64 %nlen)",
    "  %eq = icmp eq i32 %c, 0",
    "  br i1 %eq, label %hit, label %next",
    "next:",
    "  %i1 = add i64 %i, 1",
    "  store i64 %i1, ptr %ip",
    "  br label %loop",
    "hit:",
    "  ret i64 %i",
    "miss:",
    "  ret i64 -1",
    "}",
    "",
    "define i1 @plum_str_contains(ptr %s, ptr %n) {",
    "entry:",
    "  %slp = getelementptr i8, ptr %s, i64 8",
    "  %sl = load i64, ptr %slp",
    "  %nlp = getelementptr i8, ptr %n, i64 8",
    "  %nl = load i64, ptr %nlp",
    "  %sd = getelementptr i8, ptr %s, i64 16",
    "  %nd = getelementptr i8, ptr %n, i64 16",
    "  %at = call i64 @plum_str_find(ptr %sd, i64 %sl, ptr %nd, i64 %nl, i64 0)",
    "  %found = icmp sge i64 %at, 0",
    "  ret i1 %found",
    "}",
    "",
    "define i1 @plum_str_starts_with(ptr %s, ptr %n) {",
    "entry:",
    "  %slp = getelementptr i8, ptr %s, i64 8",
    "  %sl = load i64, ptr %slp",
    "  %nlp = getelementptr i8, ptr %n, i64 8",
    "  %nl = load i64, ptr %nlp",
    "  %fits = icmp sle i64 %nl, %sl",
    "  br i1 %fits, label %cmp, label %no",
    "cmp:",
    "  %sd = getelementptr i8, ptr %s, i64 16",
    "  %nd = getelementptr i8, ptr %n, i64 16",
    "  %c = call i32 @memcmp(ptr %sd, ptr %nd, i64 %nl)",
    "  %eq = icmp eq i32 %c, 0",
    "  ret i1 %eq",
    "no:",
    "  ret i1 0",
    "}",
    "",
    "define i1 @plum_str_ends_with(ptr %s, ptr %n) {",
    "entry:",
    "  %slp = getelementptr i8, ptr %s, i64 8",
    "  %sl = load i64, ptr %slp",
    "  %nlp = getelementptr i8, ptr %n, i64 8",
    "  %nl = load i64, ptr %nlp",
    "  %fits = icmp sle i64 %nl, %sl",
    "  br i1 %fits, label %cmp, label %no",
    "cmp:",
    "  %off = sub i64 %sl, %nl",
    "  %sd0 = getelementptr i8, ptr %s, i64 16",
    "  %sd = getelementptr i8, ptr %sd0, i64 %off",
    "  %nd = getelementptr i8, ptr %n, i64 16",
    "  %c = call i32 @memcmp(ptr %sd, ptr %nd, i64 %nl)",
    "  %eq = icmp eq i32 %c, 0",
    "  ret i1 %eq",
    "no:",
    "  ret i1 0",
    "}",
    "",
    "; `s.split(sep)`. An EMPTY separator splits at every position,",
    "; which yields an empty string at each END as well as one codepoint",
    "; each in between -- `\"abc\".split(\"\")` is five elements, not three.",
    "; That is the real compiler's behaviour, and it is why its own",
    "; `chars_of` is `s.split(\"\").filter(|c| c != \"\")` rather than just",
    "; `s.split(\"\")`. Matching it exactly matters more than picking the",
    "; tidier semantics: a program that splits on \"\" must not behave",
    "; differently under the two backends.",
    "define ptr @plum_str_split(ptr %s, ptr %sep) {",
    "entry:",
    "  %seplenp = getelementptr i8, ptr %sep, i64 8",
    "  %seplen = load i64, ptr %seplenp",
    "  %isempty = icmp eq i64 %seplen, 0",
    "  br i1 %isempty, label %chars, label %split",
    "chars:",
    "  %cs = call ptr @plum_chars_of(ptr %s)",
    "  %clen = call i64 @plum_array_len(ptr %cs)",
    "  %olen = add i64 %clen, 2",
    "  %co = call ptr @plum_array_new(i64 %olen)",
    "  %empty1 = call ptr @plum_str_new(ptr @.plum_fmt_line, i64 0)",
    "  %e0 = getelementptr i8, ptr %co, i64 16",
    "  store ptr %empty1, ptr %e0",
    "  %cip = alloca i64",
    "  store i64 0, ptr %cip",
    "  br label %cloop",
    "cloop:",
    "  %ci = load i64, ptr %cip",
    "  %cmore = icmp slt i64 %ci, %clen",
    "  br i1 %cmore, label %cbody, label %cdone",
    "cbody:",
    "  %csoff = mul i64 %ci, 8",
    "  %csp0 = getelementptr i8, ptr %cs, i64 %csoff",
    "  %csp = getelementptr i8, ptr %csp0, i64 16",
    "  %cval = load ptr, ptr %csp",
    "  %cdi = add i64 %ci, 1",
    "  %cdoff = mul i64 %cdi, 8",
    "  %cdp0 = getelementptr i8, ptr %co, i64 %cdoff",
    "  %cdp = getelementptr i8, ptr %cdp0, i64 16",
    "  store ptr %cval, ptr %cdp",
    "  %ci1 = add i64 %ci, 1",
    "  store i64 %ci1, ptr %cip",
    "  br label %cloop",
    "cdone:",
    "  %lasti = add i64 %clen, 1",
    "  %lastoff = mul i64 %lasti, 8",
    "  %lastp0 = getelementptr i8, ptr %co, i64 %lastoff",
    "  %lastp = getelementptr i8, ptr %lastp0, i64 16",
    "  %empty2 = call ptr @plum_str_new(ptr @.plum_fmt_line, i64 0)",
    "  store ptr %empty2, ptr %lastp",
    "  ret ptr %co",
    "split:",
    "  %slenp = getelementptr i8, ptr %s, i64 8",
    "  %slen = load i64, ptr %slenp",
    "  %cap = add i64 %slen, 1",
    "  %out = call ptr @plum_array_new(i64 %cap)",
    "  %sd = getelementptr i8, ptr %s, i64 16",
    "  %nd = getelementptr i8, ptr %sep, i64 16",
    "  %posp = alloca i64",
    "  %np = alloca i64",
    "  store i64 0, ptr %posp",
    "  store i64 0, ptr %np",
    "  br label %loop",
    "loop:",
    "  %pos = load i64, ptr %posp",
    "  %at = call i64 @plum_str_find(ptr %sd, i64 %slen, ptr %nd, i64 %seplen, i64 %pos)",
    "  %found = icmp sge i64 %at, 0",
    "  br i1 %found, label %piece, label %tail",
    "piece:",
    "  %plen = sub i64 %at, %pos",
    "  %pstart = getelementptr i8, ptr %sd, i64 %pos",
    "  %pc = call ptr @plum_str_new(ptr %pstart, i64 %plen)",
    "  %n = load i64, ptr %np",
    "  %noff = mul i64 %n, 8",
    "  %sl0 = getelementptr i8, ptr %out, i64 %noff",
    "  %sl = getelementptr i8, ptr %sl0, i64 16",
    "  store ptr %pc, ptr %sl",
    "  %n1 = add i64 %n, 1",
    "  store i64 %n1, ptr %np",
    "  %nextpos = add i64 %at, %seplen",
    "  store i64 %nextpos, ptr %posp",
    "  br label %loop",
    "tail:",
    "  %tpos = load i64, ptr %posp",
    "  %tlen = sub i64 %slen, %tpos",
    "  %tstart = getelementptr i8, ptr %sd, i64 %tpos",
    "  %tc = call ptr @plum_str_new(ptr %tstart, i64 %tlen)",
    "  %tn = load i64, ptr %np",
    "  %tnoff = mul i64 %tn, 8",
    "  %tsl0 = getelementptr i8, ptr %out, i64 %tnoff",
    "  %tsl = getelementptr i8, ptr %tsl0, i64 16",
    "  store ptr %tc, ptr %tsl",
    "  %tn1 = add i64 %tn, 1",
    "  %toutlen = getelementptr i8, ptr %out, i64 8",
    "  store i64 %tn1, ptr %toutlen",
    "  ret ptr %out",
    "}",
    "",
    "define i1 @plum_println(ptr %s) {",
    "entry:",
    "  %d = getelementptr i8, ptr %s, i64 16",
    "  %r = call i32 (ptr, ...) @printf(ptr @.plum_fmt_line, ptr %d)",
    "  ret i1 0",
    "}",
    "; --- end runtime ---",
    "",
])
