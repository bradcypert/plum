// Self-hosted CODE GENERATOR — Stage 5 of self-hosting, and the last
// piece needed for a Plum compiler written in Plum that can produce a
// native binary. See DESIGN.md's own Stage 5 section and the project
// roadmap for the "why now" story.
//
// Emits LLVM IR TEXT, the same form `crates/plum-codegen` emits, which
// `plum compile-ir <file.ll> -o <binary>` then hands to `clang`.
// Handing assembly+linking to the system toolchain is not a
// bootstrapping cheat — the real compiler does exactly the same thing
// internally, and Plum has no process-spawn builtin for a self-hosted
// compiler to shell out with.
//
// --- The two decisions that shape this file ---
//
// **1. Values are STATICALLY TYPED and UNBOXED.** An `Int` is an `i64`
// in a register, a `Float` is a `double`, a `Bool`/`Unit` is an `i1`, a
// `String` is a `ptr` to a length-prefixed cell. The alternative — one
// uniform tagged representation for every value — would have made this
// file much smaller (no type information needed anywhere, generics
// erase for free), at the cost of a tag check on every operation and a
// backend that would eventually be thrown away. Unboxed is what the
// real backend does, so this is the shape that can actually grow into
// it.
//
// **2. Nothing is ever freed.** No refcounting, no FBIP, no `plum_rc_
// inc`/`dec` — see `runtime.plum`'s own comment. That is what makes an
// unboxed backend tractable at all here: the real one spends 3,293
// lines on `plum-ir/src/fbip.rs` to free correctly, and a compiler
// that starts, compiles one program and exits doesn't need any of it.
//
// --- Where the types come from ---
//
// **The checker.** `typecheck/infer.plum` computes the type of every
// expression and now PUBLISHES it, as a typed tree (`typecheck/
// texpr.plum`). This file reads types; it does not derive them.
//
// It used to derive them, bottom-up, because inference threw its
// results away. That worked for everything except a closure literal
// with no expected type — `let f = |n| n + 1`, where `n`'s
// representation is only pinned by UNIFYING the body's use of it. The
// fix was to make the checker hand over what it already knew, not to
// grow a second unifier here.
//
// Two things came with it, both worth more than the one fixture:
//
//   - **Calls arrive classified.** `parser.PExpr` has one `ECall`
//     covering user functions, prelude functions, variant
//     constructors, closure values, methods, `Array.map` and
//     `println`. Telling them apart needs scope information, and this
//     file used to redo that resolution itself — with its own copy of
//     the precedence rules. Now `infer_call` decides once and the node
//     says which. The backend cannot disagree with the checker about
//     what a call IS.
//   - **Whole rules disappeared** rather than moving: the operator
//     result-type table, the "a match's type is its first arm's type"
//     rule (which emitted an arm speculatively just to read its type
//     back), the empty-array "element type undetermined" marker, and
//     the machinery that pushed expected parameter types down into
//     closure literals. Each existed only to reconstruct something
//     inference already knew.
//
// One genuinely new rule lives here: DEFAULTING an unconstrained type
// variable — see `cg_of_ity`.
//
// Validated against bootstrap/exec_corpus: a fixture compiled by THIS
// backend must print byte-for-byte what the real `plum build` produces
// for it — not merely match `expected.txt`, but agree with the other
// backend, which is the stronger claim.

use lexer;
use parser;
use typecheck;

let cg_fail (msg: String): Unit = panic_raw("self-hosted codegen: ".concat(msg))

// --- Representation types ---
//
// Deliberately coarse: this is "which machine type, which layout", not
// a type language. `typecheck/types.plum`'s `ITy` is the type language.
pub enum CgTy {
    CgInt,
    CgFloat,
    CgBool,
    CgUnit,
    CgStr,
    // A raw `char*`. Distinct from `CgStr` because it is NOT a
    // refcounted Plum cell: nothing increments it, releases it, or reads
    // a length header off it.
    CgCStr,
    // Both are a `ptr` to a heap cell; the NAME is carried so field
    // offsets and variant tags can be looked up in the declaration
    // tables. Nothing else about the type is needed at this level —
    // see this file's "coarse on purpose" note above.
    CgStruct(String),
    CgEnum(String),
    // The element type is carried because an element load/store needs
    // its machine type, and `.push()` needs to report the same array
    // type back. `CgArray(CgUnit)` is the ONE special value: it means
    // "empty literal, element type never determined" — see
    // `cg_array_lit`.
    CgArray(CgTy),
    // A closure: parameter representations and result representation.
    // The VALUE is a `ptr` to `{ ptr code, captures... }` — see
    // `cg_closure`.
    CgClosure(Array[CgTy], CgTy),
    // A tuple is an anonymous struct: `{ i64 rc, elem0, elem1, ... }`,
    // laid out by `cg_field_offset` exactly as a named struct's fields
    // are. Nothing about it needs a declaration, which is the whole
    // difference — the element types come from the type itself.
    CgTuple(Array[CgTy]),
    // `Task`, `Sender`, `Receiver`: a refcounted cell of `{ rc, handle }`
    // wrapping the opaque `i64` the thread shim hands out.
    //
    // These were a bare `CgInt` until the resources behind them needed
    // lifetimes. An `Int` has none -- nothing runs when one dies -- so a
    // channel was never freed and an unjoined task never reclaimed. The
    // cell is what gives the handle a death to hook onto; the NAME says
    // which shim function that death calls.
    CgHandle(String),
    // `Ref[T]`: a `ptr` to a REFCOUNTED two-word cell,
    // `{ i64 refcount, i64 value }`, allocated by `@plum_alloc_ref`.
    // The inner representation is carried so `.get()`/`.set()` know
    // the machine type to load and store. Closest analogue here is
    // `CgArray`, not `CgClosure`: it is genuinely Plum-managed memory
    // with a real refcount word at offset 0, so it needs a release
    // function per inner type. It carries NO tag, so it is never
    // pattern-matched.
    CgRef(CgTy),
}

// `Unit` is an `i1` rather than LLVM's own `void` so that every Plum
// expression, including a `Unit`-valued one, is a real SSA value that
// can be stored in a slot, returned, and passed — the same choice the
// real backend makes, and for the same reason.
let cg_llvm_ty (t: CgTy): String =
    match t {
        CgInt => "i64",
        CgFloat => "double",
        CgBool => "i1",
        CgUnit => "i1",
        CgStr => "ptr",
        CgCStr => "ptr",
        CgStruct(_) => "ptr",
        CgEnum(_) => "ptr",
        CgArray(_) => "ptr",
        CgRef(_) => "ptr",
        CgClosure(_, _) => "ptr",
        CgTuple(_) => "ptr",
        CgHandle(_) => "ptr",
    }

let cg_ty_name (t: CgTy): String =
    match t {
        CgInt => "Int",
        CgFloat => "Float",
        CgBool => "Bool",
        CgUnit => "Unit",
        CgStr => "String",
        CgCStr => "CStr",
        CgStruct(name) => name,
        CgEnum(name) => name,
        CgArray(elem) => "Array[".concat(cg_ty_name(elem)).concat("]"),
        CgRef(inner) => "Ref[".concat(cg_ty_name(inner)).concat("]"),
        CgClosure(_, ret) => "(..) -> ".concat(cg_ty_name(ret)),
        CgTuple(elems) => "(".concat(cg_ty_name_list(elems, 0, "")).concat(")"),
        CgHandle(name) => name,
    }

let cg_ty_name_list (ts: Array[CgTy]) (i: Int) (acc: String): String =
    if i >= ts.len() { acc }
    else if acc == "" { cg_ty_name_list(ts, i + 1, cg_ty_name(ts[i])) }
    else { cg_ty_name_list(ts, i + 1, acc.concat(", ").concat(cg_ty_name(ts[i]))) }

let cg_ty_eq (a: CgTy) (b: CgTy): Bool = cg_ty_name(a) == cg_ty_name(b)

// --- Declaration tables ---
//
// Resolving a type annotation needs to know whether `Shape` names a
// struct or an enum, and building the full declarations needs to
// resolve their own field/payload annotations — a cycle. It's broken by
// collecting NAMES and kinds first (`CgTyName`, which needs no
// resolution at all), then resolving everything else against that. The
// same two-pass shape `typecheck/context.plum` uses, for the same
// reason.
// `tag` is assigned in declaration order across the WHOLE program, not
// per enum — matching the flat, globally-scoped treatment variant tags
// already get everywhere else in this bootstrap (see DESIGN.md's
// module-system section, which documents that as a deliberate v1
// boundary).
pub struct CgVariant { pub name: String, pub enum_name: String, pub tag: Int, pub arity: Int }
pub struct CgEnumDecl { pub name: String, pub variants: Array[CgVariant] }

// Field and payload TYPES are no longer resolved here at all: every
// use site reads its own type off the typed tree instead. What the
// declarations are still needed for is LAYOUT — which slot a field
// lives in, and which tag a variant carries — and neither of those
// needs a resolved type, only an order.
// --- Program shape ---

// `subst` is the CURRENT function's substitution, swapped per function
// by `cg_fn` — it is what `cg_ty` needs to resolve a recorded type. It
// lives here rather than as a parameter on thirty emitters purely to
// keep those signatures unchanged.
// `generics`/`targs` are the SPECIALIZATION currently being emitted:
// the type-parameter names of the function whose body this is, and the
// concrete types they stand for. Every type read goes through them
// (`cg_concrete`), which is the whole of monomorphization's effect on
// emission — there is no rewritten copy of the body anywhere, only a
// different mapping applied while walking the same one.
pub struct CgProgram { fns: Array[typecheck.TFn], globals: Array[typecheck.TFn], ctx: typecheck.TyContext, enums: Array[CgEnumDecl], subst: typecheck.Subst, generics: Array[String], targs: Array[typecheck.ITy],
    // Slot names this function reads AT MOST ONCE on any path, so a read
    // may hand its reference over instead of lending it — see
    // `cg_reads_max`. Set per function by `cg_fn`; empty elsewhere, which
    // simply means nothing moves.
    movable: Array[String] }

// --- Cell layouts ---
//
// Struct: one 8-byte slot per field, in declared order.
// Enum:   an i64 tag at offset 0, then one 8-byte slot per payload.
//
// Eight bytes per slot regardless of the field's own width, so an
// offset is `8 * index` with no alignment arithmetic. A `Bool` wastes
// seven bytes; that is a deliberate trade of space for a layout rule
// simple enough to state in one line.
//
// An enum cell is always sized for its LARGEST variant, never for the
// variant actually being built. That is what makes pattern matching
// safe: a `match` arm loads a payload slot BEFORE it knows the tag
// matched, and with per-variant sizing that load could run off the end
// of the allocation. Over-allocating means such a load reads garbage it
// then discards, rather than reading unmapped memory.
// EVERY heap cell begins with a reference count. Nothing reads it yet —
// the ownership discipline that will is a separate change — but every
// offset below is expressed relative to it, so adding the word is a
// layout change and not an arithmetic one.
//
//   Str:     { i64 rc, i64 len, i8 bytes[len], i8 0 }
//   Array:   { i64 rc, i64 len, elem0, ... }
//   Struct:  { i64 rc, field0, field1, ... }
//   Enum:    { i64 rc, i64 tag, payload0, ... }
//   Closure: { i64 rc, ptr code, capture0, ... }
//
// These are now the same SHAPE as the real backend's cells, though not
// the same sizes (its array cell carries a capacity word this one has
// no growth strategy for).
let cg_rc_offset (unit: Unit): Int = 0
let cg_field_offset (index: Int): Int = 8 + 8 * index
let cg_tag_offset (unit: Unit): Int = 8
let cg_payload_offset (index: Int): Int = 16 + 8 * index
let cg_array_elem_offset (index: Int): Int = 16 + 8 * index
let cg_closure_code_offset (unit: Unit): Int = 8
// A closure cell carries a RELEASE-FUNCTION pointer as well as a code
// pointer. It has to: a closure's captures are not visible from its
// TYPE — `(Int) -> Int` says nothing about what was captured — so
// nothing generated per-type can walk them. Only the literal's own
// creation site knows, so that is where the walker is generated, and
// the cell carries a pointer to it. The real backend spends this same
// word for this same reason.
let cg_closure_rel_offset (unit: Unit): Int = 16
let cg_capture_offset (index: Int): Int = 24 + 8 * index

// A Plum name may contain a `.` (`Point.add`, an associated function),
// which LLVM would accept only inside quotes; mangling keeps every
// emitted symbol a plain identifier.
// A global reference has the same module question as a function call,
// and the same answer: the checker already resolved which global this
// is, so recovering its module by name is enough.
let cg_global_module_of (p: CgProgram) (name: String): String = cg_global_module_acc(p.globals, name, 0)
let cg_global_module_acc (gs: Array[typecheck.TFn]) (name: String) (i: Int): String =
    if i >= gs.len() { "" } else if gs[i].name == name { gs[i].module } else { cg_global_module_acc(gs, name, i + 1) }

let cg_global_slot (module_name: String) (name: String): String = "@g.".concat(cg_sym(module_name, name, []))

// Everything that is not a letter, a digit or `_` becomes `_`. It used
// to replace `.` alone, which was enough while every module name came
// from a directory that happened to be a plain identifier -- and was
// not enough for the prelude's own `<prelude>`, whose angle brackets
// are not legal in an LLVM symbol. A directory named `my-mod` would
// have hit the same wall.
//
// This is NOT injective (`a.b` and `a-b` mangle alike), which is
// tolerable only because a module name still comes from a directory
// and two sibling directories cannot differ by punctuation alone.
let cg_mangle (name: String): String = "plum_".concat(cg_sanitize(name))

// Anything that is not a letter, a digit or `_` becomes `_`. Every
// name that reaches an LLVM symbol goes through here: module names,
// which come from directories, and type names, which are qualified
// with the module that declared them.
pub let cg_sanitize (name: String): String =
    Array.concat_all(Array.map(chars_of(name), |c| if cg_sym_char_ok(c) { c } else { "_" }))

let CG_SYM_CHARS: Array[String] = chars_of("abcdefghijklmnopqrstuvwxyzABCDEFGHIJKLMNOPQRSTUVWXYZ0123456789_")

let cg_sym_char_ok (c: String): Bool = Array.contains(CG_SYM_CHARS, c)

// --- Monomorphization ---
//
// A generic function is emitted once PER DISTINCT set of type
// arguments, and the arguments are folded into the symbol name. That is
// the whole scheme: `Array.map[Int, String]` and `Array.map[String,
// Int]` become two different LLVM functions, each with concrete machine
// types throughout.
//
// This is forced by the choice to be UNBOXED. A boxed backend needs
// none of it — every value is a `ptr`, so one copy serves every
// instantiation — which was exactly the tradeoff weighed when Stage 5
// started. Monomorphization is the bill for that decision, and it is
// the last major subsystem the real backend has that this one lacked.
//
// The specialized body is never rewritten. Emission walks the SAME
// typed tree with a different generic mapping in `CgProgram` — see
// `cg_concrete`. That is only sound because nothing about a body's
// SHAPE depends on its type arguments, which is true here and would
// stop being true if this backend ever specialized on values.
// A function is identified by MODULE and name: two modules may declare
// the same name, and they must not share a symbol.
pub struct CgInst { pub module: String, pub name: String, pub targs: Array[typecheck.ITy] }

// A symbol name that is unique per instantiation. Monomorphic functions
// keep their plain mangled name, so the entry point stays `@plum_main`
// and the generated IR stays readable for the common case.
// The module is part of the symbol. Without it `alpha.helper` and
// `beta.helper` collide in LLVM — the checker would accept the program
// and the backend would silently emit one function for both.
let cg_sym (module_name: String) (name: String) (targs: Array[typecheck.ITy]): String = {
    let base = if module_name == "" { cg_mangle(name) } else { cg_mangle(module_name.concat(".").concat(name)) };
    if Array.is_empty(targs) { base } else { base.concat("__").concat(cg_targ_suffix(targs, 0, "")) }
}

let cg_targ_suffix (targs: Array[typecheck.ITy]) (i: Int) (acc: String): String =
    if i >= targs.len() { acc }
    else { cg_targ_suffix(targs, i + 1, if acc == "" { cg_ity_mangle(targs[i]) } else { acc.concat("_").concat(cg_ity_mangle(targs[i])) }) }

// A type rendered as an identifier-safe string. It must be INJECTIVE
// enough that two different types never collide, since a collision
// would silently merge two specializations into one — so nested type
// arguments are included rather than elided.
let cg_ity_mangle (t: typecheck.ITy): String =
    match t {
        ITInt => "Int",
        ITFloat => "Float",
        ITBool => "Bool",
        ITStr => "Str",
        ITCStr => "CStr",
        ITUnit => "Unit",
        // A declared type's name is QUALIFIED (`inner.P`,
        // `<prelude>.Zipped`), and this feeds symbol names -- so it is
        // sanitized here for the same reason `cg_mangle` sanitizes a
        // module name. Without it a perfectly ordinary `Array.zip`
        // emitted `@plum_rel_Array_<prelude>.Zipped_Int_Str`, which is
        // not an LLVM identifier.
        ITStruct(name, args) => if Array.is_empty(args) { cg_sanitize(name) } else { cg_sanitize(name).concat("_").concat(cg_targ_suffix(args, 0, "")) },
        ITEnum(name, args) => if Array.is_empty(args) { cg_sanitize(name) } else { cg_sanitize(name).concat("_").concat(cg_targ_suffix(args, 0, "")) },
        ITFunction(ptys, ret) => "fn".concat(cg_targ_suffix(ptys, 0, "")).concat("_to_").concat(cg_ity_mangle(ret)),
        ITTuple(elems) => "tup".concat(cg_targ_suffix(elems, 0, "")),
        ITRef(inner) => "Ref_".concat(cg_ity_mangle(inner)),
        // An unconstrained type variable DEFAULTS, exactly as it does in
        // `cg_of_ity` — and it must default to the same thing here, or
        // a call site and its callee would disagree about the symbol.
        ITVar(_) => "Unit",
        ITParam(name) => { cg_fail("internal: generic parameter ".concat(name).concat(" was not substituted before mangling")); "T" },
    }

let cg_inst_eq (a: CgInst) (b: CgInst): Bool =
    a.module == b.module && a.name == b.name && cg_sym(a.module, a.name, a.targs) == cg_sym(b.module, b.name, b.targs)

let cg_inst_seen (done: Array[CgInst]) (x: CgInst) (i: Int): Bool =
    if i >= done.len() { false } else if cg_inst_eq(done[i], x) { true } else { cg_inst_seen(done, x, i + 1) }

pub let cg_build_program (program: parser.ProgramNode): CgProgram =
    CgProgram {
        // Type-checking and typed-tree construction are one pass —
        // `typed_program` IS `check_program` with the results kept, so
        // the backend cannot compile anything the checker didn't prove.
        fns: typecheck.typed_program(program),
        globals: typecheck.typed_globals(program),
        // Field names and field/payload TYPES come straight from the
        // checker's own declaration tables — the backend re-resolves
        // nothing. Only variant TAGS are assigned here, because tag
        // numbering is a layout decision the checker has no opinion on.
        ctx: typecheck.build_context(program),
        enums: cg_collect_enums(program.items, 0, 0, []),
        subst: typecheck.subst_empty(()),
        generics: [],
        targs: [],
        movable: [],
    }

// `next_tag` runs across the whole program, so every variant in every
// enum has a distinct id — see `CgVariant`'s own comment.
let cg_collect_enums (items: Array[parser.ItemNode]) (i: Int) (next_tag: Int) (acc: Array[CgEnumDecl]): Array[CgEnumDecl] =
    if i >= items.len() { acc }
    else {
        match items[i].kind {
            IKEnum(decl) => {
                // Generic enums need NO specialization: every payload
                // occupies the same 8-byte slot whatever `T` is, and a
                // variant's tag doesn't depend on it either. Only the
                // machine type of a payload LOAD varies, and that comes
                // from the scrutinee's own type arguments at the use
                // site (`cg_pat_variant`).
                let vs = cg_variants_of(parser.qualify_type(items[i].module, decl.name), decl.variants, 0, next_tag, []);
                // Keyed by the same QUALIFIED name the checker puts in
                // `ITEnum`, via the one shared rule. Keying it by the
                // bare name would look right and fail to resolve.
                cg_collect_enums(items, i + 1, next_tag + decl.variants.len(), acc.push(CgEnumDecl { name: parser.qualify_type(items[i].module, decl.name), variants: vs }))
            },
            _ => cg_collect_enums(items, i + 1, next_tag, acc),
        }
    }

let cg_variants_of (enum_name: String) (variants: Array[parser.EnumVariantNode]) (i: Int) (next_tag: Int) (acc: Array[CgVariant]): Array[CgVariant] =
    if i >= variants.len() { acc }
    else {
        cg_variants_of(enum_name, variants, i + 1, next_tag + 1,
            acc.push(CgVariant { name: variants[i].name, enum_name: enum_name, tag: next_tag, arity: variants[i].payload.len() }))
    }

// --- Declaration lookup ---

let cg_field_index (fields: Array[String]) (name: String) (i: Int): Int =
    if i >= fields.len() { { cg_fail("no such field: ".concat(name)); 0 } }
    else if fields[i] == name { i }
    else { cg_field_index(fields, name, i + 1) }

// Lookup that NAMES the enum. The checker already decided which enum
// a tag belongs to and says so in the node, so the backend has nothing
// left to decide -- see `TVariantNew`'s comment for what went wrong
// when both ends decided separately.
let cg_variant_of (p: CgProgram) (enum_name: String) (tag: String): Option[CgVariant] =
    cg_find_variant_in(cg_find_enum(p, enum_name).variants, tag, 0)

let cg_find_variant_in (vs: Array[CgVariant]) (name: String) (i: Int): Option[CgVariant] =
    if i >= vs.len() { None } else if vs[i].name == name { Some(vs[i]) } else { cg_find_variant_in(vs, name, i + 1) }

// An enum cell is sized for the widest variant — see `cg_payload_
// offset`'s own comment for why that is a correctness requirement.
let cg_enum_cell_size (p: CgProgram) (enum_name: String): Int = cg_widest_variant(cg_find_enum(p, enum_name).variants, 0, 0) * 8 + 16

let cg_find_enum (p: CgProgram) (name: String): CgEnumDecl = cg_find_enum_acc(p.enums, name, 0)
let cg_find_enum_acc (es: Array[CgEnumDecl]) (name: String) (i: Int): CgEnumDecl =
    if i >= es.len() { { cg_fail("unknown enum: ".concat(name)); CgEnumDecl { name: name, variants: [] } } }
    else if es[i].name == name { es[i] }
    else { cg_find_enum_acc(es, name, i + 1) }

let cg_widest_variant (vs: Array[CgVariant]) (i: Int) (best: Int): Int =
    if i >= vs.len() { best }
    else if vs[i].arity > best { cg_widest_variant(vs, i + 1, vs[i].arity) }
    else { cg_widest_variant(vs, i + 1, best) }

// --- Emission state ---
//
// `code` is the instruction text produced so far for the expression
// being emitted; `globals` is module-level text (string constants) that
// has to be hoisted out of the function body; `val` is the LLVM operand
// naming the expression's result, and `ty` its representation. `n` is
// the next unused register/label number — threaded rather than global
// because Plum has no mutable module state, and threading it is what
// keeps every generated name unique across a whole function body.
// `allocas` is kept SEPARATE from `code` and hoisted into the function's
// entry block. An `alloca` executed inside a loop body allocates afresh
// every iteration and is not reclaimed until the function returns — a
// real stack leak, and the reason this is its own field rather than
// just more `code`. LLVM's mem2reg also only promotes ENTRY-block
// allocas back to registers, so hoisting is what makes the whole
// "every local is a slot" strategy free rather than merely correct.
// `releases` mirrors `allocas`: every heap SLOT that gets an `alloca`
// also gets a release, spliced in just before the function's `ret`.
// Threading it exactly like `allocas` is deliberate — a slot and its
// release are created at the same place and must never get separated.
struct Emit { code: String, allocas: String, releases: String, globals: String, val: String, ty: CgTy, n: Int }

// Every LOCAL is an `alloca` slot, loaded on read and stored on write —
// never a bare SSA register. That means this backend never has to
// construct a phi node or reason about dominance: an `if` that produces
// a value stores into one slot from both arms. LLVM's own mem2reg pass
// turns all of it back into registers with correct phis, so the
// generated code is not actually slower for it — BUT ONLY AT `-O1` AND
// ABOVE, since that is where mem2reg runs at all. For a long time
// nothing in the toolchain passed `clang` an `-O` flag, so this
// claim was quietly false for every binary the compiler produced:
// each local read really was a load and each write really a store.
// See `OPT_ARTIFACT` in `codegen_cli.rs` — turning it on is worth 2x
// on this compiler compiled by itself, and this backend gains more
// from it than the Rust one precisely because it leans on the trick
// harder. Same reason `let mut` and plain `let` need no distinction
// here at all.
// `ity` is the slot's full type, not just its representation. A
// release function is named after the full type (`@plum_rel_Box_Int`),
// which a `CgTy` cannot reconstruct — `CgStruct("Box")` has already
// thrown the argument away.
struct CgSlot { name: String, ptr: String, ty: CgTy, ity: typecheck.ITy }

let cg_lookup (env: Array[CgSlot]) (name: String): Option[CgSlot] = cg_lookup_acc(env, name, env.len() - 1)
let cg_lookup_acc (env: Array[CgSlot]) (name: String) (i: Int): Option[CgSlot] =
    if i < 0 { None } else if env[i].name == name { Some(env[i]) } else { cg_lookup_acc(env, name, i - 1) }

let cg_reg (n: Int): String = "%t".concat(n.to_string())
let cg_label (n: Int): String = "L".concat(n.to_string())

// --- String literals ---
//
// Emitted as module-level constants, so they need a name and an escaped
// body. The byte length is `s.len()` (Plum's `.len()` on a String is
// already a BYTE count, not a codepoint count), plus one for the
// trailing NUL every cell carries.
//
// Only the four bytes LLVM's `c"..."` syntax can't carry literally are
// escaped. Everything else — including multi-byte UTF-8 — passes
// through as raw bytes, which is exactly right: `c"..."` is a byte
// string, and a codepoint's own bytes need no special handling.
let cg_escape_llvm (s: String): String = Array.concat_all(Array.map(chars_of(s), |c| cg_escape_char(c)))

let cg_escape_char (c: String): String =
    if c == "\"" { "\\22" }
    else if c == "\\" { "\\5C" }
    else if c == "\n" { "\\0A" }
    else if c == "\t" { "\\09" }
    else if c == "\r" { "\\0D" }
    else { c }

// A string literal is emitted as a COMPLETE, STATIC cell — refcount,
// length and bytes — not as raw bytes to be copied into a fresh cell at
// runtime. Copying was costing an allocation every time the literal was
// evaluated, and the compiler evaluates thousands of them constantly:
// 18.7 of 21.4 million allocations were `plum_str_new`, measured with
// PLUM_RT_STATS.
//
// The refcount is -1, which marks the cell IMMORTAL: `plum_rc_inc` and
// every release skip a negative count, so a static cell is never
// touched and never freed. A sentinel rather than a huge positive
// number, because "negative means static" cannot be reached by
// counting.
let cg_str_constant (n: Int) (s: String): String = {
    let bytes = s.len();
    let arr = bytes + 1;
    "@.str".concat(n.to_string()).concat(" = private global { i64, i64, [").concat(arr.to_string()).concat(" x i8] } { i64 -1, i64 ")
        .concat(bytes.to_string()).concat(", [").concat(arr.to_string()).concat(" x i8] c\"").concat(cg_escape_llvm(s)).concat("\\00\" }\n")
}

// --- Constant aggregates ---
//
// An array, struct or variant literal built entirely from literals is
// the same cell every time it is evaluated, so it is emitted ONCE as a
// module-level cell with an immortal refcount instead of allocated at
// each evaluation. `[1, 2, 3]` inside a loop body was costing an
// allocation per iteration for bytes that never changed.
//
// The same -1 sentinel string literals have always used, and safe for
// the same reason, now checked against four in-place paths rather than
// one: `@plum_reuse_ok`, `@plum_array_reuse`, `@plum_str_concat_reuse`
// and `@plum_array_push_grow` all test `rc == 1` exactly, so a negative
// count declines every one and a static cell is never written through.
// `@plum_rc_inc` and every generated release skip negative counts too,
// so it is never retained and never freed -- which is also why its
// children never need releasing: they are static themselves.
//
// This is hoisting, not reuse. There is no cell to recycle because
// none is ever allocated.
struct ConstVal { ty: String, val: String, globals: String, n: Int }
struct ConstList { tys: Array[String], vals: Array[String], globals: String, n: Int }

let cg_const_of (p: CgProgram) (n: Int) (e: typecheck.TExpr): Option[ConstVal] =
    match e.node {
        TInt(v) => Some(ConstVal { ty: "i64", val: v.to_string(), globals: "", n: n }),
        TFloat(v) => Some(ConstVal { ty: "double", val: cg_float_text(v), globals: "", n: n }),
        TBool(v) => Some(ConstVal { ty: "i1", val: if v { "1" } else { "0" }, globals: "", n: n }),
        // A string literal is ALREADY a static cell, so nesting one
        // inside a constant aggregate costs nothing but its pointer.
        TStr(v) => Some(ConstVal { ty: "ptr", val: "@.str".concat(n.to_string()), globals: cg_str_constant(n, v), n: n + 2 }),
        TArrayLit(xs) => cg_const_array(p, n, xs),
        // Hoisting still beats recycling, exactly as for the others.
        TArrayLitReuse(xs, _) => cg_const_array(p, n, xs),
        TStructLit(sname, fs, sp) => match sp { Some(_) => None, None => cg_const_struct(p, n, fs) },
        // A literal that the last-use pass offered a reuse candidate is
        // still a literal. Hoisting beats recycling: no allocation, and
        // no runtime check either.
        TStructReuse(_, fs, _) => cg_const_struct(p, n, fs),
        TVariantNew(ename, tag, args) => cg_const_variant(p, n, ename, tag, args),
        TVariantReuse(ename, tag, args, _) => cg_const_variant(p, n, ename, tag, args),
        _ => None,
    }

let cg_const_list (p: CgProgram) (xs: Array[typecheck.TExpr]) (i: Int) (acc: ConstList): Option[ConstList] =
    if i >= xs.len() { Some(acc) }
    else {
        match cg_const_of(p, acc.n, xs[i]) {
            None => None,
            Some(c) => cg_const_list(p, xs, i + 1,
                ConstList { tys: acc.tys.push(c.ty), vals: acc.vals.push(c.val), globals: acc.globals.concat(c.globals), n: c.n }),
        }
    }

let cg_const_empty (n: Int): ConstList = ConstList { tys: [], vals: [], globals: "", n: n }

// Cells are eight bytes per slot whatever the slot holds, which every
// offset rule in this backend depends on. An `i1` is the only
// representation narrower than that, so it is the only one that needs
// padding written out -- and the struct is PACKED, because otherwise
// LLVM lays out `<{ i64, i1, i1 }>` at offsets 0, 8, 9 and every
// `cg_field_offset` reading it would be wrong.
let cg_const_slot_ty (t: String): String = if t == "i1" { "i1, [7 x i8]" } else { t }

let cg_const_slot_val (t: String) (v: String): String =
    if t == "i1" { "i1 ".concat(v).concat(", [7 x i8] zeroinitializer") } else { t.concat(" ").concat(v) }

let cg_const_tys (tys: Array[String]) (i: Int) (acc: String): String =
    if i >= tys.len() { acc } else { cg_const_tys(tys, i + 1, acc.concat(", ").concat(cg_const_slot_ty(tys[i]))) }

let cg_const_vals (tys: Array[String]) (vals: Array[String]) (i: Int) (acc: String): String =
    if i >= tys.len() { acc } else { cg_const_vals(tys, vals, i + 1, acc.concat(", ").concat(cg_const_slot_val(tys[i], vals[i]))) }

let cg_const_cell (c: ConstList) (head_ty: String) (head_val: String) (pad: Int): ConstVal = {
    let g = "@.const".concat(c.n.to_string());
    let padding = if pad > 0 { ", [".concat(pad.to_string()).concat(" x i8]") } else { "" };
    let pad_val = if pad > 0 { ", [".concat(pad.to_string()).concat(" x i8] zeroinitializer") } else { "" };
    ConstVal { ty: "ptr", val: g, n: c.n + 1,
        globals: c.globals.concat(g).concat(" = private global <{ ").concat(head_ty).concat(cg_const_tys(c.tys, 0, "")).concat(padding).concat(" }> <{ ")
            .concat(head_val).concat(cg_const_vals(c.tys, c.vals, 0, "")).concat(pad_val).concat(" }>\n") }
}

let cg_const_array (p: CgProgram) (n: Int) (xs: Array[typecheck.TExpr]): Option[ConstVal] =
    match cg_const_list(p, xs, 0, cg_const_empty(n)) {
        None => None,
        Some(c) => Some(cg_const_cell(c, "i64, i64", "i64 -1, i64 ".concat(xs.len().to_string()), 0)),
    }

let cg_const_struct (p: CgProgram) (n: Int) (fs: Array[typecheck.TFieldInit]): Option[ConstVal] =
    match cg_const_list(p, cg_field_values(fs, 0, []), 0, cg_const_empty(n)) {
        None => None,
        Some(c) => Some(cg_const_cell(c, "i64", "i64 -1", 0)),
    }

let cg_field_values (fs: Array[typecheck.TFieldInit]) (i: Int) (acc: Array[typecheck.TExpr]): Array[typecheck.TExpr] =
    if i >= fs.len() { acc } else { cg_field_values(fs, i + 1, acc.push(fs[i].value)) }

// Padded to the enum's FULL cell size, not this variant's. Pattern
// matching loads a payload BEFORE it has confirmed the tag -- the load
// is only safe because every enum cell is allocated for the widest
// variant -- so a short static cell would be read past its end.
let cg_const_variant (p: CgProgram) (n: Int) (ename: String) (tag: String) (args: Array[typecheck.TExpr]): Option[ConstVal] =
    match cg_variant_of(p, ename, tag) {
        None => None,
        Some(v) => match cg_const_list(p, args, 0, cg_const_empty(n)) {
            None => None,
            Some(c) => Some(cg_const_cell(c, "i64, i64", "i64 -1, i64 ".concat(v.tag.to_string()),
                cg_enum_cell_size(p, v.enum_name) - 16 - 8 * args.len())),
        },
    }

let cg_const_emit (c: ConstVal) (ty: CgTy): Emit =
    Emit { code: "", allocas: "", releases: "", globals: c.globals, val: c.val, ty: ty, n: c.n }

// The hoisted cell if the literal is constant, otherwise whatever the
// ordinary emitter produced. `otherwise` is evaluated either way --
// these emitters are pure string-builders, so the cost of the unused
// one is the strings it built, not any effect it had.
let cg_or_const (p: CgProgram) (n: Int) (e: typecheck.TExpr) (otherwise: Emit): Emit =
    match cg_const_of(p, n, e) {
        Some(c) => cg_const_emit(c, otherwise.ty),
        None => otherwise,
    }

// --- Expression emission ---

// The backend's single dispatch. Every case reads the node's own TYPE
// from the checker (`cg_ty(p, e)`) rather than re-deriving it, and
// every CALL arrives already classified — `infer_call` decided whether
// `f(x)` was a function, a closure, a variant, a method or a namespace
// call, and the node says which. This file no longer makes either kind
// of decision for itself.
let cg_expr (p: CgProgram) (env: Array[CgSlot]) (n: Int) (e: typecheck.TExpr): Emit =
    match e.node {
        TInt(v) => Emit { code: "", allocas: "", releases: "",globals: "", val: v.to_string(), ty: CgInt, n: n },
        TFloat(v) => cg_float_literal(v, n),
        TBool(v) => Emit { code: "", allocas: "", releases: "",globals: "", val: if v { "1" } else { "0" }, ty: CgBool, n: n },
        TUnitLit => cg_unit_emit(n),
        // No allocation and no copy: the literal IS the cell.
        TStr(v) => Emit {
            code: "", allocas: "", releases: "", globals: cg_str_constant(n, v),
            val: "@.str".concat(n.to_string()), ty: CgStr, n: n + 2,
        },
        TIdent(name) => cg_ident(p, env, n, name, cg_ty(p, e)),
        // A global's slot owns its value for the whole program, so a
        // read borrows a reference the same way a local's does.
        TGlobalRef(gm, name) => {
            let ty = cg_ty(p, e);
            let reg = cg_reg(n);
            Emit {
                code: "  ".concat(reg).concat(" = load ").concat(cg_llvm_ty(ty)).concat(", ptr ").concat(cg_global_slot(gm, name)).concat("\n").concat(cg_inc(ty, reg)),
                allocas: "", releases: "", globals: "", val: reg, ty: ty, n: n + 1,
            }
        },
        TUnary(op, inner) => cg_unary(p, env, n, op, inner),
        TBinary(op, lhs, rhs) => cg_binary(p, env, n, op, lhs, rhs, cg_ty(p, e)),
        TIf(cond, then_branch, else_branch) => cg_if(p, env, n, cond, then_branch, else_branch, cg_ty(p, e)),
        TBlockE(block) => cg_block_ty(p, env, n, block, cg_ty(p, e)),
        TFieldGet(base, name) => cg_field_read(p, env, n, base, name, cg_ty(p, e)),
        TRefNew(inner) => cg_ref_new(p, env, n, inner),
        TMatch(scrutinee, arms) => cg_match(p, env, n, scrutinee, arms, cg_ty(p, e)),
        TFor(pattern, lo, hi, body) => cg_for(p, env, n, pattern, lo, hi, body),
        TForArray(pattern, arr, body) => cg_for_array(p, env, n, pattern, arr, body),
        TArrayLit(elems) => cg_or_const(p, n, e, cg_array_lit(p, env, n, elems, cg_ty(p, e))),
        TArrayLitReuse(elems, cands) => cg_or_const(p, n, e, cg_array_lit_reuse(p, env, n, elems, cands, cg_ty(p, e))),
        TIndex(base, idx) => cg_index(p, env, n, base, idx, cg_ty(p, e)),
        TClosure(params, body) => cg_closure(p, env, n, params, body, cg_concrete(p, typecheck.texpr_ty(p.subst, e))),
        TStructLit(name, fields, spread) => cg_or_const(p, n, e, cg_struct_lit(p, env, n, name, fields, spread)),
        TStructReuse(name, fields, cands) => cg_or_const(p, n, e, cg_struct_reuse(p, env, n, name, fields, cands)),
        TVariantReuse(ename, tag, args, cands) => cg_or_const(p, n, e, cg_variant_reuse(p, env, n, ename, tag, args, cands)),
        TVariantNew(ename, tag, args) => cg_or_const(p, n, e, cg_variant_call(p, env, n, ename, tag, args)),
        TFnCall(m, name, args, targs) => cg_fn_call(p, env, n, m, name, args, targs, cg_ty(p, e)),
        TClosureCall(callee, args) => cg_call_closure_value(p, env, n, cg_expr(p, env, n, callee), args),
        TMethodCall(name, base, args) => cg_method_call(p, env, n, name, base, args, cg_ty(p, e)),
        TArrayNs(name, args) => cg_array_ns_call(p, env, n, name, args),
        TArrayNsReuse(name, args, cand) => cg_array_ns_reuse(p, env, n, name, args, cand),
        TExternCall(name, args) => cg_extern_call(p, env, n, name, args, cg_ty(p, e)),
        TAsCStr(inner) => cg_as_cstr(p, env, n, inner),
        TAsString(inner) => cg_as_string(p, env, n, inner),
        TChannelNew => cg_channel_new(p, env, n, cg_ty(p, e)),
        TChannelSend(ch, v) => cg_channel_send(p, env, n, ch, v),
        TChannelRecv(ch) => cg_channel_recv(p, env, n, ch, cg_ty(p, e)),
        TSelect(arms) => cg_select(p, env, n, arms, cg_ty(p, e)),
        TSpawn(clo) => cg_spawn(p, env, n, clo),
        TTaskJoin(t) => cg_task_join(p, env, n, t, cg_ty(p, e)),
        TPrintln(arg) => cg_println(p, env, n, arg),
        TTupleLit(elems) => cg_tuple_lit(p, env, n, elems, cg_ty(p, e)),
        TUnsupported(what) => { cg_fail(what.concat(" isn't supported by this backend")); cg_unit_emit(n) },
    }

// --- Reading a node's type ---
//
// `p.subst` is the CURRENT FUNCTION's substitution — see `cg_fn`, which
// swaps it per function. A type recorded during inference may still
// hold unresolved variables; applying the substitution is what turns
// `?3` into `Int`.
let cg_ty (p: CgProgram) (e: typecheck.TExpr): CgTy = cg_of_ity(cg_concrete(p, typecheck.texpr_ty(p.subst, e)))

// Resolve a recorded type all the way to a concrete one: the function's
// own substitution first (which kills inference variables), then the
// current specialization's generic mapping (which kills `ITParam`s).
// Both are needed, and in that order — a type argument may itself be
// the enclosing function's own type parameter, as in `let outer[T] (x:
// T) = inner(x)`, where `inner`'s recorded argument resolves to
// `ITParam("T")` and only the specialization says what that is.
let cg_concrete (p: CgProgram) (t: typecheck.ITy): typecheck.ITy =
    typecheck.instantiate_template(p.generics, p.targs, typecheck.subst_apply(p.subst, t))

// `ITy` (the checker's full type language) to `CgTy` (a machine
// representation). This is the ONLY place the backend interprets types,
// and it replaces every bottom-up synthesis rule this file used to
// carry.
//
// An unresolved `ITVar` reaching here is a real bug rather than a user
// error: the checker accepted the program, so every type in it is
// determined. It fails loudly with the node's own rendered type instead
// of silently picking a representation.
let cg_of_ity (t: typecheck.ITy): CgTy =
    match t {
        ITInt => CgInt,
        ITFloat => CgFloat,
        ITBool => CgBool,
        ITStr => CgStr,
        ITCStr => CgCStr,
        ITUnit => CgUnit,
        // A `Task` is a bare handle from `thread_spawn` -- an `Int`'s
        // shape, with no cell, no fields and nothing to release. Mapping
        // it to `CgStruct("Task")` would send every field/release path
        // looking for a declaration that does not exist.
        ITStruct(name, args) => if name == "Task" || name == "Sender" || name == "Receiver" { CgHandle(name) } else if name == "Array" { CgArray(cg_of_ity(args[0])) } else { CgStruct(name) },
        ITRef(inner) => CgRef(cg_of_ity(inner)),
        ITEnum(name, _) => CgEnum(name),
        ITFunction(ptys, ret) => CgClosure(Array.map(ptys, |q| cg_of_ity(q)), cg_of_ity(ret)),
        ITTuple(elems) => CgTuple(Array.map(elems, |q| cg_of_ity(q))),
        // DEFAULTING. A type variable still free after a function's
        // inference is one nothing in that function constrained — the
        // program never depends on which type it is, or unification
        // would have pinned it. `let empty = []` is the honest example:
        // its element type is unconstrained precisely because no
        // element is ever stored or read.
        //
        // Any choice is therefore sound, and `Unit` is chosen because
        // it is the one that cannot be mistaken for a real answer if it
        // ever shows up in generated code. This is not a fallback for a
        // missing case — it is the standard resolution for an ambiguous
        // type, and it is why this backend compiles `let empty = []`
        // while the REAL compiler rejects it as uninferable.
        ITVar(_) => CgUnit,
        ITParam(name) => { cg_fail("internal: generic parameter ".concat(name).concat(" reached codegen — generics aren't supported")); CgUnit },
    }

let cg_unit_emit (n: Int): Emit = Emit { code: "", allocas: "", releases: "",globals: "", val: "0", ty: CgUnit, n: n }

// LLVM accepts a decimal float literal only when it is exactly
// representable; `%.15g`-style text can silently round. Emitting the
// value through `to_string()` is what the corpus needs today (every
// float literal in it is exact), and this is the one place Stage 5
// would need a bit-pattern (`0x...`) form to be fully general — flagged
// here rather than left as a lurking rounding bug.
let cg_float_literal (v: Float) (n: Int): Emit = Emit { code: "", allocas: "", releases: "",globals: "", val: cg_float_text(v), ty: CgFloat, n: n }

// LLVM's float literal syntax needs a decimal POINT, not just digits:
// `double 5` is rejected, `double 5.0` is fine. Appending `.0` when
// there is no `.` handles that -- but the rendering can also come back
// in exponent form, and `1e-06` has no `.` either. Appending there
// produced `double 1e-06.0`, which is not valid IR at all:
//
//     let x = 0.000001    ->    error: integer constant must have
//                               integer type
//
// A legal program that failed to compile, silently introduced the day
// `.to_string()` started using `%.15g`. The mantissa is what needs the
// point, so the `.0` goes BEFORE the exponent.
let cg_float_text (v: Float): String = {
    let s = v.to_string();
    if Option.is_some(String.index_of(s, ".")) { s }
    else {
        match String.index_of(s, "e") {
            None => s.concat(".0"),
            Some(i) => String.slice(s, 0, i).concat(".0").concat(String.slice(s, i, s.len())),
        }
    }
}

let cg_ident (p: CgProgram) (env: Array[CgSlot]) (n: Int) (name: String) (ty: CgTy): Emit =
    match cg_lookup(env, name) {
        Some(slot) => {
            let reg = cg_reg(n);
            Emit {
                // Rule 3: a read yields a NEW owned reference. The slot
                // keeps its own, so the two are independent and the
                // slot's eventual release stays balanced.
                code: "  ".concat(reg).concat(" = load ").concat(cg_llvm_ty(slot.ty)).concat(", ptr ").concat(slot.ptr).concat("\n").concat(cg_inc(slot.ty, reg)),
                allocas: "", releases: "", globals: "", val: reg, ty: slot.ty, n: n + 1,
            }
        },
        // Every nullary variant (`None`, `TokEof`) now arrives as a
        // `TVariantNew` node instead, because the CHECKER resolved it —
        // so an unbound name reaching here is an internal error, not a
        // user one.
        None => { cg_fail("internal: unbound variable reached codegen: ".concat(name)); cg_unit_emit(n) },
    }

let cg_unary (p: CgProgram) (env: Array[CgSlot]) (n: Int) (op: parser.UOp) (inner: typecheck.TExpr): Emit = {
    let r = cg_expr(p, env, n, inner);
    let reg = cg_reg(r.n);
    let line = match op {
        UNeg => match r.ty {
            CgFloat => "  ".concat(reg).concat(" = fneg double ").concat(r.val).concat("\n"),
            _ => "  ".concat(reg).concat(" = sub i64 0, ").concat(r.val).concat("\n"),
        },
        UNot => "  ".concat(reg).concat(" = xor i1 ").concat(r.val).concat(", true\n"),
    };
    Emit { code: r.code.concat(line), allocas: r.allocas, releases: r.releases,globals: r.globals, val: reg, ty: r.ty, n: r.n + 1 }
}

// --- Binary operators ---
//
// `&&`/`||` are handled FIRST and separately, because they are the only
// two that must not evaluate their right operand unconditionally. They
// compile to real branches, through the same slot-and-merge shape `if`
// uses. (The self-hosted INTERPRETER had this exact bug until
// self-interpretation found it — see `interp.plum`'s `eval_binary_expr`.)
let cg_binary (p: CgProgram) (env: Array[CgSlot]) (n: Int) (op: parser.BOp) (lhs: typecheck.TExpr) (rhs: typecheck.TExpr) (ty: CgTy): Emit =
    match op {
        BAnd => cg_shortcircuit(p, env, n, lhs, rhs, true),
        BOr => cg_shortcircuit(p, env, n, lhs, rhs, false),
        BRange => { cg_fail("'..' is only supported as a 'for' iterand"); cg_unit_emit(n) },
        // Unreachable: the checker desugars `|>` into a call, so no
        // `TBinary(BPipe, ..)` ever reaches codegen.
        BPipe => { cg_fail("internal: un-desugared '|>'"); cg_unit_emit(n) },
        _ => cg_strict_binary(p, env, n, op, lhs, rhs, ty),
    }

let cg_strict_binary (p: CgProgram) (env: Array[CgSlot]) (n: Int) (op: parser.BOp) (lhs: typecheck.TExpr) (rhs: typecheck.TExpr) (ty: CgTy): Emit = {
    // Comparison BORROWS both sides — `==` reads them and produces a
    // Bool, so neither operand's ownership is needed.
    let a = cg_borrow(p, env, n, lhs);
    let b = cg_borrow(p, env, a.n, rhs);
    let reg = cg_reg(b.n);
    let code = a.code.concat(b.code);
    let globals = a.globals.concat(b.globals);
    let allocas = a.allocas.concat(b.allocas);
    let releases = a.releases.concat(b.releases);
    if cg_is_equality(op) {
        // Structural, via `cg_eq_code` — which is one instruction for a
        // primitive and a call to a generated function for anything
        // else. Address comparison would be wrong for every aggregate.
        let opnd = cg_concrete(p, typecheck.texpr_ty(p.subst, lhs));
        let cmp = cg_eq_code(opnd, a.val, b.val, b.n);
        // Both operands were owned temporaries and the comparison
        // borrowed them.
        let drop_operands = a.drop.concat(b.drop);
        match op {
            BEq => Emit { code: code.concat(cmp.code).concat(drop_operands), allocas: allocas, releases: releases, globals: globals, val: cmp.val, ty: CgBool, n: cmp.n },
            _ => {
                let neg = cg_reg(cmp.n);
                Emit { code: code.concat(cmp.code).concat(drop_operands).concat("  ").concat(neg).concat(" = xor i1 ").concat(cmp.val).concat(", true\n"), allocas: allocas, releases: releases, globals: globals, val: neg, ty: CgBool, n: cmp.n + 1 }
            },
        }
    } else if cg_ty_eq(a.ty, CgStr) {
        // ORDERED comparison of Strings, by CONTENT.
        //
        // Without this the generic emitter below produced `icmp slt
        // ptr` -- a comparison of ADDRESSES. It gave an answer, it was
        // silent, and it was whatever the allocator happened to do:
        // `"p" > "a"` was false while `id("p") > id("a")` was true.
        // The prelude never noticed because it works around it --
        // `Array.sort_string` calls `string_le`, not `<=`.
        //
        // `@plum_str_cmp_raw` is the same comparison `string_le` uses,
        // so the operator and the helper can no longer disagree.
        let cmp = cg_reg(b.n);
        let res = cg_reg(b.n + 1);
        let line = "  ".concat(cmp).concat(" = call i64 @plum_str_cmp_raw(ptr ").concat(a.val).concat(", ptr ").concat(b.val).concat(")\n")
            .concat("  ").concat(res).concat(" = ").concat(cg_str_rel_pred(op)).concat(" i64 ").concat(cmp).concat(", 0\n");
        Emit { code: code.concat(line).concat(a.drop).concat(b.drop), allocas: allocas, releases: releases, globals: globals, val: res, ty: CgBool, n: b.n + 2 }
    } else if cg_is_checked_arith(op, a.ty) {
        // CHECKED. `+`, `-` and `*` on Int stop the program on overflow
        // rather than wrapping -- see `cg_overflow_guard`.
        let g = cg_overflow_guard(cg_overflow_intrinsic(op), a.val, b.val, b.n);
        Emit { code: code.concat(g.code), allocas: allocas, releases: releases, globals: globals, val: g.reg, ty: ty, n: g.next }
    } else if cg_is_int_division(op, a.ty) {
        // GUARDED. See `cg_div_guard` -- `sdiv`/`srem` are undefined
        // for a zero divisor and for `i64::MIN / -1`, and the emitted
        // program did not merely crash, it printed a wrong number and
        // kept going.
        let g = cg_div_guard(a.val, b.val, b.n);
        let line = "  ".concat(g.reg).concat(" = ").concat(cg_binary_op_text(op, a.ty)).concat(" ").concat(cg_llvm_ty(a.ty)).concat(" ").concat(a.val).concat(", ").concat(b.val).concat("\n");
        Emit { code: code.concat(g.code).concat(line), allocas: allocas, releases: releases, globals: globals, val: g.reg, ty: ty, n: g.next }
    } else {
        let line = "  ".concat(reg).concat(" = ").concat(cg_binary_op_text(op, a.ty)).concat(" ").concat(cg_llvm_ty(a.ty)).concat(" ").concat(a.val).concat(", ").concat(b.val).concat("\n");
        Emit { code: code.concat(line), allocas: allocas, releases: releases, globals: globals, val: reg, ty: ty, n: b.n + 1 }
    }
}

// `strcmp`-shaped result against zero. Only the four ordered
// comparisons reach here; equality went through `cg_eq_code` above.
let cg_str_rel_pred (op: parser.BOp): String =
    match op {
        BLt => "icmp slt",
        BLe => "icmp sle",
        BGt => "icmp sgt",
        BGe => "icmp sge",
        _ => { cg_fail("internal: non-ordered operator on String"); "icmp slt" },
    }

let cg_is_checked_arith (op: parser.BOp) (t: CgTy): Bool =
    if cg_ty_eq(t, CgFloat) { false } else { match op { BAdd => true, BSub => true, BMul => true, _ => false } }

let cg_overflow_intrinsic (op: parser.BOp): String =
    match op {
        BAdd => "llvm.sadd.with.overflow.i64",
        BSub => "llvm.ssub.with.overflow.i64",
        _ => "llvm.smul.with.overflow.i64",
    }

// `+`, `-` and `*` on Int, CHECKED: an overflowing one stops the
// program instead of wrapping.
//
// The interpreter has always done this (`eval_arith` uses
// `checked_add` and friends) while both backends wrapped silently, so
// `9223372036854775807 + 1` printed -9223372036854775808 compiled and
// errored interpreted. Closing that divergence was a decision, not a
// bug fix: wrapping is defensible, it just was not what the
// interpreter implemented, and having both is not.
//
// The cost was measured before choosing: about 1.6x on an
// arithmetic-dense, data-dependent loop, and much worse on a loop LLVM
// could otherwise close-form or vectorize, since the early exits block
// that outright. Accepted because Plum already checks array bounds and
// division unconditionally, and silently wrong arithmetic is precisely
// what this language has been removing.
//
// Reuses `@plum_div_overflow_fail` -- the message is the same, and the
// interpreter reports `integer overflow` for both.
let cg_overflow_guard (intrinsic: String) (lhs: String) (rhs: String) (n: Int): DivGuard = {
    let pair = cg_reg(n);
    let value = cg_reg(n + 1);
    let ovf = cg_reg(n + 2);
    let ok = cg_reg(n + 3);
    let cont = cg_label(n + 4);
    let bad = cg_label(n + 5);
    let code = "  ".concat(pair).concat(" = call { i64, i1 } @").concat(intrinsic).concat("(i64 ").concat(lhs).concat(", i64 ").concat(rhs).concat(")\n")
        .concat("  ").concat(value).concat(" = extractvalue { i64, i1 } ").concat(pair).concat(", 0\n")
        .concat("  ").concat(ovf).concat(" = extractvalue { i64, i1 } ").concat(pair).concat(", 1\n")
        .concat("  ").concat(ok).concat(" = xor i1 ").concat(ovf).concat(", true\n")
        .concat("  br i1 ").concat(ok).concat(", label %").concat(cont).concat(", label %").concat(bad).concat("\n")
        .concat(bad).concat(":\n")
        .concat("  call void @plum_div_overflow_fail()\n")
        .concat("  unreachable\n")
        .concat(cont).concat(":\n");
    DivGuard { code: code, reg: value, next: n + 6 }
}

let cg_is_int_division (op: parser.BOp) (t: CgTy): Bool =
    if cg_ty_eq(t, CgFloat) { false } else { match op { BDiv => true, BRem => true, _ => false } }

struct DivGuard { code: String, reg: String, next: Int }

// The two checks LLVM needs before an integer `sdiv`/`srem`, because
// both of its undefined cases are reachable from ordinary Plum:
//
//   10 / d   where d is a runtime 0      -> undefined
//   MIN / -1                             -> undefined
//
// Undefined is not "crashes". Optimized, `10 / d` printed 135105 under
// this backend and 22988924727 under the real one, and BOTH programs
// continued afterwards. Unoptimized it was SIGFPE with no message.
//
// The messages match the interpreter's (`eval_arith`'s `checked_div`),
// which has been right all along -- this closes a divergence between
// the backends and the interpreter rather than inventing a rule.
//
// Nothing is emitted conditionally on the divisor being a constant:
// `icmp ne i64 5, 0` folds to `true` and LLVM deletes the branch, so
// the cost lands only where the divisor is genuinely unknown.
let cg_div_guard (lhs: String) (rhs: String) (n: Int): DivGuard = {
    let nz = cg_reg(n);
    let zero_ok = cg_label(n + 1);
    let zero_bad = cg_label(n + 2);
    let is_min = cg_reg(n + 3);
    let is_neg1 = cg_reg(n + 4);
    let both = cg_reg(n + 5);
    let ovf_ok_reg = cg_reg(n + 6);
    let ovf_ok = cg_label(n + 7);
    let ovf_bad = cg_label(n + 8);
    let code = "  ".concat(nz).concat(" = icmp ne i64 ").concat(rhs).concat(", 0\n")
        .concat("  br i1 ").concat(nz).concat(", label %").concat(zero_ok).concat(", label %").concat(zero_bad).concat("\n")
        .concat(zero_bad).concat(":\n")
        .concat("  call void @plum_div_zero_fail()\n")
        .concat("  unreachable\n")
        .concat(zero_ok).concat(":\n")
        .concat("  ").concat(is_min).concat(" = icmp eq i64 ").concat(lhs).concat(", -9223372036854775808\n")
        .concat("  ").concat(is_neg1).concat(" = icmp eq i64 ").concat(rhs).concat(", -1\n")
        .concat("  ").concat(both).concat(" = and i1 ").concat(is_min).concat(", ").concat(is_neg1).concat("\n")
        .concat("  ").concat(ovf_ok_reg).concat(" = xor i1 ").concat(both).concat(", true\n")
        .concat("  br i1 ").concat(ovf_ok_reg).concat(", label %").concat(ovf_ok).concat(", label %").concat(ovf_bad).concat("\n")
        .concat(ovf_bad).concat(":\n")
        .concat("  call void @plum_div_overflow_fail()\n")
        .concat("  unreachable\n")
        .concat(ovf_ok).concat(":\n");
    DivGuard { code: code, reg: cg_reg(n + 9), next: n + 10 }
}

let cg_is_equality (op: parser.BOp): Bool = match op { BEq => true, BNe => true, _ => false }

// LLVM spells the same Plum operator differently for integers and
// floats (`add`/`fadd`, `icmp slt`/`fcmp olt`), so the operand's
// representation picks the mnemonic. `fcmp olt` is the ORDERED form:
// a comparison involving NaN is false, matching Plum's own semantics.
let cg_binary_op_text (op: parser.BOp) (t: CgTy): String = {
    let f = cg_ty_eq(t, CgFloat);
    match op {
        BAdd => if f { "fadd" } else { "add" },
        BSub => if f { "fsub" } else { "sub" },
        BMul => if f { "fmul" } else { "mul" },
        BDiv => if f { "fdiv" } else { "sdiv" },
        BRem => if f { "frem" } else { "srem" },
        BEq => if f { "fcmp oeq" } else { "icmp eq" },
        BNe => if f { "fcmp one" } else { "icmp ne" },
        BLt => if f { "fcmp olt" } else { "icmp slt" },
        BGt => if f { "fcmp ogt" } else { "icmp sgt" },
        BLe => if f { "fcmp ole" } else { "icmp sle" },
        BGe => if f { "fcmp oge" } else { "icmp sge" },
        BAnd => { cg_fail("'&&' should have been short-circuited"); "and" },
        BOr => { cg_fail("'||' should have been short-circuited"); "or" },
        BRange => { cg_fail("'..' isn't an operator here"); "add" },
        BPipe => { cg_fail("internal: un-desugared '|>'"); "add" },
    }
}

// `a && b` is `if a { b } else { false }`, and `a || b` is `if a { true
// } else { b }` — one slot, two blocks, a merge. Written directly
// rather than by rewriting to an `EIf` so the emitted labels stay
// readable and no synthetic AST node is needed.
let cg_shortcircuit (p: CgProgram) (env: Array[CgSlot]) (n: Int) (lhs: typecheck.TExpr) (rhs: typecheck.TExpr) (is_and: Bool): Emit = {
    let a = cg_expr(p, env, n, lhs);
    let slot = cg_reg(a.n);
    let rhs_label = cg_label(a.n + 1);
    let end_label = cg_label(a.n + 2);
    let b = cg_expr(p, env, a.n + 3, rhs);
    let res = cg_reg(b.n);
    let shortcut = if is_and { "0" } else { "1" };
    let br = if is_and {
        "  br i1 ".concat(a.val).concat(", label %").concat(rhs_label).concat(", label %").concat(end_label).concat("\n")
    } else {
        "  br i1 ".concat(a.val).concat(", label %").concat(end_label).concat(", label %").concat(rhs_label).concat("\n")
    };
    let code = a.code
        .concat("  store i1 ").concat(shortcut).concat(", ptr ").concat(slot).concat("\n")
        .concat(br)
        .concat(rhs_label).concat(":\n")
        .concat(b.code)
        .concat("  store i1 ").concat(b.val).concat(", ptr ").concat(slot).concat("\n")
        .concat("  br label %").concat(end_label).concat("\n")
        .concat(end_label).concat(":\n")
        .concat("  ").concat(res).concat(" = load i1, ptr ").concat(slot).concat("\n");
    Emit { code: code, allocas: "  ".concat(slot).concat(" = alloca i1\n").concat(a.allocas).concat(b.allocas), releases: a.releases.concat(b.releases),globals: a.globals.concat(b.globals), val: res, ty: CgBool, n: b.n + 1 }
}

// --- if/else ---
//
// Both arms store into one slot; the merge block loads it. An `else`-
// less `if` is `Unit`-typed and stores the unit value in the implicit
// else, so the slot is always initialized on every path.
let cg_if (p: CgProgram) (env: Array[CgSlot]) (n: Int) (cond: typecheck.TExpr) (then_branch: typecheck.TExpr) (else_branch: Option[typecheck.TExpr]) (ty: CgTy): Emit = {
    let c = cg_expr(p, env, n, cond);
    let slot = cg_reg(c.n);
    let then_label = cg_label(c.n + 1);
    let else_label = cg_label(c.n + 2);
    let end_label = cg_label(c.n + 3);
    let t = cg_expr(p, env, c.n + 4, then_branch);
    let e = match else_branch {
        Some(x) => cg_expr(p, env, t.n, x),
        None => cg_unit_emit(t.n),
    };
    let res = cg_reg(e.n);
    let lty = cg_llvm_ty(ty);
    let code = c.code
        .concat("  br i1 ").concat(c.val).concat(", label %").concat(then_label).concat(", label %").concat(else_label).concat("\n")
        .concat(then_label).concat(":\n")
        .concat(t.code)
        .concat("  store ").concat(lty).concat(" ").concat(t.val).concat(", ptr ").concat(slot).concat("\n")
        .concat("  br label %").concat(end_label).concat("\n")
        .concat(else_label).concat(":\n")
        .concat(e.code)
        .concat("  store ").concat(lty).concat(" ").concat(e.val).concat(", ptr ").concat(slot).concat("\n")
        .concat("  br label %").concat(end_label).concat("\n")
        .concat(end_label).concat(":\n")
        .concat("  ").concat(res).concat(" = load ").concat(lty).concat(", ptr ").concat(slot).concat("\n");
    Emit { code: code, allocas: "  ".concat(slot).concat(" = alloca ").concat(lty).concat("\n").concat(c.allocas).concat(t.allocas).concat(e.allocas), releases: c.releases.concat(t.releases).concat(e.releases),globals: c.globals.concat(t.globals).concat(e.globals), val: res, ty: ty, n: e.n + 1 }
}

// --- for loops ---
//
// Only `for x in lo..hi` — a literal range — matching the self-hosted
// INTERPRETER's own identical restriction (`eval_for_env`). Iterating an
// array needs arrays first.
//
// The bound is evaluated ONCE, before the loop, into its own slot:
// re-evaluating `hi` per iteration would be both slower and wrong for a
// bound whose expression has effects. The induction variable lives in a
// slot too, which is what lets the loop body read it as an ordinary
// local with no special case at all.
//
// A `for` is `Unit`-valued. Assignments its body makes to OUTER locals
// take effect with no extra machinery, because those locals are slots
// and a store is a store — the exact thing the self-hosted interpreter
// needed a whole env-threading mechanism (`scope_out`) to get right.
// The range's two ends arrive as separate typed children — the checker
// already destructured `lo..hi`, so there is no `BRange` node left to
// pattern-match on here.
let cg_for (p: CgProgram) (env: Array[CgSlot]) (n: Int) (pattern: parser.PPattern) (lo_e: typecheck.TExpr) (hi_e: typecheck.TExpr) (body: typecheck.TExpr): Emit = {
    let lo = cg_expr(p, env, n, lo_e);
    let hi = cg_expr(p, env, lo.n, hi_e);
    let iv = cg_reg(hi.n);
    let hi_slot = cg_reg(hi.n + 1);
    let cond_label = cg_label(hi.n + 2);
    let body_label = cg_label(hi.n + 3);
    let end_label = cg_label(hi.n + 4);
    let cur = cg_reg(hi.n + 5);
    let bound = cg_reg(hi.n + 6);
    let test = cg_reg(hi.n + 7);
    let b = cg_expr(p, env.push(CgSlot { name: cg_let_name(pattern), ptr: iv, ty: CgInt, ity: ITInt }), hi.n + 8, body);
    let step_cur = cg_reg(b.n);
    let step_next = cg_reg(b.n + 1);
    let code = lo.code.concat(hi.code)
        .concat("  store i64 ").concat(lo.val).concat(", ptr ").concat(iv).concat("\n")
        .concat("  store i64 ").concat(hi.val).concat(", ptr ").concat(hi_slot).concat("\n")
        .concat("  br label %").concat(cond_label).concat("\n")
        .concat(cond_label).concat(":\n")
        .concat("  ").concat(cur).concat(" = load i64, ptr ").concat(iv).concat("\n")
        .concat("  ").concat(bound).concat(" = load i64, ptr ").concat(hi_slot).concat("\n")
        .concat("  ").concat(test).concat(" = icmp slt i64 ").concat(cur).concat(", ").concat(bound).concat("\n")
        .concat("  br i1 ").concat(test).concat(", label %").concat(body_label).concat(", label %").concat(end_label).concat("\n")
        .concat(body_label).concat(":\n")
        .concat(b.code)
        .concat("  ").concat(step_cur).concat(" = load i64, ptr ").concat(iv).concat("\n")
        .concat("  ").concat(step_next).concat(" = add i64 ").concat(step_cur).concat(", 1\n")
        .concat("  store i64 ").concat(step_next).concat(", ptr ").concat(iv).concat("\n")
        .concat("  br label %").concat(cond_label).concat("\n")
        .concat(end_label).concat(":\n");
    let allocas = "  ".concat(iv).concat(" = alloca i64\n")
        .concat("  ").concat(hi_slot).concat(" = alloca i64\n")
        .concat(lo.allocas).concat(hi.allocas).concat(b.allocas);
    Emit { code: code, allocas: allocas, releases: lo.releases.concat(hi.releases).concat(b.releases), globals: lo.globals.concat(hi.globals).concat(b.globals), val: "0", ty: CgUnit, n: b.n + 2 }
}

// `for x in xs` over an ARRAY: an index loop that loads each element
// into the binding's slot. Structurally `cg_for`'s sibling -- same
// counter, same three blocks -- with the bound read from the array's
// length header instead of a second operand.
//
// Ownership follows `cg_array_map`'s rule exactly. The array is an
// owned temporary here (`cg_expr`, not `cg_borrow`), released once the
// loop is done. Each element is BORROWED from it for the duration of
// one iteration: the binding takes its own reference on the way in and
// gives it back on the way out, so a body that stores the element
// somewhere longer-lived has already incremented it independently, and
// a body that merely reads it leaves the count where it started.
let cg_for_array (p: CgProgram) (env: Array[CgSlot]) (n: Int) (pattern: parser.PPattern) (arr_e: typecheck.TExpr) (body: typecheck.TExpr): Emit = {
    let a = cg_expr(p, env, n, arr_e);
    let elem_ity = cg_elem_ity(p, arr_e);
    let elem = cg_of_ity(elem_ity);
    let lty = cg_llvm_ty(elem);
    let iv = cg_reg(a.n);
    let slot = cg_reg(a.n + 1);
    let len_slot = cg_reg(a.n + 2);
    let cond_label = cg_label(a.n + 3);
    let body_label = cg_label(a.n + 4);
    let end_label = cg_label(a.n + 5);
    let cur = cg_reg(a.n + 6);
    let bound = cg_reg(a.n + 7);
    let test = cg_reg(a.n + 8);
    let ep = cg_reg(a.n + 9);
    let ev = cg_reg(a.n + 10);
    let len0 = cg_reg(a.n + 11);
    let b = cg_expr(p, env.push(CgSlot { name: cg_let_name(pattern), ptr: slot, ty: elem, ity: elem_ity }), a.n + 12, body);
    let step_cur = cg_reg(b.n);
    let step_next = cg_reg(b.n + 1);
    let code = a.code
        .concat("  ").concat(len0).concat(" = call i64 @plum_array_len(ptr ").concat(a.val).concat(")\n")
        .concat("  store i64 0, ptr ").concat(iv).concat("\n")
        .concat("  store i64 ").concat(len0).concat(", ptr ").concat(len_slot).concat("\n")
        .concat("  br label %").concat(cond_label).concat("\n")
        .concat(cond_label).concat(":\n")
        .concat("  ").concat(cur).concat(" = load i64, ptr ").concat(iv).concat("\n")
        .concat("  ").concat(bound).concat(" = load i64, ptr ").concat(len_slot).concat("\n")
        .concat("  ").concat(test).concat(" = icmp slt i64 ").concat(cur).concat(", ").concat(bound).concat("\n")
        .concat("  br i1 ").concat(test).concat(", label %").concat(body_label).concat(", label %").concat(end_label).concat("\n")
        .concat(body_label).concat(":\n")
        .concat(cg_elem_ptr_lines_at(a.val, cur, ep))
        .concat("  ").concat(ev).concat(" = load ").concat(lty).concat(", ptr ").concat(ep).concat("\n")
        .concat(cg_inc(elem, ev))
        .concat("  store ").concat(lty).concat(" ").concat(ev).concat(", ptr ").concat(slot).concat("\n")
        .concat(b.code)
        .concat(cg_dec(elem_ity, ev))
        .concat("  ").concat(step_cur).concat(" = load i64, ptr ").concat(iv).concat("\n")
        .concat("  ").concat(step_next).concat(" = add i64 ").concat(step_cur).concat(", 1\n")
        .concat("  store i64 ").concat(step_next).concat(", ptr ").concat(iv).concat("\n")
        .concat("  br label %").concat(cond_label).concat("\n")
        .concat(end_label).concat(":\n")
        .concat(cg_dec(cg_concrete(p, typecheck.texpr_ty(p.subst, arr_e)), a.val));
    let allocas = "  ".concat(iv).concat(" = alloca i64\n")
        .concat("  ").concat(len_slot).concat(" = alloca i64\n")
        .concat("  ").concat(slot).concat(" = alloca ").concat(lty).concat("\n")
        .concat(a.allocas).concat(b.allocas);
    Emit { code: code, allocas: allocas, releases: a.releases.concat(b.releases), globals: a.globals.concat(b.globals), val: "0", ty: CgUnit, n: b.n + 2 }
}

// The element pointer for a RUNTIME index, as opposed to
// `cg_elem_ptr_lines`'s numbered-register form.
let cg_elem_ptr_lines_at (arr: String) (idx: String) (out: String): String =
    "  ".concat(out).concat("_off = mul i64 ").concat(idx).concat(", 8\n")
        .concat("  ").concat(out).concat("_b = getelementptr i8, ptr ").concat(arr).concat(", i64 ").concat(out).concat("_off\n")
        .concat("  ").concat(out).concat(" = getelementptr i8, ptr ").concat(out).concat("_b, i64 ").concat(cg_array_elem_offset(0).to_string()).concat("\n")

// The ELEMENT type of an array-typed expression, as an `ITy` -- needed
// because a `CgArray`'s own element representation has already thrown
// away the type arguments a release function needs.
let cg_elem_ity (p: CgProgram) (arr_e: typecheck.TExpr): typecheck.ITy =
    match cg_concrete(p, typecheck.texpr_ty(p.subst, arr_e)) {
        ITStruct(name, args) => if name == "Array" && args.len() == 1 { args[0] } else { ITUnit },
        _ => ITUnit,
    }

// --- Blocks and statements ---
//
// A block's own `let` bindings extend the environment for the rest of
// the block and then go out of scope, which falls out of threading the
// environment by value: `cg_block` never returns its inner `env`.
struct BlockEmit { code: String, allocas: String, releases: String, globals: String, env: Array[CgSlot], n: Int }

let cg_block_ty (p: CgProgram) (env: Array[CgSlot]) (n: Int) (block: typecheck.TBlock) (ty: CgTy): Emit = {
    let s = cg_stmts(p, env, n, block.stmts, 0);
    match block.tail {
        Some(t) => {
            let r = cg_expr(p, s.env, s.n, t);
            Emit { code: s.code.concat(r.code), allocas: s.allocas.concat(r.allocas), releases: s.releases.concat(r.releases),globals: s.globals.concat(r.globals), val: r.val, ty: ty, n: r.n }
        },
        None => Emit { code: s.code, allocas: s.allocas, releases: s.releases,globals: s.globals, val: "0", ty: CgUnit, n: s.n },
    }
}

let cg_stmts (p: CgProgram) (env: Array[CgSlot]) (n: Int) (stmts: Array[typecheck.TStmt]) (i: Int): BlockEmit =
    if i >= stmts.len() { BlockEmit { code: "", allocas: "", releases: "",globals: "", env: env, n: n } }
    else {
        match stmts[i] {
            // A DESTRUCTURING `let` is an irrefutable one-arm match,
            // so it reuses the pattern machinery rather than growing a
            // second copy of it: `cg_pattern` already knows how to bind
            // every name in a tuple/struct pattern, take a reference per
            // binding, and report the slots it created. The `test` it
            // produces is ignored -- the checker has already established
            // the pattern is irrefutable, which is what makes this a
            // `let` and not a `match`.
            TSLet(pattern, value) => if !cg_is_ident_pattern(pattern) {
                let r = cg_expr(p, env, n, value);
                let vty = cg_concrete(p, typecheck.texpr_ty(p.subst, value));
                let pat = cg_pattern(p, env, r.n, pattern, r.val, vty);
                // Bindings borrow from the scrutinee and take their own
                // reference (see `cg_pattern`'s `PIdent` arm), so the
                // scrutinee's own reference is released once they have.
                let head = r.code.concat(pat.code).concat(pat.binds).concat(cg_dec(vty, r.val));
                let rest = cg_stmts(p, pat.env, pat.n, stmts, i + 1);
                BlockEmit {
                    code: head.concat(rest.code),
                    allocas: r.allocas.concat(pat.allocas).concat(rest.allocas),
                    releases: r.releases.concat(pat.releases).concat(rest.releases),
                    globals: r.globals.concat(pat.globals).concat(rest.globals),
                    env: rest.env, n: rest.n,
                }
            } else {
                // The slot register is claimed BEFORE the initializer is
                // emitted, so the initializer can be handed it as a
                // reuse candidate (`lv_self_slot`). It is only in scope
                // under that reserved name, never under `name`, so
                // shadowing is unaffected.
                let vty = cg_concrete(p, typecheck.texpr_ty(p.subst, value));
                let slot = cg_reg(n);
                let r = cg_expr(p, env.push(CgSlot { name: lv_self_slot(()), ptr: slot, ty: cg_of_ity(vty), ity: vty }), n + 1, value);
                let name = cg_let_name(pattern);
                let lty = cg_llvm_ty(r.ty);
                // Rule 2: the slot takes ownership of `r`'s +1. Any
                // value already in the slot -- a previous iteration's,
                // if this `let` is inside a loop -- is released first.
                let head = r.code
                    .concat(cg_release_slot(vty, slot, "_pre"))
                    .concat("  store ").concat(lty).concat(" ").concat(r.val).concat(", ptr ").concat(slot).concat("\n");
                let rest = cg_stmts(p, env.push(CgSlot { name: name, ptr: slot, ty: r.ty, ity: vty }), r.n, stmts, i + 1);
                BlockEmit {
                    code: head.concat(rest.code),
                    // The null-init and the exit release are as much a
                    // part of creating a slot as the `alloca` is; a slot
                    // whose release goes missing leaks, and one whose
                    // null-init goes missing releases uninitialised
                    // stack the first time it is overwritten.
                    allocas: "  ".concat(slot).concat(" = alloca ").concat(lty).concat("\n").concat(cg_null_init(vty, slot)).concat(r.allocas).concat(rest.allocas),
                    releases: cg_release_slot(vty, slot, "_end").concat(r.releases).concat(rest.releases),
                    globals: r.globals.concat(rest.globals), env: rest.env, n: rest.n }
            },
            // Assignment needs no new slot — that is the whole payoff of
            // every local being an `alloca`: `let mut` and `let` are the
            // same thing here, and a reassignment is one `store`.
            // `acc = acc.concat(x)` — the slot's current value is dead
            // the instant the slot is overwritten, which is the one
            // place ownership can be transferred into an operation
            // without any liveness analysis. That makes it eligible for
            // REUSE: appending in place when the cell turns out to be
            // uniquely referenced, instead of allocating a copy.
            //
            // This exact shape is what caused three separate accidental
            // O(n^2) blowups earlier in this project (string joins,
            // `Array.push` accumulation, `String.index_of`), so it is
            // worth special-casing even though a general last-use
            // analysis would subsume it.
            TSAssign(name, value) => if cg_is_self_method(name, value, "concat") {
                cg_self_concat(p, env, n, name, value, stmts, i)
            } else if cg_is_self_method(name, value, "push") {
                cg_self_push(p, env, n, name, value, stmts, i)
            } else {
                let r = cg_expr(p, env, n, value);
                let store = match cg_lookup(env, name) {
                    Some(slot) => cg_release_slot(cg_concrete(p, typecheck.texpr_ty(p.subst, value)), slot.ptr, "_a".concat(r.n.to_string())).concat("  store ").concat(cg_llvm_ty(slot.ty)).concat(" ").concat(r.val).concat(", ptr ").concat(slot.ptr).concat("\n"),
                    None => { cg_fail("assignment to an unbound name: ".concat(name)); "" },
                };
                let rest = cg_stmts(p, env, r.n + 1, stmts, i + 1);
                BlockEmit { code: r.code.concat(store).concat(rest.code), allocas: r.allocas.concat(rest.allocas), releases: r.releases.concat(rest.releases), globals: r.globals.concat(rest.globals), env: rest.env, n: rest.n }
            },
            TSExpr(e) => {
                let r = cg_expr(p, env, n, e);
                let rest = cg_stmts(p, env, r.n, stmts, i + 1);
                // Rule 1: the value is owned, and nothing takes it.
                BlockEmit { code: r.code.concat(cg_dec(cg_concrete(p, typecheck.texpr_ty(p.subst, e)), r.val)).concat(rest.code), allocas: r.allocas.concat(rest.allocas), releases: r.releases.concat(rest.releases),globals: r.globals.concat(rest.globals), env: rest.env, n: rest.n }
            },
        }
    }

// --- Move-on-last-read ---
//
// The one thing standing between this backend and the real one on
// accumulator code. Reference counting here is precise (see the note
// further down), and `cg_borrow` on an identifier is a TRUE borrow — no
// increment — so `acc.concat(x)` already sees refcount 1. What it does not
// do is hand that reference OVER: `cg_concat` calls the copying
// `@plum_str_concat`, and reuse was reachable only through
// `cg_is_self_method`'s literal `x = x.concat(..)` shape.
//
// So `go(acc.concat("x"), n - 1)` — an accumulator threaded through a
// tail-recursive call, which is how this whole compiler is written —
// copied the accumulator every iteration. Measured against the real
// backend on a 20,000-item accumulation: 200.4 MB here versus 0.36 MB
// there, and 194 MB versus 5.2 MB of peak RSS.
//
// A slot read AT MOST ONCE on any path can hand its reference over
// instead of lending it: load it, store null back, and skip the
// increment. Storing null is what makes this need no path analysis at
// all — the slot's release at function exit still runs, and every
// `plum_rel_*` is null-safe by construction (see `cg_null_init`, which
// relies on the same property), so it becomes a no-op on exactly the
// paths where the reference left.
//
// Safe with no whole-program reasoning, unlike the real backend's version
// of this: rule 4 below says a call CONSUMES its arguments, so a parameter
// slot OWNS its value outright and no caller is still holding it. That is
// the owned-parameter convention `plum-ir` deliberately does not have.
//
// Counting reads on any PATH rather than in total is what admits the
// accumulator: `if n == 0 { acc } else { go(acc.concat("x"), n - 1) }`
// reads `acc` once per branch, and only one branch runs.
let cg_reads_max (name: String) (e: typecheck.TExpr): Int =
    match e.node {
        TIdent(v) => if v == name { 1 } else { 0 },
        TInt(_) => 0,
        TFloat(_) => 0,
        TStr(_) => 0,
        TBool(_) => 0,
        TUnitLit => 0,
        TGlobalRef(_, _) => 0,
        TUnsupported(_) => 0,
        TUnary(_, a) => cg_reads_max(name, a),
        TFieldGet(a, _) => cg_reads_max(name, a),
        TPrintln(a) => cg_reads_max(name, a),
        TSpawn(a) => cg_reads_max(name, a),
        TChannelNew => 0,
        TChannelSend(a, b) => cg_cap2(cg_reads_max(name, a) + cg_reads_max(name, b)),
        TChannelRecv(a) => cg_reads_max(name, a),
        TSelect(arms) => cg_reads_max_select(name, arms, 0, 0),
        TTaskJoin(a) => cg_reads_max(name, a),
        TExternCall(_, xs) => cg_reads_max_list(name, xs, 0, 0),
        TAsCStr(a) => cg_reads_max(name, a),
        TAsString(a) => cg_reads_max(name, a),
        TRefNew(a) => cg_reads_max(name, a),
        TBinary(_, a, b) => cg_cap2(cg_reads_max(name, a) + cg_reads_max(name, b)),
        TIndex(a, b) => cg_cap2(cg_reads_max(name, a) + cg_reads_max(name, b)),
        TArrayLit(xs) => cg_reads_max_list(name, xs, 0, 0),
        TArrayLitReuse(xs, cands) => cg_cap2(cg_reads_max_list(name, xs, 0, 0) + (if cg_name_in(cands, name, 0) { 1 } else { 0 })),
        TTupleLit(xs) => cg_reads_max_list(name, xs, 0, 0),
        TVariantNew(_, _, xs) => cg_reads_max_list(name, xs, 0, 0),
        TFnCall(_, _, xs, _) => cg_reads_max_list(name, xs, 0, 0),
        TArrayNs(_, xs) => cg_reads_max_list(name, xs, 0, 0),
        // The candidate is the first argument, so it is ALREADY counted
        // by the list walk -- adding for it again would double-count the
        // one read the emitted code actually performs.
        TArrayNsReuse(_, xs, _) => cg_reads_max_list(name, xs, 0, 0),
        TStructLit(_, fs, sp) => cg_cap2(cg_reads_max_fields(name, fs, 0, 0) + match sp { Some(b) => cg_reads_max(name, b), None => 0 }),
        // A reuse's candidates are counted as reads: only one of them is
        // actually moved, but which one is a decision the backend makes
        // later, and over-counting only ever refuses a move.
        TStructReuse(_, fs, cands) => cg_cap2(cg_reads_max_fields(name, fs, 0, 0) + (if cg_name_in(cands, name, 0) { 1 } else { 0 })),
        TVariantReuse(_, _, xs, cands) => cg_cap2(cg_reads_max_list(name, xs, 0, 0) + (if cg_name_in(cands, name, 0) { 1 } else { 0 })),
        TMethodCall(_, b, xs) => cg_cap2(cg_reads_max(name, b) + cg_reads_max_list(name, xs, 0, 0)),
        TClosureCall(f, xs) => cg_cap2(cg_reads_max(name, f) + cg_reads_max_list(name, xs, 0, 0)),
        // Branches are ALTERNATIVES: only one runs, so their contribution
        // is the maximum rather than the sum.
        TIf(c, t, e2) => cg_cap2(cg_reads_max(name, c) + cg_max2(cg_reads_max(name, t), match e2 {
            Some(x) => cg_reads_max(name, x),
            None => 0,
        })),
        TMatch(sc, arms) => cg_cap2(cg_reads_max(name, sc) + cg_reads_max_arms(name, arms, 0, 0)),
        TBlockE(b) => cg_reads_max_block(name, b),
        // A loop body and a closure body can both run more than once, so
        // one syntactic read there is not one dynamic read. Two is
        // "more than one" — nothing needs to distinguish it from many.
        TFor(_, lo, hi, body) => cg_cap2(cg_reads_max(name, lo) + cg_reads_max(name, hi)
            + (if cg_reads_max(name, body) > 0 { 2 } else { 0 })),
        TForArray(_, arr, body) => cg_cap2(cg_reads_max(name, arr)
            + (if cg_reads_max(name, body) > 0 { 2 } else { 0 })),
        TClosure(ps, body) => if cg_params_shadow(ps, name, 0) { 0 } else {
            if cg_reads_max(name, body) > 0 { 2 } else { 0 }
        },
    }

// Does `pat` bind `name`? A pattern that does SHADOWS the outer name, so
// reads under it refer to something else and must not be counted.
// The parameters this body reads at most once on any path.
//
// Deliberately NOT filtered by type. An earlier attempt narrowed this
// to String-shaped parameters on the theory that `cg_move_or_own` only
// ever serves `cg_concat` -- it has two callers, and the other is
// `cg_array_push`, whose in-place growth depends on exactly this. The
// filter took `array_push` from 10 allocations to 1002.
let cg_movable_params (body: typecheck.TExpr) (ps: Array[typecheck.TParam]) (i: Int) (acc: Array[String]): Array[String] =
    if i >= ps.len() { acc } else {
        cg_movable_params(body, ps, i + 1,
            if cg_reads_max(ps[i].name, body) <= 1 { acc.push(ps[i].name) } else { acc })
    }

let cg_is_movable (p: CgProgram) (name: String): Bool = cg_name_in(p.movable, name, 0)

let cg_name_in (xs: Array[String]) (name: String) (i: Int): Bool =
    if i >= xs.len() { false } else { if xs[i] == name { true } else { cg_name_in(xs, name, i + 1) } }

let cg_pattern_binds (pat: parser.PPattern) (name: String): Bool =
    match pat {
        PIdent(v, _) => v == name,
        PTuple(ps) => cg_any_pattern_binds(ps, name, 0),
        PVariant(_, ps) => cg_any_pattern_binds(ps, name, 0),
        POr(ps) => cg_any_pattern_binds(ps, name, 0),
        PStruct(_, fps, _) => cg_any_field_pattern_binds(fps, name, 0),
        PInt(_) => false,
        PFloat(_) => false,
        PStr(_) => false,
        PBool(_) => false,
        PWildcard => false,
    }

let cg_any_pattern_binds (ps: Array[parser.PPattern]) (name: String) (i: Int): Bool =
    if i >= ps.len() { false } else {
        if cg_pattern_binds(ps[i], name) { true } else { cg_any_pattern_binds(ps, name, i + 1) }
    }

let cg_any_field_pattern_binds (fps: Array[parser.FieldPatternNode]) (name: String) (i: Int): Bool =
    if i >= fps.len() { false } else {
        if cg_pattern_binds(fps[i].pattern, name) { true } else { cg_any_field_pattern_binds(fps, name, i + 1) }
    }

let cg_cap2 (v: Int): Int = if v > 2 { 2 } else { v }
let cg_max2 (a: Int) (b: Int): Int = if a > b { a } else { b }

let cg_params_shadow (ps: Array[String]) (name: String) (i: Int): Bool =
    if i >= ps.len() { false } else { if ps[i] == name { true } else { cg_params_shadow(ps, name, i + 1) } }

// --- Last use ---
//
// `cg_reads_max` answers "how many times does this body read `name`",
// which is a property of a WHOLE body. Reuse needs a different
// question, asked at a POINT: at this allocation, is `v` ever read
// again? A count cannot answer it. `Entity { x: e.x + 1, y: e.y, hp:
// e.hp }` reads `e` three times and `e` is dead at the closing brace
// all the same -- and that shape, a field read from the very value
// being rebuilt, is what every struct update looks like. The case a
// use count rejects is the normal case.
//
// So this pass walks the body carrying its CONTINUATION: the subtrees
// that will be evaluated after the one it is looking at. A name is dead
// if none of them reads it.
//
// The continuation is carried as EXPRESSIONS rather than as a set of
// names, so that `cg_reads_max` -- already here, already trusted -- is
// what answers "reads it". A second definition of what counts as a read
// would be a second thing to keep in step with the first.
//
// Why a pass, rather than a field on `CgProgram` threaded through the
// emitters the way `movable` is: a continuation that FORGETS a sibling
// does not miss an optimisation, it miscompiles. Here every recursion
// site is in one function and auditing them is reading it top to
// bottom. Spread across thirty emitters, the same audit is thirty
// places where a missing `lv_with` looks exactly like correct code.
struct LvCtx { exprs: Array[typecheck.TExpr], names: Array[String], scope: Array[String] }

// Names bound and still in scope, innermost LAST -- `lv_pick` searches
// backwards so a shadowed outer name is never chosen over the inner one
// the backend would resolve.
let lv_dead (ctx: LvCtx) (v: String): Bool =
    if cg_name_in(ctx.names, v, 0) { false } else { lv_none_read(ctx.exprs, v, 0) }

let lv_none_read (xs: Array[typecheck.TExpr]) (v: String) (i: Int): Bool =
    if i >= xs.len() { true }
    else if cg_reads_max(v, xs[i]) > 0 { false }
    else { lv_none_read(xs, v, i + 1) }

let lv_with (ctx: LvCtx) (extra: Array[typecheck.TExpr]): LvCtx =
    LvCtx { exprs: lv_cat(ctx.exprs, extra, 0), names: ctx.names, scope: ctx.scope }

let lv_cat (a: Array[typecheck.TExpr]) (b: Array[typecheck.TExpr]) (i: Int): Array[typecheck.TExpr] =
    if i >= b.len() { a } else { lv_cat(a.push(b[i]), b, i + 1) }

let lv_cat_names (a: Array[String]) (b: Array[String]) (i: Int): Array[String] =
    if i >= b.len() { a } else { lv_cat_names(a.push(b[i]), b, i + 1) }

let lv_scoped (ctx: LvCtx) (names: Array[String]): LvCtx =
    LvCtx { exprs: ctx.exprs, names: ctx.names, scope: lv_cat_names(ctx.scope, names, 0) }

let lv_rest (xs: Array[typecheck.TExpr]) (from: Int) (acc: Array[typecheck.TExpr]): Array[typecheck.TExpr] =
    if from >= xs.len() { acc } else { lv_rest(xs, from + 1, acc.push(xs[from])) }

// A list evaluated LEFT TO RIGHT: element `i`'s continuation is
// everything after it, plus whatever follows the list itself.
let lv_seq (ctx: LvCtx) (xs: Array[typecheck.TExpr]) (i: Int) (acc: Array[typecheck.TExpr]): Array[typecheck.TExpr] =
    if i >= xs.len() { acc }
    else { lv_seq(ctx, xs, i + 1, acc.push(lv_expr(lv_with(ctx, lv_rest(xs, i + 1, [])), xs[i]))) }

let lv_opt (ctx: LvCtx) (o: Option[typecheck.TExpr]): Option[typecheck.TExpr] =
    match o { None => None, Some(x) => Some(lv_expr(ctx, x)) }

let lv_opt_list (o: Option[typecheck.TExpr]): Array[typecheck.TExpr] =
    match o { None => [], Some(x) => [x] }

let lv_expr (ctx: LvCtx) (e: typecheck.TExpr): typecheck.TExpr =
    typecheck.TExpr { ty: e.ty, node: lv_node(ctx, e.node) }

let lv_node (ctx: LvCtx) (node: typecheck.TNode): typecheck.TNode =
    match node {
        // Leaves: nothing to rewrite, nothing evaluated after them.
        TInt(_) => node,
        TFloat(_) => node,
        TStr(_) => node,
        TBool(_) => node,
        TUnitLit => node,
        TIdent(_) => node,
        TGlobalRef(_, _) => node,
        TUnsupported(_) => node,
        TChannelNew => node,
        TUnary(op, a) => TUnary(op, lv_expr(ctx, a)),
        TFieldGet(a, f) => TFieldGet(lv_expr(ctx, a), f),
        TPrintln(a) => TPrintln(lv_expr(ctx, a)),
        TTaskJoin(a) => TTaskJoin(lv_expr(ctx, a)),
        TChannelRecv(a) => TChannelRecv(lv_expr(ctx, a)),
        // Every arm's RECEIVER is evaluated before any body runs, and
        // exactly one body then runs -- so the receivers are a
        // left-to-right sequence and the bodies are alternatives, the
        // same shape `TIf` has.
        TSelect(arms) => TSelect(lv_select_arms(ctx, arms, 0, [])),
        TAsCStr(a) => TAsCStr(lv_expr(ctx, a)),
        TAsString(a) => TAsString(lv_expr(ctx, a)),
        TRefNew(a) => TRefNew(lv_expr(ctx, a)),
        TBinary(op, a, b) => TBinary(op, lv_expr(lv_with(ctx, [b]), a), lv_expr(ctx, b)),
        TIndex(a, b) => TIndex(lv_expr(lv_with(ctx, [b]), a), lv_expr(ctx, b)),
        TChannelSend(a, b) => TChannelSend(lv_expr(lv_with(ctx, [b]), a), lv_expr(ctx, b)),
        TArrayLit(xs) => TArrayLit(lv_seq(ctx, xs, 0, [])),
        TArrayLitReuse(_, _) => node,
        TTupleLit(xs) => TTupleLit(lv_seq(ctx, xs, 0, [])),
        // An enum rebuild names its candidate nowhere in its own
        // arguments -- `match c { Count(k) => Count(k + 1) }` reads `k`,
        // not `c`. The cell to recycle is the SCRUTINEE, which is why
        // candidacy is deadness alone and not "mentioned here".
        TVariantNew(en, nm, xs) => {
            let xs2 = lv_seq(ctx, xs, 0, []);
            let cands = lv_candidates(ctx, ctx.scope.len() - 1, []);
            if Array.is_empty(cands) { TVariantNew(en, nm, xs2) } else { TVariantReuse(en, nm, xs2, cands) }
        },
        TFnCall(m, nm, xs, targs) => TFnCall(m, nm, lv_seq(ctx, xs, 0, []), targs),
        // `Array.map(xs, f)` can build its result into `xs`'s own cell
        // when `xs` is dead afterwards. Only when the source is a plain
        // NAME: the cell has to be moved out of a slot for its refcount
        // to reach 1, and only a name has a slot to move it out of.
        TArrayNs(nm, xs) => {
            let xs2 = lv_seq(ctx, xs, 0, []);
            let cand = lv_array_cand(ctx, nm, xs);
            if cand == "" { TArrayNs(nm, xs2) } else { TArrayNsReuse(nm, xs2, cand) }
        },
        TExternCall(nm, xs) => TExternCall(nm, lv_seq(ctx, xs, 0, [])),
        TClosureCall(f, xs) => TClosureCall(lv_expr(lv_with(ctx, xs), f), lv_seq(ctx, xs, 0, [])),
        TMethodCall(m, b, xs) => TMethodCall(m, lv_expr(lv_with(ctx, xs), b), lv_seq(ctx, xs, 0, [])),
        // Branches are ALTERNATIVES, so each is rewritten under the
        // continuation of the `if` ITSELF -- what the other branch reads
        // is irrelevant to it, because the two never both run. The
        // condition, which runs before either, sees both.
        TIf(c, t, e2) => TIf(lv_expr(lv_with(ctx, lv_cat([t], lv_opt_list(e2), 0)), c),
            lv_expr(ctx, t), lv_opt(ctx, e2)),
        TMatch(sc, arms) => TMatch(lv_expr(lv_with(ctx, lv_arm_exprs(arms, 0, [])), sc), lv_arms(ctx, arms, 0, [])),
        TBlockE(b) => TBlockE(lv_block(ctx, b, 0, ctx.scope, [])),
        // A loop body and a closure body can run AGAIN. Pushing the body
        // into its own continuation is the back edge: anything the body
        // reads is live at the end of the body, so nothing read in a
        // loop is ever dead inside it.
        TFor(pat, lo, hi, body) => TFor(pat,
            lv_expr(lv_with(ctx, [hi, body]), lo),
            lv_expr(lv_with(ctx, [body]), hi),
            lv_expr(lv_scoped(lv_with(ctx, [body]), lv_pat_names(pat, [])), body)),
        TForArray(pat, arr, body) => TForArray(pat,
            lv_expr(lv_with(ctx, [body]), arr),
            lv_expr(lv_scoped(lv_with(ctx, [body]), lv_pat_names(pat, [])), body)),
        TClosure(ps, body) => TClosure(ps, lv_expr(lv_scoped(lv_with(ctx, [body]), ps), body)),
        // `spawn` runs its block on another thread, at a time nothing
        // here orders. Everything it touches stays live.
        TSpawn(a) => TSpawn(lv_expr(lv_with(ctx, [a]), a)),
        // Already a reuse -- the pass is not run twice, but an arm is
        // cheaper than an assumption.
        TStructReuse(_, _, _) => node,
        TVariantReuse(_, _, _, _) => node,
        TArrayNsReuse(_, _, _) => node,
        TStructLit(sname, fs, sp) => {
            let fs2 = lv_fields(ctx, fs, 0, [], lv_opt_list(sp));
            match sp {
                // A spread base is itself released after its fields are
                // copied out. Reusing it as the cell would mean moving
                // and releasing the same reference; left alone until
                // that is expressed properly.
                Some(b) => TStructLit(sname, fs2, Some(lv_expr(ctx, b))),
                None => {
                    let cands = lv_candidates(ctx, ctx.scope.len() - 1, []);
                    if Array.is_empty(cands) { TStructLit(sname, fs2, None) } else { TStructReuse(sname, fs2, cands) }
                },
            }
        },
    }

// Field values are evaluated left to right, then the spread base.
let lv_fields (ctx: LvCtx) (fs: Array[typecheck.TFieldInit]) (i: Int) (acc: Array[typecheck.TFieldInit]) (after: Array[typecheck.TExpr]): Array[typecheck.TFieldInit] =
    if i >= fs.len() { acc }
    else {
        let rest = lv_cat(lv_field_rest(fs, i + 1, []), after, 0);
        lv_fields(ctx, fs, i + 1,
            acc.push(typecheck.TFieldInit { name: fs[i].name, value: lv_expr(lv_with(ctx, rest), fs[i].value) }), after)
    }

let lv_field_rest (fs: Array[typecheck.TFieldInit]) (from: Int) (acc: Array[typecheck.TExpr]): Array[typecheck.TExpr] =
    if from >= fs.len() { acc } else { lv_field_rest(fs, from + 1, acc.push(fs[from].value)) }

// Every in-scope name dead at this point, innermost FIRST -- the
// backend takes the first it can represent, and innermost-first is what
// stops a shadowed outer name being offered ahead of the inner one the
// backend would resolve.
//
// Whether a candidate CLASHES with the other move analysis is settled
// in `cg_reuse_cand`, not here -- this pass has no types and cannot
// tell which of these names the backend would even accept.
// The source array of a `map` or a `filter`, when it is a name that
// nothing reads after this call. `fold` is not included and cannot be:
// it builds no array at all, so there is nothing for a cell to become.
let lv_array_cand (ctx: LvCtx) (nm: String) (xs: Array[typecheck.TExpr]): String =
    if (nm == "map" || nm == "filter") && xs.len() == 2 {
        match xs[0].node {
            TIdent(v) => if lv_dead(ctx, v) { v } else { "" },
            _ => "",
        }
    } else { "" }

let lv_candidates (ctx: LvCtx) (i: Int) (acc: Array[String]): Array[String] =
    if i < 0 { acc }
    else if lv_dead(ctx, ctx.scope[i]) { lv_candidates(ctx, i - 1, acc.push(ctx.scope[i])) }
    else { lv_candidates(ctx, i - 1, acc) }

let lv_arm_exprs (arms: Array[typecheck.TArm]) (i: Int) (acc: Array[typecheck.TExpr]): Array[typecheck.TExpr] =
    if i >= arms.len() { acc }
    else { lv_arm_exprs(arms, i + 1, lv_cat(acc.push(arms[i].body), lv_opt_list(arms[i].guard), 0)) }

let lv_arms (ctx: LvCtx) (arms: Array[typecheck.TArm]) (i: Int) (acc: Array[typecheck.TArm]): Array[typecheck.TArm] =
    if i >= arms.len() { acc }
    else {
        let inner = lv_scoped(ctx, lv_pat_names(arms[i].pattern, []));
        lv_arms(ctx, arms, i + 1, acc.push(typecheck.TArm {
            pattern: arms[i].pattern,
            guard: lv_opt(lv_with(inner, [arms[i].body]), arms[i].guard),
            body: lv_expr(inner, arms[i].body),
        }))
    }

// Statement `i`'s continuation is every LATER statement's value, then
// the tail. A later ASSIGNMENT to a name is not a read, but treating it
// as one costs nothing and removes a case to be wrong about.
let lv_block (ctx: LvCtx) (b: typecheck.TBlock) (i: Int) (scope: Array[String]) (acc: Array[typecheck.TStmt]): typecheck.TBlock =
    if i >= b.stmts.len() {
        typecheck.TBlock { stmts: acc, tail: lv_opt(LvCtx { exprs: ctx.exprs, names: ctx.names, scope: scope }, b.tail) }
    } else {
        let sctx = LvCtx {
            exprs: lv_cat(lv_cat(ctx.exprs, lv_stmt_rest(b.stmts, i + 1, []), 0), lv_opt_list(b.tail), 0),
            names: lv_cat_names(ctx.names, lv_assigned(b.stmts, i + 1, []), 0),
            scope: scope,
        };
        match b.stmts[i] {
            // A `let` in a loop body stores into the SAME slot every
            // iteration, so the previous iteration's cell is sitting
            // there waiting to be released by this very store -- the
            // same position `TSAssign` is in, reached differently. It
            // is offered under `lv_self_slot`, not under the bound
            // name, because the bound name does not mean this slot
            // yet.
            TSLet(pat, v) => lv_block(ctx, b, i + 1, lv_cat_names(scope, lv_pat_names(pat, []), 0),
                acc.push(TSLet(pat, if cg_is_ident_pattern(pat) { lv_self_reuse(lv_self_slot(()), lv_expr(sctx, v)) } else { lv_expr(sctx, v) }))),
            TSAssign(nm, v) => lv_block(ctx, b, i + 1, scope, acc.push(TSAssign(nm, lv_self_reuse(nm, lv_expr(sctx, v))))),
            TSExpr(v) => lv_block(ctx, b, i + 1, scope, acc.push(TSExpr(lv_expr(sctx, v)))),
        }
    }

// A `let`'s own slot, under a name no source identifier can spell, so
// the initializer can be offered the slot it is about to fill without
// that slot becoming VISIBLE to it. `let x = x + 1` must still read the
// outer `x`, and it does: this name is not `x`.
let lv_self_slot (): String = "<slot>"

// The slot's current value is dead the instant the slot is overwritten
// -- the principle `cg_self_concat` and `cg_self_push` already exploit
// for `acc = acc.concat(x)` and `xs = xs.push(x)`. It holds just as
// well when the value is an aggregate LITERAL, which is what
// `p = P { .. }` in a loop is, so the slot's own cell is offered as
// the first candidate to build the new value into.
//
// This is the one candidate that needs no liveness analysis at all,
// which is why the ordinary one never finds it: `p` is read later in
// the loop body, so the back-edge rule calls it live, and it IS live
// -- the NAME is. The CELL currently in the slot is not, because the
// store about to happen is what would have released it.
//
// Only the TOP-LEVEL literal of the assigned expression. A nested one
// is not what the slot is about to hold, and handing it the slot's
// cell would give it the wrong bytes.
//
// Everything else is unchanged: `cg_reuse_cand` still decides whether
// the cell may be moved at all, `cg_reuse_of_ity` whether it is big
// enough, and `@plum_reuse_ok` whether anybody else can still see it.
// Returns `e` untouched when there is nothing to add. Rebuilding it
// unconditionally measures exactly the same (193,339 allocations to
// compile a fixture, either way), so the cheaper-looking one is kept --
// but only after measuring at a bootstrap FIXED POINT. Comparing a
// freshly-changed compiler against a converged one made the two look
// 167 apart, which was the measurement generation, not the code.
let lv_self_reuse (nm: String) (e: typecheck.TExpr): typecheck.TExpr =
    match e.node {
        TArrayLit(xs) => typecheck.TExpr { ty: e.ty, node: TArrayLitReuse(xs, [nm]) },
        TArrayLitReuse(xs, cands) => typecheck.TExpr { ty: e.ty, node: TArrayLitReuse(xs, lv_cat_names([nm], cands, 0)) },
        TStructLit(sname, fs, None) => typecheck.TExpr { ty: e.ty, node: TStructReuse(sname, fs, [nm]) },
        TStructReuse(sname, fs, cands) => typecheck.TExpr { ty: e.ty, node: TStructReuse(sname, fs, lv_cat_names([nm], cands, 0)) },
        TVariantNew(en, tag, xs) => typecheck.TExpr { ty: e.ty, node: TVariantReuse(en, tag, xs, [nm]) },
        TVariantReuse(en, tag, xs, cands) => typecheck.TExpr { ty: e.ty, node: TVariantReuse(en, tag, xs, lv_cat_names([nm], cands, 0)) },
        _ => e,
    }

let lv_stmt_rest (stmts: Array[typecheck.TStmt]) (from: Int) (acc: Array[typecheck.TExpr]): Array[typecheck.TExpr] =
    if from >= stmts.len() { acc }
    else {
        lv_stmt_rest(stmts, from + 1, acc.push(match stmts[from] {
            TSLet(_, v) => v,
            TSAssign(_, v) => v,
            TSExpr(v) => v,
        }))
    }

let lv_assigned (stmts: Array[typecheck.TStmt]) (from: Int) (acc: Array[String]): Array[String] =
    if from >= stmts.len() { acc }
    else {
        lv_assigned(stmts, from + 1, match stmts[from] {
            TSAssign(nm, _) => acc.push(nm),
            TSLet(_, _) => acc,
            TSExpr(_) => acc,
        })
    }

let lv_pat_names (pat: parser.PPattern) (acc: Array[String]): Array[String] =
    match pat {
        PIdent(v, _) => acc.push(v),
        PTuple(ps) => lv_pat_names_all(ps, 0, acc),
        PVariant(_, ps) => lv_pat_names_all(ps, 0, acc),
        POr(ps) => lv_pat_names_all(ps, 0, acc),
        PStruct(_, fps, _) => lv_field_pat_names(fps, 0, acc),
        PInt(_) => acc,
        PFloat(_) => acc,
        PStr(_) => acc,
        PBool(_) => acc,
        PWildcard => acc,
    }

let lv_pat_names_all (ps: Array[parser.PPattern]) (i: Int) (acc: Array[String]): Array[String] =
    if i >= ps.len() { acc } else { lv_pat_names_all(ps, i + 1, lv_pat_names(ps[i], acc)) }

let lv_field_pat_names (fps: Array[parser.FieldPatternNode]) (i: Int) (acc: Array[String]): Array[String] =
    if i >= fps.len() { acc } else { lv_field_pat_names(fps, i + 1, lv_pat_names(fps[i].pattern, acc)) }

// A function body, rewritten. Its parameters are the outermost scope
// and there is nothing after the body, so the continuation starts
// empty: whatever the body's last expression reads, nothing reads
// afterwards.
let lv_fn (params: Array[typecheck.TParam]) (body: typecheck.TExpr): typecheck.TExpr =
    lv_expr(LvCtx { exprs: [], names: [], scope: lv_param_names(params, 0, []) }, body)

let lv_param_names (params: Array[typecheck.TParam]) (i: Int) (acc: Array[String]): Array[String] =
    if i >= params.len() { acc } else { lv_param_names(params, i + 1, acc.push(params[i].name)) }

let cg_reads_max_list (name: String) (xs: Array[typecheck.TExpr]) (i: Int) (acc: Int): Int =
    if i >= xs.len() { cg_cap2(acc) } else { cg_reads_max_list(name, xs, i + 1, cg_cap2(acc + cg_reads_max(name, xs[i]))) }

let cg_reads_max_fields (name: String) (fs: Array[typecheck.TFieldInit]) (i: Int) (acc: Int): Int =
    if i >= fs.len() { cg_cap2(acc) } else { cg_reads_max_fields(name, fs, i + 1, cg_cap2(acc + cg_reads_max(name, fs[i].value))) }

// Arms are alternatives, so the maximum. An arm whose pattern REBINDS the
// name shadows it, and reads below refer to something else.
let cg_reads_max_arms (name: String) (arms: Array[typecheck.TArm]) (i: Int) (best: Int): Int =
    if i >= arms.len() { best } else {
        let here = if cg_pattern_binds(arms[i].pattern, name) { 0 } else {
            cg_cap2(cg_reads_max(name, arms[i].body) + match arms[i].guard {
                Some(g) => cg_reads_max(name, g),
                None => 0,
            })
        };
        cg_reads_max_arms(name, arms, i + 1, cg_max2(best, here))
    }

let cg_reads_max_block (name: String) (b: typecheck.TBlock): Int =
    cg_reads_max_stmts(name, b.stmts, 0, match b.tail {
        Some(t) => cg_reads_max(name, t),
        None => 0,
    })

// Statements run in sequence, so their reads ADD. A `let` whose pattern
// rebinds the name ends the outer name's scope, so nothing after it counts.
let cg_reads_max_stmts (name: String) (stmts: Array[typecheck.TStmt]) (i: Int) (acc: Int): Int =
    if i >= stmts.len() { cg_cap2(acc) } else {
        match stmts[i] {
            TSLet(pat, v) =>
                if cg_pattern_binds(pat, name) { cg_cap2(acc + cg_reads_max(name, v)) }
                else { cg_reads_max_stmts(name, stmts, i + 1, cg_cap2(acc + cg_reads_max(name, v))) },
            // Assigning THROUGH the name replaces what the slot holds,
            // which a move (which nulls the slot) cannot account for.
            TSAssign(n2, v) =>
                if n2 == name { 2 }
                else { cg_reads_max_stmts(name, stmts, i + 1, cg_cap2(acc + cg_reads_max(name, v))) },
            TSExpr(v) => cg_reads_max_stmts(name, stmts, i + 1, cg_cap2(acc + cg_reads_max(name, v))),
        }
    }

// Is this assignment `x = x.<method>(<one argument>)`? That shape — and
// only that shape — makes the slot's current value provably dead: it is
// overwritten with the result, so nothing can observe a mutation.
let cg_is_self_method (name: String) (value: typecheck.TExpr) (method: String): Bool =
    match value.node {
        TMethodCall(m, base, args) =>
            if m == method && args.len() == 1 { match base.node { TIdent(b) => b == name, _ => false } } else { false },
        _ => false,
    }

let cg_self_concat (p: CgProgram) (env: Array[CgSlot]) (n: Int) (name: String) (value: typecheck.TExpr) (stmts: Array[typecheck.TStmt]) (i: Int): BlockEmit =
    match value.node {
        TMethodCall(_, base, args) => match cg_lookup(env, name) {
            None => { cg_fail("assignment to an unbound name: ".concat(name)); cg_stmts(p, env, n, stmts, i + 1) },
            Some(slot) => {
                // The receiver is loaded WITHOUT incrementing and
                // handed to the reusing concat, which consumes it. No
                // `_pre` release either: the slot's reference moved
                // into the call rather than being dropped.
                let recv = cg_reg(n);
                let arg = cg_borrow(p, env, n + 1, args[0]);
                let out = cg_reg(arg.n);
                let code = "  ".concat(recv).concat(" = load ptr, ptr ").concat(slot.ptr).concat("\n")
                    .concat(arg.code)
                    .concat("  ").concat(out).concat(" = call ptr @plum_str_concat_reuse(ptr ").concat(recv).concat(", ptr ").concat(arg.val).concat(")\n")
                    .concat(arg.drop)
                    .concat("  store ptr ").concat(out).concat(", ptr ").concat(slot.ptr).concat("\n");
                let rest = cg_stmts(p, env, arg.n + 1, stmts, i + 1);
                BlockEmit { code: code.concat(rest.code), allocas: arg.allocas.concat(rest.allocas), releases: arg.releases.concat(rest.releases), globals: arg.globals.concat(rest.globals), env: rest.env, n: rest.n }
            },
        },
        _ => { cg_fail("internal: cg_self_concat on a non-concat"); cg_stmts(p, env, n, stmts, i + 1) },
    }

// `acc = acc.push(x)` — an accumulator loop, and the single largest
// remaining source of allocated bytes before this: every `push` copied
// the whole array, making an n-element accumulation cost O(n^2). Here
// the old array is dead, so it can grow in place whenever malloc
// already gave it the room.
let cg_self_push (p: CgProgram) (env: Array[CgSlot]) (n: Int) (name: String) (value: typecheck.TExpr) (stmts: Array[typecheck.TStmt]) (i: Int): BlockEmit =
    match value.node {
        TMethodCall(_, base, args) => match cg_lookup(env, name) {
            None => { cg_fail("assignment to an unbound name: ".concat(name)); cg_stmts(p, env, n, stmts, i + 1) },
            Some(slot) => {
                let elem = cg_elem_ty(slot.ty);
                let recv = cg_reg(n);
                let v = cg_expr(p, env, n + 1, args[0]);
                let cell = cg_reg(v.n);
                let len = cg_reg(v.n + 1);
                let idx = cg_reg(v.n + 2);
                let code = "  ".concat(recv).concat(" = load ptr, ptr ").concat(slot.ptr).concat("\n")
                    .concat(v.code)
                    .concat("  ").concat(cell).concat(" = call ptr @plum_array_push_grow(ptr ").concat(recv).concat(", i1 ").concat(if cg_is_heap(elem) { "1" } else { "0" }).concat(", ptr ").concat(cg_rel_sym(slot.ity)).concat(")\n")
                    .concat("  ").concat(len).concat(" = call i64 @plum_array_len(ptr ").concat(cell).concat(")\n")
                    .concat("  ").concat(idx).concat(" = sub i64 ").concat(len).concat(", 1\n")
                    .concat(cg_elem_ptr_lines(cell, idx, v.n + 3))
                    .concat("  store ").concat(cg_llvm_ty(v.ty)).concat(" ").concat(v.val).concat(", ptr ").concat(cg_elem_ptr_reg(v.n + 3)).concat("\n")
                    .concat("  store ptr ").concat(cell).concat(", ptr ").concat(slot.ptr).concat("\n");
                let rest = cg_stmts(p, env, v.n + 6, stmts, i + 1);
                BlockEmit { code: code.concat(rest.code), allocas: v.allocas.concat(rest.allocas), releases: v.releases.concat(rest.releases), globals: v.globals.concat(rest.globals), env: rest.env, n: rest.n }
            },
        },
        _ => { cg_fail("internal: cg_self_push on a non-push"); cg_stmts(p, env, n, stmts, i + 1) },
    }

// A plain `let x = ..` binds one name and needs no pattern machinery;
// anything else destructures.
let cg_is_ident_pattern (pattern: parser.PPattern): Bool =
    match pattern { PIdent(_, _) => true, _ => false }

let cg_let_name (pattern: parser.PPattern): String =
    match pattern {
        PIdent(name, _) => name,
        _ => { cg_fail("destructuring `let` isn't supported yet"); "_" },
    }

// --- Calls ---
//
// There is no dispatch left to do: `infer_call` already decided which
// of the five call shapes this is, and `cg_expr` routed accordingly.
// What used to be a resolution-order comment here (bound local beats
// builtin namespace beats top-level function beats method) now lives in
// the checker, stated once for both backends.

// `println` takes ANY type, matching the real compiler
// (`println(account.balance)` is ordinary Plum, and
// `examples/contracts` is written that way). A String is printed
// directly; anything else is rendered through exactly the same
// per-type machinery `.to_string()` uses, so the two can never
// disagree about how a value looks.
//
// The two paths differ in ownership, which is why they are not
// merged. A String argument is BORROWED -- printing reads it and the
// caller still owns it. A rendered one is a fresh cell this call
// created and nothing else will ever see, so it is released the
// moment `@plum_println` returns.
let cg_println (p: CgProgram) (env: Array[CgSlot]) (n: Int) (arg: typecheck.TExpr): Emit =
    if cg_ty_eq(cg_ty(p, arg), CgStr) {
        let a = cg_borrow(p, env, n, arg);
        let reg = cg_reg(a.n);
        Emit {
            code: a.code.concat("  ").concat(reg).concat(" = call i1 @plum_println(ptr ").concat(a.val).concat(")\n").concat(a.drop),
            allocas: a.allocas, releases: a.releases,globals: a.globals, val: reg, ty: CgUnit, n: a.n + 1,
        }
    } else {
        let s = cg_to_string(p, env, n, arg);
        let reg = cg_reg(s.n);
        Emit {
            code: s.code.concat("  ").concat(reg).concat(" = call i1 @plum_println(ptr ").concat(s.val).concat(")\n")
                .concat(if cg_rc_enabled(()) { "  call void @plum_rel_str(ptr ".concat(s.val).concat(")\n") } else { "" }),
            allocas: s.allocas, releases: s.releases, globals: s.globals, val: reg, ty: CgUnit, n: s.n + 1,
        }
    }

// A named call: the user's own function, or a prelude signature. Only
// the former has a body to call — a builtin needs a real
// implementation, and this backend has only the handful its runtime
// provides, so anything else fails by name.
// The callee's symbol is its SPECIALIZED name — `cg_sym` folds the
// concrete type arguments into it — so a call site needs no knowledge
// of monomorphization beyond resolving those arguments through the
// enclosing specialization.
let cg_fn_call (p: CgProgram) (env: Array[CgSlot]) (n: Int) (module_name: String) (name: String) (args: Array[typecheck.TExpr]) (targs: Array[typecheck.ITy]) (ret: CgTy): Emit = {
    let sym = match cg_array_concat_sym(p, name, targs) {
        Some(rt) => rt,
        None => match cg_runtime_fn(name) {
            Some(rt) => rt,
            None =>
            if false { "" }
            else if cg_has_fn_in(p, module_name, name, 0) { "@".concat(cg_sym(module_name, name, cg_concrete_list(p, targs, 0, []))) }
            else { { cg_fail("prelude function ".concat(name).concat(" has no implementation in this backend's runtime yet")); "@plum_missing" } },
        } };
    let a = cg_args(p, env, n, args, 0, "", "", "", "", []);
    let reg = cg_reg(a.n);
    let call = "  ".concat(reg).concat(" = call ").concat(cg_llvm_ty(ret)).concat(" ").concat(sym).concat("(").concat(cg_join_commas(a.vals)).concat(")\n")
        .concat(if Option.is_some(cg_runtime_fn(name)) || name == "Array.concat" { cg_dec_args(p, args, a.vals, 0, "") } else { "" });
    Emit { code: a.code.concat(call), allocas: a.allocas, releases: a.releases, globals: a.globals, val: reg, ty: ret, n: a.n + 1 }
}

// Prelude functions the RUNTIME implements directly, rather than as
// prelude Plum source. Deliberately a very short list: each entry is a
// place where Plum can't express the operation at all, not merely a
// place where C would be faster.
//
// `chars_of` is here because codepoint awareness has to bottom out
// somewhere — every other string routine is written in Plum on top of
// it. Anything that CAN be written in Plum is, in `cg_prelude_src`,
// because prelude source this backend compiles is prelude source it
// also proves it can handle.
// `Array.concat[T]` is intercepted and given a single-allocation
// implementation, with the variant chosen by T: a result holding heap
// elements needs its own reference to each, one holding `Int`s must not
// touch them. Choosing by the CALL SITE's instantiated type argument is
// something only a backend with the typed tree can do.
let cg_array_concat_sym (p: CgProgram) (name: String) (targs: Array[typecheck.ITy]): Option[String] =
    if name == "Array.concat" && targs.len() == 1 {
        if cg_is_heap(cg_of_ity(cg_concrete(p, targs[0]))) { Some("@plum_array_concat_heap") } else { Some("@plum_array_concat") }
    } else { None }

let cg_runtime_fn (name: String): Option[String] =
    if name == "chars_of" { Some("@plum_chars_of") }
    else if name == "panic_raw" { Some("@plum_panic") }
    else if name == "args" { Some("@plum_args") }
    else if name == "print_raw" { Some("@plum_print_raw") }
    else if name == "exit_raw" { Some("@plum_exit_raw") }
    else if name == "env_var_raw" { Some("@plum_env_var_raw") }
    else if name == "read_file_raw" { Some("@plum_read_file_raw") }
    else if name == "write_file_raw" { Some("@plum_write_file_raw") }
    else if name == "string_hash_raw" { Some("@plum_str_hash_raw") }
    else if name == "sqrt_raw" { Some("@plum_sqrt_raw") }
    else if name == "pow_raw" { Some("@plum_pow_raw") }
    else if name == "floor_raw" { Some("@plum_floor_raw") }
    else if name == "ceil_raw" { Some("@plum_ceil_raw") }
    else if name == "round_raw" { Some("@plum_round_raw") }
    else if name == "random_raw" { Some("@plum_random_raw") }
    else if name == "string_cmp_raw" { Some("@plum_str_cmp_raw") }
    else if name == "string_concat_all_raw" { Some("@plum_str_concat_all") }
    else if name == "process_run_raw" { Some("@plum_process_run_raw") }
    else if name == "process_exit_code_raw" { Some("@plum_process_exit_code_raw") }
    else if name == "process_stdout_raw" { Some("@plum_process_stdout_raw") }
    else if name == "process_stderr_raw" { Some("@plum_process_stderr_raw") }
    else if name == "process_free_raw" { Some("@plum_process_free_raw") }
    else if name == "path_is_dir_raw" { Some("@plum_path_is_dir") }
    else if name == "dir_open_handle" { Some("@plum_dir_open") }
    else if name == "dir_next_entry" { Some("@plum_dir_next") }
    else if name == "dir_close_handle" { Some("@plum_dir_close") }
    else if name == "os_temp_dir_raw" { Some("@plum_os_temp_dir") }
    else if name == "os_self_exe_raw" { Some("@plum_os_self_exe") }
    else if name == "os_make_dir_raw" { Some("@plum_os_make_dir") }
    else if name == "os_time_raw" { Some("@plum_os_time") }
    else if name == "os_remove_file_raw" { Some("@plum_os_remove_file") }
    else if name == "os_remove_tree_raw" { Some("@plum_os_remove_tree") }
    else if name == "os_copy_tree_raw" { Some("@plum_os_copy_tree") }
    else if name == "os_platform_raw" { Some("@plum_os_platform") }
    else if name == "parse_float_raw" { Some("@plum_parse_float_raw") }
    else { None }

let cg_concrete_list (p: CgProgram) (ts: Array[typecheck.ITy]) (i: Int) (acc: Array[typecheck.ITy]): Array[typecheck.ITy] =
    if i >= ts.len() { acc } else { cg_concrete_list(p, ts, i + 1, acc.push(cg_concrete(p, ts[i]))) }

let cg_has_fn (p: CgProgram) (name: String): Bool = Option.is_some(cg_find_fn_any(p, name, 0))

// The checker has already resolved which function a call means, so a
// name reaching the backend is unambiguous in context; scanning for it
// by name alone is enough to recover its MODULE, which is what the
// symbol needs.
let cg_find_fn_any (p: CgProgram) (name: String) (i: Int): Option[typecheck.TFn] =
    if i >= p.fns.len() { None } else if p.fns[i].name == name { Some(p.fns[i]) } else { cg_find_fn_any(p, name, i + 1) }

struct ArgVals { code: String, allocas: String, releases: String, globals: String, vals: Array[String], n: Int }

// Arguments are emitted left to right, accumulating both their code and
// the `<ty> <val>` operand list the call needs. No parameter types are
// pushed down any more — a closure argument already carries its own
// resolved type from the checker.
let cg_args (p: CgProgram) (env: Array[CgSlot]) (n: Int) (args: Array[typecheck.TExpr]) (i: Int) (code: String) (allocas: String) (releases: String) (globals: String) (vals: Array[String]): ArgVals =
    if i >= args.len() { ArgVals { code: code, allocas: allocas, releases: releases, globals: globals, vals: vals, n: n } }
    else {
        let r = cg_expr(p, env, n, args[i]);
        cg_args(p, env, r.n, args, i + 1, code.concat(r.code), allocas.concat(r.allocas), releases.concat(r.releases), globals.concat(r.globals), vals.push(cg_llvm_ty(r.ty).concat(" ").concat(r.val)))
    }

let cg_join_commas (parts: Array[String]): String = cg_join_acc(parts, 1, if Array.is_empty(parts) { "" } else { parts[0] })
let cg_join_acc (parts: Array[String]) (i: Int) (acc: String): String =
    if i >= parts.len() { acc } else { cg_join_acc(parts, i + 1, acc.concat(", ").concat(parts[i])) }

let cg_method_call (p: CgProgram) (env: Array[CgSlot]) (n: Int) (method_name: String) (base: typecheck.TExpr) (args: Array[typecheck.TExpr]) (ty: CgTy): Emit =
    if method_name == "to_string" { cg_to_string(p, env, n, base) }
    else if method_name == "concat" { cg_concat(p, env, n, base, args[0]) }
    else if method_name == "len" { cg_len(p, env, n, base) }
    else if method_name == "push" { cg_array_push(p, env, n, base, args[0], ty) }
    else if method_name == "remove" { cg_array_remove(p, env, n, base, args[0], ty) }
    else if method_name == "set" && args.len() == 2 { cg_array_set(p, env, n, base, args[0], args[1], ty) }
    // Arity is what separates `Ref.set(v)` from `Array.set(i, v)` —
    // the same split inference makes.
    else if method_name == "set" { cg_ref_set(p, env, n, base, args[0]) }
    else if method_name == "get" { cg_ref_get(p, env, n, base) }
    else if method_name == "to_float" { cg_to_float(p, env, n, base) }
    else if method_name == "ends_with" { cg_str_binop(p, env, n, base, args[0], "@plum_str_ends_with", CgBool) }
    else if method_name == "starts_with" { cg_str_binop(p, env, n, base, args[0], "@plum_str_starts_with", CgBool) }
    else if method_name == "contains" { cg_str_binop(p, env, n, base, args[0], "@plum_str_contains", CgBool) }
    else if method_name == "split" { cg_str_binop(p, env, n, base, args[0], "@plum_str_split", CgArray(CgStr)) }
    // Ported verbatim from the real backend -- see `runtime.plum`'s
    // "Unicode string operations".
    else if method_name == "replace" { cg_str_ternop(p, env, n, base, args[0], args[1], "@plum_str_replace") }
    else if method_name == "to_upper" { cg_str_unop(p, env, n, base, "@plum_str_to_upper") }
    else if method_name == "to_lower" { cg_str_unop(p, env, n, base, "@plum_str_to_lower") }
    else if method_name == "trim" { cg_str_unop(p, env, n, base, "@plum_str_trim") }
    else { { cg_fail("method .".concat(method_name).concat("() isn't supported by this backend yet")); cg_unit_emit(n) } }

// The aggregate arm of `.to_string()`. The base arrived OWNED, so it
// is released once the rendering has read it.
let cg_str_call (p: CgProgram) (b: Emit) (ity: typecheck.ITy): Emit = {
    let out = cg_reg(b.n);
    Emit {
        code: b.code.concat("  ").concat(out).concat(" = call ptr ").concat(cg_str_sym(ity)).concat("(ptr ").concat(b.val).concat(")\n")
            .concat(cg_dec(ity, b.val)),
        allocas: b.allocas, releases: b.releases, globals: b.globals, val: out, ty: CgStr, n: b.n + 1,
    }
}

let cg_to_string (p: CgProgram) (env: Array[CgSlot]) (n: Int) (base: typecheck.TExpr): Emit = {
    let b = cg_expr(p, env, n, base);
    let reg = cg_reg(b.n);
    match b.ty {
        // Already a String — `.to_string()` on one is the identity, and
        // emitting a copy would be pure waste.
        CgStr => b,
        CgInt => Emit { code: b.code.concat("  ").concat(reg).concat(" = call ptr @plum_int_to_string(i64 ").concat(b.val).concat(")\n"), allocas: b.allocas, releases: b.releases, globals: b.globals, val: reg, ty: CgStr, n: b.n + 1 },
        CgFloat => Emit { code: b.code.concat("  ").concat(reg).concat(" = call ptr @plum_float_to_string(double ").concat(b.val).concat(")\n"), allocas: b.allocas, releases: b.releases, globals: b.globals, val: reg, ty: CgStr, n: b.n + 1 },
        CgBool => Emit { code: b.code.concat("  ").concat(reg).concat(" = call ptr @plum_bool_to_string(i1 ").concat(b.val).concat(")\n"), allocas: b.allocas, releases: b.releases, globals: b.globals, val: reg, ty: CgStr, n: b.n + 1 },
        CgUnit => { cg_fail("Unit has no .to_string()"); cg_unit_emit(b.n) },
        // A raw `char*` has no length header and no ownership, so
        // rendering it means deciding who owns the copy. `.as_string()`
        // is that decision, written explicitly.
        CgCStr => { cg_fail(".to_string() on a CStr isn't supported -- use .as_string()"); cg_unit_emit(b.n) },
        // Dispatched to the per-type renderer emitted by
        // `cg_emit_str_fn`, chosen by the base's own ITy -- the CgTy
        // alone cannot name the function, since `CgStruct("Box")` has
        // already discarded the type arguments.
        CgStruct(_) => cg_str_call(p, b, cg_concrete(p, typecheck.texpr_ty(p.subst, base))),
        CgEnum(_) => cg_str_call(p, b, cg_concrete(p, typecheck.texpr_ty(p.subst, base))),
        CgArray(_) => cg_str_call(p, b, cg_concrete(p, typecheck.texpr_ty(p.subst, base))),
        // Deliberately unsupported, same as `Array`: a `Ref` has no
        // meaningful text form of its own, and printing the cell
        // ADDRESS would be worse than useless. `.get().to_string()`
        // is the thing the caller wants.
        CgRef(_) => { cg_fail(".to_string() on a Ref isn't supported — use .get().to_string()"); cg_unit_emit(b.n) },
        CgClosure(_, _) => { cg_fail("a closure has no .to_string()"); cg_unit_emit(b.n) },
        CgTuple(_) => { cg_fail(".to_string() on a tuple isn't supported yet"); cg_unit_emit(b.n) },
        // A handle's only readable content is an address, which is the
        // same reason a `Ref` refuses. Printing one used to "work"
        // because these were plain `Int`s -- printing the raw shim
        // pointer, which was never useful and is now not even stable.
        CgHandle(name) => { cg_fail(".to_string() on a ".concat(name).concat(" isn't supported")); cg_unit_emit(b.n) },
    }
}

// `sitofp` — a SIGNED integer widened to a double, which is exact for
// every value a 53-bit mantissa can hold and rounds beyond that,
// matching the real backend's own `ToFloat` lowering.
let cg_to_float (p: CgProgram) (env: Array[CgSlot]) (n: Int) (base: typecheck.TExpr): Emit = {
    let b = cg_expr(p, env, n, base);
    let reg = cg_reg(b.n);
    Emit {
        code: b.code.concat("  ").concat(reg).concat(" = sitofp i64 ").concat(b.val).concat(" to double\n"),
        allocas: b.allocas, releases: b.releases,globals: b.globals, val: reg, ty: CgFloat, n: b.n + 1,
    }
}

// The string PRIMITIVES that take a receiver and one argument and are
// implemented in the runtime rather than the prelude. They stay
// primitives (as they are in the real compiler, lowered to IR nodes)
// because they are byte-level operations, and writing them over
// `chars_of` in Plum would make them codepoint-level -- a different,
// slower, and for `starts_with`/`ends_with` observably different
// function.
// The one- and three-operand shapes of `cg_str_binop`, for the string
// methods ported from the real backend. All three borrow their
// operands and return a FRESH string cell, so the operands are dropped
// after the call exactly as `cg_str_binop` drops its two.
let cg_str_unop (p: CgProgram) (env: Array[CgSlot]) (n: Int) (base: typecheck.TExpr) (fn_name: String): Emit = {
    let a = cg_borrow(p, env, n, base);
    let reg = cg_reg(a.n);
    Emit {
        code: a.code.concat("  ").concat(reg).concat(" = call ptr ").concat(fn_name).concat("(ptr ").concat(a.val).concat(")\n").concat(a.drop),
        allocas: a.allocas, releases: a.releases, globals: a.globals, val: reg, ty: CgStr, n: a.n + 1,
    }
}

let cg_str_ternop (p: CgProgram) (env: Array[CgSlot]) (n: Int) (base: typecheck.TExpr) (a1: typecheck.TExpr) (a2: typecheck.TExpr) (fn_name: String): Emit = {
    let a = cg_borrow(p, env, n, base);
    let b = cg_borrow(p, env, a.n, a1);
    let c = cg_borrow(p, env, b.n, a2);
    let reg = cg_reg(c.n);
    Emit {
        code: a.code.concat(b.code).concat(c.code).concat("  ").concat(reg).concat(" = call ptr ").concat(fn_name)
            .concat("(ptr ").concat(a.val).concat(", ptr ").concat(b.val).concat(", ptr ").concat(c.val).concat(")\n")
            .concat(a.drop).concat(b.drop).concat(c.drop),
        allocas: a.allocas.concat(b.allocas).concat(c.allocas),
        releases: a.releases.concat(b.releases).concat(c.releases),
        globals: a.globals.concat(b.globals).concat(c.globals),
        val: reg, ty: CgStr, n: c.n + 1,
    }
}

let cg_str_binop (p: CgProgram) (env: Array[CgSlot]) (n: Int) (base: typecheck.TExpr) (arg: typecheck.TExpr) (fn_name: String) (ret: CgTy): Emit = {
    let a = cg_borrow(p, env, n, base);
    let b = cg_borrow(p, env, a.n, arg);
    let reg = cg_reg(b.n);
    Emit {
        code: a.code.concat(b.code).concat("  ").concat(reg).concat(" = call ").concat(cg_llvm_ty(ret)).concat(" ").concat(fn_name).concat("(ptr ").concat(a.val).concat(", ptr ").concat(b.val).concat(")\n")
            .concat(a.drop).concat(b.drop),
        allocas: a.allocas.concat(b.allocas), releases: a.releases.concat(b.releases),globals: a.globals.concat(b.globals), val: reg, ty: ret, n: b.n + 1,
    }
}

// `@plum_str_concat_reuse` CONSUMES its receiver — the copy branch
// releases it, the in-place branch returns it — so it is only correct
// where the receiver's reference is handed over rather than lent. Its
// runtime guard (`rc == 1` and the allocation already large enough) means
// using it is never WRONG, just useless when the count is higher.
//
// A movable slot read hands the reference over, which is what makes the
// guard pass: `go(acc.concat("x"), n - 1)` grows the accumulator in place
// instead of copying it, 200.4 MB -> 0.36 MB over 20,000 items. Anything
// else is evaluated to an owned reference and handed over just the same,
// where the guard declines and it copies — same result as before, one
// call instead of two.
let cg_concat (p: CgProgram) (env: Array[CgSlot]) (n: Int) (base: typecheck.TExpr) (arg: typecheck.TExpr): Emit = {
    let a = cg_move_or_own(p, env, n, base);
    let b = cg_borrow(p, env, a.n, arg);
    let reg = cg_reg(b.n);
    Emit {
        code: a.code.concat(b.code).concat("  ").concat(reg).concat(" = call ptr @plum_str_concat_reuse(ptr ").concat(a.val).concat(", ptr ").concat(b.val).concat(")\n")
            .concat(b.drop),
        allocas: a.allocas.concat(b.allocas), releases: a.releases.concat(b.releases),globals: a.globals.concat(b.globals), val: reg, ty: CgStr, n: b.n + 1,
    }
}

// An OWNED reference to `e`, obtained by MOVING it out of its slot when
// that is the slot's only read, and by ordinary evaluation otherwise.
//
// The move stores null back into the slot. That is what removes the need
// for any path analysis: the slot's release at function exit still runs,
// and every `plum_rel_*` is null-safe by construction (`cg_null_init`
// depends on the same property), so it becomes a no-op on exactly the
// paths where the reference left.
//
// No whole-program reasoning is needed either — rule 4 says a call
// CONSUMES its arguments, so a parameter slot owns its value outright and
// no caller is still holding it.
let cg_move_or_own (p: CgProgram) (env: Array[CgSlot]) (n: Int) (e: typecheck.TExpr): BorrowEmit =
    match e.node {
        TIdent(name) =>
            if cg_is_movable(p, name) {
                match cg_lookup(env, name) {
                    Some(slot) => {
                        let reg = cg_reg(n);
                        BorrowEmit {
                            code: "  ".concat(reg).concat(" = load ").concat(cg_llvm_ty(slot.ty)).concat(", ptr ").concat(slot.ptr).concat("\n")
                                .concat(cg_null_out(slot)),
                            allocas: "", releases: "", globals: "", val: reg, ty: slot.ty, drop: "", n: n + 1,
                        }
                    },
                    None => cg_borrow_owned(p, env, n, e),
                }
            } else { cg_borrow_owned(p, env, n, e) },
        _ => cg_borrow_owned(p, env, n, e),
    }

// Null the slot a reference was moved out of, so its exit release is a
// no-op rather than a second decrement.
let cg_null_out (slot: CgSlot): String =
    if cg_rc_enabled(()) && cg_is_heap(slot.ty) { "  store ptr null, ptr ".concat(slot.ptr).concat("\n") } else { "" }

// --- Strings and arrays ---

// `.len()` is overloaded on the receiver's representation — byte length
// for a `String`, element count for an `Array` — exactly as the real
// backend overloads it on the receiver's static type. The checker
// already resolved which; this just reads it off the receiver.
let cg_len (p: CgProgram) (env: Array[CgSlot]) (n: Int) (base: typecheck.TExpr): Emit = {
    let b = cg_borrow(p, env, n, base);
    let reg = cg_reg(b.n);
    let fn_name = match b.ty {
        CgStr => "@plum_str_len",
        CgArray(_) => "@plum_array_len",
        _ => { cg_fail(".len() requires a String or an Array, found ".concat(cg_ty_name(b.ty))); "@plum_str_len" },
    };
    Emit {
        code: b.code.concat("  ").concat(reg).concat(" = call i64 ").concat(fn_name).concat("(ptr ").concat(b.val).concat(")\n").concat(b.drop),
        allocas: b.allocas, releases: b.releases, globals: b.globals, val: reg, ty: CgInt, n: b.n + 1 }
}

// Cell layout is in `runtime.plum`: an `i64` length then one 8-byte
// slot per element. `push`/`set` build a NEW cell and copy, never
// mutate — Plum arrays are values, and this backend has no ownership
// analysis that could prove an in-place update safe. That is where the
// real backend was before FBIP; the difference is it now has
// `ArrayPushReuse` and this one does not, so a `push` in a loop here is
// quadratic. Real, and the most likely first performance cliff.

// The element type comes from the checker, so an EMPTY literal is no
// longer a special case: `let empty = []` has a real element type
// (whatever unification determined), and nothing has to record
// "undetermined". The first element is also no longer emitted twice
// just to discover a type — both of those were consequences of
// synthesizing types here instead of reading them.
let cg_array_lit (p: CgProgram) (env: Array[CgSlot]) (n: Int) (elems: Array[typecheck.TExpr]) (ty: CgTy): Emit = {
    let cell = cg_reg(n);
    let head = "  ".concat(cell).concat(" = call ptr @plum_array_new(i64 ").concat(elems.len().to_string()).concat(")\n");
    let st = cg_array_store_elems(p, env, n + 1, cell, elems, 0, "", "", "", "");
    Emit { code: head.concat(st.code), allocas: st.allocas, releases: st.releases,globals: st.globals, val: cell, ty: ty, n: st.n }
}

// `[a, b]` built into the cell the slot it is about to fill already
// holds.
//
// The elements are evaluated FIRST, before the cell is decided, for
// exactly the reason a struct's fields are: `xs = [xs[0] + 1]` reads
// the very cell about to be recycled, and a value already in a
// register cannot be disturbed by what happens to the cell after.
//
// Arrays cannot go through `cg_reuse_cell` like a struct or an enum.
// A struct's size is a property of its TYPE; an array's is a property
// of the individual cell, written in the cell's own header. So
// recycling one means `@plum_array_reuse`, which sizes it, writes the
// header, and declines when anybody else can still see it.
let cg_array_lit_reuse (p: CgProgram) (env: Array[CgSlot]) (n: Int) (elems: Array[typecheck.TExpr]) (cands: Array[String]) (ty: CgTy): Emit =
    match cg_array_lit_cand(p, env, cands, 0) {
        None => cg_array_lit(p, env, n, elems, ty),
        Some(slot) => {
            let a = cg_args(p, env, n, elems, 0, "", "", "", "", []);
            let old = cg_reg(a.n);
            let cell = cg_reg(a.n + 1);
            let same = cg_reg(a.n + 2);
            let ldrop = cg_label(a.n + 3);
            let ljoin = cg_label(a.n + 4);
            Emit {
                code: a.code
                    .concat("  ").concat(old).concat(" = load ptr, ptr ").concat(slot.ptr).concat("\n")
                    .concat("  store ptr null, ptr ").concat(slot.ptr).concat("\n")
                    // The old elements are released and the length
                    // zeroed BEFORE the cell is offered up, so that
                    // whichever way the offer goes -- recycled here, or
                    // released below -- nothing releases them twice.
                    .concat(cg_array_clear_call(p, slot, old))
                    .concat("  ").concat(cell).concat(" = call ptr @plum_array_reuse(ptr ").concat(old).concat(", i64 ").concat(elems.len().to_string()).concat(")\n")
                    .concat("  ").concat(same).concat(" = icmp eq ptr ").concat(cell).concat(", ").concat(old).concat("\n")
                    .concat("  br i1 ").concat(same).concat(", label %").concat(ljoin).concat(", label %").concat(ldrop).concat("\n")
                    .concat(ldrop).concat(":\n")
                    // Null-safe and static-safe, both of which happen:
                    // the slot is null on the first pass, and may hold
                    // a hoisted constant cell.
                    .concat(cg_dec(cg_concrete(p, slot.ity), old))
                    .concat("  br label %").concat(ljoin).concat("\n")
                    .concat(ljoin).concat(":\n")
                    .concat(cg_store_elem_vals(cell, a.vals, 0, "")),
                allocas: a.allocas, releases: a.releases, globals: a.globals,
                val: cell, ty: ty, n: a.n + 5,
            }
        },
    }

// Nothing to release when the elements are scalars, which is the
// common case and emits no call at all.
let cg_array_clear_call (p: CgProgram) (slot: CgSlot) (old: String): String =
    if cg_is_heap(cg_elem_ty(slot.ty)) {
        "  call void @plum_array_clear(ptr ".concat(old).concat(", ptr ").concat(cg_rel_sym(cg_array_elem_ity(p, slot.ity))).concat(")\n")
    } else { "" }

let cg_store_elem_vals (cell: String) (vals: Array[String]) (i: Int) (acc: String): String =
    if i >= vals.len() { acc }
    else {
        let ep = cell.concat("_e").concat(i.to_string());
        cg_store_elem_vals(cell, vals, i + 1, acc
            .concat("  ").concat(ep).concat(" = getelementptr i8, ptr ").concat(cell).concat(", i64 ").concat(cg_array_elem_offset(i).to_string()).concat("\n")
            .concat("  store ").concat(vals[i]).concat(", ptr ").concat(ep).concat("\n"))
    }

// An array slot the move analysis has not already claimed. Unlike
// `cg_reuse_cand` there is no size test: `@plum_array_reuse` does that
// itself, against the cell's real capacity rather than its type.
let cg_array_lit_cand (p: CgProgram) (env: Array[CgSlot]) (cands: Array[String]) (i: Int): Option[CgSlot] =
    if i >= cands.len() { None }
    else if cg_rc_enabled(()) && !cg_is_movable(p, cands[i]) {
        match cg_lookup(env, cands[i]) {
            Some(slot) => match slot.ty { CgArray(_) => Some(slot), _ => cg_array_lit_cand(p, env, cands, i + 1) },
            None => cg_array_lit_cand(p, env, cands, i + 1),
        }
    } else { cg_array_lit_cand(p, env, cands, i + 1) }

// Every arm's RECEIVER is evaluated, so those SUM. Exactly one body
// then runs, so those are alternatives and only the largest counts --
// the same split `TIf` makes between its condition and its branches.
let cg_reads_max_select (name: String) (arms: Array[typecheck.TSelectArm]) (i: Int) (acc: Int): Int =
    cg_cap2(cg_reads_select_chans(name, arms, 0, acc) + cg_reads_select_bodies(name, arms, 0, 0))

let cg_reads_select_chans (name: String) (arms: Array[typecheck.TSelectArm]) (i: Int) (acc: Int): Int =
    if i >= arms.len() { acc }
    else { cg_reads_select_chans(name, arms, i + 1, cg_cap2(acc + cg_reads_max(name, arms[i].chan))) }

let cg_reads_select_bodies (name: String) (arms: Array[typecheck.TSelectArm]) (i: Int) (best: Int): Int =
    if i >= arms.len() { best }
    else {
        let here = if cg_pattern_binds(arms[i].pattern, name) { 0 } else { cg_reads_max(name, arms[i].body) };
        cg_reads_select_bodies(name, arms, i + 1, cg_max2(best, here))
    }

let lv_select_arms (ctx: LvCtx) (arms: Array[typecheck.TSelectArm]) (i: Int) (acc: Array[typecheck.TSelectArm]): Array[typecheck.TSelectArm] =
    if i >= arms.len() { acc }
    else {
        let inner = lv_scoped(lv_with(ctx, lv_select_rest(arms, i + 1, [])), lv_pat_names(arms[i].pattern, []));
        lv_select_arms(ctx, arms, i + 1, acc.push(typecheck.TSelectArm {
            chan: lv_expr(lv_with(ctx, lv_select_rest(arms, i + 1, [])), arms[i].chan),
            pattern: arms[i].pattern,
            body: lv_expr(inner, arms[i].body),
        }))
    }

let lv_select_rest (arms: Array[typecheck.TSelectArm]) (from: Int) (acc: Array[typecheck.TExpr]): Array[typecheck.TExpr] =
    if from >= arms.len() { acc } else { lv_select_rest(arms, from + 1, acc.push(arms[from].chan)) }

let cg_rel_in_select (p: CgProgram) (arms: Array[typecheck.TSelectArm]) (i: Int) (here: Array[typecheck.ITy]): Array[typecheck.ITy] =
    if i >= arms.len() { here }
    else { cg_rel_in_select(p, arms, i + 1, cg_rel_in(p, arms[i].body, cg_rel_in(p, arms[i].chan, here))) }

let cg_eq_in_select (p: CgProgram) (arms: Array[typecheck.TSelectArm]) (i: Int) (acc: Array[typecheck.ITy]): Array[typecheck.ITy] =
    if i >= arms.len() { acc }
    else { cg_eq_in_select(p, arms, i + 1, cg_eq_in(p, arms[i].body, cg_eq_in(p, arms[i].chan, acc))) }

let cg_calls_in_select (p: CgProgram) (arms: Array[typecheck.TSelectArm]) (i: Int) (acc: Array[CgInst]): Array[CgInst] =
    if i >= arms.len() { acc }
    else { cg_calls_in_select(p, arms, i + 1, cg_calls_in(p, arms[i].body, cg_calls_in(p, arms[i].chan, acc))) }

let cg_array_store_elems (p: CgProgram) (env: Array[CgSlot]) (n: Int) (cell: String) (elems: Array[typecheck.TExpr]) (i: Int) (code: String) (allocas: String) (releases: String) (globals: String): FieldsEmit =
    if i >= elems.len() { FieldsEmit { code: code, allocas: allocas, releases: releases, globals: globals, n: n } }
    else {
        let r = cg_expr(p, env, n, elems[i]);
        let ep = cg_reg(r.n);
        let line = "  ".concat(ep).concat(" = getelementptr i8, ptr ").concat(cell).concat(", i64 ").concat(cg_array_elem_offset(i).to_string()).concat("\n")
            .concat("  store ").concat(cg_llvm_ty(r.ty)).concat(" ").concat(r.val).concat(", ptr ").concat(ep).concat("\n");
        cg_array_store_elems(p, env, r.n + 1, cell, elems, i + 1, code.concat(r.code).concat(line), allocas.concat(r.allocas), releases.concat(r.releases), globals.concat(r.globals))
    }

// BOUNDS-CHECKED, like the real backend. An unchecked index was a
// deliberate v1 cut and a genuinely unsafe one — an out-of-range read
// returned whatever followed the cell, which with reference counting
// then got INCREMENTED, writing through a pointer made of arbitrary
// bytes. The check costs a compare and a never-taken branch.
//
// The failure message is the real backend's, verbatim, so a program
// that indexes past the end behaves identically under both.
let cg_index (p: CgProgram) (env: Array[CgSlot]) (n: Int) (base: typecheck.TExpr) (idx: typecheck.TExpr) (elem: CgTy): Emit = {
    let b = cg_borrow(p, env, n, base);
    let i = cg_expr(p, env, b.n, idx);
    let len = cg_reg(i.n);
    let lo = cg_reg(i.n + 1);
    let hi = cg_reg(i.n + 2);
    let ok = cg_reg(i.n + 3);
    let ok_label = cg_label(i.n + 4);
    let fail_label = cg_label(i.n + 5);
    let out = cg_reg(i.n + 9);
    let code = b.code.concat(i.code)
        .concat("  ").concat(len).concat(" = call i64 @plum_array_len(ptr ").concat(b.val).concat(")\n")
        .concat("  ").concat(lo).concat(" = icmp sge i64 ").concat(i.val).concat(", 0\n")
        .concat("  ").concat(hi).concat(" = icmp slt i64 ").concat(i.val).concat(", ").concat(len).concat("\n")
        .concat("  ").concat(ok).concat(" = and i1 ").concat(lo).concat(", ").concat(hi).concat("\n")
        .concat("  br i1 ").concat(ok).concat(", label %").concat(ok_label).concat(", label %").concat(fail_label).concat("\n")
        .concat(fail_label).concat(":\n")
        .concat("  call void @plum_bounds_fail()\n")
        .concat("  br label %").concat(ok_label).concat("\n")
        .concat(ok_label).concat(":\n")
        .concat(cg_elem_ptr_lines(b.val, i.val, i.n + 6))
        .concat("  ").concat(out).concat(" = load ").concat(cg_llvm_ty(elem)).concat(", ptr ").concat(cg_elem_ptr_reg(i.n + 6)).concat("\n")
        .concat(cg_inc(elem, out))
        .concat(b.drop);
    Emit { code: code, allocas: b.allocas.concat(i.allocas), releases: b.releases.concat(i.releases), globals: b.globals.concat(i.globals), val: out, ty: elem, n: i.n + 10 }
}

// The array counterpart of `cg_concat`, and the same story:
// `@plum_array_push_grow` CONSUMES its receiver (its copy branch releases
// it, its in-place branch returns it) and is runtime-guarded on `rc == 1`
// plus `malloc_usable_size`, so handing the reference over is never wrong
// — merely useless when the count is higher.
//
// This path used to allocate a fresh array and copy on EVERY push, making
// an n-element accumulation O(n^2) unless it happened to match
// `cg_is_self_method`'s literal `acc = acc.push(x)`. The parser
// accumulates `Array[Token]` through a tail-recursive call, which never
// did. The copy branch doubles, so a moved receiver amortizes to O(1).
let cg_array_push (p: CgProgram) (env: Array[CgSlot]) (n: Int) (base: typecheck.TExpr) (value: typecheck.TExpr) (ty: CgTy): Emit = {
    let bty = cg_concrete(p, typecheck.texpr_ty(p.subst, base));
    let elem = cg_elem_ty(ty);
    let b = cg_move_or_own(p, env, n, base);
    let v = cg_expr(p, env, b.n, value);
    let cell = cg_reg(v.n);
    let len = cg_reg(v.n + 1);
    let idx = cg_reg(v.n + 2);
    let code = b.code.concat(v.code)
        .concat("  ").concat(cell).concat(" = call ptr @plum_array_push_grow(ptr ").concat(b.val).concat(", i1 ").concat(if cg_is_heap(elem) { "1" } else { "0" }).concat(", ptr ").concat(cg_rel_sym(bty)).concat(")\n")
        .concat("  ").concat(len).concat(" = call i64 @plum_array_len(ptr ").concat(cell).concat(")\n")
        .concat("  ").concat(idx).concat(" = sub i64 ").concat(len).concat(", 1\n")
        .concat(cg_elem_ptr_lines(cell, idx, v.n + 3))
        // The pushed value's own +1 moves into the array (rule 5).
        .concat("  store ").concat(cg_llvm_ty(v.ty)).concat(" ").concat(v.val).concat(", ptr ").concat(cg_elem_ptr_reg(v.n + 3)).concat("\n");
    Emit { code: code, allocas: b.allocas.concat(v.allocas), releases: b.releases.concat(v.releases),globals: b.globals.concat(v.globals), val: cell, ty: ty, n: v.n + 6 }
}

let cg_array_set (p: CgProgram) (env: Array[CgSlot]) (n: Int) (base: typecheck.TExpr) (idx: typecheck.TExpr) (value: typecheck.TExpr) (ty: CgTy): Emit = {
    let b = cg_expr(p, env, n, base);
    let i = cg_expr(p, env, b.n, idx);
    let v = cg_expr(p, env, i.n, value);
    let len = cg_reg(v.n);
    let cell = cg_reg(v.n + 1);
    let copied = cg_reg(v.n + 2);
    let code = b.code.concat(i.code).concat(v.code)
        .concat("  ").concat(len).concat(" = call i64 @plum_array_len(ptr ").concat(b.val).concat(")\n")
        .concat("  ").concat(cell).concat(" = call ptr @plum_array_new(i64 ").concat(len).concat(")\n")
        .concat("  ").concat(copied).concat(" = call i1 @plum_array_copy(ptr ").concat(cell).concat(", ptr ").concat(b.val).concat(", i64 ").concat(len).concat(")\n")
        .concat(cg_inc_elems(v.ty, cell, len, cell.concat("_ie")))
        // The slot being overwritten already had a reference from the
        // copy; releasing it keeps the new cell's count exact.
        .concat(cg_elem_ptr_lines(cell, i.val, v.n + 3))
        .concat("  ".concat(cell).concat("_old = load ").concat(cg_llvm_ty(v.ty)).concat(", ptr ").concat(cg_elem_ptr_reg(v.n + 3)).concat("\n"))
        .concat(cg_dec(cg_concrete(p, typecheck.texpr_ty(p.subst, value)), cell.concat("_old")))
        .concat("  store ").concat(cg_llvm_ty(v.ty)).concat(" ").concat(v.val).concat(", ptr ").concat(cg_elem_ptr_reg(v.n + 3)).concat("\n")
        .concat(cg_dec(cg_concrete(p, typecheck.texpr_ty(p.subst, base)), b.val));
    Emit { code: code, allocas: b.allocas.concat(i.allocas).concat(v.allocas), releases: b.releases.concat(i.releases).concat(v.releases),globals: b.globals.concat(i.globals).concat(v.globals), val: cell, ty: ty, n: v.n + 6 }
}

// `xs.remove(i)`: the runtime does the copy, this does the counting.
// Every element that SURVIVES into the new array gains a reference, and
// the source array is then released -- which drops the removed
// element's last reference along with the source's own. Same ownership
// shape as `cg_array_set`, which likewise copies and then rebalances.
let cg_array_remove (p: CgProgram) (env: Array[CgSlot]) (n: Int) (base: typecheck.TExpr) (idx: typecheck.TExpr) (ty: CgTy): Emit = {
    let b = cg_expr(p, env, n, base);
    let i = cg_expr(p, env, b.n, idx);
    let cell = cg_reg(i.n);
    let len = cg_reg(i.n + 1);
    let elem = cg_elem_ty(b.ty);
    let code = b.code.concat(i.code)
        .concat("  ").concat(cell).concat(" = call ptr @plum_array_remove(ptr ").concat(b.val).concat(", i64 ").concat(i.val).concat(")\n")
        .concat("  ").concat(len).concat(" = call i64 @plum_array_len(ptr ").concat(cell).concat(")\n")
        .concat(cg_inc_elems(elem, cell, len, cell.concat("_ie")))
        .concat(cg_dec(cg_concrete(p, typecheck.texpr_ty(p.subst, base)), b.val));
    Emit { code: code, allocas: b.allocas.concat(i.allocas), releases: b.releases.concat(i.releases), globals: b.globals.concat(i.globals), val: cell, ty: ty, n: i.n + 2 }
}

// A call into an `extern "C"` function. No mangling, no specialization,
// no ownership transfer: C does not participate in reference counting,
// so every argument is BORROWED and released here exactly as it would
// be for any other temporary.
//
// A `Unit` return is `void` in C terms, and LLVM will not let a void
// call produce a value -- so nothing is assigned and the expression's
// value is the usual Unit placeholder.
let cg_extern_call (p: CgProgram) (env: Array[CgSlot]) (n: Int) (name: String) (args: Array[typecheck.TExpr]) (ret: CgTy): Emit = {
    let a = cg_args(p, env, n, args, 0, "", "", "", "", []);
    // Bool arguments widen to C's `int` before the call.
    let m = cg_marshal_args(p, args, a.vals, 0, a.n, "", []);
    let reg = cg_reg(m.n);
    let raw = cg_reg(m.n + 1);
    let is_void = cg_ty_eq(ret, CgUnit);
    let is_bool = cg_ty_eq(ret, CgBool);
    let call = if is_void {
        "  call void @".concat(name).concat("(").concat(cg_join_commas(m.vals)).concat(")\n")
    } else if is_bool {
        // C returns an `int`; anything non-zero is true. Truncating
        // instead would read 2 as FALSE.
        "  ".concat(raw).concat(" = call i32 @").concat(name).concat("(").concat(cg_join_commas(m.vals)).concat(")\n")
            .concat("  ").concat(reg).concat(" = icmp ne i32 ").concat(raw).concat(", 0\n")
    } else {
        "  ".concat(reg).concat(" = call ").concat(cg_llvm_ty(ret)).concat(" @").concat(name).concat("(").concat(cg_join_commas(m.vals)).concat(")\n")
    };
    Emit { code: a.code.concat(m.code).concat(call).concat(cg_dec_args(p, args, a.vals, 0, "")), allocas: a.allocas, releases: a.releases, globals: a.globals,
        val: if is_void { "0" } else { reg }, ty: ret, n: m.n + 2 }
}

struct MarshalEmit { code: String, vals: Array[String], n: Int }

// One operand per argument, in C's spelling. Only `Bool` differs, and
// it differs in both directions -- see `cg_c_ty`.
let cg_marshal_args (p: CgProgram) (args: Array[typecheck.TExpr]) (vals: Array[String]) (i: Int) (n: Int) (code: String) (acc: Array[String]): MarshalEmit =
    if i >= args.len() || i >= vals.len() { MarshalEmit { code: code, vals: acc, n: n } }
    else {
        let ty = cg_ty(p, args[i]);
        if cg_ty_eq(ty, CgBool) {
            let w = cg_reg(n);
            cg_marshal_args(p, args, vals, i + 1, n + 1,
                code.concat("  ").concat(w).concat(" = zext i1 ").concat(cg_arg_val(vals[i])).concat(" to i32\n"),
                acc.push("i32 ".concat(w)))
        } else { cg_marshal_args(p, args, vals, i + 1, n, code, acc.push(vals[i])) }
    }

// `cg_args` yields "<ty> <reg>" operands; the register alone is what a
// conversion needs.
let cg_arg_val (operand: String): String = {
    let parts = operand.split(" ");
    parts[parts.len() - 1]
}

// `s.as_cstr()` -- the bytes of a string cell, which the runtime always
// keeps NUL-terminated (see runtime.plum's own note on why every string
// carries a trailing NUL the length never counts). So this is a pointer
// adjustment, not a copy, and the result BORROWS from the string: it
// stays valid exactly as long as that cell does.
let cg_as_cstr (p: CgProgram) (env: Array[CgSlot]) (n: Int) (inner: typecheck.TExpr): Emit = {
    let b = cg_borrow(p, env, n, inner);
    let reg = cg_reg(b.n);
    Emit {
        code: b.code.concat("  ").concat(reg).concat(" = getelementptr i8, ptr ").concat(b.val).concat(", i64 16\n").concat(b.drop),
        allocas: b.allocas, releases: b.releases, globals: b.globals, val: reg, ty: CgCStr, n: b.n + 1,
    }
}

// `c.as_string()` -- a fresh, owned string cell COPIED from the C
// pointer. A copy is the whole point: whatever C handed back may be a
// static buffer, a stack temporary, or freed on the next call.
let cg_as_string (p: CgProgram) (env: Array[CgSlot]) (n: Int) (inner: typecheck.TExpr): Emit = {
    let b = cg_expr(p, env, n, inner);
    let reg = cg_reg(b.n);
    Emit {
        code: b.code.concat("  ").concat(reg).concat(" = call ptr @plum_cstr_to_string(ptr ").concat(b.val).concat(")\n"),
        allocas: b.allocas, releases: b.releases, globals: b.globals, val: reg, ty: CgStr, n: b.n + 1,
    }
}

// `spawn { body }`. The body arrives as a zero-parameter closure (the
// checker wrapped it), so the capture machinery is already done: this
// emits a per-site ENTRY function matching what `thread_spawn` expects
// (`void *(*)(void *)`), which invokes the closure and boxes its result
// into one malloc'd word for `.join()` to collect.
//
// A box, rather than returning the value in the pointer itself: a
// `Float` does not fit in a pointer on every target, and a boxed word
// is the same shape for every element type, so `.join()`'s unboxing
// depends only on the type it already knows.
let cg_spawn (p: CgProgram) (env: Array[CgSlot]) (n: Int) (clo: typecheck.TExpr): Emit = {
    let c = cg_expr(p, env, n, clo);
    let ret_ity = match cg_concrete(p, typecheck.texpr_ty(p.subst, clo)) {
        ITFunction(_, r) => r,
        _ => ITUnit,
    };
    let ret = cg_of_ity(ret_ity);
    let entry = "@plum_task_entry".concat(c.n.to_string());
    let lty = cg_llvm_ty(ret);
    // The closure is the TASK's to release, and it is released here
    // rather than at `.join()` for the reason that a task nobody joins
    // still runs: joining is the only place the spawning side gets
    // control back, and it may never come. Doing it at the end of the
    // body means the closure's captures die when the body that reads
    // them is finished, joined or not.
    //
    // After the call, never before -- the body reads its own captures.
    // The returned value is unaffected: it arrives owned, carrying its
    // own reference, so releasing the captures cannot free it.
    //
    // A capture-FREE closure is a module-level constant with an
    // immortal refcount, and `@plum_rel_closure` skips those, so the
    // common `spawn { f(3) }` is unchanged.
    let fn_text = "define ptr ".concat(entry).concat("(ptr %clo) {\nentry:\n")
        .concat(cg_invoke("%clo", ret, "", 0))
        .concat("  call void @plum_rel_closure(ptr %clo)\n")
        .concat("  %box = call ptr @malloc(i64 8)\n")
        .concat("  store ").concat(lty).concat(" ").concat(cg_reg(1)).concat(", ptr %box\n")
        .concat("  ret ptr %box\n}\n\n");
    let h = cg_reg(c.n + 1);
    let cell = cg_reg(c.n + 2);
    Emit {
        code: c.code.concat("  ").concat(h).concat(" = call i64 @thread_spawn(ptr ").concat(entry).concat(", ptr ").concat(c.val).concat(")\n")
            .concat(cg_handle_cell(cell, h)),
        allocas: c.allocas, releases: c.releases, globals: c.globals.concat(fn_text),
        val: cell, ty: CgHandle("Task"), n: c.n + 3,
    }
}

// `t.join()` -- block, then take the boxed value. The box is freed
// here; the task struct itself is freed by `thread_join`.
let cg_task_join (p: CgProgram) (env: Array[CgSlot]) (n: Int) (task: typecheck.TExpr) (ret: CgTy): Emit = {
    let t = cg_expr(p, env, n, task);
    let box = cg_reg(t.n);
    let v = cg_reg(t.n + 1);
    let lty = cg_llvm_ty(ret);
    Emit {
        code: t.code
            .concat(cg_handle_load(cg_reg(t.n + 2), t.val))
            .concat("  ").concat(box).concat(" = call ptr @thread_join(i64 ").concat(cg_reg(t.n + 2)).concat(")\n")
            .concat("  ").concat(v).concat(" = load ").concat(lty).concat(", ptr ").concat(box).concat("\n")
            .concat("  call void @free(ptr ").concat(box).concat(")\n")
            .concat(cg_dec(cg_concrete(p, typecheck.texpr_ty(p.subst, task)), t.val)),
        allocas: t.allocas, releases: t.releases, globals: t.globals, val: v, ty: ret, n: t.n + 3,
    }
}

// `channel[T]()` -- one queue, returned as BOTH ends. The tuple's two
// components are separate cells over the same queue handle; only their
// types differ, which is
// what makes `.send` on a `Receiver` a type error rather than a runtime
// one.
// A handle CELL is `{ rc, i64 handle }`: the refcount that gives the
// thing behind the handle a lifetime, and the opaque shim value itself.
let cg_handle_cell (cell: String) (handle: String): String =
    "  ".concat(cell).concat(" = call ptr @plum_alloc(i64 16)\n")
        .concat("  ").concat(cell).concat("_h = getelementptr i8, ptr ").concat(cell).concat(", i64 8\n")
        .concat("  store i64 ").concat(handle).concat(", ptr ").concat(cell).concat("_h\n")

// The shim handle back out of a cell. Every call into the thread shim
// goes through this, because the shim knows nothing about cells.
let cg_handle_load (reg: String) (cell: String): String =
    "  ".concat(reg).concat("_p = getelementptr i8, ptr ").concat(cell).concat(", i64 8\n")
        .concat("  ").concat(reg).concat(" = load i64, ptr ").concat(reg).concat("_p\n")

let cg_channel_new (p: CgProgram) (env: Array[CgSlot]) (n: Int) (ty: CgTy): Emit = {
    let h = cg_reg(n);
    let tx = cg_reg(n + 1);
    let rx = cg_reg(n + 2);
    let cell = cg_reg(n + 3);
    // The queue is created with TWO references, one for each end's
    // cell, so it outlives whichever end is dropped first and is freed
    // when the second goes.
    let code = "  ".concat(h).concat(" = call i64 @channel_new()\n")
        .concat(cg_handle_cell(tx, h))
        .concat(cg_handle_cell(rx, h))
        .concat("  ").concat(cell).concat(" = call ptr @plum_alloc(i64 24)\n")
        .concat("  ").concat(cell).concat("_a = getelementptr i8, ptr ").concat(cell).concat(", i64 ").concat(cg_field_offset(0).to_string()).concat("\n")
        .concat("  store ptr ").concat(tx).concat(", ptr ").concat(cell).concat("_a\n")
        .concat("  ").concat(cell).concat("_b = getelementptr i8, ptr ").concat(cell).concat(", i64 ").concat(cg_field_offset(1).to_string()).concat("\n")
        .concat("  store ptr ").concat(rx).concat(", ptr ").concat(cell).concat("_b\n");
    Emit { code: code, allocas: "", releases: "", globals: "", val: cell, ty: ty, n: n + 4 }
}

// Values cross a channel BOXED, one malloc'd word, for the same reason
// a task's result is boxed: one shape for every element type.
let cg_channel_send (p: CgProgram) (env: Array[CgSlot]) (n: Int) (ch: typecheck.TExpr) (v: typecheck.TExpr): Emit = {
    let c = cg_expr(p, env, n, ch);
    let x = cg_expr(p, env, c.n, v);
    let box = cg_reg(x.n);
    let lty = cg_llvm_ty(x.ty);
    Emit {
        code: c.code.concat(x.code)
            .concat("  ").concat(box).concat(" = call ptr @malloc(i64 8)\n")
            .concat("  store ").concat(lty).concat(" ").concat(x.val).concat(", ptr ").concat(box).concat("\n")
            .concat(cg_handle_load(cg_reg(x.n + 1), c.val))
            .concat("  call void @channel_send(i64 ").concat(cg_reg(x.n + 1)).concat(", ptr ").concat(box).concat(")\n")
            .concat(cg_dec(cg_concrete(p, typecheck.texpr_ty(p.subst, ch)), c.val)),
        allocas: c.allocas.concat(x.allocas), releases: c.releases.concat(x.releases), globals: c.globals.concat(x.globals),
        val: "0", ty: CgUnit, n: x.n + 2,
    }
}

let cg_channel_recv (p: CgProgram) (env: Array[CgSlot]) (n: Int) (ch: typecheck.TExpr) (ret: CgTy): Emit = {
    let c = cg_expr(p, env, n, ch);
    let box = cg_reg(c.n);
    let v = cg_reg(c.n + 1);
    let lty = cg_llvm_ty(ret);
    Emit {
        code: c.code
            .concat(cg_handle_load(cg_reg(c.n + 2), c.val))
            .concat("  ").concat(box).concat(" = call ptr @channel_recv(i64 ").concat(cg_reg(c.n + 2)).concat(")\n")
            .concat("  ").concat(v).concat(" = load ").concat(lty).concat(", ptr ").concat(box).concat("\n")
            .concat("  call void @free(ptr ").concat(box).concat(")\n")
            .concat(cg_dec(cg_concrete(p, typecheck.texpr_ty(p.subst, ch)), c.val)),
        allocas: c.allocas, releases: c.releases, globals: c.globals, val: v, ty: ret, n: c.n + 3,
    }
}

// --- Closures ---
//
// A closure value is `{ ptr code, capture0, capture1, ... }`. Calling
// one loads the code pointer and passes the cell itself back in as the
// first argument, so the lifted function can read its own captures.
//
// **Captures are the free variables**, which they were not until
// 2026-08-26: this used to snapshot the WHOLE enclosing environment,
// on the grounds that computing free variables means a shadowing-aware
// scan of the body, and that analysis is what produced a real,
// crash-causing bug in `plum-ir/src/fbip.rs` earlier in this project.
//
// What changed is that the scan no longer has to be written. The
// question "does this body read `name`" is exactly what `cg_reads_max`
// answers, shadowing and all -- it is the same function the move and
// reuse analyses depend on, and it handles a nested closure's captures
// and a pattern that rebinds the name because they had to be handled
// for those.
//
// Being WRONG here is loud rather than silent: a capture dropped that
// the body actually reads is a name missing from `inner_env`, and
// `cg_ident` fails the compile with "unbound variable reached codegen"
// rather than emitting something that runs. That is the property that
// makes this worth doing where the Rust version was not.
//
// It also makes a closure that captures nothing a CONSTANT — see the
// end of this function.
//
// Captures are by VALUE, snapshotted at the literal's own creation
// site — matching real Plum semantics and the self-hosted interpreter's
// `VClosure` exactly.
//
// The closure's TYPE comes from the checker. That is what this stage
// bought: `let f = |n| n + 1` compiles now, because `n`'s
// representation was determined by unifying the body's use of it —
// inference this backend neither performs nor duplicates.
let cg_closure (p: CgProgram) (env: Array[CgSlot]) (n: Int) (params: Array[String]) (body: typecheck.TExpr) (fn_ity: typecheck.ITy): Emit = {
    let fn_ty = cg_of_ity(fn_ity);
    let param_tys = cg_closure_params(fn_ty);
    let param_itys = cg_closure_param_itys(fn_ity);
    if params.len() != param_tys.len() { cg_fail("closure takes ".concat(params.len().to_string()).concat(" parameter(s) but its type says ").concat(param_tys.len().to_string())) };
    let fn_name = "@plum_lambda".concat(n.to_string());
    // The lifted function's body is emitted against a FRESH environment
    // built from the captures and parameters, never the creation site's
    // slots directly — those are `alloca`s in a different function.
    let used = cg_used_captures(env, params, body, 0, []);
    let inner_env = cg_closure_inner_env(used, params, param_tys, param_itys, 0, []);
    let inner = cg_expr(p, inner_env, n + 1, body);
    let lifted = "define ".concat(cg_llvm_ty(inner.ty)).concat(" ").concat(fn_name).concat("(ptr %env").concat(cg_closure_param_decls(param_tys, 0, "")).concat(") {\nentry:\n")
        .concat(cg_capture_loads(used, 0, ""))
        .concat(cg_closure_param_slots(param_tys, 0, ""))
        .concat(inner.allocas)
        .concat(inner.code)
        // The same two release lists a NAMED function emits on the way
        // out (see `cg_fn`), and for the same reasons. Neither was
        // emitted here, so a closure leaked both its own body's slots
        // and every heap ARGUMENT it was handed.
        //
        // The argument half is the one that bites: a caller hands a
        // closure an owned value -- `Array.map` explicitly increments
        // each element first, "the closure consumes what it is given"
        // -- and nothing ever gave it back. `Array.map` over an array
        // of heap elements leaked one cell PER ELEMENT, which is how
        // the JSON stringifier came to leak proportionally to the
        // document it was printing.
        //
        // CAPTURES are deliberately not released here: they belong to
        // the closure CELL, and `<fn>_rel` walks them when the cell
        // itself dies. Releasing them per CALL would free them out from
        // under the next invocation.
        .concat(inner.releases)
        .concat(cg_closure_param_releases(param_itys, 0, ""))
        .concat("  ret ").concat(cg_llvm_ty(inner.ty)).concat(" ").concat(inner.val).concat("\n}\n\n");
    let cell = cg_reg(inner.n);
    let head = "  ".concat(cell).concat(" = call ptr @plum_alloc(i64 ").concat((24 + 8 * used.len()).to_string()).concat(")\n")
        .concat("  ").concat(cell).concat("_c = getelementptr i8, ptr ").concat(cell).concat(", i64 ").concat(cg_closure_code_offset(()).to_string()).concat("\n")
        .concat("  store ptr ").concat(fn_name).concat(", ptr ").concat(cell).concat("_c\n")
        .concat("  ").concat(cell).concat("_r = getelementptr i8, ptr ").concat(cell).concat(", i64 ").concat(cg_closure_rel_offset(()).to_string()).concat("\n")
        .concat("  store ptr ").concat(fn_name).concat("_rel, ptr ").concat(cell).concat("_r\n");
    let caps = cg_capture_stores(used, 0, cell, inner.n + 1, "");
    // The companion release function walks exactly the captures this
    // literal took, by name and type, and is emitted alongside the
    // lifted function itself — the two are generated together because
    // only here is it known what was captured.
    let rel_fn = "define void ".concat(fn_name).concat("_rel(ptr %p) {\nentry:\n")
        .concat(cg_capture_releases(used, 0, ""))
        .concat("  ret void\n}\n\n");
    // A closure that captured NOTHING is the same three words every
    // time it is evaluated -- refcount, code pointer, release pointer --
    // so it is emitted once, as a module-level constant, and the
    // literal costs no allocation at all. `|v| v + 1` inside a loop was
    // allocating a cell per iteration for a value that never differed.
    //
    // The refcount is -1, which is this runtime's existing spelling of
    // "immortal": `@plum_rc_inc` and `@plum_rel_closure` both check for
    // a negative count and return without touching it. Nothing ever
    // writes to the cell, which is what makes `constant` accurate
    // rather than merely convenient -- and the companion `_rel` is
    // still emitted, because the initialiser names it, even though the
    // path that would call it is unreachable for a cell that never
    // dies.
    //
    // This is not reuse. Reuse recycles a cell; this one is never
    // allocated.
    if cg_rc_enabled(()) && Array.is_empty(used) {
        let g = fn_name.concat("_cell");
        Emit { code: "", allocas: "", releases: "",
            globals: inner.globals.concat(lifted).concat(rel_fn)
                .concat(g).concat(" = private constant { i64, ptr, ptr } { i64 -1, ptr ")
                .concat(fn_name).concat(", ptr ").concat(fn_name).concat("_rel }\n\n"),
            val: g, ty: fn_ty, n: inner.n }
    } else {
        Emit { code: head.concat(caps.code), allocas: "", releases: "", globals: inner.globals.concat(lifted).concat(rel_fn), val: cell, ty: fn_ty, n: caps.n }
    }
}

// The enclosing slots this body actually reads. `cg_reads_max` is
// asked only whether the count is nonzero, so its cap at 2 is
// irrelevant; what matters is that a zero is trustworthy, which is the
// same property the move analysis already relies on.
// The closure's OWN parameters are checked first, because a parameter
// shadowing an enclosing local means the body's mentions of that name
// are not references to the local at all. `cg_reads_max` applies this
// rule itself when it walks a nested `TClosure`; asking it about a bare
// body skips the step, which kept `|x| x * 10` capturing an outer `x`
// it never reads.
let cg_used_captures (env: Array[CgSlot]) (params: Array[String]) (body: typecheck.TExpr) (i: Int) (acc: Array[CgSlot]): Array[CgSlot] =
    if i >= env.len() { acc }
    else {
        cg_used_captures(env, params, body, i + 1,
            if !cg_params_shadow(params, env[i].name, 0) && cg_reads_max(env[i].name, body) > 0 { acc.push(env[i]) } else { acc })
    }

let cg_closure_ret (t: CgTy): CgTy =
    match t { CgClosure(_, ret) => ret, _ => { cg_fail("expected a closure, found ".concat(cg_ty_name(t))); CgUnit } }

let cg_closure_param_itys (t: typecheck.ITy): Array[typecheck.ITy] =
    match t { ITFunction(ptys, _) => ptys, _ => { cg_fail("expected a closure type"); [] } }

let cg_closure_params (t: CgTy): Array[CgTy] =
    match t { CgClosure(ptys, _) => ptys, _ => { cg_fail("expected a closure, found ".concat(cg_ty_name(t))); [] } }

// Capture slots keep the creation site's NAMES and order, so a name
// resolves inside the lifted function exactly as it did outside — and
// shadowing keeps working for free, because `cg_lookup` scans from the
// end of the list either way.
let cg_closure_inner_env (env: Array[CgSlot]) (params: Array[String]) (param_tys: Array[CgTy]) (param_itys: Array[typecheck.ITy]) (i: Int) (acc: Array[CgSlot]): Array[CgSlot] =
    if i < env.len() { cg_closure_inner_env(env, params, param_tys, param_itys, i + 1, acc.push(CgSlot { name: env[i].name, ptr: "%c".concat(i.to_string()), ty: env[i].ty, ity: env[i].ity })) }
    else if i - env.len() < params.len() {
        let j = i - env.len();
        cg_closure_inner_env(env, params, param_tys, param_itys, i + 1, acc.push(CgSlot { name: params[j], ptr: "%a".concat(j.to_string()), ty: param_tys[j], ity: param_itys[j] }))
    }
    else { acc }

let cg_closure_param_decls (param_tys: Array[CgTy]) (i: Int) (acc: String): String =
    if i >= param_tys.len() { acc }
    else { cg_closure_param_decls(param_tys, i + 1, acc.concat(", ").concat(cg_llvm_ty(param_tys[i])).concat(" %p").concat(i.to_string())) }

let cg_capture_loads (env: Array[CgSlot]) (i: Int) (acc: String): String =
    if i >= env.len() { acc }
    else {
        let lty = cg_llvm_ty(env[i].ty);
        let line = "  %cp".concat(i.to_string()).concat(" = getelementptr i8, ptr %env, i64 ").concat(cg_capture_offset(i).to_string()).concat("\n")
            .concat("  %cv").concat(i.to_string()).concat(" = load ").concat(lty).concat(", ptr %cp").concat(i.to_string()).concat("\n")
            .concat("  %c").concat(i.to_string()).concat(" = alloca ").concat(lty).concat("\n")
            .concat("  store ").concat(lty).concat(" %cv").concat(i.to_string()).concat(", ptr %c").concat(i.to_string()).concat("\n");
        cg_capture_loads(env, i + 1, acc.concat(line))
    }

// One release per parameter slot, mirroring `cg_param_slots`'s own
// `cg_release_slot` for named functions. The RESULT needs no special
// case for the same reason it needs none there: it carries its own +1,
// obtained independently of any slot, so returning a parameter and then
// releasing that parameter is balanced rather than a use-after-free.
let cg_closure_param_releases (param_itys: Array[typecheck.ITy]) (i: Int) (acc: String): String =
    if i >= param_itys.len() { acc }
    else { cg_closure_param_releases(param_itys, i + 1, acc.concat(cg_release_slot(param_itys[i], "%a".concat(i.to_string()), "_cend"))) }

let cg_closure_param_slots (param_tys: Array[CgTy]) (i: Int) (acc: String): String =
    if i >= param_tys.len() { acc }
    else {
        let lty = cg_llvm_ty(param_tys[i]);
        let line = "  %a".concat(i.to_string()).concat(" = alloca ").concat(lty).concat("\n")
            .concat("  store ").concat(lty).concat(" %p").concat(i.to_string()).concat(", ptr %a").concat(i.to_string()).concat("\n");
        cg_closure_param_slots(param_tys, i + 1, acc.concat(line))
    }

// One release per captured slot, at its own offset, using its own
// type's release function. `cg_rel_sym` needs an `ITy`, and a capture
// slot only carries a `CgTy` — but a closure's captures are always
// released through the representation-level path, which is exactly what
// `cg_rel_sym_cg` provides.
let cg_capture_releases (env: Array[CgSlot]) (i: Int) (acc: String): String =
    if i >= env.len() { acc }
    else if !cg_is_heap(env[i].ty) { cg_capture_releases(env, i + 1, acc) }
    else {
        let line = "  %kp".concat(i.to_string()).concat(" = getelementptr i8, ptr %p, i64 ").concat(cg_capture_offset(i).to_string()).concat("\n")
            .concat("  %kv").concat(i.to_string()).concat(" = load ptr, ptr %kp").concat(i.to_string()).concat("\n")
            .concat("  call void ").concat(cg_rel_sym(env[i].ity)).concat("(ptr %kv").concat(i.to_string()).concat(")\n");
        cg_capture_releases(env, i + 1, acc.concat(line))
    }

let cg_capture_stores (env: Array[CgSlot]) (i: Int) (cell: String) (n: Int) (acc: String): StoreEmit =
    if i >= env.len() { StoreEmit { code: acc, n: n } }
    else {
        let lty = cg_llvm_ty(env[i].ty);
        let v = cg_reg(n);
        let slot = cg_reg(n + 1);
        let line = "  ".concat(v).concat(" = load ").concat(lty).concat(", ptr ").concat(env[i].ptr).concat("\n")
            .concat(cg_inc(env[i].ty, v))
            .concat("  ").concat(slot).concat(" = getelementptr i8, ptr ").concat(cell).concat(", i64 ").concat(cg_capture_offset(i).to_string()).concat("\n")
            .concat("  store ").concat(lty).concat(" ").concat(v).concat(", ptr ").concat(slot).concat("\n");
        cg_capture_stores(env, i + 1, cell, n + 2, acc.concat(line))
    }

// Calling a closure VALUE: load the code pointer, pass the cell itself
// back as the environment argument.
let cg_call_closure_value (p: CgProgram) (env: Array[CgSlot]) (n: Int) (clo: Emit) (args: Array[typecheck.TExpr]): Emit = {
    let ret = cg_closure_ret(clo.ty);
    let a = cg_args(p, env, clo.n, args, 0, "", "", "", "", []);
    let fp = cg_reg(a.n);
    let out = cg_reg(a.n + 1);
    let code = clo.code.concat(a.code)
        .concat("  ").concat(fp).concat("p = getelementptr i8, ptr ").concat(clo.val).concat(", i64 ").concat(cg_closure_code_offset(()).to_string()).concat("\n")
        .concat("  ").concat(fp).concat(" = load ptr, ptr ").concat(fp).concat("p\n")
        .concat("  ").concat(out).concat(" = call ").concat(cg_llvm_ty(ret)).concat(" ").concat(fp).concat("(ptr ").concat(clo.val).concat(cg_prefix_commas(a.vals)).concat(")\n")
        // The callee arrived OWNED — `cg_expr`, so reading a closure
        // out of a variable incremented it — and invoking a closure
        // does not consume it. Without this the reference taken to
        // make the call was never given back, which leaked the cell
        // and everything it captured. This, not any missing
        // machinery, was the closure "capture leak": `<fn>_rel` and
        // the release pointer in the cell header were correct all
        // along and simply never reached.
        .concat(cg_dec_cg(clo.ty, clo.val));
    Emit { code: code, allocas: clo.allocas.concat(a.allocas), releases: clo.releases.concat(a.releases),globals: clo.globals.concat(a.globals), val: out, ty: ret, n: a.n + 2 }
}

let cg_prefix_commas (vals: Array[String]): String = cg_prefix_acc(vals, 0, "")
let cg_prefix_acc (vals: Array[String]) (i: Int) (acc: String): String =
    if i >= vals.len() { acc } else { cg_prefix_acc(vals, i + 1, acc.concat(", ").concat(vals[i])) }

// --- Array.map / Array.filter / Array.fold ---
//
// These are PRELUDE functions in the real compiler — ordinary generic
// Plum source. This backend has neither a prelude nor generics, so they
// are emitted inline as loops instead. That is not a workaround: an
// inlined loop is what a monomorphizing backend would produce for them
// anyway.

let cg_elem_ty (t: CgTy): CgTy =
    match t {
        CgArray(elem) => elem,
        _ => { cg_fail("expected an Array, found ".concat(cg_ty_name(t))); CgUnit },
    }

// `base + 8 + 8*index`, as three real instructions. The resulting
// pointer is `cg_reg(n + 2)`; three registers are consumed.
let cg_elem_ptr_lines (arr: String) (idx: String) (n: Int): String =
    "  ".concat(cg_reg(n)).concat(" = mul i64 ").concat(idx).concat(", 8\n")
        .concat("  ").concat(cg_reg(n + 1)).concat(" = getelementptr i8, ptr ").concat(arr).concat(", i64 ").concat(cg_reg(n)).concat("\n")
        .concat("  ").concat(cg_reg(n + 2)).concat(" = getelementptr i8, ptr ").concat(cg_reg(n + 1)).concat(", i64 ").concat(cg_array_elem_offset(0).to_string()).concat("\n")

let cg_elem_ptr_reg (n: Int): String = cg_reg(n + 2)

// A counted loop over `0..len`. `pre` opens it (through the body
// label), `post` closes it; `idx_reg` holds the current index inside
// the body. The induction variable's `alloca` is the CALLER's to hoist.
struct LoopParts { pre: String, post: String, idx_reg: String, body_n: Int }

let cg_array_loop (iv: String) (len: String) (n: Int): LoopParts = {
    let cond_label = cg_label(n);
    let body_label = cg_label(n + 1);
    let end_label = cg_label(n + 2);
    let cur = cg_reg(n + 3);
    let test = cg_reg(n + 4);
    let step = cg_reg(n + 5);
    let pre = "  store i64 0, ptr ".concat(iv).concat("\n")
        .concat("  br label %").concat(cond_label).concat("\n")
        .concat(cond_label).concat(":\n")
        .concat("  ").concat(cur).concat(" = load i64, ptr ").concat(iv).concat("\n")
        .concat("  ").concat(test).concat(" = icmp slt i64 ").concat(cur).concat(", ").concat(len).concat("\n")
        .concat("  br i1 ").concat(test).concat(", label %").concat(body_label).concat(", label %").concat(end_label).concat("\n")
        .concat(body_label).concat(":\n");
    let post = "  ".concat(step).concat(" = add i64 ").concat(cur).concat(", 1\n")
        .concat("  store i64 ").concat(step).concat(", ptr ").concat(iv).concat("\n")
        .concat("  br label %").concat(cond_label).concat("\n")
        .concat(end_label).concat(":\n");
    LoopParts { pre: pre, post: post, idx_reg: cur, body_n: n + 6 }
}

let cg_invoke (clo_val: String) (ret: CgTy) (arg_ops: String) (n: Int): String =
    "  ".concat(cg_reg(n)).concat("p = getelementptr i8, ptr ").concat(clo_val).concat(", i64 ").concat(cg_closure_code_offset(()).to_string()).concat("\n")
        .concat("  ").concat(cg_reg(n)).concat(" = load ptr, ptr ").concat(cg_reg(n)).concat("p\n")
        .concat("  ").concat(cg_reg(n + 1)).concat(" = call ").concat(cg_llvm_ty(ret)).concat(" ").concat(cg_reg(n)).concat("(ptr ").concat(clo_val).concat(arg_ops).concat(")\n")

let cg_array_ns_call (p: CgProgram) (env: Array[CgSlot]) (n: Int) (fn_name: String) (args: Array[typecheck.TExpr]): Emit =
    if fn_name == "map" { cg_array_map(p, env, n, args[0], args[1]) }
    else if fn_name == "filter" { cg_array_filter(p, env, n, args[0], args[1]) }
    else if fn_name == "fold" { cg_array_fold(p, env, n, args[0], args[1], args[2]) }
    else { { cg_fail("Array.".concat(fn_name).concat("(..) isn't supported yet")); cg_unit_emit(n) } }

// `Array.map(xs, f)` building its result into `xs`'s own cell.
//
// Element types that need releasing are handled, not refused. The loop
// drops the source's own reference to element `i` once the closure has
// taken its own -- see `cg_reuse_elem_drop`, which is also why `same`
// is computed BEFORE the loop rather than after it.
//
// The source is MOVED out of its slot before anything else, which is
// what lets its refcount reach 1 and the reuse fire at all.
//
// Reading `src[i]` and writing `out[i]` in the same cell is safe
// because map is elementwise and in order: element `i` is read before
// it is written and never read again.
let cg_array_map_reuse (p: CgProgram) (env: Array[CgSlot]) (n: Int) (nm: String) (args: Array[typecheck.TExpr]) (cand: String): Emit =
    match cg_array_reuse_slot(p, env, cand, args) {
        None => cg_array_ns_call(p, env, n, nm, args),
        Some(slot) => {
            let elem = cg_elem_ty(slot.ty);
            let elem_ity = cg_array_elem_ity(p, slot.ity);
            let old = cg_reg(n);
            let f = cg_expr(p, env, n + 1, args[1]);
            let ret = cg_closure_ret(f.ty);
            let len = cg_reg(f.n);
            let out = cg_reg(f.n + 1);
            let iv = cg_reg(f.n + 2);
            let same = cg_reg(f.n + 3);
            let lp = cg_array_loop(iv, len, f.n + 4);
            let b = lp.body_n;
            let ev = cg_reg(b + 3);
            let body = cg_elem_ptr_lines(old, lp.idx_reg, b)
                .concat("  ").concat(ev).concat(" = load ").concat(cg_llvm_ty(elem)).concat(", ptr ").concat(cg_elem_ptr_reg(b)).concat("\n")
                .concat(cg_inc(elem, ev))
                .concat(cg_invoke(f.val, ret, ", ".concat(cg_llvm_ty(elem)).concat(" ").concat(ev), b + 4))
                // Before the store, so the slot is not left holding a
                // reference nobody owns. Safe when the closure returned
                // the element it was given: that value carries the
                // reference the `cg_inc` above added, so it survives
                // this drop and the store below re-homes it.
                .concat(cg_reuse_elem_drop(elem_ity, same, ev, b + 9))
                .concat(cg_elem_ptr_lines(out, lp.idx_reg, b + 6))
                .concat("  store ").concat(cg_llvm_ty(ret)).concat(" ").concat(cg_reg(b + 5)).concat(", ptr ").concat(cg_elem_ptr_reg(b + 6)).concat("\n");
            let ldrop = cg_label(b + 11);
            let lskip = cg_label(b + 12);
            Emit {
                code: "  ".concat(old).concat(" = load ptr, ptr ").concat(slot.ptr).concat("\n")
                    .concat("  store ptr null, ptr ").concat(slot.ptr).concat("\n")
                    .concat(f.code)
                    .concat("  ").concat(len).concat(" = call i64 @plum_array_len(ptr ").concat(old).concat(")\n")
                    .concat("  ").concat(out).concat(" = call ptr @plum_array_reuse(ptr ").concat(old).concat(", i64 ").concat(len).concat(")\n")
                    // Hoisted above the loop because the BODY needs it
                    // too: whether each element's source reference is
                    // this loop's to drop is the same question as
                    // whether the cell was recycled.
                    .concat("  ").concat(same).concat(" = icmp eq ptr ").concat(out).concat(", ").concat(old).concat("\n")
                    .concat(lp.pre).concat(body).concat(lp.post)
                    // The source is only released when it was NOT reused.
                    // When it was, the cell IS the result and releasing it
                    // would free what is being returned.
                    .concat("  br i1 ").concat(same).concat(", label %").concat(lskip).concat(", label %").concat(ldrop).concat("\n")
                    .concat(ldrop).concat(":\n")
                    .concat(cg_dec(cg_concrete(p, slot.ity), old))
                    .concat("  br label %").concat(lskip).concat("\n")
                    .concat(lskip).concat(":\n")
                    .concat(cg_dec_cg(f.ty, f.val)),
                allocas: "  ".concat(iv).concat(" = alloca i64\n").concat(f.allocas),
                releases: f.releases, globals: f.globals, val: out, ty: CgArray(ret), n: b + 13,
            }
        },
    }

// The element type an `Array[T]` holds, as an `ITy` -- which is what
// picking a release function needs, and what a `CgTy` cannot say.
let cg_array_elem_ity (p: CgProgram) (arr: typecheck.ITy): typecheck.ITy = {
    let args = cg_ity_args(cg_concrete(p, arr));
    if Array.is_empty(args) { ITUnit } else { args[0] }
}

// Dropping the SOURCE array's own reference to element `i`, and only
// when the cell was actually recycled.
//
// `@plum_array_reuse` hands back the pointer it was given only when the
// refcount was 1, so `same` means "we are the sole owner, and this cell
// IS the result". The reference the source held in slot `i` then has
// nowhere left to live: the slot is about to hold something else
// (`map`), or the element is being dropped or moved forward
// (`filter`). Releasing it here is what stops it leaking, and this is
// the whole of the loop-body change that lets arrays of strings and
// structs be recycled at all.
//
// When the cell was NOT recycled, the source is still a live array --
// either somebody else holds a reference, or it simply did not fit --
// and its elements are accounted for by the whole-array release after
// the loop. Dropping them here would corrupt an array another owner is
// still reading, which is the one way this goes wrong invisibly, so the
// branch is not an optimisation and must not be hoisted away.
//
// Emitted only for element types that need releasing, so an array of
// scalars produces exactly the instructions it did before.
let cg_reuse_elem_drop (elem_ity: typecheck.ITy) (same: String) (ev: String) (n: Int): String = {
    let drop = cg_dec(elem_ity, ev);
    if drop == "" { "" }
    else {
        let ldo = cg_label(n);
        let lend = cg_label(n + 1);
        "  br i1 ".concat(same).concat(", label %").concat(ldo).concat(", label %").concat(lend).concat("\n")
            .concat(ldo).concat(":\n").concat(drop)
            .concat("  br label %").concat(lend).concat("\n")
            .concat(lend).concat(":\n")
    }
}

let cg_array_ns_reuse (p: CgProgram) (env: Array[CgSlot]) (n: Int) (nm: String) (args: Array[typecheck.TExpr]) (cand: String): Emit =
    if nm == "filter" { cg_array_filter_reuse(p, env, n, nm, args, cand) }
    else { cg_array_map_reuse(p, env, n, nm, args, cand) }

// `Array.filter(xs, pred)` compacting its result into `xs`'s own cell.
//
// Safe for the same reason `map` is, and for one more. Element `i` is
// read before anything is written for it, and the write goes to slot
// `j` where `j` is the number kept SO FAR -- so `j <= i` always, and a
// slot is only ever overwritten after it has been read. The equal case
// (`j == i`, nothing filtered out yet) stores the element back where
// it came from.
//
// The result is SHORTER than the cell, which is the only real
// difference from `map`: the length header is patched down at the end,
// exactly as the allocating `cg_array_filter` already patches its own
// over-allocated cell. A cell whose header says 3 when it has room for
// 8 is what an array literally is here, so nothing else has to change.
//
// The elements filtered OUT are the sharp case: their slots are
// compacted over, and the cell is not released either because it IS the
// result, so nothing else would ever drop them. The loop drops the
// source's reference to EVERY element it visits, kept or not -- a kept
// one has already taken a second reference for its new slot by then.
// See `cg_reuse_elem_drop`.
let cg_array_filter_reuse (p: CgProgram) (env: Array[CgSlot]) (n: Int) (nm: String) (args: Array[typecheck.TExpr]) (cand: String): Emit =
    match cg_array_reuse_slot(p, env, cand, args) {
        None => cg_array_ns_call(p, env, n, nm, args),
        Some(slot) => {
            let elem = cg_elem_ty(slot.ty);
            let elem_ity = cg_array_elem_ity(p, slot.ity);
            let old = cg_reg(n);
            let f = cg_expr(p, env, n + 1, args[1]);
            let len = cg_reg(f.n);
            let out = cg_reg(f.n + 1);
            let iv = cg_reg(f.n + 2);
            let cnt = cg_reg(f.n + 3);
            let same = cg_reg(f.n + 4);
            let lp = cg_array_loop(iv, len, f.n + 5);
            let b = lp.body_n;
            let ev = cg_reg(b + 3);
            let keep_label = cg_label(b + 6);
            let skip_label = cg_label(b + 7);
            let cur_cnt = cg_reg(b + 8);
            let next_cnt = cg_reg(b + 9);
            let body = cg_elem_ptr_lines(old, lp.idx_reg, b)
                .concat("  ").concat(ev).concat(" = load ").concat(cg_llvm_ty(elem)).concat(", ptr ").concat(cg_elem_ptr_reg(b)).concat("\n")
                .concat(cg_inc(elem, ev))
                .concat(cg_invoke(f.val, CgBool, ", ".concat(cg_llvm_ty(elem)).concat(" ").concat(ev), b + 4))
                .concat("  br i1 ").concat(cg_reg(b + 5)).concat(", label %").concat(keep_label).concat(", label %").concat(skip_label).concat("\n")
                .concat(keep_label).concat(":\n")
                .concat("  ").concat(cur_cnt).concat(" = load i64, ptr ").concat(cnt).concat("\n")
                .concat(cg_elem_ptr_lines(out, cur_cnt, b + 10))
                .concat(cg_inc(elem, ev))
                .concat("  store ").concat(cg_llvm_ty(elem)).concat(" ").concat(ev).concat(", ptr ").concat(cg_elem_ptr_reg(b + 10)).concat("\n")
                .concat("  ").concat(next_cnt).concat(" = add i64 ").concat(cur_cnt).concat(", 1\n")
                .concat("  store i64 ").concat(next_cnt).concat(", ptr ").concat(cnt).concat("\n")
                .concat("  br label %").concat(skip_label).concat("\n")
                .concat(skip_label).concat(":\n")
                // After the join, so it runs once per element whether
                // it was kept or dropped. A kept element already holds
                // the second reference stored into its new slot.
                .concat(cg_reuse_elem_drop(elem_ity, same, ev, b + 13));
            let final_cnt = cg_reg(b + 15);
            let ldrop = cg_label(b + 16);
            let lskip = cg_label(b + 17);
            Emit {
                code: "  ".concat(old).concat(" = load ptr, ptr ").concat(slot.ptr).concat("\n")
                    .concat("  store ptr null, ptr ").concat(slot.ptr).concat("\n")
                    .concat(f.code)
                    .concat("  ").concat(len).concat(" = call i64 @plum_array_len(ptr ").concat(old).concat(")\n")
                    .concat("  ").concat(out).concat(" = call ptr @plum_array_reuse(ptr ").concat(old).concat(", i64 ").concat(len).concat(")\n")
                    .concat("  ").concat(same).concat(" = icmp eq ptr ").concat(out).concat(", ").concat(old).concat("\n")
                    .concat("  store i64 0, ptr ").concat(cnt).concat("\n")
                    .concat(lp.pre).concat(body).concat(lp.post)
                    .concat("  ").concat(final_cnt).concat(" = load i64, ptr ").concat(cnt).concat("\n")
                    .concat("  ").concat(final_cnt).concat("p = getelementptr i8, ptr ").concat(out).concat(", i64 8\n")
                    .concat("  store i64 ").concat(final_cnt).concat(", ptr ").concat(final_cnt).concat("p\n")
                    // Released only when the cell was NOT reused. When
                    // it was, the cell IS the result.
                    .concat("  br i1 ").concat(same).concat(", label %").concat(lskip).concat(", label %").concat(ldrop).concat("\n")
                    .concat(ldrop).concat(":\n")
                    .concat(cg_dec(cg_concrete(p, slot.ity), old))
                    .concat("  br label %").concat(lskip).concat("\n")
                    .concat(lskip).concat(":\n")
                    .concat(cg_dec_cg(f.ty, f.val)),
                allocas: "  ".concat(iv).concat(" = alloca i64\n").concat("  ").concat(cnt).concat(" = alloca i64\n").concat(f.allocas),
                releases: f.releases, globals: f.globals, val: out, ty: CgArray(elem), n: b + 18,
            }
        },
    }

// No `cg_is_movable` interlock here, unlike `cg_reuse_cand`, and the
// asymmetry is deliberate. That set means "read at most once on any
// path", so if the name is in it, the single read on this path IS this
// `map` -- and one read is emitted by one emitter, this one. There is
// no second site left for `cg_move_or_own` to move it at. Keeping the
// interlock would refuse precisely the case worth having: an array
// parameter mapped once per call, which is what a map inside a loop
// looks like.
let cg_array_reuse_slot (p: CgProgram) (env: Array[CgSlot]) (cand: String) (args: Array[typecheck.TExpr]): Option[CgSlot] =
    if cg_rc_enabled(()) && args.len() == 2 {
        match cg_lookup(env, cand) {
            None => None,
            // No condition on the ELEMENT type any more: the loop
            // body drops what it overwrites. What is left is only
            // "is this actually an array slot".
            Some(slot) => match slot.ty { CgArray(_) => Some(slot), _ => None },
        }
    } else { None }

let cg_array_map (p: CgProgram) (env: Array[CgSlot]) (n: Int) (arr_e: typecheck.TExpr) (f_e: typecheck.TExpr): Emit = {
    let a = cg_expr(p, env, n, arr_e);
    let elem = cg_elem_ty(a.ty);
    let f = cg_expr(p, env, a.n, f_e);
    let ret = cg_closure_ret(f.ty);
    let len = cg_reg(f.n);
    let out = cg_reg(f.n + 1);
    let iv = cg_reg(f.n + 2);
    let lp = cg_array_loop(iv, len, f.n + 3);
    let b = lp.body_n;
    let ev = cg_reg(b + 3);
    let body = cg_elem_ptr_lines(a.val, lp.idx_reg, b)
        .concat("  ").concat(ev).concat(" = load ").concat(cg_llvm_ty(elem)).concat(", ptr ").concat(cg_elem_ptr_reg(b)).concat("\n")
        // Rule 4: the closure consumes what it is given, so the
        // borrowed element has to become owned first. The source array
        // keeps its own reference.
        .concat(cg_inc(elem, ev))
        .concat(cg_invoke(f.val, ret, ", ".concat(cg_llvm_ty(elem)).concat(" ").concat(ev), b + 4))
        .concat(cg_elem_ptr_lines(out, lp.idx_reg, b + 6))
        .concat("  store ").concat(cg_llvm_ty(ret)).concat(" ").concat(cg_reg(b + 5)).concat(", ptr ").concat(cg_elem_ptr_reg(b + 6)).concat("\n");
    let code = a.code.concat(f.code)
        .concat("  ").concat(len).concat(" = call i64 @plum_array_len(ptr ").concat(a.val).concat(")\n")
        .concat("  ").concat(out).concat(" = call ptr @plum_array_new(i64 ").concat(len).concat(")\n")
        .concat(lp.pre).concat(body).concat(lp.post)
        // Both operands arrived OWNED (`cg_expr`, not `cg_borrow`), so
        // both are this call's to release. Neither was, which leaked
        // the source array and the closure cell on every
        // `Array.map`/`filter`/`fold` -- invisible when an array is
        // used once, real the moment one is folded over twice.
        .concat(cg_dec(cg_concrete(p, typecheck.texpr_ty(p.subst, arr_e)), a.val))
        .concat(cg_dec_cg(f.ty, f.val));
    Emit { code: code, allocas: "  ".concat(iv).concat(" = alloca i64\n").concat(a.allocas).concat(f.allocas), releases: a.releases.concat(f.releases),globals: a.globals.concat(f.globals), val: out, ty: CgArray(ret), n: b + 9 }
}

// The output array is allocated at the INPUT's length and its length
// header is patched down afterwards to however many elements were kept.
// One pass; counting first would call the predicate twice per element,
// which is observably different for a predicate with effects.
let cg_array_filter (p: CgProgram) (env: Array[CgSlot]) (n: Int) (arr_e: typecheck.TExpr) (f_e: typecheck.TExpr): Emit = {
    let a = cg_expr(p, env, n, arr_e);
    let elem = cg_elem_ty(a.ty);
    let f = cg_expr(p, env, a.n, f_e);
    let len = cg_reg(f.n);
    let out = cg_reg(f.n + 1);
    let iv = cg_reg(f.n + 2);
    let cnt = cg_reg(f.n + 3);
    let lp = cg_array_loop(iv, len, f.n + 4);
    let b = lp.body_n;
    let ev = cg_reg(b + 3);
    let keep_label = cg_label(b + 6);
    let skip_label = cg_label(b + 7);
    let cur_cnt = cg_reg(b + 8);
    let next_cnt = cg_reg(b + 9);
    let body = cg_elem_ptr_lines(a.val, lp.idx_reg, b)
        .concat("  ").concat(ev).concat(" = load ").concat(cg_llvm_ty(elem)).concat(", ptr ").concat(cg_elem_ptr_reg(b)).concat("\n")
        // One reference for the predicate to consume, and -- if the
        // element is kept -- one more for the output array below.
        .concat(cg_inc(elem, ev))
        .concat(cg_invoke(f.val, CgBool, ", ".concat(cg_llvm_ty(elem)).concat(" ").concat(ev), b + 4))
        .concat("  br i1 ").concat(cg_reg(b + 5)).concat(", label %").concat(keep_label).concat(", label %").concat(skip_label).concat("\n")
        .concat(keep_label).concat(":\n")
        .concat("  ").concat(cur_cnt).concat(" = load i64, ptr ").concat(cnt).concat("\n")
        .concat(cg_elem_ptr_lines(out, cur_cnt, b + 10))
        .concat(cg_inc(elem, ev))
        .concat("  store ").concat(cg_llvm_ty(elem)).concat(" ").concat(ev).concat(", ptr ").concat(cg_elem_ptr_reg(b + 10)).concat("\n")
        .concat("  ").concat(next_cnt).concat(" = add i64 ").concat(cur_cnt).concat(", 1\n")
        .concat("  store i64 ").concat(next_cnt).concat(", ptr ").concat(cnt).concat("\n")
        .concat("  br label %").concat(skip_label).concat("\n")
        .concat(skip_label).concat(":\n");
    let final_cnt = cg_reg(b + 13);
    let code = a.code.concat(f.code)
        .concat("  ").concat(len).concat(" = call i64 @plum_array_len(ptr ").concat(a.val).concat(")\n")
        .concat("  ").concat(out).concat(" = call ptr @plum_array_new(i64 ").concat(len).concat(")\n")
        .concat("  store i64 0, ptr ").concat(cnt).concat("\n")
        .concat(lp.pre).concat(body).concat(lp.post)
        .concat("  ").concat(final_cnt).concat(" = load i64, ptr ").concat(cnt).concat("\n")
        .concat("  ").concat(final_cnt).concat("p = getelementptr i8, ptr ").concat(out).concat(", i64 8\n")
        .concat("  store i64 ").concat(final_cnt).concat(", ptr ").concat(final_cnt).concat("p\n")
        // Both operands arrived OWNED (`cg_expr`, not `cg_borrow`), so
        // both are this call's to release. Neither was, which leaked
        // the source array and the closure cell on every
        // `Array.map`/`filter`/`fold` -- invisible when an array is
        // used once, real the moment one is folded over twice.
        .concat(cg_dec(cg_concrete(p, typecheck.texpr_ty(p.subst, arr_e)), a.val))
        .concat(cg_dec_cg(f.ty, f.val));
    Emit {
        code: code,
        allocas: "  ".concat(iv).concat(" = alloca i64\n").concat("  ").concat(cnt).concat(" = alloca i64\n").concat(a.allocas).concat(f.allocas), releases: a.releases.concat(f.releases),
        globals: a.globals.concat(f.globals), val: out, ty: CgArray(elem), n: b + 14,
    }
}

let cg_array_fold (p: CgProgram) (env: Array[CgSlot]) (n: Int) (arr_e: typecheck.TExpr) (init_e: typecheck.TExpr) (f_e: typecheck.TExpr): Emit = {
    let a = cg_expr(p, env, n, arr_e);
    let elem = cg_elem_ty(a.ty);
    let init = cg_expr(p, env, a.n, init_e);
    let f = cg_expr(p, env, init.n, f_e);
    let acc_ty = cg_llvm_ty(init.ty);
    let len = cg_reg(f.n);
    let acc = cg_reg(f.n + 1);
    let iv = cg_reg(f.n + 2);
    let lp = cg_array_loop(iv, len, f.n + 3);
    let b = lp.body_n;
    let ev = cg_reg(b + 3);
    let cur_acc = cg_reg(b + 4);
    let body = cg_elem_ptr_lines(a.val, lp.idx_reg, b)
        .concat("  ").concat(ev).concat(" = load ").concat(cg_llvm_ty(elem)).concat(", ptr ").concat(cg_elem_ptr_reg(b)).concat("\n")
        .concat("  ").concat(cur_acc).concat(" = load ").concat(acc_ty).concat(", ptr ").concat(acc).concat("\n")
        // Both operands are consumed by the closure. The accumulator
        // slot's own reference is replaced by the result immediately
        // below, so it is released rather than incremented.
        .concat(cg_inc(elem, ev))
        .concat(cg_invoke(f.val, init.ty, ", ".concat(acc_ty).concat(" ").concat(cur_acc).concat(", ").concat(cg_llvm_ty(elem)).concat(" ").concat(ev), b + 5))
        .concat("  store ").concat(acc_ty).concat(" ").concat(cg_reg(b + 6)).concat(", ptr ").concat(acc).concat("\n");
    let out = cg_reg(b + 7);
    let code = a.code.concat(init.code).concat(f.code)
        .concat("  ").concat(len).concat(" = call i64 @plum_array_len(ptr ").concat(a.val).concat(")\n")
        .concat("  store ").concat(acc_ty).concat(" ").concat(init.val).concat(", ptr ").concat(acc).concat("\n")
        .concat(lp.pre).concat(body).concat(lp.post)
        .concat("  ").concat(out).concat(" = load ").concat(acc_ty).concat(", ptr ").concat(acc).concat("\n")
        // Both operands arrived OWNED (`cg_expr`, not `cg_borrow`), so
        // both are this call's to release. Neither was, which leaked
        // the source array and the closure cell on every
        // `Array.map`/`filter`/`fold` -- invisible when an array is
        // used once, real the moment one is folded over twice.
        .concat(cg_dec(cg_concrete(p, typecheck.texpr_ty(p.subst, arr_e)), a.val))
        .concat(cg_dec_cg(f.ty, f.val));
    Emit {
        code: code,
        allocas: "  ".concat(iv).concat(" = alloca i64\n").concat("  ").concat(acc).concat(" = alloca ").concat(acc_ty).concat("\n").concat(a.allocas).concat(init.allocas).concat(f.allocas), releases: a.releases.concat(init.releases).concat(f.releases),
        globals: a.globals.concat(init.globals).concat(f.globals), val: out, ty: init.ty, n: b + 8,
    }
}

// --- Structs, enums, and pattern matching ---

// A tuple literal. Identical to a struct literal minus the declaration
// lookup: elements are already in order, so their index IS their slot.
let cg_tuple_lit (p: CgProgram) (env: Array[CgSlot]) (n: Int) (elems: Array[typecheck.TExpr]) (ty: CgTy): Emit = {
    let cell = cg_reg(n);
    let head = "  ".concat(cell).concat(" = call ptr @plum_alloc(i64 ").concat((8 + 8 * elems.len()).to_string()).concat(")\n");
    let f = cg_store_tuple(p, env, n + 1, cell, elems, 0, "", "", "", "");
    Emit { code: head.concat(f.code), allocas: f.allocas, releases: f.releases, globals: f.globals, val: cell, ty: ty, n: f.n }
}

let cg_store_tuple (p: CgProgram) (env: Array[CgSlot]) (n: Int) (cell: String) (elems: Array[typecheck.TExpr]) (i: Int) (code: String) (allocas: String) (releases: String) (globals: String): FieldsEmit =
    if i >= elems.len() { FieldsEmit { code: code, allocas: allocas, releases: releases, globals: globals, n: n } }
    else {
        let r = cg_expr(p, env, n, elems[i]);
        let fp = cg_reg(r.n);
        let line = "  ".concat(fp).concat(" = getelementptr i8, ptr ").concat(cell).concat(", i64 ").concat(cg_field_offset(i).to_string()).concat("\n")
            .concat("  store ").concat(cg_llvm_ty(r.ty)).concat(" ").concat(r.val).concat(", ptr ").concat(fp).concat("\n");
        cg_store_tuple(p, env, r.n + 1, cell, elems, i + 1, code.concat(r.code).concat(line), allocas.concat(r.allocas), releases.concat(r.releases), globals.concat(r.globals))
    }

// A struct literal: allocate the cell, then store each field at its
// declared index. Fields are stored in DECLARATION order regardless of
// the order they were written in the literal, which is what makes a
// field read a fixed offset.
// The cell is allocated AFTER every field value and the spread base
// have been computed, not before. Nothing about the emitted code
// depends on the order -- LLVM sees the same stores either way -- but
// the ORDER is what makes reuse expressible: a cell can only be handed
// over to a literal once everything that reads the old one has read it.
// Allocating first, as this did, meant the answer to "is there a dead
// cell of the right size here?" was always "not yet".
let cg_struct_lit (p: CgProgram) (env: Array[CgSlot]) (n: Int) (name: String) (fields: Array[typecheck.TFieldInit]) (spread: Option[typecheck.TExpr]): Emit = {
    let field_names = typecheck.ctx_field_names(p.ctx, name);
    let ev = cg_eval_fields(p, env, field_names, fields, 0,
        EvalFields { code: "", allocas: "", releases: "", globals: "", vals: [], n: n });
    match spread {
        None => {
            let cell = cg_reg(ev.n);
            let st = cg_store_evald(cell, ev.vals, 0, ev.n + 1, "");
            Emit { code: ev.code.concat(cg_cell_alloc(cell, field_names.len())).concat(st.code),
                allocas: ev.allocas, releases: ev.releases, globals: ev.globals,
                val: cell, ty: CgStruct(name), n: st.n }
        },
        // `..base` fills in every position the literal did not mention.
        // The base is evaluated ONCE, each copied field is incremented
        // as it is stored -- the new cell owns its own reference to a
        // shared field, exactly as if it had been written out -- and the
        // base is then released.
        Some(base) => {
            let b = cg_expr(p, env, ev.n, base);
            let ity = cg_concrete(p, typecheck.texpr_ty(p.subst, base));
            let cell = cg_reg(b.n);
            let st = cg_store_evald(cell, ev.vals, 0, b.n + 1, "");
            let copies = cg_copy_missing_fields(p, field_names, cg_struct_field_itys(p, ity, name), fields, cell, b.val, 0, st.n, "");
            Emit {
                code: ev.code.concat(b.code).concat(cg_cell_alloc(cell, field_names.len())).concat(st.code)
                    .concat(copies.code).concat(cg_dec(ity, b.val)),
                allocas: ev.allocas.concat(b.allocas), releases: ev.releases.concat(b.releases), globals: ev.globals.concat(b.globals),
                val: cell, ty: CgStruct(name), n: copies.n,
            }
        },
    }
}

let cg_cell_alloc (cell: String) (nfields: Int): String =
    "  ".concat(cell).concat(" = call ptr @plum_alloc(i64 ").concat((8 + 8 * nfields).to_string()).concat(")\n")

// A struct literal that may RECYCLE a dead local's cell instead of
// allocating one.
//
// Eligibility is decided here rather than in the pass, because it is a
// question about REPRESENTATION -- how big the old cell is, and what it
// holds -- and the pass deals in names. A candidate that does not
// qualify falls back to an ordinary literal, so proposing one costs
// nothing.
let cg_struct_reuse (p: CgProgram) (env: Array[CgSlot]) (n: Int) (name: String) (fields: Array[typecheck.TFieldInit]) (cands: Array[String]): Emit = {
    let field_names = typecheck.ctx_field_names(p.ctx, name);
    let want = 8 + 8 * field_names.len();
    match cg_first_reuse_cand(p, env, cands, 0, want) {
        None => cg_struct_lit(p, env, n, name, fields, None),
        Some(c) => {
            let ev = cg_eval_fields(p, env, field_names, fields, 0,
                EvalFields { code: "", allocas: "", releases: "", globals: "", vals: [], n: n });
            let r = cg_reuse_cell(p, c, want, ev.n);
            let st = cg_store_evald(r.cell, ev.vals, 0, r.n, "");
            Emit { code: ev.code.concat(r.code).concat(st.code),
                allocas: ev.allocas, releases: ev.releases, globals: ev.globals,
                val: r.cell, ty: CgStruct(name), n: st.n }
        },
    }
}

// A candidate that can stand in for a fresh cell of `want` bytes, with
// the children the reuse path will have to drop.
//
// A cell qualifies when it is at least as big. It does NOT have to be
// free of references any more: the reuse path releases the old cell's
// children inline before overwriting them, and the giveup path releases
// the whole cell through its own generated release function, so both
// answers are type-correct. That is what making the runtime helper a
// PREDICATE rather than an allocator bought.
//
// Structs and enums both qualify whether or not they hold references;
// they differ only in HOW the old children are dropped. A struct's
// layout is fixed, so its drops are emitted inline -- three
// instructions per heap field, at the sites that actually reuse. An
// enum's depend on its runtime TAG, so it delegates to a generated
// companion (`cg_emit_relc_fn`) rather than inlining a whole switch
// everywhere.
//
// Arrays are excluded outright -- an array cell carries a length and a
// capacity as well as its elements, none of which this contract covers.
// `children` are dropped INLINE on the reuse path; `drop_sym`, when it
// is not empty, names a generated function that does the dropping
// instead. Exactly one of the two is ever non-empty -- structs use the
// first because their layout is fixed, enums the second because theirs
// depends on a runtime tag.
struct ReuseCand { slot: CgSlot, children: Array[typecheck.ITy], drop_sym: String, bytes: Int }

let cg_first_reuse_cand (p: CgProgram) (env: Array[CgSlot]) (cands: Array[String]) (i: Int) (want: Int): Option[ReuseCand] =
    if i >= cands.len() { None }
    else {
        match cg_reuse_cand(p, env, cands[i], want) {
            Some(c) => Some(c),
            None => cg_first_reuse_cand(p, env, cands, i + 1, want),
        }
    }

// A name the concat move already claimed is left to it. Nothing can be
// both today -- that one takes a String base, this one takes a struct
// or an enum -- but "nothing can be both" is a fact about two other
// functions, and it is cheaper to enforce it here than to notice later
// that one of them changed.
let cg_reuse_cand (p: CgProgram) (env: Array[CgSlot]) (cand: String) (want: Int): Option[ReuseCand] =
    if cg_rc_enabled(()) && !cg_is_movable(p, cand) {
        match cg_lookup(env, cand) {
            None => None,
            Some(slot) => cg_reuse_of_ity(p, slot, cg_concrete(p, slot.ity), want),
        }
    } else { None }

let cg_reuse_of_ity (p: CgProgram) (slot: CgSlot) (ity: typecheck.ITy) (want: Int): Option[ReuseCand] =
    match ity {
        ITStruct(sname, args) =>
            if sname == "Array" { None }
            // A handle cell is never recycled INTO. Its one word is a
            // shim handle, not a field, and dropping it means telling
            // the shim -- which the generic child-drop cannot do.
            else if cg_is_handle_name(sname) { None }
            else {
                let bytes = 8 + 8 * typecheck.ctx_field_names(p.ctx, sname).len();
                if bytes >= want {
                    // Instantiated exactly the way `cg_emit_rel_fn` does
                    // it, so a generic struct's children are the same
                    // types its release function would walk.
                    Some(ReuseCand { slot: slot, bytes: bytes, drop_sym: "",
                        children: Array.map(typecheck.ctx_field_types(p.ctx, sname),
                            |ft| typecheck.instantiate_template(typecheck.ctx_struct_generics(p.ctx, sname), args, ft)) })
                } else { None }
            },
        ITEnum(ename, args) =>
            if cg_enum_cell_size(p, ename) >= want {
                // An enum that owns nothing needs no drop at all; one
                // that does gets its generated companion, which is the
                // tag switch this site would otherwise have to inline.
                Some(ReuseCand { slot: slot, bytes: cg_enum_cell_size(p, ename), children: [],
                    drop_sym: if cg_enum_owns(p, cg_find_enum(p, ename).variants, args, 0) { cg_relc_sym(ity) } else { "" } })
            } else { None },
        _ => None,
    }

let cg_all_plain (tys: Array[typecheck.ITy]) (i: Int): Bool =
    if i >= tys.len() { true }
    else if cg_is_heap(cg_of_ity(tys[i])) { false }
    else { cg_all_plain(tys, i + 1) }

struct ReuseEmit { code: String, cell: String, n: Int }

// The cell to build into: the candidate's own, or a fresh one.
//
// The candidate is MOVED out of its slot first -- load, then store null
// back -- which is what makes the refcount the helper reads mean
// "nobody else can see this". Nulling is also what removes the need for
// any path analysis of the move: the slot's release at function exit
// still runs and is null-safe, so it becomes a no-op on exactly the
// paths where the reference left.
//
// Both arms release the old cell, and both are type-correct. The reuse
// arm drops its CHILDREN, because the stores that follow are about to
// overwrite them and nothing else holds them. The giveup arm releases
// the WHOLE cell through its generated release function, which
// decrements and, if that was the last reference, drops the children
// and frees.
//
// The new field values were computed BEFORE any of this, and each took
// its own reference -- `cg_field_read` increments what it loads -- so a
// field copied straight across, `name: e.name`, survives its old cell's
// drop. Inc-before-dec, obtained by ordering rather than by care.
let cg_reuse_cell (p: CgProgram) (c: ReuseCand) (want: Int) (n: Int): ReuseEmit = {
    let old = cg_reg(n);
    let ok = cg_reg(n + 1);
    let lr = cg_label(n + 2);
    let lf = cg_label(n + 3);
    let lj = cg_label(n + 4);
    let fresh = cg_reg(n + 5);
    let cell = cg_reg(n + 6);
    let drops = cg_reuse_drops(c.children, old, 0, n + 7, "");
    ReuseEmit {
        code: "  ".concat(old).concat(" = load ptr, ptr ").concat(c.slot.ptr).concat("\n")
            .concat("  store ptr null, ptr ").concat(c.slot.ptr).concat("\n")
            .concat("  ").concat(ok).concat(" = call i1 @plum_reuse_ok(ptr ").concat(old).concat(", i64 ").concat(want.to_string()).concat(")\n")
            .concat("  br i1 ").concat(ok).concat(", label %").concat(lr).concat(", label %").concat(lf).concat("\n")
            .concat(lr).concat(":\n").concat(cg_reuse_drop_code(c, old, drops.code))
            .concat("  br label %").concat(lj).concat("\n")
            .concat(lf).concat(":\n")
            .concat(cg_dec(cg_concrete(p, c.slot.ity), old))
            .concat("  ").concat(fresh).concat(" = call ptr @plum_alloc(i64 ").concat(want.to_string()).concat(")\n")
            .concat("  br label %").concat(lj).concat("\n")
            .concat(lj).concat(":\n")
            .concat("  ").concat(cell).concat(" = phi ptr [ ").concat(old).concat(", %").concat(lr).concat(" ], [ ").concat(fresh).concat(", %").concat(lf).concat(" ]\n"),
        cell: cell, n: drops.n,
    }
}

// Loads each owned child of the cell being recycled and releases it --
// the same walk `cg_rel_children` does inside a generated release
// function, emitted inline here because it sits under a branch that
// function does not have.
// One of the two drop shapes, never both.
let cg_reuse_drop_code (c: ReuseCand) (old: String) (inline: String): String =
    if c.drop_sym == "" { inline }
    else { "  call void ".concat(c.drop_sym).concat("(ptr ").concat(old).concat(")\n") }

let cg_reuse_drops (tys: Array[typecheck.ITy]) (old: String) (i: Int) (n: Int) (acc: String): CopyEmit =
    if i >= tys.len() { CopyEmit { code: acc, n: n } }
    else if !cg_is_heap(cg_of_ity(tys[i])) { cg_reuse_drops(tys, old, i + 1, n, acc) }
    else {
        let fp = cg_reg(n);
        let fv = cg_reg(n + 1);
        cg_reuse_drops(tys, old, i + 1, n + 2, acc
            .concat("  ").concat(fp).concat(" = getelementptr i8, ptr ").concat(old).concat(", i64 ").concat(cg_field_offset(i).to_string()).concat("\n")
            .concat("  ").concat(fv).concat(" = load ptr, ptr ").concat(fp).concat("\n")
            .concat("  call void ").concat(cg_rel_sym(tys[i])).concat("(ptr ").concat(fv).concat(")\n"))
    }

// `Count(k + 1)` recycling the cell `c` that `k` was matched out of.
// The enum case needs no reordering the way the struct case did:
// `cg_variant_build` already evaluates its arguments before it
// allocates, so the move slots straight in between.
//
// Payload slots the NEW variant does not use keep whatever the old one
// left there, which is unreadable -- a payload is only ever loaded
// under a matching tag -- and harmless, because a qualifying enum holds
// no references at all.
let cg_variant_reuse (p: CgProgram) (env: Array[CgSlot]) (n: Int) (ename: String) (tag: String) (args: Array[typecheck.TExpr]) (cands: Array[String]): Emit =
    match cg_variant_of(p, ename, tag) {
        None => { cg_fail("internal: unknown variant reached codegen: ".concat(tag)); cg_unit_emit(n) },
        Some(v) => {
            let a = cg_args(p, env, n, args, 0, "", "", "", "", []);
            let want = cg_enum_cell_size(p, v.enum_name);
            match cg_first_reuse_cand(p, env, cands, 0, want) {
                None => cg_variant_build(p, v, a),
                Some(c) => cg_variant_build_reuse(p, v, a, c, want),
            }
        },
    }

let cg_variant_build_reuse (p: CgProgram) (v: CgVariant) (a: ArgVals) (c: ReuseCand) (want: Int): Emit = {
    let enum_name = v.enum_name;
    let r = cg_reuse_cell(p, c, want, a.n);
    let tagged = "  ".concat(r.cell).concat("_t = getelementptr i8, ptr ").concat(r.cell).concat(", i64 ").concat(cg_tag_offset(()).to_string()).concat("\n")
        .concat("  store i64 ").concat(v.tag.to_string()).concat(", ptr ").concat(r.cell).concat("_t\n");
    let stores = cg_store_payload(r.cell, a.vals, 0, r.n, "");
    Emit { code: a.code.concat(r.code).concat(tagged).concat(stores.code),
        allocas: a.allocas, releases: a.releases, globals: a.globals,
        val: r.cell, ty: CgEnum(enum_name), n: stores.n }
}

struct CopyEmit { code: String, n: Int }

// Every declared field the literal did not mention, loaded from the
// spread base and stored into the new cell -- with an increment for any
// heap-shaped one, because both cells now point at it.
let cg_copy_missing_fields (p: CgProgram) (field_names: Array[String]) (field_itys: Array[typecheck.ITy]) (given: Array[typecheck.TFieldInit]) (cell: String) (base: String) (i: Int) (n: Int) (acc: String): CopyEmit =
    if i >= field_names.len() { CopyEmit { code: acc, n: n } }
    else if cg_field_given(given, field_names[i], 0) { cg_copy_missing_fields(p, field_names, field_itys, given, cell, base, i + 1, n, acc) }
    else {
        let fty = if i < field_itys.len() { field_itys[i] } else { ITUnit };
        let lty = cg_llvm_ty(cg_of_ity(fty));
        let sp = cg_reg(n);
        let v = cg_reg(n + 1);
        let dp = cg_reg(n + 2);
        let line = "  ".concat(sp).concat(" = getelementptr i8, ptr ").concat(base).concat(", i64 ").concat(cg_field_offset(i).to_string()).concat("\n")
            .concat("  ").concat(v).concat(" = load ").concat(lty).concat(", ptr ").concat(sp).concat("\n")
            .concat(cg_inc(cg_of_ity(fty), v))
            .concat("  ").concat(dp).concat(" = getelementptr i8, ptr ").concat(cell).concat(", i64 ").concat(cg_field_offset(i).to_string()).concat("\n")
            .concat("  store ").concat(lty).concat(" ").concat(v).concat(", ptr ").concat(dp).concat("\n");
        cg_copy_missing_fields(p, field_names, field_itys, given, cell, base, i + 1, n + 3, acc.concat(line))
    }

let cg_field_given (given: Array[typecheck.TFieldInit]) (name: String) (i: Int): Bool =
    if i >= given.len() { false } else if given[i].name == name { true } else { cg_field_given(given, name, i + 1) }

let cg_struct_field_itys (p: CgProgram) (ity: typecheck.ITy) (name: String): Array[typecheck.ITy] =
    Array.map(typecheck.ctx_field_types(p.ctx, name), |ft| typecheck.instantiate_template(typecheck.ctx_struct_generics(p.ctx, name), cg_ity_args(ity), ft))

struct FieldsEmit { code: String, allocas: String, releases: String, globals: String, n: Int }

// A field value already computed into a register, waiting to be stored.
// Splitting EVALUATION from STORING is the whole point: the two used to
// be one recursive walk that computed a value and immediately wrote it
// into a cell that therefore had to exist already.
struct EvaldField { idx: Int, lty: String, val: String }

struct EvalFields { code: String, allocas: String, releases: String, globals: String, vals: Array[EvaldField], n: Int }

let cg_eval_fields (p: CgProgram) (env: Array[CgSlot]) (field_names: Array[String]) (fields: Array[typecheck.TFieldInit]) (i: Int) (acc: EvalFields): EvalFields =
    if i >= fields.len() { acc }
    else {
        let r = cg_expr(p, env, acc.n, fields[i].value);
        cg_eval_fields(p, env, field_names, fields, i + 1,
            EvalFields { code: acc.code.concat(r.code), allocas: acc.allocas.concat(r.allocas),
                releases: acc.releases.concat(r.releases), globals: acc.globals.concat(r.globals),
                vals: acc.vals.push(EvaldField { idx: cg_field_index(field_names, fields[i].name, 0), lty: cg_llvm_ty(r.ty), val: r.val }),
                n: r.n })
    }

let cg_store_evald (cell: String) (vals: Array[EvaldField]) (i: Int) (n: Int) (acc: String): CopyEmit =
    if i >= vals.len() { CopyEmit { code: acc, n: n } }
    else {
        let fp = cg_reg(n);
        let line = "  ".concat(fp).concat(" = getelementptr i8, ptr ").concat(cell).concat(", i64 ").concat(cg_field_offset(vals[i].idx).to_string()).concat("\n")
            .concat("  store ").concat(vals[i].lty).concat(" ").concat(vals[i].val).concat(", ptr ").concat(fp).concat("\n");
        cg_store_evald(cell, vals, i + 1, n + 1, acc.concat(line))
    }

// `ref(v)`: a two-word cell, `{ i64 refcount, i64 value }`. The value
// is stored in its NATURAL machine type at offset 8, exactly the way
// an array element or a struct field is — no i64 punning, and no tag,
// since a `Ref` is never pattern-matched. `@plum_alloc` already
// installs the refcount of 1.
//
// The value is stored OWNED: `cg_expr` hands back a value the caller
// owns, and the cell takes that reference over rather than retaining
// a second one.
let cg_ref_new (p: CgProgram) (env: Array[CgSlot]) (n: Int) (inner: typecheck.TExpr): Emit = {
    let r = cg_expr(p, env, n, inner);
    let cell = cg_reg(r.n);
    let vp = cg_reg(r.n + 1);
    let code = r.code
        .concat("  ").concat(cell).concat(" = call ptr @plum_alloc(i64 16)\n")
        .concat("  ").concat(vp).concat(" = getelementptr i8, ptr ").concat(cell).concat(", i64 8\n")
        .concat("  store ").concat(cg_llvm_ty(r.ty)).concat(" ").concat(r.val).concat(", ptr ").concat(vp).concat("\n");
    Emit { code: code, allocas: r.allocas, releases: r.releases, globals: r.globals, val: cell, ty: CgRef(r.ty), n: r.n + 2 }
}

// `r.get()`: borrow the cell, load the value, and RETAIN it — the
// caller receives an owned value while the cell keeps its own
// reference. Same shape as `cg_field_read`, for the same reason.
let cg_ref_get (p: CgProgram) (env: Array[CgSlot]) (n: Int) (base: typecheck.TExpr): Emit = {
    let b = cg_borrow(p, env, n, base);
    match b.ty {
        CgRef(inner) => {
            let vp = cg_reg(b.n);
            let out = cg_reg(b.n + 1);
            let code = b.code
                .concat("  ").concat(vp).concat(" = getelementptr i8, ptr ").concat(b.val).concat(", i64 8\n")
                .concat("  ").concat(out).concat(" = load ").concat(cg_llvm_ty(inner)).concat(", ptr ").concat(vp).concat("\n")
                .concat(cg_inc(inner, out))
                .concat(b.drop);
            Emit { code: code, allocas: b.allocas, releases: b.releases, globals: b.globals, val: out, ty: inner, n: b.n + 2 }
        },
        _ => { cg_fail(".get() on a value that isn't a Ref"); cg_unit_emit(b.n) },
    }
}

// `r.set(v)`: store IN PLACE, which is the entire point of `Ref` and
// the one way it differs from `Array.set` (which copies). The value
// being overwritten owned a reference, so it is released first.
let cg_ref_set (p: CgProgram) (env: Array[CgSlot]) (n: Int) (base: typecheck.TExpr) (value: typecheck.TExpr): Emit = {
    let b = cg_borrow(p, env, n, base);
    let v = cg_expr(p, env, b.n, value);
    let vp = cg_reg(v.n);
    let old = cg_reg(v.n + 1);
    let code = b.code.concat(v.code)
        .concat("  ").concat(vp).concat(" = getelementptr i8, ptr ").concat(b.val).concat(", i64 8\n")
        .concat("  ").concat(old).concat(" = load ").concat(cg_llvm_ty(v.ty)).concat(", ptr ").concat(vp).concat("\n")
        .concat(cg_dec(cg_concrete(p, typecheck.texpr_ty(p.subst, value)), old))
        .concat("  store ").concat(cg_llvm_ty(v.ty)).concat(" ").concat(v.val).concat(", ptr ").concat(vp).concat("\n")
        .concat(b.drop);
    Emit {
        code: code, allocas: b.allocas.concat(v.allocas), releases: b.releases.concat(v.releases),
        globals: b.globals.concat(v.globals), val: "0", ty: CgUnit, n: v.n + 2,
    }
}

let cg_field_read (p: CgProgram) (env: Array[CgSlot]) (n: Int) (base: typecheck.TExpr) (name: String) (fty: CgTy): Emit = {
    let b = cg_borrow(p, env, n, base);
    match b.ty {
        CgStruct(sname) => {
            let base_ity = cg_concrete(p, typecheck.texpr_ty(p.subst, base));
            let idx = cg_field_index(typecheck.ctx_field_names(p.ctx, sname), name, 0);
            let fp = cg_reg(b.n);
            let out = cg_reg(b.n + 1);
            let code = b.code
                .concat("  ").concat(fp).concat(" = getelementptr i8, ptr ").concat(b.val).concat(", i64 ").concat(cg_field_offset(idx).to_string()).concat("
")
                .concat("  ").concat(out).concat(" = load ").concat(cg_llvm_ty(fty)).concat(", ptr ").concat(fp).concat("\n")
                .concat(cg_inc(fty, out))
                .concat(b.drop);
            Emit { code: code, allocas: b.allocas, releases: b.releases, globals: b.globals, val: out, ty: fty, n: b.n + 2 }
        },
        _ => { cg_fail("field access on a non-struct value: .".concat(name)); cg_unit_emit(b.n) },
    }
}

// A variant constructor call, `Circle(2)`. The cell is sized for the
// enum's WIDEST variant, not this one — see `cg_payload_offset`.
let cg_variant_call (p: CgProgram) (env: Array[CgSlot]) (n: Int) (ename: String) (tag: String) (args: Array[typecheck.TExpr]): Emit =
    match cg_variant_of(p, ename, tag) {
        Some(v) => cg_variant_build(p, v, cg_args(p, env, n, args, 0, "", "", "", "", [])),
        None => { cg_fail("internal: unknown variant reached codegen: ".concat(tag)); cg_unit_emit(n) },
    }

let cg_variant_build (p: CgProgram) (v: CgVariant) (a: ArgVals): Emit = {
    let enum_name = v.enum_name;
    let cell = cg_reg(a.n);
    let head = "  ".concat(cell).concat(" = call ptr @plum_alloc(i64 ").concat(cg_enum_cell_size(p, enum_name).to_string()).concat(")\n")
        .concat("  ").concat(cell).concat("_t = getelementptr i8, ptr ").concat(cell).concat(", i64 ").concat(cg_tag_offset(()).to_string()).concat("\n")
        .concat("  store i64 ").concat(v.tag.to_string()).concat(", ptr ").concat(cell).concat("_t\n");
    let stores = cg_store_payload(cell, a.vals, 0, a.n + 1, "");
    Emit { code: a.code.concat(head).concat(stores.code), allocas: a.allocas, releases: a.releases,globals: a.globals, val: cell, ty: CgEnum(enum_name), n: stores.n }
}

struct StoreEmit { code: String, n: Int }

// `vals` entries are already `<llvm-ty> <operand>` pairs, which is
// exactly the form a `store` needs.
let cg_store_payload (cell: String) (vals: Array[String]) (i: Int) (n: Int) (acc: String): StoreEmit =
    if i >= vals.len() { StoreEmit { code: acc, n: n } }
    else {
        let pp = cg_reg(n);
        let line = "  ".concat(pp).concat(" = getelementptr i8, ptr ").concat(cell).concat(", i64 ").concat(cg_payload_offset(i).to_string()).concat("
")
            .concat("  store ").concat(vals[i]).concat(", ptr ").concat(pp).concat("
");
        cg_store_payload(cell, vals, i + 1, n + 1, acc.concat(line))
    }

// --- match ---
//
// Arms are tried in order: each gets a TEST block that computes an `i1`
// and branches either to its own body or to the next arm's test. One
// result slot, one merge block, exactly like `if` — because that is all
// a `match` is once the pattern tests are compiled out.
//
// A scrutinee that matches NO arm falls through to a block that returns
// the zero value of the result type. The real compiler proves
// exhaustiveness and this one does not, so this is a deliberate,
// documented v1 gap rather than a silent one: an inexhaustive `match`
// produces a defined-but-meaningless value instead of a diagnostic.
let cg_match (p: CgProgram) (env: Array[CgSlot]) (n: Int) (scrutinee: typecheck.TExpr) (arms: Array[typecheck.TArm]) (body_ty: CgTy): Emit = {
    let sity = cg_concrete(p, typecheck.texpr_ty(p.subst, scrutinee));
    // The arms only READ the scrutinee — every binding takes its own
    // reference in the arm body — so matching on a variable borrows it.
    let sc = cg_borrow(p, env, n, scrutinee);
    let slot = cg_reg(sc.n);
    let end_label = cg_label(sc.n + 1);
    let fail_label = cg_label(sc.n + 2);
    let lty = cg_llvm_ty(body_ty);
    let a = cg_match_arms(p, env, sc.n + 3, arms, 0, sc.val, sity, slot, lty, end_label, fail_label, "", "", "", "");
    let res = cg_reg(a.n);
    let code = sc.code
        .concat("  br label %").concat(cg_label(sc.n + 3)).concat("
")
        .concat(a.code)
        .concat(fail_label).concat(":
")
        .concat("  store ").concat(lty).concat(" ").concat(cg_zero_of(body_ty)).concat(", ptr ").concat(slot).concat("
")
        .concat("  br label %").concat(end_label).concat("
")
        .concat(end_label).concat(":
")
        .concat("  ").concat(res).concat(" = load ").concat(lty).concat(", ptr ").concat(slot).concat("\n")
        // The scrutinee was an owned temporary; the arms borrowed from
        // it and any bindings took their own references, so it is done.
        .concat(sc.drop);
    Emit {
        code: code,
        allocas: "  ".concat(slot).concat(" = alloca ").concat(lty).concat("\n").concat(sc.allocas).concat(a.allocas), releases: sc.releases.concat(a.releases),
        globals: sc.globals.concat(a.globals), val: res, ty: body_ty, n: a.n + 1,
    }
}

// `select { v = rx => .., w = ry => .. }`.
//
// Every arm's RECEIVER is evaluated first, in order and exactly once,
// then their handles go into one stack array and `@channel_select`
// blocks until one of them has a value. It comes back as the winning
// arm's INDEX plus the boxed payload, so the only thing left here is a
// `switch` into that arm's block -- which is why none of the waiting
// logic is in this file.
//
// The result is merged through a stack slot rather than a `phi`, the
// same way `cg_match` merges its arms.
let cg_select (p: CgProgram) (env: Array[CgSlot]) (n: Int) (arms: Array[typecheck.TSelectArm]) (body_ty: CgTy): Emit = {
    let hs = cg_reg(n);
    let outp = cg_reg(n + 1);
    let slot = cg_reg(n + 2);
    let idx = cg_reg(n + 3);
    let box = cg_reg(n + 4);
    let end_label = cg_label(n + 5);
    let fail_label = cg_label(n + 6);
    let lty = cg_llvm_ty(body_ty);
    let c = cg_select_chans(p, env, n + 7, arms, 0, hs, "", "", "", "");
    let a = cg_select_arms(p, env, c.n, arms, 0, c.n, box, slot, lty, end_label, "", "", "", "");
    let res = cg_reg(a.n);
    Emit {
        code: c.code
            .concat("  ").concat(idx).concat(" = call i64 @channel_select(ptr ").concat(hs).concat(", i64 ").concat(arms.len().to_string()).concat(", ptr ").concat(outp).concat(")\n")
            .concat("  ").concat(box).concat(" = load ptr, ptr ").concat(outp).concat("\n")
            .concat("  switch i64 ").concat(idx).concat(", label %").concat(fail_label).concat(" [\n")
            .concat(cg_select_cases(arms, 0, c.n, ""))
            .concat("  ]\n")
            .concat(a.code)
            // Unreachable in practice: `@channel_select` only returns
            // an index it was given, and a `select` with no arms is
            // rejected by the checker. It exists because a `switch`
            // needs a default and a block needs a terminator.
            .concat(fail_label).concat(":\n")
            .concat("  store ").concat(lty).concat(" ").concat(cg_zero_of(body_ty)).concat(", ptr ").concat(slot).concat("\n")
            .concat("  br label %").concat(end_label).concat("\n")
            .concat(end_label).concat(":\n")
            .concat("  ").concat(res).concat(" = load ").concat(lty).concat(", ptr ").concat(slot).concat("\n"),
        allocas: "  ".concat(hs).concat(" = alloca i64, i64 ").concat(arms.len().to_string()).concat("\n")
            .concat("  ").concat(outp).concat(" = alloca ptr\n")
            .concat("  ").concat(slot).concat(" = alloca ").concat(lty).concat("\n")
            .concat(c.allocas).concat(a.allocas),
        releases: c.releases.concat(a.releases), globals: c.globals.concat(a.globals),
        val: res, ty: body_ty, n: a.n + 1,
    }
}

// Each arm's receiver, evaluated in order, its handle stored into the
// array `@channel_select` reads.
let cg_select_chans (p: CgProgram) (env: Array[CgSlot]) (n: Int) (arms: Array[typecheck.TSelectArm]) (i: Int) (hs: String) (code: String) (allocas: String) (releases: String) (globals: String): FieldsEmit =
    if i >= arms.len() { FieldsEmit { code: code, allocas: allocas, releases: releases, globals: globals, n: n } }
    else {
        let r = cg_expr(p, env, n, arms[i].chan);
        let ep = hs.concat("_h").concat(i.to_string());
        let line = cg_handle_load(cg_reg(r.n), r.val)
            .concat("  ").concat(ep).concat(" = getelementptr i8, ptr ").concat(hs).concat(", i64 ").concat((8 * i).to_string()).concat("\n")
            .concat("  store i64 ").concat(cg_reg(r.n)).concat(", ptr ").concat(ep).concat("\n")
            .concat(cg_dec(cg_concrete(p, typecheck.texpr_ty(p.subst, arms[i].chan)), r.val));
        cg_select_chans(p, env, r.n + 1, arms, i + 1, hs, code.concat(r.code).concat(line),
            allocas.concat(r.allocas), releases.concat(r.releases), globals.concat(r.globals))
    }

let cg_select_cases (arms: Array[typecheck.TSelectArm]) (i: Int) (base: Int) (acc: String): String =
    if i >= arms.len() { acc }
    else { cg_select_cases(arms, i + 1, base, acc.concat("    i64 ").concat(i.to_string()).concat(", label %").concat(cg_select_label(base, i)).concat("\n")) }

// Arm blocks are labelled off a base the caller already knows, so a
// `switch` can name a block that has not been emitted yet.
let cg_select_label (base: Int) (i: Int): String = cg_label(base).concat("_s").concat(i.to_string())

let cg_select_arms (p: CgProgram) (env: Array[CgSlot]) (n: Int) (arms: Array[typecheck.TSelectArm]) (i: Int) (base: Int) (box: String) (slot: String) (lty: String) (end_label: String) (code: String) (allocas: String) (releases: String) (globals: String): FieldsEmit =
    if i >= arms.len() { FieldsEmit { code: code, allocas: allocas, releases: releases, globals: globals, n: n } }
    else {
        // The payload's type is the RECEIVER's type argument, and each
        // arm has its own, which is the whole reason the unboxing load
        // lives in the arm's block rather than before the switch.
        let elem = cg_array_elem_ity(p, typecheck.texpr_ty(p.subst, arms[i].chan));
        let vty = cg_of_ity(elem);
        let v = cg_reg(n);
        let pat = cg_pattern(p, env, n + 1, arms[i].pattern, v, elem);
        let b = cg_expr(p, pat.env, pat.n, arms[i].body);
        let this_code = cg_select_label(base, i).concat(":\n")
            .concat("  ").concat(v).concat(" = load ").concat(cg_llvm_ty(vty)).concat(", ptr ").concat(box).concat("\n")
            .concat("  call void @free(ptr ").concat(box).concat(")\n")
            .concat(pat.code).concat(pat.binds)
            // The value arrived OWNED -- the sender transferred its
            // reference into the box -- and the binding took its own,
            // so this call's is spent. Same accounting as a `let`.
            .concat(cg_dec(elem, v))
            .concat(b.code)
            .concat("  store ").concat(lty).concat(" ").concat(b.val).concat(", ptr ").concat(slot).concat("\n")
            .concat("  br label %").concat(end_label).concat("\n");
        cg_select_arms(p, env, b.n, arms, i + 1, base, box, slot, lty, end_label,
            code.concat(this_code), allocas.concat(pat.allocas).concat(b.allocas),
            releases.concat(pat.releases).concat(b.releases), globals.concat(pat.globals).concat(b.globals))
    }

let cg_zero_of (t: CgTy): String =
    match t {
        CgInt => "0",
        CgFloat => "0.0",
        CgBool => "0",
        CgUnit => "0",
        CgStr => "null",
        CgCStr => "null",
        CgStruct(_) => "null",
        CgEnum(_) => "null",
        CgArray(_) => "null",
        CgRef(_) => "null",
        CgClosure(_, _) => "null",
        CgTuple(_) => "null",
        CgHandle(_) => "null",
    }

struct ArmsEmit { code: String, allocas: String, releases: String,globals: String, n: Int }

let cg_match_arms (p: CgProgram) (env: Array[CgSlot]) (n: Int) (arms: Array[typecheck.TArm]) (i: Int) (sval: String) (sity: typecheck.ITy) (slot: String) (lty: String) (end_label: String) (fail_label: String) (code: String) (allocas: String) (releases: String) (globals: String): ArmsEmit =
    if i >= arms.len() { ArmsEmit { code: code, allocas: allocas, releases: releases, globals: globals, n: n } }
    else {
        let test_label = cg_label(n);
        let pat = cg_pattern(p, env, n + 1, arms[i].pattern, sval, sity);
        match arms[i].guard {
            None => {
                let body_label = cg_label(pat.n);
                let b = cg_expr(p, pat.env, pat.n + 1, arms[i].body);
                // The NEXT arm's test label, or the fail block if this is the
                // last arm — computed before recursing so the branch can name
                // it, which is why the arm counter is threaded rather than
                // derived.
                let next_label = if i + 1 >= arms.len() { fail_label } else { cg_label(b.n) };
                let this_code = test_label.concat(":
")
                    .concat(pat.code)
                    .concat("  br i1 ").concat(pat.test).concat(", label %").concat(body_label).concat(", label %").concat(next_label).concat("
")
                    .concat(body_label).concat(":\n")
                    // Only now is the arm known to match, so only now may its
                    // bindings be stored and take references.
                    .concat(pat.binds)
                    .concat(b.code)
                    .concat("  store ").concat(lty).concat(" ").concat(b.val).concat(", ptr ").concat(slot).concat("
")
                    .concat("  br label %").concat(end_label).concat("
");
                cg_match_arms(p, env, b.n, arms, i + 1, sval, sity, slot, lty, end_label, fail_label,
                    code.concat(this_code), allocas.concat(pat.allocas).concat(b.allocas), releases.concat(pat.releases).concat(b.releases), globals.concat(pat.globals).concat(b.globals))
            },
            // `Rect(a, b) if a.x == b.x => ..` — the tag matched, but the
            // arm still has to earn the body. This emitter used to drop
            // the guard on the floor: the checker types it (see
            // `infer_match`) and every other pass walks it (`cg_rel_in`,
            // `cg_eq_in`, `cg_reads_max`), but the one place that turns an
            // arm into blocks never read it, so a guarded arm ran
            // unconditionally. `examples/adts_and_matching` printed
            // "(a square!)" for a rectangle that is not one -- a wrong
            // ANSWER, not a crash, which is why the example sweep found
            // it and nothing else had.
            //
            // The guard gets its own block between the test and the body,
            // and a false guard branches to the next arm exactly as a
            // failed tag test does -- the same fall-through the real
            // compiler's `MatchArm::guard` documents.
            Some(gexpr) => {
                let guard_label = cg_label(pat.n);
                let g = cg_expr(p, pat.env, pat.n + 1, gexpr);
                let body_label = cg_label(g.n);
                let b = cg_expr(p, pat.env, g.n + 1, arms[i].body);
                let next_label = if i + 1 >= arms.len() { fail_label } else { cg_label(b.n) };
                let this_code = test_label.concat(":
")
                    .concat(pat.code)
                    .concat("  br i1 ").concat(pat.test).concat(", label %").concat(guard_label).concat(", label %").concat(next_label).concat("
")
                    .concat(guard_label).concat(":\n")
                    // The guard READS the arm's bindings, so they have to
                    // be stored before it runs rather than in the body
                    // block. A guard that then fails leaves the extra
                    // reference in a slot the function's own exit release
                    // already covers -- delayed, not leaked.
                    .concat(pat.binds)
                    .concat(g.code)
                    .concat("  br i1 ").concat(g.val).concat(", label %").concat(body_label).concat(", label %").concat(next_label).concat("
")
                    .concat(body_label).concat(":\n")
                    .concat(b.code)
                    .concat("  store ").concat(lty).concat(" ").concat(b.val).concat(", ptr ").concat(slot).concat("
")
                    .concat("  br label %").concat(end_label).concat("
");
                cg_match_arms(p, env, b.n, arms, i + 1, sval, sity, slot, lty, end_label, fail_label,
                    code.concat(this_code),
                    allocas.concat(pat.allocas).concat(g.allocas).concat(b.allocas),
                    releases.concat(pat.releases).concat(g.releases).concat(b.releases),
                    globals.concat(pat.globals).concat(g.globals).concat(b.globals))
            },
        }
    }

// --- Patterns ---
//
// A pattern compiles to `test` (an `i1` operand) plus the bindings it
// introduces. Bindings are computed UNCONDITIONALLY, before the test is
// known to have passed — safe because every load involved is in-bounds
// by construction (`cg_payload_offset`'s over-allocation rule is what
// buys that), and simpler than threading a second control-flow layer
// through nested patterns.
// `binds` is separate from `code` for a reason that only appears once
// reference counting is on. Pattern bindings are computed
// UNCONDITIONALLY — every arm's payload is loaded before any tag is
// checked — which is safe for a LOAD (the over-allocation rule in
// `cg_payload_offset` guarantees the address is mapped) and NOT safe
// for an INCREMENT, because an increment writes THROUGH that pointer.
// `render_token`'s fifty-arm match reads `TokIdent`'s string payload
// while looking at a `TokInt`, so the "pointer" is the integer 1.
//
// So the load stays in the test block and the increment moves to the
// arm's BODY block, which only runs when the tag actually matched.
struct PatEmit { code: String, binds: String, allocas: String, releases: String, globals: String, test: String, env: Array[CgSlot], n: Int }

// The scrutinee's type is passed as an `ITy`, not a `CgTy`: a generic
// aggregate's field and payload types are TEMPLATES (`T`), and
// instantiating them needs the type ARGUMENTS, which a representation
// has already thrown away. `CgStruct("Box")` cannot tell you whether
// its `item` loads as an `i64` or a `ptr`; `ITStruct("Box", [Int])`
// can.
let cg_pattern (p: CgProgram) (env: Array[CgSlot]) (n: Int) (pattern: parser.PPattern) (sval: String) (sity: typecheck.ITy): PatEmit =
    match pattern {
        PWildcard => PatEmit { code: "", binds: "", allocas: "", releases: "",globals: "", test: "1", env: env, n: n },
        // A binding always matches; the slot it introduces is what the
        // arm body reads.
        PIdent(name, _) => {
            let slot = cg_reg(n);
            let sty = cg_of_ity(sity);
            let lty = cg_llvm_ty(sty);
            // A binding takes its OWN reference. Payload and field
            // loads in patterns deliberately do not increment — they
            // borrow from the scrutinee, which is released once the
            // whole match is done — so incrementing here is what keeps
            // the binding valid past that release.
            // BOTH the store and the increment are conditional. Leaving
            // the store in the test block would leave a non-matching
            // arm's slot holding a garbage pointer — the integer 1, say
            // — which the function's exit release would then write
            // through. The slot keeps its null instead, and releasing
            // null is a no-op.
            PatEmit {
                code: "",
                binds: cg_inc(sty, sval).concat("  store ").concat(lty).concat(" ").concat(sval).concat(", ptr ").concat(slot).concat("\n"),
                allocas: "  ".concat(slot).concat(" = alloca ").concat(lty).concat("\n").concat(cg_null_init(sity, slot)),
                releases: cg_release_slot(sity, slot, "_end"),
                globals: "", test: "1", env: env.push(CgSlot { name: name, ptr: slot, ty: sty, ity: sity }), n: n + 1,
            }
        },
        PInt(v) => cg_pat_cmp(env, n, "icmp eq i64 ", sval, v.to_string()),
        PFloat(v) => cg_pat_cmp(env, n, "fcmp oeq double ", sval, cg_float_text(v)),
        PBool(v) => cg_pat_cmp(env, n, "icmp eq i1 ", sval, if v { "1" } else { "0" }),
        PStr(v) => cg_pat_str(env, n, sval, v),
        PVariant(path, arg_pats) => cg_pat_variant(p, env, n, path, arg_pats, sval, sity),
        PStruct(path, field_pats, _) => cg_pat_struct(p, env, n, path[path.len() - 1], field_pats, sval, sity),
        // A tuple pattern always matches its own type — there is only
        // one shape — so it contributes no test of its own, only the
        // sub-patterns'.
        PTuple(pats) => cg_pat_fields(p, env, n, cg_tuple_index_names(pats, 0, []), cg_tuple_elem_itys(sity), cg_tuple_field_pats(pats, 0, []), 0, sval, "1", "", "", "", "", ""),
        POr(_) => { cg_fail("or-patterns aren't supported yet"); PatEmit { code: "", binds: "", allocas: "", releases: "",globals: "", test: "0", env: env, n: n } },
    }

let cg_pat_cmp (env: Array[CgSlot]) (n: Int) (op: String) (sval: String) (lit: String): PatEmit = {
    let reg = cg_reg(n);
    PatEmit { code: "  ".concat(reg).concat(" = ").concat(op).concat(sval).concat(", ").concat(lit).concat("
"), binds: "", allocas: "", releases: "", globals: "", test: reg, env: env, n: n + 1 }
}

let cg_pat_str (env: Array[CgSlot]) (n: Int) (sval: String) (lit: String): PatEmit = {
    // Compared directly against the STATIC cell — no copy. The literal
    // global IS a complete string cell now, so building a fresh one to
    // compare against would both allocate and, worse, copy from the
    // cell's refcount word as if it were the first byte of text.
    let gname = "@.str".concat(n.to_string());
    let test = cg_reg(n + 2);
    let code = "  ".concat(test).concat(" = call i1 @plum_str_eq(ptr ").concat(sval).concat(", ptr ").concat(gname).concat(")\n");
    PatEmit { code: code, binds: "", allocas: "", releases: "",globals: cg_str_constant(n, lit), test: test, env: env, n: n + 3 }
}

// `path` is what the CHECKER resolved the pattern head to:
// `[enum, tag]` for a variant, `[struct, tag]` for a positional struct
// pattern, both qualified. A one-element path is a pattern that never
// reached the checker; it falls back to the flat scan, which is what
// every pattern used to get.
let cg_pat_variant (p: CgProgram) (env: Array[CgSlot]) (n: Int) (path: Array[String]) (arg_pats: Array[parser.PPattern]) (sval: String) (sity: typecheck.ITy): PatEmit = {
    let name = path[path.len() - 1];
    let head = if path.len() >= 2 { path[0] } else { "" };
    match cg_pat_head_variant(p, head, name) {
        // Not a variant — a STRUCT destructured positionally,
        // `Point(x, y)`. The parser can't tell the two apart; the name
        // decides. Reuses the struct path by pairing each position
        // with its declared field name, exactly the way the tuple case
        // just below reuses it by pairing with an index.
        None => {
            let fnames = typecheck.ctx_field_names(p.ctx, head_or(head, name));
            if Array.is_empty(fnames) {
                cg_fail("unknown variant in pattern: ".concat(name));
                PatEmit { code: "", binds: "", allocas: "", releases: "",globals: "", test: "0", env: env, n: n }
            } else {
                cg_pat_struct(p, env, n, head_or(head, name), cg_positional_field_pats(fnames, arg_pats, 0, []), sval, sity)
            }
        },
        Some(v) => {
            let tag = cg_reg(n);
            let tag_ok = cg_reg(n + 1);
            let load = "  ".concat(tag).concat("p = getelementptr i8, ptr ").concat(sval).concat(", i64 ").concat(cg_tag_offset(()).to_string()).concat("\n")
                .concat("  ").concat(tag).concat(" = load i64, ptr ").concat(tag).concat("p\n")
                .concat("  ").concat(tag_ok).concat(" = icmp eq i64 ").concat(tag).concat(", ").concat(v.tag.to_string()).concat("\n");
            // Payload templates instantiated against the SCRUTINEE's
            // own type arguments — `Yes(v)` matched on a `Maybe[Int]`
            // binds `v` as an `Int`, and on a `Maybe[String]` as a
            // pointer, from one unspecialized enum declaration.
            let payload = Array.map(typecheck.ctx_variant_payload(p.ctx, v.enum_name, name), |t| typecheck.instantiate_template(typecheck.ctx_variant_generics(p.ctx, v.enum_name, name), cg_ity_args(sity), t));
            let sub = cg_pat_payloads(p, env, n + 2, payload, arg_pats, 0, sval, tag_ok, "", "", "", "", "");
            PatEmit { code: load.concat(sub.code), binds: sub.binds, allocas: sub.allocas, releases: sub.releases, globals: sub.globals, test: sub.test, env: sub.env, n: sub.n }
        },
    }
}

let head_or (head: String) (name: String): String = if head == "" { name } else { head }

// `None` covers both "this head names a struct, not an enum" and "no
// such variant", which are the same answer to the caller: not a
// variant, try the struct path.
let cg_pat_head_variant (p: CgProgram) (head: String) (tag: String): Option[CgVariant] =
    if head == "" { { cg_fail("internal: pattern head reached codegen unresolved: ".concat(tag)); None } }
    else { match cg_enum_opt(p, head) { None => None, Some(e) => cg_find_variant_in(e.variants, tag, 0) } }

let cg_enum_opt (p: CgProgram) (name: String): Option[CgEnumDecl] = cg_enum_opt_acc(p.enums, name, 0)
let cg_enum_opt_acc (es: Array[CgEnumDecl]) (name: String) (i: Int): Option[CgEnumDecl] =
    if i >= es.len() { None } else if es[i].name == name { Some(es[i]) } else { cg_enum_opt_acc(es, name, i + 1) }

// Each payload's own sub-pattern is tested and AND-ed into the running
// result. Plain `and`, not a short-circuit branch: every operand is
// already computed and side-effect-free, so there is nothing to skip.
//
// "Side-effect-free" holds for the payload LOAD (over-allocation, see
// `cg_payload_offset`) but NOT for what a nested sub-pattern does next
// with what it loaded. `Some(Some(n))` tested against a `None` loads
// the None's payload word -- another variant's data, or nothing at all
// -- and then follows it as a pointer to read an inner tag. That
// segfaults, and did: matching `Option[Option[Int]]` against `None`
// crashed under ASan while appearing to work without it.
//
// So a DEREFERENCING sub-pattern is handed a pointer that is safe to
// walk either way: the real payload when the tags so far matched, and
// `@plum_pat_safe` when they didn't (see its own comment in
// runtime.plum). A `select` keeps this flat -- no second control-flow
// layer through nested patterns, which is what the design note above
// this file's `PatEmit` deliberately avoids -- and costs one
// instruction on a path that was already loading. Binding is unchanged:
// `select` yields the REAL payload on the matching path, and `binds`
// only ever runs there.
let cg_pat_payloads (p: CgProgram) (env: Array[CgSlot]) (n: Int) (payload: Array[typecheck.ITy]) (pats: Array[parser.PPattern]) (i: Int) (sval: String) (test: String) (code: String) (binds: String) (allocas: String) (releases: String) (globals: String): PatEmit =
    if i >= pats.len() { PatEmit { code: code, binds: binds, allocas: allocas, releases: releases, globals: globals, test: test, env: env, n: n } }
    else {
        let pp = cg_reg(n);
        let pv = cg_reg(n + 1);
        let pty = cg_concrete(p, payload[i]);
        let pllty = cg_llvm_ty(cg_of_ity(pty));
        let load = "  ".concat(pp).concat(" = getelementptr i8, ptr ").concat(sval).concat(", i64 ").concat(cg_payload_offset(i).to_string()).concat("\n")
            .concat("  ").concat(pv).concat(" = load ").concat(pllty).concat(", ptr ").concat(pp).concat("\n");
        let needs_safe = pllty == "ptr" && cg_pat_derefs(pats[i]);
        let pval = if needs_safe { cg_reg(n + 2) } else { pv };
        let guard = if needs_safe {
            "  ".concat(pval).concat(" = select i1 ").concat(test).concat(", ptr ").concat(pv).concat(", ptr @plum_pat_safe\n")
        } else { "" };
        let sub = cg_pattern(p, env, n + 3, pats[i], pval, pty);
        let combined = cg_reg(sub.n);
        let join = "  ".concat(combined).concat(" = and i1 ").concat(test).concat(", ").concat(sub.test).concat("
");
        cg_pat_payloads(p, sub.env, sub.n + 1, payload, pats, i + 1, sval, combined,
            code.concat(load).concat(guard).concat(sub.code).concat(join), binds.concat(sub.binds), allocas.concat(sub.allocas), releases.concat(sub.releases), globals.concat(sub.globals))
    }

// True for a sub-pattern that FOLLOWS the value it is given as a
// pointer, rather than just binding or comparing it as a word -- the
// ones that need `cg_pat_payloads`'s safe stand-in. A string pattern
// counts: `plum_str_eq` reads a length out of the cell and then
// memcmp's from it.
let cg_pat_derefs (pat: parser.PPattern): Bool =
    match pat {
        PVariant(_, _) => true,
        PStruct(_, _, _) => true,
        PTuple(_) => true,
        PStr(_) => true,
        _ => false,
    }

// A struct pattern has no tag to check — it always matches its own
// type — so the running test starts at `1` and only sub-patterns can
// falsify it. `Point { x, y }` binds shorthand fields, which the parser
// already expands into `x: x` field patterns.
let cg_pat_struct (p: CgProgram) (env: Array[CgSlot]) (n: Int) (name: String) (field_pats: Array[parser.FieldPatternNode]) (sval: String) (sity: typecheck.ITy): PatEmit =
    cg_pat_fields(p, env, n, typecheck.ctx_field_names(p.ctx, name),
        Array.map(typecheck.ctx_field_types(p.ctx, name), |t| typecheck.instantiate_template(typecheck.ctx_struct_generics(p.ctx, name), cg_ity_args(sity), t)),
        field_pats, 0, sval, "1", "", "", "", "", "")

// A tuple pattern is destructured POSITIONALLY, but `cg_pat_fields`
// works by field name — so each position is given its index as a name.
// Reusing the struct path is the point: a tuple is an anonymous struct,
// and the emitter should not have a second copy of the same loop.
// Pairs positional sub-patterns with a struct's DECLARED field names,
// in order, so `Point(x, y)` becomes the same shape as
// `Point { x: x, y: y }`.
let cg_positional_field_pats (fnames: Array[String]) (pats: Array[parser.PPattern]) (i: Int) (acc: Array[parser.FieldPatternNode]): Array[parser.FieldPatternNode] =
    if i >= pats.len() || i >= fnames.len() { acc }
    else { cg_positional_field_pats(fnames, pats, i + 1, acc.push(parser.FieldPatternNode { name: fnames[i], pattern: pats[i] })) }

let cg_tuple_index_names (pats: Array[parser.PPattern]) (i: Int) (acc: Array[String]): Array[String] =
    if i >= pats.len() { acc } else { cg_tuple_index_names(pats, i + 1, acc.push(i.to_string())) }

let cg_tuple_field_pats (pats: Array[parser.PPattern]) (i: Int) (acc: Array[parser.FieldPatternNode]): Array[parser.FieldPatternNode] =
    if i >= pats.len() { acc }
    else { cg_tuple_field_pats(pats, i + 1, acc.push(parser.FieldPatternNode { name: i.to_string(), pattern: pats[i] })) }

let cg_tuple_elem_itys (t: typecheck.ITy): Array[typecheck.ITy] =
    match t { ITTuple(elems) => elems, _ => { cg_fail("expected a tuple"); [] } }

// A struct's or enum's type ARGUMENTS at a use site. Anything else has
// none, which is the right answer for a primitive scrutinee.
let cg_ity_args (t: typecheck.ITy): Array[typecheck.ITy] =
    match t {
        ITStruct(_, args) => args,
        ITEnum(_, args) => args,
        _ => [],
    }

let cg_pat_fields (p: CgProgram) (env: Array[CgSlot]) (n: Int) (field_names: Array[String]) (field_tys: Array[typecheck.ITy]) (pats: Array[parser.FieldPatternNode]) (i: Int) (sval: String) (test: String) (code: String) (binds: String) (allocas: String) (releases: String) (globals: String): PatEmit =
    if i >= pats.len() { PatEmit { code: code, binds: binds, allocas: allocas, releases: releases, globals: globals, test: test, env: env, n: n } }
    else {
        let idx = cg_field_index(field_names, pats[i].name, 0);
        let fty = cg_concrete(p, field_tys[idx]);
        let fp = cg_reg(n);
        let fv = cg_reg(n + 1);
        let load = "  ".concat(fp).concat(" = getelementptr i8, ptr ").concat(sval).concat(", i64 ").concat(cg_field_offset(idx).to_string()).concat("\n")
            .concat("  ").concat(fv).concat(" = load ").concat(cg_llvm_ty(cg_of_ity(fty))).concat(", ptr ").concat(fp).concat("\n");
        let sub = cg_pattern(p, env, n + 2, pats[i].pattern, fv, fty);
        let combined = cg_reg(sub.n);
        let join = "  ".concat(combined).concat(" = and i1 ").concat(test).concat(", ").concat(sub.test).concat("
");
        cg_pat_fields(p, sub.env, sub.n + 1, field_names, field_tys, pats, i + 1, sval, combined,
            code.concat(load).concat(sub.code).concat(join), binds.concat(sub.binds), allocas.concat(sub.allocas), releases.concat(sub.releases), globals.concat(sub.globals))
    }

// --- Function and program emission ---

// Parameters arrive as SSA values (`%p0`) and are immediately spilled
// into `alloca` slots, so a parameter is read exactly like any other
// local and can even be reassigned. mem2reg undoes the spill.
// `n0` is the counter to START this function's names at, and `next` is
// where the following function must start. Counting CONTINUES across
// function boundaries rather than restarting at zero per function,
// because string-literal constants (`@.str<n>`) are MODULE-level: two
// functions each restarting at zero both emit `@.str0`, and clang
// rejects the redefinition. Register and label names would be fine
// either way — they're function-local — so this is entirely about the
// one name that escapes the function.
struct FnEmit { text: String, next: Int }

// `p.subst` is swapped to THIS function's substitution before its body
// is emitted — that is what lets `cg_ty` resolve any type recorded
// during its inference. Each function was inferred independently, so
// each has its own.
let cg_fn (p0: CgProgram) (def: typecheck.TFn) (targs: Array[typecheck.ITy]) (n0: Int): FnEmit = {
    // The body the backend emits is the body the LAST-USE pass rewrote:
    // the same program, with allocations that can recycle a dead cell
    // marked as such.
    //
    // `movable` is derived from the REWRITTEN body, because a reuse ADDS
    // a read -- the candidate is moved out of its slot -- and a name
    // counted on the original could look read-once while the emitted
    // code reads it twice. `cg_reads_max` counts a node's whole
    // candidate LIST as a read for that reason: it over-counts, since
    // only one is ever taken, and over-counting only refuses a move.
    let lbody = lv_fn(def.params, def.body);
    let mov = cg_movable_params(lbody, def.params, 0, []);
    let p = CgProgram { fns: p0.fns, globals: p0.globals, ctx: p0.ctx, enums: p0.enums, subst: def.subst, generics: def.generics, targs: targs,
        movable: mov };
    let params = cg_params_of(p, def.params, 0, []);
    let entry = cg_param_slots(params, Array.map(def.params, |q| cg_concrete(p, q.ty)), 0, [], "", "");
    let ret = cg_of_ity(cg_concrete(p, def.ret));
    let body = cg_expr(p, entry.env, n0, lbody);
    let header = "define ".concat(cg_llvm_ty(ret)).concat(" @").concat(cg_sym(def.module, def.name, targs)).concat("(").concat(cg_param_decls(params)).concat(") {\nentry:\n");
    // Every `alloca` is hoisted here, at the top of the entry block,
    // ahead of any instruction that could branch — see `Emit`'s own
    // comment for why that is a correctness requirement inside loops
    // and not just a tidiness preference.
    let text = body.globals
        .concat(header)
        .concat(entry.code)
        .concat(body.allocas)
        .concat(body.code)
        // Every slot is released here, on the way out. The RESULT is
        // untouched: it carries its own +1, obtained independently of
        // any slot (rule 3), so returning a parameter's value and then
        // releasing that parameter is balanced rather than a
        // use-after-free.
        .concat(body.releases)
        .concat(entry.releases)
        .concat("  ret ").concat(cg_llvm_ty(ret)).concat(" ").concat(body.val).concat("\n")
        .concat("}\n\n");
    FnEmit { text: text, next: body.n }
}

// The checker's `TParam`s carry resolved types already; this only maps
// them to representations. `()` — the Unit pattern — contributed no
// entry there, so a `let main (): Unit` really does emit as a
// zero-argument LLVM function.
struct CgParam { name: String, ty: CgTy }

let cg_params_of (p: CgProgram) (params: Array[typecheck.TParam]) (i: Int) (acc: Array[CgParam]): Array[CgParam] =
    if i >= params.len() { acc }
    else { cg_params_of(p, params, i + 1, acc.push(CgParam { name: params[i].name, ty: cg_of_ity(cg_concrete(p, params[i].ty)) })) }

let cg_param_decls (params: Array[CgParam]): String =
    cg_join_commas(cg_param_decl_list(params, 0, []))

let cg_param_decl_list (params: Array[CgParam]) (i: Int) (acc: Array[String]): Array[String] =
    if i >= params.len() { acc }
    else { cg_param_decl_list(params, i + 1, acc.push(cg_llvm_ty(params[i].ty).concat(" %p").concat(i.to_string()))) }

// Parameter slots use `%s<i>` names rather than the `%t<n>` counter, so
// the counter can start wherever the module-level string-constant
// numbering left off without colliding.
struct ParamSlots { env: Array[CgSlot], code: String, releases: String }

// Rule 4: a call consumes its arguments, so a parameter arrives OWNED
// and this function is responsible for releasing it — which happens
// through the same exit splice as every other slot.
let cg_param_slots (params: Array[CgParam]) (ptys: Array[typecheck.ITy]) (i: Int) (env: Array[CgSlot]) (code: String) (releases: String): ParamSlots =
    if i >= params.len() { ParamSlots { env: env, code: code, releases: releases } }
    else {
        let lty = cg_llvm_ty(params[i].ty);
        let slot = "%s".concat(i.to_string());
        let line = "  ".concat(slot).concat(" = alloca ").concat(lty).concat("\n")
            .concat("  store ").concat(lty).concat(" %p").concat(i.to_string()).concat(", ptr ").concat(slot).concat("\n");
        cg_param_slots(params, ptys, i + 1, env.push(CgSlot { name: params[i].name, ptr: slot, ty: params[i].ty, ity: ptys[i] }), code.concat(line), releases.concat(cg_release_slot(ptys[i], slot, "_end")))
    }

// The C entry point. Calls Plum's own `main` and discards its result —
// a `Unit` return carries no information, so nothing is printed. (The
// REAL backend echoed it for years, which is where every compiled
// program's stray trailing `0` came from; that was fixed the same day
// this file was started.)
// The C entry point calls ONE Plum function. Which one is a parameter
// because `test` compiles a program whose entry is a synthesized
// dispatcher rather than the project's own `main` -- see main.plum's
// `cmd_test`.
let cg_entry_named (entry_sym: String): String = cg_lines([
    "define i32 @main(i32 %argc, ptr %argv) {",
    "entry:",
    "  store i32 %argc, ptr @plum_argc",
    "  store ptr %argv, ptr @plum_argv",
    // Before anything else, and for the same reason the real backend
    // does it here: `towupper`/`towlower` touch ASCII only in the
    // default "C" locale, so `.to_upper()` would quietly differ from
    // the real backend on any non-ASCII string.
    "  call void @plum_locale_init()",
    "  %reg = call i32 @atexit(ptr @plum_dump_stats)",
    // Seeded ONCE here, not per call, exactly where the real backend
    // seeds it (`plumc::emit_main`'s prologue). Seeding per call would
    // make `Float.random()` return the same value every time within a
    // second.
    "  %seed = call i64 @time(ptr null)",
    "  %seed32 = trunc i64 %seed to i32",
    "  call void @srand(i32 %seed32)",
    "  call void @plum_init_globals()",
    "  %r = call i1 ".concat(entry_sym).concat("()"),
    "  ret i32 0",
    "}",
])

// --- Structural equality ---
//
// `==` on an aggregate must compare CONTENTS, not addresses. Emitting
// `icmp eq ptr` was silently wrong: two separately-built `TokLet`s are
// equal values at different addresses, so the self-hosted parser's own
// `tokens[pos] == expected` was always false and every parse failed
// with "expected 'let'". Found by compiling the parser, not by reading
// the code.
//
// The real backend generates one equality function per type from its
// tag tables; this does the same, discovered by the same worklist that
// discovers specializations. Comparing TAGS alone would have been
// enough for the parser — its expected tokens are all nullary — and
// would have been quietly wrong for `Ident("a") == Ident("b")`, so it
// isn't done that way.

let cg_eq_sym (t: typecheck.ITy): String = "@plum_eq_".concat(cg_ity_mangle(t))

// Is this type compared by VALUE inline, or does it need a function?
let cg_eq_is_primitive (t: typecheck.ITy): Bool =
    match t {
        ITInt => true, ITFloat => true, ITBool => true, ITUnit => true, ITStr => true, ITCStr => true,
        ITVar(_) => true,
        _ => false,
    }

struct EqEmit { code: String, val: String, n: Int }

// Comparing two already-emitted operands of type `t`.
let cg_eq_code (t: typecheck.ITy) (av: String) (bv: String) (n: Int): EqEmit = {
    let reg = cg_reg(n);
    let lty = cg_llvm_ty(cg_of_ity(t));
    let line = match t {
        ITStr => "  ".concat(reg).concat(" = call i1 @plum_str_eq(ptr ").concat(av).concat(", ptr ").concat(bv).concat(")\n"),
        ITFloat => "  ".concat(reg).concat(" = fcmp oeq double ").concat(av).concat(", ").concat(bv).concat("\n"),
        ITInt => "  ".concat(reg).concat(" = icmp eq i64 ").concat(av).concat(", ").concat(bv).concat("\n"),
        ITBool => "  ".concat(reg).concat(" = icmp eq i1 ").concat(av).concat(", ").concat(bv).concat("\n"),
        ITUnit => "  ".concat(reg).concat(" = icmp eq i1 ").concat(av).concat(", ").concat(bv).concat("\n"),
        // A defaulted (unconstrained) type is compared as its defaulted
        // representation, which is `Unit` — see `cg_of_ity`.
        ITVar(_) => "  ".concat(reg).concat(" = icmp eq i1 ").concat(av).concat(", ").concat(bv).concat("\n"),
        _ => "  ".concat(reg).concat(" = call i1 ").concat(cg_eq_sym(t)).concat("(").concat(lty).concat(" ").concat(av).concat(", ").concat(lty).concat(" ").concat(bv).concat(")\n"),
    };
    EqEmit { code: line, val: reg, n: n + 1 }
}

// Every aggregate type needing an equality function, transitively. The
// `seen` check is what makes a RECURSIVE type (`PExpr` whose payload is
// a `PExpr`) terminate — it needs exactly one function, which calls
// itself.
let cg_eq_close (p: CgProgram) (t: typecheck.ITy) (acc: Array[typecheck.ITy]): Array[typecheck.ITy] =
    if cg_eq_is_primitive(t) { acc }
    else if cg_ty_in(acc, t, 0) { acc }
    else {
        let acc2 = acc.push(t);
        match t {
            ITStruct(name, args) =>
                if name == "Array" { cg_eq_close(p, args[0], acc2) }
                // A handle has no structure to compare and no fields to
                // walk into. Reached when one is a FIELD of something
                // being compared, which is why this is a stop rather
                // than an error.
                else if cg_is_handle_name(name) { acc2 }
                else { cg_eq_close_list(p, Array.map(typecheck.ctx_field_types(p.ctx, name), |ft| typecheck.instantiate_template(typecheck.ctx_struct_generics(p.ctx, name), args, ft)), 0, acc2) },
            ITEnum(name, args) => cg_eq_close_variants(p, cg_find_enum(p, name).variants, args, 0, acc2),
            ITTuple(elems) => cg_eq_close_list(p, elems, 0, acc2),
            _ => acc2,
        }
    }

let cg_ty_in (acc: Array[typecheck.ITy]) (t: typecheck.ITy) (i: Int): Bool =
    if i >= acc.len() { false } else if cg_ity_mangle(acc[i]) == cg_ity_mangle(t) { true } else { cg_ty_in(acc, t, i + 1) }

let cg_eq_close_list (p: CgProgram) (ts: Array[typecheck.ITy]) (i: Int) (acc: Array[typecheck.ITy]): Array[typecheck.ITy] =
    if i >= ts.len() { acc } else { cg_eq_close_list(p, ts, i + 1, cg_eq_close(p, ts[i], acc)) }

let cg_eq_close_variants (p: CgProgram) (vs: Array[CgVariant]) (args: Array[typecheck.ITy]) (i: Int) (acc: Array[typecheck.ITy]): Array[typecheck.ITy] =
    if i >= vs.len() { acc }
    else {
        let payload = Array.map(typecheck.ctx_variant_payload(p.ctx, vs[i].enum_name, vs[i].name), |t| typecheck.instantiate_template(typecheck.ctx_variant_generics(p.ctx, vs[i].enum_name, vs[i].name), args, t));
        cg_eq_close_variants(p, vs, args, i + 1, cg_eq_close_list(p, payload, 0, acc))
    }

// --- `.to_string()` on aggregates ---
//
// A per-TYPE renderer, discovered and emitted exactly the way the
// equality and release functions are. The output format matches the
// real compiler's byte for byte -- `P { x: 1, y: "hi" }`, `[1, 2, 3]`,
// `Circle(2.5)` -- because both compilers' output is compared against
// the same `exec_corpus` expectations.
//
// Note the quoting rule: a `String` nested inside an aggregate renders
// QUOTED, while `"hi".to_string()` at the top level does not. That is
// the real compiler's behaviour and it is deliberate -- the nested form
// is a debug rendering, where an unquoted empty string would be
// invisible.
let cg_str_sym (t: typecheck.ITy): String = "@plum_str_".concat(cg_ity_mangle(t))

let cg_sfmt_sym (owner: typecheck.ITy) (i: Int): String =
    "@.sfmt_".concat(cg_ity_mangle(owner)).concat("_").concat(i.to_string())

// A STATIC string cell (refcount -1), the same shape `cg_str_constant`
// produces -- so `plum_rel_str` skips it and these never need freeing.
let cg_sfmt_const (owner: typecheck.ITy) (i: Int) (s: String): String = {
    let bytes = s.len();
    let arr = bytes + 1;
    cg_sfmt_sym(owner, i).concat(" = private global { i64, i64, [").concat(arr.to_string())
        .concat(" x i8] } { i64 -1, i64 ").concat(bytes.to_string()).concat(", [").concat(arr.to_string())
        .concat(" x i8] c\"").concat(cg_escape_llvm(s)).concat("\\00\" }\n")
}

struct StrEmit { code: String, consts: String, val: String, n: Int }

// Renders one value of type `t`, already loaded into `val`, as a fresh
// string cell. `owner` only supplies a unique prefix for any constants.
let cg_render_val (owner: typecheck.ITy) (t: typecheck.ITy) (val: String) (n: Int): StrEmit =
    match t {
        ITInt => StrEmit { code: "  ".concat(cg_reg(n)).concat(" = call ptr @plum_int_to_string(i64 ").concat(val).concat(")\n"), consts: "", val: cg_reg(n), n: n + 1 },
        ITFloat => StrEmit { code: "  ".concat(cg_reg(n)).concat(" = call ptr @plum_float_to_string(double ").concat(val).concat(")\n"), consts: "", val: cg_reg(n), n: n + 1 },
        ITBool => StrEmit { code: "  ".concat(cg_reg(n)).concat(" = call ptr @plum_bool_to_string(i1 ").concat(val).concat(")\n"), consts: "", val: cg_reg(n), n: n + 1 },
        // Unreachable in practice: `.to_string()` on a `CStr` is
        // rejected in `cg_to_string`, so nothing gets this far with one.
        ITCStr => StrEmit { code: "", consts: cg_sfmt_const(owner, n, "<cstr>"), val: cg_sfmt_sym(owner, n), n: n + 1 },
        // Quoted, and the intermediate concat released so a nested
        // string costs no leak.
        ITStr => {
            let q = cg_sfmt_sym(owner, n);
            let r1 = cg_reg(n + 1);
            let r2 = cg_reg(n + 2);
            StrEmit {
                consts: cg_sfmt_const(owner, n, "\""),
                code: "  ".concat(r1).concat(" = call ptr @plum_str_concat(ptr ").concat(q).concat(", ptr ").concat(val).concat(")\n")
                    .concat("  ").concat(r2).concat(" = call ptr @plum_str_concat(ptr ").concat(r1).concat(", ptr ").concat(q).concat(")\n")
                    .concat("  call void @plum_rel_str(ptr ").concat(r1).concat(")\n"),
                val: r2, n: n + 3,
            }
        },
        ITUnit => StrEmit { code: "", consts: cg_sfmt_const(owner, n, "Unit"), val: cg_sfmt_sym(owner, n), n: n + 1 },
        // The renderable aggregates -- `Array` is an `ITStruct` too, so
        // both reach their own emitted renderer the same way.
        ITStruct(_, _) => StrEmit { code: "  ".concat(cg_reg(n)).concat(" = call ptr ").concat(cg_str_sym(t)).concat("(ptr ").concat(val).concat(")\n"), consts: "", val: cg_reg(n), n: n + 1 },
        ITEnum(_, _) => StrEmit { code: "  ".concat(cg_reg(n)).concat(" = call ptr ").concat(cg_str_sym(t)).concat("(ptr ").concat(val).concat(")\n"), consts: "", val: cg_reg(n), n: n + 1 },
        // Everything with no sensible text form gets a PLACEHOLDER
        // rather than a call to a renderer that was never emitted.
        // This is a deliberate, documented divergence: the real
        // compiler REJECTS `.to_string()` on an aggregate containing a
        // closure outright. Emitting a placeholder is strictly more
        // permissive, and the alternative here is worse -- renderers
        // are emitted for every reachable heap type, so a struct with
        // a closure field would otherwise emit a call to a missing
        // symbol and fail at LINK time, even when nothing ever printed
        // it. A closure has no text form in either compiler; the only
        // question is whether that costs you a link error.
        ITFunction(_, _) => StrEmit { code: "", consts: cg_sfmt_const(owner, n, "<closure>"), val: cg_sfmt_sym(owner, n), n: n + 1 },
        ITRef(_) => StrEmit { code: "", consts: cg_sfmt_const(owner, n, "<ref>"), val: cg_sfmt_sym(owner, n), n: n + 1 },
        ITTuple(_) => StrEmit { code: "", consts: cg_sfmt_const(owner, n, "<tuple>"), val: cg_sfmt_sym(owner, n), n: n + 1 },
        ITVar(_) => StrEmit { code: "", consts: cg_sfmt_const(owner, n, "<?>"), val: cg_sfmt_sym(owner, n), n: n + 1 },
        ITParam(_) => StrEmit { code: "", consts: cg_sfmt_const(owner, n, "<?>"), val: cg_sfmt_sym(owner, n), n: n + 1 },
    }

// `acc = acc ++ piece`, releasing both operands. Every operand is either
// a fresh cell this function made or a static literal, and
// `plum_rel_str` is null- and static-safe, so one rule covers both.
let cg_str_append (acc: String) (piece: String) (n: Int): StrEmit = {
    let out = cg_reg(n);
    StrEmit {
        code: "  ".concat(out).concat(" = call ptr @plum_str_concat(ptr ").concat(acc).concat(", ptr ").concat(piece).concat(")\n")
            .concat("  call void @plum_rel_str(ptr ").concat(acc).concat(")\n")
            .concat("  call void @plum_rel_str(ptr ").concat(piece).concat(")\n"),
        consts: "", val: out, n: n + 1,
    }
}

// Starts an accumulator AT a literal. `plum_str_concat` dereferences
// both operands immediately, so there is no null/empty seed to start
// from -- the first piece has to be a real cell. It is static, so
// later `plum_rel_str` calls on it are no-ops.
let cg_str_seed_lit (owner: typecheck.ITy) (text: String) (n: Int): StrEmit =
    StrEmit { code: "", consts: cg_sfmt_const(owner, n, text), val: cg_sfmt_sym(owner, n), n: n + 1 }

// Appends a literal, which needs no release of its own.
let cg_str_append_lit (owner: typecheck.ITy) (acc: String) (text: String) (n: Int): StrEmit = {
    let lit = cg_sfmt_sym(owner, n);
    let out = cg_reg(n + 1);
    StrEmit {
        consts: cg_sfmt_const(owner, n, text),
        code: "  ".concat(out).concat(" = call ptr @plum_str_concat(ptr ").concat(acc).concat(", ptr ").concat(lit).concat(")\n")
            .concat("  call void @plum_rel_str(ptr ").concat(acc).concat(")\n"),
        val: out, n: n + 2,
    }
}

// One renderer per aggregate type. Emitted for every reachable heap
// type (the same set the release functions use) rather than only where
// `.to_string()` is actually called: a struct's renderer calls its
// fields' renderers, so the set has to be closed under nesting anyway,
// and the release set already is.
// Array-then-join, like `cg_emit_insts`: one generated function per
// type, and appending each onto a growing string is quadratic.
let cg_emit_str_fns (p: CgProgram) (ts: Array[typecheck.ITy]) (i: Int) (acc: String): String =
    Array.concat_all(cg_emit_str_fns_acc(p, ts, 0, []))

let cg_emit_str_fns_acc (p: CgProgram) (ts: Array[typecheck.ITy]) (i: Int) (acc: Array[String]): Array[String] =
    if i >= ts.len() { acc } else { cg_emit_str_fns_acc(p, ts, i + 1, acc.push(cg_emit_str_fn(p, ts[i]))) }

let cg_emit_str_fn (p: CgProgram) (t: typecheck.ITy): String =
    match t {
        ITStruct(name, args) =>
            if name == "Array" { cg_emit_array_str(t, args[0]) }
            else if cg_is_handle_name(name) { "" }
            else { cg_emit_struct_str(p, t, name, Array.map(typecheck.ctx_field_types(p.ctx, name), |ft| typecheck.instantiate_template(typecheck.ctx_struct_generics(p.ctx, name), args, ft))) },
        ITEnum(name, args) => cg_emit_enum_str(p, t, name, args),
        _ => "",
    }

// `P { x: 1, y: "hi" }`
let cg_emit_struct_str (p: CgProgram) (t: typecheck.ITy) (name: String) (ftys: Array[typecheck.ITy]): String = {
    let names = typecheck.ctx_field_names(p.ctx, name);
    let start = cg_str_seed_lit(t, name.concat(" { "), 0);
    let body = cg_struct_str_fields(t, names, ftys, 0, start.val, start.code, start.consts, start.n);
    let fin = cg_str_append_lit(t, body.val, " }", body.n);
    "define ptr ".concat(cg_str_sym(t)).concat("(ptr %p) {\nentry:\n")
        .concat(body.code).concat(fin.code)
        .concat("  ret ptr ").concat(fin.val).concat("\n}\n\n")
        .concat(body.consts).concat(fin.consts)
}

let cg_struct_str_fields (t: typecheck.ITy) (names: Array[String]) (ftys: Array[typecheck.ITy]) (i: Int) (acc: String) (code: String) (consts: String) (n: Int): StrEmit =
    if i >= ftys.len() { StrEmit { code: code, consts: consts, val: acc, n: n } }
    else {
        let sep = if i == 0 { "" } else { ", " };
        let lbl = cg_str_append_lit(t, acc, sep.concat(names[i]).concat(": "), n);
        let fp = cg_reg(lbl.n);
        let fv = cg_reg(lbl.n + 1);
        let load = "  ".concat(fp).concat(" = getelementptr i8, ptr %p, i64 ").concat(cg_field_offset(i).to_string()).concat("\n")
            .concat("  ").concat(fv).concat(" = load ").concat(cg_llvm_ty(cg_of_ity(ftys[i]))).concat(", ptr ").concat(fp).concat("\n");
        let r = cg_render_val(t, ftys[i], fv, lbl.n + 2);
        let app = cg_str_append(lbl.val, r.val, r.n);
        cg_struct_str_fields(t, names, ftys, i + 1, app.val,
            code.concat(lbl.code).concat(load).concat(r.code).concat(app.code),
            consts.concat(lbl.consts).concat(r.consts), app.n)
    }

// `[1, 2, 3]` -- a runtime loop, since the length is not known here.
let cg_emit_array_str (t: typecheck.ITy) (elem: typecheck.ITy): String = {
    let ety = cg_llvm_ty(cg_of_ity(elem));
    let r = cg_render_val(t, elem, "%ev", 20);
    let sep = cg_sfmt_sym(t, 1);
    "define ptr ".concat(cg_str_sym(t)).concat("(ptr %p) {\nentry:\n")
        .concat("  %accp = alloca ptr\n  store ptr ").concat(cg_sfmt_sym(t, 0)).concat(", ptr %accp\n")
        .concat("  %lp = getelementptr i8, ptr %p, i64 8\n  %len = load i64, ptr %lp\n")
        .concat("  %ip = alloca i64\n  store i64 0, ptr %ip\n  br label %loop\n")
        .concat("loop:\n  %i = load i64, ptr %ip\n  %more = icmp slt i64 %i, %len\n")
        .concat("  br i1 %more, label %body, label %done\n")
        .concat("body:\n")
        .concat("  %first = icmp eq i64 %i, 0\n")
        .concat("  br i1 %first, label %noSep, label %withSep\n")
        .concat("withSep:\n  %a1 = load ptr, ptr %accp\n")
        .concat("  %a2 = call ptr @plum_str_concat(ptr %a1, ptr ").concat(sep).concat(")\n")
        .concat("  call void @plum_rel_str(ptr %a1)\n  store ptr %a2, ptr %accp\n  br label %noSep\n")
        .concat("noSep:\n")
        .concat("  %off = mul i64 %i, 8\n  %ep0 = getelementptr i8, ptr %p, i64 %off\n")
        .concat("  %ep = getelementptr i8, ptr %ep0, i64 ").concat(cg_array_elem_offset(0).to_string()).concat("\n")
        .concat("  %ev = load ").concat(ety).concat(", ptr %ep\n")
        .concat(r.code)
        .concat("  %a3 = load ptr, ptr %accp\n")
        .concat("  %a4 = call ptr @plum_str_concat(ptr %a3, ptr ").concat(r.val).concat(")\n")
        .concat("  call void @plum_rel_str(ptr %a3)\n  call void @plum_rel_str(ptr ").concat(r.val).concat(")\n")
        .concat("  store ptr %a4, ptr %accp\n")
        .concat("  %i1 = add i64 %i, 1\n  store i64 %i1, ptr %ip\n  br label %loop\n")
        .concat("done:\n  %af = load ptr, ptr %accp\n")
        .concat("  %out = call ptr @plum_str_concat(ptr %af, ptr ").concat(cg_sfmt_sym(t, 2)).concat(")\n")
        .concat("  call void @plum_rel_str(ptr %af)\n")
        .concat("  ret ptr %out\n}\n\n")
        .concat(cg_sfmt_const(t, 0, "[")).concat(cg_sfmt_const(t, 1, ", ")).concat(cg_sfmt_const(t, 2, "]"))
        .concat(r.consts)
}

// `Circle(2.5)` / `Empty` -- one block per variant, selected on the
// tag, same dispatch shape the release and equality functions use.
// Each block returns directly rather than joining a merge point: a phi
// over N incoming strings buys nothing here, and returning early keeps
// each variant's rendering entirely local.
let cg_emit_enum_str (p: CgProgram) (t: typecheck.ITy) (name: String) (args: Array[typecheck.ITy]): String = {
    let vs = cg_find_enum(p, name).variants;
    let blocks = cg_enum_str_blocks(p, t, vs, args, 0, 100, "", "");
    "define ptr ".concat(cg_str_sym(t)).concat("(ptr %p) {\nentry:\n")
        .concat("  %tp = getelementptr i8, ptr %p, i64 ").concat(cg_tag_offset(()).to_string()).concat("\n")
        .concat("  %tag = load i64, ptr %tp\n")
        .concat("  switch i64 %tag, label %unknown [\n").concat(cg_enum_str_cases(vs, 0, "")).concat("  ]\n")
        .concat(blocks.code)
        .concat("unknown:\n  ret ptr ").concat(cg_sfmt_sym(t, 99)).concat("\n}\n\n")
        .concat(cg_sfmt_const(t, 99, "<unknown>")).concat(blocks.consts)
}

let cg_enum_str_cases (vs: Array[CgVariant]) (i: Int) (acc: String): String =
    if i >= vs.len() { acc }
    else { cg_enum_str_cases(vs, i + 1, acc.concat("    i64 ").concat(vs[i].tag.to_string()).concat(", label %S").concat(vs[i].tag.to_string()).concat("\n")) }

let cg_enum_str_blocks (p: CgProgram) (t: typecheck.ITy) (vs: Array[CgVariant]) (args: Array[typecheck.ITy]) (i: Int) (n: Int) (code: String) (consts: String): StrEmit =
    if i >= vs.len() { StrEmit { code: code, consts: consts, val: "", n: n } }
    else {
        let ptys = cg_variant_payload_tys(p, vs[i], args);
        let head = "S".concat(vs[i].tag.to_string()).concat(":\n");
        // A payload-free variant is just its own name.
        if Array.is_empty(ptys) {
            cg_enum_str_blocks(p, t, vs, args, i + 1, n + 1,
                code.concat(head).concat("  ret ptr ").concat(cg_sfmt_sym(t, n)).concat("\n"),
                consts.concat(cg_sfmt_const(t, n, vs[i].name)))
        } else {
            let start = cg_str_seed_lit(t, vs[i].name.concat("("), n);
            let body = cg_enum_str_payloads(t, ptys, 0, start.val, start.code, start.consts, start.n);
            let fin = cg_str_append_lit(t, body.val, ")", body.n);
            cg_enum_str_blocks(p, t, vs, args, i + 1, fin.n,
                code.concat(head).concat(body.code).concat(fin.code).concat("  ret ptr ").concat(fin.val).concat("\n"),
                consts.concat(body.consts).concat(fin.consts))
        }
    }

let cg_enum_str_payloads (t: typecheck.ITy) (ptys: Array[typecheck.ITy]) (i: Int) (acc: String) (code: String) (consts: String) (n: Int): StrEmit =
    if i >= ptys.len() { StrEmit { code: code, consts: consts, val: acc, n: n } }
    else {
        let pre = if i == 0 { StrEmit { code: "", consts: "", val: acc, n: n } } else { cg_str_append_lit(t, acc, ", ", n) };
        let pp = cg_reg(pre.n);
        let pv = cg_reg(pre.n + 1);
        let load = "  ".concat(pp).concat(" = getelementptr i8, ptr %p, i64 ").concat(cg_payload_offset(i).to_string()).concat("\n")
            .concat("  ").concat(pv).concat(" = load ").concat(cg_llvm_ty(cg_of_ity(ptys[i]))).concat(", ptr ").concat(pp).concat("\n");
        let r = cg_render_val(t, ptys[i], pv, pre.n + 2);
        let app = cg_str_append(pre.val, r.val, r.n);
        cg_enum_str_payloads(t, ptys, i + 1, app.val,
            code.concat(pre.code).concat(load).concat(r.code).concat(app.code),
            consts.concat(pre.consts).concat(r.consts), app.n)
    }

// Array-then-join, like `cg_emit_insts`: one generated function per
// type, and appending each onto a growing string is quadratic.
let cg_emit_eq_fns (p: CgProgram) (ts: Array[typecheck.ITy]) (i: Int) (acc: String): String =
    Array.concat_all(cg_emit_eq_fns_acc(p, ts, 0, []))

let cg_emit_eq_fns_acc (p: CgProgram) (ts: Array[typecheck.ITy]) (i: Int) (acc: Array[String]): Array[String] =
    if i >= ts.len() { acc } else { cg_emit_eq_fns_acc(p, ts, i + 1, acc.push(cg_emit_eq_fn(p, ts[i]))) }

let cg_emit_eq_fn (p: CgProgram) (t: typecheck.ITy): String =
    match t {
        ITStruct(name, args) =>
            if name == "Array" { cg_emit_array_eq(t, args[0]) }
            else if cg_is_handle_name(name) { "" }
            else { cg_emit_struct_eq(t, Array.map(typecheck.ctx_field_types(p.ctx, name), |ft| typecheck.instantiate_template(typecheck.ctx_struct_generics(p.ctx, name), args, ft))) },
        ITEnum(name, args) => cg_emit_enum_eq(p, t, cg_find_enum(p, name).variants, args),
        ITTuple(elems) => cg_emit_struct_eq(t, elems),
        // `Ref` equality is IDENTITY, not structural: two cells holding
        // equal values are still two different cells. That is the whole
        // point of an explicit shared-mutable reference, and it is what
        // `exec_corpus/refs` pins down — `a == b` is true only when
        // both name the same cell.
        ITRef(_) =>
            "define i1 ".concat(cg_eq_sym(t)).concat("(ptr %a, ptr %b) {\nentry:\n")
                .concat("  %r = icmp eq ptr %a, %b\n  ret i1 %r\n}\n\n"),
        _ => "",
    }

// Fields compared in declared order, AND-ed together. No
// short-circuiting: every field is loaded anyway, and a branch per
// field would be more code for no saved work.
let cg_emit_struct_eq (t: typecheck.ITy) (field_tys: Array[typecheck.ITy]): String = {
    let body = cg_eq_fields(field_tys, 0, "%a", "%b", 0, "1", "");
    "define i1 ".concat(cg_eq_sym(t)).concat("(ptr %a, ptr %b) {\nentry:\n").concat(body.code)
        .concat("  ret i1 ").concat(body.val).concat("\n}\n\n")
}

let cg_eq_fields (field_tys: Array[typecheck.ITy]) (i: Int) (av: String) (bv: String) (n: Int) (running: String) (acc: String): EqEmit =
    if i >= field_tys.len() { EqEmit { code: acc, val: running, n: n } }
    else {
        let lty = cg_llvm_ty(cg_of_ity(field_tys[i]));
        let off = cg_field_offset(i).to_string();
        let ap = cg_reg(n);
        let bp = cg_reg(n + 1);
        let axv = cg_reg(n + 2);
        let bxv = cg_reg(n + 3);
        let loads = "  ".concat(ap).concat(" = getelementptr i8, ptr ").concat(av).concat(", i64 ").concat(off).concat("\n")
            .concat("  ").concat(bp).concat(" = getelementptr i8, ptr ").concat(bv).concat(", i64 ").concat(off).concat("\n")
            .concat("  ").concat(axv).concat(" = load ").concat(lty).concat(", ptr ").concat(ap).concat("\n")
            .concat("  ").concat(bxv).concat(" = load ").concat(lty).concat(", ptr ").concat(bp).concat("\n");
        let cmp = cg_eq_code(field_tys[i], axv, bxv, n + 4);
        let joined = cg_reg(cmp.n);
        let join = "  ".concat(joined).concat(" = and i1 ").concat(running).concat(", ").concat(cmp.val).concat("\n");
        cg_eq_fields(field_tys, i + 1, av, bv, cmp.n + 1, joined, acc.concat(loads).concat(cmp.code).concat(join))
    }

// Tags first; equal tags then dispatch to a per-variant payload
// comparison. A nullary variant needs no block of its own — it falls
// through to `yes`, which is also the `switch` default, so the common
// case (`tok == TokEof`) is one integer compare and a jump.
let cg_emit_enum_eq (p: CgProgram) (t: typecheck.ITy) (vs: Array[CgVariant]) (args: Array[typecheck.ITy]): String = {
    let head = "define i1 ".concat(cg_eq_sym(t)).concat("(ptr %a, ptr %b) {\nentry:\n")
        .concat("  %tap = getelementptr i8, ptr %a, i64 ").concat(cg_tag_offset(()).to_string()).concat("\n")
        .concat("  %ta = load i64, ptr %tap\n")
        .concat("  %tbp = getelementptr i8, ptr %b, i64 ").concat(cg_tag_offset(()).to_string()).concat("\n")
        .concat("  %tb = load i64, ptr %tbp\n")
        .concat("  %same = icmp eq i64 %ta, %tb\n")
        .concat("  br i1 %same, label %payload, label %no\n")
        .concat("payload:\n")
        .concat("  switch i64 %ta, label %yes [\n").concat(cg_enum_eq_cases(vs, 0, "")).concat("  ]\n");
    head.concat(cg_enum_eq_blocks(p, vs, args, 0, 0, ""))
        .concat("yes:\n  ret i1 1\nno:\n  ret i1 0\n}\n\n")
}

let cg_enum_eq_cases (vs: Array[CgVariant]) (i: Int) (acc: String): String =
    if i >= vs.len() { acc }
    else if vs[i].arity == 0 { cg_enum_eq_cases(vs, i + 1, acc) }
    else { cg_enum_eq_cases(vs, i + 1, acc.concat("    i64 ").concat(vs[i].tag.to_string()).concat(", label %V").concat(vs[i].tag.to_string()).concat("\n")) }

let cg_enum_eq_blocks (p: CgProgram) (vs: Array[CgVariant]) (args: Array[typecheck.ITy]) (i: Int) (n: Int) (acc: String): String =
    if i >= vs.len() { acc }
    else if vs[i].arity == 0 { cg_enum_eq_blocks(p, vs, args, i + 1, n, acc) }
    else {
        let payload = Array.map(typecheck.ctx_variant_payload(p.ctx, vs[i].enum_name, vs[i].name), |q| typecheck.instantiate_template(typecheck.ctx_variant_generics(p.ctx, vs[i].enum_name, vs[i].name), args, q));
        let body = cg_eq_payloads(payload, 0, n, "1", "");
        let block = "V".concat(vs[i].tag.to_string()).concat(":\n").concat(body.code).concat("  ret i1 ").concat(body.val).concat("\n");
        cg_enum_eq_blocks(p, vs, args, i + 1, body.n, acc.concat(block))
    }

let cg_eq_payloads (payload: Array[typecheck.ITy]) (i: Int) (n: Int) (running: String) (acc: String): EqEmit =
    if i >= payload.len() { EqEmit { code: acc, val: running, n: n } }
    else {
        let lty = cg_llvm_ty(cg_of_ity(payload[i]));
        let off = cg_payload_offset(i).to_string();
        let ap = cg_reg(n);
        let bp = cg_reg(n + 1);
        let axv = cg_reg(n + 2);
        let bxv = cg_reg(n + 3);
        let loads = "  ".concat(ap).concat(" = getelementptr i8, ptr %a, i64 ").concat(off).concat("\n")
            .concat("  ").concat(bp).concat(" = getelementptr i8, ptr %b, i64 ").concat(off).concat("\n")
            .concat("  ").concat(axv).concat(" = load ").concat(lty).concat(", ptr ").concat(ap).concat("\n")
            .concat("  ").concat(bxv).concat(" = load ").concat(lty).concat(", ptr ").concat(bp).concat("\n");
        let cmp = cg_eq_code(payload[i], axv, bxv, n + 4);
        let joined = cg_reg(cmp.n);
        let join = "  ".concat(joined).concat(" = and i1 ").concat(running).concat(", ").concat(cmp.val).concat("\n");
        cg_eq_payloads(payload, i + 1, cmp.n + 1, joined, acc.concat(loads).concat(cmp.code).concat(join))
    }

// Lengths, then element by element, bailing on the first difference.
let cg_emit_array_eq (t: typecheck.ITy) (elem: typecheck.ITy): String = {
    let lty = cg_llvm_ty(cg_of_ity(elem));
    let cmp = cg_eq_code(elem, "%av", "%bv", 0);
    "define i1 ".concat(cg_eq_sym(t)).concat("(ptr %a, ptr %b) {\nentry:\n")
        .concat("  %lap = getelementptr i8, ptr %a, i64 8\n")
        .concat("  %la = load i64, ptr %lap\n")
        .concat("  %lbp = getelementptr i8, ptr %b, i64 8\n")
        .concat("  %lb = load i64, ptr %lbp\n")
        .concat("  %samelen = icmp eq i64 %la, %lb\n")
        .concat("  %ip = alloca i64\n")
        .concat("  store i64 0, ptr %ip\n")
        .concat("  br i1 %samelen, label %loop, label %no\n")
        .concat("loop:\n")
        .concat("  %i = load i64, ptr %ip\n")
        .concat("  %more = icmp slt i64 %i, %la\n")
        .concat("  br i1 %more, label %body, label %yes\n")
        .concat("body:\n")
        .concat("  %off = mul i64 %i, 8\n")
        .concat("  %ap0 = getelementptr i8, ptr %a, i64 %off\n")
        .concat("  %ap = getelementptr i8, ptr %ap0, i64 ").concat(cg_array_elem_offset(0).to_string()).concat("\n")
        .concat("  %bp0 = getelementptr i8, ptr %b, i64 %off\n")
        .concat("  %bp = getelementptr i8, ptr %bp0, i64 ").concat(cg_array_elem_offset(0).to_string()).concat("\n")
        .concat("  %av = load ").concat(lty).concat(", ptr %ap\n")
        .concat("  %bv = load ").concat(lty).concat(", ptr %bp\n")
        .concat(cmp.code)
        .concat("  br i1 ").concat(cmp.val).concat(", label %next, label %no\n")
        .concat("next:\n")
        .concat("  %i1 = add i64 %i, 1\n")
        .concat("  store i64 %i1, ptr %ip\n")
        .concat("  br label %loop\n")
        .concat("yes:\n  ret i1 1\nno:\n  ret i1 0\n}\n\n")
}

// --- Reference counting ---
//
// **The ownership discipline, stated once.**
//
//   1. Every expression evaluates to an OWNED reference (+1). The
//      evaluator of an expression is responsible for it.
//   2. A SLOT (a `let` binding, a parameter, a pattern binding) holds
//      an owned reference, and is released when the slot dies.
//   3. Reading a variable produces a NEW owned reference, so a read
//      increments. The slot keeps its own.
//   4. A call CONSUMES its arguments: the callee owns them and releases
//      them, exactly as it releases its own locals. A returned value
//      carries its +1 out.
//   5. An aggregate OWNS its fields/payload/elements/captures: values
//      stored into a cell transfer their +1 into it.
//
// Every one of those is local. There is no liveness analysis here and
// no reuse: this is precise reference counting, which is the thing
// Perceus is an optimization OF. The real backend's FBIP pass would sit
// on top of exactly this, and the cost of not having it is redundant
// inc/dec pairs, not incorrectness.
//
// Deciding WHICH values need any of this is where the typed tree pays
// off again. `plum-ir/src/fbip.rs` cannot track function parameters at
// all — its own comment says why: "no type checker in this IR to prove
// one is heap-shaped". Here every node's type is known, so
// `cg_is_heap` is total and exact.

// A heap slot starts as null, so that releasing whatever it held before
// an overwrite is safe on the very FIRST write — where "before" is
// uninitialised stack.
let cg_null_init (t: typecheck.ITy) (slot: String): String =
    if cg_rc_enabled(()) && cg_is_heap(cg_of_ity(t)) { "  store ptr null, ptr ".concat(slot).concat("\n") } else { "" }

// Release whatever a slot currently holds. Emitted twice for each slot,
// at different places — before an overwrite, and at function exit — so
// the scratch register is derived from the slot's own (already unique)
// name plus a distinguishing suffix.
let cg_release_slot (t: typecheck.ITy) (slot: String) (suffix: String): String =
    if cg_rc_enabled(()) && cg_is_heap(cg_of_ity(t)) {
        "  ".concat(slot).concat(suffix).concat(" = load ptr, ptr ").concat(slot).concat("\n")
            .concat("  call void ").concat(cg_rel_sym(t)).concat("(ptr ").concat(slot).concat(suffix).concat(")\n")
    } else { "" }

// **Reference counting is ON.** `sh2` frees what it allocates: peak RSS
// type-checking the whole compiler went from 6,415 MB to 755 MB, an
// 8.5x reduction, and the bootstrap fixed point still holds.
//
// The discipline, stated once:
//
//   1. Every expression evaluates to an OWNED reference (+1).
//   2. A slot (a `let`, a parameter, a pattern binding) holds an owned
//      reference and releases it when the slot dies.
//   3. Reading a variable produces a NEW owned reference, so a read
//      increments. The slot keeps its own.
//   4. A call CONSUMES its arguments; a returned value carries its +1
//      out.
//   5. An aggregate OWNS what is stored into it.
//
// Every rule is local — no liveness analysis, no reuse. This is precise
// reference counting, which is the thing Perceus is an optimization OF;
// the real backend's FBIP pass would sit on top of exactly this, and
// the cost of not having it is redundant inc/dec pairs, not
// incorrectness.
//
// Deciding WHAT needs counting is where the typed tree pays off.
// `plum-ir/src/fbip.rs` cannot track function parameters at all — its
// own comment gives the reason, "no type checker in this IR to prove
// one is heap-shaped", which is the documented root cause of the gap-1
// work reverted earlier in this project. Here every node's type is
// known, so `cg_is_heap` is total and exact and parameters are counted
// like anything else.
//
// The switch remains because it is genuinely useful: flipping it to
// `false` emits the leaking version, which is a one-line way to tell a
// counting bug apart from any other kind.
//
// This used to carry a note claiming a closure cell's captures could
// never be released, "because a closure's captures are not visible
// from its type and its release cannot walk them". That was WRONG, and
// it was wrong about this backend's own code: a closure cell has
// carried a release-function pointer at offset 16 all along, and
// `<fn>_rel` — emitted next to each lifted function, where the capture
// list is known — walks exactly the captures that literal took. The
// machinery was complete; one caller simply never reached it.
//
// The actual bug was a single missing decrement: `cg_call_closure_
// value` took its callee OWNED (`cg_expr` increments when it reads a
// variable) but invoking a closure does not consume it, so the
// reference taken to make the call was never given back. See that
// function. `exec_corpus` is now leak-free end to end under ASan.
let cg_rc_enabled (unit: Unit): Bool = true

let cg_is_heap (t: CgTy): Bool =
    match t {
        CgInt => false, CgFloat => false, CgBool => false, CgUnit => false,
        // NOT heap: a `CStr` is a borrowed `char*`, owned by whatever
        // produced it -- a string cell that outlives the call, or the C
        // side. Nothing here increments or frees one.
        CgCStr => false,
        CgHandle(_) => true,
        CgStr => true, CgStruct(_) => true, CgEnum(_) => true, CgArray(_) => true, CgClosure(_, _) => true, CgRef(_) => true,
        CgTuple(_) => true,
    }

// After `memcpy`ing %n elements into a new array cell: the copy needs
// its own reference to each, or both cells release the same children.
let cg_inc_elems (elem: CgTy) (cell: String) (len: String) (reg: String): String =
    if cg_rc_enabled(()) && cg_is_heap(elem) {
        "  ".concat(reg).concat(" = call i1 @plum_array_inc_elems(ptr ").concat(cell).concat(", i64 ").concat(len).concat(")\n")
    } else { "" }

// Releasing something whose type is only known as a representation.
// Only closures reach this: their release frees the cell without
// walking captures, and a `CgClosure` carries enough to name that
// function.
let cg_dec_cg (t: CgTy) (val: String): String =
    match t {
        CgClosure(ptys, ret) => if cg_rc_enabled(()) { "  call void @plum_rel_closure(ptr ".concat(val).concat(")\n") } else { "" },
        _ => "",
    }

// Releasing the ARGUMENTS of a call into the runtime.
//
// Rule 4 says a call consumes its arguments — but that rule is about
// PLUM functions, which release their parameter slots on the way out.
// The runtime's own functions are hand-written IR that does no
// counting, so they BORROW instead, and the caller has to release.
//
// Getting this wrong is only ever a leak, and it was the dominant one:
// the compiler concatenates strings constantly, and every `.concat()`,
// `.to_string()`, `.len()` and `println()` was dropping both a +1 on
// the floor.
let cg_dec_args (p: CgProgram) (args: Array[typecheck.TExpr]) (vals: Array[String]) (i: Int) (acc: String): String =
    if i >= args.len() || i >= vals.len() { acc }
    // `vals` are already `<ty> <operand>` pairs, as a call needs them,
    // so the release is written with the operand as given rather than
    // re-prefixing a type.
    else { cg_dec_args(p, args, vals, i + 1, acc.concat(cg_dec_op(cg_concrete(p, typecheck.texpr_ty(p.subst, args[i])), vals[i]))) }

let cg_dec_op (t: typecheck.ITy) (operand: String): String =
    if cg_rc_enabled(()) && cg_is_heap(cg_of_ity(t)) { "  call void ".concat(cg_rel_sym(t)).concat("(").concat(operand).concat(")\n") } else { "" }

// --- Borrowing ---
//
// The single biggest source of redundant traffic: reading a variable
// increments, the operation uses it, and then it is released again.
// When the operand is a plain variable read, that pair is provably
// redundant — the SLOT holds a reference for the whole of a
// straight-line primitive operation, so the object cannot be freed
// underneath it. Skipping both is sound and removes the inc/dec pair
// entirely.
//
// This is the first step of what FBIP does properly. Perceus decides it
// with a liveness analysis (`plum-ir/src/fbip.rs`'s `mark_last_uses`);
// this decides it syntactically, which is weaker but needs no analysis
// and covers the overwhelmingly common shapes — `xs[i]`, `p.field`,
// `s.len()`, `println(msg)`, `a.concat(b)`, `match tok { .. }`.
//
// `drop` is what the caller must emit after the operand is finished
// with: empty for a borrow, a release for an owned temporary.
struct BorrowEmit { code: String, allocas: String, releases: String, globals: String, val: String, ty: CgTy, drop: String, n: Int }

let cg_borrow (p: CgProgram) (env: Array[CgSlot]) (n: Int) (e: typecheck.TExpr): BorrowEmit =
    match e.node {
        TIdent(name) => match cg_lookup(env, name) {
            Some(slot) => {
                let reg = cg_reg(n);
                BorrowEmit {
                    code: "  ".concat(reg).concat(" = load ").concat(cg_llvm_ty(slot.ty)).concat(", ptr ").concat(slot.ptr).concat("\n"),
                    allocas: "", releases: "", globals: "", val: reg, ty: slot.ty, drop: "", n: n + 1,
                }
            },
            None => cg_borrow_owned(p, env, n, e),
        },
        _ => cg_borrow_owned(p, env, n, e),
    }

let cg_borrow_owned (p: CgProgram) (env: Array[CgSlot]) (n: Int) (e: typecheck.TExpr): BorrowEmit = {
    let r = cg_expr(p, env, n, e);
    BorrowEmit {
        code: r.code, allocas: r.allocas, releases: r.releases, globals: r.globals,
        val: r.val, ty: r.ty, drop: cg_dec(cg_concrete(p, typecheck.texpr_ty(p.subst, e)), r.val), n: r.n,
    }
}

let cg_inc (t: CgTy) (val: String): String =
    if cg_rc_enabled(()) && cg_is_heap(t) { "  call void @plum_rc_inc(ptr ".concat(val).concat(")\n") } else { "" }

let cg_dec (t: typecheck.ITy) (val: String): String =
    if cg_rc_enabled(()) && cg_is_heap(cg_of_ity(t)) { "  call void ".concat(cg_rel_sym(t)).concat("(ptr ").concat(val).concat(")\n") } else { "" }

// A release function per TYPE, not per value, so a cell's children can
// be released without any runtime type information — the same shape as
// the equality functions, discovered by the same worklist.
//
// A `String` needs no generated function (it owns nothing), so it uses
// the runtime's plain one.
let cg_rel_sym (t: typecheck.ITy): String =
    match t { ITStr => "@plum_rel_str", _ => "@plum_rel_".concat(cg_ity_mangle(t)) }

// Types needing a generated release function, transitively. Same
// `seen`-guarded closure as `cg_eq_close`, and terminating for the same
// reason.
let cg_rel_close (p: CgProgram) (t: typecheck.ITy) (acc: Array[typecheck.ITy]): Array[typecheck.ITy] =
    if !cg_rc_enabled(()) { acc }
    else if !cg_is_heap(cg_of_ity(t)) { acc }
    else if cg_ty_in(acc, t, 0) { acc }
    else {
        match t {
            // A string owns nothing; the runtime releases it.
            ITStr => acc,
            _ => {
                let acc2 = acc.push(t);
                match t {
                    ITStruct(name, args) =>
                        // A handle owns no FIELDS -- there is no
                        // declaration to look them up in -- but its
                        // release function names the ELEMENT's, to
                        // clean up values still in flight, so that one
                        // has to exist.
                        if cg_is_handle_name(name) { cg_rel_close(p, args[0], acc2) }
                        else if name == "Array" { cg_rel_close(p, args[0], acc2) }
                        else { cg_rel_close_list(p, Array.map(typecheck.ctx_field_types(p.ctx, name), |ft| typecheck.instantiate_template(typecheck.ctx_struct_generics(p.ctx, name), args, ft)), 0, acc2) },
                    ITEnum(name, args) => cg_rel_close_variants(p, cg_find_enum(p, name).variants, args, 0, acc2),
                    ITTuple(elems) => cg_rel_close_list(p, elems, 0, acc2),
                    // A closure's captures are not visible from its
                    // type, so its cell cannot be walked structurally.
                    // Releasing one frees the cell and LEAKS whatever it
                    // captured — a real, bounded hole, and the reason
                    // the real backend stores a release-function pointer
                    // in every closure cell. Stated rather than hidden.
                    _ => acc2,
                }
            },
        }
    }

let cg_rel_close_list (p: CgProgram) (ts: Array[typecheck.ITy]) (i: Int) (acc: Array[typecheck.ITy]): Array[typecheck.ITy] =
    if i >= ts.len() { acc } else { cg_rel_close_list(p, ts, i + 1, cg_rel_close(p, ts[i], acc)) }

let cg_rel_close_variants (p: CgProgram) (vs: Array[CgVariant]) (args: Array[typecheck.ITy]) (i: Int) (acc: Array[typecheck.ITy]): Array[typecheck.ITy] =
    if i >= vs.len() { acc }
    else {
        let payload = Array.map(typecheck.ctx_variant_payload(p.ctx, vs[i].enum_name, vs[i].name), |t| typecheck.instantiate_template(typecheck.ctx_variant_generics(p.ctx, vs[i].enum_name, vs[i].name), args, t));
        cg_rel_close_variants(p, vs, args, i + 1, cg_rel_close_list(p, payload, 0, acc))
    }

// Array-then-join, like `cg_emit_insts`: one generated function per
// type, and appending each onto a growing string is quadratic.
let cg_emit_rel_fns (p: CgProgram) (ts: Array[typecheck.ITy]) (i: Int) (acc: String): String =
    Array.concat_all(cg_emit_rel_fns_acc(p, ts, 0, []))

let cg_emit_rel_fns_acc (p: CgProgram) (ts: Array[typecheck.ITy]) (i: Int) (acc: Array[String]): Array[String] =
    if i >= ts.len() { acc } else {
        cg_emit_rel_fns_acc(p, ts, i + 1, acc.push(cg_emit_rel_fn(p, ts[i])).push(cg_emit_relc_fn(p, ts[i])))
    }

// The companion to a release function: drop this cell's children and
// leave the cell alone. Reuse needs it and nothing else does.
//
// Emitted only for ENUMS that own references. A struct's children are
// dropped inline at the reuse site, because its layout is fixed and the
// drops are three instructions per heap field; an enum's depend on the
// runtime TAG, so the same walk would mean emitting the whole switch at
// every reuse site. Generating it once per type is the trade, and
// restricting it to enums that own something keeps a mostly-dead
// parallel family of 301 functions from appearing in every module.
//
// No refcount check and no null check on the payloads beyond what
// `cg_rel_children` already emits: this is only ever called under a
// runtime `rc == 1`, so the cell is live and solely owned by
// definition.
let cg_emit_relc_fn (p: CgProgram) (t: typecheck.ITy): String =
    match t {
        ITEnum(name, args) => {
            let vs = cg_find_enum(p, name).variants;
            if cg_enum_owns(p, vs, args, 0) {
                "define void ".concat(cg_relc_sym(t)).concat("(ptr %p) {\nentry:\n")
                    .concat("  %isnull = icmp eq ptr %p, null\n")
                    .concat("  br i1 %isnull, label %done, label %live\n")
                    .concat("live:\n")
                    .concat("  %tp = getelementptr i8, ptr %p, i64 ").concat(cg_tag_offset(()).to_string()).concat("\n")
                    .concat("  %tag = load i64, ptr %tp\n")
                    .concat("  switch i64 %tag, label %done [\n").concat(cg_rel_cases(p, vs, args, 0, "")).concat("  ]\n")
                    .concat(cg_rel_blocks(p, vs, args, 0, 0, ""))
                    .concat("done:\n  ret void\n}\n\n")
            } else { "" }
        },
        _ => "",
    }

let cg_enum_owns (p: CgProgram) (vs: Array[CgVariant]) (args: Array[typecheck.ITy]) (i: Int): Bool =
    if i >= vs.len() { false }
    else if cg_variant_owns(p, vs[i], args) { true }
    else { cg_enum_owns(p, vs, args, i + 1) }

let cg_relc_sym (t: typecheck.ITy): String = "@plum_relc_".concat(cg_ity_mangle(t))

// Every release function has the same shape: decrement, and on reaching
// zero release the children and free the cell.
let cg_rel_head (t: typecheck.ITy): String =
    "define void ".concat(cg_rel_sym(t)).concat("(ptr %p) {\nentry:\n")
        .concat("  %isnull = icmp eq ptr %p, null\n")
        .concat("  br i1 %isnull, label %skip, label %live\n")
        .concat("skip:\n  ret void\nlive:\n")
        .concat("  %rc = load i64, ptr %p\n")
        .concat("  %static = icmp slt i64 %rc, 0\n")
        .concat("  br i1 %static, label %skip, label %dec\n")
        .concat("dec:\n")
        .concat("  %rc1 = sub i64 %rc, 1\n")
        .concat("  store i64 %rc1, ptr %p\n")
        .concat("  %dead = icmp sle i64 %rc1, 0\n")
        .concat("  br i1 %dead, label %free, label %alive\n")
        .concat("alive:\n  ret void\nfree:\n")

let cg_rel_tail (unit: Unit): String = "  call void @free(ptr %p)\n  ret void\n}\n\n"

pub let cg_is_handle_name (name: String): Bool = name == "Sender" || name == "Receiver" || name == "Task"

// Releasing a handle cell is the ordinary dec-and-free, plus the one
// thing that made this whole change worth doing: at zero, the resource
// BEHIND the handle is told to go.
//
// `Sender` and `Receiver` are two cells over one queue, which is why
// the queue carries its own count and `@channel_release` frees it only
// when the second end lets go. A `Task` has one cell, and letting go
// of it without joining detaches the thread.
//
// The element's release function is passed along because values may
// still be IN FLIGHT -- queued and never received, or a result nobody
// joined -- and freeing the queue has to release them too. `null` for
// an element type that owns nothing, which the shim checks for.
let cg_handle_release_call (name: String) (rel: String): String =
    if name == "Task" { "  call void @task_release(i64 %h, ptr ".concat(rel).concat(")\n") }
    else { "  call void @channel_release(i64 %h, ptr ".concat(rel).concat(")\n") }

let cg_emit_handle_rel (p: CgProgram) (t: typecheck.ITy) (name: String) (elem: typecheck.ITy): String = {
    let rel = if cg_is_heap(cg_of_ity(cg_concrete(p, elem))) { cg_rel_sym(cg_concrete(p, elem)) } else { "null" };
    "define void ".concat(cg_rel_sym(t)).concat("(ptr %p) {\nentry:\n")
        .concat("  %isnull = icmp eq ptr %p, null\n")
        .concat("  br i1 %isnull, label %skip, label %live\n")
        .concat("skip:\n  ret void\n")
        .concat("live:\n")
        .concat("  %rc = load i64, ptr %p\n")
        .concat("  %static = icmp slt i64 %rc, 0\n")
        .concat("  br i1 %static, label %skip, label %dec\n")
        .concat("dec:\n")
        .concat("  %rc1 = sub i64 %rc, 1\n")
        .concat("  store i64 %rc1, ptr %p\n")
        .concat("  %dead = icmp sle i64 %rc1, 0\n")
        .concat("  br i1 %dead, label %gone, label %alive\n")
        .concat("alive:\n  ret void\n")
        .concat("gone:\n")
        .concat("  %hp = getelementptr i8, ptr %p, i64 8\n")
        .concat("  %h = load i64, ptr %hp\n")
        .concat(cg_handle_release_call(name, rel))
        .concat("  call void @free(ptr %p)\n")
        .concat("  ret void\n}\n\n")
}

let cg_emit_rel_fn (p: CgProgram) (t: typecheck.ITy): String =
    match t {
        ITStruct(name, args) =>
            if cg_is_handle_name(name) { cg_emit_handle_rel(p, t, name, args[0]) }
            else if name == "Array" { cg_emit_array_rel(t, args[0]) }
            else { cg_emit_struct_rel(t, Array.map(typecheck.ctx_field_types(p.ctx, name), |ft| typecheck.instantiate_template(typecheck.ctx_struct_generics(p.ctx, name), args, ft))) },
        ITEnum(name, args) => cg_emit_enum_rel(p, t, cg_find_enum(p, name).variants, args),
        ITTuple(elems) => cg_emit_struct_rel(t, elems),
        // A `Ref` cell is `{ i64 rc, value }` — byte-for-byte the
        // layout of a ONE-FIELD struct, value at offset 8. So the
        // struct release path is not merely similar, it is exactly
        // right: release the single child, then free the cell.
        ITRef(inner) => cg_emit_struct_rel(t, [inner]),
        // DELEGATES to `@plum_rel_closure` rather than doing its own
        // dec-and-free. A closure cell carries a release-function
        // pointer at offset 16 that walks exactly the captures that
        // literal took (`<fn>_rel`, emitted with the lifted function);
        // `plum_rel_closure` is what loads and calls it. Open-coding
        // the usual head/tail here instead freed the cell WITHOUT ever
        // consulting that pointer, so every capture held by a closure
        // reached through a struct field or a generic was leaked.
        //
        // This is also why the note above about captures being
        // impossible to release was wrong: the machinery was already
        // there, and one release path simply wasn't using it.
        ITFunction(_, _) =>
            "define void ".concat(cg_rel_sym(t)).concat("(ptr %p) {\nentry:\n")
                .concat("  call void @plum_rel_closure(ptr %p)\n  ret void\n}\n\n"),
        _ => "",
    }

let cg_emit_struct_rel (t: typecheck.ITy) (field_tys: Array[typecheck.ITy]): String =
    cg_rel_head(t).concat(cg_rel_children(field_tys, 0, 0, "", false)).concat(cg_rel_tail(()))

// Loads each owned child and releases it. `is_payload` picks the offset
// family — a struct's fields start right after the refcount, an enum's
// payload after the refcount and tag.
let cg_rel_children (tys: Array[typecheck.ITy]) (i: Int) (n: Int) (acc: String) (is_payload: Bool): String =
    if i >= tys.len() { acc }
    else if !cg_is_heap(cg_of_ity(tys[i])) { cg_rel_children(tys, i + 1, n, acc, is_payload) }
    else {
        let off = if is_payload { cg_payload_offset(i) } else { cg_field_offset(i) };
        let fp = "%rp".concat(n.to_string());
        let fv = "%rv".concat(n.to_string());
        let line = "  ".concat(fp).concat(" = getelementptr i8, ptr %p, i64 ").concat(off.to_string()).concat("\n")
            .concat("  ").concat(fv).concat(" = load ptr, ptr ").concat(fp).concat("\n")
            .concat("  call void ").concat(cg_rel_sym(tys[i])).concat("(ptr ").concat(fv).concat(")\n");
        cg_rel_children(tys, i + 1, n + 1, acc.concat(line), is_payload)
    }

let cg_emit_enum_rel (p: CgProgram) (t: typecheck.ITy) (vs: Array[CgVariant]) (args: Array[typecheck.ITy]): String = {
    let head = cg_rel_head(t)
        .concat("  %tp = getelementptr i8, ptr %p, i64 ").concat(cg_tag_offset(()).to_string()).concat("\n")
        .concat("  %tag = load i64, ptr %tp\n")
        .concat("  switch i64 %tag, label %done [\n").concat(cg_rel_cases(p, vs, args, 0, "")).concat("  ]\n");
    head.concat(cg_rel_blocks(p, vs, args, 0, 0, "")).concat("done:\n").concat(cg_rel_tail(()))
}

// Only variants with a heap-shaped payload need a block; the rest fall
// through to the default and just free the cell.
let cg_rel_cases (p: CgProgram) (vs: Array[CgVariant]) (args: Array[typecheck.ITy]) (i: Int) (acc: String): String =
    if i >= vs.len() { acc }
    else if !cg_variant_owns(p, vs[i], args) { cg_rel_cases(p, vs, args, i + 1, acc) }
    else { cg_rel_cases(p, vs, args, i + 1, acc.concat("    i64 ").concat(vs[i].tag.to_string()).concat(", label %R").concat(vs[i].tag.to_string()).concat("\n")) }

let cg_variant_owns (p: CgProgram) (v: CgVariant) (args: Array[typecheck.ITy]): Bool =
    Array.any(cg_variant_payload_tys(p, v, args), |t| cg_is_heap(cg_of_ity(t)))

let cg_variant_payload_tys (p: CgProgram) (v: CgVariant) (args: Array[typecheck.ITy]): Array[typecheck.ITy] =
    Array.map(typecheck.ctx_variant_payload(p.ctx, v.enum_name, v.name), |t| typecheck.instantiate_template(typecheck.ctx_variant_generics(p.ctx, v.enum_name, v.name), args, t))

let cg_rel_blocks (p: CgProgram) (vs: Array[CgVariant]) (args: Array[typecheck.ITy]) (i: Int) (n: Int) (acc: String): String =
    if i >= vs.len() { acc }
    else if !cg_variant_owns(p, vs[i], args) { cg_rel_blocks(p, vs, args, i + 1, n, acc) }
    else {
        let block = "R".concat(vs[i].tag.to_string()).concat(":\n")
            .concat(cg_rel_children(cg_variant_payload_tys(p, vs[i], args), 0, n, "", true))
            .concat("  br label %done\n");
        cg_rel_blocks(p, vs, args, i + 1, n + 100, acc.concat(block))
    }

let cg_emit_array_rel (t: typecheck.ITy) (elem: typecheck.ITy): String =
    if !cg_is_heap(cg_of_ity(elem)) { cg_rel_head(t).concat(cg_rel_tail(())) }
    else {
        cg_rel_head(t)
            .concat("  %lp = getelementptr i8, ptr %p, i64 8\n")
            .concat("  %len = load i64, ptr %lp\n")
            .concat("  %ip = alloca i64\n")
            .concat("  store i64 0, ptr %ip\n")
            .concat("  br label %loop\n")
            .concat("loop:\n")
            .concat("  %i = load i64, ptr %ip\n")
            .concat("  %more = icmp slt i64 %i, %len\n")
            .concat("  br i1 %more, label %body, label %done\n")
            .concat("body:\n")
            .concat("  %off = mul i64 %i, 8\n")
            .concat("  %ep0 = getelementptr i8, ptr %p, i64 %off\n")
            .concat("  %ep = getelementptr i8, ptr %ep0, i64 ").concat(cg_array_elem_offset(0).to_string()).concat("\n")
            .concat("  %ev = load ptr, ptr %ep\n")
            .concat("  call void ").concat(cg_rel_sym(elem)).concat("(ptr %ev)\n")
            .concat("  %i1 = add i64 %i, 1\n")
            .concat("  store i64 %i1, ptr %ip\n")
            .concat("  br label %loop\n")
            .concat("done:\n")
            .concat(cg_rel_tail(()))
    }

// --- Emitting the whole program ---
//
// Only what is REACHABLE from `main` is emitted, which falls out of
// monomorphization rather than being a separate dead-code pass: a
// generic function has no single symbol to emit until a call site says
// which instantiation it needs, so the worklist has to start from the
// entry point anyway. Monomorphic functions come along the same way.
// The PRELUDE is prepended to the user's items before anything is
// checked or compiled, exactly as the real compiler prepends its own.
// Prepending (rather than appending) is what makes a user definition of
// the same name WIN — `find_sig` scans in order, so a later declaration
// shadows the prelude's, which is the real compiler's behaviour too.
// One `declare` per `extern "C"` function in the program, emitted
// whether or not it is reached: a declaration costs nothing in the
// output, and filtering by reachability would mean threading extern
// names through the same worklist that exists to decide which BODIES to
// emit -- externs have no bodies.
let cg_emit_extern_decls (items: Array[parser.ItemNode]) (i: Int) (acc: String): String =
    if i >= items.len() { acc }
    else {
        match items[i].kind {
            IKExtern(block) => cg_emit_extern_decls(items, i + 1, acc.concat(cg_extern_decl_list(block.fns, 0, ""))),
            _ => cg_emit_extern_decls(items, i + 1, acc),
        }
    }

let cg_extern_decl_list (fns: Array[parser.ExternFnNode]) (i: Int) (acc: String): String =
    if i >= fns.len() { acc }
    else {
        let ret = match fns[i].ret_ty { Some(t) => cg_c_ty(cg_of_ann(t)), None => "void" };
        let params = cg_extern_param_tys(fns[i].params, 0, "");
        cg_extern_decl_list(fns, i + 1, acc.concat("declare ").concat(ret).concat(" @").concat(fns[i].name).concat("(").concat(params).concat(")\n"))
    }

let cg_extern_param_tys (ps: Array[parser.ExternParamNode]) (i: Int) (acc: String): String =
    if i >= ps.len() { acc }
    else {
        let t = cg_c_ty(cg_of_ann(ps[i].ty));
        cg_extern_param_tys(ps, i + 1, if acc == "" { t } else { acc.concat(", ").concat(t) })
    }

// An extern declaration's types are written directly in the AST and
// never go through inference, so they are mapped here rather than read
// off a `TExpr`. Only the C-compatible surface is accepted; anything
// else is a type the FFI boundary cannot carry.
// The C ABI's spelling of a type, which differs from Plum's in exactly
// one place: `Bool`. C's `int` is 32 bits wide and Plum's `Bool` is
// `i1`, so every crossing needs a real CONVERSION -- `zext` going out,
// a compare-against-zero coming back -- never a bitcast pretending the
// two are the same width.
//
// This was wrong in the first cut of FFI, and wrong in the silent way:
// a C function returning 2 (truthy, but not 1) truncated to `i1` and
// read as FALSE. The real backend's own marshaling notes call this "the
// one genuinely subtle piece", which is how it was found.
let cg_c_ty (t: CgTy): String = match t { CgBool => "i32", _ => cg_llvm_ty(t) }

let cg_of_ann (t: parser.Ty): CgTy =
    match t {
        TyPath(segments) => {
            let name = segments[segments.len() - 1];
            if name == "Int" { CgInt }
            else if name == "Float" { CgFloat }
            else if name == "Bool" { CgBool }
            else if name == "CStr" { CgCStr }
            else if name == "Unit" { CgUnit }
            else { { cg_fail("extern declarations can only use Int/Float/Bool/CStr/Unit, found ".concat(name)); CgInt } }
        },
        _ => { cg_fail("extern declarations can only use simple types"); CgInt },
    }

// The prelude is parsed under its OWN source path, not whatever file
// happened to be parsed last.
//
// `parse_program` stamps `parser.current_path()` onto every item it
// produces, and nothing here set one -- so prelude items inherited the
// path of the last user file `collect_project` read. Harmless for
// compiling, and wrong for anything that looks up a source POSITION:
// the checker's recorded-type table keyed prelude identifiers to the
// user's file at prelude offsets, so `plum query` could answer a
// position in your code with a prelude local. It reported `o:
// Option[T]` for a `p: Point`.
//
// `<prelude>` is not a path any file can have, so those entries can no
// longer collide with a real one. The context is restored afterwards
// because callers parse the prelude in the middle of handling a file
// and reasonably expect diagnostics to keep naming it.
pub let cg_with_prelude (program: parser.ProgramNode): parser.ProgramNode = {
    let saved = parser.current_path(());
    let src = cg_prelude_src(());
    let lexed = lexer.tokenize_spanned(src);
    parser.set_source_context("<prelude>", src, lexed.starts, lexed.ends);
    let items = parser.with_module(parser.parse_program(lexed.tokens).items, parser.PRELUDE_MODULE(()));
    parser.set_source_context(saved, "", [], []);
    // Prelude, then whichever stdlib modules the program asked for by
    // `use`, then the program itself.
    parser.ProgramNode { items: Array.concat(Array.concat(items, cg_std_items(program.items)), program.items) }
}

pub let cg_emit_program (program0: parser.ProgramNode): String = cg_emit_program_entry(program0, "main")

// Same emitter, with the entry function named. `test` uses it to
// compile a project ONCE against a synthesized dispatcher, instead of
// interpreting each test -- which is what it used to do, and why every
// test that touched the prelude failed.
pub let cg_emit_program_entry (program0: parser.ProgramNode) (entry: String): String = {
    let program = cg_with_prelude(program0);
    let p = cg_build_program(program);
    if !cg_has_fn(p, entry) { cg_fail("no top-level '".concat(entry).concat("' function to compile")) };
    // Globals are roots too: their bodies can call functions that
    // nothing else reaches.
    let insts = cg_reachable(p, cg_global_roots(p, 0, [CgInst { module: "", name: entry, targs: [] }]), [], 0);
    // Equality functions are discovered from the SAME reachable set —
    // an aggregate compared inside an unreachable function needs no
    // function emitted for it.
    let eqs = cg_eq_types_of(p, insts, 0, []);
    // Release functions are needed for every heap type that appears
    // ANYWHERE reachable, not just where `==` is used, so the closure
    // starts from every function's parameter and return types and from
    // every equality type already found.
    let rels = cg_rel_types_of(p, insts, 0, cg_rel_close_list(p, eqs, 0, []));
    let gl = cg_emit_globals(p, 0, 1000000, "", "");
    cg_runtime(())
        .concat(cg_emit_extern_decls(program.items, 0, ""))
        .concat(cg_emit_eq_fns(p, eqs, 0, ""))
        .concat(cg_emit_rel_fns(p, rels, 0, ""))
        .concat(cg_emit_str_fns(p, rels, 0, ""))
        .concat(gl.slots)
        .concat(cg_emit_insts(p, insts, 0, 0, ""))
        .concat(gl.init)
        .concat(cg_entry_named("@".concat(cg_sym("", entry, []))))
}

// Each top-level 0-parameter binding gets a module-level SLOT and one
// line in `@plum_init_globals`, which runs before `main`. Evaluating
// them once, in declaration order, is the whole point — a global
// referencing an earlier global sees an initialised slot.
//
// The register counter starts at 1,000,000 so a global's body cannot
// collide with a function's `@.str` constants. Crude, and honest about
// it: the alternative is threading the counter through two independent
// emission passes for no other benefit.
struct GlobalsEmit { slots: String, init: String }

let cg_global_dup (gs: Array[typecheck.TFn]) (module_name: String) (name: String) (j: Int) (upto: Int): Bool =
    if j >= upto { false }
    else if gs[j].name == name && gs[j].module == module_name { true }
    else { cg_global_dup(gs, module_name, name, j + 1, upto) }

let cg_emit_globals (p: CgProgram) (i: Int) (n: Int) (slots: String) (body: String): GlobalsEmit =
    if i >= p.globals.len() {
        GlobalsEmit { slots: slots, init: "define void @plum_init_globals() {\nentry:\n".concat(body).concat("  ret void\n}\n\n") }
    } else if cg_global_dup(p.globals, p.globals[i].module, p.globals[i].name, 0, i) {
        // The flat module namespace lets two modules declare the same
        // global — `UPPERCASE_CHARS` exists in both `interp.plum` and
        // `infer.plum`. `find_global_def` resolves every reference to
        // the FIRST, so only the first gets a slot; emitting the second
        // would be a duplicate symbol for a slot nothing reads.
        cg_emit_globals(p, i + 1, n, slots, body)
    } else {
        let g = p.globals[i];
        let gp = CgProgram { fns: p.fns, globals: p.globals, ctx: p.ctx, enums: p.enums, subst: g.subst, generics: [], targs: [], movable: [] };
        let ty = cg_of_ity(cg_concrete(gp, g.ret));
        let r = cg_expr(gp, [], n, g.body);
        let slot = cg_global_slot(g.module, g.name).concat(" = global ").concat(cg_llvm_ty(ty)).concat(" ").concat(cg_zero_of(ty)).concat("\n");
        let init = r.allocas.concat(r.code)
            .concat("  store ").concat(cg_llvm_ty(ty)).concat(" ").concat(r.val).concat(", ptr ").concat(cg_global_slot(g.module, g.name)).concat("\n")
            .concat(r.releases);
        cg_emit_globals(p, i + 1, r.n, slots.concat(r.globals).concat(slot), body.concat(init))
    }

// Worklist closure: pop an instantiation, record it, and push every
// instantiation its body calls. The `fuel` counter is not decoration —
// POLYMORPHIC RECURSION (`f[T]` calling `f[Array[T]]`) generates
// infinitely many specializations, and monomorphization is undecidable
// in general for it. Plum's own generics can't express it today, so
// this should never fire; if it ever does, it stops with an
// explanation rather than looping until memory runs out.
let cg_reachable (p: CgProgram) (pending: Array[CgInst]) (done: Array[CgInst]) (fuel: Int): Array[CgInst] =
    if Array.is_empty(pending) { done }
    else if fuel > 10000 { { cg_fail("monomorphization did not terminate after 10000 instantiations — polymorphic recursion?"); done } }
    else {
        let head = pending[0];
        let rest = Array.slice(pending, 1, pending.len());
        // A runtime-implemented name is already a symbol: it has no
        // Plum body to walk, and emitting one would COLLIDE with the
        // runtime's own definition. `read_file_raw` has a stub body in
        // the prelude purely so the checker has a signature for it —
        // this is what stops that stub from being compiled.
        if Option.is_some(cg_runtime_fn(head.name)) || head.name == "Array.concat" { cg_reachable(p, rest, done, fuel + 1) }
        else if cg_inst_seen(done, head, 0) { cg_reachable(p, rest, done, fuel + 1) }
        else {
            match cg_find_tfn(p, head.module, head.name, 0) {
                // A runtime-implemented prelude function has no Plum
                // body to walk or specialize — it is already a symbol.
                None => if Option.is_some(cg_runtime_fn(head.name)) { cg_reachable(p, rest, done, fuel + 1) } else {
                    cg_fail("prelude function ".concat(head.name).concat(" has no implementation in this backend's runtime yet"));
                    done
                },
                Some(def) => {
                    let inner = CgProgram { fns: p.fns, globals: p.globals, ctx: p.ctx, enums: p.enums, subst: def.subst, generics: def.generics, targs: head.targs, movable: [] };
                    cg_reachable(p, Array.concat(rest, cg_calls_in(inner, def.body, [])), done.push(head), fuel + 1)
                },
            }
        }
    }

// Every aggregate type compared with `==`/`!=` anywhere in the
// reachable program, closed over its own components.
// Every heap type a reachable function can hold: its parameters, its
// return type, and the type of every `let` in its body. `cg_rel_close`
// pulls in the component types from there.
let cg_rel_types_of (p: CgProgram) (insts: Array[CgInst]) (i: Int) (acc: Array[typecheck.ITy]): Array[typecheck.ITy] =
    if i >= insts.len() { acc }
    else {
        match cg_find_tfn(p, insts[i].module, insts[i].name, 0) {
            None => cg_rel_types_of(p, insts, i + 1, acc),
            Some(def) => {
                let inner = CgProgram { fns: p.fns, globals: p.globals, ctx: p.ctx, enums: p.enums, subst: def.subst, generics: def.generics, targs: insts[i].targs, movable: [] };
                let withparams = cg_rel_close_list(inner, Array.map(def.params, |q| cg_concrete(inner, q.ty)), 0, acc);
                let withret = cg_rel_close(inner, cg_concrete(inner, def.ret), withparams);
                cg_rel_types_of(p, insts, i + 1, cg_rel_in(inner, def.body, withret))
            },
        }
    }

// Every type appearing on a node in a body — that is what a slot may
// hold, and so what may need releasing.
let cg_rel_in (p: CgProgram) (e: typecheck.TExpr) (acc: Array[typecheck.ITy]): Array[typecheck.ITy] = {
    let here = cg_rel_close(p, cg_concrete(p, typecheck.texpr_ty(p.subst, e)), acc);
    match e.node {
        TFnCall(_, _, args, _) => cg_rel_in_list(p, args, 0, here),
        TClosureCall(callee, args) => cg_rel_in_list(p, args, 0, cg_rel_in(p, callee, here)),
        TMethodCall(_, base, args) => cg_rel_in_list(p, args, 0, cg_rel_in(p, base, here)),
        TArrayNs(_, args) => cg_rel_in_list(p, args, 0, here),
        TVariantNew(_, _, args) => cg_rel_in_list(p, args, 0, here),
        TPrintln(a) => cg_rel_in(p, a, here),
        TSpawn(a) => cg_rel_in(p, a, here),
        TChannelNew => here,
        TChannelSend(a, b) => cg_rel_in(p, b, cg_rel_in(p, a, here)),
        TChannelRecv(a) => cg_rel_in(p, a, here),
        TSelect(arms) => cg_rel_in_select(p, arms, 0, here),
        TTaskJoin(a) => cg_rel_in(p, a, here),
        TExternCall(_, xs) => cg_rel_in_list(p, xs, 0, here),
        TAsCStr(a) => cg_rel_in(p, a, here),
        TAsString(a) => cg_rel_in(p, a, here),
        TRefNew(a) => cg_rel_in(p, a, here),
        TUnary(_, a) => cg_rel_in(p, a, here),
        TBinary(_, a, b) => cg_rel_in(p, b, cg_rel_in(p, a, here)),
        TFieldGet(a, _) => cg_rel_in(p, a, here),
        TIndex(a, b) => cg_rel_in(p, b, cg_rel_in(p, a, here)),
        TArrayLit(elems) => cg_rel_in_list(p, elems, 0, here),
        TArrayLitReuse(elems, _) => cg_rel_in_list(p, elems, 0, here),
        TTupleLit(elems) => cg_rel_in_list(p, elems, 0, here),
        TBlockE(block) => cg_rel_in_block(p, block, here),
        TIf(c, t, e2) => match e2 {
            Some(x) => cg_rel_in(p, x, cg_rel_in(p, t, cg_rel_in(p, c, here))),
            None => cg_rel_in(p, t, cg_rel_in(p, c, here)),
        },
        TMatch(sc, arms) => cg_rel_in_arms(p, arms, 0, cg_rel_in(p, sc, here)),
        TFor(_, lo, hi, body) => cg_rel_in(p, body, cg_rel_in(p, hi, cg_rel_in(p, lo, here))),
        TForArray(_, arr, body) => cg_rel_in(p, body, cg_rel_in(p, arr, here)),
        TClosure(_, body) => cg_rel_in(p, body, here),
        TStructLit(_, fields, sp) => cg_rel_in_fields(p, fields, 0, match sp { Some(b) => cg_rel_in(p, b, here), None => here }),
        TStructReuse(_, fields, _) => cg_rel_in_fields(p, fields, 0, here),
        TArrayNsReuse(_, xs, _) => cg_rel_in_list(p, xs, 0, here),
        TVariantReuse(_, _, xs, _) => cg_rel_in_list(p, xs, 0, here),
        TInt(_) => here, TFloat(_) => here, TStr(_) => here, TBool(_) => here,
        TUnitLit => here, TIdent(_) => here, TGlobalRef(_, _) => here, TUnsupported(_) => here,
    }
}

let cg_rel_in_list (p: CgProgram) (es: Array[typecheck.TExpr]) (i: Int) (acc: Array[typecheck.ITy]): Array[typecheck.ITy] =
    if i >= es.len() { acc } else { cg_rel_in_list(p, es, i + 1, cg_rel_in(p, es[i], acc)) }

let cg_rel_in_block (p: CgProgram) (block: typecheck.TBlock) (acc: Array[typecheck.ITy]): Array[typecheck.ITy] = {
    let after = cg_rel_in_stmts(p, block.stmts, 0, acc);
    match block.tail { Some(t) => cg_rel_in(p, t, after), None => after }
}

let cg_rel_in_stmts (p: CgProgram) (stmts: Array[typecheck.TStmt]) (i: Int) (acc: Array[typecheck.ITy]): Array[typecheck.ITy] =
    if i >= stmts.len() { acc }
    else {
        let next = match stmts[i] {
            TSLet(_, v) => cg_rel_in(p, v, acc),
            TSAssign(_, v) => cg_rel_in(p, v, acc),
            TSExpr(v) => cg_rel_in(p, v, acc),
        };
        cg_rel_in_stmts(p, stmts, i + 1, next)
    }

let cg_rel_in_arms (p: CgProgram) (arms: Array[typecheck.TArm]) (i: Int) (acc: Array[typecheck.ITy]): Array[typecheck.ITy] =
    if i >= arms.len() { acc }
    else {
        let g = match arms[i].guard { Some(x) => cg_rel_in(p, x, acc), None => acc };
        cg_rel_in_arms(p, arms, i + 1, cg_rel_in(p, arms[i].body, g))
    }

let cg_rel_in_fields (p: CgProgram) (fields: Array[typecheck.TFieldInit]) (i: Int) (acc: Array[typecheck.ITy]): Array[typecheck.ITy] =
    if i >= fields.len() { acc } else { cg_rel_in_fields(p, fields, i + 1, cg_rel_in(p, fields[i].value, acc)) }

let cg_eq_types_of (p: CgProgram) (insts: Array[CgInst]) (i: Int) (acc: Array[typecheck.ITy]): Array[typecheck.ITy] =
    if i >= insts.len() { acc }
    else {
        match cg_find_tfn(p, insts[i].module, insts[i].name, 0) {
            None => cg_eq_types_of(p, insts, i + 1, acc),
            Some(def) => {
                let inner = CgProgram { fns: p.fns, globals: p.globals, ctx: p.ctx, enums: p.enums, subst: def.subst, generics: def.generics, targs: insts[i].targs, movable: [] };
                cg_eq_types_of(p, insts, i + 1, cg_eq_in(inner, def.body, acc))
            },
        }
    }

let cg_eq_in (p: CgProgram) (e: typecheck.TExpr) (acc: Array[typecheck.ITy]): Array[typecheck.ITy] =
    match e.node {
        TBinary(op, l, r) => {
            let inner = cg_eq_in(p, r, cg_eq_in(p, l, acc));
            if cg_is_equality(op) { cg_eq_close(p, cg_concrete(p, typecheck.texpr_ty(p.subst, l)), inner) } else { inner }
        },
        TFnCall(_, _, args, _) => cg_eq_in_list(p, args, 0, acc),
        TClosureCall(callee, args) => cg_eq_in_list(p, args, 0, cg_eq_in(p, callee, acc)),
        TMethodCall(_, base, args) => cg_eq_in_list(p, args, 0, cg_eq_in(p, base, acc)),
        TArrayNs(_, args) => cg_eq_in_list(p, args, 0, acc),
        TVariantNew(_, _, args) => cg_eq_in_list(p, args, 0, acc),
        TPrintln(a) => cg_eq_in(p, a, acc),
        TSpawn(a) => cg_eq_in(p, a, acc),
        TChannelNew => acc,
        TChannelSend(a, b) => cg_eq_in(p, b, cg_eq_in(p, a, acc)),
        TChannelRecv(a) => cg_eq_in(p, a, acc),
        TSelect(arms) => cg_eq_in_select(p, arms, 0, acc),
        TTaskJoin(a) => cg_eq_in(p, a, acc),
        TExternCall(_, xs) => cg_eq_in_list(p, xs, 0, acc),
        TAsCStr(a) => cg_eq_in(p, a, acc),
        TAsString(a) => cg_eq_in(p, a, acc),
        TRefNew(a) => cg_eq_in(p, a, acc),
        TUnary(_, a) => cg_eq_in(p, a, acc),
        TFieldGet(a, _) => cg_eq_in(p, a, acc),
        TIndex(a, b) => cg_eq_in(p, b, cg_eq_in(p, a, acc)),
        TArrayLit(elems) => cg_eq_in_list(p, elems, 0, acc),
        TArrayLitReuse(elems, _) => cg_eq_in_list(p, elems, 0, acc),
        TTupleLit(elems) => cg_eq_in_list(p, elems, 0, acc),
        TBlockE(block) => cg_eq_in_block(p, block, acc),
        TIf(c, t, e2) => match e2 {
            Some(x) => cg_eq_in(p, x, cg_eq_in(p, t, cg_eq_in(p, c, acc))),
            None => cg_eq_in(p, t, cg_eq_in(p, c, acc)),
        },
        // A literal PATTERN compares too (`match c { "0" => .. }`), and
        // it compares against the SCRUTINEE's type, so the scrutinee is
        // closed over here rather than only at explicit `==` sites.
        TMatch(sc, arms) => cg_eq_in_arms(p, arms, 0, cg_eq_close(p, cg_concrete(p, typecheck.texpr_ty(p.subst, sc)), cg_eq_in(p, sc, acc))),
        TFor(_, lo, hi, body) => cg_eq_in(p, body, cg_eq_in(p, hi, cg_eq_in(p, lo, acc))),
        TForArray(_, arr, body) => cg_eq_in(p, body, cg_eq_in(p, arr, acc)),
        TClosure(_, body) => cg_eq_in(p, body, acc),
        TStructLit(_, fields, sp) => cg_eq_in_fields(p, fields, 0, match sp { Some(b) => cg_eq_in(p, b, acc), None => acc }),
        TStructReuse(_, fields, _) => cg_eq_in_fields(p, fields, 0, acc),
        TArrayNsReuse(_, xs, _) => cg_eq_in_list(p, xs, 0, acc),
        TVariantReuse(_, _, xs, _) => cg_eq_in_list(p, xs, 0, acc),
        TInt(_) => acc, TFloat(_) => acc, TStr(_) => acc, TBool(_) => acc,
        TUnitLit => acc, TIdent(_) => acc, TGlobalRef(_, _) => acc, TUnsupported(_) => acc,
    }

let cg_eq_in_list (p: CgProgram) (es: Array[typecheck.TExpr]) (i: Int) (acc: Array[typecheck.ITy]): Array[typecheck.ITy] =
    if i >= es.len() { acc } else { cg_eq_in_list(p, es, i + 1, cg_eq_in(p, es[i], acc)) }

let cg_eq_in_block (p: CgProgram) (block: typecheck.TBlock) (acc: Array[typecheck.ITy]): Array[typecheck.ITy] = {
    let after = cg_eq_in_stmts(p, block.stmts, 0, acc);
    match block.tail { Some(t) => cg_eq_in(p, t, after), None => after }
}

let cg_eq_in_stmts (p: CgProgram) (stmts: Array[typecheck.TStmt]) (i: Int) (acc: Array[typecheck.ITy]): Array[typecheck.ITy] =
    if i >= stmts.len() { acc }
    else {
        let next = match stmts[i] {
            TSLet(_, v) => cg_eq_in(p, v, acc),
            TSAssign(_, v) => cg_eq_in(p, v, acc),
            TSExpr(v) => cg_eq_in(p, v, acc),
        };
        cg_eq_in_stmts(p, stmts, i + 1, next)
    }

let cg_eq_in_arms (p: CgProgram) (arms: Array[typecheck.TArm]) (i: Int) (acc: Array[typecheck.ITy]): Array[typecheck.ITy] =
    if i >= arms.len() { acc }
    else {
        let g = match arms[i].guard { Some(x) => cg_eq_in(p, x, acc), None => acc };
        cg_eq_in_arms(p, arms, i + 1, cg_eq_in(p, arms[i].body, g))
    }

let cg_eq_in_fields (p: CgProgram) (fields: Array[typecheck.TFieldInit]) (i: Int) (acc: Array[typecheck.ITy]): Array[typecheck.ITy] =
    if i >= fields.len() { acc } else { cg_eq_in_fields(p, fields, i + 1, cg_eq_in(p, fields[i].value, acc)) }

let cg_global_roots (p: CgProgram) (i: Int) (acc: Array[CgInst]): Array[CgInst] =
    if i >= p.globals.len() { acc }
    else {
        let g = p.globals[i];
        let gp = CgProgram { fns: p.fns, globals: p.globals, ctx: p.ctx, enums: p.enums, subst: g.subst, generics: [], targs: [], movable: [] };
        cg_global_roots(p, i + 1, Array.concat(acc, cg_calls_in(gp, g.body, [])))
    }

let cg_has_fn_in (p: CgProgram) (module_name: String) (name: String) (i: Int): Bool =
    if i >= p.fns.len() { false }
    else if p.fns[i].name == name && p.fns[i].module == module_name { true }
    else { cg_has_fn_in(p, module_name, name, i + 1) }

let cg_find_tfn (p: CgProgram) (module_name: String) (name: String) (i: Int): Option[typecheck.TFn] =
    if i >= p.fns.len() { None }
    else if p.fns[i].name == name && p.fns[i].module == module_name { Some(p.fns[i]) }
    else { cg_find_tfn(p, module_name, name, i + 1) }

// Every `TFnCall` in a body, with its type arguments resolved through
// the enclosing specialization. A separate traversal from emission on
// purpose: discovery must complete for the WHOLE program before any
// function is emitted, since a call may be the first mention of an
// instantiation that appears earlier in the output.
let cg_calls_in (p: CgProgram) (e: typecheck.TExpr) (acc: Array[CgInst]): Array[CgInst] =
    match e.node {
        TFnCall(m, name, args, targs) => cg_calls_in_list(p, args, acc.push(CgInst { module: m, name: name, targs: cg_concrete_list(p, targs, 0, []) })),
        TClosureCall(callee, args) => cg_calls_in_list(p, args, cg_calls_in(p, callee, acc)),
        TMethodCall(_, base, args) => cg_calls_in_list(p, args, cg_calls_in(p, base, acc)),
        TArrayNs(_, args) => cg_calls_in_list(p, args, acc),
        TVariantNew(_, _, args) => cg_calls_in_list(p, args, acc),
        TPrintln(a) => cg_calls_in(p, a, acc),
        TSpawn(a) => cg_calls_in(p, a, acc),
        TChannelNew => acc,
        TChannelSend(a, b) => cg_calls_in(p, b, cg_calls_in(p, a, acc)),
        TChannelRecv(a) => cg_calls_in(p, a, acc),
        TSelect(arms) => cg_calls_in_select(p, arms, 0, acc),
        TTaskJoin(a) => cg_calls_in(p, a, acc),
        TExternCall(_, xs) => cg_calls_in_list(p, xs, acc),
        TAsCStr(a) => cg_calls_in(p, a, acc),
        TAsString(a) => cg_calls_in(p, a, acc),
        TRefNew(a) => cg_calls_in(p, a, acc),
        TUnary(_, a) => cg_calls_in(p, a, acc),
        TBinary(_, a, b) => cg_calls_in(p, b, cg_calls_in(p, a, acc)),
        TFieldGet(a, _) => cg_calls_in(p, a, acc),
        TIndex(a, b) => cg_calls_in(p, b, cg_calls_in(p, a, acc)),
        TArrayLit(elems) => cg_calls_in_list(p, elems, acc),
        TArrayLitReuse(elems, _) => cg_calls_in_list(p, elems, acc),
        TTupleLit(elems) => cg_calls_in_list(p, elems, acc),
        TBlockE(block) => cg_calls_in_block(p, block, acc),
        TIf(c, t, e2) => match e2 {
            Some(x) => cg_calls_in(p, x, cg_calls_in(p, t, cg_calls_in(p, c, acc))),
            None => cg_calls_in(p, t, cg_calls_in(p, c, acc)),
        },
        TMatch(sc, arms) => cg_calls_in_arms(p, arms, 0, cg_calls_in(p, sc, acc)),
        TFor(_, lo, hi, body) => cg_calls_in(p, body, cg_calls_in(p, hi, cg_calls_in(p, lo, acc))),
        TForArray(_, arr, body) => cg_calls_in(p, body, cg_calls_in(p, arr, acc)),
        TClosure(_, body) => cg_calls_in(p, body, acc),
        TStructLit(_, fields, sp) => cg_calls_in_fields(p, fields, 0, match sp { Some(b) => cg_calls_in(p, b, acc), None => acc }),
        TStructReuse(_, fields, _) => cg_calls_in_fields(p, fields, 0, acc),
        TArrayNsReuse(_, xs, _) => cg_calls_in_list(p, xs, acc),
        TVariantReuse(_, _, xs, _) => cg_calls_in_list(p, xs, acc),
        TInt(_) => acc, TFloat(_) => acc, TStr(_) => acc, TBool(_) => acc,
        TUnitLit => acc, TIdent(_) => acc, TGlobalRef(_, _) => acc, TUnsupported(_) => acc,
    }

let cg_calls_in_list (p: CgProgram) (es: Array[typecheck.TExpr]) (acc: Array[CgInst]): Array[CgInst] = cg_calls_in_list_acc(p, es, 0, acc)
let cg_calls_in_list_acc (p: CgProgram) (es: Array[typecheck.TExpr]) (i: Int) (acc: Array[CgInst]): Array[CgInst] =
    if i >= es.len() { acc } else { cg_calls_in_list_acc(p, es, i + 1, cg_calls_in(p, es[i], acc)) }

let cg_calls_in_block (p: CgProgram) (block: typecheck.TBlock) (acc: Array[CgInst]): Array[CgInst] = {
    let after = cg_calls_in_stmts(p, block.stmts, 0, acc);
    match block.tail { Some(t) => cg_calls_in(p, t, after), None => after }
}

let cg_calls_in_stmts (p: CgProgram) (stmts: Array[typecheck.TStmt]) (i: Int) (acc: Array[CgInst]): Array[CgInst] =
    if i >= stmts.len() { acc }
    else {
        let next = match stmts[i] {
            TSLet(_, v) => cg_calls_in(p, v, acc),
            TSAssign(_, v) => cg_calls_in(p, v, acc),
            TSExpr(v) => cg_calls_in(p, v, acc),
        };
        cg_calls_in_stmts(p, stmts, i + 1, next)
    }

let cg_calls_in_arms (p: CgProgram) (arms: Array[typecheck.TArm]) (i: Int) (acc: Array[CgInst]): Array[CgInst] =
    if i >= arms.len() { acc }
    else {
        let g = match arms[i].guard { Some(x) => cg_calls_in(p, x, acc), None => acc };
        cg_calls_in_arms(p, arms, i + 1, cg_calls_in(p, arms[i].body, g))
    }

let cg_calls_in_fields (p: CgProgram) (fields: Array[typecheck.TFieldInit]) (i: Int) (acc: Array[CgInst]): Array[CgInst] =
    if i >= fields.len() { acc } else { cg_calls_in_fields(p, fields, i + 1, cg_calls_in(p, fields[i].value, acc)) }

// Accumulates into an ARRAY and joins once, rather than concatenating
// onto a growing string. This is the emitter's biggest accumulator --
// every function body in the program -- and appending to a string makes
// it quadratic: function N copies the N-1 already there. Compiling this
// compiler allocated 3.5GB to produce 6MB of IR, most of it here.
let cg_emit_insts (p: CgProgram) (insts: Array[CgInst]) (i: Int) (n: Int) (acc: String): String =
    Array.concat_all(cg_collect_insts(p, insts, 0, n, []))

let cg_collect_insts (p: CgProgram) (insts: Array[CgInst]) (i: Int) (n: Int) (acc: Array[String]): Array[String] =
    if i >= insts.len() { acc }
    else {
        match cg_find_tfn(p, insts[i].module, insts[i].name, 0) {
            None => cg_collect_insts(p, insts, i + 1, n, acc),
            Some(def) => {
                let f = cg_fn(p, def, insts[i].targs, n);
                cg_collect_insts(p, insts, i + 1, f.next, acc.push(f.text))
            },
        }
    }
