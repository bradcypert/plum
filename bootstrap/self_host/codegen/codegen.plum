// Self-hosted CODE GENERATOR — Stage 5 of self-hosting, and the last
// piece needed for a Plum compiler written in Plum that can produce a
// native binary. See DESIGN.md's own Stage 5 section and the project
// roadmap for the "why now" story.
//
// Emits LLVM IR TEXT, the same form `crates/plum-codegen` emits, which
// `plum compile-ir <file.ll> -o <binary>` then hands to `clang`.
// Handing assembly+linking to the system toolchain is not a
// bootstrapping cheat — the real compiler does exactly the same thing
// internally, and Plum has no process-spawn builtin for a self-hosted
// compiler to shell out with.
//
// --- The two decisions that shape this file ---
//
// **1. Values are STATICALLY TYPED and UNBOXED.** An `Int` is an `i64`
// in a register, a `Float` is a `double`, a `Bool`/`Unit` is an `i1`, a
// `String` is a `ptr` to a length-prefixed cell. The alternative — one
// uniform tagged representation for every value — would have made this
// file much smaller (no type information needed anywhere, generics
// erase for free), at the cost of a tag check on every operation and a
// backend that would eventually be thrown away. Unboxed is what the
// real backend does, so this is the shape that can actually grow into
// it.
//
// **2. Nothing is ever freed.** No refcounting, no FBIP, no `plum_rc_
// inc`/`dec` — see `runtime.plum`'s own comment. That is what makes an
// unboxed backend tractable at all here: the real one spends 3,293
// lines on `plum-ir/src/fbip.rs` to free correctly, and a compiler
// that starts, compiles one program and exits doesn't need any of it.
//
// --- Where the types come from ---
//
// **The checker.** `typecheck/infer.plum` computes the type of every
// expression and now PUBLISHES it, as a typed tree (`typecheck/
// texpr.plum`). This file reads types; it does not derive them.
//
// It used to derive them, bottom-up, because inference threw its
// results away. That worked for everything except a closure literal
// with no expected type — `let f = |n| n + 1`, where `n`'s
// representation is only pinned by UNIFYING the body's use of it. The
// fix was to make the checker hand over what it already knew, not to
// grow a second unifier here.
//
// Two things came with it, both worth more than the one fixture:
//
//   - **Calls arrive classified.** `parser.PExpr` has one `ECall`
//     covering user functions, prelude functions, variant
//     constructors, closure values, methods, `Array.map` and
//     `println`. Telling them apart needs scope information, and this
//     file used to redo that resolution itself — with its own copy of
//     the precedence rules. Now `infer_call` decides once and the node
//     says which. The backend cannot disagree with the checker about
//     what a call IS.
//   - **Whole rules disappeared** rather than moving: the operator
//     result-type table, the "a match's type is its first arm's type"
//     rule (which emitted an arm speculatively just to read its type
//     back), the empty-array "element type undetermined" marker, and
//     the machinery that pushed expected parameter types down into
//     closure literals. Each existed only to reconstruct something
//     inference already knew.
//
// One genuinely new rule lives here: DEFAULTING an unconstrained type
// variable — see `cg_of_ity`.
//
// Validated against bootstrap/exec_corpus: a fixture compiled by THIS
// backend must print byte-for-byte what the real `plum build` produces
// for it — not merely match `expected.txt`, but agree with the other
// backend, which is the stronger claim.

use lexer;
use parser;
use typecheck;

let cg_fail (msg: String): Unit = panic_raw("self-hosted codegen: ".concat(msg))

// --- Representation types ---
//
// Deliberately coarse: this is "which machine type, which layout", not
// a type language. `typecheck/types.plum`'s `ITy` is the type language.
pub enum CgTy {
    CgInt,
    CgFloat,
    CgBool,
    CgUnit,
    CgStr,
    // Both are a `ptr` to a heap cell; the NAME is carried so field
    // offsets and variant tags can be looked up in the declaration
    // tables. Nothing else about the type is needed at this level —
    // see this file's "coarse on purpose" note above.
    CgStruct(String),
    CgEnum(String),
    // The element type is carried because an element load/store needs
    // its machine type, and `.push()` needs to report the same array
    // type back. `CgArray(CgUnit)` is the ONE special value: it means
    // "empty literal, element type never determined" — see
    // `cg_array_lit`.
    CgArray(CgTy),
    // A closure: parameter representations and result representation.
    // The VALUE is a `ptr` to `{ ptr code, captures... }` — see
    // `cg_closure`.
    CgClosure(Array[CgTy], CgTy),
}

// `Unit` is an `i1` rather than LLVM's own `void` so that every Plum
// expression, including a `Unit`-valued one, is a real SSA value that
// can be stored in a slot, returned, and passed — the same choice the
// real backend makes, and for the same reason.
let cg_llvm_ty (t: CgTy): String =
    match t {
        CgInt => "i64",
        CgFloat => "double",
        CgBool => "i1",
        CgUnit => "i1",
        CgStr => "ptr",
        CgStruct(_) => "ptr",
        CgEnum(_) => "ptr",
        CgArray(_) => "ptr",
        CgClosure(_, _) => "ptr",
    }

let cg_ty_name (t: CgTy): String =
    match t {
        CgInt => "Int",
        CgFloat => "Float",
        CgBool => "Bool",
        CgUnit => "Unit",
        CgStr => "String",
        CgStruct(name) => name,
        CgEnum(name) => name,
        CgArray(elem) => "Array[".concat(cg_ty_name(elem)).concat("]"),
        CgClosure(_, ret) => "(..) -> ".concat(cg_ty_name(ret)),
    }

let cg_ty_eq (a: CgTy) (b: CgTy): Bool = cg_ty_name(a) == cg_ty_name(b)

// --- Declaration tables ---
//
// Resolving a type annotation needs to know whether `Shape` names a
// struct or an enum, and building the full declarations needs to
// resolve their own field/payload annotations — a cycle. It's broken by
// collecting NAMES and kinds first (`CgTyName`, which needs no
// resolution at all), then resolving everything else against that. The
// same two-pass shape `typecheck/context.plum` uses, for the same
// reason.
// `tag` is assigned in declaration order across the WHOLE program, not
// per enum — matching the flat, globally-scoped treatment variant tags
// already get everywhere else in this bootstrap (see DESIGN.md's
// module-system section, which documents that as a deliberate v1
// boundary).
pub struct CgVariant { name: String, tag: Int, arity: Int }
pub struct CgEnumDecl { name: String, variants: Array[CgVariant] }

// Field and payload TYPES are no longer resolved here at all: every
// use site reads its own type off the typed tree instead. What the
// declarations are still needed for is LAYOUT — which slot a field
// lives in, and which tag a variant carries — and neither of those
// needs a resolved type, only an order.
// --- Program shape ---

// `subst` is the CURRENT function's substitution, swapped per function
// by `cg_fn` — it is what `cg_ty` needs to resolve a recorded type. It
// lives here rather than as a parameter on thirty emitters purely to
// keep those signatures unchanged.
// `generics`/`targs` are the SPECIALIZATION currently being emitted:
// the type-parameter names of the function whose body this is, and the
// concrete types they stand for. Every type read goes through them
// (`cg_concrete`), which is the whole of monomorphization's effect on
// emission — there is no rewritten copy of the body anywhere, only a
// different mapping applied while walking the same one.
pub struct CgProgram { fns: Array[typecheck.TFn], globals: Array[typecheck.TFn], ctx: typecheck.TyContext, enums: Array[CgEnumDecl], subst: typecheck.Subst, generics: Array[String], targs: Array[typecheck.ITy] }

// --- Cell layouts ---
//
// Struct: one 8-byte slot per field, in declared order.
// Enum:   an i64 tag at offset 0, then one 8-byte slot per payload.
//
// Eight bytes per slot regardless of the field's own width, so an
// offset is `8 * index` with no alignment arithmetic. A `Bool` wastes
// seven bytes; that is a deliberate trade of space for a layout rule
// simple enough to state in one line.
//
// An enum cell is always sized for its LARGEST variant, never for the
// variant actually being built. That is what makes pattern matching
// safe: a `match` arm loads a payload slot BEFORE it knows the tag
// matched, and with per-variant sizing that load could run off the end
// of the allocation. Over-allocating means such a load reads garbage it
// then discards, rather than reading unmapped memory.
// EVERY heap cell begins with a reference count. Nothing reads it yet —
// the ownership discipline that will is a separate change — but every
// offset below is expressed relative to it, so adding the word is a
// layout change and not an arithmetic one.
//
//   Str:     { i64 rc, i64 len, i8 bytes[len], i8 0 }
//   Array:   { i64 rc, i64 len, elem0, ... }
//   Struct:  { i64 rc, field0, field1, ... }
//   Enum:    { i64 rc, i64 tag, payload0, ... }
//   Closure: { i64 rc, ptr code, capture0, ... }
//
// These are now the same SHAPE as the real backend's cells, though not
// the same sizes (its array cell carries a capacity word this one has
// no growth strategy for).
let cg_rc_offset (unit: Unit): Int = 0
let cg_field_offset (index: Int): Int = 8 + 8 * index
let cg_tag_offset (unit: Unit): Int = 8
let cg_payload_offset (index: Int): Int = 16 + 8 * index
let cg_array_elem_offset (index: Int): Int = 16 + 8 * index
let cg_closure_code_offset (unit: Unit): Int = 8
// A closure cell carries a RELEASE-FUNCTION pointer as well as a code
// pointer. It has to: a closure's captures are not visible from its
// TYPE — `(Int) -> Int` says nothing about what was captured — so
// nothing generated per-type can walk them. Only the literal's own
// creation site knows, so that is where the walker is generated, and
// the cell carries a pointer to it. The real backend spends this same
// word for this same reason.
let cg_closure_rel_offset (unit: Unit): Int = 16
let cg_capture_offset (index: Int): Int = 24 + 8 * index

// A Plum name may contain a `.` (`Point.add`, an associated function),
// which LLVM would accept only inside quotes; mangling keeps every
// emitted symbol a plain identifier.
let cg_global_slot (name: String): String = "@g.".concat(cg_mangle(name))

let cg_mangle (name: String): String = "plum_".concat(chars_join(Array.map(chars_of(name), |c| if c == "." { "_" } else { c })))

// --- Monomorphization ---
//
// A generic function is emitted once PER DISTINCT set of type
// arguments, and the arguments are folded into the symbol name. That is
// the whole scheme: `Array.map[Int, String]` and `Array.map[String,
// Int]` become two different LLVM functions, each with concrete machine
// types throughout.
//
// This is forced by the choice to be UNBOXED. A boxed backend needs
// none of it — every value is a `ptr`, so one copy serves every
// instantiation — which was exactly the tradeoff weighed when Stage 5
// started. Monomorphization is the bill for that decision, and it is
// the last major subsystem the real backend has that this one lacked.
//
// The specialized body is never rewritten. Emission walks the SAME
// typed tree with a different generic mapping in `CgProgram` — see
// `cg_concrete`. That is only sound because nothing about a body's
// SHAPE depends on its type arguments, which is true here and would
// stop being true if this backend ever specialized on values.
pub struct CgInst { name: String, targs: Array[typecheck.ITy] }

// A symbol name that is unique per instantiation. Monomorphic functions
// keep their plain mangled name, so the entry point stays `@plum_main`
// and the generated IR stays readable for the common case.
let cg_sym (name: String) (targs: Array[typecheck.ITy]): String =
    if Array.is_empty(targs) { cg_mangle(name) }
    else { cg_mangle(name).concat("__").concat(cg_targ_suffix(targs, 0, "")) }

let cg_targ_suffix (targs: Array[typecheck.ITy]) (i: Int) (acc: String): String =
    if i >= targs.len() { acc }
    else { cg_targ_suffix(targs, i + 1, if acc == "" { cg_ity_mangle(targs[i]) } else { acc.concat("_").concat(cg_ity_mangle(targs[i])) }) }

// A type rendered as an identifier-safe string. It must be INJECTIVE
// enough that two different types never collide, since a collision
// would silently merge two specializations into one — so nested type
// arguments are included rather than elided.
let cg_ity_mangle (t: typecheck.ITy): String =
    match t {
        ITInt => "Int",
        ITFloat => "Float",
        ITBool => "Bool",
        ITStr => "Str",
        ITUnit => "Unit",
        ITStruct(name, args) => if Array.is_empty(args) { name } else { name.concat("_").concat(cg_targ_suffix(args, 0, "")) },
        ITEnum(name, args) => if Array.is_empty(args) { name } else { name.concat("_").concat(cg_targ_suffix(args, 0, "")) },
        ITFunction(ptys, ret) => "fn".concat(cg_targ_suffix(ptys, 0, "")).concat("_to_").concat(cg_ity_mangle(ret)),
        ITTuple(elems) => "tup".concat(cg_targ_suffix(elems, 0, "")),
        // An unconstrained type variable DEFAULTS, exactly as it does in
        // `cg_of_ity` — and it must default to the same thing here, or
        // a call site and its callee would disagree about the symbol.
        ITVar(_) => "Unit",
        ITParam(name) => { cg_fail("internal: generic parameter ".concat(name).concat(" was not substituted before mangling")); "T" },
    }

let cg_inst_eq (a: CgInst) (b: CgInst): Bool =
    a.name == b.name && cg_sym(a.name, a.targs) == cg_sym(b.name, b.targs)

let cg_inst_seen (done: Array[CgInst]) (x: CgInst) (i: Int): Bool =
    if i >= done.len() { false } else if cg_inst_eq(done[i], x) { true } else { cg_inst_seen(done, x, i + 1) }

pub let cg_build_program (program: parser.ProgramNode): CgProgram =
    CgProgram {
        // Type-checking and typed-tree construction are one pass —
        // `typed_program` IS `check_program` with the results kept, so
        // the backend cannot compile anything the checker didn't prove.
        fns: typecheck.typed_program(program),
        globals: typecheck.typed_globals(program),
        // Field names and field/payload TYPES come straight from the
        // checker's own declaration tables — the backend re-resolves
        // nothing. Only variant TAGS are assigned here, because tag
        // numbering is a layout decision the checker has no opinion on.
        ctx: typecheck.build_context(program),
        enums: cg_collect_enums(program.items, 0, 0, []),
        subst: typecheck.subst_empty(()),
        generics: [],
        targs: [],
    }

// `next_tag` runs across the whole program, so every variant in every
// enum has a distinct id — see `CgVariant`'s own comment.
let cg_collect_enums (items: Array[parser.ItemNode]) (i: Int) (next_tag: Int) (acc: Array[CgEnumDecl]): Array[CgEnumDecl] =
    if i >= items.len() { acc }
    else {
        match items[i].kind {
            IKEnum(decl) => {
                // Generic enums need NO specialization: every payload
                // occupies the same 8-byte slot whatever `T` is, and a
                // variant's tag doesn't depend on it either. Only the
                // machine type of a payload LOAD varies, and that comes
                // from the scrutinee's own type arguments at the use
                // site (`cg_pat_variant`).
                let vs = cg_variants_of(decl.variants, 0, next_tag, []);
                cg_collect_enums(items, i + 1, next_tag + decl.variants.len(), acc.push(CgEnumDecl { name: decl.name, variants: vs }))
            },
            _ => cg_collect_enums(items, i + 1, next_tag, acc),
        }
    }

let cg_variants_of (variants: Array[parser.EnumVariantNode]) (i: Int) (next_tag: Int) (acc: Array[CgVariant]): Array[CgVariant] =
    if i >= variants.len() { acc }
    else {
        cg_variants_of(variants, i + 1, next_tag + 1,
            acc.push(CgVariant { name: variants[i].name, tag: next_tag, arity: variants[i].payload.len() }))
    }

// --- Declaration lookup ---

let cg_field_index (fields: Array[String]) (name: String) (i: Int): Int =
    if i >= fields.len() { { cg_fail("no such field: ".concat(name)); 0 } }
    else if fields[i] == name { i }
    else { cg_field_index(fields, name, i + 1) }

// The enum a variant NAME belongs to, found by scanning every enum —
// variant names are globally unique in this v1 (same flat scoping the
// tags themselves get), so the first match is the only match.
let cg_find_variant (p: CgProgram) (name: String): Option[CgVariant] = cg_find_variant_acc(p.enums, name, 0)
let cg_find_variant_acc (es: Array[CgEnumDecl]) (name: String) (i: Int): Option[CgVariant] =
    if i >= es.len() { None }
    else { match cg_find_variant_in(es[i].variants, name, 0) { Some(v) => Some(v), None => cg_find_variant_acc(es, name, i + 1) } }

let cg_find_variant_in (vs: Array[CgVariant]) (name: String) (i: Int): Option[CgVariant] =
    if i >= vs.len() { None } else if vs[i].name == name { Some(vs[i]) } else { cg_find_variant_in(vs, name, i + 1) }

let cg_enum_of_variant (p: CgProgram) (name: String): String = cg_enum_of_variant_acc(p.enums, name, 0)
let cg_enum_of_variant_acc (es: Array[CgEnumDecl]) (name: String) (i: Int): String =
    if i >= es.len() { { cg_fail("unknown variant: ".concat(name)); "" } }
    else { match cg_find_variant_in(es[i].variants, name, 0) { Some(_) => es[i].name, None => cg_enum_of_variant_acc(es, name, i + 1) } }

// An enum cell is sized for the widest variant — see `cg_payload_
// offset`'s own comment for why that is a correctness requirement.
let cg_enum_cell_size (p: CgProgram) (enum_name: String): Int = cg_widest_variant(cg_find_enum(p, enum_name).variants, 0, 0) * 8 + 16

let cg_find_enum (p: CgProgram) (name: String): CgEnumDecl = cg_find_enum_acc(p.enums, name, 0)
let cg_find_enum_acc (es: Array[CgEnumDecl]) (name: String) (i: Int): CgEnumDecl =
    if i >= es.len() { { cg_fail("unknown enum: ".concat(name)); CgEnumDecl { name: name, variants: [] } } }
    else if es[i].name == name { es[i] }
    else { cg_find_enum_acc(es, name, i + 1) }

let cg_widest_variant (vs: Array[CgVariant]) (i: Int) (best: Int): Int =
    if i >= vs.len() { best }
    else if vs[i].arity > best { cg_widest_variant(vs, i + 1, vs[i].arity) }
    else { cg_widest_variant(vs, i + 1, best) }

// --- Emission state ---
//
// `code` is the instruction text produced so far for the expression
// being emitted; `globals` is module-level text (string constants) that
// has to be hoisted out of the function body; `val` is the LLVM operand
// naming the expression's result, and `ty` its representation. `n` is
// the next unused register/label number — threaded rather than global
// because Plum has no mutable module state, and threading it is what
// keeps every generated name unique across a whole function body.
// `allocas` is kept SEPARATE from `code` and hoisted into the function's
// entry block. An `alloca` executed inside a loop body allocates afresh
// every iteration and is not reclaimed until the function returns — a
// real stack leak, and the reason this is its own field rather than
// just more `code`. LLVM's mem2reg also only promotes ENTRY-block
// allocas back to registers, so hoisting is what makes the whole
// "every local is a slot" strategy free rather than merely correct.
// `releases` mirrors `allocas`: every heap SLOT that gets an `alloca`
// also gets a release, spliced in just before the function's `ret`.
// Threading it exactly like `allocas` is deliberate — a slot and its
// release are created at the same place and must never get separated.
struct Emit { code: String, allocas: String, releases: String, globals: String, val: String, ty: CgTy, n: Int }

// Every LOCAL is an `alloca` slot, loaded on read and stored on write —
// never a bare SSA register. That means this backend never has to
// construct a phi node or reason about dominance: an `if` that produces
// a value stores into one slot from both arms. LLVM's own mem2reg pass
// turns all of it back into registers with correct phis, so the
// generated code is not actually slower for it. Same reason `let mut`
// and plain `let` need no distinction here at all.
// `ity` is the slot's full type, not just its representation. A
// release function is named after the full type (`@plum_rel_Box_Int`),
// which a `CgTy` cannot reconstruct — `CgStruct("Box")` has already
// thrown the argument away.
struct CgSlot { name: String, ptr: String, ty: CgTy, ity: typecheck.ITy }

let cg_lookup (env: Array[CgSlot]) (name: String): Option[CgSlot] = cg_lookup_acc(env, name, env.len() - 1)
let cg_lookup_acc (env: Array[CgSlot]) (name: String) (i: Int): Option[CgSlot] =
    if i < 0 { None } else if env[i].name == name { Some(env[i]) } else { cg_lookup_acc(env, name, i - 1) }

let cg_reg (n: Int): String = "%t".concat(n.to_string())
let cg_label (n: Int): String = "L".concat(n.to_string())

// --- String literals ---
//
// Emitted as module-level constants, so they need a name and an escaped
// body. The byte length is `s.len()` (Plum's `.len()` on a String is
// already a BYTE count, not a codepoint count), plus one for the
// trailing NUL every cell carries.
//
// Only the four bytes LLVM's `c"..."` syntax can't carry literally are
// escaped. Everything else — including multi-byte UTF-8 — passes
// through as raw bytes, which is exactly right: `c"..."` is a byte
// string, and a codepoint's own bytes need no special handling.
let cg_escape_llvm (s: String): String = chars_join(Array.map(chars_of(s), |c| cg_escape_char(c)))

let cg_escape_char (c: String): String =
    if c == "\"" { "\\22" }
    else if c == "\\" { "\\5C" }
    else if c == "\n" { "\\0A" }
    else if c == "\t" { "\\09" }
    else if c == "\r" { "\\0D" }
    else { c }

// A string literal is emitted as a COMPLETE, STATIC cell — refcount,
// length and bytes — not as raw bytes to be copied into a fresh cell at
// runtime. Copying was costing an allocation every time the literal was
// evaluated, and the compiler evaluates thousands of them constantly:
// 18.7 of 21.4 million allocations were `plum_str_new`, measured with
// PLUM_RT_STATS.
//
// The refcount is -1, which marks the cell IMMORTAL: `plum_rc_inc` and
// every release skip a negative count, so a static cell is never
// touched and never freed. A sentinel rather than a huge positive
// number, because "negative means static" cannot be reached by
// counting.
let cg_str_constant (n: Int) (s: String): String = {
    let bytes = s.len();
    let arr = bytes + 1;
    "@.str".concat(n.to_string()).concat(" = private global { i64, i64, [").concat(arr.to_string()).concat(" x i8] } { i64 -1, i64 ")
        .concat(bytes.to_string()).concat(", [").concat(arr.to_string()).concat(" x i8] c\"").concat(cg_escape_llvm(s)).concat("\\00\" }\n")
}

// --- Expression emission ---

// The backend's single dispatch. Every case reads the node's own TYPE
// from the checker (`cg_ty(p, e)`) rather than re-deriving it, and
// every CALL arrives already classified — `infer_call` decided whether
// `f(x)` was a function, a closure, a variant, a method or a namespace
// call, and the node says which. This file no longer makes either kind
// of decision for itself.
let cg_expr (p: CgProgram) (env: Array[CgSlot]) (n: Int) (e: typecheck.TExpr): Emit =
    match e.node {
        TInt(v) => Emit { code: "", allocas: "", releases: "",globals: "", val: v.to_string(), ty: CgInt, n: n },
        TFloat(v) => cg_float_literal(v, n),
        TBool(v) => Emit { code: "", allocas: "", releases: "",globals: "", val: if v { "1" } else { "0" }, ty: CgBool, n: n },
        TUnitLit => cg_unit_emit(n),
        // No allocation and no copy: the literal IS the cell.
        TStr(v) => Emit {
            code: "", allocas: "", releases: "", globals: cg_str_constant(n, v),
            val: "@.str".concat(n.to_string()), ty: CgStr, n: n + 2,
        },
        TIdent(name) => cg_ident(p, env, n, name, cg_ty(p, e)),
        // A global's slot owns its value for the whole program, so a
        // read borrows a reference the same way a local's does.
        TGlobalRef(name) => {
            let ty = cg_ty(p, e);
            let reg = cg_reg(n);
            Emit {
                code: "  ".concat(reg).concat(" = load ").concat(cg_llvm_ty(ty)).concat(", ptr ").concat(cg_global_slot(name)).concat("\n").concat(cg_inc(ty, reg)),
                allocas: "", releases: "", globals: "", val: reg, ty: ty, n: n + 1,
            }
        },
        TUnary(op, inner) => cg_unary(p, env, n, op, inner),
        TBinary(op, lhs, rhs) => cg_binary(p, env, n, op, lhs, rhs, cg_ty(p, e)),
        TIf(cond, then_branch, else_branch) => cg_if(p, env, n, cond, then_branch, else_branch, cg_ty(p, e)),
        TBlockE(block) => cg_block_ty(p, env, n, block, cg_ty(p, e)),
        TFieldGet(base, name) => cg_field_read(p, env, n, base, name, cg_ty(p, e)),
        TMatch(scrutinee, arms) => cg_match(p, env, n, scrutinee, arms, cg_ty(p, e)),
        TFor(pattern, lo, hi, body) => cg_for(p, env, n, pattern, lo, hi, body),
        TArrayLit(elems) => cg_array_lit(p, env, n, elems, cg_ty(p, e)),
        TIndex(base, idx) => cg_index(p, env, n, base, idx, cg_ty(p, e)),
        TClosure(params, body) => cg_closure(p, env, n, params, body, cg_concrete(p, typecheck.texpr_ty(p.subst, e))),
        TStructLit(name, fields) => cg_struct_lit(p, env, n, name, fields),
        TVariantNew(tag, args) => cg_variant_call(p, env, n, tag, args),
        TFnCall(name, args, targs) => cg_fn_call(p, env, n, name, args, targs, cg_ty(p, e)),
        TClosureCall(callee, args) => cg_call_closure_value(p, env, n, cg_expr(p, env, n, callee), args),
        TMethodCall(name, base, args) => cg_method_call(p, env, n, name, base, args, cg_ty(p, e)),
        TArrayNs(name, args) => cg_array_ns_call(p, env, n, name, args),
        TPrintln(arg) => cg_println(p, env, n, arg),
        TTupleLit(_) => { cg_fail("tuples aren't supported yet"); cg_unit_emit(n) },
        TUnsupported(what) => { cg_fail(what.concat(" isn't supported by this backend")); cg_unit_emit(n) },
    }

// --- Reading a node's type ---
//
// `p.subst` is the CURRENT FUNCTION's substitution — see `cg_fn`, which
// swaps it per function. A type recorded during inference may still
// hold unresolved variables; applying the substitution is what turns
// `?3` into `Int`.
let cg_ty (p: CgProgram) (e: typecheck.TExpr): CgTy = cg_of_ity(cg_concrete(p, typecheck.texpr_ty(p.subst, e)))

// Resolve a recorded type all the way to a concrete one: the function's
// own substitution first (which kills inference variables), then the
// current specialization's generic mapping (which kills `ITParam`s).
// Both are needed, and in that order — a type argument may itself be
// the enclosing function's own type parameter, as in `let outer[T] (x:
// T) = inner(x)`, where `inner`'s recorded argument resolves to
// `ITParam("T")` and only the specialization says what that is.
let cg_concrete (p: CgProgram) (t: typecheck.ITy): typecheck.ITy =
    typecheck.instantiate_template(p.generics, p.targs, typecheck.subst_apply(p.subst, t))

// `ITy` (the checker's full type language) to `CgTy` (a machine
// representation). This is the ONLY place the backend interprets types,
// and it replaces every bottom-up synthesis rule this file used to
// carry.
//
// An unresolved `ITVar` reaching here is a real bug rather than a user
// error: the checker accepted the program, so every type in it is
// determined. It fails loudly with the node's own rendered type instead
// of silently picking a representation.
let cg_of_ity (t: typecheck.ITy): CgTy =
    match t {
        ITInt => CgInt,
        ITFloat => CgFloat,
        ITBool => CgBool,
        ITStr => CgStr,
        ITUnit => CgUnit,
        ITStruct(name, args) => if name == "Array" { CgArray(cg_of_ity(args[0])) } else { CgStruct(name) },
        ITEnum(name, _) => CgEnum(name),
        ITFunction(ptys, ret) => CgClosure(Array.map(ptys, |q| cg_of_ity(q)), cg_of_ity(ret)),
        ITTuple(_) => { cg_fail("tuples aren't supported yet"); CgUnit },
        // DEFAULTING. A type variable still free after a function's
        // inference is one nothing in that function constrained — the
        // program never depends on which type it is, or unification
        // would have pinned it. `let empty = []` is the honest example:
        // its element type is unconstrained precisely because no
        // element is ever stored or read.
        //
        // Any choice is therefore sound, and `Unit` is chosen because
        // it is the one that cannot be mistaken for a real answer if it
        // ever shows up in generated code. This is not a fallback for a
        // missing case — it is the standard resolution for an ambiguous
        // type, and it is why this backend compiles `let empty = []`
        // while the REAL compiler rejects it as uninferable.
        ITVar(_) => CgUnit,
        ITParam(name) => { cg_fail("internal: generic parameter ".concat(name).concat(" reached codegen — generics aren't supported")); CgUnit },
    }

let cg_unit_emit (n: Int): Emit = Emit { code: "", allocas: "", releases: "",globals: "", val: "0", ty: CgUnit, n: n }

// LLVM accepts a decimal float literal only when it is exactly
// representable; `%.15g`-style text can silently round. Emitting the
// value through `to_string()` is what the corpus needs today (every
// float literal in it is exact), and this is the one place Stage 5
// would need a bit-pattern (`0x...`) form to be fully general — flagged
// here rather than left as a lurking rounding bug.
let cg_float_literal (v: Float) (n: Int): Emit = Emit { code: "", allocas: "", releases: "",globals: "", val: cg_float_text(v), ty: CgFloat, n: n }

let cg_float_text (v: Float): String = {
    let s = v.to_string();
    if Option.is_some(String.index_of(s, ".")) { s } else { s.concat(".0") }
}

let cg_ident (p: CgProgram) (env: Array[CgSlot]) (n: Int) (name: String) (ty: CgTy): Emit =
    match cg_lookup(env, name) {
        Some(slot) => {
            let reg = cg_reg(n);
            Emit {
                // Rule 3: a read yields a NEW owned reference. The slot
                // keeps its own, so the two are independent and the
                // slot's eventual release stays balanced.
                code: "  ".concat(reg).concat(" = load ").concat(cg_llvm_ty(slot.ty)).concat(", ptr ").concat(slot.ptr).concat("\n").concat(cg_inc(slot.ty, reg)),
                allocas: "", releases: "", globals: "", val: reg, ty: slot.ty, n: n + 1,
            }
        },
        // Every nullary variant (`None`, `TokEof`) now arrives as a
        // `TVariantNew` node instead, because the CHECKER resolved it —
        // so an unbound name reaching here is an internal error, not a
        // user one.
        None => { cg_fail("internal: unbound variable reached codegen: ".concat(name)); cg_unit_emit(n) },
    }

let cg_unary (p: CgProgram) (env: Array[CgSlot]) (n: Int) (op: parser.UOp) (inner: typecheck.TExpr): Emit = {
    let r = cg_expr(p, env, n, inner);
    let reg = cg_reg(r.n);
    let line = match op {
        UNeg => match r.ty {
            CgFloat => "  ".concat(reg).concat(" = fneg double ").concat(r.val).concat("\n"),
            _ => "  ".concat(reg).concat(" = sub i64 0, ").concat(r.val).concat("\n"),
        },
        UNot => "  ".concat(reg).concat(" = xor i1 ").concat(r.val).concat(", true\n"),
    };
    Emit { code: r.code.concat(line), allocas: r.allocas, releases: r.releases,globals: r.globals, val: reg, ty: r.ty, n: r.n + 1 }
}

// --- Binary operators ---
//
// `&&`/`||` are handled FIRST and separately, because they are the only
// two that must not evaluate their right operand unconditionally. They
// compile to real branches, through the same slot-and-merge shape `if`
// uses. (The self-hosted INTERPRETER had this exact bug until
// self-interpretation found it — see `interp.plum`'s `eval_binary_expr`.)
let cg_binary (p: CgProgram) (env: Array[CgSlot]) (n: Int) (op: parser.BOp) (lhs: typecheck.TExpr) (rhs: typecheck.TExpr) (ty: CgTy): Emit =
    match op {
        BAnd => cg_shortcircuit(p, env, n, lhs, rhs, true),
        BOr => cg_shortcircuit(p, env, n, lhs, rhs, false),
        BRange => { cg_fail("'..' is only supported as a 'for' iterand"); cg_unit_emit(n) },
        BPipe => { cg_fail("'|>' isn't supported yet"); cg_unit_emit(n) },
        _ => cg_strict_binary(p, env, n, op, lhs, rhs, ty),
    }

let cg_strict_binary (p: CgProgram) (env: Array[CgSlot]) (n: Int) (op: parser.BOp) (lhs: typecheck.TExpr) (rhs: typecheck.TExpr) (ty: CgTy): Emit = {
    // Comparison BORROWS both sides — `==` reads them and produces a
    // Bool, so neither operand's ownership is needed.
    let a = cg_borrow(p, env, n, lhs);
    let b = cg_borrow(p, env, a.n, rhs);
    let reg = cg_reg(b.n);
    let code = a.code.concat(b.code);
    let globals = a.globals.concat(b.globals);
    let allocas = a.allocas.concat(b.allocas);
    let releases = a.releases.concat(b.releases);
    if cg_is_equality(op) {
        // Structural, via `cg_eq_code` — which is one instruction for a
        // primitive and a call to a generated function for anything
        // else. Address comparison would be wrong for every aggregate.
        let opnd = cg_concrete(p, typecheck.texpr_ty(p.subst, lhs));
        let cmp = cg_eq_code(opnd, a.val, b.val, b.n);
        // Both operands were owned temporaries and the comparison
        // borrowed them.
        let drop_operands = a.drop.concat(b.drop);
        match op {
            BEq => Emit { code: code.concat(cmp.code).concat(drop_operands), allocas: allocas, releases: releases, globals: globals, val: cmp.val, ty: CgBool, n: cmp.n },
            _ => {
                let neg = cg_reg(cmp.n);
                Emit { code: code.concat(cmp.code).concat(drop_operands).concat("  ").concat(neg).concat(" = xor i1 ").concat(cmp.val).concat(", true\n"), allocas: allocas, releases: releases, globals: globals, val: neg, ty: CgBool, n: cmp.n + 1 }
            },
        }
    } else {
        let line = "  ".concat(reg).concat(" = ").concat(cg_binary_op_text(op, a.ty)).concat(" ").concat(cg_llvm_ty(a.ty)).concat(" ").concat(a.val).concat(", ").concat(b.val).concat("\n");
        Emit { code: code.concat(line), allocas: allocas, releases: releases, globals: globals, val: reg, ty: ty, n: b.n + 1 }
    }
}

let cg_is_equality (op: parser.BOp): Bool = match op { BEq => true, BNe => true, _ => false }

// LLVM spells the same Plum operator differently for integers and
// floats (`add`/`fadd`, `icmp slt`/`fcmp olt`), so the operand's
// representation picks the mnemonic. `fcmp olt` is the ORDERED form:
// a comparison involving NaN is false, matching Plum's own semantics.
let cg_binary_op_text (op: parser.BOp) (t: CgTy): String = {
    let f = cg_ty_eq(t, CgFloat);
    match op {
        BAdd => if f { "fadd" } else { "add" },
        BSub => if f { "fsub" } else { "sub" },
        BMul => if f { "fmul" } else { "mul" },
        BDiv => if f { "fdiv" } else { "sdiv" },
        BRem => if f { "frem" } else { "srem" },
        BEq => if f { "fcmp oeq" } else { "icmp eq" },
        BNe => if f { "fcmp one" } else { "icmp ne" },
        BLt => if f { "fcmp olt" } else { "icmp slt" },
        BGt => if f { "fcmp ogt" } else { "icmp sgt" },
        BLe => if f { "fcmp ole" } else { "icmp sle" },
        BGe => if f { "fcmp oge" } else { "icmp sge" },
        BAnd => { cg_fail("'&&' should have been short-circuited"); "and" },
        BOr => { cg_fail("'||' should have been short-circuited"); "or" },
        BRange => { cg_fail("'..' isn't an operator here"); "add" },
        BPipe => { cg_fail("'|>' isn't supported yet"); "add" },
    }
}

// `a && b` is `if a { b } else { false }`, and `a || b` is `if a { true
// } else { b }` — one slot, two blocks, a merge. Written directly
// rather than by rewriting to an `EIf` so the emitted labels stay
// readable and no synthetic AST node is needed.
let cg_shortcircuit (p: CgProgram) (env: Array[CgSlot]) (n: Int) (lhs: typecheck.TExpr) (rhs: typecheck.TExpr) (is_and: Bool): Emit = {
    let a = cg_expr(p, env, n, lhs);
    let slot = cg_reg(a.n);
    let rhs_label = cg_label(a.n + 1);
    let end_label = cg_label(a.n + 2);
    let b = cg_expr(p, env, a.n + 3, rhs);
    let res = cg_reg(b.n);
    let shortcut = if is_and { "0" } else { "1" };
    let br = if is_and {
        "  br i1 ".concat(a.val).concat(", label %").concat(rhs_label).concat(", label %").concat(end_label).concat("\n")
    } else {
        "  br i1 ".concat(a.val).concat(", label %").concat(end_label).concat(", label %").concat(rhs_label).concat("\n")
    };
    let code = a.code
        .concat("  store i1 ").concat(shortcut).concat(", ptr ").concat(slot).concat("\n")
        .concat(br)
        .concat(rhs_label).concat(":\n")
        .concat(b.code)
        .concat("  store i1 ").concat(b.val).concat(", ptr ").concat(slot).concat("\n")
        .concat("  br label %").concat(end_label).concat("\n")
        .concat(end_label).concat(":\n")
        .concat("  ").concat(res).concat(" = load i1, ptr ").concat(slot).concat("\n");
    Emit { code: code, allocas: "  ".concat(slot).concat(" = alloca i1\n").concat(a.allocas).concat(b.allocas), releases: a.releases.concat(b.releases),globals: a.globals.concat(b.globals), val: res, ty: CgBool, n: b.n + 1 }
}

// --- if/else ---
//
// Both arms store into one slot; the merge block loads it. An `else`-
// less `if` is `Unit`-typed and stores the unit value in the implicit
// else, so the slot is always initialized on every path.
let cg_if (p: CgProgram) (env: Array[CgSlot]) (n: Int) (cond: typecheck.TExpr) (then_branch: typecheck.TExpr) (else_branch: Option[typecheck.TExpr]) (ty: CgTy): Emit = {
    let c = cg_expr(p, env, n, cond);
    let slot = cg_reg(c.n);
    let then_label = cg_label(c.n + 1);
    let else_label = cg_label(c.n + 2);
    let end_label = cg_label(c.n + 3);
    let t = cg_expr(p, env, c.n + 4, then_branch);
    let e = match else_branch {
        Some(x) => cg_expr(p, env, t.n, x),
        None => cg_unit_emit(t.n),
    };
    let res = cg_reg(e.n);
    let lty = cg_llvm_ty(ty);
    let code = c.code
        .concat("  br i1 ").concat(c.val).concat(", label %").concat(then_label).concat(", label %").concat(else_label).concat("\n")
        .concat(then_label).concat(":\n")
        .concat(t.code)
        .concat("  store ").concat(lty).concat(" ").concat(t.val).concat(", ptr ").concat(slot).concat("\n")
        .concat("  br label %").concat(end_label).concat("\n")
        .concat(else_label).concat(":\n")
        .concat(e.code)
        .concat("  store ").concat(lty).concat(" ").concat(e.val).concat(", ptr ").concat(slot).concat("\n")
        .concat("  br label %").concat(end_label).concat("\n")
        .concat(end_label).concat(":\n")
        .concat("  ").concat(res).concat(" = load ").concat(lty).concat(", ptr ").concat(slot).concat("\n");
    Emit { code: code, allocas: "  ".concat(slot).concat(" = alloca ").concat(lty).concat("\n").concat(c.allocas).concat(t.allocas).concat(e.allocas), releases: c.releases.concat(t.releases).concat(e.releases),globals: c.globals.concat(t.globals).concat(e.globals), val: res, ty: ty, n: e.n + 1 }
}

// --- for loops ---
//
// Only `for x in lo..hi` — a literal range — matching the self-hosted
// INTERPRETER's own identical restriction (`eval_for_env`). Iterating an
// array needs arrays first.
//
// The bound is evaluated ONCE, before the loop, into its own slot:
// re-evaluating `hi` per iteration would be both slower and wrong for a
// bound whose expression has effects. The induction variable lives in a
// slot too, which is what lets the loop body read it as an ordinary
// local with no special case at all.
//
// A `for` is `Unit`-valued. Assignments its body makes to OUTER locals
// take effect with no extra machinery, because those locals are slots
// and a store is a store — the exact thing the self-hosted interpreter
// needed a whole env-threading mechanism (`scope_out`) to get right.
// The range's two ends arrive as separate typed children — the checker
// already destructured `lo..hi`, so there is no `BRange` node left to
// pattern-match on here.
let cg_for (p: CgProgram) (env: Array[CgSlot]) (n: Int) (pattern: parser.PPattern) (lo_e: typecheck.TExpr) (hi_e: typecheck.TExpr) (body: typecheck.TExpr): Emit = {
    let lo = cg_expr(p, env, n, lo_e);
    let hi = cg_expr(p, env, lo.n, hi_e);
    let iv = cg_reg(hi.n);
    let hi_slot = cg_reg(hi.n + 1);
    let cond_label = cg_label(hi.n + 2);
    let body_label = cg_label(hi.n + 3);
    let end_label = cg_label(hi.n + 4);
    let cur = cg_reg(hi.n + 5);
    let bound = cg_reg(hi.n + 6);
    let test = cg_reg(hi.n + 7);
    let b = cg_expr(p, env.push(CgSlot { name: cg_let_name(pattern), ptr: iv, ty: CgInt, ity: ITInt }), hi.n + 8, body);
    let step_cur = cg_reg(b.n);
    let step_next = cg_reg(b.n + 1);
    let code = lo.code.concat(hi.code)
        .concat("  store i64 ").concat(lo.val).concat(", ptr ").concat(iv).concat("\n")
        .concat("  store i64 ").concat(hi.val).concat(", ptr ").concat(hi_slot).concat("\n")
        .concat("  br label %").concat(cond_label).concat("\n")
        .concat(cond_label).concat(":\n")
        .concat("  ").concat(cur).concat(" = load i64, ptr ").concat(iv).concat("\n")
        .concat("  ").concat(bound).concat(" = load i64, ptr ").concat(hi_slot).concat("\n")
        .concat("  ").concat(test).concat(" = icmp slt i64 ").concat(cur).concat(", ").concat(bound).concat("\n")
        .concat("  br i1 ").concat(test).concat(", label %").concat(body_label).concat(", label %").concat(end_label).concat("\n")
        .concat(body_label).concat(":\n")
        .concat(b.code)
        .concat("  ").concat(step_cur).concat(" = load i64, ptr ").concat(iv).concat("\n")
        .concat("  ").concat(step_next).concat(" = add i64 ").concat(step_cur).concat(", 1\n")
        .concat("  store i64 ").concat(step_next).concat(", ptr ").concat(iv).concat("\n")
        .concat("  br label %").concat(cond_label).concat("\n")
        .concat(end_label).concat(":\n");
    let allocas = "  ".concat(iv).concat(" = alloca i64\n")
        .concat("  ").concat(hi_slot).concat(" = alloca i64\n")
        .concat(lo.allocas).concat(hi.allocas).concat(b.allocas);
    Emit { code: code, allocas: allocas, releases: lo.releases.concat(hi.releases).concat(b.releases), globals: lo.globals.concat(hi.globals).concat(b.globals), val: "0", ty: CgUnit, n: b.n + 2 }
}

// --- Blocks and statements ---
//
// A block's own `let` bindings extend the environment for the rest of
// the block and then go out of scope, which falls out of threading the
// environment by value: `cg_block` never returns its inner `env`.
struct BlockEmit { code: String, allocas: String, releases: String, globals: String, env: Array[CgSlot], n: Int }

let cg_block_ty (p: CgProgram) (env: Array[CgSlot]) (n: Int) (block: typecheck.TBlock) (ty: CgTy): Emit = {
    let s = cg_stmts(p, env, n, block.stmts, 0);
    match block.tail {
        Some(t) => {
            let r = cg_expr(p, s.env, s.n, t);
            Emit { code: s.code.concat(r.code), allocas: s.allocas.concat(r.allocas), releases: s.releases.concat(r.releases),globals: s.globals.concat(r.globals), val: r.val, ty: ty, n: r.n }
        },
        None => Emit { code: s.code, allocas: s.allocas, releases: s.releases,globals: s.globals, val: "0", ty: CgUnit, n: s.n },
    }
}

let cg_stmts (p: CgProgram) (env: Array[CgSlot]) (n: Int) (stmts: Array[typecheck.TStmt]) (i: Int): BlockEmit =
    if i >= stmts.len() { BlockEmit { code: "", allocas: "", releases: "",globals: "", env: env, n: n } }
    else {
        match stmts[i] {
            TSLet(pattern, value) => {
                let r = cg_expr(p, env, n, value);
                let name = cg_let_name(pattern);
                let slot = cg_reg(r.n);
                let lty = cg_llvm_ty(r.ty);
                // Rule 2: the slot takes ownership of `r`'s +1. Any
                // value already in the slot -- a previous iteration's,
                // if this `let` is inside a loop -- is released first.
                let vty = cg_concrete(p, typecheck.texpr_ty(p.subst, value));
                let head = r.code
                    .concat(cg_release_slot(vty, slot, "_pre"))
                    .concat("  store ").concat(lty).concat(" ").concat(r.val).concat(", ptr ").concat(slot).concat("\n");
                let rest = cg_stmts(p, env.push(CgSlot { name: name, ptr: slot, ty: r.ty, ity: vty }), r.n + 1, stmts, i + 1);
                BlockEmit {
                    code: head.concat(rest.code),
                    // The null-init and the exit release are as much a
                    // part of creating a slot as the `alloca` is; a slot
                    // whose release goes missing leaks, and one whose
                    // null-init goes missing releases uninitialised
                    // stack the first time it is overwritten.
                    allocas: "  ".concat(slot).concat(" = alloca ").concat(lty).concat("\n").concat(cg_null_init(vty, slot)).concat(r.allocas).concat(rest.allocas),
                    releases: cg_release_slot(vty, slot, "_end").concat(r.releases).concat(rest.releases),
                    globals: r.globals.concat(rest.globals), env: rest.env, n: rest.n }
            },
            // Assignment needs no new slot — that is the whole payoff of
            // every local being an `alloca`: `let mut` and `let` are the
            // same thing here, and a reassignment is one `store`.
            // `acc = acc.concat(x)` — the slot's current value is dead
            // the instant the slot is overwritten, which is the one
            // place ownership can be transferred into an operation
            // without any liveness analysis. That makes it eligible for
            // REUSE: appending in place when the cell turns out to be
            // uniquely referenced, instead of allocating a copy.
            //
            // This exact shape is what caused three separate accidental
            // O(n^2) blowups earlier in this project (string joins,
            // `Array.push` accumulation, `String.index_of`), so it is
            // worth special-casing even though a general last-use
            // analysis would subsume it.
            TSAssign(name, value) => if cg_is_self_concat(name, value) {
                let rest0 = cg_self_concat(p, env, n, name, value, stmts, i);
                rest0
            } else {
                let r = cg_expr(p, env, n, value);
                let store = match cg_lookup(env, name) {
                    Some(slot) => cg_release_slot(cg_concrete(p, typecheck.texpr_ty(p.subst, value)), slot.ptr, "_a".concat(r.n.to_string())).concat("  store ").concat(cg_llvm_ty(slot.ty)).concat(" ").concat(r.val).concat(", ptr ").concat(slot.ptr).concat("\n"),
                    None => { cg_fail("assignment to an unbound name: ".concat(name)); "" },
                };
                let rest = cg_stmts(p, env, r.n + 1, stmts, i + 1);
                BlockEmit { code: r.code.concat(store).concat(rest.code), allocas: r.allocas.concat(rest.allocas), releases: r.releases.concat(rest.releases), globals: r.globals.concat(rest.globals), env: rest.env, n: rest.n }
            },
            TSExpr(e) => {
                let r = cg_expr(p, env, n, e);
                let rest = cg_stmts(p, env, r.n, stmts, i + 1);
                // Rule 1: the value is owned, and nothing takes it.
                BlockEmit { code: r.code.concat(cg_dec(cg_concrete(p, typecheck.texpr_ty(p.subst, e)), r.val)).concat(rest.code), allocas: r.allocas.concat(rest.allocas), releases: r.releases.concat(rest.releases),globals: r.globals.concat(rest.globals), env: rest.env, n: rest.n }
            },
        }
    }

// Is this assignment `x = x.concat(<something>)`?
let cg_is_self_concat (name: String) (value: typecheck.TExpr): Bool =
    match value.node {
        TMethodCall(m, base, args) =>
            if m == "concat" && args.len() == 1 { match base.node { TIdent(b) => b == name, _ => false } } else { false },
        _ => false,
    }

let cg_self_concat (p: CgProgram) (env: Array[CgSlot]) (n: Int) (name: String) (value: typecheck.TExpr) (stmts: Array[typecheck.TStmt]) (i: Int): BlockEmit =
    match value.node {
        TMethodCall(_, base, args) => match cg_lookup(env, name) {
            None => { cg_fail("assignment to an unbound name: ".concat(name)); cg_stmts(p, env, n, stmts, i + 1) },
            Some(slot) => {
                // The receiver is loaded WITHOUT incrementing and
                // handed to the reusing concat, which consumes it. No
                // `_pre` release either: the slot's reference moved
                // into the call rather than being dropped.
                let recv = cg_reg(n);
                let arg = cg_borrow(p, env, n + 1, args[0]);
                let out = cg_reg(arg.n);
                let code = "  ".concat(recv).concat(" = load ptr, ptr ").concat(slot.ptr).concat("\n")
                    .concat(arg.code)
                    .concat("  ").concat(out).concat(" = call ptr @plum_str_concat_reuse(ptr ").concat(recv).concat(", ptr ").concat(arg.val).concat(")\n")
                    .concat(arg.drop)
                    .concat("  store ptr ").concat(out).concat(", ptr ").concat(slot.ptr).concat("\n");
                let rest = cg_stmts(p, env, arg.n + 1, stmts, i + 1);
                BlockEmit { code: code.concat(rest.code), allocas: arg.allocas.concat(rest.allocas), releases: arg.releases.concat(rest.releases), globals: arg.globals.concat(rest.globals), env: rest.env, n: rest.n }
            },
        },
        _ => { cg_fail("internal: cg_self_concat on a non-concat"); cg_stmts(p, env, n, stmts, i + 1) },
    }

let cg_let_name (pattern: parser.PPattern): String =
    match pattern {
        PIdent(name) => name,
        _ => { cg_fail("destructuring `let` isn't supported yet"); "_" },
    }

// --- Calls ---
//
// There is no dispatch left to do: `infer_call` already decided which
// of the five call shapes this is, and `cg_expr` routed accordingly.
// What used to be a resolution-order comment here (bound local beats
// builtin namespace beats top-level function beats method) now lives in
// the checker, stated once for both backends.

let cg_println (p: CgProgram) (env: Array[CgSlot]) (n: Int) (arg: typecheck.TExpr): Emit = {
    let a = cg_borrow(p, env, n, arg);
    let reg = cg_reg(a.n);
    if !cg_ty_eq(a.ty, CgStr) { cg_fail("println expects a String, found ".concat(cg_ty_name(a.ty))) };
    Emit {
        code: a.code.concat("  ").concat(reg).concat(" = call i1 @plum_println(ptr ").concat(a.val).concat(")\n").concat(a.drop),
        allocas: a.allocas, releases: a.releases,globals: a.globals, val: reg, ty: CgUnit, n: a.n + 1,
    }
}

// A named call: the user's own function, or a prelude signature. Only
// the former has a body to call — a builtin needs a real
// implementation, and this backend has only the handful its runtime
// provides, so anything else fails by name.
// The callee's symbol is its SPECIALIZED name — `cg_sym` folds the
// concrete type arguments into it — so a call site needs no knowledge
// of monomorphization beyond resolving those arguments through the
// enclosing specialization.
let cg_fn_call (p: CgProgram) (env: Array[CgSlot]) (n: Int) (name: String) (args: Array[typecheck.TExpr]) (targs: Array[typecheck.ITy]) (ret: CgTy): Emit = {
    let sym = match cg_array_concat_sym(p, name, targs) {
        Some(rt) => rt,
        None => match cg_runtime_fn(name) {
        Some(rt) => rt,
        None =>
            if cg_has_fn(p, name) { "@".concat(cg_sym(name, cg_concrete_list(p, targs, 0, []))) }
            else { { cg_fail("prelude function ".concat(name).concat(" has no implementation in this backend's runtime yet")); "@plum_missing" } },
    } };
    let a = cg_args(p, env, n, args, 0, "", "", "", "", []);
    let reg = cg_reg(a.n);
    let call = "  ".concat(reg).concat(" = call ").concat(cg_llvm_ty(ret)).concat(" ").concat(sym).concat("(").concat(cg_join_commas(a.vals)).concat(")\n")
        .concat(if Option.is_some(cg_runtime_fn(name)) || name == "Array.concat" { cg_dec_args(p, args, a.vals, 0, "") } else { "" });
    Emit { code: a.code.concat(call), allocas: a.allocas, releases: a.releases, globals: a.globals, val: reg, ty: ret, n: a.n + 1 }
}

// Prelude functions the RUNTIME implements directly, rather than as
// prelude Plum source. Deliberately a very short list: each entry is a
// place where Plum can't express the operation at all, not merely a
// place where C would be faster.
//
// `chars_of` is here because codepoint awareness has to bottom out
// somewhere — every other string routine is written in Plum on top of
// it. Anything that CAN be written in Plum is, in `cg_prelude_src`,
// because prelude source this backend compiles is prelude source it
// also proves it can handle.
// `Array.concat[T]` is intercepted and given a single-allocation
// implementation, with the variant chosen by T: a result holding heap
// elements needs its own reference to each, one holding `Int`s must not
// touch them. Choosing by the CALL SITE's instantiated type argument is
// something only a backend with the typed tree can do.
let cg_array_concat_sym (p: CgProgram) (name: String) (targs: Array[typecheck.ITy]): Option[String] =
    if name == "Array.concat" && targs.len() == 1 {
        if cg_is_heap(cg_of_ity(cg_concrete(p, targs[0]))) { Some("@plum_array_concat_heap") } else { Some("@plum_array_concat") }
    } else { None }

let cg_runtime_fn (name: String): Option[String] =
    if name == "chars_of" { Some("@plum_chars_of") }
    else if name == "panic_raw" { Some("@plum_panic") }
    else if name == "args" { Some("@plum_args") }
    else if name == "read_file_raw" { Some("@plum_read_file_raw") }
    else if name == "path_is_dir_raw" { Some("@plum_path_is_dir") }
    else if name == "dir_open_handle" { Some("@plum_dir_open") }
    else if name == "dir_next_entry" { Some("@plum_dir_next") }
    else if name == "dir_close_handle" { Some("@plum_dir_close") }
    else { None }

let cg_concrete_list (p: CgProgram) (ts: Array[typecheck.ITy]) (i: Int) (acc: Array[typecheck.ITy]): Array[typecheck.ITy] =
    if i >= ts.len() { acc } else { cg_concrete_list(p, ts, i + 1, acc.push(cg_concrete(p, ts[i]))) }

let cg_has_fn (p: CgProgram) (name: String): Bool = cg_has_fn_acc(p.fns, name, 0)
let cg_has_fn_acc (fns: Array[typecheck.TFn]) (name: String) (i: Int): Bool =
    if i >= fns.len() { false } else if fns[i].name == name { true } else { cg_has_fn_acc(fns, name, i + 1) }

struct ArgVals { code: String, allocas: String, releases: String, globals: String, vals: Array[String], n: Int }

// Arguments are emitted left to right, accumulating both their code and
// the `<ty> <val>` operand list the call needs. No parameter types are
// pushed down any more — a closure argument already carries its own
// resolved type from the checker.
let cg_args (p: CgProgram) (env: Array[CgSlot]) (n: Int) (args: Array[typecheck.TExpr]) (i: Int) (code: String) (allocas: String) (releases: String) (globals: String) (vals: Array[String]): ArgVals =
    if i >= args.len() { ArgVals { code: code, allocas: allocas, releases: releases, globals: globals, vals: vals, n: n } }
    else {
        let r = cg_expr(p, env, n, args[i]);
        cg_args(p, env, r.n, args, i + 1, code.concat(r.code), allocas.concat(r.allocas), releases.concat(r.releases), globals.concat(r.globals), vals.push(cg_llvm_ty(r.ty).concat(" ").concat(r.val)))
    }

let cg_join_commas (parts: Array[String]): String = cg_join_acc(parts, 1, if Array.is_empty(parts) { "" } else { parts[0] })
let cg_join_acc (parts: Array[String]) (i: Int) (acc: String): String =
    if i >= parts.len() { acc } else { cg_join_acc(parts, i + 1, acc.concat(", ").concat(parts[i])) }

let cg_method_call (p: CgProgram) (env: Array[CgSlot]) (n: Int) (method_name: String) (base: typecheck.TExpr) (args: Array[typecheck.TExpr]) (ty: CgTy): Emit =
    if method_name == "to_string" { cg_to_string(p, env, n, base) }
    else if method_name == "concat" { cg_concat(p, env, n, base, args[0]) }
    else if method_name == "len" { cg_len(p, env, n, base) }
    else if method_name == "push" { cg_array_push(p, env, n, base, args[0], ty) }
    else if method_name == "set" { cg_array_set(p, env, n, base, args[0], args[1], ty) }
    else if method_name == "to_float" { cg_to_float(p, env, n, base) }
    else if method_name == "ends_with" { cg_str_binop(p, env, n, base, args[0], "@plum_str_ends_with", CgBool) }
    else if method_name == "starts_with" { cg_str_binop(p, env, n, base, args[0], "@plum_str_starts_with", CgBool) }
    else if method_name == "contains" { cg_str_binop(p, env, n, base, args[0], "@plum_str_contains", CgBool) }
    else if method_name == "split" { cg_str_binop(p, env, n, base, args[0], "@plum_str_split", CgArray(CgStr)) }
    else { { cg_fail("method .".concat(method_name).concat("() isn't supported by this backend yet")); cg_unit_emit(n) } }

let cg_to_string (p: CgProgram) (env: Array[CgSlot]) (n: Int) (base: typecheck.TExpr): Emit = {
    let b = cg_expr(p, env, n, base);
    let reg = cg_reg(b.n);
    match b.ty {
        // Already a String — `.to_string()` on one is the identity, and
        // emitting a copy would be pure waste.
        CgStr => b,
        CgInt => Emit { code: b.code.concat("  ").concat(reg).concat(" = call ptr @plum_int_to_string(i64 ").concat(b.val).concat(")\n"), allocas: b.allocas, releases: b.releases, globals: b.globals, val: reg, ty: CgStr, n: b.n + 1 },
        CgFloat => Emit { code: b.code.concat("  ").concat(reg).concat(" = call ptr @plum_float_to_string(double ").concat(b.val).concat(")\n"), allocas: b.allocas, releases: b.releases, globals: b.globals, val: reg, ty: CgStr, n: b.n + 1 },
        CgBool => Emit { code: b.code.concat("  ").concat(reg).concat(" = call ptr @plum_bool_to_string(i1 ").concat(b.val).concat(")\n"), allocas: b.allocas, releases: b.releases, globals: b.globals, val: reg, ty: CgStr, n: b.n + 1 },
        CgUnit => { cg_fail("Unit has no .to_string()"); cg_unit_emit(b.n) },
        // The real backend generates a per-type `to_string` for these,
        // driven by its tag tables. Doing the same here is real work and
        // nothing in the corpus needs it yet, so it fails loudly rather
        // than printing a pointer.
        CgStruct(name) => { cg_fail(".to_string() on a struct isn't supported yet: ".concat(name)); cg_unit_emit(b.n) },
        CgEnum(name) => { cg_fail(".to_string() on an enum isn't supported yet: ".concat(name)); cg_unit_emit(b.n) },
        CgArray(_) => { cg_fail(".to_string() on an Array isn't supported yet"); cg_unit_emit(b.n) },
        CgClosure(_, _) => { cg_fail("a closure has no .to_string()"); cg_unit_emit(b.n) },
    }
}

// `sitofp` — a SIGNED integer widened to a double, which is exact for
// every value a 53-bit mantissa can hold and rounds beyond that,
// matching the real backend's own `ToFloat` lowering.
let cg_to_float (p: CgProgram) (env: Array[CgSlot]) (n: Int) (base: typecheck.TExpr): Emit = {
    let b = cg_expr(p, env, n, base);
    let reg = cg_reg(b.n);
    Emit {
        code: b.code.concat("  ").concat(reg).concat(" = sitofp i64 ").concat(b.val).concat(" to double\n"),
        allocas: b.allocas, releases: b.releases,globals: b.globals, val: reg, ty: CgFloat, n: b.n + 1,
    }
}

// The string PRIMITIVES that take a receiver and one argument and are
// implemented in the runtime rather than the prelude. They stay
// primitives (as they are in the real compiler, lowered to IR nodes)
// because they are byte-level operations, and writing them over
// `chars_of` in Plum would make them codepoint-level -- a different,
// slower, and for `starts_with`/`ends_with` observably different
// function.
let cg_str_binop (p: CgProgram) (env: Array[CgSlot]) (n: Int) (base: typecheck.TExpr) (arg: typecheck.TExpr) (fn_name: String) (ret: CgTy): Emit = {
    let a = cg_borrow(p, env, n, base);
    let b = cg_borrow(p, env, a.n, arg);
    let reg = cg_reg(b.n);
    Emit {
        code: a.code.concat(b.code).concat("  ").concat(reg).concat(" = call ").concat(cg_llvm_ty(ret)).concat(" ").concat(fn_name).concat("(ptr ").concat(a.val).concat(", ptr ").concat(b.val).concat(")\n")
            .concat(a.drop).concat(b.drop),
        allocas: a.allocas.concat(b.allocas), releases: a.releases.concat(b.releases),globals: a.globals.concat(b.globals), val: reg, ty: ret, n: b.n + 1,
    }
}

let cg_concat (p: CgProgram) (env: Array[CgSlot]) (n: Int) (base: typecheck.TExpr) (arg: typecheck.TExpr): Emit = {
    let a = cg_borrow(p, env, n, base);
    let b = cg_borrow(p, env, a.n, arg);
    let reg = cg_reg(b.n);
    Emit {
        code: a.code.concat(b.code).concat("  ").concat(reg).concat(" = call ptr @plum_str_concat(ptr ").concat(a.val).concat(", ptr ").concat(b.val).concat(")\n")
            .concat(a.drop).concat(b.drop),
        allocas: a.allocas.concat(b.allocas), releases: a.releases.concat(b.releases),globals: a.globals.concat(b.globals), val: reg, ty: CgStr, n: b.n + 1,
    }
}

// --- Strings and arrays ---

// `.len()` is overloaded on the receiver's representation — byte length
// for a `String`, element count for an `Array` — exactly as the real
// backend overloads it on the receiver's static type. The checker
// already resolved which; this just reads it off the receiver.
let cg_len (p: CgProgram) (env: Array[CgSlot]) (n: Int) (base: typecheck.TExpr): Emit = {
    let b = cg_borrow(p, env, n, base);
    let reg = cg_reg(b.n);
    let fn_name = match b.ty {
        CgStr => "@plum_str_len",
        CgArray(_) => "@plum_array_len",
        _ => { cg_fail(".len() requires a String or an Array, found ".concat(cg_ty_name(b.ty))); "@plum_str_len" },
    };
    Emit {
        code: b.code.concat("  ").concat(reg).concat(" = call i64 ").concat(fn_name).concat("(ptr ").concat(b.val).concat(")\n").concat(b.drop),
        allocas: b.allocas, releases: b.releases, globals: b.globals, val: reg, ty: CgInt, n: b.n + 1 }
}

// Cell layout is in `runtime.plum`: an `i64` length then one 8-byte
// slot per element. `push`/`set` build a NEW cell and copy, never
// mutate — Plum arrays are values, and this backend has no ownership
// analysis that could prove an in-place update safe. That is where the
// real backend was before FBIP; the difference is it now has
// `ArrayPushReuse` and this one does not, so a `push` in a loop here is
// quadratic. Real, and the most likely first performance cliff.

// The element type comes from the checker, so an EMPTY literal is no
// longer a special case: `let empty = []` has a real element type
// (whatever unification determined), and nothing has to record
// "undetermined". The first element is also no longer emitted twice
// just to discover a type — both of those were consequences of
// synthesizing types here instead of reading them.
let cg_array_lit (p: CgProgram) (env: Array[CgSlot]) (n: Int) (elems: Array[typecheck.TExpr]) (ty: CgTy): Emit = {
    let cell = cg_reg(n);
    let head = "  ".concat(cell).concat(" = call ptr @plum_array_new(i64 ").concat(elems.len().to_string()).concat(")\n");
    let st = cg_array_store_elems(p, env, n + 1, cell, elems, 0, "", "", "", "");
    Emit { code: head.concat(st.code), allocas: st.allocas, releases: st.releases,globals: st.globals, val: cell, ty: ty, n: st.n }
}

let cg_array_store_elems (p: CgProgram) (env: Array[CgSlot]) (n: Int) (cell: String) (elems: Array[typecheck.TExpr]) (i: Int) (code: String) (allocas: String) (releases: String) (globals: String): FieldsEmit =
    if i >= elems.len() { FieldsEmit { code: code, allocas: allocas, releases: releases, globals: globals, n: n } }
    else {
        let r = cg_expr(p, env, n, elems[i]);
        let ep = cg_reg(r.n);
        let line = "  ".concat(ep).concat(" = getelementptr i8, ptr ").concat(cell).concat(", i64 ").concat(cg_array_elem_offset(i).to_string()).concat("\n")
            .concat("  store ").concat(cg_llvm_ty(r.ty)).concat(" ").concat(r.val).concat(", ptr ").concat(ep).concat("\n");
        cg_array_store_elems(p, env, r.n + 1, cell, elems, i + 1, code.concat(r.code).concat(line), allocas.concat(r.allocas), releases.concat(r.releases), globals.concat(r.globals))
    }

// No bounds check. The real backend emits one; this one does not, which
// is a deliberate v1 cut and a genuinely unsafe one — an out-of-range
// index reads whatever follows the cell.
let cg_index (p: CgProgram) (env: Array[CgSlot]) (n: Int) (base: typecheck.TExpr) (idx: typecheck.TExpr) (elem: CgTy): Emit = {
    let b = cg_borrow(p, env, n, base);
    let i = cg_expr(p, env, b.n, idx);
    let out = cg_reg(i.n + 3);
    let code = b.code.concat(i.code).concat(cg_elem_ptr_lines(b.val, i.val, i.n))
        .concat("  ").concat(out).concat(" = load ").concat(cg_llvm_ty(elem)).concat(", ptr ").concat(cg_elem_ptr_reg(i.n)).concat("\n")
        .concat(cg_inc(elem, out))
        .concat(b.drop);
    Emit { code: code, allocas: b.allocas.concat(i.allocas), releases: b.releases.concat(i.releases), globals: b.globals.concat(i.globals), val: out, ty: elem, n: i.n + 4 }
}

let cg_array_push (p: CgProgram) (env: Array[CgSlot]) (n: Int) (base: typecheck.TExpr) (value: typecheck.TExpr) (ty: CgTy): Emit = {
    let b = cg_expr(p, env, n, base);
    let v = cg_expr(p, env, b.n, value);
    let old_len = cg_reg(v.n);
    let new_len = cg_reg(v.n + 1);
    let cell = cg_reg(v.n + 2);
    let copied = cg_reg(v.n + 3);
    let code = b.code.concat(v.code)
        .concat("  ").concat(old_len).concat(" = call i64 @plum_array_len(ptr ").concat(b.val).concat(")\n")
        .concat("  ").concat(new_len).concat(" = add i64 ").concat(old_len).concat(", 1\n")
        .concat("  ").concat(cell).concat(" = call ptr @plum_array_new(i64 ").concat(new_len).concat(")\n")
        .concat("  ").concat(copied).concat(" = call i1 @plum_array_copy(ptr ").concat(cell).concat(", ptr ").concat(b.val).concat(", i64 ").concat(old_len).concat(")\n")
        .concat(cg_inc_elems(v.ty, cell, old_len, cell.concat("_ie")))
        .concat(cg_elem_ptr_lines(cell, old_len, v.n + 4))
        .concat("  store ").concat(cg_llvm_ty(v.ty)).concat(" ").concat(v.val).concat(", ptr ").concat(cg_elem_ptr_reg(v.n + 4)).concat("\n")
        // The source array was an owned temporary and is done with.
        .concat(cg_dec(cg_concrete(p, typecheck.texpr_ty(p.subst, base)), b.val));
    Emit { code: code, allocas: b.allocas.concat(v.allocas), releases: b.releases.concat(v.releases),globals: b.globals.concat(v.globals), val: cell, ty: ty, n: v.n + 7 }
}

let cg_array_set (p: CgProgram) (env: Array[CgSlot]) (n: Int) (base: typecheck.TExpr) (idx: typecheck.TExpr) (value: typecheck.TExpr) (ty: CgTy): Emit = {
    let b = cg_expr(p, env, n, base);
    let i = cg_expr(p, env, b.n, idx);
    let v = cg_expr(p, env, i.n, value);
    let len = cg_reg(v.n);
    let cell = cg_reg(v.n + 1);
    let copied = cg_reg(v.n + 2);
    let code = b.code.concat(i.code).concat(v.code)
        .concat("  ").concat(len).concat(" = call i64 @plum_array_len(ptr ").concat(b.val).concat(")\n")
        .concat("  ").concat(cell).concat(" = call ptr @plum_array_new(i64 ").concat(len).concat(")\n")
        .concat("  ").concat(copied).concat(" = call i1 @plum_array_copy(ptr ").concat(cell).concat(", ptr ").concat(b.val).concat(", i64 ").concat(len).concat(")\n")
        .concat(cg_inc_elems(v.ty, cell, len, cell.concat("_ie")))
        // The slot being overwritten already had a reference from the
        // copy; releasing it keeps the new cell's count exact.
        .concat(cg_elem_ptr_lines(cell, i.val, v.n + 3))
        .concat("  ".concat(cell).concat("_old = load ").concat(cg_llvm_ty(v.ty)).concat(", ptr ").concat(cg_elem_ptr_reg(v.n + 3)).concat("\n"))
        .concat(cg_dec(cg_concrete(p, typecheck.texpr_ty(p.subst, value)), cell.concat("_old")))
        .concat("  store ").concat(cg_llvm_ty(v.ty)).concat(" ").concat(v.val).concat(", ptr ").concat(cg_elem_ptr_reg(v.n + 3)).concat("\n")
        .concat(cg_dec(cg_concrete(p, typecheck.texpr_ty(p.subst, base)), b.val));
    Emit { code: code, allocas: b.allocas.concat(i.allocas).concat(v.allocas), releases: b.releases.concat(i.releases).concat(v.releases),globals: b.globals.concat(i.globals).concat(v.globals), val: cell, ty: ty, n: v.n + 6 }
}

// --- Closures ---
//
// A closure value is `{ ptr code, capture0, capture1, ... }`. Calling
// one loads the code pointer and passes the cell itself back in as the
// first argument, so the lifted function can read its own captures.
//
// **Captures are the WHOLE enclosing environment**, not the closure's
// free variables. Computing free variables means a shadowing-aware scan
// of the body — the exact analysis that produced a real, crash-causing
// bug in `plum-ir/src/fbip.rs` earlier in this project when it got
// shadowing wrong. Capturing everything is trivially correct instead,
// and costs one word per in-scope local at the creation site.
//
// Captures are by VALUE, snapshotted at the literal's own creation
// site — matching real Plum semantics and the self-hosted interpreter's
// `VClosure` exactly.
//
// The closure's TYPE comes from the checker. That is what this stage
// bought: `let f = |n| n + 1` compiles now, because `n`'s
// representation was determined by unifying the body's use of it —
// inference this backend neither performs nor duplicates.
let cg_closure (p: CgProgram) (env: Array[CgSlot]) (n: Int) (params: Array[String]) (body: typecheck.TExpr) (fn_ity: typecheck.ITy): Emit = {
    let fn_ty = cg_of_ity(fn_ity);
    let param_tys = cg_closure_params(fn_ty);
    let param_itys = cg_closure_param_itys(fn_ity);
    if params.len() != param_tys.len() { cg_fail("closure takes ".concat(params.len().to_string()).concat(" parameter(s) but its type says ").concat(param_tys.len().to_string())) };
    let fn_name = "@plum_lambda".concat(n.to_string());
    // The lifted function's body is emitted against a FRESH environment
    // built from the captures and parameters, never the creation site's
    // slots directly — those are `alloca`s in a different function.
    let inner_env = cg_closure_inner_env(env, params, param_tys, param_itys, 0, []);
    let inner = cg_expr(p, inner_env, n + 1, body);
    let lifted = "define ".concat(cg_llvm_ty(inner.ty)).concat(" ").concat(fn_name).concat("(ptr %env").concat(cg_closure_param_decls(param_tys, 0, "")).concat(") {\nentry:\n")
        .concat(cg_capture_loads(env, 0, ""))
        .concat(cg_closure_param_slots(param_tys, 0, ""))
        .concat(inner.allocas)
        .concat(inner.code)
        .concat("  ret ").concat(cg_llvm_ty(inner.ty)).concat(" ").concat(inner.val).concat("\n}\n\n");
    let cell = cg_reg(inner.n);
    let head = "  ".concat(cell).concat(" = call ptr @plum_alloc(i64 ").concat((24 + 8 * env.len()).to_string()).concat(")\n")
        .concat("  ").concat(cell).concat("_c = getelementptr i8, ptr ").concat(cell).concat(", i64 ").concat(cg_closure_code_offset(()).to_string()).concat("\n")
        .concat("  store ptr ").concat(fn_name).concat(", ptr ").concat(cell).concat("_c\n")
        .concat("  ").concat(cell).concat("_r = getelementptr i8, ptr ").concat(cell).concat(", i64 ").concat(cg_closure_rel_offset(()).to_string()).concat("\n")
        .concat("  store ptr ").concat(fn_name).concat("_rel, ptr ").concat(cell).concat("_r\n");
    let caps = cg_capture_stores(env, 0, cell, inner.n + 1, "");
    // The companion release function walks exactly the captures this
    // literal took, by name and type, and is emitted alongside the
    // lifted function itself — the two are generated together because
    // only here is it known what was captured.
    let rel_fn = "define void ".concat(fn_name).concat("_rel(ptr %p) {\nentry:\n")
        .concat(cg_capture_releases(env, 0, ""))
        .concat("  ret void\n}\n\n");
    Emit { code: head.concat(caps.code), allocas: "", releases: "", globals: inner.globals.concat(lifted).concat(rel_fn), val: cell, ty: fn_ty, n: caps.n }
}

let cg_closure_ret (t: CgTy): CgTy =
    match t { CgClosure(_, ret) => ret, _ => { cg_fail("expected a closure, found ".concat(cg_ty_name(t))); CgUnit } }

let cg_closure_param_itys (t: typecheck.ITy): Array[typecheck.ITy] =
    match t { ITFunction(ptys, _) => ptys, _ => { cg_fail("expected a closure type"); [] } }

let cg_closure_params (t: CgTy): Array[CgTy] =
    match t { CgClosure(ptys, _) => ptys, _ => { cg_fail("expected a closure, found ".concat(cg_ty_name(t))); [] } }

// Capture slots keep the creation site's NAMES and order, so a name
// resolves inside the lifted function exactly as it did outside — and
// shadowing keeps working for free, because `cg_lookup` scans from the
// end of the list either way.
let cg_closure_inner_env (env: Array[CgSlot]) (params: Array[String]) (param_tys: Array[CgTy]) (param_itys: Array[typecheck.ITy]) (i: Int) (acc: Array[CgSlot]): Array[CgSlot] =
    if i < env.len() { cg_closure_inner_env(env, params, param_tys, param_itys, i + 1, acc.push(CgSlot { name: env[i].name, ptr: "%c".concat(i.to_string()), ty: env[i].ty, ity: env[i].ity })) }
    else if i - env.len() < params.len() {
        let j = i - env.len();
        cg_closure_inner_env(env, params, param_tys, param_itys, i + 1, acc.push(CgSlot { name: params[j], ptr: "%a".concat(j.to_string()), ty: param_tys[j], ity: param_itys[j] }))
    }
    else { acc }

let cg_closure_param_decls (param_tys: Array[CgTy]) (i: Int) (acc: String): String =
    if i >= param_tys.len() { acc }
    else { cg_closure_param_decls(param_tys, i + 1, acc.concat(", ").concat(cg_llvm_ty(param_tys[i])).concat(" %p").concat(i.to_string())) }

let cg_capture_loads (env: Array[CgSlot]) (i: Int) (acc: String): String =
    if i >= env.len() { acc }
    else {
        let lty = cg_llvm_ty(env[i].ty);
        let line = "  %cp".concat(i.to_string()).concat(" = getelementptr i8, ptr %env, i64 ").concat(cg_capture_offset(i).to_string()).concat("\n")
            .concat("  %cv").concat(i.to_string()).concat(" = load ").concat(lty).concat(", ptr %cp").concat(i.to_string()).concat("\n")
            .concat("  %c").concat(i.to_string()).concat(" = alloca ").concat(lty).concat("\n")
            .concat("  store ").concat(lty).concat(" %cv").concat(i.to_string()).concat(", ptr %c").concat(i.to_string()).concat("\n");
        cg_capture_loads(env, i + 1, acc.concat(line))
    }

let cg_closure_param_slots (param_tys: Array[CgTy]) (i: Int) (acc: String): String =
    if i >= param_tys.len() { acc }
    else {
        let lty = cg_llvm_ty(param_tys[i]);
        let line = "  %a".concat(i.to_string()).concat(" = alloca ").concat(lty).concat("\n")
            .concat("  store ").concat(lty).concat(" %p").concat(i.to_string()).concat(", ptr %a").concat(i.to_string()).concat("\n");
        cg_closure_param_slots(param_tys, i + 1, acc.concat(line))
    }

// One release per captured slot, at its own offset, using its own
// type's release function. `cg_rel_sym` needs an `ITy`, and a capture
// slot only carries a `CgTy` — but a closure's captures are always
// released through the representation-level path, which is exactly what
// `cg_rel_sym_cg` provides.
let cg_capture_releases (env: Array[CgSlot]) (i: Int) (acc: String): String =
    if i >= env.len() { acc }
    else if !cg_is_heap(env[i].ty) { cg_capture_releases(env, i + 1, acc) }
    else {
        let line = "  %kp".concat(i.to_string()).concat(" = getelementptr i8, ptr %p, i64 ").concat(cg_capture_offset(i).to_string()).concat("\n")
            .concat("  %kv").concat(i.to_string()).concat(" = load ptr, ptr %kp").concat(i.to_string()).concat("\n")
            .concat("  call void ").concat(cg_rel_sym(env[i].ity)).concat("(ptr %kv").concat(i.to_string()).concat(")\n");
        cg_capture_releases(env, i + 1, acc.concat(line))
    }

let cg_capture_stores (env: Array[CgSlot]) (i: Int) (cell: String) (n: Int) (acc: String): StoreEmit =
    if i >= env.len() { StoreEmit { code: acc, n: n } }
    else {
        let lty = cg_llvm_ty(env[i].ty);
        let v = cg_reg(n);
        let slot = cg_reg(n + 1);
        let line = "  ".concat(v).concat(" = load ").concat(lty).concat(", ptr ").concat(env[i].ptr).concat("\n")
            .concat(cg_inc(env[i].ty, v))
            .concat("  ").concat(slot).concat(" = getelementptr i8, ptr ").concat(cell).concat(", i64 ").concat(cg_capture_offset(i).to_string()).concat("\n")
            .concat("  store ").concat(lty).concat(" ").concat(v).concat(", ptr ").concat(slot).concat("\n");
        cg_capture_stores(env, i + 1, cell, n + 2, acc.concat(line))
    }

// Calling a closure VALUE: load the code pointer, pass the cell itself
// back as the environment argument.
let cg_call_closure_value (p: CgProgram) (env: Array[CgSlot]) (n: Int) (clo: Emit) (args: Array[typecheck.TExpr]): Emit = {
    let ret = cg_closure_ret(clo.ty);
    let a = cg_args(p, env, clo.n, args, 0, "", "", "", "", []);
    let fp = cg_reg(a.n);
    let out = cg_reg(a.n + 1);
    let code = clo.code.concat(a.code)
        .concat("  ").concat(fp).concat("p = getelementptr i8, ptr ").concat(clo.val).concat(", i64 ").concat(cg_closure_code_offset(()).to_string()).concat("\n")
        .concat("  ").concat(fp).concat(" = load ptr, ptr ").concat(fp).concat("p\n")
        .concat("  ").concat(out).concat(" = call ").concat(cg_llvm_ty(ret)).concat(" ").concat(fp).concat("(ptr ").concat(clo.val).concat(cg_prefix_commas(a.vals)).concat(")\n");
    Emit { code: code, allocas: clo.allocas.concat(a.allocas), releases: clo.releases.concat(a.releases),globals: clo.globals.concat(a.globals), val: out, ty: ret, n: a.n + 2 }
}

let cg_prefix_commas (vals: Array[String]): String = cg_prefix_acc(vals, 0, "")
let cg_prefix_acc (vals: Array[String]) (i: Int) (acc: String): String =
    if i >= vals.len() { acc } else { cg_prefix_acc(vals, i + 1, acc.concat(", ").concat(vals[i])) }

// --- Array.map / Array.filter / Array.fold ---
//
// These are PRELUDE functions in the real compiler — ordinary generic
// Plum source. This backend has neither a prelude nor generics, so they
// are emitted inline as loops instead. That is not a workaround: an
// inlined loop is what a monomorphizing backend would produce for them
// anyway.

let cg_elem_ty (t: CgTy): CgTy =
    match t {
        CgArray(elem) => elem,
        _ => { cg_fail("expected an Array, found ".concat(cg_ty_name(t))); CgUnit },
    }

// `base + 8 + 8*index`, as three real instructions. The resulting
// pointer is `cg_reg(n + 2)`; three registers are consumed.
let cg_elem_ptr_lines (arr: String) (idx: String) (n: Int): String =
    "  ".concat(cg_reg(n)).concat(" = mul i64 ").concat(idx).concat(", 8\n")
        .concat("  ").concat(cg_reg(n + 1)).concat(" = getelementptr i8, ptr ").concat(arr).concat(", i64 ").concat(cg_reg(n)).concat("\n")
        .concat("  ").concat(cg_reg(n + 2)).concat(" = getelementptr i8, ptr ").concat(cg_reg(n + 1)).concat(", i64 ").concat(cg_array_elem_offset(0).to_string()).concat("\n")

let cg_elem_ptr_reg (n: Int): String = cg_reg(n + 2)

// A counted loop over `0..len`. `pre` opens it (through the body
// label), `post` closes it; `idx_reg` holds the current index inside
// the body. The induction variable's `alloca` is the CALLER's to hoist.
struct LoopParts { pre: String, post: String, idx_reg: String, body_n: Int }

let cg_array_loop (iv: String) (len: String) (n: Int): LoopParts = {
    let cond_label = cg_label(n);
    let body_label = cg_label(n + 1);
    let end_label = cg_label(n + 2);
    let cur = cg_reg(n + 3);
    let test = cg_reg(n + 4);
    let step = cg_reg(n + 5);
    let pre = "  store i64 0, ptr ".concat(iv).concat("\n")
        .concat("  br label %").concat(cond_label).concat("\n")
        .concat(cond_label).concat(":\n")
        .concat("  ").concat(cur).concat(" = load i64, ptr ").concat(iv).concat("\n")
        .concat("  ").concat(test).concat(" = icmp slt i64 ").concat(cur).concat(", ").concat(len).concat("\n")
        .concat("  br i1 ").concat(test).concat(", label %").concat(body_label).concat(", label %").concat(end_label).concat("\n")
        .concat(body_label).concat(":\n");
    let post = "  ".concat(step).concat(" = add i64 ").concat(cur).concat(", 1\n")
        .concat("  store i64 ").concat(step).concat(", ptr ").concat(iv).concat("\n")
        .concat("  br label %").concat(cond_label).concat("\n")
        .concat(end_label).concat(":\n");
    LoopParts { pre: pre, post: post, idx_reg: cur, body_n: n + 6 }
}

let cg_invoke (clo_val: String) (ret: CgTy) (arg_ops: String) (n: Int): String =
    "  ".concat(cg_reg(n)).concat("p = getelementptr i8, ptr ").concat(clo_val).concat(", i64 ").concat(cg_closure_code_offset(()).to_string()).concat("\n")
        .concat("  ").concat(cg_reg(n)).concat(" = load ptr, ptr ").concat(cg_reg(n)).concat("p\n")
        .concat("  ").concat(cg_reg(n + 1)).concat(" = call ").concat(cg_llvm_ty(ret)).concat(" ").concat(cg_reg(n)).concat("(ptr ").concat(clo_val).concat(arg_ops).concat(")\n")

let cg_array_ns_call (p: CgProgram) (env: Array[CgSlot]) (n: Int) (fn_name: String) (args: Array[typecheck.TExpr]): Emit =
    if fn_name == "map" { cg_array_map(p, env, n, args[0], args[1]) }
    else if fn_name == "filter" { cg_array_filter(p, env, n, args[0], args[1]) }
    else if fn_name == "fold" { cg_array_fold(p, env, n, args[0], args[1], args[2]) }
    else { { cg_fail("Array.".concat(fn_name).concat("(..) isn't supported yet")); cg_unit_emit(n) } }

let cg_array_map (p: CgProgram) (env: Array[CgSlot]) (n: Int) (arr_e: typecheck.TExpr) (f_e: typecheck.TExpr): Emit = {
    let a = cg_expr(p, env, n, arr_e);
    let elem = cg_elem_ty(a.ty);
    let f = cg_expr(p, env, a.n, f_e);
    let ret = cg_closure_ret(f.ty);
    let len = cg_reg(f.n);
    let out = cg_reg(f.n + 1);
    let iv = cg_reg(f.n + 2);
    let lp = cg_array_loop(iv, len, f.n + 3);
    let b = lp.body_n;
    let ev = cg_reg(b + 3);
    let body = cg_elem_ptr_lines(a.val, lp.idx_reg, b)
        .concat("  ").concat(ev).concat(" = load ").concat(cg_llvm_ty(elem)).concat(", ptr ").concat(cg_elem_ptr_reg(b)).concat("\n")
        // Rule 4: the closure consumes what it is given, so the
        // borrowed element has to become owned first. The source array
        // keeps its own reference.
        .concat(cg_inc(elem, ev))
        .concat(cg_invoke(f.val, ret, ", ".concat(cg_llvm_ty(elem)).concat(" ").concat(ev), b + 4))
        .concat(cg_elem_ptr_lines(out, lp.idx_reg, b + 6))
        .concat("  store ").concat(cg_llvm_ty(ret)).concat(" ").concat(cg_reg(b + 5)).concat(", ptr ").concat(cg_elem_ptr_reg(b + 6)).concat("\n");
    let code = a.code.concat(f.code)
        .concat("  ").concat(len).concat(" = call i64 @plum_array_len(ptr ").concat(a.val).concat(")\n")
        .concat("  ").concat(out).concat(" = call ptr @plum_array_new(i64 ").concat(len).concat(")\n")
        .concat(lp.pre).concat(body).concat(lp.post);
    Emit { code: code, allocas: "  ".concat(iv).concat(" = alloca i64\n").concat(a.allocas).concat(f.allocas), releases: a.releases.concat(f.releases),globals: a.globals.concat(f.globals), val: out, ty: CgArray(ret), n: b + 9 }
}

// The output array is allocated at the INPUT's length and its length
// header is patched down afterwards to however many elements were kept.
// One pass; counting first would call the predicate twice per element,
// which is observably different for a predicate with effects.
let cg_array_filter (p: CgProgram) (env: Array[CgSlot]) (n: Int) (arr_e: typecheck.TExpr) (f_e: typecheck.TExpr): Emit = {
    let a = cg_expr(p, env, n, arr_e);
    let elem = cg_elem_ty(a.ty);
    let f = cg_expr(p, env, a.n, f_e);
    let len = cg_reg(f.n);
    let out = cg_reg(f.n + 1);
    let iv = cg_reg(f.n + 2);
    let cnt = cg_reg(f.n + 3);
    let lp = cg_array_loop(iv, len, f.n + 4);
    let b = lp.body_n;
    let ev = cg_reg(b + 3);
    let keep_label = cg_label(b + 6);
    let skip_label = cg_label(b + 7);
    let cur_cnt = cg_reg(b + 8);
    let next_cnt = cg_reg(b + 9);
    let body = cg_elem_ptr_lines(a.val, lp.idx_reg, b)
        .concat("  ").concat(ev).concat(" = load ").concat(cg_llvm_ty(elem)).concat(", ptr ").concat(cg_elem_ptr_reg(b)).concat("\n")
        // One reference for the predicate to consume, and -- if the
        // element is kept -- one more for the output array below.
        .concat(cg_inc(elem, ev))
        .concat(cg_invoke(f.val, CgBool, ", ".concat(cg_llvm_ty(elem)).concat(" ").concat(ev), b + 4))
        .concat("  br i1 ").concat(cg_reg(b + 5)).concat(", label %").concat(keep_label).concat(", label %").concat(skip_label).concat("\n")
        .concat(keep_label).concat(":\n")
        .concat("  ").concat(cur_cnt).concat(" = load i64, ptr ").concat(cnt).concat("\n")
        .concat(cg_elem_ptr_lines(out, cur_cnt, b + 10))
        .concat(cg_inc(elem, ev))
        .concat("  store ").concat(cg_llvm_ty(elem)).concat(" ").concat(ev).concat(", ptr ").concat(cg_elem_ptr_reg(b + 10)).concat("\n")
        .concat("  ").concat(next_cnt).concat(" = add i64 ").concat(cur_cnt).concat(", 1\n")
        .concat("  store i64 ").concat(next_cnt).concat(", ptr ").concat(cnt).concat("\n")
        .concat("  br label %").concat(skip_label).concat("\n")
        .concat(skip_label).concat(":\n");
    let final_cnt = cg_reg(b + 13);
    let code = a.code.concat(f.code)
        .concat("  ").concat(len).concat(" = call i64 @plum_array_len(ptr ").concat(a.val).concat(")\n")
        .concat("  ").concat(out).concat(" = call ptr @plum_array_new(i64 ").concat(len).concat(")\n")
        .concat("  store i64 0, ptr ").concat(cnt).concat("\n")
        .concat(lp.pre).concat(body).concat(lp.post)
        .concat("  ").concat(final_cnt).concat(" = load i64, ptr ").concat(cnt).concat("\n")
        .concat("  ").concat(final_cnt).concat("p = getelementptr i8, ptr ").concat(out).concat(", i64 8\n")
        .concat("  store i64 ").concat(final_cnt).concat(", ptr ").concat(final_cnt).concat("p\n");
    Emit {
        code: code,
        allocas: "  ".concat(iv).concat(" = alloca i64\n").concat("  ").concat(cnt).concat(" = alloca i64\n").concat(a.allocas).concat(f.allocas), releases: a.releases.concat(f.releases),
        globals: a.globals.concat(f.globals), val: out, ty: CgArray(elem), n: b + 14,
    }
}

let cg_array_fold (p: CgProgram) (env: Array[CgSlot]) (n: Int) (arr_e: typecheck.TExpr) (init_e: typecheck.TExpr) (f_e: typecheck.TExpr): Emit = {
    let a = cg_expr(p, env, n, arr_e);
    let elem = cg_elem_ty(a.ty);
    let init = cg_expr(p, env, a.n, init_e);
    let f = cg_expr(p, env, init.n, f_e);
    let acc_ty = cg_llvm_ty(init.ty);
    let len = cg_reg(f.n);
    let acc = cg_reg(f.n + 1);
    let iv = cg_reg(f.n + 2);
    let lp = cg_array_loop(iv, len, f.n + 3);
    let b = lp.body_n;
    let ev = cg_reg(b + 3);
    let cur_acc = cg_reg(b + 4);
    let body = cg_elem_ptr_lines(a.val, lp.idx_reg, b)
        .concat("  ").concat(ev).concat(" = load ").concat(cg_llvm_ty(elem)).concat(", ptr ").concat(cg_elem_ptr_reg(b)).concat("\n")
        .concat("  ").concat(cur_acc).concat(" = load ").concat(acc_ty).concat(", ptr ").concat(acc).concat("\n")
        // Both operands are consumed by the closure. The accumulator
        // slot's own reference is replaced by the result immediately
        // below, so it is released rather than incremented.
        .concat(cg_inc(elem, ev))
        .concat(cg_invoke(f.val, init.ty, ", ".concat(acc_ty).concat(" ").concat(cur_acc).concat(", ").concat(cg_llvm_ty(elem)).concat(" ").concat(ev), b + 5))
        .concat("  store ").concat(acc_ty).concat(" ").concat(cg_reg(b + 6)).concat(", ptr ").concat(acc).concat("\n");
    let out = cg_reg(b + 7);
    let code = a.code.concat(init.code).concat(f.code)
        .concat("  ").concat(len).concat(" = call i64 @plum_array_len(ptr ").concat(a.val).concat(")\n")
        .concat("  store ").concat(acc_ty).concat(" ").concat(init.val).concat(", ptr ").concat(acc).concat("\n")
        .concat(lp.pre).concat(body).concat(lp.post)
        .concat("  ").concat(out).concat(" = load ").concat(acc_ty).concat(", ptr ").concat(acc).concat("\n");
    Emit {
        code: code,
        allocas: "  ".concat(iv).concat(" = alloca i64\n").concat("  ").concat(acc).concat(" = alloca ").concat(acc_ty).concat("\n").concat(a.allocas).concat(init.allocas).concat(f.allocas), releases: a.releases.concat(init.releases).concat(f.releases),
        globals: a.globals.concat(init.globals).concat(f.globals), val: out, ty: init.ty, n: b + 8,
    }
}

// --- Structs, enums, and pattern matching ---

// A struct literal: allocate the cell, then store each field at its
// declared index. Fields are stored in DECLARATION order regardless of
// the order they were written in the literal, which is what makes a
// field read a fixed offset.
let cg_struct_lit (p: CgProgram) (env: Array[CgSlot]) (n: Int) (name: String) (fields: Array[typecheck.TFieldInit]): Emit = {
    let field_names = typecheck.ctx_field_names(p.ctx, name);
    let cell = cg_reg(n);
    let head = "  ".concat(cell).concat(" = call ptr @plum_alloc(i64 ").concat((8 + 8 * field_names.len()).to_string()).concat(")\n");
    let f = cg_store_fields(p, env, n + 1, field_names, cell, fields, 0, "", "", "", "");
    Emit { code: head.concat(f.code), allocas: f.allocas, releases: f.releases,globals: f.globals, val: cell, ty: CgStruct(name), n: f.n }
}

struct FieldsEmit { code: String, allocas: String, releases: String, globals: String, n: Int }

let cg_store_fields (p: CgProgram) (env: Array[CgSlot]) (n: Int) (field_names: Array[String]) (cell: String) (fields: Array[typecheck.TFieldInit]) (i: Int) (code: String) (allocas: String) (releases: String) (globals: String): FieldsEmit =
    if i >= fields.len() { FieldsEmit { code: code, allocas: allocas, releases: releases, globals: globals, n: n } }
    else {
        let idx = cg_field_index(field_names, fields[i].name, 0);
        let r = cg_expr(p, env, n, fields[i].value);
        let fp = cg_reg(r.n);
        let line = "  ".concat(fp).concat(" = getelementptr i8, ptr ").concat(cell).concat(", i64 ").concat(cg_field_offset(idx).to_string()).concat("
")
            .concat("  store ").concat(cg_llvm_ty(r.ty)).concat(" ").concat(r.val).concat(", ptr ").concat(fp).concat("
");
        cg_store_fields(p, env, r.n + 1, field_names, cell, fields, i + 1, code.concat(r.code).concat(line), allocas.concat(r.allocas), releases.concat(r.releases), globals.concat(r.globals))
    }

let cg_field_read (p: CgProgram) (env: Array[CgSlot]) (n: Int) (base: typecheck.TExpr) (name: String) (fty: CgTy): Emit = {
    let b = cg_borrow(p, env, n, base);
    match b.ty {
        CgStruct(sname) => {
            let base_ity = cg_concrete(p, typecheck.texpr_ty(p.subst, base));
            let idx = cg_field_index(typecheck.ctx_field_names(p.ctx, sname), name, 0);
            let fp = cg_reg(b.n);
            let out = cg_reg(b.n + 1);
            let code = b.code
                .concat("  ").concat(fp).concat(" = getelementptr i8, ptr ").concat(b.val).concat(", i64 ").concat(cg_field_offset(idx).to_string()).concat("
")
                .concat("  ").concat(out).concat(" = load ").concat(cg_llvm_ty(fty)).concat(", ptr ").concat(fp).concat("\n")
                .concat(cg_inc(fty, out))
                .concat(b.drop);
            Emit { code: code, allocas: b.allocas, releases: b.releases, globals: b.globals, val: out, ty: fty, n: b.n + 2 }
        },
        _ => { cg_fail("field access on a non-struct value: .".concat(name)); cg_unit_emit(b.n) },
    }
}

// A variant constructor call, `Circle(2)`. The cell is sized for the
// enum's WIDEST variant, not this one — see `cg_payload_offset`.
let cg_variant_call (p: CgProgram) (env: Array[CgSlot]) (n: Int) (tag: String) (args: Array[typecheck.TExpr]): Emit =
    match cg_find_variant(p, tag) {
        Some(v) => cg_variant_build(p, v, cg_args(p, env, n, args, 0, "", "", "", "", [])),
        None => { cg_fail("internal: unknown variant reached codegen: ".concat(tag)); cg_unit_emit(n) },
    }

let cg_variant_build (p: CgProgram) (v: CgVariant) (a: ArgVals): Emit = {
    let enum_name = cg_enum_of_variant(p, v.name);
    let cell = cg_reg(a.n);
    let head = "  ".concat(cell).concat(" = call ptr @plum_alloc(i64 ").concat(cg_enum_cell_size(p, enum_name).to_string()).concat(")\n")
        .concat("  ").concat(cell).concat("_t = getelementptr i8, ptr ").concat(cell).concat(", i64 ").concat(cg_tag_offset(()).to_string()).concat("\n")
        .concat("  store i64 ").concat(v.tag.to_string()).concat(", ptr ").concat(cell).concat("_t\n");
    let stores = cg_store_payload(cell, a.vals, 0, a.n + 1, "");
    Emit { code: a.code.concat(head).concat(stores.code), allocas: a.allocas, releases: a.releases,globals: a.globals, val: cell, ty: CgEnum(enum_name), n: stores.n }
}

struct StoreEmit { code: String, n: Int }

// `vals` entries are already `<llvm-ty> <operand>` pairs, which is
// exactly the form a `store` needs.
let cg_store_payload (cell: String) (vals: Array[String]) (i: Int) (n: Int) (acc: String): StoreEmit =
    if i >= vals.len() { StoreEmit { code: acc, n: n } }
    else {
        let pp = cg_reg(n);
        let line = "  ".concat(pp).concat(" = getelementptr i8, ptr ").concat(cell).concat(", i64 ").concat(cg_payload_offset(i).to_string()).concat("
")
            .concat("  store ").concat(vals[i]).concat(", ptr ").concat(pp).concat("
");
        cg_store_payload(cell, vals, i + 1, n + 1, acc.concat(line))
    }

// --- match ---
//
// Arms are tried in order: each gets a TEST block that computes an `i1`
// and branches either to its own body or to the next arm's test. One
// result slot, one merge block, exactly like `if` — because that is all
// a `match` is once the pattern tests are compiled out.
//
// A scrutinee that matches NO arm falls through to a block that returns
// the zero value of the result type. The real compiler proves
// exhaustiveness and this one does not, so this is a deliberate,
// documented v1 gap rather than a silent one: an inexhaustive `match`
// produces a defined-but-meaningless value instead of a diagnostic.
let cg_match (p: CgProgram) (env: Array[CgSlot]) (n: Int) (scrutinee: typecheck.TExpr) (arms: Array[typecheck.TArm]) (body_ty: CgTy): Emit = {
    let sity = cg_concrete(p, typecheck.texpr_ty(p.subst, scrutinee));
    // The arms only READ the scrutinee — every binding takes its own
    // reference in the arm body — so matching on a variable borrows it.
    let sc = cg_borrow(p, env, n, scrutinee);
    let slot = cg_reg(sc.n);
    let end_label = cg_label(sc.n + 1);
    let fail_label = cg_label(sc.n + 2);
    let lty = cg_llvm_ty(body_ty);
    let a = cg_match_arms(p, env, sc.n + 3, arms, 0, sc.val, sity, slot, lty, end_label, fail_label, "", "", "", "");
    let res = cg_reg(a.n);
    let code = sc.code
        .concat("  br label %").concat(cg_label(sc.n + 3)).concat("
")
        .concat(a.code)
        .concat(fail_label).concat(":
")
        .concat("  store ").concat(lty).concat(" ").concat(cg_zero_of(body_ty)).concat(", ptr ").concat(slot).concat("
")
        .concat("  br label %").concat(end_label).concat("
")
        .concat(end_label).concat(":
")
        .concat("  ").concat(res).concat(" = load ").concat(lty).concat(", ptr ").concat(slot).concat("\n")
        // The scrutinee was an owned temporary; the arms borrowed from
        // it and any bindings took their own references, so it is done.
        .concat(sc.drop);
    Emit {
        code: code,
        allocas: "  ".concat(slot).concat(" = alloca ").concat(lty).concat("\n").concat(sc.allocas).concat(a.allocas), releases: sc.releases.concat(a.releases),
        globals: sc.globals.concat(a.globals), val: res, ty: body_ty, n: a.n + 1,
    }
}

let cg_zero_of (t: CgTy): String =
    match t {
        CgInt => "0",
        CgFloat => "0.0",
        CgBool => "0",
        CgUnit => "0",
        CgStr => "null",
        CgStruct(_) => "null",
        CgEnum(_) => "null",
        CgArray(_) => "null",
        CgClosure(_, _) => "null",
    }

struct ArmsEmit { code: String, allocas: String, releases: String,globals: String, n: Int }

let cg_match_arms (p: CgProgram) (env: Array[CgSlot]) (n: Int) (arms: Array[typecheck.TArm]) (i: Int) (sval: String) (sity: typecheck.ITy) (slot: String) (lty: String) (end_label: String) (fail_label: String) (code: String) (allocas: String) (releases: String) (globals: String): ArmsEmit =
    if i >= arms.len() { ArmsEmit { code: code, allocas: allocas, releases: releases, globals: globals, n: n } }
    else {
        let test_label = cg_label(n);
        let pat = cg_pattern(p, env, n + 1, arms[i].pattern, sval, sity);
        let body_label = cg_label(pat.n);
        let b = cg_expr(p, pat.env, pat.n + 1, arms[i].body);
        // The NEXT arm's test label, or the fail block if this is the
        // last arm — computed before recursing so the branch can name
        // it, which is why the arm counter is threaded rather than
        // derived.
        let next_label = if i + 1 >= arms.len() { fail_label } else { cg_label(b.n) };
        let this_code = test_label.concat(":
")
            .concat(pat.code)
            .concat("  br i1 ").concat(pat.test).concat(", label %").concat(body_label).concat(", label %").concat(next_label).concat("
")
            .concat(body_label).concat(":\n")
            // Only now is the arm known to match, so only now may its
            // bindings be stored and take references.
            .concat(pat.binds)
            .concat(b.code)
            .concat("  store ").concat(lty).concat(" ").concat(b.val).concat(", ptr ").concat(slot).concat("
")
            .concat("  br label %").concat(end_label).concat("
");
        cg_match_arms(p, env, b.n, arms, i + 1, sval, sity, slot, lty, end_label, fail_label,
            code.concat(this_code), allocas.concat(pat.allocas).concat(b.allocas), releases.concat(pat.releases).concat(b.releases), globals.concat(pat.globals).concat(b.globals))
    }

// --- Patterns ---
//
// A pattern compiles to `test` (an `i1` operand) plus the bindings it
// introduces. Bindings are computed UNCONDITIONALLY, before the test is
// known to have passed — safe because every load involved is in-bounds
// by construction (`cg_payload_offset`'s over-allocation rule is what
// buys that), and simpler than threading a second control-flow layer
// through nested patterns.
// `binds` is separate from `code` for a reason that only appears once
// reference counting is on. Pattern bindings are computed
// UNCONDITIONALLY — every arm's payload is loaded before any tag is
// checked — which is safe for a LOAD (the over-allocation rule in
// `cg_payload_offset` guarantees the address is mapped) and NOT safe
// for an INCREMENT, because an increment writes THROUGH that pointer.
// `render_token`'s fifty-arm match reads `TokIdent`'s string payload
// while looking at a `TokInt`, so the "pointer" is the integer 1.
//
// So the load stays in the test block and the increment moves to the
// arm's BODY block, which only runs when the tag actually matched.
struct PatEmit { code: String, binds: String, allocas: String, releases: String, globals: String, test: String, env: Array[CgSlot], n: Int }

// The scrutinee's type is passed as an `ITy`, not a `CgTy`: a generic
// aggregate's field and payload types are TEMPLATES (`T`), and
// instantiating them needs the type ARGUMENTS, which a representation
// has already thrown away. `CgStruct("Box")` cannot tell you whether
// its `item` loads as an `i64` or a `ptr`; `ITStruct("Box", [Int])`
// can.
let cg_pattern (p: CgProgram) (env: Array[CgSlot]) (n: Int) (pattern: parser.PPattern) (sval: String) (sity: typecheck.ITy): PatEmit =
    match pattern {
        PWildcard => PatEmit { code: "", binds: "", allocas: "", releases: "",globals: "", test: "1", env: env, n: n },
        // A binding always matches; the slot it introduces is what the
        // arm body reads.
        PIdent(name) => {
            let slot = cg_reg(n);
            let sty = cg_of_ity(sity);
            let lty = cg_llvm_ty(sty);
            // A binding takes its OWN reference. Payload and field
            // loads in patterns deliberately do not increment — they
            // borrow from the scrutinee, which is released once the
            // whole match is done — so incrementing here is what keeps
            // the binding valid past that release.
            // BOTH the store and the increment are conditional. Leaving
            // the store in the test block would leave a non-matching
            // arm's slot holding a garbage pointer — the integer 1, say
            // — which the function's exit release would then write
            // through. The slot keeps its null instead, and releasing
            // null is a no-op.
            PatEmit {
                code: "",
                binds: cg_inc(sty, sval).concat("  store ").concat(lty).concat(" ").concat(sval).concat(", ptr ").concat(slot).concat("\n"),
                allocas: "  ".concat(slot).concat(" = alloca ").concat(lty).concat("\n").concat(cg_null_init(sity, slot)),
                releases: cg_release_slot(sity, slot, "_end"),
                globals: "", test: "1", env: env.push(CgSlot { name: name, ptr: slot, ty: sty, ity: sity }), n: n + 1,
            }
        },
        PInt(v) => cg_pat_cmp(env, n, "icmp eq i64 ", sval, v.to_string()),
        PFloat(v) => cg_pat_cmp(env, n, "fcmp oeq double ", sval, cg_float_text(v)),
        PBool(v) => cg_pat_cmp(env, n, "icmp eq i1 ", sval, if v { "1" } else { "0" }),
        PStr(v) => cg_pat_str(env, n, sval, v),
        PVariant(path, arg_pats) => cg_pat_variant(p, env, n, path[path.len() - 1], arg_pats, sval, sity),
        PStruct(path, field_pats, _) => cg_pat_struct(p, env, n, path[path.len() - 1], field_pats, sval, sity),
        PTuple(_) => { cg_fail("tuple patterns aren't supported yet"); PatEmit { code: "", binds: "", allocas: "", releases: "",globals: "", test: "0", env: env, n: n } },
        POr(_) => { cg_fail("or-patterns aren't supported yet"); PatEmit { code: "", binds: "", allocas: "", releases: "",globals: "", test: "0", env: env, n: n } },
    }

let cg_pat_cmp (env: Array[CgSlot]) (n: Int) (op: String) (sval: String) (lit: String): PatEmit = {
    let reg = cg_reg(n);
    PatEmit { code: "  ".concat(reg).concat(" = ").concat(op).concat(sval).concat(", ").concat(lit).concat("
"), binds: "", allocas: "", releases: "", globals: "", test: reg, env: env, n: n + 1 }
}

let cg_pat_str (env: Array[CgSlot]) (n: Int) (sval: String) (lit: String): PatEmit = {
    // Compared directly against the STATIC cell — no copy. The literal
    // global IS a complete string cell now, so building a fresh one to
    // compare against would both allocate and, worse, copy from the
    // cell's refcount word as if it were the first byte of text.
    let gname = "@.str".concat(n.to_string());
    let test = cg_reg(n + 2);
    let code = "  ".concat(test).concat(" = call i1 @plum_str_eq(ptr ").concat(sval).concat(", ptr ").concat(gname).concat(")\n");
    PatEmit { code: code, binds: "", allocas: "", releases: "",globals: cg_str_constant(n, lit), test: test, env: env, n: n + 3 }
}

let cg_pat_variant (p: CgProgram) (env: Array[CgSlot]) (n: Int) (name: String) (arg_pats: Array[parser.PPattern]) (sval: String) (sity: typecheck.ITy): PatEmit =
    match cg_find_variant(p, name) {
        None => { cg_fail("unknown variant in pattern: ".concat(name)); PatEmit { code: "", binds: "", allocas: "", releases: "",globals: "", test: "0", env: env, n: n } },
        Some(v) => {
            let tag = cg_reg(n);
            let tag_ok = cg_reg(n + 1);
            let head = "  ".concat(tag).concat("p = getelementptr i8, ptr ").concat(sval).concat(", i64 ").concat(cg_tag_offset(()).to_string()).concat("\n")
                .concat("  ").concat(tag).concat(" = load i64, ptr ").concat(tag).concat("p\n")
                .concat("  ").concat(tag_ok).concat(" = icmp eq i64 ").concat(tag).concat(", ").concat(v.tag.to_string()).concat("\n");
            // Payload templates instantiated against the SCRUTINEE's
            // own type arguments — `Yes(v)` matched on a `Maybe[Int]`
            // binds `v` as an `Int`, and on a `Maybe[String]` as a
            // pointer, from one unspecialized enum declaration.
            let payload = Array.map(typecheck.ctx_variant_payload(p.ctx, name), |t| typecheck.instantiate_template(typecheck.ctx_variant_generics(p.ctx, name), cg_ity_args(sity), t));
            let sub = cg_pat_payloads(p, env, n + 2, payload, arg_pats, 0, sval, tag_ok, "", "", "", "", "");
            PatEmit { code: head.concat(sub.code), binds: sub.binds, allocas: sub.allocas, releases: sub.releases, globals: sub.globals, test: sub.test, env: sub.env, n: sub.n }
        },
    }

// Each payload's own sub-pattern is tested and AND-ed into the running
// result. Plain `and`, not a short-circuit branch: every operand is
// already computed and side-effect-free, so there is nothing to skip.
let cg_pat_payloads (p: CgProgram) (env: Array[CgSlot]) (n: Int) (payload: Array[typecheck.ITy]) (pats: Array[parser.PPattern]) (i: Int) (sval: String) (test: String) (code: String) (binds: String) (allocas: String) (releases: String) (globals: String): PatEmit =
    if i >= pats.len() { PatEmit { code: code, binds: binds, allocas: allocas, releases: releases, globals: globals, test: test, env: env, n: n } }
    else {
        let pp = cg_reg(n);
        let pv = cg_reg(n + 1);
        let pty = cg_concrete(p, payload[i]);
        let load = "  ".concat(pp).concat(" = getelementptr i8, ptr ").concat(sval).concat(", i64 ").concat(cg_payload_offset(i).to_string()).concat("\n")
            .concat("  ").concat(pv).concat(" = load ").concat(cg_llvm_ty(cg_of_ity(pty))).concat(", ptr ").concat(pp).concat("\n");
        let sub = cg_pattern(p, env, n + 2, pats[i], pv, pty);
        let combined = cg_reg(sub.n);
        let join = "  ".concat(combined).concat(" = and i1 ").concat(test).concat(", ").concat(sub.test).concat("
");
        cg_pat_payloads(p, sub.env, sub.n + 1, payload, pats, i + 1, sval, combined,
            code.concat(load).concat(sub.code).concat(join), binds.concat(sub.binds), allocas.concat(sub.allocas), releases.concat(sub.releases), globals.concat(sub.globals))
    }

// A struct pattern has no tag to check — it always matches its own
// type — so the running test starts at `1` and only sub-patterns can
// falsify it. `Point { x, y }` binds shorthand fields, which the parser
// already expands into `x: x` field patterns.
let cg_pat_struct (p: CgProgram) (env: Array[CgSlot]) (n: Int) (name: String) (field_pats: Array[parser.FieldPatternNode]) (sval: String) (sity: typecheck.ITy): PatEmit =
    cg_pat_fields(p, env, n, typecheck.ctx_field_names(p.ctx, name),
        Array.map(typecheck.ctx_field_types(p.ctx, name), |t| typecheck.instantiate_template(typecheck.ctx_struct_generics(p.ctx, name), cg_ity_args(sity), t)),
        field_pats, 0, sval, "1", "", "", "", "", "")

// A struct's or enum's type ARGUMENTS at a use site. Anything else has
// none, which is the right answer for a primitive scrutinee.
let cg_ity_args (t: typecheck.ITy): Array[typecheck.ITy] =
    match t {
        ITStruct(_, args) => args,
        ITEnum(_, args) => args,
        _ => [],
    }

let cg_pat_fields (p: CgProgram) (env: Array[CgSlot]) (n: Int) (field_names: Array[String]) (field_tys: Array[typecheck.ITy]) (pats: Array[parser.FieldPatternNode]) (i: Int) (sval: String) (test: String) (code: String) (binds: String) (allocas: String) (releases: String) (globals: String): PatEmit =
    if i >= pats.len() { PatEmit { code: code, binds: binds, allocas: allocas, releases: releases, globals: globals, test: test, env: env, n: n } }
    else {
        let idx = cg_field_index(field_names, pats[i].name, 0);
        let fty = cg_concrete(p, field_tys[idx]);
        let fp = cg_reg(n);
        let fv = cg_reg(n + 1);
        let load = "  ".concat(fp).concat(" = getelementptr i8, ptr ").concat(sval).concat(", i64 ").concat(cg_field_offset(idx).to_string()).concat("\n")
            .concat("  ").concat(fv).concat(" = load ").concat(cg_llvm_ty(cg_of_ity(fty))).concat(", ptr ").concat(fp).concat("\n");
        let sub = cg_pattern(p, env, n + 2, pats[i].pattern, fv, fty);
        let combined = cg_reg(sub.n);
        let join = "  ".concat(combined).concat(" = and i1 ").concat(test).concat(", ").concat(sub.test).concat("
");
        cg_pat_fields(p, sub.env, sub.n + 1, field_names, field_tys, pats, i + 1, sval, combined,
            code.concat(load).concat(sub.code).concat(join), binds.concat(sub.binds), allocas.concat(sub.allocas), releases.concat(sub.releases), globals.concat(sub.globals))
    }

// --- Function and program emission ---

// Parameters arrive as SSA values (`%p0`) and are immediately spilled
// into `alloca` slots, so a parameter is read exactly like any other
// local and can even be reassigned. mem2reg undoes the spill.
// `n0` is the counter to START this function's names at, and `next` is
// where the following function must start. Counting CONTINUES across
// function boundaries rather than restarting at zero per function,
// because string-literal constants (`@.str<n>`) are MODULE-level: two
// functions each restarting at zero both emit `@.str0`, and clang
// rejects the redefinition. Register and label names would be fine
// either way — they're function-local — so this is entirely about the
// one name that escapes the function.
struct FnEmit { text: String, next: Int }

// `p.subst` is swapped to THIS function's substitution before its body
// is emitted — that is what lets `cg_ty` resolve any type recorded
// during its inference. Each function was inferred independently, so
// each has its own.
let cg_fn (p0: CgProgram) (def: typecheck.TFn) (targs: Array[typecheck.ITy]) (n0: Int): FnEmit = {
    let p = CgProgram { fns: p0.fns, globals: p0.globals, ctx: p0.ctx, enums: p0.enums, subst: def.subst, generics: def.generics, targs: targs };
    let params = cg_params_of(p, def.params, 0, []);
    let entry = cg_param_slots(params, Array.map(def.params, |q| cg_concrete(p, q.ty)), 0, [], "", "");
    let ret = cg_of_ity(cg_concrete(p, def.ret));
    let body = cg_expr(p, entry.env, n0, def.body);
    let header = "define ".concat(cg_llvm_ty(ret)).concat(" @").concat(cg_sym(def.name, targs)).concat("(").concat(cg_param_decls(params)).concat(") {\nentry:\n");
    // Every `alloca` is hoisted here, at the top of the entry block,
    // ahead of any instruction that could branch — see `Emit`'s own
    // comment for why that is a correctness requirement inside loops
    // and not just a tidiness preference.
    let text = body.globals
        .concat(header)
        .concat(entry.code)
        .concat(body.allocas)
        .concat(body.code)
        // Every slot is released here, on the way out. The RESULT is
        // untouched: it carries its own +1, obtained independently of
        // any slot (rule 3), so returning a parameter's value and then
        // releasing that parameter is balanced rather than a
        // use-after-free.
        .concat(body.releases)
        .concat(entry.releases)
        .concat("  ret ").concat(cg_llvm_ty(ret)).concat(" ").concat(body.val).concat("\n")
        .concat("}\n\n");
    FnEmit { text: text, next: body.n }
}

// The checker's `TParam`s carry resolved types already; this only maps
// them to representations. `()` — the Unit pattern — contributed no
// entry there, so a `let main (): Unit` really does emit as a
// zero-argument LLVM function.
struct CgParam { name: String, ty: CgTy }

let cg_params_of (p: CgProgram) (params: Array[typecheck.TParam]) (i: Int) (acc: Array[CgParam]): Array[CgParam] =
    if i >= params.len() { acc }
    else { cg_params_of(p, params, i + 1, acc.push(CgParam { name: params[i].name, ty: cg_of_ity(cg_concrete(p, params[i].ty)) })) }

let cg_param_decls (params: Array[CgParam]): String =
    cg_join_commas(cg_param_decl_list(params, 0, []))

let cg_param_decl_list (params: Array[CgParam]) (i: Int) (acc: Array[String]): Array[String] =
    if i >= params.len() { acc }
    else { cg_param_decl_list(params, i + 1, acc.push(cg_llvm_ty(params[i].ty).concat(" %p").concat(i.to_string()))) }

// Parameter slots use `%s<i>` names rather than the `%t<n>` counter, so
// the counter can start wherever the module-level string-constant
// numbering left off without colliding.
struct ParamSlots { env: Array[CgSlot], code: String, releases: String }

// Rule 4: a call consumes its arguments, so a parameter arrives OWNED
// and this function is responsible for releasing it — which happens
// through the same exit splice as every other slot.
let cg_param_slots (params: Array[CgParam]) (ptys: Array[typecheck.ITy]) (i: Int) (env: Array[CgSlot]) (code: String) (releases: String): ParamSlots =
    if i >= params.len() { ParamSlots { env: env, code: code, releases: releases } }
    else {
        let lty = cg_llvm_ty(params[i].ty);
        let slot = "%s".concat(i.to_string());
        let line = "  ".concat(slot).concat(" = alloca ").concat(lty).concat("\n")
            .concat("  store ").concat(lty).concat(" %p").concat(i.to_string()).concat(", ptr ").concat(slot).concat("\n");
        cg_param_slots(params, ptys, i + 1, env.push(CgSlot { name: params[i].name, ptr: slot, ty: params[i].ty, ity: ptys[i] }), code.concat(line), releases.concat(cg_release_slot(ptys[i], slot, "_end")))
    }

// The C entry point. Calls Plum's own `main` and discards its result —
// a `Unit` return carries no information, so nothing is printed. (The
// REAL backend echoed it for years, which is where every compiled
// program's stray trailing `0` came from; that was fixed the same day
// this file was started.)
let cg_entry (unit: Unit): String = cg_lines([
    "define i32 @main(i32 %argc, ptr %argv) {",
    "entry:",
    "  store i32 %argc, ptr @plum_argc",
    "  store ptr %argv, ptr @plum_argv",
    "  %reg = call i32 @atexit(ptr @plum_dump_stats)",
    "  call void @plum_init_globals()",
    "  %r = call i1 @plum_main()",
    "  ret i32 0",
    "}",
])

// --- Structural equality ---
//
// `==` on an aggregate must compare CONTENTS, not addresses. Emitting
// `icmp eq ptr` was silently wrong: two separately-built `TokLet`s are
// equal values at different addresses, so the self-hosted parser's own
// `tokens[pos] == expected` was always false and every parse failed
// with "expected 'let'". Found by compiling the parser, not by reading
// the code.
//
// The real backend generates one equality function per type from its
// tag tables; this does the same, discovered by the same worklist that
// discovers specializations. Comparing TAGS alone would have been
// enough for the parser — its expected tokens are all nullary — and
// would have been quietly wrong for `Ident("a") == Ident("b")`, so it
// isn't done that way.

let cg_eq_sym (t: typecheck.ITy): String = "@plum_eq_".concat(cg_ity_mangle(t))

// Is this type compared by VALUE inline, or does it need a function?
let cg_eq_is_primitive (t: typecheck.ITy): Bool =
    match t {
        ITInt => true, ITFloat => true, ITBool => true, ITUnit => true, ITStr => true,
        ITVar(_) => true,
        _ => false,
    }

struct EqEmit { code: String, val: String, n: Int }

// Comparing two already-emitted operands of type `t`.
let cg_eq_code (t: typecheck.ITy) (av: String) (bv: String) (n: Int): EqEmit = {
    let reg = cg_reg(n);
    let lty = cg_llvm_ty(cg_of_ity(t));
    let line = match t {
        ITStr => "  ".concat(reg).concat(" = call i1 @plum_str_eq(ptr ").concat(av).concat(", ptr ").concat(bv).concat(")\n"),
        ITFloat => "  ".concat(reg).concat(" = fcmp oeq double ").concat(av).concat(", ").concat(bv).concat("\n"),
        ITInt => "  ".concat(reg).concat(" = icmp eq i64 ").concat(av).concat(", ").concat(bv).concat("\n"),
        ITBool => "  ".concat(reg).concat(" = icmp eq i1 ").concat(av).concat(", ").concat(bv).concat("\n"),
        ITUnit => "  ".concat(reg).concat(" = icmp eq i1 ").concat(av).concat(", ").concat(bv).concat("\n"),
        // A defaulted (unconstrained) type is compared as its defaulted
        // representation, which is `Unit` — see `cg_of_ity`.
        ITVar(_) => "  ".concat(reg).concat(" = icmp eq i1 ").concat(av).concat(", ").concat(bv).concat("\n"),
        _ => "  ".concat(reg).concat(" = call i1 ").concat(cg_eq_sym(t)).concat("(").concat(lty).concat(" ").concat(av).concat(", ").concat(lty).concat(" ").concat(bv).concat(")\n"),
    };
    EqEmit { code: line, val: reg, n: n + 1 }
}

// Every aggregate type needing an equality function, transitively. The
// `seen` check is what makes a RECURSIVE type (`PExpr` whose payload is
// a `PExpr`) terminate — it needs exactly one function, which calls
// itself.
let cg_eq_close (p: CgProgram) (t: typecheck.ITy) (acc: Array[typecheck.ITy]): Array[typecheck.ITy] =
    if cg_eq_is_primitive(t) { acc }
    else if cg_ty_in(acc, t, 0) { acc }
    else {
        let acc2 = acc.push(t);
        match t {
            ITStruct(name, args) =>
                if name == "Array" { cg_eq_close(p, args[0], acc2) }
                else { cg_eq_close_list(p, Array.map(typecheck.ctx_field_types(p.ctx, name), |ft| typecheck.instantiate_template(typecheck.ctx_struct_generics(p.ctx, name), args, ft)), 0, acc2) },
            ITEnum(name, args) => cg_eq_close_variants(p, cg_find_enum(p, name).variants, args, 0, acc2),
            _ => acc2,
        }
    }

let cg_ty_in (acc: Array[typecheck.ITy]) (t: typecheck.ITy) (i: Int): Bool =
    if i >= acc.len() { false } else if cg_ity_mangle(acc[i]) == cg_ity_mangle(t) { true } else { cg_ty_in(acc, t, i + 1) }

let cg_eq_close_list (p: CgProgram) (ts: Array[typecheck.ITy]) (i: Int) (acc: Array[typecheck.ITy]): Array[typecheck.ITy] =
    if i >= ts.len() { acc } else { cg_eq_close_list(p, ts, i + 1, cg_eq_close(p, ts[i], acc)) }

let cg_eq_close_variants (p: CgProgram) (vs: Array[CgVariant]) (args: Array[typecheck.ITy]) (i: Int) (acc: Array[typecheck.ITy]): Array[typecheck.ITy] =
    if i >= vs.len() { acc }
    else {
        let payload = Array.map(typecheck.ctx_variant_payload(p.ctx, vs[i].name), |t| typecheck.instantiate_template(typecheck.ctx_variant_generics(p.ctx, vs[i].name), args, t));
        cg_eq_close_variants(p, vs, args, i + 1, cg_eq_close_list(p, payload, 0, acc))
    }

let cg_emit_eq_fns (p: CgProgram) (ts: Array[typecheck.ITy]) (i: Int) (acc: String): String =
    if i >= ts.len() { acc } else { cg_emit_eq_fns(p, ts, i + 1, acc.concat(cg_emit_eq_fn(p, ts[i]))) }

let cg_emit_eq_fn (p: CgProgram) (t: typecheck.ITy): String =
    match t {
        ITStruct(name, args) =>
            if name == "Array" { cg_emit_array_eq(t, args[0]) }
            else { cg_emit_struct_eq(t, Array.map(typecheck.ctx_field_types(p.ctx, name), |ft| typecheck.instantiate_template(typecheck.ctx_struct_generics(p.ctx, name), args, ft))) },
        ITEnum(name, args) => cg_emit_enum_eq(p, t, cg_find_enum(p, name).variants, args),
        _ => "",
    }

// Fields compared in declared order, AND-ed together. No
// short-circuiting: every field is loaded anyway, and a branch per
// field would be more code for no saved work.
let cg_emit_struct_eq (t: typecheck.ITy) (field_tys: Array[typecheck.ITy]): String = {
    let body = cg_eq_fields(field_tys, 0, "%a", "%b", 0, "1", "");
    "define i1 ".concat(cg_eq_sym(t)).concat("(ptr %a, ptr %b) {\nentry:\n").concat(body.code)
        .concat("  ret i1 ").concat(body.val).concat("\n}\n\n")
}

let cg_eq_fields (field_tys: Array[typecheck.ITy]) (i: Int) (av: String) (bv: String) (n: Int) (running: String) (acc: String): EqEmit =
    if i >= field_tys.len() { EqEmit { code: acc, val: running, n: n } }
    else {
        let lty = cg_llvm_ty(cg_of_ity(field_tys[i]));
        let off = cg_field_offset(i).to_string();
        let ap = cg_reg(n);
        let bp = cg_reg(n + 1);
        let axv = cg_reg(n + 2);
        let bxv = cg_reg(n + 3);
        let loads = "  ".concat(ap).concat(" = getelementptr i8, ptr ").concat(av).concat(", i64 ").concat(off).concat("\n")
            .concat("  ").concat(bp).concat(" = getelementptr i8, ptr ").concat(bv).concat(", i64 ").concat(off).concat("\n")
            .concat("  ").concat(axv).concat(" = load ").concat(lty).concat(", ptr ").concat(ap).concat("\n")
            .concat("  ").concat(bxv).concat(" = load ").concat(lty).concat(", ptr ").concat(bp).concat("\n");
        let cmp = cg_eq_code(field_tys[i], axv, bxv, n + 4);
        let joined = cg_reg(cmp.n);
        let join = "  ".concat(joined).concat(" = and i1 ").concat(running).concat(", ").concat(cmp.val).concat("\n");
        cg_eq_fields(field_tys, i + 1, av, bv, cmp.n + 1, joined, acc.concat(loads).concat(cmp.code).concat(join))
    }

// Tags first; equal tags then dispatch to a per-variant payload
// comparison. A nullary variant needs no block of its own — it falls
// through to `yes`, which is also the `switch` default, so the common
// case (`tok == TokEof`) is one integer compare and a jump.
let cg_emit_enum_eq (p: CgProgram) (t: typecheck.ITy) (vs: Array[CgVariant]) (args: Array[typecheck.ITy]): String = {
    let head = "define i1 ".concat(cg_eq_sym(t)).concat("(ptr %a, ptr %b) {\nentry:\n")
        .concat("  %tap = getelementptr i8, ptr %a, i64 ").concat(cg_tag_offset(()).to_string()).concat("\n")
        .concat("  %ta = load i64, ptr %tap\n")
        .concat("  %tbp = getelementptr i8, ptr %b, i64 ").concat(cg_tag_offset(()).to_string()).concat("\n")
        .concat("  %tb = load i64, ptr %tbp\n")
        .concat("  %same = icmp eq i64 %ta, %tb\n")
        .concat("  br i1 %same, label %payload, label %no\n")
        .concat("payload:\n")
        .concat("  switch i64 %ta, label %yes [\n").concat(cg_enum_eq_cases(vs, 0, "")).concat("  ]\n");
    head.concat(cg_enum_eq_blocks(p, vs, args, 0, 0, ""))
        .concat("yes:\n  ret i1 1\nno:\n  ret i1 0\n}\n\n")
}

let cg_enum_eq_cases (vs: Array[CgVariant]) (i: Int) (acc: String): String =
    if i >= vs.len() { acc }
    else if vs[i].arity == 0 { cg_enum_eq_cases(vs, i + 1, acc) }
    else { cg_enum_eq_cases(vs, i + 1, acc.concat("    i64 ").concat(vs[i].tag.to_string()).concat(", label %V").concat(vs[i].tag.to_string()).concat("\n")) }

let cg_enum_eq_blocks (p: CgProgram) (vs: Array[CgVariant]) (args: Array[typecheck.ITy]) (i: Int) (n: Int) (acc: String): String =
    if i >= vs.len() { acc }
    else if vs[i].arity == 0 { cg_enum_eq_blocks(p, vs, args, i + 1, n, acc) }
    else {
        let payload = Array.map(typecheck.ctx_variant_payload(p.ctx, vs[i].name), |q| typecheck.instantiate_template(typecheck.ctx_variant_generics(p.ctx, vs[i].name), args, q));
        let body = cg_eq_payloads(payload, 0, n, "1", "");
        let block = "V".concat(vs[i].tag.to_string()).concat(":\n").concat(body.code).concat("  ret i1 ").concat(body.val).concat("\n");
        cg_enum_eq_blocks(p, vs, args, i + 1, body.n, acc.concat(block))
    }

let cg_eq_payloads (payload: Array[typecheck.ITy]) (i: Int) (n: Int) (running: String) (acc: String): EqEmit =
    if i >= payload.len() { EqEmit { code: acc, val: running, n: n } }
    else {
        let lty = cg_llvm_ty(cg_of_ity(payload[i]));
        let off = cg_payload_offset(i).to_string();
        let ap = cg_reg(n);
        let bp = cg_reg(n + 1);
        let axv = cg_reg(n + 2);
        let bxv = cg_reg(n + 3);
        let loads = "  ".concat(ap).concat(" = getelementptr i8, ptr %a, i64 ").concat(off).concat("\n")
            .concat("  ").concat(bp).concat(" = getelementptr i8, ptr %b, i64 ").concat(off).concat("\n")
            .concat("  ").concat(axv).concat(" = load ").concat(lty).concat(", ptr ").concat(ap).concat("\n")
            .concat("  ").concat(bxv).concat(" = load ").concat(lty).concat(", ptr ").concat(bp).concat("\n");
        let cmp = cg_eq_code(payload[i], axv, bxv, n + 4);
        let joined = cg_reg(cmp.n);
        let join = "  ".concat(joined).concat(" = and i1 ").concat(running).concat(", ").concat(cmp.val).concat("\n");
        cg_eq_payloads(payload, i + 1, cmp.n + 1, joined, acc.concat(loads).concat(cmp.code).concat(join))
    }

// Lengths, then element by element, bailing on the first difference.
let cg_emit_array_eq (t: typecheck.ITy) (elem: typecheck.ITy): String = {
    let lty = cg_llvm_ty(cg_of_ity(elem));
    let cmp = cg_eq_code(elem, "%av", "%bv", 0);
    "define i1 ".concat(cg_eq_sym(t)).concat("(ptr %a, ptr %b) {\nentry:\n")
        .concat("  %lap = getelementptr i8, ptr %a, i64 8\n")
        .concat("  %la = load i64, ptr %lap\n")
        .concat("  %lbp = getelementptr i8, ptr %b, i64 8\n")
        .concat("  %lb = load i64, ptr %lbp\n")
        .concat("  %samelen = icmp eq i64 %la, %lb\n")
        .concat("  %ip = alloca i64\n")
        .concat("  store i64 0, ptr %ip\n")
        .concat("  br i1 %samelen, label %loop, label %no\n")
        .concat("loop:\n")
        .concat("  %i = load i64, ptr %ip\n")
        .concat("  %more = icmp slt i64 %i, %la\n")
        .concat("  br i1 %more, label %body, label %yes\n")
        .concat("body:\n")
        .concat("  %off = mul i64 %i, 8\n")
        .concat("  %ap0 = getelementptr i8, ptr %a, i64 %off\n")
        .concat("  %ap = getelementptr i8, ptr %ap0, i64 ").concat(cg_array_elem_offset(0).to_string()).concat("\n")
        .concat("  %bp0 = getelementptr i8, ptr %b, i64 %off\n")
        .concat("  %bp = getelementptr i8, ptr %bp0, i64 ").concat(cg_array_elem_offset(0).to_string()).concat("\n")
        .concat("  %av = load ").concat(lty).concat(", ptr %ap\n")
        .concat("  %bv = load ").concat(lty).concat(", ptr %bp\n")
        .concat(cmp.code)
        .concat("  br i1 ").concat(cmp.val).concat(", label %next, label %no\n")
        .concat("next:\n")
        .concat("  %i1 = add i64 %i, 1\n")
        .concat("  store i64 %i1, ptr %ip\n")
        .concat("  br label %loop\n")
        .concat("yes:\n  ret i1 1\nno:\n  ret i1 0\n}\n\n")
}

// --- Reference counting ---
//
// **The ownership discipline, stated once.**
//
//   1. Every expression evaluates to an OWNED reference (+1). The
//      evaluator of an expression is responsible for it.
//   2. A SLOT (a `let` binding, a parameter, a pattern binding) holds
//      an owned reference, and is released when the slot dies.
//   3. Reading a variable produces a NEW owned reference, so a read
//      increments. The slot keeps its own.
//   4. A call CONSUMES its arguments: the callee owns them and releases
//      them, exactly as it releases its own locals. A returned value
//      carries its +1 out.
//   5. An aggregate OWNS its fields/payload/elements/captures: values
//      stored into a cell transfer their +1 into it.
//
// Every one of those is local. There is no liveness analysis here and
// no reuse: this is precise reference counting, which is the thing
// Perceus is an optimization OF. The real backend's FBIP pass would sit
// on top of exactly this, and the cost of not having it is redundant
// inc/dec pairs, not incorrectness.
//
// Deciding WHICH values need any of this is where the typed tree pays
// off again. `plum-ir/src/fbip.rs` cannot track function parameters at
// all — its own comment says why: "no type checker in this IR to prove
// one is heap-shaped". Here every node's type is known, so
// `cg_is_heap` is total and exact.

// A heap slot starts as null, so that releasing whatever it held before
// an overwrite is safe on the very FIRST write — where "before" is
// uninitialised stack.
let cg_null_init (t: typecheck.ITy) (slot: String): String =
    if cg_rc_enabled(()) && cg_is_heap(cg_of_ity(t)) { "  store ptr null, ptr ".concat(slot).concat("\n") } else { "" }

// Release whatever a slot currently holds. Emitted twice for each slot,
// at different places — before an overwrite, and at function exit — so
// the scratch register is derived from the slot's own (already unique)
// name plus a distinguishing suffix.
let cg_release_slot (t: typecheck.ITy) (slot: String) (suffix: String): String =
    if cg_rc_enabled(()) && cg_is_heap(cg_of_ity(t)) {
        "  ".concat(slot).concat(suffix).concat(" = load ptr, ptr ").concat(slot).concat("\n")
            .concat("  call void ").concat(cg_rel_sym(t)).concat("(ptr ").concat(slot).concat(suffix).concat(")\n")
    } else { "" }

// **Reference counting is ON.** `sh2` frees what it allocates: peak RSS
// type-checking the whole compiler went from 6,415 MB to 755 MB, an
// 8.5x reduction, and the bootstrap fixed point still holds.
//
// The discipline, stated once:
//
//   1. Every expression evaluates to an OWNED reference (+1).
//   2. A slot (a `let`, a parameter, a pattern binding) holds an owned
//      reference and releases it when the slot dies.
//   3. Reading a variable produces a NEW owned reference, so a read
//      increments. The slot keeps its own.
//   4. A call CONSUMES its arguments; a returned value carries its +1
//      out.
//   5. An aggregate OWNS what is stored into it.
//
// Every rule is local — no liveness analysis, no reuse. This is precise
// reference counting, which is the thing Perceus is an optimization OF;
// the real backend's FBIP pass would sit on top of exactly this, and
// the cost of not having it is redundant inc/dec pairs, not
// incorrectness.
//
// Deciding WHAT needs counting is where the typed tree pays off.
// `plum-ir/src/fbip.rs` cannot track function parameters at all — its
// own comment gives the reason, "no type checker in this IR to prove
// one is heap-shaped", which is the documented root cause of the gap-1
// work reverted earlier in this project. Here every node's type is
// known, so `cg_is_heap` is total and exact and parameters are counted
// like anything else.
//
// The switch remains because it is genuinely useful: flipping it to
// `false` emits the leaking version, which is a one-line way to tell a
// counting bug apart from any other kind.
//
// KNOWN, and bounded: a closure cell's captures are incremented when
// stored but never released, because a closure's captures are not
// visible from its type and its release cannot walk them. That is a
// leak, not a crash, and it is why the real backend spends a word per
// closure cell on a release-function pointer. Arguments to runtime
// primitives are likewise not released.
let cg_rc_enabled (unit: Unit): Bool = true

let cg_is_heap (t: CgTy): Bool =
    match t {
        CgInt => false, CgFloat => false, CgBool => false, CgUnit => false,
        CgStr => true, CgStruct(_) => true, CgEnum(_) => true, CgArray(_) => true, CgClosure(_, _) => true,
    }

// After `memcpy`ing %n elements into a new array cell: the copy needs
// its own reference to each, or both cells release the same children.
let cg_inc_elems (elem: CgTy) (cell: String) (len: String) (reg: String): String =
    if cg_rc_enabled(()) && cg_is_heap(elem) {
        "  ".concat(reg).concat(" = call i1 @plum_array_inc_elems(ptr ").concat(cell).concat(", i64 ").concat(len).concat(")\n")
    } else { "" }

// Releasing something whose type is only known as a representation.
// Only closures reach this: their release frees the cell without
// walking captures, and a `CgClosure` carries enough to name that
// function.
let cg_dec_cg (t: CgTy) (val: String): String =
    match t {
        CgClosure(ptys, ret) => if cg_rc_enabled(()) { "  call void @plum_rel_closure(ptr ".concat(val).concat(")\n") } else { "" },
        _ => "",
    }

// Releasing the ARGUMENTS of a call into the runtime.
//
// Rule 4 says a call consumes its arguments — but that rule is about
// PLUM functions, which release their parameter slots on the way out.
// The runtime's own functions are hand-written IR that does no
// counting, so they BORROW instead, and the caller has to release.
//
// Getting this wrong is only ever a leak, and it was the dominant one:
// the compiler concatenates strings constantly, and every `.concat()`,
// `.to_string()`, `.len()` and `println()` was dropping both a +1 on
// the floor.
let cg_dec_args (p: CgProgram) (args: Array[typecheck.TExpr]) (vals: Array[String]) (i: Int) (acc: String): String =
    if i >= args.len() || i >= vals.len() { acc }
    // `vals` are already `<ty> <operand>` pairs, as a call needs them,
    // so the release is written with the operand as given rather than
    // re-prefixing a type.
    else { cg_dec_args(p, args, vals, i + 1, acc.concat(cg_dec_op(cg_concrete(p, typecheck.texpr_ty(p.subst, args[i])), vals[i]))) }

let cg_dec_op (t: typecheck.ITy) (operand: String): String =
    if cg_rc_enabled(()) && cg_is_heap(cg_of_ity(t)) { "  call void ".concat(cg_rel_sym(t)).concat("(").concat(operand).concat(")\n") } else { "" }

// --- Borrowing ---
//
// The single biggest source of redundant traffic: reading a variable
// increments, the operation uses it, and then it is released again.
// When the operand is a plain variable read, that pair is provably
// redundant — the SLOT holds a reference for the whole of a
// straight-line primitive operation, so the object cannot be freed
// underneath it. Skipping both is sound and removes the inc/dec pair
// entirely.
//
// This is the first step of what FBIP does properly. Perceus decides it
// with a liveness analysis (`plum-ir/src/fbip.rs`'s `mark_last_uses`);
// this decides it syntactically, which is weaker but needs no analysis
// and covers the overwhelmingly common shapes — `xs[i]`, `p.field`,
// `s.len()`, `println(msg)`, `a.concat(b)`, `match tok { .. }`.
//
// `drop` is what the caller must emit after the operand is finished
// with: empty for a borrow, a release for an owned temporary.
struct BorrowEmit { code: String, allocas: String, releases: String, globals: String, val: String, ty: CgTy, drop: String, n: Int }

let cg_borrow (p: CgProgram) (env: Array[CgSlot]) (n: Int) (e: typecheck.TExpr): BorrowEmit =
    match e.node {
        TIdent(name) => match cg_lookup(env, name) {
            Some(slot) => {
                let reg = cg_reg(n);
                BorrowEmit {
                    code: "  ".concat(reg).concat(" = load ").concat(cg_llvm_ty(slot.ty)).concat(", ptr ").concat(slot.ptr).concat("\n"),
                    allocas: "", releases: "", globals: "", val: reg, ty: slot.ty, drop: "", n: n + 1,
                }
            },
            None => cg_borrow_owned(p, env, n, e),
        },
        _ => cg_borrow_owned(p, env, n, e),
    }

let cg_borrow_owned (p: CgProgram) (env: Array[CgSlot]) (n: Int) (e: typecheck.TExpr): BorrowEmit = {
    let r = cg_expr(p, env, n, e);
    BorrowEmit {
        code: r.code, allocas: r.allocas, releases: r.releases, globals: r.globals,
        val: r.val, ty: r.ty, drop: cg_dec(cg_concrete(p, typecheck.texpr_ty(p.subst, e)), r.val), n: r.n,
    }
}

let cg_inc (t: CgTy) (val: String): String =
    if cg_rc_enabled(()) && cg_is_heap(t) { "  call void @plum_rc_inc(ptr ".concat(val).concat(")\n") } else { "" }

let cg_dec (t: typecheck.ITy) (val: String): String =
    if cg_rc_enabled(()) && cg_is_heap(cg_of_ity(t)) { "  call void ".concat(cg_rel_sym(t)).concat("(ptr ").concat(val).concat(")\n") } else { "" }

// A release function per TYPE, not per value, so a cell's children can
// be released without any runtime type information — the same shape as
// the equality functions, discovered by the same worklist.
//
// A `String` needs no generated function (it owns nothing), so it uses
// the runtime's plain one.
let cg_rel_sym (t: typecheck.ITy): String =
    match t { ITStr => "@plum_rel_str", _ => "@plum_rel_".concat(cg_ity_mangle(t)) }

// Types needing a generated release function, transitively. Same
// `seen`-guarded closure as `cg_eq_close`, and terminating for the same
// reason.
let cg_rel_close (p: CgProgram) (t: typecheck.ITy) (acc: Array[typecheck.ITy]): Array[typecheck.ITy] =
    if !cg_rc_enabled(()) { acc }
    else if !cg_is_heap(cg_of_ity(t)) { acc }
    else if cg_ty_in(acc, t, 0) { acc }
    else {
        match t {
            // A string owns nothing; the runtime releases it.
            ITStr => acc,
            _ => {
                let acc2 = acc.push(t);
                match t {
                    ITStruct(name, args) =>
                        if name == "Array" { cg_rel_close(p, args[0], acc2) }
                        else { cg_rel_close_list(p, Array.map(typecheck.ctx_field_types(p.ctx, name), |ft| typecheck.instantiate_template(typecheck.ctx_struct_generics(p.ctx, name), args, ft)), 0, acc2) },
                    ITEnum(name, args) => cg_rel_close_variants(p, cg_find_enum(p, name).variants, args, 0, acc2),
                    // A closure's captures are not visible from its
                    // type, so its cell cannot be walked structurally.
                    // Releasing one frees the cell and LEAKS whatever it
                    // captured — a real, bounded hole, and the reason
                    // the real backend stores a release-function pointer
                    // in every closure cell. Stated rather than hidden.
                    _ => acc2,
                }
            },
        }
    }

let cg_rel_close_list (p: CgProgram) (ts: Array[typecheck.ITy]) (i: Int) (acc: Array[typecheck.ITy]): Array[typecheck.ITy] =
    if i >= ts.len() { acc } else { cg_rel_close_list(p, ts, i + 1, cg_rel_close(p, ts[i], acc)) }

let cg_rel_close_variants (p: CgProgram) (vs: Array[CgVariant]) (args: Array[typecheck.ITy]) (i: Int) (acc: Array[typecheck.ITy]): Array[typecheck.ITy] =
    if i >= vs.len() { acc }
    else {
        let payload = Array.map(typecheck.ctx_variant_payload(p.ctx, vs[i].name), |t| typecheck.instantiate_template(typecheck.ctx_variant_generics(p.ctx, vs[i].name), args, t));
        cg_rel_close_variants(p, vs, args, i + 1, cg_rel_close_list(p, payload, 0, acc))
    }

let cg_emit_rel_fns (p: CgProgram) (ts: Array[typecheck.ITy]) (i: Int) (acc: String): String =
    if i >= ts.len() { acc } else { cg_emit_rel_fns(p, ts, i + 1, acc.concat(cg_emit_rel_fn(p, ts[i]))) }

// Every release function has the same shape: decrement, and on reaching
// zero release the children and free the cell.
let cg_rel_head (t: typecheck.ITy): String =
    "define void ".concat(cg_rel_sym(t)).concat("(ptr %p) {\nentry:\n")
        .concat("  %isnull = icmp eq ptr %p, null\n")
        .concat("  br i1 %isnull, label %skip, label %live\n")
        .concat("skip:\n  ret void\nlive:\n")
        .concat("  %rc = load i64, ptr %p\n")
        .concat("  %static = icmp slt i64 %rc, 0\n")
        .concat("  br i1 %static, label %skip, label %dec\n")
        .concat("dec:\n")
        .concat("  %rc1 = sub i64 %rc, 1\n")
        .concat("  store i64 %rc1, ptr %p\n")
        .concat("  %dead = icmp sle i64 %rc1, 0\n")
        .concat("  br i1 %dead, label %free, label %alive\n")
        .concat("alive:\n  ret void\nfree:\n")

let cg_rel_tail (unit: Unit): String = "  call void @free(ptr %p)\n  ret void\n}\n\n"

let cg_emit_rel_fn (p: CgProgram) (t: typecheck.ITy): String =
    match t {
        ITStruct(name, args) =>
            if name == "Array" { cg_emit_array_rel(t, args[0]) }
            else { cg_emit_struct_rel(t, Array.map(typecheck.ctx_field_types(p.ctx, name), |ft| typecheck.instantiate_template(typecheck.ctx_struct_generics(p.ctx, name), args, ft))) },
        ITEnum(name, args) => cg_emit_enum_rel(p, t, cg_find_enum(p, name).variants, args),
        ITFunction(_, _) => cg_rel_head(t).concat(cg_rel_tail(())),
        _ => "",
    }

let cg_emit_struct_rel (t: typecheck.ITy) (field_tys: Array[typecheck.ITy]): String =
    cg_rel_head(t).concat(cg_rel_children(field_tys, 0, 0, "", false)).concat(cg_rel_tail(()))

// Loads each owned child and releases it. `is_payload` picks the offset
// family — a struct's fields start right after the refcount, an enum's
// payload after the refcount and tag.
let cg_rel_children (tys: Array[typecheck.ITy]) (i: Int) (n: Int) (acc: String) (is_payload: Bool): String =
    if i >= tys.len() { acc }
    else if !cg_is_heap(cg_of_ity(tys[i])) { cg_rel_children(tys, i + 1, n, acc, is_payload) }
    else {
        let off = if is_payload { cg_payload_offset(i) } else { cg_field_offset(i) };
        let fp = "%rp".concat(n.to_string());
        let fv = "%rv".concat(n.to_string());
        let line = "  ".concat(fp).concat(" = getelementptr i8, ptr %p, i64 ").concat(off.to_string()).concat("\n")
            .concat("  ").concat(fv).concat(" = load ptr, ptr ").concat(fp).concat("\n")
            .concat("  call void ").concat(cg_rel_sym(tys[i])).concat("(ptr ").concat(fv).concat(")\n");
        cg_rel_children(tys, i + 1, n + 1, acc.concat(line), is_payload)
    }

let cg_emit_enum_rel (p: CgProgram) (t: typecheck.ITy) (vs: Array[CgVariant]) (args: Array[typecheck.ITy]): String = {
    let head = cg_rel_head(t)
        .concat("  %tp = getelementptr i8, ptr %p, i64 ").concat(cg_tag_offset(()).to_string()).concat("\n")
        .concat("  %tag = load i64, ptr %tp\n")
        .concat("  switch i64 %tag, label %done [\n").concat(cg_rel_cases(p, vs, args, 0, "")).concat("  ]\n");
    head.concat(cg_rel_blocks(p, vs, args, 0, 0, "")).concat("done:\n").concat(cg_rel_tail(()))
}

// Only variants with a heap-shaped payload need a block; the rest fall
// through to the default and just free the cell.
let cg_rel_cases (p: CgProgram) (vs: Array[CgVariant]) (args: Array[typecheck.ITy]) (i: Int) (acc: String): String =
    if i >= vs.len() { acc }
    else if !cg_variant_owns(p, vs[i], args) { cg_rel_cases(p, vs, args, i + 1, acc) }
    else { cg_rel_cases(p, vs, args, i + 1, acc.concat("    i64 ").concat(vs[i].tag.to_string()).concat(", label %R").concat(vs[i].tag.to_string()).concat("\n")) }

let cg_variant_owns (p: CgProgram) (v: CgVariant) (args: Array[typecheck.ITy]): Bool =
    Array.any(cg_variant_payload_tys(p, v, args), |t| cg_is_heap(cg_of_ity(t)))

let cg_variant_payload_tys (p: CgProgram) (v: CgVariant) (args: Array[typecheck.ITy]): Array[typecheck.ITy] =
    Array.map(typecheck.ctx_variant_payload(p.ctx, v.name), |t| typecheck.instantiate_template(typecheck.ctx_variant_generics(p.ctx, v.name), args, t))

let cg_rel_blocks (p: CgProgram) (vs: Array[CgVariant]) (args: Array[typecheck.ITy]) (i: Int) (n: Int) (acc: String): String =
    if i >= vs.len() { acc }
    else if !cg_variant_owns(p, vs[i], args) { cg_rel_blocks(p, vs, args, i + 1, n, acc) }
    else {
        let block = "R".concat(vs[i].tag.to_string()).concat(":\n")
            .concat(cg_rel_children(cg_variant_payload_tys(p, vs[i], args), 0, n, "", true))
            .concat("  br label %done\n");
        cg_rel_blocks(p, vs, args, i + 1, n + 100, acc.concat(block))
    }

let cg_emit_array_rel (t: typecheck.ITy) (elem: typecheck.ITy): String =
    if !cg_is_heap(cg_of_ity(elem)) { cg_rel_head(t).concat(cg_rel_tail(())) }
    else {
        cg_rel_head(t)
            .concat("  %lp = getelementptr i8, ptr %p, i64 8\n")
            .concat("  %len = load i64, ptr %lp\n")
            .concat("  %ip = alloca i64\n")
            .concat("  store i64 0, ptr %ip\n")
            .concat("  br label %loop\n")
            .concat("loop:\n")
            .concat("  %i = load i64, ptr %ip\n")
            .concat("  %more = icmp slt i64 %i, %len\n")
            .concat("  br i1 %more, label %body, label %done\n")
            .concat("body:\n")
            .concat("  %off = mul i64 %i, 8\n")
            .concat("  %ep0 = getelementptr i8, ptr %p, i64 %off\n")
            .concat("  %ep = getelementptr i8, ptr %ep0, i64 ").concat(cg_array_elem_offset(0).to_string()).concat("\n")
            .concat("  %ev = load ptr, ptr %ep\n")
            .concat("  call void ").concat(cg_rel_sym(elem)).concat("(ptr %ev)\n")
            .concat("  %i1 = add i64 %i, 1\n")
            .concat("  store i64 %i1, ptr %ip\n")
            .concat("  br label %loop\n")
            .concat("done:\n")
            .concat(cg_rel_tail(()))
    }

// --- Emitting the whole program ---
//
// Only what is REACHABLE from `main` is emitted, which falls out of
// monomorphization rather than being a separate dead-code pass: a
// generic function has no single symbol to emit until a call site says
// which instantiation it needs, so the worklist has to start from the
// entry point anyway. Monomorphic functions come along the same way.
// The PRELUDE is prepended to the user's items before anything is
// checked or compiled, exactly as the real compiler prepends its own.
// Prepending (rather than appending) is what makes a user definition of
// the same name WIN — `find_sig` scans in order, so a later declaration
// shadows the prelude's, which is the real compiler's behaviour too.
pub let cg_with_prelude (program: parser.ProgramNode): parser.ProgramNode =
    parser.ProgramNode { items: Array.concat(parser.parse_program(lexer.tokenize(cg_prelude_src(()))).items, program.items) }

pub let cg_emit_program (program0: parser.ProgramNode): String = {
    let program = cg_with_prelude(program0);
    let p = cg_build_program(program);
    if !cg_has_fn(p, "main") { cg_fail("no top-level 'main' function to compile") };
    // Globals are roots too: their bodies can call functions that
    // nothing else reaches.
    let insts = cg_reachable(p, cg_global_roots(p, 0, [CgInst { name: "main", targs: [] }]), [], 0);
    // Equality functions are discovered from the SAME reachable set —
    // an aggregate compared inside an unreachable function needs no
    // function emitted for it.
    let eqs = cg_eq_types_of(p, insts, 0, []);
    // Release functions are needed for every heap type that appears
    // ANYWHERE reachable, not just where `==` is used, so the closure
    // starts from every function's parameter and return types and from
    // every equality type already found.
    let rels = cg_rel_types_of(p, insts, 0, cg_rel_close_list(p, eqs, 0, []));
    let gl = cg_emit_globals(p, 0, 1000000, "", "");
    cg_runtime(())
        .concat(cg_emit_eq_fns(p, eqs, 0, ""))
        .concat(cg_emit_rel_fns(p, rels, 0, ""))
        .concat(gl.slots)
        .concat(cg_emit_insts(p, insts, 0, 0, ""))
        .concat(gl.init)
        .concat(cg_entry(()))
}

// Each top-level 0-parameter binding gets a module-level SLOT and one
// line in `@plum_init_globals`, which runs before `main`. Evaluating
// them once, in declaration order, is the whole point — a global
// referencing an earlier global sees an initialised slot.
//
// The register counter starts at 1,000,000 so a global's body cannot
// collide with a function's `@.str` constants. Crude, and honest about
// it: the alternative is threading the counter through two independent
// emission passes for no other benefit.
struct GlobalsEmit { slots: String, init: String }

let cg_global_dup (gs: Array[typecheck.TFn]) (name: String) (j: Int) (upto: Int): Bool =
    if j >= upto { false } else if gs[j].name == name { true } else { cg_global_dup(gs, name, j + 1, upto) }

let cg_emit_globals (p: CgProgram) (i: Int) (n: Int) (slots: String) (body: String): GlobalsEmit =
    if i >= p.globals.len() {
        GlobalsEmit { slots: slots, init: "define void @plum_init_globals() {\nentry:\n".concat(body).concat("  ret void\n}\n\n") }
    } else if cg_global_dup(p.globals, p.globals[i].name, 0, i) {
        // The flat module namespace lets two modules declare the same
        // global — `UPPERCASE_CHARS` exists in both `interp.plum` and
        // `infer.plum`. `find_global_def` resolves every reference to
        // the FIRST, so only the first gets a slot; emitting the second
        // would be a duplicate symbol for a slot nothing reads.
        cg_emit_globals(p, i + 1, n, slots, body)
    } else {
        let g = p.globals[i];
        let gp = CgProgram { fns: p.fns, globals: p.globals, ctx: p.ctx, enums: p.enums, subst: g.subst, generics: [], targs: [] };
        let ty = cg_of_ity(cg_concrete(gp, g.ret));
        let r = cg_expr(gp, [], n, g.body);
        let slot = "@g.".concat(cg_mangle(g.name)).concat(" = global ").concat(cg_llvm_ty(ty)).concat(" ").concat(cg_zero_of(ty)).concat("\n");
        let init = r.allocas.concat(r.code)
            .concat("  store ").concat(cg_llvm_ty(ty)).concat(" ").concat(r.val).concat(", ptr ").concat(cg_global_slot(g.name)).concat("\n")
            .concat(r.releases);
        cg_emit_globals(p, i + 1, r.n, slots.concat(r.globals).concat(slot), body.concat(init))
    }

// Worklist closure: pop an instantiation, record it, and push every
// instantiation its body calls. The `fuel` counter is not decoration —
// POLYMORPHIC RECURSION (`f[T]` calling `f[Array[T]]`) generates
// infinitely many specializations, and monomorphization is undecidable
// in general for it. Plum's own generics can't express it today, so
// this should never fire; if it ever does, it stops with an
// explanation rather than looping until memory runs out.
let cg_reachable (p: CgProgram) (pending: Array[CgInst]) (done: Array[CgInst]) (fuel: Int): Array[CgInst] =
    if Array.is_empty(pending) { done }
    else if fuel > 10000 { { cg_fail("monomorphization did not terminate after 10000 instantiations — polymorphic recursion?"); done } }
    else {
        let head = pending[0];
        let rest = Array.slice(pending, 1, pending.len());
        // A runtime-implemented name is already a symbol: it has no
        // Plum body to walk, and emitting one would COLLIDE with the
        // runtime's own definition. `read_file_raw` has a stub body in
        // the prelude purely so the checker has a signature for it —
        // this is what stops that stub from being compiled.
        if Option.is_some(cg_runtime_fn(head.name)) || head.name == "Array.concat" { cg_reachable(p, rest, done, fuel + 1) }
        else if cg_inst_seen(done, head, 0) { cg_reachable(p, rest, done, fuel + 1) }
        else {
            match cg_find_tfn(p, head.name, 0) {
                // A runtime-implemented prelude function has no Plum
                // body to walk or specialize — it is already a symbol.
                None => if Option.is_some(cg_runtime_fn(head.name)) { cg_reachable(p, rest, done, fuel + 1) } else {
                    cg_fail("prelude function ".concat(head.name).concat(" has no implementation in this backend's runtime yet"));
                    done
                },
                Some(def) => {
                    let inner = CgProgram { fns: p.fns, globals: p.globals, ctx: p.ctx, enums: p.enums, subst: def.subst, generics: def.generics, targs: head.targs };
                    cg_reachable(p, Array.concat(rest, cg_calls_in(inner, def.body, [])), done.push(head), fuel + 1)
                },
            }
        }
    }

// Every aggregate type compared with `==`/`!=` anywhere in the
// reachable program, closed over its own components.
// Every heap type a reachable function can hold: its parameters, its
// return type, and the type of every `let` in its body. `cg_rel_close`
// pulls in the component types from there.
let cg_rel_types_of (p: CgProgram) (insts: Array[CgInst]) (i: Int) (acc: Array[typecheck.ITy]): Array[typecheck.ITy] =
    if i >= insts.len() { acc }
    else {
        match cg_find_tfn(p, insts[i].name, 0) {
            None => cg_rel_types_of(p, insts, i + 1, acc),
            Some(def) => {
                let inner = CgProgram { fns: p.fns, globals: p.globals, ctx: p.ctx, enums: p.enums, subst: def.subst, generics: def.generics, targs: insts[i].targs };
                let withparams = cg_rel_close_list(inner, Array.map(def.params, |q| cg_concrete(inner, q.ty)), 0, acc);
                let withret = cg_rel_close(inner, cg_concrete(inner, def.ret), withparams);
                cg_rel_types_of(p, insts, i + 1, cg_rel_in(inner, def.body, withret))
            },
        }
    }

// Every type appearing on a node in a body — that is what a slot may
// hold, and so what may need releasing.
let cg_rel_in (p: CgProgram) (e: typecheck.TExpr) (acc: Array[typecheck.ITy]): Array[typecheck.ITy] = {
    let here = cg_rel_close(p, cg_concrete(p, typecheck.texpr_ty(p.subst, e)), acc);
    match e.node {
        TFnCall(_, args, _) => cg_rel_in_list(p, args, 0, here),
        TClosureCall(callee, args) => cg_rel_in_list(p, args, 0, cg_rel_in(p, callee, here)),
        TMethodCall(_, base, args) => cg_rel_in_list(p, args, 0, cg_rel_in(p, base, here)),
        TArrayNs(_, args) => cg_rel_in_list(p, args, 0, here),
        TVariantNew(_, args) => cg_rel_in_list(p, args, 0, here),
        TPrintln(a) => cg_rel_in(p, a, here),
        TUnary(_, a) => cg_rel_in(p, a, here),
        TBinary(_, a, b) => cg_rel_in(p, b, cg_rel_in(p, a, here)),
        TFieldGet(a, _) => cg_rel_in(p, a, here),
        TIndex(a, b) => cg_rel_in(p, b, cg_rel_in(p, a, here)),
        TArrayLit(elems) => cg_rel_in_list(p, elems, 0, here),
        TTupleLit(elems) => cg_rel_in_list(p, elems, 0, here),
        TBlockE(block) => cg_rel_in_block(p, block, here),
        TIf(c, t, e2) => match e2 {
            Some(x) => cg_rel_in(p, x, cg_rel_in(p, t, cg_rel_in(p, c, here))),
            None => cg_rel_in(p, t, cg_rel_in(p, c, here)),
        },
        TMatch(sc, arms) => cg_rel_in_arms(p, arms, 0, cg_rel_in(p, sc, here)),
        TFor(_, lo, hi, body) => cg_rel_in(p, body, cg_rel_in(p, hi, cg_rel_in(p, lo, here))),
        TClosure(_, body) => cg_rel_in(p, body, here),
        TStructLit(_, fields) => cg_rel_in_fields(p, fields, 0, here),
        TInt(_) => here, TFloat(_) => here, TStr(_) => here, TBool(_) => here,
        TUnitLit => here, TIdent(_) => here, TGlobalRef(_) => here, TUnsupported(_) => here,
    }
}

let cg_rel_in_list (p: CgProgram) (es: Array[typecheck.TExpr]) (i: Int) (acc: Array[typecheck.ITy]): Array[typecheck.ITy] =
    if i >= es.len() { acc } else { cg_rel_in_list(p, es, i + 1, cg_rel_in(p, es[i], acc)) }

let cg_rel_in_block (p: CgProgram) (block: typecheck.TBlock) (acc: Array[typecheck.ITy]): Array[typecheck.ITy] = {
    let after = cg_rel_in_stmts(p, block.stmts, 0, acc);
    match block.tail { Some(t) => cg_rel_in(p, t, after), None => after }
}

let cg_rel_in_stmts (p: CgProgram) (stmts: Array[typecheck.TStmt]) (i: Int) (acc: Array[typecheck.ITy]): Array[typecheck.ITy] =
    if i >= stmts.len() { acc }
    else {
        let next = match stmts[i] {
            TSLet(_, v) => cg_rel_in(p, v, acc),
            TSAssign(_, v) => cg_rel_in(p, v, acc),
            TSExpr(v) => cg_rel_in(p, v, acc),
        };
        cg_rel_in_stmts(p, stmts, i + 1, next)
    }

let cg_rel_in_arms (p: CgProgram) (arms: Array[typecheck.TArm]) (i: Int) (acc: Array[typecheck.ITy]): Array[typecheck.ITy] =
    if i >= arms.len() { acc }
    else {
        let g = match arms[i].guard { Some(x) => cg_rel_in(p, x, acc), None => acc };
        cg_rel_in_arms(p, arms, i + 1, cg_rel_in(p, arms[i].body, g))
    }

let cg_rel_in_fields (p: CgProgram) (fields: Array[typecheck.TFieldInit]) (i: Int) (acc: Array[typecheck.ITy]): Array[typecheck.ITy] =
    if i >= fields.len() { acc } else { cg_rel_in_fields(p, fields, i + 1, cg_rel_in(p, fields[i].value, acc)) }

let cg_eq_types_of (p: CgProgram) (insts: Array[CgInst]) (i: Int) (acc: Array[typecheck.ITy]): Array[typecheck.ITy] =
    if i >= insts.len() { acc }
    else {
        match cg_find_tfn(p, insts[i].name, 0) {
            None => cg_eq_types_of(p, insts, i + 1, acc),
            Some(def) => {
                let inner = CgProgram { fns: p.fns, globals: p.globals, ctx: p.ctx, enums: p.enums, subst: def.subst, generics: def.generics, targs: insts[i].targs };
                cg_eq_types_of(p, insts, i + 1, cg_eq_in(inner, def.body, acc))
            },
        }
    }

let cg_eq_in (p: CgProgram) (e: typecheck.TExpr) (acc: Array[typecheck.ITy]): Array[typecheck.ITy] =
    match e.node {
        TBinary(op, l, r) => {
            let inner = cg_eq_in(p, r, cg_eq_in(p, l, acc));
            if cg_is_equality(op) { cg_eq_close(p, cg_concrete(p, typecheck.texpr_ty(p.subst, l)), inner) } else { inner }
        },
        TFnCall(_, args, _) => cg_eq_in_list(p, args, 0, acc),
        TClosureCall(callee, args) => cg_eq_in_list(p, args, 0, cg_eq_in(p, callee, acc)),
        TMethodCall(_, base, args) => cg_eq_in_list(p, args, 0, cg_eq_in(p, base, acc)),
        TArrayNs(_, args) => cg_eq_in_list(p, args, 0, acc),
        TVariantNew(_, args) => cg_eq_in_list(p, args, 0, acc),
        TPrintln(a) => cg_eq_in(p, a, acc),
        TUnary(_, a) => cg_eq_in(p, a, acc),
        TFieldGet(a, _) => cg_eq_in(p, a, acc),
        TIndex(a, b) => cg_eq_in(p, b, cg_eq_in(p, a, acc)),
        TArrayLit(elems) => cg_eq_in_list(p, elems, 0, acc),
        TTupleLit(elems) => cg_eq_in_list(p, elems, 0, acc),
        TBlockE(block) => cg_eq_in_block(p, block, acc),
        TIf(c, t, e2) => match e2 {
            Some(x) => cg_eq_in(p, x, cg_eq_in(p, t, cg_eq_in(p, c, acc))),
            None => cg_eq_in(p, t, cg_eq_in(p, c, acc)),
        },
        // A literal PATTERN compares too (`match c { "0" => .. }`), and
        // it compares against the SCRUTINEE's type, so the scrutinee is
        // closed over here rather than only at explicit `==` sites.
        TMatch(sc, arms) => cg_eq_in_arms(p, arms, 0, cg_eq_close(p, cg_concrete(p, typecheck.texpr_ty(p.subst, sc)), cg_eq_in(p, sc, acc))),
        TFor(_, lo, hi, body) => cg_eq_in(p, body, cg_eq_in(p, hi, cg_eq_in(p, lo, acc))),
        TClosure(_, body) => cg_eq_in(p, body, acc),
        TStructLit(_, fields) => cg_eq_in_fields(p, fields, 0, acc),
        TInt(_) => acc, TFloat(_) => acc, TStr(_) => acc, TBool(_) => acc,
        TUnitLit => acc, TIdent(_) => acc, TGlobalRef(_) => acc, TUnsupported(_) => acc,
    }

let cg_eq_in_list (p: CgProgram) (es: Array[typecheck.TExpr]) (i: Int) (acc: Array[typecheck.ITy]): Array[typecheck.ITy] =
    if i >= es.len() { acc } else { cg_eq_in_list(p, es, i + 1, cg_eq_in(p, es[i], acc)) }

let cg_eq_in_block (p: CgProgram) (block: typecheck.TBlock) (acc: Array[typecheck.ITy]): Array[typecheck.ITy] = {
    let after = cg_eq_in_stmts(p, block.stmts, 0, acc);
    match block.tail { Some(t) => cg_eq_in(p, t, after), None => after }
}

let cg_eq_in_stmts (p: CgProgram) (stmts: Array[typecheck.TStmt]) (i: Int) (acc: Array[typecheck.ITy]): Array[typecheck.ITy] =
    if i >= stmts.len() { acc }
    else {
        let next = match stmts[i] {
            TSLet(_, v) => cg_eq_in(p, v, acc),
            TSAssign(_, v) => cg_eq_in(p, v, acc),
            TSExpr(v) => cg_eq_in(p, v, acc),
        };
        cg_eq_in_stmts(p, stmts, i + 1, next)
    }

let cg_eq_in_arms (p: CgProgram) (arms: Array[typecheck.TArm]) (i: Int) (acc: Array[typecheck.ITy]): Array[typecheck.ITy] =
    if i >= arms.len() { acc }
    else {
        let g = match arms[i].guard { Some(x) => cg_eq_in(p, x, acc), None => acc };
        cg_eq_in_arms(p, arms, i + 1, cg_eq_in(p, arms[i].body, g))
    }

let cg_eq_in_fields (p: CgProgram) (fields: Array[typecheck.TFieldInit]) (i: Int) (acc: Array[typecheck.ITy]): Array[typecheck.ITy] =
    if i >= fields.len() { acc } else { cg_eq_in_fields(p, fields, i + 1, cg_eq_in(p, fields[i].value, acc)) }

let cg_global_roots (p: CgProgram) (i: Int) (acc: Array[CgInst]): Array[CgInst] =
    if i >= p.globals.len() { acc }
    else {
        let g = p.globals[i];
        let gp = CgProgram { fns: p.fns, globals: p.globals, ctx: p.ctx, enums: p.enums, subst: g.subst, generics: [], targs: [] };
        cg_global_roots(p, i + 1, Array.concat(acc, cg_calls_in(gp, g.body, [])))
    }

let cg_find_tfn (p: CgProgram) (name: String) (i: Int): Option[typecheck.TFn] =
    if i >= p.fns.len() { None } else if p.fns[i].name == name { Some(p.fns[i]) } else { cg_find_tfn(p, name, i + 1) }

// Every `TFnCall` in a body, with its type arguments resolved through
// the enclosing specialization. A separate traversal from emission on
// purpose: discovery must complete for the WHOLE program before any
// function is emitted, since a call may be the first mention of an
// instantiation that appears earlier in the output.
let cg_calls_in (p: CgProgram) (e: typecheck.TExpr) (acc: Array[CgInst]): Array[CgInst] =
    match e.node {
        TFnCall(name, args, targs) => cg_calls_in_list(p, args, acc.push(CgInst { name: name, targs: cg_concrete_list(p, targs, 0, []) })),
        TClosureCall(callee, args) => cg_calls_in_list(p, args, cg_calls_in(p, callee, acc)),
        TMethodCall(_, base, args) => cg_calls_in_list(p, args, cg_calls_in(p, base, acc)),
        TArrayNs(_, args) => cg_calls_in_list(p, args, acc),
        TVariantNew(_, args) => cg_calls_in_list(p, args, acc),
        TPrintln(a) => cg_calls_in(p, a, acc),
        TUnary(_, a) => cg_calls_in(p, a, acc),
        TBinary(_, a, b) => cg_calls_in(p, b, cg_calls_in(p, a, acc)),
        TFieldGet(a, _) => cg_calls_in(p, a, acc),
        TIndex(a, b) => cg_calls_in(p, b, cg_calls_in(p, a, acc)),
        TArrayLit(elems) => cg_calls_in_list(p, elems, acc),
        TTupleLit(elems) => cg_calls_in_list(p, elems, acc),
        TBlockE(block) => cg_calls_in_block(p, block, acc),
        TIf(c, t, e2) => match e2 {
            Some(x) => cg_calls_in(p, x, cg_calls_in(p, t, cg_calls_in(p, c, acc))),
            None => cg_calls_in(p, t, cg_calls_in(p, c, acc)),
        },
        TMatch(sc, arms) => cg_calls_in_arms(p, arms, 0, cg_calls_in(p, sc, acc)),
        TFor(_, lo, hi, body) => cg_calls_in(p, body, cg_calls_in(p, hi, cg_calls_in(p, lo, acc))),
        TClosure(_, body) => cg_calls_in(p, body, acc),
        TStructLit(_, fields) => cg_calls_in_fields(p, fields, 0, acc),
        TInt(_) => acc, TFloat(_) => acc, TStr(_) => acc, TBool(_) => acc,
        TUnitLit => acc, TIdent(_) => acc, TGlobalRef(_) => acc, TUnsupported(_) => acc,
    }

let cg_calls_in_list (p: CgProgram) (es: Array[typecheck.TExpr]) (acc: Array[CgInst]): Array[CgInst] = cg_calls_in_list_acc(p, es, 0, acc)
let cg_calls_in_list_acc (p: CgProgram) (es: Array[typecheck.TExpr]) (i: Int) (acc: Array[CgInst]): Array[CgInst] =
    if i >= es.len() { acc } else { cg_calls_in_list_acc(p, es, i + 1, cg_calls_in(p, es[i], acc)) }

let cg_calls_in_block (p: CgProgram) (block: typecheck.TBlock) (acc: Array[CgInst]): Array[CgInst] = {
    let after = cg_calls_in_stmts(p, block.stmts, 0, acc);
    match block.tail { Some(t) => cg_calls_in(p, t, after), None => after }
}

let cg_calls_in_stmts (p: CgProgram) (stmts: Array[typecheck.TStmt]) (i: Int) (acc: Array[CgInst]): Array[CgInst] =
    if i >= stmts.len() { acc }
    else {
        let next = match stmts[i] {
            TSLet(_, v) => cg_calls_in(p, v, acc),
            TSAssign(_, v) => cg_calls_in(p, v, acc),
            TSExpr(v) => cg_calls_in(p, v, acc),
        };
        cg_calls_in_stmts(p, stmts, i + 1, next)
    }

let cg_calls_in_arms (p: CgProgram) (arms: Array[typecheck.TArm]) (i: Int) (acc: Array[CgInst]): Array[CgInst] =
    if i >= arms.len() { acc }
    else {
        let g = match arms[i].guard { Some(x) => cg_calls_in(p, x, acc), None => acc };
        cg_calls_in_arms(p, arms, i + 1, cg_calls_in(p, arms[i].body, g))
    }

let cg_calls_in_fields (p: CgProgram) (fields: Array[typecheck.TFieldInit]) (i: Int) (acc: Array[CgInst]): Array[CgInst] =
    if i >= fields.len() { acc } else { cg_calls_in_fields(p, fields, i + 1, cg_calls_in(p, fields[i].value, acc)) }

let cg_emit_insts (p: CgProgram) (insts: Array[CgInst]) (i: Int) (n: Int) (acc: String): String =
    if i >= insts.len() { acc }
    else {
        match cg_find_tfn(p, insts[i].name, 0) {
            None => cg_emit_insts(p, insts, i + 1, n, acc),
            Some(def) => {
                let f = cg_fn(p, def, insts[i].targs, n);
                cg_emit_insts(p, insts, i + 1, f.next, acc.concat(f.text))
            },
        }
    }
