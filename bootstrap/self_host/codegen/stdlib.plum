// Standard-library MODULES -- source that is compiled into a program
// only when that program says `use <Name>;`.
//
// The prelude and a stdlib module answer two different questions.
// `Array.map` and `String.pad_left` have to be in the prelude, because
// `T.f(x)` IS the method-call mechanism: `xs.map(f)` is `Array.map(xs,
// f)`, so a type's namespace cannot be optional. `Time` has no
// receiver -- it names no type, and nothing dispatches to it -- so it
// is a module wearing a namespace's clothes, and it is spelled like
// one.
//
// (`Os` is in exactly the same position and has not moved. It is
// reachable from every program written so far, including this
// compiler, so that is a deliberate break to schedule rather than a
// tidy-up to slip in.)
//
// Gating on `use` is what makes the declaration LOAD-BEARING. Until
// now `use` was parsed and then ignored by every later stage -- module
// membership came entirely from the directory an item was found in, so
// `use shapes;` documented an intent the compiler never checked. A
// stdlib module has no directory to be found in, so `use Time;` is the
// only thing that can bring it in.

use lexer;
use parser;

// `needs` is the modules this one is written against. `Http` is
// ordinary Plum over `Net`'s sockets, so a program that says
// `use Http;` must get `Net` too whether it asked for it or not --
// otherwise the module's own body would reference something that was
// never injected, which is a compiler bug reported as a user error.
pub struct StdModule { pub name: String, pub source: String, pub needs: Array[String] }

// Every stdlib module, built from `parser.std_module_names` so the
// name list has exactly one home. A name with no source here is a
// compiler bug, not a user error, and says so.
pub let cg_std_modules (): Array[StdModule] =
    Array.map(parser.std_module_names(()), |n| StdModule { name: n, source: cg_std_source(n), needs: cg_std_needs(n) })

let cg_std_needs (name: String): Array[String] =
    // `Http` parses its URLs with `Url` rather than by hand, and `Url`
    // in turn needs `Encoding` -- which `cg_close_needs` closes over,
    // so this does not have to name it.
    if name == "Http" { ["Net", "Url"] }
    // `Url` percent-encodes and percent-decodes query values, and does
    // it by CALLING `Encoding` rather than carrying a second encoder --
    // the thing #26 was split out to avoid.
    else if name == "Url" { ["Encoding"] }
    // `Path` asks `Os.platform()` which separator to use.
    // `Os.read_stdin_line_timeout` takes a `Duration`.
    else if name == "Os" { ["Time"] }
    else if name == "Path" { ["Os"] }
    // `Process.start` waits with a `Duration`, which is `Time`'s.
    else if name == "Process" { ["Time"] }
    else { [] }

let cg_std_source (name: String): String =
    if name == "Time" { cg_time_src(()) }
    else if name == "Os" { cg_os_src(()) }
    else if name == "Net" { cg_net_src(()) }
    else if name == "Http" { cg_http_src(()) }
    else if name == "Process" { cg_process_src(()) }
    else if name == "Encoding" { cg_encoding_src(()) }
    else if name == "Crypto" { cg_crypto_src(()) }
    else if name == "Url" { cg_url_src(()) }
    else if name == "Path" { cg_path_src(()) }
    else if name == "Json" { cg_json_src(()) }
    else if name == "Terminal" { cg_terminal_src(()) }
    else { { cg_fail("no source for stdlib module ".concat(name)); "" } }

// The items a program's `use` declarations actually ask for, stamped
// with their module name the same way a directory would have stamped
// them.
pub let cg_std_items (user: Array[parser.ItemNode]): Array[parser.ItemNode] = {
    let mods = cg_std_modules(());
    let wanted = cg_close_needs(mods, cg_direct_uses(mods, user, 0, []), 0);
    cg_std_items_acc(mods, wanted, 0, [])
}

let cg_direct_uses (mods: Array[StdModule]) (user: Array[parser.ItemNode]) (i: Int) (acc: Array[String]): Array[String] =
    if i >= mods.len() { acc }
    else if cg_uses_module(user, mods[i].name, 0) { cg_direct_uses(mods, user, i + 1, acc.push(mods[i].name)) }
    else { cg_direct_uses(mods, user, i + 1, acc) }

// One pass per module is enough to close over `needs`: the graph is
// tiny and acyclic by construction, and a fixed number of passes over
// the whole list cannot miss a chain shorter than that list.
let cg_close_needs (mods: Array[StdModule]) (want: Array[String]) (round: Int): Array[String] =
    if round >= mods.len() { want }
    else { cg_close_needs(mods, cg_add_needs(mods, want, 0), round + 1) }

let cg_add_needs (mods: Array[StdModule]) (want: Array[String]) (i: Int): Array[String] =
    if i >= mods.len() { want }
    else if Array.contains(want, mods[i].name) { cg_add_needs(mods, cg_union(want, mods[i].needs, 0), i + 1) }
    else { cg_add_needs(mods, want, i + 1) }

let cg_union (into: Array[String]) (add: Array[String]) (i: Int): Array[String] =
    if i >= add.len() { into }
    else if Array.contains(into, add[i]) { cg_union(into, add, i + 1) }
    else { cg_union(into.push(add[i]), add, i + 1) }

// Emitted in `std_module_names` order, not in the order the program
// happened to `use` them, so the same program always produces the same
// IR regardless of how its imports were written.
let cg_std_items_acc (mods: Array[StdModule]) (want: Array[String]) (i: Int) (acc: Array[parser.ItemNode]): Array[parser.ItemNode] =
    if i >= mods.len() { acc }
    else if Array.contains(want, mods[i].name) {
        cg_std_items_acc(mods, want, i + 1, Array.concat(acc, cg_parse_std(mods[i].name, mods[i].source)))
    } else { cg_std_items_acc(mods, want, i + 1, acc) }

// `use Time;` and `use Time.rfc7231;` both count -- the second is the
// import-one-name form, and it names the same module.
let cg_uses_module (items: Array[parser.ItemNode]) (name: String) (i: Int): Bool =
    if i >= items.len() { false }
    else {
        match items[i].kind {
            IKUse(u) => if !Array.is_empty(u.path) && u.path[0] == name { true }
                        else { cg_uses_module(items, name, i + 1) },
            _ => cg_uses_module(items, name, i + 1),
        }
    }

// Parsed with its own source context, so an error inside a stdlib
// module quotes the module rather than whatever file was being read
// when it was pulled in.
let cg_parse_std (name: String) (src: String): Array[parser.ItemNode] = {
    let saved = parser.current_path(());
    let lexed = lexer.tokenize_spanned(src);
    parser.set_source_context("<".concat(name).concat(">"), src, lexed.starts, lexed.ends);
    let items = parser.with_module(parser.parse_program(lexed.tokens).items, name);
    parser.set_source_context(saved, "", [], []);
    items
}

// --- The `Net` module ---
//
// The six TCP calls, unprefixed: `tcp_connect_to` was named that way
// because it lived in a flat prelude and had nothing else to
// distinguish it. The module supplies the prefix now, so
// `Net.connect_to` says the same thing without saying "tcp" twice.
let cg_net_src (): String = Array.join([
    "/// TCP sockets, over `native_stdlib/net_shim.c`. Plain `Result`",
    "/// wrapping around a sentinel `-1`: a raw BSD sockets call crossing",
    "/// the shim does not preserve an `errno`, so each failure carries a",
    "/// fixed message saying WHAT failed rather than why.",
    "extern \"C\" {",
    "    fn tcp_connect(host: CStr, port: Int) -> Int;",
    "    fn tcp_listen(port: Int) -> Int;",
    "    fn tcp_accept(fd: Int) -> Int;",
    "    fn tcp_send(fd: Int, buf: CStr, len: Int) -> Int;",
    "    fn tcp_recv(fd: Int, max_len: Int) -> CStr;",
    "    fn tcp_recv_n(fd: Int, max_len: Int) -> Int;",
    "    fn tcp_recv_data() -> CStr;",
    "    fn tcp_close(fd: Int) -> Unit;",
    "}",
    "",
    "/// Opens a TCP connection. The `Int` is a socket, for `Net.read`,",
    "/// `Net.write` and `Net.close`.",
    "///",
    "/// `host` may be a name or an address; resolution happens here, so a",
    "/// DNS failure and a refused connection are both `Err` with a message",
    "/// saying which.",
    "///",
    "/// **Blocking, and never closed for you.** There is no timeout, and no",
    "/// handle type — a socket outlives every scope until `Net.close` is",
    "/// called, so a connection opened in a loop and dropped is a leak the",
    "/// language will not catch.",
    "pub let connect_to (host: String) (port: Int): Result[Int, String] = unsafe {",
    "    let fd = tcp_connect(host.as_cstr(), port);",
    "    if fd < 0 { Err(\"Net.connect_to: could not connect to \".concat(host).concat(\":\").concat(port.to_string())) } else { Ok(fd) }",
    "}",
    "",
    "/// Binds and listens on a port, returning a socket to `accept` on.",
    "///",
    "/// Binds all interfaces. `Err` when the port is already in use or is",
    "/// one this process may not have — under 1024 usually needs privilege.",
    "pub let listen_on (port: Int): Result[Int, String] = unsafe {",
    "    let fd = tcp_listen(port);",
    "    if fd < 0 { Err(\"Net.listen_on: could not listen on port \".concat(port.to_string())) } else { Ok(fd) }",
    "}",
    "",
    "/// Waits for a connection and returns a socket for it.",
    "///",
    "/// Blocks until a client arrives. The listening socket stays open for",
    "/// the next `accept`; the returned one is a separate connection and",
    "/// needs its own `Net.close`.",
    "pub let accept (fd: Int): Result[Int, String] = unsafe {",
    "    let client = tcp_accept(fd);",
    "    if client < 0 { Err(\"Net.accept: accept failed\") } else { Ok(client) }",
    "}",
    "",
    "/// `len` MUST be bound BEFORE `.as_cstr()` runs. `.as_cstr()`",
    "/// decrements the string's refcount to produce its copy and FREES",
    "/// the original outright if that was the last reference, exactly",
    "/// what a direct `tcp_write(fd, \"hello\")` passes. Reading",
    "/// `data.len()` afterwards in the same argument list is a real",
    "/// use-after-free, and the real compiler found it the hard way:",
    "/// garbage bytes trailing the content on an actual socket, observed",
    "/// on the wire rather than theorized.",
    "pub let write (fd: Int) (data: String): Result[Int, String] = unsafe {",
    "    let len = data.len();",
    "    let n = tcp_send(fd, data.as_cstr(), len);",
    "    if n < 0 { Err(\"Net.write: send failed\") } else { Ok(n) }",
    "}",
    "",
    "/// \"\" on BOTH a clean peer close and a hard socket error. The",
    "/// distinction is not preserved in v1, and either way \"stop",
    "/// reading\" is the right response, and an empty String already",
    "/// signals to a caller looping until end of stream.",
    "pub let read (fd: Int) (max_len: Int): String = unsafe { tcp_recv(fd, max_len).as_string() }",
    "",
    "// --- Binary-safe TCP ---",
    "//",
    "// `read`/`write` above keep their exact contracts and stay the",
    "// convenience for line-oriented protocols. These are the pair to",
    "// reach for when the payload is not text.",
    "//",
    "// `Net.read` cannot be made binary-safe without changing what it",
    "// means: it returns a `String`, which is a promise the bytes decode",
    "// as UTF-8, and arbitrary socket traffic does not keep it. The fix",
    "// is a function with a different RETURN TYPE, not a quieter version",
    "// of this one.",
    "",
    "/// Three outcomes, and the middle one is why this exists as a",
    "/// `Result[Bytes, _]` rather than just `Bytes`:",
    "///",
    "///   Ok(bytes)  with a non-empty buffer: data",
    "///   Ok(empty)  the peer closed cleanly: end of stream",
    "///   Err(..)    a real socket error",
    "///",
    "/// `Net.read` collapses the last two into `\"\"`, a documented v1",
    "/// trade that a text protocol can live with because either answer",
    "/// means \"stop reading\". A length-framed binary protocol cannot: an",
    "/// empty read mid-stream is an ordinary event, and telling it from a",
    "/// dropped connection is the difference between waiting and failing.",
    "/// `tcp_recv_n` returns a count and keeps the two apart.",
    "pub let read_bytes (fd: Int) (max_len: Int): Result[Bytes, String] = unsafe {",
    "    let n = tcp_recv_n(fd, max_len);",
    "    if n < 0 { Err(\"Net.read_bytes: recv failed\") }",
    "    else { Ok(Bytes.from_cstr(tcp_recv_data(), n)) }",
    "}",
    "",
    "/// `len` MUST be bound BEFORE `.as_cstr()` runs, for the same reason",
    "/// `write` above spells that out: the pointer is an interior one into",
    "/// the cell, and reading `.len()` afterwards in the same argument",
    "/// list is how that bug was found on the wire the first time.",
    "///",
    "/// Binary-safe because `tcp_send` takes an explicit length and never",
    "/// calls `strlen`, so a NUL in the buffer is just another byte.",
    "pub let write_bytes (fd: Int) (data: Bytes): Result[Int, String] = unsafe {",
    "    let len = data.len();",
    "    let n = tcp_send(fd, data.as_cstr(), len);",
    "    if n < 0 { Err(\"Net.write_bytes: send failed\") } else { Ok(n) }",
    "}",
    "",
    "/// Closes a socket. Closing one twice, or closing a number that was",
    "/// never a socket, does nothing rather than failing.",
    "pub let close (fd: Int): Unit = unsafe { tcp_close(fd); () }",
    "",
], "\n")

// Embed the authoritative Plum sources at compiler-build time. An installed
// compiler needs no source files beside it, and fixes cannot drift from a
// second quoted copy of these modules. Dependencies are in cg_std_needs.
let cg_http_src (): String = @embed_file("../../std/Http.plum")

// --- The `Os` module ---
//
// Moved out of the prelude on 2026-08-27, one release after `Time`
// established the rule. `Os` names no type and nothing dispatches to
// it, so it was a module wearing a namespace's clothes -- but unlike
// `Time` it was reachable from every program already written, so the
// break was scheduled for its own release rather than slipped in
// beside the feature that revealed it.
let cg_os_src (): String = @embed_file("../../std/Os.plum")

// --- The `Process` module ---
//
// Structured process execution: an executable plus an argument array,
// not a shell command string. `Os.run_process` stays as the two-argument
// convenience used by the compiler itself; this is the options-struct
// form with env overlay and stdin, which that one does not have.
//
// `process_run` is left alone on purpose. The compiler binary calling
// `Os.run_process` was compiled against the three-argument C ABI, and
// changing that signature would crash the next generation. `process_run_ex`
// is a new entry point.
let cg_process_src (): String = @embed_file("../../std/Process.plum")

// --- The `Time` module ---
//
// Written unqualified: inside the module these are `now`, `utc`,
// `rfc7231`, and the module stamp makes them `Time.now` and the rest
// at every call site.
// --- The `Url` module ---
//
// Split out of the HTTPS issue: parsing a URL and connecting to one are
// different problems, and the small one should not wait on TLS.
//
// **`path` stays percent-ENCODED and `raw_query` is stored verbatim.**
// That is not laziness, it is what a URL is for. The path goes straight
// into an HTTP request line, so decoding it would mean re-encoding it,
// and a general re-encode turns `/` into `%2F` and breaks the target.
// Query VALUES are decoded on lookup, because a lookup's whole purpose
// is to hand back something usable.
//
// The single source of truth for the query is `raw_query`. Storing
// parsed pairs alongside it would let the two disagree the moment
// anyone built a `Url` by hand. `parse` VALIDATES the query instead --
// every escape must decode and every value must be UTF-8 -- so
// `query_get` can be total afterwards, looking up something already
// known to be well-formed.
let cg_url_src (): String = @embed_file("../../std/Url.plum")

// --- The `Path` module ---
//
// Lexical path handling. It never touches the filesystem: `clean` does
// not resolve symlinks, and nothing here stats anything. That is a
// deliberate boundary -- `Os` owns questions about what is really
// there, and this owns questions about what a path SAYS.
//
// Ordinary Plum over `Os.platform()`, the same way `Time.utc` is
// ordinary Plum over `Time.now`.
//
// **Windows accepts both separators, and emits one.** Every Win32 path
// API takes `/` as well as `\`, and real paths arrive with a mix
// (a config file written on Linux, a drive letter typed by hand). So
// input is normalized to `/` and the platform separator is put back
// only when a path is rebuilt -- which means one set of rules rather
// than two, and `Path.dirname("C:/a/b")` works on a Windows machine
// whether or not the caller used backslashes.
let cg_path_src (): String = @embed_file("../../std/Path.plum")

// --- The `Encoding` module ---
//
// Hex, base64 and percent-encoding. Not a crypto suite: no hashing, no
// ciphers, no HMAC. Those are a different kind of thing to get right
// and a different kind of thing to be wrong about.
//
// **Everything here works on `Bytes`, not `String`.** That is the whole
// reason this waited for #16. Encoding is a byte operation -- base64 of
// "a string" means base64 of its bytes, and hex-decoding arbitrary
// input cannot produce a `String` at all, because the result is
// whatever bytes were written down. A `String`-shaped API has to either
// lie about that or return a `Result` on the ENCODE side too, which is
// backwards. `String.as_bytes(s)` is total and one call, so the text
// case reads `Encoding.base64_encode(s.as_bytes())` and stays honest.
//
// Decoders return `Result[Bytes, String]`. Every one of them is parsing
// attacker-shaped input -- a query string, a header, a token -- so
// invalid input is an ordinary outcome and never a panic.
//
// `hex_encode` DELEGATES to the prelude's `Bytes.to_hex` rather than
// reimplementing it. Hex has to exist in the prelude regardless: it is
// what the checker's `.to_string()` rejection tells people to reach
// for, so it cannot require an import. Wrappers like these cost nothing
// when unused -- dead-function elimination drops them -- and one
// encoder with two spellings is the thing this module is supposed to
// prevent two of.
let cg_crypto_src (): String = Array.join([
    "/// SHA-256, the digest a package manifest pins.",
    "///",
    "/// CRYPTOGRAPHIC, unlike `String.hash`, which is FNV-1a for bucketing",
    "/// and says so. Use this one when the answer has to mean something to",
    "/// somebody else.",
    "///",
    "/// Pure Plum: no shim, no C, no platform branch. It is writable at all",
    "/// because `Int.wrapping_add` and the bitwise operators exist, and",
    "/// `wrapping_add` was added in 0.0.29 precisely because hashing needs",
    "/// it. `Int` is 64 bits, so the 32-bit lanes are masked explicitly.",
    "///",
    "/// Checked against all four of NIST's published vectors, which is",
    "/// firmer ground than most things here get: the expected answer is what",
    "/// the standard says rather than what this compiler produced last time.",
    "let MASK: Int = 4294967295",
    "",
    "// Generated from the spec, not transcribed: the first 32 bits of the",
    "// fractional parts of the cube roots of the first 64 primes.",
    "let K_TAB: Array[Int] = [1116352408, 1899447441, 3049323471, 3921009573, 961987163, 1508970993, 2453635748, 2870763221, 3624381080, 310598401, 607225278, 1426881987, 1925078388, 2162078206, 2614888103, 3248222580, 3835390401, 4022224774, 264347078, 604807628, 770255983, 1249150122, 1555081692, 1996064986, 2554220882, 2821834349, 2952996808, 3210313671, 3336571891, 3584528711, 113926993, 338241895, 666307205, 773529912, 1294757372, 1396182291, 1695183700, 1986661051, 2177026350, 2456956037, 2730485921, 2820302411, 3259730800, 3345764771, 3516065817, 3600352804, 4094571909, 275423344, 430227734, 506948616, 659060556, 883997877, 958139571, 1322822218, 1537002063, 1747873779, 1955562222, 2024104815, 2227730452, 2361852424, 2428436474, 2756734187, 3204031479, 3329325298]",
    "",
    "// The same, for the square roots of the first 8 primes.",
    "let H_INIT: Array[Int] = [1779033703, 3144134277, 1013904242, 2773480762, 1359893119, 2600822924, 528734635, 1541459225]",
    "",
    "// `x` is always already masked to 32 bits, so the right shift is",
    "// logical and the left shift cannot reach the sign bit: the largest",
    "// rotation here is 30, and 2^32 << 30 is 2^62.",
    "let rotr (x: Int) (n: Int): Int = ((x >> n) | (x << (32 - n))) & MASK",
    "",
    "let ch (x: Int) (y: Int) (z: Int): Int = (x & y) ^ ((~x) & z) & MASK",
    "let maj (x: Int) (y: Int) (z: Int): Int = (x & y) ^ (x & z) ^ (y & z)",
    "let bsig0 (x: Int): Int = rotr(x, 2) ^ rotr(x, 13) ^ rotr(x, 22)",
    "let bsig1 (x: Int): Int = rotr(x, 6) ^ rotr(x, 11) ^ rotr(x, 25)",
    "let ssig0 (x: Int): Int = rotr(x, 7) ^ rotr(x, 18) ^ (x >> 3)",
    "let ssig1 (x: Int): Int = rotr(x, 17) ^ rotr(x, 19) ^ (x >> 10)",
    "",
    "// The padded message: the bytes, a 0x80, zeros until the length is 56",
    "// mod 64, then the ORIGINAL bit length as 8 big-endian bytes.",
    "let padded (data: Array[Int]): Array[Int] = {",
    "    let bitlen = data.len() * 8;",
    "    let mut out = data.push(128);",
    "    for i in 0..pad_zeros(data.len()) { out = out.push(0); };",
    "    for i in 0..8 { out = out.push((bitlen >> ((7 - i) * 8)) & 255); };",
    "    out",
    "}",
    "",
    "let pad_zeros (n: Int): Int = {",
    "    let rem = (n + 1) % 64;",
    "    if rem <= 56 { 56 - rem } else { 120 - rem }",
    "}",
    "",
    "pub let sha256 (input: Bytes): Bytes = {",
    "    let msg = padded(input.to_array());",
    "    let mut h = H_INIT;",
    "    for b in 0..(msg.len() / 64) { h = block(msg, b * 64, h); };",
    "    digest(h)",
    "}",
    "",
    "let block (msg: Array[Int]) (at: Int) (h: Array[Int]): Array[Int] = {",
    "    let w = schedule(msg, at);",
    "    let mut s = h;",
    "    for t in 0..64 { s = round(s, w[t], K_TAB[t]); };",
    "    let mut out = [];",
    "    for i in 0..8 { out = out.push((h[i] + s[i]) & MASK); };",
    "    out",
    "}",
    "",
    "// The 64-entry message schedule: sixteen big-endian words from the",
    "// block, then forty-eight derived from them.",
    "let schedule (msg: Array[Int]) (at: Int): Array[Int] = {",
    "    let mut w = [];",
    "    for i in 0..16 {",
    "        w = w.push(((msg[at + i * 4] << 24) | (msg[at + i * 4 + 1] << 16)",
    "            | (msg[at + i * 4 + 2] << 8) | msg[at + i * 4 + 3]) & MASK);",
    "    };",
    "    for i in 16..64 {",
    "        w = w.push((ssig1(w[i - 2]) + w[i - 7] + ssig0(w[i - 15]) + w[i - 16]) & MASK);",
    "    };",
    "    w",
    "}",
    "",
    "let round (s: Array[Int]) (wt: Int) (kt: Int): Array[Int] = {",
    "    let t1 = (s[7] + bsig1(s[4]) + ch(s[4], s[5], s[6]) + kt + wt) & MASK;",
    "    let t2 = (bsig0(s[0]) + maj(s[0], s[1], s[2])) & MASK;",
    "    [(t1 + t2) & MASK, s[0], s[1], s[2], (s[3] + t1) & MASK, s[4], s[5], s[6]]",
    "}",
    "",
    "let digest (h: Array[Int]): Bytes = {",
    "    let mut out = [];",
    "    for i in 0..8 {",
    "        for j in 0..4 { out = out.push((h[i] >> ((3 - j) * 8)) & 255); };",
    "    };",
    "    Bytes.from_array(out)",
    "}",
    "",
], "\n")

let cg_encoding_src (): String = Array.join([
    "/// The base64 alphabets, split ONCE into indexable arrays.",
    "///",
    "/// Hoisted to globals deliberately. Character-classification tables",
    "/// have been the hot spot in this project twice, both times because",
    "/// a `chars_of` or a `String.index_of` sat inside a per-character",
    "/// loop and re-split its alphabet for every byte processed. A global",
    "/// is evaluated once, by `@plum_init_globals`.",
    "let B64_STD_CHARS: Array[String] = chars_of(\"ABCDEFGHIJKLMNOPQRSTUVWXYZabcdefghijklmnopqrstuvwxyz0123456789+/\")",
    "let B64_URL_CHARS: Array[String] = chars_of(\"ABCDEFGHIJKLMNOPQRSTUVWXYZabcdefghijklmnopqrstuvwxyz0123456789-_\")",
    "",
    "let byte_at (b: Bytes) (i: Int): Int = match b.at(i) { Some(v) => v, None => 0 }",
    "",
    "// --- Hex ---",
    "",
    "/// Encodes bytes as lowercase hex, two characters per byte.",
    "///",
    "/// The same function as `Bytes.to_hex`, which is in the prelude and",
    "/// needs no `use`. Offered here so that a program already reaching for",
    "/// `Encoding` finds the whole family in one place.",
    "pub let hex_encode (b: Bytes): String = Bytes.to_hex(b)",
    "",
    "// Accepts upper and lower case. An odd length is rejected by",
    "// `hex_decode` itself; see the note there.",
    "let hex_digit_value (c: Int): Int =",
    "    if c >= 48 && c <= 57 { c - 48 }",
    "    else if c >= 97 && c <= 102 { c - 97 + 10 }",
    "    else if c >= 65 && c <= 70 { c - 65 + 10 }",
    "    else { 0 - 1 }",
    "",
    "let hex_acc (b: Bytes) (i: Int) (n: Int) (acc: Array[Int]): Result[Array[Int], String] =",
    "    if i >= n { Ok(acc) }",
    "    else {",
    "        let hi = hex_digit_value(byte_at(b, i));",
    "        let lo = hex_digit_value(byte_at(b, i + 1));",
    "        if hi < 0 || lo < 0 { Err(\"Encoding.hex_decode: not a hex digit at byte \".concat(i.to_string())) }",
    "        else { hex_acc(b, i + 2, n, acc.push(hi * 16 + lo)) }",
    "    }",
    "",
    "/// Decodes a hex string to bytes, accepting upper and lower case.",
    "///",
    "/// Requires an even number of digits. An odd-length string has no",
    "/// reading, and guessing one (a leading zero? a trailing one?)",
    "/// would silently produce different bytes than whatever wrote it",
    "/// intended.",
    "///",
    "/// `Err` on any character that is not a hex digit, and on an odd",
    "/// length. Hex usually arrives from somewhere else, so both are",
    "/// ordinary outcomes rather than programmer error.",
    "pub let hex_decode (s: String): Result[Bytes, String] = {",
    "    let b = s.as_bytes();",
    "    let n = b.len();",
    "    if n % 2 != 0 { Err(\"Encoding.hex_decode: odd number of hex digits\") }",
    "    else { Result.map(hex_acc(b, 0, n, []), |vals| Bytes.from_array(vals)) }",
    "}",
    "",
    "// --- Base64 ---",
    "",
    "// Arithmetic rather than bit operations throughout: the shifts are",
    "// exact divisions and remainders on values already known to be",
    "// 0..255, and this keeps the code readable without depending on",
    "// what bitwise operators Plum does or does not have.",
    "let b64_acc (b: Bytes) (alpha: Array[String]) (pad: Bool) (i: Int) (n: Int) (acc: Array[String]): Array[String] =",
    "    if i >= n { acc }",
    "    else {",
    "        let rem = n - i;",
    "        let b0 = byte_at(b, i);",
    "        let b1 = if rem > 1 { byte_at(b, i + 1) } else { 0 };",
    "        let b2 = if rem > 2 { byte_at(b, i + 2) } else { 0 };",
    "        let c0 = alpha[b0 / 4];",
    "        let c1 = alpha[(b0 % 4) * 16 + b1 / 16];",
    "        let with2 = acc.push(c0).push(c1);",
    "        // A 1-byte tail encodes to two characters, a 2-byte tail to",
    "        // three. Padding makes the output a multiple of four so a",
    "        // decoder can frame it without a length; the URL form drops",
    "        // it because `=` needs escaping in a query string.",
    "        let with3 = if rem > 1 { with2.push(alpha[(b1 % 16) * 4 + b2 / 64]) }",
    "                    else if pad { with2.push(\"=\") } else { with2 };",
    "        let with4 = if rem > 2 { with3.push(alpha[b2 % 64]) }",
    "                    else if pad { with3.push(\"=\") } else { with3 };",
    "        b64_acc(b, alpha, pad, i + 3, n, with4)",
    "    }",
    "",
    "/// Encodes bytes as base64, RFC 4648, using the standard alphabet",
    "/// (`A-Z a-z 0-9 + /`) with `=` padding.",
    "///",
    "/// Padding makes the output a multiple of four, so a decoder can",
    "/// frame it without being told the length.",
    "pub let base64_encode (b: Bytes): String = Array.concat_all(b64_acc(b, B64_STD_CHARS, true, 0, b.len(), []))",
    "",
    "/// The URL-safe alphabet (`-` and `_` for `+` and `/`), with padding",
    "/// OMITTED, which is what JWTs and `data:` URLs expect, since `=`",
    "/// needs escaping in a query string.",
    "pub let base64_url_encode (b: Bytes): String = Array.concat_all(b64_acc(b, B64_URL_CHARS, false, 0, b.len(), []))",
    "",
    "// One decoder serves both alphabets; see `base64_decode`.",
    "///",
    "/// Deliberately lenient, and worth stating rather than discovering: a",
    "/// strict pair would reject a URL-safe token handed to the standard",
    "/// decoder, which is the single most common way this call is written",
    "/// wrong, and rejecting it buys nothing; the two alphabets do not",
    "/// overlap, so no input has two readings. What is NOT lenient is an",
    "/// unrecognised character, which is a real error and reported as one.",
    "let b64_value (c: Int): Int =",
    "    if c >= 65 && c <= 90 { c - 65 }",
    "    else if c >= 97 && c <= 122 { c - 97 + 26 }",
    "    else if c >= 48 && c <= 57 { c - 48 + 52 }",
    "    else if c == 43 || c == 45 { 62 }",
    "    else if c == 47 || c == 95 { 63 }",
    "    else { 0 - 1 }",
    "",
    "// Six-bit values, stopping only at a valid optional padding suffix.",
    "let b64_vals (b: Bytes) (i: Int) (n: Int) (acc: Array[Int]): Result[Array[Int], String] =",
    "    if i >= n { Ok(acc) }",
    "    else {",
    "        let c = byte_at(b, i);",
    "        if c == 61 {",
    "            let pad = n - i;",
    "            let valid = n % 4 == 0 && ((pad == 1 && i % 4 == 3)",
    "                || (pad == 2 && i % 4 == 2 && byte_at(b, i + 1) == 61));",
    "            if !valid {",
    "                Err(\"Encoding.base64_decode: invalid padding\")",
    "            } else { Ok(acc) }",
    "        }",
    "        else {",
    "            let v = b64_value(c);",
    "            if v < 0 { Err(\"Encoding.base64_decode: invalid character at byte \".concat(i.to_string())) }",
    "            else { b64_vals(b, i + 1, n, acc.push(v)) }",
    "        }",
    "    }",
    "",
    "/// Four 6-bit values make three bytes. A tail of three makes two, a",
    "/// tail of two makes one, and a tail of ONE is impossible: six bits",
    "/// cannot encode a byte, so that input was truncated.",
    "let b64_bytes (vals: Array[Int]) (i: Int) (n: Int) (acc: Array[Int]): Result[Array[Int], String] =",
    "    if i >= n { Ok(acc) }",
    "    else {",
    "        let rem = n - i;",
    "        let nonzero_pad_bits = (rem == 2 && vals[i + 1] % 16 != 0)",
    "            || (rem == 3 && vals[i + 2] % 4 != 0);",
    "        if rem == 1 { Err(\"Encoding.base64_decode: truncated input\") }",
    "        else if nonzero_pad_bits {",
    "            Err(\"Encoding.base64_decode: nonzero pad bits\")",
    "        }",
    "        else {",
    "            let v0 = vals[i];",
    "            let v1 = vals[i + 1];",
    "            let with1 = acc.push(v0 * 4 + v1 / 16);",
    "            let with2 = if rem > 2 { with1.push((v1 % 16) * 16 + vals[i + 2] / 4) } else { with1 };",
    "            let with3 = if rem > 3 { with2.push((vals[i + 2] % 4) * 64 + vals[i + 3]) } else { with2 };",
    "            b64_bytes(vals, i + 4, n, with3)",
    "        }",
    "    }",
    "",
    "/// Decodes base64 to bytes, accepting EITHER alphabet and treating",
    "/// padding as optional.",
    "///",
    "/// Deliberately lenient, and worth knowing rather than discovering: a",
    "/// strict pair would reject a URL-safe token handed to the standard",
    "/// decoder, which is the most common way this call is written wrong,",
    "/// and rejecting it buys nothing; the two alphabets do not overlap,",
    "/// so no input has two readings.",
    "///",
    "/// Returns `Err` for unrecognised characters, impossible lengths,",
    "/// malformed padding, or nonzero unused tail bits. If present, padding",
    "/// must be a suffix of one or two `=` characters completing a group",
    "/// of four. Unused tail bits must be zero, with or without padding.",
    "pub let base64_decode (s: String): Result[Bytes, String] = {",
    "    let b = s.as_bytes();",
    "    match b64_vals(b, 0, b.len(), []) {",
    "        Err(e) => Err(e),",
    "        Ok(vals) => Result.map(b64_bytes(vals, 0, vals.len(), []), |out| Bytes.from_array(out)),",
    "    }",
    "}",
    "",
    "/// The same decoder as `base64_decode`, which already accepts the",
    "/// URL-safe alphabet. Offered as a name so a caller reading a JWT can",
    "/// say what they mean.",
    "pub let base64_url_decode (s: String): Result[Bytes, String] = base64_decode(s)",
    "",
    "// --- Percent-encoding ---",
    "",
    "// See `percent_encode` for the alphabet and the `+` decision.",
    "let is_unreserved (c: Int): Bool =",
    "    (c >= 65 && c <= 90) || (c >= 97 && c <= 122) || (c >= 48 && c <= 57)",
    "    || c == 45 || c == 46 || c == 95 || c == 126",
    "",
    "/// A 0-15 value as the ASCII byte of its uppercase hex digit.",
    "let hex_upper_byte (v: Int): Int = if v < 10 { 48 + v } else { 65 + v - 10 }",
    "",
    "/// Builds the output as BYTES rather than as characters, which is",
    "/// what lets an unreserved byte pass straight through: turning one",
    "/// back into a one-character String would need an ASCII table to",
    "/// index, and the table would exist only to undo a conversion that",
    "/// never had to happen.",
    "let pct_acc (b: Bytes) (i: Int) (n: Int) (acc: Array[Int]): Array[Int] =",
    "    if i >= n { acc }",
    "    else {",
    "        let c = byte_at(b, i);",
    "        if is_unreserved(c) { pct_acc(b, i + 1, n, acc.push(c)) }",
    "        else { pct_acc(b, i + 1, n, acc.push(37).push(hex_upper_byte(c / 16)).push(hex_upper_byte(c % 16))) }",
    "    }",
    "",
    "// The `Err` arm below is unreachable by construction: every byte",
    "// emitted is either an unreserved character or one of `%0-9A-F`, all",
    "// ASCII and therefore valid UTF-8. Written as a `match` rather than an",
    "// unwrap so the impossible case is visible rather than asserted.",
    "",
    "/// Percent-encodes bytes for use in a URL, RFC 3986.",
    "///",
    "/// Unreserved is `A-Z a-z 0-9 - . _ ~`; every other byte becomes `%XX`",
    "/// with UPPERCASE hex, which the RFC prefers and which makes encoded",
    "/// output comparable byte for byte.",
    "///",
    "/// **A space becomes `%20`, not `+`.** The `+` convention belongs to",
    "/// HTML form bodies (`application/x-www-form-urlencoded`), not to",
    "/// URLs, and a decoder that accepted both would turn a literal `+` in",
    "/// a query value into a space.",
    "pub let percent_encode (b: Bytes): String =",
    "    match Bytes.as_string(Bytes.from_array(pct_acc(b, 0, b.len(), []))) {",
    "        Ok(s) => s,",
    "        Err(e) => e,",
    "    }",
    "",
    "let pct_decode_acc (b: Bytes) (i: Int) (n: Int) (acc: Array[Int]): Result[Array[Int], String] =",
    "    if i >= n { Ok(acc) }",
    "    else {",
    "        let c = byte_at(b, i);",
    "        if c != 37 { pct_decode_acc(b, i + 1, n, acc.push(c)) }",
    "        else if i + 2 >= n { Err(\"Encoding.percent_decode: truncated escape at byte \".concat(i.to_string())) }",
    "        else {",
    "            let hi = hex_digit_value(byte_at(b, i + 1));",
    "            let lo = hex_digit_value(byte_at(b, i + 2));",
    "            if hi < 0 || lo < 0 { Err(\"Encoding.percent_decode: invalid escape at byte \".concat(i.to_string())) }",
    "            else { pct_decode_acc(b, i + 3, n, acc.push(hi * 16 + lo)) }",
    "        }",
    "    }",
    "",
    "/// Decodes percent-escapes back to bytes.",
    "///",
    "/// `Err` on a `%` that is not followed by two hex digits. `+` decodes",
    "/// as a literal plus sign, matching `percent_encode`.",
    "///",
    "/// Returns `Bytes` rather than `String` because an escape can encode",
    "/// any byte, including sequences that are not valid UTF-8. Call",
    "/// `Bytes.as_string` when text is what was expected.",
    "pub let percent_decode (s: String): Result[Bytes, String] = {",
    "    let b = s.as_bytes();",
    "    Result.map(pct_decode_acc(b, 0, b.len(), []), |vals| Bytes.from_array(vals))",
    "}",
    "",
], "\n")

// Keep the embedded module and its generated docs on the same source.
let cg_time_src (): String = @embed_file("../../std/Time.plum")

// Turning a `JsonValue` into a real type, and saying WHERE it could
// not (issue #4).
//
// `json_parse` is in the prelude and gives back a faithful `JsonValue`.
// Reading `owner.login` out of one by hand means matching `JsonObject`,
// scanning an `Array[JsonEntry]`, and matching `JsonString` -- fifteen
// lines that say nothing about the program, once per field, and which
// have lost the field's NAME by the time they report a failure.
//
// A `Decoder[T]` is a value that knows how to do that, and decoders
// COMPOSE. The composition is what carries the path: `field("owner",
// d)` extends the path `d` reports against, so a failure five levels
// down names five levels without anyone threading a string. That is the
// whole design, and everything else here follows from it.
//
// A library, not syntax. No keyword, no grammar, nothing in the
// compiler knows this module exists -- it is ordinary Plum over a
// generic struct with a closure field, which is why it is a module and
// not a language feature.
//
// Deliberately NOT in the prelude, unlike `JsonValue` itself.
// `Decoder` is a type with its own operations rather than a namespace
// on an existing one, so nothing about `T.f(x)` method dispatch forces
// it to be always in scope, and a program that only parses JSON should
// not carry a decoding library it never names.
// Embed the canonical source so runtime behavior and reference docs cannot drift.
let cg_json_src (): String = @embed_file("../../std/Json.plum")

let cg_terminal_src (): String = Array.join([
    "/// The terminal PLATFORM LAYER (issue #3): is this a terminal, how big",
    "/// is it, and writing to it.",
    "///",
    "/// Deliberately the small half. Turning input bytes into semantic key",
    "/// events (`Key.Up`, `Ctrl+C`) is #35, and it is pure Plum with no",
    "/// C in it, which is why it is not here. What belongs in a standard",
    "/// library is the part that needs a shim and has no design space to get",
    "/// wrong: `isatty` is `isatty`. How to model a modifier key is taste,",
    "/// and taste does not belong in an API nobody can change.",
    "///",
    "/// Raw mode and the alternate screen come next, as `handle` types, so",
    "/// the terminal is restored on every exit path including a panic --",
    "/// which is the machinery a TUI otherwise writes in C.",
    "extern \"C\" {",
    "    fn term_is_tty(which: Int) -> Int;",
    "    fn term_size_query() -> Int;",
    "    fn term_size_cols() -> Int;",
    "    fn term_size_rows() -> Int;",
    "    fn term_write(s: CStr) -> Int;",
    "    fn term_flush() -> Int;",
    "    fn term_display_width(s: CStr) -> Int;",
    "    fn term_truncate_bytes(s: CStr, cells: Int) -> Int;",
    "}",
    "",
    "/// Which stream to ask about. A closed set of small integers across the",
    "/// extern boundary, the same shape `Os.Mode` and `Os.Seek` use: an",
    "/// extern taking a file descriptor NUMBER would let a caller pass",
    "/// anything at all.",
    "pub enum Stream { Stdin, Stdout, Stderr }",
    "",
    "let stream_code (s: Stream): Int = match s { Stdin => 0, Stdout => 1, Stderr => 2 }",
    "",
    "/// Whether that stream is attached to a terminal.",
    "///",
    "/// This is the check behind \"should I use colour?\" and \"is this being",
    "/// piped somewhere?\", and the answer differs per stream: a program in a",
    "/// pipeline routinely has a terminal on stderr and a pipe on stdout.",
    "/// Asking about the wrong one is how progress bars end up in log files.",
    "pub let is_tty (s: Stream): Bool = unsafe { term_is_tty(stream_code(s)) == 1 }",
    "",
    "/// The size of the terminal, in character cells.",
    "pub struct Size { pub cols: Int, pub rows: Int }",
    "",
    "/// The terminal's size, in character cells, measured on STDOUT. The",
    "/// size of the thing being drawn to. A program whose stdin is a pipe and",
    "/// whose stdout is a terminal still has a size worth knowing.",
    "///",
    "/// `Err` when there is no terminal to ask, which is not a failure the",
    "/// caller caused: output redirected to a file has no size. A program",
    "/// that wants to carry on regardless should pick its own default rather",
    "/// than be handed one, because 80x24 is a guess and this module should",
    "/// not make guesses on anyone's behalf.",
    "///",
    "/// **Poll this rather than waiting to be told.** POSIX reports a resize",
    "/// with `SIGWINCH`, Plum has no signal handling, and this module is not",
    "/// the place to introduce it. Comparing the size between iterations of",
    "/// an event loop costs one syscall against a redraw, and works the same",
    "/// way on Windows, which has no such signal at all.",
    "pub let size (): Result[Size, String] = unsafe {",
    "    if term_size_query() != 0 { Err(\"Terminal.size: not a terminal, or its size is unknown\") }",
    "    else { Ok(Size { cols: term_size_cols(), rows: term_size_rows() }) }",
    "}",
    "",
    "/// Writes to stdout with NO trailing newline and NO flush.",
    "///",
    "/// Both omissions are deliberate. A terminal program positions its own",
    "/// output with escape sequences, so an automatic newline would corrupt",
    "/// every frame it draws; and flushing per write turns one redraw into",
    "/// hundreds of syscalls. Build a frame, then `flush` it.",
    "///",
    "/// `println` is still the right thing for line-oriented output. This is",
    "/// for programs that are drawing.",
    "pub let write (text: String): Result[Unit, String] = unsafe {",
    "    if term_write(text.as_cstr()) == 0 { Ok(()) }",
    "    else { Err(\"Terminal.write: could not write to stdout\") }",
    "}",
    "",
    "/// Makes everything written so far visible. Nothing a terminal program",
    "/// draws is on screen until this returns.",
    "pub let flush (): Result[Unit, String] = unsafe {",
    "    if term_flush() == 0 { Ok(()) } else { Err(\"Terminal.flush: could not flush stdout\") }",
    "}",
    "",
    "/// The number of terminal cells `text` occupies.",
    "///",
    "/// This is Unicode 16.0 display width, not a byte or codepoint count:",
    "/// CJK and emoji take two cells, combining marks take none, and ANSI",
    "/// escape sequences are ignored. East-Asian ambiguous characters are",
    "/// narrow, the portable default when the terminal locale is unknown.",
    "pub let display_width (text: String): Int = unsafe { term_display_width(text.as_cstr()) }",
    "",
    "/// The longest prefix that fits in `cells` terminal cells.",
    "///",
    "/// Never splits combining marks, Hangul, flags, or an emoji joined",
    "/// with ZWJ: each either fits whole or is left out.",
    "/// ANSI escape sequences consume no cells and are retained only when",
    "/// they occur before the returned boundary. A non-positive width gives",
    "/// the empty string.",
    "pub let truncate (text: String) (cells: Int): String = {",
    "    let bytes = unsafe { term_truncate_bytes(text.as_cstr(), cells) };",
    "    match Bytes.as_string(Bytes.slice(text.as_bytes(), 0, bytes)) {",
    "        Ok(prefix) => prefix,",
    "        Err(_) => \"\", // the shim returns a UTF-8 boundary by contract.",
    "    }",
    "}",
    "",
    "/// `text` followed by spaces until it occupies `cells` terminal cells.",
    "/// It never truncates; use `Terminal.truncate` when a fixed column must",
    "/// fit. ANSI escapes are preserved and do not affect the added spaces.",
    "pub let pad_right (text: String) (cells: Int): String = {",
    "    let width = display_width(text);",
    "    if width >= cells { text } else { text.concat(String.repeat(\" \", cells - width)) }",
    "}",
    "",
    "// --- Modes, as handles ---",
    "//",
    "// Each of these changes the terminal and puts it back when the value",
    "// dies -- on a normal return, at the end of a block, on an `Err`, and",
    "// on a PANIC. That last one is why they are handles rather than a pair",
    "// of functions: a crash that leaves a terminal in raw mode with no",
    "// cursor does not just lose the program, it takes the user's shell with",
    "// it, and that is exactly the machinery a TUI otherwise writes in C.",
    "//",
    "// They are independent, and release LIFO, so",
    "//",
    "//     let raw = Terminal.enter_raw()?;",
    "//     let screen = Terminal.enter_alt_screen()?;",
    "//",
    "// leaves the alternate screen BEFORE restoring the mode, which is the",
    "// right order, without anyone arranging it. Either works without the",
    "// other: a filter wants raw mode and no alternate screen.",
    "//",
    "// Entering twice is COUNTED, not refused. The first entry saves the",
    "// state and applies the change, later ones only count, and the last to",
    "// die restores. That means a library and its caller can both ask",
    "// without knowing about each other, and it does not depend on the two",
    "// dying in any particular order.",
    "extern \"C\" {",
    "    fn term_enter_raw() -> Int;",
    "    fn term_leave_raw(h: Int);",
    "    fn term_enter_alt() -> Int;",
    "    fn term_leave_alt(h: Int);",
    "    fn term_hide_cursor() -> Int;",
    "    fn term_show_cursor(h: Int);",
    "}",
    "",
    "/// Raw mode, held. The terminal is restored when this value dies,",
    "/// including on a panic.",
    "///",
    "/// While it lives, Ctrl+C arrives as a BYTE (0x03) rather than a",
    "/// signal — see `Terminal.enter_raw`.",
    "pub handle RawMode { on_drop: term_leave_raw }",
    "/// The alternate screen, held. The previous screen and the user's",
    "/// scrollback come back when this value dies.",
    "pub handle AltScreen { on_drop: term_leave_alt }",
    "/// A hidden cursor, held. The cursor is shown again when this value",
    "/// dies, including on a panic — which is what stops a crash leaving a",
    "/// terminal with no cursor.",
    "pub handle HiddenCursor { on_drop: term_show_cursor }",
    "",
    "/// Line editing and echo off, so a program sees each keystroke as it",
    "/// happens rather than a line at a time.",
    "///",
    "/// **Ctrl+C stops being a signal and becomes a byte** (0x03). That is",
    "/// what raw mode means everywhere, and here it is also what keeps",
    "/// cleanup working: the default action for SIGINT ends the process",
    "/// without running any cleanup, so a Ctrl+C in raw mode with signals",
    "/// still enabled would leave the terminal raw. Delivered as a byte, a",
    "/// program can exit normally and everything is restored. A raw-mode",
    "/// program is responsible for noticing 0x03 and quitting.",
    "///",
    "/// `Err` when stdin is not a terminal; there is nothing to put into",
    "/// raw mode, and pretending otherwise would leave a program reading a",
    "/// pipe and waiting for keys that cannot come.",
    "pub let enter_raw (): Result[RawMode, String] = unsafe {",
    "    if term_enter_raw() == 0 { Ok(RawMode.from_raw(0)) }",
    "    else { Err(\"Terminal.enter_raw: stdin is not a terminal\") }",
    "}",
    "",
    "/// The xterm alternate screen: a blank screen that leaves the user's",
    "/// scrollback untouched, and gives their shell back exactly as it was.",
    "/// What a full-screen program should use instead of clearing.",
    "pub let enter_alt_screen (): Result[AltScreen, String] = unsafe {",
    "    if term_enter_alt() == 0 { Ok(AltScreen.from_raw(0)) }",
    "    else { Err(\"Terminal.enter_alt_screen: could not switch screens\") }",
    "}",
    "",
    "/// Hides the cursor while the value lives. A program drawing its own",
    "/// frames does not want a blinking block wherever the last write",
    "/// happened to end.",
    "pub let hide_cursor (): Result[HiddenCursor, String] = unsafe {",
    "    if term_hide_cursor() == 0 { Ok(HiddenCursor.from_raw(0)) }",
    "    else { Err(\"Terminal.hide_cursor: could not hide the cursor\") }",
    "}",
], "\n")
