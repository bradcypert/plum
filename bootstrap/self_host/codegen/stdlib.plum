// Standard-library MODULES -- source that is compiled into a program
// only when that program says `use <Name>;`.
//
// The prelude and a stdlib module answer two different questions.
// `Array.map` and `String.pad_left` have to be in the prelude, because
// `T.f(x)` IS the method-call mechanism: `xs.map(f)` is `Array.map(xs,
// f)`, so a type's namespace cannot be optional. `Time` has no
// receiver -- it names no type, and nothing dispatches to it -- so it
// is a module wearing a namespace's clothes, and it is spelled like
// one.
//
// (`Os` is in exactly the same position and has not moved. It is
// reachable from every program written so far, including this
// compiler, so that is a deliberate break to schedule rather than a
// tidy-up to slip in.)
//
// Gating on `use` is what makes the declaration LOAD-BEARING. Until
// now `use` was parsed and then ignored by every later stage -- module
// membership came entirely from the directory an item was found in, so
// `use shapes;` documented an intent the compiler never checked. A
// stdlib module has no directory to be found in, so `use Time;` is the
// only thing that can bring it in.

use lexer;
use parser;

// `needs` is the modules this one is written against. `Http` is
// ordinary Plum over `Net`'s sockets, so a program that says
// `use Http;` must get `Net` too whether it asked for it or not --
// otherwise the module's own body would reference something that was
// never injected, which is a compiler bug reported as a user error.
pub struct StdModule { pub name: String, pub source: String, pub needs: Array[String] }

// Every stdlib module, built from `parser.std_module_names` so the
// name list has exactly one home. A name with no source here is a
// compiler bug, not a user error, and says so.
pub let cg_std_modules (): Array[StdModule] =
    Array.map(parser.std_module_names(()), |n| StdModule { name: n, source: cg_std_source(n), needs: cg_std_needs(n) })

let cg_std_needs (name: String): Array[String] =
    if name == "Http" { ["Net"] } else { [] }

let cg_std_source (name: String): String =
    if name == "Time" { cg_time_src(()) }
    else if name == "Os" { cg_os_src(()) }
    else if name == "Net" { cg_net_src(()) }
    else if name == "Http" { cg_http_src(()) }
    else { { cg_fail("no source for stdlib module ".concat(name)); "" } }

// The items a program's `use` declarations actually ask for, stamped
// with their module name the same way a directory would have stamped
// them.
pub let cg_std_items (user: Array[parser.ItemNode]): Array[parser.ItemNode] = {
    let mods = cg_std_modules(());
    let wanted = cg_close_needs(mods, cg_direct_uses(mods, user, 0, []), 0);
    cg_std_items_acc(mods, wanted, 0, [])
}

let cg_direct_uses (mods: Array[StdModule]) (user: Array[parser.ItemNode]) (i: Int) (acc: Array[String]): Array[String] =
    if i >= mods.len() { acc }
    else if cg_uses_module(user, mods[i].name, 0) { cg_direct_uses(mods, user, i + 1, acc.push(mods[i].name)) }
    else { cg_direct_uses(mods, user, i + 1, acc) }

// One pass per module is enough to close over `needs`: the graph is
// tiny and acyclic by construction, and a fixed number of passes over
// the whole list cannot miss a chain shorter than that list.
let cg_close_needs (mods: Array[StdModule]) (want: Array[String]) (round: Int): Array[String] =
    if round >= mods.len() { want }
    else { cg_close_needs(mods, cg_add_needs(mods, want, 0), round + 1) }

let cg_add_needs (mods: Array[StdModule]) (want: Array[String]) (i: Int): Array[String] =
    if i >= mods.len() { want }
    else if Array.contains(want, mods[i].name) { cg_add_needs(mods, cg_union(want, mods[i].needs, 0), i + 1) }
    else { cg_add_needs(mods, want, i + 1) }

let cg_union (into: Array[String]) (add: Array[String]) (i: Int): Array[String] =
    if i >= add.len() { into }
    else if Array.contains(into, add[i]) { cg_union(into, add, i + 1) }
    else { cg_union(into.push(add[i]), add, i + 1) }

// Emitted in `std_module_names` order, not in the order the program
// happened to `use` them, so the same program always produces the same
// IR regardless of how its imports were written.
let cg_std_items_acc (mods: Array[StdModule]) (want: Array[String]) (i: Int) (acc: Array[parser.ItemNode]): Array[parser.ItemNode] =
    if i >= mods.len() { acc }
    else if Array.contains(want, mods[i].name) {
        cg_std_items_acc(mods, want, i + 1, Array.concat(acc, cg_parse_std(mods[i].name, mods[i].source)))
    } else { cg_std_items_acc(mods, want, i + 1, acc) }

// `use Time;` and `use Time.rfc7231;` both count -- the second is the
// import-one-name form, and it names the same module.
let cg_uses_module (items: Array[parser.ItemNode]) (name: String) (i: Int): Bool =
    if i >= items.len() { false }
    else {
        match items[i].kind {
            IKUse(u) => if !Array.is_empty(u.path) && u.path[0] == name { true }
                        else { cg_uses_module(items, name, i + 1) },
            _ => cg_uses_module(items, name, i + 1),
        }
    }

// Parsed with its own source context, so an error inside a stdlib
// module quotes the module rather than whatever file was being read
// when it was pulled in.
let cg_parse_std (name: String) (src: String): Array[parser.ItemNode] = {
    let saved = parser.current_path(());
    let lexed = lexer.tokenize_spanned(src);
    parser.set_source_context("<".concat(name).concat(">"), src, lexed.starts);
    let items = parser.with_module(parser.parse_program(lexed.tokens).items, name);
    parser.set_source_context(saved, "", []);
    items
}

// --- The `Net` module ---
//
// The six TCP calls, unprefixed: `tcp_connect_to` was named that way
// because it lived in a flat prelude and had nothing else to
// distinguish it. The module supplies the prefix now, so
// `Net.connect_to` says the same thing without saying "tcp" twice.
let cg_net_src (): String = Array.join([
    "// TCP sockets, over `native_stdlib/net_shim.c`. Plain `Result`",
    "// wrapping around a sentinel `-1`: a raw BSD sockets call crossing",
    "// the shim does not preserve an `errno`, so each failure carries a",
    "// fixed message saying WHAT failed rather than why.",
    "extern \"C\" {",
    "    fn tcp_connect(host: CStr, port: Int) -> Int;",
    "    fn tcp_listen(port: Int) -> Int;",
    "    fn tcp_accept(fd: Int) -> Int;",
    "    fn tcp_send(fd: Int, buf: CStr, len: Int) -> Int;",
    "    fn tcp_recv(fd: Int, max_len: Int) -> CStr;",
    "    fn tcp_close(fd: Int) -> Unit;",
    "}",
    "",
    "pub let connect_to (host: String) (port: Int): Result[Int, String] = unsafe {",
    "    let fd = tcp_connect(host.as_cstr(), port);",
    "    if fd < 0 { Err(\"Net.connect_to: could not connect to \".concat(host).concat(\":\").concat(port.to_string())) } else { Ok(fd) }",
    "}",
    "",
    "pub let listen_on (port: Int): Result[Int, String] = unsafe {",
    "    let fd = tcp_listen(port);",
    "    if fd < 0 { Err(\"Net.listen_on: could not listen on port \".concat(port.to_string())) } else { Ok(fd) }",
    "}",
    "",
    "pub let accept (fd: Int): Result[Int, String] = unsafe {",
    "    let client = tcp_accept(fd);",
    "    if client < 0 { Err(\"Net.accept: accept failed\") } else { Ok(client) }",
    "}",
    "",
    "// `len` MUST be bound BEFORE `.as_cstr()` runs. `.as_cstr()`",
    "// decrements the string's refcount to produce its copy and FREES",
    "// the original outright if that was the last reference -- exactly",
    "// what a direct `tcp_write(fd, \"hello\")` passes. Reading",
    "// `data.len()` afterwards in the same argument list is a real",
    "// use-after-free, and the real compiler found it the hard way:",
    "// garbage bytes trailing the content on an actual socket, observed",
    "// on the wire rather than theorized.",
    "pub let write (fd: Int) (data: String): Result[Int, String] = unsafe {",
    "    let len = data.len();",
    "    let n = tcp_send(fd, data.as_cstr(), len);",
    "    if n < 0 { Err(\"Net.write: send failed\") } else { Ok(n) }",
    "}",
    "",
    "// \"\" on BOTH a clean peer close and a hard socket error. The",
    "// distinction is not preserved in v1, and either way \"stop",
    "// reading\" is the right response -- which an empty String already",
    "// signals to a caller looping until end of stream.",
    "pub let read (fd: Int) (max_len: Int): String = unsafe { tcp_recv(fd, max_len).as_string() }",
    "",
    "pub let close (fd: Int): Unit = unsafe { tcp_close(fd); () }",
    "",
], "\n")

// --- The `Http` module ---
//
// Ordinary Plum over `Net`, with no IR, backend or extern surface of
// its own -- which is exactly why it is a SEPARATE module rather than
// more of `Net`. It is also the reason `StdModule` grew a `needs`
// field: `use Http;` has to pull `Net` in, because this source calls
// `Net.connect_to` and would otherwise reference a module the program
// never asked for.
//
// The structs lost their `Http` prefix along with the functions --
// `Http.Response`, not `Http.HttpResponse` -- and gained `pub`, which
// they never had and never needed while everything shared one flat
// namespace.
let cg_http_src (): String = Array.join([
    // --- HTTP client and server ---
    //
    // Ported from the real compiler's `STDLIB_HTTP_SRC` on 2026-08-21,
    // VERBATIM: it is ordinary Plum built on the TCP layer above, with
    // no IR, backend or extern surface of its own. That was the point
    // of building TCP first, and it is what made this port a
    // transcription rather than a reimplementation.
    //
    // Two lines were NOT verbatim on the day of the port -- the two
    // `Result.and_then(_, http_parse_head)` references, which had to be
    // eta-expanded by hand because this compiler had no
    // function-as-value support. That gap is closed, and the source
    // matches the real prelude line for line again.
    "pub struct Header { pub name: String, pub value: String }",
    "pub struct Response { pub status: Int, pub headers: Array[Header], pub body: String }",
    "pub struct UrlParts { pub host: String, pub port: Int, pub path: String }",
    "pub struct Head { pub status: Int, pub headers: Array[Header], pub leftover_body: String }",
    "pub struct Request { pub method: String, pub path: String, pub headers: Array[Header], pub body: String }",
    "pub struct RequestLine { pub method: String, pub path: String }",
    "pub struct RequestHead { pub method: String, pub path: String, pub headers: Array[Header], pub leftover_body: String }",
    "",
    "let http_parse_url (url: String): Result[UrlParts, String] =",
    "    if String.index_of(url, \"https://\") == Some(0) { Err(\"http client: https:// is not supported yet\") }",
    "    else if String.index_of(url, \"http://\") != Some(0) { Err(\"http client: url must start with http://\") }",
    "    else {",
    "        let rest = String.slice(url, 7, url.len());",
    "        let path_start = match String.index_of(rest, \"/\") { Some(i) => i, None => rest.len() };",
    "        let authority = String.slice(rest, 0, path_start);",
    "        let path = if path_start == rest.len() { \"/\" } else { String.slice(rest, path_start, rest.len()) };",
    "        match String.index_of(authority, \":\") {",
    "            None => Ok(UrlParts { host: authority, port: 80, path: path }),",
    "            Some(i) => match String.parse_int(String.slice(authority, i + 1, authority.len())) {",
    "                Err(e) => Err(\"http client: invalid port in url: \".concat(e)),",
    "                Ok(port) => Ok(UrlParts { host: String.slice(authority, 0, i), port: port, path: path }),",
    "            },",
    "        }",
    "    }",
    "",
    "let http_build_request (method: String) (parsed: UrlParts) (headers: Array[Header]) (body: String): String = {",
    "    let extra_header_lines = Array.fold(headers, \"\", |acc, h| acc.concat(h.name).concat(\": \").concat(h.value).concat(\"\\r\\n\"));",
    "    let content_length_line = if String.is_empty(body) { \"\" } else { \"Content-Length: \".concat(body.len().to_string()).concat(\"\\r\\n\") };",
    "    method.concat(\" \").concat(parsed.path).concat(\" HTTP/1.1\\r\\n\")",
    "        .concat(\"Host: \").concat(parsed.host).concat(\"\\r\\n\")",
    "        .concat(\"Connection: close\\r\\n\")",
    "        .concat(content_length_line)",
    "        .concat(extra_header_lines)",
    "        .concat(\"\\r\\n\")",
    "        .concat(body)",
    "}",
    "",
    "// Reads (and accumulates) until the blank-line header/body separator",
    "// has actually arrived — it may take more than one `tcp_read` call to",
    "// see it at all, and a single `tcp_read` may ALSO return part of the",
    "// body past it in the same chunk (`http_parse_head` below splits that",
    "// back out). An empty read here means the peer closed before the",
    "// headers even finished, always a real error, never a legitimate",
    "// empty response.",
    "let http_recv_headers_acc (fd: Int) (acc: String): Result[String, String] =",
    "    match String.index_of(acc, \"\\r\\n\\r\\n\") {",
    "        Some(_) => Ok(acc),",
    "        None => {",
    "            let chunk = Net.read(fd, 4096);",
    "            if String.is_empty(chunk) { Err(\"http client: connection closed before the response headers were complete\") }",
    "            else { http_recv_headers_acc(fd, acc.concat(chunk)) }",
    "        },",
    "    }",
    "",
    "let http_parse_status_line (line: String): Result[Int, String] = {",
    "    let parts = String.trim_end(line).split(\" \");",
    "    if parts.len() < 2 { Err(\"http client: malformed status line: \".concat(line)) }",
    "    else { match String.parse_int(parts[1]) {",
    "        Err(e) => Err(\"http client: malformed status code: \".concat(e)),",
    "        Ok(code) => Ok(code),",
    "    } }",
    "}",
    "",
    "let http_parse_header_line (line: String): Option[Header] =",
    "    match String.index_of(line, \": \") {",
    "        None => None,",
    "        Some(i) => Some(Header { name: String.slice(line, 0, i), value: String.trim_end(String.slice(line, i + 2, line.len())) }),",
    "    }",
    "",
    "let http_parse_headers (lines: Array[String]): Array[Header] =",
    "    Array.fold(lines, [], |acc, line| match http_parse_header_line(line) {",
    "        None => acc,",
    "        Some(h) => acc.push(h),",
    "    })",
    "",
    "let http_find_header (headers: Array[Header]) (name: String): Option[String] =",
    "    Option.map(Array.find(headers, |h| h.name == name), |h| h.value)",
    "",
    "// Splits the raw, already-fully-received header block (see `http_recv_",
    "// headers_acc` above) into the parsed status/headers plus whatever body",
    "// bytes rode along in the same read.",
    "let http_parse_head (raw: String): Result[Head, String] = {",
    "    let sep_index = match String.index_of(raw, \"\\r\\n\\r\\n\") { Some(i) => i, None => raw.len() };",
    "    let leftover_body = if sep_index + 4 <= raw.len() { String.slice(raw, sep_index + 4, raw.len()) } else { \"\" };",
    "    let lines = String.slice(raw, 0, sep_index).split(\"\\n\");",
    "    if lines.len() == 0 { Err(\"http client: empty response\") }",
    "    else { Result.map(http_parse_status_line(lines[0]), |status| Head {",
    "        status: status,",
    "        headers: http_parse_headers(Array.drop(lines, 1)),",
    "        leftover_body: leftover_body,",
    "    }) }",
    "}",
    "",
    "let http_recv_body_by_length_acc (fd: Int) (acc: String) (remaining: Int): Result[String, String] =",
    "    if remaining <= 0 { Ok(acc) }",
    "    else {",
    "        let chunk = Net.read(fd, remaining);",
    "        if String.is_empty(chunk) { Err(\"http client: connection closed before the full response body was received\") }",
    "        else { http_recv_body_by_length_acc(fd, acc.concat(chunk), remaining - chunk.len()) }",
    "    }",
    "",
    "let http_recv_body_until_close_acc (fd: Int) (acc: String): String = {",
    "    let chunk = Net.read(fd, 4096);",
    "    if String.is_empty(chunk) { acc } else { http_recv_body_until_close_acc(fd, acc.concat(chunk)) }",
    "}",
    "",
    "// Takes `headers`/`leftover_body` directly (not a whole `Head`) —",
    "// but, UNLIKE the rest of this module's shared parsing helpers, this",
    "// one is response-side ONLY, not reused for requests (see `http_read_",
    "// request_body` below for why the two genuinely differ, not just a",
    "// convenience split).",
    "let http_read_body (fd: Int) (headers: Array[Header]) (leftover_body: String): Result[String, String] =",
    "    match http_find_header(headers, \"Content-Length\") {",
    "        Some(cl) => match String.parse_int(cl) {",
    "            Err(e) => Err(\"http: invalid Content-Length header: \".concat(e)),",
    "            Ok(content_length) => http_recv_body_by_length_acc(fd, leftover_body, content_length - leftover_body.len()),",
    "        },",
    "        None => match http_find_header(headers, \"Transfer-Encoding\") {",
    "            Some(te) => Err(\"http: Transfer-Encoding (\".concat(te).concat(\") is not supported yet\")),",
    "            None => Ok(http_recv_body_until_close_acc(fd, leftover_body)),",
    "        },",
    "    }",
    "",
    "// The REQUEST-side sibling of `http_read_body` above — same `Content-",
    "// Length`/`Transfer-Encoding` handling, but a DELIBERATELY different",
    "// answer when NEITHER is present: an EMPTY body (`leftover_body` as-",
    "// is), never \"read until the connection closes.\" Originally shared",
    "// `http_read_body` directly for both — a real, live DEADLOCK surfaced",
    "// exactly that assumption was wrong, not just imprecise: a bodyless",
    "// `GET` (no `Content-Length`, since there's no body to measure) has no",
    "// reason to ever close its OWN write side, so a server blocked",
    "// \"reading until close\" on it hangs forever waiting for a body that",
    "// will never arrive — confirmed directly (a real test hung against a",
    "// real socket, root-caused by isolating each step with `println`",
    "// debugging until the exact hang site was found), not merely",
    "// theorized. The response side's OWN \"no length header -> read until",
    "// close\" answer stays correct on ITS side: every request this client",
    "// sends already includes `Connection: close`, so that read is bounded",
    "// by the SERVER eventually closing once it's done writing — a",
    "// guarantee nothing analogous exists for on the request side.",
    "let http_read_request_body (fd: Int) (headers: Array[Header]) (leftover_body: String): Result[String, String] =",
    "    match http_find_header(headers, \"Content-Length\") {",
    "        Some(cl) => match String.parse_int(cl) {",
    "            Err(e) => Err(\"http: invalid Content-Length header: \".concat(e)),",
    "            Ok(content_length) => http_recv_body_by_length_acc(fd, leftover_body, content_length - leftover_body.len()),",
    "        },",
    "        None => match http_find_header(headers, \"Transfer-Encoding\") {",
    "            Some(te) => Err(\"http: Transfer-Encoding (\".concat(te).concat(\") is not supported yet\")),",
    "            None => Ok(leftover_body),",
    "        },",
    "    }",
    "",
    "// Pipe + `Result.and_then`/`Result.map`, not nested `match` — a",
    "// deliberate house-style adoption (see DESIGN.md's own \"?/early-return",
    "// sugar\" section for the full writeup: real `?`-style early return",
    "// would need a language feature Plum doesn't have at all, `return`,",
    "// plus a `From`-style error-conversion mechanism the closed trait set",
    "// has no room for — this gets most of the real readability benefit",
    "// today, for free, confirmed by rewriting this exact chain both ways",
    "// and running BOTH against the real shipped counterpart before",
    "// choosing this one). `|ignored| ..` discards `tcp_write`'s own `Int`",
    "// (bytes-written count) — the next step doesn't need it, only that the",
    "// write succeeded at all.",
    "let http_do_request (fd: Int) (method: String) (parsed: UrlParts) (headers: Array[Header]) (body: String): Result[Response, String] =",
    "    Net.write(fd, http_build_request(method, parsed, headers, body))",
    "        |> Result.and_then(_, |ignored| http_recv_headers_acc(fd, \"\"))",
    "        |> Result.and_then(_, http_parse_head)",
    "        |> Result.and_then(_, |head| Result.map(http_read_body(fd, head.headers, head.leftover_body), |response_body| Response { status: head.status, headers: head.headers, body: response_body }))",
    "",
    "// `fd` has to stay reachable for the FINAL cleanup step regardless of",
    "// `http_do_request`'s own outcome — closure capture (`fd` bound by the",
    "// outer `and_then`, still in scope in the block passed to the inner",
    "// one) does this without needing the old two-armed \"close then re-wrap",
    "// Ok/Err separately\" match at all.",
    "pub let request (method: String) (url: String) (headers: Array[Header]) (body: String): Result[Response, String] =",
    "    http_parse_url(url)",
    "        |> Result.and_then(_, |parsed| Net.connect_to(parsed.host, parsed.port) |> Result.and_then(_, |fd| {",
    "            let result = http_do_request(fd, method, parsed, headers, body);",
    "            Net.close(fd);",
    "            result",
    "        }))",
    "",
    "pub let get (url: String): Result[Response, String] = request(\"GET\", url, [], \"\")",
    "",
    "pub let post (url: String) (body: String): Result[Response, String] = request(\"POST\", url, [], body)",
    "",
    "// --- HTTP server ---",
    "",
    "let http_parse_request_line (line: String): Result[RequestLine, String] = {",
    "    let parts = String.trim_end(line).split(\" \");",
    "    if parts.len() < 2 { Err(\"http server: malformed request line: \".concat(line)) }",
    "    else { Ok(RequestLine { method: parts[0], path: parts[1] }) }",
    "}",
    "",
    "// Same shape as `http_parse_head` above, just parsing a request's own",
    "// first line (`METHOD path HTTP/1.1`) instead of a response's status",
    "// line — everything past that (splitting headers from leftover body",
    "// bytes, `http_parse_headers`) is identical, reused unchanged.",
    "let http_parse_request_head (raw: String): Result[RequestHead, String] = {",
    "    let sep_index = match String.index_of(raw, \"\\r\\n\\r\\n\") { Some(i) => i, None => raw.len() };",
    "    let leftover_body = if sep_index + 4 <= raw.len() { String.slice(raw, sep_index + 4, raw.len()) } else { \"\" };",
    "    let lines = String.slice(raw, 0, sep_index).split(\"\\n\");",
    "    if lines.len() == 0 { Err(\"http server: empty request\") }",
    "    else { Result.map(http_parse_request_line(lines[0]), |rl| RequestHead {",
    "        method: rl.method,",
    "        path: rl.path,",
    "        headers: http_parse_headers(Array.drop(lines, 1)),",
    "        leftover_body: leftover_body,",
    "    }) }",
    "}",
    "",
    "// A small, fixed table covering the reason phrases any real client",
    "// actually looks at — not the full IANA registry. An unrecognized code",
    "// still produces a syntactically valid status line (`\"Unknown\"`), just",
    "// a less informative one; never a hard error, since the STATUS CODE",
    "// itself (not its phrase) is what every real HTTP client actually acts",
    "// on.",
    "let http_status_reason (code: Int): String = match code {",
    "    200 => \"OK\", 201 => \"Created\", 204 => \"No Content\",",
    "    301 => \"Moved Permanently\", 302 => \"Found\",",
    "    400 => \"Bad Request\", 401 => \"Unauthorized\", 403 => \"Forbidden\", 404 => \"Not Found\", 405 => \"Method Not Allowed\",",
    "    500 => \"Internal Server Error\", 501 => \"Not Implemented\", 502 => \"Bad Gateway\", 503 => \"Service Unavailable\",",
    "    _ => \"Unknown\",",
    "}",
    "",
    "// The wire-format inverse of `http_build_request` — unlike that",
    "// function, `Content-Length` is ALWAYS sent (even `0` for an empty",
    "// body), not just when the body is non-empty: a request omitting it",
    "// for a bodyless `GET` is common/idiomatic, but a SERVER leaving a",
    "// client to guess whether a response has a body at all is not.",
    "let http_response_to_wire (resp: Response): String = {",
    "    let extra_header_lines = Array.fold(resp.headers, \"\", |acc, h| acc.concat(h.name).concat(\": \").concat(h.value).concat(\"\\r\\n\"));",
    "    \"HTTP/1.1 \".concat(resp.status.to_string()).concat(\" \").concat(http_status_reason(resp.status)).concat(\"\\r\\n\")",
    "        .concat(\"Content-Length: \").concat(resp.body.len().to_string()).concat(\"\\r\\n\")",
    "        .concat(\"Connection: close\\r\\n\")",
    "        .concat(extra_header_lines)",
    "        .concat(\"\\r\\n\")",
    "        .concat(resp.body)",
    "}",
    "",
    "// Reads exactly one request off `conn`, runs `handler`, writes exactly",
    "// one response back — never touches `conn`'s own lifecycle (opening/",
    "// closing), that's `serve_once`/`http_serve_loop`'s job below, so",
    "// this stays testable on its own without a real listening socket",
    "// (any connected `fd` pair works, e.g. the SAME loopback-pair shape",
    "// `tcp_round_trip`'s own test already uses).",
    "let http_handle_connection (conn: Int) (handler: (Request) -> Response): Result[Unit, String] =",
    "    http_recv_headers_acc(conn, \"\")",
    "        |> Result.and_then(_, http_parse_request_head)",
    "        |> Result.and_then(_, |head| http_read_request_body(conn, head.headers, head.leftover_body) |> Result.and_then(_, |body| {",
    "            let request = Request { method: head.method, path: head.path, headers: head.headers, body: body };",
    "            let response = handler(request);",
    "            Result.map(Net.write(conn, http_response_to_wire(response)), |sent| ())",
    "        }))",
    "",
    "// Handles exactly ONE connection then returns — listens, accepts once,",
    "// closes both the connection and the listening socket, and gives back",
    "// whatever `http_handle_connection` produced. Real, useful on its own",
    "// (a one-shot server, or a test fixture — this is what THIS module's",
    "// own tests exercise directly), not just a building block for `http_",
    "// serve` below.",
    "pub let serve_once (port: Int) (handler: (Request) -> Response): Result[Unit, String] =",
    "    match Net.listen_on(port) {",
    "        Err(e) => Err(e),",
    "        Ok(server) => match Net.accept(server) {",
    "            Err(e) => { Net.close(server); Err(e) },",
    "            Ok(conn) => {",
    "                let result = http_handle_connection(conn, handler);",
    "                Net.close(conn);",
    "                Net.close(server);",
    "                result",
    "            },",
    "        },",
    "    }",
    "",
    "// The REAL long-running server: accept, hand the connection off to its",
    "// own task, repeat — forever. Concurrent by design: `spawn` puts each",
    "// connection's `http_handle_connection`/close on its own real OS",
    "// thread (see DESIGN.md's Concurrency section — \"OS threads first\")",
    "// so one slow client (a slow body, a slow handler) can't stall every",
    "// OTHER connection behind it the way a single sequential accept-loop",
    "// would. A single misbehaving/erroring connection does NOT bring the",
    "// server down (the spawned task's `Result` is deliberately never",
    "// joined, let alone matched — a bare discarded statement, same idiom",
    "// `println`'s own `write(1, s.as_cstr(), n);` already established for",
    "// a discarded non-`Unit` extern return) — only a hard failure to",
    "// ACCEPT (a real listener-level problem, not a per-connection one)",
    "// stops the loop, matching `Err` propagating out of `tcp_accept_",
    "// connection` itself.",
    "//",
    "// `handler` must be a plain top-level function or a closure that",
    "// captures NOTHING (both cross a `spawn` boundary equally, see",
    "// DESIGN.md's \"native-codegen zero-capture closure fix\" section) — a",
    "// closure that DOES capture live local state still can't cross: the",
    "// interpreter rejects it with a clear error at the `spawn` site, and",
    "// native codegen rejects it with a clean runtime abort (can't be",
    "// proven safe/unsafe at compile time — the same free-variable slot",
    "// could hold either shape depending on what's passed in).",
    "//",
    "// Deliberately not directly compile-and-run tested for the INFINITE-",
    "// LOOP shape itself (no `while`/loop-with-an-exit exists in this",
    "// language, and this function genuinely has none by design — a real",
    "// server keeps serving), same as before this change; what IS new here",
    "// (spawn-per-connection actually running two connections concurrently,",
    "// not serially) is covered by `http_serve_loop_handles_two_connections_",
    "// concurrently_not_serially` below.",
    "let http_serve_loop (server: Int) (handler: (Request) -> Response): Result[Unit, String] =",
    "    match Net.accept(server) {",
    "        Err(e) => Err(e),",
    "        Ok(conn) => {",
    "            spawn { http_handle_connection(conn, handler); Net.close(conn) };",
    "            http_serve_loop(server, handler)",
    "        },",
    "    }",
    "",
    "pub let serve (port: Int) (handler: (Request) -> Response): Result[Unit, String] =",
    "    match Net.listen_on(port) {",
    "        Err(e) => Err(e),",
    "        Ok(server) => http_serve_loop(server, handler),",
    "    }",
], "\n")

// --- The `Os` module ---
//
// Moved out of the prelude on 2026-08-27, one release after `Time`
// established the rule. `Os` names no type and nothing dispatches to
// it, so it was a module wearing a namespace's clothes -- but unlike
// `Time` it was reachable from every program already written, so the
// break was scheduled for its own release rather than slipped in
// beside the feature that revealed it.
let cg_os_src (): String = Array.join([
    "// Filesystem and self-location. These replaced shelling out to",
    "// `mktemp -d`, `rm -rf`, `rm -f`, `cp -r` and `mkdir`, and reading",
    "// `/proc/self/exe` -- see `native_stdlib/os_shim.c`.",
    "//",
    "// The `..._raw` forms are runtime primitives whose Plum bodies",
    "// exist only to give the checker a signature. They travel with the",
    "// module: `cg_runtime_fn` keys on the bare name and does not care",
    "// which module the call was written in.",
    "let os_temp_dir_raw (ignored: Bool): String = \"\"",
    "let os_self_exe_raw (ignored: Bool): String = \"\"",
    "let os_make_dir_raw (path: String): Int = 0",
    "let os_remove_file_raw (path: String): Int = 0",
    "let os_remove_tree_raw (path: String): Int = 0",
    "let os_copy_tree_raw (src: String) (dst: String): Int = 0",
    "let os_platform_raw (ignored: Bool): String = \"\"",
    "",
    "// Which platform this program is running on: \"linux\", \"macos\" or",
    "// \"windows\". Compiled in, not detected at runtime -- a binary",
    "// cannot move between platforms, so there is nothing to detect.",
    "pub let platform (): String = os_platform_raw(true)",
    "",
    "// A fresh, empty, private directory. The caller owns it and is",
    "// responsible for `Os.remove_tree` on it.",
    "pub let temp_dir (): Result[String, String] = {",
    "    let d = os_temp_dir_raw(true);",
    "    if String.is_empty(d) { Err(\"Os.temp_dir: could not create a temporary directory\") }",
    "    else { Ok(d) }",
    "}",
    "",
    "// The path of the running executable, for a program that needs to",
    "// re-invoke itself.",
    "pub let self_exe (): Result[String, String] = {",
    "    let p = os_self_exe_raw(true);",
    "    if String.is_empty(p) { Err(\"Os.self_exe: could not determine the executable path\") }",
    "    else { Ok(p) }",
    "}",
    "",
    "pub let make_dir (path: String): Result[Unit, String] =",
    "    if os_make_dir_raw(path) == 0 { Ok(()) }",
    "    else { Err(\"Os.make_dir: could not create \".concat(path)) }",
    "",
    "pub let remove_file (path: String): Result[Unit, String] =",
    "    if os_remove_file_raw(path) == 0 { Ok(()) }",
    "    else { Err(\"Os.remove_file: could not remove \".concat(path)) }",
    "",
    "// Deletes a directory and everything under it. Symlinks are removed,",
    "// never followed into.",
    "pub let remove_tree (path: String): Result[Unit, String] =",
    "    if os_remove_tree_raw(path) == 0 { Ok(()) }",
    "    else { Err(\"Os.remove_tree: could not remove \".concat(path)) }",
    "",
    "// Copies the CONTENTS of `src` into `dst`, which must already exist",
    "// -- the semantics of `cp -r src/. dst`. File modes are not",
    "// preserved.",
    "pub let copy_tree (src: String) (dst: String): Result[Unit, String] =",
    "    if os_copy_tree_raw(src, dst) == 0 { Ok(()) }",
    "    else { Err(\"Os.copy_tree: could not copy \".concat(src).concat(\" to \").concat(dst)) }",
    "",
    "// --- Environment and process ---",
    "//",
    "// Folded in from the flat prelude in 0.0.9. `Os` already owned the",
    "// filesystem calls that shell out to `os_shim.c`, so putting",
    "// `read_file` in a separate `Fs` would have split the filesystem",
    "// across two modules. This is the shape Go settled on -- `os.ReadFile`,",
    "// `os.Getenv`, `os.Exit`, `os.MkdirAll` in one place, with `net`",
    "// separate and string helpers on the type.",
    "",
    "let exit_raw (code: Int): Bool = false",
    "let env_var_raw (name: String): Array[String] = []",
    "",
    "// Exit with a status code, printing nothing. `panic_raw` also exits",
    "// non-zero but prints its message first, which is wrong when the",
    "// report has already been written.",
    "pub let exit_with (code: Int): Unit = { exit_raw(code); () }",
    "",
    "// `env_var_raw` returns an ARRAY, empty when unset, matching",
    "// `read_file_raw`: hand-written runtime IR cannot construct an",
    "// `Option` without hard-coding tag numbers the backend assigns per",
    "// program, so the wrapping happens here where `Some`/`None` are",
    "// ordinary variants.",
    "pub let env_var (name: String): Option[String] = {",
    "    let r = env_var_raw(name);",
    "    if Array.is_empty(r) { None } else { Some(r[0]) }",
    "}",
    "",
    "// --- Whole-file I/O ---",
    "",
    "let read_file_raw (path: String): Array[String] = []",
    "let write_file_raw (path: String) (contents: String): Bool = false",
    "",
    "pub let read_file (path: String): Result[String, String] = {",
    "    let r = read_file_raw(path);",
    "    if Array.is_empty(r) { Err(\"could not read \".concat(path)) } else { Ok(r[0]) }",
    "}",
    "",
    "pub let write_file (path: String) (contents: String): Result[Unit, String] =",
    "    if write_file_raw(path, contents) { Ok(()) } else { Err(\"could not write \".concat(path)) }",
    "",
    "// --- Running a program ---",
    "//",
    "// `process_run_raw` takes its arguments TAB-joined in a single string",
    "// because an extern boundary has no `Array[String]` -- see",
    "// `native_stdlib/process_shim.c`. The join happens here rather than in",
    "// the runtime, where it would have to be written in IR.",
    "",
    "let process_run_raw (program: String) (args_joined: String) (argc: Int): Int = 0",
    "let process_exit_code_raw (handle: Int): Int = 0",
    "let process_stdout_raw (handle: Int): String = \"\"",
    "let process_stderr_raw (handle: Int): String = \"\"",
    "let process_free_raw (handle: Int): Bool = false",
    "",
    "pub struct ProcessResult { pub exit_code: Int, pub stdout: String, pub stderr: String }",
    "",
    "// NO leading separator: `process_run` points argv[1] at the WHOLE",
    "// joined string, so a leading tab makes argv[1] empty and pushes the",
    "// last real argument past `argc`, silently dropping it. A plain fold",
    "// that prefixes every element is NOT equivalent.",
    "let join_args_acc (args: Array[String]) (i: Int) (acc: String): String =",
    "    if i >= args.len() { acc }",
    "    else if i == 0 { join_args_acc(args, i + 1, args[i]) }",
    "    else { join_args_acc(args, i + 1, acc.concat(\"\\t\").concat(args[i])) }",
    "",
    "// A non-zero exit code is an ordinary `Ok`. `Err` means the process",
    "// could not be started at all.",
    "pub let run_process (program: String) (args: Array[String]): Result[ProcessResult, String] = {",
    "    let joined = join_args_acc(args, 0, \"\");",
    "    let handle = process_run_raw(program, joined, args.len());",
    "    if handle < 0 { Err(\"Os.run_process: could not start process: \".concat(program)) }",
    "    else {",
    "        let result = ProcessResult {",
    "            exit_code: process_exit_code_raw(handle),",
    "            stdout: process_stdout_raw(handle),",
    "            stderr: process_stderr_raw(handle),",
    "        };",
    "        let freed = process_free_raw(handle);",
    "        Ok(result)",
    "    }",
    "}",
    "",
    "// --- Directory access ---",
    "//",
    "// `is_directory`'s three-way result is deliberate: a path that does",
    "// not exist is a real `Err`, not silently `Ok(false)`.",
    "",
    "let path_is_dir_raw (path: String): Int = 0",
    "let dir_open_handle (path: String): Int = 0",
    "let dir_next_entry (handle: Int): String = \"\"",
    "let dir_close_handle (handle: Int): Unit = ()",
    "",
    "let dir_read_all_acc (handle: Int) (acc: Array[String]): Array[String] = {",
    "    let name = dir_next_entry(handle);",
    "    if String.is_empty(name) { acc } else { dir_read_all_acc(handle, acc.push(name)) }",
    "}",
    "",
    "pub let list_dir (path: String): Result[Array[String], String] = {",
    "    let handle = dir_open_handle(path);",
    "    if handle < 0 { Err(\"Os.list_dir: could not open directory: \".concat(path)) }",
    "    else {",
    "        let entries = dir_read_all_acc(handle, []);",
    "        dir_close_handle(handle);",
    "        Ok(entries)",
    "    }",
    "}",
    "",
    "pub let is_directory (path: String): Result[Bool, String] = {",
    "    let r = path_is_dir_raw(path);",
    "    if r < 0 { Err(\"Os.is_directory: path does not exist: \".concat(path)) }",
    "    else { Ok(r == 1) }",
    "}",
], "\n")

// --- The `Time` module ---
//
// Written unqualified: inside the module these are `now`, `utc`,
// `rfc7231`, and the module stamp makes them `Time.now` and the rest
// at every call site.
let cg_time_src (): String = Array.join([
    "// The runtime primitive. Intercepted by `cg_runtime_fn`, which keys",
    "// on the bare name and so does not care that it now lives in a",
    "// module rather than in the prelude.",
    "let os_time_raw (ignored: Bool): Int = 0",
    "",
    "// Seconds since the Unix epoch, from the system clock.",
    "//",
    "// Seconds, and an `Int`, because that is what every platform's",
    "// `time()` agrees on. Anything richer -- a calendar date, a",
    "// timezone, a formatted string -- is a library on top of this and",
    "// not a runtime concern; the primitive is the part a program",
    "// cannot write for itself.",
    "pub let now (): Int = os_time_raw(true)",
    "",
    "// --- Calendars ---",
    "//",
    "// Everything below is ordinary Plum on top of `Time.now()`, which is",
    "// the line the 0.0.7 notes drew and this keeps: the CLOCK is the part",
    "// a program cannot write for itself, and the CALENDAR is arithmetic",
    "// anyone could write but nobody should have to. Porting a real CLI",
    "// produced 40 lines of `civil_from_days` in a program that wanted a",
    "// timestamp in a README, which is what moved it here.",
    "//",
    "// UTC only. A timezone database is a data-shipping problem, not an",
    "// arithmetic one, and Plum ships no data.",
    "",
    "// Floor division and modulo, which is NOT what `/` and `%` do: those",
    "// truncate toward zero, so `-1 / 86400` is `0` and the day before the",
    "// epoch would land in 1970. Every calendar function below needs the",
    "// floor, and dates before 1970 are real dates.",
    "let plum__floor_div (a: Int) (b: Int): Int = {",
    "    let q = a / b;",
    "    if a - q * b != 0 && (a < 0) != (b < 0) { q - 1 } else { q }",
    "}",
    "",
    "let plum__floor_mod (a: Int) (b: Int): Int = a - plum__floor_div(a, b) * b",
    "",
    "// A civil date and time, as UTC. `weekday` is 0 for Sunday.",
    "pub struct DateTime {",
    "    pub year: Int, pub month: Int, pub day: Int,",
    "    pub hour: Int, pub minute: Int, pub second: Int,",
    "    pub weekday: Int,",
    "}",
    "",
    "// Howard Hinnant's `civil_from_days`: exact for every date in the",
    "// proleptic Gregorian calendar, with no lookup table and no leap-year",
    "// special case. It shifts the year to start in March so the leap day",
    "// falls at the END of the cycle, which is what removes the special",
    "// case rather than hiding it.",
    "//",
    "// The inner divisions all operate on non-negative values, so plain `/`",
    "// is right there; only `era` can go negative and it uses the floor.",
    "pub let utc (epoch: Int): DateTime = {",
    "    let days = plum__floor_div(epoch, 86400);",
    "    let secs = plum__floor_mod(epoch, 86400);",
    "    let z = days + 719468;",
    "    let era = plum__floor_div(z, 146097);",
    "    let doe = z - era * 146097;",
    "    let yoe = (doe - doe / 1460 + doe / 36524 - doe / 146096) / 365;",
    "    let doy = doe - (365 * yoe + yoe / 4 - yoe / 100);",
    "    let mp = (5 * doy + 2) / 153;",
    "    let d = doy - (153 * mp + 2) / 5 + 1;",
    "    let m = if mp < 10 { mp + 3 } else { mp - 9 };",
    "    DateTime {",
    "        year: yoe + era * 400 + (if m <= 2 { 1 } else { 0 }),",
    "        month: m,",
    "        day: d,",
    "        hour: secs / 3600,",
    "        minute: secs / 60 - secs / 3600 * 60,",
    "        second: secs - secs / 60 * 60,",
    "        // 1970-01-01 was a Thursday, which is index 4.",
    "        weekday: plum__floor_mod(days + 4, 7),",
    "    }",
    "}",
    "",
    "pub let weekday_name (weekday: Int): String =",
    "    [\"Sun\", \"Mon\", \"Tue\", \"Wed\", \"Thu\", \"Fri\", \"Sat\"][plum__floor_mod(weekday, 7)]",
    "",
    "pub let month_name (month: Int): String =",
    "    [\"Jan\", \"Feb\", \"Mar\", \"Apr\", \"May\", \"Jun\", \"Jul\", \"Aug\", \"Sep\", \"Oct\", \"Nov\", \"Dec\"][plum__floor_mod(month - 1, 12)]",
    "",
    "let plum__two (n: Int): String = String.pad_left(n.to_string(), 2, \"0\")",
    "",
    "// `2026-08-27T01:40:28Z` -- ISO 8601, which is the one to reach for",
    "// when a machine reads it back or when it needs to sort as text.",
    "pub let iso8601 (epoch: Int): String = {",
    "    let t = utc(epoch);",
    "    let date = String.pad_left(t.year.to_string(), 4, \"0\").concat(\"-\").concat(plum__two(t.month)).concat(\"-\").concat(plum__two(t.day));",
    "    date.concat(\"T\").concat(plum__two(t.hour)).concat(\":\").concat(plum__two(t.minute)).concat(\":\").concat(plum__two(t.second)).concat(\"Z\")",
    "}",
    "",
    "// `Thu, 27 Aug 2026 01:40:28 GMT` -- the HTTP date format (RFC 7231),",
    "// which is what a `Last-Modified` header and a good many generated",
    "// files want.",
    "pub let rfc7231 (epoch: Int): String = {",
    "    let t = utc(epoch);",
    "    let head = weekday_name(t.weekday).concat(\", \").concat(plum__two(t.day)).concat(\" \").concat(month_name(t.month));",
    "    let time = plum__two(t.hour).concat(\":\").concat(plum__two(t.minute)).concat(\":\").concat(plum__two(t.second));",
    "    head.concat(\" \").concat(t.year.to_string()).concat(\" \").concat(time).concat(\" GMT\")",
    "}",
], "\n")
