// Standard-library MODULES -- source that is compiled into a program
// only when that program says `use <Name>;`.
//
// The prelude and a stdlib module answer two different questions.
// `Array.map` and `String.pad_left` have to be in the prelude, because
// `T.f(x)` IS the method-call mechanism: `xs.map(f)` is `Array.map(xs,
// f)`, so a type's namespace cannot be optional. `Time` has no
// receiver -- it names no type, and nothing dispatches to it -- so it
// is a module wearing a namespace's clothes, and it is spelled like
// one.
//
// (`Os` is in exactly the same position and has not moved. It is
// reachable from every program written so far, including this
// compiler, so that is a deliberate break to schedule rather than a
// tidy-up to slip in.)
//
// Gating on `use` is what makes the declaration LOAD-BEARING. Until
// now `use` was parsed and then ignored by every later stage -- module
// membership came entirely from the directory an item was found in, so
// `use shapes;` documented an intent the compiler never checked. A
// stdlib module has no directory to be found in, so `use Time;` is the
// only thing that can bring it in.

use lexer;
use parser;

// `needs` is the modules this one is written against. `Http` is
// ordinary Plum over `Net`'s sockets, so a program that says
// `use Http;` must get `Net` too whether it asked for it or not --
// otherwise the module's own body would reference something that was
// never injected, which is a compiler bug reported as a user error.
pub struct StdModule { pub name: String, pub source: String, pub needs: Array[String] }

// Every stdlib module, built from `parser.std_module_names` so the
// name list has exactly one home. A name with no source here is a
// compiler bug, not a user error, and says so.
pub let cg_std_modules (): Array[StdModule] =
    Array.map(parser.std_module_names(()), |n| StdModule { name: n, source: cg_std_source(n), needs: cg_std_needs(n) })

let cg_std_needs (name: String): Array[String] =
    // `Http` parses its URLs with `Url` rather than by hand, and `Url`
    // in turn needs `Encoding` -- which `cg_close_needs` closes over,
    // so this does not have to name it.
    if name == "Http" { ["Net", "Url"] }
    // `Url` percent-encodes and percent-decodes query values, and does
    // it by CALLING `Encoding` rather than carrying a second encoder --
    // the thing #26 was split out to avoid.
    else if name == "Url" { ["Encoding"] }
    // `Path` asks `Os.platform()` which separator to use.
    else if name == "Path" { ["Os"] }
    else { [] }

let cg_std_source (name: String): String =
    if name == "Time" { cg_time_src(()) }
    else if name == "Os" { cg_os_src(()) }
    else if name == "Net" { cg_net_src(()) }
    else if name == "Http" { cg_http_src(()) }
    else if name == "Process" { cg_process_src(()) }
    else if name == "Encoding" { cg_encoding_src(()) }
    else if name == "Url" { cg_url_src(()) }
    else if name == "Path" { cg_path_src(()) }
    else if name == "Json" { cg_json_src(()) }
    else { { cg_fail("no source for stdlib module ".concat(name)); "" } }

// The items a program's `use` declarations actually ask for, stamped
// with their module name the same way a directory would have stamped
// them.
pub let cg_std_items (user: Array[parser.ItemNode]): Array[parser.ItemNode] = {
    let mods = cg_std_modules(());
    let wanted = cg_close_needs(mods, cg_direct_uses(mods, user, 0, []), 0);
    cg_std_items_acc(mods, wanted, 0, [])
}

let cg_direct_uses (mods: Array[StdModule]) (user: Array[parser.ItemNode]) (i: Int) (acc: Array[String]): Array[String] =
    if i >= mods.len() { acc }
    else if cg_uses_module(user, mods[i].name, 0) { cg_direct_uses(mods, user, i + 1, acc.push(mods[i].name)) }
    else { cg_direct_uses(mods, user, i + 1, acc) }

// One pass per module is enough to close over `needs`: the graph is
// tiny and acyclic by construction, and a fixed number of passes over
// the whole list cannot miss a chain shorter than that list.
let cg_close_needs (mods: Array[StdModule]) (want: Array[String]) (round: Int): Array[String] =
    if round >= mods.len() { want }
    else { cg_close_needs(mods, cg_add_needs(mods, want, 0), round + 1) }

let cg_add_needs (mods: Array[StdModule]) (want: Array[String]) (i: Int): Array[String] =
    if i >= mods.len() { want }
    else if Array.contains(want, mods[i].name) { cg_add_needs(mods, cg_union(want, mods[i].needs, 0), i + 1) }
    else { cg_add_needs(mods, want, i + 1) }

let cg_union (into: Array[String]) (add: Array[String]) (i: Int): Array[String] =
    if i >= add.len() { into }
    else if Array.contains(into, add[i]) { cg_union(into, add, i + 1) }
    else { cg_union(into.push(add[i]), add, i + 1) }

// Emitted in `std_module_names` order, not in the order the program
// happened to `use` them, so the same program always produces the same
// IR regardless of how its imports were written.
let cg_std_items_acc (mods: Array[StdModule]) (want: Array[String]) (i: Int) (acc: Array[parser.ItemNode]): Array[parser.ItemNode] =
    if i >= mods.len() { acc }
    else if Array.contains(want, mods[i].name) {
        cg_std_items_acc(mods, want, i + 1, Array.concat(acc, cg_parse_std(mods[i].name, mods[i].source)))
    } else { cg_std_items_acc(mods, want, i + 1, acc) }

// `use Time;` and `use Time.rfc7231;` both count -- the second is the
// import-one-name form, and it names the same module.
let cg_uses_module (items: Array[parser.ItemNode]) (name: String) (i: Int): Bool =
    if i >= items.len() { false }
    else {
        match items[i].kind {
            IKUse(u) => if !Array.is_empty(u.path) && u.path[0] == name { true }
                        else { cg_uses_module(items, name, i + 1) },
            _ => cg_uses_module(items, name, i + 1),
        }
    }

// Parsed with its own source context, so an error inside a stdlib
// module quotes the module rather than whatever file was being read
// when it was pulled in.
let cg_parse_std (name: String) (src: String): Array[parser.ItemNode] = {
    let saved = parser.current_path(());
    let lexed = lexer.tokenize_spanned(src);
    parser.set_source_context("<".concat(name).concat(">"), src, lexed.starts, lexed.ends);
    let items = parser.with_module(parser.parse_program(lexed.tokens).items, name);
    parser.set_source_context(saved, "", [], []);
    items
}

// --- The `Net` module ---
//
// The six TCP calls, unprefixed: `tcp_connect_to` was named that way
// because it lived in a flat prelude and had nothing else to
// distinguish it. The module supplies the prefix now, so
// `Net.connect_to` says the same thing without saying "tcp" twice.
let cg_net_src (): String = Array.join([
    "// TCP sockets, over `native_stdlib/net_shim.c`. Plain `Result`",
    "// wrapping around a sentinel `-1`: a raw BSD sockets call crossing",
    "// the shim does not preserve an `errno`, so each failure carries a",
    "// fixed message saying WHAT failed rather than why.",
    "extern \"C\" {",
    "    fn tcp_connect(host: CStr, port: Int) -> Int;",
    "    fn tcp_listen(port: Int) -> Int;",
    "    fn tcp_accept(fd: Int) -> Int;",
    "    fn tcp_send(fd: Int, buf: CStr, len: Int) -> Int;",
    "    fn tcp_recv(fd: Int, max_len: Int) -> CStr;",
    "    fn tcp_recv_n(fd: Int, max_len: Int) -> Int;",
    "    fn tcp_recv_data() -> CStr;",
    "    fn tcp_close(fd: Int) -> Unit;",
    "}",
    "",
    "pub let connect_to (host: String) (port: Int): Result[Int, String] = unsafe {",
    "    let fd = tcp_connect(host.as_cstr(), port);",
    "    if fd < 0 { Err(\"Net.connect_to: could not connect to \".concat(host).concat(\":\").concat(port.to_string())) } else { Ok(fd) }",
    "}",
    "",
    "pub let listen_on (port: Int): Result[Int, String] = unsafe {",
    "    let fd = tcp_listen(port);",
    "    if fd < 0 { Err(\"Net.listen_on: could not listen on port \".concat(port.to_string())) } else { Ok(fd) }",
    "}",
    "",
    "pub let accept (fd: Int): Result[Int, String] = unsafe {",
    "    let client = tcp_accept(fd);",
    "    if client < 0 { Err(\"Net.accept: accept failed\") } else { Ok(client) }",
    "}",
    "",
    "// `len` MUST be bound BEFORE `.as_cstr()` runs. `.as_cstr()`",
    "// decrements the string's refcount to produce its copy and FREES",
    "// the original outright if that was the last reference -- exactly",
    "// what a direct `tcp_write(fd, \"hello\")` passes. Reading",
    "// `data.len()` afterwards in the same argument list is a real",
    "// use-after-free, and the real compiler found it the hard way:",
    "// garbage bytes trailing the content on an actual socket, observed",
    "// on the wire rather than theorized.",
    "pub let write (fd: Int) (data: String): Result[Int, String] = unsafe {",
    "    let len = data.len();",
    "    let n = tcp_send(fd, data.as_cstr(), len);",
    "    if n < 0 { Err(\"Net.write: send failed\") } else { Ok(n) }",
    "}",
    "",
    "// \"\" on BOTH a clean peer close and a hard socket error. The",
    "// distinction is not preserved in v1, and either way \"stop",
    "// reading\" is the right response -- which an empty String already",
    "// signals to a caller looping until end of stream.",
    "pub let read (fd: Int) (max_len: Int): String = unsafe { tcp_recv(fd, max_len).as_string() }",
    "",
    "// --- Binary-safe TCP ---",
    "//",
    "// `read`/`write` above keep their exact contracts and stay the",
    "// convenience for line-oriented protocols. These are the pair to",
    "// reach for when the payload is not text.",
    "//",
    "// `Net.read` cannot be made binary-safe without changing what it",
    "// means: it returns a `String`, which is a promise the bytes decode",
    "// as UTF-8, and arbitrary socket traffic does not keep it. The fix",
    "// is a function with a different RETURN TYPE, not a quieter version",
    "// of this one.",
    "",
    "// Three outcomes, and the middle one is why this exists as a",
    "// `Result[Bytes, _]` rather than just `Bytes`:",
    "//",
    "//   Ok(bytes)  with a non-empty buffer -- data",
    "//   Ok(empty)  the peer closed cleanly -- end of stream",
    "//   Err(..)    a real socket error",
    "//",
    "// `Net.read` collapses the last two into `\"\"`, a documented v1",
    "// trade that a text protocol can live with because either answer",
    "// means \"stop reading\". A length-framed binary protocol cannot: an",
    "// empty read mid-stream is an ordinary event, and telling it from a",
    "// dropped connection is the difference between waiting and failing.",
    "// `tcp_recv_n` returns a count and keeps the two apart.",
    "pub let read_bytes (fd: Int) (max_len: Int): Result[Bytes, String] = unsafe {",
    "    let n = tcp_recv_n(fd, max_len);",
    "    if n < 0 { Err(\"Net.read_bytes: recv failed\") }",
    "    else { Ok(Bytes.from_cstr(tcp_recv_data(), n)) }",
    "}",
    "",
    "// `len` MUST be bound BEFORE `.as_cstr()` runs, for the same reason",
    "// `write` above spells that out: the pointer is an interior one into",
    "// the cell, and reading `.len()` afterwards in the same argument",
    "// list is how that bug was found on the wire the first time.",
    "//",
    "// Binary-safe because `tcp_send` takes an explicit length and never",
    "// calls `strlen` -- a NUL in the buffer is just another byte.",
    "pub let write_bytes (fd: Int) (data: Bytes): Result[Int, String] = unsafe {",
    "    let len = data.len();",
    "    let n = tcp_send(fd, data.as_cstr(), len);",
    "    if n < 0 { Err(\"Net.write_bytes: send failed\") } else { Ok(n) }",
    "}",
    "",
    "pub let close (fd: Int): Unit = unsafe { tcp_close(fd); () }",
    "",
], "\n")

// --- The `Http` module ---
//
// Ordinary Plum over `Net`, with no IR, backend or extern surface of
// its own -- which is exactly why it is a SEPARATE module rather than
// more of `Net`. It is also the reason `StdModule` grew a `needs`
// field: `use Http;` has to pull `Net` in, because this source calls
// `Net.connect_to` and would otherwise reference a module the program
// never asked for.
//
// The structs lost their `Http` prefix along with the functions --
// `Http.Response`, not `Http.HttpResponse` -- and gained `pub`, which
// they never had and never needed while everything shared one flat
// namespace.
let cg_http_src (): String = Array.join([
    // --- HTTP client and server ---
    //
    // Ported from the real compiler's `STDLIB_HTTP_SRC` on 2026-08-21,
    // VERBATIM: it is ordinary Plum built on the TCP layer above, with
    // no IR, backend or extern surface of its own. That was the point
    // of building TCP first, and it is what made this port a
    // transcription rather than a reimplementation.
    //
    // Two lines were NOT verbatim on the day of the port -- the two
    // `Result.and_then(_, http_parse_head)` references, which had to be
    // eta-expanded by hand because this compiler had no
    // function-as-value support. That gap is closed, and the source
    // matches the real prelude line for line again.
    "pub struct Header { pub name: String, pub value: String }",
    "pub struct Response { pub status: Int, pub headers: Array[Header], pub body: String }",
    "pub struct Head { pub status: Int, pub headers: Array[Header], pub leftover_body: String }",
    "pub struct Request { pub method: String, pub path: String, pub headers: Array[Header], pub body: String }",
    "pub struct RequestLine { pub method: String, pub path: String }",
    "pub struct RequestHead { pub method: String, pub path: String, pub headers: Array[Header], pub leftover_body: String }",
    "",
    "// URL parsing lives in `Url` now; this only decides which URLs an",
    "// HTTP CLIENT is willing to act on, which is a different question",
    "// and the only part that ever belonged here.",
    "//",
    "// The two rejection messages are unchanged, deliberately: they are",
    "// what a user sees and what `bootstrap/net-smoke` asserts. What did",
    "// change is that a URL this client cannot USE is now told apart from",
    "// a URL that is not well-formed -- `nope://h/x` parses fine and is",
    "// refused for its scheme, while `h/x` is refused for having none,",
    "// and those used to be the same message.",
    "//",
    "// `https` is checked BEFORE the general scheme test so it keeps its",
    "// specific answer: it is a URL this client will support later, not",
    "// one it will never accept. See #22.",
    "let http_parse_url (url: String): Result[Url.Url, String] =",
    "    match Url.parse(url) {",
    "        Err(e) => Err(\"http client: \".concat(e)),",
    "        Ok(u) =>",
    "            if u.scheme == \"https\" { Err(\"http client: https:// is not supported yet\") }",
    "            else if u.scheme != \"http\" { Err(\"http client: url must start with http://\") }",
    "            else { Ok(u) },",
    "    }",
    "",
    "let http_build_request (method: String) (parsed: Url.Url) (headers: Array[Header]) (body: String): String = {",
    "    let extra_header_lines = Array.fold(headers, \"\", |acc, h| acc.concat(h.name).concat(\": \").concat(h.value).concat(\"\\r\\n\"));",
    "    let content_length_line = if String.is_empty(body) { \"\" } else { \"Content-Length: \".concat(body.len().to_string()).concat(\"\\r\\n\") };",
    "    method.concat(\" \").concat(Url.request_target(parsed)).concat(\" HTTP/1.1\\r\\n\")",
    "        .concat(\"Host: \").concat(Url.authority(parsed)).concat(\"\\r\\n\")",
    "        .concat(\"Connection: close\\r\\n\")",
    "        .concat(content_length_line)",
    "        .concat(extra_header_lines)",
    "        .concat(\"\\r\\n\")",
    "        .concat(body)",
    "}",
    "",
    "// Reads (and accumulates) until the blank-line header/body separator",
    "// has actually arrived — it may take more than one `tcp_read` call to",
    "// see it at all, and a single `tcp_read` may ALSO return part of the",
    "// body past it in the same chunk (`http_parse_head` below splits that",
    "// back out). An empty read here means the peer closed before the",
    "// headers even finished, always a real error, never a legitimate",
    "// empty response.",
    "let http_recv_headers_acc (fd: Int) (acc: String): Result[String, String] =",
    "    match String.index_of(acc, \"\\r\\n\\r\\n\") {",
    "        Some(_) => Ok(acc),",
    "        None => {",
    "            let chunk = Net.read(fd, 4096);",
    "            if String.is_empty(chunk) { Err(\"http client: connection closed before the response headers were complete\") }",
    "            else { http_recv_headers_acc(fd, acc.concat(chunk)) }",
    "        },",
    "    }",
    "",
    "let http_parse_status_line (line: String): Result[Int, String] = {",
    "    let parts = String.trim_end(line).split(\" \");",
    "    if parts.len() < 2 { Err(\"http client: malformed status line: \".concat(line)) }",
    "    else { match String.parse_int(parts[1]) {",
    "        Err(e) => Err(\"http client: malformed status code: \".concat(e)),",
    "        Ok(code) => Ok(code),",
    "    } }",
    "}",
    "",
    "let http_parse_header_line (line: String): Option[Header] =",
    "    match String.index_of(line, \": \") {",
    "        None => None,",
    "        Some(i) => Some(Header { name: String.slice(line, 0, i), value: String.trim_end(String.slice(line, i + 2, line.len())) }),",
    "    }",
    "",
    "let http_parse_headers (lines: Array[String]): Array[Header] =",
    "    Array.fold(lines, [], |acc, line| match http_parse_header_line(line) {",
    "        None => acc,",
    "        Some(h) => acc.push(h),",
    "    })",
    "",
    "let http_find_header (headers: Array[Header]) (name: String): Option[String] =",
    "    Option.map(Array.find(headers, |h| h.name == name), |h| h.value)",
    "",
    "// Splits the raw, already-fully-received header block (see `http_recv_",
    "// headers_acc` above) into the parsed status/headers plus whatever body",
    "// bytes rode along in the same read.",
    "let http_parse_head (raw: String): Result[Head, String] = {",
    "    let sep_index = match String.index_of(raw, \"\\r\\n\\r\\n\") { Some(i) => i, None => raw.len() };",
    "    let leftover_body = if sep_index + 4 <= raw.len() { String.slice(raw, sep_index + 4, raw.len()) } else { \"\" };",
    "    let lines = String.slice(raw, 0, sep_index).split(\"\\n\");",
    "    if lines.len() == 0 { Err(\"http client: empty response\") }",
    "    else { Result.map(http_parse_status_line(lines[0]), |status| Head {",
    "        status: status,",
    "        headers: http_parse_headers(Array.drop(lines, 1)),",
    "        leftover_body: leftover_body,",
    "    }) }",
    "}",
    "",
    "let http_recv_body_by_length_acc (fd: Int) (acc: String) (remaining: Int): Result[String, String] =",
    "    if remaining <= 0 { Ok(acc) }",
    "    else {",
    "        let chunk = Net.read(fd, remaining);",
    "        if String.is_empty(chunk) { Err(\"http client: connection closed before the full response body was received\") }",
    "        else { http_recv_body_by_length_acc(fd, acc.concat(chunk), remaining - chunk.len()) }",
    "    }",
    "",
    "let http_recv_body_until_close_acc (fd: Int) (acc: String): String = {",
    "    let chunk = Net.read(fd, 4096);",
    "    if String.is_empty(chunk) { acc } else { http_recv_body_until_close_acc(fd, acc.concat(chunk)) }",
    "}",
    "",
    "// Takes `headers`/`leftover_body` directly (not a whole `Head`) —",
    "// but, UNLIKE the rest of this module's shared parsing helpers, this",
    "// one is response-side ONLY, not reused for requests (see `http_read_",
    "// request_body` below for why the two genuinely differ, not just a",
    "// convenience split).",
    "let http_read_body (fd: Int) (headers: Array[Header]) (leftover_body: String): Result[String, String] =",
    "    match http_find_header(headers, \"Content-Length\") {",
    "        Some(cl) => match String.parse_int(cl) {",
    "            Err(e) => Err(\"http: invalid Content-Length header: \".concat(e)),",
    "            Ok(content_length) => http_recv_body_by_length_acc(fd, leftover_body, content_length - leftover_body.len()),",
    "        },",
    "        None => match http_find_header(headers, \"Transfer-Encoding\") {",
    "            Some(te) => Err(\"http: Transfer-Encoding (\".concat(te).concat(\") is not supported yet\")),",
    "            None => Ok(http_recv_body_until_close_acc(fd, leftover_body)),",
    "        },",
    "    }",
    "",
    "// The REQUEST-side sibling of `http_read_body` above — same `Content-",
    "// Length`/`Transfer-Encoding` handling, but a DELIBERATELY different",
    "// answer when NEITHER is present: an EMPTY body (`leftover_body` as-",
    "// is), never \"read until the connection closes.\" Originally shared",
    "// `http_read_body` directly for both — a real, live DEADLOCK surfaced",
    "// exactly that assumption was wrong, not just imprecise: a bodyless",
    "// `GET` (no `Content-Length`, since there's no body to measure) has no",
    "// reason to ever close its OWN write side, so a server blocked",
    "// \"reading until close\" on it hangs forever waiting for a body that",
    "// will never arrive — confirmed directly (a real test hung against a",
    "// real socket, root-caused by isolating each step with `println`",
    "// debugging until the exact hang site was found), not merely",
    "// theorized. The response side's OWN \"no length header -> read until",
    "// close\" answer stays correct on ITS side: every request this client",
    "// sends already includes `Connection: close`, so that read is bounded",
    "// by the SERVER eventually closing once it's done writing — a",
    "// guarantee nothing analogous exists for on the request side.",
    "let http_read_request_body (fd: Int) (headers: Array[Header]) (leftover_body: String): Result[String, String] =",
    "    match http_find_header(headers, \"Content-Length\") {",
    "        Some(cl) => match String.parse_int(cl) {",
    "            Err(e) => Err(\"http: invalid Content-Length header: \".concat(e)),",
    "            Ok(content_length) => http_recv_body_by_length_acc(fd, leftover_body, content_length - leftover_body.len()),",
    "        },",
    "        None => match http_find_header(headers, \"Transfer-Encoding\") {",
    "            Some(te) => Err(\"http: Transfer-Encoding (\".concat(te).concat(\") is not supported yet\")),",
    "            None => Ok(leftover_body),",
    "        },",
    "    }",
    "",
    "// Pipe + `Result.and_then`/`Result.map`, not nested `match` — a",
    "// deliberate house-style adoption (see DESIGN.md's own \"?/early-return",
    "// sugar\" section for the full writeup: real `?`-style early return",
    "// would need a language feature Plum doesn't have at all, `return`,",
    "// plus a `From`-style error-conversion mechanism the closed trait set",
    "// has no room for — this gets most of the real readability benefit",
    "// today, for free, confirmed by rewriting this exact chain both ways",
    "// and running BOTH against the real shipped counterpart before",
    "// choosing this one). `|ignored| ..` discards `tcp_write`'s own `Int`",
    "// (bytes-written count) — the next step doesn't need it, only that the",
    "// write succeeded at all.",
    "let http_do_request (fd: Int) (method: String) (parsed: Url.Url) (headers: Array[Header]) (body: String): Result[Response, String] =",
    "    Net.write(fd, http_build_request(method, parsed, headers, body))",
    "        |> Result.and_then(_, |ignored| http_recv_headers_acc(fd, \"\"))",
    "        |> Result.and_then(_, http_parse_head)",
    "        |> Result.and_then(_, |head| Result.map(http_read_body(fd, head.headers, head.leftover_body), |response_body| Response { status: head.status, headers: head.headers, body: response_body }))",
    "",
    "// `fd` has to stay reachable for the FINAL cleanup step regardless of",
    "// `http_do_request`'s own outcome — closure capture (`fd` bound by the",
    "// outer `and_then`, still in scope in the block passed to the inner",
    "// one) does this without needing the old two-armed \"close then re-wrap",
    "// Ok/Err separately\" match at all.",
    "pub let request (method: String) (url: String) (headers: Array[Header]) (body: String): Result[Response, String] =",
    "    http_parse_url(url)",
    "        |> Result.and_then(_, |parsed| Net.connect_to(parsed.host, parsed.port) |> Result.and_then(_, |fd| {",
    "            let result = http_do_request(fd, method, parsed, headers, body);",
    "            Net.close(fd);",
    "            result",
    "        }))",
    "",
    "pub let get (url: String): Result[Response, String] = request(\"GET\", url, [], \"\")",
    "",
    "pub let post (url: String) (body: String): Result[Response, String] = request(\"POST\", url, [], body)",
    "",
    "// --- HTTP server ---",
    "",
    "let http_parse_request_line (line: String): Result[RequestLine, String] = {",
    "    let parts = String.trim_end(line).split(\" \");",
    "    if parts.len() < 2 { Err(\"http server: malformed request line: \".concat(line)) }",
    "    else { Ok(RequestLine { method: parts[0], path: parts[1] }) }",
    "}",
    "",
    "// Same shape as `http_parse_head` above, just parsing a request's own",
    "// first line (`METHOD path HTTP/1.1`) instead of a response's status",
    "// line — everything past that (splitting headers from leftover body",
    "// bytes, `http_parse_headers`) is identical, reused unchanged.",
    "let http_parse_request_head (raw: String): Result[RequestHead, String] = {",
    "    let sep_index = match String.index_of(raw, \"\\r\\n\\r\\n\") { Some(i) => i, None => raw.len() };",
    "    let leftover_body = if sep_index + 4 <= raw.len() { String.slice(raw, sep_index + 4, raw.len()) } else { \"\" };",
    "    let lines = String.slice(raw, 0, sep_index).split(\"\\n\");",
    "    if lines.len() == 0 { Err(\"http server: empty request\") }",
    "    else { Result.map(http_parse_request_line(lines[0]), |rl| RequestHead {",
    "        method: rl.method,",
    "        path: rl.path,",
    "        headers: http_parse_headers(Array.drop(lines, 1)),",
    "        leftover_body: leftover_body,",
    "    }) }",
    "}",
    "",
    "// A small, fixed table covering the reason phrases any real client",
    "// actually looks at — not the full IANA registry. An unrecognized code",
    "// still produces a syntactically valid status line (`\"Unknown\"`), just",
    "// a less informative one; never a hard error, since the STATUS CODE",
    "// itself (not its phrase) is what every real HTTP client actually acts",
    "// on.",
    "let http_status_reason (code: Int): String = match code {",
    "    200 => \"OK\", 201 => \"Created\", 204 => \"No Content\",",
    "    301 => \"Moved Permanently\", 302 => \"Found\",",
    "    400 => \"Bad Request\", 401 => \"Unauthorized\", 403 => \"Forbidden\", 404 => \"Not Found\", 405 => \"Method Not Allowed\",",
    "    500 => \"Internal Server Error\", 501 => \"Not Implemented\", 502 => \"Bad Gateway\", 503 => \"Service Unavailable\",",
    "    _ => \"Unknown\",",
    "}",
    "",
    "// The wire-format inverse of `http_build_request` — unlike that",
    "// function, `Content-Length` is ALWAYS sent (even `0` for an empty",
    "// body), not just when the body is non-empty: a request omitting it",
    "// for a bodyless `GET` is common/idiomatic, but a SERVER leaving a",
    "// client to guess whether a response has a body at all is not.",
    "let http_response_to_wire (resp: Response): String = {",
    "    let extra_header_lines = Array.fold(resp.headers, \"\", |acc, h| acc.concat(h.name).concat(\": \").concat(h.value).concat(\"\\r\\n\"));",
    "    \"HTTP/1.1 \".concat(resp.status.to_string()).concat(\" \").concat(http_status_reason(resp.status)).concat(\"\\r\\n\")",
    "        .concat(\"Content-Length: \").concat(resp.body.len().to_string()).concat(\"\\r\\n\")",
    "        .concat(\"Connection: close\\r\\n\")",
    "        .concat(extra_header_lines)",
    "        .concat(\"\\r\\n\")",
    "        .concat(resp.body)",
    "}",
    "",
    "// Reads exactly one request off `conn`, runs `handler`, writes exactly",
    "// one response back — never touches `conn`'s own lifecycle (opening/",
    "// closing), that's `serve_once`/`http_serve_loop`'s job below, so",
    "// this stays testable on its own without a real listening socket",
    "// (any connected `fd` pair works, e.g. the SAME loopback-pair shape",
    "// `tcp_round_trip`'s own test already uses).",
    "let http_handle_connection (conn: Int) (handler: (Request) -> Response): Result[Unit, String] =",
    "    http_recv_headers_acc(conn, \"\")",
    "        |> Result.and_then(_, http_parse_request_head)",
    "        |> Result.and_then(_, |head| http_read_request_body(conn, head.headers, head.leftover_body) |> Result.and_then(_, |body| {",
    "            let request = Request { method: head.method, path: head.path, headers: head.headers, body: body };",
    "            let response = handler(request);",
    "            Result.map(Net.write(conn, http_response_to_wire(response)), |sent| ())",
    "        }))",
    "",
    "// Handles exactly ONE connection then returns — listens, accepts once,",
    "// closes both the connection and the listening socket, and gives back",
    "// whatever `http_handle_connection` produced. Real, useful on its own",
    "// (a one-shot server, or a test fixture — this is what THIS module's",
    "// own tests exercise directly), not just a building block for `http_",
    "// serve` below.",
    "pub let serve_once (port: Int) (handler: (Request) -> Response): Result[Unit, String] =",
    "    match Net.listen_on(port) {",
    "        Err(e) => Err(e),",
    "        Ok(server) => match Net.accept(server) {",
    "            Err(e) => { Net.close(server); Err(e) },",
    "            Ok(conn) => {",
    "                let result = http_handle_connection(conn, handler);",
    "                Net.close(conn);",
    "                Net.close(server);",
    "                result",
    "            },",
    "        },",
    "    }",
    "",
    "// The REAL long-running server: accept, hand the connection off to its",
    "// own task, repeat — forever. Concurrent by design: `spawn` puts each",
    "// connection's `http_handle_connection`/close on its own real OS",
    "// thread (see DESIGN.md's Concurrency section — \"OS threads first\")",
    "// so one slow client (a slow body, a slow handler) can't stall every",
    "// OTHER connection behind it the way a single sequential accept-loop",
    "// would. A single misbehaving/erroring connection does NOT bring the",
    "// server down (the spawned task's `Result` is deliberately never",
    "// joined, let alone matched — a bare discarded statement, same idiom",
    "// `println`'s own `write(1, s.as_cstr(), n);` already established for",
    "// a discarded non-`Unit` extern return) — only a hard failure to",
    "// ACCEPT (a real listener-level problem, not a per-connection one)",
    "// stops the loop, matching `Err` propagating out of `tcp_accept_",
    "// connection` itself.",
    "//",
    "// `handler` must be a plain top-level function or a closure that",
    "// captures NOTHING (both cross a `spawn` boundary equally, see",
    "// DESIGN.md's \"native-codegen zero-capture closure fix\" section) — a",
    "// closure that DOES capture live local state still can't cross: the",
    "// interpreter rejects it with a clear error at the `spawn` site, and",
    "// native codegen rejects it with a clean runtime abort (can't be",
    "// proven safe/unsafe at compile time — the same free-variable slot",
    "// could hold either shape depending on what's passed in).",
    "//",
    "// Deliberately not directly compile-and-run tested for the INFINITE-",
    "// LOOP shape itself (no `while`/loop-with-an-exit exists in this",
    "// language, and this function genuinely has none by design — a real",
    "// server keeps serving), same as before this change; what IS new here",
    "// (spawn-per-connection actually running two connections concurrently,",
    "// not serially) is covered by `http_serve_loop_handles_two_connections_",
    "// concurrently_not_serially` below.",
    "let http_serve_loop (server: Int) (handler: (Request) -> Response): Result[Unit, String] =",
    "    match Net.accept(server) {",
    "        Err(e) => Err(e),",
    "        Ok(conn) => {",
    "            spawn { http_handle_connection(conn, handler); Net.close(conn) };",
    "            http_serve_loop(server, handler)",
    "        },",
    "    }",
    "",
    "pub let serve (port: Int) (handler: (Request) -> Response): Result[Unit, String] =",
    "    match Net.listen_on(port) {",
    "        Err(e) => Err(e),",
    "        Ok(server) => http_serve_loop(server, handler),",
    "    }",
], "\n")

// --- The `Os` module ---
//
// Moved out of the prelude on 2026-08-27, one release after `Time`
// established the rule. `Os` names no type and nothing dispatches to
// it, so it was a module wearing a namespace's clothes -- but unlike
// `Time` it was reachable from every program already written, so the
// break was scheduled for its own release rather than slipped in
// beside the feature that revealed it.
let cg_os_src (): String = Array.join([
    "// Filesystem and self-location. These replaced shelling out to",
    "// `mktemp -d`, `rm -rf`, `rm -f`, `cp -r` and `mkdir`, and reading",
    "// `/proc/self/exe` -- see `native_stdlib/os_shim.c`.",
    "//",
    "// The `..._raw` forms are runtime primitives whose Plum bodies",
    "// exist only to give the checker a signature. They travel with the",
    "// module: `cg_runtime_fn` keys on the bare name and does not care",
    "// which module the call was written in.",
    "let os_temp_dir_raw (ignored: Bool): String = \"\"",
    "let os_self_exe_raw (ignored: Bool): String = \"\"",
    "let os_make_dir_raw (path: String): Int = 0",
    "let os_remove_file_raw (path: String): Int = 0",
    "let os_rename_file_raw (from: String) (to: String): Int = 0",
    "let os_remove_tree_raw (path: String): Int = 0",
    "let os_copy_tree_raw (src: String) (dst: String): Int = 0",
    "let os_platform_raw (ignored: Bool): String = \"\"",
    "",
    "// Which platform this program is running on: \"linux\", \"macos\" or",
    "// \"windows\". Compiled in, not detected at runtime -- a binary",
    "// cannot move between platforms, so there is nothing to detect.",
    "pub let platform (): String = os_platform_raw(true)",
    "",
    "// A fresh, empty, private directory. The caller owns it and is",
    "// responsible for `Os.remove_tree` on it.",
    "pub let temp_dir (): Result[String, String] = {",
    "    let d = os_temp_dir_raw(true);",
    "    if String.is_empty(d) { Err(\"Os.temp_dir: could not create a temporary directory\") }",
    "    else { Ok(d) }",
    "}",
    "",
    "// The path of the running executable, for a program that needs to",
    "// re-invoke itself.",
    "pub let self_exe (): Result[String, String] = {",
    "    let p = os_self_exe_raw(true);",
    "    if String.is_empty(p) { Err(\"Os.self_exe: could not determine the executable path\") }",
    "    else { Ok(p) }",
    "}",
    "",
    "pub let make_dir (path: String): Result[Unit, String] =",
    "    if os_make_dir_raw(path) == 0 { Ok(()) }",
    "    else { Err(\"Os.make_dir: could not create \".concat(path)) }",
    "",
    "// Atomic within one filesystem, and an error rather than a silent",
    "// copy across two. The point is that the destination is never a",
    "// half-written file.",
    "pub let rename_file (from: String) (to: String): Result[Unit, String] =",
    "    if os_rename_file_raw(from, to) == 0 { Ok(()) }",
    "    else { Err(\"Os.rename_file: could not rename \".concat(from).concat(\" to \").concat(to)) }",
    "",
    "pub let remove_file (path: String): Result[Unit, String] =",
    "    if os_remove_file_raw(path) == 0 { Ok(()) }",
    "    else { Err(\"Os.remove_file: could not remove \".concat(path)) }",
    "",
    "// Deletes a directory and everything under it. Symlinks are removed,",
    "// never followed into.",
    "pub let remove_tree (path: String): Result[Unit, String] =",
    "    if os_remove_tree_raw(path) == 0 { Ok(()) }",
    "    else { Err(\"Os.remove_tree: could not remove \".concat(path)) }",
    "",
    "// Copies the CONTENTS of `src` into `dst`, which must already exist",
    "// -- the semantics of `cp -r src/. dst`. File modes are not",
    "// preserved.",
    "pub let copy_tree (src: String) (dst: String): Result[Unit, String] =",
    "    if os_copy_tree_raw(src, dst) == 0 { Ok(()) }",
    "    else { Err(\"Os.copy_tree: could not copy \".concat(src).concat(\" to \").concat(dst)) }",
    "",
    "// --- Environment and process ---",
    "//",
    "// Folded in from the flat prelude in 0.0.9. `Os` already owned the",
    "// filesystem calls that shell out to `os_shim.c`, so putting",
    "// `read_file` in a separate `Fs` would have split the filesystem",
    "// across two modules. This is the shape Go settled on -- `os.ReadFile`,",
    "// `os.Getenv`, `os.Exit`, `os.MkdirAll` in one place, with `net`",
    "// separate and string helpers on the type.",
    "",
    "let exit_raw (code: Int): Bool = false",
    "let env_var_raw (name: String): Array[String] = []",
    "",
    "// Exit with a status code, printing nothing. `panic_raw` also exits",
    "// non-zero but prints its message first, which is wrong when the",
    "// report has already been written.",
    "pub let exit_with (code: Int): Unit = { exit_raw(code); () }",
    "",
    "// `env_var_raw` returns an ARRAY, empty when unset, matching",
    "// `read_file_raw`: hand-written runtime IR cannot construct an",
    "// `Option` without hard-coding tag numbers the backend assigns per",
    "// program, so the wrapping happens here where `Some`/`None` are",
    "// ordinary variants.",
    "pub let env_var (name: String): Option[String] = {",
    "    let r = env_var_raw(name);",
    "    if Array.is_empty(r) { None } else { Some(r[0]) }",
    "}",
    "",
    "// --- Whole-file I/O ---",
    "",
    "let read_file_raw (path: String): Array[String] = []",
    "let write_file_raw (path: String) (contents: String): Bool = false",
    "",
    "pub let read_file (path: String): Result[String, String] = {",
    "    let r = read_file_raw(path);",
    "    if Array.is_empty(r) { Err(\"could not read \".concat(path)) } else { Ok(r[0]) }",
    "}",
    "",
    "pub let write_file (path: String) (contents: String): Result[Unit, String] =",
    "    if write_file_raw(path, contents) { Ok(()) } else { Err(\"could not write \".concat(path)) }",
    "",
    "// --- Whole-file BINARY I/O ---",
    "//",
    "// The `String` pair above keeps its contract exactly: it is the text",
    "// convenience, and a program that wants text should keep using it.",
    "// These are for the payloads a `String` cannot honestly describe --",
    "// images, compressed data, anything with an embedded NUL or a byte",
    "// that is not valid UTF-8.",
    "//",
    "// The runtime half needed almost nothing: `read_file_raw` already",
    "// reads with `fread` and the file's real size, and `write_file_raw`",
    "// already writes with `fwrite` and the cell's stored length, so",
    "// neither has ever stopped at a NUL. What was missing was a TYPE",
    "// that promised as much -- `Os.read_file` returning a `String` is a",
    "// claim about encoding that a JPEG does not satisfy -- and",
    "// byte-indexed operations to do anything with the result.",
    "//",
    "// `read_file_bytes_raw` returns an ARRAY for the same reason its",
    "// String twin does: hand-written runtime IR cannot construct a",
    "// `Result` without hard-coding tag numbers the backend assigns per",
    "// program, so the wrapping happens here.",
    "let read_file_bytes_raw (path: String): Array[Bytes] = []",
    "let write_file_bytes_raw (path: String) (contents: Bytes): Bool = false",
    "let append_file_bytes_raw (path: String) (contents: Bytes): Bool = false",
    "",
    "// An empty file reads back as empty `Bytes`, NOT as an error -- the",
    "// array is empty only when the file could not be opened at all, so",
    "// \"no such file\" and \"a file with nothing in it\" stay distinct.",
    "pub let read_bytes (path: String): Result[Bytes, String] = {",
    "    let r = read_file_bytes_raw(path);",
    "    if Array.is_empty(r) { Err(\"could not read \".concat(path)) } else { Ok(r[0]) }",
    "}",
    "",
    "pub let write_bytes (path: String) (data: Bytes): Result[Unit, String] =",
    "    if write_file_bytes_raw(path, data) { Ok(()) } else { Err(\"could not write \".concat(path)) }",
    "",
    "// Creates the file when it does not exist, the way `>>` does.",
    "pub let append_bytes (path: String) (data: Bytes): Result[Unit, String] =",
    "    if append_file_bytes_raw(path, data) { Ok(()) } else { Err(\"could not append to \".concat(path)) }",
    "",
    "// --- Streaming file I/O ---",
    "//",
    "// The whole-file calls above are the convenience: one call, no",
    "// handle, no cleanup to think about. These are for the cases a",
    "// whole-file read cannot serve -- a file too big to hold, a stream",
    "// consumed as it arrives, an append-only log kept open.",
    "//",
    "// `File` is a `handle` (issue #9), so an open file CLOSES ITSELF",
    "// when the value dies. `File.close` is still offered, and still",
    "// returns a `Result`, because closing can fail -- a buffered write",
    "// is flushed by `fclose`, and that is exactly when a full disk is",
    "// discovered. So: call `close` when the error matters, and rely on",
    "// the handle when it does not. Neither leaks.",
    "//",
    "// Closing twice is fine and is the NORMAL path, since the handle",
    "// runs after an explicit close. `native_stdlib/file_shim.c` owns a",
    "// slot table precisely so the second one is harmless.",
    "extern \"C\" {",
    "    fn file_open(path: CStr, mode: Int) -> Int;",
    "    fn file_close(h: Int);",
    "    fn file_close_checked(h: Int) -> Int;",
    "    fn file_read_n(h: Int, max_len: Int) -> Int;",
    "    fn file_read_data() -> CStr;",
    "    fn file_write(h: Int, buf: CStr, len: Int) -> Int;",
    "    fn file_seek(h: Int, offset: Int, whence: Int) -> Int;",
    "    fn file_flush(h: Int) -> Int;",
    "}",
    "",
    "pub handle File { on_drop: file_close }",
    "",
    "// How to open. A closed set, passed as small integers across the",
    "// extern boundary -- an extern taking a mode STRING would let a",
    "// caller hand `fopen` anything at all.",
    "pub enum Mode { Read, Write, Append }",
    "",
    "// Where a seek measures from.",
    "pub enum Seek { Start, Current, End }",
    "",
    "let mode_code (m: Mode): Int = match m { Read => 0, Write => 1, Append => 2 }",
    "let seek_code (s: Seek): Int = match s { Start => 0, Current => 1, End => 2 }",
    "",
    "// `Write` truncates an existing file; `Append` does not. Both create",
    "// one that is not there, and `Read` does not.",
    "pub let open (path: String) (mode: Mode): Result[File, String] = unsafe {",
    "    let h = file_open(path.as_cstr(), mode_code(mode));",
    "    if h < 0 { Err(\"Os.open: could not open \".concat(path)) } else { Ok(File.from_raw(h)) }",
    "}",
    "",
    "// Up to `max_len` bytes. An empty result is END OF FILE, not a",
    "// failure -- the same three-way split `Net.read_bytes` makes, and",
    "// for the same reason: a reader looping until the end needs to tell",
    "// \"nothing left\" from \"something broke\".",
    "pub let File.read (f: File) (max_len: Int): Result[Bytes, String] = unsafe {",
    "    let n = file_read_n(File.raw(f), max_len);",
    "    if n < 0 { Err(\"File.read: read failed\") }",
    "    else { Ok(Bytes.from_cstr(file_read_data(), n)) }",
    "}",
    "",
    "// `len` MUST be bound BEFORE `.as_cstr()` runs, the same ordering",
    "// `Net.write` spells out: the pointer is an interior one into the",
    "// cell, and reading `.len()` afterwards in the same argument list is",
    "// how that bug was found on the wire the first time.",
    "pub let File.write (f: File) (data: Bytes): Result[Int, String] = unsafe {",
    "    let len = data.len();",
    "    let n = file_write(File.raw(f), data.as_cstr(), len);",
    "    if n < 0 { Err(\"File.write: write failed\") } else { Ok(n) }",
    "}",
    "",
    "// The new absolute position.",
    "pub let File.seek (f: File) (offset: Int) (from: Seek): Result[Int, String] = unsafe {",
    "    let p = file_seek(File.raw(f), offset, seek_code(from));",
    "    if p < 0 { Err(\"File.seek: seek failed\") } else { Ok(p) }",
    "}",
    "",
    "// Makes buffered writes visible without giving up the handle.",
    "pub let File.flush (f: File): Result[Unit, String] = unsafe {",
    "    if file_flush(File.raw(f)) == 0 { Ok(()) } else { Err(\"File.flush: flush failed\") }",
    "}",
    "",
    "// Closing is OPTIONAL: the handle closes the file when it dies. Call",
    "// this when a failed final flush is something the program should",
    "// react to rather than lose. Calling it twice, or letting the handle",
    "// run afterwards, is harmless.",
    "pub let File.close (f: File): Result[Unit, String] = unsafe {",
    "    if file_close_checked(File.raw(f)) == 0 { Ok(()) } else { Err(\"File.close: close failed\") }",
    "}",
    "",
    "// --- Running a program ---",
    "//",
    "// `process_run_raw` takes its arguments TAB-joined in a single string",
    "// because an extern boundary has no `Array[String]` -- see",
    "// `native_stdlib/process_shim.c`. The join happens here rather than in",
    "// the runtime, where it would have to be written in IR.",
    "",
    "let process_run_raw (program: String) (args_joined: String) (argc: Int): Int = 0",
    "let process_exit_code_raw (handle: Int): Int = 0",
    "let process_stdout_raw (handle: Int): String = \"\"",
    "let process_stderr_raw (handle: Int): String = \"\"",
    "let process_free_raw (handle: Int): Bool = false",
    "",
    "pub struct ProcessResult { pub exit_code: Int, pub stdout: String, pub stderr: String }",
    "",
    "// NO leading separator: `process_run` points argv[1] at the WHOLE",
    "// joined string, so a leading tab makes argv[1] empty and pushes the",
    "// last real argument past `argc`, silently dropping it. A plain fold",
    "// that prefixes every element is NOT equivalent.",
    "let join_args_acc (args: Array[String]) (i: Int) (acc: String): String =",
    "    if i >= args.len() { acc }",
    "    else if i == 0 { join_args_acc(args, i + 1, args[i]) }",
    "    else { join_args_acc(args, i + 1, acc.concat(\"\\t\").concat(args[i])) }",
    "",
    "// A non-zero exit code is an ordinary `Ok`. `Err` means the process",
    "// could not be started at all.",
    "pub let run_process (program: String) (args: Array[String]): Result[ProcessResult, String] = {",
    "    let joined = join_args_acc(args, 0, \"\");",
    "    let handle = process_run_raw(program, joined, args.len());",
    "    if handle < 0 { Err(\"Os.run_process: could not start process: \".concat(program)) }",
    "    else {",
    "        let result = ProcessResult {",
    "            exit_code: process_exit_code_raw(handle),",
    "            stdout: process_stdout_raw(handle),",
    "            stderr: process_stderr_raw(handle),",
    "        };",
    "        let freed = process_free_raw(handle);",
    "        Ok(result)",
    "    }",
    "}",
    "",
    "// --- Process identity ---",
    "//",
    "// argv, the working directory, stdin and stderr. `args()` has",
    "// always existed as a compiler builtin and is listed in STDLIB.md",
    "// now; the rest was reachable only through the private C shims the",
    "// language server uses.",
    "extern \"C\" {",
    "    fn os_cwd() -> CStr;",
    "    fn os_chdir(path: CStr) -> Int;",
    "    fn stdin_line_n() -> Int;",
    "    fn stdin_line_data() -> CStr;",
    "    fn stdin_bytes_n(max: Int) -> Int;",
    "    fn stdin_bytes_data() -> CStr;",
    "    fn stderr_write(s: CStr) -> Unit;",
    "}",
    "",
    "pub let cwd (): Result[String, String] = unsafe {",
    "    let d = os_cwd().as_string();",
    "    if String.is_empty(d) { Err(\"Os.cwd: could not determine the working directory\") } else { Ok(d) }",
    "}",
    "",
    "pub let chdir (path: String): Result[Unit, String] = unsafe {",
    "    if os_chdir(path.as_cstr()) == 0 { Ok(()) } else { Err(\"Os.chdir: could not change directory to \".concat(path)) }",
    "}",
    "",
    "// `$HOME`, or `%USERPROFILE%` on Windows. `None` when it is unset --",
    "// no guessing from a username, because a guess that is usually right",
    "// is the worst kind of wrong for a path a program is about to write",
    "// to.",
    "pub let home_dir (): Option[String] =",
    "    if platform() == \"windows\" { env_var(\"USERPROFILE\") } else { env_var(\"HOME\") }",
    "",
    "// --- Standard input and error ---",
    "//",
    "// `None` is END OF STREAM and `Some(\"\")` is a blank line, and",
    "// keeping those apart is the whole reason these exist. The shims the",
    "// language server uses return `\"\"` for both, so a filter reading",
    "// until end of input would stop at the first blank line -- wrong in a",
    "// way that only shows up on real data.",
    "//",
    "// The line arrives WITHOUT its newline, and a final line with no",
    "// trailing newline is an ordinary line rather than something to drop.",
    "pub let read_stdin_line (): Result[Option[String], String] = unsafe {",
    "    let n = stdin_line_n();",
    "    if n < 0 { Ok(None) }",
    "    else { match Bytes.from_cstr(stdin_line_data(), n).as_string() {",
    "        Ok(text) => Ok(Some(text)),",
    "        Err(e) => Err(\"Os.read_stdin_line: \".concat(e)),",
    "    } }",
    "}",
    "",
    "// Up to `max` bytes, as `Bytes` -- stdin carries whatever was piped",
    "// into it, which is not always text. An EMPTY result is end of",
    "// stream; a SHORT one is data, because a pipe hands over what it has",
    "// rather than waiting to fill a buffer.",
    "//",
    "// The bytes are copied into a Plum value before this returns, so the",
    "// result stays valid across later reads -- the shim's own buffer is",
    "// reused and would not.",
    "pub let read_stdin (max_len: Int): Result[Bytes, String] = unsafe {",
    "    let n = stdin_bytes_n(max_len);",
    "    if n < 0 { Err(\"Os.read_stdin: read failed\") } else { Ok(Bytes.from_cstr(stdin_bytes_data(), n)) }",
    "}",
    "",
    "// Writes to standard error and flushes. NOT `println`, which is",
    "// stdout -- a diagnostic that lands in the same stream as the",
    "// program's output cannot be separated from it by whoever is reading.",
    "// No trailing newline is added; say so if you want one.",
    "pub let write_stderr (s: String): Unit = unsafe { stderr_write(s.as_cstr()); () }",
    "",
    "// --- File metadata ---",
    "//",
    "// The rest of `stat(2)`. `is_directory` below was the first caller",
    "// of it and keeps its own wrapper; these are the other fields.",
    "//",
    "// Loaded once and read field by field, so `Os.stat` costs ONE",
    "// `stat` rather than one per field -- Plum's extern surface has no",
    "// multi-value return, the same constraint `File.read` works around",
    "// the same way.",
    "extern \"C\" {",
    "    fn os_stat_load(path: CStr) -> Int;",
    "    fn os_stat_size() -> Int;",
    "    fn os_stat_mtime() -> Int;",
    "    fn os_stat_is_dir() -> Int;",
    "    fn os_path_exists(path: CStr) -> Int;",
    "}",
    "",
    "// No `exists` field: a path that is not there is an `Err`, so a",
    "// `Metadata` in hand always describes something real. That is the",
    "// contract `is_directory` already set, and having one of these",
    "// answer `exists: false` while the other errored would be two",
    "// answers to one question.",
    "pub struct Metadata { pub is_directory: Bool, pub size: Int, pub mtime: Int }",
    "",
    "// Three-way underneath, and the third case is why this returns a",
    "// `Result` rather than a `Bool`: \"does this exist\" and \"can I see",
    "// whether this exists\" are different questions. A permission error",
    "// is an `Err`, not a silent `Ok(false)`.",
    "//",
    "// This is the ONE function here where a missing path is `Ok`, and",
    "// deliberately so -- it is the function whose whole job is to say",
    "// so.",
    "pub let exists (path: String): Result[Bool, String] = unsafe {",
    "    let r = os_path_exists(path.as_cstr());",
    "    if r < 0 { Err(\"Os.exists: cannot determine whether \".concat(path).concat(\" exists\")) }",
    "    else { Ok(r == 1) }",
    "}",
    "",
    "// A missing path is an `Err`, matching `is_directory`.",
    "pub let stat (path: String): Result[Metadata, String] = unsafe {",
    "    if os_stat_load(path.as_cstr()) != 0 { Err(\"Os.stat: cannot stat \".concat(path)) }",
    "    else { Ok(Metadata { is_directory: os_stat_is_dir() == 1, size: os_stat_size(), mtime: os_stat_mtime() }) }",
    "}",
    "",
    "// Bytes. Meaningful for a regular file; for a directory it is",
    "// whatever the filesystem records for the directory itself, which",
    "// is not the size of its contents.",
    "pub let file_size (path: String): Result[Int, String] = Result.map(stat(path), |m| m.size)",
    "",
    "// Seconds since the Unix epoch -- the same unit as `Time.now()`, so",
    "// the two can be compared without a conversion.",
    "pub let mtime (path: String): Result[Int, String] = Result.map(stat(path), |m| m.mtime)",
    "",
    "// --- Directory access ---",
    "//",
    "// `is_directory`'s three-way result is deliberate: a path that does",
    "// not exist is a real `Err`, not silently `Ok(false)`.",
    "",
    "let path_is_dir_raw (path: String): Int = 0",
    "let dir_open_handle (path: String): Int = 0",
    "let dir_next_entry (handle: Int): String = \"\"",
    "let dir_close_handle (handle: Int): Unit = ()",
    "",
    "let dir_read_all_acc (handle: Int) (acc: Array[String]): Array[String] = {",
    "    let name = dir_next_entry(handle);",
    "    if String.is_empty(name) { acc } else { dir_read_all_acc(handle, acc.push(name)) }",
    "}",
    "",
    "pub let list_dir (path: String): Result[Array[String], String] = {",
    "    let handle = dir_open_handle(path);",
    "    if handle < 0 { Err(\"Os.list_dir: could not open directory: \".concat(path)) }",
    "    else {",
    "        let entries = dir_read_all_acc(handle, []);",
    "        dir_close_handle(handle);",
    "        Ok(entries)",
    "    }",
    "}",
    "",
    "pub let is_directory (path: String): Result[Bool, String] = {",
    "    let r = path_is_dir_raw(path);",
    "    if r < 0 { Err(\"Os.is_directory: path does not exist: \".concat(path)) }",
    "    else { Ok(r == 1) }",
    "}",
], "\n")

// --- The `Process` module ---
//
// Structured process execution: an executable plus an argument array,
// not a shell command string. `Os.run_process` stays as the two-argument
// convenience used by the compiler itself; this is the options-struct
// form with env overlay and stdin, which that one does not have.
//
// `process_run` is left alone on purpose. The compiler binary calling
// `Os.run_process` was compiled against the three-argument C ABI, and
// changing that signature would crash the next generation. `process_run_ex`
// is a new entry point.
let cg_process_src (): String = Array.join([
    "// argv is passed to the child. A TAB join is only the extern",
    "// packing -- see `native_stdlib/process_shim.c`. Empty `env` means",
    "// inherit the parent environment; non-empty entries are `NAME=value`",
    "// overlays. `stdin: None` is an empty stdin, not the parent's.",
    "",
    "let process_run_ex_raw (program: String) (args_joined: String) (argc: Int) (env_joined: String) (envc: Int) (stdin: String) (stdin_len: Int) (has_stdin: Int): Int = 0",
    "let process_ex_exit_code_raw (handle: Int): Int = 0",
    "let process_ex_stdout_raw (handle: Int): String = \"\"",
    "let process_ex_stderr_raw (handle: Int): String = \"\"",
    "let process_ex_free_raw (handle: Int): Bool = false",
    "",
    "pub struct Options { pub program: String, pub args: Array[String], pub env: Array[String], pub stdin: Option[String] }",
    "pub struct ProcessResult { pub exit_code: Int, pub stdout: String, pub stderr: String }",
    "",
    "let join_args_acc (args: Array[String]) (i: Int) (acc: String): String =",
    "    if i >= args.len() { acc }",
    "    else if i == 0 { join_args_acc(args, i + 1, args[i]) }",
    "    else { join_args_acc(args, i + 1, acc.concat(\"\\t\").concat(args[i])) }",
    "",
    "// A non-zero exit code is an ordinary `Ok`. `Err` means the process",
    "// could not be started at all -- including a program that was not found.",
    "pub let run (opts: Options): Result[ProcessResult, String] = {",
    "    let joined = join_args_acc(opts.args, 0, \"\");",
    "    let env_joined = join_args_acc(opts.env, 0, \"\");",
    "    let stdin_s = Option.unwrap_or(opts.stdin, \"\");",
    "    let stdin_len = stdin_s.len();",
    "    let has_stdin = if Option.is_some(opts.stdin) { 1 } else { 0 };",
    "    let handle = process_run_ex_raw(opts.program, joined, opts.args.len(), env_joined, opts.env.len(), stdin_s, stdin_len, has_stdin);",
    "    if handle < 0 { Err(\"Process.run: could not start process: \".concat(opts.program)) }",
    "    else {",
    "        let result = ProcessResult {",
    "            exit_code: process_ex_exit_code_raw(handle),",
    "            stdout: process_ex_stdout_raw(handle),",
    "            stderr: process_ex_stderr_raw(handle),",
    "        };",
    "        let freed = process_ex_free_raw(handle);",
    "        Ok(result)",
    "    }",
    "}",
], "\n")

// --- The `Time` module ---
//
// Written unqualified: inside the module these are `now`, `utc`,
// `rfc7231`, and the module stamp makes them `Time.now` and the rest
// at every call site.
// --- The `Url` module ---
//
// Split out of the HTTPS issue: parsing a URL and connecting to one are
// different problems, and the small one should not wait on TLS.
//
// **`path` stays percent-ENCODED and `raw_query` is stored verbatim.**
// That is not laziness, it is what a URL is for. The path goes straight
// into an HTTP request line, so decoding it would mean re-encoding it,
// and a general re-encode turns `/` into `%2F` and breaks the target.
// Query VALUES are decoded on lookup, because a lookup's whole purpose
// is to hand back something usable.
//
// The single source of truth for the query is `raw_query`. Storing
// parsed pairs alongside it would let the two disagree the moment
// anyone built a `Url` by hand. `parse` VALIDATES the query instead --
// every escape must decode and every value must be UTF-8 -- so
// `query_get` can be total afterwards, looking up something already
// known to be well-formed.
let cg_url_src (): String = Array.join([
    "pub struct Param { pub name: String, pub value: String }",
    "",
    "// `port` is always RESOLVED: the scheme's default when the URL did",
    "// not say. 0 means the scheme has no default this module knows,",
    "// which is not an error -- parsing is not connecting, and a URL",
    "// with a scheme we have never heard of is still a URL.",
    "//",
    "// `path` is percent-encoded and never empty (`/` when the URL had",
    "// none). `raw_query` and `fragment` are stored without their `?`",
    "// and `#`, and are `\"\"` when absent -- which does not distinguish",
    "// `http://h/p` from `http://h/p?`, a difference nothing observable",
    "// depends on.",
    "pub struct Url {",
    "    pub scheme: String,",
    "    pub host: String,",
    "    pub port: Int,",
    "    pub path: String,",
    "    pub raw_query: String,",
    "    pub fragment: String,",
    "}",
    "",
    "let byte_at (b: Bytes) (i: Int): Int = match b.at(i) { Some(v) => v, None => 0 }",
    "",
    "// Ports the schemes this module knows about default to. An unknown",
    "// scheme gets 0; see `Url`'s note.",
    "pub let default_port (scheme: String): Int =",
    "    if scheme == \"http\" { 80 }",
    "    else if scheme == \"https\" { 443 }",
    "    else { 0 }",
    "",
    "// RFC 3986: ALPHA *( ALPHA / DIGIT / \"+\" / \"-\" / \".\" ).",
    "let scheme_ok_acc (b: Bytes) (i: Int) (n: Int): Bool =",
    "    if i >= n { true }",
    "    else {",
    "        let c = byte_at(b, i);",
    "        let alpha = (c >= 65 && c <= 90) || (c >= 97 && c <= 122);",
    "        let digit = c >= 48 && c <= 57;",
    "        let mark = c == 43 || c == 45 || c == 46;",
    "        if i == 0 { if alpha { scheme_ok_acc(b, i + 1, n) } else { false } }",
    "        else if alpha || digit || mark { scheme_ok_acc(b, i + 1, n) }",
    "        else { false }",
    "    }",
    "",
    "let scheme_ok (s: String): Bool = {",
    "    let b = s.as_bytes();",
    "    if b.is_empty() { false } else { scheme_ok_acc(b, 0, b.len()) }",
    "}",
    "",
    "// Every index here is a CODEPOINT index, because `String.index_of`",
    "// and `String.slice` both are. Mixing one with `.len()`, which is",
    "// BYTES, is the bug this comment exists to prevent -- they agree on",
    "// ASCII and part company on anything else, and a URL with a raw",
    "// non-ASCII character in it is exactly the input that would find it.",
    "let clen (s: String): Int = String.char_len(s)",
    "",
    "// Splits `s` at the first `sep`, returning the part before and the",
    "// part after. When `sep` is absent the whole string is `before`.",
    "pub struct Split { pub before: String, pub after: String, pub found: Bool }",
    "",
    "let split_first (s: String) (sep: String): Split =",
    "    match String.index_of(s, sep) {",
    "        None => Split { before: s, after: \"\", found: false },",
    "        Some(i) => Split {",
    "            before: String.slice(s, 0, i),",
    "            after: String.slice(s, i + clen(sep), clen(s)),",
    "            found: true,",
    "        },",
    "    }",
    "",
    "// Every escape in the query must decode, and decode to text.",
    "// Checked at PARSE time so that `query_get` afterwards cannot fail:",
    "// a lookup returning `Option` should mean \"absent\", never \"present",
    "// but malformed\".",
    "let validate_pct (context: String) (s: String): Result[Unit, String] =",
    "    match Encoding.percent_decode(s) {",
    "        Err(e) => Err(\"Url.parse: \".concat(context).concat(\": \").concat(e)),",
    "        Ok(bytes) => match bytes.as_string() {",
    "            Err(_) => Err(\"Url.parse: \".concat(context).concat(\" is not valid UTF-8 once decoded\")),",
    "            Ok(_) => Ok(()),",
    "        },",
    "    }",
    "",
    "let validate_params (params: Array[Param]) (i: Int): Result[Unit, String] =",
    "    if i >= params.len() { Ok(()) }",
    "    else { match validate_pct(\"query name\", params[i].name) {",
    "        Err(e) => Err(e),",
    "        Ok(_) => match validate_pct(\"query value\", params[i].value) {",
    "            Err(e) => Err(e),",
    "            Ok(_) => validate_params(params, i + 1),",
    "        },",
    "    } }",
    "",
    "// `a=1&b=2` into pairs, still encoded. A field with no `=` has an",
    "// empty value (`?flag`), and an empty field is skipped (`?a=1&&b=2`)",
    "// rather than becoming a nameless pair.",
    "let parse_params_acc (fields: Array[String]) (i: Int) (acc: Array[Param]): Array[Param] =",
    "    if i >= fields.len() { acc }",
    "    else if String.is_empty(fields[i]) { parse_params_acc(fields, i + 1, acc) }",
    "    else {",
    "        let kv = split_first(fields[i], \"=\");",
    "        parse_params_acc(fields, i + 1, acc.push(Param { name: kv.before, value: kv.after }))",
    "    }",
    "",
    "let raw_params (raw_query: String): Array[Param] =",
    "    if String.is_empty(raw_query) { [] }",
    "    else { parse_params_acc(String.split(raw_query, \"&\"), 0, []) }",
    "",
    "// The authority, minus any `[...]` IPv6 brackets, plus a port.",
    "//",
    "// Brackets are STRIPPED rather than kept: `Net.connect_to` passes the",
    "// host to `getaddrinfo`, which wants `::1` and not `[::1]`. They",
    "// exist in the URL only to keep the colons in an IPv6 address from",
    "// being read as a port separator, which is a syntax problem and not",
    "// something the host itself carries.",
    "let parse_authority (authority: String) (scheme: String): Result[Url, String] =",
    "    if String.contains(authority, \"@\") {",
    "        Err(\"Url.parse: userinfo (user@host) is not supported\")",
    "    } else if String.is_empty(authority) {",
    "        Err(\"Url.parse: missing host\")",
    "    } else if String.starts_with(authority, \"[\") {",
    "        match String.index_of(authority, \"]\") {",
    "            None => Err(\"Url.parse: unterminated IPv6 address\"),",
    "            Some(close) => {",
    "                let host = String.slice(authority, 1, close);",
    "                let rest = String.slice(authority, close + 1, clen(authority));",
    "                if String.is_empty(rest) { Ok(host_port(scheme, host, default_port(scheme))) }",
    "                else if !String.starts_with(rest, \":\") { Err(\"Url.parse: trailing text after IPv6 address\") }",
    "                else { with_port(scheme, host, String.slice(rest, 1, clen(rest))) }",
    "            },",
    "        }",
    "    } else {",
    "        let hp = split_first(authority, \":\");",
    "        if !hp.found { Ok(host_port(scheme, authority, default_port(scheme))) }",
    "        else if String.is_empty(hp.before) { Err(\"Url.parse: missing host\") }",
    "        else { with_port(scheme, hp.before, hp.after) }",
    "    }",
    "",
    "// A partially-built `Url`; the caller fills in path/query/fragment.",
    "let host_port (scheme: String) (host: String) (port: Int): Url =",
    "    Url { scheme: scheme, host: host, port: port, path: \"/\", raw_query: \"\", fragment: \"\" }",
    "",
    "let with_port (scheme: String) (host: String) (text: String): Result[Url, String] =",
    "    if String.is_empty(text) { Err(\"Url.parse: empty port\") }",
    "    else { match String.parse_int(text) {",
    "        Err(_) => Err(\"Url.parse: invalid port: \".concat(text)),",
    "        Ok(p) => if p < 1 || p > 65535 { Err(\"Url.parse: port out of range: \".concat(text)) }",
    "                 else { Ok(host_port(scheme, host, p)) },",
    "    } }",
    "",
    "// Absolute URLs only. A scheme-relative (`//host/x`) or relative",
    "// (`/x`) reference has no meaning without a base to resolve against,",
    "// and resolution is a different function than parsing.",
    "//",
    "// The scheme is lowercased -- schemes are case-insensitive, and",
    "// normalising here is what lets `u.scheme == \"http\"` be written",
    "// everywhere else without thinking about it. The host is left",
    "// exactly as written, matching Go's `net/url`.",
    "pub let parse (input: String): Result[Url, String] = {",
    "    let sp = split_first(input, \"://\");",
    "    if !sp.found { Err(\"Url.parse: missing scheme (expected something like http://host/path)\") }",
    "    else if !scheme_ok(sp.before) { Err(\"Url.parse: invalid scheme: \".concat(sp.before)) }",
    "    else {",
    "        let scheme = String.to_lower(sp.before);",
    "        // Fragment first, then query: a `#` ends the query, and a `?`",
    "        // inside a fragment is part of the fragment.",
    "        let frag = split_first(sp.after, \"#\");",
    "        let q = split_first(frag.before, \"?\");",
    "        let slash = String.index_of(q.before, \"/\");",
    "        let authority = match slash { Some(i) => String.slice(q.before, 0, i), None => q.before };",
    "        let path = match slash { Some(i) => String.slice(q.before, i, clen(q.before)), None => \"/\" };",
    "        match parse_authority(authority, scheme) {",
    "            Err(e) => Err(e),",
    "            Ok(base) => match validate_params(raw_params(q.after), 0) {",
    "                Err(e) => Err(e),",
    "                Ok(_) => match validate_pct(\"path\", path) {",
    "                    Err(e) => Err(e),",
    "                    Ok(_) => Ok(Url {",
    "                        scheme: base.scheme, host: base.host, port: base.port,",
    "                        path: path, raw_query: q.after, fragment: frag.after,",
    "                    }),",
    "                },",
    "            },",
    "        }",
    "    }",
    "}",
    "",
    "// What goes after the method in an HTTP request line: the path, plus",
    "// the query exactly as it arrived. Not the fragment -- a fragment is",
    "// never sent to a server.",
    "pub let request_target (u: Url): String =",
    "    if String.is_empty(u.raw_query) { u.path } else { u.path.concat(\"?\").concat(u.raw_query) }",
    "",
    "// Host, re-bracketed if it is an IPv6 literal, plus the port when",
    "// it is not the scheme's default.",
    "//",
    "// This is what an HTTP `Host:` header wants (RFC 7230 section 5.4)",
    "// and what a URL's authority component is, which is the same string",
    "// for the same reasons -- so it is written once here rather than",
    "// twice, once in `stringify` and once in the HTTP client.",
    "//",
    "// The brackets have to come back: they were stripped on the way in",
    "// because `getaddrinfo` wants `::1`, but any context that puts a",
    "// host next to a `:port` needs them or the colons are ambiguous.",
    "pub let authority (u: Url): String = {",
    "    let host = if String.contains(u.host, \":\") { \"[\".concat(u.host).concat(\"]\") } else { u.host };",
    "    if u.port == default_port(u.scheme) || u.port == 0 { host }",
    "    else { host.concat(\":\").concat(u.port.to_string()) }",
    "}",
    "",
    "// The port is omitted when it is the scheme's default, and an IPv6",
    "// host is re-bracketed -- so this is CANONICAL output rather than a",
    "// byte-for-byte reproduction of whatever was parsed. `parse` after",
    "// `stringify` yields the same `Url`, which is the invariant that",
    "// matters and the one the properties check.",
    "pub let stringify (u: Url): String = {",
    "    let frag = if String.is_empty(u.fragment) { \"\" } else { \"#\".concat(u.fragment) };",
    "    u.scheme.concat(\"://\").concat(authority(u)).concat(request_target(u)).concat(frag)",
    "}",
    "",
    "// --- Query access ---",
    "//",
    "// Values come back DECODED. `parse` already proved every escape in",
    "// the query decodes to text, so the fallback below cannot be reached",
    "// for a `Url` that came from `parse`; it exists for one built by",
    "// hand with a `raw_query` nobody validated.",
    "let decoded (s: String): String =",
    "    match Encoding.percent_decode(s) {",
    "        Err(_) => s,",
    "        Ok(bytes) => match bytes.as_string() { Err(_) => s, Ok(text) => text },",
    "    }",
    "",
    "let query_all_acc (params: Array[Param]) (name: String) (i: Int) (acc: Array[String]): Array[String] =",
    "    if i >= params.len() { acc }",
    "    else if decoded(params[i].name) == name { query_all_acc(params, name, i + 1, acc.push(decoded(params[i].value))) }",
    "    else { query_all_acc(params, name, i + 1, acc) }",
    "",
    "// Every value for `name`, in the order they appeared. A query may",
    "// legitimately repeat a key (`?tag=a&tag=b`), and a lookup that",
    "// returns one value cannot say so.",
    "pub let query_all (u: Url) (name: String): Array[String] =",
    "    query_all_acc(raw_params(u.raw_query), name, 0, [])",
    "",
    "// The FIRST value for `name`, matching Go's `Values.Get`. `None` is",
    "// absent; a present-but-empty value (`?q=`) is `Some(\"\")`.",
    "pub let query_get (u: Url) (name: String): Option[String] =",
    "    Array.first(query_all(u, name))",
    "",
    "// All pairs, decoded, in order.",
    "pub let query_params (u: Url): Array[Param] =",
    "    Array.map(raw_params(u.raw_query), |p| Param { name: decoded(p.name), value: decoded(p.value) })",
    "",
    "// Builds a `raw_query` from pairs, percent-encoding both halves.",
    "// `Encoding` owns the encoder; this only decides where the `&` and",
    "// `=` go.",
    "let encode_param (p: Param): String =",
    "    Encoding.percent_encode(p.name.as_bytes()).concat(\"=\").concat(Encoding.percent_encode(p.value.as_bytes()))",
    "",
    "pub let build_query (params: Array[Param]): String =",
    "    Array.join(Array.map(params, encode_param), \"&\")",
    "",
    "// `u` with its query replaced. A setter rather than a mutation:",
    "// values are values here.",
    "pub let with_query (u: Url) (params: Array[Param]): Url =",
    "    Url { scheme: u.scheme, host: u.host, port: u.port, path: u.path,",
    "          raw_query: build_query(params), fragment: u.fragment }",
    "",
], "\n")

// --- The `Path` module ---
//
// Lexical path handling. It never touches the filesystem: `clean` does
// not resolve symlinks, and nothing here stats anything. That is a
// deliberate boundary -- `Os` owns questions about what is really
// there, and this owns questions about what a path SAYS.
//
// Ordinary Plum over `Os.platform()`, the same way `Time.utc` is
// ordinary Plum over `Time.now`.
//
// **Windows accepts both separators, and emits one.** Every Win32 path
// API takes `/` as well as `\`, and real paths arrive with a mix
// (a config file written on Linux, a drive letter typed by hand). So
// input is normalized to `/` and the platform separator is put back
// only when a path is rebuilt -- which means one set of rules rather
// than two, and `Path.dirname("C:/a/b")` works on a Windows machine
// whether or not the caller used backslashes.
let cg_path_src (): String = Array.join([
    "// Hoisted, so the platform is not re-derived per character. It is",
    "// compiled in (`Os.platform()` is a constant, not a lookup), but a",
    "// global says that once rather than trusting every call site to be",
    "// cheap.",
    "let IS_WINDOWS: Bool = Os.platform() == \"windows\"",
    "",
    "// `\\\\` on Windows, `/` everywhere else.",
    "pub let separator (): String = if IS_WINDOWS { \"\\\\\" } else { \"/\" }",
    "",
    "// Backslashes become forward slashes on Windows so the rest of this",
    "// module has ONE separator to reason about. A no-op elsewhere: a",
    "// backslash is a legal character in a Unix filename and must not be",
    "// touched there.",
    "let normalize (p: String): String = if IS_WINDOWS { String.replace(p, \"\\\\\", \"/\") } else { p }",
    "",
    "// `C:` or `c:` -- a drive letter, which only means anything on",
    "// Windows.",
    "let has_drive (p: String): Bool =",
    "    IS_WINDOWS && String.char_len(p) >= 2 && String.slice(p, 1, 2) == \":\" && plum_is_alpha(String.slice(p, 0, 1))",
    "",
    "let plum_is_alpha (c: String): Bool = {",
    "    let b = c.as_bytes();",
    "    if b.len() != 1 { false } else { match b.at(0) {",
    "        Some(v) => (v >= 65 && v <= 90) || (v >= 97 && v <= 122),",
    "        None => false,",
    "    } }",
    "}",
    "",
    "// Rooted: `/x` anywhere, and on Windows also `C:/x` and a `//server`",
    "// UNC path. `C:x` (a drive-RELATIVE path) is deliberately not",
    "// absolute -- it means \"the current directory on drive C\", which is",
    "// a relative path with a drive attached.",
    "pub let is_absolute (p: String): Bool = {",
    "    let n = normalize(p);",
    "    if String.starts_with(n, \"/\") { true }",
    "    else if has_drive(n) { String.starts_with(String.slice(n, 2, String.char_len(n)), \"/\") }",
    "    else { false }",
    "}",
    "",
    "// --- clean ---",
    "//",
    "// Lexical only, and that limit is the point: `a/b/../c` becomes",
    "// `a/c` WITHOUT asking whether `a/b` is a symlink pointing",
    "// elsewhere. Resolving that needs syscalls and is a different",
    "// function; `Os.remove_tree` already refuses to follow links out of",
    "// a tree rather than trying to reason about them.",
    "let drop_empty_and_dot (parts: Array[String]) (i: Int) (acc: Array[String]): Array[String] =",
    "    if i >= parts.len() { acc }",
    "    else if String.is_empty(parts[i]) || parts[i] == \".\" { drop_empty_and_dot(parts, i + 1, acc) }",
    "    else { drop_empty_and_dot(parts, i + 1, acc.push(parts[i])) }",
    "",
    "// A `..` pops the segment before it -- unless there is nothing to",
    "// pop, in which case it is KEPT for a relative path (`../x` really",
    "// does mean the parent) and DROPPED for an absolute one (the root",
    "// has no parent, so `/../x` is `/x`).",
    "let resolve_dotdot (parts: Array[String]) (i: Int) (rooted: Bool) (acc: Array[String]): Array[String] =",
    "    if i >= parts.len() { acc }",
    "    else if parts[i] != \"..\" { resolve_dotdot(parts, i + 1, rooted, acc.push(parts[i])) }",
    "    else if !Array.is_empty(acc) && acc[acc.len() - 1] != \"..\" {",
    "        resolve_dotdot(parts, i + 1, rooted, Array.slice(acc, 0, acc.len() - 1))",
    "    }",
    "    else if rooted { resolve_dotdot(parts, i + 1, rooted, acc) }",
    "    else { resolve_dotdot(parts, i + 1, rooted, acc.push(\"..\")) }",
    "",
    "// Removes duplicate separators, `.` segments, and resolvable `..`",
    "// segments, and drops a trailing separator. An empty result is `.`,",
    "// matching Go's `filepath.Clean` -- the empty string is not a path,",
    "// and `.` is the one it means.",
    "pub let clean (p: String): String = {",
    "    let n = normalize(p);",
    "    let drive = if has_drive(n) { String.slice(n, 0, 2) } else { \"\" };",
    "    let rest = if String.is_empty(drive) { n } else { String.slice(n, 2, String.char_len(n)) };",
    "    let rooted = String.starts_with(rest, \"/\");",
    "    let parts = resolve_dotdot(drop_empty_and_dot(String.split(rest, \"/\"), 0, []), 0, rooted, []);",
    "    let joined = Array.join(parts, separator());",
    "    let root = if rooted { separator() } else { \"\" };",
    "    let body = root.concat(joined);",
    "    if String.is_empty(body) { if String.is_empty(drive) { \".\" } else { drive.concat(\".\") } }",
    "    else { drive.concat(body) }",
    "}",
    "",
    "// --- join ---",
    "//",
    "// Empty segments are skipped, so `join(\"\", \"b\")` is `b` rather than",
    "// `/b` -- joining nothing to something must not turn a relative path",
    "// absolute.",
    "//",
    "// A later ABSOLUTE segment does not discard the earlier ones:",
    "// `join(\"a\", \"/b\")` is `a/b`, matching Go's `filepath.Join`. Python",
    "// goes the other way and lets `/b` win, which is convenient exactly",
    "// until a caller passes user input as the second argument and",
    "// silently escapes the directory they meant to stay inside.",
    "pub let join_all (parts: Array[String]): String = {",
    "    let kept = drop_empty(parts, 0, []);",
    "    if Array.is_empty(kept) { \"\" } else { clean(Array.join(kept, \"/\")) }",
    "}",
    "",
    "let drop_empty (parts: Array[String]) (i: Int) (acc: Array[String]): Array[String] =",
    "    if i >= parts.len() { acc }",
    "    else if String.is_empty(parts[i]) { drop_empty(parts, i + 1, acc) }",
    "    else { drop_empty(parts, i + 1, acc.push(parts[i])) }",
    "",
    "pub let join (a: String) (b: String): String = join_all([a, b])",
    "",
    "// --- Splitting a path apart ---",
    "//",
    "// A TRAILING SEPARATOR is ignored by both halves: `a/b/` has",
    "// basename `b` and dirname `a`. That is a deliberate choice, and",
    "// the two obvious references disagree with each other about it.",
    "// Python treats a trailing slash as \"no file part\" (basename",
    "// `\"\"`, dirname `a/b`); Go strips it in `Base` but not in `Dir`,",
    "// so `Base` says `b` while `Dir` says `a/b`.",
    "//",
    "// Stripping in both is what makes them describe the SAME split:",
    "//",
    "//     join(dirname(p), basename(p)) == clean(p)",
    "//",
    "// holds for every path, including `\"\"`, `/`, `file` and `a/b/`.",
    "// Go's pair does not satisfy that for a trailing slash, and a",
    "// property in `bootstrap/properties` checks that this one does.",
    "",
    "let last_sep_index (s: String) (i: Int) (best: Int): Int =",
    "    if i >= String.char_len(s) { best }",
    "    else if String.slice(s, i, i + 1) == \"/\" { last_sep_index(s, i + 1, i) }",
    "    else { last_sep_index(s, i + 1, best) }",
    "",
    "// The last component. `\"\"` is `.`, a bare root is itself, and a",
    "// trailing separator is ignored (`a/b/` is `b`).",
    "pub let basename (p: String): String = {",
    "    let n = normalize(p);",
    "    if String.is_empty(n) { \".\" }",
    "    else {",
    "        let trimmed = drop_trailing_seps(n);",
    "        if String.is_empty(trimmed) { separator() }",
    "        else {",
    "            let i = last_sep_index(trimmed, 0, 0 - 1);",
    "            if i < 0 { trimmed } else { String.slice(trimmed, i + 1, String.char_len(trimmed)) }",
    "        }",
    "    }",
    "}",
    "",
    "let drop_trailing_seps (s: String): String =",
    "    if String.char_len(s) > 1 && String.ends_with(s, \"/\") {",
    "        drop_trailing_seps(String.slice(s, 0, String.char_len(s) - 1))",
    "    } else if s == \"/\" { \"\" } else { s }",
    "",
    "// Everything before the last component, cleaned. A path with no",
    "// separator is `.` -- the directory it is in.",
    "pub let dirname (p: String): String = {",
    "    let n = normalize(p);",
    "    if String.is_empty(n) { \".\" }",
    "    else {",
    "        let trimmed = drop_trailing_seps(n);",
    "        if String.is_empty(trimmed) { separator() }",
    "        else {",
    "            let i = last_sep_index(trimmed, 0, 0 - 1);",
    "            if i < 0 { \".\" }",
    "            else if i == 0 { separator() }",
    "            else { clean(String.slice(trimmed, 0, i)) }",
    "        }",
    "    }",
    "}",
    "",
    "// --- Extensions ---",
    "//",
    "// Returned WITHOUT the dot, so a check reads `Path.extension(p) ==",
    "// \"plum\"`. Go and Python include it; Rust does not, and neither do",
    "// this library's other splitters -- `String.split` does not hand",
    "// back its separator either.",
    "//",
    "// A LEADING dot does not begin an extension: `.hidden` is a name,",
    "// not an extension, so its stem is `.hidden` and its extension is",
    "// empty. A TRAILING dot gives an empty extension and a stem without",
    "// it (`file.` -> `file`), which is the only reading that lets stem",
    "// and extension describe the same name.",
    "let ext_index (name: String): Int = {",
    "    let i = last_dot(name, 0, 0 - 1);",
    "    if i <= 0 { 0 - 1 } else { i }",
    "}",
    "",
    "let last_dot (s: String) (i: Int) (best: Int): Int =",
    "    if i >= String.char_len(s) { best }",
    "    else if String.slice(s, i, i + 1) == \".\" { last_dot(s, i + 1, i) }",
    "    else { last_dot(s, i + 1, best) }",
    "",
    "pub let extension (p: String): String = {",
    "    let name = basename(p);",
    "    let i = ext_index(name);",
    "    if i < 0 { \"\" } else { String.slice(name, i + 1, String.char_len(name)) }",
    "}",
    "",
    "// The last component without its extension.",
    "pub let stem (p: String): String = {",
    "    let name = basename(p);",
    "    let i = ext_index(name);",
    "    if i < 0 { name } else { String.slice(name, 0, i) }",
    "}",
    "",
    "// `p` with a different extension, given without a dot. An empty",
    "// `ext` removes it.",
    "pub let with_extension (p: String) (ext: String): String = {",
    "    let dir = dirname(p);",
    "    let base = if String.is_empty(ext) { stem(p) } else { stem(p).concat(\".\").concat(ext) };",
    "    if dir == \".\" && !String.starts_with(normalize(p), \".\".concat(\"/\")) { base } else { join(dir, base) }",
    "}",
    "",
], "\n")

// --- The `Encoding` module ---
//
// Hex, base64 and percent-encoding. Not a crypto suite: no hashing, no
// ciphers, no HMAC. Those are a different kind of thing to get right
// and a different kind of thing to be wrong about.
//
// **Everything here works on `Bytes`, not `String`.** That is the whole
// reason this waited for #16. Encoding is a byte operation -- base64 of
// "a string" means base64 of its bytes, and hex-decoding arbitrary
// input cannot produce a `String` at all, because the result is
// whatever bytes were written down. A `String`-shaped API has to either
// lie about that or return a `Result` on the ENCODE side too, which is
// backwards. `String.as_bytes(s)` is total and one call, so the text
// case reads `Encoding.base64_encode(s.as_bytes())` and stays honest.
//
// Decoders return `Result[Bytes, String]`. Every one of them is parsing
// attacker-shaped input -- a query string, a header, a token -- so
// invalid input is an ordinary outcome and never a panic.
//
// `hex_encode` DELEGATES to the prelude's `Bytes.to_hex` rather than
// reimplementing it. Hex has to exist in the prelude regardless: it is
// what the checker's `.to_string()` rejection tells people to reach
// for, so it cannot require an import. Wrappers like these cost nothing
// when unused -- dead-function elimination drops them -- and one
// encoder with two spellings is the thing this module is supposed to
// prevent two of.
let cg_encoding_src (): String = Array.join([
    "// The base64 alphabets, split ONCE into indexable arrays.",
    "//",
    "// Hoisted to globals deliberately. Character-classification tables",
    "// have been the hot spot in this project twice, both times because",
    "// a `chars_of` or a `String.index_of` sat inside a per-character",
    "// loop and re-split its alphabet for every byte processed. A global",
    "// is evaluated once, by `@plum_init_globals`.",
    "let B64_STD_CHARS: Array[String] = chars_of(\"ABCDEFGHIJKLMNOPQRSTUVWXYZabcdefghijklmnopqrstuvwxyz0123456789+/\")",
    "let B64_URL_CHARS: Array[String] = chars_of(\"ABCDEFGHIJKLMNOPQRSTUVWXYZabcdefghijklmnopqrstuvwxyz0123456789-_\")",
    "",
    "let byte_at (b: Bytes) (i: Int): Int = match b.at(i) { Some(v) => v, None => 0 }",
    "",
    "// --- Hex ---",
    "",
    "// The prelude owns the encoder; see this module's header for why.",
    "pub let hex_encode (b: Bytes): String = Bytes.to_hex(b)",
    "",
    "// Accepts upper and lower case, and requires an even length: a hex",
    "// string with an odd number of digits has no reading, and guessing",
    "// one (a leading zero? a trailing one?) would silently produce",
    "// different bytes than whatever wrote it intended.",
    "let hex_digit_value (c: Int): Int =",
    "    if c >= 48 && c <= 57 { c - 48 }",
    "    else if c >= 97 && c <= 102 { c - 97 + 10 }",
    "    else if c >= 65 && c <= 70 { c - 65 + 10 }",
    "    else { 0 - 1 }",
    "",
    "let hex_acc (b: Bytes) (i: Int) (n: Int) (acc: Array[Int]): Result[Array[Int], String] =",
    "    if i >= n { Ok(acc) }",
    "    else {",
    "        let hi = hex_digit_value(byte_at(b, i));",
    "        let lo = hex_digit_value(byte_at(b, i + 1));",
    "        if hi < 0 || lo < 0 { Err(\"Encoding.hex_decode: not a hex digit at byte \".concat(i.to_string())) }",
    "        else { hex_acc(b, i + 2, n, acc.push(hi * 16 + lo)) }",
    "    }",
    "",
    "pub let hex_decode (s: String): Result[Bytes, String] = {",
    "    let b = s.as_bytes();",
    "    let n = b.len();",
    "    if n % 2 != 0 { Err(\"Encoding.hex_decode: odd number of hex digits\") }",
    "    else { Result.map(hex_acc(b, 0, n, []), |vals| Bytes.from_array(vals)) }",
    "}",
    "",
    "// --- Base64 ---",
    "",
    "// RFC 4648. `base64_encode` uses the standard alphabet with `=`",
    "// padding; `base64_url_encode` uses the URL-safe alphabet and omits",
    "// padding, which is what JWTs and data URLs expect.",
    "//",
    "// Arithmetic rather than bit operations throughout: the shifts are",
    "// exact divisions and remainders on values already known to be",
    "// 0..255, and this keeps the code readable without depending on",
    "// what bitwise operators Plum does or does not have.",
    "let b64_acc (b: Bytes) (alpha: Array[String]) (pad: Bool) (i: Int) (n: Int) (acc: Array[String]): Array[String] =",
    "    if i >= n { acc }",
    "    else {",
    "        let rem = n - i;",
    "        let b0 = byte_at(b, i);",
    "        let b1 = if rem > 1 { byte_at(b, i + 1) } else { 0 };",
    "        let b2 = if rem > 2 { byte_at(b, i + 2) } else { 0 };",
    "        let c0 = alpha[b0 / 4];",
    "        let c1 = alpha[(b0 % 4) * 16 + b1 / 16];",
    "        let with2 = acc.push(c0).push(c1);",
    "        // A 1-byte tail encodes to two characters, a 2-byte tail to",
    "        // three. Padding makes the output a multiple of four so a",
    "        // decoder can frame it without a length; the URL form drops",
    "        // it because `=` needs escaping in a query string.",
    "        let with3 = if rem > 1 { with2.push(alpha[(b1 % 16) * 4 + b2 / 64]) }",
    "                    else if pad { with2.push(\"=\") } else { with2 };",
    "        let with4 = if rem > 2 { with3.push(alpha[b2 % 64]) }",
    "                    else if pad { with3.push(\"=\") } else { with3 };",
    "        b64_acc(b, alpha, pad, i + 3, n, with4)",
    "    }",
    "",
    "pub let base64_encode (b: Bytes): String = Array.concat_all(b64_acc(b, B64_STD_CHARS, true, 0, b.len(), []))",
    "pub let base64_url_encode (b: Bytes): String = Array.concat_all(b64_acc(b, B64_URL_CHARS, false, 0, b.len(), []))",
    "",
    "// One decoder for both alphabets, accepting `+/` and `-_` alike and",
    "// treating padding as optional.",
    "//",
    "// Deliberately lenient, and worth stating rather than discovering: a",
    "// strict pair would reject a URL-safe token handed to the standard",
    "// decoder, which is the single most common way this call is written",
    "// wrong, and rejecting it buys nothing -- the two alphabets do not",
    "// overlap, so no input has two readings. What is NOT lenient is an",
    "// unrecognised character, which is a real error and reported as one.",
    "let b64_value (c: Int): Int =",
    "    if c >= 65 && c <= 90 { c - 65 }",
    "    else if c >= 97 && c <= 122 { c - 97 + 26 }",
    "    else if c >= 48 && c <= 57 { c - 48 + 52 }",
    "    else if c == 43 || c == 45 { 62 }",
    "    else if c == 47 || c == 95 { 63 }",
    "    else { 0 - 1 }",
    "",
    "// Six-bit values, with padding and nothing else skipped.",
    "let b64_vals (b: Bytes) (i: Int) (n: Int) (acc: Array[Int]): Result[Array[Int], String] =",
    "    if i >= n { Ok(acc) }",
    "    else {",
    "        let c = byte_at(b, i);",
    "        if c == 61 { b64_vals(b, i + 1, n, acc) }",
    "        else {",
    "            let v = b64_value(c);",
    "            if v < 0 { Err(\"Encoding.base64_decode: invalid character at byte \".concat(i.to_string())) }",
    "            else { b64_vals(b, i + 1, n, acc.push(v)) }",
    "        }",
    "    }",
    "",
    "// Four 6-bit values make three bytes. A tail of three makes two, a",
    "// tail of two makes one, and a tail of ONE is impossible: six bits",
    "// cannot encode a byte, so that input was truncated.",
    "let b64_bytes (vals: Array[Int]) (i: Int) (n: Int) (acc: Array[Int]): Result[Array[Int], String] =",
    "    if i >= n { Ok(acc) }",
    "    else {",
    "        let rem = n - i;",
    "        if rem == 1 { Err(\"Encoding.base64_decode: truncated input\") }",
    "        else {",
    "            let v0 = vals[i];",
    "            let v1 = vals[i + 1];",
    "            let with1 = acc.push(v0 * 4 + v1 / 16);",
    "            let with2 = if rem > 2 { with1.push((v1 % 16) * 16 + vals[i + 2] / 4) } else { with1 };",
    "            let with3 = if rem > 3 { with2.push((vals[i + 2] % 4) * 64 + vals[i + 3]) } else { with2 };",
    "            b64_bytes(vals, i + 4, n, with3)",
    "        }",
    "    }",
    "",
    "pub let base64_decode (s: String): Result[Bytes, String] = {",
    "    let b = s.as_bytes();",
    "    match b64_vals(b, 0, b.len(), []) {",
    "        Err(e) => Err(e),",
    "        Ok(vals) => Result.map(b64_bytes(vals, 0, vals.len(), []), |out| Bytes.from_array(out)),",
    "    }",
    "}",
    "",
    "// The same decoder; see `base64_decode`'s note on leniency.",
    "pub let base64_url_decode (s: String): Result[Bytes, String] = base64_decode(s)",
    "",
    "// --- Percent-encoding ---",
    "",
    "// RFC 3986. Unreserved is `A-Z a-z 0-9 - . _ ~`; everything else",
    "// becomes `%XX` with UPPERCASE hex, which the RFC prefers and which",
    "// makes encoded output comparable byte-for-byte.",
    "//",
    "// A space becomes `%20`, NOT `+`. The `+` convention belongs to HTML",
    "// form bodies (`application/x-www-form-urlencoded`), not to URLs, and",
    "// a decoder that accepted both would turn a literal `+` in a query",
    "// value into a space. If form encoding is wanted later it should be",
    "// its own named pair rather than a flag on this one.",
    "let is_unreserved (c: Int): Bool =",
    "    (c >= 65 && c <= 90) || (c >= 97 && c <= 122) || (c >= 48 && c <= 57)",
    "    || c == 45 || c == 46 || c == 95 || c == 126",
    "",
    "// A 0-15 value as the ASCII byte of its uppercase hex digit.",
    "let hex_upper_byte (v: Int): Int = if v < 10 { 48 + v } else { 65 + v - 10 }",
    "",
    "// Builds the output as BYTES rather than as characters, which is",
    "// what lets an unreserved byte pass straight through: turning one",
    "// back into a one-character String would need an ASCII table to",
    "// index, and the table would exist only to undo a conversion that",
    "// never had to happen.",
    "let pct_acc (b: Bytes) (i: Int) (n: Int) (acc: Array[Int]): Array[Int] =",
    "    if i >= n { acc }",
    "    else {",
    "        let c = byte_at(b, i);",
    "        if is_unreserved(c) { pct_acc(b, i + 1, n, acc.push(c)) }",
    "        else { pct_acc(b, i + 1, n, acc.push(37).push(hex_upper_byte(c / 16)).push(hex_upper_byte(c % 16))) }",
    "    }",
    "",
    "// The `Err` arm is unreachable by construction: every byte emitted",
    "// above is either an unreserved character or one of `%0-9A-F`, all",
    "// of which are ASCII and therefore valid UTF-8. Written as a `match`",
    "// rather than an unwrap so that the impossible case is visible",
    "// rather than asserted.",
    "pub let percent_encode (b: Bytes): String =",
    "    match Bytes.as_string(Bytes.from_array(pct_acc(b, 0, b.len(), []))) {",
    "        Ok(s) => s,",
    "        Err(e) => e,",
    "    }",
    "",
    "let pct_decode_acc (b: Bytes) (i: Int) (n: Int) (acc: Array[Int]): Result[Array[Int], String] =",
    "    if i >= n { Ok(acc) }",
    "    else {",
    "        let c = byte_at(b, i);",
    "        if c != 37 { pct_decode_acc(b, i + 1, n, acc.push(c)) }",
    "        else if i + 2 >= n { Err(\"Encoding.percent_decode: truncated escape at byte \".concat(i.to_string())) }",
    "        else {",
    "            let hi = hex_digit_value(byte_at(b, i + 1));",
    "            let lo = hex_digit_value(byte_at(b, i + 2));",
    "            if hi < 0 || lo < 0 { Err(\"Encoding.percent_decode: invalid escape at byte \".concat(i.to_string())) }",
    "            else { pct_decode_acc(b, i + 3, n, acc.push(hi * 16 + lo)) }",
    "        }",
    "    }",
    "",
    "pub let percent_decode (s: String): Result[Bytes, String] = {",
    "    let b = s.as_bytes();",
    "    Result.map(pct_decode_acc(b, 0, b.len(), []), |vals| Bytes.from_array(vals))",
    "}",
    "",
], "\n")

let cg_time_src (): String = Array.join([
    "// The runtime primitive. Intercepted by `cg_runtime_fn`, which keys",
    "// on the bare name and so does not care that it now lives in a",
    "// module rather than in the prelude.",
    "let os_time_raw (ignored: Bool): Int = 0",
    "",
    "// Seconds since the Unix epoch, from the system clock.",
    "//",
    "// Seconds, and an `Int`, because that is what every platform's",
    "// `time()` agrees on. Anything richer -- a calendar date, a",
    "// timezone, a formatted string -- is a library on top of this and",
    "// not a runtime concern; the primitive is the part a program",
    "// cannot write for itself.",
    "pub let now (): Int = os_time_raw(true)",
    "",
    "// --- Durations and clocks ---",
    "//",
    "// `Time.now()` above stays SECONDS, and every calendar function",
    "// below stays arithmetic on it. Changing it would break every",
    "// caller and every documented `iso8601` answer to buy precision",
    "// that belongs in a separate type anyway.",
    "extern \"C\" {",
    "    fn time_now_nanos() -> Int;",
    "    fn time_monotonic_nanos() -> Int;",
    "    fn time_sleep_nanos(n: Int) -> Int;",
    "}",
    "",
    "// A length of time, held as NANOSECONDS.",
    "//",
    "// A real type rather than an `Int` of milliseconds, because a",
    "// bare number does not say which unit it is and every caller has",
    "// to agree by convention. `#7` will want timeouts, `Http` will",
    "// want them, `Terminal` will want them -- and the alternative is",
    "// each module growing its own `timeout_ms: Int` that cannot be",
    "// passed to the others.",
    "//",
    "// The field is PRIVATE: a `Duration` is built through a",
    "// constructor that names its unit, which is the whole point of",
    "// having the type. Nanoseconds internally because a signed 64-bit",
    "// count of them spans ~292 years, which is more than any duration",
    "// needs, and because losing sub-millisecond precision would make",
    "// the type useless for the timing code that wants it most.",
    "pub struct Duration { nanos: Int }",
    "",
    "// A point on the MONOTONIC clock, whose origin is deliberately",
    "// unspecified. Two instants can be subtracted; one on its own",
    "// means nothing, which is why this is a distinct type from a wall",
    "// clock reading rather than another `Int`.",
    "pub struct Instant { nanos: Int }",
    "",
    "// Constructors, each naming its unit. Multiplication can overflow,",
    "// and Plum aborts on integer overflow rather than wrapping, so",
    "// `Time.seconds(10000000000)` is a crash and not a silently wrong",
    "// duration.",
    "pub let nanos (n: Int): Duration = Duration { nanos: n }",
    "pub let micros (n: Int): Duration = Duration { nanos: n * 1000 }",
    "pub let millis (n: Int): Duration = Duration { nanos: n * 1000000 }",
    "pub let seconds (n: Int): Duration = Duration { nanos: n * 1000000000 }",
    "pub let minutes (n: Int): Duration = seconds(n * 60)",
    "pub let hours (n: Int): Duration = minutes(n * 60)",
    "pub let zero (): Duration = Duration { nanos: 0 }",
    "",
    "// Accessors, TRUNCATING toward zero the way `/` does: a duration of",
    "// 1500 microseconds is 1 millisecond, not 2. Ask in the unit you",
    "// care about rather than rounding one answer into another.",
    "pub let Duration.as_nanos (d: Duration): Int = d.nanos",
    "pub let Duration.as_micros (d: Duration): Int = d.nanos / 1000",
    "pub let Duration.as_millis (d: Duration): Int = d.nanos / 1000000",
    "pub let Duration.as_seconds (d: Duration): Int = d.nanos / 1000000000",
    "pub let Duration.is_zero (d: Duration): Bool = d.nanos == 0",
    "",
    "pub let Duration.add (a: Duration) (b: Duration): Duration = Duration { nanos: a.nanos + b.nanos }",
    "pub let Duration.sub (a: Duration) (b: Duration): Duration = Duration { nanos: a.nanos - b.nanos }",
    "pub let Duration.scale (d: Duration) (n: Int): Duration = Duration { nanos: d.nanos * n }",
    "",
    "// A duration can be NEGATIVE -- `sub` may produce one, and refusing",
    "// to represent it would only move the problem to every caller of",
    "// `sub`. `sleep` treats a non-positive duration as no wait at all.",
    "pub let Duration.negate (d: Duration): Duration = Duration { nanos: 0 - d.nanos }",
    "",
    "// --- Comparison ---",
    "//",
    "// Functions rather than `<`, because this checker offers ordered",
    "// comparison on `Int`, `Float` and `String` and on nothing else --",
    "// a struct has no `<`. `==` works, since that is structural.",
    "//",
    "// If ordered comparison ever reaches single-field wrappers, `<`",
    "// starts working on a `Duration` for free and these stay as the",
    "// spelling that always worked.",
    "pub let Duration.compare (a: Duration) (b: Duration): Int =",
    "    if a.nanos < b.nanos { 0 - 1 } else if a.nanos > b.nanos { 1 } else { 0 }",
    "pub let Duration.lt (a: Duration) (b: Duration): Bool = a.nanos < b.nanos",
    "pub let Duration.le (a: Duration) (b: Duration): Bool = a.nanos <= b.nanos",
    "pub let Duration.gt (a: Duration) (b: Duration): Bool = a.nanos > b.nanos",
    "pub let Duration.ge (a: Duration) (b: Duration): Bool = a.nanos >= b.nanos",
    "pub let Duration.min (a: Duration) (b: Duration): Duration = if a.nanos <= b.nanos { a } else { b }",
    "pub let Duration.max (a: Duration) (b: Duration): Duration = if a.nanos >= b.nanos { a } else { b }",
    "",
    "// --- Clocks ---",
    "",
    "// Wall clock, in milliseconds since the Unix epoch. The same clock",
    "// `now()` reads, at a resolution `now()` cannot express.",
    "//",
    "// It can jump: setting the system clock or an NTP correction moves",
    "// it, backwards included. Use it to say WHEN something happened;",
    "// use `instant` to measure how long something took.",
    "pub let now_millis (): Int = unsafe { time_now_nanos() / 1000000 }",
    "",
    "// A reading of the monotonic clock, for measuring elapsed time.",
    "// Never moves backwards and is unaffected by the system clock being",
    "// set.",
    "pub let instant (): Instant = unsafe { Instant { nanos: time_monotonic_nanos() } }",
    "",
    "// How long since `t0`. Never negative, because the clock it reads",
    "// cannot go backwards.",
    "pub let since (t0: Instant): Duration = unsafe { Duration { nanos: time_monotonic_nanos() - t0.nanos } }",
    "",
    "// The time between two instants, `later - earlier`. Negative if they",
    "// are given the wrong way round, which is information rather than an",
    "// error.",
    "pub let between (earlier: Instant) (later: Instant): Duration = Duration { nanos: later.nanos - earlier.nanos }",
    "",
    "// Sleeps for AT LEAST `d`, never at most: a sleep overshoots by",
    "// whatever the scheduler decides, and no caller can be promised",
    "// otherwise. A non-positive duration returns immediately.",
    "//",
    "// Windows sleeps in whole milliseconds, so a sub-millisecond request",
    "// rounds UP to one there rather than down to nothing.",
    "pub let sleep (d: Duration): Unit = unsafe { time_sleep_nanos(d.nanos); () }",
    "",
    "// --- Calendars ---",
    "//",
    "// Everything below is ordinary Plum on top of `Time.now()`, which is",
    "// the line the 0.0.7 notes drew and this keeps: the CLOCK is the part",
    "// a program cannot write for itself, and the CALENDAR is arithmetic",
    "// anyone could write but nobody should have to. Porting a real CLI",
    "// produced 40 lines of `civil_from_days` in a program that wanted a",
    "// timestamp in a README, which is what moved it here.",
    "//",
    "// UTC only. A timezone database is a data-shipping problem, not an",
    "// arithmetic one, and Plum ships no data.",
    "",
    "// Floor division and modulo, which is NOT what `/` and `%` do: those",
    "// truncate toward zero, so `-1 / 86400` is `0` and the day before the",
    "// epoch would land in 1970. Every calendar function below needs the",
    "// floor, and dates before 1970 are real dates.",
    "let plum__floor_div (a: Int) (b: Int): Int = {",
    "    let q = a / b;",
    "    if a - q * b != 0 && (a < 0) != (b < 0) { q - 1 } else { q }",
    "}",
    "",
    "let plum__floor_mod (a: Int) (b: Int): Int = a - plum__floor_div(a, b) * b",
    "",
    "// A civil date and time, as UTC. `weekday` is 0 for Sunday.",
    "pub struct DateTime {",
    "    pub year: Int, pub month: Int, pub day: Int,",
    "    pub hour: Int, pub minute: Int, pub second: Int,",
    "    pub weekday: Int,",
    "}",
    "",
    "// Howard Hinnant's `civil_from_days`: exact for every date in the",
    "// proleptic Gregorian calendar, with no lookup table and no leap-year",
    "// special case. It shifts the year to start in March so the leap day",
    "// falls at the END of the cycle, which is what removes the special",
    "// case rather than hiding it.",
    "//",
    "// The inner divisions all operate on non-negative values, so plain `/`",
    "// is right there; only `era` can go negative and it uses the floor.",
    "pub let utc (epoch: Int): DateTime = {",
    "    let days = plum__floor_div(epoch, 86400);",
    "    let secs = plum__floor_mod(epoch, 86400);",
    "    let z = days + 719468;",
    "    let era = plum__floor_div(z, 146097);",
    "    let doe = z - era * 146097;",
    "    let yoe = (doe - doe / 1460 + doe / 36524 - doe / 146096) / 365;",
    "    let doy = doe - (365 * yoe + yoe / 4 - yoe / 100);",
    "    let mp = (5 * doy + 2) / 153;",
    "    let d = doy - (153 * mp + 2) / 5 + 1;",
    "    let m = if mp < 10 { mp + 3 } else { mp - 9 };",
    "    DateTime {",
    "        year: yoe + era * 400 + (if m <= 2 { 1 } else { 0 }),",
    "        month: m,",
    "        day: d,",
    "        hour: secs / 3600,",
    "        minute: secs / 60 - secs / 3600 * 60,",
    "        second: secs - secs / 60 * 60,",
    "        // 1970-01-01 was a Thursday, which is index 4.",
    "        weekday: plum__floor_mod(days + 4, 7),",
    "    }",
    "}",
    "",
    "pub let weekday_name (weekday: Int): String =",
    "    [\"Sun\", \"Mon\", \"Tue\", \"Wed\", \"Thu\", \"Fri\", \"Sat\"][plum__floor_mod(weekday, 7)]",
    "",
    "pub let month_name (month: Int): String =",
    "    [\"Jan\", \"Feb\", \"Mar\", \"Apr\", \"May\", \"Jun\", \"Jul\", \"Aug\", \"Sep\", \"Oct\", \"Nov\", \"Dec\"][plum__floor_mod(month - 1, 12)]",
    "",
    "let plum__two (n: Int): String = String.pad_left(n.to_string(), 2, \"0\")",
    "",
    "// `2026-08-27T01:40:28Z` -- ISO 8601, which is the one to reach for",
    "// when a machine reads it back or when it needs to sort as text.",
    "pub let iso8601 (epoch: Int): String = {",
    "    let t = utc(epoch);",
    "    let date = String.pad_left(t.year.to_string(), 4, \"0\").concat(\"-\").concat(plum__two(t.month)).concat(\"-\").concat(plum__two(t.day));",
    "    date.concat(\"T\").concat(plum__two(t.hour)).concat(\":\").concat(plum__two(t.minute)).concat(\":\").concat(plum__two(t.second)).concat(\"Z\")",
    "}",
    "",
    "// `Thu, 27 Aug 2026 01:40:28 GMT` -- the HTTP date format (RFC 7231),",
    "// which is what a `Last-Modified` header and a good many generated",
    "// files want.",
    "pub let rfc7231 (epoch: Int): String = {",
    "    let t = utc(epoch);",
    "    let head = weekday_name(t.weekday).concat(\", \").concat(plum__two(t.day)).concat(\" \").concat(month_name(t.month));",
    "    let time = plum__two(t.hour).concat(\":\").concat(plum__two(t.minute)).concat(\":\").concat(plum__two(t.second));",
    "    head.concat(\" \").concat(t.year.to_string()).concat(\" \").concat(time).concat(\" GMT\")",
    "}",
], "\n")

// Turning a `JsonValue` into a real type, and saying WHERE it could
// not (issue #4).
//
// `json_parse` is in the prelude and gives back a faithful `JsonValue`.
// Reading `owner.login` out of one by hand means matching `JsonObject`,
// scanning an `Array[JsonEntry]`, and matching `JsonString` -- fifteen
// lines that say nothing about the program, once per field, and which
// have lost the field's NAME by the time they report a failure.
//
// A `Decoder[T]` is a value that knows how to do that, and decoders
// COMPOSE. The composition is what carries the path: `field("owner",
// d)` extends the path `d` reports against, so a failure five levels
// down names five levels without anyone threading a string. That is the
// whole design, and everything else here follows from it.
//
// A library, not syntax. No keyword, no grammar, nothing in the
// compiler knows this module exists -- it is ordinary Plum over a
// generic struct with a closure field, which is why it is a module and
// not a language feature.
//
// Deliberately NOT in the prelude, unlike `JsonValue` itself.
// `Decoder` is a type with its own operations rather than a namespace
// on an existing one, so nothing about `T.f(x)` method dispatch forces
// it to be always in scope, and a program that only parses JSON should
// not carry a decoding library it never names.
let cg_json_src (): String = Array.join([
    "// A decoder is a value that turns a `JsonValue` into a `T`, or says",
    "// why it cannot -- carrying the PATH it is currently looking at so a",
    "// failure names the field rather than the document.",
    "pub struct Decoder[T] { run: (JsonValue, String) -> Result[T, String] }",
    "",
    "// --- Paths ---",
    "//",
    "// The empty path is the document itself, and reads as \"the root\"",
    "// rather than as an empty string in a message.",
    "",
    "let at_str (p: String): String = if String.is_empty(p) { \"the root\" } else { p }",
    "",
    "let expected (what: String) (p: String): String =",
    "    \"expected \".concat(what).concat(\" at \").concat(at_str(p))",
    "",
    "let join_key (p: String) (k: String): String =",
    "    if String.is_empty(p) { k } else { p.concat(\".\").concat(k) }",
    "",
    "let join_index (p: String) (i: Int): String =",
    "    p.concat(\"[\").concat(i.to_string()).concat(\"]\")",
    "",
    "// --- Primitives ---",
    "",
    "pub let value (): Decoder[JsonValue] = Decoder { run: |v, p| Ok(v) }",
    "",
    "pub let string (): Decoder[String] =",
    "    Decoder { run: |v, p| match v {",
    "        JsonString(s) => Ok(s),",
    "        _ => Err(expected(\"String\", p)),",
    "    } }",
    "",
    "pub let bool (): Decoder[Bool] =",
    "    Decoder { run: |v, p| match v {",
    "        JsonBool(b) => Ok(b),",
    "        _ => Err(expected(\"Bool\", p)),",
    "    } }",
    "",
    "pub let float (): Decoder[Float] =",
    "    Decoder { run: |v, p| match v {",
    "        JsonNumber(f) => Ok(f),",
    "        _ => Err(expected(\"Number\", p)),",
    "    } }",
    "",
    "// JSON has one number type, so an `Int` decoder has to decide what to",
    "// do with `41.5`. It REFUSES rather than truncating: a fractional value",
    "// where a count was expected is a disagreement about the document, and",
    "// silently producing 41 hides it until something downstream is wrong",
    "// for a reason nobody can trace back to here.",
    "pub let int (): Decoder[Int] =",
    "    Decoder { run: |v, p| match v {",
    "        JsonNumber(f) => if f == Float.round(f) { Ok(f.to_int()) } else { Err(expected(\"a whole Number\", p)) },",
    "        _ => Err(expected(\"Number\", p)),",
    "    } }",
    "",
    "pub let null_as [T] (fallback: T): Decoder[T] =",
    "    Decoder { run: |v, p| match v {",
    "        JsonNull => Ok(fallback),",
    "        _ => Err(expected(\"null\", p)),",
    "    } }",
    "",
    "// --- Structure ---",
    "",
    "let lookup (entries: Array[JsonEntry]) (key: String) (i: Int): Option[JsonValue] =",
    "    if i >= entries.len() { None }",
    "    else if entries[i].key == key { Some(entries[i].value) }",
    "    else { lookup(entries, key, i + 1) }",
    "",
    "// Requires the key to be present. Its absence is a different failure",
    "// from its value being the wrong shape, and says so.",
    "pub let field [T] (key: String) (inner: Decoder[T]): Decoder[T] =",
    "    Decoder { run: |v, p| match v {",
    "        JsonObject(entries) => match lookup(entries, key, 0) {",
    "            Some(found) => inner.run(found, join_key(p, key)),",
    "            None => Err(\"no field `\".concat(key).concat(\"` at \").concat(at_str(p))),",
    "        },",
    "        _ => Err(expected(\"Object\", p)),",
    "    } }",
    "",
    "// Absent or null both give `None`, which is what an optional field in",
    "// a real API means. `field(k, nullable(d))` is the other reading --",
    "// the key must be there, and its value may be null -- and both",
    "// spellings exist because both situations do.",
    "pub let optional_field [T] (key: String) (inner: Decoder[T]): Decoder[Option[T]] =",
    "    Decoder { run: |v, p| match v {",
    "        JsonObject(entries) => match lookup(entries, key, 0) {",
    "            None => Ok(None),",
    "            Some(found) => match found {",
    "                JsonNull => Ok(None),",
    "                _ => Result.map(inner.run(found, join_key(p, key)), |x| Some(x)),",
    "            },",
    "        },",
    "        _ => Err(expected(\"Object\", p)),",
    "    } }",
    "",
    "pub let nullable [T] (inner: Decoder[T]): Decoder[Option[T]] =",
    "    Decoder { run: |v, p| match v {",
    "        JsonNull => Ok(None),",
    "        _ => Result.map(inner.run(v, p), |x| Some(x)),",
    "    } }",
    "",
    "// A LIST of keys rather than a dotted string: a key containing a dot",
    "// is ordinary JSON, and a path syntax would have to invent an escape",
    "// for it. It is also nothing but nested `field`s, which is why the",
    "// path in an error comes out right without this function knowing",
    "// anything about paths.",
    "pub let at [T] (keys: Array[String]) (inner: Decoder[T]): Decoder[T] =",
    "    at_acc(keys, keys.len() - 1, inner)",
    "",
    "let at_acc [T] (keys: Array[String]) (i: Int) (acc: Decoder[T]): Decoder[T] =",
    "    if i < 0 { acc } else { at_acc(keys, i - 1, field(keys[i], acc)) }",
    "",
    "pub let index [T] (i: Int) (inner: Decoder[T]): Decoder[T] =",
    "    Decoder { run: |v, p| match v {",
    "        JsonArray(items) =>",
    "            if i < 0 || i >= items.len() {",
    "                Err(\"index \".concat(i.to_string())",
    "                    .concat(\" out of range (length \").concat(items.len().to_string())",
    "                    .concat(\") at \").concat(at_str(p)))",
    "            } else {",
    "                inner.run(items[i], join_index(p, i))",
    "            },",
    "        _ => Err(expected(\"Array\", p)),",
    "    } }",
    "",
    "pub let list [T] (inner: Decoder[T]): Decoder[Array[T]] =",
    "    Decoder { run: |v, p| match v {",
    "        JsonArray(items) => list_acc(inner, items, p, 0, []),",
    "        _ => Err(expected(\"Array\", p)),",
    "    } }",
    "",
    "// Stops at the first element that fails, and reports THAT element's",
    "// index. Collecting every failure would need a second error type and",
    "// would still leave a caller with no value.",
    "let list_acc [T] (inner: Decoder[T]) (items: Array[JsonValue]) (p: String) (i: Int) (acc: Array[T]): Result[Array[T], String] =",
    "    if i >= items.len() { Ok(acc) }",
    "    else {",
    "        match inner.run(items[i], join_index(p, i)) {",
    "            Err(e) => Err(e),",
    "            Ok(x) => list_acc(inner, items, p, i + 1, acc.push(x)),",
    "        }",
    "    }",
    "",
    "// --- Combining ---",
    "//",
    "// One `mapN` per arity, because Plum has no variadics and no way to",
    "// partially apply an n-ary closure. Six covers a struct with six",
    "// fields; past that, `and_then` composes without limit.",
    "",
    "pub let map [A, T] (a: Decoder[A]) (f: (A) -> T): Decoder[T] =",
    "    Decoder { run: |v, p| Result.map(a.run(v, p), f) }",
    "",
    "pub let map2 [A, B, T] (a: Decoder[A]) (b: Decoder[B]) (f: (A, B) -> T): Decoder[T] =",
    "    Decoder { run: |v, p| match a.run(v, p) {",
    "        Err(e) => Err(e),",
    "        Ok(x1) => match b.run(v, p) {",
    "            Err(e) => Err(e),",
    "            Ok(x2) => Ok(f(x1, x2)),",
    "        },",
    "    } }",
    "",
    "pub let map3 [A, B, C, T] (a: Decoder[A]) (b: Decoder[B]) (c: Decoder[C]) (f: (A, B, C) -> T): Decoder[T] =",
    "    Decoder { run: |v, p| match a.run(v, p) {",
    "        Err(e) => Err(e),",
    "        Ok(x1) => match b.run(v, p) {",
    "            Err(e) => Err(e),",
    "            Ok(x2) => match c.run(v, p) {",
    "                Err(e) => Err(e),",
    "                Ok(x3) => Ok(f(x1, x2, x3)),",
    "            },",
    "        },",
    "    } }",
    "",
    "pub let map4 [A, B, C, D, T] (a: Decoder[A]) (b: Decoder[B]) (c: Decoder[C]) (d: Decoder[D]) (f: (A, B, C, D) -> T): Decoder[T] =",
    "    Decoder { run: |v, p| match a.run(v, p) {",
    "        Err(e) => Err(e),",
    "        Ok(x1) => match b.run(v, p) {",
    "            Err(e) => Err(e),",
    "            Ok(x2) => match c.run(v, p) {",
    "                Err(e) => Err(e),",
    "                Ok(x3) => match d.run(v, p) {",
    "                    Err(e) => Err(e),",
    "                    Ok(x4) => Ok(f(x1, x2, x3, x4)),",
    "                },",
    "            },",
    "        },",
    "    } }",
    "",
    "pub let map5 [A, B, C, D, E, T] (a: Decoder[A]) (b: Decoder[B]) (c: Decoder[C]) (d: Decoder[D]) (e: Decoder[E]) (f: (A, B, C, D, E) -> T): Decoder[T] =",
    "    Decoder { run: |v, p| match a.run(v, p) {",
    "        Err(err) => Err(err),",
    "        Ok(x1) => match b.run(v, p) {",
    "            Err(err) => Err(err),",
    "            Ok(x2) => match c.run(v, p) {",
    "                Err(err) => Err(err),",
    "                Ok(x3) => match d.run(v, p) {",
    "                    Err(err) => Err(err),",
    "                    Ok(x4) => match e.run(v, p) {",
    "                        Err(err) => Err(err),",
    "                        Ok(x5) => Ok(f(x1, x2, x3, x4, x5)),",
    "                    },",
    "                },",
    "            },",
    "        },",
    "    } }",
    "",
    "pub let map6 [A, B, C, D, E, F, T] (a: Decoder[A]) (b: Decoder[B]) (c: Decoder[C]) (d: Decoder[D]) (e: Decoder[E]) (g: Decoder[F]) (f: (A, B, C, D, E, F) -> T): Decoder[T] =",
    "    Decoder { run: |v, p| match a.run(v, p) {",
    "        Err(err) => Err(err),",
    "        Ok(x1) => match b.run(v, p) {",
    "            Err(err) => Err(err),",
    "            Ok(x2) => match c.run(v, p) {",
    "                Err(err) => Err(err),",
    "                Ok(x3) => match d.run(v, p) {",
    "                    Err(err) => Err(err),",
    "                    Ok(x4) => match e.run(v, p) {",
    "                        Err(err) => Err(err),",
    "                        Ok(x5) => match g.run(v, p) {",
    "                            Err(err) => Err(err),",
    "                            Ok(x6) => Ok(f(x1, x2, x3, x4, x5, x6)),",
    "                        },",
    "                    },",
    "                },",
    "            },",
    "        },",
    "    } }",
    "",
    "// --- Choosing ---",
    "",
    "pub let succeed [T] (x: T): Decoder[T] = Decoder { run: |v, p| Ok(x) }",
    "",
    "// A user-written failure gets the same ` at <path>` treatment as a",
    "// built-in one, so the message should be a clause and not a sentence.",
    "pub let fail [T] (msg: String): Decoder[T] =",
    "    Decoder { run: |v, p| Err(msg.concat(\" at \").concat(at_str(p))) }",
    "",
    "// Runs a decoder chosen by what the first one produced -- a version",
    "// field deciding how to read the rest of the payload, which no amount",
    "// of `mapN` can express.",
    "pub let and_then [A, T] (a: Decoder[A]) (f: (A) -> Decoder[T]): Decoder[T] =",
    "    Decoder { run: |v, p| match a.run(v, p) {",
    "        Err(e) => Err(e),",
    "        Ok(x) => {",
    "            let next = f(x);",
    "            next.run(v, p)",
    "        },",
    "    } }",
    "",
    "// The first alternative that succeeds. The individual failures are",
    "// DISCARDED: `one_of` is used where several shapes are equally",
    "// acceptable, and a caller told that the value was neither a String",
    "// nor a Number learns more from that than from both attempts quoted",
    "// back at them.",
    "pub let one_of [T] (options: Array[Decoder[T]]): Decoder[T] =",
    "    Decoder { run: |v, p| one_of_acc(options, v, p, 0) }",
    "",
    "let one_of_acc [T] (options: Array[Decoder[T]]) (v: JsonValue) (p: String) (i: Int): Result[T, String] =",
    "    if i >= options.len() { Err(\"no alternative matched at \".concat(at_str(p))) }",
    "    else {",
    "        match options[i].run(v, p) {",
    "            Ok(x) => Ok(x),",
    "            Err(e) => one_of_acc(options, v, p, i + 1),",
    "        }",
    "    }",
    "",
    "// --- Running ---",
    "",
    "pub let decode [T] (d: Decoder[T]) (v: JsonValue): Result[T, String] = d.run(v, \"\")",
    "",
    "// Parses and decodes in one step. A parse error arrives phrased by",
    "// `json_parse` and unchanged, so a caller has ONE error path rather",
    "// than two -- which is the difference between `match` and nested",
    "// `match`.",
    "pub let decode_string [T] (d: Decoder[T]) (text: String): Result[T, String] =",
    "    match json_parse(text) {",
    "        Err(e) => Err(e),",
    "        Ok(v) => d.run(v, \"\"),",
    "    }",
], "\n")
