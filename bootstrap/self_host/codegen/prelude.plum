// The PRELUDE, in Plum — prepended to every program this backend
// compiles, exactly as `crates/plumc`'s own `STDLIB_*_SRC` constants
// are prepended by the real compiler.
//
// Carried as source text rather than loaded from a file so a compiled
// `sh` needs nothing beside it on disk, which is the same reason the
// real compiler embeds its own.
//
// **These are compiled by this backend, not special-cased in it.**
// That is the point: a prelude written in Plum is a prelude that
// proves the backend can handle real Plum. Every function here goes
// through the same type checker, the same monomorphizer and the same
// emitter as user code — `Array.slice[T]` is a genuine generic function
// that gets specialized per element type, not a builtin pretending to
// be one.
//
// Only what CANNOT be written in Plum lives in `runtime.plum` instead:
// today that is `chars_of` alone, because codepoint awareness has to
// bottom out somewhere. Everything else here is ordinary source.
//
// The definitions mirror `crates/plumc/src/lib.rs`'s own prelude
// closely enough to be recognisable, but they are not copied
// mechanically: a few are rewritten to avoid prelude functions this
// backend doesn't have yet (`Array.take`/`Array.drop`), and the JSON
// number parser `String.parse_float` delegates to in the real compiler
// is replaced by a direct one, since dragging in a JSON parser to read
// a float would be absurd here.
//
// **Private helpers are prefixed `plum__`.** A prelude's own internal
// helpers must not be able to collide with a user's functions, and in
// this bootstrap they genuinely can: modules are merged into one flat
// namespace (see `main.plum`), so an unprefixed `array_contains_acc`
// here silently shadowed `interp.plum`'s own function of that name and
// made the compiler fail to type-check itself with "argument 0: T !=
// Value". Public prelude names are deliberately NOT prefixed — those
// are the API, and shadowing one is a user's prerogative.
//
// `Option`/`Result` are DECLARED here. The type checker seeds them
// itself (`context.plum`'s `builtin_context`), but the backend needs
// real declarations to assign variant tags and payload slots — a tag is
// a layout decision, and nothing in the checker makes it.

pub let cg_prelude_src (unit: Unit): String = cg_lines([
    "pub enum Option[T] { Some(T), None }",
    "pub enum Result[T, E] { Ok(T), Err(E) }",
    "",
    "pub let Option.is_some[T] (o: Option[T]): Bool = match o { Some(_) => true, None => false }",
    "pub let Option.is_none[T] (o: Option[T]): Bool = match o { Some(_) => false, None => true }",
    "pub let Option.unwrap_or[T] (o: Option[T]) (fallback: T): T = match o { Some(v) => v, None => fallback }",
    "pub let Option.unwrap_or_else[T] (o: Option[T]) (f: () -> T): T = match o { Some(v) => v, None => f() }",
    "pub let Option.map[T, U] (o: Option[T]) (f: (T) -> U): Option[U] = match o { Some(v) => Some(f(v)), None => None }",
    "pub let Option.and_then[T, U] (o: Option[T]) (f: (T) -> Option[U]): Option[U] = match o { Some(v) => f(v), None => None }",
    "pub let Option.ok_or[T, E] (o: Option[T]) (err: E): Result[T, E] = match o { Some(v) => Ok(v), None => Err(err) }",
    "",
    "pub let Result.is_ok[T, E] (r: Result[T, E]): Bool = match r { Ok(_) => true, Err(_) => false }",
    "pub let Result.is_err[T, E] (r: Result[T, E]): Bool = match r { Ok(_) => false, Err(_) => true }",
    "pub let Result.unwrap_or[T, E] (r: Result[T, E]) (fallback: T): T = match r { Ok(v) => v, Err(_) => fallback }",
    "pub let Result.unwrap_or_else[T, E] (r: Result[T, E]) (f: (E) -> T): T = match r { Ok(v) => v, Err(e) => f(e) }",
    "pub let Result.map[T, E, U] (r: Result[T, E]) (f: (T) -> U): Result[U, E] = match r { Ok(v) => Ok(f(v)), Err(e) => Err(e) }",
    "pub let Result.map_err[T, E, F] (r: Result[T, E]) (f: (E) -> F): Result[T, F] = match r { Ok(v) => Ok(v), Err(e) => Err(f(e)) }",
    "pub let Result.and_then[T, E, U] (r: Result[T, E]) (f: (T) -> Result[U, E]): Result[U, E] = match r { Ok(v) => f(v), Err(e) => Err(e) }",
    "",
    "pub let Array.is_empty[T] (xs: Array[T]): Bool = xs.len() == 0",
    "",
    "let plum__array_concat_acc[T] (a: Array[T]) (b: Array[T]) (i: Int): Array[T] =",
    "    if i >= b.len() { a } else { plum__array_concat_acc(a.push(b[i]), b, i + 1) }",
    "pub let Array.concat[T] (a: Array[T]) (b: Array[T]): Array[T] = plum__array_concat_acc(a, b, 0)",
    "",
    "let plum__array_contains_acc[T] (xs: Array[T]) (needle: T) (i: Int): Bool =",
    "    if i >= xs.len() { false } else if xs[i] == needle { true } else { plum__array_contains_acc(xs, needle, i + 1) }",
    "pub let Array.contains[T] (xs: Array[T]) (needle: T): Bool = plum__array_contains_acc(xs, needle, 0)",
    "",
    "let plum__array_any_acc[T] (xs: Array[T]) (f: (T) -> Bool) (i: Int): Bool =",
    "    if i >= xs.len() { false } else if f(xs[i]) { true } else { plum__array_any_acc(xs, f, i + 1) }",
    "pub let Array.any[T] (xs: Array[T]) (f: (T) -> Bool): Bool = plum__array_any_acc(xs, f, 0)",
    "",
    "// Clamped at both ends, like the real prelude's own: a slice past",
    "// the end is the tail, not a crash -- which matters because this",
    "// backend emits no bounds check of its own.",
    "let plum__array_slice_acc[T] (xs: Array[T]) (i: Int) (end: Int) (acc: Array[T]): Array[T] =",
    "    if i >= end { acc } else if i >= xs.len() { acc } else { plum__array_slice_acc(xs, i + 1, end, acc.push(xs[i])) }",
    "pub let Array.slice[T] (xs: Array[T]) (start: Int) (end: Int): Array[T] =",
    "    plum__array_slice_acc(xs, if start < 0 { 0 } else { start }, end, [])",
    "",
    "let plum__array_reverse_acc[T] (xs: Array[T]) (i: Int) (acc: Array[T]): Array[T] =",
    "    if i < 0 { acc } else { plum__array_reverse_acc(xs, i - 1, acc.push(xs[i])) }",
    "pub let Array.reverse[T] (xs: Array[T]): Array[T] = plum__array_reverse_acc(xs, xs.len() - 1, [])",
    "",
    "let plum__array_all_acc[T] (xs: Array[T]) (f: (T) -> Bool) (i: Int): Bool =",
    "    if i >= xs.len() { true } else if f(xs[i]) { plum__array_all_acc(xs, f, i + 1) } else { false }",
    "pub let Array.all[T] (xs: Array[T]) (f: (T) -> Bool): Bool = plum__array_all_acc(xs, f, 0)",
    "",
    "let plum__array_find_acc[T] (xs: Array[T]) (f: (T) -> Bool) (i: Int): Option[T] =",
    "    if i >= xs.len() { None } else if f(xs[i]) { Some(xs[i]) } else { plum__array_find_acc(xs, f, i + 1) }",
    "pub let Array.find[T] (xs: Array[T]) (f: (T) -> Bool): Option[T] = plum__array_find_acc(xs, f, 0)",
    "",
    "let plum__array_find_index_acc[T] (xs: Array[T]) (f: (T) -> Bool) (i: Int): Option[Int] =",
    "    if i >= xs.len() { None } else if f(xs[i]) { Some(i) } else { plum__array_find_index_acc(xs, f, i + 1) }",
    "pub let Array.find_index[T] (xs: Array[T]) (f: (T) -> Bool): Option[Int] = plum__array_find_index_acc(xs, f, 0)",
    "",
    "pub let Array.index_of[T] (xs: Array[T]) (needle: T): Option[Int] = Array.find_index(xs, |x| x == needle)",
    "pub let Array.first[T] (xs: Array[T]): Option[T] = if Array.is_empty(xs) { None } else { Some(xs[0]) }",
    "pub let Array.last[T] (xs: Array[T]): Option[T] = if Array.is_empty(xs) { None } else { Some(xs[xs.len() - 1]) }",
    "pub let Array.take[T] (xs: Array[T]) (n: Int): Array[T] = Array.slice(xs, 0, n)",
    "pub let Array.drop[T] (xs: Array[T]) (n: Int): Array[T] = Array.slice(xs, n, xs.len())",
    "",
    "pub let Array.sum_int (xs: Array[Int]): Int = Array.fold(xs, 0, |acc, x| acc + x)",
    "pub let Array.sum_float (xs: Array[Float]): Float = Array.fold(xs, 0.0, |acc, x| acc + x)",
    "",
    "// --- Numbers ---",
    "",
    "pub let Int.abs (a: Int): Int = if a < 0 { 0 - a } else { a }",
    "pub let Int.min (a: Int) (b: Int): Int = if a < b { a } else { b }",
    "pub let Int.max (a: Int) (b: Int): Int = if a > b { a } else { b }",
    "pub let Int.clamp (x: Int) (lo: Int) (hi: Int): Int = Int.min(Int.max(x, lo), hi)",
    "",
    "pub let Float.abs (a: Float): Float = if a < 0.0 { 0.0 - a } else { a }",
    "pub let Float.min (a: Float) (b: Float): Float = if a < b { a } else { b }",
    "pub let Float.max (a: Float) (b: Float): Float = if a > b { a } else { b }",
    "pub let Float.clamp (x: Float) (lo: Float) (hi: Float): Float = Float.min(Float.max(x, lo), hi)",
    "",
    "// --- Strings ---",
    "//",
    "// All of these are built on `chars_of`, which is the one primitive",
    "// in `runtime.plum`. That is what makes them codepoint-safe rather",
    "// than byte-indexed -- `String.slice` can never split a multi-byte",
    "// character in half, because it never sees bytes at all.",
    "let plum__chars_join_acc (cs: Array[String]) (i: Int) (acc: String): String =",
    "    if i >= cs.len() { acc } else { plum__chars_join_acc(cs, i + 1, acc.concat(cs[i])) }",
    "pub let chars_join (cs: Array[String]): String = plum__chars_join_acc(cs, 0, \"\")",
    "",
    "pub let string_reverse (s: String): String = chars_join(Array.reverse(chars_of(s)))",
    "pub let String.is_empty (s: String): Bool = s.len() == 0",
    "pub let String.slice (s: String) (start: Int) (end: Int): String = chars_join(Array.slice(chars_of(s), start, end))",
    "pub let String.repeat (s: String) (n: Int): String = if n <= 0 { \"\" } else { s.concat(String.repeat(s, n - 1)) }",
    "",
    "// File I/O. `read_file_raw` is a runtime primitive returning an",
    "// array -- empty for failure, one element for success -- because",
    "// hand-written runtime IR cannot construct a `Result` without",
    "// hard-coding tag numbers the backend assigns per program. The",
    "// wrapping happens here, where `Ok`/`Err` are ordinary variants.",
    "let read_file_raw (path: String): Array[String] = []",
    "pub let read_file (path: String): Result[String, String] = {",
    "    let r = read_file_raw(path);",
    "    if Array.is_empty(r) { Err(\"could not read \".concat(path)) } else { Ok(r[0]) }",
    "}",
    "let string_hash_raw (s: String): Int = 0",
    "pub let String.hash (s: String): Int = string_hash_raw(s)",
    "let write_file_raw (path: String) (contents: String): Bool = false",
    "pub let write_file (path: String) (contents: String): Result[Unit, String] =",
    "    if write_file_raw(path, contents) { Ok(()) } else { Err(\"could not write \".concat(path)) }",
    "",
    "// Running a program. `process_run` takes its arguments TAB-joined",
    "// in a single string because an extern boundary has no",
    "// `Array[String]` -- see `native_stdlib/process_shim.c`. The join",
    "// happens here rather than in the runtime, where it would have to",
    "// be written in IR.",
    "let process_run_raw (program: String) (args_joined: String) (argc: Int): Int = 0",
    "let process_exit_code_raw (handle: Int): Int = 0",
    "let process_stdout_raw (handle: Int): String = \"\"",
    "let process_stderr_raw (handle: Int): String = \"\"",
    "let process_free_raw (handle: Int): Bool = false",
    "pub struct ProcessResult { exit_code: Int, stdout: String, stderr: String }",
    "// NO leading separator: `process_run` points argv[1] at the WHOLE",
    "// joined string, so a leading tab makes argv[1] empty and pushes",
    "// the last real argument past `argc`, silently dropping it. Mirrors",
    "// the real prelude's `join_args_acc` exactly -- a plain fold that",
    "// prefixes every element is NOT equivalent.",
    "let join_args_acc (args: Array[String]) (i: Int) (acc: String): String =",
    "    if i >= args.len() { acc }",
    "    else if i == 0 { join_args_acc(args, i + 1, args[i]) }",
    "    else { join_args_acc(args, i + 1, acc.concat(\"\\t\").concat(args[i])) }",
    "// Mirrors the real prelude's `run_process` EXACTLY, including that",
    "// a non-zero exit code is an ordinary `Ok` -- `Err` means the",
    "// process could not be started at all. `main.plum` is compiled by",
    "// both compilers, so the two must agree.",
    "pub let run_process (program: String) (args: Array[String]): Result[ProcessResult, String] = {",
    "    let joined = join_args_acc(args, 0, \"\");",
    "    let handle = process_run_raw(program, joined, args.len());",
    "    if handle < 0 { Err(\"run_process: could not start process: \".concat(program)) }",
    "    else {",
    "        let result = ProcessResult {",
    "            exit_code: process_exit_code_raw(handle),",
    "            stdout: process_stdout_raw(handle),",
    "            stderr: process_stderr_raw(handle),",
    "        };",
    "        let freed = process_free_raw(handle);",
    "        Ok(result)",
    "    }",
    "}",
    "",
    "// Directory access. The four `..._raw`/`..._handle` names below are",
    "// RUNTIME primitives -- their Plum bodies here exist only to give",
    "// the type checker a signature and are never compiled (see",
    "// `cg_runtime_fn`). `list_dir`/`is_directory` themselves are",
    "// ordinary Plum, and mirror the real prelude's own versions",
    "// closely, including `is_directory`'s three-way result: a path that",
    "// does not exist is a real `Err`, not silently `Ok(false)`.",
    "let path_is_dir_raw (path: String): Int = 0",
    "let dir_open_handle (path: String): Int = 0",
    "let dir_next_entry (handle: Int): String = \"\"",
    "let dir_close_handle (handle: Int): Unit = ()",
    "",
    "let dir_read_all_acc (handle: Int) (acc: Array[String]): Array[String] = {",
    "    let name = dir_next_entry(handle);",
    "    if String.is_empty(name) { acc } else { dir_read_all_acc(handle, acc.push(name)) }",
    "}",
    "",
    "pub let list_dir (path: String): Result[Array[String], String] = {",
    "    let handle = dir_open_handle(path);",
    "    if handle < 0 { Err(\"list_dir: could not open directory: \".concat(path)) }",
    "    else {",
    "        let entries = dir_read_all_acc(handle, []);",
    "        dir_close_handle(handle);",
    "        Ok(entries)",
    "    }",
    "}",
    "",
    "pub let is_directory (path: String): Result[Bool, String] = {",
    "    let r = path_is_dir_raw(path);",
    "    if r < 0 { Err(\"is_directory: path does not exist: \".concat(path)) }",
    "    else { Ok(r == 1) }",
    "}",
    "",
    "pub let string_is_ascii_ws (c: String): Bool = c == \" \" || c == \"\\t\" || c == \"\\n\" || c == \"\\r\"",
    "",
    "let plum__string_matches_at (cs: Array[String]) (needle: Array[String]) (base: Int) (j: Int): Bool =",
    "    if j >= needle.len() { true }",
    "    else if cs[base + j] != needle[j] { false }",
    "    else { plum__string_matches_at(cs, needle, base, j + 1) }",
    "",
    "let plum__string_index_of_acc (cs: Array[String]) (needle: Array[String]) (i: Int): Option[Int] =",
    "    if i + needle.len() > cs.len() { None }",
    "    else if plum__string_matches_at(cs, needle, i, 0) { Some(i) }",
    "    else { plum__string_index_of_acc(cs, needle, i + 1) }",
    "pub let String.index_of (s: String) (needle: String): Option[Int] = plum__string_index_of_acc(chars_of(s), chars_of(needle), 0)",
    "",
    "// --- Namespaced forms of the string METHODS ---",
    "//",
    "// `.len()`, `.split()`, `.replace()` and friends are compiler",
    "// PRIMITIVES lowered straight to IR, so they existed only as",
    "// methods, while `String.slice`/`index_of`/`lines`/`repeat`/",
    "// `trim_start`/`trim_end` are ordinary prelude functions and so",
    "// existed only namespaced. That split tracks how each one happens",
    "// to be implemented, which is invisible from outside and produced",
    "// a genuinely confusing surface: `\"x\".trim()` worked and",
    "// `String.trim(\"x\")` did not, while `String.trim_start(\"x\")`",
    "// worked and `\"x\".trim_start()` did not. Same family, opposite",
    "// rules, no way to tell which without trying.",
    "//",
    "// The rule now: `String.f(s, ..)` always works. Some also have",
    "// method sugar. These wrappers cost nothing when unused --",
    "// dead-function elimination drops them.",
    "pub let String.len (s: String): Int = s.len()",
    "pub let String.split (s: String) (sep: String): Array[String] = s.split(sep)",
    "pub let String.contains (s: String) (needle: String): Bool = s.contains(needle)",
    "pub let String.starts_with (s: String) (prefix: String): Bool = s.starts_with(prefix)",
    "pub let String.ends_with (s: String) (suffix: String): Bool = s.ends_with(suffix)",
    "pub let String.replace (s: String) (from: String) (to: String): String = s.replace(from, to)",
    "pub let String.to_upper (s: String): String = s.to_upper()",
    "pub let String.to_lower (s: String): String = s.to_lower()",
    "pub let String.trim (s: String): String = s.trim()",
    "",
    "// The one string operation that had NEITHER form: there was no way",
    "// to join an array of strings with a separator at all.",
    "let plum__join_acc (parts: Array[String]) (sep: String) (i: Int) (acc: Array[String]): Array[String] =",
    "    if i >= parts.len() { acc }",
    "    else if i == 0 { plum__join_acc(parts, sep, 1, acc.push(parts[0])) }",
    "    else { plum__join_acc(parts, sep, i + 1, acc.push(sep).push(parts[i])) }",
    "",
    "pub let String.join (parts: Array[String]) (sep: String): String = String.concat_all(plum__join_acc(parts, sep, 0, []))",
    "",
    "let plum__string_digit_value (c: String): Result[Int, String] = match c {",
    "    \"0\" => Ok(0), \"1\" => Ok(1), \"2\" => Ok(2), \"3\" => Ok(3), \"4\" => Ok(4),",
    "    \"5\" => Ok(5), \"6\" => Ok(6), \"7\" => Ok(7), \"8\" => Ok(8), \"9\" => Ok(9),",
    "    _ => Err(\"expected a digit, found \".concat(c)),",
    "}",
    "",
    "let plum__string_parse_int_acc (cs: Array[String]) (i: Int) (acc: Int) (any: Bool): Result[Int, String] =",
    "    if i >= cs.len() { if any { Ok(acc) } else { Err(\"expected at least one digit\") } }",
    "    else { match plum__string_digit_value(cs[i]) {",
    "        // Range is checked BEFORE multiplying, not after. `*` and",
    "        // `+` on Int abort the program on overflow (2026-08-21), so",
    "        // an out-of-range literal used to KILL a program that had",
    "        // asked for a `Result` precisely so it could handle bad",
    "        // input -- `String.parse_int(\"99999999999999999999\")` printed",
    "        // `integer overflow` and exited 1 instead of returning Err.",
    "        // Before that change the backends wrapped and returned a",
    "        // garbage number instead, which was no better.",
    "        //",
    "        // 922337203685477580 is Int::MAX / 10: one more and `acc * 10`",
    "        // itself overflows.",
    "        Ok(d) => if acc > 922337203685477580 { Err(\"integer out of range\") }",
    "                 else if acc * 10 > 9223372036854775807 - d { Err(\"integer out of range\") }",
    "                 else { plum__string_parse_int_acc(cs, i + 1, acc * 10 + d, true) },",
    "        Err(e) => Err(e),",
    "    } }",
    "",
    "pub let String.parse_int (s: String): Result[Int, String] = {",
    "    let cs = chars_of(s);",
    "    if Array.is_empty(cs) { Err(\"empty string\") }",
    "    else if cs[0] == \"-\" { match plum__string_parse_int_acc(Array.slice(cs, 1, cs.len()), 0, 0, false) { Ok(n) => Ok(0 - n), Err(e) => Err(e) } }",
    "    else { plum__string_parse_int_acc(cs, 0, 0, false) }",
    "}",
    "",
    "// A direct float parser. The real prelude reuses the JSON number",
    "// parser here, which is the right call THERE (it already exists and",
    "// is tested) and the wrong one here -- dragging a JSON parser in to",
    "// read a float would be absurd. Sign, integer part, optional",
    "// fraction; no exponent, which is a real narrowing, stated rather",
    "// than discovered.",
    "// The fraction accumulates as an INTEGER and is divided ONCE at the",
    "// end. It used to add `d * scale` per digit with `scale` starting at",
    "// 0.1 and divided by ten each step -- and 0.1 is not representable",
    "// in binary, so every step compounded the error. `0.000001` parsed",
    "// as 1.0000000000000002e-06.",
    "//",
    "// That was invisible until floats started printing every digit that",
    "// matters (2026-08-21); `%.15g` rendered the wrong answer and the",
    "// right one identically. One division of an exact integer by an",
    "// exact power of ten is correctly rounded, which is what `strtod`",
    "// would give.",
    "//",
    "// Accumulation STOPS past ~18 digits, which a double cannot use",
    "// anyway -- and, since `*` became checked, `acc * 10` would",
    "// otherwise overflow and ABORT the program on a long literal.",
    "// The remaining digits are still validated.",
    "let plum__string_parse_frac (cs: Array[String]) (i: Int) (acc: Int) (div: Float): Result[Float, String] =",
    "    if i >= cs.len() { Ok(acc.to_float() / div) }",
    "    else { match plum__string_digit_value(cs[i]) {",
    "        Ok(d) => if acc > 922337203685477580 { plum__string_parse_frac(cs, i + 1, acc, div) }",
    "                 else { plum__string_parse_frac(cs, i + 1, acc * 10 + d, div * 10.0) },",
    "        Err(e) => Err(e),",
    "    } }",
    "",
    "let plum__string_parse_float_body (cs: Array[String]): Result[Float, String] =",
    "    match String.index_of(chars_join(cs), \".\") {",
    "        None => match plum__string_parse_int_acc(cs, 0, 0, false) { Ok(n) => Ok(n.to_float()), Err(e) => Err(e) },",
    "        Some(dot) => match plum__string_parse_int_acc(Array.slice(cs, 0, dot), 0, 0, false) {",
    "            Err(e) => Err(e),",
    "            Ok(whole) => match plum__string_parse_frac(Array.slice(cs, dot + 1, cs.len()), 0, 0, 1.0) {",
    "                Err(e) => Err(e),",
    "                Ok(frac) => Ok(whole.to_float() + frac),",
    "            },",
    "        },",
    "    }",
    "",
    "pub let String.parse_float (s: String): Result[Float, String] = {",
    "    let cs = chars_of(s);",
    "    if Array.is_empty(cs) { Err(\"empty string\") }",
    "    else if cs[0] == \"-\" { match plum__string_parse_float_body(Array.slice(cs, 1, cs.len())) { Ok(f) => Ok(0.0 - f), Err(e) => Err(e) } }",
    "    else { plum__string_parse_float_body(cs) }",
    "}",
    "",
    "",
    "// --- Sorting ---",
    "",
    "// Insertion sort, mirroring the real prelude exactly. Quadratic and",
    "// deliberately so: it is stable, it is obviously correct by reading,",
    "// and every array this compiler sorts is small.",
    "let plum__array_sort_insert_acc[T] (sorted: Array[T]) (x: T) (le: (T, T) -> Bool) (i: Int): Array[T] =",
    "    if i >= sorted.len() { sorted.push(x) }",
    "    else if le(x, sorted[i]) { Array.concat(Array.take(sorted, i).push(x), Array.drop(sorted, i)) }",
    "    else { plum__array_sort_insert_acc(sorted, x, le, i + 1) }",
    "",
    "let plum__array_sort_insert[T] (sorted: Array[T]) (x: T) (le: (T, T) -> Bool): Array[T] = plum__array_sort_insert_acc(sorted, x, le, 0)",
    "",
    "let plum__array_sort_by_acc[T] (arr: Array[T]) (le: (T, T) -> Bool) (i: Int) (acc: Array[T]): Array[T] =",
    "    if i >= arr.len() { acc } else { plum__array_sort_by_acc(arr, le, i + 1, plum__array_sort_insert(acc, arr[i], le)) }",
    "",
    "pub let Array.sort_by[T] (arr: Array[T]) (le: (T, T) -> Bool): Array[T] = plum__array_sort_by_acc(arr, le, 0, [])",
    "",
    "pub let Array.sort_int (arr: Array[Int]): Array[Int] = Array.sort_by(arr, |a: Int, b: Int| a <= b)",
    "pub let Array.sort_float (arr: Array[Float]): Array[Float] = Array.sort_by(arr, |a: Float, b: Float| a <= b)",
    "",
    "// `Array.sort_string` is deliberately ABSENT: the real prelude compares",
    "// via `a.runes()`, and this compiler has no `.runes()` primitive. It",
    "// belongs with `Float.sqrt` and friends -- the group that needs a",
    "// runtime primitive rather than prelude source -- not here.",
    "",
    "// --- Zip ---",
    "",
    "// A named struct, not a tuple, exactly as the real prelude has it.",
    "pub struct Zipped[A, B] { first: A, second: B }",
    "",
    "let plum__array_zip_acc[T, U] (a: Array[T]) (b: Array[U]) (i: Int) (acc: Array[Zipped[T, U]]): Array[Zipped[T, U]] =",
    "    if i >= a.len() || i >= b.len() { acc } else { plum__array_zip_acc(a, b, i + 1, acc.push(Zipped { first: a[i], second: b[i] })) }",
    "",
    "pub let Array.zip[T, U] (a: Array[T]) (b: Array[U]): Array[Zipped[T, U]] = plum__array_zip_acc(a, b, 0, [])",
    "",
    "// --- String trimming ---",
    "",
    "let plum__string_is_ascii_ws (c: String): Bool = c == \" \" || c == \"\\t\" || c == \"\\n\" || c == \"\\r\"",
    "",
    "let plum__string_ws_prefix_len_acc (chars: Array[String]) (i: Int): Int =",
    "    if i >= chars.len() { i } else if plum__string_is_ascii_ws(chars[i]) { plum__string_ws_prefix_len_acc(chars, i + 1) } else { i }",
    "",
    "pub let String.trim_start (s: String): String = {",
    "    let chars = chars_of(s);",
    "    chars_join(Array.drop(chars, plum__string_ws_prefix_len_acc(chars, 0)))",
    "}",
    "",
    "pub let String.trim_end (s: String): String = string_reverse(String.trim_start(string_reverse(s)))",
    "",
    "pub let String.lines (s: String): Array[String] = s.split(\"\\n\")",
    "",
    "// --- Numbers that need the runtime ---",
    "",
    "// The real prelude writes these as `unsafe { sqrt(x) }` and friends.",
    "// This backend has no `extern \"C\"`/`unsafe` support, so they reach the",
    "// same libm functions as runtime primitives instead.",
    "let sqrt_raw (x: Float): Float = 0.0",
    "let pow_raw (b: Float) (e: Float): Float = 0.0",
    "let floor_raw (x: Float): Float = 0.0",
    "let ceil_raw (x: Float): Float = 0.0",
    "let round_raw (x: Float): Float = 0.0",
    "let random_raw (ignored: Bool): Float = 0.0",
    "",
    "pub let Float.sqrt (x: Float): Float = sqrt_raw(x)",
    "pub let Float.pow (base: Float) (exp: Float): Float = pow_raw(base, exp)",
    "pub let Float.floor (x: Float): Float = floor_raw(x)",
    "pub let Float.ceil (x: Float): Float = ceil_raw(x)",
    "pub let Float.round (x: Float): Float = round_raw(x)",
    "",
    "pub let Float.random (): Float = random_raw(true)",
    "pub let Float.random_range (lo: Float) (hi: Float): Float = lo + (hi - lo) * Float.random(())",
    "",
    "// --- String ordering ---",
    "",
    "// Byte-lexicographic, which for UTF-8 IS codepoint order -- so this",
    "// agrees with the real prelude's rune-by-rune comparison without",
    "// needing a `.runes()` decoder.",
    "let string_concat_all_raw (parts: Array[String]): String = \"\"",
    "",
    "// Joins in ONE allocation. Building a large string by repeated",
    "// `.concat` is quadratic; this is what the compiler's own emitter",
    "// uses for anything that accumulates.",
    "pub let String.concat_all (parts: Array[String]): String = string_concat_all_raw(parts)",
    "",
    "let string_cmp_raw (a: String) (b: String): Int = 0",
    "",
    "",
    "pub let string_le (a: String) (b: String): Bool = string_cmp_raw(a, b) <= 0",
    "",
    "pub let Array.sort_string (arr: Array[String]): Array[String] = Array.sort_by(arr, |a: String, b: String| string_le(a, b))",
    "",
    "// --- Assertions ---",
    "//",
    "// Mirrored from the real prelude, message for message: a test that",
    "// fails should read the same whichever compiler ran it.",
    "",
    "pub let assert (cond: Bool): Unit =",
    "    if cond { () } else { panic_raw(\"assertion failed\") }",
    "",
    "pub let assert_eq[T] (a: T) (b: T): Unit =",
    "    if a == b { () } else {",
    "        panic_raw(\"assertion failed: left != right\\n  left:  \".concat(a.to_string()).concat(\"\\n  right: \").concat(b.to_string()))",
    "    }",
    "",
    "pub let assert_ne[T] (a: T) (b: T): Unit =",
    "    if a != b { () } else {",
    "        panic_raw(\"assertion failed: left == right\\n  left:  \".concat(a.to_string()).concat(\"\\n  right: \").concat(b.to_string()))",
    "    }",
    "",
    "// --- Collections: Map and Set ---",
    "",
    "// Mirrored from `crates/plumc/src/lib.rs`'s STDLIB_COLLECTIONS_SRC,",
    "// character for character. `Map` is a real hash map, so the mirror",
    "// has to be exact in one way that is easy to miss: bucket index is",
    "// `String.hash(..) % bucket_count`, which means `Map.keys` and",
    "// `Map.values` enumerate in HASH order. A hash that disagreed with",
    "// the real compiler's would print the same map in a different order",
    "// -- see `@plum_str_hash_raw` in runtime.plum, and the sign-bit mask",
    "// that a first attempt got wrong.",
    "struct MapEntry[K, V] { key: K, value: V }",
    "struct Map[K, V] { buckets: Array[Array[MapEntry[K, V]]], size: Int }",
    "",
    "let MAP_INITIAL_BUCKETS: Int = 8",
    "let MAP_LOAD_FACTOR_NUM: Int = 3",
    "let MAP_LOAD_FACTOR_DEN: Int = 4",
    "",
    "let map_make_buckets[K, V] (n: Int): Array[Array[MapEntry[K, V]]] = {",
    "    let mut buckets = [];",
    "    for i in 0..n { buckets = buckets.push([]); };",
    "    buckets",
    "}",
    "",
    "let value_hash[T] (x: T): Int = String.hash(x.to_string())",
    "",
    "let map_bucket_index[K] (k: K) (bucket_count: Int): Int = value_hash(k) % bucket_count",
    "",
    "let map_bucket_find_index[K: Eq, V] (bucket: Array[MapEntry[K, V]]) (k: K) (i: Int): Int =",
    "    if i >= bucket.len() { -1 }",
    "    else if bucket[i].key == k { i }",
    "    else { map_bucket_find_index(bucket, k, i + 1) }",
    "",
    "let Map.new[K, V] (): Map[K, V] = Map { buckets: map_make_buckets(MAP_INITIAL_BUCKETS), size: 0 }",
    "",
    "let map_rehash[K, V] (m: Map[K, V]) (new_bucket_count: Int): Map[K, V] = {",
    "    let mut new_buckets = map_make_buckets(new_bucket_count);",
    "    for bucket in m.buckets {",
    "        for entry in bucket {",
    "            let idx = map_bucket_index(entry.key, new_bucket_count);",
    "            new_buckets = new_buckets.set(idx, new_buckets[idx].push(entry));",
    "        }",
    "    };",
    "    Map { buckets: new_buckets, size: m.size }",
    "}",
    "",
    "let Map.insert[K: Eq, V] (m: Map[K, V]) (k: K) (v: V): Map[K, V] = {",
    "    let idx = map_bucket_index(k, m.buckets.len());",
    "    let bucket = m.buckets[idx];",
    "    let existing_i = map_bucket_find_index(bucket, k, 0);",
    "    let inserted = if existing_i >= 0 {",
    "        Map { buckets: m.buckets.set(idx, bucket.set(existing_i, MapEntry { key: k, value: v })), size: m.size }",
    "    } else {",
    "        Map { buckets: m.buckets.set(idx, bucket.push(MapEntry { key: k, value: v })), size: m.size + 1 }",
    "    };",
    "    if inserted.size * MAP_LOAD_FACTOR_DEN > inserted.buckets.len() * MAP_LOAD_FACTOR_NUM {",
    "        map_rehash(inserted, inserted.buckets.len() * 2)",
    "    } else {",
    "        inserted",
    "    }",
    "}",
    "",
    "let Map.get[K: Eq, V] (m: Map[K, V]) (k: K): Option[V] = {",
    "    let bucket = m.buckets[map_bucket_index(k, m.buckets.len())];",
    "    let i = map_bucket_find_index(bucket, k, 0);",
    "    if i >= 0 { Some(bucket[i].value) } else { None }",
    "}",
    "",
    "let Map.contains[K: Eq, V] (m: Map[K, V]) (k: K): Bool =",
    "    map_bucket_find_index(m.buckets[map_bucket_index(k, m.buckets.len())], k, 0) >= 0",
    "",
    "let Map.remove[K: Eq, V] (m: Map[K, V]) (k: K): Map[K, V] = {",
    "    let idx = map_bucket_index(k, m.buckets.len());",
    "    let bucket = m.buckets[idx];",
    "    let i = map_bucket_find_index(bucket, k, 0);",
    "    if i >= 0 { Map { buckets: m.buckets.set(idx, bucket.remove(i)), size: m.size - 1 } } else { m }",
    "}",
    "",
    "let Map.len[K, V] (m: Map[K, V]): Int = m.size",
    "",
    "let Map.keys[K, V] (m: Map[K, V]): Array[K] = {",
    "    let mut acc = [];",
    "    for bucket in m.buckets { for entry in bucket { acc = acc.push(entry.key); } };",
    "    acc",
    "}",
    "",
    "let Map.values[K, V] (m: Map[K, V]): Array[V] = {",
    "    let mut acc = [];",
    "    for bucket in m.buckets { for entry in bucket { acc = acc.push(entry.value); } };",
    "    acc",
    "}",
    "",
    "let map_from_arrays_acc[K: Eq, V] (keys: Array[K]) (values: Array[V]) (i: Int) (acc: Map[K, V]): Map[K, V] =",
    "    if i >= keys.len() { acc } else { map_from_arrays_acc(keys, values, i + 1, Map.insert(acc, keys[i], values[i])) }",
    "let Map.from_arrays[K: Eq, V] (keys: Array[K]) (values: Array[V]): Map[K, V] = map_from_arrays_acc(keys, values, 0, Map.new(()))",
    "",
    "struct Set[T] { inner: Map[T, Unit] }",
    "",
    "let Set.new[T] (): Set[T] = Set { inner: Map.new(()) }",
    "let Set.insert[T: Eq] (s: Set[T]) (x: T): Set[T] = Set { inner: Map.insert(s.inner, x, ()) }",
    "let Set.contains[T: Eq] (s: Set[T]) (x: T): Bool = Map.contains(s.inner, x)",
    "let Set.remove[T: Eq] (s: Set[T]) (x: T): Set[T] = Set { inner: Map.remove(s.inner, x) }",
    "let Set.len[T] (s: Set[T]): Int = Map.len(s.inner)",
    "let Set.to_array[T] (s: Set[T]): Array[T] = Map.keys(s.inner)",
    "",
    "let Set.union[T: Eq] (a: Set[T]) (b: Set[T]): Set[T] = {",
    "    let mut result = b;",
    "    for x in Set.to_array(a) { result = Set.insert(result, x); };",
    "    result",
    "}",
    "",
    "let Set.intersection[T: Eq] (a: Set[T]) (b: Set[T]): Set[T] = {",
    "    let mut result = Set.new(());",
    "    for x in Set.to_array(a) { if Set.contains(b, x) { result = Set.insert(result, x); } };",
    "    result",
    "}",
    "",
    "let Set.difference[T: Eq] (a: Set[T]) (b: Set[T]): Set[T] = {",
    "    let mut result = Set.new(());",
    "    for x in Set.to_array(a) { if !Set.contains(b, x) { result = Set.insert(result, x); } };",
    "    result",
    "}",
    "",
    "let set_from_array_acc[T: Eq] (arr: Array[T]) (i: Int) (acc: Set[T]): Set[T] =",
    "    if i >= arr.len() { acc } else { set_from_array_acc(arr, i + 1, Set.insert(acc, arr[i])) }",
    "let Set.from_array[T: Eq] (arr: Array[T]): Set[T] = set_from_array_acc(arr, 0, Set.new(()))",
    "",
    "// --- JSON ---",
    "",
    "// Mirrored from `crates/plumc/src/lib.rs`'s STDLIB_JSON_SRC, minus its",
    "// own `chars_of` (the runtime already provides that one -- it is the",
    "// single thing this prelude cannot write in Plum). Everything else is",
    "// character-for-character the real compiler's, so the two agree on",
    "// number formatting, escape handling and parse errors by construction",
    "// rather than by inspection.",
    "struct JsonEntry { key: String, value: JsonValue }",
    "enum JsonValue {",
    "    JsonNull,",
    "    JsonBool(Bool),",
    "    JsonNumber(Float),",
    "    JsonString(String),",
    "    JsonArray(Array[JsonValue]),",
    "    JsonObject(Array[JsonEntry]),",
    "}",
    "struct ParseResult[T] { value: T, next_pos: Int }",
    "",
    "let skip_ws (chars: Array[String]) (pos: Int): Int =",
    "    if pos >= chars.len() { pos }",
    "    else {",
    "        let c = chars[pos];",
    "        if c == \" \" || c == \"\\t\" || c == \"\\n\" || c == \"\\r\" { skip_ws(chars, pos + 1) } else { pos }",
    "    }",
    "",
    "let digit_value (c: String): Result[Float, String] =",
    "    if c == \"0\" { Ok(0.0) }",
    "    else if c == \"1\" { Ok(1.0) }",
    "    else if c == \"2\" { Ok(2.0) }",
    "    else if c == \"3\" { Ok(3.0) }",
    "    else if c == \"4\" { Ok(4.0) }",
    "    else if c == \"5\" { Ok(5.0) }",
    "    else if c == \"6\" { Ok(6.0) }",
    "    else if c == \"7\" { Ok(7.0) }",
    "    else if c == \"8\" { Ok(8.0) }",
    "    else if c == \"9\" { Ok(9.0) }",
    "    else { Err(\"not a digit\") }",
    "",
    "let pow10 (n: Int): Float = if n <= 0 { 1.0 } else { pow10(n - 1) * 10.0 }",
    "let pow10_float (n: Float): Float = if n <= 0.0 { 1.0 } else { pow10_float(n - 1.0) * 10.0 }",
    "",
    "let parse_digits_acc (chars: Array[String]) (pos: Int) (acc: Float) (any: Bool): Result[ParseResult[Float], String] =",
    "    if pos >= chars.len() {",
    "        if any { Ok(ParseResult { value: acc, next_pos: pos }) } else { Err(\"expected digit\") }",
    "    } else {",
    "        match digit_value(chars[pos]) {",
    "            Ok(d) => parse_digits_acc(chars, pos + 1, acc * 10.0 + d, true),",
    "            Err(_) => if any { Ok(ParseResult { value: acc, next_pos: pos }) } else { Err(\"expected digit\") },",
    "        }",
    "    }",
    "",
    "let parse_digits (chars: Array[String]) (pos: Int): Result[ParseResult[Float], String] = parse_digits_acc(chars, pos, 0.0, false)",
    "",
    "let parse_number (chars: Array[String]) (pos: Int): Result[ParseResult[Float], String] = {",
    "    let neg = pos < chars.len() && chars[pos] == \"-\";",
    "    let start = if neg { pos + 1 } else { pos };",
    "    match parse_digits(chars, start) {",
    "        Err(e) => Err(e),",
    "        Ok(int_r) => {",
    "            let has_frac = int_r.next_pos < chars.len() && chars[int_r.next_pos] == \".\";",
    "            match (if has_frac { parse_digits(chars, int_r.next_pos + 1) } else { Ok(ParseResult { value: 0.0, next_pos: int_r.next_pos }) }) {",
    "                Err(e) => Err(e),",
    "                Ok(frac_r) => {",
    "                    let frac_digit_count = if has_frac { frac_r.next_pos - (int_r.next_pos + 1) } else { 0 };",
    "                    let frac_val = if has_frac { frac_r.value / pow10(frac_digit_count) } else { 0.0 };",
    "                    let mag_no_exp = int_r.value + frac_val;",
    "                    let exp_pos = frac_r.next_pos;",
    "                    let has_exp = exp_pos < chars.len() && (chars[exp_pos] == \"e\" || chars[exp_pos] == \"E\");",
    "                    if !has_exp {",
    "                        let signed = if neg { 0.0 - mag_no_exp } else { mag_no_exp };",
    "                        Ok(ParseResult { value: signed, next_pos: exp_pos })",
    "                    } else {",
    "                        let after_e = exp_pos + 1;",
    "                        let exp_neg = after_e < chars.len() && chars[after_e] == \"-\";",
    "                        let exp_pos_sign = after_e < chars.len() && chars[after_e] == \"+\";",
    "                        let exp_digit_start = if exp_neg || exp_pos_sign { after_e + 1 } else { after_e };",
    "                        match parse_digits(chars, exp_digit_start) {",
    "                            Err(e) => Err(e),",
    "                            Ok(exp_r) => {",
    "                                let exp_count = exp_r.value;",
    "                                let factor = pow10_float(exp_count);",
    "                                let mag = if exp_neg { mag_no_exp / factor } else { mag_no_exp * factor };",
    "                                let signed = if neg { 0.0 - mag } else { mag };",
    "                                Ok(ParseResult { value: signed, next_pos: exp_r.next_pos })",
    "                            }",
    "                        }",
    "                    }",
    "                }",
    "            }",
    "        }",
    "    }",
    "}",
    "",
    "let match_literal_at (chars: Array[String]) (pos: Int) (lit: Array[String]) (i: Int): Bool =",
    "    if i >= lit.len() { true }",
    "    else if pos + i >= chars.len() { false }",
    "    else if chars[pos + i] == lit[i] { match_literal_at(chars, pos, lit, i + 1) }",
    "    else { false }",
    "",
    "let parse_literal (chars: Array[String]) (pos: Int) (word: String) (value: JsonValue): Result[ParseResult[JsonValue], String] = {",
    "    let lit = chars_of(word);",
    "    if match_literal_at(chars, pos, lit, 0) { Ok(ParseResult { value: value, next_pos: pos + lit.len() }) }",
    "    else { Err(\"invalid literal\") }",
    "}",
    "",
    "let parse_string_body (chars: Array[String]) (pos: Int) (acc: String): Result[ParseResult[String], String] =",
    "    if pos >= chars.len() { Err(\"unterminated string\") }",
    "    else {",
    "        let c = chars[pos];",
    "        if c == \"\\\"\" { Ok(ParseResult { value: acc, next_pos: pos + 1 }) }",
    "        else if c == \"\\\\\" {",
    "            if pos + 1 >= chars.len() { Err(\"unterminated escape\") }",
    "            else {",
    "                let e = chars[pos + 1];",
    "                if e == \"\\\"\" { parse_string_body(chars, pos + 2, acc.concat(\"\\\"\")) }",
    "                else if e == \"\\\\\" { parse_string_body(chars, pos + 2, acc.concat(\"\\\\\")) }",
    "                else if e == \"/\" { parse_string_body(chars, pos + 2, acc.concat(\"/\")) }",
    "                else if e == \"n\" { parse_string_body(chars, pos + 2, acc.concat(\"\\n\")) }",
    "                else if e == \"r\" { parse_string_body(chars, pos + 2, acc.concat(\"\\r\")) }",
    "                else if e == \"t\" { parse_string_body(chars, pos + 2, acc.concat(\"\\t\")) }",
    "                else { Err(\"unsupported escape sequence\") }",
    "            }",
    "        }",
    "        else { parse_string_body(chars, pos + 1, acc.concat(c)) }",
    "    }",
    "",
    "let parse_string (chars: Array[String]) (pos: Int): Result[ParseResult[String], String] =",
    "    if pos >= chars.len() || chars[pos] != \"\\\"\" { Err(\"expected opening quote\") }",
    "    else { parse_string_body(chars, pos + 1, \"\") }",
    "",
    "let parse_value (chars: Array[String]) (pos: Int): Result[ParseResult[JsonValue], String] =",
    "    if pos >= chars.len() { Err(\"unexpected end of input\") }",
    "    else {",
    "        let c = chars[pos];",
    "        if c == \"\\\"\" {",
    "            match parse_string(chars, pos) {",
    "                Ok(r) => Ok(ParseResult { value: JsonString(r.value), next_pos: r.next_pos }),",
    "                Err(e) => Err(e),",
    "            }",
    "        }",
    "        else if c == \"{\" { parse_object(chars, pos) }",
    "        else if c == \"[\" { parse_array(chars, pos) }",
    "        else if c == \"t\" { parse_literal(chars, pos, \"true\", JsonBool(true)) }",
    "        else if c == \"f\" { parse_literal(chars, pos, \"false\", JsonBool(false)) }",
    "        else if c == \"n\" { parse_literal(chars, pos, \"null\", JsonNull) }",
    "        else {",
    "            match digit_value(c) {",
    "                Ok(_) => match parse_number(chars, pos) {",
    "                    Ok(r) => Ok(ParseResult { value: JsonNumber(r.value), next_pos: r.next_pos }),",
    "                    Err(e) => Err(e),",
    "                },",
    "                Err(_) => if c == \"-\" {",
    "                    match parse_number(chars, pos) {",
    "                        Ok(r) => Ok(ParseResult { value: JsonNumber(r.value), next_pos: r.next_pos }),",
    "                        Err(e) => Err(e),",
    "                    }",
    "                } else { Err(\"unexpected character\") },",
    "            }",
    "        }",
    "    }",
    "",
    "let parse_array (chars: Array[String]) (pos: Int): Result[ParseResult[JsonValue], String] = {",
    "    let p1 = skip_ws(chars, pos + 1);",
    "    if p1 < chars.len() && chars[p1] == \"]\" { Ok(ParseResult { value: JsonArray([]), next_pos: p1 + 1 }) }",
    "    else { parse_array_entries(chars, p1, []) }",
    "}",
    "",
    "let parse_array_entries (chars: Array[String]) (pos: Int) (acc: Array[JsonValue]): Result[ParseResult[JsonValue], String] =",
    "    match parse_value(chars, pos) {",
    "        Err(e) => Err(e),",
    "        Ok(val_r) => {",
    "            let new_acc = acc.push(val_r.value);",
    "            let p1 = skip_ws(chars, val_r.next_pos);",
    "            if p1 < chars.len() && chars[p1] == \",\" { parse_array_entries(chars, skip_ws(chars, p1 + 1), new_acc) }",
    "            else if p1 < chars.len() && chars[p1] == \"]\" { Ok(ParseResult { value: JsonArray(new_acc), next_pos: p1 + 1 }) }",
    "            else { Err(\"expected ',' or ']'\") }",
    "        }",
    "    }",
    "",
    "let parse_object (chars: Array[String]) (pos: Int): Result[ParseResult[JsonValue], String] = {",
    "    let p1 = skip_ws(chars, pos + 1);",
    "    if p1 < chars.len() && chars[p1] == \"}\" { Ok(ParseResult { value: JsonObject([]), next_pos: p1 + 1 }) }",
    "    else { parse_object_entries(chars, p1, []) }",
    "}",
    "",
    "let parse_object_entries (chars: Array[String]) (pos: Int) (acc: Array[JsonEntry]): Result[ParseResult[JsonValue], String] =",
    "    match parse_string(chars, pos) {",
    "        Err(e) => Err(e),",
    "        Ok(key_r) => {",
    "            let p1 = skip_ws(chars, key_r.next_pos);",
    "            if p1 >= chars.len() || chars[p1] != \":\" { Err(\"expected ':'\") }",
    "            else {",
    "                let p2 = skip_ws(chars, p1 + 1);",
    "                match parse_value(chars, p2) {",
    "                    Err(e) => Err(e),",
    "                    Ok(val_r) => {",
    "                        let new_acc = acc.push(JsonEntry { key: key_r.value, value: val_r.value });",
    "                        let p3 = skip_ws(chars, val_r.next_pos);",
    "                        if p3 < chars.len() && chars[p3] == \",\" { parse_object_entries(chars, skip_ws(chars, p3 + 1), new_acc) }",
    "                        else if p3 < chars.len() && chars[p3] == \"}\" { Ok(ParseResult { value: JsonObject(new_acc), next_pos: p3 + 1 }) }",
    "                        else { Err(\"expected ',' or '}'\") }",
    "                    }",
    "                }",
    "            }",
    "        }",
    "    }",
    "",
    "let json_parse (s: String): Result[JsonValue, String] = {",
    "    let chars = chars_of(s);",
    "    let start = skip_ws(chars, 0);",
    "    match parse_value(chars, start) {",
    "        Err(e) => Err(e),",
    "        Ok(r) => {",
    "            let after = skip_ws(chars, r.next_pos);",
    "            if after == chars.len() { Ok(r.value) } else { Err(\"trailing characters after JSON value\") }",
    "        }",
    "    }",
    "}",
    "",
    "let json_escape_chars (chars: Array[String]) (pos: Int) (acc: String): String =",
    "    if pos >= chars.len() { acc }",
    "    else {",
    "        let c = chars[pos];",
    "        let escaped =",
    "            if c == \"\\\"\" { \"\\\\\\\"\" }",
    "            else if c == \"\\\\\" { \"\\\\\\\\\" }",
    "            else if c == \"\\n\" { \"\\\\n\" }",
    "            else if c == \"\\r\" { \"\\\\r\" }",
    "            else if c == \"\\t\" { \"\\\\t\" }",
    "            else { c };",
    "        json_escape_chars(chars, pos + 1, acc.concat(escaped))",
    "    }",
    "",
    "let json_escape (s: String): String = json_escape_chars(chars_of(s), 0, \"\")",
    "",
    "let json_quote (s: String): String = \"\\\"\".concat(json_escape(s)).concat(\"\\\"\")",
    "",
    "let join_with_commas (parts: Array[String]) (pos: Int) (acc: String): String =",
    "    if pos >= parts.len() { acc }",
    "    else if pos == 0 { join_with_commas(parts, pos + 1, parts[pos]) }",
    "    else { join_with_commas(parts, pos + 1, acc.concat(\",\").concat(parts[pos])) }",
    "",
    "let json_stringify (v: JsonValue): String = match v {",
    "    JsonNull => \"null\",",
    "    JsonBool(b) => if b { \"true\" } else { \"false\" },",
    "    JsonNumber(n) => n.to_string(),",
    "    JsonString(s) => json_quote(s),",
    "    JsonArray(arr) => \"[\".concat(join_with_commas(Array.map(arr, |x: JsonValue| json_stringify(x)), 0, \"\")).concat(\"]\"),",
    "    JsonObject(entries) => \"{\".concat(join_with_commas(Array.map(entries, |e: JsonEntry| json_quote(e.key).concat(\":\").concat(json_stringify(e.value))), 0, \"\")).concat(\"}\"),",
    "}",

    // The backing calls for `require`/`ensure`. The parser desugars
    // every clause into a call to one of these BEFORE the checker or
    // this backend sees the body, so contracts need no work of their
    // own anywhere downstream -- exactly two prelude one-liners, which
    // is how the real compiler implements them too (see
    // `crates/plumc/src/lib.rs`). They are ordinary Plum, compiled by
    // this backend like everything else here.
    "let __contract_require (cond: Bool) (msg: String): Unit =",
    "    if cond { () } else { panic_raw(msg) }",
    "",
    "let __contract_ensure (cond: Bool) (msg: String): Unit =",
    "    if cond { () } else { panic_raw(msg) }",
])
