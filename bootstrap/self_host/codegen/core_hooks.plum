// The hook ABI uses raw pointers internally; it is not exposed as a new
// source-language pointer type. Kernel implementations arrive in #509.
let cg_core_overrides (): String = cg_lines([
    "declare ptr @plum_kernel_alloc(i64)",
    "declare void @plum_kernel_free(ptr)",
    "declare void @plum_kernel_write(ptr, i64)",
    "declare void @plum_kernel_panic(ptr, i64) noreturn",
    "@.plum_core_oom = private constant [13 x i8] c\"out of memory\"",
    "@.plum_core_lf = private constant [1 x i8] c\"\\0A\"",
    "define ptr @plum_core_alloc_raw(i64 %size) {",
    "entry:",
    "  %p = call ptr @plum_kernel_alloc(i64 %size)",
    "  %ok = icmp ne ptr %p, null",
    "  br i1 %ok, label %ready, label %fail",
    "fail:",
    "  call void @plum_kernel_panic(ptr @.plum_core_oom, i64 13)",
    "  unreachable",
    "ready:",
    "  ret ptr %p",
    "}",
    "define ptr @plum_alloc(i64 %size) {",
    "entry:",
    "  %p = call ptr @plum_core_alloc_raw(i64 %size)",
    "  store i64 1, ptr %p",
    "  ret ptr %p",
    "}",
    // No malloc capacity contract yet. Reserve only the required amount,
    // avoiding both unsafe reuse and speculative huge growth requests.
    "define i64 @plum_core_capacity_disabled(ptr %p) {",
    "entry:",
    "  ret i64 0",
    "}",
    "define ptr @plum_alloc_preferred_or_fail(i64 %required, i64 %preferred, i64 %origin, ptr %error, i64 %error_length) {",
    "entry:",
    "  %p = call ptr @plum_kernel_alloc(i64 %required)",
    "  %ok = icmp ne ptr %p, null",
    "  br i1 %ok, label %ready, label %fail",
    "fail:",
    "  call void @plum_kernel_panic(ptr %error, i64 %error_length)",
    "  unreachable",
    "ready:",
    "  store i64 1, ptr %p",
    "  ret ptr %p",
    "}",
    "define void @plum_memory_fatal(ptr %data, i64 %length) noreturn {",
    "entry:",
    "  call void @plum_kernel_panic(ptr %data, i64 %length)",
    "  unreachable",
    "}",
    "define i1 @plum_print_raw(ptr %s) {",
    "entry:",
    "  %lp = getelementptr i8, ptr %s, i64 8",
    "  %length = load i64, ptr %lp",
    "  %data = getelementptr i8, ptr %s, i64 16",
    "  call void @plum_kernel_write(ptr %data, i64 %length)",
    "  ret i1 false",
    "}",
    "define i1 @plum_println(ptr %s) {",
    "entry:",
    "  %ignored = call i1 @plum_print_raw(ptr %s)",
    "  call void @plum_kernel_write(ptr @.plum_core_lf, i64 1)",
    "  ret i1 false",
    "}",
    "define i1 @plum_panic(ptr %s) {",
    "entry:",
    "  %lp = getelementptr i8, ptr %s, i64 8",
    "  %length = load i64, ptr %lp",
    "  %data = getelementptr i8, ptr %s, i64 16",
    "  call void @plum_kernel_panic(ptr %data, i64 %length)",
    "  unreachable",
    "}",
    cg_core_failure("plum_bounds_fail", ".plum_oob", 25),
    cg_core_failure("plum_div_zero_fail", ".plum_divzero", 16),
    cg_core_failure("plum_shift_fail", ".plum_negshift", 20),
    cg_core_failure("plum_div_overflow_fail", ".plum_overflow", 16),
    cg_core_integer_format(()),
])

let cg_core_failure (name: String) (message: String) (length: Int): String = cg_lines([
    "define void @${name}() {",
    "entry:",
    "  call void @plum_kernel_panic(ptr @${message}, i64 ${length})",
    "  unreachable",
    "}",
])

// Unsigned magnitude handles MIN_INT without signed negation overflow.
// Formatting borrows only stack scratch, then constructs an ordinary RC cell.
let cg_core_integer_format (): String = cg_lines([
    "define ptr @plum_int_to_string(i64 %n) {",
    "entry:",
    "  %buffer = alloca [21 x i8], align 1",
    "  %negative = icmp slt i64 %n, 0",
    "  %negated = sub i64 0, %n",
    "  %magnitude = select i1 %negative, i64 %negated, i64 %n",
    "  br label %digit",
    "digit:",
    "  %value = phi i64 [ %magnitude, %entry ], [ %quotient, %digit ]",
    "  %pos = phi i64 [ 21, %entry ], [ %next, %digit ]",
    "  %remainder = urem i64 %value, 10",
    "  %ascii = add i64 %remainder, 48",
    "  %byte = trunc i64 %ascii to i8",
    "  %next = sub i64 %pos, 1",
    "  %address = getelementptr i8, ptr %buffer, i64 %next",
    "  store i8 %byte, ptr %address",
    "  %quotient = udiv i64 %value, 10",
    "  %more = icmp ne i64 %quotient, 0",
    "  br i1 %more, label %digit, label %sign",
    "sign:",
    "  br i1 %negative, label %minus, label %finish",
    "minus:",
    "  %signedpos = sub i64 %next, 1",
    "  %signptr = getelementptr i8, ptr %buffer, i64 %signedpos",
    "  store i8 45, ptr %signptr",
    "  br label %finish",
    "finish:",
    "  %start = phi i64 [ %next, %sign ], [ %signedpos, %minus ]",
    "  %length = sub i64 21, %start",
    "  %data = getelementptr i8, ptr %buffer, i64 %start",
    "  %s = call ptr @plum_str_new(ptr %data, i64 %length)",
    "  ret ptr %s",
    "}",
])
