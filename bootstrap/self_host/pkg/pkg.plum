use lexer;
use parser;

// `plum.pkg` -- the package manifest.
//
// A project does not need one. Everything the compiler did before this
// module existed, it still does with no manifest present, and `plum
// new` does not write one. The file appears when a project acquires a
// DEPENDENCY, which is the first moment there is anything to say that
// the directory layout does not already say.
//
// == Why it is read by the real parser ==
//
// The alternative was a second format with a second parser -- TOML or a
// subset of it -- written and then maintained forever alongside the
// language's own. Plum already has a lexer and a parser, and a manifest
// is a value; `parser.parse_whole_expr` turns the text into a tree and
// nothing here executes anything.
//
// == Why it is NOT a `.plum` file ==
//
// This is the part with the bad history. `setup.py`, `build.rs` and
// `build.zig` all began as configuration and became programs, because a
// configuration file written in a general-purpose language invites
// computing in it, and then the tool has to RUN it in order to read it.
//
// Two separable things were being conflated there, and only one is
// risky. Reusing a parser to read data carries none: text goes in, a
// tree comes out. Making the file LOOK like a program is the whole
// risk. So this file has no `let`, no declaration, no `main`, and not a
// `.plum` extension. It is a bare value, and it is a value in a file
// nothing will ever try to compile. Zig makes the same split and did
// not blur it: `.zon` is data, `build.zig` is a program.
//
// And the shape is ENFORCED rather than trusted. `check_value` walks
// the parsed tree and rejects every node that is not a literal, an
// array, or a struct literal, so
//
//     Dep { name: "x", path: home_dir().concat("/x") }
//
// fails immediately, saying a manifest is data and not a program.
// Anyone who tries to script one finds out in five seconds and the
// error teaches the rule. String interpolation is rejected by the same
// walk without needing its own case, because an interpolated string
// parses to a concatenation rather than to `EStr`.
//
// The honest residual risk is not users but us: a maintainer relaxing
// the validator a little, twice, over two years. `bootstrap/pkg-check`
// asserts the rejections so that relaxation has to be deliberate.

// A dependency is EITHER a path or a git repository, never both and
// never neither.
//
// `path` is a directory on this machine, relative to the manifest that
// names it. `git` is a URL plus a `rev`, fetched into the global cache
// by `plum fetch` — see `fetch.plum`, which is the same module.
//
// `sha256` is optional and is the tree hash of what was fetched. It is
// how a manifest becomes a lockfile without there being a second file:
// declare it and every later fetch has to produce exactly those bytes.
// `plum fetch` prints the hash of what it got, so adding one is a
// copy and a paste.
//
// Unused fields are the empty string rather than `Option`, matching
// `Manifest` beside it, and every consumer asks `git != ""` — a
// dependency with a `git` is a git dependency, which is the only
// question anything downstream needs answered.
pub struct Dep {
    pub name: String,
    pub path: String,
    pub git: String,
    pub rev: String,
    pub sha256: String,
}

// `link` is library NAMES, not linker flags: `["sqlite3"]` becomes
// `-lsqlite3` and nothing else can be said. A manifest that could carry
// `-Wl,--wrap=malloc` would be a manifest that injects arbitrary linker
// behaviour into someone else's build, which is the same slide this file
// is shaped to prevent everywhere else. See issue #42.
//
// The per-target lists use the SAME four names as `native/`'s
// subdirectories, and `posix` means the same thing in both: Linux and
// macOS. One vocabulary to learn rather than two.
pub struct Manifest {
    pub name: String,
    pub version: String,
    pub deps: Array[Dep],
    pub link: Array[String],
    pub link_linux: Array[String],
    pub link_macos: Array[String],
    pub link_windows: Array[String],
    pub link_posix: Array[String],
}

// The libraries this manifest asks for when building for `os`.
pub let manifest_link_for (m: Manifest) (os: String): Array[String] = {
    let per_os = if os == "windows" { m.link_windows }
        else if os == "macos" { m.link_macos }
        else { m.link_linux };
    let posix = if os == "windows" { [] } else { m.link_posix };
    Array.concat(m.link, Array.concat(posix, per_os))
}

pub let manifest_name (unit: Unit): String = "plum.pkg"

// What a project with no `plum.pkg` has. Not an error: the file is
// optional, and its absence means "no dependencies", not "malformed".
pub let no_manifest (unit: Unit): Manifest = Manifest { name: "", version: "", deps: [], link: [], link_linux: [], link_macos: [], link_windows: [], link_posix: [] }

pub let manifest_path (root: String): String = Path.join(root, manifest_name(()))

// Read `<root>/plum.pkg`, or the empty manifest if there is none.
//
// A read that fails for any reason OTHER than absence is a hard error:
// a manifest that exists and cannot be read must never be silently
// treated as a project without dependencies, because that would fail
// much later as a pile of unbound variables.
pub let read (root: String): Manifest = {
    let path = manifest_path(root);
    if !Result.unwrap_or(Os.exists(path), false) { no_manifest(()) }
    else {
        match Os.read_file(path) {
            Err(e) => { panic_raw("failed to read ${path}: ${e}"); no_manifest(()) },
            Ok(src) => parse(path, src),
        }
    }
}

pub let parse (path: String) (src: String): Manifest = {
    let lexed = lexer.tokenize_spanned(src);
    // The same per-file source context every other parse sets, so a
    // malformed manifest gets `plum.pkg:3:9` with a caret rather than a
    // bare message.
    parser.set_source_context(path, src, lexed.starts, lexed.ends);
    let value = parser.parse_whole_expr(lexed.tokens);
    check_value(path, value);
    to_manifest(path, value)
}

// ---------------------------------------------------------------- data

// The line between data and program, in one function. Everything
// allowed here is inert; everything else names or calls something.
let check_value (path: String) (e: parser.PExpr): Unit = match e {
    EInt(_) => (),
    EFloat(_) => (),
    EStr(_) => (),
    EBool(_) => (),
    EArray(elems) => check_all(path, elems, 0),
    EStructLit(_, fields, spread) => match spread {
        // `Dep { ..base }` reads a value out of scope, and there is no
        // scope here.
        Some(_) => not_data(path, "a spread (`..`)"),
        None => check_fields(path, fields, 0),
    },
    _ => not_data(path, kind_of(e)),
}

let check_all (path: String) (elems: Array[parser.PExpr]) (i: Int): Unit =
    if i >= elems.len() { () }
    else { check_value(path, elems[i]); check_all(path, elems, i + 1) }

let check_fields (path: String) (fields: Array[parser.FieldInitNode]) (i: Int): Unit =
    if i >= fields.len() { () }
    else { check_value(path, fields[i].value); check_fields(path, fields, i + 1) }

// Named so the message can say WHAT was found. A bare "not allowed"
// leaves the reader hunting; "a function call" points at the line.
let kind_of (e: parser.PExpr): String = match e {
    EIdent(n, _) => "the name `${n}`",
    ECall(_, _) => "a function call",
    EField(_, _) => "a field access",
    EIndex(_, _) => "an index",
    EBinary(_, _, _) => "an operator (string interpolation is one)",
    EUnary(_, _) => "an operator",
    EClosure(_, _) => "a closure",
    EIf(_, _, _) => "an `if`",
    EMatch(_, _, _) => "a `match`",
    EBlock(_) => "a block",
    EFor(_, _, _) => "a `for`",
    ETuple(_) => "a tuple",
    ESpawn(_) => "a `spawn`",
    EUnsafe(_) => "an `unsafe` block",
    _ => "that",
}

let not_data (path: String) (what: String): Unit =
    panic_raw("${path}: a manifest is data, not a program, and ${what} is not data.\n  Only strings, numbers, `true`/`false`, arrays and struct literals are allowed.")

// ------------------------------------------------------------ the shape

let to_manifest (path: String) (e: parser.PExpr): Manifest = match e {
    EStructLit(lit_path, fields, _) => {
        if last_segment(lit_path) != "Package" {
            fail(path, "a manifest is one `Package { .. }`, but this one is `${last_segment(lit_path)}`")
        };
        reject_unknown(path, fields, 0,
            ["name", "version", "deps", "link", "link_linux", "link_macos", "link_windows", "link_posix"], "Package");
        Manifest {
            name: required_string(path, fields, "name", "Package"),
            version: optional_string(path, fields, "version"),
            deps: deps_of(path, fields),
            link: link_field(path, fields, "link"),
            link_linux: link_field(path, fields, "link_linux"),
            link_macos: link_field(path, fields, "link_macos"),
            link_windows: link_field(path, fields, "link_windows"),
            link_posix: link_field(path, fields, "link_posix"),
        }
    },
    _ => { fail(path, "a manifest is one `Package { .. }`"); no_manifest(()) },
}

// A list of library NAMES. The validator is the whole point: a name is
// what `-l` takes, so anything that could be a flag, a path or a shell
// fragment is refused here rather than handed to the linker.
//
// `stdc++`, `ws2_32` and `c++` are all real library names, which is why
// `+`, `_` and digits are allowed; a leading `-` never is.
let link_field (path: String) (fields: Array[parser.FieldInitNode]) (name: String): Array[String] =
    match field_named(fields, name, 0) {
        None => [],
        Some(v) => match v {
            EArray(elems) => link_names(path, name, elems, 0, []),
            _ => { fail(path, "`${name}` is an array of library names"); [] },
        },
    }

let link_names (path: String) (field: String) (elems: Array[parser.PExpr]) (i: Int) (acc: Array[String]): Array[String] =
    if i >= elems.len() { acc }
    else {
        let lib = match elems[i] {
            EStr(s) => s,
            _ => { fail(path, "`${field}` holds library names, which are strings"); "" },
        };
        if !is_library_name(lib) {
            fail(path, "`${lib}` is not a library name.\n  `${field}` takes what `-l` takes: `sqlite3`, `ws2_32`, `stdc++`. A linker FLAG is not a library name, and a manifest may not pass one into someone else's build.")
        };
        link_names(path, field, elems, i + 1, acc.push(lib))
    }

let is_library_name (s: String): Bool =
    !String.is_empty(s) && !s.starts_with("-") && all_library_chars(chars_of(s), 0)

let all_library_chars (cs: Array[String]) (i: Int): Bool =
    if i >= cs.len() { true }
    else if is_library_char(cs[i]) { all_library_chars(cs, i + 1) }
    else { false }

let is_library_char (c: String): Bool =
    Array.contains(chars_of("abcdefghijklmnopqrstuvwxyzABCDEFGHIJKLMNOPQRSTUVWXYZ0123456789_-.+"), c)

let deps_of (path: String) (fields: Array[parser.FieldInitNode]): Array[Dep] =
    match field_named(fields, "deps", 0) {
        None => [],
        Some(v) => match v {
            EArray(elems) => dep_list(path, elems, 0, []),
            _ => { fail(path, "`deps` is an array of `Dep { .. }`"); [] },
        },
    }

let dep_list (path: String) (elems: Array[parser.PExpr]) (i: Int) (acc: Array[Dep]): Array[Dep] =
    if i >= elems.len() { acc }
    else { dep_list(path, elems, i + 1, acc.push(dep_of(path, elems[i]))) }

let dep_of (path: String) (e: parser.PExpr): Dep = match e {
    EStructLit(lit_path, fields, _) => {
        if last_segment(lit_path) != "Dep" {
            fail(path, "every entry in `deps` is a `Dep { .. }`, but this one is `${last_segment(lit_path)}`")
        };
        reject_unknown(path, fields, 0, ["name", "path", "git", "rev", "sha256"], "Dep");
        let name = required_string(path, fields, "name", "Dep");
        let dep_path = optional_string(path, fields, "path");
        let git = optional_string(path, fields, "git");
        let rev = optional_string(path, fields, "rev");
        let sha256 = optional_string(path, fields, "sha256");
        // A package name is an identifier. It names no module -- a
        // dependency's modules are named by its own subdirectories --
        // but it is what a registry would resolve one day, and a name
        // that cannot be written in source is a name that will have to
        // be changed later. Catching it here names the manifest line.
        if !is_identifier(name) {
            fail(path, "`${name}` cannot be a package name: it must start with a letter and hold only letters, digits and `_`")
        };
        // An explicitly EMPTY path gets its own message, because it is a
        // different mistake from omitting the field and the generic
        // "give it a path" would be telling someone to do what they
        // just did. See the note in `check_source` for why an empty
        // path is caught here at all rather than by the loader.
        match field_named(fields, "path", 0) {
            Some(_) => if String.is_empty(dep_path) {
                fail(path, "dependency `${name}` has an empty path")
            } else { () },
            None => (),
        };
        check_source(path, name, dep_path, git, rev, sha256);
        Dep { name: name, path: dep_path, git: git, rev: rev, sha256: sha256 }
    },
    _ => { fail(path, "every entry in `deps` is a `Dep { .. }`"); Dep { name: "", path: "", git: "", rev: "", sha256: "" } },
}

// Where a dependency comes from, checked once, here.
//
// Every one of these is a manifest that PARSES and that the loader
// would otherwise discover much later, somewhere that cannot name the
// line that was wrong.
let check_source (path: String) (name: String) (dep_path: String) (git: String) (rev: String) (sha256: String): Unit = {
    let has_path = !String.is_empty(dep_path);
    let has_git = !String.is_empty(git);

    if has_path && has_git {
        fail(path, "dependency `${name}` has both a `path` and a `git`.\n  A dependency comes from one place. Delete whichever is not the one you meant.")
    };
    // An empty path is rejected HERE because by the time the loader
    // sees it, it is indistinguishable from a cycle. `Path.join`
    // drops empty segments, so `path: ""` cleans to the depending
    // project's own directory, which is already in the visited set,
    // and the dependency was silently skipped: the build SUCCEEDED
    // and the only symptom was `unbound variable` at the `use`,
    // pointing at the user's source rather than at the manifest
    // line that was actually wrong.
    if !has_path && !has_git {
        fail(path, "dependency `${name}` says where it is called but not where it comes from.\n  Give it a `path` (a directory on this machine) or a `git` and a `rev`.")
    };

    if has_git {
        if String.is_empty(rev) {
            fail(path, "dependency `${name}` has a `git` but no `rev`.\n  A manifest is the lockfile here, so a git dependency names an exact commit.")
        };
        // A branch or a tag is NOT a pin. Both move, and a dependency
        // that can change underneath a build makes "the manifest is the
        // lockfile" false -- which is the one promise this design is
        // built on, so it is enforced rather than recommended. The
        // length check is what rejects `main` and `v1.2.0`, and it also
        // rejects an abbreviated SHA, which is a pin that can become
        // ambiguous as a repository grows.
        if !String.is_empty(rev) && !is_hex_of_length(rev, 40) {
            fail(path, "dependency `${name}` has `rev: \"${rev}\"`, which is not a commit.\n  A `rev` is a full 40-character commit hash. A branch or a tag moves, and a dependency that moves is not pinned.")
        }
    } else {
        if !String.is_empty(rev) {
            fail(path, "dependency `${name}` has a `rev` but no `git`. A path dependency is whatever is in the directory.")
        };
        if !String.is_empty(sha256) {
            fail(path, "dependency `${name}` has a `sha256` but no `git`.\n  A path dependency is a directory you control and is not verified; the hash would be checking your own working tree against itself.")
        }
    };

    if !String.is_empty(sha256) && !is_hex_of_length(sha256, 64) {
        fail(path, "dependency `${name}` has a `sha256` that is not a 64-character hex hash.\n  `plum fetch` prints the hash of what it fetched; paste that.")
    }
}

let is_hex_of_length (s: String) (n: Int): Bool =
    s.len() == n && all_hex(chars_of(s), 0)

let all_hex (cs: Array[String]) (i: Int): Bool =
    if i >= cs.len() { true }
    else if Array.contains(chars_of("0123456789abcdef"), cs[i]) { all_hex(cs, i + 1) }
    else { false }

// ----------------------------------------------------------- accessors

let field_named (fields: Array[parser.FieldInitNode]) (name: String) (i: Int): Option[parser.PExpr] =
    if i >= fields.len() { None }
    else if fields[i].name == name { Some(fields[i].value) }
    else { field_named(fields, name, i + 1) }

// An unknown field is an ERROR rather than something ignored. A
// manifest is small and hand-written, and the failure mode of ignoring
// what it did not understand is a typo that does nothing and says
// nothing -- `dependencies:` instead of `deps:`, and a build that
// cannot find a module for reasons the manifest appears to contradict.
let reject_unknown (path: String) (fields: Array[parser.FieldInitNode]) (i: Int) (known: Array[String]) (what: String): Unit =
    if i >= fields.len() { () }
    else {
        if !Array.contains(known, fields[i].name) {
            fail(path, "`${what}` has no field `${fields[i].name}`. It understands ${Array.join(known, ", ")}")
        };
        reject_unknown(path, fields, i + 1, known, what)
    }

let required_string (path: String) (fields: Array[parser.FieldInitNode]) (name: String) (what: String): String =
    match field_named(fields, name, 0) {
        None => { fail(path, "`${what}` needs a `${name}`"); "" },
        Some(v) => string_value(path, name, v),
    }

let optional_string (path: String) (fields: Array[parser.FieldInitNode]) (name: String): String =
    match field_named(fields, name, 0) {
        None => "",
        Some(v) => string_value(path, name, v),
    }

let string_value (path: String) (name: String) (e: parser.PExpr): String = match e {
    EStr(s) => s,
    _ => { fail(path, "`${name}` is a string"); "" },
}

let last_segment (path: Array[String]): String = Option.unwrap_or(Array.last(path), "")

// Asked of the LEXER rather than of a character-class predicate written
// here. The authority on what an identifier is, is the thing that reads
// identifiers: a string is one exactly when it lexes to a single
// `TokIdent`. That also rejects `match` and `struct` for free, which a
// hand-written letters-and-digits test would have let through.
let is_identifier (s: String): Bool = {
    let tokens = lexer.tokenize(s);
    tokens.len() == 2 && match tokens[0] { TokIdent(n) => n == s, _ => false }
}

let fail (path: String) (msg: String): Unit = panic_raw("${path}: ${msg}")
