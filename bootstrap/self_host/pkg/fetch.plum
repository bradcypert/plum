use treefs;
use Encoding;
use Crypto;
use Process;

// Fetching a git dependency into the global cache.
//
// This file is the same module as `pkg.plum` -- one directory is one
// module -- so everything here is `pkg.something` from outside and bare
// from inside.
//
// == Why shelling out to `git` ==
//
// Settled in issue #36 and worth restating where the code is, because
// the obvious argument for the other side is a false one. "Nobody
// writes their own TLS" is not true: Go wrote `crypto/tls` in Go and
// `go get` uses it, Zig wrote `std.crypto.tls` in Zig so its toolchain
// would not need OpenSSL, and Java has done TLS in Java since the 90s.
// Languages whose identity is "no C dependencies" wrote their own.
//
// The argument that actually applies here is scale and starting point.
// Go and Zig built their TLS on crypto their languages already had.
// Plum has SHA-256 and three encodings. No AES, no ChaCha20, no
// elliptic curve, no bignum, no constant-time comparison. TLS from
// there is a research programme, and `bootstrap/properties` can prove
// sorting correct while being unable to tell you whether your AES is
// constant-time.
//
// So `git` is a CONDITIONAL dependency: needed by a project that fetches
// and by nothing else. The bootstrap path stays `seed -> compiler` with
// no network, forever, and nothing in this file is on it.
//
// == Why fetching is explicit ==
//
// `plum build` does not fetch. A missing dependency is an error naming
// `plum fetch`, not a silent download in the middle of a build.
//
// Cargo and Go both fetch implicitly and it is a real convenience. It
// is also a build that reaches the network without being asked, and
// this compiler currently cannot: every harness in `bootstrap/` runs
// offline, and that is a property worth keeping deliberately rather
// than discovering it has been lost. Implicit fetching can be added
// later; it cannot be taken back once builds depend on it.

// ------------------------------------------------------------ the cache
//
// A global cache, not a `deps/` directory inside the project.
//
// Packages are addressed by the exact Git URL and commit. Two projects
// naming that same pair share one checkout. An optional `sha256` checks
// the source bytes independently on every use; it is not the cache key
// and cannot substitute for preserving the requested Git identity.
//
// Other people's code stays out of your tree and grep results unless
// you explicitly copy the cache into the project with `plum vendor`.

// `PLUM_CACHE`, then `XDG_CACHE_HOME/plum`, then `~/.cache/plum`.
//
// `PLUM_CACHE` exists for the harnesses before it exists for users: a
// test that fetches must not write into the developer's real cache, and
// `bootstrap/pkg-check` sets it to a temp directory. An override that
// only the tests need is still the first thing to add, because without
// it the tests cannot run at all without side effects.
//
// An empty variable counts as unset. `PLUM_CACHE=` in a shell script is
// how a variable gets cleared, and treating it as a request to use the
// empty string as a path produces a cache at the filesystem root.
pub let cache_root (unit: Unit): String =
    match non_empty_env("PLUM_CACHE") {
        Some(p) => p,
        None => match non_empty_env("XDG_CACHE_HOME") {
            Some(p) => Path.join(p, "plum"),
            None => match Os.home_dir(()) {
                Some(h) => Path.join(Path.join(h, ".cache"), "plum"),
                None => {
                    panic_raw("cannot find a cache directory: neither PLUM_CACHE, XDG_CACHE_HOME nor HOME is set.\n  Set PLUM_CACHE to a directory Plum may write fetched packages into.");
                    ""
                },
            },
        },
    }

let non_empty_env (name: String): Option[String] =
    match Os.env_var(name) {
        None => None,
        Some(v) => if String.is_empty(v) { None } else { Some(v) },
    }

pub let package_cache (unit: Unit): String = Path.join(cache_root(()), "pkg")

// List both legacy and versioned layouts without asking callers to
// rediscover them with `find`. A package entry ends at a full Git commit
// directory (40 hex characters), below the v2 identity (64 characters).
// Stop there: package source may itself contain commit-shaped names.
struct CacheFrame { relative: String, entries: Array[treefs.EntryInfo], index: Int }
pub struct CacheUsage { pub files: Int, pub bytes: Int }

let cache_frame (root: treefs.TreeRoot) (relative: String) (links: Bool): CacheFrame = {
    let result = if links { treefs.entries(root, relative, true) } else { treefs.children(root, relative, true) };
    let entries = match result { Ok(xs) => xs, Err(e) => { panic_raw("cache inventory ${relative}: ${e}"); [] } };
    CacheFrame { relative: relative, entries: entries, index: 0 }
}

pub let cached_packages (unit: Unit): Array[String] = {
    let path = cache_root(());
    if !Result.unwrap_or(Os.exists(path), false) { [] }
    else {
        let root = match treefs.open_root(path) { Ok(r) => r, Err(e) => treefs.fail_root(e) };
        let top = cache_frame(root, ".", false);
        let mut found = false;
        for entry in top.entries {
            if entry.name == "pkg" {
                if entry.kind != 2 { panic_raw("package cache must be an ordinary directory: ${path}/pkg") };
                found = true;
                ()
            };
        };
        if !found { [] }
        else {
            let results = ref([]);
            cache_package_dirs(root, path, [cache_frame(root, "pkg", false)], results);
            Array.sort_string(results.get())
        }
    }
}

// Layout discovery never follows links, even before a commit root is found.
// A bounded stack also prevents corrupt cache layouts exhausting the stack.
let cache_package_dirs (root: treefs.TreeRoot) (path: String) (stack: Array[CacheFrame]) (results: Ref[Array[String]]): Unit =
    if stack.len() == 0 { () }
    else {
        let frame = stack[stack.len() - 1];
        let rest = Array.slice(stack, 0, stack.len() - 1);
        if frame.index >= frame.entries.len() { cache_package_dirs(root, path, rest, results) }
        else {
            let info = frame.entries[frame.index];
            let relative = Path.join(frame.relative, info.name);
            let pending = rest.push(CacheFrame { relative: frame.relative, entries: frame.entries, index: frame.index + 1 });
            if info.kind != 2 || info.name.starts_with(".partial-") || (info.name.ends_with(".partial") && is_commit_dir(treefs.path_slice(info.name, 0, info.name.len() - 8))) { cache_package_dirs(root, path, pending, results) }
            else if is_commit_dir(info.name) {
                let mut values = results.get();
                results.set([]);
                values = values.push(Path.join(path, relative));
                results.set(values);
                cache_package_dirs(root, path, pending, results)
            } else {
                if stack.len() >= 128 { panic_raw("cache directory depth exceeds 128 at ${path}/${relative}") };
                cache_package_dirs(root, path, pending.push(cache_frame(root, relative, false)), results)
            }
        }
    }

let is_commit_dir (name: String): Bool =
    name.len() == 40 && Array.fold(chars_of(name), true, |ok, c|
        ok && Array.contains(chars_of("0123456789abcdef"), c))

// Logical usage counts each regular file and each stored link once. Links
// contribute target-text bytes, never the size or contents of their targets.
// Hardlinks count once per directory entry; this is not allocated disk blocks.
pub let cached_package_usage (dir: String): CacheUsage = {
    let root = match treefs.open_root(dir) { Ok(r) => r, Err(e) => treefs.fail_root(e) };
    cache_usage(root, dir, [cache_frame(root, ".", true)], CacheUsage { files: 0, bytes: 0 })
}

pub let cached_package_size (dir: String): Int = cached_package_usage(dir).bytes

let cache_usage (root: treefs.TreeRoot) (path: String) (stack: Array[CacheFrame]) (usage: CacheUsage): CacheUsage =
    if stack.len() == 0 { usage }
    else {
        let frame = stack[stack.len() - 1];
        let rest = Array.slice(stack, 0, stack.len() - 1);
        if frame.index >= frame.entries.len() { cache_usage(root, path, rest, usage) }
        else {
            let info = frame.entries[frame.index];
            let relative = Path.join(frame.relative, info.name);
            let pending = rest.push(CacheFrame { relative: frame.relative, entries: frame.entries, index: frame.index + 1 });
            if info.kind == 2 {
                if stack.len() >= 128 { panic_raw("cache directory depth exceeds 128 at ${path}/${relative}") };
                cache_usage(root, path, pending.push(cache_frame(root, relative, true)), usage)
            } else {
                let size = if info.kind == 3 { info.target.len() }
                    else if info.kind == 1 {
                        let entry = match treefs.open_entry(root, relative, true) { Ok(e) => e, Err(e) => treefs.fail_entry(e) };
                        match treefs.entry_size(entry) { Ok(n) => n, Err(e) => { panic_raw("cache size ${path}/${relative}: ${e}"); 0 } }
                    } else { panic_raw("unsupported cache entry: ${path}/${relative}"); 0 };
                if size > 9223372036854775807 - usage.bytes || usage.files == 9223372036854775807 { panic_raw("cache usage exceeds integer range at ${path}/${relative}") };
                cache_usage(root, path, pending, CacheUsage { files: usage.files + 1, bytes: usage.bytes + size })
            }
        }
    }

// Empty only fetched packages. The cache root is controlled by an
// environment variable and may one day hold other Plum cache kinds, so
// `plum cache clean` must not erase the root wholesale.
pub let clear_package_cache (unit: Unit): Result[Unit, String] =
    if Result.unwrap_or(Os.exists(package_cache(())), false) {
        Os.remove_tree(package_cache(()))
    } else { Ok(()) }

// Where one exact Git URL-and-revision pair lives.
//
// `pkg/v2/<sha256>/<commit>/`: the digest is the identity; the final
// revision is only a readable label. Schemes, punctuation, repeated
// slashes and `.git` suffixes can all distinguish real Git remotes, so
// none may be discarded before hashing. Lengths frame the two fields
// unambiguously, even if a URL contains delimiters or newlines.
//
// Both stores use this relative path. Old, lossy entries are deliberately
// not reused or migrated: their paths cannot prove which URL made them.
pub let cache_dir (git: String) (rev: String): String =
    Path.join(package_cache(()), package_identity_path(git, rev))

// The project-local counterpart of `cache_dir`, with the same identity.
pub let vendor_dir (root: String) (git: String) (rev: String): String =
    Path.join(Path.join(root, "vendor"), package_identity_path(git, rev))

let package_identity_path (git: String) (rev: String): String = {
    let framed = "${git.len().to_string()}:${git}${rev.len().to_string()}:${rev}";
    let key = Bytes.to_hex(Crypto.sha256(Bytes.from_string(framed)));
    Path.join(Path.join("v2", key), sanitize_segment(rev))
}

pub let vendor_dep (root: String) (d: Dep): String = {
    let src = fetch_dep(d);
    let dst = vendor_dir(root, d.git, d.rev);
    if Result.unwrap_or(Os.is_directory(dst), false) { verify(d, dst) }
    else {
        let stage = package_stage(dst);
        let scratch = Path.join(stage, "tree");
        match Os.make_dir(scratch) {
            Ok(_) => (),
            Err(e) => { let cleanup = Os.remove_tree(stage); panic_raw("could not create vendoring scratch directory ${scratch}: ${e}") },
        };
        match Os.copy_tree(src, scratch) {
            Ok(_) => (),
            Err(e) => { let cleanup = Os.remove_tree(stage); panic_raw("could not vendor `${d.name}` into ${dst}: ${e}") },
        };
        publish_stage(d, stage, dst);
        verify(d, dst)
    };
    dst
}

// The revision label is decorative, never the identity. Replace unsafe
// characters and reject dot segments so even direct API calls with a
// non-commit revision cannot escape the digest directory.
let sanitize_segment (s: String): String = {
    let mapped = Array.fold(chars_of(s), "", |acc, c| acc.concat(if is_safe_char(c) { c } else { "_" }));
    if mapped == "." || mapped == ".." || String.is_empty(mapped) { "_" } else { mapped }
}

let is_safe_char (c: String): Bool =
    Array.contains(chars_of("abcdefghijklmnopqrstuvwxyzABCDEFGHIJKLMNOPQRSTUVWXYZ0123456789._-"), c)

// Package identity is independent of symlink target contents outside the
// package. Inventory never follows links; regular files are opened through
// the held root with links rejected, then hashed in bounded native buffers.
struct PackageDirectory { relative: String, depth: Int }
struct PackageEntry { relative: String, kind: Int, target: String }

let package_inventory (root: treefs.TreeRoot): Result[Array[PackageEntry], String] =
    package_inventory_walk(root, [PackageDirectory { relative: ".", depth: 0 }], 0, [])

let package_inventory_walk (root: treefs.TreeRoot) (directories: Array[PackageDirectory]) (index: Int) (found: Array[PackageEntry]): Result[Array[PackageEntry], String] =
    if index >= directories.len() { Ok(Array.sort_by(found, |a: PackageEntry, b: PackageEntry| a.relative <= b.relative)) }
    else {
        let current = directories[index];
        if current.depth >= 128 { Err("package traversal exceeds 128 directory levels at ${current.relative}") }
        else { match treefs.entries(root, current.relative, true) {
            Err(e) => Err(e),
            Ok(entries) => {
                let mut pending = directories;
                let mut all = found;
                let mut failure = "";
                for entry in entries {
                    if entry.name != ".git" && failure == "" {
                        let relative = if current.relative == "." { entry.name } else { "${current.relative}/${entry.name}" };
                        if entry.kind == 2 {
                            pending = pending.push(PackageDirectory { relative: relative, depth: current.depth + 1 });
                        } else if entry.kind == 3 {
                            match treefs.validate_link(root, relative) {
                                Ok(_) => (),
                                Err(e) => { failure = e; () },
                            };
                        } else if entry.kind != 1 { failure = "unsupported package entry ${relative}"; () };
                        all = all.push(PackageEntry { relative: relative, kind: entry.kind, target: entry.target });
                    } else { () };
                };
                if failure != "" { Err(failure) }
                else { package_inventory_walk(root, pending, index + 1, all) }
            },
        } }
    }

pub let validate_package (dir: String): Result[Unit, String] =
    match treefs.open_root(dir) {
        Err(e) => Err(e),
        Ok(root) => match package_inventory(root) { Ok(_) => Ok(()), Err(e) => Err(e) },
    }

pub let tree_hash (dir: String): String = tree_hash_version(dir, 2)

pub let tree_hash_version (dir: String) (version: Int): String =
    match tree_hash_result(dir, version) { Ok(digest) => digest, Err(e) => { panic_raw(e); "" } }

pub let tree_hash_result (dir: String) (version: Int): Result[String, String] =
    if version != 1 && version != 2 { Err("unsupported package hash version ${version.to_string()}") }
    else { match treefs.open_root(dir) {
        Err(e) => Err(e),
        Ok(root) => match package_inventory(root) {
            Err(e) => Err(e),
            Ok(entries) => match treefs.hasher() {
                Err(e) => Err(e),
                Ok(hash) => package_hash_entries(root, entries, hash, version),
            },
        },
    } }

let package_hash_entries (root: treefs.TreeRoot) (entries: Array[PackageEntry]) (hash: treefs.TreeHasher) (version: Int): Result[String, String] = {
    let mut failure = "";
    if version == 2 {
        match treefs.hash_bytes(hash, Bytes.from_string("plum-tree-v2\n")) {
            Ok(_) => (), Err(e) => { failure = e; () },
        };
    } else { () };
    for entry in entries {
        if failure == "" {
            if version == 1 && entry.kind == 3 {
                failure = "legacy package hash refuses symlink ${entry.relative}; migrate the dependency to hash_version: 2 using the hash printed by plum fetch";
            } else if version == 1 && entry.kind == 2 { () }
            else { match package_payload(root, entry, version) {
                Err(e) => { failure = e; () },
                Ok(payload) => {
                    if version == 2 {
                        let tag = if entry.kind == 1 { "F" } else if entry.kind == 2 { "D" } else { "L" };
                        let frame = "${tag}${entry.relative.len().to_string()}\n${entry.relative}\n${payload.len().to_string()}\n";
                        match treefs.hash_bytes(hash, Bytes.from_string(frame)) {
                            Ok(_) => (), Err(e) => { failure = e; () },
                        };
                    } else { () };
                    if failure == "" {
                        match treefs.hash_bytes(hash, payload) {
                            Ok(_) => (), Err(e) => { failure = e; () },
                        };
                    } else { () };
                },
            } }
        } else { () };
    };
    if failure != "" { Err(failure) } else { Ok(treefs.hash_finish(hash)) }
}

let package_payload (root: treefs.TreeRoot) (entry: PackageEntry) (version: Int): Result[Bytes, String] =
    if entry.kind == 2 { Ok(Bytes.empty(())) }
    else if entry.kind == 3 { Ok(Bytes.from_string(entry.target)) }
    else { match treefs.open_entry(root, entry.relative, true) {
        Err(e) => Err(e),
        Ok(file) => match treefs.file_hash(file, entry.relative, version) {
            Err(e) => Err(e),
            Ok(hex) => Encoding.hex_decode(hex),
        },
    } }

// ------------------------------------------------------------- fetching

pub let is_fetched (d: Dep): Bool =
    Result.unwrap_or(Os.is_directory(cache_dir(d.git, d.rev)), false)

// Fetch `d` unless it is already in the cache. Returns its directory.
//
// The verification runs on every call, not only after a download. A
// cache entry is a directory on a disk that other programs can reach,
// and the whole point of declaring a `sha256` is that the bytes are
// checked before they are compiled -- checking only what was just
// downloaded would verify the one case that was never in doubt.
pub let fetch_dep (d: Dep): String = {
    let dir = cache_dir(d.git, d.rev);
    if !Result.unwrap_or(Os.is_directory(dir), false) { clone_into(d, dir) } else { () };
    verify(d, dir);
    dir
}

// The same check `fetch_dep` runs, for a cache entry that is already
// there. `plum build` calls this on every git dependency.
pub let verify_cached (d: Dep) (dir: String): Unit = verify(d, dir)

let verify (d: Dep) (dir: String): Unit =
    match verify_result(d, dir) { Ok(_) => (), Err(e) => panic_raw(e) }

let verify_result (d: Dep) (dir: String): Result[Unit, String] =
    if String.is_empty(d.sha256) { validate_package(dir) }
    else { match tree_hash_result(dir, d.hash_version) {
        Err(e) => Err(e),
        Ok(got) => if got == d.sha256 { Ok(()) }
            else { Err("dependency `${d.name}` does not match its `sha256`.\n  manifest: ${d.sha256}\n  fetched:  ${got}\n  at ${dir}\n  Either the commit's contents changed underneath the hash, or the cache entry was modified. Delete the directory above and fetch again.") },
    } }

// Each operation owns a uniquely reserved container. Never remove a guessed
// `.partial` sibling: another process (or the user) may own that pathname.
let package_stage (destination: String): String = {
    ensure_parent(destination);
    match treefs.staging(Path.dirname(destination)) {
        Ok(path) => path, Err(e) => { panic_raw(e); "" },
    }
}

// Validate the payload before publication and clean only our own container.
// A concurrent winner is usable only after the usual integrity validation.
let publish_stage (d: Dep) (stage: String) (destination: String): Unit = {
    let payload = Path.join(stage, "tree");
    match verify_result(d, payload) {
        Err(e) => { let cleanup = Os.remove_tree(stage); panic_raw(e) },
        Ok(_) => (),
    };
    let moved = Os.rename_file(payload, destination);
    let cleanup = Os.remove_tree(stage);
    match moved {
        Ok(_) => (),
        Err(e) => if Result.unwrap_or(Os.is_directory(destination), false) {
            match verify_result(d, destination) {
                Ok(_) => (),
                Err(invalid) => panic_raw("could not publish package into ${destination}: ${e}\n${invalid}"),
            }
        } else { panic_raw("could not publish package into ${destination}: ${e}") },
    }
}

let clone_into (d: Dep) (dir: String): Unit = {
    require_git(d);
    // Cloned into a scratch directory beside the destination and MOVED
    // into place, so an interrupted fetch cannot leave a half-populated
    // directory that later runs would accept as a complete package.
    // Beside it rather than in `/tmp` so the move stays on one
    // filesystem and is therefore atomic.
    let stage = package_stage(dir);
    let scratch = Path.join(stage, "tree");

    // A full clone, then a checkout. `--depth 1` cannot fetch an
    // arbitrary commit on every server -- some allow it, some do not --
    // and a fetch that works on GitHub and fails on a self-hosted remote
    // is a worse deal than a slower clone that always works.
    git_staging(d, stage, ["clone", "--quiet", "--no-checkout", d.git, scratch],
        "could not clone ${d.git}");
    git_staging(d, stage, ["-C", scratch, "config", "core.symlinks", "true"], "could not enable faithful symlink checkout");
    git_staging(d, stage, ["-C", scratch, "checkout", "--quiet", d.rev],
        "could not check out ${d.rev} from ${d.git}\n  The repository was cloned, so the URL is right and the commit is not in it.");

    // The package is source, not a repository. Removing `.git` keeps the
    // cache to what is actually needed, and stops anything downstream
    // from treating a cache entry as a working tree it may update.
    match Os.remove_tree(Path.join(scratch, ".git")) {
        Ok(_) => (),
        Err(e) => { let cleanup = Os.remove_tree(stage); panic_raw("could not remove fetched repository metadata: ${e}") },
    };
    publish_stage(d, stage, dir)
}

// The error a person actually gets when `git` is not installed.
//
// Named, and named BEFORE anything is attempted, because the failure
// otherwise arrives as `Err` from `Process.run` somewhere inside a
// clone and reads as a network problem. Windows is the case that
// matters: git is frequently absent there and the compiler itself has
// never needed it.
let require_git (d: Dep): Unit =
    if git_available(()) { () }
    else {
        panic_raw("dependency `${d.name}` needs `git`, which is not on PATH.\n  Plum shells out to git to fetch packages; it is needed only by projects that fetch, not to build the compiler or a project with path dependencies.\n  Install git, or vendor the package and use `path` instead of `git`.")
    }

pub let git_available (unit: Unit): Bool =
    match Process.run(Process.Options { program: "git", args: ["--version"], env: [], stdin: None }) {
        Err(_) => false,
        Ok(r) => r.exit_code == 0,
    }

let git_staging (d: Dep) (scratch: String) (args: Array[String]) (what: String): Unit = {
    let failure = match Process.run(Process.Options { program: "git", args: args, env: [], stdin: None }) {
        Err(e) => "dependency `${d.name}`: ${what}\n  git could not be started: ${e}",
        Ok(r) => if r.exit_code != 0 {
            "dependency `${d.name}`: ${what}\n  git exited ${r.exit_code.to_string()}: ${String.trim(r.stderr)}"
        } else { "" },
    };
    if failure != "" { let cleanup = Os.remove_tree(scratch); panic_raw(failure) } else { () }
}

let ensure_parent (dir: String): Unit = ensure_dir(Path.dirname(dir))

// Work backwards with Path.dirname so drive and UNC roots stay intact.
// Splitting/rejoining components turns `C:\cache` into drive-relative
// `C:cache`; suppressing mkdir errors then hides the missing staging parent.
let ensure_dir (path: String): Unit = ensure_directory(Path.clean(path), 0)

let ensure_directory (path: String) (depth: Int): Unit =
    if Result.unwrap_or(Os.is_directory(path), false) { () }
    else if depth >= 128 { panic_raw("package directory creation exceeds 128 levels at ${path}") }
    else {
        let parent = Path.dirname(path);
        if parent == path { panic_raw("package directory root is unavailable: ${path}") };
        ensure_directory(parent, depth + 1);
        match Os.make_dir(path) {
            Ok(_) => (),
            Err(e) => if Result.unwrap_or(Os.is_directory(path), false) { () }
                else { panic_raw("cannot create package directory ${path}: ${e}") },
        }
    }

// These pairs all lost identity in the old display-path encoding. Test
// both stores: build resolution and publication must use the same key.
pub let test_package_storage_identity (): Unit = {
    let rev = "0123456789012345678901234567890123456789";
    let urls = [
        ["https://git.example/repo", "ssh://git.example/repo"],
        ["git@example:repo", "git_example_repo"],
        ["/tmp/repo:one", "/tmp/repo_one"],
        ["/tmp/repo.git", "/tmp/repo"],
        ["https://git.example/a//b", "https://git.example/a/b"],
        ["https://git.example/../repo", "https://git.example/_/repo"],
        ["https://git.example/é", "https://git.example/_"],
    ];
    for pair in urls {
        assert(cache_dir(pair[0], rev) != cache_dir(pair[1], rev));
        assert(vendor_dir("project", pair[0], rev) != vendor_dir("project", pair[1], rev));
    };
    // Manifests currently reject refs, but the path API still preserves
    // its revision input and never lets it escape the storage root.
    assert(cache_dir("repo", "release/v1") != cache_dir("repo", "release_v1"));
    assert(vendor_dir("project", "repo", "release/v1") != vendor_dir("project", "repo", "release_v1"));
    assert(cache_dir("ab", "c") != cache_dir("a", "bc"));
    assert(cache_dir("a\nb", "c") != cache_dir("a", "b\nc"));
    assert_eq(cache_dir("repo", rev), cache_dir("repo", rev));
    assert_eq(Path.basename(cache_dir("repo", rev)), rev);
    assert_eq(Path.basename(vendor_dir("project", "repo", rev)), rev);
}

pub let test_package_identity_layout (): Unit = {
    // Fixed framing vector, calculated independently of the Plum helper.
    assert_eq(package_identity_path("a\nb", "c"),
        Path.join(Path.join("v2", "7a6f128b2268aa9b0008b684852adec17c5971548097472d84a5ece2e5607483"), "c"));
    for rev in ["", ".", "..", "../../escape", "C:\\escape"] {
        let parts = String.split(package_identity_path("../../remote", rev), Path.separator());
        assert_eq(parts.len(), 3);
        assert_eq(parts[0], "v2");
        assert_eq(parts[1].len(), 64);
        assert(Array.fold(chars_of(parts[1]), true, |ok, c|
            ok && Array.contains(chars_of("0123456789abcdef"), c)));
        assert(parts[2] != "" && parts[2] != "." && parts[2] != "..");
    }
}
