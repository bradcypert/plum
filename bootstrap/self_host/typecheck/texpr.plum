// The TYPED tree the checker produces and the backend consumes.
//
// `infer.plum` used to compute the type of every expression and throw
// it away, which forced `codegen/codegen.plum` to re-derive
// representations bottom-up as it emitted. That worked for everything
// except a closure literal with no expected type (`let f = |n| n + 1`),
// where the parameter's representation is only pinned by UNIFYING the
// body's use of it — inference, not synthesis. Rather than grow a
// second unifier in the backend, the checker now publishes what it
// already knew.
//
// A `TExpr` is a `PExpr` with two things added:
//
//   1. **A type on every node.** Read it through `texpr_ty` below, not
//      directly — see that function's own comment.
//   2. **A resolved CLASSIFICATION for every call.** `parser.PExpr` has
//      one `ECall` covering user functions, builtins, variant
//      constructors, closure values, methods, `Array.map`, and
//      `println`; telling them apart takes scope information the parser
//      doesn't have. `infer_call` already does that work, and the
//      distinct `TNode` cases below record the answer. That means the
//      backend can never disagree with the checker about what a call
//      IS — a whole class of bug removed rather than tested for.
//
// Cases the checker accepts but the backend doesn't compile (tuples,
// generic instantiation, `unsafe`, `spawn`, `select`) become
// `TUnsupported`, carrying the reason, so the backend's failure names
// the real construct instead of a missing match arm.

use parser;

pub struct TExpr { ty: ITy, node: TNode }

pub struct TBlock { stmts: Array[TStmt], tail: Option[TExpr] }

pub enum TStmt {
    TSLet(parser.PPattern, TExpr),
    TSAssign(String, TExpr),
    TSExpr(TExpr),
}

pub struct TArm { pattern: parser.PPattern, guard: Option[TExpr], body: TExpr }
pub struct TFieldInit { name: String, value: TExpr }

pub enum TNode {
    TInt(Int),
    TFloat(Float),
    TStr(String),
    TBool(Bool),
    // `()` — the unit VALUE. The parser spells it `ETuple([])`; this is
    // where that stops being a tuple.
    TUnitLit,
    TIdent(String),
    // MODULE and name of a top-level 0-parameter binding. Inference used to
    // INLINE these — it returned the global's body in place of the
    // reference — which is correct but makes the backend re-evaluate
    // the body at every mention. `PLUM_DIGIT_CHARS = chars_of(..)` in
    // the lexer was being recomputed once per character classified.
    // Recording a reference instead lets a backend evaluate each global
    // once, into a slot.
    TGlobalRef(String, String),
    TArrayLit(Array[TExpr]),
    TTupleLit(Array[TExpr]),
    TUnary(parser.UOp, TExpr),
    TBinary(parser.BOp, TExpr, TExpr),
    TFieldGet(TExpr, String),
    TIndex(TExpr, TExpr),
    TBlockE(TBlock),
    // then/else are `TExpr`s (a block is just a `TBlockE`), which keeps
    // `TBlock` out of every node that contains a body.
    TIf(TExpr, TExpr, Option[TExpr]),
    TMatch(TExpr, Array[TArm]),
    // pattern, range start, range end, body
    TFor(parser.PPattern, TExpr, TExpr, TExpr),
    // `for x in xs` over an ARRAY, as opposed to `TFor`'s range. Its
    // own node rather than a flag on `TFor`: the two share no operands
    // (a range has two bounds, an array has one iterand) and no codegen
    // (an index-and-load loop versus a counter), so folding them
    // together would be a tag pretending to be a shape.
    // pattern, array, body
    TForArray(parser.PPattern, TExpr, TExpr),
    TClosure(Array[String], TExpr),
    // `Game { score: 0, ..g }` -- the optional `TExpr` is the SPREAD
    // base, whose fields fill in every position the literal does not
    // mention. Carried to the backend rather than desugared in the
    // checker because the copied fields must be INCREMENTED as they are
    // stored: desugaring to `TFieldGet` would produce borrowed values
    // where `cg_store_fields` requires owned ones, and the refcount
    // would come out one short per field.
    TStructLit(String, Array[TFieldInit], Option[TExpr]),
    TVariantNew(String, Array[TExpr]),
    // --- The five resolved call shapes ---
    // A named function: a user's own, or a prelude signature from
    // `builtin_sig`. The name is the SIGNATURE's name, so a
    // module-qualified call (`lexer.tokenize`) has already been
    // resolved to the plain one.
    //
    // The third field is the call's own TYPE ARGUMENTS — one per
    // declared generic parameter, in declared order, empty for a
    // monomorphic function. Inference instantiates a generic
    // signature with fresh variables and then unifies them away;
    // recording those variables here is what lets a backend recover
    // "this call site is `f[Int]`" afterwards, which is exactly the
    // information monomorphization needs and cannot reconstruct.
    // Read them through the function's substitution, like any other
    // recorded type.
    // MODULE, name, arguments, type arguments.
    //
    // The module is recorded, not recoverable: two modules may declare
    // the same function name, so a backend that looked one up by name
    // alone would pick whichever came first. `infer_call` already knows
    // which it resolved to — this is that answer, written down.
    TFnCall(String, String, Array[TExpr], Array[ITy]),
    // Calling a closure VALUE — a local, a parameter, or anything else
    // whose type turned out to be a function.
    TClosureCall(TExpr, Array[TExpr]),
    // `base.method(args)`: the builtin methods (`to_string`, `concat`,
    // `len`, `push`, `set`, `split`, `ends_with`, ...).
    TMethodCall(String, TExpr, Array[TExpr]),
    // `Array.map`/`filter`/`fold` — a namespace call, not a method.
    TArrayNs(String, Array[TExpr]),
    // `ref(v)` — allocates a fresh `Ref[T]` cell holding `v`. Its own
    // node rather than a `TMethodCall`, because it is a CONSTRUCTOR:
    // the operand is the value going in, not a receiver.
    TRefNew(TExpr),
    // A call into an `extern "C"` function: no Plum body, no closure
    // cell, just a direct call to a `declare`d symbol. Its own node
    // rather than a flag on `TFnCall` because the backend does
    // something entirely different with it -- no specialization, no
    // mangling, no argument ownership transfer.
    TExternCall(String, Array[TExpr]),
    // `s.as_cstr()` / `c.as_string()` -- the two conversions between a
    // Plum `String` cell and a raw `char*`.
    TAsCStr(TExpr),
    TAsString(TExpr),
    TPrintln(TExpr),
    TUnsupported(String),
}

// A node's type as recorded DURING inference may still contain
// unresolved variables — `?3` only becomes `Int` once something later
// in the same function body unifies it. Applying the function's final
// substitution is what resolves them, so every consumer must read a
// type through here rather than touching `.ty`.
//
// Doing it at the point of USE, rather than rewriting the whole tree
// once inference finishes, is deliberate: a rewrite pass would be
// another full mirror of this enum to maintain, for no benefit — the
// substitution is idempotent and `subst_apply` is cheap.
pub let texpr_ty (subst: Subst) (e: TExpr): ITy = subst_apply(subst, e.ty)

// A checked top-level function, with its body typed and the
// substitution needed to read those types.
pub struct TParam { name: String, ty: ITy }
// `generics` are the function's own declared type parameters, by name
// and in declared order. A backend that monomorphizes needs them to
// know WHAT to substitute; `TFnCall`'s type arguments say what to
// substitute IN.
// `module` is where the function was declared — needed by a backend so
// that two modules' same-named functions get distinct SYMBOLS.
pub struct TFn { name: String, module: String, generics: Array[String], params: Array[TParam], ret: ITy, body: TExpr, subst: Subst }
