// Layer 2/3: type environment + expression/pattern inference + whole-
// program checking — mirrors `crates/plum-types/src/infer.rs`'s
// `infer_expr`/`infer_program` shape, with two real, deliberate
// simplifications versus the real compiler, both stated up front:
//
// 1. **Top-level function signatures must be fully annotated** (every
//    param, and the return type) — sidesteps the real compiler's
//    hardest, most historically bug-prone piece entirely: Phase 1/
//    Phase 2's "pre-declare with fresh vars, unify with annotations
//    once the body is checked" dance exists ONLY because a signature
//    might need to be INFERRED. When every signature is already
//    concrete text, mutual recursion (even genuinely cyclic call
//    graphs) "just works" for free — every function's signature is
//    already in the environment before ANY body is checked, no
//    unification-order dependency at all. Real Hindley-Milner
//    unification/`Subst`/fresh variables are still fully exercised —
//    just for expression BODIES and unannotated LOCAL `let`s, not
//    signature bootstrapping. A top-level function missing an
//    annotation fails with a clear error, not silent inference.
// 2. **No `Scheme`/`generalize` machinery** — Plum's generics are
//    always explicitly declared (`let f[T] (x: T): T = ...`), never
//    discovered by generalizing an inferred type the way classic ML
//    let-polymorphism does. A generic function's own declared
//    parameter names ARE its scheme; instantiation just substitutes
//    fresh `ITVar`s for them at each call site (`context.plum`'s
//    `instantiate_template`, reused here) — no separate generalize
//    step is needed because there was never anything to generalize
//    FROM.
//
// **Error handling**: `fail_tc` (`panic_raw`), not `Result` — matching
// this bootstrap effort's own established house style throughout
// (`lexer/lexer.plum`'s `unexpected_char`, `parser/parser.plum`'s
// `fail`, `interp/interp.plum`'s `fail_interp`). A real, deliberate
// simplification versus the real compiler's `Result`-based diagnostics
// — this checker can say "this program type-checks" or crash loudly
// explaining why not, which is everything needed to validate accept/
// reject behavior, just not to recover and keep checking past one
// error.

use Os;
use parser;
use lexer;

// --- Where a type error happened ---
//
// The checker runs on a MERGED program: every module's items
// concatenated into one flat list (see main.plum's `collect_project`),
// so there is no ambient "current file" by the time an error is
// reported. The position therefore travels on the AST -- `ItemNode`
// carries the file it was parsed from and its own offset, and `PBlock`
// carries one offset per statement -- and this cell records whichever
// is currently being checked.
//
// **Granularity is a statement, not an expression.** The real compiler
// carets the exact subexpression (`p.nope`); this points at the
// statement containing it. That is a deliberate trade: expression-level
// spans would mean a position on all twenty-odd `PExpr` variants, which
// is ~180 match sites across the parser, interpreter, checker and
// backend, against roughly a dozen for this. Statement granularity is
// what turns "somewhere in your project" into "this line", which is the
// difference that actually matters; going from there to the exact
// column is a refinement that can be made later without redoing any of
// this.
//
// The source is re-read from disk to render, which only ever happens on
// the failure path -- the compiler is about to abort anyway.
// Whether the expression currently being checked is inside an `unsafe`
// block. A cell rather than a threaded parameter for the same reason
// the error position is one: it would otherwise be a new argument on
// every `infer_*` function, and it is consulted in exactly one place.
// Mirrors `plum_types::Infer::in_unsafe`, including that it is saved and
// restored around the block rather than simply set -- a closure defined
// inside an `unsafe` block and CALLED outside it must not carry the
// permission with it.
let UNSAFE: Ref[Bool] = ref(false)

// --- Recorded types, for hover and go-to-definition ---
//
// Every IDENTIFIER occurrence, with the type inference resolved it to
// and which file it was in. This is what lets an editor answer "what is
// the type under my cursor" for a LOCAL -- a name-based lookup can only
// ever find top-level definitions, and gets a shadowed local wrong.
//
// Only identifiers are recorded, not every expression: they are the
// only thing a cursor position can land on, which is why positions live
// on `EIdent`/`EField` alone and not on all twenty-two `PExpr`
// variants. Recording is OFF unless a query asks for it -- `check`,
// `build` and `emit-llvm` should not pay for a table nothing reads.
// `def_offset` is where the identifier's binding is, or -1 when it has
// none recorded -- a top-level name, which the name index answers for
// instead.
pub struct NodeType { pub path: String, pub offset: Int, pub name: String, pub ty: String, pub def_offset: Int }

let RECORD: Ref[Bool] = ref(false)
// `ref([])` cannot pin the element type from the annotation alone --
// the same narrow gap `parser.plum`'s `no_tail` works around, and the
// same fix: a helper whose own declared return type does the pinning.
let no_nodes (unit: Unit): Array[NodeType] = []
let NODES: Ref[Array[NodeType]] = ref(no_nodes(()))

pub let record_types (on: Bool): Unit = { RECORD.set(on); NODES.set(no_nodes(())) }
pub let recorded_types (): Array[NodeType] = NODES.get()

let note_at (name: String) (offset: Int) (ty: ITy) (def_offset: Int): Unit =
    if RECORD.get() && offset >= 0 {
        NODES.set(NODES.get().push(NodeType { path: ERR.get().path, offset: offset, name: name, ty: render_ty(ty), def_offset: def_offset }))
    } else { () }

let note_ident (name: String) (offset: Int) (ty: ITy) (def_offset: Int): Unit = note_at(name, offset, ty, def_offset)

// A BINDING site records itself, so hovering `let n = ..` works and not
// only the uses of `n`. Its own definition is itself.
let note_binding (name: String) (offset: Int) (ty: ITy): Unit = note_at(name, offset, ty, offset)

struct ErrPos { path: String, offset: Int, fn_name: String }
let ERR: Ref[ErrPos] = ref(ErrPos { path: "", offset: 0 - 1, fn_name: "" })

// The FUNCTION being checked, recorded alongside the position. It is
// what a PRELUDE error has instead of a position: prelude source is a
// string inside the compiler, so it has no file to point into, and
// "unknown struct: Array" with no further context is nearly useless
// when the prelude is a thousand lines.
pub let set_err_pos (path: String) (offset: Int) (fn_name: String): Unit =
    ERR.set(ErrPos { path: path, offset: offset, fn_name: fn_name })

// A statement offset of -1 means "synthesized, or parsed without a
// source context" — keep whatever the enclosing item set instead of
// overwriting it with a position that points nowhere.
pub let set_stmt_pos (offset: Int): Unit =
    if offset >= 0 { ERR.set(ErrPos { path: ERR.get().path, offset: offset, fn_name: ERR.get().fn_name }) } else { () }

let fail_tc (msg: String): Unit = {
    let e = ERR.get();
    if e.path == "" || e.offset < 0 {
        panic_raw("self-hosted type checker: ".concat(msg)
            .concat(if e.fn_name == "" { "" } else { " (checking '".concat(e.fn_name).concat("')") }))
    }
    else {
        match Os.read_file(e.path) {
            Ok(src) => panic_raw(lexer.render_at(src, e.path, e.offset, msg)),
            Err(_) => panic_raw("self-hosted type checker: ".concat(msg)),
        }
    }
}

// --- Fresh type variables ---

pub struct FreshState { pub next: Int }
pub let fresh_state_new (unit: Unit): FreshState = FreshState { next: 0 }

struct Fresh { ty: ITy, state: FreshState }
let fresh (state: FreshState): Fresh = Fresh { ty: ITVar(state.next), state: FreshState { next: state.next + 1 } }

let fresh_list (state: FreshState) (n: Int): FreshListResult = fresh_list_acc(state, n, [])
struct FreshListResult { tys: Array[ITy], state: FreshState }
let fresh_list_acc (state: FreshState) (n: Int) (acc: Array[ITy]): FreshListResult =
    if acc.len() >= n { FreshListResult { tys: acc, state: state } }
    else { let f = fresh(state); fresh_list_acc(f.state, n, acc.push(f.ty)) }

// --- Type environment (locals/params) ---

// `def_offset` is where the name was BOUND -- carried so that resolving
// an identifier can say not just what type it has but where it came
// from. A local's binding is always in the same file as its use (a
// function body does not span files), so no path is needed alongside it.
struct EnvBinding { name: String, ty: ITy, def_offset: Int }
pub struct TyEnv { pub bindings: Array[EnvBinding] }
pub let tyenv_empty (unit: Unit): TyEnv = TyEnv { bindings: [] }
pub let tyenv_extend (env: TyEnv) (name: String) (ty: ITy) (def_offset: Int): TyEnv =
    TyEnv { bindings: env.bindings.push(EnvBinding { name: name, ty: ty, def_offset: def_offset }) }
let tyenv_lookup (env: TyEnv) (name: String): Option[EnvBinding] = tyenv_lookup_acc(env.bindings, name, env.bindings.len() - 1)
let tyenv_lookup_acc (bindings: Array[EnvBinding]) (name: String) (i: Int): Option[EnvBinding] =
    if i < 0 { None } else if bindings[i].name == name { Some(bindings[i]) } else { tyenv_lookup_acc(bindings, name, i - 1) }

// --- Top-level function signatures ---

// `module` is where the function was DECLARED. The PRELUDE and the
// builtin signature table both use "" — the root module — which is also
// what a project's root-level files use, so a program can shadow a
// prelude name exactly as it always could.
// `is_extern` marks a signature declared in an `extern "C"` block:
// there is no Plum body to call, the backend emits a `declare` and a
// direct call instead, and reaching one outside `unsafe` is an error.
// `is_pub` is read by ONE rule: a module-qualified call may only reach
// a `pub` item. Everything reached unqualified is in the caller's own
// module or the root, where privacy does not apply.
pub struct FnSig { pub name: String, pub module: String, pub generics: Array[String], pub params: Array[ITy], pub ret: ITy, pub is_extern: Bool, pub is_pub: Bool }
// `current` is the module whose body is being checked right now. It is
// swapped per function rather than threaded as a parameter, for the
// same reason `CgProgram` carries the current substitution: it would
// otherwise have to be added to thirty signatures that do not otherwise
// care.
// `generics` is the ENCLOSING function's type parameters, carried so a
// `let x: T = ..` inside a generic function resolves `T` to `ITParam`
// rather than failing as an unknown type. Everything else here was
// already threaded through every inference call; this rides along.
pub struct Program2 { pub sigs: Array[FnSig], pub globals: Array[GlobalDef], pub ctx: TyContext, pub current: String, pub generics: Array[String] }

pub struct GlobalDef { pub module: String, pub def: parser.LetDefNode }

pub let build_sigs (ctx: TyContext) (program: parser.ProgramNode): Program2 = collect_sigs_acc(ctx, program.items, 0, [], [])

// An extern function has no generics and no body; `Unit` stands in for
// a declaration with no return type, matching how the real compiler
// types a `void` extern (`plum_types::TypeContext::extern_fns`).
let is_unit_ty (t: ITy): Bool = match t { ITUnit => true, _ => false }

let extern_sigs (ctx: TyContext) (fns: Array[parser.ExternFnNode]) (i: Int) (acc: Array[FnSig]): Array[FnSig] =
    if i >= fns.len() { acc }
    else {
        let params = Array.map(fns[i].params, |q| resolve_ann(ctx, [], q.ty));
        let ret = match fns[i].ret_ty { Some(t) => resolve_ann(ctx, [], t), None => ITUnit };
        extern_sigs(ctx, fns, i + 1, acc.push(FnSig { name: fns[i].name, module: "", generics: [], params: params, ret: ret, is_extern: true, is_pub: true }))
    }

let collect_sigs_acc (ctx: TyContext) (items: Array[parser.ItemNode]) (i: Int) (sigs: Array[FnSig]) (globals: Array[GlobalDef]): Program2 =
    if i >= items.len() { Program2 { sigs: sigs, globals: globals, ctx: ctx, current: "", generics: [] } }
    else {
        match items[i].kind {
            IKLet(def) => {
                if Array.is_empty(def.params) { collect_sigs_acc(ctx, items, i + 1, sigs, globals.push(GlobalDef { module: items[i].module, def: def })) }
                else {
                    let generic_names = Array.map(def.generics, |g| g.name);
                    let params = Array.map(def.params, |p| resolve_param_ty(ctx, items[i].module, generic_names, p));
                    let ret = match def.ret_ty {
                        Some(t) => resolve_ann_seen(ctx, items[i].module, generic_names, t),
                        None => { fail_tc("top-level function ".concat(def.name).concat(" needs an explicit return type annotation")); ITUnit },
                    };
                    collect_sigs_acc(ctx, items, i + 1, sigs.push(FnSig { name: def.name, module: items[i].module, generics: generic_names, params: params, ret: ret, is_extern: false, is_pub: items[i].is_pub }), globals)
                }
            },
            // `extern "C" { fn sin(x: Float) -> Float; }` -- a signature
            // with no body. Recorded like any other so ordinary call
            // inference resolves it; `is_extern` is what the unsafe gate
            // and the backend key off.
            IKExtern(block) => collect_sigs_acc(ctx, items, i + 1, Array.concat(sigs, extern_sigs(ctx, block.fns, 0, [])), globals),
            _ => collect_sigs_acc(ctx, items, i + 1, sigs, globals),
        }
    }

// `()` — the Unit pattern — is ONE real parameter of type `Unit`, not
// zero params (see `interp/interp.plum`'s own identical finding, which
// this mirrors exactly, just for TYPES instead of runtime binding
// names: `f()` sugar unifies against `Function([Unit], ret)`, which
// only makes sense if `()` really does mean "one Unit-typed
// parameter").
let resolve_param_ty (ctx: TyContext) (viewer: String) (in_scope: Array[String]) (p: parser.ParamNode): ITy =
    match p {
        ParamIdent(name) => { fail_tc("parameter ".concat(name).concat(" needs an explicit type annotation")); ITUnit },
        ParamPatternTy(pattern, ann) => match ann {
            Some(t) => resolve_ann_seen(ctx, viewer, in_scope, t),
            None => match pattern {
                PTuple(elems) => if Array.is_empty(elems) { ITUnit } else { { fail_tc("destructuring parameters aren't supported yet"); ITUnit } },
                _ => { fail_tc("parameter needs an explicit type annotation"); ITUnit },
            },
        },
    }

// --- The four things the prelude does NOT declare ---
//
// This used to be a table of 97 signatures: a hand-written second copy
// of the prelude's surface, maintained by remembering to. It existed
// because `check` ran WITHOUT the prelude, so the checker had no other
// way to know what `Array.concat` or `Option.unwrap_or` were.
//
// The two copies drifted, silently. `Map`, `Set`, `String.contains` and
// `String.repeat` were declared in the prelude and missing here, so
// `check` rejected programs that `build` compiled and ran correctly --
// a compiler disagreeing with itself about which programs are valid.
//
// `check` prepends the prelude now (see `main.plum`), exactly as the
// backend always has, so 92 of these entries became dead weight
// duplicating source that the checker reads for real. Deleted
// 2026-08-20. Reading the actual prelude costs ~20ms.
//
// What is left is what the prelude genuinely does not declare, and
// each is here for its own reason -- there is no list to keep in sync
// any more, and adding to this one should feel like it needs a reason.
let arr_of (t: ITy): ITy = ITStruct("Array", [t])
let tp (name: String): ITy = ITParam(name)

let builtin_sig (name: String): Option[FnSig] =
    // A built-in ARRAY operation, not a prelude function: there is no
    // `let Array.push` anywhere to read.
    if name == "Array.push" { Some(FnSig { name: name, module: "", generics: ["T"], params: [arr_of(tp("T")), tp("T")], ret: arr_of(tp("T")), is_extern: false, is_pub: true }) }
    // Both are runtime primitives the backend intercepts and emits
    // directly (`cg_runtime_fn`), so neither has a Plum body to declare.
    else if name == "chars_of" { Some(FnSig { name: name, module: "", generics: [], params: [ITStr], ret: arr_of(ITStr), is_extern: false, is_pub: true }) }
    else if name == "panic_raw" { Some(FnSig { name: name, module: "", generics: [], params: [ITStr], ret: ITUnit, is_extern: false, is_pub: true }) }
    // `args()` is written with empty parentheses, which this parser
    // turns into a ZERO-argument call (it implements no `f()`-means-
    // `f(())` sugar), so the signature has to be zero-param to match
    // the real call shape.
    else if name == "args" { Some(FnSig { name: name, module: "", generics: [], params: [], ret: arr_of(ITStr), is_extern: false, is_pub: true }) }
    else { None }

// An UNQUALIFIED name resolves in the CURRENT module first, then in the
// root module `""` — which is where the prelude and any root-level file
// live. It never reaches into a sibling module: crossing a module
// boundary requires naming it, which is the whole point.
//
// This is what makes two modules able to declare the same function.
// Before it, `interp.plum` and `infer.plum` could not both have a
// `bind_params`, and the prelude's private helpers had to be prefixed
// to stay out of the way.
let find_sig (p2: Program2) (name: String): Option[FnSig] =
    match find_sig_in(p2.sigs, p2.current, name, 0) {
        Some(sig) => Some(sig),
        None => match find_sig_in(p2.sigs, "", name, 0) {
            Some(sig) => Some(sig),
            // ...and finally the PRELUDE, which is its own module and
            // so exports only what it marks `pub`. A private prelude
            // helper is simply not found, and reads as unbound -- which
            // is what it now is from outside.
            None => match find_sig_in(p2.sigs, parser.PRELUDE_MODULE(()), name, 0) {
                Some(sig) => if sig.is_pub { Some(sig) } else { None },
                None => None,
            },
        },
    }

// Naming a module and reaching into it is the ONLY way to cross a
// boundary, so it is the only place privacy can be violated. An
// unqualified name never leaves the current module or the root
// (`find_sig` above), and a call within one module is not a crossing
// however the item was declared.
//
// `pub` was parsed into `ItemNode.is_pub` from the beginning and read
// by nothing until 2026-08-27, which made "everything is private by
// default" a documented guarantee that was not true. This is that
// sentence becoming true.
pub let check_visible (p2: Program2) (sig: FnSig) (ns: String) (name: String): Unit =
    if sig.is_pub || ns == p2.current { () }
    else {
        fail_tc(ns.concat(".").concat(name).concat(" is private to ").concat(module_label(ns))
            .concat(". Add `pub` to its declaration to use it from ").concat(module_label(p2.current)))
    }

let find_sig_in (sigs: Array[FnSig]) (module_name: String) (name: String) (i: Int): Option[FnSig] =
    if i >= sigs.len() { None }
    else if sigs[i].name == name && sigs[i].module == module_name { Some(sigs[i]) }
    else { find_sig_in(sigs, module_name, name, i + 1) }

// --- Binding a parameter pattern (only plain-ident/Unit shapes — same
// v1 scope as `interp/interp.plum` and `resolve_param_ty` above) ---

let bind_param (env: TyEnv) (p: parser.ParamNode) (ty: ITy): TyEnv =
    match p {
        ParamIdent(name) => tyenv_extend(env, name, ty, 0 - 1),
        ParamPatternTy(pattern, _) => match pattern {
            PIdent(name, off) => tyenv_extend(env, name, ty, off),
            PTuple(elems) => if Array.is_empty(elems) { env } else { { fail_tc("destructuring parameters aren't supported yet"); env } },
            _ => { fail_tc("destructuring parameters aren't supported yet"); env },
        },
    }

// --- Checking every function body against its own (already fully
// known) signature ---

pub let check_program (program: parser.ProgramNode): Unit = {
    let ctx = build_context(program);
    let p2 = build_sigs(ctx, program);
    check_all_fns(p2, program.items, 0)
}

let check_all_fns (p2: Program2) (items: Array[parser.ItemNode]) (i: Int): Unit =
    if i >= items.len() { () }
    else {
        match items[i].kind {
            IKLet(def) => if Array.is_empty(def.params) { check_all_fns(p2, items, i + 1) } else { { set_err_pos(items[i].path, items[i].start, def.name); check_fn(p2, def, items[i].module); check_all_fns(p2, items, i + 1) } },
            _ => check_all_fns(p2, items, i + 1),
        }
    }

let check_fn (p2: Program2) (def: parser.LetDefNode) (module_name: String): Unit = { check_fn_typed(p2, def, module_name); () }

// Checking a function and PRODUCING its typed body are the same
// operation — the typed tree falls out of inference rather than needing
// a second pass. `check_program` throws the result away; `typed_program`
// keeps it. Nothing can drift between "what the checker proved" and
// "what the backend compiles", because there is only one traversal.
let check_fn_typed (p20: Program2) (def: parser.LetDefNode) (module_name: String): TFn = {
    // Swapped in for the duration of this body: every unqualified name
    // it mentions resolves in ITS module.
    // The signature is looked up against a provisional `Program2` so
    // its generics can be put INTO the real one: `sig.generics` is what
    // makes `let x: T = ..` resolve inside a generic function.
    let p2x = Program2 { sigs: p20.sigs, globals: p20.globals, ctx: p20.ctx, current: module_name, generics: [] };
    let sig = Option.unwrap_or(find_sig(p2x, def.name), FnSig { name: def.name, module: module_name, generics: [], params: [], ret: ITUnit, is_extern: false, is_pub: true });
    let p2 = Program2 { sigs: p20.sigs, globals: p20.globals, ctx: p20.ctx, current: module_name, generics: sig.generics };
    let env = bind_params(tyenv_empty(()), def.params, sig.params, 0);
    let r = infer_expr(p2, fresh_state_new(()), env, subst_empty(()), def.body);
    let body_ty = subst_apply(r.subst, r.ty);
    let ret_ty = subst_apply(r.subst, sig.ret);
    match unify(body_ty, ret_ty) {
        Ok(_) => (),
        Err(e) => fail_tc("function ".concat(def.name).concat(": declared return type ").concat(render_ty(ret_ty)).concat(" doesn't match body type ").concat(render_ty(body_ty)).concat(" (").concat(e).concat(")")),
    };
    TFn { name: def.name, module: module_name, generics: sig.generics, params: typed_params(def.params, sig.params, r.subst, 0, []), ret: ret_ty, body: r.texpr, subst: r.subst }
}

// Parameter names paired with their (now resolved) declared types.
// `()` — the Unit pattern — binds no name and contributes no entry, the
// same treatment it gets in `bind_param`, the interpreter, and the
// backend.
let typed_params (params: Array[parser.ParamNode]) (tys: Array[ITy]) (subst: Subst) (i: Int) (acc: Array[TParam]): Array[TParam] =
    if i >= params.len() || i >= tys.len() { acc }
    else {
        match params[i] {
            ParamIdent(name) => typed_params(params, tys, subst, i + 1, acc.push(TParam { name: name, ty: subst_apply(subst, tys[i]) })),
            ParamPatternTy(pattern, _) => match pattern {
                PIdent(name, _) => typed_params(params, tys, subst, i + 1, acc.push(TParam { name: name, ty: subst_apply(subst, tys[i]) })),
                _ => typed_params(params, tys, subst, i + 1, acc),
            },
        }
    }

// The whole program, type-checked, with every function's body typed —
// the backend's entry point. Fails loudly (`fail_tc`) on any type
// error, exactly as `check_program` does, because it IS `check_program`
// with the results kept.
pub let typed_program (program: parser.ProgramNode): Array[TFn] = {
    let ctx = build_context(program);
    let p2 = build_sigs(ctx, program);
    typed_fns_acc(p2, program.items, 0, [])
}

// Every top-level 0-parameter binding, typed, in declaration order —
// which is the order they have to be initialised in, since one may
// reference another.
pub let typed_globals (program: parser.ProgramNode): Array[TFn] = {
    let ctx = build_context(program);
    let p2 = build_sigs(ctx, program);
    typed_globals_acc(p2, p2.globals, 0, [])
}

let typed_globals_acc (p20: Program2) (globals: Array[GlobalDef]) (i: Int) (acc: Array[TFn]): Array[TFn] =
    if i >= globals.len() { acc }
    else {
        let p2 = Program2 { sigs: p20.sigs, globals: p20.globals, ctx: p20.ctx, current: globals[i].module, generics: [] };
        let r = infer_expr(p2, fresh_state_new(()), tyenv_empty(()), subst_empty(()), globals[i].def.body);
        // The declared type, unified with what the initializer inferred.
        //
        // This was missing entirely: a global's annotation was parsed
        // and then ignored, so it neither CHECKED the initializer nor
        // CONSTRAINED it. The second half is the one that bit. A
        // generic initializer -- `Map.new(())`, `ref([])` -- still has
        // free type variables when its instantiation is recorded for
        // the backend, and free variables get DEFAULTED to a scalar. So
        // `let M: Map[String, String] = Map.new(())` produced a map
        // monomorphized for something else, and reading a `String` back
        // out emitted `store ptr %t, ptr %p` with an `i1` in hand.
        //
        // The compiler worked around this twice in its own source
        // before it was understood -- see `NODES` in this file, a
        // global whose element type is pinned by a helper function's
        // declared return type because its own annotation could not do
        // it.
        //
        // Unifying here fixes both halves at once, and the substitution
        // that comes out is what the body's recorded instantiations are
        // resolved through.
        let s2 = match globals[i].def.ret_ty {
            None => r.subst,
            Some(t) => {
                let declared = resolve_ann(p2.ctx, [], t);
                match unify(subst_apply(r.subst, r.ty), declared) {
                    Ok(s) => subst_compose(s, r.subst),
                    Err(e) => {
                        fail_tc("global ".concat(globals[i].def.name).concat(": declared type ").concat(render_ty(declared))
                            .concat(" doesn't match its value's type ").concat(render_ty(subst_apply(r.subst, r.ty))).concat(" (").concat(e).concat(")"));
                        r.subst
                    },
                }
            },
        };
        typed_globals_acc(p20, globals, i + 1,
            acc.push(TFn { name: globals[i].def.name, module: globals[i].module, generics: [], params: [], ret: subst_apply(s2, r.ty), body: r.texpr, subst: s2 }))
    }

let typed_fns_acc (p2: Program2) (items: Array[parser.ItemNode]) (i: Int) (acc: Array[TFn]): Array[TFn] =
    if i >= items.len() { acc }
    else {
        match items[i].kind {
            IKLet(def) => if Array.is_empty(def.params) { typed_fns_acc(p2, items, i + 1, acc) } else { typed_fns_acc(p2, items, i + 1, acc.push(check_fn_typed(p2, def, items[i].module))) },
            _ => typed_fns_acc(p2, items, i + 1, acc),
        }
    }

let bind_params (env: TyEnv) (params: Array[parser.ParamNode]) (tys: Array[ITy]) (i: Int): TyEnv =
    if i >= params.len() { env } else { bind_params(bind_param(env, params[i], tys[i]), params, tys, i + 1) }

// --- Expression inference ---

// `texpr` is the TYPED tree for the expression just inferred — see
// `texpr.plum` for what it is and why the checker publishes it. Every
// arm of `infer_expr` builds one; nothing else about inference changed.
pub struct InferResult { pub ty: ITy, pub subst: Subst, pub state: FreshState, pub texpr: TExpr }

// Building an `InferResult` whose node needs no children.
let ir_leaf (ty: ITy) (subst: Subst) (state: FreshState) (node: TNode): InferResult =
    InferResult { ty: ty, subst: subst, state: state, texpr: TExpr { ty: ty, node: node } }

// The `TUnsupported` shape every "isn't supported yet" arm returns, so
// the backend's own failure names the construct rather than falling off
// a match.
let ir_unsupported (subst: Subst) (state: FreshState) (what: String): InferResult =
    ir_leaf(ITUnit, subst, state, TUnsupported(what))

pub let infer_expr (p2: Program2) (state: FreshState) (env: TyEnv) (acc: Subst) (e: parser.PExpr): InferResult =
    match e {
        EInt(v) => ir_leaf(ITInt, acc, state, TInt(v)),
        EFloat(v) => ir_leaf(ITFloat, acc, state, TFloat(v)),
        EStr(v) => ir_leaf(ITStr, acc, state, TStr(v)),
        EBool(v) => ir_leaf(ITBool, acc, state, TBool(v)),
        EIdent(name, off) => infer_ident(p2, state, env, acc, name, off),
        ETuple(elems) => infer_tuple(p2, state, env, acc, elems),
        EUnary(op, inner) => infer_unary(p2, state, env, acc, op, inner),
        // Desugared, not inferred directly: `|>` has no type of its
        // own, it just rearranges a call (parser.plum::desugar_pipe).
        EBinary(BPipe, lhs, rhs) => infer_expr(p2, state, env, acc, parser.desugar_pipe(lhs, rhs)),
        EBinary(op, lhs, rhs) => infer_binary(p2, state, env, acc, op, lhs, rhs),
        EField(base, name) => infer_field(p2, state, env, acc, base, name),
        ECall(callee, args) => infer_call(p2, state, env, acc, callee, args),
        EBlock(block) => infer_block(p2, state, env, acc, block),
        EIf(cond, then_branch, else_branch) => infer_if(p2, state, env, acc, cond, then_branch, else_branch),
        EMatch(scrutinee, arms, _) => infer_match(p2, state, env, acc, scrutinee, arms),
        EFor(pattern, iter, body) => infer_for(p2, state, env, acc, pattern, iter, body),
        EStructLit(path, fields, spread) => infer_struct_lit(p2, state, env, acc, path, fields, spread),
        // `f[T](x)` -- explicit type arguments -- is NOT a feature the
        // real compiler has either: `GenericInst` parses, but the only
        // form with meaning anywhere is `channel[T]()`, and everything
        // else is rejected there too ("type inference not yet
        // implemented for this expression form"). So this arm is not a
        // gap versus the real compiler; the `channel` half of it is
        // simply part of the concurrency scope cut. The message used to
        // claim a whole missing feature.
        EGenericInst(callee, _) =>
            match callee {
                EIdent(name, _) => if name == "channel" { fail_tc("channels aren't supported yet"); ir_unsupported(acc, state, "channel") }
                    else { fail_tc("type inference not yet implemented for this expression form"); ir_unsupported(acc, state, "generic instantiation") },
                _ => { fail_tc("type inference not yet implemented for this expression form"); ir_unsupported(acc, state, "generic instantiation") },
            },
        EIndex(base, idx) => infer_index(p2, state, env, acc, base, idx),
        EArray(elems) => infer_array_lit(p2, state, env, acc, elems),
        EClosure(params, body) => infer_closure(p2, state, env, acc, params, body),
        // `unsafe { .. }` is an ordinary block that flips the gate while
        // it is being checked. The block's own type is the result, so
        // there is no node for it in the typed tree -- by the time the
        // backend runs, the gate has already done its whole job.
        EUnsafe(block) => {
            let was = UNSAFE.get();
            UNSAFE.set(true);
            let r = infer_block(p2, state, env, acc, block);
            UNSAFE.set(was);
            r
        },
        // `spawn { body }` runs `body` on another thread and evaluates
        // to a `Task[T]` to join later. The body is inferred exactly as
        // a block, then wrapped as a zero-parameter closure for the
        // backend to lift -- it captures its enclosing locals, which is
        // what a closure already knows how to do.
        ESpawn(block) => {
            let r = infer_block(p2, state, env, acc, block);
            let body_ty = subst_apply(r.subst, r.ty);
            ir_leaf(ITStruct("Task", [body_ty]), r.subst, r.state,
                TSpawn(TExpr { ty: ITFunction([], body_ty), node: TClosure([], r.texpr) }))
        },
        // Channels ARE supported -- `channel[T]()`, `send`, `recv`. Only
        // `select` is not, and saying "select/channels" sent people
        // looking for a channel bug that was not there.
        ESelect(arms, _) => infer_select(p2, state, env, acc, arms),
    }

// A closure literal's params get FRESH type variables (no annotations
// exist at all on `|a, b| ...` syntax) — its own type is only pinned
// down by how it's later USED (unified against the params it's called
// with, or against a struct field's declared function type in a
// struct literal). Mirrors `infer_fn_call`'s `fresh_list`-then-unify
// shape, just the other direction: here the fresh vars start OUT as
// the closure's own declared shape, rather than being unified against
// an already-known signature.
let infer_closure (p2: Program2) (state: FreshState) (env: TyEnv) (acc: Subst) (params: Array[String]) (body: parser.PExpr): InferResult = {
    let fr = fresh_list(state, params.len());
    let env2 = extend_closure_params(env, params, fr.tys, 0);
    let r = infer_expr(p2, fr.state, env2, acc, body);
    let fn_ty = ITFunction(Array.map(fr.tys, |t| subst_apply(r.subst, t)), subst_apply(r.subst, r.ty));
    InferResult { ty: fn_ty, subst: r.subst, state: r.state, texpr: TExpr { ty: fn_ty, node: TClosure(params, r.texpr) } }
}

let extend_closure_params (env: TyEnv) (params: Array[String]) (tys: Array[ITy]) (i: Int): TyEnv =
    if i >= params.len() { env } else { extend_closure_params(tyenv_extend(env, params[i], tys[i], 0 - 1), params, tys, i + 1) }

let infer_ident (p2: Program2) (state: FreshState) (env: TyEnv) (acc: Subst) (name: String) (offset: Int): InferResult =
    match tyenv_lookup(env, name) {
        // `subst_apply(acc, ..)`, NOT the raw stored type. A binding is
        // recorded in `TyEnv` with whatever type it had when it was
        // bound, and nothing ever rewrites the environment afterwards
        // (there is deliberately no `tyenv_apply` — that walk is what
        // makes the Rust checker's own `TypeEnv::apply_subst` cost
        // 42.7M entry visits on this compiler's source). So a variable
        // whose type was PINNED DOWN after it was bound still reads
        // back unconstrained here.
        //
        // That was a real unsoundness, not a theoretical one:
        //
        //     let f = |n| if n == 0 { !n } else { true };
        //
        // `n == 0` pins n to Int; `!n` then needs Bool. Reading the
        // stale, unconstrained `n` let `!` unify it with Bool locally,
        // and `subst_compose` favors the already-established binding
        // for a repeated variable, so the conflicting one was silently
        // DISCARDED instead of reported. `check` answered "ok" and
        // codegen went on to emit `xor i1` against an `i64`, which only
        // `clang` finally rejected — with no source location.
        //
        // Resolving at lookup fixes it without reintroducing the walk:
        // `acc` is already threaded through inference, so this is O(the
        // substitution) at the handful of points that read a name,
        // rather than O(the environment) at every refinement.
        Some(b) => {
            let resolved = subst_apply(acc, b.ty);
            note_ident(name, offset, resolved, b.def_offset);
            ir_leaf(resolved, acc, state, TIdent(name))
        },
        // A top-level 0-parameter binding. Its BODY is still inferred —
        // that is where its type comes from, and it has to be checked
        // anyway — but the node records a REFERENCE rather than the
        // inlined body, so a backend can evaluate it once into a slot
        // instead of at every mention.
        None => match find_global_def(p2, name) {
            Some(def) => {
                let r = infer_expr(p2, state, tyenv_empty(()), acc, def.body);
                note_ident(name, offset, r.ty, 0 - 1);
                ir_leaf(r.ty, r.subst, r.state, TGlobalRef(global_module_of(p2, name), name))
            },
            // A bare name that turns out to be a FUNCTION is that
            // function as a VALUE -- `Array.map(xs, double)`,
            // `http_serve_once(port, handler)`, `let f = double`.
            //
            // Until 2026-08-21 this fell straight through to "unbound
            // variable", which was a strange thing to say about a
            // function defined ten lines up: the checker looked the
            // name up among LOCALS only, and consulted signatures just
            // for names in CALL position. So the same name worked in
            // one place and was invisible in the other.
            //
            // `infer_partial_call` with NO arguments already is the
            // eta-expansion this needs -- every parameter becomes
            // residual, and it builds `TClosure(params, TFnCall(..))`
            // over them. The backend needs nothing new; closures
            // already work, which is why the workaround (writing
            // `|n| double(n)` by hand) always did.
            None => match find_sig(p2, name) {
                Some(sig) => infer_partial_call(p2, state, env, acc, sig, []),
                None => match builtin_sig(name) {
                    Some(sig) => infer_partial_call(p2, state, env, acc, sig, []),
                    None => if is_capitalized_name(name) { infer_variant_ref(p2, state, acc, name) } else { { fail_tc("unbound variable: ".concat(name)); ir_unsupported(acc, state, "unbound variable ".concat(name)) } },
                },
            },
        },
    }

// Same rule as `find_sig`: current module, then the root.
// Which module a resolved global came from — the same current-then-root
// order `find_global_def` uses, so the two always agree.
let global_module_of (p2: Program2) (name: String): String =
    match find_global_in(p2.globals, p2.current, name, 0) { Some(_) => p2.current, None => "" }

let find_global_def (p2: Program2) (name: String): Option[parser.LetDefNode] =
    match find_global_in(p2.globals, p2.current, name, 0) {
        Some(d) => Some(d),
        None => find_global_in(p2.globals, "", name, 0),
    }

let find_global_in (globals: Array[GlobalDef]) (module_name: String) (name: String) (i: Int): Option[parser.LetDefNode] =
    if i >= globals.len() { None }
    else if globals[i].def.name == name && globals[i].module == module_name { Some(globals[i].def) }
    else { find_global_in(globals, module_name, name, i + 1) }

let find_global_def_unused (globals: Array[parser.LetDefNode]) (name: String): Option[parser.LetDefNode] = find_global_acc(globals, name, 0)
let find_global_acc (globals: Array[parser.LetDefNode]) (name: String) (i: Int): Option[parser.LetDefNode] =
    if i >= globals.len() { None } else if globals[i].name == name { Some(globals[i]) } else { find_global_acc(globals, name, i + 1) }

// Pre-split uppercase alphabet as a GLOBAL (evaluated once), tested
// with `Array.contains` — NOT `String.index_of("ABC...", c)`, which
// re-splits the whole 26-character literal into 26 fresh heap strings
// on every single call. See `lexer/lexer.plum`'s own character-
// classification comment for the measurement behind this.
let UPPERCASE_CHARS: Array[String] = chars_of("ABCDEFGHIJKLMNOPQRSTUVWXYZ")

let is_capitalized_name (name: String): Bool = Array.contains(UPPERCASE_CHARS, chars_of(name)[0])

// `()` is the UNIT VALUE, not a zero-element tuple — the parser
// produces `ETuple([])` for it (there's no separate unit literal node),
// so this is where that gets mapped back. Without it, `usage(())`
// against `let usage (): Unit` failed as "() != Unit": the argument
// inferred as `ITTuple([])` while the parameter resolved to `ITUnit`
// (`resolve_param_ty` already maps the Unit PATTERN that way).
let infer_tuple (p2: Program2) (state: FreshState) (env: TyEnv) (acc: Subst) (elems: Array[parser.PExpr]): InferResult =
    if Array.is_empty(elems) { ir_leaf(ITUnit, acc, state, TUnitLit) }
    else {
        let r = infer_list(p2, state, env, acc, elems, 0, [], []);
        ir_leaf(ITTuple(r.tys), r.subst, r.state, TTupleLit(r.texprs))
    }

struct InferListResult { tys: Array[ITy], subst: Subst, state: FreshState, texprs: Array[TExpr] }
let infer_list (p2: Program2) (state: FreshState) (env: TyEnv) (acc: Subst) (exprs: Array[parser.PExpr]) (i: Int) (tys: Array[ITy]) (texprs: Array[TExpr]): InferListResult =
    if i >= exprs.len() { InferListResult { tys: tys, subst: acc, state: state, texprs: texprs } }
    else {
        let r = infer_expr(p2, state, env, acc, exprs[i]);
        infer_list(p2, r.state, env, r.subst, exprs, i + 1, tys.push(r.ty), texprs.push(r.texpr))
    }

// `Array[T]` is represented as `ITStruct("Array", [T])` — see `context.
// plum`'s own top comment for why (matches the real compiler's own
// `Type::Struct("Array", ..)` representation exactly, reusing existing
// `ITStruct` machinery rather than adding a dedicated `ITy` case).
let infer_array_lit (p2: Program2) (state: FreshState) (env: TyEnv) (acc: Subst) (elems: Array[parser.PExpr]): InferResult =
    if Array.is_empty(elems) {
        let f = fresh(state);
        ir_leaf(ITStruct("Array", [f.ty]), acc, f.state, TArrayLit([]))
    } else {
        let r = infer_list(p2, state, env, acc, elems, 0, [], []);
        let u = unify_all_same(r.tys, r.subst);
        ir_leaf(ITStruct("Array", [u.ty]), u.subst, r.state, TArrayLit(r.texprs))
    }

// Unifies every entry of `tys` against the FIRST one — the array-
// literal-elements counterpart to `infer_if`'s two-branch unification,
// just folded over N entries instead of 2.
struct UnifyAllResult { ty: ITy, subst: Subst }
let unify_all_same (tys: Array[ITy]) (acc: Subst): UnifyAllResult = unify_all_same_from(tys, tys[0], 1, acc)
let unify_all_same_from (tys: Array[ITy]) (first: ITy) (i: Int) (acc: Subst): UnifyAllResult =
    if i >= tys.len() { UnifyAllResult { ty: subst_apply(acc, first), subst: acc } }
    else {
        let s = match unify(subst_apply(acc, first), subst_apply(acc, tys[i])) { Ok(s) => subst_compose(s, acc), Err(e) => { fail_tc("array literal elements: ".concat(e)); acc } };
        unify_all_same_from(tys, first, i + 1, s)
    }

let infer_index (p2: Program2) (state: FreshState) (env: TyEnv) (acc: Subst) (base: parser.PExpr) (idx: parser.PExpr): InferResult = {
    let br = infer_expr(p2, state, env, acc, base);
    let elem_fresh = fresh(br.state);
    let s1 = match unify(subst_apply(br.subst, br.ty), ITStruct("Array", [elem_fresh.ty])) { Ok(s) => subst_compose(s, br.subst), Err(e) => { fail_tc("indexing: ".concat(e)); br.subst } };
    let ir = infer_expr(p2, elem_fresh.state, env, s1, idx);
    let s2 = match unify(subst_apply(ir.subst, ir.ty), ITInt) { Ok(s) => subst_compose(s, ir.subst), Err(e) => { fail_tc("index must be an Int: ".concat(e)); ir.subst } };
    ir_leaf(subst_apply(s2, elem_fresh.ty), s2, ir.state, TIndex(br.texpr, ir.texpr))
}

let infer_unary (p2: Program2) (state: FreshState) (env: TyEnv) (acc: Subst) (op: parser.UOp) (inner: parser.PExpr): InferResult = {
    let r = infer_expr(p2, state, env, acc, inner);
    match op {
        UNot => ir_leaf(unify_or_fail(r.ty, ITBool), r.subst, r.state, TUnary(op, r.texpr)),
        UNeg => ir_leaf(r.ty, r.subst, r.state, TUnary(op, r.texpr)),
    }
}

let unify_or_fail (a: ITy) (b: ITy): ITy = match unify(a, b) { Ok(_) => b, Err(e) => { fail_tc(e); b } }

let infer_binary (p2: Program2) (state: FreshState) (env: TyEnv) (acc: Subst) (op: parser.BOp) (lhs: parser.PExpr) (rhs: parser.PExpr): InferResult = {
    let lr = infer_expr(p2, state, env, acc, lhs);
    let rr = infer_expr(p2, lr.state, env, lr.subst, rhs);
    let combined = match unify(subst_apply(rr.subst, lr.ty), subst_apply(rr.subst, rr.ty)) {
        Ok(s) => subst_compose(s, rr.subst),
        Err(e) => { fail_tc("'".concat(op_name(op)).concat("': ").concat(e)); rr.subst },
    };
    let operand_ty = subst_apply(combined, lr.ty);
    reject_function_equality(p2, op, operand_ty);
    reject_unordered_comparison(op, operand_ty);
    ir_leaf(binary_result_ty(op, operand_ty), combined, rr.state, TBinary(op, lr.texpr, rr.texpr))
}

// `==`/`!=` on anything CONTAINING a function is a type error, not a
// backend failure. Mirrors the real compiler's own check (see
// `plum_types::Infer::first_function_within`), added there and here at
// the same time for the same reason: the two backends failed
// differently, late, and without a source location -- and one step out,
// for a struct with a closure FIELD, they disagreed outright (a runtime
// error under the interpreter, `true` under native codegen, for two
// different closures).
// `<`, `<=`, `>` and `>=` need an ORDER, and only `Int`, `Float` and
// `String` have one.
//
// Nothing checked this before, so every other type reached codegen and
// got whatever the generic emitter did with it -- a comparison of
// ADDRESSES for anything heap-allocated, and a signed comparison of an
// `i1` for `Bool`, where `true` is -1 and `true < false` came out
// true. `[1] < [2]` and `[2] < [1]` were BOTH true at once, which no
// ordering can satisfy; that is the shape of the whole class.
//
// Rejecting rather than DEFINING an ordering for aggregates is
// deliberate. Lexicographic for arrays and field-order for structs
// would both be defensible, and enums have no obvious answer at all --
// that is a language design decision, and nothing needs it. Rejecting
// can be relaxed later; the reverse cannot.
//
// An unresolved type variable is ALLOWED through. This checker has no
// bounds (its own documented v1 cut), so a `T` cannot be known to be
// ordered or not, and rejecting every one would reject correct generic
// code to catch a case nothing writes. The concrete types are where
// the bugs were.
let reject_unordered_comparison (op: parser.BOp) (t: ITy): Unit =
    if is_ordered_op(op) && is_known_unordered(t) {
        fail_tc("'".concat(op_name(op)).concat("' needs an ordered type -- Int, Float or String -- but got ").concat(render_ty(t)))
    } else { () }

let is_ordered_op (op: parser.BOp): Bool =
    match op { BLt => true, BLe => true, BGt => true, BGe => true, _ => false }

// True only when the type is KNOWN and known not to be ordered. A type
// variable answers false: unknown is not the same as unordered.
let is_known_unordered (t: ITy): Bool =
    match t {
        ITInt => false,
        ITFloat => false,
        ITStr => false,
        ITVar(_) => false,
        ITParam(_) => false,
        _ => true,
    }

let reject_function_equality (p2: Program2) (op: parser.BOp) (t: ITy): Unit =
    match op {
        BEq => reject_if_functional(p2, "==", t),
        BNe => reject_if_functional(p2, "!=", t),
        _ => (),
    }

let reject_if_functional (p2: Program2) (sym: String) (t: ITy): Unit =
    match first_function_within(p2.ctx, t, []) {
        Some(inner) => fail_tc("'".concat(sym).concat("' is not supported for ").concat(render_ty(t))
            .concat(if render_ty(inner) == render_ty(t) { ": a function has no meaningful equality" }
                    else { ": it would have to compare ".concat(render_ty(inner)).concat(", and a function has no meaningful equality") })),
        None => (),
    }

// The first function type reachable inside `t` -- directly, or through
// a type argument, a struct field, or a variant payload. `seen` guards
// recursive declarations BY NAME, which can only under-report (leaving
// today's behaviour untouched) and never reject something legitimate.
let first_function_within (ctx: TyContext) (t: ITy) (seen: Array[String]): Option[ITy] =
    match t {
        ITFunction(_, _) => Some(t),
        ITStruct(name, args) =>
            if Array.contains(seen, name) { None }
            else {
                let inner = first_function_in_list(ctx, args, seen.push(name), 0);
                if Option.is_some(inner) { inner }
                else {
                    // `Array`/`Ref` and friends are BUILTIN: they have
                    // no declaration to read fields from, and asking
                    // for one is an error rather than an empty answer.
                    // Their element type is a type ARGUMENT, already
                    // walked just above.
                    match find_struct(ctx, name) {
                        None => None,
                        Some(_) => first_function_in_list(ctx,
                            Array.map(ctx_field_types(ctx, name), |ft| instantiate_template(ctx_struct_generics(ctx, name), args, ft)),
                            seen.push(name), 0),
                    }
                }
            },
        ITEnum(name, args) =>
            if Array.contains(seen, name) { None }
            else {
                let inner = first_function_in_list(ctx, args, seen.push(name), 0);
                if Option.is_some(inner) { inner }
                else {
                    match ctx_enum_tags(ctx, name) {
                        Some(tags) => first_function_in_variants(ctx, name, tags, args, seen.push(name), 0),
                        None => None,
                    }
                }
            },
        _ => None,
    }

let first_function_in_list (ctx: TyContext) (ts: Array[ITy]) (seen: Array[String]) (i: Int): Option[ITy] =
    if i >= ts.len() { None }
    else {
        match first_function_within(ctx, ts[i], seen) {
            Some(f) => Some(f),
            None => first_function_in_list(ctx, ts, seen, i + 1),
        }
    }

let first_function_in_variants (ctx: TyContext) (enum_name: String) (tags: Array[String]) (args: Array[ITy]) (seen: Array[String]) (i: Int): Option[ITy] =
    if i >= tags.len() { None }
    else {
        let payload = Array.map(ctx_variant_payload(ctx, enum_name, tags[i]), |pt| instantiate_template(ctx_variant_generics(ctx, enum_name, tags[i]), args, pt));
        match first_function_in_list(ctx, payload, seen, 0) {
            Some(f) => Some(f),
            None => first_function_in_variants(ctx, enum_name, tags, args, seen, i + 1),
        }
    }

let op_name (op: parser.BOp): String = match op {
    BAdd => "+", BSub => "-", BMul => "*", BDiv => "/", BRem => "%",
    BEq => "==", BNe => "!=", BLt => "<", BGt => ">", BLe => "<=", BGe => ">=",
    BAnd => "&&", BOr => "||", BRange => "..", BPipe => "|>",
}

let binary_result_ty (op: parser.BOp) (operand_ty: ITy): ITy =
    match op {
        BAdd => operand_ty, BSub => operand_ty, BMul => operand_ty, BDiv => operand_ty, BRem => operand_ty,
        BEq => ITBool, BNe => ITBool, BLt => ITBool, BGt => ITBool, BLe => ITBool, BGe => ITBool,
        BAnd => ITBool, BOr => ITBool,
        BRange => operand_ty,
        // Unreachable: `infer_expr` desugars `|>` before it gets here.
        BPipe => { fail_tc("internal: un-desugared '|>'"); ITUnit },
    }

// A struct value's type must ALREADY be concrete (resolved through the
// running `Subst`) — mirrors the real compiler's own documented
// constraint EXACTLY (`Expr::Field`'s inference requires `base`'s type
// to already be a resolved `Type::Struct`, found and fixed for
// GLOBALS, then again for FUNCTION forward-references, during Stage 2
// — see DESIGN.md's "Stage 2: self-hosted parser" section). This
// checker never needs the fix Stage 2 needed (no forward-reference
// problem here at all — every top-level signature is fully known
// before any body is checked, per this file's own top comment) but the
// UNDERLYING constraint on field access itself is the same regardless.
let infer_field (p2: Program2) (state: FreshState) (env: TyEnv) (acc: Subst) (base: parser.PExpr) (name: String): InferResult =
    // `String.len` as a VALUE -- a qualified function name, not a field
    // read. Checked BEFORE the base is inferred, because inferring
    // `String` on its own fails first ("unbound variant/function:
    // String") and the field never gets looked at.
    //
    // Bare function names became values earlier the same day
    // (`Array.map(xs, double)`); dotted ones did not, because they
    // arrive here as a field access rather than as an identifier. That
    // left `Array.map(xs, String.len)` failing right after
    // `Array.map(xs, double)` started working, which is a worse state
    // than neither working.
    //
    // A LOCAL shadows this: a capitalized variable is unusual but
    // legal, and `Thing.field` on one must stay a field read.
    match qualified_fn_ref(p2, env, base, name) {
        Some(sig) => infer_partial_call(p2, state, env, acc, sig, []),
        None => match qualified_variant(p2, env, base, name) {
            Some(v) => infer_variant_ref_v(p2, state, acc, name, v),
            None => infer_field_read(p2, state, env, acc, base, name),
        },
    }

// A dotted expression read back as a NAME: `Shade` from `Shade.Light`,
// `inner.Shade` from `inner.Shade.Light`. `None` for anything that is
// not a chain of plain identifiers, which is everything that could be
// a real value.
let enum_path_name (base: parser.PExpr): Option[String] =
    match base {
        EIdent(ns, _) => Some(ns),
        EField(inner, seg) => match enum_path_name(inner) { Some(pre) => Some(pre.concat(".").concat(seg)), None => None },
        _ => None,
    }

// `Shade.Light` -- a variant said with its enum, which is the way to
// say which `Light` you mean when two enums declare one. The enum name
// resolves the way a TYPE annotation does (the viewer's module, then
// the root, then the prelude), so `Result.Ok` still reaches the
// prelude from a module that declares an `Ok` of its own.
//
// A LOCAL shadows this, the same as `qualified_fn_ref`: `Shade` could
// name a value.
let qualified_variant (p2: Program2) (env: TyEnv) (base: parser.PExpr) (tag: String): Option[VariantLookup] =
    match enum_path_name(base) {
        None => None,
        Some(ns) =>
            if Option.is_some(tyenv_lookup(env, ns)) { None }
            else { match best_enum(p2.ctx, p2.current, ns) {
                None => None,
                Some(info) => find_variant_in(p2.ctx, info.name, tag),
            } },
    }

// The signature `Ns.name` names, when `base` is a bare capitalized
// identifier that is not a local.
let qualified_fn_ref (p2: Program2) (env: TyEnv) (base: parser.PExpr) (name: String): Option[FnSig] =
    match base {
        EIdent(ns, _) =>
            if !is_capitalized_name(ns) { None }
            else if Option.is_some(tyenv_lookup(env, ns)) { None }
            else {
                let qualified = ns.concat(".").concat(name);
                match find_sig(p2, qualified) { Some(sig) => Some(sig), None => builtin_sig(qualified) }
            },
        _ => None,
    }

let infer_field_read (p2: Program2) (state: FreshState) (env: TyEnv) (acc: Subst) (base: parser.PExpr) (name: String): InferResult = {
    let r = infer_expr(p2, state, env, acc, base);
    let base_ty = subst_apply(r.subst, r.ty);
    match base_ty {
        ITStruct(struct_name, args) => match find_struct(p2.ctx, struct_name) {
            Some(info) => match find_field_template(info.fields, name) {
                Some(field_ty) => {
                    check_field_visible(p2.ctx, p2.current, struct_name, name);
                    ir_leaf(instantiate_template(info.generics, args, field_ty), r.subst, r.state, TFieldGet(r.texpr, name))
                },
                None => { fail_tc("struct ".concat(struct_name).concat(" has no field named ").concat(name)); ir_unsupported(r.subst, r.state, "bad field access") },
            },
            // Naming the FIELD matters: reaching here with `Array`
            // means something is reading `.field` off an array, and
            // which field says which expression is at fault.
            None => { fail_tc("no such type '".concat(struct_name).concat("' to read field '").concat(name).concat("' from")); ir_unsupported(r.subst, r.state, "unknown struct") },
        },
        _ => { fail_tc("field access requires a struct value with a statically known type, found ".concat(render_ty(base_ty))); ir_unsupported(r.subst, r.state, "field access on a non-struct") },
    }
}

let check_all_fields_visible (p2: Program2) (info: StructInfo) (i: Int): Unit =
    if i >= info.fields.len() { () }
    else {
        check_field_visible(p2.ctx, p2.current, info.name, info.fields[i].name);
        check_all_fields_visible(p2, info, i + 1)
    }

let find_field_template (fields: Array[StructFieldTemplate]) (name: String): Option[ITy] = find_field_template_acc(fields, name, 0)
let find_field_template_acc (fields: Array[StructFieldTemplate]) (name: String) (i: Int): Option[ITy] =
    if i >= fields.len() { None } else if fields[i].name == name { Some(fields[i].ty) } else { find_field_template_acc(fields, name, i + 1) }

// A variant tag referenced BARE. With no payload that is just the
// value (`None`); with one it is the CONSTRUCTOR as a function --
// `Array.map(xs, Circle)` -- and eta-expands exactly as a bare
// function name does.
//
// Without this the bare reference reached `infer_variant` with no
// arguments and reported "variant expects a different number of
// arguments", which describes a call nobody wrote.
// A name that is not bound but IS a stdlib module is almost always a
// missing `use`, not a typo -- most often in code written before the
// module existed, or copied from documentation that predates it.
// Saying so is the whole cost of having gated the module behind `use`.
let unbound_message (tag: String): String =
    if Array.contains(parser.std_module_names(), tag) {
        "unbound variant/function: ".concat(tag).concat(" -- `").concat(tag)
            .concat("` is a standard library module; add `use ").concat(tag).concat(";` to this file")
    } else { "unbound variant/function: ".concat(tag) }

// An UNQUALIFIED tag, resolved with no scrutinee to point at one enum.
// One candidate is the answer. More than one is decided by the module
// doing the writing -- a `Verdict.Ok` declared here shadows the
// prelude's `Result.Ok` the same way a type declared here shadows a
// prelude type -- and if that does not narrow it to one, the program
// has to say which, because guessing is how the checker and the
// backend came to disagree in the first place.
let resolve_variant (p2: Program2) (tag: String): Option[VariantLookup] = {
    let cands = variant_candidates(p2.ctx, tag);
    if Array.is_empty(cands) { None }
    else if cands.len() == 1 { Some(cands[0]) }
    else {
        let mine = variants_in_module(cands, p2.current, 0, []);
        if mine.len() == 1 { Some(mine[0]) }
        else if Array.is_empty(mine) { { fail_tc(ambiguous_tag_message(tag, cands)); Some(cands[0]) } }
        else { { fail_tc(ambiguous_tag_message(tag, mine)); Some(mine[0]) } }
    }
}

let ambiguous_tag_message (tag: String) (cands: Array[VariantLookup]): String =
    "`".concat(tag).concat("` is a variant of ").concat(join_enum_names(cands, 0, ""))
        .concat(" -- write ").concat(parser.display_type_name(cands[0].enum_name)).concat(".").concat(tag)
        .concat(" to say which one you mean")

let join_enum_names (cands: Array[VariantLookup]) (i: Int) (acc: String): String =
    if i >= cands.len() { acc }
    else {
        let name = parser.display_type_name(cands[i].enum_name);
        if acc == "" { join_enum_names(cands, i + 1, name) }
        else if i == cands.len() - 1 { join_enum_names(cands, i + 1, acc.concat(" and ").concat(name)) }
        else { join_enum_names(cands, i + 1, acc.concat(", ").concat(name)) }
    }

let infer_variant_ref (p2: Program2) (state: FreshState) (acc: Subst) (tag: String): InferResult =
    match resolve_variant(p2, tag) {
        None => { fail_tc(unbound_message(tag)); ir_unsupported(acc, state, "unbound variant ".concat(tag)) },
        Some(v) => infer_variant_ref_v(p2, state, acc, tag, v),
    }

// The same, for a variant that has ALREADY been resolved -- `Shade.
// Light` names its enum outright, so there is nothing left to look up
// and nothing that could look it up differently.
let infer_variant_ref_v (p2: Program2) (state: FreshState) (acc: Subst) (tag: String) (v: VariantLookup): InferResult = {
    check_enum_named(p2.ctx, p2.current, v.enum_name);
    let fr = fresh_list(state, v.enum_generics.len());
    let payload = Array.map(v.payload, |t| instantiate_template(v.enum_generics, fr.tys, t));
    if Array.is_empty(payload) { infer_variant_v(p2, state, acc, tag, [], [], v) }
    else {
        let names = partial_param_names(payload.len(), 0, []);
        let ret_ty = ITEnum(v.enum_name, fr.tys);
        let fn_ty = ITFunction(payload, ret_ty);
        InferResult {
            ty: fn_ty, subst: acc, state: fr.state,
            texpr: TExpr { ty: fn_ty, node: TClosure(names, TExpr { ty: ret_ty, node: TVariantNew(v.enum_name, tag, partial_param_refs(names, payload, 0, [])) }) },
        }
    }
}

let infer_variant (p2: Program2) (state: FreshState) (acc: Subst) (tag: String) (arg_tys: Array[ITy]) (arg_texprs: Array[TExpr]): InferResult =
    match resolve_variant(p2, tag) {
        Some(v) => infer_variant_v(p2, state, acc, tag, arg_tys, arg_texprs, v),
        None => { fail_tc(unbound_message(tag)); ir_unsupported(acc, state, "unbound variant ".concat(tag)) },
    }

let infer_variant_v (p2: Program2) (state: FreshState) (acc: Subst) (tag: String) (arg_tys: Array[ITy]) (arg_texprs: Array[TExpr]) (v: VariantLookup): InferResult = {
    check_enum_named(p2.ctx, p2.current, v.enum_name);
    let fr = fresh_list(state, v.enum_generics.len());
    let payload = Array.map(v.payload, |t| instantiate_template(v.enum_generics, fr.tys, t));
    let subst2 = unify_variant_args(payload, arg_tys, acc);
    ir_leaf(ITEnum(v.enum_name, fr.tys), subst2, fr.state, TVariantNew(v.enum_name, tag, arg_texprs))
}

let unify_variant_args (payload: Array[ITy]) (args: Array[ITy]) (acc: Subst): Subst =
    if payload.len() != args.len() { { fail_tc("variant expects a different number of arguments"); acc } }
    else { unify_variant_args_acc(payload, args, 0, acc) }

let unify_variant_args_acc (payload: Array[ITy]) (args: Array[ITy]) (i: Int) (acc: Subst): Subst =
    if i >= payload.len() { acc }
    else {
        match unify(subst_apply(acc, payload[i]), subst_apply(acc, args[i])) {
            Ok(s) => unify_variant_args_acc(payload, args, i + 1, subst_compose(s, acc)),
            Err(e) => { fail_tc(e); acc },
        }
    }

// A local binding (param/`let`) holding a closure-typed value is
// checked FIRST, mirroring `interp/interp.plum`'s own `eval_call`
// ordering exactly (same reasoning: a local shadowing a top-level
// name of the same name must call the LOCAL one) — everything else
// (`println`/contracts/top-level functions/variant construction) only
// applies once `name` isn't bound locally at all. Any callee shape
// besides a bare name or `.field`/`.method()` (an immediately-invoked
// closure literal, a closure produced by a call/`if`/`match`) falls to
// the general case: infer it normally and expect an `ITFunction`.
// `channel[T]()` -- recognised by SHAPE, exactly as the real compiler
// recognises it (`Infer`'s own `Call` arm matches a `GenericInst`
// callee named `channel` with one type argument and no value
// arguments). It is the one place explicit type arguments mean
// anything in either compiler.
let channel_elem_ty (p2: Program2) (callee: parser.PExpr) (args: Array[parser.PExpr]): Option[ITy] =
    if !Array.is_empty(args) { None }
    else {
        match callee {
            EGenericInst(inner, targs) =>
                if targs.len() == 1 {
                    match inner {
                        EIdent(nm, _) => if nm == "channel" { Some(resolve_ann(p2.ctx, [], targs[0])) } else { None },
                        _ => None,
                    }
                } else { None },
            _ => None,
        }
    }

let infer_call (p2: Program2) (state: FreshState) (env: TyEnv) (acc: Subst) (callee: parser.PExpr) (args: Array[parser.PExpr]): InferResult =
    match channel_elem_ty(p2, callee, args) {
        Some(elem) => ir_leaf(ITTuple([ITStruct("Sender", [elem]), ITStruct("Receiver", [elem])]), acc, state, TChannelNew),
        None => infer_call_shapes(p2, state, env, acc, callee, args),
    }

let infer_call_shapes (p2: Program2) (state: FreshState) (env: TyEnv) (acc: Subst) (callee: parser.PExpr) (args: Array[parser.PExpr]): InferResult =
    match callee {
        EIdent(name, _) => match tyenv_lookup(env, name) {
            // Same resolve-at-lookup rule as `infer_ident` above.
            Some(b) => { let ty = subst_apply(acc, b.ty); infer_closure_call(p2, state, env, acc, ty, args, TExpr { ty: ty, node: TIdent(name) }) },
            None => infer_named_call(p2, state, env, acc, name, args),
        },
        // `Array.map`/`filter`/`fold` — a NAMESPACE call ("Array" is
        // never a bound value), checked the same way `interp/interp.
        // plum`'s own `eval_call` checks it, for the same reason.
        // `Ns.func(..)` — a NAMESPACE call ("Array"/"Option"/"Result"/
        // "String" are never bound values), checked before `base` is
        // evaluated as an expression for the same reason `interp/interp.
        // plum`'s `eval_call` does it: evaluating a capitalized unbound
        // name would otherwise "succeed" as a bogus zero-payload variant
        // construction instead of failing.
        EField(base, method_name) => match base {
            EIdent(ns, _) => {
                if ns == "Array" && (method_name == "map" || method_name == "filter" || method_name == "fold") {
                    infer_array_ns_call(p2, state, env, acc, method_name, args)
                } else if Option.is_some(tyenv_lookup(env, ns)) || Option.is_some(find_global_def(p2, ns)) {
                    // `ns` names a real VALUE, so this is an ordinary
                    // method/struct-field call on it — checked BEFORE the
                    // module and builtin cases so a local can never be
                    // shadowed by a module or prelude name.
                    infer_method_call(p2, state, env, acc, base, method_name, args)
                } else {
                    // An ASSOCIATED function declared in source (`let
                    // Array.reverse[T] (..)`) is checked before the
                    // builtin of the same name, matching the shadowing
                    // order everywhere else here: a real declaration
                    // wins over a prelude signature, because in the
                    // real compiler the prelude IS a declaration and a
                    // later one shadows it. Without this, prelude
                    // source could declare `Array.reverse` and no call
                    // site could reach it — the qualified name was only
                    // ever looked up in `builtin_sig`.
                    // An associated function declared in source
                    // (`let Array.reverse[T] (..)`), looked up by its
                    // qualified name in the current module then the
                    // root.
                    match find_sig(p2, ns.concat(".").concat(method_name)) {
                        Some(sig) => infer_fn_call(p2, state, env, acc, sig, args),
                        None => match builtin_sig(ns.concat(".").concat(method_name)) {
                            Some(sig) => infer_fn_call(p2, state, env, acc, sig, args),
                            // A MODULE-qualified call (`lexer.tokenize(src)`).
                            // `main.plum` merges every module's items into one
                            // program, so the callee is just an ordinary
                            // top-level signature by this point — the
                            // qualifier carries no additional meaning, exactly
                            // as `resolve_named` already treats a qualified
                            // TYPE path by its last segment. Reached only when
                            // `ns` isn't a bound value and isn't a builtin
                            // namespace, so it can't capture a genuine
                            // record-of-closures field call.
                            // A MODULE-qualified call, `lexer.tokenize(src)`:
                            // resolved IN module `ns`, not by ignoring the
                            // qualifier. Before modules existed this looked
                            // the bare name up in one flat table, so
                            // `lexer.tokenize` and `parser.tokenize` were
                            // the same function.
                            None => match find_sig_in(p2.sigs, ns, method_name, 0) {
                                Some(sig) => { check_visible(p2, sig, ns, method_name); infer_fn_call(p2, state, env, acc, sig, args) },
                                // `Shade.Light(x)` -- a payload variant
                                // said with its enum. After the function
                                // lookups, so a declared `Ns.name` still
                                // wins, and before the method fallback,
                                // whose error would name the wrong thing.
                                None => match qualified_variant(p2, env, base, method_name) {
                                    Some(v) => {
                                        let ar = infer_list(p2, state, env, acc, args, 0, [], []);
                                        infer_variant_v(p2, ar.state, ar.subst, method_name, ar.tys, ar.texprs, v)
                                    },
                                    None => infer_method_call(p2, state, env, acc, base, method_name, args),
                                },
                            },
                        } }
                }
            },
            _ => infer_method_call(p2, state, env, acc, base, method_name, args),
        },
        _ => {
            let r = infer_expr(p2, state, env, acc, callee);
            infer_closure_call(p2, r.state, env, r.subst, subst_apply(r.subst, r.ty), args, r.texpr)
        },
    }

let infer_array_ns_call (p2: Program2) (state: FreshState) (env: TyEnv) (acc: Subst) (fn_name: String) (args: Array[parser.PExpr]): InferResult =
    if fn_name == "map" { infer_array_map(p2, state, env, acc, args[0], args[1]) }
    else if fn_name == "filter" { infer_array_filter(p2, state, env, acc, args[0], args[1]) }
    else if fn_name == "fold" { infer_array_fold(p2, state, env, acc, args[0], args[1], args[2]) }
    else { { fail_tc("unsupported Array.".concat(fn_name).concat("(...) call")); ir_unsupported(acc, state, "Array.".concat(fn_name)) } }

// Infers a closure argument with its parameter types ALREADY KNOWN,
// instead of letting them start as fresh variables the body is checked
// against. This is the "closure-param-type-seeding" the real compiler
// also needs (see DESIGN.md's language-ergonomics chunk, where the same
// inference-ordering bug was found and fixed there twice).
//
// Why it's load-bearing: `Array.filter(self_s.entries, |e| ..e.id..)`
// (real code, `typecheck/types.plum`) infers the closure BODY before
// unifying the closure against `(ElemTy) -> Bool`, so without seeding,
// `e` is still an unresolved variable at `e.id` and field access fails
// with "requires a struct value with a statically known type". Field
// access genuinely cannot be deferred — it needs a concrete struct to
// look the field up in — so the param type has to arrive first.
//
// Only a closure LITERAL can be seeded; anything else (a bare function
// reference, a variable holding a closure) is inferred normally and
// then unified by the caller exactly as before.
let infer_closure_seeded (p2: Program2) (state: FreshState) (env: TyEnv) (acc: Subst) (f_expr: parser.PExpr) (param_tys: Array[ITy]): InferResult =
    match f_expr {
        EClosure(params, body) => {
            if params.len() != param_tys.len() {
                fail_tc("closure expects a different number of parameters here")
            };
            let env2 = extend_closure_params(env, params, param_tys, 0);
            let r = infer_expr(p2, state, env2, acc, body);
            let fn_ty = ITFunction(Array.map(param_tys, |t| subst_apply(r.subst, t)), subst_apply(r.subst, r.ty));
            InferResult { ty: fn_ty, subst: r.subst, state: r.state, texpr: TExpr { ty: fn_ty, node: TClosure(params, r.texpr) } }
        },
        _ => infer_expr(p2, state, env, acc, f_expr),
    }

let infer_array_map (p2: Program2) (state: FreshState) (env: TyEnv) (acc: Subst) (arr_expr: parser.PExpr) (f_expr: parser.PExpr): InferResult = {
    let ar = infer_expr(p2, state, env, acc, arr_expr);
    let elem_fresh = fresh(ar.state);
    let s1 = match unify(subst_apply(ar.subst, ar.ty), ITStruct("Array", [elem_fresh.ty])) { Ok(s) => subst_compose(s, ar.subst), Err(e) => { fail_tc("Array.map: ".concat(e)); ar.subst } };
    let fr = infer_closure_seeded(p2, elem_fresh.state, env, s1, f_expr, [subst_apply(s1, elem_fresh.ty)]);
    let out_fresh = fresh(fr.state);
    let s2 = match unify(subst_apply(fr.subst, fr.ty), ITFunction([subst_apply(s1, elem_fresh.ty)], out_fresh.ty)) { Ok(s) => subst_compose(s, fr.subst), Err(e) => { fail_tc("Array.map function argument: ".concat(e)); fr.subst } };
    ir_leaf(ITStruct("Array", [subst_apply(s2, out_fresh.ty)]), s2, out_fresh.state, TArrayNs("map", [ar.texpr, fr.texpr]))
}

let infer_array_filter (p2: Program2) (state: FreshState) (env: TyEnv) (acc: Subst) (arr_expr: parser.PExpr) (f_expr: parser.PExpr): InferResult = {
    let ar = infer_expr(p2, state, env, acc, arr_expr);
    let elem_fresh = fresh(ar.state);
    let s1 = match unify(subst_apply(ar.subst, ar.ty), ITStruct("Array", [elem_fresh.ty])) { Ok(s) => subst_compose(s, ar.subst), Err(e) => { fail_tc("Array.filter: ".concat(e)); ar.subst } };
    let fr = infer_closure_seeded(p2, elem_fresh.state, env, s1, f_expr, [subst_apply(s1, elem_fresh.ty)]);
    let s2 = match unify(subst_apply(fr.subst, fr.ty), ITFunction([subst_apply(s1, elem_fresh.ty)], ITBool)) { Ok(s) => subst_compose(s, fr.subst), Err(e) => { fail_tc("Array.filter function argument: ".concat(e)); fr.subst } };
    ir_leaf(ITStruct("Array", [subst_apply(s2, elem_fresh.ty)]), s2, fr.state, TArrayNs("filter", [ar.texpr, fr.texpr]))
}

let infer_array_fold (p2: Program2) (state: FreshState) (env: TyEnv) (acc: Subst) (arr_expr: parser.PExpr) (init_expr: parser.PExpr) (f_expr: parser.PExpr): InferResult = {
    let ar = infer_expr(p2, state, env, acc, arr_expr);
    let elem_fresh = fresh(ar.state);
    let s1 = match unify(subst_apply(ar.subst, ar.ty), ITStruct("Array", [elem_fresh.ty])) { Ok(s) => subst_compose(s, ar.subst), Err(e) => { fail_tc("Array.fold: ".concat(e)); ar.subst } };
    let ir = infer_expr(p2, elem_fresh.state, env, s1, init_expr);
    let fr = infer_closure_seeded(p2, ir.state, env, ir.subst, f_expr, [subst_apply(ir.subst, ir.ty), subst_apply(ir.subst, elem_fresh.ty)]);
    let acc_ty = subst_apply(fr.subst, ir.ty);
    let elem_ty = subst_apply(fr.subst, elem_fresh.ty);
    let s2 = match unify(subst_apply(fr.subst, fr.ty), ITFunction([acc_ty, elem_ty], acc_ty)) { Ok(s) => subst_compose(s, fr.subst), Err(e) => { fail_tc("Array.fold function argument: ".concat(e)); fr.subst } };
    ir_leaf(subst_apply(s2, acc_ty), s2, fr.state, TArrayNs("fold", [ar.texpr, ir.texpr, fr.texpr]))
}

// Unifies `fn_ty` against a freshly-built `ITFunction(<one fresh var
// per arg>, <fresh return var>)`, then checks each argument against
// the (now hopefully concrete) param types — the closure-calling
// counterpart to `infer_fn_call`'s named-function version just below,
// which instead already knows its param types up front from a real
// declared signature.
// `callee_texpr` is the already-typed callee — a local holding a
// closure, or a struct field read. It becomes the `TClosureCall`'s own
// callee, which is how the backend knows to load a code pointer rather
// than emit a direct call.
// Under-applying a closure VALUE, not just a named function:
// `clamp3(0)(10)` leaves one parameter, and the first `(0)` already
// produced a closure -- so the residual has to be built here too, or
// currying would work only for the FIRST application in a chain. Same
// shape as `infer_partial_call`, with a `TClosureCall` body: the callee
// is a value, so there is no symbol to name.
let infer_partial_closure_call (p2: Program2) (state: FreshState) (env: TyEnv) (acc: Subst) (ptys: Array[ITy]) (ret: ITy) (args: Array[parser.PExpr]) (callee_texpr: TExpr): InferResult = {
    let supplied = Array.slice(ptys, 0, args.len());
    let residual = Array.slice(ptys, args.len(), ptys.len());
    let ar = infer_call_args(p2, state, env, acc, args, supplied, 0, []);
    let names = partial_param_names(residual.len(), 0, []);
    let res_tys = Array.map(residual, |t| subst_apply(ar.subst, t));
    let ret_ty = subst_apply(ar.subst, ret);
    let fn_ty = ITFunction(res_tys, ret_ty);
    let body_args = Array.concat(ar.texprs, partial_param_refs(names, res_tys, 0, []));
    InferResult {
        ty: fn_ty, subst: ar.subst, state: ar.state,
        texpr: TExpr { ty: fn_ty, node: TClosure(names, TExpr { ty: ret_ty, node: TClosureCall(callee_texpr, body_args) }) },
    }
}

let infer_closure_call (p2: Program2) (state: FreshState) (env: TyEnv) (acc: Subst) (fn_ty: ITy) (args: Array[parser.PExpr]) (callee_texpr: TExpr): InferResult = {
    match subst_apply(acc, fn_ty) {
        ITFunction(ptys, ret) =>
            if !Array.is_empty(args) && args.len() < ptys.len() {
                infer_partial_closure_call(p2, state, env, acc, ptys, ret, args, callee_texpr)
            } else { infer_closure_call_exact(p2, state, env, acc, fn_ty, args, callee_texpr) },
        _ => infer_closure_call_exact(p2, state, env, acc, fn_ty, args, callee_texpr),
    }
}

let infer_closure_call_exact (p2: Program2) (state: FreshState) (env: TyEnv) (acc: Subst) (fn_ty: ITy) (args: Array[parser.PExpr]) (callee_texpr: TExpr): InferResult = {
    let fr = fresh_list(state, args.len());
    let retf = fresh(fr.state);
    let s1 = match unify(subst_apply(acc, fn_ty), ITFunction(fr.tys, retf.ty)) { Ok(s) => subst_compose(s, acc), Err(e) => { fail_tc("call: ".concat(e)); acc } };
    let ar = infer_call_args(p2, retf.state, env, s1, args, Array.map(fr.tys, |t| subst_apply(s1, t)), 0, []);
    ir_leaf(subst_apply(ar.subst, retf.ty), ar.subst, ar.state, TClosureCall(callee_texpr, ar.texprs))
}

// The namespace a type owns its methods under. `x.f(a)` means
// `T.f(x, a)` where `T` is what this returns for `x`'s type -- see
// DESIGN.md's "Method calls are namespaced functions".
//
// `ITStruct`/`ITEnum` carry their own names, which is what makes this
// work for `Array` (an `ITStruct` named "Array"), for `Option` and
// `Result`, and for anything a user declares, with no list to keep.
// Everything else -- a type variable, a function, a tuple, `Unit` --
// has no name to put before the dot and therefore no methods.
let ity_namespace (t: ITy): Option[String] =
    match t {
        ITStr => Some("String"),
        ITInt => Some("Int"),
        ITFloat => Some("Float"),
        ITBool => Some("Bool"),
        // The BARE name: an associated function is declared
        // `let Circle.area (..)`, so the namespace is the type name as
        // written, not the qualified identity the checker carries.
        ITStruct(name, _) => Some(parser.bare_type_name(name)),
        ITEnum(name, _) => Some(parser.bare_type_name(name)),
        _ => None,
    }

// Both halves of why a method call failed, because either alone sends
// the reader looking in the wrong place: "no method `trim_end`" invites
// a search for a method list that does not exist, and "no function
// `String.trim_end`" hides that built-in methods are a separate thing.
let no_method_message (base_ty: ITy) (method_name: String): String =
    match ity_namespace(base_ty) {
        Some(ns) => "no method `".concat(method_name).concat("` on ").concat(ns)
            .concat(": it is not a built-in method, and no function named `")
            .concat(ns).concat(".").concat(method_name).concat("` is in scope"),
        None => "no method `".concat(method_name)
            .concat("` here: only a named type -- String, Int, Float, Bool, an array, a struct or an enum -- can have methods"),
    }

// `x.f(a)` as `T.f(x, a)`, reached only after the built-in methods and
// the struct-field lookup have both declined.
//
// The receiver is prepended to the arguments and the whole thing goes
// through `infer_fn_call`, the SAME path an ordinary `String.trim_end(s)`
// call takes. That is the point: this is sugar, not a second calling
// convention, so arity errors, generic instantiation and argument
// unification are all whatever they already were.
let infer_namespaced_method (p2: Program2) (state: FreshState) (env: TyEnv) (acc: Subst) (base_ty: ITy) (base: parser.PExpr) (method_name: String) (args: Array[parser.PExpr]): InferResult =
    match ity_namespace(base_ty) {
        None => { fail_tc(no_method_message(base_ty, method_name)); ir_unsupported(acc, state, "unsupported method call") },
        Some(ns) => {
            let qualified = ns.concat(".").concat(method_name);
            match find_sig(p2, qualified) {
                Some(sig) => infer_fn_call(p2, state, env, acc, sig, Array.concat([base], args)),
                // A declaration wins over a builtin of the same name,
                // the shadowing order used everywhere else here.
                None => match builtin_sig(qualified) {
                    Some(sig) => infer_fn_call(p2, state, env, acc, sig, Array.concat([base], args)),
                    // `Array.map`/`filter`/`fold` have no `FnSig` to
                    // find at all: their types depend on the closure
                    // they are handed, so they are checked by hand.
                    // The method form goes through the SAME dispatch
                    // `Array.map(xs, f)` already uses rather than
                    // getting a second implementation.
                    None => if ns == "Array" && (method_name == "map" || method_name == "filter" || method_name == "fold") {
                        infer_array_ns_call(p2, state, env, acc, method_name, Array.concat([base], args))
                    } else {
                        fail_tc(no_method_message(base_ty, method_name));
                        ir_unsupported(acc, state, "unsupported method call")
                    },
                },
            }
        },
    }

let infer_named_call (p2: Program2) (state: FreshState) (env: TyEnv) (acc: Subst) (name: String) (args: Array[parser.PExpr]): InferResult =
    if name == "println" { infer_println_call(p2, state, env, acc, args) }
    else {
        match find_sig(p2, name) {
            Some(sig) => infer_fn_call(p2, state, env, acc, sig, args),
            // A user-declared function wins over a builtin of the same
            // name — same shadowing order the real compiler uses, where
            // the prelude is prepended and a later declaration takes
            // precedence.
            None => match builtin_sig(name) {
                Some(sig) => infer_fn_call(p2, state, env, acc, sig, args),
                // `ref(v)` is checked HERE, alongside the other
                // builtins and after `find_sig`, so a user-declared
                // `ref` still shadows it — the same precedence every
                // other builtin gets. It can't go in `builtin_sig`
                // because its result type depends on its argument's.
                None => if name == "ref" && args.len() == 1 {
                    let r = infer_expr(p2, state, env, acc, args[0]);
                    ir_leaf(ITRef(subst_apply(r.subst, r.ty)), r.subst, r.state, TRefNew(r.texpr))
                } else {
                    let ar = infer_list(p2, state, env, acc, args, 0, [], []);
                    if is_capitalized_name(name) { infer_variant(p2, ar.state, ar.subst, name, ar.tys, ar.texprs) }
                    else { { fail_tc("unbound function: ".concat(name)); ir_unsupported(ar.subst, ar.state, "unbound function ".concat(name)) } }
                },
            },
        }
    }

let infer_println_call (p2: Program2) (state: FreshState) (env: TyEnv) (acc: Subst) (args: Array[parser.PExpr]): InferResult = {
    let r = infer_expr(p2, state, env, acc, args[0]);
    ir_leaf(ITUnit, r.subst, r.state, TPrintln(r.texpr))
}

// Instantiates `sig`'s own declared generics as fresh vars (a no-op
// substitution walk when `sig.generics` is empty — an ordinary
// monomorphic call), unifies each argument against the corresponding
// (possibly still-generic) param type, and returns the substituted
// return type — mirrors the real compiler's `instantiate_generic` +
// per-argument unification exactly, minus bound-checking (`Num`/`Eq`/
// `Show` — this checker's own stated v1 scope cut, "no bounds").
// `scale(2)` where `scale` takes two parameters: an under-applied call
// is a function value over the REMAINING parameters, not an arity
// error. `f(a)(b)` and `f(a, b)` then mean the same thing, which is the
// well-known ML property and, per DESIGN.md's "Currying" section, a
// resolution of Plum's old juxtaposition footgun rather than a new one.
//
// Nothing downstream needed a new concept. The residual value IS a
// closure -- over synthetic parameters, with a fully-applied call as
// its body -- so this builds an ordinary `TClosure` and the backend
// compiles it the way it compiles any other closure literal. That
// mirrors the real compiler, which rewrites the same shape in LOWERING
// (`plum_ir::lower` consults `partial_calls`); this checker can do it
// directly, because it emits a typed tree rather than recording a
// span-keyed note for a later pass to act on.
//
// `args.is_empty()` deliberately never takes this path: `f()` on a
// multi-parameter `f` stays an arity error, never a vacuous "give me
// `f` back" -- the same scope decision the real compiler made.
//
// The supplied argument EXPRESSIONS end up inside the closure body, so
// they are re-evaluated per call of the residual rather than once at
// partial-application time. That matches the real compiler's own
// rewrite exactly, and Plum expressions of this kind are pure, so the
// two are observationally identical.
let infer_partial_call (p2: Program2) (state: FreshState) (env: TyEnv) (acc: Subst) (sig: FnSig) (args: Array[parser.PExpr]): InferResult = {
    let fr = fresh_list(state, sig.generics.len());
    let inst_params = Array.map(sig.params, |t| instantiate_template(sig.generics, fr.tys, t));
    let inst_ret = instantiate_template(sig.generics, fr.tys, sig.ret);
    let supplied = Array.slice(inst_params, 0, args.len());
    let residual = Array.slice(inst_params, args.len(), inst_params.len());
    let ar = infer_call_args(p2, fr.state, env, acc, args, supplied, 0, []);
    let names = partial_param_names(residual.len(), 0, []);
    let res_tys = Array.map(residual, |t| subst_apply(ar.subst, t));
    let ret_ty = subst_apply(ar.subst, inst_ret);
    let fn_ty = ITFunction(res_tys, ret_ty);
    let body_args = Array.concat(ar.texprs, partial_param_refs(names, res_tys, 0, []));
    InferResult {
        ty: fn_ty, subst: ar.subst, state: ar.state,
        texpr: TExpr { ty: fn_ty, node: TClosure(names, TExpr { ty: ret_ty, node: TFnCall(sig.module, sig.name, body_args, fr.tys) }) },
    }
}

// `__partial_arg0`, `__partial_arg1`, ... -- double-underscored for the
// same reason every other compiler-synthesized name is: a user cannot
// write one, so these can never shadow anything real.
let partial_param_names (count: Int) (i: Int) (acc: Array[String]): Array[String] =
    if i >= count { acc } else { partial_param_names(count, i + 1, acc.push("__partial_arg".concat(i.to_string()))) }

let partial_param_refs (names: Array[String]) (tys: Array[ITy]) (i: Int) (acc: Array[TExpr]): Array[TExpr] =
    if i >= names.len() { acc }
    else { partial_param_refs(names, tys, i + 1, acc.push(TExpr { ty: tys[i], node: TIdent(names[i]) })) }

let infer_fn_call (p2: Program2) (state: FreshState) (env: TyEnv) (acc: Subst) (sig: FnSig) (args: Array[parser.PExpr]): InferResult = {
    if sig.is_extern {
        // No currying for an extern: there is no closure to build over
        // its remaining parameters, and a partial application would have
        // nothing to compile to.
        if sig.params.len() != args.len() {
            fail_tc("call to extern ".concat(sig.name).concat(": expected ").concat(sig.params.len().to_string()).concat(" argument(s), found ").concat(args.len().to_string()))
        };
        if !UNSAFE.get() {
            fail_tc("calling extern function '".concat(sig.name).concat("' requires an 'unsafe' block"))
        };
        let ar = infer_call_args(p2, state, env, acc, args, sig.params, 0, []);
        ir_leaf(sig.ret, ar.subst, ar.state, TExternCall(sig.name, ar.texprs))
    } else if Array.is_empty(args) && sig.params.len() == 1 && is_unit_ty(sig.params[0]) {
        // `f()` where `f` was declared `let f (): T`. That declaration
        // has ONE parameter -- the empty-tuple pattern -- so the call
        // needs one argument, and the real compiler synthesizes it
        // (`Infer::unit_sugar_calls`). Without this, every such call has
        // to be written `f(())`, which is what this compiler's own
        // source does throughout and why the gap went unnoticed until a
        // program written for the real compiler came through.
        //
        // Deliberately narrow: exactly one parameter, exactly `Unit`,
        // exactly zero arguments. A no-argument call to a multi-param
        // function stays the arity error that partial application
        // deliberately does not swallow.
        ir_leaf(sig.ret, acc, state, TFnCall(sig.module, sig.name, [TExpr { ty: ITUnit, node: TUnitLit }], []))
    } else {
        if !Array.is_empty(args) && args.len() < sig.params.len() {
            infer_partial_call(p2, state, env, acc, sig, args)
        } else {
            if sig.params.len() != args.len() { fail_tc("call to ".concat(sig.name).concat(": expected ").concat(sig.params.len().to_string()).concat(" argument(s), found ").concat(args.len().to_string())) };
            let fr = fresh_list(state, sig.generics.len());
            let inst_params = Array.map(sig.params, |t| instantiate_template(sig.generics, fr.tys, t));
            let inst_ret = instantiate_template(sig.generics, fr.tys, sig.ret);
            let ar = infer_call_args(p2, fr.state, env, acc, args, inst_params, 0, []);
            ir_leaf(subst_apply(ar.subst, inst_ret), ar.subst, ar.state, TFnCall(sig.module, sig.name, ar.texprs, fr.tys))
        }
    }
}

struct CallArgsResult { subst: Subst, state: FreshState, texprs: Array[TExpr] }
let infer_call_args (p2: Program2) (state: FreshState) (env: TyEnv) (acc: Subst) (args: Array[parser.PExpr]) (param_tys: Array[ITy]) (i: Int) (texprs: Array[TExpr]): CallArgsResult =
    if i >= args.len() || i >= param_tys.len() { CallArgsResult { subst: acc, state: state, texprs: texprs } }
    else {
        // A CLOSURE argument is inferred against the parameter type it
        // is about to be checked against, not in isolation. Inferring
        // it in isolation gives its parameters disconnected fresh
        // variables, and the body is checked BEFORE the unification
        // just below could ever resolve them -- so `Array.find(xs, |it|
        // it.price > 0)` failed with "field access requires a struct
        // value with a statically known type, found T1" even though
        // `xs: Array[Item]` had already pinned the element type one
        // argument earlier.
        //
        // `infer_closure_seeded` already existed for exactly this
        // reason, but only `Array.map`/`filter`/`fold` used it. Same
        // generalization the real checker made, for the same reason:
        // ANY function taking a callback hit this, stdlib or
        // user-defined, and patching the three builtins individually
        // just hid it (see `plum_types::Infer::infer_call_with_callee`).
        let seeded = match subst_apply(acc, param_tys[i]) {
            ITFunction(ptys, _) => infer_closure_seeded(p2, state, env, acc, args[i], ptys),
            _ => infer_expr(p2, state, env, acc, args[i]),
        };
        let r = seeded;
        let s2 = match unify(subst_apply(r.subst, r.ty), subst_apply(r.subst, param_tys[i])) {
            Ok(s) => subst_compose(s, r.subst),
            Err(e) => { fail_tc("argument ".concat(i.to_string()).concat(": ").concat(e)); r.subst },
        };
        infer_call_args(p2, r.state, env, s2, args, param_tys, i + 1, texprs.push(r.texpr))
    }

let infer_method_call (p2: Program2) (state: FreshState) (env: TyEnv) (acc: Subst) (base: parser.PExpr) (method_name: String) (args: Array[parser.PExpr]): InferResult =
    if method_name == "to_string" {
        let r = infer_expr(p2, state, env, acc, base);
        ir_leaf(ITStr, r.subst, r.state, TMethodCall("to_string", r.texpr, []))
    } else if method_name == "concat" {
        let br = infer_expr(p2, state, env, acc, base);
        let s1 = match unify(subst_apply(br.subst, br.ty), ITStr) { Ok(s) => subst_compose(s, br.subst), Err(e) => { fail_tc(".concat() receiver: ".concat(e)); br.subst } };
        let ar = infer_expr(p2, br.state, env, s1, args[0]);
        let s2 = match unify(subst_apply(ar.subst, ar.ty), ITStr) { Ok(s) => subst_compose(s, ar.subst), Err(e) => { fail_tc(".concat() argument: ".concat(e)); ar.subst } };
        ir_leaf(ITStr, s2, ar.state, TMethodCall("concat", br.texpr, [ar.texpr]))
    } else if (method_name == "ends_with" || method_name == "starts_with" || method_name == "contains") && args.len() == 1 {
        // Compiler PRIMITIVES lowered straight to IR nodes (`StrEndsWith`
        // and friends), not prelude functions — so they have no entry in
        // `builtin_sig` and are recognised here, alongside the other
        // dot-methods, by name and arity.
        let br = infer_expr(p2, state, env, acc, base);
        let bt = subst_apply(br.subst, br.ty);
        // A receiver that is NOT a String falls through to the
        // namespaced rule rather than failing here. `contains` is the
        // case that forced this: it is a string primitive AND
        // `Array.contains` exists, so `xs.contains(2)` used to report
        // "Array[Int] != String" -- the built-in arm claiming a method
        // name for one type and denying it to every other.
        //
        // Built-in methods are matched on NAME before the receiver is
        // known, which is why this has to be checked per arm rather
        // than once. Every String-receiver primitive does the same.
        match unify(bt, ITStr) {
            Err(_) => infer_namespaced_method(p2, br.state, env, br.subst, bt, base, method_name, args),
            Ok(s0) => {
                let s1 = subst_compose(s0, br.subst);
                let ar = infer_expr(p2, br.state, env, s1, args[0]);
                let s2 = match unify(subst_apply(ar.subst, ar.ty), ITStr) { Ok(s) => subst_compose(s, ar.subst), Err(e) => { fail_tc(".".concat(method_name).concat("() argument: ").concat(e)); ar.subst } };
                ir_leaf(ITBool, s2, ar.state, TMethodCall(method_name, br.texpr, [ar.texpr]))
            },
        }
    } else if method_name == "split" && args.len() == 1 {
        // Another compiler primitive, same as `ends_with` above.
        let br = infer_expr(p2, state, env, acc, base);
        let s1 = match unify(subst_apply(br.subst, br.ty), ITStr) { Ok(s) => subst_compose(s, br.subst), Err(e) => { fail_tc(".split() receiver: ".concat(e)); br.subst } };
        let ar = infer_expr(p2, br.state, env, s1, args[0]);
        let s2 = match unify(subst_apply(ar.subst, ar.ty), ITStr) { Ok(s) => subst_compose(s, ar.subst), Err(e) => { fail_tc(".split() argument: ".concat(e)); ar.subst } };
        ir_leaf(arr_of(ITStr), s2, ar.state, TMethodCall("split", br.texpr, [ar.texpr]))
    } else if (method_name == "to_upper" || method_name == "to_lower" || method_name == "trim") && Array.is_empty(args) {
        // Str -> Str, no arguments. Compiler primitives like
        // `ends_with`/`split` above, recognised by name and arity.
        let br = infer_expr(p2, state, env, acc, base);
        let s1 = match unify(subst_apply(br.subst, br.ty), ITStr) { Ok(s) => subst_compose(s, br.subst), Err(e) => { fail_tc(".".concat(method_name).concat("() receiver: ").concat(e)); br.subst } };
        ir_leaf(ITStr, s1, br.state, TMethodCall(method_name, br.texpr, []))
    } else if method_name == "replace" && args.len() == 2 {
        // Str -> Str -> Str -> Str: haystack, needle, replacement.
        let br = infer_expr(p2, state, env, acc, base);
        let s1 = match unify(subst_apply(br.subst, br.ty), ITStr) { Ok(s) => subst_compose(s, br.subst), Err(e) => { fail_tc(".replace() receiver: ".concat(e)); br.subst } };
        let a1 = infer_expr(p2, br.state, env, s1, args[0]);
        let s2 = match unify(subst_apply(a1.subst, a1.ty), ITStr) { Ok(s) => subst_compose(s, a1.subst), Err(e) => { fail_tc(".replace() pattern: ".concat(e)); a1.subst } };
        let a2 = infer_expr(p2, a1.state, env, s2, args[1]);
        let s3 = match unify(subst_apply(a2.subst, a2.ty), ITStr) { Ok(s) => subst_compose(s, a2.subst), Err(e) => { fail_tc(".replace() replacement: ".concat(e)); a2.subst } };
        ir_leaf(ITStr, s3, a2.state, TMethodCall("replace", br.texpr, [a1.texpr, a2.texpr]))
    } else if method_name == "to_float" && Array.is_empty(args) {
        // `Int.to_float()` — a compiler primitive (`ir::Expr::ToFloat`),
        // like `ends_with`/`split` above, so it has no `builtin_sig`
        // entry and is recognised here by name and arity.
        let r = infer_expr(p2, state, env, acc, base);
        let s1 = match unify(subst_apply(r.subst, r.ty), ITInt) { Ok(s) => subst_compose(s, r.subst), Err(e) => { fail_tc(".to_float() receiver: ".concat(e)); r.subst } };
        ir_leaf(ITFloat, s1, r.state, TMethodCall("to_float", r.texpr, []))
    } else if method_name == "len" && Array.is_empty(args) {
        infer_len(p2, state, env, acc, base)
    } else if method_name == "send" && args.len() == 1 {
        let r = infer_expr(p2, state, env, acc, base);
        let ef = fresh(r.state);
        let s1 = match unify(subst_apply(r.subst, r.ty), ITStruct("Sender", [ef.ty])) {
            Ok(x) => subst_compose(x, r.subst),
            Err(e) => { fail_tc(".send() requires a Sender: ".concat(e)); r.subst },
        };
        let vr = infer_expr(p2, ef.state, env, s1, args[0]);
        let s2 = match unify(subst_apply(vr.subst, vr.ty), subst_apply(vr.subst, ef.ty)) {
            Ok(x) => subst_compose(x, vr.subst),
            Err(e) => { fail_tc(".send() value: ".concat(e)); vr.subst },
        };
        ir_leaf(ITUnit, s2, vr.state, TChannelSend(r.texpr, vr.texpr))
    } else if method_name == "recv" && Array.is_empty(args) {
        let r = infer_expr(p2, state, env, acc, base);
        let ef = fresh(r.state);
        let s1 = match unify(subst_apply(r.subst, r.ty), ITStruct("Receiver", [ef.ty])) {
            Ok(x) => subst_compose(x, r.subst),
            Err(e) => { fail_tc(".recv() requires a Receiver: ".concat(e)); r.subst },
        };
        ir_leaf(subst_apply(s1, ef.ty), s1, ef.state, TChannelRecv(r.texpr))
    } else if method_name == "join" && Array.is_empty(args) {
        // `t.join()` -- wait for the task and take its value. Recognised
        // by SHAPE, matching the real compiler's own precedent: a struct
        // with an unrelated zero-argument field called `join` would
        // collide, an accepted and documented narrowness there too.
        let r = infer_expr(p2, state, env, acc, base);
        let ef = fresh(r.state);
        let s1 = match unify(subst_apply(r.subst, r.ty), ITStruct("Task", [ef.ty])) {
            Ok(x) => subst_compose(x, r.subst),
            Err(e) => { fail_tc(".join() requires a Task: ".concat(e)); r.subst },
        };
        ir_leaf(subst_apply(s1, ef.ty), s1, ef.state, TTaskJoin(r.texpr))
    } else if method_name == "as_cstr" {
        // `s.as_cstr()` -- hand a Plum string's bytes to C. Validated at
        // this boundary rather than at the extern call, so a string with
        // an embedded NUL is caught where it is converted rather than
        // silently truncating inside the callee.
        let r = infer_expr(p2, state, env, acc, base);
        let s1 = match unify(subst_apply(r.subst, r.ty), ITStr) { Ok(x) => subst_compose(x, r.subst), Err(e) => { fail_tc(".as_cstr() requires a String: ".concat(e)); r.subst } };
        ir_leaf(ITCStr, s1, r.state, TAsCStr(r.texpr))
    } else if method_name == "as_string" {
        // The way back. Without it a `CStr` is a dead end -- exactly the
        // gap the real compiler found while wiring up TCP.
        let r = infer_expr(p2, state, env, acc, base);
        let s1 = match unify(subst_apply(r.subst, r.ty), ITCStr) { Ok(x) => subst_compose(x, r.subst), Err(e) => { fail_tc(".as_string() requires a CStr: ".concat(e)); r.subst } };
        ir_leaf(ITStr, s1, r.state, TAsString(r.texpr))
    } else if method_name == "remove" && args.len() == 1 {
        // `xs.remove(i)` -- a new array without element `i`. Arity is
        // what separates it from `Map.remove`/`Set.remove`, which are
        // ordinary declared functions reached through `find_sig` -- the
        // same split `.set` already uses to tell `Array.set(i, v)` from
        // `Ref.set(v)`.
        let br = infer_expr(p2, state, env, acc, base);
        let ef = fresh(br.state);
        let s1 = match unify(subst_apply(br.subst, br.ty), ITStruct("Array", [ef.ty])) {
            Ok(s) => subst_compose(s, br.subst),
            Err(e) => { fail_tc(".remove() requires an Array: ".concat(e)); br.subst },
        };
        let ir = infer_expr(p2, ef.state, env, s1, args[0]);
        let s2 = match unify(subst_apply(ir.subst, ir.ty), ITInt) {
            Ok(s) => subst_compose(s, ir.subst),
            Err(e) => { fail_tc(".remove() index: ".concat(e)); ir.subst },
        };
        ir_leaf(subst_apply(s2, ITStruct("Array", [ef.ty])), s2, ir.state, TMethodCall("remove", br.texpr, [ir.texpr]))
    } else if method_name == "push" && args.len() == 1 {
        infer_array_push(p2, state, env, acc, base, args[0])
    } else if method_name == "set" && args.len() == 2 {
        infer_array_set(p2, state, env, acc, base, args[0], args[1])
    } else if method_name == "get" && Array.is_empty(args) {
        // `r.get()` on a `Ref[T]` yields `T`. The receiver is unified
        // against `Ref[fresh]` rather than inspected, so it works even
        // when the receiver's type is not yet resolved.
        let r = infer_expr(p2, state, env, acc, base);
        let inner = fresh(r.state);
        let s1 = match unify(subst_apply(r.subst, r.ty), ITRef(inner.ty)) {
            Ok(s) => subst_compose(s, r.subst),
            Err(e) => { fail_tc(".get() receiver: ".concat(e)); r.subst },
        };
        ir_leaf(subst_apply(s1, inner.ty), s1, inner.state, TMethodCall("get", r.texpr, []))
    } else if method_name == "set" && args.len() == 1 {
        // `r.set(v)` on a `Ref[T]`. Distinguished from `Array.set`
        // above purely by ARITY -- the array form takes an index too.
        let r = infer_expr(p2, state, env, acc, base);
        let vr = infer_expr(p2, r.state, env, r.subst, args[0]);
        let s1 = match unify(subst_apply(vr.subst, r.ty), ITRef(subst_apply(vr.subst, vr.ty))) {
            Ok(s) => subst_compose(s, vr.subst),
            Err(e) => { fail_tc(".set() receiver: ".concat(e)); vr.subst },
        };
        ir_leaf(ITUnit, s1, vr.state, TMethodCall("set", r.texpr, [vr.texpr]))
    } else {
        // Struct-field closure call — the record-of-closures dispatch
        // pattern (`reader.read(x)`, DESIGN.md's "interfaces via
        // records of closures" story), the type-checking counterpart to
        // `interp/interp.plum`'s own identical `EField` fallback.
        let br = infer_expr(p2, state, env, acc, base);
        let base_ty = subst_apply(br.subst, br.ty);
        match base_ty {
            ITStruct(struct_name, gen_args) => match find_struct(p2.ctx, struct_name) {
                Some(info) => match find_field_template(info.fields, method_name) {
                    Some(field_ty) => {
                        let ft = instantiate_template(info.generics, gen_args, field_ty);
                        infer_closure_call(p2, br.state, env, br.subst, ft, args, TExpr { ty: ft, node: TFieldGet(br.texpr, method_name) })
                    },
                    // No such FIELD -- so try a namespaced function.
                    // The field is looked for first deliberately: a
                    // record of closures is a dispatch mechanism, and
                    // a `S.read` must not be able to shadow a `read`
                    // field. See DESIGN.md.
                    None => infer_namespaced_method(p2, br.state, env, br.subst, base_ty, base, method_name, args),
                },
                // Not a declared struct at all -- `Array` reaches here,
                // being an `ITStruct` the checker builds rather than
                // one anybody declared.
                None => infer_namespaced_method(p2, br.state, env, br.subst, base_ty, base, method_name, args),
            },
            _ => infer_namespaced_method(p2, br.state, env, br.subst, base_ty, base, method_name, args),
        }
    }

// `.len()`/`.push(v)`/`.set(i, v)` — arity-disambiguated (see `infer_
// method_call`'s own call site), mirroring `interp/interp.plum`'s own
// identically-named/-shaped runtime helpers exactly.
// `.len()` is OVERLOADED on the receiver: byte length for a `String`,
// element count for an `Array` — matching the real compiler's own
// lowering, which picks the IR node by the receiver's static type.
//
// This is the one place inference has to branch on an already-resolved
// type rather than unify against a single expected shape: `Str` and
// `Array[?]` have no common unifier, so committing to either up front
// would wrongly reject the other. The receiver is inferred FIRST, and
// only a receiver that resolves to exactly `Str` takes the string
// path; anything still unresolved falls through to the array path,
// which unifies as before. That means a `.len()` on a receiver whose
// type is not yet known is read as an ARRAY length — a real, narrow
// bias, chosen because it preserves every pre-existing array-`.len()`
// inference exactly, and because a genuinely unresolved receiver at
// this point can only come from an unannotated closure parameter.
let infer_len (p2: Program2) (state: FreshState) (env: TyEnv) (acc: Subst) (base: parser.PExpr): InferResult = {
    let br = infer_expr(p2, state, env, acc, base);
    match subst_apply(br.subst, br.ty) {
        ITStr => ir_leaf(ITInt, br.subst, br.state, TMethodCall("len", br.texpr, [])),
        _ => {
            let elem_fresh = fresh(br.state);
            let s1 = match unify(subst_apply(br.subst, br.ty), ITStruct("Array", [elem_fresh.ty])) { Ok(s) => subst_compose(s, br.subst), Err(e) => { fail_tc(".len(): ".concat(e)); br.subst } };
            ir_leaf(ITInt, s1, elem_fresh.state, TMethodCall("len", br.texpr, []))
        },
    }
}

let infer_array_push (p2: Program2) (state: FreshState) (env: TyEnv) (acc: Subst) (base: parser.PExpr) (value_expr: parser.PExpr): InferResult = {
    let br = infer_expr(p2, state, env, acc, base);
    let elem_fresh = fresh(br.state);
    let s1 = match unify(subst_apply(br.subst, br.ty), ITStruct("Array", [elem_fresh.ty])) { Ok(s) => subst_compose(s, br.subst), Err(e) => { fail_tc(".push(): ".concat(e)); br.subst } };
    let vr = infer_expr(p2, elem_fresh.state, env, s1, value_expr);
    let s2 = match unify(subst_apply(vr.subst, vr.ty), subst_apply(vr.subst, elem_fresh.ty)) { Ok(s) => subst_compose(s, vr.subst), Err(e) => { fail_tc(".push() argument: ".concat(e)); vr.subst } };
    ir_leaf(ITStruct("Array", [subst_apply(s2, elem_fresh.ty)]), s2, vr.state, TMethodCall("push", br.texpr, [vr.texpr]))
}

let infer_array_set (p2: Program2) (state: FreshState) (env: TyEnv) (acc: Subst) (base: parser.PExpr) (idx_expr: parser.PExpr) (value_expr: parser.PExpr): InferResult = {
    let br = infer_expr(p2, state, env, acc, base);
    let elem_fresh = fresh(br.state);
    let s1 = match unify(subst_apply(br.subst, br.ty), ITStruct("Array", [elem_fresh.ty])) { Ok(s) => subst_compose(s, br.subst), Err(e) => { fail_tc(".set(): ".concat(e)); br.subst } };
    let ir = infer_expr(p2, elem_fresh.state, env, s1, idx_expr);
    let s2 = match unify(subst_apply(ir.subst, ir.ty), ITInt) { Ok(s) => subst_compose(s, ir.subst), Err(e) => { fail_tc(".set() index: ".concat(e)); ir.subst } };
    let vr = infer_expr(p2, ir.state, env, s2, value_expr);
    let s3 = match unify(subst_apply(vr.subst, vr.ty), subst_apply(vr.subst, elem_fresh.ty)) { Ok(s) => subst_compose(s, vr.subst), Err(e) => { fail_tc(".set() value: ".concat(e)); vr.subst } };
    ir_leaf(ITStruct("Array", [subst_apply(s3, elem_fresh.ty)]), s3, vr.state, TMethodCall("set", br.texpr, [ir.texpr, vr.texpr]))
}

let infer_block (p2: Program2) (state: FreshState) (env: TyEnv) (acc: Subst) (block: parser.PBlock): InferResult = {
    let r = infer_stmts(p2, state, env, acc, block.stmts, 0, [], block.starts);
    match block.tail {
        Some(t) => {
            // The tail's own position is the last entry in `starts`.
            set_stmt_pos(block_start_at(block.starts, block.stmts.len()));
            let tr = infer_expr(p2, r.state, r.env, r.subst, t);
            ir_leaf(tr.ty, tr.subst, tr.state, TBlockE(TBlock { stmts: r.tstmts, tail: Some(tr.texpr) }))
        },
        None => ir_leaf(ITUnit, r.subst, r.state, TBlockE(TBlock { stmts: r.tstmts, tail: None })),
    }
}

struct StmtsResult { env: TyEnv, subst: Subst, state: FreshState, tstmts: Array[TStmt] }

// `starts` is `PBlock.starts` -- one offset per statement, plus a
// trailing one for the block's tail expression. Out-of-range reads
// answer -1 ("unknown"), so a block built without a source context
// behaves exactly as it did before positions existed.
let block_start_at (starts: Array[Int]) (i: Int): Int =
    if i >= starts.len() { 0 - 1 } else { starts[i] }

// The result of checking a `let` statement's annotation: the type the
// binding takes, and the substitution unifying it produced. A struct
// rather than a tuple because both halves are read by name below.
struct LetTy { ty: ITy, subst: Subst }

// The bound NAME, for the error message. A destructuring pattern has no
// single name, so it renders as its pattern -- which is what the reader
// wrote either way.
let render_pattern_name (p: parser.PPattern): String =
    match p {
        PIdent(name, _) => name,
        _ => parser.render_pattern(p),
    }

let infer_stmts (p2: Program2) (state: FreshState) (env: TyEnv) (acc: Subst) (stmts: Array[parser.PStmt]) (i: Int) (tstmts: Array[TStmt]) (starts: Array[Int]): StmtsResult =
    if i >= stmts.len() { StmtsResult { env: env, subst: acc, state: state, tstmts: tstmts } }
    else {
        set_stmt_pos(block_start_at(starts, i));
        match stmts[i] {
            // The ANNOTATION, when there is one, is unified against the
            // value's inferred type -- and the binding then takes the
            // unified type, so `let xs: Array[Int] = []` pins the
            // element type the way a reader expects.
            //
            // Until 2026-08-20 the annotation was discarded by the
            // parser and this arm could not have checked it: the
            // self-hosted compiler accepted `let a: Int = true`,
            // `let a: String = 1 + 2` and `let a: Array[Int] = "s"`
            // and compiled them, while the real compiler rejected
            // every one. Nothing caught it because nothing in this
            // repo -- corpus, examples, or the compiler's own 30,000
            // lines -- annotates a local.
            SLet(_, pattern, ann, value) => {
                let r = infer_expr(p2, state, env, acc, value);
                let vty = subst_apply(r.subst, r.ty);
                let checked = match ann {
                    None => LetTy { ty: vty, subst: r.subst },
                    Some(t) => {
                        let want = resolve_ann_seen(p2.ctx, p2.current, p2.generics, t);
                        match unify(vty, want) {
                            Ok(sub) => LetTy { ty: subst_apply(sub, want), subst: subst_compose(r.subst, sub) },
                            Err(e) => {
                                fail_tc("let ".concat(render_pattern_name(pattern)).concat(": declared type ").concat(render_ty(want)).concat(" doesn't match value type ").concat(render_ty(vty)).concat(" (").concat(e).concat(")"));
                                LetTy { ty: want, subst: r.subst }
                            },
                        }
                    },
                };
                let br = bind_pattern_ty(p2, r.state, checked.subst, env, pattern, checked.ty);
                infer_stmts(p2, br.state, br.env, br.subst, stmts, i + 1, tstmts.push(TSLet(br.pattern, r.texpr)), starts)
            },
            SAssign(name, value) => {
                let r = infer_expr(p2, state, env, acc, value);
                // `match`, NOT `Option.unwrap_or` — a real mistake
                // caught immediately by an actual test failure, not
                // spotted by inspection: `Option.unwrap_or`'s fallback
                // is an ordinary VALUE argument (unlike `unwrap_or_
                // else`'s closure), so Plum's strict, non-lazy
                // evaluation runs it UNCONDITIONALLY before the call
                // even happens — `fail_tc(...)` inside that fallback
                // position fired on every assignment, whether the name
                // was bound or not. `match` only evaluates the branch
                // actually taken.
                let target_ty = match tyenv_lookup(env, name) {
                    Some(b) => b.ty,
                    None => { fail_tc("assignment to an unbound name: ".concat(name)); ITUnit },
                };
                let s2 = match unify(subst_apply(r.subst, r.ty), subst_apply(r.subst, target_ty)) { Ok(s) => subst_compose(s, r.subst), Err(e) => { fail_tc("assignment to ".concat(name).concat(": ").concat(e)); r.subst } };
                infer_stmts(p2, r.state, env, s2, stmts, i + 1, tstmts.push(TSAssign(name, r.texpr)), starts)
            },
            SExpr(e) => { let r = infer_expr(p2, state, env, acc, e); infer_stmts(p2, r.state, env, r.subst, stmts, i + 1, tstmts.push(TSExpr(r.texpr)), starts) },
        }
    }

let infer_if (p2: Program2) (state: FreshState) (env: TyEnv) (acc: Subst) (cond: parser.PExpr) (then_branch: parser.PBlock) (else_branch: Option[parser.PExpr]): InferResult = {
    let cr = infer_expr(p2, state, env, acc, cond);
    let s1 = match unify(subst_apply(cr.subst, cr.ty), ITBool) { Ok(s) => subst_compose(s, cr.subst), Err(e) => { fail_tc("'if' condition: ".concat(e)); cr.subst } };
    let tr = infer_block(p2, cr.state, env, s1, then_branch);
    match else_branch {
        Some(e) => {
            let er = infer_expr(p2, tr.state, env, tr.subst, e);
            let s2 = match unify(subst_apply(er.subst, tr.ty), subst_apply(er.subst, er.ty)) { Ok(s) => subst_compose(s, er.subst), Err(err) => { fail_tc("'if'/'else' branches: ".concat(err)); er.subst } };
            ir_leaf(subst_apply(s2, tr.ty), s2, er.state, TIf(cr.texpr, tr.texpr, Some(er.texpr)))
        },
        None => ir_leaf(tr.ty, tr.subst, tr.state, TIf(cr.texpr, tr.texpr, None)),
    }
}

let infer_for (p2: Program2) (state: FreshState) (env: TyEnv) (acc: Subst) (pattern: parser.PPattern) (iter: parser.PExpr) (body: parser.PBlock): InferResult =
    match iter {
        EBinary(BRange, lo_e, hi_e) => {
            let lr = infer_expr(p2, state, env, acc, lo_e);
            let s1 = match unify(subst_apply(lr.subst, lr.ty), ITInt) { Ok(s) => subst_compose(s, lr.subst), Err(e) => { fail_tc("'for' range start: ".concat(e)); lr.subst } };
            let hr = infer_expr(p2, lr.state, env, s1, hi_e);
            let s2 = match unify(subst_apply(hr.subst, hr.ty), ITInt) { Ok(s) => subst_compose(s, hr.subst), Err(e) => { fail_tc("'for' range end: ".concat(e)); hr.subst } };
            let br = bind_pattern_ty(p2, hr.state, s2, env, pattern, ITInt);
            let bodyr = infer_block(p2, br.state, br.env, br.subst, body);
            ir_leaf(ITUnit, bodyr.subst, bodyr.state, TFor(br.pattern, lr.texpr, hr.texpr, bodyr.texpr))
        },
        // `for x in xs` over an array. The element type comes from
        // unifying the iterand against `Array[?]`, so a non-array
        // iterand reports a type error naming what it actually got
        // rather than the old blanket "only a literal range".
        _ => {
            let ir = infer_expr(p2, state, env, acc, iter);
            let ef = fresh(ir.state);
            let s1 = match unify(subst_apply(ir.subst, ir.ty), ITStruct("Array", [ef.ty])) {
                Ok(s) => subst_compose(s, ir.subst),
                Err(e) => { fail_tc("'for' iterand must be a range or an array: ".concat(e)); ir.subst },
            };
            let elem = subst_apply(s1, ef.ty);
            let br = bind_pattern_ty(p2, ef.state, s1, env, pattern, elem);
            let bodyr = infer_block(p2, br.state, br.env, br.subst, body);
            ir_leaf(ITUnit, bodyr.subst, bodyr.state, TForArray(br.pattern, ir.texpr, bodyr.texpr))
        },
    }

// `Game { ship.rotation: r, ..g }` -- the nested field-update sugar the
// parser records as a FieldInitNode with a non-empty `extra_path`.
// Expanded to what it means before anything else looks at it:
//
//     Game { ship: Ship { rotation: r, ..g.ship }, ..g }
//
// The expansion needs the INNER struct's name, which only the context
// knows, which is why this lives in the checker rather than in the
// parser (the real compiler's `plumc::nested_struct_update` runs after
// declarations are collected, for the same reason).
//
// A nested update with no `..base` cannot be expanded -- there would be
// nothing to copy the inner struct's other fields from -- and is left
// alone to fail as an ordinary "missing field" error.
let expand_nested_updates (p2: Program2) (info: StructInfo) (fields: Array[parser.FieldInitNode]) (spread: Option[parser.PExpr]): Array[parser.FieldInitNode] =
    match spread {
        None => fields,
        Some(base) => expand_nested_acc(p2, info, fields, base, 0, []),
    }

let expand_nested_acc (p2: Program2) (info: StructInfo) (fields: Array[parser.FieldInitNode]) (base: parser.PExpr) (i: Int) (acc: Array[parser.FieldInitNode]): Array[parser.FieldInitNode] =
    if i >= fields.len() { acc }
    else if Array.is_empty(fields[i].extra_path) { expand_nested_acc(p2, info, fields, base, i + 1, acc.push(fields[i])) }
    else {
        let outer = fields[i].name;
        check_field_visible(p2.ctx, p2.current, info.name, outer);
        let inner_name = match find_field_template(info.fields, outer) {
            Some(ITStruct(sn, _)) => sn,
            _ => { fail_tc("'".concat(outer).concat(".") .concat(fields[i].extra_path[0]).concat("' needs '").concat(outer).concat("' to be a struct")); "" },
        };
        // The inner literal updates ONE field of `base.outer`, spreading
        // the rest -- and recurses, so `a.b.c: v` nests twice.
        let inner_field = parser.FieldInitNode {
            name: fields[i].extra_path[0],
            extra_path: Array.slice(fields[i].extra_path, 1, fields[i].extra_path.len()),
            value: fields[i].value,
        };
        let inner = EStructLit([inner_name], [inner_field], Some(EField(base, outer)));
        expand_nested_acc(p2, info, fields, base, i + 1, acc.push(parser.FieldInitNode { name: outer, extra_path: [], value: inner }))
    }

let infer_struct_lit (p2: Program2) (state: FreshState) (env: TyEnv) (acc: Subst) (path: Array[String]) (fields0: Array[parser.FieldInitNode]) (spread: Option[parser.PExpr]): InferResult = {
    let name = path[path.len() - 1];
    check_struct_named(p2.ctx, p2.current, name);
    match best_struct(p2.ctx, p2.current, name) {
        Some(info) => {
            let fields = expand_nested_updates(p2, info, fields0, spread);
            let fr = fresh_list(state, info.generics.len());
            let r = infer_struct_fields(p2, fr.state, env, acc, info, fr.tys, fields, 0, []);
            let lit_ty = ITStruct(info.name, Array.map(fr.tys, |t| subst_apply(r.subst, t)));
            // The spread base must be the SAME struct type -- `Game {
            // ..point }` is a type error, not a partial copy.
            match spread {
                None => ir_leaf(lit_ty, r.subst, r.state, TStructLit(info.name, cg_zip_field_inits(fields, r.texprs, 0, []), None)),
                Some(base) => {
                    let br = infer_expr(p2, r.state, env, r.subst, base);
                    let s2 = match unify(subst_apply(br.subst, br.ty), subst_apply(br.subst, lit_ty)) {
                        Ok(x) => subst_compose(x, br.subst),
                        Err(e) => { fail_tc("struct-literal '..' base: ".concat(e)); br.subst },
                    };
                    ir_leaf(subst_apply(s2, lit_ty), s2, br.state, TStructLit(info.name, cg_zip_field_inits(fields, r.texprs, 0, []), Some(br.texpr)))
                },
            }
        },
        None => { fail_tc("unknown struct: ".concat(name)); ir_unsupported(acc, state, "unknown struct ".concat(name)) },
    }
}

// Pairs each field-init's NAME with its typed value, in the order the
// literal wrote them. The backend reorders to declaration order itself,
// using the struct's own declared field list.
let cg_zip_field_inits (fields: Array[parser.FieldInitNode]) (texprs: Array[TExpr]) (i: Int) (acc: Array[TFieldInit]): Array[TFieldInit] =
    if i >= fields.len() || i >= texprs.len() { acc }
    else { cg_zip_field_inits(fields, texprs, i + 1, acc.push(TFieldInit { name: fields[i].name, value: texprs[i] })) }

let infer_struct_fields (p2: Program2) (state: FreshState) (env: TyEnv) (acc: Subst) (info: StructInfo) (gen_args: Array[ITy]) (fields: Array[parser.FieldInitNode]) (i: Int) (texprs: Array[TExpr]): CallArgsResult =
    if i >= fields.len() { CallArgsResult { subst: acc, state: state, texprs: texprs } }
    else {
        // A field's DECLARED type seeds a closure literal's parameters,
        // the same way a call argument's does — which is what makes
        // `Ops { add: |a, b| a + b }` infer.
        let field_ty0 = match find_field_template(info.fields, fields[i].name) {
            Some(t) => instantiate_template(info.generics, gen_args, t),
            None => ITUnit,
        };
        let r = match subst_apply(acc, field_ty0) {
            ITFunction(ptys, _) => infer_closure_seeded(p2, state, env, acc, fields[i].value, ptys),
            _ => infer_expr(p2, state, env, acc, fields[i].value),
        };
        check_field_visible(p2.ctx, p2.current, info.name, fields[i].name);
        let field_ty = match find_field_template(info.fields, fields[i].name) {
            Some(t) => instantiate_template(info.generics, gen_args, t),
            None => { fail_tc("struct ".concat(info.name).concat(" has no field named ").concat(fields[i].name)); ITUnit },
        };
        let s2 = match unify(subst_apply(r.subst, r.ty), subst_apply(r.subst, field_ty)) { Ok(s) => subst_compose(s, r.subst), Err(e) => { fail_tc("field ".concat(fields[i].name).concat(": ").concat(e)); r.subst } };
        infer_struct_fields(p2, r.state, env, s2, info, gen_args, fields, i + 1, texprs.push(r.texpr))
    }

let infer_match (p2: Program2) (state: FreshState) (env: TyEnv) (acc: Subst) (scrutinee: parser.PExpr) (arms: Array[parser.MatchArmNode]): InferResult = {
    let sr = infer_expr(p2, state, env, acc, scrutinee);
    let ar = infer_match_arms(p2, sr.state, env, sr.subst, subst_apply(sr.subst, sr.ty), arms, 0, None, []);
    check_exhaustive(p2, subst_apply(ar.subst, sr.ty), arms);
    ir_leaf(ar.ty, ar.subst, ar.state, TMatch(sr.texpr, ar.tarms))
}

struct ArmsResult { ty: ITy, subst: Subst, state: FreshState, tarms: Array[TArm] }

// --- `select` ---
//
// Each arm waits on its OWN receiver, so unlike `match` there is no one
// scrutinee: every arm brings its own `Receiver[T]` and binds a value
// of that arm's own `T`. What the arms do share is a result type, the
// same way `match` arms do, because the whole `select` is one
// expression.
//
// An arm with no receiver to wait on cannot ever be chosen, and a
// `select` with no arms at all blocks forever with nothing that could
// wake it -- Go allows exactly that as a deliberate idiom, but nothing
// else in this language is a way to spell "hang", so it is rejected.
let infer_select (p2: Program2) (state: FreshState) (env: TyEnv) (acc: Subst) (arms: Array[parser.SelectArmNode]): InferResult =
    if Array.is_empty(arms) {
        fail_tc("`select` needs at least one arm; a select with none can never proceed");
        ir_unsupported(acc, state, "empty select")
    } else {
        let r = infer_select_arms(p2, state, env, acc, arms, 0, None, []);
        ir_leaf(Option.unwrap_or(r.ty, ITUnit), r.subst, r.state, TSelect(r.tarms))
    }

struct SelectArmsResult { ty: Option[ITy], subst: Subst, state: FreshState, tarms: Array[TSelectArm] }

let infer_select_arms (p2: Program2) (state: FreshState) (env: TyEnv) (acc: Subst) (arms: Array[parser.SelectArmNode]) (i: Int) (result_ty: Option[ITy]) (tarms: Array[TSelectArm]): SelectArmsResult =
    if i >= arms.len() { SelectArmsResult { ty: result_ty, subst: acc, state: state, tarms: tarms } }
    else {
        let cr = infer_expr(p2, state, env, acc, arms[i].expr);
        let ef = fresh(cr.state);
        let s1 = match unify(subst_apply(cr.subst, cr.ty), ITStruct("Receiver", [ef.ty])) {
            Ok(s) => subst_compose(s, cr.subst),
            Err(e) => { fail_tc("a `select` arm waits on a Receiver: ".concat(e)); cr.subst },
        };
        let br = bind_pattern_ty(p2, ef.state, s1, env, arms[i].pattern, subst_apply(s1, ef.ty));
        let bodyr = infer_expr(p2, br.state, br.env, br.subst, arms[i].body);
        let new_result = match result_ty {
            None => subst_apply(bodyr.subst, bodyr.ty),
            Some(prev) => match unify(subst_apply(bodyr.subst, prev), subst_apply(bodyr.subst, bodyr.ty)) {
                Ok(s) => subst_apply(subst_compose(s, bodyr.subst), bodyr.ty),
                Err(e) => { fail_tc("`select` arms: ".concat(e)); bodyr.ty },
            },
        };
        infer_select_arms(p2, bodyr.state, env, bodyr.subst, arms, i + 1, Some(new_result),
            tarms.push(TSelectArm { chan: cr.texpr, pattern: br.pattern, body: bodyr.texpr }))
    }

// --- Exhaustiveness ---
//
// The SAME rule the real compiler applies (`plum-types::infer`'s own
// exhaustiveness block), deliberately, not a stricter or cleverer one:
// two checkers that disagree about which programs are valid is a worse
// outcome than either rule on its own.
//
// Only an ENUM scrutinee is checked. A struct or tuple has a single
// shape, trivially covered by any arm that type-checks against it at
// all, and an `Int`/`String` scrutinee has no finite set of values to
// enumerate.
//
// A trailing catch-all — a wildcard or a bare binding — exempts the
// match, because it accepts anything by construction.
//
// Only TOP-LEVEL variant tags count. `Some(Ok(x))` covers `Some`, not
// "`Some` when its payload is `Ok`". That makes the check INCOMPLETE
// (it accepts some matches that can still fail at runtime on a nested
// shape) rather than unsound (it never rejects a match that does cover
// everything), which is the direction this project consistently
// chooses — the same reasoning `movecheck.rs`'s permissiveness records.
//
// A GUARDED arm still counts as covering its tag. That is the real
// compiler's documented choice too: a variant reachable only through a
// guard that fails hits the existing runtime error unchanged, and this
// check exists to catch the far more common case of a variant with no
// arm at all, without reasoning about guard truth at compile time.
let check_exhaustive (p2: Program2) (scrutinee_ty: ITy) (arms: Array[parser.MatchArmNode]): Unit =
    match scrutinee_ty {
        ITEnum(enum_name, _) => match ctx_enum_tags(p2.ctx, enum_name) {
            None => (),
            Some(all_tags) =>
                if has_catchall_arm(arms) { () }
                else {
                    let missing = missing_tags(all_tags, covered_tags(arms, 0, []), 0, []);
                    if Array.is_empty(missing) { () }
                    else { fail_tc("match is not exhaustive — missing variant(s): ".concat(join_tags(missing, 0, ""))) }
                },
        },
        _ => (),
    }

// Only the LAST arm can exempt the match: an earlier catch-all would
// make every arm after it dead, which is a different problem and not
// this check's business.
let has_catchall_arm (arms: Array[parser.MatchArmNode]): Bool =
    if Array.is_empty(arms) { false } else { is_catchall_pattern(arms[arms.len() - 1].pattern) }

let is_catchall_pattern (pattern: parser.PPattern): Bool =
    match pattern { PWildcard => true, PIdent(_, _) => true, _ => false }

let covered_tags (arms: Array[parser.MatchArmNode]) (i: Int) (acc: Array[String]): Array[String] =
    if i >= arms.len() { acc }
    else { covered_tags(arms, i + 1, Array.concat(acc, tags_of_pattern(arms[i].pattern))) }

// An or-pattern covers every tag its alternatives name.
let tags_of_pattern (pattern: parser.PPattern): Array[String] =
    match pattern {
        PVariant(path, _) => [path[path.len() - 1]],
        POr(alts) => or_alt_tags(alts, 0, []),
        _ => [],
    }

let or_alt_tags (alts: Array[parser.PPattern]) (i: Int) (acc: Array[String]): Array[String] =
    if i >= alts.len() { acc }
    else { or_alt_tags(alts, i + 1, Array.concat(acc, tags_of_pattern(alts[i]))) }

let missing_tags (all_tags: Array[String]) (covered: Array[String]) (i: Int) (acc: Array[String]): Array[String] =
    if i >= all_tags.len() { acc }
    else if Array.contains(covered, all_tags[i]) { missing_tags(all_tags, covered, i + 1, acc) }
    else { missing_tags(all_tags, covered, i + 1, acc.push(all_tags[i])) }

let join_tags (tags: Array[String]) (i: Int) (acc: String): String =
    if i >= tags.len() { acc }
    else if acc == "" { join_tags(tags, i + 1, tags[i]) }
    else { join_tags(tags, i + 1, acc.concat(", ").concat(tags[i])) }

let infer_match_arms (p2: Program2) (state: FreshState) (env: TyEnv) (acc: Subst) (scrutinee_ty: ITy) (arms: Array[parser.MatchArmNode]) (i: Int) (result_ty: Option[ITy]) (tarms: Array[TArm]): ArmsResult =
    if i >= arms.len() { ArmsResult { ty: Option.unwrap_or(result_ty, ITUnit), subst: acc, state: state, tarms: tarms } }
    else {
        let br = bind_pattern_ty(p2, state, acc, env, arms[i].pattern, scrutinee_ty);
        let gr = match arms[i].guard {
            Some(g) => {
                let r = infer_expr(p2, br.state, br.env, br.subst, g);
                let s = match unify(subst_apply(r.subst, r.ty), ITBool) { Ok(s) => subst_compose(s, r.subst), Err(e) => { fail_tc("match guard: ".concat(e)); r.subst } };
                GuardCheckResult { subst: s, state: r.state, tguard: Some(r.texpr) }
            },
            None => GuardCheckResult { subst: br.subst, state: br.state, tguard: None },
        };
        let bodyr = infer_expr(p2, gr.state, br.env, gr.subst, arms[i].body);
        let new_result = match result_ty {
            None => subst_apply(bodyr.subst, bodyr.ty),
            Some(prev) => match unify(subst_apply(bodyr.subst, prev), subst_apply(bodyr.subst, bodyr.ty)) {
                Ok(s) => subst_apply(subst_compose(s, bodyr.subst), bodyr.ty),
                Err(e) => { fail_tc("match arms: ".concat(e)); bodyr.ty },
            },
        };
        infer_match_arms(p2, bodyr.state, env, bodyr.subst, scrutinee_ty, arms, i + 1, Some(new_result),
            tarms.push(TArm { pattern: br.pattern, guard: gr.tguard, body: bodyr.texpr }))
    }

struct GuardCheckResult { subst: Subst, state: FreshState, tguard: Option[TExpr] }

// --- Pattern typing: binds pattern-introduced names into `env`,
// unifying the pattern's own shape against `scrutinee_ty` ---

// `pattern` is the pattern REWRITTEN with what the names in it
// resolved to: a variant path becomes `[enum, tag]` and a struct path
// becomes `[struct]`, both fully qualified. The backend then reads the
// answer instead of searching for one -- see `TVariantNew` in
// texpr.plum for what went wrong when both ends searched separately.
struct BindResult { env: TyEnv, subst: Subst, state: FreshState, pattern: parser.PPattern }
struct BindListResult { env: TyEnv, subst: Subst, state: FreshState, pats: Array[parser.PPattern] }

let bind_pattern_ty (p2: Program2) (state: FreshState) (acc: Subst) (env: TyEnv) (pattern: parser.PPattern) (scrutinee_ty: ITy): BindResult =
    match pattern {
        PWildcard => BindResult { env: env, subst: acc, state: state, pattern: pattern },
        PIdent(name, off) => { note_binding(name, off, scrutinee_ty); BindResult { env: tyenv_extend(env, name, scrutinee_ty, off), subst: acc, state: state, pattern: pattern } },
        PInt(_) => BindResult { env: env, subst: unify_pattern_prim(acc, scrutinee_ty, ITInt), state: state, pattern: pattern },
        PFloat(_) => BindResult { env: env, subst: unify_pattern_prim(acc, scrutinee_ty, ITFloat), state: state, pattern: pattern },
        PStr(_) => BindResult { env: env, subst: unify_pattern_prim(acc, scrutinee_ty, ITStr), state: state, pattern: pattern },
        PBool(_) => BindResult { env: env, subst: unify_pattern_prim(acc, scrutinee_ty, ITBool), state: state, pattern: pattern },
        PTuple(elems) => bind_tuple_pattern(p2, state, acc, env, elems, scrutinee_ty),
        PVariant(path, arg_pats) => bind_variant_pattern(p2, state, acc, env, path, arg_pats, scrutinee_ty),
        PStruct(path, field_pats, rest) => bind_struct_pattern(p2, state, acc, env, path[path.len() - 1], field_pats, rest, scrutinee_ty),
        // Only the FIRST alternative binds -- they all bind the same
        // names at the same types, so one pass is enough for the
        // environment. Every alternative is still RESOLVED, because
        // each one reaches the backend as its own test.
        POr(alts) => {
            let r = bind_pattern_ty(p2, state, acc, env, alts[0], scrutinee_ty);
            BindResult { env: r.env, subst: r.subst, state: r.state,
                pattern: POr(bind_or_alts(p2, r.state, r.subst, env, alts, scrutinee_ty, 1, [r.pattern])) }
        },
    }

// Resolves the alternatives after the first, keeping their rewritten
// form and DISCARDING the environment: `Light | Dark` binds nothing,
// and where an alternative binds, the first one already bound it.
let bind_or_alts (p2: Program2) (state: FreshState) (acc: Subst) (env: TyEnv) (alts: Array[parser.PPattern]) (scrutinee_ty: ITy) (i: Int) (out: Array[parser.PPattern]): Array[parser.PPattern] =
    if i >= alts.len() { out }
    else {
        let r = bind_pattern_ty(p2, state, acc, env, alts[i], scrutinee_ty);
        bind_or_alts(p2, state, acc, env, alts, scrutinee_ty, i + 1, out.push(r.pattern))
    }

let unify_pattern_prim (acc: Subst) (scrutinee_ty: ITy) (prim: ITy): Subst =
    match unify(subst_apply(acc, scrutinee_ty), prim) { Ok(s) => subst_compose(s, acc), Err(e) => { fail_tc(e); acc } }

let bind_tuple_pattern (p2: Program2) (state: FreshState) (acc: Subst) (env: TyEnv) (elems: Array[parser.PPattern]) (scrutinee_ty: ITy): BindResult = {
    let fr = fresh_list(state, elems.len());
    let s1 = match unify(subst_apply(acc, scrutinee_ty), ITTuple(fr.tys)) { Ok(s) => subst_compose(s, acc), Err(e) => { fail_tc(e); acc } };
    let r = bind_pattern_list(p2, fr.state, s1, env, elems, fr.tys, 0, []);
    BindResult { env: r.env, subst: r.subst, state: r.state, pattern: PTuple(r.pats) }
}

let bind_pattern_list (p2: Program2) (state: FreshState) (acc: Subst) (env: TyEnv) (pats: Array[parser.PPattern]) (tys: Array[ITy]) (i: Int) (out: Array[parser.PPattern]): BindListResult =
    if i >= pats.len() { BindListResult { env: env, subst: acc, state: state, pats: out } }
    else {
        let r = bind_pattern_ty(p2, state, acc, env, pats[i], subst_apply(acc, tys[i]));
        bind_pattern_list(p2, r.state, r.subst, r.env, pats, tys, i + 1, out.push(r.pattern))
    }

// A `pub` function may return a type its own module keeps private, and
// nothing stops it. The value that comes back is then OPAQUE outside
// that module: it can be held and passed on, but not taken apart,
// because taking it apart means naming the type. That is a coherent
// position -- it is how a handle type behaves -- and it is why the
// PATTERN paths check visibility as well as the construction ones.
// What the SCRUTINEE's type already says, before any search by tag.
// `match s { Light => ... }` on an `inner.Shade` means that enum's
// `Light` however many other enums declare one, and the type is
// known here in every case that matters -- it is what the arm is
// about to be unified against. Falls through to the flat scan only
// when the scrutinee is still a variable, or is an enum with no such
// tag, where the flat scan's answer produces the error message this
// has always produced.
let variant_by_scrutinee (ctx: TyContext) (scrutinee_ty: ITy) (tag: String): Option[VariantLookup] =
    match scrutinee_ty { ITEnum(name, _) => find_variant_in(ctx, name, tag), _ => None }

// `Shade.Light` in a pattern: the qualifier is the whole answer, and
// it overrides the scrutinee -- naming the wrong enum should report
// the mismatch, not be quietly corrected to the right one.
let resolve_pattern_variant (p2: Program2) (acc: Subst) (scrutinee_ty: ITy) (path: Array[String]) (tag: String): Option[VariantLookup] =
    if path.len() >= 2 {
        match best_enum(p2.ctx, p2.current, parser.join_dot(Array.slice(path, 0, path.len() - 1))) {
            Some(info) => find_variant_in(p2.ctx, info.name, tag),
            None => None,
        }
    }
    else { match variant_by_scrutinee(p2.ctx, subst_apply(acc, scrutinee_ty), tag) {
        Some(v) => Some(v),
        None => resolve_variant(p2, tag),
    } }

let bind_variant_pattern (p2: Program2) (state: FreshState) (acc: Subst) (env: TyEnv) (path: Array[String]) (arg_pats: Array[parser.PPattern]) (scrutinee_ty: ITy): BindResult = {
    let tag = path[path.len() - 1];
    match resolve_pattern_variant(p2, acc, scrutinee_ty, path, tag) {
        Some(v) => {
            check_enum_named(p2.ctx, p2.current, v.enum_name);
            let fr = fresh_list(state, v.enum_generics.len());
            let s1 = match unify(subst_apply(acc, scrutinee_ty), ITEnum(v.enum_name, fr.tys)) { Ok(s) => subst_compose(s, acc), Err(e) => { fail_tc(e); acc } };
            let payload = Array.map(v.payload, |t| instantiate_template(v.enum_generics, fr.tys, t));
            let r = bind_pattern_list(p2, fr.state, s1, env, arg_pats, payload, 0, []);
            BindResult { env: r.env, subst: r.subst, state: r.state, pattern: PVariant([v.enum_name, tag], r.pats) }
        },
        // Not a variant — try a STRUCT of that name. `Point(x, y)`
        // destructures a struct POSITIONALLY, binding its fields in
        // declared order, which the parser produces as a Ctor pattern
        // indistinguishable from a variant one until the name is
        // resolved here. The real compiler accepts it (see
        // `exec_corpus/refs`), so this checker has to as well.
        None => match (if path.len() >= 2 { None } else { struct_by_scrutinee(p2.ctx, p2.current, subst_apply(acc, scrutinee_ty), tag) }) {
            Some(info) => {
                check_struct_named(p2.ctx, p2.current, tag);
                let fr = fresh_list(state, info.generics.len());
                let s1 = match unify(subst_apply(acc, scrutinee_ty), ITStruct(info.name, fr.tys)) { Ok(s) => subst_compose(s, acc), Err(e) => { fail_tc(e); acc } };
                if arg_pats.len() != info.fields.len() {
                    fail_tc("struct ".concat(tag).concat(" has ").concat(info.fields.len().to_string()).concat(" field(s), pattern binds ").concat(arg_pats.len().to_string()));
                    BindResult { env: env, subst: s1, state: fr.state, pattern: PVariant([info.name, tag], arg_pats) }
                } else {
                    // `Point(x, y)` names no field and binds all of
                    // them, so every one has to be visible -- otherwise
                    // positional form would be a way around the check
                    // that the named form enforces.
                    check_all_fields_visible(p2, info, 0);
                    let tys = Array.map(info.fields, |f| instantiate_template(info.generics, fr.tys, f.ty));
                    let r = bind_pattern_list(p2, fr.state, s1, env, arg_pats, tys, 0, []);
                    // A positional STRUCT pattern, still spelled as a
                    // variant one. The head names the struct, so the
                    // backend can tell the two apart the same way this
                    // did: by what the name resolved to.
                    BindResult { env: r.env, subst: r.subst, state: r.state, pattern: PVariant([info.name, tag], r.pats) }
                }
            },
            None => { fail_tc("unbound variant: ".concat(tag)); BindResult { env: env, subst: acc, state: state, pattern: PVariant([tag], arg_pats) } },
        },
    }
}

// The same rule as `variant_by_scrutinee`, for the two struct pattern
// forms. Two modules may each declare a `Point`, and which one a
// pattern means is not a question about who is looking -- the
// scrutinee already answered it.
let struct_by_scrutinee (ctx: TyContext) (current: String) (scrutinee_ty: ITy) (name: String): Option[StructInfo] =
    match scrutinee_ty {
        ITStruct(sname, _) => match find_struct(ctx, sname) {
            Some(info) => if bare_type_name_of(info.name) == name { Some(info) } else { best_struct(ctx, current, name) },
            None => best_struct(ctx, current, name),
        },
        _ => best_struct(ctx, current, name),
    }

let bare_type_name_of (qname: String): String = parser.bare_type_name(qname)

let bind_struct_pattern (p2: Program2) (state: FreshState) (acc: Subst) (env: TyEnv) (name: String) (field_pats: Array[parser.FieldPatternNode]) (rest: Bool) (scrutinee_ty: ITy): BindResult = {
    check_struct_named(p2.ctx, p2.current, name);
    match struct_by_scrutinee(p2.ctx, p2.current, subst_apply(acc, scrutinee_ty), name) {
        Some(info) => {
            let fr = fresh_list(state, info.generics.len());
            let s1 = match unify(subst_apply(acc, scrutinee_ty), ITStruct(info.name, fr.tys)) { Ok(s) => subst_compose(s, acc), Err(e) => { fail_tc(e); acc } };
            let r = bind_struct_field_pats(p2, fr.state, s1, env, info, fr.tys, field_pats, 0, []);
            BindResult { env: r.env, subst: r.subst, state: r.state, pattern: PStruct([info.name], r.fields, rest) }
        },
        None => { fail_tc("unknown struct: ".concat(name)); BindResult { env: env, subst: acc, state: state, pattern: PStruct([name], field_pats, rest) } },
    }
}

struct BindFieldsResult { env: TyEnv, subst: Subst, state: FreshState, fields: Array[parser.FieldPatternNode] }

let bind_struct_field_pats (p2: Program2) (state: FreshState) (acc: Subst) (env: TyEnv) (info: StructInfo) (gen_args: Array[ITy]) (field_pats: Array[parser.FieldPatternNode]) (i: Int) (out: Array[parser.FieldPatternNode]): BindFieldsResult =
    if i >= field_pats.len() { BindFieldsResult { env: env, subst: acc, state: state, fields: out } }
    else {
        check_field_visible(p2.ctx, p2.current, info.name, field_pats[i].name);
        let field_ty = match find_field_template(info.fields, field_pats[i].name) {
            Some(t) => instantiate_template(info.generics, gen_args, t),
            None => { fail_tc("struct ".concat(info.name).concat(" has no field named ").concat(field_pats[i].name)); ITUnit },
        };
        let r = bind_pattern_ty(p2, state, acc, env, field_pats[i].pattern, subst_apply(acc, field_ty));
        bind_struct_field_pats(p2, r.state, r.subst, r.env, info, gen_args, field_pats, i + 1,
            out.push(parser.FieldPatternNode { name: field_pats[i].name, pattern: r.pattern }))
    }
