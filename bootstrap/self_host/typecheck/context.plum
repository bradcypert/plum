// Layer 1.5: struct/enum declaration context + AST-annotation ->
// `ITy` resolution — mirrors `crates/plum-types/src/context.rs`'s
// `TypeContext` (field/variant templates, keyed by declaration name)
// and `infer.rs`'s `ast_type_to_type`/`resolve_annotation` (the two
// AST-type -> `Type` converters — this module doesn't need to keep
// them separate the way the real compiler does, since this checker
// has no `extern` support to justify the split).
//
// **Deliberate v1 scope cut**: of the real compiler's own five built-in
// generic-arity-one pseudo-types, only `Array` is recognized here
// (`Task`/`Sender`/`Receiver`/`Ref` aren't — `interp/interp.plum`
// doesn't support concurrency either, so there's nothing for a type
// checker to validate for those yet). Referencing one of THOSE names in
// an annotation still fails with a clear "unknown type" error, not
// silently wrong behavior. `Array[T]` resolves to `ITStruct("Array",
// [T])` — the exact same representation the real compiler's own
// `ast_type_to_type` uses (`Type::Struct("Array", vec![elem_ty])`, see
// `plum-types::infer.rs`), reused as-is rather than adding a dedicated
// `ITy` case: every existing `ITStruct` machinery (`unify`, `subst_
// apply`, `instantiate_template`) already handles it correctly with
// zero new code.

use parser;

// `is_pub` was parsed into `StructFieldNode` and dropped here until
// 2026-08-27, which is why `pub` on a field did nothing.
struct StructFieldTemplate { name: String, ty: ITy, is_pub: Bool }
// `module`/`is_pub` are carried for VISIBILITY only. A type's identity
// is still its bare name (`ITStruct(name, args)`), so two modules
// still cannot declare the same type name -- that is unchanged, and is
// its own piece of work. What these add is the ability to say no.
struct StructInfo { name: String, generics: Array[String], fields: Array[StructFieldTemplate], module: String, is_pub: Bool }
struct VariantInfo { tag: String, enum_name: String, payload: Array[ITy] }
struct EnumInfo { name: String, generics: Array[String], variants: Array[VariantInfo], module: String, is_pub: Bool }

pub struct TyContext { pub structs: Array[StructInfo], pub enums: Array[EnumInfo] }

let fail_ctx (msg: String): Unit = panic_raw("self-hosted type checker: ".concat(msg))

// The root module is spelled `""` internally -- it holds the prelude
// and every file not in a subdirectory. Printing "module ``" in a
// diagnostic is not something a reader can act on.
pub let module_label (m: String): String =
    if m == "" { "the root module" }
    else if m == parser.PRELUDE_MODULE(()) { "the prelude" }
    else { "module `".concat(m).concat("`") }

// --- Building the context from a whole program's declarations ---

// TWO passes, not one — declaration types are mutually and
// SELF-referential, so no single in-order pass can work. `pub enum ITy
// { .. ITFunction(Array[ITy], ITy) .. }` (this very type checker's own
// `types.plum`) mentions `ITy` inside `ITy`'s own payload, and a
// single-pass build resolves each variant's payload against the context
// as it existed BEFORE that enum was added — so the self-reference
// failed with "unknown type: ITy". The same happened for every
// self-hosted source (`Ty` in parser.plum, `Value` in interp.plum,
// `InterpPiece` in lexer.plum), which is what blocked `./sh check` from
// running on this project's own code at all.
//
// Pass 1 registers every declaration's NAME and its own generic
// parameters, with empty fields/variants. Pass 2 then resolves every
// field/payload annotation against that COMPLETE name set, so forward
// and self references both resolve. Resolution only ever needs names
// and arity (`resolve_named` looks up `find_struct`/`find_enum`), never
// the field types themselves, which is exactly why the placeholder pass
// is sufficient rather than needing a fixpoint.
//
// This is the same Phase-1/Phase-2 split the real compiler uses, and
// the one `infer.plum`'s own top comment notes it could SKIP for
// FUNCTIONS (their signatures are required to be fully annotated, so
// they're all known before any body is checked). Types get no such
// escape: a declaration's shape is only knowable from the declaration
// itself, so the split is unavoidable here.
pub let build_context (program: parser.ProgramNode): TyContext = {
    let names_only = collect_names_acc(program.items, 0, builtin_context(()));
    resolve_decls_acc(program.items, 0, names_only, builtin_context(()))
}

// The prelude declares all nine of the types this used to hand-write --
// `Option`, `Result`, `JsonValue`, `JsonEntry`, `ProcessResult`,
// `Zipped`, `Map`, `MapEntry`, `Set` -- and every caller of
// `build_context` now passes a program with the prelude prepended:
// `check` included, since 2026-08-20.
//
// The hand-written copies existed because `check` ran WITHOUT the
// prelude, and a checker that doesn't know `Option` can't check
// anything real. That made this a second copy of nine declarations,
// kept current by remembering to, and it fell behind -- `Map` and `Set`
// were missing entirely, so `check` rejected programs the backend
// compiled and ran correctly. The prelude source is the only copy now.
//
// Kept as an empty function rather than deleted outright: the next
// genuinely-undeclarable type goes here, and this comment is where the
// reason for one would be written down.
let builtin_context (unit: Unit): TyContext = TyContext {
    structs: [],
    enums: [],
}

let collect_names_acc (items: Array[parser.ItemNode]) (i: Int) (ctx: TyContext): TyContext =
    if i >= items.len() { ctx }
    else {
        match items[i].kind {
            IKStruct(decl) => collect_names_acc(items, i + 1, TyContext {
                structs: ctx.structs.push(StructInfo { name: parser.qualify_type(items[i].module, decl.name), generics: Array.map(decl.generics, |g| g.name), fields: [], module: items[i].module, is_pub: items[i].is_pub }),
                enums: ctx.enums,
            }),
            IKEnum(decl) => collect_names_acc(items, i + 1, TyContext {
                structs: ctx.structs,
                enums: ctx.enums.push(EnumInfo { name: parser.qualify_type(items[i].module, decl.name), generics: Array.map(decl.generics, |g| g.name), variants: [], module: items[i].module, is_pub: items[i].is_pub }),
            }),
            _ => collect_names_acc(items, i + 1, ctx),
        }
    }

let resolve_decls_acc (items: Array[parser.ItemNode]) (i: Int) (names: TyContext) (out: TyContext): TyContext =
    if i >= items.len() { out }
    else {
        match items[i].kind {
            IKStruct(decl) => resolve_decls_acc(items, i + 1, names, add_struct(names, out, decl, items[i].module, items[i].is_pub)),
            IKEnum(decl) => resolve_decls_acc(items, i + 1, names, add_enum(names, out, decl, items[i].module, items[i].is_pub)),
            _ => resolve_decls_acc(items, i + 1, names, out),
        }
    }

// `names` is the complete pass-1 name set that annotations resolve
// AGAINST; `out` is the fully-resolved context being accumulated. Two
// separate contexts on purpose — resolving against `out` would
// reintroduce the in-order dependency this split exists to remove.
let add_struct (names: TyContext) (out: TyContext) (decl: parser.StructDeclNode) (module_name: String) (is_pub: Bool): TyContext = {
    // A struct's OWN declared generic names are already fully known
    // from its own declaration — resolving its fields' annotations
    // needs no fresh-var bootstrapping the way a mutually-recursive
    // FUNCTION signature would (see `infer.plum`'s own top comment for
    // that same reasoning, applied to functions instead of structs).
    let generic_names = Array.map(decl.generics, |g| g.name);
    let fields = Array.map(decl.fields, |f| StructFieldTemplate { name: f.name, ty: resolve_ann_seen(names, module_name, generic_names, f.ty), is_pub: f.is_pub });
    TyContext { structs: out.structs.push(StructInfo { name: parser.qualify_type(module_name, decl.name), generics: generic_names, fields: fields, module: module_name, is_pub: is_pub }), enums: out.enums }
}

let add_enum (names: TyContext) (out: TyContext) (decl: parser.EnumDeclNode) (module_name: String) (is_pub: Bool): TyContext = {
    let generic_names = Array.map(decl.generics, |g| g.name);
    let variants = Array.map(decl.variants, |v| VariantInfo {
        tag: v.name,
        enum_name: parser.qualify_type(module_name, decl.name),
        payload: Array.map(v.payload, |t| resolve_ann_seen(names, module_name, generic_names, t)),
    });
    TyContext { structs: out.structs, enums: out.enums.push(EnumInfo { name: parser.qualify_type(module_name, decl.name), generics: generic_names, variants: variants, module: module_name, is_pub: is_pub }) }
}

// --- Lookups ---

// Visibility for the places a type is named WITHOUT an annotation: a
// struct literal, a struct pattern, a variant constructor. Those
// resolve through `find_struct`/`find_variant` rather than through
// `resolve_ann`, so they need their own call rather than inheriting
// the annotation path's check.
// A FIELD is private unless declared `pub`, independently of its
// struct: `pub struct Circle { pub radius: Float, cached: Float }` is
// a visible type with one visible field.
//
// The consequence worth stating out loud: a struct with any private
// field cannot be CONSTRUCTED from outside its module, because a
// literal has to name every field. That is deliberate -- it is what
// makes a constructor function the only way in, which is the whole
// point of hiding the field -- but it means such a struct needs one.
pub let check_field_visible (ctx: TyContext) (viewer: String) (struct_name: String) (field: String): Unit =
    // Callers pass either an identity (qualified, straight out of an
    // `ITStruct`) or a name as written in source (bare). Try the
    // identity first: `best_struct` would fail to match a qualified
    // name and silently skip the check, which is how this went quiet
    // the first time.
    match match find_struct(ctx, struct_name) {
        Some(info) => Some(info),
        None => best_struct(ctx, viewer, struct_name),
    } {
        None => (),
        Some(info) => if viewer == ANY_MODULE() || viewer == info.module { () }
            else { match find_field_pub(info.fields, field, 0) {
                None => (),
                Some(is_pub) => if is_pub { () } else {
                    fail_ctx("field ".concat(struct_name).concat(".").concat(field)
                        .concat(" is private to ").concat(module_label(info.module))
                        .concat(". Add `pub` to it to use it from ").concat(module_label(viewer)))
                },
            } },
    }

let find_field_pub (fields: Array[StructFieldTemplate]) (name: String) (i: Int): Option[Bool] =
    if i >= fields.len() { None }
    else if fields[i].name == name { Some(fields[i].is_pub) }
    else { find_field_pub(fields, name, i + 1) }

pub let check_struct_named (ctx: TyContext) (viewer: String) (name: String): Unit =
    match best_struct(ctx, viewer, name) {
        Some(info) => check_type_visible(viewer, info.module, info.is_pub, "struct", name),
        None => (),
    }

// A type's identity is still its bare NAME, so two modules declaring
// the same name both land in one flat list and `find_struct` returns
// whichever is first. That was harmless while nothing read the extra
// fields; it is not harmless for visibility, because it would let a
// module be told that its OWN type is private to somebody else.
//
// So the visibility lookup prefers the viewer's own module, then the
// root, then anything -- the same current-then-root order `find_sig`
// uses for functions, for the same reason.
//
// This does NOT make duplicate type names work properly: the type the
// checker then uses is still whichever the flat lookup finds, and its
// FIELDS may come from the other declaration. Fixing that means giving
// a type a module-qualified identity, which is a separate and much
// wider change (see DESIGN.md).
pub let best_struct (ctx: TyContext) (viewer: String) (name: String): Option[StructInfo] =
    match find_struct_in(ctx.structs, viewer, name, 0) {
        Some(info) => Some(info),
        None => match find_struct_in(ctx.structs, "", name, 0) {
            Some(info) => Some(info),
            None => match find_struct_in(ctx.structs, parser.PRELUDE_MODULE(()), name, 0) {
                Some(info) => Some(info),
                // Last resort: any module at all, matched on the bare name.
                // Reached when a name is not declared by the viewer, the
                // root or the prelude -- a qualified `inner.P` written out
                // in full lands here too.
                None => find_struct_bare(ctx.structs, name, 0),
            },
        },
    }

let find_struct_in (structs: Array[StructInfo]) (module_name: String) (name: String) (i: Int): Option[StructInfo] =
    if i >= structs.len() { None }
    else if structs[i].name == parser.qualify_type(module_name, name) && structs[i].module == module_name { Some(structs[i]) }
    else { find_struct_in(structs, module_name, name, i + 1) }

// Checked against the ENUM, not the variant: `Hidden.A` is private
// because `Hidden` is, and a variant has no visibility of its own.
pub let check_enum_named (ctx: TyContext) (viewer: String) (enum_name: String): Unit =
    match best_enum(ctx, viewer, enum_name) {
        Some(info) => check_type_visible(viewer, info.module, info.is_pub, "enum", enum_name),
        None => (),
    }

pub let best_enum (ctx: TyContext) (viewer: String) (name: String): Option[EnumInfo] =
    match find_enum_in(ctx.enums, viewer, name, 0) {
        Some(info) => Some(info),
        None => match find_enum_in(ctx.enums, "", name, 0) {
            Some(info) => Some(info),
            None => match find_enum_in(ctx.enums, parser.PRELUDE_MODULE(()), name, 0) {
                Some(info) => Some(info),
                None => find_enum_bare(ctx.enums, name, 0),
            },
        },
    }

let find_enum_in (enums: Array[EnumInfo]) (module_name: String) (name: String) (i: Int): Option[EnumInfo] =
    if i >= enums.len() { None }
    else if enums[i].name == parser.qualify_type(module_name, name) && enums[i].module == module_name { Some(enums[i]) }
    else { find_enum_in(enums, module_name, name, i + 1) }

// Matches the bare LAST SEGMENT, for the last-resort lookup only. Two
// modules declaring the same name both match here and the first wins,
// which is exactly the old behaviour -- but it is now reached only
// after the viewer, the root and the prelude have all been tried, so
// it can no longer make a module lose its own type.
let find_struct_bare (structs: Array[StructInfo]) (name: String) (i: Int): Option[StructInfo] =
    if i >= structs.len() { None }
    else if structs[i].name == parser.qualify_type(structs[i].module, name) { Some(structs[i]) }
    else { find_struct_bare(structs, name, i + 1) }

let find_enum_bare (enums: Array[EnumInfo]) (name: String) (i: Int): Option[EnumInfo] =
    if i >= enums.len() { None }
    else if enums[i].name == parser.qualify_type(enums[i].module, name) { Some(enums[i]) }
    else { find_enum_bare(enums, name, i + 1) }

// `find_struct`/`find_enum` take a QUALIFIED name -- the one carried in
// `ITStruct`/`ITEnum`. Resolving a name written in SOURCE goes through
// `best_struct`/`best_enum` instead, which take the bare form.
pub let find_struct (ctx: TyContext) (name: String): Option[StructInfo] = find_struct_acc(ctx.structs, name, 0)
let find_struct_acc (structs: Array[StructInfo]) (name: String) (i: Int): Option[StructInfo] =
    if i >= structs.len() { None } else if structs[i].name == name { Some(structs[i]) } else { find_struct_acc(structs, name, i + 1) }

pub let find_enum (ctx: TyContext) (name: String): Option[EnumInfo] = find_enum_acc(ctx.enums, name, 0)
let find_enum_acc (enums: Array[EnumInfo]) (name: String) (i: Int): Option[EnumInfo] =
    if i >= enums.len() { None } else if enums[i].name == name { Some(enums[i]) } else { find_enum_acc(enums, name, i + 1) }

// A variant tag's owning enum + declared generics + payload template.
//
// Tags no longer live in one flat global namespace. A tag is resolved
// by, in order: an explicit qualifier (`Shade.Light`), the SCRUTINEE's
// type in a pattern, the module doing the writing, and only then a
// scan of every enum -- which is now reached just when exactly one
// enum declares the tag, because more than one is reported instead of
// guessed. `find_variant` is that last scan and is no longer the way
// anything resolves a tag on its own.
pub struct VariantLookup { pub enum_name: String, pub enum_generics: Array[String], pub payload: Array[ITy] }

let find_variant_acc (variants: Array[VariantInfo]) (tag: String) (i: Int): Option[VariantInfo] =
    if i >= variants.len() { None } else if variants[i].tag == tag { Some(variants[i]) } else { find_variant_acc(variants, tag, i + 1) }

// Resolution that NAMES the enum instead of searching for it. Every
// caller that already knows which enum it means should use this:
// `find_variant` answers by tag alone, so two enums sharing a tag
// name make it a coin toss -- and the checker and the backend can
// toss differently, which type-checks and then miscompiles.
// Every enum that declares this tag, in declaration order. One
// candidate is an answer; more than one is a question the program has
// to answer for itself.
pub let variant_candidates (ctx: TyContext) (tag: String): Array[VariantLookup] = variant_candidates_acc(ctx.enums, tag, 0, [])
let variant_candidates_acc (enums: Array[EnumInfo]) (tag: String) (i: Int) (acc: Array[VariantLookup]): Array[VariantLookup] =
    if i >= enums.len() { acc }
    else {
        match find_variant_acc(enums[i].variants, tag, 0) {
            Some(v) => variant_candidates_acc(enums, tag, i + 1, acc.push(VariantLookup { enum_name: enums[i].name, enum_generics: enums[i].generics, payload: v.payload })),
            None => variant_candidates_acc(enums, tag, i + 1, acc),
        }
    }

// The candidates declared in one module. `module_of_type` splits a
// qualified name back into the module that owns it.
pub let variants_in_module (cands: Array[VariantLookup]) (module_name: String) (i: Int) (acc: Array[VariantLookup]): Array[VariantLookup] =
    if i >= cands.len() { acc }
    else if module_of_type(cands[i].enum_name) == module_name { variants_in_module(cands, module_name, i + 1, acc.push(cands[i])) }
    else { variants_in_module(cands, module_name, i + 1, acc) }

// "" for a name with no qualifier -- a builtin like `Array`, which no
// module declares.
pub let module_of_type (qname: String): String = {
    let parts = qname.split(".");
    if parts.len() < 2 { "" } else { join_but_last(parts, 0, "") }
}

let join_but_last (parts: Array[String]) (i: Int) (acc: String): String =
    if i >= parts.len() - 1 { acc }
    else if acc == "" { join_but_last(parts, i + 1, parts[i]) }
    else { join_but_last(parts, i + 1, acc.concat(".").concat(parts[i])) }

pub let find_variant_in (ctx: TyContext) (enum_name: String) (tag: String): Option[VariantLookup] =
    match find_enum(ctx, enum_name) {
        None => None,
        Some(info) => match find_variant_acc(info.variants, tag, 0) {
            Some(v) => Some(VariantLookup { enum_name: info.name, enum_generics: info.generics, payload: v.payload }),
            None => None,
        },
    }

// --- AST annotation -> `ITy` ---

// The module doing the LOOKING, when there is one to check against.
// `ANY_MODULE` means "do not check": used while the context is still
// being built, where every annotation belongs to the declaration it
// came from and so is visible by construction.
// `*` cannot collide with a real module: a module name comes from a
// directory and has to be a legal identifier in `use X;`.
pub let ANY_MODULE (): String = "*"

pub let resolve_ann (ctx: TyContext) (in_scope: Array[String]) (t: parser.Ty): ITy =
    resolve_ann_seen(ctx, ANY_MODULE(), in_scope, t)

// A type is private unless declared `pub`, exactly as a function is.
// The identity of a type is still its bare name, so this cannot make
// two same-named types coexist -- it can only refuse to resolve one
// that the looking module has no business naming.
pub let check_type_visible (viewer: String) (owner: String) (is_pub: Bool) (kind: String) (name: String): Unit =
    if is_pub || viewer == ANY_MODULE() || viewer == owner { () }
    else {
        fail_ctx(kind.concat(" ").concat(name).concat(" is private to ").concat(module_label(owner))
            .concat(". Add `pub` to its declaration to use it from ").concat(module_label(viewer)))
    }

pub let resolve_ann_seen (ctx: TyContext) (viewer: String) (in_scope: Array[String]) (t: parser.Ty): ITy =
    match t {
        TyFunction(params, ret) => ITFunction(Array.map(params, |p| resolve_ann_seen(ctx, viewer, in_scope, p)), resolve_ann_seen(ctx, viewer, in_scope, ret)),
        TyGeneric(base, args) => resolve_named(ctx, viewer, in_scope, base[base.len() - 1], Array.map(args, |a| resolve_ann_seen(ctx, viewer, in_scope, a))),
        TyPath(segments) => resolve_named(ctx, viewer, in_scope, segments[segments.len() - 1], []),
        TyTuple(elems) => ITTuple(Array.map(elems, |e| resolve_ann_seen(ctx, viewer, in_scope, e))),
    }

let resolve_named (ctx: TyContext) (viewer: String) (in_scope: Array[String]) (name: String) (args: Array[ITy]): ITy =
    if name == "Int" { ITInt }
    else if name == "Float" { ITFloat }
    else if name == "Bool" { ITBool }
    else if name == "String" { ITStr }
    else if name == "CStr" { ITCStr }
    else if name == "Unit" { ITUnit }
    else if name == "Array" { ITStruct("Array", args) }
    // Handles, not declarations: `Task`/`Sender`/`Receiver` have no
    // fields to look up, and the type argument is what `.join()`/
    // `.recv()` read the element type from.
    else if name == "Task" { ITStruct("Task", args) }
    else if name == "Sender" { ITStruct("Sender", args) }
    else if name == "Receiver" { ITStruct("Receiver", args) }
    // `Ref[T]` is a TYPE you can write, not only one inference can
    // produce. `ITRef` has always existed and `ref(v)` has always made
    // one; there was simply no way to NAME it, so `let r: Ref[Int] =
    // ref(1)` failed with "unknown type: Ref" while the identical line
    // without the annotation compiled.
    else if name == "Ref" && args.len() == 1 { ITRef(args[0]) }
    else if Array.contains(in_scope, name) { ITParam(name) }
    // Resolved through the VIEWER's own module first, so a name means
    // what it means where it was written.
    else { match best_struct(ctx, viewer, name) {
        Some(info) => { check_struct_named(ctx, viewer, name); ITStruct(info.name, args) },
        None => match best_enum(ctx, viewer, name) {
            Some(info) => { check_enum_named(ctx, viewer, name); ITEnum(info.name, args) },
            None => { fail_ctx("unknown type: ".concat(name)); ITUnit },
        },
    } }

// --- Instantiating a declaration's template at a concrete use site ---

// Substitutes every `ITParam(name)` in `template` for the matching
// entry of `args` (positional, same order as `generics`) — the fixed-
// arity, explicit-declaration-driven counterpart to a polymorphic
// function's `Scheme` instantiation (see `infer.plum`'s own doc
// comment on why this checker needs no `Scheme`/`generalize` machinery
// at all: Plum's generics are always explicitly declared, never
// inferred from usage).
pub let instantiate_template (generics: Array[String]) (args: Array[ITy]) (template: ITy): ITy =
    match template {
        ITParam(name) => Option.unwrap_or(lookup_generic_arg(generics, args, name, 0), template),
        ITFunction(params, ret) => ITFunction(Array.map(params, |p| instantiate_template(generics, args, p)), instantiate_template(generics, args, ret)),
        ITTuple(elems) => ITTuple(Array.map(elems, |e| instantiate_template(generics, args, e))),
        ITStruct(name, sargs) => ITStruct(name, Array.map(sargs, |a| instantiate_template(generics, args, a))),
        ITEnum(name, sargs) => ITEnum(name, Array.map(sargs, |a| instantiate_template(generics, args, a))),
        _ => template,
    }

let lookup_generic_arg (generics: Array[String]) (args: Array[ITy]) (name: String) (i: Int): Option[ITy] =
    if i >= generics.len() { None } else if generics[i] == name { Some(args[i]) } else { lookup_generic_arg(generics, args, name, i + 1) }

// --- Layout accessors for the backend ---
//
// `codegen/` needs a struct's field NAMES (for slot order) and a
// struct's/variant's declared field/payload TYPES (to pick a load's
// machine type). Those already live here, fully resolved, so the
// backend reads them rather than re-resolving the annotations — the
// same reason it reads expression types off the typed tree instead of
// synthesizing them. Exposed as functions rather than by making the
// info structs public, so the representation stays private.
pub let ctx_field_names (ctx: TyContext) (name: String): Array[String] =
    match find_struct(ctx, name) {
        Some(info) => Array.map(info.fields, |f| f.name),
        None => { fail_ctx("unknown struct: ".concat(name).concat(" (asked for its field names)")); [] },
    }

pub let ctx_field_types (ctx: TyContext) (name: String): Array[ITy] =
    match find_struct(ctx, name) {
        Some(info) => Array.map(info.fields, |f| f.ty),
        None => { fail_ctx("unknown struct: ".concat(name).concat(" (asked for its field types)")); [] },
    }

pub let ctx_variant_payload (ctx: TyContext) (enum_name: String) (tag: String): Array[ITy] =
    match find_variant_in(ctx, enum_name, tag) {
        Some(v) => v.payload,
        None => { fail_ctx("unknown variant: ".concat(enum_name).concat(".").concat(tag)); [] },
    }

// The declared type-parameter names of a struct, and of the enum a
// variant belongs to. A backend that leaves generic AGGREGATES
// unspecialized (correct when every field occupies a uniform slot)
// still needs these to instantiate a field or payload TEMPLATE against
// the type arguments at a particular use site.
pub let ctx_struct_generics (ctx: TyContext) (name: String): Array[String] =
    match find_struct(ctx, name) {
        Some(info) => info.generics,
        None => { fail_ctx("unknown struct: ".concat(name).concat(" (asked for its generics)")); [] },
    }

pub let ctx_variant_generics (ctx: TyContext) (enum_name: String) (tag: String): Array[String] =
    match find_variant_in(ctx, enum_name, tag) {
        Some(v) => v.enum_generics,
        None => { fail_ctx("unknown variant: ".concat(enum_name).concat(".").concat(tag)); [] },
    }

// Every variant tag of an enum, in declaration order — what
// exhaustiveness checking needs to know what a `match` has to cover.
// `None` for an unknown name, which is not an error here: the caller
// only asks about a scrutinee whose type already resolved to an enum.
pub let ctx_enum_tags (ctx: TyContext) (name: String): Option[Array[String]] =
    match find_enum(ctx, name) {
        Some(info) => Some(Array.map(info.variants, |v| v.tag)),
        None => None,
    }
