// Layer 1.5: struct/enum declaration context + AST-annotation ->
// `ITy` resolution — mirrors `crates/plum-types/src/context.rs`'s
// `TypeContext` (field/variant templates, keyed by declaration name)
// and `infer.rs`'s `ast_type_to_type`/`resolve_annotation` (the two
// AST-type -> `Type` converters — this module doesn't need to keep
// them separate the way the real compiler does, since this checker
// has no `extern` support to justify the split).
//
// **Deliberate v1 scope cut**: of the real compiler's own five built-in
// generic-arity-one pseudo-types, only `Array` is recognized here
// (`Task`/`Sender`/`Receiver`/`Ref` aren't — `interp/interp.plum`
// doesn't support concurrency either, so there's nothing for a type
// checker to validate for those yet). Referencing one of THOSE names in
// an annotation still fails with a clear "unknown type" error, not
// silently wrong behavior. `Array[T]` resolves to `ITStruct("Array",
// [T])` — the exact same representation the real compiler's own
// `ast_type_to_type` uses (`Type::Struct("Array", vec![elem_ty])`, see
// `plum-types::infer.rs`), reused as-is rather than adding a dedicated
// `ITy` case: every existing `ITStruct` machinery (`unify`, `subst_
// apply`, `instantiate_template`) already handles it correctly with
// zero new code.

use parser;

struct StructFieldTemplate { name: String, ty: ITy }
struct StructInfo { name: String, generics: Array[String], fields: Array[StructFieldTemplate] }
struct VariantInfo { tag: String, enum_name: String, payload: Array[ITy] }
struct EnumInfo { name: String, generics: Array[String], variants: Array[VariantInfo] }

pub struct TyContext { structs: Array[StructInfo], enums: Array[EnumInfo] }

let fail_ctx (msg: String): Unit = panic_raw("self-hosted type checker: ".concat(msg))

// --- Building the context from a whole program's declarations ---

// TWO passes, not one — declaration types are mutually and
// SELF-referential, so no single in-order pass can work. `pub enum ITy
// { .. ITFunction(Array[ITy], ITy) .. }` (this very type checker's own
// `types.plum`) mentions `ITy` inside `ITy`'s own payload, and a
// single-pass build resolves each variant's payload against the context
// as it existed BEFORE that enum was added — so the self-reference
// failed with "unknown type: ITy". The same happened for every
// self-hosted source (`Ty` in parser.plum, `Value` in interp.plum,
// `InterpPiece` in lexer.plum), which is what blocked `./sh check` from
// running on this project's own code at all.
//
// Pass 1 registers every declaration's NAME and its own generic
// parameters, with empty fields/variants. Pass 2 then resolves every
// field/payload annotation against that COMPLETE name set, so forward
// and self references both resolve. Resolution only ever needs names
// and arity (`resolve_named` looks up `find_struct`/`find_enum`), never
// the field types themselves, which is exactly why the placeholder pass
// is sufficient rather than needing a fixpoint.
//
// This is the same Phase-1/Phase-2 split the real compiler uses, and
// the one `infer.plum`'s own top comment notes it could SKIP for
// FUNCTIONS (their signatures are required to be fully annotated, so
// they're all known before any body is checked). Types get no such
// escape: a declaration's shape is only knowable from the declaration
// itself, so the split is unavoidable here.
pub let build_context (program: parser.ProgramNode): TyContext = {
    let names_only = collect_names_acc(program.items, 0, builtin_context(()));
    resolve_decls_acc(program.items, 0, names_only, builtin_context(()))
}

// `Option[T]`/`Result[T, E]` are declared in the real compiler's PRELUDE
// (see `plumc`'s `STDLIB_*_SRC`), not in any file this checker is handed
// — but they're referenced pervasively by ordinary Plum source, so a
// checker that doesn't know them can't check anything real. Seeded into
// BOTH passes so their variant tags (`Some`/`None`/`Ok`/`Err`) resolve
// through the same `find_variant` path a user-declared enum's tags do,
// with no special-casing anywhere else.
//
// Deliberately NOT a general prelude import: this is the two enums whose
// absence actually blocks checking, hand-written, rather than a
// mechanism for loading the real prelude's ~1,500 lines. Extending this
// list is the right move when a specific missing declaration blocks a
// specific real program, matching how every other v1 scope decision in
// this bootstrap has been made.
let builtin_context (unit: Unit): TyContext = TyContext {
    // `ProcessResult` is here for the same reason `Option`/`Result`
    // are: it lives in the prelude, and `check` runs on a program
    // WITHOUT the prelude (unlike `emit-llvm`/`build`, where the
    // backend prepends it). `main.plum` reads `.exit_code`/`.stderr`
    // off a `run_process` result, so checking this compiler's own
    // source needs the field layout, not just the name.
    structs: [
        StructInfo {
            name: "ProcessResult",
            generics: [],
            fields: [
                StructFieldTemplate { name: "exit_code", ty: ITInt },
                StructFieldTemplate { name: "stdout", ty: ITStr },
                StructFieldTemplate { name: "stderr", ty: ITStr },
            ],
        },
    ],
    enums: [
        EnumInfo {
            name: "Option",
            generics: ["T"],
            variants: [
                VariantInfo { tag: "Some", enum_name: "Option", payload: [ITParam("T")] },
                VariantInfo { tag: "None", enum_name: "Option", payload: [] },
            ],
        },
        EnumInfo {
            name: "Result",
            generics: ["T", "E"],
            variants: [
                VariantInfo { tag: "Ok", enum_name: "Result", payload: [ITParam("T")] },
                VariantInfo { tag: "Err", enum_name: "Result", payload: [ITParam("E")] },
            ],
        },
    ],
}

let collect_names_acc (items: Array[parser.ItemNode]) (i: Int) (ctx: TyContext): TyContext =
    if i >= items.len() { ctx }
    else {
        match items[i].kind {
            IKStruct(decl) => collect_names_acc(items, i + 1, TyContext {
                structs: ctx.structs.push(StructInfo { name: decl.name, generics: Array.map(decl.generics, |g| g.name), fields: [] }),
                enums: ctx.enums,
            }),
            IKEnum(decl) => collect_names_acc(items, i + 1, TyContext {
                structs: ctx.structs,
                enums: ctx.enums.push(EnumInfo { name: decl.name, generics: Array.map(decl.generics, |g| g.name), variants: [] }),
            }),
            _ => collect_names_acc(items, i + 1, ctx),
        }
    }

let resolve_decls_acc (items: Array[parser.ItemNode]) (i: Int) (names: TyContext) (out: TyContext): TyContext =
    if i >= items.len() { out }
    else {
        match items[i].kind {
            IKStruct(decl) => resolve_decls_acc(items, i + 1, names, add_struct(names, out, decl)),
            IKEnum(decl) => resolve_decls_acc(items, i + 1, names, add_enum(names, out, decl)),
            _ => resolve_decls_acc(items, i + 1, names, out),
        }
    }

// `names` is the complete pass-1 name set that annotations resolve
// AGAINST; `out` is the fully-resolved context being accumulated. Two
// separate contexts on purpose — resolving against `out` would
// reintroduce the in-order dependency this split exists to remove.
let add_struct (names: TyContext) (out: TyContext) (decl: parser.StructDeclNode): TyContext = {
    // A struct's OWN declared generic names are already fully known
    // from its own declaration — resolving its fields' annotations
    // needs no fresh-var bootstrapping the way a mutually-recursive
    // FUNCTION signature would (see `infer.plum`'s own top comment for
    // that same reasoning, applied to functions instead of structs).
    let generic_names = Array.map(decl.generics, |g| g.name);
    let fields = Array.map(decl.fields, |f| StructFieldTemplate { name: f.name, ty: resolve_ann(names, generic_names, f.ty) });
    TyContext { structs: out.structs.push(StructInfo { name: decl.name, generics: generic_names, fields: fields }), enums: out.enums }
}

let add_enum (names: TyContext) (out: TyContext) (decl: parser.EnumDeclNode): TyContext = {
    let generic_names = Array.map(decl.generics, |g| g.name);
    let variants = Array.map(decl.variants, |v| VariantInfo {
        tag: v.name,
        enum_name: decl.name,
        payload: Array.map(v.payload, |t| resolve_ann(names, generic_names, t)),
    });
    TyContext { structs: out.structs, enums: out.enums.push(EnumInfo { name: decl.name, generics: generic_names, variants: variants }) }
}

// --- Lookups ---

pub let find_struct (ctx: TyContext) (name: String): Option[StructInfo] = find_struct_acc(ctx.structs, name, 0)
let find_struct_acc (structs: Array[StructInfo]) (name: String) (i: Int): Option[StructInfo] =
    if i >= structs.len() { None } else if structs[i].name == name { Some(structs[i]) } else { find_struct_acc(structs, name, i + 1) }

pub let find_enum (ctx: TyContext) (name: String): Option[EnumInfo] = find_enum_acc(ctx.enums, name, 0)
let find_enum_acc (enums: Array[EnumInfo]) (name: String) (i: Int): Option[EnumInfo] =
    if i >= enums.len() { None } else if enums[i].name == name { Some(enums[i]) } else { find_enum_acc(enums, name, i + 1) }

// A variant tag's owning enum + declared generics + payload template
// — tags are looked up by bare name alone, no owning-enum qualifier
// needed (mirrors the real compiler's own "variant tags live in one
// flat, global namespace" precedent — DESIGN.md's module-system
// section documents this as a deliberate, pre-existing v1 scope
// boundary, not something specific to this checker).
pub struct VariantLookup { enum_name: String, enum_generics: Array[String], payload: Array[ITy] }

pub let find_variant (ctx: TyContext) (tag: String): Option[VariantLookup] = find_variant_in_enums(ctx.enums, tag, 0)
let find_variant_in_enums (enums: Array[EnumInfo]) (tag: String) (i: Int): Option[VariantLookup] =
    if i >= enums.len() { None }
    else {
        match find_variant_acc(enums[i].variants, tag, 0) {
            Some(v) => Some(VariantLookup { enum_name: enums[i].name, enum_generics: enums[i].generics, payload: v.payload }),
            None => find_variant_in_enums(enums, tag, i + 1),
        }
    }
let find_variant_acc (variants: Array[VariantInfo]) (tag: String) (i: Int): Option[VariantInfo] =
    if i >= variants.len() { None } else if variants[i].tag == tag { Some(variants[i]) } else { find_variant_acc(variants, tag, i + 1) }

// --- AST annotation -> `ITy` ---

pub let resolve_ann (ctx: TyContext) (in_scope: Array[String]) (t: parser.Ty): ITy =
    match t {
        TyFunction(params, ret) => ITFunction(Array.map(params, |p| resolve_ann(ctx, in_scope, p)), resolve_ann(ctx, in_scope, ret)),
        TyGeneric(base, args) => resolve_named(ctx, in_scope, base[base.len() - 1], Array.map(args, |a| resolve_ann(ctx, in_scope, a))),
        TyPath(segments) => resolve_named(ctx, in_scope, segments[segments.len() - 1], []),
        TyTuple(elems) => ITTuple(Array.map(elems, |e| resolve_ann(ctx, in_scope, e))),
    }

let resolve_named (ctx: TyContext) (in_scope: Array[String]) (name: String) (args: Array[ITy]): ITy =
    if name == "Int" { ITInt }
    else if name == "Float" { ITFloat }
    else if name == "Bool" { ITBool }
    else if name == "String" { ITStr }
    else if name == "Unit" { ITUnit }
    else if name == "Array" { ITStruct("Array", args) }
    else if Array.contains(in_scope, name) { ITParam(name) }
    else if Option.is_some(find_struct(ctx, name)) { ITStruct(name, args) }
    else if Option.is_some(find_enum(ctx, name)) { ITEnum(name, args) }
    else { { fail_ctx("unknown type: ".concat(name)); ITUnit } }

// --- Instantiating a declaration's template at a concrete use site ---

// Substitutes every `ITParam(name)` in `template` for the matching
// entry of `args` (positional, same order as `generics`) — the fixed-
// arity, explicit-declaration-driven counterpart to a polymorphic
// function's `Scheme` instantiation (see `infer.plum`'s own doc
// comment on why this checker needs no `Scheme`/`generalize` machinery
// at all: Plum's generics are always explicitly declared, never
// inferred from usage).
pub let instantiate_template (generics: Array[String]) (args: Array[ITy]) (template: ITy): ITy =
    match template {
        ITParam(name) => Option.unwrap_or(lookup_generic_arg(generics, args, name, 0), template),
        ITFunction(params, ret) => ITFunction(Array.map(params, |p| instantiate_template(generics, args, p)), instantiate_template(generics, args, ret)),
        ITTuple(elems) => ITTuple(Array.map(elems, |e| instantiate_template(generics, args, e))),
        ITStruct(name, sargs) => ITStruct(name, Array.map(sargs, |a| instantiate_template(generics, args, a))),
        ITEnum(name, sargs) => ITEnum(name, Array.map(sargs, |a| instantiate_template(generics, args, a))),
        _ => template,
    }

let lookup_generic_arg (generics: Array[String]) (args: Array[ITy]) (name: String) (i: Int): Option[ITy] =
    if i >= generics.len() { None } else if generics[i] == name { Some(args[i]) } else { lookup_generic_arg(generics, args, name, i + 1) }

// --- Layout accessors for the backend ---
//
// `codegen/` needs a struct's field NAMES (for slot order) and a
// struct's/variant's declared field/payload TYPES (to pick a load's
// machine type). Those already live here, fully resolved, so the
// backend reads them rather than re-resolving the annotations — the
// same reason it reads expression types off the typed tree instead of
// synthesizing them. Exposed as functions rather than by making the
// info structs public, so the representation stays private.
pub let ctx_field_names (ctx: TyContext) (name: String): Array[String] =
    match find_struct(ctx, name) {
        Some(info) => Array.map(info.fields, |f| f.name),
        None => { fail_ctx("unknown struct: ".concat(name)); [] },
    }

pub let ctx_field_types (ctx: TyContext) (name: String): Array[ITy] =
    match find_struct(ctx, name) {
        Some(info) => Array.map(info.fields, |f| f.ty),
        None => { fail_ctx("unknown struct: ".concat(name)); [] },
    }

pub let ctx_variant_payload (ctx: TyContext) (tag: String): Array[ITy] =
    match find_variant(ctx, tag) {
        Some(v) => v.payload,
        None => { fail_ctx("unknown variant: ".concat(tag)); [] },
    }

// The declared type-parameter names of a struct, and of the enum a
// variant belongs to. A backend that leaves generic AGGREGATES
// unspecialized (correct when every field occupies a uniform slot)
// still needs these to instantiate a field or payload TEMPLATE against
// the type arguments at a particular use site.
pub let ctx_struct_generics (ctx: TyContext) (name: String): Array[String] =
    match find_struct(ctx, name) {
        Some(info) => info.generics,
        None => { fail_ctx("unknown struct: ".concat(name)); [] },
    }

pub let ctx_variant_generics (ctx: TyContext) (tag: String): Array[String] =
    match find_variant(ctx, tag) {
        Some(v) => v.enum_generics,
        None => { fail_ctx("unknown variant: ".concat(tag)); [] },
    }

// Every variant tag of an enum, in declaration order — what
// exhaustiveness checking needs to know what a `match` has to cover.
// `None` for an unknown name, which is not an error here: the caller
// only asks about a scrutinee whose type already resolved to an enum.
pub let ctx_enum_tags (ctx: TyContext) (name: String): Option[Array[String]] =
    match find_enum(ctx, name) {
        Some(info) => Some(Array.map(info.variants, |v| v.tag)),
        None => None,
    }
