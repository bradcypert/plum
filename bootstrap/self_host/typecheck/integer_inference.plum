// Contextual inference specializes literals and seeds closure parameters.
// Looking up a bound value preserves its recorded type without inserting casts.
use parser;

let has_fixed_ty (ty: ITy): Bool = match ty {
    ITInteger(_) => true,
    ITRawPtr(_) => true,
    ITStruct(_, args) => Array.any(args, has_fixed_ty),
    ITEnum(_, args) => Array.any(args, has_fixed_ty),
    ITTuple(args) => Array.any(args, has_fixed_ty),
    ITFunction(args, ret) => has_fixed_ty(ret) || Array.any(args, has_fixed_ty),
    ITRef(inner) => has_fixed_ty(inner),
    _ => false,
}

let infer_expected
    (p2: Program2)
    (state: FreshState)
    (env: TyEnv)
    (acc: Subst)
    (e: parser.PExpr)
    (expected0: ITy): InferResult
= {
    let expected = subst_apply(acc, expected0);
    if !has_fixed_ty(expected) { infer_expr(p2, state, env, acc, e) }
    else {
        match e {
            EInt(text, offset) => match expected {
                ITInteger(k) => infer_integer_literal(k, text, offset, acc, state),
                _ => infer_expr(p2, state, env, acc, e),
            },
            EUnary(UNeg, EInt(text, offset)) => match expected {
                ITInteger(k) => infer_integer_literal(k, "-".concat(text), offset, acc, state),
                _ => infer_expr(p2, state, env, acc, e),
            },
            EUnary(UNeg, inner) => match expected {
                ITInteger(k) => {
                    if !integer_spec(k).signed {
                        fail_tc("unsigned integer negation is not supported");
                    };
                    let r = infer_expected(p2, state, env, acc, inner, expected);
                    let checked = constrain_operand(r.subst, r.ty, expected, "negation: ");
                    ir_leaf(expected, checked, r.state, TUnary(UNeg, r.texpr))
                },
                _ => infer_expr(p2, state, env, acc, e),
            },
            EUnary(UBitNot, inner) => if Option.is_some(integer_kind(expected)) {
                let r = infer_expected(p2, state, env, acc, inner, expected);
                let s = constrain_operand(r.subst, r.ty, expected, "bitwise complement: ");
                ir_leaf(expected, s, r.state, TUnary(UBitNot, r.texpr))
            } else { infer_expr(p2, state, env, acc, e) },
            EUnsafe(block) => {
                let was = UNSAFE.get();
                UNSAFE.set(true);
                let r = infer_expected_block(p2, state, env, acc, block, expected);
                UNSAFE.set(was);
                r
            },
            EBinary(BPipe, lhs, rhs) => infer_expected(
                p2,
                state,
                env,
                acc,
                parser.desugar_pipe(lhs, rhs),
                expected
            ),
            EBinary(op, lhs, rhs) => if integer_value_operator(op)
                && Option.is_some(integer_kind(expected)) {
                    infer_binary_expected(p2, state, env, acc, op, lhs, rhs, Some(expected))
                } else { infer_expr(p2, state, env, acc, e) },
            EBlock(block) => infer_expected_block(p2, state, env, acc, block, expected),
            EIf(cond, yes, no) => infer_if_expected(
                p2,
                state,
                env,
                acc,
                cond,
                yes,
                no,
                Some(expected)
            ),
            EMatch(value, arms, _) => infer_match_expected(
                p2,
                state,
                env,
                acc,
                value,
                arms,
                Some(expected)
            ),
            EArray(elems) => match expected {
                ITStruct("Array", args) => {
                    let r = infer_call_args(
                        p2,
                        state,
                        env,
                        acc,
                        elems,
                        Array.map(elems, |elem| args[0]),
                        0,
                        []
                    );
                    ir_leaf(expected, r.subst, r.state, TArrayLit(r.texprs))
                },
                _ => infer_expr(p2, state, env, acc, e),
            },
            ETuple(elems) => match expected {
                ITTuple(tys) => if tys.len() == elems.len() {
                    let r = infer_call_args(p2, state, env, acc, elems, tys, 0, []);
                    ir_leaf(expected, r.subst, r.state, TTupleLit(r.texprs))
                } else { infer_expr(p2, state, env, acc, e) },
                _ => infer_expr(p2, state, env, acc, e),
            },
            EClosure(params, body) => match expected {
                ITFunction(ptys, ret) => {
                    if params.len() != ptys.len() {
                        fail_tc("closure expects a different number of parameters here");
                    };
                    let env2 = extend_closure_params(env, params, ptys, 0);
                    let r = infer_expected(p2, state, env2, acc, body, ret);
                    let s = constrain_operand(r.subst, r.ty, ret, "closure result: ");
                    ir_leaf(subst_apply(s, expected), s, r.state, TClosure(params, r.texpr))
                },
                _ => infer_expr(p2, state, env, acc, e),
            },
            ECall(callee, args) => {
                let path = err_path(());
                let r = infer_call_expected(p2, state, env, acc, callee, args, Some(expected));
                if REFERENCES_ON.get() {
                    note_expression_reference(p2, path, env, e, r.texpr);
                };
                r
            },
            EStructLit(path, fields, spread) => infer_struct_lit_expected(
                p2,
                state,
                env,
                acc,
                path,
                fields,
                spread,
                Some(expected)
            ),
            _ => infer_expr(p2, state, env, acc, e),
        }
    }
}

let infer_expected_block
    (p2: Program2)
    (state: FreshState)
    (env: TyEnv)
    (acc: Subst)
    (block: parser.PBlock)
    (expected: ITy): InferResult
= {
    let r = infer_stmts(p2, state, env, acc, block.stmts, 0, [], block.starts);
    match block.tail {
        Some(t) => {
            set_stmt_pos(block_start_at(block.starts, block.stmts.len()));
            let tr = infer_expected(p2, r.state, r.env, r.subst, t, expected);
            ir_leaf(tr.ty, tr.subst, tr.state, TBlockE(TBlock {
                stmts: r.tstmts,
                tail: Some(tr.texpr),
                starts: block.starts
            }))
        },
        None => ir_leaf(ITUnit, r.subst, r.state, TBlockE(TBlock {
            stmts: r.tstmts,
            tail: None,
            starts: block.starts
        })),
    }
}

let infer_optional_expected
    (p2: Program2)
    (state: FreshState)
    (env: TyEnv)
    (acc: Subst)
    (e: parser.PExpr)
    (expected: Option[ITy]): InferResult
=
    match expected {
        Some(t) => infer_expected(p2, state, env, acc, e, t),
        None => infer_expr(p2, state, env, acc, e)
    }

let integer_arithmetic (op: parser.BOp): Bool = match op {
    BAdd => true,
    BSub => true,
    BMul => true,
    BDiv => true,
    BRem => true,
    _ => false,
}

let integer_shift (op: parser.BOp): Bool = match op {
    BShl => true,
    BShr => true,
    _ => false
}

let integer_value_operator (op: parser.BOp): Bool = integer_arithmetic(op) || is_bitwise(op)

// Shift counts have their own type, independent of the value's width. In
// particular an Int count must never contextualize or widen the left value.
let infer_integer_shift
    (p2: Program2)
    (state: FreshState)
    (env: TyEnv)
    (acc: Subst)
    (op: parser.BOp)
    (lhs: parser.PExpr)
    (rhs: parser.PExpr)
    (expected: Option[ITy]): InferResult
= {
    let left = infer_optional_expected(p2, state, env, acc, lhs, expected);
    let seeded = seed_expected_result(left.subst, left.ty, expected);
    let right = infer_expected(p2, left.state, env, seeded, rhs, ITInt);
    let s = constrain_operand(right.subst, right.ty, ITInt, "shift count must be Int: ");
    let ty = subst_apply(s, left.ty);
    reject_non_int_bitwise(op, ty);
    ir_leaf(ty, s, right.state, TBinary(op, left.texpr, right.texpr))
}

let integer_literal_expression (e: parser.PExpr): Bool = match e {
    EInt(_, _) => true,
    EUnary(UNeg, inner) => integer_literal_expression(inner),
    EUnary(UBitNot, inner) => integer_literal_expression(inner),
    EBinary(op, lhs, rhs) => integer_value_operator(op) && integer_literal_expression(lhs)
        && integer_literal_expression(rhs),
    _ => false,
}

struct IntegerOperands { left: InferResult, right: InferResult }

let infer_integer_operands
    (p2: Program2)
    (state: FreshState)
    (env: TyEnv)
    (acc: Subst)
    (lhs: parser.PExpr)
    (rhs: parser.PExpr)
    (expected: Option[ITy]): IntegerOperands
=
    if integer_literal_expression(lhs) && !integer_literal_expression(rhs)
        && Option.is_none(expected) {
            // Only inference order changes; TBinary retains source evaluation
            // order. Never re-infer either operand or duplicate its references.
            let right = infer_expr(p2, state, env, acc, rhs);
            let left = infer_expected(p2, right.state, env, right.subst, lhs, right.ty);
            IntegerOperands {
                left: left,
                right: InferResult {
                    subst: left.subst,
                    state: left.state,
                    ..right
                }
            }
        } else {
            let left = infer_optional_expected(p2, state, env, acc, lhs, expected);
            let seeded = seed_expected_result(left.subst, left.ty, expected);
            let right = infer_expected(p2, left.state, env, seeded, rhs, left.ty);
            IntegerOperands { left: left, right: right }
        }

let seed_expected_result (acc: Subst) (actual: ITy) (expected: Option[ITy]): Subst =
    match expected {
        Some(want) => constrain_operand(acc, actual, want, "expected result: "),
        None => acc,
    }

let infer_global_initializer
    (p2: Program2)
    (state: FreshState)
    (acc: Subst)
    (def: parser.LetDefNode): InferResult
= {
    let r = match def.ret_ty {
        Some(ann) => infer_expected(
            p2,
            state,
            tyenv_empty(()),
            acc,
            def.body,
            resolve_ann_seen(p2.ctx, p2.current, [], ann)
        ),
        None => infer_expr(p2, state, tyenv_empty(()), acc, def.body),
    };
    // Retain the annotation's constraints before resolving ambiguous shifts.
    // A mismatch is reported by the existing global declaration checks.
    let checked = match def.ret_ty {
        Some(ann) => match unify(
            subst_apply(r.subst, r.ty),
            resolve_ann_seen(p2.ctx, p2.current, [], ann)
        ) {
            Ok(s) => subst_compose(s, r.subst),
            Err(_) => r.subst,
        },
        None => r.subst,
    };
    let s = resolve_integer_shifts(checked, r.texpr);
    InferResult {
        ty: subst_apply(s, r.ty),
        subst: s,
        ..r
    }
}

let infer_variant_call_expected
    (p2: Program2)
    (state: FreshState)
    (env: TyEnv)
    (acc: Subst)
    (tag: String)
    (args: Array[parser.PExpr])
    (v: VariantLookup)
    (expected: Option[ITy]): InferResult
= {
    check_enum_named(p2.ctx, p2.current, v.enum_name);
    let fr = fresh_list(state, v.enum_generics.len());
    let ret = ITEnum(v.enum_name, fr.tys);
    let seeded = seed_expected_result(acc, ret, expected);
    let payload = Array.map(v.payload, |t| instantiate_template(v.enum_generics, fr.tys, t));
    if payload.len() != args.len() {
        fail_tc("variant expects a different number of arguments");
    };
    let ar = infer_call_args(p2, fr.state, env, seeded, args, payload, 0, []);
    ir_leaf(
        subst_apply(ar.subst, ret),
        ar.subst,
        ar.state,
        TVariantNew(v.enum_name, tag, ar.texprs)
    )
}

let first_restricted_c_type (ctx: TyContext) (t: ITy) (seen: Array[String]): Option[ITy] =
    match t {
        ITInteger(_) => Some(t),
        ITRawPtr(_) => Some(t),
        ITFunction(params, ret) => first_restricted_c_type_in_list(ctx, params.push(ret), seen, 0),
        ITStruct(name, args) =>
            {
                // Arguments are finite type syntax. Only expansion of a
                // declaration's fields needs the nominal recursion guard.
                let inner = first_restricted_c_type_in_list(ctx, args, seen, 0);
                if Option.is_some(inner) { inner }
                else if Array.contains(seen, name) { None }
                else {
                    match find_struct(ctx, name) {
                        None => None,
                        Some(_) => first_restricted_c_type_in_list(
                            ctx,
                            Array.map(
                                ctx_field_types(ctx, name),
                                |ft| instantiate_template(
                                    ctx_struct_generics(ctx, name),
                                    args,
                                    ft
                                )
                            ),
                            seen.push(name),
                            0
                        ),
                    }
                }
            },
        ITEnum(name, args) => {
            let inner = first_restricted_c_type_in_list(ctx, args, seen, 0);
            if Option.is_some(inner) { inner }
            else if Array.contains(seen, name) { None }
            else {
                match ctx_enum_tags(ctx, name) {
                    Some(tags) => first_restricted_c_type_in_variants(
                        ctx,
                        name,
                        tags,
                        args,
                        seen.push(name),
                        0
                    ),
                    None => None,
                }
            }
        },
        ITTuple(elems) => first_restricted_c_type_in_list(ctx, elems, seen, 0),
        ITRef(inner) => first_restricted_c_type(ctx, inner, seen),
        _ => None,
    }

let first_restricted_c_type_in_list
    (ctx: TyContext)
    (ts: Array[ITy])
    (seen: Array[String])
    (i: Int): Option[ITy]
=
    if i >= ts.len() { None }
    else {
        match first_restricted_c_type(ctx, ts[i], seen) {
            Some(x) => Some(x),
            None => first_restricted_c_type_in_list(ctx, ts, seen, i + 1)
        }
    }

let first_restricted_c_type_in_variants
    (ctx: TyContext)
    (enum_name: String)
    (tags: Array[String])
    (args: Array[ITy])
    (seen: Array[String])
    (i: Int): Option[ITy]
=
    if i >= tags.len() { None }
    else {
        let payload = Array.map(
            ctx_variant_payload(ctx, enum_name, tags[i]),
            |pt| instantiate_template(ctx_variant_generics(ctx, enum_name, tags[i]), args, pt)
        );
        match first_restricted_c_type_in_list(ctx, payload, seen, 0) {
            Some(f) => Some(f),
            None => first_restricted_c_type_in_variants(ctx, enum_name, tags, args, seen, i + 1),
        }
    }

let integer_array_anchor (elems: Array[parser.PExpr]) (i: Int): Int =
    if i >= elems.len() { 0 }
    else if !integer_literal_expression(elems[i]) { i }
    else { integer_array_anchor(elems, i + 1) }

let infer_integer_array_elems
    (p2: Program2)
    (state: FreshState)
    (env: TyEnv)
    (acc: Subst)
    (elems: Array[parser.PExpr])
    (anchor: Int)
    (seed: InferResult)
    (i: Int)
    (texprs: Array[TExpr]): CallArgsResult
=
    if i >= elems.len() {
        CallArgsResult {
            subst: acc,
            state: state,
            texprs: texprs
        }
    }
    else {
        let r = if i == anchor {
            InferResult {
                subst: acc,
                state: state,
                ..seed
            }
        }
        else { infer_expected(p2, state, env, acc, elems[i], seed.ty) };
        let s = constrain_operand(r.subst, r.ty, seed.ty, "array element: ");
        infer_integer_array_elems(
            p2,
            r.state,
            env,
            s,
            elems,
            anchor,
            seed,
            i + 1,
            texprs.push(r.texpr)
        )
    }

// An immediately called closure has no stored type yet. Seed its result (or
// residual function for a partial call) before its body defaults literals.
let infer_inline_callee
    (p2: Program2)
    (state: FreshState)
    (env: TyEnv)
    (acc: Subst)
    (callee: parser.PExpr)
    (arity: Int)
    (supplied: Int)
    (expected: Option[ITy]): InferResult
=
    match expected {
        None => infer_expr(p2, state, env, acc, callee),
        Some(want) => {
            let params = fresh_list(state, arity);
            let result = fresh(params.state);
            let call_result = if supplied > 0 && supplied < arity {
                ITFunction(Array.slice(params.tys, supplied, arity), result.ty)
            } else { result.ty };
            let seeded = seed_expected_result(acc, call_result, Some(want));
            infer_expected(p2, result.state, env, seeded, callee, ITFunction(params.tys, result.ty))
        },
    }

let check_integer_negation (subst: Subst) (operand: ITy): Unit =
    match subst_apply(subst, operand) {
        ITInteger(k) => if !integer_spec(k).signed {
            fail_tc("unsigned integer negation is not supported");
        },
        ITRawPtr(k) => reject_raw_pointer_arithmetic(ITRawPtr(k)),
        _ => (),
    }

// Delay the Int fallback until the whole body and its result annotation have
// contributed constraints. A later use of a closure parameter can still pin
// its width after the shift expression; only truly ambiguous operands default.
let resolve_integer_shifts (subst: Subst) (expr: TExpr): Subst = {
    let here = match expr.node {
        TBinary(op, left, _) => if integer_shift(op) {
            match subst_apply(subst, left.ty) {
                ITVar(_) => constrain_operand(subst, left.ty, ITInt, "shift operand: "),
                _ => subst,
            }
        } else { subst },
        _ => subst,
    };
    Array.fold(t_children(expr), here, |s, child| resolve_integer_shifts(s, child))
}

// Local closure parameters may still be variables at the first negation check.
// Validate again against the completed body's substitution, before lowering.
let validate_integer_negations (subst: Subst) (expr: TExpr): Unit = {
    match expr.node {
        TUnary(UNeg, operand) => check_integer_negation(subst, operand.ty),
        TBinary(op, left, _) => reject_non_int_bitwise(op, subst_apply(subst, left.ty)),
        _ => (),
    };
    for child in t_children(expr) {
        validate_integer_negations(subst, child);
    };
}
