// Integer ranges are properties of the language's value types, independent
// of their eventual storage layout. Int and I64 share the same kind.
// ITInt remains the canonical representation of Int/I64; ITInteger carries
// the other seven kinds through inference, specialization and lowering.
pub enum IntegerKind { IntegerI8, IntegerI16, IntegerI32, IntegerI64, IntegerU8, IntegerU16, IntegerU32, IntegerU64 }

pub struct IntegerSpec { pub bits: Int, pub signed: Bool, pub max: String, pub min_magnitude: String }

pub let integer_spec (kind: IntegerKind): IntegerSpec = match kind {
    IntegerI8 => IntegerSpec { bits: 8, signed: true, max: "127", min_magnitude: "128" },
    IntegerI16 => IntegerSpec { bits: 16, signed: true, max: "32767", min_magnitude: "32768" },
    IntegerI32 => IntegerSpec { bits: 32, signed: true, max: "2147483647", min_magnitude: "2147483648" },
    IntegerI64 => IntegerSpec { bits: 64, signed: true, max: "9223372036854775807", min_magnitude: "9223372036854775808" },
    IntegerU8 => IntegerSpec { bits: 8, signed: false, max: "255", min_magnitude: "0" },
    IntegerU16 => IntegerSpec { bits: 16, signed: false, max: "65535", min_magnitude: "0" },
    IntegerU32 => IntegerSpec { bits: 32, signed: false, max: "4294967295", min_magnitude: "0" },
    IntegerU64 => IntegerSpec { bits: 64, signed: false, max: "18446744073709551615", min_magnitude: "0" },
}

// Input is canonical decimal text from the lexer/pattern parser: optional
// minus, then ASCII digits without leading zeroes. Validate that invariant
// here as well, so malformed input cannot accidentally pass a length check.
// Range comparison happens BEFORE any signed parsing or wrapping arithmetic.
let integer_literal_bits (kind: IntegerKind) (text: String): Option[Int] = {
    let bytes = text.as_bytes();
    let negative = bytes.len() > 0 && bytes_at_raw(bytes, 0) == 45;
    let start = if negative { 1 } else { 0 };
    if bytes.len() <= start { None }
    else if bytes.len() > start + 1 && bytes_at_raw(bytes, start) == 48 { None }
    else {
        let mut valid = true;
        for i in start..bytes.len() {
            if bytes_at_raw(bytes, i) < 48 || bytes_at_raw(bytes, i) > 57 { valid = false; };
        };
        let spec = integer_spec(kind);
        let magnitude = if negative { String.slice(text, 1, text.len()) } else { text };
        let limit = if negative { spec.min_magnitude } else { spec.max };
        if !valid || (negative && !spec.signed) || !integer_magnitude_le(magnitude, limit) { None }
        else {
            // TInt carries this raw word together with its inferred integer
            // type, without a signed conversion of its mathematical value.
            // Wrapping only happens after the mathematical range check.
            let mut bits = 0;
            for i in start..bytes.len() {
                bits = Int.wrapping_add(Int.wrapping_mul(bits, 10), bytes_at_raw(bytes, i) - 48);
            };
            Some(if negative { Int.wrapping_sub(0, bits) } else { bits })
        }
    }
}

let integer_magnitude_le (value: String) (limit: String): Bool =
    value.len() < limit.len() || (value.len() == limit.len() && value <= limit)

pub let test_integer_literal_ranges (): Unit = {
    // Keep compiler sources buildable by the checked-in bootstrap seed,
    // which predates direct signed-minimum literal support.
    let int_min = -9223372036854775807 - 1;
    let kinds = [IntegerI8, IntegerI16, IntegerI32, IntegerI64, IntegerU8, IntegerU16, IntegerU32, IntegerU64];
    let over_max = ["128", "32768", "2147483648", "9223372036854775808", "256", "65536", "4294967296", "18446744073709551616"];
    let under_min = ["-129", "-32769", "-2147483649", "-9223372036854775809", "-1", "-1", "-1", "-1"];
    let maxima = [127, 32767, 2147483647, 9223372036854775807, 255, 65535, 4294967295, -1];
    let minima = [-128, -32768, -2147483648, int_min, 0, 0, 0, 0];
    let widths = [8, 16, 32, 64, 8, 16, 32, 64];
    for i in 0..kinds.len() {
        let kind = kinds[i];
        let spec = integer_spec(kind);
        assert(Option.is_some(integer_literal_bits(kind, "0")));
        assert_eq(spec.bits, widths[i]);
        assert_eq(integer_literal_bits(kind, spec.max), Some(maxima[i]));
        assert(Option.is_none(integer_literal_bits(kind, over_max[i])));
        assert(Option.is_none(integer_literal_bits(kind, under_min[i])));
        if spec.signed {
            assert_eq(integer_literal_bits(kind, "-".concat(spec.min_magnitude)), Some(minima[i]));
            assert(Option.is_some(integer_literal_bits(kind, "-".concat(spec.max))));
            assert_eq(integer_literal_bits(kind, "-0"), Some(0));
        } else {
            assert(Option.is_none(integer_literal_bits(kind, "-0")));
        };
        for text in ["", "-", "+1", "00", "01", "-01", "1_0", "1.0", " 1", "1 ", "é", "１２", "12a", "a12", "999999999999999999999999999999999999999999999999999999999999999999"] {
            assert(Option.is_none(integer_literal_bits(kind, text)));
        };
    };
    assert_eq(integer_literal_bits(IntegerI64, "-9223372036854775808"), Some(int_min));
    assert_eq(integer_literal_bits(IntegerI64, "9223372036854775807"), Some(9223372036854775807));
    assert_eq(integer_literal_bits(IntegerU64, "9223372036854775808"), Some(int_min));
    assert_eq(integer_literal_bits(IntegerU64, "18446744073709551614"), Some(-2));
    assert_eq(integer_literal_bits(IntegerU64, "18446744073709551615"), Some(-1));
    assert_eq(integer_literal_bits(IntegerU32, "4294967295"), Some(4294967295));
    assert_eq(integer_spec(IntegerI64).bits, 64);
    assert_eq(integer_spec(IntegerU64).bits, 64);
}

pub let test_integer_literal_small_ranges (): Unit = {
    // Exhaust every value in both eight-bit domains, including rejection
    // immediately outside each domain. Expected values use existing Int
    // arithmetic, independently of the decimal accumulation above.
    for value in - 130..258 {
        let text = value.to_string();
        let signed = integer_literal_bits(IntegerI8, text);
        let unsigned = integer_literal_bits(IntegerU8, text);
        if value >= -128 && value <= 127 { assert_eq(signed, Some(value)); }
        else { assert(Option.is_none(signed)); };
        if value >= 0 && value <= 255 { assert_eq(unsigned, Some(value)); }
        else { assert(Option.is_none(unsigned)); };
    };
}

pub let integer_name (kind: IntegerKind): String = match kind {
    IntegerI8 => "I8", IntegerI16 => "I16", IntegerI32 => "I32", IntegerI64 => "Int",
    IntegerU8 => "U8", IntegerU16 => "U16", IntegerU32 => "U32", IntegerU64 => "U64",
}

let integer_named (name: String): Option[ITy] = match name {
    "Int" => Some(ITInt), "I64" => Some(ITInt),
    "I8" => Some(ITInteger(IntegerI8)), "I16" => Some(ITInteger(IntegerI16)), "I32" => Some(ITInteger(IntegerI32)),
    "U8" => Some(ITInteger(IntegerU8)), "U16" => Some(ITInteger(IntegerU16)), "U32" => Some(ITInteger(IntegerU32)), "U64" => Some(ITInteger(IntegerU64)),
    _ => None,
}

let integer_kind (ty: ITy): Option[IntegerKind] = match ty {
    ITInt => Some(IntegerI64), ITInteger(k) => Some(k), _ => None,
}

let infer_integer_literal (kind: IntegerKind) (text: String) (offset: Int) (acc: Subst) (state: FreshState): InferResult = {
    let ty = if kind == IntegerI64 { ITInt } else { ITInteger(kind) };
    let bits = match integer_literal_bits(kind, text) {
        Some(v) => v,
        None => { set_stmt_pos(offset); fail_tc("integer literal out of range: ${text} for ${integer_name(kind)}"); 0 },
    };
    ir_leaf(ty, acc, state, TInt(bits))
}

pub let test_integer_type_identity (): Unit = {
    let kinds = [IntegerI8, IntegerI16, IntegerI32, IntegerU8, IntegerU16, IntegerU32, IntegerU64];
    assert_eq(integer_named("I64"), Some(ITInt));
    assert_eq(integer_named("Int"), Some(ITInt));
    assert_eq(integer_named("types.U8"), None);
    for k in kinds {
        let ty = ITInteger(k);
        assert_eq(integer_named(integer_name(k)), Some(ty));
        assert_eq(render_ty(ty), integer_name(k));
        assert(Result.is_err(unify(ty, ITInt)));
        assert(Result.is_err(unify(ITInt, ty)));
        assert_eq(subst_apply(subst_single(0, ty), ITStruct("Array", [ITVar(0)])), ITStruct("Array", [ty]));
        for other in kinds {
            assert_eq(Result.is_ok(unify(ty, ITInteger(other))), k == other);
        };
    };
}
