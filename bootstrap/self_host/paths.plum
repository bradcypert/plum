use Os;
use treefs;

// Shared logical path handling for source selection and editor snapshots.
let source_absolute (path: String): String =
    if source_has_nul(path.as_bytes()) { panic_raw("NUL in filesystem path"); "" }
    else if Path.is_absolute(path) { Path.clean(path) }
    else { Path.clean(Path.join(Result.unwrap_or(Os.cwd(()), "."), path)) }

// Match components, not byte offsets in case-folded Unicode. Exact matching
// retains native byte paths; the case-insensitive fallback is Windows-only.
let source_relative_option (root: String) (path: String): Option[String] = {
    let base = Path.clean(root);
    let name = Path.clean(path);
    let prefix = lsp_directory_prefix(base);
    if name == base { Some(".") }
    else if name.starts_with(prefix) { Some(treefs.path_slice(name, prefix.len(), name.len())) }
    else if Os.platform() == "windows" {
        let parents = base.replace("\\", "/").split("/");
        let children = name.replace("\\", "/").split("/");
        if source_prefix_matches(parents, children, 0) {
            Some(if parents.len() == children.len() { "." } else { Array.join(Array.slice(children, parents.len(), children.len()), "/") })
        } else { None }
    } else { None }
}

let source_prefix_matches (parents: Array[String]) (children: Array[String]) (i: Int): Bool =
    if i >= parents.len() { true }
    else if i >= children.len() || String.to_lower(parents[i]) != String.to_lower(children[i]) { false }
    else { source_prefix_matches(parents, children, i + 1) }

let source_is_directory (path: String): Bool = match treefs.open_root(path) {
    Ok(_) => true, Err(_) => Result.unwrap_or(Os.is_directory(path), false),
}

let source_has_manifest (path: String): Bool = match treefs.open_root(path) {
    Err(_) => false,
    Ok(root) => match treefs.child_present(root, "plum.pkg") {
        Err(e) => { panic_raw(e); false }, Ok(present) => present,
    },
}

let source_has_nul (bytes: Bytes): Bool = {
    let mut found = false;
    for i in 0..bytes.len() { if bytes.at(i) == Some(0) { found = true; () }; };
    found
}
