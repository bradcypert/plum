#!/usr/bin/env bash
# Is every `.plum` file in the repo already formatted?
#
# `plum fmt` has exactly one opinion: the line a statement or an item
# begins on is indented four spaces per enclosing block. That rule was
# not invented, it was MEASURED -- across this repo indentation is
# already a multiple of four everywhere, with no tabs, no trailing
# whitespace and no missing final newline. The corpus is the style
# guide and this asserts the formatter agrees with it.
#
# Three properties, and the second is the one that makes a formatter
# safe to run on somebody's code:
#
#   1. FIXED POINT -- formatting changes nothing. A file that changes is
#      either misindented or a rule is wrong, and both are worth a look.
#   2. SAME PROGRAM -- the formatted file's TOKEN sequence is identical
#      to the original's, token text by token text. Whitespace and
#      comments are exactly what lies between tokens, so two files whose
#      tokens agree in order differ only in formatting.
#
#      This started as the narrower "only leading whitespace changed",
#      which was true while indentation was the only opinion `fmt` had.
#      Collapsing a run of blank lines is not a leading-whitespace
#      change, so the check had to become the real property rather than
#      a proxy for it.
#   3. IDEMPOTENT -- formatting twice is formatting once. This failed
#      when first checked: a block anchors to the indent of the line its
#      brace is on, so moving an outer construct leaves everything
#      inside anchored to where it used to be. `fmt` iterates to a fixed
#      point for that reason.
#
# Usage:  bootstrap/fmt-check [path-to-plum-binary]   (default: ./sh.real)
set -uo pipefail

root="$(cd "$(dirname "${BASH_SOURCE[0]}")/.." && pwd)"
cd "$root"
plum="${1:-./sh.real}"

work="$(mktemp -d 2>/dev/null || mktemp -d -t plum-fmt)"
trap 'rm -rf "$work"' EXIT

ok=0; fail=0
while IFS= read -r f; do
    if ! "$plum" fmt "$f" > "$work/out" 2>"$work/err"; then
        printf 'FAIL  %-58s fmt errored: %s\n' "$f" "$(head -n 1 "$work/err")"
        fail=$((fail + 1)); continue
    fi

    # 2, checked even when the file is already formatted: a rule that
    # rewrote code would show here rather than in a diff nobody reads.
    #
    # The formatted text is written BESIDE the original, because
    # `@embed_file` resolves relative to the file being compiled.
    side="$(dirname "$f")/.fmt-check-tok-$$.plum"
    cp "$work/out" "$side"
    tok_rc=0
    "$plum" relex "$f" --tokens > "$work/tok-before" 2>"$work/tokerr" || tok_rc=1
    "$plum" relex "$side" --tokens > "$work/tok-after" 2>>"$work/tokerr" || tok_rc=1
    rm -f "$side"
    # A FAILING `relex --tokens` used to read as a pass. Its output went
    # to `> file` with stderr to `/dev/null` and its exit status
    # discarded, so both files came back empty and `cmp -s` happily
    # agreed. Verified by injection: a wrapper where `--tokens` exits 1
    # produced a byte-identical verdict with this property removed
    # entirely.
    if [ $tok_rc -ne 0 ]; then
        printf 'FAIL  %-58s relex --tokens failed: %s\n' "$f" "$(head -n 1 "$work/tokerr")"
        fail=$((fail + 1)); continue
    fi
    if ! cmp -s "$work/tok-before" "$work/tok-after"; then
        printf 'FAIL  %-58s fmt changed the token stream\n' "$f"
        fail=$((fail + 1)); continue
    fi

    if ! cmp -s "$f" "$work/out"; then
        printf 'FAIL  %-58s not formatted\n' "$f"
        diff "$f" "$work/out" | head -n 4 | sed 's/^/        /'
        fail=$((fail + 1)); continue
    fi

    # The second pass runs BESIDE the original, not in a temp dir:
    # `@embed_file` resolves relative to the file being compiled, so a
    # copy somewhere else cannot find what it embeds. That is a real
    # property of the language and the harness has to respect it.
    twice="$(dirname "$f")/.fmt-check-$$.plum"
    "$plum" fmt "$f" > "$twice" 2>/dev/null
    "$plum" fmt "$twice" > "$work/twice" 2>/dev/null
    same=0; cmp -s "$twice" "$work/twice" || same=1
    rm -f "$twice"
    if [ $same -ne 0 ]; then
        printf 'FAIL  %-58s fmt is not idempotent\n' "$f"
        fail=$((fail + 1)); continue
    fi
    ok=$((ok + 1))
done < <(find . -name '*.plum' -not -path './.git/*' -not -path './bootstrap/fmt_corpus/*' | sort)

# `fmt_corpus` is the other half, and it is what stops this harness from
# passing vacuously. The sweep above proves `fmt` leaves correct code
# alone -- which a formatter that did NOTHING would also pass. These are
# inputs where it has to act, with the answer written down.
for dir in bootstrap/fmt_corpus/*/; do
    name="$(basename "$dir")"
    [ -f "$dir/in.plum" ] || continue
    if ! "$plum" fmt "$dir/in.plum" > "$work/fixed" 2>"$work/err"; then
        printf 'FAIL  %-58s fmt errored: %s\n' "$name" "$(head -n 1 "$work/err")"
        fail=$((fail + 1)); continue
    fi
    if ! cmp -s "$dir/expected.plum" "$work/fixed"; then
        printf 'FAIL  %-58s does not match expected.plum\n' "$name"
        diff "$dir/expected.plum" "$work/fixed" | head -n 6 | sed 's/^/        /'
        fail=$((fail + 1)); continue
    fi

    # SAME PROGRAM, asserted here rather than only in the sweep above.
    #
    # The sweep checks this too, but it cannot fail there: the token
    # comparison runs before the byte comparison, so any file reaching
    # the pass counter is already byte-identical to its formatted form
    # and its token streams agree trivially. Property 2 could only ever
    # fire on a file property 1 was already failing.
    #
    # These fixtures are the only inputs in the repository where `fmt`
    # genuinely REWRITES text, and until now they were checked against
    # `expected.plum` alone. So the property that makes a formatter safe
    # to run on somebody's code was checked on exactly zero inputs where
    # the formatter acts. A rule that ate a trailing comma or a comment
    # would have been caught only by someone noticing `expected.plum`
    # change in review.
    ctok_rc=0
    "$plum" relex "$dir/in.plum" --tokens > "$work/ctok-before" 2>"$work/tokerr" || ctok_rc=1
    cp "$work/fixed" "$dir/.fmt-check-tok-$$.plum"
    "$plum" relex "$dir/.fmt-check-tok-$$.plum" --tokens > "$work/ctok-after" 2>>"$work/tokerr" || ctok_rc=1
    rm -f "$dir/.fmt-check-tok-$$.plum"
    if [ $ctok_rc -ne 0 ]; then
        printf 'FAIL  %-58s relex --tokens failed: %s\n' "$name" "$(head -n 1 "$work/tokerr")"
        fail=$((fail + 1)); continue
    fi
    if ! cmp -s "$work/ctok-before" "$work/ctok-after"; then
        printf 'FAIL  %-58s fmt changed the token stream\n' "$name"
        diff "$work/ctok-before" "$work/ctok-after" | head -n 6 | sed 's/^/        /'
        fail=$((fail + 1)); continue
    fi
    ok=$((ok + 1))
done

if [ "$fail" -ne 0 ]; then
    printf '\nfmt-check: %d file(s) failed, %d already formatted\n' "$fail" "$ok"
    exit 1
fi
printf 'fmt-check: %d checks pass -- every repo file already formatted, and fmt_corpus reformatted as recorded\n' "$ok"
