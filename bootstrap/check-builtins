#!/usr/bin/env python3
"""Every builtin the checker recognizes must be inventoried and shared names tested."""
from collections import defaultdict
from pathlib import Path
import sys
import tempfile

from compiler_metadata import ROOT, check_generated, load
from plum_queries import ast, comparison_names, completion_names, function_body, inventory_names, nodes, query


def inventories(program):
    # Inspect parsed comparisons independently of the completion tables:
    # completion alone cannot reveal a builtin missing from its table.
    methods = comparison_names(program, "method_name")
    functions = comparison_names(function_body(program, "builtin_sig"), "name")
    for claimed, listed, label in [
        (methods, inventory_names(program, "builtin_methods", "BuiltinMethod"), "methods"),
        (functions, inventory_names(program, "builtin_functions", "BuiltinFn"), "functions"),
    ]:
        missing = claimed - listed
        if missing:
            raise ValueError(f"checker accepts builtin {label} missing from the inventory: {', '.join(sorted(missing))}")
    return methods


def shared_methods(names, methods):
    spaces = defaultdict(set)
    for name in names:
        if "." in name:
            namespace, method = name.rsplit(".", 1)
            spaces[method].add(namespace)
    return {name for name, namespaces in spaces.items() if len(namespaces) > 1 and name in methods}


def namespace_path(node):
    if type(node) is str:
        return node
    if isinstance(node, list) and len(node) == 3 and node[0] == "field":
        base = namespace_path(node[1])
        if base is not None:
            return base + "." + node[2]
    return None


def dot_calls(program, namespaces):
    # A field callee can also be Ns.method(...). Exclude the namespaces
    # reported by completion so they cannot stand in for receiver coverage.
    return {node[1][-1] for node in nodes(program)
            if len(node) >= 2 and node[0] == "call" and isinstance(node[1], list)
            and len(node[1]) == 3 and node[1][0] == "field"
            and namespace_path(node[1][1]) not in namespaces}


def main():
    compiler = sys.argv[1] if len(sys.argv) > 1 else "./sh"
    if "/" in compiler or "\\" in compiler:
        compiler = (ROOT / compiler).resolve()
    data = load()
    check_generated(data)
    methods = inventories(ast(compiler, ROOT / "bootstrap/self_host/typecheck/infer.plum"))
    with tempfile.TemporaryDirectory(prefix="plum-builtins-") as work:
        Path(work, "main.plum").write_text(
            "".join(f"use {m};\n" for m in data["stdlib_modules"]) + 'let main (): Unit = println("x")\n',
            encoding="utf-8",
        )
        names = completion_names(query(compiler, "complete", work))
    absent = set(data["stdlib_modules"]) - {name.split(".")[0] for name in names if "." in name}
    if absent:
        raise ValueError(f"completion offered nothing for: {', '.join(sorted(absent))}")
    shared = shared_methods(names, methods)
    if not shared:
        raise ValueError("no shared builtin names found -- nothing was checked")
    namespaces = {name.rsplit(".", 1)[0] for name in names if "." in name}
    missing = shared - dot_calls(ast(compiler, ROOT / "bootstrap/exec_corpus/dot_methods/main.plum"), namespaces)
    if missing:
        raise ValueError(f"shared builtin names missing dot-call coverage: {', '.join(sorted(missing))}")
    print(f"check-builtins: {len(methods)} builtin methods inventoried; {len(shared)} shared names exercised")


if __name__ == "__main__":
    try:
        main()
    except (OSError, ValueError) as error:
        sys.exit(f"check-builtins: {error}")
