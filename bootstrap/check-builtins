#!/usr/bin/env bash
# Every method the CHECKER recognises is offered by COMPLETION.
#
# `infer_method_call` recognises builtin methods as a chain of name
# comparisons -- each needs its own unification and its own IR node, so
# there is no signature table to look up. Completion cannot read a chain
# of `if`s, and it was reading the prelude's SOURCE instead: everything
# written in Plum appeared, everything the compiler implements itself
# did not.
#
# The result was an editor that offered twenty-three methods on an array
# and not `map`, `filter`, `fold`, `len` or `push` -- the five a person
# reaches for first. There WAS a hand-written list of builtins for
# completion; it had seven entries, none of those five, and it fed only
# the `Array.` path and not the `xs.` one.
#
# `typecheck.builtin_methods()` is that list, moved next to the chain it
# has to agree with. This is what stops it drifting again: the chain is
# the authority, and a name it matches that the table does not carry is
# a failure. A hand-kept list is only safe when something checks it.
set -uo pipefail

root="$(cd "$(dirname "${BASH_SOURCE[0]}")/.." && pwd)"
cd "$root"

infer=bootstrap/self_host/typecheck/infer.plum

# Names the checker matches on, and names the table declares. The table
# is read from `name:` fields inside the `builtin_methods` literal.
chain="$(grep -o 'method_name == "[a-z_]*"' "$infer" | sed 's/.*"\(.*\)"/\1/' | sort -u)"
table="$(sed -n '/pub let builtin_methods /,/^]/p' "$infer" | grep -o 'name: "[a-z_]*"' | sed 's/.*"\(.*\)"/\1/' | sort -u)"

if [ -z "$chain" ] || [ -z "$table" ]; then
    echo "check-builtins: found no names -- has infer.plum's shape changed?" >&2
    exit 1
fi

missing="$(comm -23 <(printf '%s\n' "$chain") <(printf '%s\n' "$table"))"

if [ -n "$missing" ]; then
    echo "check-builtins: the checker accepts these methods and completion does not offer them:" >&2
    printf '  %s\n' $missing >&2
    echo "add them to \`builtin_methods\` in $infer" >&2
    exit 1
fi

# --- and every SHARED name is exercised as a dot call ---
#
# A builtin arm matches on NAME before the receiver is known, so a name
# that another type also declares must hand back what it does not own.
# `contains` was fixed for that; `len`, `concat` and `remove` were not,
# and `m.len()` on a Map reported "Map[String, Int] != Array[T0]" until
# 2026-08-31.
#
# The names at risk are exactly those a builtin shares with a declared
# function, and they are derivable: `plum complete` lists every declared
# `Ns.name`. Each one has to appear as a dot call in the fixture, so a
# new builtin that shadows something cannot ship untested.
plum="${1:-./sh}"
fixture=bootstrap/exec_corpus/dot_methods/main.plum
work="$(mktemp -d)"
trap 'rm -rf "$work"' EXIT
printf 'use Os;\nuse Time;\nuse Net;\nuse Http;\nlet main (): Unit = println("x")\n' > "$work/main.plum"

if "$plum" complete "$work" > "$work/names.json" 2>/dev/null; then
    # Distinct `Ns.name` pairs FIRST -- completion lists a builtin and a
    # prelude declaration of the same name separately, and counting those
    # as two namespaces would flag every String primitive.
    shared="$(grep -o '"name":"[A-Z][A-Za-z0-9_]*\.[a-z_][A-Za-z0-9_]*"' "$work/names.json" \
        | sed 's/"name":"//;s/"$//' | sort -u \
        | sed 's/^[A-Za-z0-9_]*\.//' | sort | uniq -d)"
    untested=""
    for m in $shared; do
        printf '%s\n' "$chain" | grep -qx "$m" || continue
        grep -q "\.$m(" "$fixture" || untested="$untested $m"
    done
    if [ -n "$untested" ]; then
        echo "check-builtins: these builtin methods share a name with a declared function" >&2
        echo "and are not exercised as a dot call in $fixture:" >&2
        printf '  %s\n' $untested >&2
        exit 1
    fi
else
    echo "check-builtins: \`plum complete\` failed; skipping the shared-name half" >&2
fi

printf 'check-builtins: %d builtin methods, every one offered by completion and every shared name exercised\n' "$(printf '%s\n' "$chain" | wc -l | tr -d ' ')"
