// Statement indentation at every depth, and the closing braces with it.
//
// A `}` sits one level OUT from the statements it closes, which is
// known exactly rather than guessed: `PBlock` records where its own
// braces are, so the brace's indent is the statement indent minus four.
//
// The MATCH ARMS here are already where they belong, deliberately. An
// arm is not a statement and not a block, so nothing gives it a span,
// and `fmt` leaves it alone rather than guess. See fmt.plum's note.
enum Shape { Dot, Line(Int) }

let describe (s: Shape) (n: Int): Int = {
    let total = match s {
        Dot => 0,
        Line(k) => {
            let doubled = k * 2;
            doubled + n
        },
    };
    if total > 10 {
        total
    } else {
        for i in 0..n {
            let step = i + total;
            println(step.to_string());
        };
        total + 1
    }
}
