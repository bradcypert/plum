// `for x in xs` over an ARRAY, as opposed to a range. The self-hosted
// checker accepted only `lo..hi` until this landed -- found while
// mirroring the Map prelude, which iterates buckets, but it is ordinary
// Plum that any program might write.
//
// Covers the ownership case that matters: iterating an array of HEAP
// elements, and keeping one past the end of its iteration.

struct P { name: String, n: Int }

let total (xs: Array[Int]): Int = {
    let mut acc = 0;
    for x in xs { acc = acc + x; };
    acc
}

let names (ps: Array[P]): Array[String] = {
    let mut out = [];
    for p in ps { out = out.push(p.name); };
    out
}

let nested (rows: Array[Array[Int]]): Int = {
    let mut acc = 0;
    for row in rows { for cell in row { acc = acc + cell; }; };
    acc
}

let main (): Unit = {
    println(total([1, 2, 3]).to_string());
    println(names([P { name: "a", n: 1 }, P { name: "b", n: 2 }]).to_string());
    println(nested([[1, 2], [3], []]).to_string());
    println(total([]).to_string());
}
