use Encoding;
// Frozen pre-optimization decoder: compatibility oracle for diagnostics and precedence.
let oracle_at (b: Bytes) (i: Int): Int = b.at(i).unwrap_or(0)
let oracle_value (c: Int): Int =
    if c >= 65 && c <= 90 { c - 65 }
    else if c >= 97 && c <= 122 { c - 97 + 26 }
    else if c >= 48 && c <= 57 { c - 48 + 52 }
    else if c == 43 || c == 45 { 62 }
    else if c == 47 || c == 95 { 63 }
    else { 0 - 1 }

// Six-bit values, stopping only at a valid optional padding suffix.
let oracle_vals (b: Bytes) (i: Int) (n: Int) (acc: Array[Int]): Result[Array[Int], String] =
    if i >= n { Ok(acc) }
    else {
        let c = oracle_at(b, i);
        if c == 61 {
            let pad = n - i;
            let valid = n % 4 == 0 && ((pad == 1 && i % 4 == 3)
                || (pad == 2 && i % 4 == 2 && oracle_at(b, i + 1) == 61));
            if !valid {
                Err("Encoding.base64_decode: invalid padding")
            } else { Ok(acc) }
        }
        else {
            let v = oracle_value(c);
            if v < 0 { Err("Encoding.base64_decode: invalid character at byte ".concat(i.to_string())) }
            else { oracle_vals(b, i + 1, n, acc.push(v)) }
        }
    }

/// Four 6-bit values make three bytes. A tail of three makes two, a
/// tail of two makes one, and a tail of ONE is impossible: six bits
/// cannot encode a byte, so that input was truncated.
let oracle_bytes (vals: Array[Int]) (i: Int) (n: Int) (acc: Array[Int]): Result[Array[Int], String] =
    if i >= n { Ok(acc) }
    else {
        let rem = n - i;
        let nonzero_pad_bits = (rem == 2 && vals[i + 1] % 16 != 0)
            || (rem == 3 && vals[i + 2] % 4 != 0);
        if rem == 1 { Err("Encoding.base64_decode: truncated input") }
        else if nonzero_pad_bits {
            Err("Encoding.base64_decode: nonzero pad bits")
        }
        else {
            let v0 = vals[i];
            let v1 = vals[i + 1];
            let with1 = acc.push(v0 * 4 + v1 / 16);
            let with2 = if rem > 2 { with1.push((v1 % 16) * 16 + vals[i + 2] / 4) } else { with1 };
            let with3 = if rem > 3 { with2.push((vals[i + 2] % 4) * 64 + vals[i + 3]) } else { with2 };
            oracle_bytes(vals, i + 4, n, with3)
        }
    }

/// Decodes base64 to bytes, accepting EITHER alphabet and treating
/// padding as optional.
///
/// Deliberately lenient, and worth knowing rather than discovering: a
/// strict pair would reject a URL-safe token handed to the standard
/// decoder, which is the most common way this call is written wrong,
/// and rejecting it buys nothing; the two alphabets do not overlap,
/// so no input has two readings.
///
/// Returns `Err` for unrecognised characters, impossible lengths,
/// malformed padding, or nonzero unused tail bits. If present, padding
/// must be a suffix of one or two `=` characters completing a group
/// of four. Unused tail bits must be zero, with or without padding.
let oracle_decode (s: String): Result[Bytes, String] = {
    let b = s.as_bytes();
    match oracle_vals(b, 0, b.len(), []) {
        Err(e) => Err(e),
        Ok(vals) => Result.map(oracle_bytes(vals, 0, vals.len(), []), |out| Bytes.from_array(out)),
    }
}

let describe (r: Result[Bytes, String]): String = match r {
    Ok(b) => "ok:".concat(b.to_hex()),
    Err(e) => "err:".concat(e),
}
let compare (text: String): Unit = {
    let want = describe(oracle_decode(text));
    assert_eq(describe(Encoding.base64_decode(text)), want);
    assert_eq(describe(Encoding.base64_url_decode(text)), want)
}
let main (): Unit = {
    let alphabet = ["A", "B", "Z", "g", "/", "_", "=", "!", "\x00", "é"];
    let mut count = 1;
    for length in 0..5 {
        for code in 0..count {
            let mut rest = code;
            let mut text = "";
            for i in 0..length { text = text.concat(alphabet[rest % alphabet.len()]); rest = rest / alphabet.len(); };
            compare(text);
        };
        count = count * alphabet.len();
    };
    for text in ["+/8=", "+/8", "-_8=", "-_8", "+_8", "-/8", "AA==", "AB==", "AAA=", "AAB=", "AAAAA", "AAAAAB!", "AB=A", "A!", "AA==!", "AA\x00A", "AAAAé"] {
        compare(text);
    };
    let mut values = [];
    for i in 0..256 { values = values.push(i); };
    let want = Bytes.from_array(values);
    for text in ["", "AAECAwQFBgcICQoLDA0ODxAREhMUFRYXGBkaGxwdHh8gISIjJCUmJygpKissLS4vMDEyMzQ1Njc4OTo7PD0-P0BBQkNERUZHSElKS0xNTk9QUVJTVFVWV1hZWltcXV5fYGFiY2RlZmdoaWprbG1ub3BxcnN0dXZ3eHl6e3x9fn-AgYKDhIWGh4iJiouMjY6PkJGSk5SVlpeYmZqbnJ2en6ChoqOkpaanqKmqq6ytrq-wsbKztLW2t7i5uru8vb6_wMHCw8TFxsfIycrLzM3Oz9DR0tPU1dbX2Nna29zd3t_g4eLj5OXm5-jp6uvs7e7v8PHy8_T19vf4-fr7_P3-_w"] {
        assert_eq(Encoding.base64_decode(text).unwrap_or(Bytes.empty()).to_array(), values);
        assert_eq(Encoding.base64_url_decode(text).unwrap_or(Bytes.empty()).to_array(), values);
    };
    let mut text = "YWJj".repeat(50).concat("+/8=");
    let input_alias = text;
    let input_view = unsafe { text.as_cstr() };
    let mut decoded = Encoding.base64_decode(text).unwrap_or(Bytes.empty());
    let output_alias = decoded;
    let output_view = unsafe { decoded.as_cstr() };
    text = text.concat("!");
    decoded = decoded.concat(Bytes.from_array([0]));
    let expected = "abc".repeat(50).as_bytes().concat(Bytes.from_array([251, 255]));
    assert_eq(output_alias.to_array(), expected.to_array());
    assert_eq(unsafe { output_view.as_string() }.as_bytes().to_array(), expected.to_array());
    assert_eq(unsafe { input_view.as_string() }, input_alias);
    assert_eq(input_alias, "YWJj".repeat(50).concat("+/8="));
    assert_eq(text, input_alias.concat("!"));
    assert_eq(decoded.len(), expected.len() + 1);
    assert_eq(Encoding.base64_decode("YWJj".repeat(32768).concat("-_8")).unwrap_or(Bytes.empty()).to_array(), "abc".repeat(32768).as_bytes().concat(Bytes.from_array([251, 255])).to_array());
    println("Base64 decode: exact errors, precedence, binary bytes, alphabets, padding and immutable aliases")
}
