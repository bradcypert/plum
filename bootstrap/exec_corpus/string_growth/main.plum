// Public ownership paths, including spare capacity retained by later aliases.
let grow (s: String) (n: Int): String =
    if n <= 0 { s } else { grow(s.concat("aé\x00🙂"), n - 1) }
let aliases (): Unit = unsafe {
    let mut s = grow("", 37);
    let original = s;
    let bytes = s.as_bytes();
    let pointer = s.as_cstr();
    s = s.concat("suffix");
    assert_eq(original, grow("", 37));
    assert(bytes == grow("", 37).as_bytes());
    // CStr conversion stops at NUL, while the owner retains the whole cell.
    assert_eq(pointer.as_string(), "aé");
    assert_eq(s, grow("", 37).concat("suffix"));
    assert_eq(original.len(), 296)
}
let bytes_alias (): Unit = {
    let mut s = grow("", 37);
    let bytes = s.as_bytes();
    s = s.concat("suffix");
    assert(bytes == grow("", 37).as_bytes());
    assert_eq(s, grow("", 37).concat("suffix"))
}
let cstr_alias (): Unit = unsafe {
    let mut s = "x".repeat(512);
    let pointer = s.as_cstr();
    s = s.concat("suffix");
    assert_eq(pointer.as_string(), "x".repeat(512));
    assert_eq(s.len(), 518)
}
let main (): Unit = {
    let text = grow("", 4096);
    assert_eq(text.len(), 32768);
    assert_eq(text.char_len(), 16384);
    assert_eq(text.as_bytes().at(3), Some(0));
    aliases();
    bytes_alias();
    cstr_alias();
    let mut s = "abc".repeat(17);
    for i in 0..5 { s = s.concat(s); };
    assert_eq(s, "abc".repeat(544));
    s = s.concat("");
    assert_eq(s.len(), 1632);
    let mut saved = [];
    let mut prefix = "";
    for i in 0..64 { prefix = prefix.concat("é"); saved = saved.push(prefix); };
    for i in 0..64 { assert_eq(saved[i], "é".repeat(i + 1)); };
    println("String growth: values, snapshots, UTF-8, NUL and String/Bytes/CStr aliases")
}
