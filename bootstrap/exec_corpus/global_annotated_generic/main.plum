// A global whose type parameter comes only from its ANNOTATION.
//
// `None` does not say what it is an `Option` OF, and `Map.new(())` does
// not say what it maps. Until this fixture existed, a reference to such
// a global re-inferred its body at every mention, got a free type
// variable, and the backend DEFAULTED that variable to a scalar -- so
// the payload of `Some(v)` loaded as an `i1` while the arm returning it
// was a `ptr`, and LLVM refused the module. The error named a register.
//
// Locals were always fine, which is what made it confusing: the same
// two lines inside a function compiled.
struct Entry { label: String }

let NOTHING: Option[String] = None
let TABLE: Map[String, String] = Map.new(())
let COUNTS: Ref[Map[String, Int]] = ref(Map.new(()))
let EMPTY: Array[Entry] = []

let looked_up (): String = match Map.get(TABLE, "a") { Some(v) => v, None => "absent" }

let main (): Unit = {
    println(match NOTHING { Some(v) => v, None => "none" });
    println(looked_up());
    COUNTS.set(Map.insert(COUNTS.get(), "k", 7));
    println(match Map.get(COUNTS.get(), "k") { Some(n) => n.to_string(), None => "missing" });
    println(Array.concat(EMPTY, [Entry { label: "e" }])[0].label)
}
