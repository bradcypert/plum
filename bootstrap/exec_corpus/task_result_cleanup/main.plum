// Force both orders of unjoined completion and check nested owned results
// before process exit can drain declared handles through the registry.
extern "C" {
    fn result_gate();
    fn result_resume();
    fn result_wait();
    fn result_reset();
    fn result_verify();
    fn result_drop(h: Int);
}
handle Probe { on_drop: result_drop }
struct Payload { resource: Probe, text: String, items: Array[String] }

let produce (): Payload = {
    unsafe { result_gate() };
    Payload {
        resource: unsafe { Probe.from_raw(42) },
        text: "owned".concat(" result"),
        items: ["nested".concat(" value")],
    }
}
let handle_first (): Unit = {
    let task = spawn { produce() };
    ()
}
let worker_first (): Unit = {
    let task = spawn { produce() };
    unsafe { result_resume(); result_wait() }
}
let main (): Unit = {
    handle_first();
    unsafe { result_resume(); result_wait(); result_reset() };
    worker_first();
    unsafe { result_verify() };
    println("released both unjoined results")
}
