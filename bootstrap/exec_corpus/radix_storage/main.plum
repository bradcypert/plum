extern "C" { fn radix_verify(s: CStr, length: Int, n: Int, radix: Int, kind: Int) -> Unit; }
let check (n: Int) (radix: Int): Unit = {
    let result = Int.to_radix(n, radix);
    unsafe { radix_verify(result.as_cstr(), result.len(), n, radix, 0); };
    let mut appended = result; let alias = appended; let bytes = appended.as_bytes();
    let view = unsafe { appended.as_cstr() };
    appended = appended.concat("!");
    assert_eq(appended, alias.concat("!")); assert_eq(bytes.to_hex(), alias.as_bytes().to_hex());
    assert_eq(unsafe { view.as_string() }, alias);
}
let main (): Unit = {
    let min = 0 - 9223372036854775807 - 1;
    let max = 9223372036854775807;
    let values = [min, min + 1, 0 - max, 0 - 65535, 0 - 256, 0 - 36, 0 - 35, 0 - 1,
        0, 1, 2, 9, 10, 35, 36, 255, 256, 65535, max - 1, max];
    let format = Int.to_radix;
    for n in values {
        for radix in 0..40 { check(n, radix); };
        check(n, min); check(n, max);
        assert_eq(format(n, 10), n.to_string());
        let hex = Int.to_hex_bits(n); let bits = Int.to_bits(n);
        unsafe { radix_verify(hex.as_cstr(), hex.len(), n, 16, 1); radix_verify(bits.as_cstr(), bits.len(), n, 2, 2); };
    };
    for n in 0..36 {
        assert_eq(Int.to_radix(n, 36), String.slice("0123456789abcdefghijklmnopqrstuvwxyz", n, n + 1));
        assert_eq(Int.to_hex(n), Int.to_radix(n, 16));
        assert_eq(Int.to_binary(n), Int.to_radix(n, 2));
        assert_eq(Int.to_octal(n), Int.to_radix(n, 8));
    };
    let of_255 = Int.to_radix(255); assert_eq(of_255(16), "ff"); assert_eq(of_255(2), "11111111");
    assert_eq(Int.to_binary(min), "-1".concat("0".repeat(63)));
    assert_eq(Int.to_binary(0 - 1), "-1"); assert_eq(Int.to_bits(0 - 1), "1".repeat(64));
    assert_eq(Float.to_fixed(0.5, 0), "0"); assert_eq(Float.to_fixed(1.5, 0), "2");
    assert_eq(Float.to_fixed(2.5, 0), "2"); assert_eq(Float.to_fixed(3.5, 0), "4");
    assert_eq(Float.to_fixed(0.375, 2), "0.38"); assert_eq(Float.to_fixed(9.99, 1), "10.0");
    assert_eq(Float.to_fixed(-0.001, 2), "-0.00");
    println("Radix formatting: all bases, full Int range, clamping, bit patterns, rounding and immutable aliases")
}
