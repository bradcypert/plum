use Memory;

extern "C" { fn forward_close(n: Int) -> Unit; fn forward_total() -> Int; }

handle Resource { on_drop: forward_close }

struct Owner { resource: Resource }

struct Box[T] { value: T }

enum Owned { Value(Resource) }

let make (n: Int): Resource = unsafe { Resource.from_raw(n) }

let total (): Int = unsafe { forward_total() }

let live (): Int = match Memory.snapshot() {
    Some(s) => s.live_bytes,
    None => -1
}

let use_text (s: String): Unit = assert_eq(s.len(), 65536)

let identity (s: String): String = s

let pair (a: String) (b: String): String = a.concat(b)

let take_resource (r: Resource): Int = unsafe { r.raw() }

let take_owner (r: Owner): Int = unsafe { r.resource.raw() }

let take_array (r: Array[Resource]): Int = unsafe { r[0].raw() }

let take_ref (r: Ref[Resource]): Int = unsafe { r.get().raw() }

let take_enum (r: Owned): Int = match r { Value(v) => unsafe { v.raw() } }

let take_function (f: () -> Int): Int = f()

let lifetime (): Unit = {
    let forward = |s: String| {
        use_text(s);
        // The consuming callee has returned; its ordinary input must be gone
        // before this frame exits, not merely leak-free at process exit.
        let bytes = live();
        if bytes >= 0 {
            assert(bytes < 4096);
        };
    };
    forward("x".repeat(65536));
    let borrowing = |s: String| {
        assert(s.starts_with("x"));
        let bytes = live();
        if bytes >= 0 {
            assert(bytes >= 65536);
        };
        // A later read keeps this borrow live across the observation.
        // At a last borrowed read, ordinary values may now release early.
        assert(s.starts_with("x"));
    };
    borrowing("x".repeat(65536));
}

let scoped (): Unit = {
    let forward = |r: Resource| {
        assert_eq(take_resource(r), 0);
        assert_eq(total(), 0);
    };
    forward(make(0));
    assert_eq(total(), 1);
    let forward = |r: Owner| {
        assert_eq(take_owner(r), 1);
        assert_eq(total(), 1);
    };
    forward(Owner { resource: make(1) });
    assert_eq(total(), 2);
    let forward = |r: Array[Resource]| {
        assert_eq(take_array(r), 2);
        assert_eq(total(), 2);
    };
    forward([make(2)]);
    assert_eq(total(), 3);
    let forward = |r: Ref[Resource]| {
        assert_eq(take_ref(r), 3);
        assert_eq(total(), 3);
    };
    forward(ref(make(3)));
    assert_eq(total(), 4);
    let forward = |r: Owned| {
        assert_eq(take_enum(r), 4);
        assert_eq(total(), 4);
    };
    forward(Value(make(4)));
    assert_eq(total(), 5);
    let forward = |f: () -> Int| {
        assert_eq(take_function(f), 5);
        assert_eq(total(), 5);
    };
    forward(
        {
            let r = make(5);
            || unsafe { r.raw() }
        }
    );
    assert_eq(total(), 6);
}

let round (): Unit = {
    let reverse = String.reverse;
    let forward = |s: String| reverse(s);
    assert_eq(forward("aé🙂".repeat(32)), "🙂éa".repeat(32));
    let id = |s: String| identity(s);
    assert_eq(id("a".repeat(32)), "a".repeat(32));
    let wrap = |s: String| Some(s);
    assert_eq(wrap("a".repeat(32)), Some("a".repeat(32)));
    let nest = |s: Option[String]| Some(s);
    assert_eq(nest(Some("a".repeat(32))), Some(Some("a".repeat(32))));
    let nest = |b: Box[String]| Box { value: b };
    assert_eq(nest(Box { value: "a".repeat(32) }).value.value, "a".repeat(32));
    let tuple = |s: String| (s, 7);
    let (value, number) = tuple("a".repeat(32));
    assert_eq(value, "a".repeat(32));
    assert_eq(number, 7);
    let array = |s: String| [s];
    assert_eq(array("a".repeat(32)), ["a".repeat(32)]);
    let twice = |s: String| pair(s, s);
    assert_eq(twice("a".repeat(32)), "a".repeat(64));
    let later = |s: String| pair(s, String.slice(s, 0, 1));
    assert_eq(later("a".repeat(32)), "a".repeat(33));
    let snapshot = "aé🙂".repeat(32);
    let bytes = snapshot.as_bytes();
    let view = snapshot.as_cstr();
    assert_eq(forward(snapshot), "🙂éa".repeat(32));
    assert_eq(snapshot, "aé🙂".repeat(32));
    assert_eq(bytes.to_hex(), snapshot.as_bytes().to_hex());
    assert_eq(unsafe { view.as_string() }, snapshot);
    let captured = "aé🙂".repeat(32);
    let retained = || captured;
    let wrapped = |s: String| pair(retained(), s);
    assert_eq(wrapped("!"), captured.concat("!"));
    assert_eq(wrapped("?"), captured.concat("?"));
    let save = |s: String| { || s };
    let saved = save("a".repeat(32));
    assert_eq(saved(), "a".repeat(32));
    assert_eq(saved(), "a".repeat(32));
    let cell = ref("");
    let store = |s: String| cell.set(s);
    store("a".repeat(32));
    assert_eq(cell.get(), "a".repeat(32));
    let cstr = |s: CStr| s;
    let result = cstr("a".repeat(32).as_cstr());
    assert_eq(unsafe { result.as_string() }, "a".repeat(32));
    let bytes = |s: Bytes| s;
    let result = bytes("a".repeat(32).as_bytes());
    assert_eq(result.to_hex(), "61".repeat(32));
    let events = ref(0);
    let ordered = |s: String| pair(
        {
            events.set(events.get() * 10 + 1);
            s
        },
        {
            events.set(events.get() * 10 + 2);
            "!"
        }
    );
    assert_eq(ordered("a"), "a!");
    assert_eq(events.get(), 12);
    assert_eq(ordered("b"), "b!");
    assert_eq(events.get(), 1212);
    let shared = "aé🙂".repeat(32);
    let left = spawn { forward(shared) };
    let right = spawn { forward(shared) };
    assert_eq(left.join(), "🙂éa".repeat(32));
    assert_eq(right.join(), "🙂éa".repeat(32));
    assert_eq(shared, "aé🙂".repeat(32));
}

let main (): Unit = {
    let baseline = live();
    lifetime();
    scoped();
    round();
    if baseline >= 0 {
        assert_eq(live(), baseline);
    };
    assert_eq(total(), 6);
    println(
        "Parameter forwarding: owned reads, prompt release, constructors, aliases and scoped cleanup"
    )
}
