use Memory;
extern "C" { fn check_memory_registry() -> Int; }

let live_bytes (): Int = match Memory.snapshot() { Some(s) => s.live_bytes, None => -1 }
let peak_bytes (): Int = match Memory.snapshot() { Some(s) => s.peak_bytes, None => -1 }

let bounded_work (): Unit = {
    let mut values: Array[String] = [];
    let mut map: Map[Int, String] = Map.new(());
    for i in 0..128 {
        let text = "cell".concat(i.to_string());
        values = values.push(text);
        map = Map.insert(map, i, text);
    };
    let alias = values;
    let worker = spawn { alias[0].concat("!") };
    assert_eq(worker.join(), "cell0!");
    assert_eq(values.len(), 128);
    assert_eq(Map.len(map), 128);
    let mut reused = "";
    for i in 0..64 { reused = reused.concat("x"); };
    assert_eq(reused.len(), 64)
}

let main (): Unit = {
    assert_eq(args().len(), 0);
    if Option.is_none(Memory.snapshot()) {
        println("memory diagnostics disabled")
    } else {
        let baseline = live_bytes();
        let old_peak = peak_bytes();
        for i in 0..4 { bounded_work(); assert_eq(live_bytes(), baseline); };
        assert_eq(peak_bytes() >= old_peak, true);
        match Memory.snapshot() {
            None => panic_raw("diagnostics unexpectedly disabled"),
            Some(before) => {
                bounded_work();
                match Memory.snapshot() {
                    None => panic_raw("diagnostics unexpectedly disabled"),
                    Some(after) => {
                        let changes = Memory.delta(before, after);
                        assert_eq(changes.allocations > 0, true);
                        assert_eq(changes.allocated_bytes > 0, true);
                        assert_eq(after.peak_bytes >= before.peak_bytes, true);
                        assert_eq(Memory.delta(after, before).allocations < 0, true)
                    },
                }
            },
        };
        assert_eq(unsafe { check_memory_registry() }, 1);
        println("memory diagnostics enabled: bounded ownership, reuse, capacity and threaded snapshots pass")
    }
}
