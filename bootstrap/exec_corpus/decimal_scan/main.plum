let preserve (x: Float) (precision: Int): Unit = {
    let text = Float.to_fixed(x, precision);
    let want = text.as_bytes().to_hex();
    let alias = text; let bytes = text.as_bytes(); let view = unsafe { text.as_cstr() };
    let changed = text.concat("!");
    assert_eq(changed, alias.concat("!"));
    assert_eq(alias.as_bytes().to_hex(), want); assert_eq(bytes.to_hex(), want);
    assert_eq(unsafe { view.as_string() }.as_bytes().to_hex(), want);
}

let main (): Unit = {
    assert_eq(Float.to_fixed(0.5, 0), "0"); assert_eq(Float.to_fixed(1.5, 0), "2");
    assert_eq(Float.to_fixed(2.5, 0), "2"); assert_eq(Float.to_fixed(3.5, 0), "4");
    assert_eq(Float.to_fixed(0.125, 2), "0.12"); assert_eq(Float.to_fixed(0.375, 2), "0.38");
    assert_eq(Float.to_fixed(0.625, 2), "0.62"); assert_eq(Float.to_fixed(0.875, 2), "0.88");
    assert_eq(Float.to_fixed(0.5000000000000001, 0), "1");
    assert_eq(Float.to_fixed(0.49999999999999994, 0), "0");
    assert_eq(Float.to_fixed(1.4999999999999998, 0), "1");
    assert_eq(Float.to_fixed(1.5000000000000002, 0), "2");
    assert_eq(Float.to_fixed(99.5, 0), "100"); assert_eq(Float.to_fixed(999.5, 0), "1000");
    assert_eq(Float.to_fixed(-0.0, 2), "-0.00"); assert_eq(Float.to_fixed(-0.001, 2), "-0.00");
    for x in [0.0, -0.0, 0.5, 1.5, -1.5, 0.375, 9.99, 1.0 / 3.0,
        1.7976931348623157e308, -1.7976931348623157e308, 4.9406564584124654e-324] {
            for precision in (0 - 1)..19 { preserve(x, precision); };
        };
    let min = 0 - 9223372036854775807 - 1;
    assert_eq(Float.to_fixed(1.5, min), "2");
    assert_eq(Float.to_fixed(1.25, 9223372036854775807), "1.25000000000000000");
    println("Decimal scans: half-even ties, near misses, carries, signed zero, precision limits and immutable results")
}
