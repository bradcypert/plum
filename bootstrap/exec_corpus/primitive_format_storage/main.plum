let preserve (text: String): Unit = {
    let mut changed = text;
    let alias = changed;
    let bytes = changed.as_bytes();
    let view = unsafe { changed.as_cstr() };
    changed = changed.concat("!");
    assert_eq(changed, alias.concat("!"));
    assert_eq(bytes.to_hex(), alias.as_bytes().to_hex());
    assert_eq(unsafe { view.as_string() }, alias);
}

let bool_text (value: Bool): String = value.to_string()
let worker (n: Int): String = {
    let first = n.to_string();
    for i in 0..100 {
        assert_eq(i.to_string(), Int.to_radix(i, 10));
        assert_eq((0.1 + 0.2).to_string(), "0.30000000000000004");
        assert_eq(Float.to_fixed(if n < 0 { 1.25 } else { 17.125 }, 3), if n < 0 { "1.250" } else { "17.125" });
        assert_eq(bool_text(i - (i / 2) * 2 == 0), if i - (i / 2) * 2 == 0 { "true" } else { "false" });
    };
    first
}

let main (): Unit = {
    let min = 0 - 9223372036854775807 - 1;
    for n in [min, min + 1, 0 - 1, 0, 1, 9223372036854775807] {
        let text = n.to_string();
        assert_eq(text, Int.to_radix(n, 10)); preserve(text);
    };
    for b in [true, false] {
        let text = bool_text(b);
        assert_eq(text, if b { "true" } else { "false" });
        preserve(text);
        assert_eq("${b}", text);
    };
    assert_eq((-0.0).to_string(), "-0");
    assert_eq((1.0 / 0.0).to_string(), "inf");
    assert_eq((-1.0 / 0.0).to_string(), "-inf");
    assert_eq((0.0 / 0.0).to_string(), "nan");
    preserve((1.0 / 3.0).to_string());
    preserve(Float.to_fixed(1.7976931348623157e308, 17));
    assert_eq(Float.to_fixed(0.5, 0), "0");
    assert_eq(Float.to_fixed(1.5, 0), "2");
    assert_eq(Float.to_fixed(2.5, 0), "2");
    assert_eq(Float.to_fixed(3.5, 0), "4");
    assert_eq(Float.to_fixed(-0.001, 2), "-0.00");
    assert_eq(Float.to_fixed(1.25, 0 - 1), "1");
    assert_eq(Float.to_fixed(1.25, 18), "1.25000000000000000");
    let a = spawn { worker(min) }; let b = spawn { worker(9223372036854775807) };
    assert_eq(a.join(), "-9223372036854775808");
    assert_eq(b.join(), "9223372036854775807");
    println("Primitive formatting: compact results, static booleans, immutable aliases and concurrent local scratch")
}
