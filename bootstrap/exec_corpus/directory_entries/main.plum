use Os;

extern "C" { fn directory_bad_name(root: CStr) -> Int; }

let require (ok: Bool): Unit = assert_eq(ok, true)

let repeat_listing (root: String) (n: Int): Unit = {
    if n > 0 {
        match Os.list_dir(root) {
            Err(e) => { panic_raw(e); () },
            Ok(names) => {
                require(names.len() == 2);
                require(Array.contains(names, "alpha"));
                require(Array.contains(names, "snow-\u{2603}"));
            },
        };
        repeat_listing(root, n - 1)
    }
}

let main (): Unit = {
    let root = Result.unwrap_or_else(Os.temp_dir(), |e| { panic_raw(e); "" });
    require(Result.unwrap_or_else(Os.list_dir(root), |e| { panic_raw(e); [] }).len() == 0);
    println("empty directory: ok");
    require(Result.is_ok(Os.write_file(root.concat("/alpha"), "")));
    require(Result.is_ok(Os.write_file(root.concat("/snow-\u{2603}"), "")));
    repeat_listing(root, 256);
    println("repeated UTF-8 listings: ok");
    // Returned strings survive subsequent reads and closing both streams.
    let saved = Result.unwrap_or_else(Os.list_dir(root), |e| { panic_raw(e); [] });
    repeat_listing(root, 2);
    require(Array.contains(saved, "alpha"));
    require(Array.contains(saved, "snow-\u{2603}"));
    println("names outlive native storage: ok");
    require(match Os.list_dir(root.concat("/alpha")) { Err(_) => true, Ok(_) => false });
    require(match Os.list_dir(root.concat("/missing")) { Err(_) => true, Ok(_) => false });
    println("open failures: ok");
    // Windows filesystem encoding is covered separately by issue #109.
    if Os.platform() != "windows" {
        require(unsafe { directory_bad_name(root.as_cstr()) } == 0);
        for iteration in 0..32 {
            require(match Os.list_dir(root) {
                Err(e) => String.contains(e, "not valid UTF-8"),
                Ok(_) => false,
            })
        }
    };
    println("invalid UTF-8 rejected: ok");
    require(Result.is_ok(Os.remove_tree(root)));
    println("cleanup: ok")
}
