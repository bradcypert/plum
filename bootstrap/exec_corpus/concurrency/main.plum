// Threads and channels. The self-hosted backend reaches both through
// native_stdlib/thread_shim.c rather than emitting pthread IR of its
// own, which is what the real backend does -- the same split as
// directories and processes.
//
// `spawn { .. }` becomes a zero-parameter CLOSURE in the checker, so
// the capture machinery is already done; the backend emits a per-site
// entry function matching what `thread_spawn` expects and boxes the
// result for `.join()`.
//
// Both channel ends are the SAME handle underneath. Only the types
// differ, which is what makes `.send` on a Receiver a type error rather
// than a runtime one.
//
// This fixture LEAKED BY DESIGN for most of its life -- 608 bytes, then
// 288 -- and now leaks nothing.
//
// What changed is that `Sender`, `Receiver` and `Task` stopped being
// bare integers. An integer has no lifetime, so nothing ran when one
// died: the channel was never freed and an unjoined task was never
// reclaimed. They are refcounted cells now, and the last reference
// dying is what frees the queue or detaches the thread. See DESIGN.md,
// "Handles that own something".
//
// For scale, the retired real compiler leaked 734 bytes on this same
// program and never stopped.

let square (n: Int): Int = n * n

let producer (tx: Sender[Int]) (n: Int): Unit = tx.send(square(n))

let main (): Unit = {
    let t = spawn { square(9) };
    println(t.join().to_string());

    let (tx, rx) = channel[Int]();
    spawn { producer(tx, 7) };
    println(rx.recv().to_string());

    let a = spawn { square(1) };
    let b = spawn { square(2) };
    let c = spawn { square(3) };
    println([a.join(), b.join(), c.join()].to_string());

    // A captured heap value crossing a thread boundary.
    let label = "from-thread";
    let d = spawn { label.concat("!") };
    println(d.join());

    // Several values through one channel, in order.
    let (tx2, rx2) = channel[String]();
    spawn { tx2.send("first") };
    println(rx2.recv());
}
