use inner;

// Same NAME, different type. `P` here means this file's `P`, because a
// name means what it means where it was written.
pub struct P { pub x: Int }

pub enum Shade { Warm, Cool }

let describe (p: P): String = "root P x=".concat(p.x.to_string())

let main (): Unit = {
    println(describe(P { x: 42 }));
    println(inner.make().y);
    // The enums are distinct too, variants and all.
    println(match Warm { Warm => "root Warm", Cool => "root Cool" });
    println(match inner.shade() { Light => "inner Light", Dark => "inner Dark" })
}
