let reference (parts: Array[String]) (sep: String): String = {
    let mut out = "";
    for i in 0..parts.len() {
        if i > 0 {
            out = out.concat(sep);
        };
        out = out.concat(parts[i]);
    };
    out
}

let check_sliced_join (): Unit = {
    let lo = -9223372036854775807 - 1;
    let hi = 9223372036854775807;
    let parts = ["before", "é", "\x00", "", "🙂", "after"];
    assert_eq(Array.concat_all(Array.slice(parts, lo, hi)), "beforeé\x00🙂after");
    assert_eq(Array.concat_all(Array.slice(parts, 1, 5)), "é\x00🙂");
    assert_eq(Array.concat_all(Array.slice(parts, 4, 5)), "🙂");
    assert_eq(Array.concat_all(Array.slice(parts, 3, 4)), "");
    assert_eq(Array.concat_all(Array.slice(parts, 5, 2)), "");
    assert_eq(Array.concat_all(Array.slice(parts, lo, lo)), "");
    assert_eq(Array.concat_all(Array.slice(parts, hi, hi)), "");
    assert_eq(Array.concat_all(Array.slice(parts, 5, hi)), "after");
    let mut owned = ["first".repeat(2), "second".repeat(2), "third".repeat(2)];
    let joined = Array.concat_all(Array.slice(
        owned,
        {
            owned = ["changed"];
            1
        },
        owned.len() + 1
    ));
    assert_eq(joined, "secondsecond");
    assert_eq(owned[0], "changed");
    let shared = ["discard".repeat(2), "keep".repeat(4), "skip".repeat(2)];
    let kept = Array.concat_all(Array.slice(shared, 1, 2));
    assert_eq(kept.concat("!"), "keepkeepkeepkeep!");
    assert_eq(shared[1], "keepkeepkeepkeep");
}

let main (): Unit = {
    check_sliced_join(());
    let raw = unsafe { Bytes.from_array([255, 128, 65]).as_cstr().as_string() };
    for parts in [
        [],
        [""],
        ["a"],
        ["", ""],
        ["", "a", ""],
        ["a", "", "b"],
        ["aé", "\x00", "🙂", "", raw]
    ] {
        for sep in ["", ",", "é\x00🙂", raw, "<>".repeat(1024)] {
            assert_eq(
                parts.join(sep).as_bytes().to_array(),
                reference(parts, sep).as_bytes().to_array()
            );
        };
        assert_eq(Array.concat_all(parts), reference(parts, ""));
    };
    let mut source = "abcé🙂".repeat(50);
    let mut parts = [source, "", source];
    let array_alias = parts;
    let mut sep = source;
    let input_view = unsafe { sep.as_cstr() };
    let mut joined = parts.join(sep);
    let saved = joined;
    let bytes = joined.as_bytes();
    let pointer = unsafe { joined.as_cstr() };
    source = source.concat("changed");
    sep = sep.concat("separator");
    parts = parts.set(0, "replacement");
    joined = joined.concat("tail");
    let original = "abcé🙂".repeat(50);
    let want = original.repeat(4);
    assert_eq(saved, want);
    assert_eq(bytes.to_array(), want.as_bytes().to_array());
    assert_eq(unsafe { pointer.as_string() }, want);
    assert_eq(unsafe { input_view.as_string() }, original);
    assert_eq(array_alias[0], original);
    assert_eq(array_alias[2], original);
    assert_eq(parts[0], "replacement");
    assert_eq(source, original.concat("changed"));
    assert_eq(sep, original.concat("separator"));
    assert_eq(joined, want.concat("tail"));
    let compact = "aé\x00".repeat(36);
    let padded = ["", compact, ""];
    let forwarded = Array.concat_all(padded);
    let separator_only = ["", ""].join(compact);
    assert_eq(forwarded.concat("tail"), "aé\x00".repeat(36).concat("tail"));
    assert_eq(separator_only, compact);
    assert_eq(padded[1], "aé\x00".repeat(36));
    let mut many = [];
    for i in 0..32768 {
        many = many.push("é\x00🙂");
    };
    assert_eq(
        many.join("|").as_bytes().to_array(),
        "é\x00🙂|".repeat(32767).concat("é\x00🙂").as_bytes().to_array()
    );
    assert_eq(Array.concat_all(many), "é\x00🙂".repeat(32768));
    assert_eq(many.len(), 32768);
    println("String join: exact bytes, separators, empty parts and immutable aliases")
}
