// Regression fixture for issue #69.
//
// A channel end is shared by several spawned tasks. The queue itself is
// synchronized in the native shim; this deliberately exercises the
// wrapper-cell lifetime across the spawn boundary.
use Time;

let sender_round (): Unit = {
    let (tx, rx) = channel[Int]();
    for t in 0..8 {
        spawn { for i in 0..10000 { tx.send(i) } }
    };
    for i in 0..80000 { rx.recv() };
    Time.sleep(Time.millis(50));
    println("senders done")
}

let receiver_round (): Unit = {
    let (tx, rx) = channel[Int]();
    for t in 0..8 {
        spawn { for i in 0..10000 { rx.recv() } }
    };
    for i in 0..80000 { tx.send(i) };
    Time.sleep(Time.millis(50));
    println("receivers done")
}

let main (): Unit = {
    sender_round();
    receiver_round()
}
