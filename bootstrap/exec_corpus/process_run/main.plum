use Os;
use Process;

// Structured process execution: argv is passed to the child, not
// concatenated into a shell command. This fixture re-invokes itself so
// the same binary works on every platform -- `/bin/echo` is not on
// Windows, and a shell would make the metacharacter cases vacuous.
//
// The `--echo` cases are the ones that fail if anyone "fixes" this to
// go through `system()` / `cmd.exe`: `$HOME` would expand, `$(whoami)`
// would run, `*` would glob, and `a;echo pwned` would become two
// commands.

extern "C" {
    fn stdin_read_line() -> CStr;
}

let join_acc (xs: Array[String]) (i: Int) (acc: String): String =
    if i >= xs.len() { acc }
    else if i == 0 { join_acc(xs, i + 1, xs[i]) }
    else { join_acc(xs, i + 1, acc.concat(" :: ").concat(xs[i])) }

let show (label: String) (r: Result[Process.ProcessResult, String]): Unit =
    match r {
        Err(_) => println(label.concat(": err")),
        Ok(res) => {
            println(label.concat(": exit=").concat(res.exit_code.to_string())
                .concat(" out=[").concat(String.trim_end(res.stdout)).concat("]")
                .concat(" err=[").concat(String.trim_end(res.stderr)).concat("]"))
        },
    }

let run_self (self: String) (args: Array[String]) (env: Array[String]) (stdin: Option[String]): Result[Process.ProcessResult, String] =
    Process.run(Process.Options {
        program: self,
        args: args,
        env: env,
        stdin: stdin,
    })

let child (argv: Array[String]): Unit =
    if argv[0] == "--echo" { println(join_acc(Array.drop(argv, 1), 0, "")) }
    else if argv[0] == "--stdin" { unsafe { println(stdin_read_line().as_string()) } }
    else if argv[0] == "--env" {
        println(match Os.env_var("PLUM_PROC_TEST") { Some(v) => v, None => "UNSET" })
    }
    else if argv[0] == "--path" {
        println(match Os.env_var("PATH") { Some(_) => "set", None => "UNSET" })
    }
    else if argv[0] == "--exit" {
        match String.parse_int(if argv.len() >= 2 { argv[1] } else { "99" }) {
            Ok(code) => Os.exit_with(code),
            Err(_) => Os.exit_with(99),
        }
    }
    else { println("unknown child mode") }

let parent (): Unit =
    match Os.self_exe() {
        Err(e) => println("self_exe: ".concat(e)),
        Ok(self) => {
            show("echo", run_self(self, [
                "--echo",
                "hello world",
                "$HOME",
                "a;echo pwned",
                "$(whoami)",
                "x|y",
                "*",
                "\"quoted\"",
            ], [], None));
            show("exit0", run_self(self, ["--exit", "0"], [], None));
            show("exit3", run_self(self, ["--exit", "3"], [], None));
            show("missing", Process.run(Process.Options {
                program: "plum_definitely_not_a_program_9f3a",
                args: [],
                env: [],
                stdin: None,
            }));
            show("stdin", run_self(self, ["--stdin"], [], Some("hello from stdin")));
            show("env", run_self(self, ["--env"], ["PLUM_PROC_TEST=from-parent"], None));
            show("path", run_self(self, ["--path"], ["PLUM_PROC_TEST=from-parent"], None))
        },
    }

let main (): Unit =
    if Array.is_empty(args()) { parent() } else { child(args()) }
