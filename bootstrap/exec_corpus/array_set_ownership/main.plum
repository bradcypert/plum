struct Box { text: String }
enum Item { Empty, Text(String) }

let text (n: Int): String = n.to_string().concat("-payload").repeat(8)
let ints (n: Int): Array[Int] = [n, n + 1, n + 2, n + 3]
let heap_loop (xs: Array[Box]) (n: Int): Array[Box] =
    if n <= 0 { xs } else { heap_loop(xs.set(n % 3, Box { text: text(n) }), n - 1) }

let main (): Unit = {
    let mut xs = ints(10);
    let original = xs;
    for n in 0..1000 { xs = xs.set(n % 4, n); };
    assert_eq(xs, [996, 997, 998, 999]); assert_eq(original, [10, 11, 12, 13]);

    let mut snapshots: Array[Array[Int]] = [];
    let mut state = ints(0);
    for n in 0..128 { snapshots = snapshots.push(state); state = state.set(0, n + 1); };
    for n in 0..128 { assert_eq(snapshots[n], [n, 1, 2, 3]); };
    assert_eq(state, [128, 1, 2, 3]);

    // Index/value reads and assignments run before deciding uniqueness.
    let mut source = ints(20);
    let changed = source.set({ source = ints(30); 1 }, source[0]);
    assert_eq(changed, [20, 30, 22, 23]); assert_eq(source, [30, 31, 32, 33]);
    let saved = ref(ints(0));
    let receiver = ints(40);
    let changed = receiver.set({ saved.set(receiver); 0 }, 99);
    assert_eq(changed, [99, 41, 42, 43]); assert_eq(saved.get(), [40, 41, 42, 43]);
    let receiver = ints(50);
    let changed = receiver.set(1, { saved.set(receiver); 100 });
    assert_eq(changed, [50, 100, 52, 53]); assert_eq(saved.get(), [50, 51, 52, 53]);
    let receiver = ints(60);
    assert_eq(receiver.set(0, receiver[0]), [60, 61, 62, 63]);
    assert_eq(Array.set(ints(70), 3, 0), [70, 71, 72, 0]);
    assert_eq([true, false].set(1, true), [true, true]);
    assert_eq([1.25, 2.5].set(0, 3.75), [3.75, 2.5]);
    assert_eq([(), ()].set(0, ()), [(), ()]);

    let old = text(1); let replacement = text(2);
    let bytes = old.as_bytes(); let view = unsafe { old.as_cstr() };
    let mut strings = [old, old, replacement];
    let snapshot = strings;
    strings = strings.set(0, replacement);
    strings = strings.set(1, strings[1]);
    strings = strings.set(2, text(3));
    assert_eq(snapshot, [old, old, replacement]);
    assert_eq(strings, [replacement, old, text(3)]);
    assert_eq(bytes.to_hex(), old.as_bytes().to_hex());
    assert_eq(unsafe { view.as_string() }, old);
    let mut buffers = [old.as_bytes(), replacement.as_bytes()];
    buffers = buffers.set(0, buffers[1]);
    assert_eq(buffers[0].to_hex(), replacement.as_bytes().to_hex());
    let mut views = [unsafe { old.as_cstr() }, unsafe { replacement.as_cstr() }];
    views = views.set(0, views[1]);
    assert_eq(unsafe { views[0].as_string() }, replacement);

    let mut boxes = heap_loop([Box { text: text(0) }, Box { text: text(0) }, Box { text: text(0) }], 1000);
    assert_eq(boxes[0].text, text(3)); assert_eq(boxes[1].text, text(1));
    let box_alias = boxes[0];
    boxes = boxes.set(0, Box { text: text(4) });
    assert_eq(box_alias.text, text(3)); assert_eq(boxes[0].text, text(4));
    let mut items = [Text(text(1)), Empty];
    items = items.set(0, items[0]); items = items.set(1, Text(text(2)));
    assert_eq(items, [Text(text(1)), Text(text(2))]);
    items = items.set(0, Empty); assert_eq(items, [Empty, Text(text(2))]);

    let nested = [ints(1), ints(2)]; let nested_alias = nested;
    let nested = nested.set(0, nested[1]);
    assert_eq(nested[0], ints(2)); assert_eq(nested_alias[0], ints(1));
    let mut pairs = [(text(1), 1), (text(2), 2)];
    pairs = pairs.set(0, pairs[1]);
    let (s, n) = pairs[0]; assert_eq(s, text(2)); assert_eq(n, 2);
    let a = ref(text(1)); let b = ref(text(2));
    let refs = [a, b].set(0, b); a.set(text(3));
    assert_eq(refs[0].get(), text(2)); assert_eq(a.get(), text(3));
    let first = text(1); let second = text(2);
    let mut functions = [|| first, || second];
    let function_alias = functions;
    functions = functions.set(0, functions[1]);
    assert_eq(functions[0](), second); assert_eq(function_alias[0](), first);
    let shared = [Box { text: text(0) }, Box { text: text(0) }, Box { text: text(0) }];
    let a = spawn { heap_loop(shared, 100) };
    let b = spawn { heap_loop(shared, 200) };
    let left = a.join(); let right = b.join();
    assert_eq(left[0].text, text(3)); assert_eq(right[0].text, text(3));
    assert_eq(shared[0].text, text(0));
    println("Array.set: consuming reuse, persistent snapshots, operand aliases and scalar/heap ownership")
}
