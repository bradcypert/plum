use Memory;
struct Box { text: String }
enum Item { Empty, Text(String) }
extern "C" {
    fn concat_close(n: Int) -> Unit;
    fn concat_count() -> Int;
    fn concat_at(i: Int) -> Int;
    fn concat_pattern(i: Int) -> Float;
    fn concat_bits(n: Float) -> Int;
}
handle Resource { on_drop: concat_close }
let make (n: Int): Resource = unsafe { Resource.from_raw(n) }
let captured (n: Int): () -> Int = { let owner = make(n); || unsafe { owner.raw() } }
let ints (n: Int): Array[Int] = [n, n + 1, n + 2]
let text (n: Int): String = n.to_string().repeat(16)
let concat[T] (a: Array[T]) (b: Array[T]): Array[T] = Array.concat(a, b)
let check_order (offset: Int) (expected: Array[Int]): Unit = {
    assert_eq(unsafe { concat_count() }, offset + expected.len());
    for i in 0..expected.len() { assert_eq(unsafe { concat_at(offset + i) }, expected[i]); }
}
let scoped (): Unit = {
    let a = [make(1), make(2)]; let b = [make(3)]; let marker = make(4);
    let out = concat(a, b);
    assert_eq(unsafe { out[2].raw() }, 3); assert_eq(unsafe { concat_count() }, 0);
}
let assigned (): Unit = {
    let mut xs = [captured(5)]; let marker = make(6);
    xs = Array.concat(xs, [captured(7)]);
    xs = Array.concat(xs, xs);
    assert_eq(xs.len(), 4); assert_eq(xs[0](), 5); assert_eq(xs[3](), 7);
    assert_eq(unsafe { concat_count() }, 4);
}
let discarded (): Unit = {
    let xs = [captured(8)]; let marker = make(9);
    // A non-assignment must keep the original scoped owner even at last use.
    Array.concat(xs, [captured(10)]);
    check_order(7, [10]);
}
let grow (n: Int): Array[Int] = {
    let mut xs: Array[Int] = [];
    for i in 0..n { xs = Array.concat(xs, [i]); };
    xs
}
let live (): Int = match Memory.snapshot() { Some(s) => s.live_bytes, None => -1 }
let memory_round (): Unit = {
    let xs = grow(256); let before = live();
    let same = Array.concat(xs, []);
    if before >= 0 { assert_eq(live(), before); };
    let changed = Array.concat(xs, [256]);
    if before >= 0 { assert_eq(live() - before, 2072); };
    assert_eq(same.len(), 256); assert_eq(xs[255], 255); assert_eq(changed[256], 256);
}
let main (): Unit = {
    let baseline = live(); memory_round();
    if baseline >= 0 { assert_eq(live(), baseline); };
    let empty: Array[String] = [];
    assert_eq(concat(empty, []), []); assert_eq(concat([], [text(1)]), [text(1)]);
    assert_eq(concat([text(1)], []), [text(1)]);
    assert_eq(concat(ints(0), ints(3)), [0, 1, 2, 3, 4, 5]);
    assert_eq(concat(Array.filter([text(1)], |s| false), [text(2)]), [text(2)]);
    assert_eq(Array.concat([], []).len(), 0);
    let f: (Array[Int], Array[Int]) -> Array[Int] = Array.concat;
    assert_eq(f([1, 2], [3]), [1, 2, 3]);
    let partial = Array.concat([1, 2]); assert_eq(partial([3]), [1, 2, 3]);
    assert_eq(concat([true, false], [false, true]), [true, false, false, true]);
    assert_eq(concat([(), ()], [()]), [(), (), ()]);
    let patterns = concat([unsafe { concat_pattern(0) }, unsafe { concat_pattern(1) }],
        [unsafe { concat_pattern(2) }, unsafe { concat_pattern(3) }]);
    for i in 0..4 { assert_eq(unsafe { concat_bits(patterns[i]) }, unsafe { concat_bits(concat_pattern(i)) }); };
    assert_eq(concat([1.25], [-0.0, 2.5])[1].to_string(), "-0");

    let mut xs = ints(10); let saved = xs;
    xs = Array.concat(xs, xs);
    assert_eq(xs, [10, 11, 12, 10, 11, 12]); assert_eq(saved, ints(10));
    let mut snapshots: Array[Array[Int]] = []; let mut state: Array[Int] = [];
    for i in 0..128 { snapshots = snapshots.push(state); state = Array.concat(state, [i]); };
    for n in 0..128 { assert_eq(snapshots[n].len(), n); for i in 0..n { assert_eq(snapshots[n][i], i); }; };
    assert_eq(state.len(), 128);
    let mut source = ints(20);
    let out = Array.concat(source, { source = [30, 31]; source });
    assert_eq(out, [20, 21, 22, 30, 31]); assert_eq(source, [30, 31]);
    let published = ref(ints(0)); let receiver = ints(40);
    let out = Array.concat(receiver, { published.set(receiver); [50] });
    assert_eq(out, [40, 41, 42, 50]); assert_eq(published.get(), ints(40));
    let mut source = ints(60);
    source = Array.concat(source, Array.slice(source, 1, 3));
    assert_eq(source, [60, 61, 62, 61, 62]);

    let a = text(1); let b = text(2); let bytes = a.as_bytes(); let view = unsafe { a.as_cstr() };
    let mut strings = [a, a]; let original = strings;
    for i in 0..64 { strings = Array.concat(strings, [b]); };
    assert_eq(strings.len(), 66); assert_eq(strings[0], a); assert_eq(strings[65], b); assert_eq(original, [a, a]);
    assert_eq(bytes.to_hex(), a.as_bytes().to_hex()); assert_eq(unsafe { view.as_string() }, a);
    let buffers = concat([a.as_bytes()], [b.as_bytes()]); assert_eq(buffers[1].to_hex(), b.as_bytes().to_hex());
    let views = concat([unsafe { a.as_cstr() }], [unsafe { b.as_cstr() }]); assert_eq(unsafe { views[1].as_string() }, b);
    let boxes = concat([Box { text: a }], [Box { text: b }]); assert_eq(boxes[1].text, b);
    assert_eq(concat([Empty, Text(a)], [Text(b)]), [Empty, Text(a), Text(b)]);
    assert_eq(concat([[1], [2]], [[3]]), [[1], [2], [3]]);
    let pairs = concat([(a, 1)], [(b, 2)]); let (s, n) = pairs[1]; assert_eq(s, b); assert_eq(n, 2);
    let first = ref(a); let second = ref(b); let refs = concat([first], [second]);
    first.set(text(3)); assert_eq(refs[0].get(), text(3)); assert_eq(refs[1].get(), b);
    let shared = [Box { text: a }]; let left = spawn { concat(shared, [Box { text: b }]) };
    let right = spawn { concat(shared, shared) };
    assert_eq(left.join()[1].text, b); assert_eq(right.join().len(), 2); assert_eq(shared[0].text, a);
    let large = "abcd".repeat(25000).as_bytes().to_array();
    let large = Array.concat([0], large);
    assert_eq(large.len(), 100001); assert_eq(large[0], 0); assert_eq(large[100000], 100);

    scoped(); check_order(0, [4, 3, 1, 2]);
    assigned(); check_order(4, [6, 5, 7]);
    discarded(); check_order(7, [10, 9, 8]);
    println("Array.concat: owned batch appends, immutable aliases, operand order and scoped owners")
}
