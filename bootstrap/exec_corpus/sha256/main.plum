// SHA-256 against all four of NIST's published vectors.
//
// Worth having as a fixture rather than a property: the expected answers
// are what the standard says, not what this compiler produced last time,
// which is firmer ground than a recording.
//
// NIST's fourth vector, a million characters, is NOT here: this corpus
// runs under AddressSanitizer, which instruments every allocation, and
// a million bytes of it blows the 60-second limit. It lives in
// `bootstrap/properties` instead, which runs without ASan.
use Crypto;
use Encoding;

let digest (s: String): String = Encoding.hex_encode(Crypto.sha256(Bytes.from_string(s)))

let main (): Unit = {
    println(digest(""));
    println(digest("abc"));
    println(digest("abcdbcdecdefdefgefghfghighijhijkijkljklmklmnlmnomnopnopq"))
}
