let make (): String = "ab\x00🙂".repeat(32)

let main (): Unit = {
    let replace = String.replace;
    let upper = String.to_upper;
    let lower = String.to_lower;
    let forward = |s: String| {
        assert(s.starts_with("ab"));
        s.replace("ab", "zy").to_upper().to_lower()
    };
    assert_eq(forward(make()), "zy\x00🙂".repeat(32));
    let source = make();
    let bytes = source.as_bytes();
    let view = source.as_cstr();
    assert_eq(source.replace("ab", "zy"), "zy\x00🙂".repeat(32));
    assert_eq(upper(source), "AB\x00🙂".repeat(32));
    assert_eq(lower(upper(make())), make());
    assert_eq(source, make());
    assert_eq(bytes.to_hex(), make().as_bytes().to_hex());
    assert_eq(unsafe { view.as_string() }, "ab");
    assert_eq(replace(make(), "ab", "zy"), "zy\x00🙂".repeat(32));
    assert_eq(replace(make(), "ab", "longer"), "longer\x00🙂".repeat(32));
    assert_eq(replace(make(), "ab", ""), "\x00🙂".repeat(32));

    let odd_run = "o".repeat(16386).concat("a".repeat(513));
    let expanded = replace(odd_run, "aa", "z".repeat(32));
    let expected = "o".repeat(16386).concat("z".repeat(8192)).concat("a");
    assert_eq(expanded, expected);
    assert_eq(unsafe { expanded.as_cstr().as_string() }, expected);
    let early = "a".repeat(64).concat("o".repeat(448)).concat("o".repeat(64));
    assert_eq(early.replace("aa", "z".repeat(8)), "z".repeat(256).concat("o".repeat(512)));

    let source = "o".repeat(512).concat("x".repeat(64));
    let alias = source.as_bytes();
    let grown = source.replace("x", "yyyy");
    assert_eq(grown, "o".repeat(512).concat("y".repeat(256)));
    assert_eq(alias.at(575), Some(120));
    assert_eq(replace(make(), "", "!"), make());
    assert_eq(replace(make(), "missing", "!"), make());
    assert_eq("ab".repeat(32).replace("ab", ""), "");
    assert_eq("".to_upper(), "");
    assert_eq("".replace("", "!"), "");
    let source = make();
    assert_eq(source.replace(source, source), source);
    assert_eq(source.replace("ab", source).len(), (source.len() + 5) * 32);
    let captured = make();
    let f = || captured.replace("ab", "zy").to_upper();
    assert_eq(f(), "ZY\x00🙂".repeat(32));
    assert_eq(f(), "ZY\x00🙂".repeat(32));
    assert_eq(captured, make());
    let cell = ref(make());
    let current = cell.get();
    assert_eq(current.replace("ab", "zy"), "zy\x00🙂".repeat(32));
    assert_eq(cell.get(), make());
    let mut changed = "ab".repeat(32);
    let result = changed.replace(
        {
            changed = "later";
            "ab"
        },
        {
            assert_eq(changed, "later");
            "zy"
        }
    );
    assert_eq(result, "zy".repeat(32));
    assert_eq(changed, "later");
    let source = make();
    let left = spawn { source.replace("ab", "zy").to_upper() };
    let right = spawn { source.to_upper().replace("AB", "ZY") };
    assert_eq(left.join(), "ZY\x00🙂".repeat(32));
    assert_eq(right.join(), "ZY\x00🙂".repeat(32));
    assert_eq(source, make());
    // Mapping widths and supplementary support vary by OS. A per-unit model
    // exercises both growing/shrinking units without hardcoding an OS table.
    let model = Array.concat_all(Array.map(chars_of("ȿı".repeat(32)), |s| s.to_upper()));
    assert_eq("ȿı".repeat(32).to_upper(), model);
    println("String transforms: owned reuse, aliases, evaluation order and Unicode widths")
}
