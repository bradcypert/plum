struct Point { x: Int, y: Int }

let main (): Unit = {
    let counter = ref(0);
    counter.set(counter.get() + 1);
    counter.set(counter.get() + 41);
    println(counter.get().to_string());

    let a = ref(Point { x: 0, y: 0 });
    let b = a;
    b.set(Point { x: 5, y: 5 });
    println(match a.get() { Point(x, y) => (x + y).to_string() });
    println((a == b).to_string());

    let c = ref(Point { x: 5, y: 5 });
    println((a == c).to_string());

    let total = ref(0);
    let add = |n: Int| total.set(total.get() + n);
    add(10);
    add(20);
    add(12);
    println(total.get().to_string());
}
