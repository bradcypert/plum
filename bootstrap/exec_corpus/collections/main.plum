// Map/Set enumeration order is unspecified. Normalize printed collections;
// map_trie independently checks key/value positional alignment.

let main (): Unit = {
    let m = Map.insert(Map.insert(Map.new(()), "a", 1), "b", 2);
    println(Map.len(m).to_string());
    println(Option.unwrap_or(Map.get(m, "a"), 0).to_string());
    println(Map.contains(m, "b").to_string());
    println(Array.sort_string(Map.keys(m)).to_string());
    println(Array.sort_int(Map.values(m)).to_string());
    let m2 = Map.remove(m, "a");
    println(Map.len(m2).to_string());

    let s = Set.insert(Set.insert(Set.new(()), 3), 7);
    println(Set.len(s).to_string());
    println(Set.contains(s, 7).to_string());
    println(Array.sort_int(Set.to_array(s)).to_string());
    let t = Set.from_array([7, 9]);
    println(Array.sort_int(Set.to_array(Set.union(s, t))).to_string());
    println(Array.sort_int(Set.to_array(Set.intersection(s, t))).to_string());
    println(Array.sort_int(Set.to_array(Set.difference(s, t))).to_string());
}
