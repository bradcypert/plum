use Memory;

let allocation_bytes (): Int = match Memory.snapshot() {
    None => -1,
    Some(s) => s.allocated_bytes,
}

let assert_projection_bytes (before: Int) (len: Int): Unit = {
    let after = allocation_bytes();
    if before >= 0 {
        // One header and eight bytes per slot, with room for the observer.
        assert(after - before <= 8 * len + 256);
    };
}

let key_in_slot (slot: Int) (start: Int): Int =
    if (start.hash() & 31) == slot { start } else { key_in_slot(slot, start + 1) }

let check_promotion
    (source: Map[Int, Int])
    (removed: Int)
    (survivors: Array[Int])
    (bytes_per_removal: Int): Unit
= {
    let before = allocation_bytes();
    for i in 0..64 {
        let result = Map.remove(source, removed);
        assert_eq(Map.len(result), survivors.len());
        assert(!Map.contains(result, removed));
        for key in survivors {
            assert(Map.contains(result, key));
        };
    };
    let after = allocation_bytes();
    if before >= 0 {
        // Allow the result wrapper and, for a collision collapse, a new
        // leaf. The source snapshot needs no singleton array copy.
        assert(after - before <= 64 * bytes_per_removal + 256);
    };
    assert(Map.contains(source, removed));
}

let check_terminal_promotion (a: Int) (b: Int) (deep: Int): Unit = {
    let other = key_in_slot(1, 1);
    let nested = key_in_slot(1, other + 1);
    check_promotion(Map.from_arrays([a, b], [10, 20]), b, [a], 64);
    check_promotion(Map.from_arrays([a, other], [10, 20]), a, [other], 24);
    check_promotion(Map.from_arrays([a, b, other], [10, 20, 30]), other, [a, b], 24);
    check_promotion(Map.from_arrays([a, deep], [10, 20]), deep, [a], 24);
    check_promotion(Map.from_arrays([a, b, deep], [10, 20, 30]), deep, [a, b], 24);

    let source = Map.from_arrays([a, other, nested], [10, 20, 30]);
    let result = Map.remove(source, a);
    assert_eq(Map.len(result), 2);
    assert_eq(Map.get(result, other), Some(20));
    assert_eq(Map.get(result, nested), Some(30));
    assert_eq(Map.get(source, a), Some(10));
}

let check_collision_replacements (a: Int) (b: Int) (deep: Int): Unit = {
    let mut map = Map.from_arrays([a, b, deep], [0, 1, 2]);
    let before = allocation_bytes();
    for i in 0..1024 {
        let key = if i % 2 == 0 { a } else { b };
        map = Map.insert(map, key, i);
    };
    let after = allocation_bytes();
    if before >= 0 {
        // Replacing an owned entry can recycle its record on every iteration.
        assert(after - before < 1024);
    };
    assert_eq(Map.len(map), 3);
    assert_eq(Map.get(map, a), Some(1022));
    assert_eq(Map.get(map, b), Some(1023));
    assert_eq(Map.get(map, deep), Some(2));
}

let check_set_traversal (): Unit = {
    let mut source: Set[Int] = Set.new(());
    for i in 0..4096 {
        source = Set.insert(source, i);
    };
    let before_members = allocation_bytes();
    let members = Set.to_array(source);
    assert_projection_bytes(before_members, 4096);
    assert_eq(members.len(), 4096);
    assert(members.contains(0) && members.contains(4095));
    let disjoint = Set.from_array([5000, 7000]);
    let before = allocation_bytes();
    let result = Set.intersection(source, disjoint);
    let after = allocation_bytes();
    assert_eq(Set.len(result), 0);
    if before >= 0 {
        // The disjoint traversal only needs an empty result and the
        // observer record. A rebuilt key array or per-branch closures
        // would allocate thousands of bytes.
        assert(after - before < 1024);
    };
    let empty: Set[Int] = Set.new(());
    let superset = Set.insert(source, 8192);
    let before_reuse = allocation_bytes();
    let union = Set.union(source, empty);
    let before_intersection = allocation_bytes();
    let intersection = Set.intersection(source, superset);
    let after_intersection = allocation_bytes();
    if before_reuse >= 0 {
        assert(before_intersection - before_reuse < 1024);
        assert(after_intersection - before_intersection < 1024);
    };
    assert_eq(union, source);
    assert_eq(intersection, source);
    assert_eq(Set.len(superset), 4097);

    let almost_superset = Set.remove(superset, 4095);
    let before_single_miss = allocation_bytes();
    let almost_all = Set.intersection(source, almost_superset);
    let after_single_miss = allocation_bytes();
    assert_eq(Set.len(almost_all), 4095);
    assert(!Set.contains(almost_all, 4095));
    assert(Set.contains(source, 4095));
    assert(Set.contains(almost_superset, 8192));
    if before_single_miss >= 0 {
        // Removing the missing key copies only its path from the shared input.
        assert(after_single_miss - before_single_miss < 16384);
    };

    let member = Set.from_array([2048]);
    let before_singleton = allocation_bytes();
    for i in 0..64 {
        let intersection = Set.intersection(source, member);
        assert_eq(Set.len(intersection), 1);
        assert(Set.contains(intersection, 2048));
    };
    let after_singleton = allocation_bytes();
    if before_singleton >= 0 {
        // Wrappers for each result, with the existing leaf retained.
        assert(after_singleton - before_singleton <= 64 * 48 + 256);
    };

    let covered = Set.from_array([0, 2048, 4095]);
    let before_covered = allocation_bytes();
    let covered_union = Set.union(source, covered);
    let after_covered = allocation_bytes();
    assert_eq(covered_union, source);
    if before_covered >= 0 {
        assert(after_covered - before_covered < 256);
    };

    let extra = Set.insert(covered, 8192);
    let before_extra = allocation_bytes();
    let extended = Set.union(source, extra);
    let after_extra = allocation_bytes();
    assert_eq(extended, superset);
    assert(Set.contains(extra, 8192));
    assert(!Set.contains(source, 8192));
    if before_extra >= 0 {
        // Only the novel member needs a copy of a path into the shared trie.
        assert(after_extra - before_extra < 4096);
    };

    let only_two = Set.from_array([key_in_slot(1, 8192), key_in_slot(2, 8192)]);
    let skewed = Set.union(only_two, source);
    assert_eq(Set.len(skewed), 4098);
    for key in Set.to_array(only_two) {
        assert(Set.contains(skewed, key));
    };
    for key in 0..4096 {
        assert(Set.contains(skewed, key));
    };

    let before_empty = allocation_bytes();
    let same = Set.difference(source, empty);
    let after_empty = allocation_bytes();
    assert_eq(Set.len(same), 4096);
    if before_empty >= 0 {
        assert(after_empty - before_empty < 1024);
    };

    let mut large_disjoint: Set[Int] = Set.new(());
    for i in 4096..8192 {
        large_disjoint = Set.insert(large_disjoint, i);
    };
    let before_union = allocation_bytes();
    let joined = Set.union(source, large_disjoint);
    let after_union = allocation_bytes();
    assert_eq(Set.len(joined), 8192);
    assert_eq(Set.len(source), 4096);
    assert_eq(Set.len(large_disjoint), 4096);
    for key in 0..8192 {
        assert(Set.contains(joined, key));
    };
    if before_union >= 0 {
        // The union shares leaf cells even when most root slots overlap.
        assert(after_union - before_union < 280000);
    };

    let mut mostly_covered: Set[Int] = Set.new(());
    for key in 0..3072 {
        mostly_covered = Set.insert(mostly_covered, key);
    };
    mostly_covered = Set.insert(mostly_covered, 8192);
    let before_covered_union = allocation_bytes();
    let mostly_covered_union = Set.union(source, mostly_covered);
    let after_covered_union = allocation_bytes();
    assert_eq(mostly_covered_union, superset);
    assert_eq(Set.len(mostly_covered), 3073);
    if before_covered_union >= 0 {
        assert(after_covered_union - before_covered_union < 4096);
    };

    let before_disjoint = allocation_bytes();
    let retained = Set.difference(source, large_disjoint);
    let after_disjoint = allocation_bytes();
    assert_eq(retained, source);
    assert_eq(Set.len(large_disjoint), 4096);
    if before_disjoint >= 0 {
        // An empty intersection allows the original trie to be returned.
        assert(after_disjoint - before_disjoint < 256);
    };

    let mostly_disjoint = Set.insert(large_disjoint, 4095);
    let before_single_cut = allocation_bytes();
    let single_cut = Set.difference(source, mostly_disjoint);
    let after_single_cut = allocation_bytes();
    assert_eq(Set.len(single_cut), 4095);
    assert(!Set.contains(single_cut, 4095));
    assert(Set.contains(source, 4095));
    if before_single_cut >= 0 {
        assert(after_single_cut - before_single_cut < 16384);
    };

    let mut clustered = large_disjoint;
    let mut survivors = 0;
    for i in 0..4096 {
        if (i.hash() & 31) < 16 {
            clustered = Set.insert(clustered, i);
        }
        else {
            survivors = survivors + 1;
        };
    };
    let before_clustered = allocation_bytes();
    let remainder = Set.difference(source, clustered);
    let after_clustered = allocation_bytes();
    assert_eq(Set.len(remainder), survivors);
    assert_eq(Set.len(source), 4096);
    assert_eq(Set.len(clustered), 8192 - survivors);
    for i in 0..4096 {
        assert_eq(Set.contains(remainder, i), (i.hash() & 31) >= 16);
    };
    if before_clustered >= 0 {
        // A changed bitmap can keep all the surviving child tries.
        assert(after_clustered - before_clustered < 16384);
    };

    let before_clustered_intersection = allocation_bytes();
    let common = Set.intersection(source, clustered);
    let after_clustered_intersection = allocation_bytes();
    assert_eq(Set.len(common), 4096 - survivors);
    for i in 0..4096 {
        assert_eq(Set.contains(common, i), (i.hash() & 31) < 16);
    };
    if before_clustered_intersection >= 0 {
        assert(after_clustered_intersection - before_clustered_intersection < 16384);
    };

    let exclusions = Set.from_array([0, 1024, 4095, 8192]);
    let before_cut = allocation_bytes();
    let cut = Set.difference(source, exclusions);
    let after_cut = allocation_bytes();
    if before_cut >= 0 {
        // A shared input needs only the affected paths copied.
        assert(after_cut - before_cut < 16384);
    };
    assert_eq(Set.len(cut), 4093);
    assert_eq(Set.len(source), 4096);
    for i in 0..4096 {
        assert(Set.contains(source, i));
        assert_eq(Set.contains(cut, i), i != 0 && i != 1024 && i != 4095);
    };
}

let check_grafted_union (shift: Int): Unit = {
    let mut left: Set[Int] = Set.new(());
    let mut right: Set[Int] = Set.new(());
    for key in 0..4096 {
        let hash = key.hash();
        if shift == 0 || (hash & 31) == 7 {
            if (Int.shr_logical(hash, shift) & 1) == 0 {
                left = Set.insert(left, key);
            }
            else {
                right = Set.insert(right, key);
            };
        };
    };
    let left_size = Set.len(left);
    let right_size = Set.len(right);
    let before = allocation_bytes();
    let result = Set.union(left, right);
    let after = allocation_bytes();
    assert_eq(Set.len(result), left_size + right_size);
    assert(left_size >= 2 && right_size >= 2);
    assert_eq(Set.len(left), left_size);
    assert_eq(Set.len(right), right_size);
    for key in 0..4096 {
        assert_eq(Set.contains(result, key), shift == 0 || (key.hash() & 31) == 7);
    };
    if before >= 0 {
        // The union only needs packed branch slots and the result wrapper.
        assert(after - before < 2048);
    };
}

let check_single_candidate_intersection (a: Int) (b: Int) (deep: Int): Unit = {
    // Only slot zero is shared. Each right set is too small for the coverage scan.
    let outside = key_in_slot(4, 1);
    let left = Set.from_array([a, b, deep, key_in_slot(1, 1), key_in_slot(2, 1)]);
    let leaf_right = Set.from_array([deep, outside]);
    let before = allocation_bytes();
    for i in 0..64 {
        let leaf = Set.intersection(left, leaf_right);
        assert_eq(Set.len(leaf), 1);
        assert(Set.contains(leaf, deep));
    };
    let after = allocation_bytes();
    if before >= 0 {
        // The surviving terminal needs no temporary child buffer.
        assert(after - before <= 64 * 80 + 256);
    };
    let collision = Set.intersection(left, Set.from_array([b, a, outside]));
    assert_eq(Set.to_array(collision), [a, b]);
    let branch = Set.intersection(left, Set.from_array([a, deep, outside]));
    assert_eq(Set.len(branch), 2);
    assert(Set.contains(branch, a));
    assert(Set.contains(branch, deep));
    assert_eq(branch, Set.from_array([a, deep]));
    assert_eq(Set.len(left), 5);
    assert_eq(Set.len(leaf_right), 2);
}

let check_pruned_terminals (a: Int) (b: Int) (deep: Int): Unit = {
    let other = key_in_slot(1, 1);
    let outside = key_in_slot(2, 1);
    let left = Set.from_array([a, b, deep, other]);
    let removals = Set.from_array([a, b, other]);
    let before = allocation_bytes();
    for i in 0..64 {
        let leaf = Set.difference(left, removals);
        assert_eq(Set.len(leaf), 1);
        assert(Set.contains(leaf, deep));
    };
    let after = allocation_bytes();
    if before >= 0 {
        // Promoting the leaf through every shared hash level should not
        // build a temporary array at each level.
        assert(after - before <= 64 * 448 + 256);
    };

    let collision = Set.difference(left, Set.from_array([deep, other, outside]));
    assert_eq(Set.to_array(collision), [a, b]);
    let branch = Set.difference(left, Set.from_array([b, other, outside]));
    assert_eq(branch, Set.from_array([a, deep]));
    assert(Set.contains(branch, a) && Set.contains(branch, deep));
    assert_eq(Set.len(left), 4);
}

let bucket_key (a: Int) (b: Int) (mask: Int): Array[Int] = {
    let mut key: Array[Int] = [];
    for bit in 0..8 {
        key = key.push(if (mask & (1 << bit)) == 0 { a } else { b });
    };
    key
}

let check_single_bucket_leaf
    (keys: Array[Array[Int]])
    (bucket: Set[Array[Int]])
    (miss: Array[Int]): Unit
= {
    let first = keys[0];
    let last = keys[keys.len() - 1];
    let left = Set.insert(Set.insert(bucket, [-1]), [-2]);
    let mut right = Set.from_array([[-1], [-2]]);
    // The two shared leaves reach bulk pruning. The padding keeps this
    // path even though at most one key from the collision bucket can match.
    for index in 0..keys.len() {
        right = Set.insert(right, [index]);
    };
    let exclusions = Set.insert(right, first);
    let before = allocation_bytes();
    let without_first = Set.difference(left, exclusions);
    let after = allocation_bytes();
    if before >= 0 {
        // Copy the surviving entries without building a selection mask.
        assert(after - before <= 1264);
    };
    assert_eq(Set.to_array(without_first), Array.drop(keys, 1));
    let without_last = Set.difference(left, Set.insert(right, last));
    assert_eq(Set.to_array(without_last), Array.take(keys, keys.len() - 1));
    let no_collision_match = Set.difference(left, Set.insert(right, miss));
    assert_eq(Set.to_array(no_collision_match), keys);

    let pair = Set.from_array([first, last, [-1], [-2]]);
    let survivor = Set.difference(pair, Set.from_array([first, [-1], [-2]]));
    assert_eq(survivor, Set.from_array([last]));
    assert(Set.contains(survivor, last));
    assert_eq(Set.len(left), keys.len() + 2);
    assert_eq(Set.to_array(bucket), keys);
}

let check_sparse_bucket_intersection
    (a: Int)
    (b: Int)
    (keys: Array[Array[Int]])
    (left: Set[Array[Int]]): Unit
= {
    let first = keys[1];
    let last = keys[127];
    let mut absent: Set[Array[Int]] = Set.new(());
    for slot in 128..142 {
        absent = Set.insert(absent, bucket_key(a, b, slot));
    };
    let one = Set.insert(absent, last);
    let both = Set.insert(one, first);
    let before = allocation_bytes();
    let result = Set.intersection(left, both);
    let after = allocation_bytes();
    if before >= 0 {
        // Only two entries survive, even though the right bucket has sixteen.
        assert(after - before <= 208);
    };
    assert_eq(Set.to_array(result), [first, last]);
    assert_eq(Set.to_array(Set.intersection(left, one)), [last]);
    assert_eq(Set.len(Set.intersection(left, absent)), 0);
    assert_eq(Set.to_array(left), keys);
}

let check_bulk_collision_union (keys: Array[Array[Int]]): Unit = {
    let left_keys = Array.take(keys, 96);
    let right_keys = Array.reverse(Array.drop(keys, 64));
    let left = Set.from_array(left_keys);
    let right = Set.from_array(right_keys);
    let before = allocation_bytes();
    let joined = Set.union(left, right);
    let after = allocation_bytes();
    if before >= 0 {
        // The union shares the original key entries and only grows the bucket.
        assert(after - before <= 2048);
    };
    let ordered = Array.concat(right_keys, Array.take(keys, 64));
    let expected = Set.from_array(ordered);
    assert_eq(Set.to_array(joined), ordered);
    assert_eq(Map.get(Map.insert(Map.new(()), joined, 42), expected), Some(42));
    assert_eq(Set.to_array(left), left_keys);
    assert_eq(Set.to_array(right), right_keys);

    let reversed = Array.reverse(keys);
    let owned_left = Set.from_array(keys);
    let owned_right = Set.from_array(reversed);
    let before_owned = allocation_bytes();
    let reordered = Set.union(owned_left, owned_right);
    let after_owned = allocation_bytes();
    if before_owned >= 0 {
        // Reuse the unique right bucket, with room for observer records.
        assert(after_owned - before_owned <= 128);
    };
    assert_eq(Set.to_array(reordered), reversed);

    let negative = Set.from_array([(keys[0], -0.0), (keys[1], -0.0)]);
    let positive = Set.from_array([(keys[2], 0.0), (keys[1], 0.0)]);
    let representatives = Set.to_array(Set.union(negative, positive));
    assert_eq(representatives, [(keys[2], 0.0), (keys[1], -0.0), (keys[0], -0.0)]);
    let (_, retained) = representatives[1];
    assert_eq(retained.to_string(), "-0");
}

let check_pruned_bucket (a: Int) (b: Int): Unit = {
    let mut keys: Array[Array[Int]] = [];
    let mut survivors: Array[Array[Int]] = [];
    let mut removals: Array[Array[Int]] = [];
    for slot in 0..128 {
        let key = bucket_key(a, b, slot);
        keys = keys.push(key);
        if slot % 4 == 0 {
            removals = removals.push(key);
        }
        else {
            survivors = survivors.push(key);
        };
    };
    for slot in 128..192 {
        removals = removals.push(bucket_key(a, b, slot));
    };
    assert_eq(keys[0].hash(), keys[127].hash());
    let left = Set.from_array(keys);
    let excluded = Set.from_array(removals);
    let included = Set.from_array(Array.reverse(survivors));

    let before = allocation_bytes();
    let difference = Set.difference(left, excluded);
    let split = allocation_bytes();
    let intersection = Set.intersection(left, included);
    let after = allocation_bytes();
    if before >= 0 {
        // The shared bucket needs one exact 96-entry buffer and a small
        // selection mask. Its capacity never grows while filling.
        assert(split - before <= 1024);
        assert(after - split <= 1024);
    };
    assert_eq(Set.to_array(difference), survivors);
    assert_eq(Set.to_array(intersection), survivors);

    // Promote the survivor at the highest bit of the last selection word.
    let only_last = Set.difference(left, Set.from_array(Array.take(keys, 127)));
    assert_eq(Set.to_array(only_last), [keys[127]]);
    assert_eq(Set.to_array(left), keys);
    check_single_bucket_leaf(keys, left, bucket_key(a, b, 128));
    check_sparse_bucket_intersection(a, b, keys, left);
    check_bulk_collision_union(keys);
}

let check_set_snapshots (a: Int) (b: Int) (deep: Int): Unit = {
    let left = Set.from_array([a, b, deep]);
    let right = Set.from_array([b, deep, 17]);
    let either = Set.union(left, right);
    let both = Set.intersection(left, right);
    let only_left = Set.difference(left, right);
    assert_eq(Set.len(either), 4);
    for key in [a, b, deep, 17] {
        assert(Set.contains(either, key));
    };
    assert_eq(Set.len(both), 2);
    assert(Set.contains(both, b));
    assert(Set.contains(both, deep));
    assert_eq(Set.to_array(only_left), [a]);
    assert_eq(Set.len(Set.intersection(left, left)), 3);
    let collision_only = Set.from_array([a, b]);
    assert_eq(Set.intersection(collision_only, left), collision_only);
    let reversed_collision = Set.from_array([b, a]);
    assert_eq(Set.intersection(collision_only, reversed_collision), collision_only);
    assert_eq(Set.intersection(left, reversed_collision), collision_only);
    let right_with_one_miss = Set.from_array([a, deep]);
    assert_eq(Set.intersection(left, right_with_one_miss), right_with_one_miss);
    assert_eq(Set.difference(left, Set.from_array([deep, 17])), collision_only);
    let single_a = Set.from_array([a]);
    let single_b = Set.from_array([b]);
    assert_eq(Set.intersection(collision_only, single_b), single_b);
    assert_eq(Set.intersection(single_a, Set.from_array([b, deep])), Set.new(()));
    assert_eq(Set.intersection(Set.from_array([a, deep]), single_b), Set.new(()));
    assert_eq(Set.difference(single_a, single_b), single_a);
    assert_eq(Set.difference(single_a, Set.from_array([b, deep])), single_a);
    assert_eq(Set.len(Set.difference(single_b, left)), 0);
    assert_eq(Set.difference(collision_only, Set.from_array([b, deep])), single_a);
    assert_eq(Set.len(Set.difference(right, right)), 0);
    assert_eq(Set.len(left), 3);
    assert(Set.contains(left, a));
    assert(!Set.contains(left, 17));
    assert_eq(Set.len(right), 3);
    assert(Set.contains(right, 17));
    assert(!Set.contains(right, a));

    // Equal keys can still have distinguishable representations.
    let neg = Set.from_array([-0.0]);
    let pos = Set.from_array([0.0]);
    assert_eq(Set.to_array(Set.union(neg, pos))[0].to_string(), "-0");
    assert_eq(Set.to_array(Set.intersection(neg, pos))[0].to_string(), "-0");
    let signed = Set.from_array([-0.0, 1.0, 2.0]);
    assert_eq(Set.to_array(Set.intersection(signed, pos))[0].to_string(), "-0");
    assert_eq(Set.to_array(Set.intersection(neg, Set.from_array([0.0, 1.0])))[0].to_string(), "-0");
    let added = Set.union(signed, Set.from_array([0.0, 3.0]));
    assert_eq(Set.len(added), 4);
    assert(Set.contains(added, 3.0));
    assert(Array.any(Set.to_array(added), |x| x.to_string() == "-0"));
    let remainder = Set.difference(signed, Set.from_array([1.0]));
    assert(Array.any(Set.to_array(remainder), |x| x.to_string() == "-0"));
}

let check_union_key (left: Set[Int]) (right: Set[Int]) (expected: Set[Int]): Unit = {
    let result = Set.union(left, right);
    assert_eq(result, expected);
    let table = Map.insert(Map.new(()), result, 42);
    assert_eq(Map.get(table, expected), Some(42));
}

let check_union_identical_buckets (a: Int) (b: Int) (deep: Int): Unit = {
    let left = Set.from_array([a, b, deep]);
    let right = Set.from_array([a, b, deep]);
    let before = allocation_bytes();
    for i in 0..64 {
        assert_eq(Set.union(left, right), left);
    };
    let after = allocation_bytes();
    if before >= 0 {
        assert(after - before < 256);
    };
    let reversed = Set.from_array([b, a, deep]);
    check_union_key(left, reversed, reversed);
    assert_eq(Set.to_array(left), [a, b, deep]);
}

let check_set_union_collision_order (a: Int) (b: Int) (deep: Int): Unit = {
    let single_a = Set.from_array([a]);
    let single_b = Set.from_array([b]);
    let ab = Set.from_array([a, b]);
    let ba = Set.from_array([b, a]);
    // Union historically keeps right bucket positions, even with different
    // operand sizes. Those positions determine structural key equality.
    check_union_key(single_a, single_b, ba);
    check_union_key(ab, single_b, ba);
    check_union_key(ab, ba, ba);
    let left_branch = Set.from_array([a, deep]);
    let expected = Set.from_array([b, a, deep]);
    check_union_key(left_branch, single_b, expected);
    check_union_key(left_branch, Set.from_array([b, deep]), expected);
    let x = key_in_slot(1, 1);
    let y = key_in_slot(2, 1);
    let separate_slots = Set.from_array([x, y]);
    let separate_union = Set.from_array([b, a, x, y]);
    check_union_key(separate_slots, ba, separate_union);
    check_union_key(ba, separate_slots, separate_union);
    check_union_key(ba, Set.from_array([deep]), Set.from_array([b, a, deep]));
}

// Inverting the two reversible word-mixer rounds supplies real complete-hash
// collisions (the final sign-bit mask identifies these pairs). Verify the
// hashes here so a future hashing change cannot silently weaken this test.
let main (): Unit = {
    let a = 0;
    let b = -3592346752865808038;
    let deep = 7849046083877192578;
    assert_eq(a.hash(), b.hash());
    assert_eq(a.hash(), 0);
    assert_eq(deep.hash(), 1152921504606846976);
    check_terminal_promotion(a, b, deep);
    check_collision_replacements(a, b, deep);
    check_set_snapshots(a, b, deep);
    check_single_candidate_intersection(a, b, deep);
    check_pruned_terminals(a, b, deep);
    check_pruned_bucket(a, b);
    check_set_union_collision_order(a, b, deep);
    check_union_identical_buckets(a, b, deep);
    check_grafted_union(0);
    check_grafted_union(5);
    check_set_traversal();
    // These hashes share the first twelve trie levels. Test each kind
    // of collapse in isolation, including removal from a shared root.
    let path = Map.insert(Map.insert(Map.insert(Map.new(()), a, "a"), b, "b"), deep, "deep");
    let path_keys = Map.keys(path);
    let path_values = Map.values(path);
    assert_eq(path_keys.len(), 3);
    assert_eq(path_values.len(), path_keys.len());
    for i in 0..path_keys.len() {
        assert_eq(Map.get(path, path_keys[i]), Some(path_values[i]));
    };
    let no_deep = Map.remove(path, deep);
    assert_eq(Map.len(no_deep), 2);
    assert_eq(Map.get(no_deep, a), Some("a"));
    assert_eq(Map.get(no_deep, b), Some("b"));
    assert_eq(Map.get(no_deep, deep), None);
    let last = Map.remove(no_deep, a);
    assert_eq(Map.keys(last), [b]);
    assert_eq(Map.values(last), ["b"]);
    let no_a = Map.remove(path, a);
    assert_eq(Map.get(no_a, b), Some("b"));
    assert_eq(Map.get(no_a, deep), Some("deep"));
    assert_eq(Map.get(no_a, a), None);
    assert_eq(Map.get(path, a), Some("a"));
    assert_eq(Map.get(path, deep), Some("deep"));

    let keys = [
        a,
        b,
        deep,
        -586861493372274958,
        -6625778522637806968,
        2831618103098661130,
        1991620495841089180,
        -5038139845957174836,
        -6086893701949170222,
        -3487469807577879104
    ];
    let mut m: Map[Int, String] = Map.new(());
    for i in 0..keys.len() {
        m = Map.insert(m, keys[i], i.to_string());
    };
    let old = m;
    assert_eq(Map.len(m), keys.len());
    for i in 0..keys.len() {
        assert_eq(Map.get(m, keys[i]), Some(i.to_string()));
    };
    m = Map.insert(m, b, "replacement");
    assert_eq(Map.len(m), keys.len());
    assert_eq(Map.get(old, b), Some("1"));
    assert_eq(Map.get(m, b), Some("replacement"));
    // Collision -> leaf, deep singleton branches, and absent removal.
    m = Map.remove(m, a);
    assert_eq(Map.get(m, b), Some("replacement"));
    assert_eq(Map.len(Map.remove(m, a)), keys.len() - 1);
    let snapshot = m;
    for k in keys {
        m = Map.remove(m, k);
    };
    assert_eq(Map.len(m), 0);
    assert_eq(Map.keys(m), []);
    assert_eq(Map.values(m), []);
    assert_eq(Map.get(snapshot, b), Some("replacement"));
    assert_eq(Map.get(old, a), Some("0"));
    m = Map.insert(m, deep, "again");
    assert_eq(Map.get(m, deep), Some("again"));
    // Dense branches and different insertion orders; order is unspecified,
    // but keys and values must enumerate matching positions.
    let mut dense: Map[Int, String] = Map.new(());
    for i in 0..1024 {
        dense = Map.insert(dense, i, i.to_string());
    };
    let before_keys = allocation_bytes();
    let ks = Map.keys(dense);
    assert_projection_bytes(before_keys, 1024);
    let before_values = allocation_bytes();
    let vs = Map.values(dense);
    assert_projection_bytes(before_values, 1024);
    assert_eq(ks.len(), 1024);
    assert_eq(vs.len(), ks.len());
    for i in 0..ks.len() {
        assert_eq(Map.get(dense, ks[i]), Some(vs[i]));
    };
    let holder = ref(dense);
    for i in 0..1024 {
        holder.set(Map.remove(holder.get(), i));
    };
    assert_eq(Map.len(holder.get()), 0);
    assert_eq(Map.len(dense), 1024);
    let floats = Map.insert(Map.new(()), -0.0, "zero");
    assert_eq(Map.len(Map.insert(floats, 0.0, "new")), 1);
    assert_eq(Map.get(floats, 0.0), Some("zero"));
    let set = Set.from_array(keys);
    assert_eq(Set.len(set), keys.len());
    let without_collision = Set.difference(set, Set.from_array([a, b]));
    let survivors = Set.from_array(Array.slice(keys, 2, keys.len()));
    assert_eq(without_collision, survivors);
    assert_eq(without_collision.hash(), survivors.hash());
    assert_eq(Set.len(Set.intersection(set, Set.from_array([a, b]))), 2);
    assert_eq(Set.len(Set.union(set, Set.from_array([a, b]))), keys.len());
    // Preserve generic structural equality and hashing for shared values.
    let mut independent: Map[Int, String] = Map.new(());
    for i in 0..keys.len() {
        independent = Map.insert(independent, keys[i], i.to_string());
    };
    assert_eq(old, independent);
    assert_eq(old.hash(), independent.hash());
    assert_ne(old, snapshot);
    println("map trie ok");
}
