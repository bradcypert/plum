use Time;

extern "C" { fn time_millis_regressions() -> Int; }

let main (): Unit = {
    assert_eq(unsafe { time_millis_regressions() }, 1);
    let before = Time.now();
    let millis = Time.now_millis();
    let after = Time.now();
    assert(millis >= before * 1000 && millis <= after * 1000 + 999);
    println("wall-clock milliseconds: ok")
}
