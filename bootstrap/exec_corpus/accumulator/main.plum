// Tail-recursive accumulators threaded through a call — the shape this
// whole compiler is written in, and the one the self-hosted backend used
// to copy on every iteration. The accumulator is read once on each path,
// so the read hands its reference over instead of lending it, and the
// value grows in place.

let build_str (acc: String) (n: Int): String =
    if n == 0 { acc } else { build_str(acc.concat("ab"), n - 1) }

let build_arr (acc: Array[Int]) (n: Int): Array[Int] =
    if n == 0 { acc } else { build_arr(acc.push(n), n - 1) }

// Read TWICE on one path, so neither may be moved: the second read would
// find a nulled slot.
let twice_str (acc: String): Int = acc.len() + acc.concat("!").len()
let twice_arr (acc: Array[Int]): Int = acc.len() + acc.push(9).len()

// Read once per branch, but the branches are alternatives — still movable.
let branchy (acc: String) (flag: Bool): Int =
    if flag { acc.concat("x").len() } else { acc.len() }

let main (): Unit = {
    println(build_str("", 400).len().to_string());
    println(build_arr([], 500).len().to_string());
    println(twice_str("xyz").to_string());
    println(twice_arr([1, 2, 3]).to_string());
    println(branchy("abcd", true).to_string());
    println(branchy("abcd", false).to_string());
    println(build_str("seed", 0));
    println(build_arr([7], 0).len().to_string());
}
