use Memory;

extern "C" {
    fn map_scoped_close(id: Int) -> Unit;
    fn map_scoped_closed() -> Int;
}

handle Resource { on_drop: map_scoped_close }

struct Owner { resource: Resource }

let make (id: Int): Owner = Owner { resource: unsafe { Resource.from_raw(id) } }

let raw (owner: Option[Owner]): Int = match owner {
    Some(o) => unsafe { o.resource.raw() },
    None => -1,
}

let closed (): Int = unsafe { map_scoped_closed() }

let exercise (): Unit = {
    let mut m: Map[Int, Owner] = Map.new(());
    for i in 0..48 {
        m = Map.insert(m, i, make(i));
    };
    let snapshot = m;
    m = Map.insert(m, 15, make(48));
    m = Map.remove(m, 16);
    m = Map.remove(m, 99);

    assert_eq(Map.len(m), 47);
    assert_eq(Map.len(snapshot), 48);
    for i in 0..48 {
        assert_eq(raw(Map.get(snapshot, i)), i);
        let expected = if i == 15 { 48 } else if i == 16 { -1 } else { i };
        assert_eq(raw(Map.get(m, i)), expected);
    };
    assert_eq(closed(), 0);
}

let key_at (slot: Int) (key: Int): Int =
    if (key.hash() & 31) == slot { key } else { key_at(slot, key + 1) }

let array_bytes (): Int = match Memory.by_origin() {
    None => -1,
    Some(profile) => {
        let mut result = -1;
        for row in profile.rows {
            if row.origin == Memory.Origin.ArrayStorage {
                result = row.stats.live_bytes;
            };
        };
        result
    },
}

let insert_shared_children (): Unit = {
    let mut snapshot: Map[Int, Owner] = Map.new(());
    for i in 1..16 {
        snapshot = Map.insert(snapshot, key_at(i * 2, 0), make(48 + i));
    };
    let slots = [1, 15, 31];
    for i in 0..slots.len() {
        // These hash slots insert at the start, middle, and end of the
        // same shared child array. Each output must own every old child.
        let key = key_at(slots[i], 0);
        let updated = Map.insert(snapshot, key, make(64 + i));
        assert_eq(Map.len(updated), 16);
        assert_eq(raw(Map.get(updated, key)), 64 + i);
        assert_eq(raw(Map.get(snapshot, key)), -1);
        for j in 1..16 {
            let retained_key = key_at(j * 2, 0);
            assert_eq(raw(Map.get(updated, retained_key)), 48 + j);
            assert_eq(raw(Map.get(snapshot, retained_key)), 48 + j);
        };
    };
}

let compact_owned_children (): Unit = {
    let before = array_bytes();
    let mut m: Map[Int, String] = Map.new(());
    for slot in 0..32 {
        m = Map.insert(m, key_at(slot, 0), slot.to_string());
    };
    for slot in 4..32 {
        m = Map.remove(m, key_at(slot, 0));
    };
    let after = array_bytes();
    if before >= 0 {
        // Four entries share one root array. A retained dense buffer would
        // still occupy at least 272 bytes, even without growth reserve.
        assert(after > before && after - before <= 144);
    };
    assert_eq(Map.len(m), 4);
    for slot in 0..4 {
        assert_eq(Map.get(m, key_at(slot, 0)), Some(slot.to_string()));
    };
}

let project_owners (m: Map[Int, Owner]): (Array[Int], Array[Owner]) =
    (Map.keys(m), Map.values(m))

let check_projected_owners (): Unit = {
    let keys = [0, -3592346752865808038, 7849046083877192578, 17];
    let mut m: Map[Int, Owner] = Map.new(());
    for i in 0..keys.len() {
        m = Map.insert(m, keys[i], make(67 + i));
    };
    let (actual, owners) = project_owners(m);
    assert_eq(closed(), 67);
    assert_eq(actual.len(), keys.len());
    assert_eq(owners.len(), keys.len());
    for i in 0..owners.len() {
        let id = unsafe { owners[i].resource.raw() };
        assert_eq(actual[i], keys[id - 67]);
    };
}

let build_scoped_map (): Map[Int, Owner] = {
    let values = [make(71), make(72), make(73), make(74)];
    let map = Map.from_arrays([1, 1, 2], values);
    assert_eq(closed(), 71);
    map
}

let check_bulk_owners (): Unit = {
    let map = build_scoped_map();
    // The overwritten value and the unpaired tail closed at scope exit.
    // Both returned owners remain live.
    assert_eq(closed(), 73);
    assert_eq(Map.len(map), 2);
    assert_eq(raw(Map.get(map, 1)), 72);
    assert_eq(raw(Map.get(map, 2)), 73);
}

let check_collision_owners (): Unit = {
    let a = 0;
    let b = -3592346752865808038;
    assert_eq(a.hash(), b.hash());
    let mut map = Map.insert(Map.insert(Map.new(()), a, make(75)), b, make(76));
    map = Map.insert(map, a, make(77));
    assert_eq(closed(), 76);
    let snapshot = map;
    map = Map.insert(map, a, make(78));
    assert_eq(closed(), 76);
    assert_eq(raw(Map.get(snapshot, a)), 77);
    assert_eq(raw(Map.get(map, a)), 78);
    assert_eq(raw(Map.get(snapshot, b)), 76);
    assert_eq(raw(Map.get(map, b)), 76);
}

let check_promoted_owners (): Unit = {
    let a = 0;
    let b = -3592346752865808038;
    {
        let mut map = Map.from_arrays([a, b], [make(79), make(80)]);
        map = Map.remove(map, b);
        assert_eq(closed(), 80);
        assert_eq(raw(Map.get(map, a)), 79);
    };
    assert_eq(closed(), 81);
    {
        let other = key_at(1, 1);
        let snapshot = Map.from_arrays([a, other], [make(81), make(82)]);
        let result = Map.remove(snapshot, a);
        assert_eq(closed(), 81);
        assert_eq(raw(Map.get(result, other)), 82);
        assert_eq(raw(Map.get(snapshot, a)), 81);
    };
}

let main (): Unit = {
    exercise();
    assert_eq(closed(), 49);
    insert_shared_children();
    assert_eq(closed(), 67);
    compact_owned_children();
    check_projected_owners();
    assert_eq(closed(), 71);
    check_bulk_owners();
    assert_eq(closed(), 75);
    check_collision_owners();
    assert_eq(closed(), 79);
    check_promoted_owners();
    assert_eq(closed(), 83);
    println("Map updates preserve shared resource owners and release each exactly once")
}
