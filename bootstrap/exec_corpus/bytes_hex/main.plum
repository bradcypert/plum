use Encoding;
let main (): Unit = {
    let mut values = [];
    for i in 0..256 { values = values.push(i); };
    let all = Bytes.from_array(values);
    let want = "";
    assert_eq(all.to_hex(), want);
    assert_eq(Encoding.hex_encode(all), want);
    assert_eq(Bytes.empty().to_hex(), "");
    assert_eq(Encoding.hex_encode(Bytes.empty()), "");
    let mut source = all;
    let alias = source;
    let input_view = unsafe { source.as_cstr() };
    let mut encoded = source.to_hex();
    let saved = encoded;
    let output_bytes = saved.as_bytes();
    let output_view = unsafe { saved.as_cstr() };
    encoded = encoded.concat("changed");
    source = source.concat(Bytes.from_array([0, 255]));
    assert_eq(saved, want);
    assert_eq(output_bytes.to_array(), want.as_bytes().to_array());
    assert_eq(unsafe { output_view.as_string() }, want);
    assert_eq(encoded, want.concat("changed"));
    assert_eq(alias.to_array(), values);
    // This input view starts with NUL, while Bytes itself retains all 256 bytes.
    assert_eq(unsafe { input_view.as_string() }, "");
    assert_eq(source.to_array(), values.push(0).push(255));
    assert_eq("aé\x00🙂".as_bytes().to_hex(), "61c3a900f09f9982");
    assert_eq(Bytes.from_array([255, 128, 16, 1]).to_hex(), "ff801001");
    let large = "aé\x00🙂".repeat(32768).as_bytes();
    assert_eq(large.to_hex(), "61c3a900f09f9982".repeat(32768));
    assert_eq(large.len(), 262144);
    println("Bytes hex: all byte values, exact output, empty, binary and immutable aliases")
}
