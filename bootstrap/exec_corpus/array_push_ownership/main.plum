use Memory;

extern "C" {
    fn push_close(n: Int) -> Unit; fn push_closed(n: Int) -> Int; fn push_total() -> Int; fn push_pattern(
        i: Int
    ) -> Float; fn push_bits(n: Float) -> Int;
}

handle Resource { on_drop: push_close }

let make (n: Int): Resource = unsafe { Resource.from_raw(n) }

let live (): Int = match Memory.snapshot() {
    Some(s) => s.live_bytes,
    None => -1
}

let ints (n: Int): Array[Int] = [n, n + 1, n + 2, n + 3]

let append[T] (xs: Array[T]) (value: T): Array[T] = xs.push(value)

let resources (): Unit = {
    let mut owners: Array[Resource] = [];
    for i in 0..128 {
        owners = owners.push(make(i));
    };
    assert_eq(unsafe { push_total() }, 0);
    let saved = owners;
    owners = owners.push(make(128));
    owners = owners.push(owners[0]);
    assert_eq(saved.len(), 128);
    assert_eq(owners.len(), 130);
    for i in 0..129 {
        assert_eq(unsafe { owners[i].raw() }, i);
    };
    assert_eq(unsafe { owners[129].raw() }, 0);
    assert_eq(unsafe { push_total() }, 0);
}

let memory_round (): Unit = {
    let source = ints(10);
    let before = live();
    let out = source.push(14);
    if before >= 0 {
        assert_eq(live() - before, 56);
    };
    assert_eq(source, [10, 11, 12, 13]);
    assert_eq(out, [10, 11, 12, 13, 14]);
    let mut reserved = "x".repeat(4096).as_bytes().to_array();
    reserved = reserved.filter(|x| false);
    let before = live();
    reserved = reserved.push(7);
    if before >= 0 {
        assert_eq(live(), before);
    };
    assert_eq(reserved, [7]);
}

let main (): Unit = {
    let baseline = live();
    memory_round();
    resources();
    if baseline >= 0 {
        assert_eq(live(), baseline);
    };
    assert_eq(unsafe { push_total() }, 129);
    for i in 0..129 {
        assert_eq(unsafe { push_closed(i) }, 1);
    };
    let mut versions: Array[Array[Int]] = [];
    let mut xs: Array[Int] = [];
    for i in 0..256 {
        versions = versions.push(xs);
        xs = xs.push(i);
    };
    for i in 0..256 {
        assert_eq(versions[i].len(), i);
        for j in 0..i {
            assert_eq(versions[i][j], j);
        };
    };
    assert_eq(xs.len(), 256);
    assert_eq(xs[255], 255);
    let mut words: Array[String] = [];
    for i in 0..4096 {
        words = words.push(i.to_string());
    };
    for i in 0..4096 {
        assert_eq(words[i], i.to_string());
    };
    let first = words[0];
    let view = first.as_cstr();
    let bytes = first.as_bytes();
    let changed = words.push(first);
    assert_eq(words.len(), 4096);
    assert_eq(changed[4096], first);
    assert_eq(unsafe { view.as_string() }, "0");
    assert_eq(bytes.to_hex(), "30");
    let mut source = ints(0);
    let out = source.push(
        {
            source = ints(10);
            99
        }
    );
    assert_eq(out, [0, 1, 2, 3, 99]);
    assert_eq(source, ints(10));
    let published = ref(ints(0));
    let receiver = ints(20);
    let out = receiver.push(
        {
            published.set(receiver);
            99
        }
    );
    assert_eq(out, [20, 21, 22, 23, 99]);
    assert_eq(published.get(), ints(20));
    assert_eq([true, false].push(true), [true, false, true]);
    assert_eq([()].push(()), [(), ()]);
    let small: Array[U8] = [0, 255];
    assert_eq(small.push(128), [0, 255, 128]);
    let wide: Array[U64] = [18446744073709551615];
    assert_eq(wide.push(9223372036854775808), [18446744073709551615, 9223372036854775808]);
    let floats = [
        unsafe { push_pattern(0) },
        unsafe { push_pattern(1) },
        unsafe { push_pattern(2) }
    ];
    let changed = floats.push(unsafe { push_pattern(3) });
    for i in 0..4 {
        assert_eq(unsafe { push_bits(changed[i]) }, unsafe { push_bits(push_pattern(i)) });
    };
    assert_eq(floats.len(), 3);
    let f: (Array[Int], Int) -> Array[Int] = append;
    assert_eq(f(ints(0), 4), [0, 1, 2, 3, 4]);
    let shared = ints(0);
    let left = spawn { shared.push(4) };
    let right = spawn { shared.push(5) };
    assert_eq(left.join(), [0, 1, 2, 3, 4]);
    assert_eq(right.join(), [0, 1, 2, 3, 5]);
    assert_eq(shared, ints(0));
    println("Array.push: owned growth, exact shared copies, operand order and child lifetimes")
}
