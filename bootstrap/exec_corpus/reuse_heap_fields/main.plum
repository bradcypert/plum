// A struct with a String field, rebuilt in a loop. Its cell IS
// recycled -- the reuse path drops the old field before the new one is
// stored -- and the point of the fixture is that the drop and the
// increment cancel exactly.
//
// `n: v.n` copies the field straight across, so the old and the new
// value are the same pointer. `cg_field_read` increments what it loads
// and the reuse drops what the cell held, in that order. Get the order
// backwards and the string is freed while the literal is still storing
// it; skip the drop and it leaks. The corpus runs under
// `detect_leaks=1`, which is what makes this a test rather than a
// comment.
struct Named { n: String, k: Int }

let go (v: Named) (i: Int): Named =
    if i <= 0 { v } else { go(Named { n: v.n, k: v.k + 1 }, i - 1) }

let main (): Unit = {
    let r = go(Named { n: "x", k: 0 }, 3);
    println(r.n.concat(r.k.to_string()))
}
