#!/usr/bin/env bash
# The user-facing commands nothing else runs.
#
# Every other harness here drives `check`, `build`, `run`, `test`,
# `emit-llvm` or `fmt`, because those are what the compiler's own
# development needs. Four documented commands were left over, and the
# most exposed one is the one a person types FIRST:
#
#   plum new        scaffolds a project, and its template embeds a
#                   `test_greet` function. If the template stopped
#                   compiling, the first person to find out would be
#                   somebody trying the language for the first time.
#   plum doc DIR    the USER-facing half of `plum doc`. `check-docs` and
#                   `build-site` both exercise `--stdlib`, which takes a
#                   different path through `cmd_doc_stdlib`; nothing ran
#                   it on an ordinary project directory, which is the
#                   mode the documentation tells people to use.
#   dump-tokens     documented in `bootstrap/README.md`, invoked by
#   dump-ast        nothing. `tokens` and `ast` are covered by the
#                   corpus goldens; these two are their debug siblings
#                   and share none of that coverage.
#
# And one BEHAVIOUR rather than a command: which of a project's
# `native/*.c` sources get compiled for which target. That is checked
# here because it is only observable through `plum build` and `plum run`.
#
# Deliberately shallow. This is a smoke test: it asserts each command
# runs, produces the shape it promises, and exits 0. What the output
# MEANS is `corpus-check`'s job and `check-docs`'s job.
#
# Usage:  bootstrap/cli-smoke [path-to-plum-binary]   (default: ./sh)
set -uo pipefail

root="$(cd "$(dirname "${BASH_SOURCE[0]}")/.." && pwd)"
cd "$root"
plum="${1:-./sh}"

work="$(mktemp -d 2>/dev/null || mktemp -d -t plum-cli)"
trap 'rm -rf "$work"' EXIT

fail=0
ok=0

check() {
    if [ "$1" -eq 0 ]; then ok=$((ok + 1)); else printf 'FAIL  %s\n' "$2"; fail=$((fail + 1)); fi
}

# --- plum new ---------------------------------------------------------

# Run from INSIDE the temp directory: `new` takes a name, not a path,
# and creates the directory relative to the working directory.
( cd "$work" && SH_TIMEOUT="${SH_TIMEOUT:-60}" "$root/$plum" new hello ) > "$work/new.log" 2>&1
check $? "plum new exited nonzero: $(head -n 1 "$work/new.log")"

[ -f "$work/hello/main.plum" ]; check $? "plum new did not write main.plum"

# Exactly one file, which is a property the documentation states in
# several places and which packages deliberately did not change: a
# project with no dependencies needs no manifest.
[ "$(find "$work/hello" -type f | wc -l)" -eq 1 ]; check $? "plum new wrote more than one file"

# The scaffold must RUN, not merely exist.
out="$(SH_MEM="${SH_MEM:-512M}" SH_TIMEOUT="${SH_TIMEOUT:-120}" "$plum" run "$work/hello" 2>&1)"
[ "$out" = "hello, plum" ]; check $? "plum new's scaffold did not run: $out"

# And its embedded test must pass. The template advertises `plum test`
# in the message `new` prints, so a template whose test fails teaches a
# new user that the test runner is broken.
out="$(SH_MEM="${SH_MEM:-512M}" SH_TIMEOUT="${SH_TIMEOUT:-120}" "$plum" test "$work/hello" 2>&1)"
printf '%s' "$out" | grep -q '1 passed; 0 failed'; check $? "plum new's scaffold test did not pass: $(printf '%s' "$out" | tail -n 1)"

# Refusing to overwrite is the one destructive-adjacent behaviour here.
( cd "$work" && "$root/$plum" new hello ) > "$work/new2.log" 2>&1
[ $? -ne 0 ]; check $? "plum new overwrote an existing directory"

# --- plum doc on a PROJECT --------------------------------------------

mkdir -p "$work/proj/greet"
cat > "$work/proj/greet/greet.plum" <<'EOF'
/// Greets somebody.
pub let hello (who: String): String = "hello, ".concat(who)
let private_helper (): Int = 1
EOF
printf 'use greet;\nlet main (): Unit = println(greet.hello("x"))\n' > "$work/proj/main.plum"

SH_TIMEOUT="${SH_TIMEOUT:-120}" "$plum" doc "$work/proj" -o "$work/docs" > "$work/doc.log" 2>&1
check $? "plum doc on a project exited nonzero: $(head -n 1 "$work/doc.log")"

[ -f "$work/docs/greet.md" ]; check $? "plum doc wrote no page for module greet"
[ -f "$work/docs/index.md" ]; check $? "plum doc wrote no index.md"
grep -q 'Greets somebody' "$work/docs/greet.md"; check $? "the /// text did not reach the page"
# `pub` is the public surface. A private helper carrying no `///` would
# be invisible anyway; this one has a name that would show if the filter
# broke.
! grep -q 'private_helper' "$work/docs/greet.md"; check $? "a private declaration was published"

SH_TIMEOUT="${SH_TIMEOUT:-120}" "$plum" doc "$work/proj" -o "$work/dochtml" --html > "$work/doch.log" 2>&1
check $? "plum doc --html on a project exited nonzero: $(head -n 1 "$work/doch.log")"
[ -f "$work/dochtml/index.html" ] && [ -f "$work/dochtml/style.css" ]
check $? "plum doc --html did not write index.html and style.css"

# --- plum doc does not publish a DEPENDENCY's API ----------------------
#
# Issue #49. `plum doc myapp` documented every package `myapp` depends
# on, under `myapp`'s name, in `myapp`'s output directory -- a
# consequence of dependencies reaching every command through
# `collect_project` rather than a decision anyone made.
#
# The dependency here declares a module whose name could not collide
# with the consumer's (`vendored`), so a page for it is unambiguous
# evidence and not a naming accident. Both directions are checked: the
# default must NOT write it, and `--with-deps` must.

mkdir -p "$work/vendor/vendored"
cat > "$work/vendor/plum.pkg" <<'EOF'
Package { name: "vendor", version: "0.1.0" }
EOF
cat > "$work/vendor/vendored/vendored.plum" <<'EOF'
/// Something the consumer did not write.
pub let borrowed (): Int = 7
EOF
cat > "$work/proj/plum.pkg" <<'EOF'
Package {
    name: "proj",
    version: "0.1.0",
    deps: [ Dep { name: "vendor", path: "../vendor" } ],
}
EOF

SH_TIMEOUT="${SH_TIMEOUT:-120}" "$plum" doc "$work/proj" -o "$work/docs2" > "$work/doc2.log" 2>&1
check $? "plum doc on a project with a dependency exited nonzero: $(head -n 1 "$work/doc2.log")"
[ -f "$work/docs2/greet.md" ]; check $? "plum doc dropped the project's OWN module"
! ls "$work/docs2" | grep -q 'vendor'; check $? "plum doc published a dependency's page by default"
! grep -rq 'borrowed' "$work/docs2"; check $? "a dependency's declaration reached the default output"

SH_TIMEOUT="${SH_TIMEOUT:-120}" "$plum" doc "$work/proj" -o "$work/docs3" --with-deps > "$work/doc3.log" 2>&1
check $? "plum doc --with-deps exited nonzero: $(head -n 1 "$work/doc3.log")"
[ -f "$work/docs3/greet.md" ]; check $? "--with-deps dropped the project's own module"
[ -f "$work/docs3/vendor.vendored.md" ]
check $? "--with-deps did not write the dependency's page (expected vendor.vendored.md)"
grep -q 'borrowed' "$work/docs3/vendor.vendored.md"
check $? "--with-deps wrote the page without the declaration"

# The note only fires where it helps: this project HAS its own module,
# so it must not be told to pass a flag it does not need.
! grep -q 'with-deps' "$work/doc2.log"
check $? "plum doc suggested --with-deps to a project that documented its own modules"

# Building still sees the dependency. The split is `doc`'s alone, and a
# `doc` change that quietly stopped `build` resolving packages would be
# a far worse bug than the one being fixed.
printf 'use greet;\nuse vendor.vendored as v;\nlet main (): Unit = println(greet.hello(v.borrowed().to_string()))\n' > "$work/proj/main.plum"
SH_TIMEOUT="${SH_TIMEOUT:-120}" "$plum" check "$work/proj" > "$work/depcheck.log" 2>&1
check $? "the project stopped type-checking against its dependency: $(head -n 1 "$work/depcheck.log")"

# --- native/ source selection -----------------------------------------
#
# `native/*.c` is compiled for every target; `native/<os>/*.c` only when
# that target is being built. The proof in both directions is an
# `#error` in the directory that must NOT be reached: a file that is
# compiled says so, and a file that is skipped is silent.

mkdir -p "$work/nat/native/posix" "$work/nat/native/windows"
printf 'int plum_common_marker(void) { return 1; }\n' > "$work/nat/native/common.c"
printf '#include <unistd.h>\nint plum_posix_marker(void) { return 2; }\n' > "$work/nat/native/posix/p.c"
printf '#error "a windows source was compiled for a non-windows target"\n' > "$work/nat/native/windows/w.c"
cat > "$work/nat/main.plum" <<'EOF'
extern "C" {
    fn plum_common_marker() -> Int;
    fn plum_posix_marker() -> Int;
}
let main (): Unit = unsafe { println("${(plum_common_marker() + plum_posix_marker()).to_string()}") }
EOF

# On this machine (Linux or macOS) `common` and `posix` are compiled and
# `windows` is not. If `windows/` were reached the `#error` would fail
# the build, so a successful run IS the assertion.
out="$(SH_MEM="${SH_MEM:-512M}" SH_TIMEOUT="${SH_TIMEOUT:-180}" "$plum" run "$work/nat" 2>&1)"
[ "$out" = "3" ]; check $? "native/ selection on the host: expected 3, got: $(printf '%s' "$out" | tail -n 1)"

# The other direction, and it needs NO cross toolchain. Target Windows
# and the roles swap: `windows/` must now be reached and `posix/` must
# not. The link will fail here for want of Windows headers, which is
# fine -- this asserts on WHICH sources clang was handed, not on the
# outcome.
#
# Both halves are needed. Asserting only that the posix `#error` is
# absent would pass vacuously if clang gave up before reaching any
# platform source; requiring the windows one to FIRE proves it got there.
printf '#error "a posix source was compiled for a windows target"\n' > "$work/nat/native/posix/p.c"
printf '#error "the windows source was reached"\n' > "$work/nat/native/windows/w.c"
xout="$(SH_MEM="${SH_MEM:-512M}" SH_TIMEOUT="${SH_TIMEOUT:-180}" "$plum" build "$work/nat" --target x86_64-pc-windows-gnu -o "$work/nat/out.exe" 2>&1)"
printf '%s' "$xout" | grep -q 'the windows source was reached'
check $? "targeting windows did not compile native/windows/"
! printf '%s' "$xout" | grep -q 'a posix source was compiled'
check $? "targeting windows compiled native/posix/"

# An unrecognized subdirectory is an error rather than something
# skipped, so `native/win32/` cannot compile on no target at all.
mkdir -p "$work/nat/native/win32"
printf 'int stray(void) { return 0; }\n' > "$work/nat/native/win32/x.c"
uout="$(SH_MEM="${SH_MEM:-512M}" SH_TIMEOUT="${SH_TIMEOUT:-180}" "$plum" run "$work/nat" 2>&1)"
printf '%s' "$uout" | grep -q 'not a target directory'
check $? "an unknown native/ subdirectory was not reported: $(printf '%s' "$uout" | tail -n 1)"
rm -rf "$work/nat/native/win32"

# --- dump-tokens / dump-ast -------------------------------------------
#
# Their non-dump siblings are pinned byte-for-byte by 98 corpus goldens.
# These two share none of that, so all this asserts is that they run and
# say something about the file they were given.

SH_TIMEOUT="${SH_TIMEOUT:-60}" "$plum" dump-tokens "$work/proj/main.plum" > "$work/tok.txt" 2>&1
check $? "dump-tokens exited nonzero: $(head -n 1 "$work/tok.txt")"
[ -s "$work/tok.txt" ] && grep -q 'println' "$work/tok.txt"
check $? "dump-tokens produced nothing recognisable"

SH_TIMEOUT="${SH_TIMEOUT:-60}" "$plum" dump-ast "$work/proj/main.plum" > "$work/ast.txt" 2>&1
check $? "dump-ast exited nonzero: $(head -n 1 "$work/ast.txt")"
[ -s "$work/ast.txt" ] && grep -q 'main' "$work/ast.txt"
check $? "dump-ast produced nothing recognisable"

if [ "$fail" -ne 0 ]; then
    printf '\ncli-smoke: %d check(s) failed, %d passed\n' "$fail" "$ok"
    exit 1
fi
printf 'cli-smoke: %d checks pass -- new, doc on a project, dump-tokens, dump-ast\n' "$ok"
