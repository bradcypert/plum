#!/usr/bin/env bash
# Compiles and runs every code snippet in the published prose, and
# checks each against the output the document claims.
#
# Documentation rots silently, and this project has proved it more than
# once: the README described an interpreter for a day after the
# interpreter was deleted, and its own text contained a note that a
# previous claim "stopped being true in 2026-08 and the sentence
# stayed". Prose cannot be tested. A snippet with its output beside it
# can be, so the tutorial is written that way on purpose -- every
# example is a COMPLETE program rather than a fragment.
#
# Three kinds of block are understood:
#
#   * a ```plum block followed by a plain ``` block -- built, run, and
#     its output compared exactly
#   * a ```plum block followed by a plain ``` block starting with
#     `error:` -- expected NOT to compile, with that message
#   * anything else -- built only, to prove it at least compiles
#
# A RUN of consecutive ```plum blocks is ONE project, so a module
# example -- which cannot be a single file -- can be checked too: a
# block headed `// shapes/circle.plum` becomes that file, and a block
# with no such header becomes `main.plum`.
#
# Writing the first draft, this caught a paraphrased error message:
# the doc said `non-exhaustive match: missing Rect` and the compiler
# says `match is not exhaustive — missing variant(s): Rect`.
#
# Usage:  bootstrap/doc-check [path-to-plum-binary]     (default: ./sh)
set -uo pipefail

root="$(cd "$(dirname "${BASH_SOURCE[0]}")/.." && pwd)"
cd "$root"

plum="${1:-./sh}"

PY_BIN="$(command -v python3 || command -v python)"
[ -n "$PY_BIN" ] || { echo "doc-check: needs python3 to extract the snippets" >&2; exit 1; }

fail=0

# The file list is DERIVED from `bootstrap/build-site`, not written out
# here. Every document published to plumlang.org gets its snippets
# compiled, and a new page cannot be added to the site without also
# being checked -- which is exactly the failure this harness exists to
# prevent, applied to itself.
#
# README.md is added on top because it is the front door and is not a
# site page.
docs="README.md $(awk '/^page /{print $2}' bootstrap/build-site)"

for doc in $docs; do
    [ -f "$doc" ] || { echo "doc-check: $doc does not exist"; fail=1; continue; }
    "$PY_BIN" bootstrap/doc_check.py "$doc" "$plum" || fail=1
done

exit $fail
