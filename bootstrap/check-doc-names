#!/usr/bin/env bash
# Every standard-library name the documentation mentions in PROSE exists.
#
# `bootstrap/doc-check` compiles the code BLOCKS. The prose around them
# is full of names too -- `Array.filter`, `Os.read_file`, `Map.insert` --
# and nothing looked at those. Sixty-seven of them in README.md alone.
#
# This project has been bitten by unchecked prose three times in a week:
# bounded type parameters "are supported" (they parsed and were
# discarded), two same-named types "do not silently unify" (they did),
# and "no mandatory parameter types" (there are). A named function is
# the part of prose that CAN be checked mechanically, so it is.
#
# The name set is whatever `plum complete` reports for a project that
# `use`s every standard-library module -- the same list the editor
# offers, so this also fails if completion stops reporting something.
# A name is only checked when its namespace is one the compiler knows,
# which is what keeps `Point.add` in a worked example from being
# mistaken for a standard-library claim.
set -uo pipefail

root="$(cd "$(dirname "${BASH_SOURCE[0]}")/.." && pwd)"
cd "$root"

plum="${1:-./sh}"
PY_BIN="$(command -v python3 || command -v python)"
[ -n "$PY_BIN" ] || { echo "check-doc-names: needs python3" >&2; exit 1; }

work="$(mktemp -d)"
trap 'rm -rf "$work"' EXIT
# The `use` list is DERIVED from the compiler, not typed out here.
#
# It used to be a hand-written `use Os; use Time; use Net; use Http;
# use Process;` -- five of the ten modules `parser.std_module_names()`
# actually has. A name is only checkable when its namespace appears in
# completion's answer, so every `Json.*` and `Terminal.*` name in the
# documentation was silently unverifiable, and fabricated ones passed
# under "all real".
#
# That is verbatim the bug `main.plum`'s own `all_std_uses` comment
# records fixing IN THE COMPILER: "a hand-maintained second copy of that
# list... Found when `Encoding` landed and silently did not appear."
# The harness kept its copy.
mods="$(grep -oE 'pub let std_module_names \(\): Array\[String\] = \[[^]]*\]' \
    bootstrap/self_host/parser/parser.plum | grep -oE '"[A-Za-z_]+"' | tr -d '"')"
if [ -z "$mods" ]; then
    echo "check-doc-names: could not read std_module_names from parser.plum" >&2
    exit 1
fi
: > "$work/main.plum"
for m in $mods; do printf 'use %s;\n' "$m" >> "$work/main.plum"; done
printf 'let main (): Unit = println("x")\n' >> "$work/main.plum"

if ! "$plum" complete "$work" > "$work/names.json" 2>"$work/err"; then
    echo "check-doc-names: \`plum complete\` failed: $(head -n 1 "$work/err")" >&2
    exit 1
fi

# Derived from `bootstrap/build-site` for the same reason `doc-check`
# derives it: a page published to plumlang.org that nothing checks is
# how a document starts naming functions that no longer exist.
docs="README.md $(awk '/^page /{print $2}' bootstrap/build-site)"

# shellcheck disable=SC2086
"$PY_BIN" - "$work/names.json" "$mods" $docs <<'PY'
import re, json, sys
names = set(x["name"] for x in json.load(open(sys.argv[1])))
spaces = set(n.split(".")[0] for n in names if "." in n)
fails = 0

# Every standard-library module must have reached completion, or this
# harness is checking a subset of the documentation while reporting on
# all of it. A module missing here means the fixture did not `use` it,
# or completion stopped offering it -- either way names in that
# namespace become unverifiable AND are reported as "all real".
absent = [m for m in sys.argv[2].split() if m not in spaces]
if absent:
    print("FAIL completion offered nothing for: %s" % " ".join(absent))
    fails += len(absent)

# A nested namespace (`Os.File.read`) needs the middle segment to be
# allowed a capital. The old pattern required the second segment to
# start lowercase, so an entire page of `docs/stdlib/` was unmatchable.
NAME = re.compile(r"`([A-Z][A-Za-z0-9_]*(?:\.[A-Za-z0-9_]+)+)`")
total = 0
for doc in sys.argv[3:]:
    prose = re.sub(r"```.*?```", "", open(doc).read(), flags=re.S)
    claimed = sorted(set(NAME.findall(prose)))
    checkable = [c for c in claimed if c.split(".")[0] in spaces]
    missing = [c for c in checkable if c not in names]
    total += len(checkable)
    for m in missing:
        print("FAIL %s names `%s`, which does not exist" % (doc, m))
    fails += len(missing)
    if not missing:
        print("ok   %-12s %d standard-library names in prose, all real" % (doc + ":", len(checkable)))

# Zero names across EVERY document is not a pass. A per-document zero is
# fine and expected -- the README is an 88-line front door that names
# none -- but the whole set yielding nothing means the pattern or the
# document list has stopped matching, which is the failure this harness
# already had once.
if total == 0:
    print("FAIL no standard-library names matched in any document -- nothing was checked")
    fails += 1
sys.exit(1 if fails else 0)
PY
