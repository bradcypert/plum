#!/usr/bin/env python3
"""Fails if a built site links to a page it does not contain.

The site is stitched together from two generators that know nothing
about each other -- Hugo for the prose, `plum doc` for the reference --
so the links BETWEEN them are the ones nothing else checks. A renamed
prose page or a standard-library module that stops existing breaks a
link that no compiler, no Hugo build, and no test would notice.

    bootstrap/check-site-links site/public

External links are not followed: this is a build step, not a crawler,
and it must not fail because someone else's server is down.
"""
import os
import re
import sys
import urllib.parse

# Three attribute forms, because Hugo's `--minify` DROPS the quotes.
# A quoted-only pattern silently matches nothing on a minified page and
# reports a clean bill of health for a site it never looked at -- which
# is what the first version of this script did.
LINK = re.compile(r"""(?:href|src)\s*=\s*(?:"([^"]*)"|'([^']*)'|([^\s"'<>`]+))""")
SKIP = ("http://", "https://", "mailto:", "data:", "#", "//")


def main(root: str) -> int:
    root = os.path.abspath(root)
    if not os.path.isdir(root):
        print(f"check-site-links: {root} is not a directory", file=sys.stderr)
        return 1

    broken, pages = [], 0
    for dirpath, _, filenames in os.walk(root):
        for name in filenames:
            if not name.endswith(".html"):
                continue
            pages += 1
            path = os.path.join(dirpath, name)
            with open(path, encoding="utf8") as handle:
                html = handle.read()
            for quoted, single, bare in LINK.findall(html):
                raw = quoted or single or bare
                if raw.startswith(SKIP):
                    continue
                target = urllib.parse.unquote(urllib.parse.urldefrag(raw)[0])
                if not target:
                    continue
                # A leading `/` is site-absolute; anything else is
                # relative to the page that wrote it.
                base = root if target.startswith("/") else dirpath
                full = os.path.join(base, target.lstrip("/"))
                if os.path.exists(full) or os.path.exists(os.path.join(full, "index.html")):
                    continue
                broken.append((os.path.relpath(path, root), raw))

    if broken:
        print(f"check-site-links: {len(broken)} broken link(s)")
        for page, link in sorted(set(broken)):
            print(f"  {page} -> {link}")
        return 1

    print(f"check-site-links: {pages} page(s), no broken internal links")
    return 0


if __name__ == "__main__":
    sys.exit(main(sys.argv[1] if len(sys.argv) > 1 else "site/public"))
