#!/usr/bin/env bash
# Regenerates every `examples/*/expected.txt` — the recordings
# `bootstrap/example-sweep` checks against.
#
# Run this only when an example's output is MEANT to change. A sweep
# failure is otherwise a bug report, and re-recording is how you erase
# one: the recording is the reference precisely because it does not move
# when the compilers do.
#
# It records with the self-hosted compiler, which is the only one with
# a backend since 2026-08-21. Until then it recorded with the REAL
# compiler on the principle that a recording should come from the
# implementation being retired rather than the one replacing it. With
# the Rust backend gone that principle has nothing to attach to, and
# this is simply "record what it does now" -- which is why re-recording
# needs more care than it used to, not less.
#
# Examples are run from a TEMP directory, matching how `example-sweep`
# runs them. `json_and_files` writes a file into its working directory;
# recording from inside `examples/json_and_files/` drops that artifact
# into the repo.
set -euo pipefail

root="$(cd "$(dirname "${BASH_SOURCE[0]}")/.." && pwd)"
cd "$root"
work="$(mktemp -d -t plum-record-XXXXXX)"
trap 'rm -rf "$work"' EXIT

declare -A no_run=([asteroids]="opens a window (raylib)")
declare -A link_flags=([asteroids]="--link-lib raylib")

for dir in examples/*/; do
    name="$(basename "$dir")"
    [ -f "$dir/main.plum" ] || continue
    if [ -n "${no_run[$name]:-}" ]; then
        printf '  skip  %-24s %s\n' "$name" "${no_run[$name]}"
        continue
    fi

    native_flag=""
    if [ -d "$dir/native" ]; then
        for c in "$dir"/native/*.c; do [ -e "$c" ] && native_flag="$native_flag --link-c $c"; done
    fi

    SH_MEM="${SH_MEM:-4G}" SH_TIMEOUT="${SH_TIMEOUT:-240}" ./sh emit-llvm "$dir" > "$work/ir.ll" 2>"$work/err" || {
        printf '  FAIL  %-24s %s\n' "$name" "$(head -1 "$work/err")"; continue; }
    clang_flags="$(printf '%s %s' "${link_flags[$name]:-}" "$native_flag" | sed 's/--link-lib */-l/g; s/--link-c *//g')"
    clang -O2 -Wno-override-module "$work/ir.ll" \
        native_stdlib/compat_shim.c native_stdlib/dir_shim.c \
        native_stdlib/io_shim.c native_stdlib/os_shim.c \
        native_stdlib/process_shim.c native_stdlib/thread_shim.c \
        $clang_flags -lm -o "$work/bin" > "$work/err" 2>&1 || {
        printf '  FAIL  %-24s %s\n' "$name" "$(head -1 "$work/err")"; continue; }

    (cd "$work" && ./bin > "$work/out.txt" 2>&1) || true
    if [ -f "$dir/expected.txt" ] && cmp -s "$work/out.txt" "$dir/expected.txt"; then
        printf '  same  %-24s\n' "$name"
    else
        cp "$work/out.txt" "$dir/expected.txt"
        printf '  WROTE %-24s %s lines\n' "$name" "$(wc -l < "$dir/expected.txt")"
    fi
done
