#!/usr/bin/env bash
# Builds a working Plum compiler from the checked-in SEED, using clang
# and nothing else — no Rust toolchain, no existing `./sh`.
#
# This is the answer to "I just cloned this; how do I get a compiler?"
# The self-hosted compiler needs a Plum compiler to build it, and the
# seed is that compiler, shipped as LLVM IR: readable text, diffable,
# and turned into a binary by the same `clang` the project already
# requires.
#
# Usage:  ./bootstrap/from-seed [-o <out>]     (default: ./sh.seed)
set -euo pipefail

root="$(cd "$(dirname "${BASH_SOURCE[0]}")/.." && pwd)"
cd "$root"

out="./sh.seed"
if [ "${1:-}" = "-o" ] && [ -n "${2:-}" ]; then out="$2"; fi

seed="bootstrap/seed/plum.ll"
[ -f "$seed" ] || { echo "missing $seed -- run bootstrap/gen-seed" >&2; exit 1; }

# The same shims the compiler embeds (see `bootstrap/gen-shims`).
# `net_shim.c` is not among them: nothing in the compiler calls it.
# `os_shim.c` very much is -- it is how the compiler makes temp
# directories, deletes them, and finds its own executable.
# `compat_shim.c` IS, and must be: it supplies the handful of C
# symbols the generated runtime calls that do not exist under that
# name on macOS and Windows, which is what lets THIS seed -- built
# on Linux, checked in as IR -- link on those platforms at all.
# The same platform split `platform_libs` makes inside the compiler
# (see `bootstrap/self_host/main.plum`). It has to be repeated here
# because this script runs BEFORE any compiler exists -- that is what
# bootstrapping from a seed means. `net_shim.c` is absent from the link
# below, so `-lws2_32` is not needed; pthreads are, because
# `thread_shim.c` is.
libs="-lm"
case "$(uname -s)" in
    MINGW*|MSYS*|CYGWIN*) libs="-lm -lpthread" ;;
esac

clang -O2 -Wno-override-module "$seed" \
    native_stdlib/compat_shim.c \
    native_stdlib/dir_shim.c \
    native_stdlib/io_shim.c \
    native_stdlib/os_shim.c \
    native_stdlib/process_shim.c \
    native_stdlib/thread_shim.c \
    $libs -o "$out"

echo "built $out from the seed -- no Rust compiler involved"
echo "next: $out build bootstrap/self_host -o sh.real"
