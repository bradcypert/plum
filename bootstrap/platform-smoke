#!/bin/sh
# Does a Plum compiler BINARY work on the machine it is sitting on?
#
# This is the only harness meant to run on macOS and Windows, and it is
# deliberately the least clever one in the directory. Everything else in
# `bootstrap/` is a development tool aimed at a Linux workstation: they
# assume GNU `timeout`, ASan with `detect_leaks=1` (which does not exist
# on Darwin at all), `readlink -f`, bash arrays, and the `./sh` cgroup
# wrapper. None of that is available or wanted here.
#
# What it checks is the product promise rather than the source tree:
# take the binary a user would download, point it at real programs, and
# see whether the programs build and print the right thing. That
# exercises the whole user-facing path -- the embedded C shims being
# written out, the shell-out to `clang`, the link, the run -- on the
# platform in question, which is exactly the part that does not
# transfer from Linux.
#
# It is NOT a substitute for `bootstrap/corpus-check` on Linux. There is
# no leak checking here, so a refcounting miscompile passes silently.
# Linux remains the platform where correctness is actually established;
# this answers the narrower question of whether the same compiler works
# somewhere else.
#
# Usage:  bootstrap/platform-smoke [path-to-plum-binary]     (default: ./sh.real)
set -u

root="$(cd "$(dirname "$0")/.." && pwd)"
cd "$root" || exit 1

plum="${1:-./sh.real}"
case "$plum" in /*) ;; *) plum="$root/${plum#./}" ;; esac
# A MinGW toolchain appends `.exe` to an output name that has no
# extension, so the file the caller named may not be the file on disk.
# MSYS2's bash resolves that transparently when EXECUTING, and not when
# testing for existence, which is the half that matters here.
[ -x "$plum" ] || [ -x "$plum.exe" ] || { echo "no compiler binary at $plum" >&2; exit 1; }

# BSD `mktemp` requires a template; GNU's does not. Neither spelling
# works on both, so try the plain one and fall back.
work="$(mktemp -d 2>/dev/null || mktemp -d -t plumsmoke)"
[ -n "$work" ] || { echo "could not make a temp directory" >&2; exit 1; }
trap 'rm -rf "$work"' EXIT INT TERM

echo "compiler:  $plum"
echo "version:   $("$plum" version 2>&1)"
echo "clang:     $(clang --version 2>&1 | head -n 1)"
echo "platform:  $(uname -s) $(uname -m)"
echo

ok=0
fail=0

for dir in bootstrap/exec_corpus/*/; do
    name="$(basename "$dir")"
    [ -f "$dir/main.plum" ] || continue
    [ -f "$dir/expected.txt" ] || continue

    # `build`, not `emit-llvm` plus a hand-written clang line. The point
    # is to test what a user actually runs, including the parts of the
    # compiler that shell out to other programs.
    if ! "$plum" build "$dir" -o "$work/$name.bin" > "$work/$name.log" 2>&1; then
        printf 'FAIL  %-24s did not build: %s\n' "$name" "$(head -n 1 "$work/$name.log")"
        fail=$((fail + 1))
        continue
    fi

    act="$(cd "$work" && "./$name.bin" 2>"$work/$name.rt")"
    rc=$?
    if [ $rc -ne 0 ]; then
        printf 'FAIL  %-24s exited %s: %s\n' "$name" "$rc" "$(head -n 1 "$work/$name.rt")"
        fail=$((fail + 1))
        continue
    fi

    if [ "$act" = "$(cat "$dir/expected.txt")" ]; then
        printf 'OK    %-24s\n' "$name"
        ok=$((ok + 1))
    else
        printf 'FAIL  %-24s output differs from expected.txt\n' "$name"
        printf '%s\n' "$act" > "$work/$name.act"
        # BYTES, not a diff. Twice now a diff has shown two lines that
        # looked identical, and a rendered-CR pass over it showed
        # nothing either -- so whatever the difference was, no
        # character-level view could display it. `od` cannot have that
        # problem. Truncated to the first 96 bytes of each side, which
        # is enough to place the first divergence.
        echo "        expected |"
        head -c 96 "$dir/expected.txt" | od -c | sed 's/^/          /'
        echo "        actual   |"
        head -c 96 "$work/$name.act" | od -c | sed 's/^/          /'
        echo "        sizes    | expected $(wc -c < "$dir/expected.txt"), actual $(wc -c < "$work/$name.act")"
        fail=$((fail + 1))
    fi
done

# --- Timed stdin reads, over a real PIPE (issue #32) ---
#
# The corpus above cannot reach this. A fixture feeds its child's stdin
# through `Process.run`, which uses a temp FILE -- and a file is always
# ready to read, so no deadline can ever expire against one. On Windows
# that means the corpus exercises `GetFileType`'s FILE_TYPE_DISK branch
# and leaves `PeekNamedPipe` only proven to compile.
#
# `bootstrap/stdin-smoke` covers this properly on Linux, and is bash
# with fractional sleeps. This is the portable subset, so that the path
# a real program on Windows most often takes -- a shell pipeline --
# actually runs somewhere.
#
# **The program prints a VERDICT, not a transcript.** How many timeouts
# occur before data arrives depends on the machine, so comparing the
# sequence would flake. Whether a timeout happened at all, what line was
# eventually read, and whether the stream ended are all deterministic.
#
# No `timeout` command here (it is GNU), so nothing may block forever:
# every writer closes the pipe, which ends the reader through EOF.
mkdir -p "$work/stdinpipe"
cat > "$work/stdinpipe/main.plum" <<'PLUM_EOF'
use Os;
use Time;

struct Acc { lines: Array[String], timeouts: Int, eof: Bool }

let step (a: Acc) (n: Int): Acc =
    if n <= 0 || a.eof { a }
    else {
        match Os.read_stdin_line_timeout(Time.millis(200)) {
            Ok(Got(l)) => step(Acc { lines: a.lines.push(l), timeouts: a.timeouts, eof: false }, n - 1),
            Ok(TimedOut) => step(Acc { lines: a.lines, timeouts: a.timeouts + 1, eof: false }, n - 1),
            Ok(Eof) => Acc { lines: a.lines, timeouts: a.timeouts, eof: true },
            Err(_) => Acc { lines: a.lines, timeouts: a.timeouts, eof: true },
        }
    }

// Each part is bound first: an interpolation cannot contain braces of
// its own, so an `if` has to be pulled out into a `let`. GRAMMAR.md
// says so; this is what it looks like in practice.
let main (): Unit = {
    let a = step(Acc { lines: [], timeouts: 0, eof: false }, 60);
    let joined = Array.join(a.lines, "|");
    let timed_out = if a.timeouts > 0 { "yes" } else { "no" };
    println("lines=${joined} timeouts=${timed_out} eof=${a.eof}")
}
PLUM_EOF

if ! "$plum" build "$work/stdinpipe" -o "$work/stdinpipe.bin" > "$work/stdinpipe.log" 2>&1; then
    printf 'FAIL  %-24s did not build: %s\n' "stdin_pipe" "$(head -n 1 "$work/stdinpipe.log")"
    fail=$((fail + 1))
else
    check_pipe() {
        label="$1"
        want="$2"
        got="$3"
        if [ "$got" = "$want" ]; then
            printf 'OK    %-24s\n' "$label"
            ok=$((ok + 1))
        else
            printf 'FAIL  %-24s\n        expected | %s\n        actual   | %s\n' "$label" "$want" "$got"
            fail=$((fail + 1))
        fi
    }

    # A pipe nobody writes to. Every read must time out rather than
    # block, and the reader must still finish when the writer goes away.
    check_pipe "stdin_pipe_idle" \
        "lines= timeouts=yes eof=true" \
        "$(sleep 1 | "$work/stdinpipe.bin")"

    # THE ONE THAT MATTERS: `par` arrives, deadlines pass, then `tial`
    # completes the line. A reader that dropped its partial line on
    # timeout would report `tial` here.
    check_pipe "stdin_pipe_partial" \
        "lines=partial timeouts=yes eof=true" \
        "$( { printf 'par'; sleep 1; printf 'tial\n'; } | "$work/stdinpipe.bin" )"

    # Everything available at once: no timeout, and a BLANK line is data
    # rather than the end of the stream.
    check_pipe "stdin_pipe_ready" \
        "lines=a| timeouts=no eof=true" \
        "$(printf 'a\n\n' | "$work/stdinpipe.bin")"
fi

echo
if [ $fail -eq 0 ]; then
    echo "platform smoke: $ok programs built and ran correctly on $(uname -s) $(uname -m)"
else
    echo "platform smoke: $fail of $((ok + fail)) FAILED on $(uname -s) $(uname -m)" >&2
    exit 1
fi
