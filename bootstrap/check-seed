#!/usr/bin/env bash
# Proves the checked-in seed is still good enough to bootstrap from.
#
# "Good enough" is a specific claim, and this checks exactly it:
#
#   1. the seed CARRIES every C shim in `native_stdlib/`
#   2. clang alone turns the seed into a compiler
#   3. that compiler compiles TODAY's `bootstrap/self_host`
#   4. what it produces emits the same IR as the current compiler does
#
# Step 4 is the one that matters. A seed that builds but produces a
# DIFFERENT compiler would be a seed that silently bootstraps something
# other than this source tree.
#
# Step 1 looks redundant next to it and is not, which is worth spelling
# out because the gap it covers was a real one found on 2026-08-23.
# Steps 2-4 compare what the seed PRODUCES; nothing in them looks at
# what the seed CONTAINS. The seed embeds the shim sources it will
# write out when IT builds something, and on Linux a missing one is
# invisible -- every harness passes, because the harnesses pass the
# shims to clang themselves. It becomes visible only on a platform
# where a shim supplies a libc name that is genuinely absent
# (`compat_shim.c` on macOS and Windows), and only at the second
# bootstrap step, as an unresolved-symbol link error with nothing to
# connect it to the seed. Cheap to check here; expensive to diagnose
# there.
#
# When this fails, the fix is `bootstrap/gen-seed` — the seed has fallen
# behind the language the compiler's own source now uses. That is
# expected occasionally and should be a deliberate commit, not a
# reflex: each refresh puts 6MB of generated text into history.
#
# CI can reuse the seed executable it just built in the same job with
# --seed-compiler PATH. Today's source is still rebuilt independently,
# from another working directory, and its output is still compared.
# Without that option this always builds the seed with clang alone.
set -euo pipefail

root="$(cd "$(dirname "${BASH_SOURCE[0]}")/.." && pwd)"
cd "$root"
seed_compiler=""
if [ "$#" -gt 0 ]; then
    if [ "$#" -ne 2 ] || [ "$1" != "--seed-compiler" ] || [ -z "$2" ]; then
        echo "usage: bootstrap/check-seed [--seed-compiler PATH]" >&2
        exit 1
    fi
    case "$2" in
        /*) seed_compiler="$2" ;;
        *) seed_compiler="$root/$2" ;;
    esac
    if [ ! -x "$seed_compiler" ]; then
        echo "check-seed: no executable seed compiler at $seed_compiler" >&2
        exit 1
    fi
fi
work="$(mktemp -d -t plum-seed-XXXXXX)"
trap 'rm -rf "$work"' EXIT

echo "the seed carries every shim in native_stdlib/, at its current content ..."
missing=""
for c in native_stdlib/*.c; do
    grep -q "$(basename "$c")" bootstrap/seed/plum.ll || missing="$missing $(basename "$c")"
done
if [ -n "$missing" ]; then
    echo "SEED STALE: it embeds no copy of:$missing" >&2
    echo "run bootstrap/gen-seed to refresh it" >&2
    exit 1
fi

# Presence is not enough: an embedded shim or TLS header can be PRESENT and stale,
# and the checks below cannot see it, because they compare what the
# seed PRODUCES and both sides are built from today's source. A stale
# embedded shim only bites on a platform where that shim's content
# genuinely differs -- which is every reason the shims were touched in
# the first place.
shim_hash="$(./bootstrap/shim-hash)"
recorded="$(cat bootstrap/seed/shims.sha256 2>/dev/null || echo none)"
if [ "$shim_hash" != "$recorded" ]; then
    echo "SEED STALE: embedded native or vendored TLS sources have changed since the seed was built" >&2
    echo "  seed was built with $recorded" >&2
    echo "  native_stdlib/ is now $shim_hash" >&2
    echo "run bootstrap/gen-seed to refresh it" >&2
    exit 1
fi

if [ -z "$seed_compiler" ]; then
    echo "seed -> compiler (clang only) ..."
    ./bootstrap/from-seed -o "$work/sh.seed" > "$work/build.log" 2>&1 || {
        echo "clang could not build the seed:" >&2; cat "$work/build.log" >&2; exit 1; }
    seed_compiler="$work/sh.seed"
else
    echo "using supplied seed compiler: $seed_compiler"
fi

echo "seed compiler -> today's source ..."
(cd "$work" && SH_MEM="${SH_MEM:-1G}" SH_TIMEOUT="${SH_TIMEOUT:-600}" "$seed_compiler" build "$root/bootstrap/self_host" -o "$work/sh.next" > "$work/next.log" 2>&1) || {
    echo "the seed compiler could not build today's source -- run bootstrap/gen-seed:" >&2
    head -20 "$work/next.log" >&2; exit 1; }

# BOTH from this directory, naming the source the SAME way. That is not
# tidiness: since debug builds carry line tables, the emitted IR records
# the path it was given -- `DIFile(filename: ..)` -- so naming the same
# source `bootstrap/self_host` and `$root/bootstrap/self_host` produces
# two files that differ in every filename and compare unequal. This ran
# one side from `$work` with an absolute path and reported a stale seed
# for a compiler that was byte-identical.
#
# Whether the compiler works from another directory is
# `bootstrap/self-sufficiency`'s question, and it asks it properly by
# varying the directory on BOTH sides.
echo "comparing what it produces against the current compiler ..."
SH_MEM="${SH_MEM:-256M}" SH_TIMEOUT="${SH_TIMEOUT:-600}" "$work/sh.next" emit-llvm bootstrap/self_host > "$work/next.ll" 2>&1
SH_MEM="${SH_MEM:-256M}" SH_TIMEOUT="${SH_TIMEOUT:-600}" ./sh emit-llvm bootstrap/self_host > "$work/cur.ll" 2>&1

if cmp -s "$work/next.ll" "$work/cur.ll"; then
    echo "SEED OK: bootstraps to a compiler identical to the current one"
else
    echo "SEED STALE: a compiler bootstrapped from the seed differs from the current one" >&2
    echo "run bootstrap/gen-seed to refresh it" >&2
    exit 1
fi
