#!/usr/bin/env python3
"""Regenerates `bootstrap/self_host/shims/shims.plum` from native_stdlib/.

The self-hosted compiler EMBEDS the C shims it links against, rather
than reading `native_stdlib/*.c` off disk. It has to: that path was
relative to the current directory, so `sh build` worked only when run
from the repo root — a compiler that works in one directory is not a
compiler you can install. The real compiler embeds the same sources via
`include_str!` for the identical reason.

Rust gets this for free at compile time. Plum has no `include_str!`, so
the embedding is generated, and this script is what generates it. Run it
after editing any shim; `bootstrap/check-shims` fails if the checked-in
copy has drifted, so a forgotten regeneration is caught rather than
discovered later as a mysterious link error.

`net_shim.c` was deliberately absent until 2026-08-21, on the reasoning
that the runtime declares nothing from it and embedding an unused 166
lines buys nothing. True of the RUNTIME and false of the point: a
compiled PROGRAM can call `tcp_*`, and without the shim embedded here
it cannot be linked. The self-hosted compiler had no networking prelude
at all, so nothing noticed until the Rust backend was deleted and HTTP
programs stopped being compilable by anything.
"""

import os
import pathlib
import sys

ROOT = pathlib.Path(__file__).resolve().parent.parent
# DERIVED from the directory, not listed by hand.
#
# It used to be a literal list, and the failure that produces is the one
# this project keeps meeting: `handle_shim.c` was added, `check-shims`
# said everything matched -- because it only compares the files it knows
# about -- and the miss surfaced as `undefined reference to
# plum_handle_track` at link time, several steps from the cause.
#
# Sorted so the generated file has a stable order regardless of how the
# filesystem enumerates.
SHIMS = [(p.name, True, p) for p in sorted((ROOT / "native_stdlib").glob("*.c"))]
VENDOR = ROOT / "vendor" / "mbedtls"
if VENDOR.exists():
    SHIMS += [("mbedtls/" + str(p.relative_to(VENDOR)), p.suffix == ".c", p)
              for p in sorted(VENDOR.joinpath("include").rglob("*.h"))]
    SHIMS += [("mbedtls/library/" + p.name, False, p)
              for p in sorted(VENDOR.joinpath("library").glob("*.h"))]
    SHIMS += [("mbedtls/" + str(p.relative_to(VENDOR)), True, p)
              for p in sorted(VENDOR.joinpath("library").glob("*.c"))]
SHIMS.sort(key=lambda item: item[0])
if not SHIMS:
    sys.exit("no shims found in native_stdlib/")
OUT = ROOT / "bootstrap" / "self_host" / "shims" / "shims.plum"

HEADER = '''// The C shims this compiler links into every binary it produces --
// EMBEDDED, not read from disk.
//
// GENERATED by `bootstrap/gen-shims` from `native_stdlib/*.c` and the
// pinned `vendor/mbedtls` snapshot. Do not
// edit: run the generator instead. `bootstrap/check-shims` fails if
// this file and the C sources have drifted apart.
//
// Embedded because the alternative was reading `native_stdlib/` relative
// to the CURRENT DIRECTORY, which meant `sh build` only worked when run
// from the repo root -- a compiler that works in one directory is not a
// compiler you can install. The real compiler embeds the same sources
// through `include_str!`, for the same reason. `@embed_file` reads each
// source at compile time and stores it as one string in the compiler.
// Avoid line arrays: vendored TLS has hundreds of thousands of lines,
// and parsing those arrays inflated compiler memory and build time.
//
// `net_shim.c` IS here, since 2026-08-21. It was left out on the
// reasoning that the runtime declares nothing from it -- true, and
// beside the point: a compiled PROGRAM calls `tcp_*`, and without the
// shim embedded here it cannot be linked.

pub struct ShimFile { pub name: String, pub source: String, pub compile: Bool }

pub let shim_files (): Array[ShimFile] = [
'''


def render(name: str, compile: bool, path: pathlib.Path) -> str:
    # Resolve against shims.plum, independent of the build's working directory.
    # Emit literal fields in declaration order for static aggregate layout.
    rel = pathlib.Path(os.path.relpath(path, OUT.parent)).as_posix()
    return (
        '    ShimFile {\n'
        '        name: "%s",\n'
        '        source: @embed_file("%s"),\n'
        '        compile: %s,\n'
        '    },\n' % (name, rel, "true" if compile else "false")
    )


def generate() -> str:
    return HEADER + "".join(render(name, compile, path)
                            for name, compile, path in SHIMS) + "]\n"


# Headers that DO NOT EXIST on Windows, even under MinGW-w64. A shim
# that includes one of these outside a platform guard cannot compile
# there, and the failure is a fatal error in a temp directory during
# someone else's build -- see `net_shim.c`, which shipped exactly this
# and was caught only by CI.
#
# `dirent.h`, `pthread.h` and `unistd.h` are deliberately ABSENT from
# this list. MinGW-w64 provides all three, which is not a guess: the
# Windows CI leg links `dir_shim.c`, `os_shim.c` and `thread_shim.c`
# successfully. Listing them would be a false alarm, and a check that
# cries wolf gets switched off.
WINDOWS_ABSENT = (
    "sys/socket.h", "sys/wait.h", "netinet/in.h", "netdb.h",
    "arpa/inet.h", "mach-o/dyld.h", "malloc/malloc.h",
)


def unguarded_headers():
    """Every non-portable #include sitting at conditional depth zero."""
    problems = []
    for name, compile, path in SHIMS:
        depth = 0
        for n, line in enumerate(path.read_text().splitlines(), 1):
            s = line.strip()
            if s.startswith("#if"):
                depth += 1
            elif s.startswith("#endif"):
                depth -= 1
            elif depth == 0 and s.startswith("#include"):
                for h in WINDOWS_ABSENT:
                    if "<%s>" % h in s:
                        problems.append("%s:%d: %s is not on Windows and is outside any #if" % (name, n, h))
    return problems


if __name__ == "__main__":
    text = generate()
    if "--check" in sys.argv:
        bad = unguarded_headers()
        if bad:
            print("non-portable headers outside a platform guard:", file=sys.stderr)
            for b in bad:
                print("  " + b, file=sys.stderr)
            sys.exit(1)
        current = OUT.read_text() if OUT.exists() else ""
        if current != text:
            print("shims.plum is out of date -- run bootstrap/gen-shims", file=sys.stderr)
            sys.exit(1)
        print("shims.plum matches native_stdlib/")
    else:
        OUT.write_text(text)
        print("wrote %s" % OUT.relative_to(ROOT))
