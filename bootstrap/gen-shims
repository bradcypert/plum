#!/usr/bin/env python3
"""Regenerates `bootstrap/self_host/shims/shims.plum` from native_stdlib/.

The self-hosted compiler EMBEDS the C shims it links against, rather
than reading `native_stdlib/*.c` off disk. It has to: that path was
relative to the current directory, so `sh build` worked only when run
from the repo root — a compiler that works in one directory is not a
compiler you can install. The real compiler embeds the same sources via
`include_str!` for the identical reason.

Rust gets this for free at compile time. Plum has no `include_str!`, so
the embedding is generated, and this script is what generates it. Run it
after editing any shim; `bootstrap/check-shims` fails if the checked-in
copy has drifted, so a forgotten regeneration is caught rather than
discovered later as a mysterious link error.

`net_shim.c` was deliberately absent until 2026-08-21, on the reasoning
that the runtime declares nothing from it and embedding an unused 166
lines buys nothing. True of the RUNTIME and false of the point: a
compiled PROGRAM can call `tcp_*`, and without the shim embedded here
it cannot be linked. The self-hosted compiler had no networking prelude
at all, so nothing noticed until the Rust backend was deleted and HTTP
programs stopped being compilable by anything.
"""

import pathlib
import sys

ROOT = pathlib.Path(__file__).resolve().parent.parent
SHIMS = ["compat_shim.c", "dir_shim.c", "io_shim.c", "net_shim.c",
         "process_shim.c", "thread_shim.c"]
OUT = ROOT / "bootstrap" / "self_host" / "shims" / "shims.plum"

HEADER = '''// The C shims this compiler links into every binary it produces --
// EMBEDDED, not read from disk.
//
// GENERATED by `bootstrap/gen-shims` from `native_stdlib/*.c`. Do not
// edit: run the generator instead. `bootstrap/check-shims` fails if
// this file and the C sources have drifted apart.
//
// Embedded because the alternative was reading `native_stdlib/` relative
// to the CURRENT DIRECTORY, which meant `sh build` only worked when run
// from the repo root -- a compiler that works in one directory is not a
// compiler you can install. The real compiler embeds the same sources
// through `include_str!`, for the same reason; Plum has no equivalent,
// so the embedding is generated.
//
// `net_shim.c` IS here, since 2026-08-21. It was left out on the
// reasoning that the runtime declares nothing from it -- true, and
// beside the point: a compiled PROGRAM calls `tcp_*`, and without the
// shim embedded here it cannot be linked.

pub struct ShimFile { name: String, source: String }

pub let shim_files (): Array[ShimFile] = [
'''


def escape(line: str) -> str:
    return line.replace("\\", "\\\\").replace('"', '\\"')


def render(name: str, text: str) -> str:
    lines = text.split("\n")
    body = "\n".join('        "%s",' % escape(l) for l in lines)
    return (
        '    ShimFile {\n'
        '        name: "%s",\n'
        '        source: join_lines([\n%s\n        ]),\n'
        '    },\n' % (name, body)
    )


def generate() -> str:
    out = [HEADER]
    for shim in SHIMS:
        text = (ROOT / "native_stdlib" / shim).read_text()
        out.append(render(shim, text))
    out.append(']\n\n')
    out.append(
        '// One shim source, reassembled. `Array.fold` over `concat` is\n'
        '// quadratic in the number of lines, which for a few hundred is\n'
        '// irrelevant and for anything larger would not be.\n'
        'let join_lines (lines: Array[String]): String =\n'
        '    Array.fold(lines, "", |acc, l| acc.concat(l).concat("\\n"))\n'
    )
    return "".join(out)


if __name__ == "__main__":
    text = generate()
    if "--check" in sys.argv:
        current = OUT.read_text() if OUT.exists() else ""
        if current != text:
            print("shims.plum is out of date -- run bootstrap/gen-shims", file=sys.stderr)
            sys.exit(1)
        print("shims.plum matches native_stdlib/")
    else:
        OUT.write_text(text)
        print("wrote %s" % OUT.relative_to(ROOT))
