#!/usr/bin/env bash
# End-to-end LSP smoke test: initialize, open a file with a known error,
# expect a diagnostic on the right line, then shut down.
cd /home/brad/Projects/plum
work=$(mktemp -d); trap 'rm -rf "$work"' EXIT
printf 'struct P { x: Int }\n\nlet f (p: P): Int = p.nope\n' > "$work/main.plum"
# A second, well-typed project: hover on a LOCAL needs the project to
# check cleanly, which the one above deliberately does not.
mkdir -p "$work/ok"
printf 'struct P { x: Int }\n\nlet f (p: P): Int = {\n    let n = p.x;\n    n + 1\n}\n' > "$work/ok/main.plum"
python3 - "$work" > "$work/session.bin" <<'PY'
import json, sys
d = sys.argv[1]
msgs = [
  {"jsonrpc":"2.0","id":1,"method":"initialize","params":{}},
  {"jsonrpc":"2.0","method":"textDocument/didOpen","params":{"textDocument":{"uri":"file://%s/main.plum" % d}}},
  # hover and go-to-definition on `P` in `let f (p: P)` -- line 2, char 11
  {"jsonrpc":"2.0","id":3,"method":"textDocument/hover","params":{"textDocument":{"uri":"file://%s/main.plum" % d},"position":{"line":2,"character":10}}},
  {"jsonrpc":"2.0","id":4,"method":"textDocument/definition","params":{"textDocument":{"uri":"file://%s/main.plum" % d},"position":{"line":2,"character":10}}},
  # hover on the LOCAL `n` (line 4, char 4) -- the checker's inferred
  # type, which a name-based lookup cannot produce
  {"jsonrpc":"2.0","id":5,"method":"textDocument/hover","params":{"textDocument":{"uri":"file://%s/ok/main.plum" % d},"position":{"line":4,"character":4}}},
  # go-to-definition on the USE of `n` (line 4) must land on its BINDING
  # (line 3) -- the name index cannot do this, it only knows top-level
  # definitions
  {"jsonrpc":"2.0","id":6,"method":"textDocument/definition","params":{"textDocument":{"uri":"file://%s/ok/main.plum" % d},"position":{"line":4,"character":4}}},
  {"jsonrpc":"2.0","id":2,"method":"shutdown"},
  {"jsonrpc":"2.0","method":"exit"},
]
out=sys.stdout.buffer
for m in msgs:
    b=json.dumps(m).encode()
    out.write(b"Content-Length: %d\r\n\r\n" % len(b)); out.write(b)
PY
out=$(SH_MEM=4G SH_TIMEOUT=60 ./sh lsp < "$work/session.bin" 2>&1)
fail=0
echo "$out" | grep -q '"textDocumentSync":1' || { echo "FAIL: no capabilities"; fail=1; }
echo "$out" | grep -q 'has no field named nope' || { echo "FAIL: no diagnostic"; fail=1; }
echo "$out" | grep -q '"line":2' || { echo "FAIL: wrong line"; fail=1; }
echo "$out" | grep -q '"id":2,"result":null' || { echo "FAIL: no shutdown reply"; fail=1; }
echo "$out" | grep -q '"value":"struct P"' || { echo "FAIL: hover did not report the struct"; fail=1; }
echo "$out" | grep -q '"id":4,"result":{"uri"' || { echo "FAIL: no definition location"; fail=1; }
echo "$out" | grep -q '"value":"n: Int"' || { echo "FAIL: hover did not infer the local's type"; fail=1; }
echo "$out" | grep -q '"id":6,"result":{"uri":[^}]*"line":3' || { echo "FAIL: go-to-definition did not reach the local's binding"; fail=1; }
[ $fail -eq 0 ] && echo "lsp smoke: ok"
exit $fail
