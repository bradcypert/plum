#!/usr/bin/env bash
# Builds plumlang.org into `site/public`.
#
# Two generators, one tree:
#
#   Hugo         prose, from `site/content` -- most of which is copied
#                out of the repository root Markdown by this script, so
#                each document has exactly one source of truth.
#   `plum doc`   the API reference, verbatim into `public/api`.
#   `plum highlight`
#                the Plum code blocks in the prose, after Hugo has
#                rendered them -- Chroma has no Plum lexer, and the
#                compiler's own is the only one that cannot be wrong.
#
# The reference is deliberately not run through Hugo. It is the
# compiler's own output, and it has to look here exactly as it looks
# for someone who ran `plum doc` on their own package -- otherwise the
# site quietly stops being a demonstration of the tool it documents.
#
#   bootstrap/build-site           # build into site/public
#   bootstrap/build-site --serve   # build, then `hugo server` for local work
set -uo pipefail

root="$(cd "$(dirname "${BASH_SOURCE[0]}")/.." && pwd)"
cd "$root"

plum="${PLUM:-./sh}"
repo="https://github.com/bradcypert/plum"

if ! command -v hugo >/dev/null 2>&1; then
    echo "build-site: hugo is not on PATH" >&2
    echo "  https://gohugo.io/installation/" >&2
    exit 1
fi

# --- Prose --------------------------------------------------------
#
# Each root document becomes a page. `bootstrap/site_page.py` does the
# actual conversion, including rewriting links: a root document that IS
# published becomes a site path, and anything else (an example, a shim,
# DESIGN.md) becomes a link to the file on GitHub rather than a relative
# path with no page behind it.
page() {
    local src="$1" slug="$2" title="$3" blurb="$4" toc="$5"
    python3 bootstrap/site_page.py "$src" "$slug" "$title" "$blurb" "$toc" \
        > "site/content/${slug}.md" || exit 1
    echo "  site/content/${slug}.md"
}

echo "prose:"
page INSTALL.md  install  "Install" \
     "One binary, and clang." true
page TUTORIAL.md tutorial "Tutorial" \
     "From \`plum new\` to a program with tests, in twenty minutes." true
page LANGUAGE.md language "Language tour" \
     "The whole language, one feature at a time." true
page MODULES.md  modules  "Modules" \
     "How code is organised, and what the standard library gives you." true
page RUNNING.md  running  "Running programs" \
     "Building, running, cross-compiling, and the worked examples." true
page TOOLING.md  tooling  "Tooling" \
     "Tests, formatting, the language server, and debug builds." true
page GRAMMAR.md  grammar  "Grammar" \
     "The whole language, as a grammar." true
page VISION.md   vision   "Vision" \
     "What Plum is for, and what it is deliberately not." false
page PORTING.md  porting  "Porting" \
     "What a new platform costs, and what is already paid." true

# --- Prose site ---------------------------------------------------

echo "hugo:"
hugo --source site --minify --quiet || exit 1

# --- API reference ------------------------------------------------
#
# After Hugo, because `cleanDestinationDir` empties `public` first.
echo "reference:"
"$plum" doc --stdlib --html -o site/public/api --home "Plum=/" || exit 1

# Chroma has no Plum lexer, so Hugo left the ```plum fences plain.
# The compiler highlights them, after the fact, with its own lexer.
echo "highlighting:"
PLUM="$plum" python3 bootstrap/highlight-site site/public || exit 1

pages=$(find site/public -name '*.html' | wc -l | tr -d ' ')
echo "built ${pages} page(s) into site/public"

if [ "${1:-}" = "--serve" ]; then
    echo "serving http://localhost:1313/ (the reference is at /api/index.html)"
    hugo server --source site --disableFastRender
fi
