#!/usr/bin/env bash
# Proves `plum test` actually runs tests, and that BOTH compilers agree
# on the result.
#
# This exists because `sh test` was broken for months without anyone
# noticing. It ran each test through the tree-walking interpreter, which
# never loads the prelude — so every test calling `assert_eq`, which is
# every realistic test, failed with "unbound function: assert_eq" while
# the same code compiled and ran fine. The feature had been "validated"
# against tests that happened to use only `panic_raw`.
#
# So the fixture below deliberately uses the things a smoke test is
# tempted to skip: the prelude's assertions, a `Ref`, a stdlib call,
# and -- added 2026-08-21 -- a zero-argument call, a partial
# application and a dotted-path struct update. Those last three each
# need a side-channel that inference computes and lowering cannot
# re-derive, and all three were broken in the real compiler's
# `plum test` and nowhere else, for exactly as long as this fixture
# did not use them. It also asserts a FAILING test both fails and does
# not stop the ones after it.
set -uo pipefail

root="$(cd "$(dirname "${BASH_SOURCE[0]}")/.." && pwd)"
cd "$root"
work="$(mktemp -d -t plum-testsmoke-XXXXXX)"
trap 'rm -rf "$work"' EXIT

cat > "$work/main.plum" <<'PLUM'
struct Vec2 { x: Int, y: Int }
struct Ship { pos: Vec2 }
struct Game { ship: Ship, score: Int }

let main (): Unit = println("app")

let seven (): Int = 7
let scale (a: Int) (b: Int): Int = a * b

let test_assertions (): Unit = assert_eq(1 + 1, 2)

let test_ref (): Unit = {
    let cell = ref(0);
    cell.set(cell.get() + 42);
    assert_eq(cell.get(), 42)
}

let test_stdlib (): Unit =
    assert_eq(Option.unwrap_or(Array.find([1, 2, 3], |n| n > 2), 0), 3)

// The three below exist because a test runner can quietly lower a
// DIFFERENT program than the one `run` lowers. Each needs a side-
// channel that inference computes and lowering cannot re-derive, and
// each was broken in the real compiler's `plum test` -- and ONLY there
// -- until 2026-08-21, because this fixture did not use them.
let test_zero_argument_call (): Unit = assert_eq(seven(), 7)

let test_partial_application (): Unit = {
    let double = scale(2);
    assert_eq(double(21), 42)
}

let test_dotted_field_update (): Unit = {
    let g = Game { ship: Ship { pos: Vec2 { x: 1, y: 2 } }, score: 0 };
    let g2 = Game { ship.pos.x: 99, ..g };
    assert_eq(g2.ship.pos.x, 99)
}

let test_fails_on_purpose (): Unit = assert_eq(2 + 2, 5)

let test_runs_after_a_failure (): Unit = assert(true)
PLUM

fail=0

check_run() {
    local label="$1"; shift
    local out; out="$("$@" test "$work" 2>&1)"
    echo "$out" | grep -q 'test test_ref ... ok' || { echo "FAIL [$label]: a Ref test did not pass"; fail=1; }
    echo "$out" | grep -q 'test test_stdlib ... ok' || { echo "FAIL [$label]: a stdlib test did not pass"; fail=1; }
    # Each of these needs an inference side-channel threaded into
    # lowering. A test runner that skips one lowers a different program
    # than `run` does, and says so only here.
    echo "$out" | grep -q 'test test_zero_argument_call ... ok' || { echo "FAIL [$label]: a zero-argument call did not work in a test"; fail=1; }
    echo "$out" | grep -q 'test test_partial_application ... ok' || { echo "FAIL [$label]: partial application did not work in a test"; fail=1; }
    echo "$out" | grep -q 'test test_dotted_field_update ... ok' || { echo "FAIL [$label]: a dotted field update did not work in a test"; fail=1; }
    echo "$out" | grep -q 'test_fails_on_purpose' || { echo "FAIL [$label]: the failing test was not reported"; fail=1; }
    # 7 passed proves the run continued past the failure.
    echo "$out" | grep -q 'FAILED. 7 passed; 1 failed' || { echo "FAIL [$label]: wrong tally"; echo "$out" | tail -3; fail=1; }
}

check_run self-hosted ./sh

# The real compiler is OPTIONAL. Its half is the whole point of this
# script -- "both compilers agree" -- so its absence is announced
# rather than passed over silently, but it is not a failure: the
# self-hosted half still proves `plum test` runs tests.
if [ -x ./target/release/plum ]; then
    check_run rust ./target/release/plum
    agreed=" both compilers agree"
else
    echo "note: ./target/release/plum not built -- self-hosted half only, no agreement check"
    agreed=" (self-hosted only)"
fi

[ $fail -eq 0 ] && echo "test smoke: ok,$agreed"
exit $fail
