use Os;
use Encoding;

// Property tests: invariants that must hold for MANY inputs, checked
// against values generated here rather than against answers recorded
// from a previous run.
//
// **Why this exists.** `bootstrap/interp-check` compares the compiler
// against the Rust interpreter, an independent implementation, and that
// is the only thing in this repo able to catch the compiler being
// CONFIDENTLY WRONG -- a recording just preserves whatever it did last
// time. But the interpreter now lags the language: it has no `Os.`
// namespace and no `x.f(a)` = `T.f(x, a)` rule, so those fixtures are
// skipped. New features are exactly what it cannot check, which makes
// its coverage inversely correlated with risk.
//
// A property does not lag. It is written in the language it tests, so a
// feature gets properties the day it lands, and it encodes an invariant
// known IN ADVANCE rather than whatever the implementation happens to
// produce. That is a different kind of independence from a second
// implementation, and a cheaper one to keep.
//
// **Deliberately deterministic.** A fixed seed, not a clock. A property
// that fails on one CI run in twenty and cannot be reproduced locally
// is worse than no property: it teaches people to re-run until green.
// Every failure here reproduces exactly.

// --- A generator ---

// A linear congruential generator, kept small ON PURPOSE. Plum checks
// integer overflow and aborts on it (`cg_overflow_guard`), so the usual
// 64-bit LCG constants would kill the test process rather than wrap.
// With `seed < 2^31` the product below peaks near 2.4e18, comfortably
// inside `Int`.
let PRNG_MOD (): Int = 2147483648

let next_seed (seed: Int): Int = (seed * 1103515245 + 12345) % PRNG_MOD()

// A value in [lo, hi]. `Int.abs` is applied to the seed rather than the
// result so a negative range still lands inside it.
let rand_between (seed: Int) (lo: Int) (hi: Int): Int =
    lo + (Int.abs(seed) % (hi - lo + 1))

// --- Reporting ---

// `assert_eq` prints the two values but not the INPUT that produced
// them, which for a property is the only thing that lets you reproduce
// it. This prints the case first, so a failure names it even though the
// abort message cannot.
let check_eq (label: String) (input: String) (got: String) (want: String): Unit =
    if got == want { () } else {
        println("PROPERTY FAILED: ".concat(label));
        println("  input: ".concat(input));
        println("  got:   ".concat(got));
        println("  want:  ".concat(want));
        panic_raw("property failed: ".concat(label))
    }

// --- Int round trip ---

// `parse_int(n.to_string()) == n`. The compiler's own `parse_int` and
// `to_string` are separate code paths, so this checks them against each
// other rather than against a recording.
// A sentinel no generated value can be, so a parse FAILURE is a
// visible mismatch rather than a coincidence.
let parsed_int (text: String): String =
    text.parse_int().unwrap_or(0 - 999999999999).to_string()

let int_roundtrip (seed: Int) (left: Int): Unit =
    if left <= 0 { () } else {
        let v = rand_between(seed, 0 - 1000000000, 1000000000);
        let text = v.to_string();
        check_eq("int round trip", text, parsed_int(text), text);
        int_roundtrip(next_seed(seed), left - 1)
    }

pub let test_int_roundtrip (): Unit = {
    int_roundtrip(12345, 300);
    // The edges a small generator will never reach on its own, and the
    // ones most likely to be wrong.
    check_eq("int edge", "0", parsed_int("0"), "0");
    check_eq("int edge", "max", parsed_int("9223372036854775807"), "9223372036854775807");
    check_eq("int edge", "min", parsed_int("-9223372036854775808"), "-9223372036854775808")
}

// --- Float round trip ---

// `parse_float(x.to_string()) == x`, over magnitudes that reach BOTH
// notations.
//
// This is the property the interpreter earned its keep on. The float
// formatting bug it caught -- `0.000001` printing as
// `1.0000000000000002e-06` -- is exactly a round-trip failure, and it
// would have been caught here without a second implementation. The
// runtime's own `plum_fmt_double` already works this way internally,
// retrying at 15, 16 and 17 digits until the text parses back to the
// same double; this checks the same invariant from outside.
let float_roundtrip (seed: Int) (left: Int): Unit =
    if left <= 0 { () } else {
        let mantissa = rand_between(seed, 1, 999999);
        let exponent = rand_between(next_seed(seed), 0 - 20, 20);
        let x = mantissa.to_float() * Float.pow(10.0, exponent.to_float());
        let text = x.to_string();
        check_eq("float round trip", text,
            text.parse_float().unwrap_or(0.0 - 1.0).to_string(), text);
        float_roundtrip(next_seed(next_seed(seed)), left - 1)
    }

pub let test_float_roundtrip (): Unit = {
    float_roundtrip(999, 300);
    // The two the formatting bug actually showed up on, and the
    // boundaries where `%g` switches notation.
    check_eq("float edge", "1e-06", "0.000001".parse_float().unwrap_or(0.0).to_string(), "1e-06");
    check_eq("float edge", "1e+20", "100000000000000000000.0".parse_float().unwrap_or(0.0).to_string(), "1e+20");
    check_eq("float edge", "0.1", "0.1".parse_float().unwrap_or(0.0).to_string(), "0.1");
    check_eq("float edge", "zero", 0.0.to_string(), "0")
}

// --- split / join ---

// `split(s, sep).join(sep) == s`, for any `s` and any non-empty `sep`.
// True by construction and easy to get wrong at the edges: a leading
// separator, a trailing one, two in a row, and the empty string all
// produce empty parts that must survive the round trip.
let sep_string (seed: Int) (left: Int) (acc: String): String =
    if left <= 0 { acc } else {
        let pick = Int.abs(seed) % 3;
        let c = if pick == 0 { "a" } else if pick == 1 { "b" } else { "," };
        sep_string(next_seed(seed), left - 1, acc.concat(c))
    }

let split_join (seed: Int) (left: Int): Unit =
    if left <= 0 { () } else {
        let s = sep_string(seed, rand_between(seed, 0, 12), "");
        check_eq("split/join round trip", "[".concat(s).concat("]"),
            s.split(",").join(","), s);
        split_join(next_seed(seed), left - 1)
    }

pub let test_split_join (): Unit = {
    split_join(4242, 200);
    check_eq("split/join edge", "empty", "".split(",").join(","), "");
    check_eq("split/join edge", "leading", ",a".split(",").join(","), ",a");
    check_eq("split/join edge", "trailing", "a,".split(",").join(","), "a,");
    check_eq("split/join edge", "doubled", "a,,b".split(",").join(","), "a,,b")
}

// --- Case mapping ---

// Over ASCII, case mapping preserves length and `to_upper` is settled
// after one application. Deliberately ASCII-only: `ß` uppercases to
// `SS` in some implementations and not others, which is a real
// divergence this project has already documented rather than a
// property violation.
let ascii_string (seed: Int) (left: Int) (acc: String): String =
    if left <= 0 { acc } else {
        let pick = Int.abs(seed) % 4;
        let c = if pick == 0 { "a" } else if pick == 1 { "Z" } else if pick == 2 { "m" } else { "7" };
        ascii_string(next_seed(seed), left - 1, acc.concat(c))
    }

let case_props (seed: Int) (left: Int): Unit =
    if left <= 0 { () } else {
        let s = ascii_string(seed, rand_between(seed, 1, 10), "");
        check_eq("upper preserves length", s, s.to_upper().len().to_string(), s.len().to_string());
        check_eq("upper is idempotent", s, s.to_upper().to_upper(), s.to_upper());
        check_eq("lower then upper", s, s.to_lower().to_upper(), s.to_upper());
        case_props(next_seed(seed), left - 1)
    }

pub let test_case_mapping (): Unit = case_props(31337, 150)

// --- Sorting ---

// A sort must produce a PERMUTATION that is ordered. Checking "ordered"
// alone passes for a function that returns an empty array, and checking
// length alone passes for one that returns its input untouched.
let is_sorted (xs: Array[Int]) (i: Int): Bool =
    if i + 1 >= xs.len() { true }
    else if xs[i] > xs[i + 1] { false }
    else { is_sorted(xs, i + 1) }

let int_array (seed: Int) (left: Int) (acc: Array[Int]): Array[Int] =
    if left <= 0 { acc }
    else { int_array(next_seed(seed), left - 1, acc.push(rand_between(seed, 0 - 50, 50))) }

let sort_props (seed: Int) (left: Int): Unit =
    if left <= 0 { () } else {
        let xs = int_array(seed, rand_between(seed, 0, 15), []);
        let sorted = Array.sort_int(xs);
        check_eq("sort orders", xs.to_string(), is_sorted(sorted, 0).to_string(), "true");
        check_eq("sort keeps length", xs.to_string(), sorted.len().to_string(), xs.len().to_string());
        check_eq("sort keeps sum", xs.to_string(), Array.sum_int(sorted).to_string(), Array.sum_int(xs).to_string());
        sort_props(next_seed(seed), left - 1)
    }

pub let test_sorting (): Unit = sort_props(777, 120)

// --- Arithmetic ---

// Identities that must hold whenever no operand overflows. `Int` is
// CHECKED here -- `+`/`-`/`*` abort rather than wrap -- so the ranges
// are chosen to stay inside, and what is being tested is that ordinary
// arithmetic is not quietly wrong near the guards.
let arith_props (seed: Int) (left: Int): Unit =
    if left <= 0 { () } else {
        let a = rand_between(seed, 0 - 1000000, 1000000);
        let b = rand_between(next_seed(seed), 0 - 1000000, 1000000);
        let case = a.to_string().concat(", ").concat(b.to_string());
        check_eq("add then subtract", case, ((a + b) - b).to_string(), a.to_string());
        check_eq("multiply then divide", case, ((a * 7) / 7).to_string(), a.to_string());
        check_eq("addition commutes", case, (a + b).to_string(), (b + a).to_string());
        check_eq("negate twice", case, (0 - (0 - a)).to_string(), a.to_string());
        arith_props(next_seed(next_seed(seed)), left - 1)
    }

pub let test_arithmetic (): Unit = arith_props(2024, 200)

// --- JSON ---

// `stringify(parse(stringify(v))) == stringify(v)`.
//
// Round-tripping through TEXT rather than comparing two `JsonValue`s,
// because there is no structural equality on them -- and the text is
// the thing that has to survive anyway, since JSON is what the language
// server speaks.
//
// This is aimed squarely at `parse_number`, which is shared between
// `json_parse` and `String.parse_float` and had its value computation
// rerouted through `strtod` on 2026-08-25. Nothing else guards it.
let json_leaf (seed: Int): JsonValue = {
    let pick = Int.abs(seed) % 5;
    if pick == 0 { JsonNull }
    else if pick == 1 { JsonBool(Int.abs(seed) % 2 == 0) }
    else if pick == 2 { JsonNumber(rand_between(seed, 0 - 100000, 100000).to_float()) }
    else if pick == 3 {
        // Exponent territory, where the number parser is most likely to
        // be wrong -- and was.
        JsonNumber(rand_between(seed, 1, 999999).to_float() * Float.pow(10.0, rand_between(next_seed(seed), 0 - 15, 15).to_float()))
    }
    else { JsonString(ascii_string(seed, rand_between(seed, 0, 6), "")) }
}

let json_value (seed: Int) (depth: Int): JsonValue =
    if depth <= 0 { json_leaf(seed) }
    else {
        let pick = Int.abs(seed) % 4;
        if pick == 0 { JsonArray(json_items(seed, rand_between(seed, 0, 3), depth - 1, [])) }
        else if pick == 1 {
            JsonObject([
                JsonEntry { key: "a", value: json_value(next_seed(seed), depth - 1) },
                JsonEntry { key: "b", value: json_value(next_seed(next_seed(seed)), depth - 1) },
            ])
        }
        else { json_leaf(seed) }
    }

let json_items (seed: Int) (n: Int) (depth: Int) (acc: Array[JsonValue]): Array[JsonValue] =
    if n <= 0 { acc }
    else { json_items(next_seed(seed), n - 1, depth, acc.push(json_value(seed, depth))) }

let json_roundtrip (seed: Int) (left: Int): Unit =
    if left <= 0 { () } else {
        let text = json_stringify(json_value(seed, 3));
        let again = match json_parse(text) {
            Ok(v) => json_stringify(v),
            Err(e) => "PARSE ERROR: ".concat(e),
        };
        check_eq("json round trip", text, again, text);
        json_roundtrip(next_seed(seed), left - 1)
    }

pub let test_json_roundtrip (): Unit = {
    json_roundtrip(5150, 200);
    check_eq("json edge", "empty array", json_stringify(JsonArray([])), "[]");
    check_eq("json edge", "empty object", json_stringify(JsonObject([])), "{}");
    check_eq("json edge", "null", json_stringify(JsonNull), "null")
}

// --- Array laws ---

let array_laws (seed: Int) (left: Int): Unit =
    if left <= 0 { () } else {
        let xs = int_array(seed, rand_between(seed, 0, 12), []);
        let n = rand_between(next_seed(seed), 0, xs.len());
        let case = xs.to_string();

        check_eq("reverse twice", case, Array.reverse(Array.reverse(xs)).to_string(), case);
        // `take(n) ++ drop(n)` is the whole array, for every split
        // point including both ends.
        check_eq("take ++ drop", case.concat(" at ").concat(n.to_string()),
            Array.concat(xs.take(n), xs.drop(n)).to_string(), case);
        // Two functions that must never disagree about the same
        // question.
        if xs.len() > 0 {
            let probe = xs[Int.abs(seed) % xs.len()];
            check_eq("contains agrees with index_of", case.concat(" find ").concat(probe.to_string()),
                xs.contains(probe).to_string(),
                Option.is_some(xs.index_of(probe)).to_string())
        } else { () };
        array_laws(next_seed(seed), left - 1)
    }

pub let test_array_laws (): Unit = array_laws(60613, 150)

// --- String laws ---

let string_laws (seed: Int) (left: Int): Unit =
    if left <= 0 { () } else {
        let s = ascii_string(seed, rand_between(seed, 0, 10), "");
        let i = rand_between(next_seed(seed), 0, s.len());
        check_eq("slice halves rejoin", s.concat(" at ").concat(i.to_string()),
            s.slice(0, i).concat(s.slice(i, s.len())), s);
        let reps = rand_between(next_seed(next_seed(seed)), 0, 4);
        check_eq("repeat multiplies length", s.concat(" x ").concat(reps.to_string()),
            s.repeat(reps).len().to_string(), (s.len() * reps).to_string());
        string_laws(next_seed(seed), left - 1)
    }

pub let test_string_laws (): Unit = string_laws(8675309, 150)

// --- Float laws ---

let float_laws (seed: Int) (left: Int): Unit =
    if left <= 0 { () } else {
        let x = rand_between(seed, 0 - 100000, 100000).to_float() / 1000.0;
        let case = x.to_string();
        check_eq("floor <= x", case, (Float.floor(x) <= x).to_string(), "true");
        check_eq("x <= ceil", case, (x <= Float.ceil(x)).to_string(), "true");
        check_eq("ceil - floor <= 1", case, (Float.ceil(x) - Float.floor(x) <= 1.0).to_string(), "true");
        check_eq("abs is non-negative", case, (Float.abs(x) >= 0.0).to_string(), "true");
        // `sqrt` of a square, back to where it started. Compared with a
        // tolerance: this is the one law here that is not exact.
        let p = Float.abs(x);
        check_eq("sqrt of square", case, (Float.abs(Float.sqrt(p * p) - p) < 0.0001).to_string(), "true");
        float_laws(next_seed(seed), left - 1)
    }

pub let test_float_laws (): Unit = float_laws(2718, 150)

// --- String ordering ---

// The trichotomy and its consequences: for any two strings exactly one
// of `<`, `==`, `>` holds, and the operators agree with each other.
//
// These were WRONG until 2026-08-26, and wrong in a way no existing
// test could see. Ordered comparison of Strings emitted `icmp slt ptr`
// -- a comparison of ADDRESSES. It always produced an answer, so
// nothing crashed; the answer was whatever the allocator happened to
// do. `"p" > "a"` was false while `id("p") > id("a")` was true.
//
// The corpus could not catch it because the prelude works around it:
// `Array.sort_string` calls `string_le`, not `<=`. So the one place
// strings are ordered in anger never used the operators.
//
// The literal/runtime split is the reason both forms appear below. A
// property written only with literals, or only with values, would have
// passed on half the bug.
let str_order (seed: Int) (left: Int): Unit =
    if left <= 0 { () } else {
        let a = ascii_string(seed, rand_between(seed, 0, 5), "");
        let b = ascii_string(next_seed(seed), rand_between(next_seed(seed), 0, 5), "");
        let case = "[".concat(a).concat("] vs [").concat(b).concat("]");

        // Exactly one of the three holds.
        let lt = if a < b { 1 } else { 0 };
        let eq = if a == b { 1 } else { 0 };
        let gt = if a > b { 1 } else { 0 };
        check_eq("exactly one of < == >", case, (lt + eq + gt).to_string(), "1");

        // Each operator is the mirror of its opposite.
        check_eq("< mirrors >", case, (a < b).to_string(), (b > a).to_string());
        check_eq("<= mirrors >=", case, (a <= b).to_string(), (b >= a).to_string());
        check_eq("<= is not >", case, (a <= b).to_string(), (!(a > b)).to_string());

        // And a value compares to itself the way it must.
        check_eq("reflexive <=", case, (a <= a).to_string(), "true");
        check_eq("irreflexive <", case, (a < a).to_string(), "false");
        str_order(next_seed(seed), left - 1)
    }

// --- Float to Int ---
//
// Integers inside the exact-float range round-trip through `to_float`
// then `to_int`. Truncation toward zero does not move a value that is
// already whole. `round_to_int` agrees with `Float.round` then `to_int`.
let float_to_int_rt (seed: Int) (left: Int): Unit =
    if left <= 0 { () } else {
        let v = rand_between(seed, 0 - 1000000000, 1000000000);
        check_eq("int via float", v.to_string(), v.to_float().to_int().to_string(), v.to_string());
        let frac = 0.25;
        let truncated = if v >= 0 { (v.to_float() + frac).to_int() } else { (v.to_float() - frac).to_int() };
        check_eq("trunc toward zero", v.to_string(), truncated.to_string(), v.to_string());
        let x = v.to_float() + frac;
        check_eq("round_to_int matches round", x.to_string(), x.round_to_int().to_string(), Float.round(x).to_int().to_string());
        float_to_int_rt(next_seed(seed), left - 1)
    }

pub let test_float_to_int (): Unit = {
    float_to_int_rt(777, 200);
    check_eq("trunc 3.7", "3.7", (3.7).to_int().to_string(), "3");
    check_eq("trunc -3.7", "-3.7", (0.0 - 3.7).to_int().to_string(), "-3");
    check_eq("round 3.5", "3.5", (3.5).round_to_int().to_string(), "4");
    check_eq("round -3.5", "-3.5", (0.0 - 3.5).round_to_int().to_string(), "-4");
    let z = 0.0;
    check_eq("nan", "nan", (z / z).to_int().to_string(), "0");
    check_eq("+inf", "+inf", (1.0 / z).to_int().to_string(), "9223372036854775807");
    check_eq("-inf", "-inf", (0.0 - 1.0 / z).to_int().to_string(), "-9223372036854775808")
}

pub let test_string_ordering (): Unit = {
    str_order(90210, 150);
    // LITERAL operands, the half that was broken while runtime values
    // happened to work.
    check_eq("literal >", "p vs a", ("p" > "a").to_string(), "true");
    check_eq("literal >=", "p vs p", ("p" >= "p").to_string(), "true");
    check_eq("literal <", "a vs p", ("a" < "p").to_string(), "true");
    check_eq("literal longer", "ab vs aa", ("ab" > "aa").to_string(), "true");
    check_eq("literal prefix", "ab vs a", ("ab" > "a").to_string(), "true");
    // The operators and the sort must agree, since the prelude sorts
    // with a helper rather than with `<=`.
    check_eq("sort agrees", "cba", Array.sort_string(["c", "a", "b"]).to_string(), "[\"a\", \"b\", \"c\"]")
}

// --- Encoding round trips ---
//
// `decode(encode(b)) == b`, over generated byte buffers, for all three
// encodings.
//
// **Round trips alone are not enough here, and the reason is worth
// stating.** A round trip is self-consistent by construction: if the
// encoder and the decoder shared a wrong alphabet -- two characters
// swapped, say -- every round trip would still pass, and every byte
// this program ever exchanged with anything else would be wrong. The
// published RFC 4648 vectors below are the other half, and they are the
// half that checks against the world rather than against ourselves.
//
// Lengths deliberately span every residue mod 3 (base64's tail cases)
// and mod 2 (hex's pairing), because that is where the off-by-ones live.

let rand_bytes_acc (seed: Int) (left: Int) (acc: Array[Int]): Array[Int] =
    if left <= 0 { acc }
    else { rand_bytes_acc(next_seed(seed), left - 1, acc.push(rand_between(seed, 0, 255))) }

// The full byte range, including 0 and 255 -- the two a text-shaped
// encoder is most likely to mishandle.
let rand_bytes (seed: Int) (len: Int): Bytes = Bytes.from_array(rand_bytes_acc(seed, len, []))

let encoding_roundtrip (seed: Int) (left: Int): Unit =
    if left <= 0 { () } else {
        // 0..24 bytes covers every tail case several times over.
        let len = rand_between(seed, 0, 24);
        let b = rand_bytes(next_seed(seed), len);
        let want = b.to_hex();
        let label = "len ".concat(len.to_string()).concat(" = ").concat(want);

        check_eq("hex round trip", label,
            match Encoding.hex_decode(Encoding.hex_encode(b)) { Ok(d) => d.to_hex(), Err(e) => e }, want);
        check_eq("base64 round trip", label,
            match Encoding.base64_decode(Encoding.base64_encode(b)) { Ok(d) => d.to_hex(), Err(e) => e }, want);
        check_eq("base64url round trip", label,
            match Encoding.base64_url_decode(Encoding.base64_url_encode(b)) { Ok(d) => d.to_hex(), Err(e) => e }, want);
        check_eq("percent round trip", label,
            match Encoding.percent_decode(Encoding.percent_encode(b)) { Ok(d) => d.to_hex(), Err(e) => e }, want);

        encoding_roundtrip(next_seed(next_seed(seed)), left - 1)
    }

let b64_of (s: String): String = Encoding.base64_encode(s.as_bytes())
let hex_of (s: String): String = Encoding.hex_encode(s.as_bytes())

pub let test_encoding_roundtrip (): Unit = {
    encoding_roundtrip(4242, 120);

    // RFC 4648 section 10, verbatim. These are what catch a bug the
    // round trips cannot see.
    check_eq("rfc4648 b64", "\"\"", b64_of(""), "");
    check_eq("rfc4648 b64", "f", b64_of("f"), "Zg==");
    check_eq("rfc4648 b64", "fo", b64_of("fo"), "Zm8=");
    check_eq("rfc4648 b64", "foo", b64_of("foo"), "Zm9v");
    check_eq("rfc4648 b64", "foob", b64_of("foob"), "Zm9vYg==");
    check_eq("rfc4648 b64", "fooba", b64_of("fooba"), "Zm9vYmE=");
    check_eq("rfc4648 b64", "foobar", b64_of("foobar"), "Zm9vYmFy");

    // Same section, base16. Lowercase here; the RFC prints uppercase.
    check_eq("rfc4648 hex", "f", hex_of("f"), "66");
    check_eq("rfc4648 hex", "fo", hex_of("fo"), "666f");
    check_eq("rfc4648 hex", "foo", hex_of("foo"), "666f6f");
    check_eq("rfc4648 hex", "foobar", hex_of("foobar"), "666f6f626172");

    // The two alphabets must differ exactly where the RFC says: the
    // 62nd and 63rd characters, and nowhere else.
    let high = Bytes.from_array([251, 255]);
    check_eq("b64 std alphabet", "fbff", Encoding.base64_encode(high), "+/8=");
    check_eq("b64 url alphabet", "fbff", Encoding.base64_url_encode(high), "-_8");

    // Percent-encoding against the unreserved set, which is the whole
    // specification of this encoder.
    check_eq("pct unreserved", "alnum+mark",
        Encoding.percent_encode("azAZ09-._~".as_bytes()), "azAZ09-._~");
    check_eq("pct reserved", "delims",
        Encoding.percent_encode(" &=?#/+".as_bytes()), "%20%26%3D%3F%23%2F%2B");

    // Decoders reject rather than guess.
    check_eq("hex odd rejected", "686",
        match Encoding.hex_decode("686") { Ok(_) => "accepted", Err(_) => "rejected" }, "rejected");
    check_eq("b64 truncated rejected", "a",
        match Encoding.base64_decode("a") { Ok(_) => "accepted", Err(_) => "rejected" }, "rejected");
    check_eq("pct truncated rejected", "%2",
        match Encoding.percent_decode("%2") { Ok(_) => "accepted", Err(_) => "rejected" }, "rejected")
}
