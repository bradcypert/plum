use Os;
use Encoding;
use Url;
use Path;

// Property tests: invariants that must hold for MANY inputs, checked
// against values generated here rather than against answers recorded
// from a previous run.
//
// **Why this exists.** `bootstrap/interp-check` compares the compiler
// against the Rust interpreter, an independent implementation, and that
// is the only thing in this repo able to catch the compiler being
// CONFIDENTLY WRONG -- a recording just preserves whatever it did last
// time. But the interpreter now lags the language: it has no `Os.`
// namespace and no `x.f(a)` = `T.f(x, a)` rule, so those fixtures are
// skipped. New features are exactly what it cannot check, which makes
// its coverage inversely correlated with risk.
//
// A property does not lag. It is written in the language it tests, so a
// feature gets properties the day it lands, and it encodes an invariant
// known IN ADVANCE rather than whatever the implementation happens to
// produce. That is a different kind of independence from a second
// implementation, and a cheaper one to keep.
//
// **Deliberately deterministic.** A fixed seed, not a clock. A property
// that fails on one CI run in twenty and cannot be reproduced locally
// is worse than no property: it teaches people to re-run until green.
// Every failure here reproduces exactly.

// --- A generator ---

// A linear congruential generator, kept small ON PURPOSE. Plum checks
// integer overflow and aborts on it (`cg_overflow_guard`), so the usual
// 64-bit LCG constants would kill the test process rather than wrap.
// With `seed < 2^31` the product below peaks near 2.4e18, comfortably
// inside `Int`.
let PRNG_MOD (): Int = 2147483648

let next_seed (seed: Int): Int = (seed * 1103515245 + 12345) % PRNG_MOD()

// A value in [lo, hi]. `Int.abs` is applied to the seed rather than the
// result so a negative range still lands inside it.
let rand_between (seed: Int) (lo: Int) (hi: Int): Int =
    lo + (Int.abs(seed) % (hi - lo + 1))

// --- Reporting ---

// `assert_eq` prints the two values but not the INPUT that produced
// them, which for a property is the only thing that lets you reproduce
// it. This prints the case first, so a failure names it even though the
// abort message cannot.
let check_eq (label: String) (input: String) (got: String) (want: String): Unit =
    if got == want { () } else {
        println("PROPERTY FAILED: ".concat(label));
        println("  input: ".concat(input));
        println("  got:   ".concat(got));
        println("  want:  ".concat(want));
        panic_raw("property failed: ".concat(label))
    }

// --- Int round trip ---

// `parse_int(n.to_string()) == n`. The compiler's own `parse_int` and
// `to_string` are separate code paths, so this checks them against each
// other rather than against a recording.
// A sentinel no generated value can be, so a parse FAILURE is a
// visible mismatch rather than a coincidence.
let parsed_int (text: String): String =
    text.parse_int().unwrap_or(0 - 999999999999).to_string()

let int_roundtrip (seed: Int) (left: Int): Unit =
    if left <= 0 { () } else {
        let v = rand_between(seed, 0 - 1000000000, 1000000000);
        let text = v.to_string();
        check_eq("int round trip", text, parsed_int(text), text);
        int_roundtrip(next_seed(seed), left - 1)
    }

pub let test_int_roundtrip (): Unit = {
    int_roundtrip(12345, 300);
    // The edges a small generator will never reach on its own, and the
    // ones most likely to be wrong.
    check_eq("int edge", "0", parsed_int("0"), "0");
    check_eq("int edge", "max", parsed_int("9223372036854775807"), "9223372036854775807");
    check_eq("int edge", "min", parsed_int("-9223372036854775808"), "-9223372036854775808")
}

// --- Float round trip ---

// `parse_float(x.to_string()) == x`, over magnitudes that reach BOTH
// notations.
//
// This is the property the interpreter earned its keep on. The float
// formatting bug it caught -- `0.000001` printing as
// `1.0000000000000002e-06` -- is exactly a round-trip failure, and it
// would have been caught here without a second implementation. The
// runtime's own `plum_fmt_double` already works this way internally,
// retrying at 15, 16 and 17 digits until the text parses back to the
// same double; this checks the same invariant from outside.
let float_roundtrip (seed: Int) (left: Int): Unit =
    if left <= 0 { () } else {
        let mantissa = rand_between(seed, 1, 999999);
        let exponent = rand_between(next_seed(seed), 0 - 20, 20);
        let x = mantissa.to_float() * Float.pow(10.0, exponent.to_float());
        let text = x.to_string();
        check_eq("float round trip", text,
            text.parse_float().unwrap_or(0.0 - 1.0).to_string(), text);
        float_roundtrip(next_seed(next_seed(seed)), left - 1)
    }

pub let test_float_roundtrip (): Unit = {
    float_roundtrip(999, 300);
    // The two the formatting bug actually showed up on, and the
    // boundaries where `%g` switches notation.
    check_eq("float edge", "1e-06", "0.000001".parse_float().unwrap_or(0.0).to_string(), "1e-06");
    check_eq("float edge", "1e+20", "100000000000000000000.0".parse_float().unwrap_or(0.0).to_string(), "1e+20");
    check_eq("float edge", "0.1", "0.1".parse_float().unwrap_or(0.0).to_string(), "0.1");
    check_eq("float edge", "zero", 0.0.to_string(), "0")
}

// --- split / join ---

// `split(s, sep).join(sep) == s`, for any `s` and any non-empty `sep`.
// True by construction and easy to get wrong at the edges: a leading
// separator, a trailing one, two in a row, and the empty string all
// produce empty parts that must survive the round trip.
let sep_string (seed: Int) (left: Int) (acc: String): String =
    if left <= 0 { acc } else {
        let pick = Int.abs(seed) % 3;
        let c = if pick == 0 { "a" } else if pick == 1 { "b" } else { "," };
        sep_string(next_seed(seed), left - 1, acc.concat(c))
    }

let split_join (seed: Int) (left: Int): Unit =
    if left <= 0 { () } else {
        let s = sep_string(seed, rand_between(seed, 0, 12), "");
        check_eq("split/join round trip", "[".concat(s).concat("]"),
            s.split(",").join(","), s);
        split_join(next_seed(seed), left - 1)
    }

pub let test_split_join (): Unit = {
    split_join(4242, 200);
    check_eq("split/join edge", "empty", "".split(",").join(","), "");
    check_eq("split/join edge", "leading", ",a".split(",").join(","), ",a");
    check_eq("split/join edge", "trailing", "a,".split(",").join(","), "a,");
    check_eq("split/join edge", "doubled", "a,,b".split(",").join(","), "a,,b")
}

// --- Case mapping ---

// Over ASCII, case mapping preserves length and `to_upper` is settled
// after one application. Deliberately ASCII-only: `ß` uppercases to
// `SS` in some implementations and not others, which is a real
// divergence this project has already documented rather than a
// property violation.
let ascii_string (seed: Int) (left: Int) (acc: String): String =
    if left <= 0 { acc } else {
        let pick = Int.abs(seed) % 4;
        let c = if pick == 0 { "a" } else if pick == 1 { "Z" } else if pick == 2 { "m" } else { "7" };
        ascii_string(next_seed(seed), left - 1, acc.concat(c))
    }

let case_props (seed: Int) (left: Int): Unit =
    if left <= 0 { () } else {
        let s = ascii_string(seed, rand_between(seed, 1, 10), "");
        check_eq("upper preserves length", s, s.to_upper().len().to_string(), s.len().to_string());
        check_eq("upper is idempotent", s, s.to_upper().to_upper(), s.to_upper());
        check_eq("lower then upper", s, s.to_lower().to_upper(), s.to_upper());
        case_props(next_seed(seed), left - 1)
    }

pub let test_case_mapping (): Unit = case_props(31337, 150)

// --- Sorting ---

// A sort must produce a PERMUTATION that is ordered. Checking "ordered"
// alone passes for a function that returns an empty array, and checking
// length alone passes for one that returns its input untouched.
let is_sorted (xs: Array[Int]) (i: Int): Bool =
    if i + 1 >= xs.len() { true }
    else if xs[i] > xs[i + 1] { false }
    else { is_sorted(xs, i + 1) }

let int_array (seed: Int) (left: Int) (acc: Array[Int]): Array[Int] =
    if left <= 0 { acc }
    else { int_array(next_seed(seed), left - 1, acc.push(rand_between(seed, 0 - 50, 50))) }

let sort_props (seed: Int) (left: Int): Unit =
    if left <= 0 { () } else {
        let xs = int_array(seed, rand_between(seed, 0, 15), []);
        let sorted = Array.sort_int(xs);
        check_eq("sort orders", xs.to_string(), is_sorted(sorted, 0).to_string(), "true");
        check_eq("sort keeps length", xs.to_string(), sorted.len().to_string(), xs.len().to_string());
        check_eq("sort keeps sum", xs.to_string(), Array.sum_int(sorted).to_string(), Array.sum_int(xs).to_string());
        sort_props(next_seed(seed), left - 1)
    }

pub let test_sorting (): Unit = sort_props(777, 120)

// --- Arithmetic ---

// Identities that must hold whenever no operand overflows. `Int` is
// CHECKED here -- `+`/`-`/`*` abort rather than wrap -- so the ranges
// are chosen to stay inside, and what is being tested is that ordinary
// arithmetic is not quietly wrong near the guards.
let arith_props (seed: Int) (left: Int): Unit =
    if left <= 0 { () } else {
        let a = rand_between(seed, 0 - 1000000, 1000000);
        let b = rand_between(next_seed(seed), 0 - 1000000, 1000000);
        let case = a.to_string().concat(", ").concat(b.to_string());
        check_eq("add then subtract", case, ((a + b) - b).to_string(), a.to_string());
        check_eq("multiply then divide", case, ((a * 7) / 7).to_string(), a.to_string());
        check_eq("addition commutes", case, (a + b).to_string(), (b + a).to_string());
        check_eq("negate twice", case, (0 - (0 - a)).to_string(), a.to_string());
        arith_props(next_seed(next_seed(seed)), left - 1)
    }

pub let test_arithmetic (): Unit = arith_props(2024, 200)

// --- JSON ---

// `stringify(parse(stringify(v))) == stringify(v)`.
//
// Round-tripping through TEXT rather than comparing two `JsonValue`s,
// because there is no structural equality on them -- and the text is
// the thing that has to survive anyway, since JSON is what the language
// server speaks.
//
// This is aimed squarely at `parse_number`, which is shared between
// `json_parse` and `String.parse_float` and had its value computation
// rerouted through `strtod` on 2026-08-25. Nothing else guards it.
let json_leaf (seed: Int): JsonValue = {
    let pick = Int.abs(seed) % 5;
    if pick == 0 { JsonNull }
    else if pick == 1 { JsonBool(Int.abs(seed) % 2 == 0) }
    else if pick == 2 { JsonNumber(rand_between(seed, 0 - 100000, 100000).to_float()) }
    else if pick == 3 {
        // Exponent territory, where the number parser is most likely to
        // be wrong -- and was.
        JsonNumber(rand_between(seed, 1, 999999).to_float() * Float.pow(10.0, rand_between(next_seed(seed), 0 - 15, 15).to_float()))
    }
    else { JsonString(ascii_string(seed, rand_between(seed, 0, 6), "")) }
}

let json_value (seed: Int) (depth: Int): JsonValue =
    if depth <= 0 { json_leaf(seed) }
    else {
        let pick = Int.abs(seed) % 4;
        if pick == 0 { JsonArray(json_items(seed, rand_between(seed, 0, 3), depth - 1, [])) }
        else if pick == 1 {
            JsonObject([
                JsonEntry { key: "a", value: json_value(next_seed(seed), depth - 1) },
                JsonEntry { key: "b", value: json_value(next_seed(next_seed(seed)), depth - 1) },
            ])
        }
        else { json_leaf(seed) }
    }

let json_items (seed: Int) (n: Int) (depth: Int) (acc: Array[JsonValue]): Array[JsonValue] =
    if n <= 0 { acc }
    else { json_items(next_seed(seed), n - 1, depth, acc.push(json_value(seed, depth))) }

let json_roundtrip (seed: Int) (left: Int): Unit =
    if left <= 0 { () } else {
        let text = json_stringify(json_value(seed, 3));
        let again = match json_parse(text) {
            Ok(v) => json_stringify(v),
            Err(e) => "PARSE ERROR: ".concat(e),
        };
        check_eq("json round trip", text, again, text);
        json_roundtrip(next_seed(seed), left - 1)
    }

pub let test_json_roundtrip (): Unit = {
    json_roundtrip(5150, 200);
    check_eq("json edge", "empty array", json_stringify(JsonArray([])), "[]");
    check_eq("json edge", "empty object", json_stringify(JsonObject([])), "{}");
    check_eq("json edge", "null", json_stringify(JsonNull), "null")
}

// --- Array laws ---

let array_laws (seed: Int) (left: Int): Unit =
    if left <= 0 { () } else {
        let xs = int_array(seed, rand_between(seed, 0, 12), []);
        let n = rand_between(next_seed(seed), 0, xs.len());
        let case = xs.to_string();

        check_eq("reverse twice", case, Array.reverse(Array.reverse(xs)).to_string(), case);
        // `take(n) ++ drop(n)` is the whole array, for every split
        // point including both ends.
        check_eq("take ++ drop", case.concat(" at ").concat(n.to_string()),
            Array.concat(xs.take(n), xs.drop(n)).to_string(), case);
        // Two functions that must never disagree about the same
        // question.
        if xs.len() > 0 {
            let probe = xs[Int.abs(seed) % xs.len()];
            check_eq("contains agrees with index_of", case.concat(" find ").concat(probe.to_string()),
                xs.contains(probe).to_string(),
                Option.is_some(xs.index_of(probe)).to_string())
        } else { () };
        array_laws(next_seed(seed), left - 1)
    }

pub let test_array_laws (): Unit = array_laws(60613, 150)

// --- String laws ---

let string_laws (seed: Int) (left: Int): Unit =
    if left <= 0 { () } else {
        let s = ascii_string(seed, rand_between(seed, 0, 10), "");
        let i = rand_between(next_seed(seed), 0, s.len());
        check_eq("slice halves rejoin", s.concat(" at ").concat(i.to_string()),
            s.slice(0, i).concat(s.slice(i, s.len())), s);
        let reps = rand_between(next_seed(next_seed(seed)), 0, 4);
        check_eq("repeat multiplies length", s.concat(" x ").concat(reps.to_string()),
            s.repeat(reps).len().to_string(), (s.len() * reps).to_string());
        string_laws(next_seed(seed), left - 1)
    }

pub let test_string_laws (): Unit = string_laws(8675309, 150)

// --- Float laws ---

let float_laws (seed: Int) (left: Int): Unit =
    if left <= 0 { () } else {
        let x = rand_between(seed, 0 - 100000, 100000).to_float() / 1000.0;
        let case = x.to_string();
        check_eq("floor <= x", case, (Float.floor(x) <= x).to_string(), "true");
        check_eq("x <= ceil", case, (x <= Float.ceil(x)).to_string(), "true");
        check_eq("ceil - floor <= 1", case, (Float.ceil(x) - Float.floor(x) <= 1.0).to_string(), "true");
        check_eq("abs is non-negative", case, (Float.abs(x) >= 0.0).to_string(), "true");
        // `sqrt` of a square, back to where it started. Compared with a
        // tolerance: this is the one law here that is not exact.
        let p = Float.abs(x);
        check_eq("sqrt of square", case, (Float.abs(Float.sqrt(p * p) - p) < 0.0001).to_string(), "true");
        float_laws(next_seed(seed), left - 1)
    }

pub let test_float_laws (): Unit = float_laws(2718, 150)

// --- String ordering ---

// The trichotomy and its consequences: for any two strings exactly one
// of `<`, `==`, `>` holds, and the operators agree with each other.
//
// These were WRONG until 2026-08-26, and wrong in a way no existing
// test could see. Ordered comparison of Strings emitted `icmp slt ptr`
// -- a comparison of ADDRESSES. It always produced an answer, so
// nothing crashed; the answer was whatever the allocator happened to
// do. `"p" > "a"` was false while `id("p") > id("a")` was true.
//
// The corpus could not catch it because the prelude works around it:
// `Array.sort_string` calls `string_le`, not `<=`. So the one place
// strings are ordered in anger never used the operators.
//
// The literal/runtime split is the reason both forms appear below. A
// property written only with literals, or only with values, would have
// passed on half the bug.
let str_order (seed: Int) (left: Int): Unit =
    if left <= 0 { () } else {
        let a = ascii_string(seed, rand_between(seed, 0, 5), "");
        let b = ascii_string(next_seed(seed), rand_between(next_seed(seed), 0, 5), "");
        let case = "[".concat(a).concat("] vs [").concat(b).concat("]");

        // Exactly one of the three holds.
        let lt = if a < b { 1 } else { 0 };
        let eq = if a == b { 1 } else { 0 };
        let gt = if a > b { 1 } else { 0 };
        check_eq("exactly one of < == >", case, (lt + eq + gt).to_string(), "1");

        // Each operator is the mirror of its opposite.
        check_eq("< mirrors >", case, (a < b).to_string(), (b > a).to_string());
        check_eq("<= mirrors >=", case, (a <= b).to_string(), (b >= a).to_string());
        check_eq("<= is not >", case, (a <= b).to_string(), (!(a > b)).to_string());

        // And a value compares to itself the way it must.
        check_eq("reflexive <=", case, (a <= a).to_string(), "true");
        check_eq("irreflexive <", case, (a < a).to_string(), "false");
        str_order(next_seed(seed), left - 1)
    }

// --- Float to Int ---
//
// Integers inside the exact-float range round-trip through `to_float`
// then `to_int`. Truncation toward zero does not move a value that is
// already whole. `round_to_int` agrees with `Float.round` then `to_int`.
let float_to_int_rt (seed: Int) (left: Int): Unit =
    if left <= 0 { () } else {
        let v = rand_between(seed, 0 - 1000000000, 1000000000);
        check_eq("int via float", v.to_string(), v.to_float().to_int().to_string(), v.to_string());
        let frac = 0.25;
        let truncated = if v >= 0 { (v.to_float() + frac).to_int() } else { (v.to_float() - frac).to_int() };
        check_eq("trunc toward zero", v.to_string(), truncated.to_string(), v.to_string());
        let x = v.to_float() + frac;
        check_eq("round_to_int matches round", x.to_string(), x.round_to_int().to_string(), Float.round(x).to_int().to_string());
        float_to_int_rt(next_seed(seed), left - 1)
    }

pub let test_float_to_int (): Unit = {
    float_to_int_rt(777, 200);
    check_eq("trunc 3.7", "3.7", (3.7).to_int().to_string(), "3");
    check_eq("trunc -3.7", "-3.7", (0.0 - 3.7).to_int().to_string(), "-3");
    check_eq("round 3.5", "3.5", (3.5).round_to_int().to_string(), "4");
    check_eq("round -3.5", "-3.5", (0.0 - 3.5).round_to_int().to_string(), "-4");
    let z = 0.0;
    check_eq("nan", "nan", (z / z).to_int().to_string(), "0");
    check_eq("+inf", "+inf", (1.0 / z).to_int().to_string(), "9223372036854775807");
    check_eq("-inf", "-inf", (0.0 - 1.0 / z).to_int().to_string(), "-9223372036854775808")
}

pub let test_string_ordering (): Unit = {
    str_order(90210, 150);
    // LITERAL operands, the half that was broken while runtime values
    // happened to work.
    check_eq("literal >", "p vs a", ("p" > "a").to_string(), "true");
    check_eq("literal >=", "p vs p", ("p" >= "p").to_string(), "true");
    check_eq("literal <", "a vs p", ("a" < "p").to_string(), "true");
    check_eq("literal longer", "ab vs aa", ("ab" > "aa").to_string(), "true");
    check_eq("literal prefix", "ab vs a", ("ab" > "a").to_string(), "true");
    // The operators and the sort must agree, since the prelude sorts
    // with a helper rather than with `<=`.
    check_eq("sort agrees", "cba", Array.sort_string(["c", "a", "b"]).to_string(), "[\"a\", \"b\", \"c\"]")
}

// --- Encoding round trips ---
//
// `decode(encode(b)) == b`, over generated byte buffers, for all three
// encodings.
//
// **Round trips alone are not enough here, and the reason is worth
// stating.** A round trip is self-consistent by construction: if the
// encoder and the decoder shared a wrong alphabet -- two characters
// swapped, say -- every round trip would still pass, and every byte
// this program ever exchanged with anything else would be wrong. The
// published RFC 4648 vectors below are the other half, and they are the
// half that checks against the world rather than against ourselves.
//
// Lengths deliberately span every residue mod 3 (base64's tail cases)
// and mod 2 (hex's pairing), because that is where the off-by-ones live.

let rand_bytes_acc (seed: Int) (left: Int) (acc: Array[Int]): Array[Int] =
    if left <= 0 { acc }
    else { rand_bytes_acc(next_seed(seed), left - 1, acc.push(rand_between(seed, 0, 255))) }

// The full byte range, including 0 and 255 -- the two a text-shaped
// encoder is most likely to mishandle.
let rand_bytes (seed: Int) (len: Int): Bytes = Bytes.from_array(rand_bytes_acc(seed, len, []))

let encoding_roundtrip (seed: Int) (left: Int): Unit =
    if left <= 0 { () } else {
        // 0..24 bytes covers every tail case several times over.
        let len = rand_between(seed, 0, 24);
        let b = rand_bytes(next_seed(seed), len);
        let want = b.to_hex();
        let label = "len ".concat(len.to_string()).concat(" = ").concat(want);

        check_eq("hex round trip", label,
            match Encoding.hex_decode(Encoding.hex_encode(b)) { Ok(d) => d.to_hex(), Err(e) => e }, want);
        check_eq("base64 round trip", label,
            match Encoding.base64_decode(Encoding.base64_encode(b)) { Ok(d) => d.to_hex(), Err(e) => e }, want);
        check_eq("base64url round trip", label,
            match Encoding.base64_url_decode(Encoding.base64_url_encode(b)) { Ok(d) => d.to_hex(), Err(e) => e }, want);
        check_eq("percent round trip", label,
            match Encoding.percent_decode(Encoding.percent_encode(b)) { Ok(d) => d.to_hex(), Err(e) => e }, want);

        encoding_roundtrip(next_seed(next_seed(seed)), left - 1)
    }

let b64_of (s: String): String = Encoding.base64_encode(s.as_bytes())
let hex_of (s: String): String = Encoding.hex_encode(s.as_bytes())

pub let test_encoding_roundtrip (): Unit = {
    encoding_roundtrip(4242, 120);

    // RFC 4648 section 10, verbatim. These are what catch a bug the
    // round trips cannot see.
    check_eq("rfc4648 b64", "\"\"", b64_of(""), "");
    check_eq("rfc4648 b64", "f", b64_of("f"), "Zg==");
    check_eq("rfc4648 b64", "fo", b64_of("fo"), "Zm8=");
    check_eq("rfc4648 b64", "foo", b64_of("foo"), "Zm9v");
    check_eq("rfc4648 b64", "foob", b64_of("foob"), "Zm9vYg==");
    check_eq("rfc4648 b64", "fooba", b64_of("fooba"), "Zm9vYmE=");
    check_eq("rfc4648 b64", "foobar", b64_of("foobar"), "Zm9vYmFy");

    // Same section, base16. Lowercase here; the RFC prints uppercase.
    check_eq("rfc4648 hex", "f", hex_of("f"), "66");
    check_eq("rfc4648 hex", "fo", hex_of("fo"), "666f");
    check_eq("rfc4648 hex", "foo", hex_of("foo"), "666f6f");
    check_eq("rfc4648 hex", "foobar", hex_of("foobar"), "666f6f626172");

    // The two alphabets must differ exactly where the RFC says: the
    // 62nd and 63rd characters, and nowhere else.
    let high = Bytes.from_array([251, 255]);
    check_eq("b64 std alphabet", "fbff", Encoding.base64_encode(high), "+/8=");
    check_eq("b64 url alphabet", "fbff", Encoding.base64_url_encode(high), "-_8");

    // Percent-encoding against the unreserved set, which is the whole
    // specification of this encoder.
    check_eq("pct unreserved", "alnum+mark",
        Encoding.percent_encode("azAZ09-._~".as_bytes()), "azAZ09-._~");
    check_eq("pct reserved", "delims",
        Encoding.percent_encode(" &=?#/+".as_bytes()), "%20%26%3D%3F%23%2F%2B");

    // Decoders reject rather than guess.
    check_eq("hex odd rejected", "686",
        match Encoding.hex_decode("686") { Ok(_) => "accepted", Err(_) => "rejected" }, "rejected");
    check_eq("b64 truncated rejected", "a",
        match Encoding.base64_decode("a") { Ok(_) => "accepted", Err(_) => "rejected" }, "rejected");
    check_eq("pct truncated rejected", "%2",
        match Encoding.percent_decode("%2") { Ok(_) => "accepted", Err(_) => "rejected" }, "rejected")
}

// --- Url round trips ---
//
// `parse(stringify(u))` yields the same `Url` as `u`. Note the shape:
// NOT `stringify(parse(s)) == s`, which is false on purpose --
// `stringify` is canonical, so it drops a default port and adds the `/`
// a bare authority implies. Idempotence after one normalisation pass is
// the honest invariant, and it is the one that says a URL survives
// being taken apart and put back together.
//
// The parts are generated rather than whole URLs: assembling from
// pieces is what reaches combinations nobody would think to type, and
// the port/query/fragment presence flags are exactly the axes where a
// stringify bug hides.

let url_of (seed: Int): String = {
    let scheme = if rand_between(seed, 0, 1) == 0 { "http" } else { "https" };
    let host = ["a.example", "b.test", "127.0.0.1", "h"][rand_between(next_seed(seed), 0, 3)];
    // Includes each scheme's own default, which stringify must omit,
    // and the other's, which it must keep.
    let port = [0, 80, 443, 8080, 65535][rand_between(next_seed(next_seed(seed)), 0, 4)];
    let path = ["/", "/x", "/a/b/c", "/p%C3%A9"][rand_between(next_seed(seed) + 7, 0, 3)];
    let query = ["", "q=1", "a=1&b=2", "tag=a&tag=b", "e="][rand_between(next_seed(seed) + 3, 0, 4)];
    let frag = ["", "top", "a-b"][rand_between(next_seed(seed) + 11, 0, 2)];
    scheme.concat("://").concat(host)
        .concat(if port == 0 { "" } else { ":".concat(port.to_string()) })
        .concat(path)
        .concat(if String.is_empty(query) { "" } else { "?".concat(query) })
        .concat(if String.is_empty(frag) { "" } else { "#".concat(frag) })
}

let url_fields (u: Url.Url): String =
    u.scheme.concat("|").concat(u.host).concat("|").concat(u.port.to_string())
        .concat("|").concat(u.path).concat("|").concat(u.raw_query).concat("|").concat(u.fragment)

let url_roundtrip (seed: Int) (left: Int): Unit =
    if left <= 0 { () } else {
        let text = url_of(seed);
        match Url.parse(text) {
            Err(e) => check_eq("url parses", text, e, "parsed"),
            Ok(u) => {
                let again = Url.stringify(u);
                check_eq("url stringify round trip", text,
                    match Url.parse(again) { Ok(v) => url_fields(v), Err(e) => e },
                    url_fields(u));
                // Canonical means canonical: a second pass changes nothing.
                check_eq("url stringify idempotent", text,
                    match Url.parse(again) { Ok(v) => Url.stringify(v), Err(e) => e },
                    again)
            },
        };
        url_roundtrip(next_seed(seed), left - 1)
    }

// A query survives being built and read back, for values full of the
// characters that mean something in a query string.
let query_roundtrip (seed: Int) (left: Int): Unit =
    if left <= 0 { () } else {
        let value = ["a b", "c&d", "e=f", "100%", "", "a+b", "é", "?#/"][rand_between(seed, 0, 7)];
        let name = ["k", "a b", "n&m"][rand_between(next_seed(seed), 0, 2)];
        match Url.parse("http://h/p") {
            Err(e) => check_eq("query base parses", "http://h/p", e, "parsed"),
            Ok(base) => {
                let u = Url.with_query(base, [Url.Param { name: name, value: value }]);
                check_eq("query round trip", name.concat(" = ").concat(value),
                    match Url.query_get(u, name) { Some(v) => v, None => "<none>" }, value);
                // And it survives the text form, which is the part that
                // has to escape `&` and `=` correctly.
                check_eq("query survives stringify", name.concat(" = ").concat(value),
                    match Url.parse(Url.stringify(u)) {
                        Ok(v) => match Url.query_get(v, name) { Some(x) => x, None => "<none>" },
                        Err(e) => e,
                    }, value)
            },
        };
        query_roundtrip(next_seed(seed), left - 1)
    }

pub let test_url_roundtrip (): Unit = {
    url_roundtrip(31337, 150);
    query_roundtrip(8675309, 120);

    // The compatibility claim #26 was accepted on: for every URL the
    // HTTP client accepts today, `Url` agrees about what to connect to
    // and what to put in the request line. `Http` builds its request
    // target by leaving the query IN the path; `Url` splits them and
    // `request_target` puts them back, so these must match.
    check_eq("http compat target", "http://h/x?q=1",
        match Url.parse("http://h/x?q=1") { Ok(u) => Url.request_target(u), Err(e) => e }, "/x?q=1");
    check_eq("http compat target", "http://h",
        match Url.parse("http://h") { Ok(u) => Url.request_target(u), Err(e) => e }, "/");
    check_eq("http compat port", "http://h/x",
        match Url.parse("http://h/x") { Ok(u) => u.port.to_string(), Err(e) => e }, "80");
    check_eq("http compat port", "http://h:8080/x",
        match Url.parse("http://h:8080/x") { Ok(u) => u.port.to_string(), Err(e) => e }, "8080");
    check_eq("http compat host", "http://h:8080/x",
        match Url.parse("http://h:8080/x") { Ok(u) => u.host, Err(e) => e }, "h");

    // Parsing is not connecting: https parses even though the client
    // cannot yet speak it. This is the line that made the split worth
    // making.
    check_eq("https parses", "https://example.com/x",
        match Url.parse("https://example.com/x") { Ok(u) => u.port.to_string(), Err(e) => e }, "443")
}

// --- Path splits describe the same split ---
//
// `join(dirname(p), basename(p)) == clean(p)`, for every path.
//
// This is the invariant that decided how a TRAILING SEPARATOR is
// handled, and it is worth stating why it is not free. Python treats
// `a/b/` as having no file part (basename `""`, dirname `a/b`); Go
// strips the slash in `Base` but not in `Dir`, so it answers `b` and
// `a/b` -- and `join("a/b", "b")` is `a/b/b`, not `a/b`. Go's own pair
// does not round-trip. Stripping in both halves is what makes these two
// functions describe one split rather than two.
//
// Generated from parts rather than whole strings: the combinations that
// break this are trailing slashes, doubled slashes, `.`/`..` segments
// and a bare root, and assembling them reaches pairings nobody types.

let path_piece (seed: Int): String =
    ["a", "b", "..", ".", "x.plum", ".hidden", ""][rand_between(seed, 0, 6)]

let path_of (seed: Int): String = {
    let n = rand_between(seed, 1, 4);
    let lead = if rand_between(next_seed(seed), 0, 1) == 0 { "/" } else { "" };
    let body = path_body(next_seed(next_seed(seed)), n, "");
    let trail = if rand_between(seed + 7, 0, 3) == 0 { "/" } else { "" };
    lead.concat(body).concat(trail)
}

let path_body (seed: Int) (left: Int) (acc: String): String =
    if left <= 0 { acc }
    else {
        let piece = path_piece(seed);
        let sep = if String.is_empty(acc) { "" } else { "/" };
        path_body(next_seed(seed), left - 1, acc.concat(sep).concat(piece))
    }

let path_split_rt (seed: Int) (left: Int): Unit =
    if left <= 0 { () } else {
        let p = path_of(seed);
        check_eq("dirname+basename == clean", p,
            Path.join(Path.dirname(p), Path.basename(p)), Path.clean(p));
        // `clean` is idempotent: cleaning an already-clean path changes
        // nothing. A normaliser that is not idempotent has no canonical
        // form, and every comparison built on it is unreliable.
        check_eq("clean is idempotent", p, Path.clean(Path.clean(p)), Path.clean(p));
        path_split_rt(next_seed(seed), left - 1)
    }

pub let test_path_splits (): Unit = {
    path_split_rt(24601, 300);

    // The documented edges, which a generator will not reliably hit.
    check_eq("clean empty", "''", Path.clean(""), ".");
    check_eq("basename empty", "''", Path.basename(""), ".");
    check_eq("dirname empty", "''", Path.dirname(""), ".");
    check_eq("basename root", "/", Path.basename("/"), Path.separator());
    check_eq("dirname root", "/", Path.dirname("/"), Path.separator());

    // Extension and stem describe the same name.
    check_eq("stem+ext", "x.plum", Path.stem("x.plum").concat(".").concat(Path.extension("x.plum")), "x.plum");
    check_eq("leading dot is not an extension", ".hidden", Path.extension(".hidden"), "");
    check_eq("leading dot keeps its stem", ".hidden", Path.stem(".hidden"), ".hidden");

    // Joining must never invent an absolute path out of relative parts.
    check_eq("join stays relative", "a + b",
        Path.is_absolute(Path.join("a", "b")).to_string(), "false");
    check_eq("join keeps the first root", "/a + b",
        Path.is_absolute(Path.join("/a", "b")).to_string(), "true")
}

// --- Trigonometry and logs (issue #20) ---
//
// Identities, not recorded values. `sin(0.7)` matching whatever this
// compiler printed last time proves nothing about `sin`; the Pythagorean
// identity holding for every angle proves quite a lot, and would catch
// the two mistakes worth catching here -- a wrong libm symbol, and
// arguments swapped.
//
// The tolerance is 1e-9 rather than exact. These are the only functions
// in the prelude whose results are not exactly determined: libm is
// correctly rounded but not identical across platforms, so an equality
// test would pass on this machine and fail on somebody's.

let TRIG_EPS (): Float = 0.000000001

let close (a: Float) (b: Float): Bool = Float.abs(a - b) < TRIG_EPS()

let trig_laws (seed: Int) (left: Int): Unit =
    if left <= 0 { () } else {
        // Radians in roughly [-6.28, 6.28], so a full turn either way.
        let x = rand_between(seed, 0 - 6283, 6283).to_float() / 1000.0;
        let case = x.to_string();
        check_eq("sin^2 + cos^2 = 1", case,
            close(Float.sin(x) * Float.sin(x) + Float.cos(x) * Float.cos(x), 1.0).to_string(), "true");
        check_eq("sin is odd", case, close(Float.sin(0.0 - x), 0.0 - Float.sin(x)).to_string(), "true");
        check_eq("cos is even", case, close(Float.cos(0.0 - x), Float.cos(x)).to_string(), "true");
        check_eq("sin and cos are bounded", case,
            (Float.abs(Float.sin(x)) <= 1.0 && Float.abs(Float.cos(x)) <= 1.0).to_string(), "true");
        // `atan2(sin t, cos t)` is `t` folded into (-pi, pi]. Checked
        // through `cos`, which is even and periodic, so the fold does
        // not have to be spelled out -- and the ARGUMENT ORDER is what
        // this catches, since swapping them gives the co-angle.
        check_eq("atan2 recovers the angle", case,
            close(Float.cos(Float.atan2(Float.sin(x), Float.cos(x))), Float.cos(x)).to_string(), "true");
        // exp and log undo each other, on the range where log is defined.
        let p = Float.abs(x) + 0.001;
        check_eq("log undoes exp", case, close(Float.log(Float.exp(p)) - p, 0.0).to_string(), "true");
        check_eq("exp undoes log", case, (Float.abs(Float.exp(Float.log(p)) - p) < 0.000001).to_string(), "true");
        check_eq("log2 agrees with log", case,
            (Float.abs(Float.log2(p) - Float.log(p) / Float.log(2.0)) < 0.000001).to_string(), "true");
        // Degrees and radians are inverse, which is what stops a factor
        // of 180 or a stray pi from hiding in one of them.
        check_eq("degrees undoes radians", case,
            (Float.abs(Float.degrees(Float.radians(x)) - x) < 0.000001).to_string(), "true");
        trig_laws(next_seed(seed), left - 1)
    }

pub let test_trig_laws (): Unit = {
    trig_laws(31415, 200);

    // The values everyone knows, which a generator will not land on.
    check_eq("sin 0", "0", close(Float.sin(0.0), 0.0).to_string(), "true");
    check_eq("cos 0", "0", close(Float.cos(0.0), 1.0).to_string(), "true");
    check_eq("sin pi/2", "pi/2", close(Float.sin(Float.pi() / 2.0), 1.0).to_string(), "true");
    check_eq("cos pi", "pi", close(Float.cos(Float.pi()), 0.0 - 1.0).to_string(), "true");
    check_eq("tau is two pi", "tau", close(Float.tau(), 2.0 * Float.pi()).to_string(), "true");
    check_eq("log e", "e", close(Float.log(Float.e()), 1.0).to_string(), "true");
    check_eq("log10 1000", "1000", close(Float.log10(1000.0), 3.0).to_string(), "true");
    check_eq("radians 180", "180", close(Float.radians(180.0), Float.pi()).to_string(), "true");

    // `atan2` in all four quadrants. `atan(y/x)` cannot tell these
    // apart, and the whole point of `atan2` is that it can.
    check_eq("atan2 Q1", "1,1", close(Float.atan2(1.0, 1.0), Float.pi() / 4.0).to_string(), "true");
    check_eq("atan2 Q2", "1,-1", close(Float.atan2(1.0, 0.0 - 1.0), 3.0 * Float.pi() / 4.0).to_string(), "true");
    check_eq("atan2 Q3", "-1,-1", close(Float.atan2(0.0 - 1.0, 0.0 - 1.0), 0.0 - 3.0 * Float.pi() / 4.0).to_string(), "true");
    check_eq("atan2 Q4", "-1,1", close(Float.atan2(0.0 - 1.0, 1.0), 0.0 - Float.pi() / 4.0).to_string(), "true")
}

// --- Seeded random numbers (issue #20) ---
//
// The properties an `Rng` promises: the same seed replays exactly, a
// range is respected including its excluded upper bound, and a shuffle
// is a PERMUTATION rather than merely a rearrangement that lost or
// duplicated something.

let rng_take (r: Rng) (n: Int) (acc: Array[Int]): Array[Int] =
    if n <= 0 { acc } else {
        let (next, v) = Rng.int_range(r, 0, 1000);
        rng_take(next, n - 1, acc.push(v))
    }

let rng_in_range (r: Rng) (lo: Int) (hi: Int) (n: Int): Bool =
    if n <= 0 { true } else {
        let (next, v) = Rng.int_range(r, lo, hi);
        if v < lo || v >= hi { false } else { rng_in_range(next, lo, hi, n - 1) }
    }

let rng_floats_in_unit (r: Rng) (n: Int): Bool =
    if n <= 0 { true } else {
        let (next, f) = Rng.float(r);
        if f < 0.0 || f >= 1.0 { false } else { rng_floats_in_unit(next, n - 1) }
    }

let rng_laws (seed: Int) (left: Int): Unit =
    if left <= 0 { () } else {
        let case = seed.to_string();
        // Same seed, same sequence -- the entire reason this type exists.
        check_eq("a seed replays", case,
            Array.join(Array.map(rng_take(Rng.from_seed(seed), 20, []), |v: Int| v.to_string()), ","),
            Array.join(Array.map(rng_take(Rng.from_seed(seed), 20, []), |v: Int| v.to_string()), ","));
        // The upper bound is EXCLUDED, which is what makes
        // `int_range(r, 0, xs.len())` an index.
        check_eq("int_range respects its bounds", case,
            rng_in_range(Rng.from_seed(seed), 0 - 5, 7, 200).to_string(), "true");
        check_eq("float is in [0,1)", case,
            rng_floats_in_unit(Rng.from_seed(seed), 200).to_string(), "true");
        // An empty range has no number to return and must not draw one.
        let (_, empty) = Rng.int_range(Rng.from_seed(seed), 4, 4);
        check_eq("an empty range gives its low end", case, empty.to_string(), "4");
        // A shuffle keeps exactly the elements it was given. Sorting
        // both sides is what makes this about membership rather than
        // order -- a shuffle that dropped or duplicated one would show here.
        let xs = rng_take(Rng.from_seed(seed), 12, []);
        let (_, shuffled) = Rng.shuffle(Rng.from_seed(seed + 1), xs);
        check_eq("shuffle is a permutation", case,
            Array.join(Array.map(Array.sort_int(shuffled), |v: Int| v.to_string()), ","),
            Array.join(Array.map(Array.sort_int(xs), |v: Int| v.to_string()), ","));
        check_eq("shuffle keeps the length", case,
            shuffled.len().to_string(), xs.len().to_string());
        rng_laws(next_seed(seed), left - 1)
    }

pub let test_rng_laws (): Unit = {
    rng_laws(1729, 40);

    // Seeds a generator must survive: zero, negative, and one that
    // would land on a modulus boundary if it were used unfolded.
    check_eq("seed 0 is usable", "0",
        rng_in_range(Rng.from_seed(0), 0, 10, 100).to_string(), "true");
    check_eq("a negative seed is usable", "-99",
        rng_in_range(Rng.from_seed(0 - 99), 0, 10, 100).to_string(), "true");
    check_eq("seed 0 is not stuck", "0",
        (rng_take(Rng.from_seed(0), 5, [])[0] == rng_take(Rng.from_seed(0), 5, [])[4]).to_string(), "false");

    // Different seeds are different streams.
    check_eq("seeds differ", "1 vs 2",
        (Array.join(Array.map(rng_take(Rng.from_seed(1), 10, []), |v: Int| v.to_string()), ",")
         == Array.join(Array.map(rng_take(Rng.from_seed(2), 10, []), |v: Int| v.to_string()), ",")).to_string(),
        "false");

    // `choice` on an empty array has nothing to return.
    let (_, none) = Rng.choice(Rng.from_seed(5), []);
    check_eq("choice of nothing", "[]", Option.is_none(none).to_string(), "true")
}

// --- Bitwise laws ---
//
// Boolean algebra, which these operators either satisfy or are wrong.
// Recorded values would prove nothing here: `12 & 10 == 8` is one
// point, and De Morgan holding for thousands of pairs is a statement
// about the operator.
//
// The shift laws are the ones with edges worth generating against. A
// shift count is drawn from -0..70 deliberately, so counts AT and PAST
// the word width are exercised rather than assumed — those are defined
// behaviour here, not undefined, and the definition is what is checked.

let bitwise_laws (seed: Int) (left: Int): Unit =
    if left <= 0 { () } else {
        let a = rand_between(seed, 0 - 1000000, 1000000);
        let b = rand_between(next_seed(seed), 0 - 1000000, 1000000);
        let case = a.to_string().concat(" , ").concat(b.to_string());

        // Commutative, associative, and idempotent where they should be.
        check_eq("& commutes", case, (a & b).to_string(), (b & a).to_string());
        check_eq("| commutes", case, (a | b).to_string(), (b | a).to_string());
        check_eq("^ commutes", case, (a ^ b).to_string(), (b ^ a).to_string());
        check_eq("& is idempotent", case, (a & a).to_string(), a.to_string());
        check_eq("| is idempotent", case, (a | a).to_string(), a.to_string());

        // `^` is its own inverse, which is the property every use of it
        // for swapping or masking depends on.
        check_eq("^ cancels", case, (a ^ a).to_string(), "0");
        check_eq("^ round trip", case, ((a ^ b) ^ b).to_string(), a.to_string());

        // Complement.
        check_eq("~~ is identity", case, (~(~a)).to_string(), a.to_string());
        check_eq("a & ~a is empty", case, (a & ~a).to_string(), "0");
        check_eq("a | ~a is full", case, (a | ~a).to_string(), "-1");
        check_eq("~a is -a - 1", case, (~a).to_string(), (0 - a - 1).to_string());

        // De Morgan, both directions.
        check_eq("de morgan and", case, (~(a & b)).to_string(), (~a | ~b).to_string());
        check_eq("de morgan or", case, (~(a | b)).to_string(), (~a & ~b).to_string());

        // Absorption, which catches a precedence mistake as well as an
        // operator one.
        check_eq("absorption", case, (a & (a | b)).to_string(), a.to_string());

        // Identity and annihilator elements.
        check_eq("& all ones", case, (a & (0 - 1)).to_string(), a.to_string());
        check_eq("| zero", case, (a | 0).to_string(), a.to_string());
        check_eq("& zero", case, (a & 0).to_string(), "0");
        check_eq("^ zero", case, (a ^ 0).to_string(), a.to_string());

        // --- Shifts ---
        //
        // Counts run past 63 on purpose: those are DEFINED, and the
        // definition is what is being checked.
        let n = rand_between(next_seed(next_seed(seed)), 0, 70);
        let scase = case.concat(" << ").concat(n.to_string());

        // A left shift doubles, until it runs out of room. Checked
        // against repeated addition rather than multiplication, because
        // `*` traps on overflow and `<<` does not.
        check_eq("<< by 0", scase, (a << 0).to_string(), a.to_string());
        check_eq(">> by 0", scase, (a >> 0).to_string(), a.to_string());
        check_eq("<< by 1 doubles", case, (a << 1).to_string(), (a + a).to_string());

        // Past the word width both are total, and their answers are the
        // limit of the sequence rather than garbage.
        if n >= 64 {
            check_eq("<< past the width is 0", scase, (a << n).to_string(), "0");
            check_eq(">> past the width is the sign", scase,
                (a >> n).to_string(), (if a < 0 { 0 - 1 } else { 0 }).to_string())
        } else { () };

        // An arithmetic shift right is a floor division by a power of
        // two, which is where it differs from truncating `/` for
        // negatives -- and is the reason `Rng` needs `plum__mod_floor`.
        check_eq(">> by 1 halves toward -inf", case,
            (a >> 1).to_string(), (if a < 0 { (a - 1) / 2 } else { a / 2 }).to_string());

        // The unsigned shift agrees with the signed one on
        // non-negatives, and differs on exactly the sign bit.
        let p = Int.abs(a);
        check_eq("ushr agrees on non-negatives", case,
            Int.shr_logical(p, 3).to_string(), (p >> 3).to_string());
        check_eq("ushr never goes negative", scase,
            (Int.shr_logical(a, 1) >= 0).to_string(), "true");
        check_eq("ushr by 0 is identity", case, Int.shr_logical(a, 0).to_string(), a.to_string());
        check_eq("ushr past the width is 0", scase,
            (if n >= 64 { Int.shr_logical(a, n) } else { 0 }).to_string(), "0");

        // Population count, and its complement.
        check_eq("ones of a and ~a fill the word", case,
            (Int.count_ones(a) + Int.count_ones(~a)).to_string(), "64");
        check_eq("ones is in range", case,
            (Int.count_ones(a) >= 0 && Int.count_ones(a) <= 64).to_string(), "true");

        bitwise_laws(next_seed(seed), left - 1)
    }

pub let test_bitwise_laws (): Unit = {
    bitwise_laws(20250908, 200);

    // The values that pin PRECEDENCE, which no law above can see:
    // every one of these parses differently in C.
    check_eq("bitwise binds tighter than ==", "12 & 10 == 8", (12 & 10 == 8).to_string(), "true");
    check_eq("shifts bind like multiplication", "1 << 3 + 1", (1 << 3 + 1).to_string(), "9");
    check_eq("& binds tighter than ^", "12 ^ 10 & 6", (12 ^ 10 & 6).to_string(), (12 ^ (10 & 6)).to_string());
    check_eq("^ binds tighter than |", "1 | 6 ^ 3", (1 | 6 ^ 3).to_string(), (1 | (6 ^ 3)).to_string());
    check_eq("~ binds tightest", "~5 + 1", (~5 + 1).to_string(), ((~5) + 1).to_string());

    // The word's edges.
    check_eq("the sign bit", "1 << 63", (1 << 63).to_string(), "-9223372036854775808");
    check_eq("count_ones of the sign bit", "1 << 63", Int.count_ones(1 << 63).to_string(), "1");
    check_eq("count_ones of -1", "-1", Int.count_ones(0 - 1).to_string(), "64");
    check_eq("ushr of the sign bit", "-1 >> 63", Int.shr_logical(0 - 1, 63).to_string(), "1")
}

// --- Formatting laws (issue #23) ---
//
// The interesting ones are round trips. A recorded string proves the
// function did what it did last time; `to_radix` then reading the
// digits back proves it is a base conversion.

let digit_value_at (c: String): Int =
    match String.index_of("0123456789abcdefghijklmnopqrstuvwxyz", c) { Some(i) => i, None => 0 - 1 }

// Reads a radix string back to an Int, which is the inverse `parse_int`
// only offers for base 10.
let from_radix (s: String) (radix: Int): Int = {
    let neg = String.starts_with(s, "-");
    let body = if neg { String.slice(s, 1, String.char_len(s)) } else { s };
    let v = from_radix_acc(chars_of(body), radix, 0, 0);
    if neg { 0 - v } else { v }
}

let from_radix_acc (cs: Array[String]) (radix: Int) (i: Int) (acc: Int): Int =
    if i >= cs.len() { acc } else { from_radix_acc(cs, radix, i + 1, acc * radix + digit_value_at(cs[i])) }

let count_char (s: String) (c: String): Int =
    Array.fold(chars_of(s), 0, |acc, ch| if ch == c { acc + 1 } else { acc })

let format_laws (seed: Int) (left: Int): Unit =
    if left <= 0 { () } else {
        let n = rand_between(seed, 0 - 100000000, 100000000);
        let radix = rand_between(next_seed(seed), 2, 36);
        let case = n.to_string().concat(" base ").concat(radix.to_string());

        // A base conversion is reversible. This is the property; the
        // digits themselves are an implementation detail.
        check_eq("to_radix round trips", case,
            from_radix(Int.to_radix(n, radix), radix).to_string(), n.to_string());
        // Base 10 must agree with the one everybody already uses.
        check_eq("base 10 is to_string", case, Int.to_radix(n, 10), n.to_string());
        check_eq("hex is radix 16", case, Int.to_hex(n), Int.to_radix(n, 16));
        check_eq("binary is radix 2", case, Int.to_binary(n), Int.to_radix(n, 2));
        // The sign lives in the string, not in the digits.
        check_eq("sign is a prefix", case,
            String.starts_with(Int.to_radix(n, radix), "-").to_string(), (n < 0).to_string());

        // Bit patterns are fixed width, and their ones agree with
        // `count_ones` -- two independent implementations of the same
        // question, which is what makes this worth checking.
        check_eq("to_bits is 64 wide", case, String.char_len(Int.to_bits(n)).to_string(), "64");
        check_eq("to_hex_bits is 16 wide", case, String.char_len(Int.to_hex_bits(n)).to_string(), "16");
        check_eq("bits agree with count_ones", case,
            count_char(Int.to_bits(n), "1").to_string(), Int.count_ones(n).to_string());
        // A non-negative number's bit pattern is its unsigned hex,
        // zero-extended -- so the two renderings cannot drift apart.
        let p = Int.abs(n);
        check_eq("hex_bits ends with hex", case,
            String.ends_with(Int.to_hex_bits(p), Int.to_hex(p)).to_string(), "true");

        // --- Fixed decimals ---
        let d = rand_between(next_seed(next_seed(seed)), 0, 9);
        let x = rand_between(seed, 0 - 1000000, 1000000).to_float() / 1000.0;
        let fcase = x.to_string().concat(" to ").concat(d.to_string()).concat("dp");
        let text = Float.to_fixed(x, d);

        // Exactly `d` digits after the point, and a point only when
        // there are digits to follow it.
        check_eq("decimal places", fcase, count_char(text, ".").to_string(), (if d == 0 { 0 } else { 1 }).to_string());
        if d > 0 {
            check_eq("digits after the point", fcase,
                (String.char_len(text) - Option.unwrap_or(String.index_of(text, "."), 0) - 1).to_string(),
                d.to_string())
        } else { () };
        // The rendering is within half a unit in the last place of the
        // value -- which is what "correctly rounded" means, and is a
        // statement no recorded string can make.
        check_eq("stays within half a ulp", fcase,
            (Float.abs(Result.unwrap_or(String.parse_float(text), 0.0 - 999999.0) - x)
                <= 0.5 / Float.pow(10.0, d.to_float()) + 0.0000001).to_string(), "true");

        // --- Padding ---
        let w = rand_between(next_seed(seed), 0, 20);
        let s = String.slice("abcdefghij", 0, rand_between(seed, 0, 10));
        let pcase = "'".concat(s).concat("' to ").concat(w.to_string());
        check_eq("pad_center reaches the width", pcase,
            String.char_len(String.pad_center(s, w, ".")).to_string(),
            Int.max(w, String.char_len(s)).to_string());
        check_eq("pad_center keeps the text", pcase,
            String.contains(String.pad_center(s, w, "."), s).to_string(), "true");
        // The three pads agree on length, differing only in placement.
        check_eq("pads agree on width", pcase,
            String.char_len(String.pad_left(s, w, ".")).to_string(),
            String.char_len(String.pad_center(s, w, ".")).to_string());

        format_laws(next_seed(seed), left - 1)
    }

pub let test_format_laws (): Unit = {
    format_laws(90210, 200);

    // Edges a generator will not reliably reach.
    check_eq("radix of zero", "0", Int.to_hex(0), "0");
    check_eq("bits of zero", "0", count_char(Int.to_bits(0), "1").to_string(), "0");
    check_eq("bits of -1", "-1", count_char(Int.to_bits(0 - 1), "1").to_string(), "64");
    // The most negative Int cannot be negated, so its conversion has to
    // peel the last digit off first.
    check_eq("radix of the most negative Int", "min",
        Int.to_radix(1 << 63, 16), "-8000000000000000");
    check_eq("radix is clamped", "base 99", Int.to_radix(255, 99), Int.to_radix(255, 36));

    // Half to EVEN, unlike `Float.round`. Pinned because it is
    // surprising, standard, and would otherwise look like a bug -- and
    // because the C library does NOT agree across platforms on these
    // four, which is what CI on Windows found. The prelude rounds the
    // digits itself so that every platform answers the same.
    check_eq("half to even at .5", "0.5", Float.to_fixed(0.5, 0), "0");
    check_eq("half to even at 3.5", "3.5", Float.to_fixed(3.5, 0), "4");
    check_eq("tie to even down", "0.125", Float.to_fixed(0.125, 2), "0.12");
    check_eq("tie to even up", "0.375", Float.to_fixed(0.375, 2), "0.38");
    // A carry that runs off the end of the kept digits.
    check_eq("carry into the units", "9.99", Float.to_fixed(9.99, 1), "10.0");
    check_eq("carry through two digits", "99.995", Float.to_fixed(99.995, 2), "100.00");
    check_eq("half to even at 1.5", "1.5", Float.to_fixed(1.5, 0), "2");
    check_eq("half to even at 2.5", "2.5", Float.to_fixed(2.5, 0), "2");
    check_eq("round is half away from zero", "2.5", Float.round(2.5).to_string(), "3");
    // Correctly rounded from the exact binary value: 2.675 is really
    // 2.674999..., which a scale-and-round implementation gets wrong.
    check_eq("rounds from the exact value", "2.675", Float.to_fixed(2.675, 2), "2.67");
    check_eq("a negative that rounds to zero keeps its sign", "-0.001",
        Float.to_fixed(0.0 - 0.001, 2), "-0.00")
}
