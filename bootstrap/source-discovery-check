#!/usr/bin/env python3
"""Check source order/metadata and linear allocation growth during discovery.

Build the real compiler sources with a discovery-only entry point. This avoids
parsing/LLVM generation obscuring the allocation cost being tested. Runtime
allocated bytes catch prefix copying even when allocation counts stay linear.
"""
import os
from pathlib import Path
import re
import shutil
import subprocess
import sys
import tempfile

ROOT = Path(__file__).resolve().parent.parent
COMPILER = Path(sys.argv[1] if len(sys.argv) > 1 else ROOT / "sh.real").resolve()

ENTRY = '''
let main (): Unit = {
    let argv = args();
    if argv[0] == "native" || argv[0] == "native-dep" {
        let builder = source_builder();
        for path in native_c_files_policy(argv[1], argv[2], builder, argv[0] == "native") { println(path); }
    } else {
    let inputs = prepare_inputs(argv[1]);
    if argv[0] == "readback" {
        let parsed = parse_source_files(inputs.files, 0, []);
        let file = inputs.files[0];
        assert(Result.is_ok(treefs.read_source(file.path)));
        assert(Result.is_ok(Os.rename_file(file.path, "${file.path}.saved")));
        assert(Result.is_ok(Os.write_file(file.path, "untrusted replacement")));
        assert(Result.is_err(treefs.read_source(file.path)));
        treefs.clear_source_locations(());
        assert(Result.is_err(treefs.read_source(file.path)));
        println("confined diagnostic reads");
    }
    else if argv[0] == "replace" {
        let file = inputs.files[0];
        assert(Result.is_ok(Os.rename_file(file.path, "${file.path}.saved")));
        assert(Result.is_ok(Os.write_file(file.path, "let changed (): Int = 2")));
        let parsed = parse_source_files(inputs.files, 0, []);
        println(parsed.len().to_string())
    }
    else if argv[0] == "count" { println(inputs.files.len().to_string()) }
    else {
        for dep in inputs.deps { println("D|${dep.name}|${dep.path}"); };
        for f in inputs.files { println("F|${f.path}|${f.module_name}|${f.owner}|${f.dep_name}"); };
    }
    }
}
'''


def run(command, ok=True, **kwargs):
    result = subprocess.run(list(map(str, command)), capture_output=True, text=True,
                            timeout=180, **kwargs)
    assert (result.returncode == 0) == ok, result.stdout + result.stderr
    return result


def write(path, text=""):
    path.parent.mkdir(parents=True, exist_ok=True)
    path.write_text(text)


with tempfile.TemporaryDirectory(prefix="plum-discovery-") as tmp:
    work = Path(tmp)
    harness = work / "bootstrap/self_host"
    shutil.copytree(ROOT / "bootstrap/self_host", harness)
    # Preserve relative @embed_file paths without symlinks (Windows CI too).
    shutil.copytree(ROOT / "bootstrap/std", work / "bootstrap/std")
    shutil.copytree(ROOT / "native_stdlib", work / "native_stdlib")
    shutil.copytree(ROOT / "vendor", work / "vendor")
    main = harness / "main.plum"
    source = main.read_text()
    assert source.count("let main (): Unit = {") == 1
    main.write_text(source.replace("let main (): Unit = {", "let compiler_main (): Unit = {") + ENTRY)
    binary = work / "discover"
    run([COMPILER, "build", harness, "-o", binary])

    def discover(path, mode="list", ok=True):
        return run([binary, mode, path], ok=ok,
                   env=dict(os.environ, PLUM_RT_STATS="1"))

    def expected_path(path, module, owner="", dep=""):
        if path.is_dir():
            out = []
            for entry in os.listdir(path):
                if not entry.startswith("."):
                    out.extend(expected_path(path / entry, module, owner, dep))
            return out
        return [f"F|{path}|{module}|{owner}|{dep}"] if str(path).endswith(".plum") else []

    def expected_root(path, dep=""):
        out = []
        for entry in os.listdir(path):
            if entry.startswith(".") or (not dep and entry == "vendor"):
                continue
            child = path / entry
            if dep and not child.is_dir():
                continue
            module = entry if child.is_dir() else ""
            if dep:
                module = dep if module == dep else f"{dep}.{module}"
            out.extend(expected_path(child, module, str(path) if dep else "", dep))
        return out

    app = work / "app"
    # Include nested files, hidden entries, ignored files and nested vendor/.
    # Files below a/b remain in module a under current language semantics.
    for name in ["z.plum", "a/nested/one.plum", "a/two.plum", "a/vendor/v.plum",
                 "b/three.plum", ".hidden.plum", ".hidden/f.plum",
                 "a/.hidden.plum", "a/.hidden/f.plum", "vendor/skip.plum", "readme.txt"]:
        write(app / name)
    empty = work / "empty"
    empty.mkdir()
    for path in [app, empty, app / "z.plum", app / "readme.txt"]:
        expected = expected_root(path) if path.is_dir() else expected_path(path, "")
        assert discover(path).stdout.splitlines() == expected

    for dep in ["alpha", "beta"]:
        write(work / dep / dep / "one.plum")
        write(work / dep / "extra/nested/two.plum")
        write(work / dep / "vendor/v.plum")
        write(work / dep / ".hidden/f.plum")
        write(work / dep / "readme.txt")
    write(app / "plum.pkg", 'Package { name: "app", deps: [ Dep { name: "alpha", path: "../alpha" }, Dep { name: "beta", path: "../beta" } ] }\n')
    lines = discover(app).stdout.splitlines()
    deps = [line.split("|")[1:] for line in lines if line.startswith("D|")]
    assert {name for name, _ in deps} == {"alpha", "beta"}
    expected = expected_root(app)
    for name, path in deps:
        expected.extend(expected_root(Path(path), name))
    assert [line for line in lines if line.startswith("F|")] == expected
    write(work / "alpha/bad.plum")
    rejected = discover(app, ok=False)
    assert "has Plum source at its root" in rejected.stdout + rejected.stderr
    (work / "alpha/bad.plum").unlink()
    print("source-discovery: order, filtering, modules, ownership and dependency rejection passed")

    # A hidden target is not independently discovered, so its visible alias
    # is valid. Visible aliases of one physical source are ambiguous.
    links = work / "links"
    write(links / ".storage/target.plum", "let main (): Unit = ()\n")
    try:
        (links / "main.plum").symlink_to(".storage/target.plum")
    except OSError:
        print("source-discovery: symlinks unavailable on this runner")
    else:
        result = discover(links)
        assert f"F|{links / 'main.plum'}|||" in result.stdout
        write(links / "plum.pkg", 'Package { name: "links", symlinks: "reject" }')
        result = discover(links, ok=False)
        assert "refused link" in result.stdout + result.stderr, result.stdout + result.stderr
        (links / "plum.pkg").unlink()
        (links / "alias.plum").symlink_to(".storage/target.plum")
        result = discover(links, ok=False)
        assert "duplicate filesystem identity" in result.stdout + result.stderr
        (links / "alias.plum").unlink()
        (links / "main.plum").unlink()
        for target, cause in [("../app/z.plum", "escapes filesystem root"),
                              (str(app / "z.plum"), "absolute"),
                              ("missing.plum", "errno 2")]:
            (links / "main.plum").symlink_to(target)
            result = discover(links, ok=False)
            assert "cannot discover sources" in result.stdout + result.stderr
            assert cause in result.stdout + result.stderr, result.stdout + result.stderr
            (links / "main.plum").unlink()
        (links / "loop").symlink_to(".", target_is_directory=True)
        result = discover(links, ok=False)
        assert "duplicate filesystem identity" in result.stdout + result.stderr
        (links / "loop").unlink()
        (links / "one").symlink_to(".storage", target_is_directory=True)
        (links / "two").symlink_to(".storage", target_is_directory=True)
        result = discover(links, ok=False)
        assert "duplicate filesystem identity" in result.stdout + result.stderr
        (links / "one").unlink()
        (links / "two").unlink()
    # Selecting a subtree changes the selected sources and module layout, not
    # the declared root's boundary, dependencies or link policy.
    policy = work / "policy"
    selected = policy / "nested"
    write(policy / "plum.pkg", 'Package { name: "policy", symlinks: "reject" }')
    write(policy / ".storage/shared", "let selected (): Int = 1")
    write(selected / "own.plum")
    write(selected / "module/member.plum")
    write(policy / "unselected.plum")
    result = discover(selected)
    assert result.stdout.splitlines() == expected_root(selected)
    relative = run([binary, "list", "policy/nested"], cwd=work)
    assert relative.stdout.splitlines() == [line.replace(str(policy), "policy") for line in expected_root(selected)]
    try:
        (selected / "alias.plum").symlink_to("../.storage/shared")
    except OSError:
        pass
    else:
        assert "refused link" in discover(selected, ok=False).stdout
        write(policy / "plum.pkg", 'Package { name: "policy", symlinks: "within-root" }')
        result = discover(selected)
        assert f"F|{selected / 'alias.plum'}|||" in result.stdout
        assert str(policy / "unselected.plum") not in result.stdout
        write(selected / "native/.keep")
        write(policy / ".storage/shim", "int selected(void) { return 1; }")
        (selected / "native/shim.c").symlink_to("../../.storage/shim")
        assert str(selected / "native/shim.c") in run([binary, "native", selected, "linux"]).stdout
        write(policy / "plum.pkg", 'Package { name: "policy", symlinks: "reject" }')
        run([binary, "native", selected, "linux"], ok=False)
        # A declared dependency under that same ancestor has its own policy
        # and boundary, even without a manifest of its own.
        dependency = policy / "dependency"
        write(dependency / ".storage/code", "pub let value (): Int = 1")
        (dependency / "module").mkdir()
        (dependency / "module/value.plum").symlink_to("../.storage/code")
        consumer = work / "policy-consumer"
        write(consumer / "plum.pkg", 'Package { name: "consumer", deps: [Dep { name: "dep", path: "../policy/dependency" }] }')
        result = discover(consumer)
        assert str(dependency / "module/value.plum") in result.stdout
        write(dependency / ".storage/shim", "int dependency(void) { return 1; }")
        (dependency / "native").mkdir()
        (dependency / "native/shim.c").symlink_to("../.storage/shim")
        native_dep = run([binary, "native-dep", dependency, "linux"])
        assert str(dependency / "native/shim.c") in native_dep.stdout
        (dependency / "module/value.plum").unlink()
        (dependency / "module/value.plum").symlink_to("../../.storage/shared")
        discover(consumer, ok=False)
    # Dependencies declared at the parent remain available for a selected
    # directory and explicit file without pulling in unselected own sources.
    for selection in [app / "a", app / "z.plum"]:
        result = discover(selection)
        assert {line.split("|")[1] for line in result.stdout.splitlines() if line.startswith("D|")} == {"alpha", "beta"}
        assert f"F|{app / 'b/three.plum'}|" not in result.stdout
    deep = policy / "deep"
    for _ in range(130):
        deep = deep / "d"
    deep.mkdir(parents=True)
    failure = discover(deep, ok=False)
    assert "manifest lookup exceeds 128" in failure.stdout + failure.stderr
    executable = work / "selected-executable"
    write(executable / "plum.pkg", 'Package { name: "selected", deps: [Dep { name: "helper", path: "../selected-helper" }] }')
    write(work / "selected-helper/helper/main.plum", 'pub let answer (): String = "nested selection"')
    write(executable / "unselected.plum", "this is intentionally not valid Plum")
    entry = executable / "nested/main.plum"
    write(entry, 'use helper;\nlet main (): Unit = println(helper.answer())')
    for selection in [entry.parent, entry]:
        assert run([COMPILER, "run", selection]).stdout.strip() == "nested selection"
    print("source-discovery: selected subtrees preserve root policy, dependencies and logical paths")

    diagnostic = work / "diagnostic"
    write(diagnostic / "main.plum", "let original (): Int = 1")
    assert "confined diagnostic reads" in discover(diagnostic, "readback").stdout

    replaced = work / "replaced"
    write(replaced / "main.plum", "let original (): Int = 1")
    result = discover(replaced, "replace", ok=False)
    assert "source identity changed during discovery" in result.stdout + result.stderr
    hardlinks = work / "hardlinks"
    write(hardlinks / "one.plum")
    os.link(hardlinks / "one.plum", hardlinks / "two.plum")
    result = discover(hardlinks, ok=False)
    assert "duplicate filesystem identity" in result.stdout + result.stderr
    print("source-discovery: confinement, link policy, cycles and physical aliases passed")

    # Exercise native enumeration directly so target selection is independent
    # of Plum module discovery. The native compiler itself is a trusted tool.
    def native(path, target="linux", ok=True):
        return run([binary, "native", path, target], ok=ok)

    native_project = work / "native-project"
    for name in ["native/shared.c", "native/config.h", "native/linux/linux.c",
                 "native/posix/posix.c", "native/windows/windows.c", "native/macos/macos.c"]:
        write(native_project / name)
    for target in ["linux", "windows", "macos"]:
        expected = []
        for name in os.listdir(native_project / "native"):
            path = native_project / "native" / name
            if path.is_dir() and (name == target or (name == "posix" and target != "windows")):
                expected.extend(str(path / child) for child in os.listdir(path) if child.endswith(".c"))
            elif path.is_file() and name.endswith(".c"):
                expected.append(str(path))
        assert native(native_project, target).stdout.splitlines() == expected
    write(native_project / "native/win32/wrong.c")
    result = native(native_project, ok=False)
    assert "not a target directory" in result.stdout + result.stderr
    shutil.rmtree(native_project / "native/win32")
    os.link(native_project / "native/shared.c", native_project / "native/duplicate.c")
    result = native(native_project, ok=False)
    assert "duplicate filesystem identity" in result.stdout + result.stderr
    (native_project / "native/duplicate.c").unlink()
    write(native_project / ".body", "int native_body(void) { return 1; }")
    native_alias = native_project / "native/alias.c"
    try:
        native_alias.symlink_to("../.body")
    except OSError:
        pass
    else:
        assert str(native_alias) in native(native_project).stdout.splitlines()
        write(native_project / "plum.pkg", 'Package { name: "native", symlinks: "reject" }')
        result = native(native_project, ok=False)
        assert "refused link" in result.stdout + result.stderr
        (native_project / "plum.pkg").unlink()
        native_alias.unlink()
        native_alias.symlink_to("../../outside.c")
        result = native(native_project, ok=False)
        assert "cannot discover sources" in result.stdout + result.stderr
        native_alias.unlink()
        shutil.rmtree(native_project / "native/linux")
        (native_project / "native/linux").symlink_to(".", target_is_directory=True)
        result = native(native_project, ok=False)
        assert "duplicate filesystem identity" in result.stdout + result.stderr
        (native_project / "native/linux").unlink()
        shutil.rmtree(native_project / "native/windows")
        (native_project / "native/windows").symlink_to("../../outside", target_is_directory=True)
        native(native_project, "linux")  # excluded target is not traversed
        native(native_project, "windows", ok=False)
    print("source-discovery: native targets, alias detection and root policy passed")

    manifests = work / "manifest-links"
    write(manifests / "main.plum")
    write(manifests / ".config", 'Package { name: "test" }')
    manifest_link = manifests / "plum.pkg"
    try:
        manifest_link.symlink_to(".config")
    except OSError:
        pass
    else:
        discover(manifests)
        write(manifests / ".config", 'Package { name: "test", symlinks: "reject" }')
        result = discover(manifests, ok=False)
        assert "failed to read" in result.stdout + result.stderr
        manifest_link.unlink()
        write(work / "outside.pkg", 'Package { name: "outside" }')
        for target in ["missing", "../outside.pkg", str(manifests / ".config")]:
            manifest_link.symlink_to(target)
            result = discover(manifests, ok=False)
            assert "failed to read" in result.stdout + result.stderr
            manifest_link.unlink()
    print("source-discovery: manifest links obey root and reject policies")

    # No elapsed-time thresholds: total allocated bytes must scale linearly.
    # Fixed-width names keep path-processing costs comparable at each size.
    def allocated(path, count):
        result = discover(path, "count")
        assert result.stdout.strip() == str(count)
        match = re.search(r"\[plum-rt\] alloc n=\d+ bytes=(\d+)", result.stderr)
        assert match, result.stderr
        return int(match[1])

    for shape in ["flat", "nested", "dependencies"]:
        amounts = []
        for count in [1024, 2048, 4096]:
            tree = work / f"{shape}-{count}"
            if shape == "dependencies":
                tree.mkdir()
                dep_specs = []
                for i in range(16):
                    dep = work / f"deps-{count}-{i:02d}"
                    dep_specs.append(f'Dep {{ name: "d{i:02d}", path: "../{dep.name}" }}')
                    for j in range(count // 16):
                        write(dep / f"d{i:02d}" / f"f{j:04d}.plum")
                write(tree / "plum.pkg", 'Package { name: "app", deps: [' + ", ".join(dep_specs) + '] }\n')
            else:
                for i in range(count):
                    directory = tree if shape == "flat" else tree / f"m{i % 16:02d}" / "nested"
                    write(directory / f"f{i:04d}.plum")
            amounts.append(allocated(tree, count))
        print(f"source-discovery: {shape} allocated bytes for 1024/2048/4096 files: {amounts}")
        for small, large in zip(amounts, amounts[1:]):
            assert large < small * 2.6, f"{shape} discovery allocation growth is not linear: {amounts}"

print("source-discovery: passed")
