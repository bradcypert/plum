#!/usr/bin/env python3
"""Verify declared native dependencies, compatibility fallback, and cache edits.

Portable: run alongside platform smoke on Windows/macOS and in Linux CI.
Assertions combine actual linked program behavior with cache/selection events.
"""
import os
from pathlib import Path
import subprocess
import sys
import tempfile
import time

COMPILER = Path(sys.argv[1] if len(sys.argv) > 1 else './sh.real').resolve()
passed = 0


def require(condition, message):
    global passed
    if not condition:
        raise AssertionError(message)
    passed += 1


with tempfile.TemporaryDirectory(prefix='plum-native-deps-') as tmp:
    work = Path(tmp)
    env = dict(os.environ, PLUM_CACHE=str(work / 'cache'), PLUM_CACHE_TRACE='1')
    timings = os.environ.get('PLUM_CI_TIMINGS') == '1'
    if timings:
        env['PLUM_PROFILE'] = '1'
    for name in ('PLUM_CC', 'PLUM_NO_BUILD_CACHE', 'PLUM_NO_OBJECT_CACHE', 'PLUM_BUILD_CACHE_MAX_BYTES'):
        env.pop(name, None)

    def invoke(*args, selection=None, event=None, output=None, ok=True, overlay=None):
        print('native-deps:', ' '.join(repr(str(a)) for a in args), flush=True)
        started = time.monotonic()
        result = subprocess.run([str(COMPILER), *map(str, args)], env=env | (overlay or {}),
                                capture_output=True, text=True, cwd=work, timeout=180)
        print(f'native-deps completed: {time.monotonic() - started:.3f}s (exit {result.returncode})', flush=True)
        if timings:
            for line in result.stderr.splitlines():
                if line.startswith(('profile:', 'cache: native dependencies:')):
                    print('  ' + line, flush=True)
        require((result.returncode == 0) == ok, result.stdout + result.stderr)
        if selection:
            require(f'cache: native dependencies: {selection}\n' in result.stderr, result.stderr)
        if event:
            require(f'cache: IR {event}\n' in result.stderr, result.stderr)
        if output is not None:
            require(result.stdout == output, repr(result.stdout))
        return result

    def manifest(project, declaration):
        fields = '' if declaration is None else ', native_deps: ' + declaration
        (project / 'plum.pkg').write_text('Package { name: "' + project.name + '"' + fields + ' }\n')

    def program(project, native=True):
        project.mkdir()
        (project / 'main.plum').write_text(
            'extern "C" { fn native_value() -> Int; }\n'
            'let main (): Unit = println(unsafe { native_value() })\n'
            'let test_native (): Unit = assert_eq(unsafe { native_value() }, 7)\n')
        if native:
            (project / 'native').mkdir()
            (project / 'native/value.c').write_text('long long native_value(void) { return 7; }\n')

    def built(project, selection, *flags):
        binary = work / 'program.exe'
        invoke('build', project, '-o', binary, *flags, selection=selection)
        result = subprocess.run([str(binary)], capture_output=True, text=True, check=True, timeout=30)
        require(result.stdout == '7\n', repr(result.stdout))

    plain = work / 'plain'
    program(plain)
    manifest(plain, '[]')
    built(plain, 'none')
    built(plain, 'none', '--release')
    invoke('test', plain, selection='none')
    invoke('run', plain, selection='none', event='miss', output='7\n')
    invoke('run', plain, selection='none', event='hit', output='7\n')
    invoke('run', plain, selection='none', output='7\n', overlay={'PLUM_NO_BUILD_CACHE': '1'})
    invoke('run', plain, selection='none', output='7\n', overlay={'PLUM_NO_OBJECT_CACHE': '1'})

    # A manifest edit changes IR identity; returning to a known declaration
    # may reuse its IR. Native source edits still rebuild the native input.
    manifest(plain, '["tls"]')
    invoke('run', plain, selection='tls', event='miss', output='7\n')
    manifest(plain, '[]')
    (plain / 'native/value.c').write_text('long long native_value(void) { return 8; }\n')
    invoke('run', plain, selection='none', event='hit', output='8\n')

    library = work / 'library'
    library.mkdir()
    (library / 'main.plum').write_text('let main (): Unit = println(7)\n')
    (library / 'plum.pkg').write_text('Package { name: "library", native_deps: [], link: ["m"] }\n')
    built(library, 'none')

    # An inactive platform source is not an unknown native input.
    platform_only = work / 'platform_only'
    platform_only.mkdir()
    (platform_only / 'main.plum').write_text('let main (): Unit = println(7)\n')
    windows = os.name == 'nt' or sys.platform.startswith(('msys', 'cygwin'))
    inactive = platform_only / 'native' / ('linux' if windows else 'windows')
    inactive.mkdir(parents=True)
    (inactive / 'unused.c').write_text('#error inactive platform source was selected\n')
    built(platform_only, 'none')

    external = work / 'external'
    program(external, native=False)
    helper = work / 'helper.c'
    helper.write_text('long long native_value(void) { return 7; }\n')
    built(external, 'none', '--link-c', helper, '--link-lib', 'm', '--native-deps', 'none')
    # Omission retains the old full bundle for opaque command-line inputs.
    built(external, 'tls', '--link-c', helper)
    for flags in [('--native-deps',), ('--native-deps', 'unknown'),
                  ('--native-deps', 'none', '--native-deps', 'tls')]:
        result = invoke('build', external, *flags, ok=False)
        require('--native-deps requires one value' in result.stderr + result.stdout, result.stderr)

    # Headers + native-only TLS calls must work with no Plum TLS declaration.
    tls = work / 'tls'
    program(tls)
    manifest(tls, '["tls"]')
    (tls / 'native/value.c').write_text('#include <mbedtls/version.h>\n'
        'long long native_value(void) { return mbedtls_version_get_number() ? 7 : -1; }\n')
    built(tls, 'tls')
    # Undeclared legacy native TLS has the same behavior.
    manifest(tls, None)
    invoke('test', tls, selection='tls')

    # Root/CLI opt-outs cannot suppress a transitive dependency's requirement.
    app = work / 'app'
    app.mkdir()
    (app / 'main.plum').write_text('use tls;\nlet main (): Unit = println(tls.value())\n')
    middle = work / 'middle'
    middle.mkdir()
    (middle / 'middle').mkdir()
    (middle / 'middle/value.plum').write_text('pub let value (): Int = 1\n')
    (middle / 'plum.pkg').write_text('Package { name: "middle", native_deps: [], '
        'deps: [Dep { name: "tls", path: "../tls" }] }\n')
    (tls / 'main.plum').unlink()
    (tls / 'tls').mkdir()
    (tls / 'tls/value.plum').write_text('extern "C" { fn native_value() -> Int; }\n'
        'pub let value (): Int = unsafe { native_value() }\n')
    (app / 'plum.pkg').write_text('Package { name: "app", native_deps: [], '
        'deps: [Dep { name: "middle", path: "../middle" }] }\n')
    manifest(tls, '["tls"]')
    invoke('run', app, '--native-deps', 'none', selection='tls', event='miss', output='7\n')
    # An actual dependency metadata/source edit must reach the linker on a hit.
    manifest(tls, '[]')
    (tls / 'native/value.c').write_text('long long native_value(void) { return 7; }\n')
    invoke('run', app, selection='none', event='miss', output='7\n')
    invoke('run', app, selection='none', event='hit', output='7\n')

    direct = work / 'direct'
    direct.mkdir()
    manifest(direct, '[]')
    (direct / 'main.plum').write_text('extern "C" { fn tls_close(handle: Int); }\n'
        'let main (): Unit = { unsafe { tls_close(0) }; println(7) }\n')
    built(direct, 'tls', '--native-deps', 'none')

    for declaration in ('false', '[1]', '["openssl"]', '["tls", "tls"]'):
        manifest(plain, declaration)
        invoke('check-manifest', plain / 'plum.pkg', ok=False)

print(f'native-deps-check: {passed} checks pass', flush=True)
