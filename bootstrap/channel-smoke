#!/usr/bin/env bash
# Repeats the shared-channel-end regression fixture. A single execution can
# miss the lifetime race; repeated native runs make issue #69 observable.
set -uo pipefail

root="$(cd "$(dirname "${BASH_SOURCE[0]}")/.." && pwd)"
cd "$root" || exit 1

plum="${1:-./sh.real}"
work="$(mktemp -d -t plum-channel-XXXXXX)"
trap 'rm -rf "$work"' EXIT

for fixture in bootstrap/exec_corpus/channel_shared_ends bootstrap/exec_corpus/channel_nested_ends; do
    if ! "$plum" build "$fixture" -o "$work/channel" >"$work/build.log" 2>&1; then
        echo "channel-smoke: $fixture build failed"
        sed -n '1,12p' "$work/build.log"
        exit 1
    fi

    for run in $(seq 1 20); do
        if ! timeout 30 "$work/channel" >"$work/out" 2>"$work/err"; then
            echo "channel-smoke: $fixture run $run failed"
            sed -n '1,20p' "$work/err"
            exit 1
        fi
        if ! cmp -s "$fixture/expected.txt" "$work/out"; then
            echo "channel-smoke: $fixture run $run output differed"
            diff -u "$fixture/expected.txt" "$work/out" || true
            exit 1
        fi
    done
    echo "channel-smoke: $fixture: 20 runs passed"
done
