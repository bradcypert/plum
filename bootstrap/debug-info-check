#!/usr/bin/env bash
# A DEBUG build carries Plum line information, and a release build does
# not.
#
# This is the harness that has to exist for `!dbg` to be worth emitting.
# Wrong debug info does not crash: it points a debugger or a profiler at
# the wrong line and is believed. Every other invariant here is pinned
# by something that fails loudly, and a feature whose failure mode is
# "quietly misleads you" needs it more than most, not less.
#
# What is asserted is the LINE NUMBERS, against a fixture whose contents
# this script writes and therefore knows the answer for. Asserting that
# metadata merely EXISTS would pass just as happily with every function
# pointing at line 1, which is the most likely way for this to break.
#
# Two layers, because they fail differently:
#
#   1. The emitted IR -- portable, runs everywhere, and catches a
#      regression in what this compiler produces.
#   2. The linked binary through `addr2line` -- the real question, since
#      it is DWARF a debugger reads rather than metadata we wrote. Only
#      when binutils is present: `bootstrap/check-build-modes` already
#      avoids `readelf` because "binutils is not guaranteed on every
#      platform the compiler targets", and the same applies here.
set -uo pipefail

root="$(cd "$(dirname "${BASH_SOURCE[0]}")/.." && pwd)"
cd "$root"

plum="${1:-./sh}"
work="$(mktemp -d)"
trap 'rm -rf "$work"' EXIT

fail=0

# Line 1 is a comment, so `top` is on 2 and `nested` on 3. Written out
# rather than derived, so the expectation is independent of the file.
mkdir -p "$work/p"
cat > "$work/p/main.plum" <<'PLUM'
// deliberately here, so the functions below start at known lines
let top (n: Int): Int = n + 1
let nested (n: Int): Int = top(n) + 1
let main (): Unit = println(nested(1).to_string())
PLUM

if ! SH_MEM="${SH_MEM:-512M}" SH_TIMEOUT="${SH_TIMEOUT:-120}" "$plum" emit-llvm "$work/p" > "$work/dbg.ll" 2> "$work/dbg.err"; then
    echo "FAIL: debug emit failed: $(head -n 1 "$work/dbg.err")" >&2
    exit 1
fi

# `top` is declared on line 2 and `nested` on line 3. A subprogram
# claiming anything else is the bug this harness exists for.
for pair in "top 2" "nested 3" "main 4"; do
    set -- $pair
    name="$1"; want="$2"
    got="$(grep -oE "DISubprogram\(name: \"$name\", scope: ![0-9]+, file: ![0-9]+, line: [0-9]+" "$work/dbg.ll" | grep -oE 'line: [0-9]+$' | grep -oE '[0-9]+' | head -n 1)"
    if [ -z "$got" ]; then
        echo "FAIL: no DISubprogram for '$name' in a debug build" >&2
        fail=1
    elif [ "$got" != "$want" ]; then
        echo "FAIL: '$name' is on line $want, its debug info says $got" >&2
        fail=1
    fi
done

# STATEMENT granularity, not just function. A block's statements each
# get their own location, which is what makes `break main.plum:9` land
# where a person means rather than at the top of the enclosing function.
# Asserting only the subprograms above would pass with every instruction
# in a function sharing one line, which is what the first version did.
mkdir -p "$work/s"
cat > "$work/s/main.plum" <<'PLUM'
let work (n: Int): Int = {
    let a = n + 1;
    let b = a * 2;
    let c = b - 3;
    c
}
let main (): Unit = println(work(5).to_string())
PLUM

if ! SH_MEM="${SH_MEM:-512M}" SH_TIMEOUT="${SH_TIMEOUT:-120}" "$plum" emit-llvm "$work/s" > "$work/stmt.ll" 2> "$work/stmt.err"; then
    echo "FAIL: statement-granularity emit failed: $(head -n 1 "$work/stmt.err")" >&2
    fail=1
else
    for want in 2 3 4 5; do
        if ! grep -qE "DILocation\(line: $want," "$work/stmt.ll"; then
            echo "FAIL: no location for the statement on line $want -- granularity is coarser than a statement" >&2
            fail=1
        fi
    done
fi

# Every instruction in a function that HAS debug info needs a location:
# LLVM's verifier rejects an inlinable call without one, so this would
# already have failed the build -- but it fails as a clang error about
# metadata, which reads like a bug in the shims. Asserting it here names
# the actual cause.
if ! grep -q '!dbg !' "$work/dbg.ll"; then
    echo "FAIL: a debug build attached no locations to any instruction" >&2
    fail=1
fi

# A release build is compiled without `-g` and has nothing to read this,
# so emitting it would be dead weight in every shipped binary.
if ! SH_MEM="${SH_MEM:-512M}" SH_TIMEOUT="${SH_TIMEOUT:-120}" "$plum" emit-llvm "$work/p" --release > "$work/rel.ll" 2> "$work/rel.err"; then
    echo "FAIL: release emit failed: $(head -n 1 "$work/rel.err")" >&2
    fail=1
elif grep -qE "DISubprogram|DICompileUnit|!dbg !" "$work/rel.ll"; then
    echo "FAIL: a --release build carries debug information; it should not" >&2
    fail=1
fi

# --- the linked binary, where it actually matters ---
#
# The IR above is what this compiler WROTE. This is what a debugger
# actually reads, and the two can differ -- most importantly on macOS,
# where the linker leaves DWARF in the `.o` files and only a debug map
# in the executable. `plum build` pipes IR through one clang invocation
# into a temp directory and keeps no `.o`, so if nothing resolves that
# map the line information is gone by the time anyone looks for it.
# Whether clang's driver already runs `dsymutil` for a compile-and-link
# in one step is exactly the question this is here to answer, on a real
# Mac, rather than be assumed either way.
if ! SH_MEM="${SH_MEM:-512M}" SH_TIMEOUT="${SH_TIMEOUT:-120}" "$plum" build "$work/p" -o "$work/p.bin" > "$work/build.err" 2>&1; then
    echo "FAIL: debug build failed: $(head -n 1 "$work/build.err")" >&2
    fail=1
else
    # Whichever dumper this platform has. macOS ships `dwarfdump` and no
    # `addr2line`; Linux is usually the other way round.
    dwarf_lines() {
        if command -v llvm-dwarfdump > /dev/null 2>&1; then llvm-dwarfdump --debug-line "$1" 2>/dev/null
        elif command -v dwarfdump > /dev/null 2>&1; then dwarfdump --debug-line "$1" 2>/dev/null
        elif command -v objdump > /dev/null 2>&1; then objdump --dwarf=decodedline "$1" 2>/dev/null
        fi
    }

    lines="$(dwarf_lines "$work/p.bin")"
    where="the executable"
    # A `.dSYM` beside it counts: that is where a Mach-O toolchain puts
    # line information, and lldb finds it there.
    # `case`, not `printf | grep -q`: grep exits on its first match and
    # closes the pipe, printf dies of SIGPIPE, and `set -o pipefail`
    # then reports the whole pipeline as failed -- so the check said
    # "no line information" about output that plainly contained it.
    case "$lines" in *main.plum*) ;; *)
        if [ -d "$work/p.bin.dSYM" ]; then
            lines="$(dwarf_lines "$work/p.bin.dSYM/Contents/Resources/DWARF/p.bin")"
            where="its .dSYM bundle"
        fi ;;
    esac

    if [ -z "$(command -v llvm-dwarfdump)$(command -v dwarfdump)$(command -v objdump)" ]; then
        echo "  (skipped the binary: no DWARF dumper on this platform)"
    else
        case "$lines" in
            *main.plum*) printf '  line information reaches %s\n' "$where" ;;
            *)
        echo "FAIL: the built binary has no Plum line information, in itself or a .dSYM." >&2
        echo "      On Mach-O this means the debug map was never resolved -- 'plum build'" >&2
        echo "      keeps no .o files, so it needs to run dsymutil." >&2
        # Say WHAT is missing rather than leaving the next person to
        # guess across CI rounds, which is how this one was diagnosed
        # twice wrongly. Each line distinguishes a different cause:
        # no tool, tool ran but produced nothing, or a debug map that
        # points at object files the compiler had already deleted.
        echo "      --- diagnosis ---" >&2
        # What `plum build` itself said. `run_dsymutil` warns there when
        # dsymutil fails or complains, which is the one voice that can
        # report the IN-BUILD run rather than a by-hand one after the
        # scratch objects are gone.
        echo "      plum build said: $(head -c 400 "$work/build.err" 2>/dev/null | tr '\n' ' ')" >&2
        echo "      dsymutil: $(command -v dsymutil 2>/dev/null || echo 'NOT ON PATH')" >&2
        echo "      .dSYM beside the binary: $(ls -d "$work"/*.dSYM 2>/dev/null || echo 'none')" >&2
        # Distinguishes an EMPTY bundle -- our in-build dsymutil failed --
        # from one with content that simply does not mention our source.
        if [ -d "$work/p.bin.dSYM" ]; then
            echo "      bundle contents: $(find "$work/p.bin.dSYM" -type f -exec ls -l {} \; 2>/dev/null | awk '{print $NF" ("$5" bytes)"}' | tr '\n' ' ')" >&2
            echo "      bundle line table, first lines: $(dwarf_lines "$work/p.bin.dSYM/Contents/Resources/DWARF/p.bin" | head -n 4 | tr '\n' ' | ')" >&2
        fi
        if command -v nm > /dev/null 2>&1; then
            echo "      debug map (OSO) entries: $(nm -pa "$work/p.bin" 2>/dev/null | grep -c OSO)" >&2
        fi
        if command -v dsymutil > /dev/null 2>&1; then
            echo "      dsymutil says: $(dsymutil "$work/p.bin" 2>&1 | head -n 2 | tr '\n' ' ')" >&2
            echo "      .dSYM after running it by hand: $(ls -d "$work"/*.dSYM 2>/dev/null || echo 'still none')" >&2
        fi
        fail=1 ;;
        esac
    fi
fi

# The precise question -- does one address resolve to the right line --
# where a tool that answers it exists.
if command -v addr2line > /dev/null 2>&1 && [ -f "$work/p.bin" ]; then
    addr="$(nm "$work/p.bin" 2>/dev/null | grep -E ' T plum_top$' | head -n 1 | awk '{print $1}')"
    if [ -z "$addr" ]; then
        echo "  (skipped addr2line: no plum_top symbol -- stripped?)"
    else
        line="$(addr2line -e "$work/p.bin" "0x$addr" 2>/dev/null)"
        case "$line" in
            *main.plum:2) ;;
            *) echo "FAIL: addr2line puts plum_top at '$line', expected main.plum:2" >&2; fail=1 ;;
        esac
    fi
fi

[ $fail -ne 0 ] && exit 1
printf 'debug-info-check: debug builds carry Plum line information, release builds carry none\n'
