/// One header. `name` is as it appeared on the wire; header names are
/// case-insensitive in HTTP, so compare with care.
pub struct Header { pub name: String, pub value: String }
/// A complete response: status, headers, and the whole body as raw bytes.
/// Use Response.text to decode UTF-8 explicitly.
pub struct Response { pub status: Int, pub headers: Array[Header], pub body: Bytes }
/// A response's head, before the body has been read.
///
/// `leftover_body` is whatever arrived in the same read as the headers
/// — a body does not begin on a tidy packet boundary, so those bytes
/// have to be handed on rather than dropped.
pub struct Head { pub status: Int, pub headers: Array[Header], pub leftover_body: Bytes }
/// An incoming request, with its body preserved as raw bytes.
/// Use Request.text to decode UTF-8 explicitly.
pub struct Request { pub method: String, pub path: String, pub headers: Array[Header], pub body: Bytes }
/// A request's first line, split.
pub struct RequestLine { pub method: String, pub path: String }
/// A request's head, before its body has been read. `leftover_body`
/// carries the bytes that arrived alongside the headers.
pub struct RequestHead { pub method: String, pub path: String, pub headers: Array[Header], pub leftover_body: Bytes }

extern "C" {
    fn tls_connect(host: CStr, port: Int) -> Int;
    fn tls_send(handle: Int, buf: CStr, len: Int) -> Int;
    fn tls_recv_n(handle: Int, max_len: Int) -> Int;
    fn tls_recv_data() -> CStr;
    fn tls_close(handle: Int) -> Unit;
}

// Keep transport policy in one place: explicit byte counts, clean EOF,
// and errors have identical meanings for plain TCP and TLS.
let http_read (fd: Int) (secure: Int) (max_len: Int): Result[Bytes, String] =
    if secure == 0 { Net.read_bytes(fd, max_len) }
    else { unsafe {
        let n = tls_recv_n(fd, max_len);
        if n < 0 { Err("https client: read failed") }
        else { Ok(Bytes.from_cstr(tls_recv_data(), n)) }
    } }

let http_write (fd: Int) (secure: Int) (data: Bytes): Result[Int, String] =
    if secure == 0 { Net.write_bytes(fd, data) }
    else { unsafe {
        let len = data.len();
        let n = tls_send(fd, data.as_cstr(), len);
        if n < 0 { Err("https client: write failed") } else { Ok(n) }
    } }

// Bytes.slice copies. Slice only a bounded chunk, never the whole unsent
// suffix, so repeated short writes do not copy the body quadratically.
let http_write_all (fd: Int) (secure: Int) (data: Bytes) (offset: Int): Result[Unit, String] =
    if offset >= data.len() { Ok(()) }
    else {
        let end = offset + Int.min(16384, data.len() - offset);
        match http_write(fd, secure, data.slice(offset, end)) {
            Err(e) => Err(e),
            Ok(n) => if n <= 0 || n > end - offset { Err("http: write made invalid progress") }
                else { http_write_all(fd, secure, data, offset + n) },
        }
    }

// Serialize only the head. Keep the body as its existing RC buffer rather
// than allocating another whole-body copy just to prepend HTTP metadata.
struct HttpWire { head: Bytes, body: Bytes }
let http_send (fd: Int) (secure: Int) (wire: HttpWire): Result[Unit, String] =
    http_write_all(fd, secure, wire.head, 0)
        |> Result.and_then(_, |ignored| http_write_all(fd, secure, wire.body, 0))

/// Decodes the request body as UTF-8. Invalid UTF-8 returns Err; the raw
/// body remains available as Bytes. No Content-Type or charset conversion
/// is inferred, and valid text shares the body's reference-counted storage.
pub let Request.text (req: Request): Result[String, String] = req.body.as_string()

/// Decodes the response body as UTF-8, returning Err for invalid text.
/// This validates without copying the payload; it does not decompress or
/// interpret Content-Type. Use body directly for arbitrary binary data.
pub let Response.text (resp: Response): Result[String, String] = resp.body.as_string()

/// URL parsing lives in `Url` now; this only decides which URLs an
/// HTTP CLIENT is willing to act on, which is a different question
/// and the only part that ever belonged here.
///
/// The two rejection messages are unchanged, deliberately: they are
/// what a user sees and what `bootstrap/net-smoke` asserts. What did
/// change is that a URL this client cannot USE is now told apart from
/// a URL that is not well-formed. `nope://h/x` parses fine and is
/// refused for its scheme, while `h/x` is refused for having none,
/// and those used to be the same message.
///
let http_parse_url (url: String): Result[Url.Url, String] =
    match Url.parse(url) {
        Err(e) => Err("http client: ".concat(e)),
        Ok(u) =>
            if u.scheme == "https" || u.scheme == "http" { Ok(u) }
            else { Err("http client: url must start with http:// or https://") },
    }

// RFC 9110 token syntax, shared by methods and field names. Scan bytes:
// tokens are ASCII even when the surrounding String contains UTF-8.
let http_token_byte (c: Int): Bool =
    (c >= 65 && c <= 90) || (c >= 97 && c <= 122) || (c >= 48 && c <= 57)
        || c == 33 || c == 35 || c == 36 || c == 37 || c == 38 || c == 39
        || c == 42 || c == 43 || c == 45 || c == 46 || c == 94 || c == 95
        || c == 96 || c == 124 || c == 126

let http_token_ok_acc (b: Bytes) (i: Int): Bool =
    if i >= b.len() { true }
    else { match b.at(i) {
        Some(c) => if http_token_byte(c) { http_token_ok_acc(b, i + 1) } else { false },
        None => false,
    } }

let http_token_ok (text: String): Bool =
    !String.is_empty(text) && http_token_ok_acc(text.as_bytes(), 0)

// Field values allow SP and HTAB; targets and authorities allow neither.
// Bytes above ASCII are preserved, including existing UTF-8 field values.
let http_text_ok_acc (b: Bytes) (i: Int) (field_value: Bool): Bool =
    if i >= b.len() { true }
    else { match b.at(i) {
        Some(c) => {
            let ok = if field_value { c == 9 || (c >= 32 && c != 127) } else { c > 32 && c != 127 };
            if ok { http_text_ok_acc(b, i + 1, field_value) } else { false }
        },
        None => false,
    } }

let http_validate_headers (headers: Array[Header]) (i: Int): Result[Unit, String] =
    if i >= headers.len() { Ok(()) }
    else if !http_token_ok(headers[i].name) { Err("http: invalid header name") }
    else if !http_text_ok_acc(headers[i].value.as_bytes(), 0, true) { Err("http: invalid header value") }
    else { http_validate_headers(headers, i + 1) }

// Public structs are unchecked data. Validate the actual interpolated fields
// here, even when a Url was constructed without going through Url.parse.
let http_build_request (method: String) (parsed: Url.Url) (headers: Array[Header]) (body: Bytes): Result[HttpWire, String] = {
    let target = Url.request_target(parsed);
    let authority = Url.authority(parsed);
    if !http_token_ok(method) { Err("http client: invalid method") }
    else if String.is_empty(target) || !http_text_ok_acc(target.as_bytes(), 0, false) { Err("http client: invalid request target") }
    else if String.is_empty(authority) || !http_text_ok_acc(authority.as_bytes(), 0, false) { Err("http client: invalid authority") }
    else { Result.map(http_validate_headers(headers, 0)
        |> Result.and_then(_, |ignored| http_request_headers(headers, 0)), |ignored| {
            let extra_header_lines = Array.fold(headers, "", |acc, h| acc.concat(h.name).concat(": ").concat(h.value).concat("\r\n"));
            let content_length_line = if body.is_empty() { "" } else { "Content-Length: ".concat(body.len().to_string()).concat("\r\n") };
            let head = method.concat(" ").concat(target).concat(" HTTP/1.1\r\n")
            .concat("Host: ").concat(authority).concat("\r\n")
            .concat("Connection: close\r\n")
            .concat(content_length_line)
            .concat(extra_header_lines)
            .concat("\r\n");
            HttpWire { head: head.as_bytes(), body: body }
        }) }
}

// Search byte offsets, retaining the last three bytes as overlap after a
// read. Only the head is decoded later: a body coalesced with the head may
// begin with NUL, invalid UTF-8, or half of a multibyte character.
let http_head_separator (raw: Bytes) (i: Int): Option[Int] =
    if i + 3 >= raw.len() { None }
    else if http_byte(raw, i) == 13 && http_byte(raw, i + 1) == 10
        && http_byte(raw, i + 2) == 13 && http_byte(raw, i + 3) == 10 { Some(i) }
    else { http_head_separator(raw, i + 1) }

let http_recv_headers_from (fd: Int) (secure: Int) (acc: Bytes) (start: Int): Result[Bytes, String] =
    match http_head_separator(acc, start) {
        Some(_) => Ok(acc),
        None => match http_read(fd, secure, 4096) {
            Err(e) => Err(e),
            Ok(chunk) => if chunk.is_empty() { Err("http client: connection closed before the response headers were complete") }
                else { http_recv_headers_from(fd, secure, acc.concat(chunk), Int.max(0, acc.len() - 3)) },
        },
    }

let http_recv_headers_acc (fd: Int) (secure: Int) (acc: Bytes): Result[Bytes, String] =
    http_recv_headers_from(fd, secure, acc, 0)

let http_status_valid (status: Int): Bool = status >= 100 && status <= 599
let http_informational (status: Int): Bool = status >= 100 && status < 200

// RFC 9112 section 6.3: these responses end at the header terminator,
// before Content-Length or Transfer-Encoding can select body framing.
let http_response_bodyless (method: String) (status: Int): Bool =
    method == "HEAD" || http_informational(status) || status == 204 || status == 304

let http_tunnel (method: String) (status: Int): Bool =
    method == "CONNECT" && status >= 200 && status < 300

let http_parse_status_line (line: String): Result[Int, String] = {
    let parts = line.split(" ");
    if parts.len() < 2 { Err("http client: malformed status line: ".concat(line)) }
    else if parts[0] != "HTTP/1.0" && parts[0] != "HTTP/1.1" {
        Err("http client: unsupported HTTP version")
    } else {
        let code = parts[1].as_bytes();
        if code.len() != 3 || !http_digit(http_byte(code, 0)) || !http_digit(http_byte(code, 1)) || !http_digit(http_byte(code, 2)) {
            Err("http client: malformed status code")
        } else { match String.parse_int(parts[1]) {
            Err(e) => Err("http client: malformed status code: ".concat(e)),
            Ok(status) => if http_status_valid(status) { Ok(status) } else { Err("http client: invalid response status") },
        } }
    }
}

let http_byte (b: Bytes) (i: Int): Int = match b.at(i) { Some(c) => c, None => -1 }
let http_ows (c: Int): Bool = c == 32 || c == 9
let http_ows_start (b: Bytes) (i: Int): Int =
    if http_ows(http_byte(b, i)) { http_ows_start(b, i + 1) } else { i }
let http_ows_end (b: Bytes) (i: Int): Int =
    if http_ows(http_byte(b, i - 1)) { http_ows_end(b, i - 1) } else { i }

// Only SP/HTAB are optional whitespace. Generic Unicode trimming would
// erase malformed controls. String.slice uses codepoints, Bytes uses octets.
let http_trim_ows (s: String): String = {
    let b = s.as_bytes();
    let start = http_ows_start(b, 0);
    let end = http_ows_end(b, b.len());
    String.slice(s, start, String.char_len(s) - (b.len() - end))
}

let http_parse_header_line (line: String): Result[Header, String] =
    match String.index_of(line, ":") {
        None => Err("http: malformed header line"),
        Some(i) => {
            let name = String.slice(line, 0, i);
            let value = http_trim_ows(String.slice(line, i + 1, String.char_len(line)));
            if !http_token_ok(name) { Err("http: invalid header name") }
            else if !http_text_ok_acc(value.as_bytes(), 0, true) { Err("http: invalid header value") }
            else { Ok(Header { name: name, value: value }) }
        },
    }

// Tail recursion keeps the stack bounded and moves the accumulator into
// push. Never silently discard a malformed field (including obs-fold).
let http_parse_headers_acc (lines: Array[String]) (i: Int) (acc: Array[Header]): Result[Array[Header], String] =
    if i >= lines.len() { Ok(acc) }
    else { match http_parse_header_line(lines[i]) {
        Err(e) => Err(e),
        Ok(h) => http_parse_headers_acc(lines, i + 1, acc.push(h)),
    } }

let http_parse_headers (lines: Array[String]): Result[Array[Header], String] =
    http_parse_headers_acc(lines, 0, [])

// Parsed names are ASCII tokens; folding never changes their spelling in
// the public Header. The same comparison serves Host and body framing.
let http_ascii_lower (c: Int): Int = if c >= 65 && c <= 90 { c + 32 } else { c }
let http_ascii_equal (a: Bytes) (b: Bytes) (i: Int): Bool =
    if i >= a.len() { true }
    else if http_ascii_lower(http_byte(a, i)) != http_ascii_lower(http_byte(b, i)) { false }
    else { http_ascii_equal(a, b, i + 1) }

let http_header_named (header: Header) (name: String): Bool =
    header.name.len() == name.len() && http_ascii_equal(header.name.as_bytes(), name.as_bytes(), 0)

let http_find_header (headers: Array[Header]) (name: String): Option[String] =
    Option.map(Array.find(headers, |h| http_header_named(h, name)), |h| h.value)

// Parse decimal lists directly from bytes: no split array or magnitude-sized
// recursion/allocation. The -1 sentinel means no length has been seen yet.
// SP/HTAB may surround list members, never interrupt a decimal number.
let http_lengths (b: Bytes) (i: Int) (n: Int) (phase: Int) (known: Int): Result[Int, String] = {
    let c = http_byte(b, i);
    if i == b.len() || c == 44 {
        if phase == 0 { Err("http: invalid Content-Length header") }
        else if known >= 0 && known != n { Err("http: conflicting Content-Length headers") }
        else if i == b.len() { Ok(n) }
        else { http_lengths(b, i + 1, 0, 0, n) }
    } else if http_digit(c) && phase != 2 {
        let digit = c - 48;
        if n > (9223372036854775807 - digit) / 10 { Err("http: Content-Length out of range") }
        else { http_lengths(b, i + 1, n * 10 + digit, 1, known) }
    } else if http_ows(c) {
        http_lengths(b, i + 1, n, if phase == 1 { 2 } else { phase }, known)
    } else { Err("http: invalid Content-Length header") }
}

let http_content_lengths (headers: Array[Header]) (i: Int) (known: Int): Result[Int, String] =
    if i >= headers.len() { Ok(known) }
    else if http_header_named(headers[i], "Content-Length") {
        match http_lengths(headers[i].value.as_bytes(), 0, 0, 0, known) {
            Err(e) => Err(e),
            Ok(n) => http_content_lengths(headers, i + 1, n),
        }
    } else { http_content_lengths(headers, i + 1, known) }

// Resolve metadata before reading or acknowledging any body. Chunked
// decoding is unsupported; never fall back to Content-Length for a coding.
// -1 is unframed: empty for requests, close-delimited for responses.
let http_framing (headers: Array[Header]): Result[Int, String] =
    match http_find_header(headers, "Transfer-Encoding") {
        Some(te) => if Option.is_some(http_find_header(headers, "Content-Length")) {
            Err("http: Content-Length and Transfer-Encoding cannot be combined")
        } else { Err("http: Transfer-Encoding (".concat(te).concat(") is not supported yet")) },
        None => http_content_lengths(headers, 0, -1),
    }

// Whole-message APIs own Host/framing. Reject caller overrides before
// connecting rather than emitting a second, potentially conflicting field.
let http_request_headers (headers: Array[Header]) (i: Int): Result[Unit, String] =
    if i >= headers.len() { Ok(()) }
    else if http_header_named(headers[i], "Host") || http_header_named(headers[i], "Content-Length")
        || http_header_named(headers[i], "Transfer-Encoding") {
            Err("http client: Host, Content-Length and Transfer-Encoding are managed headers")
        } else { http_request_headers(headers, i + 1) }

// Decode exactly the head, never the body. Byte offsets stay byte offsets
// even when a header contains multibyte UTF-8.
let http_parse_head (raw: Bytes): Result[Head, String] =
    match http_head_separator(raw, 0) {
        None => Err("http client: incomplete response head"),
        Some(i) => raw.slice(0, i).as_string() |> Result.and_then(_, |text| {
            let lines = text.split("\r\n");
            http_parse_status_line(lines[0]) |> Result.and_then(_, |status|
                Result.map(http_parse_headers(Array.drop(lines, 1)), |headers| Head {
                    status: status, headers: headers, leftover_body: raw.slice(i + 4, raw.len()),
                }))
        }),
    }

let http_recv_body_by_length_acc (fd: Int) (secure: Int) (acc: Bytes) (remaining: Int): Result[Bytes, String] =
    if remaining <= 0 { Ok(acc) }
    else { match http_read(fd, secure, Int.min(remaining, 16384)) {
        Err(e) => Err(e),
        Ok(chunk) => if chunk.is_empty() { Err("http client: connection closed before the full response body was received") }
            else { http_recv_body_by_length_acc(fd, secure, acc.concat(chunk), remaining - chunk.len()) },
    } }

let http_recv_body_until_close_acc (fd: Int) (secure: Int) (acc: Bytes): Result[Bytes, String] =
    match http_read(fd, secure, 4096) {
        Err(e) => Err(e),
        Ok(chunk) => if chunk.is_empty() { Ok(acc) }
            else { http_recv_body_until_close_acc(fd, secure, acc.concat(chunk)) },
    }

// Ignore bytes beyond the selected message boundary. This server closes
// after one request; surplus bytes must never become handler body content.
let http_read_fixed_body (fd: Int) (secure: Int) (length: Int) (pending: Bytes): Result[Bytes, String] =
    if length == 0 { Ok(Bytes.empty()) }
    else if pending.len() == length { Ok(pending) }
    else if pending.len() > length { Ok(pending.slice(0, length)) }
    else { http_recv_body_by_length_acc(fd, secure, pending, length - pending.len()) }

// Method/status precedence comes before framing metadata (RFC 9112 6.3).
let http_read_body (fd: Int) (secure: Int) (method: String) (status: Int) (headers: Array[Header]) (leftover_body: Bytes): Result[Bytes, String] =
    if http_response_bodyless(method, status) { Ok(Bytes.empty()) }
    else if http_tunnel(method, status) { Err("http client: CONNECT tunnels are not supported") }
    else { http_framing(headers) |> Result.and_then(_, |length|
        if length < 0 { http_recv_body_until_close_acc(fd, secure, leftover_body) }
        else { http_read_fixed_body(fd, secure, length, leftover_body) }) }

// Requests without framing have zero content, even if another request or
// unsolicited bytes arrived in the same network read.
let http_read_request_body (fd: Int) (headers: Array[Header]) (leftover_body: Bytes): Result[Bytes, String] =
    http_framing(headers) |> Result.and_then(_, |length|
        http_read_fixed_body(fd, 0, Int.max(0, length), leftover_body))

// Carry only unread bytes to the next head. A direct tail call releases
// the previous head instead of retaining one continuation per interim
// response. The count also bounds a peer's endless informational stream.
let http_recv_final_head (fd: Int) (secure: Int) (pending: Bytes) (interim_count: Int): Result[Head, String] =
    match http_recv_headers_acc(fd, secure, pending) {
        Err(e) => Err(e),
        Ok(raw) => match http_parse_head(raw) {
            Err(e) => Err(e),
            Ok(head) => if head.status == 101 { Err("http client: protocol upgrades are not supported") }
                else if http_informational(head.status) {
                    if interim_count >= 100 { Err("http client: too many informational responses") }
                    else { http_recv_final_head(fd, secure, head.leftover_body, interim_count + 1) }
                } else { Ok(head) },
        },
    }

let http_do_request (fd: Int) (secure: Int) (method: String) (wire: HttpWire): Result[Response, String] =
    http_send(fd, secure, wire)
        |> Result.and_then(_, |ignored| http_recv_final_head(fd, secure, Bytes.empty(), 0))
        |> Result.and_then(_, |head| Result.map(http_read_body(fd, secure, method, head.status, head.headers, head.leftover_body), |response_body| Response { status: head.status, headers: head.headers, body: response_body }))

/// Sends a request with a raw byte body over HTTP or HTTPS.
/// Encode text with String.as_bytes(); decode the reply with Response.text.
/// Reads use bounded chunks, but the complete body is buffered in memory.
/// There is currently no total header/body size limit or streaming API.
///
/// Sends a request over HTTP or HTTPS. HTTPS verifies the peer's
/// certificate and hostname using the native TLS trust-store integration.
///
/// Invalid URL text, methods, header names, and header values return Err
/// before connecting. Caller Host, Content-Length and Transfer-Encoding
/// fields are rejected: the builder owns authority and framing. Methods
/// and names must be nonempty ASCII tokens;
/// values may contain spaces, HTAB, and UTF-8, but no other ASCII controls
/// or DEL. Bodies are not subject to protocol-field validation.
///
/// Reads past up to 100 informational responses to the final response.
/// HEAD, 204, and 304 responses have an empty body regardless of framing
/// headers. Protocol upgrades (101) and successful CONNECT tunnels return
/// Err and close the connection; this API cannot hand off a transport.
pub let request (method: String) (url: String) (headers: Array[Header]) (body: Bytes): Result[Response, String] =
    http_parse_url(url)
        |> Result.and_then(_, |parsed| http_build_request(method, parsed, headers, body)
            |> Result.and_then(_, |wire| if parsed.scheme == "https" {
                let fd = unsafe { tls_connect(parsed.host.as_cstr(), parsed.port) };
                if fd < 0 { Err("https client: TLS connection failed") }
                else { let result = http_do_request(fd, 1, method, wire); unsafe { tls_close(fd) }; result }
            } else {
                Net.connect_to(parsed.host, parsed.port) |> Result.and_then(_, |fd| {
                    let result = http_do_request(fd, 0, method, wire);
                    Net.close(fd);
                    result
                })
            }))

/// Fetches a URL and reads the whole response.
///
/// Supports both `http://` and `https://`; HTTPS uses the native TLS
/// transport with platform trust-store and hostname verification.
///
/// Redirects are NOT followed: a 301 or 302 comes back as itself, with
/// its `Location` header, so the caller decides. Following one changes
/// which host you are talking to, which is not a decision a library
/// should make quietly.
pub let get (url: String): Result[Response, String] = request("GET", url, [], Bytes.empty())

/// POSTs raw bytes and reads the whole response. For text, pass
/// text.as_bytes() and use Response.text on the result. Sets `Content-Length`;
/// set `Content-Type` yourself if the server needs one.
///
/// Redirects are not followed — see `Http.get`.
pub let post (url: String) (body: Bytes): Result[Response, String] = request("POST", url, [], body)

// --- HTTP server ---

let http_parse_request_line (line: String): Result[RequestLine, String] = {
    let parts = line.split(" ");
    if parts.len() != 3 { Err("http server: malformed request line") }
    else if !http_token_ok(parts[0]) || String.is_empty(parts[1]) || !http_text_ok_acc(parts[1].as_bytes(), 0, false) {
        Err("http server: malformed request line")
    } else if parts[2] != "HTTP/1.1" && parts[2] != "HTTP/1.0" {
        Err("http server: unsupported HTTP version")
    } else { Ok(RequestLine { method: parts[0], path: parts[1] }) }
}

let http_digit (c: Int): Bool = c >= 48 && c <= 57
let http_hex (c: Int): Bool = http_digit(c) || (c >= 65 && c <= 70) || (c >= 97 && c <= 102)
let http_reg_name_byte (c: Int): Bool =
    (c >= 65 && c <= 90) || (c >= 97 && c <= 122) || http_digit(c)
        || c == 45 || c == 46 || c == 95 || c == 126
        || c == 33 || c == 36 || c == 38 || c == 39 || c == 40 || c == 41
        || c == 42 || c == 43 || c == 44 || c == 59 || c == 61

let http_port_ok (b: Bytes) (i: Int): Bool =
    if i >= b.len() { true }
    else if http_digit(http_byte(b, i)) { http_port_ok(b, i + 1) } else { false }

let http_reg_name_ok (b: Bytes) (i: Int): Bool =
    if i >= b.len() { true }
    else if http_byte(b, i) == 58 { http_port_ok(b, i + 1) }
    else if http_byte(b, i) == 37 {
        if http_hex(http_byte(b, i + 1)) && http_hex(http_byte(b, i + 2)) { http_reg_name_ok(b, i + 3) } else { false }
    } else if http_reg_name_byte(http_byte(b, i)) { http_reg_name_ok(b, i + 1) } else { false }

let http_hex_ok (b: Bytes) (i: Int): Bool =
    if i >= b.len() { true }
    else if http_hex(http_byte(b, i)) { http_hex_ok(b, i + 1) } else { false }

// IPv4 is special only as an IPv6 suffix: exactly four decimal octets,
// no leading zeroes. Elsewhere dotted text can also be a reg-name.
let http_ipv4_ok (s: String): Bool = {
    let parts = s.split(".");
    parts.len() == 4 && Array.all(parts, |part| {
        let b = part.as_bytes();
        b.len() >= 1 && b.len() <= 3 && (b.len() == 1 || http_byte(b, 0) != 48)
            && http_port_ok(b, 0) && match String.parse_int(part) { Ok(n) => n <= 255, Err(_) => false }
    })
}

let http_ipv6_groups (parts: Array[String]) (i: Int) (allow_ipv4: Bool) (count: Int): Int =
    if i >= parts.len() { count }
    else {
        let part = parts[i];
        if allow_ipv4 && i == parts.len() - 1 && String.contains(part, ".") {
            if http_ipv4_ok(part) { count + 2 } else { -1 }
        } else if part.len() >= 1 && part.len() <= 4 && http_hex_ok(part.as_bytes(), 0) {
            http_ipv6_groups(parts, i + 1, allow_ipv4, count + 1)
        } else { -1 }
    }

let http_ipv6_side (s: String) (allow_ipv4: Bool): Int =
    if String.is_empty(s) { 0 } else { http_ipv6_groups(s.split(":"), 0, allow_ipv4, 0) }

let http_ipv6_ok (s: String): Bool =
    if s.len() > 45 { false }
    else { match String.index_of(s, "::") {
        None => http_ipv6_side(s, true) == 8,
        Some(i) => {
            let left = http_ipv6_side(String.slice(s, 0, i), false);
            let right = http_ipv6_side(String.slice(s, i + 2, String.char_len(s)), true);
            left >= 0 && right >= 0 && left + right < 8
        },
    } }

let http_ipvfuture_tail (b: Bytes) (i: Int): Bool =
    if i >= b.len() { true }
    else if http_reg_name_byte(http_byte(b, i)) || http_byte(b, i) == 58 { http_ipvfuture_tail(b, i + 1) } else { false }

let http_ip_literal_ok (s: String): Bool =
    if String.starts_with(s, "v") || String.starts_with(s, "V") {
        match String.index_of(s, ".") {
            None => false,
            Some(i) => i > 1 && i + 1 < s.len()
                && http_hex_ok(String.slice(s, 1, i).as_bytes(), 0)
                && http_ipvfuture_tail(s.as_bytes(), i + 1),
        }
    } else { http_ipv6_ok(s) }

// RFC 9110 section 7.2 / RFC 3986: uri-host [ ':' port ]. This is
// syntax validation, not DNS resolution or a socket port-range check.
// Empty Host and empty port are legal grammar (RFC 9112 section 3.2).
let http_host_ok (s: String): Bool =
    if String.starts_with(s, "[") { match String.index_of(s, "]") {
        None => false,
        Some(i) => {
            let b = s.as_bytes();
            http_ip_literal_ok(String.slice(s, 1, i))
                && (i + 1 == b.len() || (http_byte(b, i + 1) == 58 && http_port_ok(b, i + 2)))
        },
    } } else { http_reg_name_ok(s.as_bytes(), 0) }

let http_validate_host (headers: Array[Header]) (i: Int) (seen: Bool) (required: Bool): Result[Unit, String] =
    if i >= headers.len() {
        if required && !seen { Err("http server: missing Host header") } else { Ok(()) }
    } else if http_header_named(headers[i], "Host") {
        if seen { Err("http server: duplicate Host header") }
        else if !http_host_ok(headers[i].value) { Err("http server: invalid Host header") }
        else { http_validate_host(headers, i + 1, true, required) }
    } else { http_validate_host(headers, i + 1, seen, required) }

// Validate the complete head before exposing it to body reading. Keep the
// version local so the public RequestLine/RequestHead structs stay stable.
let http_parse_request_head (raw: Bytes): Result[RequestHead, String] =
    match http_head_separator(raw, 0) {
        None => Err("http server: incomplete request head"),
        Some(i) => raw.slice(0, i).as_string() |> Result.and_then(_, |text| {
            let lines = text.split("\r\n");
            http_parse_request_line(lines[0]) |> Result.and_then(_, |rl|
                http_parse_headers(Array.drop(lines, 1)) |> Result.and_then(_, |headers|
                    http_validate_host(headers, 0, false, String.ends_with(lines[0], "HTTP/1.1"))
                        |> Result.map(_, |ignored| RequestHead {
                            method: rl.method, path: rl.path, headers: headers,
                            leftover_body: raw.slice(i + 4, raw.len()),
                        })))
        }),
    }

/// A small, fixed table covering the reason phrases any real client
/// actually looks at — not the full IANA registry. An unrecognized code
/// still produces a syntactically valid status line (`"Unknown"`), just
/// a less informative one; never a hard error, since the STATUS CODE
/// itself (not its phrase) is what every real HTTP client actually acts
/// on.
let http_status_reason (code: Int): String = match code {
    200 => "OK", 201 => "Created", 204 => "No Content",
    301 => "Moved Permanently", 302 => "Found",
    400 => "Bad Request", 401 => "Unauthorized", 403 => "Forbidden", 404 => "Not Found", 405 => "Method Not Allowed",
    500 => "Internal Server Error", 501 => "Not Implemented", 502 => "Bad Gateway", 503 => "Service Unavailable",
    _ => "Unknown",
}

// This whole-response API owns framing: caller-supplied lengths/codings
// cannot override the method/status policy or describe a different body.
// Omit length for 304: resp.body need not be the selected representation.
// HEAD may report the byte length of the handler's would-be GET body.
let http_response_to_wire (method: String) (resp: Response): Result[HttpWire, String] =
    if !http_status_valid(resp.status) { Err("http server: invalid response status") }
    else if http_informational(resp.status) { Err("http server: handler must return a final response") }
    else if http_tunnel(method, resp.status) { Err("http server: CONNECT tunnels are not supported") }
    else { Result.map(http_validate_headers(resp.headers, 0), |ignored| {
        let extra_header_lines = Array.fold(resp.headers, "", |acc, h|
            if http_header_named(h, "Content-Length") || http_header_named(h, "Transfer-Encoding") { acc }
            else { acc.concat(h.name).concat(": ").concat(h.value).concat("\r\n") });
        let length_line = if resp.status == 204 || resp.status == 304 { "" }
            else { "Content-Length: ".concat(resp.body.len().to_string()).concat("\r\n") };
        let body = if http_response_bodyless(method, resp.status) { Bytes.empty() } else { resp.body };
        let head = "HTTP/1.1 ".concat(resp.status.to_string()).concat(" ").concat(http_status_reason(resp.status)).concat("\r\n")
            .concat(length_line)
            .concat("Connection: close\r\n")
            .concat(extra_header_lines)
            .concat("\r\n");
        HttpWire { head: head.as_bytes(), body: body }
    }) }

// The public RequestHead omits version. Inspect the already validated
// request line only when Expect is present, preserving that public shape.
let http_request_http11 (raw: Bytes) (i: Int): Bool =
    if i + 1 >= raw.len() { false }
    else if http_byte(raw, i) == 13 && http_byte(raw, i + 1) == 10 {
        i >= 8 && raw.slice(i - 8, i) == "HTTP/1.1".as_bytes()
    } else { http_request_http11(raw, i + 1) }

let http_expectations_ok (headers: Array[Header]) (i: Int): Bool =
    if i >= headers.len() { true }
    else if http_header_named(headers[i], "Expect")
        && !http_expectation_value(headers[i].value.as_bytes(), 0) { false }
    else { http_expectations_ok(headers, i + 1) }

// Expect is a list. Each supported member is exactly 100-continue;
// compare bounded token slices rather than allocating a split array.
let http_expectation_value (value: Bytes) (offset: Int): Bool = {
    let start = http_ows_start(value, offset);
    let end = start + 12;
    if end > value.len() || !http_ascii_equal(value.slice(start, end), "100-continue".as_bytes(), 0) { false }
    else {
        let next = http_ows_start(value, end);
        if next == value.len() { true }
        else if http_byte(value, next) == 44 { http_expectation_value(value, next + 1) }
        else { false }
    }
}

let http_reject_request (conn: Int) (status: String) (error: String): Result[Unit, String] =
    http_write_all(conn, 0, "HTTP/1.1 ".concat(status).concat("\r\nContent-Length: 0\r\nConnection: close\r\n\r\n").as_bytes(), 0)
        |> Result.and_then(_, |ignored| Err(error))

let http_dispatch_request (conn: Int) (head: RequestHead) (length: Int) (handler: (Request) -> Response): Result[Unit, String] =
    http_read_fixed_body(conn, 0, Int.max(0, length), head.leftover_body) |> Result.and_then(_, |body| {
        let request = Request { method: head.method, path: head.path, headers: head.headers, body: body };
        http_response_to_wire(head.method, handler(request))
            |> Result.and_then(_, |wire| http_send(conn, 0, wire))
    })

/// Reads exactly one request off `conn`, runs `handler`, writes exactly
/// one response back — never touches `conn`'s own lifecycle (opening/
/// closing), that's `serve_once`/`http_serve_loop`'s job below, so
/// this stays testable on its own without a real listening socket
/// (any connected `fd` pair works, e.g. the SAME loopback-pair shape
/// `tcp_round_trip`'s own test already uses).
let http_handle_connection (conn: Int) (handler: (Request) -> Response): Result[Unit, String] =
    http_recv_headers_acc(conn, 0, Bytes.empty()) |> Result.and_then(_, |raw|
        match http_parse_request_head(raw) {
            Err(e) => http_reject_request(conn, "400 Bad Request", e),
            Ok(head) => match http_framing(head.headers) {
                Err(e) => http_reject_request(conn, "400 Bad Request", e),
                Ok(length) => {
                    let expect = Option.is_some(http_find_header(head.headers, "Expect")) && http_request_http11(raw, 0);
                    if expect && !http_expectations_ok(head.headers, 0) {
                        http_reject_request(conn, "417 Expectation Failed", "http server: unsupported expectation")
                    } else {
                        let ready = if expect && length > head.leftover_body.len() {
                            http_write_all(conn, 0, "HTTP/1.1 100 Continue\r\n\r\n".as_bytes(), 0)
                        } else { Ok(()) };
                        ready |> Result.and_then(_, |ignored| http_dispatch_request(conn, head, length, handler))
                    }
                },
            },
        })

/// Handles exactly ONE connection then returns — listens, accepts once,
/// closes both the connection and the listening socket, and gives back
/// whatever `http_handle_connection` produced. Invalid handler headers
/// return Err without writing response bytes; the connection is closed.
/// Status codes must be 200..599: informational-only handler responses and
/// successful CONNECT tunnels return Err without writing response bytes.
/// HEAD, 204, and 304 suppress the handler's body. HEAD reports its byte
/// length; 204 and 304 omit Content-Length. Caller Content-Length and
/// Transfer-Encoding fields are replaced by this generated framing.
/// Malformed request lines/fields and missing (HTTP/1.1), duplicate, or
/// invalid Host fields receive 400 before body reading or handler dispatch,
/// then return Err. Ambiguous, invalid, or unsupported body framing also
/// receives 400 before reading content or dispatching the handler. Repeated
/// or comma-separated Content-Length values must all agree and use decimal
/// digits within Int range. Requests without framing have an empty body;
/// bytes beyond a declared length are excluded from that request's body.
/// HTTP/1.1 Expect: 100-continue is acknowledged before waiting for content;
/// unsupported expectations receive 417. HTTP/1.0 expectations are ignored.
/// HTTP/1.0 may omit Host. Present Host values use URI host
/// syntax, including empty values, IP literals, and optional decimal ports.
/// Real, useful on its own
/// (a one-shot server, or a test fixture — this is what THIS module's
/// own tests exercise directly), not just a building block for `http_
/// serve` below.
pub let serve_once (port: Int) (handler: (Request) -> Response): Result[Unit, String] =
    match Net.listen_on(port) {
        Err(e) => Err(e),
        Ok(server) => match Net.accept(server) {
            Err(e) => { Net.close(server); Err(e) },
            Ok(conn) => {
                let result = http_handle_connection(conn, handler);
                Net.close(conn);
                Net.close(server);
                result
            },
        },
    }

/// The REAL long-running server: accept, hand the connection off to its
/// own task, repeat — forever. Concurrent by design: `spawn` puts each
/// connection's `http_handle_connection`/close on its own real OS
/// thread (see DESIGN.md's Concurrency section — "OS threads first")
/// so one slow client (a slow body, a slow handler) can't stall every
/// OTHER connection behind it the way a single sequential accept-loop
/// would. A single misbehaving/erroring connection does NOT bring the
/// server down (the spawned task's `Result` is deliberately never
/// joined, let alone matched — a bare discarded statement, same idiom
/// `println`'s own `write(1, s.as_cstr(), n);` already established for
/// a discarded non-`Unit` extern return) — only a hard failure to
/// ACCEPT (a real listener-level problem, not a per-connection one)
/// stops the loop, matching `Err` propagating out of `tcp_accept_
/// connection` itself.
///
/// `handler` must be a plain top-level function or a closure that
/// captures NOTHING (both cross a `spawn` boundary equally, see
/// DESIGN.md's "native-codegen zero-capture closure fix" section) — a
/// closure that DOES capture live local state still can't cross: the
/// interpreter rejects it with a clear error at the `spawn` site, and
/// native codegen rejects it with a clean runtime abort (can't be
/// proven safe/unsafe at compile time — the same free-variable slot
/// could hold either shape depending on what's passed in).
///
/// Deliberately not directly compile-and-run tested for the INFINITE-
/// LOOP shape itself (no `while`/loop-with-an-exit exists in this
/// language, and this function genuinely has none by design — a real
/// server keeps serving), same as before this change; what IS new here
/// (spawn-per-connection actually running two connections concurrently,
/// not serially) is covered by `http_serve_loop_handles_two_connections_
/// concurrently_not_serially` below.
let http_serve_loop (server: Int) (handler: (Request) -> Response): Result[Unit, String] =
    match Net.accept(server) {
        Err(e) => Err(e),
        Ok(conn) => {
            spawn { http_handle_connection(conn, handler); Net.close(conn) };
            http_serve_loop(server, handler)
        },
    }

/// Serves HTTP on a port, calling `handler` once per request, forever.
///
/// **Never returns** unless listening or accepting fails. Connections
/// run concurrently. Invalid handler headers close that connection without
/// sending a response; other connections continue to be served. Invalid
/// request heads receive 400 and close, as described by `serve_once`.
pub let serve (port: Int) (handler: (Request) -> Response): Result[Unit, String] =
    match Net.listen_on(port) {
        Err(e) => Err(e),
        Ok(server) => http_serve_loop(server, handler),
    }
