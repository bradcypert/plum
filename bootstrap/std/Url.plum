/// One `name=value` pair of a query string, decoded.
///
/// Both halves are the real text: `a b` is a space, not `a%20b`.
/// `build_query` re-encodes them on the way out.
pub struct Param { pub name: String, pub value: String }

/// `port` is always RESOLVED: the scheme's default when the URL did
/// not say. 0 means the scheme has no default this module knows,
/// which is not an error. Parsing is not connecting, and a URL
/// with a scheme we have never heard of is still a URL.
///
/// `path` is percent-encoded and never empty (`/` when the URL had
/// none). `raw_query` and `fragment` are stored without their `?`
/// and `#`, and are `""` when absent, which does not distinguish
/// `http://h/p` from `http://h/p?`, a difference nothing observable
/// depends on.
pub struct Url {
    pub scheme: String,
    pub host: String,
    pub port: Int,
    pub path: String,
    pub raw_query: String,
    pub fragment: String,
}

let byte_at (b: Bytes) (i: Int): Int = match b.at(i) { Some(v) => v, None => 0 }

/// Ports the schemes this module knows about default to. An unknown
/// scheme gets 0; see `Url`'s note.
pub let default_port (scheme: String): Int =
    if scheme == "http" { 80 }
    else if scheme == "https" { 443 }
    else { 0 }

/// RFC 3986: ALPHA *( ALPHA / DIGIT / "+" / "-" / "." ).
let scheme_ok_acc (b: Bytes) (i: Int) (n: Int): Bool =
    if i >= n { true }
    else {
        let c = byte_at(b, i);
        let alpha = (c >= 65 && c <= 90) || (c >= 97 && c <= 122);
        let digit = c >= 48 && c <= 57;
        let mark = c == 43 || c == 45 || c == 46;
        if i == 0 { if alpha { scheme_ok_acc(b, i + 1, n) } else { false } }
        else if alpha || digit || mark { scheme_ok_acc(b, i + 1, n) }
        else { false }
    }

let scheme_ok (s: String): Bool = {
    let b = s.as_bytes();
    if b.is_empty() { false } else { scheme_ok_acc(b, 0, b.len()) }
}

/// Every index here is a CODEPOINT index, because `String.index_of`
/// and `String.slice` both are. Mixing one with `.len()`, which is
/// BYTES, is the bug this comment exists to prevent. They agree on
/// ASCII and part company on anything else, and a URL with a raw
/// non-ASCII character in it is exactly the input that would find it.
let clen (s: String): Int = String.char_len(s)

/// Splits `s` at the first `sep`, returning the part before and the
/// part after. When `sep` is absent the whole string is `before`.
pub struct Split { pub before: String, pub after: String, pub found: Bool }

let split_first (s: String) (sep: String): Split =
    match String.index_of(s, sep) {
        None => Split { before: s, after: "", found: false },
        Some(i) => Split {
            before: String.slice(s, 0, i),
            after: String.slice(s, i + clen(sep), clen(s)),
            found: true,
        },
    }

/// Every escape in the query must decode, and decode to text.
/// Checked at PARSE time so that `query_get` afterwards cannot fail:
/// a lookup returning `Option` should mean "absent", never "present
/// but malformed".
let validate_pct (context: String) (s: String): Result[Unit, String] =
    match Encoding.percent_decode(s) {
        Err(e) => Err("Url.parse: ".concat(context).concat(": ").concat(e)),
        Ok(bytes) => match bytes.as_string() {
            Err(_) => Err("Url.parse: ".concat(context).concat(" is not valid UTF-8 once decoded")),
            Ok(_) => Ok(()),
        },
    }

let validate_params (params: Array[Param]) (i: Int): Result[Unit, String] =
    if i >= params.len() { Ok(()) }
    else { match validate_pct("query name", params[i].name) {
        Err(e) => Err(e),
        Ok(_) => match validate_pct("query value", params[i].value) {
            Err(e) => Err(e),
            Ok(_) => validate_params(params, i + 1),
        },
    } }

/// `a=1&b=2` into pairs, still encoded. A field with no `=` has an
/// empty value (`?flag`), and an empty field is skipped (`?a=1&&b=2`)
/// rather than becoming a nameless pair.
let parse_params_acc (fields: Array[String]) (i: Int) (acc: Array[Param]): Array[Param] =
    if i >= fields.len() { acc }
    else if String.is_empty(fields[i]) { parse_params_acc(fields, i + 1, acc) }
    else {
        let kv = split_first(fields[i], "=");
        parse_params_acc(fields, i + 1, acc.push(Param { name: kv.before, value: kv.after }))
    }

let raw_params (raw_query: String): Array[Param] =
    if String.is_empty(raw_query) { [] }
    else { parse_params_acc(String.split(raw_query, "&"), 0, []) }

/// The authority, minus any `[...]` IPv6 brackets, plus a port.
///
/// Brackets are STRIPPED rather than kept: `Net.connect_to` passes the
/// host to `getaddrinfo`, which wants `::1` and not `[::1]`. They
/// exist in the URL only to keep the colons in an IPv6 address from
/// being read as a port separator, which is a syntax problem and not
/// something the host itself carries.
let parse_authority (authority: String) (scheme: String): Result[Url, String] =
    if String.contains(authority, "@") {
        Err("Url.parse: userinfo (user@host) is not supported")
    } else if String.is_empty(authority) {
        Err("Url.parse: missing host")
    } else if String.starts_with(authority, "[") {
        match String.index_of(authority, "]") {
            None => Err("Url.parse: unterminated IPv6 address"),
            Some(close) => {
                let host = String.slice(authority, 1, close);
                let rest = String.slice(authority, close + 1, clen(authority));
                if String.is_empty(rest) { Ok(host_port(scheme, host, default_port(scheme))) }
                else if !String.starts_with(rest, ":") { Err("Url.parse: trailing text after IPv6 address") }
                else { with_port(scheme, host, String.slice(rest, 1, clen(rest))) }
            },
        }
    } else {
        let hp = split_first(authority, ":");
        if !hp.found { Ok(host_port(scheme, authority, default_port(scheme))) }
        else if String.is_empty(hp.before) { Err("Url.parse: missing host") }
        else { with_port(scheme, hp.before, hp.after) }
    }

/// A partially-built `Url`; the caller fills in path/query/fragment.
let host_port (scheme: String) (host: String) (port: Int): Url =
    Url { scheme: scheme, host: host, port: port, path: "/", raw_query: "", fragment: "" }

let with_port (scheme: String) (host: String) (text: String): Result[Url, String] =
    if String.is_empty(text) { Err("Url.parse: empty port") }
    else { match String.parse_int(text) {
        Err(_) => Err("Url.parse: invalid port: ".concat(text)),
        Ok(p) => if p < 1 || p > 65535 { Err("Url.parse: port out of range: ".concat(text)) }
                 else { Ok(host_port(scheme, host, p)) },
    } }

/// Absolute URLs only. A scheme-relative (`//host/x`) or relative
/// (`/x`) reference has no meaning without a base to resolve against,
/// and resolution is a different function than parsing.
///
/// The scheme is lowercased, because schemes are case-insensitive, and
/// normalising here is what lets `u.scheme == "http"` be written
/// everywhere else without thinking about it. The host is left
/// exactly as written, matching Go's `net/url`.
pub let parse (input: String): Result[Url, String] = {
    let sp = split_first(input, "://");
    if !sp.found { Err("Url.parse: missing scheme (expected something like http://host/path)") }
    else if !scheme_ok(sp.before) { Err("Url.parse: invalid scheme: ".concat(sp.before)) }
    else {
        let scheme = String.to_lower(sp.before);
        // Fragment first, then query: a `#` ends the query, and a `?`
        // inside a fragment is part of the fragment.
        let frag = split_first(sp.after, "#");
        let q = split_first(frag.before, "?");
        let slash = String.index_of(q.before, "/");
        let authority = match slash { Some(i) => String.slice(q.before, 0, i), None => q.before };
        let path = match slash { Some(i) => String.slice(q.before, i, clen(q.before)), None => "/" };
        match parse_authority(authority, scheme) {
            Err(e) => Err(e),
            Ok(base) => match validate_params(raw_params(q.after), 0) {
                Err(e) => Err(e),
                Ok(_) => match validate_pct("path", path) {
                    Err(e) => Err(e),
                    Ok(_) => Ok(Url {
                        scheme: base.scheme, host: base.host, port: base.port,
                        path: path, raw_query: q.after, fragment: frag.after,
                    }),
                },
            },
        }
    }
}

/// What goes after the method in an HTTP request line: the path, plus
/// the query exactly as it arrived. Not the fragment; a fragment is
/// never sent to a server.
pub let request_target (u: Url): String =
    if String.is_empty(u.raw_query) { u.path } else { u.path.concat("?").concat(u.raw_query) }

/// Host, re-bracketed if it is an IPv6 literal, plus the port when
/// it is not the scheme's default.
///
/// This is what an HTTP `Host:` header wants (RFC 7230 section 5.4)
/// and what a URL's authority component is, which is the same string
/// for the same reasons, so it is written once here rather than
/// twice, once in `stringify` and once in the HTTP client.
///
/// The brackets have to come back: they were stripped on the way in
/// because `getaddrinfo` wants `::1`, but any context that puts a
/// host next to a `:port` needs them or the colons are ambiguous.
pub let authority (u: Url): String = {
    let host = if String.contains(u.host, ":") { "[".concat(u.host).concat("]") } else { u.host };
    if u.port == default_port(u.scheme) || u.port == 0 { host }
    else { host.concat(":").concat(u.port.to_string()) }
}

/// The port is omitted when it is the scheme's default, and an IPv6
/// host is re-bracketed, so this is CANONICAL output rather than a
/// byte-for-byte reproduction of whatever was parsed. `parse` after
/// `stringify` yields the same `Url`, which is the invariant that
/// matters and the one the properties check.
pub let stringify (u: Url): String = {
    let frag = if String.is_empty(u.fragment) { "" } else { "#".concat(u.fragment) };
    u.scheme.concat("://").concat(authority(u)).concat(request_target(u)).concat(frag)
}

/// --- Query access ---
///
/// Values come back DECODED. `parse` already proved every escape in
/// the query decodes to text, so the fallback below cannot be reached
/// for a `Url` that came from `parse`; it exists for one built by
/// hand with a `raw_query` nobody validated.
let decoded (s: String): String =
    match Encoding.percent_decode(s) {
        Err(_) => s,
        Ok(bytes) => match bytes.as_string() { Err(_) => s, Ok(text) => text },
    }

let query_all_acc (params: Array[Param]) (name: String) (i: Int) (acc: Array[String]): Array[String] =
    if i >= params.len() { acc }
    else if decoded(params[i].name) == name { query_all_acc(params, name, i + 1, acc.push(decoded(params[i].value))) }
    else { query_all_acc(params, name, i + 1, acc) }

/// Every value for `name`, in the order they appeared. A query may
/// legitimately repeat a key (`?tag=a&tag=b`), and a lookup that
/// returns one value cannot say so.
pub let query_all (u: Url) (name: String): Array[String] =
    query_all_acc(raw_params(u.raw_query), name, 0, [])

/// The FIRST value for `name`, matching Go's `Values.Get`. `None` is
/// absent; a present-but-empty value (`?q=`) is `Some("")`.
pub let query_get (u: Url) (name: String): Option[String] =
    Array.first(query_all(u, name))

/// All pairs, decoded, in order.
pub let query_params (u: Url): Array[Param] =
    Array.map(raw_params(u.raw_query), |p| Param { name: decoded(p.name), value: decoded(p.value) })

/// Builds a `raw_query` from pairs, percent-encoding both halves.
/// `Encoding` owns the encoder; this only decides where the `&` and
/// `=` go.
let encode_param (p: Param): String =
    Encoding.percent_encode(p.name.as_bytes()).concat("=").concat(Encoding.percent_encode(p.value.as_bytes()))

/// Builds a query string from pairs, percent-encoding both halves.
///
/// The leading `?` is NOT included, so this can be assigned straight to
/// a `Url`'s `raw_query`. An empty array gives an empty string rather
/// than a stray separator.
pub let build_query (params: Array[Param]): String =
    Array.join(Array.map(params, encode_param), "&")

/// `u` with its query replaced. A setter rather than a mutation:
/// values are values here.
pub let with_query (u: Url) (params: Array[Param]): Url =
    Url { scheme: u.scheme, host: u.host, port: u.port, path: u.path,
          raw_query: build_query(params), fragment: u.fragment }

