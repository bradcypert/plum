/// Hoisted, so the platform is not re-derived per character. It is
/// compiled in (`Os.platform()` is a constant, not a lookup), but a
/// global says that once rather than trusting every call site to be
/// cheap.
let IS_WINDOWS: Bool = Os.platform() == "windows"

/// `\\` on Windows, `/` everywhere else.
///
/// Every function in this module has an `_in` form taking the
/// convention as its first argument, and a host form that reads it
/// from `Os.platform()`. The pair exists because the Windows branch
/// is UNREACHABLE on a Unix machine, not merely untested, so a
/// Windows-only path bug could otherwise only be found by CI, on a
/// machine nobody can attach a debugger to. `lsp.uri_to_path_in` is
/// the same shape for the same reason, and two releases shipped bugs
/// of exactly this kind before it existed.
///
/// They are also what to call when you are building a path FOR
/// another platform rather than for the one you are running on.
pub let separator_in (windows: Bool): String = if windows { "\\" } else { "/" }
pub let separator (): String = separator_in(IS_WINDOWS)

/// Backslashes become forward slashes on Windows so the rest of this
/// module has ONE separator to reason about. A no-op elsewhere: a
/// backslash is a legal character in a Unix filename and must not be
/// touched there.
let normalize_in (windows: Bool) (p: String): String = if windows { String.replace(p, "\\", "/") } else { p }

/// `C:` or `c:`, a drive letter, which only means anything on
/// Windows.
let has_drive_in (windows: Bool) (p: String): Bool =
    windows && String.char_len(p) >= 2 && String.slice(p, 1, 2) == ":" && plum_is_alpha(String.slice(p, 0, 1))

let plum_is_alpha (c: String): Bool = {
    let b = c.as_bytes();
    if b.len() != 1 { false } else { match b.at(0) {
        Some(v) => (v >= 65 && v <= 90) || (v >= 97 && v <= 122),
        None => false,
    } }
}

/// Rooted: `/x` anywhere, and on Windows also `C:/x` and a `//server`
/// UNC path. `C:x` (a drive-RELATIVE path) is deliberately not
/// absolute; it means "the current directory on drive C", which is
/// a relative path with a drive attached.
pub let is_absolute_in (windows: Bool) (p: String): Bool = {
    let n = normalize_in(windows, p);
    if String.starts_with(n, "/") { true }
    else if has_drive_in(windows, n) { String.starts_with(String.slice(n, 2, String.char_len(n)), "/") }
    else { false }
}
pub let is_absolute (p: String): Bool = is_absolute_in(IS_WINDOWS, p)

/// --- clean ---
///
/// Lexical only, and that limit is the point: `a/b/../c` becomes
/// `a/c` WITHOUT asking whether `a/b` is a symlink pointing
/// elsewhere. Resolving that needs syscalls and is a different
/// function; `Os.remove_tree` already refuses to follow links out of
/// a tree rather than trying to reason about them.
let drop_empty_and_dot (parts: Array[String]) (i: Int) (acc: Array[String]): Array[String] =
    if i >= parts.len() { acc }
    else if String.is_empty(parts[i]) || parts[i] == "." { drop_empty_and_dot(parts, i + 1, acc) }
    else { drop_empty_and_dot(parts, i + 1, acc.push(parts[i])) }

/// A `..` pops the segment before it, unless there is nothing to
/// pop, in which case it is KEPT for a relative path (`../x` really
/// does mean the parent) and DROPPED for an absolute one (the root
/// has no parent, so `/../x` is `/x`).
let resolve_dotdot (parts: Array[String]) (i: Int) (rooted: Bool) (acc: Array[String]): Array[String] =
    if i >= parts.len() { acc }
    else if parts[i] != ".." { resolve_dotdot(parts, i + 1, rooted, acc.push(parts[i])) }
    else if !Array.is_empty(acc) && acc[acc.len() - 1] != ".." {
        resolve_dotdot(parts, i + 1, rooted, Array.slice(acc, 0, acc.len() - 1))
    }
    else if rooted { resolve_dotdot(parts, i + 1, rooted, acc) }
    else { resolve_dotdot(parts, i + 1, rooted, acc.push("..")) }

/// Removes duplicate separators, `.` segments, and resolvable `..`
/// segments, and drops a trailing separator. An empty result is `.`,
/// matching Go's `filepath.Clean`. The empty string is not a path,
/// and `.` is the one it means.
pub let clean_in (windows: Bool) (p: String): String = {
    let n = normalize_in(windows, p);
    let drive = if has_drive_in(windows, n) { String.slice(n, 0, 2) } else { "" };
    let rest = if String.is_empty(drive) { n } else { String.slice(n, 2, String.char_len(n)) };
    let rooted = String.starts_with(rest, "/");
    // `\\server\share` -- a UNC path, whose root is TWO separators.
    // Collapsing it to one turned a network path into a local one:
    // `//srv/sh` cleaned to `\srv\sh`, which names something else
    // entirely. Exactly two, since `///x` is not UNC.
    // A path WITH a drive is never UNC, and `join("C:\\", "a")`
    // produces exactly that shape before cleaning: `C://a`.
    let unc = windows && String.is_empty(drive) && String.starts_with(rest, "//") && !String.starts_with(rest, "///");
    let parts = resolve_dotdot(drop_empty_and_dot(String.split(rest, "/"), 0, []), 0, rooted, []);
    let joined = Array.join(parts, separator_in(windows));
    let root = if unc { separator_in(windows).concat(separator_in(windows)) } else if rooted { separator_in(windows) } else { "" };
    let body = root.concat(joined);
    if String.is_empty(body) { if String.is_empty(drive) { "." } else { drive.concat(".") } }
    else { drive.concat(body) }
}
pub let clean (p: String): String = clean_in(IS_WINDOWS, p)

/// --- join ---
///
/// Empty segments are skipped, so `join("", "b")` is `b` rather than
/// `/b`; joining nothing to something must not turn a relative path
/// absolute.
///
/// A later ABSOLUTE segment does not discard the earlier ones:
/// `join("a", "/b")` is `a/b`, matching Go's `filepath.Join`. Python
/// goes the other way and lets `/b` win, which is convenient exactly
/// until a caller passes user input as the second argument and
/// silently escapes the directory they meant to stay inside.
pub let join_all_in (windows: Bool) (parts: Array[String]): String = {
    let kept = drop_empty(parts, 0, []);
    if Array.is_empty(kept) { "" } else { clean_in(windows, Array.join(kept, "/")) }
}
pub let join_all (parts: Array[String]): String = join_all_in(IS_WINDOWS, parts)

let drop_empty (parts: Array[String]) (i: Int) (acc: Array[String]): Array[String] =
    if i >= parts.len() { acc }
    else if String.is_empty(parts[i]) { drop_empty(parts, i + 1, acc) }
    else { drop_empty(parts, i + 1, acc.push(parts[i])) }

/// Joins two path segments with the platform separator, cleaning the
/// result.
///
/// A trailing separator on `a` or a leading one on `b` does not produce
/// a doubled separator.
///
/// **An absolute `b` does NOT win**: `join("a", "/b")` is `a/b`, not
/// `/b`. This is `join_all([a, b])` and inherits its rule, which is
/// Go's; see the reasoning there. If `b` may be absolute and should
/// be taken as-is, test it with `Path.is_absolute` and use it
/// directly.
///
/// This documentation said the opposite until 0.0.30, and the
/// package loader was written against the sentence rather than the
/// code: an absolute dependency path was resolved relative to the
/// manifest, producing `/home/x/opt/parsec` and blaming the user's
/// manifest for a path the compiler had invented.
pub let join_in (windows: Bool) (a: String) (b: String): String = join_all_in(windows, [a, b])
pub let join (a: String) (b: String): String = join_all([a, b])

// --- Splitting a path apart ---
//
// A TRAILING SEPARATOR is ignored by both halves: `a/b/` has
// basename `b` and dirname `a`. That is a deliberate choice, and
// the two obvious references disagree with each other about it.
// Python treats a trailing slash as "no file part" (basename
// `""`, dirname `a/b`); Go strips it in `Base` but not in `Dir`,
// so `Base` says `b` while `Dir` says `a/b`.
//
// Stripping in both is what makes them describe the SAME split:
//
//     join(dirname(p), basename(p)) == clean(p)
//
// holds for every path, including `""`, `/`, `file` and `a/b/`.
// Go's pair does not satisfy that for a trailing slash, and a
// property in `bootstrap/properties` checks that this one does.

let last_sep_index (s: String) (i: Int) (best: Int): Int =
    if i >= String.char_len(s) { best }
    else if String.slice(s, i, i + 1) == "/" { last_sep_index(s, i + 1, i) }
    else { last_sep_index(s, i + 1, best) }

/// The last component. `""` is `.`, a bare root is itself, and a
/// trailing separator is ignored (`a/b/` is `b`).
pub let basename_in (windows: Bool) (p: String): String = {
    let n = normalize_in(windows, p);
    if String.is_empty(n) { "." }
    else {
        // The DRIVE comes off first. Without that, `C:\` has no
        // separator after trimming and reads as the name `C:`
        // rather than as a root.
        let drive = if has_drive_in(windows, n) { String.slice(n, 0, 2) } else { "" };
        let rest = if String.is_empty(drive) { n } else { String.slice(n, 2, String.char_len(n)) };
        let trimmed = drop_trailing_seps(rest);
        if String.is_empty(trimmed) { separator_in(windows) }
        else {
            let i = last_sep_index(trimmed, 0, 0 - 1);
            if i < 0 { trimmed } else { String.slice(trimmed, i + 1, String.char_len(trimmed)) }
        }
    }
}
pub let basename (p: String): String = basename_in(IS_WINDOWS, p)

let drop_trailing_seps (s: String): String =
    if String.char_len(s) > 1 && String.ends_with(s, "/") {
        drop_trailing_seps(String.slice(s, 0, String.char_len(s) - 1))
    } else if s == "/" { "" } else { s }

/// Everything before the last component, cleaned. A path with no
/// separator is `.`, the directory it is in.
pub let dirname_in (windows: Bool) (p: String): String = {
    let n = normalize_in(windows, p);
    if String.is_empty(n) { "." }
    else {
        // As in `basename_in`: the drive is not part of the search
        // for the last separator, and it stays on the answer.
        // `dirname("C:\a\")` was `C:.` -- the drive with no root,
        // which names the current directory on drive C rather than
        // its top.
        let drive = if has_drive_in(windows, n) { String.slice(n, 0, 2) } else { "" };
        let rest = if String.is_empty(drive) { n } else { String.slice(n, 2, String.char_len(n)) };
        let trimmed = drop_trailing_seps(rest);
        if String.is_empty(trimmed) { drive.concat(separator_in(windows)) }
        else {
            let i = last_sep_index(trimmed, 0, 0 - 1);
            if i < 0 { if String.is_empty(drive) { "." } else { drive.concat(".") } }
            else if i == 0 { drive.concat(separator_in(windows)) }
            else { clean_in(windows, drive.concat(String.slice(trimmed, 0, i))) }
        }
    }
}
pub let dirname (p: String): String = dirname_in(IS_WINDOWS, p)

/// --- Extensions ---
///
/// Returned WITHOUT the dot, so a check reads `Path.extension(p) ==
/// "plum"`. Go and Python include it; Rust does not, and neither do
/// this library's other splitters. `String.split` does not hand
/// back its separator either.
///
/// A LEADING dot does not begin an extension: `.hidden` is a name,
/// not an extension, so its stem is `.hidden` and its extension is
/// empty. A TRAILING dot gives an empty extension and a stem without
/// it (`file.` -> `file`), which is the only reading that lets stem
/// and extension describe the same name.
let ext_index (name: String): Int = {
    let i = last_dot(name, 0, 0 - 1);
    if i <= 0 { 0 - 1 } else { i }
}

let last_dot (s: String) (i: Int) (best: Int): Int =
    if i >= String.char_len(s) { best }
    else if String.slice(s, i, i + 1) == "." { last_dot(s, i + 1, i) }
    else { last_dot(s, i + 1, best) }

/// The extension of the last segment, without its dot, or empty when
/// there is none.
///
/// A leading dot does not start an extension: `.gitignore` is a name,
/// not an extension, and returns nothing. `archive.tar.gz` gives
/// `gz` --
/// the LAST dot wins, so `stem` and `extension` always recombine into
/// the original name.
pub let extension_in (windows: Bool) (p: String): String = {
    let name = basename_in(windows, p);
    let i = ext_index(name);
    if i < 0 { "" } else { String.slice(name, i + 1, String.char_len(name)) }
}
pub let extension (p: String): String = extension_in(IS_WINDOWS, p)

/// The last component without its extension.
pub let stem_in (windows: Bool) (p: String): String = {
    let name = basename_in(windows, p);
    let i = ext_index(name);
    if i < 0 { name } else { String.slice(name, 0, i) }
}
pub let stem (p: String): String = stem_in(IS_WINDOWS, p)

/// `p` with a different extension, given without a dot. An empty
/// `ext` removes it.
pub let with_extension_in (windows: Bool) (p: String) (ext: String): String = {
    let dir = dirname_in(windows, p);
    let base = if String.is_empty(ext) { stem_in(windows, p) } else { stem_in(windows, p).concat(".").concat(ext) };
    if dir == "." && !String.starts_with(normalize_in(windows, p), ".".concat("/")) { base } else { join_in(windows, dir, base) }
}
pub let with_extension (p: String) (ext: String): String = with_extension_in(IS_WINDOWS, p, ext)

