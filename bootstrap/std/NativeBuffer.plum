/// Owned, bounded native storage for unsafe in/out calls. This is separate
/// from immutable String/Bytes cells and from their owned CStr views.
extern "C" {
    fn plum_buffer_create(capacity: Int) -> Int;
    fn plum_buffer_release(buffer: Int);
    fn plum_buffer_length(buffer: Int) -> Int;
    fn plum_buffer_capacity(buffer: Int) -> Int;
    fn plum_buffer_reserve(buffer: Int, capacity: Int) -> Int;
    fn plum_buffer_write(buffer: Int, data: CStr, length: Int) -> Int;
    fn plum_buffer_acquire(buffer: Int, mode: Int) -> Int;
    fn plum_buffer_data(lease: Int) -> RawCStr;
    fn plum_buffer_commit(lease: Int, length: Int) -> Int;
    fn plum_buffer_text_length(lease: Int) -> Int;
    fn plum_buffer_end(lease: Int);
    fn plum_buffer_snapshot() -> Int;
    fn plum_buffer_snapshot_field(token: Int, field: Int) -> Int;
}

/// Aliases share one mutable native resource. Its final owner releases the
/// allocation. Normal exits and panic follow the standard handle contract.
pub handle Buffer { on_drop: plum_buffer_release }
// Private lease: its native reference survives owner cleanup, and its drop
// always ends the borrow, including a callback returning Err or panicking.
handle Lease { on_drop: plum_buffer_end }

let error (operation: String) (status: Int): String =
    operation.concat(if status == -2 { ": buffer is already borrowed" }
        else if status == -3 { ": allocation failed" }
        else { ": invalid length, capacity or NUL termination" })
let checked (operation: String) (status: Int): Result[Unit, String] =
    if status == 0 { Ok(()) } else { Err(error(operation, status)) }

/// Create empty storage with exactly `capacity` writable bytes. Zero capacity
/// is valid for binary operations. Native metadata/minimum allocation size
/// are separate from the reported payload capacity. New storage is zeroed;
/// logical length starts at zero. Allocation can fail.
pub let create (capacity: Int): Result[Buffer, String] = unsafe {
    if capacity < 0 { Err("NativeBuffer.create: capacity must be nonnegative") }
    else {
        let raw = plum_buffer_create(capacity);
        if raw == 0 { Err("NativeBuffer.create: allocation failed or capacity is not representable") }
        else { Ok(Buffer.from_raw(raw)) }
    }
}

/// Last committed readable prefix. During an edit this remains the previous
/// length. This metadata query does not access bytes or end the lease.
pub let length (buffer: Buffer): Int = unsafe { plum_buffer_length(Buffer.raw(buffer)) }
/// Writable bytes, including the terminator slot when used for text editing.
pub let capacity (buffer: Buffer): Int = unsafe { plum_buffer_capacity(Buffer.raw(buffer)) }

/// Grow to at least `capacity`, preserving contents. Never shrinks or truncates.
/// Err while borrowed; failed allocation leaves the old storage intact.
pub let reserve (buffer: Buffer) (capacity: Int): Result[Unit, String] = unsafe {
    checked("NativeBuffer.reserve", plum_buffer_reserve(Buffer.raw(buffer), capacity))
}

/// Copy immutable bytes into native storage. Err if they do not fit or the
/// resource is borrowed; neither case changes existing contents. Adds NUL
/// termination when capacity exceeds the byte length. Exact-capacity binary
/// input remains valid without a terminator.
pub let copy_in (buffer: Buffer) (bytes: Bytes): Result[Unit, String] = unsafe {
    checked("NativeBuffer.copy_in", plum_buffer_write(Buffer.raw(buffer), bytes.as_cstr(), bytes.len()))
}

/// Copy the committed prefix into independent Bytes while holding a read
/// lease. Err when another lease is active; later native edits cannot change
/// the returned immutable value.
pub let copy_out (buffer: Buffer): Result[Bytes, String] = unsafe {
    let raw = plum_buffer_acquire(Buffer.raw(buffer), 0);
    if raw == -1 || raw == -2 { Err(error("NativeBuffer.copy_out", raw)) }
    else {
        let lease = Lease.from_raw(raw);
        let n = plum_buffer_length(Lease.raw(lease));
        Ok(Bytes.from_cstr(plum_buffer_data(Lease.raw(lease)), n))
    }
}

/// Copy the committed prefix and validate UTF-8. Includes embedded NULs:
/// use with_text when a native API instead treats the first NUL as the end.
pub let text (buffer: Buffer): Result[String, String] =
    match copy_out(buffer) { Err(e) => Err(e), Ok(bytes) => bytes.as_string() }

/// Unsafe scoped binary access. The callback receives pointer/capacity and
/// returns the initialized readable length. Call with all arguments inside
/// unsafe; this function cannot be partially applied or used as a value.
/// No pointer may escape or be retained by foreign code. Writes must fit the
/// capacity. Once the callback begins, Err, invalid length or panic discards
/// contents. Rejected acquisition leaves contents unchanged.
/// Conflicting leases/copies/resizes return Err, including reentrant aliases.
pub let with_mut (buffer: Buffer) (operation: (RawCStr, Int) -> Result[Int, String]): Result[Int, String] = unsafe {
    let raw = plum_buffer_acquire(Buffer.raw(buffer), 1);
    if raw == -1 || raw == -2 { Err(error("NativeBuffer.with_mut", raw)) }
    else {
        let lease = Lease.from_raw(raw);
        let pointer = plum_buffer_data(Lease.raw(lease));
        let cap = plum_buffer_capacity(Lease.raw(lease));
        match operation(pointer, cap) {
            Err(e) => Err(e),
            Ok(n) => match checked("NativeBuffer.with_mut", plum_buffer_commit(Lease.raw(lease), n)) {
                Err(e) => Err(e), Ok(_) => Ok(n),
            },
        }
    }
}

/// Unsafe scoped C text editing. Capacity includes NUL space. Input must
/// already be terminated within initialized storage; output must have a NUL
/// within capacity. Scan, copy and validate UTF-8 while the lease is held;
/// return (callback result, independent String) before other aliases can edit.
/// Callback Err, invalid termination/UTF-8 or panic discards contents;
/// rejected acquisition leaves them unchanged. No pointer may escape.
/// Calls must be fully applied inside unsafe. Separate buffers are independent;
/// aliased borrows return Err. The copy is of the text prefix, not capacity.
pub let with_text[T] (buffer: Buffer) (operation: (RawCStr, Int) -> Result[T, String]): Result[(T, String), String] = unsafe {
    let raw = plum_buffer_acquire(Buffer.raw(buffer), 2);
    if raw == -1 || raw == -2 { Err(error("NativeBuffer.with_text", raw)) }
    else {
        let lease = Lease.from_raw(raw);
        let pointer = plum_buffer_data(Lease.raw(lease));
        let cap = plum_buffer_capacity(Lease.raw(lease));
        match operation(pointer, cap) {
            Err(e) => Err(e),
            Ok(value) => {
                let n = plum_buffer_text_length(Lease.raw(lease));
                if n < 0 { Err(error("NativeBuffer.with_text", -1)) }
                else { match Bytes.from_cstr(pointer, n).as_string() {
                    Err(e) => Err(e),
                    Ok(text) => match checked("NativeBuffer.with_text", plum_buffer_commit(Lease.raw(lease), n)) {
                        Err(e) => Err(e), Ok(_) => Ok((value, text)),
                    },
                } }
            },
        }
    }
}

/// Separate native payload accounting under --memory-stats. Requests count
/// successful creation/growth; allocated_capacity sums requested capacities.
/// Live/peak capacity excludes metadata, allocator rounding, other native/GPU
/// allocations and allocator-internal realloc overlap. Memory.snapshot counts
/// the small Plum handle/lease cells separately. Snapshot records allocate
/// Plum cells after freezing these native fields.
pub struct Snapshot {
    pub allocations: Int,
    pub allocated_capacity: Int,
    pub live_buffers: Int,
    pub live_capacity: Int,
    pub peak_buffers: Int,
    pub peak_capacity: Int,
}

/// One coherent native-buffer snapshot, or None when diagnostics are disabled.
/// Frozen fields are thread-local; reading one does not allocate native storage.
pub let snapshot (): Option[Snapshot] = unsafe {
    let token = plum_buffer_snapshot();
    if token == 0 { None }
    else {
        let allocations = plum_buffer_snapshot_field(token, 0);
        let allocated_capacity = plum_buffer_snapshot_field(token, 1);
        let live_buffers = plum_buffer_snapshot_field(token, 2);
        let live_capacity = plum_buffer_snapshot_field(token, 3);
        let peak_buffers = plum_buffer_snapshot_field(token, 4);
        let peak_capacity = plum_buffer_snapshot_field(token, 5);
        Some(Snapshot { allocations: allocations, allocated_capacity: allocated_capacity,
            live_buffers: live_buffers, live_capacity: live_capacity,
            peak_buffers: peak_buffers, peak_capacity: peak_capacity })
    }
}
