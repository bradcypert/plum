/// Filesystem and self-location. These replaced shelling out to
/// `mktemp -d`, `rm -rf`, `rm -f`, `cp -r` and `mkdir`, and reading
/// `/proc/self/exe`. See `native_stdlib/os_shim.c`.
///
/// The `..._raw` forms are runtime primitives whose Plum bodies
/// exist only to give the checker a signature. They travel with the
/// module: `cg_runtime_fn` keys on the bare name and does not care
/// which module the call was written in.
let os_temp_dir_raw (ignored: Bool): String = ""
let os_self_exe_raw (ignored: Bool): String = ""
let os_make_dir_raw (path: String): Int = 0
let os_remove_file_raw (path: String): Int = 0
let os_rename_file_raw (from: String) (to: String): Int = 0
let os_remove_tree_raw (path: String): Int = 0
let os_copy_tree_raw (src: String) (dst: String): Int = 0
let os_platform_raw (ignored: Bool): String = ""

/// Which platform this program is running on: "linux", "macos" or
/// "windows". Compiled in, not detected at runtime; a binary
/// cannot move between platforms, so there is nothing to detect.
pub let platform (): String = os_platform_raw(true)

/// A fresh, empty, private directory. The caller owns it and is
/// responsible for `Os.remove_tree` on it.
pub let temp_dir (): Result[String, String] = {
    let d = os_temp_dir_raw(true);
    if String.is_empty(d) { Err("Os.temp_dir: could not create a temporary directory") }
    else { Ok(d) }
}

/// The path of the running executable, for a program that needs to
/// re-invoke itself.
pub let self_exe (): Result[String, String] = {
    let p = os_self_exe_raw(true);
    if String.is_empty(p) { Err("Os.self_exe: could not determine the executable path") }
    else { Ok(p) }
}

/// Creates one directory. The PARENT must already exist; this makes a
/// single level, not a path.
///
/// `Err` when the parent is missing, when the name is taken by a file,
/// or when permission is refused. A directory that already exists is
/// also an `Err`, so a caller who does not care should check
/// `Os.exists` first.
pub let make_dir (path: String): Result[Unit, String] =
    if os_make_dir_raw(path) == 0 { Ok(()) }
    else { Err("Os.make_dir: could not create ".concat(path)) }

/// Atomic within one filesystem, and an error rather than a silent
/// copy across two. The point is that the destination is never a
/// half-written file.
pub let rename_file (from: String) (to: String): Result[Unit, String] =
    if os_rename_file_raw(from, to) == 0 { Ok(()) }
    else { Err("Os.rename_file: could not rename ".concat(from).concat(" to ").concat(to)) }

/// Deletes a file. `Err` when it is not there, when it is a directory,
/// or when permission is refused — `Os.remove_tree` is the one for
/// directories.
pub let remove_file (path: String): Result[Unit, String] =
    if os_remove_file_raw(path) == 0 { Ok(()) }
    else { Err("Os.remove_file: could not remove ".concat(path)) }

/// Deletes a directory and everything under it. Symlinks are removed,
/// never followed into.
pub let remove_tree (path: String): Result[Unit, String] =
    if os_remove_tree_raw(path) == 0 { Ok(()) }
    else { Err("Os.remove_tree: could not remove ".concat(path)) }

/// Copies the CONTENTS of `src` into `dst`, which must already exist
/// the semantics of `cp -r src/. dst`. File modes are not
/// preserved.
pub let copy_tree (src: String) (dst: String): Result[Unit, String] =
    if os_copy_tree_raw(src, dst) == 0 { Ok(()) }
    else { Err("Os.copy_tree: could not copy ".concat(src).concat(" to ").concat(dst)) }

// --- Environment and process ---
//
// Folded in from the flat prelude in 0.0.9. `Os` already owned the
// filesystem calls that shell out to `os_shim.c`, so putting
// `read_file` in a separate `Fs` would have split the filesystem
// across two modules. This is the shape Go settled on -- `os.ReadFile`,
// `os.Getenv`, `os.Exit`, `os.MkdirAll` in one place, with `net`
// separate and string helpers on the type.

let exit_raw (code: Int): Bool = false
let env_var_raw (name: String): Array[String] = []

/// Exit with a status code, printing nothing. `panic_raw` also exits
/// non-zero but prints its message first, which is wrong when the
/// report has already been written.
pub let exit_with (code: Int): Unit = { exit_raw(code); () }

/// `env_var_raw` returns an ARRAY, empty when unset, matching
/// `read_file_raw`: hand-written runtime IR cannot construct an
/// `Option` without hard-coding tag numbers the backend assigns per
/// program, so the wrapping happens here where `Some`/`None` are
/// ordinary variants.
pub let env_var (name: String): Option[String] = {
    let r = env_var_raw(name);
    if Array.is_empty(r) { None } else { Some(r[0]) }
}

// --- Whole-file I/O ---

let read_file_raw (path: String): Array[String] = []
let write_file_raw (path: String) (contents: String): Bool = false

/// Reads a whole file as text.
///
/// `Err` when the file is missing, unreadable, or not valid UTF-8. Use
/// `Os.read_bytes` for a file that is not text, or that might not be.
pub let read_file (path: String): Result[String, String] = {
    let r = read_file_raw(path);
    if Array.is_empty(r) { Err("could not read ".concat(path)) } else { Ok(r[0]) }
}

/// Writes text to a file, creating it or REPLACING what was there.
///
/// The parent directory must exist. Nothing is written on failure, so
/// a full disk leaves the old contents rather than a truncated file.
pub let write_file (path: String) (contents: String): Result[Unit, String] =
    if write_file_raw(path, contents) { Ok(()) } else { Err("could not write ".concat(path)) }

/// --- Whole-file BINARY I/O ---
///
/// The `String` pair above keeps its contract exactly: it is the text
/// convenience, and a program that wants text should keep using it.
/// These are for the payloads a `String` cannot honestly describe --
/// images, compressed data, anything with an embedded NUL or a byte
/// that is not valid UTF-8.
///
/// The runtime half needed almost nothing: `read_file_raw` already
/// reads with `fread` and the file's real size, and `write_file_raw`
/// already writes with `fwrite` and the cell's stored length, so
/// neither has ever stopped at a NUL. What was missing was a TYPE
/// that promised as much. `Os.read_file` returning a `String` is a
/// claim about encoding that a JPEG does not satisfy, and
/// byte-indexed operations to do anything with the result.
///
/// `read_file_bytes_raw` returns an ARRAY for the same reason its
/// String twin does: hand-written runtime IR cannot construct a
/// `Result` without hard-coding tag numbers the backend assigns per
/// program, so the wrapping happens here.
let read_file_bytes_raw (path: String): Array[Bytes] = []
let write_file_bytes_raw (path: String) (contents: Bytes): Bool = false
let append_file_bytes_raw (path: String) (contents: Bytes): Bool = false

/// An empty file reads back as empty `Bytes`, NOT as an error, because the
/// array is empty only when the file could not be opened at all, so
/// "no such file" and "a file with nothing in it" stay distinct.
pub let read_bytes (path: String): Result[Bytes, String] = {
    let r = read_file_bytes_raw(path);
    if Array.is_empty(r) { Err("could not read ".concat(path)) } else { Ok(r[0]) }
}

/// Writes bytes to a file, creating it or REPLACING what was there.
///
/// The `Bytes` counterpart to `Os.write_file`: use this for anything
/// that is not text, and for text you have already encoded.
pub let write_bytes (path: String) (data: Bytes): Result[Unit, String] =
    if write_file_bytes_raw(path, data) { Ok(()) } else { Err("could not write ".concat(path)) }

/// Creates the file when it does not exist, the way `>>` does.
pub let append_bytes (path: String) (data: Bytes): Result[Unit, String] =
    if append_file_bytes_raw(path, data) { Ok(()) } else { Err("could not append to ".concat(path)) }

// --- Streaming file I/O ---
//
// The whole-file calls above are the convenience: one call, no
// handle, no cleanup to think about. These are for the cases a
// whole-file read cannot serve -- a file too big to hold, a stream
// consumed as it arrives, an append-only log kept open.
//
// `File` is a `handle` (issue #9), so an open file CLOSES ITSELF
// when the value dies. `File.close` is still offered, and still
// returns a `Result`, because closing can fail -- a buffered write
// is flushed by `fclose`, and that is exactly when a full disk is
// discovered. So: call `close` when the error matters, and rely on
// the handle when it does not. Neither leaks.
//
// Closing twice is fine and is the NORMAL path, since the handle
// runs after an explicit close. `native_stdlib/file_shim.c` owns a
// slot table precisely so the second one is harmless.
extern "C" {
    fn file_open(path: CStr, mode: Int) -> Int;
    fn file_close(h: Int);
    fn file_close_checked(h: Int) -> Int;
    fn file_read_n(h: Int, max_len: Int) -> Int;
    fn file_read_data() -> CStr;
    fn file_write(h: Int, buf: CStr, len: Int) -> Int;
    fn file_seek(h: Int, offset: Int, whence: Int) -> Int;
    fn file_flush(h: Int) -> Int;
}

/// An open file. **Closed when this value dies**, including on a
/// panic, so a file opened in a scope needs no cleanup.
///
/// `File.close` is still offered and still returns a `Result`, because
/// closing can fail: a buffered write is flushed by the close, and that
/// is exactly when a full disk is discovered. Call it when that error
/// matters; rely on the handle when it does not. Closing twice is
/// harmless.
pub handle File { on_drop: file_close }

/// How to open. A closed set, passed as small integers across the
/// extern boundary; an extern taking a mode STRING would let a
/// caller hand `fopen` anything at all.
pub enum Mode { Read, Write, Append }

/// Where a seek measures from.
pub enum Seek { Start, Current, End }

let mode_code (m: Mode): Int = match m { Read => 0, Write => 1, Append => 2 }
let seek_code (s: Seek): Int = match s { Start => 0, Current => 1, End => 2 }

/// `Write` truncates an existing file; `Append` does not. Both create
/// one that is not there, and `Read` does not.
pub let open (path: String) (mode: Mode): Result[File, String] = unsafe {
    let h = file_open(path.as_cstr(), mode_code(mode));
    if h < 0 { Err("Os.open: could not open ".concat(path)) } else { Ok(File.from_raw(h)) }
}

/// Up to `max_len` bytes. An empty result is END OF FILE, not a
/// failure: the same three-way split `Net.read_bytes` makes, and
/// for the same reason: a reader looping until the end needs to tell
/// "nothing left" from "something broke".
pub let File.read (f: File) (max_len: Int): Result[Bytes, String] = unsafe {
    let n = file_read_n(File.raw(f), max_len);
    if n < 0 { Err("File.read: read failed") }
    else { Ok(Bytes.from_cstr(file_read_data(), n)) }
}

/// `len` MUST be bound BEFORE `.as_cstr()` runs, the same ordering
/// `Net.write` spells out: the pointer is an interior one into the
/// cell, and reading `.len()` afterwards in the same argument list is
/// how that bug was found on the wire the first time.
pub let File.write (f: File) (data: Bytes): Result[Int, String] = unsafe {
    let len = data.len();
    let n = file_write(File.raw(f), data.as_cstr(), len);
    if n < 0 { Err("File.write: write failed") } else { Ok(n) }
}

/// The new absolute position.
pub let File.seek (f: File) (offset: Int) (from: Seek): Result[Int, String] = unsafe {
    let p = file_seek(File.raw(f), offset, seek_code(from));
    if p < 0 { Err("File.seek: seek failed") } else { Ok(p) }
}

/// Makes buffered writes visible without giving up the handle.
pub let File.flush (f: File): Result[Unit, String] = unsafe {
    if file_flush(File.raw(f)) == 0 { Ok(()) } else { Err("File.flush: flush failed") }
}

/// Closing is OPTIONAL: the handle closes the file when it dies. Call
/// this when a failed final flush is something the program should
/// react to rather than lose. Calling it twice, or letting the handle
/// run afterwards, is harmless.
pub let File.close (f: File): Result[Unit, String] = unsafe {
    if file_close_checked(File.raw(f)) == 0 { Ok(()) } else { Err("File.close: close failed") }
}

// --- Running a program ---
//
// `process_run_raw` takes its arguments TAB-joined in a single string
// because an extern boundary has no `Array[String]` -- see
// `native_stdlib/process_shim.c`. The join happens here rather than in
// the runtime, where it would have to be written in IR.

let process_run_raw (program: String) (args_joined: String) (argc: Int): Int = 0
let process_exit_code_raw (handle: Int): Int = 0
let process_stdout_raw (handle: Int): String = ""
let process_stderr_raw (handle: Int): String = ""
let process_free_raw (handle: Int): Bool = false

/// What a finished process left behind.
///
/// `exit_code` is the child's own status: a non-zero one is an ordinary
/// result, not an error. Failing to START the process is the `Err`.
/// What a finished process left behind.
///
/// `exit_code` is the child's own status: a non-zero one is an ordinary
/// result, not an error. Failing to START the process is the `Err`.
pub struct ProcessResult { pub exit_code: Int, pub stdout: String, pub stderr: String }

/// NO leading separator: `process_run` points argv[1] at the WHOLE
/// joined string, so a leading tab makes argv[1] empty and pushes the
/// last real argument past `argc`, silently dropping it. A plain fold
/// that prefixes every element is NOT equivalent.
let join_args_acc (args: Array[String]) (i: Int) (acc: String): String =
    if i >= args.len() { acc }
    else if i == 0 { join_args_acc(args, i + 1, args[i]) }
    else { join_args_acc(args, i + 1, acc.concat("\t").concat(args[i])) }

/// A non-zero exit code is an ordinary `Ok`. `Err` means the process
/// could not be started at all.
pub let run_process (program: String) (args: Array[String]): Result[ProcessResult, String] = {
    let joined = join_args_acc(args, 0, "");
    let handle = process_run_raw(program, joined, args.len());
    if handle < 0 { Err("Os.run_process: could not start process: ".concat(program)) }
    else {
        let result = ProcessResult {
            exit_code: process_exit_code_raw(handle),
            stdout: process_stdout_raw(handle),
            stderr: process_stderr_raw(handle),
        };
        let freed = process_free_raw(handle);
        Ok(result)
    }
}

// --- Process identity ---
//
// argv, the working directory, stdin and stderr. `args()` has
// always existed as a compiler builtin and is documented now;
// the rest was reachable only through the private C shims the
// language server uses.
extern "C" {
    fn os_cwd() -> CStr;
    fn os_chdir(path: CStr) -> Int;
    fn stdin_line_n() -> Int;
    fn stdin_line_data() -> CStr;
    fn stdin_bytes_n(max: Int) -> Int;
    fn stdin_bytes_data() -> CStr;
    fn stdin_line_timed(timeout_nanos: Int) -> Int;
    fn stdin_bytes_timed(max: Int, timeout_nanos: Int) -> Int;
    fn stderr_write(s: CStr) -> Unit;
}

/// The process's current working directory, as an absolute path.
pub let cwd (): Result[String, String] = unsafe {
    let d = os_cwd().as_string();
    if String.is_empty(d) { Err("Os.cwd: could not determine the working directory") } else { Ok(d) }
}

/// Changes the process's working directory.
///
/// Affects the WHOLE process, including every relative path used
/// afterwards and every child it spawns — so a library that changes it
/// and does not change it back has altered something its caller never
/// agreed to.
pub let chdir (path: String): Result[Unit, String] = unsafe {
    if os_chdir(path.as_cstr()) == 0 { Ok(()) } else { Err("Os.chdir: could not change directory to ".concat(path)) }
}

/// `$HOME`, or `%USERPROFILE%` on Windows. `None` when it is unset --
/// no guessing from a username, because a guess that is usually right
/// is the worst kind of wrong for a path a program is about to write
/// to.
pub let home_dir (): Option[String] =
    if platform() == "windows" { env_var("USERPROFILE") } else { env_var("HOME") }

/// --- Standard input and error ---
///
/// `None` is END OF STREAM and `Some("")` is a blank line, and
/// keeping those apart is the whole reason these exist. The shims the
/// language server uses return `""` for both, so a filter reading
/// until end of input would stop at the first blank line, which is wrong in a
/// way that only shows up on real data.
///
/// The line arrives WITHOUT its newline, and a final line with no
/// trailing newline is an ordinary line rather than something to drop.
pub let read_stdin_line (): Result[Option[String], String] = unsafe {
    let n = stdin_line_n();
    if n < 0 { Ok(None) }
    else { match Bytes.from_cstr(stdin_line_data(), n).as_string() {
        Ok(text) => Ok(Some(text)),
        Err(e) => Err("Os.read_stdin_line: ".concat(e)),
    } }
}

/// Up to `max` bytes, as `Bytes`. Stdin carries whatever was piped
/// into it, which is not always text. An EMPTY result is end of
/// stream; a SHORT one is data, because a pipe hands over what it has
/// rather than waiting to fill a buffer.
///
/// The bytes are copied into a Plum value before this returns, so the
/// result stays valid across later reads; the shim's own buffer is
/// reused and would not.
pub let read_stdin (max_len: Int): Result[Bytes, String] = unsafe {
    let n = stdin_bytes_n(max_len);
    if n < 0 { Err("Os.read_stdin: read failed") } else { Ok(Bytes.from_cstr(stdin_bytes_data(), n)) }
}

/// Writes to standard error and flushes. NOT `println`, which is
/// stdout, since a diagnostic that lands in the same stream as the
/// program's output cannot be separated from it by whoever is reading.
/// No trailing newline is added; say so if you want one.
pub let write_stderr (s: String): Unit = unsafe { stderr_write(s.as_cstr()); () }

/// --- Reading with a deadline (issue #7) ---
///
/// Three outcomes, and `Option` has already spent itself on two of
/// them: `read_stdin_line` uses `None` for end of stream, which is the
/// distinction the whole function exists for. A timed read has to say
/// "a line", "the input ended" or "nothing arrived in time", so it says
/// so in a type with three names rather than nesting two `Option`s and
/// asking the reader to remember which is which.
pub enum Input[T] { Got(T), Eof, TimedOut }

/// The timeout bounds the WHOLE CALL, not just the wait for the first
/// byte, so a slow writer cannot leave a caller blocked mid-line past
/// its deadline. Bytes already read are kept, so `TimedOut` is never
/// data loss: calling again resumes where this stopped.
pub let read_stdin_line_timeout (d: Time.Duration): Result[Input[String], String] = unsafe {
    let n = stdin_line_timed(d.as_nanos());
    if n == 0 - 2 { Ok(TimedOut) }
    else if n < 0 { Ok(Eof) }
    else { match Bytes.from_cstr(stdin_line_data(), n).as_string() {
        Ok(text) => Ok(Got(text)),
        Err(e) => Err("Os.read_stdin_line_timeout: ".concat(e)),
    } }
}

/// Up to `max_len` bytes, with the same three outcomes. A SHORT read is
/// `Got`, not `TimedOut`: a pipe handing over what it has is data
/// arriving, not a deadline passing.
pub let read_stdin_timeout (max_len: Int) (d: Time.Duration): Result[Input[Bytes], String] = unsafe {
    let n = stdin_bytes_timed(max_len, d.as_nanos());
    if n == 0 - 2 { Ok(TimedOut) }
    else if n < 0 { Ok(Eof) }
    else { Ok(Got(Bytes.from_cstr(stdin_bytes_data(), n))) }
}

// --- File metadata ---
//
// The rest of `stat(2)`. `is_directory` below was the first caller
// of it and keeps its own wrapper; these are the other fields.
//
// Loaded once and read field by field, so `Os.stat` costs ONE
// `stat` rather than one per field -- Plum's extern surface has no
// multi-value return, the same constraint `File.read` works around
// the same way.
extern "C" {
    fn os_stat_load(path: CStr) -> Int;
    fn os_stat_size() -> Int;
    fn os_stat_mtime() -> Int;
    fn os_stat_is_dir() -> Int;
    fn os_path_exists(path: CStr) -> Int;
}

/// No `exists` field: a path that is not there is an `Err`, so a
/// `Metadata` in hand always describes something real. That is the
/// contract `is_directory` already set, and having one of these
/// answer `exists: false` while the other errored would be two
/// answers to one question.
pub struct Metadata { pub is_directory: Bool, pub size: Int, pub mtime: Int }

/// Three-way underneath, and the third case is why this returns a
/// `Result` rather than a `Bool`: "does this exist" and "can I see
/// whether this exists" are different questions. A permission error
/// is an `Err`, not a silent `Ok(false)`.
///
/// This is the ONE function here where a missing path is `Ok`, and
/// deliberately so; it is the function whose whole job is to say
/// so.
pub let exists (path: String): Result[Bool, String] = unsafe {
    let r = os_path_exists(path.as_cstr());
    if r < 0 { Err("Os.exists: cannot determine whether ".concat(path).concat(" exists")) }
    else { Ok(r == 1) }
}

/// A missing path is an `Err`, matching `is_directory`.
pub let stat (path: String): Result[Metadata, String] = unsafe {
    if os_stat_load(path.as_cstr()) != 0 { Err("Os.stat: cannot stat ".concat(path)) }
    else { Ok(Metadata { is_directory: os_stat_is_dir() == 1, size: os_stat_size(), mtime: os_stat_mtime() }) }
}

/// Bytes. Meaningful for a regular file; for a directory it is
/// whatever the filesystem records for the directory itself, which
/// is not the size of its contents.
pub let file_size (path: String): Result[Int, String] = Result.map(stat(path), |m| m.size)

/// Seconds since the Unix epoch, the same unit as `Time.now()`, so
/// the two can be compared without a conversion.
pub let mtime (path: String): Result[Int, String] = Result.map(stat(path), |m| m.mtime)

// --- Directory access ---
//
// `is_directory`'s three-way result is deliberate: a path that does
// not exist is a real `Err`, not silently `Ok(false)`.

let path_is_dir_raw (path: String): Int = 0
let dir_open_handle (path: String): Int = 0
let dir_next_entry (handle: Int): String = ""
let dir_close_handle (handle: Int): Unit = ()

let dir_read_all_acc (handle: Int) (acc: Array[String]): Array[String] = {
    let name = dir_next_entry(handle);
    if String.is_empty(name) { acc } else { dir_read_all_acc(handle, acc.push(name)) }
}

/// Lists a directory's entries by NAME, without `.` or `..`, in
/// whatever order the filesystem gives.
///
/// Names, not paths: join them onto the directory with `Path.join` to
/// get something you can open.
pub let list_dir (path: String): Result[Array[String], String] = {
    let handle = dir_open_handle(path);
    if handle < 0 { Err("Os.list_dir: could not open directory: ".concat(path)) }
    else {
        let entries = dir_read_all_acc(handle, []);
        dir_close_handle(handle);
        Ok(entries)
    }
}

/// Whether the path is a directory. `Ok(false)` for a file, and for
/// something that is not there at all — use `Os.exists` to tell those
/// apart.
pub let is_directory (path: String): Result[Bool, String] = {
    let r = path_is_dir_raw(path);
    if r < 0 { Err("Os.is_directory: path does not exist: ".concat(path)) }
    else { Ok(r == 1) }
}
