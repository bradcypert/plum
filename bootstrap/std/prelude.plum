// i traverses the borrowed prefix [0, n); no optional byte cell is needed.
let plum__string_hash_acc (b: Bytes) (i: Int) (n: Int) (h: Int): Int =
    if i >= n { h & 9223372036854775807 }
    else {
        plum__string_hash_acc(b, i + 1, n, Int.wrapping_mul(h ^ bytes_at_raw(b, i), 1099511628211))
    }

/// A hash of the string's bytes, for bucketing.
///
/// Not stable across releases and not cryptographic — do not persist
/// it, and do not use it for anything security-related.
///
/// Borrows input and allocates no temporary storage while hashing.
///
/// FNV-1a, kept in Plum now that `Int.wrapping_mul` can express its
/// modulo-2^64 multiply. The final sign-bit mask is required: `Map`
/// uses the result with `%`, which needs a non-negative index.
pub let String.hash (s: String): Int = {
    let b = s.as_bytes();
    plum__string_hash_acc(b, 0, b.len(), -3750763034362895579)
}

/// Whether a one-character string is an ASCII space, tab, newline or
/// carriage return. Unicode spaces are not included.
pub let String.is_ascii_ws (c: String): Bool = c == " " || c == "\t" || c == "\n" || c == "\r"

// KMP failure links: the longest proper prefix that is also a suffix
// of the bytes matched so far. Following a link never advances the
// input, and never repeats comparisons for a discarded prefix.
let plum__string_search_fallback
    (needle: Bytes)
    (links: Array[Int])
    (matched: Int)
    (byte: Int): Int
=
    if matched > 0 && bytes_at_raw(needle, matched) != byte {
        plum__string_search_fallback(needle, links, links[matched - 1], byte)
    } else { matched }

// The table has exactly one entry per byte of a nonempty needle.
let plum__string_search_links (needle: Bytes): Array[Int] = {
    let n = bytes_len_raw(needle);
    let mut links: Array[Int] = plum__array_reserve_empty_raw(n);
    links = links.push(0);
    let mut matched = 0;
    for i in 1..n {
        let byte = bytes_at_raw(needle, i);
        let prefix = plum__string_search_fallback(needle, links, matched, byte);
        matched = if bytes_at_raw(needle, prefix) == byte { prefix + 1 } else { 0 };
        links = links.push(matched);
    };
    links
}

let plum__string_search_bytes
    (s: Bytes)
    (needle: Bytes)
    (links: Array[Int])
    (i: Int)
    (matched: Int): Int
=
    if i >= bytes_len_raw(s) { -1 }
    else {
        let byte = bytes_at_raw(s, i);
        let prefix = plum__string_search_fallback(needle, links, matched, byte);
        let next = if bytes_at_raw(needle, prefix) == byte { prefix + 1 } else { 0 };
        if next == bytes_len_raw(needle) { i + 1 - next }
        else { plum__string_search_bytes(s, needle, links, i + 1, next) }
    }

// Count non-continuation bytes in a borrowed UTF-8 prefix. Shared by
// character counts and the conversion of search offsets to codepoints.
let plum__string_count_starts (s: Bytes) (end: Int) (i: Int) (count: Int): Int =
    if i >= end { count }
    else {
        let byte = bytes_at_raw(s, i);
        plum__string_count_starts(
            s,
            end,
            i + 1,
            count + if byte < 128 || byte >= 192 { 1 } else { 0 }
        )
    }

// A fixed bound keeps this search linear without needing a prefix table.
let plum__string_find_short_raw (s: Bytes) (needle: Bytes): Int = -1

/// The CHARACTER index where `needle` first appears, or `None`.
/// An empty needle matches at zero. Search takes linear time in the UTF-8
/// byte lengths and borrows the input text. Short needles need no scratch
/// storage. Longer needles use one exact-sized prefix table.
pub let String.index_of (s: String) (needle: String): Option[Int] =
    if needle.len() == 0 { Some(0) }
    else if needle.len() > s.len() { None }
    else {
        let text = bytes_of_str_raw(s);
        let pattern = bytes_of_str_raw(needle);
        let offset = if bytes_len_raw(pattern) <= 8 {
            plum__string_find_short_raw(text, pattern)
        } else {
            let links = plum__string_search_links(pattern);
            plum__string_search_bytes(text, pattern, links, 0, 0)
        };
        if offset < 0 { None } else { Some(plum__string_count_starts(text, offset, 0, 0)) }
    }

/// --- Namespaced forms of the string METHODS ---
///
/// `.len()`, `.split()`, `.replace()` and friends are compiler
/// PRIMITIVES lowered straight to IR, so they existed only as
/// methods, while `String.slice`/`index_of`/`lines`/`repeat`/
/// `trim_start`/`trim_end` are ordinary prelude functions and so
/// existed only namespaced. That split tracks how each one happens
/// to be implemented, which is invisible from outside and produced
/// a genuinely confusing surface: `"x".trim()` worked and
/// `String.trim("x")` did not, while `String.trim_start("x")`
/// worked and `"x".trim_start()` did not. Same family, opposite
/// rules, no way to tell which without trying.
///
/// The rule now: `String.f(s, ..)` always works. Some also have
/// method sugar. These wrappers cost nothing when unused --
/// dead-function elimination drops them.
/// The number of BYTES. `String.char_len` is the character count, and
/// the two differ for anything outside ASCII.
pub let String.len (s: String): Int = s.len()

/// Splits on every occurrence of `sep`.
///
/// A separator at either end produces an empty piece, so splitting
/// `\",a,\"` on `\",\"` gives three pieces. Splitting on an empty
/// separator gives the characters.
pub let String.split (s: String) (sep: String): Array[String] = s.split(sep)

/// Whether `needle` appears anywhere.
pub let String.contains (s: String) (needle: String): Bool = s.contains(needle)

/// Whether the string begins with `prefix`.
pub let String.starts_with (s: String) (prefix: String): Bool = s.starts_with(prefix)

/// Whether the string ends with `suffix`.
pub let String.ends_with (s: String) (suffix: String): Bool = s.ends_with(suffix)

/// Every occurrence of `from` replaced with `to`. An empty `from`
/// leaves the string alone rather than looping.
/// Unchanged nonempty results share the input cell. Uniquely owned storage
/// can be reused for equal-width replacements or when capacity fits the
/// changed result with little spare space. Other changed results allocate
/// exactly. Empty results use static storage.
pub let String.replace (s: String) (from: String) (to: String): String = s.replace(from, to)

/// Uppercased using the platform's one-codepoint Unicode mapping. This
/// does not perform multi-codepoint expansions (for example, ß to SS).
/// POSIX uses the initialized UTF-8 locale; Windows maps the BMP only
/// and leaves supplementary codepoints unchanged. Mappings can vary by OS.
/// Unchanged nonempty results share input storage. Changed results may reuse
/// uniquely owned storage when every mapped codepoint keeps its byte width;
/// otherwise they allocate exactly. Empty results use static storage.
pub let String.to_upper (s: String): String = s.to_upper()

/// Lowercased with the same platform mapping and storage rules as `String.to_upper`.
pub let String.to_lower (s: String): String = s.to_lower()

/// Whitespace removed from both ends, including Unicode spaces.
/// Unchanged input shares its storage. A shorter result can reuse compact,
/// uniquely owned storage or copy the retained UTF-8 bytes.
pub let String.trim (s: String): String = s.trim()

let bytes_of_str_raw (s: String): Bytes = bytes_of_str_raw(s)

let str_of_bytes_raw (b: Bytes): String = ""

let bytes_len_raw (b: Bytes): Int = 0

let bytes_at_raw (b: Bytes) (i: Int): Int = 0

let bytes_slice_raw (b: Bytes) (start: Int) (end: Int): Bytes = bytes_slice_raw(b, start, end)

let bytes_concat_raw (a: Bytes) (b: Bytes): Bytes = bytes_concat_raw(a, b)

let bytes_from_array_raw (xs: Array[Int]): Bytes = bytes_from_array_raw(xs)

/// No bytes.
pub let Bytes.empty (): Bytes = bytes_of_str_raw("")

/// How many bytes.
pub let Bytes.len (b: Bytes): Int = bytes_len_raw(b)

/// Whether there are no bytes.
pub let Bytes.is_empty (b: Bytes): Bool = bytes_len_raw(b) == 0

/// Free in both directions at runtime; the DIRECTION is what differs.
/// Every String is bytes, so this one is total.
/// The string's bytes, as UTF-8. No copy of the text is decoded, so
/// this is the cheap direction.
pub let String.as_bytes (s: String): Bytes = bytes_of_str_raw(s)

/// The string's UTF-8 bytes. The same as `String.as_bytes`, named for
/// a caller thinking in bytes.
pub let Bytes.from_string (s: String): Bytes = bytes_of_str_raw(s)

/// Not every Bytes is a String, so this one is not. This is the ONE
/// place the UTF-8 promise is established rather than assumed. The
/// reason the two types are distinct at all.
/// Written in Plum, not as a runtime primitive, because it needs
/// nothing the two byte primitives above do not already provide --
/// and this prelude's rule is that only what CANNOT be written here
/// goes into hand-written IR.
///
/// Full UTF-8, not just a lead-byte check: the ranges below reject
/// overlong encodings (C0/C1, and E0/F0 with a too-small second
/// byte), the UTF-16 surrogate block (ED A0..BF, which is why ED is
/// singled out), and anything past U+10FFFF (F5..FF, and F4 with a
/// second byte over 8F). A validator that only checked continuation
/// bytes would accept all four, and each one is a real way for a
/// decoder downstream to disagree about what this buffer says.
let plum__is_cont (b: Bytes) (i: Int): Bool = {
    let v = bytes_at_raw(b, i);
    v >= 128 && v <= 191
}

let plum__utf8_ok (b: Bytes) (i: Int) (n: Int): Bool =
    if i >= n { true }
    else {
        let c = bytes_at_raw(b, i);
        // ASCII.
        if c < 128 { plum__utf8_ok(b, i + 1, n) }
        // A continuation byte with no lead (80..BF), or an overlong
        // two-byte form (C0/C1).
        else if c < 194 { false }
        // Two bytes: C2..DF.
        else if c < 224 {
            if i + 1 >= n { false }
            else if !plum__is_cont(b, i + 1) { false }
            else { plum__utf8_ok(b, i + 2, n) }
        }
        // Three bytes: E0..EF. E0 must not be overlong (second byte
        // A0..BF) and ED must not encode a surrogate (second byte
        // 80..9F).
        else if c < 240 {
            if i + 2 >= n { false }
            else {
                let c1 = bytes_at_raw(b, i + 1);
                let lo = if c == 224 { 160 } else { 128 };
                let hi = if c == 237 { 159 } else { 191 };
                if c1 < lo || c1 > hi { false }
                else if !plum__is_cont(b, i + 2) { false }
                else { plum__utf8_ok(b, i + 3, n) }
            }
        }
        // Four bytes: F0..F4. F0 must not be overlong (second byte
        // 90..BF) and F4 must not exceed U+10FFFF (second byte
        // 80..8F).
        else if c < 245 {
            if i + 3 >= n { false }
            else {
                let c1 = bytes_at_raw(b, i + 1);
                let lo = if c == 240 { 144 } else { 128 };
                let hi = if c == 244 { 143 } else { 191 };
                if c1 < lo || c1 > hi { false }
                else if !plum__is_cont(b, i + 2) { false }
                else if !plum__is_cont(b, i + 3) { false }
                else { plum__utf8_ok(b, i + 4, n) }
            }
        }
        // F5..FF: past the end of the encodable range.
        else { false }
    }

/// Whether these bytes are valid UTF-8, without building a string.
pub let Bytes.is_utf8 (b: Bytes): Bool = plum__utf8_ok(b, 0, bytes_len_raw(b))

/// Decodes UTF-8 into a string.
///
/// `Err` when the bytes are not valid UTF-8 — which is why this is a
/// `Result` and `String.as_bytes` is not. Bytes arrive from files and
/// sockets, and not all of them are text.
pub let Bytes.as_string (b: Bytes): Result[String, String] =
    if Bytes.is_utf8(b) { Ok(str_of_bytes_raw(b)) }
    else { Err("Bytes.as_string: not valid UTF-8") }

/// BYTE indices, throughout. `Bytes.slice` can and will split a
/// multi-byte character in half, which is the operation `String`
/// deliberately does not offer, and the reason a program reaching for
/// bytes reached for them.
///
/// Clamped rather than aborting, matching `Array.slice`.
/// Bytes from `start` up to but not including `end`, with bounds
/// clamped. A slice can split a multi-byte character, so the result is
/// not guaranteed to be valid UTF-8.
/// Whole ranges share their owned storage; empty ranges use shared static
/// storage. Other ranges reuse compact uniquely owned storage when possible
/// or copy the selected bytes.
pub let Bytes.slice (b: Bytes) (start: Int) (end: Int): Bytes = {
    let n = bytes_len_raw(b);
    let lo = if start < 0 { 0 } else if start > n { n } else { start };
    let hi = if end < lo { lo } else if end > n { n } else { end };
    bytes_slice_raw(b, lo, hi)
}

/// The two runs of bytes, joined.
pub let Bytes.concat (a: Bytes) (b: Bytes): Bytes = bytes_concat_raw(a, b)

/// `None` rather than an abort for an out-of-range index: a byte
/// buffer is usually being walked by a parser that does not know how
/// long it is yet, and `Option` is how the rest of this prelude says
/// "nothing there" (`Array.first`, `Map.get`).
/// The byte at `i` as a number 0-255, or `None` when out of range.
pub let Bytes.at (b: Bytes) (i: Int): Option[Int] =
    if i < 0 { None } else if i >= bytes_len_raw(b) { None } else { Some(bytes_at_raw(b, i)) }

/// Each element is one byte, 0-255. Values outside that range are
/// masked to their low 8 bits rather than rejected. `from_array` is
/// a construction helper, and a `Result` here would put error handling
/// in front of every literal buffer.
/// Bytes from numbers. Values outside 0-255 are truncated to their
/// low eight bits.
pub let Bytes.from_array (xs: Array[Int]): Bytes = bytes_from_array_raw(xs)

/// The way back in from C, and the counterpart to `.as_cstr()`.
///
/// Takes an explicit LENGTH, which is the whole difference from
/// `RawCStr.as_string()`: that one stops at the first NUL because a
/// `char*` alone cannot say how long it is, and any C API returning
/// bytes has to hand back a count separately. Given the count, this
/// is binary-safe. Given a wrong one, it reads whatever is
/// next in memory, exactly as the equivalent C would.
///
/// COPIES into a fresh cell. C buffers are routinely static, reused
/// on the next call, or freed by the callee; the copy is what makes
/// the result an ordinary owned Plum value.
let bytes_from_cstr_raw (c: RawCStr) (len: Int): Bytes = unsafe { bytes_from_cstr_raw(c, len) }

/// Copies `len` bytes from a C pointer.
///
/// Requires an `unsafe` block and all arguments at the call site;
/// it cannot be used as a function value or partially applied.
/// For positive `len`, the caller must ensure `c` points to at least
/// `len` readable bytes that remain valid throughout the copy.
/// No pointer, lifetime, or allocation-bound validation is performed.
/// Nonpositive lengths return empty bytes without reading `c`.
/// The result owns a fresh copy, including any embedded NUL bytes;
/// the source is neither retained nor freed.
pub let Bytes.from_cstr (c: RawCStr) (len: Int): Bytes = unsafe {
    if len <= 0 { Bytes.empty() } else { bytes_from_cstr_raw(c, len) }
}

// Borrows b and returns independent owned Array[Int] storage.
let plum__bytes_to_array_raw (b: Bytes): Array[Int] = []

/// The bytes as numbers 0-255, using one exact-sized array allocation.
/// The result is independent of the input; empty results use static storage.
pub let Bytes.to_array (b: Bytes): Array[Int] = plum__bytes_to_array_raw(b)

/// Lowercase hex, two characters per byte, no separator.
///
/// This is what `.to_string()` would have to be if `Bytes` had one,
/// and the reason it does not: hex is A rendering, not THE rendering,
/// and picking it silently would make `.to_string()` mean something
/// different on this type than on every other. Named explicitly, the
/// caller decides.
let plum__hex_digit (v: Int): String =
    if v == 0 { "0" } else if v == 1 { "1" } else if v == 2 { "2" } else if v == 3 { "3" }
    else if v == 4 { "4" } else if v == 5 { "5" } else if v == 6 { "6" } else if v == 7 { "7" }
    else if v == 8 { "8" } else if v == 9 { "9" } else if v == 10 { "a" } else if v == 11 { "b" }
    else if v == 12 { "c" } else if v == 13 { "d" } else if v == 14 { "e" } else { "f" }

// Implemented by the generated runtime; borrows b and returns owned storage.
let plum__bytes_to_hex_raw (b: Bytes): String = ""

/// Lowercase hex, two characters per byte. `Encoding.hex_decode`
/// reads it back. A nonempty result uses one exact-sized allocation;
/// an empty result uses shared static storage.
pub let Bytes.to_hex (b: Bytes): String = plum__bytes_to_hex_raw(b)

// The runtime plans and fills a known-size result while borrowing all inputs.
let plum__string_join_raw (parts: Array[String]) (sep: String): String = ""

/// Joins parts in order with `sep` between adjacent entries. Empty parts
/// still contribute separator boundaries.
///
/// Shares a compact part or separator when it supplies every output byte.
/// Copies other nonempty results into exact-sized storage. Empty output
/// uses shared static storage.
pub let Array.join (parts: Array[String]) (sep: String): String = plum__string_join_raw(parts, sep)

/// Int's minimum, which CANNOT be written as a literal: its
/// magnitude is out of range as a positive number, so the lexer
/// rejects `9223372036854775808` before any sign is applied.
let plum__int_min (u: Unit): Int = 0 - 9223372036854775807 - 1

// chars_of groups following continuation bytes with the preceding byte,
// even for unsafe raw Strings. Only accept a sign/digit as a one-byte unit.
let plum__string_parse_int_acc
    (s: String)
    (bytes: Bytes)
    (n: Int)
    (i: Int)
    (acc: Int)
    (any: Bool)
    (negative: Bool): Result[Int, String]
=
    if i >= n { if any { Ok(acc) } else { Err("expected at least one digit") } }
    else {
        let byte = bytes_at_raw(bytes, i);
        if byte < 48 || byte > 57 || (i + 1 < n && plum__is_cont(bytes, i + 1)) {
            // Accepted prefix units are single ASCII bytes, so i is also
            // the character index here. Reuse String.slice's grouping for
            // the first rejected unit instead of adding another decoder.
            Err("expected a digit, found ".concat(String.slice(s, i, i + 1)))
        } else {
            let digit = byte - 48;
            // Check range before checked multiplication/addition. Negative
            // accumulation represents Int::MIN without negating its magnitude.
            if negative {
                if acc < 0 - 922337203685477580 { Err("integer out of range") }
                else if acc * 10 < plum__int_min(()) + digit { Err("integer out of range") }
                else {
                    plum__string_parse_int_acc(s, bytes, n, i + 1, acc * 10 - digit, true, negative)
                }
            } else if acc > 922337203685477580 { Err("integer out of range") }
            else if acc * 10 > 9223372036854775807 - digit { Err("integer out of range") }
            else {
                plum__string_parse_int_acc(s, bytes, n, i + 1, acc * 10 + digit, true, negative)
            }
        }
    }

/// Parses a decimal integer, with an optional leading `-`.
///
/// `Err` on anything else, including an empty string, surrounding
/// spaces, and a number too large for an `Int`. No `0x` or `0b`
/// prefixes — this is the inverse of `to_string`, not a literal
/// parser. Scans ASCII digits directly without a character array;
/// the first invalid character keeps the existing diagnostic.
pub let String.parse_int (s: String): Result[Int, String] = {
    let bytes = bytes_of_str_raw(s);
    let n = bytes_len_raw(bytes);
    if n == 0 { Err("empty string") } else {
        let negative = bytes_at_raw(bytes, 0) == 45 && (n == 1 || !plum__is_cont(bytes, 1));
        plum__string_parse_int_acc(s, bytes, n, if negative { 1 } else { 0 }, 0, false, negative)
    }
}

/// `String.parse_float` DELEGATES to the JSON number parser below,
/// exactly as the real prelude does.
///
/// It used to have a hand-written parser here, on the reasoning that
/// dragging a JSON parser in to read a float would be absurd. That
/// reasoning cost twice. The hand-written version accumulated the
/// fraction digit by digit against a repeatedly-divided 0.1, so
/// `0.000001` parsed as 1.0000000000000002e-06, invisible until
/// floats started printing every digit that matters. And its own
/// comment admitted the second cost: "no exponent, which is a real
/// narrowing, stated rather than discovered". Stated, but it made
/// the two compilers DISAGREE. `String.parse_float("1e3")` gave
/// 1000 under the real compiler and an error here.
///
/// The JSON parser was already in this same prelude, already
/// handling exponents, already correct. Reusing it is not absurd;
/// writing a second one was.
/// Overflow returns `Err`; underflow follows binary64 rounding to a
/// subnormal value or signed zero.
pub let String.parse_float (s: String): Result[Float, String] = {
    let cs = bytes_of_str_raw(s);
    match parse_number(cs, 0) {
        Ok(r) => if r.next_pos == bytes_len_raw(cs) { Ok(r.value) } else {
            Err("trailing characters after number")
        },
        Err(e) => Err(e),
    }
}

// --- Sorting ---

// Merge into a fresh, uniquely owned accumulator reserved for the run.
// Tail calls move it into the next push. Taking the left element on
// equality preserves the original order of ties.
let plum__array_sort_merge_acc[T]
    (left: Array[T])
    (right: Array[T])
    (le: (T, T) -> Bool)
    (i: Int)
    (j: Int)
    (acc: Array[T]): Array[T]
=
    if i >= left.len() {
        if j >= right.len() { acc }
        else { plum__array_sort_merge_acc(left, right, le, i, j + 1, acc.push(right[j])) }
    } else if j >= right.len() {
        plum__array_sort_merge_acc(left, right, le, i + 1, j, acc.push(left[i]))
    } else if le(left[i], right[j]) {
        plum__array_sort_merge_acc(left, right, le, i + 1, j, acc.push(left[i]))
    } else {
        plum__array_sort_merge_acc(left, right, le, i, j + 1, acc.push(right[j]))
    }

// Split index ranges rather than copying slices of the input. Only
// the sorted runs and merge output allocate, with O(n) peak storage
// and O(log n) stack depth for the recursive splits.
let plum__array_sort_range[T] (arr: Array[T]) (le: (T, T) -> Bool) (lo: Int) (hi: Int): Array[T] = {
    let len = hi - lo;
    if len <= 0 { [] }
    else if len == 1 { [arr[lo]] }
    else if len == 2 {
        let left = arr[lo];
        let right = arr[lo + 1];
        if le(left, right) { [left, right] } else { [right, left] }
    } else {
        let mid = lo + len / 2;
        let left = plum__array_sort_range(arr, le, lo, mid);
        let right = plum__array_sort_range(arr, le, mid, hi);
        plum__array_sort_merge_acc(left, right, le, 0, 0, plum__array_reserve_empty_raw(len))
    }
}

/// Sorted by a \"less than or equal\" predicate.
///
/// STABLE: elements `le` considers equivalent keep their original
/// order, which is what makes sorting by one key and then another
/// produce the ordering people expect.
///
/// Merge sort with O(n log n) comparisons and O(n) auxiliary storage.
pub let Array.sort_by[T] (arr: Array[T]) (le: (T, T) -> Bool): Array[T] =
    plum__array_sort_range(arr, le, 0, arr.len())

/// Sorted ascending.
pub let Array.sort_int (arr: Array[Int]): Array[Int] = Array.sort_by(arr, |a: Int, b: Int| a <= b)

/// Sorted ascending. NaN does not compare, so an array containing one
/// has no meaningful order.
pub let Array.sort_float (arr: Array[Float]): Array[Float] =
    Array.sort_by(arr, |a: Float, b: Float| a <= b)

// `Array.sort_string` is deliberately ABSENT: the real prelude compares
// via `a.runes()`, and this compiler has no `.runes()` primitive. It
// belongs with `Float.sqrt` and friends -- the group that needs a
// runtime primitive rather than prelude source -- not here.

// --- Zip ---

/// A named struct, not a tuple, exactly as the real prelude has it.
pub struct Zipped[A, B] { pub first: A, pub second: B }

// The current compiler lowers this private traversal to an exact-sized
// array and a paired fill. The source body supports older bootstrap compilers.
let plum__array_zip_with_raw[T, U, V]
    (a: Array[T])
    (b: Array[U])
    (pair: (T, U) -> V): Array[V]
= {
    let mut out = [];
    for i in 0..Int.min(a.len(), b.len()) {
        out = out.push(pair(a[i], b[i]));
    };
    out
}

/// Pairs elements positionally, stopping at the shorter array.
pub let Array.zip[T, U] (a: Array[T]) (b: Array[U]): Array[Zipped[T, U]] =
    plum__array_zip_with_raw(a, b, |first, second| Zipped { first: first, second: second })

// --- String trimming ---

let plum__string_trim_start_raw (s: String): String = ""

let plum__string_trim_end_raw (s: String): String = ""

/// Whitespace removed from the start, using the same Unicode whitespace
/// predicate and storage rules as String.trim. Empty results use shared
/// static storage.
pub let String.trim_start (s: String): String = plum__string_trim_start_raw(s)

/// Whitespace removed from the end, using the same Unicode whitespace
/// predicate and storage rules as String.trim. Empty results use shared
/// static storage.
pub let String.trim_end (s: String): String = plum__string_trim_end_raw(s)

/// Split on newlines.
///
/// A trailing newline produces a final empty piece, since the text
/// after it is empty — which is what makes joining the result back
/// with newlines give the original.
pub let String.lines (s: String): Array[String] = s.split("\n")

// --- Numbers that need the runtime ---

/// The real prelude writes these as `unsafe { fabs(x) }`,
/// `unsafe { sqrt(x) }` and friends.
/// This backend has no `extern "C"`/`unsafe` support, so they reach the
/// same libm functions as runtime primitives instead.
let abs_raw (x: Float): Float = 0.0

let sqrt_raw (x: Float): Float = 0.0

let pow_raw (b: Float) (e: Float): Float = 0.0

let floor_raw (x: Float): Float = 0.0

let ceil_raw (x: Float): Float = 0.0

let round_raw (x: Float): Float = 0.0

let sin_raw (x: Float): Float = 0.0

let cos_raw (x: Float): Float = 0.0

let tan_raw (x: Float): Float = 0.0

let asin_raw (x: Float): Float = 0.0

let acos_raw (x: Float): Float = 0.0

let atan_raw (x: Float): Float = 0.0

let atan2_raw (y: Float) (x: Float): Float = 0.0

let log_raw (x: Float): Float = 0.0

let log2_raw (x: Float): Float = 0.0

let log10_raw (x: Float): Float = 0.0

let exp_raw (x: Float): Float = 0.0

let float_fixed_raw (x: Float) (decimals: Int): String = ""

let random_raw (ignored: Bool): Float = 0.0

/// The square root. Negative input gives NaN rather than failing.
pub let Float.sqrt (x: Float): Float = sqrt_raw(x)

/// `base` raised to `exp`. A fractional exponent of a negative base
/// gives NaN.
pub let Float.pow (base: Float) (exp: Float): Float = pow_raw(base, exp)

/// The largest whole number no greater than `x` — toward negative
/// infinity, so `floor(-2.5)` is `-3.0`.
pub let Float.floor (x: Float): Float = floor_raw(x)

/// The smallest whole number no less than `x`.
pub let Float.ceil (x: Float): Float = ceil_raw(x)

/// The nearest whole number, halves AWAY FROM ZERO: `round(2.5)` is
/// `3.0` and `round(-2.5)` is `-3.0`.
///
/// `Float.to_fixed` rounds halves to EVEN, which is not an
/// inconsistency — it is what C, Python, Rust and Java all do, because
/// rounding is arithmetic and formatting is rendering.
pub let Float.round (x: Float): Float = round_raw(x)

/// A float in `[0.0, 1.0)` from a process-wide generator seeded from
/// the clock.
///
/// Different every run, and NOT reproducible. `Rng.from_seed` is the
/// one for a test or a replay.
pub let Float.random (): Float = random_raw(true)

/// A float in `[lo, hi)`, from the same unseeded generator as
/// `Float.random`.
pub let Float.random_range (lo: Float) (hi: Float): Float = lo + (hi - lo) * Float.random(())

/// --- Trigonometry, logs and constants (issue #20) ---
///
/// Angles are RADIANS everywhere, which is what libm takes and what the
/// inverse functions return. `Float.radians` and `Float.degrees` convert
/// at the edges, so a program that thinks in degrees converts once
/// rather than scattering `* 3.14159 / 180.0`.
/// Sine of an angle in RADIANS.
pub let Float.sin (x: Float): Float = sin_raw(x)

/// Cosine of an angle in radians.
pub let Float.cos (x: Float): Float = cos_raw(x)

/// Tangent of an angle in radians. Grows without bound near odd
/// multiples of pi/2 rather than failing.
pub let Float.tan (x: Float): Float = tan_raw(x)

/// The angle in radians whose sine is `x`, in `[-pi/2, pi/2]`. NaN
/// outside `[-1, 1]`.
pub let Float.asin (x: Float): Float = asin_raw(x)

/// The angle in radians whose cosine is `x`, in `[0, pi]`. NaN
/// outside `[-1, 1]`.
pub let Float.acos (x: Float): Float = acos_raw(x)

/// The angle in radians whose tangent is `x`. `Float.atan2` is the
/// one that knows which quadrant.
pub let Float.atan (x: Float): Float = atan_raw(x)

/// `atan2(y, x)`, in that order, matching libm, Go, Python
/// and Java all use, and the reason it exists: it knows which QUADRANT
/// the point is in, which `atan(y / x)` cannot, and it does not divide
/// by zero when `x` is 0.
pub let Float.atan2 (y: Float) (x: Float): Float = atan2_raw(y, x)

/// Natural log. `log2` and `log10` are separate rather than
/// `log(x) / log(2.0)`, because libm computes them directly and the
/// division loses accuracy at exactly the powers people check.
/// The natural logarithm. NaN for a negative argument, and negative
/// infinity at zero.
pub let Float.log (x: Float): Float = log_raw(x)

/// Base-2 logarithm, computed directly rather than as a division —
/// which is what keeps `log2(8.0)` exactly `3.0`.
pub let Float.log2 (x: Float): Float = log2_raw(x)

/// Base-10 logarithm, computed directly. See `Float.log2`.
pub let Float.log10 (x: Float): Float = log10_raw(x)

/// `e` raised to `x`.
pub let Float.exp (x: Float): Float = exp_raw(x)

/// Constants as FUNCTIONS, because `Float.` is a type namespace and
/// `T.f(x)` is how a name gets into it. Written out to the last digit a
/// double can hold rather than computed, so they are exact literals and
/// not a rounding of something else.
/// Pi, to the last digit a double holds.
pub let Float.pi (): Float = 3.141592653589793

/// Two pi — a full turn, which is the more useful constant when
/// working with angles.
pub let Float.tau (): Float = 6.283185307179586

/// Euler's number.
pub let Float.e (): Float = 2.718281828459045

/// Degrees to radians. Every trigonometric function here takes
/// radians, so this is the conversion at the edge.
pub let Float.radians (degrees: Float): Float = degrees * 3.141592653589793 / 180.0

/// Radians to degrees.
pub let Float.degrees (radians: Float): Float = radians * 180.0 / 3.141592653589793

/// --- Seeded, reproducible random numbers (issue #20) ---
///
/// `Float.random` reads a process-global generator seeded from the
/// clock, which is right for "give me something different each run" and
/// useless for a test or a replay. An `Rng` is a VALUE: same seed, same
/// sequence, on every platform and every run.
///
/// Every call returns the NEXT GENERATOR alongside the number, rather
/// than mutating in place, so a generator is as ordinary a value as an
/// `Int`. Threading it by hand is the cost; being able to replay a game
/// from a seed, or write a test that cannot flake, is what it buys. A
/// `Ref[Rng]` is the opt-in for in-place update.
///
/// --- Which generator, and why ---
///
/// SplitMix64: a small, modern 64-bit generator with a full 2^64
/// period. It is fast, has excellent bit diffusion, and is the right
/// generator when reproducibility and simple state matter more than
/// cryptographic secrecy. The wrapping multiply and logical shifts it
/// needs became expressible when `Int.wrapping_mul` and bitwise
/// operators landed.
///
/// **Not for cryptography, keys, tokens or passwords.** It is a
/// statistical generator and its entire state is recoverable from two
/// outputs.
pub struct Rng { state: Int }

let RNG_GAMMA: Int = -7046029254386353131

let RNG_MIX_1: Int = -4658895280553007687

let RNG_MIX_2: Int = -7723592293110705685

let RNG_RANGE: Int = 9223372036854775807

/// Any `Int` is a legal seed, including zero and negatives. SplitMix64
/// has no forbidden state, unlike generators whose all-zero state gets
/// stuck, so the seed is kept exactly rather than folded into a range.
pub let Rng.from_seed (seed: Int): Rng = Rng { state: seed }

let plum__mod_floor (a: Int) (m: Int): Int = {
    let r = a - (a / m) * m;
    if r < 0 { r + m } else { r }
}

/// The raw step: advance by SplitMix64's golden-ratio increment, then
/// mix all 64 bits. Keep the sign bit here: wide integer ranges need
/// the full signed domain. Each caller reduces the output as needed.
let rng_advance (state: Int): Int = Int.wrapping_add(state, RNG_GAMMA)

let rng_mix (state: Int): Int = {
    let z1 = Int.wrapping_mul(state ^ Int.shr_logical(state, 30), RNG_MIX_1);
    let z2 = Int.wrapping_mul(z1 ^ Int.shr_logical(z1, 27), RNG_MIX_2);
    z2 ^ Int.shr_logical(z2, 31)
}

let rng_step (r: Rng): (Rng, Int) = {
    let next = rng_advance(r.state);
    (Rng { state: next }, rng_mix(next))
}

/// A `Float` in `[0.0, 1.0)`. Use 53 exactly representable bits so
/// converting to `Float` cannot round the largest sample up to `1.0`.
/// The generator advances exactly once, as for previous versions;
/// float samples may differ because the discarded low bits no longer round.
pub let Rng.float (r: Rng): (Rng, Float) = {
    let (next, z) = rng_step(r);
    (next, Int.shr_logical(z & RNG_RANGE, 10).to_float() / 9007199254740992.0)
}

/// A float in `[lo, hi)`, and the next generator.
pub let Rng.float_range (r: Rng) (lo: Float) (hi: Float): (Rng, Float) = {
    let (next, f) = Rng.float(r);
    (next, lo + (hi - lo) * f)
}

/// `[lo, hi)`, the upper bound EXCLUDED, so `int_range(r, 0, xs.len())`
/// is an index into `xs` and needs no `- 1` anywhere.
/// All ordered `Int` bounds are supported, even when `hi - lo` would
/// overflow. `hi` must itself be an `Int`, so the maximum `Int` cannot
/// be included as a result of this half-open API.
///
/// Rejection sampling, not `z % span`. The modulo is biased whenever the
/// span does not divide the generator's range evenly: the low values
/// come up more often, by about one part in `range / span`. That is
/// invisible in a game and fatal in a shuffle, and the loop costs an
/// extra step only on the fraction of draws that land in the leftover
/// tail. Widths through the maximum `Int` preserve their seeded sequences.
/// Wider ranges reject full signed samples outside `[lo, hi)` instead;
/// they accept at least half of the domain, averaging at most two draws.
///
/// An empty or backwards range returns `lo` and does not draw, because
/// there is no number to return and a panic here would make an ordinary
/// off-by-one crash a program at random.
pub let Rng.int_range (r: Rng) (lo: Int) (hi: Int): (Rng, Int) = {
    if hi <= lo { (r, lo) } else {
        let span = Int.wrapping_sub(hi, lo);
        if span < 0 { rng_wide(r, lo, hi) } else { rng_below(r, span, lo) }
    }
}

// Tail recursion keeps retries in constant stack space. No span or
// offset arithmetic is needed for ranges at least 2^63 wide.
let rng_wide (r: Rng) (lo: Int) (hi: Int): (Rng, Int) = {
    let (next, z) = rng_step(r);
    if z < lo || z >= hi { rng_wide(next, lo, hi) } else { (next, z) }
}

let rng_below_limit (span: Int): Int = RNG_RANGE - plum__mod_floor(RNG_RANGE, span)

let rng_nonnegative_sample (state: Int): Int = rng_mix(state) & RNG_RANGE

// Return the accepted state alone. The caller can mix it again without
// allocating a tuple for each draw or each retry.
let rng_below_state (state: Int) (limit: Int): Int = {
    let next = rng_advance(state);
    if rng_nonnegative_sample(next) >= limit { rng_below_state(next, limit) } else { next }
}

let rng_below (r: Rng) (span: Int) (lo: Int): (Rng, Int) = {
    let next = rng_below_state(r.state, rng_below_limit(span));
    (Rng { state: next }, lo + plum__mod_floor(rng_nonnegative_sample(next), span))
}

/// A boolean, evenly, and the next generator.
pub let Rng.bool (r: Rng): (Rng, Bool) = {
    let (next, v) = Rng.int_range(r, 0, 2);
    (next, v == 1)
}

/// Fisher-Yates, walking from the end so every permutation is equally
/// likely. The naive version, swapping each element with any other, is
/// not uniform, and looks fine until somebody counts.
pub let Rng.shuffle[T] (r: Rng) (xs: Array[T]): (Rng, Array[T]) = {
    let last = xs.len() - 1;
    if last <= 0 { (r, xs) } else { rng_shuffle_acc(r.state, xs, last) }
}

let rng_shuffle_acc[T] (state: Int) (xs: Array[T]) (i: Int): (Rng, Array[T]) =
    if i <= 0 { (Rng { state }, xs) } else {
        let span = i + 1;
        let next = rng_below_state(state, rng_below_limit(span));
        let j = plum__mod_floor(rng_nonnegative_sample(next), span);
        rng_shuffle_acc(next, plum__array_swap_raw(xs, i, j), i - 1)
    }

let plum__array_swap_raw[T] (xs: Array[T]) (i: Int) (j: Int): Array[T] =
    if i == j { xs } else {
        let a = xs[i];
        let b = xs[j];
        xs.set(i, b).set(j, a)
    }

/// One element, or `None` from an empty array.
pub let Rng.choice[T] (r: Rng) (xs: Array[T]): (Rng, Option[T]) =
    if Array.is_empty(xs) { (r, None) } else {
        let (next, i) = Rng.int_range(r, 0, xs.len());
        (next, Some(xs[i]))
    }

// --- String ordering ---

/// Byte-lexicographic, which for UTF-8 IS codepoint order, so this
/// agrees with the real prelude's rune-by-rune comparison without
/// needing a `.runes()` decoder.
let string_concat_all_raw (parts: Array[String]): String = ""

/// Concatenates parts in order, without a separator. The compiler's own
/// emitter uses this for collected output fragments.
///
/// Uses checked sizes and shares a single compact part when it supplies
/// every output byte. Other nonempty results use exact-sized storage.
/// Empty output uses shared static storage.
pub let Array.concat_all (parts: Array[String]): String = string_concat_all_raw(parts)

/// Decimal text to the NEAREST double, via libc `strtod`.
///
/// `parse_number` below validates the grammar and finds where the
/// number ends, and that part was always right. What it got wrong was
/// the VALUE: building it as `mantissa * 10^exp` in floating point
/// accumulates rounding error, so `9.21258e-07` parsed to a double
/// one ulp away and `parse_float(x.to_string()) != x`. `to_string`
/// goes to real lengths to guarantee that round trip, retrying
/// at 15, 16 and 17 digits until `strtod` agrees, so the inverse
/// has to be the same `strtod`, not an approximation of it.
///
/// Found by a property test on 2026-08-25. The Rust interpreter
/// computed the identical wrong double, so `interp-check` agreed
/// with it and saw nothing.
let parse_float_raw (s: String): Float = 0.0

let string_cmp_raw (a: String) (b: String): Int = 0

/// Sorted by BYTE order, not by any locale's alphabet — so uppercase
/// sorts before lowercase, and accented letters sort after `z`.
pub let Array.sort_string (arr: Array[String]): Array[String] =
    Array.sort_by(arr, |a: String, b: String| a <= b)

// --- Assertions ---
//
// Mirrored from the real prelude, message for message: a test that
// fails should read the same whichever compiler ran it.

/// Stops the program unless `cond` holds.
///
/// For a condition the code depends on, not for input validation:
/// there is no way to catch this.
pub let assert (cond: Bool): Unit =
    if cond { () } else { panic_raw("assertion failed") }

/// Stops the program unless the two are equal, printing BOTH — which
/// is the difference from `assert(a == b)` and the reason to prefer
/// it in a test.
pub let assert_eq[T] (a: T) (b: T): Unit =
    if a == b { () } else {
        panic_raw(
            "assertion failed: left != right\n  left:  ".concat(a.to_string()).concat("\n  right: ")
                .concat(b.to_string())
        )
    }

/// Stops the program if the two are equal, printing them.
pub let assert_ne[T] (a: T) (b: T): Unit =
    if a != b { () } else {
        panic_raw(
            "assertion failed: left == right\n  left:  ".concat(a.to_string()).concat("\n  right: ")
                .concat(b.to_string())
        )
    }

// --- Collections: Map and Set ---

/// One key and value stored in a map collision bucket.
pub struct MapEntry[K, V] { key: K, value: V }

// Single entries live directly in leaves. Only equal complete hashes need
// a collision array. Branch arrays are bounded by the bitmap's 32 slots.
enum MapNode[K, V] {
    MapEmpty,
    MapLeaf(Int, K, V),
    MapCollision(Int, Array[MapEntry[K, V]]),
    MapBranch(Int, Array[MapNode[K, V]]),
}

/// A hash map from `K` to `V`.
///
/// PERSISTENT: `Map.insert` returns a new map and leaves the original
/// alone, so a map can be shared without copying defensively. Keys
/// need `Eq` and `Hash`. Equal keys hash identically.
/// NaN is not a supported key, including inside aggregates, because
/// IEEE equality makes it unequal to itself. References use identity.
pub struct Map[K, V] { root: MapNode[K, V], size: Int }

let value_hash[T: Hash] (x: T): Int = x.hash()

let map_bit (hash: Int) (shift: Int): Int = 1 << (Int.shr_logical(hash, shift) & 31)

let map_rank (bits: Int) (bit: Int): Int = Int.count_ones(bits & (bit - 1))

let map_bucket_find_index[K: Eq, V] (bucket: Array[MapEntry[K, V]]) (k: K) (i: Int): Int =
    if i >= bucket.len() { -1 }
    else if bucket[i].key == k { i }
    else { map_bucket_find_index(bucket, k, i + 1) }

// Joining distinct complete hashes must diverge before all hash bits are
// consumed. Keeping this separate also handles a collision node as a child.
let map_join[K, V]
    (a: MapNode[K, V])
    (ah: Int)
    (b: MapNode[K, V])
    (bh: Int)
    (shift: Int): MapNode[K, V]
= {
    let abit = map_bit(ah, shift);
    let bbit = map_bit(bh, shift);
    if abit == bbit { MapBranch(abit, [map_join(a, ah, b, bh, shift + 5)]) }
    else if abit < bbit { MapBranch(abit | bbit, [a, b]) }
    else { MapBranch(abit | bbit, [b, a]) }
}

// The compiler lowers this to the consuming array growth path plus a
// suffix shift. The source body supports older bootstrap compilers.
let plum__array_insert_raw[T] (xs: Array[T]) (at: Int) (value: T): Array[T] = {
    let mut out = [];
    for i in 0..xs.len() {
        if i == at {
            out = out.push(value);
        };
        out = out.push(xs[i]);
    };
    if at == xs.len() {
        out = out.push(value);
    };
    out
}

// Trie buffers can release excess capacity after deletion. The source body
// supports older bootstrap compilers.
let plum__array_remove_compact_raw[T] (xs: Array[T]) (at: Int): Array[T] = xs.remove(at)

// Pass callback arguments directly so the recursive update needs neither
// a captured closure nor a boxed context at each level of the trie.
let plum__array_update_raw[T, A, B, C, D, E]
    (xs: Array[T])
    (at: Int)
    (a: A)
    (b: B)
    (c: C)
    (d: D)
    (e: E)
    (update: (T, A, B, C, D, E) -> T): Array[T]
= xs.set(at, update(xs[at], a, b, c, d, e))

// Pass context without a closure per child array. The source body
// supports older bootstrap compilers.
let plum__array_fold_context_raw[T, A, B, C, D]
    (xs: Array[T])
    (init: A)
    (b: B)
    (c: C)
    (d: D)
    (step: (A, T, B, C, D) -> A): A
= Array.fold(xs, init, |acc, item| step(acc, item, b, c, d))

let map_node_get[K: Eq, V] (node: MapNode[K, V]) (hash: Int) (key: K) (shift: Int): Option[V] =
    match node {
        MapEmpty => None,
        MapLeaf(h, k, v) => if h == hash && k == key { Some(v) } else { None },
        MapCollision(h, entries) => if h != hash { None } else {
            let i = map_bucket_find_index(entries, key, 0);
            if i < 0 { None } else { Some(entries[i].value) }
        },
        MapBranch(bits, children) => {
            let bit = map_bit(hash, shift);
            if (bits & bit) == 0 { None }
            else { map_node_get(children[map_rank(bits, bit)], hash, key, shift + 5) }
        },
    }

// Presence checks must not allocate an Option or retain a stored value.
let map_node_contains[K: Eq, V] (node: MapNode[K, V]) (hash: Int) (key: K) (shift: Int): Bool =
    match node {
        MapEmpty => false,
        MapLeaf(h, k, _) => h == hash && k == key,
        MapCollision(h, entries) => h == hash && map_bucket_find_index(entries, key, 0) >= 0,
        MapBranch(bits, children) => {
            let bit = map_bit(hash, shift);
            (bits & bit) != 0
                && map_node_contains(children[map_rank(bits, bit)], hash, key, shift + 5)
        },
    }

// The new entry needs its own cell. Keep the collision node's reset token
// in the caller so it can rebuild the node at its original size.
let map_bucket_append[K, V]
    (entries: Array[MapEntry[K, V]])
    (key: K)
    (value: V): Array[MapEntry[K, V]]
= entries.push(MapEntry { key: key, value: value })

let map_node_put[K, V]
    (node: MapNode[K, V])
    (hash: Int)
    (key: K)
    (value: V)
    (position: Int)
    (shift: Int): MapNode[K, V]
= match node {
    MapEmpty => MapLeaf(hash, key, value),
    MapLeaf(h, k, v) => if h != hash { map_join(node, h, MapLeaf(hash, key, value), hash, shift) }
    else if position < 0 { MapLeaf(hash, key, value) }
    else {
        MapCollision(hash, [MapEntry { key: k, value: v }, MapEntry { key: key, value: value }])
    },
    MapCollision(h, entries) => if h != hash {
        map_join(node, h, MapLeaf(hash, key, value), hash, shift)
    }
    else {
        MapCollision(
            hash,
            if position == 0 { map_bucket_append(entries, key, value) }
            else {
                plum__array_update_raw(
                    entries,
                    position - 1,
                    key,
                    value,
                    (),
                    (),
                    (),
                    |previous, k, v, unused1, unused2, unused3| MapEntry {
                        key: k,
                        value: v,
                        ..previous
                    }
                )
            }
        )
    },
    MapBranch(bits, children) => {
        let bit = map_bit(hash, shift);
        let i = map_rank(bits, bit);
        if (bits & bit) == 0 {
            MapBranch(bits | bit, plum__array_insert_raw(children, i, MapLeaf(hash, key, value)))
        }
        else {
            MapBranch(bits, plum__array_update_raw(
                children,
                i,
                hash,
                key,
                value,
                position,
                shift + 5,
                |child, h, k, v, at, next| map_node_put(child, h, k, v, at, next)
            ))
        }
    },
}

// Return -1 for a matching leaf, 0 on a miss, or a one-based collision
// position. The update can use this result without comparing the key again.
let map_node_key_position[K: Eq, V]
    (node: MapNode[K, V])
    (hash: Int)
    (key: K)
    (shift: Int): Int
= match node {
    MapEmpty => 0,
    MapLeaf(h, k, _) => if h == hash && k == key { -1 } else { 0 },
    MapCollision(h, entries) => if h == hash { map_bucket_find_index(entries, key, 0) + 1 } else {
        0
    },
    MapBranch(bits, children) => {
        let bit = map_bit(hash, shift);
        if (bits & bit) == 0 { 0 }
        else { map_node_key_position(children[map_rank(bits, bit)], hash, key, shift + 5) }
    },
}

// A unary branch can be dropped when removing a key leaves just one
// full hash. Follow the unary prefix to the first split.
let map_unary_survivor[K, V]
    (node: MapNode[K, V])
    (hash: Int)
    (shift: Int): MapNode[K, V]
= match node {
    MapBranch(bits, children) => if children.len() == 1 {
        map_unary_survivor(children[0], hash, shift + 5)
    } else if children.len() == 2 {
        let i = map_rank(bits, map_bit(hash, shift));
        match children[i] {
            MapLeaf(_, _, _) => {
                let sibling = children[1 - i];
                match sibling {
                    MapLeaf(_, _, _) | MapCollision(_, _) => sibling,
                    _ => MapEmpty,
                }
            },
            _ => MapEmpty,
        }
    } else { MapEmpty },
    _ => MapEmpty,
}

// The caller has proved the key exists. This lets the match release or
// reset the old node before handing its children into the update.
let map_node_remove_present[K, V]
    (node: MapNode[K, V])
    (hash: Int)
    (position: Int)
    (shift: Int)
    (probe_unary: Bool): MapNode[K, V]
= match node {
    MapEmpty => MapEmpty,
    MapLeaf(_, _, _) => MapEmpty,
    MapCollision(h, entries) => {
        let i = position - 1;
        if entries.len() == 2 {
            let survivor = entries[1 - i];
            MapLeaf(h, survivor.key, survivor.value)
        } else { MapCollision(h, plum__array_remove_compact_raw(entries, i)) }
    },
    MapBranch(bits, children) => {
        let unary = children.len() == 1;
        let survivor = if unary && probe_unary && position < 0 {
            map_unary_survivor(children[0], hash, shift + 5)
        }
        else { MapEmpty };
        let promote_unary = match survivor {
            MapEmpty => false,
            _ => true,
        };
        if promote_unary { survivor } else {
            let bit = map_bit(hash, shift);
            let i = map_rank(bits, bit);
            let leaf = match children[i] {
                MapLeaf(_, _, _) => true,
                _ => false,
            };
            // A branch or collision represents at least two entries. Only a
            // leaf child disappears when we remove a single key.
            if leaf {
                // Read a terminal survivor from the original array. A branch
                // survivor still needs the current level's shift.
                let promote = children.len() == 2 && match children[1 - i] {
                    MapLeaf(_, _, _) => true,
                    MapCollision(_, _) => true,
                    _ => false,
                };
                if promote { children[1 - i] }
                else { MapBranch(bits & ~bit, plum__array_remove_compact_raw(children, i)) }
            }
            else {
                let rest = plum__array_update_raw(
                    children,
                    i,
                    hash,
                    position,
                    shift + 5,
                    // A failed probe already covered the unary prefix.
                    !unary,
                    (),
                    |child, h, at, next, probe, unused| map_node_remove_present(
                        child,
                        h,
                        at,
                        next,
                        probe
                    )
                );
                // A recursive removal can turn the only child into a terminal.
                if unary {
                    match rest[0] {
                        MapLeaf(_, _, _) => rest[0],
                        MapCollision(_, _) => rest[0],
                        _ => MapBranch(bits, rest),
                    }
                } else { MapBranch(bits, rest) }
            }
        }
    },
}

/// An empty map.
pub let Map.new[K, V] (): Map[K, V] = Map { root: MapEmpty, size: 0 }

// Matching the wrapper lets Perceus reset it and pass the root to the
// trie update before rebuilding the wrapper. A shared map keeps its root.
let map_insert_hashed[K: Eq, V] (m: Map[K, V]) (hash: Int) (k: K) (v: V): Map[K, V] =
    match m {
        Map { root, size } => {
            let position = map_node_key_position(root, hash, k, 0);
            let added = if position == 0 { 1 } else { 0 };
            Map { root: map_node_put(root, hash, k, v, position, 0), size: size + added }
        },
    }

/// A NEW map with `k` set to `v`, replacing any previous value. The
/// original is unchanged. Only the affected trie path is rebuilt.
pub let Map.insert[K: Eq + Hash, V] (m: Map[K, V]) (k: K) (v: V): Map[K, V] =
    map_insert_hashed(m, value_hash(k), k, v)

/// The value for `k`, or `None`.
pub let Map.get[K: Eq + Hash, V] (m: Map[K, V]) (k: K): Option[V] =
    map_node_get(m.root, value_hash(k), k, 0)

/// Whether `k` has a value.
pub let Map.contains[K: Eq + Hash, V] (m: Map[K, V]) (k: K): Bool =
    map_node_contains(m.root, value_hash(k), k, 0)

// The caller supplies a leaf (-1) or a one-based collision position.
let map_remove_at[K, V] (m: Map[K, V]) (hash: Int) (position: Int): Map[K, V] =
    match m {
        Map { root, size } => if size == 1 { Map.new(()) } else {
            Map {
                root: map_node_remove_present(root, hash, position, 0, true),
                size: size - 1
            }
        },
    }

let map_remove_hashed[K: Eq, V] (m: Map[K, V]) (hash: Int) (k: K): Map[K, V] = {
    let position = map_node_key_position(m.root, hash, k, 0);
    if position == 0 { m } else { map_remove_at(m, hash, position) }
}

/// A new map without `k`. Removing an absent key is not an error.
pub let Map.remove[K: Eq + Hash, V] (m: Map[K, V]) (k: K): Map[K, V] =
    map_remove_hashed(m, value_hash(k), k)

/// How many entries.
pub let Map.len[K, V] (m: Map[K, V]): Int = m.size

// Reserve the known size of the result while keeping its initialized
// length at zero. Older compilers use ordinary array growth.
let plum__array_reserve_empty_raw[T] (capacity: Int): Array[T] = []

let map_node_collect[K, V, T]
    (node: MapNode[K, V])
    (acc: Array[T])
    (project: (K, V) -> T): Array[T]
= match node {
    MapEmpty => acc,
    MapLeaf(_, k, v) => acc.push(project(k, v)),
    MapCollision(_, entries) => plum__array_fold_context_raw(
        entries,
        acc,
        project,
        (),
        (),
        |out, entry, get, unused1, unused2| out.push(get(entry.key, entry.value))
    ),
    MapBranch(_, children) => map_collect_children(children, acc, project),
}

let map_collect_children[K, V, T]
    (children: Array[MapNode[K, V]])
    (acc: Array[T])
    (project: (K, V) -> T): Array[T]
= plum__array_fold_context_raw(
    children,
    acc,
    project,
    (),
    (),
    |out, child, get, unused1, unused2| map_node_collect(child, out, get)
)

let plum__array_map_exact_raw[T, U] (source: Array[T]) (project: (T) -> U): Array[U] =
    Array.map(source, project)

let map_project[K, V, T]
    (m: Map[K, V])
    (project: (K, V) -> T)
    (leaf_project: (MapNode[K, V]) -> T)
    (entry_project: (MapEntry[K, V]) -> T): Array[T]
= match m {
    Map { root, size } => match root {
        MapEmpty => [],
        MapLeaf(_, key, value) => [project(key, value)],
        MapCollision(_, entries) => plum__array_map_exact_raw(entries, entry_project),
        MapBranch(_, children) => {
            // Branch children are nonempty. One member per slot means they are leaves.
            if children.len() == size { plum__array_map_exact_raw(children, leaf_project) }
            else { map_collect_children(children, plum__array_reserve_empty_raw(size), project) }
        },
    },
}

let map_project_nonleaf[T] (): T = {
    panic_raw("flat map projection requires a leaf");
    let none: Array[T] = [];
    none[0]
}

/// Every key, in no particular order.
pub let Map.keys[K, V] (m: Map[K, V]): Array[K] = map_project(
    m,
    |k, v| k,
    |node| match node {
        MapLeaf(_, key, _) => key,
        _ => map_project_nonleaf(()),
    },
    |entry| entry.key
)

/// Every value, in the same order as `Map.keys`.
pub let Map.values[K, V] (m: Map[K, V]): Array[V] = map_project(
    m,
    |k, v| v,
    |node| match node {
        MapLeaf(_, _, value) => value,
        _ => map_project_nonleaf(()),
    },
    |entry| entry.value
)

// The compiler folds both arrays directly, transferring eligible slots.
// Older bootstrap compilers can read the same bounded prefix by index.
let plum__array_fold_pair_raw[T, U, A]
    (left: Array[T])
    (right: Array[U])
    (init: A)
    (step: (A, T, U) -> A): A
= {
    let mut out = init;
    for i in 0..Int.min(left.len(), right.len()) {
        out = step(out, left[i], right[i]);
    };
    out
}

/// A map from parallel arrays, stopping at the shorter. A repeated
/// key keeps the LAST value.
pub let Map.from_arrays[K: Eq + Hash, V] (keys: Array[K]) (values: Array[V]): Map[K, V] =
    plum__array_fold_pair_raw(
        keys,
        values,
        Map.new(()),
        |acc, key, value| Map.insert(acc, key, value)
    )

/// A set of `T`, persistent like `Map` — `Set.insert` returns a new
/// set. Members need `Eq` and `Hash`. Equal keys hash identically.
/// NaN is not a supported key, including inside aggregates, because
/// IEEE equality makes it unequal to itself. References use identity.
pub struct Set[T] { inner: Map[T, Unit] }

// The compiler can hoist the complete literal, including the empty map.
/// An empty set.
pub let Set.new[T] (): Set[T] = Set { inner: Map { root: MapEmpty, size: 0 } }

/// A new set with `x` added. Adding a member twice changes nothing.
pub let Set.insert[T: Eq + Hash] (s: Set[T]) (x: T): Set[T] = match s {
    Set { inner } => Set { inner: Map.insert(inner, x, ()) },
}

/// Whether `x` is a member.
pub let Set.contains[T: Eq + Hash] (s: Set[T]) (x: T): Bool = Map.contains(s.inner, x)

let set_remove_hashed[T: Eq] (s: Set[T]) (hash: Int) (key: T): Set[T] = {
    let position = map_node_key_position(s.inner.root, hash, key, 0);
    if position == 0 { s }
    else if Set.len(s) == 1 { Set.new(()) }
    else {
        match s {
            Set { inner } => Set { inner: map_remove_at(inner, hash, position) },
        }
    }
}

/// A new set without `x`.
pub let Set.remove[T: Eq + Hash] (s: Set[T]) (x: T): Set[T] =
    set_remove_hashed(s, value_hash(x), x)

/// How many members.
pub let Set.len[T] (s: Set[T]): Int = Map.len(s.inner)

/// Every member, in no particular order.
pub let Set.to_array[T] (s: Set[T]): Array[T] = Map.keys(s.inner)

enum SetOperation {
    SetAll,
    SetAddMissing,
    SetErase
}

let set_insert_missing[T] (acc: Map[T, Unit]) (hash: Int) (key: T): Map[T, Unit] =
    match acc {
        Map { root, size } => Map { root: map_node_put(root, hash, key, (), 0, 0), size: size + 1 },
    }

let set_apply_key[T: Eq]
    (acc: Map[T, Unit])
    (operation: SetOperation)
    (hash: Int)
    (key: T): Map[T, Unit]
= match operation {
    SetAll => map_insert_hashed(acc, hash, key, ()),
    SetAddMissing => if map_node_contains(acc.root, hash, key, 0) { acc }
    else { set_insert_missing(acc, hash, key) },
    SetErase => map_remove_hashed(acc, hash, key),
}

// A terminal node stores the complete hash for every key it holds.
let set_collect[T: Eq]
    (node: MapNode[T, Unit])
    (acc: Map[T, Unit])
    (operation: SetOperation): Map[T, Unit]
= match node {
    MapEmpty => acc,
    MapLeaf(hash, key, _) => set_apply_key(acc, operation, hash, key),
    MapCollision(hash, entries) => plum__array_fold_context_raw(
        entries,
        acc,
        operation,
        hash,
        (),
        |out, entry, policy, h, unused| set_apply_key(out, policy, h, entry.key)
    ),
    MapBranch(_, children) => plum__array_fold_context_raw(
        children,
        acc,
        operation,
        (),
        (),
        |out, child, policy, unused1, unused2| set_collect(child, out, policy)
    ),
}

let set_root[T] (s: Set[T]): MapNode[T, Unit] =
    match s {
        Set { inner } => match inner {
            Map { root, size: _ } => root,
        },
    }

// A scan can prove no matches, record one match, or stop early.
enum SetKeyScan[T] {
    NoSetMatch,
    OneSetMatch(Int, T),
    StopSetScan
}

let set_note_match[T] (found: SetKeyScan[T]) (hash: Int) (detail: T): SetKeyScan[T] =
    match found {
        NoSetMatch => OneSetMatch(hash, detail),
        _ => StopSetScan,
    }

let set_bucket_coverage[T: Eq]
    (entries: Array[MapEntry[T, Unit]])
    (right: MapNode[T, Unit])
    (hash: Int)
    (shift: Int)
    (i: Int)
    (found: SetKeyScan[Int]): SetKeyScan[Int]
=
    if i >= entries.len() { found }
    else if map_node_contains(right, hash, entries[i].key, shift) {
        set_bucket_coverage(entries, right, hash, shift, i + 1, found)
    } else {
        match set_note_match(found, hash, i + 1) {
            StopSetScan => StopSetScan,
            next => set_bucket_coverage(entries, right, hash, shift, i + 1, next),
        }
    }

let set_children_coverage[T: Eq]
    (left: Array[MapNode[T, Unit]])
    (right: Array[MapNode[T, Unit]])
    (bits: Int)
    (right_bits: Int)
    (shift: Int)
    (i: Int)
    (found: SetKeyScan[Int]): SetKeyScan[Int]
=
    if bits == 0 { found }
    else {
        let bit = bits & - bits;
        let other = if (right_bits & bit) == 0 { MapEmpty }
        else { right[map_rank(right_bits, bit)] };
        match set_node_coverage(left[i], other, shift, found) {
            StopSetScan => StopSetScan,
            next => set_children_coverage(left, right, bits & ~bit, right_bits, shift, i + 1, next),
        }
    }

// A right terminal checks the complete hash, independent of branch shift.
let set_terminal_coverage[T: Eq]
    (left: Array[MapNode[T, Unit]])
    (right: MapNode[T, Unit])
    (i: Int)
    (found: SetKeyScan[Int]): SetKeyScan[Int]
=
    if i >= left.len() { found }
    else {
        match set_node_coverage(left[i], right, 0, found) {
            StopSetScan => StopSetScan,
            next => set_terminal_coverage(left, right, i + 1, next),
        }
    }

// Follow the left paths while aligning right branch slots at each shift.
// A right terminal can be checked at any shift using its complete hash.
// Record the left position so removal needs no second equality lookup.
let set_node_coverage[T: Eq]
    (left: MapNode[T, Unit])
    (right: MapNode[T, Unit])
    (shift: Int)
    (found: SetKeyScan[Int]): SetKeyScan[Int]
= match left {
    MapEmpty => found,
    MapLeaf(hash, key, _) => if map_node_contains(right, hash, key, shift) { found }
    else { set_note_match(found, hash, -1) },
    MapCollision(hash, entries) => match right {
        MapEmpty => StopSetScan,
        _ => set_bucket_coverage(entries, right, hash, shift, 0, found),
    },
    MapBranch(bits, children) => match right {
        MapEmpty => StopSetScan,
        MapBranch(right_bits, right_children) => set_children_coverage(
            children,
            right_children,
            bits,
            right_bits,
            shift + 5,
            0,
            found
        ),
        _ => set_terminal_coverage(children, right, 0, found),
    },
}

enum SetOverlapCheck {
    SharedMember,
    CollisionOrder
}

let set_bucket_overlap[T: Eq]
    (entries: Array[MapEntry[T, Unit]])
    (right: MapNode[T, Unit])
    (hash: Int)
    (i: Int)
    (found: SetKeyScan[T]): SetKeyScan[T]
=
    if i >= entries.len() { found }
    else {
        let key = entries[i].key;
        if map_node_contains(right, hash, key, 0) {
            match set_note_match(found, hash, key) {
                StopSetScan => StopSetScan,
                next => set_bucket_overlap(entries, right, hash, i + 1, next),
            }
        } else { set_bucket_overlap(entries, right, hash, i + 1, found) }
    }

let set_children_overlap[T: Eq]
    (left: Array[MapNode[T, Unit]])
    (right: Array[MapNode[T, Unit]])
    (left_bits: Int)
    (right_bits: Int)
    (common: Int)
    (shift: Int)
    (check: SetOverlapCheck)
    (found: SetKeyScan[T]): SetKeyScan[T]
= if common == 0 { found } else {
    let bit = common & - common;
    match set_nodes_overlap(
        left[map_rank(left_bits, bit)],
        right[map_rank(right_bits, bit)],
        shift,
        check,
        found
    ) {
        StopSetScan => StopSetScan,
        next => set_children_overlap(
            left,
            right,
            left_bits,
            right_bits,
            common & ~bit,
            shift,
            check,
            next
        ),
    }
}

// Only matching bitmap slots can lead to terminals with the same hash.
// Union checks whether changing the base can reorder colliding keys.
// Difference keeps one equal key and stops when it finds a second.
let set_nodes_overlap[T: Eq]
    (left: MapNode[T, Unit])
    (right: MapNode[T, Unit])
    (shift: Int)
    (check: SetOverlapCheck)
    (found: SetKeyScan[T]): SetKeyScan[T]
= match left {
    MapEmpty => found,
    MapBranch(left_bits, left_children) => match right {
        MapBranch(right_bits, right_children) => set_children_overlap(
            left_children,
            right_children,
            left_bits,
            right_bits,
            left_bits & right_bits,
            shift + 5,
            check,
            found
        ),
        _ => set_nodes_overlap(right, left, shift, check, found),
    },
    MapLeaf(hash, _, _) | MapCollision(hash, _) => match right {
        MapEmpty => found,
        MapLeaf(h, key, _) => if hash != h { found } else {
            match left {
                MapLeaf(_, k, _) => {
                    let equal = k == key;
                    match check {
                        SharedMember => if equal { set_note_match(found, hash, key) } else {
                            found
                        },
                        CollisionOrder => if equal { found } else { StopSetScan },
                    }
                },
                MapCollision(_, entries) => match check {
                    SharedMember => if map_bucket_find_index(entries, key, 0) >= 0 {
                        set_note_match(found, hash, key)
                    } else { found },
                    CollisionOrder => StopSetScan,
                },
                _ => found,
            }
        },
        MapCollision(h, entries) => if hash != h { found } else {
            match check {
                SharedMember => set_bucket_overlap(entries, left, h, 0, found),
                CollisionOrder => StopSetScan,
            }
        },
        MapBranch(bits, children) => {
            let bit = map_bit(hash, shift);
            if (bits & bit) == 0 { found }
            else { set_nodes_overlap(left, children[map_rank(bits, bit)], shift + 5, check, found) }
        },
    },
}

let set_preserves_union_order[T: Eq] (left: MapNode[T, Unit]) (right: MapNode[T, Unit]): Bool =
    match set_nodes_overlap(left, right, 0, CollisionOrder, NoSetMatch) {
        NoSetMatch => true,
        _ => false,
    }

// Separate bitmap slots contain different full hashes. Combine their
// packed child arrays without rebuilding either side's descendants.
let set_graft_children[T]
    (left_bits: Int)
    (left: Array[MapNode[T, Unit]])
    (right_bits: Int)
    (right: Array[MapNode[T, Unit]]): Array[MapNode[T, Unit]]
= if left_bits < (right_bits & - right_bits) { plum__array_concat_exact_raw(left, right) }
else if right_bits < (left_bits & - left_bits) { plum__array_concat_exact_raw(right, left) }
else {
    let mut slots = left_bits | right_bits;
    let mut right_destinations = 0;
    let size = left.len() + right.len();
    for i in 0..size {
        let bit = slots & - slots;
        slots = slots & (slots - 1);
        if (right_bits & bit) != 0 {
            right_destinations = right_destinations | (1 << i);
        };
    };
    plum__array_interleave_exact_raw(left, right, right_destinations)
}

// A successful graft keeps every key from both inputs. A shared full
// hash delegates to the normal union so collision order and equal-key
// representatives follow the existing policy.
let set_graft_union[T]
    (left: MapNode[T, Unit])
    (right: MapNode[T, Unit])
    (shift: Int): MapNode[T, Unit]
= match left {
    MapEmpty => MapEmpty,
    MapBranch(left_bits, left_children) => match right {
        MapBranch(right_bits, right_children) => if (left_bits & right_bits) == 0 {
            MapBranch(
                left_bits | right_bits,
                set_graft_children(left_bits, left_children, right_bits, right_children)
            )
        } else if left_bits == right_bits && left_children.len() == 1 {
            // The merged branch still needs this level's hash chunk.
            match set_graft_union(left_children[0], right_children[0], shift + 5) {
                MapEmpty => MapEmpty,
                child => MapBranch(left_bits, [child]),
            }
        } else { MapEmpty },
        MapLeaf(hash, _, _) | MapCollision(hash, _) => {
            let bit = map_bit(hash, shift);
            if (left_bits & bit) == 0 {
                let i = map_rank(left_bits, bit);
                MapBranch(left_bits | bit, plum__array_insert_raw(left_children, i, right))
            } else if left_bits == bit {
                match set_graft_union(left_children[0], right, shift + 5) {
                    MapEmpty => MapEmpty,
                    child => MapBranch(left_bits, [child]),
                }
            } else { MapEmpty }
        },
        MapEmpty => MapEmpty,
    },
    MapLeaf(hash, _, _) | MapCollision(hash, _) => match right {
        MapEmpty => MapEmpty,
        MapBranch(_, _) => set_graft_union(right, left, shift),
        MapLeaf(h, _, _) | MapCollision(h, _) => if hash != h {
            map_join(left, hash, right, h, shift)
        }
        else { MapEmpty },
    },
}

let set_union_by_insertion[T: Eq] (a: Set[T]) (b: Set[T]): Set[T] =
    if Set.len(b) <= Set.len(a)
        && set_preserves_union_order(b.inner.root, a.inner.root) {
            // Keep the left representative of an equal key, whichever
            // set supplies the accumulator.
            match a {
                Set { inner } => Set {
                    inner: set_collect(set_root(b), inner, SetAddMissing)
                },
            }
        }
    else {
        match b {
            Set { inner } => Set { inner: set_collect(set_root(a), inner, SetAll) },
        }
    }

// An edit carries the number of new keys contributed by the right input.
enum SetMergeEdit[T] {
    SetMergeKeep,
    SetMergeUpdated(MapNode[T, Unit], Int)
}

let set_merge_children[T: Eq]
    (left_bits: Int)
    (left: Array[MapNode[T, Unit]])
    (right_bits: Int)
    (right: Array[MapNode[T, Unit]])
    (shift: Int): SetMergeEdit[T]
= {
    let bits = left_bits | right_bits;
    let size = Int.count_ones(bits);
    let mut slots = bits;
    let mut left_index = 0;
    let mut right_index = 0;
    let mut changed = false;
    let mut added = 0;
    let mut children: Array[MapNode[T, Unit]] = [];
    for i in 0..size {
        let bit = slots & - slots;
        slots = slots & ~bit;
        let on_left = (left_bits & bit) != 0;
        let on_right = (right_bits & bit) != 0;
        let other = if !on_right { MapEmpty }
        else if !on_left {
            let child = right[right_index];
            added = added + set_count_node(child);
            child
        } else {
            match set_merge_union_node(left[left_index], right[right_index], shift) {
                SetMergeKeep => MapEmpty,
                SetMergeUpdated(child, count) => {
                    added = added + count;
                    child
                },
            }
        };
        match other {
            MapEmpty => if changed {
                children = children.push(left[left_index]);
            },
            child => {
                if !changed {
                    children = plum__array_reserve_empty_raw(size);
                    for at in 0..left_index {
                        children = children.push(left[at]);
                    };
                    changed = true;
                };
                children = children.push(child);
            },
        };
        if on_left {
            left_index = left_index + 1;
        };
        if on_right {
            right_index = right_index + 1;
        };
    };
    if changed { SetMergeUpdated(MapBranch(bits, children), added) } else { SetMergeKeep }
}

let set_merge_branch_terminal[T: Eq]
    (bits: Int)
    (children: Array[MapNode[T, Unit]])
    (terminal: MapNode[T, Unit])
    (hash: Int)
    (shift: Int)
    (terminal_first: Bool): SetMergeEdit[T]
= {
    let bit = map_bit(hash, shift);
    let index = map_rank(bits, bit);
    if (bits & bit) == 0 {
        let added = if terminal_first { set_count_children(children) }
        else { set_count_node(terminal) };
        SetMergeUpdated(
            MapBranch(bits | bit, plum__array_insert_raw(children, index, terminal)),
            added
        )
    } else if terminal_first {
        let original = children[index];
        let mut siblings = 0;
        for i in 0..children.len() {
            if i != index {
                siblings = siblings + set_count_node(children[i]);
            };
        };
        match set_merge_union_node(terminal, original, shift + 5) {
            SetMergeKeep => SetMergeUpdated(
                MapBranch(bits, children.set(index, terminal)),
                siblings
            ),
            SetMergeUpdated(child, added) =>
                SetMergeUpdated(MapBranch(bits, children.set(index, child)), siblings + added),
        }
    } else {
        match set_merge_union_node(children[index], terminal, shift + 5) {
            SetMergeKeep => SetMergeKeep,
            SetMergeUpdated(child, added) =>
                SetMergeUpdated(MapBranch(bits, children.set(index, child)), added),
        }
    }
}

let set_bucket_prefix_length[T: Eq]
    (left: Array[MapEntry[T, Unit]])
    (right: Array[MapEntry[T, Unit]])
    (i: Int)
    (end: Int): Int
= if i == end || left[i].key != right[i].key { i }
else { set_bucket_prefix_length(left, right, i + 1, end) }

let set_bucket_common_prefix[T: Eq]
    (left: Array[MapEntry[T, Unit]])
    (right: Array[MapEntry[T, Unit]]): Int
= set_bucket_prefix_length(left, right, 0, Int.min(left.len(), right.len()))

let set_merge_bucket_union[T: Eq]
    (left: MapNode[T, Unit])
    (right: MapNode[T, Unit]): SetMergeEdit[T]
= {
    // The right bucket supplies positions and left keys supply representatives.
    let base = Map { root: right, size: set_count_node(right) };
    match set_collect(left, base, SetAll) {
        Map { root, size } => SetMergeUpdated(root, size - set_count_node(left)),
    }
}

let set_find_bucket_index[T: Eq]
    (entries: Array[MapEntry[T, Unit]])
    (key: T)
    (index: Int)
    (end: Int): Int
= if index == end { -1 }
else if entries[index].key == key { index }
else { set_find_bucket_index(entries, key, index + 1, end) }

// Equal replacements keep the original right positions searchable.
// Search only that prefix so a unique right buffer can be reused.
let set_merge_collision_entries[T: Eq]
    (left: Array[MapEntry[T, Unit]])
    (right: Array[MapEntry[T, Unit]])
    (prefix: Int): Array[MapEntry[T, Unit]]
= {
    let end = right.len();
    let mut merged = right;
    // The common prefix already supplies the positions for these entries.
    for i in 0..prefix {
        merged = merged.set(i, left[i]);
    };
    // Keys in the remaining left suffix cannot match an earlier left key.
    for i in prefix..left.len() {
        let entry = left[i];
        let at = set_find_bucket_index(merged, entry.key, prefix, end);
        if at < 0 {
            merged = merged.push(entry);
        }
        else {
            merged = merged.set(at, entry);
        };
    };
    merged
}

// The right leaf takes the first position. An equal left entry supplies
// its representative and the remaining left entries keep their order.
let set_prepend_bucket_leaf[T]
    (entries: Array[MapEntry[T, Unit]])
    (key: T)
    (position: Int): Array[MapEntry[T, Unit]]
= if position < 0 { plum__array_insert_raw(entries, 0, MapEntry { key: key, value: () }) }
else {
    let entry = entries[position];
    let mut moved = entries;
    for i in 0..position {
        let at = position - i;
        moved = moved.set(at, moved[at - 1]);
    };
    moved.set(0, entry)
}

let set_merge_union_node[T: Eq]
    (left: MapNode[T, Unit])
    (right: MapNode[T, Unit])
    (shift: Int): SetMergeEdit[T]
= match left {
    MapEmpty => SetMergeUpdated(right, set_count_node(right)),
    MapBranch(left_bits, left_children) => match right {
        MapEmpty => SetMergeKeep,
        MapBranch(right_bits, right_children) => if (left_bits & right_bits) == 0 {
            SetMergeUpdated(
                MapBranch(
                    left_bits | right_bits,
                    set_graft_children(left_bits, left_children, right_bits, right_children)
                ),
                set_count_children(right_children)
            )
        } else {
            set_merge_children(left_bits, left_children, right_bits, right_children, shift + 5)
        },
        MapLeaf(hash, _, _) | MapCollision(hash, _) =>
            set_merge_branch_terminal(left_bits, left_children, right, hash, shift, false),
    },
    MapLeaf(hash, _, _) | MapCollision(hash, _) => match right {
        MapEmpty => SetMergeKeep,
        MapBranch(bits, children) =>
            set_merge_branch_terminal(bits, children, left, hash, shift, true),
        MapLeaf(h, _, _) | MapCollision(h, _) => if hash != h {
            SetMergeUpdated(map_join(left, hash, right, h, shift), set_count_node(right))
        } else {
            match left {
                MapLeaf(_, key, _) => match right {
                    MapLeaf(_, k, _) if key == k => SetMergeKeep,
                    _ => set_merge_bucket_union(left, right),
                },
                MapCollision(_, left_entries) => match right {
                    MapCollision(_, right_entries) => {
                        let prefix = set_bucket_common_prefix(left_entries, right_entries);
                        if prefix == right_entries.len() { SetMergeKeep }
                        else {
                            let merged = set_merge_collision_entries(
                                left_entries,
                                right_entries,
                                prefix
                            );
                            let added = merged.len() - left_entries.len();
                            SetMergeUpdated(MapCollision(hash, merged), added)
                        }
                    },
                    MapLeaf(_, key, _) => {
                        let position = map_bucket_find_index(left_entries, key, 0);
                        if position == 0 { SetMergeKeep }
                        else {
                            let merged = set_prepend_bucket_leaf(left_entries, key, position);
                            let added = if position < 0 { 1 } else { 0 };
                            SetMergeUpdated(MapCollision(hash, merged), added)
                        }
                    },
                    _ => set_merge_bucket_union(left, right),
                },
                _ => set_merge_bucket_union(left, right),
            }
        },
    },
}

let set_union_branch_roots[T: Eq] (a: Set[T]) (b: Set[T]): Set[T] =
    match set_merge_union_node(a.inner.root, b.inner.root, 0) {
        SetMergeKeep => a,
        SetMergeUpdated(root, added) => {
            let size = Set.len(a) + added;
            // Keep the edit in scope for Map reuse and consume the Set wrapper.
            match a {
                Set { inner: _ } => Set { inner: Map { root, size } },
            }
        },
    }

let set_union_collision_map[T: Eq]
    (left: Array[MapEntry[T, Unit]])
    (right: Map[T, Unit])
    (prefix: Int): Map[T, Unit]
= match right {
    Map { root, size } => {
        // Finish the Map outside the node match so both cells can be reused.
        let merged = match root {
            MapCollision(hash, entries) =>
                MapCollision(hash, set_merge_collision_entries(left, entries, prefix)),
            node => node,
        };
        let size = set_count_node(merged);
        Map { root: merged, size }
    },
}

// Inspect the prefix before consuming the right Set. A negative result
// indicates that the right root is outside this same-hash bucket path.
let set_bucket_union_prefix[T: Eq]
    (left: Array[MapEntry[T, Unit]])
    (hash: Int)
    (right: MapNode[T, Unit]): Int
= match right {
    MapCollision(h, entries) if h == hash => set_bucket_common_prefix(left, entries),
    _ => -1,
}

let set_union_merge_routes[T: Eq] (a: Set[T]) (b: Set[T]): Set[T] =
    match a.inner.root {
        // Inserting a small left input avoids counting large right-only subtries.
        MapBranch(_, _) if Set.len(a) > Set.len(b) / 8 => match b.inner.root {
            MapBranch(_, _) => set_union_branch_roots(a, b),
            _ => set_union_by_insertion(a, b),
        },
        MapCollision(hash, left_entries) => {
            let prefix = set_bucket_union_prefix(left_entries, hash, b.inner.root);
            if prefix < 0 { set_union_by_insertion(a, b) }
            else if prefix == Set.len(b) { a }
            else {
                match b {
                    Set { inner } => Set {
                        inner: set_union_collision_map(left_entries, inner, prefix)
                    },
                }
            }
        },
        _ => set_union_by_insertion(a, b),
    }

// A miss on a different hash is -2. A new key with the same hash is
// -1. An existing key uses its zero-based position, including a leaf at 0.
let set_union_leaf_position[T: Eq]
    (node: MapNode[T, Unit])
    (hash: Int)
    (key: T)
    (shift: Int): Int
= match node {
    MapEmpty => -2,
    MapLeaf(h, k, _) => if h != hash { -2 } else if k == key { 0 } else { -1 },
    MapCollision(h, entries) => if h != hash { -2 }
    else { map_bucket_find_index(entries, key, 0) },
    MapBranch(bits, children) => {
        let bit = map_bit(hash, shift);
        if (bits & bit) == 0 { -2 }
        else { set_union_leaf_position(children[map_rank(bits, bit)], hash, key, shift + 5) }
    },
}

// Keep the existing right leaf when the route ends at a missing slot
// or at a terminal with a different hash.
let set_union_update_leaf[T]
    (node: MapNode[T, Unit])
    (hash: Int)
    (key: T)
    (leaf: MapNode[T, Unit])
    (position: Int)
    (shift: Int): MapNode[T, Unit]
= match node {
    MapEmpty => leaf,
    MapLeaf(h, old_key, _) => if h != hash { map_join(node, h, leaf, hash, shift) }
    else {
        MapCollision(h, [MapEntry { key: key, value: () }, MapEntry { key: old_key, value: () }])
    },
    MapCollision(h, entries) => if h != hash { map_join(node, h, leaf, hash, shift) }
    else { MapCollision(h, set_prepend_bucket_leaf(entries, key, position)) },
    MapBranch(bits, children) => {
        let bit = map_bit(hash, shift);
        let i = map_rank(bits, bit);
        if (bits & bit) == 0 {
            MapBranch(bits | bit, plum__array_insert_raw(children, i, leaf))
        }
        else {
            MapBranch(bits, plum__array_update_raw(
                children,
                i,
                hash,
                key,
                leaf,
                position,
                shift + 5,
                |child, h, k, right, at, next| set_union_update_leaf(child, h, k, right, at, next)
            ))
        }
    },
}

let set_union_update_map[T]
    (left: Map[T, Unit])
    (hash: Int)
    (key: T)
    (leaf: MapNode[T, Unit])
    (position: Int): Map[T, Unit]
= match left {
    Map { root, size } => {
        let added = if position < 0 { 1 } else { 0 };
        Map { root: set_union_update_leaf(root, hash, key, leaf, position, 0), size: size + added }
    },
}

let set_union_single_leaf[T: Eq] (a: Set[T]) (b: Set[T]): Set[T] = {
    let leaf = b.inner.root;
    match leaf {
        MapLeaf(hash, key, _) => {
            let position = set_union_leaf_position(a.inner.root, hash, key, 0);
            if position == 0 { a }
            else {
                match a {
                    Set { inner } => Set {
                        inner: set_union_update_map(inner, hash, key, leaf, position)
                    },
                }
            }
        },
        _ => set_union_by_insertion(a, b),
    }
}

// An already selected root can reuse the input's owned wrappers.
let set_replace_map_root[T] (map: Map[T, Unit]) (root: MapNode[T, Unit]) (size: Int): Map[T, Unit] =
    match map {
        Map { root: _, size: _ } => Map { root, size },
    }

let set_replace_root[T] (set: Set[T]) (root: MapNode[T, Unit]) (size: Int): Set[T] =
    match set {
        Set { inner } => Set { inner: set_replace_map_root(inner, root, size) },
    }

enum SetGraftRoute { DisjointBranches, OverlappingBranches, GeneralGraft }

let set_root_graft_route[T]
    (left: MapNode[T, Unit])
    (right: MapNode[T, Unit]): SetGraftRoute
= match left {
    MapBranch(left_bits, _) => match right {
        MapBranch(right_bits, _) => if (left_bits & right_bits) == 0 { DisjointBranches }
        // Equal unary roots can still have disjoint child routes.
        else if left_bits == right_bits && (left_bits & (left_bits - 1)) == 0 { GeneralGraft }
        else { OverlappingBranches },
        _ => GeneralGraft,
    },
    _ => GeneralGraft,
}

// This call is only reached after proving the root bitmaps are disjoint.
let set_graft_disjoint_branches[T]
    (left: MapNode[T, Unit])
    (right: MapNode[T, Unit]): MapNode[T, Unit]
= match right {
    MapBranch(right_bits, right_children) => match left {
        MapBranch(left_bits, left_children) => MapBranch(
            left_bits | right_bits,
            set_graft_children(left_bits, left_children, right_bits, right_children)
        ),
        _ => MapEmpty,
    },
    _ => MapEmpty,
}

let set_graft_disjoint_map[T]
    (left: Map[T, Unit])
    (right: MapNode[T, Unit])
    (right_size: Int): Map[T, Unit]
= match left {
    Map { root, size } => {
        let grafted = set_graft_disjoint_branches(root, right);
        Map { root: grafted, size: size + right_size }
    },
}

/// Everything in either set.
pub let Set.union[T: Eq + Hash] (a: Set[T]) (b: Set[T]): Set[T] = {
    let right_size = Set.len(b);
    let left_size = Set.len(a);
    if left_size == 0 { b }
    else if right_size == 0 { a }
    else if right_size == 1 { set_union_single_leaf(a, b) }
    else {
        match set_root_graft_route(a.inner.root, b.inner.root) {
            DisjointBranches => match a {
                Set { inner } => Set {
                    inner: set_graft_disjoint_map(inner, set_root(b), right_size)
                },
            },
            OverlappingBranches => set_union_merge_routes(a, b),
            GeneralGraft => match set_graft_union(a.inner.root, b.inner.root, 0) {
                MapEmpty => set_union_merge_routes(a, b),
                root => set_replace_root(a, root, left_size + right_size),
            },
        }
    }
}

// Find the left representative of a singleton intersection. A matching
// leaf already has the shape needed by the result.
let set_find_leaf[T: Eq]
    (node: MapNode[T, Unit])
    (hash: Int)
    (key: T)
    (shift: Int): MapNode[T, Unit]
= match node {
    MapEmpty => MapEmpty,
    MapLeaf(h, k, _) => if h == hash && k == key { node } else { MapEmpty },
    MapCollision(h, entries) => if h != hash { MapEmpty } else {
        let i = map_bucket_find_index(entries, key, 0);
        if i < 0 { MapEmpty } else { MapLeaf(h, entries[i].key, ()) }
    },
    MapBranch(bits, children) => {
        let bit = map_bit(hash, shift);
        if (bits & bit) == 0 { MapEmpty }
        else { set_find_leaf(children[map_rank(bits, bit)], hash, key, shift + 5) }
    },
}

/// Only what is in both.
pub let Set.intersection[T: Eq + Hash] (a: Set[T]) (b: Set[T]): Set[T] = {
    let right_size = Set.len(b);
    if right_size == 0 { b }
    else {
        match a.inner.root {
            MapEmpty => a,
            MapLeaf(hash, key, _) => if map_node_contains(b.inner.root, hash, key, 0) { a }
            else { Set.new(()) },
            _ => match b.inner.root {
                MapLeaf(hash, key, _) => match set_find_leaf(set_root(a), hash, key, 0) {
                    MapEmpty => Set.new(()),
                    leaf => set_replace_root(b, leaf, 1),
                },
                _ => {
                    let coverage = if Set.len(a) - 1 <= right_size {
                        set_node_coverage(a.inner.root, b.inner.root, 0, NoSetMatch)
                    } else { StopSetScan };
                    match coverage {
                        NoSetMatch => a,
                        OneSetMatch(hash, position) => match a {
                            Set { inner } => Set { inner: map_remove_at(inner, hash, position) },
                        },
                        StopSetScan => set_prune(a, b, true),
                    }
                },
            },
        }
    }
}

// The caller still has the left node for the unchanged case.
enum SetPrune[T] {
    SetKeepNode,
    SetDropNode,
    SetUpdateNode(MapNode[T, Unit])
}

// Keep the matching suffix as bit masks until the result size is known.
let set_append_bucket_mask[T]
    (entries: Array[MapEntry[T, Unit]])
    (out: Array[MapEntry[T, Unit]])
    (start: Int)
    (mask: Int): Array[MapEntry[T, Unit]]
= {
    let mut kept = out;
    for slot in 0..64 {
        if (mask & (1 << slot)) != 0 {
            kept = kept.push(entries[start + slot]);
        };
    };
    kept
}

let set_prune_bucket[T: Eq]
    (entries: Array[MapEntry[T, Unit]])
    (right: MapNode[T, Unit])
    (hash: Int)
    (retain_matches: Bool): SetPrune[T]
= {
    let len = entries.len();
    let mut prefix = len;
    let mut suffix_size = 0;
    let mut first_index = 0;
    let mut first_start = 0;
    let mut first_mask = 0;
    // Further nonempty masks are stored as adjacent start and mask slots.
    let mut masks: Array[Int] = [];
    for block in 0..((len - 1) / 64 + 1) {
        let start = block * 64;
        let mut mask = 0;
        for i in start..Int.min(start + 64, len) {
            if map_node_contains(right, hash, entries[i].key, 0) != retain_matches {
                if prefix == len {
                    prefix = i;
                };
            } else if prefix != len {
                if suffix_size == 0 {
                    first_index = i;
                };
                mask = mask | (1 << (i - start));
                suffix_size = suffix_size + 1;
            };
        };
        if mask != 0 {
            if first_mask == 0 {
                first_start = start;
                first_mask = mask;
            } else {
                masks = masks.push(start).push(mask);
            };
        };
    };
    let size = prefix + suffix_size;
    if prefix == len { SetKeepNode }
    else if size == 0 { SetDropNode }
    else if size == 1 {
        let i = if prefix == 1 { 0 } else { first_index };
        SetUpdateNode(MapLeaf(hash, entries[i].key, ()))
    }
    else if suffix_size == 0 { SetUpdateNode(MapCollision(hash, Array.take(entries, prefix))) }
    else {
        let mut kept = plum__array_reserve_empty_raw(size);
        for i in 0..prefix {
            kept = kept.push(entries[i]);
        };
        kept = set_append_bucket_mask(entries, kept, first_start, first_mask);
        for i in 0..(masks.len() / 2) {
            kept = set_append_bucket_mask(entries, kept, masks[2 * i], masks[2 * i + 1]);
        };
        SetUpdateNode(MapCollision(hash, kept))
    }
}

let set_bucket_find_last_match[T: Eq]
    (left: Array[MapEntry[T, Unit]])
    (right: Array[MapEntry[T, Unit]])
    (i: Int): Int
= if i < 0 { -1 }
else if map_bucket_find_index(right, left[i].key, 0) >= 0 { i }
else { set_bucket_find_last_match(left, right, i - 1) }

// Only matching entries add frames. The caller limits the right bucket to sixteen.
// Walking backwards lets us fill the exact-size result in left order.
let set_bucket_collect_matches[T: Eq]
    (left: Array[MapEntry[T, Unit]])
    (right: Array[MapEntry[T, Unit]])
    (i: Int)
    (count: Int): Array[MapEntry[T, Unit]]
= {
    let next = if count == right.len() { -1 } else { set_bucket_find_last_match(left, right, i) };
    if next < 0 { plum__array_reserve_empty_raw(count) }
    else {
        set_bucket_collect_matches(left, right, next - 1, count + 1).push(left[next])
    }
}

let set_prune_sparse_bucket[T: Eq]
    (left: Array[MapEntry[T, Unit]])
    (right: Array[MapEntry[T, Unit]])
    (hash: Int): SetPrune[T]
= {
    let last = set_bucket_find_last_match(left, right, left.len() - 1);
    if last < 0 { SetDropNode }
    else {
        let previous = set_bucket_find_last_match(left, right, last - 1);
        if previous < 0 { SetUpdateNode(MapLeaf(hash, left[last].key, ())) }
        else {
            let kept = set_bucket_collect_matches(left, right, previous - 1, 2);
            SetUpdateNode(MapCollision(hash, kept.push(left[previous]).push(left[last])))
        }
    }
}

// Keep the original children until the first edit. Hold a lone survivor
// directly so promoting a terminal does not require a temporary array.
let set_prune_branch[T: Eq]
    (children: Array[MapNode[T, Unit]])
    (right: MapNode[T, Unit])
    (bits: Int)
    (common: Int)
    (shift: Int)
    (retain_matches: Bool): SetPrune[T]
= if common == 0 {
    if retain_matches { SetDropNode } else { SetKeepNode }
} else if retain_matches && (common & (common - 1)) == 0 {
    let child = children[map_rank(bits, common)];
    let other = match right {
        MapBranch(right_bits, right_children) => right_children[map_rank(right_bits, common)],
        _ => right,
    };
    let edit = set_prune_nodes(child, other, shift + 5, true);
    match edit {
        SetKeepNode if common == bits => SetKeepNode,
        SetDropNode => SetDropNode,
        _ => {
            let survivor = match edit {
                SetUpdateNode(next) => next,
                _ => child,
            };
            match survivor {
                // A branch still routes using the next hash chunk.
                MapBranch(_, _) => SetUpdateNode(MapBranch(common, [survivor])),
                _ => SetUpdateNode(survivor),
            }
        },
    }
} else {
    let candidates = if retain_matches { common } else { bits };
    let mut todo = candidates;
    let mut surviving = candidates;
    let mut changed = candidates != bits;
    let mut first = MapEmpty;
    let mut kept: Array[MapNode[T, Unit]] = [];
    for i in 0..Int.count_ones(candidates) {
        let bit = todo & - todo;
        todo = todo & ~bit;
        let child = children[if candidates == bits { i } else { map_rank(bits, bit) }];
        let edit = if (common & bit) == 0 { SetKeepNode } else {
            let other = match right {
                MapBranch(right_bits, right_children) => right_children[map_rank(right_bits, bit)],
                _ => right,
            };
            set_prune_nodes(child, other, shift + 5, retain_matches)
        };
        let prefix = if changed { 0 } else { i };
        let next = match edit {
            SetKeepNode => if changed { child } else { MapEmpty },
            SetDropNode => {
                changed = true;
                surviving = surviving & ~bit;
                MapEmpty
            },
            SetUpdateNode(next) => {
                changed = true;
                next
            },
        };
        if changed {
            if prefix == 1 {
                first = children[0];
            }
            else if prefix > 1 {
                kept = Array.take(children, prefix);
            };
            match next {
                MapEmpty => (),
                _ if kept.len() != 0 => {
                    kept = kept.push(next);
                },
                _ => match first {
                    MapEmpty => {
                        first = next;
                    },
                    _ => {
                        kept = [first, next];
                    },
                },
            };
        };
    };
    if !changed { SetKeepNode }
    else if surviving == 0 { SetDropNode }
    else if kept.len() == 0 {
        match first {
            MapBranch(_, _) => SetUpdateNode(MapBranch(surviving, [first])),
            _ => SetUpdateNode(first),
        }
    } else { SetUpdateNode(MapBranch(surviving, kept)) }
}

// A right-hand leaf bounds the intersection to one left representative.
let set_prune_singleton[T: Eq]
    (left: MapNode[T, Unit])
    (hash: Int)
    (key: T)
    (shift: Int): SetPrune[T]
= match set_find_leaf(left, hash, key, shift) {
    MapEmpty => SetDropNode,
    leaf => SetUpdateNode(leaf),
}

let set_prune_nodes[T: Eq]
    (left: MapNode[T, Unit])
    (right: MapNode[T, Unit])
    (shift: Int)
    (retain_matches: Bool): SetPrune[T]
= {
    let nonmember = if retain_matches { SetDropNode } else { SetKeepNode };
    match left {
        MapEmpty => SetKeepNode,
        MapLeaf(hash, key, _) => if map_node_contains(right, hash, key, shift) != retain_matches {
            SetDropNode
        } else { SetKeepNode },
        MapCollision(hash, entries) => match right {
            MapEmpty => nonmember,
            MapBranch(bits, children) => {
                let bit = map_bit(hash, shift);
                if (bits & bit) == 0 { nonmember }
                else {
                    set_prune_nodes(left, children[map_rank(bits, bit)], shift + 5, retain_matches)
                }
            },
            MapLeaf(h, key, _) => if h != hash { nonmember }
            else if retain_matches { set_prune_singleton(left, h, key, shift) }
            else {
                let i = map_bucket_find_index(entries, key, 0);
                if i < 0 { SetKeepNode }
                else { SetUpdateNode(map_node_remove_present(left, hash, i + 1, shift, false)) }
            },
            MapCollision(h, other_entries) => if h != hash { nonmember }
            else if retain_matches && other_entries.len() <= 16
                && other_entries.len() <= entries.len() / 2 {
                    set_prune_sparse_bucket(entries, other_entries, hash)
                }
            else { set_prune_bucket(entries, right, hash, retain_matches) },
        },
        MapBranch(bits, children) => match right {
            MapEmpty => nonmember,
            MapBranch(other_bits, _) => set_prune_branch(
                children,
                right,
                bits,
                bits & other_bits,
                shift,
                retain_matches
            ),
            MapLeaf(hash, key, _) => if retain_matches {
                set_prune_singleton(left, hash, key, shift)
            } else {
                set_prune_branch(children, right, bits, bits & map_bit(hash, shift), shift, false)
            },
            MapCollision(hash, _) => set_prune_branch(
                children,
                right,
                bits,
                bits & map_bit(hash, shift),
                shift,
                retain_matches
            ),
        },
    }
}

// Count the result once so unchanged and fully removed subtries need no
// allocated records for their sizes during the edit.
let set_count_children[T] (children: Array[MapNode[T, Unit]]): Int = {
    let mut size = 0;
    for child in children {
        size = size + set_count_node(child);
    };
    size
}

let set_count_node[T] (node: MapNode[T, Unit]): Int = match node {
    MapEmpty => 0,
    MapLeaf(_, _, _) => 1,
    MapCollision(_, entries) => entries.len(),
    MapBranch(_, children) => set_count_children(children),
}

let set_prune[T: Eq] (left: Set[T]) (right: Set[T]) (retain_matches: Bool): Set[T] =
    match set_prune_nodes(left.inner.root, right.inner.root, 0, retain_matches) {
        SetKeepNode => left,
        SetDropNode => Set.new(()),
        SetUpdateNode(root) => Set { inner: Map { root: root, size: set_count_node(root) } },
    }

/// What is in `a` and not in `b`.
pub let Set.difference[T: Eq + Hash] (a: Set[T]) (b: Set[T]): Set[T] = {
    let right_size = Set.len(b);
    if right_size == 0 { a }
    else if right_size <= Set.len(a) / 2 {
        // Visit at most as many keys as a rebuild would need to insert.
        match b.inner.root {
            MapLeaf(hash, key, _) => set_remove_hashed(a, hash, key),
            _ => match a {
                Set { inner } => Set { inner: set_collect(set_root(b), inner, SetErase) },
            },
        }
    }
    else {
        match a.inner.root {
            MapLeaf(hash, key, _) => if map_node_contains(b.inner.root, hash, key, 0) {
                Set.new(())
            } else { a },
            _ => match set_nodes_overlap(a.inner.root, b.inner.root, 0, SharedMember, NoSetMatch) {
                NoSetMatch => a,
                OneSetMatch(hash, key) => set_remove_hashed(a, hash, key),
                StopSetScan => set_prune(a, b, false),
            },
        }
    }
}

/// A set of the array's elements, discarding duplicates.
pub let Set.from_array[T: Eq + Hash] (arr: Array[T]): Set[T] =
    if arr.len() == 0 { Set.new(()) }
    else { Set { inner: Array.fold(arr, Map.new(()), |acc, elem| Map.insert(acc, elem, ())) } }

// --- JSON ---

/// An object member, with a decoded key and JSON value.
pub struct JsonEntry { pub key: String, pub value: JsonValue }

/// A parsed JSON document.
///
/// Numbers are binary64 `Float`s and may lose precision when parsed.
/// `use Json;` brings in decoders that turn one of these into your own
/// types; `Json.int` rejects values outside the safe integer range.
pub enum JsonValue {
    JsonNull,
    JsonBool(Bool),
    JsonNumber(Float),
    JsonString(String),
    JsonArray(Array[JsonValue]),
    JsonObject(Array[JsonEntry]),
}

/// What a JSON parse step consumed: a value, and where to carry on
/// from. Public because the parser's own pieces return it; a caller
/// wants `json_parse`.
pub struct ParseResult[T] { pub value: T, pub next_pos: Int }

// Scanning uses byte offsets. JSON punctuation is ASCII, so token and
// string-run boundaries never split a UTF-8 code point.
let skip_ws (bytes: Bytes) (pos: Int): Int =
    if pos >= bytes_len_raw(bytes) { pos }
    else {
        let c = bytes_at_raw(bytes, pos);
        if c == 32 || c == 9 || c == 10 || c == 13 { skip_ws(bytes, pos + 1) } else { pos }
    }

let json_digit (c: Int): Bool = c >= 48 && c <= 57

let parse_digits (bytes: Bytes) (pos: Int): Int =
    if pos < bytes_len_raw(bytes) && json_digit(bytes_at_raw(bytes, pos)) {
        parse_digits(bytes, pos + 1)
    }
    else { pos }

// Shared lexical scanner for String.parse_float and JSON. No numeric
// accumulation or exponent scaling: the runtime converts the token once.
let parse_number (bytes: Bytes) (pos: Int): Result[ParseResult[Float], String] = {
    let n = bytes_len_raw(bytes);
    let start = if pos < n && bytes_at_raw(bytes, pos) == 45 { pos + 1 } else { pos };
    let int_end = parse_digits(bytes, start);
    if int_end == start { Err("expected digit") }
    else {
        let has_frac = int_end < n && bytes_at_raw(bytes, int_end) == 46;
        let frac_end = if has_frac { parse_digits(bytes, int_end + 1) } else { int_end };
        if has_frac && frac_end == int_end + 1 { Err("expected digit") }
        else {
            let has_exp = frac_end < n
                && (bytes_at_raw(bytes, frac_end) == 101 || bytes_at_raw(bytes, frac_end) == 69);
            let after_e = frac_end + 1;
            let exp_start = if has_exp && after_e < n
                && (bytes_at_raw(bytes, after_e) == 45 || bytes_at_raw(bytes, after_e) == 43) {
                    after_e + 1
                } else { after_e };
            let end = if has_exp { parse_digits(bytes, exp_start) } else { frac_end };
            if has_exp && end == exp_start { Err("expected digit") }
            else {
                let converted = parse_float_raw(str_of_bytes_raw(bytes_slice_raw(bytes, pos, end)));
                // Some CRTs return positive zero on negative underflow.
                // Preserve the token's sign independently of that behavior.
                let value = if converted == 0.0 && start > pos { -0.0 } else { converted };
                if Float.is_finite(value) { Ok(ParseResult { value: value, next_pos: end }) }
                else { Err("float out of range") }
            }
        }
    }
}

let parse_literal
    (bytes: Bytes)
    (pos: Int)
    (word: String)
    (value: JsonValue): Result[ParseResult[JsonValue], String]
=
    if str_of_bytes_raw(bytes_slice_raw(bytes, pos, pos + word.len())) == word {
        Ok(ParseResult { value: value, next_pos: pos + word.len() })
    }
    else { Err("invalid literal") }

let json_hex (c: Int): Int =
    if c >= 48 && c <= 57 { c - 48 }
    else if c >= 65 && c <= 70 { c - 55 }
    else if c >= 97 && c <= 102 { c - 87 }
    else { -1 }

let json_hex4 (bytes: Bytes) (pos: Int) (left: Int) (acc: Int): Result[Int, String] =
    if left == 0 { Ok(acc) }
    else if pos >= bytes_len_raw(bytes) { Err("invalid unicode escape") }
    else {
        let d = json_hex(bytes_at_raw(bytes, pos));
        if d < 0 { Err("invalid unicode escape") }
        else { json_hex4(bytes, pos + 1, left - 1, acc * 16 + d) }
    }

let json_codepoint (c: Int): String = str_of_bytes_raw(bytes_from_array_raw(
    if c < 128 { [c] }
    else if c < 2048 { [192 + c / 64, 128 + c % 64] }
    else if c < 65536 { [224 + c / 4096, 128 + (c / 64) % 64, 128 + c % 64] }
    else { [240 + c / 262144, 128 + (c / 4096) % 64, 128 + (c / 64) % 64, 128 + c % 64] }
))

let json_unicode (bytes: Bytes) (pos: Int): Result[ParseResult[String], String] =
    match json_hex4(bytes, pos, 4, 0) {
        Err(e) => Err(e),
        Ok(c) => if c >= 55296 && c <= 56319 {
            if pos + 6 > bytes_len_raw(bytes) || bytes_at_raw(bytes, pos + 4) != 92
                || bytes_at_raw(bytes, pos + 5) != 117 { Err("invalid unicode surrogate pair") }
            else {
                match json_hex4(bytes, pos + 6, 4, 0) {
                    Err(e) => Err(e),
                    Ok(low) => if low < 56320 || low > 57343 {
                        Err("invalid unicode surrogate pair")
                    }
                    else {
                        Ok(ParseResult {
                            value: json_codepoint(65536 + (c - 55296) * 1024 + low - 56320),
                            next_pos: pos + 10
                        })
                    },
                }
            }
        } else if c >= 56320 && c <= 57343 { Err("invalid unicode surrogate pair") }
        else { Ok(ParseResult { value: json_codepoint(c), next_pos: pos + 4 }) },
    }

// An ordinary run is copied once into a chunk. Escapes append small
// chunks to a uniquely owned growable array, then concat_all copies the
// decoded string once. Width is handled by tail calls, not stack frames.
let parse_string_body
    (bytes: Bytes)
    (pos: Int)
    (run: Int)
    (parts: Array[String]): Result[ParseResult[String], String]
=
    if pos >= bytes_len_raw(bytes) { Err("unterminated string") }
    else {
        let c = bytes_at_raw(bytes, pos);
        if c == 34 || c == 92 {
            if pos > run {
                parts = parts.push(str_of_bytes_raw(bytes_slice_raw(bytes, run, pos)));
            };
            if c == 34 { Ok(ParseResult { value: Array.concat_all(parts), next_pos: pos + 1 }) }
            else if pos + 1 >= bytes_len_raw(bytes) { Err("unterminated escape") }
            else {
                let e = bytes_at_raw(bytes, pos + 1);
                let decoded = if e == 117 { json_unicode(bytes, pos + 2) }
                else {
                    let value = if e == 34 { Ok("\"") }
                    else if e == 92 { Ok("\\") }
                    else if e == 47 { Ok("/") }
                    else if e == 98 { Ok(json_codepoint(8)) }
                    else if e == 102 { Ok(json_codepoint(12)) }
                    else if e == 110 { Ok("\n") }
                    else if e == 114 { Ok("\r") }
                    else if e == 116 { Ok("\t") }
                    else { Err("unsupported escape sequence") };
                    match value {
                        Err(err) => Err(err),
                        Ok(v) => Ok(ParseResult { value: v, next_pos: pos + 2 }),
                    }
                };
                match decoded {
                    Err(err) => Err(err),
                    Ok(r) => {
                        parts = parts.push(r.value);
                        parse_string_body(bytes, r.next_pos, r.next_pos, parts)
                    },
                }
            }
        }
        else if c < 32 { Err("unescaped control character") }
        else { parse_string_body(bytes, pos + 1, run, parts) }
    }

let parse_string (bytes: Bytes) (pos: Int): Result[ParseResult[String], String] =
    if pos >= bytes_len_raw(bytes) || bytes_at_raw(bytes, pos) != 34 {
        Err("expected opening quote")
    }
    else { parse_string_body(bytes, pos + 1, pos + 1, []) }

let parse_value (bytes: Bytes) (pos: Int) (depth: Int): Result[ParseResult[JsonValue], String] =
    if pos >= bytes_len_raw(bytes) { Err("unexpected end of input") }
    else {
        let c = bytes_at_raw(bytes, pos);
        if c == 34 {
            match parse_string(bytes, pos) {
                Ok(r) => Ok(ParseResult { value: JsonString(r.value), next_pos: r.next_pos }),
                Err(e) => Err(e),
            }
        }
        else if c == 123 {
            if depth >= 128 { Err("JSON nesting limit exceeded (128)") } else {
                parse_object(bytes, pos, depth + 1)
            }
        }
        else if c == 91 {
            if depth >= 128 { Err("JSON nesting limit exceeded (128)") } else {
                parse_array(bytes, pos, depth + 1)
            }
        }
        else if c == 116 { parse_literal(bytes, pos, "true", JsonBool(true)) }
        else if c == 102 { parse_literal(bytes, pos, "false", JsonBool(false)) }
        else if c == 110 { parse_literal(bytes, pos, "null", JsonNull) }
        else if json_digit(c) || c == 45 {
            let start = if c == 45 { pos + 1 } else { pos };
            if start + 1 < bytes_len_raw(bytes) && bytes_at_raw(bytes, start) == 48
                && json_digit(bytes_at_raw(bytes, start + 1)) { Err("leading zero in JSON number") }
            else {
                match parse_number(bytes, pos) {
                    Ok(r) => Ok(ParseResult { value: JsonNumber(r.value), next_pos: r.next_pos }),
                    Err(e) => Err(e),
                }
            }
        }
        else { Err("unexpected character") }
    }

let parse_array (bytes: Bytes) (pos: Int) (depth: Int): Result[ParseResult[JsonValue], String] = {
    let p1 = skip_ws(bytes, pos + 1);
    if p1 < bytes_len_raw(bytes) && bytes_at_raw(bytes, p1) == 93 {
        Ok(ParseResult { value: JsonArray([]), next_pos: p1 + 1 })
    }
    else { parse_array_entries(bytes, p1, depth, []) }
}

let parse_array_entries
    (bytes: Bytes)
    (pos: Int)
    (depth: Int)
    (acc: Array[JsonValue]): Result[ParseResult[JsonValue], String]
=
    match parse_value(bytes, pos, depth) {
        Err(e) => Err(e),
        Ok(val_r) => {
            acc = acc.push(val_r.value);
            let p1 = skip_ws(bytes, val_r.next_pos);
            if p1 < bytes_len_raw(bytes) && bytes_at_raw(bytes, p1) == 44 {
                parse_array_entries(bytes, skip_ws(bytes, p1 + 1), depth, acc)
            }
            else if p1 < bytes_len_raw(bytes) && bytes_at_raw(bytes, p1) == 93 {
                Ok(ParseResult { value: JsonArray(acc), next_pos: p1 + 1 })
            }
            else { Err("expected ',' or ']'") }
        }
    }

let parse_object (bytes: Bytes) (pos: Int) (depth: Int): Result[ParseResult[JsonValue], String] = {
    let p1 = skip_ws(bytes, pos + 1);
    if p1 < bytes_len_raw(bytes) && bytes_at_raw(bytes, p1) == 125 {
        Ok(ParseResult { value: JsonObject([]), next_pos: p1 + 1 })
    }
    else { parse_object_entries(bytes, p1, depth, []) }
}

let parse_object_entries
    (bytes: Bytes)
    (pos: Int)
    (depth: Int)
    (acc: Array[JsonEntry]): Result[ParseResult[JsonValue], String]
=
    match parse_string(bytes, pos) {
        Err(e) => Err(e),
        Ok(key_r) => {
            let p1 = skip_ws(bytes, key_r.next_pos);
            if Array.any(acc, |entry: JsonEntry| entry.key == key_r.value) {
                Err("duplicate object member name")
            }
            else if p1 >= bytes_len_raw(bytes) || bytes_at_raw(bytes, p1) != 58 {
                Err("expected ':'")
            }
            else {
                let p2 = skip_ws(bytes, p1 + 1);
                match parse_value(bytes, p2, depth) {
                    Err(e) => Err(e),
                    Ok(val_r) => {
                        acc = acc.push(JsonEntry { key: key_r.value, value: val_r.value });
                        let p3 = skip_ws(bytes, val_r.next_pos);
                        if p3 < bytes_len_raw(bytes) && bytes_at_raw(bytes, p3) == 44 {
                            parse_object_entries(bytes, skip_ws(bytes, p3 + 1), depth, acc)
                        }
                        else if p3 < bytes_len_raw(bytes) && bytes_at_raw(bytes, p3) == 125 {
                            Ok(ParseResult { value: JsonObject(acc), next_pos: p3 + 1 })
                        }
                        else { Err("expected ',' or '}'") }
                    }
                }
            }
        }
    }

/// Parses JSON text.
///
/// `Err` with a message naming what was expected. Accepts one complete
/// value and rejects trailing text after it. Object member names must
/// be unique within each object, compared after decoding escapes;
/// duplicate names return `Err("duplicate object member name")`.
/// Strings support JSON escapes, including UTF-16 surrogate pairs, and
/// reject raw control characters and unpaired surrogates. Numbers must
/// follow JSON syntax (no leading zeros).
/// Numbers overflowing binary64 return `Err`; underflow rounds to a
/// subnormal value or signed zero.
/// At most 128 arrays/objects may be nested, counting the root container;
/// a deeper container returns `Err("JSON nesting limit exceeded (128)")`.
/// Input bytes and decoded strings use linear storage; this is not a
/// total input-size limit. Wide objects still compare each key against
/// preceding keys to reject duplicates.
pub let json_parse (s: String): Result[JsonValue, String] = {
    let bytes = bytes_of_str_raw(s);
    let start = skip_ws(bytes, 0);
    match parse_value(bytes, start, 0) {
        Err(e) => Err(e),
        Ok(r) => {
            let after = skip_ws(bytes, r.next_pos);
            if after == bytes_len_raw(bytes) { Ok(r.value) } else {
                Err("trailing characters after JSON value")
            }
        }
    }
}

// ASCII escape boundaries cannot split a UTF-8 code point. Scan byte
// runs so ordinary text needs neither chars_of nor per-character strings.
let json_run_end (s: Bytes) (pos: Int): Int =
    if pos >= bytes_len_raw(s) { pos }
    else {
        let b = bytes_at_raw(s, pos);
        if b == 34 || b == 92 || b < 32 { pos }
        else { json_run_end(s, pos + 1) }
    }

let json_escape_byte (b: Int): String =
    if b == 34 { "\\\"" }
    else if b == 92 { "\\\\" }
    else if b == 8 { "\\b" }
    else if b == 12 { "\\f" }
    else if b == 10 { "\\n" }
    else if b == 13 { "\\r" }
    else if b == 9 { "\\t" }
    else if b < 32 { "\\u00".concat(plum__hex_digit(b / 16)).concat(plum__hex_digit(b % 16)) }
    else { "" }

// One continuation per active container, rather than one per sibling.
// Keep the container alive while visiting its children so dropping a
// traversal frame cannot recursively destroy the unvisited subtree.
enum JsonWriteStack {
    JsonWriteDone,
    JsonWriteValue(JsonValue, JsonWriteStack),
    JsonWriteArray(Array[JsonValue], Int, JsonWriteStack),
    JsonWriteObject(Array[JsonEntry], Int, JsonWriteStack),
    JsonWriteString(Bytes, Int, JsonWriteStack),
    JsonWriteText(String, JsonWriteStack),
}

// Every transition is a same-signature tail call (musttail in LLVM).
// Append only through self-rebinding here: passing parts through nested
// helpers keeps aliases alive and defeats geometric array growth.
// concat_all then copies the fragments into one final allocation.
let json_emit (stack: JsonWriteStack) (parts: Array[String]): Result[String, String] = match stack {
    JsonWriteDone => Ok(Array.concat_all(parts)),
    JsonWriteText(text, rest) => {
        parts = parts.push(text);
        json_emit(rest, parts)
    },
    JsonWriteString(s, pos, rest) => {
        let end = json_run_end(s, pos);
        if end > pos {
            parts = parts.push(str_of_bytes_raw(bytes_slice_raw(s, pos, end)));
        };
        if end == bytes_len_raw(s) {
            parts = parts.push("\"");
            json_emit(rest, parts)
        } else {
            parts = parts.push(json_escape_byte(bytes_at_raw(s, end)));
            json_emit(JsonWriteString(s, end + 1, rest), parts)
        }
    },
    JsonWriteValue(v, rest) => match v {
        JsonNull => {
            parts = parts.push("null");
            json_emit(rest, parts)
        },
        JsonBool(b) => {
            parts = parts.push(if b { "true" } else { "false" });
            json_emit(rest, parts)
        },
        JsonNumber(n) => {
            if Float.is_finite(n) {
                parts = parts.push(n.to_string());
                json_emit(rest, parts)
            } else { Err("non-finite JSON number") }
        },
        JsonString(s) => {
            parts = parts.push("\"");
            json_emit(JsonWriteString(bytes_of_str_raw(s), 0, rest), parts)
        },
        JsonArray(arr) => {
            parts = parts.push("[");
            json_emit(JsonWriteArray(arr, 0, rest), parts)
        },
        JsonObject(entries) => {
            parts = parts.push("{");
            json_emit(JsonWriteObject(entries, 0, rest), parts)
        },
    },
    JsonWriteArray(arr, pos, rest) =>
        if pos >= arr.len() {
            parts = parts.push("]");
            json_emit(rest, parts)
        } else {
            if pos > 0 {
                parts = parts.push(",");
            };
            json_emit(JsonWriteValue(arr[pos], JsonWriteArray(arr, pos + 1, rest)), parts)
        },
    JsonWriteObject(entries, pos, rest) =>
        if pos >= entries.len() {
            parts = parts.push("}");
            json_emit(rest, parts)
        } else {
            let entry = entries[pos];
            if pos > 0 {
                parts = parts.push(",");
            };
            parts = parts.push("\"");
            let next = JsonWriteValue(entry.value, JsonWriteObject(entries, pos + 1, rest));
            json_emit(
                JsonWriteString(bytes_of_str_raw(entry.key), 0, JsonWriteText(":", next)),
                parts
            )
        },
}

/// Renders a `JsonValue` as compact JSON — no spaces, no newlines.
///
/// Object keys come out in the order they are held, which for a parsed
/// document is the order they were read. All U+0000–U+001F control
/// characters are escaped, including in keys. Output construction takes
/// linear time and space in the output size, with an explicit traversal
/// stack proportional to nesting depth instead of native stack recursion.
/// Returns `Err("non-finite JSON number")` for NaN or either infinity,
/// including inside arrays and objects. No partial output is returned.
pub let json_stringify (v: JsonValue): Result[String, String] =
    json_emit(JsonWriteValue(v, JsonWriteDone), [])

/// `pub` because the PARSER generates calls to these when it
/// desugars `requires`/`ensures`, and that generated code lands in
/// the user's own module. Nobody writes them by hand.
pub let __contract_require (cond: Bool) (msg: String): Unit =
    if cond { () } else { panic_raw(msg) }

pub let __contract_ensure (cond: Bool) (msg: String): Unit =
    if cond { () } else { panic_raw(msg) }
