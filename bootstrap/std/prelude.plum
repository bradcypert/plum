// Fixed-width bit helpers retain the Int helper conventions.
let i8_shr_logical_raw (x: I8) (n: Int): I8 = 0

/// Shifts the low 8 bits right with zero fill. Nonpositive counts return x; counts at least 8 return zero. The result retains I8.
pub let I8.shr_logical (x: I8) (n: Int): I8 = i8_shr_logical_raw(x, n)

let i8_count_ones_raw (x: I8): Int = 0

/// Counts one bits within the 8-bit representation, excluding any sign extension. Returns an Int in 0..8 inclusive.
pub let I8.count_ones (x: I8): Int = i8_count_ones_raw(x)

