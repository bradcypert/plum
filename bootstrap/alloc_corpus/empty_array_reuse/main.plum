let main (): Unit = {
    let mut values = "x".repeat(4096).as_bytes().to_array(); values = values.filter(|x| false);
    for i in 0..1000 {
        values = values.map(|x| x);
        for j in 0..4096 { values = values.push(j); };
        assert_eq(values.len(), 4096); assert_eq(values[4095], 4095);
        values = values.filter(|x| false);
    };
    assert_eq(values, []);
}
