// A map inside a loop -- the case a single `Array.map` does not show.
// Each iteration's source is dead the moment the next result exists, so
// the whole chain runs in ONE array cell instead of a thousand.
//
// This fixture and `closure_in_loop` are now the same program, and
// deliberately so: they were split when the count here was 1002,
// because the array cells were fixed and the thousand closure cells
// were not. Both numbers are 2 now. They are kept apart because they
// fail apart -- one regresses if array reuse breaks, the other if
// capture-free closures stop being constants.
let go (xs: Array[Int]) (n: Int): Array[Int] =
    if n <= 0 { xs } else { go(Array.map(xs, |v| v + 1), n - 1) }

let main (): Unit = println(go([1, 2, 3, 4, 5], 1000).len().to_string())
