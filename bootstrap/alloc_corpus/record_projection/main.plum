struct Box[T] { value: T }
let reverse (b: Box[String]): String = String.reverse(b.value)
let apply (b: Box[String]) (f: (Box[String]) -> String): String = f(b)
let main (): Unit = {
    let mut text = "aé\x00🙂".repeat(1024);
    for i in 0..512 {
        text = if i % 2 == 0 { reverse(Box { value: text }) } else { apply(Box { value: text }, |b| String.reverse(b.value)) };
        assert_eq(text.starts_with("🙂"), i % 2 == 0); assert_eq(text.len(), 8192);
    };
    assert_eq(text, "aé\x00🙂".repeat(1024));
}
