let main (): Unit = {
    let reverse = String.reverse;
    let forward = |s: String| reverse(s);
    let mut text = "aé\x00🙂".repeat(1024);
    for i in 0..512 {
        text = if i % 2 == 0 { String.reverse(text) } else { forward(text) };
        assert_eq(text.len(), 8192); assert_eq(text.starts_with("🙂"), i % 2 == 0);
    };
    assert_eq(text, "aé\x00🙂".repeat(1024));
}
