// The outer map consumes an owned temporary, so every stage can reuse
// its Array and transfer ordinary children into the consuming callback.
let words (): Array[String] = {
    let mut xs: Array[String] = [];
    for i in 0..128 {
        xs = xs.push(i.to_string().repeat(16));
    };
    xs
}

let pipeline (xs: Array[String]) (n: Int): Array[String] =
    if n <= 0 { xs } else { pipeline(xs.map(|s| s.concat("!")).map(|s| s.concat("?")), n - 1) }

let main (): Unit = {
    let xs = pipeline(words(), 256);
    assert_eq(xs.len(), 128);
    for i in 0..128 {
        assert_eq(xs[i], i.to_string().repeat(16).concat("!?".repeat(256)));
    };
}
