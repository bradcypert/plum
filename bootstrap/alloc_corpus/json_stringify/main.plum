// Allocation counts alone do not catch quadratic copying: the old
// serializer allocated ~62 MB for this array's 44 KB output. The byte
// ceiling also covers string escaping, object keys and deep traversal.
let values (n: Int) (value: JsonValue) (xs: Array[JsonValue]): Array[JsonValue] =
    if n == 0 { xs } else { values(n - 1, value, xs.push(value)) }

let nested (n: Int) (v: JsonValue): JsonValue =
    if n == 0 { v } else { nested(n - 1, JsonArray([v])) }

let repeated (n: Int) (xs: Array[String]): String =
    if n == 0 { Array.concat_all(xs) } else { repeated(n - 1, xs.push("é\n\t\\\"")) }

let main (): Unit = {
    println(Bytes.len(stringify_valid(JsonArray(values(4000, JsonString("abcdefgh"), []))).as_bytes()).to_string());
    println(Bytes.len(stringify_valid(nested(1000, JsonNull)).as_bytes()).to_string());
    let s = repeated(4000, []);
    println(Bytes.len(stringify_valid(JsonObject([JsonEntry { key: s, value: JsonString(s) }])).as_bytes()).to_string());
}

// These fixtures construct finite JSON. Fail loudly if that invariant changes.
let stringify_valid (value: JsonValue): String = match json_stringify(value) {
    Ok(text) => text,
    Err(e) => { panic_raw(e); "" },
}
