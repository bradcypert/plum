// The same question for an enum payload rather than a struct, and it
// gets the same answer -- but for a different reason worth keeping a
// fixture for. The cell to recycle here is the MATCH SCRUTINEE, which
// the rebuilt value never mentions: `Count(k + 1)` reads `k`, not `c`.
// A rule that looked for the candidate inside the allocation would
// find nothing.
enum Counter { Empty, Count(Int) }

let bump (c: Counter) (n: Int): Counter =
    if n <= 0 { c }
    else { bump(match c { Empty => Count(1), Count(k) => Count(k + 1) }, n - 1) }

let main (): Unit =
    println(match bump(Empty, 1000) { Empty => 0, Count(k) => k }.to_string())
