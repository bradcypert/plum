// Last-use reversal transfers the String owner and keeps its existing buffer.
let main (): Unit = {
    let mut text = "aé\x00🙂".repeat(1024);
    for i in 0..512 {
        text = String.reverse(text);
        assert_eq(text.len(), 8192); assert_eq(text.starts_with("🙂"), i % 2 == 0);
    };
    assert_eq(text, "aé\x00🙂".repeat(1024));
}
