// Small slices must not materialize the entire large input. Explicit
// doubling keeps construction independent of allocator size classes.
let main (): Unit = {
    let mut text = "aé中🙂\x00";
    for i in 0..12 { text = text.concat(text); };
    for i in 0..100 {
        assert_eq(String.slice(text, 0, 2), "aé");
        assert_eq(String.slice(text, 10242, 10245), "中🙂\x00");
        assert_eq(String.slice(text, 20479, 9223372036854775807), "\x00");
        assert_eq(String.slice(text, 20480, 9223372036854775807), "");
        assert_eq(String.slice(text, 5, -1), "");
    };
    println("slices")
}
