// Parse-time validation should not split query fields or construct Params.
// Keep this query-heavy workload sensitive to reintroducing those temporaries.
use Url;

let run (text: String) (left: Int) (total: Int): Int =
    if left == 0 { total } else {
        match Url.parse(text) {
            Err(e) => { panic_raw(e); 0 },
            Ok(u) => run(text, left - 1, total + u.raw_query.len()),
        }
    }

// Keep repeated-field construction independent of malloc_usable_size. String.repeat
// grows a buffer in place when allocator size classes permit it, so its
// allocation count varies across libc versions. Explicit doubling uses
// a fresh array join at each level, keeping the setup count stable.
let fixture_repeat (text: String) (n: Int): String =
    if n <= 0 { "" } else {
        let half = fixture_repeat(text, n / 2);
        Array.concat_all(if n % 2 == 0 { [half, half] } else { [half, half, text] })
    }

let main (): Unit = {
    let text = "http://example.com/a/b?".concat(fixture_repeat("key=value&", 1000)).concat("last=end#top");
    println(run(text, 100, 0));
    // Escaped data must not trigger a component-sized decoding buffer.
    let encoded = "http://example.com/a/b?".concat(fixture_repeat("key=value%20x&", 1000)).concat("last=end#top");
    println(run(encoded, 100, 0));
}
