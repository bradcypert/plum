let main (): Unit = {
    let bytes = Bytes.slice("é".repeat(64).as_bytes(), 1, 127);
    assert_eq(bytes.len(), 126);
    assert_eq(Bytes.at(bytes, 0), Some(169));
    assert_eq(Bytes.at(bytes, 125), Some(195));

    let text = String.slice("é".repeat(64), 1, 63);
    assert_eq(text.len(), 124);
    assert_eq(text.char_len(), 62);

    let prefix = "\u{3000}".concat("é".repeat(64)).trim_start();
    let suffix = String.pad_right("é".repeat(64), 65, "\u{a0}").trim_end();
    assert_eq(prefix, suffix);
    assert_eq(prefix.len(), 128)
}
