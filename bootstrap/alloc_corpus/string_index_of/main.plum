// Search must not materialize one heap string per character. The
// needle's prefix table grows geometrically; haystack length adds no
// search allocations. Includes misses, hits, and Unicode offsets.
let doubled (s: String) (n: Int): String = if n <= 0 { s } else { doubled(s.concat(s), n - 1) }

let main (): Unit = {
    let haystack = doubled("a", 18);
    let needle = doubled("a", 13).concat("b");
    println(Option.unwrap_or(String.index_of(haystack, needle), -1).to_string());
    println(Option.unwrap_or(String.index_of(haystack.concat("b"), needle), -1).to_string());
    println(Option.unwrap_or(String.index_of("é中🙂abc", "abc"), -1).to_string())
}
