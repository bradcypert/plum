let func (n: Int): () -> Int = || n
let input (): Array[() -> Int] = {
    let mut xs: Array[() -> Int] = [];
    for i in 0..256 { xs = xs.push(func(i)); };
    xs
}
let main (): Unit = {
    let xs = input(); let snapshot = xs;
    let ys = Array.slice(xs, 1, 255);
    assert_eq(ys.len(), 254);
    for i in 0..254 { assert_eq(ys[i](), i + 1); assert_eq(snapshot[i](), i); };
}
