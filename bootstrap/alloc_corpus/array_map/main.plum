// `Array.map` builds a new array, and when the SOURCE is dead it now
// builds into the source's own cell. Here that saves exactly one
// allocation out of eleven, because this fixture's cost is dominated by
// `grow` building the input. `array_map_loop` is where the same
// optimisation is worth 1000.
//
// Kept as the single-map case precisely because it is unimpressive:
// it catches a reuse that fires when it should not just as well as one
// that fires when it should.
let main (): Unit = {
    let xs = grow([], 500);
    println(Array.map(xs, |n| n * 2).len().to_string())
}

let grow (xs: Array[Int]) (n: Int): Array[Int] = if n <= 0 { xs } else { grow(xs.push(n), n - 1) }
