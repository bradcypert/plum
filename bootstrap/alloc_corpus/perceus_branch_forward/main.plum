enum Tree { Leaf(Int), Fork(Tree, Tree) }
let build (depth: Int): Tree =
    if depth == 0 { Leaf(depth + 1) } else { Fork(build(depth - 1), Leaf(depth + 1)) }
let update (tree: Tree) (depth: Int): Tree = match tree {
    Leaf(value) => if value < 0 { tree } else { Leaf(value + 1) },
    Fork(left, right) => if depth < 0 { tree } else { Fork(update(left, depth - 1), right) },
}
let sum (tree: Tree): Int = match tree {
    Leaf(value) => value,
    Fork(left, right) => sum(left) + sum(right),
}
// Neither arm has a last-use frontier before its consuming call. Do not
// defer the ordinary arm-entry release merely because the source is read.
let forward (tree: Tree): Tree = match tree {
    Leaf(_) => update(tree, 16),
    Fork(_, _) => update(tree, 16),
}
let main (): Unit = {
    let mut tree = build(16);
    for i in 0..32 { tree = forward(tree); };
    assert_eq(sum(tree), 185);
}
