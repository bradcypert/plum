#!/usr/bin/env bash
# Native failure/cleanup checks plus the public text/binary read contract.
set -euo pipefail
root="$(cd "$(dirname "${BASH_SOURCE[0]}")/.." && pwd)"
cd "$root"
plum="${PLUM:-./sh}"
work="$(mktemp -d)"
trap 'rm -rf "$work"' EXIT

clang -O1 -g -fsanitize=address,undefined -fno-sanitize-recover=all \
    bootstrap/whole-file-read-test.c -o "$work/native-test"
ASAN_OPTIONS=detect_leaks=1 timeout 10 "$work/native-test"

"$plum" build bootstrap/exec_corpus/whole_file_reads -o "$work/reads"
timeout 30 "$work/reads" > "$work/out"
diff -u bootstrap/exec_corpus/whole_file_reads/expected.txt "$work/out"
echo "file-read smoke: ok"
