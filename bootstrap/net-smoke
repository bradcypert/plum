#!/usr/bin/env bash
# Proves the networking prelude WORKS in a compiled binary -- a TCP
# round trip and an HTTP request/response over loopback.
#
# Deliberately NOT an `exec_corpus` fixture, and the reason is worth
# stating. Networking fixtures can HANG rather than fail: if a client
# connects before its server has listened, the accept blocks forever
# and the process never exits. The first attempt at this as a corpus
# fixture did exactly that. A hang inside `corpus-check` is far worse
# than no coverage -- it blocks every future run of everything -- so
# this lives in its own script with a hard `timeout`, the same shape as
# `lsp-smoke` and `test-smoke`, where a hang is a clean failure.
#
# It exists because its absence caused a real regression. The
# self-hosted compiler had no networking prelude at all, survivable
# only while `plum build` could still compile such programs. When the
# Rust backend was deleted on 2026-08-21, every HTTP and TCP program
# became compilable by NOTHING -- and every harness passed, because
# nothing exercised networking.
#
# The ports are high and odd. A collision with an unrelated listener is
# the one way this fails for a reason that is not a bug.
set -uo pipefail

root="$(cd "$(dirname "${BASH_SOURCE[0]}")/.." && pwd)"
cd "$root"
work="$(mktemp -d -t plum-netsmoke-XXXXXX)"
trap 'rm -rf "$work"' EXIT

fail=0

# --- TCP ---------------------------------------------------------
# Race-free by construction: `main` creates the LISTENING socket before
# anything can connect, and only then spawns the acceptor.
mkdir -p "$work/tcp"
cat > "$work/tcp/main.plum" <<'PLUM'
use Net;
let main (): Unit = match Net.listen_on(18733) {
    Err(e) => println("listen: ".concat(e)),
    Ok(srv) => {
        let acceptor = spawn {
            match Net.accept(srv) {
                Err(e) => "accept: ".concat(e),
                Ok(conn) => {
                    let got = Net.read(conn, 1024);
                    match Net.write(conn, "pong") { Ok(_) => (), Err(_) => () };
                    Net.close(conn);
                    got
                },
            }
        };
        match Net.connect_to("127.0.0.1", 18733) {
            Err(e) => println("connect: ".concat(e)),
            Ok(fd) => {
                match Net.write(fd, "ping") { Ok(_) => (), Err(_) => () };
                let reply = Net.read(fd, 1024);
                Net.close(fd);
                println(acceptor.join().concat("/").concat(reply))
            },
        };
        Net.close(srv)
    },
}
PLUM

# --- Binary TCP --------------------------------------------------
# Same race-free shape as the TCP case above, with a payload chosen so
# that the STRING path would demonstrably mangle it: it opens with a NUL
# and carries a second one, so `Net.read`'s NUL-terminated result would
# be empty. `Net.read_bytes` carries a length and does not care.
#
# The last line is the distinction `Net.read` cannot express: a clean
# peer close arrives as `Ok` with an empty buffer, NOT as an `Err`.
mkdir -p "$work/netbin"
cat > "$work/netbin/main.plum" <<'PLUM'
use Net;
let payload (): Bytes = Bytes.from_array([0, 255, 10, 13, 128, 65, 0, 66])

let main (): Unit = match Net.listen_on(18735) {
    Err(e) => println("listen: ".concat(e)),
    Ok(srv) => {
        let acceptor = spawn {
            match Net.accept(srv) {
                Err(e) => "accept: ".concat(e),
                Ok(conn) => {
                    let got = match Net.read_bytes(conn, 1024) {
                        Ok(b) => b.to_hex(),
                        Err(e) => e,
                    };
                    match Net.write_bytes(conn, payload()) { Ok(_) => (), Err(_) => () };
                    Net.close(conn);
                    got
                },
            }
        };
        match Net.connect_to("127.0.0.1", 18735) {
            Err(e) => println("connect: ".concat(e)),
            Ok(fd) => {
                match Net.write_bytes(fd, payload()) { Ok(_) => (), Err(_) => () };
                let reply = match Net.read_bytes(fd, 1024) { Ok(b) => b, Err(_) => Bytes.empty() };
                println(acceptor.join());
                println(reply.to_hex());
                println((reply == payload()).to_string());
                println(match Net.read_bytes(fd, 1024) {
                    Ok(b) => b.is_empty().to_string(),
                    Err(e) => "eof was an error: ".concat(e),
                });
                Net.close(fd)
            },
        };
        Net.close(srv)
    },
}
PLUM

# --- HTTP wire format --------------------------------------------
# The exact bytes `Http.get` puts on the wire, captured by a RAW TCP
# listener rather than by `Http.serve_once` -- a parsed `Request` cannot
# tell you what was actually sent.
#
# This exists because `Http` was migrated onto the `Url` module, which
# splits the query out of the path where the old hand-rolled parser left
# them together. `Url.request_target` puts them back, and the claim that
# it does so byte-for-byte is exactly the kind of thing that is true on
# the day it is written and quietly false later. The request line below
# is the one the previous parser produced, recorded before the migration
# and unchanged by it.
#
# `Host` carries the port, because 18797 is not the scheme default --
# RFC 7230 section 5.4. It did NOT until 2026-09-04: the client sent a
# bare host, which a name-based virtual host on a non-default port reads
# as a different origin than the one that was asked for.
#
# That deviation was pinned here first, as current-not-correct
# behaviour, so the migration onto `Url` could be verified by comparison
# against it; correcting it was then a deliberate edit to this
# expectation, which is what the earlier comment asked for.
mkdir -p "$work/httpwire"
cat > "$work/httpwire/main.plum" <<'PLUM'
use Net;
use Http;

let main (): Unit = match Net.listen_on(18797) {
    Err(e) => println("listen: ".concat(e)),
    Ok(srv) => {
        let server = spawn {
            match Net.accept(srv) {
                Err(e) => "accept: ".concat(e),
                Ok(conn) => {
                    let got = Net.read(conn, 4096);
                    match Net.write(conn, "HTTP/1.1 200 OK\r\nContent-Length: 2\r\n\r\nhi") { Ok(_) => (), Err(_) => () };
                    Net.close(conn);
                    got
                },
            }
        };
        match Http.get("http://127.0.0.1:18797/a/b?q=1&r=2") {
            Err(e) => println("client: ".concat(e)),
            Ok(r) => println("client got ".concat(r.status.to_string()).concat(" ").concat(r.body)),
        };
        println("--- request bytes ---");
        println(String.replace(server.join(), "\r\n", "\\r\\n\n"));
        Net.close(srv)
    },
}
PLUM

# --- HTTP --------------------------------------------------------
# `Http.serve_once` listens AND accepts internally, so the race cannot
# be removed the way it can for raw TCP. The client retries instead: a
# refused connection returns immediately, so a bounded retry covers the
# server's startup window without needing a sleep primitive, and a
# server that never comes up ends the loop rather than hanging it.
mkdir -p "$work/http"
cat > "$work/http/main.plum" <<'PLUM'
use Net;
use Http;

let attempt (n: Int): String =
    if n <= 0 { "client: gave up" }
    else {
        match Http.get("http://127.0.0.1:18734/world") {
            Ok(r) => r.status.to_string().concat(" ").concat(r.body),
            Err(e) => attempt(n - 1),
        }
    }

let main (): Unit = {
    let server = spawn {
        Http.serve_once(18734, |req| Http.Response {
            status: 200,
            headers: [Http.Header { name: "Content-Type", value: "text/plain" }],
            body: "hello ".concat(req.path),
        })
    };
    let got = attempt(200);
    match server.join() { Ok(_) => println(got), Err(e) => println("server: ".concat(e)) };
    // Failure paths, which need no listener and so cannot be flaky.
    println(match Net.connect_to("127.0.0.1", 1) { Ok(_) => "?", Err(e) => e });
    println(match Http.get("https://example.com/") { Ok(_) => "?", Err(e) => e });
    println(match Http.get("nope://example.com/") { Ok(_) => "?", Err(e) => e })
}
PLUM

check() {
    local name="$1" expected="$2"
    if ! SH_MEM="${SH_MEM:-512M}" SH_TIMEOUT="${SH_TIMEOUT:-240}" ./sh build "$work/$name" -o "$work/$name.bin" > "$work/$name.err" 2>&1; then
        echo "FAIL [$name]: did not compile: $(head -1 "$work/$name.err")"; fail=1; return
    fi
    local out
    out="$(cd "$work" && timeout 30 "./$name.bin" 2>&1)"
    local rc=$?
    if [ $rc -ne 0 ]; then
        echo "FAIL [$name]: exited $rc$([ $rc -eq 124 ] && echo ' (TIMED OUT -- a blocked accept, not a slow one)')"
        printf '%s\n' "$out" | head -4 | sed 's/^/        /'
        fail=1; return
    fi
    if [ "$out" != "$expected" ]; then
        echo "FAIL [$name]: wrong output"
        diff <(printf '%s\n' "$expected") <(printf '%s\n' "$out") | head -8 | sed 's/^/        /'
        fail=1; return
    fi
}

check tcp "ping/pong"
check httpwire "client got 200 hi
--- request bytes ---
GET /a/b?q=1&r=2 HTTP/1.1\\r\\n
Host: 127.0.0.1:18797\\r\\n
Connection: close\\r\\n
\\r\\n"
check netbin "00ff0a0d80410042
00ff0a0d80410042
true
true"
check http "200 hello /world
Net.connect_to: could not connect to 127.0.0.1:1
http client: https:// is not supported yet
http client: url must start with http://"

[ $fail -eq 0 ] && echo "net smoke: ok, TCP and HTTP work in a compiled binary"
exit $fail
