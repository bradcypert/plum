#!/usr/bin/env bash
# PEAK MEMORY, asserted rather than hoped for.
#
# `./sh` caps the compiler with a cgroup `MemoryMax`, but that guard
# needs `systemd-run --user`, which needs a user session bus -- and a CI
# runner does not have one. The wrapper notices and degrades to a plain
# `timeout`, silently and by design, so **on CI there is no memory
# ceiling at all**. Every `SH_MEM` value in `bootstrap/` is therefore a
# developer-desktop guard and nothing else.
#
# That left the one measurement worth keeping honest unenforced
# anywhere automated. Type-checking the whole compiler peaked at 731 MB
# until tail calls in a cycle started returning early, and 57 MB after;
# a regression back would have been invisible to CI. This asserts it
# with `getrusage`, which needs no cgroup, no root and no session bus,
# and so works everywhere Python does.
#
# **Only operations the COMPILER performs alone are checked.** Anything
# that links shells out to clang, and clang's footprint dwarfs ours and
# varies by version -- a threshold over `build` would measure clang and
# fail on an unlucky runner. `emit-llvm` and `check` are pure Plum, so
# the only variable is us, which is the point.
#
# The measured value is printed whether or not it passes, so drift is
# visible in the log before it becomes a failure.
#
# Each ceiling is chosen so it actually CATCHES that operation's known
# regression rather than merely sitting above it. A first pass used
# round numbers twice as large and the `check` ceiling sailed straight
# over the 83 MB the old compiler really used -- a threshold that misses
# the regression it was written for is decoration.
#
# RSS depends on the platform, allocator and workload size. After TLS
# embedding and compiler growth, CI run 537 (2026-11-07) measured MiB:
#
#                  debug emit    release emit    check
#   linux x86_64      127             113           47
#   linux arm64      128.3           113           45
#   macOS arm64      166             142           59
#
# The prior merged PR already used 127 MiB on Linux ARM64. The old
# 128 MiB debug ceiling left no growth margin: this run exceeded it by
# 268 KiB. Allow 144 MiB for Linux debug emission (about 12% headroom),
# while retaining 128 MiB for release and 64 MiB for checking. macOS
# retains 192/192/80 MiB; its RSS has historically varied more widely.
# Requested-byte budgets below independently reject repeated allocation
# churn even when RSS stays flat. These RSS ceilings still reject the
# historical 744 MiB emission and 83 MiB checking regressions on Linux.
#
# If a ceiling fails, compare actual allocation traffic, output size,
# lifetimes and platform measurements before recalibrating it.
#
# The Windows job does not run this at all -- it is a separate job with
# its own steps. The `resource` guard below is defensive rather than
# load-bearing, for anyone who adds it there later.
set -uo pipefail

root="$(cd "$(dirname "${BASH_SOURCE[0]}")/.." && pwd)"
cd "$root"

plum="${1:-./sh.real}"

if [ ! -x "$plum" ]; then
    echo "mem-check: no compiler at $plum -- build one first" >&2
    exit 1
fi

if ! python3 -c 'import resource' 2>/dev/null; then
    echo "mem-check: skipped, no POSIX resource module (Windows?)"
    exit 0
fi

fail=0

# `getrusage(RUSAGE_CHILDREN).ru_maxrss` is the high-water mark of every
# child waited for. Linux reports KILOBYTES and macOS reports BYTES --
# the same field, a factor of 1024 apart, which is exactly the kind of
# difference that makes a threshold look fine on one platform and absurd
# on the other.
#
# `timeout` is GNU coreutils and is NOT on macOS, which ships neither it
# nor an equivalent under that name; Homebrew installs it as `gtimeout`.
# The first version of this harness called it unconditionally and the
# macOS job died with `FileNotFoundError: 'timeout'` before measuring a
# single byte -- this file was the first macOS-reachable harness ever to
# reach for it, so nothing had caught the assumption. Same GNU/BSD split
# `bootstrap/package-release` documents for `sha256sum` vs `shasum`.
#
# Running WITHOUT one is the fallback rather than an error: the timeout
# is belt-and-braces against a hung compiler, and CI already caps the
# whole job. Losing it costs a slower failure, not a wrong measurement.
# Re-measured on Linux x86_64 after embedded TLS (2026-09-30): 120 MB
# to emit and 40 MB to check. Embedding files directly replaced the
# per-line string arrays that had raised emission to 570 MB. The
# then-existing 128/64 MB ceilings passed that workload.
compiler_usage() {
    python3 - "$@" <<'PY'
import os, re, resource, shutil, subprocess, sys
runner = next((t for t in ("timeout", "gtimeout") if shutil.which(t)), None)
argv = ([runner, "600"] if runner else []) + sys.argv[1:]
result = subprocess.run(argv,
                    stdout=subprocess.DEVNULL, stderr=subprocess.PIPE,
                    env=dict(os.environ, PLUM_RT_STATS="1"))
stats = result.stderr.decode("utf-8", errors="replace")
match = re.search(r"\[plum-rt\] alloc n=[0-9]+ bytes=([0-9]+)", stats)
allocated = int(match[1]) if match else -1
rc = result.returncode
kb = resource.getrusage(resource.RUSAGE_CHILDREN).ru_maxrss
if sys.platform == "darwin":
    kb //= 1024
print("%d %d %d" % (kb, rc, allocated))
PY
}

check() {   # <threshold-KB> <allocated-byte-ceiling-or-0> <label> <args...>
    local limit="$1" byte_limit="$2" label="$3"; shift 3
    local out kb rc allocated
    out="$(compiler_usage "$plum" "$@")" || { echo "FAIL: $label could not be measured" >&2; fail=1; return; }
    read -r kb rc allocated <<< "$out"
    if [ "$rc" != "0" ]; then
        echo "FAIL: $label exited $rc -- measuring a failed run proves nothing" >&2
        fail=1
        return
    fi
    printf '  %-34s %6d MB   (ceiling %d MB)\n' "$label" "$((kb / 1024))" "$((limit / 1024))"
    if [ "$byte_limit" -gt 0 ]; then
        printf '    cumulative allocated bytes: %s (ceiling %s)\n' "$allocated" "$byte_limit"
        if [ "$allocated" -lt 0 ] || [ "$allocated" -gt "$byte_limit" ]; then
            echo "FAIL: $label missing allocation stats or over its byte ceiling" >&2
            fail=1
        fi
    fi
    if [ "$kb" -gt "$limit" ]; then
        echo "FAIL: $label peaked at $kb KiB, over its $limit KiB ceiling" >&2
        fail=1
    fi
}

echo "mem-check: peak RSS of the compiler alone (no clang in these)"

# See the table at the top for what each platform actually measures and
# why they differ. `uname` rather than a build-time constant, because
# the same checkout is run on all three.
case "$(uname -s)" in
    Darwin) debug_emit_ceiling=196608; release_emit_ceiling=196608; check_ceiling=81920 ;;
    *)      debug_emit_ceiling=147456; release_emit_ceiling=131072; check_ceiling=65536 ;;
esac

# 120 MB on Linux with compact TLS embedding; 744 MB measured on the
# pre-fix compiler, before tail calls in a cycle returned early.
# Fragment collection reduced default/debug allocation traffic from about
# 38.4 GB to 6.7 GB; shared boundary trimming reduced it again from
# 7.0 GB to 5.0 GB, retaining parsed handle names to about 3.7 GB,
# and collecting literal/argument fragments to about 3.0 GB.
# Program-scoped type facts further reduce this to about 2.4 GB.
# Structural symbol identities bring it to about 2.2 GB on this input.
# Batched callgraph worklists reduce it further to about 1.9 GB.
# Branch and match fragments reduce this to about 1.5 GB.
# Keep an independent requested-byte budget: RSS alone
# does not catch repeatedly copying either annotated text or metadata.
check "$debug_emit_ceiling" 1800000000 "emit-llvm, whole compiler" emit-llvm bootstrap/self_host

# 40 MB on Linux with compact TLS embedding; 83 MB on that same pre-fix
# compiler.
check "$check_ceiling" 0 "check, whole compiler" check bootstrap/self_host

# Selective emission replay reduced release emission from about 6.0 GB
# to 4.5 GB allocated cumulatively. RSS alone cannot catch that regression:
# cumulative allocation traffic can fall without moving the live peak.
# Use the built-in requested-byte counter, not allocator-dependent timing.
# Retaining parsed handle names further reduced this from 4.8 GB to 3.5 GB.
# Literal/argument fragments reduced it again to about 2.9 GB.
# Memoizing complete resource/type queries brings it to about 2.2 GB.
# Structural symbol identities bring it to about 2.0 GB.
# Batched callgraph worklists bring it to about 1.7 GB.
# Branch and match fragments bring it to about 1.4 GB.
# Leave about 0.3 GB for growth while rejecting repeated text copies.
# Release mode also keeps debug line-attachment work out of this budget.
check "$release_emit_ceiling" 1650000000 "release emit-llvm, whole compiler" emit-llvm bootstrap/self_host --release

# Exercise both allocation paths at several widths; a whole-compiler total
# alone can hide a quadratic literal builder as the surrounding source grows.
python3 "$root/bootstrap/emission-memory-check.py" "$plum" || fail=1
python3 "$root/bootstrap/reachability-memory-check.py" "$plum" || fail=1
python3 "$root/bootstrap/branch-memory-check.py" "$plum" || fail=1

[ $fail -ne 0 ] && exit 1
echo "mem-check: the compiler stays within its memory ceilings"
