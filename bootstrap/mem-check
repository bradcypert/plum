#!/usr/bin/env bash
# PEAK MEMORY, asserted rather than hoped for.
#
# `./sh` caps the compiler with a cgroup `MemoryMax`, but that guard
# needs `systemd-run --user`, which needs a user session bus -- and a CI
# runner does not have one. The wrapper notices and degrades to a plain
# `timeout`, silently and by design, so **on CI there is no memory
# ceiling at all**. Every `SH_MEM` value in `bootstrap/` is therefore a
# developer-desktop guard and nothing else.
#
# That left the one measurement worth keeping honest unenforced
# anywhere automated. Type-checking the whole compiler peaked at 731 MB
# until tail calls in a cycle started returning early, and 57 MB after;
# a regression back would have been invisible to CI. This asserts it
# with `getrusage`, which needs no cgroup, no root and no session bus,
# and so works everywhere Python does.
#
# **Only operations the COMPILER performs alone are checked.** Anything
# that links shells out to clang, and clang's footprint dwarfs ours and
# varies by version -- a threshold over `build` would measure clang and
# fail on an unlucky runner. `emit-llvm` and `check` are pure Plum, so
# the only variable is us, which is the point.
#
# The measured value is printed whether or not it passes, so drift is
# visible in the log before it becomes a failure.
#
# Each ceiling is chosen so it actually CATCHES that operation's known
# regression rather than merely sitting above it. A first pass used
# round numbers twice as large and the `check` ceiling sailed straight
# over the 83 MB the old compiler really used -- a threshold that misses
# the regression it was written for is decoration.
#
# Measured on every platform that runs this, 2026-09-03:
#
#             emit-llvm   check      ceiling headroom
#   linux x86_64   55 MB   26 MB      2.3x / 2.5x
#   linux arm64    55 MB   24 MB      2.3x / 2.7x
#   macOS arm64    66 MB   39 MB      1.9x / 1.6x
#
# macOS costs ~20% more to emit and ~50% more to check than Linux, so
# its `check` has the least room of anything here. That is still the
# right ceiling rather than a too-tight one: 39 MB would have to grow by
# 64% to trip it, which is a regression and not noise, and raising it
# past 83 MB would stop it catching the thing it exists for. Worth
# knowing before anyone reads the slack as spare.
#
# The Windows job does not run this at all -- it is a separate job with
# its own steps. The `resource` guard below is defensive rather than
# load-bearing, for anyone who adds it there later.
set -uo pipefail

root="$(cd "$(dirname "${BASH_SOURCE[0]}")/.." && pwd)"
cd "$root"

plum="${1:-./sh.real}"

if [ ! -x "$plum" ]; then
    echo "mem-check: no compiler at $plum -- build one first" >&2
    exit 1
fi

if ! python3 -c 'import resource' 2>/dev/null; then
    echo "mem-check: skipped, no POSIX resource module (Windows?)"
    exit 0
fi

fail=0

# `getrusage(RUSAGE_CHILDREN).ru_maxrss` is the high-water mark of every
# child waited for. Linux reports KILOBYTES and macOS reports BYTES --
# the same field, a factor of 1024 apart, which is exactly the kind of
# difference that makes a threshold look fine on one platform and absurd
# on the other.
#
# `timeout` is GNU coreutils and is NOT on macOS, which ships neither it
# nor an equivalent under that name; Homebrew installs it as `gtimeout`.
# The first version of this harness called it unconditionally and the
# macOS job died with `FileNotFoundError: 'timeout'` before measuring a
# single byte -- this file was the first macOS-reachable harness ever to
# reach for it, so nothing had caught the assumption. Same GNU/BSD split
# `bootstrap/package-release` documents for `sha256sum` vs `shasum`.
#
# Running WITHOUT one is the fallback rather than an error: the timeout
# is belt-and-braces against a hung compiler, and CI already caps the
# whole job. Losing it costs a slower failure, not a wrong measurement.
peak_kb() {
    python3 - "$@" <<'PY'
import resource, shutil, subprocess, sys
runner = next((t for t in ("timeout", "gtimeout") if shutil.which(t)), None)
argv = ([runner, "600"] if runner else []) + sys.argv[1:]
rc = subprocess.run(argv,
                    stdout=subprocess.DEVNULL, stderr=subprocess.DEVNULL).returncode
kb = resource.getrusage(resource.RUSAGE_CHILDREN).ru_maxrss
if sys.platform == "darwin":
    kb //= 1024
print("%d %d" % (kb, rc))
PY
}

check() {   # <threshold-KB> <label> <args...>
    local limit="$1" label="$2"; shift 2
    local out kb rc
    out="$(peak_kb "$plum" "$@")" || { echo "FAIL: $label could not be measured" >&2; fail=1; return; }
    kb="${out%% *}"; rc="${out##* }"
    if [ "$rc" != "0" ]; then
        echo "FAIL: $label exited $rc -- measuring a failed run proves nothing" >&2
        fail=1
        return
    fi
    printf '  %-34s %6d MB   (ceiling %d MB)\n' "$label" "$((kb / 1024))" "$((limit / 1024))"
    if [ "$kb" -gt "$limit" ]; then
        echo "FAIL: $label peaked at $((kb / 1024)) MB, over its $((limit / 1024)) MB ceiling" >&2
        fail=1
    fi
}

echo "mem-check: peak RSS of the compiler alone (no clang in these)"

# 56 MB today; 744 MB measured on the pre-fix compiler, before tail
# calls in a cycle returned early. This is the number with a job.
check 131072 "emit-llvm, whole compiler" emit-llvm bootstrap/self_host

# 26 MB today, 83 MB on that same pre-fix compiler.
check 65536 "check, whole compiler" check bootstrap/self_host

[ $fail -ne 0 ] && exit 1
echo "mem-check: the compiler stays within its memory ceilings"
