// Fixture for `deterministic_codegen`. Deliberately shaped to make the
// compiler's two former sources of nondeterministic output observable
// in a program small enough to compile in milliseconds:
//
//   * MANY mutable bindings reassigned on BOTH sides of an `if` inside
//     a `for` — each one diverges between branches, so `merge_envs`
//     allocates a fresh SSA register per name while iterating an
//     `Env` (a `HashMap`). Enough names are needed that the random
//     per-process iteration order actually permutes; a handful is not
//     enough to notice.
//
//   * SEVERAL closure literals across SEVERAL functions — closures are
//     numbered from one global counter in function-emission order, so
//     any instability in that order renames them.

let helper_a (n: Int): Int = {
    let f = |x: Int| x + n;
    f(1) + f(2)
}

let helper_b (n: Int): Int = {
    let g = |x: Int| x * n;
    let h = |x: Int| x - n;
    g(3) + h(4)
}

let helper_c (n: Int): Int = {
    let k = |x: Int| x + 1;
    k(n)
}

let main (): Unit = {
    let mut a1 = 0;
    let mut a2 = 0;
    let mut a3 = 0;
    let mut a4 = 0;
    let mut a5 = 0;
    let mut a6 = 0;
    let mut a7 = 0;
    let mut a8 = 0;
    let mut flag = false;
    for i in 0..10 {
        if i % 2 == 0 {
            a1 = a1 + 1;
            a2 = a2 + 2;
            a3 = a3 + 3;
            a4 = a4 + 4;
            a5 = a5 + 5;
            a6 = a6 + 6;
            a7 = a7 + 7;
            a8 = a8 + 8;
            flag = true;
        } else {
            a1 = a1 + 8;
            a2 = a2 + 7;
            a3 = a3 + 6;
            a4 = a4 + 5;
            a5 = a5 + 4;
            a6 = a6 + 3;
            a7 = a7 + 2;
            a8 = a8 + 1;
            flag = false;
        };
    };
    println(a1 + a2 + a3 + a4 + a5 + a6 + a7 + a8);
    println(flag);
    println(helper_a(1) + helper_b(2) + helper_c(3));
}
