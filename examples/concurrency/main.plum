// Concurrency: `spawn`/`.join()` for tasks, channels for communication.
// Sending is a MOVE — after `tx.send(msg)`, the compiler treats `msg`
// as used for the last time, so reusing it is a compile error, not a
// runtime race: ownership transferred rather than being shared.
//
// Run: `plum run examples/concurrency`
// Build: `plum build examples/concurrency -o out && ./out`

let square (n: Int): Int = n * n

// `spawn { ... }` starts a lightweight task running `{ ... }`;
// `.join()` blocks until it finishes and returns its result.
let compute_in_background (n: Int): Int = spawn { square(n) }.join()

let producer (tx: Sender[Int]) (n: Int): Unit = {
    let msg = square(n);
    tx.send(msg)
    // tx.send(msg); // <- would be a compile error: `msg` already moved
}
// See DESIGN.md's "Concurrency" section: `.recv()`/`select` BLOCK — no
// runtime `None` for a closed channel the way the language sketch in
// DESIGN.md's history once considered; a closed-with-no-sender channel
// is a hang, not a value, matching Go's own channel semantics.

let main (): Unit = {
    // A single background task, joined for its result.
    println(compute_in_background(9));   // 81

    // Producer/consumer over a typed channel. `.recv()` blocks until a
    // value arrives and returns it directly (not wrapped in `Option`).
    // The "fire and forget" `spawn` below discards its own `Task`
    // result — ordinary, no special handling needed.
    let (tx, rx) = channel[Int]();
    spawn { producer(tx, 7) };
    println(rx.recv());   // 49

    // Several tasks, spawned and joined individually.
    let t1 = spawn { square(1) };
    let t2 = spawn { square(2) };
    let t3 = spawn { square(3) };
    let t4 = spawn { square(4) };
    println([t1.join(), t2.join(), t3.join(), t4.join()]);   // [1, 4, 9, 16]
}
