    "note": "Both ordinary binaries use their own checked-in seed-to-source paths. Array sources exactly match the guard generator, with a unique heap input. Statements and fields use the same heap-input construction. Fixed project paths; no timing measurements.",
    "generator_python": "import os,json,re,subprocess,hashlib\nfrom pathlib import Path\nroot=Path('/tmp/plum-liveness-scale');root.mkdir(exist_ok=True)\nrows=[]\nfor kind in ('array','block','fields'):\n for width in (256,512,1024,2048):\n  if kind=='fields' and width>512:continue\n  project=root/f'{kind}-{width}';project.mkdir(exist_ok=True)\n  prefix='let identity(s: String): String = s\\n'\n  if kind=='array':\n   source=prefix+'let collect(s: String): Array[String] = [\\n'+',\\n'.join('identity(s)' for _ in range(width))+'\\n]\\n'\n   source+=f'let main(): Unit = {{ let xs = collect(41.to_string().concat(\"-shared\")); assert_eq(xs.len(), {width}); for x in xs {{ assert_eq(x,\"41-shared\"); }}; println(\"ok\") }}\\n'\n  elif kind=='block':\n   source='let consume(s: String): Unit = assert_eq(s,\"41-shared\")\\nlet visit(s: String): Unit = {\\n'+'consume(s);\\n'*width+'}\\nlet main(): Unit = { visit(41.to_string().concat(\"-shared\")); println(\"ok\") }\\n'\n  else:\n   source='struct Wide { '+', '.join(f'f{i}: String' for i in range(width))+' }\\n'+prefix\n   source+='let collect(s: String): Wide = Wide { '+', '.join(f'f{i}: identity(s)' for i in range(width))+' }\\n'\n   source+=f'let main(): Unit = {{ let v = collect(41.to_string().concat(\"-shared\")); assert_eq(v.f0,\"41-shared\"); assert_eq(v.f{width-1},\"41-shared\"); println(\"ok\") }}\\n'\n  (project/'main.plum').write_text(source)\n  for label,compiler in [('before','/tmp/plum-allocation-ci'),('after','/tmp/plum-liveness-ci')]:\n   if not Path(compiler).exists():continue\n   for mode,flags in [('debug',[]),('release',['--release'])]:\n    r=subprocess.run([compiler,'emit-llvm',str(project),*flags],capture_output=True,env=dict(os.environ,PLUM_RT_STATS='1'),timeout=180)\n    if r.returncode:raise RuntimeError(r.stdout[-2000:]+r.stderr[-2000:])\n    (root/f'{kind}-{width}-{label}-{mode}.ll').write_bytes(r.stdout)\n    stats=re.search(rb'alloc n=(\\d+) bytes=(\\d+)',r.stderr)\n    row=dict(kind=kind,width=width,label=label,mode=mode,allocations=int(stats[1]),allocated_bytes=int(stats[2]),ir_bytes=len(r.stdout),source_sha256=hashlib.sha256(source.encode()).hexdigest(),stdout_sha256=hashlib.sha256(r.stdout).hexdigest())\n    rows.append(row);print(row,flush=True)\n(root/'results.json').write_text(json.dumps(rows,indent=2)+'\\n')\n"
  },
